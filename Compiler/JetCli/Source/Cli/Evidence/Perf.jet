struct CaptureBundle {
    samples: [TraceSample]
    profile: TraceProfile
    allocations: [TraceAllocation]
    browser: [TraceBrowser]
    browser_rows_truncated: Bool
    game_frames: [TraceGameFrame]
    game_draw_events: [TraceGameDrawEvent]
    tasks: [TraceTask]
    locks: [TraceLock]
    io: [TraceIo]
    io_rows_truncated: Bool
    native: [TraceNative]
    native_rows_truncated: Bool
    spans: [TraceSpan]
    span_rows_truncated: Bool
    source_identity: [SourceIdentity]
    source_maps: [TraceSourceMap]
    task_rows_truncated: Bool
    // Rust: Source/CmdPerf.rs:67
    fn empty() -> CaptureBundle {
        CaptureBundle{samples: [], profile: TraceProfile.unsupported("source sampling requires a source capture"),
            allocations: [], browser: [], browser_rows_truncated: false, game_frames: [], game_draw_events: [],
            tasks: [], locks: [], io: [], io_rows_truncated: false, native: [], native_rows_truncated: false,
            spans: [], span_rows_truncated: false, source_identity: [], source_maps: [], task_rows_truncated: false}
    }
    // Rust: Source/CmdPerf.rs:91
    fn add_game_devtools_bodies(&self, bodies: &[JetDevtoolsEventBody]) -> Unit Err! {
        (frames, draws) :: project_game_devtools_bodies(bodies)?
        self.game_frames.extend(^frames)
        self.game_draw_events.extend(^draws)
        Ok(())
    }
}
// Rust: Source/CmdPerf.rs:103
pub fn run(raw: &[String]) -> Outcome {
    action :: raw.get(1)
    if action == None || action == Val("help") || action.is_some_and(value -> CLI.is_help_flag(value)) {
        if CLI.command_group("perf") == { Val(group) -> println("jet perf — {group.summary}"); None -> {} }
        println("")
        print("{CLI.command_group_usage(\"perf\")}")
        return .Exit(ExitCodes.OK)
    }
    verb :: action.unwrap()
    rest := raw[2..<raw.len()].to_vec()
    if rest.iter().any(arg -> CLI.is_help_flag(arg)) {
        spec :: CLI.command_group("perf").and_then(group -> group.actions.iter().find(nested -> nested.name == verb))
        if spec == {
            Val(spec) -> { println("jet perf {spec.name} — {spec.summary}"); println("usage: {spec.usage}") }
            None -> print("{CLI.command_group_usage(\"perf\")}")
        }
        return .Exit(ExitCodes.OK)
    }
    quiet :: rest.iter().any(arg -> arg == "--quiet")
    rest.retain(arg -> arg != "--quiet")
    if verb == {
        "run" -> .Exit(run_session(verb, rest, quiet))
        "test" -> .Exit(run_session(verb, rest, quiet))
        "attach" -> .Exit(attach(rest))
        "view" -> .Exit(view(rest))
        "compare" -> .Exit(compare(rest))
        "export" -> .Exit(export(rest))
        other -> {
            emit_cli_report("E2101", "`{other}` isn't a jet perf command.", "jet perf accepts only commands in its named area.", "run `jet perf help`.", false)
            .Exit(ExitCodes.USAGE)
        }
    }
}
// Rust: Source/CmdPerf.rs:157
fn run_session(action: String, args: &[String], quiet: Bool) -> Int32 {
    parsed :: if parse_session_args(args) == {
        Ok(parsed) -> parsed
        Err(message) -> { perf_error_with_fix(message, "run `jet perf {action} <file.jet> [--out <path.jettrace>]`"); return ExitCodes.USAGE }
    }
    // GATE #4494: exact native child process, environment, clocks and polling.
    exe :: if env.current_exe() == {
        Ok(path) -> path
        Err(error) -> { perf_error("cannot resolve jet executable: {error}"); return ExitCodes.USAGE }
    }
    child_argv := [action.to_string()]
    child_argv.extend(parsed.child_args.iter().cloned())
    relay_nonce :: SystemTime.now().duration_since(UNIX_EPOCH).unwrap_or_default().as_nanos()
    relay_path :: env.temp_dir().join("jet-perf-devtools-{process.id()}-{relay_nonce}.ring")
    relay_session_id :: "jet-perf-{process.id()}-{relay_nonce}"
    child_command := Command.new(exe)
    child_command.args(child_argv).env("JET_OBSERVE", "1").env("JET_DEVTOOLS_RELAY_PATH", relay_path)
        .env("JET_DEVTOOLS_RELAY_SESSION_ID", relay_session_id).env("JET_DEVTOOLS_RELAY_SOURCE_ID", parsed.source ?? "")
        .env("JET_DEVTOOLS_RELAY_BUILD_ID", "runtime").env("JET_DEVTOOLS_RELAY_REVISION", "runtime")
        .env("JET_DEVTOOLS_RELAY_WORLD_ID", "game").stdin(Stdio.inherit()).stdout(Stdio.inherit()).stderr(Stdio.inherit())
    child := if child_command.spawn() == {
        Ok(child) -> child
        Err(error) -> { perf_error("cannot start `jet {action}`: {error}"); return ExitCodes.USAGE }
    }
    pid :: child.id()
    started :: Instant.now()
    last_snapshot := String?{None}
    io_timeline := IOTimeline.default()
    native_timing := NativeTimingInput.unavailable(0)
    observe := () -> {
        if poll_observe_snapshot(pid) == {
            Val(snapshot) -> {
                observed_at_ns :: elapsed_ns(started)
                io_timeline.observe(snapshot.tasks, observed_at_ns, snapshot.process_cpu_ns != None)
                native_timing = snapshot.process_cpu_ns.map(duration -> NativeTimingInput.Captured{
                    duration_ns: duration, observed_at_ns: observed_at_ns, process_id: snapshot.process_id}) ?? NativeTimingInput.unavailable(observed_at_ns)
                last_snapshot = Val(snapshot.text)
            }
            None -> {}
        }
    }
    loop {
        if child_exited(&child) == {
            Ok(true) -> break
            Ok(false) -> { if parsed.source != None { observe() }; thread.sleep(Duration.from_millis(25)) }
            Err(error) -> {
                perf_error("cannot wait for `jet {action}`: {error}")
                _ :: child.kill()
                _ :: child.wait()
                return ExitCodes.USAGE
            }
        }
    }
    // Observe the exited, unreaped child once more, including short runs.
    if parsed.source != None { observe() }
    status :: if child.wait() == {
        Ok(status) -> status
        Err(error) -> { perf_error("cannot wait for `jet {action}`: {error}"); return ExitCodes.USAGE }
    }
    game_bodies :: if DevServer.LiveInspect.read_devtools_relay_path_with_identity(relay_path, Val(relay_session_id), parsed.source, Val("runtime"), Val("runtime"), Val("game")) == {
        Ok(envelope) -> envelope.game_trace_bodies()
        Err(_) if !relay_path.exists() -> []
        Err(message) -> { _ :: fs.remove_file(relay_path); perf_error(message); return ExitCodes.USAGE }
    }
    wall_ns :: elapsed_ns(started)
    io_timeline.finish(wall_ns)
    capture :: if parsed.source == {
        Val(source) -> capture_from_source(source, last_snapshot, wall_ns, native_timing.duration_ns(), Val(&io_timeline), Val(&native_timing)).unwrap_or_else(_ -> CaptureBundle.empty())
        None -> CaptureBundle.empty()
    }
    argv := [action.to_string()]
    argv.extend(args.iter().cloned())
    receipt_sections :: if receipt_sections_for_command(action, child_argv) == {
        Ok(sections) -> sections
        Err(message) -> { perf_error("receipt sections: {message}"); return ExitCodes.USAGE }
    }
    trace_result :: write_session_trace(action, argv, parsed.out, ^capture, game_bodies, parsed.capture_allowlist, ^receipt_sections)
    _ :: fs.remove_file(relay_path)
    if trace_result == {
        Ok(path) -> { if !quiet { eprintln("trace: {path.display()}") } }
        Err(message) -> { perf_error(message); return ExitCodes.USAGE }
    }
    status.code() ?? 1
}
// Rust: Source/CmdPerf.rs:331
struct SessionArgs { out: String?; source: String?; capture_allowlist: [String]; child_args: [String] }
// Rust: Source/CmdPerf.rs:340
fn parse_session_args(args: &[String]) -> SessionArgs Err! {
    out := String?{None}
    source := String?{None}
    capture_allowlist := [String]{}
    child_args := [String]{}
    i := 0
    passthrough := false
    loop i < args.len() {
        arg :: &args[i]
        if passthrough { child_args.push(arg.clone()); i += 1; next }
        if arg == "--" { passthrough = true; child_args.push(arg.clone()); i += 1; next }
        if arg.strip_prefix("--out=") == { Val(value) -> { out = Val(value.to_string()); i += 1; next }; None -> {} }
        if arg == "--out" { out = Val(args.get(i + 1).ok_or("`--out` needs a path")?.clone()); i += 2; next }
        if arg.strip_prefix("--capture=") == { Val(value) -> { capture_allowlist = parse_capture_allowlist(value)?; i += 1; next }; None -> {} }
        if arg == "--capture" { capture_allowlist = parse_capture_allowlist(args.get(i + 1).ok_or("`--capture` needs a comma-separated allowlist")?)?; i += 2; next }
        if arg.starts_with("-") { child_args.push(arg.clone()); i += 1; next }
        if source == None && (arg.ends_with(".jet") || OSPath.from(arg).extension().and_then(e -> e.to_str()) == Val("jet")) { source = Val(arg.to_string()) }
        child_args.push(arg.clone())
        i += 1
    }
    Ok(SessionArgs{out: out, source: source, capture_allowlist: capture_allowlist, child_args: child_args})
}
// Rust: Source/CmdPerf.rs:408
fn parse_capture_allowlist(raw: String) -> [String] Err! {
    items := [String]{}
    loop part in raw.split(",") {
        item := part.trim() // #4303
        if item.is_empty() { next }
        if !DEFAULT_EXCLUSIONS.contains(item) { return Err("`--capture` item `{item}` is not a D-PERFSESSION1 privacy field; allowed: {DEFAULT_EXCLUSIONS.join(\", \")}") }
        items.push(item.to_string())
    }
    if items.is_empty() { return Err("`--capture` needs at least one privacy field") }
    items.sort()
    items.dedup()
    Ok(items)
}
// Rust: Source/CmdPerf.rs:431
fn attach(args: &[String]) -> Int32 {
    pid := UInt32?{None}
    out := String?{None}
    source := String?{None}
    capture_allowlist := [String]{}
    i := 0
    loop i < args.len() {
        arg :: &args[i]
        if arg.strip_prefix("--out=") == { Val(value) -> { out = Val(value.to_string()); i += 1; next }; None -> {} }
        if arg == "--out" {
            if args.get(i + 1) == { Val(value) -> out = Val(value.clone()); None -> { perf_error("`--out` needs a path"); return ExitCodes.USAGE } }
            i += 2; next
        }
        if arg.strip_prefix("--source=") == { Val(value) -> { source = Val(value.to_string()); i += 1; next }; None -> {} }
        if arg == "--source" {
            if args.get(i + 1) == { Val(value) -> source = Val(value.clone()); None -> { perf_error("`--source` needs a `.jet` path"); return ExitCodes.USAGE } }
            i += 2; next
        }
        if arg.strip_prefix("--capture=") == {
            Val(value) -> {
                if parse_capture_allowlist(value) == { Ok(items) -> capture_allowlist = items; Err(message) -> { perf_error(message); return ExitCodes.USAGE } }
                i += 1; next
            }
            None -> {}
        }
        if arg == "--capture" {
            value :: if args.get(i + 1) == { Val(value) -> value; None -> { perf_error("`--capture` needs a comma-separated allowlist"); return ExitCodes.USAGE } }
            if parse_capture_allowlist(value) == { Ok(items) -> capture_allowlist = items; Err(message) -> { perf_error(message); return ExitCodes.USAGE } }
            i += 2; next
        }
        if arg.starts_with("-") { perf_error("unknown `jet perf attach` flag `{arg}`"); return ExitCodes.USAGE }
        if pid != None { perf_error("`jet perf attach` takes one process id"); return ExitCodes.USAGE }
        if arg.parse<UInt32>() == { Ok(value) -> pid = Val(value); Err(_) -> { perf_error("`{arg}` isn't a process id"); return ExitCodes.USAGE } }
        i += 1
    }
    process_id :: if pid == {
        Val(value) -> value
        None -> { perf_error_with_fix("`jet perf attach` needs a process id", "run `jet perf attach <pid> --source <file.jet>`"); return ExitCodes.USAGE }
    }
    if !process_exists(process_id) {
        perf_error_with_fix("process {process_id} is not running or not visible to this user", "start the program with `jet run --observe`, then attach to that pid")
        return ExitCodes.USAGE
    }
    relay_path :: DevServer.LiveInspect.devtools_relay_path(process_id)
    game_bodies :: if DevServer.LiveInspect.read_devtools_relay_path_with_identity(relay_path, None, source, None, None, None) == {
        Ok(envelope) -> envelope.game_trace_bodies()
        Err(_) if !DevServer.LiveInspect.devtools_relay_path(process_id).exists() -> []
        Err(message) -> { perf_error(message); return ExitCodes.USAGE }
    }
    browser_capture :: if read_browser_capture(process_id, source == None) == {
        Ok(capture) -> Val(capture)
        Err(_) if !DevServer.BrowserTrace.relay_path(process_id).exists() -> None
        Err(message) -> { perf_error(message); return ExitCodes.USAGE }
    }
    capture :: if browser_capture == {
        Val(browser_capture) -> {
            if source.is_some_and(path -> !browser_capture.sources.iter().any(source -> source.path == path)) {
                perf_error("`--source` does not match the devserver browser session"); return ExitCodes.USAGE
            }
            browser :: if capture_browser(^browser_capture) == { Ok(bundle) -> bundle; Err(message) -> { perf_error(message); return ExitCodes.USAGE } }
            if merge_host_onto_browser(process_id, source, ^browser) == { Ok(bundle) -> bundle; Err(message) -> { perf_error(message); return ExitCodes.USAGE } }
        }
        None -> {
            if (source, DevServer.LiveInspect.read(process_id)) == {
                (Val(path), Ok(snapshot)) -> {
                    timing :: process_times(process_id)
                    wall_ns :: timing.map(pair -> pair.0) ?? 0
                    cpu_ns :: timing.map(pair -> pair.1)
                    native_timing :: timing.map(pair -> NativeTimingInput.Captured{duration_ns: pair.1, observed_at_ns: 0, process_id: process_id}) ?? NativeTimingInput.unavailable(wall_ns)
                    if capture_from_source(path, Val(snapshot), wall_ns, cpu_ns, None, Val(&native_timing)) == {
                        Ok(bundle) -> bundle
                        Err(message) -> { perf_error(message); return ExitCodes.USAGE }
                    }
                }
                (Val(_), Err(message)) -> { perf_error_with_fix(message, "start the program with `jet run --observe`, then attach"); return ExitCodes.USAGE }
                (None, Ok(_)) -> {
                    emit_cli_report("E2102", "live observe snapshot found, but `--source` is required", "domain capture must attribute facts to a Jet symbol identity", "run `jet perf attach {process_id} --source <file.jet>`", false)
                    return ExitCodes.USAGE
                }
                (None, Err(_)) -> CaptureBundle.empty()
            }
        }
    }
    argv := ["attach", process_id.to_string()]
    if source == { Val(path) -> { argv.push("--source"); argv.push(path.clone()) }; None -> {} }
    if !capture_allowlist.is_empty() { argv.push("--capture"); argv.push(capture_allowlist.join(",")) }
    if write_session_trace("attach", argv, out, ^capture, game_bodies, capture_allowlist, []) == {
        Ok(path) -> { eprintln("trace: {path.display()}"); ExitCodes.OK }
        Err(message) -> { perf_error(message); ExitCodes.USAGE }
    }
}
// Rust: Source/CmdPerf.rs:653
fn read_browser_capture(pid: UInt32, activate: Bool) -> DevServer.BrowserTrace.Capture Err! {
    if DevServer.BrowserTrace.read(pid) == {
        Ok(capture) -> return Ok(capture)
        Err(error) if DevServer.BrowserTrace.relay_path(pid).exists() || !activate -> return Err(error)
        Err(_) -> {}
    }
    DevServer.BrowserTrace.request(pid)?
    // GATE #4494: native monotonic clock and sleep.
    deadline :: Instant.now() + Duration.from_secs(2)
    loop Instant.now() < deadline {
        if DevServer.BrowserTrace.relay_path(pid).exists() { thread.sleep(Duration.from_millis(1600)); return DevServer.BrowserTrace.read(pid) }
        thread.sleep(Duration.from_millis(25))
    }
    DevServer.BrowserTrace.cancel_request(pid)
    Err("process {pid} has no browser trace relay")
}
// Rust: Source/CmdPerf.rs:677
fn capture_browser(capture: DevServer.BrowserTrace.Capture) -> CaptureBundle Err! {
    bundle := CaptureBundle.empty()
    bundle.source_identity = capture.sources.iter().map(source -> SourceIdentity{path: source.path.clone(), sha256: source.sha256.clone(), symbols: source.symbols.clone()}).collect()
    if capture.source_map == { Val(map) -> bundle.source_maps.push(TraceSourceMap.from_map_bytes("js", "app.js", map)); None -> {} }
    symbols := [String:String]{}
    loop source in &capture.sources { loop (name, _) in &source.symbols { symbols.insert(name, source.path) } }
    loop row in capture.rows {
        path :: symbols.get(row.symbol).ok_or_else(() -> "browser trace named unknown compiler symbol `{row.symbol}`")?
        bundle.browser.push(TraceBrowser{class: row.class, duration_ns: row.duration_ns, start_ns: row.start_ns, symbol: JetSymbolRef{path: path.to_string(), name: row.symbol}})
    }
    bundle.browser_rows_truncated = capture.truncated
    Ok(bundle)
}
// Rust: Source/CmdPerf.rs:728
fn merge_host_onto_browser(pid: UInt32, source: String?, browser: CaptureBundle) -> CaptureBundle Err! {
    symbol :: attribution_symbol(browser.source_identity, source).ok_or("browser capture has no Jet symbol identity for host attribution")?
    timing :: process_times(pid)
    wall_ns :: timing.map(pair -> pair.0) ?? 0
    cpu_ns :: timing.map(pair -> pair.1)
    if wall_ns > 0 { browser.samples.push(TraceSample{domain: "wall", duration_ns: wall_ns, symbol: symbol.clone()}) }
    if cpu_ns == { Val(cpu) if cpu > 0 -> browser.samples.push(TraceSample{domain: "cpu", duration_ns: cpu, symbol: symbol.clone()}); _ -> {} }
    native_timing :: timing.map(pair -> NativeTimingInput.Captured{duration_ns: pair.1, observed_at_ns: 0, process_id: pid}) ?? NativeTimingInput.unavailable(wall_ns)
    snapshot :: DevServer.LiveInspect.read(pid).ok()
    snapshot_tasks :: snapshot.and_then(text -> {
        process_id :: UInt32.try_from(json_u64(text, "pid")?).ok()?
        Val(observe_tasks(text, process_id))
    }).unwrap_or_default()
    if snapshot == {
        Val(text) -> {
            (alloc_count, alloc_bytes) :: observe_arena_resources(text)
            if alloc_count > 0 || alloc_bytes > 0 { browser.allocations.push(TraceAllocation{count: alloc_count, bytes: alloc_bytes, symbol: symbol.clone()}) }
            loop observed in observe_locks(text) {
                browser.locks.push(TraceLock{kind: "channel", id: observed.id, depth: observed.depth, capacity: observed.capacity,
                    send_waiters: observed.send_waiters, recv_waiters: observed.recv_waiters, closed: observed.closed, symbol: symbol.clone()})
            }
        }
        None -> {}
    }
    observed_tasks := snapshot_tasks.rows.clone()
    observed_tasks.sort_by_key(task -> task.key())
    trace_task_ids :: trace_task_id_map(observed_tasks)
    loop observed in &observed_tasks {
        id :: trace_task_ids[observed.key()]
        parent :: if observed.parent == 0 { 0 } else {
            trace_task_ids.get((observed.process_id, observed.parent)).copied().ok_or_else(() -> "observed task {observed.id} in process {observed.process_id} has missing parent {observed.parent}")?
        }
        browser.tasks.push(TraceTask{id: id, parent: parent, state: observed.state.clone(), wait: observed.wait.clone(), cancelled: observed.cancelled, symbol: symbol.clone()})
    }
    browser.task_rows_truncated = snapshot_tasks.truncated
    loop observed in observe_io(snapshot_tasks.rows) {
        task_id :: if trace_task_ids.get(observed.task) == { Val(id) -> id; None -> next }
        browser.io.push(TraceIo{end_ns: wall_ns, kind: observed.kind, start_ns: wall_ns, task_id: task_id, wait: observed.wait, symbol: symbol.clone()})
    }
    root_task_id :: if native_timing == {
        .Captured{process_id: process_id, ..} -> observed_tasks.iter().find(task -> task.process_id == process_id && task.parent == 0).and_then(task -> trace_task_ids.get(task.key())).copied()
        .Unavailable{..} -> None
    }
    browser.native.push(if (native_timing, root_task_id) == {
        (.Captured{duration_ns: duration, observed_at_ns: at, ..}, Val(task_id)) -> TraceNative{clock: "process_cpu", duration_ns: Val(duration), observed_at_ns: at, reason: "", status: "captured", symbol: symbol.clone(), target: core.sys.target.selected_target(), task_id: Val(task_id)}
        (.Captured{observed_at_ns: at, ..}, None) -> TraceNative{clock: "process_cpu", duration_ns: None, observed_at_ns: at, reason: "root task causality was not observable", status: "unavailable", symbol: symbol.clone(), target: core.sys.target.selected_target(), task_id: None}
        (.Unavailable{observed_at_ns: at, reason: reason}, _) -> TraceNative{clock: "process_cpu", duration_ns: None, observed_at_ns: at, reason: reason.clone(), status: "unavailable", symbol: symbol.clone(), target: core.sys.target.selected_target(), task_id: None}
    }) // GATE #4483: selected build target identity.
    Ok(browser)
}
// Rust: Source/CmdPerf.rs:886
fn attribution_symbol(sources: &[SourceIdentity], preferred_path: String?) -> JetSymbolRef? {
    source :: preferred_path.and_then(path -> sources.iter().find(source -> source.path == path)).or_else(() -> sources.first())?
    name :: source.symbols.iter().find(pair -> pair.1 == "fn" && pair.0 == "run")
        .or_else(() -> source.symbols.iter().find(pair -> pair.1 == "fn")).or_else(() -> source.symbols.first()).map(pair -> pair.0.clone())?
    Val(JetSymbolRef{path: source.path.clone(), name: name})
}
// Rust: Source/CmdPerf.rs:907
struct SourceFunction { name: String; span: Diagnostics.Span }
// Rust: Source/CmdPerf.rs:916
fn source_functions(src: String) -> [SourceFunction]? {
    source_for_parse :: Package.mask_inline_package_source(src).ok()?.0
    (tokens, lex_diagnostics) :: Lexer.lex(source_for_parse)
    if !lex_diagnostics.is_empty() { return None }
    program :: Parser.parse_with_source(tokens, source_for_parse).ok()?
    Val(program.items.iter().filter_map(item -> if item == {
        .Func(function) -> Val(SourceFunction{name: function.name.clone(), span: function.span})
        _ -> None
    }).collect())
}
// Rust: Source/CmdPerf.rs:939
fn source_line_column(src: String, offset: Int) -> (UInt64, UInt64) {
    before :: src.get(0..<offset) ?? src
    line_start :: before.rfind("\n").map_or(0, newline -> newline + 1)
    (before.matches("\n").count() as UInt64 + 1, before[line_start..<before.len()].chars().count() as UInt64 + 1)
}
// Rust: Source/CmdPerf.rs:948
fn sampled_source_profile(source_path: String, source_sha256: String, source: String, functions: &[SourceFunction]?, wall_samples: UInt64, cpu_samples: UInt64, samples_truncated: Bool) -> TraceProfile {
    functions :: if functions == { Val(value) -> value; None -> return TraceProfile.unsupported("source does not parse; no function location is attributable") }
    entry :: if functions.iter().find(function -> function.name == "run") == { Val(value) -> value; None -> return TraceProfile.unsupported("source has no `fn run` entrypoint") }
    retained_wall :: wall_samples.min(TRACE_PROFILE_SAMPLE_LIMIT)
    retained_cpu :: cpu_samples.min(TRACE_PROFILE_SAMPLE_LIMIT)
    (start_line, start_column) :: source_line_column(source, entry.span.start)
    (end_line, end_column) :: source_line_column(source, entry.span.end)
    source_for_row :: () -> TraceProfileSource{path: source_path, sha256: source_sha256, start_line: start_line, start_column: start_column, end_line: end_line, end_column: end_column}
    symbol :: JetSymbolRef{path: source_path, name: entry.name.clone()}
    rows := [TraceProfileRow]{}
    if retained_wall > 0 { rows.push(TraceProfileRow{clock: "wall", execution_count: None, sample_count: retained_wall, sample_weight: retained_wall, source: source_for_row(), symbol: symbol.clone()}) }
    if retained_cpu > 0 { rows.push(TraceProfileRow{clock: "cpu", execution_count: None, sample_count: retained_cpu, sample_weight: retained_cpu, source: source_for_row(), symbol: symbol}) }
    truncated :: samples_truncated || wall_samples > TRACE_PROFILE_SAMPLE_LIMIT || cpu_samples > TRACE_PROFILE_SAMPLE_LIMIT
    (status, coverage, reason) :: if truncated { ("truncated", "partial", "sampling observations exceeded the bounded profile sample limit") }
        else if rows.is_empty() { ("no_samples", "none", "the observe channel produced no source-attributed samples") }
        else { ("captured", "partial", "sampling is attributed to the observed entrypoint; execution counts are not inferred") }
    TraceProfile{method: "sampling", status: status, coverage: coverage, rows: rows, row_limit: TRACE_PROFILE_SAMPLE_LIMIT,
        rows_truncated: truncated, overhead_ns: None, overhead_status: "not_measured", overhead_reason: "no matched non-profiled run was captured",
        reason: reason, window_status: "unavailable", window_wall_ns: None, window_cpu_ns: None, window_reason: "the runtime published no run window"}
}
// Rust: Source/CmdPerf.rs:1043
fn record_run_window(profile: &TraceProfile, snapshot: String?) -> {
    window :: if snapshot.and_then(text -> DevServer.LiveInspect.runtime_window(text).ok()).flatten() == { Val(window) -> window; None -> return }
    profile.window_status = if window.exit { "exit" } else { "live" }
    profile.window_wall_ns = Val(window.elapsed_ns)
    profile.window_cpu_ns = window.cpu_ns
    profile.window_reason = if (window.exit, window.cpu_ns) == {
        (_, None) -> "the runtime has no process CPU clock on this target"
        (true, Val(_)) -> "published by the runtime at its exit seam"
        (false, Val(_)) -> "the last live publication; the run had not exited"
    }
}
// Rust: Source/CmdPerf.rs:1061
fn capture_from_source(source_path: String, snapshot: String?, wall_ns: UInt64, cpu_ns: UInt64?, io_timeline: &IOTimeline?, native_timing: &NativeTimingInput?) -> CaptureBundle Err! {
    path :: OSPath.from(source_path)
    if path.extension().and_then(e -> e.to_str()) != Val("jet") { return Err("source path must be a `.jet` file, got `{source_path}`") }
    // GATE #4494: native source bytes.
    bytes :: fs.read(path).map_err(e -> "cannot read source {source_path}: {e}")?
    src :: String.from_utf8_lossy(bytes)
    sha256 :: SHA256.sha256_hex(bytes)
    path_text :: source_path.to_string()
    functions :: source_functions(src)
    entry :: functions.and_then(functions -> functions.iter().find(function -> function.name == "run"))
    symbol :: entry.map(function -> JetSymbolRef{path: path_text.clone(), name: function.name.clone()})
    profile_wall_samples :: io_timeline.map(timeline -> timeline.profile_samples()) ?? (if snapshot != None { 1 } else { 0 })
    profile_cpu_samples :: io_timeline.map(timeline -> timeline.profile_cpu_samples()) ?? (if snapshot != None && cpu_ns != None { 1 } else { 0 })
    profile_truncated :: io_timeline.map(timeline -> timeline.profile_samples_truncated()) ?? false
    profile := sampled_source_profile(path_text, sha256, src, functions, profile_wall_samples, profile_cpu_samples, profile_truncated)
    record_run_window(&profile, snapshot)
    snapshot_tasks :: snapshot.and_then(text -> {
        process_id :: UInt32.try_from(json_u64(text, "pid")?).ok()?
        Val(observe_tasks(text, process_id))
    }).unwrap_or_default()
    samples := [TraceSample]{}
    if symbol == {
        Val(symbol) -> {
            if wall_ns > 0 { samples.push(TraceSample{domain: "wall", duration_ns: wall_ns, symbol: symbol.clone()}) }
            if cpu_ns == { Val(cpu) if cpu > 0 -> samples.push(TraceSample{domain: "cpu", duration_ns: cpu, symbol: symbol.clone()}); _ -> {} }
        }
        None -> {}
    }
    allocations := [TraceAllocation]{}
    if (symbol, snapshot) == {
        (Val(symbol), Val(snapshot)) -> {
            (alloc_count, alloc_bytes) :: observe_arena_resources(snapshot)
            if alloc_count > 0 || alloc_bytes > 0 { allocations.push(TraceAllocation{count: alloc_count, bytes: alloc_bytes, symbol: symbol.clone()}) }
        }
        _ -> {}
    }
    observed_tasks := io_timeline.map(timeline -> timeline.tasks()).unwrap_or_else(() -> snapshot_tasks.rows.clone())
    observed_tasks.sort_by_key(task -> task.key())
    trace_task_ids :: trace_task_id_map(observed_tasks)
    tasks := [TraceTask]{}
    if symbol == {
        Val(symbol) -> {
            loop observed in &observed_tasks {
                id :: trace_task_ids[observed.key()]
                parent :: if observed.parent == 0 { 0 } else {
                    trace_task_ids.get((observed.process_id, observed.parent)).copied().ok_or_else(() -> "observed task {observed.id} in process {observed.process_id} has missing parent {observed.parent}")?
                }
                tasks.push(TraceTask{id: id, parent: parent, state: observed.state.clone(), wait: observed.wait.clone(), cancelled: observed.cancelled, symbol: symbol.clone()})
            }
        }
        None -> {}
    }
    locks := [TraceLock]{}
    if (symbol, snapshot) == {
        (Val(symbol), Val(snapshot)) -> {
            loop observed in observe_locks(snapshot) {
                locks.push(TraceLock{kind: "channel", id: observed.id, depth: observed.depth, capacity: observed.capacity,
                    send_waiters: observed.send_waiters, recv_waiters: observed.recv_waiters, closed: observed.closed, symbol: symbol.clone()})
            }
        }
        _ -> {}
    }
    io := [TraceIo]{}
    if symbol == {
        Val(symbol) -> {
            observed :: io_timeline.map(timeline -> timeline.completed.clone()).unwrap_or_else(() ->
                observe_io(snapshot_tasks.rows).into_iter().map(io -> ObservedIoSpan{end_ns: wall_ns, kind: io.kind, start_ns: wall_ns, task: io.task, wait: io.wait}).collect())
            loop observed in observed {
                task_id :: if trace_task_ids.get(observed.task) == { Val(id) -> id; None -> next }
                io.push(TraceIo{end_ns: observed.end_ns, kind: observed.kind, start_ns: observed.start_ns, task_id: task_id, wait: observed.wait, symbol: symbol.clone()})
            }
        }
        None -> {}
    }
    native := [TraceNative]{}
    if (symbol, native_timing) == {
        (Val(symbol), Val(timing)) -> {
            root_task_id :: if timing == {
                .Captured{process_id: process_id, ..} -> observed_tasks.iter().find(task -> task.process_id == process_id && task.parent == 0).and_then(task -> trace_task_ids.get(task.key())).copied()
                .Unavailable{..} -> None
            }
            native.push(if (timing, root_task_id) == {
                (.Captured{duration_ns: duration, observed_at_ns: at, ..}, Val(task_id)) -> TraceNative{clock: "process_cpu", duration_ns: Val(duration), observed_at_ns: at, reason: "", status: "captured", symbol: symbol.clone(), target: core.sys.target.selected_target(), task_id: Val(task_id)}
                (.Captured{observed_at_ns: at, ..}, None) -> TraceNative{clock: "process_cpu", duration_ns: None, observed_at_ns: at, reason: "root task causality was not observable", status: "unavailable", symbol: symbol.clone(), target: core.sys.target.selected_target(), task_id: None}
                (.Unavailable{observed_at_ns: at, reason: reason}, _) -> TraceNative{clock: "process_cpu", duration_ns: None, observed_at_ns: at, reason: reason.clone(), status: "unavailable", symbol: symbol.clone(), target: core.sys.target.selected_target(), task_id: None}
            }) // GATE #4483: selected build target identity.
        }
        _ -> {}
    }
    spans := [TraceSpan]{}
    if symbol == {
        Val(symbol) -> {
            if io_timeline == {
                Val(timeline) if !timeline.task_spans.is_empty() -> {
                    loop observed in timeline.spans() {
                        task_id :: if trace_task_ids.get(observed.task) == { Val(id) -> id; None -> next }
                        parent_task_id :: if observed.parent_task_id == 0 { None } else {
                            Val(trace_task_ids.get((observed.task.0, observed.parent_task_id)).copied().ok_or_else(() -> "observed span task {observed.task.1} in process {observed.task.0} has missing parent {observed.parent_task_id}")?)
                        }
                        spans.push(TraceSpan{clock: "monotonic", end_ns: Val(observed.end_ns), kind: "task_observed", parent_task_id: parent_task_id,
                            reason: "", start_ns: Val(observed.start_ns), status: "captured", symbol: symbol.clone(), task_id: Val(task_id)})
                    }
                }
                Val(_) -> spans.push(TraceSpan{clock: "monotonic", end_ns: None, kind: "task_observed", parent_task_id: None,
                    reason: "task presence was not observable", start_ns: None, status: "unavailable", symbol: symbol.clone(), task_id: None})
                None -> spans.push(TraceSpan{clock: "monotonic", end_ns: None, kind: "task_observed", parent_task_id: None,
                    reason: "task span requires multiple live observations", start_ns: None, status: "unavailable", symbol: symbol.clone(), task_id: None})
            }
        }
        None -> {}
    }
    Ok(CaptureBundle{samples: samples, profile: profile, allocations: allocations, browser: [], browser_rows_truncated: false,
        game_frames: [], game_draw_events: [], tasks: tasks, locks: locks, io: io,
        io_rows_truncated: io_timeline.map(timeline -> timeline.io_rows_truncated) ?? snapshot_tasks.truncated,
        native: native, native_rows_truncated: false, spans: spans,
        span_rows_truncated: io_timeline.map(timeline -> timeline.span_rows_truncated) ?? false,
        source_identity: [SourceIdentity{path: path_text.clone(), sha256: sha256,
            symbols: functions.iter().flatten().map(function -> (function.name.clone(), "fn")).collect()}],
        source_maps: [TraceSourceMap.jet_with_source(path_text, src)],
        task_rows_truncated: io_timeline.map(timeline -> timeline.task_rows_truncated) ?? snapshot_tasks.truncated})
}
// Rust: Source/CmdPerf.rs:1370
pub enum NativeTimingInput {
    Captured { duration_ns: UInt64; observed_at_ns: UInt64; process_id: UInt32 }
    Unavailable { observed_at_ns: UInt64; reason: String }
    // Rust: Source/CmdPerf.rs:1383
    fn unavailable(observed_at_ns: UInt64) -> NativeTimingInput {
        .Unavailable{observed_at_ns: observed_at_ns, reason: native_unavailable_reason()}
    }
    // Rust: Source/CmdPerf.rs:1390
    fn duration_ns(&self) -> UInt64? { if self == { .Captured{duration_ns: duration, ..} -> Val(duration); .Unavailable{..} -> None } }
}
// Rust: Source/CmdPerf.rs:1398
fn native_unavailable_reason() -> String {
    // GATE #4483: selected target facts, not host environment.
    native_unavailable_reason_for(core.sys.target.selected_os(), core.sys.target.selected_target())
}
// Rust: Source/CmdPerf.rs:1402
fn native_unavailable_reason_for(os: String, target: String) -> String {
    if native_process_cpu_supported(os) { "process CPU timing was not observable" }
    else { "process CPU timing is unavailable on target {target}" }
}
// Rust: Source/CmdPerf.rs:1410
fn native_process_cpu_supported(os: String) -> Bool { os == "linux" || os == "android" }
