use jet.ProveReplay.[ReplayIdentity, ReplayAuthority, CaptureOpts, prepare_saved_replay, prepare_replay, emit_prove_diag]
use jet.Sema.Effect
use jet.AST.[Item, Expr, LValue, Pattern, ImportKind, core_list_prefix]
use jet.SHA256.sha256_hex
use jet.ExitCodes
use core.process.exit

// Rust: Source/CmdProve.rs:1821
fn prepare_replay_or_exit(identity: ReplayIdentity, path: String, json: Bool) -> ReplayAuthority {
    is_saved :: path.starts_with(".jet/records/saved/") || jet.build_project_root(identity.entry).ok()
        .is_some_and((root) -> OSPath.new(path).starts_with(root.join(".jet/records/saved")))
    prepared :: if is_saved -> prepare_saved_replay(identity, OSPath.new(path)) else -> prepare_replay(identity, path)
    if prepared == {
        .Ok(authority) -> authority
        .Err((code, why)) -> {
            what :: if code == {
                "E3620" -> "replay schema version is incompatible"
                "E3621" -> "replay semantic identity does not match"
                "E3628" -> "replay capture exceeded its artifact limit"
                _ -> "replay artifact is corrupt"
            }
            fix :: if code == {
                "E3620" -> "use a reader for the artifact schema, or recapture with this Jet"
                "E3621" -> "replay the exact target identity that produced the artifact"
                "E3628" -> "recapture a bounded artifact with a recorded Time authority"
                _ -> "recapture the target and keep the complete `.jetproof-replay` artifact"
            }
            emit_prove_diag(code, what, why, fix, json)
            exit(ExitCodes.USER_ERROR)
        }
    }
}

// Rust: Source/CmdProve.rs:1856
fn time_site_id_for_target(target: Target) -> String {
    (path, offset) :: target.members.first().map((member) -> {
        source :: String.from_utf8_lossy(member.bytes)
        (member.path, source.find("time.now").unwrap_or(USize.MAX))
    }).unwrap_or((target.root, USize.MAX))
    sha256_hex("{path}:{offset}:core.time.now".as_bytes())
}

// Rust: Source/CmdProve.rs:1871
fn lens_shows(lenses: [String], facet: String) -> Bool {
    if lenses.is_empty() -> return true
    if lenses.iter().any((lens) -> lens == "all") -> return facet != "solver"
    lenses.iter().any((lens) -> lens == facet)
}

// Rust: Source/CmdProve.rs:1881
fn canonical_lens_names(lenses: [String]) -> [String] {
    if lenses.iter().any((lens) -> lens == "all") {
        return if lenses.iter().any((lens) -> lens == "solver") -> ["all", "solver"] else -> ["all"]
    }
    PROOF_LENSES.iter().filter((candidate) -> lenses.iter().any((lens) -> lens == candidate)).collect()
}

// Rust: Source/CmdProve.rs:1896
fn outside_selected_lenses(lenses: [String], items: [FrontEndItem], tests: [TestItem],
    budgets: jet.BudgetView.BudgetProjection, declarations: [ContractDeclaration]) -> [String] {
    if lenses.is_empty() -> return []
    rows := [String]{}
    loop item in items.iter().filter((item) -> item.diagnostic != None) -> rows.push("  front end failed at {item.path}:{item.line}")
    loop item in tests.iter().filter((item) -> item.state >= 1) {
        kind :: if item.kind == { 1 -> "contract"; 2 -> "runtime"; 3 -> "property"; 4 -> "doctest"; _ -> "unit" }
        if !lens_shows(lenses, if item.kind == 1 -> "contracts" else -> "tests") {
            message :: item.message.replace("\n", " ").replace("\r", " ")
            rows.push("  {kind} {item.name}: {message}")
        }
    }
    loop declaration in declarations {
        observed :: tests.iter().any((item) -> item.kind == 1 && item.name == declaration.marker
            && USize.from(item.line) == declaration.line && source_paths_match(item.path, declaration.path) && item.state <= 1)
        if !observed && !lens_shows(lenses, "contracts") -> rows.push("  contract {declaration.marker} at {declaration.path}:{declaration.line}: not observed")
    }
    loop fact in budgets.facts {
        unavailable :: fact.evidence == "unavailable"
        failed :: fact.outcome != "pass"
        if (unavailable || failed) && !lens_shows(lenses, "budgets") -> rows.push("  budget {fact.budget_id}: {fact.outcome} ({fact.evidence})")
    }
    loop reason in budgets.rejected {
        if !lens_shows(lenses, "budgets") -> rows.push("  budget unavailable: {reason}")
    }
    if rows.is_empty() -> return ["OUTSIDE SELECTED LENSES", "  none failed or unavailable"]
    output := ["OUTSIDE SELECTED LENSES"]
    output.extend(rows)
    output
}

// Rust: Source/CmdProve.rs:1967
struct CaptureSite { operation: String, effect: Effect? }

// Rust: Source/CmdProve.rs:1978
// Check parsed authority before starting the producer; unknown call shapes fail closed.
fn preflight_capture_target(target: Target, opts: CaptureOpts, json_mode: Bool) -> () Int32! {
    sites :: capture_sites_for_target(target)
    time_sites :: sites.iter().filter(supported_time_capture_site).count()
    if time_sites > 1 -> return capture_preflight_error("E3625", "multiple core.time.now sites",
        "the current replay adapter has one bounded Time record and cannot prove request order for multiple sites",
        "capture one Time request per target, or route time through an injected deterministic input", json_mode)
    loop site in sites {
        if site.effect == None -> return capture_preflight_error("E3625", site.operation,
            "the reachable call shape is opaque to the replay authority",
            "route the operation through a supported deterministic input, or remove it from the captured target", json_mode)
        effect :: site.effect.unwrap()
        if effect == .Time && !supported_time_capture_site(site) -> return capture_preflight_error("E3625", site.operation,
            "the current replay adapter records only `core.time.now`; this Time operation would sleep or read an unrecorded clock",
            "capture a target that uses `core.time.now`, or route the operation through an injected deterministic input", json_mode)
        if effect == {
            .Time -> {}
            .Rand -> {
                if !opts.sensitive -> return capture_preflight_error("E3627", site.operation,
                    "safe capture reached raw {effect.name()}; untainted values still require sensitive-data consent",
                    "inject deterministic data, or explicitly use --capture-sensitive", json_mode)
            }
            .IO -> {
                if !opts.sensitive -> return capture_preflight_error("E3627", site.operation,
                    "safe capture reached raw {effect.name()}; untainted values still require sensitive-data consent",
                    "inject deterministic data, or explicitly use --capture-sensitive", json_mode)
            }
            .Net -> {
                if !opts.sensitive -> return capture_preflight_error("E3627", site.operation,
                    "safe capture reached raw {effect.name()}; untainted values still require sensitive-data consent",
                    "inject deterministic data, or explicitly use --capture-sensitive", json_mode)
            }
            other -> return capture_preflight_error("E3625", site.operation,
                "replay capture has no authority adapter for the {other.name()} effect",
                "route the operation through a supported deterministic input, or change the capture target", json_mode)
        }
    }
    // A no-Time target may still capture an envelope for schema/identity checks.
    Ok(())
}

// Rust: Source/CmdProve.rs:2050
fn preflight_replay_target(target: Target, json_mode: Bool) -> () Int32! {
    sites :: capture_sites_for_target(target)
    time_sites :: sites.iter().filter(supported_time_capture_site).count()
    if time_sites > 1 {
        emit_prove_diag("E3623", "replay diverged from captured authority",
            "the target requests more than one `core.time.now` site, but the artifact has one bounded Time record",
            "recapture a target with one supported Time request, or route time through an injected deterministic input", json_mode)
        return Err(ExitCodes.USER_ERROR)
    }
    loop site in sites {
        if supported_time_capture_site(site) -> continue
        operation :: site.operation
        why :: if site.effect == {
            .Some(.Time) -> "replay reached unsupported Time operation at {operation}; the artifact records only `core.time.now`"
            .Some(effect) -> "replay reached unrecorded {effect.name()} authority at {operation}"
            .None -> "replay reached an opaque authority boundary at {operation}"
        }
        emit_prove_diag("E3623", "replay diverged from captured authority", why,
            "recapture with a supported Time-only target, or remove the unrecorded boundary", json_mode)
        return Err(ExitCodes.USER_ERROR)
    }
    Ok(())
}

// Rust: Source/CmdProve.rs:2090
fn supported_time_capture_site(site: CaptureSite) -> Bool {
    site.effect == Some(Effect.Time) && site.operation.rsplit(".").next() == Some("now")
}

// Rust: Source/CmdProve.rs:2095
fn capture_sites_for_target(target: Target) -> [CaptureSite] {
    local_functions := Set[String].new()
    loop member in target.members {
        source :: String.from_utf8_lossy(member.bytes)
        (tokens, lex_diagnostics) :: jet.Lexer.lex(source)
        if !lex_diagnostics.is_empty() -> continue
        program :: if jet.Parser.parse_with_source(tokens, source) == { .Ok(program) -> program; .Err(_) -> continue }
        collect_capture_function_names(program.items, &local_functions)
    }
    sites := [CaptureSite]{}
    loop member in target.members {
        source :: String.from_utf8_lossy(member.bytes)
        (tokens, lex_diagnostics) :: jet.Lexer.lex(source)
        if !lex_diagnostics.is_empty() -> continue
        program :: if jet.Parser.parse_with_source(tokens, source) == { .Ok(program) -> program; .Err(_) -> continue }
        aliases := [String:String]{}
        loop import in program.imports {
            if import.core_module_path() == .Some(module) {
                alias :: import.import_alias()
                aliases.insert(alias, module)
                if alias.rsplit(".").next() == .Some(short) -> aliases.entry(short).or_insert(module)
            }
            prefix :: if import.kind == { .Unqualified(module_alias, _) -> core_list_prefix(module_alias); _ -> None }
            if prefix == .Some(value) {
                loop binding in import.walk_bindings() {
                    if binding.original == None -> continue
                    module :: "{value}.{binding.original.unwrap()}"
                    if jet.Syntax.is_known_core_module(module) -> aliases.insert(binding.local, module)
                }
            }
        }
        collect_capture_items(program.items, aliases, local_functions, &sites)
    }
    sites
}

// Rust: Source/CmdProve.rs:2153
fn collect_capture_function_names(items: [Item], names: &Set[String]) -> {
    loop item in items {
        if item == {
            .Func(func) -> names.insert(func.name)
            .Impl(implementation) -> names.extend(implementation.methods.iter().map((func) -> func.name))
            .Struct(definition) -> names.extend(definition.methods.iter().map((func) -> func.name))
            .Enum(definition) -> names.extend(definition.methods.iter().map((func) -> func.name))
            .CodeModule(module) -> { if module.body == .Some(body) -> collect_capture_function_names(body, names) }
            _ -> {}
        }
    }
}

// Rust: Source/CmdProve.rs:2178
fn capture_preflight_error(code: String, operation: String, why: String, fix: String, json_mode: Bool) -> () Int32! {
    what :: if code == "E3627" -> "replay capture refused sensitive data" else -> "replay capture cannot model {operation}"
    emit_prove_diag(code, what, why, fix, json_mode)
    Err(ExitCodes.USER_ERROR)
}

use jet.AST.[Func, Stmt, ForKind, StrPart, EnumLitArg, LambdaBody, OrFallback]

// Rust: Source/CmdProve.rs:2194
fn collect_capture_items(items: [Item], aliases: [String:String], local_functions: Set[String], sites: &[CaptureSite]) -> {
    loop item in items {
        if item == {
            .Func(func) -> collect_capture_func(func, aliases, local_functions, sites)
            .Impl(implementation) -> { loop func in implementation.methods -> collect_capture_func(func, aliases, local_functions, sites) }
            .Struct(definition) -> { loop func in definition.methods -> collect_capture_func(func, aliases, local_functions, sites) }
            .Enum(definition) -> { loop func in definition.methods -> collect_capture_func(func, aliases, local_functions, sites) }
            .Test(test) -> collect_capture_statements(test.body, aliases, local_functions, sites)
            .CodeModule(module) -> { if module.body == .Some(body) -> collect_capture_items(body, aliases, local_functions, sites) }
            _ -> {}
        }
    }
}

// Rust: Source/CmdProve.rs:2231
fn collect_capture_func(func: Func, aliases: [String:String], local_functions: Set[String], sites: &[CaptureSite]) -> {
    collect_capture_statements(func.body, aliases, local_functions, sites)
}

// Rust: Source/CmdProve.rs:2240
fn collect_capture_statements(statements: [Stmt], aliases: [String:String], local_functions: Set[String], sites: &[CaptureSite]) -> {
    loop statement in statements {
        if statement == {
            .Expr(expr) | .Yield(expr, _) | .DeferClose{close: expr, ..} -> collect_capture_expr(expr, aliases, local_functions, sites)
            .Val(binding) -> collect_capture_expr(binding.init, aliases, local_functions, sites)
            .Assign{target, value, ..} -> {
                collect_capture_lvalue(target, aliases, local_functions, sites)
                collect_capture_expr(value, aliases, local_functions, sites)
            }
            .Return(.Some(expr), _) | .BreakValue(expr, _) | .BreakLabelValue(_, _, expr, _) -> collect_capture_expr(expr, aliases, local_functions, sites)
            .While{cond, body, ..} -> {
                collect_capture_expr(cond, aliases, local_functions, sites)
                collect_capture_statements(body, aliases, local_functions, sites)
            }
            .For{kind, body, ..} -> {
                if kind == {
                    .Range{start, end, step, ..} -> {
                        collect_capture_expr(start, aliases, local_functions, sites)
                        collect_capture_expr(end, aliases, local_functions, sites)
                        if step == .Some(value) -> collect_capture_expr(value, aliases, local_functions, sites)
                    }
                    .In{collection, step} -> {
                        collect_capture_expr(collection, aliases, local_functions, sites)
                        if step == .Some(value) -> collect_capture_expr(value, aliases, local_functions, sites)
                    }
                }
                collect_capture_statements(body, aliases, local_functions, sites)
            }
            .Switch{subject, arms, else_body, ..} | .ComptimeSwitch{subject, arms, else_body, ..} -> {
                collect_capture_expr(subject, aliases, local_functions, sites)
                loop arm in arms {
                    collect_capture_expr(arm.cond, aliases, local_functions, sites)
                    collect_capture_statements(arm.body, aliases, local_functions, sites)
                }
                if else_body == .Some(body) -> collect_capture_statements(body, aliases, local_functions, sites)
            }
            .CountedLoop{init, cond, step, body, ..} -> {
                collect_capture_expr(init.init, aliases, local_functions, sites)
                collect_capture_expr(cond, aliases, local_functions, sites)
                if step == .Some(value) -> collect_capture_statements([value], aliases, local_functions, sites)
                collect_capture_statements(body, aliases, local_functions, sites)
            }
            .Unsafe{body, ..} -> {
                sites.push(CaptureSite{operation: "#Unsafe raw boundary", effect: None})
                collect_capture_statements(body, aliases, local_functions, sites)
            }
            .TaskGroup{body, ..} | .Reactive{body, ..} -> {
                sites.push(CaptureSite{operation: "task/concurrency boundary", effect: None})
                collect_capture_statements(body, aliases, local_functions, sites)
            }
            .Impure{body, ..} -> {
                sites.push(CaptureSite{operation: "comptime impure boundary", effect: None})
                collect_capture_statements(body, aliases, local_functions, sites)
            }
            .Live{body, ..} -> {
                sites.push(CaptureSite{operation: "live terminal boundary", effect: None})
                collect_capture_statements(body, aliases, local_functions, sites)
            }
            .AssumeDet{body, ..} -> {
                sites.push(CaptureSite{operation: "assume-deterministic boundary", effect: None})
                collect_capture_statements(body, aliases, local_functions, sites)
            }
            .Loop{body, ..} | .Shield{body, ..} | .Switched{body, ..} | .Region{body, ..}
                | .Policy{body, ..} | .Layout{body, ..} | .AuthorityScope{body, ..}
                | .ComptimeBlock{body, ..} | .Transact{body, ..} -> collect_capture_statements(body, aliases, local_functions, sites)
            .ContextBlock{fields, body, ..} -> {
                sites.push(CaptureSite{operation: "context block boundary", effect: None})
                loop (_, value, _) in fields -> collect_capture_expr(value, aliases, local_functions, sites)
                collect_capture_statements(body, aliases, local_functions, sites)
            }
            .ScopeMember{args, body, ..} -> {
                sites.push(CaptureSite{operation: "scope member boundary", effect: None})
                loop arg in args -> collect_capture_expr(arg, aliases, local_functions, sites)
                collect_capture_statements(body, aliases, local_functions, sites)
            }
            .Return(.None, _) | .Break(_) | .Continue(_) | .BreakLabel(..) | .ContinueLabel(..) -> {}
            _ -> sites.push(CaptureSite{operation: "unsupported statement boundary", effect: None})
        }
    }
}

// Rust: Source/CmdProve.rs:2406
fn collect_capture_lvalue(target: LValue, aliases: [String:String], local_functions: Set[String], sites: &[CaptureSite]) -> {
    if target == {
        .Local{..} -> {}
        .Index{base, index, ..} -> {
            collect_capture_expr(base, aliases, local_functions, sites)
            collect_capture_expr(index, aliases, local_functions, sites)
        }
        .Field{base, ..} -> collect_capture_expr(base, aliases, local_functions, sites)
    }
}

// Rust: Source/CmdProve.rs:2424
fn collect_capture_expr(expr: Expr, aliases: [String:String], local_functions: Set[String], sites: &[CaptureSite]) -> {
    if expr == {
        .Call(call) -> {
            if local_functions.contains(call.name) {
                // Local transitive boundaries are covered by the same callee walk.
            } else if jet.Sema.builtin_effect(call.name) == .Some(effect) -> sites.push(CaptureSite{operation: call.name, effect: Some(effect)})
            else if call.name.rsplit_once(".") == .Some((module, method)) {
                resolved_module :: aliases.get(module).unwrap_or(module)
                if jet.Sema.core_effect(resolved_module, method) == .Some(effect) -> sites.push(CaptureSite{operation: call.name, effect: Some(effect)})
                else if !aliases.contains_key(module) -> sites.push(CaptureSite{operation: call.name, effect: None})
                // Imported Core pure calls add no site; sema rejects unknown methods.
            } else -> sites.push(CaptureSite{operation: call.name, effect: None})
            loop arg in call.args -> collect_capture_expr(arg.expr, aliases, local_functions, sites)
        }
        .MethodCall{receiver, method, args, ..} -> {
            recognized := false
            if capture_receiver_path(receiver) == .Some(path) {
                parts := path.split(".")
                if parts.next() == .Some(alias) {
                    if aliases.get(alias) == .Some(module) {
                        suffix :: parts.collect().join(".")
                        resolved :: if suffix.is_empty() -> module else -> "{module}.{suffix}"
                        if jet.Sema.core_effect(resolved, method) == .Some(effect) {
                            recognized = true
                            sites.push(CaptureSite{operation: "{resolved}.{method}", effect: Some(effect)})
                        } else if aliases.contains_key(alias) -> recognized = true
                    }
                }
            }
            if !recognized -> sites.push(CaptureSite{operation: "method call {method}", effect: None})
            collect_capture_expr(receiver, aliases, local_functions, sites)
            loop arg in args -> collect_capture_expr(arg.expr, aliases, local_functions, sites)
        }
        .CallValue{callee, args, ..} -> {
            sites.push(CaptureSite{operation: "opaque callable", effect: None})
            collect_capture_expr(callee, aliases, local_functions, sites)
            loop arg in args -> collect_capture_expr(arg.expr, aliases, local_functions, sites)
        }
        .Str(parts, _) -> {
            loop part in parts { if part == .Interp(value, _) -> collect_capture_expr(value, aliases, local_functions, sites) }
        }
        .ListLit(items, _) -> { loop item in items -> collect_capture_expr(item, aliases, local_functions, sites) }
        .TupleLit(items, _, _) -> { loop (_, item) in items -> collect_capture_expr(item, aliases, local_functions, sites) }
        .MemberSpread{base, ..} | .Spread(base, _) | .Deref(base, _) | .RawOf(base, _)
            | .Copy(base, _) | .Place(base, _, _) | .Field(base, _, _) | .Present(base, _)
            | .Ok(base, _) | .Err(base, _) | .Paren(base, _) -> collect_capture_expr(base, aliases, local_functions, sites)
        .Try(base, _, _, note) -> {
            collect_capture_expr(base, aliases, local_functions, sites)
            if note == .Some(value) -> collect_capture_expr(value, aliases, local_functions, sites)
        }
        .MapLit(entries, _) -> {
            loop (key, value) in entries {
                collect_capture_expr(key, aliases, local_functions, sites)
                collect_capture_expr(value, aliases, local_functions, sites)
            }
        }
        .Index{base, index, ..} -> {
            collect_capture_expr(base, aliases, local_functions, sites)
            collect_capture_expr(index, aliases, local_functions, sites)
        }
        .Slice{base, start, end, range, ..} -> {
            collect_capture_expr(base, aliases, local_functions, sites)
            if range == .Some(value) -> collect_capture_expr(value, aliases, local_functions, sites)
            else {
                collect_capture_expr(start, aliases, local_functions, sites)
                collect_capture_expr(end, aliases, local_functions, sites)
            }
        }
        .Range{start, end, ..} -> {
            collect_capture_expr(start, aliases, local_functions, sites)
            collect_capture_expr(end, aliases, local_functions, sites)
        }
        .Unary(_, inner, _) -> collect_capture_expr(inner, aliases, local_functions, sites)
        .Binary(_, left, right, _) -> {
            collect_capture_expr(left, aliases, local_functions, sites)
            collect_capture_expr(right, aliases, local_functions, sites)
        }
        .CompareChain{operands, ..} -> { loop operand in operands -> collect_capture_expr(operand, aliases, local_functions, sites) }
        .OptField{base, ..} -> collect_capture_expr(base, aliases, local_functions, sites)
        .StructLit{fields, ..} -> { loop (_, _, value) in fields -> collect_capture_expr(value, aliases, local_functions, sites) }
        .TypedLit{body, ..} -> body.for_each_expr((value) -> collect_capture_expr(value, aliases, local_functions, sites))
        .EnumLit{args, ..} -> {
            loop arg in args {
                if arg == {
                    .Positional(value) | .Named{expr: value, ..} -> collect_capture_expr(value, aliases, local_functions, sites)
                }
            }
        }
        .Tainted(inner, _, _) -> collect_capture_expr(inner, aliases, local_functions, sites)
        .PatternTest{subject, pattern, ..} -> {
            collect_capture_expr(subject, aliases, local_functions, sites)
            collect_capture_pattern(pattern, aliases, local_functions, sites)
        }
        .If{cond, then_body, then_value, else_body, else_value, ..} -> {
            collect_capture_expr(cond, aliases, local_functions, sites)
            collect_capture_statements(then_body, aliases, local_functions, sites)
            collect_capture_expr(then_value, aliases, local_functions, sites)
            collect_capture_statements(else_body, aliases, local_functions, sites)
            collect_capture_expr(else_value, aliases, local_functions, sites)
        }
        .Lambda(lambda) -> {
            if lambda.body == {
                .Expr(value) -> collect_capture_expr(value, aliases, local_functions, sites)
                .Block(body) -> collect_capture_statements(body, aliases, local_functions, sites)
            }
        }
        .OrFallback{value, fallback, ..} -> {
            collect_capture_expr(value, aliases, local_functions, sites)
            if fallback == {
                .Value(value) | .Return(.Some(value), _) -> collect_capture_expr(value, aliases, local_functions, sites)
                .Panic{args, ..} -> { loop arg in args -> collect_capture_expr(arg.expr, aliases, local_functions, sites) }
                _ -> {}
            }
        }
        .PtrFromAddr{addr, ..} -> {
            sites.push(CaptureSite{operation: "native pointer boundary", effect: None})
            collect_capture_expr(addr, aliases, local_functions, sites)
        }
        .StrMatchLit(_, _) | .BinMatchLit(_, _) | .Int(..) | .Float(..) | .Bool(..) | .Char(..)
            | .Ident(..) | .UnitLit{..} | .Absent(_) | .Todo{..} | .ReduceMarker(..) | .ComptimeName{..} -> {}
        _ -> sites.push(CaptureSite{operation: "unsupported expression boundary", effect: None})
    }
}

use jet_foundation.Span

// Rust: Source/CmdProve.rs:2684
fn collect_capture_pattern(pattern: Pattern, aliases: [String:String], local_functions: Set[String], sites: &[CaptureSite]) -> {
    if pattern == {
        .Or(patterns, _) -> { loop child in patterns -> collect_capture_pattern(child, aliases, local_functions, sites) }
        .Struct{fields, ..} -> {
            loop field in fields { if field == .Value{value, ..} -> collect_capture_expr(value, aliases, local_functions, sites) }
        }
        .Variant{..} | .Present{..} | .Absent(_) | .Ok{..} | .Err{..}
            | .Range{..} | .StrMatch{..} | .BinMatch{..} -> {}
    }
}

// Rust: Source/CmdProve.rs:2714
fn capture_receiver_path(expr: Expr) -> String? {
    if expr == {
        .Ident(name, _) -> Some(name)
        .Field(base, field, _) -> Some("{capture_receiver_path(base)?}.{field}")
        _ -> None
    }
}

// Rust: Source/CmdProve.rs:2722
fn semantic_front_end_items(target: Target, path: String, source: String) -> ([FrontEndItem], [ContractDeclaration]) {
    (tokens, lex_diagnostics) :: jet.Lexer.lex(source)
    program :: if lex_diagnostics.is_empty() -> jet.Parser.parse_with_source(tokens, source).ok() else -> None
    if program == None -> return ([generic_front_end_item(target, path, source)], [])
    facts := [FrontEndItem]{}
    declarations := [ContractDeclaration]{}
    collect_semantic_items(target, path, source, program.unwrap().items, &facts, &declarations)
    if facts.is_empty() -> facts.push(generic_front_end_item(target, path, source))
    (facts, declarations)
}

// Rust: Source/CmdProve.rs:2756
fn generic_front_end_item(target: Target, path: String, source: String) -> FrontEndItem {
    FrontEndItem{id: evidence_id(target, "front_end", path, "1:1-1:1", "program checked"),
        path: path, diagnostic: None, source: source, facet: "all", line: 1, column: 1}
}

// Rust: Source/CmdProve.rs:2768
fn collect_semantic_items(target: Target, path: String, source: String, items: [Item],
    facts: &[FrontEndItem], declarations: &[ContractDeclaration]) -> {
    loop item in items {
        if item == {
            .Func(func) -> collect_func_semantics(target, path, source, func, facts, declarations)
            .Impl(implementation) -> { loop func in implementation.methods -> collect_func_semantics(target, path, source, func, facts, declarations) }
            .Struct(definition) -> { loop func in definition.methods -> collect_func_semantics(target, path, source, func, facts, declarations) }
            .Enum(definition) -> { loop func in definition.methods -> collect_func_semantics(target, path, source, func, facts, declarations) }
            .Distinct(definition) -> {
                if definition.range == .Some((lower, upper, span)) -> push_front_end_fact(target, path, source, facts,
                    "refinements", "refinement", span, "{definition.name} range [{lower}, {upper}]")
            }
            .CodeModule(module) -> { if module.body == .Some(body) -> collect_semantic_items(target, path, source, body, facts, declarations) }
            _ -> {}
        }
    }
}

// Rust: Source/CmdProve.rs:2820
fn collect_func_semantics(target: Target, path: String, source: String, func: Func,
    facts: &[FrontEndItem], declarations: &[ContractDeclaration]) -> {
    loop (marker, clauses) in [("Pre", func.pre), ("Post", func.post)] {
        loop clause in clauses {
            span :: clause.cond.span()
            (line, column) :: span_line_col(source, span.start)
            span_label :: span_text(source, span)
            claim :: normalized_claim(source, span)
            message :: if clause.message_expr == {
                .Str(parts, _) -> {
                    if parts.len() == 1 -> if parts[0] == { .Lit(value) -> Some(value); _ -> None } else -> None
                }
                _ -> None
            }
            declarations.push(ContractDeclaration{id: evidence_id(target, "contract", path, span_label, claim),
                path: path, line: line, column: column, marker: marker, message: message})
        }
    }
    if func.declared_effects == .Some(effects) {
        span :: effects.first().map((pair) -> pair.1).unwrap_or(func.span)
        names :: effects.iter().map((pair) -> pair.0).collect().join(",")
        push_front_end_fact(target, path, source, facts, "effects", "effect", span, "{func.name} effect bound [{names}]")
    }
    if func.effect_via == .Some((callback, span)) -> push_front_end_fact(target, path, source, facts, "effects", "effect", span, "{func.name} effects via {callback}")
    if func.scrub_tag == .Some(tag) -> push_front_end_fact(target, path, source, facts, "taint", "taint", func.span, "{func.name} scrubs {tag}")
    if func.is_replayable -> push_front_end_fact(target, path, source, facts, "replay", "replayability", func.replayable_span.unwrap_or(func.span), "{func.name} is replayable")
}

// Rust: Source/CmdProve.rs:2907
fn push_front_end_fact(target: Target, path: String, source: String, facts: &[FrontEndItem],
    facet: String, id_kind: String, span: Span, claim: String) -> {
    span_label :: span_text(source, span)
    (line, column) :: span_line_col(source, span.start)
    facts.push(FrontEndItem{id: evidence_id(target, id_kind, path, span_label, claim),
        path: path, diagnostic: None, source: source, facet: facet, line: line, column: column})
}

// Rust: Source/CmdProve.rs:2930
fn span_text(source: String, span: Span) -> String {
    (start_line, start_column) :: span_line_col(source, span.start)
    (end_line, end_column) :: span_line_col(source, span.end)
    "{start_line}:{start_column}-{end_line}:{end_column}"
}

// Rust: Source/CmdProve.rs:2936
fn normalized_claim(source: String, span: Span) -> String {
    source.get(span.start..<span.end).unwrap_or("").split_whitespace().collect().join(" ")
}

// Rust: Source/CmdProve.rs:2945
fn host_target_triple() -> String {
    "{core.sys.target.selected_arch()}-{core.sys.target.selected_os()}" // GATE #4483
}

// Rust: Source/CmdProve.rs:2949
const PROOF_LENSES: [String] = ["all", "refinements", "effects", "taint", "contracts", "tests", "budgets", "replay", "solver"]

// Rust: Source/CmdProve.rs:2961
fn validate_lens(value: String, target: String, json_mode: Bool) -> {
    if PROOF_LENSES.contains(value) -> return
    what :: "unknown proof lens `{value}`"
    why :: "`jet prove` accepts all, refinements, effects, taint, contracts, tests, budgets, replay, solver"
    fix :: "try `jet prove {target} --lens tests`"
    emit_cli_report_for_action("prove", "E2941", what, why, fix, json_mode)
    exit(ExitCodes.USAGE)
}

use jet_foundation.Evidence.[EvidenceReport, EvidenceKind, EvidenceOutcome, decode_report_bytes,
    EVIDENCE_REPORT_ENV, EVIDENCE_REPORT_ID_ENV, EVIDENCE_TOOLCHAIN_ENV, EVIDENCE_TARGET_ENV,
    EVIDENCE_PROFILE_ENV, EVIDENCE_SOURCE_REVISION_ENV, EVIDENCE_BUILD_REVISION_ENV, EVIDENCE_REVISION_ENV]
use core.files as fs
use core.process.[Command, Stdio]
use core.time.[Duration, Instant]
use core.thread
// GATE #4494: native process supervision, concurrent pipe drains, OS errors and FFI.

// Rust: Source/CmdProve.rs:2972
fn run_test_producers(target: Target) -> ([TestItem], Int32, [RecordLink]) Err! {
    items := [TestItem]{}
    highest_exit := ExitCodes.OK
    evidence_links := [RecordLink]{}
    loop member in target.members {
        if !jet.has_test_blocks(member.path) && !jet.has_test_contracts(member.path)
            && jet.Doctest.discover(String.from_utf8_lossy(member.bytes)).is_empty() -> continue
        prefix :: member.sha256[0..<16]
        report_path :: core.env.temp_dir().join("jet_prove_test_{core.process.id()}_{prefix}.bin")
        _ :: fs.remove_file(report_path)
        command := Command.new(core.env.current_exe().unwrap_or_else((_) -> OSPath.new("jet")))
        command.args(["test", member.path, "--serial", "--show-default"])
            .env(EVIDENCE_REPORT_ENV, report_path).env(EVIDENCE_REPORT_ID_ENV, "prove:{prefix}")
            .env(EVIDENCE_TOOLCHAIN_ENV, jet.VERSION).env(EVIDENCE_TARGET_ENV, host_target_triple())
            .env(EVIDENCE_PROFILE_ENV, "dev").env(EVIDENCE_SOURCE_REVISION_ENV, target.source_digest)
            .env(EVIDENCE_BUILD_REVISION_ENV, target.build_digest).env(EVIDENCE_REVISION_ENV, target.mir.optimized_hash)
            .env("JET_PROVE_FRESH_TEST", "1").env_remove("JET_PROP_REPLAY_SEED").env_remove("JET_PROP_REPLAY_CASE")
        replay_failure :: read_generated_failure(target, member)
        if replay_failure == .Some(failure) {
            command.env("JET_PROP_SEED", failure.seed.to_string()).env("JET_PROP_REPLAY_SEED", failure.seed.to_string())
                .env("JET_PROP_REPLAY_CASE", failure.case_index.to_string())
        }
        property_seed :: replay_failure.map((failure) -> failure.seed)
            .or_else(() -> core.env.var("JET_PROP_SEED").ok().and_then((seed) -> seed.parse[UInt64]().ok())).unwrap_or(DEFAULT_PROPERTY_SEED)
        if supervise_child(&command, Duration.from_secs(120)) == {
            .Exited(.Some(code)) -> {
                if code == ExitCodes.ICE -> highest_exit = ExitCodes.ICE
                else if code == ExitCodes.RUNTIME_PANIC && highest_exit != ExitCodes.ICE -> highest_exit = ExitCodes.RUNTIME_PANIC
                else if code == ExitCodes.USER_ERROR && highest_exit == ExitCodes.OK -> highest_exit = ExitCodes.USER_ERROR
                if read_test_report(report_path) == {
                    .Ok(report) -> {
                        persist_generated_failure(target, member, report)?
                        report_link :: if persist_evidence_report(target, report) == {
                            .Ok(link) -> link
                            .Err(error) -> { _ :: fs.remove_file(report_path); return Err(error) }
                        }
                        evidence_links.push(report_link)
                        invalid_records :: report.records.is_empty() || report.records.iter().any((record) ->
                            record.kind != .Property && !record.source.path.is_empty() && !producer_path_is_member(target, record.source.path))
                        if invalid_records -> highest_exit = ExitCodes.ICE
                        else {
                            if report.records.iter().any((record) -> record.kind == .Runtime
                                || (record.kind == .Contract && record.outcome == .Failed)) && highest_exit != ExitCodes.ICE -> highest_exit = ExitCodes.RUNTIME_PANIC
                            loop record in report.records {
                                kind :: record.kind
                                kind_code :: kind.code()
                                outcome :: record.outcome
                                name :: record.identity.claim_id
                                message :: record.detail
                                property_failure :: if kind == .Property -> parse_generated_failure_detail(message) else -> None
                                generation_unavailable :: kind == .Property && property_generation_unavailable(message)
                                generated :: kind == .Property && !outcome.is_incomplete() && !generation_unavailable
                                generated_count :: if generated -> record.count else -> 0
                                source_path :: record.source.path
                                if (kind == .Runtime && (name == "E3005" || message.starts_with("Stop [")))
                                    || (kind == .Unit && message.starts_with("Stop [")) -> continue
                                claim :: "{kind_code}:{name}:{message}"
                                line :: if kind == .Property -> UInt32.from(record.count) else -> record.source.line
                                state :: if generation_unavailable -> 3 else -> outcome.test_state().unwrap_or_else(() ->
                                    if outcome == .Failed -> 1 else if outcome.is_incomplete() -> 3 else -> 0)
                                seed :: property_failure.map((failure) -> failure.seed).unwrap_or(property_seed)
                                case_index :: property_failure.map((failure) -> failure.case_index).unwrap_or(0)
                                items.push(TestItem{
                                    id: evidence_id(target, if kind == .Contract -> "contract" else -> "unit", member.path, "0:0-0:0", claim),
                                    path: if kind == .Property || source_path.is_empty() -> member.path else -> source_path,
                                    state: state, kind: kind_code, message: message, line: line, name: name,
                                    seed: if kind == .Property -> seed.to_string() else -> "", case_index: case_index,
                                    generated: generated, generated_count: generated_count,
                                    reason: if generation_unavailable -> "generation_unavailable" else -> "",
                                })
                            }
                        }
                    }
                    .Err(_) -> {
                        if code == ExitCodes.USER_ERROR {
                            if highest_exit == ExitCodes.OK -> highest_exit = ExitCodes.USER_ERROR
                        } else -> highest_exit = ExitCodes.ICE
                    }
                }
            }
            .Exited(.None) -> highest_exit = ExitCodes.ICE
            .TimedOut | .LaunchFailed -> items.push(TestItem{
                id: evidence_id(target, "unit", member.path, "0:0-0:0", "producer unavailable"),
                path: member.path, state: 3, kind: 0, message: "", line: 0, generated: false,
                generated_count: 0, name: "", seed: "", case_index: 0, reason: "producer_start_failed",
            })
        }
        _ :: fs.remove_file(report_path)
    }
    Ok((items, highest_exit, evidence_links))
}

// Rust: Source/CmdProve.rs:3206
fn producer_path_is_member(target: Target, path: String) -> Bool {
    normalized_path := path.trim_start_matches("./").replace("\\", "/") // #4303
    target.members.iter().any((member) -> member.path.trim_start_matches("./").replace("\\", "/") == normalized_path)
}

// Rust: Source/CmdProve.rs:3214
fn supervise_child(command: &Command, deadline: Duration) -> ChildOutcome {
    // Concurrent drains prevent full-pipe deadlock; transcripts stay private and bounded.
    configure_child_process_group(command)
    command.stdout(Stdio.piped()).stderr(Stdio.piped())
    child := if command.spawn() == { .Ok(child) -> child; .Err(_) -> return ChildOutcome.LaunchFailed }
    stdout := child.stdout.take().map((stream) -> thread.spawn(() -> {
        owned := ^stream
        capture_child_stream(&owned)
    }))
    stderr := child.stderr.take().map((stream) -> thread.spawn(() -> {
        owned := ^stream
        capture_child_stream(&owned)
    }))
    finish :: (outcome) -> {
        if stdout.take() == .Some(worker) -> _ :: worker.join()
        if stderr.take() == .Some(worker) -> _ :: worker.join()
        outcome
    }
    started :: Instant.now()
    loop {
        if child.try_wait() == {
            .Ok(.Some(status)) -> return finish(ChildOutcome.Exited(status.code()))
            .Ok(.None) -> {
                if started.elapsed() < deadline -> thread.sleep(Duration.from_millis(5))
                else {
                    terminate_child_process_group(child.id())
                    _ :: child.kill()
                    _ :: child.wait()
                    return finish(ChildOutcome.TimedOut)
                }
            }
            .Err(_) -> {
                terminate_child_process_group(child.id())
                _ :: child.kill()
                _ :: child.wait()
                return finish(ChildOutcome.Exited(None))
            }
        }
    }
}

// Rust: Source/CmdProve.rs:3267,3284
fn configure_child_process_group(command: &Command) -> {
    if core.sys.target.selected_family() == "unix" { // GATE #4483
        #Unsafe("pre-exec callback invokes async-signal-safe setpgid only") {
            command.pre_exec(() -> {
                if setpgid(0, 0) == 0 -> Ok(()) else -> Err(core.io.Error.last_os_error())
            })
        }
    }
    // Rust's non-Unix arm intentionally has no process-group setup.
}

// Rust: Source/CmdProve.rs:3272
#FFI(c)
extern fn setpgid(pid: Int32, pgid: Int32) -> Int32

// Rust: Source/CmdProve.rs:3287,3297
fn terminate_child_process_group(pid: UInt32) -> {
    if core.sys.target.selected_family() == "unix" {
        #Unsafe("negative pid addresses the isolated child process group") { _ :: kill(-Int32.from(pid), 9) }
    }
    // Rust's non-Unix arm relies on the caller's child.kill().
}

// Rust: Source/CmdProve.rs:3289
#FFI(c)
extern fn kill(pid: Int32, signal: Int32) -> Int32

// Rust: Source/CmdProve.rs:3299
fn capture_child_stream[T: core.io.Read](stream: &T) -> [UInt8] {
    const MAX_TRANSCRIPT_BYTES: USize = 64 * 1024
    captured := [UInt8]{}
    buffer := [UInt8; 8192].filled(0)
    loop {
        if stream.read(&buffer) == {
            .Ok(0) -> break
            .Ok(count) -> {
                remaining :: MAX_TRANSCRIPT_BYTES.saturating_sub(captured.len())
                captured.extend_from_slice(buffer[0..<count.min(remaining)])
            }
            .Err(_) -> break
        }
    }
    captured
}

// Rust: Source/CmdProve.rs:3316
fn read_test_report(path: OSPath) -> EvidenceReport Err! { EvidenceReport.read(path) }

// Rust: Source/CmdProve.rs:3320
fn read_test_report_bytes(bytes: [UInt8]) -> EvidenceReport Err! {
    (records, derivations) :: decode_report_bytes(bytes)?
    report_id :: records.first().map((record) -> record.identity.report_id).unwrap_or("test-run")
    EvidenceReport.try_from_records_with_derivations(report_id, records, derivations).map_err((error) -> error.to_string())
}

// Rust: Source/CmdProve.rs:3335,3371,3385,3398
// Protocol and real subprocess tests live in Tests/Cli/Evidence/Prove02.jet.

// Rust: Source/CmdProve.rs:3434
pub fn target_input_sha256_for_file(file: String) -> String Err! {
    resolve_target(file).map((target) -> target.input_sha256)
}

// Rust: Source/CmdProve.rs:3437
fn resolve_target(raw: String) -> Target Err! {
    path :: OSPath.new(raw)
    metadata :: fs.symlink_metadata(path).map_err((error) -> {
        if error.kind() == .NotFound -> "can't find proof target `{raw}`" // GATE #4409
        else -> "can't inspect proof target `{raw}`: {error}"
    })?
    if metadata.file_type().is_symlink() -> return Err("proof target `{raw}` must not be a symlink")
    reject_symlink_ancestors(path)?
    (kind, paths) := if metadata.is_file() -> {
        if path.extension().and_then((ext) -> ext.to_str()) != Some(jet.Syntax.FILE_EXT) -> return Err("proof target `{raw}` is not a .jet file")
        ("file", [path])
    } else -> {
        if !metadata.is_dir() -> return Err("proof target `{raw}` is not a file or directory")
        kind :: if has_proof_manifest(path, jet.Syntax.PACKAGE_FILE)? -> "package" else -> "workspace"
        found := [OSPath]{}
        collect_jet_files(path, &found)?
        if found.is_empty() -> return Err("proof target `{raw}` contains no .jet files")
        (kind, found)
    }
    paths.sort_by((a, b) -> normalized(a).as_bytes().cmp(normalized(b).as_bytes()))
    members := [Member].with_capacity(paths.len())
    loop member_path in paths {
        bytes :: fs.read(member_path).map_err((error) -> "couldn't read `{member_path.display()}`: {error}")?
        members.push(Member{path: normalized(member_path), sha256: sha256_hex(bytes), bytes: bytes})
    }
    identity_members := members.iter().map((member) -> (member.path, member.sha256)).collect()
    if metadata.is_dir() {
        closure_paths := [OSPath]{}
        collect_identity_files(path, &closure_paths)?
        loop closure_path in closure_paths {
            bytes :: fs.read(closure_path).map_err((error) -> "couldn't read `{closure_path.display()}`: {error}")?
            normalized_path :: normalized(closure_path)
            if !identity_members.iter().any((member) -> member.0 == normalized_path) -> identity_members.push((normalized_path, sha256_hex(bytes)))
        }
    } else {
        manifest_root :: path.parent().and_then(jet.Loader.find_manifest_root)
            .map((root) -> if root.as_os_str().is_empty() -> OSPath.new(".") else -> root)
        if manifest_root == .Some(root) {
            closure_paths := [OSPath]{}
            collect_identity_files(root, &closure_paths)?
            loop closure_path in closure_paths {
                bytes :: fs.read(closure_path).map_err((error) -> "couldn't read `{closure_path.display()}`: {error}")?
                normalized_path :: normalized(closure_path)
                if !identity_members.iter().any((member) -> member.0 == normalized_path) -> identity_members.push((normalized_path, sha256_hex(bytes)))
            }
        }
        // Production loader closure makes identity sensitive to imported sources.
        (_, dependencies) :: jet.Loader.load_entry_with_overlays_and_dependencies(raw, [], true)
        loop dependency in dependencies {
            dependency_metadata :: if fs.symlink_metadata(dependency) == {
                .Ok(metadata) -> metadata
                .Err(error) -> {
                    if error.kind() == .NotFound -> continue // GATE #4409
                    return Err("couldn't inspect proof dependency `{dependency.display()}`: {error}")
                }
            }
            if dependency_metadata.file_type().is_symlink() -> return Err("proof target contains symlink `{dependency.display()}`")
            if !dependency_metadata.is_file() -> continue
            bytes :: fs.read(dependency).map_err((error) -> "couldn't read proof dependency `{dependency.display()}`: {error}")?
            dependency_path :: normalized(dependency)
            if !identity_members.iter().any((member) -> member.0 == dependency_path) -> identity_members.push((dependency_path, sha256_hex(bytes)))
        }
    }
    canonical :: jet.ReceiptStore.canonical_target_identity(path, identity_members)?
    canonical_members :: canonical.members
    input_sha256 :: canonical.input_sha256
    authority_root :: canonical.authority_root
    source_records :: canonical_members.iter().filter((member) -> member.0.ends_with(".jet"))
        .map((member) -> (member.0, member.1.as_bytes().to_vec())).collect()
    source_digest :: proof_digest("jet-proof-source-v2", source_records)
    lock_records :: canonical_members.iter().filter((member) -> is_lock_identity_path(member.0))
        .map((member) -> (member.0, member.1.as_bytes().to_vec())).collect()
    lock_digest :: proof_digest_or_none("jet-proof-lock-v2", lock_records)
    build_records :: canonical_members.iter().filter((member) -> is_build_identity_path(member.0))
        .map((member) -> (member.0, member.1.as_bytes().to_vec())).collect()
    build_inputs :: proof_digest_or_none("jet-proof-build-inputs-v2", build_records)
    build_digest :: proof_build_digest(build_inputs, lock_digest)?
    semantic_bundle :: if members.len() == 1 -> load_checked_proof_bundle(members[0].path, "dev", [String:String]{}) else -> None
    core_abi :: proof_core_abi(semantic_bundle.map((pair) -> pair.0), source_digest)
    mir :: proof_mir_identity(semantic_bundle, source_digest, core_abi, members)
    Ok(Target{kind: kind, root: normalized(path), authority_root: authority_root, identity_members: canonical_members,
        input_sha256: input_sha256, source_digest: source_digest, build_digest: build_digest,
        core_abi: core_abi, lock_digest: lock_digest, mir: mir, members: members})
}

