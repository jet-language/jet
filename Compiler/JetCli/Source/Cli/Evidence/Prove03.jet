fn test_failure_detail(item: &TestItem) -> String {
    source_line :: source_line_for(item.path, item.line) ?? ""
    caret :: source_line.chars().count().max(1)
    spaces :: " ".repeat(caret.saturating_sub(1))
    "  Stop [E3001]: {item.message}\n    --> {item.path}:{item.line}\n      {spaces}^\n  More: jet-lang.dev/e/E3001\n"
}
// Rust: Source/CmdProve.rs:4709
fn test_failure_json(item: &TestItem) -> String {
    source_line :: source_line_for(item.path, item.line)
    source_line_json :: source_line.map(line -> json(line)) ?? "null"
    width :: source_line.map_or(1, line -> line.chars().count().max(1))
    "{{\"caret\":{{\"startColumn\":1,\"width\":{width}}},\"code\":\"E3001\",\"context\":[],\"frames\":[],\"message\":{json(item.message)},\"notes\":[],\"origin\":{{\"producer\":\"jet-runtime\",\"stage\":\"runtime\"}},\"safeLocals\":[],\"severity\":\"error\",\"span\":{{\"endColumn\":{width + 1},\"endLine\":{item.line},\"path\":{json(item.path)},\"sourceLine\":{source_line_json},\"startColumn\":1,\"startLine\":{item.line}}},\"type\":\"runtime\"}}"
}
// Rust: Source/CmdProve.rs:4728
fn runtime_item_diagnostic(item: &TestItem) -> String { test_failure_json(item) }
