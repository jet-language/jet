    "{{\"source\":{{\"sha256\":{candidate_digest_json(target.source_digest)},\"contentSha256\":{candidate_digest_json(target.source_digest)},\"inputSha256\":{candidate_digest_json(target.input_sha256)}}},\"compiler\":{{\"sha256\":{candidate_digest_json(target.build_digest)},\"version\":{version}}},\"configuration\":{{\"coreAbi\":{json(target.core_abi)},\"lockSha256\":{candidate_digest_json(target.lock_digest)},\"profile\":\"dev\"}},\"generatedArtifact\":{{\"semanticMirSha256\":{candidate_digest_json(target.mir.semantic_hash)},\"optimizedMirSha256\":{candidate_digest_json(target.mir.optimized_hash)},\"mir\":{target.mir.canonical_json()}}},\"targetTool\":{{\"triple\":{json(host_target_triple())},\"adapter\":\"mir-v1\"}},\"proofModel\":{{\"id\":\"jet-prove-v1\"}},\"proofChecker\":{{\"id\":\"jet-prove-v1\"}}}}"
