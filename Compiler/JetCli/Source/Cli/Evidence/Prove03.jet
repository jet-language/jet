// Rust: Source/CmdProve.rs:4776
// D-JPROOF1=A: identical existing bytes stay unchanged; differing bytes refuse.
fn write_jetproof(target: &Target, proof_report: String, consumed: &[RecordLink], produced: &[RecordLink]) -> ProofArtifact Err! {
    report_bytes :: "{proof_report}\n"
    report_id :: SHA256.sha256_hex(report_bytes.as_bytes())
    kind :: target.kind
    root :: OSPath.from(target.root)
    stem :: (root.file_stem().and_then(s -> s.to_str()) ?? kind).replace('.', "_")
    name :: if stem.is_empty() { kind.to_string() } else { stem }
    short_id := report_id.get(0..<16.min(report_id.len())).unwrap()
    rel :: ".jet/proofs/{kind}/{name}/{short_id}.jetproof"
    path :: target.authority_root.join(rel)
    consumed_json :: record_links_json(consumed)
    produced_json :: record_links_json(produced)
    envelope :: "{{\"artifact\":{{\"path\":{json(rel)}}},\"consumed\":{consumed_json},\"links_version\":1,\"privacy\":{{\"absolute_paths\":\"omitted\",\"argv\":\"omitted\",\"environment\":\"omitted\",\"full_source\":\"omitted\",\"producer_transcripts\":\"omitted\",\"safe_locals\":\"redacted_by_D-OBS2\"}},\"produced\":{produced_json},\"proofReport\":{proof_report},\"report_id\":{json(report_id)},\"schema\":\"jet.jproof\",\"version\":2}}\n"
    ensure_artifact_parent(path)?
    // GATE #4494: no-follow metadata, exclusive create, hard-link publication and fsync.
    if fs.symlink_metadata(path) == {
        Ok(metadata) -> {
            if !metadata.file_type().is_file() { return Err("final .jetproof path is not a regular file: {rel}") }
            existing :: fs.read(path).map_err(e -> e.to_string())?
            if existing == envelope.as_bytes() {
                return Ok(ProofArtifact { artifact_id: report_id, path: ^path,
                    size: UInt64.try_from(envelope.len()).map_err(_ -> "proof artifact is too large")? })
            }
            return Err("refusing to overwrite differing .jetproof at {rel}")
        }
        Err(_) -> {}
    }
    hash := report_id.get(0..<8).unwrap()
    tmp :: path.with_extension("jetproof.tmp.{process.id()}.{hash}")
    write_result :: (() -> {
        file := fs.OpenOptions.new().write(true).create_new(true).open(tmp).map_err(e -> e.to_string())?
        // GATE #4483: selected-family cfg(unix).
        if core.sys.target.selected_family() == "unix" {
            file.set_permissions(fs.Permissions.from_mode(0o600)).map_err(e -> e.to_string())?
        }
        file.write_all(envelope.as_bytes()).map_err(e -> e.to_string())?
        file.sync_all().map_err(e -> e.to_string())?
        if fs.hard_link(tmp, path) == {
            Ok(_) -> {}
            Err(error) if error.kind() == std.io.ErrorKind.AlreadyExists -> {
                metadata :: fs.symlink_metadata(path).map_err(e -> e.to_string())?
                if metadata.file_type().is_symlink() || !metadata.is_file() { return Err("final .jetproof path is not a regular file: {rel}") }
                existing :: fs.read(path).map_err(e -> e.to_string())?
                if existing != envelope.as_bytes() { return Err("refusing to overwrite differing .jetproof at {rel}") }
            }
            Err(error) -> return Err(error.to_string())
        }
        fs.remove_file(tmp).map_err(e -> e.to_string())?
        if core.sys.target.selected_family() == "unix" {
            if path.parent() == {
                Val(parent) -> fs.File.open(parent).map_err(e -> e.to_string())?.sync_all().map_err(e -> e.to_string())?
                None -> {}
            }
        }
        Ok(())
    })()
    if write_result == {
        Err(error) -> { _ :: fs.remove_file(tmp); return Err(error) }
        Ok(_) -> {}
    }
    Ok(ProofArtifact { artifact_id: report_id, path: ^path,
        size: UInt64.try_from(envelope.len()).map_err(_ -> "proof artifact is too large")? })
}
// Rust: Source/CmdProve.rs:4889
fn ensure_artifact_parent(path: &OSPath) -> Void Err! {
    parent :: path.parent() ?? OSPath.from(".")
    current := if parent.is_absolute() { OSPath.from(std.path.MAIN_SEPARATOR.to_string()) } else { OSPath.from(".") }
    for component in parent.components() {
        if component == {
            RootDir | CurDir -> {}
            Normal(name) -> {
                current.push(name)
                if fs.symlink_metadata(current) == {
                    Ok(metadata) if metadata.file_type().is_symlink() -> return Err("artifact parent is a symlink: {current.display()}")
                    Ok(metadata) if !metadata.is_dir() -> return Err("artifact parent is not a directory: {current.display()}")
                    Ok(_) -> {}
                    Err(error) if error.kind() == std.io.ErrorKind.NotFound -> {
                        fs.create_dir(current).map_err(e -> e.to_string())?
                        // GATE #4483: selected-family cfg(unix); #4494: native permissions.
                        if core.sys.target.selected_family() == "unix" {
                            fs.set_permissions(current, fs.Permissions.from_mode(0o700)).map_err(e -> e.to_string())?
                        }
                    }
                    Err(error) -> return Err(error.to_string())
                }
            }
            ParentDir | Prefix(_) -> return Err("artifact parent contains an unsafe component")
        }
    }
    Ok(())
}
