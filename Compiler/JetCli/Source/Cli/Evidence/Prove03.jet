// Rust: Source/CmdProve.rs:3619
fn reject_symlink_ancestors(path: &OSPath) -> Void Err! {
    // GATE #4494: native cwd, path components, no-follow metadata.
    current := if path.is_absolute() { OSPath.from(std.path.MAIN_SEPARATOR.to_string()) }
        else { env.current_dir().map_err(error -> "couldn't resolve proof target parent: {error}")? }
    for component in path.components() {
        if component == {
            RootDir -> current = OSPath.from(std.path.MAIN_SEPARATOR.to_string())
            CurDir -> {}
            ParentDir -> { _ :: current.pop() }
            Normal(name) -> current.push(name)
            Prefix(_) -> return Err("proof target {path.display()} has an unsupported path prefix")
        }
        metadata :: fs.symlink_metadata(current).map_err(error -> "couldn't inspect proof target ancestor {current.display()}: {error}")?
        if metadata.file_type().is_symlink() {
            return Err("proof target {path.display()} must not pass through symlink {current.display()}")
        }
    }
    Ok(())
}

// Rust: Source/CmdProve.rs:3660
fn append_proof_field(bytes: &[UInt8], label: String, value: &[UInt8]) -> Void {
    bytes.extend_from_slice((label.len() as UInt64).to_be_bytes())
    bytes.extend_from_slice(label.as_bytes())
    bytes.extend_from_slice((value.len() as UInt64).to_be_bytes())
    bytes.extend_from_slice(value)
}
// Rust: Source/CmdProve.rs:3667
fn proof_digest(schema: String, fields: &[(String, [UInt8])]) -> String {
    bytes := []
    append_proof_field(&bytes, "schema", schema.as_bytes())
    for (label, value) in fields { append_proof_field(&bytes, label, value) }
    SHA256.sha256_hex(bytes)
}
// Rust: Source/CmdProve.rs:3676
fn proof_digest_or_none(schema: String, fields: &[(String, [UInt8])]) -> String {
    if fields.is_empty() { proof_digest(schema, &[("none", "<none>".as_bytes().to_vec())]) }
    else { proof_digest(schema, fields) }
}
// Rust: Source/CmdProve.rs:3684
fn is_lock_identity_path(path: String) -> Bool {
    path == ".jet/lock" || path.ends_with("/.jet/lock") ||
        path.rsplit('/').next().is_some_and(name -> name == "jet.lock" || name == "jet.lock.json")
}
// Rust: Source/CmdProve.rs:3690
fn is_build_identity_path(path: String) -> Bool {
    path.rsplit('/').next().is_some_and(name -> name == "package.jet" || name == "build.jet")
}
// Rust: Source/CmdProve.rs:3699
// Content-derived compiler identity emitted by build.rs over compiler inputs.
fn proof_compiler_digest() -> String { env.compile_var("JET_COMPILER_BUILD_ID") }
// Rust: Source/CmdProve.rs:3703
fn proof_build_digest(build_inputs: String, lock_digest: String) -> String Err! {
    compiler_digest :: proof_compiler_digest()
    // GATE #4494: real child process; #4409: preserve NotFound.
    rustc_identity :: if Command.new("rustc").args(["-vV"]).output() == {
        Ok(rustc) if rustc.status.success() -> String.from_utf8(^rustc.stdout).map_err(_ -> "rustc identity is not UTF-8")?
        Ok(_) -> return Err("cannot identify rustc: `rustc -vV` failed")
        Err(error) if error.kind() == std.io.ErrorKind.NotFound -> "<unavailable: rustc executable not installed>"
        Err(error) -> return Err("cannot identify rustc: {error}")
    }
    fields :: [
        ("compiler", compiler_digest.as_bytes().to_vec()),
        ("jet_version", env.compile_var("CARGO_PKG_VERSION").as_bytes().to_vec()),
        ("compiler_build_id", env.compile_var("JET_COMPILER_BUILD_ID").as_bytes().to_vec()),
        ("runner_id", (env.compile_var_optional("JET_RUNNER_BUILD_ID") ?? "unversioned").as_bytes().to_vec()),
        ("stdlib_id", (env.compile_var_optional("JET_STDLIB_BUILD_ID") ?? "unversioned").as_bytes().to_vec()),
        ("target", host_target_triple().as_bytes().to_vec()),
        ("profile", "dev".as_bytes().to_vec()), ("rustc", rustc_identity.into_bytes()),
        ("build_inputs", build_inputs.as_bytes().to_vec()), ("lock", lock_digest.as_bytes().to_vec())
    ]
    Ok(proof_digest("jet-proof-build-v2", &fields))
}
// Rust: Source/CmdProve.rs:3754
fn load_checked_proof_bundle(entry: String, profile: String, setting_overrides: &[String:String]) -> (AST.ProgramBundle, Sema.SemIndexEffectFacts)? {
    (diagnostics, bundle, facts) :: Driver.check_file_with_effect_facts_for_run(entry, profile, setting_overrides)
    if diagnostics.iter().any(diagnostic -> diagnostic.severity == Severity.Error) { None }
    else { bundle.map(bundle -> (^bundle, ^facts)) }
}
// Rust: Source/CmdProve.rs:3771
fn proof_core_abi(bundle: &AST.ProgramBundle?, source_digest: String) -> String {
    emission :: bundle.map(bundle -> Codegen.corelib_emission_fingerprint(bundle, false)) ?? "unavailable"
    proof_digest("jet-proof-core-abi-v2", &[("emission", emission.into_bytes()), ("source", source_digest.as_bytes().to_vec())])
}
// Rust: Source/CmdProve.rs:3784
fn unavailable_mir_identity(source_digest: String, core_abi: String, members: &[Member]) -> MIR.MirProgramIdentity {
    fields := [("source", source_digest.as_bytes().to_vec()), ("core_abi", core_abi.as_bytes().to_vec())]
    for member in members { fields.push((member.path.clone(), member.sha256.as_bytes().to_vec())) }
    fields.push(("mir", "unavailable".as_bytes().to_vec()))
    unavailable :: proof_digest("jet-proof-mir-unavailable-v1", &fields)
    source_map := members.iter().enumerate().map((index, member) -> MIR.MirSourceMapIdentity {
        id: index as UInt64 + 1, path: member.path.clone(), digest: member.sha256.clone()
    }).collect()
    source_map.sort_by((left, right) -> left.id.cmp(right.id))
    MIR.MirProgramIdentity.unavailable(unavailable, ^source_map)
}
// Rust: Source/CmdProve.rs:3813
fn proof_mir_identity(checked: &(AST.ProgramBundle, Sema.SemIndexEffectFacts)?, source_digest: String, core_abi: String, members: &[Member]) -> MIR.MirProgramIdentity {
    if checked == {
        Val((bundle, _facts)) -> {
            (mir, artifact) :: lower_checked_semantic_mir_program_for(bundle, MIR.MirArtifactRequest.new(
                MIR.MirArtifactTarget.RustAot, MIR.MirArtifactKind.NativeExecutable, MIR.MirArtifactBuildMode.Dev))
            identity :: mir.artifact_identity(artifact).unwrap_or_else(error -> jet_foundation.ice(None, "canonical MIR identity failed: {error}"))
            return std.sync.Arc.unwrap_or_clone(identity.program_identity)
        }
        None -> {}
    }
    unavailable_mir_identity(source_digest, core_abi, members)
}
// Rust: Source/CmdProve.rs:3836
fn proof_mir_identity_for_file(file: String, profile: String, setting_overrides: &[String:String]) -> MIR.MirProgramIdentity Err! {
    bytes :: fs.read(file).map_err(error -> "could not read `{file}`: {error}")?
    member :: Member { path: normalized(OSPath.from(file)), sha256: SHA256.sha256_hex(bytes), bytes: ^bytes }
    checked :: load_checked_proof_bundle(file, profile, setting_overrides).ok_or_else(() -> "could not check `{file}` for MIR artifact identity")?
    source_digest :: SHA256.sha256_hex(member.bytes)
    core_abi :: proof_core_abi(Val(&checked.0), source_digest)
    Ok(proof_mir_identity(Val(&checked), source_digest, core_abi, &[member]))
}
// Rust: Source/CmdProve.rs:3859
fn has_proof_manifest(dir: &OSPath, name: String) -> Bool Err! {
    path :: dir.join(name)
    if fs.symlink_metadata(path) == {
        Ok(metadata) if metadata.file_type().is_symlink() -> Err("proof manifest `{path.display()}` is a symlink")
        Ok(metadata) -> Ok(metadata.is_file())
        Err(error) if error.kind() == std.io.ErrorKind.NotFound -> Ok(false)
        Err(error) -> Err("couldn't inspect proof manifest `{path.display()}`: {error}")
    }
}
// Rust: Source/CmdProve.rs:3874
fn collect_jet_files(dir: &OSPath, out: &[OSPath]) -> Void Err! {
    entries :: fs.read_dir(dir).map_err(e -> "couldn't read `{dir.display()}`: {e}")?
    for entry in entries {
        path :: entry.map_err(e -> "couldn't inspect `{dir.display()}`: {e}")?.path()
        metadata :: fs.symlink_metadata(path).map_err(e -> "couldn't inspect `{path.display()}`: {e}")?
        if metadata.file_type().is_symlink() { return Err("proof target contains symlink `{path.display()}`") }
        if path.file_name().and_then(name -> name.to_str()).is_none() { return Err("proof target contains a non-UTF-8 path `{path.display()}`") }
        if metadata.is_dir() {
            name :: path.file_name().and_then(n -> n.to_str()) ?? ""
            if name == "build" || name.starts_with('.') { continue }
            collect_jet_files(path, out)?
        } else if metadata.is_file() && path.extension().and_then(ext -> ext.to_str()) == Val(Syntax.FILE_EXT) {
            name :: path.file_name().and_then(name -> name.to_str()) ?? ""
            if name != Syntax.PACKAGE_FILE && name != Syntax.PAYLOAD_FILE && name != "build.jet" { out.push(^path) }
        }
    }
    Ok(())
}
// Rust: Source/CmdProve.rs:3919
fn collect_identity_files(dir: &OSPath, out: &[OSPath]) -> Void Err! {
    entries :: fs.read_dir(dir).map_err(e -> "couldn't read `{dir.display()}`: {e}")?
    for entry in entries {
        path :: entry.map_err(e -> "couldn't inspect `{dir.display()}`: {e}")?.path()
        metadata :: fs.symlink_metadata(path).map_err(e -> "couldn't inspect `{path.display()}`: {e}")?
        if metadata.file_type().is_symlink() { return Err("proof target contains symlink `{path.display()}`") }
        if path.file_name().and_then(name -> name.to_str()).is_none() { return Err("proof target contains a non-UTF-8 path `{path.display()}`") }
        name :: path.file_name().and_then(name -> name.to_str()) ?? ""
        parent_is_jet :: path.parent().and_then(parent -> parent.file_name()).and_then(name -> name.to_str()) == Val(".jet")
        if metadata.is_dir() {
            if name == ".git" || (parent_is_jet && name == "cache") { continue }
            collect_identity_files(path, out)?
            continue
        }
        if !metadata.is_file() { continue }
        under_generated :: path.components().collect().windows(2).any(components ->
            components[0].as_os_str() == ".jet" && components[1].as_os_str() == "generated")
        if name == "package.jet" || name == "jet.lock" || name == "jet.lock.json" || name == "build.jet" ||
            (parent_is_jet && name == "lock") || under_generated { out.push(^path) }
    }
    Ok(())
}
// Rust: Source/CmdProve.rs:3987
fn normalized(path: &OSPath) -> String {
    relative :: if path.is_absolute() {
        path.strip_prefix(env.current_dir().unwrap_or_else(_ -> OSPath.from("."))).unwrap_or(path)
    } else { path }
    relative.components().map(part -> part.as_os_str().to_string_lossy()).collect().join("/")
}
// Rust: Source/CmdProve.rs:4000
fn budget_projection(target: &Target) -> BudgetView.BudgetProjection {
    target_path :: OSPath.from(target.root)
    search :: if target_path.is_file() { target_path.parent().and_then(parent -> parent.parent()) ?? OSPath.from(".") } else { target_path }
    root :: Loader.find_manifest_root(search).unwrap_or_else(() -> search.to_path_buf())
    sources :: target.members.iter().map(member -> {
        path :: OSPath.from(member.path)
        relative :: path.strip_prefix(root).unwrap_or(path).to_string_lossy().replace('\\', "/")
        trimmed := relative.trim_start_matches("./") // #4303
        (trimmed.to_string(), member.sha256.clone())
    }).collect()
    BudgetView.read_compatible(root, sources)
}
// Rust: Source/CmdProve.rs:4030
fn diagnostic_span(source: String, diagnostic: &Diagnostic) -> String {
    span :: if diagnostic.span == { Val(span) -> span; None -> return "0:0-0:0" }
    (sl, sc) :: span_line_col(source, span.start)
    (el, ec) :: span_line_col(source, span.end)
    "{sl}:{sc}-{el}:{ec}"
}
// Rust: Source/CmdProve.rs:4039
fn evidence_id(target: &Target, kind: String, origin: String, span: String, claim: String) -> String {
    claim_sha :: SHA256.sha256_hex(claim.as_bytes())
    preimage := []
    for field in [target.input_sha256, kind, origin, span, claim_sha] {
        preimage.extend_from_slice((field.len() as UInt64).to_be_bytes())
        preimage.extend_from_slice(field.as_bytes())
    }
    SHA256.sha256_hex(preimage)
}
// Rust: Source/CmdProve.rs:4049
fn claim_grade(proved: USize, failed: USize, tests: &[TestItem], solver: &[ProveSolver.SolverEvidence]) -> String {
    // Failed producers cannot establish a package floor.
    if failed > 0 || tests.iter().any(item -> item.state == 1) { return "unchecked" }
    if solver.iter().any(item -> if item.outcome == { Proved { .. } -> true; _ -> false }) { return "proved" }
    generated: UInt64 :: tests.iter().filter(item -> item.generated && item.state == 0).map(item -> item.generated_count).sum()
    if generated > 0 { return "generated({generated})" }
    examples :: tests.iter().filter(item -> (item.kind == 0 || item.kind == 2 || item.kind == 4) && item.state == 0).count()
    if examples > 0 { return "examples({examples})" }
    if failed == 0 && proved > 0 { "checked" } else { "unchecked" }
}
// Rust: Source/CmdProve.rs:4091
fn claims_floor_for_target(target: &Target) -> Package.ClaimsGrade? {
    root :: OSPath.from(target.root)
    entry :: if root.is_dir() { OSPath.from(target.members.first()?.path) } else { root.to_path_buf() }
    Loader.package_facts_for_entry(entry).ok().flatten().and_then(facts -> facts.policy.claims_min)
}
// Rust: Source/CmdProve.rs:4103
fn grade_meets_floor(actual: String, floor: Package.ClaimsGrade) -> Bool {
    Package.ClaimsGrade.parse(actual).is_some_and(grade -> grade.meets(floor))
}
// Rust: Source/CmdProve.rs:4107
fn render_report(target: &Target, items: &[FrontEndItem], warnings: &[FrontEndWarning], tests: &[TestItem],
    budgets: &BudgetView.BudgetProjection, solver: &[ProveSolver.SolverEvidence], _lenses: &[String],
    declarations: &[ContractDeclaration], replay_time_ms: Int64?, proved: USize, failed: USize,
    claims_grade: String, claims_floor: Package.ClaimsGrade?, exit_code: Int32) -> String {
    members :: target.identity_members.iter().map((path, sha256) -> "{{\"path\":{json(path)},\"sha256\":{json(sha256)}}}").collect().join(",")
    diagnostics := items.iter().filter_map(item -> item.diagnostic.map(d -> diagnostic_json(item.path, item.source, d))).collect()
    diagnostic_index := 0
    evidence_rows := items.iter().map(item -> {
        (outcome, indexes) :: if item.diagnostic.is_some() {
            i :: diagnostic_index
            diagnostic_index += 1
            ("failed", "[{i}]")
        } else { ("proved", "[]") }
        "{{\"attachment\":null,\"budget\":null,\"contract\":null,\"count\":1,\"diagnosticIndexes\":{indexes},\"facet\":\"{item.facet}\",\"id\":{json(item.id)},\"kind\":\"front_end\",\"outcome\":\"{outcome}\",\"producer\":\"jet-sema\",\"property\":null,\"reason\":null,\"solver\":null,\"source\":{{\"column\":{item.column},\"line\":{item.line},\"path\":{json(item.path)}}},\"state\":\"checked\"}}"
    }).collect()
    if claims_floor == {
        Val(floor) -> {
            floor_name :: floor.render()
            diagnostic :: Diagnostic.error("E2942", "claim grade `{claims_grade}` is below package floor `{floor_name}`",
                "package policy requires at least `{floor_name}` evidence",
                "raise the claim with `jet prove --lens solver` or the required generated/property evidence", None)
            diagnostic_index :: diagnostics.len()
            diagnostics.push(diagnostic_json(target.root, "", diagnostic))
            claim :: "claim grade `{claims_grade}` below floor `{floor_name}`"
            id :: evidence_id(target, "claims_policy", target.root, "1:1-1:1", claim)
            evidence_rows.push("{{\"attachment\":null,\"budget\":null,\"contract\":null,\"count\":1,\"diagnosticIndexes\":[{diagnostic_index}],\"facet\":\"claims\",\"id\":{json(id)},\"kind\":\"policy\",\"outcome\":\"failed\",\"producer\":\"jet-policy\",\"property\":null,\"reason\":\"claims_floor\",\"solver\":null,\"source\":{{\"column\":1,\"line\":1,\"path\":{json(target.root)}}},\"state\":\"unchecked\"}}")
        }
        None -> {}
    }
    used_contract_records := collections.BTreeSet.new()
    for declaration in declarations {
        matching :: matching_contract_record(declaration, tests, used_contract_records)
        (id, attachment, state, outcome, reason, observation, diagnostic_indexes) :: if matching == {
            Val((index, item)) -> {
                used_contract_records.insert(index)
                (state, outcome, reason, observation) :: if item.state == {
                    0 -> ("executed", "passed", "null", "reached_pass")
                    1 -> ("executed", "failed", "null", "reached_fail")
                    2 -> ("skipped", "not_run", "\"fail_fast_policy\"", "not_reached")
                    _ -> ("unavailable", "unavailable", "\"producer_start_failed\"", "not_reached")
                }
                diagnostic_indexes :: if item.state == 1 {
                    index :: diagnostics.len()
                    diagnostics.push(runtime_contract_diagnostic(declaration.path, item))
                    "[{index}]"
                } else { "[]" }
                (declaration.id.clone(), if item.state == 0 || item.state == 1 { "{{\"testEvidenceId\":{json(item.id)}}}" } else { "null" },
                    state, outcome, reason, observation, diagnostic_indexes)
            }
            None -> (declaration.id.clone(), "null", "declared", "not_observed", "null", "not_reached", "[]")
        }
        contract :: "{{\"marker\":{json(declaration.marker)},\"observation\":\"{observation}\",\"site\":{{\"column\":{declaration.column},\"line\":{declaration.line},\"path\":{json(declaration.path)}}}}}"
        evidence_rows.push("{{\"attachment\":{attachment},\"budget\":null,\"contract\":{contract},\"count\":1,\"diagnosticIndexes\":{diagnostic_indexes},\"facet\":\"contracts\",\"id\":{json(id)},\"kind\":\"contract\",\"outcome\":\"{outcome}\",\"producer\":\"jet-runtime\",\"property\":null,\"reason\":{reason},\"solver\":null,\"source\":{{\"column\":{declaration.column},\"line\":{declaration.line},\"path\":{json(declaration.path)}}},\"state\":\"{state}\"}}")
    }
    for item in tests {
        if item.kind == 1 { continue }
        if item.kind == 2 {
            // Preserve the failed unit execution and its diagnostic linkage.
            diagnostic_index :: diagnostics.len()
            diagnostics.push(runtime_item_diagnostic(item))
            evidence_rows.push("{{\"attachment\":null,\"budget\":null,\"contract\":null,\"count\":1,\"diagnosticIndexes\":[{diagnostic_index}],\"facet\":\"tests\",\"id\":{json(item.id)},\"kind\":\"unit\",\"outcome\":\"failed\",\"producer\":\"jet-test\",\"property\":null,\"reason\":null,\"solver\":null,\"source\":{{\"column\":1,\"line\":{item.line.max(1)},\"path\":{json(item.path)}}},\"state\":\"executed\"}}")
            continue
        }
        (kind, facet, producer) :: if item.kind == {
            3 -> ("property", "tests", "jet-property")
            4 -> ("doctest", "tests", "jet-doctest")
            _ -> ("unit", "tests", "jet-test")
        }
        (state, outcome) :: if item.state == {
            0 -> ("executed", "passed")
            1 -> ("executed", "failed")
            2 -> ("skipped", "not_run")
            _ -> ("unavailable", "unavailable")
        }
        reason :: if item.state == 2 { "\"fail_fast_policy\"" }
            else if item.reason.is_empty() { if item.state > 2 { "\"producer_start_failed\"" } else { "null" } }
            else { json(item.reason) }
        diagnostic_indexes :: if item.state == 1 {
            index :: diagnostics.len()
            diagnostics.push(runtime_item_diagnostic(item))
            "[{index}]"
        } else { "[]" }
        property :: if item.kind == 3 {
            shrink_trace :: if item.message.is_empty() { "[]" } else { "[{{\"name\":\"minimized_inputs\",\"value\":{json(item.message)}}}]" }
            "{{\"caseIndex\":{item.case_index},\"effectiveSeed\":{item.seed.parse::<UInt64>().unwrap_or(0)},\"generatedCases\":{item.generated_count},\"shrinkTrace\":{shrink_trace},\"source\":{{\"column\":1,\"line\":1,\"path\":{json(item.path)}}},\"toolchain\":{{\"jet\":{json(env.compile_var(\"CARGO_PKG_VERSION\"))},\"targetTriple\":{json(host_target_triple())}}}}}"
        } else { "null" }
        count :: if item.kind == 3 { item.generated_count } else { 1 }
        evidence_rows.push("{{\"attachment\":null,\"budget\":null,\"contract\":null,\"count\":{count},\"diagnosticIndexes\":{diagnostic_indexes},\"facet\":\"{facet}\",\"id\":{json(item.id)},\"kind\":\"{kind}\",\"outcome\":\"{outcome}\",\"producer\":\"{producer}\",\"property\":{property},\"reason\":{reason},\"solver\":null,\"source\":{{\"column\":1,\"line\":{item.line.max(1)},\"path\":{json(item.path)}}},\"state\":\"{state}\"}}")
    }
    for fact in budgets.facts {
        kind :: if fact.statistical { "statistical_budget" } else { "deterministic_budget" }
        outcome :: if fact.outcome == { "pass" -> "met"; "warn" -> "warning"; _ -> "failed" }
        budget :: "{{\"budgetId\":{json(fact.budget_id)},\"enforcement\":{json(fact.enforcement)},\"evidenceId\":{json(fact.evidence_id)},\"reportId\":{json(fact.report_id)},\"statistical\":{fact.statistical}}}"
        evidence_rows.push("{{\"attachment\":null,\"budget\":{budget},\"contract\":null,\"count\":1,\"diagnosticIndexes\":[],\"facet\":\"budgets\",\"id\":{json(fact.evidence_id)},\"kind\":\"{kind}\",\"outcome\":\"{outcome}\",\"producer\":\"jet-budget\",\"property\":null,\"reason\":null,\"solver\":null,\"source\":{{\"column\":1,\"line\":1,\"path\":{json(target.root)}}},\"state\":\"checked\"}}")
    }
    for (index, reason) in budgets.rejected.iter().enumerate() {
        claim :: "canonical budget report unavailable: {reason}"
        id :: evidence_id(target, "budget", target.root, "0:0-0:{index}", claim)
        evidence_rows.push("{{\"attachment\":null,\"budget\":null,\"contract\":null,\"count\":1,\"diagnosticIndexes\":[],\"facet\":\"budgets\",\"id\":{json(id)},\"kind\":\"deterministic_budget\",\"outcome\":\"unavailable\",\"producer\":\"jet-budget\",\"property\":null,\"reason\":{json(reason)},\"solver\":null,\"source\":{{\"column\":1,\"line\":1,\"path\":{json(target.root)}}},\"state\":\"unavailable\"}}")
    }
    for item in solver {
        diagnostic_indexes :: if item.outcome == {
            Disproved { assignment, .. } -> {
                index :: diagnostics.len()
                values :: assignment.iter().map((name, value) -> "{name} = {value}").collect().join(", ")
                message :: "solver found a counterexample to {item.obligation.kind}"
                why :: "Why: these values satisfy every assumption but make the claim false: {values}"
                fix :: "Fix: change {item.obligation.origin} so every admitted input satisfies the claim, or correct the contract"
                diagnostics.push("{{\"caret\":null,\"code\":\"E2950\",\"context\":[],\"frames\":[],\"message\":{json(message)},\"notes\":[{json(why)},{json(fix)}],\"origin\":{{\"producer\":\"native-presburger\",\"stage\":\"solver\"}},\"safeLocals\":[],\"severity\":\"error\",\"span\":{{\"endColumn\":1,\"endLine\":1,\"path\":{json(item.obligation.origin)},\"sourceLine\":null,\"startColumn\":1,\"startLine\":1}},\"type\":\"producer\"}}")
                "[{index}]"
            }
            _ -> "[]"
        }
        evidence_rows.push(ProveSolver.evidence_json(item, diagnostic_indexes))
    }
    if replay_time_ms == {
        Val(time_ms) -> {
            claim :: "replayed Time authority at {time_ms} ms"
            id :: evidence_id(target, "replay", target.root, "1:1-1:1", claim)
            evidence_rows.push("{{\"attachment\":null,\"budget\":null,\"contract\":null,\"count\":1,\"diagnosticIndexes\":[],\"facet\":\"replay\",\"id\":{json(id)},\"kind\":\"front_end\",\"outcome\":\"observed\",\"producer\":\"jet-replay\",\"property\":null,\"reason\":\"parity_not_available\",\"solver\":null,\"source\":{{\"column\":1,\"line\":1,\"path\":{json(target.root)}}},\"state\":\"executed\"}}")
        }
        None -> {}
    }
    for warning in warnings { diagnostics.push(diagnostic_json(warning.path, warning.source, warning.diagnostic)) }
    (evidence, derivations) :: canonicalize_evidence_rows(target, evidence_rows)
    (solver_selected, solver_proved, solver_disproved, solver_unknown, solver_unavailable) :: ProveSolver.summarize(solver)
    unit_report :: unit_test_report(tests)
    unit_summary :: unit_report.status_envelope().json()
    unit_unavailable :: tests.iter().filter(item -> (item.kind == 0 || item.kind == 2) && item.state == 3).count()
    contract_selected :: declarations.len()
    (contract_passed, contract_failed, contract_not_observed, contract_skipped) :: contract_summary(declarations, tests)
    contract_observed :: contract_passed + contract_failed
    property_passed :: tests.iter().filter(item -> item.kind == 3 && item.state == 0).count()
    property_failed :: tests.iter().filter(item -> item.kind == 3 && item.state == 1).count()
    property_cases: UInt32 :: tests.iter().filter(item -> item.kind == 3).map(item -> item.line).sum()
    property_shrunk_failures :: tests.iter().filter(item -> item.kind == 3 && item.state == 1 && !item.message.is_empty()).count()
    doctest_passed :: tests.iter().filter(item -> item.kind == 4 && item.state == 0).count()
    doctest_failed :: tests.iter().filter(item -> item.kind == 4 && item.state == 1).count()
    doctest_skipped :: tests.iter().filter(item -> item.kind == 4 && item.state >= 2).count()
    doctest_selected :: doctest_passed + doctest_failed + doctest_skipped
    deterministic_selected :: budgets.facts.iter().filter(fact -> !fact.statistical).count() + budgets.rejected.len()
    deterministic_failed :: budgets.facts.iter().filter(fact -> !fact.statistical && fact.outcome == "fail").count()
    deterministic_met :: budgets.facts.iter().filter(fact -> !fact.statistical && fact.outcome == "pass").count()
    deterministic_unavailable :: budgets.facts.iter().filter(fact -> !fact.statistical && fact.evidence == "unavailable").count() + budgets.rejected.len()
    statistical_selected :: budgets.facts.iter().filter(fact -> fact.statistical).count()
    statistical_failed :: budgets.facts.iter().filter(fact -> fact.statistical && fact.outcome == "fail").count()
    statistical_met :: budgets.facts.iter().filter(fact -> fact.statistical && fact.outcome == "pass").count()
    statistical_unavailable :: budgets.facts.iter().filter(fact -> fact.statistical && fact.evidence == "unavailable").count()
    front_end_selected :: proved + failed
    property_skipped :: tests.iter().filter(item -> item.kind == 3 && item.state >= 2).count()
    property_selected :: property_passed + property_failed + property_skipped
    result :: if exit_code != ExitCodes.OK { "fail" }
        else if unit_unavailable > 0 || deterministic_unavailable > 0 || statistical_unavailable > 0 || solver_unknown > 0 { "pass_incomplete" }
        else { "pass" }
    mir :: target.mir.canonical_json()
    candidate_identity :: candidate_identity_json(target)
    grade :: json(claims_grade)
    version :: json(env.compile_var("CARGO_PKG_VERSION"))
    triple :: json(host_target_triple())
    "{{\"derivations\":[{derivations}],\"diagnostics\":[{diagnostics.join(\",\")}],\"evidence\":[{evidence}],\"evidencePolicy\":\"allow_incomplete\",\"grade\":{grade},\"exitCode\":{exit_code},\"result\":\"{result}\",\"schemaVersion\":1,\"candidateIdentity\":{candidate_identity},\"summaries\":{{\"claims\":{{\"grade\":{grade}}},\"contract\":{{\"declared\":{contract_selected},\"failed\":{contract_failed},\"notObserved\":{contract_not_observed},\"observed\":{contract_observed},\"passed\":{contract_passed},\"selected\":{contract_selected},\"skipped\":{contract_skipped}}},\"deterministicBudget\":{{\"failed\":{deterministic_failed},\"met\":{deterministic_met},\"selected\":{deterministic_selected},\"skipped\":0,\"unavailable\":{deterministic_unavailable}}},\"doctest\":{{\"failed\":{doctest_failed},\"passed\":{doctest_passed},\"selected\":{doctest_selected},\"skipped\":{doctest_skipped}}},\"frontEnd\":{{\"failed\":{failed},\"proved\":{proved},\"selected\":{front_end_selected},\"skipped\":0}},\"property\":{{\"failed\":{property_failed},\"generatedCases\":{property_cases},\"passed\":{property_passed},\"selected\":{property_selected},\"shrunkFailures\":{property_shrunk_failures},\"skipped\":{property_skipped}}},\"solver\":{{\"disproved\":{solver_disproved},\"proved\":{solver_proved},\"selected\":{solver_selected},\"unavailable\":{solver_unavailable},\"unknown\":{solver_unknown}}},\"statisticalBudget\":{{\"failed\":{statistical_failed},\"met\":{statistical_met},\"selected\":{statistical_selected},\"skipped\":0,\"unavailable\":{statistical_unavailable}}},\"unit\":{unit_summary}}},\"target\":{{\"inputSha256\":{json(target.input_sha256)},\"kind\":\"{target.kind}\",\"members\":[{members}],\"mir\":{mir},\"root\":{json(target.root)}}},\"tool\":{{\"jet\":{version},\"proofProducer\":\"jet-prove\",\"targetTriple\":{triple}}}}}"
}
// Rust: Source/CmdProve.rs:4473
fn canonicalize_evidence_rows(target: &Target, rows: &[String]) -> (String, String) {
    identity :: DerivationIdentity.new(target.source_digest.clone(), target.build_digest.clone(), target.mir.optimized_hash.clone(), target.input_sha256.clone())
    rendered := Array<String>.with_capacity(rows.len())
    derivations := Array<String>.with_capacity(rows.len())
    for (index, row) in rows.iter().enumerate() {
        id :: row_string_field(row, "id") ?? "proof-row-{index}"
        kind :: row_string_field(row, "kind") ?? "unknown"
        producer :: row_string_field(row, "producer") ?? "jet-prove"
        method :: if producer == {
            "native-presburger" | "jet-solver" -> DerivationMethod.FormalProof
            "jet-property" -> DerivationMethod.SampledAgreement
            "jet-runtime" | "jet-test" | "jet-doctest" | "jet-replay" -> DerivationMethod.RecordedExecution
            "jet-sema" | "jet-budget" | "jet-policy" -> DerivationMethod.StaticDerivation
            _ -> DerivationMethod.ExternalAssumption
        }
        outcome :: row_string_field(row, "outcome") ?? ""
        state :: row_string_field(row, "state") ?? ""
        disposition :: if outcome == "unavailable" || outcome == "not_observed" || outcome == "unknown" ||
            state == "unavailable" || state == "not_run" || state == "unchecked" { DerivationDisposition.Unavailable } else { DerivationDisposition.Current }
        derivation :: DerivationRecord.new(id.clone(), "{kind}:{id}", producer, method, "checked-proof-row", [id.clone()], identity.clone()).with_disposition(disposition)
        rendered.push(row.strip_suffix('}').map(prefix -> "{prefix},\"derivation\":{{\"id\":{json(derivation.id)}}}}}").unwrap_or_else(() -> row.clone()))
        derivations.push(derivation.to_json())
    }
    (rendered.join(","), derivations.join(","))
}
// Rust: Source/CmdProve.rs:4535
fn row_string_field(row: String, field: String) -> String? {
    tree :: parse_json(row).ok()?
    fields :: if tree == { DataTree.Object(fields) -> fields; _ -> return None }
    fields.iter().find_map((key, value) -> if key == field { value.as_str().ok() } else { None }).map(value -> value.to_string())
}
// Rust: Source/CmdProve.rs:4545
fn contract_summary(declarations: &[ContractDeclaration], tests: &[TestItem]) -> (USize, USize, USize, USize) {
    used := collections.BTreeSet.new()
    passed := 0
    failed := 0
    not_observed := 0
    skipped := 0
    for declaration in declarations {
        if matching_contract_record(declaration, tests, used) == {
            None -> { not_observed += 1; continue }
            Val((index, item)) -> {
                used.insert(index)
                if item.state == { 0 -> passed += 1; 1 -> failed += 1; _ -> skipped += 1 }
            }
        }
    }
    (passed, failed, not_observed, skipped)
}
// Rust: Source/CmdProve.rs:4570
fn diagnostic_json(path: String, source: String, d: &Diagnostic) -> String {
    severity :: if d.severity == Severity.Error { "error" } else { "warning" }
    span :: d.span.map(s -> {
        (sl, sc) :: span_line_col(source, s.start)
        (el, ec) :: span_line_col(source, s.end)
        "{{\"endColumn\":{ec},\"endLine\":{el},\"path\":{json(path)},\"sourceLine\":null,\"startColumn\":{sc},\"startLine\":{sl}}}"
    }) ?? "null"
    why :: "Why: {d.why}"
    fix :: "Fix: {d.fix}"
    "{{\"caret\":null,\"code\":{json(d.code)},\"context\":[],\"frames\":[],\"message\":{json(d.what)},\"notes\":[{json(why)},{json(fix)}],\"origin\":{{\"producer\":\"jet-sema\",\"stage\":\"front_end\"}},\"safeLocals\":[],\"severity\":\"{severity}\",\"span\":{span},\"type\":\"front_end\"}}"
}
// Rust: Source/CmdProve.rs:4580
fn source_paths_match(left: String, right: String) -> Bool {
    normalize :: (path: String) -> { trimmed := path.trim_start_matches("./"); trimmed.replace('\\', "/") } // #4303
    l :: normalize(left)
    r :: normalize(right)
    l == r || l.ends_with("/{r}") || r.ends_with("/{l}")
}
// Rust: Source/CmdProve.rs:4586
fn contract_record_matches(declaration: &ContractDeclaration, item: &TestItem) -> Bool {
    item.kind == 1 && item.name == declaration.marker && source_paths_match(item.path, declaration.path) &&
        declaration.message.map_or(true, message -> message == item.message)
}
// Rust: Source/CmdProve.rs:4596
fn matching_contract_record(declaration: &ContractDeclaration, tests: &[TestItem], used: &collections.BTreeSet<USize>) -> (USize, &TestItem)? {
    matching :: tests.iter().enumerate().find((index, item) -> !used.contains(index) && contract_record_matches(declaration, item) && item.line as USize == declaration.line)
    if matching.is_some() { return matching }
    candidates := tests.iter().enumerate().filter((index, item) -> !used.contains(index) && contract_record_matches(declaration, item))
    first :: candidates.next()?
    if candidates.next().is_none() { Val(first) } else { None }
}
// Rust: Source/CmdProve.rs:4615
fn runtime_contract_diagnostic(path: String, item: &TestItem) -> String {
    message :: "#{item.name} contract failed: {item.message}"
    report :: Outcome.jet_render_runtime_stop("E3005", path, item.line, "", "", 1, 1, message, "")
    why :: "Why: {report.why}"
    fix :: "Fix: {report.fix}"
    source_line :: source_line_for(path, item.line)
    source_line_json :: source_line.map(line -> json(line)) ?? "null"
    width :: source_line.map_or(1, line -> line.chars().count().max(1))
    "{{\"caret\":{{\"startColumn\":1,\"width\":{width}}},\"code\":\"E3005\",\"context\":[],\"frames\":[],\"message\":{json(message)},\"notes\":[{json(why)},{json(fix)}],\"origin\":{{\"producer\":\"jet-runtime\",\"stage\":\"runtime\"}},\"safeLocals\":[],\"severity\":\"error\",\"span\":{{\"endColumn\":{width + 1},\"endLine\":{item.line},\"path\":{json(path)},\"sourceLine\":{source_line_json},\"startColumn\":1,\"startLine\":{item.line}}},\"type\":\"runtime\"}}"
}
// Rust: Source/CmdProve.rs:4642
fn source_line_for(path: String, line: UInt32) -> String? {
    index :: USize.try_from(line).ok()?.checked_sub(1)?
    fs.read_to_string(path).ok()?.lines().nth(index).map(line -> line.to_string())
}
// Rust: Source/CmdProve.rs:4651
struct UnitTestReport {
    passed: USize
    failed: USize
    skipped: USize
    // Rust: Source/CmdProve.rs:4658
    fn summary(self: &Self) -> String { "{self.passed} passed, {self.failed} failed, {self.skipped} skipped" }
    // Rust: Source/CmdProve.rs:4665
    fn status_envelope(self: &Self) -> StatusEnvelope {
        StatusEnvelope.new("test", self.failed == 0).with_field("test", StatusValue.object(
            StatusFields.new().with("failed", self.failed).with("passed", self.passed).with("skipped", self.skipped)
                .with("selected", self.passed + self.failed + self.skipped)))
    }
}
// Rust: Source/CmdProve.rs:4679
fn unit_test_report(tests: &[TestItem]) -> UnitTestReport {
    is_unit :: (item: &TestItem) -> item.kind == 0 || item.kind == 2
    UnitTestReport {
        passed: tests.iter().filter(item -> is_unit(item) && item.state == 0).count(),
        failed: tests.iter().filter(item -> is_unit(item) && item.state == 1).count(),
        skipped: tests.iter().filter(item -> is_unit(item) && item.state >= 2).count()
    }
}
