fn child_peak_rss(pid: U32) -> U64? ProviderFailure! {
    if core.sys.target.selected_os() == "linux" -> return read_vm_hwm(pid)
    Ok(None)
}
// Rust: Source/BudgetProviders.rs:1998
fn run_compile_child(entry: OSPath, root: OSPath, target: String, profile: String) -> ChildMetrics ProviderFailure! {
    if target != "cli" -> return Err(ProviderFailure.operation(.Unsupported, "compile workload target `{target}` is unsupported by the resident fixture compiler"))
    backend :: CompileBackend.for_profile(profile)
    executable :: running_executable() ?? return Err(ProviderFailure.operation(.Execution, "cannot identify resident Jet compiler: {err}"))
    command := Command.new(executable) // GATE #4494
    &command.arg(if backend == { .JitCranelift -> "run", .AotRustc -> "build" })
    &command.arg(entry).current_dir(root).env("JET_STORE_DIR", root.join(".jet-store"))
    &command.stdin(Stdio.null()).stdout(Stdio.null()).stderr(Stdio.null())
    if profile == {
        "dev" -> {}
        "release" -> { &command.arg("--release") }
        "small" -> { &command.arg("--small") }
        else -> { &command.arg("--profile={profile}") }
    }
    if core.sys.target.selected_family() == "unix" -> &command.process_group(0)
    child := command.spawn() ?? return Err(ProviderFailure.operation(.Execution, "cannot start compile workload child: {err}"))
    peak_rss_bytes := U64{0}
    deadline :: Instant.now() + NATIVE_BUILD_DEADLINE
    loop {
        if child_peak_rss(child.id()) == { .Val(value) -> { peak_rss_bytes = peak_rss_bytes.max(value) }, .None -> {} }
        usage_result :: wait4_process(child.id(), true)
        if usage_result == {
            .Ok(Val(usage)) -> {
                if usage.status != 0 -> return Err(ProviderFailure.operation(.Execution, "compile workload child exited with status {usage.status}"))
                peak_rss_bytes = peak_rss_bytes.max(usage.peak_rss_bytes)
                if core.sys.target.selected_os() == "linux" && peak_rss_bytes == 0 -> return Err(ProviderFailure.operation(.Unavailable, "compile child peak RSS was not observable"))
                return Ok(ChildMetrics{process_cpu_ns: usage.process_cpu_ns, peak_rss_bytes: peak_rss_bytes})
            }
            .Ok(None) -> {
                if Instant.now() < deadline -> thread.sleep(Duration.from_millis(2))
                else {
                    terminate_group(&child)
                    return Err(ProviderFailure.operation(.Timeout, "compile workload child exceeded its deadline"))
                }
            }
            .Err(error) -> { terminate_group(&child); return Err(error) }
        }
    }
}
// Rust: Source/BudgetProviders.rs:2096
fn running_executable() -> OSPath io.Error! {
    if core.sys.target.selected_os() == "linux" {
        executable :: OSPath.from_text("/proc/self/exe")
        _ :: fs.File.open(executable) // GATE #4494
        return Ok(executable)
    }
    std.env.current_exe() // GATE #4494
}

// Rust: Source/BudgetProviders.rs:2109
fn read_compile_phases(root: OSPath, entry: OSPath) -> [(String, U128)] ProviderFailure! {
    executable :: running_executable() ?? return Err(ProviderFailure.operation(.Execution, "cannot identify resident Jet compiler: {err}"))
    command := Command.new(executable)
    &command.arg("explain-build").arg(entry).arg("--json").current_dir(root)
    &command.env("JET_STORE_DIR", root.join(".jet-store")).env("NO_COLOR", "1")
    output :: command.output() ?? return Err(ProviderFailure.operation(.Unavailable, "cannot read explain-build record: {err}"))
    if !output.status.success() {
        stderr := String.from_utf8_lossy(output.stderr).trim() // #4303
        return Err(ProviderFailure.operation(.Unavailable, "explain-build failed with status {output.status}: {stderr}"))
    }
    text :: String.from_utf8(output.stdout) ?? return Err(ProviderFailure.malformed("explain-build output is not UTF-8"))
    trimmed := text.trim() // #4303
    value :: parse_json(trimmed, true) ?? return Err(ProviderFailure.malformed("explain-build output is invalid: {err.message}"))
    record :: if value == {
        .Object(fields) -> fields.iter().find(fn(pair) { pair.0 == "build" }).map(fn(pair) { pair.1 }) ?? value
        else -> value
    }
    fields :: if record == { .Object(fields) -> fields, else -> return Err(ProviderFailure.malformed("explain-build record is not an object")) }
    schema_value :: fields.iter().find(fn(pair) { pair.0 == "schema" }).map(fn(pair) { pair.1 }) ?? return Err(ProviderFailure.malformed("explain-build record has no schema"))
    schema :: if schema_value == { .Text(text) | .TypedText(text) -> text, else -> return Err(ProviderFailure.malformed("explain-build record has no schema")) }
    if schema != "jet.explain-build/v1" -> return Err(ProviderFailure.malformed("explain-build record has an unsupported schema"))
    program :: fields.iter().find(fn(pair) { pair.0 == "program" }).map(fn(pair) { pair.1 })
    if !(if program == { .Val(.Text(text)) | .Val(.TypedText(text)) -> !text.is_empty(), else -> false }) -> return Err(ProviderFailure.malformed("explain-build record has no program"))
    node_value :: fields.iter().find(fn(pair) { pair.0 == "nodes" }).map(fn(pair) { pair.1 })
    nodes :: if node_value == { .Val(.Array(nodes)) -> nodes, else -> return Err(ProviderFailure.malformed("explain-build record has no nodes")) }
    phases := [String: U128]{}
    loop node_value in nodes {
        node :: if node_value == { .Object(fields) -> fields, else -> return Err(ProviderFailure.malformed("explain-build node is not an object")) }
        kind_value :: node.iter().find(fn(pair) { pair.0 == "kind" }).map(fn(pair) { pair.1 })
        kind :: if kind_value == { .Val(.Text(text)) | .Val(.TypedText(text)) -> text, else -> return Err(ProviderFailure.malformed("explain-build node has no kind")) }
        if kind == "package" -> continue
        if kind != "check" && kind != "compile" && kind != "link" -> return Err(ProviderFailure.malformed("explain-build node has an unsupported kind"))
        loop field in ["key", "subject", "why_ran"] {
            field_value :: node.iter().find(fn(pair) { pair.0 == field }).map(fn(pair) { pair.1 })
            if !(if field_value == { .Val(.Text(text)) | .Val(.TypedText(text)) -> !text.is_empty(), else -> false }) -> return Err(ProviderFailure.malformed("explain-build node has no {field}"))
        }
        input_value :: node.iter().find(fn(pair) { pair.0 == "inputs" }).map(fn(pair) { pair.1 })
        inputs :: if input_value == { .Val(.Array(values)) -> values, else -> return Err(ProviderFailure.malformed("explain-build node has no inputs")) }
        loop input in inputs {
            if !(input == .Text(_) || input == .TypedText(_)) -> return Err(ProviderFailure.malformed("explain-build node inputs are not strings"))
        }
        duration :: node.iter().find(fn(pair) { pair.0 == "duration_ms" }).map(fn(pair) { pair.1 }) ?? return Err(ProviderFailure.malformed("explain-build node has no duration"))
        duration_ms :: if duration == {
            .Float(number) -> number
            .Int(number) -> number as F64
            .Number(text) -> text.parse[F64]() ?? return Err(ProviderFailure.malformed("explain-build node duration is not a number"))
            else -> return Err(ProviderFailure.malformed("explain-build node duration is not a number"))
        }
        if !duration_ms.is_finite() || duration_ms < 0.0 -> return Err(ProviderFailure.malformed("explain-build node duration is invalid"))
        nanos :: duration_ms * 1_000_000.0
        if nanos > U64.MAX as F64 -> return Err(ProviderFailure.malformed("explain-build node duration overflowed"))
        rounded :: nanos.round() as U128
        total :: phases.get(kind) ?? U128{0}
        phases[kind] = total.checked_add(rounded) ?? return Err(ProviderFailure.malformed("compile phase total overflowed"))
    }
    if phases.is_empty() -> return Err(ProviderFailure.operation(.Unavailable, "explain-build record contained no nodes"))
    keys := phases.keys().to_list()
    &keys.sort()
    result := [(String, U128)]{}
    loop key in keys -> &result.push((key, phases[key]))
    Ok(^result)
}
// Rust: Source/BudgetProviders.rs:2274
fn phase_totals_json(phases: [(String, U128)]) -> CanonicalJson ProviderFailure! {
    result := [CanonicalJson]{}
    loop (name, ns) in phases {
        entry :: CanonicalJson.object([("name", CanonicalJson.String(name)), ("ns", CanonicalJson.Integer(ns.to_string()))]) ?? return Err(ProviderFailure.malformed(err))
        &result.push(entry)
    }
    Ok(CanonicalJson.Array(^result))
}
// Rust: Source/BudgetProviders.rs:2289
fn aggregate_compile_phases(records: [CanonicalJson]) -> CanonicalJson ProviderFailure! {
    totals := [String: U128]{}
    loop record_value in records {
        record :: if record_value == { .Object(fields) -> fields, else -> return Err(ProviderFailure.malformed("compile sample record is not an object")) }
        phases :: if record.get("phase_totals") == { .Val(.Array(values)) -> values, else -> return Err(ProviderFailure.malformed("compile sample record has no phase totals")) }
        loop phase_value in phases {
            phase :: if phase_value == { .Object(fields) -> fields, else -> return Err(ProviderFailure.malformed("compile phase total is not an object")) }
            name :: if phase.get("name") == { .Val(.String(text)) -> text, else -> return Err(ProviderFailure.malformed("compile phase total has no name")) }
            text :: if phase.get("ns") == { .Val(.Integer(text)) -> text, else -> return Err(ProviderFailure.malformed("compile phase total has no duration")) }
            ns :: text.parse[U128]() ?? return Err(ProviderFailure.malformed("compile phase total is not an unsigned integer"))
            total :: totals.get(name) ?? U128{0}
            totals[name] = total.checked_add(ns) ?? return Err(ProviderFailure.malformed("compile phase total overflowed"))
        }
    }
    keys := totals.keys().to_list()
    &keys.sort()
    phases := [(String, U128)]{}
    loop key in keys -> &phases.push((key, totals[key]))
    phase_totals_json(phases)
}

// Rust: Source/BudgetProviders.rs:2330
fn run_in_process(function: InProcessProvider, request: &ProviderRequest, timeout: Duration, identity: String) -> [ProviderEvent] ProviderFailure! {
    if core.sys.target.selected_os() != "linux" -> return Err(ProviderFailure.operation(.Execution, "bounded in-process providers are enabled only on Linux"))
    cancellation :: ProviderCancellation{cancelled: Arc.new(AtomicBool.new(false))}
    bytes :: run_isolated_bytes(timeout, "provider `{identity}`", fn() -> [U8] ProviderFailure! {
        result :: panic_runtime.catch_unwind(panic_runtime.AssertUnwindSafe(fn() { function(request, &cancellation) })) ?? return Err(ProviderFailure.operation(.Panic, "in-process provider failed unexpectedly")) // GATE #4494
        events :: result
        Ok(encode_stream(events))
    })
    decode_stream(bytes, request)
}
// Rust: Source/BudgetProviders.rs:2365
fn read_bounded(path: OSPath, timeout: Duration) -> [U8] ProviderFailure! {
    if core.sys.target.selected_os() == "linux" -> return read_bounded_isolated(path, timeout)
    Err(ProviderFailure.operation(.Execution, "isolated provider file reads are enabled only on Linux"))
}

