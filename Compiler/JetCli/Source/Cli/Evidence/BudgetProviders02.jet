// Rust: Source/BudgetProviders.rs:1815
fn copy_cache_tree(source: OSPath, destination: OSPath) Err! {
    fs.create_dir_all(destination) ?? return Err("cannot create compile workload cache directory: {err}")
    entries :: fs.read_dir(source) ?? return Err("cannot read compile workload cache: {err}")
    collected :: entries.collect() ?? return Err("cannot enumerate compile workload cache: {err}")
    loop entry in collected {
        path :: entry.path()
        metadata :: fs.symlink_metadata(path) ?? return Err("cannot inspect compile workload cache path: {err}")
        if metadata.file_type().is_symlink() -> return Err("compile workload cache contains a symlink: {path.display()}")
        target :: destination.join(entry.file_name())
        if metadata.is_dir() {
            copy_cache_tree(path, target)
        } else if metadata.is_file() {
            _ :: fs.copy(path, target) ?? return Err("cannot copy compile workload cache artifact: {err}")
        }
    }
    Ok(())
}

// Rust: Source/BudgetProviders.rs:1844
fn apply_unified_patch(root: OSPath, patch: String) Err! {
    if !safe_relative_path(patch) -> return Err("compile workload patch path is not project-relative")
    patch_bytes :: fs.read(root.join(patch)) ?? return Err("cannot read compile workload patch: {err}")
    patch_text :: String.from_utf8(^patch_bytes) ?? return Err("compile workload patch is not UTF-8")
    lines :: patch_text.lines().to_list()
    old_header :: lines.iter().find(fn(line) { line.starts_with("--- ") }) ?? return Err("compile workload patch has no old-file header")
    new_header :: lines.iter().find(fn(line) { line.starts_with("+++ ") }) ?? return Err("compile workload patch has no new-file header")
    old_path :: patch_header_path(old_header)
    new_path :: patch_header_path(new_header)
    if old_path != new_path -> return Err("compile workload patch changes more than one file")
    hunk_index :: lines.iter().position(fn(line) { line.starts_with("@@") }) ?? return Err("compile workload patch has no hunk")
    header := lines[hunk_index].split_whitespace()
    if header.next() != Val("@@") -> return Err("compile workload patch has an invalid hunk header")
    parse_range :: fn(value: String) -> (Int, Int) Err! {
        value :: value.get(1..) ?? return Err("compile workload patch has an invalid hunk range")
        parts :: value.split_once(",")
        start_text :: if parts == { .Val(pair) -> pair.before, .None -> value }
        count_text :: if parts == { .Val(pair) -> pair.after, .None -> "1" }
        start :: start_text.parse[Int]() ?? return Err("compile workload patch has an invalid hunk start")
        count :: count_text.parse[Int]() ?? return Err("compile workload patch has an invalid hunk count")
        if start < 0 -> return Err("compile workload patch has an invalid hunk start")
        if count < 0 -> return Err("compile workload patch has an invalid hunk count")
        if start == 0 -> return Err("compile workload patch has a zero hunk start")
        Ok((start, count))
    }
    (old_start_one, old_count) :: parse_range(header.next() ?? return Err("compile workload patch has no old hunk range"))
    (_, new_count) :: parse_range(header.next() ?? return Err("compile workload patch has no new hunk range"))
    target :: root.join(new_path)
    metadata :: fs.symlink_metadata(target) ?? return Err("compile workload patch target is unavailable: {err}")
    if metadata.file_type().is_symlink() || !metadata.is_file() -> return Err("compile workload patch target is not a regular file")
    original :: fs.read_to_string(target) ?? return Err("cannot read compile workload patch target: {err}")
    trailing_newline :: original.ends_with("\n")
    current :: original.lines().to_list()
    old_start :: old_start_one - 1
    if old_start > current.len() -> return Err("compile workload patch hunk starts outside the source tree")
    output := [String]{}
    loop index in 0..<old_start -> &output.push(current[index])
    cursor := old_start
    seen_old := 0
    seen_new := 0
    loop index in (hunk_index + 1)..<lines.len() {
        line :: lines[index]
        if line.starts_with("@@") -> return Err("compile workload patch must contain exactly one hunk")
        if line.starts_with("\\ No newline") -> continue
        (kind, body) :: line.split_at(1)
        if kind == {
            " " -> {
                if current.get(cursor) != Val(body) -> return Err("compile workload patch context does not match the source tree")
                &output.push(body)
                cursor += 1
                seen_old += 1
                seen_new += 1
            }
            "-" -> {
                if current.get(cursor) != Val(body) -> return Err("compile workload patch removal does not match the source tree")
                cursor += 1
                seen_old += 1
            }
            "+" -> { &output.push(body); seen_new += 1 }
            else -> return Err("compile workload patch contains an invalid hunk line")
        }
    }
    if seen_old != old_count || seen_new != new_count -> return Err("compile workload patch hunk counts do not match its body")
    loop index in cursor..<current.len() -> &output.push(current[index])
    rewritten := output.join("\n")
    if trailing_newline -> &rewritten.push_str("\n")
    fs.write(target, rewritten) ?? return Err("cannot apply compile workload patch: {err}")
    Ok(())
}

// Rust: Source/BudgetProviders.rs:1968
fn patch_header_path(header: String) -> String Err! {
    value :: header[4..].split("\t").next() ?? ""
    value :: value.strip_prefix("a/") ?? value.strip_prefix("b/") ?? value
    if !safe_relative_path(value) -> return Err("compile workload patch header has an unsafe path")
    Ok(value)
}

