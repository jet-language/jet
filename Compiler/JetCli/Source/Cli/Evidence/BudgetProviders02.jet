struct Reader { bytes: View[U8], at: Int }
// Rust: Source/BudgetProviders.rs:2960
fn Reader.take(self: &Reader, n: Int) -> View[U8] ProviderFailure! {
    end :: self.at.checked_add(n) ?? return Err(ProviderFailure.malformed("provider frame length overflow"))
    value :: self.bytes.get(self.at..end) ?? return Err(ProviderFailure.malformed("provider stream is truncated"))
    self.at = end
    Ok(value)
}
// Rust: Source/BudgetProviders.rs:2972
fn Reader.byte(self: &Reader) -> U8 ProviderFailure! { Ok(self.take(1)[0]) }
// Rust: Source/BudgetProviders.rs:2975
fn Reader.u32(self: &Reader) -> U32 ProviderFailure! { Ok(U32.from_be_bytes(self.take(4))) }
// Rust: Source/BudgetProviders.rs:2978
fn Reader.u64(self: &Reader) -> U64 ProviderFailure! { Ok(U64.from_be_bytes(self.take(8))) }
// Rust: Source/BudgetProviders.rs:2981
fn Reader.text(self: &Reader) -> String ProviderFailure! {
    n :: self.u32() as Int
    Ok(String.from_utf8(self.take(n).to_list()) ?? return Err(ProviderFailure.malformed("provider text is not UTF-8")))
}

// Rust: Source/BudgetProviders.rs:2988
fn validate_events(events: [ProviderEvent], request: &ProviderRequest) -> ProviderEvidence ProviderFailure! {
    if events.is_empty() -> return Err(ProviderFailure.malformed("provider stream is empty"))
    sample_count := 0
    complete := false
    last_spec := U32{0}
    seen := false
    loop index in 0..<events.len() {
        if complete -> return Err(ProviderFailure.malformed("event follows final Complete"))
        if events[index] == {
            .Sample(spec, metric, _) -> {
                if spec as Int >= request.specs.len() || request.specs[spec as Int].metric != metric -> return Err(ProviderFailure.operation(.Incompatible, "provider sample does not match requested spec/metric"))
                if seen && spec < last_spec -> return Err(ProviderFailure.malformed("provider events are not contiguous and ordered"))
                seen = true; last_spec = spec; sample_count += 1
                if sample_count > MAX_SAMPLES -> return Err(ProviderFailure.malformed("provider emitted more than 1000000 samples"))
            }
            .Metadata(spec, details) -> {
                if spec as Int >= request.specs.len() || details.is_empty() -> return Err(ProviderFailure.malformed("provider metadata has an invalid spec or no fields"))
                if detail_scalars("", details) > MAX_METADATA_SCALARS -> return Err(ProviderFailure.malformed("provider metadata exceeds its scalar limit"))
                previous := String?{None}
                loop (key, value) in details {
                    if key.is_empty() || previous.is_some_and(fn(prior) { prior >= key }) -> return Err(ProviderFailure.malformed("provider metadata keys are not unique and sorted"))
                    if value.is_empty() -> return Err(ProviderFailure.malformed("provider metadata contains an empty value"))
                    previous = Val(key)
                }
                if seen && spec < last_spec -> return Err(ProviderFailure.malformed("provider events are not contiguous and ordered"))
                seen = true; last_spec = spec
            }
            .Unavailable(spec, reason, details) -> {
                if spec as Int >= request.specs.len() || reason.is_empty() -> return Err(ProviderFailure.malformed("provider Unavailable has invalid spec or empty reason"))
                if detail_scalars(reason, details) > MAX_DETAIL_SCALARS -> return Err(ProviderFailure.malformed("provider unavailable detail exceeds 512 scalars"))
                if seen && spec < last_spec -> return Err(ProviderFailure.malformed("provider events are not contiguous and ordered"))
                seen = true; last_spec = spec
            }
            .Complete(request_id, samples) -> {
                if index + 1 != events.len() || request_id != request.request_id || samples != sample_count as U64 -> return Err(ProviderFailure.malformed("provider Complete request id/count/finality mismatch"))
                complete = true
            }
        }
    }
    if !complete -> return Err(ProviderFailure.malformed("provider stream has no final Complete"))
    Ok(ProviderEvidence{events: ^events})
}
// Rust: Source/BudgetProviders.rs:3106
fn detail_scalars(reason: String, details: [(String, String)]) -> Int {
    sum := 0
    loop (key, value) in details -> sum += key.chars().count().saturating_add(value.chars().count())
    reason.chars().count().saturating_add(sum)
}
// Rust: Source/BudgetProviders.rs:3114
fn is_hex64(value: String) -> Bool {
    if value.bytes().len() != 64 -> return false
    loop byte in value.bytes() { if !((byte >= 48 && byte <= 57) || (byte >= 97 && byte <= 102)) -> return false }
    true
}
// Rust: Source/BudgetProviders.rs:3121
pub fn unavailable_if_too_few(budget: String, evidence: &ProviderEvidence, minimum: Int) ProviderDiagnostic! {
    count := 0
    first_unavailable := String?{None}
    loop event in evidence.events {
        if event == { .Sample(_, _, _) -> { count += 1 }, .Unavailable(_, reason, _) -> { if first_unavailable == None -> first_unavailable = Val(reason) }, else -> {} }
    }
    if first_unavailable == { .Val(reason) -> return Err(ProviderFailure.operation(.Unavailable, reason).diagnostic(budget)), .None -> {} }
    if count < minimum -> return Err(ProviderFailure.operation(.Unavailable, "provider returned {count} samples; policy requires {minimum}").diagnostic(budget))
    Ok(())
}
// Rust: Source/BudgetProviders.rs:3152
pub fn evaluate_provider_evidence(budget: String, evidence_id: String, context_key: String, baseline_report_ids: [String], evidence: &ProviderEvidence, spec: U32, baseline: [Rational], percentile: Percentile?, comparison: &Comparison, direction: Direction, enforcement: Enforcement, policy: MeasurementPolicy?, minimum_samples: Int) -> Evaluation ProviderDiagnostic! {
    samples := [Rational]{}
    loop event in evidence.events {
        if event == {
            .Sample(event_spec, _, value) -> { if event_spec == spec -> &samples.push(value) }
            .Unavailable(event_spec, reason, _) -> { if event_spec == spec -> return Err(ProviderFailure.operation(.Unavailable, reason).diagnostic(budget)) }
            else -> {}
        }
    }
    if samples.len() < minimum_samples -> return Err(ProviderFailure.operation(.Unavailable, "provider returned {samples.len()} samples; policy requires {minimum_samples}").diagnostic(budget))
    Ok(evaluate(evidence_id, context_key, baseline_report_ids, samples, baseline, percentile, comparison, direction, enforcement, policy) ?? return Err(ProviderFailure.operation(.Execution, "shared evaluator rejected provider evidence: {err}").diagnostic(budget)))
}
// Rust: Source/BudgetProviders.rs:3219
pub fn evaluation_diagnostic(budget: String, evaluation: &Evaluation, direction: Direction, baseline_report_ids: [String]) -> ProviderDiagnostic? {
    if evaluation.evidence == {
        .Pass -> None
        .Unavailable -> Val(ProviderFailure.operation(.Unavailable, "the shared evaluator found no compatible nonzero baseline evidence").diagnostic(budget))
        .Regression | .Inconclusive -> {
            state :: if evaluation.evidence == .Regression -> "regressed" else -> "is inconclusive"
            rational :: fn(value: Rational) { "{value.num}/{value.den}" }
            lower :: evaluation.lower95.map(rational) ?? "none"
            upper :: evaluation.upper95.map(rational) ?? "none"
            point :: rational(evaluation.point)
            direction_text :: if direction == { .LowerIsBetter -> "lower-is-better", .HigherIsBetter -> "higher-is-better" }
            reports :: baseline_report_ids.join(",")
            Val(ProviderDiagnostic{code: "E2907", what: "Performance budget {budget} {state}", why: "Estimator {point} with confidence [{lower}, {upper}] in {direction_text} direction did not prove the limit; baseline reports [{reports}]", fix: "Improve the measured behavior, inspect the named evidence, or record an explicit exception"})
        }
    }
}
