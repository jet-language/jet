// exact borrowed C layout, pointers, descriptor ownership and native admission.
// Rust: Source/BudgetProviders.rs:2381
fn read_bounded_isolated(path: OSPath, timeout: Duration) -> [U8] ProviderFailure! {
    name :: std.ffi.CString.new(path.encoded) ?? return Err(ProviderFailure.operation(.Execution, "provider response path contains NUL")) // GATE #4494
    O_RDONLY :: I32{0}
    O_NONBLOCK :: I32{2048}
    O_CLOEXEC :: I32{524288}
    O_NOFOLLOW :: I32{131072}
    AT_EMPTY_PATH :: I32{4096}
    STATX_TYPE :: U32{1}
    S_IFMT :: U16{61440}
    S_IFREG :: U16{32768}
    // GATE #4494: cfg(test) instrumentation must be selected at compile time.
    active := ActiveFileReader?{None}
    if core.sys.target.test_build() -> active = Val(ActiveFileReader.new())
    defer { if active == { .Val(owner) -> owner.close(), .None -> {} } }
    run_isolated_bytes(timeout, "provider response {path.display()}", fn() -> [U8] ProviderFailure! {
        #Unsafe("borrow initialized C path/stat/buffer storage for descriptor reads") {
            if core.sys.target.test_build() {
                delay :: FILE_READER_DELAY_MS.load(AtomicOrdering.Relaxed)
                if delay > 0 -> _ :: native.usleep((delay.min(U32.MAX as U64) * 1000) as U32)
            }
            fd :: native.open(name.as_ptr(), O_RDONLY | O_NONBLOCK | O_CLOEXEC | O_NOFOLLOW)
            if fd < 0 -> return Err(ProviderFailure.operation(.Execution, "cannot open provider response without following links"))
            empty :: [U8]{0}
            info := std.mem.zeroed[Statx]() // GATE #4494
            if native.statx(fd, empty.as_ptr() as *I8, AT_EMPTY_PATH, STATX_TYPE, &info) != 0 || (info.mode & S_IFMT) != S_IFREG {
                _ :: native.close(fd)
                return Err(ProviderFailure.operation(.Execution, "provider response is not a regular file"))
            }
            bytes := [U8]{}
            buffer := [U8; 8192]{0}
            loop {
                count :: native.read(fd, buffer.as_mut_ptr(), buffer.len())
                if count < 0 {
                    _ :: native.close(fd)
                    return Err(ProviderFailure.operation(.Execution, "cannot read provider response"))
                }
                if count == 0 -> break
                &bytes.extend_from_slice(buffer[0..count as Int])
                if bytes.len() > MAX_BYTES {
                    _ :: native.close(fd)
                    return Err(ProviderFailure.malformed("provider stream exceeds 16 MiB"))
                }
            }
            _ :: native.close(fd)
            Ok(^bytes)
        }
    })
}

