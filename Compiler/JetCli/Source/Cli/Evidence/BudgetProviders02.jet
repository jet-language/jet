fn run_isolated_bytes[F](timeout: Duration, label: String, work: F) -> [U8] ProviderFailure! where F: FnOnce[() -> [U8] ProviderFailure!] {
    O_NONBLOCK :: I32{2048}
    F_SETFL :: I32{4}
    WNOHANG :: I32{1}
    SIGKILL :: I32{9}
    PR_SET_PDEATHSIG :: I32{1}
    // Rust: Source/BudgetProviders.rs:2520
    // pipe/fork/close/read/write/fcntl/waitpid/kill/setpgid/getpid/getppid/
    // prctl/_exit are raw native imports, never callbacks into Rust.
    #Unsafe("isolated Linux worker pipe/group/prctl lifecycle; native admission #4494") {
        supervisor :: native.getpid()
        pipes := [I32; 2]{-1}
        if native.pipe(pipes.as_mut_ptr()) != 0 -> return Err(ProviderFailure.operation(.Execution, "cannot create isolated worker pipe: {io.Error.last_os_error()}"))
        pid :: native.fork()
        if pid < 0 {
            _ :: native.close(pipes[0])
            _ :: native.close(pipes[1])
            return Err(ProviderFailure.operation(.Execution, "cannot isolate {label}: {io.Error.last_os_error()}"))
        }
        if pid == 0 {
            if native.prctl(PR_SET_PDEATHSIG, SIGKILL as Int, 0, 0, 0) != 0 || native.getppid() != supervisor -> native._exit(1)
            _ :: native.close(pipes[0])
            _ :: native.setpgid(0, 0)
            _ :: native.close(2)
            // GATE #4494: fork-child allocating/unwind execution needs the
            // audited native runtime boundary, not ordinary scheduler reentry.
            caught :: panic_runtime.catch_unwind(panic_runtime.AssertUnwindSafe(^work))
            result :: if caught == { .Ok(value) -> value, .Err(_) -> Err(ProviderFailure.operation(.Panic, "isolated worker panicked")) }
            frame := [U8]{}
            if result == {
                .Ok(bytes) -> { &frame.push(0); &frame.extend_from_slice(bytes) }
                .Err(failure) -> { &frame.push(1); &frame.push(class_byte(failure.class)); &frame.extend_from_slice(failure.reason.bytes()) }
            }
            at := 0
            loop at < frame.len() {
                sent :: native.write(pipes[1], frame[at..].as_ptr(), frame.len() - at)
                if sent <= 0 -> break
                at += sent as Int
            }
            _ :: native.close(pipes[1])
            native._exit(0)
        }
        // GATE #4494: compile-time test instrumentation, scoped until return.
        active := ActiveIsolatedWorker?{None}
        if core.sys.target.test_build() -> active = Val(ActiveIsolatedWorker.new())
        defer { if active == { .Val(owner) -> owner.close(), .None -> {} } }
        _ :: native.close(pipes[1])
        _ :: native.setpgid(pid, pid)
        _ :: native.fcntl(pipes[0], F_SETFL, O_NONBLOCK)
        if core.sys.target.test_build() -> LAST_ISOLATED_GROUP.store(pid as U64, AtomicOrdering.SeqCst)
        deadline :: Instant.now() + timeout
        frame := [U8]{}
        worker_reaped := false
        buffer := [U8; 8192]{0}
        loop {
            count :: native.read(pipes[0], buffer.as_mut_ptr(), buffer.len())
            if count > 0 { &frame.extend_from_slice(buffer[0..count as Int]); continue }
            if count == 0 { _ :: native.close(pipes[0]); break }
            if !worker_reaped {
                status := I32{0}
                waited :: native.waitpid(pid, &status, WNOHANG)
                if waited == pid -> worker_reaped = true
            }
            if Instant.now() >= deadline {
                _ :: native.kill(-pid, SIGKILL)
                if !worker_reaped { status := I32{0}; _ :: native.waitpid(pid, &status, 0) }
                _ :: native.close(pipes[0])
                return Err(ProviderFailure.operation(.Timeout, "{label} timed out and its isolated process group was terminated"))
            }
            thread.sleep(Duration.from_millis(1))
        }
        if !worker_reaped { status := I32{0}; _ :: native.waitpid(pid, &status, 0) }
        if frame.first() == {
            .Val(0) -> Ok(frame[1..].to_list())
            .Val(1) -> {
                class :: frame.get(1).and_then(byte_class) ?? return Err(ProviderFailure.operation(.Execution, "isolated worker returned an invalid failure class"))
                reason :: String.from_utf8(frame[2..].to_list()) ?? return Err(ProviderFailure.operation(.Execution, "isolated worker returned non-UTF-8 failure text"))
                Err(ProviderFailure.operation(class, reason))
            }
            else -> Err(ProviderFailure.operation(.Execution, "{label} exited without a result"))
        }
    }
}

// Rust: Source/BudgetProviders.rs:2702
fn run_subprocess(path: OSPath, request: [U8], timeout: Duration) -> [U8] ProviderFailure! {
    command := Command.new(path)
    &command.stdin(Stdio.piped()).stdout(Stdio.piped()).stderr(Stdio.null())
    if core.sys.target.selected_family() == "unix" -> &command.process_group(0)
    child := command.spawn() ?? return Err(ProviderFailure.operation(.Execution, "cannot launch provider {path.display()}: {err}"))
    stdin := child.stdin.take() ?? return Err(ProviderFailure.operation(.Execution, "provider stdin was unavailable"))
    (writer_tx, writer_rx) :: mpsc.sync_channel(1)
    thread.spawn(fn() { _ :: writer_tx.send(stdin.write_all(request)) }) // GATE #4494: captured stream/task transfer.
    stdout :: child.stdout.take() ?? return Err(ProviderFailure.operation(.Execution, "provider stdout was unavailable"))
    (tx, rx) :: mpsc.channel()
    thread.spawn(fn() {
        bytes := [U8]{}
        limited := stdout.take((MAX_BYTES + 1) as U64)
        result :: limited.read_to_end(&bytes).map(fn(_) { ^bytes })
        _ :: tx.send(^result)
    })
    deadline :: Instant.now() + timeout
    loop {
        if child.try_wait() == {
            .Ok(Val(status)) -> {
                if !status.success() { terminate_group(&child); return Err(ProviderFailure.operation(.Execution, "provider exited with {status}")) }
                remaining :: deadline.saturating_duration_since(Instant.now())
                read_result :: rx.recv_timeout(remaining) ?? {
                    terminate_group(&child)
                    return Err(ProviderFailure.operation(.Timeout, "provider stdout did not close before deadline"))
                }
                bytes :: read_result ?? return Err(ProviderFailure.operation(.Execution, "cannot read provider stdout: {err}"))
                write_result :: writer_rx.recv_timeout(deadline.saturating_duration_since(Instant.now())) ?? {
                    terminate_group(&child)
                    return Err(ProviderFailure.operation(.Timeout, "provider stdin did not close before deadline"))
                }
                _ :: write_result ?? return Err(ProviderFailure.operation(.Execution, "cannot write provider stdin: {err}"))
                if bytes.len() > MAX_BYTES -> return Err(ProviderFailure.malformed("provider stream exceeds 16 MiB"))
                return Ok(bytes)
            }
            .Ok(None) -> {
                if Instant.now() < deadline -> thread.sleep(Duration.from_millis(2))
                else { terminate_group(&child); return Err(ProviderFailure.operation(.Timeout, "provider timed out and was terminated")) }
            }
            .Err(error) -> { terminate_group(&child); return Err(ProviderFailure.operation(.Execution, "cannot supervise provider: {error}")) }
        }
    }
}
// Rust: Source/BudgetProviders.rs:2810
pub fn terminate_group(child: &Child) {
    if core.sys.target.selected_family() == "unix" {
        // Rust: Source/BudgetProviders.rs:2815
        #Unsafe("kill the child process group before reaping the child; #4494") { _ :: native.kill(-(child.id() as I32), 9) }
    }
    _ :: child.kill()
    _ :: child.wait()
}

// Rust: Source/BudgetProviders.rs:2824
pub fn encode_stream(events: [ProviderEvent]) -> [U8] {
    out := MAGIC.to_list()
    loop event in events {
        if event == {
            .Sample(spec, metric, value) -> {
                &out.push(1); put_u32(&out, spec); put_text(&out, metric)
                put_text(&out, value.num.to_string()); put_text(&out, value.den.to_string())
            }
            .Unavailable(spec, reason, details) -> {
                &out.push(2); put_u32(&out, spec); put_text(&out, reason); put_u32(&out, details.len() as U32)
                loop (key, value) in details { put_text(&out, key); put_text(&out, value) }
            }
            .Metadata(spec, details) -> {
                &out.push(4); put_u32(&out, spec); put_u32(&out, details.len() as U32)
                loop (key, value) in details { put_text(&out, key); put_text(&out, value) }
            }
            .Complete(request_id, samples) -> {
                &out.push(3); put_text(&out, request_id); &out.extend_from_slice(samples.to_be_bytes())
            }
        }
    }
    ^out
}
// Rust: Source/BudgetProviders.rs:2874
fn put_u32(out: &[U8], value: U32) { &out.extend_from_slice(value.to_be_bytes()) }
// Rust: Source/BudgetProviders.rs:2877
fn put_text(out: &[U8], value: String) { put_u32(out, value.bytes().len() as U32); &out.extend_from_slice(value.bytes()) }
// Rust: Source/BudgetProviders.rs:2882
fn decode_stream(bytes: [U8], request: &ProviderRequest) -> [ProviderEvent] ProviderFailure! {
    if bytes.len() > MAX_BYTES -> return Err(ProviderFailure.malformed("provider stream exceeds 16 MiB"))
    reader := Reader{bytes: bytes, at: 0}
    if reader.take(MAGIC.len()) != MAGIC -> return Err(ProviderFailure.malformed("provider stream has bad magic"))
    events := [ProviderEvent]{}
    loop reader.at < bytes.len() {
        tag :: reader.byte()
        event :: if tag == {
            1 -> {
                spec :: reader.u32(); metric :: reader.text(); num :: reader.text(); den :: reader.text()
                value :: Rational.parse(num, den) ?? return Err(ProviderFailure.malformed(err))
                ProviderEvent.Sample{spec: spec, metric: metric, value: value}
            }
            2 -> {
                spec :: reader.u32(); reason :: reader.text(); count :: reader.u32() as Int
                if count > MAX_DETAIL_SCALARS -> return Err(ProviderFailure.malformed("provider unavailable detail exceeds 512 scalars"))
                details := [(String, String)]{}
                loop _ in 0..<count { key :: reader.text(); value :: reader.text(); &details.push((key, value)) }
                if detail_scalars(reason, details) > MAX_DETAIL_SCALARS -> return Err(ProviderFailure.malformed("provider unavailable detail exceeds 512 scalars"))
                ProviderEvent.Unavailable{spec: spec, reason: reason, details: ^details}
            }
            4 -> {
                spec :: reader.u32(); count :: reader.u32() as Int
                if count > MAX_METADATA_SCALARS -> return Err(ProviderFailure.malformed("provider metadata exceeds its scalar limit"))
                details := [(String, String)]{}
                loop _ in 0..<count { key :: reader.text(); value :: reader.text(); &details.push((key, value)) }
                ProviderEvent.Metadata{spec: spec, details: ^details}
            }
            3 -> { request_id :: reader.text(); samples :: reader.u64(); ProviderEvent.Complete{request_id: request_id, samples: samples} }
            else -> return Err(ProviderFailure.malformed("provider stream has unknown event tag"))
        }
        &events.push(^event)
    }
    evidence :: validate_events(^events, request)
    Ok(evidence.events)
}
