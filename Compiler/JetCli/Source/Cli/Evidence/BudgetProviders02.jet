fn class_byte(class: FailureClass) -> U8 {
    if class == { .Unavailable -> 0, .Malformed -> 1, .Panic -> 2, .Timeout -> 3, .Execution -> 4, .Incompatible -> 5, .Unsupported -> 6, .Unresolved -> 7 }
}
// Rust: Source/BudgetProviders.rs:2546
fn byte_class(value: U8) -> FailureClass? {
    if value == { 0 -> Val(.Unavailable), 1 -> Val(.Malformed), 2 -> Val(.Panic), 3 -> Val(.Timeout), 4 -> Val(.Execution), 5 -> Val(.Incompatible), 6 -> Val(.Unsupported), 7 -> Val(.Unresolved), else -> None }
}
