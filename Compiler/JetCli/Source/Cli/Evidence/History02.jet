// Rust: Source/ReceiptStore.rs:2647
fn canonicalize_receipt_stderr(verb: String, stderr: [U8]) -> [U8] {
    if verb != "build" -> return ~stderr
    canonical := [U8]{}
    offset := 0
    loop offset < stderr.len() {
        line_end := offset
        loop line_end < stderr.len() && stderr[line_end] != U8{10} -> line_end += 1
        line :: stderr[offset..<line_end]
        rewritten := false
        if find_bytes(line, "Built ".bytes()) == Val(built) {
            start :: built + 6
            if find_bytes(line[start..<line.len()], " in ".bytes()) == Val(timing) {
                timing_start :: start + timing
                if find_bytes(line[(timing_start + 4)..<line.len()], [U8]{U8{226}, U8{156}, U8{147}}) == Val(check) {
                    &canonical.extend(line[0..<timing_start])
                    &canonical.push(U8{32})
                    &canonical.extend(line[(timing_start + 4 + check)..<line.len()])
                    rewritten = true
                }
            }
        }
        if !rewritten -> &canonical.extend(line)
        if line_end < stderr.len() -> &canonical.push(U8{10})
        offset = line_end + 1
    }
    canonical
}
// Rust: Source/ReceiptStore.rs:2681
fn find_bytes(haystack: [U8], needle: [U8]) -> Int? {
    if needle.len() > haystack.len() -> return None
    loop index in 0..<(haystack.len() - needle.len() + 1) {
        if haystack[index..<(index + needle.len())] == needle -> return Val(index)
    }
    None
}
// Rust: Source/ReceiptStore.rs:2687
pub fn participating_verb(argv: [String]) -> String? {
    if argv.len() == 0 -> return None
    if argv[0] == "test" -> return Val("test")
    if argv[0] == "prove" -> return Val("prove")
    if argv[0] == "budget" && argv.len() > 1 && argv[1] == "check" -> return Val("budget check")
    None
}
// Rust: Source/ReceiptStore.rs:2698
fn cacheable_invocation(verb: String, argv: [String]) -> Bool {
    if verb == "prove" {
        loop arg in argv {
            if arg == "--capture" || arg == "--capture-sensitive" || arg == "--replay" || arg == "--save" || arg == "--unsave" || arg.starts_with("--capture=") || arg.starts_with("--capture-sensitive=") || arg.starts_with("--replay=") || arg.starts_with("--save=") || arg.starts_with("--unsave=") -> return false
        }
    }
    true
}

