// Rust: Source/ReceiptStore.rs:1770
fn decode_optional_receipt_job(bytes: [U8], project_root: OSPath) -> OptionalReceiptJob Err! {
    if bytes.len() > OPTIONAL_RECEIPT_JOB_MAX_BYTES || !bytes.starts_with(OPTIONAL_RECEIPT_JOB_MAGIC) -> return Err("optional receipt job schema or size is invalid")
    cursor := OPTIONAL_RECEIPT_JOB_MAGIC.len()
    root :: optional_job_text(jet_cli_receipt_take_frame(bytes, &cursor), "project root", OPTIONAL_RECEIPT_JOB_MAX_PATH_BYTES)
    // GATE #4494: lossless native-path UTF-8 view.
    expected_root :: project_root.to_str() ?? return Err("canonical optional receipt project root is not UTF-8")
    if root != expected_root -> return Err("optional receipt job project root does not match its path")
    cwd :: OSPath.from(optional_job_text(jet_cli_receipt_take_frame(bytes, &cursor), "working directory", OPTIONAL_RECEIPT_JOB_MAX_PATH_BYTES))
    if !cwd.is_absolute() || !cwd.starts_with(project_root) -> return Err("optional receipt job working directory is outside its project root")
    context_key :: optional_job_text(jet_cli_receipt_take_frame(bytes, &cursor), "context key", JET_CLI_RECEIPT_DIGEST_LEN)
    if !jet_cli_receipt_is_digest(context_key) -> return Err("optional receipt job context key is malformed")
    verb :: optional_job_text(jet_cli_receipt_take_frame(bytes, &cursor), "verb", OPTIONAL_RECEIPT_JOB_MAX_PATH_BYTES)
    key :: optional_job_text(jet_cli_receipt_take_frame(bytes, &cursor), "claim key", JET_CLI_RECEIPT_DIGEST_LEN)
    status_bytes :: jet_cli_receipt_take_frame(bytes, &cursor)
    if status_bytes.len() != 4 -> return Err("optional receipt job status is malformed")
    unsigned :: jet_cli_receipt_read_be(status_bytes)
    status :: I32{if unsigned >= 2147483648 -> unsigned - 4294967296 else -> unsigned}
    input_count :: optional_job_u64(bytes, &cursor, "input count")
    if input_count > 100000 -> return Err("optional receipt job has too many inputs")
    inputs := [JetCLIReceiptInput]{}
    loop _ in 0..<input_count {
        path :: OSPath.from(optional_job_text(jet_cli_receipt_take_frame(bytes, &cursor), "input path", OPTIONAL_RECEIPT_JOB_MAX_PATH_BYTES))
        if !path.is_absolute() || !path.starts_with(project_root) -> return Err("optional receipt job input path is outside its project root")
        digest :: optional_job_text(jet_cli_receipt_take_frame(bytes, &cursor), "input digest", JET_CLI_RECEIPT_DIGEST_LEN)
        if !jet_cli_receipt_is_digest(digest) -> return Err("optional receipt job input digest is malformed")
        &inputs.push(JetCLIReceiptInput{path: path, digest: digest})
    }
    argument_count :: optional_job_u64(bytes, &cursor, "argument count")
    if argument_count > OPTIONAL_RECEIPT_JOB_MAX_ARGS -> return Err("optional receipt job has too many arguments")
    argv := [String]{}
    loop _ in 0..<argument_count -> &argv.push(optional_job_text(jet_cli_receipt_take_frame(bytes, &cursor), "argument", OPTIONAL_RECEIPT_JOB_MAX_PATH_BYTES))
    stdout :: jet_cli_receipt_take_frame(bytes, &cursor)
    stderr :: jet_cli_receipt_take_frame(bytes, &cursor)
    if cursor != bytes.len() -> return Err("optional receipt job has trailing bytes")
    claim :: JetCLIReceiptClaim{verb: verb, key: key, inputs: inputs}
    if !jet_cli_receipt_is_digest(claim.key) || participating_verb(argv) != Val(claim.verb) || !cacheable_invocation(claim.verb, argv) -> return Err("optional receipt job claim does not match its cacheable act")
    Ok(OptionalReceiptJob{project_root: project_root, cwd: cwd, context_key: context_key, claim: claim, argv: argv, status: status, stdout: stdout, stderr: stderr})
}

// Rust: Source/ReceiptStore.rs:1893
fn persist_published_receipt<F: JetCLIReceiptReadHost, A: JetCLIReceiptAuthorityHost, P: JetCLIReceiptProcessHost, H: JetCLIRecordIndexFileHost, R: JetCLIRecordRetentionHost>(store: JetCLIReceiptStore, published_claim: JetCLIReceiptClaim, context_key: String, argv: [String], status: I32, stdout: [U8], stderr: [U8], cwd: receipt_paths.Path, file_host: &F, authority: &A, process_host: &P, host: &H, retention: &R) -> JetCLIReceiptError! {
    published :: jet_cli_receipt_store_write(store, published_claim, argv, status, stdout, stderr, [], [], [], &file_host, &host, &process_host)
    if !published -> return
    jet_cli_receipt_store_adopt_staged_sections(store, published_claim, &file_host, &host)
    jet_cli_receipt_store_remember_context_key(store, context_key, published_claim, &file_host, &host)
    if jet_cli_receipt_store_lookup(store, published_claim, &file_host) == Val(receipt) -> jet_cli_receipt_index_published(store, receipt, argv, cwd, &file_host, &authority, &process_host, &host, &retention)
}

// Rust: Source/ReceiptStore.rs:1919
// The bounded worker drops optional jobs when unavailable/full; never waits.
pub fn enqueue_optional_history(operation: String, job: fn() -> ()) -> {
    sender :: OPTIONAL_HISTORY_QUEUE.as_ref() ?? {
        optional_history_notice(operation, "optional history worker is unavailable")
        return
    }
    // GATE #4494: bounded native try_send and one-shot sendable closure.
    if sender.try_send((operation, ^job)) == {
        .Ok(_) -> {}
        .Err(.Full((name, _))) -> optional_history_notice(name, "optional history queue is full or unavailable")
        .Err(.Disconnected((name, _))) -> optional_history_notice(name, "optional history queue is full or unavailable")
    }
}

// Rust: Source/ReceiptStore.rs:1939
// A returned status belongs to the captured act; None leaves dispatch untouched.
pub fn run_if_needed<F: JetCLIReceiptReadHost, A: JetCLIReceiptAuthorityHost, P: JetCLIReceiptProcessHost, H: JetCLIRecordIndexFileHost, R: JetCLIRecordRetentionHost>(argv: [String], tools: JetCLIReceiptToolIdentity, file_host: &F, authority: &A, process_host: &P, host: &H, retention: &R) -> I32? {
    // GATE #4494: native environment, child process, threads, clock and atomic id.
    if std.env.var_os("JET_RECEIPT_BYPASS") != None -> return None
    verb :: participating_verb(argv) ?? return None
    if !cacheable_invocation(verb, argv) -> return None
    cwd :: &process_host.current_dir() ?? {
        optional_history_notice("resolving receipt working directory", err.message)
        return None
    }
    root :: jet_cli_receipt_root_for(verb, argv, cwd, &file_host, &authority)
    store :: JetCLIReceiptStore{root: root}
    if jet_cli_receipt_store_lookup_context(store, verb, argv, cwd, tools, &file_host, &authority, &process_host) == {
        .Ok(found) -> {
            if found == Val(receipt) {
                store_root :: ~store.root
                receipt_for_index :: ~receipt
                argv_for_index :: ~argv
                cwd_for_index :: ~cwd
                enqueue_optional_history("indexing a cached receipt", () -> {
                    index_store :: JetCLIReceiptStore{root: store_root}
                    jet_cli_receipt_index_published(index_store, receipt_for_index, argv_for_index, cwd_for_index, &file_host, &authority, &process_host, &host, &retention) ?? optional_history_notice("indexing a cached receipt", err.message)
                })
                secret_values :: jet_cli_receipt_secret_values(argv, &process_host)
                jet_cli_receipt_replay(verb, argv, receipt, secret_values, &process_host)
                return Val(receipt.status)
            }
        }
        .Err(error) -> {
            optional_history_notice("reading a cached receipt", error.message)
            return None
        }
    }
    input_paths :: if verb == "check" && !jet_cli_receipt_has_explicit_target(verb, argv) -> jet_cli_receipt_project_check_input_paths(cwd, &file_host, &authority) ?? jet_cli_receipt_input_paths_for(verb, argv, cwd, &file_host, &authority) else -> jet_cli_receipt_input_paths_for(verb, argv, cwd, &file_host, &authority)
    if input_paths.len() == 0 && verb != "budget check" -> return None
    claim := jet_cli_receipt_store_claim(verb, argv, input_paths, tools, &file_host, &authority, &process_host) ?? {
        optional_history_notice("claiming a receipt", err.message)
        return None
    }
    if verb == "prove" {
        target_inputs_sha256 :: jet_cli_receipt_target_inputs_sha256(claim, argv, cwd, jet_cli_receipt_current_dir(&process_host), &file_host, &authority) ?? {
            optional_history_notice("resolving receipt identity", err.message)
            return None
        }
        filtered_paths := [receipt_paths.Path]{}
        has_generated_failure := false
        loop input in claim.inputs {
            matches :: jet_cli_receipt_generated_failure_matches_target(input.path, target_inputs_sha256)
            if !jet_cli_receipt_is_generated_failure_input(input.path) || matches -> &filtered_paths.push(~input.path)
            if matches -> has_generated_failure = true
        }
        if has_generated_failure {
            nanos :: time.SystemTime.now().duration_since(time.UNIX_EPOCH).map((duration) -> duration.as_nanos()) ?? 0
            attempt :: "{process.id()}:{nanos}:{NEXT_TEMP_ID.fetch_add(1, sync.Ordering.Relaxed)}"
            claim = jet_cli_receipt_store_claim_with_attempt(verb, argv, filtered_paths, attempt.bytes(), tools, &file_host, &authority, &process_host) ?? {
                optional_history_notice("claiming a generated replay receipt", err.message)
                return None
            }
        } else {
            if filtered_paths.len() != claim.inputs.len() {
                claim = jet_cli_receipt_store_claim(verb, argv, filtered_paths, tools, &file_host, &authority, &process_host) ?? {
                    optional_history_notice("claiming a filtered receipt", err.message)
                    return None
                }
            }
        }
    }
    proof_receipt_link :: if verb == "prove" -> jet_cli_receipt_reserve_record(store, claim, argv, cwd, &file_host, &authority, &process_host, &host, &retention) ?? {
        optional_history_notice("reserving a receipt record", err.message)
        None
    } else -> None
    executable :: &process_host.current_exe() ?? {
        optional_history_notice("resolving the Jet executable for receipt capture", err.message)
        return None
    }
    command := process.Command.new(executable)
    &command.args(argv)
    &command.current_dir(cwd)
    &command.env("JET_RECEIPT_BYPASS", "1")
    &command.env(JET_RECEIPT_DIR_ENV, store.root)
    &command.env(JET_RECEIPT_CLAIM_ENV, claim.key)
    // The parent digest is unknown until capture; staged sections bind later.
    &command.env(JET_RECEIPT_DIGEST_ENV, "")
    if proof_receipt_link != None -> &command.env(JET_RECEIPT_RECORD_CLAIM_ENV, claim.key)
    else -> &command.env_remove(JET_RECEIPT_RECORD_CLAIM_ENV)
    &command.stdout(process.Stdio.piped())
    &command.stderr(process.Stdio.piped())
    child := &command.spawn() ?? {
        optional_history_notice("starting receipt capture", err.to_string())
        return None
    }
    stdout :: &child.stdout.take() ?? {
        &child.kill() ?? {}
        optional_history_notice("capturing receipt stdout", "receipt child did not expose stdout")
        return None
    }
    stderr :: &child.stderr.take() ?? {
        &child.kill() ?? {}
        optional_history_notice("capturing receipt stderr", "receipt child did not expose stderr")
        return None
    }
    stdout_reader :: thread.spawn(() -> capture_stream(^stdout, std.io.stdout()))
    stderr_reader :: thread.spawn(() -> capture_stream(^stderr, std.io.stderr()))
    child_status :: &child.wait() ?? {
        optional_history_notice("waiting for receipt capture", err.to_string())
        return None
    }
    status :: child_status.code() ?? I32{1}
    captured_stdout :: stdout_reader.join() ?? [U8]{}
    captured_stderr :: stderr_reader.join() ?? [U8]{}
    published_claim := ~claim
    if verb == "prove" {
        target_inputs_sha256 :: jet_cli_receipt_target_inputs_sha256(claim, argv, cwd, jet_cli_receipt_current_dir(&process_host), &file_host, &authority) ?? {
            optional_history_notice("resolving published receipt identity", err.message)
            return None
        }
        current_paths := [receipt_paths.Path]{}
        loop path in jet_cli_receipt_input_paths_for(verb, argv, cwd, &file_host, &authority) {
            if !jet_cli_receipt_is_generated_failure_input(path) || jet_cli_receipt_generated_failure_matches_target(path, target_inputs_sha256) -> &current_paths.push(path)
        }
        current_claim :: jet_cli_receipt_store_claim(verb, argv, current_paths, tools, &file_host, &authority, &process_host) ?? {
            optional_history_notice("claiming the published receipt", err.message)
            return None
        }
        published_claim.inputs = current_claim.inputs
    }
    secret_values :: jet_cli_receipt_secret_values(argv, &process_host)
    redacted_stdout :: bounded_redact_bytes(captured_stdout, secret_values) ?? {
        optional_history_notice("staging optional receipt job", err)
        return Val(status)
    }
    canonical_stderr :: canonicalize_receipt_stderr(verb, captured_stderr)
    receipt_stderr :: bounded_redact_bytes(canonical_stderr, secret_values) ?? {
        optional_history_notice("staging optional receipt job", err)
        return Val(status)
    }
    context_key :: jet_cli_receipt_store_context_key(verb, argv, tools, &process_host) ?? {
        optional_history_notice("staging optional receipt job", err.message)
        return Val(status)
    }
    project_root :: jet_cli_receipt_project_root_for_store(store.root, cwd, &file_host) ?? {
        optional_history_notice("staging optional receipt job", "receipt store is not rooted at the canonical `.jet/receipts` path")
        return Val(status)
    }
    helper_cwd :: &file_host.canonicalize(cwd) ?? {
        optional_history_notice("staging optional receipt job", "could not canonicalize receipt working directory: {err.message}")
        return Val(status)
    }
    if jet_cli_receipt_strip_prefix(helper_cwd, project_root) == None {
        optional_history_notice("staging optional receipt job", "receipt working directory is outside its canonical project root")
        return Val(status)
    }
    job :: OptionalReceiptJob{project_root: project_root, cwd: helper_cwd, context_key: context_key, claim: published_claim, argv: redacted_optional_receipt_argv(argv), status: status, stdout: redacted_stdout, stderr: receipt_stderr}
    spawn_optional_receipt_helper(job) ?? optional_history_notice("staging optional receipt job", err)
    Val(status)
}

