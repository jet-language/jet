pub fn read_authority_file(path: OSPath) -> AuthorityFileSnapshot io.Error! {
    parent :: path.parent().filter((parent) -> !parent.as_os_str().is_empty()) ?? OSPath.from(".")
    name :: path.file_name() ?? return Err(io.Error.new(.InvalidInput, "authority path has no file name"))
    authority :: DirectoryAuthority.open(parent)
    if !descriptor_supported() -> return Err(unsupported_descriptor_error())
    root_metadata :: (authority.handle ?? panic("authority handle")).metadata()
    authority.snapshot_child_file(name, path, OSPath.from(name), root_metadata)
}
// Rust: Source/Store.rs:834
pub fn append_authority_file(path: OSPath, bytes: [U8]) -> io.Error! {
    parent :: path.parent().filter((parent) -> !parent.as_os_str().is_empty()) ?? OSPath.from(".")
    name :: path.file_name() ?? return Err(io.Error.new(.InvalidInput, "authority path has no file name"))
    DirectoryAuthority.create(parent).append_child_file(name, bytes)
}
