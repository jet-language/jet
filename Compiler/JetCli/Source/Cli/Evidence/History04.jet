fn dp_create_path(path: OSPath) -> fs.File io.Error! {
    if !descriptor_supported() -> return Err(unsupported_descriptor_error())
    current := dp_open_anchor(path)
    loop component in dp_components(path) {
        if dp_open_at(&current, component, true) == {
            .Ok(next) -> current = ^next
            .Err(error) -> {
                if error.kind() != .NotFound -> return Err(error)
                component_name :: dp_name(component)
                if mkdirat(current.as_raw_fd(), component_name.as_ptr(), 0o700) != 0 {
                    mkdir_error :: io.Error.last_os_error()
                    if mkdir_error.kind() != .AlreadyExists -> return Err(mkdir_error)
                } else -> current.sync_all()
                current = dp_open_at(&current, component, true)
            }
        }
    }
    Ok(^current)
}
