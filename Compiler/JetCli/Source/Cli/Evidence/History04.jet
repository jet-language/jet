fn same_store_file_identity(left: fs.Metadata, right: fs.Metadata) -> Bool {
    if target.selected_family() == "unix" -> return left.dev() == right.dev() && left.ino() == right.ino() && left.len() == right.len() && left.modified().ok() == right.modified().ok()
    left.file_type() == right.file_type() && left.len() == right.len() && left.modified().ok() == right.modified().ok()
}
