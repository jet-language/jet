fn ignored_tree_name(name: String) -> Bool { name.starts_with(".") || name == "build" || name == "target" }
// Rust: Source/Store.rs:1678
struct AuthorityTreeFile { relative: String, file: fs.File, metadata: fs.Metadata }
// Rust: Source/Store.rs:1684
fn collect_authority_tree(directory: &DirectoryAuthority, relative: OSPath, files: &[AuthorityTreeFile], depth: Int, reject_hardlinks: Bool) -> io.Error! {
    if depth > MAX_TREE_DEPTH -> return Err(io.Error.new(.InvalidData, "package tree exceeds the maximum directory depth"))
    names :: directory.list_names()
    loop name in names {
        #If(test) { before_store_child_open(directory.path(), name) }
        file :: directory.open_child(name)
        metadata :: file.metadata()
        name_str :: name.to_str() ?? return Err(io.Error.new(.InvalidData, "package tree contains a non-UTF-8 name"))
        child_relative :: relative.join(name)
        if metadata.is_dir() {
            if ignored_tree_name(name_str) -> next
            child :: DirectoryAuthority.from_opened(directory.path_value.join(name), ^file)
            collect_authority_tree(&child, child_relative, &files, depth + 1, reject_hardlinks)
        } else {
            if metadata.is_file() {
                if reject_hardlinks && file_nlink(metadata) > 1 -> return Err(io.Error.new(.PermissionDenied, "refusing multiply linked source file `{child_relative.display()}`"))
                if ignored_tree_name(name_str) -> next
                if files.len() >= MAX_TREE_FILES -> return Err(io.Error.new(.InvalidData, "package tree contains too many files"))
                &files.push(AuthorityTreeFile{relative: child_relative.to_string_lossy().replace("\\", "/"), file: ^file, metadata: metadata})
            } else -> return Err(io.Error.new(.InvalidInput, "package tree contains a special entry `{child_relative.display()}`"))
        }
    }
    after :: directory.list_names()
    if names != after -> return Err(io.Error.new(.Other, "package source changed while inspecting `{directory.path_value.display()}`"))
}
// Rust: Source/Store.rs:1760
pub fn hash_directory_authority(root: &DirectoryAuthority, reject_hardlinks: Bool) -> String io.Error! {
    files := [AuthorityTreeFile]{}
    collect_authority_tree(&root, OSPath.from(""), &files, 0, reject_hardlinks)
    &files.sort_by((left, right) -> left.relative <=> right.relative)
    hasher := StreamingSha256.new()
    total_bytes := 0
    loop entry in files {
        &hasher.update(entry.relative.bytes())
        &hasher.update([U8]{U8{0}})
        length :: entry.metadata.len()
        if length > MAX_TREE_FILE_BYTES || total_bytes + length > MAX_TREE_TOTAL_BYTES -> return Err(io.Error.new(.InvalidData, "package tree exceeds the hashing size bound"))
        &hasher.update(U64{length}.to_be_bytes())
        file := ^entry.file
        limited := (&file).take(length + 1)
        actual := 0
        buffer := [U8; 65536]{U8{0}}
        loop {
            count :: &limited.read(&buffer)
            if count == 0 -> break
            actual += count
            if actual > length -> return Err(io.Error.new(.InvalidData, "package source file grew while hashing"))
            &hasher.update(buffer[0..<count])
        }
        after :: file.metadata()
        if actual != length || !same_store_file_identity(entry.metadata, after) -> return Err(io.Error.new(.Other, "package source file changed while hashing `{entry.relative}`"))
        total_bytes += length
    }
    digest :: &hasher.finalize()
    hex := ""
    loop byte in digest -> hex += "{byte:02x}"
    Ok("sha256-{hex}")
}
