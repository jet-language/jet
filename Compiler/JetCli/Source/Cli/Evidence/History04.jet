fn dp_link_file(source: &fs.File, destination: &fs.File, child: OsString) -> Bool io.Error! {
    if !descriptor_supported() -> return Err(unsupported_descriptor_error())
    if !descriptor_linux() -> return Ok(false)
    destination_c :: dp_name(child)
    empty :: CString.new("").expect("empty C string")
    if linkat(source.as_raw_fd(), empty.as_ptr(), destination.as_raw_fd(), destination_c.as_ptr(), AT_EMPTY_PATH) == 0 -> return Ok(true)
    error :: io.Error.last_os_error()
    raw :: error.raw_os_error()
    if raw == Val(EXDEV) || raw == Val(EPERM) || raw == Val(EOPNOTSUPP) -> return Ok(false)
    Err(error)
}
