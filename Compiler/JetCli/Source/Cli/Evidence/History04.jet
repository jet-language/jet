fn verify_authority_snapshot_target(authority: &DirectoryAuthority, name: OsString, expected_metadata: fs.Metadata, expected_bytes: [U8]) -> io.Error! {
    file :: authority.open_child(name)
    metadata :: file.metadata()
    validate_authority_file(metadata)
    if !same_store_object_identity(expected_metadata, metadata) -> return Err(io.Error.other("authority target changed while approval was pending"))
    bytes :: read_authority_handle(&file, metadata)
    if bytes != expected_bytes -> return Err(io.Error.other("authority target contents changed while approval was pending"))
}
// Rust: Source/Store.rs:868
fn replace_authority_file_unlocked(authority: &DirectoryAuthority, name: OsString, snapshot: &AuthorityFileSnapshot, replacement: [U8]) -> AuthorityReplaceError! {
    if replacement.len() > MAX_TREE_FILE_BYTES -> return Err(AuthorityReplaceError.not_published(io.Error.new(.InvalidData, "authority replacement exceeds the tree-file size bound")))
    held_metadata :: snapshot.file.metadata() ?? return Err(AuthorityReplaceError.not_published(err))
    if !same_store_object_identity(snapshot.metadata, held_metadata) || held_metadata.len() != snapshot.metadata.len() -> return Err(AuthorityReplaceError.not_published(io.Error.other("authority snapshot changed before approval could be published")))
    authority.revalidate() ?? return Err(AuthorityReplaceError.not_published(err))
    renamed := false
    temp_name := None as OsString?
    failure :: if (() -> io.Error! {
        verify_authority_snapshot_target(&authority, name, snapshot.metadata, snapshot.bytes_value)
        stamp :: (time.SystemTime.now().duration_since(time.UNIX_EPOCH) ?? time.Duration.ZERO).as_nanos()
        pid :: process.id()
        stage := None as fs.File?
        loop attempt in 0..<32 {
            candidate :: OsString.from(".jet-authority-replace-{pid}-{stamp}-{attempt}")
            if authority.create_child_file(candidate) == {
                .Ok(file) -> {
                    temp_name = Val(candidate)
                    stage = Val(^file)
                    break
                }
                .Err(error) -> { if error.kind() != .AlreadyExists -> return Err(error) }
            }
        }
        temporary :: temp_name ?? return Err(io.Error.new(.AlreadyExists, "could not reserve an authority replacement"))
        staged := stage ?? panic("authority replacement stage")
        &staged.write_all(replacement)
        staged.sync_all()
        staged_metadata :: staged.metadata()
        validate_authority_file(staged_metadata)
        drop(^staged)
        verify_authority_snapshot_target(&authority, name, snapshot.metadata, snapshot.bytes_value)
        dp_rename_replace(authority.handle_ref(), temporary, authority.handle_ref(), name)
        renamed = true
        authority.sync_all()
        final_file :: authority.open_child(name)
        final_metadata :: final_file.metadata()
        validate_authority_file(final_metadata)
        if !same_store_object_identity(staged_metadata, final_metadata) -> return Err(io.Error.other("authority replacement target changed after publication"))
        final_bytes :: read_authority_handle(&final_file, final_metadata)
        if final_bytes != replacement -> return Err(io.Error.other("authority replacement contents changed after publication"))
    })() == {
        .Ok(_) -> None
        .Err(error) -> Val(error)
    }
    if !renamed { if temp_name == Val(temporary) -> authority.remove_child_tree(temporary) ?? {} }
    if failure == Val(error) -> return Err(if renamed -> AuthorityReplaceError.published(error) else -> AuthorityReplaceError.not_published(error))
}
// Rust: Source/Store.rs:967
pub fn replace_authority_file(snapshot: &AuthorityFileSnapshot, replacement: [U8]) -> AuthorityReplaceError! {
    authority :: &snapshot.authority
    authority.revalidate() ?? return Err(AuthorityReplaceError.not_published(err))
    authority.lock_exclusive() ?? return Err(AuthorityReplaceError.not_published(err))
    if replace_authority_file_unlocked(&authority, snapshot.name, &snapshot, replacement) == {
        .Ok(_) -> authority.unlock_exclusive() ?? return Err(AuthorityReplaceError.published(err))
        .Err(error) -> {
            authority.unlock_exclusive() ?? {}
            return Err(error)
        }
    }
}
