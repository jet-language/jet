fn dp_open_path(path: OSPath) -> fs.File io.Error! {
    if !descriptor_supported() -> return Err(unsupported_descriptor_error())
    current := dp_open_anchor(path)
    loop component in dp_components(path) -> current = dp_open_at(&current, component, true)
