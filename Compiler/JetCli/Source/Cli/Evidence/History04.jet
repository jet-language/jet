// Rust: Source/Store.rs:1053-1086
// GATE #4483: all target arms use the selected target, never the host.
fn descriptor_linux() -> Bool { target.selected_os() == "linux" || target.selected_os() == "android" }
fn descriptor_supported() -> Bool { descriptor_linux() || target.selected_os() == "macos" || target.selected_os() == "ios" }
O_RDONLY :: 0
O_WRONLY :: 1
O_APPEND :: if descriptor_linux() -> 0o2000 else -> 0x0008
O_CLOEXEC :: if descriptor_linux() -> 0o2000000 else -> 0x01000000
O_DIRECTORY :: if descriptor_linux() -> 0o200000 else -> 0x00100000
O_NOFOLLOW :: if descriptor_linux() -> 0o400000 else -> 0x0100
O_NONBLOCK :: 0o4000
O_CREAT :: 0o100
O_EXCL :: 0o200
AT_REMOVEDIR :: 0x200
LOCK_EX :: 2
LOCK_UN :: 8
AT_EMPTY_PATH :: 0x1000
RENAME_NOREPLACE :: 1
RENAME_EXCL :: 0x0004
// Rust: Source/Store.rs:1089-1123
// GATE #4494: canonical unix_fd owns openat/mkdirat/unlinkat/renameat2/
// renameatx_np/linkat/fcntl/renameat/flock ABI; no Rust callbacks or path fallback.
// Rust: Source/Store.rs:1126
fn dp_name(value: OsString) -> CString io.Error! {
    bytes :: value.as_bytes()
    if bytes.len() == 0 || bytes == ".".bytes() || bytes == "..".bytes() || bytes.contains(U8{47}) -> return Err(io.Error.new(.InvalidInput, "authority child name is not one safe path component"))
    CString.new(bytes) ?? return Err(io.Error.new(.InvalidInput, "authority child name contains NUL"))
}
// Rust: Source/Store.rs:1142
fn dp_open_anchor(path: OSPath) -> fs.File io.Error! {
    anchor :: OSPath.from(if path.is_absolute() -> "/" else -> ".")
    options := fs.OpenOptions.new()
    &options.read(true)
    &options.custom_flags(O_DIRECTORY | O_NOFOLLOW | O_CLOEXEC)
    file :: options.open(anchor)
    if !file.metadata().is_dir() -> return Err(io.Error.other("authority anchor is not a directory"))
    Ok(^file)
}
// Rust: Source/Store.rs:1157
fn dp_components(path: OSPath) -> [OsString] io.Error! {
    out := [OsString]{}
    loop component in path.components() {
        if component == {
            .RootDir -> {}
            .CurDir -> {}
            .Normal(name) -> &out.push(name.to_os_string())
            else -> return Err(io.Error.new(.InvalidInput, "authority path contains unsupported components"))
        }
    }
    if out.len() == 0 && path.as_os_str().is_empty() -> return Err(io.Error.new(.InvalidInput, "authority path is empty"))
    Ok(out)
}
