fn dp_open_at(directory: &fs.File, value: OsString, want_directory: Bool) -> fs.File io.Error! {
    value_c :: dp_name(value)
    flags :: if want_directory -> O_RDONLY | O_DIRECTORY | O_NOFOLLOW | O_CLOEXEC else -> O_RDONLY | O_NOFOLLOW | O_CLOEXEC | O_NONBLOCK
