fn dp_create_private_child(directory: &fs.File, prefix: String) -> OSPath io.Error! {
    if !descriptor_supported() -> return Err(unsupported_descriptor_error())
    stamp :: (time.SystemTime.now().duration_since(time.UNIX_EPOCH) ?? time.Duration.ZERO).as_nanos()
    pid :: process.id()
    loop attempt in 0..<128 {
        candidate :: OsString.from(".jet-{prefix}-{pid}-{stamp}-{attempt}")
        candidate_name :: dp_name(candidate)
        if mkdirat(directory.as_raw_fd(), candidate_name.as_ptr(), 0o700) == 0 {
            directory.sync_all()
            return Ok(OSPath.from(candidate))
        }
        error :: io.Error.last_os_error()
        if error.kind() != .AlreadyExists -> return Err(error)
    }
    Err(io.Error.new(.AlreadyExists, "could not allocate a private authority directory"))
}
