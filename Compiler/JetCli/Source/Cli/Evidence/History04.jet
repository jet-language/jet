// Rust: Source/Store.rs:731
fn validate_authority_file(metadata: fs.Metadata) -> io.Error! {
    if !metadata.is_file() -> return Err(io.Error.new(.InvalidInput, "authority target is not a regular file"))
    if file_nlink(metadata) > 1 -> return Err(io.Error.new(.PermissionDenied, "refusing a multiply linked authority file"))
}
// Rust: Source/Store.rs:747
fn read_authority_handle(file: &fs.File, initial: fs.Metadata) -> [U8] io.Error! {
    if initial.len() > MAX_TREE_FILE_BYTES -> return Err(io.Error.new(.InvalidData, "authority file exceeds the tree-file size bound"))
    bytes := [U8]{}
    limited := file.take(MAX_TREE_FILE_BYTES + 1)
    &limited.read_to_end(&bytes)
    if bytes.len() > MAX_TREE_FILE_BYTES -> return Err(io.Error.new(.InvalidData, "authority file grew beyond the tree-file size bound"))
    observed :: file.metadata()
    validate_authority_file(observed)
    if !same_store_file_identity(initial, observed) || observed.len() != bytes.len() -> return Err(io.Error.other("authority file changed while it was being read"))
    Ok(bytes)
}
// Rust: Source/Store.rs:776
fn authority_path_components(path: OSPath) -> [OsString] io.Error! {
    if path.is_absolute() -> return Err(io.Error.new(.InvalidInput, "authority path must be relative to its retained root"))
    components := [OsString]{}
    loop component in path.components() {
        if component == {
            .CurDir -> {}
            .Normal(name) -> &components.push(name.to_os_string())
            else -> return Err(io.Error.new(.InvalidInput, "authority path contains unsupported components"))
        }
    }
    Ok(components)
}
