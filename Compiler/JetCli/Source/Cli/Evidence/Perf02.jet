        if core.sys.target.selected_family() == "unix" {
            perms := file.metadata().map((metadata) -> metadata.permissions()) ?? return Err("{err}")
            &perms.set_mode(0o600)
            fs.set_permissions(tmp, perms) ?? return Err("{err}")
        }
        &file.write_all(bytes) ?? return Err("cannot write temp trace: {err}")
        &file.sync_all() ?? return Err("cannot durable-write temp trace: {err}")
    }
    fs.rename(tmp, path) ?? {
        _ :: fs.remove_file(tmp)
        return Err("cannot install trace {path.display()}: {err}")
    }
    return
}
