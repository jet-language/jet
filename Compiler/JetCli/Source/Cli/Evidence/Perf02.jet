// Rust: Source/CmdPerf.rs:2700
fn export(args: [String]) -> I32 {
    path := String?{None}
    mode := ExportMode.JSON
    i := 0
    loop i < args.len() {
        arg :: args[i]
        if arg == CLI.MACHINE_OUTPUT_FLAG { mode = ExportMode.JSON; i += 1; next }
        if arg == "--pprof" { mode = ExportMode.Pprof; i += 1; next }
        if arg == "--otel" { mode = ExportMode.Otel; i += 1; next }
        if arg == "--chrome" { mode = ExportMode.Chrome; i += 1; next }
        if arg == "--emit-profile-map" { mode = ExportMode.ProfileMap; i += 1; next }
        if arg.starts_with("-") {
            perf_error_with_fix("unknown `jet perf export` flag `{arg}`", "run `jet perf export <path{ARTIFACT_EXT_TRACE}> [--json|--pprof|--otel|--chrome|--emit-profile-map]")
            return ExitCodes.USAGE
        }
        if path != None { perf_error("`jet perf export` takes one trace path"); return ExitCodes.USAGE }
        path = Val(~arg)
        i += 1
    }
    selected :: path ?? { perf_error("`jet perf export` needs a {ARTIFACT_EXT_TRACE} path"); return ExitCodes.USAGE }
    trace :: read_verified(selected) ?? { perf_error(err); return ExitCodes.USAGE }
    projection :: if mode == {
        .JSON -> export_json_envelope(trace)
        .Pprof -> export_pprof_projection(trace)
        .Otel -> export_otel_projection(trace)
        .Chrome -> export_chrome_projection(trace)
        .ProfileMap -> export_profile_map_projection(trace)
    }
    if mode == ExportMode.JSON -> print_raw(render_perf_json("perf.export", ^projection))
    else -> print_raw(String.from_utf8_lossy(projection.bytes()))
    ExitCodes.OK
}
