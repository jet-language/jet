// Rust: Source/CmdPerf.rs:2384
fn render_perf_json(action: String, value: ^CanonicalJson) -> String { StatusEnvelope.new(action, true).with_field("perf", status_value(value)).json() }
// Rust: Source/CmdPerf.rs:2390
fn status_value(value: CanonicalJson) -> StatusValue {
    if value == {
        .Null -> StatusValue.Null
        .Bool(flag) -> StatusValue.Bool(flag)
        .Integer(text) -> StatusValue.Integer(text.parse() ?? panic("canonical perf integer must fit status integer"))
        .String(text) -> StatusValue.String(~text)
        .Array(values) -> {
            rows := [StatusValue]{}
            loop value in values -> &rows.push(status_value(value))
            StatusValue.array(^rows)
        }
        .Object(values) -> {
            fields := StatusFields.new()
            loop (name, value) in values -> fields = fields.with(name, status_value(value))
            StatusValue.object(^fields)
        }
    }
}
// Rust: Source/CmdPerf.rs:2411
fn view_html(trace: CanonicalJson, frames: FramesMode) -> String {
    id :: trace_id(trace) ?? "unknown"
    flame_rows := [String]{}
    loop line in ascii_flame(trace) -> &flame_rows.push("<li>{html_escape(line)}</li>")
    flame :: flame_rows.join("")
    timeline_rows := [String]{}
    loop line in ascii_timeline(trace) -> &timeline_rows.push("<li>{html_escape(line)}</li>")
    timeline :: timeline_rows.join("")
    frames_label :: if frames == FramesMode.Jet -> "jet" else -> "all"
    """<!doctype html>
<html lang="en"><head><meta charset="utf-8"><title>jettrace {id}</title>
<style>
body{{font:14px/1.4 ui-monospace,monospace;margin:1.5rem;background:#111;color:#eee}}
h1,h2{{font-weight:600}}
.bar{{display:inline-block;height:10px;background:#6cf;margin-left:.5rem}}
section{{margin:1rem 0}}
</style></head><body>
<h1>jettrace {id}</h1>
<p>schema {TRACE_SCHEMA} v{TRACE_VERSION} · frames={frames_label}</p>
<section><h2>flamegraph</h2><ul id="flame">{flame}</ul></section>
<section><h2>timeline</h2><ul id="timeline">{timeline}</ul></section>
<script>
const flame=document.getElementById('flame');
for (const li of flame.querySelectorAll('li')) {{
  const m=li.textContent.match(/#+/);
  if(!m) continue;
  const bar=document.createElement('span');
  bar.className='bar';
  bar.style.width=(m[0].length*4)+'px';
  li.appendChild(bar);
}}
</script>
</body></html>
"""
}
