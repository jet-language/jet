// Rust: Source/CmdPerf.rs:3641
fn native_summary(trace: CanonicalJson) -> String? {
    fields :: if content_array(trace, "native")?.first() == .Val(.Object(fields)) -> fields else -> { return None }
    status :: fields.get("status").and_then(chrome_string) ?? return None
    target :: fields.get("target").and_then(chrome_string) ?? return None
    symbol :: fields.get("symbol").and_then(symbol_label) ?? "?"
    if status == {
        "captured" -> {
            duration :: if fields.get("duration_ns") == .Val(.Integer(value)) -> value else -> { return None }
            observed :: if fields.get("observed_at_ns") == .Val(.Integer(value)) -> value else -> { return None }
            task :: if fields.get("task_id") == .Val(.Integer(value)) -> value else -> { return None }
            Val("native process_cpu={duration}ns observed_at={observed}ns target={target} task={task} · {symbol}")
        }
        "unavailable" -> {
            reason :: fields.get("reason").and_then(chrome_string) ?? return None
            Val("native unavailable target={target} reason={reason} · {symbol}")
        }
        else -> None
    }
}
// Rust: Source/CmdPerf.rs:3689
fn span_summary(trace: CanonicalJson) -> String? {
    items :: content_array(trace, "spans") ?? return None
    first :: if items.first() == .Val(.Object(fields)) -> fields else -> { return None }
    status :: first.get("status").and_then(chrome_string) ?? return None
    symbol :: first.get("symbol").and_then(symbol_label) ?? "?"
    if status == "unavailable" {
        reason :: first.get("reason").and_then(chrome_string) ?? return None
        return Val("spans unavailable reason={reason} · {symbol}")
    }
    if status != "captured" -> return None
    start := U64.MAX
    end := U64{0}
    children := 0
    loop item in items {
        fields :: if item == .Object(fields) -> fields else -> { return None }
        item_start :: if fields.get("start_ns") == .Val(.Integer(value)) -> value else -> { return None }
        item_end :: if fields.get("end_ns") == .Val(.Integer(value)) -> value else -> { return None }
        start = start.min(item_start.parse().ok()?)
        end = end.max(item_end.parse().ok()?)
        if fields.get("parent_task_id") != Val(CanonicalJson.Null) -> children += 1
    }
    Val("spans count={items.len()} children={children} window={start}..{end}ns · {symbol}")
}
// Rust: Source/CmdPerf.rs:3737
fn symbol_label(value: CanonicalJson) -> String? {
    fields :: if value == .Object(fields) -> fields else -> { return None }
    path :: fields.get("path").and_then(chrome_string) ?? return None
    name :: fields.get("name").and_then(chrome_string) ?? return None
    Val("{path}#{name}")
}

