// Rust: Source/CmdPerf.rs:2191
fn render_view_text(trace: CanonicalJson, frames: FramesMode, color: Bool) -> {
    id :: trace_id(trace) ?? "unknown"
    command :: content_command(trace) ?? "unknown"
    bold :: if color -> "\u{1b}[1m" else -> ""
    reset :: if color -> "\u{1b}[0m" else -> ""
    print("{bold}schema{reset} {TRACE_SCHEMA} v{TRACE_VERSION}")
    print("{bold}trace{reset} {id}")
    print("{bold}command{reset} {command}")
    label :: if frames == FramesMode.Jet -> "jet" else -> "all"
    print("{bold}frames{reset} {label}")
    if first_sample(trace) == .Val((domain, ns, symbol)) -> print("sample {domain} {ns}ns · {symbol}")
    if profile_summary(trace) == .Val(summary) -> print(summary)
    if first_allocation(trace) == .Val((count, bytes, symbol)) -> print("alloc count={count} bytes={bytes} · {symbol}")
    if browser_summary(trace) == .Val((n, symbol)) -> print("browser count={n} · {symbol}")
    if task_summary(trace) == .Val((n, child_n, symbol)) -> print("tasks count={n} children={child_n} · {symbol}")
    if lock_summary(trace) == .Val((n, waiters, symbol)) -> print("locks count={n} waiters={waiters} · {symbol}")
    if io_summary(trace) == .Val((n, symbol)) -> print("io count={n} · {symbol}")
    if native_summary(trace) == .Val(summary) -> print(summary)
    if span_summary(trace) == .Val(summary) -> print(summary)
    if frames_show_generated(frames) -> print("generated-frames: none retained in .jettrace (hidden unless captured under --frames=all)")
    flame :: ascii_flame(trace)
    if !flame.is_empty() { print("{bold}flamegraph{reset}"); loop line in flame -> print(line) }
    timeline :: ascii_timeline(trace)
    if !timeline.is_empty() { print("{bold}timeline{reset}"); loop line in timeline -> print(line) }
}
// Rust: Source/CmdPerf.rs:2252
fn frames_show_generated(frames: FramesMode) -> Bool { frames == FramesMode.All }
// Rust: Source/CmdPerf.rs:2256
fn ascii_flame(trace: CanonicalJson) -> [String] {
    rows := [String]{}
    if first_sample(trace) == .Val((domain, ns, symbol)) {
        width :: Int{(U64.parse(ns) ?? 1).min(40)}.max(1)
        &rows.push("{symbol} {domain} {\"#\".repeat(width)}")
    }
    if content_object(trace).and_then((content) -> content.get("profile")) == .Val(.Object(profile)) {
        if profile.get("rows") == .Val(.Array(values)) {
            loop row in values.iter().take(8) {
                fields :: if row == .Object(fields) -> fields else -> { next }
                symbol :: fields.get("symbol").and_then(symbol_label) ?? { next }
                clock :: if fields.get("clock") == .Val(.String(value)) -> value else -> { next }
                weight :: if fields.get("sample_weight") == .Val(.Integer(value)) -> value else -> { next }
                &rows.push("{symbol} profile:{clock} samples={weight}")
            }
        }
    }
    if browser_summary(trace) == .Val((n, symbol)) -> &rows.push("{symbol} browser {\"#\".repeat(n.min(40).max(1))}")
    rows
}
// Rust: Source/CmdPerf.rs:2292
fn ascii_timeline(trace: CanonicalJson) -> [String] {
    rows := [String]{}
    if content_array(trace, "browser") == .Val(items) {
        loop item in items.iter().take(8) {
            fields :: if item == .Object(fields) -> fields else -> { next }
            start :: if fields.get("start_ns") == .Val(.Integer(value)) -> value else -> { next }
            duration :: if fields.get("duration_ns") == .Val(.Integer(value)) -> value else -> { next }
            name :: fields.get("symbol").and_then(symbol_label) ?? "browser"
            &rows.push("[{start}+{duration}] {name}")
        }
    }
    if content_array(trace, "spans") == .Val(items) {
        loop item in items.iter().take(8) {
            fields :: if item == .Object(fields) -> fields else -> { next }
            if fields.get("status") != Val(CanonicalJson.String("captured")) -> next
            start :: if fields.get("start_ns") == .Val(.Integer(value)) -> value else -> { next }
            end :: if fields.get("end_ns") == .Val(.Integer(value)) -> value else -> { next }
            name :: fields.get("symbol").and_then(symbol_label) ?? "span"
            &rows.push("[{start}..{end}] {name}")
        }
    }
    rows
}
