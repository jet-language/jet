// Rust: Source/CmdPerf.rs:1805
fn split_json_objects(inner: String, limit: Int) -> (objects: [String], truncated: Bool) {
    out := [String]{}
    bytes :: inner.as_bytes()
    i := 0
    loop i < bytes.len() {
        loop i < bytes.len() && (bytes[i] == 44 || bytes[i].is_ascii_whitespace()) -> i += 1
        if i >= bytes.len() -> break
        if out.len() == limit -> return (objects: ^out, truncated: true)
        if bytes[i] != 123 -> break
        start :: i
        depth := 0
        loop i < bytes.len() {
            if bytes[i] == {
                123 -> depth += 1
                125 -> {
                    depth -= 1
                    if depth == 0 {
                        &out.push(inner.get(start..<i + 1) ?? panic("JSON UTF-8 byte boundary")) // #4303
                        i += 1
                        break
                    }
                }
                34 -> {
                    i += 1
                    loop i < bytes.len() {
                        if bytes[i] == 92 { i += 2; next }
                        if bytes[i] == 34 -> break
                        i += 1
                    }
                }
                else -> {}
            }
            i += 1
        }
    }
    (objects: ^out, truncated: false)
}
// Rust: Source/CmdPerf.rs:1856
fn json_string(object: String, key: String) -> String? {
    tail :: object.split_once("\"{key}\":\"")?.1
    out := String.new()
    chars := tail.chars()
    loop chars.next() == .Val(ch) {
        if ch == {
            '\\' -> {
                escaped :: chars.next() ?? return None
                mapped :: if escaped == { '"' -> '"'; '\\' -> '\\'; 'n' -> '\n'; 'r' -> '\r'; 't' -> '\t'; else -> escaped }
                &out.push(mapped)
            }
            '"' -> { return Val(^out) }
            else -> &out.push(ch)
        }
    }
    None
}

// Rust: Source/CmdPerf.rs:1878
struct PolledSnapshot { process_id: U32, process_cpu_ns: U64?, tasks: ObservedTasks, text: String }
// Rust: Source/CmdPerf.rs:1885
fn poll_observe_snapshot(root_pid: U32) -> PolledSnapshot? {
    stack := [U32]{root_pid}
    seen := [U32:Bool]{}
    best := PolledSnapshot?{None}
    best_score := U64{0}
    loop stack.pop() == .Val(pid) {
        if seen.has_key(pid) -> next
        seen[pid] = true
        if DevServer.LiveInspect.read(pid) == .Ok(snapshot) {
            resources :: observe_arena_resources(snapshot)
            tasks :: observe_tasks(snapshot, pid)
            locks :: observe_locks(snapshot)
            io :: observe_io(tasks.rows)
            child_tasks := U64{0}
            loop task in tasks.rows { if task.parent > 0 -> child_tasks += 1 }
            contended :: U64{locks.len()}
            io_n :: U64{io.len()}
            score :: U64{if resources.0 > 0 || resources.1 > 0 -> 100 else -> 0} + child_tasks.saturating_mul(10) + contended.saturating_mul(20) + io_n.saturating_mul(20) + U64{tasks.rows.len()}
            if score > best_score {
                best_score = score
                best = Val(PolledSnapshot{process_id: pid, process_cpu_ns: process_times(pid).map((times) -> times.1), tasks: ^tasks, text: ~snapshot})
            }
            if (resources.0 > 0 || resources.1 > 0) && child_tasks > 0 && contended > 0 && io_n > 0 -> return ^best
        }
        &stack.extend(process_children(pid))
    }
    best
}
// Rust: Source/CmdPerf.rs:1929
fn child_exited(child: &Child) -> Bool IOError! {
    // GATE #4494 / #4483: non-reaping Linux/Android zombie observation.
    if selected_os() == "linux" || selected_os() == "android" {
        if fs.read_to_string("/proc/{child.id()}/stat") == .Ok(stat) -> return Ok(stat.rsplit_once(") ").map((pair) -> pair.1.starts_with('Z') || pair.1.starts_with('X')) ?? false)
    }
    status :: &child.try_wait()
    Ok(status != None)
}
// Rust: Source/CmdPerf.rs:1939
fn process_children(pid: U32) -> [U32] {
    if selected_os() != "linux" && selected_os() != "android" -> return []
    kids := [U32:Bool]{}
    children_readable := false
    if fs.read_dir("/proc/{pid}/task") == .Ok(entries) {
        loop entry in entries.flatten() {
            if fs.read_to_string(entry.path().join("children")) == .Ok(text) {
                children_readable = true
                loop value in text.split_whitespace() {
                    if U32.parse(value) == .Ok(child) -> kids[child] = true
                }
            }
        }
    }
    if !children_readable {
        entries :: fs.read_dir("/proc") ?? return []
        loop entry in entries.flatten() {
            child :: entry.file_name().to_str().and_then((s) -> U32.parse(s).ok()) ?? { next }
            stat :: fs.read_to_string("/proc/{child}/stat") ?? { next }
            fields :: stat.rsplit_once(") ").map((pair) -> pair.1) ?? { next }
            parts := fields.split_whitespace()
            _ :: parts.next()
            ppid :: parts.next().and_then((value) -> U32.parse(value).ok()) ?? { next }
            if ppid == pid -> kids[child] = true
        }
    }
    result := kids.keys().to_list()
    &result.sort()
    result
}
