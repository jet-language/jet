fn html_escape(text: String) -> String { text.replace("&", "&amp;").replace("<", "&lt;").replace(">", "&gt;").replace("\"", "&quot;") }

// Rust: Source/CmdPerf.rs:2463
fn compare(args: [String]) -> I32 {
    paths := [String]{}
    override_identity := false
    baseline_name := String?{None}
    i := 0
    loop i < args.len() {
        arg :: args[i]
        if arg == "--override-identity" { override_identity = true; i += 1; next }
        if arg.strip_prefix("--baseline=") == .Val(value) { baseline_name = Val(~value); i += 1; next }
        if arg == "--baseline" {
            value :: args.get(i + 1) ?? { perf_error("`--baseline` needs a pinned baseline name"); return ExitCodes.USAGE }
            baseline_name = Val(~value)
            i += 2
            next
        }
        if arg.starts_with("-") {
            perf_error_with_fix("unknown `jet perf compare` flag `{arg}`", "run `jet perf compare base{ARTIFACT_EXT_TRACE} head{ARTIFACT_EXT_TRACE} [--baseline <name>] [--override-identity]")
            return ExitCodes.USAGE
        }
        &paths.push(~arg)
        i += 1
    }
    if paths.len() != 2 {
        perf_error_with_fix("`jet perf compare` needs two {ARTIFACT_EXT_TRACE} paths", "run `jet perf compare base{ARTIFACT_EXT_TRACE} head{ARTIFACT_EXT_TRACE} [--baseline <name>] [--override-identity]")
        return ExitCodes.USAGE
    }
    base :: read_verified(paths[0]) ?? { perf_error("base trace: {err}"); return ExitCodes.USAGE }
    head :: read_verified(paths[1]) ?? { perf_error("head trace: {err}"); return ExitCodes.USAGE }
    base_tool :: toolchain_digest(base)
    head_tool :: toolchain_digest(head)
    identity_mismatch :: base_tool != head_tool || hardware_fingerprint(base) != hardware_fingerprint(head)
    if identity_mismatch && !override_identity {
        if base_tool != head_tool -> emit_cli_report("E2102", "toolchain identity mismatch between traces", "compare requires matching toolchain digests (D-PERFSESSION1)", "recapture both traces on the same machine/toolchain, or pass `--override-identity`", false)
        else -> emit_cli_report("E2102", "hardware identity mismatch between traces", "compare requires matching hardware fingerprints (D-PERFSESSION1)", "recapture both traces on the same machine/toolchain, or pass `--override-identity`", false)
        return ExitCodes.USER_ERROR
    }
    if baseline_name == .Val(name) {
        require_pinned_baseline(name) ?? {
            emit_cli_report("E2102", err, "`--baseline` selects a D-PERFBUDGET-BASELINE1 pinned name", "create the baseline with `jet budget update --baseline {name}`, or omit `--baseline`", false)
            return ExitCodes.USER_ERROR
        }
    }
    deltas :: compare_domain_deltas(base, head)
    receipt_deltas :: compare_receipt_sections(base, head) ?? { perf_error("receipt sections: {err}"); return ExitCodes.USAGE }
    budget_line :: budget_compare_line(base, head, baseline_name)
    override_note :: if identity_mismatch && override_identity -> " · identity override" else -> ""
    baseline_note :: if baseline_name == .Val(name) -> " · baseline {name}" else -> ""
    print("compare ok · schema {TRACE_SCHEMA} v{TRACE_VERSION} · base {trace_id(base) ?? \"unknown\"} · head {trace_id(head) ?? \"unknown\"}{override_note}{baseline_note}")
    if !deltas.is_empty() -> print("deltas: {deltas.join(\" · \")}")
    if !receipt_deltas.is_empty() -> print("receipt deltas: {receipt_deltas.join(\" · \")}")
    print(budget_line)
    ExitCodes.OK
}
// Rust: Source/CmdPerf.rs:2590
fn require_pinned_baseline(name: String) -[FS.Read, Env]> Err! {
    invalid := name.is_empty() || name.contains(".") || name.contains("\\") || name.starts_with("/")
    loop part in name.split("/") { if part.is_empty() || part == "." || part == ".." -> invalid = true }
    loop byte in name.bytes() { if !byte.is_ascii_lowercase() && !byte.is_ascii_digit() && byte != 45 && byte != 47 -> invalid = true }
    if invalid -> return Err("baseline name `{name}` is not a pinned BaselineName")
    cwd :: env.current_dir() ?? return Err("cannot resolve cwd: {err}") // GATE #4494
    root :: jet.Loader.selected_project_root(cwd) ?? cwd
    path :: root.join(".jet").join("perf").join("baselines").join("names").join("{name}.json")
    if !path.is_file() -> return Err("pinned baseline `{name}` is missing at {path.display()}")
    return
}
// Rust: Source/CmdPerf.rs:2623
fn hardware_fingerprint(trace: CanonicalJson) -> String? {
    hardware :: content_object(trace)?.get("hardware") ?? return None
    if hardware == .Object(fields) {
        if fields.get("fingerprint") == .Val(.String(text)) -> return Val(~text)
    }
    None
}
// Rust: Source/CmdPerf.rs:2635
fn compare_domain_deltas(base: CanonicalJson, head: CanonicalJson) -> [String] {
    out := [String]{}
    loop domain in [String]{"wall", "cpu"} {
        if sample_duration(base, domain) == .Val(b) {
            if sample_duration(head, domain) == .Val(h) -> &out.push("{domain} {b}->{h} ns")
        }
