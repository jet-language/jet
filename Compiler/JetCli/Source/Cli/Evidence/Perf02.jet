    CanonicalJson.object([("flamegraph", CanonicalJson.Array(^flame)), ("frames", CanonicalJson.String(if frames == FramesMode.Jet -> "jet" else -> "all")), ("kind", CanonicalJson.String("jet.trace.view")), ("schema", CanonicalJson.String(TRACE_SCHEMA)), ("timeline", CanonicalJson.Array(^timeline)), ("trace", ~trace), ("version", CanonicalJson.Integer("{TRACE_VERSION}"))]) ?? panic("view json keys are unique")
