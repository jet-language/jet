fn lock_summary(trace: CanonicalJson) -> (Int, U64, String)? {
    items :: content_array(trace, "locks") ?? return None
    if items.is_empty() -> return None
    waiters := U64{0}
    symbol := String?{None}
    loop item in items {
        fields :: if item == .Object(fields) -> fields else -> { next }
        if fields.get("send_waiters") == .Val(.Integer(send)) -> waiters = waiters.saturating_add(send.parse() ?? 0)
        if fields.get("recv_waiters") == .Val(.Integer(recv)) -> waiters = waiters.saturating_add(recv.parse() ?? 0)
        if symbol == None {
            if fields.get("symbol") == .Val(value) -> symbol = symbol_label(value)
        }
    }
    Val((items.len(), waiters, symbol ?? "?"))
}
