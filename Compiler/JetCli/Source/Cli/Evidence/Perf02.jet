fn json_u64(object: String, key: String) -> U64? {
    tail :: object.split_once("\"{key}\":")?.1
    digits :: String.from_iter(tail.chars().take_while((ch) -> ch.is_ascii_digit()))
    U64.parse(digits).ok()
}
// Rust: Source/CmdPerf.rs:1999
fn process_times(pid: U32) -> (U64, U64)? {
    if selected_os() != "linux" && selected_os() != "android" -> return None
    rate :: proc_clock_ticks_per_second() ?? return None
    uptime :: fs.read_to_string("/proc/uptime").ok() ?? return None
    now_ticks :: uptime_ticks(uptime, rate) ?? return None
    stat :: fs.read_to_string("/proc/{pid}/stat").ok() ?? return None
    fields :: stat.rsplit_once(") ")?.1.split_whitespace().to_list()
    utime :: U64.parse(fields.get(11)?).ok() ?? return None
    stime :: U64.parse(fields.get(12)?).ok() ?? return None
    starttime :: U64.parse(fields.get(19)?).ok() ?? return None
    wall :: ticks_to_ns(now_ticks.checked_sub(starttime) ?? return None, rate) ?? return None
    cpu :: ticks_to_ns(utime.checked_add(stime) ?? return None, rate) ?? return None
    Val((wall, cpu))
}
// Rust: Source/CmdPerf.rs:2022
fn proc_clock_ticks_per_second() -> U64? {
    auxv :: fs.read("/proc/self/auxv").ok() ?? return None
    clock_ticks_per_second_from_auxv(auxv)
}
// Rust: Source/CmdPerf.rs:2027
fn clock_ticks_per_second_from_auxv(auxv: [U8]) -> U64? {
    // Rust: Source/CmdPerf.rs:2028
    const AT_CLKTCK: U64 = 17
    width :: selected_pointer_width() /% 8 // GATE #4483
    loop pair in auxv.chunks_exact(width * 2) {
        tag :: native_word(pair[0..<width]) ?? return None
        if tag == 0 -> break
        if tag == AT_CLKTCK {
            ticks :: native_word(pair[width..<width * 2]) ?? return None
            return if ticks == 0 -> None else -> Val(ticks)
        }
    }
    None
}
// Rust: Source/CmdPerf.rs:2045
fn native_word(bytes: [U8]) -> U64? {
    width :: selected_pointer_width() /% 8 // GATE #4483
    if bytes.len() != width -> return None
    // Rust usize::from_ne_bytes, checked into u64; target endian, never host endian.
    word := U128{0}
    little :: selected_endianness() == "little"
    loop index in 0..<width {
        at :: if little -> width - index - 1 else -> index
        word = word.checked_mul(256)?.checked_add(U128{bytes[at]}) ?? return None
    }
    U64.try_from(word).ok()
}
// Rust: Source/CmdPerf.rs:2050
fn uptime_ticks(uptime: String, rate: U64) -> U64? {
    if rate == 0 -> return None
    value :: uptime.split_whitespace().next() ?? return None
    pair :: value.split_once(".") ?? (value, "")
    seconds :: U128.parse(pair.0).ok() ?? return None
    ticks := seconds.checked_mul(U128{rate}) ?? return None
    if !pair.1.is_empty() {
        scale :: U128{10}.checked_pow(U32{pair.1.bytes().len()}) ?? return None
        fraction :: U128.parse(pair.1).ok() ?? return None
        ticks = ticks.checked_add(fraction.checked_mul(U128{rate})?.checked_div(scale) ?? return None) ?? return None
    }
    U64.try_from(ticks).ok()
}
// Rust: Source/CmdPerf.rs:2070
fn ticks_to_ns(ticks: U64, rate: U64) -> U64? {
    if rate == 0 -> return None
    nanos :: U128{ticks}.checked_mul(1_000_000_000)?.checked_div(U128{rate}) ?? return None
    U64.try_from(nanos).ok()
}

// Rust: Source/CmdPerf.rs:2080
fn view(args: [String]) -> I32 {
    path := String?{None}
    mode := ViewMode.Text
    frames := FramesMode.Jet
    i := 0
    loop i < args.len() {
        arg :: args[i]
        if arg == CLI.MACHINE_OUTPUT_FLAG { mode = ViewMode.JSON; i += 1; next }
        if arg == "--html" { mode = ViewMode.HTML; i += 1; next }
        if arg.strip_prefix("--frames=") == .Val(value) {
            if value == "jet" -> frames = FramesMode.Jet
            else { if value == "all" -> frames = FramesMode.All else { perf_error("`--frames` accepts only `jet` or `all`"); return ExitCodes.USAGE } }
            i += 1
            next
        }
        if arg == "--frames" {
            value :: args.get(i + 1) ?? { perf_error("`--frames` needs `jet` or `all`"); return ExitCodes.USAGE }
            if value == "jet" -> frames = FramesMode.Jet
            else { if value == "all" -> frames = FramesMode.All else { perf_error("`--frames` accepts only `jet` or `all`"); return ExitCodes.USAGE } }
            i += 2
            next
        }
        if arg.starts_with("-") {
            perf_error_with_fix("unknown `jet perf view` flag `{arg}`", "run `jet perf view <path{ARTIFACT_EXT_TRACE}> [--json|--html] [--frames=jet|all]`")
            return ExitCodes.USAGE
        }
        if path != None { perf_error("`jet perf view` takes one trace path"); return ExitCodes.USAGE }
        path = Val(~arg)
        i += 1
    }
    selected :: path ?? { perf_error("`jet perf view` needs a {ARTIFACT_EXT_TRACE} path"); return ExitCodes.USAGE }
    trace :: read_verified(selected) ?? { perf_error(err); return ExitCodes.USAGE }
    if mode == {
        .Text -> render_view_text(trace, frames, use_color())
        .JSON -> print_raw(render_perf_json("perf.view", view_json(trace, frames)))
        .HTML -> print_raw(view_html(trace, frames))
    }
    ExitCodes.OK
}
