// Authenticated invocation receipts (Source/ReceiptStore.rs RE01).
// Paths use Core Path; native byte-path transport belongs to the store host.
use core.files.path as receipt_paths

// Rust constants (ReceiptStore.rs:72-101). Section constants live in ReceiptSections.
pub JET_CLI_RECEIPT_LINK_WIRE_MAGIC :: [U8]{U8{106}, U8{101}, U8{116}, U8{45}, U8{114}, U8{101}, U8{99}, U8{101}, U8{105}, U8{112}, U8{116}, U8{45}, U8{108}, U8{105}, U8{110}, U8{107}, U8{115}, U8{45}, U8{118}, U8{49}, U8{0}}
pub JET_CLI_RECEIPT_LINK_VERSION :: 1
pub JET_CLI_MAX_RECEIPT_LINKS :: 100000
pub JET_CLI_RECEIPT_MAGIC :: [U8]{U8{106}, U8{101}, U8{116}, U8{45}, U8{114}, U8{101}, U8{99}, U8{101}, U8{105}, U8{112}, U8{116}, U8{45}, U8{118}, U8{50}, U8{0}}
pub JET_CLI_RECEIPT_DIGEST_LEN :: 64
pub JET_CLI_RECEIPT_MAX_FIELD :: 67108864
pub JET_CLI_MAX_RECEIPT_BYTES :: 138412032
pub JET_CLI_RECEIPT_SECTION_DIR :: "sections"
pub JET_CLI_RECEIPT_SECTION_STAGE_DIR :: "staged"
pub JET_CLI_RECEIPT_RECORD_CLAIM_ENV :: "JET_RECEIPT_RECORD_CLAIM"
pub JET_CLI_RECEIPT_RECORD_ENGINE :: "jet-receipt-v2"
pub JET_CLI_RECEIPT_DIR_ENV :: "JET_RECEIPT_DIR"
pub JET_CLI_RECEIPT_CLAIM_ENV :: "JET_RECEIPT_CLAIM"
pub JET_CLI_RECEIPT_DIGEST_ENV :: "JET_RECEIPT_DIGEST"
pub JET_CLI_RECEIPT_CAPTURE_TRUNCATION_MARKER :: [U8]{U8{10}, U8{60}, U8{111}, U8{117}, U8{116}, U8{112}, U8{117}, U8{116}, U8{32}, U8{116}, U8{114}, U8{117}, U8{110}, U8{99}, U8{97}, U8{116}, U8{101}, U8{100}, U8{62}, U8{10}}
pub JET_CLI_RECEIPT_SECRET_NAME_PARTS :: [String]{"secret", "token", "password", "passwd", "credential", "key"}
