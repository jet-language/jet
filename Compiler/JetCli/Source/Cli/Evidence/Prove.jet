// Rust: Source/CmdProve.rs:435
fn save_replay_command(identity: &ProveReplay.ReplayIdentity, raw: String) -> (String, OSPath, UInt64) (String, String)! {
    project_root :: build_project_root(identity.entry).map_err(diagnostics -> ("E3622", "could not resolve replay project root: {diagnostics:?}"))?
    index := load_record_index(project_root).map_err(error -> ("E3622", error))?
    entry :: resolve_indexed_replay(index, raw).map_err(error -> ("E3621", error))?.ok_or_else(() -> ("E3621", "replay `{raw}` is not an indexed replay artifact"))?
    record_identity :: identity.record_identity().map_err(error -> ("E3621", error))?
    if entry.identity != record_identity { return Err(("E3621", "replay `{entry.artifact_id}` belongs to a different target identity")) }
    validate_artifact_id(entry.artifact_id).map_err(error -> ("E3621", error))?
    source_path :: project_root.join(entry.path)
    source_text :: source_path.to_string_lossy().to_string()
    prepared :: if entry.saved { ProveReplay.prepare_saved_replay(identity, source_path) } else { ProveReplay.prepare_replay(identity, source_text) }
    _ :: prepared?
    // GATE #4494: native byte publication/verification.
    source_bytes :: fs.read(source_path).map_err(error -> ("E3622", "could not read indexed replay `{source_path.display()}` for saving: {error}"))?
    actual_id :: replay_artifact_id(source_bytes).map_err(error -> ("E3622", error))?
    if actual_id != entry.artifact_id { return Err(("E3621", "indexed replay id `{entry.artifact_id}` does not match its authoritative bytes")) }
    source_size :: UInt64.try_from(source_bytes.len()).map_err(_ -> ("E3622", "replay artifact is too large"))?
    if source_size != entry.size { return Err(("E3621", "indexed replay `{entry.artifact_id}` records {entry.size} bytes but contains {source_size}")) }
    destination_relative :: saved_replay_relative_path(entry.artifact_id)
    destination :: project_root.join(destination_relative)
    source_hash :: SHA256.sha256_hex(source_bytes)
    _ :: write_authoritative_bytes(destination, source_bytes, "saved replay").map_err(error -> ("E3623", "could not publish saved replay `{entry.artifact_id}`: {error}"))?
    saved_bytes :: fs.read(destination).map_err(error -> ("E3623", "could not verify saved replay `{entry.artifact_id}`: {error}"))?
    saved_size :: UInt64.try_from(saved_bytes.len()).map_err(_ -> ("E3623", "saved replay is too large"))?
    if saved_size != source_size || SHA256.sha256_hex(saved_bytes) != source_hash { return Err(("E3623", "saved replay `{entry.artifact_id}` failed byte and size verification")) }
    saved :: index.save_replay_and_store(entry.artifact_id, record_identity, destination_relative, saved_size).map_err(error -> ("E3621", error))?
    Ok((saved.artifact_id, saved.path, saved.size))
}
// Rust: Source/CmdProve.rs:542
fn ordinary_replay_for_id(project_root: &OSPath, id: String) -> (OSPath, UInt64)? Err! {
    directory :: project_root.join(".jet/replays")
    // GATE #4494 / #4409: directory reads with exact NotFound distinction.
    entries :: if fs.read_dir(directory) == {
        Ok(entries) -> entries
        Err(error) if error.kind() == std.io.ErrorKind.NotFound -> return Ok(None)
        Err(error) -> return Err("could not inspect replay directory: {error}")
    }
    candidates := [(OSPath, UInt64)]{}
    loop item in entries {
        item :: item.map_err(error -> error.to_string())?
        path :: item.path()
        metadata :: item.metadata().map_err(error -> "could not inspect replay candidate: {error}")?
        if item.file_type().map_err(error -> error.to_string())?.is_symlink() || !metadata.is_file()
            || path.extension().and_then(extension -> extension.to_str()) != Val("jetproof-replay") { next }
        bytes :: fs.read(path).map_err(error -> error.to_string())?
        if replay_artifact_id(bytes).ok() == Val(id) {
            relative :: path.strip_prefix(project_root).map_err(_ -> "replay artifact escaped its project root")?.to_path_buf()
            candidates.push((relative, UInt64.try_from(bytes.len()).map_err(_ -> "replay artifact is too large")?))
        }
    }
    candidates.sort_by(left, right -> left.0.cmp(right.0))
    Ok(candidates.into_iter().next())
}
// Rust: Source/CmdProve.rs:585
fn unsave_replay_command(id: String, identity: &ProveReplay.ReplayIdentity) -> Unit (String, String)! {
    validate_artifact_id(id).map_err(error -> ("E3621", error))?
    project_root :: build_project_root(identity.entry).map_err(diagnostics -> ("E3622", "could not resolve replay project root: {diagnostics:?}"))?
    record_identity :: identity.record_identity().map_err(error -> ("E3621", error))?
    index := load_record_index(project_root).map_err(error -> ("E3622", error))?
    entry :: index.find(RecordKind.Replay, id, true).ok_or_else(() -> ("E3623", "saved replay `{id}` is not indexed"))?
    if entry.identity != record_identity { return Err(("E3621", "replay `{id}` belongs to a different target identity")) }
    expected_relative :: saved_replay_relative_path(id)
    if !entry.saved || entry.path != expected_relative { return Err(("E3623", "replay `{id}` is not an exact saved replay claim")) }
    expected_path :: project_root.join(expected_relative)
    tombstone := OSPath?{None}
    // GATE #4494 / #4409: stage removal and rollback on index mutation failure.
    if fs.symlink_metadata(expected_path) == {
        Ok(metadata) -> {
            if metadata.file_type().is_symlink() || !metadata.is_file() { return Err(("E3623", "saved replay `{id}` is not a regular file")) }
            temporary :: expected_path.with_extension("unsave.tmp.{process.id()}")
            fs.rename(expected_path, temporary).map_err(error -> ("E3623", "could not stage saved replay `{id}` for removal: {error}"))?
            tombstone = Val(temporary)
        }
        Err(error) if error.kind() == std.io.ErrorKind.NotFound -> {}
        Err(error) -> return Err(("E3623", "could not inspect saved replay `{id}`: {error}"))
    }
    restored :: ordinary_replay_for_id(project_root, id).map_err(error -> ("E3622", error))?
    mutation :: if restored == {
        Val((path, size)) -> {
            ordinary := entry.clone()
            ordinary.path = path
            ordinary.size = size
            ordinary.saved = false
            index.replace_and_store(ordinary)
        }
        None -> index.remove_replay_and_store(id).map(_ -> ())
    }
    if mutation == {
        Err(error) -> { if tombstone == { Val(path) -> { _ :: fs.rename(path, expected_path) }; None -> {} }; return Err(("E3623", error)) }
        Ok(_) -> {}
    }
    if tombstone == {
        Val(path) -> fs.remove_file(path).map_err(error -> ("E3623", "saved replay `{id}` was unpublished but cleanup failed: {error}"))?
        None -> {}
    }
    Ok(())
}
