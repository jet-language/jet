// Rust: Source/CmdProve.rs:741
fn parse_history_artifact_detail(detail: String) -> String? {
    detail.lines().find_map(line -> {
        trimmed := line.trim() // #4303
        artifact :: trimmed.strip_prefix(HISTORY_ARTIFACT_PREFIX)?
        fields :: if parse_json(artifact).ok()? == { .Object(fields) -> fields; _ -> return None }
        schema :: fields.iter().find_map(pair -> if pair.0 == "schema" { pair.1.as_str().ok() } else { None })
        version :: fields.iter().find_map(pair -> if pair.0 == "version" { Val(pair.1) } else { None })
        if schema != Val("jet.testing.history") || version != Val(DataTree.Int(1)) { return None }
        Val(artifact.to_string())
    })
}
// Rust: Source/CmdProve.rs:760
fn clear_history_artifact(target: &Target, member: &Member) -> Unit Err! {
    path :: history_artifact_path(target, member)
    // GATE #4494 / #4409: native no-follow file removal.
    if fs.symlink_metadata(path) == {
        Ok(metadata) if metadata.file_type().is_symlink() || !metadata.is_file() -> return Err("history artifact path is not a regular file: {path.display()}")
        Ok(_) -> {}
        Err(error) if error.kind() == std.io.ErrorKind.NotFound -> return Ok(())
        Err(error) -> return Err("could not inspect history artifact: {error}")
    }
    fs.remove_file(path).map_err(error -> "could not clear history artifact: {error}")
}
// Rust: Source/CmdProve.rs:776
fn persist_history_artifact(target: &Target, member: &Member, report: &EvidenceReport) -> Unit Err! {
    has_property := false
    artifact := String?{None}
    loop record in &report.records {
        if record.kind != EvidenceKind.Property { next }
        has_property = true
        if record.outcome == EvidenceOutcome.Failed || record.outcome == EvidenceOutcome.Error {
            if parse_history_artifact_detail(record.detail) == { Val(value) -> { artifact = Val(value); break }; None -> {} }
        }
    }
    if artifact == {
        Val(value) -> { path :: history_artifact_path(target, member); bytes :: "{value}\n".into_bytes(); _ :: write_authoritative_bytes(path, bytes, "history artifact")?; Ok(()) }
        None if has_property -> clear_history_artifact(target, member)
        None -> Ok(())
    }
}
// Rust: Source/CmdProve.rs:810
fn parse_generated_failure_detail(detail: String) -> GeneratedFailure? {
    detail.lines().find_map(line -> {
        trimmed := line.trim() // #4303
        rest :: trimmed.strip_prefix("seed ")?
        (seed, rest) :: rest.split_once(" case ")?
        (case_index, rest) :: rest.split_once(":")?
        input_marker :: " (input "
        input_start :: rest.rfind(input_marker)?
        input :: rest[input_start + input_marker.len()..<rest.len()].strip_suffix(")")?.to_string()
        Val(GeneratedFailure{seed: seed.parse<UInt64>().ok()?, case_index: case_index.parse<UInt64>().ok()?, input: input})
    })
}
// Rust: Source/CmdProve.rs:828
fn read_generated_failure(target: &Target, member: &Member) -> GeneratedFailure? {
    path :: generated_failure_path(target, member)
    // GATE #4494: native no-follow metadata and source read.
    metadata :: fs.symlink_metadata(path).ok()?
    if metadata.file_type().is_symlink() || !metadata.is_file() { return None }
    text :: fs.read_to_string(path).ok()?
    fields :: if parse_json(text).ok()? == { .Object(fields) -> fields; _ -> return None }
    field :: name -> fields.iter().find_map(pair -> if pair.0 == name { Val(pair.1) } else { None })
    if field("version") != Val(DataTree.Int(1)) || field("target").and_then(value -> value.as_str().ok()) != Val(target.input_sha256)
        || field("member").and_then(value -> value.as_str().ok()) != Val(member.sha256) { return None }
    parse_u64 :: value -> if value == {
        Val(.Int(value)) if value >= 0 -> UInt64.try_from(value).ok()
        Val(.Text(value)) -> value.parse<UInt64>().ok()
        Val(.TypedText(value)) -> value.parse<UInt64>().ok()
        _ -> None
    }
    seed :: parse_u64(field("seed"))?
    case_index :: parse_u64(field("caseIndex"))?
    input :: field("input").and_then(value -> value.as_str().ok())?.to_string()
    Val(GeneratedFailure{seed: seed, case_index: case_index, input: input})
}
// Rust: Source/CmdProve.rs:872
fn write_generated_failure(target: &Target, member: &Member, failure: &GeneratedFailure) -> Unit Err! {
    path :: generated_failure_path(target, member)
    ensure_artifact_parent(path)?
    // GATE #4494: native exclusive temporary write and atomic replacement.
    if fs.symlink_metadata(path) == {
        Ok(metadata) -> { if metadata.file_type().is_symlink() || !metadata.is_file() { return Err("generated failure path is not a regular file: {path.display()}") } }
        Err(_) -> {}
    }
    seed :: if failure.seed <= Int64.MAX as UInt64 { failure.seed.to_string() } else { ProveReplay.json_str(failure.seed.to_string()) }
    case_index :: if failure.case_index <= Int64.MAX as UInt64 { failure.case_index.to_string() } else { ProveReplay.json_str(failure.case_index.to_string()) }
    contents :: "{{\"caseIndex\":{case_index},\"input\":{ProveReplay.json_str(failure.input)},\"member\":{ProveReplay.json_str(member.sha256)},\"seed\":{seed},\"target\":{ProveReplay.json_str(target.input_sha256)},\"version\":1}}\n"
    hash :: SHA256.sha256_hex(contents.bytes())
    temporary :: path.with_extension("json.tmp.{process.id()}.{hash[0..<8]}")
    write_result :: (() -> {
        file := fs.OpenOptions.new().write(true).create_new(true).open(temporary).map_err(error -> error.to_string())?
        file.write_all(contents.bytes()).map_err(error -> error.to_string())?
        file.sync_all().map_err(error -> error.to_string())?
        Ok(())
    })()
    if write_result == {
        Err(error) -> { _ :: fs.remove_file(temporary); return Err("could not write generated failure `{temporary.display()}`: {error}") }
        Ok(_) -> {}
    }
    // GATE #4483: selected Unix permission arm.
    if core.sys.target.selected_family() == "unix" {
        fs.set_permissions(temporary, fs.Permissions.from_mode(0o600)).map_err(error -> "could not protect generated failure `{temporary.display()}`: {error}")?
    }
    fs.rename(temporary, path).map_err(error -> { _ :: fs.remove_file(temporary); "could not publish generated failure `{path.display()}`: {error}" })?
    if path.parent() == { Val(parent) -> fs.File.open(parent).map_err(error -> error.to_string())?.sync_all().map_err(error -> error.to_string())?; None -> {} }
    Ok(())
}
// Rust: Source/CmdProve.rs:955
fn clear_generated_failure(target: &Target, member: &Member) -> Unit Err! {
    path :: generated_failure_path(target, member)
    // GATE #4494 / #4409: native no-follow removal with NotFound distinction.
    if fs.symlink_metadata(path) == {
        Ok(metadata) if metadata.file_type().is_symlink() || !metadata.is_file() -> return Err("generated failure path is not a regular file: {path.display()}")
        Ok(_) -> {}
        Err(error) if error.kind() == std.io.ErrorKind.NotFound -> return Ok(())
        Err(error) -> return Err("could not inspect generated failure: {error}")
    }
    fs.remove_file(path).map_err(error -> "could not clear generated failure: {error}")
}
// Rust: Source/CmdProve.rs:971
fn persist_generated_failure(target: &Target, member: &Member, report: &EvidenceReport) -> Unit Err! {
    persist_history_artifact(target, member, report)?
    has_property := false
    failure := GeneratedFailure?{None}
    loop record in &report.records {
        if record.kind != EvidenceKind.Property { next }
        has_property = true
        if record.outcome == EvidenceOutcome.Failed || record.outcome == EvidenceOutcome.Error {
            if parse_generated_failure_detail(record.detail) == { Val(parsed) -> { failure = Val(parsed); break }; None -> {} }
        }
    }
    if failure == { Val(failure) -> write_generated_failure(target, member, failure); None if has_property -> clear_generated_failure(target, member); None -> Ok(()) }
}
// Rust: Source/CmdProve.rs:1001
fn property_generation_unavailable(message: String) -> Bool {
    message.starts_with("E0613:") || message.contains("generated inputs are unavailable") || message.contains("has no built-in generator")
}
// Rust: Source/CmdProve.rs:1007
pub fn run_prove(args: &[String], json: Bool) -> {
    // GATE #4494: only validated capture/replay authorities may install the time adapter.
    env.remove_var("JET_PROVE_REPLAY_TIME_MS")
    positional := [String]{}
    lenses := [String]{}
    capture := ProveReplay.CaptureOpts?{None}
    replay := String?{None}
    save := String?{None}
    unsave := String?{None}
    i := 0
    loop i < args.len() {
        arg :: &args[i]
        if arg == CLI.MACHINE_OUTPUT_FLAG { i += 1; next }
        if ProveReplay.parse_capture_flag(arg) == {
            Val(opts) -> {
                if capture != None || replay != None { emit_prove_cli_error("E2104", "`jet prove` accepts at most one of `--capture` / `--replay`", json); process.exit(ExitCodes.USAGE) }
                capture = Val(opts); i += 1; next
            }
            None -> {}
        }
        if ProveReplay.parse_replay_flag(arg, args.get(i + 1)) == {
            Val(parsed) -> {
                if capture != None || replay != None { emit_prove_cli_error("E2104", "`jet prove` accepts at most one of `--capture` / `--replay`", json); process.exit(ExitCodes.USAGE) }
                if parsed == {
                    Ok(path) -> { replay = Val(path); i += if arg == "--replay" { 2 } else { 1 } }
                    Err(message) -> { emit_prove_cli_error("E2104", message, json); process.exit(ExitCodes.USAGE) }
                }
                next
            }
            None -> {}
        }
        if arg.strip_prefix("--save=") == {
            Val(value) -> {
                if value.is_empty() { emit_prove_cli_error("E2104", "`--save` needs a replay artifact id or path", json); process.exit(ExitCodes.USAGE) }
                if save != None || unsave != None { emit_prove_cli_error("E2104", "`jet prove` accepts at most one of `--save` / `--unsave`", json); process.exit(ExitCodes.USAGE) }
                save = Val(value.to_string()); i += 1; next
            }
            None -> {}
        }
        if arg == "--save" {
            value :: if args.get(i + 1).filter(value -> !value.starts_with("-")) == {
                Val(value) -> value
                None -> { emit_prove_cli_error("E2104", "`--save` needs a replay artifact id or path", json); process.exit(ExitCodes.USAGE) }
            }
            if save != None || unsave != None { emit_prove_cli_error("E2104", "`jet prove` accepts at most one of `--save` / `--unsave`", json); process.exit(ExitCodes.USAGE) }
            save = Val(value.to_string()); i += 2; next
        }
        if arg.strip_prefix("--unsave=") == {
            Val(value) -> {
                if value.is_empty() { emit_prove_cli_error("E2104", "`--unsave` needs a replay artifact id", json); process.exit(ExitCodes.USAGE) }
                if save != None || unsave != None { emit_prove_cli_error("E2104", "`jet prove` accepts at most one of `--save` / `--unsave`", json); process.exit(ExitCodes.USAGE) }
                unsave = Val(value.to_string()); i += 1; next
            }
            None -> {}
        }
        if arg == "--unsave" {
            value :: if args.get(i + 1).filter(value -> !value.starts_with("-")) == {
                Val(value) -> value
                None -> { emit_prove_cli_error("E2104", "`--unsave` needs a replay artifact id", json); process.exit(ExitCodes.USAGE) }
            }
            if save != None || unsave != None { emit_prove_cli_error("E2104", "`jet prove` accepts at most one of `--save` / `--unsave`", json); process.exit(ExitCodes.USAGE) }
            unsave = Val(value.to_string()); i += 2; next
        }
        if arg.strip_prefix("--lens=") == {
            Val(value) -> { validate_lens(value, positional.first().copied() ?? "TARGET", json); lenses.push(value.to_string()); i += 1; next }
            None -> {}
        }
        if arg == "--lens" { value :: args.get(i + 1) ?? ""; validate_lens(value, positional.first().copied() ?? "TARGET", json); lenses.push(value.to_string()); i += 2; next }
        if arg.starts_with("-") { emit_prove_cli_error("E2102", "unknown `jet prove` flag `{arg}`", json); process.exit(ExitCodes.USAGE) }
        positional.push(arg)
        i += 1
    }
    if positional.len() != 1 {
        emit_prove_cli_error_with_fix("E2104", "`jet prove` needs exactly one file, package, or workspace target", "jet prove path/to/program.jet", json)
        process.exit(ExitCodes.USAGE)
    }
    target :: if resolve_target(positional[0]) == { Ok(target) -> target; Err(message) -> { emit_prove_cli_error("E2105", message, json); process.exit(ExitCodes.USER_ERROR) } }
    identity :: ProveReplay.ReplayIdentity{
        entry: if target.members.len() == 1 { target.members[0].path.clone() } else { target.root.clone() },
        source_digest: target.source_digest.clone(), execution_adapter: "mir-v1", target_triple: host_target_triple(), abi: "gnu",
        build_digest: target.build_digest.clone(), core_abi: target.core_abi.clone(), lock_digest: target.lock_digest.clone(), profile: "dev",
        semantic_mir_hash: target.mir.semantic_hash.clone(), optimized_mir_hash: target.mir.optimized_hash.clone(),
        mir_schema: MIR.MIR_IDENTITY_SCHEMA, mir_identity: target.mir.canonical_json(), time_site_id: time_site_id_for_target(target)}
    if (save != None || unsave != None) && (capture != None || replay != None) {
        emit_prove_cli_error("E2104", "`jet prove` cannot combine `--save` or `--unsave` with capture or replay", json)
        process.exit(ExitCodes.USAGE)
    }
    if unsave == {
        Val(id) -> {
            if unsave_replay_command(id, identity) == { Err(error) -> mutation_diag(error, "unsave", json); Ok(_) -> {} }
            if json { result :: "{{\"artifactId\":{ProveReplay.json_str(id)},\"status\":\"removed\"}}"; print("{prove_status_result(\"unsave\", result)}") }
            else { println("UNSAVED  replay {id}") }
            process.exit(ExitCodes.OK)
        }
        None -> {}
    }
    if save == {
        Val(raw) -> {
            (artifact_id, path, size) :: if save_replay_command(identity, raw) == { Ok(saved) -> saved; Err(error) -> mutation_diag(error, "save", json) }
            if json {
                result :: "{{\"artifactId\":{ProveReplay.json_str(artifact_id)},\"path\":{ProveReplay.json_str(path.to_string_lossy())},\"size\":{size},\"status\":\"saved\"}}"
                print("{prove_status_result(\"save\", result)}")
            } else { println("SAVED    replay {artifact_id} -> {path.display()} ({size} bytes)") }
            process.exit(ExitCodes.OK)
        }
        None -> {}
    }
    if (capture != None || replay != None) && target.members.len() != 1 {
        paths :: target.members.iter().map(member -> member.path).collect().join(", ")
        listed :: if paths.is_empty() { "none" } else { paths }
        ProveReplay.emit_prove_diag("E3624", "replay target cardinality is not one", "the selected {target.kind} resolved {target.members.len()} runnable targets: {listed}", "select one runnable file or package target before capture or replay", json)
        process.exit(ExitCodes.USER_ERROR)
    }
    capture_opts :: capture.clone()
    capture_authority :: if capture == {
        Val(opts) -> if ProveReplay.prepare_safe_capture_at(opts, json, target.authority_root) == { Ok(authority) -> Val(authority); Err(status) -> process.exit(status) }
        None -> None
    }
    if capture_authority == { Val(authority) -> env.set_var("JET_PROVE_REPLAY_TIME_MS", authority.time_ms().to_string()); None -> {} }
    if capture_opts == { Val(opts) -> if preflight_capture_target(target, opts, json) == { Err(status) -> process.exit(status); Ok(_) -> {} }; None -> {} }
    if replay.take() == {
        Val(raw) -> {
            index :: if load_record_index(target.authority_root) == {
                Ok(index) -> index
                Err(error) -> { emit_prove_cli_error("E2105", "failed to load replay index: {error}", json); process.exit(ExitCodes.ICE) }
            }
            replay = if resolve_indexed_replay(index, raw) == {
                Ok(Val(entry)) -> Val(target.authority_root.join(entry.path).to_string_lossy().to_string())
                Ok(None) -> { path :: OSPath.from(raw); if path.starts_with(OSPath.from(".jet")) { Val(target.authority_root.join(path).to_string_lossy().to_string()) } else { Val(raw) } }
                Err(error) -> {
                    ProveReplay.emit_prove_diag("E3621", "replay semantic identity could not be resolved", error, "use an indexed replay id or a canonical `.jetproof-replay` path", json)
                    process.exit(ExitCodes.USER_ERROR)
                }
            }
        }
        None -> {}
    }
    if replay == None && capture == None {
        record_identity :: if identity.record_identity() == {
            Ok(identity) -> identity
            Err(error) -> { emit_prove_cli_error("E2105", "failed to identify saved replay claims: {error}", json); process.exit(ExitCodes.ICE) }
        }
        index :: if load_record_index(target.authority_root) == {
            Ok(index) -> index
            Err(error) -> { emit_prove_cli_error("E2105", "failed to load replay index: {error}", json); process.exit(ExitCodes.ICE) }
        }
        if index.saved_replays(record_identity).into_iter().next() == { Val(entry) -> replay = Val(target.authority_root.join(entry.path).to_string_lossy().to_string()); None -> {} }
    }
    replay_path :: replay.clone()
    replay_authority := if replay == {
        Val(path) -> {
            artifact_present :: ProveReplay.replay_artifact_is_present(path)
            authority :: if artifact_present {
                authority :: prepare_replay_or_exit(identity, path, json)
                if preflight_replay_target(target, json) == { Err(status) -> process.exit(status); Ok(_) -> {} }
                authority
            } else {
                if preflight_replay_target(target, json) == { Err(status) -> process.exit(status); Ok(_) -> {} }
                prepare_replay_or_exit(identity, path, json)
            }
            time_sites :: capture_sites_for_target(target).into_iter().filter(site -> supported_time_capture_site(site)).count()
            if time_sites == 0 {
                ProveReplay.emit_prove_diag("E3623", "replay diverged from captured authority",
                    "the target has no statically identified `core.time.now` call site for the captured Time record",
                    "replay the matching target, or recapture a target with one supported Time call", json)
                process.exit(ExitCodes.USER_ERROR)
            }
            env.set_var("JET_PROVE_REPLAY_TIME_MS", authority.time_ms.to_string())
            if !json { eprintln("ambient authority opened: Time; {identity.execution_adapter} exact") }
            Val(authority)
        }
        None -> None
    }
    // The adapter environment is not evidence; only validated authority supplies this fact.
    replay_time_ms :: replay_authority.map(authority -> authority.time_ms)
    items := [FrontEndItem]{}
    warnings := [FrontEndWarning]{}
    declarations := [ContractDeclaration]{}
    loop member in &target.members {
        source :: String.from_utf8_lossy(member.bytes).to_string()
        (semantic_items, member_declarations) :: semantic_front_end_items(target, member.path, source)
        declarations.extend(^member_declarations)
        (errors, member_warnings) :: check_with_path(member.path).into_iter().partition(diagnostic -> diagnostic.severity == Diagnostics.Severity.Error)
        warnings.extend(member_warnings.into_iter().map(diagnostic -> FrontEndWarning{path: member.path.clone(), source: source.clone(), diagnostic: diagnostic}))
        if errors.is_empty() {
            items.extend(semantic_items.into_iter().map(item -> { item.source = source.clone(); item }))
        } else {
            loop diagnostic in errors {
                span :: diagnostic_span(source, diagnostic)
                (line, column) :: diagnostic.span.map(span -> Diagnostics.span_line_col(source, span.start)) ?? (1, 1)
                claim :: "{diagnostic.code}:{diagnostic.what}"
                items.push(FrontEndItem{id: evidence_id(target, "front_end", member.path, span, claim), path: member.path.clone(),
                    diagnostic: Val(diagnostic), facet: "all", source: source.clone(), line: line, column: column})
            }
        }
    }
    failed :: items.iter().filter(item -> item.diagnostic != None).count()
    proved :: items.len() - failed
    (tests, producer_exit, evidence_links) :: if failed == 0 {
        if run_test_producers(target) == {
            Ok(result) -> result
            Err(message) -> { emit_prove_cli_error("E2105", "evidence producer failed: {message}", json); process.exit(ExitCodes.ICE) }
        }
    } else { ([], ExitCodes.OK, []) }
    test_failed :: tests.iter().filter(item -> item.state == 1).count()
    budgets :: budget_projection(target)
    budget_failed :: budgets.facts.iter().any(fact -> fact.outcome == "fail")
    enable_solver :: lenses.iter().any(lens -> lens == "solver")
    solver_members :: target.members.iter().map(member -> (member.path.clone(), String.from_utf8_lossy(member.bytes).to_string())).collect()
    // Never solve any member after another member's front end fails.
    solver :: if failed == 0 {
        if ProveSolver.run_solver_producer(solver_members, target.input_sha256, enable_solver) == {
            Ok(items) -> items
            Err(message) -> { emit_prove_cli_error("E2105", "solver producer failed: {message}", json); process.exit(ExitCodes.ICE) }
        }
    } else { [] }
    solver_disproved :: solver.iter().any(item -> if item.outcome == { .Disproved{..} -> true; _ -> false })
    exit_code := if producer_exit == ExitCodes.ICE { ExitCodes.ICE }
        else if producer_exit == ExitCodes.RUNTIME_PANIC { ExitCodes.RUNTIME_PANIC }
        else if producer_exit == ExitCodes.USER_ERROR { ExitCodes.USER_ERROR }
        else if failed > 0 || test_failed > 0 || budget_failed || solver_disproved { ExitCodes.USER_ERROR }
        else { ExitCodes.OK }
    if replay_authority.as_mut() == {
        Val(authority) -> {
            if authority.consume_time() == {
                Err(why) -> { ProveReplay.emit_prove_diag("E3623", "replay diverged from captured authority", why, "recapture with `--capture` so the normal producer result is authoritative", json); process.exit(ExitCodes.USER_ERROR) }
                Ok(_) -> {}
            }
            if authority.finish() == {
                Err(why) -> { ProveReplay.emit_prove_diag("E3623", "replay diverged from captured authority", why, "recapture with `--capture` so the normal producer result is authoritative", json); process.exit(ExitCodes.USER_ERROR) }
                Ok(_) -> {}
            }
            outcome :: if exit_code == ExitCodes.RUNTIME_PANIC { "panic" } else { "exit" }
            if authority.expected_status != exit_code || authority.expected_outcome != outcome {
                ProveReplay.emit_prove_diag("E3623", "replay diverged from captured authority",
                    "captured outcome={authority.expected_outcome} status={authority.expected_status}, current outcome={outcome} status={exit_code}",
                    "recapture with `--capture` so the normal producer result is authoritative", json)
                process.exit(ExitCodes.USER_ERROR)
            }
        }
        None -> {}
    }
    claims_grade :: claim_grade(proved, failed, tests, solver)
    claims_floor :: claims_floor_for_target(target)
    claims_floor_violation :: claims_floor.filter(floor -> !grade_meets_floor(claims_grade, floor))
    if claims_floor_violation != None && exit_code == ExitCodes.OK { exit_code = ExitCodes.USER_ERROR }
    report :: render_report(target, items, warnings, tests, budgets, solver, lenses, declarations, replay_time_ms, proved, failed, claims_grade, claims_floor_violation, exit_code)
    if exit_code != ExitCodes.ICE {
        consumed := evidence_links
        if replay_path == {
            Val(path) -> {
                replay_link :: if index_replay_artifact(OSPath.from(path), identity, RecordCapture.Safe, false) == {
                    Ok(link) -> link
                    Err(message) -> { emit_prove_cli_error("E2105", "failed to index replay artifact: {message}", json); process.exit(ExitCodes.ICE) }
                }
                consumed.push(replay_link)
            }
            None -> {}
        }
        produced :: produced_receipt_links(target)
        proof_artifact :: if write_jetproof(target, report, consumed, produced) == {
            Ok(artifact) -> artifact
            Err(message) -> { emit_prove_cli_error("E2105", "failed to write .jetproof: {message}", json); process.exit(ExitCodes.ICE) }
        }
        proof_identity :: if RecordIdentity.new(target.input_sha256.clone(), env.compile_var("CARGO_PKG_VERSION"), "jet-prove-v1") == {
            Ok(identity) -> identity
            Err(message) -> { emit_prove_cli_error("E2105", "failed to identify proof artifact: {message}", json); process.exit(ExitCodes.ICE) }
        }
        if index_artifact(proof_identity, RecordKind.Proof, proof_artifact.artifact_id.clone(), proof_artifact.path.clone(), proof_artifact.size, RecordCapture.Safe, ^consumed, ^produced, true) == {
            Err(message) -> { emit_prove_cli_error("E2105", "failed to index .jetproof: {message}", json); process.exit(ExitCodes.ICE) }
            Ok(_) -> {}
        }
        if failed == 0 && producer_exit != ExitCodes.ICE {
            if capture_authority == {
                Val(authority) -> {
                    path :: if ProveReplay.finalize_safe_capture_path(identity, authority, exit_code, json, None) == { Ok(path) -> path; Err(status) -> process.exit(status) }
                    capture_kind :: if capture_opts.is_some_and(opts -> opts.sensitive) { RecordCapture.Sensitive } else { RecordCapture.Safe }
                    if index_replay_artifact(path, identity, capture_kind, true) == {
                        Err(message) -> { emit_prove_cli_error("E2105", "failed to index replay artifact: {message}", json); process.exit(ExitCodes.ICE) }
                        Ok(_) -> {}
                    }
                }
                None -> {}
            }
        }
    }
    if json {
        proof :: StatusValue.parse(report).expect("render_report emits valid JSON")
        status :: StatusEnvelope.new("prove", exit_code == ExitCodes.OK).with_field("proof", proof)
        println("{status.json_line()}")
    } else {
        show :: facet -> lens_shows(lenses, facet)
        if !lenses.is_empty() { println("LENSES   {canonical_lens_names(lenses).join(\", \")}") }
        println("CLAIMS   grade: {claims_grade}")
        if claims_floor_violation == { Val(floor) -> eprintln("Error [E2942]: claim grade `{claims_grade}` is below package floor `{floor.render()}`"); None -> {} }
        if show("refinements") || show("all") || show("effects") || show("taint") || lenses.is_empty() { println("CHECKED  front end: {proved} proved, {failed} failed") }
        loop item in &items { if item.diagnostic == { Val(diagnostic) -> eprintln("{diagnostic.render(item.path, item.source)}"); None -> {} } }
        loop warning in &warnings { eprintln("{warning.diagnostic.render(warning.path, warning.source)}") }
        loop row in outside_selected_lenses(lenses, items, tests, budgets, declarations) { println("{row}") }
        if show("tests") || lenses.is_empty() {
            if !tests.is_empty() {
                unit_report :: unit_test_report(tests)
                println("TESTS    unit: {unit_report.summary()}")
                loop item in tests.iter().filter(item -> (item.kind == 0 || item.kind == 2) && item.state == 1) { println("{item.name}: FAIL"); eprint("{test_failure_detail(item)}") }
            }
        }
        if show("budgets") || lenses.is_empty() {
            if !budgets.facts.is_empty() || !budgets.rejected.is_empty() {
                met :: budgets.facts.iter().filter(fact -> fact.outcome == "pass").count()
                failed_b :: budgets.facts.iter().filter(fact -> fact.outcome == "fail").count()
                warned :: budgets.facts.len() - met - failed_b
                println("BUDGETS  {met} met, {failed_b} failed, {warned} warned, {budgets.rejected.len()} unavailable · verified canonical reports")
                loop reason in &budgets.rejected { println("  unavailable: {reason}") }
            }
        }
        if replay_time_ms != None && (show("replay") || lenses.is_empty()) { println("REPLAY   exact Time authority; execution adapter matched; parity not available") }
        if enable_solver {
            (selected, proved_s, disproved_s, unknown_s, _) :: ProveSolver.summarize(solver)
            println("SOLVER   {selected} selected, {proved_s} proved, {disproved_s} disproved, {unknown_s} unknown")
            loop item in &solver {
                if item.outcome == {
                    .Disproved{assignment: assignment, ..} -> {
                        values :: assignment.iter().map(pair -> "{pair.0} = {pair.1}").collect().join(" and ")
                        eprintln("Error [E2950]: Solver found a counterexample to {item.obligation.kind}")
                        eprintln(" Why: The assignment {values} satisfies the assumptions but makes the claim false")
                        eprintln(" Fix: Change {item.obligation.origin} so every return satisfies the claim, or correct the contract")
                        eprintln("More: jet-lang.dev/e/E2950")
                    }
                    _ -> {}
                }
            }
        }
        unavailable :: tests.iter().filter(item -> item.state == 3).count()
        budget_incomplete :: !budgets.rejected.is_empty() || budgets.facts.iter().any(fact -> fact.evidence == "unavailable")
        result :: if failed > 0 || test_failed > 0 || budget_failed || solver_disproved { "fail" }
            else if unavailable > 0 || budget_incomplete || solver.iter().any(item -> if item.outcome == { .Unknown{..} -> true; _ -> false }) { "pass_incomplete" }
            else { "pass" }
        println("RESULT   {result}")
    }
    process.exit(exit_code)
}
