// Rust: Source/CmdProve.rs:60
fn index_artifact(identity: RecordIdentity, kind: RecordKind, artifact_id: String, path: OSPath,
    size: UInt64, capture: RecordCapture, consumed: [RecordLink], produced: [RecordLink], save_requested: Bool) -> RecordLink Err! {
    // GATE #4494: native working directory and index persistence.
    absolute :: if path.is_absolute() { path } else { env.current_dir().map_err(error -> error.to_string())?.join(path) }
    project_root :: build_project_root(absolute.to_string_lossy()).map_err(diagnostics -> "could not resolve record project root: {diagnostics:?}")?
    relative :: absolute.strip_prefix(project_root).map_err(_ -> "record artifact is outside the project: {absolute.display()}")?.to_path_buf()
    index := RecordIndex.load_for_project(project_root).map_err(error -> "could not load record index: {error}")?
    (recorded_sequence, existing_saved) :: if index.find(kind, artifact_id, true) == {
        Val(entry) -> (entry.recorded_sequence, entry.saved)
        None -> (index.next_recorded_sequence().map_err(error -> "could not allocate record sequence: {error}")?, false)
    }
    entry :: RecordIndexEntry.new(identity, kind, artifact_id.clone(), relative).map_err(error -> "could not construct {kind} record: {error}")?
        .with_links(^consumed, ^produced).map_err(error -> "could not link {kind} record `{artifact_id}`: {error}")?
        .with_capture(capture).with_size(size).with_recorded_sequence(recorded_sequence).with_saved(existing_saved || save_requested)
    index.update_and_store(^entry).map_err(error -> "could not store {kind} record `{artifact_id}`: {error}")?
    RecordLink.new(kind, artifact_id).map_err(error -> "could not link {kind} record: {error}")
}
// Rust: Source/CmdProve.rs:112
fn produced_receipt_links(target: &Target) -> [RecordLink] {
    // GATE #4494: native environment access.
    claim_key :: if env.var(ReceiptStore.JET_RECEIPT_RECORD_CLAIM_ENV) == { Ok(value) -> value; Err(_) -> return [] }
    if claim_key.len() != 64 || !claim_key.bytes().all(byte -> byte.is_ascii_digit() || (byte >= 97 && byte <= 102)) { return [] }
    expected_identity :: if RecordIdentity.new(target.input_sha256.clone(), env.compile_var("CARGO_PKG_VERSION"), "jet-receipt-v2") == { Ok(value) -> value; Err(_) -> return [] }
    index :: if RecordIndex.load_for_project(target.authority_root) == { Ok(value) -> value; Err(_) -> return [] }
    indexed :: if index.find(RecordKind.Receipt, claim_key, true) == { Val(value) -> value; None -> return [] }
    if indexed.identity != expected_identity { return [] }
    RecordLink.new(RecordKind.Receipt, claim_key).ok().into_iter().collect()
}
// Rust: Source/CmdProve.rs:145
fn write_authoritative_bytes(path: &OSPath, bytes: &[UInt8], label: String) -> UInt64 Err! {
    ensure_artifact_parent(path)?
    // GATE #4494: no-follow metadata, exclusive temporary creation, hard-link publication and fsync.
    if fs.symlink_metadata(path) == {
        Ok(metadata) -> {
            if metadata.file_type().is_symlink() || !metadata.is_file() { return Err("final {label} path is not a regular file: {path.display()}") }
            existing :: fs.read(path).map_err(error -> error.to_string())?
            if existing == bytes { return UInt64.try_from(existing.len()).map_err(_ -> "{label} is too large") }
            return Err("refusing to overwrite differing {label} at {path.display()}")
        }
        Err(_) -> {}
    }
    extension :: path.extension().and_then(extension -> extension.to_str()) ?? "artifact"
    hash :: SHA256.sha256_hex(bytes).get(0..<8) ?? "00000000"
    tmp :: path.with_extension("{extension}.tmp.{process.id()}.{hash}")
    write_result :: (() -> {
        file := fs.OpenOptions.new().write(true).create_new(true).open(tmp).map_err(error -> error.to_string())?
        // GATE #4483: selected target family determines the Unix permission/fsync arms.
        if core.sys.target.selected_family() == "unix" {
            file.set_permissions(fs.Permissions.from_mode(0o600)).map_err(error -> error.to_string())?
        }
        file.write_all(bytes).map_err(error -> error.to_string())?
        file.sync_all().map_err(error -> error.to_string())?
        if fs.hard_link(tmp, path) == {
            Ok(_) -> {}
            Err(error) if error.kind() == std.io.ErrorKind.AlreadyExists -> {
                metadata :: fs.symlink_metadata(path).map_err(e -> e.to_string())?
                if metadata.file_type().is_symlink() || !metadata.is_file() { return Err("final {label} path is not a regular file: {path.display()}") }
                existing :: fs.read(path).map_err(e -> e.to_string())?
                if existing != bytes { return Err("refusing to overwrite differing {label} at {path.display()}") }
            }
            Err(error) -> return Err(error.to_string())
        }
        fs.remove_file(tmp).map_err(error -> error.to_string())?
        if core.sys.target.selected_family() == "unix" {
            if path.parent() == { Val(parent) -> fs.File.open(parent).map_err(error -> error.to_string())?.sync_all().map_err(error -> error.to_string())?; None -> {} }
        }
        Ok(())
    })()
    if write_result == { Err(error) -> { _ :: fs.remove_file(tmp); return Err(error) }; Ok(_) -> {} }
    UInt64.try_from(bytes.len()).map_err(_ -> "{label} is too large")
}
// Rust: Source/CmdProve.rs:224
fn persist_evidence_report(target: &Target, report: &EvidenceReport) -> RecordLink Err! {
    report_id :: report.identity.report_id
    if report_id.is_empty() || report_id.contains("/") || report_id.contains("\\") || report_id == "." || report_id == ".." {
        return Err("evidence report has an unsafe report id `{report_id}`")
    }
    identity :: RecordIdentity.new(target.input_sha256.clone(), report.build.toolchain.clone(), report.producer.as_str())?
    path :: target.authority_root.join(".jet/evidence").join("{report_id}.json")
    bytes :: report.encode()?
    size :: write_authoritative_bytes(path, bytes, "evidence report")?
    index_artifact(identity, RecordKind.Evidence, report_id.to_string(), path, size, RecordCapture.Safe, [], [], true)
}
// Rust: Source/CmdProve.rs:259
fn replay_artifact_id(bytes: &[UInt8]) -> String Err! {
    if bytes.len() < 16 { return Err("replay artifact is truncated before its header") }
    header_len :: UInt32.from_le_bytes(bytes[12..<16].try_into().map_err(_ -> "replay header length is invalid")?) as Int
    header_end :: 16.checked_add(header_len).ok_or("replay header length overflows")?
    if header_end > bytes.len() { return Err("replay artifact header is truncated") }
    header :: String.from_utf8(bytes[16..<header_end]).map_err(_ -> "replay artifact header is not UTF-8")?
    fields :: if parse_json(header).map_err(_ -> "replay artifact header is not valid JSON")? == {
        .Object(fields) -> fields
        _ -> return Err("replay artifact header is not a JSON object")
    }
    artifact_id :: fields.iter().find_map(pair -> if pair.0 == "artifact_id" { pair.1.as_str().ok() } else { None }).ok_or("replay artifact header has no artifact_id")?
    Ok(artifact_id.to_string())
}
// Rust: Source/CmdProve.rs:291
pub fn index_replay_artifact(path: &OSPath, identity: &ProveReplay.ReplayIdentity, capture: RecordCapture, save_requested: Bool) -> RecordLink Err! {
    // GATE #4494: native artifact bytes.
    bytes :: fs.read(path).map_err(error -> "could not read replay artifact `{path.display()}` for indexing: {error}")?
    artifact_id :: replay_artifact_id(bytes)?
    record_identity :: identity.record_identity()?
    size :: UInt64.try_from(bytes.len()).map_err(_ -> "replay artifact is too large")?
    index_artifact(record_identity, RecordKind.Replay, artifact_id, path.to_path_buf(), size, capture, [], [], save_requested)
}
// Rust: Source/CmdProve.rs:320
fn validate_artifact_id(id: String) -> Unit Err! {
    if id.len() != 24 || !id.bytes().all(byte -> byte.is_ascii_hexdigit()) { return Err("replay artifact id must be 24 lowercase hexadecimal bytes") }
    if id.bytes().any(byte -> byte.is_ascii_uppercase()) { return Err("replay artifact id must use lowercase hexadecimal bytes") }
    Ok(())
}
// Rust: Source/CmdProve.rs:330
fn saved_replay_relative_path(id: String) -> OSPath { OSPath.from(".jet/records/saved/{id}") }
// Rust: Source/CmdProve.rs:335
fn validate_replay_input_path(raw: String) -> OSPath Err! {
    if raw.is_empty() { return Err("replay artifact path is empty") }
    if raw.contains(TEXT_NUL) || raw.contains("\\") || raw.starts_with("/") { return Err("replay artifact path must stay project-relative") }
    if raw.split("/").any(component -> component.is_empty()) { return Err("replay artifact path must use non-empty components") }
    path :: OSPath.from(raw)
    if path.components().any(component -> if component == { .CurDir -> true; .ParentDir -> true; .RootDir -> true; .Prefix(_) -> true; _ -> false }) { return Err("replay artifact path contains an unsafe component") }
    is_saved :: path.parent() == Val(OSPath.from(".jet/records/saved")) && path.file_name().and_then(name -> name.to_str()).is_some_and(name -> validate_artifact_id(name).is_ok())
    if path.extension().and_then(extension -> extension.to_str()) != Val("jetproof-replay") && !is_saved { return Err("replay input must be a canonical index id or `.jetproof-replay` artifact path") }
    Ok(path)
}
// Rust: Source/CmdProve.rs:372
fn resolve_indexed_replay(index: &RecordIndex, raw: String) -> RecordIndexEntry? Err! {
    if index.find(RecordKind.Replay, raw, true) == { Val(entry) -> return Ok(Val(entry)); None -> {} }
    path :: validate_replay_input_path(raw)?
    Ok(index.entries_authenticated().into_iter().find(entry -> entry.kind == RecordKind.Replay && entry.path == path))
}
