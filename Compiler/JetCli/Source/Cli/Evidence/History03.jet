fn sync_directory(path: OSPath) -> std.io.Error! {
    // GATE #4494: sync the held directory descriptor.
    directory :: fs.File.open(path)
    directory.sync_all()
}
// Rust: Source/ReceiptStore.rs:3833
fn write_bytes<W: Write>(writer: &W, bytes: [U8]) -> {
    &writer.write_all(bytes) ?? {}
    &writer.flush() ?? {}
}
