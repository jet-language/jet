fn capture_stream<R: Read, W: Write>(reader: &R, writer: &W) -> [U8] {
    // GATE #4494: native streams preserve bytes and concurrent pipe drainage.
    captured := [U8]{}
    buffer := [U8; 8192]{U8{0}}
    truncated := false
    loop {
        read :: &reader.read(&buffer) ?? break
        if read == 0 -> break
        remaining :: (JET_CLI_RECEIPT_MAX_FIELD - captured.len()).max(0)
        keep :: remaining.min(read)
        &captured.extend(buffer[0..<keep])
        truncated = truncated || keep < read
        &writer.write_all(buffer[0..<read]) ?? break
        &writer.flush() ?? {}
    }
    if truncated -> &captured.extend(CAPTURE_TRUNCATION_MARKER)
    captured
}
