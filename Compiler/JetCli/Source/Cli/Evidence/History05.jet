pub fn copy_into_project(store_entry: OSPath, project_root: OSPath) -> Diagnostic! {
    source :: open_directory_authority(store_entry).map_err(error -> io_error("checking store entry", store_entry, error))
    expected :: hash_directory_authority(&source, false).map_err(error -> io_error("hashing store entry", store_entry, error))
    parent :: project_root.parent() ?? return Err(io_error("locating dep copy parent", project_root, invalid_path_error()))
    parent_authority :: ensure_directory_authority(parent).map_err(error -> io_error("creating dep copy parent", parent, error))
    project_name :: project_root.file_name() ?? return Err(io_error("locating dep copy", project_root, invalid_path_error()))
    if parent_authority.open_child_directory(project_name) == {
        .Ok(existing) -> {
            actual :: hash_directory_authority(&existing, false).map_err(error -> io_error("hashing dep copy", project_root, error))
            if actual != expected {
                return Err(io_error("checking dep copy", project_root, io.Error.new(.InvalidData, "existing dependency copy does not match its immutable store entry")))
            }
            return Ok(())
        }
        .Err(error) -> { if error.kind() != .NotFound -> return Err(io_error("checking dep copy", project_root, error)) }
    }
    (staging_name, staging) :: parent_authority.create_private_child("dep-copy").map_err(error -> io_error("creating dep copy staging dir", parent, error))
    result :: (() -> Diagnostic! {
        copy_directory_authority(&source, &staging, false).map_err(error -> io_error("copying dep tree", project_root, error))
        actual :: hash_directory_authority(&staging, false).map_err(error -> io_error("hashing staged dep copy", project_root, error))
        if actual != expected {
            return Err(io_error("checking staged dep copy", project_root, io.Error.new(.InvalidData, "staged dependency copy does not match its immutable store entry")))
        }
        if publish_directory(&parent_authority, staging_name, &parent_authority, project_name) == {
            .Ok(_) -> Ok(())
            .Err(error) -> {
                if error.kind() != .AlreadyExists -> return Err(io_error("publishing dep copy", project_root, error))
                winner :: parent_authority.open_child_directory(project_name).map_err(error -> io_error("opening concurrent dep copy", project_root, error))
                winner_hash :: hash_directory_authority(&winner, false).map_err(error -> io_error("hashing concurrent dep copy", project_root, error))
                if winner_hash == expected -> Ok(())
                else -> Err(io_error("publishing dep copy", project_root, io.Error.new(.AlreadyExists, "concurrent dependency copy has different contents")))
            }
        }
    })()
    _ :: parent_authority.remove_child_tree(staging_name)
    result
}

// Rust: Source/Store.rs:2332
pub fn verify_entry(pkg_name: String, store_entry: OSPath, expected_tree_hash: String) -> Diagnostic! {
    entry :: if open_directory_authority(store_entry) == {
        .Ok(entry) -> ^entry
        .Err(error) -> {
            if error.kind() == .NotFound {
                return Err(Diagnostic.error("E1204", "the store entry for `{pkg_name}` is missing", "a package source tree must be present in the store before it can be used", "run `jet fetch` to re-download the package", None))
            }
            return Err(io_error("checking store entry", store_entry, error))
        }
    }
    if expected_tree_hash.is_empty() -> return Err(missing_content_hash(pkg_name))
    actual :: hash_directory_authority(&entry, false).map_err(error -> io_error("hashing store entry", store_entry, error))
    if actual != expected_tree_hash {
        return Err(Diagnostic.error("E1204", "the store entry for `{pkg_name}` has been modified", "the content hash of the stored source tree doesn't match the fingerprint in {UNIFIED_LOCK_FILE}", "run `jet fetch` to re-download the package, or run `jetpack hangar verify` to check all entries", None))
    }
    Ok(())
}

// Rust: Source/Store.rs:2378
pub fn verify_all(entries: &[(String, OSPath, String)]) -> [Diagnostic] {
    diags := []
    loop (name, path, expected) in entries {
        if verify_entry(name, path, expected) == {
            .Ok(_) -> {}
            .Err(d) -> diags.push(^d)
        }
    }
    ^diags
}

// Rust: Source/Store.rs:2393
pub fn list_entries() -> [OSPath] {
    dir :: store_dir()
    authority :: open_directory_authority(dir).ok() ?? return []
    names :: authority.list_names().ok() ?? return []
    entries := []
    loop name in names {
        if name == OsString.from(".snapshots") -> continue
        if authority.open_child_directory(name).is_ok() -> entries.push(dir.join(name))
    }
    ^entries
}

// Rust: Source/Store.rs:2415
pub fn gc(in_use_fingerprints: &Set<String>) -> [OSPath] {
    dir :: store_dir()
    authority :: open_directory_authority(dir).ok() ?? return []
    names :: authority.list_names().ok() ?? return []
    removed := []
    loop name in names {
        if name == OsString.from(".snapshots") -> continue
        entry :: authority.open_child_directory(name).ok() ?? continue
        dir_name :: name.to_string_lossy()
        fp :: dir_name.rsplitn(2, '-').next() ?? ""
        if !in_use_fingerprints.contains(fp) && authority.remove_child_tree(name).is_ok() {
            _ :: entry
            removed.push(dir.join(name))
        }
    }
    ^removed
}

// Rust: Source/Store.rs:2443
fn validate_store_component(value: String) -> Err! {
    components := OSPath.from(value).components()
    normal :: if components.next() == { .Val(.Normal(_)) -> true; _ -> false }
    if value.is_empty() || value == "." || value == ".." || value.contains('/') || value.contains('\\') || value.contains(':') || value.chars().any(c -> c.is_control()) || !normal || components.next().is_some() {
        return Err("the value must be one safe path component")
    }
    Ok(())
}

// Rust: Source/Store.rs:2460
fn store_path_diagnostic(value: String, reason: String) -> Diagnostic {
    Diagnostic.error("E1206", "package store path component `{value}` is not allowed", reason, "use a package name, version, and fingerprint without path separators", None)
}

