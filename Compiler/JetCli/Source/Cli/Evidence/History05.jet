fn io_error(action: String, path: OSPath, err: io.Error) -> Diagnostic {
    // GATE #4409: preserve native error kind before diagnostics format its Display.
    Diagnostic.error("E1206", "I/O error while {action} at `{path.display()}`", "a filesystem operation failed during package installation", "check permissions and disk space: {err}", None)
}

// Rust: Source/Store.rs:2482
fn invalid_path_error() -> io.Error { io.Error.new(.InvalidInput, "store entry has no parent") }

// Rust: Source/Store.rs:2489
fn missing_content_hash(pkg_name: String) -> Diagnostic {
    Diagnostic.error("E1204", "the store entry for `{pkg_name}` has no content hash", "locked package sources must carry a content hash before they are used", "run `jet fetch` to recreate the lock with verified content hashes", None)
}

// Rust: Source/Store.rs:2505
pub fn generations_log_path() -> OSPath { store_dir().join("generations.log") }

// Rust: Source/Store.rs:2511
pub struct Generation { pub number: U64, pub timestamp: String, pub entry_hash: String }

// Rust: Source/Store.rs:2519
pub fn record_generation() -> U64 {
    entries :: list_entries()
    entry_names := entries.iter().map(p -> (p.file_name().and_then(n -> n.to_str()) ?? "").to_string()).collect<[String]>()
    entry_names.sort()
    entry_list :: entry_names.join(",")
    // Rust uses DefaultHasher, despite its preceding comment saying SHA256.
    h := DefaultHasher.new()
    entry_list.hash(&h)
    entry_hash :: format("{:016x}", h.finish())
    log_path :: generations_log_path()
    existing_raw :: fs.read_to_string(log_path).unwrap_or_default()
    next_gen :: (existing_raw.lines().filter_map(l -> l.split_whitespace().next()).filter_map(n -> n.parse<U64>().ok()).max() ?? 0) + 1
    // GATE #4494: selected platform clock and append-open file handle.
    ts :: time.SystemTime.now().duration_since(time.UNIX_EPOCH).map(d -> d.as_secs().to_string()).unwrap_or_else(_ -> "0")
    line :: "{next_gen} {ts} {entry_hash}\n"
    _ :: fs.create_dir_all(store_dir())
    _ :: fs.OpenOptions.new().create(true).append(true).open(log_path).and_then(f -> f.write_all(line.as_bytes()))
    next_gen
}

// Rust: Source/Store.rs:2572
pub fn list_generations() -> [Generation] {
    raw :: fs.read_to_string(generations_log_path()).unwrap_or_default()
    generations := []
    loop line in raw.lines() {
        parts := line.split_whitespace()
        first :: parts.next() ?? continue
        number :: first.parse<U64>().ok() ?? continue
        timestamp :: parts.next() ?? continue
        entry_hash :: parts.next() ?? ""
        generations.push(Generation{number: number, timestamp: timestamp.to_string(), entry_hash: entry_hash.to_string()})
    }
    ^generations
}

// Rust: Source/Store.rs:2595
pub fn rollback_to(gen_number: U64) -> Generation Err! {
    gens :: list_generations()
    target :: gens.iter().find(g -> g.number == gen_number) ?? return Err("generation {gen_number} does not exist")
    log_path :: generations_log_path()
    next_gen :: (gens.iter().map(g -> g.number).max() ?? 0) + 1
    // GATE #4494: same native clock/append primitives as record_generation.
    ts :: time.SystemTime.now().duration_since(time.UNIX_EPOCH).map(d -> d.as_secs().to_string()).unwrap_or_else(_ -> "0")
    line :: "{next_gen} {ts} rollback-to-{gen_number}\n"
    _ :: fs.OpenOptions.new().create(true).append(true).open(log_path).and_then(f -> f.write_all(line.as_bytes()))
    Ok(~target)
}
