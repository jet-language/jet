// Rust: Source/Store.rs:1818
pub fn copy_directory_authority(source: &DirectoryAuthority, destination: &DirectoryAuthority, reject_hardlinks: Bool) -> io.Error! {
    names :: source.list_names()
    loop name in &names {
        source_file := source.open_child(name)
        metadata :: source_file.metadata()
        name_str :: name.to_str() ?? return Err(io.Error.new(.InvalidData, "package tree contains a non-UTF-8 name"))
        if metadata.is_dir() {
            if ignored_tree_name(name_str) -> continue
            child_source :: DirectoryAuthority.from_opened(source.path().join(name), ^source_file)
            child :: destination.create_child_directory(name)
            copy_directory_authority(&child_source, &child, reject_hardlinks)
        } else if metadata.is_file() {
            if reject_hardlinks && file_nlink(&metadata) > 1 {
                return Err(io.Error.new(.PermissionDenied, "refusing multiply linked source file `{source.path().join(name).display()}`"))
            }
            if ignored_tree_name(name_str) -> continue
            destination_file := destination.create_child_file(name)
            copy_open_file(&source_file, &destination_file)
            after :: source_file.metadata()
            if !same_store_file_identity(&metadata, &after) {
                return Err(io.Error.new(.Other, "package source file changed while copying `{source.path().join(name).display()}`"))
            }
        } else {
            return Err(io.Error.new(.InvalidInput, "package tree contains a special entry `{source.path().join(name).display()}`"))
        }
    }
    if names != source.list_names() {
        return Err(io.Error.new(.Other, "package source changed while copying `{source.path().display()}`"))
    }
    Ok(())
}

// Rust: Source/Store.rs:1872
pub fn link_directory_authority(source: &DirectoryAuthority, destination: &DirectoryAuthority) -> io.Error! {
    names :: source.list_names()
    loop name in &names {
        source_file := source.open_child(name)
        metadata :: source_file.metadata()
        name_str :: name.to_str() ?? return Err(io.Error.new(.InvalidData, "store entry contains a non-UTF-8 name"))
        if metadata.is_dir() {
            if ignored_tree_name(name_str) -> continue
            child_source :: DirectoryAuthority.from_opened(source.path().join(name), ^source_file)
            child :: destination.create_child_directory(name)
            link_directory_authority(&child_source, &child)
        } else if metadata.is_file() {
            if ignored_tree_name(name_str) -> continue
            // GATE #4494: hard-link from the retained source descriptor, never its path.
            if !dp_link_file(&source_file, destination.handle_ref(), name) {
                destination_file := destination.create_child_file(name)
                copy_open_file(&source_file, &destination_file)
            }
            after :: source_file.metadata()
            if !same_store_file_identity(&metadata, &after) {
                return Err(io.Error.new(.Other, "store source file changed while linking `{source.path().join(name).display()}`"))
            }
        } else {
            return Err(io.Error.new(.InvalidInput, "store entry contains a special entry `{source.path().join(name).display()}`"))
        }
    }
    if names != source.list_names() {
        return Err(io.Error.new(.Other, "store entry changed while linking `{source.path().display()}`"))
    }
    Ok(())
}

// Rust: Source/Store.rs:1921
struct SnapshotCleanup { parent: DirectoryAuthority, name: OsString }

// Rust: Source/Store.rs:1926
pub fn snapshot_directory_authority(source: &DirectoryAuthority) -> SourceSnapshot Diagnostic! {
    store :: ensure_directory_authority(store_dir()).map_err(error -> io_error("creating source snapshot store", store_dir(), error))
    snapshots :: if store.open_child_directory(OsString.from(".snapshots")) == {
        .Ok(directory) -> ^directory
        .Err(error) -> {
            if error.kind() != .NotFound -> return Err(io_error("opening source snapshot root", store.path().join(".snapshots"), error))
            store.create_child_directory(OsString.from(".snapshots")).map_err(error -> io_error("creating source snapshot root", store.path().join(".snapshots"), error))
        }
    }
    (name, stage) :: snapshots.create_private_child("source").map_err(error -> io_error("creating source snapshot", snapshots.path(), error))
    cleanup :: () -> { _ :: snapshots.remove_child_tree(name) }
    if copy_directory_authority(source, &stage, true) == {
        .Ok(_) -> {}
        .Err(error) -> {
            cleanup()
            return Err(io_error("snapshotting package source", source.path(), error))
        }
    }
    content_hash :: if hash_directory_authority(&stage, false) == {
        .Ok(hash) -> ^hash
        .Err(error) -> {
            cleanup()
            return Err(io_error("hashing source snapshot", stage.path(), error))
        }
    }
    cleanup_parent :: snapshots.try_clone().map_err(error -> io_error("retaining source snapshot authority", snapshots.path(), error))
    Ok(SourceSnapshot{path_value: ~stage.path(), cleanup: Val(SnapshotCleanup{parent: ^cleanup_parent, name: ^name}), content_hash_value: ^content_hash})
}

// Rust: Source/Store.rs:1980
pub fn store_dir() -> OSPath {
    if env.var("JET_PACKAGE_STORE_DIR") == {
        .Ok(dir) -> return OSPath.from(dir)
        .Err(_) -> {}
    }
    home :: env.var("HOME").or_else(_ -> env.var("USERPROFILE")).unwrap_or_else(_ -> ".")
    OSPath.from(home).join(".jet").join("store")
}

// Rust: Source/Store.rs:1991
pub fn store_path(name: String, version: String, fingerprint: String) -> OSPath {
    fp :: fingerprint.strip_prefix("sha256-") ?? fingerprint
    store_dir().join("{name}-{version}-{fp}")
}

// Rust: Source/Store.rs:1999
pub struct SourceSnapshot {
    path_value: OSPath
    cleanup: SnapshotCleanup?
    content_hash_value: String
    // Rust: Source/Store.rs:2006
    pub fn path(&self) -> &OSPath { &self.path_value }
    // Rust: Source/Store.rs:2010
    pub fn content_hash(&self) -> &String { &self.content_hash_value }
    // Rust: Source/Store.rs:2016
    fn drop(&self) -> {
        if self.cleanup.take() == {
            .Val(cleanup) -> { _ :: cleanup.parent.remove_child_tree(cleanup.name) }
            .None -> {}
        }
    }
}

// Rust: Source/Store.rs:2026
pub fn snapshot_tree(source_dir: OSPath) -> SourceSnapshot Diagnostic! {
    source :: open_directory_authority(source_dir).map_err(error -> io_error("checking package source", source_dir, error))
    snapshot_directory_authority(&source)
}

// Rust: Source/Store.rs:2040
pub fn ensure_path_dep(name: String, version: String, fingerprint: String, source_dir: OSPath) -> (OSPath, String) Diagnostic! {
    validate_store_component(name).map_err(reason -> store_path_diagnostic(name, reason))
    validate_store_component(version).map_err(reason -> store_path_diagnostic(version, reason))
    fp :: fingerprint.strip_prefix("sha256-") ?? fingerprint
    validate_store_component(fp).map_err(reason -> store_path_diagnostic(fp, reason))
    source :: open_directory_authority(source_dir).map_err(error -> io_error("checking package source", source_dir, error))
    dest :: store_path(name, version, fp)
    parent :: dest.parent() ?? return Err(io_error("locating store entry parent", dest, invalid_path_error()))
    parent_authority :: ensure_directory_authority(parent).map_err(error -> io_error("creating store entry parent", parent, error))
    dest_name :: dest.file_name() ?? return Err(io_error("locating store entry", dest, invalid_path_error()))
    if parent_authority.open_child_directory(dest_name) == {
        .Ok(existing) -> {
            hash :: hash_directory_authority(&existing, false).map_err(error -> io_error("hashing store entry", dest, error))
            return Ok((dest, hash))
        }
        .Err(error) -> { if error.kind() != .NotFound -> return Err(io_error("checking store entry", dest, error)) }
    }
    (staging_name, staging) :: parent_authority.create_private_child("entry").map_err(error -> io_error("creating store staging entry", parent, error))
    result :: (() -> String Diagnostic! {
        copy_directory_authority(&source, &staging, true).map_err(error -> io_error("copying to store", dest, error))
        hash :: hash_directory_authority(&staging, false).map_err(error -> io_error("hashing store entry", dest, error))
        if publish_directory(&parent_authority, staging_name, &parent_authority, dest_name) == {
            .Ok(_) -> Ok(hash)
            .Err(error) -> {
                if error.kind() != .AlreadyExists -> return Err(io_error("publishing store entry", dest, error))
                winner :: parent_authority.open_child_directory(dest_name).map_err(error -> io_error("opening concurrent store entry", dest, error))
                winner_hash :: hash_directory_authority(&winner, false).map_err(error -> io_error("hashing concurrent store entry", dest, error))
                if winner_hash == hash -> Ok(winner_hash)
                else -> Err(io_error("publishing store entry", dest, io.Error.new(.AlreadyExists, "concurrent store entry has different contents")))
            }
        }
    })()
    _ :: parent_authority.remove_child_tree(staging_name)
    Ok((dest, result?))
}

// Rust: Source/Store.rs:2112
pub fn verify_content_hash(pkg_name: String, store_entry: OSPath, expected_content_hash: String) -> Diagnostic! {
    entry :: if open_directory_authority(store_entry) == {
        .Ok(entry) -> ^entry
        .Err(error) -> {
            if error.kind() == .NotFound {
                return Err(Diagnostic.error("E1204", "the store entry for `{pkg_name}` is missing", "a package source tree must be present in the store", "run `jet fetch` to re-download the package", None))
            }
            return Err(io_error("checking store entry", store_entry, error))
        }
    }
    if expected_content_hash.is_empty() -> return Err(missing_content_hash(pkg_name))
    actual :: hash_directory_authority(&entry, false).map_err(error -> io_error("hashing store entry", store_entry, error))
    if actual != expected_content_hash {
        return Err(Diagnostic.error("E1204", "the store entry for `{pkg_name}` has been modified", "expected content hash `{expected_content_hash}` but got `{actual}`", "delete the store entry and run `jet fetch` to re-install", None))
    }
    Ok(())
}

// Rust: Source/Store.rs:2152
pub fn ensure_git_dep(name: String, version: String, fingerprint: String, git_dir: OSPath) -> (OSPath, String) Diagnostic! {
    ensure_path_dep(name, version, fingerprint, git_dir)
}

// Rust: Source/Store.rs:2163
pub fn link_into_project(store_entry: OSPath, link_root: OSPath) -> Diagnostic! {
    source :: open_directory_authority(store_entry).map_err(error -> io_error("checking store entry", store_entry, error))
    expected :: hash_directory_authority(&source, false).map_err(error -> io_error("hashing store entry", store_entry, error))
    parent :: link_root.parent() ?? return Err(io_error("locating dep link parent", link_root, invalid_path_error()))
    parent_authority :: ensure_directory_authority(parent).map_err(error -> io_error("creating dep link parent", parent, error))
    link_name :: link_root.file_name() ?? return Err(io_error("locating dep link", link_root, invalid_path_error()))
    if parent_authority.open_child_directory(link_name) == {
        .Ok(existing) -> {
            actual :: hash_directory_authority(&existing, false).map_err(error -> io_error("hashing dependency link", link_root, error))
            if actual != expected {
                return Err(io_error("checking dependency link", link_root, io.Error.new(.InvalidData, "existing dependency link does not match its immutable store entry")))
            }
            return Ok(())
        }
        .Err(error) -> { if error.kind() != .NotFound -> return Err(io_error("checking dependency link", link_root, error)) }
    }
    (staging_name, staging) :: parent_authority.create_private_child("dep-link").map_err(error -> io_error("creating dep link staging dir", parent, error))
    result :: (() -> Diagnostic! {
        link_directory_authority(&source, &staging).map_err(error -> io_error("linking dependency tree", link_root, error))
        actual :: hash_directory_authority(&staging, false).map_err(error -> io_error("hashing staged dependency link", link_root, error))
        if actual != expected {
            return Err(io_error("checking staged dependency link", link_root, io.Error.new(.InvalidData, "staged dependency link does not match its immutable store entry")))
        }
        if publish_directory(&parent_authority, staging_name, &parent_authority, link_name) == {
            .Ok(_) -> Ok(())
            .Err(error) -> {
                if error.kind() != .AlreadyExists -> return Err(io_error("publishing dependency link", link_root, error))
                winner :: parent_authority.open_child_directory(link_name).map_err(error -> io_error("opening concurrent dependency link", link_root, error))
                winner_hash :: hash_directory_authority(&winner, false).map_err(error -> io_error("hashing concurrent dependency link", link_root, error))
                if winner_hash == expected -> Ok(())
                else -> Err(io_error("publishing dependency link", link_root, io.Error.new(.AlreadyExists, "concurrent dependency link has different contents")))
            }
        }
    })()
    _ :: parent_authority.remove_child_tree(staging_name)
    result
}

