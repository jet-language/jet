// Rust: Source/CmdBudget.rs:1808
fn dev_owned(spec: &BudgetSpec) -> Bool {
    ((provider_kind(spec.provider) == "ServiceProbe" || provider_kind(spec.provider) == "SceneProbe") && (spec.scope.starts_with("Service(") || spec.scope.starts_with("Scene("))) || provider_kind(spec.provider) == "CompilerProbe"
}
// Rust: Source/CmdBudget.rs:1814
fn bench_measurement_provider(request: &ProviderRequest, _: &ProviderCancellation) -> [ProviderEvent] ProviderFailure! {
    workload :: if request.workload == .Object(value) -> value else -> return Err(ProviderFailure.malformed("BenchMeasurement workload is not an object"))
    path :: if workload.get("path") == .Val(.String(value)) -> value else -> return Err(ProviderFailure.malformed("BenchMeasurement workload has no source path"))
    name :: if workload.get("name") == .Val(.String(value)) -> value else -> return Err(ProviderFailure.malformed("BenchMeasurement workload has no benchmark name"))
    source :: fs.read_to_string(OSPath.from(path)) ?? return Err(ProviderFailure.malformed("cannot read benchmark source: {err}"))
    mode :: OutputMode{json: false, color: ColorChoice.Never, quiet: false}
    evidence :: collect_measure_evidence(path, source, mode, Val(name))
    bench :: evidence.find((bench) -> bench.name == name) ?? return Err(ProviderFailure.malformed("measured claim `{name}` was not emitted by `jet test --measure"))
    events := [ProviderEvent]{}
    loop (index, spec) in request.specs {
        if !spec.metric.starts_with("BenchTime(") -> return Err(ProviderFailure.malformed("BenchMeasurement does not support metric `{spec.metric}`"))
        loop (elapsed, iters) in bench.samples {
            value :: Rational.parse(elapsed.to_string(), iters.to_string()) ?? return Err(ProviderFailure.malformed(err))
            &events.push(ProviderEvent.Sample{spec: index as U32, metric: spec.metric, value: value})
        }
    }
    samples :: events.len() as U64
    &events.push(ProviderEvent.Complete{request_id: request.request_id, samples: samples})
    Ok(^events)
}
// Rust: Source/CmdBudget.rs:1876
fn allocation_probe_provider(request: &ProviderRequest, _: &ProviderCancellation) -> [ProviderEvent] ProviderFailure! {
    workload :: if request.workload == .Object(value) -> value else -> return Err(ProviderFailure.malformed("AllocationProbe workload is not an object"))
    path :: if workload.get("path") == .Val(.String(value)) -> value else -> return Err(ProviderFailure.malformed("AllocationProbe workload has no source path"))
    name :: if workload.get("name") == .Val(.String(value)) -> value else -> return Err(ProviderFailure.malformed("AllocationProbe workload has no benchmark name"))
    source :: fs.read_to_string(OSPath.from(path)) ?? return Err(ProviderFailure.malformed("cannot read allocation workload source: {err}"))
    mode :: OutputMode{json: false, color: ColorChoice.Never, quiet: false}
    evidence :: collect_measure_evidence(path, source, mode, Val(name))
    bench :: evidence.find((bench) -> bench.name == name) ?? return Err(ProviderFailure.malformed("measured claim `{name}` was not emitted by its selected allocation workload"))
    if bench.allocation_samples.len() != 20 -> return Err(ProviderFailure.malformed("AllocationProbe `{name}` emitted {bench.allocation_samples.len()} trials; policy requires 20"))
    events := [ProviderEvent]{}
    loop (index, spec) in request.specs {
        if spec.metric != "AllocationCount" && spec.metric != "AllocationBytes" -> return Err(ProviderFailure.malformed("AllocationProbe does not support metric `{spec.metric}`"))
        loop (count, bytes, iters) in bench.allocation_samples {
            numerator :: if spec.metric == "AllocationCount" -> count else -> bytes
            value :: Rational.parse(numerator.to_string(), iters.to_string()) ?? return Err(ProviderFailure.malformed(err))
            &events.push(ProviderEvent.Sample{spec: index as U32, metric: spec.metric, value: value})
        }
    }
    samples :: events.len() as U64
    &events.push(ProviderEvent.Complete{request_id: request.request_id, samples: samples})
    Ok(^events)
}
// Rust: Source/CmdBudget.rs:1949
fn service_probe_provider(request: &ProviderRequest, _: &ProviderCancellation) -> [ProviderEvent] ProviderFailure! {
    // Evidence is supplied by run_dev_refresh/build_report. Bare budget check has no readiness evidence.
    events := [ProviderEvent]{}
    loop (index, spec) in request.specs {
        if spec.metric != "ServiceReadiness" -> return Err(ProviderFailure.malformed("ServiceProbe does not support metric `{spec.metric}`"))
        &events.push(ProviderEvent.Unavailable{spec: index as U32, reason: "ServiceProbe requires `jet dev` to collect readiness evidence; run `jet dev <file>` to refresh", details: []})
    }
    &events.push(ProviderEvent.Complete{request_id: request.request_id, samples: 0 as U64})
    Ok(^events)
}
// Rust: Source/CmdBudget.rs:1975
fn scene_probe_provider(request: &ProviderRequest, _: &ProviderCancellation) -> [ProviderEvent] ProviderFailure! {
    // Evidence is supplied by run_dev_refresh/build_report, not the bare check invocation.
    events := [ProviderEvent]{}
    loop (index, spec) in request.specs {
        metric :: spec.metric.split("(").first().unwrap_or(spec.metric)
        if metric != "FrameTime" && metric != "DrawCalls" && metric != "SceneAssetBytes" && metric != "MemoryHighWater" -> return Err(ProviderFailure.malformed("SceneProbe does not support metric `{spec.metric}`"))
        &events.push(ProviderEvent.Unavailable{spec: index as U32, reason: "SceneProbe requires `jet dev` to collect scene evidence; run `jet dev <file>` to refresh", details: []})
    }
    &events.push(ProviderEvent.Complete{request_id: request.request_id, samples: 0 as U64})
    Ok(^events)
}
// Rust: Source/CmdBudget.rs:2003
fn measurement_base(root: &OSPath, bundle: &ProgramBundle, spec: &BudgetSpec, _subject: &CanonicalJson, tool: &CanonicalJson, provider: &CanonicalJson, target: String, profile: String) -> (CanonicalJson, String, String) Err! {
    metric_name :: spec.metric.split("(").first().unwrap_or(spec.metric)
    percentile :: metric_percentile(spec.metric).map((value) -> CanonicalJson.String(value)).unwrap_or(CanonicalJson.Null)
    metric :: CanonicalJson.object([("name", CanonicalJson.String(metric_name)), ("percentile", percentile)])?
    comparison :: comparison_json(spec)?
    direction :: if metric_name == "Throughput" -> "higher_is_better" else -> "lower_is_better"
    applies :: CanonicalJson.object([("profiles", CanonicalJson.Array(axis(spec.applicability.profiles, profile))), ("targets", CanonicalJson.Array(axis(spec.applicability.targets, target)))])?
    kind :: provider_kind(spec.provider)
    identity :: provider_identity(spec.provider)
    budget_spec :: CanonicalJson.object([
        ("applies", applies), ("comparison", comparison),
        ("enforcement", CanonicalJson.String(spec.enforcement.to_ascii_lowercase())),
        ("metric", metric), ("name", CanonicalJson.String(spec.name)),
        ("package_id", CanonicalJson.String(package_name(root))), ("perf_role", CanonicalJson.String(spec.role)),
        ("provider", CanonicalJson.object([("identity", CanonicalJson.String(identity)), ("kind", CanonicalJson.String(kind))])?),
        ("scope", CanonicalJson.String(spec.scope))
    ])?
    hash :: stable_id(budget_spec)
    fingerprint :: text_field(provider, "hardware_fingerprint")?
    framed := ("jet-budget-context-v1" + TEXT_NUL).bytes().to_vec()
    // GATE #4483: architecture comes from selected-target facts.
    loop value in ["package", metric_name, metric_percentile(spec.metric).unwrap_or(""), target, core.sys.target.selected_arch(), profile, JET_VERSION,
        text_field(tool, "compiler_build_id")?, text_field(tool, "stdlib_id")?, text_field(tool, "runner_id")?, text_field(tool, "digest")?, kind, identity,
        text_field(provider, "version")?, text_field(provider, "isolation")?, text_field(provider, "cpu_arch")?, text_field(provider, "cpu_model")?,
        wire_map(as_object(provider)?, "logical_cpus")?, wire_map(as_object(provider)?, "memory_bytes")?, text_field(provider, "os")?,
        text_field(provider, "kernel")?, text_field(provider, "power_governor")?, fingerprint] { frame(&framed, value) }
    context :: sha256_hex(framed)
    (source, line, _) :: source_location(root, bundle, spec)
    base :: CanonicalJson.object([
        ("baseline", CanonicalJson.Null), ("budget_id", CanonicalJson.String("{spec.role}:{spec.name}")),
        ("budget_spec", budget_spec), ("budget_spec_sha256", CanonicalJson.String(hash)), ("comparison", comparison),
        ("context_key", CanonicalJson.String(context)), ("decision", CanonicalJson.Null), ("direction", CanonicalJson.String(direction)),
        ("enforcement", CanonicalJson.String(spec.enforcement.to_ascii_lowercase())), ("history", CanonicalJson.Null), ("metric", metric),
        ("policy", if spec.comparison_fact.kind == "Absolute" -> CanonicalJson.Null else -> policy_json()),
        ("provider", provider), ("samples", CanonicalJson.Array([CanonicalJson.Integer("0")])),
        ("source", CanonicalJson.String("{source}:{line}")), ("statistics", CanonicalJson.Null),
        ("target_class", CanonicalJson.String(target)), ("unit", CanonicalJson.String(metric_unit(spec.metric)))
    ])?
    Ok((^base, ^hash, ^context))
}
// Rust: Source/CmdBudget.rs:2145
fn measurement_base_truthful(root: &OSPath, bundle: &ProgramBundle, located: &LocatedBudgetSpec, subject: &CanonicalJson, tool: &CanonicalJson, provider: &CanonicalJson, target: String, profile: String) -> (CanonicalJson, String, String) Err! {
    spec :: located.spec
    (base, hash, _) :: measurement_base(root, bundle, spec, subject, tool, provider, target, profile)?
    metric_name :: spec.metric.split("(").first().unwrap_or(spec.metric)
    context :: context_key(subject, tool, provider, metric_name, metric_percentile(spec.metric))?
    object := as_object(base)?.clone()
    object["context_key"] = CanonicalJson.String(context)
    (source, line, _) :: source_location(root, bundle, located)
    object["source"] = CanonicalJson.String("{source}:{line}")
    Ok((CanonicalJson.Object(^object), ^hash, ^context))
}
// Rust: Source/CmdBudget.rs:2176
fn context_key(subject: &CanonicalJson, tool: &CanonicalJson, provider: &CanonicalJson, metric: String, percentile: String?) -> String Err! {
    subject :: as_object(subject)?
    tool :: as_object(tool)?
    provider :: as_object(provider)?
    input := ("jet-budget-context-v1" + TEXT_NUL).bytes().to_vec()
    loop value in [text_map(subject, "target_id")?, metric, percentile.unwrap_or(""), text_map(subject, "target_class")?, text_map(subject, "target_triple")?, text_map(subject, "profile")?] { frame(&input, value) }
    loop key in ["jet_version", "compiler_build_id", "stdlib_id", "runner_id", "digest"] { frame(&input, text_map(tool, key)?) }
    loop key in ["kind", "identity", "version", "isolation", "cpu_arch", "cpu_model", "logical_cpus", "memory_bytes", "os", "kernel", "power_governor", "hardware_fingerprint"] { frame(&input, wire_map(provider, key)?) }
    Ok(sha256_hex(input))
}
// Rust: Source/CmdBudget.rs:2225
fn compiler_fact(bundle: &ProgramBundle, effect_facts: &SemIndexEffectFacts, spec: &BudgetSpec) -> U128 Err! {
    if spec.metric == {
        "PublicApiItems" -> {
            count := 0 as U128
            loop (module_idx, module) in bundle.modules {
                loop item in module.items {
                    public :: if item == {
                        .Func(v) | .Struct(v) | .Enum(v) | .Trait(v) | .CodeModule(v) -> effect_facts.name_ledger.public(module_idx, v.name)
                        else -> false
                    }
                    if public -> count += 1
                }
            }
            Ok(count)
        }
        "DependencyCount" -> Ok(bundle.dep_roots.len() as U128)
        "EffectCount" -> {
            // GATE #4499: native effect identity is the map key; no string encoding.
            effects := [Effect:Bool]{}
            loop (_, set) in effect_facts.solved { loop effect in set { effects[effect] = true } }
            Ok(effects.len() as U128)
        }
        "GeneratedUnsafe" -> Err("CompilerFacts metric `GeneratedUnsafe` has no exact checked front-end fact; refusing proxy measurement")
        else -> {
            if spec.metric.starts_with("CompileTime") -> return Err("CompilerFacts metric `CompileTime` is unsupported; use the typed CompilerProbe provider")
            Err("CompilerFacts metric `{spec.metric}` is not implemented")
        }
    }
}
// Rust: Source/CmdBudget.rs:2232
fn provider_kind(provider: String) -> String { provider.split_once("(").map((pair) -> pair.0).unwrap_or(provider) }
// Rust: Source/CmdBudget.rs:2238
fn provider_identity(provider: String) -> String { provider.split_once("(").and_then((pair) -> pair.1.strip_suffix(")")).unwrap_or("") }
// Rust: Source/CmdBudget.rs:2244
fn metric_unit(metric: String) -> String {
    if metric.split("(").first().unwrap_or(metric) == {
        "BinarySize" | "ArtifactSize" -> "Bytes"
        "StartupTime" | "FrameTime" | "Latency" | "BenchTime" | "ServiceReadiness" | "CompileTime" -> "Duration"
        "MemoryHighWater" | "AllocationBytes" | "SceneAssetBytes" -> "Bytes"
        "Throughput" -> "Rate"
        else -> "Count"
    }
}
// Rust: Source/CmdBudget.rs:2254
fn build_selected_artifact(root: &OSPath, entry: &OSPath) -> (OSPath, U64, String) Err! {
    executable :: running_executable() ?? return Err("cannot identify compiler for BuildArtifact: {err}")
    // GATE #4494: real native child process, group ownership, supervision and clock.
    command := Command.new(executable)
    &command.arg("build").arg(entry).current_dir(root).stdin(Stdio.null()).stdout(Stdio.null()).stderr(Stdio.null())
    if core.sys.target.selected_family() == "unix" { &command.process_group(0) }
    child := command.spawn() ?? return Err("cannot start selected artifact build: {err}")
    deadline :: Instant.now() + SELECTED_BUILD_DEADLINE
    loop {
        status :: child.try_wait() ?? {
            terminate_group(&child)
            return Err("cannot supervise selected artifact build: {err}")
        }
        if status == {
            .Val(status) -> {
                if status.success() -> break
                terminate_group(&child)
                return Err("selected artifact build exited with {status}")
            }
            .None -> {
                if Instant.now() < deadline { std.thread.sleep(Duration.from_millis(5)) }
                else {
                    terminate_group(&child)
                    return Err("selected artifact build exceeded 120 second build deadline")
                }
            }
        }
    }
    stem :: entry.file_stem().and_then((value) -> value.to_str()) ?? return Err("selected artifact entry has no UTF-8 stem")
    artifact :: root.join(".jet").join("build").join(if core.sys.target.selected_os() == "windows" -> "{stem}.exe" else -> stem)
    metadata :: fs.symlink_metadata(artifact) ?? return Err("selected artifact was not produced: {err}")
    if metadata.file_type().is_symlink() || !metadata.is_file() -> return Err("selected artifact is not a regular file")
    digest :: sha256_file_hex(artifact) ?? return Err("cannot hash selected artifact: {err}")
    Ok((artifact, metadata.len(), digest))
}
// Rust: Source/CmdBudget.rs:2313
fn quantity(value: &BudgetQuantity) -> Rational Err! {
    if value == {
        .Count(v) | .Bytes(v) | .DurationNs(v) -> Rational.parse(v.to_string(), "1")
        .Rate(numerator, denominator_ns) -> Rational.parse(numerator.to_string(), denominator_ns.to_string())
        .PercentBasisPoints(_) -> Err("absolute budget cannot use a relative percent limit")
    }
}
// Rust: Source/CmdBudget.rs:2327
fn metric_percentile(metric: String) -> String? {
    raw :: metric.split_once("(")?.1.strip_suffix(")")?
    if raw == { "P50" -> Val("p50"), "P90" -> Val("p90"), "P95" -> Val("p95"), "P99" -> Val("p99"), "P999" -> Val("p999"), else -> None }
}
// Rust: Source/CmdBudget.rs:2338
fn percentile(metric: String) -> Percentile? {
    if metric_percentile(metric) == { .Val("p50") -> Val(Percentile.P50), .Val("p90") -> Val(Percentile.P90), .Val("p95") -> Val(Percentile.P95), .Val("p99") -> Val(Percentile.P99), .Val("p999") -> Val(Percentile.P999), else -> None }
}
// Rust: Source/CmdBudget.rs:2348
fn comparison_json(spec: &BudgetSpec) -> CanonicalJson Err! {
    direction :: if spec.limit_fact.kind == "AtLeast" -> "at_least" else -> "at_most"
    if spec.comparison_fact.kind == {
        "Absolute" -> CanonicalJson.object([("direction", CanonicalJson.String(direction)), ("kind", CanonicalJson.String("absolute")), ("limit", quantity(spec.limit_fact.quantity)?.to_json())])
        "AbsoluteFrom" -> CanonicalJson.object([
            ("baseline", CanonicalJson.String(spec.comparison_fact.baseline ?? return Err("AbsoluteFrom baseline is absent"))),
            ("direction", CanonicalJson.String(direction)), ("kind", CanonicalJson.String("absolute_from")), ("limit", quantity(spec.limit_fact.quantity)?.to_json())
        ])
        "RelativeTo" -> {
            value :: if spec.limit_fact.quantity == .PercentBasisPoints(value) -> value else -> return Err("RelativeTo requires a basis-point limit")
            improvement :: spec.limit_fact.kind == "ImprovementAtLeast"
            CanonicalJson.object([
                ("baseline", CanonicalJson.String(spec.comparison_fact.baseline ?? return Err("RelativeTo baseline is absent"))),
                ("direction", CanonicalJson.String(if spec.metric.starts_with("Throughput") -> "higher_is_better" else -> "lower_is_better")),
                ("goal", CanonicalJson.String(if improvement -> "improvement_at_least" else -> "regression_at_most")),
                ("kind", CanonicalJson.String("relative_to")), ("limit_basis_points", CanonicalJson.Integer(value.to_string()))
            ])
        }
        else -> Err("unknown budget comparison `{spec.comparison_fact.kind}`")
    }
}
// Rust: Source/CmdBudget.rs:2421
fn comparison_model(spec: &BudgetSpec) -> Comparison Err! {
    direction :: if spec.limit_fact.kind == "AtLeast" -> LimitDirection.AtLeast else -> LimitDirection.AtMost
    if spec.comparison_fact.kind == {
        "Absolute" -> Ok(Comparison.Absolute{limit: quantity(spec.limit_fact.quantity)?, direction: direction})
        "AbsoluteFrom" -> Ok(Comparison.AbsoluteFrom{limit: quantity(spec.limit_fact.quantity)?, direction: direction})
        "RelativeTo" -> {
            raw :: if spec.limit_fact.quantity == .PercentBasisPoints(value) -> value else -> return Err("RelativeTo requires a basis-point limit")
            value :: I128.try_from(raw) ?? return Err("relative basis-point limit exceeds evaluator range")
            Ok(Comparison.RelativeTo{limit_basis_points: BigInt.from_i128(value), goal: if spec.limit_fact.kind == "ImprovementAtLeast" -> RelativeGoal.ImprovementAtLeast else -> RelativeGoal.RegressionAtMost})
        }
        else -> Err("unknown budget comparison `{spec.comparison_fact.kind}`")
    }
}
