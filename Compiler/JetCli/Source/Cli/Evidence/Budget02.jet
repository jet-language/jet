fn subject(root: &OSPath, bundle: &ProgramBundle, start: String, end: String, target: String, profile: String, artifact: &(OSPath, U64, String)?) -> CanonicalJson Err! {
    sources := [(String, String)]{}
    loop module in bundle.modules {
        path :: module.path.strip_prefix(root).unwrap_or(module.path).to_string_lossy().replace("\\", "/")
        &sources.push((path, sha256_hex(module.source.bytes())))
    }
    &sources.sort()
    artifact :: artifact.map((value) -> CanonicalJson.object([("bytes", CanonicalJson.Integer(value.1.to_string())), ("sha256", CanonicalJson.String(value.2))]).unwrap()).unwrap_or(CanonicalJson.Null)
    CanonicalJson.object([("artifact", artifact), ("measured_end", CanonicalJson.String(end)), ("measured_start", CanonicalJson.String(start)),
        ("member_sources", CanonicalJson.Array(sources.map((pair) -> CanonicalJson.object([("path", CanonicalJson.String(pair.0)), ("sha256", CanonicalJson.String(pair.1))]).unwrap()))),
        ("profile", CanonicalJson.String(profile)), ("target_class", CanonicalJson.String(target)), ("target_id", CanonicalJson.String(package_name(root))), ("target_triple", CanonicalJson.String(host_triple()?))])
}
