}
// Rust: Source/CmdBudget.rs:2528
fn report_wrapper(evidence_id: String, measurements: [CanonicalJson], subject: CanonicalJson, tool: CanonicalJson, privacy: CanonicalJson, pass: Int, warn: Int, fail: Int) -> CanonicalJson Err! {
    overall :: if fail > 0 -> "fail" else if warn > 0 -> "warn" else -> "pass"
    content :: CanonicalJson.object([("evidence_id", CanonicalJson.String(evidence_id)), ("measurements", CanonicalJson.Array(^measurements)), ("privacy", ^privacy), ("subject", ^subject),
        ("summary", CanonicalJson.object([("fail", CanonicalJson.Integer(fail.to_string())), ("outcome", CanonicalJson.String(overall)), ("pass", CanonicalJson.Integer(pass.to_string())), ("warn", CanonicalJson.Integer(warn.to_string()))])?), ("toolchain", ^tool)])?
    id :: stable_id(content)
    CanonicalJson.object([("content", ^content), ("report_id", CanonicalJson.String(id)), ("schema", CanonicalJson.String("jet.budget-report")), ("version", CanonicalJson.Integer("1"))])
}
// Rust: Source/CmdBudget.rs:2575
fn trend_json(ids: &[String], samples: &[[Rational]], percentile: Percentile?, direction: Direction) -> CanonicalJson Err! {
    pairs := [(String, Rational)]{}
    loop index in 0..<ids.len().min(samples.len()) { &pairs.push((ids[index], estimator(samples[index], percentile)?)) }
    &pairs.reverse()
    ids :: pairs.map((pair) -> pair.0)
    estimators :: pairs.map((pair) -> pair.1)
    value :: evaluate_trend(ids, estimators, direction)?
    label :: if value.label == { .Improving -> "improving", .Stable -> "stable", .Regressing -> "regressing", .Insufficient -> "insufficient" }
    CanonicalJson.object([("estimators", CanonicalJson.Array(value.estimators.map((value) -> value.to_json()))), ("label", CanonicalJson.String(label)),
        ("report_ids", CanonicalJson.Array(value.report_ids.map((id) -> CanonicalJson.String(id)))), ("score", value.score.map((score) -> score.to_json()).unwrap_or(CanonicalJson.Null))])
}
// Rust: Source/CmdBudget.rs:2623
fn applicable(spec: &BudgetSpec, target: String, profile: String) -> Bool {
    // Rust: Source/CmdBudget.rs:2624
    fn one(axis: &BudgetAxis, current: String) -> Bool {
        if axis == { .Current | .All -> true, .Only(values) -> values.any((v) -> v.eq_ignore_ascii_case(current) || v.contains(title(current))) }
    }
    one(spec.applicability.targets, target) && one(spec.applicability.profiles, profile)
}
// Rust: Source/CmdBudget.rs:2634
fn axis(axis: &BudgetAxis, current: String) -> [CanonicalJson] {
    if axis == { .Current -> [CanonicalJson.String(current)], .All -> [CanonicalJson.String("all")], .Only(values) -> values.map((value) -> CanonicalJson.String(value)) }
}
// Rust: Source/CmdBudget.rs:2641
fn title(s: String) -> String {
    chars := s.chars()
    chars.next().map((first) -> first.to_ascii_uppercase().to_string() + chars.as_str()).unwrap_or("")
}
// Rust: Source/CmdBudget.rs:2647
fn project_entry(root: &OSPath) -> OSPath { find_project_entry(root) }
// Rust: Source/CmdBudget.rs:2650
fn package_name(root: &OSPath) -> String {
    entry :: project_entry(root)
    if jet.Loader.package_facts_for_entry(entry) == { .Ok(.Val(facts)) -> return facts.name, .Ok(.None) -> {}, .Err(_) -> return "package" }
    jet.Package.PackageFacts.load(root).and_then((result) -> result.ok()).map((facts) -> facts.name).unwrap_or("package")
}
