fn result_rank(row: &ResultRow) -> U8 {
    if (row.outcome, row.evidence, row.stale) == {
        (.Fail, .Regression | .Inconclusive, _) -> 1
        (.Fail, .Unavailable, false) -> 2
        (.Fail, _, true) -> 3
        (.Warn, _, _) -> 4
        else -> 5
    }
}
// Rust: Source/CmdBudget.rs:3007
fn output_counts(built: &BuiltReport) -> (Int, Int, Int, Int, Int) {
    counts := (0, 0, 0, 0, 0)
    loop row in built.results {
        if result_rank(row) == { 1 -> counts.0 += 1, 2 -> counts.1 += 1, 3 -> counts.2 += 1, 4 -> counts.3 += 1, else -> counts.4 += 1 }
    }
    counts
}
// Rust: Source/CmdBudget.rs:3020
fn diagnostic_parts(row: &ResultRow) -> (String, String, String) {
    if row.evidence == Evidence.Unavailable -> ("E2906", "performance budget {row.name} has no usable evidence", "correct the provider evidence or bootstrap only when absent or stale evidence is eligible")
    else -> ("E2907", "performance budget {row.name} {if row.evidence == Evidence.Inconclusive -> \"is inconclusive\" else -> \"regressed\"}", "improve the measured behavior, inspect `jet budget check --verbose`, or record an explicit exception")
}
// Rust: Source/CmdBudget.rs:3027
fn emit_check(options: &Options, built: &BuiltReport, id: String, path: String, created: Bool) {
    if options.json { emit_json(options, built, path, None, false, if built.fail > 0 -> 1 else -> 0, None); return }
    loop row in built.results {
        if row.outcome == PolicyOutcome.Pass {
            if options.verbose { emit_verbose_row(row) }
            next
        }
        (code, message, fix) :: diagnostic_parts(row)
        severity :: if row.outcome == PolicyOutcome.Warn -> "Warning" else -> "Error"
        eprintln("{severity} [{code}]: {message}\n --> {row.source}:{row.line}:{row.column}\n Why: {row.reason}\n Fix: {fix}\nMore: jet-lang.dev/e/{code}")
        emit_annotation(options, severity, code, row, message, fix)
        if options.verbose { emit_verbose_row(row) }
    }
    if options.verbose {
        marker :: if created -> "+" else -> "~"
        suffix :: if created -> "" else -> " (verified reuse)"
        eprintln("{marker} report {id} {path}{suffix}")
    }
    // Quiet suppresses only the recap, never per-row diagnostics.
    if options.quiet -> return
    short :: id.slice(0, 12)
    (failed, unavailable, stale, warn, passed) :: output_counts(built)
    warning :: if warn > 0 -> " · {count(warn, \"warning\", \"warnings\")}" else -> ""
    if failed > 0 { eprintln("budgets failed: {count(failed, \"budget failed\", \"budgets failed\")}{warning} · report {short}") }
    else if unavailable > 0 { eprintln("budgets unavailable: {count(unavailable, \"result unavailable\", \"results unavailable\")}{warning} · report {short}") }
    else if stale > 0 { eprintln("budgets stale: {count(stale, \"baseline stale\", \"baselines stale\")}{warning} · report {short}") }
    else if warn > 0 {
        prefix :: if passed > 0 -> "{count(passed, \"budget\", \"budgets\")} passed · " else -> ""
        eprintln("budgets: {prefix}{count(warn, \"warning\", \"warnings\")} · report {short}")
    } else { eprintln("budgets: {count(passed, \"budget\", \"budgets\")} passed · report {short}") }
}
// Rust: Source/CmdBudget.rs:3130
fn emit_verbose_row(row: &ResultRow) {
    ids :: if row.baseline_report_ids.is_empty() -> "none" else -> row.baseline_report_ids.join(",")
    bound :: (value: Rational?) -> value.map((value) -> "{value.num}/{value.den}").unwrap_or("none")
    outcome :: if row.outcome == PolicyOutcome.Pass -> "pass" else if row.outcome == PolicyOutcome.Warn -> "warn" else -> "fail"
    eprintln("{outcome} {row.id}: point {row.sample.num}/{row.sample.den} · bounds [{bound(row.lower95)}, {bound(row.upper95)}] · baseline [{ids}] · {row.metric_label} · {row.reason}")
}
// Rust: Source/CmdBudget.rs:3161
fn emit_annotation(options: &Options, severity: String, code: String, row: &ResultRow, message: String, fix: String) {
    enabled :: options.annotations == Annotations.Github || (options.annotations == Annotations.Auto && std.env.var("GITHUB_ACTIONS").ok() == Val("true"))
    if !enabled -> return
    level :: if severity == "Warning" -> "warning" else -> "error"
    property :: (v: String) -> v.replace("%", "%25").replace("\r", "%0D").replace("\n", "%0A").replace(":", "%3A").replace(",", "%2C")
    message :: "{message}\nWhy: {row.reason}\nFix: {fix}".replace("%", "%25").replace("\r", "%0D").replace("\n", "%0A")
    eprintln("::{level} file={property(row.source)},line={row.line},col={row.column},title={property(\"Jet {code}\")}::{message}")
}
// Rust: Source/CmdBudget.rs:3199
fn emit_json(options: &Options, built: &BuiltReport, path: String, plan: (String, String?, Bool)?, applied: Bool, exit: I32, diagnostic: CanonicalJson?) {
    (failed, unavailable, stale, warn, _) :: output_counts(built)
    failure_kind :: if failed > 0 -> Val("budget") else if unavailable > 0 || stale > 0 -> Val("evidence") else -> None
    results :: built.results.map((row) -> result_json(row))
    plan :: plan.map((plan) -> {
        (baseline, old, created) :: plan
        id :: text_field(built.value, "report_id").unwrap()
        CanonicalJson.object([("baseline", CanonicalJson.String(baseline)), ("requires_confirmation", CanonicalJson.Bool(false)),
            ("rows", CanonicalJson.Array([plan_row(if created -> "create" else -> "reuse", "report", path, None, id), plan_row("advance", "baseline", ".jet/perf/baselines/names/{baseline}.json", old, id)]))]).unwrap()
    }).unwrap_or(CanonicalJson.Null)
    diagnostics :: diagnostic.map((value) -> [value]).unwrap_or([])
    value :: CanonicalJson.object([("applied", CanonicalJson.Bool(applied)), ("diagnostics", CanonicalJson.Array(diagnostics)), ("exit_code", CanonicalJson.Integer(exit.to_string())),
        ("failure_kind", failure_kind.map((value) -> CanonicalJson.String(value)).unwrap_or(CanonicalJson.Null)), ("plan", plan), ("report", built.value),
        ("report_path", CanonicalJson.String(path)), ("results", CanonicalJson.Array(results))]).unwrap()
    budget :: status_value(value)
    print(StatusEnvelope.new(options.command, exit == 0).with_field("budget", budget).json())
}
// Rust: Source/CmdBudget.rs:3276
fn result_json(row: &ResultRow) -> CanonicalJson {
    evidence :: if row.evidence == { .Pass -> "pass", .Regression -> "regression", .Inconclusive -> "inconclusive", .Unavailable -> "unavailable" }
    status :: if row.stale && row.outcome == PolicyOutcome.Fail -> "stale"
        else if row.evidence == Evidence.Unavailable && row.outcome == PolicyOutcome.Fail -> "unavailable"
        else -> if row.outcome == { .Pass -> "pass", .Warn -> "warn", .Fail -> "fail" }
    diagnostic :: if row.outcome == PolicyOutcome.Pass -> CanonicalJson.Null else -> CanonicalJson.String(if row.evidence == Evidence.Unavailable -> "E2906" else -> "E2907")
    CanonicalJson.object([
        ("baseline_report_ids", CanonicalJson.Array(row.baseline_report_ids.map((value) -> CanonicalJson.String(value)))), ("budget_id", CanonicalJson.String(row.id)),
        ("comparison", row.comparison), ("diagnostic_code", diagnostic), ("direction", CanonicalJson.String(row.direction)),
        ("enforcement", CanonicalJson.String(if row.enforcement == Enforcement.Warn -> "warn" else -> "fail")), ("evidence", CanonicalJson.String(evidence)),
        ("lower95", row.lower95.map((value) -> value.to_json()).unwrap_or(CanonicalJson.Null)), ("metric", row.metric), ("point", row.sample.to_json()), ("reason", CanonicalJson.String(row.reason)),
        ("source", CanonicalJson.object([("column", CanonicalJson.Integer(row.column.to_string())), ("line", CanonicalJson.Integer(row.line.to_string())), ("path", CanonicalJson.String(row.source))]).unwrap()),
        ("stale", CanonicalJson.Bool(row.stale)), ("status", CanonicalJson.String(status)), ("trend", row.trend), ("unit", CanonicalJson.String(row.unit)),
        ("upper95", row.upper95.map((value) -> value.to_json()).unwrap_or(CanonicalJson.Null))
    ]).unwrap()
}
