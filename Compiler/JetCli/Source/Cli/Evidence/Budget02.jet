fn statistics_json(samples: &[Rational]) -> CanonicalJson Err! {
    sorted := samples.to_vec()
    &sorted.sort()
    value :: statistics(samples)?
    CanonicalJson.object([("count", CanonicalJson.Integer(samples.len().to_string())), ("mad", value.mad.to_json()), ("mean", value.mean.to_json()),
        ("p50", value.p50.to_json()), ("p90", value.p90.to_json()), ("p95", value.p95.to_json()), ("p99", value.p99.to_json()), ("p999", value.p999.to_json()),
        ("sorted_samples", CanonicalJson.Array(sorted.map((sample) -> sample.to_json())))])
}
