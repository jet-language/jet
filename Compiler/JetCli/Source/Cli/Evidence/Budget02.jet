fn plan_row(operation: String, artifact: String, path: String, from: String?, id: String) -> CanonicalJson {
    CanonicalJson.object([("artifact", CanonicalJson.String(artifact)), ("from_id", from.map((value) -> CanonicalJson.String(value)).unwrap_or(CanonicalJson.Null)),
        ("id", CanonicalJson.String(id)), ("operation", CanonicalJson.String(operation)), ("path", CanonicalJson.String(path)), ("to_id", CanonicalJson.String(id))]).unwrap()
}
