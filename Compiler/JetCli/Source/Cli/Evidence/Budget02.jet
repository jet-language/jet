fn compiler_failure(options: &Options, entry: &OSPath, diags: &[Diagnostic]) -> I32 {
    src :: fs.read_to_string(entry).unwrap_or("")
    if options.json {
        report_path :: jet.Diagnostics.ReportPath.from_path(entry)
        diagnostics :: StatusValue.array(diags.map((diagnostic) -> report_status_value(diagnostic.to_report(report_path, src))))
        budget :: StatusValue.object(StatusFields.new().with("applied", false).with("diagnostics", diagnostics).with("exit_code", 1).with("failure_kind", "compiler")
            .with("plan", StatusValue.Null).with("report", StatusValue.Null).with("report_path", StatusValue.Null).with("results", StatusValue.array([])))
        print(StatusEnvelope.new(options.command, false).with_field("budget", budget).json())
    } else { eprint(jet.Diagnostics.render_all(entry.to_string_lossy(), src, diags)) }
    1
}
// Rust: Source/CmdBudget.rs:3428
fn tool_failure(options: &Options, why: String) -> I32 {
    if options.json {
        diagnostic :: ReportEnvelope.new("tool", "error", "E2908", "performance budget operation failed", why, "correct the named failure and retry")
        budget :: StatusValue.object(StatusFields.new().with("applied", false).with("diagnostics", StatusValue.array([report_status_value(diagnostic)]))
            .with("exit_code", 1).with("failure_kind", "tool").with("plan", StatusValue.Null).with("report", StatusValue.Null).with("report_path", StatusValue.Null).with("results", StatusValue.array([])))
        print(StatusEnvelope.new(options.command, false).with_field("budget", budget).json())
    } else { eprintln("Error [E2908]: Performance budget operation failed\n Why: {why}\n Fix: Correct the named failure and retry\nMore: jet-lang.dev/e/E2908\nbudget command failed before a valid report was produced") }
    1
}
// Rust: Source/CmdBudget.rs:3467
fn status_value(value: &CanonicalJson) -> StatusValue {
    if value == {
        .Null -> StatusValue.Null
        .Bool(value) -> StatusValue.Bool(value)
        .Integer(value) -> StatusValue.Integer(Int.parse(value).expect("canonical budget integer must fit status integer"))
        .String(value) -> StatusValue.String(value)
        .Array(values) -> StatusValue.array(values.map((value) -> status_value(value)))
        .Object(values) -> {
            fields := StatusFields.new()
            keys := values.keys().to_vec()
            &keys.sort()
            loop name in keys { fields = fields.with(name, status_value(values[name])) }
            StatusValue.object(^fields)
        }
    }
}
// Rust: Source/CmdBudget.rs:3488
fn report_status_value(report: &ReportEnvelope) -> StatusValue {
    fields := StatusFields.new().with("schema", "{report.schema_name}/v{report.schema_version}").with("moment", report.moment.as_str())
        .with("severity", report.severity.as_str()).with("code", report.code.as_str()).with("what", report.what.as_str()).with("why", report.why.as_str()).with("fix", report.fix.as_str())
        .with("applicability", report.applicability.map((value) -> StatusValue.from(value.as_str())).unwrap_or(StatusValue.Null))
        .with("detail", report.detail.map((value) -> StatusValue.from(value)).unwrap_or(StatusValue.Null))
        .with("denial_kind", report.denial_kind.map((value) -> StatusValue.from(value)).unwrap_or(StatusValue.Null))
        .with("call_chain", StatusValue.array(report.call_chain.map((value) -> StatusValue.from(value))))
        .with("scope_chain", StatusValue.array(report.scope_chain.map((value) -> StatusValue.from(value))))
        .with("nearest_granting_scope", report.nearest_granting_scope.map((value) -> StatusValue.from(value)).unwrap_or(StatusValue.Null))
        .with("file", report.file.filter((value) -> !value.is_empty()).map((value) -> StatusValue.from(value.as_str())).unwrap_or(StatusValue.Null))
        .with("line", report.line.map((value) -> StatusValue.from(value)).unwrap_or(StatusValue.Null))
        .with("col", report.col.map((value) -> StatusValue.from(value)).unwrap_or(StatusValue.Null))
        .with("span", report.span.map((span) -> StatusValue.object(StatusFields.new().with("start", span.start).with("end", span.end))).unwrap_or(StatusValue.Null))
    fix_edits :: StatusValue.array(report.fix_edits().map((edit) -> StatusValue.object(StatusFields.new().with("file", edit.file.as_str())
        .with("span", StatusValue.object(StatusFields.new().with("start", edit.span.start).with("end", edit.span.end)))
        .with("new_text", edit.new_text.as_str()).with("safety", edit.safety.as_str()))))
    if !report.fix_edits().is_empty() { fields = fields.with("fix_edits", fix_edits) }
    else if report.no_fix_reason() == .Val(reason) { fields = fields.with("no_fix_reason", StatusValue.object(StatusFields.new().with("kind", reason.kind.as_str()).with("next", reason.next.as_str()))) }
    else { fields = fields.with("fix_edits", fix_edits) }
    fields = fields.with("cause", StatusValue.array(report.cause.map((value) -> StatusValue.from(value.as_str())))).with("clears", report.clears)
    if report.extension == .Val(extension) {
        if extension == {
            .Crypto(reason, operation, expected, actual) -> {
                fields = fields.with("reason", reason.as_str()).with("operation", operation.as_str())
                    .with("expected", expected.map((value) -> StatusValue.from(value)).unwrap_or(StatusValue.Null))
                    .with("actual", actual.map((value) -> StatusValue.from(value)).unwrap_or(StatusValue.Null))
            }
            .BuildError(report) -> fields = fields.with("build_error", report.as_str())
        }
    }
    StatusValue.object(^fields)
}
