fn provider(kind: String, identity: String, root: &OSPath, _entry: &OSPath, profile: String, compile: &CompileWorkloadFact?) -> CanonicalJson Err! {
    triple :: host_triple()?
    cpu_arch :: triple.split("-").first().filter((v) -> !v.is_empty()) ?? return Err("host triple has no architecture")
    cpuinfo :: fs.read_to_string(OSPath.from("/proc/cpuinfo")) ?? return Err("cannot read CPU identity: {err}")
    cpu_model :: proc_value(cpuinfo, "model name").or_else(() -> proc_value(cpuinfo, "Hardware")) ?? return Err("CPU model is unavailable")
    meminfo :: fs.read_to_string(OSPath.from("/proc/meminfo")) ?? return Err("cannot read memory identity: {err}")
    memory_text :: proc_value(meminfo, "MemTotal").and_then((v) -> v.split_whitespace().first()) ?? return Err("memory total is unavailable")
    memory_kib :: U128.parse(memory_text) ?? return Err("memory total is malformed")
    memory_bytes :: memory_kib.checked_mul(1024) ?? return Err("memory total overflow")
    kernel :: read_trimmed("/proc/sys/kernel/osrelease", "kernel identity")?
    power_governor :: read_trimmed("/sys/devices/system/cpu/cpu0/cpufreq/scaling_governor", "CPU power governor")?
    // GATE #4494: native available parallelism must return the observed OS value.
    logical_cpus :: std.thread.available_parallelism() ?? return Err("logical CPU count unavailable: {err}")
    compile_version :: if kind == "CompilerProbe" {
        workload :: compile ?? return Err("CompilerProbe provider has no resolved workload")
        Val(compiler_probe_version(root, workload.mode, workload.target, profile, workload.patch)?)
    } else -> None
    (version, isolation) :: if kind == {
        "AllocationProbe" -> ("jet-arena-events-v1-warmup-auto-trials-20", "benchmark-process-counter-reset-per-trial")
        "ServiceProbe" -> ("jet-service-readiness-v1-trials-20", "service-process-group-down-up-per-trial")
        "SceneProbe" -> ("jet-scene-headless-v1-warmup-5-measure-20", "scene-in-process-frame-loop")
        "CompilerProbe" -> (compile_version.expect("compile provider version"), "child-process-per-sample")
        "BuildArtifact" -> ("jet-artifact-footprint-v1-first-line-vmhwm-trials-20", "fresh-child-process-per-trial")
        else -> ("1", "process")
    }
    // GATE #4483: preserve selected OS, not a hard-coded host.
    body :: CanonicalJson.object([("cpu_arch", CanonicalJson.String(cpu_arch)), ("cpu_model", CanonicalJson.String(cpu_model)), ("identity", CanonicalJson.String(identity)),
        ("isolation", CanonicalJson.String(isolation)), ("kernel", CanonicalJson.String(kernel)), ("kind", CanonicalJson.String(kind)),
        ("logical_cpus", CanonicalJson.Integer(logical_cpus.get().to_string())), ("memory_bytes", CanonicalJson.Integer(memory_bytes.to_string())),
        ("os", CanonicalJson.String(core.sys.target.selected_os())), ("power_governor", CanonicalJson.String(power_governor)), ("version", CanonicalJson.String(version))])?
    map := as_object(body)?.clone()
    map["hardware_fingerprint"] = CanonicalJson.String(stable_id(body))
    Ok(CanonicalJson.Object(^map))
}
