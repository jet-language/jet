fn tool_failure_with_report(options: &Options, id: String, why: String) -> I32 {
    if options.json -> return tool_failure(options, why)
    eprintln("Error [E2908]: Performance budget operation failed\n Why: {why}\n Fix: Correct the named failure and retry\nMore: jet-lang.dev/e/E2908\nbudget command failed · report {id} was not accepted")
    1
}
// Rust: Source/CmdBudget.rs:3666
fn timestamp_now() -> String {
    // GATE #4494: real wall clock; preserve duration-before-epoch default handling.
    elapsed :: SystemTime.now().duration_since(UNIX_EPOCH).unwrap_or(Duration.ZERO)
    seconds :: elapsed.as_secs() as I64
    days :: seconds.div_euclid(86400)
    second :: seconds.rem_euclid(86400)
    z :: days + 719468
    era :: (if z >= 0 -> z else -> z - 146096) / 146097
    doe :: z - era * 146097
    yoe :: (doe - doe / 1460 + doe / 36524 - doe / 146096) / 365
    year := yoe + era * 400
    doy :: doe - (365 * yoe + yoe / 4 - yoe / 100)
    mp :: (5 * doy + 2) / 153
    day :: doy - (153 * mp + 2) / 5 + 1
    month :: mp + (if mp < 10 -> 3 else -> -9)
    year += if month <= 2 -> 1 else -> 0
    "{year:04}-{month:02}-{day:02}T{second / 3600:02}:{(second % 3600) / 60:02}:{second % 60:02}.{elapsed.subsec_nanos():09}Z"
}
