// Rust: Source/CmdBudget.rs:2906
fn running_executable() -> OSPath IOError! {
    // GATE #4494: actual process executable identity.
    current :: std.env.current_exe()?
    if core.sys.target.selected_os() == "linux" -> select_running_executable(current, OSPath.from("/proc/self/exe")) else -> Ok(current)
}
// Rust: Source/CmdBudget.rs:2919
fn select_running_executable(current: &OSPath, stable: &OSPath) -> OSPath IOError! {
    // GATE #4409: distinguish NotFound from unreadable canonical paths.
    if fs.File.open(current) == {
        .Ok(file) -> {
            file.close()
            if fs.File.open(stable) == .Ok(stable_file) { stable_file.close(); Ok(stable.clone()) } else -> Ok(current.clone())
        }
        .Err(error) -> {
            if error.kind() == IOErrorKind.NotFound {
                file :: fs.File.open(stable)?
                file.close()
                Ok(stable.clone())
            } else -> Ok(current.clone())
        }
    }
}
