// Rust: Source/BudgetProviders.rs:825
pub NATIVE_BUILD_DEADLINE :: Duration.from_secs(120)
// Rust: Source/BudgetProviders.rs:837
pub fn collection_deadline(kind: String, mode: String?, facts: Duration, native_build: Duration) -> Duration {
    if kind == {
        "BuildArtifact" -> Duration.from_secs(ARTIFACT_READY_DEADLINE.as_secs() * ARTIFACT_RUNTIME_SAMPLES as U64) + facts,
        "CompilerProbe" -> {
            trials :: COMPILE_WARMUPS as U32 + COMPILE_SAMPLES as U32
            prime :: if mode == Val("Edit") { 1 } else { 0 }
            (trials + prime) * native_build + facts
        }
        "BenchMeasurement" | "AllocationProbe" -> native_build + facts,
        else -> facts
    }
}
// Rust: Source/BudgetProviders.rs:867
pub fn compiler_probe_workload(project_root: OSPath, entry: OSPath, mode: String, target: String, profile: String, patch: String?) -> CanonicalJson Err! {
    root :: project_root.canonicalize().map_err(fn(error) { "cannot resolve compile workload root: ${error}" })
    resolved_entry :: entry.canonicalize().map_err(fn(error) { "cannot resolve compile workload entry: ${error}" })
    if !resolved_entry.starts_with(root) -> return Err("compile workload entry escapes its project root")
    descriptor :: compile_descriptor(root, mode, target, profile, patch)
    provider_version :: compiler_probe_version(root, mode, target, profile, patch)
    CanonicalJson.object([
        ("entry", CanonicalJson.String(resolved_entry.to_string_lossy())),
        ("mode", CanonicalJson.String(mode)), ("patch", patch.map(fn(value) { CanonicalJson.String(value) }) ?? CanonicalJson.Null),
        ("patch_sha256", CanonicalJson.String(descriptor.patch_sha256)),
        ("profile", CanonicalJson.String(profile)), ("provider_version", CanonicalJson.String(provider_version)),
        ("project_root", CanonicalJson.String(root.to_string_lossy())),
        ("samples", CanonicalJson.Integer(COMPILE_SAMPLES.to_string())),
        ("source_tree_sha256", CanonicalJson.String(descriptor.source_tree_sha256)),
        ("target", CanonicalJson.String(target)), ("warmups", CanonicalJson.Integer(COMPILE_WARMUPS.to_string()))
    ])
}
// Rust: Source/BudgetProviders.rs:929
pub fn compiler_probe_version(project_root: OSPath, mode: String, target: String, profile: String, patch: String?) -> String Err! {
    root :: project_root.canonicalize().map_err(fn(error) { "cannot resolve compile workload root: ${error}" })
    descriptor :: compile_descriptor(root, mode, target, profile, patch)
    backend :: CompileBackend.for_profile(profile)
    Ok("jet-compile-latency-v3;clock=${COMPILE_CLOCK};mode=${mode};target=${target};profile=${profile};backend=${backend.label()};linker=${backend.linker()};warmups=${COMPILE_WARMUPS};samples=${COMPILE_SAMPLES};source=${descriptor.source_tree_sha256};patch=${descriptor.patch_sha256}")
}
// Rust: Source/BudgetProviders.rs:950
struct CompileDescriptor { source_tree_sha256: String, patch_sha256: String }
// Rust: Source/BudgetProviders.rs:955
fn compile_descriptor(root: OSPath, mode: String, target: String, profile: String, patch: String?) -> CompileDescriptor Err! {
    if !(mode == "Clean" || mode == "NoChange" || mode == "Edit") || target.is_empty() || profile.is_empty() {
        return Err("compile workload has an unsupported mode, empty target, or empty profile")
    }
    if target != "cli" -> return Err("compile workload target `${target}` is unsupported by the resident fixture compiler")
    validate_compile_profile(root, profile)
    if mode == "Edit" && patch.is_none() -> return Err("CompileProbe Edit workload has no patch path")
    if mode != "Edit" && patch.is_some() -> return Err("only an Edit workload may name a patch path")
    patch_sha256 :: if patch == {
        .Val(path_text) -> {
            if !safe_relative_path(path_text) -> return Err("compile workload patch path is not project-relative")
            path :: root.join(path_text)
