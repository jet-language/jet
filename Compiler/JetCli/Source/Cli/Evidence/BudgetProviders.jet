// Rust: Source/BudgetProviders.rs:233
pub fn ProviderFailure.diagnostic(self: &ProviderFailure, budget: String) -> ProviderDiagnostic {
    if self.class == {
        .Unavailable | .Incompatible -> ProviderDiagnostic{code: "E2906", what: "Performance budget ${budget} has no usable evidence", why: self.reason, fix: "Correct the provider evidence or bootstrap only when absent or stale evidence is eligible"},
        .Unsupported -> ProviderDiagnostic{code: "E2903", what: "Performance budget ${budget} is not valid", why: self.reason, fix: "Use one supported metric and provider pair"},
        .Unresolved -> ProviderDiagnostic{code: "E2905", what: "Performance budget ${budget} cannot resolve provider", why: self.reason, fix: "Name one registered provider identity"},
        else -> ProviderDiagnostic{code: "E2908", what: "Performance budget operation failed", why: "Measurement provider refused the operation: ${self.reason}", fix: "Correct the named provider failure and retry the operation"}
    }
}
