fn safe_relative_path(value: String) -> Bool {
    !value.is_empty() && !value.starts_with("/") && !value.contains("\\") &&
        value.split("/").all(fn(part) { !part.is_empty() && part != "." && part != ".." })
}
// Rust: Source/BudgetProviders.rs:1561
fn source_files(root: OSPath) -> [(String, OSPath)] Err! {
    // Rust: Source/BudgetProviders.rs:1562
    fn visit(root: OSPath, dir: OSPath, files: &[(String, OSPath)]) Err! {
        entries := std.fs.read_dir(dir).map_err(fn(error) { "cannot read compile workload directory: ${error}" }).collect_result().map_err(fn(error) { "cannot enumerate compile workload directory: ${error}" })
        entries.sort_by_key(fn(entry) { entry.file_name() })
        loop entry in entries {
            path :: entry.path()
            name :: entry.file_name().to_string_lossy()
            if name == ".jet" || name == ".jet-compile-cache" || name == "build" || name == "target" || name == ".git" -> continue
            metadata :: std.fs.symlink_metadata(path).map_err(fn(error) { "cannot inspect compile workload path: ${error}" })
            if metadata.file_type().is_symlink() -> return Err("compile workload contains a symlink: ${path.display()}")
            if metadata.is_dir() {
                visit(root, path, &files)
            } else if metadata.is_file() {
                relative :: path.strip_prefix(root).map_err(fn(error) { "compile workload path escaped its root" }).to_string_lossy().replace("\\", "/")
                if relative == "package.jet" || relative.ends_with(".jet") -> &files.push((relative, path))
            }
        }
        Ok(())
    }
    files := [(String, OSPath)]{}
    visit(root, root, &files)
    files.sort_by(fn(left, right) { left.0.cmp(right.0) })
    if files.is_empty() -> return Err("compile workload has no package or Jet source files")
    Ok(^files)
}
// Rust: Source/BudgetProviders.rs:1610
fn source_tree_digest(root: OSPath) -> String Err! {
    files :: source_files(root)
    frame := [U8]{}
    total := U64{0}
    loop (relative, path) in files {
        length :: std.fs.metadata(path).map_err(fn(error) { "cannot inspect compile workload source: ${error}" }).len()
        total = total.checked_add(length).ok_or_else(fn() { "compile workload source byte count overflowed" })
        if total > COMPILE_MAX_PROJECT_BYTES -> return Err("compile workload exceeds the 64 MiB project limit")
        bytes :: std.fs.read(path).map_err(fn(error) { "cannot read compile workload source: ${error}" })
        &frame.extend_from_slice((relative.bytes().len() as U64).to_be_bytes())
        &frame.extend_from_slice(relative.bytes())
        &frame.extend_from_slice((bytes.len() as U64).to_be_bytes())
        &frame.extend_from_slice(bytes)
    }
    Ok(sha256_hex(frame))
}
// Rust: Source/BudgetProviders.rs:1634
fn source_tree_bytes(root: OSPath) -> U128 Err! {
    total := U128{0}
    loop (relative, path) in source_files(root) {
        bytes :: std.fs.metadata(path).map_err(fn(error) { "cannot inspect compile workload source: ${error}" }).len() as U128
        total = total.checked_add(bytes).ok_or_else(fn() { "compile workload source byte count overflowed" })
        if total > COMPILE_MAX_PROJECT_BYTES as U128 -> return Err("compile workload exceeds the 64 MiB project limit")
    }
    Ok(total)
}
// Rust: Source/BudgetProviders.rs:1651
fn copy_compile_project(source: OSPath, destination: OSPath) Err! {
    // Rust: Source/BudgetProviders.rs:1652
    fn copy_dir(source: OSPath, destination: OSPath, total: &U64) Err! {
        std.fs.create_dir_all(destination).map_err(fn(error) { "cannot create compile workload scratch directory: ${error}" })
        entries := std.fs.read_dir(source).map_err(fn(error) { "cannot read compile workload project: ${error}" }).collect_result().map_err(fn(error) { "cannot enumerate compile workload project: ${error}" })
        entries.sort_by_key(fn(entry) { entry.file_name() })
        loop entry in entries {
            path :: entry.path()
            name :: entry.file_name().to_string_lossy()
            if name == ".jet" || name == ".jet-compile-cache" || name == "build" || name == "target" || name == ".git" -> continue
            metadata :: std.fs.symlink_metadata(path).map_err(fn(error) { "cannot inspect compile workload project path: ${error}" })
            if metadata.file_type().is_symlink() -> return Err("compile workload contains a symlink: ${path.display()}")
            target :: destination.join(entry.file_name())
            if metadata.is_dir() {
                copy_dir(path, target, &total)
            } else if metadata.is_file() {
                total = total.checked_add(metadata.len()).ok_or_else(fn() { "compile workload exceeds its byte limit" })
                if total > COMPILE_MAX_PROJECT_BYTES -> return Err("compile workload exceeds the 64 MiB project limit")
                _ :: std.fs.copy(path, target).map_err(fn(error) { "cannot copy compile workload input: ${error}" })
            }
        }
        Ok(())
    }
    total := U64{0}
    copy_dir(source, destination, &total)
}
// Rust: Source/BudgetProviders.rs:1700
fn compile_cache_root(root: OSPath) -> OSPath? Err! {
    jet_dir :: root.join(".jet")
    metadata :: if std.fs.symlink_metadata(jet_dir) == {
        .Ok(metadata) -> metadata,
        .Err(error) -> {
            if error.kind() == std.io.ErrorKind.NotFound -> return Ok(None)
            return Err("cannot inspect compile workload state: ${error}")
        }
    }
    if metadata.file_type().is_symlink() || !metadata.is_dir() -> return Err("compile workload state `${jet_dir.display()}` is not a real directory")
    Ok(Val(jet_dir.join("build")))
}
// Rust: Source/BudgetProviders.rs:1716
fn ensure_compile_cache_root(root: OSPath) -> OSPath Err! {
    jet_dir :: root.join(".jet")
    if std.fs.symlink_metadata(jet_dir) == {
        .Ok(metadata) -> {
            if metadata.file_type().is_symlink() || !metadata.is_dir() -> return Err("compile workload state `${jet_dir.display()}` is not a real directory")
        }
        .Err(error) -> {
            if error.kind() == std.io.ErrorKind.NotFound {
                std.fs.create_dir(jet_dir).map_err(fn(error) { "cannot create compile workload state: ${error}" })
            } else { return Err("cannot inspect compile workload state: ${error}") }
        }
    }
    cache :: jet_dir.join("build")
    if std.fs.symlink_metadata(cache) == {
        .Ok(metadata) -> {
            if metadata.file_type().is_symlink() || !metadata.is_dir() -> return Err("compile workload cache `${cache.display()}` is not a real directory")
        }
        .Err(error) -> {
            if error.kind() == std.io.ErrorKind.NotFound {
                std.fs.create_dir(cache).map_err(fn(error) { "cannot create compile workload cache: ${error}" })
            } else { return Err("cannot inspect compile workload cache: ${error}") }
        }
    }
    Ok(cache)
}
// Rust: Source/BudgetProviders.rs:1750
fn reset_compile_cache(root: OSPath) ProviderFailure! {
    cache :: compile_cache_root(root).map_err(fn(error) { ProviderFailure.operation(.Execution, error) }) ?? return Ok(())
    if std.fs.symlink_metadata(cache) == {
        .Ok(metadata) -> {
            if metadata.file_type().is_symlink() || !metadata.is_dir() -> return Err(ProviderFailure.operation(.Execution, "compile workload cache `${cache.display()}` is not a real directory"))
        }
        .Err(error) -> {
            if error.kind() == std.io.ErrorKind.NotFound -> return Ok(())
            return Err(ProviderFailure.operation(.Execution, "cannot inspect compile workload cache: ${error}"))
        }
    }
    std.fs.remove_dir_all(cache).map_err(fn(error) { ProviderFailure.operation(.Execution, "cannot reset compile workload cache: ${error}") })
}
// Rust: Source/BudgetProviders.rs:1785
fn restore_compile_cache(warm: OSPath, trial: OSPath) ProviderFailure! {
    reset_compile_cache(trial)
    source :: compile_cache_root(warm).map_err(fn(error) { ProviderFailure.operation(.Execution, error) }) ?? return Ok(())
    metadata :: if std.fs.symlink_metadata(source) == {
        .Ok(metadata) -> metadata,
        .Err(error) -> {
            if error.kind() == std.io.ErrorKind.NotFound -> return Ok(())
            return Err(ProviderFailure.operation(.Execution, "cannot inspect compile workload cache: ${error}"))
        }
    }
    if metadata.file_type().is_symlink() || !metadata.is_dir() -> return Err(ProviderFailure.operation(.Execution, "compile workload cache `${source.display()}` is not a real directory"))
    destination :: ensure_compile_cache_root(trial).map_err(fn(error) { ProviderFailure.operation(.Execution, error) })
    copy_cache_tree(source, destination).map_err(fn(error) { ProviderFailure.operation(.Execution, error) })
    Ok(())
}

