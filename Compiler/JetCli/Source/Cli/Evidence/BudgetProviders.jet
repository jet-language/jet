// Rust: Source/BudgetProviders.rs:90
pub fn ProviderRequest.validate(self: &ProviderRequest) ProviderFailure! {
    if self.schema != "jet.provider-request" || self.version != 1 {
        return Err(ProviderFailure.malformed("unsupported provider request schema/version"))
    }
    loop (name, value) in [("request_id", self.request_id), ("provider_hash", self.provider_hash), ("context_hash", self.context_hash)] {
        if !is_hex64(value) -> return Err(ProviderFailure.malformed("${name} is not lowercase Hex64"))
    }
    if self.specs.is_empty() || self.specs.len() > MAX_SPECS {
        return Err(ProviderFailure.malformed("provider request spec count is outside 1..=4096"))
    }
    previous := (String, String)?{None}
    loop spec in self.specs {
        if !is_hex64(spec.budget_hash) || spec.metric.is_empty() {
            return Err(ProviderFailure.malformed("provider request has an invalid budget hash or empty metric"))
        }
        key :: (spec.metric, spec.budget_hash)
        if previous == { .Val(prior) -> prior >= key, .None -> false } {
            return Err(ProviderFailure.malformed("provider request specs are not strictly ordered by metric then budget hash"))
        }
        previous = Val(key)
    }
    Ok(())
}
// Rust: Source/BudgetProviders.rs:130
pub fn ProviderRequest.bytes(self: &ProviderRequest) -> [U8] ProviderFailure! {
    self.validate()
    specs := [CanonicalJson]{}
    loop spec in self.specs {
        &specs.push(CanonicalJson.object([
            ("budget_hash", CanonicalJson.String(spec.budget_hash)),
            ("metric", CanonicalJson.String(spec.metric))
        ]).expect("fixed keys"))
    }
    Ok(CanonicalJson.object([
        ("context_hash", CanonicalJson.String(self.context_hash)),
        ("policy", self.policy), ("provider_hash", CanonicalJson.String(self.provider_hash)),
        ("request_id", CanonicalJson.String(self.request_id)),
        ("schema", CanonicalJson.String(self.schema)), ("specs", CanonicalJson.Array(^specs)),
        ("version", CanonicalJson.Integer(self.version.to_string())), ("workload", self.workload)
    ]).expect("fixed keys").bytes())
}
