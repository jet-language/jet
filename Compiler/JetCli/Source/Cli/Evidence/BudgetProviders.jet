fn validate_compile_profile(root: OSPath, profile: String) Err! {
    if profile == "dev" || profile == "release" || profile == "debug" || profile == "ci" || profile == "small" -> return Ok(())
    manifest :: root.join("package.jet")
    raw :: std.fs.read_to_string(manifest).map_err(fn(error) { "compile workload profile `${profile}` is unsupported by the resident fixture compiler" })
    facts :: PackageFacts.parse(raw, manifest.display().to_string()).map_err(fn(error) { "compile workload profile `${profile}` is unsupported by the resident fixture compiler" })
    if facts.build_profiles.iter().any(fn(candidate) { candidate.name == profile }) -> return Ok(())
    Err("compile workload profile `${profile}` is unsupported by the resident fixture compiler")
}
// Rust: Source/BudgetProviders.rs:1026
fn compiler_latency_provider(request: &ProviderRequest, cancellation: &ProviderCancellation) -> [ProviderEvent] ProviderFailure! {
    workload :: if request.workload == {
        .Object(workload) -> workload,
        else -> return Err(ProviderFailure.malformed("CompilerProbe workload is not an object"))
    }
    validate_compile_workload_identity(request, workload)
    mode :: workload_text(workload, "mode")
    target :: workload_text(workload, "target")
    profile :: workload_text(workload, "profile")
    provider_version :: workload_text(workload, "provider_version")
    root_path :: OSPath.new(workload_text(workload, "project_root"))
    entry_path :: OSPath.new(workload_text(workload, "entry"))
    if !root_path.is_absolute() || !entry_path.is_absolute() -> return Err(ProviderFailure.malformed("CompilerProbe paths are not compiler-resolved absolute text"))
    patch :: if workload.get("patch") == {
        .Val(.Null) -> None,
        .Val(.String(value)) -> Val(value),
        else -> return Err(ProviderFailure.malformed("CompilerProbe patch is not text or null"))
    }
    warmups :: workload_unsigned(workload, "warmups")
    sample_count :: workload_unsigned(workload, "samples")
    if warmups != COMPILE_WARMUPS || sample_count != COMPILE_SAMPLES as U128 {
        return Err(ProviderFailure.operation(.Incompatible, "CompilerProbe workload does not use the pinned warmup/sample policy"))
    }
    if target != "cli" -> return Err(ProviderFailure.operation(.Unsupported, "compile workload target `${target}` is unsupported by the resident fixture compiler"))
    loop spec in request.specs {
        if !(spec.metric == "CompileTime(P50)" || spec.metric == "CompileTime(P90)" || spec.metric == "CompileTime(P95)" || spec.metric == "CompileTime(P99)" || spec.metric == "CompileTime(P999)") {
            return Err(ProviderFailure.operation(.Unsupported, "CompilerProbe does not support metric `${spec.metric}`"))
        }
    }
    root :: root_path.canonicalize().map_err(fn(error) { ProviderFailure.operation(.Unavailable, "compile workload root is unavailable: ${error}") })
    entry :: entry_path.canonicalize().map_err(fn(error) { ProviderFailure.operation(.Unavailable, "compile workload entry is unavailable: ${error}") })
    if !entry.starts_with(root) -> return Err(ProviderFailure.operation(.Incompatible, "compile workload entry escapes its project root"))
    descriptor :: compile_descriptor(root, mode, target, profile, patch).map_err(ProviderFailure.malformed)
    expected_provider_version :: compiler_probe_version(root, mode, target, profile, patch).map_err(ProviderFailure.malformed)
    if provider_version != expected_provider_version -> return Err(ProviderFailure.operation(.Incompatible, "compile workload provider identity is stale or forged"))
    source_tree_sha256 :: workload_text(workload, "source_tree_sha256")
    patch_sha256 :: workload_text(workload, "patch_sha256")
    if source_tree_sha256 != descriptor.source_tree_sha256 || patch_sha256 != descriptor.patch_sha256 {
        return Err(ProviderFailure.operation(.Incompatible, "compile workload source or patch identity is stale or forged"))
    }
    sequence :: COMPILE_WORKLOAD_SEQUENCE.fetch_add(1, AtomicOrdering.Relaxed) // GATE #4494
    scratch :: std.env.temp_dir().join("jet-compile-latency-${std.process.id()}-${sequence}-${request.request_id[..12]}")
    result := compile_latency_samples(root, entry, scratch, mode, patch, descriptor.source_tree_sha256, descriptor.patch_sha256, target, profile, warmups as USize, sample_count as USize, request.specs, request.request_id)
    _ :: std.fs.remove_dir_all(scratch)
    ^result
}
// Rust: Source/BudgetProviders.rs:1157
fn validate_compile_workload_identity(request: &ProviderRequest, fields: [String: CanonicalJson]) ProviderFailure! {
    KEYS :: ["entry", "mode", "patch", "patch_sha256", "profile", "project_root", "provider_version", "samples", "source_tree_sha256", "target", "warmups"]
    if fields.len() != KEYS.len() || KEYS.iter().any(fn(key) { !fields.contains_key(key) }) {
        return Err(ProviderFailure.malformed("CompilerProbe workload has an unexpected or missing identity field"))
    }
    if request.request_id != stable_id(request.workload) -> return Err(ProviderFailure.operation(.Incompatible, "compile workload request identity is stale or forged"))
    Ok(())
}
// Rust: Source/BudgetProviders.rs:1188
fn compile_latency_samples(root: OSPath, entry: OSPath, scratch: OSPath, mode: String, patch: String?, expected_source_tree_sha256: String, expected_patch_sha256: String, target: String, profile: String, warmups: USize, sample_count: USize, specs: [ProviderSpec], request_id: String) -> [ProviderEvent] ProviderFailure! {
    relative_entry :: entry.strip_prefix(root).map_err(fn(error) { ProviderFailure.malformed("compile workload entry is outside its project root") })
    workload_bytes :: source_tree_bytes(root).map_err(ProviderFailure.malformed)
    edit_bytes_data :: patch.map(fn(path) { std.fs.read(root.join(path)) }).transpose().map_err(fn(error) { ProviderFailure.malformed("cannot read edit bytes: ${error}") })
    edit_bytes :: edit_bytes_data.map(fn(bytes) { bytes.len() as U128 }) ?? 0
    edit_sha256 :: edit_bytes_data.map(sha256_hex) ?? sha256_hex([])
    if edit_sha256 != expected_patch_sha256 -> return Err(ProviderFailure.operation(.Incompatible, "compile workload patch changed while it was copied"))
    compiler_digest :: JET_COMPILER_BUILD_ID
    core_digest :: JET_STDLIB_BUILD_ID
    host :: "${core.sys.target.selected_os()}:${JET_BUILD_TARGET}"
    backend :: CompileBackend.for_profile(profile)
    linker :: backend.linker()
    sample_values := [Rational]{}
    sample_records := [CanonicalJson]{}
    peak_rss_bytes := U64{0}
    edit_patch :: if mode == "Edit" { Val(patch.ok_or_else(fn() { ProviderFailure.malformed("Edit workload has no patch path") })) } else { None }
    // Prime a fixed watched path once; restore its exact warm cache per edit.
    warm :: scratch.join("warm-cache")
    edit_trial :: scratch.join("edit-trial")
    if mode == "Edit" {
        std.fs.create_dir_all(scratch).map_err(fn(error) { ProviderFailure.operation(.Execution, "cannot create edit workload scratch directory: ${error}") })
        copy_compile_project(root, edit_trial).map_err(ProviderFailure.malformed)
        copied_digest :: source_tree_digest(edit_trial).map_err(ProviderFailure.malformed)
        if copied_digest != expected_source_tree_sha256 -> return Err(ProviderFailure.operation(.Incompatible, "compile workload source changed while it was copied"))
        reset_compile_cache(edit_trial)
        run_compile_child(edit_trial.join(relative_entry), edit_trial, target, profile)
        restore_compile_cache(edit_trial, warm)
    } else {
        copy_compile_project(root, scratch).map_err(ProviderFailure.malformed)
        copied_digest :: source_tree_digest(scratch).map_err(ProviderFailure.malformed)
        if copied_digest != expected_source_tree_sha256 -> return Err(ProviderFailure.operation(.Incompatible, "compile workload source changed while it was copied"))
    }
    loop trial in 0..<warmups {
        if mode == "Edit" {
            _ :: compile_edit_trial(root, relative_entry, edit_trial, warm, edit_patch.ok_or_else(fn() { ProviderFailure.malformed("Edit workload has no patch path") }), expected_source_tree_sha256, expected_patch_sha256, target, profile)
        } else {
            scratch_entry :: scratch.join(relative_entry)
            if mode == "Clean" -> reset_compile_cache(scratch)
            run_compile_child(scratch_entry, scratch, target, profile)
        }
    }
    loop trial in 0..<sample_count {
        (child, phase_totals) :: if mode == "Edit" {
            compile_edit_trial(root, relative_entry, edit_trial, warm, edit_patch.ok_or_else(fn() { ProviderFailure.malformed("Edit workload has no patch path") }), expected_source_tree_sha256, expected_patch_sha256, target, profile)
        } else {
            scratch_entry :: scratch.join(relative_entry)
            if mode == "Clean" -> reset_compile_cache(scratch)
            child :: run_compile_child(scratch_entry, scratch, target, profile)
            (child, read_compile_phases(scratch, scratch_entry))
        }
        peak_rss_bytes = peak_rss_bytes.max(child.peak_rss_bytes)
        elapsed_ns :: child.process_cpu_ns
        &sample_values.push(Rational.parse(elapsed_ns.to_string(), "1").map_err(ProviderFailure.malformed))
        &sample_records.push(CanonicalJson.object([
            ("backend", CanonicalJson.String(backend.label())), ("cache_state", CanonicalJson.String(mode)),
            ("clock", CanonicalJson.String(COMPILE_CLOCK)), ("compiler_digest", CanonicalJson.String(compiler_digest)),
            ("core_digest", CanonicalJson.String(core_digest)), ("edit_bytes", CanonicalJson.Integer(edit_bytes.to_string())),
            ("elapsed_ns", CanonicalJson.Integer(elapsed_ns.to_string())), ("host", CanonicalJson.String(host)),
            ("linker", CanonicalJson.String(linker)), ("peak_rss_bytes", CanonicalJson.Integer(child.peak_rss_bytes.to_string())),
            ("phase_totals", phase_totals_json(phase_totals)), ("profile", CanonicalJson.String(profile)),
            ("source_tree_sha256", CanonicalJson.String(expected_source_tree_sha256)),
            ("target", CanonicalJson.String(target)), ("workload_bytes", CanonicalJson.Integer(workload_bytes.to_string()))
        ]).map_err(ProviderFailure.malformed))
    }
    sum := Rational.zero()
    loop value in sample_values -> sum = sum.add(value).map_err(ProviderFailure.malformed)
    mean :: sum.div(Rational.integer(sample_values.len() as I128)).map_err(ProviderFailure.malformed)
    squared_sum := Rational.zero()
    loop value in sample_values {
        delta :: value.sub(mean).map_err(ProviderFailure.malformed)
        squared_sum = squared_sum.add(delta.mul(delta).map_err(ProviderFailure.malformed)).map_err(ProviderFailure.malformed)
    }
    variance :: squared_sum.div(Rational.integer(sample_values.len() as I128)).map_err(ProviderFailure.malformed)
    aggregate_phases :: aggregate_compile_phases(sample_records)
    metadata_json :: CanonicalJson.object([
        ("backend", CanonicalJson.String(backend.label())), ("cache_state", CanonicalJson.String(mode)),
        ("clock", CanonicalJson.String(COMPILE_CLOCK)), ("compiler_digest", CanonicalJson.String(compiler_digest)),
        ("core_digest", CanonicalJson.String(core_digest)), ("edit_bytes", CanonicalJson.Integer(edit_bytes.to_string())),
        ("edit_sha256", CanonicalJson.String(edit_sha256)), ("host", CanonicalJson.String(host)),
        ("linker", CanonicalJson.String(linker)), ("peak_rss_bytes", CanonicalJson.Integer(peak_rss_bytes.to_string())),
        ("phase_totals", aggregate_phases), ("profile", CanonicalJson.String(profile)),
        ("sample_records", CanonicalJson.Array(^sample_records)), ("samples", CanonicalJson.Integer(sample_count.to_string())),
        ("source_tree_sha256", CanonicalJson.String(expected_source_tree_sha256)), ("target", CanonicalJson.String(target)),
        ("variance", variance.to_json()), ("warmups", CanonicalJson.Integer(warmups.to_string())),
        ("workload_bytes", CanonicalJson.Integer(workload_bytes.to_string()))
    ]).map_err(ProviderFailure.malformed)
    metadata :: String.from_utf8(metadata_json.bytes()).map_err(fn(error) { ProviderFailure.malformed("compile metadata is not UTF-8") })
    events := [ProviderEvent]{}
    loop spec in 0..<specs.len() {
        loop value in sample_values {
            &events.push(ProviderEvent.Sample{spec: spec as U32, metric: specs[spec].metric, value: value})
        }
        &events.push(ProviderEvent.Metadata{spec: spec as U32, details: [("compile", metadata)]})
    }
    &events.push(ProviderEvent.Complete{request_id: request_id, samples: (sample_count * specs.len()) as U64})
    Ok(^events)
}
// Rust: Source/BudgetProviders.rs:1470
fn compile_edit_trial(root: OSPath, relative_entry: OSPath, trial: OSPath, warm: OSPath, patch: String, expected_source_tree_sha256: String, expected_patch_sha256: String, target: String, profile: String) -> (ChildMetrics, [(String, U128)]) ProviderFailure! {
    copy_compile_project(root, trial).map_err(ProviderFailure.malformed)
    copied_digest :: source_tree_digest(trial).map_err(ProviderFailure.malformed)
    if copied_digest != expected_source_tree_sha256 -> return Err(ProviderFailure.operation(.Incompatible, "compile workload source changed while it was copied"))
    patch_bytes :: std.fs.read(trial.join(patch)).map_err(fn(error) { ProviderFailure.operation(.Incompatible, "compile workload patch changed while it was copied: ${error}") })
    if sha256_hex(patch_bytes) != expected_patch_sha256 -> return Err(ProviderFailure.operation(.Incompatible, "compile workload patch changed while it was copied"))
    restore_compile_cache(warm, trial)
    apply_unified_patch(trial, patch).map_err(ProviderFailure.malformed)
    entry :: trial.join(relative_entry)
    child :: run_compile_child(entry, trial, target, profile)
    Ok((child, read_compile_phases(trial, entry)))
}
