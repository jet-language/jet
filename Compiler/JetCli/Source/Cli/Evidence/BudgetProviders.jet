pub fn ProviderRegistry.collect(self: &ProviderRegistry, identity: String, request: &ProviderRequest, timeout: Duration) -> ProviderEvidence ProviderFailure! {
    request.validate()
    provider :: self.providers.get(identity).ok_or_else(fn() { ProviderFailure.operation(.Unresolved, "provider `${identity}` is unresolved") })
    events :: if provider == {
        .InProcess(function) -> run_in_process(function, request, timeout, identity),
        .Subprocess(path) -> decode_stream(run_subprocess(path, request.bytes(), timeout), request),
        .File(path) -> decode_stream(read_bounded(path, timeout), request)
    }
    validate_events(^events, request)
}
// Rust: Source/BudgetProviders.rs:364
fn compiler_facts_provider(request: &ProviderRequest, cancellation: &ProviderCancellation) -> [ProviderEvent] ProviderFailure! {
    values :: if request.workload == {
        .Array(values) -> values,
        else -> return Err(ProviderFailure.malformed("CompilerFacts workload is not an ordered sample array"))
    }
    if values.len() != request.specs.len() -> return Err(ProviderFailure.malformed("CompilerFacts workload/spec count differs"))
    events := [ProviderEvent]{}
    loop index in 0..<values.len() {
        text :: if values[index] == {
            .Integer(value) -> value,
            else -> return Err(ProviderFailure.malformed("CompilerFacts sample is not an integer"))
        }
        value :: Rational.parse(text, "1").map_err(ProviderFailure.malformed)
        &events.push(ProviderEvent.Sample{spec: index as U32, metric: request.specs[index].metric, value: ^value})
    }
    &events.push(ProviderEvent.Complete{request_id: request.request_id, samples: values.len() as U64})
    Ok(^events)
}
// Rust: Source/BudgetProviders.rs:399
fn build_artifact_provider(request: &ProviderRequest, cancellation: &ProviderCancellation) -> [ProviderEvent] ProviderFailure! {
    workload :: if request.workload == {
        .Object(workload) -> workload,
        else -> return Err(ProviderFailure.malformed("BuildArtifact workload is not an object"))
    }
    path_text :: if workload.get("path") == {
        .Val(.String(path)) -> path,
        else -> return Err(ProviderFailure.malformed("BuildArtifact workload has no artifact path"))
    }
    path :: OSPath.new(path_text)
    if !path.is_absolute() -> return Err(ProviderFailure.malformed("BuildArtifact path is not compiler-resolved absolute text"))
    metadata :: std.fs.symlink_metadata(path).map_err(fn(error) { ProviderFailure.operation(.Unavailable, "built artifact is unavailable: ${error}") }) // GATE #4494
    if metadata.file_type().is_symlink() || !metadata.is_file() -> return Err(ProviderFailure.operation(.Incompatible, "built artifact is not a regular file"))
    value :: Rational.parse(metadata.len().to_string(), "1").map_err(ProviderFailure.malformed)
    runtime := ArtifactRuntime?{None}
    if request.specs.iter().any(fn(spec) { spec.metric == "StartupTime" || spec.metric == "MemoryHighWater" }) {
        if core.sys.target.selected_os() == "linux" {
            runtime = Val(measure_artifact_runtime(path, ARTIFACT_RUNTIME_SAMPLES))
        } else {
            return Err(ProviderFailure.operation(.Unavailable, "BuildArtifact startup and memory measurements require Linux /proc process accounting"))
        }
    }
    events := [ProviderEvent]{}
    sample_count := U64{0}
    loop index in 0..<request.specs.len() {
        spec :: request.specs[index]
        if spec.metric == {
            "BinarySize" | "ArtifactSize" -> {
                &events.push(ProviderEvent.Sample{spec: index as U32, metric: spec.metric, value: value})
                sample_count += 1
            }
            "StartupTime" | "MemoryHighWater" -> {
                measured :: runtime.expect("runtime measurements were requested")
                samples :: if spec.metric == "StartupTime" { measured.startup_ns } else { measured.memory_bytes }
                loop sample in samples {
                    &events.push(ProviderEvent.Sample{spec: index as U32, metric: spec.metric, value: sample})
                    sample_count += 1
                }
            }
            else -> return Err(ProviderFailure.operation(.Unsupported, "BuildArtifact does not support metric `${spec.metric}`"))
        }
    }
    &events.push(ProviderEvent.Complete{request_id: request.request_id, samples: sample_count})
    Ok(^events)
}
// Rust: Source/BudgetProviders.rs:505
ARTIFACT_RUNTIME_SAMPLES :: 20
// Rust: Source/BudgetProviders.rs:506
ARTIFACT_READY_DEADLINE :: Duration.from_secs(2)
// Rust: Source/BudgetProviders.rs:509
struct ArtifactRuntime { startup_ns: [Rational], memory_bytes: [Rational] }
// Rust: Source/BudgetProviders.rs:515
fn measure_artifact_runtime(path: OSPath, samples: USize) -> ArtifactRuntime ProviderFailure! {
    startup_ns := [Rational]{}
    memory_bytes := [Rational]{}
    loop trial in 0..<samples {
        started :: Instant.now()
        command := Command.new(path)
        command.stdin(Stdio.null()).stdout(Stdio.piped()).stderr(Stdio.null())
        if core.sys.target.selected_family() == "unix" -> command.process_group(0) // GATE #4494
        child := command.spawn().map_err(fn(error) { ProviderFailure.operation(.Execution, "cannot launch artifact for startup/RSS measurement: ${error}") })
        pid :: child.id()
        stdout :: child.stdout.take().ok_or_else(fn() { ProviderFailure.operation(.Execution, "artifact stdout was unavailable for its readiness line") })
        (ready_tx, ready_rx) :: mpsc.sync_channel(1) // GATE #4494
        reader :: std.thread.spawn(fn() {
            line := ""
            result :: BufReader.new(^stdout).read_line(&line).map_err(fn(error) { error.to_string() })
            _ :: ready_tx.send(^result)
        })
        deadline :: Instant.now() + ARTIFACT_READY_DEADLINE
        high_water := U64{0}
        ready_ns :: loop {
            if read_vm_hwm(pid) == { .Val(value) -> { high_water = high_water.max(value) }, .None -> {} }
            if ready_rx.try_recv() == {
                .Ok(.Ok(bytes)) -> {
                    if bytes > 0 {
                        if read_vm_hwm(pid) == { .Val(value) -> { high_water = high_water.max(value) }, .None -> {} }
                        high_water = high_water.max(stop_artifact(pid))
                        break started.elapsed().as_nanos()
                    }
                    _ :: reader.join()
                    return Err(ProviderFailure.operation(.Unavailable, "artifact exited without a readiness line"))
                }
                .Ok(.Err(error)) -> {
                    _ :: reader.join()
                    return Err(ProviderFailure.operation(.Unavailable, "artifact readiness read failed: ${error}"))
                }
                .Err(.Disconnected) -> {
                    _ :: reader.join()
                    return Err(ProviderFailure.operation(.Unavailable, "artifact readiness reader exited unexpectedly"))
                }
                .Err(.Empty) -> {}
            }
            if wait4_artifact(pid, true) == {
                .Val(value) -> {
                    high_water = high_water.max(value)
                    if ready_rx.recv_timeout(Duration.from_millis(100)) == {
                        .Ok(.Ok(bytes)) -> {
                            if bytes > 0 -> break started.elapsed().as_nanos()
                            return Err(ProviderFailure.operation(.Unavailable, "artifact exited without a readiness line"))
                        }
                        .Ok(.Err(error)) -> return Err(ProviderFailure.operation(.Unavailable, "artifact readiness read failed: ${error}")),
                        .Err(error) -> return Err(ProviderFailure.operation(.Unavailable, "artifact exited before its readiness line"))
                    }
                }
                .None -> {
                    if Instant.now() >= deadline {
                        _ :: stop_artifact(pid)
                        _ :: reader.join()
                        return Err(ProviderFailure.operation(.Timeout, "artifact did not emit a readiness line within 2 seconds"))
                    }
                }
            }
            std.thread.sleep(Duration.from_millis(1)) // GATE #4494
        }
        _ :: reader.join()
        if high_water == 0 -> return Err(ProviderFailure.operation(.Unavailable, "artifact exited before VmHWM could be observed"))
        &startup_ns.push(Rational.parse(ready_ns.to_string(), "1").map_err(ProviderFailure.malformed))
        &memory_bytes.push(Rational.parse(high_water.to_string(), "1").map_err(ProviderFailure.malformed))
    }
    Ok(ArtifactRuntime{startup_ns: ^startup_ns, memory_bytes: ^memory_bytes})
}
// Rust: Source/BudgetProviders.rs:649
struct ProcessUsage { status: I32, process_cpu_ns: U128, peak_rss_bytes: U64 }
// Rust: Source/BudgetProviders.rs:656
fn process_timeval_ns(seconds: I64, micros: I64, name: String) -> U128 ProviderFailure! {
    seconds_u :: U128.try_from(seconds).map_err(fn(error) { ProviderFailure.malformed("${name} seconds are negative") })
    micros_u :: U128.try_from(micros).map_err(fn(error) { ProviderFailure.malformed("${name} microseconds are negative") })
    if micros_u >= 1_000_000 -> return Err(ProviderFailure.malformed("${name} microseconds are outside 0..1_000_000"))
    seconds_u.checked_mul(1_000_000_000).and_then(fn(value) { value.checked_add(micros_u * 1000) }).ok_or_else(fn() { ProviderFailure.malformed("${name} overflowed nanoseconds") })
}
// Rust: Source/BudgetProviders.rs:677
// Rust: Source/BudgetProviders.rs:717
fn wait4_process(pid: U32, nonblocking: Bool) -> ProcessUsage? ProviderFailure! {
    if core.sys.target.selected_os() != "linux" {
        return Err(ProviderFailure.operation(.Unavailable, "process CPU child accounting requires Linux wait4 resource usage"))
    }
    status := I32{0}
    usage := [std.os.raw.CLong].repeat(0, 18)
    options :: if nonblocking { 1 } else { 0 }
    // Rust: Source/BudgetProviders.rs:681
    // GATE #4494: Linux wait4 ABI; #4483 selected-target c_long width.
    result :: #Unsafe("wait4 writes status and the Linux rusage buffer") {
        std.os.raw.wait4(pid as I32, &status, options, usage.as_mut_ptr())
    }
    if result == 0 -> return Ok(None)
    if result < 0 -> return Err(ProviderFailure.operation(.Execution, "cannot collect child resource usage: ${std.io.Error.last_os_error()}"))
    user_ns :: process_timeval_ns(usage[0], usage[1], "child ru_utime")
    system_ns :: process_timeval_ns(usage[2], usage[3], "child ru_stime")
    process_cpu_ns :: user_ns.checked_add(system_ns).ok_or_else(fn() { ProviderFailure.malformed("child process CPU time overflowed") })
    kib :: U64.try_from(usage[4]).map_err(fn(error) { ProviderFailure.malformed("child ru_maxrss is negative") })
    peak_rss_bytes :: kib.checked_mul(1024).ok_or_else(fn() { ProviderFailure.malformed("child ru_maxrss overflowed bytes") })
    Ok(Val(ProcessUsage{status: status, process_cpu_ns: process_cpu_ns, peak_rss_bytes: peak_rss_bytes}))
}
// Rust: Source/BudgetProviders.rs:725
fn wait4_artifact(pid: U32, nonblocking: Bool) -> U64? ProviderFailure! {
    Ok(wait4_process(pid, nonblocking).map(fn(usage) { usage.peak_rss_bytes }))
}
// Rust: Source/BudgetProviders.rs:730
fn stop_artifact(pid: U32) -> U64 ProviderFailure! {
    // Rust: Source/BudgetProviders.rs:734
    // GATE #4494: native kill of the entire child process group.
    #Unsafe("terminate the isolated artifact process group") {
        _ :: std.os.raw.kill(-(pid as I32), 9)
    }
    wait4_artifact(pid, false).ok_or_else(fn() { ProviderFailure.operation(.Execution, "artifact wait4 returned without reaping the process") })
}
// Rust: Source/BudgetProviders.rs:746
fn read_vm_hwm(pid: U32) -> U64? ProviderFailure! {
    path :: OSPath.new("/proc/${pid}/status")
    status :: if std.fs.read_to_string(path) == {
        .Ok(status) -> status,
        .Err(error) -> {
            if error.kind() == std.io.ErrorKind.NotFound -> return Ok(None)
            return Err(ProviderFailure.operation(.Unavailable, "cannot read ${path}: ${error}"))
        }
    }
    line :: status.lines().find(fn(line) { line.starts_with("VmHWM:") }) ?? return Ok(None)
    fields := line.split_whitespace()
    _ :: fields.next()
    kib :: fields.next().ok_or_else(fn() { ProviderFailure.malformed("artifact VmHWM has no value") }).parse[U64]().map_err(fn(error) { ProviderFailure.malformed("artifact VmHWM is not an integer") })
    if fields.next() != Val("kB") -> return Err(ProviderFailure.malformed("artifact VmHWM is not expressed in kB"))
    Ok(Val(kib.checked_mul(1024).ok_or_else(fn() { ProviderFailure.malformed("artifact VmHWM overflowed bytes") })))
}
