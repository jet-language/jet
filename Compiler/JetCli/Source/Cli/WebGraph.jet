// `jet explain --web-graph` and the `inspect expand --facts web` lens: the
// application graph of the entry's `run: fn` builder chain, read from the
// checked program. The chain is read as written; no user code runs and no
// source text is searched.
use {
    jet_driver.[JetDriverCompileResult, JetDriverDocModule, JetDriverVerbOutput, JET_DRIVER_EXIT_OK]
    jet_foundation.[AppRouteRoot, CallArg, Expr, Field, Func, Item, Span, StructDef, Type, UnOp, WebPartitionMarker]
    jet_foundation.[app_entry_run_fn, app_route_file_address, ast_visit_body, diagnostic_column_at, diagnostic_line_at, failure_contract_of_function, owned_trait_codec_marker, sha256_bytes, sha256_hex, type_name]
    jet_sema.[sema_app_canonical_route_path, sema_app_route_parts, sema_app_route_static_parts, sema_app_routes_overlap]
    jet_semindex.[semindex_function_key, semindex_sorted_unique]
}

// The middleware every server function runs behind, in order.
JET_CLI_WEB_MIDDLEWARE: [String]{"context", "auth", "csp", "logging", "observability"}

JetCLIWebField: struct {
    name: String
    ty: String
    codec: String
    required: Bool
    default: String?
}

JetCLIWebLoader: struct {
    handler: String
    data_type: String
    dependency: String
    preload: Bool
    cache_identity: String
}

JetCLIWebCapture: struct {
    name: String
    ty: String
    serializable: Bool
}

JetCLIWebIsland: struct {
    identity: String
    captures: [JetCLIWebCapture]
    serializable: Bool
}

JetCLIWebRoute: struct {
    path: String
    handler: String
    route_identity: String
    path_params: [JetCLIWebField]{[JetCLIWebField]{}}
    search_params: [JetCLIWebField]{[JetCLIWebField]{}}
    search_codec: String{"query"}
    loader: JetCLIWebLoader?{None}
    pending: String?{None}
    not_found: String?{None}
    error: String?{None}
    precedence: String
    // The builder's render spelling: csr, ssr, ssg, stream or island.
    render: String
    // Render facts: the mode is a fact mode (static, server, server+stream,
    // server+island, client).
    mode: String{"static"}
    reason: [String]{[String]{}}
    effects: [String]{[String]{}}
    interactive: Bool{false}
    data_loader: String?{None}
    form: String?{None}
    cache: String{"unspecified"}
    override_mode: String?{None}
    // Decimal text of the stable u64 boundary id.
    pending_boundary_id: String?{None}
    island: JetCLIWebIsland?{None}
    provenance: String
    span: Span
}

JetCLIWebContract: struct {
    input: String
    output: String
    error: String
    effects: [String]
    middleware: [String]
}

JetCLIWebAction: struct {
    name: String
    handler: String
    kind: String
    preload: Bool
    contract: JetCLIWebContract
    provenance: String
    span: Span
}

JetCLIWebFormField: struct {
    name: String
    ty: String
    required: Bool
    default: String?
    label: String
    control: String
}

JetCLIWebForm: struct {
    model: String
    action: String
    contract: JetCLIWebContract
    fields: [JetCLIWebFormField]
    provenance: String
}

JetCLIWebQuery: struct {
    key: String
    footprint: String
    source: String
    kind: String
}

JetCLIWebStore: struct {
    name: String
    source: String
    kind: String
    history_limit: String
}

JetCLIWebMount: struct {
    prefix: String
    handler: String
    effects: [String]
    security: [String]
    provenance: String
    span: Span
}

JetCLIWebRoot: struct {
    root: String
    span: Span
}

JetCLIWebGraph: struct {
    entry: String
    hydration: String{"dev-overlay"}
    routes: [JetCLIWebRoute]{[JetCLIWebRoute]{}}
    actions: [JetCLIWebAction]{[JetCLIWebAction]{}}
    forms: [JetCLIWebForm]{[JetCLIWebForm]{}}
    queries: [JetCLIWebQuery]{[JetCLIWebQuery]{}}
    stores: [JetCLIWebStore]{[JetCLIWebStore]{}}
    mounts: [JetCLIWebMount]{[JetCLIWebMount]{}}
    routes_from: [JetCLIWebRoot]{[JetCLIWebRoot]{}}
    security: [String]{[String]{}}
    assets: [String]{[String]{}}
    split: [String]{[String]{}}
    cache: [String]{[String]{}}
    a11y: [String]{[String]{}}
    adapters: [String]{[String]{}}
}

// The builder walk: the graph so far, the render mode later routes take, the
// explicit mode the next route takes, and whether an `app()` root was seen.
JetCLIWebWalk: struct {
    graph: JetCLIWebGraph
    render: String{"csr"}
    next_override: String?{None}
    found_app: Bool{false}
}

// ---- builder argument readers ----

jet_cli_web_const_text: fn(args: [CallArg], index: Int) -> String? {
    if index >= args.len() -> return None
    jet_cli_web_literal(args[index].expr)
}

jet_cli_web_literal: fn(expression: Expr) -> String? {
    if expression == .Str(parts, _, _) {
        text := ""
        loop part in parts {
            if part == .Lit(value) {
                text = "{text}{value}"
            } else {
                return None
            }
        }
        return Val(text)
    }
    None
}

// The text a constant default or literal argument spells on the wire.
jet_cli_web_wire_text: fn(expression: Expr?) -> String? {
    value: expression ?? return None
    if value == .Int(number, _, _, _, _) -> return Val("{number}")
    if value == .Float(number, _, _, _, _) -> return Val("{number}")
    if value == .Bool(flag, _, _) -> return Val(if flag -> "true" else -> "false")
    if value == .Char(text, _, _) -> return Val(text)
    jet_cli_web_literal(value)
}

jet_cli_web_const_int: fn(expression: Expr) -> Int? {
    if expression == .Int(number, _, _, _, _) -> return Val(number)
    if expression == .Paren(inner, _, _) -> return jet_cli_web_const_int(inner)
    if expression == .Unary(op, inner, _, _) && op == UnOp.Neg {
        number: jet_cli_web_const_int(inner) ?? return None
        return Val(0 - number)
    }
    None
}

jet_cli_web_handler: fn(args: [CallArg], index: Int) -> String? {
    if index >= args.len() -> return None
    if args[index].expr == .Ident(name, _, _) -> return Val(name)
    if args[index].expr == .Field(_, member, _, _) -> return Val(member)
    None
}

jet_cli_web_labeled_text: fn(args: [CallArg], label: String) -> String? {
    loop argument in args {
        if argument.label == .Val(given) && given.name == label -> return jet_cli_web_literal(argument.expr)
    }
    None
}

// A labeled boolean, else the last unlabeled boolean argument.
jet_cli_web_labeled_bool: fn(args: [CallArg], label: String) -> Bool {
    loop argument in args {
        if argument.label == .Val(given) && given.name == label {
            if argument.expr == .Bool(flag, _, _) -> return flag
            return false
        }
    }
    loop index in 0..<args.len() {
        argument: args[args.len() - 1 - index]
        if argument.label != None -> next
        if argument.expr == .Bool(flag, _, _) -> return flag
        return false
    }
    false
}

// ---- render modes, cache facts and identities ----

jet_cli_web_mode_parse: fn(name: String) -> String? {
    if name == "static" || name == "Static" || name == "ssg" -> return Val("static")
    if name == "server" || name == "Server" || name == "ssr" -> return Val("server")
    if name == "server+stream" || name == "ServerStream" || name == "Stream" || name == "stream" || name == "streaming" -> return Val("server+stream")
    if name == "server+island" || name == "ServerIsland" || name == "Island" || name == "island" -> return Val("server+island")
    if name == "client" || name == "Client" || name == "csr" -> return Val("client")
    None
}

// The builder spelling of a fact mode.
jet_cli_web_legacy_mode: fn(mode: String) -> String {
    if mode == {
        "static" -> "ssg"
        "server" -> "ssr"
        "server+stream" -> "stream"
        "server+island" -> "island"
        else -> "csr"
    }
}

jet_cli_web_cache_parse: fn(policy: String) -> String? {
    if policy == "immutable" || policy == "static" -> return Val("immutable")
    if policy == "revalidate" || policy == "stream" -> return Val("revalidate")
    if policy == "private" || policy == "no-store" -> return Val("private")
    None
}

jet_cli_web_identity_key: fn(kind: String, path: String, handler: String) -> String {
    nul: String.from_bytes([U8{0}]) ?? ""
    "jet:{kind}:v1:{path}{nul}{handler}"
}

jet_cli_web_route_identity: fn(path: String, handler: String) -> String {
    "route-{sha256_hex(jet_cli_web_identity_key("route", path, handler)).slice(0, 24)}"
}

jet_cli_web_island_identity: fn(path: String, handler: String) -> String {
    "island-{sha256_hex(jet_cli_web_identity_key("island", path, handler)).slice(0, 24)}"
}

// The first eight digest bytes as a big-endian u64, in decimal.
jet_cli_web_pending_boundary_id: fn(path: String, handler: String) -> String {
    bytes: jet_cli_web_identity_key("pending-boundary", path, handler).bytes()
    digest: sha256_bytes(bytes[0..<bytes.len()])
    number := [Int]{}
    loop index in 0..<8 -> number.push(Int.from_u8(digest[index]))
    digits := ""
    more := true
    loop more {
        remainder := 0
        more = false
        loop index in 0..<number.len() {
            current: remainder * 256 + number[index]
            number[index] = current /% 10
            remainder = current - (current /% 10) * 10
            if number[index] != 0 -> more = true
        }
        digits = "{remainder}{digits}"
    }
    digits
}

jet_cli_web_precedence_name: fn(path: String) -> String {
    loop part in sema_app_route_parts(path) {
        if part.kind != 0 -> return "static-before-dynamic"
    }
    "static"
}

jet_cli_web_same_precedence: fn(left: String, right: String) -> Bool {
    sema_app_route_static_parts(left) == sema_app_route_static_parts(right) && sema_app_route_parts(left).len() == sema_app_route_parts(right).len()
}

jet_cli_web_new_route: fn(path: String, handler: String, render: String, override_mode: String?, provenance: String, span: Span) -> JetCLIWebRoute {
    route := JetCLIWebRoute{path: path, handler: handler, route_identity: jet_cli_web_route_identity(path, handler), precedence: jet_cli_web_precedence_name(path), render: render, provenance: provenance, span: span}
    if override_mode == .Val(mode) {
        route.mode = mode
        route.reason = [String]{"explicit render mode `{mode}`"}
        route.override_mode = Val(mode)
    }
    route
}

// The first registration of a path owns it; an equally specific overlapping
// pattern has no deterministic owner and is left out (check reports both).
jet_cli_web_record_route: fn(walk: &JetCLIWebWalk, route: &&JetCLIWebRoute) {
    loop previous in walk.graph.routes {
        if previous.path == route.path -> return
        if sema_app_routes_overlap(previous.path, route.path) && jet_cli_web_same_precedence(previous.path, route.path) -> return
    }
    walk.graph.routes.push(route)
}

// ---- user declarations ----

jet_cli_web_collect_functions: fn(items: [Item], out: &[Func]) {
    loop item in items {
        if item == {
            .Func(function) -> out.push(function.copy())
            .CodeModule(module_value) -> {
                if module_value.body == .Val(body) -> jet_cli_web_collect_functions(body, out)
            }
            else -> {}
        }
    }
}

jet_cli_web_user_functions: fn(modules: [JetDriverDocModule]) -> [Func] {
    functions := [Func]{}
    loop doc_module in modules {
        if doc_module.alias == "" -> jet_cli_web_collect_functions(doc_module.items, functions)
    }
    functions
}

jet_cli_web_function: fn(functions: [Func], name: String) -> Func? {
    loop function in functions {
        if function.name == name -> return Val(function)
    }
    None
}

jet_cli_web_find_struct: fn(items: [Item], name: String) -> StructDef? {
    loop item in items {
        if item == {
            .Struct(definition) -> {
                if definition.name == name -> return Val(definition)
            }
            .CodeModule(module_value) -> {
                if module_value.body == .Val(body) {
                    if jet_cli_web_find_struct(body, name) == .Val(found) -> return Val(found)
                }
            }
            else -> {}
        }
    }
    None
}

jet_cli_web_struct: fn(modules: [JetDriverDocModule], name: String) -> StructDef? {
    loop doc_module in modules {
        if doc_module.alias != "" -> next
        if jet_cli_web_find_struct(doc_module.items, name) == .Val(found) -> return Val(found)
    }
    None
}

// A codec derive: a codec trait or a family of them (OWNED_TRAITS).
jet_cli_web_has_serde_derive: fn(derives: [String]) -> Bool {
    loop name in derives {
        if owned_trait_codec_marker(name) -> return true
    }
    false
}

jet_cli_web_collect_serializable: fn(items: [Item], out: &[String]) {
    loop item in items {
        if item == {
            .Struct(definition) -> {
                names: loop named in definition.derives -> named.name
                if jet_cli_web_has_serde_derive(names) -> out.push(definition.name)
            }
            .Enum(definition) -> {
                names: loop named in definition.derives -> named.name
                if jet_cli_web_has_serde_derive(names) -> out.push(definition.name)
            }
            .CodeModule(module_value) -> {
                if module_value.body == .Val(body) -> jet_cli_web_collect_serializable(body, out)
            }
            else -> {}
        }
    }
}

// Whether a value of `ty` can cross into a resumed island payload.
jet_cli_web_resumable: fn(ty: Type, named: [String]) -> Bool {
    if ty == {
        .Int | .Float | .Bool | .String | .Char | .IntN(_, _) | .Float32 | .Measure(_) -> true
        .List(inner) | .Shared(inner) | .Option(inner) -> jet_cli_web_resumable(inner, named)
        .InlineRange(inner, _, _) | .Tagged(_, inner) | .Quantity(inner, _) -> jet_cli_web_resumable(inner, named)
        .FixedList(inner, _) -> jet_cli_web_resumable(inner, named)
        .Map(key, _, value) -> key == Type.String && jet_cli_web_resumable(value, named)
        .Result(ok, err) -> jet_cli_web_resumable(ok, named) && jet_cli_web_resumable(err, named)
        .Tuple(fields) -> {
            loop field in fields {
                if !jet_cli_web_resumable(field.ty, named) -> return false
            }
            true
        }
        .Union(members) -> {
            loop member in members {
                if !jet_cli_web_resumable(member, named) -> return false
            }
            true
        }
        .Named(name) -> name == "Dyn" || name == "JSON" || name == "Date" || name == "DateTime" || name == "ZonedDateTime" || name == "Decimal" || name == "Duration" || name == "Unit" || named.contains(name)
        .Apply(name, args) -> {
            if !named.contains(name) -> return false
            loop argument in args {
                if !jet_cli_web_resumable(argument, named) -> return false
            }
            true
        }
        .Fn(_, _, _, _, _, _) | .TraitObject(_) -> false
    }
}

// The wire contract of a server function named `name`.
jet_cli_web_contract: fn(function: Func?) -> JetCLIWebContract {
    known: function ?? return JetCLIWebContract{input: "", output: "", error: "", effects: [String]{}, middleware: [String]{}}
    params := [String]{}
    loop parameter in known.params {
        if parameter.name != "self" -> params.push("{parameter.name}:{type_name(parameter.ty)}")
    }
    input := "Unit"
    if params.len() == 1 {
        loop parameter in known.params {
            if parameter.name != "self" -> input = type_name(parameter.ty)
        }
    } else if params.len() > 1 {
        input = "({params.join(",")})"
    }
    output := ""
    error := ""
    if failure_contract_of_function(known.return_type, known.return_type_span) == {
        .Default(success, failure) | .Explicit(success, failure) | .Inferred(success, failure) -> {
            output = type_name(success)
            error = type_name(failure)
        }
        .Optional(success) | .ProvenUnreachable(success) | .InferredNever(success) -> {
            output = type_name(success)
            error = "Never"
        }
        .DeclaredNever -> {
            output = "Never"
            error = "Never"
        }
        .Converted(success, _, target) -> {
            output = type_name(success)
            error = type_name(target)
        }
    }
    effects := [String]{}
    if known.declared_effects == .Val(entries) {
        loop entry in entries -> effects.push(entry.name)
    }
    JetCLIWebContract{input: input, output: output, error: error, effects: effects, middleware: JET_CLI_WEB_MIDDLEWARE.copy()}
}

// The solved effect row of `name`: the entry module's own function first, then
// any user module's; a function sema did not summarize keeps its declared row.
jet_cli_web_function_effects: fn(modules: [JetDriverDocModule], entry_identity: String, function: Func) -> [String] {
    loop pass in 0..<2 {
        loop doc_module in modules {
            if pass == 0 && doc_module.module_identity != entry_identity -> next
            loop body in doc_module.functions {
                if body.synthetic -> next
                key: semindex_function_key(body.key) ?? next
                if key.local == function.name || (pass == 1 && key.local.ends_with("::{function.name}")) -> return body.effects.solved.copy()
            }
        }
    }
    effects := [String]{}
    if function.declared_effects == .Val(entries) {
        loop entry in entries -> effects.push(entry.name)
    }
    effects
}

// ---- the builder walk ----

jet_cli_web_is_app_receiver: fn(expression: Expr) -> Bool {
    if expression == .Ident(name, _, _) -> return name == "web" || name == "core.web"
    if expression == .Field(base, member, _, _) && member == "web" {
        if base == .Ident(name, _, _) -> return name == "core"
    }
    false
}

jet_cli_web_walk: fn(expression: Expr, walk: &JetCLIWebWalk, functions: [Func]) {
    if expression == {
        .MethodCall(receiver, method, method_span, _, _, args, _) -> {
            if method == "app" && args.len() == 0 && jet_cli_web_is_app_receiver(receiver) {
                walk.found_app = true
                return
            }
            jet_cli_web_walk(receiver, walk, functions)
            jet_cli_web_apply(method, args, method_span, walk, functions)
        }
        .Copy(inner, _, _) | .Paren(inner, _, _) | .Ok(inner, _, _) -> jet_cli_web_walk(inner, walk, functions)
        .Place(inner, _, _, _) -> jet_cli_web_walk(inner, walk, functions)
        .Call(call, _) -> {
            if (call.name == "app" || call.name == "web.app" || call.name == "core.web.app") && call.args.len() == 0 {
                walk.found_app = true
                return
            }
            loop argument in call.args -> jet_cli_web_walk(argument.expr, walk, functions)
        }
        else -> {}
    }
}

jet_cli_web_apply: fn(method: String, args: [CallArg], span: Span, walk: &JetCLIWebWalk, functions: [Func]) {
    if method == "route" || method == "page" || method == "layout" {
        path: sema_app_canonical_route_path(jet_cli_web_const_text(args, 0) ?? "/")
        handler: jet_cli_web_handler(args, 1) ?? "<dynamic>"
        override_mode: walk.next_override
        walk.next_override = None
        render: walk.render.copy()
        jet_cli_web_record_route(walk, jet_cli_web_new_route(path, handler, render, override_mode, "builder", span))
        return
    }
    if method == "action" || method == "form" || method == "data" || method == "loader" {
        name := jet_cli_web_const_text(args, 0) ?? method
        if method == "loader" -> name = jet_cli_web_handler(args, 0) ?? jet_cli_web_const_text(args, 0) ?? method
        handler: jet_cli_web_handler(args, 1) ?? "<dynamic>"
        preload: method == "loader" && jet_cli_web_labeled_bool(args, "preload")
        contract: jet_cli_web_contract(jet_cli_web_function(functions, handler))
        walk.graph.actions.push(JetCLIWebAction{name: name, handler: handler, kind: method, preload: preload, contract: contract, provenance: "builder", span: span})
        return
    }
    if method == "pending" || method == "not_found" || method == "error" {
        handler: jet_cli_web_handler(args, 0) ?? "<dynamic>"
        last: walk.graph.routes.len() - 1
        if last < 0 -> return
        if method == {
            "pending" -> walk.graph.routes[last].pending = Val(handler)
            "not_found" -> walk.graph.routes[last].not_found = Val(handler)
            else -> walk.graph.routes[last].error = Val(handler)
        }
        return
    }
    if method == "mount" {
        effects := [String]{}
        security := [String]{}
        if jet_cli_web_const_text(args, 2) == .Val(row) -> effects.push(row)
        if jet_cli_web_const_text(args, 3) == .Val(rule) -> security.push(rule)
        walk.graph.mounts.push(JetCLIWebMount{prefix: jet_cli_web_const_text(args, 0) ?? "/", handler: jet_cli_web_handler(args, 1) ?? "<mount>", effects: effects, security: security, provenance: "builder", span: span})
        return
    }
    if method == "routes" {
        root: jet_cli_web_labeled_text(args, "from") ?? jet_cli_web_const_text(args, 0) ?? ""
        if root != "" -> walk.graph.routes_from.push(JetCLIWebRoot{root: root, span: span})
        return
    }
    if method == "csr" || method == "ssr" || method == "ssg" || method == "stream" || method == "streaming" || method == "island" {
        legacy: if method == "streaming" -> "stream" else -> method
        walk.render = legacy
        walk.next_override = jet_cli_web_mode_parse(legacy)
        return
    }
    if method == "render" {
        spelled: jet_cli_web_const_text(args, 0) ?? jet_cli_web_handler(args, 0) ?? return
        mode: jet_cli_web_mode_parse(spelled) ?? return
        legacy: jet_cli_web_legacy_mode(mode)
        walk.render = legacy
        walk.next_override = Val(mode)
        last: walk.graph.routes.len() - 1
        if last >= 0 {
            walk.graph.routes[last].render = legacy
            walk.graph.routes[last].mode = mode
            walk.graph.routes[last].reason = [String]{"explicit render mode `{mode}`"}
            walk.graph.routes[last].override_mode = Val(mode)
            walk.graph.routes[last].cache = "unspecified"
        }
        return
    }
    if method == "cache" {
        if jet_cli_web_const_text(args, 1) == .Val(policy) {
            last: walk.graph.routes.len() - 1
            if last >= 0 && jet_cli_web_const_text(args, 0) == .Val(target) && target == walk.graph.routes[last].path {
                if jet_cli_web_cache_parse(policy) == .Val(cache) -> walk.graph.routes[last].cache = cache
            }
            walk.graph.cache.push(policy)
        } else if jet_cli_web_const_text(args, 0) == .Val(policy) {
            walk.graph.cache.push(policy)
        }
        return
    }
    if method == "hydration_release" -> walk.graph.hydration = "release-keep-server"
    if method == "hydration_dev" -> walk.graph.hydration = "dev-overlay"
    value: jet_cli_web_const_text(args, 0) ?? return
    if method == {
        "security" -> walk.graph.security.push(value)
        "assets" -> walk.graph.assets.push(value)
        "split" | "code_split" -> walk.graph.split.push(value)
        "a11y" -> walk.graph.a11y.push(value)
        "adapter" -> walk.graph.adapters.push(value)
        else -> {}
    }
}

jet_cli_web_walk_run: fn(run: Func, walk: &JetCLIWebWalk, functions: [Func]) {
    loop statement in run.body {
        if statement == {
            .Expr(expression) -> jet_cli_web_walk(expression, walk, functions)
            .Return(value, _) -> {
                if value == .Val(expression) -> jet_cli_web_walk(expression, walk, functions)
            }
            .Val(binding) -> jet_cli_web_walk(binding.init, walk, functions)
            .Assign(_, _, _, value) -> jet_cli_web_walk(value, walk, functions)
            else -> {}
        }
    }
}

// `.routes(from:)`: every `page: fn` file under a found root, in path order,
// with the render mode in force at the end of the chain.
jet_cli_web_expand_roots: fn(walk: &JetCLIWebWalk, roots: [AppRouteRoot]) {
    render: walk.render.copy()
    override_mode: walk.next_override.copy()
    sources: walk.graph.routes_from.copy()
    loop given in sources {
        loop root in roots {
            if root.root != given.root || !root.found -> next
            loop file in root.files {
                if !file.has_page -> next
                address: app_route_file_address(file.path)
                if address.bad_part != None -> next
                stem: if file.path.ends_with(".jet") -> file.path.slice(0, file.path.len() - 4) else -> file.path
                handler: stem.replace("/", "_").replace("\\", "_").replace("[", "_").replace("]", "_")
                jet_cli_web_record_route(walk, jet_cli_web_new_route(address.path, handler, render.copy(), override_mode.copy(), "{given.root}/{file.path}", given.span))
            }
            break
        }
    }
}

jet_cli_web_action_matches: fn(path: String, handler: String, action: JetCLIWebAction) -> Bool {
    action.name == path || action.name == handler || action.name == "*" || (path == "/" && action.name == "")
}

jet_cli_web_route_codec: fn(ty: Type) -> String {
    if ty == {
        .Option(inner) -> jet_cli_web_route_codec(inner)
        .Int | .IntN(_, _) -> "int"
        .Float -> "float"
        .Bool -> "bool"
        .Named(name) -> if name == "JSON" || name == "Dyn" -> "json" else -> "string"
        else -> "string"
    }
}

jet_cli_web_is_option: fn(ty: Type) -> Bool {
    if ty == .Option(_) -> return true
    false
}

jet_cli_web_named: fn(ty: Type) -> String? {
    if ty == .Named(name) -> return Val(name)
    if ty == .Option(inner) -> return jet_cli_web_named(inner)
    None
}

jet_cli_web_route_field: fn(name: String, ty: Type, default: Expr?, required: Bool) -> JetCLIWebField {
    JetCLIWebField{name: name, ty: type_name(ty), codec: jet_cli_web_route_codec(ty), required: required, default: jet_cli_web_wire_text(default)}
}

// The handler of a route: the named function, else the `page: fn` of the
// convention file the route came from.
jet_cli_web_route_function: fn(modules: [JetDriverDocModule], functions: [Func], route: JetCLIWebRoute) -> Func? {
    if jet_cli_web_function(functions, route.handler) == .Val(found) -> return Val(found)
    loop doc_module in modules {
        if doc_module.alias != "" || !doc_module.path.ends_with(route.provenance) -> next
        page := [Func]{}
        jet_cli_web_collect_functions(doc_module.items, page)
        return jet_cli_web_function(page, "page")
    }
    None
}

// Path parameters by name, then one search binding: a struct record (its
// fields under the JSON codec) or a `search`/`query` input.
jet_cli_web_route_inputs: fn(modules: [JetDriverDocModule], function: Func, route: &JetCLIWebRoute) {
    used := [Int]{}
    loop part in sema_app_route_parts(route.path) {
        if part.kind == 0 -> next
        loop (index, parameter) in function.params {
            if parameter.name != part.name || used.contains(index) -> next
            used.push(index)
            route.path_params.push(jet_cli_web_route_field(parameter.name, parameter.ty, parameter.default, true))
            break
        }
    }
    loop (index, parameter) in function.params {
        if used.contains(index) || parameter.name == "data" -> next
        record := StructDef?{None}
        if jet_cli_web_named(parameter.ty) == .Val(name) -> record = jet_cli_web_struct(modules, name)
        if record == None && parameter.name != "search" && parameter.name != "query" -> next
        if record == .Val(definition) {
            fields := [JetCLIWebField]{}
            loop field in definition.fields {
                if field.computed != None -> next
                fields.push(jet_cli_web_route_field(field.name, field.ty, field.default, !jet_cli_web_is_option(field.ty) && field.default == None))
            }
            route.search_params = fields
            route.search_codec = "json"
        } else {
            route.search_params = [JetCLIWebField]{jet_cli_web_route_field(parameter.name, parameter.ty, parameter.default, !jet_cli_web_is_option(parameter.ty) && parameter.default == None)}
        }
        return
    }
}

jet_cli_web_route_contracts: fn(modules: [JetDriverDocModule], functions: [Func], graph: &JetCLIWebGraph) {
    loop index in 0..<graph.routes.len() {
        path: graph.routes[index].path
        handler: graph.routes[index].handler
        loader_index := -1
        loop (action_index, action) in graph.actions {
            if (action.kind == "loader" || action.kind == "data") && jet_cli_web_action_matches(path, handler, action) -> loader_index = action_index
        }
        if loader_index >= 0 {
            action: graph.actions[loader_index]
            data_type := if action.contract.output == "" -> "Unit" else -> action.contract.output
            if jet_cli_web_function(functions, action.handler) == .Val(loader) && loader.return_type == .Val(returned) {
                data_type = if returned == .Result(ok, _) -> type_name(ok) else -> type_name(returned)
            }
            graph.routes[index].loader = Val(JetCLIWebLoader{handler: action.handler, data_type: data_type, dependency: if action.name == "" -> action.handler else -> action.name, preload: action.preload, cache_identity: graph.routes[index].route_identity})
        }
        if jet_cli_web_route_function(modules, functions, graph.routes[index]) == .Val(function) -> jet_cli_web_route_inputs(modules, function, graph.routes[index])
    }
}

jet_cli_web_sort_routes: fn(routes: &[JetCLIWebRoute]) {
    routes = loop fresh_item in routes -> fresh_item
    routes.sort_by((left: JetCLIWebRoute, right: JetCLIWebRoute) -> (sema_app_route_static_parts(right.path) <=> sema_app_route_static_parts(left.path)).then(sema_app_route_parts(right.path).len() <=> sema_app_route_parts(left.path).len()).then(left.path <=> right.path).then(left.handler <=> right.handler))
}

jet_cli_web_effect_root: fn(effect_name: String) -> String {
    effect_name.split(".").to_list()[0]
}

jet_cli_web_render_facts: fn(modules: [JetDriverDocModule], entry_identity: String, functions: [Func], serializable: [String], graph: &JetCLIWebGraph) {
    policy_cache := String?{None}
    loop policy in graph.cache {
        if jet_cli_web_cache_parse(policy) == .Val(cache) -> policy_cache = Val(cache)
    }
    loop index in 0..<graph.routes.len() {
        path: graph.routes[index].path
        handler: graph.routes[index].handler
        handler_fn: jet_cli_web_function(functions, handler)
        effects := [String]{}
        captures_from := [Func]{}
        if handler_fn == .Val(function) {
            loop row in jet_cli_web_function_effects(modules, entry_identity, function) -> effects.push(row)
            captures_from.push(function.copy())
        }
        loader := String?{None}
        form := String?{None}
        loop action in graph.actions {
            if !jet_cli_web_action_matches(path, handler, action) -> next
            is_form: action.kind == "form" || action.kind == "action"
            if action.kind == "data" || action.kind == "loader" -> loader = Val(action.handler)
            if is_form -> form = Val(action.handler)
            if jet_cli_web_function(functions, action.handler) == .Val(function) {
                loop row in jet_cli_web_function_effects(modules, entry_identity, function) -> effects.push(row)
                if is_form -> captures_from.push(function)
            }
        }
        effects = semindex_sorted_unique(effects)
        browser := false
        runtime := false
        loop row in effects {
            root: jet_cli_web_effect_root(row)
            if root == "Browser" -> browser = true
            if ["DB", "FS", "Net", "IO", "Time", "Rand", "Env", "Exec", "Secret", "RequestContext"].contains(root) -> runtime = true
        }
        reactive := false
        if handler_fn == .Val(function) {
            if function.web_marker == .Val(marker) && marker == WebPartitionMarker.JS -> browser = true
            reactive = function.is_reactive
        }
        interactive: browser || reactive || form != None
        derived: if {
            browser -> "client"
            interactive -> "server+island"
            loader != None -> "server+stream"
            runtime -> "server"
            else -> "static"
        }
        override_mode: graph.routes[index].override_mode
        mode: override_mode ?? derived
        reason := [String]{}
        if override_mode == .Val(explicit) {
            reason.push("explicit render mode `{explicit}`")
        } else {
            if browser -> reason.push("handler `{handler}` reaches Browser")
            if reactive -> reason.push("handler `{handler}` is reactive")
            if loader == .Val(name) -> reason.push("loader `{name}` supplies runtime data")
            if form == .Val(name) -> reason.push("form/action `{name}` adds interactivity")
            if runtime && loader == None -> reason.push("handler `{handler}` reaches runtime effect(s): {effects.join(", ")}")
            if reason.len() == 0 -> reason.push("handler `{handler}` has no runtime data or interactivity")
        }
        if graph.routes[index].cache == "unspecified" && policy_cache == .Val(cache) -> graph.routes[index].cache = cache
        island_mode: mode == "server+island" || mode == "client"
        if interactive || island_mode {
            captures := [JetCLIWebCapture]{}
            loop function in captures_from {
                loop parameter in function.params {
                    known := false
                    loop capture in captures {
                        if capture.name == parameter.name -> known = true
                    }
                    if !known -> captures.push(JetCLIWebCapture{name: parameter.name, ty: type_name(parameter.ty), serializable: jet_cli_web_resumable(parameter.ty, serializable)})
                }
            }
            captures.sort_by((left: JetCLIWebCapture, right: JetCLIWebCapture) -> left.name <=> right.name)
            all := true
            loop capture in captures {
                if !capture.serializable -> all = false
            }
            graph.routes[index].island = Val(JetCLIWebIsland{identity: jet_cli_web_island_identity(path, handler), captures: captures, serializable: all})
        }
        if mode == "server+stream" || mode == "server+island" -> graph.routes[index].pending_boundary_id = Val(jet_cli_web_pending_boundary_id(path, handler))
        graph.routes[index].mode = mode
        graph.routes[index].reason = reason
        graph.routes[index].effects = effects
        graph.routes[index].interactive = interactive || island_mode
        graph.routes[index].data_loader = loader
        graph.routes[index].form = form
    }
}

// ---- queries, stores and forms over every user function ----

jet_cli_web_is_namespace: fn(expression: Expr, member: String) -> Bool {
    if expression == .Ident(name, _, _) -> return name == member || name == ("web.{member}") || name == ("core.web.{member}")
    if expression == .Field(base, field, _, _) && field == member {
        if base == .Ident(name, _, _) -> return name == "web" || name == "core.web"
        return false
    }
    if expression == .Paren(inner, _, _) -> return jet_cli_web_is_namespace(inner, member)
    false
}

// A query or store call: its kind and arguments.
JetCLIWebNamespaceCall: struct {
    kind: String
    args: [CallArg]
}

jet_cli_web_namespace_call: fn(expression: Expr, member: String) -> JetCLIWebNamespaceCall? {
    if expression == .Call(call, _) {
        name: call.name
        if member == "query" {
            if name == "query.live" || name == "web.query.live" || name == "core.web.query.live" -> return Val(JetCLIWebNamespaceCall{kind: "live", args: call.args})
            if name == "query.subscribe" || name == "web.query.subscribe" || name == "core.web.query.subscribe" -> return Val(JetCLIWebNamespaceCall{kind: "subscribe", args: call.args})
            return None
        }
        if name == "store" || name == "web.store" || name == "core.web.store" -> return Val(JetCLIWebNamespaceCall{kind: "default", args: call.args})
        if name == "store.with_history" || name == "web.store.with_history" || name == "core.web.store.with_history" -> return Val(JetCLIWebNamespaceCall{kind: "with_history", args: call.args})
        return None
    }
    if expression == .MethodCall(receiver, method, _, _, _, args, _) && jet_cli_web_is_namespace(receiver, member) {
        if member == "query" {
            if method == "live" || method == "subscribe" -> return Val(JetCLIWebNamespaceCall{kind: method, args: args})
            return None
        }
        if method == "new" -> return Val(JetCLIWebNamespaceCall{kind: "default", args: args})
        if method == "with_history" -> return Val(JetCLIWebNamespaceCall{kind: "with_history", args: args})
    }
    None
}

jet_cli_web_form_model: fn(expression: Expr) -> String? {
    if expression == {
        .Ident(name, _, _) -> Val(name)
        .Paren(inner, _, _) -> jet_cli_web_form_model(inner)
        .OrFallback(inner, _, _, _, _) -> jet_cli_web_form_model(inner)
        .MethodCall(_, method, _, _, _, args, _) -> if method == "input" -> jet_cli_web_const_text(args, 0) else -> None
        .Call(call, _) -> if call.name == "input" || call.name.ends_with(".input") -> jet_cli_web_const_text(call.args, 0) else -> None
        else -> None
    }
}

jet_cli_web_form_label: fn(name: String) -> String {
    words := [String]{}
    loop part in name.split("_") {
        if part == "" -> next
        words.push("{part.slice(0, 1).upper()}{part.slice(1, part.len())}")
    }
    words.join(" ")
}

jet_cli_web_form: fn(modules: [JetDriverDocModule], functions: [Func], call_args: [CallArg], source: String) -> JetCLIWebForm? {
    if call_args.len() != 2 -> return None
    action_index := 1
    loop (index, argument) in call_args {
        if argument.label == .Val(given) && given.name == "action" {
            action_index = index
            break
        }
    }
    model: jet_cli_web_form_model(call_args[if action_index == 0 -> 1 else -> 0].expr) ?? return None
    action: jet_cli_web_const_text(call_args, action_index) ?? jet_cli_web_handler(call_args, action_index) ?? return None
    if model == "" || action == "" -> return None
    record: jet_cli_web_struct(modules, model) ?? return None
    fields := [JetCLIWebFormField]{}
    loop field in record.fields {
        if field.computed != None -> next
        base: if field.ty == .Option(inner) -> inner else -> field.ty
        ty := type_name(base)
        control := "Text"
        if base == {
            .Int | .IntN(_, _) -> {
                ty = "Int"
                control = "Number"
            }
            .Float -> {
                ty = "Float"
                control = "Number"
            }
            .Bool -> {
                ty = "Bool"
                control = "Checkbox"
            }
            .String -> ty = "String"
            else -> {}
        }
        fields.push(JetCLIWebFormField{name: field.name, ty: ty, required: !jet_cli_web_is_option(field.ty) && field.default == None, default: jet_cli_web_wire_text(field.default), label: jet_cli_web_form_label(field.name), control: control})
    }
    Val(JetCLIWebForm{model: model, action: action, contract: jet_cli_web_contract(jet_cli_web_function(functions, action)), fields: fields, provenance: source})
}

jet_cli_web_query: fn(expression: Expr, source: String) -> JetCLIWebQuery? {
    found: jet_cli_web_namespace_call(expression, "query") ?? return None
    key := ""
    footprint := ""
    if found.kind == "live" {
        key = jet_cli_web_const_text(found.args, 0) ?? ""
        footprint = jet_cli_web_const_text(found.args, 1) ?? ""
    } else if jet_cli_web_const_text(found.args, 0) == .Val(named) {
        key = named
        footprint = "ext:{named}"
    }
    if key.trim() == "" || footprint.trim() == "" -> return None
    Val(JetCLIWebQuery{key: key, footprint: footprint, source: source, kind: found.kind})
}

jet_cli_web_store: fn(expression: Expr, source: String) -> JetCLIWebStore? {
    found: jet_cli_web_namespace_call(expression, "store") ?? return None
    name: jet_cli_web_const_text(found.args, 0) ?? return None
    if name.trim() == "" -> return None
    limit := "default"
    if found.kind == "with_history" {
        limit = "<dynamic>"
        if found.args.len() > 2 && jet_cli_web_const_int(found.args[2].expr) == .Val(count) -> limit = "{count}"
    }
    Val(JetCLIWebStore{name: name, source: source, kind: found.kind, history_limit: limit})
}

// The query, store and form calls one walk over the user functions found.
JetCLIWebUses: struct {
    queries: [JetCLIWebQuery]
    stores: [JetCLIWebStore]
    forms: [JetCLIWebForm]
}

jet_cli_web_note_use: fn(uses: &JetCLIWebUses, expression: Expr, modules: [JetDriverDocModule], functions: [Func], source: String) {
    if jet_cli_web_query(expression, source) == .Val(fact) -> uses.queries.push(fact)
    if jet_cli_web_store(expression, source) == .Val(fact) -> uses.stores.push(fact)
    if expression == .Call(call, _) && (call.name == "form" || call.name == "web.form" || call.name == "core.web.form") {
        if jet_cli_web_form(modules, functions, call.args, source) == .Val(fact) -> uses.forms.push(fact)
    }
}

jet_cli_web_collect_uses: fn(modules: [JetDriverDocModule], functions: [Func], graph: &JetCLIWebGraph) {
    uses := JetCLIWebUses{queries: [JetCLIWebQuery]{}, stores: [JetCLIWebStore]{}, forms: [JetCLIWebForm]{}}
    loop function in functions -> ast_visit_body(function.body, (expression: Expr) -> jet_cli_web_note_use(uses, expression, modules, functions, function.name), true)
    queries := uses.queries
    stores := uses.stores
    forms: uses.forms
    queries.sort_by((left: JetCLIWebQuery, right: JetCLIWebQuery) -> (left.key <=> right.key).then(left.footprint <=> right.footprint).then(left.source <=> right.source).then(left.kind <=> right.kind))
    loop fact in queries {
        last: graph.queries.len() - 1
        if last >= 0 && graph.queries[last].key == fact.key && graph.queries[last].footprint == fact.footprint && graph.queries[last].source == fact.source && graph.queries[last].kind == fact.kind -> next
        graph.queries.push(fact)
    }
    stores.sort_by((left: JetCLIWebStore, right: JetCLIWebStore) -> (left.name <=> right.name).then(left.source <=> right.source).then(left.kind <=> right.kind).then(left.history_limit <=> right.history_limit))
    loop fact in stores {
        last: graph.stores.len() - 1
        if last >= 0 && graph.stores[last].name == fact.name && graph.stores[last].source == fact.source && graph.stores[last].kind == fact.kind && graph.stores[last].history_limit == fact.history_limit -> next
        graph.stores.push(fact)
    }
    // One fact per (model, action, function); the first call site wins.
    kept := [JetCLIWebForm]{}
    loop fact in forms {
        seen := false
        loop earlier in kept {
            if earlier.model == fact.model && earlier.action == fact.action && earlier.provenance == fact.provenance -> seen = true
        }
        if !seen -> kept.push(fact.copy())
    }
    kept.sort_by((left: JetCLIWebForm, right: JetCLIWebForm) -> (left.model <=> right.model).then(left.action <=> right.action).then(left.provenance <=> right.provenance))
    graph.forms = kept
}

// The application graph of the checked entry, or None when the entry has no
// app `run: fn`.
jet_cli_web_graph: fn(modules: [JetDriverDocModule], entry_identity: String) -> JetCLIWebGraph? {
    entry_index := -1
    loop (index, doc_module) in modules {
        if doc_module.module_identity == entry_identity -> entry_index = index
    }
    if entry_index < 0 -> return None
    entry: modules[entry_index]
    functions: jet_cli_web_user_functions(modules)
    walk := JetCLIWebWalk{graph: JetCLIWebGraph{entry: entry.path}}
    if app_entry_run_fn(entry.items) == .Val(run) {
        jet_cli_web_walk_run(run, walk, functions)
    } else {
        // A `run: fn` written without its `App` return is an app entry when its
        // chain starts at `app()`.
        entry_functions := [Func]{}
        jet_cli_web_collect_functions(entry.items, entry_functions)
        run: jet_cli_web_function(entry_functions, "run") ?? return None
        jet_cli_web_walk_run(run, walk, functions)
        if !walk.found_app -> return None
    }
    jet_cli_web_expand_roots(walk, entry.app_route_roots)
    graph := walk.graph
    jet_cli_web_route_contracts(modules, functions, graph)
    jet_cli_web_sort_routes(graph.routes)
    serializable := [String]{}
    loop doc_module in modules {
        if doc_module.alias == "" -> jet_cli_web_collect_serializable(doc_module.items, serializable)
    }
    jet_cli_web_render_facts(modules, entry_identity, functions, serializable, graph)
    jet_cli_web_collect_uses(modules, functions, graph)
    Val(graph)
}

// ---- JSON ----

jet_cli_web_text: fn(name: String, value: String) -> JetCLIStatusField {
    jet_cli_status_field(name, jet_cli_status_text(value))
}

jet_cli_web_field_value: fn(field: JetCLIWebField) -> JetCLIStatusValue {
    jet_cli_status_object([JetCLIStatusField]{
        jet_cli_web_text("name", field.name),
        jet_cli_web_text("type", field.ty),
        jet_cli_web_text("codec", field.codec),
        jet_cli_status_field("required", jet_cli_status_bool(field.required)),
        jet_cli_status_field("default", jet_cli_status_optional_text(field.default)),
    })
}

jet_cli_web_route_value: fn(route: JetCLIWebRoute) -> JetCLIStatusValue {
    loader := JetCLIStatusValue.Null
    if route.loader == .Val(given) {
        loader = jet_cli_status_object([JetCLIStatusField]{
            jet_cli_web_text("handler", given.handler),
            jet_cli_web_text("data_type", given.data_type),
            jet_cli_web_text("dependency", given.dependency),
            jet_cli_status_field("preload", jet_cli_status_bool(given.preload)),
            jet_cli_web_text("cache_identity", given.cache_identity),
        })
    }
    pending := JetCLIStatusValue.Null
    if route.pending_boundary_id == .Val(id) -> pending = JetCLIStatusValue.Float{text: id}
    island := JetCLIStatusValue.Null
    if route.island == .Val(given) {
        captures: loop capture in given.captures -> jet_cli_status_object([JetCLIStatusField]{
            jet_cli_web_text("name", capture.name),
            jet_cli_web_text("type", capture.ty),
            jet_cli_status_field("serializable", jet_cli_status_bool(capture.serializable)),
        })
        island = jet_cli_status_object([JetCLIStatusField]{
            jet_cli_web_text("identity", given.identity),
            jet_cli_web_text("hydration_trigger", "immediate"),
            jet_cli_status_field("resume_payload", jet_cli_status_object([JetCLIStatusField]{
                jet_cli_status_field("serializable", jet_cli_status_bool(given.serializable)),
                jet_cli_status_field("captures", jet_cli_status_array(captures)),
            })),
        })
    }
    jet_cli_status_object([JetCLIStatusField]{
        jet_cli_web_text("path", route.path),
        jet_cli_web_text("handler", route.handler),
        jet_cli_web_text("route_identity", route.route_identity),
        jet_cli_status_field("path_params", jet_cli_status_array(loop field in route.path_params -> jet_cli_web_field_value(field))),
        jet_cli_status_field("search_params", jet_cli_status_array(loop field in route.search_params -> jet_cli_web_field_value(field))),
        jet_cli_web_text("search_codec", route.search_codec),
        jet_cli_status_field("loader", loader),
        jet_cli_status_field("boundaries", jet_cli_status_object([JetCLIStatusField]{
            jet_cli_status_field("pending", jet_cli_status_optional_text(route.pending)),
            jet_cli_status_field("not_found", jet_cli_status_optional_text(route.not_found)),
            jet_cli_status_field("error", jet_cli_status_optional_text(route.error)),
        })),
        jet_cli_web_text("precedence", route.precedence),
        jet_cli_web_text("render", route.render),
        jet_cli_status_field("render_facts", jet_cli_status_object([JetCLIStatusField]{
            jet_cli_web_text("mode", route.mode),
            jet_cli_status_field("reason", jet_cli_status_texts(route.reason)),
            jet_cli_status_field("effects", jet_cli_status_texts(route.effects)),
            jet_cli_status_field("interactive", jet_cli_status_bool(route.interactive)),
            jet_cli_status_field("loader", jet_cli_status_optional_text(route.data_loader)),
            jet_cli_status_field("form", jet_cli_status_optional_text(route.form)),
            jet_cli_web_text("cache", route.cache),
            jet_cli_status_field("override", jet_cli_status_optional_text(route.override_mode)),
            jet_cli_status_field("pending_boundary_id", pending),
            jet_cli_status_field("island", island),
        })),
        jet_cli_web_text("provenance", route.provenance),
    })
}

jet_cli_web_contract_fields: fn(name: String, contract: JetCLIWebContract) -> [JetCLIStatusField] {
    [JetCLIStatusField]{
        jet_cli_web_text("input", contract.input),
        jet_cli_web_text("output", contract.output),
        jet_cli_web_text("error", contract.error),
        jet_cli_web_text("endpoint", "/actions/{name}"),
        jet_cli_web_text("method", "POST"),
        jet_cli_web_text("csrf", "same-origin"),
        jet_cli_status_field("effects", jet_cli_status_texts(contract.effects)),
    }
}

jet_cli_web_action_value: fn(action: JetCLIWebAction) -> JetCLIStatusValue {
    fields := [JetCLIStatusField]{
        jet_cli_web_text("name", action.name),
        jet_cli_web_text("handler", action.handler),
        jet_cli_web_text("kind", action.kind),
        jet_cli_status_field("preload", jet_cli_status_bool(action.preload)),
    }
    loop field in jet_cli_web_contract_fields(action.name, action.contract) -> fields.push(field)
    fields.push(jet_cli_status_field("middleware", jet_cli_status_texts(action.contract.middleware)))
    fields.push(jet_cli_web_text("provenance", action.provenance))
    jet_cli_status_object(fields)
}

jet_cli_web_form_value: fn(form: JetCLIWebForm) -> JetCLIStatusValue {
    fields := [JetCLIStatusField]{
        jet_cli_web_text("name", form.model),
        jet_cli_web_text("model", form.model),
        jet_cli_web_text("action", form.action),
    }
    loop field in jet_cli_web_contract_fields(form.action, form.contract) -> fields.push(field)
    fields.push(jet_cli_status_field("fields", jet_cli_status_array(loop field in form.fields -> jet_cli_status_object([JetCLIStatusField]{
        jet_cli_web_text("name", field.name),
        jet_cli_web_text("ty", field.ty),
        jet_cli_status_field("required", jet_cli_status_bool(field.required)),
        jet_cli_status_field("default", jet_cli_status_optional_text(field.default)),
        jet_cli_web_text("label", field.label),
        jet_cli_web_text("control", field.control),
        jet_cli_web_text("wire_name", field.name),
    }))))
    fields.push(jet_cli_status_field("middleware", jet_cli_status_texts(form.contract.middleware)))
    fields.push(jet_cli_web_text("provenance", form.provenance))
    jet_cli_status_object(fields)
}

jet_cli_web_policy_value: fn(graph: JetCLIWebGraph) -> JetCLIStatusValue {
    jet_cli_status_object([JetCLIStatusField]{
        jet_cli_status_field("security", jet_cli_status_texts(graph.security)),
        jet_cli_status_field("assets", jet_cli_status_texts(graph.assets)),
        jet_cli_status_field("split", jet_cli_status_texts(graph.split)),
        jet_cli_status_field("cache", jet_cli_status_texts(graph.cache)),
        jet_cli_status_field("a11y", jet_cli_status_texts(graph.a11y)),
        jet_cli_status_field("adapters", jet_cli_status_texts(graph.adapters)),
    })
}

jet_cli_web_graph_value: fn(graph: JetCLIWebGraph) -> JetCLIStatusValue {
    jet_cli_status_object([JetCLIStatusField]{
        jet_cli_web_text("entry", graph.entry),
        jet_cli_web_text("hydration", graph.hydration),
        jet_cli_status_field("routes", jet_cli_status_array(loop route in graph.routes -> jet_cli_web_route_value(route))),
        jet_cli_status_field("actions", jet_cli_status_array(loop action in graph.actions -> jet_cli_web_action_value(action))),
        jet_cli_status_field("forms", jet_cli_status_array(loop form in graph.forms -> jet_cli_web_form_value(form))),
        jet_cli_status_field("queries", jet_cli_status_array(loop query in graph.queries -> jet_cli_status_object([JetCLIStatusField]{
            jet_cli_web_text("key", query.key),
            jet_cli_web_text("footprint", query.footprint),
            jet_cli_web_text("source", query.source),
            jet_cli_web_text("kind", query.kind),
        }))),
        jet_cli_status_field("stores", jet_cli_status_array(loop store in graph.stores -> jet_cli_status_object([JetCLIStatusField]{
            jet_cli_web_text("name", store.name),
            jet_cli_web_text("source", store.source),
            jet_cli_web_text("kind", store.kind),
            jet_cli_web_text("history_limit", store.history_limit),
        }))),
        jet_cli_status_field("mounts", jet_cli_status_array(loop mount in graph.mounts -> jet_cli_status_object([JetCLIStatusField]{
            jet_cli_web_text("prefix", mount.prefix),
            jet_cli_web_text("handler", mount.handler),
            jet_cli_status_field("effects", jet_cli_status_texts(mount.effects)),
            jet_cli_status_field("security", jet_cli_status_texts(mount.security)),
            jet_cli_web_text("provenance", mount.provenance),
        }))),
        jet_cli_status_field("routes_from", jet_cli_status_texts(loop root in graph.routes_from -> root.root)),
        jet_cli_status_field("policy", jet_cli_web_policy_value(graph)),
    })
}

// ---- text ----

jet_cli_web_fields_text: fn(fields: [JetCLIWebField]) -> String {
    parts: loop field in fields -> "{field.name}:{field.ty}"
    parts.join(",")
}

jet_cli_web_route_line: fn(route: JetCLIWebRoute) -> String {
    "  {route.path} [{route.mode}] -> {route.handler} ({route.provenance})"
}

// Every text line of the graph, in report order.
jet_cli_web_lines: fn(graph: JetCLIWebGraph) -> [String] {
    lines := [String]{"web application graph — {graph.entry}", "hydration: {graph.hydration} (shared IR: true)"}
    loop route in graph.routes {
        lines.push(jet_cli_web_route_line(route))
        loader := ""
        if route.loader == .Val(given) -> loader = " loader={given.handler} data={given.data_type} preload={given.preload} cache={given.cache_identity}"
        lines.push("    route-contract: identity={route.route_identity} precedence={route.precedence} path=[{jet_cli_web_fields_text(route.path_params)}] search=[{jet_cli_web_fields_text(route.search_params)}] codec={route.search_codec}{loader} boundaries=pending:{route.pending ?? "-"} not_found:{route.not_found ?? "-"} error:{route.error ?? "-"}")
        reason: if route.reason.len() == 0 -> "unspecified" else -> route.reason.join("; ")
        facts := "    render-facts: mode={route.mode} reason={reason} effects=[{route.effects.join(",")}] cache={route.cache}"
        if route.pending_boundary_id == .Val(id) -> facts = "{facts} pending_boundary_id={id}"
        if route.island == .Val(given) -> facts = "{facts} island={given.identity} hydration=immediate"
        lines.push(facts)
    }
    loop action in graph.actions {
        contract: action.contract
        lines.push("  action {action.name} ({action.kind}) -> {action.handler} input={contract.input} output={contract.output} error={contract.error} endpoint=/actions/{action.name} method=POST csrf=same-origin effects=[{contract.effects.join(",")}] middleware=[{contract.middleware.join(",")}] ({action.provenance})")
    }
    loop form in graph.forms {
        contract: form.contract
        fields: loop field in form.fields -> if field.required -> "{field.name}:{field.ty}" else -> "{field.name}:{field.ty}?"
        lines.push("  form {form.model} model={form.model} action={form.action} input={contract.input} output={contract.output} error={contract.error} endpoint=/actions/{form.action} method=POST csrf=same-origin fields=[{fields.join(",")}] effects=[{contract.effects.join(",")}] middleware=[{contract.middleware.join(",")}] ({form.provenance})")
    }
    loop query in graph.queries -> lines.push("  query {query.key} ({query.kind}) footprint={query.footprint} source={query.source}")
    loop store in graph.stores -> lines.push("  store {store.name} ({store.kind}) history_limit={store.history_limit} source={store.source}")
    loop mount in graph.mounts -> lines.push("  mount {mount.prefix} -> {mount.handler} effects={mount.effects.join(",")} security={mount.security.join(",")} ({mount.provenance})")
    loop root in graph.routes_from -> lines.push("  routes(from: {root.root})")
    if graph.security.len() > 0 -> lines.push("  security: {graph.security.join(", ")}")
    if graph.assets.len() > 0 -> lines.push("  assets: {graph.assets.join(", ")}")
    if graph.split.len() > 0 -> lines.push("  split: {graph.split.join(", ")}")
    if graph.cache.len() > 0 -> lines.push("  cache: {graph.cache.join(", ")}")
    if graph.a11y.len() > 0 -> lines.push("  a11y: {graph.a11y.join(", ")}")
    if graph.adapters.len() > 0 -> lines.push("  adapters: {graph.adapters.join(", ")}")
    lines
}

// ---- reports ----

// `jet explain --web-graph <file.jet>` over the checked entry.
jet_cli_web_graph_report: fn(result: JetDriverCompileResult, json: Bool) -> JetDriverVerbOutput {
    graph: jet_cli_web_graph(result.doc_modules, result.entry_module_identity)
    if json {
        value := JetCLIStatusValue.Null
        if graph == .Val(found) -> value = jet_cli_web_graph_value(found)
        return JetDriverVerbOutput{stdout: "{jet_cli_status_render("inspect.web", true, [JetCLIStatusField]{jet_cli_status_field("web_app", value)})}\n", stderr: "", exit_code: JET_DRIVER_EXIT_OK}
    }
    found: graph ?? return JetDriverVerbOutput{stdout: "(none)\n", stderr: "", exit_code: JET_DRIVER_EXIT_OK}
    out := ""
    loop line in jet_cli_web_lines(found) -> out = "{out}{line}\n"
    JetDriverVerbOutput{stdout: out, stderr: "", exit_code: JET_DRIVER_EXIT_OK}
}

jet_cli_web_located: fn(name: String, value: JetCLIStatusValue, span: Span, entry: String, source: String?) -> [JetCLIStatusField] {
    fields := [JetCLIStatusField]{jet_cli_status_field(name, value), jet_cli_web_text("source", entry), jet_cli_status_field("span", jet_cli_expand_span(span, source))}
    if source == .Val(text) {
        fields.push(jet_cli_status_field("line", jet_cli_status_int(diagnostic_line_at(text, span.start))))
        fields.push(jet_cli_status_field("column", jet_cli_status_int(diagnostic_column_at(text, span.start))))
    }
    fields
}

// The `web` expand lens: one fact per graph line in text, and one graph fact
// (with source locations) in JSON. A program with no app graph has no facts.
jet_cli_expand_web: fn(modules: [JetDriverDocModule], entry_identity: String, json: Bool) -> [JetCLIExpandFact] {
    graph: jet_cli_web_graph(modules, entry_identity) ?? return [JetCLIExpandFact]{}
    if !json {
        lines: jet_cli_web_lines(graph)
        return loop (index, line) in lines -> JetCLIExpandFact{source: graph.entry, offset: index, name: "web", text: line, value: JetCLIStatusValue.Null}
    }
    source: jet_cli_expand_source(modules, graph.entry)
    routes: loop route in graph.routes -> {
        fields := [JetCLIStatusField]{jet_cli_web_text("path", route.path), jet_cli_web_text("handler", route.handler), jet_cli_web_text("render", route.render)}
        loop field in jet_cli_web_located("provenance", jet_cli_status_text(route.provenance), route.span, graph.entry, source) -> fields.push(field)
        jet_cli_status_object(fields)
    }
    actions: loop action in graph.actions -> {
        fields := [JetCLIStatusField]{jet_cli_web_text("name", action.name), jet_cli_web_text("handler", action.handler), jet_cli_web_text("kind", action.kind)}
        loop field in jet_cli_web_located("provenance", jet_cli_status_text(action.provenance), action.span, graph.entry, source) -> fields.push(field)
        jet_cli_status_object(fields)
    }
    mounts: loop mount in graph.mounts -> {
        fields := [JetCLIStatusField]{jet_cli_web_text("prefix", mount.prefix), jet_cli_web_text("handler", mount.handler), jet_cli_status_field("effects", jet_cli_status_texts(mount.effects)), jet_cli_status_field("security", jet_cli_status_texts(mount.security))}
        loop field in jet_cli_web_located("provenance", jet_cli_status_text(mount.provenance), mount.span, graph.entry, source) -> fields.push(field)
        jet_cli_status_object(fields)
    }
    roots: loop root in graph.routes_from -> jet_cli_status_object(jet_cli_web_located("root", jet_cli_status_text(root.root), root.span, graph.entry, source))
    value: jet_cli_status_object([JetCLIStatusField]{
        jet_cli_web_text("kind", "web_graph"),
        jet_cli_web_text("source", graph.entry),
        jet_cli_web_text("entry", graph.entry),
        jet_cli_web_text("hydration", graph.hydration),
        jet_cli_status_field("routes", jet_cli_status_array(routes)),
        jet_cli_status_field("actions", jet_cli_status_array(actions)),
        jet_cli_status_field("mounts", jet_cli_status_array(mounts)),
        jet_cli_status_field("routes_from", jet_cli_status_array(roots)),
        jet_cli_status_field("policy", jet_cli_web_policy_value(graph)),
    })
    [JetCLIExpandFact]{JetCLIExpandFact{source: graph.entry, offset: 0, name: "web", text: "web application graph — {graph.entry}", value: value}}
}
