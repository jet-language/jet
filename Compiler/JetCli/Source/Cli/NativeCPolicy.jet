// The one native C compiler policy, computed from native-c-policy.tsv beside
// this file while the compiler builds (row rules: NativeCPolicyRows.jet).

// Flags appended after every native C compiler invocation's own arguments.
JET_CLI_NATIVE_C_FLAGS :: comptime { jet_cli_native_c_policy_values(embed_file("native-c-policy.tsv"), "flag") }

// Nix cc-wrapper features removed from the child's NIX_HARDENING_ENABLE.
JET_CLI_NATIVE_C_HARDENING_REMOVED :: comptime { jet_cli_native_c_policy_values(embed_file("native-c-policy.tsv"), "hardening-remove") }
