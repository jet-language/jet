// The environment that lets a `jet run` or `jet dev` program write its
// production-failure receipt (Runtime ProductionReceipt.jet writes it on a
// root stop). The program gets only the receipt directory
// `.jet/reports/production-<id>` under the project root, the project-relative
// entry, and digests of its source, closure, arguments and target, never a
// source, argument or environment value.
use {
    jet_driver.[jet_driver_run_receipt_frame]
    cli_files: core.files
    cli_sys: core.sys
    production_crypto: core.crypto
    jet_backend.[x64_process_env]
    jet_pkg_model.[WorkspaceDeclarationCache]
    jetpack_foundation.[
        JET_DEVELOPMENT_RECEIPT_CLOSURE_DIGEST_ENV, JET_DEVELOPMENT_RECEIPT_DIRECTORY_ENV,
        JET_DEVELOPMENT_RECEIPT_ENTRY_ENV, JET_DEVELOPMENT_RECEIPT_INPUT_COUNT_DIGEST_ENV,
        JET_DEVELOPMENT_RECEIPT_INPUT_COUNT_ENV, JET_DEVELOPMENT_RECEIPT_INPUT_DIGEST_ENV,
        JET_DEVELOPMENT_RECEIPT_SOURCE_DIGEST_ENV, JET_DEVELOPMENT_RECEIPT_TARGET_DIGEST_ENV,
        JET_DEVELOPMENT_RECEIPT_TARGET_ENV, PACKAGE_FILE, UNIFIED_LOCK_FILE,
    ]
}

JET_CLI_PRODUCTION_TARGET: "native"

// One variable a launched program gets over jet's own environment.
JetCLIEnvVar: struct {
    name: String
    value: String
}

// The receipt variables of the program `file` run with `program_args`. The
// receipt's identity is its entry, source, closure, arguments and target, so
// one failure of one run writes one receipt wherever it runs.
jet_cli_production_receipt_env: fn(file: String, program_args: [String]) -> [JetCLIEnvVar] {
    cwd: cli_sys.current_dir() ?? "."
    source_file: if file.starts_with("/") -> file.copy() else -> "{cwd}/{file}"
    cache := WorkspaceDeclarationCache.new()
    root: jet_cli_selected_project_root(cache, jet_cli_parent(source_file) ?? ".") ?? cwd.copy()
    entry: jet_cli_production_entry(source_file, root)
    source_digest: jet_cli_source_hash(cli_files.read_bytes(source_file) ?? [U8]{})

    closure := "jet-production-closure-v1".bytes()
    closure.push(U8{0})
    jet_driver_run_receipt_frame(closure, entry.bytes())
    jet_driver_run_receipt_frame(closure, source_digest.bytes())
    package: jet_cli_manifest_root(jet_cli_parent(source_file) ?? ".")
    jet_cli_production_project_input(closure, package, root, "manifest")
    jet_cli_production_project_input(closure, package, root, "lock")
    closure_digest: jet_cli_source_hash(closure)

    inputs := "jet-production-inputs-v1".bytes()
    inputs.push(U8{0})
    loop argument in program_args -> jet_driver_run_receipt_frame(inputs, argument.bytes())
    input_digest: jet_cli_source_hash(inputs)
    count: "{program_args.len()}"
    count_digest: jet_cli_source_hash(count.bytes())
    target_digest: jet_cli_source_hash(JET_CLI_PRODUCTION_TARGET.bytes())

    identity := "jet-production-failure-v1".bytes()
    identity.push(U8{0})
    jet_driver_run_receipt_frame(identity, entry.bytes())
    jet_driver_run_receipt_frame(identity, source_digest.bytes())
    jet_driver_run_receipt_frame(identity, closure_digest.bytes())
    jet_driver_run_receipt_frame(identity, input_digest.bytes())
    jet_driver_run_receipt_frame(identity, JET_CLI_PRODUCTION_TARGET.bytes())
    id: production_crypto.sha256(identity).hex()
    short: String.from_bytes(id.bytes().slice(0, 16)) ?? ""
    base: if root.ends_with("/") -> root.copy() else -> "{root}/"

    [JetCLIEnvVar]{
        JetCLIEnvVar{name: JET_DEVELOPMENT_RECEIPT_DIRECTORY_ENV, value: "{base}.jet/reports/production-{short}"},
        JetCLIEnvVar{name: JET_DEVELOPMENT_RECEIPT_ENTRY_ENV, value: entry},
        JetCLIEnvVar{name: JET_DEVELOPMENT_RECEIPT_SOURCE_DIGEST_ENV, value: source_digest},
        JetCLIEnvVar{name: JET_DEVELOPMENT_RECEIPT_CLOSURE_DIGEST_ENV, value: closure_digest},
        JetCLIEnvVar{name: JET_DEVELOPMENT_RECEIPT_INPUT_DIGEST_ENV, value: input_digest},
        JetCLIEnvVar{name: JET_DEVELOPMENT_RECEIPT_INPUT_COUNT_ENV, value: count},
        JetCLIEnvVar{name: JET_DEVELOPMENT_RECEIPT_INPUT_COUNT_DIGEST_ENV, value: count_digest},
        JetCLIEnvVar{name: JET_DEVELOPMENT_RECEIPT_TARGET_ENV, value: JET_CLI_PRODUCTION_TARGET},
        JetCLIEnvVar{name: JET_DEVELOPMENT_RECEIPT_TARGET_DIGEST_ENV, value: target_digest},
    }
}

// `source_file` relative to `root`, else its file name.
jet_cli_production_entry: fn(source_file: String, root: String) -> String {
    if jet_cli_production_relative(source_file, root) == .Val(relative) {
        if relative != "" && relative != "." -> return relative
    }
    parts: source_file.split("/").to_list()
    name: parts[parts.len() - 1].copy()
    if name == "" -> "<unknown>" else -> name
}

// `path` below `root`, as Rust `Path::strip_prefix` reads it.
jet_cli_production_relative: fn(path: String, root: String) -> String? {
    if path == root -> return Val("")
    prefix: if root.ends_with("/") -> root.copy() else -> "{root}/"
    if path.starts_with(prefix) -> return Val(path.removeprefix(prefix))
    None
}

// The closure's frames for the `kind` file ("manifest" or "lock") of the
// package that holds the source (`package`, its manifest root): its kind, its
// path relative to `root`, and its digest. A package without that file, or a
// source outside any package, adds nothing.
jet_cli_production_project_input: fn(closure: &[U8], package: String?, root: String, kind: String) {
    found: package ?? return
    path: if kind == "manifest" -> "{found}/{PACKAGE_FILE}" else -> "{found}/{UNIFIED_LOCK_FILE}"
    bytes: cli_files.read_bytes(path) ?? return
    jet_driver_run_receipt_frame(closure, kind.bytes())
    relative: jet_cli_production_relative(path, root) ?? kind.copy()
    jet_driver_run_receipt_frame(closure, relative.bytes())
    jet_driver_run_receipt_frame(closure, jet_cli_source_hash(bytes).bytes())
}

// jet's environment rows with `vars` set over them.
jet_cli_launch_env: fn(vars: [JetCLIEnvVar]) -> [String]? {
    if vars.len() == 0 -> return None
    prefixes := [String]{}
    loop variable in vars -> prefixes.push("{variable.name}=")
    rows := [String]{}
    loop row in x64_process_env() {
        overridden: loop prefix in prefixes {
            if row.starts_with(prefix) -> break true
        } ?? false
        if !overridden -> rows.push(row.copy())
    }
    loop variable in vars -> rows.push("{variable.name}={variable.value}")
    Val(rows)
}
