// Whole-invocation receipts for `jet check` (Rust ReceiptStore
// `run_if_needed`, `lookup_context`, `replay_receipt`). A check whose context
// and input closure match its last receipt replays the receipt's output and
// status without compiling; otherwise the check runs and its outcome is
// published as an immutable receipt, and the invocation's context pointer
// (`.jet/receipts/contexts/<context key>`) moves to it. JET_RECEIPT_BYPASS
// turns both off. Replay and invalidation notices show only under `--verbose`
// (#3721: a clean check prints one line).
use {
    jet_driver.[JetDriverAuthorizedSourceSnapshot, JetDriverVerbOutput]
    jet_pkg_model.[JET_VERSION, WorkspaceDeclarationCache]
    cli_files: core.files
    cli_sys: core.sys
    receipt_crypto: core.crypto
}

// The claim a missed check publishes: its store, context key, the claim
// identity (context and check-context frames, before any input) and the
// inputs observed before the compile ran.
JetCLICheckRecording: struct {
    project_root: String
    context_key: String
    identity: [U8]
    inputs: [JetCLIReceiptInput]
    argv: [String]
    target: String
}

// A check either replays its current receipt or runs; a run carries the
// claim its outcome publishes, or None when it runs unrecorded.
JetCLICheckReceiptStep: enum {
    Replay(output: JetDriverVerbOutput)
    Run(recording: JetCLICheckRecording?)
}

// The positional after the `check` verb, if the invocation names a target:
// the jet-owned words read as the front door reads them (jet_cli_positionals),
// so the receipt claims the target the check compiles.
jet_cli_check_receipt_target: fn(owned: [String]) -> String? Never! {
    verb_seen := false
    loop word in jet_cli_positionals(owned) {
        if verb_seen -> return Val(word.copy())
        if word == "check" -> verb_seen = true
    }
    None
}

// Rust `collect_tree_inputs` for `check`: every `.jet` source and lock under
// `path`, skipping `.git`, `target` and `build`; under `.jet` only the lock and
// the generated tree count.
jet_cli_check_tree_inputs: fn(path: String, out: &[String]) Never! -[FS]> {
    info: cli_files.stat(path) ?? return
    if info.is_symlink -> return
    if info.is_file {
        out.push(path.copy())
        return
    }
    if !info.is_dir -> return
    held: JetCLIRootedDirectory.open(path, [String]{}, false) ?? return
    entries: held.list() ?? return
    generated: path.contains("/.jet/generated")
    loop entry in entries {
        child: jet_cli_rooted_join(path, entry.name)
        if entry.is_dir {
            if ([String]{".git", "target", "build"}).contains(entry.name) -> next
            if entry.name == ".jet" {
                lock: jet_cli_rooted_join(child, "lock")
                if jet_cli_receipt_regular(lock) -> out.push(lock)
                jet_cli_check_tree_inputs(jet_cli_rooted_join(child, "generated"), out)
                next
            }
            jet_cli_check_tree_inputs(child, out)
            next
        }
        if !entry.is_file -> next
        if generated || entry.name.ends_with(".jet") || entry.name == "lock" -> out.push(child)
    }
}

// Rust `input_paths_for`/`project_check_input_paths`: a bare check reads the
// whole authority tree of the working directory, a directory target its own
// tree, and a file target the file plus its owning authorities (manifests,
// lock, stock entry candidates and generated inputs). The compiled sources a
// file check reads beyond these join at publication from its snapshot.
jet_cli_check_receipt_paths: fn(cache: &WorkspaceDeclarationCache, cwd: String, target: String?, file: String) -[FS, Env]> [String] Never! {
    paths := [String]{}
    raw: target ?? {
        loop root in jet_cli_receipt_authority_roots(cache, cwd) -> jet_cli_check_tree_inputs(root, paths)
        return paths
    }
    absolute: if raw.starts_with("/") -> raw else -> jet_cli_rooted_join(cwd, raw)
    if cli_files.is_dir(absolute) {
        jet_cli_check_tree_inputs(cli_files.realpath(absolute) ?? absolute, paths)
        return paths
    }
    paths.push(file.copy())
    loop root in jet_cli_receipt_authority_roots(cache, jet_cli_parent(file) ?? cwd) {
        loop name in ([String]{"package.jet", "pkg.jet", "workspace.jet", "build.jet", ".jet/lock"}) {
            path: jet_cli_rooted_join(root, name)
            if jet_cli_receipt_regular(path) -> paths.push(path)
        }
        loop relative in JET_CLI_STOCK_ENTRIES {
            path: jet_cli_rooted_join(root, relative)
            if jet_cli_receipt_regular(path) -> paths.push(path)
        }
        jet_cli_check_tree_inputs(jet_cli_rooted_join(root, ".jet/generated"), paths)
    }
    paths
}

// Rust `append_context_path`: a label, the canonical path and what is there
// now (a file by its digest).
jet_cli_check_context_path: fn(identity: &[U8], label: String, path: String) Never! -[FS]> {
    jet_cli_receipt_frame(identity, label.bytes())
    jet_cli_receipt_frame(identity, (cli_files.realpath(path) ?? path).bytes())
    info: cli_files.stat(path) ?? {
        jet_cli_receipt_frame(identity, (if jet_cli_rooted_missing(err) -> "missing" else -> "unreadable").bytes())
        return
    }
    if {
        info.is_symlink -> jet_cli_receipt_frame(identity, "symlink".bytes())
        info.is_file -> {
            jet_cli_receipt_frame(identity, "file".bytes())
            digest: if cli_files.read_bytes(path) == {
                .Ok(bytes) -> receipt_crypto.sha256(bytes).hex()
                .Err(_) -> "unreadable"
            }
            jet_cli_receipt_frame(identity, digest.bytes())
        }
        info.is_dir -> jet_cli_receipt_frame(identity, "directory".bytes())
        else -> jet_cli_receipt_frame(identity, "other".bytes())
    }
}

// Rust `append_check_context_identity`: a check claim includes its authority
// and entry-selection state, so a newly created higher-priority entry
// candidate or authority changes the claim even before it is an input.
jet_cli_check_context_identity: fn(cache: &WorkspaceDeclarationCache, cwd: String, identity: &[U8]) Never! -[FS, Env]> {
    jet_cli_receipt_frame(identity, "check-context-v2".bytes())
    jet_cli_check_context_path(identity, "working-directory", cwd)
    loop root in jet_cli_receipt_authority_roots(cache, cwd) {
        jet_cli_check_context_path(identity, "package-root", root)
        loop (priority, relative) in JET_CLI_STOCK_ENTRIES {
            jet_cli_receipt_frame(identity, "entry-candidate".bytes())
            jet_cli_receipt_frame(identity, "{priority}".bytes())
            jet_cli_check_context_path(identity, "path", jet_cli_rooted_join(root, relative))
        }
        loop name in ([String]{"package.jet", "pkg.jet", "workspace.jet", ".jet/lock"}) {
            jet_cli_check_context_path(identity, name, jet_cli_rooted_join(root, name))
        }
        generated: jet_cli_rooted_join(root, ".jet/generated")
        jet_cli_receipt_frame(identity, "generated-inputs".bytes())
        jet_cli_check_context_path(identity, "root", generated)
        files := [String]{}
        jet_cli_check_tree_inputs(generated, files)
        loop file in jet_cli_lock_canonical(files) -> jet_cli_check_context_path(identity, "file", file)
    }
}

// The canonical, observed inputs at `paths`.
jet_cli_check_receipt_inputs: fn(paths: [String]) -[FS, Time.Wait]> [JetCLIReceiptInput] JetCLIReadError! {
    inputs := [JetCLIReceiptInput]{}
    loop path in paths {
        canonical: cli_files.realpath(path) ?? return Err(jet_cli_read_error("could not canonicalize input {path}: {jet_cli_io_error_text(err)}"))
        inputs.push(jet_cli_receipt_observe_input(JetCLIReceiptInput{path: canonical, digest: ""}))
    }
    Ok(inputs)
}

// The receipt the context pointer names, when it is a well-formed check
// receipt stored under its own claim key.
jet_cli_check_receipt_stored: fn(project_root: String, context_key: String) -[FS, Time.Wait]> JetCLIReceipt? JetCLIReadError! {
    contexts: [String]{".jet", "receipts", "contexts"}
    if !JetCLIRootedDirectory.present(project_root, contexts) -> return Ok(None)
    pointers: JetCLIRootedDirectory.open(project_root, contexts, false)
    pointer: if pointers.read(context_key, 4096) == {
        .Val(bytes) -> bytes
        .None -> { return Ok(None) }
        .Err(error) -> { return Err(error) }
    }
    key: String.from_bytes(pointer) ?? return Ok(None)
    if !jet_cli_receipt_is_digest(key) -> return Ok(None)
    objects: [String]{".jet", "receipts", "objects"}
    if !JetCLIRootedDirectory.present(project_root, objects) -> return Ok(None)
    held: JetCLIRootedDirectory.open(project_root, objects, false)
    raw: if held.read(key, JET_CLI_RECEIPT_MAX_BYTES) == {
        .Val(bytes) -> bytes
        .None -> { return Ok(None) }
        .Err(error) -> { return Err(error) }
    }
    receipt: jet_cli_receipt_decode(raw) ?? return Ok(None)
    if receipt.claim.key != key || receipt.claim.verb != "check" -> return Ok(None)
    Ok(Val(receipt))
}

// Rust `changed_receipt_inputs`: paths whose digest changed, vanished or
// newly appeared, sorted and unique.
jet_cli_check_receipt_changes: fn(old: [JetCLIReceiptInput], new: [JetCLIReceiptInput]) -> [String] Never! {
    changed := [String]{}
    loop input in old {
        same := false
        loop candidate in new {
            if candidate.path == input.path {
                same = candidate.digest == input.digest
                break
            }
        }
        if !same -> changed.push(input.path)
    }
    loop input in new {
        known := false
        loop candidate in old {
            if candidate.path == input.path {
                known = true
                break
            }
        }
        if !known -> changed.push(input.path)
    }
    jet_cli_lock_canonical(changed)
}

// Rust `replay_receipt`: the stored output under the current secret values,
// then (verbose) the replay notice.
jet_cli_check_receipt_replay: fn(receipt: JetCLIReceipt, argv: [String], notice: String, verbose: Bool) -[Env]> JetDriverVerbOutput? Never! {
    secrets: jet_cli_receipt_secret_values(argv)
    stdout_bytes: jet_cli_receipt_redact_bytes(receipt.stdout, secrets) ?? return None
    stderr_bytes: jet_cli_receipt_redact_bytes(receipt.stderr, secrets) ?? return None
    stdout: String.from_bytes(stdout_bytes) ?? return None
    stderr: String.from_bytes(stderr_bytes) ?? return None
    current: if verbose -> "ok: check current (receipt {receipt.claim.key.slice(0, 12)})\n" else -> ""
    Val(JetDriverVerbOutput{stdout: stdout, stderr: "{notice}{stderr}{current}", exit_code: receipt.status})
}

// Rust `lookup_context` after the pointer: the stored closure is checked as
// it stands now, with the authority paths rediscovered so a new entry
// candidate cannot hide behind it. A mismatch says why under `--verbose`.
jet_cli_check_receipt_current: fn(receipt: JetCLIReceipt, identity: [U8], paths: [String], args: [String], notice: String, verbose: Bool) -> JetDriverVerbOutput? {
    current_paths := paths
    loop input in receipt.claim.inputs {
        if jet_cli_receipt_regular(input.path) -> current_paths.push(input.path)
    }
    observed: jet_cli_check_receipt_inputs(current_paths) ?? return None
    claim: jet_cli_receipt_claim_of("check", identity, observed)
    if claim != receipt.claim {
        if verbose {
            changes: jet_cli_check_receipt_changes(receipt.claim.inputs, claim.inputs)
            if changes.len() == 0 -> jet_cli_write_notice("receipt: check invalidated (entry candidates or authority context changed)\n")
            loop path in changes -> jet_cli_write_notice("receipt: check invalidated (input changed: `{path}`)\n")
        }
        return None
    }
    if receipt.digest != jet_cli_receipt_digest(receipt) {
        if verbose -> jet_cli_write_notice("receipt: check invalidated (receipt authentication changed)\n")
        return None
    }
    jet_cli_check_receipt_replay(receipt, args, notice, verbose)
}

// Rust `run_if_needed` up to the act: a `jet check` plan replays its current
// receipt, or runs with the claim its outcome publishes. Store failures are
// optional-history notices; the check then runs unrecorded.
jet_cli_check_receipt_begin: fn(args: [String], plan: JetCLIPlan) -> JetCLICheckReceiptStep {
    if cli_sys.get("JET_RECEIPT_BYPASS") != None -> return JetCLICheckReceiptStep.Run{recording: None}
    file := ""
    notice := ""
    if plan == {
        .Check(found, _, _, _, _, _, written, _, _, _, _, _) -> {
            file = found
            notice = written
        }
        .Done(_) | .Refused(_, _, _, _) | .Diagnostics(_, _, _, _, _) | .CheckWorkspace(_, _, _, _, _, _, _, _, _, _) | .CheckPrelude(_, _, _, _, _, _) | .CheckCore(_, _, _, _, _) | .Build(_, _, _, _, _, _, _, _, _, _, _) | .LockedBuild(_, _) | .BuildPackage(_, _, _, _, _, _, _, _) | .Run(_, _, _, _, _, _, _, _, _, _, _, _) | .RunRemote(_, _, _, _, _, _, _, _) | .NativeSource(_, _, _, _, _) | .DevWeb(_, _, _, _, _, _, _, _) | .Jobs(_, _, _, _) | .Test(_, _, _, _, _, _) | .TestWorkspace(_, _, _, _, _, _, _, _) | .TestProfile(_, _, _, _, _, _) | .New(_, _, _, _, _, _) | .Doc(_, _, _, _, _) | .Emit(_, _, _, _, _, _) | .Eval(_, _, _, _, _) | .Fill(_, _, _) | .Structural(_, _, _) | .Review(_, _, _) | .Keygen(_, _, _) | .KeyBackup(_, _, _) | .Publish(_, _, _, _) | .Yank(_, _, _) | .Lint(_, _, _, _, _, _, _) | .Fmt(_) | .FmtLang(_, _) | .Fix(_, _, _, _, _, _, _, _, _) | .Inspect(_) | .InspectB(_) | .ForeignBind(_, _, _) | .Perf(_, _) | .Semindex(_, _, _) | .Find(_, _, _, _) | .Cache(_, _) | .Remote(_, _, _) | .Comparison(_, _, _) | .Try(_, _, _) | .Maintenance(_, _, _, _) | .Completion(_, _, _) | .Schema(_, _, _, _, _) | .Codemod(_, _, _, _, _) | .PolicyExplain(_, _, _, _, _, _) | .DiagnosticTypeExplain(_, _, _, _) | .BuildFactExplain(_, _, _, _, _, _, _) | .Gates(_, _, _, _, _) | .Output(_, _, _, _) | .Doctor(_, _, _, _) | .UpdateJet(_, _, _, _, _) | .AuditCopies(_, _, _, _, _) | .AuditForeign(_, _, _, _, _) | .CompilerService(_) | .Repl(_, _, _, _) | .LSP | .ReplChild(_) | .EvalExpression(_, _, _) | .Prove(_, _, _, _, _, _) | .Budget(_, _, _, _) | .AuditWrites(_, _, _, _, _) -> return JetCLICheckReceiptStep.Run{recording: None}
    }
    // Rust `OutputFlags::parse(argv).verbose`: the flag, whatever the target.
    owned: jet_cli_owned_flags(args)
    verbose: owned.contains("--verbose") || owned.contains("-v")
    cwd: cli_sys.current_dir() ?? {
        jet_cli_write_notice(jet_cli_history_notice("resolving receipt working directory", jet_cli_io_error_text(err)))
        return JetCLICheckReceiptStep.Run{recording: None}
    }
    cache := WorkspaceDeclarationCache.new()
    target: jet_cli_check_receipt_target(owned)
    project_root: jet_cli_receipt_project_root(cache, jet_cli_parent(file) ?? cwd)
    context: jet_cli_receipt_context_identity("check", args, jet_cli_terminal_bits()) ?? {
        jet_cli_write_notice(jet_cli_history_notice("claiming a receipt", err.message))
        return JetCLICheckReceiptStep.Run{recording: None}
    }
    context_key: receipt_crypto.sha256(context).hex()
    identity := context
    jet_cli_check_context_identity(cache, cwd, identity)
    paths: jet_cli_check_receipt_paths(cache, cwd, target, file)
    if jet_cli_check_receipt_stored(project_root, context_key) == {
        .Val(receipt) -> {
            if jet_cli_check_receipt_current(receipt, identity, paths, args, notice, verbose) == .Val(output) -> return JetCLICheckReceiptStep.Replay{output: output}
        }
        .None -> {}
        .Err(error) -> {
            jet_cli_write_notice(jet_cli_history_notice("reading a cached receipt", error.message))
            return JetCLICheckReceiptStep.Run{recording: None}
        }
    }
    if paths.len() == 0 -> return JetCLICheckReceiptStep.Run{recording: None}
    inputs: jet_cli_check_receipt_inputs(paths) ?? {
        jet_cli_write_notice(jet_cli_history_notice("claiming a receipt", err.message))
        return JetCLICheckReceiptStep.Run{recording: None}
    }
    JetCLICheckReceiptStep.Run{recording: Val(JetCLICheckRecording{project_root: project_root, context_key: context_key, identity: identity, inputs: inputs, argv: args, target: file})}
}

// Each source a compile read, at the digest of the bytes it read; None when
// one of them is gone, so the outcome is not recorded.
jet_cli_check_snapshot_inputs: fn(snapshot: JetDriverAuthorizedSourceSnapshot) -[FS]> [JetCLIReceiptInput]? Never! {
    inputs := [JetCLIReceiptInput]{}
    loop root in snapshot.roots {
        loop file in root.files {
            path: cli_files.realpath(file.path) ?? return None
            inputs.push(JetCLIReceiptInput{path: path, digest: receipt_crypto.sha256(file.source.bytes()).hex()})
        }
    }
    Val(inputs)
}

// Rust `persist_published_receipt` and `index_published_receipt`. The claim
// is the pre-compile inputs plus each `compiled` source outside them;
// publication refuses a closure that changed meanwhile.
jet_cli_check_receipt_store: fn(recording: JetCLICheckRecording, output: JetDriverVerbOutput, compiled: [JetCLIReceiptInput]) JetCLIReadError! -[FS, Env, Time]> {
    inputs := recording.inputs
    known := [String]{}
    loop input in inputs -> known.push(input.path)
    loop input in compiled {
        if known.contains(input.path) -> next
        known.push(input.path)
        inputs.push(input.copy())
    }
    claim: jet_cli_receipt_claim_of("check", recording.identity, inputs)
    receipt: jet_cli_receipt_prepare(claim, output.exit_code, output.stdout.bytes(), output.stderr.bytes(), [JetCLIReceiptSection]{}, [JetCLIRecordLink]{}, [JetCLIRecordLink]{}, jet_cli_receipt_secret_values(recording.argv))
    _: jet_cli_receipt_publish(recording.project_root, receipt)
    current: jet_cli_receipt_lookup(recording.project_root, claim) ?? return
    pointers: JetCLIRootedDirectory.open(recording.project_root, [String]{".jet", "receipts", "contexts"}, true)
    pointers.replace(recording.context_key, claim.key.bytes(), None)
    cache := WorkspaceDeclarationCache.new()
    target: jet_cli_receipt_target_identity(cache, recording.target, claim.inputs)
    index := jet_cli_record_index_load(recording.project_root)
    identity: JetCLIRecordIdentity{target_inputs_sha256: target.input_sha256, tool_version: JET_VERSION, engine: "jet-receipt-v2"}
    entry: jet_cli_comparison_index_entry(index, identity, "receipt", claim.key, ".jet/receipts/objects/{claim.key}", jet_cli_receipt_encode(current).len(), current.consumed, current.produced, false)
    jet_cli_record_index_upsert_many_and_store(index, recording.project_root, [JetCLIRecordIndexEntry]{entry})
}

// A Jet defect (status 101) is never a receipt.
jet_cli_check_receipt_publish: fn(recording: JetCLICheckRecording, output: JetDriverVerbOutput, compiled: [JetCLIReceiptInput]) {
    if output.exit_code == JET_CLI_EXIT_ICE -> return
    if jet_cli_check_receipt_store(recording, output, compiled) == .Err(error) {
        jet_cli_write_notice(jet_cli_history_notice("staging optional receipt job", error.message))
    }
}
