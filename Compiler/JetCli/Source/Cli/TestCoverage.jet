// `jet test --coverage`: which of the tested file's functions the run
// entered. The harness probes each coverable function's entry
// (IRTestHarness.coverage, JetIR BuildTests.jet ir_coverage_probe); every
// test process appends the lines it entered to the file JET_COV_OUT names
// (JetRuntime Coverage.jet), and the report lists each coverable function
// as HIT or MISS after the test report. Every optimize level builds the same
// probes, so each level's run reports alike.
use {
    cli_files: core.files
    jet_foundation.[FnBody, TTestFact, Type, type_name]
}

JET_CLI_COVERAGE_ENV: "JET_COV_OUT"

// A coverable function: its checked key, its report name (`Type.method` for
// a method) and the line its declaration starts on.
JetCLICoverageFunction: struct {
    key: String
    name: String
    line: Int
}

// The functions of `file` the report measures, by line: its own functions
// and methods, none synthetic, none a #Test or an output check
// (`harnessed`, checked keys), and not `run`.
jet_cli_coverage_functions: fn(file: String, functions: [FnBody], tests: [TTestFact], harnessed: [String]) -> [JetCLICoverageFunction] Never! {
    excluded := [String:Bool]{}
    loop test in tests -> excluded[test.function.key.copy()] = true
    loop key in harnessed -> excluded[key.copy()] = true
    out := [JetCLICoverageFunction]{}
    loop function in functions {
        if function.synthetic || function.source_file != file || function.name == "run" || excluded.get(function.key) != None -> next
        name: if function.kind == {
            .TopLevel -> function.name.copy()
            .Method(_, owner) -> "{jet_cli_coverage_owner(owner)}.{function.name}"
            .TraitMethod(_, _, owner, _, _) -> "{jet_cli_coverage_owner(owner)}.{function.name}"
        }
        // A generic function's instances share its key.
        excluded[function.key.copy()] = true
        out.push(JetCLICoverageFunction{key: function.key.copy(), name: name, line: function.line})
    }
    out.sort_by((left: JetCLICoverageFunction, right: JetCLICoverageFunction) -> (left.line <=> right.line).then(left.name <=> right.name))
    out
}

// A method owner's short name: no module path, no type arguments.
jet_cli_coverage_owner: fn(owner: Type) -> String Never! {
    bare: type_name(owner).split("[").to_list()[0]
    parts: bare.replace("::", ".").split(".").to_list()
    parts[parts.len() - 1].copy()
}

// The probes the harness builds: each coverable function's line by key.
jet_cli_coverage_probes: fn(functions: [JetCLICoverageFunction]) -> [String:Int] Never! {
    probes := [String:Int]{}
    loop function in functions -> probes[function.key.copy()] = function.line
    probes
}

// The lines the run's processes entered, read from `path`, which is then
// removed.
jet_cli_coverage_hits: fn(path: String) -[FS]> [Int:Bool] Never! {
    hits := [Int:Bool]{}
    text: cli_files.read(path) ?? ""
    cli_files.remove(path).drop("the hit file is one run's; a leftover is harmless")
    loop record in text.lines() {
        fields: record.split("\t").to_list()
        if fields.len() != 2 || fields[0] != "f" -> next
        line: Int.parse(fields[1]) ?? next
        hits[line] = true
    }
    hits
}

// The text report: each function HIT or MISS, then the share covered,
// rounded half to even.
jet_cli_coverage_text: fn(file: String, functions: [JetCLICoverageFunction], hits: [Int:Bool]) -> String Never! {
    if functions.len() == 0 -> return "\ncoverage: no functions to measure\n"
    out := "\ncoverage for {file}\n"
    covered := 0
    loop function in functions {
        hit: hits.get(function.line) != None
        if hit -> covered += 1
        mark: if hit -> "HIT " else -> "MISS"
        out = "{out}  {mark}  {function.name}  {file}:{function.line}\n"
    }
    total: functions.len()
    scaled: covered * 100
    percent := scaled /% total
    twice: (scaled % total) * 2
    if twice > total || (twice == total && percent % 2 == 1) -> percent += 1
    "{out}  {covered}/{total} functions covered ({percent}%)\n"
}

// The `--json` status line: `"coverage":{"file","functions":[{name,line,covered}]}`.
jet_cli_coverage_status: fn(file: String, functions: [JetCLICoverageFunction], hits: [Int:Bool]) -> String Never! {
    rows: loop function in functions -> jet_cli_status_object([JetCLIStatusField]{
        jet_cli_status_field("name", jet_cli_status_text(function.name)),
        jet_cli_status_field("line", jet_cli_status_int(function.line)),
        jet_cli_status_field("covered", jet_cli_status_bool(hits.get(function.line) != None)),
    })
    payload: jet_cli_status_object([JetCLIStatusField]{
        jet_cli_status_field("file", jet_cli_status_text(file)),
        jet_cli_status_field("functions", jet_cli_status_array(rows)),
    })
    "{jet_cli_status_render("coverage", true, [JetCLIStatusField]{jet_cli_status_field("coverage", payload)})}\n"
}
