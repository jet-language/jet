JET_CLI_EFFECT_SOURCE :: "// The effect vocabulary is written here, not in Rust.\n//\n// This is ordinary Jet source. Each type implements `Effect`: a struct is an\n// effect root with no members, and an enum is a closed family whose cases are\n// its leaves (`FS.Read`). Effect parsing, marker arguments (`#FX(Net, FS)`),\n// fact registration, manifest and `--allow`/`--deny` validation, diagnostics,\n// and reflection all read this list (Foundation's generated\n// Registry/EffectVocabulary.jet carries it to the compiler), so an effect\n// exists exactly when it is written here. The types' order is the canonical\n// order of a written effect row.\n// `fn irreversible(self) -> Bool` says which effects a `#Transact` rollback\n// can't take back; a family is irreversible when any of its cases is.\n// `Panic`, `Mem` and `Time.Wait` are deny-only: a policy may refuse them but\n// never has to grant them.\n\nstruct Net {{\n    impl Effect {{\n        fn irreversible(self) -> Bool {{ true }}\n    }}\n}}\n\nenum FS {{\n    Read\n    Write\n\n    impl Effect {{\n        fn irreversible(self) -> Bool {{ self == .Write }}\n    }}\n}}\n\nstruct IO {{\n    impl Effect {{}}\n}}\n\nenum DB {{\n    Read\n    Write\n\n    impl Effect {{}}\n}}\n\nenum Time {{\n    Wait\n\n    impl Effect {{}}\n}}\n\nenum Rand {{\n    Draw\n\n    impl Effect {{}}\n}}\n\nstruct Env {{\n    impl Effect {{}}\n}}\n\nenum Exec {{\n    Exit\n    Args\n\n    impl Effect {{\n        fn irreversible(self) -> Bool {{ true }}\n    }}\n}}\n\nstruct Log {{\n    impl Effect {{}}\n}}\n\nstruct GPU {{\n    impl Effect {{}}\n}}\n\nenum FFI {{\n    Go\n    Java\n    DotNet\n    Fortran\n    Cobol\n    Tcl\n    Lua\n    Ada\n    Pascal\n    Dart\n    PowerShell\n    Perl\n    Ruby\n    Php\n    R\n    Com\n    C\n    Cpp\n    Asm\n    Py\n    Octave\n\n    impl Effect {{\n        fn irreversible(self) -> Bool {{ true }}\n    }}\n}}\n\nstruct Browser {{\n    impl Effect {{}}\n}}\n\nstruct Secret {{\n    impl Effect {{}}\n}}\n\nstruct Panic {{\n    impl Effect {{}}\n}}\n\nenum Mem {{\n    Alloc\n    Rc\n\n    impl Effect {{}}\n}}\n"

