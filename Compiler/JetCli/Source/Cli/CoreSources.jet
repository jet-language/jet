// The canonical effect source: Compiler/Prelude/Effects.jet, then
// Core/Effects/Effects.jet, then Core/Compiler/Meta.jet, read from the
// toolchain tree while the compiler builds (JetFoundation
// EFFECT_CANONICAL_SOURCE).
use {
    jet_foundation.[EFFECT_CANONICAL_SOURCE]
}

JET_CLI_EFFECT_SOURCE: comptime { EFFECT_CANONICAL_SOURCE }
