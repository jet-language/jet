pub JET_CLI_EFFECT_SOURCE :: prep { "// D-META-ONE1=A: the effect vocabulary is written here, not in Rust.\n//\n// This is ordinary Jet source. Each line declares one effect root or leaf.\n// Effect parsing, marker arguments (`#FX(Net, FS)`), fact registration,\n// diagnostics, and reflection all read this list, so an effect exists exactly\n// when it is written here.\n\neffect Net $irreversible\neffect FS\neffect FS.Read\neffect FS.Write $irreversible\neffect IO\neffect DB\neffect Time\neffect Rand\neffect Env\neffect Exec $irreversible\neffect Log\neffect GPU\neffect FFI $irreversible\neffect Browser\neffect Secret\n" }

