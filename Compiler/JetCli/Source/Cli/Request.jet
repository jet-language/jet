// The driver request the Jet-hosted `jet` builds for one entry file, the way
// the Rust bootstrap host does (`open_authorized_sources` and
// `__jet_bootstrap_request_from_host`): the entry root and its declared
// path-dependency closure, the Core library rows with their bodies, the
// canonical effect source, and the host facts. The entry root is the nearest
// directory at or above the entry that holds `package.jet`, or the entry's own
// directory for a loose file.
use {
    cli_files: core.files
    cli_sys: core.sys
    cli_tasks: core.tasks
    jet_foundation.[
        AppAuthorizedDirectory,
        BuildOptions,
        BuildSettingOverride,
        AppAuthorizedDirectoryEntry,
        CompilerThreads,
        CompilerTraceSink,
        CORE_DECLARATIONS_PARTS_PATH,
        CORE_SOURCE_OWNED_ROWS,
        CoreDeclarationError,
        CoreDeclarationSource,
        CoreSourceOwnedRow,
        core_decl_fail,
        core_decl_parts,
        ENV_JET_COMPILER_IDENTITY,
        ENV_JET_FRONT_CORE_OBJECT_OUTPUT,
        ENV_JET_FRONT_LIBRARY_LIFECYCLE,
        ENV_JET_FRONT_LIBRARY_OBJECT_OUTPUT,
        ENV_JET_FRONT_RUNTIME_IMAGE_OUTPUT,
        ENV_JET_FRONT_RUNTIME_PACK_OUTPUT,
        ENV_JET_FRONT_RUNTIME_WEB_OUTPUT,
        ENV_JET_RECHECK_VERIFY,
        ENV_JET_TOOLCHAIN_ROOT,
        compiler_take_rows,
        compiler_transfer_rows,
        foundation_json_quote,
        ModuleLayer,
        Program,
        RuntimeInterfaceRow,
        build_options_value,
        target_os_native,
        target_os_parse,
    ]
    jet_driver.[
        JetDriverAuthorizedSourceFile,
        JetDriverAuthorizedSourceRoot,
        JetDriverAuthorizedSourceSnapshot,
        JetDriverCompileMode,
        JetDriverBuildEntry,
        JetDriverBuildPath,
        JetDriverBuildInputError,
        JetDriverCompileRequest,
        JetDriverCompileResult,
        JetDriverKeepGoing,
        JetDriverLoweringInputs,
        JetDriverLoweringInputsResult,
        JetDriverCoreSource,
        JetDriverCoreSourceReader,
        JetDriverComptimeInputLog,
        JetDriverComptimeInputRecord,
        JetDriverHostFacts,
        JetDriverToolchainPackageReader,
        JetDriverToolchainTree,
        JetDriverVerbOutput,
        JET_DRIVER_EXIT_USER_ERROR,
        jet_driver_report_problems,
        jet_driver_compile,
        jet_driver_compile_keep_going,
        jet_driver_lowering_inputs,
        jet_driver_checked_declarations,
        jet_driver_c_symbol,
        jet_driver_compile_escaped_failure,
        jet_driver_shared_build_inputs,
        jet_driver_shared_build_http_inputs,
        jet_driver_core_text,
        jet_driver_core_text_file,
        jet_driver_runtime_interface_file,
        jet_driver_runtime_interface_sources,
        jet_driver_dependency_selector,
        jet_driver_version_selector_matches,
        JetDriverScriptDependency,
        JetDriverScopedImport,
        jet_driver_app_route_names,
        jet_driver_core_import_module,
        jet_driver_file_import_path,
        jet_driver_inline_package,
        jet_driver_is_foreign_provider_import,
        jet_driver_item_is_build_entry,
        jet_driver_pascal_segment,
        jet_driver_scoped_imports,
    ]
    jet_eval.[
        JetEvalConfig,
        JetEvalNativeImageReader,
        JetEvalNativeSession,
        jet_eval_default_config,
        jet_eval_native_session,
    ]
    jet_backend.[x64_link_runtime_image, x64_link_runtime_pack]
    jet_ir.[IRLibraryExportRow, IRLintFinding, ir_build_library, ir_export_abi_json, ir_lint_module, ir_opt_options, ir_optimize_module, ir_thread_exports, ir_x64_compile_module, ir_x64_library_object]
    jet_pkg_model.[BuildStamp, DepSpec, LockFile, LockedBuildContribution, PackageFacts, pkg_load_organization_gate_policy, pkg_lock_load, pkg_manifest_parse, pkg_source_store_path, pkg_to_manifest]
    jet_sema.[SemaOutputIntent]
    jet_web.[web_runtime_partition]
}

// The production CLI's compile, under the driver's all-phases collector with
// `--keep-going` (Controls.jet). A diagnostic trap is a failed compile, never
// an artifact. `trace_sink` traces the keep-going report write
// (`keepgoing.report`).
jet_cli_compile_request: fn(request: &&JetDriverCompileRequest, trace_sink: JetCLITraceSink?{None}) -> JetDriverCompileResult {
    if !jet_cli_keep_going_enabled() -> return jet_driver_compile(request)
    result := jet_driver_compile_keep_going(request, JetDriverKeepGoing{skip: jet_cli_control_items("keep_going_skip")})
    if result.keep_going_rows.len() > 0 -> result.complete = false
    if trace_sink == .Val(sink) -> sink.begin("keepgoing.report", "", -1, -1)
    problem: jet_cli_keep_going_report(result.keep_going_rows)
    if trace_sink == .Val(sink) -> sink.end("keepgoing.report", result.keep_going_rows.len())
    if problem != "" -> return jet_driver_compile_escaped_failure(problem)
    result
}

// jet_cli_compile_request for the native executable route: the compile
// stopped before lowering, with the checked inputs the route builds from
// (Pipeline `jet_driver_lowering_inputs`), under the same keep-going collector.
jet_cli_lowering_inputs: fn(request: &&JetDriverCompileRequest, trace_sink: JetCLITraceSink?) -> JetDriverLoweringInputsResult {
    if !jet_cli_keep_going_enabled() -> return jet_driver_lowering_inputs(request, None)
    front := jet_driver_lowering_inputs(request, Val(JetDriverKeepGoing{skip: jet_cli_control_items("keep_going_skip")}))
    if front.compile.keep_going_rows.len() > 0 -> front.compile.complete = false
    if trace_sink == .Val(sink) -> sink.begin("keepgoing.report", "", -1, -1)
    problem: jet_cli_keep_going_report(front.compile.keep_going_rows)
    if trace_sink == .Val(sink) -> sink.end("keepgoing.report", front.compile.keep_going_rows.len())
    if problem != "" -> return JetDriverLoweringInputsResult{compile: jet_driver_compile_escaped_failure(problem), inputs: None}
    front
}

// `--keep-going` selects the all-phases collector.
jet_cli_keep_going_enabled: fn() -> Bool Never! {
    jet_cli_control_on("keep_going")
}

// Writes the TSV failure census `rows` to the `--keep-going-report` file
// when one is named; the write's failure text, else "".
jet_cli_keep_going_report: fn(rows: [String]) -> String {
    report: jet_cli_control_text("keep_going_report") ?? return ""
    lines := [String]{"phase\titem\tcode\tmessage\tspan"}
    loop row in rows -> lines.push(row.copy())
    lines.push("")
    cli_files.write(report, lines.join("\n")) ?? return "cannot write the compiler failure census: {err}"
    ""
}

// Appends `rows` to the `--keep-going-report` census the front end wrote
// (jet_cli_keep_going_report); the write's failure text, else "".
jet_cli_keep_going_append: fn(rows: [String]) -> String Never! {
    report: jet_cli_control_text("keep_going_report") ?? return ""
    text: rows.join("\n")
    problem: jet_cli_trace_append(report, "{text}\n") ?? return ""
    "cannot append to the compiler failure census `{report}`: {problem}"
}

// Packaging uses the ordinary hosted source loader: the checked
// NativeLibrary program (the compile stopped before lowering) built as IR
// from its `#Export(c)` rows (ir_build_library) at O1, checked by IR Lint
// after the build and after the optimizer, and written as `{prefix}.o` with
// its export list, ABI receipt and thread receipt (ir_thread_exports: the
// exports that can start a second thread), and `{prefix}.interface.jet`: the
// jet.runtime interface its runtime bindings render
// (jet_driver_runtime_interface_file), which Toolchain/RuntimePack.jet checks
// against the embedded copy. The rows alone root the library:
// an entry module's `run: fn` is no startup here, only an export when it is
// `#Export(c)`. `lifecycle` is the lifecycle list's path
// (JET_FRONT_LIBRARY_LIFECYCLE). Each lowering phase is a span of
// `trace_sink` under the names the native route uses (Host.jet), and the web
// partition, Core library and pack links are `runtime.web`, `runtime.core`
// and `runtime.pack`.
jet_cli_runtime_library: fn(front: &&JetDriverLoweringInputsResult, prefix: String, lifecycle: String?, compiler_threads: CompilerThreads, trace_sink: JetCLITraceSink?) -> JetDriverCompileResult {
    owned := front.move()
    result := owned.compile.move()
    if !result.complete || result.internal_problem != None -> return result
    checked := owned.inputs.move() ?? return jet_driver_compile_escaped_failure("the runtime front end returned no checked inputs")
    // The lifecycle list, the export and interface rows and the checked
    // declarations the IR build reads.
    if trace_sink == .Val(sink) -> sink.begin("runtime.inputs", "", -1, -1)
    lifecycle_path: lifecycle ?? return jet_driver_compile_escaped_failure("runtime packaging requires the lifecycle list")
    lifecycle_text: cli_files.read(lifecycle_path) ?? return jet_driver_compile_escaped_failure("cannot read runtime lifecycle list: {err}")
    rows: loop row in checked.c_exports if row.exported -> IRLibraryExportRow{key: row.key, symbol: jet_driver_c_symbol(row.name)}
    interface_rows := [RuntimeInterfaceRow]{}
    loop row in checked.c_exports {
        found: row.runtime_interface ?? next
        if found.declaration == "" -> return jet_driver_compile_escaped_failure("the runtime's public function `{found.module_name}.{found.member}` has a signature the jet.runtime interface can't render (type parameters, or a parameter convention, default or variadic) or is `priv(package)`")
        interface_rows.push(RuntimeInterfaceRow{module_name: found.module_name.copy(), member: found.member.copy(), declaration: found.declaration.copy(), symbol: found.symbol.copy()})
    }
    interface_text: jet_driver_runtime_interface_file(interface_rows)
    declarations := jet_driver_checked_declarations(checked)
    if trace_sink == .Val(sink) -> sink.end("runtime.inputs", interface_rows.len())
    if trace_sink == .Val(sink) -> sink.begin("ir.build", "", -1, -1)
    library := ir_build_library(checked.functions.move(), checked.decls, checked.symbols.move(), declarations.type_defs.move(), declarations.impls.move(), checked.sources.move(), declarations.constants.move(), declarations.foreign.move(), rows, lifecycle_text.split("\n").to_list())
    if trace_sink == .Val(sink) -> sink.end("ir.build", library.program.functions.len())
    issues := compiler_take_rows<String>(library.errors)
    loop failure in library.failures -> issues.push("{failure.name} [{failure.key}]: {failure.message} at {failure.source_file}:{failure.span.start}..{failure.span.end}")
    // The memory term is read now: the front end before this holds most of it.
    threads: CompilerThreads{cap: compiler_threads.cap, cores: compiler_threads.cores, memory_available: jet_cli_memory_available()}
    if issues.len() == 0 {
        if trace_sink == .Val(sink) -> sink.begin("ir.lint", "", -1, -1)
        loop finding in ir_lint_module(library.program, "ir.build", threads) -> issues.push(jet_cli_runtime_lint_issue(finding))
        if trace_sink == .Val(sink) -> sink.end("ir.lint", library.program.functions.len())
    }
    if issues.len() == 0 {
        if trace_sink == .Val(sink) -> sink.begin("ir.opt", "", -1, -1)
        _ := ir_optimize_module(library.program, ir_opt_options(1), threads)
        if trace_sink == .Val(sink) -> sink.end("ir.opt", library.program.functions.len())
        if trace_sink == .Val(sink) -> sink.begin("ir.lint", "", -1, -1)
        loop finding in ir_lint_module(library.program, "ir.opt", threads) -> issues.push(jet_cli_runtime_lint_issue(finding))
        if trace_sink == .Val(sink) -> sink.end("ir.lint", library.program.functions.len())
    }
    if issues.len() == 0 {
        thread_exports: ir_thread_exports(library.program, library.exports, [String]{})
        if trace_sink == .Val(sink) -> sink.begin("ir.x64", "", -1, -1)
        compiled := ir_x64_compile_module(library.program.move(), threads)
        if trace_sink == .Val(sink) -> sink.end("ir.x64", compiled.functions.len())
        // JET_FRONT_RUNTIME_WEB_OUTPUT: the runtime partition of a web build
        // (JetWeb Build.jet), selected from the same lowered module, as
        // `{prefix}.wasm` with its receipt `{prefix}.wasm.tsv`.
        if cli_sys.get(ENV_JET_FRONT_RUNTIME_WEB_OUTPUT) == .Val(web_prefix) {
            if trace_sink == .Val(sink) -> sink.begin("runtime.web", "", -1, -1)
            web := web_runtime_partition(compiled.program, library.exports, library.data)
            if trace_sink == .Val(sink) -> sink.end("runtime.web", web.bytes.len())
            if web.errors.len() > 0 {
                cli_files.write("{prefix}.issues", web.errors.join("\n")) ?? return jet_driver_compile_escaped_failure("cannot write runtime library findings: {err}")
                return jet_driver_compile_escaped_failure("the runtime's web partition failed; see {prefix}.issues")
            }
            cli_files.write_bytes("{web_prefix}.wasm", web.bytes) ?? return jet_driver_compile_escaped_failure("cannot write the runtime's web partition: {err}")
            cli_files.write("{web_prefix}.wasm.tsv", web.receipt) ?? return jet_driver_compile_escaped_failure("cannot write the runtime's web receipt: {err}")
        }
        if trace_sink == .Val(sink) -> sink.begin("ir.object", "", -1, -1)
        object := ir_x64_library_object(compiled, library.exports, library.data, true, true)
        if trace_sink == .Val(sink) -> sink.end("ir.object", object.bytes.len())
        if object.errors.len() == 0 {
            cli_files.write_bytes("{prefix}.o", object.bytes) ?? return jet_driver_compile_escaped_failure("cannot write runtime object: {err}")
            // Sorted: `jet run` binary-searches it (Host.jet jet_cli_runtime_exports_mark).
            symbols := loop row in library.exports -> row.symbol
            symbols.sort()
            cli_files.write("{prefix}.exports", symbols.join("\n")) ?? return jet_driver_compile_escaped_failure("cannot write runtime exports: {err}")
            cli_files.write("{prefix}.abi.json", ir_export_abi_json(library.abis)) ?? return jet_driver_compile_escaped_failure("cannot write runtime ABI: {err}")
            cli_files.write("{prefix}.threads", thread_exports.join("\n")) ?? return jet_driver_compile_escaped_failure("cannot write runtime thread receipt: {err}")
            cli_files.write("{prefix}.interface.jet", interface_text) ?? return jet_driver_compile_escaped_failure("cannot write the runtime interface: {err}")
            // JET_FRONT_CORE_OBJECT_OUTPUT: the Core code library
            // (CoreLibrary.jet), which the runtime image links beside the
            // runtime; Core starts threads through the runtime, so the
            // runtime's receipt is what its own receipt reaches.
            core := [U8]?{None}
            if cli_sys.get(ENV_JET_FRONT_CORE_OBJECT_OUTPUT) == .Val(core_prefix) {
                if trace_sink == .Val(sink) -> sink.begin("runtime.core", "", -1, -1)
                built := jet_cli_core_library(core_prefix, thread_exports, threads)
                if trace_sink == .Val(sink) -> sink.end("runtime.core", built.bytes.len())
                if built.problem != "" -> return jet_driver_compile_escaped_failure(built.problem)
                core = Val(built.bytes.move())
            }
            if trace_sink == .Val(sink) -> sink.begin("runtime.pack", "", -1, -1)
            packed: jet_cli_runtime_pack(result, prefix, object.bytes.move(), core.move())
            if trace_sink == .Val(sink) -> sink.end("runtime.pack", -1)
            return packed
        }
        compiler_transfer_rows<String>(issues, object.errors)
    }
    cli_files.write("{prefix}.issues", issues.join("\n")) ?? return jet_driver_compile_escaped_failure("cannot write runtime library findings: {err}")
    jet_driver_compile_escaped_failure("runtime library lowering failed; see {prefix}.issues")
}

// An IR Lint finding (Lint.jet) over the runtime library: a compiler bug,
// one issue row naming the function, the pass and the rule.
jet_cli_runtime_lint_issue: fn(finding: IRLintFinding) -> String Never! {
    "{finding.function}: IR Lint after {finding.pass}, {finding.rule}: {finding.message}"
}

// JET_FRONT_RUNTIME_PACK_OUTPUT: links the runtime library object `object`
// alone into the runtime pack, with no C archive (#6693), and
// JET_FRONT_RUNTIME_IMAGE_OUTPUT: the pack prelinked at the run base, which
// `jet run` binds programs to (Image/RuntimePack.jet x64_link_runtime_image).
// With the Core object `core` (jet_cli_core_library) the image prelinks the
// runtime object and it together, so a program bound to the image can call
// a Core function by its symbol; the pack, which a full link reads, stays
// the runtime's alone.
jet_cli_runtime_pack: fn(result: &&JetDriverCompileResult, prefix: String, object: &&[U8], core: &&[U8]?) -> JetDriverCompileResult {
    if cli_sys.get(ENV_JET_FRONT_RUNTIME_PACK_OUTPUT) == .Val(pack_path) {
        linked := x64_link_runtime_pack([String]{"{prefix}.o"}, [[U8]]{object.move()}, [String]{})
        if linked.errors.len() > 0 {
            cli_files.write("{prefix}.pack-issues", linked.errors.join("\n")) ?? return jet_driver_compile_escaped_failure("cannot write runtime pack findings: {err}")
            return jet_driver_compile_escaped_failure("runtime pack linking failed; see {prefix}.pack-issues")
        }
        cli_files.write_bytes(pack_path, linked.bytes) ?? return jet_driver_compile_escaped_failure("cannot write runtime pack: {err}")
        if cli_sys.get(ENV_JET_FRONT_RUNTIME_IMAGE_OUTPUT) == .Val(image_path) {
            prelinked := [U8]{}
            if core.move() == .Val(code) {
                // The runtime object moved into the pack link; it is read
                // back from the file written above.
                runtime_object := cli_files.read_bytes("{prefix}.o") ?? return jet_driver_compile_escaped_failure("cannot read the runtime object back: {err}")
                both := x64_link_runtime_pack([String]{"{prefix}.o", "the Core library object"}, [[U8]]{runtime_object.move(), code}, [String]{})
                if both.errors.len() > 0 {
                    cli_files.write("{prefix}.pack-issues", both.errors.join("\n")) ?? return jet_driver_compile_escaped_failure("cannot write runtime image findings: {err}")
                    return jet_driver_compile_escaped_failure("linking the runtime and Core for the runtime image failed; see {prefix}.pack-issues")
                }
                prelinked = both.bytes.move()
            } else {
                prelinked = linked.bytes.move()
            }
            image: x64_link_runtime_image(pack_path, prelinked.move())
            if image.errors.len() > 0 {
                cli_files.write("{prefix}.pack-issues", image.errors.join("\n")) ?? return jet_driver_compile_escaped_failure("cannot write runtime image findings: {err}")
                return jet_driver_compile_escaped_failure("runtime image linking failed; see {prefix}.pack-issues")
            }
            cli_files.write_bytes(image_path, image.bytes) ?? return jet_driver_compile_escaped_failure("cannot write runtime image: {err}")
        }
    }
    result
}

// Names the Jet toolchain source tree: the directory that holds `Core/`.
// Unset, the tree is found (jet_cli_toolchain_root); with no tree, jet
// compiles against the Core sources built into it (jet_cli_core_sources).
JET_CLI_TOOLCHAIN_ROOT_ENV: ENV_JET_TOOLCHAIN_ROOT
// This compiler's identity (`name@version#<source id>`). Unset, it is read from
// the IDENTITY file beside the jet executable (jet_cli_compiler_identity).
JET_CLI_COMPILER_IDENTITY_ENV: ENV_JET_COMPILER_IDENTITY
// Beside the jet executable: the file holding its identity on one line.
JET_CLI_IDENTITY_FILE: "IDENTITY"

// The directory holding the running jet executable.
jet_cli_executable_dir: fn() -[Env]> String Never! {
    jet_cli_parent(cli_sys.executable()) ?? "/"
}

// The running compiler's identity: JET_COMPILER_IDENTITY, else the one line of
// the IDENTITY file beside the executable; None when neither names one.
jet_cli_compiler_identity: fn() -> String? Never! {
    if cli_sys.get(JET_CLI_COMPILER_IDENTITY_ENV) == .Val(value) -> return Val(value)
    text: cli_files.read(jet_cli_authority_path(jet_cli_executable_dir(), JET_CLI_IDENTITY_FILE)) ?? return None
    identity: text.trim()
    if identity == "" || identity.contains("\n") -> return None
    Val(identity)
}

// The refusal when this compiler has no identity, naming both places it looks.
jet_cli_identity_missing: fn() -> (what: String, fix: String) Never! {
    file: jet_cli_authority_path(jet_cli_executable_dir(), JET_CLI_IDENTITY_FILE)
    (what: "this compiler has no identity: `{JET_CLI_COMPILER_IDENTITY_ENV}` is not set and `{file}` names none", fix: "set `{JET_CLI_COMPILER_IDENTITY_ENV}` to the compiler's `name@version#build-id`, or write that one line to `{file}`")
}

// Whether `directory` holds a Jet toolchain: the Core library and the
// compiler prelude.
jet_cli_is_toolchain: fn(directory: String) -[FS]> Bool Never! {
    cli_files.is_dir(jet_cli_authority_path(directory, "Core")) && cli_files.is_dir(jet_cli_authority_path(directory, "Compiler/Prelude"))
}

// Whether `directory` is the Core library of the toolchain whose sources a
// compile there reads (jet_cli_toolchain_root): `jet check Core`.
jet_cli_is_core_library: fn(directory: String) -[FS, Env]> Bool Never! {
    if jet_cli_toolchain_root(directory) == {
        .Found(root) -> {
            core: cli_files.realpath(jet_cli_authority_path(root, "Core")) ?? return false
            (cli_files.realpath(directory) ?? return false) == core
        }
        .Missing(_, _) -> false
    }
}

// Where the toolchain sources a request for `input` (a file or directory) come from.
JetCLIToolchainRoot: enum {
    Found(root: String)
    Missing(what: String, fix: String)
}

// The toolchain source tree: JET_TOOLCHAIN_ROOT, else the nearest directory at
// or above `input` that holds a toolchain (a Jet checkout, whose own Core
// takes precedence for contributors). Missing names both places; a compile
// then reads the Core sources built into jet, and only the tools that need
// a checkout's other files refuse.
jet_cli_toolchain_root: fn(input: String) -> JetCLIToolchainRoot Never! {
    if cli_sys.get(JET_CLI_TOOLCHAIN_ROOT_ENV) == .Val(root) -> return JetCLIToolchainRoot.Found{root: root}
    start: cli_files.realpath(input) ?? input
    current := start
    loop {
        if jet_cli_is_toolchain(current) -> return JetCLIToolchainRoot.Found{root: current}
        if current == "/" -> break
        current = jet_cli_parent(current) ?? break
    }
    JetCLIToolchainRoot.Missing{
        what: "can't find the Jet toolchain sources: `{JET_CLI_TOOLCHAIN_ROOT_ENV}` is not set and no directory at or above `{start}` holds `Core/` and `Compiler/Prelude/`",
        fix: "set `{JET_CLI_TOOLCHAIN_ROOT_ENV}` to the Jet toolchain source tree, or run jet inside a Jet checkout",
    }
}

JET_CLI_MAX_TREE_DEPTH: 256
JET_CLI_MAX_SOURCE_BYTES: 536870912
JET_CLI_MAX_SOURCE_TOTAL: 4294967296
JET_CLI_MAX_SOURCE_FILES: 1000000

// A directory holding one of these is its own project, outside the walk.
JET_CLI_PROJECT_MARKERS: [String]{"package.jet", "pkg.jet", "workspace.jet", ".jet/lock"}

// Names the source walk never enters or reads, besides every name that starts
// with `.`.
JET_CLI_SKIPPED_NAMES: [String]{"target", "build", "node_modules", "bin"}

// Generated foreign-binding caches and the sidecars each binding may carry.
JET_CLI_FOREIGN_CACHE_DIRECTORIES: [String]{".jet/bindings/c", ".jet/bindings/cpp"}
JET_CLI_FOREIGN_CACHE_SIDECARS: [String]{"metadata", "provenance"}

JetCLICompiled: enum {
    // The driver ran; `snapshot` is the source snapshot it compiled, kept for
    // presenting diagnostics against the files that own them.
    Compiled(result: JetDriverCompileResult, snapshot: JetDriverAuthorizedSourceSnapshot)
    // The host could not assemble the request: write these bytes and exit.
    Refused(output: JetDriverVerbOutput)
}

// `root` joined with a root-relative path (Loader.jet `jet_driver_authority_path`).
jet_cli_authority_path: fn(root: String, relative: String) -> String Never! {
    if root == "/" -> return "/{relative}"
    "{root}/{relative}"
}

// `identity_key` over `FileIdentity::from_metadata`. Directory identity is
// pinned to the opened object, not its mutable listing.
jet_cli_identity_key: fn(kind: String, stat: cli_files.Stat) -> String Never! {
    if kind == "directory" -> return "authority-file-v1;kind=directory;length=0;modified_ns=none;device={stat.id.device};inode={stat.id.inode}"
    modified: if stat.modified.to_unix_ns() == {
        .Ok(value) -> if value >= 0 -> "{value}" else -> "none"
        .Err(_) -> "none"
    }
    "authority-file-v1;kind={kind};length={stat.size};modified_ns={modified};device={stat.id.device};inode={stat.id.inode}"
}

jet_cli_is_project_boundary: fn(directory: String) -[FS]> Bool Never! {
    loop marker in JET_CLI_PROJECT_MARKERS {
        marker_path: "{directory}/{marker}"
        if cli_files.is_file(marker_path) || cli_files.is_symlink(marker_path) -> return true
    }
    false
}

// `discover_source_files_from`: entries in name order, so the files come out in
// relative-path order; a symlinked directory is skipped and any other symlink
// refused; dot names, build output, and nested projects stay out. With
// `retain_directories`, every walked directory's complete immediate listing
// (taken before those filters, empty directories included) goes to
// `directories` for App convention routing. Returns the problem that stopped
// the walk.
JetCLISourceBudget: struct {
    entries: Int
    bytes: Int
    files: Int
}

jet_cli_source_read_limit: fn(budget: JetCLISourceBudget, size: Int, path: String) -> Int JetCLIReadError! {
    if size > JET_CLI_MAX_SOURCE_BYTES -> return Err(jet_cli_read_error("`{path}` exceeds the {JET_CLI_MAX_SOURCE_BYTES}-byte file bound"))
    if budget.files >= JET_CLI_MAX_SOURCE_FILES -> return Err(jet_cli_read_error("authorized sources exceed the {JET_CLI_MAX_SOURCE_FILES}-file bound at `{path}`"))
    remaining: JET_CLI_MAX_SOURCE_TOTAL - budget.bytes
    if size > remaining -> return Err(jet_cli_read_error("authorized sources exceed the {JET_CLI_MAX_SOURCE_TOTAL}-byte total bound at `{path}`"))
    Ok(if remaining < JET_CLI_MAX_SOURCE_BYTES -> remaining else -> JET_CLI_MAX_SOURCE_BYTES)
}

jet_cli_replace_source_budget: fn(budget: &JetCLISourceBudget, before: String, after: String, path: String) -> Int JetCLIReadError! {
    replacement: JetCLISourceBudget{entries: budget.entries, bytes: budget.bytes - before.count_bytes(), files: budget.files - 1}
    size: after.count_bytes()
    _: jet_cli_source_read_limit(replacement, size, path)
    budget.bytes = replacement.bytes + size
    Ok(budget.bytes)
}

jet_cli_walk_sources: fn(root: String, relative: String, depth: Int, files: &[JetDriverAuthorizedSourceFile], directories: &[AppAuthorizedDirectory], retain_directories: Bool, budget: &JetCLISourceBudget) -[FS]> String? Never! {
    directory: if relative == "" -> root else -> jet_cli_authority_path(root, relative)
    chain := [cli_files.Directory]{}
    names := [String]{}
    initial: jet_cli_hold_root_chain(directory, chain, names) ?? return Val(err.message)
    if jet_cli_build_read_chain_current(chain, names, initial) == .Err(problem) -> return Val(problem.message)
    if jet_cli_walk_held_sources(root, relative, depth, chain[chain.len() - 1], files, directories, retain_directories, budget) == .Val(problem) -> return Val(problem)
    if jet_cli_build_read_chain_current(chain, names, initial) == .Err(problem) -> return Val(problem.message)
    None
}

jet_cli_walk_held_sources: fn(root: String, relative: String, depth: Int, held: cli_files.Directory, files: &[JetDriverAuthorizedSourceFile], directories: &[AppAuthorizedDirectory], retain_directories: Bool, budget: &JetCLISourceBudget) -[FS]> String? Never! {
    directory: if relative == "" -> root else -> jet_cli_authority_path(root, relative)
    listing: held.list() ?? return Val("cannot list `{directory}`: {err}")
    if listing.len() > JET_CLI_MAX_SOURCE_FILES - budget.entries -> return Val("the source walk exceeds the {JET_CLI_MAX_SOURCE_FILES}-entry bound at `{directory}`")
    budget.entries += listing.len()
    if retain_directories {
        entries := [AppAuthorizedDirectoryEntry]{}
        loop entry in listing {
            entries.push(AppAuthorizedDirectoryEntry{
                name: entry.name,
                path: jet_cli_authority_path(directory, entry.name),
                is_directory: entry.is_dir,
                name_is_unicode: entry.name_is_unicode,
            })
        }
        directories.push(AppAuthorizedDirectory{path: directory, entries: entries})
    }
    loop entry in listing {
        name: entry.name
        child: if relative == "" -> name else -> "{relative}/{name}"
        path: jet_cli_authority_path(root, child)
        if !entry.name_is_unicode {
            if name.ends_with(".jet") -> return Val("`{path}` has a non-Unicode source name")
            next
        }
        stat: held.entry_stat(name) ?? return Val("cannot inspect `{path}`: {err}")
        if stat.is_symlink {
            // Reference source discovery skips directory links without reading
            // them; all other links are refused before name filtering.
            if cli_files.is_dir(path) -> next
            return Val("`{path}` is a symbolic link")
        }
        if name.starts_with(".") || JET_CLI_SKIPPED_NAMES.contains(name) -> next
        if stat.is_dir {
            child_held: held.open_directory(name) ?? return Val("cannot open `{path}`: {err}")
            opened: child_held.stat() ?? return Val("cannot inspect `{path}`: {err}")
            if opened.id != stat.id -> return Val("`{path}` changed while it was held")
            if jet_cli_held_project_boundary(child_held) == {
                .Ok(boundary) -> { if boundary -> next }
                .Err(problem) -> { return Val(problem.message) }
            }
            if depth >= JET_CLI_MAX_TREE_DEPTH -> return Val("the source walk exceeds the {JET_CLI_MAX_TREE_DEPTH}-level depth bound at `{path}`")
            if jet_cli_walk_held_sources(root, child, depth + 1, child_held, files, directories, retain_directories, budget) == .Val(problem) -> return Val(problem)
            current: held.entry_stat(name) ?? return Val("cannot inspect `{path}`: {err}")
            if !current.is_dir || current.is_symlink || current.id != stat.id -> return Val("`{path}` changed while it was held")
            next
        }
        if !name.ends_with(".jet") -> next
        if !stat.is_file -> return Val("`{path}` is not a regular file")
        limit: jet_cli_source_read_limit(budget, stat.size, path) ?? return Val(err.message)
        read: jet_cli_read_held_source(held, name, limit) ?? return Val("cannot read `{path}`: {err.message}")
        budget.bytes += read.stat.size
        budget.files += 1
        if !jet_cli_build_read_same_file(stat, read.stat) -> return Val("`{path}` changed while it was held")
        source: String.from_bytes(read.bytes.move()) ?? return Val("cannot read `{path}`: file is not valid UTF-8")
        // A script (a `#!/...` launch line) is a standalone program wherever
        // it lives, never a member of the package around it.
        if jet_cli_is_script(source) -> next
        files.push(JetDriverAuthorizedSourceFile{path: path, relative_path: child, identity: jet_cli_identity_key("file", read.stat), source: source})
    }
    None
}

// The sources a loose entry reaches (jet_cli_prepare_snapshot), read into
// `files` in walk order by the walk's placement, link, stat and read rules,
// so an unrelated link or unreadable file elsewhere under its folder is never
// opened. A source is reached through a `use "path"` file import, a local
// `use name` module import or a body-less `name: module`, resolved by the
// loader's own candidate paths (Loader.jet jet_driver_lookup_file_target,
// jet_driver_find_module_import_target, jet_driver_code_module_file). False
// when the folder needs its whole tree after all: the entry or a stock entry
// carries an inline `package:` block, a module import no candidate path
// holds may name any file of the tree (the loader's module-name index),
// `.routes(from:)` reads a directory's shape, or a reached source declares
// the build entry `build: fn(b: Build)`, whose source lists may name any
// file of the folder.
jet_cli_reach_sources: fn(root: String, entry: String, files: &[JetDriverAuthorizedSourceFile], budget: &JetCLISourceBudget) -[FS]> Bool JetCLIReadError! {
    pending := [String]{entry.copy()}
    loop stock in JET_CLI_STOCK_ENTRIES {
        if stock != entry -> pending.push(stock.copy())
    }
    held := [String]{}
    next_index := 0
    loop next_index < pending.len() {
        relative: pending[next_index].copy()
        next_index += 1
        if held.contains(relative) || jet_cli_outside_walk(root, relative) -> next
        held.push(relative.copy())
        path: jet_cli_authority_path(root, relative)
        stat: cli_files.stat(path) ?? {
            if err == .NotFound(_) -> next
            return Err(jet_cli_read_error("cannot inspect `{path}`: {err}"))
        }
        if stat.is_symlink -> return Err(jet_cli_read_error("`{path}` is a symbolic link"))
        if stat.is_dir -> next
        if !stat.is_file -> return Err(jet_cli_read_error("`{path}` is not a regular file"))
        limit: jet_cli_source_read_limit(budget, stat.size, path) ?? return Err(err)
        read: jet_cli_read_rooted_source(root, relative, limit) ?? return Err(jet_cli_read_error("cannot read `{path}`: {err.message}"))
        if !jet_cli_build_read_same_file(stat, read.stat) -> return Err(jet_cli_read_error("`{path}` changed while it was held"))
        budget.bytes += read.stat.size
        budget.files += 1
        source: String.from_bytes(read.bytes.move()) ?? return Err(jet_cli_read_error("cannot read `{path}`: file is not valid UTF-8"))
        // A script is a standalone program, never a source another file reaches.
        if relative != entry && jet_cli_is_script(source) -> next
        carrier: jet_driver_inline_package(source)
        if carrier.found || carrier.error != None -> return Ok(false)
        if jet_cli_parsed_program(source) == .Val(program) {
            if !jet_cli_reached_paths(root, relative, program, pending) -> return Ok(false)
        }
        at := files.len()
        loop (position, file) in files {
            if jet_cli_relative_precedes(relative, file.relative_path) {
                at = position
                break
            }
        }
        files.insert(at, JetDriverAuthorizedSourceFile{path: path, relative_path: relative, identity: jet_cli_identity_key("file", read.stat), source: source})
    }
    Ok(true)
}

// The root-relative paths the source at `relative` reaches, onto `pending`
// (jet_cli_reach_sources); false when one may name any file of the tree: an
// app route or the build entry.
jet_cli_reached_paths: fn(root: String, relative: String, program: Program, pending: &[String]) -[FS]> Bool Never! {
    if jet_driver_app_route_names(program).len() > 0 -> return false
    scoped := [JetDriverScopedImport]{}
    jet_driver_scoped_imports(program.imports, program.items, "", true, scoped)
    loop row in scoped {
        declaration: row.declaration
        // Core, foreign and versioned imports name no file of the folder.
        if jet_driver_is_foreign_provider_import(declaration) || jet_driver_core_import_module(declaration) != None || declaration.inline_version != None -> next
        if declaration.kind == {
            .File(path, _) -> {
                resolved: jet_driver_file_import_path(relative, path)
                if resolved.valid -> pending.push(resolved.path)
            }
            .Module(name, _) -> {
                found := false
                loop candidate in jet_cli_module_candidates(name) {
                    candidate_path: jet_cli_authority_path(root, candidate)
                    if cli_files.exists(candidate_path) || cli_files.is_symlink(candidate_path) {
                        pending.push(candidate)
                        found = true
                    }
                }
                if !found -> return false
            }
            .Unqualified(_, _, _, _, _) -> {}
        }
    }
    loop item in program.items {
        if jet_driver_item_is_build_entry(item) -> return false
        if item == .CodeModule(definition) && definition.body == None {
            candidates: [String]{definition.name.copy(), "{definition.name}/module"}
            loop candidate in candidates {
                resolved: jet_driver_file_import_path(relative, candidate)
                if resolved.valid -> pending.push(resolved.path)
            }
        }
    }
    true
}

// The root-relative files a local `use name` import may load, in the
// loader's order (Loader.jet jet_driver_find_module_import_target); none
// for a name with an unsafe component, which the loader refuses.
jet_cli_module_candidates: fn(name: String) -> [String] Never! {
    if name.len() == 0 || name == "." || name == ".." || name.contains("/") || name.contains("\\") -> return [String]{}
    pascal: jet_driver_pascal_segment(name)
    [String]{"{name}.jet", "{pascal}.jet", "{name}/run.jet", "{pascal}/run.jet"}
}

jet_cli_held_project_boundary: fn(directory: cli_files.Directory) -[FS]> Bool JetCLIReadError! {
    loop marker in JET_CLI_PROJECT_MARKERS {
        if marker == ".jet/lock" {
            info: directory.entry_stat(".jet") ?? {
                if err == .NotFound(_) -> next
                return Err(jet_cli_read_error(jet_cli_io_error_text(err)))
            }
            if info.is_symlink -> return Ok(true)
            if !info.is_dir -> next
            nested: directory.open_directory(".jet") ?? return Err(jet_cli_read_error(jet_cli_io_error_text(err)))
            lock: nested.entry_stat("lock") ?? {
                if err == .NotFound(_) -> next
                return Err(jet_cli_read_error(jet_cli_io_error_text(err)))
            }
            if lock.is_file || lock.is_symlink -> return Ok(true)
        } else {
            info: directory.entry_stat(marker) ?? {
                if err == .NotFound(_) -> next
                return Err(jet_cli_read_error(jet_cli_io_error_text(err)))
            }
            if info.is_file || info.is_symlink -> return Ok(true)
        }
    }
    Ok(false)
}

JetCLICacheSource: struct {
    relative_path: String
    read: JetCLIHeldSource
}

// One checked foreign-cache record under `root` (a binding or its sidecar).
jet_cli_cache_file: fn(root: String, relative: String, budget: &JetCLISourceBudget) -[FS]> JetCLICacheSource JetCLIReadError! {
    path: jet_cli_authority_path(root, relative)
    stat: cli_files.stat(path) ?? return Err(jet_cli_read_error("cannot inspect `{path}`: {err}"))
    if stat.is_symlink -> return Err(jet_cli_read_error("`{path}` is a symbolic link"))
    if !stat.is_file -> return Err(jet_cli_read_error("`{path}` is not a regular file"))
    limit: jet_cli_source_read_limit(budget, stat.size, path)
    read: jet_cli_read_rooted_source(root, relative, limit) ?? return Err(jet_cli_read_error("cannot read `{path}`: {err.message}"))
    if !jet_cli_build_read_same_file(stat, read.stat) -> return Err(jet_cli_read_error("`{path}` changed while it was held"))
    budget.bytes += read.stat.size
    budget.files += 1
    Ok(JetCLICacheSource{relative_path: relative, read: read})
}

// `collect_authorized_foreign_cache_files`: every generated C and C++ binding
// (not the `.adapted.jet` views) with its `.metadata` and `.provenance`
// sidecars, in relative-path order.
jet_cli_foreign_cache_files: fn(root: String, caches: &[JetDriverAuthorizedSourceFile], budget: &JetCLISourceBudget) -[FS]> String? Never! {
    collected := [JetCLICacheSource]{}
    loop cache_directory in JET_CLI_FOREIGN_CACHE_DIRECTORIES {
        directory: jet_cli_authority_path(root, cache_directory)
        directory_info: cli_files.stat(directory) ?? {
            if err == .NotFound(_) -> next
            return Val("cannot inspect `{directory}`: {err}")
        }
        if directory_info.is_symlink || !directory_info.is_dir -> return Val("`{directory}` is not a real directory")
        held: jet_cli_rooted_open_root(directory) ?? return Val(err.message)
        held_info: held.stat() ?? return Val("cannot inspect `{directory}`: {err}")
        if held_info.id != directory_info.id -> return Val("`{directory}` changed while it was held")
        entries: held.list() ?? return Val("cannot list `{directory}`: {err}")
        if entries.len() > JET_CLI_MAX_SOURCE_FILES -> return Val("cache discovery exceeds the {JET_CLI_MAX_SOURCE_FILES}-entry bound")
        discovery := JetCLISourceBudget{entries: entries.len(), bytes: 0, files: 0}
        bindings := [JetCLICacheSource]{}
        loop entry in entries {
            if !entry.name_is_unicode -> return Val("`{directory}` contains a cache name that cannot be addressed as UTF-8")
            name: entry.name
            relative: "{cache_directory}/{name}"
            path: jet_cli_authority_path(root, relative)
            stat: held.entry_stat(name) ?? return Val("cannot inspect `{path}`: {err}")
            if stat.is_symlink -> return Val("`{path}` is a symbolic link")
            if !name.ends_with(".jet") -> next
            if !stat.is_file -> return Val("`{path}` is not a regular file")
            // discover_files validates every .jet, including hidden bindings
            // and adapted views, before its caller selects generated caches.
            limit := jet_cli_source_read_limit(discovery, stat.size, path) ?? return Val(err.message)
            adapted: name.ends_with(".adapted.jet")
            if !adapted {
                shared_limit: jet_cli_source_read_limit(budget, stat.size, path) ?? return Val(err.message)
                if shared_limit < limit -> limit = shared_limit
            }
            read: jet_cli_read_held_source(held, name, limit) ?? return Val("cannot read `{path}`: {err.message}")
            if !jet_cli_build_read_same_file(stat, read.stat) -> return Val("`{path}` changed while it was held")
            discovery.bytes += read.stat.size
            discovery.files += 1
            if adapted -> next
            budget.bytes += read.stat.size
            budget.files += 1
            bindings.push(JetCLICacheSource{relative_path: relative, read: read})
        }
        current: cli_files.stat(directory) ?? return Val("cannot revalidate `{directory}`: {err}")
        if !current.is_dir || current.is_symlink || current.id != held_info.id -> return Val("`{directory}` changed while it was held")
        // The reference discovers all bindings first, then opens metadata and
        // provenance in that order. Convert UTF-8 only after final path sorting.
        loop binding in bindings {
            stem: binding.relative_path.slice(0..<(binding.relative_path.len() - 4))
            loop extension in JET_CLI_FOREIGN_CACHE_SIDECARS {
                relative: "{stem}.{extension}"
                path: jet_cli_authority_path(root, relative)
                _: cli_files.stat(path) ?? {
                    if err == .NotFound(_) -> next
                    return Val("cannot inspect `{path}`: {err}")
                }
                sidecar: jet_cli_cache_file(root, relative, budget) ?? return Val(err.message)
                collected.push(sidecar)
            }
            collected.push(binding)
        }
    }
    collected.sort_by(fn(left: JetCLICacheSource, right: JetCLICacheSource) { left.relative_path <=> right.relative_path })
    loop file in collected {
        path: jet_cli_authority_path(root, file.relative_path)
        source: String.from_bytes(file.read.bytes.move()) ?? return Val("cannot read `{path}`: file is not valid UTF-8")
        caches.push(JetDriverAuthorizedSourceFile{path: path, relative_path: file.relative_path, identity: jet_cli_identity_key("file", file.read.stat), source: source})
    }
    None
}

// Read dependency declarations from the bytes already in the snapshot, never
// by reopening the manifest. Inline Package carriers use the same model, and
// the carrier is the one the driver selects (jet_driver_root_inline_carrier):
// the entry file's own block (`entry`, the entry root's entry path; "" for a
// dependency root), else the first stock entry's.
jet_cli_root_dependencies: fn(root: JetDriverAuthorizedSourceRoot, entry: String) -> [String: DepSpec] Never! {
    loop file in root.files {
        if file.relative_path != "package.jet" -> next
        manifest: pkg_manifest_parse(file.path, file.source) ?? return [String: DepSpec]{}
        return manifest.dependencies
    }
    loop file in root.files {
        if file.path != entry -> next
        if jet_cli_inline_dependencies(file) == .Val(dependencies) -> return dependencies
    }
    loop relative in JET_CLI_STOCK_ENTRIES {
        loop file in root.files {
            if file.relative_path != relative || file.path == entry -> next
            if jet_cli_inline_dependencies(file) == .Val(dependencies) -> return dependencies
        }
    }
    [String: DepSpec]{}
}

// The dependencies of `file`'s inline `package:` block: none for a malformed
// block (the driver reports it), or None when the file carries no block.
jet_cli_inline_dependencies: fn(file: JetDriverAuthorizedSourceFile) -> [String: DepSpec]? Never! {
    inline: if PackageFacts.parse_inline(file.source, file.path) == {
        .Ok(value) -> value
        .Err(_) -> { return Val([String: DepSpec]{}) }
    }
    if inline == .Val(carrier) {
        manifest: pkg_to_manifest(carrier.facts, file.source) ?? return Val([String: DepSpec]{})
        return Val(manifest.dependencies)
    }
    None
}

jet_cli_dependency_within: fn(path: String, root: String) -> Bool Never! {
    path == root || path.starts_with(if root.ends_with("/") -> root else -> "{root}/")
}

// `RootPathReach`: the entry's relative declarations, canonicalized once, and
// the canonical sibling directories they open outside its tree.
JetCLIRootPathReach: struct {
    declared: [String]
    sibling_dirs: [String]
}

jet_cli_root_path_reach: fn(entry: String, dependencies: [String: DepSpec]) -[FS]> JetCLIRootPathReach Never! {
    declared := [String]{}
    sibling_dirs := [String]{}
    loop spec in dependencies.values() {
        if spec == .Path(relative) {
            if relative.starts_with("/") -> next
            canonical: cli_files.realpath(jet_cli_report_path(Val(entry), relative)) ?? next
            declared.push(canonical.copy())
            if !jet_cli_dependency_within(canonical, entry) {
                sibling_parent: jet_cli_parent(canonical) ?? "/"
                if !sibling_dirs.contains(sibling_parent) -> sibling_dirs.push(sibling_parent)
            }
        }
    }
    JetCLIRootPathReach{declared: declared, sibling_dirs: sibling_dirs}
}

// Test the canonical target, never a textual symlink alias.
// Check before reading the target tree.
jet_cli_path_dependency_reachable: fn(canonical: String, reach: JetCLIRootPathReach) -> Bool Never! {
    if reach.declared.contains(canonical) -> return true
    loop sibling_parent in reach.sibling_dirs {
        if jet_cli_dependency_within(canonical, sibling_parent) -> return true
    }
    false
}

jet_cli_path_dependency_escape: fn(name: String, relative: String, parent: String, color: Bool) -> JetDriverVerbOutput Never! {
    jet_cli_report_output("", "E1223", "path dependency `{name}` escapes its parent package", "the path `{relative}` resolves outside the declaring package directory `{parent}`", "use a relative path below the declaring package directory", color, JET_DRIVER_EXIT_USER_ERROR)
}

// Authorize each path root once, in dependency-name order, and each version
// dependency's first-party battery (jet_cli_first_party_battery). The entry
// root (roots[0]) declares its dependencies in package.jet or in the inline
// block of `entry_path` or a stock entry. The driver's catalog still owns
// dependency binding and semantic diagnostics; this host only reads trees the
// declared graph permits. No provider or network is run.
jet_cli_path_dependency_roots: fn(roots: &[JetDriverAuthorizedSourceRoot], entry_path: String, color: Bool) -[FS, Env]> JetDriverVerbOutput? Never! {
    entry: roots[0].canonical_path
    root_reach: jet_cli_root_path_reach(entry, jet_cli_root_dependencies(roots[0], entry_path))
    index := 0
    loop index < roots.len() {
        parent: roots[index].canonical_path
        dependencies: jet_cli_root_dependencies(roots[index], if index == 0 -> entry_path else -> "")
        names := dependencies.keys().to_list()
        names.sort()
        loop name in names {
            if dependencies[name] == .Registry(source) {
                // No battery leaves the dependency unbound: the driver emits
                // E0603 at the declaration.
                battery: jet_cli_first_party_battery(name, source, entry) ?? next
                if jet_cli_authorize_dependency_root(roots, battery, color) == .Val(refusal) -> return Val(refusal)
                next
            }
            if dependencies[name] == .Git(_, _) {
                // The source-store entry `jet fetch` pinned in the project's
                // lock; checking it against the lock is `jet build --locked`.
                directory: jet_cli_locked_git_root(entry, name) ?? return Val(jet_cli_report_output("", "E1202", "git dependency `{name}` is not fetched: `.jet/lock` pins no revision for it", jet_cli_diagnostic_copy("E1202").why, "run `jet fetch`, then build again", color, JET_DRIVER_EXIT_USER_ERROR))
                if jet_cli_authorize_dependency_root(roots, directory, color) == .Val(refusal) -> return Val(refusal)
                next
            }
            if dependencies[name] == .Path(relative) {
                path: jet_cli_report_path(Val(parent), relative)
                canonical: cli_files.realpath(path) ?? ""
                declared_by_root: !relative.starts_with("/") && canonical != "" && jet_cli_path_dependency_reachable(canonical, root_reach)
                if index != 0 && !declared_by_root && (relative.starts_with("/") || !jet_cli_dependency_within(path, parent)) {
                    return Val(jet_cli_path_dependency_escape(name, relative, parent, color))
                }
                // A missing target stays unbound: the driver emits E0603 at
                // the declaration rather than a host filesystem diagnostic.
                if canonical == "" -> next
                if index != 0 && !declared_by_root && !jet_cli_dependency_within(canonical, parent) {
                    return Val(jet_cli_path_dependency_escape(name, relative, parent, color))
                }
                if jet_cli_authorize_dependency_root(roots, canonical, color) == .Val(refusal) -> return Val(refusal)
            }
        }
        index += 1
    }
    None
}

// The source-store directory of the git dependency `name` the lock at
// `project_root` pins, or None when it pins no revision or the entry is gone.
jet_cli_locked_git_root: fn(project_root: String, name: String) -[FS, Env]> String? Never! {
    lock: pkg_lock_load(project_root) ?? return None
    package: lock.find_package(name) ?? return None
    pinned: if package.source == {
        .Git(_, _) -> package.locked != None
        .Root | .Path(_) | .Nix(_, _) | .Cran(_, _, _, _, _) | .LuaRocks(_, _, _, _, _) | .Registry(_, _, _, _, _, _, _, _) | .Foreign(_, _, _) -> false
    }
    if !pinned -> return None
    Val(cli_files.realpath(pkg_source_store_path(name, package.version, package.fingerprint)) ?? return None)
}

// The toolchain directory of the first-party batteries.
JET_CLI_BATTERIES_DIR: "Jetpack/Provider/Batteries"

// The canonical first-party batteries directory of the toolchain
// (jet_cli_toolchain_root of `entry`), or None without a toolchain root.
jet_cli_batteries_dir: fn(entry: String) -[FS, Env]> String? Never! {
    toolchain: if jet_cli_toolchain_root(entry) == {
        .Found(root) -> root
        .Missing(_, _) -> { return None }
    }
    Val(cli_files.realpath(jet_cli_authority_path(toolchain, JET_CLI_BATTERIES_DIR)) ?? return None)
}

// The canonical root of the first-party battery a version dependency `name`
// (`source`, its selector) names, or None. Like the Rust jetpack's embedded
// batteries registry (generated from crates/jetpack/batteries/*), the toolchain
// ships the batteries: `<toolchain root>/Jetpack/Provider/Batteries/<name>`
// (jet_cli_batteries_dir of `entry`, the entry root) resolves only when its
// package.jet declares that name and a version the selector matches. A loose
// script's inline `use name#version` reaches the same batteries
// (pkg_inline_deps_resolve).
jet_cli_first_party_battery: fn(name: String, source: String, entry: String) -[FS, Env]> String? Never! {
    selector: jet_driver_dependency_selector(source, name) ?? return None
    directory: jet_cli_authority_path(jet_cli_batteries_dir(entry) ?? return None, name)
    manifest_path: jet_cli_authority_path(directory, "package.jet")
    text: cli_files.read(manifest_path) ?? return None
    manifest: pkg_manifest_parse(manifest_path, text) ?? return None
    if manifest.package.name != name || !(jet_driver_version_selector_matches(selector, manifest.package.version) ?? false) -> return None
    Val(cli_files.realpath(directory) ?? return None)
}

// Authorizes the directory `canonical` as one more source root unless a root
// already holds it; the refusal when its tree can't be read securely.
jet_cli_authorize_dependency_root: fn(roots: &[JetDriverAuthorizedSourceRoot], canonical: String, color: Bool) -[FS]> JetDriverVerbOutput? Never! {
    loop existing in roots {
        if existing.canonical_path == canonical -> return None
    }
    stat: cli_files.stat(canonical) ?? return None
    if !stat.is_dir -> return None
    files := [JetDriverAuthorizedSourceFile]{}
    directories := [AppAuthorizedDirectory]{}
    caches := [JetDriverAuthorizedSourceFile]{}
    budget := JetCLISourceBudget{entries: 0, bytes: 0, files: 0}
    if jet_cli_walk_sources(canonical, "", 0, files, directories, true, budget) == .Val(problem) {
        return Val(jet_cli_report_output("", "E2105", "can't securely read the sources under `{canonical}`: {problem}", jet_cli_why("E2105"), "remove the symbolic link or unreadable file, or check a file outside this tree", color, JET_DRIVER_EXIT_USER_ERROR))
    }
    if jet_cli_foreign_cache_files(canonical, caches, budget) == .Val(problem) {
        return Val(jet_cli_report_output("", "E2105", "can't securely read the foreign bindings under `{canonical}`: {problem}", jet_cli_why("E2105"), "remove the symbolic link or unreadable file, or regenerate the bindings with `jet bind`", color, JET_DRIVER_EXIT_USER_ERROR))
    }
    roots.push(JetDriverAuthorizedSourceRoot{canonical_path: canonical, identity: jet_cli_identity_key("directory", stat), allow_hardlinks: false, files: files, foreign_cache_files: caches, directories: directories})
    None
}

// The nearest directory at or above `entry_path` that holds `package.jet`, or
// the entry's own directory for a loose file. A toolchain's Core library is no
// source root: its `package.jet` is the library's own manifest (its layer
// table), and each Core file is a loose file.
jet_cli_source_root: fn(entry_path: String) -[FS]> String Never! {
    start: jet_cli_parent(entry_path) ?? "/"
    current := start
    loop {
        if cli_files.is_file(jet_cli_authority_path(current, "package.jet")) && !jet_cli_is_toolchain_core(current) -> return current
        if current == "/" -> return start
        current = jet_cli_parent(current) ?? return start
    }
}

// Whether `directory` is the Core library of the toolchain around it.
jet_cli_is_toolchain_core: fn(directory: String) -[FS]> Bool Never! {
    parent: jet_cli_parent(directory) ?? return false
    jet_cli_authority_path(parent, "Core") == directory && jet_cli_is_toolchain(parent)
}

jet_cli_host_triple: fn(arch: String, os: String) -> String Never! {
    known_arch: arch == "x86_64" || arch == "aarch64"
    if os == "linux" && known_arch -> return "{arch}-unknown-linux-gnu"
    if os == "windows" && known_arch -> return "{arch}-pc-windows-msvc"
    if os == "macos" && known_arch -> return "{arch}-apple-darwin"
    if os == "wasi" -> return "{arch}-wasi"
    "{arch}-unknown-{os}"
}

// The memory free for new work, in bytes: Linux `/proc/meminfo`
// `MemAvailable` (kB), lowered to the tightest cgroup v2 headroom
// (`memory.max - memory.current`) of this process's cgroup and its
// ancestors, so a capped run never admits threads its cap cannot hold;
// `None` where the host cannot tell.
jet_cli_memory_available: fn() -[FS]> Int? Never! {
    available := jet_cli_meminfo_available() ?? return None
    membership: cli_files.read("/proc/self/cgroup") ?? return Val(available)
    path := ""
    loop line in membership.lines() {
        if line.starts_with("0::") -> path = line.slice(3..<line.len())
    }
    loop {
        directory: "/sys/fs/cgroup{path}"
        // A level whose memory.max is `max` bounds nothing; its usage isn't read.
        if jet_cli_cgroup_bytes("{directory}/memory.max") == .Val(max) {
            if jet_cli_cgroup_bytes("{directory}/memory.current") == .Val(current) {
                headroom: if max > current -> max - current else -> 0
                if headroom < available -> available = headroom
            }
        }
        if path == "" || path == "/" -> break
        cut: path.rfind("/")
        path = if cut > 0 -> path.slice(0, cut) else -> ""
    }
    Val(available)
}

jet_cli_meminfo_available: fn() -[FS]> Int? Never! {
    text: cli_files.read("/proc/meminfo") ?? return None
    loop line in text.lines() {
        if !line.starts_with("MemAvailable:") -> next
        loop word in line.slice(13..<line.len()).split(" ") {
            if word == "" -> next
            kilobytes: Int.parse(word) ?? return None
            return Val(kilobytes * 1024)
        }
    }
    None
}

// One cgroup v2 byte count (`memory.max`, `memory.current`); `None` when the
// file is missing or holds `max` (no limit).
jet_cli_cgroup_bytes: fn(file: String) -[FS]> Int? Never! {
    text: cli_files.read(file) ?? return None
    bytes: Int.parse(text.trim()) ?? return None
    Val(bytes)
}

// The compiler's thread default: one thread per physical core this process
// may run on. Linux lists the CPUs the process may use in `/proc/self/status`
// (`Cpus_allowed_list`) and the SMT siblings of each CPU in
// `/sys/devices/system/cpu/cpuN/topology/thread_siblings_list`; an allowed
// CPU and its siblings are one core, so only the first allowed CPU of each
// core is read. The default is the measured-best count: today a compile past
// one thread per core spends more CPU time for no wall time (#5472). When
// the per-stage SMT acceptance shows all hardware threads (32 on a 16-core
// SMT host) beating one per core, the default becomes all hardware threads.
// `logical`, the count of CPUs the process may use, is the answer when the
// host can't tell, and the default never exceeds it.
jet_cli_physical_cores: fn(logical: Int) -[FS]> Int Never! {
    status: cli_files.read("/proc/self/status") ?? return logical
    allowed := [Int]{}
    loop line in status.lines() {
        if line.starts_with("Cpus_allowed_list:") -> allowed = jet_cli_cpu_list(line.slice(18..<line.len()).trim()) ?? return logical
    }
    covered := [Int]{}
    cores := 0
    loop cpu in allowed {
        if covered.contains(cpu) -> next
        siblings: cli_files.read("/sys/devices/system/cpu/cpu{cpu}/topology/thread_siblings_list") ?? return logical
        covered.extend(jet_cli_cpu_list(siblings.trim()) ?? return logical)
        cores += 1
    }
    if cores < 1 || cores > logical -> return logical
    cores
}

// The CPUs of a Linux CPU list (`0-3,8-11`, `0,2`); `None` when it is not one.
jet_cli_cpu_list: fn(text: String) -> [Int]? Never! {
    cpus := [Int]{}
    loop part in text.split(",") {
        if part == "" -> next
        bounds: part.split("-").to_list()
        first: Int.parse(bounds[0]) ?? return None
        last: if bounds.len() == 2 -> Int.parse(bounds[1]) ?? return None else -> first
        loop cpu in first..<(last + 1) {
            cpus.push(cpu)
        }
    }
    Val(cpus)
}

// The compiler's thread default once other work is counted: one thread per
// physical core (jet_cli_physical_cores), but never more than the CPUs other
// processes leave free at start. `/proc/stat`'s `procs_running` line counts
// the runnable threads at this instant, this thread among them; the others
// spread over the host's online CPUs, so their share of the `logical` CPUs
// this process may use counts as busy. A quiet host gets every physical
// core; on an SMT host the default shrinks only once fewer CPUs than
// physical cores are free, since a busy core's sibling still runs a compiler
// thread. An unreadable file leaves the physical-core count.
jet_cli_default_threads: fn(logical: Int) -[FS]> Int Never! {
    physical: jet_cli_physical_cores(logical)
    stat: cli_files.read("/proc/stat") ?? return physical
    online_list: cli_files.read("/sys/devices/system/cpu/online") ?? return physical
    online: jet_cli_cpu_list(online_list.trim()) ?? return physical
    jet_cli_threads_left(physical, logical, online.len(), stat)
}

// At most `physical` threads, and at most the `logical` CPUs this process may
// use less the busy share of them that `stat` (the text of `/proc/stat`)
// shows across `online` CPUs; at least one. `physical` when `stat` has no
// `procs_running` count.
jet_cli_threads_left: fn(physical: Int, logical: Int, online: Int, stat: String) -> Int Never! {
    running := -1
    loop line in stat.lines() {
        if line.starts_with("procs_running ") -> running = Int.parse(line.slice(14..<line.len()).trim()) ?? -1
    }
    if running < 0 -> return physical
    others: if running > 1 -> running - 1 else -> 0
    spread: if online < logical -> logical else -> online
    free: logical - others * logical /% spread
    if free < 1 -> return 1
    if free < physical -> return free
    physical
}

// The Core library rows of the toolchain tree (jet_cli_toolchain_root of
// `input`, the entry), else the Core sources built into jet
// (jet_cli_core_source_text), or the refusal that stops the
// request. A tree's private parts are its own CoreSourceParts.tsv rows
// (jet_cli_tree_core_rows). Each body is read when the compile first schedules its row
// (jet_driver_core_text_file), so a compile reads only the Core files its
// imports reach; every tree file is checked to be present here, so a missing
// one still refuses the request up front. Every compile also needs this
// compiler's identity, so its absence refuses here too.
JetCLICoreSources: enum {
    Loaded(sources: [JetDriverCoreSource])
    Missing(what: String, fix: String)
}

jet_cli_core_sources: fn(input: String) -> JetCLICoreSources Never! {
    if jet_cli_compiler_identity() == None {
        missing: jet_cli_identity_missing()
        return JetCLICoreSources.Missing{what: missing.what, fix: missing.fix}
    }
    core_sources := [JetDriverCoreSource]{}
    if jet_cli_toolchain_root(input) == .Found(toolchain) {
        rows: jet_cli_toolchain_core_rows(toolchain) ?? return JetCLICoreSources.Missing{what: err.message, fix: "set `{JET_CLI_TOOLCHAIN_ROOT_ENV}` to the Jet toolchain source tree, and keep its `{CORE_DECLARATIONS_PARTS_PATH}` rows whole"}
        loop row in rows {
            core_path: jet_cli_authority_path(toolchain, row.path)
            if !cli_files.is_file(core_path) -> return JetCLICoreSources.Missing{what: "can't read the Core library source `{core_path}`", fix: "set `{JET_CLI_TOOLCHAIN_ROOT_ENV}` to the Jet toolchain source tree, the directory that holds `Core/`"}
            core_sources.push(JetDriverCoreSource{module_name: row.module_name, alias: row.alias, path: row.path, owner: row.owner, owned_members: row.owned_members, runtime: row.runtime, text: jet_driver_core_text_file(core_path, JetCLICoreSourceReader{})})
        }
    } else {
        // Each row's file is its repository path, so a Core file's comptime
        // inputs (`Core/<dir>/<asset>`) resolve among the built-in assets.
        loop row in CORE_SOURCE_OWNED_ROWS {
            core_sources.push(JetDriverCoreSource{module_name: row.module_name, alias: row.alias, path: row.path, owner: row.owner, owned_members: row.owned_members, runtime: row.runtime, text: jet_driver_core_text_file(row.path, JetCLIBuiltinCoreSourceReader{})})
        }
    }
    // The jet.runtime interface modules ride with Core: they are embedded in
    // jet whether or not a toolchain tree is present (RuntimeInterface.jet).
    core_sources.extend(jet_driver_runtime_interface_sources())
    JetCLICoreSources.Loaded{sources: core_sources}
}

// The Core rows a compile of the toolchain tree `toolchain` reads
// (jet_cli_tree_core_rows of its CoreSourceParts.tsv).
jet_cli_toolchain_core_rows: fn(toolchain: String) -> [CoreSourceOwnedRow] CoreDeclarationError! {
    parts_path: jet_cli_authority_path(toolchain, CORE_DECLARATIONS_PARTS_PATH)
    text: cli_files.read(parts_path) ?? return Err(core_decl_fail("can't read the Core source parts `{parts_path}`"))
    parts: core_decl_parts(text) ?? return Err(err)
    Ok(jet_cli_tree_core_rows(parts))
}

// The Core rows of a toolchain tree whose CoreSourceParts.tsv declares
// `parts`: this jet's Core.rows source modules and runtime units, with the
// tree's private parts in place of the parts jet was built with. A tree that
// adds or changes a part then checks on a jet built before that part.
jet_cli_tree_core_rows: fn(parts: [CoreDeclarationSource]) -> [CoreSourceOwnedRow] Never! {
    rows := [CoreSourceOwnedRow]{}
    placed := false
    loop row in CORE_SOURCE_OWNED_ROWS {
        if row.owner == "" || row.runtime {
            rows.push(row.copy())
            next
        }
        if placed -> next
        placed = true
        loop part in parts -> rows.push(CoreSourceOwnedRow{module_name: part.module_name.copy(), alias: part.alias.copy(), path: part.path.copy(), owner: part.owner.copy(), owned_members: part.members.copy(), type_exports: [String]{}, impl_types: part.impl_types.copy(), runtime: false})
    }
    rows
}

// The CLI's read of one Core file for jet_driver_core_text_file, and of the
// assets a Core file embeds.
JetCLICoreSourceReader: struct {
    impl JetDriverCoreSourceReader {
        read: fn(self, file: String) -[FS.Read]> String? {
            text: cli_files.read(file) ?? return None
            Val(text)
        }
        read_bytes: fn(self, file: String) -[FS.Read]> [U8] JetDriverBuildInputError! {
            bytes: cli_files.read_bytes(file) ?? return Err(JetDriverBuildInputError{message: jet_cli_io_error_text(err)})
            Ok(bytes)
        }
    }
}

// The read of one Core row from the sources built into jet, by its
// repository path (`Core/App/App.jet`), and of an asset a Core file embeds
// (`Core/Ui/XkbTables/keysym_values.bin`) from the assets built into it.
JetCLIBuiltinCoreSourceReader: struct {
    impl JetDriverCoreSourceReader {
        read: fn(self, file: String) -[FS.Read]> String? {
            jet_cli_core_source_text(file)
        }
        read_bytes: fn(self, file: String) -[FS.Read]> [U8] JetDriverBuildInputError! {
            if jet_cli_core_asset_bytes(file) == .Val(bytes) -> return Ok(bytes)
            text: jet_cli_core_source_text(file) ?? return Err(JetDriverBuildInputError{message: "`{file}` is not a Core source or asset built into this jet"})
            Ok(text.bytes())
        }
    }
}

// The toolchain tree of `input`'s compile (jet_cli_toolchain_root, the tree
// its Core rows come from) for `toolchain:` comptime inputs, by its physical
// path; None without one, so those reads refuse: a built-in Core has no tree.
jet_cli_toolchain_tree: fn(input: String) -[FS, Env]> Shared<JetDriverToolchainTree>? Never! {
    if jet_cli_toolchain_root(input) == .Found(toolchain) {
        root: cli_files.realpath(toolchain) ?? return None
        return Val(Shared{JetDriverToolchainTree{root: root, reader: JetCLIToolchainPackages{}, packages: None}})
    }
    None
}

// The toolchain's own packages, the ones that read its tree with
// `toolchain:` inputs: the compiler workspace
// (`<root>/Compiler`), each member its package.jet declares, and every
// package their path dependencies reach inside the tree, each by its physical
// directory. A package outside the tree, and one inside it that nothing in the
// compiler workspace depends on (a vendored copy nested in the checkout), is
// not one of them.
JetCLIToolchainPackages: struct {
    impl JetDriverToolchainPackageReader {
        packages: fn(self, root: String) -[FS.Read]> [String] {
            found := [String]{}
            workspace: cli_files.canonicalize(jet_cli_entry_join(root, "Compiler")) ?? return found
            found.push(workspace.copy())
            workspace_manifest: jet_cli_entry_join(workspace, JET_CLI_PACKAGE_FILE)
            loop member in jet_cli_manifest_facts(cli_files.read(workspace_manifest) ?? "", workspace_manifest).members {
                directory: cli_files.canonicalize(jet_cli_entry_join(workspace, member.path)) ?? next
                if directory.starts_with("{root}/") && !found.contains(directory) -> found.push(directory)
            }
            index := 0
            loop index < found.len() {
                directory: found[index].copy()
                index += 1
                manifest_path: jet_cli_entry_join(directory, JET_CLI_PACKAGE_FILE)
                raw: cli_files.read(manifest_path) ?? next
                manifest: pkg_manifest_parse(manifest_path, raw) ?? next
                loop name in manifest.dependencies.keys() {
                    if manifest.dependencies[name] == .Path(path) {
                        target: cli_files.canonicalize(jet_cli_entry_join(directory, path)) ?? next
                        if target.starts_with("{root}/") && !found.contains(target) -> found.push(target)
                    }
                }
            }
            found
        }
        package_of: fn(self, root: String, file: String) -[FS.Read]> String? {
            directory := cli_files.dirname(file)
            loop directory.starts_with("{root}/") {
                if cli_files.canonicalize(jet_cli_entry_join(directory, JET_CLI_PACKAGE_FILE)) == .Ok(_) -> return Val(directory)
                directory = cli_files.dirname(directory)
            }
            None
        }
    }
}

// The driver request for `snapshot` on this host: the Core rows, the
// canonical effect source, the host facts, the lock's build stamp and build
// contributions, and at most `threads` compiler threads (`None` admits
// threads automatically, up to one per physical core).
jet_cli_driver_request: fn(snapshot: JetDriverAuthorizedSourceSnapshot, core_sources: [JetDriverCoreSource], threads: Int?, mode: JetDriverCompileMode) -> JetDriverCompileRequest Never! {
    os: cli_sys.name()
    cores: cli_sys.cpu_count()
    stamp := BuildStamp?{None}
    contributions := [LockedBuildContribution]{}
    lock: jet_cli_entry_lock(snapshot)
    if lock == .Val(found) {
        // copy: `found` is a payload view of `lock`.
        stamp = found.build_stamp.copy()
        contributions = found.build_contributions.copy()
    }
    // `jet -e`'s entry file shows the value of its last statement.
    eval_entry: jet_cli_kept_entry(snapshot.entry_path, "eval")
    JetDriverCompileRequest{
        authorized_sources: snapshot,
        canonical_effect_source: JET_CLI_EFFECT_SOURCE,
        core_sources: core_sources,
        host_facts: JetDriverHostFacts{target_triple: Val(jet_cli_host_triple(cli_sys.arch(), os)), active_os: Val(os), compiler_identity: jet_cli_compiler_identity()},
        eval_config: jet_cli_eval_config(),
        record_store: None,
        trace_sink: None,
        compiler_threads: CompilerThreads{cap: Val(threads ?? jet_cli_default_threads(cores)), cores: cores, memory_available: jet_cli_memory_available()},
        mode: mode,
        eval_entry: eval_entry,
        tests_optional: mode == JetDriverCompileMode.Test && (cli_sys.get(JET_CLI_TEST_SUITE_ENV) != None || cli_sys.get(JET_CLI_TEST_PROFILE_ENV) != None),
        build_inputs: Val(jet_driver_shared_build_inputs(JetCLIBuildInputs{})),
        build_http_inputs: Val(jet_driver_shared_build_http_inputs(JetCLIBuildHTTPInputs{})),
        build_stamp: stamp,
        build_contributions: contributions,
        toolchain_tree: jet_cli_toolchain_tree(snapshot.entry_path),
        recheck_verify: cli_sys.get(ENV_JET_RECHECK_VERIFY) == Val("1"),
    }
}

// The entry root's `.jet/lock`, whose `[build.stamp]` and
// `[[build.contribution]]` rows a compile folds. A missing or unparsable lock
// is None: the compile keeps the driver's default stamp, never captures a fresh
// one from git and the clock, and folds no contribution.
jet_cli_entry_lock: fn(snapshot: JetDriverAuthorizedSourceSnapshot) -[FS]> LockFile? {
    loop root in snapshot.roots {
        if root.identity != snapshot.entry_root_identity -> next
        return pkg_lock_load(root.canonical_path)
    }
    None
}

// The evaluator configuration of a CLI compile: compile-time code runs
// natively over the toolchain's runtime image (jet_cli_native_session).
jet_cli_eval_config: fn() -> JetEvalConfig Never! {
    config := jet_eval_default_config()
    config.native = jet_cli_native_session()
    config
}

// The compile's native children over the runtime image beside the pack,
// read only when compile-time code first runs; None when this toolchain
// has none.
jet_cli_native_session: fn() -> Shared<JetEvalNativeSession>? Never! {
    jet_cli_native_session_at(jet_cli_runtime_dir())
}

// The native session over the runtime pack directory `runtime_dir`; None when
// it records no runtime key.
jet_cli_native_session_at: fn(runtime_dir: String) -> Shared<JetEvalNativeSession>? Never! {
    if jet_cli_runtime_key(runtime_dir) == None -> return None
    Val(jet_eval_native_session("{runtime_dir}/{JET_CLI_RUNTIME_IMAGE_FILE}", JetCLINativeImageReader{}))
}

// The CLI's read of the runtime image for jet_eval_native_session.
JetCLINativeImageReader: struct {
    impl JetEvalNativeImageReader {
        read: fn(self, file: String) -[FS.Read]> [U8]? {
            bytes: cli_files.read_bytes(file) ?? return None
            Val(bytes)
        }
    }
}

// The CLI's raw build-input transport for checked `build: fn` input services:
// filesystem facts only. The driver's build adapter owns the path law, glob
// matching, pins, decoding and every diagnostic; an error is the failed
// operation's own text.
JetCLIBuildInputs: struct {
    impl JetDriverBuildInputs {
        resolve: fn(self, path: String) -[FS.Read]> JetDriverBuildPath JetDriverBuildInputError! {
            resolved: jet_cli_build_resolve(path) ?? return Err(JetDriverBuildInputError{message: err.message})
            Ok(resolved)
        }
        entries: fn(self, directory: String) -[FS.Read]> [JetDriverBuildEntry] JetDriverBuildInputError! {
            listed: cli_files.list_dir(directory) ?? return Err(JetDriverBuildInputError{message: jet_cli_io_error_text(err)})
            out := [JetDriverBuildEntry]{}
            loop entry in listed {
                info: cli_files.stat(jet_cli_entry_join(directory, entry.name)) ?? return Err(JetDriverBuildInputError{message: jet_cli_io_error_text(err)})
                out.push(JetDriverBuildEntry{name: entry.name, directory: info.is_dir && !info.is_symlink, file: info.is_file && !info.is_symlink})
            }
            Ok(out)
        }
        read: fn(self, path: String, limit: Int) -[FS.Read]> [U8] JetDriverBuildInputError! {
            if limit < 0 || limit > 536870912 -> return Err(JetDriverBuildInputError{message: "file read bound exceeds the tree hashing bound"})
            expected: cli_files.stat(path) ?? return Err(JetDriverBuildInputError{message: jet_cli_io_error_text(err)})
            if expected.is_symlink || !expected.is_file -> return Err(JetDriverBuildInputError{message: "file is not a regular file"})
            reader := cli_files.open(path, .Refuse) ?? return Err(JetDriverBuildInputError{message: jet_cli_io_error_text(err)})
            opened: reader.stat() ?? return Err(JetDriverBuildInputError{message: jet_cli_io_error_text(err)})
            if !opened.is_file || expected.id != opened.id || expected.size != opened.size || expected.modified != opened.modified || expected.changed != opened.changed -> return Err(JetDriverBuildInputError{message: "file changed before reading"})
            if expected.size > limit -> return Err(JetDriverBuildInputError{message: "file exceeds its read bound"})
            bytes := [U8]{}
            bytes.try_reserve(if expected.size < 65536 -> expected.size else -> 65536) ?? return Err(JetDriverBuildInputError{message: "cannot reserve file read buffer: {err}"})
            loop {
                remaining: limit + 1 - bytes.len()
                chunk: reader.read(if remaining < 65536 -> remaining else -> 65536) ?? return Err(JetDriverBuildInputError{message: jet_cli_io_error_text(err)})
                if chunk.len() == 0 -> break
                bytes.extend(chunk)
                if bytes.len() > limit -> return Err(JetDriverBuildInputError{message: "file exceeds its read bound"})
            }
            after: reader.stat() ?? return Err(JetDriverBuildInputError{message: jet_cli_io_error_text(err)})
            path_after: cli_files.stat(path) ?? return Err(JetDriverBuildInputError{message: jet_cli_io_error_text(err)})
            if !after.is_file || !path_after.is_file || expected.id != after.id || expected.id != path_after.id || expected.size != after.size || expected.size != path_after.size || expected.modified != after.modified || expected.modified != path_after.modified || expected.changed != after.changed || expected.changed != path_after.changed || bytes.len() != expected.size {
                return Err(JetDriverBuildInputError{message: "file changed while reading"})
            }
            Ok(bytes)
        }
        read_rooted: fn(self, root: String, relative: String, limit: Int) -[FS.Read]> [U8] JetDriverBuildInputError! {
            bytes: jet_cli_build_read_rooted(root, relative, limit) ?? return Err(JetDriverBuildInputError{message: err.message})
            Ok(bytes)
        }
    }
}

// CheckReads::read_nofollow_at_root's raw transport. Keep every directory
// pinned and recheck its parent entry; no canonicalize-then-read window can
// follow a replaced intermediate component outside the authorized build root.
jet_cli_build_read_rooted: fn(root: String, relative: String, limit: Int) -[FS.Read]> [U8] JetCLIReadError! {
    read: jet_cli_read_rooted_source(root, relative, limit)
    Ok(read.bytes.move())
}

JetCLIHeldSource: struct {
    bytes: [U8]
    stat: cli_files.Stat
}

jet_cli_read_rooted_source: fn(root: String, relative: String, limit: Int) -[FS.Read]> JetCLIHeldSource JetCLIReadError! {
    if limit < 0 || limit > JET_CLI_MAX_SOURCE_BYTES -> return Err(jet_cli_read_error("file read bound exceeds the tree hashing bound"))
    if relative.starts_with("/") -> return Err(jet_cli_read_error("file authority path must be relative and normalized"))
    parts := [String]{}
    loop part in relative.split("/") {
        if part == "" || part == "." -> next
        if part == ".." -> return Err(jet_cli_read_error("file authority path must be relative and normalized"))
        loop byte in part.bytes() {
            if byte == (U8{0}) -> return Err(jet_cli_read_error("file authority path contains NUL"))
        }
        parts.push(part)
    }
    directories := [cli_files.Directory]{}
    names := [String]{}
    initial: jet_cli_hold_root_chain(root, directories, names)
    if parts.len() == 0 -> return Err(jet_cli_read_error("file authority path is empty"))
    loop index in 0..<(parts.len() - 1) {
        opened: directories[directories.len() - 1].open_directory(parts[index]) ?? return Err(jet_cli_build_rooted_open_error(err))
        directories.push(opened)
        names.push(parts[index])
    }
    name: parts[parts.len() - 1]
    if jet_cli_build_read_chain_current(directories, names, initial) == .Err(error) -> return Err(error)
    read: jet_cli_read_held_source(directories[directories.len() - 1], name, limit)
    if jet_cli_build_read_chain_current(directories, names, initial) == .Err(_) -> return Err(jet_cli_read_error("file changed while it was being read"))
    Ok(read)
}

jet_cli_hold_root_chain: fn(root: String, directories: &[cli_files.Directory], names: &[String]) -[FS.Read]> String JetCLIReadError! {
    initial: if root.starts_with("/") -> "/" else -> "."
    directories.push(cli_files.open_directory(initial) ?? return Err(jet_cli_read_error(jet_cli_io_error_text(err))))
    loop part in root.split("/") {
        if part == "" || part == "." -> next
        if part == ".." -> return Err(jet_cli_read_error("file authority root must not contain parent components"))
        loop byte in part.bytes() {
            if byte == (U8{0}) -> return Err(jet_cli_read_error("file authority path contains NUL"))
        }
        opened: directories[directories.len() - 1].open_directory(part) ?? return Err(jet_cli_build_rooted_open_error(err))
        directories.push(opened)
        names.push(part)
    }
    Ok(initial)
}

// Both source snapshots and build input reads consume this same opened file.
// The stat in the snapshot therefore describes exactly the bytes read.
jet_cli_read_held_source: fn(directory: cli_files.Directory, name: String, limit: Int) -[FS.Read]> JetCLIHeldSource JetCLIReadError! {
    if limit < 0 || limit > JET_CLI_MAX_SOURCE_BYTES -> return Err(jet_cli_read_error("file read bound exceeds the tree hashing bound"))
    reader := directory.open(name) ?? return Err(jet_cli_build_rooted_open_error(err))
    expected: reader.stat() ?? return Err(jet_cli_read_error(jet_cli_io_error_text(err)))
    if !expected.is_file -> return Err(jet_cli_read_error("file authority input is not a regular file"))
    if expected.links != 1 -> return Err(jet_cli_read_error("file authority input has multiple hard links"))
    current: directory.entry_stat(name) ?? return Err(jet_cli_read_error(jet_cli_io_error_text(err)))
    if !current.is_file -> return Err(jet_cli_read_error("file authority input is not a regular file"))
    if current.links != 1 -> return Err(jet_cli_read_error("file authority input has multiple hard links"))
    if !jet_cli_build_read_same_file(expected, current) -> return Err(jet_cli_read_error("file authority input moved while it was held"))
    if expected.size > limit -> return Err(jet_cli_read_error("file exceeds its read bound"))
    bytes := [U8]{}
    bytes.try_reserve(if expected.size < 65536 -> expected.size else -> 65536) ?? return Err(jet_cli_read_error("cannot reserve file read buffer: {err}"))
    loop {
        remaining: limit + 1 - bytes.len()
        chunk: reader.read(if remaining < 65536 -> remaining else -> 65536) ?? return Err(jet_cli_read_error(jet_cli_io_error_text(err)))
        if chunk.len() == 0 -> break
        bytes.extend(chunk)
        if bytes.len() > limit -> return Err(jet_cli_read_error("file exceeds its read bound"))
    }
    after: reader.stat() ?? return Err(jet_cli_read_error(jet_cli_io_error_text(err)))
    path_after: directory.entry_stat(name) ?? return Err(jet_cli_read_error("file changed while it was being read"))
    if !jet_cli_build_read_same_file(expected, after) || !jet_cli_build_read_same_file(expected, path_after) || after.size != bytes.len() {
        return Err(jet_cli_read_error("file changed while it was being read"))
    }
    Ok(JetCLIHeldSource{bytes: bytes, stat: expected})
}

jet_cli_build_read_same_file: fn(left: cli_files.Stat, right: cli_files.Stat) -> Bool Never! {
    right.is_file && right.links == 1 && left.id == right.id && left.size == right.size && left.modified == right.modified && left.changed == right.changed
}

jet_cli_build_read_chain_current: fn(directories: &[cli_files.Directory], names: &[String], initial: String) -[FS.Read]> Bool JetCLIReadError! {
    base: cli_files.stat(initial) ?? return Err(jet_cli_read_error(jet_cli_io_error_text(err)))
    held_base: directories[0].stat() ?? return Err(jet_cli_read_error(jet_cli_io_error_text(err)))
    if !base.is_dir || base.is_symlink || base.id != held_base.id -> return Err(jet_cli_read_error("file authority directory moved while it was held"))
    loop index in 0..<names.len() {
        named: directories[index].entry_stat(names[index]) ?? return Err(jet_cli_read_error(jet_cli_io_error_text(err)))
        held: directories[index + 1].stat() ?? return Err(jet_cli_read_error(jet_cli_io_error_text(err)))
        if !named.is_dir || named.is_symlink || named.id != held.id -> return Err(jet_cli_read_error("file authority directory moved while it was held"))
    }
    Ok(true)
}

jet_cli_build_rooted_open_error: fn(error: IOError) -> JetCLIReadError Never! {
    message: jet_cli_io_error_text(error)
    jet_cli_read_error(if message.ends_with("(os error 40)") || message.ends_with("(os error 62)") -> "file authority path contains a symlink" else -> message)
}

// Where absolute `path` resolves with every link followed (fs::canonicalize
// over lstat/readlink): a missing component is `exists: false`; a link chain
// longer than the system's 40 is ELOOP.
jet_cli_build_resolve: fn(path: String) -[FS.Read]> JetDriverBuildPath JetCLIReadError! {
    pending := path.split("/").to_list()
    index := 0
    resolved := ""
    followed := 0
    loop index < pending.len() {
        part: pending[index]
        index += 1
        if part == "" || part == "." -> next
        if part == ".." {
            parts := resolved.split("/").to_list()
            _ := parts.pop()
            resolved = parts.join("/")
            next
        }
        candidate: "{resolved}/{part}"
        info: cli_files.stat(candidate) ?? {
            if err == .NotFound(_) -> return Ok(JetDriverBuildPath{exists: false, path: candidate, file: false, links: 0})
            return Err(jet_cli_read_error(jet_cli_io_error_text(err)))
        }
        if !info.is_symlink {
            resolved = candidate
            next
        }
        followed += 1
        if followed > 40 -> return Err(jet_cli_read_error("Too many levels of symbolic links (os error 40)"))
        target: cli_files.read_link(candidate) ?? return Err(jet_cli_read_error(jet_cli_io_error_text(err)))
        spliced: if target.starts_with("/") -> target else -> "{resolved}/{target}"
        rest := spliced.split("/").to_list()
        loop remaining in index..<pending.len() -> rest.push(pending[remaining])
        pending = rest
        index = 0
        resolved = ""
    }
    final: if resolved == "" -> "/" else -> resolved
    info: cli_files.stat(final) ?? return Err(jet_cli_read_error(jet_cli_io_error_text(err)))
    Ok(JetDriverBuildPath{exists: true, path: final, file: info.is_file, links: info.links})
}

// Build the request for `file` (the entry as the user named it) and run the
// Jet compiler on it in `mode` with at most `threads` compiler threads
// (`--threads N`; `None` admits threads automatically).
// Untraced: only the compiling verbs trace (`jet_cli_compile_entry`).
// `jet_driver_compile` declares no effect row or failure (its Eval host
// adapter makes dynamic calls with no effect bound), so this function and the
// host verbs above it stay unannotated.
jet_cli_compile_file: fn(file: String, color: Bool, threads: Int?, mode: JetDriverCompileMode) -> JetCLICompiled {
    jet_cli_compile_entry(file, color, threads, mode, None, None)
}

// One file's bytes as a compile sees them in place of the disk copy, or as a
// new source file beside it; nothing is written.
JetCLIOverlay: struct {
    path: String
    source: String
}

// `jet_cli_compile_file` with the entry file's bytes replaced by
// `entry_source` when given (`jet fmt --explicit-copies` asks sema about a
// policy-marked copy of the entry; nothing is written), traced through
// `trace_sink`: the process's one sink, which `jet_cli_main` opens for
// `build`, `run`, `check`, `test`, `doc` and `emit` (the `--trace` control).
// `settings` are the command line's `--set` writers and `profile` the
// `--profile` it selects ("" keeps the request's default; `jet check`);
// `target_machine` is the machine without an OS it checks for ("" for the
// host; `jet check --target`); `hold_check_state` as in
// jet_cli_compile_prepared.
jet_cli_compile_entry: fn(file: String, color: Bool, threads: Int?, mode: JetDriverCompileMode, entry_source: String?, trace_sink: JetCLITraceSink?, settings: [BuildSettingOverride]{[BuildSettingOverride]{}}, profile: String{""}, target_machine: String{""}, hold_check_state: Bool{false}) -> JetCLICompiled {
    overlays := [JetCLIOverlay]{}
    if entry_source == .Val(replacement) -> overlays.push(JetCLIOverlay{path: file, source: replacement})
    jet_cli_compile_overlays(file, file, overlays, color, threads, mode, trace_sink, settings, profile, target_machine, hold_check_state: hold_check_state)
}

// An overlay or entry path as the snapshot spells it: the canonical path of a
// file that exists, else the lexically absolute path (Report.jet
// `jet_cli_report_path`).
jet_cli_overlay_path: fn(path: String) -[FS, Env]> String Never! {
    canonical: cli_files.realpath(path) ?? return jet_cli_report_path(jet_cli_report_cwd(), path)
    canonical
}

// Whether root-relative `left` comes before `right` in the walk's order:
// component by component, by bytes (`/` sorts before every name byte).
jet_cli_relative_precedes: fn(left: String, right: String) -> Bool Never! {
    a: left.bytes()
    b: right.bytes()
    loop index in 0..<a.len() {
        if index >= b.len() -> return false
        if a[index] != b[index] {
            if a[index] == 47 -> return true
            if b[index] == 47 -> return false
            return a[index] < b[index]
        }
    }
    a.len() < b.len()
}

// Whether root-relative `relative` lies where the source walk does not reach:
// a dot or skipped name, or under a symbolic link or nested project.
jet_cli_outside_walk: fn(root: String, relative: String) -[FS]> Bool Never! {
    directory := root
    loop name in relative.split("/") {
        if name == "" || name.starts_with(".") || JET_CLI_SKIPPED_NAMES.contains(name) -> return true
        if directory != root {
            if cli_files.is_symlink(directory) || jet_cli_is_project_boundary(directory) -> return true
        }
        directory = jet_cli_authority_path(directory, name)
    }
    false
}

// `files` with `added` placed at its root-relative position in walk order.
jet_cli_insert_source: fn(files: &&[JetDriverAuthorizedSourceFile], added: JetDriverAuthorizedSourceFile) -> [JetDriverAuthorizedSourceFile] Never! {
    ordered := [JetDriverAuthorizedSourceFile]{}
    ordered.try_reserve(files.len() + 1) ?? panic("cannot reserve the authorized source ordering: {err}")
    placed := false
    loop file in files {
        if !placed && jet_cli_relative_precedes(added.relative_path, file.relative_path) {
            ordered.push(added.copy())
            placed = true
        }
        ordered.push(file)
    }
    if !placed -> ordered.push(added.copy())
    ordered
}

// A prepared compile: the authorized request and the snapshot it holds, or
// the refusal that stopped preparing it.
JetCLIPrepared: enum {
    Prepared(request: JetDriverCompileRequest, snapshot: JetDriverAuthorizedSourceSnapshot)
    Refused(output: JetDriverVerbOutput)
}

// The authorized source snapshot of a compile, before the Core sources join
// it, or the refusal that stopped taking it.
JetCLISnapshotted: enum {
    Held(snapshot: JetDriverAuthorizedSourceSnapshot)
    Refused(output: JetDriverVerbOutput)
}

jet_cli_prepare_refused: fn(what: String, fix: String, color: Bool) -> JetCLIPrepared Never! {
    JetCLIPrepared.Refused{output: jet_cli_prepare_refusal(what, fix, color)}
}

jet_cli_snapshot_refused: fn(what: String, fix: String, color: Bool) -> JetCLISnapshotted Never! {
    JetCLISnapshotted.Refused{output: jet_cli_prepare_refusal(what, fix, color)}
}

jet_cli_prepare_refusal: fn(what: String, fix: String, color: Bool) -> JetDriverVerbOutput Never! {
    jet_cli_report_output("", "E2105", what, jet_cli_why("E2105"), fix, color, JET_DRIVER_EXIT_USER_ERROR)
}

// The E2105 headline for a file Jet couldn't read. A path that names nothing
// says so; anything else (a directory, a permission, a link the snapshot
// refuses) keeps the secure-read wording.
jet_cli_unread_file_what: fn(file: String) -[FS]> String Never! {
    if !cli_files.exists(file) -> return "there's no file `{file}`"
    "can't securely read the file `{file}`"
}

// The checked sources under `anchor`'s source root with `overlays` laid over
// them, compiled with `entry` as the entry. An overlay replaces the bytes of a
// walked file, or adds an absent `.jet` file the walk would have read; the
// source loader and its authorization stay the one in this file. The source
// walk is the `sources` span; the request carries `trace_sink` into the
// driver's phases; `hold_check_state` as in jet_cli_compile_prepared.
jet_cli_compile_overlays: fn(anchor: String, entry: String, overlays: [JetCLIOverlay], color: Bool, threads: Int?, mode: JetDriverCompileMode, trace_sink: JetCLITraceSink?, settings: [BuildSettingOverride]{[BuildSettingOverride]{}}, profile: String{""}, target_machine: String{""}, hold_check_state: Bool{false}) -> JetCLICompiled {
    if trace_sink == .Val(sink) -> sink.begin("sources", "", -1, -1)
    prepared: jet_cli_prepare_overlays(anchor, entry, overlays, color, threads, mode)
    if trace_sink == .Val(sink) -> sink.end("sources", jet_cli_prepared_file_count(prepared))
    jet_cli_compile_prepared(prepared, None, trace_sink, settings, profile, target_machine: target_machine, hold_check_state: hold_check_state)
}

// How many source files a prepared compile authorizes; -1 for a refusal.
jet_cli_prepared_file_count: fn(prepared: JetCLIPrepared) -> Int Never! {
    if prepared == {
        .Prepared(_, snapshot) -> jet_cli_snapshot_file_count(snapshot)
        .Refused(_) -> -1
    }
}

// Compile `prepared` (`jet_cli_compile_overlays`). `input_log`, when given,
// records every comptime input file the compile reads (`embed_file`,
// `embed_bytes`, `find`); `settings` are the `--set` writers; a non-empty
// `profile` is the selected `--profile`; `prelude` checks the entry as a
// Compiler/Prelude source (`jet check --prelude`); `every_core_body` checks
// every Core body, called or not, and `core_layers` is Core's layer table
// whose upward names it reports (`jet check Core`); a non-empty
// `target_machine` is the machine without an OS the program is checked for.
// `hold_check_state`: the caller ends the process with the result still held
// (Host.jet jet_cli_finish), so a check's compile state moves into the
// result and is never dropped (JetDriverCompileRequest.hold_check_state).
jet_cli_compile_prepared: fn(prepared: &&JetCLIPrepared, input_log: Shared<JetDriverComptimeInputLog>?, trace_sink: JetCLITraceSink?, settings: [BuildSettingOverride]{[BuildSettingOverride]{}}, profile: String{""}, prelude: Bool{false}, every_core_body: Bool{false}, core_layers: [ModuleLayer]{[ModuleLayer]{}}, target_machine: String{""}, hold_check_state: Bool{false}) -> JetCLICompiled {
    if prepared.move() == {
        .Refused(output) -> JetCLICompiled.Refused{output: output}
        .Prepared(request, snapshot) -> {
            selected := request
            selected.trace_sink = jet_cli_trace_boxed(trace_sink)
            // copy: the caller keeps its handle on the one shared log.
            selected.comptime_input_log = input_log.copy()
            selected.setting_overrides = settings
            if profile != "" -> selected.profile = profile
            selected.target_machine = target_machine
            selected.prelude_entry = prelude
            selected.every_core_body = every_core_body
            selected.core_layers = core_layers
            selected.hold_check_state = hold_check_state
            // The runtime-library seam is `jet doc`'s (Host.jet jet_cli_doc_result):
            // a check, test or build under a stray JET_FRONT_LIBRARY_OBJECT_OUTPUT
            // stays that verb's compile.
            library_prefix: if selected.mode == JetDriverCompileMode.Doc -> cli_sys.get(ENV_JET_FRONT_LIBRARY_OBJECT_OUTPUT) else -> None
            // copy: a three-field row; the request moves into the compiler below.
            compiler_threads: selected.compiler_threads.copy()
            result := if library_prefix == .Val(prefix) -> jet_cli_runtime_library(jet_cli_lowering_inputs(selected, trace_sink), prefix, cli_sys.get(ENV_JET_FRONT_LIBRARY_LIFECYCLE), compiler_threads, trace_sink) else -> jet_cli_compile_request(selected, trace_sink)
            // The host's phases after the compile (Host.jet's native backend
            // route) trace through the same sink, which the result carries,
            // and compile on the request's threads.
            result.trace_sink = jet_cli_trace_boxed(trace_sink)
            result.compiler_threads = compiler_threads
            JetCLICompiled.Compiled{result: result, snapshot: snapshot}
        }
    }
}

// The checked compile of an executable (`jet build`, `jet run`, a script,
// `jet dev`): the driver's compile stopped before lowering, with the checked
// inputs the native route builds from (Host.jet jet_cli_native_executable).
JetCLIExecutableCompiled: enum {
    // `inputs` is None when the compile stopped before lowering; the result's
    // diagnostics say why. `snapshot` as in JetCLICompiled.Compiled.
    Checked(result: JetDriverCompileResult, inputs: JetDriverLoweringInputs?, snapshot: JetDriverAuthorizedSourceSnapshot)
    Refused(output: JetDriverVerbOutput)
}

// The executable compile of `file` (its source walk is the `sources` span),
// starting at the function `entry` when one is selected.
jet_cli_compile_executable_file: fn(file: String, entry: String?, color: Bool, threads: Int?, options: BuildOptions, trace_sink: JetCLITraceSink?) -> JetCLIExecutableCompiled {
    if trace_sink == .Val(sink) -> sink.begin("sources", "", -1, -1)
    prepared: jet_cli_prepare_overlays(file, file, [JetCLIOverlay]{}, color, threads, JetDriverCompileMode.Program)
    if trace_sink == .Val(sink) -> sink.end("sources", jet_cli_prepared_file_count(prepared))
    jet_cli_compile_executable(prepared, entry, options, None, trace_sink, color)
}

// jet_cli_compile_prepared for the native executable route under the build
// `options`: their selected profile is the front end's (`#build.profile`, its
// package.jet settings); `entry` selects the function the program starts at
// (None: the package's own entry); `input_log` as there, else a log of this
// compile's own: either way the result lists the comptime inputs it read
// (JetDriverCompileResult.comptime_inputs). The settings the
// package's `build: fn` contributes are recorded and folded first
// (jet_cli_contributed_request); `color` renders that step's refusal.
jet_cli_compile_executable: fn(prepared: &&JetCLIPrepared, entry: String?, options: BuildOptions, input_log: Shared<JetDriverComptimeInputLog>?, trace_sink: JetCLITraceSink?, color: Bool) -> JetCLIExecutableCompiled {
    if prepared.move() == {
        .Refused(output) -> JetCLIExecutableCompiled.Refused{output: output}
        .Prepared(request, snapshot) -> {
            selected := request
            selected.trace_sink = jet_cli_trace_boxed(trace_sink)
            // copy: the caller keeps its handle on the one shared log, and
            // this compile keeps its own to read the records back.
            log: input_log.copy() ?? Shared{JetDriverComptimeInputLog{records: [JetDriverComptimeInputRecord]{}}}
            selected.comptime_input_log = Val(log.copy())
            if options.profile != "" -> selected.profile = options.profile
            selected.artifact_build = options.command == "build"
            // An OS-less build (`os: web`) folds `#build.target.os` on its own OS,
            // which no host triple names.
            os_option: build_options_value(options, "os")
            if target_os_parse(os_option) == .Val(os) && !target_os_native(os) -> selected.build_os = os_option
            // copy: the caller's options keep the machine for the image refusal.
            selected.target_machine = options.target_machine.copy()
            selected.setting_overrides = options.settings.copy()
            selected.gate_set.allowed = options.gates.copy()
            contributed := jet_cli_contributed_request(selected, color)
            // copy: `refusal` is a payload view of `contributed`.
            if contributed.refusal == .Val(refusal) -> return JetCLIExecutableCompiled.Refused{output: refusal.copy()}
            compiled_request := contributed.request.move()
            if entry != None -> compiled_request.selected_entry = entry.copy()
            compiled_request.deep_checks = options.deep_checks.copy()
            // `dead_code: remove` lowers only the entry package's reached
            // bodies; `keep` lowers them all, so the image can carry them
            // (Host.jet jet_cli_ir_checks).
            compiled_request.lower_reached_only = build_options_value(options, "dead_code") == "remove"
            // The native route builds IR right after the front end, so the
            // compile's state drops on its own task meanwhile
            // (JetDriverCompileRequest.release_state_aside).
            compiled_request.release_state_aside = true
            // A single program compile without a named start function is a
            // singular intent: sema selects its entry in the decided order
            // (explicit address, legacy `run: fn`, sole compatible Output,
            // checked `defaults: { run: … }`, then an ambiguity error;
            // syntax-decisions.md:7421-7429) and reports E0101 when none is
            // selected and the manifest binds no `outputs.*.entry`; the driver
            // starts at the selected Output's function, else that binding.
            if compiled_request.selected_entry == None -> compiled_request.output_intent = SemaOutputIntent.Run
            // copy: a three-field row; the request moves into the compiler below.
            compiler_threads: compiled_request.compiler_threads.copy()
            front := jet_cli_lowering_inputs(compiled_request, trace_sink)
            // The native route traces through the same sink and builds on the
            // request's threads (Host.jet jet_cli_native_executable).
            front.compile.trace_sink = jet_cli_trace_boxed(trace_sink)
            front.compile.compiler_threads = compiler_threads
            front.compile.comptime_inputs = jet_cli_comptime_inputs_read(log)
            JetCLIExecutableCompiled.Checked{result: front.compile.move(), inputs: front.inputs.move(), snapshot: snapshot}
        }
    }
}

// The comptime inputs `log` recorded, in read order.
jet_cli_comptime_inputs_read: fn(log: Shared<JetDriverComptimeInputLog>) -> [JetDriverComptimeInputRecord] Never! {
    permit: log.guard_read()
    permit.value.records.copy()
}

// How many source files the snapshot authorizes, over every root.
jet_cli_snapshot_file_count: fn(snapshot: JetDriverAuthorizedSourceSnapshot) -> Int Never! {
    count := 0
    loop root in snapshot.roots -> count += root.files.len()
    count
}

// The authorized request `jet_cli_compile_overlays` compiles, without
// compiling it: load-only queries (schema, source explain, gates) run the
// driver's source query over exactly the sources a compile would see.
// `alone` holds the entry by itself, and `target` holds a build target's
// whole folder, as jet_cli_prepare_snapshot says.
jet_cli_prepare_overlays: fn(anchor: String, entry: String, overlays: [JetCLIOverlay], color: Bool, threads: Int?, mode: JetDriverCompileMode, alone: Bool{false}, target: Bool{false}) -> JetCLIPrepared {
    if jet_cli_prepare_snapshot(anchor, entry, overlays, color, alone, target) == {
        .Refused(output) -> JetCLIPrepared.Refused{output: output}
        .Held(snapshot) -> jet_cli_prepare_request(snapshot, color, threads, mode)
    }
}

// The request that compiles `snapshot` against the Core sources of the
// toolchain of `core_input` (the snapshot's entry when `None`), or against
// this jet's Core record when those are the sources built in
// (jet_cli_core_record); `core_tests`
// as JetDriverCompileRequest.core_tests, its row compiled from
// `core_tested_source` when given (the file with its doctest claims,
// Doctests.jet). The organization's gate policy (`JET_ORG_UNSAFE_POLICY`) is
// its outermost policy rung; a configured policy that can't be read is
// refused (E3109), never skipped.
jet_cli_prepare_request: fn(snapshot: JetDriverAuthorizedSourceSnapshot, color: Bool, threads: Int?, mode: JetDriverCompileMode, core_input: String?{None}, core_tests: String{""}, core_tested_source: String?{None}) -> JetCLIPrepared {
    core_sources := if jet_cli_core_sources(core_input ?? snapshot.entry_path) == {
        .Loaded(sources) -> sources
        .Missing(what, fix) -> { return jet_cli_prepare_refused(what, fix, color) }
    }
    if core_tested_source == .Val(text) {
        // A fresh cell: copies of a row share theirs (jet_driver_core_text).
        loop index in 0..<core_sources.len() {
            if core_sources[index].path == core_tests -> core_sources[index].text = jet_driver_core_text(text)
        }
    }
    organization := if pkg_load_organization_gate_policy() == {
        .Ok(policy) -> policy
        .Err(error) -> return JetCLIPrepared.Refused{output: JetDriverVerbOutput{stdout: "", stderr: jet_driver_report_problems("", "", error.diagnostics, color, true), exit_code: JET_DRIVER_EXIT_USER_ERROR}}
    }
    request := jet_cli_driver_request(snapshot, core_sources, threads, mode)
    request.core_record = jet_cli_core_record(core_input ?? snapshot.entry_path)
    request.organization_policy = organization.declarations.move()
    request.organization_deny = organization.deny.move()
    request.organization_source = organization.source.move()
    request.core_tests = core_tests
    JetCLIPrepared.Prepared{request: request.move(), snapshot: snapshot}
}

// `jet check Core`'s entry: one import of each public Core module, under an
// alias no code names (its `_` keeps the import from L0103).
jet_cli_core_check_source: fn() -> String Never! {
    seen := [String:Bool]{}
    lines := [String]{}
    loop row in CORE_SOURCE_OWNED_ROWS {
        if row.owner != "" || row.runtime || seen.get(row.module_name) != None -> next
        seen[row.module_name] = true
        lines.push("use _core_{lines.len()}: {row.module_name}\n")
    }
    lines.push("\nmain: fn() {{}}\n")
    lines.join("")
}

// The Core row path of `file` when it is a source of the Core library of the
// toolchain a compile there reads (jet_cli_toolchain_root), not a runtime
// unit: `jet test Core/Encoding/Cbor.jet` runs that Core unit's #Tests
// (jet_cli_core_test_source). A runtime unit's exact bytes are their own
// entry (Loader.jet jet_driver_runtime_entry_row).
jet_cli_core_test_path: fn(file: String) -[FS, Env]> String? Never! {
    root: if jet_cli_toolchain_root(file) == {
        .Found(found) -> cli_files.realpath(found) ?? return None
        .Missing(_, _) -> return None
    }
    path: cli_files.realpath(file) ?? return None
    prefix: "{root}/"
    if !path.starts_with(prefix) -> return None
    relative: path.removeprefix(prefix)
    rows: jet_cli_toolchain_core_rows(root) ?? return None
    loop row in rows {
        if !row.runtime && row.path == relative -> return Val(row.path.copy())
    }
    None
}

// The entry of a `jet test` of the Core source `file` at the row path `path`
// (jet_cli_core_test_path): one import of the module that loads it, its
// owner when it is a compiler-private part, under an alias no code names.
jet_cli_core_test_source: fn(file: String, path: String) -[FS, Env]> String Never! {
    toolchain: if jet_cli_toolchain_root(file) == {
        .Found(found) -> found
        .Missing(_, _) -> return ""
    }
    rows: jet_cli_toolchain_core_rows(toolchain) ?? return ""
    loop row in rows {
        if row.path == path -> return "use _core_test: {if row.owner != "" -> row.owner else -> row.module_name}\n"
    }
    ""
}

// The Core sources under `directory` that declare #Tests or doctests, when
// `directory` is in the Core library of the toolchain a compile there reads:
// `jet test Core/Encoding` runs `jet test <file>` for each. `names` are
// their row paths, `files` the toolchain files, in row order.
JetCLICoreTestFiles: struct {
    names: [String]
    files: [String]
}

jet_cli_core_test_files: fn(directory: String) -[FS, Env]> JetCLICoreTestFiles? Never! {
    root: if jet_cli_toolchain_root(directory) == {
        .Found(found) -> cli_files.realpath(found) ?? return None
        .Missing(_, _) -> return None
    }
    path: cli_files.realpath(directory) ?? return None
    if path != "{root}/Core" && !path.starts_with("{root}/Core/") -> return None
    within: "{path.removeprefix("{root}/")}/"
    found := JetCLICoreTestFiles{names: [String]{}, files: [String]{}}
    rows: jet_cli_toolchain_core_rows(root) ?? return None
    loop row in rows {
        if !row.path.starts_with(within) || found.names.contains(row.path) -> next
        file: jet_cli_authority_path(root, row.path)
        source: cli_files.read(file) ?? next
        tested: source.starts_with("#Test(") || source.contains("\n#Test(")
        if !tested && jet_cli_doc_discover_doctests(JetCLIDocUnit{path: row.path, source: source}).len() == 0 -> next
        found.names.push(row.path.copy())
        found.files.push(file)
    }
    if found.names.len() == 0 -> return None
    Val(found)
}

// Whether the entry at `entry_path` (or its overlay) is a script: its first
// line is a `#!/...` launch line (Authority.jet `jet_cli_is_script`).
jet_cli_entry_is_script: fn(entry_path: String, overlays: [JetCLIOverlay]) -[FS, Env]> Bool Never! {
    loop overlay in overlays {
        if jet_cli_overlay_path(overlay.path) == entry_path -> return jet_cli_is_script(overlay.source)
    }
    reader := cli_files.open(entry_path, .Refuse) ?? return false
    head: reader.read(3) ?? return false
    head == "#!/".bytes()
}

// The authorized source snapshot `jet_cli_prepare_overlays` compiles. A script
// is a standalone program wherever it lives: its snapshot is the script alone,
// rooted at its own directory, never the package around it. So is an `alone`
// entry (`jet check --prelude`: the compiler embeds each Prelude source by
// itself, never with its directory's other files). A loose entry's snapshot
// is the entry and the sources it reaches, unless it is a build `target`'s
// entry: the target's listed sources may name any file of the folder, so its
// snapshot is the whole folder. An anchor no file holds yet is read from its
// overlay (an editor's unsaved buffer).
jet_cli_prepare_snapshot: fn(anchor: String, entry: String, overlays: [JetCLIOverlay], color: Bool, alone: Bool{false}, target: Bool{false}) -> JetCLISnapshotted {
    anchor_path: cli_files.realpath(anchor) ?? jet_cli_overlaid_path(anchor, overlays) ?? return jet_cli_snapshot_refused(jet_cli_unread_file_what(anchor), "check the spelling, or run jet from the folder that contains it", color)
    entry_path: jet_cli_overlay_path(entry)
    script: alone || jet_cli_entry_is_script(entry_path, overlays)
    root: if script -> jet_cli_parent(entry_path) ?? "/" else -> jet_cli_source_root(anchor_path)
    root_stat: cli_files.stat(root) ?? return jet_cli_snapshot_refused("can't securely read the source root `{root}`", "check that the directory exists and is readable", color)
    files := [JetDriverAuthorizedSourceFile]{}
    directories := [AppAuthorizedDirectory]{}
    budget := JetCLISourceBudget{entries: 0, bytes: 0, files: 0}
    prefix: if root == "/" -> "/" else -> "{root}/"
    // A loose entry (no package around it, no unsaved buffer) holds only the
    // sources it reaches (jet_cli_reach_sources), never its whole folder.
    loose: !script && !target && overlays.len() == 0 && entry_path.ends_with(".jet") && entry_path.starts_with(prefix) && (jet_cli_parent(entry_path) ?? "") == root && !cli_files.exists(jet_cli_authority_path(root, "package.jet"))
    reached := false
    if loose {
        reached = jet_cli_reach_sources(root, entry_path.slice(prefix.len()..<entry_path.len()), files, budget) ?? return jet_cli_snapshot_refused("can't securely read the sources under `{root}`: {err.message}", "remove the symbolic link or unreadable file, or check a file outside this tree", color)
        if !reached {
            files = [JetDriverAuthorizedSourceFile]{}
            budget = JetCLISourceBudget{entries: 0, bytes: 0, files: 0}
        }
    }
    if !script && !reached {
        if jet_cli_walk_sources(root, "", 0, files, directories, true, budget) == .Val(problem) {
            return jet_cli_snapshot_refused("can't securely read the sources under `{root}`: {problem}", "remove the symbolic link or unreadable file, or check a file outside this tree", color)
        }
    }
    // An explicitly selected entry is a source whatever its suffix (`jet self
    // devtools reduce` and `ice-report` compile the input under its own name),
    // and so is a script, which the walk leaves out; the walk's placement,
    // link, stat and read rules still hold for it. An entry no file holds yet
    // comes from its overlay below.
    unsaved: !cli_files.exists(entry_path) && jet_cli_overlaid_path(entry_path, overlays) != None
    if (script || !entry_path.ends_with(".jet")) && entry_path.starts_with(prefix) && !unsaved {
        relative: entry_path.slice(prefix.len()..<entry_path.len())
        if !jet_cli_outside_walk(root, relative) {
            stat: cli_files.stat(entry_path) ?? return jet_cli_snapshot_refused("can't securely read the sources under `{root}`: cannot inspect `{entry_path}`: {err}", "remove the symbolic link or unreadable file, or check a file outside this tree", color)
            if stat.is_symlink -> return jet_cli_snapshot_refused("can't securely read the sources under `{root}`: `{entry_path}` is a symbolic link", "remove the symbolic link or unreadable file, or check a file outside this tree", color)
            if stat.is_file {
                limit: jet_cli_source_read_limit(budget, stat.size, entry_path) ?? return jet_cli_snapshot_refused(err.message, "reduce the source tree size", color)
                read: jet_cli_read_rooted_source(root, relative, limit) ?? return jet_cli_snapshot_refused("can't securely read the sources under `{root}`: cannot read `{entry_path}`: {err.message}", "remove the symbolic link or unreadable file, or check a file outside this tree", color)
                if !jet_cli_build_read_same_file(stat, read.stat) -> return jet_cli_snapshot_refused("`{entry_path}` changed while it was held", "retry with a stable source tree", color)
                budget.bytes += read.stat.size
                budget.files += 1
                source: String.from_bytes(read.bytes.move()) ?? return jet_cli_snapshot_refused("cannot read `{entry_path}`: file is not valid UTF-8", "save the source as UTF-8", color)
                files = jet_cli_insert_source(files, JetDriverAuthorizedSourceFile{path: entry_path, relative_path: relative, identity: jet_cli_identity_key("file", read.stat), source: source})
            }
        }
    }
    loop overlay in overlays {
        path: jet_cli_overlay_path(overlay.path)
        replaced := false
        loop index in 0..<files.len() {
            if files[index].path != path -> next
            _: jet_cli_replace_source_budget(budget, files[index].source, overlay.source, path) ?? return jet_cli_snapshot_refused(err.message, "reduce the source tree size", color)
            files[index].source = overlay.source
            replaced = true
        }
        if replaced -> next
        relative: if path.starts_with(prefix) -> path.slice(prefix.len()..<path.len()) else -> ""
        if relative == "" || cli_files.exists(path) || !relative.ends_with(".jet") || jet_cli_outside_walk(root, relative) {
            return jet_cli_snapshot_refused("`{overlay.path}` is not a checked source file of `{root}`", "check a `.jet` file that is not inside a skipped or nested project directory", color)
        }
        size: overlay.source.count_bytes()
        _: jet_cli_source_read_limit(budget, size, path) ?? return jet_cli_snapshot_refused(err.message, "reduce the source tree size", color)
        budget.bytes += size
        budget.files += 1
        added: JetDriverAuthorizedSourceFile{path: path, relative_path: relative, identity: "authority-file-v1;kind=overlay;length={size};modified_ns=none;device=none;inode=none", source: overlay.source}
        files = jet_cli_insert_source(files, added)
    }
    entry_found := false
    loop file in files {
        if file.path == entry_path -> entry_found = true
    }
    if !entry_found {
        return jet_cli_snapshot_refused("`{entry}` is not a checked source file of `{root}`", "check a `.jet` file that is not inside a skipped or nested project directory", color)
    }
    // A header import's missing or stale C cache is bound now, so the cache
    // read below sees it (CHeaderBind.jet).
    if jet_cli_c_bind_refresh(root, entry_path, files, color) == .Val(refusal) -> return JetCLISnapshotted.Refused{output: refusal}
    caches := [JetDriverAuthorizedSourceFile]{}
    if jet_cli_foreign_cache_files(root, caches, budget) == .Val(problem) {
        return jet_cli_snapshot_refused("can't securely read the foreign bindings under `{root}`: {problem}", "remove the symbolic link or unreadable file, or regenerate the bindings with `jet bind`", color)
    }
    current_root: cli_files.stat(root) ?? return jet_cli_snapshot_refused("cannot revalidate source root `{root}`: {err}", "retry with a stable source tree", color)
    if !current_root.is_dir || current_root.is_symlink || current_root.id != root_stat.id -> return jet_cli_snapshot_refused("source root `{root}` changed while it was held", "retry with a stable source tree", color)
    root_identity: jet_cli_identity_key("directory", root_stat)
    roots := [JetDriverAuthorizedSourceRoot]{JetDriverAuthorizedSourceRoot{canonical_path: root, identity: root_identity, allow_hardlinks: false, files: files, foreign_cache_files: caches, directories: directories}}
    script_dependencies := [JetDriverScriptDependency]{}
    if jet_cli_script_dependency_roots(roots, entry_path, script_dependencies, color) == .Val(refusal) -> return JetCLISnapshotted.Refused{output: refusal}
    if jet_cli_path_dependency_roots(roots, entry_path, color) == .Val(refusal) -> return JetCLISnapshotted.Refused{output: refusal}
    JetCLISnapshotted.Held{snapshot: JetDriverAuthorizedSourceSnapshot{
        roots: roots,
        entry_root_identity: root_identity,
        entry_path: entry_path,
        script_dependencies: script_dependencies,
    }}
}

// The snapshot path of `path` when one of `overlays` holds it.
jet_cli_overlaid_path: fn(path: String, overlays: [JetCLIOverlay]) -[FS, Env]> String? Never! {
    held: jet_cli_overlay_path(path)
    loop overlay in overlays {
        if jet_cli_overlay_path(overlay.path) == held -> return Val(held)
    }
    None
}

// ---- The compiler's streaming trace: the `--trace[=FILE]` control ----
//
// The native `jet` implements the driver's CompilerTraceSink
// (Compiler/JetFoundation/Source/Trace.jet) itself. A file target receives the
// Chrome trace-event lines the Rust host's writer produces: the `[` header,
// `process_name`, `trace.start` (`unix_ms`, `functions`), one `B`/`E` event per
// span, with `rss_kb`/`peak_rss_kb` (VmRSS/VmHWM) and the span's CPU time
// (`cpu_ns` of its task, `proc_cpu_ns` of every thread, `majflt` major
// faults; this writer only) on every phase close and a `memory` counter after a
// phase, while an item's close (`begin_item`, or an indexed `begin`) carries
// only its task's `cpu_ns`, and nested phases closer than
// JET_CLI_TRACE_PROCESS_MS share one process read, so per-item events stay
// cheap; throttled `C` progress events, `<phase>.<name>` counter events, and
// `JET_PHASE_COUNTERS` stderr lines with `--phase-counters`, so Tools/perf
// and Tools/agent read either compiler's trace. `-` or `stderr` streams one
// readable line per event to stderr instead. The target stays open for the
// whole compile and every line is flushed as soon as its event happens, so a
// running compile can be followed. A failed write stops the trace, never the
// compile. The sink's calls stay inside the trait's FS row: monotonic time is
// `/proc/uptime` (CLOCK_BOOTTIME, 10 ms resolution) and stderr is written as
// `/dev/stderr`.
JET_CLI_TRACE_STDERR: "/dev/stderr"
// Minimum spacing of the progress events of one kind; the last item is always
// written.
JET_CLI_TRACE_PROGRESS_MS: 200
// A progress kind reads the clock on its first call and then once every this
// many calls (and on its last item), so a per-item kind costs no clock read
// per item.
JET_CLI_TRACE_PROGRESS_STRIDE: 16
// A phase span's begin or end below the top level reuses the process's clocks
// and memory read this recently (ms), so steps that repeat per item (a
// comptime item's `comptime.apply`) share one `/proc/self` read.
JET_CLI_TRACE_PROCESS_MS: 50

// One open span: its kind, the label it shows, when it began (µs), the CPU
// clocks and fault count when it began, and whether it is one item's
// (`begin_item`, or an indexed `begin`), which reads only its task's CPU
// clock.
JetCLITraceSpan: struct {
    kind: String
    label: String
    start_us: Int
    start: JetCLITraceUsage
    item: Bool
}

// CPU time in ns of the calling task (core.tasks.cpu_ns: the time its fiber
// ran, on whichever carrier threads; a plain thread's own CPU time) and of the
// whole process (`/proc/self/stat` utime + stime, in 10 ms clock ticks), and
// the process's major page faults; -1 where unreadable or not read. A span
// reports the difference between its end and its begin; begin and end run in
// the same task (spans nest per task).
JetCLITraceUsage: struct {
    cpu_ns: Int
    proc_cpu_ns: Int
    majflt: Int
}

JetCLITraceState: struct {
    // False after a failed write: the trace stops, the compile does not.
    writing: Bool
    // The target, open for appending from the trace's start.
    writer: cli_files.FileWriter
    // Open spans per trace lane (jet_cli_trace_lane), innermost last.
    stacks: [Int:[JetCLITraceSpan]]
    // Each task's trace lane, its events' `tid`: 1 for the task that opened
    // the trace, then numbered in the order tasks first trace.
    lanes: [cli_tasks.TaskID:Int]
    // When each progress kind was last written (uptime ms).
    progress_at: [String:Int]
    // How many times each progress kind was reported.
    progress_calls: [String:Int]
    // The last read of the process's clocks and faults (`cpu_ns` -1) and
    // memory, and when it was taken (uptime ms, -1 before the first).
    process: JetCLITraceUsage
    memory: JetCLITraceMemory?
    process_ms: Int
}

JetCLITraceSink: struct {
    // The trace file, or `/dev/stderr` for the readable stream.
    target: String
    human: Bool
    // Uptime (ms) when the trace opened: the origin of every timestamp.
    start_ms: Int
    pid: Int
    functions: Bool
    phase_counters: Bool
    // Shared by every copy of the sink and every compiler thread.
    state: Shared<JetCLITraceState>

    impl CompilerTraceSink {
        begin: fn(self, name: String, detail: String, index: Int, total: Int) Never! -[FS, Time]> {
            args: if index >= 0 -> ",\"args\":{{\"index\":{index},\"total\":{total}}}" else -> ""
            jet_cli_trace_open(self, name, detail, args, jet_cli_trace_place(index, total), index >= 0)
        }

        begin_item: fn(self, name: String, file: String, item: String) Never! -[FS, Time]> {
            args: ",\"args\":{{\"file\":{foundation_json_quote(file)},\"item\":{foundation_json_quote(item)}}}"
            jet_cli_trace_open(self, name, item, args, " ({file})", true)
        }

        // Closes the innermost open span of kind `name` in this task, and any
        // deeper span an early return left open; no open span of that kind in
        // this task writes nothing.
        end: fn(self, name: String, items: Int) Never! -[FS, Time]> {
            cpu_ns: cli_tasks.cpu_ns()
            ts: jet_cli_trace_micros(self.start_ms)
            id: cli_tasks.current_task()
            permit := self.state.guard_edit()
            if !permit.value.writing -> return
            task: jet_cli_trace_lane(permit.value, id)
            stack := permit.value.stacks.get(task) ?? return
            position := stack.len() - 1
            loop position >= 0 && stack[position].kind != name -> position -= 1
            if position < 0 -> return
            line := ""
            loop stack.len() > position + 1 {
                abandoned: stack.pop() ?? break
                line = "{line}{jet_cli_trace_close_line(self, abandoned, false, -1, None, None, ts, task, stack.len())}"
            }
            closed: stack.pop() ?? return
            // Only a phase's close reads the process's clocks and memory.
            memory := JetCLITraceMemory?{None}
            now := JetCLITraceUsage{cpu_ns: cpu_ns, proc_cpu_ns: -1, majflt: -1}
            if !closed.item {
                now = jet_cli_trace_process(permit.value, self.start_ms + ts /% 1000, cpu_ns, stack.len() == 0)
                memory = permit.value.memory
            }
            spent: jet_cli_trace_usage_since(closed.start, now)
            line = "{line}{jet_cli_trace_close_line(self, closed, true, items, memory, Val(spent), ts, task, stack.len())}"
            permit.value.stacks[task] = stack
            jet_cli_trace_write(self.target, permit.value, line)
        }

        progress: fn(self, name: String, done: Int, total: Int) Never! -[FS]> {
            if name.starts_with("counters.") {
                self.counter(name, done)
                return
            }
            last_item: total > 0 && done + 1 >= total
            if !jet_cli_trace_progress_due(self.state, name, last_item) -> return
            now: jet_cli_trace_uptime_ms()
            permit := self.state.guard_edit()
            if !permit.value.writing -> return
            if permit.value.progress_at.get(name) == .Val(previous) {
                if !last_item && now - previous < JET_CLI_TRACE_PROGRESS_MS -> return
            }
            permit.value.progress_at[name] = now
            task: jet_cli_trace_lane(permit.value, cli_tasks.current_task())
            ts: if now > self.start_ms -> (now - self.start_ms) * 1000 else -> 0
            line := ""
            if self.human {
                depth: (permit.value.stacks.get(task) ?? [JetCLITraceSpan]{}).len()
                of: if total > 0 -> "/{total}" else -> ""
                line = "{jet_cli_trace_prefix(self, ts, task, depth)}~ {name} {done}{of}{jet_cli_trace_resident(jet_cli_trace_memory())}\n"
            } else {
                line = "{jet_cli_trace_head(name, None, "C", ts, self.pid, task)},\"args\":{{\"done\":{done},\"total\":{total}}}}},\n"
            }
            jet_cli_trace_write(self.target, permit.value, line)
        }

        functions: fn(self) -[]> Bool Never! {
            self.functions
        }
    }

    // A `counters.<phase>.<name>` progress kind: one #4319 scaling counter
    // value, written unthrottled as the `<phase>.<name>` counter event and,
    // with `--phase-counters`, as a `JET_PHASE_COUNTERS` stderr line.
    counter: fn(self, kind: String, value: Int) Never! {
        parts := kind.split(".").to_list()
        if parts.len() < 3 -> return
        counter_name: parts.pop() ?? return
        phase := parts[1]
        loop index in 2..<parts.len() -> phase = "{phase}.{parts[index]}"
        counter: "{phase}.{counter_name}"
        ts: jet_cli_trace_micros(self.start_ms)
        id: cli_tasks.current_task()
        permit := self.state.guard_edit()
        if permit.value.writing {
            task: jet_cli_trace_lane(permit.value, id)
            depth: (permit.value.stacks.get(task) ?? [JetCLITraceSpan]{}).len()
            line: if self.human -> "{jet_cli_trace_prefix(self, ts, task, depth)}# {counter} = {value}\n" else -> "{jet_cli_trace_head(counter, None, "C", ts, self.pid, task)},\"args\":{{\"value\":{value}}}}},\n"
            jet_cli_trace_write(self.target, permit.value, line)
        }
        if self.phase_counters {
            _: jet_cli_trace_append(JET_CLI_TRACE_STDERR, "JET_PHASE_COUNTERS {{\"phase\":{foundation_json_quote(phase)},{foundation_json_quote(counter_name)}:{value}}}\n")
        }
    }
}

// Resident and peak resident set size in kB (`VmRSS`, `VmHWM`).
JetCLITraceMemory: struct {
    rss_kb: Int
    peak_kb: Int
}

// The process's one sink, opened by `jet_cli_main` for a compiling verb: the
// target the `--trace` control names (Controls.jet: on alone or `-` for
// stderr, else the file); `None` when it asks for no trace or the target
// cannot be written (the reason goes to stderr, the compile goes on).
// `--trace-detail=functions` traces each function, `--phase-counters` also
// prints the counters. A file target is truncated and starts with the trace
// header.
jet_cli_trace_sink: fn() -> JetCLITraceSink? {
    chosen: if jet_cli_control("trace").value == {
        .Bool(on) -> if on -> "-" else -> ""
        .Text(file) -> file.copy() // copy: the control's value is dropped here.
        .Null | .Integer(_) | .Float(_) | .Array(_) | .Object(_) -> ""
    }
    if chosen == "" -> return None
    human: chosen == "-" || chosen == "stderr"
    target: if human -> JET_CLI_TRACE_STDERR else -> chosen
    start_ms: jet_cli_trace_uptime_ms()
    pid: cli_sys.pid()
    executable: cli_sys.executable().split("/").to_list()
    process := "jet"
    if executable.len() > 0 && executable[executable.len() - 1] != "" -> process = executable[executable.len() - 1]
    functions: (jet_cli_control_text("trace_detail") ?? "") == "functions"
    detail: if functions -> "true" else -> "false"
    opening: if human -> "[{jet_cli_trace_clock(0)}] trace: {process} pid {pid}, functions {detail}\n" else -> "[\n{{\"name\":\"process_name\",\"ph\":\"M\",\"pid\":{pid},\"tid\":0,\"args\":{{\"name\":{foundation_json_quote(process)}}}}},\n"
    opened: if human -> jet_cli_trace_append(target, opening) else -> jet_cli_trace_create(target, opening)
    if opened == .Val(problem) {
        _: jet_cli_trace_append(JET_CLI_TRACE_STDERR, "jet: cannot write the compiler trace `{chosen}`: {problem}\n")
        return None
    }
    if !human {
        // The wall-clock anchor readers align the trace with: the
        // modification time the header write just set (no clock read).
        unix_ms: if cli_files.stat(target) == .Ok(info) -> info.modified.to_unix_ms() else -> 0
        started: jet_cli_trace_append(target, "{{\"name\":\"trace.start\",\"ph\":\"i\",\"s\":\"g\",\"ts\":0,\"pid\":{pid},\"tid\":0,\"args\":{{\"unix_ms\":{unix_ms},\"functions\":{detail}}}}},\n")
        if started == .Val(problem) {
            _: jet_cli_trace_append(JET_CLI_TRACE_STDERR, "jet: cannot write the compiler trace `{chosen}`: {problem}\n")
            return None
        }
    }
    // The target stays open: every event appends to the same open file.
    writer: cli_files.append(target) ?? {
        _: jet_cli_trace_append(JET_CLI_TRACE_STDERR, "jet: cannot write the compiler trace `{chosen}`: {err}\n")
        return None
    }
    Val(JetCLITraceSink{
        target: target,
        human: human,
        start_ms: start_ms,
        pid: pid,
        functions: functions,
        phase_counters: jet_cli_control_on("phase_counters"),
        state: Shared{JetCLITraceState{
            writing: true,
            writer: writer,
            stacks: [Int:[JetCLITraceSpan]]{},
            lanes: jet_cli_trace_opening_lanes(),
            progress_at: [String:Int]{},
            progress_calls: [String:Int]{},
            process: JetCLITraceUsage{cpu_ns: -1, proc_cpu_ns: -1, majflt: -1},
            memory: None,
            process_ms: -1,
        }},
    })
}

// A driver trait object over the sink. Trait objects cannot be copied, so
// each owner (the request, the result) gets its own; every one writes
// through the sink's one shared state.
jet_cli_trace_boxed: fn(sink: JetCLITraceSink?) -> CompilerTraceSink? Never! {
    opened: sink ?? return None
    // copy: the caller's sink (owner: the request's option, boxed again for the result) and
    // this trait object (owner: the boxed sink) each hold the sink; the copy shares its one
    // traced state cell (a refcount bump plus flags).
    Val(jet_cli_trace_object(opened.copy()))
}

jet_cli_trace_object: fn(sink: &&JetCLITraceSink) -> CompilerTraceSink Never! {
    sink.move()
}

// Counts one report of progress kind `name`: true on its first call, every
// JET_CLI_TRACE_PROGRESS_STRIDE-th call after, and on its last item.
jet_cli_trace_progress_due: fn(state: Shared<JetCLITraceState>, name: String, last_item: Bool) -> Bool {
    permit := state.guard_edit()
    calls: permit.value.progress_calls.get(name) ?? 0
    permit.value.progress_calls[name] = calls + 1
    last_item || calls % JET_CLI_TRACE_PROGRESS_STRIDE == 0
}

// Opens a span of kind `name` labelled `detail` (`name` when empty): its `B`
// event carries `args` (`,"args":{...}` or ""), its readable line `place`.
// An `item` span (one comptime item, or one indexed unit of a phase) reads
// only its task's CPU clock, so a phase of many items stays cheap to trace.
jet_cli_trace_open: fn(sink: JetCLITraceSink, name: String, detail: String, args: String, place: String, item: Bool) Never! -[FS, Time]> {
    ts: jet_cli_trace_micros(sink.start_ms)
    id: cli_tasks.current_task()
    label: if detail == "" -> name else -> detail
    cpu_ns: cli_tasks.cpu_ns()
    permit := sink.state.guard_edit()
    if !permit.value.writing -> return
    task: jet_cli_trace_lane(permit.value, id)
    stack := permit.value.stacks.get(task) ?? [JetCLITraceSpan]{}
    start := JetCLITraceUsage{cpu_ns: cpu_ns, proc_cpu_ns: -1, majflt: -1}
    if !item -> start = jet_cli_trace_process(permit.value, sink.start_ms + ts /% 1000, cpu_ns, stack.len() == 0)
    line := ""
    if sink.human {
        shown: if detail == "" -> "" else -> " {detail}"
        line = "{jet_cli_trace_prefix(sink, ts, task, stack.len())}> {name}{shown}{place}\n"
    } else {
        if !permit.value.stacks.has_key(task) -> line = jet_cli_trace_task_name(sink.pid, task)
        line = "{line}{jet_cli_trace_head(label, Val(name), "B", ts, sink.pid, task)}{args}}},\n"
    }
    stack.push(JetCLITraceSpan{kind: name, label: label, start_us: ts, start: start, item: item})
    permit.value.stacks[task] = stack
    jet_cli_trace_write(sink.target, permit.value, line)
}

// A span's close. Machine form: its `E` event (with args only for the span
// `end` named), then a phase's `memory` counter; readable form: one line
// with the span's duration, CPU time, item count and memory.
jet_cli_trace_close_line: fn(sink: JetCLITraceSink, span: JetCLITraceSpan, named: Bool, items: Int, memory: JetCLITraceMemory?, spent: JetCLITraceUsage?, ts: Int, task: Int, depth: Int) -> String Never! {
    if sink.human {
        item: if span.label == span.kind -> "" else -> " {span.label}"
        counted: if items >= 0 -> " items={items}" else -> ""
        abandoned: if named -> "" else -> " (left open)"
        cpu := ""
        if spent == .Val(usage) {
            if usage.cpu_ns >= 0 -> cpu = " cpu={jet_cli_trace_seconds(usage.cpu_ns /% 1000)}s"
        }
        return "{jet_cli_trace_prefix(sink, ts, task, depth)}< {span.kind}{item} {jet_cli_trace_seconds(ts - span.start_us)}s{cpu}{counted}{jet_cli_trace_resident(memory)}{abandoned}\n"
    }
    head: jet_cli_trace_head(span.label, Val(span.kind), "E", ts, sink.pid, task)
    if !named -> return "{head}}},\n"
    args := [String]{}
    if items >= 0 -> args.push("\"items\":{items}")
    if memory == .Val(kb) -> args.push("\"rss_kb\":{kb.rss_kb},\"peak_rss_kb\":{kb.peak_kb}")
    if spent == .Val(usage) {
        if usage.cpu_ns >= 0 -> args.push("\"cpu_ns\":{usage.cpu_ns}")
        if usage.proc_cpu_ns >= 0 -> args.push("\"proc_cpu_ns\":{usage.proc_cpu_ns}")
        if usage.majflt >= 0 -> args.push("\"majflt\":{usage.majflt}")
    }
    joined: args.join(",")
    line := "{head},\"args\":{{{joined}}}}},\n"
    if span.label == span.kind && memory == .Val(kb) {
        rss_mb: kb.rss_kb /% 1024
        peak_mb: kb.peak_kb /% 1024
        line = "{line}{jet_cli_trace_head("memory", None, "C", ts, sink.pid, task)},\"args\":{{\"rss_mb\":{rss_mb},\"peak_rss_mb\":{peak_mb}}}}},\n"
    }
    line
}

// `{"name":..,"cat":..,"ph":..,"ts":..,"pid":..,"tid":..` without the closing
// brace, so the caller appends `args`. `tid` is the event's task: its spans
// nest under one trace-viewer lane whichever carrier threads ran it.
jet_cli_trace_head: fn(name: String, kind: String?, phase: String, ts: Int, pid: Int, task: Int) -> String Never! {
    category: if kind == .Val(text) -> ",\"cat\":{foundation_json_quote(text)}" else -> ""
    "{{\"name\":{foundation_json_quote(name)}{category},\"ph\":\"{phase}\",\"ts\":{ts},\"pid\":{pid},\"tid\":{task}"
}

// The `thread_name` metadata event naming the lane of a task's first span.
jet_cli_trace_task_name: fn(pid: Int, task: Int) -> String Never! {
    "{{\"name\":\"thread_name\",\"ph\":\"M\",\"pid\":{pid},\"tid\":{task},\"args\":{{\"name\":\"task {task}\"}}}},\n"
}

// The readable stream's line prefix: elapsed seconds, a non-main lane's
// number, and two spaces per open span.
jet_cli_trace_prefix: fn(sink: JetCLITraceSink, ts: Int, task: Int, depth: Int) -> String Never! {
    lane: if task == JET_CLI_TRACE_MAIN_LANE -> "" else -> "[t{task}] "
    indent := ""
    loop indent.len() < depth * 2 -> indent = "{indent}  "
    "[{jet_cli_trace_clock(ts)}] {lane}{indent}"
}

// Elapsed microseconds as right-aligned seconds, `   12.345s`.
jet_cli_trace_clock: fn(us: Int) -> String Never! {
    text := jet_cli_trace_seconds(us)
    loop text.len() < 9 -> text = " {text}"
    "{text}s"
}

jet_cli_trace_seconds: fn(us: Int) -> String Never! {
    seconds: us /% 1000000
    millis: (us %% 1000000) /% 1000
    pad: if millis < 10 -> "00" else if millis < 100 -> "0" else -> ""
    "{seconds}.{pad}{millis}"
}

// ` (3/120)` for an item's place in its phase; ` (#3)` when uncounted.
jet_cli_trace_place: fn(index: Int, total: Int) -> String Never! {
    if index < 0 -> return ""
    position: index + 1
    if total > 0 -> return " ({position}/{total})"
    " (#{position})"
}

jet_cli_trace_resident: fn(memory: JetCLITraceMemory?) -> String Never! {
    if memory == .Val(kb) {
        rss_mb: kb.rss_kb /% 1024
        peak_mb: kb.peak_kb /% 1024
        return " rss={rss_mb}MB peak={peak_mb}MB"
    }
    ""
}

// Microseconds since the trace opened (`/proc/uptime` resolution).
jet_cli_trace_micros: fn(start_ms: Int) -> Int Never! {
    elapsed: jet_cli_trace_uptime_ms() - start_ms
    if elapsed < 0 -> return 0
    elapsed * 1000
}

// Milliseconds since boot from `/proc/uptime` (`12345.67 …`, CLOCK_BOOTTIME),
// the trace's monotonic clock; 0 when it cannot be read. Every span's begin
// and end reads it, so it is scanned in place, never split.
jet_cli_trace_uptime_ms: fn() -> Int Never! {
    text: cli_files.read("/proc/uptime") ?? return 0
    bytes: text.bytes()
    point := 0
    loop point < bytes.len() && bytes[point] != (U8{46}) {
        if bytes[point] == (U8{32}) -> return 0
        point += 1
    }
    seconds: jet_cli_trace_number(bytes, 0, point)
    if seconds < 0 || point >= bytes.len() -> return 0
    end := point + 1
    loop end < bytes.len() && bytes[end] != (U8{32}) && bytes[end] != (U8{10}) {
        if bytes[end] == (U8{46}) -> return 0
        end += 1
    }
    if end > point + 1 && jet_cli_trace_number(bytes, point + 1, end) < 0 -> return 0
    // The first three fraction digits, zero-padded: `.67` is 670 ms.
    millis := 0
    loop index in 0..<3 {
        digit: if point + 1 + index < end -> (Int{bytes[point + 1 + index]}) - 48 else -> 0
        millis = millis * 10 + digit
    }
    seconds * 1000 + millis
}

// The decimal number `bytes[from..<to]`, or -1 when it is empty or holds a
// non-digit.
jet_cli_trace_number: fn(bytes: [U8], from: Int, to: Int) -> Int Never! {
    if from >= to -> return -1
    value := 0
    loop index in from..<to {
        code: Int{bytes[index]}
        if code < 48 || code > 57 -> return -1
        value = value * 10 + code - 48
    }
    value
}

// The trace lane of the task that opened the trace.
JET_CLI_TRACE_MAIN_LANE: 1

jet_cli_trace_opening_lanes: fn() -> [cli_tasks.TaskID:Int] Never! {
    lanes := [cli_tasks.TaskID:Int]{}
    lanes[cli_tasks.current_task()] = JET_CLI_TRACE_MAIN_LANE
    lanes
}

// The calling task's trace lane, numbering a task the first time it traces.
// The identity is the running task's (its fiber's, kept across the carrier
// threads that run it; a plain thread's), and the CPU clock the spans read
// (core.tasks.cpu_ns) is that task's too, so a span that parks and resumes
// on another carrier still closes on its own stack and clock.
jet_cli_trace_lane: fn(state: &JetCLITraceState, task: cli_tasks.TaskID) -> Int Never! {
    if state.lanes.get(task) == .Val(lane) -> return lane
    lane: state.lanes.len() + 1
    state.lanes[task] = lane
    lane
}

jet_cli_trace_memory: fn() -> JetCLITraceMemory? Never! {
    text: cli_files.read("/proc/self/status") ?? return None
    rss := -1
    peak := -1
    loop line in text.lines() {
        if line.starts_with("VmRSS:") -> rss = jet_cli_trace_status_kb(line)
        if line.starts_with("VmHWM:") -> peak = jet_cli_trace_status_kb(line)
    }
    if rss < 0 || peak < 0 -> return None
    Val(JetCLITraceMemory{rss_kb: rss, peak_kb: peak})
}

// The kB count of one `/proc/self/status` line (`VmRSS:\t  1234 kB`), or -1.
jet_cli_trace_status_kb: fn(line: String) -> Int Never! {
    parts: line.split(":").to_list()
    if parts.len() != 2 -> return -1
    loop word in parts[1].trim().split(" ") {
        if word == "" -> next
        return Int.parse(word) ?? -1
    }
    -1
}

// `/proc/self/stat` counts CPU time in clock ticks of USER_HZ (100 on every
// Linux ABI): 10 ms each.
JET_CLI_TRACE_NS_PER_TICK: 10000000

// The process's CPU clock and major fault count (`cpu_ns` -1).
jet_cli_trace_process_usage: fn() -> JetCLITraceUsage Never! {
    usage := JetCLITraceUsage{cpu_ns: -1, proc_cpu_ns: -1, majflt: -1}
    // `pid (comm) state …`: the fields after the last `)` start at field 3
    // (state), so majflt (12), utime (14) and stime (15) are 9, 11 and 12.
    text: cli_files.read("/proc/self/stat") ?? return usage
    parts: text.split(")").to_list()
    if parts.len() < 2 -> return usage
    fields := [String]{}
    loop word in parts[parts.len() - 1].trim().split(" ") {
        if word != "" -> fields.push(word)
    }
    if fields.len() < 13 -> return usage
    usage.majflt = Int.parse(fields[9]) ?? -1
    utime: Int.parse(fields[11]) ?? return usage
    stime: Int.parse(fields[12]) ?? return usage
    usage.proc_cpu_ns = (utime + stime) * JET_CLI_TRACE_NS_PER_TICK
    usage
}

// A phase span's usage at uptime `now_ms` with its task's `cpu_ns`, and
// `state.memory` set: the process's clocks, faults and memory read again
// when `fresh` (a top-level span) or when the last read is
// JET_CLI_TRACE_PROCESS_MS old, else the last read's.
jet_cli_trace_process: fn(state: &JetCLITraceState, now_ms: Int, cpu_ns: Int, fresh: Bool) -> JetCLITraceUsage Never! {
    if fresh || state.process_ms < 0 || now_ms - state.process_ms >= JET_CLI_TRACE_PROCESS_MS {
        state.process = jet_cli_trace_process_usage()
        state.memory = jet_cli_trace_memory()
        state.process_ms = now_ms
    }
    JetCLITraceUsage{cpu_ns: cpu_ns, proc_cpu_ns: state.process.proc_cpu_ns, majflt: state.process.majflt}
}

// What a span spent between `start` and `now`; -1 where either is unknown.
jet_cli_trace_usage_since: fn(start: JetCLITraceUsage, now: JetCLITraceUsage) -> JetCLITraceUsage Never! {
    JetCLITraceUsage{
        cpu_ns: if start.cpu_ns < 0 || now.cpu_ns < 0 -> -1 else -> now.cpu_ns - start.cpu_ns,
        proc_cpu_ns: if start.proc_cpu_ns < 0 || now.proc_cpu_ns < 0 -> -1 else -> now.proc_cpu_ns - start.proc_cpu_ns,
        majflt: if start.majflt < 0 || now.majflt < 0 -> -1 else -> now.majflt - start.majflt,
    }
}

// Writes one event's text to the open target and flushes it, so every event
// is in the file when the call returns; the first failure stops the trace.
jet_cli_trace_write: fn(target: String, state: &JetCLITraceState, text: String) Never! {
    problem: jet_cli_trace_put(state.writer, text) ?? return
    state.writing = false
    _: jet_cli_trace_append(JET_CLI_TRACE_STDERR, "jet: the compiler trace stopped: writing `{target}` failed: {problem}\n")
}

jet_cli_trace_put: fn(writer: &cli_files.FileWriter, text: String) -> String? Never! {
    writer.write_all(text.bytes()) ?? return Val("{err}")
    writer.flush() ?? return Val("{err}")
    None
}

// Appends `text` (each call opens, writes, flushes and closes, so every event
// is in the file when the call returns); the failure, or `None`. Writes go
// through an append-mode `FileWriter` (the native runtime pack exports the
// writer routes; it has no whole-file append route).
jet_cli_trace_append: fn(target: String, text: String) -> String? Never! {
    writer := cli_files.append(target) ?? return Val("{err}")
    writer.write_all(text.bytes()) ?? return Val("{err}")
    writer.flush() ?? return Val("{err}")
    None
}

jet_cli_trace_create: fn(target: String, text: String) -> String? Never! {
    cli_files.write(target, text) ?? return Val("{err}")
    None
}
