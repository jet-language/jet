// The driver request the Jet-hosted `jet` builds for one entry file, the way
// the Rust bootstrap host does (Compiler/Bootstrap/Host/Native.rs
// `open_authorized_sources` and `__jet_bootstrap_request_from_host`): the
// entry root and its declared path-dependency closure, the Core library rows
// with their bodies, the canonical effect source, and the host facts. The
// entry root is the nearest directory at or above the entry that holds
// `package.jet`, or the entry's own directory for a loose file.
use core.files as cli_files
use core.sys as cli_sys
use jet_foundation.[
    AppAuthorizedDirectory,
    AppAuthorizedDirectoryEntry,
    CompilerThreads,
    CompilerTraceSink,
    CORE_SOURCE_OWNED_ROWS,
    MIRArtifactBuildMode,
    foundation_json_quote,
]
use jet_driver.[
    JetDriverAuthorizedSourceFile,
    JetDriverAuthorizedSourceRoot,
    JetDriverAuthorizedSourceSnapshot,
    JetDriverCompileMode,
    JetDriverBuildEntry,
    JetDriverBuildPath,
    JetDriverBuildInputError,
    JetDriverCompileRequest,
    JetDriverCompileResult,
    JetDriverKeepGoing,
    JetDriverCompileTarget,
    JetDriverCoreSource,
    JetDriverComptimeInputLog,
    JetDriverHostFacts,
    JetDriverVerbOutput,
    JET_DRIVER_EXIT_USER_ERROR,
    jet_driver_compile,
    jet_driver_compile_mir,
    jet_driver_compile_keep_going,
    jet_driver_compile_escaped_failure,
    jet_driver_shared_build_inputs,
    jet_driver_shared_build_http_inputs,
    JetDriverScriptDependency,
]
use jet_eval.[
    jet_eval_host_config,
]
use jet_backend.[x64_runtime_library, x64_runtime_export_abi_json, x64_link_runtime_pack]
use jet_pkg_model.[DepSpec, PackageFacts, pkg_manifest_parse, pkg_to_manifest]

// The production CLI and bootstrap observer share the driver's all-phases
// implementation. A diagnostic trap is a failed compile, never an artifact.
// `trace_sink` traces the keep-going report write (`keepgoing.report`).
fn jet_cli_compile_request(request: ^JetDriverCompileRequest, emit_rust: Bool, trace_sink: JetCLITraceSink?{None}) -> JetDriverCompileResult {
    if !jet_cli_keep_going_enabled() {
        return if emit_rust -> jet_driver_compile(^request) else -> jet_driver_compile_mir(^request)
    }
    skip := [String]{}
    loop row in (cli_sys.get("JET_KEEP_GOING_SKIP") ?? "").split(",").to_list() {
        if row.trim().len() > 0 -> &skip.push(row.trim())
    }
    result := jet_driver_compile_keep_going(^request, JetDriverKeepGoing{skip: skip}, emit_rust)
    if result.keep_going_rows.len() > 0 -> result.complete = false
    if trace_sink == .Val(sink) -> sink.begin("keepgoing.report", "", -1, -1)
    problem :: jet_cli_keep_going_report(result.keep_going_rows)
    if trace_sink == .Val(sink) -> sink.end("keepgoing.report", result.keep_going_rows.len())
    if problem != "" -> return jet_driver_compile_escaped_failure(problem)
    result
}

// JET_KEEP_GOING=1 selects the all-phases collector (here and in the
// bootstrap native feed, Compiler/Bootstrap/Host/Entry.jet).
fn jet_cli_keep_going_enabled() -> Bool Never! {
    (cli_sys.get("JET_KEEP_GOING") ?? "") == "1"
}

// Writes the TSV failure census `rows` to JET_KEEP_GOING_REPORT when it is
// set; the write's failure text, else "".
fn jet_cli_keep_going_report(rows: [String]) -> String {
    report :: cli_sys.get("JET_KEEP_GOING_REPORT") ?? return ""
    lines := [String]{"phase\titem\tcode\tmessage\tspan"}
    loop row in rows -> &lines.push(row)
    &lines.push("")
    cli_files.write(report, lines.join("\n")) ?? return "cannot write the compiler failure census: {err}"
    ""
}

// Packaging uses the ordinary hosted source loader and checked NativeLibrary
// MIR. The private environment seam is shared with the bootstrap observer;
// neither Tests.rs factories nor emitted Rust enter object/pack production.
fn jet_cli_runtime_library(result: ^JetDriverCompileResult, prefix: String) -> JetDriverCompileResult {
    if !result.complete || result.internal_problem != None -> return result
    program :: result.mir ?? return jet_driver_compile_escaped_failure("the runtime front end returned no checked MIR")
    lifecycle_path :: cli_sys.get("JET_FRONT_LIBRARY_LIFECYCLE") ?? return jet_driver_compile_escaped_failure("runtime packaging requires the lifecycle list")
    lifecycle_text :: cli_files.read(lifecycle_path) ?? return jet_driver_compile_escaped_failure("cannot read runtime lifecycle list: {err}")
    library :: x64_runtime_library(program, lifecycle_text.split("\n").to_list())
    if library.object.errors.len() > 0 {
        cli_files.write("{prefix}.issues", library.object.errors.join("\n")) ?? return jet_driver_compile_escaped_failure("cannot write runtime library findings: {err}")
        return jet_driver_compile_escaped_failure("runtime library lowering failed; see {prefix}.issues")
    }
    cli_files.write_bytes("{prefix}.o", library.object.bytes) ?? return jet_driver_compile_escaped_failure("cannot write runtime object: {err}")
    symbols :: loop row in library.exports -> row.symbol
    cli_files.write("{prefix}.exports", symbols.join("\n")) ?? return jet_driver_compile_escaped_failure("cannot write runtime exports: {err}")
    cli_files.write("{prefix}.abi.json", x64_runtime_export_abi_json(library.export_abis)) ?? return jet_driver_compile_escaped_failure("cannot write runtime ABI: {err}")
    if cli_sys.get("JET_FRONT_RUNTIME_PACK_OUTPUT") == .Val(pack_path) {
        names := [String]{"{prefix}.o"}
        bytes := [[U8]]{library.object.bytes}
        loop path in (cli_sys.get("JET_FRONT_RUNTIME_PLATFORM_INPUTS") ?? "").split("\n").to_list() {
            if path.trim() == "" -> next
            input :: cli_files.read_bytes(path) ?? return jet_driver_compile_escaped_failure("cannot read runtime platform input `{path}`: {err}")
            &names.push(path)
            &bytes.push(input)
        }
        // Preserve the hosted backend's direct memory/unwind imports (the
        // same explicit C roots as LinkRuntime.jet), never archive-wide roots.
        roots :: [String]{"memcpy", "memmove", "memset", "memcmp", "_Unwind_Backtrace"}
        linked :: x64_link_runtime_pack(names, ^bytes, roots)
        if linked.errors.len() > 0 {
            cli_files.write("{prefix}.pack-issues", linked.errors.join("\n")) ?? return jet_driver_compile_escaped_failure("cannot write runtime pack findings: {err}")
            return jet_driver_compile_escaped_failure("runtime pack linking failed; see {prefix}.pack-issues")
        }
        cli_files.write_bytes(pack_path, linked.bytes) ?? return jet_driver_compile_escaped_failure("cannot write runtime pack: {err}")
    }
    result
}

// Names the Jet toolchain source tree: the directory that holds `Core/`. The
// Rust host embeds those bodies; the Jet host reads them from this tree.
JET_CLI_TOOLCHAIN_ROOT_ENV :: "JET_TOOLCHAIN_ROOT"
// This compiler's identity override (`name@version#<source id>`), for tests and
// for compilers built before the identity was embedded; else the embedded one.
JET_CLI_COMPILER_IDENTITY_ENV :: "JET_COMPILER_IDENTITY"

// The running compiler's identity: JET_COMPILER_IDENTITY when set, else the
// identity its assembly embedded (JET_CLI_BUILT_COMPILER_IDENTITY); None in an
// unassembled tree with no override.
fn jet_cli_compiler_identity() -> String? Never! {
    if cli_sys.get(JET_CLI_COMPILER_IDENTITY_ENV) == .Val(value) -> return Val(value)
    if JET_CLI_BUILT_COMPILER_IDENTITY == "" -> return None
    Val(JET_CLI_BUILT_COMPILER_IDENTITY)
}

// crates/jet-foundation/src/SHA256.rs `MAX_TREE_DEPTH`.
JET_CLI_MAX_TREE_DEPTH :: 256
JET_CLI_MAX_SOURCE_BYTES :: 536870912
JET_CLI_MAX_SOURCE_TOTAL :: 4294967296
JET_CLI_MAX_SOURCE_FILES :: 1000000

// A directory holding one of these is its own project, outside the walk
// (Authority.rs `has_nested_project_boundary`).
JET_CLI_PROJECT_MARKERS :: [String]{"package.jet", "pkg.jet", "workspace.jet", ".jet/lock"}

// Names the source walk never enters or reads (Authority.rs
// `discover_source_files_from`), besides every name that starts with `.`.
JET_CLI_SKIPPED_NAMES :: [String]{"target", "build", "node_modules", "bin"}

// Generated foreign-binding caches and the sidecars each binding may carry
// (Native.rs `collect_authorized_foreign_cache_files`).
JET_CLI_FOREIGN_CACHE_DIRECTORIES :: [String]{".jet/bindings/c", ".jet/bindings/cpp"}
JET_CLI_FOREIGN_CACHE_SIDECARS :: [String]{"metadata", "provenance"}

enum JetCLICompiled {
    // The driver ran; `snapshot` is the source snapshot it compiled, kept for
    // presenting diagnostics against the files that own them.
    Compiled(result: JetDriverCompileResult, snapshot: JetDriverAuthorizedSourceSnapshot)
    // The host could not assemble the request: write these bytes and exit.
    Refused(output: JetDriverVerbOutput)
}

fn jet_cli_refused(what: String, fix: String, color: Bool) -> JetCLICompiled Never! {
    JetCLICompiled.Refused{output: JetDriverVerbOutput{
        stdout: "",
        stderr: jet_cli_report("E2105", what, jet_cli_why("E2105"), fix, color),
        exit_code: JET_DRIVER_EXIT_USER_ERROR,
    }}
}

// `root` joined with a root-relative path (Loader.jet `jet_driver_authority_path`).
fn jet_cli_authority_path(root: String, relative: String) -> String Never! {
    if root == "/" -> return "/{relative}"
    "{root}/{relative}"
}

// Native.rs `identity_key` over Authority.rs `FileIdentity::from_metadata`.
// Directory identity is pinned to the opened object, not its mutable listing.
fn jet_cli_identity_key(kind: String, stat: cli_files.Stat) -> String Never! {
    if kind == "directory" -> return "authority-file-v1;kind=directory;length=0;modified_ns=none;device={stat.id.device};inode={stat.id.inode}"
    modified :: if stat.modified.to_unix_ns() == {
        .Ok(value) -> if value >= 0 -> "{value}" else -> "none"
        .Err(_) -> "none"
    }
    "authority-file-v1;kind={kind};length={stat.size};modified_ns={modified};device={stat.id.device};inode={stat.id.inode}"
}

fn jet_cli_is_project_boundary(directory: String) -[FS]> Bool Never! {
    loop marker in JET_CLI_PROJECT_MARKERS {
        marker_path :: "{directory}/{marker}"
        if cli_files.is_file(marker_path) || cli_files.is_symlink(marker_path) -> return true
    }
    false
}

// Authority.rs `discover_source_files_from`: entries in name order, so the
// files come out in relative-path order; a symlinked directory is skipped and
// any other symlink refused; dot names, build output, and nested projects stay
// out. With `retain_directories`, every walked directory's complete immediate
// listing (taken before those filters, empty directories included) goes to
// `directories` for App convention routing. Returns the problem that stopped
// the walk.
struct JetCLISourceBudget {
    entries: Int
    bytes: Int
    files: Int
}

fn jet_cli_source_read_limit(budget: JetCLISourceBudget, size: Int, path: String) -> Int JetCLIReadError! {
    if size > JET_CLI_MAX_SOURCE_BYTES -> return Err(jet_cli_read_error("`{path}` exceeds the {JET_CLI_MAX_SOURCE_BYTES}-byte file bound"))
    if budget.files >= JET_CLI_MAX_SOURCE_FILES -> return Err(jet_cli_read_error("authorized sources exceed the {JET_CLI_MAX_SOURCE_FILES}-file bound at `{path}`"))
    remaining :: JET_CLI_MAX_SOURCE_TOTAL - budget.bytes
    if size > remaining -> return Err(jet_cli_read_error("authorized sources exceed the {JET_CLI_MAX_SOURCE_TOTAL}-byte total bound at `{path}`"))
    Ok(if remaining < JET_CLI_MAX_SOURCE_BYTES -> remaining else -> JET_CLI_MAX_SOURCE_BYTES)
}

fn jet_cli_replace_source_budget(budget: &JetCLISourceBudget, before: String, after: String, path: String) -> Int JetCLIReadError! {
    replacement :: JetCLISourceBudget{entries: budget.entries, bytes: budget.bytes - before.count_bytes(), files: budget.files - 1}
    size :: after.count_bytes()
    _ :: jet_cli_source_read_limit(replacement, size, path)
    budget.bytes = replacement.bytes + size
    Ok(budget.bytes)
}

fn jet_cli_walk_sources(root: String, relative: String, depth: Int, files: &[JetDriverAuthorizedSourceFile], directories: &[AppAuthorizedDirectory], retain_directories: Bool, budget: &JetCLISourceBudget) -[FS]> String? Never! {
    directory :: if relative == "" -> root else -> jet_cli_authority_path(root, relative)
    chain := [cli_files.Directory]{}
    names := [String]{}
    initial :: jet_cli_hold_root_chain(directory, &chain, &names) ?? return Val(err.message)
    if jet_cli_build_read_chain_current(&chain, &names, initial) == .Err(problem) -> return Val(problem.message)
    if jet_cli_walk_held_sources(root, relative, depth, chain[chain.len() - 1], &files, &directories, retain_directories, &budget) == .Val(problem) -> return Val(problem)
    if jet_cli_build_read_chain_current(&chain, &names, initial) == .Err(problem) -> return Val(problem.message)
    None
}

fn jet_cli_walk_held_sources(root: String, relative: String, depth: Int, held: cli_files.Directory, files: &[JetDriverAuthorizedSourceFile], directories: &[AppAuthorizedDirectory], retain_directories: Bool, budget: &JetCLISourceBudget) -[FS]> String? Never! {
    directory :: if relative == "" -> root else -> jet_cli_authority_path(root, relative)
    listing :: held.list() ?? return Val("cannot list `{directory}`: {err}")
    if listing.len() > JET_CLI_MAX_SOURCE_FILES - budget.entries -> return Val("the source walk exceeds the {JET_CLI_MAX_SOURCE_FILES}-entry bound at `{directory}`")
    budget.entries += listing.len()
    if retain_directories {
        entries := [AppAuthorizedDirectoryEntry]{}
        loop entry in listing {
            &entries.push(AppAuthorizedDirectoryEntry{
                name: entry.name,
                path: jet_cli_authority_path(directory, entry.name),
                is_directory: entry.is_dir,
                name_is_unicode: entry.name_is_unicode,
            })
        }
        &directories.push(AppAuthorizedDirectory{path: directory, entries: entries})
    }
    loop entry in listing {
        name :: entry.name
        child :: if relative == "" -> name else -> "{relative}/{name}"
        path :: jet_cli_authority_path(root, child)
        if !entry.name_is_unicode {
            if name.ends_with(".jet") -> return Val("`{path}` has a non-Unicode source name")
            next
        }
        stat :: held.entry_stat(name) ?? return Val("cannot inspect `{path}`: {err}")
        if stat.is_symlink {
            // Reference source discovery skips directory links without reading
            // them; all other links are refused before name filtering.
            if cli_files.is_dir(path) -> next
            return Val("`{path}` is a symbolic link")
        }
        if name.starts_with(".") || JET_CLI_SKIPPED_NAMES.contains(name) -> next
        if stat.is_dir {
            child_held :: held.open_directory(name) ?? return Val("cannot open `{path}`: {err}")
            opened :: child_held.stat() ?? return Val("cannot inspect `{path}`: {err}")
            if opened.id != stat.id -> return Val("`{path}` changed while it was held")
            if jet_cli_held_project_boundary(child_held) == {
                .Ok(boundary) -> { if boundary -> next }
                .Err(problem) -> { return Val(problem.message) }
            }
            if depth >= JET_CLI_MAX_TREE_DEPTH -> return Val("the source walk exceeds the {JET_CLI_MAX_TREE_DEPTH}-level depth bound at `{path}`")
            if jet_cli_walk_held_sources(root, child, depth + 1, child_held, &files, &directories, retain_directories, &budget) == .Val(problem) -> return Val(problem)
            current :: held.entry_stat(name) ?? return Val("cannot inspect `{path}`: {err}")
            if !current.is_dir || current.is_symlink || current.id != stat.id -> return Val("`{path}` changed while it was held")
            next
        }
        if !name.ends_with(".jet") -> next
        if !stat.is_file -> return Val("`{path}` is not a regular file")
        limit :: jet_cli_source_read_limit(budget, stat.size, path) ?? return Val(err.message)
        read :: jet_cli_read_held_source(held, name, limit) ?? return Val("cannot read `{path}`: {err.message}")
        budget.bytes += read.stat.size
        budget.files += 1
        if !jet_cli_build_read_same_file(stat, read.stat) -> return Val("`{path}` changed while it was held")
        source :: String.from_bytes(^read.bytes) ?? return Val("cannot read `{path}`: file is not valid UTF-8")
        // A script (a `#!/...` launch line) is a standalone program wherever
        // it lives, never a member of the package around it.
        if jet_cli_is_script(source) -> next
        &files.push(JetDriverAuthorizedSourceFile{path: path, relative_path: child, identity: jet_cli_identity_key("file", read.stat), source: source})
    }
    None
}

fn jet_cli_held_project_boundary(directory: cli_files.Directory) -[FS]> Bool JetCLIReadError! {
    loop marker in JET_CLI_PROJECT_MARKERS {
        if marker == ".jet/lock" {
            info :: directory.entry_stat(".jet") ?? {
                if err == .NotFound(_) -> next
                return Err(jet_cli_read_error(jet_cli_io_error_text(err)))
            }
            if info.is_symlink -> return Ok(true)
            if !info.is_dir -> next
            nested :: directory.open_directory(".jet") ?? return Err(jet_cli_read_error(jet_cli_io_error_text(err)))
            lock :: nested.entry_stat("lock") ?? {
                if err == .NotFound(_) -> next
                return Err(jet_cli_read_error(jet_cli_io_error_text(err)))
            }
            if lock.is_file || lock.is_symlink -> return Ok(true)
        } else {
            info :: directory.entry_stat(marker) ?? {
                if err == .NotFound(_) -> next
                return Err(jet_cli_read_error(jet_cli_io_error_text(err)))
            }
            if info.is_file || info.is_symlink -> return Ok(true)
        }
    }
    Ok(false)
}

struct JetCLICacheSource {
    relative_path: String
    read: JetCLIHeldSource
}

// One checked foreign-cache record under `root` (a binding or its sidecar).
fn jet_cli_cache_file(root: String, relative: String, budget: &JetCLISourceBudget) -[FS]> JetCLICacheSource JetCLIReadError! {
    path :: jet_cli_authority_path(root, relative)
    stat :: cli_files.stat(path) ?? return Err(jet_cli_read_error("cannot inspect `{path}`: {err}"))
    if stat.is_symlink -> return Err(jet_cli_read_error("`{path}` is a symbolic link"))
    if !stat.is_file -> return Err(jet_cli_read_error("`{path}` is not a regular file"))
    limit :: jet_cli_source_read_limit(budget, stat.size, path)
    read :: jet_cli_read_rooted_source(root, relative, limit) ?? return Err(jet_cli_read_error("cannot read `{path}`: {err.message}"))
    if !jet_cli_build_read_same_file(stat, read.stat) -> return Err(jet_cli_read_error("`{path}` changed while it was held"))
    budget.bytes += read.stat.size
    budget.files += 1
    Ok(JetCLICacheSource{relative_path: relative, read: read})
}

// Native.rs `collect_authorized_foreign_cache_files`: every generated C and
// C++ binding (not the `.adapted.jet` views) with its `.metadata` and
// `.provenance` sidecars, in relative-path order.
fn jet_cli_foreign_cache_files(root: String, caches: &[JetDriverAuthorizedSourceFile], budget: &JetCLISourceBudget) -[FS]> String? Never! {
    collected := [JetCLICacheSource]{}
    loop cache_directory in JET_CLI_FOREIGN_CACHE_DIRECTORIES {
        directory :: jet_cli_authority_path(root, cache_directory)
        directory_info :: cli_files.stat(directory) ?? {
            if err == .NotFound(_) -> next
            return Val("cannot inspect `{directory}`: {err}")
        }
        if directory_info.is_symlink || !directory_info.is_dir -> return Val("`{directory}` is not a real directory")
        held :: jet_cli_rooted_open_root(directory) ?? return Val(err.message)
        held_info :: held.stat() ?? return Val("cannot inspect `{directory}`: {err}")
        if held_info.id != directory_info.id -> return Val("`{directory}` changed while it was held")
        entries :: held.list() ?? return Val("cannot list `{directory}`: {err}")
        if entries.len() > JET_CLI_MAX_SOURCE_FILES -> return Val("cache discovery exceeds the {JET_CLI_MAX_SOURCE_FILES}-entry bound")
        discovery := JetCLISourceBudget{entries: entries.len(), bytes: 0, files: 0}
        bindings := [JetCLICacheSource]{}
        loop entry in entries {
            if !entry.name_is_unicode -> return Val("`{directory}` contains a cache name that cannot be addressed as UTF-8")
            name :: entry.name
            relative :: "{cache_directory}/{name}"
            path :: jet_cli_authority_path(root, relative)
            stat :: held.entry_stat(name) ?? return Val("cannot inspect `{path}`: {err}")
            if stat.is_symlink -> return Val("`{path}` is a symbolic link")
            if !name.ends_with(".jet") -> next
            if !stat.is_file -> return Val("`{path}` is not a regular file")
            // discover_files validates every .jet, including hidden bindings
            // and adapted views, before its caller selects generated caches.
            limit := jet_cli_source_read_limit(discovery, stat.size, path) ?? return Val(err.message)
            adapted :: name.ends_with(".adapted.jet")
            if !adapted {
                shared_limit :: jet_cli_source_read_limit(budget, stat.size, path) ?? return Val(err.message)
                if shared_limit < limit -> limit = shared_limit
            }
            read :: jet_cli_read_held_source(held, name, limit) ?? return Val("cannot read `{path}`: {err.message}")
            if !jet_cli_build_read_same_file(stat, read.stat) -> return Val("`{path}` changed while it was held")
            discovery.bytes += read.stat.size
            discovery.files += 1
            if adapted -> next
            budget.bytes += read.stat.size
            budget.files += 1
            &bindings.push(JetCLICacheSource{relative_path: relative, read: read})
        }
        current :: cli_files.stat(directory) ?? return Val("cannot revalidate `{directory}`: {err}")
        if !current.is_dir || current.is_symlink || current.id != held_info.id -> return Val("`{directory}` changed while it was held")
        // The reference discovers all bindings first, then opens metadata and
        // provenance in that order. Convert UTF-8 only after final path sorting.
        loop binding in bindings {
            stem :: binding.relative_path.slice(0..<(binding.relative_path.len() - 4))
            loop extension in JET_CLI_FOREIGN_CACHE_SIDECARS {
                relative :: "{stem}.{extension}"
                path :: jet_cli_authority_path(root, relative)
                _ :: cli_files.stat(path) ?? {
                    if err == .NotFound(_) -> next
                    return Val("cannot inspect `{path}`: {err}")
                }
                sidecar :: jet_cli_cache_file(root, relative, &budget) ?? return Val(err.message)
                &collected.push(sidecar)
            }
            &collected.push(^binding)
        }
    }
    &collected.sort_by((left: JetCLICacheSource, right: JetCLICacheSource) -> left.relative_path <=> right.relative_path)
    loop file in collected {
        path :: jet_cli_authority_path(root, file.relative_path)
        source :: String.from_bytes(^file.read.bytes) ?? return Val("cannot read `{path}`: file is not valid UTF-8")
        &caches.push(JetDriverAuthorizedSourceFile{path: path, relative_path: file.relative_path, identity: jet_cli_identity_key("file", file.read.stat), source: source})
    }
    None
}

// Read dependency declarations from the bytes already in the snapshot, never
// by reopening the manifest. Inline Package carriers use the same model.
fn jet_cli_root_dependencies(root: JetDriverAuthorizedSourceRoot) -> [String: DepSpec] Never! {
    loop file in root.files {
        if file.relative_path != "package.jet" -> next
        manifest :: pkg_manifest_parse(file.path, file.source) ?? return [String: DepSpec]{}
        return manifest.dependencies
    }
    loop relative in JET_CLI_STOCK_ENTRIES {
        loop file in root.files {
            if file.relative_path != relative -> next
            inline :: if PackageFacts.parse_inline(file.source, file.path) == {
                .Ok(value) -> value
                .Err(_) -> { return [String: DepSpec]{} }
            }
            if inline == .Val(carrier) {
                manifest :: pkg_to_manifest(carrier.facts, file.source) ?? return [String: DepSpec]{}
                return manifest.dependencies
            }
        }
    }
    [String: DepSpec]{}
}

fn jet_cli_dependency_within(path: String, root: String) -> Bool Never! {
    path == root || path.starts_with(if root.ends_with("/") -> root else -> "{root}/")
}

// Loader.rs `RootPathReach`: the entry's relative declarations, canonicalized
// once, and the canonical sibling directories they open outside its tree.
struct JetCLIRootPathReach {
    declared: [String]
    sibling_dirs: [String]
}

fn jet_cli_root_path_reach(entry: String, dependencies: [String: DepSpec]) -[FS]> JetCLIRootPathReach Never! {
    declared := [String]{}
    sibling_dirs := [String]{}
    loop spec in dependencies.values() {
        if spec == .Path(relative) {
            if relative.starts_with("/") -> next
            canonical :: cli_files.realpath(jet_cli_report_path(Val(entry), relative)) ?? next
            &declared.push(canonical)
            if !jet_cli_dependency_within(canonical, entry) {
                sibling_parent :: jet_cli_parent(canonical) ?? "/"
                if !sibling_dirs.contains(sibling_parent) -> &sibling_dirs.push(sibling_parent)
            }
        }
    }
    JetCLIRootPathReach{declared: declared, sibling_dirs: sibling_dirs}
}

// Test the canonical target, never a textual symlink alias.
// Check before reading the target tree.
fn jet_cli_path_dependency_reachable(canonical: String, reach: JetCLIRootPathReach) -> Bool Never! {
    if reach.declared.contains(canonical) -> return true
    loop sibling_parent in reach.sibling_dirs {
        if jet_cli_dependency_within(canonical, sibling_parent) -> return true
    }
    false
}

fn jet_cli_path_dependency_escape(name: String, relative: String, parent: String, color: Bool) -> JetDriverVerbOutput Never! {
    JetDriverVerbOutput{stdout: "", stderr: jet_cli_report("E1206", "path dependency `{name}` escapes its parent package", "the path `{relative}` resolves outside the declaring package directory `{parent}`", "use a relative path below the declaring package directory", color), exit_code: JET_DRIVER_EXIT_USER_ERROR}
}

// Authorize each path root once, in dependency-name order. The driver's
// catalog still owns dependency binding and semantic diagnostics; this host
// only reads trees the declared graph permits. No provider or network is run.
fn jet_cli_path_dependency_roots(roots: &[JetDriverAuthorizedSourceRoot], color: Bool) -[FS, Env]> JetDriverVerbOutput? Never! {
    entry :: roots[0].canonical_path
    root_reach :: jet_cli_root_path_reach(entry, jet_cli_root_dependencies(roots[0]))
    index := 0
    loop index < roots.len() {
        parent :: roots[index].canonical_path
        dependencies :: jet_cli_root_dependencies(roots[index])
        names := dependencies.keys().to_list()
        &names.sort()
        loop name in names {
            if dependencies[name] == .Path(relative) {
                path :: jet_cli_report_path(Val(parent), relative)
                canonical :: cli_files.realpath(path) ?? ""
                declared_by_root :: !relative.starts_with("/") && canonical != "" && jet_cli_path_dependency_reachable(canonical, root_reach)
                if index != 0 && !declared_by_root && (relative.starts_with("/") || !jet_cli_dependency_within(path, parent)) {
                    return Val(jet_cli_path_dependency_escape(name, relative, parent, color))
                }
                // A missing target stays unbound: the driver emits E0603 at
                // the declaration rather than a host filesystem diagnostic.
                if canonical == "" -> next
                if index != 0 && !declared_by_root && !jet_cli_dependency_within(canonical, parent) {
                    return Val(jet_cli_path_dependency_escape(name, relative, parent, color))
                }
                found := false
                loop existing in roots {
                    if existing.canonical_path == canonical -> found = true
                }
                if found -> next
                stat :: cli_files.stat(canonical) ?? next
                if !stat.is_dir -> next
                files := [JetDriverAuthorizedSourceFile]{}
                directories := [AppAuthorizedDirectory]{}
                caches := [JetDriverAuthorizedSourceFile]{}
                budget := JetCLISourceBudget{entries: 0, bytes: 0, files: 0}
                if jet_cli_walk_sources(canonical, "", 0, &files, &directories, true, &budget) == .Val(problem) {
                    return Val(JetDriverVerbOutput{stdout: "", stderr: jet_cli_report("E2105", "can't securely read the sources under `{canonical}`: {problem}", jet_cli_why("E2105"), "remove the symbolic link or unreadable file, or check a file outside this tree", color), exit_code: JET_DRIVER_EXIT_USER_ERROR})
                }
                if jet_cli_foreign_cache_files(canonical, &caches, &budget) == .Val(problem) {
                    return Val(JetDriverVerbOutput{stdout: "", stderr: jet_cli_report("E2105", "can't securely read the foreign bindings under `{canonical}`: {problem}", jet_cli_why("E2105"), "remove the symbolic link or unreadable file, or regenerate the bindings with `jet bind`", color), exit_code: JET_DRIVER_EXIT_USER_ERROR})
                }
                &roots.push(JetDriverAuthorizedSourceRoot{canonical_path: canonical, identity: jet_cli_identity_key("directory", stat), allow_hardlinks: false, files: files, foreign_cache_files: caches, directories: directories})
            }
        }
        index += 1
    }
    None
}

// The nearest directory at or above `entry_path` that holds `package.jet`, or
// the entry's own directory for a loose file.
fn jet_cli_source_root(entry_path: String) -[FS]> String Never! {
    start :: jet_cli_parent(entry_path) ?? "/"
    current := start
    loop {
        if cli_files.is_file(jet_cli_authority_path(current, "package.jet")) -> return current
        if current == "/" -> return start
        current = jet_cli_parent(current) ?? return start
    }
}

// Layout.rs `TargetLayout::host_triple`.
fn jet_cli_host_triple(arch: String, os: String) -> String Never! {
    known_arch :: arch == "x86_64" || arch == "aarch64"
    if os == "linux" && known_arch -> return "{arch}-unknown-linux-gnu"
    if os == "windows" && known_arch -> return "{arch}-pc-windows-msvc"
    if os == "macos" && known_arch -> return "{arch}-apple-darwin"
    if os == "wasi" -> return "{arch}-wasi"
    "{arch}-unknown-{os}"
}

// The memory free for new work, in bytes: Linux `/proc/meminfo`
// `MemAvailable` (kB), lowered to the tightest cgroup v2 headroom
// (`memory.max - memory.current`) of this process's cgroup and its
// ancestors, so a capped run never admits threads its cap cannot hold;
// `None` where the host cannot tell.
fn jet_cli_memory_available() -[FS]> Int? Never! {
    available := jet_cli_meminfo_available() ?? return None
    membership :: cli_files.read("/proc/self/cgroup") ?? return Val(available)
    path := ""
    loop line in membership.lines() {
        if line.starts_with("0::") -> path = line.slice(3..<line.len())
    }
    loop {
        directory :: "/sys/fs/cgroup{path}"
        limit :: jet_cli_cgroup_bytes("{directory}/memory.max")
        used :: jet_cli_cgroup_bytes("{directory}/memory.current")
        if limit == .Val(max) && used == .Val(current) {
            headroom :: if max > current -> max - current else -> 0
            if headroom < available -> available = headroom
        }
        if path == "" || path == "/" -> break
        cut := path.len() - 1
        loop cut > 0 && path.slice(cut..<(cut + 1)) != "/" -> cut -= 1
        path = path.slice(0..<cut)
    }
    Val(available)
}

fn jet_cli_meminfo_available() -[FS]> Int? Never! {
    text :: cli_files.read("/proc/meminfo") ?? return None
    loop line in text.lines() {
        if !line.starts_with("MemAvailable:") -> next
        loop word in line.slice(13..<line.len()).split(" ") {
            if word == "" -> next
            kilobytes :: Int.parse(word) ?? return None
            return Val(kilobytes * 1024)
        }
    }
    None
}

// One cgroup v2 byte count (`memory.max`, `memory.current`); `None` when the
// file is missing or holds `max` (no limit).
fn jet_cli_cgroup_bytes(file: String) -[FS]> Int? Never! {
    text :: cli_files.read(file) ?? return None
    bytes :: Int.parse(text.trim()) ?? return None
    Val(bytes)
}

// The Core library rows with their bodies, read from the toolchain tree that
// `JET_TOOLCHAIN_ROOT` names, or the refusal that stops the request.
enum JetCLICoreSources {
    Loaded(sources: [JetDriverCoreSource])
    Missing(what: String, fix: String)
}

fn jet_cli_core_sources() -> JetCLICoreSources Never! {
    toolchain :: cli_sys.get(JET_CLI_TOOLCHAIN_ROOT_ENV) ?? return JetCLICoreSources.Missing{what: "`{JET_CLI_TOOLCHAIN_ROOT_ENV}` is not set, so the Core library sources can't be found", fix: "set `{JET_CLI_TOOLCHAIN_ROOT_ENV}` to the Jet toolchain source tree, the directory that holds `Core/`"}
    core_sources := [JetDriverCoreSource]{}
    loop row in CORE_SOURCE_OWNED_ROWS {
        core_path :: jet_cli_authority_path(toolchain, row.path)
        body :: cli_files.read(core_path) ?? return JetCLICoreSources.Missing{what: "can't read the Core library source `{core_path}`", fix: "set `{JET_CLI_TOOLCHAIN_ROOT_ENV}` to the Jet toolchain source tree, the directory that holds `Core/`"}
        &core_sources.push(JetDriverCoreSource{module_name: row.module_name, alias: row.alias, path: row.path, owner: row.owner, owned_members: row.owned_members, runtime: row.runtime, source: body})
    }
    JetCLICoreSources.Loaded{sources: core_sources}
}

// The driver request for `snapshot` on this host: the Core rows, the
// canonical effect source, the host facts, and at most `threads` compiler
// threads (`None` admits threads automatically).
fn jet_cli_driver_request(snapshot: JetDriverAuthorizedSourceSnapshot, core_sources: [JetDriverCoreSource], threads: Int?, mode: JetDriverCompileMode) -> JetDriverCompileRequest Never! {
    os :: cli_sys.name()
    JetDriverCompileRequest{
        authorized_sources: snapshot,
        canonical_effect_source: JET_CLI_EFFECT_SOURCE,
        core_sources: core_sources,
        host_facts: JetDriverHostFacts{target_triple: Val(jet_cli_host_triple(cli_sys.arch(), os)), active_os: Val(os), compiler_identity: jet_cli_compiler_identity()},
        eval_config: jet_eval_host_config(),
        target: JetDriverCompileTarget.Native,
        record_store: None,
        trace_sink: None,
        // Dev verification knob (the bootstrap host's
        // JET_BOOTSTRAP_MIR_LINT_EVERY_PASS): JET_MIR_LINT_EVERY_PASS=1 checks
        // legality and MIR Lint after every optimizer pass, and a failure names
        // the pass and carries the rejected function's MIR.
        mir_lint_every_pass: (cli_sys.get("JET_MIR_LINT_EVERY_PASS") ?? "") == "1",
        compiler_threads: CompilerThreads{cap: threads, cores: cli_sys.cpu_count(), memory_available: jet_cli_memory_available()},
        mode: mode,
        build_inputs: Val(jet_driver_shared_build_inputs(JetCLIBuildInputs{})),
        build_http_inputs: Val(jet_driver_shared_build_http_inputs(JetCLIBuildHTTPInputs{})),
    }
}

// The CLI's raw build-input transport for checked `fn build` input services:
// filesystem facts only. The driver's build adapter owns the path law, glob
// matching, pins, decoding and every diagnostic; an error is the failed
// operation's own text.
struct JetCLIBuildInputs {}

impl JetCLIBuildInputs.JetDriverBuildInputs {
    fn resolve(self, path: String) -[FS.Read]> JetDriverBuildPath JetDriverBuildInputError! {
        resolved :: jet_cli_build_resolve(path) ?? return Err(JetDriverBuildInputError{message: err.message})
        Ok(resolved)
    }
    fn entries(self, directory: String) -[FS.Read]> [JetDriverBuildEntry] JetDriverBuildInputError! {
        listed :: cli_files.list_dir(directory) ?? return Err(JetDriverBuildInputError{message: jet_cli_io_error_text(err)})
        out := [JetDriverBuildEntry]{}
        loop entry in listed {
            info :: cli_files.stat(jet_cli_entry_join(directory, entry.name)) ?? return Err(JetDriverBuildInputError{message: jet_cli_io_error_text(err)})
            &out.push(JetDriverBuildEntry{name: entry.name, directory: info.is_dir && !info.is_symlink, file: info.is_file && !info.is_symlink})
        }
        Ok(out)
    }
    fn read(self, path: String, limit: Int) -[FS.Read]> [U8] JetDriverBuildInputError! {
        if limit < 0 || limit > 536870912 -> return Err(JetDriverBuildInputError{message: "file read bound exceeds the tree hashing bound"})
        expected :: cli_files.stat(path) ?? return Err(JetDriverBuildInputError{message: jet_cli_io_error_text(err)})
        if expected.is_symlink || !expected.is_file -> return Err(JetDriverBuildInputError{message: "file is not a regular file"})
        reader :: cli_files.open(path, .Refuse) ?? return Err(JetDriverBuildInputError{message: jet_cli_io_error_text(err)})
        opened :: reader.stat() ?? return Err(JetDriverBuildInputError{message: jet_cli_io_error_text(err)})
        if !opened.is_file || expected.id != opened.id || expected.size != opened.size || expected.modified != opened.modified || expected.changed != opened.changed -> return Err(JetDriverBuildInputError{message: "file changed before reading"})
        if expected.size > limit -> return Err(JetDriverBuildInputError{message: "file exceeds its read bound"})
        bytes := [U8]{}
        &bytes.try_reserve(if expected.size < 65536 -> expected.size else -> 65536) ?? return Err(JetDriverBuildInputError{message: "cannot reserve file read buffer: {err}"})
        loop {
            remaining :: limit + 1 - bytes.len()
            chunk :: reader.read(if remaining < 65536 -> remaining else -> 65536) ?? return Err(JetDriverBuildInputError{message: jet_cli_io_error_text(err)})
            if chunk.len() == 0 -> break
            &bytes.extend(chunk)
            if bytes.len() > limit -> return Err(JetDriverBuildInputError{message: "file exceeds its read bound"})
        }
        after :: reader.stat() ?? return Err(JetDriverBuildInputError{message: jet_cli_io_error_text(err)})
        path_after :: cli_files.stat(path) ?? return Err(JetDriverBuildInputError{message: jet_cli_io_error_text(err)})
        if !after.is_file || !path_after.is_file || expected.id != after.id || expected.id != path_after.id || expected.size != after.size || expected.size != path_after.size || expected.modified != after.modified || expected.modified != path_after.modified || expected.changed != after.changed || expected.changed != path_after.changed || bytes.len() != expected.size {
            return Err(JetDriverBuildInputError{message: "file changed while reading"})
        }
        Ok(bytes)
    }
    fn read_rooted(self, root: String, relative: String, limit: Int) -[FS.Read]> [U8] JetDriverBuildInputError! {
        bytes :: jet_cli_build_read_rooted(root, relative, limit) ?? return Err(JetDriverBuildInputError{message: err.message})
        Ok(bytes)
    }
}

// CheckReads::read_nofollow_at_root's raw transport. Keep every directory
// pinned and recheck its parent entry; no canonicalize-then-read window can
// follow a replaced intermediate component outside the authorized build root.
fn jet_cli_build_read_rooted(root: String, relative: String, limit: Int) -[FS.Read]> [U8] JetCLIReadError! {
    read :: jet_cli_read_rooted_source(root, relative, limit)
    Ok(^read.bytes)
}

struct JetCLIHeldSource {
    bytes: [U8]
    stat: cli_files.Stat
}

fn jet_cli_read_rooted_source(root: String, relative: String, limit: Int) -[FS.Read]> JetCLIHeldSource JetCLIReadError! {
    if limit < 0 || limit > JET_CLI_MAX_SOURCE_BYTES -> return Err(jet_cli_read_error("file read bound exceeds the tree hashing bound"))
    if relative.starts_with("/") -> return Err(jet_cli_read_error("file authority path must be relative and normalized"))
    parts := [String]{}
    loop part in relative.split("/") {
        if part == "" || part == "." -> next
        if part == ".." -> return Err(jet_cli_read_error("file authority path must be relative and normalized"))
        loop byte in part.bytes() {
            if byte == (U8{0}) -> return Err(jet_cli_read_error("file authority path contains NUL"))
        }
        &parts.push(part)
    }
    directories := [cli_files.Directory]{}
    names := [String]{}
    initial :: jet_cli_hold_root_chain(root, &directories, &names)
    if parts.len() == 0 -> return Err(jet_cli_read_error("file authority path is empty"))
    loop index in 0..<(parts.len() - 1) {
        opened :: directories[directories.len() - 1].open_directory(parts[index]) ?? return Err(jet_cli_build_rooted_open_error(err))
        &directories.push(opened)
        &names.push(parts[index])
    }
    name :: parts[parts.len() - 1]
    if jet_cli_build_read_chain_current(&directories, &names, initial) == .Err(error) -> return Err(error)
    read :: jet_cli_read_held_source(directories[directories.len() - 1], name, limit)
    if jet_cli_build_read_chain_current(&directories, &names, initial) == .Err(_) -> return Err(jet_cli_read_error("file changed while it was being read"))
    Ok(read)
}

fn jet_cli_hold_root_chain(root: String, directories: &[cli_files.Directory], names: &[String]) -[FS.Read]> String JetCLIReadError! {
    initial :: if root.starts_with("/") -> "/" else -> "."
    &directories.push(cli_files.open_directory(initial) ?? return Err(jet_cli_read_error(jet_cli_io_error_text(err))))
    loop part in root.split("/") {
        if part == "" || part == "." -> next
        if part == ".." -> return Err(jet_cli_read_error("file authority root must not contain parent components"))
        loop byte in part.bytes() {
            if byte == (U8{0}) -> return Err(jet_cli_read_error("file authority path contains NUL"))
        }
        opened :: directories[directories.len() - 1].open_directory(part) ?? return Err(jet_cli_build_rooted_open_error(err))
        &directories.push(opened)
        &names.push(part)
    }
    Ok(initial)
}

// Both source snapshots and build input reads consume this same opened file.
// The stat in the snapshot therefore describes exactly the bytes read.
fn jet_cli_read_held_source(directory: cli_files.Directory, name: String, limit: Int) -[FS.Read]> JetCLIHeldSource JetCLIReadError! {
    if limit < 0 || limit > JET_CLI_MAX_SOURCE_BYTES -> return Err(jet_cli_read_error("file read bound exceeds the tree hashing bound"))
    reader :: directory.open(name) ?? return Err(jet_cli_build_rooted_open_error(err))
    expected :: reader.stat() ?? return Err(jet_cli_read_error(jet_cli_io_error_text(err)))
    if !expected.is_file -> return Err(jet_cli_read_error("file authority input is not a regular file"))
    if expected.links != 1 -> return Err(jet_cli_read_error("file authority input has multiple hard links"))
    current :: directory.entry_stat(name) ?? return Err(jet_cli_read_error(jet_cli_io_error_text(err)))
    if !current.is_file -> return Err(jet_cli_read_error("file authority input is not a regular file"))
    if current.links != 1 -> return Err(jet_cli_read_error("file authority input has multiple hard links"))
    if !jet_cli_build_read_same_file(expected, current) -> return Err(jet_cli_read_error("file authority input moved while it was held"))
    if expected.size > limit -> return Err(jet_cli_read_error("file exceeds its read bound"))
    bytes := [U8]{}
    &bytes.try_reserve(if expected.size < 65536 -> expected.size else -> 65536) ?? return Err(jet_cli_read_error("cannot reserve file read buffer: {err}"))
    loop {
        remaining :: limit + 1 - bytes.len()
        chunk :: reader.read(if remaining < 65536 -> remaining else -> 65536) ?? return Err(jet_cli_read_error(jet_cli_io_error_text(err)))
        if chunk.len() == 0 -> break
        &bytes.extend(chunk)
        if bytes.len() > limit -> return Err(jet_cli_read_error("file exceeds its read bound"))
    }
    after :: reader.stat() ?? return Err(jet_cli_read_error(jet_cli_io_error_text(err)))
    path_after :: directory.entry_stat(name) ?? return Err(jet_cli_read_error("file changed while it was being read"))
    if !jet_cli_build_read_same_file(expected, after) || !jet_cli_build_read_same_file(expected, path_after) || after.size != bytes.len() {
        return Err(jet_cli_read_error("file changed while it was being read"))
    }
    Ok(JetCLIHeldSource{bytes: bytes, stat: expected})
}

fn jet_cli_build_read_same_file(left: cli_files.Stat, right: cli_files.Stat) -> Bool Never! {
    right.is_file && right.links == 1 && left.id == right.id && left.size == right.size && left.modified == right.modified && left.changed == right.changed
}

fn jet_cli_build_read_chain_current(directories: &[cli_files.Directory], names: &[String], initial: String) -[FS.Read]> Bool JetCLIReadError! {
    base :: cli_files.stat(initial) ?? return Err(jet_cli_read_error(jet_cli_io_error_text(err)))
    held_base :: directories[0].stat() ?? return Err(jet_cli_read_error(jet_cli_io_error_text(err)))
    if !base.is_dir || base.is_symlink || base.id != held_base.id -> return Err(jet_cli_read_error("file authority directory moved while it was held"))
    loop index in 0..<names.len() {
        named :: directories[index].entry_stat(names[index]) ?? return Err(jet_cli_read_error(jet_cli_io_error_text(err)))
        held :: directories[index + 1].stat() ?? return Err(jet_cli_read_error(jet_cli_io_error_text(err)))
        if !named.is_dir || named.is_symlink || named.id != held.id -> return Err(jet_cli_read_error("file authority directory moved while it was held"))
    }
    Ok(true)
}

fn jet_cli_build_rooted_open_error(error: IOError) -> JetCLIReadError Never! {
    message :: jet_cli_io_error_text(error)
    jet_cli_read_error(if message.ends_with("(os error 40)") || message.ends_with("(os error 62)") -> "file authority path contains a symlink" else -> message)
}

// Where absolute `path` resolves with every link followed (fs::canonicalize
// over lstat/readlink): a missing component is `exists: false`; a link chain
// longer than the system's 40 is ELOOP.
fn jet_cli_build_resolve(path: String) -[FS.Read]> JetDriverBuildPath JetCLIReadError! {
    pending := path.split("/").to_list()
    index := 0
    resolved := ""
    followed := 0
    loop index < pending.len() {
        part :: pending[index]
        index += 1
        if part == "" || part == "." -> next
        if part == ".." {
            parts := resolved.split("/").to_list()
            _ := &parts.pop()
            resolved = parts.join("/")
            next
        }
        candidate :: "{resolved}/{part}"
        info :: cli_files.stat(candidate) ?? {
            if err == .NotFound(_) -> return Ok(JetDriverBuildPath{exists: false, path: candidate, file: false, links: 0})
            return Err(jet_cli_read_error(jet_cli_io_error_text(err)))
        }
        if !info.is_symlink {
            resolved = candidate
            next
        }
        followed += 1
        if followed > 40 -> return Err(jet_cli_read_error("Too many levels of symbolic links (os error 40)"))
        target :: cli_files.read_link(candidate) ?? return Err(jet_cli_read_error(jet_cli_io_error_text(err)))
        spliced :: if target.starts_with("/") -> target else -> "{resolved}/{target}"
        rest := spliced.split("/").to_list()
        loop remaining in index..<pending.len() -> &rest.push(pending[remaining])
        pending = rest
        index = 0
        resolved = ""
    }
    final :: if resolved == "" -> "/" else -> resolved
    info :: cli_files.stat(final) ?? return Err(jet_cli_read_error(jet_cli_io_error_text(err)))
    Ok(JetDriverBuildPath{exists: true, path: final, file: info.is_file, links: info.links})
}

// Build the request for `file` (the entry as the user named it) and run the
// Jet compiler on it in `mode` with at most `threads` compiler threads
// (`--threads N`; `None` admits threads automatically). `emit_rust` asks for
// explicit Rust emission queries; native builds/runs/tests stop at checked MIR
// with the same diagnostics, then use the native backend's existing optimizer.
// Untraced: only the compiling verbs trace (`jet_cli_compile_entry`).
// `jet_driver_compile` declares no effect row or failure (its Eval host
// adapter makes dynamic calls with no effect bound), so this function and the
// host verbs above it stay unannotated, like the bootstrap entry
// (Compiler/Bootstrap/Host/Entry.jet).
fn jet_cli_compile_file(file: String, color: Bool, emit_rust: Bool, threads: Int?, mode: JetDriverCompileMode) -> JetCLICompiled {
    jet_cli_compile_entry(file, color, emit_rust, threads, mode, None, None)
}

// One file's bytes as a compile sees them in place of the disk copy, or as a
// new source file beside it; nothing is written.
struct JetCLIOverlay {
    path: String
    source: String
}

// `jet_cli_compile_file` with the entry file's bytes replaced by
// `entry_source` when given (`jet fmt --explicit-copies` asks sema about a
// policy-marked copy of the entry; nothing is written), traced through
// `trace_sink`: the process's one sink, which `jet_cli_main` opens for
// `build`, `run`, `check`, `test` and `emit` (`--trace`, JET_TRACE_FILE).
fn jet_cli_compile_entry(file: String, color: Bool, emit_rust: Bool, threads: Int?, mode: JetDriverCompileMode, entry_source: String?, trace_sink: JetCLITraceSink?) -> JetCLICompiled {
    overlays := [JetCLIOverlay]{}
    if entry_source == .Val(replacement) -> &overlays.push(JetCLIOverlay{path: file, source: replacement})
    jet_cli_compile_overlays(file, file, overlays, color, emit_rust, threads, mode, trace_sink)
}

// An overlay or entry path as the snapshot spells it: the canonical path of a
// file that exists, else the lexically absolute path (Report.jet
// `jet_cli_report_path`).
fn jet_cli_overlay_path(path: String) -[FS, Env]> String Never! {
    canonical :: cli_files.realpath(path) ?? return jet_cli_report_path(jet_cli_report_cwd(), path)
    canonical
}

// Whether root-relative `left` comes before `right` in the walk's order:
// component by component, by bytes (`/` sorts before every name byte).
fn jet_cli_relative_precedes(left: String, right: String) -> Bool Never! {
    a :: left.bytes()
    b :: right.bytes()
    loop index in 0..<a.len() {
        if index >= b.len() -> return false
        if a[index] != b[index] {
            if a[index] == 47 -> return true
            if b[index] == 47 -> return false
            return a[index] < b[index]
        }
    }
    a.len() < b.len()
}

// Whether root-relative `relative` lies where the source walk does not reach:
// a dot or skipped name, or under a symbolic link or nested project.
fn jet_cli_outside_walk(root: String, relative: String) -[FS]> Bool Never! {
    directory := root
    loop name in relative.split("/") {
        if name == "" || name.starts_with(".") || JET_CLI_SKIPPED_NAMES.contains(name) -> return true
        if directory != root {
            if cli_files.is_symlink(directory) || jet_cli_is_project_boundary(directory) -> return true
        }
        directory = jet_cli_authority_path(directory, name)
    }
    false
}

// `files` with `added` placed at its root-relative position in walk order.
fn jet_cli_insert_source(files: ^[JetDriverAuthorizedSourceFile], added: JetDriverAuthorizedSourceFile) -> [JetDriverAuthorizedSourceFile] Never! {
    ordered := [JetDriverAuthorizedSourceFile]{}
    &ordered.try_reserve(files.len() + 1) ?? panic("cannot reserve the authorized source ordering: {err}")
    placed := false
    loop file in files {
        if !placed && jet_cli_relative_precedes(added.relative_path, file.relative_path) {
            &ordered.push(added)
            placed = true
        }
        &ordered.push(file)
    }
    if !placed -> &ordered.push(added)
    ordered
}

// A prepared compile: the authorized request and the snapshot it holds, or
// the refusal that stopped preparing it.
enum JetCLIPrepared {
    Prepared(request: JetDriverCompileRequest, snapshot: JetDriverAuthorizedSourceSnapshot)
    Refused(output: JetDriverVerbOutput)
}

// The authorized source snapshot of a compile, before the Core sources join
// it, or the refusal that stopped taking it.
enum JetCLISnapshotted {
    Held(snapshot: JetDriverAuthorizedSourceSnapshot)
    Refused(output: JetDriverVerbOutput)
}

fn jet_cli_prepare_refused(what: String, fix: String, color: Bool) -> JetCLIPrepared Never! {
    JetCLIPrepared.Refused{output: jet_cli_prepare_refusal(what, fix, color)}
}

fn jet_cli_snapshot_refused(what: String, fix: String, color: Bool) -> JetCLISnapshotted Never! {
    JetCLISnapshotted.Refused{output: jet_cli_prepare_refusal(what, fix, color)}
}

fn jet_cli_prepare_refusal(what: String, fix: String, color: Bool) -> JetDriverVerbOutput Never! {
    JetDriverVerbOutput{
        stdout: "",
        stderr: jet_cli_report("E2105", what, jet_cli_why("E2105"), fix, color),
        exit_code: JET_DRIVER_EXIT_USER_ERROR,
    }
}

// The checked sources under `anchor`'s source root with `overlays` laid over
// them, compiled with `entry` as the entry. An overlay replaces the bytes of a
// walked file, or adds an absent `.jet` file the walk would have read; the
// source loader and its authorization stay the one in this file.
fn jet_cli_compile_overlays(anchor: String, entry: String, overlays: [JetCLIOverlay], color: Bool, emit_rust: Bool, threads: Int?, mode: JetDriverCompileMode, trace_sink: JetCLITraceSink?) -> JetCLICompiled {
    jet_cli_compile_for_target(anchor, entry, overlays, color, emit_rust, threads, mode, JetDriverCompileTarget.Native, false, trace_sink)
}

// Sandbox and native targets use the same authorized source snapshot. The
// source walk is the `sources` span; the request carries `trace_sink` into
// the driver's phases, and its result back to the native backend.
// `release` is Rust CmdCompile `select_native_profile` for `--release` (or
// `--profile release`): the compile runs under the `release` profile, whose
// MIR artifact mode is Release (Driver `mir_artifact_build_mode_for`).
fn jet_cli_compile_for_target(anchor: String, entry: String, overlays: [JetCLIOverlay], color: Bool, emit_rust: Bool, threads: Int?, mode: JetDriverCompileMode, target: JetDriverCompileTarget, release: Bool, trace_sink: JetCLITraceSink?) -> JetCLICompiled {
    if trace_sink == .Val(sink) -> sink.begin("sources", "", -1, -1)
    prepared :: jet_cli_prepare_overlays(anchor, entry, overlays, color, threads, mode)
    if trace_sink == .Val(sink) -> sink.end("sources", jet_cli_prepared_file_count(prepared))
    jet_cli_compile_prepared(^prepared, emit_rust, target, release, None, trace_sink)
}

// How many source files a prepared compile authorizes; -1 for a refusal.
fn jet_cli_prepared_file_count(prepared: JetCLIPrepared) -> Int Never! {
    if prepared == {
        .Prepared(_, snapshot) -> jet_cli_snapshot_file_count(snapshot)
        .Refused(_) -> -1
    }
}

// Compile `prepared` for `target` (`jet_cli_compile_for_target`).
// `input_log`, when given, records every comptime input file the compile
// reads (`embed_file`, `embed_bytes`, `find`).
fn jet_cli_compile_prepared(prepared: ^JetCLIPrepared, emit_rust: Bool, target: JetDriverCompileTarget, release: Bool, input_log: Shared<JetDriverComptimeInputLog>?, trace_sink: JetCLITraceSink?) -> JetCLICompiled {
    if ^prepared == {
        .Refused(output) -> JetCLICompiled.Refused{output: output}
        .Prepared(request, snapshot) -> {
            selected := request
            selected.target = target
            selected.trace_sink = jet_cli_trace_boxed(trace_sink)
            // copy: the caller keeps its handle on the one shared log.
            selected.comptime_input_log = input_log.copy()
            if release {
                selected.profile = "release"
                selected.build_mode = MIRArtifactBuildMode.Release
            }
            library_prefix :: if target == .Native -> cli_sys.get("JET_FRONT_LIBRARY_OBJECT_OUTPUT") else -> None
            // copy: a three-field row; the request moves into the compiler below.
            compiler_threads :: selected.compiler_threads.copy()
            result := jet_cli_compile_request(^selected, emit_rust && library_prefix == None, trace_sink)
            if library_prefix == .Val(prefix) -> result = jet_cli_runtime_library(^result, prefix)
            // The host's phases after the compile (Host.jet's native backend
            // route) trace through the same sink, which the result carries,
            // and compile on the request's threads.
            result.trace_sink = jet_cli_trace_boxed(trace_sink)
            result.compiler_threads = compiler_threads
            JetCLICompiled.Compiled{result: result, snapshot: snapshot}
        }
    }
}

// How many source files the snapshot authorizes, over every root.
fn jet_cli_snapshot_file_count(snapshot: JetDriverAuthorizedSourceSnapshot) -> Int Never! {
    count := 0
    loop root in snapshot.roots -> count += root.files.len()
    count
}

// The authorized request `jet_cli_compile_overlays` compiles, without
// compiling it: load-only queries (schema, source explain, gates) run the
// driver's source query over exactly the sources a compile would see.
fn jet_cli_prepare_overlays(anchor: String, entry: String, overlays: [JetCLIOverlay], color: Bool, threads: Int?, mode: JetDriverCompileMode) -> JetCLIPrepared {
    if jet_cli_prepare_snapshot(anchor, entry, overlays, color) == {
        .Refused(output) -> JetCLIPrepared.Refused{output: output}
        .Held(snapshot) -> jet_cli_prepare_request(snapshot, color, threads, mode)
    }
}

// The request that compiles `snapshot` against the Core sources of this toolchain.
fn jet_cli_prepare_request(snapshot: JetDriverAuthorizedSourceSnapshot, color: Bool, threads: Int?, mode: JetDriverCompileMode) -> JetCLIPrepared {
    core_sources :: if jet_cli_core_sources() == {
        .Loaded(sources) -> sources
        .Missing(what, fix) -> { return jet_cli_prepare_refused(what, fix, color) }
    }
    JetCLIPrepared.Prepared{request: jet_cli_driver_request(snapshot, core_sources, threads, mode), snapshot: snapshot}
}

// Whether the entry at `entry_path` (or its overlay) is a script: its first
// line is a `#!/...` launch line (Authority.jet `jet_cli_is_script`).
fn jet_cli_entry_is_script(entry_path: String, overlays: [JetCLIOverlay]) -[FS, Env]> Bool Never! {
    loop overlay in overlays {
        if jet_cli_overlay_path(overlay.path) == entry_path -> return jet_cli_is_script(overlay.source)
    }
    reader :: cli_files.open(entry_path, .Refuse) ?? return false
    head :: reader.read(3) ?? return false
    head == "#!/".bytes()
}

// The authorized source snapshot `jet_cli_prepare_overlays` compiles. A script
// is a standalone program wherever it lives: its snapshot is the script alone,
// rooted at its own directory, never the package around it.
fn jet_cli_prepare_snapshot(anchor: String, entry: String, overlays: [JetCLIOverlay], color: Bool) -> JetCLISnapshotted {
    anchor_path :: cli_files.realpath(anchor) ?? return jet_cli_snapshot_refused("can't securely read the file `{anchor}`", "check the spelling, or run jet from the folder that contains it", color)
    entry_path :: jet_cli_overlay_path(entry)
    script :: jet_cli_entry_is_script(entry_path, overlays)
    root :: if script -> jet_cli_parent(entry_path) ?? "/" else -> jet_cli_source_root(anchor_path)
    root_stat :: cli_files.stat(root) ?? return jet_cli_snapshot_refused("can't securely read the source root `{root}`", "check that the directory exists and is readable", color)
    files := [JetDriverAuthorizedSourceFile]{}
    directories := [AppAuthorizedDirectory]{}
    budget := JetCLISourceBudget{entries: 0, bytes: 0, files: 0}
    if !script {
        if jet_cli_walk_sources(root, "", 0, &files, &directories, true, &budget) == .Val(problem) {
            return jet_cli_snapshot_refused("can't securely read the sources under `{root}`: {problem}", "remove the symbolic link or unreadable file, or check a file outside this tree", color)
        }
    }
    prefix :: if root == "/" -> "/" else -> "{root}/"
    // An explicitly selected entry is a source whatever its suffix (`jet self
    // devtools reduce` and `ice-report` compile the input under its own name),
    // and so is a script, which the walk leaves out; the walk's placement,
    // link, stat and read rules still hold for it.
    if (script || !entry_path.ends_with(".jet")) && entry_path.starts_with(prefix) {
        relative :: entry_path.slice(prefix.len()..<entry_path.len())
        if !jet_cli_outside_walk(root, relative) {
            stat :: cli_files.stat(entry_path) ?? return jet_cli_snapshot_refused("can't securely read the sources under `{root}`: cannot inspect `{entry_path}`: {err}", "remove the symbolic link or unreadable file, or check a file outside this tree", color)
            if stat.is_symlink -> return jet_cli_snapshot_refused("can't securely read the sources under `{root}`: `{entry_path}` is a symbolic link", "remove the symbolic link or unreadable file, or check a file outside this tree", color)
            if stat.is_file {
                limit :: jet_cli_source_read_limit(budget, stat.size, entry_path) ?? return jet_cli_snapshot_refused(err.message, "reduce the source tree size", color)
                read :: jet_cli_read_rooted_source(root, relative, limit) ?? return jet_cli_snapshot_refused("can't securely read the sources under `{root}`: cannot read `{entry_path}`: {err.message}", "remove the symbolic link or unreadable file, or check a file outside this tree", color)
                if !jet_cli_build_read_same_file(stat, read.stat) -> return jet_cli_snapshot_refused("`{entry_path}` changed while it was held", "retry with a stable source tree", color)
                budget.bytes += read.stat.size
                budget.files += 1
                source :: String.from_bytes(^read.bytes) ?? return jet_cli_snapshot_refused("cannot read `{entry_path}`: file is not valid UTF-8", "save the source as UTF-8", color)
                files = jet_cli_insert_source(^files, JetDriverAuthorizedSourceFile{path: entry_path, relative_path: relative, identity: jet_cli_identity_key("file", read.stat), source: source})
            }
        }
    }
    loop overlay in overlays {
        path :: jet_cli_overlay_path(overlay.path)
        replaced := false
        loop index in 0..<files.len() {
            if files[index].path != path -> next
            _ :: jet_cli_replace_source_budget(&budget, files[index].source, overlay.source, path) ?? return jet_cli_snapshot_refused(err.message, "reduce the source tree size", color)
            files[index].source = overlay.source
            replaced = true
        }
        if replaced -> next
        relative :: if path.starts_with(prefix) -> path.slice(prefix.len()..<path.len()) else -> ""
        if relative == "" || cli_files.exists(path) || !relative.ends_with(".jet") || jet_cli_outside_walk(root, relative) {
            return jet_cli_snapshot_refused("`{overlay.path}` is not a checked source file of `{root}`", "check a `.jet` file that is not inside a skipped or nested project directory", color)
        }
        size :: overlay.source.count_bytes()
        _ :: jet_cli_source_read_limit(budget, size, path) ?? return jet_cli_snapshot_refused(err.message, "reduce the source tree size", color)
        budget.bytes += size
        budget.files += 1
        added :: JetDriverAuthorizedSourceFile{path: path, relative_path: relative, identity: "authority-file-v1;kind=overlay;length={size};modified_ns=none;device=none;inode=none", source: overlay.source}
        files = jet_cli_insert_source(^files, added)
    }
    entry_found := false
    loop file in files {
        if file.path == entry_path -> entry_found = true
    }
    if !entry_found {
        return jet_cli_snapshot_refused("`{entry}` is not a checked source file of `{root}`", "check a `.jet` file that is not inside a skipped or nested project directory", color)
    }
    caches := [JetDriverAuthorizedSourceFile]{}
    if jet_cli_foreign_cache_files(root, &caches, &budget) == .Val(problem) {
        return jet_cli_snapshot_refused("can't securely read the foreign bindings under `{root}`: {problem}", "remove the symbolic link or unreadable file, or regenerate the bindings with `jet bind`", color)
    }
    current_root :: cli_files.stat(root) ?? return jet_cli_snapshot_refused("cannot revalidate source root `{root}`: {err}", "retry with a stable source tree", color)
    if !current_root.is_dir || current_root.is_symlink || current_root.id != root_stat.id -> return jet_cli_snapshot_refused("source root `{root}` changed while it was held", "retry with a stable source tree", color)
    root_identity :: jet_cli_identity_key("directory", root_stat)
    roots := [JetDriverAuthorizedSourceRoot]{JetDriverAuthorizedSourceRoot{canonical_path: root, identity: root_identity, allow_hardlinks: false, files: files, foreign_cache_files: caches, directories: directories}}
    script_dependencies := [JetDriverScriptDependency]{}
    if jet_cli_script_dependency_roots(&roots, entry_path, &script_dependencies, color) == .Val(refusal) -> return JetCLISnapshotted.Refused{output: refusal}
    if jet_cli_path_dependency_roots(&roots, color) == .Val(refusal) -> return JetCLISnapshotted.Refused{output: refusal}
    JetCLISnapshotted.Held{snapshot: JetDriverAuthorizedSourceSnapshot{
        roots: roots,
        entry_root_identity: root_identity,
        entry_path: entry_path,
        script_dependencies: script_dependencies,
    }}
}

// ---- The compiler's streaming trace: `--trace[=FILE]` and JET_TRACE_FILE ----
//
// The native `jet` implements the driver's CompilerTraceSink
// (Compiler/JetFoundation/Source/Trace.jet) itself. A file target receives
// the Chrome trace-event lines the Rust host's writer produces
// (crates/jet-driver/src/Trace.rs): the `[` header, `process_name`,
// `trace.start` (`unix_ms`, `functions`), one `B`/`E` event per span with
// `rss_kb`/`peak_rss_kb` (VmRSS/VmHWM) and the span's CPU time (`cpu_ns` of
// its thread, `proc_cpu_ns` of every thread, `majflt` major faults; this
// writer only) on every close and a `memory` counter after a phase,
// throttled `C` progress events, `<phase>.<name>`
// counter events, and `JET_PHASE_COUNTERS` stderr lines when that variable is
// set, so Tools/perf and Tools/agent read either compiler's trace. `-` or
// `stderr` streams one readable line per event to stderr instead. Every line
// is written as soon as its event happens, so a running compile can be
// followed. A failed write stops the trace, never the compile. The sink's
// calls stay inside the trait's FS row: monotonic time is `/proc/uptime`
// (CLOCK_BOOTTIME, 10 ms resolution) and stderr is written as `/dev/stderr`.
JET_CLI_TRACE_FILE_ENV :: "JET_TRACE_FILE"
JET_CLI_TRACE_DETAIL_ENV :: "JET_TRACE_DETAIL"
JET_CLI_PHASE_COUNTERS_ENV :: "JET_PHASE_COUNTERS"
JET_CLI_TRACE_STDERR :: "/dev/stderr"
// Minimum spacing of the progress events of one kind; the last item is
// always written (Trace.rs `PROGRESS_INTERVAL`).
JET_CLI_TRACE_PROGRESS_MS :: 200

// One open span: its kind, the label it shows, when it began (µs), and the
// CPU clocks and fault count when it began.
struct JetCLITraceSpan {
    kind: String
    label: String
    start_us: Int
    start: JetCLITraceUsage
}

// CPU time in ns of the calling thread (`/proc/thread-self/schedstat`: the
// scheduler's exact run time) and of the whole process (`/proc/self/stat`
// utime + stime, in 10 ms clock ticks), and the process's major page faults;
// -1 where unreadable. A span reports the difference between its end and its
// begin; begin and end run on the same thread (spans nest per thread).
struct JetCLITraceUsage {
    cpu_ns: Int
    proc_cpu_ns: Int
    majflt: Int
}

struct JetCLITraceState {
    // False after a failed write: the trace stops, the compile does not.
    writing: Bool
    // Open spans per thread (kernel thread id), innermost last.
    stacks: [Int:[JetCLITraceSpan]]
    // When each progress kind was last written (uptime ms).
    progress_at: [String:Int]
}

struct JetCLITraceSink {
    // The trace file, or `/dev/stderr` for the readable stream.
    target: String
    human: Bool
    // Uptime (ms) when the trace opened: the origin of every timestamp.
    start_ms: Int
    pid: Int
    // The thread that opened the trace; the readable stream marks others.
    main_thread: Int
    functions: Bool
    phase_counters: Bool
    // Shared by every copy of the sink and every compiler thread.
    state: Shared<JetCLITraceState>
}

// Resident and peak resident set size in kB (`VmRSS`, `VmHWM`).
struct JetCLITraceMemory {
    rss_kb: Int
    peak_kb: Int
}

// The process's one sink, opened by `jet_cli_main` for a compiling verb:
// the target `requested` (`--trace` passes `-`, `--trace=FILE` the file)
// selects, else JET_TRACE_FILE; `None` when neither asks for a trace or the
// target cannot be written (the reason goes to stderr, the compile goes on).
// A file target is truncated and starts with the trace header.
fn jet_cli_trace_sink(requested: String?) -> JetCLITraceSink? {
    chosen := cli_sys.get(JET_CLI_TRACE_FILE_ENV) ?? ""
    if requested == .Val(flag) -> chosen = flag
    if chosen == "" -> return None
    human :: chosen == "-" || chosen == "stderr"
    target :: if human -> JET_CLI_TRACE_STDERR else -> chosen
    start_ms :: jet_cli_trace_uptime_ms()
    pid :: cli_sys.pid()
    executable :: cli_sys.executable().split("/").to_list()
    process := "jet"
    if executable.len() > 0 && executable[executable.len() - 1] != "" -> process = executable[executable.len() - 1]
    functions :: (cli_sys.get(JET_CLI_TRACE_DETAIL_ENV) ?? "") == "functions"
    detail :: if functions -> "true" else -> "false"
    opening :: if human -> "[{jet_cli_trace_clock(0)}] trace: {process} pid {pid}, functions {detail}\n" else -> "[\n{{\"name\":\"process_name\",\"ph\":\"M\",\"pid\":{pid},\"tid\":0,\"args\":{{\"name\":{foundation_json_quote(process)}}}}},\n"
    opened :: if human -> jet_cli_trace_append(target, opening) else -> jet_cli_trace_create(target, opening)
    if opened == .Val(problem) {
        _ :: jet_cli_trace_append(JET_CLI_TRACE_STDERR, "jet: cannot write the compiler trace `{chosen}`: {problem}\n")
        return None
    }
    if !human {
        // The wall-clock anchor readers align the trace with: the
        // modification time the header write just set (no clock read).
        unix_ms :: if cli_files.stat(target) == .Ok(info) -> info.modified.to_unix_ms() else -> 0
        started :: jet_cli_trace_append(target, "{{\"name\":\"trace.start\",\"ph\":\"i\",\"s\":\"g\",\"ts\":0,\"pid\":{pid},\"tid\":0,\"args\":{{\"unix_ms\":{unix_ms},\"functions\":{detail}}}}},\n")
        if started == .Val(problem) {
            _ :: jet_cli_trace_append(JET_CLI_TRACE_STDERR, "jet: cannot write the compiler trace `{chosen}`: {problem}\n")
            return None
        }
    }
    Val(JetCLITraceSink{
        target: target,
        human: human,
        start_ms: start_ms,
        pid: pid,
        main_thread: jet_cli_trace_thread(),
        functions: functions,
        phase_counters: (cli_sys.get(JET_CLI_PHASE_COUNTERS_ENV) ?? "") != "",
        state: shared JetCLITraceState{writing: true, stacks: [Int:[JetCLITraceSpan]]{}, progress_at: [String:Int]{}},
    })
}

// A driver trait object over the sink. Trait objects cannot be copied, so
// each owner (the request, the result) gets its own; every one writes
// through the sink's one shared state.
fn jet_cli_trace_boxed(sink: JetCLITraceSink?) -> CompilerTraceSink? Never! {
    opened :: sink ?? return None
    // copy: the caller's sink (owner: the request's option, boxed again for the result) and
    // this trait object (owner: the boxed sink) each hold the sink; the copy shares its one
    // traced state cell (a refcount bump plus flags).
    Val(jet_cli_trace_object(opened.copy()))
}

fn jet_cli_trace_object(sink: ^JetCLITraceSink) -> CompilerTraceSink Never! {
    ^sink
}

impl JetCLITraceSink.CompilerTraceSink {
    fn begin(self, name: String, detail: String, index: Int, total: Int) Never! -[FS]> {
        ts :: jet_cli_trace_micros(self.start_ms)
        thread :: jet_cli_trace_thread()
        label :: if detail == "" -> name else -> detail
        start :: jet_cli_trace_usage()
        permit := self.state.guard_edit()
        if !permit.value.writing -> return
        stack := permit.value.stacks.get(thread) ?? [JetCLITraceSpan]{}
        line := ""
        if self.human {
            item :: if detail == "" -> "" else -> " {detail}"
            line = "{jet_cli_trace_prefix(self, ts, thread, stack.len())}> {name}{item}{jet_cli_trace_place(index, total)}\n"
        } else {
            if !permit.value.stacks.has_key(thread) -> line = jet_cli_trace_thread_name(self.pid, thread)
            args :: if index >= 0 -> ",\"args\":{{\"index\":{index},\"total\":{total}}}" else -> ""
            line = "{line}{jet_cli_trace_head(label, Val(name), "B", ts, self.pid, thread)}{args}}},\n"
        }
        &stack.push(JetCLITraceSpan{kind: name, label: label, start_us: ts, start: start})
        permit.value.stacks[thread] = stack
        jet_cli_trace_write(self.target, &permit.value, line)
    }

    // Closes the innermost open span of kind `name` on this thread, and any
    // deeper span an early return left open; no open span of that kind on
    // this thread writes nothing.
    fn end(self, name: String, items: Int) Never! -[FS]> {
        usage :: jet_cli_trace_usage()
        memory :: jet_cli_trace_memory()
        ts :: jet_cli_trace_micros(self.start_ms)
        thread :: jet_cli_trace_thread()
        permit := self.state.guard_edit()
        if !permit.value.writing -> return
        stack := permit.value.stacks.get(thread) ?? return
        position := stack.len() - 1
        loop position >= 0 && stack[position].kind != name -> position -= 1
        if position < 0 -> return
        line := ""
        loop stack.len() > position + 1 {
            abandoned :: &stack.pop() ?? break
            line = "{line}{jet_cli_trace_close_line(self, abandoned, false, -1, None, None, ts, thread, stack.len())}"
        }
        closed :: &stack.pop() ?? return
        spent :: jet_cli_trace_usage_since(closed.start, usage)
        line = "{line}{jet_cli_trace_close_line(self, closed, true, items, memory, Val(spent), ts, thread, stack.len())}"
        permit.value.stacks[thread] = stack
        jet_cli_trace_write(self.target, &permit.value, line)
    }

    fn progress(self, name: String, done: Int, total: Int) Never! -[FS]> {
        if name.starts_with("counters.") {
            self.counter(name, done)
            return
        }
        now :: jet_cli_trace_uptime_ms()
        thread :: jet_cli_trace_thread()
        permit := self.state.guard_edit()
        if !permit.value.writing -> return
        last_item :: total > 0 && done + 1 >= total
        if permit.value.progress_at.get(name) == .Val(previous) {
            if !last_item && now - previous < JET_CLI_TRACE_PROGRESS_MS -> return
        }
        permit.value.progress_at[name] = now
        ts :: if now > self.start_ms -> (now - self.start_ms) * 1000 else -> 0
        line := ""
        if self.human {
            depth :: (permit.value.stacks.get(thread) ?? [JetCLITraceSpan]{}).len()
            of :: if total > 0 -> "/{total}" else -> ""
            line = "{jet_cli_trace_prefix(self, ts, thread, depth)}~ {name} {done}{of}{jet_cli_trace_resident(jet_cli_trace_memory())}\n"
        } else {
            line = "{jet_cli_trace_head(name, None, "C", ts, self.pid, thread)},\"args\":{{\"done\":{done},\"total\":{total}}}}},\n"
        }
        jet_cli_trace_write(self.target, &permit.value, line)
    }

    fn functions(self) -[]> Bool Never! {
        self.functions
    }
}

impl JetCLITraceSink {
    // A `counters.<phase>.<name>` progress kind: one #4319 scaling counter
    // value, written unthrottled as the `<phase>.<name>` counter event and,
    // with JET_PHASE_COUNTERS set, as a `JET_PHASE_COUNTERS` stderr line.
    fn counter(self, kind: String, value: Int) Never! {
        parts := kind.split(".").to_list()
        if parts.len() < 3 -> return
        counter_name :: &parts.pop() ?? return
        phase := parts[1]
        loop index in 2..<parts.len() -> phase = "{phase}.{parts[index]}"
        counter :: "{phase}.{counter_name}"
        ts :: jet_cli_trace_micros(self.start_ms)
        thread :: jet_cli_trace_thread()
        permit := self.state.guard_edit()
        if permit.value.writing {
            depth :: (permit.value.stacks.get(thread) ?? [JetCLITraceSpan]{}).len()
            line :: if self.human -> "{jet_cli_trace_prefix(self, ts, thread, depth)}# {counter} = {value}\n" else -> "{jet_cli_trace_head(counter, None, "C", ts, self.pid, thread)},\"args\":{{\"value\":{value}}}}},\n"
            jet_cli_trace_write(self.target, &permit.value, line)
        }
        if self.phase_counters {
            _ :: jet_cli_trace_append(JET_CLI_TRACE_STDERR, "JET_PHASE_COUNTERS {{\"phase\":{foundation_json_quote(phase)},{foundation_json_quote(counter_name)}:{value}}}\n")
        }
    }
}

// A span's close. Machine form: its `E` event (with args only for the span
// `end` named), then a phase's `memory` counter; readable form: one line
// with the span's duration, CPU time, item count and memory.
fn jet_cli_trace_close_line(sink: JetCLITraceSink, span: JetCLITraceSpan, named: Bool, items: Int, memory: JetCLITraceMemory?, spent: JetCLITraceUsage?, ts: Int, thread: Int, depth: Int) -> String Never! {
    if sink.human {
        item :: if span.label == span.kind -> "" else -> " {span.label}"
        counted :: if items >= 0 -> " items={items}" else -> ""
        abandoned :: if named -> "" else -> " (left open)"
        cpu := ""
        if spent == .Val(usage) {
            if usage.cpu_ns >= 0 -> cpu = " cpu={jet_cli_trace_seconds(usage.cpu_ns /% 1000)}s"
        }
        return "{jet_cli_trace_prefix(sink, ts, thread, depth)}< {span.kind}{item} {jet_cli_trace_seconds(ts - span.start_us)}s{cpu}{counted}{jet_cli_trace_resident(memory)}{abandoned}\n"
    }
    head :: jet_cli_trace_head(span.label, Val(span.kind), "E", ts, sink.pid, thread)
    if !named -> return "{head}}},\n"
    args := [String]{}
    if items >= 0 -> &args.push("\"items\":{items}")
    if memory == .Val(kb) -> &args.push("\"rss_kb\":{kb.rss_kb},\"peak_rss_kb\":{kb.peak_kb}")
    if spent == .Val(usage) {
        if usage.cpu_ns >= 0 -> &args.push("\"cpu_ns\":{usage.cpu_ns}")
        if usage.proc_cpu_ns >= 0 -> &args.push("\"proc_cpu_ns\":{usage.proc_cpu_ns}")
        if usage.majflt >= 0 -> &args.push("\"majflt\":{usage.majflt}")
    }
    joined :: args.join(",")
    line := "{head},\"args\":{{{joined}}}}},\n"
    if span.label == span.kind && memory == .Val(kb) {
        rss_mb :: kb.rss_kb /% 1024
        peak_mb :: kb.peak_kb /% 1024
        line = "{line}{jet_cli_trace_head("memory", None, "C", ts, sink.pid, thread)},\"args\":{{\"rss_mb\":{rss_mb},\"peak_rss_mb\":{peak_mb}}}}},\n"
    }
    line
}

// `{"name":..,"cat":..,"ph":..,"ts":..,"pid":..,"tid":..` without the
// closing brace, so the caller appends `args` (Trace.rs `push_event_head`).
fn jet_cli_trace_head(name: String, kind: String?, phase: String, ts: Int, pid: Int, thread: Int) -> String Never! {
    category :: if kind == .Val(text) -> ",\"cat\":{foundation_json_quote(text)}" else -> ""
    "{{\"name\":{foundation_json_quote(name)}{category},\"ph\":\"{phase}\",\"ts\":{ts},\"pid\":{pid},\"tid\":{thread}"
}

// The `thread_name` metadata event a thread's first span is preceded by.
fn jet_cli_trace_thread_name(pid: Int, thread: Int) -> String Never! {
    "{{\"name\":\"thread_name\",\"ph\":\"M\",\"pid\":{pid},\"tid\":{thread},\"args\":{{\"name\":\"thread {thread}\"}}}},\n"
}

// The readable stream's line prefix: elapsed seconds, a non-main thread's
// id, and two spaces per open span.
fn jet_cli_trace_prefix(sink: JetCLITraceSink, ts: Int, thread: Int, depth: Int) -> String Never! {
    lane :: if thread == sink.main_thread -> "" else -> "[t{thread}] "
    indent := ""
    loop indent.len() < depth * 2 -> indent = "{indent}  "
    "[{jet_cli_trace_clock(ts)}] {lane}{indent}"
}

// Elapsed microseconds as right-aligned seconds, `   12.345s`.
fn jet_cli_trace_clock(us: Int) -> String Never! {
    text := jet_cli_trace_seconds(us)
    loop text.len() < 9 -> text = " {text}"
    "{text}s"
}

fn jet_cli_trace_seconds(us: Int) -> String Never! {
    seconds :: us /% 1000000
    millis :: (us %% 1000000) /% 1000
    pad :: if millis < 10 -> "00" else if millis < 100 -> "0" else -> ""
    "{seconds}.{pad}{millis}"
}

// ` (3/120)` for an item's place in its phase; ` (#3)` when uncounted.
fn jet_cli_trace_place(index: Int, total: Int) -> String Never! {
    if index < 0 -> return ""
    position :: index + 1
    if total > 0 -> return " ({position}/{total})"
    " (#{position})"
}

fn jet_cli_trace_resident(memory: JetCLITraceMemory?) -> String Never! {
    if memory == .Val(kb) {
        rss_mb :: kb.rss_kb /% 1024
        peak_mb :: kb.peak_kb /% 1024
        return " rss={rss_mb}MB peak={peak_mb}MB"
    }
    ""
}

// Microseconds since the trace opened (`/proc/uptime` resolution).
fn jet_cli_trace_micros(start_ms: Int) -> Int Never! {
    elapsed :: jet_cli_trace_uptime_ms() - start_ms
    if elapsed < 0 -> return 0
    elapsed * 1000
}

// Milliseconds since boot from `/proc/uptime` (`12345.67 …`, CLOCK_BOOTTIME),
// the trace's monotonic clock; 0 when it cannot be read.
fn jet_cli_trace_uptime_ms() -> Int Never! {
    text :: cli_files.read("/proc/uptime") ?? return 0
    loop field in text.split(" ") {
        parts :: field.split(".").to_list()
        if parts.len() != 2 -> return 0
        fraction := parts[1]
        loop fraction.len() < 3 -> fraction = "{fraction}0"
        seconds :: Int.parse(parts[0]) ?? return 0
        millis :: Int.parse(fraction.slice(0..<3)) ?? return 0
        return seconds * 1000 + millis
    }
    0
}

// The calling thread's kernel id, from `/proc/thread-self` (`<pid>/task/<tid>`).
fn jet_cli_trace_thread() -> Int Never! {
    link :: cli_files.read_link("/proc/thread-self") ?? return 0
    parts :: link.split("/").to_list()
    if parts.len() == 0 -> return 0
    Int.parse(parts[parts.len() - 1]) ?? 0
}

fn jet_cli_trace_memory() -> JetCLITraceMemory? Never! {
    text :: cli_files.read("/proc/self/status") ?? return None
    rss := -1
    peak := -1
    loop line in text.lines() {
        if line.starts_with("VmRSS:") -> rss = jet_cli_trace_status_kb(line)
        if line.starts_with("VmHWM:") -> peak = jet_cli_trace_status_kb(line)
    }
    if rss < 0 || peak < 0 -> return None
    Val(JetCLITraceMemory{rss_kb: rss, peak_kb: peak})
}

// The kB count of one `/proc/self/status` line (`VmRSS:\t  1234 kB`), or -1.
fn jet_cli_trace_status_kb(line: String) -> Int Never! {
    parts :: line.split(":").to_list()
    if parts.len() != 2 -> return -1
    loop word in parts[1].trim().split(" ") {
        if word == "" -> next
        return Int.parse(word) ?? -1
    }
    -1
}

// `/proc/self/stat` counts CPU time in clock ticks of USER_HZ (100 on every
// Linux ABI): 10 ms each.
JET_CLI_TRACE_NS_PER_TICK :: 10000000

// The CPU clocks and major fault count a span starts from and ends at.
fn jet_cli_trace_usage() -> JetCLITraceUsage Never! {
    usage := JetCLITraceUsage{cpu_ns: -1, proc_cpu_ns: -1, majflt: -1}
    // `<run ns> <wait ns> <timeslices>`: the first field is the thread's CPU time.
    if cli_files.read("/proc/thread-self/schedstat") == .Ok(schedstat) {
        loop field in schedstat.trim().split(" ") {
            usage.cpu_ns = Int.parse(field) ?? -1
            break
        }
    }
    // `pid (comm) state …`: the fields after the last `)` start at field 3
    // (state), so majflt (12), utime (14) and stime (15) are 9, 11 and 12.
    text :: cli_files.read("/proc/self/stat") ?? return usage
    parts :: text.split(")").to_list()
    if parts.len() < 2 -> return usage
    fields := [String]{}
    loop word in parts[parts.len() - 1].trim().split(" ") {
        if word != "" -> &fields.push(word)
    }
    if fields.len() < 13 -> return usage
    usage.majflt = Int.parse(fields[9]) ?? -1
    utime :: Int.parse(fields[11]) ?? return usage
    stime :: Int.parse(fields[12]) ?? return usage
    usage.proc_cpu_ns = (utime + stime) * JET_CLI_TRACE_NS_PER_TICK
    usage
}

// What a span spent between `start` and `now`; -1 where either is unknown.
fn jet_cli_trace_usage_since(start: JetCLITraceUsage, now: JetCLITraceUsage) -> JetCLITraceUsage Never! {
    JetCLITraceUsage{
        cpu_ns: if start.cpu_ns < 0 || now.cpu_ns < 0 -> -1 else -> now.cpu_ns - start.cpu_ns,
        proc_cpu_ns: if start.proc_cpu_ns < 0 || now.proc_cpu_ns < 0 -> -1 else -> now.proc_cpu_ns - start.proc_cpu_ns,
        majflt: if start.majflt < 0 || now.majflt < 0 -> -1 else -> now.majflt - start.majflt,
    }
}

// Writes one event's text; the first failure stops the trace.
fn jet_cli_trace_write(target: String, state: &JetCLITraceState, text: String) Never! {
    problem :: jet_cli_trace_append(target, text) ?? return
    state.writing = false
    _ :: jet_cli_trace_append(JET_CLI_TRACE_STDERR, "jet: the compiler trace stopped: writing `{target}` failed: {problem}\n")
}

// Appends `text` (each call opens, writes, flushes and closes, so every event
// is in the file when the call returns); the failure, or `None`. Writes go
// through an append-mode `FileWriter` (the native runtime pack exports the
// writer routes; it has no whole-file append route).
fn jet_cli_trace_append(target: String, text: String) -> String? Never! {
    writer :: cli_files.append(target) ?? return Val("{err}")
    writer.write_all(text.bytes()) ?? return Val("{err}")
    writer.flush() ?? return Val("{err}")
    None
}

fn jet_cli_trace_create(target: String, text: String) -> String? Never! {
    cli_files.write(target, text) ?? return Val("{err}")
    None
}

// The identity (`name@version#<compiler_source_id>`) of the source this compiler
// was built from. The native assembler (Tools/agent/native-compiler.mjs) writes
// it into the assembled unit; "" in a tree it did not assemble. It stays the
// last line of this file, so that rewrite moves no other byte of this file.
JET_CLI_BUILT_COMPILER_IDENTITY :: ""
