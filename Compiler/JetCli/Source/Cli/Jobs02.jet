//RS /// Is `name` a built-in command?
//RS pub fn is_builtin(name: &str) -> bool {
//RS     COMMANDS.iter().any(|c| c.name == name)
//RS         // Group normalization rewrites canonical `jet <group> <action>` into
//RS         // its internal handler word after rejecting the retired bare form.
//RS         || COMMANDS
//RS             .iter()
//RS             .flat_map(|c| c.actions)
//RS             .any(|action| action.handler.dispatch_word() == name)
//RS         // E0043 teaching path: `jet install` is intentionally not advertised in
//RS         // help/completions, but dispatch must reach its bespoke "use fetch"
//RS         // diagnostic instead of generic unknown-command E2101.
//RS         || name == "install"
//RS         || is_retired_root(name)
//RS }
