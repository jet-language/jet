//RS             | "remove"
//RS             | "bind"
//RS             | "lsp"
//RS             | "config"
//RS             | "update"
//RS             | "outdated"
//RS             | "search"
//RS             | "info"
//RS             | "import"
//RS             | "explain"
//RS             | "logs"
//RS             | "clean"
//RS             | "fetch"
//RS             | "publish"
//RS             | "yank"
