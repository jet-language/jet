//RS         }
//RS         return format!("{} {} <command>", BINARY_NAME, group.name);
//RS     }
//RS     if let Some((group, action)) = moved_command(name) {
//RS         return action
//RS             .usage
//RS             .lines()
//RS             .map(|usage| format!("{} {} {}", BINARY_NAME, group.name, usage))
//RS             .collect::<Vec<_>>()
//RS             .join("\n");
//RS     }
//RS     // A flat command's own declared shape, when the registry carries one
//RS     // (#2072). Falling back to `[args]` keeps rows that have no positional.
