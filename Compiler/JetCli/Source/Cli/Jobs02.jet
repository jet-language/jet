// Rust: crates/jet-cli/src/CLI.rs:2318
pub enum HelpOrder {
    Frequency
    Az
    Za
}
// Rust: crates/jet-cli/src/CLI.rs:2327
pub HELP_ORDER_NAMES :: "frequency, az, za"
// Rust: crates/jet-cli/src/CLI.rs:2329
pub fn jet_cli_help_order_parse(value: String) -> HelpOrder? Never! {
    if value == {
        "frequency" -> Val(HelpOrder.Frequency)
        "az" -> Val(HelpOrder.Az)
        "za" -> Val(HelpOrder.Za)
        else -> None
    }
}

// Rust: crates/jet-cli/src/CLI.rs:2341
// Sort row indices, retaining the canonical table and stable ties. Registry.jet's
// selection-sort projection predates this O(n log n) reference implementation.
pub fn jet_cli_commands_in_order(order: HelpOrder) -> [Int] Never! {
    indices := [Int]{}
    loop (index, _) in JET_CLI_COMMANDS -> &indices.push(index)
    &indices.sort_by((left: Int, right: Int) -> {
        a :: JET_CLI_COMMANDS[left]
        b :: JET_CLI_COMMANDS[right]
        if order == {
            .Frequency -> a.frequency_rank <=> b.frequency_rank
            .Az -> {
                if jet_cli_name_before(a.name, b.name) -> return -1
                if jet_cli_name_before(b.name, a.name) -> return 1
                0
            }
            .Za -> {
                if jet_cli_name_before(b.name, a.name) -> return -1
                if jet_cli_name_before(a.name, b.name) -> return 1
                0
            }
        }
    })
    indices
}
// Rust: crates/jet-cli/src/CLI.rs:2360
// The reference takes a supplied version rather than the host's version constant.
pub fn jet_cli_usage_page_version(version: String, order: HelpOrder) -> String Never! {
    out := "Welcome to {JET_CLI_LANG_NAME}! (v{version})\n\nUsage:\n".bytes()
    commands :: jet_cli_commands_in_order(order)
    loop index in commands {
        command :: JET_CLI_COMMANDS[index]
        if jet_cli_is_canonical_top_level(command.name) {
            jet_cli_completions_append(&out, "  {jet_cli_pad(jet_cli_command_usage(command.name), 36)} {command.summary}\n")
        }
    }
    loop index in commands {
        command :: JET_CLI_COMMANDS[index]
        if command.actions.len() > 0 {
            jet_cli_completions_append(&out, "\n{jet_cli_group_label(command.name)} Commands:\n{jet_cli_group_usage(command.name)}")
        }
    }
    jet_cli_completions_append(&out, "\nFlags:\n")
    loop flag in JET_CLI_FLAGS -> jet_cli_completions_append(&out, "  {jet_cli_pad(flag.long, 28)} {flag.help}\n")
    jet_cli_completions_finish(out)
}

