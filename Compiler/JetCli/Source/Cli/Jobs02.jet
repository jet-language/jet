//RS fn escape_zsh(s: &str) -> String {
//RS     s.replace('\'', "'\\''")
//RS         .replace(':', "\\:")
//RS         .replace('[', "\\[")
//RS         .replace(']', "\\]")
//RS }
//RS fn escape_fish(s: &str) -> String {
//RS     s.replace('\'', "\\'")
//RS }
//RS fn roff_escape(s: &str) -> String {
//RS     // Lines beginning with `'` or `.` are roff control lines; escape and also
//RS     // neutralize backslashes.
//RS     s.replace('\\', "\\\\")
//RS }
