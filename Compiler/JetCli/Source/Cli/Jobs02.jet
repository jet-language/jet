//RS /// Commands that own a bespoke flag vocabulary or forward flags downstream.
//RS /// Main dispatch still reads the command set from `COMMANDS`; this only decides
//RS /// whether the generic E2102 checker should run.
//RS pub fn owns_flag_vocabulary(name: &str) -> bool {
//RS     matches!(
//RS         name,
//RS         "env"
//RS             | "cc"
