//RS /// Is `flag` (e.g. `--json` or `--color=always`) a known flag?
//RS pub fn is_known_flag(flag: &str) -> bool {
//RS     let head = flag.split('=').next().unwrap_or(flag);
//RS     FLAGS.iter().any(|f| f.long == head)
//RS }
//RS 
//RS /// #1659 criterion 2: the one spelling-check for "the user asked for help",
//RS /// shared by every command instead of each hand-copying
//RS /// `arg == "--help" || arg == "-h"`.
//RS pub fn is_help_flag(arg: &str) -> bool {
//RS     arg == "--help" || arg == "-h"
//RS }
//RS 
//RS /// Levenshtein edit distance — the same shape used by sema's S14 suggestions.
//RS /// Closest built-in command to `name` within edit distance 3, or `None`.
//RS pub fn closest_command(name: &str) -> Option<&'static str> {
//RS     closest(
//RS         name,
//RS         COMMANDS
//RS             .iter()
//RS             .filter(|command| is_canonical_top_level(command.name))
//RS             .map(|command| command.name),
//RS     )
//RS }
//RS 
//RS /// Closest known flag to `flag` within edit distance 3, or `None`.
//RS pub fn closest_flag(flag: &str) -> Option<&'static str> {
//RS     let head = flag.split('=').next().unwrap_or(flag);
//RS     closest(head, FLAGS.iter().map(|f| f.long))
//RS }
//RS 
//RS fn closest<'a, I: Iterator<Item = &'a str>>(needle: &str, hay: I) -> Option<&'a str> {
//RS     let mut best: Option<(&str, usize)> = None;
//RS     for cand in hay {
//RS         let d = edit_distance(needle, cand);
//RS         if best.map(|(_, bd)| d < bd).unwrap_or(true) {
//RS             best = Some((cand, d));
//RS         }
//RS     }
//RS     // Cap: only suggest when reasonably close (allow ~half the word length).
//RS     best.filter(|(c, d)| *d <= 3 && *d <= c.len())
//RS         .map(|(c, _)| c)
//RS }
//RS 
//RS // ──────────────────────────────────────────────
//RS // Generators (hand-rolled — invariant I6, no clap_complete)
//RS // ──────────────────────────────────────────────
