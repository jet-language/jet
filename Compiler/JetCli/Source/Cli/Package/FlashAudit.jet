// Flash-only raw escaped-token identity scan (Source/CmdFlash.rs:869-1381).
// This is not a JSON value parser: no decoded key or value escapes this file.
// Only the flash plan builder uses the private scan/identity verification.
use core.files as flash_files

struct JetCLIFlashOptions { target: String?, image: Path?, audit: Path?, adapter: JetCLIFlashAdapter? }
enum JetCLIFlashParse { Help Options(JetCLIFlashOptions) }
// Rust parse_flash_args (CmdFlash.rs:881-924).
fn jet_cli_flash_parse_args(args: [String]) -> JetCLIFlashParse JetCLIFlashError! {
    options := JetCLIFlashOptions{target: None, image: None, audit: None, adapter: None}
    index := if args.len() > 0 && args[0] == "flash" -> 1 else -> 0
    loop index < args.len() {
        argument :: args[index]
        if argument == "--json" || argument == "--quiet" {
            index += 1
            next
        }
        if argument == "--help" || argument == "help" -> return Ok(JetCLIFlashParse.Help)
        raw :: argument.bytes()
        equal := -1
        loop (at, byte) in raw {
            if Int.from_u8(byte) == 61 {
                equal = at
                break
            }
        }
        // copy: the flag text is a sub-range copied out of `raw` (which keeps its bytes), or the
        // argument itself, which stays in `args` (a read parameter: no move out of it, E0201);
        // `flag` owns its own text.
        flag :: if equal >= 0 -> String.from_bytes(raw[0..<equal].copy()) ?? panic("UTF-8 flag") else -> argument.copy()
        // copy: the inline value is a sub-range copied out of `raw` (which keeps its whole byte
        // list); a range has no owner to move from.
        inline :: if equal >= 0 -> Val(String.from_bytes(raw[equal + 1..<raw.len()].copy()) ?? panic("UTF-8 value")) else -> None
        if flag != "--target" && flag != "--image" && flag != "--audit" && flag != "--adapter" -> return Err(jet_cli_flash_error("unexpected flash argument `{argument}`"))
        value := ""
        if inline == {
            .Val(text) -> {
                if text.is_empty() -> return Err(jet_cli_flash_error("`{flag}` needs a value"))
                value = ^text
            }
            .None -> {
                index += 1
                if index >= args.len() || args[index].starts_with("-") -> return Err(jet_cli_flash_error("`{flag}` needs a value"))
                // copy: `args[index]` stays with the caller (`args` is a read parameter: no move
                // out of it, E0201) and `value` owns its own.
                value = args[index].copy()
            }
        }
        if flag == {
            "--target" -> options.target = Val(^value)
            "--image" -> options.image = Val(flash_paths.of(value))
            "--audit" -> options.audit = Val(flash_paths.of(value))
            else -> options.adapter = Val(jet_cli_flash_adapter_parse(value) ?? return Err(jet_cli_flash_error("unknown flash adapter `{value}` (use probe-rs, openocd, or emulator)")))
        }
        index += 1
    }
    Ok(JetCLIFlashParse.Options(options))
}
// Rust canonical_flash_args (CmdFlash.rs:926-934).
fn jet_cli_flash_canonical_args(args: [String]) -> [String] Never! {
    // copy: `args` stays with the caller (`args` is a read parameter: no move out of it, E0201) and
    // the new value owns its own.
    if args.len() > 0 && args[0] == "flash" -> return args.copy()
    result := [String]{"flash"}
    // copy: `word` stays in the iterated collection (`word` is a view of its element; no move out
    // of an element, E0225) and the pushed row owns its own.
    loop word in args -> &result.push(word.copy())
    result
}
// Rust flash_help (CmdFlash.rs:1379-1381).
fn jet_cli_flash_help() -> String Never! {
    "jet flash --target <board.name> [--image <firmware.elf>] [--audit <target.json>] [--adapter <probe-rs|openocd|emulator>]"
}
// Rust resolve_declared_tool/resolve_audit_path skip ordinary inspect errors;
// #4378's typed raw-address refusal is never treated as an absent candidate.
fn jet_cli_flash_candidate_metadata<H: JetCLIFlashHost>(host: &H, path: Path) -> JetCLIFlashMetadata? JetCLIFlashError! {
    if &host.symlink_metadata(path) == {
        .Ok(metadata) -> Ok(Val(^metadata))
        .Err(cause) -> {
            if cause.byte_offset != None -> return Err(^cause)
            Ok(jet_cli_flash_no_metadata())
        }
    }
}
fn jet_cli_flash_no_metadata() -> JetCLIFlashMetadata? Never! { None }
// Rust resolve_declared_tool (CmdFlash.rs:945-967).
fn jet_cli_flash_resolve_tool<H: JetCLIFlashHost>(host: &H, name: String) -> Path JetCLIFlashError! {
    if name.is_empty() || name.contains("/") || name.contains("\\") -> return Err(jet_cli_flash_error("declared flash tool `{name}` is not a bare executable"))
    // #4376: a result match retains the checked owner of fallible optional Core Paths.
    snapshot :: if &host.path_snapshot() == {
        .Ok(value) -> ^value
        .Err(cause) -> { return Err(^cause) }
    }
    directories :: snapshot ?? return Err(jet_cli_flash_error("cannot resolve declared flash tool without a PATH snapshot"))
    loop directory in directories {
        candidate :: flash_paths.join(directory, name)
        inspected :: jet_cli_flash_candidate_metadata<H>(&host, candidate)
        metadata :: inspected ?? next
        if metadata.symlink || !metadata.regular -> next
        canonical :: &host.canonicalize(candidate) ?? return Err(jet_cli_flash_context_error("cannot canonicalize declared flash tool `{name}`: {err.message}", err))
        // #4381: preserve canonical Core Path identity; never nominally rewrap.
        return Ok(^canonical)
    }
    Err(jet_cli_flash_error("declared flash tool `{name}` was not found in the captured PATH"))
}
// Rust regular_file (CmdFlash.rs:969-977).
// #4376: exact Core text projection keeps error paths independent of external owner fields.
fn jet_cli_flash_regular_file<H: JetCLIFlashHost>(host: &H, path: Path, label: String) -> Path JetCLIFlashError! {
    metadata :: &host.symlink_metadata(path) ?? return Err(jet_cli_flash_context_error("cannot inspect {label} `{flash_paths.show(path)}`: {err.message}", err))
    if metadata.symlink || !metadata.regular -> return Err(jet_cli_flash_error("{label} `{flash_paths.show(path)}` is not a regular file"))
    canonical :: &host.canonicalize(path) ?? return Err(jet_cli_flash_context_error("cannot canonicalize {label} `{flash_paths.show(path)}`: {err.message}", err))
    // #4381: ownership-preserving Core Path nominal rewrap.
    Ok(Path{raw: ^canonical.raw})
}
// Rust resolve_audit_path (CmdFlash.rs:979-1010).
fn jet_cli_flash_resolve_audit<H: JetCLIFlashHost>(host: &H, image: Path, target: String, explicit: Path?) -> Path JetCLIFlashError! {
    if explicit == .Val(path) -> return jet_cli_flash_regular_file<H>(&host, path, "target audit")
    parent :: flash_paths.parent(image)
    candidates := [Path]{flash_paths.with_suffix(image, ".target.json")}
    safe_bytes := [U8]{}
    loop byte in target.bytes() {
        code :: Int.from_u8(byte)
        if code >= 128 && code < 192 -> next
        &safe_bytes.push(if jet_cli_flash_ascii_alnum(code) -> byte else -> U8{95})
    }
    safe :: String.from_bytes(safe_bytes) ?? panic("ASCII target name")
    named :: flash_paths.join(parent, "{safe}.target.json")
    if named.raw != candidates[0].raw -> &candidates.push(named)
    existing := [Path]{}
    loop candidate in candidates {
        inspected :: jet_cli_flash_candidate_metadata<H>(&host, candidate)
        _ :: inspected ?? next
        &existing.push(jet_cli_flash_regular_file<H>(&host, candidate, "target audit"))
    }
    // copy: `existing[0]` stays in its list (owner: `existing`; no move out of an element, E0225)
    // and the returned value owns its own.
    if existing.len() == 1 -> return Ok(existing[0].copy())
    if existing.is_empty() -> return Err(jet_cli_flash_error("no target audit sidecar found beside `{flash_paths.show(image)}`; pass `--audit <target.json>`"))
    Err(jet_cli_flash_error("multiple target audit sidecars found beside `{flash_paths.show(image)}`; pass one with `--audit`"))
}
// Rust read_audit (CmdFlash.rs:1012-1023).
// #4376: Core's exact-text projection avoids missing external Path owner lowering.
fn jet_cli_flash_read_audit<H: JetCLIFlashHost>(host: &H, path: Path) -> String JetCLIFlashError! {
    metadata :: &host.metadata(path) ?? return Err(jet_cli_flash_context_error("cannot inspect target audit `{flash_paths.show(path)}`: {err.message}", err))
    if metadata.bytes > JET_CLI_FLASH_MAX_AUDIT_BYTES -> return Err(jet_cli_flash_error("target audit `{flash_paths.show(path)}` exceeds the {JET_CLI_FLASH_MAX_AUDIT_BYTES}-byte limit"))
    text :: &host.read_audit_text(path) ?? return Err(jet_cli_flash_context_error("cannot read target audit `{flash_paths.show(path)}`: {err.message}", err))
    Ok(text)
}
// Rust verify_audit_identity (CmdFlash.rs:1025-1059); tokens are never decoded.
fn jet_cli_flash_verify_audit(fields: [String:String], machine: MIRTargetMachine, digest: String) JetCLIFlashError! {
    keys :: [String]{"name", "triple", "environment", "provider_identity"}
    // copy: `machine.name` stays with the caller (`machine` is a read parameter: no move out of it,
    // E0201) and the new value owns its own. `machine.triple` stays with the caller (`machine` is a
    // read parameter: no move out of it, E0201) and the new value owns its own.
    expected :: [String]{machine.name.copy(), machine.triple.copy(), jet_target_environment_identity(machine), jet_target_provider_identity(machine)}
    loop (index, key) in keys {
        actual :: fields.get(key) ?? return Err(jet_cli_flash_error("target audit has no `{key}` identity field"))
        token :: jet_cli_flash_json_string_token(expected[index])
        if actual != token -> return Err(jet_cli_flash_error("target audit `{key}` does not match selected target `{machine.name}`"))
    }
    digest_keys :: [String]{"image_sha256", "artifact_sha256", "image_digest"}
    loop key in digest_keys {
        if fields.get(key) == .Val(actual) {
            token :: jet_cli_flash_json_string_token(digest)
            prefixed :: jet_cli_flash_json_string_token("sha256:{digest}")
            if actual != token && actual != prefixed -> return Err(jet_cli_flash_error("target audit `{key}` does not match the image digest"))
            break
        }
    }
}
struct JetCLIFlashTokenCursor { bytes: [U8], at: Int }
fn jet_cli_flash_token_peek(cursor: JetCLIFlashTokenCursor) -> Int Never! {
    if cursor.at >= cursor.bytes.len() -> return -1
    Int.from_u8(cursor.bytes[cursor.at])
}
fn jet_cli_flash_token_space(byte: Int) -> Bool Never! { byte == 32 || byte == 9 || byte == 10 || byte == 12 || byte == 13 }
// Rust skip_json_space (CmdFlash.rs:1219-1226).
fn jet_cli_flash_skip_json_space(cursor: &JetCLIFlashTokenCursor) Never! {
    loop jet_cli_flash_token_space(jet_cli_flash_token_peek(cursor)) -> cursor.at += 1
}
// Rust parse_top_level_string_fields (CmdFlash.rs:1064-1120).
fn jet_cli_flash_parse_top_level_string_fields(text: String) -> [String:String] JetCLIFlashError! {
    cursor := JetCLIFlashTokenCursor{bytes: text.bytes(), at: 0}
    jet_cli_flash_skip_json_space(&cursor)
    if jet_cli_flash_token_peek(cursor) != 123 -> return Err(jet_cli_flash_error("top-level value is not an object"))
    cursor.at += 1
    fields := [String:String]{}
    loop {
        jet_cli_flash_skip_json_space(&cursor)
        if jet_cli_flash_token_peek(cursor) == 125 {
            cursor.at += 1
            break
        }
        key :: jet_cli_flash_parse_json_string_token(&cursor)
        if key.contains("\\") -> return Err(jet_cli_flash_error("escaped object keys are not supported"))
        jet_cli_flash_skip_json_space(&cursor)
        if jet_cli_flash_token_peek(cursor) != 58 -> return Err(jet_cli_flash_error("object key is not followed by `:`"))
        cursor.at += 1
        jet_cli_flash_skip_json_space(&cursor)
        value := ""
        if jet_cli_flash_token_peek(cursor) == 34 -> value = jet_cli_flash_parse_json_string_token(&cursor) else -> jet_cli_flash_skip_json_value(&cursor)
        if fields.has_key(key) -> return Err(jet_cli_flash_error("duplicate top-level field `{key}`"))
        fields[key] = ^value
        jet_cli_flash_skip_json_space(&cursor)
        byte :: jet_cli_flash_token_peek(cursor)
        if byte == 44 {
            cursor.at += 1
            jet_cli_flash_skip_json_space(&cursor)
            if jet_cli_flash_token_peek(cursor) == 125 -> return Err(jet_cli_flash_error("object has a trailing comma"))
        } else {
            if byte != 125 -> return Err(jet_cli_flash_error("object field is not followed by `,` or `}}`"))
            cursor.at += 1
            break
        }
    }
    jet_cli_flash_skip_json_space(&cursor)
    if cursor.at != cursor.bytes.len() -> return Err(jet_cli_flash_error("trailing bytes after target audit object"))
    Ok(fields)
}
// Rust parse_json_string_token (CmdFlash.rs:1122-1154): escaped text verbatim.
fn jet_cli_flash_parse_json_string_token(cursor: &JetCLIFlashTokenCursor) -> String JetCLIFlashError! {
    if jet_cli_flash_token_peek(cursor) != 34 -> return Err(jet_cli_flash_error("expected a JSON string"))
    cursor.at += 1
    start :: cursor.at
    escaped := false
    loop cursor.at < cursor.bytes.len() {
        byte :: jet_cli_flash_token_peek(cursor)
        cursor.at += 1
        if escaped {
            escaped = false
            if byte == 117 {
                loop _ in 0..<4 {
                    digit :: jet_cli_flash_token_peek(cursor)
                    if !((digit >= 48 && digit <= 57) || (digit >= 65 && digit <= 70) || (digit >= 97 && digit <= 102)) -> return Err(jet_cli_flash_error("malformed JSON unicode escape"))
                    cursor.at += 1
                }
            }
            next
        }
        if byte == 92 -> escaped = true
        // copy: the string token is a sub-range copied out of the cursor's bytes (owner: `cursor`,
        // a write parameter that keeps its whole buffer).
        if byte == 34 -> return Ok(String.from_bytes(cursor.bytes[start..<cursor.at - 1].copy()) ?? return Err(jet_cli_flash_error("JSON string is not UTF-8")))
        if byte <= 31 -> return Err(jet_cli_flash_error("JSON string contains a control character"))
    }
    Err(jet_cli_flash_error("unterminated JSON string"))
}
// Rust skip_json_value (CmdFlash.rs:1156-1217): delimiter scan, not validation.
fn jet_cli_flash_skip_json_value(cursor: &JetCLIFlashTokenCursor) JetCLIFlashError! {
    first :: jet_cli_flash_token_peek(cursor)
    if first == -1 -> return Err(jet_cli_flash_error("missing JSON value"))
    if first == 34 {
        _ :: jet_cli_flash_parse_json_string_token(&cursor)
        return
    }
    if first == 123 || first == 91 {
        stack := [Int]{first}
        cursor.at += 1
        escaped := false
        loop cursor.at < cursor.bytes.len() {
            byte :: jet_cli_flash_token_peek(cursor)
            cursor.at += 1
            if escaped {
                escaped = false
                next
            }
            if byte == 92 {
                escaped = true
                next
            }
            if byte == 34 {
                loop cursor.at < cursor.bytes.len() {
                    inner :: jet_cli_flash_token_peek(cursor)
                    cursor.at += 1
                    if inner == 92 -> cursor.at += 1
                    if inner == 34 -> break
                }
                next
            }
            if byte == 123 || byte == 91 -> &stack.push(byte)
            if byte == 125 || byte == 93 {
                open :: &stack.pop() ?? return Err(jet_cli_flash_error("unbalanced JSON value"))
                if (open == 123 && byte != 125) || (open == 91 && byte != 93) -> return Err(jet_cli_flash_error("mismatched JSON delimiters"))
                if stack.is_empty() -> return
            }
        }
        return Err(jet_cli_flash_error("unterminated JSON value"))
    }
    start :: cursor.at
    loop cursor.at < cursor.bytes.len() {
        byte :: jet_cli_flash_token_peek(cursor)
        if byte == 44 || byte == 125 || byte == 93 || jet_cli_flash_token_space(byte) -> break
        cursor.at += 1
    }
    if cursor.at == start -> return Err(jet_cli_flash_error("empty JSON value"))
}
// Rust json_string_token (CmdFlash.rs:1228-1231).
fn jet_cli_flash_json_string_token(value: String) -> String Never! {
    bytes :: canonical_json_bytes(CanonicalJSON.String(value))
    // copy: the unquoted text is a sub-range copied out of `bytes` (which keeps its whole list); a
    // range has no owner to move from.
    String.from_bytes(bytes[1..<bytes.len() - 2].copy()) ?? panic("canonical JSON string is UTF-8")
}
struct JetCLIFlashCapture { bytes: [U8], truncated: Bool }
// Rust bound_capture (CmdFlash.rs:1233-1242).
fn jet_cli_flash_bound_capture(bytes: [U8]) -> JetCLIFlashCapture Never! {
    // copy: `bytes` stays with the caller (`bytes` is a read parameter: no move out of it, E0201)
    // and the field `bytes` owns its own.
    if bytes.len() <= JET_CLI_FLASH_MAX_CAPTURE_BYTES -> return JetCLIFlashCapture{bytes: bytes.copy(), truncated: false}
    marker :: "\n<output truncated>\n".bytes()
    // copy: the bounded capture is a sub-range copied out of `bytes` (owner: the caller, a read
    // parameter); a range has no owner to move from.
    bounded := bytes[0..<JET_CLI_FLASH_MAX_CAPTURE_BYTES - marker.len()].copy()
    loop byte in marker -> &bounded.push(byte)
    JetCLIFlashCapture{bytes: bounded, truncated: true}
}
fn jet_cli_flash_ascii_alnum(code: Int) -> Bool Never! { (code >= 48 && code <= 57) || (code >= 65 && code <= 90) || (code >= 97 && code <= 122) }
// Rust safe_openocd_image_name (CmdFlash.rs:1244-1251).
fn jet_cli_flash_safe_openocd_image_name(name: String) -> Bool Never! {
    if name.is_empty() || name == "." || name == ".." -> return false
    loop byte in name.bytes() {
        code :: Int.from_u8(byte)
        if !jet_cli_flash_ascii_alnum(code) && code != 46 && code != 45 && code != 95 -> return false
    }
    true
}
// Rust status_value (CmdFlash.rs:1253-1272); Dyn objects retain ordered pairs.
fn jet_cli_flash_status_value(value: CanonicalJSON) -> Dyn Never! {
    if value == {
        .Null -> Dyn.Null
        .Bool(flag) -> Dyn.Bool(flag)
        .Integer(text) -> Dyn.Int(Int.parse(text) ?? panic("canonical flash integer must fit status integer"))
        // copy: `text` is a payload view of `value` (owner: the caller, a read parameter: no move
        // out of it, E0201); the Dyn text owns its own.
        .String(text) -> Dyn.Text(text.copy())
        .Array(values) -> {
            rows := [Dyn]{}
            loop row in values -> &rows.push(jet_cli_flash_status_value(row))
            Dyn.Array(rows)
        }
        .Object(values) -> {
            fields := [(key: String, value: Dyn)]{}
            // copy: `row.key` stays in the iterated collection (`row` is a view of its element; no
            // move out of an element, E0225) and the field `key` owns its own.
            loop row in values -> &fields.push((key: row.key.copy(), value: jet_cli_flash_status_value(row.value)))
            Dyn.Object(fields)
        }
    }
}
// Rust programmer_json (CmdFlash.rs:1338-1377).
fn jet_cli_flash_programmer_json(facts: MIRTargetProgrammerFacts) -> CanonicalJSON Never! {
    config := [CanonicalJSON]{}
    // copy: `value` stays in the iterated collection (`value` is a view of its element; no move out
    // of an element, E0225) and the new `CanonicalJSON.String` value owns its own.
    loop value in facts.config -> &config.push(CanonicalJSON.String(value.copy()))
    CanonicalJSON.Object([CanonicalJSONField]{
        {key: "adapter", value: CanonicalJSON.String(jet_target_programmer_adapter_name(facts.adapter))},
        {key: "chip", value: jet_cli_flash_optional_json(facts.chip)},
        {key: "config", value: CanonicalJSON.Array(config)},
        {key: "cpu", value: jet_cli_flash_optional_json(facts.cpu)},
        // copy: `facts.executable` stays with the caller (`facts` is a read parameter: no move out
        // of it, E0201) and the new `CanonicalJSON.String` value owns its own.
        {key: "executable", value: CanonicalJSON.String(facts.executable.copy())},
        {key: "interface", value: jet_cli_flash_optional_json(facts.interface)},
        {key: "machine", value: jet_cli_flash_optional_json(facts.machine)},
        {key: "reset", value: CanonicalJSON.Bool(facts.reset)},
        {key: "speed_khz", value: if facts.speed_khz == .Val(speed) -> CanonicalJSON.Integer("{speed}") else -> CanonicalJSON.Null},
    })
}
// copy: `text` is a payload view of `value` (owner: the caller, a read parameter: no move out of
// it, E0201); the JSON string owns its own.
fn jet_cli_flash_optional_json(value: String?) -> CanonicalJSON Never! { if value == .Val(text) -> CanonicalJSON.String(text.copy()) else -> CanonicalJSON.Null }
// Rust programmer_value (CmdFlash.rs:1303-1336).
fn jet_cli_flash_programmer_value(facts: MIRTargetProgrammerFacts) -> Dyn Never! { jet_cli_flash_status_value(jet_cli_flash_programmer_json(facts)) }
// Rust plan_value (CmdFlash.rs:1274-1301).
fn jet_cli_flash_plan_value(plan: JetCLIFlashPlan) -> Dyn Never! { jet_cli_flash_status_value(jet_cli_flash_plan_json(plan)) }
