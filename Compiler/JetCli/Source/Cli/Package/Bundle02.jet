fn game_effect_identity(renderer: String, backend: String) -> String {
    effect :: if renderer == "raylib" -> "GPU" else -> "none"
    "sha256:{sha256_hex(\"jet-game-effect-v1{TEXT_NUL}{backend}{TEXT_NUL}{effect}\".as_bytes())}"
}

// Rust: Source/CmdPackage.rs:2510
fn cook_game_assets(root: OSPath, tree: [GameTreeFile], header: GameHeader,
    force_clean: Bool, resume: Bool, dry_run: Bool) -> CookedGameAssets Err! {
    assets := [GameBundleAsset]{}
    loop file in tree {
        if file.relative.strip_prefix("assets/") == .Some(path) {
            if header.cook_mode == "scripts-only" && !is_game_script(path) -> continue
            if header.development_stripping && is_game_debug_asset(path) -> continue
            validate_game_asset_relative_path(path)?
            assets.push(GameBundleAsset.new(path, file.mode, file.bytes))
        }
    }
    assets.sort_by((left, right) -> left.path.cmp(right.path).then(left.digest().cmp(right.digest())))
    digest_input := [UInt8]{}
    digest_input.extend_from_slice("jet-game-cook-assets-v1{TEXT_NUL}".as_bytes())
    loop asset in assets {
        frame(&digest_input, asset.path.as_bytes())
        digest_input.extend_from_slice(asset.mode.to_be_bytes())
        frame(&digest_input, asset.bytes)
    }
    asset_digest :: sha256_hex(digest_input)
    identity :: sha256_hex("jet-game-cook-v1{TEXT_NUL}{header.target}{TEXT_NUL}{header.profile}{TEXT_NUL}{header.backend}{TEXT_NUL}{header.cook_mode}{TEXT_NUL}{asset_digest}".as_bytes())
    invalidation :: if force_clean -> {
        if header.cook_mode == "scripts-only" -> "forced-clean requested; scripts-only asset set rebuilt" else -> "forced-clean requested; asset set rebuilt"
    } else if header.cook_mode == "scripts-only" -> "scripts-only invalidation scope" else -> "asset content or cook identity changed"
    if dry_run -> return Ok(CookedGameAssets{assets: assets, digest: "sha256:{asset_digest}", cache_hit: false, invalidation: "dry-run {header.cook_mode} cook planned"})
    if header.cook_mode == "fast" -> return Ok(CookedGameAssets{assets: assets, digest: "sha256:{asset_digest}", cache_hit: false,
        invalidation: if force_clean -> "forced-clean requested; fast on-the-fly cook bypassed persistent cache" else -> "fast on-the-fly cook; persistent cache bypassed"})
    cache_root :: root.join(".jet").join("game-cache")
    object_root :: cache_root.join("objects")
    cooked_root :: cache_root.join("cooked")
    fs.create_dir_all(object_root).map_err((error) -> "could not create game asset cache `{object_root.display()}`: {error}")?
    fs.create_dir_all(cooked_root).map_err((error) -> "could not create game cook cache `{cooked_root.display()}`: {error}")?
    loop asset in assets -> write_content_addressed_blob(object_root, asset)?
    final_dir :: cooked_root.join(identity)
    marker :: game_cook_marker(identity, header, asset_digest)
    if fs.symlink_metadata(final_dir).is_ok() {
        if force_clean {
            ensure_owned_directory(final_dir, marker, "game cook cache")?
            fs.remove_dir_all(final_dir).map_err((error) -> "could not remove game cook cache `{final_dir.display()}`: {error}")?
        } else {
            ensure_owned_directory(final_dir, marker, "game cook cache")?
            cached_assets :: load_cached_game_assets(final_dir, assets)?
            return Ok(CookedGameAssets{assets: cached_assets, digest: "sha256:{asset_digest}", cache_hit: true, invalidation: "content-addressed cooked assets reused"})
        }
    }
    staging :: cooked_root.join(".{identity}-staging")
    if fs.symlink_metadata(staging).is_ok() {
        if force_clean {
            ensure_owned_directory(staging, marker, "game cook staging")?
            fs.remove_dir_all(staging).map_err((error) -> "could not remove game cook staging `{staging.display()}`: {error}")?
        } else if resume {
            ensure_owned_directory(staging, marker, "game cook staging")?
            fs.remove_dir_all(staging).map_err((error) -> "could not resume game cook staging `{staging.display()}`: {error}")?
        } else -> return Err("game cook staging `{staging.display()}` already exists; use `--resume` only after inspecting it or `--clean` for owned staging")
    }
    result :: (() -> () Err! {
        fs.create_dir(staging).map_err((error) -> "could not create game cook staging `{staging.display()}`: {error}")?
        write_atomic_bytes(staging.join("staging.json"), marker.as_bytes())?
        loop asset in assets {
            destination :: staging.join("assets").join(asset.path)
            if destination.parent() == .Some(parent) -> fs.create_dir_all(parent).map_err((error) -> "could not create cooked asset directory `{parent.display()}`: {error}")?
            fs.write(destination, asset.bytes).map_err((error) -> "could not write cooked asset `{destination.display()}`: {error}")?
            set_mode(destination, asset.mode)?
        }
        fs.rename(staging, final_dir).map_err((error) -> "could not atomically publish cooked game assets `{final_dir.display()}`: {error}")?
        Ok(())
    })()
    if result.is_err() -> cleanup_staging(staging, true)
    result?
    Ok(CookedGameAssets{assets: assets, digest: "sha256:{asset_digest}", cache_hit: false, invalidation: invalidation})
}

// Rust: Source/CmdPackage.rs:2661
fn load_cached_game_assets(cooked_dir: OSPath, expected: [GameBundleAsset]) -> [GameBundleAsset] Err! {
    assets := [GameBundleAsset]{}
    loop asset in expected {
        path :: cooked_dir.join("assets").join(asset.path)
        ensure_regular_game_file(path, "cooked game asset")?
        bytes :: fs.read(path).map_err((error) -> "could not read cooked game asset `{path.display()}`: {error}")?
        if sha256_hex(bytes) != asset.digest() -> return Err("cooked game asset `{path.display()}` has a foreign digest")
        assets.push(GameBundleAsset.new(asset.path, asset.mode, bytes))
    }
    Ok(assets)
}

// Rust: Source/CmdPackage.rs:2681
fn validate_game_asset_relative_path(path: String) -> () Err! {
    if path.is_empty() || path.contains("\\") || path.chars().any((character) -> character.is_control()) -> return Err("game asset path `{path}` is invalid")
    if path.split("/").any((component) -> component.is_empty() || component == "." || component == "..") -> return Err("game asset path `{path}` is invalid")
    Ok(())
}

// Rust: Source/CmdPackage.rs:2694
fn is_game_script(path: String) -> Bool {
    OSPath.new(path).extension().and_then((extension) -> extension.to_str()).is_some_and((extension) ->
        ["jet", "lua", "js", "ts", "gd", "json", "txt"].contains(extension.to_ascii_lowercase()))
}

// Rust: Source/CmdPackage.rs:2703
fn is_game_debug_asset(path: String) -> Bool {
    OSPath.new(path).extension().and_then((extension) -> extension.to_str()).is_some_and((extension) ->
        ["pdb", "dsym", "debug", "dbg", "map"].contains(extension.to_ascii_lowercase()))
}

// Rust: Source/CmdPackage.rs:2715
fn game_cook_marker(identity: String, header: GameHeader, asset_digest: String) -> String {
    "jet-game-cook-v1\nidentity={identity}\ntarget={header.target}\nprofile={header.profile}\nbackend={header.backend}\ncook_mode={header.cook_mode}\nassets_sha256={asset_digest}\n"
}

// Rust: Source/CmdPackage.rs:2722
fn write_content_addressed_blob(root: OSPath, asset: GameBundleAsset) -> () Err! {
    digest :: asset.digest()
    destination :: root.join(digest)
    if fs.symlink_metadata(destination).is_ok() {
        ensure_regular_game_file(destination, "game asset cache object")?
        existing :: fs.read(destination).map_err((error) -> "could not read game asset cache object `{destination.display()}`: {error}")?
        if sha256_hex(existing) != digest -> return Err("game asset cache object `{destination.display()}` has a foreign digest")
        return Ok(())
    }
    temporary :: root.join(".{digest}-{core.process.id()}")
    if fs.symlink_metadata(temporary).is_ok() -> return Err("game asset cache staging `{temporary.display()}` already exists")
    fs.write(temporary, asset.bytes).map_err((error) -> "could not write game asset cache object `{temporary.display()}`: {error}")?
    if fs.rename(temporary, destination) == .Err(error) {
        cleanup_staging(temporary, false)
        if fs.symlink_metadata(destination).is_err() -> return Err("could not publish game asset cache object `{destination.display()}`: {error}")
    }
    Ok(())
}

// Rust: Source/CmdPackage.rs:2758
fn ensure_owned_directory(path: OSPath, marker: String, label: String) -> () Err! {
    metadata :: fs.symlink_metadata(path).map_err((error) -> "could not inspect {label} `{path.display()}`: {error}")?
    if metadata.file_type().is_symlink() || !metadata.is_dir() -> return Err("{label} `{path.display()}` is not an owned directory")
    marker_path :: path.join("staging.json")
    existing :: fs.read_to_string(marker_path).map_err((error) -> "could not read {label} marker `{marker_path.display()}`: {error}")?
    if existing != marker -> return Err("{label} `{path.display()}` has a foreign or stale identity; refusing to reuse it")
    Ok(())
}

// Rust: Source/CmdPackage.rs:2776
fn write_atomic_bytes(path: OSPath, bytes: [UInt8]) -> () Err! {
    parent :: path.parent().ok_or_else(() -> "path `{path.display()}` has no parent")?
    fs.create_dir_all(parent).map_err((error) -> "could not create staging parent `{parent.display()}`: {error}")?
    file_name :: path.file_name().and_then((name) -> name.to_str()).unwrap_or("staging")
    temporary :: parent.join(".{file_name}-{core.process.id()}")
    fs.write(temporary, bytes).map_err((error) -> "could not write staging file `{temporary.display()}`: {error}")?
    fs.rename(temporary, path).map_err((error) -> {
        cleanup_staging(temporary, false)
        "could not publish staging file `{path.display()}`: {error}"
    })
}

// Rust: Source/CmdPackage.rs:2794
fn make_game_plan(options: PackageOptions, target: BundleTarget, header: GameHeader,
    executable_path: OSPath, executable_bytes: [UInt8], cooked: CookedGameAssets) -> (PackageBundlePlan, [OSPath]) Err! {
    executable_name :: options.name.or_else(() -> executable_path.file_stem().map((value) -> value.to_string_lossy().into_owned()))
        .filter((value) -> !value.is_empty()).ok_or_else(() -> "game package needs a non-empty executable name")?
    package :: options.package.unwrap_or(executable_name)
    version :: options.version.unwrap_or("0.1.0")
    display_name :: options.name.unwrap_or(package)
    metadata := BundleMetadata.new(package, display_name)
    metadata.publisher = if options.publisher.is_empty() -> "Jet" else -> options.publisher
    metadata.description = options.description
    executable :: BundleExecutable.new(executable_name, executable_path.to_string_lossy().into_owned(), executable_bytes)
    game := GameBundleSpec.new(header.profile, header.export_preset, header.source_revision, header.backend, header.renderer, header.cook_mode)
    game.build_identity = header.build_identity
    game.development_stripping = header.development_stripping
    game.crash_reporter = header.crash_reporter
    game.crash_consent = header.crash_consent
    game.crash_runtime = header.crash_runtime
    game.assets = cooked.assets
    spec := BundleSpec.game(target, package, version, executable, metadata)
    spec.game = Some(game)
    input_paths := [OSPath]{}
    if options.icon == .Some(icon_path) {
        ensure_regular_game_file(icon_path, "icon")?
        icon_bytes :: fs.read(icon_path).map_err((error) -> "could not read icon `{icon_path.display()}`: {error}")?
        format :: options.icon_format.or_else(() -> icon_path.extension().and_then((extension) -> IconFormat.parse(extension.to_string_lossy())))
            .ok_or_else(() -> "`--icon` needs `--icon-format` when the extension is unknown")?
        spec.icons.push(BundleIcon.new(package, format, options.icon_size, icon_bytes).with_source(icon_path.to_string_lossy().into_owned()))
        input_paths.push(icon_path)
    }
    if options.update_channel.is_some() != options.update_url.is_some() -> return Err("`--update-channel` and `--update-url` must be supplied together")
    if (options.update_channel, options.update_url) == (.Some(channel), .Some(url)) -> spec.updater = Some(UpdaterSpec.new(channel, url))
    plan :: PackageBundlePlan.from_spec(spec).map_err((error) -> error.to_string())?
    Ok((plan, input_paths))
}

// Rust: Source/CmdPackage.rs:2870
fn launch_game_output(path: OSPath, target: BundleTarget, renderer: String) -> UInt32 Err! {
    metadata :: fs.symlink_metadata(path).map_err((error) -> "could not inspect game package `{path.display()}`: {error}")?
    if metadata.file_type().is_symlink() -> return Err("game package `{path.display()}` must not be a symlink")
    command := if target == {
        .LinuxAppImage -> {
            if metadata.is_file() -> Command.new(path)
            else -> return Err("game target `{target.as_str()}` is not runnable by this host")
        }
        .MacOSApp -> {
            // GATE #4483
            if metadata.is_dir() && core.sys.target.selected_os() == "macos" -> Command.new("open").arg(path)
            else -> return Err("game target `{target.as_str()}` is not runnable by this host")
        }
        .WindowsMsix -> {
            if metadata.is_file() && core.sys.target.selected_os() == "windows" -> Command.new("explorer.exe").arg(path)
            else -> return Err("windows-msix game packages require a Windows host for `--run-now`")
        }
    }
    if renderer == "raylib" -> command.env("JET_RAYLIB_DISPLAY", "1")
    else -> command.env_remove("JET_RAYLIB_DISPLAY")
    child :: command.spawn().map_err((error) -> "could not launch game package `{path.display()}`: {error}")?
    Ok(child.id())
}

// Rust: Source/CmdPackage.rs:2909
fn resolve_game_destination(root: OSPath, path: OSPath) -> OSPath {
    if path.is_absolute() -> path else -> root.join(path)
}

// Rust: Source/CmdPackage.rs:2917
fn deploy_game_output(source: OSPath, destination: OSPath, force_clean: Bool) -> OSPath Err! {
    source_metadata :: fs.symlink_metadata(source).map_err((error) -> "could not inspect game package `{source.display()}`: {error}")?
    if source_metadata.file_type().is_symlink() -> return Err("game package `{source.display()}` must not be a symlink")
    if source_metadata.is_file() {
        destination_metadata :: fs.symlink_metadata(destination).ok()
        if destination_metadata == .Some(metadata) {
            if metadata.file_type().is_symlink() -> return Err("deploy destination `{destination.display()}` must not be a symlink")
        }
        final_path :: if destination_metadata.is_some_and((metadata) -> metadata.is_dir()) ->
            destination.join(source.file_name().ok_or_else(() -> "game package `{source.display()}` has no file name")?)
            else -> destination
        if fs.symlink_metadata(final_path) == .Ok(metadata) {
            if metadata.file_type().is_symlink() -> return Err("deploy destination `{final_path.display()}` must not be a symlink")
            if !force_clean -> return Err("deploy destination `{final_path.display()}` already exists; pass `--clean` to replace it")
            if metadata.is_dir() -> return Err("deploy destination `{final_path.display()}` is a directory")
            fs.remove_file(final_path).map_err((error) -> "could not replace deploy destination `{final_path.display()}`: {error}")?
        }
        parent :: final_path.parent().ok_or_else(() -> "deploy destination `{final_path.display()}` has no parent")?
        fs.create_dir_all(parent).map_err((error) -> "could not create deploy directory `{parent.display()}`: {error}")?
        file_name :: final_path.file_name().and_then((name) -> name.to_str()).unwrap_or("game")
        temporary :: parent.join(".{file_name}-deploy-{core.process.id()}")
        if fs.symlink_metadata(temporary).is_ok() -> return Err("deploy staging `{temporary.display()}` already exists")
        result :: (() -> () Err! {
            _ :: fs.copy(source, temporary).map_err((error) -> "could not copy game package `{source.display()}`: {error}")?
            set_mode(temporary, game_file_mode(source_metadata))?
            fs.rename(temporary, final_path).map_err((error) -> "could not atomically publish deployed game package `{final_path.display()}`: {error}")?
            Ok(())
        })()
        if result.is_err() -> cleanup_staging(temporary, false)
        result?
        return Ok(final_path)
    }
    if !source_metadata.is_dir() -> return Err("game package `{source.display()}` is not a regular file or directory")
    if fs.symlink_metadata(destination) == .Ok(metadata) {
        if metadata.file_type().is_symlink() -> return Err("deploy destination `{destination.display()}` must not be a symlink")
        if !force_clean -> return Err("deploy destination `{destination.display()}` already exists; pass `--clean` to replace it")
        if metadata.is_dir() -> fs.remove_dir_all(destination).map_err((error) -> "could not replace deploy destination `{destination.display()}`: {error}")?
        else -> fs.remove_file(destination).map_err((error) -> "could not replace deploy destination `{destination.display()}`: {error}")?
    }
    parent :: destination.parent().ok_or_else(() -> "deploy destination `{destination.display()}` has no parent")?
    fs.create_dir_all(parent).map_err((error) -> "could not create deploy directory `{parent.display()}`: {error}")?
    file_name :: destination.file_name().and_then((name) -> name.to_str()).unwrap_or("game")
    temporary :: parent.join(".{file_name}-deploy-{core.process.id()}")
    if fs.symlink_metadata(temporary).is_ok() -> return Err("deploy staging `{temporary.display()}` already exists")
    result :: (() -> () Err! {
        fs.create_dir(temporary).map_err((error) -> "could not create deploy staging `{temporary.display()}`: {error}")?
        copy_game_directory(source, temporary)?
        set_mode(temporary, game_file_mode(source_metadata))?
        fs.rename(temporary, destination).map_err((error) -> "could not atomically publish deployed game package `{destination.display()}`: {error}")?
        Ok(())
    })()
    if result.is_err() -> cleanup_staging(temporary, true)
    result?
    Ok(destination)
}

// Rust: Source/CmdPackage.rs:3040
fn copy_game_directory(source: OSPath, destination: OSPath) -> () Err! {
    entries := fs.read_dir(source).map_err((error) -> "could not enumerate game package `{source.display()}`: {error}")?
        .collect_result().map_err((error) -> "could not enumerate game package `{source.display()}`: {error}")?
    entries.sort_by((left, right) -> left.file_name().cmp(right.file_name()))
    loop entry in entries {
        source_path :: entry.path()
        destination_path :: destination.join(entry.file_name())
        metadata :: fs.symlink_metadata(source_path).map_err((error) -> "could not inspect game package `{source_path.display()}`: {error}")?
        if metadata.file_type().is_symlink() -> return Err("game package `{source_path.display()}` must not contain symlinks")
        if metadata.is_dir() {
            fs.create_dir(destination_path).map_err((error) -> "could not create deployed game directory `{destination_path.display()}`: {error}")?
            copy_game_directory(source_path, destination_path)?
            set_mode(destination_path, game_file_mode(metadata))?
        } else if metadata.is_file() {
            _ :: fs.copy(source_path, destination_path).map_err((error) -> "could not copy deployed game file `{source_path.display()}`: {error}")?
            set_mode(destination_path, game_file_mode(metadata))?
        } else -> return Err("game package `{source_path.display()}` is not a regular file or directory")
    }
    Ok(())
}

// Rust: Source/CmdPackage.rs:3070
fn stage_game_plan(root: OSPath, plan: PackageBundlePlan, force_clean: Bool, resume: Bool, dry_run: Bool) -> OSPath Err! {
    stage_root :: root.join(".jet").join("game-stages")
    identity :: plan.identity.replace(":", "-")
    final_dir :: stage_root.join(identity)
    if dry_run -> return Ok(final_dir)
    marker :: CanonicalJson.object([
        ("plan_identity", CanonicalJson.String(plan.identity)),
        ("schema", CanonicalJson.String("jet.game.stage")),
    ]).map_err((error) -> "could not create game stage marker: {error}")?.bytes()
    if fs.symlink_metadata(final_dir).is_ok() {
        ensure_game_stage_marker(final_dir, marker)?
        if force_clean -> fs.remove_dir_all(final_dir).map_err((error) -> "could not remove game stage `{final_dir.display()}`: {error}")?
        else -> return Ok(final_dir)
    } else if resume -> return Err("no resumable game stage exists for plan `{plan.identity}`")
    fs.create_dir_all(stage_root).map_err((error) -> "could not create game stage root `{stage_root.display()}`: {error}")?
    staging :: stage_root.join(".{identity}-staging")
    if fs.symlink_metadata(staging).is_ok() -> return Err("game stage `{staging.display()}` already exists; refusing stale or foreign staging")
    result :: (() -> () Err! {
        fs.create_dir(staging).map_err((error) -> "could not create game stage `{staging.display()}`: {error}")?
        write_atomic_bytes(staging.join("staging.json"), marker)?
        write_atomic_bytes(staging.join("plan.json"), plan.to_json().bytes())?
        loop file in plan.files {
            destination :: staging.join("files").join(file.path)
            if destination.parent() == .Some(parent) -> fs.create_dir_all(parent).map_err((error) -> "could not create staged game directory `{parent.display()}`: {error}")?
            fs.write(destination, file.bytes).map_err((error) -> "could not write staged game file `{destination.display()}`: {error}")?
            set_mode(destination, file.mode)?
        }
        fs.rename(staging, final_dir).map_err((error) -> "could not atomically publish game stage `{final_dir.display()}`: {error}")?
        Ok(())
    })()
    if result.is_err() -> cleanup_staging(staging, true)
    result?
    Ok(final_dir)
}

// Rust: Source/CmdPackage.rs:3146
fn verify_game_stage_files(stage: OSPath, plan: PackageBundlePlan) -> () Err! {
    marker :: CanonicalJson.object([
        ("plan_identity", CanonicalJson.String(plan.identity)), ("schema", CanonicalJson.String("jet.game.stage")),
    ]).map_err((error) -> "could not create game stage marker: {error}")?.bytes()
    ensure_game_stage_marker(stage, marker)?
    loop file in plan.files {
        path :: stage.join("files").join(file.path)
        ensure_regular_game_file(path, "staged game file")?
        bytes :: fs.read(path).map_err((error) -> "could not read staged game file `{path.display()}`: {error}")?
        if bytes != file.bytes || sha256_hex(bytes) != file.digest() -> return Err("staged game file `{path.display()}` has a foreign digest")
        metadata :: fs.symlink_metadata(path).map_err((error) -> "could not inspect staged game file `{path.display()}`: {error}")?
        if game_file_mode(metadata) != file.mode -> return Err("staged game file `{path.display()}` has a foreign mode")
    }
    Ok(())
}

// Rust: Source/CmdPackage.rs:3171
fn export_game_output(root: OSPath, plan: PackageBundlePlan, target: BundleTarget, preset: String, force_clean: Bool) -> (OSPath, MaterializedFacts) Err! {
    if plan.target != target -> return Err("export target `{target.as_str()}` does not match package plan target `{plan.target.as_str()}`")
    if preset == "store" && target != BundleTarget.WindowsMsix -> return Err("the `store` export preset requires `windows-msix`")
    if preset == "headless" && plan.game.is_some_and((game) -> game.renderer != "headless") -> return Err("the `headless` export preset requires a headless renderer")
    export_root :: root.join(".jet").join("game-exports").join(preset)
    fs.create_dir_all(export_root).map_err((error) -> "could not create game export directory `{export_root.display()}`: {error}")?
    destination :: export_root.join(plan.artifact_name)
    prepare_export_destination(destination, force_clean)?
    facts :: materialize_package(plan, destination)?
    Ok((destination, facts))
}

// Rust: Source/CmdPackage.rs:3205
fn prepare_export_destination(path: OSPath, force_clean: Bool) -> () Err! {
    metadata :: if fs.symlink_metadata(path) == {
        .Ok(metadata) -> metadata
        .Err(error) -> {
            if error.kind() == .NotFound -> return Ok(()) // GATE #4409
            return Err("could not inspect existing export `{path.display()}`: {error}")
        }
    }
    if metadata.file_type().is_symlink() -> return Err("export destination `{path.display()}` must not be a symlink")
    if !force_clean -> return Err("export destination `{path.display()}` already exists; pass `--clean` to replace an owned export")
    (if metadata.is_dir() -> fs.remove_dir_all(path) else -> fs.remove_file(path))
        .map_err((error) -> "could not remove existing export `{path.display()}`: {error}")
}

// Rust: Source/CmdPackage.rs:3233
fn cancel_game_stages(root: OSPath) -> (OSPath?, String) Err! {
    stage_root :: root.join(".jet").join("game-stages")
    metadata :: if fs.symlink_metadata(stage_root) == {
        .Ok(metadata) -> metadata
        .Err(error) -> {
            if error.kind() == .NotFound -> return Ok((None, "no owned game staging exists")) // GATE #4409
            return Err("could not inspect game stage root `{stage_root.display()}`: {error}")
        }
    }
    if metadata.file_type().is_symlink() || !metadata.is_dir() -> return Err("game stage root `{stage_root.display()}` is not an owned directory")
    cancelled := OSPath?{None}
    entries :: fs.read_dir(stage_root).map_err((error) -> "could not enumerate game stages `{stage_root.display()}`: {error}")?
        .collect_result().map_err((error) -> "could not enumerate game stages `{stage_root.display()}`: {error}")?
    loop entry in entries {
        path :: entry.path()
        name :: entry.file_name().to_string_lossy().into_owned()
        if name.starts_with(".") && !name.ends_with("-staging") -> continue
        path_metadata :: fs.symlink_metadata(path).map_err((error) -> "could not inspect game stage `{path.display()}`: {error}")?
        if path_metadata.file_type().is_symlink() || !path_metadata.is_dir() -> return Err("game stage `{path.display()}` is not an owned directory")
        marker :: fs.read(path.join("staging.json")).map_err((error) -> "could not read game stage marker `{path.join(\"staging.json\").display()}`: {error}")?
        schema :: "\"schema\":\"jet.game.stage\"".as_bytes()
        if !marker.windows(schema.len()).any((window) -> window == schema) -> return Err("game stage `{path.display()}` has a foreign marker; refusing cancellation")
        fs.remove_dir_all(path).map_err((error) -> "could not cancel game stage `{path.display()}`: {error}")?
        cancelled = Some(path)
    }
    Ok((cancelled, "owned canonical game stages cancelled"))
}

// Rust: Source/CmdPackage.rs:3291
fn ensure_game_stage_marker(path: OSPath, expected: [UInt8]) -> () Err! {
    metadata :: fs.symlink_metadata(path).map_err((error) -> "could not inspect game stage `{path.display()}`: {error}")?
    if metadata.file_type().is_symlink() || !metadata.is_dir() -> return Err("game stage `{path.display()}` is not an owned directory")
    marker :: path.join("staging.json")
    bytes :: fs.read(marker).map_err((error) -> "could not read game stage marker `{marker.display()}`: {error}")?
    if bytes != expected -> return Err("game stage `{path.display()}` has a foreign or stale identity; refusing to reuse it")
    Ok(())
}

use jet_foundation.[CanonicalJson, StatusFields, StatusEnvelope]
use jet.ReceiptStore.[ReceiptStore, ReceiptSection, Receipt, receipt_root_for]

// Rust: Source/CmdPackage.rs:3309
fn game_phase(phase: String, status: String, header: GameHeader, started: Instant,
    cache_hit: Bool, invalidation: String, output: String?, sha256: String?, bytes: UInt64?, diagnostic: GameDiagnostic?) -> GamePhaseReceipt {
    GamePhaseReceipt{phase: phase, status: status, header: header, cache_hit: cache_hit,
        invalidation: invalidation, output: output, sha256: sha256, bytes: bytes,
        duration_ms: UInt64.from(started.elapsed().as_millis()), diagnostic: diagnostic}
}

// Rust: Source/CmdPackage.rs:3335
fn game_phase_json(phase: GamePhaseReceipt) -> CanonicalJson {
    CanonicalJson.object([
        ("authority_identity", CanonicalJson.String(phase.header.authority_identity)),
        ("backend", CanonicalJson.String(phase.header.backend)),
        ("build_identity", CanonicalJson.String(phase.header.build_identity)),
        ("bytes", phase.bytes.map(json_integer).unwrap_or(CanonicalJson.Null)),
        ("cache_hit", CanonicalJson.Bool(phase.cache_hit)),
        ("cook_mode", CanonicalJson.String(phase.header.cook_mode)),
        ("crash_consent", CanonicalJson.String(phase.header.crash_consent)),
        ("crash_reporter", CanonicalJson.String(phase.header.crash_reporter)),
        ("crash_runtime", game_crash_runtime_json(phase.header.crash_runtime)),
        ("development_stripping", CanonicalJson.Bool(phase.header.development_stripping)),
        ("diagnostic", phase.diagnostic.map(game_diagnostic_json).unwrap_or(CanonicalJson.Null)),
        ("duration_ms", json_integer(phase.duration_ms)),
        ("effect_identity", CanonicalJson.String(phase.header.effect_identity)),
        ("invalidation", CanonicalJson.String(phase.invalidation)),
        ("output", phase.output.map(json_text_value).unwrap_or(CanonicalJson.Null)),
        ("phase", CanonicalJson.String(phase.phase)),
        ("profile", CanonicalJson.String(phase.header.profile)),
        ("renderer", CanonicalJson.String(phase.header.renderer)),
        ("sha256", phase.sha256.map(json_text_value).unwrap_or(CanonicalJson.Null)),
        ("source_revision", CanonicalJson.String(phase.header.source_revision)),
        ("status", CanonicalJson.String(phase.status)),
        ("target", CanonicalJson.String(phase.header.target)),
    ]).expect("fixed game phase JSON keys")
}

