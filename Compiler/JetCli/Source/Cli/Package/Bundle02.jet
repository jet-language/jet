fn game_materializer_json(materializer: BundleMaterializerFact) -> CanonicalJson {
    CanonicalJson.object([
        ("authority", json_text_value(materializer.authority)), ("executable", json_text_value(materializer.executable)),
        ("mechanism", json_text_value(materializer.mechanism)), ("policy", json_text_value(materializer.policy)),
        ("tool", json_text_value(materializer.tool)), ("tool_identity", json_text_value(materializer.tool_identity)),
        ("tool_version", json_text_value(materializer.tool_version)),
    ]).expect("fixed game materializer JSON keys")
}

// Rust: Source/CmdPackage.rs:3442
fn game_report_json(header: GameHeader, phases: [String], receipts: [GamePhaseReceipt],
    plan_identity: String?, plan: PackageBundlePlan?, artifact_sha256: String?, output: OSPath?,
    artifact: PackageBundleArtifact?, explain: Bool, planned: Bool) -> CanonicalJson {
    status :: if receipts.iter().any((phase) -> phase.status == "error" || phase.diagnostic != None) -> "error"
        else if receipts.iter().any((phase) -> phase.status == "cancelled") -> "cancelled" else -> "ok"
    execution :: if planned -> "planned" else if artifact != None -> "materialized" else -> "not-materialized"
    artifact_status :: if artifact != None -> "materialized" else if plan != None -> "planned" else -> "none"
    signing_status :: artifact.map((value) -> value.receipt.signing_status().as_str())
        .or_else(() -> plan.map((value) -> if value.signing_hooks.is_empty() -> "not-requested" else -> "requested")).unwrap_or("not-requested")
    materialization :: game_materialization_json(execution, artifact_sha256, output, artifact)
    fields := [
        ("artifact", artifact.map((value) -> value.to_json()).unwrap_or(CanonicalJson.Null)),
        ("artifact_status", json_text_value(artifact_status)),
        ("artifact_sha256", artifact_sha256.map(json_text_value).unwrap_or(CanonicalJson.Null)),
        ("execution", json_text_value(execution)),
        ("authority_identity", CanonicalJson.String(header.authority_identity)),
        ("backend", CanonicalJson.String(header.backend)),
        ("build_identity", CanonicalJson.String(header.build_identity)),
        ("cook_mode", CanonicalJson.String(header.cook_mode)),
        ("crash_consent", CanonicalJson.String(header.crash_consent)),
        ("crash_reporter", CanonicalJson.String(header.crash_reporter)),
        ("development_stripping", CanonicalJson.Bool(header.development_stripping)),
        ("crash_runtime", game_crash_runtime_json(header.crash_runtime)),
        ("effect_identity", CanonicalJson.String(header.effect_identity)),
        ("export_preset", CanonicalJson.String(header.export_preset)),
        ("format", CanonicalJson.String(GAME_PACKAGE_RECEIPT_SCHEMA)),
        ("output", output.map((path) -> json_text_value(path.display().to_string())).unwrap_or(CanonicalJson.Null)),
        ("materialization", materialization),
        ("phases", CanonicalJson.Array(receipts.iter().map(game_phase_json).collect())),
        ("plan", plan.map((value) -> value.to_json()).unwrap_or(CanonicalJson.Null)),
        ("plan_identity", plan_identity.map(json_text_value).unwrap_or(CanonicalJson.Null)),
        ("profile", CanonicalJson.String(header.profile)),
        ("renderer", CanonicalJson.String(header.renderer)),
        ("requested_phases", CanonicalJson.Array(phases.iter().map(json_text_value).collect())),
        ("schema", CanonicalJson.String(GAME_PACKAGE_RECEIPT_SCHEMA)),
        ("source_revision", CanonicalJson.String(header.source_revision)),
        ("status", CanonicalJson.String(status)),
        ("planned", CanonicalJson.Bool(planned)),
        ("target", CanonicalJson.String(header.target)),
        ("signing_status", json_text_value(signing_status)),
    ]
    if explain {
        cook :: receipts.iter().find((phase) -> phase.phase == "cook")
        cache_identity :: cook.and_then((phase) -> phase.sha256).unwrap_or("not computed")
        fields.push(("explain", CanonicalJson.object([
            ("authority_identity", json_text_value(header.authority_identity)),
            ("cache_identity", json_text_value(cache_identity)), ("execution", json_text_value(execution)),
            ("planned", CanonicalJson.Bool(planned)),
            ("inputs", artifact.map((value) -> value.receipt.to_json()).or_else(() -> plan.map((value) -> value.to_json())).unwrap_or(CanonicalJson.Null)),
            ("phases", CanonicalJson.Array(receipts.iter().map((phase) -> json_text_value(phase.phase)).collect())),
            ("pipeline", CanonicalJson.Array(phases.iter().map(json_text_value).collect())),
        ]).expect("fixed game explanation JSON keys")))
    }
    CanonicalJson.object(fields).expect("fixed game package receipt JSON keys")
}

// Rust: Source/CmdPackage.rs:3558
fn json_text_value(value: String) -> CanonicalJson { CanonicalJson.String(value) }

// Rust: Source/CmdPackage.rs:3562
fn json_integer[T: ToString](value: T) -> CanonicalJson { CanonicalJson.Integer(value.to_string()) }

// Rust: Source/CmdPackage.rs:3565
fn write_game_receipt(path: OSPath, report: CanonicalJson) -> () Err! {
    bytes :: report.bytes()
    write_atomic_bytes(path, bytes)
}

// Rust: Source/CmdPackage.rs:3570
fn record_game_receipt(args: [String], input_paths: [OSPath], report: CanonicalJson, phases: [GamePhaseReceipt]) -> Receipt Err! {
    cwd :: core.env.current_dir().map_err((error) -> "could not read current directory: {error}")?
    root :: receipt_root_for("package", args, cwd)
    store :: ReceiptStore.new(root)
    sections := [ReceiptSection].with_capacity(phases.len() + 1)
    sections.push(ReceiptSection.from_json("game", "GamePackageReceipt", report)
        .map_err((error) -> "could not encode game package receipt section: {error}")?)
    loop phase in phases {
        sections.push(ReceiptSection.from_json("game.{phase.phase}", "GamePhaseReceipt", game_phase_json(phase))
            .map_err((error) -> "could not encode {phase.phase} receipt section: {error}")?)
    }
    store.record_with_sections("package", args, input_paths, 0, report.bytes(), [], sections)
}

// Rust: Source/CmdPackage.rs:3610
fn render_game_report(run: GameRun, report_path: OSPath, receipt_digest: String, mode: OutputMode) -> {
    if mode.json {
        game :: status_value(run.report)
        fields :: StatusFields.new().with("kind", "game").with("game", game)
            .with("receipt", report_path.display().to_string()).with("receipt_digest", receipt_digest)
        println("{StatusEnvelope.new(\"package\", run.success).with_fields(fields).json()}")
        return
    }
    state :: if run.success -> "ok" else -> "error"
    println("game package: {state}")
    if run.phases.first() == .Some(phase) -> println("target: {phase.header.target} profile: {phase.header.profile} backend: {phase.header.backend} renderer: {phase.header.renderer}")
    loop phase in run.phases {
        suffix :: phase.output.map((output) -> " ({output})").unwrap_or("")
        println("{phase.phase}: {phase.status}{suffix}")
    }
    if run.output == .Some(output) -> println("output: {output.display()}")
    println("receipt: {report_path.display()} ({receipt_digest})")
}

