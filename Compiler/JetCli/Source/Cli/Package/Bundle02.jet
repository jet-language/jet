use jet_foundation.TEXT_NUL
use jet.Package.PackageFacts
use jet.SHA256.sha256_hex
use core.files as fs
use core.time.Instant
use core.process.Command
// GATE #4494: native filesystem, clock and child-process operations.

// Rust: Source/CmdPackage.rs:1493
fn execute_game_package(options: PackageOptions) -> GameRun Err! {
    planned :: options.dry_run || options.explain
    target :: options.target.ok_or_else(() -> "`jet package --kind game` needs an explicit `--target`")?
    profile :: options.profile.unwrap_or("release")
    validate_game_profile_name(profile)?
    backend :: options.backend.unwrap_or("aot")
    if backend != "aot" -> return Err("unsupported game backend `{backend}`; the only artifact-producing backend is `aot`")
    renderer :: options.renderer.unwrap_or("headless")
    if renderer != "headless" && renderer != "raylib" -> return Err("unknown game renderer `{renderer}`; use `headless` or `raylib`")
    export_preset :: options.export_preset.unwrap_or("default")
    if export_preset != "default" && export_preset != "store" && export_preset != "headless" -> return Err("unknown game export preset `{export_preset}`; use `default`, `store`, or `headless`")
    if export_preset == "headless" && renderer != "headless" -> return Err("the `headless` export preset requires `--renderer headless`")
    requested_cook_mode :: options.cook_mode
    crash_reporter :: options.crash_reporter.unwrap_or("off")
    if crash_reporter != "off" && crash_reporter != "on" && crash_reporter != "opt-in" -> return Err("unknown crash reporter policy `{crash_reporter}`; use `off`, `on`, or `opt-in`")
    crash_consent :: options.crash_consent.unwrap_or("not-requested")
    if crash_consent != "not-requested" && crash_consent != "granted" && crash_consent != "denied" -> return Err("unknown crash reporter consent `{crash_consent}`; use `not-requested`, `granted`, or `denied`")
    if crash_reporter == "on" && crash_consent != "granted" -> return Err("crash reporter `on` requires `--crash-consent granted`")
    if crash_reporter == "off" && crash_consent == "granted" -> return Err("crash reporter consent cannot be granted when the reporter is off")
    phases :: game_phase_names(options.phase)?
    (root, source_entry) :: resolve_game_root(options)?
    generated_hint :: source_entry.unwrap_or_else(() -> root.join("run.jet"))
    generated_root :: generated_project_root(generated_hint)?
    tree :: collect_game_tree(root)?
    facts :: PackageFacts.load_checked(root).map_err((error) -> "could not load package authority in `{root.display()}`: {error}")?
    source_revision :: game_source_revision(tree, facts)
    validate_declared_game_profile(profile, facts)?
    declared_profile :: facts.and_then((facts) -> facts.build_profiles.iter().find((candidate) -> candidate.name == profile))
    cook_mode :: requested_cook_mode.unwrap_or_else(() -> declared_profile.and_then((candidate) -> candidate.game_cook_mode)
        .unwrap_or_else(() -> if options.scripts_only -> "scripts-only" else if profile_is_development(profile) -> "fast" else -> "reproducible"))
    if cook_mode != "fast" && cook_mode != "reproducible" && cook_mode != "scripts-only" -> return Err("unknown game cook mode `{cook_mode}`; use `fast`, `reproducible`, or `scripts-only`")
    if options.scripts_only && cook_mode != "scripts-only" -> return Err("`--scripts-only` conflicts with an explicit non-script cook mode")
    development_stripping :: declared_profile.and_then((candidate) -> candidate.game_development_stripping).unwrap_or_else(() -> !profile_is_development(profile))
    authority_result :: game_authority_identity(facts, renderer)
    authority_error :: authority_result.err()
    authority_identity :: authority_result.unwrap_or_else((_) -> "rejected")
    effect_identity :: game_effect_identity(renderer, backend)
    header := GameHeader{target: target.as_str(), profile: profile, backend: backend, renderer: renderer,
        cook_mode: cook_mode, export_preset: export_preset, source_revision: source_revision, build_identity: "planned",
        authority_identity: authority_identity, effect_identity: effect_identity, development_stripping: development_stripping,
        crash_reporter: crash_reporter, crash_consent: crash_consent, crash_runtime: requested_game_crash_runtime(crash_reporter, crash_consent)}
    if authority_error == .Some(error) {
        authority_started :: Instant.now()
        diagnostic :: game_authority_diagnostic(error)
        phase :: game_phase("authority", "error", header, authority_started, false, "renderer effect is not authorized", None, None, None, Some(diagnostic))
        report :: game_report_json(header, ["authority"], [phase], None, None, None, None, None, options.explain, planned)
        return Ok(GameRun{report: report, phases: [phase], input_paths: tree.iter().map((file) -> root.join(file.relative)).collect(),
            root: generated_root, output: None, success: false})
    }
    validate_game_renderer_selection(renderer, tree)?
    if options.cancel {
        cancel_started :: Instant.now()
        (cancelled, status, invalidation) :: if planned -> (None, "planned", "dry-run cancellation planned") else -> {
            (cancelled, invalidation) :: cancel_game_stages(generated_root)?
            (cancelled, "cancelled", invalidation)
        }
        phase :: game_phase("cancel", status, header, cancel_started, false, invalidation, cancelled.map((path) -> path.display().to_string()), None, None, None)
        report :: game_report_json(header, ["cancel"], [phase], None, None, None, None, None, options.explain, planned)
        return Ok(GameRun{report: report, phases: [phase], input_paths: tree.iter().map((file) -> root.join(file.relative)).collect(),
            root: generated_root, output: None, success: true})
    }
    input_paths := tree.iter().map((file) -> root.join(file.relative)).collect()
    phases_receipt := [GamePhaseReceipt]{}
    build_started :: Instant.now()
    (executable_path, executable_bytes, build_cache_hit, build_invalidation) :: if options.executable == .Some(path) -> {
        ensure_regular_game_file(path, "executable")?
        bytes :: fs.read(path).map_err((error) -> "could not read executable `{path.display()}`: {error}")?
        (path, bytes, true, "explicit executable input")
    } else if source_entry == .Some(entry) -> {
        if planned -> (generated_root.join(".jet").join("build").join(jet.CmdCompile.stem(entry.to_string_lossy())), [], false, "dry-run build planned from source")
        else -> {
            path :: build_game_entry(root, entry, profile, target)?
            bytes :: fs.read(path).map_err((error) -> "could not read built game executable `{path.display()}`: {error}")?
            (path, bytes, false, "source revision changed or build cache missed")
        }
    } else if planned -> (generated_root.join(".jet").join("build").join("game"), [], false, "dry-run build planned without a source entry")
    else -> return Err("game packaging needs `--executable <path>` or a project source entry")
    if !executable_bytes.is_empty() && header.crash_reporter != "off" && header.crash_consent == "granted" {
        if !executable_bytes.windows(GAME_CRASH_REPORTER_ABI.len()).any((window) -> window == GAME_CRASH_REPORTER_ABI.as_bytes()) {
            return Err("active game crash reporter requires a binary built with Jet's game reporter bootstrap; build from a game source entry or use `--crash-reporter off`")
        }
        header.crash_runtime = GameCrashReporterSpec.installed()
    }
    header.build_identity = if executable_bytes.is_empty() -> "planned" else -> {
        executable_digest :: sha256_hex(executable_bytes)
        "sha256:{sha256_hex(\"jet-game-build-v1{TEXT_NUL}{source_revision}{TEXT_NUL}{target.as_str()}{TEXT_NUL}{backend}{TEXT_NUL}{renderer}{TEXT_NUL}{executable_digest}\".as_bytes())}"
    }
    phases_receipt.push(game_phase("build", "planned", header, build_started, build_cache_hit, build_invalidation,
        Some(executable_path.display().to_string()), if executable_bytes.is_empty() -> None else -> Some(sha256_hex(executable_bytes)),
        Some(UInt64.from(executable_bytes.len())), None))
    if !planned && phases_receipt.last_mut() == .Some(phase) -> phase.status = "ok"
    input_paths.push(executable_path)
    dedup_paths(&input_paths)
    cooked := CookedGameAssets?{None}
    if phases.iter().any((phase) -> phase == "cook") {
        cook_started :: Instant.now()
        result :: cook_game_assets(generated_root, tree, header, options.force_clean, options.resume, planned)?
        cook_output :: if header.cook_mode == "fast" -> "on-the-fly cook (persistent cache bypassed)" else -> generated_root.join(".jet").join("game-cache").display().to_string()
        phases_receipt.push(game_phase("cook", if planned -> "planned" else -> "ok", header, cook_started, result.cache_hit,
            result.invalidation, Some(cook_output), Some(result.digest), Some(result.assets.iter().map((asset) -> UInt64.from(asset.bytes.len())).sum()), None))
        cooked = Some(result)
    }
    plan := PackageBundlePlan?{None}
    stage_root := OSPath?{None}
    output := OSPath?{None}
    artifact := PackageBundleArtifact?{None}
    if phases.iter().any((phase) -> phase == "stage") {
        cooked_assets :: cooked.ok_or_else(() -> "game stage requires the cook phase")?
        (game_plan, package_inputs) :: make_game_plan(options, target, header, executable_path, executable_bytes, cooked_assets)?
        input_paths.extend(package_inputs)
        dedup_paths(&input_paths)
        stage_started :: Instant.now()
        stage_path :: stage_game_plan(generated_root, game_plan, options.force_clean, options.resume, planned)?
        stage_root = Some(stage_path)
        invalidation :: if options.force_clean -> "forced-clean requested" else if options.resume -> "resumed canonical plan staging" else -> "new canonical plan staging"
        phases_receipt.push(game_phase("stage", "planned", header, stage_started, false, invalidation,
            Some(stage_path.display().to_string()), Some(game_plan.identity), Some(game_plan.files.iter().map((file) -> UInt64.from(file.bytes.len())).sum()), None))
        if !planned && phases_receipt.last_mut() == .Some(phase) -> phase.status = "ok"
        output = Some(resolve_output_path(options.output, game_plan.artifact_name)?)
        plan = Some(game_plan)
    }
    if phases.iter().any((phase) -> phase == "package") {
        package_started :: Instant.now()
        game_plan :: plan.ok_or_else(() -> "game package requires the stage phase")?
        package_output :: output.ok_or_else(() -> "game package has no output path")?
        if planned {
            phases_receipt.push(game_phase("package", "planned", header, package_started, false, "dry-run materialization planned",
                Some(package_output.display().to_string()), Some(game_plan.identity), Some(game_plan.files.iter().map((file) -> UInt64.from(file.bytes.len())).sum()), None))
        } else {
            stage_path :: stage_root.ok_or_else(() -> "game package requires the canonical stage output")?
            verify_game_stage_files(stage_path, game_plan)?
            materialized :: materialize_package(game_plan, package_output)?
            packaged := game_plan.materialized_artifact(materialized.sha256, materialized.bytes)
            packaged.receipt.record_materializer(materialized.materializer)
            if materialized.signing == .Some(signing) -> packaged.receipt.record_signing(signing)
            phases_receipt.push(game_phase("package", "ok", header, package_started, false, "canonical staged plan materialized",
                Some(package_output.display().to_string()), Some(materialized.sha256), Some(materialized.bytes), None))
            artifact = Some(packaged)
        }
    }
    if phases.iter().any((phase) -> phase == "export") {
        export_started :: Instant.now()
        if output == None -> return Err("game export requires the package phase")
        game_plan :: plan.ok_or_else(() -> "game export requires the stage plan")?
        export_destination :: root.join(".jet").join("game-exports").join(export_preset).join(game_plan.artifact_name)
        export_status := if planned -> "planned" else -> "ok"
        export_invalidation := "export preset `{export_preset}`"
        export_output := Some(export_destination)
        export_digest := artifact.map((value) -> value.digest())
        export_bytes := artifact.map((value) -> value.bytes())
        export_diagnostic := GameDiagnostic?{None}
        if planned -> export_invalidation = "dry-run native export planned"
        else {
            if export_game_output(generated_root, game_plan, target, export_preset, options.force_clean) == {
                .Ok((path, materialized)) -> {
                    export_output = Some(path)
                    export_digest = Some(materialized.sha256)
                    export_bytes = Some(materialized.bytes)
                    exported := game_plan.materialized_artifact(materialized.sha256, materialized.bytes)
                    exported.receipt.record_materializer(materialized.materializer)
                    if materialized.signing == .Some(signing) -> exported.receipt.record_signing(signing)
                    artifact = Some(exported)
                    output = Some(path)
                    export_invalidation = "native export adapter materialized output"
                }
                .Err(error) -> {
                    export_status = "error"; export_output = None; export_digest = None; export_bytes = None
                    export_invalidation = "export adapter refused output"
                    export_diagnostic = Some(GameDiagnostic{code: "E2109", what: error,
                        fix: "choose a supported preset/target and pass `--clean` for an owned export"})
                }
            }
        }
        phases_receipt.push(game_phase("export", export_status, header, export_started, false, export_invalidation,
            export_output.map((path) -> path.display().to_string()), export_digest, export_bytes, export_diagnostic))
    }
    if phases.iter().any((phase) -> phase == "deploy") {
        deploy_started :: Instant.now()
        destination :: options.deploy_to.map((path) -> resolve_game_destination(root, path))
        status := "planned"
        invalidation := "deployment is explicit and destination-scoped"
        diagnostic := GameDiagnostic?{None}
        deployed := destination
        if destination == None {
            status = "skipped"; invalidation = "deploy destination was not provided"
            diagnostic = Some(GameDiagnostic{code: "E2104", what: "deploy phase has no destination", fix: "pass `--deploy-to <path>` or omit the deploy phase"})
            deployed = None
        } else if planned -> invalidation = "dry-run deployment planned"
        else if output == .Some(package_output) {
            if deploy_game_output(package_output, destination.expect("destination checked"), options.force_clean) == {
                .Ok(path) -> { deployed = Some(path); invalidation = "package artifact deployed atomically" }
                .Err(error) -> {
                    status = "skipped"; invalidation = "deployment refused"
                    diagnostic = Some(GameDiagnostic{code: "E2106", what: error, fix: "choose an empty destination or pass `--clean` for an owned output"})
                    deployed = None
                }
            }
        } else {
            status = "skipped"; invalidation = "deploy requires a materialized package output"
            diagnostic = Some(GameDiagnostic{code: "E2107", what: "deploy phase has no package artifact", fix: "include the package phase before deploy"})
            deployed = None
        }
        phases_receipt.push(game_phase("deploy", status, header, deploy_started, false, invalidation,
            deployed.map((path) -> path.display().to_string()), artifact.map((value) -> value.digest()), artifact.map((value) -> value.bytes()), diagnostic))
    }
    if phases.iter().any((phase) -> phase == "run") {
        run_started :: Instant.now()
        status := "skipped"
        invalidation := "run requires explicit `--run-now`"
        diagnostic := GameDiagnostic?{None}
        if options.run_now {
            if planned -> invalidation = "dry-run launch planned"
            else if output == .Some(game_output) {
                if launch_game_output(game_output, target, renderer) == {
                    .Ok(pid) -> { status = "ok"; invalidation = "launched packaged game process pid {pid}" }
                    .Err(error) -> {
                        invalidation = "run launch refused"
                        diagnostic = Some(GameDiagnostic{code: "E2108", what: error, fix: "package for the host target or omit `--run-now`"})
                    }
                }
            } else {
                invalidation = "run requires a materialized package output"
                diagnostic = Some(GameDiagnostic{code: "E2107", what: "run phase has no package artifact", fix: "include the package phase before run"})
            }
        } else -> diagnostic = Some(GameDiagnostic{code: "E2105", what: "run phase was requested without `--run-now`", fix: "pass `--run-now` to opt into process launch"})
        phases_receipt.push(game_phase("run", status, header, run_started, false, invalidation,
            output.map((path) -> path.display().to_string()), artifact.map((value) -> value.digest()), artifact.map((value) -> value.bytes()), diagnostic))
    }
    artifact_sha256 :: artifact.map((value) -> value.digest())
    plan_identity :: plan.map((value) -> value.identity)
    report :: game_report_json(header, phases, phases_receipt, plan_identity, plan, artifact_sha256, output, artifact, options.explain, planned)
    success :: !phases_receipt.iter().any((phase) -> phase.status == "error" || phase.diagnostic != None)
    Ok(GameRun{report: report, phases: phases_receipt, input_paths: input_paths, root: generated_root, output: output, success: success})
}

// Rust: Source/CmdPackage.rs:2128
fn validate_game_profile_name(profile: String) -> () Err! {
    if profile.is_empty() || profile.chars().any((character) ->
        character.is_control() || ['/', '\\', ':', '<', '>', '"', '|', '?', '*'].contains(character)) -> return Err("invalid game profile `{profile}`")
    Ok(())
}

// Rust: Source/CmdPackage.rs:2140
fn profile_is_development(profile: String) -> Bool { ["dev", "debug", "ci", "development"].contains(profile) }

// Rust: Source/CmdPackage.rs:2144
fn validate_declared_game_profile(profile: String, facts: PackageFacts?) -> () Err! {
    if facts == .Some(package) {
        if !package.build_profiles.is_empty() && !package.build_profiles.iter().any((candidate) -> candidate.name == profile) {
            names :: package.build_profiles.iter().map((candidate) -> candidate.name).collect().join(", ")
            return Err("game profile `{profile}` is not declared by package.jet; available profiles: {names}")
        }
    } else if !["dev", "debug", "release", "hardened", "ci", "development"].contains(profile) -> return Err("game profile `{profile}` needs a package.jet build declaration")
    Ok(())
}

// Rust: Source/CmdPackage.rs:2170
fn game_phase_names(raw: String?) -> [String] Err! {
    const ORDER: [String] = ["build", "cook", "stage", "package", "export", "deploy", "run"]
    value :: raw.unwrap_or("build,cook,stage,package,export")
    requested := Set[String].new()
    loop part in value.split(",") {
        phase := part.trim() // #4303
        if phase.is_empty() -> continue
        if phase == "all" { requested.extend(ORDER); continue }
        if !ORDER.contains(phase) -> return Err("unknown game phase `{phase}`; use build,cook,stage,package,export,deploy,run")
        requested.insert(phase)
    }
    if requested.is_empty() -> return Err("`--phase` needs at least one game phase")
    last :: ORDER.iter().rposition((phase) -> requested.contains(phase)).unwrap_or(0)
    Ok(ORDER[0..<last + 1].iter().collect())
}

// Rust: Source/CmdPackage.rs:2196
fn resolve_game_root(options: PackageOptions) -> (OSPath, OSPath?) Err! {
    base :: options.source.unwrap_or(core.env.current_dir().map_err((error) -> "could not read current directory: {error}")?)
    metadata :: fs.symlink_metadata(base).map_err((error) -> "could not inspect game source `{base.display()}`: {error}")?
    if metadata.file_type().is_symlink() -> return Err("game source `{base.display()}` must not be a symlink")
    if metadata.is_file() {
        entry :: fs.canonicalize(base).map_err((error) -> "could not canonicalize game source `{base.display()}`: {error}")?
        parent :: entry.parent().unwrap_or(OSPath.new("."))
        if entry.file_name().and_then((name) -> name.to_str()) == Some("package.jet") {
            root :: jet.Loader.find_manifest_root(parent).unwrap_or(parent)
            return Ok((root, find_game_entry(root)))
        }
        root :: jet.Loader.find_manifest_root(parent).unwrap_or(parent)
        return Ok((root, Some(entry)))
    }
    if !metadata.is_dir() -> return Err("game source `{base.display()}` is not a regular file or directory")
    root :: jet.Loader.find_manifest_root(base).unwrap_or(base)
    Ok((root, find_game_entry(root)))
}

// Rust: Source/CmdPackage.rs:2223
fn generated_project_root(path: OSPath) -> OSPath Err! {
    jet.build_project_root(path.to_string_lossy()).map_err((diagnostics) ->
        "could not resolve generated project root for `{path.display()}`: {diagnostics.debug()}")
}

// Rust: Source/CmdPackage.rs:2232
fn find_game_entry(root: OSPath) -> OSPath? {
    [root.join("main.jet"), root.join("src").join("main.jet"), root.join("src").join("Scene.jet"), root.join("game.jet")]
        .iter().find((candidate) -> fs.symlink_metadata(candidate).ok().is_some_and((metadata) -> metadata.is_file() && !metadata.file_type().is_symlink()))
}

// Rust: Source/CmdPackage.rs:2246
fn collect_game_tree(root: OSPath) -> [GameTreeFile] Err! {
    files := [GameTreeFile]{}
    collect_game_tree_at(root, OSPath.new(""), &files)?
    files.sort_by((left, right) -> left.relative.cmp(right.relative))
    Ok(files)
}

// Rust: Source/CmdPackage.rs:2252
fn game_source_revision(tree: [GameTreeFile], facts: PackageFacts?) -> String {
    input := [UInt8]{}
    input.extend_from_slice("jet-game-source-v2{TEXT_NUL}".as_bytes())
    frame(&input, jet.VERSION.as_bytes())
    if facts == .Some(package) -> frame(&input, package.semantic_digest().as_bytes())
    loop file in tree {
        frame(&input, file.relative.as_bytes())
        input.extend_from_slice(file.mode.to_be_bytes())
        frame(&input, file.bytes)
    }
    "sha256:{sha256_hex(input)}"
}

// Rust: Source/CmdPackage.rs:2270
fn collect_game_tree_at(root: OSPath, relative: OSPath, files: &[GameTreeFile]) -> () Err! {
    const MAX_GAME_FILE_BYTES: UInt64 = 256 * 1024 * 1024
    directory :: root.join(relative)
    metadata :: fs.symlink_metadata(directory).map_err((error) -> "could not inspect game path `{directory.display()}`: {error}")?
    if metadata.file_type().is_symlink() -> return Err("game path `{directory.display()}` must not be a symlink")
    if metadata.is_file() {
        if metadata.len() > MAX_GAME_FILE_BYTES -> return Err("game input `{directory.display()}` exceeds the {MAX_GAME_FILE_BYTES} byte limit")
        bytes :: fs.read(directory).map_err((error) -> "could not read game input `{directory.display()}`: {error}")?
        relative_text :: relative.to_str().ok_or_else(() -> "game input `{directory.display()}` is not valid UTF-8")?.replace("\\", "/")
        mode :: game_file_mode(metadata)
        files.push(GameTreeFile{relative: relative_text, mode: mode, bytes: bytes})
        return Ok(())
    }
    if !metadata.is_dir() -> return Err("game path `{directory.display()}` is not a regular file or directory")
    entries := fs.read_dir(directory).map_err((error) -> "could not enumerate game path `{directory.display()}`: {error}")?
        .collect_result().map_err((error) -> "could not enumerate game path `{directory.display()}`: {error}")?
    entries.sort_by((left, right) -> left.file_name().cmp(right.file_name()))
    loop entry in entries {
        name :: entry.file_name().to_str().ok_or_else(() -> "game path `{entry.path().display()}` is not valid UTF-8")?
        if relative.as_os_str().is_empty() && [".git", ".jet", "build", "target", "node_modules", "dist"].contains(name) -> continue
        collect_game_tree_at(root, relative.join(name), files)?
    }
    Ok(())
}

// Rust: Source/CmdPackage.rs:2331
fn game_file_mode(metadata: fs.Metadata) -> UInt32 {
    // GATE #4483: selected target family, never compiler host cfg.
    if core.sys.target.selected_family() == "unix" {
        mode :: metadata.permissions().mode() & 0o777
        if mode == 0 -> 0o644 else -> mode
    } else -> 0o644
}

// Rust: Source/CmdPackage.rs:2343
fn ensure_regular_game_file(path: OSPath, label: String) -> () Err! {
    metadata :: fs.symlink_metadata(path).map_err((error) -> "could not inspect {label} `{path.display()}`: {error}")?
    if metadata.file_type().is_symlink() || !metadata.is_file() -> return Err("{label} `{path.display()}` is not a regular file")
    Ok(())
}

// Rust: Source/CmdPackage.rs:2352
fn game_build_target(target: BundleTarget) -> String Err! {
    arch :: core.sys.target.selected_arch() // GATE #4483
    triple :: if (target, arch) == {
        (.LinuxAppImage, "x86_64") -> "x86_64-unknown-linux-gnu"
        (.LinuxAppImage, "aarch64") -> "aarch64-unknown-linux-gnu"
        (.LinuxAppImage, "i686") -> "i686-unknown-linux-gnu"
        (.MacOSApp, "x86_64") -> "x86_64-apple-darwin"
        (.MacOSApp, "aarch64") -> "aarch64-apple-darwin"
        (.WindowsMsix, "x86_64") -> "x86_64-pc-windows-gnu"
        (.WindowsMsix, "aarch64") -> "aarch64-pc-windows-msvc"
        (.WindowsMsix, "i686") -> "i686-pc-windows-gnu"
        _ -> return Err("game target `{target.as_str()}` has no compiler target mapping for host architecture `{arch}`")
    }
    Ok(triple)
}

// Rust: Source/CmdPackage.rs:2373
fn build_game_entry(root: OSPath, entry: OSPath, profile: String, target: BundleTarget) -> OSPath Err! {
    target_triple :: game_build_target(target)?
    jet_exe :: core.env.current_exe().map_err((error) -> "could not resolve jet executable for game build: {error}")?
    selected_profile :: if profile == { "debug" -> "dev"; "development" -> "dev"; "hardened" -> "release"; value -> value }
    output :: Command.new(jet_exe).arg("build").arg(entry).arg("--profile").arg(selected_profile)
        .arg("--target").arg(target_triple).arg("--quiet").current_dir(root).output()
        .map_err((error) -> "could not start game build: {error}")?
    if !output.status.success() -> return Err("game build failed ({output.status}){command_output_detail(output.stdout, output.stderr)}")
    generated_root :: generated_project_root(entry)?
    path :: generated_root.join(".jet").join("build").join(jet.CmdCompile.stem(entry.to_string_lossy()))
    ensure_regular_game_file(path, "built game executable")?
    Ok(path)
}

// Rust: Source/CmdPackage.rs:2414
fn command_output_detail(stdout: [UInt8], stderr: [UInt8]) -> String {
    const MAX_DETAIL_BYTES: USize = 4096
    stdout_text := String.from_utf8_lossy(stdout[0..<stdout.len().min(MAX_DETAIL_BYTES)]).trim() // #4303
    stderr_text := String.from_utf8_lossy(stderr[0..<stderr.len().min(MAX_DETAIL_BYTES)]).trim() // #4303
    if (stdout_text.is_empty(), stderr_text.is_empty()) == {
        (true, true) -> ""
        (false, true) -> ": stdout: {stdout_text}"
        (true, false) -> ": stderr: {stderr_text}"
        (false, false) -> ": stdout: {stdout_text}; stderr: {stderr_text}"
    }
}

// Rust: Source/CmdPackage.rs:2430
fn dedup_paths(paths: &[OSPath]) -> { paths.sort(); paths.dedup() }

// Rust: Source/CmdPackage.rs:2434
fn game_authority_identity(facts: PackageFacts?, renderer: String) -> String Err! {
    authority := if facts == .Some(package) ->
        jet_foundation.Authority.ApplicationAuthority.from_policy(package.authority.holds.allow, package.authority.holds.deny, "package.jet authority.holds")
        else -> jet_foundation.Authority.ApplicationAuthority.ambient_basics()
    policy_identity :: authority.debug()
    required_effect :: if renderer == "raylib" -> "GPU" else -> "none"
    if renderer == "raylib" {
        authority.required_effects.insert("GPU")
        if authority.policy_diagnostic() == .Some(diagnostic) -> return Err("{diagnostic.code}: renderer `{renderer}` requires effect `GPU`; {diagnostic.what}; {diagnostic.why}; fix: {diagnostic.fix}")
    }
    Ok("sha256:{sha256_hex(\"jet-game-authority-v1{TEXT_NUL}{policy_identity}{TEXT_NUL}{required_effect}\".as_bytes())}")
}

// Rust: Source/CmdPackage.rs:2465
fn game_authority_diagnostic(error: String) -> GameDiagnostic {
    (code, body) :: error.split_once(":").map_or(("E1803", error), ((code, body)) -> (code.trim(), body.trim()))
    (what, fix) :: body.split_once("fix:").map_or((body.trim(), "declare `GPU` in package.jet authority.holds.allow"), ((what, fix)) -> (what.trim(), fix.trim()))
    code_text := code // #4303
    what_text := what // #4303
    fix_text := fix // #4303
    GameDiagnostic{code: code_text, what: what_text, fix: fix_text}
}

// Rust: Source/CmdPackage.rs:2482
fn validate_game_renderer_selection(renderer: String, tree: [GameTreeFile]) -> () Err! {
    if renderer != "raylib" -> return Ok(())
    bridge :: "core.game.raylib".as_bytes()
    if tree.iter().any((file) -> file.relative.ends_with(".jet") && file.bytes.windows(bridge.len()).any((window) -> window == bridge)) -> return Ok(())
    Err("renderer `raylib` was selected, but the source does not use the checked `core.game.raylib` bridge")
}

