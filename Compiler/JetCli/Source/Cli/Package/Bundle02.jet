        ("installation", json_text_value(runtime.installation)),
        ("memory", CanonicalJson.object([("max_logs", json_integer(runtime.memory_logs)),
            ("max_stacks", json_integer(runtime.memory_stacks))]).expect("fixed game crash memory JSON keys")),
        ("retention", CanonicalJson.object([("max_reports", json_integer(runtime.retention_limit)),
            ("mode", json_text_value(runtime.retention_mode)), ("path", json_text_value(runtime.retention_path))])
            .expect("fixed game crash retention JSON keys")),
        ("routing", json_text_value(runtime.routing)), ("upload_policy", json_text_value(runtime.upload_policy)),
    ]).expect("fixed game crash runtime JSON keys")
}

// Rust: Source/CmdPackage.rs:3399
fn game_materialization_json(status: String, artifact_sha256: String?, output: OSPath?, artifact: PackageBundleArtifact?) -> CanonicalJson {
    materializer :: artifact.and_then((value) -> value.receipt.materializer).map(game_materializer_json).unwrap_or(CanonicalJson.Null)
    CanonicalJson.object([
        ("artifact_sha256", artifact_sha256.map(json_text_value).unwrap_or(CanonicalJson.Null)),
        ("bytes", artifact.map((value) -> json_integer(value.bytes())).unwrap_or(CanonicalJson.Null)),
        ("output", output.map((path) -> json_text_value(path.display().to_string())).unwrap_or(CanonicalJson.Null)),
        ("materializer", materializer), ("status", json_text_value(status)),
    ]).expect("fixed game materialization JSON keys")
}

