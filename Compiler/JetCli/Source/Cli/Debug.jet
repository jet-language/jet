// `jet debug <file.jet>`: the program's native O0 image, built by this `jet`,
// run under LLDB behind the `(Jet)` console of Compiler/JetDebug Native.jet.
// It stops at the start of `run`, then reads one command a line; the end of
// stdin runs the program to its end, and `quit` ends it early (E2204). With
// no LLDB the session stops with E2203 before it builds anything.
use {
    cli_files: core.files
    cli_process: core.process
    cli_sys: core.sys
    cli_term: core.term
    jet_debug.[NATIVE_DEBUG_PROMPT, NativeDebugError, NativeDebugStep, NativeSession, NativeStopKind, native_debug_build_argv, native_debug_image, native_debug_lldb]
    jet_driver.[JET_DRIVER_EXIT_OK, JET_DRIVER_EXIT_USAGE, JET_DRIVER_EXIT_USER_ERROR]
    jet_foundation.[diagnostic_registry_row]
}

jet_cli_debug: fn(jet_argv: [String], args: [String], color: Bool) -[FS, Env, Exec, IO, Time.Wait]> JetCLIPlan Never! {
    loop flag in jet_argv {
        if flag == "--dap" || flag == "--raw-frames" || flag.starts_with("--record") || flag.starts_with("--replay") -> return jet_cli_not_ported("debug {flag.before("=")}", color)
    }
    if args.len() < 2 -> return jet_cli_missing_target("debug", false)
    if args.len() > 2 -> return jet_cli_fail("E2104", "`jet debug` takes one source file, but got `{args[2]}` too", jet_cli_why("E2104"), "Run `jet debug <file.jet>`.", color, JET_DRIVER_EXIT_USAGE)
    entry: args[1]
    source: cli_files.read(entry) ?? return jet_cli_fail("E2105", "couldn't read `{entry}`: {err}", jet_cli_why("E2105"), "check the path, then run the command again", color, JET_DRIVER_EXIT_USER_ERROR)
    _: native_debug_lldb() ?? return jet_cli_debug_unavailable(err, color)
    scratch: cli_files.temp_dir("jet-debug") ?? return jet_cli_fail("E2105", "couldn't create the debug build directory: {err}", jet_cli_why("E2105"), "check that the temporary directory is writable, then run the command again", color, JET_DRIVER_EXIT_USER_ERROR)
    plan: jet_cli_debug_session(entry, source, scratch.path, color)
    if cli_files.remove_all(scratch.path) == {
        .Err(_) -> {}
        .Ok(_) -> {}
    }
    plan
}

jet_cli_debug_session: fn(entry: String, source: String, scratch: String, color: Bool) -[FS, Env, Exec, IO, Time.Wait]> JetCLIPlan Never! {
    out_dir: cli_files.join(scratch, "out")
    built: cli_process.cmd(native_debug_build_argv(cli_sys.executable(), entry, out_dir)).stdout(.Capture).stderr(.Capture).run() ?? return jet_cli_fail("E2105", "couldn't run the debug build: {err}", jet_cli_why("E2105"), "check that this `jet` can run, then run the command again", color, JET_DRIVER_EXIT_USER_ERROR)
    if !built.success -> return jet_cli_done(built.output, built.errors, if built.code == 0 -> JET_DRIVER_EXIT_USER_ERROR else -> built.code)
    session := NativeSession.start(native_debug_image(entry, out_dir), cli_files.join(scratch, "output.txt")) ?? return jet_cli_debug_unavailable(err, color)
    plan: jet_cli_debug_console(session, cli_files.basename(entry), source.split("\n").to_list(), color)
    session.close()
    plan
}

jet_cli_debug_unavailable: fn(error: NativeDebugError, color: Bool) -> JetCLIPlan Never! {
    report: error.diagnostic()
    jet_cli_fail(report.code, report.what, report.why, report.fix, color, JET_DRIVER_EXIT_USER_ERROR)
}

// Read commands until the program ends. A piped stdin's commands are echoed
// after the prompt, so the transcript reads as the session went.
jet_cli_debug_console: fn(session: &NativeSession, file: String, lines: [String], color: Bool) -[FS, Env, Exec, IO, Time.Wait]> JetCLIPlan Never! {
    echo: !cli_term.stdin().is_tty()
    opened := NativeDebugStep?{None}
    if session.open(file, lines) == {
        .Ok(step) -> opened = step
        .Err(failure) -> return jet_cli_debug_unavailable(failure, color)
    }
    if opened == None {
        row: diagnostic_registry_row("E0101") ?? panic("E0101 is not registered")
        return jet_cli_fail("E0101", row.what, row.why, row.fix, color, JET_DRIVER_EXIT_USER_ERROR)
    }
    first: opened ?? panic("the session opened")
    jet_cli_debug_write(first.text)
    stop := first.stop
    input := cli_term.stdin()
    loop stop.kind == NativeStopKind.Paused {
        jet_cli_debug_write(NATIVE_DEBUG_PROMPT)
        // The end of stdin runs the program to its end.
        command := "continue"
        if input.read_line() == {
            .Ok(read) -> command = read ?? "continue"
            .Err(_) -> {}
        }
        command = command.trim().copy()
        if echo -> jet_cli_debug_write("{command}\n")
        if command == "q" || command == "quit" {
            row: diagnostic_registry_row("E2204") ?? panic("E2204 is not registered")
            return jet_cli_fail("E2204", row.what, row.why, row.fix, color, JET_DRIVER_EXIT_USER_ERROR)
        }
        step: session.command(command, stop, file, lines) ?? return jet_cli_debug_unavailable(err, color)
        jet_cli_debug_write(step.text)
        stop = step.stop
    }
    jet_cli_done("", "", JET_DRIVER_EXIT_OK)
}

jet_cli_debug_write: fn(text: String) Never! -[IO, Time.Wait]> {
    if text.len() == 0 -> return
    out := cli_term.stdout()
    out.write(text).drop("jet debug stdout")
    out.flush().drop("jet debug stdout")
}
