    fn name(&self) -> String {
        if self == {
            .Added -> "added"
            .Removed -> "removed"
            .Renamed -> "renamed"
            .Moved -> "moved"
            .Signature -> "signature_changed"
            .Body -> "body_changed"
        }
    }
}
