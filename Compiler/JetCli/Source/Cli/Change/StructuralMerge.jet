// Rust: Source/CmdStructuralMerge.rs:77
pub fn run_diff(args: [String]) -> {
    if wants_help(args) { print(diff_help()); return }
    if !args.iter().any(arg -> arg == "--structural") {
        fail("`jet diff` currently requires `--structural`", "jet diff --structural before.jet after.jet")
    }
    paths :: positional(args, "diff")
    if paths.len() != 2 {
        fail("`jet diff --structural` needs two checked Jet files", "jet diff --structural before.jet after.jet")
    }
    before :: load(OSPath.from(paths[0]))
    after :: load(OSPath.from(paths[1]))
    ops :: transition_ops(&before, &after)
    changes :: structural_diff(before.units, after.units, ops)
    report :: report_mode(args)
    if report == "text" {
        if changes.is_empty() -> println("no structural changes")
        loop item in changes {
            identity :: item.after ?? item.before ?? "definition"
            println("{item.kind.name()}: {identity} [{item.stable_id}]")
        }
    } else {
        payload :: StatusValue.object(StatusFields.new().with("changes", StatusValue.array(changes.iter().map(item -> change_value(&item)))))
        println(StatusEnvelope.new("diff.structural", true).with_field("structural_diff", payload).json())
    }
}
// Rust: Source/CmdStructuralMerge.rs:132
pub fn run_merge(args: [String]) -> {
    if wants_help(args) { print(merge_help()); return }
    if args.get(1) == Val("install-driver") { install_driver(args); return }
    if !args.iter().any(arg -> arg == "--structural") {
        fail("`jet merge` currently requires `--structural`", "jet merge --structural base.jet ours.jet theirs.jet --out merged.jet")
    }
    paths :: positional(args, "merge")
    if paths.len() != 3 {
        fail("`jet merge --structural` needs base, ours, and theirs", "jet merge --structural base.jet ours.jet theirs.jet --out merged.jet")
    }
    base_path :: OSPath.from(paths[0])
    ours_path :: OSPath.from(paths[1])
    theirs_path :: OSPath.from(paths[2])
    base :: load(base_path)
    ours :: load(ours_path)
    theirs :: load(theirs_path)
    (candidate, conflicts) :: merge_units(&base, &ours, &theirs)
    if !conflicts.is_empty() {
        render_conflicts(conflicts, report_mode(args))
        exit(ExitCodes.USER_ERROR)
    }
    formatted :: jet.format_source(candidate) ?? fail("structural merge produced source that does not parse", "resolve edits manually; no output was written")
    output_path :: absolute_normalized(flag_value(args, "--out").map(value -> OSPath.from(value)) ?? ours_path)
    overlays :: [(output_path, formatted)]
    _ :: open_structural_with_overlays(output_path, overlays) ?? render_index_error("merged output did not pass parser and sema", err)
    _ :: fs.write(output_path, formatted.bytes()) ?? fail("could not write `{output_path.display()}`: {err}", "choose a writable --out path")
    if report_mode(args) == "text" {
        println("merged: {output_path.display()}")
    } else {
        println(StatusEnvelope.new("merge.structural", true).with_field("structural_merge", StatusValue.object(StatusFields.new().with("output", output_path.display()))).json())
    }
}
// Rust: Source/CmdStructuralMerge.rs:210
pub fn structural_help(command: String) -> String? {
    if command == { "diff" -> Val(diff_help()) "merge" -> Val(merge_help()) else -> None }
}
// Rust: Source/CmdStructuralMerge.rs:218
fn load(path: OSPath) -> Document {
    source :: fs.read_to_string(path) ?? fail("could not read `{path.display()}`: {err}", "pass a readable Jet source file")
    index :: open_structural_with_overlays(path, []) ?? render_index_error("`{path.display()}` did not pass parser and sema", err)
    units := [Unit]{}
    loop fact in index.definition_facts() {
        if !same_module(path, fact.module_path) -> continue
        slice :: source.get(fact.span.start..<fact.span.end) ?? fail("semantic index returned an invalid source span", "run `jet check` and report this compiler bug")
        trimmed := slice.trim() // #4303
        &units.push(Unit{fact: ~fact, source: trimmed.to_string(), leading: ""})
    }
    &units.sort_by_key(unit -> unit.fact.span.start)
    cursor := 0
    loop unit in &units {
        unit.leading = (source.get(cursor..<unit.fact.span.start) ?? "").to_string()
        cursor = unit.fact.span.end
    }
    source_hash :: jet.SHA256.sha256_hex(source.bytes())
    semantic_ops :: semantic_ops_for_file(path, source_hash)
    Document{path: absolute_normalized(path), units: ^units, suffix: (source.get(cursor..) ?? "").to_string(), source_hash: source_hash, semantic_ops: semantic_ops}
}
// Rust: Source/CmdStructuralMerge.rs:269
fn structural_diff(before: [Unit], after: [Unit], ops: [SemanticOp]) -> [Change] {
    matches :: match_units(before, after, ops)
    used := [Int:Bool]{}
    changes := [Change]{}
    loop i in 0..<before.len() {
        left :: &before[i]
        right :: matches.matched.get(i) ?? None
        if right == {
            None -> &changes.push(change(.Removed, left, None))
            .Val(index) -> {
                &used.insert(index, true)
                other :: &after[index]
                rename :: semantic_rename(left, other, ops)
                signature_changed :: left.fact.signature_id != other.fact.signature_id
                content_changed :: left.fact.content_id != other.fact.content_id
                if rename.is_some() -> &changes.push(change_with_op(.Renamed, left, Val(other), rename))
                // A standalone buffer path change is a move only if the declaration changed.
                if left.fact.module_path != other.fact.module_path && (rename.is_some() || signature_changed || content_changed) {
                    &changes.push(change(.Moved, left, Val(other)))
                }
                if signature_changed { &changes.push(change(.Signature, left, Val(other))) }
                else if content_changed { &changes.push(change(.Body, left, Val(other))) }
            }
        }
    }
    loop i in 0..<after.len() {
        if !used.has_key(i) -> &changes.push(change(.Added, &after[i], Val(&after[i])))
    }
    &changes.sort_by((a, b) -> a.stable_id.cmp(b.stable_id).then(a.kind.cmp(b.kind)))
    ^changes
}
// Rust: Source/CmdStructuralMerge.rs:320
fn change(kind: ChangeKind, before: &Unit, after: &Unit?) -> Change { change_with_op(kind, before, after, None) }
// Rust: Source/CmdStructuralMerge.rs:324
fn change_with_op(kind: ChangeKind, before: &Unit, after: &Unit?, semantic_op: &SemanticOp?) -> Change {
    stable_id :: semantic_op.and_then(op -> op.targets.first().map(target -> ~target.stable_id)) ?? after.map(unit -> ~unit.fact.stable_id) ?? ~before.fact.stable_id
    Change{kind: kind, stable_id: stable_id, before: Val(~before.fact.human_identity), after: after.map(unit -> ~unit.fact.human_identity), semantic_op: semantic_op.map(op -> ~op)}
}
// Rust: Source/CmdStructuralMerge.rs:343
fn match_units(base: [Unit], side: [Unit], ops: [SemanticOp]) -> UnitMatches {
    result := [Int:Int?]{}
    ambiguous := [Int:[Int]]{}
    used := [Int:Bool]{}
    // Reserve exact identities before any fuzzy match steals an unchanged sibling.
    loop index in 0..<base.len() {
        unit :: &base[index]
        base_count :: base.iter().filter(candidate -> exact_key(&candidate) == exact_key(unit)).count()
        exact := [Int]{}
        loop i in 0..<side.len() {
            if exact_key(&side[i]) == exact_key(unit) -> &exact.push(i)
        }
        if base_count == 1 && exact.len() == 1 {
            &result.insert(index, Val(exact[0]))
            &used.insert(exact[0], true)
        }
    }
    loop index in 0..<base.len() {
        if result.has_key(index) -> continue
        unit :: &base[index]
        semantic :: candidates(side, &used, candidate -> semantic_rename(unit, candidate, ops).is_some())
        signature :: candidates(side, &used, candidate -> candidate.fact.signature_id == unit.fact.signature_id)
        ancestry :: candidates(side, &used, candidate -> candidate.fact.stable_id == unit.fact.stable_id)
        selected :: if !semantic.is_empty() -> semantic else if !signature.is_empty() -> signature else -> ancestry
        if selected.len() == 1 {
            &used.insert(selected[0], true)
            &result.insert(index, Val(selected[0]))
        } else {
            if selected.len() > 1 -> &ambiguous.insert(index, selected)
            &result.insert(index, None)
        }
    }
    UnitMatches{matched: ^result, ambiguous: ^ambiguous}
}
// Rust: Source/CmdStructuralMerge.rs:400
fn exact_key(unit: &Unit) -> (String, String) { (unit.fact.kind, unit.fact.name) }
// Rust: Source/CmdStructuralMerge.rs:404
fn candidates(side: [Unit], used: &[Int:Bool], predicate: fn(&Unit) -> Bool) -> [Int] {
    out := [Int]{}
    loop i in 0..<side.len() {
        if !used.has_key(i) && predicate(&side[i]) -> &out.push(i)
    }
    ^out
}
// Rust: Source/CmdStructuralMerge.rs:415
fn semantic_rename(before: &Unit, after: &Unit, ops: [SemanticOp]) -> &SemanticOp? {
    loop op in ops {
        if op.kind == "rename" && op.from == Val(before.fact.name) && op.to == Val(after.fact.name) && op.targets.iter().any(target ->
            target.stable_id == before.fact.stable_id || target.before == before.fact.human_identity || (target.kind == before.fact.kind && target.module_path == before.fact.module_path)) {
            return Val(&op)
        }
    }
    None
}
// Rust: Source/CmdStructuralMerge.rs:433
fn merge_units(base: &Document, ours: &Document, theirs: &Document) -> (String, [Conflict]) {
    ours_ops :: transition_ops(base, ours)
    theirs_ops :: transition_ops(base, theirs)
    ours_matches :: match_units(base.units, ours.units, ours_ops)
    theirs_matches :: match_units(base.units, theirs.units, theirs_ops)
    ours_used := [Int:Bool]{}
    theirs_used := [Int:Bool]{}
    merged := ""
    conflicts := [Conflict]{}
    loop index in 0..<base.units.len() {
        original :: &base.units[index]
        if ours_matches.ambiguous.get(index) == .Val(indices) {
            loop i in indices -> &ours_used.insert(i, true)
            &conflicts.push(ambiguous_conflict(original, "ours", indices, ours.units))
            continue
        }
        if theirs_matches.ambiguous.get(index) == .Val(indices) {
            loop i in indices -> &theirs_used.insert(i, true)
            &conflicts.push(ambiguous_conflict(original, "theirs", indices, theirs.units))
            continue
        }
        oi :: ours_matches.matched.get(index) ?? None
        ti :: theirs_matches.matched.get(index) ?? None
        if oi == .Val(i) -> &ours_used.insert(i, true)
        if ti == .Val(i) -> &theirs_used.insert(i, true)
        o :: oi.map(i -> &ours.units[i])
        t :: ti.map(i -> &theirs.units[i])
        leading :: if (o, t) == {
            (.Val(ou), .Val(th)) -> merge_text("inter_item_trivia", original, original.leading, ou.leading, th.leading, &conflicts)
            (.Val(ou), None) -> ~ou.leading
            (None, .Val(th)) -> ~th.leading
            (None, None) -> ""
        }
        if (o, t) == {
            (None, None) -> {}
            (.Val(ou), None) -> {
                if ou.fact.content_id != original.fact.content_id -> &conflicts.push(conflict("delete_edit", original, ou, ou))
            }
            (None, .Val(th)) -> {
                if th.fact.content_id != original.fact.content_id -> &conflicts.push(conflict("delete_edit", original, th, th))
            }
            (.Val(ou), .Val(th)) -> {
                if ou.fact.content_id == th.fact.content_id { push_unit(&merged, leading, ou.source) }
                else if ou.fact.content_id == original.fact.content_id { push_unit(&merged, leading, th.source) }
                else if th.fact.content_id == original.fact.content_id { push_unit(&merged, leading, ou.source) }
                else {
                    if merge_recorded_rename(original, ou, th, ours_ops, theirs_ops) == {
                        .Val(source) -> push_unit(&merged, leading, source)
                        None -> &conflicts.push(conflict("overlapping_edit", original, ou, th))
                    }
                }
            }
        }
    }
    ours_added := [&Unit]{}
    theirs_added := [&Unit]{}
    loop i in 0..<ours.units.len() { if !ours_used.has_key(i) -> &ours_added.push(&ours.units[i]) }
    loop i in 0..<theirs.units.len() { if !theirs_used.has_key(i) -> &theirs_added.push(&theirs.units[i]) }
    theirs_paired := [Int:Bool]{}
    loop ours_unit in ours_added {
        matches := [Int]{}
        loop i in 0..<theirs_added.len() {
            if !theirs_paired.has_key(i) && exact_key(theirs_added[i]) == exact_key(ours_unit) -> &matches.push(i)
        }
        if matches.is_empty() { push_unit(&merged, ours_unit.leading, ours_unit.source) }
        else if matches.len() == 1 {
            index :: matches[0]
            &theirs_paired.insert(index, true)
            theirs_unit :: theirs_added[index]
            if ours_unit.fact.content_id != theirs_unit.fact.content_id {
                &conflicts.push(conflict("competing_add", ours_unit, ours_unit, theirs_unit))
            } else {
                leading :: merge_text("inter_item_trivia", ours_unit, "", ours_unit.leading, theirs_unit.leading, &conflicts)
                push_unit(&merged, leading, ours_unit.source)
            }
        } else {
            &conflicts.push(Conflict{kind: "ambiguous_identity", stable_id: ~ours_unit.fact.stable_id, human_identity: ~ours_unit.fact.human_identity, ours: ~ours_unit.fact.content_id, theirs: "ambiguous additions"})
        }
    }
    loop i in 0..<theirs_added.len() {
        if !theirs_paired.has_key(i) -> push_unit(&merged, theirs_added[i].leading, theirs_added[i].source)
    }
    suffix :: merge_shell("suffix", base.suffix, ours.suffix, theirs.suffix, &conflicts)
    &merged.push_str(suffix)
    (^merged, ^conflicts)
}
// Rust: Source/CmdStructuralMerge.rs:573
fn transition_ops(before: &Document, after: &Document) -> [SemanticOp] {
    out := [SemanticOp]{}
    loop op in before.semantic_ops.iter().chain(after.semantic_ops.iter()) {
        if op.matches_file_transition([before.path, after.path], before.source_hash, after.source_hash) && !out.contains(op) {
            &out.push(~op)
        }
    }
    ^out
}
// Rust: Source/CmdStructuralMerge.rs:594
fn merge_recorded_rename(base: &Unit, ours: &Unit, theirs: &Unit, ours_ops: [SemanticOp], theirs_ops: [SemanticOp]) -> String? {
    ours_rename :: semantic_rename(base, ours, ours_ops)
    theirs_rename :: semantic_rename(base, theirs, theirs_ops)
    to :: if (ours_rename, theirs_rename) == {
        (.Val(o), .Val(t)) -> { if o.to != t.to -> return None; o.to ?? return None }
        (.Val(o), None) -> o.to ?? return None
        (None, .Val(t)) -> t.to ?? return None
        else -> return None
    }
    from :: base.fact.name
    renamed_base :: rename_source(base.source, from, to) ?? return None
    other :: if ours_rename.is_some() && theirs_rename.is_none() -> rename_source(theirs.source, from, to) ?? return None
        else if theirs_rename.is_some() && ours_rename.is_none() -> rename_source(ours.source, from, to) ?? return None
        else -> ~theirs.source
    if ours.source == theirs.source -> Val(~ours.source)
    else if ours.source == renamed_base -> Val(other)
    else if theirs.source == renamed_base -> Val(~ours.source)
    else -> None
}
// Rust: Source/CmdStructuralMerge.rs:630
fn rename_source(source: String, from: String, to: String) -> String? {
    loop (start, _) in source.match_indices(from) {
        before :: source[..start].chars().next_back()
        end :: start + from.len()
        after :: source[end..].chars().next()
        if before.is_none_or(ch -> !ch.is_alphanumeric() && ch != '_') && after.is_none_or(ch -> !ch.is_alphanumeric() && ch != '_') {
            renamed := ~source
            &renamed.replace_range(start..<end, to)
            return Val(^renamed)
        }
    }
    None
}
// Rust: Source/CmdStructuralMerge.rs:643
fn push_unit(output: &String, leading: String, source: String) -> { &output.push_str(leading); &output.push_str(source) }
// Rust: Source/CmdStructuralMerge.rs:648
fn merge_text(kind: String, unit: &Unit, base: String, ours: String, theirs: String, conflicts: &[Conflict]) -> String {
    if ours == theirs -> return ~ours
    if ours == base -> return ~theirs
    if theirs == base -> return ~ours
    &conflicts.push(Conflict{kind: kind, stable_id: ~unit.fact.stable_id, human_identity: ~unit.fact.human_identity, ours: "sha256:{jet.SHA256.sha256_hex(ours.bytes())}", theirs: "sha256:{jet.SHA256.sha256_hex(theirs.bytes())}"})
    ~base
}
// Rust: Source/CmdStructuralMerge.rs:675
fn ambiguous_conflict(base: &Unit, side: String, indices: [Int], units: [Unit]) -> Conflict {
    ids :: indices.iter().map(index -> units[index].fact.human_identity).collect().join(",")
    Conflict{kind: "ambiguous_identity", stable_id: ~base.fact.stable_id, human_identity: ~base.fact.human_identity,
        ours: if side == "ours" -> "ambiguous:{ids}" else -> ~base.fact.content_id,
        theirs: if side == "theirs" -> "ambiguous:{ids}" else -> ~base.fact.content_id}
}
// Rust: Source/CmdStructuralMerge.rs:698
fn merge_shell(label: String, base: String, ours: String, theirs: String, conflicts: &[Conflict]) -> String {
    if ours == theirs -> return ~ours
    if ours == base -> return ~theirs
    if theirs == base -> return ~ours
    &conflicts.push(Conflict{kind: "file_scope_edit", stable_id: "file:{label}", human_identity: "file {label}", ours: "sha256:{jet.SHA256.sha256_hex(ours.bytes())}", theirs: "sha256:{jet.SHA256.sha256_hex(theirs.bytes())}"})
    ~base
}
// Rust: Source/CmdStructuralMerge.rs:724
fn conflict(kind: String, base: &Unit, ours: &Unit, theirs: &Unit) -> Conflict {
    Conflict{kind: kind, stable_id: ~base.fact.stable_id, human_identity: ~base.fact.human_identity, ours: ~ours.fact.content_id, theirs: ~theirs.fact.content_id}
}
// Rust: Source/CmdStructuralMerge.rs:734
fn render_conflicts(conflicts: [Conflict], mode: String) -> {
    if mode == "text" {
        loop item in conflicts -> eprintln("conflict: {item.human_identity} ({item.kind})\n stable id: {item.stable_id}\n ours: {item.ours}\n theirs: {item.theirs}")
        eprintln("merge stopped: resolve conflicts manually; no output was written")
    } else {
        payload :: StatusValue.object(StatusFields.new().with("conflicts", StatusValue.array(conflicts.iter().map(item -> conflict_value(&item)))))
        eprintln(StatusEnvelope.new("merge.structural", false).with_field("structural_merge", payload).json())
    }
}
// Rust: Source/CmdStructuralMerge.rs:763
fn install_driver(args: [String]) -> {
    repo :: OSPath.from(flag_value(args, "--repo") ?? ".")
    config :: git_config_path(repo)
    git_config_set(config, "merge.jetstruct.name", "Jet structural merge")
    git_config_set(config, "merge.jetstruct.driver", "jet merge --structural %O %A %B --out %A")
    loop (key, expected) in [("merge.jetstruct.name", "Jet structural merge"), ("merge.jetstruct.driver", "jet merge --structural %O %A %B --out %A")] {
        actual :: git_config_get(config, key)
        trimmed := actual.trim() // #4303
        if trimmed != expected -> fail("Git did not retain `{key}` exactly", "check repository config permissions and includes")
    }
    attributes :: repo.join(".gitattributes")
    attrs := fs.read_to_string(attributes) ?? ""
    line :: "*.jet merge=jetstruct"
    if !attrs.lines().any(existing -> existing.trim() == line) {
        if !attrs.is_empty() && !attrs.ends_with('\n') -> &attrs.push('\n')
        &attrs.push_str(line)
        &attrs.push('\n')
        write_file(attributes, attrs)
    }
    println("installed structural merge driver in {repo.display()}")
}
// Rust: Source/CmdStructuralMerge.rs:803
fn git_config_path(repo: OSPath) -> OSPath {
    // GATE #4494: real child process and captured output, never a fake Git result.
    output :: Command.new("git").arg("-C").arg(repo).args(["rev-parse", "--git-path", "config"]).output() ?? fail("could not run Git: {err}", "install Git before enabling its merge driver")
    if !output.status.success() -> fail("`{repo.display()}` is not a Git worktree", "run inside a Git repository or pass --repo <path>")
    raw :: String.from_utf8(output.stdout) ?? fail("Git returned a non-UTF-8 config path", "repair the Git worktree metadata")
    trimmed := raw.trim() // #4303
    reported :: OSPath.from(trimmed)
    config :: if reported.is_absolute() -> normalize_path(reported) else -> normalize_path(repo.join(reported))
    if !config.is_file() -> fail("`{repo.display()}` has no Git config", "repair the Git worktree metadata")
    config
}
// Rust: Source/CmdStructuralMerge.rs:842
fn git_config_set(config: OSPath, key: String, value: String) -> {
    // GATE #4494: native child process.
    output :: Command.new("git").args(["config", "--file"]).arg(config).args(["--replace-all", key, value]).output() ?? fail("could not run Git: {err}", "install Git before enabling its merge driver")
    if !output.status.success() -> fail("could not update Git config `{key}`", "fix repository config permissions")
}
// Rust: Source/CmdStructuralMerge.rs:862
fn git_config_get(config: OSPath, key: String) -> String {
    // GATE #4494: native child process.
    output :: Command.new("git").args(["config", "--file"]).arg(config).args(["--get", key]).output() ?? fail("could not run Git: {err}", "install Git before enabling its merge driver")
    if !output.status.success() -> fail("could not read back Git config `{key}`", "repair the repository config")
    String.from_utf8(output.stdout) ?? fail("Git config contained non-UTF-8 data", "repair the repository config")
}
// Rust: Source/CmdStructuralMerge.rs:888
fn write_file(path: OSPath, content: String) -> {
    _ :: fs.write(path, content) ?? fail("could not write `{path.display()}`: {err}", "fix repository permissions")
}
// Rust: Source/CmdStructuralMerge.rs:896
fn positional(args: [String], command: String) -> [String] {
    out := [String]{}
    skip_value := false
    started := false
    loop arg in args {
        if !started { if arg == command -> started = true; continue }
        if skip_value { skip_value = false; continue }
        if arg == "--out" || arg == "--repo" { skip_value = true; continue }
        if !arg.starts_with('-') && arg != "install-driver" -> &out.push(~arg)
    }
    ^out
}
// Rust: Source/CmdStructuralMerge.rs:918
fn flag_value(args: [String], name: String) -> String? {
    loop pair in args.windows(2) { if pair[0] == name -> return Val(pair[1]) }
    None
}
// Rust: Source/CmdStructuralMerge.rs:923
fn report_mode(args: [String]) -> String { if jet.CLI.machine_output_requested(args) -> "json" else -> "text" }
// Rust: Source/CmdStructuralMerge.rs:930
fn wants_help(args: [String]) -> Bool { args.iter().any(arg -> jet.CLI.is_help_flag(arg)) || args.get(1).is_some_and(arg -> arg == "help") }
// Rust: Source/CmdStructuralMerge.rs:934
fn diff_help() -> String { "usage: jet diff --structural <before.jet> <after.jet> [--json]\n\nCompares checked Jet definitions by semantic identity.\n" }
// Rust: Source/CmdStructuralMerge.rs:937
fn merge_help() -> String { "usage:\n  jet merge --structural <base.jet> <ours.jet> <theirs.jet> [--out <file.jet>] [--json]\n  jet merge install-driver [--repo <path>]\n\nPerforms a checked three-way structural merge or installs the opt-in Git driver.\n" }
// Rust: Source/CmdStructuralMerge.rs:940
fn same_module(path: OSPath, module: String) -> Bool { absolute_normalized(path) == absolute_normalized(OSPath.from(module)) }
// Rust: Source/CmdStructuralMerge.rs:943
fn absolute_normalized(path: OSPath) -> OSPath {
    if path.is_absolute() -> normalize_path(path)
    else {
        cwd :: env.current_dir() ?? fail("could not read current directory: {err}", "run from a readable directory")
        normalize_path(cwd.join(path))
    }
}
// Rust: Source/CmdStructuralMerge.rs:959
fn change_value(change: &Change) -> StatusValue {
    StatusValue.object(StatusFields.new().with("kind", change.kind.name()).with("stable_id", change.stable_id)
        .with("before", change.before.map(value -> StatusValue.from(value)) ?? StatusValue.Null)
        .with("after", change.after.map(value -> StatusValue.from(value)) ?? StatusValue.Null)
        .with("semantic_op", change.semantic_op.map(op -> semantic_op_value(&op)) ?? StatusValue.Null))
}
// Rust: Source/CmdStructuralMerge.rs:990
fn semantic_op_value(op: &SemanticOp) -> StatusValue {
    optional :: (value: String?) -> value.map(text -> StatusValue.from(text)) ?? StatusValue.Null
    StatusValue.object(StatusFields.new().with("kind", op.kind).with("rule_id", optional(op.rule_id))
        .with("from", optional(op.from)).with("to", optional(op.to)).with("node", optional(op.node))
        .with("match", optional(op.match_template)).with("replace", optional(op.replace_template)))
}
// Rust: Source/CmdStructuralMerge.rs:1008
fn conflict_value(conflict: &Conflict) -> StatusValue {
    StatusValue.object(StatusFields.new().with("kind", conflict.kind).with("stable_id", conflict.stable_id)
        .with("human_identity", conflict.human_identity).with("ours", conflict.ours).with("theirs", conflict.theirs))
}
// Rust: Source/CmdStructuralMerge.rs:1018
fn render_index_error(context: String, error: SemIndexError) -> Never {
    jet_cli_error_fix("E2105", context, "correct source errors; structural tools never merge unchecked code")
    if error == .Load(diags) { loop diagnostic in diags -> eprintln("  {diagnostic.code}: {diagnostic.what}") }
    exit(ExitCodes.USER_ERROR)
}
// Rust: Source/CmdStructuralMerge.rs:1026
fn fail(message: String, fix: String) -> Never {
    jet_cli_error_fix("E2104", message, fix)
    exit(ExitCodes.USAGE)
}
