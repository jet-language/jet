// Rust `indentation` (CmdImport.rs:3432-3434), spaces/tabs only, measured in bytes.
pub fn jet_cli_import_indentation(line: String) -> Int Never! {
    at := 0
    bytes :: line.bytes()
    loop at < bytes.len() && (bytes[at] == (U8{32}) || bytes[at] == (U8{9})) -> at += 1
