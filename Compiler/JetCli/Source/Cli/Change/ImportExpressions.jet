    String.from_bytes([U8]{U8.from_int(192 + value /% 64) ?? panic("Latin-1 lead"), U8.from_int(128 + value % 64) ?? panic("Latin-1 trail")}) ?? panic("Latin-1 token")
}
// Rust `push_piece` (2326-2331).
pub fn jet_cli_import_push_piece(output: &[U8], piece: String) Never! {
    if !output.is_empty() && output[output.len() - 1] != (U8{40}) && output[output.len() - 1] != (U8{32}) -> &output.push(U8{32})
