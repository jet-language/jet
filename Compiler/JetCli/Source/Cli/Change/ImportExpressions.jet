// Rust `assignment` (CmdImport.rs:3394-3400).
pub fn jet_cli_import_assignment(line: String) -> (left: String, right: String)? Never! {
    pair :: jet_cli_import_split_top(line, "=") ?? return None
    if pair.right.starts_with("=") || pair.left.ends_with("!") || pair.left.ends_with("<") || pair.left.ends_with(">") -> return None
