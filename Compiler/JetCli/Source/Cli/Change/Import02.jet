// Rust: Source/CmdImport.rs:2473
pub fn jet_cli_import_attach_import_evidence(plan: &JetCLIImportPlan) -> Err! {
    // The canonical completed Plan carries boundary/evidence non-optionally.
    derivation :: plan.evidence.derivations.first() ?? return Err("source import evidence has no derivation")
    evidence :: plan.evidence.records.first() ?? return Err("source import evidence has no record")
    boundary :: plan.boundary.attach_derivation(derivation).attach_evidence(evidence)
    boundary.validate()
    plan.boundary = ^boundary
    return
}

// Rust: Source/CmdImport.rs:2496
pub fn jet_cli_import_indexed_artifact_path(index: JetCLIRecordIndex, entry: JetCLIRecordIndexEntry, cwd: Path) -> Path Never! {
    path :: import_paths.of(entry.path)
    if import_paths.is_absolute(path) -> return path
    if jet_cli_receipt_strip_prefix(path, import_paths.of(".jet")) != None -> return import_paths.join_path(cwd, path)
    import_paths.join_path(index.root, path)
}

// Rust: Source/CmdImport.rs:2506
pub fn jet_cli_import_receipt_store_for_artifact(path: Path) -> JetCLIReceiptStore Err! {
    objects :: jet_cli_receipt_parent(path) ?? return Err("receipt artifact has no parent: {path.raw}")
    if jet_cli_receipt_file_name(objects) != "objects" -> return Err("indexed comparison path is not a receipt object: {path.raw}")
    root :: jet_cli_receipt_parent(objects) ?? return Err("receipt object has no store root: {path.raw}")
    Ok(JetCLIReceiptStore{root: root})
}

// Rust: Source/CmdImport.rs:2522
pub fn jet_cli_import_attachment_values(record: EvidenceRecord, name: String) -> [String] Never! {
    values := [String]{}
    loop attachment in record.attachments {
        if attachment.name == name -> &values.push(~attachment.value)
    }
    values
}

// Rust: Source/CmdImport.rs:2531
pub fn jet_cli_import_require_attachment(record: EvidenceRecord, name: String, expected: String) -> Err! {
    values :: jet_cli_import_attachment_values(record, name)
    if values.len() != 1 || values[0] != expected -> return Err("indexed evidence attachment `{name}` does not match the current import")
    return
}

// Rust: Source/CmdImport.rs:2545
pub fn jet_cli_import_require_attachment_set(record: EvidenceRecord, name: String, expected: [String]) -> Err! {
    values := jet_cli_import_attachment_values(record, name)
    &values.sort()
    if values != expected -> return Err("indexed evidence attachments `{name}` do not match the current import")
    return
}

// Rust: Source/CmdImport.rs:2560
pub fn jet_cli_import_validate_import_binding(record: EvidenceRecord, boundary: ForeignBoundaryContract, boundary_digest: String, source_digest: String, replacement_digest: String) -> Err! {
    jet_cli_import_require_attachment(record, "boundary", boundary_digest)
    jet_cli_import_require_attachment(record, "source-digest", source_digest)
    jet_cli_import_require_attachment(record, "replacement-digest", replacement_digest)
    jet_cli_import_require_attachment(record, "source-identity", boundary.identity.source)
    jet_cli_import_require_attachment(record, "replacement-identity", boundary.identity.overlay)
    jet_cli_import_require_attachment(record, "tool-identity", boundary.identity.toolchain)
    jet_cli_import_require_attachment(record, "target-identity", boundary.identity.target)
    jet_cli_import_require_attachment(record, "coverage", boundary.artifact_coverage.digest())
    jet_cli_import_require_attachment_set(record, "assumption", boundary.assumptions)
    identity :: boundary.identity.derivation_identity()
    if record.build.toolchain != identity.build || record.build.target != identity.target || record.build.profile != "source-import" -> return Err("indexed import evidence build identity is stale")
    if record.revision.source != identity.source || record.revision.build != identity.build || record.revision.revision != identity.run -> return Err("indexed import evidence revision identity is stale")
    return
}

// Rust: Source/CmdImport.rs:2596
pub fn jet_cli_import_indexed_import_evidence(index: JetCLIRecordIndex, cwd: Path, boundary: ForeignBoundaryContract, boundary_digest: String, source_digest: String, replacement_digest: String) -[FS.Read]> (record: EvidenceRecord, derivation: DerivationRecord) Err! {
    report_id :: "source-import-{boundary_digest}"
    entry :: jet_cli_record_index_find(index, JetCLIRecordKind.Evidence, report_id, true) ?? return Err("source import update requires prior indexed import evidence for the current source")
    if entry.identity.target_inputs_sha256 != source_digest || entry.identity.engine != evidence_producer_name(EvidenceProducerKind.Compile) -> return Err("indexed import evidence is stale against the current source digest")
    path :: jet_cli_import_indexed_artifact_path(index, entry, cwd)
    report :: evidence_report_read(path.raw) ?? return Err("cannot read indexed import evidence: {err.message}")
    if !evidence_report_is_complete(report) -> return Err("indexed import evidence is incomplete")
    found := EvidenceRecord?{None}
    loop record in report.records {
        if record.identity.report_id == report_id && record.identity.claim_id == "source-import" {
            found = Val(~record)
            break
        }
    }
    record :: found ?? return Err("indexed import evidence has no source-import record")
    evidence_record_validate(record) ?? return Err("indexed import evidence is invalid: {evidence_expectation_error_text(err)}")
    if record.outcome != EvidenceOutcome.Generated -> return Err("indexed import evidence is not a complete generated candidate: {evidence_outcome_name(record.outcome)}")
    jet_cli_import_validate_import_binding(record, boundary, boundary_digest, source_digest, replacement_digest)
    reference :: record.derivation ?? return Err("indexed import evidence has no derivation reference")
    derivation :: evidence_report_derivation(report, reference) ?? return Err("indexed import evidence has no derivation payload")
    if !derivation_record_validate(derivation) -> return Err("derivation {derivation.id} has a non-canonical identity")
    if derivation.identity != boundary.identity.derivation_identity() -> return Err("indexed import derivation identity is stale")
    if derivation.method != MIRDerivationMethod.StaticDerivation || derivation.rule != "foreign-source-import" || derivation.disposition != MIRDerivationDisposition.Current -> return Err("indexed import derivation is not current")
    premises := [String]{~boundary_digest, boundary.artifact_coverage.digest(), ~source_digest, ~replacement_digest}
    &premises.sort()
    &premises.dedup()
    if derivation.premises != premises -> return Err("indexed import derivation premises are stale")
    Ok((record: ^record, derivation: ^derivation))
}

// Rust: Source/CmdImport.rs:2678
pub fn jet_cli_import_validate_comparison_binding(record: EvidenceRecord, comparison: ComparisonRecord, artifact_id: String, boundary: ForeignBoundaryContract, boundary_digest: String) -> Err! {
    jet_cli_import_require_attachment(record, "comparison-artifact", artifact_id)
    jet_cli_import_require_attachment(record, "boundary", boundary_digest)
    jet_cli_import_require_attachment(record, "source-identity", boundary.identity.source)
    jet_cli_import_require_attachment(record, "replacement-identity", boundary.identity.overlay)
    jet_cli_import_require_attachment(record, "tool-identity", boundary.identity.toolchain)
    jet_cli_import_require_attachment(record, "target-identity", boundary.identity.target)
    jet_cli_import_require_attachment(record, "coverage", boundary.artifact_coverage.digest())
    jet_cli_import_require_attachment_set(record, "assumption", boundary.assumptions)
    if record.build.toolchain != boundary.identity.toolchain || record.build.target != boundary.identity.target || record.build.profile != "comparison" || record.revision.source != artifact_id || record.revision.build != "jet-comparison-v1" || record.revision.revision != artifact_id -> return Err("indexed comparison evidence build identity is stale")
    loop sample in comparison.samples {
        if sample.identity.source != boundary.identity.source || sample.identity.tool != boundary.identity.toolchain || sample.identity.target != boundary.identity.target -> return Err("indexed comparison samples are not bound to the current foreign tool and target")
    }
    return
}

// Rust: Source/CmdImport.rs:2712
pub fn jet_cli_import_indexed_comparison<F: JetCLIReceiptReadHost>(index: JetCLIRecordIndex, cwd: Path, boundary: ForeignBoundaryContract, boundary_digest: String, file_host: &F) -[FS]> ComparisonRecord Err! {
    entries := jet_cli_record_index_query_kind(index, JetCLIRecordKind.Comparison, true)
    &entries.sort_by((left: JetCLIRecordIndexEntry, right: JetCLIRecordIndexEntry) -> {
        if left.recorded_sequence != right.recorded_sequence -> right.recorded_sequence <=> left.recorded_sequence
        else -> left.artifact_id <=> right.artifact_id
    })
    stale_reason := String?{None}
    loop entry in entries {
        path :: jet_cli_import_indexed_artifact_path(index, entry, cwd)
        // GATE #4494: the canonical bounded held/no-follow reader, not a Rust bridge.
        bytes :: foundation_read_file_nofollow(path.raw, JET_CLI_MAX_RECEIPT_BYTES) ?? {
            stale_reason = Val("indexed comparison receipt `{entry.artifact_id}` could not be authenticated: {err}")
            next
        }
        raw_receipt :: jet_cli_receipt_decode_bytes(bytes) ?? {
            stale_reason = Val("indexed comparison receipt `{entry.artifact_id}` could not be authenticated: {err.message}")
            next
        }
        store :: jet_cli_import_receipt_store_for_artifact(path)
        current :: jet_cli_receipt_store_lookup(store, raw_receipt.claim, &file_host) ?? return Err(err.message)
        receipt :: current ?? {
            stale_reason = Val("indexed comparison `{entry.artifact_id}` is stale against its current corpus inputs")
            next
        }
        found := JetCLIReceiptSection?{None}
        loop section in receipt.sections {
            if section.name == "comparison" && section.type_name == "ComparisonRecord" {
                found = Val(~section)
                break
            }
        }
        section :: found ?? { next }
        payload :: jet_cli_receipt_section_value(section) ?? return Err(err.message)
        comparison :: comparison_record_from_json(payload) ?? return Err(err.message)
        artifact_id :: comparison_record_artifact_id(comparison) ?? return Err(err.message)
        if section.payload_digest != artifact_id || artifact_id != entry.artifact_id -> return Err("indexed comparison `{entry.artifact_id}` has a non-canonical artifact digest")
        bound := false
        bound_error := String?{None}
        loop link in receipt.consumed {
            if link.kind != JetCLIRecordKind.Evidence -> next
            evidence_entry :: jet_cli_record_index_find(index, JetCLIRecordKind.Evidence, link.artifact_id, true) ?? {
                bound_error = Val("comparison `{entry.artifact_id}` links to missing evidence `{link.artifact_id}`")
                next
            }
            evidence_path :: jet_cli_import_indexed_artifact_path(index, evidence_entry, cwd)
            evidence_report :: evidence_report_read(evidence_path.raw) ?? return Err("cannot read comparison evidence `{link.artifact_id}`: {err.message}")
            if !evidence_report_is_complete(evidence_report) {
                bound_error = Val("comparison evidence `{link.artifact_id}` is incomplete")
                next
            }
            loop evidence in evidence_report.records {
                if evidence.identity.report_id != link.artifact_id || evidence.identity.claim_id != "comparison" -> next
                if jet_cli_import_validate_comparison_binding(evidence, comparison, artifact_id, boundary, boundary_digest) == .Err(_) -> next
                bound = true
                evidence_record_validate(evidence) ?? return Err("indexed comparison evidence is invalid: {evidence_expectation_error_text(err)}")
                if evidence.outcome != EvidenceOutcome.Passed -> return Err("indexed comparison `{entry.artifact_id}` is not accepted: evidence outcome is {evidence_outcome_name(evidence.outcome)}")
                reference :: evidence.derivation ?? return Err("indexed comparison `{entry.artifact_id}` has no checked derivation")
                derivation :: evidence_report_derivation(evidence_report, reference) ?? return Err("indexed comparison `{entry.artifact_id}` has a missing derivation payload")
                if derivation.disposition != MIRDerivationDisposition.Current -> return Err("indexed comparison `{entry.artifact_id}` has stale derivation evidence")
                if derivation != evidence_record_checked_derivation(evidence) -> return Err("indexed comparison `{entry.artifact_id}` derivation does not match its evidence")
            }
        }
        if !bound {
            if bound_error == .Val(error) -> stale_reason = Val(^error)
            next
        }
        comparison_record_assert_equal(comparison) ?? return Err("indexed comparison `{entry.artifact_id}` was not matched: {comparison_assertion_error_text(err)}")
        return Ok(^comparison)
    }
    Err(stale_reason ?? "source import update requires an indexed matched comparison bound to the current source, generated candidate, tool, target, coverage, and assumptions")
}

// Rust: Source/CmdImport.rs:2865
pub fn jet_cli_import_accept_update_replacement<H: JetCLIImportPlanHost, I: JetCLIRecordIndexFileHost, F: JetCLIReceiptReadHost>(plan: &JetCLIImportPlan, cwd: Path, plan_host: &H, index_host: &I, file_host: &F) -[FS]> ForeignSourceReceipt Err! {
    boundary :: plan.boundary
    if !boundary.has_complete_artifact_coverage() -> return Err("source import replacement coverage is incomplete")
    current_files := [Path]{}
    jet_cli_import_collect_sources(plan.source, plan.source, plan.language, &current_files, &plan_host) ?? return Err(err.message)
    &current_files.sort_by((left: Path, right: Path) -> jet_cli_record_compare_paths(left.raw, right.raw))
    current_source_digest :: jet_cli_import_tree_identity(plan.source, current_files, "jet-source-import-input-v1", &plan_host) ?? return Err(err.message)
    if current_source_digest != plan.source_digest -> return Err("source import update source changed after planning")
    index :: jet_cli_record_index_load_for_project(cwd, &index_host) ?? return Err("cannot load indexed reasoning records: {err.message}")
    prior :: jet_cli_import_indexed_import_evidence(index, cwd, boundary, plan.boundary_digest, plan.source_digest, plan.replacement_digest)
    comparison :: jet_cli_import_indexed_comparison(index, cwd, boundary, plan.boundary_digest, &file_host)
    accepted := ~boundary
    current_identity :: ~accepted.identity
    current_coverage :: ~accepted.artifact_coverage
    replacement_identity :: ~current_identity.overlay
    receipt :: &accepted.accept_reasoned_replacement(current_identity, current_coverage, prior.derivation, prior.record, comparison, ^replacement_identity)
    plan.boundary = ^accepted
    Ok(^receipt)
}

// Rust: Source/CmdImport.rs:2917
pub fn jet_cli_import_accepted_receipt_json(receipt: ForeignSourceReceipt, assumptions: [String]) -> CanonicalJSON Err! {
    identity :: canonical_json_object([CanonicalJSONField]{
        CanonicalJSONField{key: "generator", value: CanonicalJSON.String(~receipt.boundary_identity.generator)},
        CanonicalJSONField{key: "implementation", value: CanonicalJSON.String(~receipt.boundary_identity.implementation)},
        CanonicalJSONField{key: "overlay", value: CanonicalJSON.String(~receipt.boundary_identity.overlay)},
        CanonicalJSONField{key: "source", value: CanonicalJSON.String(~receipt.boundary_identity.source)},
        CanonicalJSONField{key: "target", value: CanonicalJSON.String(~receipt.boundary_identity.target)},
        CanonicalJSONField{key: "toolchain", value: CanonicalJSON.String(~receipt.boundary_identity.toolchain)}
    }) ?? return Err(err.message)
    evidence := [CanonicalJSON]{}
    loop item in receipt.evidence {
        value :: canonical_json_object([CanonicalJSONField]{
            CanonicalJSONField{key: "claim_id", value: CanonicalJSON.String(~item.claim_id)},
            CanonicalJSONField{key: "evidence_id", value: CanonicalJSON.String(~item.evidence_id)},
            CanonicalJSONField{key: "report_id", value: CanonicalJSON.String(~item.report_id)}
        }) ?? return Err(err.message)
        &evidence.push(^value)
    }
    derivation :: canonical_json_object([CanonicalJSONField]{CanonicalJSONField{key: "id", value: CanonicalJSON.String(~receipt.derivation.id)}}) ?? return Err(err.message)
    assumption_values := [CanonicalJSON]{}
    loop assumption in assumptions -> &assumption_values.push(CanonicalJSON.String(~assumption))
    reason :: if receipt.comparison_reason == .Val(value) -> CanonicalJSON.String(~value) else -> CanonicalJSON.Null
    difference :: if receipt.first_difference == .Val(value) -> CanonicalJSON.Integer("{value}") else -> CanonicalJSON.Null
    value :: canonical_json_object([CanonicalJSONField]{
        CanonicalJSONField{key: "artifact_coverage_digest", value: CanonicalJSON.String(~receipt.artifact_coverage_digest)},
        CanonicalJSONField{key: "assumptions", value: CanonicalJSON.Array(^assumption_values)},
        CanonicalJSONField{key: "boundary_digest", value: CanonicalJSON.String(~receipt.boundary_digest)},
        CanonicalJSONField{key: "boundary_identity", value: ^identity},
        CanonicalJSONField{key: "comparison_artifact_id", value: CanonicalJSON.String(~receipt.comparison_artifact_id)},
        CanonicalJSONField{key: "comparison_reason", value: ^reason},
        CanonicalJSONField{key: "comparison_relation", value: CanonicalJSON.String(~receipt.comparison_relation)},
        CanonicalJSONField{key: "comparison_schema_version", value: CanonicalJSON.Integer("{receipt.comparison_schema_version}")},
        CanonicalJSONField{key: "comparison_status", value: CanonicalJSON.String(~receipt.comparison_status)},
        CanonicalJSONField{key: "compared_samples", value: CanonicalJSON.Integer("{receipt.compared_samples}")},
        CanonicalJSONField{key: "derivation", value: ^derivation},
        CanonicalJSONField{key: "discarded_cases", value: CanonicalJSON.Integer("{receipt.discarded_cases}")},
        CanonicalJSONField{key: "evidence", value: CanonicalJSON.Array(^evidence)},
        CanonicalJSONField{key: "first_difference", value: ^difference},
        CanonicalJSONField{key: "replacement_identity", value: CanonicalJSON.String(~receipt.replacement_identity)},
        CanonicalJSONField{key: "schema", value: CanonicalJSON.String(~receipt.schema)},
        CanonicalJSONField{key: "source_authority", value: CanonicalJSON.String(receipt.source_authority.as_str())},
        CanonicalJSONField{key: "source_identity", value: CanonicalJSON.String(~receipt.source_identity)}
    }) ?? return Err(err.message)
    Ok(^value)
}

// Rust: Source/CmdImport.rs:2975
pub fn jet_cli_import_persist_accepted_receipt<H: JetCLIImportPlanHost, F: JetCLIReceiptReadHost, A: JetCLIReceiptAuthorityHost, P: JetCLIReceiptProcessHost, I: JetCLIRecordIndexFileHost, R: JetCLIRecordRetentionHost>(plan: JetCLIImportPlan, receipt: ForeignSourceReceipt, cwd: Path, tools: JetCLIReceiptToolIdentity, plan_host: &H, file_host: &F, authority: &A, process_host: &P, index_host: &I, retention: &R) -[FS, Env, IO, Time]> Err! {
    boundary :: plan.boundary
    receipt.validate()
    files := [Path]{}
    jet_cli_import_collect_sources(plan.source, plan.source, plan.language, &files, &plan_host) ?? return Err(err.message)
    &files.sort_by((left: Path, right: Path) -> jet_cli_record_compare_paths(left.raw, right.raw))
    if files.is_empty() -> return Err("accepted source import has no source inputs")
    argv :: [String]{"import", ~plan.source.raw, "--update"}
    root :: jet_cli_receipt_root_for("import", argv, cwd, &file_host, &authority)
    store :: JetCLIReceiptStore{root: ^root}
    section :: jet_cli_receipt_section_from_json("foreign-source-replacement", "ForeignSourceReceipt", jet_cli_import_accepted_receipt_json(receipt, boundary.assumptions)) ?? return Err(err.message)
    consumed := [JetCLIRecordLink]{}
    loop evidence in receipt.evidence {
        link :: jet_cli_record_link_new(JetCLIRecordKind.Evidence, ~evidence.report_id) ?? return Err(err.message)
        if !consumed.contains(link) -> &consumed.push(^link)
    }
    comparison :: jet_cli_record_link_new(JetCLIRecordKind.Comparison, ~receipt.comparison_artifact_id) ?? return Err(err.message)
    if !consumed.contains(comparison) -> &consumed.push(^comparison)
    _ :: jet_cli_receipt_store_record(store, "import", argv, files, I32{0}, [], [], [JetCLIReceiptSection]{^section}, consumed, [], tools, &file_host, &authority, &process_host, &index_host, &retention) ?? return Err(err.message)
    return
}

// Rust: Source/CmdImport.rs:3031
pub fn jet_cli_import_apply_plan<H: JetCLIImportPlanHost, F: JetCLIReceiptReadHost, A: JetCLIReceiptAuthorityHost, P: JetCLIReceiptProcessHost, I: JetCLIRecordIndexFileHost, R: JetCLIRecordRetentionHost>(plan: ^JetCLIImportPlan, mode: JetCLIImportMode, json: Bool, tools: JetCLIReceiptToolIdentity, plan_host: &H, file_host: &F, authority: &A, process_host: &P, index_host: &I, retention: &R) -[FS, Env, IO, Time]> JetDriverVerbOutput Never! {
    current_plan := ^plan
    if mode != JetCLIImportMode.DryRun {
        jet_cli_import_attach_import_evidence(&current_plan) ?? return jet_cli_import_operation_error("attach import evidence", err, json)
    }
    accepted_receipt := ForeignSourceReceipt?{None}
    if mode == JetCLIImportMode.Update {
        cwd :: &plan_host.cwd() ?? return jet_cli_import_operation_error("read current directory", err.message, json)
        receipt :: jet_cli_import_accept_update_replacement(&current_plan, cwd, &plan_host, &index_host, &file_host) ?? return jet_cli_import_operation_error("accept source replacement", err, json)
        accepted_receipt = Val(^receipt)
    }
    report :: jet_cli_import_report(current_plan)
    baseline_root :: import_paths.join(current_plan.target, ".jet-import/baseline")
    writes := [(path: Path, contents: String)]{}
    conflicts := [Path]{}
    loop generated in current_plan.generated {
        target :: import_paths.join_path(current_plan.target, generated.relative)
        baseline :: import_paths.join_path(baseline_root, generated.relative)
        existing :: if &plan_host.read_text(target) == .Ok(value) -> Val(^value) else -> None
        prior :: if &plan_host.read_text(baseline) == .Ok(value) -> Val(^value) else -> None
        if mode != JetCLIImportMode.DryRun {
            if existing == .None -> &writes.push((path: ~target, contents: ~generated.contents))
            else {
                current :: existing ?? panic("matched existing text")
                if current != generated.contents {
                    if mode == JetCLIImportMode.Create -> &conflicts.push(~target)
                    else {
                        if prior == .Val(old) {
                            if current == old -> &writes.push((path: ~target, contents: ~generated.contents))
                            else { if generated.contents != old -> &conflicts.push(~target) }
                        } else -> &conflicts.push(~target)
                    }
                }
            }
            if prior != Val(generated.contents) -> &writes.push((path: ^baseline, contents: ~generated.contents))
        }
    }
    report_path :: import_paths.join(current_plan.target, "import-report.json")
    report_baseline :: import_paths.join(baseline_root, "import-report.json")
    existing_report :: if &plan_host.read_text(report_path) == .Ok(value) -> Val(^value) else -> None
    prior_report :: if &plan_host.read_text(report_baseline) == .Ok(value) -> Val(^value) else -> None
    if mode != JetCLIImportMode.DryRun {
        if existing_report == .None -> &writes.push((path: ~report_path, contents: ~report))
        else {
            current :: existing_report ?? panic("matched existing report")
            if current != report {
                if mode == JetCLIImportMode.Create -> &conflicts.push(~report_path)
                else {
                    if prior_report == .Val(old) {
                        if current == old -> &writes.push((path: ~report_path, contents: ~report))
                        else { if report != old -> &conflicts.push(~report_path) }
                    } else -> &conflicts.push(~report_path)
                }
            }
        }
        if prior_report != Val(report) -> &writes.push((path: ^report_baseline, contents: ~report))
    }
    if !conflicts.is_empty() {
        conflict_paths := [String]{}
        values := [DataTree]{}
        loop path in conflicts {
            &conflict_paths.push(~path.raw)
            &values.push(DataTree.Text(~path.raw))
        }
        row :: diagnostic_registry_row("JT0199") ?? panic("JT0199 is not registered")
        diagnostic :: diagnostic_from_registry("JT0199", None, row.what.replace("{{paths}}", conflict_paths.join(", ")), row.why, row.fix)
        if json -> return JetDriverVerbOutput{stdout: StatusEnvelope.new("import", false).with_report(ReportEnvelope.new("tool", "error", diagnostic.code, diagnostic.what, diagnostic.why, diagnostic.fix)).with_field("paths", DataTree.Array(^values)).json_line(), stderr: "", exit_code: 1}
        output := [U8]{}
        jet_cli_import_files_append(&output, "error[{diagnostic.code}]: {diagnostic.what}\n")
        loop path in conflicts -> jet_cli_import_files_append(&output, "  {path.raw}\n")
        jet_cli_import_files_append(&output, "  why: {diagnostic.why}\n  fix: {diagnostic.fix}\n")
        return JetDriverVerbOutput{stdout: "", stderr: String.from_bytes(^output) ?? panic("import conflict UTF-8"), exit_code: 1}
    }
    loop write in writes {
        if jet_cli_receipt_parent(write.path) == .Val(parent) {
            // GATE #4494: real recursive native directory creation.
            import_files.create_dir_all(parent.raw) ?? return jet_cli_import_operation_error("create import output", "{err}", json)
        }
        import_files.write_bytes(write.path.raw, write.contents.bytes()) ?? return jet_cli_import_operation_error("write import output", "{err}", json)
    }
    if mode != JetCLIImportMode.DryRun {
        persist_evidence_report_for_inputs(&current_plan.evidence, current_plan.source_digest) ?? return jet_cli_import_operation_error("persist import evidence", err, json)
    }
    if accepted_receipt == .Val(receipt) {
        cwd :: &plan_host.cwd() ?? return jet_cli_import_operation_error("read current directory", err.message, json)
        jet_cli_import_persist_accepted_receipt(current_plan, receipt, cwd, tools, &plan_host, &file_host, &authority, &process_host, &index_host, &retention) ?? return jet_cli_import_operation_error("persist accepted source receipt", err, json)
    }
    if json -> return JetDriverVerbOutput{stdout: StatusEnvelope.new("import", true).with_field("import", jet_cli_import_report_value(current_plan)).json_line(), stderr: "", exit_code: 0}
    verb :: if mode == JetCLIImportMode.DryRun -> "would import" else -> "imported"
    output := [U8]{}
    jet_cli_import_files_append(&output, "{verb} {current_plan.source.raw} -> {current_plan.target.raw}\n  {current_plan.functions} functions, {current_plan.tests} carried tests, {current_plan.todos.len()} TODO diagnostics\n")
    boundary :: current_plan.boundary
    jet_cli_import_files_append(&output, "  migration: {boundary.disposition.as_str()} (mode: {jet_cli_import_migration_mode(boundary)}; source conversion: {jet_cli_import_migration_source_conversion(boundary)}; source authority: {boundary.source_authority.as_str()})\n")
    loop todo in current_plan.todos {
        diagnostic :: jet_cli_import_todo_diagnostic(todo)
        jet_cli_import_files_append(&output, "  {diagnostic.code} {diagnostic.what}\n    why: {diagnostic.why}\n    fix: {diagnostic.fix}\n    target: {todo.target}  status: {todo.status}\n")
    }
    JetDriverVerbOutput{stdout: String.from_bytes(^output) ?? panic("import output UTF-8"), stderr: "", exit_code: 0}
}

