fn final_path(handle: Handle) -> String std.io.Error! {
    needed :: #Unsafe("query Windows final-path buffer size") { GetFinalPathNameByHandleW(handle, std.ptr.null_mut(), 0, 0) }
    if needed == 0 { return Err(std.io.Error.last_os_error()) }
