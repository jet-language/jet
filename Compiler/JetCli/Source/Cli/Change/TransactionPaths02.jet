fn secure_replace_windows(project: &OSPath, temp: &OSPath, path: &OSPath, expected: &[UInt8]) -> Void std.io.Error! {
    if path_identity(path)? == path_identity(temp)? { return Err(std.io.Error.new(std.io.ErrorKind.PermissionDenied, "temp aliases destination")) }
    relative :: path.strip_prefix(project).map_err(_ -> std.io.Error.new(std.io.ErrorKind.PermissionDenied, "destination escapes project"))?
    current_path := project.to_path_buf()
    for component in relative.parent().into_iter().flat_map(parent -> parent.components()) {
        part :: if component == { Normal(part) -> part; _ -> return Err(std.io.Error.new(std.io.ErrorKind.InvalidInput, "non-normal codemod path")) }
        current_path.push(part)
        meta :: fs.symlink_metadata(current_path)?
        if meta.file_type().is_symlink() || !meta.is_dir() { return Err(std.io.Error.new(std.io.ErrorKind.PermissionDenied, "codemod parent is not a real directory")) }
    }
    project_handle :: open_handle(project, GENERIC_READ | GENERIC_WRITE, true)?
    parent :: open_handle(path.parent() ?? project, GENERIC_READ | GENERIC_WRITE, true)?
    destination :: open_handle(path, GENERIC_READ, false)?
    project_final :: final_path(project_handle.as_raw_handle())?
    parent_final :: final_path(parent.as_raw_handle())?
    destination_final :: final_path(destination.as_raw_handle())?
    trimmed := project_final.trim_end_matches(['\\', '/']) // #4303
    project_prefix :: "{trimmed}\\"
    if parent_final != project_final && !parent_final.starts_with(project_prefix) { return Err(std.io.Error.new(std.io.ErrorKind.PermissionDenied, "opened destination parent escapes project handle")) }
    destination_parent :: destination_final.rsplit_once(['\\', '/']).map((parent, _) -> parent) ?? ""
    if destination_parent.trim_end_matches(['\\', '/']) != parent_final.trim_end_matches(['\\', '/']) { return Err(std.io.Error.new(std.io.ErrorKind.PermissionDenied, "destination does not belong to opened parent directory")) }
    destination_file := File.from(^destination)
    current := []
    destination_file.read_to_end(&current)?
    if current != expected { return Err(std.io.Error.new(std.io.ErrorKind.Other, "destination drifted before rename")) }
    temp_handle :: open_handle(temp, GENERIC_READ | DELETE, false)?
    temp_final :: final_path(temp_handle.as_raw_handle())?
    temp_parent :: temp_final.rsplit_once(['\\', '/']).map((parent, _) -> parent) ?? ""
    if temp_parent.trim_end_matches(['\\', '/']) != parent_final.trim_end_matches(['\\', '/']) ||
        (temp_parent != project_final && !temp_parent.starts_with(project_prefix)) { return Err(std.io.Error.new(std.io.ErrorKind.PermissionDenied, "opened temp does not belong to opened project parent directory")) }
    file_name :: path.file_name().ok_or_else(() -> std.io.Error.new(std.io.ErrorKind.InvalidInput, "destination has no name"))?.encode_wide().collect()
    bytes :: file_name.len() * std.mem.size_of::<UInt16>()
    size :: std.mem.size_of::<FileRenameInfo>() + bytes.saturating_sub(2)
    buffer := Array<UInt64>.filled(0, size.div_ceil(std.mem.size_of::<UInt64>()))
    // GATE #4494: C-aligned backing words, exact variable-tail FILE_RENAME_INFO layout.
    #Unsafe("initialize exact Windows rename-info header and inline UTF-16 name") {
        info :: buffer.as_mut_ptr().cast::<FileRenameInfo>()
        (*info).replace_if_exists = 1
        (*info).root_directory = parent.as_raw_handle()
        (*info).file_name_length = bytes as UInt32
        std.ptr.copy_nonoverlapping(file_name.as_ptr(), (*info).file_name.as_mut_ptr(), file_name.len())
    }
    if #Unsafe("handle-relative native temp rename with initialized buffer") { SetFileInformationByHandle(temp_handle.as_raw_handle(), FILE_RENAME_INFO_CLASS, buffer.as_mut_ptr().cast(), size as UInt32) } == 0 { return Err(std.io.Error.last_os_error()) }
    if #Unsafe("flush retained parent directory handle") { FlushFileBuffers(parent.as_raw_handle()) } == 0 { return Err(std.io.Error.last_os_error()) }
    if parent_final != project_final && #Unsafe("flush retained project directory handle") { FlushFileBuffers(project_handle.as_raw_handle()) } == 0 { return Err(std.io.Error.last_os_error()) }
    Ok(())
}
// Rust: Source/CmdCodemod/Transaction.rs:3131
fn secure_replace_other(project: &OSPath, temp: &OSPath, path: &OSPath, expected: &[UInt8]) -> Void std.io.Error! {
    relative :: path.strip_prefix(project).map_err(_ -> std.io.Error.new(std.io.ErrorKind.PermissionDenied, "destination escapes project"))?
    current_path := project.to_path_buf()
    for component in relative.parent().into_iter().flat_map(parent -> parent.components()) {
        part :: if component == { Normal(part) -> part; _ -> return Err(std.io.Error.new(std.io.ErrorKind.InvalidInput, "non-normal codemod path")) }
        current_path.push(part)
        meta :: fs.symlink_metadata(current_path)?
        if meta.file_type().is_symlink() || !meta.is_dir() { return Err(std.io.Error.new(std.io.ErrorKind.PermissionDenied, "codemod parent is not a real directory")) }
    }
    if fs.read(path)? != expected { return Err(std.io.Error.new(std.io.ErrorKind.Other, "destination drifted before rename")) }
    fs.rename(temp, path)
}
// Rust: Source/CmdCodemod/Transaction.rs:3168
fn now_nanos() -> UInt128 { SystemTime.now().duration_since(UNIX_EPOCH).unwrap_or_default().as_nanos() }
// Rust: Source/CmdCodemod/Transaction.rs:3174
fn unhex(s: String) -> [UInt8] {
    if s.len() % 2 != 0 { fail("invalid recovery journal byte encoding") }
    (0..<s.len()).step_by(2).map(i -> UInt8.from_str_radix(s.get(i..<i + 2).unwrap(), 16)
        .unwrap_or_else(_ -> fail("invalid recovery journal byte encoding"))).collect()
}
