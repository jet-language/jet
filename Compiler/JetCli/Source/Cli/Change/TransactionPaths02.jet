    destination_identity :: path_identity(path)?
    temp_identity :: path_identity(temp)?
    if destination_identity == temp_identity { return Err(std.io.Error.new(std.io.ErrorKind.PermissionDenied, "temp aliases destination")) }
    if temp.parent() != path.parent() { return Err(std.io.Error.new(std.io.ErrorKind.InvalidInput, "codemod temp is not beside destination")) }
    relative :: path.strip_prefix(project).map_err(_ -> std.io.Error.new(std.io.ErrorKind.PermissionDenied, "destination escapes project"))?
    root :: OpenOptions.new().read(true).custom_flags(O_DIRECTORY | O_NOFOLLOW | O_CLOEXEC).open(project)?
    held := []
    dirfd := root.as_raw_fd()
    for component in relative.parent().into_iter().flat_map(parent -> parent.components()) {
        part :: if component == { Normal(part) -> part; _ -> return Err(std.io.Error.new(std.io.ErrorKind.InvalidInput, "non-normal codemod path")) }
        part_name :: name(part)?
        fd :: #Unsafe("open normal parent component without following links") { openat(dirfd, part_name.as_ptr(), O_RDONLY | O_DIRECTORY | O_NOFOLLOW | O_CLOEXEC, 0) }
        if fd < 0 { return Err(std.io.Error.last_os_error()) }
        held.push(#Unsafe("retain directory fd through final rename") { std.os.fd.OwnedFd.from_raw_fd(fd) })
        dirfd = held.last().unwrap().as_raw_fd()
    }
    final_name :: name(relative.file_name().ok_or_else(() -> std.io.Error.new(std.io.ErrorKind.InvalidInput, "destination has no name"))?)?
    fd :: #Unsafe("open final destination relative to checked ancestry") { openat(dirfd, final_name.as_ptr(), O_RDONLY | O_NOFOLLOW | O_CLOEXEC, 0) }
    if fd < 0 { return Err(std.io.Error.last_os_error()) }
    destination := #Unsafe("retain destination fd while checking contents") { File.from_raw_fd(fd) }
    if !destination.metadata()?.is_file() || destination.metadata()?.nlink() != 1 { return Err(std.io.Error.new(std.io.ErrorKind.PermissionDenied, "destination is not regular file")) }
    current := []
    destination.read_to_end(&current)?
    if current != expected { return Err(std.io.Error.new(std.io.ErrorKind.Other, "destination drifted before handle-relative rename")) }
    temp_name :: name(temp.file_name().ok_or_else(() -> std.io.Error.new(std.io.ErrorKind.InvalidInput, "temp has no name"))?)?
    temp_fd :: #Unsafe("open temp relative to retained destination parent") { openat(dirfd, temp_name.as_ptr(), O_RDONLY | O_NOFOLLOW | O_CLOEXEC, 0) }
    if temp_fd < 0 { return Err(std.io.Error.last_os_error()) }
    temp_check :: #Unsafe("own temp check descriptor") { File.from_raw_fd(temp_fd) }
    if temp_check.metadata()?.nlink() != 1 { return Err(std.io.Error.new(std.io.ErrorKind.PermissionDenied, "temp has multiple links")) }
    if #Unsafe("rename checked sibling temp over destination") { renameat(dirfd, temp_name.as_ptr(), dirfd, final_name.as_ptr()) } != 0 { return Err(std.io.Error.last_os_error()) }
