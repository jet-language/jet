fn replace_journal_generation(lock: &Lock, tx: String, generation: USize, bytes: &[UInt8], expected: (UInt64, UInt64)?) -> (UInt64, UInt64) {
    if core.sys.target.selected_family() != "unix" { fail("handle-relative journal publication is unavailable on this platform") }
