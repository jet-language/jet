fn unlink_at_checked(dir: &File, file_name: &OSPath, expected: (UInt64, UInt64)) -> Void std.io.Error! {
    if core.sys.target.selected_family() != "unix" { return Err(std.io.Error.new(std.io.ErrorKind.Unsupported, "handle-relative removal unavailable")) }
