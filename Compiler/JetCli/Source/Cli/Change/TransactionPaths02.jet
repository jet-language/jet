}
// Rust: Source/CmdCodemod/Transaction.rs:2745,2878,3131
fn secure_replace(project: &OSPath, temp: &OSPath, path: &OSPath, expected: &[UInt8]) -> Void std.io.Error! {
    // GATE #4483: all original Unix/Windows/other cfg arms, selected target.
    if core.sys.target.selected_family() == "unix" { return secure_replace_unix(project, temp, path, expected) }
    if core.sys.target.selected_os() == "windows" { return secure_replace_windows(project, temp, path, expected) }
    secure_replace_other(project, temp, path, expected)
}
