// Rust: Source/CmdCodemod/Transaction.rs:2409
struct Journal { records: [Record]; log_path: OSPath; log: [UInt8] }
// Rust: Source/CmdCodemod/Transaction.rs:2414
fn parse_journal(raw: String) -> Journal {
    root :: jet_cli_codemod_json_parse(raw).and_then(value -> jet_cli_codemod_json_object_fields(value))
        .unwrap_or_else(error -> fail("invalid recovery journal: {error.message}"))
    files :: if jet_cli_codemod_json_field(root, "files") == {
        Val(JetCLICodemodJSONValue.Array(values)) -> values
        _ -> fail("invalid recovery journal files")
    }
    string :: key -> if jet_cli_codemod_json_field(root, key) == {
        Val(JetCLICodemodJSONValue.String(value)) -> value.clone()
        _ -> fail("recovery journal missing `{key}`")
    }
    records :: files.iter().map(value -> {
        object :: if value == { JetCLICodemodJSONValue.Object(fields) -> fields; _ -> fail("invalid recovery journal record") }
        s :: key -> if jet_cli_codemod_json_field(object, key) == {
            Val(JetCLICodemodJSONValue.String(text)) -> text.clone()
            _ -> fail("recovery journal missing `{key}`")
        }
        identity :: key -> if jet_cli_codemod_json_field(object, key) == {
            Val(JetCLICodemodJSONValue.Array(values)) if values.len() == 2 -> {
                number :: value -> if value == { JetCLICodemodJSONValue.Number(number) -> number; _ -> fail("recovery journal `{key}` identity is invalid") }
                (number(values[0]), number(values[1]))
            }
            _ -> fail("recovery journal missing `{key}` identity")
        }
        // GATE #4483: Unix-only handles carrier is retained in canonical Record.
        Record { path: OSPath.from(s("path")), temp: OSPath.from(s("temp")), before: unhex(s("before")), after: unhex(s("after")),
            destination_id: identity("destination_id"), temp_id: identity("temp_id"), handles: None }
    }).collect()
    Journal { records: ^records, log_path: OSPath.from(string("log_path")), log: unhex(string("log")) }
}
// Rust: Source/CmdCodemod/Transaction.rs:2466
fn write_new_sync(path: &OSPath, bytes: &[UInt8]) -> Void {
    // GATE #4494: non-Unix exclusive create and file fsync.
    file := OpenOptions.new().write(true).create_new(true).open(path).unwrap_or_else(e -> fail("could not write `{path.display()}`: {e}"))
    file.write_all(bytes).unwrap_or_else(e -> fail("could not write `{path.display()}`: {e}"))
    file.sync_all().unwrap_or_else(e -> fail("could not sync `{path.display()}`: {e}"))
}
