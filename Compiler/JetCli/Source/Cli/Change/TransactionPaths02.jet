    name :: CString.new(file_name.as_bytes()).map_err(_ -> std.io.Error.new(std.io.ErrorKind.InvalidInput, "NUL in codemod file name"))?
    // Rust constants :2488-2492 and FFI openat :2494; GATE #4494: retained native descriptor owns close.
    O_WRONLY :: 1
    O_CREAT :: 0o100
    O_EXCL :: 0o200
    O_CLOEXEC :: 0o2000000
    O_NOFOLLOW :: 0o400000
    fd :: #Unsafe("native openat with a live parent descriptor and NUL-terminated name") {
        openat(dir.as_raw_fd(), name.as_ptr(), O_WRONLY | O_CREAT | O_EXCL | O_NOFOLLOW | O_CLOEXEC, 0o600)
    }
    if fd < 0 { return Err(std.io.Error.last_os_error()) }
    file := #Unsafe("take unique ownership of the newly created fd") { File.from_raw_fd(fd) }
    file.write_all(bytes)?
    file.sync_all()?
    metadata :: file.metadata()?
    if !metadata.is_file() || metadata.nlink() != 1 { return Err(std.io.Error.new(std.io.ErrorKind.PermissionDenied, "created codemod file is linked or not regular")) }
    dir.sync_all()?
    Ok((metadata.dev(), metadata.ino()))
}
