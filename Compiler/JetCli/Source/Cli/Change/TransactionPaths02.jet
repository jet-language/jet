        GetFileInformationByHandleEx(owned.as_raw_handle(), FILE_ATTRIBUTE_TAG_INFO_CLASS, (&tag as *FileAttributeTagInfo).cast(), std.mem.size_of::<FileAttributeTagInfo>() as UInt32)
