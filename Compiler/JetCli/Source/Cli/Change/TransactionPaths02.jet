fn write_new_at(dir: &File, file_name: &OSPath, bytes: &[UInt8]) -> (UInt64, UInt64) std.io.Error! {
    // GATE #4483: cfg(unix)/cfg(not(unix)); #4409 preserves Unsupported/InvalidInput/PermissionDenied.
