    if fd < 0 { fail("could not create journal generation: {std.io.Error.last_os_error()}") }
    staged := #Unsafe("own successful journal stage create") { File.from_raw_fd(fd) }
    staged.write_all(bytes).unwrap_or_else(e -> fail("could not write journal generation: {e}"))
    staged.sync_all().unwrap_or_else(e -> fail("could not sync journal generation: {e}"))
    staged_meta :: staged.metadata().unwrap_or_else(e -> fail("could not identify journal generation: {e}"))
    if !staged_meta.is_file() || staged_meta.nlink() != 1 { fail("journal generation is linked or not regular") }
    staged_id :: (staged_meta.dev(), staged_meta.ino())
    if expected == {
        Val(expected) -> {
            current :: open(lock._file, journal_name).unwrap_or_else(e -> fail("could not reopen current journal: {e}"))
            metadata :: current.metadata().unwrap_or_else(e -> fail("could not identify current journal: {e}"))
            if (metadata.dev(), metadata.ino()) != expected || metadata.nlink() != 1 { fail("recovery journal identity changed before generation publish") }
            if #Unsafe("publish generation relative to retained lock directory") { renameat(lock._file.as_raw_fd(), staged_name.as_ptr(), lock._file.as_raw_fd(), journal_name.as_ptr()) } != 0 {
                fail("could not publish recovery journal generation: {std.io.Error.last_os_error()}")
            }
        }
        None -> {
            if #Unsafe("exclusive first journal publication by hard link") { linkat(lock._file.as_raw_fd(), staged_name.as_ptr(), lock._file.as_raw_fd(), journal_name.as_ptr(), 0) } != 0 {
                fail("could not publish first recovery journal: {std.io.Error.last_os_error()}")
            }
            if #Unsafe("remove linked stage name") { unlinkat(lock._file.as_raw_fd(), staged_name.as_ptr(), 0) } != 0 {
                fail("could not remove linked journal stage: {std.io.Error.last_os_error()}")
            }
        }
    }
    published :: open(lock._file, journal_name).unwrap_or_else(e -> fail("could not reopen published journal: {e}"))
    metadata :: published.metadata().unwrap_or_else(e -> fail("could not identify published journal: {e}"))
    if (metadata.dev(), metadata.ino()) != staged_id || metadata.nlink() != 1 { fail("published recovery journal identity does not match staged generation") }
    lock._file.sync_all().unwrap_or_else(e -> fail("could not sync codemod directory: {e}"))
