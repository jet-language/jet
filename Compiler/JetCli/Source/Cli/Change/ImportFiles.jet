// Source/CmdImport.rs file translation leaves. Input paths are display text;
// no foreign execution, filesystem access, publication, or evidence fabrication.
// Rust `Translation` (408-414).
pub struct JetCLIImportTranslation {
    pub source: String
    pub todos: [JetCLIImportTodo]
    pub functions: Int
    pub tests: Int
}
// Rust rendered enterprise row (608). Named row avoids tuple JetShow #4357.
struct JetCLIImportRenderedFunction { pub carried_test: Bool, pub text: String }

// Rust `gap` (3376-3392).
pub fn jet_cli_import_gap(what: String, why: String, fix: String, source: String, target: String, line: Int) -> JetCLIImportTodo Never! {
    JetCLIImportTodo{what: what, why: why, fix: fix, source: "{source}:{line}", target: target, status: "omitted-reported"}
}
fn jet_cli_import_files_append(output: &[U8], text: String) Never! {
    loop byte in text.bytes() -> &output.push(byte)
}

// Rust `translate_file` (422-518): Python annotated functions only.
pub fn jet_cli_import_translate_file(raw: String, source: String, target: String) -> JetCLIImportTranslation Never! {
    lines :: raw.lines()
    rendered := [String]{}
    todos := [JetCLIImportTodo]{}
    functions := 0
    tests := 0
    at := 0
    loop at < lines.len() {
        line :: lines[at]
        trimmed :: ~line.trim()
        if trimmed.is_empty() || trimmed.starts_with("#") {
            at += 1
            next
        }
        if jet_cli_import_indentation(line) != 0 || !trimmed.starts_with("def ") {
            &todos.push(jet_cli_import_gap("unsupported Python top-level construct '{jet_cli_import_shorten(trimmed)}'", "first Python importer translates annotated functions only", "port construct into ordinary Jet; no source was silently emitted", source, target, at + 1))
            at += 1
            next
        }
        header_line :: at + 1
        at += 1
        body := [JetCLIImportBodyLine]{}
        loop at < lines.len() {
            if !lines[at].trim().is_empty() && jet_cli_import_indentation(lines[at]) == 0 -> break
            if !lines[at].trim().is_empty() -> &body.push(JetCLIImportBodyLine{line: at + 1, text: ~lines[at]})
            at += 1
        }
        if jet_cli_import_parse_header(trimmed) == {
            .Err(error) -> &todos.push(jet_cli_import_gap("Python function signature at line {header_line} is not type-safe", error.message, "add supported parameter and return annotations, then rerun import", source, target, header_line))
            .Ok(function_header) -> {
                function := function_header
                function.body = body
                if jet_cli_import_translate_body(function) == {
                    .Ok(converted) -> {
                        marker := ""
                        if function.name.starts_with("test_") && function.params.is_empty() {
                            tests += 1
                            marker = "#Test "
                        }
                        &rendered.push(jet_cli_import_render_function(marker, function, converted))
                        functions += 1
                    }
                    .Err(error) -> &todos.push(jet_cli_import_gap("Python body '{function.name}' was not translated", error.message, "port body into ordinary Jet; source remains in omissions report", source, target, error.line))
                }
            }
        }
    }
    output := [U8]{}
    jet_cli_import_files_append(&output, jet_cli_import_header("py"))
    loop index in 0..<rendered.len() {
        if index > 0 -> &output.push(U8{10})
        jet_cli_import_files_append(&output, rendered[index])
    }
    if functions == 0 -> jet_cli_import_files_append(&output, "// No construct was safe to translate. See import-report.json.\n")
    JetCLIImportTranslation{source: String.from_bytes(output) ?? panic("Python translation UTF-8"), todos: todos, functions: functions, tests: tests}
}

// Rust `translate_pascal_file` (520-555).
pub fn jet_cli_import_translate_pascal_file(raw: String, source: String, target: String) -> JetCLIImportTranslation Never! {
    output := [U8]{}
    jet_cli_import_files_append(&output, jet_cli_import_binder_header("pascal"))
    jet_cli_import_files_append(&output, "// Source: {source}\n")
    todo :: if jet_cli_import_pascal_library_name(raw) == .Val(library) -> {
        jet_cli_import_files_append(&output, "use pascal.{library} as {library}\n\n// Binder stub: use pascal.{library} as {library}\n// TODO JT0101: Pascal library `{library}` remains an FFI source.\n")
        jet_cli_import_gap("Pascal library `{library}` was not translated", "Object Pascal bodies, classes, and runtime ownership have no proven source-to-Jet mapping; the original source remains authoritative", "run `jet inspect bind pascal {source} --pkg {library}` for call-in-place bindings, then port unsupported bodies explicitly", source, target, 1)
    } else -> {
        jet_cli_import_files_append(&output, "// TODO JT0101: Pascal source has no recognizable library declaration.\n")
        jet_cli_import_gap("Pascal source has no recognizable library declaration", "the importer cannot establish a library boundary or ABI contract", "add a Pascal `library` declaration or use a hand-written Jet FFI overlay; no source was silently emitted", source, target, 1)
    }
    jet_cli_import_files_append(&output, "// The Pascal source remains the canonical source of truth.\n")
    JetCLIImportTranslation{source: String.from_bytes(output) ?? panic("Pascal preparation UTF-8"), todos: [todo], functions: 0, tests: 0}
}

// Rust `translate_ada_file` (557-590).
pub fn jet_cli_import_translate_ada_file(raw: String, source: String, target: String) -> JetCLIImportTranslation Never! {
    output := [U8]{}
    jet_cli_import_files_append(&output, jet_cli_import_binder_header("ada"))
    jet_cli_import_files_append(&output, "// Source: {source}\n")
    todo :: if jet_cli_import_ada_package_name(raw) == .Val(package) -> {
        jet_cli_import_files_append(&output, "use ada.{package} as {package}\n\n// Binder stub: use ada.{package} as {package}\n// TODO JT0101: Ada package `{package}` remains an FFI source.\n")
        jet_cli_import_gap("Ada package `{package}` was not translated", "Ada bodies, range checks, exceptions, tasking, and representation clauses have no proven source-to-Jet mapping; the original package spec and body remain authoritative", "run `jet inspect bind ada {source} --pkg {package}` for call-in-place bindings, then port unsupported bodies explicitly", source, target, 1)
    } else -> {
        jet_cli_import_files_append(&output, "// TODO JT0101: Ada source has no recognizable package declaration.\n")
        jet_cli_import_gap("Ada source has no recognizable package declaration", "the importer cannot establish a library boundary or ABI contract", "add a top-level Ada `package` declaration or use a hand-written Jet FFI overlay; no source was silently emitted", source, target, 1)
    }
    jet_cli_import_files_append(&output, "// The Ada source remains the canonical source of truth.\n")
    JetCLIImportTranslation{source: String.from_bytes(output) ?? panic("Ada preparation UTF-8"), todos: [todo], functions: 0, tests: 0}
}

// Rust `translate_enterprise_file` (595-830): Java/C#/TS/JS/Go scalar orchestration.
pub fn jet_cli_import_translate_enterprise_file(language: String, raw: String, source: String, target: String) -> JetCLIImportTranslation Never! {
    output := [U8]{}
    jet_cli_import_files_append(&output, jet_cli_import_header(language))
    jet_cli_import_files_append(&output, "// Source: {source}\n// Provenance: law=D-MIGRATE-SRC1; generated spans remain tied to the source file.\n")
    lines :: raw.lines()
    rendered := [JetCLIImportRenderedFunction?]{}
    todos := [JetCLIImportTodo]{}
    // #4366: membership map instead of the defective Set.add Bool result.
    names := [String:Bool]{}
    rendered_by_name := [String:Int]{}
    functions := 0
    tests := 0
    float_literals :: language == "ts"
    at := 0
    loop at < lines.len() {
        trimmed :: ~lines[at].trim()
        if trimmed.is_empty() || jet_cli_import_foreign_comment_line(trimmed) {
            at += 1
            next
        }
        if jet_cli_import_foreign_ignored_line(language, trimmed) {
            at += 1
            next
        }
        if jet_cli_import_foreign_import_line(language, trimmed) {
            if !jet_cli_import_foreign_supported_import(language, trimmed) -> &todos.push(jet_cli_import_gap("unsupported {language} dependency declaration", "the importer does not execute or infer foreign dependency behavior", "bind the dependency with `jet inspect bind {language}` or port it explicitly before rerunning import", source, target, at + 1))
            at += 1
            next
        }
        signature := ~trimmed
        open_line := at
        candidate :: jet_cli_import_foreign_function_candidate(language, trimmed)
        if candidate && !jet_cli_import_has_unquoted_char(trimmed, "{{") && at + 1 < lines.len() && lines[at + 1].trim() == "{{" && (!trimmed.contains("=>") || trimmed.trim_end().ends_with("=>")) {
            signature = "{signature} {{"
            open_line += 1
        }
        if candidate {
            if jet_cli_import_parse_foreign_header(language, signature) == {
                .Ok(parsed_header) -> {
                    header := parsed_header
                    is_expression_body :: header.expression_body != None
                    body := [JetCLIImportBodyLine]{}
                    end_line := at
                    if header.expression_body == .Val(expression) -> &body.push(JetCLIImportBodyLine{line: at + 1, text: ~expression})
                    else {
                        if jet_cli_import_collect_foreign_body(lines, open_line) == {
                            .Ok(collected) -> {
                                body = collected.body
                                end_line = collected.end
                            }
                            .Err(error) -> {
                                &todos.push(jet_cli_import_gap("malformed {language} function at line {at + 1}", error.message, "repair the source function and rerun import; the original source was preserved", source, target, at + 1))
                                at += 1
                                next
                            }
                        }
                    }
                    header.function.body = body
                    if language == "js" {
                        docs :: jet_cli_import_javascript_doc_types(lines, at)
                        if jet_cli_import_infer_javascript_types(&header.function, docs) == .Err(error) {
                            &todos.push(jet_cli_import_gap("JavaScript function `{header.function.name}` was not translated", error.message, "add a supported scalar JSDoc type or port the function explicitly", source, target, at + 1))
                            at = end_line + 1
                            next
                        }
                    }
                    function_name :: header.function.name
                    canonical_name :: jet_cli_import_canonical_identifier(function_name)
                    if names.has_key(canonical_name) {
                        if &rendered_by_name.remove(canonical_name) == .Val(index) {
                            if rendered[index] == .Val(prior) {
                                functions -= 1
                                if prior.carried_test -> tests -= 1
                            }
                            rendered[index] = None
                        }
                        &todos.push(jet_cli_import_gap("ambiguous overloaded {language} function `{function_name}`", "multiple source functions would share one Jet name and call shape", "rename or manually port the overloads behind one explicit Jet API", source, target, at + 1))
                        at = end_line + 1
                        next
                    }
                    names[~canonical_name] = true
                    float_context := header.function.result == "Float"
                    loop param in header.function.params { if param.ty == "Float" -> float_context = true }
                    if jet_cli_import_translate_foreign_body(language, header.function, float_literals || float_context, is_expression_body) == {
                        .Ok(converted) -> {
                            carried_test :: header.function.name.starts_with("test_") && header.function.params.is_empty()
                            marker := ""
                            if carried_test {
                                tests += 1
                                marker = "#Test "
                            }
                            rendered_by_name[~canonical_name] = rendered.len()
                            text :: "// Source span: {source}:{at + 1}-{end_line + 1}\n{jet_cli_import_render_function(marker, header.function, converted)}"
                            &rendered.push(Val(JetCLIImportRenderedFunction{carried_test: carried_test, text: text}))
                            functions += 1
                        }
                        .Err(error) -> &todos.push(jet_cli_import_gap("{language} body `{header.function.name}` was not translated", error.message, "port the body into ordinary Jet; the original source remains authoritative", source, target, error.line))
                    }
                    at = end_line + 1
                    next
                }
                .Err(error) -> {
                    end_line := at
                    if jet_cli_import_has_unquoted_char(signature, "{{") {
                        if jet_cli_import_collect_foreign_body(lines, open_line) == .Ok(collected) -> end_line = collected.end
                    }
                    &todos.push(jet_cli_import_gap("unsupported {language} function declaration", error.message, "use the supported scalar function subset or port the declaration explicitly", source, target, at + 1))
                    at = end_line + 1
                    next
                }
            }
        }
        if jet_cli_import_foreign_structural_line(trimmed) {
            at += 1
            next
        }
        &todos.push(jet_cli_import_gap("unsupported {language} top-level construct `{jet_cli_import_shorten(trimmed)}`", "the importer only emits proven scalar functions and does not model foreign runtime state", "port the construct into ordinary Jet or keep it behind the language binder", source, target, at + 1))
        at += 1
    }
    if functions == 0 {
        if jet_cli_import_enterprise_unit_name(language, raw, source) == .Val(unit) {
            root :: jet_cli_import_foreign_binder_root(language)
            jet_cli_import_files_append(&output, "use {root}.{unit} as {unit}\n\n// Binder fallback: use {root}.{unit} as {unit}\n")
        }
        jet_cli_import_files_append(&output, "// No construct was safe to translate. See import-report.json.\n")
    }
    first := true
    loop row in rendered {
        if row == .Val(item) {
            if first {
                &output.push(U8{10})
                first = false
            }
            jet_cli_import_files_append(&output, item.text)
        }
    }
    jet_cli_import_files_append(&output, "\n// The {language} source remains the canonical source of truth until every TODO is resolved.\n")
    JetCLIImportTranslation{source: String.from_bytes(output) ?? panic("enterprise translation UTF-8"), todos: todos, functions: functions, tests: tests}
}
