// Specialized backend registration recognition; not the full-language lexer.
// All token positions are UTF-8 byte offsets, as in Source/CmdBackendScaffold.rs.
pub struct JetCLIBackendSyntaxToken {
    pub text: String
    pub start: Int
    pub end: Int
}

#Error
pub struct JetCLIBackendRegistrationError { pub message: String }

// Rust `syntax_tokens` (CmdBackendScaffold.rs:715-786).
pub fn jet_cli_backend_syntax_tokens(source: String) -> [JetCLIBackendSyntaxToken] Never! {
    bytes :: source.bytes()
    tokens := [JetCLIBackendSyntaxToken]{}
    index := 0
    loop index < bytes.len() {
        byte :: Int.from_u8(bytes[index])
        // Rust u8::is_ascii_whitespace excludes vertical tab (0x0B).
        if byte == 32 || byte == 9 || byte == 10 || byte == 12 || byte == 13 {
            index += 1
            next
        }
        if byte == 47 && index + 1 < bytes.len() && bytes[index + 1] == (U8{47}) {
            index += 2
            loop index < bytes.len() && bytes[index] != (U8{10}) { index += 1 }
            next
        }
        if byte == 47 && index + 1 < bytes.len() && bytes[index + 1] == (U8{42}) {
            index += 2
            // Deliberately nonnested: the first closing delimiter wins.
            loop index + 1 < bytes.len() && !(bytes[index] == (U8{42}) && bytes[index + 1] == (U8{47})) { index += 1 }
            index = if index + 2 < bytes.len() -> index + 2 else -> bytes.len()
            next
        }
        start :: index
        if byte == 34 || byte == 39 {
            quote :: bytes[index]
            index += 1
            loop index < bytes.len() {
                if bytes[index] == (U8{92}) {
                    index = if index + 2 < bytes.len() -> index + 2 else -> bytes.len()
                } else {
                    if bytes[index] == quote {
                        index += 1
                        break
                    } else {
                        index += 1
                    }
                }
            }
            &tokens.push(JetCLIBackendSyntaxToken{text: String.from_bytes_lossy(bytes[start..<index]), start: start, end: index})
            next
        }
        if (byte >= 65 && byte <= 90) || (byte >= 97 && byte <= 122) || (byte >= 48 && byte <= 57) || byte == 95 {
            index += 1
            loop index < bytes.len() {
                code :: Int.from_u8(bytes[index])
                if !((code >= 65 && code <= 90) || (code >= 97 && code <= 122) || (code >= 48 && code <= 57) || code == 95) -> break
                index += 1
            }
            &tokens.push(JetCLIBackendSyntaxToken{text: String.from_bytes_lossy(bytes[start..<index]), start: start, end: index})
            next
        }
        index += 1
        // Each non-ASCII punctuation byte is decoded separately, retaining the
        // Rust lossy replacement behavior rather than advancing by a scalar.
        &tokens.push(JetCLIBackendSyntaxToken{text: String.from_bytes_lossy(bytes[start..<index]), start: start, end: index})
    }
    tokens
}

// Rust `has_routes_registration` (CmdBackendScaffold.rs:788-812).
pub fn jet_cli_backend_has_routes_registration(source: String) -> Bool Never! {
    tokens :: jet_cli_backend_syntax_tokens(source)
    loop index in 0..<tokens.len() {
        if tokens[index].text != "." || index + 2 >= tokens.len() -> next
        if tokens[index + 1].text != "routes" || tokens[index + 2].text != "(" -> next
        if index + 3 < tokens.len() && (tokens[index + 3].text == "\"routes\"" || tokens[index + 3].text == "'routes'") -> return true
        if index + 5 < tokens.len() && tokens[index + 3].text == "from" && tokens[index + 4].text == ":" && (tokens[index + 5].text == "\"routes\"" || tokens[index + 5].text == "'routes'") -> return true
    }
    false
}

// Rust `app_constructor_end` (CmdBackendScaffold.rs:814-845).
pub fn jet_cli_backend_app_constructor_end(source: String) -> Int JetCLIBackendRegistrationError! {
    tokens :: jet_cli_backend_syntax_tokens(source)
    candidate := Int?{None}
    count := 0
    loop index in 0..<tokens.len() {
        if tokens[index].text != "app" || index + 2 >= tokens.len() -> next
        if tokens[index + 1].text != "(" || tokens[index + 2].text != ")" -> next
        web_qualified :: index >= 2 && tokens[index - 1].text == "." && tokens[index - 2].text == "web" && (index < 3 || tokens[index - 3].text != ".")
        // Rust does not check the token preceding `core` here: retain that policy.
        core_qualified :: index >= 4 && tokens[index - 1].text == "." && tokens[index - 2].text == "web" && tokens[index - 3].text == "." && tokens[index - 4].text == "core"
        bare :: index == 0 || (tokens[index - 1].text != "." && tokens[index - 1].text != "fn")
        if web_qualified || core_qualified || bare {
            // Every close-token offset is unique. Counting avoids Rust's redundant
            // quadratic ends.contains scan without changing any observable result.
            candidate = Val(tokens[index + 2].end)
            count += 1
        }
    }
    if count == 0 -> return Err(JetCLIBackendRegistrationError{message: "the checked run function has no canonical App builder"})
    if count > 1 -> return Err(JetCLIBackendRegistrationError{message: "the checked run function has multiple App builders"})
    Ok(candidate ?? panic("one App candidate must have a byte end"))
}
