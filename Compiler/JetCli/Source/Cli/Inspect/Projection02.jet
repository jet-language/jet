// Rust: Source/CmdInspect.rs:464
// Libraries have no program entry and must not demand `fn run`.
fn package_is_library_only(entry: &OSPath) -> Bool {
    facts :: Loader.package_facts_for_entry(entry).ok().flatten() ?? return false
    if !facts.outputs.is_empty() -> return facts.outputs.values().all(output -> output.kind == Package.PackageOutputKind.Library)
    folder :: entry.parent().filter(parent -> !parent.as_os_str().is_empty()).unwrap_or_else(() -> OSPath.new("."))
    root :: Loader.find_manifest_root(folder) ?? return false
    Loader.package_run_member(&root).is_none()
}

// Rust: Source/CmdInspect.rs:484
pub fn missing_project_context_diagnostic(path: &OSPath) -> Diagnostic? {
    parent :: path.parent().filter(parent -> !parent.as_os_str().is_empty()).unwrap_or_else(() -> OSPath.new("."))
    if Loader.find_package_root_checked(parent).ok().flatten().is_some()
        || Loader.package_facts_for_entry(path).ok().flatten().is_some()
        || Loader.find_workspace_root_checked(parent).ok().flatten().is_some() -> return None
    source :: fs.read_to_string(path).ok() ?? return None
    source_for_parse :: Package.mask_inline_package_source(&source).ok()?.0
    (tokens, lex_diagnostics) :: Lexer.lex(&source_for_parse)
    if !lex_diagnostics.is_empty() -> return None
    parsed_span :: Parser.parse_with_source(&tokens, &source_for_parse).ok().and_then(program -> {
        program.imports.iter().find_map(import -> {
            if import.kind == {
                .Module(name, span) if name.starts_with(Syntax.PROJECT_IMPORT_PREFIX) -> Some(span)
                .Unqualified{module_alias, span, ..} if module_alias.starts_with(Syntax.PROJECT_IMPORT_PREFIX) -> Some(span)
                _ -> None
            }
        })
    })
    lexical_span :: tokens.windows(4).find_map(window -> {
        if (window[0].kind, window[1].kind, window[2].kind, window[3].kind) == {
            (.KwUse, .Ident(project), .Dot, .Ident(_)) if project == Syntax.PROJECT_IMPORT_ROOT ->
                Some(Span.new(window[1].span.start, window[3].span.end))
            _ -> None
        }
    })
    span :: parsed_span.or(lexical_span) ?? return None
    Some(Diagnostic.from_row("E2393", [("import", "use project.<module>")], Some(span)))
}

// Rust: Source/CmdInspect.rs:557
fn explicit_file_proof_rows() -> [CheckProofRow] {
    [
        ("entry resolution", "explicit-file checks resolve only the named source file", "E2389"),
        ("module graph", "explicit-file checks keep semantic scope and do not promise a project graph", "E2390"),
        ("Core closure", "explicit-file checks keep semantic scope and do not promise project Core closure", "E2391"),
        ("tier lowering", "explicit-file checks keep semantic scope and do not promise project tier lowering", "E2392")
    ].into_iter().map((name, detail, diagnostic) -> CheckProofRow{
        output: "not-applicable", name: name.to_string(), status: "not applicable",
        detail: detail.to_string(), diagnostic: diagnostic.to_string()
    }).collect()
}

// Rust: Source/CmdInspect.rs:591
fn is_project_runnable_output(kind: AST.OutputKind) -> Bool {
    if kind == { .Executable | .Service -> true, _ -> false }
}

// Rust: Source/CmdInspect.rs:598
fn normalize_output_path(path: &OSPath) -> OSPath {
    fs.canonicalize(path).unwrap_or_else(_ -> path.to_path_buf())
}

// Rust: Source/CmdInspect.rs:602
fn source_line(source: String, offset: UInt) -> UInt {
    end :: offset.min(source.len())
    1 + source.get(..end).unwrap_or_default().bytes().filter(byte -> byte == 10).count()
}

// Rust: Source/CmdInspect.rs:612
fn project_output_specs(bundle: &AST.ProgramBundle, package_facts: Package.PackageFacts?) -> ([ProjectOutputSpec], [Diagnostic]) {
    specs: [String:ProjectOutputSpec] = [:]
    diagnostics := []
    if package_facts == .Some(package_facts) -> {
        addresses :: package_facts.outputs.keys().sorted()
        loop address in addresses {
            output :: package_facts.outputs[address]
            if !output.kind.is_runnable() -> next
            path :: if package_facts.entry_path(&bundle.project_root, output) == {
                .Ok(path) -> path.map(path -> normalize_output_path(&path))
                .Err(error) -> {
                    diagnostics.push(Diagnostic.from_row("E2389", [("detail", "output `{address}` entry resolution failed: {error}")], None))
                    None
                }
            }
            specs.insert(address.clone(), ProjectOutputSpec{address: address.clone(), name: output.name.clone(), path: path})
        }
    }
    loop module in &bundle.modules {
        loop item in &module.items {
            if item == {
                .Const(constant) -> {
                    output :: constant.resolved_output.as_ref().filter(output -> is_project_runnable_output(output.kind)) ?? next
                    module_path :: normalize_output_path(&module.path)
                    specs.entry(output.address.clone()).and_modify(spec -> {
                        if spec.path.is_none() -> spec.path = Some(module_path.clone())
                        if spec.name.is_empty() -> spec.name = output.output_name.clone()
                    }).or_insert_with(() -> ProjectOutputSpec{
                        address: output.address.clone(), name: output.output_name.clone(), path: Some(module_path.clone())
                    })
                }
                _ -> {}
            }
        }
    }
    if specs.is_empty() -> {
        entry_module :: bundle.modules.get(bundle.entry)
        entry_path :: entry_module.map(module -> normalize_output_path(&module.path))
        has_run :: entry_module.is_some_and(module -> module.items.iter().any(item -> {
            if item == { .Func(function) if function.name == "run" -> true, _ -> false }
        }))
        address :: if has_run -> "run" else -> "default"
        specs.insert(address, ProjectOutputSpec{address: address, name: "run", path: entry_path})
    }
    keys :: specs.keys().sorted()
    (keys.map(key -> specs.remove(key).unwrap()), diagnostics)
}

// Rust: Source/CmdInspect.rs:713
struct ProjectBundleProof {
    module_status: String
    module_detail: String
    core_status: String
    core_detail: String
    tier_status: String
    tier_detail: String
    mir_digest: String
}

impl ProjectBundleProof {
    // Rust: Source/CmdInspect.rs:725
    fn from_bundle(bundle: &AST.ProgramBundle, _facts: &Sema.SemIndexEffectFacts, target: String?, profile: String, library: Bool) -> ProjectBundleProof {
        import_edges :: bundle.modules.iter().map(module -> module.imports.len()).sum<UInt>()
        module_status :: if !bundle.modules.is_empty() -> "proven" else -> "compiler defect"
        module_detail :: "{bundle.modules.len()} loaded module(s), {import_edges} resolved import edge(s); project root {bundle.project_root.display()}"
        sealed :: Sema.sealed_package_count()
        if sealed > 0 -> {
            detail :: "{sealed} dependency package(s) reused from check records; the whole-program MIR proof runs when every package is checked"
            return ProjectBundleProof{module_status: module_status, module_detail: module_detail,
                core_status: "reused", core_detail: detail.clone(), tier_status: "reused", tier_detail: detail, mir_digest: "reused"}
        }
        core :: Codegen.core_closure_proof(bundle, false)
        used_core :: if core.used_calls.is_empty() -> "none" else -> core.used_calls.join(",")
        synthesized_core :: if core.synthesized_calls.is_empty() -> "none" else -> core.synthesized_calls.join(",")
        core_detail :: "used=[{used_core}] synthesized=[{synthesized_core}] routes=[{core.adapter_routes.join(",")}] fingerprint={core.fingerprint}"
        artifact_target :: if target == Some(Syntax.BUILD_TARGET_WEB) -> MIR.MirArtifactTarget.Web else -> MIR.MirArtifactTarget.Cranelift
        artifact_kind :: if artifact_target == MIR.MirArtifactTarget.Web -> MIR.MirArtifactKind.WebApplication
            else if library -> MIR.MirArtifactKind.NativeLibrary else -> MIR.MirArtifactKind.NativeExecutable
        (mir, artifact) :: lower_checked_semantic_mir_program_for(bundle,
            MIR.MirArtifactRequest.new(artifact_target, artifact_kind, MIR.MirArtifactBuildMode.Dev))
        mir_identity :: mir.artifact_identity(artifact).unwrap_or_else(error -> {
            jet_foundation.ice(None, "canonical MIR identity failed: {error}")
        }).program_identity
        mir_detail :: "mir-v1={mir_identity.canonical_json()}"
        (tier_status, tier_detail) := if target == Some(Syntax.BUILD_TARGET_WEB) -> {
            web_target :: Codegen.MIRWeb.MirWebTarget{
                layout: if bundle.build_facts.target_triple.is_empty() -> Layout.TargetLayout.host()
                    else -> Layout.TargetLayout.from_triple(bundle.build_facts.target_triple.clone()),
                assets: Codegen.MIRWeb.MirWebAssets.with_default_shell(),
                semantic_digest: MIR.mir_program_digest(&mir), artifact: artifact,
                release_devtools_policy: Driver.release_devtools_policy_for_bundle(bundle, profile)
            }
            if Codegen.MIRWeb.emit_web(&mir, &web_target) == {
                .Ok(_) -> ("proven", "web=proven; checked MIR Web artifact")
                .Err(error) -> ("compiler defect", "web=compiler defect; {error}")
            }
        } else -> {
            detail_prefix :: target.map(target -> "target={target}; ").unwrap_or_default()
            jit_detail :: jet_jit.resident_jit_safe_program_detail(&mir)
            if jit_detail.is_empty() -> ("proven", "{detail_prefix}AOT=proven; JIT=proven; interpreter=shared checked MIR route")
            else -> ("compiler defect", "{detail_prefix}JIT=compiler defect; {jit_detail}")
        }
        tier_detail.push(' ')
        tier_detail.push_str(&mir_detail)
        ProjectBundleProof{module_status: module_status, module_detail: module_detail, core_status: "proven",
            core_detail: "{core_detail} {mir_detail}", tier_status: tier_status, tier_detail: tier_detail,
            mir_digest: mir_identity.identity_digest()}
    }
}

// Rust: Source/CmdInspect.rs:866
fn project_output_location(bundle: &AST.ProgramBundle, output: &AST.ResolvedOutput) -> String? {
    module :: bundle.modules.get(output.module) ?? return None
    Some("{module.display}:{source_line(module.source, output.definition.start)}")
}

// Rust: Source/CmdInspect.rs:878
fn legacy_entry_location(bundle: &AST.ProgramBundle) -> String? {
    module :: bundle.modules.get(bundle.entry) ?? return None
    function :: module.items.iter().find_map(item -> {
        if item == { .Func(function) if function.name == "run" -> Some(function), _ -> None }
    }) ?? return None
    Some("{module.display}:{source_line(module.source, function.span.start)}")
}

// Rust: Source/CmdInspect.rs:891
fn output_proof_rows(bundle: &AST.ProgramBundle, spec: &ProjectOutputSpec, entry_fn: String?,
    shared: &ProjectBundleProof, library: Bool, diagnostics: &[Diagnostic]) -> [CheckProofRow] {
    resolved :: bundle.modules.iter().flat_map(module -> &module.items).find_map(item -> {
        if item == {
            .Const(constant) -> constant.resolved_output.as_ref().filter(output ->
                output.address == spec.address && is_project_runnable_output(output.kind))
            _ -> None
        }
    })
    location :: resolved.and_then(output -> project_output_location(bundle, output)).or_else(() -> {
        if spec.address == "run" || spec.address == "default" -> legacy_entry_location(bundle) else -> None
    }).or_else(() -> {
        if library -> bundle.modules.get(bundle.entry).map(module -> "{module.display}:1") else -> None
    })
    output_name :: if spec.name.is_empty() -> spec.address else -> spec.name
    output_label :: "{spec.address} `{output_name}`"
    entry_detail :: if location == {
        .Some(location) -> {
            requested :: entry_fn.filter(name -> name != "run").map(name -> "; requested `{name}`").unwrap_or_default()
            "{output_label} resolved at {location}{requested}"
        }
        .None -> {
            path :: spec.path.map(path -> path.display().to_string()).unwrap_or_else(() -> "<unknown>")
            "{output_label} is absent from the checked module graph ({path}:1)"
        }
    }
    rows := []
    if location.is_none() -> {
        loop (name, diagnostic, detail) in [
            ("entry resolution", "E2389", entry_detail.clone()),
            ("module graph", "E2390", "{output_label} has no resolved source location"),
            ("Core closure", "E2391", "{output_label} has no resolved source location"),
            ("tier lowering", "E2392", "{output_label} has no resolved source location")
        ] {
            push_proof_row(&rows, diagnostics, spec.address, name, "compiler defect", detail, diagnostic)
        }
        return rows
    }
    location :: location.unwrap()
    push_proof_row(&rows, diagnostics, spec.address, "entry resolution", "proven", entry_detail, "E2389")
    push_proof_row(&rows, diagnostics, spec.address, "module graph", shared.module_status,
        "{shared.module_detail}; entry={location}; mir_identity_digest={shared.mir_digest}", "E2390")
    push_proof_row(&rows, diagnostics, spec.address, "Core closure", shared.core_status, "{shared.core_detail}; entry={location}", "E2391")
    push_proof_row(&rows, diagnostics, spec.address, "tier lowering", shared.tier_status, "{shared.tier_detail}; entry={location}", "E2392")
    rows
}

// Rust: Source/CmdInspect.rs:1026
fn failed_output_rows(spec: &ProjectOutputSpec, reason: String) -> ([CheckProofRow], [Diagnostic]) {
    location :: spec.path.map(path -> "{path.display()}:1").unwrap_or_else(() -> "<unknown>:1")
    detail :: "output `{spec.address}` could not be checked at {location}: {reason}"
    rows := []
    diagnostics := []
    loop (name, diagnostic) in [("entry resolution", "E2389"), ("module graph", "E2390"), ("Core closure", "E2391"), ("tier lowering", "E2392")] {
        push_proof_row(&rows, &diagnostics, spec.address, name, "compiler defect", detail.clone(), diagnostic)
    }
    (rows, diagnostics)
}

// Rust: Source/CmdInspect.rs:1060
fn project_proof_rows(bundle: &AST.ProgramBundle, facts: &Sema.SemIndexEffectFacts,
    package_facts: Package.PackageFacts?, entry_fn: String?, target: String?, profile: String,
    setting_overrides: &[String:String]) -> ([CheckProofRow], [Diagnostic]) {
    (specs, diagnostics) := project_output_specs(bundle, package_facts)
    rows := []
    loop spec in &specs {
        declared_output :: package_facts.is_some_and(facts -> facts.outputs.contains_key(&spec.address))
            || bundle.modules.iter().any(module -> module.items.iter().any(item -> {
                if item == {
                    .Const(constant) -> constant.resolved_output.as_ref().is_some_and(output -> output.address == spec.address)
                    _ -> false
                }
            }))
        checked_bundle_storage :: if declared_output -> {
            spec.path.and_then(path -> {
                path :: path.to_string_lossy().into_owned()
                (check_diagnostics, checked_bundle, checked_facts) :: Driver.check_file_with_effect_facts_for_output(
                    &path, &spec.address, profile, setting_overrides)
                diagnostics.extend(check_diagnostics)
                checked_bundle.map(bundle -> (bundle, checked_facts))
            })
        } else -> None
        checked :: if declared_output -> checked_bundle_storage.as_ref().map((bundle, facts) -> (bundle, facts))
            else -> Some((bundle, facts))
        if checked.is_none() -> {
            reason :: if spec.path.is_some() -> "the output entry check returned no bundle" else -> "the manifest entry could not be resolved"
            (failed, failed_diagnostics) :: failed_output_rows(spec, reason)
            rows.extend(failed)
            diagnostics.extend(failed_diagnostics)
            next
        }
        (checked_bundle, checked_facts) :: checked.unwrap()
        library :: spec.address == "default" || package_facts.and_then(facts -> facts.outputs.get(&spec.address))
            .is_some_and(output -> output.kind == Package.PackageOutputKind.Library)
        shared :: ProjectBundleProof.from_bundle(checked_bundle, checked_facts, target, profile, library)
        rows.extend(output_proof_rows(checked_bundle, spec, entry_fn, &shared, library, &diagnostics))
    }
    (rows, diagnostics)
}

// Rust: Source/CmdInspect.rs:1146
fn push_proof_row(rows: &[CheckProofRow], diagnostics: &[Diagnostic], output: String, name: String,
    status: String, detail: String, diagnostic: String) -> {
    row :: CheckProofRow{output: output.to_string(), name: name.to_string(), status: status.to_string(), detail: detail, diagnostic: diagnostic.to_string()}
    if row.status != "proven" && row.status != "not applicable" && row.status != "reused" -> {
        diagnostics.push(Diagnostic.from_row(row.diagnostic, [("detail", row.detail)], None))
    }
    rows.push(row)
}

// Rust: Source/CmdInspect.rs:1173
pub fn check_result_value(check: &CheckResult) -> StatusValue {
    rows :: StatusValue.array(check.proof_rows.iter().map(row -> StatusValue.object(StatusFields.new()
        .with("output", row.output).with("name", row.name).with("status", row.status)
        .with("detail", row.detail).with("diagnostic", row.diagnostic))))
    StatusValue.object(StatusFields.new().with("status", "passed").with("contract", CHECK_RESULT_CONTRACT)
        .with("schema_version", CHECK_RESULT_SCHEMA_VERSION).with("scope", scope_name(check.scope)).with("elapsed_ms", check.elapsed_ms)
        .with("provenance", StatusValue.object(StatusFields.new().with("source", check.source).with("profile", check.profile)
            .with("front_end", check.front_end).with("programmable_build", check.programmable_build).with("diagnostics", check.diagnostics)))
        .with("rows", rows))
}

// Rust: Source/CmdInspect.rs:1211
pub fn check_result_json(check: &CheckResult) -> String {
    rows :: check.proof_rows.iter().map(row ->
        "{{\"output\":\"{json_escape(row.output)}\",\"name\":\"{json_escape(row.name)}\",\"status\":\"{json_escape(row.status)}\",\"detail\":\"{json_escape(row.detail)}\",\"diagnostic\":\"{json_escape(row.diagnostic)}\"}}"
    ).collect<[String]>().join(",")
    "{{\"status\":\"passed\",\"contract\":\"{CHECK_RESULT_CONTRACT}\",\"schema_version\":{CHECK_RESULT_SCHEMA_VERSION},\"scope\":\"{scope_name(check.scope)}\",\"elapsed_ms\":{check.elapsed_ms},\"provenance\":{{\"source\":\"{json_escape(check.source)}\",\"profile\":\"{json_escape(check.profile)}\",\"front_end\":\"{json_escape(check.front_end)}\",\"programmable_build\":\"{json_escape(check.programmable_build)}\",\"diagnostics\":{check.diagnostics}}},\"rows\":[{rows}]}}"
}

// Rust: Source/CmdInspect.rs:1242
pub fn check_result_text(check: &CheckResult) -> String {
    text := "check: passed (source={check.source}, profile={check.profile}, scope={scope_name(check.scope)}, schema_version={CHECK_RESULT_SCHEMA_VERSION}, elapsed_ms={check.elapsed_ms}, front_end={check.front_end}, programmable_build={check.programmable_build}, diagnostics={check.diagnostics})\n"
    loop row in &check.proof_rows -> text.push_str("proof: output={row.output} {row.name} [{row.status}] {row.detail} (diagnostic={row.diagnostic})\n")
    text
}

// Rust: Source/CmdInspect.rs:1266
// Receipt replay records exclude elapsed time; replays report their own.
pub fn check_result_record(check: &CheckResult) -> String {
    rows :: check.proof_rows.iter().map(row ->
        "{{\"output\":\"{json_escape(row.output)}\",\"name\":\"{json_escape(row.name)}\",\"status\":\"{json_escape(row.status)}\",\"detail\":\"{json_escape(row.detail)}\",\"diagnostic\":\"{json_escape(row.diagnostic)}\"}}"
    ).collect<[String]>().join(",")
    "{{\"source\":\"{json_escape(check.source)}\",\"profile\":\"{json_escape(check.profile)}\",\"front_end\":\"{json_escape(check.front_end)}\",\"programmable_build\":\"{json_escape(check.programmable_build)}\",\"diagnostics\":{check.diagnostics},\"scope\":\"{scope_name(check.scope)}\",\"rows\":[{rows}]}}"
}

// Rust: Source/CmdInspect.rs:1294
pub fn check_result_from_record(record: String, elapsed_ms: U64) -> CheckResult? {
    value :: JSON.parse_json(record).ok() ?? return None
    object :: value.as_object().ok() ?? return None
    // Rust: Source/CmdInspect.rs:1297
    fn text(fields: &[(String, DataTree.DataTree)], name: String) -> String? {
        fields.iter().find((key, _) -> key == name).and_then((_, value) -> value.as_str().ok()).map(value -> value.to_string())
    }
    diagnostics :: object.iter().find((key, _) -> key == "diagnostics").and_then((_, value) -> {
        if value == { .Int(count) -> UInt.try_from(count).ok(), _ -> None }
    }) ?? return None
    scope :: if text(object, "scope")? == {
        "project" -> CheckScope.Project
        "explicit-file" -> CheckScope.ExplicitFile
        _ -> return None
    }
    proof_rows := []
    loop row in object.iter().find((key, _) -> key == "rows")?.1.as_array().ok()? {
        row :: row.as_object().ok() ?? return None
        proof_rows.push(CheckProofRow{output: text(row, "output")?, name: text(row, "name")?,
            status: text(row, "status")?, detail: text(row, "detail")?, diagnostic: text(row, "diagnostic")?})
    }
    Some(CheckResult{source: text(object, "source")?, profile: text(object, "profile")?,
        front_end: text(object, "front_end")?, programmable_build: text(object, "programmable_build")?,
        diagnostics: diagnostics, scope: scope, elapsed_ms: elapsed_ms, proof_rows: proof_rows})
}

// Rust: Source/CmdInspect.rs:1347
pub fn check_result_ran_programmable_build(check: &CheckResult) -> Bool {
    check.programmable_build != "not-selected"
}

// Rust: Source/CmdInspect.rs:1351
pub fn render_check_failure(path: &OSPath, diagnostics: &[Diagnostic], json: Bool, color: Bool) -> Never {
    entry :: path.display().to_string()
    source :: fs.read_to_string(path).unwrap_or_default()
    if json -> {
        machine_file :: jet_cli.machine_report_path_for_process(&entry)
        clears :: jet.Diagnostics.report_clear_counts(diagnostics)
        reports :: diagnostics.iter().zip(clears).map((diagnostic, clears) ->
            diagnostic.to_report_with_clears(&machine_file, &source, clears))
        rendered :: render_status_with_reports("inspect", false, reports, StatusFields.new())
        print("{rendered}\n")
    } else -> eprint("{jet.render_all_colored(&entry, &source, diagnostics, color)}")
    exit(ExitCodes.USER_ERROR) // GATE #4494 native process exit
}

// Rust: Source/CmdInspect.rs:1379
pub fn run_digest(args: &[String], json: Bool) -> {
    (topic, list_topics) :: parse_digest_args(args)
    if !list_topics && topic.is_none() -> {
        emit_digest(llm_digest(), json)
        return
    }
    slices :: digest_slices()
    if list_topics -> {
        if topic.is_some() -> {
            cli_error(@fix "E2104", "`--list-topics` cannot be combined with `--topic`",
                "use `jet inspect digest --list-topics` or `jet inspect digest --topic <name>`")
            exit(ExitCodes.USAGE)
        }
        if json -> {
            topics :: StatusValue.array(slices.iter().map(slice -> StatusValue.from(slice.topic)))
            payload :: render_status("inspect.digest", true,
                StatusFields.new().with("digest", StatusValue.object(StatusFields.new().with("topics", topics))))
            println("{payload}")
        } else -> {
            loop slice in &slices -> println("{slice.topic}")
        }
        return
    }
    digest :: if topic == {
        .Some(topic) -> {
            if slices.iter().find(slice -> slice.topic == topic) == {
                .Some(slice) -> slice.bytes.clone()
                .None -> {
                    closest :: slices.iter().min_by_key(slice -> (Syntax.edit_distance(&topic, &slice.topic), &slice.topic))
                        .map(slice -> slice.topic).unwrap_or("first-program")
                    cli_error(@fix "E2104", "unknown digest topic `{topic}`",
                        "use `--topic {closest}`, or list topics with `jet inspect digest --list-topics`")
                    exit(ExitCodes.USAGE)
                }
            }
        }
        .None -> llm_digest()
    }
    emit_digest(digest, json)
}

// Rust: Source/CmdInspect.rs:1450
pub fn run_output(args: &[String], json: Bool) -> {
    positionals :: args.iter().filter(arg -> !arg.starts_with('-')).collect<[String]>()
    file :: positionals.first().unwrap_or_else(() -> {
        cli_error(@fix "E2104", "`jet inspect output` needs an entry file",
            "run `jet inspect output Examples/features/tooling/output_callable.jet`")
        exit(ExitCodes.USAGE)
    })
    requested :: positionals.get(1)
    path :: OSPath.new(file)
    environment: [String:String] = [:]
    projection :: (if requested == {
        .Some(address) -> check_projection_for_output_effects(path, address, "dev", &environment)
        .None -> check_projection_for_run(path, "dev", &environment)
    }).unwrap_or_else(diagnostics -> render_check_failure(path, &diagnostics, json, false))
    selected :: projection.bundle.modules.iter().flat_map(module -> module.items.iter()).find_map(item -> {
        if item == {
            .Const(value) -> {
                output :: value.resolved_output.as_ref() ?? return None
                output.selected.then_some((value.name, output))
            }
            _ -> None
        }
    })
    (binding, output) :: selected.unwrap_or_else(() -> {
        cli_error(@fix "E2104", "the checked source has no selected Output",
            "declare one Executable Output or select one by address")
        exit(ExitCodes.USER_ERROR)
    })
    module :: projection.bundle.modules[output.module]
    callable_identity :: "{module.alias}::{output.semantic_name}"
    failure :: output.failure_contract()
    failure_contract :: failure.effective_type().name()
    failure_source :: failure.source()
    effects := output.effects.clone()
    effects.sort()
    required_effects :: effects.iter().cloned().collect<Sema.EffectSet>()
    manifest :: if Loader.package_facts_for_bundle(&projection.bundle) == {
        .Ok(manifest) -> manifest
        .Err(diagnostics) -> render_check_failure(path, &diagnostics, json, false)
    }
    authority :: jet.EffectBudget.project_application_effects(&required_effects, manifest.as_ref())
    if json -> {
        output_value :: StatusValue.object(StatusFields.new()
            .with("binding", binding).with("kind", output.kind.as_str()).with("name", output.output_name)
            .with("entry", output.source_name).with("source_path", output.source_path)
            .with("callable_identity", callable_identity).with("failure_contract", failure_contract.clone())
            .with("failure_source", failure_source.clone())
            .with("effects", StatusValue.array(effects.iter().map(effect -> StatusValue.from(effect))))
            .with("required_effects", StatusValue.array(effects.iter().map(effect -> StatusValue.from(effect))))
            .with("granted_effects", StatusValue.array(authority.granted_effects.iter().map(effect -> StatusValue.from(effect))))
            .with("denied_effects", StatusValue.array(authority.denied_effects.iter().map(effect -> StatusValue.from(effect))))
            .with("authority", authority.authority).with("selection_reason", output.selection_reason))
        payload :: render_status("inspect.output", true, StatusFields.new().with("output", output_value))
        println("{payload}")
    } else -> {
        println("selected: {output.kind.as_str()} \"{output.output_name}\"")
        println("entry: {output.source_name}")
        println("source path: {output.source_path}")
        println("callable identity: {callable_identity}")
        println("failure contract: {failure_contract} ({failure_source})")
        required :: if effects.is_empty() -> "none" else -> effects.join(", ")
        granted :: if authority.granted_effects.is_empty() -> "none"
            else -> authority.granted_effects.iter().cloned().collect<[String]>().join(", ")
        denied :: if authority.denied_effects.is_empty() -> "none"
            else -> authority.denied_effects.iter().cloned().collect<[String]>().join(", ")
        println("required effects: {required}")
        println("granted effects: {granted}")
        println("denied effects: {denied}")
        println("authority: {authority.authority}")
        println("selection reason: {output.selection_reason}")
    }
}

// Rust: Source/CmdInspect.rs:1616
// Projects typed environment reads without exposing their values.
pub fn run_env(args: &[String], json: Bool) -> {
    file :: entry_file(args).unwrap_or_else(() -> {
        if OSPath.new(Syntax.ENV_FILE).is_file() -> Syntax.ENV_FILE.to_string() else -> Syntax.CONFIG_FILE.to_string()
    })
    source :: if fs.read_to_string(&file) == {
        .Ok(source) -> source
        .Err(error) -> {
            cli_error(@fix "E2105", "can't read config surface `{file}`: {error}",
                "pass a readable `env.jet` or `config.jet` file")
            exit(ExitCodes.USER_ERROR)
        }
    }
    path :: OSPath.new(&file)
    base_dir :: path.parent().filter(parent -> !parent.as_os_str().is_empty()).unwrap_or_else(() -> OSPath.new("."))
    plan :: if jet_env_model.ModuleEval.evaluate_env(&source, base_dir) == {
        .Ok(plan) -> plan
        .Err(diagnostic) -> {
            if json -> {
                machine_file :: jet_cli.machine_report_path_for_process(&file)
                report :: diagnostic.to_report(&machine_file, &source)
                rendered :: render_status_with_reports("inspect.env", false, [report], StatusFields.new())
                print("{rendered}\n")
            } else -> eprint("{jet.render_diagnostics(&file, &source, [&diagnostic])}")
            exit(ExitCodes.USER_ERROR)
        }
    }
    if json -> {
        reads :: StatusValue.array(plan.environment_reads.iter().map(read ->
            StatusValue.object(StatusFields.new().with("name", read.name).with("type", read.ty))))
        payload :: render_status("inspect.env", true,
            StatusFields.new().with("env", StatusValue.object(StatusFields.new().with("file", file).with("reads", reads))))
        println("{payload}")
    } else -> {
        println("environment")
        println("file: {file}")
        if plan.environment_reads.is_empty() -> println("reads: none")
        else -> {
            println("reads:")
            loop read in &plan.environment_reads -> println("  {read.name}: {read.ty}")
        }
    }
}

// Rust: Source/CmdInspect.rs:1697
fn emit_digest(digest: String, json: Bool) -> {
    if json -> {
        payload :: render_status("inspect.digest", true,
            StatusFields.new().with("digest", StatusValue.object(StatusFields.new().with("value", digest))))
        println("{payload}")
    } else -> print("{digest}")
}

// Rust: Source/CmdInspect.rs:1713
struct DigestSlice { topic: String, bytes: String }

// Rust: Source/CmdInspect.rs:1718
fn parse_digest_args(args: &[String]) -> (String?, Bool) {
    topic := None
    list_topics := false
    index := 0
    loop index < args.len() {
        arg :: args[index]
        if arg == jet.CLI.MACHINE_OUTPUT_FLAG -> {
            index += 1
            next
        }
        if arg == "--list-topics" -> list_topics = true
        else if arg.strip_prefix("--topic=") == .Some(value) -> topic = Some(value.to_string())
        else if arg == "--topic" -> {
            value :: args.get(index + 1).filter(value -> !value.starts_with('-')).unwrap_or_else(() -> {
                cli_error(@fix "E2104", "`--topic` needs a value",
                    "write `--topic <name>`; use `--list-topics` to discover names")
                exit(ExitCodes.USAGE)
            })
            topic = Some(value.clone())
            index += 1
        }
        index += 1
    }
    (topic, list_topics)
}

// Rust: Source/CmdInspect.rs:1752
// Slices are byte-exact ranges of the full digest; concatenation reproduces it.
fn digest_slices() -> [DigestSlice] {
    digest :: llm_digest()
    headings :: [
        ("first-program", "## First program"), ("core.source-rules", "## Core source rules"),
        ("idioms", "## Canonical idiom suites"), ("syntax.keywords", "## Keywords"),
        ("syntax.types", "## Built-in type names"), ("syntax.reserved", "## Reserved first-party names"),
        ("markers", "## Markers"), ("core", "## Core module index"), ("diagnostics", "## Diagnostics")
    ]
    starts :: headings.iter().map((_, heading) -> digest.find(heading).expect("digest heading disappeared")).collect<[UInt]>()
    slices := []
    loop (index, (topic, _)) in headings.iter().enumerate() {
        start :: if index == 0 -> 0 else -> starts[index]
        end :: starts.get(index + 1).copied().unwrap_or(digest.len())
        if topic != "core" -> {
            slices.push(DigestSlice{topic: topic.to_string(), bytes: digest[start..end].to_string()})
            next
        }
        header_end :: digest[start..end].find("module\titems\n")
            .map(offset -> start + offset + "module\titems\n".len()).expect("core digest header disappeared")
        rows :: digest[header_end..end].split_inclusive('\n').scan(header_end, (offset, line) -> {
            start :: offset
            offset += line.len()
            Some((start, offset, line.starts_with("core.")))
        }).filter_map((start, end, is_module) -> is_module.then_some((start, end))).collect<[(UInt, UInt)]>()
        loop (row_index, (row_start, row_end)) in rows.iter().enumerate() {
            topic :: digest[row_start..row_end].split_once('\t').map((module, _) -> module).expect("core digest row lost module name")
            slice_start :: if row_index == 0 -> start else -> row_start
            slice_end :: rows.get(row_index + 1).map((next_start, _) -> next_start).unwrap_or(end)
            slices.push(DigestSlice{topic: topic.to_string(), bytes: digest[slice_start..slice_end].to_string()})
        }
    }
    slices
}

// Rust: Source/CmdInspect.rs:1813
fn llm_digest() -> String {
    marker_text :: digest_marker_text()
    diagnostic_text :: digest_diagnostic_text()
    core_text :: digest_core_module_text()
    idiom_suites_body :: [
        "Each idiom has one executable, golden-backed source of truth under `Examples/suites/`.",
        "",
        "- Dispatch: `Examples/suites/dispatch.jet` — ordered dispatch tables and grouped aliases.",
        "- Failure: `Examples/suites/failure.jet` — implicit failure flow, typed expert contracts, and one conversion rail.",
        "- Finite state: `Examples/suites/finite_state.jet` — enums, variant groups, tags, and typestate transitions.",
        "- Ownership: `Examples/suites/ownership.jet` — reused views, explicit `~` boundaries, and cost visibility.",
        "- Wire output: `Examples/suites/wire_output.jet` — canonical JSON writer bytes and a `#Codable` round trip."
    ].join("\n")
    first_program_body :: [
        "A source file ends with one `fn run()` entry. `print` is a built-in.",
        "", "```jet", "fn run() {{", "    greeting :: \"Hello, Jet\"", "    print(greeting)", "}}", "```", "",
        "No semicolons. Comments start with `//`. Strings use double quotes and interpolate {{name}}."
    ].join("\n")
    core_rules_body :: [
        "Bindings: `name :: value` is immutable; `name := value` is mutable; `name = value` reassigns a mutable binding.",
        "Functions: `fn name(parameter: Type) -> Return {{ ... }}`; an effect ceiling splits the arrow: `fn name(parameter: Type) -[Effects]> Return {{ ... }}`, and `-[]>` declares a pure function.",
        "Visibility: declarations are private by default; prefix an item with `pub` for package use.",
        "Types: `Int`, `Float`, `Bool`, `String`, `Char`; lists use `[T]`; optional values use `T?`; failures use `T E!`.",
        "Errors: failures propagate implicitly; handle `T?` or `T E!` with `?? fallback` or a pattern test. Use `Ok(value)`, `Err(error)`, `Val(value)`, and `None`.",
        "Control: `if condition {{ ... }} else {{ ... }}`; loops use `loop name in source {{ ... }}`, and a collecting loop yields a list with `loop name in source -> value`; exit with `break` and advance with `next`.",
        "Construction: use `Type{{ field: value }}`; list literals use `[T]{{ value1, value2 }}`.",
        "Calls and member access use `name(args)` and `value.member(args)`. Core imports use `use core.module as alias`.",
        "Ownership is safe by default. `&T` writes, `^T` moves, and `~value` copies. Expert unsafe code needs `#Unsafe(\"reason\")`."
    ].join("\n")
    marker_body :: "User marker spelling is `#Name(arguments)`; rows below are registry declarations.\n\n```text\n{marker_text}\n```"
    core_body :: "Use a module alias, then call an indexed item: `use core.term as term`; `term.print(\"hi\")`.\n\n```text\n{core_text}\n```"
    diagnostic_body :: "Diagnostic rows use current registry meaning. Match code first; follow `fix`. Rows marked retired or reserved are not current syntax.\n\n```text\n{diagnostic_text}\n```"
    out :: [
        "# Jet LLM surface digest", "",
        "Generated. Current compiler registries own markers, diagnostics, syntax names, and Core items.",
        "Read on demand with `jet inspect digest`; do not maintain a checked-in copy.",
        "Use active rows only. Retired rows teach replacement; they are not valid current source.",
        "Write one current program. Do not invent aliases, legacy spellings, or library namespaces.", "",
        digest_section("First program", first_program_body),
        digest_section("Core source rules", core_rules_body),
        digest_section("Canonical idiom suites", idiom_suites_body),
        digest_section("Keywords", digest_list(Syntax.JET_KEYWORD_LIST)),
        digest_section("Built-in type names", digest_list(Syntax.JET_TYPE_LIST)),
        digest_section("Reserved first-party names", digest_list(Syntax.FIRST_PARTY_RESERVED)),
        digest_section("Markers", marker_body),
        digest_section("Core module index", core_body),
        digest_section("Diagnostics", diagnostic_body)
    ].join("\n")
    trimmed := out.trim_end() // #4303
    "{trimmed}\n"
}

// Rust: Source/CmdInspect.rs:1888
fn digest_section(title: String, body: String) -> String {
    trimmed := body.trim() // #4303
    "## {title}\n\n{trimmed}\n"
}

// Rust: Source/CmdInspect.rs:1892
fn digest_list(values: &[String]) -> String {
    unique := []
    loop value in values {
        if !unique.iter().any(seen -> seen == value) -> unique.push(value)
    }
    unique.into_iter().map(value -> "- {value}").collect<[String]>().join("\n")
}

// Rust: Source/CmdInspect.rs:1906
fn digest_marker_text() -> String {
    out := "status\tname\tregistered declaration"
    loop row in Registry.marker_rows() {
        rule :: row.rule.expect("every marker registry row has an applied rule")
        status :: if rule.status == { .Active -> "active", .Retired{..} -> "retired" }
        out.push_str("\n{status}\t{row.name}\t{digest_marker_declaration(rule)}")
    }
    out
}

// Rust: Source/CmdInspect.rs:1927
fn digest_marker_declaration(rule: &AppliedRule) -> String {
    fields := rule.signature.params.iter().map(param -> {
        default :: param.default.map_or("", value -> "{{{value}}}")
        "{param.name}: {param.source_type}{default}"
    }).collect<[String]>()
    if rule.signature.variadic_source_type == .Some(source_type) -> fields.push("{source_type}...")
    sites :: rule.sites.iter().map(site -> ".{site.name()}").collect<[String]>().join(", ")
    fields.push("@sites: [{sites}]")
    if rule.repeatable -> fields.push("@repeatable: true")
    if rule.owns_menu -> fields.push("@owns_menu: true")
    if rule.inherits -> fields.push("@inherits: true")
    if rule.resolution != RuleResolution.SiteBound -> fields.push("@resolution: .{digest_resolution_name(rule.resolution)}")
    if !rule.policy_scopes.is_empty() -> {
        scopes :: rule.policy_scopes.iter().map(scope -> ".{digest_scope_name(scope)}").collect<[String]>().join(", ")
        fields.push("@scopes: [{scopes}]")
    }
    if rule.companion_site == .Some(companion) -> fields.push("@companion: [{companion.rule}, .{companion.site.name()}]")
    if rule.status == .Retired{replacement} -> fields.push("@retired: \"{digest_quote(replacement)}\"")
    "marker {rule.name}({fields.join(", ")})"
}

// Rust: Source/CmdInspect.rs:1988
fn digest_scope_name(scope: PolicyScope) -> String {
    if scope == {
        .Organization -> "Organization"
        .Package -> "Package"
        .Module -> "Module"
        .Function -> "Function"
        .Block -> "Block"
    }
}

// Rust: Source/CmdInspect.rs:1998
fn digest_resolution_name(resolution: RuleResolution) -> String {
    if resolution == {
        .SiteBound -> "SiteBound"
        .Override -> "Override"
        .Merge -> "Merge"
        .Tighten -> "Tighten"
    }
}

// Rust: Source/CmdInspect.rs:2007
fn digest_quote(value: String) -> String {
    value.replace('\\', "\\\\").replace('"', "\\\"")
}

// Rust: Source/CmdInspect.rs:2011
fn digest_diagnostic_text() -> String {
    out := "code\tstatus\tstage\tseverity\tmoment\tmeaning\twhat\twhy\tfix\tdetail\tstructured-fix"
    loop row in Registry.diagnostic_rows() {
        severity :: if row.severity == { .Error -> "error", .Lint -> "lint" }
        structured_fix :: row.structured_fix.map_or_else(() -> "-", fix -> fix.source_marker())
        out.push_str("\n{row.code}\t{row.status.name()}\t{row.stage}\t{severity}\t{row.moment.as_str()}\t{digest_one_line(row.meaning)}\t{digest_one_line(row.what)}\t{digest_one_line(row.why)}\t{digest_one_line(row.fix)}\t{row.detail}\t{structured_fix}")
    }
    out
}

// Rust: Source/CmdInspect.rs:2042
fn digest_one_line(value: String) -> String {
    value.split_whitespace().collect<[String]>().join(" ")
}

// Rust: Source/CmdInspect.rs:2046
fn digest_core_module_text() -> String {
    out := "module\titems"
    loop module in Syntax.KNOWN_CORE_MODULES {
        items :: Sema.core_module_items(module)
        rendered :: digest_core_items(&items)
        out.push_str("\n{module}\t{rendered}")
    }
    out
}

// Rust: Source/CmdInspect.rs:2056
fn digest_core_items(items: &[String]) -> String {
    unique := []
    loop item in items {
        if !unique.iter().any(seen -> seen == item) -> unique.push(item.clone())
    }
    if unique.is_empty() -> "(no indexed item)" else -> unique.join(", ")
}

// Rust: Source/CmdInspect.rs:2073
// Reads lock-backed provenance; verification stays in the existing resolver.
pub fn run_provenance(args: &[String], json: Bool) -> {
    cwd :: core.env.current_dir().unwrap_or_else(_ -> OSPath.new("."))
    root :: jet_cli.require_manifest_root(&cwd,
        "error: no package.jet found — run `jet inspect provenance` inside a project")
    lock :: jet.Lock.load(&root).unwrap_or_else(() -> {
        cli_error("E1202", "no lockfile found — run `jet fetch` first")
        exit(ExitCodes.USER_ERROR)
    })
    entry :: jet_cli.find_project_entry(&root)
    package :: if Loader.package_facts_for_entry(&entry) == {
        .Ok(.Some(package)) -> package
        .Ok(.None) -> {
            cli_error("E2105", "the project has no package facts")
            exit(ExitCodes.USER_ERROR)
        }
        .Err(diagnostics) -> {
            source :: fs.read_to_string(&entry).unwrap_or_default()
            file :: entry.display().to_string()
            if json -> {
                machine_file :: jet_cli.machine_report_path_for_process(&file)
                clears :: jet.Diagnostics.report_clear_counts(&diagnostics)
                reports :: diagnostics.iter().zip(clears).map((diagnostic, clears) ->
                    diagnostic.to_report_with_clears(&machine_file, &source, clears))
                rendered :: render_status_with_reports("inspect.provenance", false, reports, StatusFields.new())
                print("{rendered}\n")
            } else -> eprint("{jet.render_diagnostics(&file, &source, &diagnostics)}")
            exit(ExitCodes.USER_ERROR)
        }
    }
    requirement :: package.authority.trust.as_ref().and_then(trust -> trust.require).unwrap_or(Package.ProvenanceRequirement.None)
    target :: provenance_target(args)
    reports := lock.packages.iter().filter(package -> {
        if package.source == { .Root -> false, _ -> true }
    }).filter(package -> target.is_none() || target == Some(package.name)).map(package -> package.provenance_report()).collect()
    reports.sort_by((left, right) -> left.name.cmp(&right.name).then(left.version.cmp(&right.version)))
    if target == .Some(target) -> {
        if reports.is_empty() -> {
            cli_error(@fix "E2104", "dependency `{target}` is not present in the lockfile",
                "use `jet inspect provenance` to list locked dependencies")
            exit(ExitCodes.USER_ERROR)
        }
    }
    if json -> render_provenance_json(requirement, &reports) else -> render_provenance_text(requirement, &reports)
}

// Rust: Source/CmdInspect.rs:2151
fn provenance_target(args: &[String]) -> String? {
    args.iter().find(argument -> !argument.starts_with('-')).cloned()
}

// Rust: Source/CmdInspect.rs:2157
fn render_provenance_text(requirement: Package.ProvenanceRequirement, reports: &[jet.Lock.DependencyProvenanceReport]) -> {
    println("provenance")
    println("require: {requirement.label()}")
    loop (index, report) in reports.iter().enumerate() {
        if index > 0 -> println("")
        println("{report.name} {report.version}")
        evidence :: if report.integrity.status == jet.Lock.ProvenanceStatus.Enforced -> ", E1204" else -> ""
        println("  {"integrity":<12} {report.integrity.value} — matches .jet/lock ({report.integrity.status.label()}{evidence})")
        render_provenance_field("transparency", &report.transparency)
        render_provenance_field("publisher", &report.publisher)
        render_provenance_field("build", &report.build)
        render_effect_provenance_text(report)
    }
}

// Rust: Source/CmdInspect.rs:2187
fn render_provenance_field(label: String, field: &jet.Lock.ProvenanceField) -> {
    println("  {label:<12} {field.value} ({field.status.label()})")
}

// Rust: Source/CmdInspect.rs:2191
fn render_effect_provenance_text(report: &jet.Lock.DependencyProvenanceReport) -> {
    println("  effect roles")
    println("    required effects: {effect_names(&report.required_effects)}")
    println("    granted effects: {effect_names(&report.granted_effects)}")
    println("    denied effects: {effect_names(&report.denied_effects)}")
    println("    authority: {report.authority}")
}

// Rust: Source/CmdInspect.rs:2208
fn effect_names(effects: &[String]) -> String {
    if effects.is_empty() -> "none" else -> effects.join(", ")
}

// Rust: Source/CmdInspect.rs:2216
fn render_provenance_json(requirement: Package.ProvenanceRequirement, reports: &[jet.Lock.DependencyProvenanceReport]) -> {
    packages :: StatusValue.array(reports.iter().map(render_provenance_json_package))
    payload :: render_status("inspect.provenance", true, StatusFields.new().with("provenance",
        StatusValue.object(StatusFields.new().with("require", requirement.label()).with("packages", packages))))
    println("{payload}")
}

