//RS /// Split the one rendered digest into byte-exact topic slices. The full digest
//RS /// remains the only source: slices are ranges of its output, so concatenating
//RS /// the listed slices reproduces the whole file exactly.
//RS fn digest_slices() -> Vec<DigestSlice> {
//RS     let digest = llm_digest();
//RS     let headings = [
//RS         ("first-program", "## First program"),
//RS         ("core.source-rules", "## Core source rules"),
//RS         ("idioms", "## Canonical idiom suites"),
