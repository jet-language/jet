// Rust: Source/CmdInspect.rs:2236
fn render_provenance_json_package(report: DependencyProvenanceReport) -> StatusValue {
    integrity_evidence :: if report.integrity.status == .Enforced -> Some("E1204") else -> None
    StatusValue.object(StatusFields.new()
        .with("name", report.name).with("version", report.version)
        .with("integrity", render_provenance_json_field(report.integrity, integrity_evidence))
        .with("transparency", render_provenance_json_field(report.transparency, None))
        .with("publisher", render_provenance_json_field(report.publisher, None))
        .with("build", render_provenance_json_field(report.build, None))
        .with("required_effects", StatusValue.array(report.required_effects.iter().map((effect) -> StatusValue.from(effect))))
        .with("granted_effects", StatusValue.array(report.granted_effects.iter().map((effect) -> StatusValue.from(effect))))
        .with("denied_effects", StatusValue.array(report.denied_effects.iter().map((effect) -> StatusValue.from(effect))))
        .with("authority", report.authority))
}

// Rust: Source/CmdInspect.rs:2290
fn render_provenance_json_field(field: ProvenanceField, evidence: String?) -> StatusValue {
    fields := StatusFields.new().with("value", field.value).with("status", field.status.label())
    if evidence == .Some(value) -> fields = fields.with("evidence", value)
    StatusValue.object(fields)
}

// Rust: Source/CmdInspect.rs:2303
fn shape_type_label(ty: ShapeType) -> String {
    if ty == {
        .Null -> "Null"
        .Bool -> "Bool"
        .Int -> "Int"
        .Float -> "Float"
        .Number -> "Number"
        .Text -> "Text"
        .Bytes -> "Bytes"
        .Array(inner) -> "[{shape_type_label(inner)}]"
        .Optional(inner) -> "{shape_type_label(inner)}?"
        .Object(identity) -> "Object({identity.key()})"
        .Unknown(value) -> "Unknown({value})"
    }
}

// Rust: Source/CmdInspect.rs:2319
fn shape_default_value(default: ShapeDefault) -> StatusValue {
    if default == {
        .Null -> StatusValue.Null
        .Bool(value) -> StatusValue.from(value)
        .Int(value) -> StatusValue.from(value)
        .Float(value) -> StatusValue.Float(value)
        .Text(value) -> StatusValue.from(value)
        .Bytes(value) -> StatusValue.array(value.iter().map((byte) -> StatusValue.from(Int128.from(byte))))
        .Unknown(value) -> StatusValue.from(value)
    }
}

// Rust: Source/CmdInspect.rs:2335
fn shape_optional_name(value: String?, format: String, ignored: &[String]) -> StatusValue {
    if value == {
        .Some(name) -> StatusValue.from(name)
        .None -> {
            ignored.push(format)
            StatusValue.Null
        }
    }
}

// Rust: Source/CmdInspect.rs:2349
fn shape_names_value(names: ShapeFieldNames) -> StatusValue {
    ignored := [String]{}
    value :: StatusFields.new().with("text", names.text)
        .with("json", shape_optional_name(names.json, "json", &ignored))
        .with("cbor", shape_optional_name(names.cbor, "cbor", &ignored))
        .with("csv", shape_optional_name(names.csv, "csv", &ignored))
        .with("toml", shape_optional_name(names.toml, "toml", &ignored))
        .with("yaml", shape_optional_name(names.yaml, "yaml", &ignored))
        .with("xml", shape_optional_name(names.xml, "xml", &ignored))
        .with("args", names.args).with("env", names.env)
        .with("db", shape_optional_name(names.db, "db", &ignored))
        .with("layout", shape_optional_name(names.layout, "layout", &ignored))
        .with("ignored", StatusValue.array(ignored.iter().map((format) -> StatusValue.from(format))))
    StatusValue.object(value)
}

// Rust: Source/CmdInspect.rs:2398
fn shape_layout_kind(kind: ShapeLayoutKind) -> String {
    if kind == { .Default -> "default"; .C -> "c"; .Columnar -> "columnar" }
}

// Rust: Source/CmdInspect.rs:2406
fn shape_layout_value(fact: ShapeFact) -> StatusValue {
    StatusValue.object(StatusFields.new().with("kind", shape_layout_kind(fact.layout.kind))
        .with("alignment", fact.layout.alignment.map(StatusValue.from).unwrap_or(StatusValue.Null)))
}

// Rust: Source/CmdInspect.rs:2420
fn shape_dimensions_value(dimensions: ShapeDimensions) -> StatusValue {
    if dimensions == {
        .Known(rank, width) -> StatusValue.object(StatusFields.new().with("status", "known").with("rank", rank).with("width", width))
        .Unknown(reason) -> StatusValue.object(StatusFields.new().with("status", "unknown").with("reason", reason))
    }
}

// Rust: Source/CmdInspect.rs:2436
fn shape_provenance_value(fact: ShapeFact) -> StatusValue {
    origin :: if fact.provenance.origin == {
        .Declared -> StatusValue.from("declared")
        .Derived(from) -> StatusValue.object(StatusFields.new().with("kind", "derived").with("from", from.key()))
        .Imported(package) -> StatusValue.object(StatusFields.new().with("kind", "imported").with("package", package))
    }
    span :: fact.provenance.span.map((span) -> StatusValue.object(StatusFields.new().with("start", span.start).with("end", span.end))).unwrap_or(StatusValue.Null)
    StatusValue.object(StatusFields.new().with("origin", origin).with("span", span)
        .with("declaration", fact.provenance.declaration.map(StatusValue.from).unwrap_or(StatusValue.Null)))
}

// Rust: Source/CmdInspect.rs:2476
fn shape_field_value(field: ShapeFieldFact) -> StatusValue {
    StatusValue.object(StatusFields.new().with("source_name", field.name)
        .with("type", shape_type_label(field.ty)).with("order", field.order)
        .with("encoding", field.encoding).with("skipped", field.skip)
        .with("default", field.default.map(shape_default_value).unwrap_or(StatusValue.Null))
        .with("names", shape_names_value(field.names))
        .with("short", field.short.map(StatusValue.from).unwrap_or(StatusValue.Null))
        .with("doc", field.doc.map(StatusValue.from).unwrap_or(StatusValue.Null)))
}

// Rust: Source/CmdInspect.rs:2512
fn shape_projection_value(fact: ShapeFact, kind: ShapeProjectionKind) -> StatusValue {
    if fact.project(kind) == {
        .Ok(projection) -> {
            fields :: StatusValue.array(projection.fields.iter().map((field) ->
                StatusValue.object(StatusFields.new().with("source_name", field.source_name)
                    .with("name", field.name).with("decode_name", field.decode_name)
                    .with("type", shape_type_label(field.ty)).with("order", field.order)
                    .with("encoding", field.encoding)
                    .with("default", field.default.map(shape_default_value).unwrap_or(StatusValue.Null))
                    .with("short", field.short.map(StatusValue.from).unwrap_or(StatusValue.Null))
                    .with("doc", field.doc.map(StatusValue.from).unwrap_or(StatusValue.Null)))))
            StatusValue.object(StatusFields.new().with("kind", kind.as_str()).with("status", "supported").with("fields", fields))
        }
        .Err(error) -> StatusValue.object(StatusFields.new().with("kind", kind.as_str())
            .with("status", "unsupported").with("ignored", true).with("reason", error.to_string()))
    }
}

// Rust: Source/CmdInspect.rs:2567
fn shape_fact_value(fact: ShapeFact) -> StatusValue {
    identity :: StatusValue.object(StatusFields.new().with("source", fact.identity.source)
        .with("type", fact.identity.type_name).with("key", fact.identity.key()))
    fields :: StatusValue.array(fact.fields.iter().map(shape_field_value))
    projections :: StatusValue.array(ShapeProjectionKind.ALL.iter().map((kind) -> shape_projection_value(fact, kind)))
    StatusValue.object(StatusFields.new().with("identity", identity)
        .with("dimensions", shape_dimensions_value(fact.dimensions)).with("encoding", fact.encoding)
        .with("layout", shape_layout_value(fact)).with("provenance", shape_provenance_value(fact))
        .with("fields", fields).with("projections", projections))
}

// Rust: Source/CmdInspect.rs:2592
fn shape_name_text(value: String?) -> String { value.unwrap_or("ignored") }

// Rust: Source/CmdInspect.rs:2596
fn print_shape_fact(fact: ShapeFact) -> {
    println("shape {fact.identity.key()} (encoding={fact.encoding}, layout={shape_layout_kind(fact.layout.kind)})")
    println("  dimensions: {fact.dimensions.debug()}")
    loop field in fact.fields {
        println("  field {field.name}: {shape_type_label(field.ty)} (order={field.order}, encoding={field.encoding}, skipped={field.skip})")
        println("    names: text={field.names.text} json={shape_name_text(field.names.json)} cbor={shape_name_text(field.names.cbor)} csv={shape_name_text(field.names.csv)} toml={shape_name_text(field.names.toml)} yaml={shape_name_text(field.names.yaml)} xml={shape_name_text(field.names.xml)} args={field.names.args} env={field.names.env} db={shape_name_text(field.names.db)} layout={shape_name_text(field.names.layout)}")
    }
    loop kind in ShapeProjectionKind.ALL {
        if fact.project(kind) == {
            .Ok(projection) -> println("  projection {kind.as_str()}: supported ({projection.fields.len()} fields)")
            .Err(error) -> println("  projection {kind.as_str()}: ignored ({error})")
        }
    }
}

// Rust: Source/CmdInspect.rs:2642
// Expose the canonical shape fact and every typed projection.
pub fn run_shapes(args: [String], json: Bool) -> {
    file :: entry_file(args)
    if file == None {
        cli_error_fix("E2104", "`jet inspect shapes` needs an entry file",
            "run `jet inspect shapes Examples/features/encoding/records.jet`")
        exit(jet.ExitCodes.USAGE)
    }
    path :: OSPath.new(file.unwrap())
    projection :: check_projection(path).unwrap_or_else((diagnostics) -> render_check_failure(path, diagnostics, json, false))
    facts := [ShapeFact]{}
    loop module in projection.bundle.modules {
        loop item in module.items {
            if item == .Struct(structure) {
                fact :: if shape_fact_from_struct(module.display, structure) == {
                    .Ok(fact) -> fact
                    .Err(error) -> {
                        emit_cli_report_for_action("inspect.shapes", "E2105",
                            "could not project shape `{structure.name}` from `{module.display}`: {error}",
                            "the checked declaration could not form one canonical shape fact",
                            "fix the declaration's field names, types, or format markers", json)
                        exit(jet.ExitCodes.USER_ERROR)
                    }
                }
                facts.push(fact)
            }
        }
    }
    facts.sort_by((left, right) -> left.identity.cmp(right.identity))
    if json {
        shapes :: StatusValue.array(facts.iter().map(shape_fact_value))
        println("{render_status(\"inspect.shapes\", true, StatusFields.new().with(\"shapes\", shapes))}")
    } else {
        if facts.is_empty() -> println("No shape facts declared.")
        loop fact in facts -> print_shape_fact(fact)
    }
}

// Rust: Source/CmdInspect.rs:2702
fn entry_file(args: [String]) -> String? {
    skip_value := false
    loop argument in args {
        if skip_value { skip_value = false; continue }
        if argument == "--profile" || argument == "--target" || argument == "--scope" || argument == "--kind" {
            skip_value = true
            continue
        }
        if argument.starts_with("-") -> continue
        return Some(argument)
    }
    None
}

// Rust: Source/CmdInspect.rs:2726
pub fn run_types(args: [String], json: Bool) -> {
    file :: entry_file(args)
    if file == None {
        cli_error_fix("E2104", "`jet inspect types` needs an entry file",
            "run `jet inspect types Examples/features/operators/mixed_types.jet`")
        exit(jet.ExitCodes.USAGE)
    }
    path :: OSPath.new(file.unwrap())
    projection :: check_projection(path).unwrap_or_else((diagnostics) -> render_check_failure(path, diagnostics, json, false))
    grouped := [String:[String]]{}
    registered := [jet_foundation.Traits.OperatorImpl]{}
    loop module in projection.bundle.modules {
        registry := TraitRegistry.auto_derives_for_items(module.items)
        registry.register_synthetic_operators()
        registered.extend(registry.operator_impls)
    }
    loop implementation in registered {
        symbol :: operator_symbol(implementation.trait_name)
        if symbol == None -> continue
        rhs :: implementation.rhs.name()
        owner :: if plain_number(implementation.left) && !plain_number(rhs) -> rhs else -> implementation.left
        source :: "{implementation.left}.{implementation.trait_name}<{rhs}>"
        result :: implementation.result.name()
        kind :: if implementation.explicit_rhs -> "explicit hook" else -> "hook"
        direct :: "{implementation.left} {symbol.unwrap()} {rhs} -> {result}  {kind} {source}"
        grouped.entry(owner).or_default().push(direct)
        if plain_number(rhs) && !plain_number(implementation.left) && (implementation.trait_name == "Add" || implementation.trait_name == "Mul") {
            explicit_reverse :: registered.iter().any((candidate) ->
                candidate.explicit_rhs && candidate.left == rhs
                && candidate.trait_name == implementation.trait_name
                && candidate.rhs.name() == implementation.left)
            if !explicit_reverse -> grouped.entry(owner).or_default().push("{rhs} {symbol.unwrap()} {implementation.left} -> {result}  mirror of {source}")
        }
    }
    loop rows in grouped.values_mut() { rows.sort(); rows.dedup() }
    owners := grouped.keys().collect()
    owners.sort()
    if json {
        types :: StatusValue.array(owners.iter().map((owner) ->
            StatusValue.object(StatusFields.new().with("type", owner)
                .with("rows", StatusValue.array(grouped[owner].iter().map((row) -> StatusValue.from(row)))))))
        payload :: render_status("inspect.types", true, StatusFields.new().with("types", types))
        println("{payload}")
    } else {
        loop owner in owners {
            println("type {owner}:")
            loop row in grouped[owner] -> println("  {row}")
        }
    }
}

use jet_foundation.MIROptimization.Acceleration.[AccelerationGate, AccelerationGateStatus, AccelerationGateInput, AccelerationProof, AccelerationWorkloadFacts, AccelerationMeasurement, D_ACCEL_STATIC_FLOOR_ITEMS, D_ACCEL_CACHE_BLOCK_BYTES, D_ACCEL_REQUIRED_GAIN_NUMERATOR, D_ACCEL_REQUIRED_GAIN_DENOMINATOR]
use jet_foundation.MIR.[MirOptimizationRejection, MirOptimizationDecision, MirVectorFact, MirAccelerationFact, MirLoopFact, MirArtifactBuildMode, MirArtifactRequest, MirArtifactTarget, MirArtifactKind]
use jet.ReceiptStore.[ReceiptStore, AccelerationReceiptRow, input_paths_for, receipt_root_for, canonical_target_identity, acceleration_decisions]
use jet.RecordIndex.[RecordIndex, RecordKind]

// Rust: Source/CmdInspect.rs:2816
fn acceleration_scope_name(scope: InspectScope) -> String {
    if scope == { .Package -> "package"; .Target(_) -> "target"; .Live(_) -> "live"; .Replay(_) -> "replay" }
}

// Rust: Source/CmdInspect.rs:2825
fn acceleration_span_value(start: USize, end: USize) -> StatusValue {
    StatusValue.object(StatusFields.new().with("start", start).with("end", end))
}

// Rust: Source/CmdInspect.rs:2829
struct AccelerationRuntimeReceipt {
    receipt_digest: String
    receipt_verb: String
    record_sequence: UInt64
    row: AccelerationReceiptRow
}

// Rust: Source/CmdInspect.rs:2836
fn acceleration_runtime_receipt(scope: InspectScope, file: String, profile: String) -> [AccelerationRuntimeReceipt] {
    cwd :: if core.env.current_dir() == { .Ok(cwd) -> cwd; .Err(_) -> return [] }
    receipt_root := OSPath?{None}
    target_identities := [(String, OSPath)]{}
    loop verb in ["test", "prove", "build"] {
        argv := [verb]
        if scope == .Target(target) -> argv.push(target)
        if !profile.is_empty() -> argv.extend(["--profile", profile])
        inputs :: input_paths_for(verb, argv, cwd)
        if inputs.is_empty() -> continue
        root :: receipt_root_for(verb, argv, cwd)
        if receipt_root == None -> receipt_root = Some(root)
        store :: ReceiptStore.new(root)
        claim :: if store.claim(verb, argv, inputs) == { .Ok(claim) -> claim; .Err(_) -> continue }
        members :: claim.inputs.iter().map((input) -> (input.path.to_string_lossy().into_owned(), input.digest)).collect()
        identity :: if canonical_target_identity(OSPath.new(file), members) == { .Ok(identity) -> identity; .Err(_) -> continue }
        target_identities.push((identity.input_sha256, identity.authority_root))
    }
    if receipt_root == None || target_identities.is_empty() -> return []
    store :: ReceiptStore.new(receipt_root.unwrap())
    index_roots := [cwd]
    loop (_, authority_root) in target_identities {
        if !index_roots.contains(authority_root) -> index_roots.push(authority_root)
    }
    entries := [jet.RecordIndex.RecordEntry]{}
    loop index_root in index_roots {
        index :: if RecordIndex.load_for_project(index_root) == { .Ok(index) -> index; .Err(_) -> continue }
        entries.extend(index.query_kind(RecordKind.Receipt, true).iter().filter((entry) ->
            target_identities.iter().any((identity) -> entry.identity.target_inputs_sha256 == identity.0)
            && entry.identity.tool_version == jet.VERSION))
    }
    entries.sort_by((left, right) -> right.recorded_sequence.cmp(left.recorded_sequence)
        .then_with(() -> right.artifact_id.cmp(left.artifact_id)))
    entries.dedup_by((left, right) -> left.artifact_id == right.artifact_id)
    receipts :: if store.list() == {
        .Ok(receipts) -> receipts.iter().filter_map((receipt) -> store.lookup(receipt.claim).ok().flatten()).collect()
        .Err(_) -> return []
    }
    loop entry in entries {
        receipt :: receipts.iter().find((receipt) -> receipt.claim.key == entry.artifact_id)
        if receipt == None -> continue
        found :: receipt.unwrap()
        receipt_members :: found.claim.inputs.iter().map((input) ->
            (input.path.to_string_lossy().into_owned(), input.digest)).collect()
        receipt_identity :: if canonical_target_identity(OSPath.new(file), receipt_members) == {
            .Ok(identity) -> identity
            .Err(_) -> continue
        }
        if !target_identities.iter().any((identity) -> receipt_identity.input_sha256 == identity.0) -> continue
        rows :: if acceleration_decisions(found) == { .Ok(rows) -> rows; .Err(_) -> continue }
        return rows.iter().map((row) -> AccelerationRuntimeReceipt{
            receipt_digest: found.digest, receipt_verb: found.claim.verb,
            record_sequence: entry.recorded_sequence, row: row,
        }).collect()
    }
    []
}

// Rust: Source/CmdInspect.rs:2974
fn acceleration_runtime_measurement_value(measurement: AccelerationMeasurement) -> StatusValue {
    StatusValue.object(StatusFields.new().with("items", measurement.items)
        .with("sample_items", measurement.sample_items).with("sample_nanos", measurement.sample_nanos)
        .with("spawn_nanos", measurement.spawn_nanos).with("bandwidth_floor_nanos", measurement.bandwidth_floor_nanos)
        .with("floor_nanos", measurement.floor_nanos)
        .with("projected_serial_nanos", measurement.projected_serial_nanos.map(StatusValue.from).unwrap_or(StatusValue.Null))
        .with("required_serial_nanos", measurement.required_serial_nanos.map(StatusValue.from).unwrap_or(StatusValue.Null)))
}

// Rust: Source/CmdInspect.rs:3002
fn acceleration_runtime_value(runtime: AccelerationRuntimeReceipt) -> StatusValue {
    decision :: runtime.row.decision
    pin :: if decision.status == { .Pinned(pin) -> StatusValue.from(pin.as_str()); _ -> StatusValue.Null }
    StatusValue.object(StatusFields.new().with("record_sequence", runtime.record_sequence)
        .with("receipt_digest", runtime.receipt_digest).with("receipt_verb", runtime.receipt_verb)
        .with("sequence", runtime.row.sequence).with("function", runtime.row.function)
        .with("loop_header", runtime.row.loop_header)
        .with("source", acceleration_span_value(runtime.row.source_start, runtime.row.source_end))
        .with("transform", decision.transform.as_str()).with("status", decision.status.as_str())
        .with("pin", pin).with("selected", decision.selected()).with("measurement_source", "receipt")
        .with("measurement", acceleration_runtime_measurement_value(decision.measurement)))
}

// Rust: Source/CmdInspect.rs:3031
fn acceleration_rejection_statement(reason: MirOptimizationRejection) -> String {
    if reason == {
        .MissingProof -> "the loop lacks the required proof"
        .MayTrap -> "the loop may trap"
        .HasEffects -> "the loop body has effects"
        .HasEarlyExit -> "the loop has an early exit"
        .MayAlias -> "the loop may alias"
        .CrossIterationDependency -> "iterations depend on each other"
        .DynamicTripCount -> "the trip count is dynamic"
        .UnknownCopyCost -> "copy cost is unknown"
        .ScalarBoundary -> "the loop crosses a scalar boundary"
        .ObservableLayout -> "the layout is observable"
        .OwnershipObligation -> "the ownership proof is incomplete"
        .UnsupportedOperation -> "the operation is unsupported"
    }
}

// Rust: Source/CmdInspect.rs:3050
fn acceleration_gate_statement(status: AccelerationGateStatus?) -> String {
    if status == {
        .None -> "the runtime profile has not been published"
        .Some(.BelowStaticFloor) -> "the source item count is at or below the static floor"
        .Some(.Pinned(pin)) -> "the loop is pinned by {pin.as_str()}"
        .Some(.NotReleaseBuild) -> "the build is not a release profile"
        .Some(.CrossModeParityMissing) -> "cross-mode parity proof is incomplete"
        .Some(.ColumnCopyNotApplicable) -> "nested-reuse facts do not permit a column copy"
        .Some(.ProofIncomplete) -> "the acceleration proof is incomplete"
        .Some(.SampleNotTimed) -> "the first serial chunk has not been timed"
        .Some(.SpawnCostNotMeasured) -> "the once-per-process spawn cost has not been measured"
        .Some(.BandwidthFloorNotMeasured) -> "the memory-bandwidth floor has not been measured"
        .Some(.InvalidMeasurement) -> "the supplied measurement is invalid"
        .Some(.ProjectedGainBelowThreshold) -> "projected gain is below the required threshold"
        .Some(.Selected) -> "the measured gate selected this transform"
    }
}

// Rust: Source/CmdInspect.rs:3092
fn acceleration_proof_value(proof: AccelerationProof) -> StatusValue {
    StatusValue.object(StatusFields.new().with("source_proven", proof.source_proven)
        .with("independent_iterations", proof.independent_iterations).with("no_aliasing", proof.no_aliasing)
        .with("no_cross_iteration_dependencies", proof.no_cross_iteration_dependencies)
        .with("no_early_exit", proof.no_early_exit).with("effect_free_body", proof.effect_free_body)
        .with("ownership_safe", proof.ownership_safe).with("failure_order_preserved", proof.failure_order_preserved))
}

// Rust: Source/CmdInspect.rs:3109
fn acceleration_workload_value(workload: AccelerationWorkloadFacts) -> StatusValue {
    StatusValue.object(StatusFields.new().with("nested_reuse", workload.nested_reuse)
        .with("single_pass", workload.single_pass).with("column_copy_applicable", workload.column_copy_applicable()))
}

// Rust: Source/CmdInspect.rs:3118
fn acceleration_vector_value(function: String, fact: MirVectorFact) -> StatusValue {
    (decision, accepted_rule, rejection_code, rejection_statement) :: if fact.decision == {
        .Eligible -> ("accepted", StatusValue.from(fact.rule.as_str()), StatusValue.Null, StatusValue.Null)
        .Rejected(reason) -> ("rejected", StatusValue.Null, StatusValue.from(reason.as_str()), StatusValue.from(acceleration_rejection_statement(reason)))
    }
    lane_width :: fact.lane_width.map((lane) -> StatusValue.from(UInt64.from(lane))).unwrap_or(StatusValue.Null)
    StatusValue.object(StatusFields.new().with("function", function).with("loop_header", fact.loop_header.0)
        .with("span", acceleration_span_value(fact.span.start, fact.span.end)).with("rule", fact.rule.as_str())
        .with("accepted_rule", accepted_rule).with("layout", fact.layout.as_str()).with("packed", fact.packed)
        .with("lane_width", lane_width).with("access_count", fact.accesses.len()).with("no_aliasing", fact.no_aliasing)
        .with("no_early_exit", fact.no_early_exit).with("effect_free_body", fact.effect_free_body)
        .with("no_cross_iteration_dependencies", fact.no_cross_iteration_dependencies)
        .with("decision", decision).with("rejection_code", rejection_code).with("rejection_statement", rejection_statement))
}

// Rust: Source/CmdInspect.rs:3167
fn acceleration_cross_mode_parity(fact: MirAccelerationFact, vector: MirVectorFact?) -> Bool {
    if vector == None -> return false
    row :: vector.unwrap()
    row.no_aliasing && row.no_early_exit && row.effect_free_body
        && row.no_cross_iteration_dependencies && fact.proof.proves(fact.transform)
}

// Rust: Source/CmdInspect.rs:3181
fn acceleration_gate_value(function: String, fact: MirAccelerationFact, loop_fact: MirLoopFact?,
    vector: MirVectorFact?, gate: AccelerationGate, release_build: Bool, runtime: AccelerationRuntimeReceipt?) -> StatusValue {
    cross_mode_parity_proven :: acceleration_cross_mode_parity(fact, vector)
    trip_count :: loop_fact.and_then((loop_fact) -> loop_fact.trip_count)
    items :: trip_count.and_then((items) -> USize.try_from(items).ok())
    deferred_decision :: items.map((items) -> {
        input := AccelerationGateInput.deferred()
        input.items = items
        input.release_build = release_build
        input.cross_mode_parity_proven = cross_mode_parity_proven
        fact.evaluate(gate, input)
    })
    runtime_decision :: runtime.map((runtime) -> runtime.row.decision)
    gate_status :: runtime_decision.map((decision) -> decision.status.as_str())
        .or_else(() -> deferred_decision.map((decision) -> decision.status.as_str())).unwrap_or("runtime-profile-required")
    selected :: runtime_decision.map((decision) -> decision.selected())
        .or_else(() -> deferred_decision.map((decision) -> decision.selected())).unwrap_or(false)
    gate_statement :: acceleration_gate_statement(runtime_decision.map((decision) -> decision.status)
        .or_else(() -> deferred_decision.map((decision) -> decision.status)))
    trip_count_value :: trip_count.map(StatusValue.from).unwrap_or(StatusValue.Null)
    runtime_profile :: if runtime != None -> "receipt" else -> "not-published"
    measurement_source :: if runtime != None -> "receipt" else -> "none"
    measurement :: runtime_decision.map((decision) -> acceleration_runtime_measurement_value(decision.measurement)).unwrap_or(StatusValue.Null)
    StatusValue.object(StatusFields.new().with("function", function).with("loop_header", fact.loop_header.0)
        .with("span", acceleration_span_value(fact.span.start, fact.span.end)).with("transform", fact.transform.as_str())
        .with("workload", acceleration_workload_value(fact.workload)).with("proof", acceleration_proof_value(fact.proof))
        .with("trip_count", trip_count_value).with("release_build", release_build)
        .with("cross_mode_parity_proven", cross_mode_parity_proven).with("gate_status", gate_status)
        .with("rejection_statement", gate_statement).with("selected", selected).with("runtime_profile", runtime_profile)
        .with("measurement_source", measurement_source).with("measurement", measurement)
        .with("gate", StatusValue.object(StatusFields.new().with("static_floor_items", D_ACCEL_STATIC_FLOOR_ITEMS)
            .with("cache_block_bytes", D_ACCEL_CACHE_BLOCK_BYTES).with("required_gain_numerator", D_ACCEL_REQUIRED_GAIN_NUMERATOR)
            .with("required_gain_denominator", D_ACCEL_REQUIRED_GAIN_DENOMINATOR))))
}

use jet.CLI.InspectRequest
use jet.Policy.GateSet
use jet_foundation.MIR.[MirDecisionRow, MirDecisionKind]
use jet.CmdCompile.resolve_named_profile
use jet.lower_checked_semantic_mir_program_for

// Rust: Source/CmdInspect.rs:3270
fn run_accel(request: InspectRequest, mode: OutputMode, gates: GateSet,
    profile: String, setting_overrides: [String:String]) -> {
    file :: inspect_entry_path(request.scope)
    inspect_scope :: if request.scope == {
        .Package -> CheckScope.Project
        .Target(target) -> if OSPath.new(target).is_dir() -> CheckScope.Project else -> CheckScope.ExplicitFile
        .Live(_) -> CheckScope.Project
        .Replay(_) -> CheckScope.Project
    }
    selected_target :: if request.scope == { .Target(target) -> Some(target); _ -> None }
    path :: OSPath.new(file)
    projection :: check_projection_for_command(path, gates, profile, setting_overrides, inspect_scope, None, selected_target)
        .unwrap_or_else((diagnostics) -> render_check_failure(path, diagnostics, mode.json, mode.color_stderr()))
    build_profile :: resolve_named_profile(profile, file, mode)
    release_build :: build_profile.is_release()
    build_mode :: if release_build -> MirArtifactBuildMode.Release else -> MirArtifactBuildMode.Dev
    (mir, _) :: lower_checked_semantic_mir_program_for(projection.bundle,
        MirArtifactRequest.new(MirArtifactTarget.RustAot, MirArtifactKind.NativeExecutable, build_mode))
    gate :: AccelerationGate.d_accel1()
    runtime_receipts :: acceleration_runtime_receipt(request.scope, file, profile)
    runtime_profile :: if runtime_receipts.is_empty() -> "not-published" else -> "receipt"
    measurement_source :: if runtime_receipts.is_empty() -> "none" else -> "receipt"
    runtime_rows :: runtime_receipts.iter().map(acceleration_runtime_value).collect()
    functions := mir.functions.iter().collect()
    functions.sort_by((left, right) -> left.key.cmp(right.key))
    vector_rows := [StatusValue]{}
    acceleration_rows := [StatusValue]{}
    text := String.new()
    text.push_str("accel: scope={acceleration_scope_name(request.scope)} source={file} profile={profile} release_build={release_build} runtime_profile={runtime_profile}\n")
    text.push_str("gate: static_floor_items={D_ACCEL_STATIC_FLOOR_ITEMS} cache_block_bytes={D_ACCEL_CACHE_BLOCK_BYTES} required_gain={D_ACCEL_REQUIRED_GAIN_NUMERATOR}/{D_ACCEL_REQUIRED_GAIN_DENOMINATOR} measurement_source={measurement_source}\n")
    loop runtime in runtime_receipts {
        decision :: runtime.row.decision
        measurement :: decision.measurement
        projected :: measurement.projected_serial_nanos.map((value) -> value.to_string()).unwrap_or("null")
        required :: measurement.required_serial_nanos.map((value) -> value.to_string()).unwrap_or("null")
        text.push_str("runtime acceleration verb={runtime.receipt_verb} receipt={runtime.receipt_digest} sequence={runtime.row.sequence} function={runtime.row.function} loop={runtime.row.loop_header} source={runtime.row.source_start}-{runtime.row.source_end} transform={decision.transform.as_str()} status={decision.status.as_str()} selected={decision.selected()} items={measurement.items} sample_items={measurement.sample_items} sample_nanos={measurement.sample_nanos} spawn_nanos={measurement.spawn_nanos} bandwidth_floor_nanos={measurement.bandwidth_floor_nanos} floor_nanos={measurement.floor_nanos} projected_serial_nanos={projected} required_serial_nanos={required}\n")
    }
    if runtime_receipts.is_empty() -> text.push_str("runtime profile: no matching authenticated receipt.\n")
    loop function in functions {
        loop vector in function.optimization.vector_facts {
            vector_rows.push(acceleration_vector_value(function.key, vector))
            if vector.decision == {
                .Eligible -> text.push_str("vector {function.key} loop={vector.loop_header.0} span={vector.span.start}-{vector.span.end} rule={vector.rule.as_str()} accepted\n")
                .Rejected(reason) -> text.push_str("vector {function.key} loop={vector.loop_header.0} span={vector.span.start}-{vector.span.end} rule={vector.rule.as_str()} rejected: {acceleration_rejection_statement(reason)} ({reason.as_str()})\n")
            }
        }
        loop acceleration in function.optimization.acceleration_facts {
            loop_fact :: function.optimization.loop_facts.iter().find((candidate) -> candidate.header == acceleration.loop_header)
            vector :: function.optimization.vector_facts.iter().find((candidate) -> candidate.loop_header == acceleration.loop_header)
            runtime :: runtime_receipts.iter().find((runtime) ->
                runtime.row.function == function.key && UInt64.from(runtime.row.loop_header) == acceleration.loop_header.0
                && runtime.row.source_start == acceleration.span.start && runtime.row.source_end == acceleration.span.end)
            acceleration_rows.push(acceleration_gate_value(function.key, acceleration, loop_fact, vector, gate, release_build, runtime))
            trip_count :: loop_fact.and_then((loop_fact) -> loop_fact.trip_count).map((items) -> items.to_string()).unwrap_or("unknown")
            items :: loop_fact.and_then((loop_fact) -> loop_fact.trip_count).and_then((items) -> USize.try_from(items).ok())
            deferred_status :: items.map((items) -> {
                input := AccelerationGateInput.deferred()
                input.items = items
                input.release_build = release_build
                input.cross_mode_parity_proven = acceleration_cross_mode_parity(acceleration, vector)
                acceleration.evaluate(gate, input).status
            })
            gate_status :: runtime.map((runtime) -> runtime.row.decision.status).or(deferred_status)
            status :: gate_status.map((status) -> status.as_str()).unwrap_or("runtime-profile-required")
            gate_statement :: acceleration_gate_statement(gate_status)
            selected :: runtime.map((runtime) -> runtime.row.decision.selected())
                .or_else(() -> deferred_status.map((status) -> status.is_selected())).unwrap_or(false)
            row_measurement_source :: if runtime != None -> "receipt" else -> "none"
            text.push_str("acceleration {function.key} loop={acceleration.loop_header.0} span={acceleration.span.start}-{acceleration.span.end} transform={acceleration.transform.as_str()} status={status} reason={gate_statement} trip_count={trip_count} selected={selected} measurement_source={row_measurement_source}\n")
        }
    }
    if vector_rows.is_empty() -> text.push_str("No vector facts declared.\n")
    if acceleration_rows.is_empty() -> text.push_str("No acceleration facts declared.\n")
    if mode.json {
        payload :: render_status("inspect.accel", true, StatusFields.new()
            .with("scope", acceleration_scope_name(request.scope)).with("source", file)
            .with("profile", profile).with("release_build", release_build)
            .with("runtime_profile", runtime_profile).with("measurement_source", measurement_source)
            .with("vectors", StatusValue.array(vector_rows)).with("decisions", StatusValue.array(acceleration_rows))
            .with("runtime_decisions", StatusValue.array(runtime_rows))
            .with("gate", StatusValue.object(StatusFields.new().with("static_floor_items", D_ACCEL_STATIC_FLOOR_ITEMS)
                .with("cache_block_bytes", D_ACCEL_CACHE_BLOCK_BYTES).with("required_gain_numerator", D_ACCEL_REQUIRED_GAIN_NUMERATOR)
                .with("required_gain_denominator", D_ACCEL_REQUIRED_GAIN_DENOMINATOR))))
        println("{payload}")
    } else -> print("{text}")
}

// Rust: Source/CmdInspect.rs:3538
fn decision_row_value(row: MirDecisionRow) -> StatusValue {
    identity :: row.identity.map((identity) -> StatusValue.object(StatusFields.new()
        .with("source", identity.source).with("configuration", identity.configuration)
        .with("profile", identity.profile).with("target", identity.target)
        .with("implementation", identity.implementation).with("artifact", identity.artifact).with("run", identity.run)))
        .unwrap_or(StatusValue.Null)
    StatusValue.object(StatusFields.new().with("id", row.id).with("kind", row.kind.as_str())
        .with("disposition", row.disposition.as_str())
        .with("function_id", row.function.map((function) -> StatusValue.from(function.0)).unwrap_or(StatusValue.Null))
        .with("function", if row.function_name.is_empty() -> StatusValue.Null else -> StatusValue.from(row.function_name))
        .with("span", acceleration_span_value(row.span.start, row.span.end))
        .with("rule", row.rule).with("reason", row.reason).with("producer", row.producer).with("evidence", row.evidence)
        .with("evidence_method", row.evidence_method.map((method) -> StatusValue.from(method.as_str())).unwrap_or(StatusValue.Null))
        .with("derivation_disposition", row.derivation_disposition.map((disposition) -> StatusValue.from(disposition.as_str())).unwrap_or(StatusValue.Null))
        .with("derivation_ref", row.derivation.map((reference) -> StatusValue.from(reference.id)).unwrap_or(StatusValue.Null))
        .with("identity", identity)
        .with("edit", row.edit.map((edit) -> StatusValue.object(StatusFields.new()
            .with("span", acceleration_span_value(edit.span.start, edit.span.end)).with("replacement", edit.replacement)))
            .unwrap_or(StatusValue.Null)))
}

// Rust: Source/CmdInspect.rs:3621
fn decision_kind_status_value(rows: [MirDecisionRow]) -> StatusValue {
    kinds :: [MirDecisionKind.Tier, MirDecisionKind.Inline, MirDecisionKind.Vectorize, MirDecisionKind.Parallel,
        MirDecisionKind.Copy, MirDecisionKind.Bounds, MirDecisionKind.Deopt, MirDecisionKind.Unreachable, MirDecisionKind.LoopInvariant]
    fields := StatusFields.new()
    loop kind in kinds {
        count :: rows.iter().filter((row) -> row.kind == kind).count()
        fields = fields.with(kind.as_str(), StatusValue.object(StatusFields.new()
            .with("status", if count == 0 -> "not-applicable" else -> "present").with("rows", count)))
    }
    StatusValue.object(fields)
}

// Rust: Source/CmdInspect.rs:3655
fn canonical_pass_status_value(record: jet_foundation.CanonicalPass.Record) -> StatusValue {
    // Rust: Source/CmdInspect.rs:3656
    fn snapshot(value: String) -> StatusValue {
        StatusValue.parse(value).unwrap_or_else((_) -> StatusValue.String(value))
    }
    StatusValue.object(StatusFields.new().with("schema", jet_foundation.CanonicalPass.SCHEMA)
        .with("protocol", jet_foundation.CanonicalPass.PROTOCOL).with("stage", record.stage)
        .with("operation_id", record.operation_id).with("occurrence", record.occurrence).with("order", record.order)
        .with("source", StatusValue.object(StatusFields.new().with("path", record.source)
            .with("process", core.env.var("JET_ADAPTER_CANONICAL_PASS_PROCESS").unwrap_or("inspect"))))
        .with("input", StatusValue.object(StatusFields.new().with("representation", record.input_representation)
            .with("canonical_payload", snapshot(record.input_payload)).with("identity", snapshot(record.input_identity))))
        .with("output", StatusValue.object(StatusFields.new().with("representation", record.output_representation)
            .with("canonical_payload", snapshot(record.output_payload)).with("identity", snapshot(record.output_identity))))
        .with("premises", StatusValue.array(record.premises.iter().map((premise) -> StatusValue.from(premise))))
        .with("disposition", record.disposition))
}

use jet.CLI.InspectPlane
use jet_foundation.Registry

// Rust: Source/CmdInspect.rs:3710
fn run_decisions(request: InspectRequest, mode: OutputMode, gates: GateSet,
    profile: String, setting_overrides: [String:String]) -> {
    file :: inspect_entry_path(request.scope)
    inspect_scope :: if request.scope == {
        .Package -> CheckScope.Project
        .Target(target) -> if OSPath.new(target).is_dir() -> CheckScope.Project else -> CheckScope.ExplicitFile
        .Live(_) -> CheckScope.Project
        .Replay(_) -> CheckScope.Project
    }
    jet_foundation.CanonicalPass.clear()
    selected_target :: if request.scope == { .Target(target) -> Some(target); _ -> None }
    projection :: check_projection_for_command(OSPath.new(file), gates, profile, setting_overrides, inspect_scope, None, selected_target)
        .unwrap_or_else((diagnostics) -> render_check_failure(OSPath.new(file), diagnostics, mode.json, mode.color_stderr()))
    (mir, artifact) :: lower_checked_semantic_mir_program_for(projection.bundle,
        MirArtifactRequest.new(MirArtifactTarget.RustAot, MirArtifactKind.NativeExecutable, MirArtifactBuildMode.Dev))
    additional_rows := projection.diagnostics.iter().filter_map((diagnostic) -> diagnostic.decision_row).collect()
    additional_rows.extend(jet_jit.plan_mir_tiers(mir, artifact).decision_ledger_rows(mir))
    ledger :: jet_foundation.MIROptimization.decision_ledger(mir, Some(artifact), profile, "not-observed", additional_rows)
    rows :: ledger.rows
    canonical_passes :: jet_foundation.CanonicalPass.take().iter().map(canonical_pass_status_value).collect()
    if mode.json {
        payload :: render_status("inspect.decisions", true, StatusFields.new()
            .with("scope", acceleration_scope_name(request.scope)).with("source", file).with("profile", profile)
            .with("rows", StatusValue.array(rows.iter().map(decision_row_value)))
            .with("kinds", decision_kind_status_value(rows)).with("canonical_routes", StatusValue.array(canonical_passes))
            .with("record_status", "current").with("retention", "bounded").with("redaction", "none"))
        println("{payload}")
        return
    }
    text := String.new()
    text.push_str("decisions: scope={acceleration_scope_name(request.scope)} source={file} profile={profile} record_status=current retention=bounded redaction=none\n")
    loop row in rows {
        function :: if row.function_name.is_empty() -> "<package>" else -> row.function_name
        method :: row.evidence_method.map((method) -> method.as_str()).unwrap_or("unavailable")
        derivation_disposition :: row.derivation_disposition.map((disposition) -> disposition.as_str()).unwrap_or("unknown")
        derivation_ref :: row.derivation.map((reference) -> reference.id).unwrap_or("unavailable")
        identity :: row.identity.map((identity) ->
            "source={identity.source} configuration={identity.configuration} profile={identity.profile} target={identity.target} implementation={identity.implementation} artifact={identity.artifact} run={identity.run}")
            .unwrap_or("identity=unavailable")
        text.push_str("decision id={row.id} kind={row.kind.as_str()} disposition={row.disposition.as_str()} derivation_disposition={derivation_disposition} function={function} span={row.span.start}-{row.span.end} rule={row.rule} reason={row.reason} producer={row.producer} evidence={row.evidence} method={method} derivation_ref={derivation_ref} {identity}\n")
    }
    loop kind in [MirDecisionKind.Tier, MirDecisionKind.Inline, MirDecisionKind.Vectorize,
        MirDecisionKind.Parallel, MirDecisionKind.Copy, MirDecisionKind.Bounds, MirDecisionKind.Deopt,
        MirDecisionKind.Unreachable, MirDecisionKind.LoopInvariant] {
        present :: rows.iter().any((row) -> row.kind == kind)
        state :: if present -> "present" else -> "not-applicable"
        text.push_str("kind {kind.as_str()}: {state}\n")
    }
    print("{text}")
}

// Rust: Source/CmdInspect.rs:3881
// Dispatch the parser-owned grammar to its existing typed projection.
pub fn run_inspect(request: InspectRequest, mode: OutputMode, gates: GateSet,
    profile: String, setting_overrides: [String:String], no_os: Bool) -> {
    if request.plane == InspectPlane.Decisions {
        if request.scope == {
            .Live(pid) -> run_inspect_live(request.plane, pid, mode)
            .Replay(artifact) -> run_inspect_replay(request.plane, artifact, profile, setting_overrides, mode)
            .Package -> run_decisions(request, mode, gates, profile, setting_overrides)
            .Target(_) -> run_decisions(request, mode, gates, profile, setting_overrides)
        }
        return
    }
    if request.plane == InspectPlane.Accel {
        run_accel(request, mode, gates, profile, setting_overrides)
        return
    }
    if request.scope == {
        .Live(pid) -> { run_inspect_live(request.plane, pid, mode); return }
        .Replay(artifact) -> { run_inspect_replay(request.plane, artifact, profile, setting_overrides, mode); return }
        .Package -> {}
        .Target(_) -> {}
    }
    if request.plane == InspectPlane.Build && request.options.iter().any((option) ->
        option == "--coverage" || option.starts_with("--coverage=")) {
        run_build_coverage(mode)
        return
    }
    file :: inspect_entry_path(request.scope)
    args := [file]
    args.extend(request.options)
    if request.plane == {
        .Decisions -> run_decisions(request, mode, gates, profile, setting_overrides)
        .Types -> run_types(args, mode.json)
        .Shapes -> run_shapes(args, mode.json)
        .Accel -> panic("accel inspect is routed before live/replay dispatch")
        .Rights -> {
            inspect_scope :: if request.scope == {
                .Package -> CheckScope.Project
                .Target(target) -> if OSPath.new(target).is_dir() -> CheckScope.Project else -> CheckScope.ExplicitFile
                _ -> panic("live and replay inspect scopes returned above")
            }
            selected_target :: if request.scope == { .Target(target) -> Some(target); _ -> None }
            projection :: check_projection_for_command(OSPath.new(file), gates, profile, setting_overrides, inspect_scope, None, selected_target)
                .unwrap_or_else((diagnostics) -> render_check_failure(OSPath.new(file), diagnostics, mode.json, mode.color_stderr()))
            run_rights(projection, inspect_scope, file, mode.json)
        }
        .Claims -> run_claims(args[0], mode.json)
        .Structure -> jet.CmdStructure.run_structure(args, mode.json, mode.color_stderr(), gates)
        .Build -> {
            query_args :: args.iter().collect()
            jet.CmdCompile.run_build_query("graph", query_args, mode)
        }
        .Gates -> jet.CmdGates.run(args, mode.json, mode.color_stderr(), gates, false)
    }
    _ :: (profile, no_os)
}

// Rust: Source/CmdInspect.rs:3994
fn coverage_fact_value(fact: jet_foundation.Coverage.CoverageFact) -> StatusValue {
    StatusValue.object(StatusFields.new().with("plane", fact.plane).with("rows", fact.rows)
        .with("edit_covered", fact.edit_covered).with("reason_covered", fact.reason_covered)
        .with("behavior_reasons", fact.behavior_reasons).with("design_reasons", fact.design_reasons)
        .with("ambiguous_reasons", fact.ambiguous_reasons).with("uncovered", fact.uncovered))
}

// Rust: Source/CmdInspect.rs:4008
fn run_build_coverage(mode: OutputMode) -> {
    entries :: Registry.diagnostic_coverage_entries()
    facts :: jet_foundation.Coverage.try_facts(entries).expect("registered diagnostic coverage rows must be valid")
    validation :: Registry.validate_diagnostic_coverage(entries)
    if mode.json {
        ok :: validation.is_ok()
        coverage :: StatusValue.array(facts.iter().map(coverage_fact_value))
        fields := StatusFields.new().with("coverage", coverage)
        if validation == .Err(error) -> fields = fields.with("validation_error", error)
        println("{render_status(\"inspect.build\", ok, fields)}")
        return
    }
    println("diagnostic coverage")
    println("plane\trows\twith fix_edits\twith reason\tuncovered\tstate")
    loop fact in facts {
        state :: if fact.is_closed() -> "closed" else -> "open"
        println("{fact.plane}\t{fact.rows}\t{fact.edit_covered}\t{fact.reason_covered}\t{fact.uncovered}\t{state}")
    }
    if validation == .Err(error) -> println("coverage validation error: {error}")
}

