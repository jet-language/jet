// Rust: Source/CmdFill.rs:1
// Typed-goal reports and checked candidate proposals for jet check / jet fill.
use core.files as fs
use jet.Diagnostics.[Span]
use jet.AST.[Expr, Func, Item, ProgramBundle]
use jet.Sema.[SemIndexEffectFacts, show_set]
use jet.Driver
use jet_foundation.Report.[StatusEnvelope, StatusFields, StatusValue]
use jet_cli.[OutputMode]
use jet_cli.CmdInspect.[CheckProjection, check_projection_for_effects, render_check_failure]

// Rust: Source/CmdFill.rs:13
struct FunctionInfo {
    name: String
    return_type: String
}

// Rust: Source/CmdFill.rs:19
struct GoalSite {
    file: String
    source: String
    line: UInt
    function: String
    span: Span
    expected_type: String
    required_effects: String
    params: [(String, String)]
    functions: [FunctionInfo]
}

// Rust: Source/CmdFill.rs:33
// A :line suffix filters the report only; the whole file is checked first.
pub fn run_fill(target: String, mode: OutputMode) -> {
    (file, line) :: split_target(target)
    path :: OSPath.new(file)
    environment: [String:String] = [:]
    checked := if check_projection_for_effects(path, "dev", &environment) == {
        .Ok(checked) -> checked
        .Err(diagnostics) -> render_check_failure(path, &diagnostics, mode.json, mode.color_stderr())
    }
    report :: render_goal_report(&checked, Some(path), line, true, mode.json)
    if report == {
        .Some(report) -> println("{report}")
        .None if mode.json -> println("{StatusEnvelope.new(\"fill\", true).with_field(\"fill\", StatusValue.object(StatusFields.new().with(\"goals\", StatusValue.array([])))).json()}")
        .None -> println("no goals found in '{file}'")
    }
}

// Rust: Source/CmdFill.rs:70
pub fn render_goal_report(checked: &CheckProjection, file_filter: OSPath?, line_filter: UInt?, include_candidates: Bool, json: Bool) -> String? {
    goals := collect_goals(&checked.bundle, &checked.facts)
    if file_filter == .Some(path) -> goals.retain(goal -> same_file(goal.file, path))
    if line_filter == .Some(line) -> goals.retain(goal -> goal.line == line)
    if goals.is_empty() -> return None
    out := ""
    if json -> {
        fill :: StatusValue.object(StatusFields.new().with("goals", StatusValue.array(goals.iter().map(goal -> {
            candidates :: checked_candidates(goal, include_candidates)
            StatusValue.object(StatusFields.new()
                .with("file", goal.file)
                .with("line", goal.line)
                .with("function", goal.function)
                .with("expected_type", goal.expected_type)
                .with("required_effects", goal.required_effects)
                .with("candidates", StatusValue.array(candidates.iter().map(candidate -> StatusValue.from(candidate)))))
        }))))
        return Some(StatusEnvelope.new("fill", true).with_field("fill", fill).json())
    }
    loop goal in &goals {
        out.push_str("goal: {goal.file}:{goal.line} ({goal.function})\n")
        out.push_str("  expected type: {goal.expected_type}\n")
        out.push_str("  required effects: {goal.required_effects}\n")
        if include_candidates -> {
            candidates :: checked_candidates(goal, true)
            if candidates.is_empty() -> {
                out.push_str("  candidates: none (no local expression passed the checker)\n")
            } else -> {
                out.push_str("  candidates:\n")
                loop (index, candidate) in candidates.iter().enumerate() {
                    out.push_str("    {index + 1}. {candidate} (checked)\n")
                }
            }
        }
    }
    Some(out)
}

// Rust: Source/CmdFill.rs:144
fn split_target(target: String) -> (String, UInt?) {
    target.rsplit_once(':')
        .and_then((file, line) -> line.parse<UInt>().ok().map(line -> (file, Some(line))))
        .unwrap_or((target, None))
}

// Rust: Source/CmdFill.rs:151
fn same_file(display: String, path: OSPath) -> Bool {
    if display == path.to_string_lossy() -> return true
    if (fs.canonicalize(display), fs.canonicalize(path)) == {
        (.Ok(left), .Ok(right)) -> left == right
        _ -> false
    }
}

// Rust: Source/CmdFill.rs:161
fn collect_goals(bundle: &ProgramBundle, facts: &SemIndexEffectFacts) -> [GoalSite] {
    goals := []
    loop module in &bundle.modules {
        functions := []
        collect_function_infos(&module.items, &functions)
        file :: module.display.clone()
        source :: module.source.clone()
        alias :: module.alias.clone()
        loop item in &module.items {
            collect_item_goals(item, None, file, source, alias, facts, &functions, &goals)
        }
    }
    goals
}

// Rust: Source/CmdFill.rs:181
fn collect_function_infos(items: &[Item], out: &[FunctionInfo]) -> {
    loop item in items {
        if item == {
            .Func(function) -> add_function_info(function, out)
            .Struct(structure) -> {
                loop function in &structure.methods -> add_function_info(function, out)
                loop block in &structure.trait_impls {
                    loop function in &block.methods -> add_function_info(function, out)
                }
            }
            .Enum(enumeration) -> {
                loop function in &enumeration.methods -> add_function_info(function, out)
                loop block in &enumeration.trait_impls {
                    loop function in &block.methods -> add_function_info(function, out)
                }
            }
            .Impl(implementation) -> {
                loop function in &implementation.methods -> add_function_info(function, out)
            }
            _ -> {}
        }
    }
}

// Rust: Source/CmdFill.rs:215
fn add_function_info(function: &Func, out: &[FunctionInfo]) -> {
    if function.params.is_empty() -> {
        if function.return_type == .Some(return_type) -> {
            out.push(FunctionInfo{name: function.name.clone(), return_type: return_type.name()})
        }
    }
}

// Rust: Source/CmdFill.rs:226
fn collect_item_goals(item: &Item, owner: String?, file: String, source: String, alias: String,
    facts: &SemIndexEffectFacts, functions: &[FunctionInfo], out: &[GoalSite]) -> {
    if item == {
        .Func(function) -> collect_function_goals(function, owner, file, source, alias, facts, functions, out)
        .Impl(implementation) -> {
            owner :: implementation.type_name.clone()
            loop function in &implementation.methods {
                collect_function_goals(function, Some(owner), file, source, alias, facts, functions, out)
            }
        }
        .Struct(structure) -> {
            owner :: structure.name.clone()
            loop function in &structure.methods {
                collect_function_goals(function, Some(owner), file, source, alias, facts, functions, out)
            }
            loop block in &structure.trait_impls {
                loop function in &block.methods {
                    collect_function_goals(function, Some(owner), file, source, alias, facts, functions, out)
                }
            }
        }
        .Enum(enumeration) -> {
            owner :: enumeration.name.clone()
            loop function in &enumeration.methods {
                collect_function_goals(function, Some(owner), file, source, alias, facts, functions, out)
            }
            loop block in &enumeration.trait_impls {
                loop function in &block.methods {
                    collect_function_goals(function, Some(owner), file, source, alias, facts, functions, out)
                }
            }
        }
        _ -> {}
    }
}

// Rust: Source/CmdFill.rs:317
fn collect_function_goals(function: &Func, owner: String?, file: String, source: String, alias: String,
    facts: &SemIndexEffectFacts, functions: &[FunctionInfo], out: &[GoalSite]) -> {
    function_name :: owner.map(owner -> "{owner}.{function.name}").unwrap_or_else(() -> function.name.clone())
    params :: function.params.iter().map(param -> (param.name.clone(), param.ty.name())).collect<[(String, String)]>()
    effects :: required_effects(facts, alias, owner, function.name)
    loop statement in &function.body {
        statement.for_each_expr_mut(expr -> {
            if expr == {
                .Todo{span, expected_type} -> {
                    offset :: span.start.min(source.len())
                    out.push(GoalSite{
                        file: file.to_string(), source: source.to_string(),
                        line: source[..offset].bytes().filter(byte -> byte == 10).count() + 1,
                        function: function_name.clone(), span: span,
                        expected_type: expected_type.clone().unwrap_or_else(() -> "(unknown)"),
                        required_effects: effects.clone(), params: params.clone(), functions: functions.to_vec()
                    })
                }
                _ -> {}
            }
        })
    }
}

// Rust: Source/CmdFill.rs:367
fn required_effects(facts: &SemIndexEffectFacts, alias: String, owner: String?, name: String) -> String {
    local_key :: owner.map(owner -> "{owner}::{name}").unwrap_or_else(() -> name.to_string())
    keys :: ["{alias}::{local_key}", local_key, name.to_string()]
    loop key in keys {
        if facts.solved.get(&key) == .Some(effects) -> {
            return if effects.is_empty() -> "none" else -> "[{show_set(effects)}]"
        }
    }
    // Pure rows are omitted from the shared checked reachability projection.
    "none"
}

// Rust: Source/CmdFill.rs:392
fn checked_candidates(goal: &GoalSite, include_candidates: Bool) -> [String] {
    if !include_candidates -> return []
    candidates := []
    loop (name, ty) in &goal.params {
        if ty == goal.expected_type -> candidates.push(name.clone())
    }
    current_name :: goal.function.rsplit('.').next().unwrap_or(goal.function)
    loop function in &goal.functions {
        if function.name != current_name && function.return_type == goal.expected_type -> {
            candidates.push("{function.name}()")
        }
    }
    if goal.expected_type == {
        "Int" -> candidates.push("0")
        "Float" | "F32" -> candidates.push("0.0")
        "Bool" -> candidates.push("false")
        "String" -> candidates.push("\"\"")
        "Char" -> candidates.push("'a'")
        "Unit" | "()" -> candidates.push("()")
        expected if expected.ends_with('?') -> candidates.push("null")
        _ -> {}
    }
    checked := []
    loop candidate in candidates {
        if checked.contains(&candidate) -> next
        if candidate_checks(goal, &candidate) -> checked.push(candidate)
    }
    checked
}

// Rust: Source/CmdFill.rs:432
fn candidate_checks(goal: &GoalSite, candidate: String) -> Bool {
    if goal.span.end > goal.source.len() || goal.span.start > goal.span.end -> return false
    source := goal.source.clone()
    source.replace_range(goal.span.start..goal.span.end, candidate)
    Driver.check_eval(&source, &goal.file).is_empty()
}
