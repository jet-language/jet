// Rust: Source/CmdDoc.rs:14
pub fn run_doc(target: String, mode: OutputMode, check: Bool) -> {
    entry :: OSPath.from(resolve_source_path(target))
    projection :: CmdInspect.check_projection_for_effects(&entry, "dev", &[String:String]{}) ?? {
        source :: fs.read_to_string(&entry).unwrap_or_default()
        if mode.json -> print(jet.render_all_json(&ReportPath.from_path(&entry), source, &err))
        else -> eprint(jet.render_all_colored(entry.display().to_string(), source, &err, mode.color_stderr()))
        exit(ExitCodes.USER_ERROR)
    }
    graph :: build_doc_graph(&projection.bundle, projection.index())
    if check {
        diagnostics :: undocumented_diagnostics(&graph)
        if !diagnostics.is_empty() {
            render_doc_diagnostics(&projection.bundle, &diagnostics, mode)
            exit(ExitCodes.USER_ERROR)
        }
        if mode.json -> println(graph.to_status_envelope().json())
        else -> println("doc check: passed ({graph.doctests.len()} doctest block(s))")
        return
    }
    if mode.json {
        println(graph.to_status_envelope().json())
        return
    }
    output_dir :: entry.parent().filter(|path| -> !path.as_os_str().is_empty()).unwrap_or(OSPath.from(".")).join("docs")
    result :: fs.create_dir_all(&output_dir)
        .and_then(|_| -> fs.write(output_dir.join("index.html"), graph.to_html()))
        .and_then(|_| -> fs.write(output_dir.join("index.md"), graph.to_markdown()))
    result ?? {
        cli_error!("E2105", "couldn't write generated documentation in `{output_dir.display()}`: {err}")
        exit(ExitCodes.USER_ERROR)
    }
    println("doc: generated {output_dir.display()}")
}
// Rust: Source/CmdDoc.rs:84
fn undocumented_diagnostics(graph: &DocGraph) -> [(String, Diagnostic)] {
    graph.undocumented_public().iter().map(|item| -> (
        item.source.path,
        Diagnostic.from_row("L2201", &[("name", item.qualified_name)], Val(Span.new(item.source.start, item.source.end)))
    )).collect()
}
// Rust: Source/CmdDoc.rs:102
fn render_doc_diagnostics(bundle: &ProgramBundle, diagnostics: &[(String, Diagnostic)], mode: OutputMode) -> {
    by_path := [String:[Diagnostic]]{}
    loop (path, diagnostic) in diagnostics -> &by_path.entry(path).or_default().push(diagnostic)
    paths := by_path.keys().collect::<[String]>()
    &paths.sort()
    loop path in paths {
        if bundle.modules.iter().find(|module| -> {
            stable :: module.path.strip_prefix(&bundle.project_root).ok()
                .map_or_else(|| -> module.display.replace('\\', "/"), |relative| -> relative.to_string_lossy().replace('\\', "/"))
            stable == path
        }) == .Val(module) {
            rows :: by_path[path]
            if mode.json -> print(jet.render_all_json(&ReportPath.from_path(&module.path), module.source, &rows))
            else -> eprint(jet.render_all_colored(module.display, module.source, &rows, mode.color_stderr()))
        }
    }
}
// Rust: Source/CmdDossier.rs:12
pub fn run_module_explain(subject: String, file: String, profile: String, json: Bool) -> {
    abs :: absolutize(file)
    module_name :: subject.split('.').next().unwrap_or(subject)
    checked :: CmdInspect.check_projection_with_options(&abs, GateSet.default(), profile, &[String:String]{}) ?? CmdInspect.render_check_failure(&abs, &err, json, false)
    index :: checked.index()
    instance :: index.instances().iter().find(|instance| -> instance.name == module_name || instance.applications.iter().any(|application| -> application.name == module_name)).unwrap_or_else(|| -> {
        cli_error!(@fix "E2104", "generic module `{module_name}` is not present in `{file}`", "pass the instantiated member as `module.member` and the source entry file")
        exit(ExitCodes.USER_ERROR)
    })
    if json {
        arguments :: StatusValue.array(instance.argument_values.iter().zip(instance.argument_provenance.iter()).map(|(value, sources)| -> StatusValue.object(
            StatusFields.new().with("value", value).with("provenance", StatusValue.array(sources.iter().map(StatusValue.from)))
        )))
        generic_module :: StatusValue.object(StatusFields.new().with("subject", subject).with("module", instance.name)
            .with("fingerprint", instance.fingerprint).with("arguments", arguments).with("check", CmdInspect.check_result_value(&checked.check)))
        println(StatusEnvelope.new("inspect.generic_module", true).with_field("generic_module", generic_module).json())
        return
    }
    println("generic module `{subject}`")
    println("  instance: {instance.name}")
    println("  fingerprint: {instance.fingerprint}")
    loop (value, sources) in instance.argument_values.iter().zip(instance.argument_provenance.iter()) {
        println("  argument: {value}")
        loop source in sources -> println("    from: {source}")
    }
    print(CmdInspect.check_result_text(&checked.check))
}
// Rust: Source/CmdImpact.rs:11
pub fn run_impact(args: &[String], json: Bool) -> {
    depth := USize{3}
    positional := [String]{}
    loop arg in args {
        if arg.strip_prefix("--depth=") == .Val(n) {
            depth = n.parse::<USize>() ?? {
                cli_error!("E2104", "`--depth` must be a positive integer")
                exit(ExitCodes.USER_ERROR)
            }
        } else if !arg.starts_with('-') -> &positional.push(arg)
    }
    if positional.len() != 2 {
        cli_error!(@fix "E2104", "`jet inspect impact` needs an entry file and a symbol name", "jet inspect impact Examples/features/effects/effects.jet report")
        exit(ExitCodes.USER_ERROR)
    }
    path :: positional[0]
    symbol :: positional[1]
    if depth == 0 {
        cli_error!("E2104", "`--depth` must be at least 1")
        exit(ExitCodes.USER_ERROR)
    }
    abs :: absolutize(path)
    checked :: CmdInspect.check_projection(&abs) ?? CmdInspect.render_check_failure(&abs, &err, json, false)
    report :: ImpactReport.analyze(checked.index(), symbol, depth)
    if json -> println(StatusEnvelope.new("inspect.impact", report.found).with_field("impact", impact_value(&report, &checked.check)).json())
    else {
        print(CmdInspect.check_result_text(&checked.check))
        print(report.render_text())
    }
    if !report.found -> exit(ExitCodes.USER_ERROR)
}
// Rust: Source/CmdImpact.rs:60
fn impact_value(report: &ImpactReport, check: &CheckResult) -> StatusValue {
    span :: |start: USize, end: USize| -> StatusValue.object(StatusFields.new().with("start", start).with("end", end))
    reference :: |value: &ImpactRef| -> StatusValue.object(StatusFields.new().with("depth", value.depth).with("name", value.name)
        .with("module_path", value.module_path).with("span", span(value.span_start, value.span_end)))
    edge :: |value: &ImpactEdge| -> StatusValue.object(StatusFields.new().with("depth", value.depth).with("caller", value.caller)
        .with("callee", value.callee).with("module_path", value.module_path).with("span", span(value.span_start, value.span_end)))
    StatusValue.object(StatusFields.new().with("symbol", report.symbol).with("found", report.found).with("depth_limit", report.depth_limit)
        .with("definition_module", report.definition_module.map(StatusValue.from).unwrap_or(StatusValue.Null))
        .with("references", StatusValue.array(report.references.iter().map(reference)))
        .with("call_sites", StatusValue.array(report.call_sites.iter().map(edge)))
        .with("upstream_callers", StatusValue.array(report.upstream_callers.iter().map(edge)))
        .with("downstream_callees", StatusValue.array(report.downstream_callees.iter().map(edge)))
        .with("check", CmdInspect.check_result_value(check)))
}
