// Rust: Source/CmdPkg.rs:12
struct PackageInput { path: OSPath, raw: String, inline: InlinePackageBlock?, manifest: Manifest }
// Rust: Source/CmdPkg.rs:19
fn package_input(root: &OSPath) -> PackageInput {
    entry :: find_project_entry(root)
    entry_raw :: fs.read_to_string(&entry) ?? {
        cli_error!("E2105", "couldn't read {entry.display()}: {err}")
        exit(ExitCodes.USER_ERROR)
    }
    inline :: jet.Package.extract_inline_package(entry_raw) ?? {
        eprint(jet.render_diagnostics(entry.display().to_string(), entry_raw, &[err.diagnostic()]))
        exit(ExitCodes.USER_ERROR)
    }
    facts_option :: jet.Loader.package_facts_for_entry(&entry) ?? {
        eprint(jet.render_diagnostics(entry.display().to_string(), entry_raw, &err))
        exit(ExitCodes.USER_ERROR)
    }
    facts :: facts_option.unwrap_or_else(|| -> {
        cli_error!("E2105", "couldn't resolve package facts for {entry.display()}")
        exit(ExitCodes.USER_ERROR)
    })
    if inline == .Val(block) {
        raw :: block.body(entry_raw).to_string()
        manifest :: jet.Package.to_manifest(&facts, raw) ?? {
            eprint(jet.render_diagnostics(entry.display().to_string(), raw, &[err]))
            exit(ExitCodes.USER_ERROR)
        }
        return PackageInput{path: entry, raw: entry_raw, inline: Val(block), manifest: manifest}
    }
    path :: jet.Loader.manifest_path(root).unwrap_or_else(|| -> {
        cli_error!("E2105", "couldn't locate {jet.Syntax.PACKAGE_FILE}")
        exit(ExitCodes.USER_ERROR)
    })
    raw :: fs.read_to_string(&path) ?? {
        cli_error!("E2105", "couldn't read {path.display()}: {err}")
        exit(ExitCodes.USER_ERROR)
    }
    manifest :: jet.Package.to_manifest(&facts, raw) ?? {
        eprint(jet.render_diagnostics(path.display().to_string(), raw, &[err]))
        exit(ExitCodes.USER_ERROR)
    }
    PackageInput{path: path, raw: raw, inline: None, manifest: manifest}
}
// Rust: Source/CmdPkg.rs:95
fn edited_package_source(input: &PackageInput, updated_body: fn(String) -> String) -> String {
    if input.inline == .Val(block) {
        source := input.raw.clone()
        updated :: updated_body(block.body(input.raw))
        &source.replace_range(block.body_span.start..<block.body_span.end, updated)
        return source
    }
    updated_body(input.raw)
}
// Rust: Source/CmdPkg.rs:107
fn write_package_source(input: &PackageInput, updated: String) -> Unit Err! {
    parent :: input.path.parent().ok_or("package source has no parent directory")?
    name :: input.path.file_name().ok_or("package source has no file name")?
    resolver :: jet.Authority.AuthorityResolver.open(&parent) ?? return Err("could not open package source authority: {err}")
    checked :: resolver.checked_file(&OSPath.from(name)) ?? return Err("could not check {input.path.display()}: {err}")
    current :: checked.text() ?? return Err("could not read {input.path.display()}: {err}")
    if current != input.raw -> return Err("{input.path.display()} changed while the package edit was prepared")
    resolver.revalidate_file(&checked) ?? return Err("package source changed before writing: {err}")
    nonce :: (SystemTime.now().duration_since(UNIX_EPOCH) ?? return Err("could not create package edit nonce: {err}")).as_nanos()
    temporary :: parent.join(".{name.to_string_lossy()}.jet-package-edit-{id()}-{nonce}")
    stage :: || -> {
        file := fs.OpenOptions.new().write(true).create_new(true).open(&temporary) ?? return Err("could not stage {input.path.display()}: {err}")
        file.write_all(updated.bytes()) ?? return Err("could not stage {input.path.display()}: {err}")
        file.sync_all() ?? return Err("could not sync {input.path.display()}: {err}")
        resolver.revalidate_file(&checked) ?? return Err("package source changed before publishing: {err}")
        fs.rename(&temporary, &input.path) ?? return Err("could not publish {input.path.display()}: {err}")
        Ok(())
    }
    result :: stage()
    if result.is_err() -> _ :: fs.remove_file(&temporary)
    result
}
// Rust: Source/CmdPkg.rs:165
pub fn run_add(raw_args: &[String]) -> {
    cwd :: std.env.current_dir().unwrap_or(OSPath.from("."))
    root :: require_manifest_root(&cwd, "error: no package.jet found — run `jet add` inside a project\n fix: run `jet new <name>` to create a project first")
    non_flag :: raw_args.iter().filter(|arg| -> !arg.starts_with("--")).collect::<[String]>()
    dep_name :: non_flag.get(1).unwrap_or_else(|| -> {
        cli_error!(@fix "E2104", "`jet add` needs a dependency name", "try `jet add mylib --path ../mylib`")
        exit(ExitCodes.USER_ERROR)
    })
    path_val :: flag_value(raw_args, "--path")
    git_val :: flag_value(raw_args, "--git")
    tag_val :: flag_value(raw_args, "--tag")
    branch_val :: flag_value(raw_args, "--branch")
    rev_val :: flag_value(raw_args, "--rev")
    spec :: if path_val == .Val(path) -> DepSpec.Path{path: path}
    else if git_val == .Val(url) {
        selector :: if tag_val == .Val(tag) -> GitSelector.Tag(tag)
        else if branch_val == .Val(branch) -> GitSelector.Branch(branch)
        else if rev_val == .Val(rev) -> GitSelector.Rev(rev)
        else {
            cli_error!("E2104", "git dependency `{dep_name}` needs one of: --tag, --branch, --rev")
            exit(ExitCodes.USER_ERROR)
        }
        DepSpec.Git{url: url, selector: selector}
    } else {
        cli_error!(@fix "E2104", "`jet add {dep_name}` needs --path or --git", "try `jet add {dep_name} --path ../{dep_name}` or `jet add {dep_name} --git <url> --tag <tag>`")
        exit(ExitCodes.USER_ERROR)
    }
    input :: package_input(&root)
    updated :: edited_package_source(&input, |raw| -> jet.Manifest.add_dependency(raw, dep_name, &spec))
    write_package_source(&input, updated) ?? {
        cli_error!("E2105", "couldn't write {input.path.display()}: {err}")
        exit(ExitCodes.USER_ERROR)
    }
    println("added `{dep_name}` to {input.path.display()}")
    do_fetch(&root, false)
}
// Rust: Source/CmdPkg.rs:230
pub fn run_remove(dep_name: String) -> {
    cwd :: std.env.current_dir().unwrap_or(OSPath.from("."))
    root :: require_manifest_root(&cwd, "error: no package.jet found")
    input :: package_input(&root)
    if !input.manifest.dependencies.contains_key(dep_name) {
        cli_error!(@fix "E2104", "dependency `{dep_name}` is not present in {jet.Syntax.PACKAGE_FILE}", "remove a dependency listed in {jet.Syntax.PACKAGE_FILE}, or add `{dep_name}` first")
        exit(ExitCodes.USER_ERROR)
    }
    updated :: edited_package_source(&input, |raw| -> jet.Manifest.remove_dependency(raw, dep_name))
    write_package_source(&input, updated) ?? {
        cli_error!("E2105", "couldn't write {input.path.display()}: {err}")
        exit(ExitCodes.USER_ERROR)
    }
    println("removed `{dep_name}` from {input.path.display()}")
    do_fetch(&root, false)
}
// Rust: Source/CmdPkg.rs:255
pub fn run_fetch(locked: Bool) -> {
    cwd :: std.env.current_dir().unwrap_or(OSPath.from("."))
    root :: require_manifest_root(&cwd, "error: no package.jet found — run `jet fetch` inside a project")
    do_fetch(&root, locked)
}
// Rust: Source/CmdPkg.rs:264
pub fn run_update(dep: String?) -> {
    cwd :: std.env.current_dir().unwrap_or(OSPath.from("."))
    root :: require_manifest_root(&cwd, "error: no package.jet found")
    input :: package_input(&root)
    existing_lock :: jet.Lock.load(&root)
    opts :: jet.Fetch.FetchOptions{locked: false, update: true, update_dep: dep, resolution: jet.Publish.ResolveMode.Conservative}
    (lock, _) :: jet.Fetch.fetch(&root, &input.manifest, existing_lock, &opts) ?? {
        eprint(jet.render_diagnostics(input.path.display().to_string(), input.raw, &err))
        exit(ExitCodes.USER_ERROR)
    }
    print_registry_tiers(&lock)
    if dep == .Val(name) -> println("updated `{name}`") else -> println("updated all moving selectors")
}
// Rust: Source/CmdPkg.rs:299
fn do_fetch(root: &OSPath, locked: Bool) -> {
    input :: package_input(root)
    existing_lock :: jet.Lock.load(root)
    opts :: jet.Fetch.FetchOptions{locked: locked, update: false, update_dep: None, resolution: jet.Publish.ResolveMode.Conservative}
    (lock, _) :: jet.Fetch.fetch(root, &input.manifest, existing_lock, &opts) ?? {
        eprint(jet.render_diagnostics(input.path.display().to_string(), input.raw, &err))
        exit(ExitCodes.USER_ERROR)
    }
    print_registry_tiers(&lock)
    if locked -> println("lock verified") else -> println("fetched all dependencies")
}
// Rust: Source/CmdPkg.rs:330
fn print_registry_tiers(lock: &LockFile) -> {
    loop package in lock.packages {
        if package.source == .Registry{registry, tier, gate_status, ..} -> println("resolved `{package.name}` {package.version} from registry `{registry}` (tier: {tier}; gate status: {gate_status})")
    }
}
