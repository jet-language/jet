// Private continuation of canonical Cli.Inspect.Projection.
use core.files as fs
use core.files.path.[OSPath]
use core.sys as env
use jet.[CLI, DevServer, RecordIndex, AST, Diagnostics, ExitCodes]
use jet_foundation.[StatusValue, StatusFields, StatusEnvelope, CanonicalJson]
use jet_foundation.sema.[RightsRow, RightsWalk]
use jet_foundation.Authority.[Holds]
use ProveReplay.[ReplayAuthority, open_named_replay]

// Rust: Source/CmdInspect.rs:4041
fn inspect_entry_path(scope: CLI.InspectScope) -> String {
    if scope == {
        .Target(target) -> {
            if !fs.is_dir(target) -> return ~target
            root :: require_manifest_root(OSPath.of(target), "error: no package.jet found for this inspect target")
            return find_project_entry(root).to_string_lossy()
        }
        .Package | .Live(_) | .Replay(_) -> {
            // GATE #4494: real process cwd.
            cwd :: env.current_dir() ?? OSPath.of(".")
            root :: require_manifest_root(cwd, "error: no package.jet found — run inspect inside a project")
            return find_project_entry(root).to_string_lossy()
        }
    }
}

// Rust: Source/CmdInspect.rs:4068
fn run_decisions_live(pid: U32, mode: OutputMode) -> {
    projection :: DevServer.LiveInspect.read_plane(pid, "decisions") ?? {
        cli_error_fix("E2105", err, "start the program with --observe, then run `jet inspect decisions --live {pid}`")
        env.exit(ExitCodes.USER_ERROR) // GATE #4494
    }
    has_ledger :: projection.decision_ledger != None
    ledger :: projection.decision_ledger ?? {
        identity :: MirDecisionIdentity{source: ~projection.source_id, configuration: ~projection.build_id, profile: "live", target: ~projection.world_id, implementation: ~projection.protocol, artifact: "pid:{pid}", run: ~projection.revision}
        MirDecisionLedger.from_rows(identity, [MirDecisionRow]{MirDecisionRow.new(MirDecisionKind.Tier, MirDecisionDisposition.Unavailable, None, "", Diagnostics.Span.new(0, 0), "live-decision-ledger", "the live runtime produced no compiler decision ledger for this run", "live.inspect", "runtime-snapshot")})
    }
    record_status :: if has_ledger -> "current" else -> "unavailable"
    if mode.json {
        rows := [StatusValue]{}
        loop row in ledger.rows -> &rows.push(decision_row_value(row))
        fields :: StatusFields.new().with("scope", "live").with("pid", projection.pid).with("protocol", projection.protocol).with("session_id", projection.session_id).with("source_id", projection.source_id).with("build_id", projection.build_id).with("revision", projection.revision).with("world_id", projection.world_id).with("record_status", record_status).with("retention", "bounded").with("redaction", "transport-safe").with("rows", StatusValue.array(^rows)).with("kinds", decision_kind_status_value(ledger.rows))
        print("{render_status(\"inspect.decisions\", true, fields)}")
        return
    }
    text := String.new()
    &text.push_str("decisions: scope=live pid={projection.pid} source={projection.source_id} build={projection.build_id} revision={projection.revision} world={projection.world_id} record_status={record_status} retention=bounded redaction=transport-safe\n")
    loop row in ledger.rows {
        derivation_ref :: if row.derivation == .Val(reference) -> reference.id else -> "unavailable"
        disposition :: if row.derivation_disposition == .Val(value) -> value.as_str() else -> "unknown"
        &text.push_str("decision kind={row.kind.as_str()} disposition={row.disposition.as_str()} derivation_disposition={disposition} derivation_ref={derivation_ref} reason={row.reason} producer={row.producer}\n")
    }
    print_raw(text)
}

// Rust: Source/CmdInspect.rs:4163
fn run_inspect_live(plane: CLI.InspectPlane, pid: U32, mode: OutputMode) -> {
    if plane == CLI.InspectPlane.Decisions {
        run_decisions_live(pid, mode)
        return
    }
    if mode.json {
        projection :: DevServer.LiveInspect.read_plane(pid, plane.name()) ?? {
            cli_error_fix("E2105", err, "start the program with --observe, then run `jet inspect {plane.name()} --live {pid}`")
            env.exit(ExitCodes.USER_ERROR) // GATE #4494
        }
        values := [StatusValue]{}
        loop value in projection.values {
            rendered :: if value.rendered_value == .Val(text) -> StatusValue.String(~text) else -> StatusValue.Null
            &values.push(StatusValue.object(StatusFields.new().with("value_id", value.value_id).with("type_identity", value.type_identity).with("disposition", value.disposition).with("reason", value.reason).with("rendered_value", ^rendered)))
        }
        shapes := [StatusValue]{}
        loop shape in projection.shapes {
            ids := [StatusValue]{}
            loop id in shape.value_ids -> &ids.push(StatusValue.String(~id))
            &shapes.push(StatusValue.object(StatusFields.new().with("type_identity", shape.type_identity).with("value_ids", StatusValue.array(^ids))))
        }
        fields :: StatusFields.new().with("plane", projection.plane).with("scope", projection.scope).with("pid", projection.pid).with("protocol", projection.protocol).with("session_id", projection.session_id).with("source_id", projection.source_id).with("build_id", projection.build_id).with("revision", projection.revision).with("world_id", projection.world_id).with("values", StatusValue.array(^values)).with("shapes", StatusValue.array(^shapes))
        print("{render_status(\"inspect.{plane.name()}\", true, fields)}")
    } else {
        snapshot :: DevServer.LiveInspect.read(pid) ?? {
            cli_error_fix("E2105", err, "start the program with --observe, then run `jet inspect {plane.name()} --live {pid}`")
            env.exit(ExitCodes.USER_ERROR) // GATE #4494
        }
        print_raw(DevServer.LiveInspect.render(snapshot))
    }
}

// Rust: Source/CmdInspect.rs:4243
fn indexed_decision_record_state(artifact: String) -> (status: String, retention: String, redaction: String) {
    index :: RecordIndex.RecordIndex.load_for_project(OSPath.of(".")) ?? return (status: "unavailable", retention: "unknown", redaction: "unknown")
    requested_path :: OSPath.of(artifact)
    requested_name :: requested_path.file_name().and_then((name) -> name.to_str())
    matches_artifact :: (entry: RecordIndex.RecordIndexEntry) -> entry.artifact_id == artifact || entry.path == requested_path || (if requested_name == .Val(name) -> entry.path.file_name().and_then((value) -> value.to_str()) == Val(name) else -> false)
    loop entry in index.query(false) {
        if entry.kind == RecordIndex.RecordKind.Replay && matches_artifact(entry) -> return (status: "current", retention: if entry.saved -> "saved" else -> "bounded", redaction: entry.capture.as_str())
    }
    loop entry in index.query(true) {
        if entry.kind == RecordIndex.RecordKind.Replay && matches_artifact(entry) -> return (status: "redacted", retention: "retained", redaction: "sensitive")
    }
    (status: "unavailable", retention: "unknown", redaction: "unknown")
}

// Rust: Source/CmdInspect.rs:4276
fn run_decisions_replay(artifact: String, authority: ReplayAuthority, mode: OutputMode) -> {
    has_ledger :: authority.decision_ledger != None
    ledger :: authority.decision_ledger ?? {
        identity :: MirDecisionIdentity{source: "replay-artifact", configuration: "replay-receipt", profile: "replay", target: "replay", implementation: "mir-v1", artifact: ~artifact, run: "replay:{artifact}"}
        MirDecisionLedger.from_rows(identity, [MirDecisionRow]{MirDecisionRow.new(MirDecisionKind.Tier, MirDecisionDisposition.Unavailable, None, "", Diagnostics.Span.new(0, 0), "replay-decision-ledger", "the replay artifact has no retained compiler decision section", "replay.inspect", "replay-receipt")})
    }
    indexed :: indexed_decision_record_state(artifact)
    record_status :: if has_ledger -> "current" else -> indexed.status
    if mode.json {
        rows := [StatusValue]{}
        loop row in ledger.rows -> &rows.push(decision_row_value(row))
        fields :: StatusFields.new().with("plane", "decisions").with("scope", "replay").with("artifact", artifact).with("expected_outcome", authority.expected_outcome).with("expected_status", authority.expected_status).with("record_status", record_status).with("retention", indexed.retention).with("redaction", indexed.redaction).with("rows", StatusValue.array(^rows)).with("kinds", decision_kind_status_value(ledger.rows))
        print("{StatusEnvelope.new(\"inspect.decisions\", true).with_fields(fields).json()}")
    } else {
        print("decisions replay")
        print("artifact: {artifact}")
        print("record_status: {record_status} retention: {indexed.retention} redaction: {indexed.redaction}")
        print("expected: {authority.expected_outcome} ({authority.expected_status})")
        loop row in ledger.rows {
            reference :: if row.derivation == .Val(value) -> value.id else -> "unavailable"
            disposition :: if row.derivation_disposition == .Val(value) -> value.as_str() else -> "unknown"
            print("decision kind={row.kind.as_str()} disposition={row.disposition.as_str()} derivation_disposition={disposition} derivation_ref={reference} reason={row.reason} producer={row.producer}")
        }
    }
}

// Rust: Source/CmdInspect.rs:4363
fn run_inspect_replay(plane: CLI.InspectPlane, artifact: String, profile: String, setting_overrides: [String:String], mode: OutputMode) -> {
    file :: inspect_entry_path(CLI.InspectScope.Replay(~artifact))
    authority :: open_named_replay(file, artifact, profile, setting_overrides, mode.json) ?? env.exit(err) // GATE #4494
    if plane == CLI.InspectPlane.Decisions {
        run_decisions_replay(artifact, authority, mode)
        return
    }
    acts := [StatusValue]{}
    values := [StatusValue]{}
    shape_values := [String:[String:Bool]]{}
    loop act in authority.recorded_run.acts {
        locals := [StatusValue]{}
        loop local in act.locals {
            &locals.push(StatusValue.object(StatusFields.new().with("name", local.name).with("type_name", local.type_name).with("value", local.value)))
            &values.push(StatusValue.object(StatusFields.new().with("value_id", local.name).with("type_identity", local.type_name).with("disposition", "captured").with("reason", "").with("rendered_value", local.value)))
            if !shape_values.has_key(local.type_name) -> shape_values[~local.type_name] = [String:Bool]{}
            shape_values[local.type_name][~local.name] = true
        }
        &acts.push(StatusValue.object(StatusFields.new().with("sequence", act.sequence).with("function", act.function).with("line", act.line).with("locals", StatusValue.array(^locals))))
    }
    shapes := [StatusValue]{}
    types := shape_values.keys().to_list()
    &types.sort()
    loop type_identity in types {
        ids := shape_values[type_identity].keys().to_list()
        &ids.sort()
        rows := [StatusValue]{}
        loop id in ids -> &rows.push(StatusValue.String(~id))
        &shapes.push(StatusValue.object(StatusFields.new().with("type_identity", type_identity).with("value_ids", StatusValue.array(^rows))))
    }
    if mode.json {
        fields :: StatusFields.new().with("plane", plane.name()).with("scope", "replay").with("artifact", artifact).with("expected_outcome", authority.expected_outcome).with("expected_status", authority.expected_status).with("acts", StatusValue.array(^acts)).with("values", StatusValue.array(^values)).with("shapes", StatusValue.array(^shapes))
        print("{StatusEnvelope.new(\"inspect.{plane.name()}\", true).with_fields(fields).json()}")
    } else {
        print("{plane.name()} replay")
        print("artifact: {artifact}")
        print("expected: {authority.expected_outcome} ({authority.expected_status})")
        loop act in authority.recorded_run.acts {
            print("  #{act.sequence} {act.function}:{act.line}")
            loop local in act.locals -> print("    {local.name}: {local.type_name} = {local.value}")
        }
    }
}

// Rust: Source/CmdInspect.rs:4470
fn run_rights(projection: CheckProjection, scope: CheckScope, target: String, json: Bool) -> {
    // Rust: Source/CmdInspect.rs:4472
    struct CallableView {
        key: String, name: String, source: String, span: Diagnostics.Span
        declared_effects: [String]?
        is_pure: Bool, is_comptime: Bool, is_replayable: Bool
        inferred_seed: String?
    }
    // Rust: Source/CmdInspect.rs:4484
    struct CallableReport {
        view: CallableView, declared: RightsRow, inferred: RightsRow
        inferred_effects: Holds, direct_effects: Holds
        callees: [String], maximal: Bool, walk: RightsWalk
    }
    // Rust: Source/CmdInspect.rs:4495
    fn add_func(out: &[CallableView], alias: String, namespace: String, source: String, owner: String?, function: AST.Func) -> {
        identity :: if owner == .Val(name) -> "{namespace}{name}::{function.name}" else -> "{namespace}{function.name}"
        effects := [String]?{None}
        if function.declared_effects == .Val(declared) {
            names := [String]{}
            loop pair in declared -> &names.push(~pair.0)
            effects = Val(^names)
        }
        &out.push(CallableView{key: "{alias}::{identity}", name: ~function.name, source: ~source, span: function.span, declared_effects: ^effects, is_pure: function.is_pure, is_comptime: function.is_comptime, is_replayable: function.is_replayable, inferred_seed: None})
    }
    // Rust: Source/CmdInspect.rs:4522
    fn add_trait_method(out: &[CallableView], alias: String, namespace: String, source: String, trait_name: String, method: AST.TraitMethodSig) -> {
        identity :: "{namespace}{trait_name}::{method.name}"
        effects := [String]?{None}
        if method.declared_effects == .Val(declared) {
            names := [String]{}
            loop pair in declared -> &names.push(~pair.0)
            effects = Val(^names)
        }
        &out.push(CallableView{key: "{alias}::{identity}", name: ~method.name, source: ~source, span: method.span, declared_effects: ^effects, is_pure: method.is_pure, is_comptime: false, is_replayable: false, inferred_seed: None})
    }
    // Rust: Source/CmdInspect.rs:4547
    fn add_extern(out: &[CallableView], alias: String, namespace: String, source: String, function: AST.ExternFn) -> {
        &out.push(CallableView{key: "{alias}::{namespace}{function.name}", name: ~function.name, source: ~source, span: function.span, declared_effects: None, is_pure: false, is_comptime: false, is_replayable: false, inferred_seed: Val(function.effect_root ?? "FFI")})
    }
    // Rust: Source/CmdInspect.rs:4572
    fn collect_items(items: [AST.Item], alias: String, namespace: String, source: String, out: &[CallableView]) -> {
        loop item in items {
            if item == {
                .Func(function) -> add_func(&out, alias, namespace, source, None, function)
                .Impl(definition) -> {
                    loop method in definition.methods -> add_func(&out, alias, namespace, source, Val(definition.type_name), method)
                }
                .Struct(definition) -> {
                    loop method in definition.methods -> add_func(&out, alias, namespace, source, Val(definition.name), method)
                    loop block in definition.trait_impls {
                        loop method in block.methods -> add_func(&out, alias, namespace, source, Val(definition.name), method)
                    }
                }
                .Enum(definition) -> {
                    loop method in definition.methods -> add_func(&out, alias, namespace, source, Val(definition.name), method)
                    loop block in definition.trait_impls {
                        loop method in block.methods -> add_func(&out, alias, namespace, source, Val(definition.name), method)
                    }
                }
                .Trait(definition) -> {
                    loop method in definition.methods -> add_trait_method(&out, alias, namespace, source, definition.name, method)
                }
                .ExternRust(block) -> {
                    loop function in block.functions -> add_extern(&out, alias, namespace, source, function)
                }
                .CodeModule(module) -> {
                    if module.body == .Val(body) -> collect_items(body, alias, "{namespace}{module.name}__", source, &out)
                }
                .GenericModule(module) -> collect_items(module.body, alias, "{namespace}{module.name}__", source, &out)
                else -> {}
            }
        }
    }
    // Rust: Source/CmdInspect.rs:4668
    fn holds_value(holds: Holds) -> StatusValue {
        values := [StatusValue]{}
        loop name in holds.iter() -> &values.push(StatusValue.String(~name))
        StatusValue.array(^values)
    }
    // Rust: Source/CmdInspect.rs:4672
    fn holds_text(holds: Holds) -> String { holds.iter().to_list().join(", ") }
    // Rust: Source/CmdInspect.rs:4676
    fn verdict_name(verdict: jet_foundation.Authority.Verdict) -> String {
        if verdict == { .Allowed -> "allowed"; .Denied -> "denied"; .Missing -> "missing" }
    }
    // Rust: Source/CmdInspect.rs:4684
    fn span_value(source: String, start: Int, end: Int) -> StatusValue {
        StatusValue.object(StatusFields.new().with("source", source).with("start", start).with("end", end))
    }
    // Rust: Source/CmdInspect.rs:4693
    fn frame_value(frame: jet_foundation.sema.ScopeFrame) -> StatusValue {
        StatusValue.object(StatusFields.new().with("scope", frame.scope.name()).with("name", frame.name).with("grants", holds_value(frame.grants)).with("authority", StatusValue.object(StatusFields.new().with("source", frame.provenance.source).with("reason", frame.provenance.reason))))
    }
    // Rust: Source/CmdInspect.rs:4710
    fn row_value(row: RightsRow) -> StatusValue {
        allow :: if row.allow == .Val(value) -> holds_value(value) else -> StatusValue.Null
        StatusValue.object(StatusFields.new().with("kind", row.kind.name()).with("allow", ^allow).with("deny", holds_value(row.deny)).with("provenance", StatusValue.object(StatusFields.new().with("source", row.provenance.source).with("reason", row.provenance.reason))))
    }
    // Rust: Source/CmdInspect.rs:4732
    fn row_text(row: RightsRow) -> String {
        allow :: if row.allow == .Val(value) -> holds_text(value) else -> "unbounded"
        "kind={row.kind.name()} allow=[{allow}] deny=[{holds_text(row.deny)}]"
    }
    // Rust: Source/CmdInspect.rs:4746
    fn declared_row(callable: CallableView) -> RightsRow {
        reason :: if {
            callable.is_comptime -> "comptime declaration"
            callable.is_pure -> "pure declaration"
            callable.is_replayable -> "replayable declaration"
            callable.declared_effects != None -> "declared effect row"
            else -> "inferred callable declaration"
        }
        provenance :: jet_foundation.sema.RightsProvenance.new(~callable.key, reason)
        if callable.is_comptime -> return RightsRow.comptime(provenance)
        if callable.is_pure -> return RightsRow.pure(provenance)
        if callable.is_replayable -> return RightsRow.replayable(provenance)
        if callable.declared_effects == .Val(effects) {
            allow := [String]{}
            deny := [String]{}
            loop name in effects {
                if name.strip_prefix("!") == .Val(value) -> &deny.push(~value)
                else -> &allow.push(~name)
            }
            return RightsRow.invocation(allow, deny, provenance)
        }
        RightsRow.callable(provenance)
    }
    selected_path :: OSPath.of(target).canonicalize().ok()
    callables := [CallableView]{}
    loop (module_index, module) in projection.bundle.modules {
        if scope == CheckScope.ExplicitFile {
            module_path :: module.path.canonicalize() ?? ~module.path
            selected_matches :: if selected_path == .Val(selected) -> selected == module_path else -> false
            if module.display != target && !selected_matches -> next
        }
        alias :: projection.facts.name_ledger.module_alias(module_index) ?? module.alias
        collect_items(module.items, alias, "", module.display, &callables)
    }
    &callables.sort_by((left: CallableView, right: CallableView) -> {
        if left.key != right.key -> left.key <=> right.key
        else { if left.span.start != right.span.start -> left.span.start <=> right.span.start else -> left.span.end <=> right.span.end }
    })
    &callables.dedup_by((left: CallableView, right: CallableView) -> left.key == right.key)
    application :: projection.bundle.package_guarantees.application_authority
    scope_chain :: [jet_foundation.sema.ScopeFrame]{jet_foundation.sema.ScopeFrame.new(jet_foundation.Authority.Scope.Package, ~application.authority, ~application.granted_effects, jet_foundation.sema.RightsProvenance.new(~application.authority, "selected application authority"))}
    reports := [CallableReport]{}
    loop view in callables {
        declared :: declared_row(view)
        summary :: projection.facts.summaries.get(view.key)
        inferred_effects := projection.facts.solved.get(view.key) ?? Holds.default()
        if inferred_effects.is_empty() {
            if summary == .Val(value) -> &inferred_effects.extend(value.direct.iter())
        }
        if inferred_effects.is_empty() {
            if view.inferred_seed == .Val(seed) -> _ :: &inferred_effects.insert(~seed)
        }
        inferred :: RightsRow.invocation(inferred_effects.iter(), [], jet_foundation.sema.RightsProvenance.new(~view.key, "sema inferred effect facts"))
        call_chain := [String]{~view.key}
        if projection.index().effect_of(view.key) == .Val(fact) {
            if fact.provenance.first() == .Val(witness) {
                if !witness.call_path.is_empty() -> call_chain = ~witness.call_path
            }
        }
        walk :: declared.walk(inferred_effects, call_chain, scope_chain)
        direct :: if summary == .Val(value) -> ~value.direct else -> Holds.default()
        callees :: if summary == .Val(value) -> value.edges.iter().to_list() else -> [String]{}
        maximal :: if summary == .Val(value) -> value.maximal else -> false
        &reports.push(CallableReport{view: ^view, declared: ^declared, inferred: ^inferred, inferred_effects: ^inferred_effects, direct_effects: ^direct, callees: ^callees, maximal: maximal, walk: ^walk})
    }
    authority_facts := [StatusValue]{}
    loop declaration in jet_foundation.Authority.effect_declarations() -> &authority_facts.push(StatusValue.object(StatusFields.new().with("name", declaration.name).with("irreversible", declaration.irreversible)))
    authority :: StatusValue.object(StatusFields.new().with("source", application.authority).with("required", holds_value(application.required_effects)).with("granted", holds_value(application.granted_effects)).with("denied", holds_value(application.denied_effects)))
    callable_values := [StatusValue]{}
    loop report in reports {
        denials := [StatusValue]{}
        loop denial in report.walk.denials {
            witness_spans := [StatusValue]{}
            if projection.index().effect_of(report.view.key) == .Val(fact) {
                loop witness in fact.provenance {
                    if witness.effect == denial.right {
                        loop span in witness.spans -> &witness_spans.push(span_value(report.view.source, span.start, span.end))
                        break
                    }
                }
            }
            nearest :: if denial.chain.nearest_granting_scope == .Val(frame) -> frame_value(frame) else -> StatusValue.Null
            calls := [StatusValue]{}
            loop call in denial.chain.call_chain -> &calls.push(StatusValue.String(~call))
            frames := [StatusValue]{}
            loop frame in denial.chain.scope_chain -> &frames.push(frame_value(frame))
            chain :: StatusValue.object(StatusFields.new().with("right", denial.chain.right).with("call_chain", StatusValue.array(^calls)).with("scope_chain", StatusValue.array(^frames)).with("nearest_granting_scope", ^nearest))
            &denials.push(StatusValue.object(StatusFields.new().with("right", denial.right).with("verdict", verdict_name(denial.verdict)).with("chain", ^chain).with("source_spans", StatusValue.array(^witness_spans))))
        }
        callees := [StatusValue]{}
        loop callee in report.callees -> &callees.push(StatusValue.String(~callee))
        summary :: StatusFields.new().with("direct", holds_value(report.direct_effects)).with("callees", StatusValue.array(^callees)).with("maximal", report.maximal)
        &callable_values.push(StatusValue.object(StatusFields.new().with("callable", report.view.key).with("name", report.view.name).with("source_span", span_value(report.view.source, report.view.span.start, report.view.span.end)).with("declared_row", row_value(report.declared)).with("inferred_row", row_value(report.inferred)).with("inferred_effects", holds_value(report.inferred_effects)).with("effects", StatusValue.object(summary)).with("verdict", verdict_name(report.walk.verdict)).with("denials", StatusValue.array(^denials))))
    }
    if json {
        fields :: StatusFields.new().with("scope", scope_name(scope)).with("target", target).with("authority", ^authority).with("evidence", "checked_static").with("runtime_observation", "not_run").with("provenance_scope", "checked_semantic_index").with("authority_facts", StatusValue.array(^authority_facts)).with("callables", StatusValue.array(^callable_values))
        print("{StatusEnvelope.new(\"inspect.rights\", true).with_fields(fields).json()}")
    } else {
        print("rights")
        print("scope: {scope_name(scope)}")
        print("target: {target}")
        print("evidence: checked_static")
        print("runtime observation: not_run")
        print("provenance scope: checked_semantic_index")
        print("authority: {application.authority}")
        print("granted: {holds_text(application.granted_effects)}")
        print("denied: {holds_text(application.denied_effects)}")
        print("authority facts:")
        loop declaration in jet_foundation.Authority.effect_declarations() {
            suffix :: if declaration.irreversible -> " (irreversible)" else -> ""
            print("  {declaration.name}{suffix}")
        }
        loop report in reports {
            print("callable: {report.view.key} @ {report.view.source}:{report.view.span.start}-{report.view.span.end}")
            print("  declared row: {row_text(report.declared)}")
            print("  inferred row: {row_text(report.inferred)}")
            print("  inferred effects: {holds_text(report.inferred_effects)}")
            print("  verdict: {verdict_name(report.walk.verdict)}")
            if report.walk.denials.is_empty() -> print("  denials: none")
            else {
                loop denial in report.walk.denials {
                    via :: if denial.chain.call_chain.is_empty() -> "none" else -> denial.chain.call_chain.join(" -> ")
                    print("  denial: {denial.right} ({verdict_name(denial.verdict)}) via {via}")
                }
            }
        }
    }
}

// Rust: Source/CmdInspect.rs:5052
const HARDENING_SURFACE_SCHEMA: String = "jet.hardening.surface.v1"
// Rust: Source/CmdInspect.rs:5053
const HARDENING_SURFACE_VERSION: I128 = 1
// Rust: Source/CmdInspect.rs:5054
const CAPABILITY_RELATION_SCHEMA: String = "jet.capability.relation.v1"
// Rust: Source/CmdInspect.rs:5055
const CAPABILITY_RELATION_VERSION: I128 = 1
// Rust: Source/CmdInspect.rs:5056
const CAPABILITY_RELATION_DISPOSITIONS: [String] = ["planned", "implemented-unqualified", "passed", "failed", "stale", "unavailable", "unsupported", "owner-ratified-not-applicable"]

// Rust: Source/CmdInspect.rs:5067
fn capability_status_field(value: StatusValue, name: String) -> StatusValue? {
    if value == .Object(fields) {
        loop (field, value) in fields.iter() { if field == name -> return Val(value) }
    }
    None
}
// Rust: Source/CmdInspect.rs:5076
fn capability_status_string(value: StatusValue) -> String? {
    if value == .String(text) -> Val(text) else -> None
}
// Rust: Source/CmdInspect.rs:5083
fn capability_status_integer(value: StatusValue) -> I128? {
    if value == .Integer(number) -> Val(number) else -> None
}
// Rust: Source/CmdInspect.rs:5090
fn capability_status_bool(value: StatusValue) -> Bool? {
    if value == .Bool(flag) -> Val(flag) else -> None
}
// Rust: Source/CmdInspect.rs:5097
fn capability_digest(value: StatusValue) -> String? {
    text :: capability_status_string(value) ?? return None
    hex :: text.strip_prefix("sha256:") ?? return None
    if hex.bytes().len() != 64 -> return None
    loop character in hex.chars() { if !character.is_ascii_hexdigit() -> return None }
    Val(text)
}

// Rust: Source/CmdInspect.rs:5104
fn capability_canonical_json(value: StatusValue) -> String Err! {
    // Rust: Source/CmdInspect.rs:5105
    fn encode(value: StatusValue, root: Bool) -> String Err! {
        if value == {
            .Null -> Ok("null")
            .Bool(flag) -> Ok("{flag}")
            .Integer(number) -> Ok("{number}")
            .Float(_) -> Err("canonical capability metadata cannot contain floating-point numbers")
            .String(text) -> Ok("\"{json_escape(text)}\"")
            .Array(values) -> {
                parts := [String]{}
                loop item in values -> &parts.push(encode(item, false))
                Ok("[{parts.join(\",\")}]")
            }
            .Object(fields) -> {
                entries := fields.iter().to_list()
                &entries.sort_unstable_by((left, right) -> left.0 <=> right.0)
                loop at in 1..<entries.len() {
                    if entries[at - 1].0 == entries[at].0 -> return Err("canonical capability metadata has duplicate object keys")
                }
                parts := [String]{}
                loop (name, item) in entries {
                    if root && name == "content_digest" -> next
                    encoded :: encode(item, false)
                    &parts.push("\"{json_escape(name)}\":{encoded}")
                }
                Ok("{{{parts.join(\",\")}}}")
            }
        }
    }
    encode(value, true)
}

// Rust: Source/CmdInspect.rs:5149
fn validate_capability_content_digest(value: StatusValue, label: String) -> Err! {
    actual :: capability_status_field(value, "content_digest").and_then(capability_digest) ?? return Err("{label} content_digest is missing or invalid")
    canonical :: capability_canonical_json(value)
    expected :: "sha256:{jet.SHA256.sha256_hex(canonical.bytes())}"
    if actual != expected -> return Err("{label} content_digest does not match canonical content")
    return
}

// Rust: Source/CmdInspect.rs:5161
fn validate_hardening_manifest(manifest: StatusValue) -> Err! {
    errors := [String]{}
    if capability_status_field(manifest, "schema").and_then(capability_status_string) != Val(HARDENING_SURFACE_SCHEMA) -> &errors.push("schema must be {HARDENING_SURFACE_SCHEMA}")
    if capability_status_field(manifest, "schema_version").and_then(capability_status_integer) != Val(HARDENING_SURFACE_VERSION) -> &errors.push("schema_version must be {HARDENING_SURFACE_VERSION}")
    if validate_capability_content_digest(manifest, "hardening manifest") == .Err(error) -> &errors.push(^error)
    snapshot :: capability_status_field(manifest, "source_snapshot") ?? {
        &errors.push("source_snapshot is required")
        return Err(errors.join("; "))
    }
    if capability_status_field(snapshot, "algorithm").and_then(capability_status_string) != Val("sha256") -> &errors.push("source_snapshot algorithm must be sha256")
    if capability_status_field(snapshot, "hash").and_then(capability_digest) == None -> &errors.push("source_snapshot hash is missing or invalid")
    if errors.is_empty() -> return
    Err(errors.join("; "))
}

// Rust: Source/CmdInspect.rs:5198
fn validate_capability_relation(manifest: StatusValue, relation: StatusValue) -> Err! {
    errors := [String]{}
    if capability_status_field(relation, "schema").and_then(capability_status_string) != Val(CAPABILITY_RELATION_SCHEMA) -> &errors.push("schema must be {CAPABILITY_RELATION_SCHEMA}")
    if capability_status_field(relation, "schema_version").and_then(capability_status_integer) != Val(CAPABILITY_RELATION_VERSION) -> &errors.push("schema_version must be {CAPABILITY_RELATION_VERSION}")
    if validate_capability_content_digest(relation, "capability relation") == .Err(error) -> &errors.push(^error)
    relation_source :: capability_status_field(relation, "source_snapshot_hash").and_then(capability_digest)
    manifest_source :: capability_status_field(manifest, "source_snapshot").and_then((snapshot) -> capability_status_field(snapshot, "hash")).and_then(capability_digest)
    if relation_source == None -> &errors.push("source_snapshot_hash is missing or invalid")
    else { if relation_source != manifest_source -> &errors.push("source_snapshot_hash does not match the manifest") }
    revision_rule :: capability_status_field(relation, "revision_rule").and_then(capability_status_string)
    if (revision_rule ?? "").trim().is_empty() -> &errors.push("revision_rule is missing or empty")
    identity_rows :: if capability_status_field(relation, "identities") == .Val(.Array(values)) -> values else -> {
        &errors.push("identities are required")
        [StatusValue]{}
    }
    identity_modes := [String:[String:Bool]]{}
    loop identity in identity_rows {
        identity_id :: capability_status_field(identity, "capability_id").and_then(capability_status_string) ?? {
            &errors.push("identity capability_id is missing")
            next
        }
        if identity_id.trim().is_empty() {
            &errors.push("identity capability_id is empty")
            next
        }
        if identity_modes.has_key(identity_id) -> &errors.push("duplicate identity: {identity_id}")
        modes :: if capability_status_field(identity, "applicable_modes") == .Val(.Array(values)) -> values else -> {
            &errors.push("identity has no applicable modes: {identity_id}")
            [StatusValue]{}
        }
        mode_set := [String:Bool]{}
        loop value in modes {
            mode :: capability_status_string(value) ?? {
                &errors.push("identity mode is malformed: {identity_id}")
                next
            }
            // Rust short-circuits insert when an empty mode is encountered.
            if mode.trim().is_empty() || mode_set.has_key(mode) -> &errors.push("identity mode is empty or duplicated: {identity_id}")
            else -> mode_set[~mode] = true
        }
        source_identity :: capability_status_field(identity, "source_identity")
        path :: source_identity.and_then((value) -> capability_status_field(value, "path")).and_then(capability_status_string)
        digest :: source_identity.and_then((value) -> capability_status_field(value, "digest")).and_then(capability_digest)
        if (path ?? "").trim().is_empty() || digest == None -> &errors.push("identity source is invalid: {identity_id}")
        identity_modes[~identity_id] = ^mode_set
    }
    row_rows :: if capability_status_field(relation, "rows") == .Val(.Array(values)) -> values else -> {
        &errors.push("rows are required")
        [StatusValue]{}
    }
    row_ids := [String:Bool]{}
    disposition_counts := [String:Int]{}
    counted_rows := 0
    loop (index, row) in row_rows {
        label :: "row#{index}"
        row_id :: capability_status_field(row, "row_id").and_then(capability_status_string) ?? {
            &errors.push("{label} row_id is missing")
            next
        }
        if row_id.trim().is_empty() || row_ids.has_key(row_id) -> &errors.push("duplicate or empty row_id: {row_id}")
        else -> row_ids[~row_id] = true
        capability_id :: capability_status_field(row, "capability_id").and_then(capability_status_string)
        mode :: capability_status_field(row, "mode").and_then(capability_status_string)
        if capability_id != None && mode != None {
            id :: capability_id ?? panic("matched capability id")
            mode_name :: mode ?? panic("matched mode")
            if row_id != "{id}@{mode_name}" -> &errors.push("row identity is not canonical: {row_id}")
            if identity_modes.get(id) == .Val(modes) {
                if !modes.has_key(mode_name) -> &errors.push("row has an inapplicable mode: {row_id}")
            } else -> &errors.push("row has no identity: {row_id}")
        } else -> &errors.push("row capability_id or mode is missing: {row_id}")
        disposition :: capability_status_field(row, "disposition").and_then(capability_status_string)
        if disposition == .Val(name) {
            if !CAPABILITY_RELATION_DISPOSITIONS.contains(name) -> &errors.push("row has an invalid disposition: {row_id}")
            disposition_counts[~name] = (disposition_counts.get(name) ?? 0) + 1
            if capability_status_field(row, "status").and_then(capability_status_string) != Val(name) -> &errors.push("row status contradicts disposition: {row_id}")
            owner_link :: capability_status_field(row, "owner_link").and_then(capability_status_string)
            if name != "passed" && (owner_link ?? "").trim().is_empty() -> &errors.push("non-pass row has no owner link: {row_id}")
            if name == "passed" {
                evidence_passed :: capability_status_field(row, "evidence").and_then((value) -> capability_status_field(value, "status")).and_then(capability_status_string) == Val("passed")
                independent_oracle :: capability_status_field(row, "oracle").and_then((value) -> capability_status_field(value, "independent_expected_behavior")).and_then(capability_status_bool) == Val(true)
                value_consuming :: capability_status_field(row, "observable").and_then((value) -> capability_status_field(value, "value_consuming")).and_then(capability_status_bool) == Val(true)
                if !evidence_passed || !independent_oracle || !value_consuming -> &errors.push("passed row lacks evidence, independent oracle, or observable value: {row_id}")
                exact_identity :: capability_status_field(row, "identity").and_then((value) -> capability_status_field(value, "candidate")).and_then((value) -> capability_status_field(value, "status")).and_then(capability_status_string) == Val("available")
                concrete_identity := true
                loop field in [String]{"compiler_identity", "tool_identity", "target_identity"} {
                    if !(capability_status_field(row, field) == .Val(.Object(_))) -> concrete_identity = false
                }
                candidate_status :: capability_status_field(row, "candidate_identity").and_then((value) -> capability_status_field(value, "status")).and_then(capability_status_string)
                candidate_available :: candidate_status == Val("available")
                if !exact_identity || !concrete_identity || !candidate_available -> &errors.push("passed row lacks exact candidate identity: {row_id}")
                if candidate_status == Val("stale") -> &errors.push("stale candidate is marked passed: {row_id}")
            }
            if name == "owner-ratified-not-applicable" {
                ratified := false
                if capability_status_field(row, "exclusion") == .Val(value) {
                    ratified = true
                    loop field in [String]{"reason", "owner", "decision"} {
                        text :: capability_status_field(value, field).and_then(capability_status_string)
                        if (text ?? "").trim().is_empty() -> ratified = false
                    }
                }
                if !ratified -> &errors.push("capability exclusion is not owner-ratified: {row_id}")
            }
        } else -> &errors.push("row disposition is missing: {row_id}")
        loop field in [String]{"contract", "route", "observable", "oracle", "evidence", "identity", "owner", "source_identity", "candidate_identity"} {
            if !(capability_status_field(row, field) == .Val(.Object(_))) -> &errors.push("row {field} is missing: {row_id}")
        }
        if capability_status_field(row, "counted").and_then(capability_status_bool) != Val(true) -> &errors.push("row is not counted: {row_id}")
        else -> counted_rows += 1
    }
    identity_keys := identity_modes.keys().to_list()
    &identity_keys.sort()
    loop identity in identity_keys {
        modes := identity_modes[identity].keys().to_list()
        &modes.sort()
        loop mode in modes {
            row_id :: "{identity}@{mode}"
            if !row_ids.has_key(row_id) -> &errors.push("missing applicable mode row: {row_id}")
        }
    }
    denominator :: capability_status_field(relation, "denominator") ?? {
        &errors.push("denominator is required")
        return Err(errors.join("; "))
    }
    if !(denominator == .Object(_)) {
        &errors.push("denominator is required")
        return Err(errors.join("; "))
    }
    // GATE #4483: checked i128→usize is selected-target width, not host width.
    integer_field :: (value: StatusValue?) -> value.and_then(capability_status_integer).and_then((number) -> USize.try_from(number).ok())
    if integer_field(capability_status_field(denominator, "row_count")) != Val(USize{row_rows.len()}) -> &errors.push("denominator row_count is stale")
    if integer_field(capability_status_field(denominator, "counted_rows")) != Val(USize{counted_rows}) -> &errors.push("denominator counted_rows is stale")
    denominator_ids := [String:Bool]?{None}
    if capability_status_field(denominator, "identity_ids") == .Val(.Array(values)) {
        ids := [String:Bool]{}
        loop value in values {
            if capability_status_string(value) == .Val(id) {
                if ids.has_key(id) -> &errors.push("denominator identity_ids contain duplicates")
                else -> ids[~id] = true
            } else -> &errors.push("denominator identity_ids contain a malformed value")
        }
        denominator_ids = Val(^ids)
    } else -> &errors.push("denominator identity_ids are required")
    ids_stale := false
    if denominator_ids == .Val(ids) {
        if ids.len() != identity_modes.len() -> ids_stale = true
        loop id in ids.keys() { if !identity_modes.has_key(id) -> ids_stale = true }
    }
    if integer_field(capability_status_field(denominator, "identity_count")) != Val(USize{identity_modes.len()}) || ids_stale -> &errors.push("denominator identities are stale")
    disposition_values :: capability_status_field(denominator, "dispositions")
    if disposition_values == .Val(.Object(fields)) {
        loop (name, _) in fields.iter() {
            if !CAPABILITY_RELATION_DISPOSITIONS.contains(name) -> &errors.push("denominator has unknown disposition: {name}")
        }
        loop disposition in CAPABILITY_RELATION_DISPOSITIONS {
            actual :: integer_field(disposition_values.and_then((value) -> capability_status_field(value, disposition)))
            if actual != Val(USize{disposition_counts.get(disposition) ?? 0}) -> &errors.push("denominator disposition count is stale: {disposition}")
        }
    } else -> &errors.push("denominator dispositions are required")
    consumers :: capability_status_field(relation, "consumers")
    loop consumer in [String]{"inspect", "hardening", "learner", "release"} {
        value :: consumers.and_then((value) -> capability_status_field(value, consumer)) ?? {
            &errors.push("consumer metadata is missing: {consumer}")
            next
        }
        if capability_status_field(value, "relation").and_then(capability_status_string) != Val("manifest.capability_relation.rows") -> &errors.push("consumer relation is not canonical: {consumer}")
        if consumer == "release" && capability_status_field(value, "candidate").and_then(capability_status_string) != Val("row.candidate_identity") -> &errors.push("release consumer candidate is not canonical")
    }
    if errors.is_empty() -> return
    Err(errors.join("; "))
}

// Rust: Source/CmdInspect.rs:5530
fn capability_relation_status(value: StatusValue) -> String {
    capability_status_field(value, "status").and_then(capability_status_string) ?? "unavailable"
}

// Rust: Source/CmdInspect.rs:5536
fn capability_relation_has_candidate_evidence(value: StatusValue) -> Bool {
    rows :: if capability_status_field(value, "rows") == .Val(.Array(rows)) -> rows else -> { return false }
    if rows.is_empty() -> return false
    loop row in rows {
        if capability_status_field(row, "counted").and_then(capability_status_bool) != Val(true) -> return false
        disposition :: capability_status_field(row, "disposition").and_then(capability_status_string)
        if disposition == {
            .Val("owner-ratified-not-applicable") -> {}
            .Val("passed") -> {
                passed :: capability_status_field(row, "evidence").and_then((value) -> capability_status_field(value, "status")).and_then(capability_status_string) == Val("passed")
                available :: capability_status_field(row, "candidate_identity").and_then((value) -> capability_status_field(value, "status")).and_then(capability_status_string) == Val("available")
                if !passed || !available -> return false
            }
            else -> { return false }
        }
    }
    true
}

// Rust: Source/CmdInspect.rs:5563
pub fn capability_relation_projection(root: OSPath) -[FS.Read]> StatusValue Err! {
    path :: root.join(".jet/hardening-manifest.json")
    unavailable :: (reason: String) -> StatusValue.object(StatusFields.new().with("schema", CAPABILITY_RELATION_SCHEMA).with("status", "unavailable").with("relation", "manifest.capability_relation.rows").with("path", path.display()).with("reason", ^reason).with("rows", StatusValue.array([StatusValue]{})))
    // GATE #4494 / #4409: real read_to_string with native NotFound fidelity.
    raw :: fs.read_to_string(path) ?? {
        if err.kind() == std.io.ErrorKind.NotFound -> return Ok(unavailable("capability relation source `{path.display()}` is absent"))
        return Err("can't read canonical capability relation source `{path.display()}`: {err}")
    }
    manifest :: StatusValue.parse(raw) ?? return Err("can't parse canonical manifest `{path.display()}`: {err}")
    validate_hardening_manifest(manifest) ?? return Err("canonical manifest `{path.display()}` is invalid: {err}")
    relation :: capability_status_field(manifest, "capability_relation") ?? return Ok(unavailable("manifest has no capability_relation evidence"))
    if !(relation == .Object(_)) -> return Err("canonical manifest `{path.display()}` has a non-object capability_relation")
    validate_capability_relation(manifest, relation) ?? return Err("canonical capability relation `{path.display()}` is invalid: {err}")
    fields :: if relation == .Object(fields) -> fields else -> panic("capability relation object was checked above")
    projection := StatusFields.new()
    loop (name, value) in fields.iter() {
        if name == "status" || name == "relation" || name == "path" -> next
        &projection.insert(~name, ~value) ?? panic("manifest capability relation fields must be unique")
    }
    &projection.insert("status", "available") ?? panic("capability relation status field must be unique")
    &projection.insert("relation", "manifest.capability_relation.rows") ?? panic("capability relation route field must be unique")
    &projection.insert("path", path.display()) ?? panic("capability relation path field must be unique")
    Ok(StatusValue.object(^projection))
}

// Rust: Source/CmdInspect.rs:5643
// inspect claims consumes this exact manifest relation, not diagnostic observations.
const RELEASE_CLAIM_SOURCE: String = "manifest.capability_relation.rows"

// Rust: Source/CmdInspect.rs:5645
fn release_claim_rows(relation: StatusValue) -> [StatusValue] {
    rows :: if capability_status_field(relation, "rows") == .Val(.Array(rows)) -> rows else -> { return [] }
    claims := [StatusValue]{}
    loop row in rows {
        row_id :: capability_status_field(row, "row_id").and_then(capability_status_string) ?? { next }
        capability :: capability_status_field(row, "capability_id").and_then(capability_status_string) ?? { next }
        mode :: capability_status_field(row, "mode").and_then(capability_status_string) ?? { next }
        disposition :: capability_status_field(row, "disposition").and_then(capability_status_string) ?? { next }
        status :: capability_status_field(row, "status").and_then(capability_status_string) ?? disposition
        candidate :: capability_status_field(row, "candidate_identity") ?? StatusValue.Null
        counted :: capability_status_field(row, "counted").and_then(capability_status_bool) ?? false
        owner_link :: capability_status_field(row, "owner_link") ?? StatusValue.Null
        &claims.push(StatusValue.object(StatusFields.new().with("claim", row_id).with("capability", capability).with("mode", mode).with("disposition", disposition).with("status", status).with("counted", counted).with("owner_link", ~owner_link).with("candidate_identity", ~candidate)))
    }
    claims
}

// Rust: Source/CmdInspect.rs:5690
fn run_claims(file: String, json: Bool) -> {
    source_path :: OSPath.of(file)
    base :: source_path.parent().filter((parent) -> !parent.as_os_str().is_empty()) ?? OSPath.of(".")
    root :: jet.Loader.find_package_root_checked(base).ok().flatten() ?? ~base
    relation :: capability_relation_projection(root) ?? {
        cli_error_fix("E2105", err, "regenerate the canonical `.jet/hardening-manifest.json` and rerun inspect claims")
        env.exit(ExitCodes.USER_ERROR) // GATE #4494
    }
    release :: jet.Manifest.current_release_status()
    claims :: release_claim_rows(relation)
    relation_ready :: capability_relation_status(relation) == "available" && capability_relation_has_candidate_evidence(relation)
    // Complete relation is necessary, never sufficient while policy remains future.
    release_ready :: release.policy_active() && release.readiness() == "ready" && relation_ready
    if json {
        release_value :: StatusValue.object(StatusFields.new().with("version", jet.Manifest.COMPILER_VERSION).with("status", release.channel()).with("disposition", release.disposition()).with("readiness", release.readiness()).with("compatibility_policy", release.policy()).with("compatibility_policy_disposition", release.policy_disposition()).with("compatibility_policy_active", release.policy_active()))
        fields :: StatusFields.new().with("file", file).with("source", RELEASE_CLAIM_SOURCE).with("release", ^release_value).with("release_ready", release_ready).with("capability_relation", relation).with("claims", StatusValue.array(claims))
        print("{StatusEnvelope.new(\"inspect.claims\", release_ready).with_fields(fields).json()}")
    } else {
        print("claims")
        active :: if release.policy_active() -> "active" else -> "not active"
        print("release: {release.channel()} (disposition: {release.disposition()}; readiness: {release.readiness()}; 1.0 compatibility policy: {release.policy()} [{release.policy_disposition()}; {active}])")
        print("claim source: {RELEASE_CLAIM_SOURCE}")
        ready :: if release_ready -> "yes" else -> "no"
        print("release ready: {ready}")
        print("capability relation: {capability_relation_status(relation)}")
        if claims.is_empty() -> print("none")
        else {
            loop claim in claims {
                if !(claim == .Object(_)) -> next
                field :: (name: String) -> capability_status_field(claim, name).and_then(capability_status_string) ?? "unknown"
                print("{field(\"claim\")} {field(\"mode\")} {field(\"disposition\")}")
            }
        }
    }
}

// Rust: Source/CmdInspect.rs:5793
fn plain_number(name: String) -> Bool { name == "Int" || name == "Float" || name == "Decimal" }
// Rust: Source/CmdInspect.rs:5797
fn operator_symbol(trait_name: String) -> String? {
    if trait_name == { "Add" -> Val("+"); "Sub" -> Val("-"); "Mul" -> Val("*"); "Div" -> Val("/"); else -> None }
}
