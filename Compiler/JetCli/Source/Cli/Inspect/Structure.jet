// Rust: Source/CmdStructure.rs:1
// Projects checked structure facts and the structure slice of the one gate ledger.
// No second analyzer; these facts never flow to codegen.
use jet.[Sema, Policy, Driver, Diagnostics, AST, ExitCodes, render_all_colored]
use jet_foundation.[core_bootstrap_order, core_modules, CoreLeafKind, CORE_ROOT_TYPES,
    StructureFact, Registry, StatusEnvelope, StatusFields, StatusValue]
use crate.[absolutize, cli_error, machine_report_path_for_process, machine_report_path_for_bundle]
use std.[fs, process]

// Rust: Source/CmdStructure.rs:18
pub fn run_structure(args: &[String], json: Bool, color: Bool, gates: Policy.GateSet) -> {
    if args.iter().any(argument -> argument == "--core") {
        if json { render_core_json() } else { render_core_text() }
        return
    }
    path :: if entry_file(args) == {
        Val(path) -> path
        None -> {
            cli_error.full("E2104", "`jet inspect structure` needs an entry file",
                "structure facts come from one checked Jet entry file",
                "run `jet inspect structure Examples/features/basics/hello.jet`")
            // GATE #4494: native process exit.
            process.exit(ExitCodes.USAGE)
        }
    }
    abs :: absolutize(path)
    // Preserve relative provenance while loading from the same working directory.
    entry :: path
    (diagnostics, maybe_bundle, facts) :: Driver.check_file_with_effect_facts(entry, None, false)
    has_errors :: diagnostics.iter().any(diagnostic -> diagnostic.severity == Diagnostics.Severity.Error)
    bundle :: if (if has_errors { None } else { maybe_bundle }) == {
        Val(bundle) -> bundle
        None -> {
            if !facts.name_ledger.structure_facts().is_empty() {
                ledger := Sema.GateLedger.GateLedger.default()
                ledger.append_structure_facts(facts.name_ledger)
                if json { render_json(facts.name_ledger.structure_facts(), ledger) }
                else { render_text(facts.name_ledger.structure_facts(), ledger) }
            }
            render_frontend_diagnostics(entry, abs, diagnostics, json, color)
        }
    }
    ledger :: Sema.GateLedger.GateLedger.collect(bundle, gates)
    if !ledger.diagnostics().is_empty() { render_gate_diagnostics(ledger, bundle, json, color) }
    if json { render_json(facts.name_ledger.structure_facts(), ledger) }
    else { render_text(facts.name_ledger.structure_facts(), ledger) }
}
// Rust: Source/CmdStructure.rs:72
fn entry_file(args: &[String]) -> String? {
    args.iter().find(argument -> !argument.starts_with("-")).cloned()
}
// Rust: Source/CmdStructure.rs:78
fn render_core_text() -> {
    println("core")
    println("bootstrap:")
    loop (index, step) in core_bootstrap_order().iter().enumerate() {
        dependencies :: if step.dependencies.is_empty() { "none" } else { step.dependencies.join(", ") }
        println("  {index + 1}. {step.name}  depends_on [{dependencies}]")
    }
    println("root types: {CORE_ROOT_TYPES.join(\", \")}")
    println("modules: {core_modules().len()}")
    loop module in core_modules() {
        dependencies :: if module.dependencies.is_empty() { "none" } else { module.dependencies.join(", ") }
        println("  module {module.module}  depends_on [{dependencies}]")
        println("    members: {module.members.join(\", \")}")
        if module.type_exports.is_empty() { println("    types: (none)") }
        else {
            println("    types:")
            loop (name, kind) in module.type_exports { println("      {name} ({core_leaf_kind_text(kind)})") }
        }
    }
}
// Rust: Source/CmdStructure.rs:116
fn core_leaf_kind_text(kind: CoreLeafKind) -> String {
    if kind == {
        .Plain -> "plain"
        .CryptoNominal -> "crypto_nominal"
        .Generic(arity) -> "generic({arity})"
        .Enum(variants) -> "enum [{variants.join(\", \")}]"
    }
}
// Rust: Source/CmdStructure.rs:127
fn core_type_json(name: String, kind: CoreLeafKind) -> StatusValue {
    kind_name :: if kind == { .Plain -> "plain"; .CryptoNominal -> "crypto_nominal"; .Generic(_) -> "generic"; .Enum(_) -> "enum" }
    fields := StatusFields.new().with("name", name).with("kind", kind_name)
    if kind == {
        .Enum(variants) -> fields = fields.with("variants", StatusValue.array(variants.iter().map(value -> StatusValue.from(value))))
        _ -> {}
    }
    StatusValue.object(fields)
}
// Rust: Source/CmdStructure.rs:148
fn render_core_json() -> {
    bootstrap :: StatusValue.array(core_bootstrap_order().iter().map(step ->
        StatusValue.object(StatusFields.new().with("name", step.name)
            .with("dependencies", StatusValue.array(step.dependencies.iter().map(value -> StatusValue.from(value)))))))
    roots :: StatusValue.array(CORE_ROOT_TYPES.iter().map(value -> StatusValue.from(value)))
    modules :: StatusValue.array(core_modules().iter().map(module ->
        StatusValue.object(StatusFields.new().with("module", module.module)
            .with("members", StatusValue.array(module.members.iter().map(value -> StatusValue.from(value))))
            .with("type_exports", StatusValue.array(module.type_exports.iter().map(item -> core_type_json(item.0, item.1))))
            .with("dependencies", StatusValue.array(module.dependencies.iter().map(value -> StatusValue.from(value)))))))
    core :: StatusValue.object(StatusFields.new().with("bootstrap", bootstrap).with("root_types", roots).with("modules", modules))
    println("{StatusEnvelope.new(\"inspect.structure\", true).with_field(\"core\", core).json()}")
}
// Rust: Source/CmdStructure.rs:198
fn render_text(facts: &[StructureFact], ledger: &Sema.GateLedger.GateLedger) -> {
    println("structure")
    loop row in Registry.structure_rows() { println("  {row.name}  safe={row.safe_direction.name()}  gates={row.gates.join(\", \")}") }
    println("facts: {facts.len()}")
    if facts.is_empty() { println("  (none in this program)") }
    else {
        loop fact in facts {
            println("  {fact.kind.name()}  {fact.source}:{fact.span.start}..{fact.span.end}  {fact.subject}  {fact.status} — {fact.detail}")
        }
    }
    gates :: ledger.entries().iter().filter(entry -> entry.kind == Sema.GateLedger.GateKind.Structure).collect()
    println("gates: {gates.len()}")
    if gates.is_empty() { println("  (none in this program)") }
    else {
        loop entry in gates {
            start :: entry.span.map_or(0, span -> span.start)
            end :: entry.span.map_or(0, span -> span.end)
            reason :: entry.reason ?? "unknown"
            println("  {entry.scope}  {entry.source}:{start}..{end}  {entry.subject}  {reason} — {entry.detail}")
            loop provenance in &entry.provenance { println("    provenance {provenance}") }
        }
    }
}
// Rust: Source/CmdStructure.rs:254
fn render_json(facts: &[StructureFact], ledger: &Sema.GateLedger.GateLedger) -> {
    rows :: StatusValue.array(Registry.structure_rows().map(row ->
        StatusValue.object(StatusFields.new().with("name", row.name).with("safe_direction", row.safe_direction.name())
            .with("gates", StatusValue.array(row.gates.iter().map(value -> StatusValue.from(value)))).with("decision", row.decision))))
    fact_values :: StatusValue.array(facts.iter().map(fact -> {
        span :: StatusValue.object(StatusFields.new().with("start", fact.span.start).with("end", fact.span.end))
        gate :: fact.gate.map(value -> StatusValue.from(value)) ?? StatusValue.Null
        registry :: Registry.structure_row(fact.kind).map(row -> row.name) ?? fact.kind.name()
        StatusValue.object(StatusFields.new().with("kind", fact.kind.name()).with("registry", registry)
            .with("subject", fact.subject).with("source", fact.source).with("span", span)
            .with("status", fact.status).with("detail", fact.detail).with("gate", gate))
    }))
    gates :: StatusValue.array(ledger.entries().iter().filter(entry -> entry.kind == Sema.GateLedger.GateKind.Structure).map(entry -> {
        span :: StatusValue.object(StatusFields.new().with("start", entry.span.map_or(0, span -> span.start))
            .with("end", entry.span.map_or(0, span -> span.end)))
        reason :: entry.reason.map(value -> StatusValue.from(value)) ?? StatusValue.Null
        status :: entry.status.map(value -> StatusValue.from(value)) ?? StatusValue.Null
        provenance :: StatusValue.array(entry.provenance.iter().map(value -> StatusValue.from(value)))
        StatusValue.object(StatusFields.new().with("kind", entry.kind.name()).with("scope", entry.scope)
            .with("source", entry.source).with("span", span).with("subject", entry.subject)
            .with("reason", reason).with("status", status).with("detail", entry.detail).with("provenance", provenance))
    }))
    structure :: StatusValue.object(StatusFields.new().with("rows", rows).with("facts", fact_values).with("gates", gates))
    println("{StatusEnvelope.new(\"inspect.structure\", true).with_field(\"structure\", structure).json()}")
}
// Rust: Source/CmdStructure.rs:351
fn render_frontend_diagnostics(entry: String, path: &OSPath, diagnostics: &[Diagnostics.Diagnostic], json: Bool, color: Bool) -> Never {
    // GATE #4494: native filesystem and process exit.
    source :: fs.read_to_string(path).unwrap_or_default()
    if json {
        reports :: diagnostics.iter().map(diagnostic -> diagnostic.to_report(machine_report_path_for_process(entry), source))
        print("{StatusEnvelope.new(\"inspect.structure\", false).with_reports(reports).json()}")
    } else {
        loop diagnostic in diagnostics { eprint("{render_all_colored(entry, source, [diagnostic], color)}") }
    }
    process.exit(ExitCodes.USER_ERROR)
}
// Rust: Source/CmdStructure.rs:383
fn render_gate_diagnostics(ledger: &Sema.GateLedger.GateLedger, bundle: &AST.ProgramBundle, json: Bool, color: Bool) -> Never {
    if json {
        reports :: ledger.diagnostics().iter().map(diagnostic -> {
            source :: bundle.modules.iter().find(module -> module.display == diagnostic.source).map(module -> module.source) ?? ""
            file :: machine_report_path_for_bundle(bundle, diagnostic.source)
            diagnostic.diagnostic.to_report(file, source)
        })
        print("{StatusEnvelope.new(\"inspect.structure\", false).with_reports(reports).json()}")
    } else {
        loop diagnostic in ledger.diagnostics() {
            source :: bundle.modules.iter().find(module -> module.display == diagnostic.source).map(module -> module.source) ?? ""
            eprint("{render_all_colored(diagnostic.source, source, [diagnostic.diagnostic], color)}")
        }
    }
    // GATE #4494: native process exit.
    process.exit(ExitCodes.USER_ERROR)
}
