// Rust: Source/CmdSchema.rs:1
// Published schema inspection and snapshot-only re-baselining. Build's E0910
// remains the authoritative check; squash never edits user source.
use jet.[ExitCodes, Syntax, Publish, Loader, Traits, Sema, AST]
use crate.[find_project_entry, require_manifest_root, cli_error]
use std.[env, process]

// Rust: Source/CmdSchema.rs:25
pub fn run_schema(args: &[String]) -> {
    verb :: args.first()
    if verb == {
        Val(value) if value == Syntax.SCHEMA_VERB_STATUS -> run_status()
        Val(value) if value == Syntax.SCHEMA_VERB_SQUASH -> run_squash(flag_value(args, "--before"))
        other -> {
            fix :: "use `jet inspect schema {Syntax.SCHEMA_VERB_STATUS}` to inspect published schemas, or `jet inspect schema {Syntax.SCHEMA_VERB_SQUASH} --before <version>` to re-baseline them"
            if other == {
                Val(value) -> cli_error.with_fix("E2101", "`jet inspect schema {value}` isn't a schema command", fix)
                None -> cli_error.with_fix("E2104", "`jet inspect schema` needs a verb", fix)
            }
            // GATE #4494: native process exit.
            process.exit(ExitCodes.USER_ERROR)
        }
    }
}
// Rust: Source/CmdSchema.rs:52
fn project_root() -> OSPath {
    // GATE #4494: native working directory.
    cwd :: env.current_dir().unwrap_or_else(_ -> OSPath.from("."))
    require_manifest_root(cwd, "error: no package.jet found — run `jet inspect schema` inside a project")
}
// Rust: Source/CmdSchema.rs:61
fn run_status() -> {
    root :: project_root()
    snaps :: Publish.load_all_snapshots(root)
    if snaps.is_empty() {
        println("no published schemas yet.")
        println("note: a `#PublishedSchema` struct is snapshotted into .jet/cache/schema/ on `jet registry publish`.")
        return
    }
    pending :: pending_breaks(root)
    println("published schemas in this project:\n")
    loop snap in &snaps {
        print("  {snap.type_name} — published {snap.published_version}")
        if snap.squashed_before == { Val(before) -> print(" (squashed before {before})"); None -> {} }
        println("")
        println("    {snap.fields.len()} field(s):")
        loop field in &snap.fields { println("      {field.name}: {field.ty}") }
        if pending.iter().any(name -> name == snap.type_name) {
            println("    pending: a breaking change vs this snapshot — `jet build` would report E0910")
        }
        println("")
    }
}
// Rust: Source/CmdSchema.rs:104
fn pending_breaks(root: &OSPath) -> [String] {
    entry :: find_project_entry(root)
    entry_str :: entry.to_string_lossy().to_string()
    if !entry.is_file() { return [] }
    out := [String]{}
    if Loader.load_entry_with_overlay(entry_str, None, true) == {
        Ok(bundle) -> {
            loop module in &bundle.modules {
                // Advisory only: named types are trusted without the populated trait
                // registry. Build's populated-registry check remains authoritative.
                reg :: Traits.TraitRegistry.default()
                diags :: Sema.check_schema_migrations(module.items, bundle.project_root, reg)
                if diags.is_empty() { next }
                loop item in &module.items {
                    if item == {
                        .Struct(s) -> {
                            if s.is_published_schema && diags.iter().any(d -> d.what.contains("`{s.name}`")) { out.push(s.name.clone()) }
                        }
                        _ -> {}
                    }
                }
            }
        }
        Err(_) -> {}
    }
    out.sort()
    out.dedup()
    out
}
// Rust: Source/CmdSchema.rs:146
fn run_squash(before: String?) -> {
    cutoff :: if before == {
        Val(value) -> value
        None -> {
            cli_error.full("E2104", "`jet inspect schema {Syntax.SCHEMA_VERB_SQUASH}` needs `--before <version>`",
                "squash re-baselines to the current shape and marks migrations before a version as no longer required, so it needs that cutoff version",
                "run `jet inspect schema {Syntax.SCHEMA_VERB_SQUASH} --before 2.0.0` (the version whose migrations you want to retire)")
            // GATE #4494: native process exit.
            process.exit(ExitCodes.USER_ERROR)
        }
    }
    root :: project_root()
    entry :: find_project_entry(root)
    version :: Loader.package_facts_for_entry(entry).ok().flatten().and_then(facts -> facts.version) ?? "0.0.0"
    entry_str :: entry.to_string_lossy().to_string()
    bundle :: if Loader.load_entry_with_overlay(entry_str, None, true) == {
        Ok(bundle) -> bundle
        Err(_) -> {
            cli_error("E2105", "couldn't load the project to read its current schema shape")
            // GATE #4494: native process exit.
            process.exit(ExitCodes.USER_ERROR)
        }
    }
    count := 0
    loop module in &bundle.modules {
        loop item in &module.items {
            if item == {
                .Struct(s) -> {
                    if s.is_published_schema {
                        snap := Publish.snapshot_from_struct(s, version)
                        snap.squashed_before = Val(cutoff.to_string())
                        if Publish.save_snapshot(root, snap).is_ok() {
                            count += 1
                            println("  re-baselined `{s.name}` to version {version} (squashed before {cutoff})")
                        }
                    }
                }
                _ -> {}
            }
        }
    }
    if count == 0 { println("no `#PublishedSchema` structs found — nothing to squash.") }
    else {
        println("\nok: {count} snapshot(s) re-baselined. Migration blocks for versions before {cutoff} are no longer required.")
        println("note: this rewrote .jet/cache/schema/ only — your source is unchanged. Commit the updated snapshots.")
    }
}
// Rust: Source/CmdSchema.rs:208
fn flag_value(args: &[String], flag: String) -> String? {
    index := 0
    loop index < args.len() {
        argument :: &args[index]
        if argument.strip_prefix("{flag}=") == { Val(rest) -> return Val(rest.to_string()); None -> {} }
        if argument == flag { return args.get(index + 1).cloned() }
        index += 1
    }
    None
}
