    JetCLIHandlerSpec{key: "Cache", dispatch_word: "cache", keeps_group: true},
    JetCLIHandlerSpec{key: "Perf", dispatch_word: "perf", keeps_group: true},
    JetCLIHandlerSpec{key: "Reserved", dispatch_word: "reserved", keeps_group: false},
    JetCLIHandlerSpec{key: "Db", dispatch_word: "db", keeps_group: true},
} }

