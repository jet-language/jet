// The one `jet` command table (D-JETCLI-HOST1=A): every top-level command,
// nested group action, dispatcher seam, and flag that argv parsing, help, man,
// and completions read. Order is the man-page and completion order; `jet help`
// lists commands by `frequency_rank` (1 = most used), which
// `node Tools/cli-census/census.mjs` measures and writes here.
//
// The Rust host keeps a frozen copy in crates/jet-cli/src/CLI.rs until the Jet
// CLI replaces it; `node Compiler/Bootstrap/check-command-table.mjs` fails when
// the two differ.

// One flag. A `With <cmd>[/<cmd>…]: ` help prefix scopes it to those commands;
// `--json`, `--quiet`, and `--color` apply to every command.
pub struct JetCLIFlagSpec {
    pub long: String
    pub help: String
}

// One dispatcher seam a nested action reaches. `key` names the Rust host's
// `HandlerKey` variant; `dispatch_word` is the handler word a grouped argv
// is normalized to unless `keeps_group` keeps the group word in front.
pub struct JetCLIHandlerSpec {
    pub key: String
    pub dispatch_word: String
    pub keeps_group: Bool
}

// One canonical nested spelling under a group (`jet registry publish`).
// `usage` holds one form per line; `handler` is a `JetCLIHandlerSpec.key`.
pub struct JetCLIActionSpec {
    pub name: String
    pub usage: String
    pub summary: String
    pub handler: String
    pub also_canonical_top_level: Bool
}

// One top-level command: a bare leaf (`build`) or a group with nested
// actions (`registry`). `headline` rows are the greeting's commands.
// `exhaustive` (groups only) means every subword is modeled by `actions`;
// `os`, `env`, and `db` expose a wider downstream verb surface.
// `usage` is the positional shape; None renders the generic `[args]`.
pub struct JetCLICommandSpec {
    pub name: String
    pub summary: String
    pub headline: Bool
    pub frequency_rank: Int
    pub exhaustive: Bool
    pub usage: String?
    pub actions: [JetCLIActionSpec]
}

pub JET_CLI_HANDLERS :: prep { [JetCLIHandlerSpec]{
    JetCLIHandlerSpec{key: "Publish", dispatch_word: "publish", keeps_group: false},
    JetCLIHandlerSpec{key: "Yank", dispatch_word: "yank", keeps_group: false},
    JetCLIHandlerSpec{key: "Keygen", dispatch_word: "keygen", keeps_group: false},
