    },
} }

pub JET_CLI_FLAGS :: prep { [JetCLIFlagSpec]{
    JetCLIFlagSpec{long: "--live", help: "With inspect: Process id for a live plane scope"},
    JetCLIFlagSpec{long: "--observe", help: "With run: Expose bounded live runtime facts for attachment"},
    JetCLIFlagSpec{long: "--raw-frames", help: "With debug: Show generated Rust frames and scopes (expert)"},
    JetCLIFlagSpec{long: "--dap", help: "With debug: Speak the Debug Adapter Protocol over stdio"},
    JetCLIFlagSpec{long: "--gc-trace", help: "With run/dev: Record bounded automatic GC-promotion evidence"},
    JetCLIFlagSpec{long: "--structural", help: "With diff/merge: Compare checked definitions by semantic identity"},
    JetCLIFlagSpec{long: "--base-receipt", help: "With review: Proof receipt for the base change-set side"},
    JetCLIFlagSpec{long: "--receipt", help: "With review: Proof receipt for the reviewed change-set side"},
    JetCLIFlagSpec{long: "--out", help: "With structural merge: Write the checked result to this path"},
    JetCLIFlagSpec{long: "--repo", help: "With merge install-driver: Git worktree to configure"},
    JetCLIFlagSpec{long: "--json", help: "Emit machine-readable facts or diagnostics"},
    JetCLIFlagSpec{long: "--topic", help: "With inspect digest: Emit one digest topic"},
    JetCLIFlagSpec{long: "--to", help: "With publish/cache/db migrate: Foreign registry, prune target size, or migration target version"},
    JetCLIFlagSpec{long: "--list-topics", help: "With inspect digest: List digest topics"},
    JetCLIFlagSpec{long: "--kind", help: "With inspect gates/package: Filter one gate or bundle kind"},
    // #1659 criterion 3: one spelling, every command. Suppresses non-error
    // status/progress output (watch banners, hot-swap notices,
    // confirmations); never suppresses errors or requested data.
    JetCLIFlagSpec{long: "--quiet", help: "Suppress non-error status output"},
    JetCLIFlagSpec{long: "--color", help: "Color: auto | always | never"},
    JetCLIFlagSpec{long: "--version", help: "With package/new: Set bundle or migration version; global flag prints compiler version"},
    JetCLIFlagSpec{long: "--endpoint", help: "With self-update: Signed toolchain channel endpoint"},
    JetCLIFlagSpec{long: "--channel", help: "With self-update: Toolchain channel name"},
    JetCLIFlagSpec{long: "--platform", help: "With self-update: Toolchain target triple"},
    JetCLIFlagSpec{long: "--trust-key", help: "With self-update: Public trust-key file"},
    JetCLIFlagSpec{long: "--apply", help: "With self-update/generate/new: Apply the verified artifact or planned source writes"},
    JetCLIFlagSpec{long: "--preview", help: "With new: Preview deterministic backend source writes without applying them"},
    JetCLIFlagSpec{long: "--remove", help: "With new: Remove only unchanged outputs recorded by the scaffold receipt"},
    JetCLIFlagSpec{long: "--path", help: "With new: Route or output path, defaulting to `/<name>`"},
    JetCLIFlagSpec{long: "--route", help: "With new: Alias for `--path`"},
    JetCLIFlagSpec{long: "--model", help: "With new: Model name recorded beside the route source"},
    JetCLIFlagSpec{long: "--allow-unofficial", help: "With self-update: Explicitly allow a local keyless channel"},
    JetCLIFlagSpec{long: "--check", help: "With fmt/learn: Check without changing files (CI gate)"},
    JetCLIFlagSpec{long: "--lang", help: "With fmt: Delegate non-Jet files to the environment formatter for this language"},
    JetCLIFlagSpec{long: "--restore-role-files", help: "With init: Restore the exact pre-package.jet role files"},
    JetCLIFlagSpec{long: "--diff", help: "With fmt --check: Also print unified diffs for each changed file"},
    JetCLIFlagSpec{long: "--simplify", help: "With fmt: Rewrite to the simplest ratified spelling"},
    JetCLIFlagSpec{long: "--changed", help: "With fmt: Format only VCS-changed .jet files (requires git)"},
    JetCLIFlagSpec{long: "--explicit-copies", help: "With fmt: Materialize implicit read-view copies as `~`"},
    JetCLIFlagSpec{long: "--skipped", help: "With project parts: Show modules omitted from automatic discovery"},
    JetCLIFlagSpec{long: "--stdin-path", help: "With fmt -: Path label used in diagnostics when reading from stdin"},
    JetCLIFlagSpec{long: "--small", help: "With build/run/jobs: Favor a smaller binary"},
    JetCLIFlagSpec{long: "--lib", help: "With build: Emit the native Library and C header"},
    JetCLIFlagSpec{long: "--output", help: "With build/run/dev/jobs/package: Select a named output (build --lib selects a Library; Canvas uses it as the initial selection)"},
    JetCLIFlagSpec{long: "--locked", help: "With build/fetch/jobs/run: Require locked dependency and provenance facts"},
    JetCLIFlagSpec{long: "--effect", help: "With find: Require an effect such as FS.Read"},
    JetCLIFlagSpec{long: "--example", help: "With find: Search by input/output example"},
    // D-CLI-STORE2=A: script locking folds into `fetch`, not a separate verb.
    JetCLIFlagSpec{long: "--lock", help: "With fetch/db migrate/new: Lock dependency fetching or choose a migration/scaffold lock policy"},
    JetCLIFlagSpec{long: "--read-only", help: "With shared-store enroll: Grant read-only broker access"},
    JetCLIFlagSpec{long: "--host", help: "With cache limit: Host-wide store cap"},
    JetCLIFlagSpec{long: "--fd", help: "With shared-store broker: Inherited broker socket descriptor"},
    // D-CLI-BARE1=A / D-TASKS-LIST1=A: select one workspace member.
    JetCLIFlagSpec{long: "-p", help: "With run/dev/debug/check/build/jobs: Pick a workspace member by name"},
    JetCLIFlagSpec{long: "--annotated", help: "With new: Include commented example deps"},
    JetCLIFlagSpec{long: "--force", help: "With publish: Bypass pre-publish gate (with warning)"},
    // #1659 criterion 1 (round 2): these 8 flags previously lived only in
    // usage-string prose (`NestedCommandSpec::usage`), invisible to
    // `is_known_flag`/`closest_flag` (E2102 "did you mean"), the man page,
    // and shell completions. Real rows here fix all three renderers at once.
    JetCLIFlagSpec{long: "--no-sign", help: "With publish: Skip the optional author signature (registry metadata is still signed)"},
    JetCLIFlagSpec{long: "--registry", help: "With keygen/key: Registry name to generate or manage a signing key for"},
    JetCLIFlagSpec{long: "--pkg", help: "With bind: Library name for the generated binding module"},
    JetCLIFlagSpec{long: "--shape", help: "With bind: Binding facade shape: automatic or native"},
    JetCLIFlagSpec{long: "--freeze", help: "With bind: Record the resolved binding plan in the project lock"},
    JetCLIFlagSpec{long: "--policy", help: "With bind: Binding policy: automatic or frozen"},
    JetCLIFlagSpec{long: "--accept", help: "With bind --update: Accept exactly this candidate plan digest"},
    JetCLIFlagSpec{long: "--import", help: "With build: Import and inspect an existing foreign build graph"},
    JetCLIFlagSpec{long: "--clang", help: "With bind cpp: Path to the clang binary used to parse the header"},
    JetCLIFlagSpec{long: "--ar", help: "With bind cpp: Path to the ar archiver used to build the static library"},
    JetCLIFlagSpec{long: "--before", help: "With schema squash: Re-baseline migrations before this version"},
    JetCLIFlagSpec{long: "--spdx", help: "With sbom: Emit SPDX tag-value format (default)"},
    JetCLIFlagSpec{long: "--cyclonedx", help: "With sbom: Emit CycloneDX JSON format"},
    JetCLIFlagSpec{long: "--advisory-db", help: "With audit: Path to advisory database file"},
    JetCLIFlagSpec{long: "--vendor-dir", help: "With vendor: Directory to copy dependencies into (default vendor/)"},
    JetCLIFlagSpec{long: "--sbom", help: "With build: Also write an SPDX SBOM next to the binary"},
    JetCLIFlagSpec{long: "--verbose", help: "With build/jobs: Print the bridge steps; with check: print the status line, proof rows, and receipt notices; with run/dev/test: show advisory lints; with explain: show a syntax token's registry name and decision"},
    JetCLIFlagSpec{long: "--template", help: "With new: Start from a named template: cli, ui, web, or overrides"},
    JetCLIFlagSpec{long: "--sort", help: "With help: Order commands by use (frequency, the default), A to Z (az), or Z to A (za)"},
    JetCLIFlagSpec{long: "--online", help: "With doctor: Allow network checks"},
    JetCLIFlagSpec{long: "--fix", help: "With doctor: Apply auto-fixable problems"},
    JetCLIFlagSpec{long: "--dry-run", help: "With package/rewrite commands/generate: Preview changes without writing"},
    JetCLIFlagSpec{long: "--entry", help: "With generate: Source file containing the generator job"},
    JetCLIFlagSpec{long: "--keep", help: "With try: Keep a clean speculative edit"},
    JetCLIFlagSpec{long: "--edition", help: "With fix: Apply edition migration rewrites --edition=<year>"},
    JetCLIFlagSpec{long: "--all", help: "With fix: Apply safety classes beyond formatting and behavior-preserving"},
    JetCLIFlagSpec{long: "--try-anyway", help: "With dev: Interpret past unsupported features (no guarantees)"},
    JetCLIFlagSpec{long: "--interpret", help: "With dev/jobs: Force the tier-0 TIR interpreter"},
    JetCLIFlagSpec{long: "--trace-tiers", help: "With run/dev: Print per-function Cranelift vs interpreter tier selection; with test: print AOT marker"},
    JetCLIFlagSpec{long: "--restart", help: "With dev: Always rerun from scratch after a save"},
    JetCLIFlagSpec{long: "--swap", help: "With dev: Hot-swap compatible edits and restart after type changes"},
    JetCLIFlagSpec{long: "--reload", help: "With explain: Explain the checked reload decision for a source or project path"},
    JetCLIFlagSpec{long: "--watch", help: "With run/dev/learn/test/jobs: Re-run on dependency changes; test default off with r=failed, a=all, o=output; jobs accepts --watch[=<on|off>]; --watch=off runs once"},
    JetCLIFlagSpec{long: "--graph", help: "With jobs: Show the checked job dependency graph"},
    JetCLIFlagSpec{long: "--status", help: "With jobs: Show fresh or stale status for declared jobs"},
    JetCLIFlagSpec{long: "--explain", help: "With jobs/package: Explain dependencies, phases, cache identity, and admission facts"},
    JetCLIFlagSpec{long: "--canvas", help: "With dev: Open the full Canvas IDE over this dev session"},
    JetCLIFlagSpec{long: "--app", help: "With dev: Select a checked local-app function"},
    JetCLIFlagSpec{long: "--share", help: "With dev: Select local-app sharing authority: loopback or lan"},
    JetCLIFlagSpec{long: "--canvas-host", help: "With dev: With --canvas, bind host (loopback by default)"},
    JetCLIFlagSpec{long: "--canvas-port", help: "With dev: With --canvas, bind an explicit port"},
    JetCLIFlagSpec{long: "--canvas-transport", help: "With dev: With --canvas, select the named transport"},
    JetCLIFlagSpec{long: "--canvas-authority", help: "With dev: With --canvas, select loopback or remote authority"},
    JetCLIFlagSpec{long: "--canvas-audit", help: "With dev: With --canvas, enable request/rebuild audit output"},
    // E2-M18 REPL flags.
    JetCLIFlagSpec{long: "--project", help: "With repl: Load package settings and imports from this directory"},
    JetCLIFlagSpec{long: "--console", help: "With repl: Open the project-loaded capability-gated console"},
    JetCLIFlagSpec{long: "--sandbox", help: "With repl: Use the reversible data sandbox (`--sandbox data`)"},
    JetCLIFlagSpec{long: "--console-ttl", help: "With repl: Expire console authority after this many milliseconds"},
    // E3 interactive scripting flags.
    JetCLIFlagSpec{long: "--protocol", help: "With notebook: Use the bounded headless JSONL/script session"},
    JetCLIFlagSpec{long: "--headless", help: "With notebook: Use the bounded headless session"},
    JetCLIFlagSpec{long: "--bind", help: "With notebook: Bind the local HTTP client to this address"},
    JetCLIFlagSpec{long: "--token", help: "With notebook/dev: Require a bearer token for the session"},
    // E2-M16 flags.
    // D-RUN-PREPARE1=A: `jet run` delegates project environment realization
    // to Jetpack unless the caller explicitly opts out.
    JetCLIFlagSpec{long: "--no-prepare", help: "With run: Refuse Jetpack project environment preparation"},
    JetCLIFlagSpec{long: "--pure", help: "With eval: Reject code with side effects"},
    JetCLIFlagSpec{long: "--allow", help: "With run/build/jobs/repl/db: Allow comma-separated effect roots or leaves as --allow=RIGHTS"},
    JetCLIFlagSpec{long: "--deny", help: "With run/build/jobs/repl/db: Deny comma-separated effect roots or leaves as --deny=RIGHTS"},
    JetCLIFlagSpec{long: "--offline", help: "With env/run/dev/test/cc/c++: Reuse only cached signed toolchain and package data"},
    JetCLIFlagSpec{long: "--fixtures", help: "With env/run/dev/test/cc/c++: Use an explicit fixture bundle"},
