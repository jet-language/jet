        usage: None,
        // D-PERFSESSION1=D: `jet perf` owns collection/view/compare/export. `run` and
        // `test` stay canonical top-level intents and also live here so the group help
        // lists the full family. Measurement remains a mode of the canonical test
        // intent, not another perf-session action.
        actions: [JetCLIActionSpec]{
            JetCLIActionSpec{name: "run", usage: "run", summary: "Run a program and write a .jettrace", handler: "Perf", also_canonical_top_level: true},
            JetCLIActionSpec{name: "test", usage: "test", summary: "Run tests and write a .jettrace", handler: "Perf", also_canonical_top_level: true},
            JetCLIActionSpec{name: "attach", usage: "attach", summary: "Attach to a running process and write a .jettrace", handler: "Perf", also_canonical_top_level: false},
            JetCLIActionSpec{name: "view", usage: "view", summary: "Show a .jettrace summary", handler: "Perf", also_canonical_top_level: false},
            JetCLIActionSpec{name: "compare", usage: "compare", summary: "Compare two .jettrace artifacts", handler: "Perf", also_canonical_top_level: false},
            JetCLIActionSpec{name: "export", usage: "export", summary: "Export a loss-declared projection of a .jettrace", handler: "Perf", also_canonical_top_level: false},
