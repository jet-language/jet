    JetCLIHandlerSpec{key: "Devtools", dispatch_word: "devtools", keeps_group: false},
    JetCLIHandlerSpec{key: "Lsp", dispatch_word: "lsp", keeps_group: false},
    JetCLIHandlerSpec{key: "Exec", dispatch_word: "exec", keeps_group: false},
