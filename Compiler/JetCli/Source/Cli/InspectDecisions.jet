// `jet inspect decisions`: the IR optimizer's report for the checked program,
// optimized at the level and with the inlining `jet build` compiles it with
// (jet_cli_native_level: O2, O0 under the `debug` profile; the build option
// flags over the profile), plus the functions the IR builder could not
// build, each counted loop sema's loop proof covers as it lowered
// (ir_loop_proof_rows), each masked branch (ir_masked_branch_rows), the main
// the build gives the program (JetIR EntryOwned.jet) and the invocation's
// selected canonical-pass gaps.
use {
    jet_driver.[JetDriverCompileMode, JetDriverLoweringInputs, JetDriverVerbOutput, JET_DRIVER_EXIT_OK, jet_driver_checked_declarations, jet_driver_present_diagnostics]
    jet_foundation.[BuildOptionChoice, BuildOptions, BuildOptionsResolved, CanonicalPassBoundaryGap, CanonicalPassOptions, CompilerThreads, build_option_flags, build_options_resolve, build_options_stock, build_options_value, canonical_pass_boundary_gaps]
    jet_ir.[IROptOptions, IROptReport, ir_build_program, ir_checks_stock, ir_entry_root_need, ir_loop_proof_rows, ir_masked_branch_rows, ir_optimize_module_measured, ir_opt_inline_of, ir_opt_options_from, ir_opt_report_text]
    decisions_sys: core.sys
}

JetCLIDecisions: struct {
    report: IROptReport
    // `name [key]: message at file:start..end` per function the IR builder
    // could not build; the optimizer ran over the rest.
    unbuilt: [String]
    // ir_loop_proof_rows of the built program.
    loops: [String]
    // ir_masked_branch_rows of the built program.
    masked: [String]
    // The program's main: "program-owned", or why it runs under the process
    // root (ir_entry_root_need).
    main: String
}

// The build options `jet inspect decisions` optimizes under, as `jet build`
// resolves them: the stock options, or those of the stock `profile`
// (`release` and `hardened` the `release` profile's, `debug` its own; `""`
// names none), with the build option flags of `options` (`--inline=off`,
// `--optimize=full`) over them; or the refusal of a flag.
jet_cli_decisions_options: fn(options: [String], profile: String) -> BuildOptionsResolved Never! {
    release: profile == "release" || profile == "hardened"
    written := [BuildOptionChoice]{}
    if release -> written.extend(jet_cli_stock_release_choices())
    if profile == "debug" -> written.extend(jet_cli_stock_debug_choices())
    if build_option_flags(options) == {
        .Refused(code, what, fix) -> return BuildOptionsResolved.Refused{code: code, what: what, fix: fix}
        .Resolved(given, _) -> loop flag in given.written -> written.push(flag.copy())
    }
    build_options_resolve("build", if release -> "release" else -> "", written)
}

// The optimizer's options at `level` with `build`'s (the build options)
// `small` (inlining kept to the O1 limits) and `inline` (which callees
// inlining takes), plus the environment's pass knobs: JET_OPT_DISABLE (pass
// names to skip), JET_OPT_VERIFY, JET_OPT_SSA_STRESS and JET_OPT_DUMP
// (Opt.jet IROptOptions).
jet_cli_opt_options: fn(level: Int, build: BuildOptions) -> IROptOptions {
    ir_opt_options_from(level, build_options_value(build, "small") == "true", ir_opt_inline_of(build_options_value(build, "inline")), decisions_sys.get("JET_OPT_DISABLE"), decisions_sys.get("JET_OPT_VERIFY"), decisions_sys.get("JET_OPT_SSA_STRESS"), decisions_sys.get("JET_OPT_DUMP"))
}

// Builds `inputs` into one IR module from its entry and optimizes it as
// `build` (the build options) has `jet build` do.
jet_cli_decisions: fn(inputs: &&JetDriverLoweringInputs, build: BuildOptions, threads: CompilerThreads) -> JetCLIDecisions {
    checked := inputs.move()
    declarations := jet_driver_checked_declarations(checked)
    built := ir_build_program(checked.functions.move(), checked.decls, declarations.type_defs.move(), declarations.impls.move(), checked.sources.move(), declarations.constants.move(), declarations.foreign.move(), checked.entry_key ?? "", ir_checks_stock(), threads)
    unbuilt := [String]{}
    loop failure in built.failures -> unbuilt.push("{failure.name} [{failure.key}]: {failure.message} at {failure.source_file}:{failure.span.start}..{failure.span.end}")
    loops: ir_loop_proof_rows(built.program)
    masked: ir_masked_branch_rows(built.program)
    need: ir_entry_root_need(built.program)
    main: if need == "" -> "program-owned" else -> "process root: {need}"
    report: ir_optimize_module_measured(built.program, jet_cli_opt_options(jet_cli_native_level(build), build), threads)
    JetCLIDecisions{report: report, unbuilt: unbuilt.move(), loops: loops, masked: masked, main: main}
}

jet_cli_decisions_report: fn(decisions: JetCLIDecisions, scope: String, file: String, profile: String, canonical_route_gaps: [CanonicalPassBoundaryGap], json: Bool) -> String Never! {
    r: decisions.report
    if !json {
        text := "decisions: scope={scope} source={file} profile={profile}\n{ir_opt_report_text(r)}\n"
        loop row in decisions.unbuilt -> text = "{text}unbuilt {row}\n"
        loop row in decisions.loops -> text = "{text}{row}\n"
        loop row in decisions.masked -> text = "{text}{row}\n"
        text = "{text}main: {decisions.main}\n"
        if canonical_route_gaps.len() > 0 -> text = "{text}{jet_cli_canonical_route_gap_text(canonical_route_gaps)}"
        return text
    }
    fields := [JetCLIStatusField]{
        jet_cli_status_field("scope", jet_cli_status_text(scope)), jet_cli_status_field("source", jet_cli_status_text(file)), jet_cli_status_field("profile", jet_cli_status_text(profile)),
        jet_cli_status_field("level", jet_cli_status_int(r.level)),
        jet_cli_status_field("instructions_before", jet_cli_status_int(r.instructions_before)), jet_cli_status_field("instructions_after", jet_cli_status_int(r.instructions_after)),
        jet_cli_status_field("inlined_calls", jet_cli_status_int(r.inlined_calls)), jet_cli_status_field("direct_calls", jet_cli_status_int(r.direct_calls)),
        jet_cli_status_field("folded", jet_cli_status_int(r.folded)), jet_cli_status_field("branches_folded", jet_cli_status_int(r.branches_folded)),
        jet_cli_status_field("compares_fused", jet_cli_status_int(r.compares_fused)), jet_cli_status_field("copies_coalesced", jet_cli_status_int(r.copies_coalesced)),
        jet_cli_status_field("dead_removed", jet_cli_status_int(r.dead_removed)), jet_cli_status_field("unreachable_removed", jet_cli_status_int(r.unreachable_removed)),
        jet_cli_status_field("aggregates_replaced", jet_cli_status_int(r.aggregates_replaced)),
        jet_cli_status_field("unbuilt", jet_cli_status_texts(decisions.unbuilt)),
        jet_cli_status_field("loop_proofs", jet_cli_status_texts(decisions.loops)),
        jet_cli_status_field("masked_branches", jet_cli_status_texts(decisions.masked)),
        jet_cli_status_field("main", jet_cli_status_text(decisions.main)),
    }
    // Explicit opt-in gaps are a separately labeled extension, never execution records.
    if canonical_route_gaps.len() > 0 -> fields.push(jet_cli_status_field("canonical_route_gaps", jet_cli_status_array(jet_cli_canonical_route_gap_values(canonical_route_gaps))))
    "{jet_cli_status_render("inspect.decisions", true, fields)}\n"
}

// The checked Program compile of the authorized sources under the job's
// profile, the check failure every inspect plane reports, then the IR
// optimizer's report. Canonical-route gaps are opt-in through the adapter
// evidence environment (`JET_ADAPTER_MODE` and comma-separated
// `JET_ADAPTER_OPERATION_IDS`).
jet_cli_inspect_decisions_host: fn(job: JetCLIInspectJob, source: String) -> JetDriverVerbOutput {
    output := JetDriverVerbOutput{stdout: "", stderr: "", exit_code: JET_DRIVER_EXIT_OK}
    prepared: jet_cli_prepare_overlays(job.file, job.file, [JetCLIOverlay]{}, job.color, job.threads, JetDriverCompileMode.Program)
    if prepared == {
        .Refused(refusal) -> output = refusal.move()
        .Prepared(value, _) -> {
            request := value.move()
            request.profile = job.profile
            ids: decisions_sys.get("JET_ADAPTER_OPERATION_IDS") ?? ""
            operation_ids := [String]{}
            if ids != "" -> operation_ids = ids.split(",").to_list()
            options: CanonicalPassOptions{adapter_mode: decisions_sys.get("JET_ADAPTER_MODE") ?? "", operation_ids: operation_ids.move()}
            sources := request.authorized_sources
            compiler_threads: request.compiler_threads.copy()
            front := jet_cli_lowering_inputs(request, None)
            errors: jet_cli_errors(jet_driver_present_diagnostics(front.compile.diagnostics, sources, front.compile.generated_source_files))
            if errors.len() > 0 -> jet_cli_inspect_finish(job, jet_cli_inspect_check_failed(job, source, errors))
            if front.compile.internal_problem == .Val(problem) -> jet_cli_inspect_finish(job, jet_cli_ice(problem))
            inputs := front.inputs.move() ?? jet_cli_inspect_finish(job, jet_cli_ice("the checked compile of `{job.file}` has no lowering inputs"))
            if inputs.entry_key == None -> jet_cli_inspect_finish(job, jet_cli_build_failed("`{job.file}` has no `run: fn` to optimize", "the IR optimizer reports the program reachable from its `run: fn`", "add `run: fn()` to the file, or check it with `jet check {job.file}`", job.color))
            threads: CompilerThreads{cap: compiler_threads.cap, cores: compiler_threads.cores, memory_available: jet_cli_memory_available()}
            build := build_options_stock("build")
            if job.build == .Val(given) -> build = given.copy()
            decisions: jet_cli_decisions(inputs, build, threads)
            report: jet_cli_decisions_report(decisions, job.scope, job.file, job.profile, canonical_pass_boundary_gaps(options), job.json)
            jet_cli_inspect_finish(job, JetDriverVerbOutput{stdout: report, stderr: "", exit_code: JET_DRIVER_EXIT_OK})
        }
    }
    output
}
