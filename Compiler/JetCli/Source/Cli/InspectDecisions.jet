// `jet inspect decisions`: the IR optimizer's report for the checked program,
// optimized at the level `jet build` compiles it (jet_cli_native_level: O1,
// O2 under a release profile), plus the functions the IR builder could not
// build and the invocation's selected canonical-pass gaps.
use jet_driver.[JetDriverCompileMode, JetDriverLoweringInputs, JetDriverVerbOutput, JET_DRIVER_EXIT_OK, jet_driver_checked_declarations, jet_driver_present_diagnostics]
use jet_foundation.[BuildOptions, CanonicalPassBoundaryGap, CanonicalPassOptions, CompilerThreads, build_options_stock, build_options_value, canonical_pass_boundary_gaps]
use jet_ir.[IROptOptions, IROptReport, ir_build_program, ir_checks_stock, ir_optimize_module_measured, ir_opt_inline_of, ir_opt_options_from, ir_opt_report_text]
use core.sys as decisions_sys

struct JetCLIDecisions {
    report: IROptReport
    // `name [key]: message at file:start..end` per function the IR builder
    // could not build; the optimizer ran over the rest.
    unbuilt: [String]
}

// The optimizer's options at `level` with `build`'s (the build options)
// `small` (inlining kept to the O1 limits) and `inline` (which callees
// inlining takes), plus the environment's pass knobs: JET_OPT_DISABLE (pass
// names to skip), JET_OPT_SSA_VERIFY, JET_OPT_SSA_STRESS and JET_OPT_DUMP
// (Opt.jet IROptOptions).
fn jet_cli_opt_options(level: Int, build: BuildOptions) -> IROptOptions {
    ir_opt_options_from(level, build_options_value(build, "small") == "true", ir_opt_inline_of(build_options_value(build, "inline")), decisions_sys.get("JET_OPT_DISABLE"), decisions_sys.get("JET_OPT_SSA_VERIFY"), decisions_sys.get("JET_OPT_SSA_STRESS"), decisions_sys.get("JET_OPT_DUMP"))
}

// Builds `inputs` into one IR module from its entry and optimizes it as
// `build` (the build options) has `jet build` do.
fn jet_cli_decisions(inputs: ^JetDriverLoweringInputs, build: BuildOptions, threads: CompilerThreads) -> JetCLIDecisions {
    checked := ^inputs
    declarations := jet_driver_checked_declarations(&checked)
    built := ir_build_program(^checked.functions, ^declarations.type_defs, ^declarations.impls, ^checked.sources, ^declarations.constants, ^declarations.foreign, checked.entry_key ?? "", ir_checks_stock(), threads)
    unbuilt := [String]{}
    loop failure in built.failures -> &unbuilt.push("{failure.name} [{failure.key}]: {failure.message} at {failure.source_file}:{failure.span.start}..{failure.span.end}")
    report :: ir_optimize_module_measured(&built.program, jet_cli_opt_options(jet_cli_native_level(build), build), threads)
    JetCLIDecisions{report: report, unbuilt: ^unbuilt}
}

fn jet_cli_decisions_report(decisions: JetCLIDecisions, scope: String, file: String, profile: String, canonical_route_gaps: [CanonicalPassBoundaryGap], json: Bool) -> String Never! {
    r :: decisions.report
    if !json {
        text := "decisions: scope={scope} source={file} profile={profile}\n{ir_opt_report_text(r)}\n"
        loop row in decisions.unbuilt -> text = "{text}unbuilt {row}\n"
        if canonical_route_gaps.len() > 0 -> text = "{text}{jet_cli_canonical_route_gap_text(canonical_route_gaps)}"
        return text
    }
    fields := [JetCLIStatusField]{
        jet_cli_status_field("scope", jet_cli_status_text(scope)), jet_cli_status_field("source", jet_cli_status_text(file)), jet_cli_status_field("profile", jet_cli_status_text(profile)),
        jet_cli_status_field("level", jet_cli_status_int(r.level)),
        jet_cli_status_field("instructions_before", jet_cli_status_int(r.instructions_before)), jet_cli_status_field("instructions_after", jet_cli_status_int(r.instructions_after)),
        jet_cli_status_field("inlined_calls", jet_cli_status_int(r.inlined_calls)), jet_cli_status_field("direct_calls", jet_cli_status_int(r.direct_calls)),
        jet_cli_status_field("folded", jet_cli_status_int(r.folded)), jet_cli_status_field("branches_folded", jet_cli_status_int(r.branches_folded)),
        jet_cli_status_field("compares_fused", jet_cli_status_int(r.compares_fused)), jet_cli_status_field("copies_coalesced", jet_cli_status_int(r.copies_coalesced)),
        jet_cli_status_field("dead_removed", jet_cli_status_int(r.dead_removed)), jet_cli_status_field("unreachable_removed", jet_cli_status_int(r.unreachable_removed)),
        jet_cli_status_field("aggregates_replaced", jet_cli_status_int(r.aggregates_replaced)),
        jet_cli_status_field("unbuilt", jet_cli_status_texts(decisions.unbuilt)),
    }
    // Explicit opt-in gaps are a separately labeled extension, never execution records.
    if canonical_route_gaps.len() > 0 -> &fields.push(jet_cli_status_field("canonical_route_gaps", jet_cli_status_array(jet_cli_canonical_route_gap_values(canonical_route_gaps))))
    "{jet_cli_status_render("inspect.decisions", true, fields)}\n"
}

// The checked Program compile of the authorized sources under the job's
// profile, the check failure every inspect plane reports, then the IR
// optimizer's report. Canonical-route gaps are opt-in through the adapter
// evidence environment (`JET_ADAPTER_MODE` and comma-separated
// `JET_ADAPTER_OPERATION_IDS`).
fn jet_cli_inspect_decisions_host(job: JetCLIInspectJob, source: String) -> JetDriverVerbOutput {
    output := JetDriverVerbOutput{stdout: "", stderr: "", exit_code: JET_DRIVER_EXIT_OK}
    prepared :: jet_cli_prepare_overlays(job.file, job.file, [JetCLIOverlay]{}, job.color, job.threads, JetDriverCompileMode.Program)
    if prepared == {
        .Refused(refusal) -> output = ^refusal
        .Prepared(value, _) -> {
            request := ^value
            request.profile = job.profile
            ids :: decisions_sys.get("JET_ADAPTER_OPERATION_IDS") ?? ""
            operation_ids := [String]{}
            if ids != "" -> operation_ids = ids.split(",").to_list()
            options :: CanonicalPassOptions{adapter_mode: decisions_sys.get("JET_ADAPTER_MODE") ?? "", operation_ids: ^operation_ids}
            sources := request.authorized_sources
            compiler_threads :: request.compiler_threads.copy()
            front := jet_cli_lowering_inputs(^request, None)
            errors :: jet_cli_errors(jet_driver_present_diagnostics(front.compile.diagnostics, sources, front.compile.generated_source_files))
            if errors.len() > 0 -> jet_cli_inspect_finish(job, jet_cli_inspect_check_failed(job, source, errors))
            if front.compile.internal_problem == .Val(problem) -> jet_cli_inspect_finish(job, jet_cli_ice(problem))
            inputs := ^front.inputs ?? jet_cli_inspect_finish(job, jet_cli_ice("the checked compile of `{job.file}` has no lowering inputs"))
            if inputs.entry_key == None -> jet_cli_inspect_finish(job, jet_cli_build_failed("`{job.file}` has no `fn run` to optimize", "the IR optimizer reports the program reachable from its `fn run`", "add `fn run()` to the file, or check it with `jet check {job.file}`", job.color))
            threads :: CompilerThreads{cap: compiler_threads.cap, cores: compiler_threads.cores, memory_available: jet_cli_memory_available()}
            build :: if job.release_build -> jet_cli_stock_release_options() else -> build_options_stock("build")
            decisions :: jet_cli_decisions(^inputs, build, threads)
            report :: jet_cli_decisions_report(decisions, job.scope, job.file, job.profile, canonical_pass_boundary_gaps(options), job.json)
            jet_cli_inspect_finish(job, JetDriverVerbOutput{stdout: report, stderr: "", exit_code: JET_DRIVER_EXIT_OK})
        }
    }
    output
}
