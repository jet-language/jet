// run_fix: the shared diagnostic edit engine, not a second formatter.
// Publication uses the canonical held codemod transaction.
use {
    cli_files: core.files
    jet_driver.[JetDriverBuildQueryScope, JetDriverCompileMode, JetDriverVerbOutput, jet_driver_entry_package_has_build, jet_driver_present_diagnostics, jet_driver_query_build_plan, JET_DRIVER_EXIT_OK, JET_DRIVER_EXIT_USER_ERROR]
    jet_foundation.[Diagnostic, DiagnosticFixApplicability, DiagnosticFixSafety, Span, TextEdit, DIAGNOSTIC_ERROR]
    jet_lexer.[lex, Token, TOKEN_BLOCK_COMMENT, TOKEN_COLON, TOKEN_COLON_EQ, TOKEN_EQ, TOKEN_IDENT, TOKEN_LBRACE, TOKEN_LINE_COMMENT, TOKEN_RBRACE, TOKEN_SEMI]
    jet_parser.[jet_format_unified_diff, parser_marker_placement_edits]
}

// `errors`: the file's errors, each `CODE: what` (jet_cli_fix_checked
// compares an edited file's against them). `repairs`: the fixes of those
// errors, a subset of `fixes` (jet_cli_fix_round).
JetCLIFixQuery: enum {
    Fixes(fixes: [JetCLIFix], errors: [String], repairs: [JetCLIFix])
    Refused(output: JetDriverVerbOutput)
}

// The fixes one `jet fix` round applies: the error repairs alone while the
// file has any, so the other fixes are read again from the repaired file (an
// unused-binding fix read beside an unknown name may rename the binding the
// name's repair points at). `held` when fixes wait for the next round.
JetCLIFixRound: struct {
    fixes: [JetCLIFix]
    held: Bool
}

jet_cli_fix_round: fn(fixes: [JetCLIFix], repairs: [JetCLIFix], all: Bool) -> JetCLIFixRound Never! {
    usable: if all -> fixes else -> jet_cli_safe_fixes(fixes)
    usable_repairs: if all -> repairs else -> jet_cli_safe_fixes(repairs)
    if usable_repairs.len() == 0 || usable_repairs.len() == usable.len() -> return JetCLIFixRound{fixes: usable, held: false}
    JetCLIFixRound{fixes: usable_repairs, held: true}
}

// The Doc compile of `file` with its bytes replaced by `source`, and each
// file of `files`, the file table, by its text in `texts` (by row) or else
// with the fixes so far, that a `jet fix` query reads: the entry's
// diagnostics and definition facts alone, so Core bodies wait for demand
// (JetDriverCompileRequest.doc_core_on_demand). A file the fixes leave
// unchanged is read from disk.
jet_cli_fix_compile: fn(file: String, source: String, files: [JetCLIFixFile], texts: [String?]) -> JetCLICompiled {
    overlays := [JetCLIOverlay]{JetCLIOverlay{path: file, source: source}}
    loop (row, other) in files {
        if row < texts.len() && texts[row] != None {
            if texts[row] == .Val(text) -> overlays.push(jet_cli_fix_overlay(other.path, text))
        } else if other.source == .Val(text) {
            overlays.push(jet_cli_fix_overlay(other.path, text))
        }
    }
    if jet_cli_prepare_overlays(file, file, overlays, false, None, JetDriverCompileMode.Doc) == {
        .Refused(output) -> JetCLICompiled.Refused{output: output.move()}
        .Prepared(request, snapshot) -> {
            demanded := request.move()
            demanded.doc_core_on_demand = true
            jet_cli_compile_prepared(JetCLIPrepared.Prepared{request: demanded.move(), snapshot: snapshot.move()}, None, None)
        }
    }
}

// copy: a compile's overlay owns its file's path and text, while the file
// table keeps both for the rounds after it.
jet_cli_fix_overlay: fn(path: String, text: String) -> JetCLIOverlay Never! {
    JetCLIOverlay{path: path.copy(), source: text.copy()}
}

// The fixes of `file` with `source` as its text and the file table `files`
// with `texts` (jet_cli_fix_compile): the compiler's own, and the
// `syntax.rewrite` edits of the findings the entry package's build raises
// in it (jet_cli_fix_build_findings). `errors` count the table's files'
// errors too, so a fix that breaks one is rolled back.
jet_cli_fix_collect: fn(file: String, source: String, files: [JetCLIFixFile], texts: [String?], all: Bool) -> JetCLIFixQuery {
    diagnostics := [Diagnostic]{}
    errors := [String]{}
    canonical: jet_cli_overlay_path(file)
    if jet_cli_fix_compile(file, source, files, texts) == {
        .Refused(output) -> return JetCLIFixQuery.Refused{output: output}
        .Compiled(result, snapshot) -> {
            if result.internal_problem == .Val(problem) -> return JetCLIFixQuery.Refused{output: jet_cli_ice(problem)}
            loop diagnostic in jet_driver_present_diagnostics(result.diagnostics, snapshot, result.generated_source_files) {
                if diagnostic.origin == .Val(origin) {
                    if origin.path != canonical || origin.source != source {
                        if diagnostic.severity == DIAGNOSTIC_ERROR && jet_cli_fix_names_file(files, origin.path) -> errors.push("{origin.path}: {diagnostic.code}: {diagnostic.what}")
                        next
                    }
                }
                diagnostics.push(diagnostic)
            }
        }
    }
    loop finding in jet_cli_fix_build_findings(file, source) {
        if finding.origin == None -> next
        if finding.origin == .Val(origin) {
            if origin.path != canonical || origin.source != source -> next
        }
        diagnostics.push(finding)
    }
    migrations: jet_cli_fix_migration_sites(diagnostics, source)
    failed := [Diagnostic]{}
    loop diagnostic in diagnostics {
        if diagnostic.severity == DIAGNOSTIC_ERROR {
            errors.push("{diagnostic.code}: {diagnostic.what}")
            failed.push(diagnostic)
        }
    }
    repairs := jet_cli_fixes_from_diagnostics(failed.move())
    fixes := jet_cli_fixes_from_diagnostics(diagnostics.move())
    // A migration repairs the error at the retired word, so it is both.
    loop site in migrations {
        fixes.push(jet_cli_fix_retired_run(site))
        repairs.push(jet_cli_fix_retired_run(site))
    }
    JetCLIFixQuery.Fixes{fixes: if all -> fixes else -> jet_cli_safe_fixes(fixes), errors: errors.move(), repairs: if all -> repairs else -> jet_cli_safe_fixes(repairs)}
}

// The rewrites `jet fix` registers for retired spellings: a block after the
// retired build-time word, `comptime { … }`, is written `#run { … }`. They
// are offered only when the compile reported an error at one of those words,
// so a program whose own `comptime` names something keeps it; then every such
// word in the file is rewritten at once, so a second `jet fix` changes
// nothing. The error itself stays the generic one and never names `#run`.
// Returns the words to rewrite (jet_cli_fix_retired_run).
jet_cli_fix_migration_sites: fn(diagnostics: [Diagnostic], source: String) -> [Span] {
    sites: jet_cli_fix_retired_run_words(source)
    reported := false
    loop diagnostic in diagnostics {
        if diagnostic.severity != DIAGNOSTIC_ERROR -> next
        if diagnostic.span == .Val(span) {
            loop site in sites {
                if site.start == span.start -> reported = true
            }
        }
    }
    if reported -> sites else -> [Span]{}
}

// The rewrite of one retired build-time word to `#run`.
jet_cli_fix_retired_run: fn(site: Span) -> JetCLIFix {
    JetCLIFix{title: "write the retired `comptime` block as `#run`", edit: TextEdit{span: site, new_text: "#run"}, applicability: DiagnosticFixApplicability.Safe, safety: DiagnosticFixSafety.BehaviorPreserving}
}

// Each `comptime` word right before a `{` where a value or a statement
// starts: after `:`, `:=`, `=`, `{`, `}` or `;`, or first on its line. A
// word in a condition (`if comptime {`) or an operand stays.
jet_cli_fix_retired_run_words: fn(source: String) -> [Span] {
    bytes: source.bytes()
    lexed: lex(bytes)
    sites := [Span]{}
    previous := -1
    loop index in 0..<lexed.tokens.len() {
        token: lexed.tokens[index]
        if !jet_cli_fix_meaningful(token) -> next
        if token.kind == TOKEN_IDENT && token.span.end - token.span.start == 8 && jet_cli_codemod_slice(bytes, token.span.start, token.span.end) == "comptime" {
            if jet_cli_fix_next_opens_block(lexed.tokens, index + 1) && jet_cli_fix_starts_value(bytes, lexed.tokens, previous, token.span.start) -> sites.push(token.span)
        }
        previous = index
    }
    sites
}

jet_cli_fix_meaningful: fn(token: Token) -> Bool {
    token.span.start != token.span.end && token.kind != TOKEN_LINE_COMMENT && token.kind != TOKEN_BLOCK_COMMENT
}

jet_cli_fix_next_opens_block: fn(tokens: [Token], from: Int) -> Bool {
    loop index in from..<tokens.len() {
        if jet_cli_fix_meaningful(tokens[index]) -> return tokens[index].kind == TOKEN_LBRACE
    }
    false
}

jet_cli_fix_starts_value: fn(bytes: [U8], tokens: [Token], previous: Int, start: Int) -> Bool {
    if previous < 0 -> return true
    before: tokens[previous]
    if before.kind == TOKEN_COLON || before.kind == TOKEN_COLON_EQ || before.kind == TOKEN_EQ || before.kind == TOKEN_LBRACE || before.kind == TOKEN_RBRACE || before.kind == TOKEN_SEMI -> return true
    loop at in before.span.end..<start {
        if (Int{bytes[at]}) == 10 -> return true
    }
    false
}

// Whether the file table `files` holds the file at `path`.
jet_cli_fix_names_file: fn(files: [JetCLIFixFile], path: String) -> Bool Never! {
    loop other in files {
        if other.path == path && other.before != None -> return true
    }
    false
}

// The `.Tidy` findings a package lint raises (`meta.report`) when the entry
// package's `build: fn` runs with `file` reading `source`, presented in
// their files; none when the package has no build or it fails. A finding's
// `syntax.rewrite` fix is its edit.
jet_cli_fix_build_findings: fn(file: String, source: String) -> [Diagnostic] {
    if jet_cli_prepare_overlays(file, file, [JetCLIOverlay]{JetCLIOverlay{path: file, source: source}}, false, None, JetDriverCompileMode.Doc) == {
        .Refused(_) -> return [Diagnostic]{}
        .Prepared(request, _) -> {
            owned := request.move()
            if !jet_driver_entry_package_has_build(owned) -> return [Diagnostic]{}
            scope := JetDriverBuildQueryScope{next_session_id: 1}
            response := jet_driver_query_build_plan(owned, scope)
            query := response.query.move()
            if !query.complete || query.internal_problem != None -> return [Diagnostic]{}
            return jet_driver_present_diagnostics(query.tidy, response.request.authorized_sources, query.generated_source_files)
        }
    }
}

// The errors of `file` with `source` as its text and the file table `files`
// with `texts` (jet_cli_fix_collect); a file the compiler refuses is one
// error.
jet_cli_fix_errors: fn(file: String, source: String, files: [JetCLIFixFile], texts: [String?]) -> [String] {
    if jet_cli_fix_collect(file, source, files, texts, false) == {
        .Fixes(_, errors, _) -> errors
        .Refused(_) -> [String]{"the compiler refused the edited file"}
    }
}

// Whether `applied` changes the fixed file from `source` or a file of the
// table `files` from its text with the fixes so far.
jet_cli_fix_changes: fn(applied: JetCLIFixApply, source: String, files: [JetCLIFixFile]) -> Bool Never! {
    if applied.source != source -> return true
    loop (row, text) in applied.texts {
        if text == .Val(edited) {
            if files[row].source == .Val(current) {
                if edited != current -> return true
            } else if files[row].before == .Val(original) {
                if edited != original -> return true
            }
        }
    }
    false
}

// Whether `a` and `b`, two applications of fixes to the same files, leave
// any file different.
jet_cli_fix_differs: fn(a: JetCLIFixApply, b: JetCLIFixApply) -> Bool Never! {
    if a.source != b.source -> return true
    count: if a.texts.len() > b.texts.len() -> a.texts.len() else -> b.texts.len()
    loop row in 0..<count {
        if row >= a.texts.len() {
            if b.texts[row] != None -> return true
        } else if row >= b.texts.len() {
            if a.texts[row] != None -> return true
        } else if a.texts[row] != b.texts[row] {
            return true
        }
    }
    false
}

// Whether the fixes so far change any file of the table `files` from its
// text before `jet fix`.
jet_cli_fix_touched: fn(files: [JetCLIFixFile]) -> Bool Never! {
    loop file in files {
        if file.source == .Val(edited) {
            if file.before == .Val(original) {
                if edited != original -> return true
            }
        }
    }
    false
}

// Takes each file `fixes` name by TextEdit.path into the file table `files`,
// read from disk the first time (a file that can't be read keeps no text,
// and the fixes that edit it are refused, jet_cli_fix_apply_non_overlapping),
// and gives each edit its row; an edit of `canonical`, the fixed file, is
// row -1.
jet_cli_fix_resolve: fn(files: &[JetCLIFixFile], canonical: String, fixes: &&[JetCLIFix]) -> [JetCLIFix] {
    resolved := [JetCLIFix]{}
    loop fix in fixes.move() {
        first := jet_cli_fix_place(files, canonical, fix.edit.move())
        edits := [TextEdit]{}
        rows := [Int]{}
        loop other in fix.edits.move() {
            placed := jet_cli_fix_place(files, canonical, other.move())
            rows.push(placed.row)
            edits.push(placed.edit.move())
        }
        resolved.push(JetCLIFix{title: fix.title.move(), edit: first.edit.move(), applicability: fix.applicability, safety: fix.safety, edits: edits.move(), file: first.row, files: rows.move()})
    }
    resolved
}

// An edit without its path, and the row of the file it changes.
JetCLIFixPlaced: struct {
    edit: TextEdit
    row: Int
}

jet_cli_fix_place: fn(files: &[JetCLIFixFile], canonical: String, edit: &&TextEdit) -> JetCLIFixPlaced {
    stripped := TextEdit{span: edit.span, new_text: edit.new_text.move()}
    named := edit.path.move() ?? return JetCLIFixPlaced{edit: stripped.move(), row: -1}
    if named == canonical -> return JetCLIFixPlaced{edit: stripped.move(), row: -1}
    loop (row, other) in files {
        if other.path == named -> return JetCLIFixPlaced{edit: stripped.move(), row: row}
    }
    text: jet_cli_fix_read(named)
    files.push(JetCLIFixFile{path: named.move(), before: text, source: None})
    JetCLIFixPlaced{edit: stripped.move(), row: files.len() - 1}
}

jet_cli_fix_read: fn(path: String) -> String? {
    text := cli_files.read(path) ?? return None
    Val(text.move())
}

// Sets each file of the table `files` that `texts` (by row) gives a text to
// that text.
jet_cli_fix_settle: fn(files: &[JetCLIFixFile], texts: &&[String?]) Never! {
    row := 0
    loop text in texts.move() {
        if text != None -> files[row].source = text
        row += 1
    }
}

// Applies `fixes` to `source` and the file table `files`
// (jet_cli_fix_apply_non_overlapping) and checks the result: an edit is
// kept only while the files have no more errors than `baseline`, the fixed
// file's errors before `jet fix`. When the whole set adds errors, each fix
// is tried on top of the ones kept so far, and one that adds an error is
// rolled back into `rejected` with the first error it adds. A fix none of
// whose edits can apply goes to `refused`.
jet_cli_fix_checked: fn(file: String, source: String, files: [JetCLIFixFile], fixes: [JetCLIFix], baseline: [String], rejected: &[JetCLIFixSkip], refused: &[JetCLIFixSkip]) -> JetCLIFixApply {
    whole: jet_cli_fix_apply_non_overlapping(source, files, fixes, jet_cli_fix_all(fixes))
    loop refusal in whole.refused -> jet_cli_fix_skip(refused, fixes[refusal.fix], refusal.reason)
    if !jet_cli_fix_changes(whole, source, files) || jet_cli_fix_errors(file, whole.source, files, whole.texts).len() <= baseline.len() -> return whole
    kept := [Int]{}
    result := JetCLIFixApply{source: source, applied: 0, deferred: whole.deferred}
    loop (index, fix) in fixes {
        chosen := [Int]{}
        loop earlier in kept -> chosen.push(earlier)
        chosen.push(index)
        trial: jet_cli_fix_apply_non_overlapping(source, files, fixes, chosen)
        if !jet_cli_fix_differs(trial, result) -> next
        errors: jet_cli_fix_errors(file, trial.source, files, trial.texts)
        if errors.len() <= baseline.len() {
            kept.push(index)
            result = JetCLIFixApply{source: trial.source, applied: trial.applied, deferred: whole.deferred, texts: trial.texts}
            next
        }
        added := errors[0]
        loop error in errors {
            if !baseline.contains(error) {
                added = error
                break
            }
        }
        jet_cli_fix_skip(rejected, fix, "the edited file no longer checks: {added}")
    }
    result
}

// Records `fix` as skipped, once per edit.
jet_cli_fix_skip: fn(skips: &[JetCLIFixSkip], fix: JetCLIFix, reason: String) Never! {
    loop skip in skips {
        if skip.edit.span.start == fix.edit.span.start && skip.edit.span.end == fix.edit.span.end && skip.edit.new_text == fix.edit.new_text -> return
    }
    skips.push(JetCLIFixSkip{title: fix.title, edit: fix.edit, reason: reason})
}

// `jet fix --markers inside|above`: write every declaration's whole marker
// set in one place. Nested declarations overlap their parent's edit, so the
// moves apply in rounds.
jet_cli_fix_markers: fn(before: String, inside: Bool) -> JetCLIFixApply {
    source := before
    count := 0
    round := 0
    loop round < 16 {
        fixes := [JetCLIFix]{}
        loop edit in parser_marker_placement_edits(source.bytes(), inside) -> fixes.push(JetCLIFix{title: "move the markers", edit: edit, applicability: DiagnosticFixApplicability.Safe, safety: DiagnosticFixSafety.BehaviorPreserving})
        if fixes.len() == 0 -> break
        applied: jet_cli_fix_apply_non_overlapping(source, [JetCLIFixFile]{}, fixes, jet_cli_fix_all(fixes))
        if applied.source == source -> break
        source = applied.source
        count += applied.applied
        round += 1
    }
    JetCLIFixApply{source: source, applied: count, deferred: 0}
}

jet_cli_fix_run: fn(file: String, dry_run: Bool, all: Bool, markers: String, style: Bool, color: Bool, quiet: Bool, json: Bool) -> JetDriverVerbOutput {
    before: cli_files.read(file) ?? return jet_cli_report_output("", "E2105", "can't find the file `{file}`", jet_cli_why("E2105"), "correct the named problem, then run the command again", color, JET_DRIVER_EXIT_USER_ERROR)
    all_fixes := [JetCLIFix]{}
    all_repairs := [JetCLIFix]{}
    baseline := [String]{}
    if jet_cli_fix_collect(file, before, [JetCLIFixFile]{}, [String?]{}, true) == {
        .Fixes(found, errors, repairs) -> {
            all_fixes = found
            baseline = errors
            all_repairs = repairs
        }
        .Refused(output) -> { return output }
    }
    // `--markers` and `--style` apply their own moves, not the suggestions;
    // a style move left for a hand edit is counted as skipped.
    skipped := if markers != "" || style -> 0 else -> all_fixes.len() - jet_cli_safe_fixes(all_fixes).len()
    skips := [JetCLIFixSkip]{}
    if !all && markers == "" && !style {
        loop fix in all_fixes {
            if jet_cli_safe_fixes([JetCLIFix]{fix}).len() == 0 -> jet_cli_fix_skip(skips, fix, "needs review: `jet fix --all` applies it")
        }
    }
    rejected := [JetCLIFixSkip]{}
    refused := [JetCLIFixSkip]{}
    applied := JetCLIFixApply{source: before, applied: 0, deferred: 0}
    count := 0
    files := [JetCLIFixFile]{}
    if markers != "" {
        // The moved file must check no worse than the input.
        applied = jet_cli_fix_markers(before, markers == "inside")
        count = applied.applied
        if applied.source != before && jet_cli_fix_errors(file, applied.source, files, [String?]{}).len() > baseline.len() {
            return jet_cli_report_output("", "E2105", "moving the markers {markers} would make `{file}` fail to check", jet_cli_why("E2105"), "fix the file's errors first, then run `jet fix --markers {markers}` again", color, JET_DRIVER_EXIT_USER_ERROR)
        }
    } else if style {
        // The moved file must check no worse than the input.
        applied = jet_cli_fix_style(before)
        count = applied.applied
        skipped = applied.deferred
        if applied.source != before && jet_cli_fix_errors(file, applied.source, files, [String?]{}).len() > baseline.len() {
            return jet_cli_report_output("", "E2105", "moving the impls into their types would make `{file}` fail to check", jet_cli_why("E2105"), "fix the file's errors first, then run `jet fix --style` again", color, JET_DRIVER_EXIT_USER_ERROR)
        }
    } else {
        canonical: jet_cli_overlay_path(file)
        first := jet_cli_fix_round(all_fixes, all_repairs, all)
        held := first.held
        fixes: jet_cli_fix_resolve(files, canonical, first.fixes.move())
        applied = jet_cli_fix_checked(file, before, files, fixes, baseline, rejected, refused)
        count = applied.applied
        // Repairs that change nothing release the held fixes next round.
        stalled := held && !jet_cli_fix_changes(applied, before, files)
        jet_cli_fix_settle(files, applied.texts.move())
        round := 1
        loop round < 16 && (applied.deferred > 0 || held) {
            next := if jet_cli_fix_collect(file, applied.source, files, [String?]{}, all) == {
                .Fixes(found, _, repairs) -> jet_cli_fix_round(found, if stalled -> [JetCLIFix]{} else -> repairs, true)
                .Refused(output) -> { return output }
            }
            held = next.held
            more: jet_cli_fix_resolve(files, canonical, next.fixes.move())
            next_applied := jet_cli_fix_checked(file, applied.source, files, more, baseline, rejected, refused)
            if !jet_cli_fix_changes(next_applied, applied.source, files) {
                if !held -> break
                stalled = true
            } else {
                count += next_applied.applied
                jet_cli_fix_settle(files, next_applied.texts.move())
                applied.source = next_applied.source.move()
                applied.deferred = next_applied.deferred
            }
            round += 1
        }
    }
    loop skip in rejected -> skips.push(skip)
    loop skip in refused -> skips.push(skip)
    // Each rolled-back fix, with the error its edit adds, and each fix
    // refused whole, with why.
    rolled := ""
    loop skip in rejected -> rolled = "{rolled}{file}: rolled back the fix at {skip.edit.span.start}..{skip.edit.span.end} -> `{skip.edit.new_text}`: {skip.reason}\n"
    loop skip in refused -> rolled = "{rolled}{file}: refused the fix at {skip.edit.span.start}..{skip.edit.span.end} -> `{skip.edit.new_text}`: {skip.reason}\n"
    status := ""
    if applied.source == before && !jet_cli_fix_touched(files) {
        if json -> return JetDriverVerbOutput{stdout: jet_cli_fix_status(file, dry_run, 0, skips, None), stderr: "", exit_code: JET_DRIVER_EXIT_OK}
        detail: if skipped == 0 -> "" else -> " ({skipped} suggestion{if skipped == 1 -> "" else -> "s"} need review)"
        status = "{rolled}{file}: no changes made{detail}\n"
        return JetDriverVerbOutput{stdout: "", stderr: if quiet -> "" else -> status, exit_code: JET_DRIVER_EXIT_OK}
    }
    diff := ""
    if dry_run {
        if json -> return JetDriverVerbOutput{stdout: jet_cli_fix_status(file, dry_run, count, skips, None), stderr: "", exit_code: JET_DRIVER_EXIT_OK}
        diff = jet_format_unified_diff(file, before, applied.source)
        loop changed in files.move() {
            if changed.source == .Val(edited) {
                if changed.before == .Val(original) {
                    if edited != original -> diff = "{diff}{jet_format_unified_diff(jet_cli_fix_display(file, changed.path.move()), original, edited)}"
                }
            }
        }
        status = "{rolled}{file}: would apply {count} fix{if count == 1 -> "" else -> "es"} (dry run; nothing written)\n"
        if skipped > 0 -> status = "{status}{file}: skipped {skipped} suggestion{if skipped == 1 -> "" else -> "s"} for review (dry run)\n"
    } else {
        others := [JetCLISourceChange]{}
        loop changed in files.move() {
            if changed.source == .Val(edited) {
                if changed.before == .Val(original) {
                    if edited != original -> others.push(JetCLISourceChange{path: changed.path.move(), before: original.bytes(), after: edited.bytes()})
                }
            }
        }
        log: jet_cli_commit_fix(file, before.bytes(), applied.source.bytes(), None, skips, others.move()) ?? return jet_cli_report_output("", "E2105", err.message, jet_cli_why("E2105"), "correct the named problem, then run the command again", color, JET_DRIVER_EXIT_USER_ERROR)
        if json -> return JetDriverVerbOutput{stdout: jet_cli_fix_status(file, dry_run, count, skips, Val(log)), stderr: "", exit_code: JET_DRIVER_EXIT_OK}
        status = "{rolled}{file}: applied {count} fix{if count == 1 -> "" else -> "es"}\n"
        if skipped > 0 -> status = "{status}{file}: skipped {skipped} suggestion{if skipped == 1 -> "" else -> "s"} for review\n"
        status = "{status}  log: {log}\n"
    }
    JetDriverVerbOutput{stdout: diff, stderr: if quiet -> "" else -> status, exit_code: JET_DRIVER_EXIT_OK}
}

// `path`, another file a fix changes, as the diff names it: beside `file`
// when it sits in `file`'s folder or under it, else whole.
jet_cli_fix_display: fn(file: String, path: &&String) -[FS, Env]> String Never! {
    folder: jet_cli_parent(jet_cli_overlay_path(file)) ?? return path
    if !path.starts_with("{folder}/") -> return path
    rest: path.slice(folder.len() + 1, path.len())
    written: jet_cli_parent(file) ?? ""
    if written == "" || written == "." -> return rest
    "{written}/{rest}"
}

// `jet fix --json`: one jet.status/v1 line naming the edits applied (or, on
// a dry run, that would be) and each edit left out with its reason. A
// needs-review suggestion such as a script's authority grant stays out until
// `jet fix --all` or a hand edit decides it; a rolled-back fix names the
// error it adds. `log` is the replay log of a written file.
jet_cli_fix_status: fn(file: String, dry_run: Bool, count: Int, skips: [JetCLIFixSkip], log: String?) -> String Never! {
    skipped: loop skip in skips -> jet_cli_status_object([JetCLIStatusField]{
        jet_cli_status_field("title", jet_cli_status_text(skip.title)),
        jet_cli_status_field("reason", jet_cli_status_text(skip.reason)),
        jet_cli_status_field("span", jet_cli_status_object([JetCLIStatusField]{jet_cli_status_field("start", jet_cli_status_int(skip.edit.span.start)), jet_cli_status_field("end", jet_cli_status_int(skip.edit.span.end))})),
        jet_cli_status_field("new_text", jet_cli_status_text(skip.edit.new_text)),
    })
    fix: jet_cli_status_object([JetCLIStatusField]{
        jet_cli_status_field("file", jet_cli_status_text(file)),
        jet_cli_status_field("dry_run", jet_cli_status_bool(dry_run)),
        jet_cli_status_field("applied", jet_cli_status_int(count)),
        jet_cli_status_field("skipped", jet_cli_status_array(skipped)),
        jet_cli_status_field("log", jet_cli_status_optional_text(log)),
    })
    "{jet_cli_status_render("fix", true, [JetCLIStatusField]{jet_cli_status_field("fix", fix)})}\n"
}
