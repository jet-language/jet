// `jet explain <build fact> [file] [--profile <name>] [--set name=value]`: the
// writer chain of one build fact over the authorized load of `file`, else of
// the current directory's project entry, the same chain the compile folds
// (jet_driver_explain_build_fact). `jet explain <binding>.<function> <file>`
// explains a module value: the build setting a generic-module instantiation
// passes as a fact-value argument, folded under the same chain.
use {
    cli_files: core.files
    jet_driver.[JetDriverAuthorizedSourceSnapshot, JetDriverCompileMode, jet_driver_explain_build_fact, jet_driver_present_diagnostics]
    jet_foundation.[BuildSettingOverride, DiagnosticExplanation, SourceFile]
}

JET_CLI_BUILD_FACT_WHY: "the nearest source writer wins within the most explicit contribution layer; same-layer disagreement is an error"
JET_CLI_BUILD_FACT_FIX: "change the effective writer, or remove it to inherit the next writer in the chain"

// A module value query `binding.function` (`jet explain tuned.slots`): the
// top-level instantiation `binding: module<…>(…)` whose argument for the
// module parameter `parameter` is the build setting `setting`, of a module
// that declares `function`.
JetCLIModuleValue: struct {
    query: String
    binding: String
    instantiation: String
    function: String
    parameter: String
    setting: String
}

// `file` is "" when the command names none; `module_value` is the module
// value `key` feeds, None for a build fact query.
jet_cli_build_fact_explain_host: fn(key: String, file: String, profile: String, settings: [BuildSettingOverride], module_value: JetCLIModuleValue?, color: Bool, json: Bool) -> JetCLIPlan {
    entry := file
    if entry == "" {
        notices := [String]{}
        cwd: cli_files.cwd() ?? "."
        if jet_cli_find_project_entry(cwd, "explain", color, notices) == {
            .Entry(found) -> entry = found.path
            .Absent -> return jet_cli_missing_bare_entry("explain", cwd, color)
            .Refused(plan) -> return plan
        }
    }
    prepared := jet_cli_prepare_overlays(entry, entry, [JetCLIOverlay]{}, color, None, JetDriverCompileMode.Doc)
    if prepared.move() == {
        .Refused(output) -> JetCLIPlan.Done{output: output}
        .Prepared(request, snapshot) -> {
            selected := request
            if profile != "" -> selected.profile = profile
            selected.setting_overrides = settings
            explained: jet_driver_explain_build_fact(selected, key)
            if explained.fact == .Val(fact) {
                lines := [String]{}
                code := key.copy()
                if module_value == .Val(value) {
                    // The chain's first line is `<fact> = <folded value>`.
                    folded: fact.explain().split("\n").to_list()[0].split(" = ").to_list()
                    shown: if folded.len() > 1 -> folded[folded.len() - 1] else -> ""
                    lines.push("`{value.binding}` is `{value.instantiation}`: `{value.function}` reads its module argument `{value.parameter}`")
                    lines.push("{value.parameter} = #build.settings.{value.setting} value:{shown}")
                    code = value.query.copy()
                }
                loop line in fact.explain().split("\n") -> lines.push(line.removeprefix("  "))
                explanation: DiagnosticExplanation{code: code, stage: "", meaning: lines[0], what: Val(lines.join("\n")), why: Val(JET_CLI_BUILD_FACT_WHY), fix: Val(JET_CLI_BUILD_FACT_FIX), example: None}
                return jet_cli_explanation_output(explanation, color, json)
            }
            if explained.diagnostics.len() == 0 -> return JetCLIPlan.Done{output: jet_cli_ice("build fact `{key}` resolved to no writer")}
            presented: jet_driver_present_diagnostics(explained.diagnostics, snapshot, [SourceFile]{})
            JetCLIPlan.Done{output: jet_cli_lint_errors(snapshot.entry_path, jet_cli_build_fact_entry_source(snapshot), presented, color, json)}
        }
    }
}

// The module value `query` names in `source`, None when `query` is not
// `<binding>.<function>` of a top-level instantiation that passes a
// `#build.settings.<name>` argument to a module declaring `function`.
jet_cli_module_value: fn(query: String, source: String) -> JetCLIModuleValue? Never! {
    parts: query.split(".").to_list()
    if parts.len() != 2 || parts[0] == "" || parts[1] == "" -> return None
    lines: source.split("\n").to_list()
    instantiation := ""
    loop line in lines {
        if line.starts_with("{parts[0]}: ") -> instantiation = line.removeprefix("{parts[0]}: ").trim()
    }
    call: instantiation.split("(").to_list()
    if call.len() != 2 || !call[1].ends_with(")") -> return None
    module_name: call[0].split("<").to_list()[0].trim()
    arguments: call[1].removesuffix(")").split(",").to_list()
    // The module's declaration line, `name: module<…>(parameters) {`, and
    // whether a later line declares `function`.
    parameters := [String]{}
    declares := false
    inside := false
    loop line in lines {
        if line.starts_with("{module_name}: module") {
            head: line.split("(").to_list()
            if head.len() < 2 -> return None
            loop parameter in head[1].split(")").to_list()[0].split(",") -> parameters.push(parameter.split(":").to_list()[0].trim())
            inside = true
            next
        }
        if inside && line.trim().starts_with("{parts[1]}: fn") -> declares = true
        if inside && line.starts_with("}}") -> inside = false
    }
    if !declares -> return None
    loop (index, argument) in arguments {
        written: argument.trim()
        if !written.starts_with("#build.settings.") || index >= parameters.len() -> next
        return Val(JetCLIModuleValue{query: query.copy(), binding: parts[0].copy(), instantiation: instantiation.copy(), function: parts[1].copy(), parameter: parameters[index].copy(), setting: written.removeprefix("#build.settings.")})
    }
    None
}

// The profile `--profile <name>`/`--release` selects for the chain; the stock
// `debug` profile is the front end's `dev` (jet_cli_build_options), "" then.
jet_cli_build_fact_profile: fn(jet_argv: [String]) -> String Never! {
    name: jet_cli_profile_name(jet_argv)
    if name == "debug" -> return ""
    name
}

// The bytes of the snapshot's entry file, "" when the entry is not a walked file.
jet_cli_build_fact_entry_source: fn(snapshot: JetDriverAuthorizedSourceSnapshot) -> String Never! {
    loop root in snapshot.roots {
        loop file in root.files {
            if file.path == snapshot.entry_path -> return file.source
        }
    }
    ""
}
