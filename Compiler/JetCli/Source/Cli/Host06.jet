                else if arg.starts_with("--fixtures=") -> &child_flags.extend(["--fixtures", arg.trim_start_matches("--fixtures=")])
                else if arg.starts_with("--preset=") {
                    value := arg.trim_start_matches("--preset=") // #4303
                    preset = Val(value)
                    &child_flags.extend(["--preset", value])
                } else if arg.starts_with("--env=") {
                    value := arg.trim_start_matches("--env=") // #4303
                    environment = Val(value)
                    &child_flags.extend(["--env", value])
                } else if arg.starts_with("--color=") -> &child_flags.push(arg)
                else if arg.starts_with("-") {
