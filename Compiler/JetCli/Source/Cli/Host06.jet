pub fn implicit_copy_spans(bundle: &ProgramBundle, origin: String) -> [Span] {
    requested :: fs.canonicalize(OSPath.from_text(origin)).ok()
    module :: bundle.modules.iter().find(fn(module) { requested.is_some_and(fn(path) { fs.canonicalize(module.path).ok() == Val(path) }) || module.display == origin }).or_else(fn() { bundle.modules.get(bundle.entry) }) ?? return []
    implicit_copy_spans_in_module(module)
}
