fn collect_copy_span(expression: &Expr, spans: &[Span]) {
    if expression == { .Copy(inner, copy_span) -> { if copy_span == inner.span() -> &spans.push(copy_span) }, else -> {} }
}
// Rust: Source/CmdCompile.rs:9639
fn collect_func_implicit_copy_spans(function: &Func, spans: &[Span]) {
    if function.compiler_generated -> return
    collect_stmts_implicit_copy_spans(function.body, &spans)
}
// Rust: Source/CmdCompile.rs:9649
fn collect_item_implicit_copy_spans(item: &Item, spans: &[Span]) {
    if item == {
        .Func(function) -> collect_func_implicit_copy_spans(function, &spans)
        .Struct(definition) | .Enum(definition) -> {
            loop function in definition.methods -> collect_func_implicit_copy_spans(function, &spans)
            loop implementation in definition.trait_impls {
                if implementation.compiler_generated -> continue
                loop function in implementation.methods -> collect_func_implicit_copy_spans(function, &spans)
            }
        }
        .Impl(definition) -> { loop function in definition.methods -> collect_func_implicit_copy_spans(function, &spans) }
        .Test(definition) -> collect_stmts_implicit_copy_spans(definition.body, &spans)
        .CodeModule(definition) -> { if definition.body == { .Val(body) -> { loop item in body -> collect_item_implicit_copy_spans(item, &spans) }, .None -> {} } }
        .GenericModule(definition) -> { loop item in definition.body -> collect_item_implicit_copy_spans(item, &spans) }
        else -> {}
    }
}
