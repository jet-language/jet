// Rust: Source/CmdCompile.rs:8590
fn run_test_watch(path: String, opts: TestRunOpts, mode: OutputMode) -> Never {
    target :: OSPath.from_text(path)
    watch := WatchSession.open(target) ?? {
        write_mode_diagnostic(mode, jet.render_all_colored(path, "", [err], mode.color_stderr()))
        exit(ExitCodes.USER_ERROR)
    }
    files := [OSPath]{}
    if target.is_dir() -> collect_source_files_recursive(target, Syntax.FILE_EXT, &files)
    else -> &files.push(target)
    loop file in files -> watch.graph_mut().upsert(file, WatchService.RootKind.BuildInput)
    watch.graph_mut().scan_runtime_inputs()
    manifest_search :: if target.is_dir() -> target else -> target.parent() ?? OSPath.from_text(".")
    if Loader.find_manifest_root(manifest_search) == { .Val(root) -> watch.graph_mut().upsert(root.join(Syntax.PACKAGE_FILE), WatchService.RootKind.Manifest), .None -> {} }
    watch_record :: opts.record.map(fn(name) {
        record_path :: if target.is_dir() -> jet.find_project_entry(target) else -> target
        profile :: opts.profile ?? (if opts.release || opts.measure -> Syntax.BUILD_PROFILE_RELEASE else -> "dev")
        ProveReplay.begin_named_capture(record_path.to_string_lossy(), name, profile, opts.setting_overrides, mode.json).unwrap_or_else(fn(status) { exit(status) })
    })
    if !mode.json && !mode.quiet {
        cache_mode :: if opts.fresh -> "fresh" else -> "cached"
        write_mode_status(mode, "jet test --watch ({cache_mode} results): r rerun failed, a run all, o cycle output, q quit\n")
    }
    input :: spawn_test_watch_input()
    output := opts.capture
    (last_status, failed) := run_test_watch_selection(path, opts, output, None, mode)
    last_good := last_status == ExitCodes.OK
    if !last_good && !mode.json && !mode.quiet -> write_mode_status(mode, "jet test: failure; last-good build artifact retained\n")
    loop {
        action := U8?{None}
        loop {
            byte :: input.try_recv() ?? break
            action = Val(byte.to_ascii_lowercase())
        }
        if action == {
            .Val(113) | .Val(3) -> {
                if watch_record == { .Val(capture) -> ProveReplay.finish_named_capture(capture, last_status, mode.json) ?? exit(err), .None -> {} }
                exit(last_status)
            }
            .Val(114) -> {
                if failed.is_empty() {
                    if !mode.json && !mode.quiet -> write_mode_status(mode, "jet test: no failed tests to rerun\n")
                } else {
                    (status, current_failures) :: run_test_watch_selection(path, opts, output, Val(failed), mode)
                    last_status = status
                    failed = current_failures
                    if status == ExitCodes.OK -> last_good = true
                    else if last_good && !mode.json && !mode.quiet -> write_mode_status(mode, "jet test: failure; last-good build artifact retained\n")
                }
            }
            .Val(97) -> {
                (status, current_failures) :: run_test_watch_selection(path, opts, output, None, mode)
                last_status = status
                failed = current_failures
                if status == ExitCodes.OK -> last_good = true
                else if last_good && !mode.json && !mode.quiet -> write_mode_status(mode, "jet test: failure; last-good build artifact retained\n")
            }
            .Val(111) -> {
                output = if output == { .Failed -> .All, .All -> .None, .None -> .Failed }
                if !mode.json && !mode.quiet -> write_mode_status(mode, "jet test: output {output.as_str()}\n")
            }
            else -> {}
        }
        if watch.poll() == {
            .Val(receipt) -> {
                _ :: watch.acknowledge(receipt)
                selection :: if failed.is_empty() -> None else -> Val(failed)
                (status, current_failures) :: run_test_watch_selection(path, opts, output, selection, mode)
                last_status = status
                failed = current_failures
                if status == ExitCodes.OK -> last_good = true
                else if last_good && !mode.json && !mode.quiet -> write_mode_status(mode, "jet test: failure; last-good build artifact retained\n")
            }
            .None -> {}
        }
        thread.sleep(Duration.from_millis(WATCH_POLL_INTERVAL_MS.max(25)))
    }
}
// Rust: Source/CmdCompile.rs:8771
fn run_doctests(path: OSPath, shown: String, src: String, update_snapshots: Bool, profile: &BuildProfile, setting_overrides: [String:String], capture: TestCapturePolicy, mode: OutputMode) -> Bool {
    blocks :: Doctest.discover(src)
    if blocks.is_empty() -> return true
    project_root :: jet.build_project_root(shown) ?? { report_problems(mode, shown, src, err); return false }
    all_ok := true
    rewritten := src
    did_rewrite := false
    loop n in 0..<blocks.len() {
        block :: blocks[n]
        label :: "doctest at {shown}:{block.fence_line}"
        program :: Doctest.synth_program(block)
        build_root :: project_root.join(".jet").join("build")
        _ :: fs.create_dir_all(build_root)
        tmp :: build_root.join("{stem(shown)}__doctest_{n}.{std.process.id()}.jet")
        if fs.write(tmp, program).is_err() {
            emit_doctest_result(label, false, "", "", capture, mode)
            cli_error("E2105", "couldn't stage doctest from `{shown}`")
            all_ok = false
            write_doctest_proof_record(label, shown, block.fence_line, false, "producer_start_failed")
            continue
        }
        tmp_shown :: tmp.to_string_lossy()
        compiled :: jet.compile_with_target_and_gates_and_profile_and_settings(program, tmp_shown, jet.Policy.GateSet.default(), None, profile.budget_name(), setting_overrides)
        (rust_code, ffi_link) :: if compiled == {
            .Ok(out) -> (out.rust, out.ffi)
            .Err(diags) -> {
                emit_doctest_result(label, false, "", "", capture, mode)
                report_problems(mode, tmp_shown, program, diags)
                all_ok = false
                write_doctest_proof_record(label, shown, block.fence_line, false, "does not compile")
                _ :: fs.remove_file(tmp)
                continue
            }
        }
        bin :: tmp.with_extension("")
        generated_rs :: build_root.join("{stem(tmp_shown)}.rs")
        build(tmp_shown, rust_code, None, bin, profile, ffi_link, [], false, None, None, None, mode, false, None)
        command := Command.new(bin)
        &command.env("JET_TEST_CAPTURE", capture.as_str())
        if mode.json -> &command.env("JET_TEST_JSON", "1")
        out :: command.output() ?? {
            emit_doctest_result(label, false, "", "", capture, mode)
            cli_error("E2105", "couldn't run {label}: {err}")
            all_ok = false
            write_doctest_proof_record(label, shown, block.fence_line, false, "producer_start_failed")
            _ :: fs.remove_file(tmp)
            _ :: fs.remove_file(bin)
            _ :: fs.remove_file(generated_rs)
            continue
        }
        _ :: fs.remove_file(tmp)
        _ :: fs.remove_file(bin)
        _ :: fs.remove_file(generated_rs)
        stdout :: String.from_utf8_lossy(out.stdout)
        stderr :: String.from_utf8_lossy(out.stderr)
        if !out.status.success() {
            emit_doctest_result(label, false, stdout, stderr, capture, mode)
            all_ok = false
            write_doctest_proof_record(label, shown, block.fence_line, false, "runtime error")
            continue
        }
        produced :: stdout.lines().to_list()
        block_ok := true
        loop i in 0..<block.expects.len() {
            e :: block.expects[i]
            actual :: produced.get(i) ?? ""
            if actual == e.expected -> continue
            if update_snapshots && jet_cli_test_rewrite_doctest_expect(&rewritten, e.line, actual) { did_rewrite = true; continue }
            block_ok = false
            all_ok = false
            span :: jet_cli_test_doc_line_span(src, e.line)
            diag :: Doctest.mismatch_diag(shown, e, actual, span)
            report_problems(mode, shown, src, [diag])
        }
        emit_doctest_result(label, block_ok, stdout, stderr, capture, mode)
        write_doctest_proof_record(label, shown, block.fence_line, block_ok, if block_ok -> "" else -> "output mismatch")
    }
    if did_rewrite {
        fs.write(path, rewritten) ?? { cli_error("E2105", "couldn't update doctest snapshots in `{shown}`: {err}"); return false }
    }
    all_ok
}
