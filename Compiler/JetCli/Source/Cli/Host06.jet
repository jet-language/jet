    project_dir :: EnvHook.find_env_root(cwd) ?? {
        cli_error_full("E1340", "jet fmt --lang needs an env.jet", "the external formatter is an environment package fact", "run from a realized environment project containing env.jet")
        return ExitCodes.USER_ERROR
    }
    env_path :: project_dir.join(Syntax.ENV_FILE)
    source :: fs.read_to_string(env_path) ?? {
        cli_error_full("E1340", "could not read `{env_path.display()}`", err.to_string(), "fix the environment file and retry")
        return ExitCodes.USER_ERROR
    }
    plan :: ModuleEval.evaluate_env_with_selections(source, project_dir, preset, environment) ?? {
        write_mode_diagnostic(mode, jet.Diagnostics.render_all(Syntax.ENV_FILE, source, [err]))
        return ExitCodes.USER_ERROR
    }
    formatter :: plan.lifecycle.formatter ?? {
        cli_error_full("E1340", "no formatter is declared for language {language}", "jet fmt --lang delegates through the selected environment formatter fact", "declare a formatter package in the selected env module")
        return ExitCodes.USER_ERROR
    }
    formatter_program :: jet_cli_external_formatter_program(formatter.package) ?? {
        cli_error_full("E1340", "the environment formatter package has no executable name", "Jetpack realizes formatter packages, and Jet invokes their package name", "use a formatter package such as `pkgs.nixfmt`")
        return ExitCodes.USER_ERROR
    }
    files := collect_external_fmt_files(cwd, project_dir, explicit_paths, language) ?? {
        cli_error_full("E1340", "could not discover formatter input files", err, "fix the named path or run the formatter from the environment root")
        return ExitCodes.USAGE
    }
    if changed_only {
        changed :: external_fmt_changed_files(project_dir) ?? {
            cli_error_full("E1340", "--changed needs a readable Git worktree", err, "run inside a Git worktree or remove --changed")
            return ExitCodes.USAGE
        }
        &files.retain(fn(path) { path.strip_prefix(project_dir).ok().map(fn(relative) { relative.to_string_lossy().replace("\\", "/") }).is_some_and(fn(relative) { changed.contains(relative) }) })
    }
    if files.is_empty() { if mode.json -> write_mode_machine(mode, "{fmt_json_ok()}\n"); return ExitCodes.OK }
    temp :: ExternalFmtTempDir.new() ?? {
        cli_error_full("E1340", "could not stage formatter inputs", err, "fix the temporary directory and retry")
        return ExitCodes.USAGE
    }
    staged := [ExternalFmtStagedFile]{}
    command := ["env"]
    &command.extend(^child_flags)
    &command.push("--")
    &command.push(formatter_program)
    loop index in 0..<files.len() {
        source_path :: files[index]
        before :: fs.read(source_path) ?? {
            cli_error_full("E1340", "could not read `{source_path.display()}`", err.to_string(), "fix the file permissions and retry")
            return ExitCodes.USAGE
        }
        name :: source_path.file_name().map(fn(name) { name.to_string_lossy() }) ?? "input"
        staged_path :: temp.path.join("{index:04}-{name}")
        fs.write(staged_path, before) ?? {
            cli_error_full("E1340", "could not stage formatter inputs", err.to_string(), "fix the temporary directory and retry")
            return ExitCodes.USAGE
        }
        &command.push(staged_path.to_string_lossy())
        &staged.push(ExternalFmtStagedFile{source: source_path, staged: staged_path, before: ^before})
    }
    code :: EngineDispatch.dispatch(Syntax.JETPACK_BINARY_NAME, "env", command)
    if code != ExitCodes.OK -> return code
    changed := [(OSPath, [U8], [U8])]{}
    loop file in staged {
        after :: fs.read(file.staged) ?? {
            cli_error_full("E1340", "environment formatter did not produce readable output", err.to_string(), "check the formatter package and retry")
            return ExitCodes.USER_ERROR
        }
        if file.before != after -> &changed.push((file.source, ^file.before, ^after))
    }
    if changed.is_empty() { if mode.json -> write_mode_machine(mode, "{fmt_json_ok()}\n"); return ExitCodes.OK }
    if check_only {
        paths :: changed.iter().map(fn(row) { external_fmt_display_path(project_dir, row.0) }).to_list()
        if mode.json {
            if show_diff {
                diffs := [(String, String)]{}
                loop i in 0..<changed.len() {
                    before :: String.from_utf8_lossy(changed[i].1)
                    after :: String.from_utf8_lossy(changed[i].2)
                    &diffs.push((paths[i], Formatter.unified_diff(paths[i], before, after)))
                }
                write_mode_machine(mode, "{fmt_json_dirty_diffs(diffs)}\n")
            } else -> write_mode_machine(mode, "{fmt_json_dirty_paths(paths)}\n")
        } else {
            loop i in 0..<changed.len() {
                path :: paths[i]
                write_mode_renderable(mode, "{path}\n")
                if show_diff -> write_mode_renderable(mode, Formatter.unified_diff(path, String.from_utf8_lossy(changed[i].1), String.from_utf8_lossy(changed[i].2)))
            }
        }
        return ExitCodes.USER_ERROR
    }
    loop (path, _, after) in changed {
        fs.write(path, after) ?? {
            cli_error_full("E1340", "could not write `{path.display()}`", err.to_string(), "fix the file permissions and rerun the formatter")
            return ExitCodes.USAGE
        }
    }
    if mode.json -> write_mode_machine(mode, "{fmt_json_ok()}\n")
    ExitCodes.OK
}
// Rust: Source/CmdCompile.rs:10173
// Canonical exact helper: Compile/Format.jet:255 jet_cli_external_formatter_program.
// Rust: Source/CmdCompile.rs:10180
fn collect_external_fmt_files(cwd: OSPath, project_dir: OSPath, explicit_paths: [String], language: String) -> [OSPath] Err! {
    files := BTreeSet.new()
    if explicit_paths.is_empty() -> walk_external_fmt_files(project_dir, language, &files)
    else {
        loop raw in explicit_paths {
            path :: OSPath.from_text(raw)
            path :: if path.is_absolute() -> path else -> cwd.join(path)
            metadata :: fs.symlink_metadata(path) ?? return Err("{path.display()}: {err}")
            if metadata.is_dir() -> walk_external_fmt_files(path, language, &files)
            else if metadata.is_file() && jet_cli_format_matches_language(path.to_string_lossy(), language) -> _ :: files.insert(path)
        }
    }
    Ok(files.to_list())
}
// Rust: Source/CmdCompile.rs:10209
fn walk_external_fmt_files(dir: OSPath, language: String, files: &BTreeSet[OSPath]) {
    IGNORED :: [".git", ".jet", "target", "build", "vendor", "node_modules"]
    entries :: fs.read_dir(dir) ?? return
    entries := entries.flatten().to_list()
    &entries.sort_by_key(fn(entry) { entry.path() })
    loop entry in entries {
        path :: entry.path()
        kind :: entry.file_type() ?? continue
        if kind.is_dir() {
            ignored :: path.file_name().and_then(fn(name) { name.to_str() }).is_some_and(fn(name) { IGNORED.contains(name) })
            if !ignored -> walk_external_fmt_files(path, language, &files)
        } else if kind.is_file() && jet_cli_format_matches_language(path.to_string_lossy(), language) -> _ :: files.insert(path)
    }
}
// Rust: Source/CmdCompile.rs:10235
// Canonical exact predicate: Compile/Format.jet:318 jet_cli_format_matches_language.
// Rust: Source/CmdCompile.rs:10239
fn external_fmt_changed_files(root: OSPath) -> BTreeSet[String] Err! {
    changed := BTreeSet.new()
    loop args in [["diff", "--name-only", "HEAD"], ["diff", "--name-only", "--cached"], ["ls-files", "--others", "--exclude-standard"]] {
        output :: Command.new("git").args(args).current_dir(root).output() ?? return Err(err.to_string())
        if !output.status.success() && args.first() == Val("diff") {
            error := String.from_utf8_lossy(output.stderr).trim() // #4303
            return Err(error)
        }
        loop line in String.from_utf8_lossy(output.stdout).lines() {
            trimmed := line.trim() // #4303
            relative :: trimmed.replace("\\", "/")
            if !relative.is_empty() && root.join(relative).is_file() -> _ :: changed.insert(relative)
        }
    }
    Ok(^changed)
}
// Rust: Source/CmdCompile.rs:10264
fn external_fmt_display_path(root: OSPath, path: OSPath) -> String {
    path.strip_prefix(root).map(fn(relative) { relative.to_string_lossy().replace("\\", "/") }).unwrap_or_else(fn(_) { path.to_string_lossy() })
}
