fn run_fmt_stdin(stdin_path: String?, explicit_copies: Bool, simplify: Bool, mode: OutputMode) {
    src := ""
    io.stdin().read_to_string(&src) ?? { cli_error("E2105", "failed to read from stdin"); exit(ExitCodes.USAGE) }
    label :: stdin_path ?? "<stdin>"
    (_, retired_target_count) :: rewrite_retired_package_targets(src, label)
    retired_selector_count :: Formatter.retired_interpolation_selector_edits(src).len()
    retired_print_count :: Formatter.retired_print_family_edits(src).len()
    retired_type_count :: Formatter.retired_type_edits(src).len()
    if format_source_for_fmt(src, label, explicit_copies, simplify) == {
        .Ok(formatted) -> {
            write_mode_renderable(mode, formatted)
            if retired_target_count > 0 {
                suffix :: if retired_target_count == 1 -> "" else -> "s"
                write_mode_status(mode, "{label}: rewrote {retired_target_count} retired target spelling{suffix} from `plugin` to `sandbox` (D-ONCE-SANDBOX1=A)\n")
            }
            if retired_selector_count > 0 {
                suffix :: if retired_selector_count == 1 -> "" else -> "s"
                write_mode_status(mode, "{label}: rewrote {retired_selector_count} retired interpolation selector{suffix} from `#` to `:` (D-ONCE-HASH1)\n")
            }
            if retired_print_count > 0 {
                suffix :: if retired_print_count == 1 -> "" else -> "s"
                write_mode_status(mode, "{label}: rewrote {retired_print_count} retired print-family spelling{suffix} (D-ONCE-PRINT1=A)\n")
            }
            if retired_type_count > 0 {
                suffix :: if retired_type_count == 1 -> "" else -> "s"
                write_mode_status(mode, "{label}: rewrote {retired_type_count} retired Core container name{suffix} (D-COLLNAME1=A)\n")
            }
        }
        .Err(diags) -> {
            rendered :: if mode.json -> render_diagnostic_status("fmt", false, jet.machine_report_path_for_process(label), src, diags) else -> jet.render_diagnostics(label, src, diags)
            write_mode_diagnostic(mode, rendered)
            exit(ExitCodes.USAGE)
        }
    }
}
// Rust: Source/CmdCompile.rs:9516
fn format_source_for_fmt(src: String, origin: String, explicit_copies: Bool, simplify: Bool) -> String [Diagnostic]! {
    if jet_cli_format_is_package(origin) -> return format_package_manifest_for_fmt(src, origin)
    copy_marks_inserted := false
    materialized :: if explicit_copies && OSPath.from_text(origin).is_file() && !jet_cli_format_is_typed_package(src, origin) {
        source := src
        bundle := Loader.load_entry(origin)
        diagnostics :: Sema.check_bundle(&bundle, Sema.CompileMode.Check)
        if diagnostics.iter().any(fn(diagnostic) { diagnostic.severity == Severity.Error }) -> return Err(diagnostics)
        spans := implicit_copy_spans(bundle, origin)
        &spans.reverse()
        loop span in spans {
            if span.start <= source.len() { &source.insert_str(span.start, Syntax.SIGIL_COPY); copy_marks_inserted = true }
        }
        rewrite_retired_package_targets(source, origin).0
    } else -> rewrite_retired_package_targets(src, origin).0
    if jet_cli_format_is_typed_package(materialized, origin) {
        if Package.format_source(materialized, origin) == { .Ok(formatted) -> return Ok(formatted), .Err(_) -> {} }
    }
    if jet.format_source_with_options(materialized, Formatter.FormatOptions{simplify: simplify}) == {
        .Ok(formatted) -> Ok(formatted)
        .Err(diagnostics) -> { if copy_marks_inserted -> Err([Diagnostic.from_row("E0122", [("file", origin)], None)]) else -> Err(diagnostics) }
    }
}
