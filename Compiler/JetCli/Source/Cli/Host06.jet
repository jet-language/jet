fn discover_project_files() -> [OSPath] {
    cwd :: env.current_dir().unwrap_or_else(fn(_) { OSPath.from_text(".") })
    root :: Loader.find_manifest_root(cwd) ?? cwd
    files := [OSPath]{}
    walk_jet_files(root, &files)
    ^files
}
// Rust: Source/CmdCompile.rs:9316
fn collect_explicit_files(paths: [String]) -> [OSPath] {
    files := [OSPath]{}
    loop raw in paths {
        p :: OSPath.from_text(raw)
        if p.is_dir() -> walk_jet_files(p, &files) else -> &files.push(p)
    }
    &files.sort()
    &files.dedup()
    ^files
}
// Rust: Source/CmdCompile.rs:9333
fn collect_changed_files() -> [OSPath] {
    is_git :: Command.new("git").args(["rev-parse", "--is-inside-work-tree"]).stdout(Stdio.null()).stderr(Stdio.null()).status().map(fn(s) { s.success() }).unwrap_or(false)
    if !is_git {
        cli_error_full("E2104", "`--changed` requires a git repository", "`jet fmt --changed` uses git to find modified .jet files", "run from inside a git repository, or format specific files with `jet fmt <path>`")
        exit(ExitCodes.USAGE)
    }
    ext :: Syntax.FILE_EXT
    cwd :: env.current_dir().unwrap_or_else(fn(_) { OSPath.from_text(".") })
    seen := BTreeSet.new()
    loop git_args in [["diff", "--name-only", "HEAD"], ["diff", "--name-only", "--cached"]] {
        if Command.new("git").args(git_args).output() == {
            .Ok(out) -> {
                if out.status.success() {
                    loop line in String.from_utf8_lossy(out.stdout).lines() {
                        if line.ends_with(".{ext}") { p :: cwd.join(line); if p.is_file() -> _ :: seen.insert(p) }
                    }
                }
            }
            .Err(_) -> {}
        }
    }
    seen.to_list()
}
