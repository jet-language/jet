fn report_coverage(file: String, cov_out: OSPath, mode: OutputMode, profile: String, setting_overrides: [String:String]) {
    observations :: jet_cli_test_coverage_parse(fs.read_to_string(cov_out).unwrap_or_default())
    _ :: fs.remove_file(cov_out)
    funcs :: jet.coverable_functions(file, profile, setting_overrides)
    functions :: funcs.iter().map(fn(pair) { JetCLITestCoverableFunction{name: pair.0, line: pair.1} }).to_list()
    if mode.json {
        payload :: jet_cli_test_coverage_tree(file, functions, observations)
        write_mode_machine(mode, "{render_status("coverage", true, StatusFields.new().with("coverage", payload))}\n")
        return
    }
    write_mode_renderable(mode, jet_cli_test_coverage_human(file, functions, observations))
}
