fn collect_stmts_implicit_copy_spans(statements: [Stmt], spans: &[Span]) {
    loop statement in statements {
        statement := statement.clone()
        statement.for_each_expr_mut(fn(expr) { collect_copy_span(&expr, &spans) })
    }
}
