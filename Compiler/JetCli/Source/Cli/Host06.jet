pub fn implicit_copy_spans_in_module(module: &LoadedModule) -> [Span] {
    spans := [Span]{}
    collect_stmts_implicit_copy_spans(module.script_body, &spans)
    loop item in module.items -> collect_item_implicit_copy_spans(item, &spans)
    &spans.sort_by_key(fn(span) { -span.start })
    &spans.dedup_by_key(fn(span) { span.start })
    ^spans
}
