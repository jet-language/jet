fn walk_jet_files(dir: OSPath, out: &[OSPath]) {
    entries :: fs.read_dir(dir) ?? return
    entries := entries.flatten().to_list()
    &entries.sort_by_key(fn(entry) { entry.path() })
    loop entry in entries {
        path :: entry.path()
        if path.is_dir() {
            name :: path.file_name().and_then(fn(name) { name.to_str() }) ?? ""
            if !IGNORED_DIRS.contains(name) && !jet_cli_format_skip_walk_path(path.to_string_lossy()) -> walk_jet_files(path, &out)
        } else if path.extension().and_then(fn(e) { e.to_str() }) == Val(Syntax.FILE_EXT) && path.file_name().and_then(fn(name) { name.to_str() }) != Val(Syntax.PAYLOAD_FILE) && !jet_cli_format_skip_walk_path(path.to_string_lossy()) -> &out.push(path)
    }
}
