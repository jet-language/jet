// Rust: Source/CmdCompile.rs:9780
fn ExternalFmtTempDir.new() -> ExternalFmtTempDir Err! {
    stamp :: (SystemTime.now().duration_since(UNIX_EPOCH) ?? return Err(err.to_string())).as_nanos()
    loop attempt in 0..<32 {
        path :: env.temp_dir().join("jet-fmt-{stamp}-{std.process.id()}-{attempt}")
        if fs.create_dir(path) == {
            .Ok(_) -> return Ok(ExternalFmtTempDir{path: path})
            .Err(error) -> { if error.kind() == io.ErrorKind.AlreadyExists -> continue; return Err(error.to_string()) }
        }
    }
    Err("could not allocate a formatter staging directory")
}
