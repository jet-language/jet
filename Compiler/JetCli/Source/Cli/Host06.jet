pub fn run_external_fmt(raw: [String], mode: OutputMode) -> I32 {
    language := String?{None}
    explicit_paths := [String]{}
    child_flags := [String]{}
    preset := String?{None}
    environment := String?{None}
    check_only := false
    show_diff := false
    changed_only := false
    index := 1
    loop index < raw.len() {
        arg :: raw[index]
        if arg == {
            "--lang" -> { index += 1; language = raw.get(index) }
            "--check" -> { check_only = true }
            "--diff" | "--dry-run" -> { check_only = true; show_diff = true }
            "--changed" -> { changed_only = true }
            "--fixtures" | "--preset" | "--env" -> {
                index += 1
                value :: raw.get(index) ?? {
                    cli_error_full("E2104", "{arg} needs a value", "these options select the realized environment", "pass a value after the option")
                    return ExitCodes.USAGE
                }
                if arg == "--preset" -> preset = Val(value)
                if arg == "--env" -> environment = Val(value)
                &child_flags.push(arg)
                &child_flags.push(value)
            }
