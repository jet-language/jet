// The CLI owns this executor for the complete compiler/session lifetime.
// All comptime requests and REPL turns share its one child. Explicit close
// destroys live slots before their retained images unload.
use jet_backend.[X64ExecutionHost, X64ExecutionRequest, X64ExecutionResponse, x64_execution_open, x64_execution_request, x64_execution_close]
use jet_codegen.[JetCodegenClosureSource]
use jet_foundation.[MIRFunctionID]
use core.sys as cli_sys

struct JetCLINativeClosureSources {
    rows: [String:JetCodegenClosureSource]
}

struct JetCLINativeExecutor {
    host: X64ExecutionHost
    // Independent compiler snapshots can reuse a MIR numeric identity. Never
    // resolve an older native closure against the currently compiling source.
    sources: Shared<JetCLINativeClosureSources>
}
impl JetCLINativeExecutor.JetDriverExecutionHost {
    fn execute(self, request: X64ExecutionRequest) -[Exec, IO, FFI.C, FFI.Asm, Time.Wait]> X64ExecutionResponse {
        x64_execution_request(self.host, request)
    }
    fn session_resource(self) -[]> X64ExecutionHost Never! { self.host }
    fn register_closure_sources(self, snapshot: String, sources: [JetCodegenClosureSource]) Never! -[Time.Wait]> {
        loop source in sources -> self.sources.rows["{snapshot}:{source.function.value}"] = source
    }
    fn closure_source(self, snapshot: String, function: MIRFunctionID) -[Time.Wait]> JetCodegenClosureSource? Never! {
        self.sources.rows.get("{snapshot}:{function.value}")
    }
}
fn jet_cli_native_executor(executable: String, runtime: String) -> JetCLINativeExecutor {
    JetCLINativeExecutor{host: x64_execution_open(executable, runtime), sources: shared JetCLINativeClosureSources{rows: [String:JetCodegenClosureSource]{}}}
}
fn jet_cli_native_executor_close(executor: JetCLINativeExecutor) {
    x64_execution_close(executor.host)
}

// The runtime beside the compiler is the same packaged runtime dev images
// link. Missing artifacts are reported only when a native request is selected.
fn jet_cli_native_process_executor() -> JetCLINativeExecutor Never! {
    directory :: jet_cli_runtime_dir()
    key :: jet_cli_runtime_key(directory) ?? ""
    jet_cli_native_executor(cli_sys.executable(), "{directory}/{key}/libjet_runtime.so")
}
