    {qualified_name: "Map.contains_key", signature: "Map.contains_key(key: K) -> Bool", summary: "True when key has an entry.", example: ""},
    {qualified_name: "Map.keys", signature: "Map.keys() -> Iter<K>", summary: "Lazily yields every key in map order.", example: ""},
    {qualified_name: "Map.values", signature: "Map.values() -> Iter<V>", summary: "Lazily yields every value in map order.", example: ""},
    {qualified_name: "Map.each", signature: "Map.each(f: fn(K, V))", summary: "Runs f once per entry.", example: ""},
    {qualified_name: "String.len", signature: "String.len() -> Int", summary: "Number of characters.", example: ""},
    {qualified_name: "String.is_empty", signature: "String.is_empty() -> Bool", summary: "True when the string is empty.", example: ""},
    {qualified_name: "String.contains", signature: "String.contains(s: String) -> Bool", summary: "True when s appears in the string.", example: ""},
    {qualified_name: "String.starts_with", signature: "String.starts_with(s: String) -> Bool", summary: "True when the string starts with s.", example: ""},
