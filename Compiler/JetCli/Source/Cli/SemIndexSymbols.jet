    {qualified_name: "String.to_upper", signature: "String.to_upper() -> String", summary: "Uppercased copy.", example: ""},
    {qualified_name: "String.to_lower", signature: "String.to_lower() -> String", summary: "Lowercased copy.", example: ""},
