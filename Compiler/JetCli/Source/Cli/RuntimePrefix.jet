// The runtime/Core prefix of a Jet-hosted rustc build: the Rust host embeds
// the Prelude and Foundation sources it prepends to the emitted program
// (MIRRust `emit_mir_runtime_text`); the Jet host reads the same files from
// the toolchain source tree and lets JetCodegen assemble them.
use core.files as cli_files
use core.sys as cli_sys
use jet_codegen.[
    JetRustRuntimeAsset,
    JetRustRuntimePrefix,
    JetRustRuntimePrefixInputs,
    JetRustRuntimeSource,
    jet_rust_release_devtools_policy,
    jet_rust_runtime_artifact,
    jet_rust_runtime_asset_paths,
    jet_rust_runtime_prefix,
    jet_rust_runtime_source_paths,
]
use jet_driver.[
    JetDriverVerbOutput,
]
use jet_foundation.[
    JetReleaseInspect,
    MIRArtifactKind,
    MIRProgram,
]

enum JetCLIRuntimeText {
    // The prefix to write before the emitted program.
    Text(text: String)
    // The report that stopped the build.
    Failed(output: JetDriverVerbOutput)
}

fn jet_cli_runtime_unreadable(what: String, color: Bool) -> JetCLIRuntimeText Never! {
    JetCLIRuntimeText.Failed{output: jet_cli_build_failed(what, jet_cli_why("E2105"), "set `{JET_CLI_TOOLCHAIN_ROOT_ENV}` to the Jet toolchain source tree, the directory that holds `Core/` and `crates/`", color)}
}

// The prefix for `program`'s Rust AOT artifact. A test harness builds under
// the development devtools policy (Rust `jet test` runs a non-release
// profile), and so does `development` (`jet emit --rust`, a dev-mode
// artifact); a `--release` build's profile inspects `local` (main.rs
// `ProfileConfig::release`).
fn jet_cli_runtime_text(file: String, program: MIRProgram, color: Bool, development: Bool) -[Env, FS]> JetCLIRuntimeText Never! {
    artifact :: jet_rust_runtime_artifact(program) ?? return JetCLIRuntimeText.Failed{output: jet_cli_ice("the MIR program of `{file}` has no unique Rust artifact")}
    toolchain :: cli_sys.get(JET_CLI_TOOLCHAIN_ROOT_ENV) ?? return jet_cli_runtime_unreadable("`{JET_CLI_TOOLCHAIN_ROOT_ENV}` is not set, so the runtime sources can't be found", color)
    sources := [JetRustRuntimeSource]{}
    loop relative in jet_rust_runtime_source_paths() {
        path :: jet_cli_authority_path(toolchain, relative)
        text :: cli_files.read(path) ?? return jet_cli_runtime_unreadable("can't read the runtime source `{path}`: {err}", color)
        &sources.push(JetRustRuntimeSource{path: relative, text: text})
    }
    assets := [JetRustRuntimeAsset]{}
    loop relative in jet_rust_runtime_asset_paths() {
        path :: jet_cli_authority_path(toolchain, relative)
        bytes :: cli_files.read_bytes(path) ?? return jet_cli_runtime_unreadable("can't read the runtime asset `{path}`: {err}", color)
        &assets.push(JetRustRuntimeAsset{path: relative, bytes: bytes})
    }
    harness :: artifact.harness != None || artifact.kind == MIRArtifactKind.TestExecutable || artifact.kind == MIRArtifactKind.FuzzExecutable || artifact.kind == MIRArtifactKind.TestOverride
    inspect :: if harness || development -> JetReleaseInspect?{None} else -> Val(JetReleaseInspect.Local)
    inputs :: JetRustRuntimePrefixInputs{
        target_triple: jet_cli_host_triple(cli_sys.arch(), cli_sys.name()),
        policy: jet_rust_release_devtools_policy(inspect),
        ffi_crate: None,
        sources: sources,
        assets: assets,
    }
    outcome := JetCLIRuntimeText.Failed{output: jet_cli_ice("the runtime prefix of `{file}` was not assembled")}
    if jet_rust_runtime_prefix(program, artifact, inputs) == {
        .Text(text) -> outcome = JetCLIRuntimeText.Text{text: text}
        .Refused(message) -> outcome = JetCLIRuntimeText.Failed{output: jet_cli_ice("the runtime prefix of `{file}` could not be assembled: {message}")}
    }
    outcome
}
