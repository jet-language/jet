// Source/ReceiptSections.rs append-only section record codec and field diff.
use jet_foundation.[CanonicalJSON, CanonicalJSONField, canonical_json_parse, canonical_json_object, canonical_json_bytes, canonical_json_equal]
use core.crypto as receipt_crypto

struct JetCLIReceiptSectionRecord {
    claim_key: String
    parent_digest: String
    section: JetCLIReceiptSection
}

struct JetCLIReceiptFieldDiff {
    section: String
    field: String
    before: CanonicalJSON?
    after: CanonicalJSON?
}

JET_CLI_RECEIPT_SECTION_RECORD_MAX :: comptime { 67112960 }

fn jet_cli_receipt_section_record_validate(record: JetCLIReceiptSectionRecord) JetCLIReadError! {
    if !jet_cli_receipt_is_digest(record.claim_key) {
        return Err(jet_cli_read_error("receipt section claim digest is malformed"))
    }
    if record.parent_digest != "" && !jet_cli_receipt_is_digest(record.parent_digest) {
        return Err(jet_cli_read_error("receipt section parent digest is malformed"))
    }
    jet_cli_receipt_section_validate(record.section)
}

fn jet_cli_receipt_section_record_body(record: JetCLIReceiptSectionRecord, marker: String) -> [U8] Never! {
    bytes := jet_cli_receipt_section_marker(marker)
    jet_cli_receipt_frame(&bytes, record.claim_key.bytes())
    jet_cli_receipt_frame(&bytes, record.parent_digest.bytes())
    jet_cli_receipt_frame(&bytes, record.section.name.bytes())
    jet_cli_receipt_frame(&bytes, record.section.type_name.bytes())
    jet_cli_receipt_frame(&bytes, record.section.schema_digest.bytes())
    jet_cli_receipt_frame(&bytes, record.section.payload_digest.bytes())
    bytes
}

fn jet_cli_receipt_section_record_identity(record: JetCLIReceiptSectionRecord) -> String Never! {
    receipt_crypto.sha256(jet_cli_receipt_section_record_body(record, "jet-receipt-section-id-v1")).hex()
}

fn jet_cli_receipt_section_record_encode(record: JetCLIReceiptSectionRecord) -> [U8] JetCLIReadError! {
    jet_cli_receipt_section_record_validate(record)
    bytes := jet_cli_receipt_section_record_body(record, "jet-receipt-section-record-v1")
    jet_cli_receipt_frame(&bytes, record.section.bytes)
    if bytes.len() > JET_CLI_RECEIPT_SECTION_RECORD_MAX {
        return Err(jet_cli_read_error("receipt section record is too large (maximum 67112960 bytes)"))
    }
    Ok(bytes)
}

fn jet_cli_receipt_section_record_text(cursor: &JetCLIReceiptCursor, label: String) -> String JetCLIReadError! {
    bytes :: jet_cli_receipt_take(&cursor)
    Ok(String.from_bytes(bytes) ?? return Err(jet_cli_read_error("receipt section {label} is not UTF-8")))
}

fn jet_cli_receipt_section_record_decode(bytes: [U8]) -> JetCLIReceiptSectionRecord JetCLIReadError! {
    if bytes.len() > JET_CLI_RECEIPT_SECTION_RECORD_MAX {
        return Err(jet_cli_read_error("receipt section record is too large"))
    }
    magic :: jet_cli_receipt_section_marker("jet-receipt-section-record-v1")
    if bytes.len() < magic.len() || bytes.slice(0, magic.len()) != magic {
        return Err(jet_cli_read_error("receipt section record magic is invalid"))
    }
    cursor := JetCLIReceiptCursor{bytes: bytes, at: magic.len(), prefix: "receipt section record", maximum: JET_CLI_RECEIPT_SECTION_RECORD_MAX}
    claim_key :: jet_cli_receipt_section_record_text(&cursor, "claim key")
    parent_digest :: jet_cli_receipt_section_record_text(&cursor, "parent digest")
    name :: jet_cli_receipt_section_record_text(&cursor, "name")
    type_name :: jet_cli_receipt_section_record_text(&cursor, "type name")
    schema_digest :: jet_cli_receipt_section_record_text(&cursor, "schema digest")
    payload_digest :: jet_cli_receipt_section_record_text(&cursor, "payload digest")
    value :: jet_cli_receipt_take(&cursor)
    if cursor.at != bytes.len() -> return Err(jet_cli_read_error("receipt section record has trailing bytes"))
    section :: JetCLIReceiptSection{name: name, type_name: type_name, schema_digest: schema_digest, payload_digest: payload_digest, bytes: value}
    jet_cli_receipt_section_validate(section)
    record :: JetCLIReceiptSectionRecord{claim_key: claim_key, parent_digest: parent_digest, section: section}
    jet_cli_receipt_section_record_validate(record)
    Ok(record)
}

fn jet_cli_receipt_field_path(diff: JetCLIReceiptFieldDiff) -> String Never! {
    if diff.field == "$" -> return diff.section
    "{diff.section}.{diff.field}"
}

fn jet_cli_receipt_diff_value(value: CanonicalJSON?) -> String Never! {
    if value == .Val(tree) {
        bytes :: canonical_json_bytes(tree)
        return String.from_bytes(bytes.slice(0, bytes.len() - 1)) ?? "<invalid>"
    }
    "<missing>"
}

fn jet_cli_receipt_field_diff_render(diff: JetCLIReceiptFieldDiff) -> String Never! {
    "{jet_cli_receipt_field_path(diff)}: {jet_cli_receipt_diff_value(diff.before)} -> {jet_cli_receipt_diff_value(diff.after)}"
}

fn jet_cli_receipt_diff_projection(diffs: [JetCLIReceiptFieldDiff]) -> CanonicalJSON Never! {
    values := [CanonicalJSON]{}
    loop diff in diffs {
        fields :: [CanonicalJSONField]{
            {key: "after", value: diff.after ?? CanonicalJSON.Null},
            {key: "before", value: diff.before ?? CanonicalJSON.Null},
            {key: "field", value: CanonicalJSON.String(diff.field)},
            {key: "section", value: CanonicalJSON.String(diff.section)},
        }
        &values.push(canonical_json_object(fields) ?? panic("unique field diff keys"))
    }
    CanonicalJSON.Array(values)
}

fn jet_cli_receipt_missing_fields(section: String, prefix: String, value: CanonicalJSON, removed: Bool, diffs: &[JetCLIReceiptFieldDiff]) Never! {
    if value == .Object(fields) && fields.len() > 0 {
        loop field in fields {
            path :: if prefix == "" -> field.key else -> "{prefix}.{field.key}"
            jet_cli_receipt_missing_fields(section, path, field.value, removed, &diffs)
        }
        return
    }
    &diffs.push(JetCLIReceiptFieldDiff{section: section, field: if prefix == "" -> "$" else -> prefix, before: if removed -> Val(value) else -> None, after: if removed -> None else -> Val(value)})
}

fn jet_cli_receipt_diff_fields(section: String, prefix: String, before: CanonicalJSON, after: CanonicalJSON, diffs: &[JetCLIReceiptFieldDiff]) Never! {
    if before == .Object(before_fields) && after == .Object(after_fields) {
        left := 0
        right := 0
        loop left < before_fields.len() || right < after_fields.len() {
            if right == after_fields.len() || (left < before_fields.len() && before_fields[left].key < after_fields[right].key) {
                child :: before_fields[left]
                path :: if prefix == "" -> child.key else -> "{prefix}.{child.key}"
                &diffs.push(JetCLIReceiptFieldDiff{section: section, field: path, before: Val(child.value), after: None})
                left += 1
            } else if left == before_fields.len() || after_fields[right].key < before_fields[left].key {
                child :: after_fields[right]
                path :: if prefix == "" -> child.key else -> "{prefix}.{child.key}"
                &diffs.push(JetCLIReceiptFieldDiff{section: section, field: path, before: None, after: Val(child.value)})
                right += 1
            } else {
                child_before :: before_fields[left]
                child_after :: after_fields[right]
                path :: if prefix == "" -> child_before.key else -> "{prefix}.{child_before.key}"
                jet_cli_receipt_diff_fields(section, path, child_before.value, child_after.value, &diffs)
                left += 1
                right += 1
            }
        }
        return
    }
    if !canonical_json_equal(before, after) {
        &diffs.push(JetCLIReceiptFieldDiff{section: section, field: if prefix == "" -> "$" else -> prefix, before: Val(before), after: Val(after)})
    }
}

fn jet_cli_receipt_diff_sections(before: [JetCLIReceiptSection], after: [JetCLIReceiptSection]) -> [JetCLIReceiptFieldDiff] JetCLIReadError! {
    before_sections :: jet_cli_receipt_normalized_sections(before)
    after_sections :: jet_cli_receipt_normalized_sections(after)
    diffs := [JetCLIReceiptFieldDiff]{}
    left := 0
    right := 0
    loop left < before_sections.len() || right < after_sections.len() {
        if right == after_sections.len() || (left < before_sections.len() && before_sections[left].name < after_sections[right].name) {
            section :: before_sections[left]
            value :: canonical_json_parse(section.bytes) ?? return Err(jet_cli_read_error("canonical JSON is invalid: {err.message}"))
            jet_cli_receipt_missing_fields(section.name, "", value, true, &diffs)
            left += 1
        } else if left == before_sections.len() || after_sections[right].name < before_sections[left].name {
            section :: after_sections[right]
            value :: canonical_json_parse(section.bytes) ?? return Err(jet_cli_read_error("canonical JSON is invalid: {err.message}"))
            jet_cli_receipt_missing_fields(section.name, "", value, false, &diffs)
            right += 1
        } else {
            section_before :: before_sections[left]
            section_after :: after_sections[right]
            if section_before.type_name != section_after.type_name {
                &diffs.push(JetCLIReceiptFieldDiff{section: section_before.name, field: "@type", before: Val(CanonicalJSON.String(section_before.type_name)), after: Val(CanonicalJSON.String(section_after.type_name))})
            }
            before_value :: canonical_json_parse(section_before.bytes) ?? return Err(jet_cli_read_error("canonical JSON is invalid: {err.message}"))
            after_value :: canonical_json_parse(section_after.bytes) ?? return Err(jet_cli_read_error("canonical JSON is invalid: {err.message}"))
            jet_cli_receipt_diff_fields(section_before.name, "", before_value, after_value, &diffs)
            left += 1
            right += 1
        }
    }
    Ok(diffs)
}
