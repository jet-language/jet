// Source/CmdSchema.rs:60-205. One canonical loader/schema pass, no semantic
// compilation or CLI migration checker. Direct reports are not renderables.
use jet_driver.[JetDriverCompileRequest, JetDriverVerbOutput, JET_DRIVER_EXIT_OK, jet_driver_source_query, jet_driver_load_schema_snapshots, jet_driver_schema_pending_breaks, load_all_snapshots, save_snapshot]
use jet_sema.[SchemaSnapshot, snapshot_from_struct]

fn jet_cli_schema_status_text(snapshots: [SchemaSnapshot], pending: [String]) -> String Never! {
    if snapshots.len() == 0 -> return "no published schemas yet.\nnote: a `#PublishedSchema` struct is snapshotted into .jet/cache/schema/ on `jet registry publish`.\n"
    out := "published schemas in this project:\n\n"
    loop snapshot in snapshots {
        out = "{out}  {snapshot.type_name} — published {snapshot.published_version}"
        if snapshot.squashed_before == .Val(before) -> out = "{out} (squashed before {before})"
        out = "{out}\n    {snapshot.fields.len()} field(s):\n"
        loop field in snapshot.fields -> out = "{out}      {field.name}: {field.ty}\n"
        if pending.contains(snapshot.type_name) -> out = "{out}    pending: a breaking change vs this snapshot — `jet build` would report E0910\n"
        out = "{out}\n"
    }
    out
}

// The host supplies the same authorized load-only request used by source
// explain. None means no readable entry/request: status intentionally ignores
// that advisory failure, but still lists valid canonical snapshots.
fn jet_cli_schema_status_host(root: String, request: JetDriverCompileRequest?) -> JetDriverVerbOutput {
    snapshots :: load_all_snapshots(root)
    pending := [String]{}
    if snapshots.len() > 0 && request == .Val(prepared) {
        loaded :: jet_driver_source_query(prepared)
        if loaded.complete {
            items :: loop source_module in loaded.modules -> source_module.program.items
            pending = jet_driver_schema_pending_breaks(items, jet_driver_load_schema_snapshots(root))
        }
    }
    JetDriverVerbOutput{stdout: jet_cli_schema_status_text(snapshots, pending), stderr: "", exit_code: JET_DRIVER_EXIT_OK}
}

fn jet_cli_schema_squash_summary(count: Int, before: String) -> String Never! {
    if count == 0 -> return "no `#PublishedSchema` structs found — nothing to squash.\n"
    "\nok: {count} snapshot(s) re-baselined. Migration blocks for versions before {before} are no longer required.\nnote: this rewrote .jet/cache/schema/ only — your source is unchanged. Commit the updated snapshots.\n"
}

fn jet_cli_schema_squash_host(root: String, request: JetDriverCompileRequest?, before: String, color: Bool, json: Bool) -> JetDriverVerbOutput {
    prepared :: request ?? return jet_cli_maintenance_error("E2105", "couldn't load the project to read its current schema shape", None, color, json)
    loaded :: jet_driver_source_query(prepared)
    if !loaded.complete -> return jet_cli_maintenance_error("E2105", "couldn't load the project to read its current schema shape", None, color, json)
    // This public loader fact is supplied by SolSema2's source-query seam;
    // do not infer a version from syntax, display paths, or identity strings.
    version :: loaded.entry_package_version ?? "0.0.0"
    count := 0
    out := ""
    loop source_module in loaded.modules {
        loop item in source_module.program.items {
            if item == .Struct(definition) {
                // Rust squash uses the legacy single-marker flag, not the
                // full-build grouped-marker registry's broader predicate.
                if !definition.is_published_schema -> next
                snapshot := snapshot_from_struct(definition, version)
                snapshot.squashed_before = Val(before)
                if save_snapshot(root, snapshot) == {
                    .Ok(_) -> {
                        count += 1
                        out = "{out}  re-baselined `{definition.name}` to version {version} (squashed before {before})\n"
                    }
                    // Rust deliberately does not turn individual failed
                    // saves into reports; count only successfully saved rows.
                    .Err(_) -> {}
                }
            }
        }
    }
    JetDriverVerbOutput{stdout: "{out}{jet_cli_schema_squash_summary(count, before)}", stderr: "", exit_code: JET_DRIVER_EXIT_OK}
}
