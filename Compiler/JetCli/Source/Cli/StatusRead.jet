// Adapted from origin/port/compiler Jetpack/Foundation/Source/Report.jet
// `report_status_value_parse`: use the Core JSON reader, not another parser.
use {
    cli_json: core.encoding.json
    status_math: core.math
    status_text: core.text
    core.encoding.[Dyn]
    jet_foundation.[foundation_float_display, foundation_json_integer]
}

// Rust's `String` refusals from the status readers (StatusValue::parse and
// the ledgers and manifests read through it).
#Error
JetCLIReadError: struct {
    message: String
}

jet_cli_read_error: fn(message: String) -> JetCLIReadError Never! {
    JetCLIReadError{message: message}
}

report_status_value_parse: fn(text: String) -> Dyn JetCLIReadError! {
    if cli_json.parse(text) == {
        .Ok(tree) -> Ok(tree)
        .Err(error) -> Err(jet_cli_read_error(error.reason))
    }
}

// Rust StatusValue::from_dyn over every Dyn variant: a Number lexeme is an
// integer when it parses as one, an integer spelling past Int stays exact,
// and a fraction or exponent is an f64 rendered in its Display form
// (`1.2300e+4` is `12300`); Bytes are their base64 text and a DateTime its
// RFC 3339 text.
jet_cli_status_from_tree: fn(tree: Dyn) -> JetCLIStatusValue JetCLIReadError! {
    value: if tree == {
        .Null -> JetCLIStatusValue.Null
        .Bool(value) -> jet_cli_status_bool(value)
        .Int(value) -> jet_cli_status_int(value)
        .Float(value) -> {
            if !status_math.is_finite(value) {
                return Err(jet_cli_read_error("status fields cannot contain non-finite numbers"))
            }
            JetCLIStatusValue.Float{text: foundation_float_display(value)}
        }
        .Number(lexeme) -> {
            if foundation_json_integer(tree) == .Val(number) -> return Ok(jet_cli_status_int(number))
            float_spelled := false
            loop byte in lexeme.bytes() {
                if byte == (U8{46}) || byte == (U8{101}) || byte == (U8{69}) -> float_spelled = true
            }
            // copy: `lexeme` is a payload view of read parameter `tree`; the status value owns its text.
            if !float_spelled -> return Ok(JetCLIStatusValue.Float{text: lexeme.copy()})
            number: Float.parse(lexeme) ?? return Err(jet_cli_read_error("status number `{lexeme}` is not a JSON number"))
            if !status_math.is_finite(number) {
                return Err(jet_cli_read_error("status fields cannot contain non-finite numbers"))
            }
            JetCLIStatusValue.Float{text: foundation_float_display(number)}
        }
        .Text(value) -> jet_cli_status_text(value)
        .Bytes(_) | .DateTime(_) -> jet_cli_status_text(tree.to_text() ?? panic("Bytes and DateTime always have a text form"))
        .Array(values) -> {
            items := [JetCLIStatusValue]{}
            loop value in values -> &items.push(jet_cli_status_from_tree(value))
            jet_cli_status_array(items)
        }
        .Object(values) -> {
            fields := [JetCLIStatusField]{}
            names := [String:Bool]{}
            loop entry in values {
                if entry.key == "" || status_text.has_control(entry.key) {
                    return Err(jet_cli_read_error("status field names must be non-empty and contain no control characters"))
                }
                if names.get(entry.key) != None {
                    return Err(jet_cli_read_error("duplicate status field `{entry.key}`"))
                }
                names[entry.key] = true
                &fields.push(jet_cli_status_field(entry.key, jet_cli_status_from_tree(entry.value)))
            }
            jet_cli_status_object(fields)
        }
    }
    Ok(value)
}

// StatusValue::parse always goes through the canonical Core JSON reader.
jet_cli_status_value_parse: fn(text: String) -> JetCLIStatusValue JetCLIReadError! {
    jet_cli_status_from_tree(report_status_value_parse(text))
}

jet_cli_status_get: fn(value: JetCLIStatusValue, name: String) -> JetCLIStatusValue? Never! {
    if value == .Object(fields) {
        loop field in fields {
            if field.name == name -> return Val(field.value)
        }
    }
    None
}

jet_cli_status_string: fn(value: JetCLIStatusValue?) -> String? Never! {
    if value == .Val(status) {
        if status == .Text(text) -> return Val(text)
    }
    None
}

jet_cli_status_integer: fn(value: JetCLIStatusValue?) -> Int? Never! {
    if value == .Val(status) {
        if status == .Integer(number) -> return Val(number)
    }
    None
}

jet_cli_status_boolean: fn(value: JetCLIStatusValue?) -> Bool? Never! {
    if value == .Val(status) {
        if status == .Bool(flag) -> return Val(flag)
    }
    None
}

jet_cli_status_list: fn(value: JetCLIStatusValue?) -> [JetCLIStatusValue]? Never! {
    if value == .Val(status) {
        // copy: `items` is a payload of read parameter `value`, which keeps the original; the returned Option owns this one
        if status == .Array(items) -> return Val(items.copy())
    }
    None
}

jet_cli_status_is_object: fn(value: JetCLIStatusValue?) -> Bool Never! {
    if value == .Val(.Object(_)) -> return true
    false
}

jet_cli_status_nested: fn(value: JetCLIStatusValue, field: String, name: String) -> JetCLIStatusValue? Never! {
    child: jet_cli_status_get(value, field) ?? return None
    jet_cli_status_get(child, name)
}
