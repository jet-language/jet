// Source/CmdInspect.rs run_accel/run_decisions. The host supplies authenticated
// receipt rows and actual canonical-pass records; a renderer never probes a store.
use jet_driver.[JetDriverCompileRequest, JetDriverOptimizationQueryResult, JetDriverVerbOutput, jet_driver_optimization_query, jet_driver_present_diagnostics, JET_DRIVER_EXIT_OK, JET_DRIVER_EXIT_USER_ERROR]
use jet_foundation.[Span, diagnostic_render_all, MIRVectorFact, MIRVectorRule, MIRVectorLayout, MIROptimizationRejection, MIRAccelerationFact, MIRAccelerationProof, MIRAccelerationMeasurement, MIRAccelerationDecision, MIRAccelerationGateStatus, MIRDecisionRow, MIRDecisionKind, MIRDecisionDisposition, MIRDerivationMethod, MIRDerivationDisposition, MIRDecisionIdentity, mir_acceleration_gate, mir_acceleration_deferred, mir_acceleration_evaluate, mir_acceleration_proves, mir_acceleration_transform_name, mir_acceleration_pin_name, mir_acceleration_status_name]
use jet_optimizer.MIRDecisionLedger
use jet_foundation.[CanonicalPassBoundaryGap]

struct JetCLIAccelerationSpan {
    start: U64
    end: U64
}
struct JetCLIAccelerationRuntime {
    receipt_digest: String
    receipt_verb: String
    record_sequence: U64
    sequence: U64
    function: String
    loop_header: U64
    source: JetCLIAccelerationSpan
    decision: MIRAccelerationDecision
}
fn jet_cli_optimization_span(span: Span) -> JetCLIStatusValue Never! {
    jet_cli_status_object([jet_cli_status_field("start", jet_cli_status_int(span.start)), jet_cli_status_field("end", jet_cli_status_int(span.end))])
}
// StatusValue accepts all u64s as JSON integers, never as strings or signed casts.
fn jet_cli_optimization_u64(value: U64) -> JetCLIStatusValue Never! { JetCLIStatusValue.Float{text: "{value}"} }
fn jet_cli_optimization_runtime_span(span: JetCLIAccelerationSpan) -> JetCLIStatusValue Never! {
    jet_cli_status_object([jet_cli_status_field("start", jet_cli_optimization_u64(span.start)), jet_cli_status_field("end", jet_cli_optimization_u64(span.end))])
}
fn jet_cli_optimization_optional_u64(value: U64?) -> JetCLIStatusValue Never! {
    if value == .Val(number) -> jet_cli_optimization_u64(number) else -> JetCLIStatusValue.Null
}
fn jet_cli_optimization_optional_int(value: Int?) -> JetCLIStatusValue Never! {
    if value == .Val(number) -> jet_cli_status_int(number) else -> JetCLIStatusValue.Null
}
fn jet_cli_optimization_vector_rule(rule: MIRVectorRule) -> String Never! {
    if rule == {
        .Elementwise -> "elementwise"
        .FieldAccess -> "field-access"
        .ConditionalAccumulate -> "conditional-accumulate"
        .EarlyExitSearch -> "early-exit-search"
        .Reduction -> "reduction"
    }
}
fn jet_cli_optimization_vector_layout(layout: MIRVectorLayout) -> String Never! {
    if layout == {
        .Flat -> "flat"
        .AosStrided -> "aos-strided"
        .ColumnarDirect -> "columnar-direct"
    }
}
fn jet_cli_optimization_rejection(reason: MIROptimizationRejection) -> (code: String, statement: String) Never! {
    if reason == {
        .MissingProof -> (code: "missing-proof", statement: "the loop lacks the required proof")
        .MayTrap -> (code: "may-trap", statement: "the loop may trap")
        .HasEffects -> (code: "has-effects", statement: "the loop body has effects")
        .HasEarlyExit -> (code: "has-early-exit", statement: "the loop has an early exit")
        .MayAlias -> (code: "may-alias", statement: "the loop may alias")
        .CrossIterationDependency -> (code: "cross-iteration-dependency", statement: "iterations depend on each other")
        .DynamicTripCount -> (code: "dynamic-trip-count", statement: "the trip count is dynamic")
        .UnknownCopyCost -> (code: "unknown-copy-cost", statement: "copy cost is unknown")
        .ScalarBoundary -> (code: "scalar-boundary", statement: "the loop crosses a scalar boundary")
        .ObservableLayout -> (code: "observable-layout", statement: "the layout is observable")
        .OwnershipObligation -> (code: "ownership-obligation", statement: "the ownership proof is incomplete")
        .UnsupportedOperation -> (code: "unsupported-operation", statement: "the operation is unsupported")
    }
}
fn jet_cli_optimization_gate_statement(status: MIRAccelerationGateStatus?) -> String Never! {
    if status == None -> return "the runtime profile has not been published"
    if status == {
        .BelowStaticFloor -> "the source item count is at or below the static floor"
        .Pinned(pin) -> "the loop is pinned by {mir_acceleration_pin_name(pin)}"
        .NotReleaseBuild -> "the build is not a release profile"
        .CrossModeParityMissing -> "cross-mode parity proof is incomplete"
        .ColumnCopyNotApplicable -> "nested-reuse facts do not permit a column copy"
        .ProofIncomplete -> "the acceleration proof is incomplete"
        .SampleNotTimed -> "the first serial chunk has not been timed"
        .SpawnCostNotMeasured -> "the once-per-process spawn cost has not been measured"
        .BandwidthFloorNotMeasured -> "the memory-bandwidth floor has not been measured"
        .InvalidMeasurement -> "the supplied measurement is invalid"
        .ProjectedGainBelowThreshold -> "projected gain is below the required threshold"
        .Selected -> "the measured gate selected this transform"
    }
}
fn jet_cli_optimization_measurement(value: MIRAccelerationMeasurement) -> JetCLIStatusValue Never! {
    jet_cli_status_object([
        jet_cli_status_field("items", jet_cli_optimization_u64(value.items)),
        jet_cli_status_field("sample_items", jet_cli_optimization_u64(value.sample_items)),
        jet_cli_status_field("sample_nanos", jet_cli_optimization_u64(value.sample_nanos)),
        jet_cli_status_field("spawn_nanos", jet_cli_optimization_u64(value.spawn_nanos)),
        jet_cli_status_field("bandwidth_floor_nanos", jet_cli_optimization_u64(value.bandwidth_floor_nanos)),
        jet_cli_status_field("floor_nanos", jet_cli_optimization_u64(value.floor_nanos)),
        jet_cli_status_field("projected_serial_nanos", jet_cli_optimization_optional_u64(value.projected_serial_nanos)),
        jet_cli_status_field("required_serial_nanos", jet_cli_optimization_optional_u64(value.required_serial_nanos)),
    ])
}
fn jet_cli_optimization_runtime(value: JetCLIAccelerationRuntime) -> JetCLIStatusValue Never! {
    decision :: value.decision
    pin :: if decision.status == .Pinned(pin) -> jet_cli_status_text(mir_acceleration_pin_name(pin)) else -> JetCLIStatusValue.Null
    jet_cli_status_object([
        jet_cli_status_field("record_sequence", jet_cli_optimization_u64(value.record_sequence)),
        jet_cli_status_field("receipt_digest", jet_cli_status_text(value.receipt_digest)),
        jet_cli_status_field("receipt_verb", jet_cli_status_text(value.receipt_verb)),
        jet_cli_status_field("sequence", jet_cli_optimization_u64(value.sequence)),
        jet_cli_status_field("function", jet_cli_status_text(value.function)),
        jet_cli_status_field("loop_header", jet_cli_optimization_u64(value.loop_header)),
        jet_cli_status_field("source", jet_cli_optimization_runtime_span(value.source)),
        jet_cli_status_field("transform", jet_cli_status_text(mir_acceleration_transform_name(decision.transform))),
        jet_cli_status_field("status", jet_cli_status_text(mir_acceleration_status_name(decision.status))),
        jet_cli_status_field("pin", pin), jet_cli_status_field("selected", jet_cli_status_bool(decision.status == .Selected)),
        jet_cli_status_field("measurement_source", jet_cli_status_text("receipt")),
        jet_cli_status_field("measurement", jet_cli_optimization_measurement(decision.measurement)),
    ])
}
fn jet_cli_optimization_gate_value() -> JetCLIStatusValue Never! {
    gate :: mir_acceleration_gate()
    jet_cli_status_object([
        jet_cli_status_field("static_floor_items", jet_cli_optimization_u64(gate.static_floor_items)),
        jet_cli_status_field("cache_block_bytes", jet_cli_optimization_u64(gate.cache_block_bytes)),
        jet_cli_status_field("required_gain_numerator", jet_cli_optimization_u64(gate.required_gain_numerator)),
        jet_cli_status_field("required_gain_denominator", jet_cli_optimization_u64(gate.required_gain_denominator)),
    ])
}
fn jet_cli_optimization_vector(key: String, fact: MIRVectorFact) -> JetCLIStatusValue Never! {
    rule :: jet_cli_optimization_vector_rule(fact.rule)
    accepted :: fact.decision == .Eligible
    code := JetCLIStatusValue.Null
    statement := JetCLIStatusValue.Null
    if fact.decision == .Rejected(reason) {
        rejection :: jet_cli_optimization_rejection(reason)
        code = jet_cli_status_text(rejection.code)
        statement = jet_cli_status_text(rejection.statement)
    }
    jet_cli_status_object([
        jet_cli_status_field("function", jet_cli_status_text(key)),
        jet_cli_status_field("loop_header", jet_cli_optimization_u64(fact.loop_header.value)),
        jet_cli_status_field("span", jet_cli_optimization_span(fact.span)),
        jet_cli_status_field("rule", jet_cli_status_text(rule)),
        jet_cli_status_field("accepted_rule", if accepted -> jet_cli_status_text(rule) else -> JetCLIStatusValue.Null),
        jet_cli_status_field("layout", jet_cli_status_text(jet_cli_optimization_vector_layout(fact.layout))),
        jet_cli_status_field("packed", jet_cli_status_bool(fact.packed)),
        jet_cli_status_field("lane_width", jet_cli_optimization_optional_int(fact.lane_width)),
        jet_cli_status_field("access_count", jet_cli_status_int(fact.accesses.len())),
        jet_cli_status_field("no_aliasing", jet_cli_status_bool(fact.no_aliasing)),
        jet_cli_status_field("no_early_exit", jet_cli_status_bool(fact.no_early_exit)),
        jet_cli_status_field("effect_free_body", jet_cli_status_bool(fact.effect_free_body)),
        jet_cli_status_field("no_cross_iteration_dependencies", jet_cli_status_bool(fact.no_cross_iteration_dependencies)),
        jet_cli_status_field("decision", jet_cli_status_text(if accepted -> "accepted" else -> "rejected")),
        jet_cli_status_field("rejection_code", code), jet_cli_status_field("rejection_statement", statement),
    ])
}
fn jet_cli_optimization_proof(proof: MIRAccelerationProof) -> JetCLIStatusValue Never! {
    jet_cli_status_object([
        jet_cli_status_field("source_proven", jet_cli_status_bool(proof.source_proven)),
        jet_cli_status_field("independent_iterations", jet_cli_status_bool(proof.independent_iterations)),
        jet_cli_status_field("no_aliasing", jet_cli_status_bool(proof.no_aliasing)),
        jet_cli_status_field("no_cross_iteration_dependencies", jet_cli_status_bool(proof.no_cross_iteration_dependencies)),
        jet_cli_status_field("no_early_exit", jet_cli_status_bool(proof.no_early_exit)),
        jet_cli_status_field("effect_free_body", jet_cli_status_bool(proof.effect_free_body)),
        jet_cli_status_field("ownership_safe", jet_cli_status_bool(proof.ownership_safe)),
        jet_cli_status_field("failure_order_preserved", jet_cli_status_bool(proof.failure_order_preserved)),
    ])
}
// Query functions already have canonical key ordering. Runtime order is the
// authenticated receipt's order (never sorted/replaced by inferred source facts).
fn jet_cli_acceleration_report(query: JetDriverOptimizationQueryResult, scope: String, file: String, runtime: [JetCLIAccelerationRuntime], json: Bool) -> String Never! {
    published :: runtime.len() > 0
    runtime_profile :: if published -> "receipt" else -> "not-published"
    measurement_source :: if published -> "receipt" else -> "none"
    gate :: mir_acceleration_gate()
    text := if json -> "" else -> "accel: scope={scope} source={file} profile={query.profile} release_build={query.release_build} runtime_profile={runtime_profile}\ngate: static_floor_items={gate.static_floor_items} cache_block_bytes={gate.cache_block_bytes} required_gain={gate.required_gain_numerator}/{gate.required_gain_denominator} measurement_source={measurement_source}\n"
    runtime_values := [JetCLIStatusValue]{}
    loop value in runtime {
        if json {
            &runtime_values.push(jet_cli_optimization_runtime(value))
            next
        }
        d :: value.decision
        m :: d.measurement
        text = "{text}runtime acceleration verb={value.receipt_verb} receipt={value.receipt_digest} sequence={value.sequence} function={value.function} loop={value.loop_header} source={value.source.start}-{value.source.end} transform={mir_acceleration_transform_name(d.transform)} status={mir_acceleration_status_name(d.status)} selected={d.status == .Selected} items={m.items} sample_items={m.sample_items} sample_nanos={m.sample_nanos} spawn_nanos={m.spawn_nanos} bandwidth_floor_nanos={m.bandwidth_floor_nanos} floor_nanos={m.floor_nanos} projected_serial_nanos={jet_cli_status_json(jet_cli_optimization_optional_u64(m.projected_serial_nanos))} required_serial_nanos={jet_cli_status_json(jet_cli_optimization_optional_u64(m.required_serial_nanos))}\n"
    }
    if !json && !published -> text = "{text}runtime profile: no matching authenticated receipt.\n"
    vectors := [JetCLIStatusValue]{}
    accelerations := [JetCLIStatusValue]{}
    vector_count := 0
    acceleration_count := 0
    loop function in query.functions {
        loop vector in function.vectors {
            vector_count += 1
            if json {
                &vectors.push(jet_cli_optimization_vector(function.key, vector))
                next
            }
            prefix :: "vector {function.key} loop={vector.loop_header.value} span={vector.span.start}-{vector.span.end} rule={jet_cli_optimization_vector_rule(vector.rule)}"
            if vector.decision == {
                .Eligible -> text = "{text}{prefix} accepted\n"
                .Rejected(reason) -> {
                    rejection :: jet_cli_optimization_rejection(reason)
                    text = "{text}{prefix} rejected: {rejection.statement} ({rejection.code})\n"
                }
            }
        }
        loop fact in function.accelerations {
            acceleration_count += 1
            trip := Int?{None}
            loop loop_fact in function.loops {
                if loop_fact.header == fact.loop_header {
                    trip = loop_fact.trip_count
                    break
                }
            }
            parity := false
            loop vector in function.vectors {
                if vector.loop_header == fact.loop_header {
                    parity = vector.no_aliasing && vector.no_early_exit && vector.effect_free_body && vector.no_cross_iteration_dependencies && mir_acceleration_proves(fact.proof, fact.transform)
                    break
                }
            }
            decision := MIRAccelerationDecision?{None}
            if trip == .Val(items) {
                if U64.from_int(items) == .Ok(count) -> decision = Val(mir_acceleration_evaluate(gate, fact.transform, mir_acceleration_deferred(fact, count, query.release_build, parity)))
            }
            runtime_index := Int?{None}
            if U64.from_int(fact.span.start) == .Ok(start) {
                if U64.from_int(fact.span.end) == .Ok(end) {
                    loop (index, value) in runtime {
                        if value.function != function.key || value.loop_header != fact.loop_header.value || start != value.source.start || end != value.source.end -> next
                        runtime_index = Val(index)
                        decision = Val(value.decision)
                        break
                    }
                }
            }
            status :: decision.map(value -> value.status)
            selected :: if status == .Val(value) -> value == .Selected else -> false
            status_name :: if status == .Val(value) -> mir_acceleration_status_name(value) else -> "runtime-profile-required"
            reason :: jet_cli_optimization_gate_statement(status)
            receipt :: runtime_index != None
            profile :: if receipt -> "receipt" else -> "not-published"
            source :: if receipt -> "receipt" else -> "none"
            measurement :: if json && runtime_index == .Val(index) -> jet_cli_optimization_measurement(runtime[index].decision.measurement) else -> JetCLIStatusValue.Null
            if json -> &accelerations.push(jet_cli_status_object([
                jet_cli_status_field("function", jet_cli_status_text(function.key)),
                jet_cli_status_field("loop_header", jet_cli_optimization_u64(fact.loop_header.value)),
                jet_cli_status_field("span", jet_cli_optimization_span(fact.span)),
                jet_cli_status_field("transform", jet_cli_status_text(mir_acceleration_transform_name(fact.transform))),
                jet_cli_status_field("workload", jet_cli_status_object([
                    jet_cli_status_field("nested_reuse", jet_cli_status_bool(fact.workload.nested_reuse)),
                    jet_cli_status_field("single_pass", jet_cli_status_bool(fact.workload.single_pass)),
                    jet_cli_status_field("column_copy_applicable", jet_cli_status_bool(fact.workload.nested_reuse && !fact.workload.single_pass)),
                ])),
                jet_cli_status_field("proof", jet_cli_optimization_proof(fact.proof)),
                jet_cli_status_field("trip_count", jet_cli_optimization_optional_int(trip)),
                jet_cli_status_field("release_build", jet_cli_status_bool(query.release_build)),
                jet_cli_status_field("cross_mode_parity_proven", jet_cli_status_bool(parity)),
                jet_cli_status_field("gate_status", jet_cli_status_text(status_name)),
                jet_cli_status_field("rejection_statement", jet_cli_status_text(reason)),
                jet_cli_status_field("selected", jet_cli_status_bool(selected)),
                jet_cli_status_field("runtime_profile", jet_cli_status_text(profile)),
                jet_cli_status_field("measurement_source", jet_cli_status_text(source)),
                jet_cli_status_field("measurement", measurement), jet_cli_status_field("gate", jet_cli_optimization_gate_value()),
            ]))
            if json -> next
            trip_text :: if trip == .Val(items) -> "{items}" else -> "unknown"
            text = "{text}acceleration {function.key} loop={fact.loop_header.value} span={fact.span.start}-{fact.span.end} transform={mir_acceleration_transform_name(fact.transform)} status={status_name} reason={reason} trip_count={trip_text} selected={selected} measurement_source={source}\n"
        }
    }
    if !json && vector_count == 0 -> text = "{text}No vector facts declared.\n"
    if !json && acceleration_count == 0 -> text = "{text}No acceleration facts declared.\n"
    if !json -> return text
    fields :: [JetCLIStatusField]{
        jet_cli_status_field("scope", jet_cli_status_text(scope)), jet_cli_status_field("source", jet_cli_status_text(file)),
        jet_cli_status_field("profile", jet_cli_status_text(query.profile)), jet_cli_status_field("release_build", jet_cli_status_bool(query.release_build)),
        jet_cli_status_field("runtime_profile", jet_cli_status_text(runtime_profile)), jet_cli_status_field("measurement_source", jet_cli_status_text(measurement_source)),
        jet_cli_status_field("vectors", jet_cli_status_array(vectors)), jet_cli_status_field("decisions", jet_cli_status_array(accelerations)),
        jet_cli_status_field("runtime_decisions", jet_cli_status_array(runtime_values)), jet_cli_status_field("gate", jet_cli_optimization_gate_value()),
    }
    "{jet_cli_status_render("inspect.accel", true, fields)}\n"
}
fn jet_cli_optimization_kind(kind: MIRDecisionKind) -> String Never! {
    if kind == {
        .Tier -> "tier"
        .Inline -> "inline"
        .Vectorize -> "vectorize"
        .Parallel -> "parallel"
        .Copy -> "copy"
        .Bounds -> "bounds"
        .Deopt -> "deopt"
        .Unreachable -> "unreachable"
        .LoopInvariant -> "loop-invariant"
    }
}
fn jet_cli_optimization_disposition(value: MIRDecisionDisposition) -> String Never! {
    if value == {
        .Accepted -> "accepted"
        .Rejected -> "rejected"
        .Selected -> "selected"
        .NotAttempted -> "not-attempted"
        .Unavailable -> "unavailable"
    }
}
fn jet_cli_optimization_method(value: MIRDerivationMethod) -> String Never! {
    if value == {
        .StaticDerivation -> "static_derivation"
        .FormalProof -> "formal_proof"
        .RecordedExecution -> "recorded_execution"
        .SampledAgreement -> "sampled_agreement"
        .ExternalAssumption -> "external_assumption"
    }
}
fn jet_cli_optimization_derivation(value: MIRDerivationDisposition) -> String Never! {
    if value == {
        .Current -> "current"
        .Stale -> "stale"
        .Expired -> "expired"
        .Redacted -> "redacted"
        .Unavailable -> "unavailable"
        .Unsupported -> "unsupported"
        .BudgetExhausted -> "budget_exhausted"
        .Unknown -> "unknown"
    }
}
fn jet_cli_optimization_identity(value: MIRDecisionIdentity) -> JetCLIStatusValue Never! {
    jet_cli_status_object([
        jet_cli_status_field("source", jet_cli_status_text(value.source)), jet_cli_status_field("configuration", jet_cli_status_text(value.configuration)),
        jet_cli_status_field("profile", jet_cli_status_text(value.profile)), jet_cli_status_field("target", jet_cli_status_text(value.target)),
        jet_cli_status_field("implementation", jet_cli_status_text(value.implementation)), jet_cli_status_field("artifact", jet_cli_status_text(value.artifact)), jet_cli_status_field("run", jet_cli_status_text(value.run)),
    ])
}
fn jet_cli_optimization_decision(row: MIRDecisionRow) -> JetCLIStatusValue Never! {
    identity :: if row.identity == .Val(value) -> jet_cli_optimization_identity(value) else -> JetCLIStatusValue.Null
    method :: if row.evidence_method == .Val(value) -> jet_cli_status_text(jet_cli_optimization_method(value)) else -> JetCLIStatusValue.Null
    disposition :: if row.derivation_disposition == .Val(value) -> jet_cli_status_text(jet_cli_optimization_derivation(value)) else -> JetCLIStatusValue.Null
    reference :: if row.derivation == .Val(value) -> jet_cli_status_text(value.id) else -> JetCLIStatusValue.Null
    edit :: if row.edit == .Val(value) -> jet_cli_status_object([jet_cli_status_field("span", jet_cli_optimization_span(value.span)), jet_cli_status_field("replacement", jet_cli_status_text(value.replacement))]) else -> JetCLIStatusValue.Null
    function_id :: if row.function == .Val(value) -> jet_cli_optimization_u64(value.value) else -> JetCLIStatusValue.Null
    jet_cli_status_object([
        jet_cli_status_field("id", jet_cli_optimization_u64(row.id)), jet_cli_status_field("kind", jet_cli_status_text(jet_cli_optimization_kind(row.kind))),
        jet_cli_status_field("disposition", jet_cli_status_text(jet_cli_optimization_disposition(row.disposition))), jet_cli_status_field("function_id", function_id),
        jet_cli_status_field("function", if row.function_name == "" -> JetCLIStatusValue.Null else -> jet_cli_status_text(row.function_name)),
        jet_cli_status_field("span", jet_cli_optimization_span(row.span)), jet_cli_status_field("rule", jet_cli_status_text(row.rule)),
        jet_cli_status_field("reason", jet_cli_status_text(row.reason)), jet_cli_status_field("producer", jet_cli_status_text(row.producer)), jet_cli_status_field("evidence", jet_cli_status_text(row.evidence)),
        jet_cli_status_field("evidence_method", method), jet_cli_status_field("derivation_disposition", disposition), jet_cli_status_field("derivation_ref", reference),
        jet_cli_status_field("identity", identity), jet_cli_status_field("edit", edit),
    ])
}
fn jet_cli_decisions_report(ledger: MIRDecisionLedger, scope: String, file: String, profile: String, canonical_routes: [JetCLIStatusValue], canonical_route_gaps: [CanonicalPassBoundaryGap], json: Bool) -> String Never! {
    text := if json -> "" else -> "decisions: scope={scope} source={file} profile={profile} record_status=current retention=bounded redaction=none\n"
    values := [JetCLIStatusValue]{}
    counts := [String:Int]{}
    loop row in ledger.rows {
        if json -> &values.push(jet_cli_optimization_decision(row))
        kind :: jet_cli_optimization_kind(row.kind)
        counts[kind] = (counts.get(kind) ?? 0) + 1
        if json -> next
        function :: if row.function_name == "" -> "<package>" else -> row.function_name
        method :: if row.evidence_method == .Val(value) -> jet_cli_optimization_method(value) else -> "unavailable"
        disposition :: if row.derivation_disposition == .Val(value) -> jet_cli_optimization_derivation(value) else -> "unknown"
        reference :: if row.derivation == .Val(value) -> value.id else -> "unavailable"
        identity := "identity=unavailable"
        if row.identity == .Val(value) -> identity = "source={value.source} configuration={value.configuration} profile={value.profile} target={value.target} implementation={value.implementation} artifact={value.artifact} run={value.run}"
        text = "{text}decision id={row.id} kind={kind} disposition={jet_cli_optimization_disposition(row.disposition)} derivation_disposition={disposition} function={function} span={row.span.start}-{row.span.end} rule={row.rule} reason={row.reason} producer={row.producer} evidence={row.evidence} method={method} derivation_ref={reference} {identity}\n"
    }
    kinds := [JetCLIStatusField]{}
    loop kind in ["tier", "inline", "vectorize", "parallel", "copy", "bounds", "deopt", "unreachable", "loop-invariant"] {
        count :: counts.get(kind) ?? 0
        status :: if count == 0 -> "not-applicable" else -> "present"
        if !json -> text = "{text}kind {kind}: {status}\n"
        if json -> &kinds.push(jet_cli_status_field(kind, jet_cli_status_object([jet_cli_status_field("status", jet_cli_status_text(status)), jet_cli_status_field("rows", jet_cli_status_int(count))])))
    }
    if !json {
        if canonical_route_gaps.len() > 0 -> text = "{text}{jet_cli_canonical_route_gap_text(canonical_route_gaps)}"
        return text
    }
    fields := [JetCLIStatusField]{
        jet_cli_status_field("scope", jet_cli_status_text(scope)), jet_cli_status_field("source", jet_cli_status_text(file)), jet_cli_status_field("profile", jet_cli_status_text(profile)),
        jet_cli_status_field("rows", jet_cli_status_array(values)), jet_cli_status_field("kinds", jet_cli_status_object(kinds)), jet_cli_status_field("canonical_routes", jet_cli_status_array(canonical_routes)),
        jet_cli_status_field("record_status", jet_cli_status_text("current")), jet_cli_status_field("retention", jet_cli_status_text("bounded")), jet_cli_status_field("redaction", jet_cli_status_text("none")),
    }
    // Ordinary captures retain Rust's exact schema. Explicit opt-in gaps are
    // a separately labeled specification extension, never execution records.
    if canonical_route_gaps.len() > 0 -> &fields.push(jet_cli_status_field("canonical_route_gaps", jet_cli_status_array(jet_cli_canonical_route_gap_values(canonical_route_gaps))))
    "{jet_cli_status_render("inspect.decisions", true, fields)}\n"
}
// Request/root/profile preparation belongs to the canonical shared host.
// Accel uses its resolved release mode; decisions retains Dev even for --profile release.
// Query first, then collect its canonical journal and held-store receipt rows,
// then present. This ordering preserves the journal of this actual invocation.
fn jet_cli_optimization_host(sources: JetDriverAuthorizedSourceSnapshot, query: JetDriverOptimizationQueryResult, plane: String, scope: String, file: String, runtime: [JetCLIAccelerationRuntime], canonical_routes: [JetCLIStatusValue], color: Bool, json: Bool) -> JetDriverVerbOutput {
    if !query.compile.complete || query.compile.internal_problem != None {
        diagnostics :: jet_driver_present_diagnostics(query.compile.diagnostics, sources, [MIRSourceFile]{})
        report :: if json -> jet_cli_reports_status_json("inspect", false, jet_cli_report_cwd(), file, "", diagnostics) else -> diagnostic_render_all(file, "", diagnostics, color)
        return JetDriverVerbOutput{stdout: if json -> report else -> "", stderr: if json -> "" else -> report, exit_code: JET_DRIVER_EXIT_USER_ERROR}
    }
    output := ""
    if {
        plane == "accel" -> output = jet_cli_acceleration_report(query, scope, file, runtime, json)
        else -> {
            ledger :: query.decisions ?? panic("completed optimization query lost its canonical decisions")
            output = jet_cli_decisions_report(ledger, scope, file, query.profile, canonical_routes, query.canonical_route_gaps, json)
        }
    }
    JetDriverVerbOutput{stdout: output, stderr: "", exit_code: JET_DRIVER_EXIT_OK}
}
