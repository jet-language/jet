// Manifestless script admission reuses PackageModel's offline selector,
// resolver, tree identity and teaching diagnostics. No package manifest is
// synthesized, and no provider, compiler subprocess or network is consulted.
use jet_driver.JetDriverScriptDependency

fn jet_cli_script_dependency_error(path: String, source: String, dep: InlineDep, reason: InlineDepUnresolved, color: Bool) -> JetDriverVerbOutput Never! {
    JetDriverVerbOutput{stdout: "", stderr: diagnostic_render_all(path, source, [Diagnostic]{pkg_inline_deps_e1253(dep, reason)}, color), exit_code: JET_DRIVER_EXIT_USER_ERROR}
}

// Hold every ancestor before the shared path-based resolver may inspect it.
// A missing root is not an error; an existing hostile root fails closed.
fn jet_cli_script_dependency_authority(root: String, name: String) -[FS, Env]> FoundationDirectoryAuthority? InlineDepUnresolved! {
    info :: cli_files.stat(root) ?? {
        if err == .NotFound(_) -> return Ok(None)
        return Err(InlineDepUnresolved.InvalidTree(TreeHashError.IO{path: root, detail: "{err}"}))
    }
    if info.is_symlink -> return Err(InlineDepUnresolved.InvalidTree(TreeHashError.Symlink(root)))
    if !info.is_dir -> return Ok(None)
    held :: foundation_open_directory_authority(root) ?? {
        if err == .NotFound(_) -> return Ok(None)
        return Err(InlineDepUnresolved.InvalidTree(TreeHashError.IO{path: root, detail: "{err}"}))
    }
    stat :: held.entry_stat(name) ?? {
        if err == .NotFound(_) -> return Ok(None)
        return Err(InlineDepUnresolved.InvalidTree(TreeHashError.IO{path: root, detail: "{err}"}))
    }
    path :: cli_files.join(root, name)
    if stat.is_symlink -> return Err(InlineDepUnresolved.InvalidTree(TreeHashError.Symlink(path)))
    if !stat.is_dir -> return Ok(None)
    package :: held.child(name) ?? return Err(InlineDepUnresolved.InvalidTree(TreeHashError.IO{path: path, detail: "{err}"}))
    Ok(Val(package))
}

fn jet_cli_script_dependency_roots(roots: &[JetDriverAuthorizedSourceRoot], entry_path: String, admitted: &[JetDriverScriptDependency], color: Bool) -[FS, Env]> JetDriverVerbOutput? Never! {
    entry_root :: roots[0]
    loop file in entry_root.files {
        if file.relative_path == "package.jet" -> return None
        if file.path == entry_path || JET_CLI_STOCK_ENTRIES.contains(file.relative_path) {
            // The normal package loader owns malformed-carrier diagnostics;
            // do not attempt manifestless resolution before it reports them.
            inline :: if PackageFacts.parse_inline(file.source, file.path) == {
                .Ok(value) -> { value }
                .Err(_) -> { return None }
            }
            if inline == .Val(_) -> return None
        }
    }
    entry :: loop file in entry_root.files { if file.path == entry_path -> break file } ?? return None
    program :: jet_cli_parsed_program(entry.source) ?? return None
    script_dir :: jet_cli_parent(entry_path) ?? "/"
    loop dep in pkg_inline_deps_collect(program) {
        // Name/selector validation belongs to the shared resolver. Do not
        // interpret an invalid import as a pathname even for a preflight.
        if !pkg_inline_deps_valid_package_name(dep.name) {
            return Val(jet_cli_script_dependency_error(entry_path, entry.source, dep, .InvalidName, color))
        }
        if pkg_inline_deps_numeric_version(dep.selector) == None {
            return Val(jet_cli_script_dependency_error(entry_path, entry.source, dep, .InvalidSelector, color))
        }
        local_root :: cli_files.join(script_dir, ".jet/inline-deps")
        authority := if jet_cli_script_dependency_authority(local_root, dep.name) == {
            .Val(held) -> Val(held)
            .None -> None
            .Err(error) -> { return Val(jet_cli_script_dependency_error(entry_path, entry.source, dep, error, color)) }
        }
        if authority == None && cli_sys.get(PKG_INLINE_DEPS_FIXTURES_ENV) == .Val(fixtures) {
            authority = if jet_cli_script_dependency_authority(fixtures, dep.name) == {
                .Val(held) -> Val(held)
                .None -> None
                .Err(error) -> { return Val(jet_cli_script_dependency_error(entry_path, entry.source, dep, error, color)) }
            }
        }
        resolved :: pkg_inline_deps_resolve(dep, script_dir) ?? return Val(jet_cli_script_dependency_error(entry_path, entry.source, dep, err, color))
        if authority == .Val(held) {
            held.revalidate() ?? return Val(jet_cli_script_dependency_error(entry_path, entry.source, dep, .InvalidTree(TreeHashError.IO{path: resolved.dir, detail: "{err}"}), color))
        }
        selected :: foundation_open_directory_authority(resolved.dir) ?? return Val(jet_cli_script_dependency_error(entry_path, entry.source, dep, .InvalidTree(TreeHashError.IO{path: resolved.dir, detail: "{err}"}), color))
        selected_id :: selected.identity() ?? return Val(jet_cli_script_dependency_error(entry_path, entry.source, dep, .InvalidTree(TreeHashError.IO{path: resolved.dir, detail: "{err}"}), color))
        canonical :: selected.path()
        stat :: cli_files.stat(canonical) ?? return Val(jet_cli_script_dependency_error(entry_path, entry.source, dep, .InvalidTree(TreeHashError.IO{path: canonical, detail: "{err}"}), color))
        if stat.id != selected_id -> return Val(jet_cli_script_dependency_error(entry_path, entry.source, dep, .InvalidTree(TreeHashError.IO{path: canonical, detail: "source root changed while held"}), color))
        root_identity :: jet_cli_identity_key("directory", stat)
        found := false
        loop root in roots { if root.identity == root_identity -> found = true }
        if !found {
            files := [JetDriverAuthorizedSourceFile]{}
            directories := [AppAuthorizedDirectory]{}
            budget := JetCLISourceBudget{entries: 0, bytes: 0, files: 0}
            if jet_cli_walk_sources(canonical, "", 0, &files, &directories, true, &budget) == .Val(problem) {
                return Val(jet_cli_script_dependency_error(entry_path, entry.source, dep, .InvalidTree(TreeHashError.IO{path: canonical, detail: problem}), color))
            }
            &roots.push(JetDriverAuthorizedSourceRoot{canonical_path: canonical, identity: root_identity, allow_hardlinks: false, files: files, foreign_cache_files: [JetDriverAuthorizedSourceFile]{}, directories: directories})
        }
        // The same full tree identity must survive source snapshot capture.
        // Held hashing rejects hardlinks and links, including ancestor swaps.
        content_hash :: selected.tree_hash(true) ?? return Val(jet_cli_script_dependency_error(entry_path, entry.source, dep, .InvalidTree(TreeHashError.IO{path: canonical, detail: "{err}"}), color))
        if content_hash != resolved.content_hash -> return Val(jet_cli_script_dependency_error(entry_path, entry.source, dep, .InvalidTree(TreeHashError.IO{path: canonical, detail: "source tree changed while admitted"}), color))
        &admitted.push(JetDriverScriptDependency{name: dep.name, selector: dep.selector, resolved_version: resolved.resolved_version, content_hash: content_hash, root_identity: root_identity, span: dep.span})
    }
    None
}
