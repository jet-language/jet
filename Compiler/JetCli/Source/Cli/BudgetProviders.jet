// The provider inputs `jet budget check` gathers before it measures: the
// native artifact a BuildArtifact budget sizes, built by this `jet`, and the
// service readiness samples the `jetpack` engine's internal ServiceProbe
// transport takes. Both are gathered once per run, before any sample is
// recorded, so a run that can't gather them writes no report.
use {
    providers_crypto: core.crypto
    providers_hex: core.encoding.hex
    cli_files: core.files
    cli_process: core.process
    cli_sys: core.sys
    jet_foundation.[CanonicalJSON, CanonicalJSONField, PerfRational, perf_rational_integer, perf_report_object_new]
    jet_sema.[BudgetSpec, sema_budget_provider_identity, sema_budget_provider_kind]
    jet_driver.[JetDriverBudgetFacts]
    jet_pkg_model.[JET_VERSION]
}

// The samples a ServiceProbe row carries: one per down-up-ready trial.
JET_CLI_BUDGET_SERVICE_SAMPLES: 20

// The built artifact: its path, size in bytes and SHA-256.
JetCLIBudgetArtifact: struct {
    path: String
    bytes: Int
    sha256: String
}

// One service's readiness samples, in nanoseconds.
JetCLIBudgetService: struct {
    name: String
    samples: [Int]
}

// The selected artifact: this `jet` builds the project entry in its root
// within a 120-second deadline, and the artifact is the regular file
// `.jet/build/<stem>` that build leaves. A symlink is refused, so the size
// and hash are of the file the build wrote.
jet_cli_budget_build_artifact: fn(root: String, entry: String) -> JetCLIBudgetArtifact JetCLIBudgetFailure! {
    receipt: cli_process.cmd([String]{cli_sys.executable(), "build", entry}).cwd(root).stdout(.Capture).stderr(.Capture).timeout(120s).run() ?? return Err(jet_cli_budget_failure("cannot start selected artifact build: {jet_cli_io_error_text(err)}"))
    if receipt.timed_out -> return Err(jet_cli_budget_failure("selected artifact build exceeded 120 second build deadline"))
    if !receipt.success -> return Err(jet_cli_budget_failure("selected artifact build exited with status {receipt.code}"))
    path: jet_cli_entry_join(root, ".jet/build/{jet_cli_stem(entry)}")
    info: cli_files.stat(path) ?? return Err(jet_cli_budget_failure("selected artifact was not produced: {jet_cli_io_error_text(err)}"))
    if info.is_symlink || !info.is_file -> return Err(jet_cli_budget_failure("selected artifact is not a regular file"))
    bytes: cli_files.read_bytes(path) ?? return Err(jet_cli_budget_failure("cannot hash selected artifact: {jet_cli_io_error_text(err)}"))
    Ok(JetCLIBudgetArtifact{path: path, bytes: bytes.len(), sha256: providers_crypto.sha256(bytes).hex()})
}

// The readiness evidence of the service `name`. Evidence that can't be
// collected fails the run, and the failure names `jet dev` as the way to
// refresh it.
jet_cli_budget_service: fn(root: String, name: String) -> JetCLIBudgetService JetCLIBudgetFailure! {
    samples: jet_cli_budget_probe_service(root, name) ?? return Err(jet_cli_budget_failure("ServiceProbe `{name}` was not collected: {err.message}; run `jet dev <file>` to refresh service evidence"))
    Ok(JetCLIBudgetService{name: name.copy(), samples: samples}) // copy: the caller keeps the provider's service name.
}

// The `jetpack` engine's `__service-probe` cycles the service down, up and
// ready, and prints one `JETSERVICE1` row: the hex service name, then
// exactly 20 samples.
jet_cli_budget_probe_service: fn(root: String, name: String) -> [Int] JetCLIBudgetFailure! {
    bin: jet_cli_find_engine_binary(JET_CLI_JETPACK_BINARY) ?? return Err(jet_cli_budget_failure("the `{JET_CLI_JETPACK_BINARY}` engine is not installed"))
    if jet_cli_query_engine_protocol(bin) != Val(JET_VERSION) -> return Err(jet_cli_budget_failure("the `{JET_CLI_JETPACK_BINARY}` engine at `{bin}` does not speak jet {JET_VERSION}'s protocol"))
    receipt: cli_process.cmd([String]{bin, "__service-probe", name, "--no-color"}).cwd(root).env(JET_CLI_ROOT_ENGINE_DISPATCH_PID_ENV, "{cli_process.current_pid()}").stdout(.Capture).stderr(.Capture).run() ?? return Err(jet_cli_budget_failure("cannot run `{bin}`: {jet_cli_io_error_text(err)}"))
    if !receipt.success -> return Err(jet_cli_budget_failure("measurement failed: {receipt.errors.trim()}"))
    rows := [String]{}
    loop line in receipt.output.lines() -> rows.push(line)
    if rows.len() == 0 -> return Err(jet_cli_budget_failure("the probe returned no evidence"))
    if rows.len() > 1 -> return Err(jet_cli_budget_failure("the probe returned extra evidence rows"))
    fields := [String]{}
    loop field in rows[0].split("\t") -> fields.push(field)
    if fields.len() < 2 || fields[0] != "JETSERVICE1" || fields[1] != providers_hex.encode(name.bytes()) -> return Err(jet_cli_budget_failure("the probe returned incompatible evidence"))
    samples := [Int]{}
    loop index in 2..<fields.len() {
        value: Int.parse(fields[index]) ?? return Err(jet_cli_budget_failure("the probe did not return exactly {JET_CLI_BUDGET_SERVICE_SAMPLES} samples"))
        if value < 0 -> return Err(jet_cli_budget_failure("the probe did not return exactly {JET_CLI_BUDGET_SERVICE_SAMPLES} samples"))
        samples.push(value)
    }
    if samples.len() != JET_CLI_BUDGET_SERVICE_SAMPLES -> return Err(jet_cli_budget_failure("the probe did not return exactly {JET_CLI_BUDGET_SERVICE_SAMPLES} samples"))
    Ok(samples)
}

// The samples of one budget row: the CompilerFacts value, the built
// artifact's size, or the service's readiness samples.
jet_cli_budget_samples: fn(spec: BudgetSpec, facts: JetDriverBudgetFacts, artifact: JetCLIBudgetArtifact?, services: [JetCLIBudgetService]) -> [PerfRational] JetCLIBudgetFailure! {
    if sema_budget_provider_kind(spec.provider) == {
        "BuildArtifact" -> {
            metric: sema_budget_provider_kind(spec.metric)
            if metric != "BinarySize" && metric != "ArtifactSize" -> return Err(jet_cli_budget_failure("BuildArtifact does not support metric `{spec.metric}`"))
            built: artifact ?? return Err(jet_cli_budget_failure("BuildArtifact budget `{spec.name}` has no built artifact"))
            return Ok([PerfRational]{perf_rational_integer(built.bytes)})
        }
        "ServiceProbe" -> {
            if spec.metric != "ServiceReadiness" -> return Err(jet_cli_budget_failure("ServiceProbe does not support metric `{spec.metric}`"))
            name: sema_budget_provider_identity(spec.provider) ?? ""
            loop service in services {
                if service.name == name -> return Ok(loop sample in service.samples -> perf_rational_integer(sample))
            }
            return Err(jet_cli_budget_failure("ServiceProbe `{name}` was not collected; run `jet dev <file>` to refresh service evidence"))
        }
        else -> {}
    }
    value: jet_cli_budget_compiler_fact(spec.metric, facts)
    Ok([PerfRational]{perf_rational_integer(value)})
}

// The measurement protocol and isolation recorded in the provider identity
// of kind `kind`; a report is comparable only with history taken under the
// same protocol.
jet_cli_budget_provider_version: fn(kind: String) -> (version: String, isolation: String) Never! {
    if kind == {
        "BuildArtifact" -> (version: "jet-artifact-footprint-v1-first-line-vmhwm-trials-20", isolation: "fresh-child-process-per-trial")
        "ServiceProbe" -> (version: "jet-service-readiness-v1-trials-20", isolation: "service-process-group-down-up-per-trial")
        else -> (version: "1", isolation: "process")
    }
}

// The report subject's artifact: its size and SHA-256, Null when no budget
// sizes one.
jet_cli_budget_artifact_json: fn(artifact: JetCLIBudgetArtifact?) -> CanonicalJSON Never! {
    built: artifact ?? return CanonicalJSON.Null
    perf_report_object_new([CanonicalJSONField]{
        CanonicalJSONField{key: "bytes", value: CanonicalJSON.Integer("{built.bytes}")},
        CanonicalJSONField{key: "sha256", value: CanonicalJSON.String(built.sha256.copy())}, // copy: the caller keeps the artifact.
    })
}
