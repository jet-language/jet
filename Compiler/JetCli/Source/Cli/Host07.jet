// Rust: Source/CmdCompile.rs:11199
fn native_cache_key_with_toolchain_and_overlays(file: String, profile: String, profile_tag: String, mode_tag: String, backend: NativeKeyBackend, overlays: [(OSPath, String)], invocation_authority: ApplicationAuthority?) -> String? {
    debug_native_cache_event("key-entry pid={id()} file={file} profile={profile_tag} mode={mode_tag}")
    if env.var_os("JET_PROVE_FRESH_TEST").is_some() {
        debug_native_cache_event("key-none prove-fresh")
        return .None
    }
    bundle := jet.Loader.load_entry_with_overlays(file, overlays, false) ?? {
        debug_native_cache_event("key-none load")
        return .None
    }
    if program_uses_embed(bundle) {
        debug_native_cache_event("key-none embed")
        return .None
    }
    if Driver.seed_build_facts(&bundle, profile, false, [String:String]{}).is_err() {
        debug_native_cache_event("key-none seed-facts")
        return .None
    }
    if jet.Sema.check_bundle(&bundle, .Check).any(fn(diagnostic) { diagnostic.severity == .Error }) {
        debug_native_cache_event("key-none sema")
        return .None
    }
    native_cache_key_for_program(file, bundle, profile_tag, mode_tag, backend, invocation_authority)
}
