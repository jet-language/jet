// Rust: Source/CmdCompile.rs:10710
fn append_link_identity(bytes: &[U8], links: [String], root: OSPath?) {
    loop link in links -> append_cache_field(&bytes, normalize_link_argument(link, root))
    artifacts := [OSPath]{}
    index := 0
    loop index < links.len() {
        argument :: links[index]
        raw_path :: if argument == "-L" { links.get(index + 1).and_then(fn(value) { value.strip_prefix("native=") }) } else { argument.strip_prefix("native=") }
        if raw_path == .Val(raw) -> collect_link_artifacts(resolve_link_path(raw, root), root, &artifacts)
        index += if argument == "-L" { 2 } else { 1 }
    }
    loop link in links {
        raw_path :: link.strip_prefix("link-arg=").filter(fn(path) { !path.starts_with("-Wl,") }) ?? next
        collect_link_artifacts(resolve_link_path(raw_path, root), root, &artifacts)
    }
    identities := artifacts.map(fn(original) {
        path :: fs.canonicalize(original).unwrap_or(original)
        logical :: stable_link_path(path, root)
        digest :: fs.read(path).map(fn(contents) { jet.SHA256.sha256_hex(contents) }).unwrap_or("unreadable")
        (logical, digest)
    })
    &identities.sort()
    &identities.dedup()
    append_cache_field(&bytes, "jet-linked-artifacts.v1")
    loop (path, digest) in identities {
        append_cache_field(&bytes, path)
        append_cache_field(&bytes, digest)
    }
}
// Rust: Source/CmdCompile.rs:10766
fn collect_link_artifacts(path: &OSPath, root: OSPath?, artifacts: &[OSPath]) {
    project :: root ?? return
    canonical :: fs.canonicalize(path).unwrap_or(path.clone())
    if !canonical.starts_with(project) -> return
    if canonical.is_file() {
        if is_link_artifact(canonical) -> &artifacts.push(canonical)
        return
    }
    entries :: fs.read_dir(canonical) ?? return
    loop result in entries {
        entry :: result ?? next
        candidate :: entry.path()
        if candidate.is_file() && is_link_artifact(candidate) -> &artifacts.push(candidate)
    }
}
// Rust: Source/CmdCompile.rs:10791
fn is_link_artifact(path: &OSPath) -> Bool {
    path.extension().is_some_and(fn(extension) {
        value :: extension.to_str()
        value == .Val("a") || value == .Val("so") || value == .Val("dylib") || value == .Val("dll") || value == .Val("lib")
    })
}
// Rust: Source/CmdCompile.rs:10800
fn resolve_link_path(raw: String, root: OSPath?) -> OSPath {
    path := OSPath.new(raw)
    if !path.is_absolute() && root == .Val(project) -> path = project.join(path)
    fs.canonicalize(path).unwrap_or(path)
}
// Rust: Source/CmdCompile.rs:10812
fn stable_link_path(path: &OSPath, root: OSPath?) -> String {
    rendered :: root.and_then(fn(project) { path.strip_prefix(project).ok() }).map(fn(relative) { "project/{relative.to_string_lossy()}" }).unwrap_or_else(fn() { path.to_string_lossy() })
    rendered.replace("\\", "/")
}
// Rust: Source/CmdCompile.rs:10820
fn normalize_link_argument(argument: String, root: OSPath?) -> String {
    loop marker in ["native=", "dependency=", "link-arg=-Wl,-rpath,"] {
        if argument.strip_prefix(marker) == .Val(raw_path) {
            path :: resolve_link_path(raw_path, root)
            return "{marker}{stable_link_path(path, root)}"
        }
    }
    if argument.strip_prefix("link-arg=").filter(fn(path) { !path.starts_with("-Wl,") }) == .Val(raw_path) {
        path :: resolve_link_path(raw_path, root)
        return "link-arg={stable_link_path(path, root)}"
    }
    argument
}
// Rust: Source/CmdCompile.rs:10837
fn native_cache_salt(toolchain: String, dependency_fingerprint: String, runtime_fingerprint: String, corelib_fingerprint: String, mode: String, target: String, instance_fingerprints: [String], bridge_identity: String?, comptime_inputs: [ComptimeInput], authority_identity: String?) -> String {
    native_cache_salt_with_schema(NATIVE_CACHE_SALT_SCHEMA, toolchain, dependency_fingerprint, runtime_fingerprint, corelib_fingerprint, mode, target, instance_fingerprints, bridge_identity, comptime_inputs, authority_identity)
}
// Rust: Source/CmdCompile.rs:10863
fn native_cache_salt_with_schema(schema: [U8], toolchain: String, dependency_fingerprint: String, runtime_fingerprint: String, corelib_fingerprint: String, mode: String, target: String, instance_fingerprints: [String], bridge_identity: String?, comptime_inputs: [ComptimeInput], authority_identity: String?) -> String {
    instances := instance_fingerprints.clone()
    &instances.sort()
    inputs := comptime_inputs.map(fn(input) { (input.path, input.hash) })
    &inputs.sort_unstable()
    bytes := [U8]{}
    &bytes.extend(schema)
    loop value in [toolchain, dependency_fingerprint, runtime_fingerprint, corelib_fingerprint, mode, target, bridge_identity.unwrap_or("none")] -> append_cache_field(&bytes, value)
    &bytes.extend(instances.len().to_u64().to_be_bytes())
    loop instance in instances -> append_cache_field(&bytes, instance)
    &bytes.extend(inputs.len().to_u64().to_be_bytes())
    loop (path, hash) in inputs {
        append_cache_field(&bytes, path)
        append_cache_field(&bytes, hash)
    }
    if authority_identity == .Val(identity) {
        append_cache_field(&bytes, "application-authority")
        append_cache_field(&bytes, identity)
    }
    jet.SHA256.sha256_hex(bytes)
}
