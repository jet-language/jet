// Rust: Source/CmdCompile.rs:11290
fn native_cache_key_for_program(file: String, bundle: &jet.AST.ProgramBundle, profile_tag: String, mode_tag: String, backend: NativeKeyBackend, invocation_authority: ApplicationAuthority?) -> String? {
    debug_native_cache_event("program-key-entry pid={id()} file={file} profile={profile_tag} mode={mode_tag} modules={bundle.modules.len()}")
    if env.var_os("JET_PROVE_FRESH_TEST").is_some() {
        debug_native_cache_event("program-key-none prove-fresh")
        return .None
    }
    (toolchain_identity, runtime_fingerprint, corelib_fingerprint) :: if backend == {
        .Rustc(identity) -> {
            devtools_policy :: Driver.release_devtools_policy_for_bundle(bundle, profile_tag)
            (identity, jet.Codegen.cached_runtime_fingerprint_with_policy(devtools_policy), jet.Codegen.corelib_emission_fingerprint_with_policy(bundle, mode_tag.starts_with("test"), devtools_policy))
        }
        .Cranelift -> (DEV_AOT_TOOLCHAIN_IDENTITY.get(), "", "")
    }
    if !native_cacheable_program(bundle) -> return .None
    bridge_identity :: jet.FFI.prepare(bundle).map(fn(link) { link.map(fn(value) { value.cache_identity }) }) ?? return .None
    instances := [String]{}
    loop module in bundle.modules {
        loop item in module.items {
            if item == .CodeModule(cm) && cm.instance_identity == .Val(identity) -> &instances.push(identity.fingerprint.clone())
        }
    }
    dependency_interfaces :: dependency_interface_fingerprint(bundle)
    manifest :: manifest_fingerprint(file) ?? {
        debug_native_cache_event("program-key-none manifest")
        return .None
    }
    // Selected target dossier, never host OS or CPU facts. GATE #4483.
    target_identity :: jet.SHA256.sha256_hex(bundle.build_facts.target_dossier.cache_bytes(bundle.build_facts.target_triple))
    authority_identity :: application_authority_cache_identity(invocation_authority)
    salt :: native_cache_salt(toolchain_identity, "{manifest}:{dependency_interfaces}", runtime_fingerprint, corelib_fingerprint, mode_tag, target_identity, instances, bridge_identity, bundle.comptime_inputs, authority_identity)
    canonical :: jet.CanonicalAST.canonical_bytes(bundle)
    canonical_fingerprint :: jet.SHA256.sha256_hex(canonical)
    key :: jet.CanonicalAST.ast_cache_key(bundle, profile_tag, salt, bundle.build_facts)
    if env.var("JET_DEBUG_NATIVE_CACHE_LOG") == .Ok(path) {
        line :: "pid={id()} file={file} profile={profile_tag} mode={mode_tag} canonical={canonical_fingerprint} toolchain={jet.SHA256.sha256_hex(toolchain_identity.bytes())} dependency={dependency_interfaces} runtime={runtime_fingerprint} corelib={corelib_fingerprint} manifest={manifest} salt={salt} key={key} instances={instances:?} comptime_inputs={bundle.comptime_inputs:?}\n"
        if fs.OpenOptions.new().create(true).append(true).open(OSPath.new(path)) == .Ok(log) -> _ :: &log.write_all(line.bytes())
    }
    debug_native_cache_event("program-key-ok pid={id()} file={file} key={key}")
    .Val(key)
}
