// Rust: Source/CmdCompile.rs:11480
pub fn validate_target(triple: String, mode: OutputMode) {
    if jet.Doctor.probe_target_component(triple) == .Err(error) {
        needs_install_hint :: if error == { .SysrootUnavailable, .LibraryUnavailable(_) -> true; _ -> false }
        fix :: error.fix(triple)
        diag :: jet.Sema.e3302(triple)
        src :: "// cross-build for {triple}"
        report_problems(mode, "<target>", src, [diag])
        if needs_install_hint -> write_mode_diagnostic(mode, " why: {fix}\n")
        exit(ExitCodes.USER_ERROR)
    }
}

