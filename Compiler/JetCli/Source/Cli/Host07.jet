// Rust: Source/CmdCompile.rs:11067
fn dependency_interface_fingerprint(bundle: &jet.AST.ProgramBundle) -> String {
    interfaces := [(String, String, [U8])]{}
    loop (dependency, root) in bundle.dep_roots {
        loop (module_idx, module) in bundle.modules.enumerate() {
            if !module.path.starts_with(root) -> next
            loop item in module.items {
                name :: if item == {
                    .Func(def), .Struct(def), .Enum(def), .Trait(def), .Tag(def), .CodeModule(def) -> .Val(def.name)
                    _ -> .None
                }
                public :: name.is_some_and(fn(value) { bundle.name_ledger.exported(module_idx, value) })
                if public -> &interfaces.push((dependency.clone(), module.display.clone(), jet.CanonicalAST.canonical_fragment(item)))
            }
        }
    }
    &interfaces.sort_by(fn(a, b) { (a.0, a.1, a.2).cmp((b.0, b.1, b.2)) })
    bytes := [U8]{}
    loop (dependency, module, interface) in interfaces {
        loop value in [dependency.bytes(), module.bytes(), interface] {
            &bytes.extend(value.len().to_u64().to_be_bytes())
            &bytes.extend(value)
        }
    }
    jet.SHA256.sha256_hex(bytes)
}
