struct WebRustcIncrementalSession {
    root: OSPath
    pid: U32
    // GATE #4499: native-path equality/order keys; never display strings.
    process_roots: [OSPath:OSPath]
    reused_dirs: U64
    // Rust: Source/CmdCompile.rs:11515
    fn new(build_root: &OSPath) -> WebRustcIncrementalSession {
        WebRustcIncrementalSession{root: build_root.join(".jet-web-incremental"), pid: id(), process_roots: [OSPath:OSPath]{}, reused_dirs: 0}
    }
    // Rust: Source/CmdCompile.rs:11524
    fn prepare_dir(&self, identity: String, emit_maps: Bool, has_ffi: Bool) -> OSPath Err! {
        identity_root :: self.root.join(identity)
        fs.create_dir_all(identity_root) ?? return Err("error: couldn't prepare Web rustc incremental cache {identity_root.display()}: {err}")
        self.prune_stale_siblings(identity_root)
        process_root :: identity_root.join(self.pid.to_string())
        fs.create_dir_all(process_root) ?? return Err("error: couldn't prepare Web rustc process cache {process_root.display()}: {err}")
        self.process_roots[process_root.clone()] = identity_root
        dir :: process_root.join(if emit_maps { "debug" } else { "release" }).join(if has_ffi { "ffi" } else { "plain" })
        fs.create_dir_all(dir) ?? return Err("error: couldn't prepare Web rustc incremental cache {dir.display()}: {err}")
        if fs.read_dir(dir).ok().and_then(fn(&entries) { &entries.next() }).is_some() -> self.reused_dirs = self.reused_dirs.saturating_add(1)
        Ok(dir)
    }
    // Rust: Source/CmdCompile.rs:11567 (cfg(test) observation).
    fn reused_dirs(&self) -> U64 { self.reused_dirs }
    // Rust: Source/CmdCompile.rs:11571
    fn prune_stale_siblings(&self, identity_root: &OSPath) {
        proc_root :: OSPath.new("/proc")
        if !proc_root.is_dir() -> return
        entries :: fs.read_dir(identity_root) ?? return
        loop result in entries {
            entry :: result ?? next
            path :: entry.path()
            file_type :: entry.file_type() ?? next
            if !file_type.is_dir() -> next
            pid :: U32.parse(entry.file_name().to_string_lossy()) ?? next
            if pid != self.pid && !proc_root.join(pid.to_string()).is_dir() -> _ :: fs.remove_dir_all(path)
        }
    }
    // Rust: Source/CmdCompile.rs:11596
    fn cleanup(&self) {
        roots :: &self.process_roots.take()
        keys := roots.keys().collect()
        &keys.sort()
        loop process_root in keys {
            _ :: fs.remove_dir_all(process_root)
            _ :: fs.remove_dir(roots[process_root])
        }
    }
}
// Rust: Source/CmdCompile.rs:11605
impl Close for WebRustcIncrementalSession { fn close(&self) { self.cleanup() } }

// Rust: Source/CmdCompile.rs:11613
pub fn run_dev_web(file: String, profile: &BuildProfile, mode: OutputMode, verbose: Bool, port: U16?, canvas: Bool, canvas_options: CanvasHostOptions?, setting_overrides: [String:String]) {
    release_policy :: release_devtools_policy_for_profile(profile)
    path :: OSPath.new(file)
    if !path.exists() {
        cli_error_fix("E2105", "can't find the file `{file}`", "check the spelling, or run {Syntax.BINARY_NAME} from the folder that contains it")
        exit(ExitCodes.USER_ERROR)
    }
    project_root :: jet.build_project_root(file) ?? {
        source :: fs.read_to_string(path).unwrap_or("")
        report_problems(mode, file, source, err)
        exit(ExitCodes.USER_ERROR)
    }
    static_root :: build_output_root(project_root)
    rustc_incremental_session := WebRustcIncrementalSession.new(static_root)
    host :: if canvas {
        options :: canvas_options.unwrap_or(CanvasHostOptions.default())
        WebHost.bind_web_with_canvas_options_and_policy(file, static_root, verbose, port, options, release_policy.clone())
    } else { WebHost.bind_with_policy(file, static_root, verbose, port, release_policy) } ?? {
        if canvas { emit_cli_diagnostic_with_fix("E2105", err, "close the existing Canvas session or choose another `--canvas-port`") } else { write_mode_diagnostic(mode, "{err}\n") }
        exit(ExitCodes.USER_ERROR)
    }
    resident_session :: host.resident_session()
    _project_rebuild_executor :: resident_session.register_project_rebuild_executor() ?? {
        write_mode_diagnostic(mode, "{err}\n")
        &rustc_incremental_session.cleanup()
        exit(ExitCodes.USER_ERROR)
    }
    watch := WatchSession.open(path) ?? {
        write_mode_diagnostic(mode, jet.render_all_colored(file, "", [err], mode.color_stderr()))
        &rustc_incremental_session.cleanup()
        exit(ExitCodes.USER_ERROR)
    }
    if rebuild_dev_web(file, profile, mode, verbose, false, host, setting_overrides, &rustc_incremental_session).is_err() {
        &rustc_incremental_session.cleanup()
        exit(ExitCodes.USER_ERROR)
    }
    if canvas {
        host.start_canvas()
        CmdDevTools.open_canvas_browser(host.canvas_url())
    } else { host.start() }
    loop {
        &watch.wait_for_change_for(.Val(Duration.from_millis(WATCH_POLL_INTERVAL_MS)))
        if host.exit_code() == .Val(code) {
            &rustc_incremental_session.cleanup()
            exit(code)
        }
        if &watch.poll() == .Val(receipt) {
            if receipt.change_kinds.all(fn(kind) { kind == "stale" }) -> next
            _ :: rebuild_dev_web(file, profile, mode, verbose, true, host, setting_overrides, &rustc_incremental_session)
            &watch.acknowledge(receipt) ?? {
                write_mode_diagnostic(mode, jet.render_all_colored(file, "", [err], mode.color_stderr()))
                &rustc_incremental_session.cleanup()
                exit(ExitCodes.USER_ERROR)
            }
        }
        if resident_session.take_project_rebuild() == {
            .Ok(.Val(request)) -> {
                result :: rebuild_dev_web(file, profile, mode, verbose, true, host, setting_overrides, &rustc_incremental_session)
                resident_session.finish_project_rebuild(request, result) ?? write_mode_diagnostic(mode, "{err}\n")
            }
            .Ok(.None) -> {}
            .Err(error) -> write_mode_diagnostic(mode, "{error}\n")
        }
    }
}
