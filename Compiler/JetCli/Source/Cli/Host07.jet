// Rust: Source/CmdCompile.rs:10616
pub struct FuzzRunOpts {
    pub iterations: U64?
    pub time_budget_ms: U64?
    pub seed: U64?
    pub corpus: String?
}
// Rust: Source/CmdCompile.rs:10629
pub fn run_fuzz(file: String, test_name: String?, opts: FuzzRunOpts, mode: OutputMode) {
    replacement := "{Syntax.BINARY_NAME} test --grade=generated"
    if opts.iterations == .Val(iterations) -> replacement = "{replacement} --iterations={iterations}"
    replacement = "{replacement} {file}"
    if test_name == .Val(name) -> replacement = "{replacement} {name}"
    _ :: (opts.time_budget_ms, opts.seed, opts.corpus, mode)
    cli_error("E2104", "`jet fuzz` is retired; use `{replacement}`")
    exit(ExitCodes.USAGE)
}

// Rust: Source/CmdCompile.rs:10649
fn package_build_fingerprint(file: String) -> String? Unit! {
    (root, facts) :: load_pkg_manifest(file) ?? return Ok(.None)
    resolver :: jet.Authority.AuthorityResolver.open(root) ?? return Err(())
    maybe_entry :: facts.resolve_build_entry_checked(resolver) ?? return Err(())
    entry :: maybe_entry ?? return Ok(.None)
    raw :: entry.text() ?? return Err(())
    source :: if entry.path.file_name().and_then(fn(name) { name.to_str() }) == .Val(Syntax.PACKAGE_FILE) { jet.Package.build_entry_source(raw).unwrap_or(raw) } else { raw }
    entry_path :: entry.path.to_string_lossy()
    bundle :: jet.Loader.load_entry_with_overlay(entry_path, .Val((entry.path, source)), false) ?? return Err(())
    Ok(.Val(jet.SHA256.sha256_hex(jet.CanonicalAST.canonical_bytes(bundle))))
}
// Rust: Source/CmdCompile.rs:10677
fn manifest_fingerprint(file: String) -> String? {
    search_from :: OSPath.new(file).parent().unwrap_or(OSPath.new("."))
    package_root :: jet.Loader.find_package_root_checked(search_from) ?? return .None
    (unused_root, facts) :: load_pkg_manifest(file) ?? return if package_root.is_none() { .Val("") } else { .None }
    build :: package_build_fingerprint(file).ok() ?? return .None
    bytes := "jet.package-semantic.v2{TEXT_NUL}".bytes()
    append_cache_field(&bytes, facts.semantic_digest())
    append_cache_field(&bytes, build.unwrap_or(""))
    .Val(jet.SHA256.sha256_hex(bytes))
}
