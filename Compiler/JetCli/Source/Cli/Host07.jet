// Rust: Source/CmdCompile.rs:10918
fn application_authority_cache_identity(authority: ApplicationAuthority?) -> String? {
    selected :: authority ?? return .None
    bytes := [U8]{}
    &bytes.extend(APPLICATION_AUTHORITY_CACHE_SCHEMA)
    append_cache_field(&bytes, selected.authority)
    loop (name, holds) in [("required", selected.required_effects), ("granted", selected.granted_effects), ("denied", selected.denied_effects)] {
        append_cache_field(&bytes, name)
        &bytes.extend(holds.len().to_u64().to_be_bytes())
        loop hold in holds -> append_cache_field(&bytes, hold)
    }
    .Val(jet.SHA256.sha256_hex(bytes))
}
// Rust: Source/CmdCompile.rs:10939
fn command_identity(program: String, args: [String]) -> String {
    command := Command.new(OSPath.new(program))
    &command.args(args)
    output :: &command.output() ?? return "unavailable:{err.kind():?}"
    bytes := [U8]{}
    &bytes.extend(output.status.code().unwrap_or(-1).to_i64().to_be_bytes())
    &bytes.extend(output.stdout)
    &bytes.extend(output.stderr)
    jet.SHA256.sha256_hex(bytes)
}
// Rust: Source/CmdCompile.rs:10952
fn rustc_identity() -> (String, String) {
    command := Command.new(OSPath.new("rustc"))
    &command.arg("-vV")
    output :: &command.output() ?? {
        unavailable :: "unavailable:{err.kind():?}"
        return (unavailable.clone(), unavailable)
    }
    bytes := [U8]{}
    &bytes.extend(output.status.code().unwrap_or(-1).to_i64().to_be_bytes())
    &bytes.extend(output.stdout)
    &bytes.extend(output.stderr)
    verbose :: String.from_utf8_lossy(output.stdout)
    backend :: verbose.lines().find(fn(line) { line.starts_with("LLVM version:") }).unwrap_or("LLVM version: unavailable")
    (jet.SHA256.sha256_hex(bytes), backend)
}
