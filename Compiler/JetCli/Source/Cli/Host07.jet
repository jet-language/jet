// Rust: Source/CmdCompile.rs:11793
fn rebuild_dev_web(file: String, profile: &BuildProfile, mode: OutputMode, verbose: Bool, is_rebuild: Bool, host: &WebHost, setting_overrides: [String:String], rustc_incremental_session: &WebRustcIncrementalSession) Err! {
    _source_transaction :: host.lock_source_transaction()
    result :: build_dev_web(file, profile, mode, verbose, is_rebuild, host, setting_overrides, &rustc_incremental_session)
    if is_rebuild && mode.json -> emit_dev_rebuild_status(mode, file, host, result.as_ref().err())
    result.map_err(fn(failure) { failure.message })
}
// Rust: Source/CmdCompile.rs:11824
fn emit_dev_rebuild_status(mode: OutputMode, file: String, host: &WebHost, failure: DevWebBuildFailure?) {
    revisions :: host.revision_facts()
    revision :: fn(value: U64?) { value.map(StatusValue.from).unwrap_or(.Null) }
    fields := StatusFields.new().with("file", file).with("candidate", revision(revisions.candidate)).with("diagnostic_revision", revision(revisions.diagnostic)).with("accepted_revision", revision(revisions.accepted)).with("last_good_revision", revision(revisions.accepted))
    reports := []
    if failure == .Val(value) {
        if value.diagnostics.is_empty() {
            fields = fields.with("error", value.message)
        } else {
            machine_file :: machine_report_path_for_process(file)
            clears :: jet.Diagnostics.report_clear_counts(value.diagnostics)
            reports = value.diagnostics.zip(clears).map(fn((diagnostic, count)) { diagnostic.to_report_with_clears(machine_file, value.source, count) })
        }
    }
    rendered :: render_status_with_reports("dev.rebuild", failure.is_none(), reports, fields)
    write_mode_machine(mode, "{rendered}\n")
}
// Rust: Source/CmdCompile.rs:11859
fn build_dev_web(file: String, profile: &BuildProfile, mode: OutputMode, verbose: Bool, is_rebuild: Bool, host: &WebHost, setting_overrides: [String:String], rustc_incremental_session: &WebRustcIncrementalSession) DevWebBuildFailure! {
    started :: Instant.now()
    host.mark_building()
    src :: fs.read_to_string(OSPath.new(file)).unwrap_or("")
    project_root :: jet.build_project_root(file) ?? {
        message :: jet.render_diagnostics(file, src, err)
        if !is_rebuild -> report_problems(mode, file, src, err)
        host.mark_error("E2105", message.clone(), is_rebuild)
        return Err(DevWebBuildFailure{message: message, source: src, diagnostics: err})
    }
    out :: jet.compile_web_with_gates_and_profile_and_settings(file, jet.Policy.GateSet.default(), profile.budget_name(), setting_overrides) ?? {
        if !is_rebuild -> report_problems(mode, file, src, err)
        code :: err.first().map(fn(diagnostic) { diagnostic.code.to_string() }).unwrap_or("")
        message :: jet.render_diagnostics(file, src, err)
        host.mark_error(code, message.clone(), is_rebuild)
        return Err(DevWebBuildFailure{message: message, source: src, diagnostics: err})
    }
    web :: out.web ?? {
        message :: jet.Diagnostics.render_ice_report("missing web codegen output", "", false)
        write_mode_diagnostic(mode, "{message}\n")
        host.mark_error("ICE", message.clone(), is_rebuild)
        return Err(DevWebBuildFailure.host(message))
    }
    build_root :: build_output_root(project_root)
    staging :: build_root.join(".jet-dev-staging")
    staging_authority :: WebOutputAuthority.open_or_create(staging, project_root) ?? {
        message :: "error: couldn't open web staging output: {err}"
        write_mode_diagnostic(mode, "{message}\n")
        host.mark_error("ICE", message.clone(), is_rebuild)
        return Err(DevWebBuildFailure.host(message))
    }
    write_web_artifacts(file, web, out.ffi, verbose, staging_authority, .Val(&rustc_incremental_session), true, mode) ?? {
        write_mode_diagnostic(mode, "{err}\n")
        host.mark_error("ICE", err.clone(), is_rebuild)
        return Err(DevWebBuildFailure.host(err))
    }
    stage_and_swap(staging, build_root, project_root) ?? {
        message :: "couldn't finalize web build: {err}"
        write_mode_diagnostic(mode, "{message}\n")
        host.mark_error("ICE", message.clone(), is_rebuild)
        return Err(DevWebBuildFailure.host(message))
    }
    host.mark_ready(started.elapsed().as_millis(), is_rebuild)
    Ok(())
}
