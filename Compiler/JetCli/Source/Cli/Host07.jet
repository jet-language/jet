struct DevWebBuildFailure {
    message: String
    source: String
    diagnostics: [Diagnostic]
    // Rust: Source/CmdCompile.rs:11784
    fn host(message: String) -> DevWebBuildFailure {
        DevWebBuildFailure{message: message, source: "", diagnostics: []}
