fn bin_path(project_root: &OSPath, file: String) -> OSPath { build_output_root(project_root).join(stem(file)) }
// Rust: Source/CmdCompile.rs:10570
fn programmable_build_target_name(output: &Driver.BuildCompileOutput) -> String? {
    build :: output.build ?? return .None
    default_target :: build.plan.default_target() ?? return .None
    target_id :: default_target.id().0
    target :: build.plan.targets().get(target_id) ?? return .None
    if target.kind == .Executable { .Val(target.name.clone()) } else { .None }
}
// Rust: Source/CmdCompile.rs:10577
fn build_artifact_path(project_root: &OSPath, file: String, target_name: String?) -> OSPath {
    name :: target_name ?? return bin_path(project_root, file)
    components := OSPath.new(name).components()
    first :: &components.next()
    second :: &components.next()
    if first == .Val(.Normal(_)) && second.is_none() -> return build_output_root(project_root).join(name)
    bin_path(project_root, file)
}
