// Rust: Source/CmdCompile.rs:11443
fn native_cacheable_program(bundle: &jet.AST.ProgramBundle) -> Bool {
    !bundle.cffi.links_c() && !jet.FFI.collect_externs(bundle).any(fn(entry) { entry.c_abi })
}
// Rust: Source/CmdCompile.rs:11452
fn inject_game_crash_reporter_bootstrap(rust_code: &String, game_runtime: Bool) {
    if !game_runtime -> return
    // Rust: Source/CmdCompile.rs:11456
    MAIN :: "fn main() {\n"
