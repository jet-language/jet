fn program_uses_embed(bundle: &jet.AST.ProgramBundle) -> Bool {
    bundle.modules.any(fn(module) { module.source.contains(Syntax.BUILTIN_EMBED_FILE) || module.source.contains(Syntax.BUILTIN_EMBED_BYTES) })
}
