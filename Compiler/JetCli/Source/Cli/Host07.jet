fn setting_overrides_tag(settings: [String:String]) -> String {
    if settings.is_empty() -> return "settings=default"
    keys := settings.keys().collect()
    &keys.sort()
    fields := [String]{}
    loop key in keys {
        value :: settings[key]
        &fields.push("{key.len()}:{key}{value.len()}:{value}")
    }
    "settings={fields.join("")}"
}
