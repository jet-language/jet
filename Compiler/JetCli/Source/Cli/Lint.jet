// Source/CmdDevTools.rs lint --complexity and the JSON-aware --a11y host.
use core.time as cli_time
use jet_driver.[JetDriverVerbOutput, JetDriverCompileMode, jet_driver_parse_user_source, jet_driver_present_diagnostics, jet_driver_report_problems, jet_driver_is_a11y_lint, JET_DRIVER_EXIT_OK, JET_DRIVER_EXIT_USAGE, JET_DRIVER_EXIT_USER_ERROR]
use jet_foundation.[Diagnostic, DIAGNOSTIC_LINT, diagnostic_from_registry, diagnostic_line_at, diagnostic_render_all]
use jet_driver.[jet_driver_cost_query]
use jet_codegen.[TCostReport]
use jet_foundation.[TCostKind, TCostState, diagnostic_registry_row, tir_cost_operation, tir_cost_fix]

fn jet_cli_lint_errors(file: String, source: String, diagnostics: [Diagnostic], color: Bool, json: Bool) -> JetDriverVerbOutput {
    rendered :: if json -> jet_cli_reports_status_json("diagnostics", false, jet_cli_report_cwd(), file, source, diagnostics) else -> jet_driver_report_problems(file, source, diagnostics, color, true)
    JetDriverVerbOutput{stdout: if json -> rendered else -> "", stderr: if json -> "" else -> rendered, exit_code: JET_DRIVER_EXIT_USER_ERROR}
}

fn jet_cli_lint_a11y(file: String, source: String, color: Bool, json: Bool) -> JetDriverVerbOutput {
    compiled :: jet_cli_compile_file(file, color, false, None, JetDriverCompileMode.Program)
    if compiled == {
        .Refused(refusal) -> return ^refusal
        .Compiled(result, snapshot) -> {
            diagnostics :: jet_driver_present_diagnostics(result.diagnostics, snapshot, result.generated_source_files)
            errors :: jet_cli_errors(diagnostics)
            if errors.len() > 0 -> return jet_cli_lint_errors(file, source, errors, color, json)
            if result.internal_problem == .Val(problem) -> return jet_cli_ice(problem)
            lints := [Diagnostic]{}
            loop diagnostic in diagnostics {
                if jet_driver_is_a11y_lint(diagnostic.code) -> &lints.push(diagnostic)
            }
            if lints.len() == 0 -> return JetDriverVerbOutput{stdout: if json -> "" else -> "ok: `{file}` has no accessibility problems\n", stderr: "", exit_code: JET_DRIVER_EXIT_OK}
            count :: lints.len()
            stderr :: if json -> jet_cli_render_all_json(jet_cli_report_cwd(), file, source, lints) else -> "{diagnostic_render_all(file, source, lints, color)}\n{count} accessibility warning{if count == 1 -> "" else -> "s"} found\n"
            return JetDriverVerbOutput{stdout: "", stderr: stderr, exit_code: JET_DRIVER_EXIT_USER_ERROR}
        }
    }
}

fn jet_cli_lint_max(raw: [String], color: Bool) -> JetCLIIntOption Never! {
    loop argument in raw {
        if !argument.starts_with("--max=") -> next
        text :: argument.removeprefix("--max=")
        digits :: text.bytes()
        index := if digits.len() > 0 && digits[0] == (U8{43}) -> 1 else -> 0
        if index >= digits.len() -> return JetCLIIntOption.Refused{output: jet_cli_lint_max_error(text, color)}
        value := 0
        loop index < digits.len() {
            digit :: Int.from_u8(digits[index]) - 48
            if digit < 0 || digit > 9 || value > 429496729 || (value == 429496729 && digit > 5) -> return JetCLIIntOption.Refused{output: jet_cli_lint_max_error(text, color)}
            value = value * 10 + digit
            index += 1
        }
        return JetCLIIntOption.Value{value: Val(value)}
    }
    JetCLIIntOption.Value{value: None}
}

// An option error is returned before compiling, as Source/main.rs does.
enum JetCLIIntOption {
    Value(value: Int?)
    Refused(output: JetDriverVerbOutput)
}

fn jet_cli_lint_max_error(text: String, color: Bool) -> JetDriverVerbOutput Never! {
    JetDriverVerbOutput{stdout: "", stderr: jet_cli_report("E2104", "`--max={text}` isn't a non-negative integer", jet_cli_why("E2104"), "use `--max=<n>` with a non-negative integer", color), exit_code: JET_DRIVER_EXIT_USAGE}
}

fn jet_cli_lint_architecture(file: String, color: Bool) -> JetCLIArchitectureInspection {
    watch :: cli_time.start()
    compiled :: jet_cli_compile_file(file, color, false, None, JetDriverCompileMode.Doc)
    if compiled == {
        .Refused(refusal) -> return JetCLIArchitectureInspection{rows: [], check: None, reason: Val("the checked semantic projection was unavailable; no architecture claim was emitted ({refusal.stderr.trim()})")}
        .Compiled(result, snapshot) -> {
            diagnostics :: jet_driver_present_diagnostics(result.diagnostics, snapshot, result.generated_source_files)
            errors :: jet_cli_errors(diagnostics)
            if errors.len() > 0 {
                reasons :: loop diagnostic in errors -> "{diagnostic.code}: {diagnostic.what}"
                return JetCLIArchitectureInspection{rows: [], check: None, reason: Val("the checked semantic projection was unavailable; no architecture claim was emitted ({reasons.join("; ")})")}
            }
            if result.internal_problem == .Val(problem) -> return JetCLIArchitectureInspection{rows: [], check: None, reason: Val("the checked semantic projection was unavailable; no architecture claim was emitted ({problem})")}
            return JetCLIArchitectureInspection{rows: jet_cli_architecture_rows(jet_cli_checked_semindex(result)), reason: None, check: Val(jet_cli_inspect_check_value(file, watch.elapsed_millis(), diagnostics.len()))}
        }
    }
}

fn jet_cli_lint_complexity(file: String, source: String, raw: [String], color: Bool, json: Bool) -> JetDriverVerbOutput {
    budget := Int?{None}
    budget_option :: jet_cli_lint_max(raw, color)
    if budget_option == {
        .Value(value) -> budget = value
        .Refused(output) -> return ^output
    }
    compiled :: jet_cli_compile_file(file, color, false, None, JetDriverCompileMode.Program)
    if compiled == {
        .Refused(refusal) -> return ^refusal
        .Compiled(result, snapshot) -> {
            diagnostics :: jet_driver_present_diagnostics(result.diagnostics, snapshot, result.generated_source_files)
            errors :: jet_cli_errors(diagnostics)
            if errors.len() > 0 -> return jet_cli_lint_errors(file, source, errors, color, json)
            if result.internal_problem == .Val(problem) -> return jet_cli_ice(problem)
        }
    }
    parsed :: jet_driver_parse_user_source(source)
    if parsed.diagnostics.len() > 0 -> return jet_cli_lint_errors(file, source, parsed.diagnostics, color, json)
    reports :: jet_cli_complexity_reports(parsed.program)
    rows := [JetCLIStatusValue]{}
    exceeded := [Diagnostic]{}
    stdout := ""
    loop report in reports {
        line :: diagnostic_line_at(source, report.span.start)
        over :: if budget == .Val(value) -> report.score > value else -> false
        if json {
            &rows.push(jet_cli_status_object([JetCLIStatusField]{jet_cli_status_field("file", jet_cli_status_text(file)), jet_cli_status_field("fn", jet_cli_status_text(report.name)), jet_cli_status_field("line", jet_cli_status_int(line)), jet_cli_status_field("score", jet_cli_status_int(report.score)), jet_cli_status_field("budget", if budget == .Val(value) -> jet_cli_status_int(value) else -> JetCLIStatusValue.Null), jet_cli_status_field("over", jet_cli_status_bool(over))}))
        } else {
            suffix :: if budget == .Val(value) -> " (budget {value})" else -> ""
            stdout = "{stdout}{file}:{line} fn {report.name} — score {report.score}{suffix}\n"
        }
        if over {
            diagnostic := diagnostic_from_registry("L2902", Val(report.span), "function `{report.name}` has cognitive complexity {report.score} above budget {budget ?? 0}", "the function's control flow is harder to read and maintain than the selected budget allows", "split the function, reduce nesting, or replace mixed control flow with a focused helper")
            diagnostic.severity = DIAGNOSTIC_LINT
            &exceeded.push(diagnostic)
        }
    }
    if budget == None {
        inspection :: jet_cli_lint_architecture(file, color)
        if json {
            fields := [JetCLIStatusField]{
                jet_cli_status_field("contract", jet_cli_status_text("jet.architecture-advice/v1")),
                jet_cli_status_field("file", jet_cli_status_text(file)),
                jet_cli_status_field("local_complexity", jet_cli_status_array(rows)),
                jet_cli_status_field("architecture_advice", jet_cli_architecture_value(inspection)),
                jet_cli_status_field("measurement", jet_cli_status_object([JetCLIStatusField]{jet_cli_status_field("benchmark", jet_cli_status_text("not_run")), jet_cli_status_field("change_task", jet_cli_status_text("not_measured")), jet_cli_status_field("claim", jet_cli_status_text("none"))})),
            }
            if inspection.check == .Val(check) -> &fields.push(jet_cli_status_field("check", check))
            stdout = "{jet_cli_status_render("lint.complexity", true, fields)}\n"
        } else {
            stdout = "{stdout}{jet_cli_architecture_text(inspection)}"
        }
    } else {
        if json -> stdout = "{jet_cli_status_json(jet_cli_status_array(rows))}\n"
    }
    JetDriverVerbOutput{stdout: stdout, stderr: if !json && exceeded.len() > 0 -> diagnostic_render_all(file, source, exceeded, color) else -> "", exit_code: if exceeded.len() == 0 -> JET_DRIVER_EXIT_OK else -> JET_DRIVER_EXIT_USER_ERROR}
}

fn jet_cli_cost_same(left: Diagnostic, right: Diagnostic) -> Bool Never! {
    left.code == right.code && left.severity == right.severity && left.span == right.span && left.what == right.what && left.why == right.why && left.fix == right.fix
}
fn jet_cli_cost_add(rows: &[Diagnostic], diagnostic: Diagnostic) Never! {
    loop previous in rows {
        if jet_cli_cost_same(previous, diagnostic) {
            return
        }
    }
    &rows.push(diagnostic)
}
fn jet_cli_cost_diagnostics(report: TCostReport, sema: [Diagnostic]) -> [Diagnostic] Never! {
    rows := [Diagnostic]{}
    loop diagnostic in sema {
        if diagnostic.code == "L2510" -> jet_cli_cost_add(&rows, diagnostic)
    }
    registry :: diagnostic_registry_row("L2510") ?? panic("L2510 must be registered")
    loop site in report.sites {
        if site.loop_depth == 0 || site.state != TCostState.SemanticRemainder || site.kind == TCostKind.ViewMaterialization -> next
        operation :: tir_cost_operation(site.kind)
        fix :: tir_cost_fix(site.kind)
        diagnostic :: diagnostic_from_registry("L2510", Val(site.span), registry.what.replace("{{operation}}", operation), registry.why, registry.fix.replace("{{fix}}", fix))
        jet_cli_cost_add(&rows, diagnostic)
    }
    rows
}
fn jet_cli_lint_cost(file: String, source: String, color: Bool, json: Bool) -> JetDriverVerbOutput {
    prepared :: jet_cli_prepare_overlays(file, file, [JetCLIOverlay]{}, color, None, JetDriverCompileMode.Doc)
    if prepared == {
        .Refused(output) -> return output
        .Prepared(request, snapshot) -> {
            query :: jet_driver_cost_query(^request)
            diagnostics :: jet_driver_present_diagnostics(query.compile.diagnostics, snapshot, query.compile.generated_source_files)
            errors :: jet_cli_errors(diagnostics)
            if errors.len() > 0 -> return jet_cli_lint_errors(file, source, errors, color, json)
            if query.compile.internal_problem == .Val(problem) -> return jet_cli_ice(problem)
            report :: query.report ?? {
                detail :: if query.gaps.len() > 0 -> query.gaps.join("; ") else -> "the checked TIR projection did not complete"
                return jet_cli_execute(jet_cli_inspect_b_report("E2104", "cost projection for `{file}` failed", detail, "report the missing checked specialization with this source file; its cost cannot be proved until the compiler lowers that specialization", color, json, JET_DRIVER_EXIT_USER_ERROR))
            }
            lints :: jet_cli_cost_diagnostics(report, diagnostics)
            if lints.len() == 0 -> return JetDriverVerbOutput{stdout: if json -> jet_cli_render_all_json(jet_cli_report_cwd(), file, source, [Diagnostic]{}) else -> "ok: `{file}` has no hidden dynamic costs in loops\n", stderr: "", exit_code: JET_DRIVER_EXIT_OK}
            count :: lints.len()
            stderr :: if json -> jet_cli_render_all_json(jet_cli_report_cwd(), file, source, lints) else -> "{diagnostic_render_all(file, source, lints, color)}\n{count} hidden dynamic cost warning{if count == 1 -> "" else -> "s"} found\n"
            return JetDriverVerbOutput{stdout: "", stderr: stderr, exit_code: JET_DRIVER_EXIT_USER_ERROR}
        }
    }
}
