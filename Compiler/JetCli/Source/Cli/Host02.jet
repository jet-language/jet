fn authority_relative_path(root: OSPath, path: OSPath) -> OSPath? {
    normalized :: if root.as_os_str().is_empty() -> OSPath.from(".") else -> root
    if path.strip_prefix(normalized).ok() == .Val(relative) {
        if !relative.as_os_str().is_empty() -> return Val(relative)
    }
    if normalized == OSPath.from(".") || normalized.as_os_str().is_empty() -> return Val(path)
    None
}
// Rust: Source/CmdCompile.rs:1038
fn write_authority_receipt(transaction: &AuthorityTransaction, source: String, operation: String, scope: String, projection: EffectProjection, policy_source: String) Err! {
    required :: projection.required_effects
    granted :: projection.granted_effects
    denied :: projection.denied_effects
    // Canonical EffectProjection sets are already sorted and duplicate-free.
    // Preserve Rust JSON escaping, including its unquoted json_escape fields.
    text :: "{{\"schema\":\"jet.authority.receipt/v1\",\"kind\":\"approval\",\"scope\":{json_escape(scope)},\"resource\":\"application\",\"operation\":{json_escape(operation)},\"source\":{json_escape(source)},\"authority\":{json_escape(projection.authority)},\"policy_source\":{json_escape(policy_source)},\"required_effects\":{json_strings(required)},\"granted_effects\":{json_strings(granted)},\"denied_effects\":{json_strings(denied)}}}\n"
    append_authority_receipt(&transaction, text.bytes(), "authority receipt")
}
// Rust: Source/CmdCompile.rs:1078
fn write_authority_delegation_receipts(transaction: &AuthorityTransaction, source: String, projection: EffectProjection, delegations: [AuthorityDelegation], policy_source: String) Err! {
    if delegations.is_empty() -> return Ok(())
    required :: projection.required_effects
    granted :: projection.granted_effects
    denied :: projection.denied_effects
    // Preserve BTreeSet order without sorting the canonical ordered sets again.
    bytes := String.builder()
    loop delegation in delegations {
        scope :: "{delegation.binding}@{delegation.scope_span.start}..{delegation.scope_span.end}"
        policy :: "#FX; {policy_source}"
        &bytes.push("{{\"schema\":\"jet.authority.receipt/v1\",\"kind\":\"delegation\",\"scope\":{json_escape(scope)},\"resource\":{json_escape(delegation.resource)},\"operation\":{json_escape(delegation.operation)},\"source\":{json_escape(source)},\"source_span\":{{\"start\":{delegation.span.start},\"end\":{delegation.span.end}}},\"authority\":{json_escape(delegation.binding)},\"policy_source\":{json_escape(policy)},\"required_effects\":{json_strings(required)},\"granted_effects\":{json_strings(granted)},\"denied_effects\":{json_strings(denied)}}}\n")
    }
    append_authority_receipt(&transaction, bytes.finish().bytes(), "authority delegation receipt")
}
// Rust: Source/CmdCompile.rs:1130
fn resolve_run_authority_before_execution(file: String, src: String, mode: OutputMode, profile: String, setting_overrides: [String:String], entry_fn: String?, package_manifest: &(OSPath, PackageFacts)?, source_closure: [(OSPath, String)], source_snapshot: AuthorityFileSnapshot?, invocation_authority: ApplicationAuthority?) -> ApplicationAuthority? {
    if source_closure.is_empty() -> fail_authority_transaction(mode, file, src, "could not establish the checked source authority", "authority checks must use the immutable source checked for this compile", "the checked source closure is empty")
    (diagnostics, optional_bundle, facts) :: run_compiler_work(fn() { check_file_with_effect_facts_for_run_and_entry_with_source_closure(file, source_closure, profile, setting_overrides, entry_fn) })
    loop diagnostic in diagnostics {
        if diagnostic.severity == .Error {
            report_problems(mode, file, src, diagnostics)
            compile_process.exit(ExitCodes.USER_ERROR)
        }
    }
    bundle :: optional_bundle ?? {
        report_problems(mode, file, src, diagnostics)
        compile_process.exit(ExitCodes.USER_ERROR)
    }
    (projection, delegations) := native_effect_projection(bundle, facts.summaries, entry_fn, package_manifest.map(fn(pair) { pair.1 }))
    entries :: compute_package_effects(bundle, facts.solved, facts.summaries)
    lints :: jet_cli.visible_lints(diagnostics)
    apply_native_effect_policy("run", file, src, mode, false, lints, entries, facts.fact_registry, &projection, &package_manifest, delegations, source_snapshot, invocation_authority)
}
// Rust: Source/CmdCompile.rs:1198
fn merge_invocation_authority(projection: &EffectProjection, invocation_authority: ApplicationAuthority?) {
    invocation :: invocation_authority ?? return
    // Effect sets remain sorted and duplicate-free; do not rescan for each item.
    granted := [String:Bool]{}
    loop effect in projection.granted_effects -> granted[effect] = true
    loop effect in invocation.granted_effects -> granted[effect] = true
    denied := [String:Bool]{}
    loop effect in projection.denied_effects -> denied[effect] = true
    loop effect in invocation.denied_effects -> denied[effect] = true
    projection.granted_effects = granted.keys().to_list()
    projection.denied_effects = denied.keys().to_list()
    &projection.granted_effects.sort(); &projection.denied_effects.sort()
    if !projection.authority.is_empty() && !invocation.authority.is_empty() -> projection.authority = "{projection.authority} + "
    projection.authority = "{projection.authority}{invocation.authority}"
}
// Rust: Source/CmdCompile.rs:1219
fn resolve_application_authority(cmd: String, file: String, src: String, mode: OutputMode, projection: &EffectProjection, package_manifest: &(OSPath, PackageFacts)?, delegations: [AuthorityDelegation], source_snapshot: AuthorityFileSnapshot?, transaction: &AuthorityTransaction, invocation_authority: ApplicationAuthority?) -> ApplicationAuthority? {
    if cmd != "build" && cmd != "run" -> return None
    merge_invocation_authority(&projection, invocation_authority)
    denied := [String]{}
    loop effect in projection.required_effects {
        if authority_answer(projection.granted_effects, projection.denied_effects, effect) == Verdict.Denied -> &denied.push(effect)
    }
    if !denied.is_empty() {
        report_problems(mode, file, src, [pkg_application_policy_diagnostic(projection, denied, None)])
        compile_process.exit(ExitCodes.USER_ERROR)
    }
    root :: package_manifest.map(fn(pair) { pair.0 }) ?? OSPath.from(file).parent().filter(fn(parent) { !parent.as_os_str().is_empty() }) ?? OSPath.from(".")
    undecided :: projection.undecided()
    if undecided.is_empty() {
        write_authority_delegation_receipts(&transaction, file, projection, delegations, "declared policy") ?? fail_authority_transaction(mode, file, src, "could not record the Authority delegation receipt", "every Authority delegation is source-linked before the effect runs", err)
        return invocation_authority.map(fn(_) { projection.application_authority() })
    }
    if !authority_prompt_is_interactive(mode) {
        script :: if package_manifest == None -> Val(ScriptEntry{path: file, source: src, command: cmd}) else -> None
        report_problems(mode, file, src, [pkg_application_policy_diagnostic(projection, [], script)])
        compile_process.exit(ExitCodes.USER_ERROR)
    }
    write_mode_diagnostic(mode, authority_confirmation_prompt(file, undecided))
    _ :: compile_io.stderr().flush() // GATE #4494
    answer := ""
    answered :: (compile_io.stdin().read_line(&answer).ok() ?? 0) > 0 // GATE #4494
    trimmed := answer.trim() // #4303
    normalized :: trimmed.to_ascii_lowercase()
    choice :: if !answered -> "n" else if normalized == "" || normalized == "y" || normalized == "yes" -> "y" else if normalized == "always" -> "always" else -> "n"
    pending := PendingAuthorityProjectUpdate?{None}
    scope := ""
    policy_source := ""
    if choice == {
        "y" -> { scope = "invocation"; policy_source = "interactive.once" }
        "always" -> {
            scope = "project"
            if package_manifest == None {
                grant :: pkg_application_policy_diagnostic(projection, [], Val(ScriptEntry{path: file, source: src, command: cmd}))
                edit :: grant.edit ?? fail_authority_transaction(mode, file, src, "can't save authority for this script", "the grant is written as a leading `package { … }` block", "no package block could be derived for this source")
                if source_snapshot == None -> fail_authority_transaction(mode, file, src, "can't save authority for this source", "saving a grant requires a checked source file, not a virtual overlay", "the source has no descriptor-relative identity")
                relative :: authority_relative_path(root, OSPath.from(file)) ?? fail_authority_transaction(mode, file, src, "can't save authority for this source", "the checked source must sit beneath its own directory", "source `{file}` is outside `{root.display()}`")
                snapshot :: &transaction.snapshot_file(relative) ?? fail_authority_transaction(mode, file, src, "can't snapshot the script for saving authority", "the saved grant must edit the same immutable source checked for this run", "could not snapshot `{relative.display()}`: {err}")
                updated_source := src
                &updated_source.replace_range(edit.span.start..<edit.span.end, edit.new_text)
                reparsed :: PackageFacts.parse_inline(updated_source, file).ok().flatten() ?? {
                    report_problems(mode, file, src, [Diagnostic.error("E1221", "saving authority produced an invalid `{file}`", "the inserted package block did not parse as a leading Package", "declare the package block by hand with `jet fix --all`", None)])
                    compile_process.exit(ExitCodes.USER_ERROR)
                }
                pending = Val(PendingAuthorityProjectUpdate.Inline(^snapshot, updated_source.bytes(), reparsed.0))
                policy_source = "inline Package authority.holds"
            } else {
                inline :: PackageFacts.parse_inline(src, file) ?? {
                    report_problems(mode, file, src, [Diagnostic.error("E1362", "the inline Package body is malformed", "{err}", "fix the inline Package fields before approving authority", None)])
                    compile_process.exit(ExitCodes.USER_ERROR)
                }
                if inline == .Val((_, block)) {
                    checked_snapshot :: source_snapshot ?? fail_authority_transaction(mode, file, src, "can't persist project authority for this source", "project approval requires a checked source file, not a virtual overlay", "the source has no descriptor-relative identity")
                    relative :: authority_relative_path(root, OSPath.from(file)) ?? fail_authority_transaction(mode, file, src, "can't persist project authority for this source", "project approval requires the checked source beneath the project root", "source `{checked_snapshot.path().display()}` is outside project root `{root.display()}`")
                    snapshot :: &transaction.snapshot_file(relative) ?? fail_authority_transaction(mode, file, src, "can't snapshot project authority", "project approval must edit the same immutable source checked for this run", "could not snapshot `{relative.display()}`: {err}")
                    updated_body := block.body(src)
                    loop effect in undecided -> updated_body = add_authority_hold(updated_body, effect)
                    updated_source := src
                    &updated_source.replace_range(block.body_span.start..<block.body_span.end, updated_body)
                    reparsed :: PackageFacts.parse(updated_body, file) ?? {
                        report_problems(mode, file, src, [Diagnostic.error("E1221", "project approval produced an invalid `{file}`", "{err}", "edit the inline Package authority.holds with the canonical manifest editor", None)])
                        compile_process.exit(ExitCodes.USER_ERROR)
                    }
                    pending = Val(PendingAuthorityProjectUpdate.Inline(^snapshot, updated_source.bytes(), ^reparsed))
                    policy_source = "inline Package authority.holds"
                } else {
                    manifest_file :: manifest_path(root) ?? {
                        report_problems(mode, file, src, [pkg_application_policy_diagnostic(projection, [], None)])
                        compile_process.exit(ExitCodes.USER_ERROR)
                    }
                    relative :: authority_relative_path(root, manifest_file) ?? fail_authority_transaction(mode, file, src, "can't snapshot project authority", "project approval must edit the canonical manifest beneath the project root", "manifest `{manifest_file.display()}` is outside project root `{root.display()}`")
                    snapshot :: &transaction.snapshot_file(relative) ?? fail_authority_transaction(mode, file, src, "can't read `{manifest_file.display()}` for project approval", "project approval must edit the same immutable manifest checked for this run", "could not snapshot `{relative.display()}`: {err}")
                    updated := snapshot.text() ?? fail_authority_transaction(mode, file, src, "can't read `{manifest_file.display()}` for project approval", "project approval requires a UTF-8 canonical package manifest", "{err}")
                    loop effect in undecided -> updated = add_authority_hold(updated, effect)
                    reparsed :: PackageFacts.parse(updated, manifest_file.display()) ?? {
                        report_problems(mode, file, src, [Diagnostic.error("E1221", "project approval produced an invalid `{manifest_file.display()}`", "{err}", "edit `authority.holds.allow` with the canonical manifest editor", None)])
                        compile_process.exit(ExitCodes.USER_ERROR)
                    }
                    pending = Val(PendingAuthorityProjectUpdate.Manifest(^snapshot, updated.bytes(), ^reparsed))
                    policy_source = "package.jet authority.holds"
                }
            }
        }
        else -> {
            all_denied := [String:Bool]{}
            loop effect in projection.denied_effects -> all_denied[effect] = true
            loop effect in undecided -> all_denied[effect] = true
            projection.denied_effects = all_denied.keys().to_list()
            &projection.denied_effects.sort()
            report_problems(mode, file, src, [pkg_application_policy_diagnostic(projection, undecided, None)])
            compile_process.exit(ExitCodes.USER_ERROR)
        }
    }
    write_authority_receipt(&transaction, file, cmd, scope, projection, policy_source) ?? fail_authority_transaction(mode, file, src, "could not record the application authority receipt", "every authority approval is source-linked before the effect runs", err)
    write_authority_delegation_receipts(&transaction, file, projection, delegations, policy_source) ?? fail_authority_transaction(mode, file, src, "could not record the Authority delegation receipt", "every Authority delegation is source-linked before the effect runs", err)
    if pending == .Val(update) {
        if update == {
            .Inline(snapshot, replacement, manifest) | .Manifest(snapshot, replacement, manifest) -> {
                &transaction.replace_file(snapshot, replacement) ?? {
                    detail :: if err.is_published() -> "the authority rename committed, but post-commit verification or durability failed; the canonical state is committed or uncertain and execution is forbidden" else -> "the approval receipt is durable, but the canonical authority file was not published; execution is forbidden"
                    fail_authority_transaction(mode, file, src, "could not persist project authority", detail, "{err}")
                }
                if package_manifest == .Val((existing_root, _)) -> package_manifest = Val((existing_root, ^manifest))
                else -> package_manifest = Val((root, ^manifest))
            }
        }
    }
    if scope == "invocation" -> Val(projection.application_authority()) else -> None
}
// Rust: Source/CmdCompile.rs:1637
fn authority_confirmation_prompt(file: String, undecided: [String]) -> String {
    rights :: undecided
    // undecided() preserves canonical BTreeSet order.
    rows := [(String, String)]{}
    width := 0
    loop right in rights {
        action :: effect_action(right)
        width = width.max(action.len())
        &rows.push((action, right))
    }
    out := String.builder()
    &out.push("{file} will:\n")
    loop (action, right) in rows -> &out.push("  {action}{" ".repeat(width - action.len())}  {right}\n")
    &out.push("Run it? [Y/n/always] ")
    out.finish()
}
// Rust: Source/CmdCompile.rs:1654
fn apply_native_effect_policy(cmd: String, file: String, src: String, mode: OutputMode, is_plugin: Bool, lints: [Diagnostic], entries: [PackageEffects], fact_registry: FactRegistry, projection: &EffectProjection, package_manifest: &(OSPath, PackageFacts)?, delegations: [AuthorityDelegation], source_snapshot: AuthorityFileSnapshot?, invocation_authority: ApplicationAuthority?) -> ApplicationAuthority? {
    authority_root :: package_manifest.map(fn(pair) { pair.0 }) ?? OSPath.from(file).parent().filter(fn(parent) { !parent.as_os_str().is_empty() }) ?? OSPath.from(".")
    // GATE #4494 retained-descriptor transaction: root lock, no-follow snapshots,
    // atomic publication and durability remain in the canonical Store owner.
    transaction :: begin_authority_transaction(authority_root) ?? fail_authority_transaction(mode, file, src, "could not establish the authority transaction", "authority receipts and grants must use one locked project root", "could not lock authority root `{authority_root.display()}`: {err}")
    if is_plugin {
        loop package in entries {
            if package.name != "root" -> next
            declared_needs :: package_manifest.map(fn(pair) { pair.1.authority.needs }) ?? []
            forbidden := [String]{}
            loop effect in package.effects {
                covered := false
                loop need in declared_needs { if authority_covers(need, effect) { covered = true; break } }
                if effect_root(effect) != "Mem" && !covered -> &forbidden.push("{effect} (declare authority.needs `{effect}`)")
            }
            if !forbidden.is_empty() {
                &forbidden.sort()
                report_problems(mode, file, src, [e1258(pkg_effect_show_set(forbidden))])
                compile_process.exit(ExitCodes.USER_ERROR)
            }
            break
        }
    }
    authority :: resolve_application_authority(cmd, file, src, mode, &projection, &package_manifest, delegations, source_snapshot, &transaction, invocation_authority)
    if package_manifest == .Val((root, manifest)) {
        lint_violations :: enforce_lint_policy(lints, manifest)
        if !lint_violations.is_empty() {
            report_problems(mode, file, src, lint_violations)
            compile_process.exit(ExitCodes.USER_ERROR)
        }
        configured_names := [String]{}
        if manifest.authority.holds.allow == .Val(names) -> &configured_names.extend(names)
        if manifest.authority.holds.deny == .Val(names) -> &configured_names.extend(names)
        // BTreeMap iteration preserves configured-name error precedence.
        grant_keys := manifest.authority.grants.keys().to_list()
        &grant_keys.sort()
        loop key in grant_keys -> &configured_names.extend(manifest.authority.grants[key])
        violations := [Diagnostic]{}
        loop name in configured_names {
            if parse_effect_name(name) != None {
                resolve_effect_name(name, fact_registry) ?? { &violations.push(undeclared_effect(name, err, None)); () }
            }
        }
        &violations.extend(enforce_effect_budget(entries, manifest))
        if !violations.is_empty() {
            report_problems(mode, file, src, violations)
            compile_process.exit(ExitCodes.USER_ERROR)
        }
        // fetch owns lock creation; execution updates existing provenance only.
        lock_file :: lock_path(root)
        relative :: authority_relative_path(root, lock_file) ?? fail_authority_transaction(mode, file, src, "can't read project lock `{lock_file.display()}`", "native execution must preserve the canonical lock authority", "lock `{lock_file.display()}` is outside authority root `{root.display()}`")
        lock_snapshot := AuthorityFileSnapshot?{None}
        if &transaction.snapshot_file(relative) == {
            .Ok(snapshot) -> lock_snapshot = Val(^snapshot)
            .Err(error) -> {
                if error.kind() != .NotFound -> fail_authority_transaction(mode, file, src, "can't read project lock `{lock_file.display()}`", "native execution must preserve the canonical lock authority", "fix the lock permissions and retry: {error}")
            }
        }
        if lock_snapshot == .Val(snapshot) {
            raw :: snapshot.text() ?? fail_authority_transaction(mode, file, src, "can't read project lock `{lock_file.display()}`", "native execution requires a UTF-8 canonical lockfile", "{err}")
            lock := parse_lock(raw) ?? fail_authority_transaction(mode, file, src, "can't parse project lock `{lock_file.display()}`", "native execution cannot update a corrupt lockfile", err)
            update_lock_provenance(&lock, entries, manifest)
            replacement :: write_lock(lock)
            &transaction.replace_file(snapshot, replacement.bytes()) ?? {
                detail :: if err.is_published() -> "the lockfile rename committed, but post-commit verification or durability failed; canonical lock authority is committed or uncertain and execution is forbidden" else -> "the canonical lockfile was not published; execution is forbidden"
                fail_authority_transaction(mode, file, src, "can't write project lock `{lock_file.display()}`", detail, "{err}")
            }
        }
    }
    &transaction.finish() ?? fail_authority_transaction(mode, file, src, "could not finish the authority transaction", "authority receipts or grants may be committed, but durability state is uncertain; execution is forbidden", "{err}")
    authority
}
