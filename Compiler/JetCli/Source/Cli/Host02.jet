// Rust: Source/CmdCompile.rs:601
fn vector_build_projection(file: String) -> [(String, USize, USize, String, String, String, String)] {
    (diagnostics, bundle, _) :: check_file_with_effect_facts(file, None, false)
    loop diagnostic in diagnostics {
        if diagnostic.severity == .Error -> return []
    }
    checked :: bundle ?? return []
    (mir, _) :: lower_checked_semantic_mir_program_for(checked, MirArtifactRequest.new(MirArtifactTarget.RustAot, MirArtifactKind.NativeExecutable, MirArtifactBuildMode.Dev))
    rows := [(String, USize, USize, String, String, String, String)]{}
    loop function in mir.functions {
        loop fact in function.optimization.vector_facts {
            decision :: if fact.decision == {
                .Eligible -> "accepted"
                .Rejected(reason) -> reason.as_str()
            }
            &rows.push((function.key, fact.span.start, fact.span.end, fact.rule.as_str(), fact.layout.as_str(), fact.lane_width.map(fn(lane) { "{lane}" }) ?? "none", decision))
        }
    }
    rows
}
// Rust: Source/CmdCompile.rs:650
fn vector_build_projection_json(rows: [(String, USize, USize, String, String, String, String)]) -> String {
    rendered := [String]{}
    loop (function, start, end, rule, layout, lane, decision) in rows {
        &rendered.push("{{\"function\":\"{json_escape(function)}\",\"span\":{{\"start\":{start},\"end\":{end}}},\"rule\":\"{json_escape(rule)}\",\"layout\":\"{json_escape(layout)}\",\"lane\":\"{json_escape(lane)}\",\"decision\":\"{json_escape(decision)}\"}}")
    }
    "[{rendered.join(",")}]"
}
// Rust: Source/CmdCompile.rs:672
fn vector_build_projection_text(rows: [(String, USize, USize, String, String, String, String)]) -> String {
    out := String.builder()
    loop (function, start, end, rule, layout, lane, decision) in rows -> &out.push("vector\t{function}\t{start}..{end}\t{rule}\t{layout}\t{lane}\t{decision}\n")
    out.finish()
}
// Rust: Source/CmdCompile.rs:682
pub fn run_build_query(command: String, args: [String], mode: OutputMode) {
    explain_nodes :: command == "explain-build" && args.len() <= 1
    subject := String?{None}
    file := String?{None}
    if command == {
        "graph" -> file = args.first()
        "query" -> { if args.first() == Val("build") -> file = args.get(1) }
        "explain-build" -> {
            if explain_nodes -> file = args.first()
            else { subject = args.first(); file = args.get(1) }
        }
        else -> ()
    }
    selected :: file ?? {
        prefix :: if command == "explain-build" -> "<target|action|file> " else -> ""
        write_mode_diagnostic(mode, "usage: jet {command} {prefix}<file.jet>\n")
        compile_process.exit(ExitCodes.USAGE)
    }
    src :: compile_files.read(selected) ?? ""
    if explain_nodes {
        nodes :: query_build_nodes(selected) ?? {
            report_problems(mode, selected, src, err)
            compile_process.exit(ExitCodes.USER_ERROR)
        }
        print_build_nodes(selected, nodes, mode)
        return
    }
    queried :: if command == "query" -> evaluate_build_query(selected, BuildQueryExpression.Build) else -> query_build_plan(selected)
    optional_plan :: queried ?? {
        report_problems(mode, selected, src, err)
        compile_process.exit(ExitCodes.USER_ERROR)
    }
    plan :: optional_plan ?? {
        if mode.json -> write_mode_machine(mode, "{render_status("inspect.build", true, StatusFields.new().with("build", StatusValue.Null))}\n")
        else -> write_mode_renderable(mode, "default pipeline: no root fn build\n")
        return
    }
    if subject == .Val(name) {
        if plan.explain_target_named(name) == .Val(explanation) { print_build_explanation(explanation, mode); return }
        if plan.explain_action_named(name) == .Val(explanation) { print_build_explanation(explanation, mode); return }
        print_build_explanation(plan.explain_file(name), mode)
        return
    }
    graph :: plan.graph()
    vector_rows :: vector_build_projection(selected)
    if mode.json {
        payload := build_plan_json(plan, None)
        if payload.strip_suffix("}") == .Val(prefix) -> payload = "{prefix},\"vector\":{vector_build_projection_json(vector_rows)}}}"
        build :: StatusValue.parse(payload) ?? panic("build plan projection must be valid JSON")
        write_mode_machine(mode, "{render_status("inspect.build", true, StatusFields.new().with("build", build))}\n")
    } else {
        loop target in graph.targets -> write_mode_renderable(mode, "target\t{target.name}\t{target.kind:?}\n")
        loop action in graph.actions -> write_mode_renderable(mode, "action\t{action.name}\t{action.outputs.join(",")}\n")
        write_mode_renderable(mode, vector_build_projection_text(vector_rows))
    }
}
// Rust: Source/CmdCompile.rs:807
fn print_build_nodes(file: String, static_nodes: [jet.BuildPlanNode], mode: OutputMode) {
    program :: build_record_program(file)
    workspace :: build_project_root(file).ok()
    records := [BuildNodeRecord]?{None}
    if Store.from_env().ok() == .Val(store) && workspace == .Val(root) {
        if store.last_build_record(root, program).ok() == .Val(Val(record)) -> records = Val(record.nodes)
    }
    if records == None {
        fallback := [BuildNodeRecord]{}
        loop node in static_nodes -> &fallback.push(BuildNodeRecord{kind: node.kind.as_str(), key: node.key, subject: node.subject, duration_ms: 0.0, why_ran: "first-run", inputs: node.inputs})
        records = Val(^fallback)
    }
    rows :: records ?? panic("build node projection assigned")
    if mode.json {
        nodes := [String]{}
        loop node in rows -> &nodes.push("{{\"kind\":\"{json_escape(node.kind)}\",\"key\":\"{json_escape(node.key)}\",\"subject\":\"{json_escape(node.subject)}\",\"duration_ms\":{node.duration_ms:.3},\"why_ran\":\"{json_escape(node.why_ran)}\",\"inputs\":{json_strings(node.inputs)}}}")
        write_mode_machine(mode, "{{\"schema\":\"jet.explain-build/v1\",\"program\":\"{json_escape(program)}\",\"nodes\":[{nodes.join(",")}]}}\n")
    } else {
        loop node in rows -> write_mode_renderable(mode, "{node.kind}\t{node.key}\t{node.subject}\t{node.duration_ms:.3}\t{node.why_ran}\t{node.inputs.join(",")}\n")
    }
}
// Rust: Source/CmdCompile.rs:880
pub fn run_compiler_api(operation: String, file: String, mode: OutputMode) {
    debug_assert(mode.json, "inspect compiler must use the shared machine-output mode")
    document := ""
    if operation == {
        "lex" | "parse" | "source-map" | "source_map" -> {
            if compile_files.read(OSPath.from(file)) == {
                .Ok(source) -> {
                    document = if operation == {
                        "lex" -> jet_compiler.lex_source_json(source)
                        "parse" -> jet_compiler.parse_source_json(source)
                        else -> jet_compiler.source_map_json(source)
                    }
                }
                .Err(error) -> document = jet_compiler.compiler_api_error_json(operation, file, "E0956", "could not read compiler input: {error}")
            }
        }
        "check" -> document = jet_compiler.check_file_json(OSPath.from(file))
