    compile_process.exit(ExitCodes.ICE)
}
// Rust: Source/CmdCompile.rs:342
pub fn run_build_verify(artifact_id: String, mode: OutputMode) -> Never {
    fail :: fn(message: String) -> Never {
        if mode.json {
            diagnostic :: Diagnostic.error("E2105", "build verification failed: {message}", "the indexed receipt could not be verified", "repair the receipt or rerun the producing build", None)
            write_mode_machine(mode, render_diagnostic_status("build.verify", false, ReportPath.from_process("<cli>"), "", [diagnostic]))
        } else -> cli_error("E2105", "build verification failed: {message}")
        compile_process.exit(ExitCodes.USER_ERROR)
    }
    project_root :: build_project_root(".") ?? fail("could not resolve record project root: {err:?}")
    host :: compile_sys.record_index_file_host() // GATE #4494 native held-index adapter
    index :: jet_cli_record_index_load_for_project(project_root, &host) ?? fail("could not load record index: {err.message}")
    indexed :: jet_cli_record_index_find(index, RecordKind.Receipt, artifact_id, true) ?? fail("receipt `{artifact_id}` is not indexed")
    receipt_path :: project_root.join(indexed.path)
    receipt :: read_receipt_path(receipt_path) ?? fail("could not read indexed receipt: {err}")
    loop input in receipt.claim.inputs {
        digest :: sha256_file_hex(input.path) ?? fail("first differing input `{input.path.display()}` is unavailable: {err}")
        if digest != input.digest -> fail("first differing input `{input.path.display()}`: expected sha256-{input.digest}, found sha256-{digest}")
    }
    target :: indexed_receipt_target(receipt, indexed.identity) ?? fail(err)
    project_root :: build_project_root(target.to_string_lossy()) ?? fail("could not resolve target project root: {err:?}")
    artifact :: receipt_artifact_path(receipt, project_root, target)
    before :: compile_files.read_bytes(artifact) ?? fail("recorded build output `{artifact.display()}` is unavailable: {err}")
    rebuild_indexed_target(target, mode) ?? fail(err)
    after :: compile_files.read_bytes(artifact) ?? fail("rebuilt output `{artifact.display()}` is unavailable: {err}")
    if before != after -> fail("rebuilt output `{artifact.display()}` differs although all {receipt.claim.inputs.len()} receipt inputs matched; the native toolchain/output diverged")
    if mode.json {
        rendered :: render_status("build.verify", true, StatusFields.new().with("status", "identical").with("inputs", receipt.claim.inputs.len()).with("outputs", 1).with("sha256", sha256_hex(after)))
        write_mode_machine(mode, "{rendered}\n")
    } else -> write_mode_renderable(mode, "identical: {receipt.claim.inputs.len()} inputs, 1 output, sha256 match\n")
    compile_process.exit(ExitCodes.OK)
}
// Rust: Source/CmdCompile.rs:448
fn indexed_receipt_target(receipt: Receipt, identity: RecordIdentity) -> OSPath Err! {
    loop input in receipt.claim.inputs {
        if input.path.extension().and_then(fn(extension) { extension.to_str() }) == Val("jet") {
            if jet_cli.target_input_sha256_for_file(input.path.to_string_lossy()).ok() == .Val(digest) {
                if digest == identity.target_inputs_sha256 -> return Ok(input.path)
            }
        }
    }
    Err("indexed receipt does not identify a rebuildable Jet target in its inputs")
}
// Rust: Source/CmdCompile.rs:475
fn receipt_artifact_path(receipt: Receipt, project_root: OSPath, target: OSPath) -> OSPath {
    output :: String.from_utf8_lossy(receipt.stdout)
    loop line in output.lines() {
        if line.strip_prefix("built: ") == .Val(built) {
            path := built.split_once(" (").map(fn(parts) { parts.0 }) ?? built
            path = path.trim() // #4303
            if !path.is_empty() -> return OSPath.from(path)
            break
        }
    }
    build_artifact_path(project_root, target.to_string_lossy(), None)
}
// Rust: Source/CmdCompile.rs:495
fn rebuild_indexed_target(target: OSPath, mode: OutputMode) Err! {
    executable :: compile_sys.current_exe() ?? return Err("could not locate the current jet executable: {err}")
    // GATE #4494 native child execution and inherited environment.
    output :: compile_process.Command.new(executable).arg("build").arg(target).env("JET_RECEIPT_BYPASS", "1").output() ?? return Err("could not rebuild `{target.display()}`: {err}")
    if !output.status.success() {
        stderr :: String.from_utf8_lossy(output.stderr)
        trimmed := stderr.trim() // #4303
        detail :: if trimmed.is_empty() -> "child build exited with {output.status}" else -> "child build exited with {output.status}: {trimmed}"
        if !mode.quiet -> write_mode_diagnostic(mode, "{detail}\n")
        return Err(detail)
    }
    Ok(())
}
// Rust: Source/CmdCompile.rs:523
fn finish_recorded_artifacts(record: NamedCapture?, record_name: String?, production_receipt: ProductionReceiptContext?, exit_code: I32, mode: OutputMode) {
    if record == .Val(capture) {
        jet_cli.finish_named_capture(capture, exit_code, mode.json) ?? compile_process.exit(err)
        if record_name == .Val(name) -> index_named_capture(capture, name, RecordCapture.Safe) ?? fail_record_index(err)
    }
    if production_receipt == .Val(context) -> index_production_receipt(context) ?? fail_record_index(err)
}
// Rust: Source/CmdCompile.rs:543
fn try_recorded_run(file: String, program_args: [String], capture: NamedCapture, record_name: String?, production_receipt: ProductionReceiptContext?, mode: OutputMode) -> Bool {
    execution :: record_run(file, program_args) ?? return false
    emit_run_output(execution.stdout, execution.stderr)
    jet_cli.finish_named_capture_with_run(capture, execution.exit_code, mode.json, execution.run) ?? compile_process.exit(err)
    if record_name == .Val(name) -> index_named_capture(capture, name, RecordCapture.Safe) ?? fail_record_index(err)
    if production_receipt == .Val(context) -> index_production_receipt(context) ?? fail_record_index(err)
    compile_process.exit(execution.exit_code)
}
