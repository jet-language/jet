// Rust: Source/CmdCompile.rs:30
struct BuildProgress {
    enabled: Bool
    verbose: Bool
    started: compile_time.Instant
    mode: OutputMode
    progress: MultiProgress?
    task: TaskId?

    // Rust: Source/CmdCompile.rs:40
    fn new(cmd: String, emit_rust: Bool, verbose: Bool, mode: OutputMode, profile: OutputProfile?) -> BuildProgress {
        enabled :: cmd == "build" && !emit_rust && !mode.quiet && !mode.json
        progress := MultiProgress?{None}
        task := TaskId?{None}
        if enabled && profile == .Val(selected) {
            progress = Val(jet_cli_progress_new(selected))
            if progress == .Val(current) {
                task = jet_cli_progress_add_unknown(&current, "build").ok()
            }
        }
        BuildProgress{enabled: enabled, verbose: verbose, started: compile_time.Instant.now(), mode: mode, progress: ^progress, task: task}
    }
    // Rust: Source/CmdCompile.rs:65
    fn render(&self, phase: String, detail: String) {
        progress :: &self.progress ?? return
        task :: self.task ?? return
        jet_cli_progress_set_custom_column(&progress, task, "phase", phase) ?? return
        jet_cli_progress_set_custom_column(&progress, task, "detail", detail) ?? return
        if jet_cli_progress_frame(progress).ok() == .Val(Val(frame)) {
            if !frame.text.is_empty() -> write_mode_progress(self.mode, "{frame.text}\n")
        }
    }
    // Rust: Source/CmdCompile.rs:82
    fn major(&self, label: String, detail: String) {
        if self.enabled -> &self.render(label, detail)
    }
    // Rust: Source/CmdCompile.rs:88
    fn minor(&self, label: String, detail: String) {
        if self.enabled && self.verbose -> &self.render(label, detail)
    }
    // Rust: Source/CmdCompile.rs:94
    fn finish(&self, artifact: String) {
        if !self.enabled -> return
        elapsed :: self.started.elapsed()
        duration :: if elapsed.as_secs() == 0 -> "{elapsed.as_millis()}ms" else -> "{elapsed.as_secs_f64():.1}s"
        if self.progress == .Val(progress) && self.task == .Val(task) {
            _ :: jet_cli_progress_set_custom_column(&progress, task, "artifact", artifact)
            _ :: jet_cli_progress_set_custom_column(&progress, task, "elapsed", duration)
            _ :: jet_cli_progress_finish(&progress, task)
            if jet_cli_progress_frame(progress).ok() == .Val(Val(frame)) {
                if !frame.text.is_empty() -> write_mode_progress(self.mode, "{frame.text}\n")
            }
        }
    }
}

// Rust: Source/CmdCompile.rs:121
// Flush stdout before stderr so non-TTY shared sinks preserve Prelude ordering.
fn emit_run_output(stdout: String, stderr: String) {
    compile_io.stdout().write_all(stdout.bytes())
    if !stderr.is_empty() {
        _ :: compile_io.stdout().flush() // GATE #4494 native stream flush
        compile_io.stderr().write_all(stderr.bytes())
    }
}
// Rust: Source/CmdCompile.rs:128
fn render_diagnostic_status(action: String, ok: Bool, file: ReportPath, source: String, diagnostics: [Diagnostic]) -> String {
    clears :: report_clear_counts(diagnostics)
    reports := []
    loop (index, diagnostic) in diagnostics {
        &reports.push(diagnostic.to_report_with_clears(file, source, clears[index]))
    }
    "{render_status_with_reports(action, ok, reports, StatusFields.new())}\n"
}
// Rust: Source/CmdCompile.rs:146
fn index_compile_artifact(identity: RecordIdentity, kind: RecordKind, artifact_id: String, path: OSPath, size: U64, capture: RecordCapture, consumed: [RecordLink], produced: [RecordLink], protected: Bool) Err! {
    absolute :: if path.is_absolute() -> ^path else -> (compile_sys.current_dir() ?? return Err("{err}")).join(path)
    project_root :: build_project_root(absolute.to_string_lossy()) ?? return Err("could not resolve record project root: {err:?}")
    index_compile_artifact_at(project_root, ^identity, kind, ^artifact_id, ^absolute, size, capture, ^consumed, ^produced, protected)
}
// Rust: Source/CmdCompile.rs:183
// Caller-selected root is essential: deriving it from .jet/<kind> is wrong.
fn index_compile_artifact_at(project_root: OSPath, identity: RecordIdentity, kind: RecordKind, artifact_id: String, absolute: OSPath, size: U64, capture: RecordCapture, consumed: [RecordLink], produced: [RecordLink], protected: Bool) Err! {
    path :: absolute.strip_prefix(project_root) ?? return Err("record artifact is outside the project: {absolute.display()}")
    // GATE #4494 canonical native adapters for the held index/retention seams.
    host :: compile_sys.record_index_file_host()
    retention :: compile_sys.record_retention_host()
    index := jet_cli_record_index_load_for_project(project_root, &host) ?? return Err("could not load record index: {err.message}")
    recorded_sequence := U64{0}
    saved := false
    if jet_cli_record_index_find(index, kind, artifact_id, true) == .Val(entry) {
        recorded_sequence = entry.recorded_sequence
        saved = entry.saved
    } else {
        recorded_sequence = jet_cli_record_index_next_recorded_sequence(index) ?? return Err("could not allocate record sequence: {err}")
    }
    entry := jet_cli_record_entry_new(^identity, kind, artifact_id, path.to_string_lossy()) ?? return Err("could not construct {kind} record: {err.message}")
    jet_cli_record_entry_with_links(&entry, ^consumed, ^produced) ?? return Err("could not link {kind} record `{artifact_id}`: {err.message}")
    entry.capture = capture
    entry.size = size
    entry.recorded_sequence = recorded_sequence
    entry.saved = saved || protected
    // Production receipts rewrite one row: imported modules can change even
    // when receipt bytes remain identical, so latest provenance supersedes it.
    published :: if kind == RecordKind.Receipt -> jet_cli_record_index_supersede_and_store(&index, ^entry, &host, &retention) else -> jet_cli_record_index_update_and_store(&index, ^entry, &host, &retention)
    published ?? return Err("could not store {kind} record `{artifact_id}`: {err.message}")
    Ok(())
}
// Rust: Source/CmdCompile.rs:230
fn replay_artifact_id(bytes: [U8]) -> String Err! {
    if bytes.len() < 16 -> return Err("replay artifact is truncated before its header")
    header_len :: U32.from_le_bytes(bytes[12..<16]) ?? return Err("replay header length is invalid")
    header_end :: USize{16}.checked_add(USize{header_len}) ?? return Err("replay header length overflows")
    if header_end > bytes.len() -> return Err("replay artifact header is truncated")
    header :: String.from_bytes(bytes[16..<header_end]) ?? return Err("replay artifact header is not UTF-8")
    tree :: parse_json(header) ?? return Err("replay artifact header is not valid JSON")
    if tree == .Object(fields) {
        loop (key, value) in fields {
            if key == "artifact_id" {
                if value.as_str().ok() == .Val(id) -> return Ok(id)
                break
            }
        }
        return Err("replay artifact header has no artifact_id")
    }
    Err("replay artifact header is not a JSON object")
}
// Rust: Source/CmdCompile.rs:263
fn index_named_capture(capture: NamedCapture, _name: String, capture_mode: RecordCapture) Err! {
    path :: capture.artifact_path() ?? return Err("named capture has no artifact path")
    bytes :: compile_files.read_bytes(path) ?? return Err("could not read replay artifact `{path.display()}`: {err}")
    artifact_id :: replay_artifact_id(bytes)?
    identity :: capture.record_identity()?
    size :: U64.try_from(bytes.len()) ?? return Err("replay artifact is too large")
    index_compile_artifact(^identity, RecordKind.Replay, ^artifact_id, path, size, capture_mode, [], [], true)
}
// Rust: Source/CmdCompile.rs:295
fn index_production_receipt(context: ProductionReceiptContext) Err! {
    directory :: compile_sys.var_os(jet.JET_DEVELOPMENT_RECEIPT_DIRECTORY_ENV) ?? return Ok(())
    absolute_path :: OSPath.from(directory).join("receipt")
    metadata :: compile_files.symlink_metadata(absolute_path) ?? {
        if err.kind() == .NotFound -> return Ok(())
        return Err("could not inspect production receipt: {err}")
    }
    if metadata.file_type().is_symlink() || !metadata.is_file() -> return Err("production receipt is not a regular file: {absolute_path.display()}")
    bytes :: compile_files.read_bytes(absolute_path) ?? return Err("could not read production receipt: {err}")
    identity :: context.record_identity()?
    artifact_id :: "sha256-{sha256_hex(bytes)}"
    size :: U64.try_from(bytes.len()) ?? return Err("production receipt is too large")
    index_compile_artifact_at(context.project_root(), ^identity, RecordKind.Receipt, ^artifact_id, absolute_path, size, RecordCapture.Safe, [], [], true)
}
