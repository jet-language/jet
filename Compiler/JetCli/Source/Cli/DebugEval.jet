// The expressions `jet debug --dap` evaluates at a stop: a breakpoint's
// `condition`, the `{…}` parts of a logpoint's `logMessage`, and an
// `evaluate` request. The compiler's parser reads each as one Jet
// expression, and it is evaluated over the paused frame's locals as the
// console shows them. The evaluator reads a local by its name, Int, Float,
// Bool and String literals, `!` and unary `-`, `+ - *` on Ints and on
// Floats, comparisons (chained too), and `&&` and `||`. Nothing runs in the
// program.
use {
    jet_debug.[NATIVE_DEBUG_UNAVAILABLE, NativeLocal, debug_unquote_text, native_debug_text_literal]
    jet_foundation.[BinOp, DIAGNOSTIC_ERROR, Expr]
    jet_parser.[parse_source]
}

// A value an expression has is a debugger value row, as a local is: its Jet
// type and its text as the Locals view shows it (a String quoted), with no
// name. The evaluator computes with Int, Float, Bool and String rows; any
// other (a struct, a list, a Decimal) it only shows.
jet_cli_dap_value: fn(type_name: String, text: String) -> NativeLocal Never! {
    NativeLocal{name: "", type_name: type_name, value: text}
}

jet_cli_dap_of_int: fn(number: Int) -> NativeLocal Never! { jet_cli_dap_value("Int", "{number}") }
jet_cli_dap_of_float: fn(number: Float) -> NativeLocal Never! { jet_cli_dap_value("Float", "{number}") }
jet_cli_dap_of_bool: fn(flag: Bool) -> NativeLocal Never! { jet_cli_dap_value("Bool", "{flag}") }
jet_cli_dap_of_string: fn(text: String) -> NativeLocal Never! { jet_cli_dap_value("String", native_debug_text_literal(text)) }

// The type the evaluator computes a row of `type_name` as: "Int", "Float",
// "Bool" or "String", else "" (shown only).
jet_cli_dap_kind: fn(type_name: String) -> String Never! {
    if type_name == {
        "Int" | "I64" | "U64" | "I32" | "U32" | "I16" | "U16" | "I8" | "U8" -> "Int"
        "Float" | "F32" -> "Float"
        "Bool" -> "Bool"
        "String" -> "String"
        else -> ""
    }
}

jet_cli_dap_as_int: fn(value: NativeLocal) -> Int? Never! {
    if jet_cli_dap_kind(value.type_name) != "Int" -> return None
    Val(Int.parse(value.value) ?? return None)
}

jet_cli_dap_as_float: fn(value: NativeLocal) -> Float? Never! {
    if jet_cli_dap_kind(value.type_name) != "Float" -> return None
    Val(Float.parse(value.value) ?? return None)
}

jet_cli_dap_as_bool: fn(value: NativeLocal) -> Bool? Never! {
    if jet_cli_dap_kind(value.type_name) != "Bool" -> return None
    if value.value == {
        "true" -> Val(true)
        "false" -> Val(false)
        else -> None
    }
}

jet_cli_dap_as_string: fn(value: NativeLocal) -> String? Never! {
    if jet_cli_dap_kind(value.type_name) != "String" -> return None
    Val(debug_unquote_text(value.value))
}

#Error
JetCLIDapEvalError: struct { message: String }

jet_cli_dap_eval_error: fn(message: String) -> JetCLIDapEvalError Never! {
    JetCLIDapEvalError{message: message}
}

// `text` read as one Jet expression.
jet_cli_dap_parse: fn(text: String) -> Expr JetCLIDapEvalError! {
    if text.trim() == "" -> return Err(jet_cli_dap_eval_error("the expression is empty"))
    parsed: parse_source("dap_expression: fn() {{\n{text}\n}}\n".bytes())
    loop diagnostic in parsed.diagnostics {
        if diagnostic.severity == DIAGNOSTIC_ERROR -> return Err(jet_cli_dap_eval_error("`{text}` is not a Jet expression: {diagnostic.what}"))
    }
    if parsed.program.items.len() == 1 && parsed.program.items[0] == .Func(function) && function.body.len() == 1 && function.body[0] == .Expr(expr) {
        return Ok(expr)
    }
    Err(jet_cli_dap_eval_error("`{text}` is not one Jet expression"))
}

// A logpoint's `logMessage`, read as the Jet string literal it would be
// between double quotes: `{expr}` parts interpolate.
jet_cli_dap_parse_message: fn(message: String) -> Expr JetCLIDapEvalError! {
    jet_cli_dap_parse("\"{message.replace("\"", "\\\"")}\"")
}

// A breakpoint condition's truth over `locals`.
jet_cli_dap_condition: fn(expr: Expr, locals: [NativeLocal]) -> Bool JetCLIDapEvalError! {
    value: jet_cli_dap_eval(expr, locals) ?? return Err(err)
    if jet_cli_dap_as_bool(value) == .Val(flag) -> return Ok(flag)
    Err(jet_cli_dap_eval_error("the condition is a {value.type_name}, not a Bool"))
}

// The value of `expr` over `locals`.
jet_cli_dap_eval: fn(expr: Expr, locals: [NativeLocal]) -> NativeLocal JetCLIDapEvalError! {
    if expr == {
        .Ident(name, _, _) -> {
            loop local in locals {
                if local.name == name -> return jet_cli_dap_local(local)
            }
            Err(jet_cli_dap_eval_error("`{name}` is not a local here"))
        }
        .Int(value, _, _, _, _) -> Ok(jet_cli_dap_of_int(value))
        .Float(value, _, _, _, _) -> Ok(jet_cli_dap_of_float(value))
        .Bool(value, _, _) -> Ok(jet_cli_dap_of_bool(value))
        .Str(parts, _, _) -> {
            text := ""
            loop part in parts {
                if part == {
                    .Lit(literal) -> text = "{text}{literal}"
                    .Interp(inner, _) -> {
                        value: jet_cli_dap_eval(inner, locals) ?? return Err(err)
                        text = "{text}{jet_cli_dap_text(value)}"
                    }
                    .Byte(_) -> return Err(jet_cli_dap_eval_error("a byte escape is not evaluated"))
                }
            }
            Ok(jet_cli_dap_of_string(text))
        }
        .Paren(inner, _, _) -> jet_cli_dap_eval(inner, locals)
        .Unary(op, operand, _, _) -> {
            value: jet_cli_dap_eval(operand, locals) ?? return Err(err)
            if op == {
                .Not -> if jet_cli_dap_as_bool(value) == .Val(flag) -> Ok(jet_cli_dap_of_bool(!flag)) else -> Err(jet_cli_dap_eval_error("`!` needs a Bool"))
                .Neg -> {
                    if jet_cli_dap_as_int(value) == .Val(number) -> return Ok(jet_cli_dap_of_int(-number))
                    if jet_cli_dap_as_float(value) == .Val(number) -> return Ok(jet_cli_dap_of_float(-number))
                    Err(jet_cli_dap_eval_error("`-` needs an Int or a Float"))
                }
            }
        }
        .Binary(op, left, right, _, _) -> {
            first: jet_cli_dap_eval(left, locals) ?? return Err(err)
            if op == .And || op == .Or {
                flag: jet_cli_dap_as_bool(first) ?? return Err(jet_cli_dap_eval_error("`&&` and `||` need Bools"))
                if flag == (op == .Or) -> return Ok(jet_cli_dap_of_bool(flag))
                second: jet_cli_dap_eval(right, locals) ?? return Err(err)
                if jet_cli_dap_as_bool(second) == .Val(found) -> return Ok(jet_cli_dap_of_bool(found))
                return Err(jet_cli_dap_eval_error("`&&` and `||` need Bools"))
            }
            second: jet_cli_dap_eval(right, locals) ?? return Err(err)
            jet_cli_dap_binary(op, first, second)
        }
        .CompareChain(operands, ops, _, _, _) -> {
            if operands.len() != ops.len() + 1 -> return Err(jet_cli_dap_eval_error("a comparison chain is malformed"))
            previous := jet_cli_dap_eval(operands[0], locals) ?? return Err(err)
            loop (k, op) in ops {
                next_value: jet_cli_dap_eval(operands[k + 1], locals) ?? return Err(err)
                held: jet_cli_dap_binary(op, previous, next_value) ?? return Err(err)
                if jet_cli_dap_as_bool(held) == .Val(flag) && !flag -> return Ok(held)
                previous = next_value
            }
            Ok(jet_cli_dap_of_bool(true))
        }
        .StrMatchLit(_, _, _) | .BinMatchLit(_, _, _) | .Unit(_, _) | .Char(_, _, _) | .ListLit(_, _, _) | .MemberSpread(_, _, _, _) | .Spread(_, _, _) | .MapLit(_, _, _) | .Index(_, _, _, _, _) | .Slice(_, _, _, _, _, _) | .Range(_, _, _, _, _) | .Call(_, _) | .UnitLit(_, _, _, _, _, _, _) | .Deref(_, _, _) | .RawOf(_, _, _) | .Copy(_, _, _) | .Place(_, _, _, _) | .Field(_, _, _, _) | .OptField(_, _, _, _, _, _) | .MethodCall(_, _, _, _, _, _, _) | .OptMethodCall(_, _, _, _, _, _, _) | .StructLit(_, _, _, _, _, _, _, _) | .TypedLit(_, _, _, _) | .EnumLit(_, _, _, _, _, _, _) | .Tainted(_, _, _, _) | .Present(_, _, _) | .Absent(_, _) | .Todo(_, _, _) | .NoElse(_, _) | .PatternTest(_, _, _, _) | .Ok(_, _, _) | .Err(_, _, _) | .Try(_, _, _, _, _) | .OrFallback(_, _, _, _, _) | .If(_, _, _, _, _, _, _) | .TupleLit(_, _, _, _) | .Lambda(_, _) | .CallValue(_, _, _, _) | .PtrFromAddr(_, _, _, _, _, _) | .ComptimeName(_, _, _, _) | .TypeValue(_, _, _) | .Pipe(_, _, _, _) -> {
            Err(jet_cli_dap_eval_error("the debugger evaluates locals, literals, `! -`, `+ - *`, comparisons, `&&` and `||`"))
        }
    }
}

// `first op second` for an arithmetic or comparison operator.
jet_cli_dap_binary: fn(op: BinOp, first: NativeLocal, second: NativeLocal) -> NativeLocal JetCLIDapEvalError! {
    if jet_cli_dap_as_int(first) == .Val(a) && jet_cli_dap_as_int(second) == .Val(b) {
        return if op == {
            .Add -> Ok(jet_cli_dap_of_int(a + b))
            .Sub -> Ok(jet_cli_dap_of_int(a - b))
            .Mul -> Ok(jet_cli_dap_of_int(a * b))
            .Div | .FloorDiv | .Mod | .Rem | .Pow | .BitAnd | .BitOr | .BitXor | .Shl | .Shr | .Compare | .And | .Or | .Eq | .Ne | .Lt | .Gt | .Le | .Ge -> jet_cli_dap_order(op, a <=> b)
        }
    }
    if jet_cli_dap_as_float(first) == .Val(a) && jet_cli_dap_as_float(second) == .Val(b) {
        return if op == {
            .Add -> Ok(jet_cli_dap_of_float(a + b))
            .Sub -> Ok(jet_cli_dap_of_float(a - b))
            .Mul -> Ok(jet_cli_dap_of_float(a * b))
            .Eq -> Ok(jet_cli_dap_of_bool(a <= b && a >= b))
            .Ne -> Ok(jet_cli_dap_of_bool(!(a <= b && a >= b)))
            .Lt -> Ok(jet_cli_dap_of_bool(a < b))
            .Gt -> Ok(jet_cli_dap_of_bool(a > b))
            .Le -> Ok(jet_cli_dap_of_bool(a <= b))
            .Ge -> Ok(jet_cli_dap_of_bool(a >= b))
            .Div | .FloorDiv | .Mod | .Rem | .Pow | .BitAnd | .BitOr | .BitXor | .Shl | .Shr | .Compare | .And | .Or -> Err(jet_cli_dap_eval_error("this operator is not evaluated"))
        }
    }
    if jet_cli_dap_as_string(first) == .Val(a) && jet_cli_dap_as_string(second) == .Val(b) -> return jet_cli_dap_order(op, a <=> b)
    if jet_cli_dap_as_bool(first) == .Val(a) && jet_cli_dap_as_bool(second) == .Val(b) && (op == .Eq || op == .Ne) -> return Ok(jet_cli_dap_of_bool((a == b) == (op == .Eq)))
    Err(jet_cli_dap_eval_error("the operands are not two Ints, two Floats, two Strings or two Bools"))
}

// A comparison operator applied to an ordering (`<=>`'s).
jet_cli_dap_order: fn(op: BinOp, order: Ordering) -> NativeLocal JetCLIDapEvalError! {
    if op == {
        .Eq -> Ok(jet_cli_dap_of_bool(order == Ordering.Equal))
        .Ne -> Ok(jet_cli_dap_of_bool(order != Ordering.Equal))
        .Lt -> Ok(jet_cli_dap_of_bool(order == Ordering.Less))
        .Gt -> Ok(jet_cli_dap_of_bool(order == Ordering.Greater))
        .Le -> Ok(jet_cli_dap_of_bool(order != Ordering.Greater))
        .Ge -> Ok(jet_cli_dap_of_bool(order != Ordering.Less))
        .Add | .Sub | .Mul | .Div | .FloorDiv | .Mod | .Rem | .Pow | .BitAnd | .BitOr | .BitXor | .Shl | .Shr | .Compare | .And | .Or -> Err(jet_cli_dap_eval_error("this operator is not evaluated"))
    }
}

// A local's value row, checked readable as its Jet type.
jet_cli_dap_local: fn(local: NativeLocal) -> NativeLocal JetCLIDapEvalError! {
    if local.value == NATIVE_DEBUG_UNAVAILABLE -> return Err(jet_cli_dap_eval_error("`{local.name}` has no readable value here"))
    value: jet_cli_dap_value(local.type_name, local.value)
    readable: if jet_cli_dap_kind(local.type_name) == {
        "Int" -> jet_cli_dap_as_int(value) != None
        "Float" -> jet_cli_dap_as_float(value) != None
        "Bool" -> jet_cli_dap_as_bool(value) != None
        else -> true
    }
    if !readable -> return Err(jet_cli_dap_eval_error("`{local.name}` reads `{local.value}`, not a {local.type_name}"))
    Ok(value)
}

// A value as string interpolation shows it: a String's own text.
jet_cli_dap_text: fn(value: NativeLocal) -> String Never! {
    jet_cli_dap_as_string(value) ?? value.value
}

// A value as the Locals view shows it, and its Jet type.
jet_cli_dap_shown: fn(value: NativeLocal) -> (text: String, type_name: String) Never! {
    (text: value.value, type_name: value.type_name)
}

jet_cli_dap_test_locals: fn() -> [NativeLocal] Never! {
    [NativeLocal]{
        NativeLocal{name: "i", type_name: "Int", value: "3"},
        NativeLocal{name: "rate", type_name: "Float", value: "0.5"},
        NativeLocal{name: "name", type_name: "String", value: "\"ab\""},
        NativeLocal{name: "done", type_name: "Bool", value: "false"},
        NativeLocal{name: "gone", type_name: "Int", value: NATIVE_DEBUG_UNAVAILABLE},
    }
}

// `text`'s value over the test locals as interpolation shows it, or
// `error: <why>`.
jet_cli_dap_test_eval: fn(text: String) -> String Never! {
    expr: jet_cli_dap_parse(text) ?? return "error: {err.message}"
    value: jet_cli_dap_eval(expr, jet_cli_dap_test_locals()) ?? return "error: {err.message}"
    jet_cli_dap_text(value)
}

#Test("A debugger condition compares and combines locals") {
    assert_eq(jet_cli_dap_test_eval("i == 3"), "true")
    assert_eq(jet_cli_dap_test_eval("i != 3 || !done"), "true")
    assert_eq(jet_cli_dap_test_eval("0 < i <= 2"), "false")
    assert_eq(jet_cli_dap_test_eval("name < \"b\" && rate >= 0.5"), "true")
    assert_eq(jet_cli_dap_test_eval("(i + 1) * -2"), "-8")
}

#Test("A debugger expression that can't be evaluated says why") {
    assert(jet_cli_dap_test_eval("i ==").starts_with("error: `i ==` is not a Jet expression"))
    assert_eq(jet_cli_dap_test_eval("missing > 1"), "error: `missing` is not a local here")
    assert_eq(jet_cli_dap_test_eval("gone == 1"), "error: `gone` has no readable value here")
    assert_eq(jet_cli_dap_test_eval("i == rate"), "error: the operands are not two Ints, two Floats, two Strings or two Bools")
    assert(jet_cli_dap_test_eval("name.len()").starts_with("error: the debugger evaluates locals"))
    condition: jet_cli_dap_parse("i + 1") ?? panic(err.message)
    assert(jet_cli_dap_condition(condition, jet_cli_dap_test_locals()) == .Err(_))
}

#Test("A logpoint message fills in its expressions") {
    message: jet_cli_dap_parse_message("i is {{i}}, twice {{i * 2}}, \"{{name}}\"") ?? panic(err.message)
    value: jet_cli_dap_eval(message, jet_cli_dap_test_locals()) ?? panic(err.message)
    assert_eq(jet_cli_dap_text(value), "i is 3, twice 6, \"ab\"")
}
