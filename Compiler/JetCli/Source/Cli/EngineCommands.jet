// Engine front doors. Keep the original argv, including the standalone `--` and
// opaque downstream flags; InspectB owns the one engine
// protocol/stdio/exit-status mechanism.
jet_cli_engine_commands: fn(command: String, raw: [String]) -> JetCLIPlan? Never! {
    if command == {
        "env" -> {
            forwarded := [String]{"env"}
            removed := false
            loop argument in raw {
                if !removed && argument == "env" {
                    removed = true
                    next
                }
                forwarded.push(argument.copy())
            }
            return Val(JetCLIPlan.InspectB{plan: JetCLIInspectBPlan.Engine{engine: JET_CLI_JETPACK_BINARY, verb: command, argv: forwarded}})
        }
        "trust" | "image" | "os" | "bridge" | "services" | "config" | "search" | "clean" | "split" | "fold" -> {
            return Val(JetCLIPlan.InspectB{plan: JetCLIInspectBPlan.Engine{engine: JET_CLI_JETPACK_BINARY, verb: command, argv: raw}})
        }
        else -> {}
    }
    None
}

// The hidden engine host of a bare `jet dev` in a role-file project
// (Jetpack/CLI EnvCommand.jet `cli_cmd_dev`).
JET_CLI_DEV_ENGINE_VERB: "__dev"

// A bare `jet dev` at `start` in a role-file project (an `env.jet` and no
// `package.jet` here or above) runs inside the project environment: the
// engine gates trust, checks the declared secrets, composes the environment,
// starts the dev services, then runs `jet dev <entry>` there. The engine gets
// its own flags, then `--` and every word of that `jet dev <entry>`; a color
// flag goes to both. None outside such a project, or when `jet dev` names a
// file.
jet_cli_dev_environment_plan: fn(start: String, raw: [String]) -[FS, Env]> JetCLIPlan? Never! {
    if jet_cli_find_package_root(start, false) == {
        .Absent -> {}
        .Root(_) | .Refused(_) -> return None
    }
    if jet_cli_find_env_root(start) == None -> return None
    engine := [String]{JET_CLI_DEV_ENGINE_VERB}
    dev := [String]{}
    named := false
    value_next := false
    separated := false
    loop word in raw {
        if !named && word == "dev" {
            named = true
            next
        }
        if separated {
            dev.push(word.copy())
            next
        }
        if value_next {
            engine.push(word.copy())
            value_next = false
            next
        }
        if word == {
            "--" -> {
                separated = true
                dev.push(word.copy())
            }
            "--trust" | "--offline" | "--yes" | "-y" -> engine.push(word.copy())
            "--env" | "--preset" | "--fixtures" | "--local-nix-catalog" -> {
                engine.push(word.copy())
                value_next = true
            }
            else -> {
                if !word.starts_with("-") -> return None
                if word == "--no-color" || word.starts_with("--color=") -> engine.push(word.copy())
                dev.push(word.copy())
            }
        }
    }
    engine.push("--")
    loop word in dev -> engine.push(word)
    Val(JetCLIPlan.InspectB{plan: JetCLIInspectBPlan.Engine{engine: JET_CLI_JETPACK_BINARY, verb: "dev", argv: engine}})
}

// The hidden engine host of the package-dependency commands (Jetpack/CLI
// Hosts/PackageDependencyHost.jet); its version is part of the protocol.
JET_CLI_PACKAGE_ENGINE_VERB: "__package-v1"

// `jet add|remove|fetch|update [<dep>]`, `jet registry vendor` and the lock check of
// `jet build --locked`: the front selects the package root of `start` and
// its project entry; the engine edits that Package carrier and runs the
// package fetch. `jet fetch --lock <script>` locks a loose script, which has
// no project: the engine gets `start` and no entry. `words` are the
// command's words as typed, command first.
jet_cli_package_engine: fn(start: String, words: [String], color: Bool, json: Bool) -[FS, Env]> JetCLIPlan Never! {
    command: words[0]
    if command == "fetch" && words.contains("--lock") {
        argv := [String]{JET_CLI_PACKAGE_ENGINE_VERB, start, "", if color -> "1" else -> "0", if json -> "1" else -> "0"}
        loop word in words -> argv.push(word.copy())
        return JetCLIPlan.InspectB{plan: JetCLIInspectBPlan.Engine{engine: JET_CLI_JETPACK_BINARY, verb: command, argv: argv}}
    }
    root: if jet_cli_require_inspect_root(start, "error: `jet {command}` needs a project — no `package.jet` found here or above", color) == {
        .Root(path) -> path
        .Refused(plan) -> { return plan }
    }
    notices := [String]{}
    entry: if jet_cli_find_project_entry(root, command, color, notices) == {
        .Entry(found) -> found.path
        .Refused(plan) -> { return plan }
        .Absent -> jet_cli_entry_join(root, JET_CLI_DEFAULT_ENTRY_FILE)
    }
    argv := [String]{JET_CLI_PACKAGE_ENGINE_VERB, root, entry, if color -> "1" else -> "0", if json -> "1" else -> "0"}
    loop word in words -> argv.push(word.copy())
    JetCLIPlan.InspectB{plan: JetCLIInspectBPlan.Engine{engine: JET_CLI_JETPACK_BINARY, verb: command, argv: argv}}
}

// The command's words from the jet-owned argv: from the command word on.
jet_cli_command_words: fn(jet_argv: [String], command: String) -> [String] Never! {
    words := [String]{}
    loop word in jet_argv {
        if words.len() == 0 && word != command -> next
        words.push(word.copy())
    }
    words
}
