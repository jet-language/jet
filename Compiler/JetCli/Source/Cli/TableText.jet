// The shared CLI text policy from AdaptiveTable.rs, not core.text's UAX
// grapheme/width policy. Inputs are valid UTF-8 byte facts. Every scalar read
// uses the one Foundation decoder over the caller's READ array. Owned output
// buffers are distinct; this does not establish a borrowed String supplier.
use jet_foundation.[foundation_read_bytes_scalar_at, foundation_append_read_bytes]

JET_CLI_TABLE_MAX_CELL_BYTES :: 4096
JET_CLI_TABLE_MAX_RENDER_WIDTH :: 256

fn jet_cli_table_min(a: Int, b: Int) -> Int Never! { if a < b -> a else -> b }
fn jet_cli_table_max(a: Int, b: Int) -> Int Never! { if a > b -> a else -> b }
fn jet_cli_table_sub(a: Int, b: Int) -> Int Never! { if a > b -> a - b else -> 0 }
fn jet_cli_table_control(code: Int) -> Bool Never! { code < 32 || (code >= 127 && code <= 159) }
fn jet_cli_table_regional(code: Int) -> Bool Never! { code >= 0x1f1e6 && code <= 0x1f1ff }

// Preserve the reference ranges literally, including its supplementary
// 1dc00..1dfff range. Changing Unicode policy is not part of this port.
fn jet_cli_table_extend(code: Int) -> Bool Never! {
    if {
        code >= 0x0300 && code <= 0x036f -> true
        code >= 0x0483 && code <= 0x0489 -> true
        code >= 0x0591 && code <= 0x05bd -> true
        code == 0x05bf -> true
        code >= 0x05c1 && code <= 0x05c2 -> true
        code >= 0x05c4 && code <= 0x05c5 -> true
        code >= 0x0610 && code <= 0x061a -> true
        code >= 0x064b && code <= 0x065f -> true
        code == 0x0670 -> true
        code >= 0x06d6 && code <= 0x06ed -> true
        code == 0x0711 -> true
        code >= 0x0730 && code <= 0x074a -> true
        code >= 0x07a6 && code <= 0x07b0 -> true
        code >= 0x07eb && code <= 0x07f3 -> true
        code >= 0x0816 && code <= 0x0819 -> true
        code >= 0x081b && code <= 0x0823 -> true
        code >= 0x0825 && code <= 0x0827 -> true
        code >= 0x0829 && code <= 0x082d -> true
        code >= 0x0859 && code <= 0x085b -> true
        code >= 0x08d3 && code <= 0x0903 -> true
        code >= 0x093a && code <= 0x093c -> true
        code >= 0x093e && code <= 0x094f -> true
        code >= 0x0951 && code <= 0x0957 -> true
        code >= 0x0962 && code <= 0x0963 -> true
        code >= 0x0981 && code <= 0x0984 -> true
        code >= 0x09be && code <= 0x09c4 -> true
        code >= 0x09c7 && code <= 0x09c8 -> true
        code >= 0x09cb && code <= 0x09cd -> true
        code == 0x09d7 -> true
        code >= 0x09e2 && code <= 0x09e3 -> true
        code >= 0x0a01 && code <= 0x0a03 -> true
        code == 0x0a3c -> true
        code >= 0x0a3e && code <= 0x0a42 -> true
        code >= 0x0a47 && code <= 0x0a48 -> true
        code >= 0x0a4b && code <= 0x0a4d -> true
        code == 0x0a51 -> true
        code >= 0x0a70 && code <= 0x0a71 -> true
        code == 0x0a75 -> true
        code == 0x0abc -> true
        code >= 0x0abe && code <= 0x0ac5 -> true
        code >= 0x0ac7 && code <= 0x0ac9 -> true
        code >= 0x0acb && code <= 0x0acd -> true
        code >= 0x0ae2 && code <= 0x0ae3 -> true
        code >= 0x0b01 && code <= 0x0b03 -> true
        code == 0x0b3c -> true
        code >= 0x0b3e && code <= 0x0b44 -> true
        code >= 0x0b47 && code <= 0x0b48 -> true
        code >= 0x0b4b && code <= 0x0b4d -> true
        code >= 0x0b56 && code <= 0x0b57 -> true
        code >= 0x0b62 && code <= 0x0b63 -> true
        code >= 0x0c00 && code <= 0x0c04 -> true
        code >= 0x0c3e && code <= 0x0c44 -> true
        code >= 0x0c46 && code <= 0x0c48 -> true
        code >= 0x0c4a && code <= 0x0c4d -> true
        code >= 0x0c55 && code <= 0x0c56 -> true
        code >= 0x0c62 && code <= 0x0c63 -> true
        code >= 0x0d00 && code <= 0x0d03 -> true
        code >= 0x0d3b && code <= 0x0d44 -> true
        code >= 0x0d46 && code <= 0x0d48 -> true
        code >= 0x0d4a && code <= 0x0d4d -> true
        code == 0x0d57 -> true
        code >= 0x0d62 && code <= 0x0d63 -> true
        code == 0x0e31 -> true
        code >= 0x0e34 && code <= 0x0e3a -> true
        code >= 0x0e47 && code <= 0x0e4e -> true
        code == 0x0eb1 -> true
        code >= 0x0eb4 && code <= 0x0ebc -> true
        code >= 0x0ec8 && code <= 0x0ecd -> true
        code == 0x0f18 -> true
        code == 0x0f35 -> true
        code == 0x0f37 -> true
        code == 0x0f39 -> true
        code >= 0x0f71 && code <= 0x0f84 -> true
        code >= 0x0f86 && code <= 0x0f87 -> true
        code >= 0x0f8d && code <= 0x0fbc -> true
        code == 0x0fc6 -> true
        code >= 0x102b && code <= 0x103e -> true
        code >= 0x1056 && code <= 0x1059 -> true
        code >= 0x105e && code <= 0x1060 -> true
        code >= 0x1062 && code <= 0x1064 -> true
        code >= 0x1067 && code <= 0x106d -> true
        code >= 0x1071 && code <= 0x1074 -> true
        code == 0x1082 -> true
        code == 0x1084 -> true
        code >= 0x1087 && code <= 0x108d -> true
        code == 0x108f -> true
        code >= 0x109a && code <= 0x109d -> true
        code >= 0x135d && code <= 0x135f -> true
        code >= 0x1712 && code <= 0x1714 -> true
        code >= 0x1732 && code <= 0x1734 -> true
        code >= 0x1752 && code <= 0x1753 -> true
        code >= 0x1772 && code <= 0x1773 -> true
        code >= 0x17b4 && code <= 0x17d3 -> true
        code == 0x17dd -> true
        code >= 0x180b && code <= 0x180f -> true
        code >= 0x1885 && code <= 0x1886 -> true
        code == 0x18a9 -> true
        code >= 0x1920 && code <= 0x193b -> true
        code >= 0x1a17 && code <= 0x1a1b -> true
        code >= 0x1a55 && code <= 0x1a5e -> true
        code == 0x1a60 -> true
        code >= 0x1a62 && code <= 0x1a6f -> true
        code >= 0x1a70 && code <= 0x1a7c -> true
        code == 0x1a7f -> true
        code >= 0x1ab0 && code <= 0x1aff -> true
        code >= 0x1b00 && code <= 0x1b04 -> true
        code == 0x1b34 -> true
        code >= 0x1b36 && code <= 0x1b44 -> true
        code >= 0x1b6b && code <= 0x1b73 -> true
        code >= 0x1b80 && code <= 0x1b82 -> true
        code >= 0x1ba1 && code <= 0x1bad -> true
        code >= 0x1be6 && code <= 0x1bf3 -> true
        code >= 0x1c24 && code <= 0x1c37 -> true
        code >= 0x1cd0 && code <= 0x1ce8 -> true
        code == 0x1ced -> true
        code == 0x1cf4 -> true
        code >= 0x1cf7 && code <= 0x1cfc -> true
        code >= 0x1d167 && code <= 0x1d1ff -> true
        code >= 0x1dc00 && code <= 0x1dfff -> true
        code >= 0x20d0 && code <= 0x20f0 -> true
        code >= 0x2cef && code <= 0x2cf1 -> true
        code >= 0x2de0 && code <= 0x2dff -> true
        code >= 0x302a && code <= 0x302f -> true
        code >= 0xa66f && code <= 0xa672 -> true
        code >= 0xa674 && code <= 0xa67d -> true
        code >= 0xa69e && code <= 0xa69f -> true
        code >= 0xa6f0 && code <= 0xa6f1 -> true
        code == 0xa802 -> true
        code == 0xa806 -> true
        code == 0xa80b -> true
        code >= 0xa823 && code <= 0xa827 -> true
        code == 0xa82c -> true
        code >= 0xa880 && code <= 0xa881 -> true
        code >= 0xa8b4 && code <= 0xa8c5 -> true
        code >= 0xa8e0 && code <= 0xa8f1 -> true
        code == 0xa8ff -> true
        code >= 0xa926 && code <= 0xa92f -> true
        code >= 0xa947 && code <= 0xa953 -> true
        code >= 0xa980 && code <= 0xa983 -> true
        code >= 0xa9b3 && code <= 0xa9c0 -> true
        code == 0xa9c6 -> true
        code == 0xa9e5 -> true
        code >= 0xaa29 && code <= 0xaa3f -> true
        code == 0xaa43 -> true
        code >= 0xaa4c && code <= 0xaa4d -> true
        code >= 0xaa7b && code <= 0xaa7d -> true
        code == 0xaab0 -> true
        code >= 0xaab2 && code <= 0xaab4 -> true
        code >= 0xaab7 && code <= 0xaab8 -> true
        code >= 0xaabe && code <= 0xaabf -> true
        code == 0xaac1 -> true
        code >= 0xaaeb && code <= 0xaaef -> true
        code >= 0xaaf5 && code <= 0xaaf6 -> true
        code >= 0xabe3 && code <= 0xabe4 -> true
        code >= 0xabe6 && code <= 0xabe7 -> true
        code == 0xabe9 -> true
        code == 0xabec -> true
        code >= 0xabf0 && code <= 0xabf1 -> true
        code >= 0xfe00 && code <= 0xfe0f -> true
        code >= 0xfe20 && code <= 0xfe2f -> true
        code >= 0x1f3fb && code <= 0x1f3ff -> true
        code == 0x200b || code == 0x200c -> true
        code >= 0x200e && code <= 0x200f -> true
        code >= 0x2060 && code <= 0x2064 -> true
        code >= 0x2066 && code <= 0x206f -> true
        else -> false
    }
}

fn jet_cli_table_wide(code: Int) -> Bool Never! {
    if {
        code >= 0x1100 && code <= 0x115f -> true
        code >= 0x231a && code <= 0x231b -> true
        code >= 0x2329 && code <= 0x232a -> true
        code >= 0x23e9 && code <= 0x23ec -> true
        code == 0x23f0 || code == 0x23f3 -> true
        code >= 0x25fd && code <= 0x25fe -> true
        code >= 0x2614 && code <= 0x2615 -> true
        code >= 0x2648 && code <= 0x2653 -> true
        code == 0x267f || code == 0x2693 || code == 0x26a1 -> true
        code >= 0x26aa && code <= 0x26ab -> true
        code >= 0x26bd && code <= 0x26be -> true
        code >= 0x26c4 && code <= 0x26c5 -> true
        code == 0x26ce || code == 0x26d4 || code == 0x26ea -> true
        code >= 0x26f2 && code <= 0x26f3 -> true
        code == 0x26f5 || code == 0x26fa || code == 0x26fd || code == 0x2705 -> true
        code >= 0x270a && code <= 0x270b -> true
        code == 0x2728 || code == 0x274c || code == 0x274e -> true
        code >= 0x2753 && code <= 0x2755 -> true
        code == 0x2757 -> true
        code >= 0x2795 && code <= 0x2797 -> true
        code == 0x27b0 || code == 0x27bf -> true
        code >= 0x2b1b && code <= 0x2b1c -> true
        code == 0x2b50 || code == 0x2b55 -> true
        code >= 0x2e80 && code <= 0x2ffb -> true
        code >= 0x3000 && code <= 0x303e -> true
        code >= 0x3041 && code <= 0x3247 -> true
        code >= 0x3250 && code <= 0x4dbf -> true
        code >= 0x4e00 && code <= 0xa4c6 -> true
        code >= 0xa960 && code <= 0xa97c -> true
        code >= 0xac00 && code <= 0xd7a3 -> true
        code >= 0xf900 && code <= 0xfaff -> true
        code >= 0xfe10 && code <= 0xfe19 -> true
        code >= 0xfe30 && code <= 0xfe6b -> true
        code >= 0xff01 && code <= 0xff60 -> true
        code >= 0xffe0 && code <= 0xffe6 -> true
        code >= 0x1f300 && code <= 0x1f64f -> true
        code >= 0x1f680 && code <= 0x1f6ff -> true
        code >= 0x1f900 && code <= 0x1f9ff -> true
        code >= 0x20000 && code <= 0x3fffd -> true
        else -> false
    }
}

fn jet_cli_table_scalar_width(code: Int) -> Int Never! {
    if jet_cli_table_control(code) || jet_cli_table_extend(code) || code == 0x200d -> return 0
    if jet_cli_table_wide(code) -> 2 else -> 1
}

struct JetCLITableCluster { end: Int, width: Int }

// start and limit are scalar boundaries of an unchanged READ input. Unlike
// UAX segmentation, a regional indicator absorbs only a second indicator;
// other starts absorb Extend* and repeated ZWJ + next scalar, taking max width.
fn jet_cli_table_cluster(source: [U8], start: Int, limit: Int) -> JetCLITableCluster Never! {
    first :: foundation_read_bytes_scalar_at(source, start)
    end := first.next_byte
    width := jet_cli_table_scalar_width(first.codepoint)
    if jet_cli_table_regional(first.codepoint) {
        if end < limit {
            next_scalar :: foundation_read_bytes_scalar_at(source, end)
            if jet_cli_table_regional(next_scalar.codepoint) {
                end = next_scalar.next_byte
                width = 2
            }
        }
    } else {
        loop {
            loop end < limit {
                extension :: foundation_read_bytes_scalar_at(source, end)
                if !jet_cli_table_extend(extension.codepoint) -> break
                end = extension.next_byte
            }
            if end >= limit -> break
            joiner :: foundation_read_bytes_scalar_at(source, end)
            if joiner.codepoint != 0x200d -> break
            end = joiner.next_byte
            if end >= limit -> break
            joined :: foundation_read_bytes_scalar_at(source, end)
            end = joined.next_byte
            width = jet_cli_table_max(width, jet_cli_table_scalar_width(joined.codepoint))
        }
    }
    JetCLITableCluster{end: end, width: width}
}

// Only ANSI ESC sequences are removed. Other controls (and newlines) remain
// literal facts. Scan scalars, so an ESC followed by non-ASCII consumes the
// whole scalar just as the Rust char iterator does.
fn jet_cli_table_strip_ansi(source: [U8]) -> [U8] Never! {
    out := [U8]{}
    state := 0
    index := 0
    loop index < source.len() {
        scalar :: foundation_read_bytes_scalar_at(source, index)
        code :: scalar.codepoint
        if state == {
            0 -> {
                if code == 27 -> state = 1
                else -> foundation_append_read_bytes(&out, source, index, scalar.next_byte)
            }
            1 -> state = if code == 91 -> 2 else if code == 93 -> 3 else -> 0
            2 -> { if code >= 64 && code <= 126 -> state = 0 }
            3 -> { if code == 7 -> state = 0 else if code == 27 -> state = 4 }
            4 -> state = if code == 92 -> 0 else -> 3
            else -> state = 0
        }
        index = scalar.next_byte
    }
    out
}

// Consume already owned facts. A clean, bounded input is returned unchanged;
// scans never materialize a scalar/substring/list from a String. Oversized
// clusters are skipped, and later fitting clusters are retained (not prefix
// truncation). Text truncation does not set the table's structural flag.
fn jet_cli_table_bound_text(input: ^[U8]) -> [U8] Never! {
    text := ^input
    ansi := false
    loop byte in text {
        if byte == (U8{27}) {
            ansi = true
            break
        }
    }
    if ansi -> text = jet_cli_table_strip_ansi(text)
    if text.len() <= JET_CLI_TABLE_MAX_CELL_BYTES -> return ^text
    out := [U8]{}
    index := 0
    loop index < text.len() {
        cluster :: jet_cli_table_cluster(text, index, text.len())
        if out.len() + cluster.end - index <= JET_CLI_TABLE_MAX_CELL_BYTES -> foundation_append_read_bytes(&out, text, index, cluster.end)
        index = cluster.end
    }
    out
}

// Normalized table facts have already had ANSI removed and the byte bound
// applied. Width is the maximum logical line, not the sum across newlines.
fn jet_cli_table_text_width(text: [U8]) -> Int Never! {
    maximum := 0
    start := 0
    loop start <= text.len() {
        end := start
        loop end < text.len() && text[end] != (U8{10}) -> end += 1
        width := 0
        index := start
        loop index < end {
            cluster :: jet_cli_table_cluster(text, index, end)
            width += cluster.width
            index = cluster.end
        }
        maximum = jet_cli_table_max(maximum, width)
        if end == text.len() -> break
        start = end + 1
    }
    maximum
}

fn jet_cli_table_wrap_span(lines: &[[U8]], text: [U8], start: Int, stop: Int, width: Int) Never! {
    end := stop
    if end > start && text[end - 1] == (U8{13}) -> end -= 1
    if start == end {
        &lines.push([U8]{})
        return
    }
    line := [U8]{}
    line_width := 0
    emitted := false
    index := start
    loop index < end {
        cluster :: jet_cli_table_cluster(text, index, end)
        if {
            cluster.width == 0 -> {
                if line_width < width -> foundation_append_read_bytes(&line, text, index, cluster.end)
            }
            cluster.width > width -> {
                if line.len() > 0 {
                    &lines.push(^line)
                    line = [U8]{}
                    line_width = 0
                }
                &lines.push([U8]{63})
                emitted = true
            }
            else -> {
                if line_width != 0 && line_width + cluster.width > width {
                    &lines.push(^line)
                    line = [U8]{}
                    line_width = 0
                }
                foundation_append_read_bytes(&line, text, index, cluster.end)
                line_width += cluster.width
            }
        }
        index = cluster.end
    }
    if line.len() > 0 || !emitted -> &lines.push(^line)
}

fn jet_cli_table_wrap(text: [U8], budget: Int) -> [[U8]] Never! {
    width :: jet_cli_table_max(budget, 1)
    lines := [[U8]]{}
    start := 0
    loop start <= text.len() {
        end := start
        loop end < text.len() && text[end] != (U8{10}) -> end += 1
        jet_cli_table_wrap_span(&lines, text, start, end, width)
        if end == text.len() -> break
        start = end + 1
    }
    lines
}

fn jet_cli_table_clip(text: [U8], width: Int, unicode: Bool) -> [U8] Never! {
    if width == 0 -> return [U8]{}
    if text.len() > JET_CLI_TABLE_MAX_CELL_BYTES {
        // copy: `text` stays with the caller (`text` is a read parameter: no move out of it, E0201)
        // and the argument of `jet_cli_table_bound_text` owns its own.
        bounded :: jet_cli_table_bound_text(text.copy())
        return jet_cli_table_clip(bounded, width, unicode)
    }
    // copy: `text` stays with the caller (`text` is a read parameter: no move out of it, E0201) and
    // the new value owns its own.
    if jet_cli_table_text_width(text) <= width -> return text.copy()
    out := [U8]{}
    suffix_width :: if unicode -> 1 else -> 3
    if width <= suffix_width {
        if unicode -> return [U8]{226, 128, 166}
        loop _ in 0..<width -> &out.push(U8{46})
        return out
    }
    keep :: width - suffix_width
    used := 0
    index := 0
    loop index < text.len() && used < keep {
        cluster :: jet_cli_table_cluster(text, index, text.len())
        if cluster.width > keep - used -> break
        foundation_append_read_bytes(&out, text, index, cluster.end)
        used += cluster.width
        index = cluster.end
    }
    if unicode {
        &out.push(U8{226})
        &out.push(U8{128})
        &out.push(U8{166})
    } else {
        loop _ in 0..<3 -> &out.push(U8{46})
    }
    out
}

fn jet_cli_table_repeat(out: &[U8], byte: U8, count: Int) Never! {
    loop _ in 0..<count -> &out.push(byte)
}

fn jet_cli_table_append_pad(out: &[U8], value: [U8], width: Int, alignment: JetCLITableAlignment) Never! {
    if value.len() > JET_CLI_TABLE_MAX_CELL_BYTES {
        // copy: `value` stays with the caller (`value` is a read parameter: no move out of it,
        // E0201) and the argument of `jet_cli_table_bound_text` owns its own.
        bounded :: jet_cli_table_bound_text(value.copy())
        jet_cli_table_append_pad(&out, bounded, width, alignment)
        return
    }
    visible :: jet_cli_table_text_width(value)
    if visible > width {
        clipped :: jet_cli_table_clip(value, width, true)
        jet_cli_table_append_pad(&out, clipped, width, alignment)
        return
    }
    gap :: jet_cli_table_sub(width, visible)
    left :: if alignment == {
        .Left -> 0
        .Right -> gap
        .Center -> gap /% 2
    }
    jet_cli_table_repeat(&out, U8{32}, left)
    foundation_append_read_bytes(&out, value, 0, value.len())
    jet_cli_table_repeat(&out, U8{32}, gap - left)
}
