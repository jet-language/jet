// Immutable receipts and append-only section records, held under the selected
// project root. All store I/O goes through RootedStore.
use {
    receipt_crypto: core.crypto
    jet_driver.[JET_DRIVER_RUN_RECEIPT_MAX_BYTES, JET_DRIVER_RUN_RECEIPT_MAX_FIELD, JetDriverRecordLink, JetDriverRunReceipt, JetDriverRunReceiptClaim, JetDriverRunReceiptInput, JetDriverRunReceiptSection, jet_driver_run_receipt_decode, jet_driver_run_receipt_digest, jet_driver_run_receipt_encode, jet_driver_run_receipt_is_digest, jet_driver_run_receipt_normalized_links, jet_driver_run_receipt_normalized_sections, jet_driver_run_receipt_section_validate]
}

jet_cli_receipt_lookup_bytes: fn(bytes: [U8]?, claim: JetDriverRunReceiptClaim, observed_inputs: [JetDriverRunReceiptInput], published_sections: [JetCLIReceiptSectionRecord]) -> JetDriverRunReceipt? JetCLIReadError! {
    if !jet_driver_run_receipt_is_digest(claim.key) || claim.inputs != observed_inputs -> return Ok(None)
    raw: bytes ?? return Ok(None)
    receipt := jet_driver_run_receipt_decode(raw) ?? return Ok(None)
    if receipt.claim != claim -> return Ok(None)
    Ok(Val(jet_cli_receipt_merge_sections(receipt, claim, published_sections)))
}

jet_cli_receipt_merge_sections: fn(original: &&JetDriverRunReceipt, claim: JetDriverRunReceiptClaim, published_sections: [JetCLIReceiptSectionRecord]) -> JetDriverRunReceipt JetCLIReadError! {
    receipt := original.move()
    loop record in published_sections {
        if record.claim_key != claim.key || record.parent_digest != receipt.digest {
            return Err(jet_cli_read_error("published receipt section has a different parent identity"))
        }
        section: record.section
        jet_driver_run_receipt_section_validate(section)
        same := false
        loop existing in receipt.sections {
            if existing.name != section.name -> next
            if existing.type_name == section.type_name && existing.schema_digest == section.schema_digest && existing.payload_digest == section.payload_digest {
                same = true
                break
            }
            return Err(jet_cli_read_error("receipt section `{section.name}` conflicts with the immutable receipt"))
        }
        if !same -> receipt.sections.push(section.copy())
    }
    receipt.sections = jet_driver_run_receipt_normalized_sections(receipt.sections)
    Ok(receipt)
}

// Rust bounded_redact_bytes/replace_bytes: byte-preserving, non-overlapping
// replacements, including non-UTF8 command output, before its digest is made.
jet_cli_receipt_redact_bytes: fn(bytes: [U8], secret_values: [String]) -> [U8] JetCLIReadError! {
    if bytes.len() > JET_DRIVER_RUN_RECEIPT_MAX_FIELD {
        return Err(jet_cli_read_error("receipt output exceeds its size limit"))
    }
    redacted := bytes
    marker: "<redacted>".bytes()
    loop secret in secret_values {
        needle: secret.bytes()
        if needle.len() == 0 || needle.len() > redacted.len() -> next
        output := [U8]{}
        index := 0
        loop index <= redacted.len() - needle.len() {
            matches := true
            loop offset in 0..<needle.len() {
                if redacted[index + offset] != needle[offset] {
                    matches = false
                    break
                }
            }
            if matches {
                loop byte in marker -> output.push(byte)
                index += needle.len()
            } else {
                output.push(redacted[index])
                index += 1
            }
        }
        loop offset in index..<redacted.len() -> output.push(redacted[offset])
        redacted = output.move()
    }
    if redacted.len() > JET_DRIVER_RUN_RECEIPT_MAX_FIELD {
        return Err(jet_cli_read_error("redacted receipt output exceeds its size limit"))
    }
    Ok(redacted)
}

jet_cli_receipt_prepare: fn(claim: JetDriverRunReceiptClaim, status: Int, stdout: [U8], stderr: [U8], sections: [JetDriverRunReceiptSection], consumed: [JetDriverRecordLink], produced: [JetDriverRecordLink], secret_values: [String]) -> JetDriverRunReceipt JetCLIReadError! {
    receipt := JetDriverRunReceipt{
        claim: claim,
        status: status,
        stdout: jet_cli_receipt_redact_bytes(stdout, secret_values),
        stderr: jet_cli_receipt_redact_bytes(stderr, secret_values),
        sections: jet_driver_run_receipt_normalized_sections(sections),
        consumed: jet_driver_run_receipt_normalized_links(consumed, "consumed"),
        produced: jet_driver_run_receipt_normalized_links(produced, "produced"),
        digest: "",
    }
    receipt.digest = jet_driver_run_receipt_digest(receipt)
    // The canonical codec also enforces the signed i32 exit-status domain and
    // claim field sizes; never return an object publication would refuse.
    _: jet_driver_run_receipt_encode(receipt)
    Ok(receipt)
}

jet_cli_receipt_observe_input: fn(input: JetDriverRunReceiptInput) -[FS, Time.Wait]> JetDriverRunReceiptInput JetCLIReadError! {
    if !input.path.starts_with("/") -> return Err(jet_cli_read_error("receipt input path is not absolute: {input.path}"))
    parts := [String]{}
    loop part in input.path.split("/") {
        if part != "" && part != "." -> parts.push(part)
    }
    name: parts.pop() ?? return Err(jet_cli_read_error("receipt input has no file name"))
    held: JetCLIRootedDirectory.open("/", parts, false) ?? return Err(err)
    raw: if held.read(name, Int.MAX) == {
        .Val(bytes) -> bytes
        .None -> { return Err(jet_cli_read_error("receipt input does not exist: {input.path}")) }
        .Err(error) -> { return Err(error) }
    }
    Ok(JetDriverRunReceiptInput{path: input.path, digest: receipt_crypto.sha256(raw).hex()})
}

jet_cli_receipt_inputs_current: fn(inputs: [JetDriverRunReceiptInput]) -[FS, Time.Wait]> Bool Never! {
    loop input in inputs {
        observed: jet_cli_receipt_observe_input(input) ?? return false
        if observed != input -> return false
    }
    true
}

jet_cli_receipt_read_section_records: fn(project_root: String, claim_key: String, parent_digest: String, staged: Bool{false}) -[FS, Time.Wait]> [JetCLIReceiptSectionRecord] JetCLIReadError! {
    if !jet_driver_run_receipt_is_digest(claim_key) -> return Err(jet_cli_read_error("receipt section claim digest is malformed"))
    parts: [String]{".jet", "receipts", if staged -> "staged" else -> "sections", claim_key}
    present: JetCLIRootedDirectory.present(project_root, parts) ?? return Err(err)
    if !present -> return Ok([JetCLIReceiptSectionRecord]{})
    held: JetCLIRootedDirectory.open(project_root, parts, false) ?? return Err(err)
    entries := held.list() ?? return Err(err)
    records := [JetCLIReceiptSectionRecord]{}
    loop entry in entries {
        if entry.name == "" || entry.name.starts_with(".") -> next
        shown: jet_cli_rooted_join(held.path, entry.name)
        if !jet_driver_run_receipt_is_digest(entry.name) -> return Err(jet_cli_read_error("receipt section record has a non-digest name: {shown}"))
        if !entry.is_file -> return Err(jet_cli_read_error("receipt section record is not a regular file: {shown}"))
        raw: if held.read(entry.name, JET_CLI_RECEIPT_SECTION_RECORD_MAX) == {
            .Val(bytes) -> bytes
            .None -> { return Err(jet_cli_read_error("receipt section record disappeared: {shown}")) }
            .Err(error) -> { return Err(error) }
        }
        record: jet_cli_receipt_section_record_decode(raw)
        if jet_cli_receipt_section_record_identity(record) != entry.name -> return Err(jet_cli_read_error("receipt section record identity does not match its path: {shown}"))
        if record.claim_key != claim_key || record.parent_digest != parent_digest -> return Err(jet_cli_read_error("receipt section record belongs to a different receipt: {shown}"))
        records.push(record)
        if records.len() > 256 -> return Err(jet_cli_read_error("receipt has too many sections (maximum 256)"))
    }
    Ok(records)
}

jet_cli_receipt_lookup: fn(project_root: String, claim: JetDriverRunReceiptClaim) -[FS, Time.Wait]> JetDriverRunReceipt? JetCLIReadError! {
    if !jet_driver_run_receipt_is_digest(claim.key) || !jet_cli_receipt_inputs_current(claim.inputs) -> return Ok(None)
    parts: [String]{".jet", "receipts", "objects"}
    present: JetCLIRootedDirectory.present(project_root, parts) ?? return Err(err)
    if !present -> return Ok(None)
    held: JetCLIRootedDirectory.open(project_root, parts, false) ?? return Err(err)
    raw: if held.read(claim.key, JET_DRIVER_RUN_RECEIPT_MAX_BYTES) == {
        .Val(bytes) -> bytes
        .None -> { return Ok(None) }
        .Err(error) -> { return Err(error) }
    }
    receipt: jet_driver_run_receipt_decode(raw) ?? return Ok(None)
    if receipt.claim != claim -> return Ok(None)
    records: jet_cli_receipt_read_section_records(project_root, claim.key, receipt.digest)
    Ok(Val(jet_cli_receipt_merge_sections(receipt, claim, records)))
}

// True is a new immutable object; false is an identical publication or a
// stale input closure. A different object under the same key is never replaced.
jet_cli_receipt_publish: fn(project_root: String, receipt: JetDriverRunReceipt) -[FS, Env, Time.Wait]> Bool JetCLIReadError! {
    if !jet_driver_run_receipt_is_digest(receipt.claim.key) -> return Err(jet_cli_read_error("receipt claim key is not a lowercase SHA-256 digest"))
    bytes: jet_driver_run_receipt_encode(receipt)
    if !jet_cli_receipt_inputs_current(receipt.claim.inputs) -> return Ok(false)
    held: JetCLIRootedDirectory.open(project_root, [String]{".jet", "receipts", "objects"}, true) ?? return Err(err)
    Ok(held.publish_immutable(receipt.claim.key, bytes, None, JET_DRIVER_RUN_RECEIPT_MAX_BYTES) ?? return Err(err))
}

jet_cli_receipt_list: fn(project_root: String) -[FS, Time.Wait]> [JetDriverRunReceipt] JetCLIReadError! {
    parts: [String]{".jet", "receipts", "objects"}
    present: JetCLIRootedDirectory.present(project_root, parts) ?? return Err(err)
    if !present -> return Ok([JetDriverRunReceipt]{})
    held: JetCLIRootedDirectory.open(project_root, parts, false) ?? return Err(err)
    entries := held.list() ?? return Err(err)
    receipts := [JetDriverRunReceipt]{}
    loop entry in entries {
        if !entry.is_file || !jet_driver_run_receipt_is_digest(entry.name) -> next
        raw: held.read(entry.name, JET_DRIVER_RUN_RECEIPT_MAX_BYTES) ?? next
        receipt: jet_driver_run_receipt_decode(raw) ?? next
        if receipt.claim.key != entry.name -> next
        records: jet_cli_receipt_read_section_records(project_root, entry.name, receipt.digest) ?? next
        key: receipt.claim
        row: jet_cli_receipt_merge_sections(receipt, key, records) ?? next
        receipts.push(row)
    }
    Ok(receipts)
}
