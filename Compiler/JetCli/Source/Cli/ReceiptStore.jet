// Pure ReceiptStore operations (Source/ReceiptStore.rs lookup 624-675).
// The host supplies bytes only after the canonical held-directory reader has
// authenticated the file. This API never opens paths or publishes an object.
pub fn jet_cli_receipt_lookup_bytes(bytes: [U8]?, claim: JetCLIReceiptClaim, observed_inputs: [JetCLIReceiptInput], published_sections: [JetCLIReceiptSectionRecord]) -> JetCLIReceipt? String! {
    if !jet_cli_receipt_is_digest(claim.key) || claim.inputs != observed_inputs -> return Ok(None)
    raw :: bytes ?? return Ok(None)
    receipt := jet_cli_receipt_decode(raw) ?? return Ok(None)
    if receipt.claim != claim -> return Ok(None)
    loop record in published_sections {
        if record.claim_key != claim.key || record.parent_digest != receipt.digest {
            return Err("published receipt section has a different parent identity")
        }
        section :: record.section
        jet_cli_receipt_section_validate(section)
        same := false
        loop existing in receipt.sections {
            if existing.name != section.name -> next
            if existing.type_name == section.type_name && existing.schema_digest == section.schema_digest && existing.payload_digest == section.payload_digest {
                same = true
                break
            }
            return Err("receipt section `{section.name}` conflicts with the immutable receipt")
        }
        if !same -> &receipt.sections.push(section)
    }
    receipt.sections = jet_cli_receipt_normalized_sections(receipt.sections)
    Ok(Val(receipt))
}

pub fn jet_cli_receipt_section(receipt: JetCLIReceipt, name: String) -> JetCLIReceiptSection? String! {
    jet_cli_receipt_section_name_validate(name)
    loop section in receipt.sections {
        if section.name == name -> return Ok(Val(section))
    }
    Ok(None)
}

// Rust bounded_redact_bytes/replace_bytes: byte-preserving, non-overlapping
// replacements, including non-UTF8 command output, before its digest is made.
pub fn jet_cli_receipt_redact_bytes(bytes: [U8], secret_values: [String]) -> [U8] String! {
    if bytes.len() > JET_CLI_RECEIPT_MAX_FIELD {
        return Err("receipt output exceeds its size limit")
    }
    redacted := bytes
    marker :: "<redacted>".bytes()
    loop secret in secret_values {
        needle :: secret.bytes()
        if needle.len() == 0 || needle.len() > redacted.len() -> next
        output := [U8]{}
        index := 0
        loop index <= redacted.len() - needle.len() {
            matches := true
            loop offset in 0..<needle.len() {
                if redacted[index + offset] != needle[offset] {
                    matches = false
                    break
                }
            }
            if matches {
                loop byte in marker -> &output.push(byte)
                index += needle.len()
            } else {
                &output.push(redacted[index])
                index += 1
            }
        }
        loop offset in index..<redacted.len() -> &output.push(redacted[offset])
        redacted = ^output
    }
    if redacted.len() > JET_CLI_RECEIPT_MAX_FIELD {
        return Err("redacted receipt output exceeds its size limit")
    }
    Ok(redacted)
}

pub fn jet_cli_receipt_prepare(claim: JetCLIReceiptClaim, status: Int, stdout: [U8], stderr: [U8], sections: [JetCLIReceiptSection], consumed: [JetCLIRecordLink], produced: [JetCLIRecordLink], secret_values: [String]) -> JetCLIReceipt String! {
    receipt := JetCLIReceipt{
        claim: claim,
        status: status,
        stdout: jet_cli_receipt_redact_bytes(stdout, secret_values),
        stderr: jet_cli_receipt_redact_bytes(stderr, secret_values),
        sections: jet_cli_receipt_normalized_sections(sections),
        consumed: jet_cli_receipt_normalized_links(consumed, "consumed"),
        produced: jet_cli_receipt_normalized_links(produced, "produced"),
        digest: "",
    }
    receipt.digest = jet_cli_receipt_digest(receipt)
    // The canonical codec also enforces the signed i32 exit-status domain and
    // claim field sizes; never return an object publication would refuse.
    _ :: jet_cli_receipt_encode(receipt)
    Ok(receipt)
}
