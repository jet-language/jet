// Source/ReceiptStore.rs: immutable receipts and append-only section records,
// held under the selected project root. All store I/O goes through RootedStore.
use core.crypto as receipt_crypto

fn jet_cli_receipt_lookup_bytes(bytes: [U8]?, claim: JetCLIReceiptClaim, observed_inputs: [JetCLIReceiptInput], published_sections: [JetCLIReceiptSectionRecord]) -> JetCLIReceipt? JetCLIReadError! {
    if !jet_cli_receipt_is_digest(claim.key) || claim.inputs != observed_inputs -> return Ok(None)
    raw :: bytes ?? return Ok(None)
    receipt := jet_cli_receipt_decode(raw) ?? return Ok(None)
    if receipt.claim != claim -> return Ok(None)
    Ok(Val(jet_cli_receipt_merge_sections(^receipt, claim, published_sections)))
}

fn jet_cli_receipt_merge_sections(original: ^JetCLIReceipt, claim: JetCLIReceiptClaim, published_sections: [JetCLIReceiptSectionRecord]) -> JetCLIReceipt JetCLIReadError! {
    receipt := ^original
    loop record in published_sections {
        if record.claim_key != claim.key || record.parent_digest != receipt.digest {
            return Err(jet_cli_read_error("published receipt section has a different parent identity"))
        }
        section :: record.section
        jet_cli_receipt_section_validate(section)
        same := false
        loop existing in receipt.sections {
            if existing.name != section.name -> next
            if existing.type_name == section.type_name && existing.schema_digest == section.schema_digest && existing.payload_digest == section.payload_digest {
                same = true
                break
            }
            return Err(jet_cli_read_error("receipt section `{section.name}` conflicts with the immutable receipt"))
        }
        if !same -> &receipt.sections.push(section)
    }
    receipt.sections = jet_cli_receipt_normalized_sections(receipt.sections)
    Ok(receipt)
}

fn jet_cli_receipt_section(receipt: JetCLIReceipt, name: String) -> JetCLIReceiptSection? JetCLIReadError! {
    jet_cli_receipt_section_name_validate(name)
    loop section in receipt.sections {
        if section.name == name -> return Ok(Val(section))
    }
    Ok(None)
}

// Rust bounded_redact_bytes/replace_bytes: byte-preserving, non-overlapping
// replacements, including non-UTF8 command output, before its digest is made.
fn jet_cli_receipt_redact_bytes(bytes: [U8], secret_values: [String]) -> [U8] JetCLIReadError! {
    if bytes.len() > JET_CLI_RECEIPT_MAX_FIELD {
        return Err(jet_cli_read_error("receipt output exceeds its size limit"))
    }
    redacted := bytes
    marker :: "<redacted>".bytes()
    loop secret in secret_values {
        needle :: secret.bytes()
        if needle.len() == 0 || needle.len() > redacted.len() -> next
        output := [U8]{}
        index := 0
        loop index <= redacted.len() - needle.len() {
            matches := true
            loop offset in 0..<needle.len() {
                if redacted[index + offset] != needle[offset] {
                    matches = false
                    break
                }
            }
            if matches {
                loop byte in marker -> &output.push(byte)
                index += needle.len()
            } else {
                &output.push(redacted[index])
                index += 1
            }
        }
        loop offset in index..<redacted.len() -> &output.push(redacted[offset])
        redacted = ^output
    }
    if redacted.len() > JET_CLI_RECEIPT_MAX_FIELD {
        return Err(jet_cli_read_error("redacted receipt output exceeds its size limit"))
    }
    Ok(redacted)
}

fn jet_cli_receipt_prepare(claim: JetCLIReceiptClaim, status: Int, stdout: [U8], stderr: [U8], sections: [JetCLIReceiptSection], consumed: [JetCLIRecordLink], produced: [JetCLIRecordLink], secret_values: [String]) -> JetCLIReceipt JetCLIReadError! {
    receipt := JetCLIReceipt{
        claim: claim,
        status: status,
        stdout: jet_cli_receipt_redact_bytes(stdout, secret_values),
        stderr: jet_cli_receipt_redact_bytes(stderr, secret_values),
        sections: jet_cli_receipt_normalized_sections(sections),
        consumed: jet_cli_receipt_normalized_links(consumed, "consumed"),
        produced: jet_cli_receipt_normalized_links(produced, "produced"),
        digest: "",
    }
    receipt.digest = jet_cli_receipt_digest(receipt)
    // The canonical codec also enforces the signed i32 exit-status domain and
    // claim field sizes; never return an object publication would refuse.
    _ :: jet_cli_receipt_encode(receipt)
    Ok(receipt)
}

fn jet_cli_receipt_observe_input(input: JetCLIReceiptInput) -[FS, Time.Wait]> JetCLIReceiptInput JetCLIReadError! {
    if !input.path.starts_with("/") -> return Err(jet_cli_read_error("receipt input path is not absolute: {input.path}"))
    parts := [String]{}
    loop part in input.path.split("/") {
        if part != "" && part != "." -> &parts.push(part)
    }
    name :: &parts.pop() ?? return Err(jet_cli_read_error("receipt input has no file name"))
    held :: JetCLIRootedDirectory.open("/", parts, false) ?? return Err(err)
    raw :: if held.read(name, Int.MAX) == {
        .Val(bytes) -> bytes
        .None -> { return Err(jet_cli_read_error("receipt input does not exist: {input.path}")) }
        .Err(error) -> { return Err(error) }
    }
    Ok(JetCLIReceiptInput{path: input.path, digest: receipt_crypto.sha256(raw).hex()})
}

fn jet_cli_receipt_inputs_current(inputs: [JetCLIReceiptInput]) -[FS, Time.Wait]> Bool Never! {
    loop input in inputs {
        observed :: jet_cli_receipt_observe_input(input) ?? return false
        if observed != input -> return false
    }
    true
}

fn jet_cli_receipt_read_section_records(project_root: String, claim_key: String, parent_digest: String, staged: Bool{false}) -[FS, Time.Wait]> [JetCLIReceiptSectionRecord] JetCLIReadError! {
    if !jet_cli_receipt_is_digest(claim_key) -> return Err(jet_cli_read_error("receipt section claim digest is malformed"))
    parts :: [String]{".jet", "receipts", if staged -> "staged" else -> "sections", claim_key}
    present :: JetCLIRootedDirectory.present(project_root, parts) ?? return Err(err)
    if !present -> return Ok([JetCLIReceiptSectionRecord]{})
    held :: JetCLIRootedDirectory.open(project_root, parts, false) ?? return Err(err)
    entries := held.list() ?? return Err(err)
    records := [JetCLIReceiptSectionRecord]{}
    loop entry in entries {
        if entry.name == "" || entry.name.starts_with(".") -> next
        shown :: jet_cli_rooted_join(held.path, entry.name)
        if !jet_cli_receipt_is_digest(entry.name) -> return Err(jet_cli_read_error("receipt section record has a non-digest name: {shown}"))
        if !entry.is_file -> return Err(jet_cli_read_error("receipt section record is not a regular file: {shown}"))
        raw :: if held.read(entry.name, JET_CLI_RECEIPT_SECTION_RECORD_MAX) == {
            .Val(bytes) -> bytes
            .None -> { return Err(jet_cli_read_error("receipt section record disappeared: {shown}")) }
            .Err(error) -> { return Err(error) }
        }
        record :: jet_cli_receipt_section_record_decode(raw)
        if jet_cli_receipt_section_record_identity(record) != entry.name -> return Err(jet_cli_read_error("receipt section record identity does not match its path: {shown}"))
        if record.claim_key != claim_key || record.parent_digest != parent_digest -> return Err(jet_cli_read_error("receipt section record belongs to a different receipt: {shown}"))
        &records.push(record)
        if records.len() > 256 -> return Err(jet_cli_read_error("receipt has too many sections (maximum 256)"))
    }
    Ok(records)
}

fn jet_cli_receipt_lookup(project_root: String, claim: JetCLIReceiptClaim) -[FS, Time.Wait]> JetCLIReceipt? JetCLIReadError! {
    if !jet_cli_receipt_is_digest(claim.key) || !jet_cli_receipt_inputs_current(claim.inputs) -> return Ok(None)
    parts :: [String]{".jet", "receipts", "objects"}
    present :: JetCLIRootedDirectory.present(project_root, parts) ?? return Err(err)
    if !present -> return Ok(None)
    held :: JetCLIRootedDirectory.open(project_root, parts, false) ?? return Err(err)
    raw :: if held.read(claim.key, JET_CLI_RECEIPT_MAX_BYTES) == {
        .Val(bytes) -> bytes
        .None -> { return Ok(None) }
        .Err(error) -> { return Err(error) }
    }
    receipt :: jet_cli_receipt_decode(raw) ?? return Ok(None)
    if receipt.claim != claim -> return Ok(None)
    records :: jet_cli_receipt_read_section_records(project_root, claim.key, receipt.digest)
    Ok(Val(jet_cli_receipt_merge_sections(^receipt, claim, records)))
}

// True is a new immutable object; false is an identical publication or a
// stale input closure. A different object under the same key is never replaced.
fn jet_cli_receipt_publish(project_root: String, receipt: JetCLIReceipt) -[FS, Env, Time.Wait]> Bool JetCLIReadError! {
    if !jet_cli_receipt_is_digest(receipt.claim.key) -> return Err(jet_cli_read_error("receipt claim key is not a lowercase SHA-256 digest"))
    bytes :: jet_cli_receipt_encode(receipt)
    if !jet_cli_receipt_inputs_current(receipt.claim.inputs) -> return Ok(false)
    held :: JetCLIRootedDirectory.open(project_root, [String]{".jet", "receipts", "objects"}, true) ?? return Err(err)
    Ok(held.publish_immutable(receipt.claim.key, bytes, None, JET_CLI_RECEIPT_MAX_BYTES) ?? return Err(err))
}

fn jet_cli_receipt_publish_section(project_root: String, record: JetCLIReceiptSectionRecord) -[FS, Env, Time.Wait]> Bool JetCLIReadError! {
    bytes :: jet_cli_receipt_section_record_encode(record)
    directory :: if record.parent_digest == "" -> "staged" else -> "sections"
    held :: JetCLIRootedDirectory.open(project_root, [String]{".jet", "receipts", directory, record.claim_key}, true) ?? return Err(err)
    id :: jet_cli_receipt_section_record_identity(record)
    Ok(held.publish_immutable(id, bytes, None, JET_CLI_RECEIPT_SECTION_RECORD_MAX) ?? return Err(err))
}

fn jet_cli_receipt_adopt_staged_sections(project_root: String, claim: JetCLIReceiptClaim) JetCLIReadError! -[FS, Env, Time.Wait]> {
    parent :: if jet_cli_receipt_lookup(project_root, claim) == {
        .Val(receipt) -> receipt
        .None -> { return Err(jet_cli_read_error("cannot adopt receipt sections before parent publication")) }
        .Err(error) -> { return Err(error) }
    }
    records :: jet_cli_receipt_read_section_records(project_root, claim.key, "", true)
    if records.len() == 0 -> return
    adopted := [JetCLIReceiptSectionRecord]{}
    loop record in records {
        published :: JetCLIReceiptSectionRecord{claim_key: claim.key, parent_digest: parent.digest, section: record.section}
        &adopted.push(published)
    }
    // Validate every conflict before publishing the first append-only record.
    checked_parent := parent
    _ :: jet_cli_receipt_merge_sections(^checked_parent, claim, adopted)
    held :: JetCLIRootedDirectory.open(project_root, [String]{".jet", "receipts", "staged", claim.key}, false) ?? return Err(err)
    loop (index, record) in adopted {
        _ :: jet_cli_receipt_publish_section(project_root, record)
        _ :: held.remove(jet_cli_receipt_section_record_identity(records[index])) ?? return Err(err)
    }
}

fn jet_cli_receipt_list(project_root: String) -[FS, Time.Wait]> [JetCLIReceipt] JetCLIReadError! {
    parts :: [String]{".jet", "receipts", "objects"}
    present :: JetCLIRootedDirectory.present(project_root, parts) ?? return Err(err)
    if !present -> return Ok([JetCLIReceipt]{})
    held :: JetCLIRootedDirectory.open(project_root, parts, false) ?? return Err(err)
    entries := held.list() ?? return Err(err)
    receipts := [JetCLIReceipt]{}
    loop entry in entries {
        if !entry.is_file || !jet_cli_receipt_is_digest(entry.name) -> next
        raw :: held.read(entry.name, JET_CLI_RECEIPT_MAX_BYTES) ?? next
        receipt :: jet_cli_receipt_decode(raw) ?? next
        if receipt.claim.key != entry.name -> next
        records :: jet_cli_receipt_read_section_records(project_root, entry.name, receipt.digest) ?? next
        key :: receipt.claim
        row :: jet_cli_receipt_merge_sections(^receipt, key, records) ?? next
        &receipts.push(row)
    }
    Ok(receipts)
}

fn jet_cli_receipt_list_current(project_root: String) -[FS, Time.Wait]> [JetCLIReceipt] JetCLIReadError! {
    receipts :: jet_cli_receipt_list(project_root)
    current := [JetCLIReceipt]{}
    loop receipt in receipts {
        if jet_cli_receipt_lookup(project_root, receipt.claim) == {
            .Val(fresh) -> &current.push(fresh)
            .None -> {}
            .Err(error) -> { return Err(error) }
        }
    }
    Ok(current)
}
