// `ICE`: Jet's own defect.
JET_CLI_EXIT_ICE: 101

// Rust host `render_internal_fault`.
jet_cli_ice: fn(what: String) -> JetDriverVerbOutput Never! {
    JetDriverVerbOutput{
        stdout: "",
        stderr: "internal compiler error: {what}\nThis is a bug in jet, NOT in your program. Please report it,\nattaching your source file.",
        exit_code: JET_CLI_EXIT_ICE,
    }
}

jet_cli_errors: fn(diagnostics: [Diagnostic]) -> [Diagnostic] Never! {
    errors := [Diagnostic]{}
    loop diagnostic in diagnostics {
        if diagnostic.severity == DIAGNOSTIC_ERROR -> errors.push(diagnostic.copy())
    }
    errors
}

// `jet check <file>`: compile through the Jet compiler, place each diagnostic
// on the file that owns it, and report the outcome the Rust host prints; `json`
// selects the machine outcome. An explicit file outside every project that
// imports `project.<module>` is E2393 before the compile. A `project` check
// (bare or directory) of a program, not a library, runs in Run mode, so an
// entry with no `run: fn` is E0101
// (`check_projection_with_options_and_preflight`). `verbose` on an
// explicit-file check adds the check's scope and proof rows on stdout
// (first-hour.md lesson 3). `finish` ends the process with the outcome once the
// compile ran, skipping the teardown of its result.
// `recording` publishes the outcome as the invocation's receipt before the
// process ends (CheckReceipt.jet). `profile` is the `--profile` the compile
// selects ("" for the default); the machine and verbose outcomes name it.
jet_cli_compile_check: fn(file: String, source: String, color: Bool, quiet: Bool, threads: Int?, project: Bool, json: Bool, verbose: Bool, settings: [BuildSettingOverride], profile: String, trace_sink: JetCLITraceSink?, finish: Bool, recording: JetCLICheckRecording?{None}) -> JetDriverVerbOutput {
    watch: cli_time.start()
    // copy: `profile` still selects the compile below.
    selected: if profile == "" -> JET_BUILD_DEFAULT_PROFILE else -> profile.copy()
    if !project {
        if jet_cli_missing_project_context(file, source) == .Val(missing) {
            if json -> return jet_cli_check_json_outcome(file, source, [Diagnostic]{missing}, watch.elapsed_millis(), selected)
            return JetDriverVerbOutput{stdout: "", stderr: jet_driver_report_problems(file, source, [Diagnostic]{missing}, color, true), exit_code: JET_DRIVER_EXIT_USER_ERROR}
        }
    }
    lacks_run: project && jet_cli_entry_lacks_callable(source, jet_cli_project_entry_callable(file))
    output := JetDriverVerbOutput{stdout: "", stderr: "", exit_code: JET_DRIVER_EXIT_OK}
    compiled: jet_cli_compile_entry(file, color, threads, JetDriverCompileMode.Check, None, trace_sink, settings, profile)
    if compiled == {
        .Refused(refusal) -> output = refusal.move()
        .Compiled(result, snapshot) -> {
            diagnostics := jet_driver_present_diagnostics(result.diagnostics, snapshot, result.generated_source_files)
            if lacks_run && !jet_cli_package_is_library_only(file, result) -> diagnostics.push(sema_no_run_diagnostic())
            if jet_cli_errors(diagnostics).len() == 0 && result.internal_problem == None && result.rust_foreign.entries.len() > 0 {
                if jet_cli_rust_foreign_check(result.rust_foreign, result.foreign_link) == .Err(error) -> diagnostics.push(jet_cli_rust_foreign_diagnostic(error))
            }
            output = if json -> jet_cli_check_json_outcome(file, source, diagnostics, watch.elapsed_millis(), selected) else -> jet_driver_check_outcome(file, source, diagnostics, color, quiet)
            if verbose && !project && !json && output.exit_code == JET_DRIVER_EXIT_OK -> output.stdout = jet_cli_inspect_check_text(file, watch.elapsed_millis(), diagnostics.len(), selected)
            // `emit_check_outcome`: a human check also prints each `#Todo` goal card (no candidates; `jet fill` checks those).
            if result.typed_goals && !json && !quiet && jet_cli_errors(diagnostics).len() == 0 && result.internal_problem == None {
                if jet_cli_check_goal_cards(file, color) == {
                    .Ok(cards) -> output.stdout = "{output.stdout}{cards}"
                    .Err(error) -> output = jet_cli_ice(error.message)
                }
            }
            if jet_cli_errors(diagnostics).len() == 0 {
                if result.internal_problem == .Val(problem) -> output = jet_cli_ice(problem)
            }
            if finish {
                if recording == .Val(claimed) && jet_cli_check_snapshot_inputs(snapshot) == .Val(sources) -> jet_cli_check_receipt_publish(claimed, output, sources)
                jet_cli_finish(output)
            }
        }
    }
    output
}

// `jet check --prelude <file>`: compile one Compiler/Prelude source as the
// compiler embeds it (Loader.jet jet_driver_parse_prelude_source) and report
// the outcome `jet check` does.
jet_cli_compile_prelude_check: fn(file: String, source: String, color: Bool, quiet: Bool, threads: Int?, json: Bool, trace_sink: JetCLITraceSink?) -> JetDriverVerbOutput {
    watch: cli_time.start()
    output := JetDriverVerbOutput{stdout: "", stderr: "", exit_code: JET_DRIVER_EXIT_OK}
    prepared: jet_cli_prepare_overlays(file, file, [JetCLIOverlay]{}, color, threads, JetDriverCompileMode.Check, true)
    compiled: jet_cli_compile_prepared(prepared, None, trace_sink, [BuildSettingOverride]{}, "", true)
    if compiled == {
        .Refused(refusal) -> output = refusal.move()
        .Compiled(result, snapshot) -> {
            diagnostics: jet_driver_present_diagnostics(result.diagnostics, snapshot, result.generated_source_files)
            output = if json -> jet_cli_check_json_outcome(file, source, diagnostics, watch.elapsed_millis(), JET_BUILD_DEFAULT_PROFILE) else -> jet_driver_check_outcome(file, source, diagnostics, color, quiet)
            if jet_cli_errors(diagnostics).len() == 0 {
                if result.internal_problem == .Val(problem) -> output = jet_cli_ice(problem)
            }
        }
    }
    output
}

// `jet check Core`: one Check compile of an entry that imports every public
// module of the Core library `core` (jet_cli_core_check_source), written to a
// scratch directory, with every declaration of each module loaded and every
// body checked whether a program calls it or not; reported as `jet check`
// reports `core`.
jet_cli_compile_core_check: fn(core: String, color: Bool, quiet: Bool, threads: Int?, json: Bool, trace_sink: JetCLITraceSink?) -> JetDriverVerbOutput {
    watch: cli_time.start()
    scratch: cli_files.temp_dir("jet-check-core") ?? return JetDriverVerbOutput{stdout: "", stderr: "jet check: couldn't create a scratch directory for the Core entry: {err}\n", exit_code: JET_DRIVER_EXIT_USER_ERROR}
    entry: "{scratch.path}/core.jet"
    source: jet_cli_core_check_source()
    cli_files.write(entry, source) ?? return JetDriverVerbOutput{stdout: "", stderr: "jet check: couldn't write the Core entry `{entry}`: {err}\n", exit_code: JET_DRIVER_EXIT_USER_ERROR}
    prepared := if jet_cli_prepare_snapshot(entry, entry, [JetCLIOverlay]{}, color, true) == {
        .Refused(refusal) -> JetCLIPrepared.Refused{output: refusal}
        .Held(snapshot) -> jet_cli_prepare_request(snapshot, color, threads, JetDriverCompileMode.Check, Val(core))
    }
    compiled: jet_cli_compile_prepared(prepared, None, trace_sink, [BuildSettingOverride]{}, "", false, true)
    output := JetDriverVerbOutput{stdout: "", stderr: "", exit_code: JET_DRIVER_EXIT_OK}
    if compiled == {
        .Refused(refusal) -> output = refusal.move()
        .Compiled(result, snapshot) -> {
            diagnostics: jet_driver_present_diagnostics(result.diagnostics, snapshot, result.generated_source_files)
            output = if json -> jet_cli_check_json_outcome(core, source, diagnostics, watch.elapsed_millis(), JET_BUILD_DEFAULT_PROFILE) else -> jet_driver_check_outcome(core, source, diagnostics, color, quiet)
            if jet_cli_errors(diagnostics).len() == 0 {
                if result.internal_problem == .Val(problem) -> output = jet_cli_ice(problem)
            }
        }
    }
    output
}

// `jet check` of a workspace root: each member no other member depends on
// checks in project scope; its compile loads every other member, and a
// failing member's errors are reported inline before its E0626. Each outcome
// is written as it finishes; the exit status is the most severe one.
jet_cli_check_workspace: fn(files: [String], sources: [String], color: Bool, quiet: Bool, threads: Int?, json: Bool, settings: [BuildSettingOverride], profile: String, trace_sink: JetCLITraceSink?) -> JetDriverVerbOutput {
    exit_code := JET_DRIVER_EXIT_OK
    loop index in 0..<files.len() {
        output: jet_cli_compile_check(files[index], sources[index], color, quiet, threads, true, json, false, settings, profile, trace_sink, false)
        jet_cli_write_output(output)
        if output.exit_code > exit_code -> exit_code = output.exit_code
    }
    JetDriverVerbOutput{stdout: "", stderr: "", exit_code: exit_code}
}

// One workspace member's `jet test`, as its child process ended.
JetCLITestMemberRun: struct {
    index: Int
    done: Bool
    code: Int
    output: String
    errors: String
}

// `jet test` in children (JetCLIPlan.TestWorkspace): each of `member_args`
// runs as a child `executable` ("" for this jet) with its `envs` row (none
// when `envs` is empty). A workspace root's members run as many at once as
// jet_cli_native_test_width allows (one per core, fewer while free memory
// can't hold JET_TEST_MEMBER_MEMORY for each); the runs of one package
// (each optimize level, another compiler) run one at a time, as each is a
// whole parallel test run. With `results` the runs' rows, each at its
// `tiers` entry, are one document (TestSettingLayers.jet
// jet_cli_test_runs_results_write). A run that hands its evidence to a
// parent (EVIDENCE_REPORT_ENV) hands it every child's records as one report
// (jet_cli_test_runs_report_write). The exit status is the most severe
// child's.
jet_cli_test_workspace: fn(names: [String], member_args: [[String]], envs: [[String]], executable: String, heading: String, results: String, tiers: [String], quiet: Bool) -> JetDriverVerbOutput {
    handoff: cli_sys.get(EVIDENCE_REPORT_ENV) ?? ""
    if results == "" && handoff == "" -> return jet_cli_test_workspace_run(names, member_args, envs, executable, heading, results, tiers, "", handoff, quiet)
    scratch: cli_files.temp_dir("jet-test-results") ?? return JetDriverVerbOutput{stdout: "", stderr: "jet test: couldn't create a scratch directory for the children's test evidence: {err}\n", exit_code: JET_DRIVER_EXIT_USER_ERROR}
    jet_cli_test_workspace_run(names, member_args, envs, executable, heading, results, tiers, scratch.path, handoff, quiet)
}

// jet_cli_test_workspace with `scratch` ("" without `results` or a
// `handoff` report) holding each child's evidence report.
jet_cli_test_workspace_run: fn(names: [String], member_args: [[String]], envs: [[String]], executable: String, heading: String, results: String, tiers: [String], scratch: String, handoff: String, quiet: Bool) -> JetDriverVerbOutput {
    // copy: the plan keeps its executable; each argv owns its program word.
    program: if executable == "" -> cli_sys.executable() else -> executable.copy()
    argvs := [[String]]{}
    loop args in member_args {
        argv := [String]{program.copy()} // copy: one program word per argv.
        loop argument in args -> argv.push(argument.copy()) // copy: the plan keeps its words.
        argvs.push(argv)
    }
    child_envs := jet_cli_test_runs_envs(envs, argvs.len(), scratch)
    // The handed-on report holds every child's records, so they share its id.
    if handoff != "" {
        report_id: cli_sys.get(EVIDENCE_REPORT_ID_ENV) ?? "test:runs:{cli_process.current_pid()}:{cli_time.unix_ns()}"
        loop index in 0..<child_envs.len() {
            child_envs[index].push(EVIDENCE_REPORT_ID_ENV)
            child_envs[index].push(report_id.copy())
        }
    }
    width: if heading == "member" -> jet_cli_native_test_width(cli_sys.cpu_count(), jet_cli_memory_available(), JET_TEST_MEMBER_MEMORY) else -> 1
    exit_code := JET_DRIVER_EXIT_OK
    loop run in jet_cli_test_members_run(heading, names, argvs, child_envs, width, quiet) {
        if run.code > exit_code -> exit_code = run.code
    }
    if scratch == "" -> return JetDriverVerbOutput{stdout: "", stderr: "", exit_code: exit_code}
    problems := ""
    if results != "" -> problems = jet_cli_test_runs_results_write(results, scratch, names, tiers, program)
    if handoff != "" -> problems = "{problems}{jet_cli_test_runs_report_write(handoff, scratch, names)}"
    if problems != "" && JET_DRIVER_EXIT_USER_ERROR > exit_code -> exit_code = JET_DRIVER_EXIT_USER_ERROR
    JetDriverVerbOutput{stdout: "", stderr: problems, exit_code: exit_code}
}

// Runs each argv as a child with its `envs` row of name, value pairs set, at
// most `width` at once, and writes each one's output whole (after a
// `jet test: <heading> <name>` header on stderr unless quiet) once it and
// every argv before it have finished, so the streams keep argv order whatever
// order the children end in. The runs come back in argv order.
jet_cli_test_members_run: fn(heading: String, names: [String], argvs: [[String]], envs: [[String]], width: Int, quiet: Bool) -> [JetCLITestMemberRun] {
    runs := [JetCLITestMemberRun]{}
    loop index in 0..<argvs.len() -> runs.push(JetCLITestMemberRun{index: index, done: false, code: 0, output: "", errors: ""})
    started := 0
    running := 0
    written := 0
    { sender: done, receiver: finished }: channel<JetCLITestMemberRun>()
    task.group members(limit: width) {
        loop written < runs.len() {
            if started < argvs.len() && running < width {
                task jet_cli_test_member_report(started, argvs[started], envs[started], done.copy())
                started += 1
                running += 1
                next
            }
            run := finished.receive() ?? break
            running -= 1
            runs[run.index] = run
            loop written < runs.len() && runs[written].done {
                if !quiet -> jet_cli_write_notice("jet test: {heading} `{names[written]}`\n")
                jet_cli_write_output(JetDriverVerbOutput{stdout: runs[written].output, stderr: runs[written].errors, exit_code: runs[written].code})
                written += 1
            }
        }
    }
    runs
}

// Runs one member's child in its own task, so a task that stops still
// reports its member, as a failure.
jet_cli_test_member_report: fn(index: Int, argv: [String], env: [String], done: Sender<JetCLITestMemberRun>) {
    member: task jet_cli_test_member(index, argv.copy(), env.copy())
    run := member.join() ?? JetCLITestMemberRun{index: index, done: true, code: JET_DRIVER_EXIT_USER_ERROR, output: "", errors: "jet test: the run of `{argv.join(" ")}` stopped before it reported\n"}
    done.send(run)
}

jet_cli_test_member: fn(index: Int, argv: [String], env: [String]) -> JetCLITestMemberRun {
    spec := cli_process.cmd(argv)
    loop pair in 0..<(env.len() /% 2) -> spec = spec.env(env[2 * pair], env[2 * pair + 1])
    receipt: spec.run() ?? return JetCLITestMemberRun{index: index, done: true, code: JET_DRIVER_EXIT_USER_ERROR, output: "", errors: "jet test: couldn't run `{argv.join(" ")}`: {err}\n"}
    code := receipt.code
    if !receipt.success && code <= 0 -> code = JET_DRIVER_EXIT_USER_ERROR
    JetCLITestMemberRun{index: index, done: true, code: code, output: receipt.output, errors: receipt.errors}
}

// `emit_check_outcome` under `--json`, on stdout: errors are one failed
// `diagnostics` status (exit 1); visible warnings alone are a passing one; a
// clean explicit-file check is one passing `check` status carrying the
// `jet.check/v1` fields, since every `--json` command answers with the
// `jet.status/v1` object. `profile` is the profile the check compiled under.
jet_cli_check_json_outcome: fn(file: String, source: String, diagnostics: [Diagnostic], elapsed_ms: Int, profile: String) -[FS, Env]> JetDriverVerbOutput Never! {
    base: jet_cli_report_base(file)
    errors: jet_cli_errors(diagnostics)
    if errors.len() > 0 {
        return JetDriverVerbOutput{stdout: jet_cli_reports_status_json("diagnostics", false, base, file, source, errors), stderr: "", exit_code: JET_DRIVER_EXIT_USER_ERROR}
    }
    lints := [Diagnostic]{}
    loop diagnostic in diagnostics {
        if !jet_driver_is_a11y_lint(diagnostic.code) -> lints.push(diagnostic.copy())
    }
    if lints.len() > 0 {
        return JetDriverVerbOutput{stdout: jet_cli_reports_status_json("diagnostics", true, base, file, source, lints), stderr: "", exit_code: JET_DRIVER_EXIT_OK}
    }
    JetDriverVerbOutput{stdout: "{jet_cli_status_render("check", true, jet_cli_check_result_fields(file, elapsed_ms, diagnostics.len(), profile))}\n", stderr: "", exit_code: JET_DRIVER_EXIT_OK}
}

// Resolution's stderr notices (a migrated retired entry, `--show-default`)
// go out before the compile, ahead of anything the built program writes.
jet_cli_write_notice: fn(notice: String) {
    if notice.len() == 0 -> return
    stderr_handle := cli_term.stderr()
    stderr_handle.write(notice).drop("jet stderr")
}

// `jet emit --<tier> <file>`. `--ast` parses the file (Emit.jet). `--ir`
// checks it as a run (an entry that selects nothing to start at is E0101);
// errors stop it with the problem count; visible lints (not a11y) go to
// stderr without a summary; it prints its EmitTree.
jet_cli_compile_emit: fn(file: String, source: String, color: Bool, json: Bool, tier: String, function: String?, trace_sink: JetCLITraceSink?) -> JetDriverVerbOutput {
    if tier == "ast" -> return jet_cli_emit_ast(file, source, color, json, function)
    output := JetDriverVerbOutput{stdout: "", stderr: "", exit_code: JET_DRIVER_EXIT_OK}
    compiled := jet_cli_compile_executable_file(file, None, color, None, build_options_stock("build"), trace_sink)
    if compiled.move() == {
        .Refused(refusal) -> output = refusal
        .Checked(result, inputs, snapshot) -> jet_cli_finish(jet_cli_emit_ir_result(file, source, color, json, function, result, inputs, snapshot))
    }
    output
}

// `jet eval <file>`: the entry checks for a native root run (Eval mode under
// `--pure`, where the driver adds the transitive E3401 purity walk from `run`)
// and stops before lowering; the checked program builds as slot IR from `run`,
// which runs natively at O0 in the compile's runtime child (not the generated
// entry, which drops a valued result). That child admits standard output, as
// a run does; any other ambient effect is refused (E3401). What the program
// printed is program output: before the value, or on stderr under `--json` so
// stdout stays one `eval` document.
jet_cli_compile_eval: fn(file: String, pure: Bool, color: Bool, json: Bool) -> JetDriverVerbOutput {
    source: cli_files.read(file) ?? return jet_cli_report_output("", "E2105", "couldn't read `{file}`: {jet_cli_io_error_text(err)}", jet_cli_why("E2105"), "correct the named problem, then run the command again", color, JET_DRIVER_EXIT_USER_ERROR)
    output := JetDriverVerbOutput{stdout: "", stderr: "", exit_code: JET_DRIVER_EXIT_OK}
    mode: if pure -> JetDriverCompileMode.Eval else -> JetDriverCompileMode.RootRun
    prepared: jet_cli_prepare_overlays(file, file, [JetCLIOverlay]{}, color, None, mode)
    compiled := jet_cli_compile_executable(prepared, None, build_options_stock("run"), None, None, color)
    if compiled.move() == {
        .Refused(refusal) -> output = refusal
        .Checked(result, inputs, snapshot) -> jet_cli_eval_result(file, source, color, json, result, inputs, snapshot)
    }
    output
}

// The checked inputs move into the IR build, so the process ends here with
// the output (jet_cli_finish).
jet_cli_eval_result: fn(file: String, source: String, color: Bool, json: Bool, result: JetDriverCompileResult, inputs: &&JetDriverLoweringInputs?, snapshot: JetDriverAuthorizedSourceSnapshot) -> Never {
    errors: jet_driver_present_diagnostics(jet_cli_errors(result.diagnostics), snapshot, result.generated_source_files)
    if errors.len() > 0 -> jet_cli_finish(JetDriverVerbOutput{stdout: "", stderr: diagnostic_render_all(file, source, errors, color), exit_code: JET_DRIVER_EXIT_USER_ERROR})
    if result.internal_problem == .Val(problem) -> jet_cli_finish(jet_cli_ice(problem))
    checked := inputs.move() ?? jet_cli_finish(jet_cli_ice("the Jet compiler finished `{file}` without its checked functions"))
    entry_key: checked.entry_key ?? jet_cli_finish(jet_cli_ice("the Jet compiler finished `{file}` without its `run` entry"))
    declarations := jet_driver_checked_declarations(checked)
    // copy: the builder consumes its own type rows; the evaluator reads the value back by them.
    layouts := ir_program_new([FnBody]{}, DeclTable{}, declarations.type_defs.copy(), [TImplDef]{}, [String:String]{}, [TConstantDef]{})
    // A failure the evaluator reports points at `run`.
    span := Span{start: 0, end: 0}
    loop function in checked.functions {
        if function.key == entry_key -> span = function.source_span
    }
    built := ir_build_program(checked.functions.move(), checked.decls, declarations.type_defs.move(), declarations.impls.move(), checked.sources.move(), declarations.constants.move(), declarations.foreign.move(), entry_key, ir_checks_stock(), result.compiler_threads)
    if built.failures.len() > 0 {
        census := [JetDriverIceRow]{}
        loop failure in built.failures -> jet_driver_ice_record(census, "{failure.name} [{failure.key}]", "ir.build", "unlowered", "{failure.message} at {failure.source_file}:{failure.span.start}..{failure.span.end}")
        jet_cli_finish(jet_cli_ice("the Jet evaluator failed on `{file}`: {jet_driver_ice_text(census)}"))
    }
    jet_plugin_link(built.program, jet_driver_entry_root_path(snapshot))
    entry: name_rows_value(built.program.function_rows, entry_key) ?? jet_cli_finish(jet_cli_ice("the slot IR of `{file}` has no `run` function"))
    config := jet_cli_eval_config()
    config.runtime_execution = true
    config.eval_entry = true
    program := jet_eval_native_load(JetEvalIRComptime{code: built.program.move(), layouts: shared [IRProgram]{layouts.move()}, items: [Int]{entry}, build_failures: [String]{}}, config)
    evaluated: jet_eval_native_run(program, 0, [TComptimeValue]{}, config, span)
    if evaluated.error == .Val(failure) {
        report: diagnostic_render_all(file, source, [Diagnostic]{failure.diagnostic}, color)
        jet_cli_finish(if json -> JetDriverVerbOutput{stdout: "", stderr: "{evaluated.stdout}{report}", exit_code: JET_DRIVER_EXIT_USER_ERROR} else -> JetDriverVerbOutput{stdout: evaluated.stdout, stderr: report, exit_code: JET_DRIVER_EXIT_USER_ERROR})
    }
    if evaluated.internal_problem == .Val(problem) -> jet_cli_finish(jet_cli_ice("the native run of `{file}` failed internally: {problem.message}"))
    // The program exited before `run` returned: what it printed, and its status.
    if evaluated.exit_code == .Val(code) -> jet_cli_finish(if json -> JetDriverVerbOutput{stdout: "", stderr: "{evaluated.stdout}{evaluated.stderr}", exit_code: code} else -> JetDriverVerbOutput{stdout: evaluated.stdout, stderr: evaluated.stderr, exit_code: code})
    data: evaluated.value ?? jet_cli_finish(jet_cli_ice("evaluating `run` in `{file}` produced no value"))
    value: sema_user_template_ct_value(data) ?? jet_cli_finish(jet_cli_ice("the value of `run` in `{file}` is not compile-time data"))
    if json {
        encoded: ast_comptime_value_json(value) ?? jet_cli_finish(jet_cli_eval_json_unsupported(err.byte_offset, err.path, err.reason, evaluated.stdout))
        rendered: jet_cli_status_value_parse(encoded) ?? jet_cli_finish(jet_cli_ice("the value of `run` in `{file}` has no JSON form"))
        jet_cli_finish(JetDriverVerbOutput{stdout: "{jet_cli_status_render("eval", true, [JetCLIStatusField]{jet_cli_status_field("value", rendered)})}\n", stderr: evaluated.stdout, exit_code: JET_DRIVER_EXIT_OK})
    }
    shown: jet_cli_eval_shown(value)
    line: if shown == .Val(text) -> "{text}\n" else -> ""
    jet_cli_finish(JetDriverVerbOutput{stdout: "{evaluated.stdout}{line}", stderr: "", exit_code: JET_DRIVER_EXIT_OK})
}

// `jet eval --json` when the value of `run` has no JSON encoding: the failed
// `eval` status on stdout, the program's own output on stderr.
jet_cli_eval_json_unsupported: fn(byte_offset: Int, path: String, reason: String, program_stdout: String) -> JetDriverVerbOutput Never! {
    failure: jet_cli_status_object([JetCLIStatusField]{
        jet_cli_status_field("format", jet_cli_status_text("JSON")),
        jet_cli_status_field("kind", jet_cli_status_text("Unsupported")),
        jet_cli_status_field("byte_offset", jet_cli_status_int(byte_offset)),
        jet_cli_status_field("line", JetCLIStatusValue.Null),
        jet_cli_status_field("column", JetCLIStatusValue.Null),
        jet_cli_status_field("path", jet_cli_status_text(path)),
        jet_cli_status_field("reason", jet_cli_status_text(reason)),
        jet_cli_status_field("cause", JetCLIStatusValue.Null),
    })
    rendered: jet_cli_status_render("eval", false, [JetCLIStatusField]{jet_cli_status_field("error", failure)})
    JetDriverVerbOutput{stdout: "{rendered}\n", stderr: program_stdout, exit_code: JET_DRIVER_EXIT_USER_ERROR}
}

// `render_eval_value`: a present value shows its inner value and Unit shows
// nothing.
jet_cli_eval_shown: fn(value: CtValue) -> String? Never! {
    if value == .Present(inner) -> return jet_cli_eval_shown(inner)
    if value == .Unit -> return None
    Val(ast_comptime_value_show(value))
}

// The entry's file name without `.jet`.
jet_cli_stem: fn(file: String) -> String Never! {
    parts := file.split("/").to_list()
    name: parts.pop() ?? file
    if name.ends_with(".jet") -> return name.slice(0..<(name.len() - 4))
    name
}

jet_cli_build_failed: fn(what: String, why: String, fix: String, color: Bool) -> JetDriverVerbOutput Never! {
    jet_cli_report_output("", "E2105", what, why, fix, color, JET_DRIVER_EXIT_USER_ERROR)
}
// The native runtime is checked and linked once when the toolchain is built
// (Compiler/build.jet), then shipped beside `jet` as jet-runtime/jet_runtime.pack.o.
// Both dev and release builds use the same pack and native linker.
JET_CLI_RUNTIME_PACK_FILE: "jet_runtime.pack.o"
// The Jet-only runtime object the pack was linked from, beside it. A program
// with a foreign closure links it with that closure's platform archives once.
JET_CLI_RUNTIME_OBJECT_FILE: "jet_runtime_jet.o"
// The pack prelinked at LINK_RUN_BASE (Image/RuntimePack.jet
// x64_link_runtime_image), beside it: `jet run` binds a program with no C
// closure to it instead of linking the pack, and compile-time code runs
// bound to it in the comptime child (JetEval Native.jet).
JET_CLI_RUNTIME_IMAGE_FILE: "jet_runtime.image"
// Written by the toolchain build: the native runtime's key for every profile.
JET_CLI_RUNTIME_KEY_FILE: "native.key"
// Written by the toolchain build beside the pack: every symbol the runtime exports, one
// per line, sorted (Request.jet).
JET_CLI_RUNTIME_EXPORTS_FILE: "runtime.exports"
// Written by the toolchain build beside the pack: the exports whose call can start a
// second thread, one per line, or `*` when every program can
// (Request.jet, JetIR BuildLibrary.jet ir_thread_exports).
JET_CLI_RUNTIME_THREADS_FILE: "runtime.threads"
// The C library functions a program's foreign calls may name and still run
// on one thread only (jet_cli_single_thread): leaves that start no thread,
// install no handler and call nothing back.
JET_CLI_SINGLE_THREAD_FOREIGN: [String]{"abs", "labs", "memchr", "memcmp", "memcpy", "memmove", "memset", "strchr", "strcmp", "strlen", "strncmp", "acos", "asin", "atan", "atan2", "cbrt", "ceil", "cos", "exp", "fabs", "floor", "fmod", "hypot", "log", "log10", "log2", "pow", "round", "sin", "sqrt", "tan", "trunc"}
// The runtime routes every program's `main` calls besides its IR (JetBackend
// Image/Object.jet x64_object_main).
JET_CLI_MAIN_ROUTES: [String]{"jet_rt_host_main_arguments", "jet_rt_host_program_start", "jet_rt_main", "jet_rt_main_owned_start", "jet_rt_thread_init", "jet_rt_stdout_flush"}
// In a package root, beside package.jet: the functions `jet build` lays out
// first, one name per line (jet_cli_hot_text).
JET_CLI_HOT_TEXT_FILE: "hot-text.list"

// jet-runtime/ beside the `jet` executable.
jet_cli_runtime_dir: fn() -[Env]> String Never! {
    parts := cli_sys.executable().split("/").to_list()
    _ := parts.pop()
    "{parts.join("/")}/jet-runtime"
}

// The runtime key the toolchain build recorded beside this compiler. Consumer
// source and build profile do not enter it; no toolchain probes are needed
// here. None when the file is missing, unreadable, or not one word.
jet_cli_runtime_key: fn(runtime_dir: String) -[FS]> String? Never! {
    text: cli_files.read("{runtime_dir}/{JET_CLI_RUNTIME_KEY_FILE}") ?? return None
    key: text.trim()
    if key.len() == 0 || key == "." || key == ".." || key.split("/").to_list().len() != 1 -> return None
    Val(key)
}

// `--checked-alloc` (the `checked_alloc` build option): only such a build
// links the runtime's checked heap and runs checked, and the option is part
// of every build key (build_options_key).
jet_cli_checked_alloc: fn(options: BuildOptions) -> Bool Never! {
    build_options_value(options, "checked_alloc") == "true"
}

// Why the one native executable route stopped; each caller reports it.
JetCLINativeFailure: enum {
    RustForeign(error: JetDriverRustForeignError)
    NoEntry
    // A compiler fault stopped the route before an image: the census holds
    // its rows (jet_cli_ice_census).
    Faulted
    // An executable write; `what` names the path and the cause.
    Write(what: String)
    RuntimeKey(what: String)
    Runtime(what: String)
    Foreign(message: String)
}

// The native route's result: the linked executable, else why not.
JetCLINativeLinked: enum {
    Image(executable: X64Executable)
    Failed(failure: JetCLINativeFailure)
}

// The ICE census row of a function the native route can't build (pass,
// rule, message), and that function's trap (jet_cli_ir_trap): selection still
// runs over the whole module, so every later phase reports too. A key with
// no function row still records its row, named by the key; a module row
// (key "") is named "-".
jet_cli_ice_trap: fn(census: &[JetDriverIceRow], program: &IRModule, key: String, pass: String, rule: String, message: String) Never! {
    if key == "" {
        jet_driver_ice_record(census, "-", pass, rule, message)
        return
    }
    id: name_rows_value(program.function_rows, key) ?? {
        jet_driver_ice_record(census, "[{key}]", pass, rule, message)
        return
    }
    jet_driver_ice_record(census, "{program.functions[id].name} [{key}]", pass, rule, message)
    jet_cli_ir_trap(program.functions[id])
}

// The ICE report of the native route's census: every row, exit 101. Under
// JET_KEEP_GOING the rows also go to JET_KEEP_GOING_REPORT after the front
// end's.
jet_cli_ice_census: fn(file: String, census: [JetDriverIceRow]) -[FS, Env]> JetDriverVerbOutput Never! {
    jet_cli_ice_report("the Jet backend failed on `{file}`", census)
}

// `summary` and every census row, exit 101 (the rows also reach
// JET_KEEP_GOING_REPORT under JET_KEEP_GOING).
jet_cli_ice_report: fn(summary: String, census: [JetDriverIceRow]) -[FS, Env]> JetDriverVerbOutput Never! {
    text: "{summary}: {jet_driver_ice_text(census)}"
    if !jet_cli_keep_going_enabled() -> return jet_cli_ice(text)
    rows: loop row in census -> jet_driver_ice_keep_going_row(row)
    problem: jet_cli_keep_going_append(rows)
    jet_cli_ice(if problem == "" -> text else -> "{text}\n{problem}")
}

// The one native executable route of `jet build`, `jet run` (every profile),
// `jet test` (`harness`: the selected tests and Check Outputs, built by
// ir_build_tests instead of the program's entry): build
// the slot IR of every checked function the entry reaches (Compiler/JetIR),
// select x86-64 for it into an in-memory object, realize the program's C closure
// (c@path archives, #FFI(c) inline bodies, a Rust foreign helper's archive,
// the musl platform), then use the in-process linker to bind the packaged
// runtime of `runtime_dir` into a static x86-64 executable image at `base`
// (LINK_BASE for a file, LINK_RUN_BASE for Image/Loader.jet; `executable_path`
// names it in link diagnostics; the one compiled runtime). Link inputs are always
// [object, runtime, C closure...]; a program with a C closure links the
// Jet-only runtime object instead of the pack. At LINK_RUN_BASE a program
// with no C closure is bound to the pack's prelinked runtime image instead
// (Image/MemoryLink.jet), without relinking the runtime; one the image
// can't bind links in full. A closure the `libs` or `link_args` build
// options or a Rust helper add reads only the checked foreign facts, so it
// is realized on a thread of its own (its C compiler children and archive
// digests, then the read of the runtime it selects) while this thread
// builds the object; its failures are reported after the object's, as when
// they came after it. A closure only checked foreign declarations name
// waits for the object: only the providers its live code references are
// realized, and with none the program links no C.
// A fault (a function the builder can't build, a runtime route the runtime
// does not export, a selection, object or link finding) is one ICE row of
// `census` (jet_cli_ice_trap); the faulty function becomes one trap, so
// selection still runs over the whole module and the route goes on while it
// still has object bytes, so each later phase reports too. `options` are the
// build options: the IR passes' optimization level (jet_cli_native_level) and
// the runtime checks the program keeps (jet_cli_ir_checks).
// JET_TRACE_FILE / `--trace`: the route's phases are spans of the compile's
// trace sink: `native.rust_foreign` (a Rust foreign helper's realization),
// `ir.build`, `ir.opt` (level > 0), `ir.x64` (on the threads the compile
// admits), `ir.object`, `native.foreign` (the wait for the C closure and the
// runtime's bytes once the object is built, and for a closure only checked
// foreign declarations name the live symbol collection and the providers'
// realization) and `native.link`.
// A span a failure returns from stays open. An image for LINK_RUN_BASE whose
// C closure can't link there (absolute 32-bit relocations in non-PIC C) is
// linked at LINK_RUN_LOW_BASE instead, below 2 GiB, where the loader still
// maps it into jet (Image/Loader.jet). `file` is the entry path the
// command named (jet_cli_debug_directory); `root` is its package root, where
// a literal plugin artifact path is read (jet_plugin_link). `hot`: the
// functions to lay out first (ir_x64_hot_order; jet_cli_hot_text).
// `split_debug`: the link puts the DWARF, `.symtab` and section headers in a
// side debug file the executable names by build id (`debug_info: split`
// under `jet build`).
jet_cli_native_executable: fn(result: JetDriverCompileResult, inputs: &&JetDriverLoweringInputs, harness: IRTestHarness?, sources: JetCLIForeignSources, options: BuildOptions, runtime_dir: String, executable_path: String, base: Int, census: &[JetDriverIceRow], file: String, root: String, hot: [String], split_debug: Bool) -[FS, Env, Exec, Time]> JetCLINativeLinked Never! {
    trace_sink: result.trace_sink
    checked := inputs.move()
    if harness == None && checked.entry_key == None -> return JetCLINativeLinked.Failed{failure: JetCLINativeFailure.NoEntry}
    if trace_sink == .Val(sink) -> sink.begin("native.rust_foreign", "", -1, -1)
    helper := JetCLIRustForeignArtifact?{None}
    if jet_cli_rust_foreign_realize(result.rust_foreign, result.foreign_link) == {
        .Ok(realized) -> helper = realized
        .Err(error) -> return JetCLINativeLinked.Failed{failure: JetCLINativeFailure.RustForeign{error: error}}
    }
    if trace_sink == .Val(sink) -> sink.end("native.rust_foreign", if helper == None -> 0 else -> 1)
    rust_helper: if helper == .Val(artifact) -> Val(jet_cli_rust_foreign_archive(artifact)) else -> None
    // The runtime's key and export list are read before either thread
    // starts: queued behind the closure thread's archive reads, these small
    // reads would stall the object between ir.build and ir.opt.
    runtime_exports: jet_cli_runtime_exports(runtime_dir)
    runtime_key: if runtime_exports.failure == None -> Val(runtime_exports.key.copy()) else -> None
    // The program object holds DWARF unless `debug_info: false`; the link
    // drops every other input's too (the runtime pack's, a C closure's).
    debug_info: build_options_value(options, "debug_info") != "false"
    objects := [JetCLINativeObject]{}
    closures := [JetCLIForeignRealized]{}
    // copy: the closure's thread owns its inputs; this function still reads them.
    foreign_link: result.foreign_link.copy()
    // A closure only the checked foreign declarations name (the C provider
    // of an imported module's declarations) is decided by the
    // program's live code: the link's own collection over the object and the
    // pack (x64_link_live_undefined) names the symbols live code references
    // and nothing defines, and only the providers of those declarations are
    // realized (jet_driver_foreign_link_live). With none, the program links
    // no C, needs no C tools and starts at `__jet_start`. Meanwhile the
    // closure thread reads the pack that collection needs.
    decided: rust_helper == None && sources.libs.len() == 0 && sources.link_args.len() == 0 && (jet_cli_native_c_linked(foreign_link) || foreign_link.inline_c.len() > 0)
    first_facts: if decided -> jet_driver_foreign_link_empty() else -> foreign_link.copy()
    task.group native_foreign {
        realizing: task jet_cli_native_foreign_realize(first_facts, rust_helper, sources.copy(), runtime_dir.copy(), runtime_key, base == LINK_RUN_BASE && !decided)
        object: jet_cli_native_object(result, checked, harness, options, runtime_exports, census, file, root, hot)
        if object.failure == None && trace_sink == .Val(sink) -> sink.begin("native.foreign", "", -1, -1)
        objects.push(object)
        closures.push(realizing.join() ?? panic(compiler_threads_failure_text(err)))
    }
    built := objects.pop() ?? panic("the native route lost its object")
    if built.failure == .Val(failure) -> return JetCLINativeLinked.Failed{failure: failure}
    realized := closures.pop() ?? panic("the native route lost its C closure")
    object := built.bytes.move()
    if decided {
        pack := realized.runtime.move() ?? return JetCLINativeLinked.Failed{failure: JetCLINativeFailure.Runtime{what: realized.runtime_error}}
        query := x64_link_live_undefined([String]{"{executable_path} (program object)", realized.runtime_path}, [[U8]]{object.move(), pack.move()})
        live := [String:Bool]{}
        loop symbol in query.symbols -> live[symbol.copy()] = true
        queried := query.bufs.move()
        pack = queried.pop() ?? panic("the live symbol query lost the runtime pack")
        object = queried.pop() ?? panic("the live symbol query lost the program object")
        kept: jet_driver_foreign_link_live(foreign_link, live)
        if jet_cli_native_c_linked(kept) || kept.inline_c.len() > 0 || base == LINK_RUN_BASE {
            // A live closure, or a program with none that binds to the
            // prelinked runtime image.
            realized = jet_cli_native_foreign_realize(kept, None, sources, runtime_dir, runtime_key, base == LINK_RUN_BASE)
        } else {
            realized.runtime = Val(pack.move())
        }
    }
    if trace_sink == .Val(sink) -> sink.end("native.foreign", if realized.inputs == .Val(found) -> found.names.len() else -> 0)
    closure: realized.inputs ?? return JetCLINativeLinked.Failed{failure: JetCLINativeFailure.Foreign{message: realized.error}}
    runtime := realized.runtime.move() ?? return JetCLINativeLinked.Failed{failure: JetCLINativeFailure.Runtime{what: realized.runtime_error}}
    runtime_path := realized.runtime_path
    if realized.bound {
        // A program with no C closure binds to the prelinked runtime image
        // (Image/MemoryLink.jet); one it can't bind (thread-local data,
        // init/fini arrays, an import the image lacks) links the pack in full.
        if trace_sink == .Val(sink) -> sink.begin("native.link", "", -1, -1)
        // copy: the full link needs the object again when the bind refuses it.
        bound := x64_bind_runtime_image(executable_path, object.copy(), runtime, runtime_path, realized.runtime_stamp, realized.runtime_gap_at, realized.runtime_gap, debug_info)
        if trace_sink == .Val(sink) -> sink.end("native.link", 2)
        if bound.errors.len() == 0 {
            if trace_sink == .Val(sink) -> sink.progress("counters.native.link.bytes", bound.executable.tail_at + bound.executable.tail.len(), -1)
            return JetCLINativeLinked.Image{executable: jet_cli_native_with_command(bound.executable, result.command_record)}
        }
        // The image moved into the bind; the full link reads the pack.
        runtime_path = "{runtime_dir}/{JET_CLI_RUNTIME_PACK_FILE}"
        runtime = cli_files.read_bytes(runtime_path) ?? return JetCLINativeLinked.Failed{failure: JetCLINativeFailure.Runtime{what: "couldn't read the Jet runtime {runtime_path}: {err}"}}
    }
    // Input names appear only in link diagnostics; the image is a function of
    // the bytes and their order. The object and runtime move in, uncopied; the
    // object never touches the disk.
    names := [String]{"{executable_path} (program object)", runtime_path}
    bytes := [[U8]]{object.move(), runtime.move()}
    loop name in closure.names -> names.push(name.copy())
    loop input in closure.bytes -> bytes.push(input.copy())
    input_count: names.len()
    // copy: only a C closure can refuse LINK_RUN_BASE, and the retry at LINK_RUN_LOW_BASE needs the inputs again.
    retry: if base != LINK_BASE && closure.names.len() > 0 -> Val(bytes.copy()) else -> None
    if trace_sink == .Val(sink) -> sink.begin("native.link", "", -1, -1)
    // The memory term is read now: the link's section pieces are new work.
    link_threads: CompilerThreads{cap: result.compiler_threads.cap, cores: result.compiler_threads.cores, memory_available: jet_cli_memory_available()}
    errors := [String]{}
    undefined := [String]{}
    executable := x64_executable_whole([U8]{})
    if split_debug {
        split := x64_link_executable_split(names, bytes, base, link_threads)
        errors = split.errors.copy()
        undefined = split.undefined.copy()
        executable = x64_executable_split(split)
    } else {
        image := x64_link_executable(names, bytes, base, link_threads, debug_info)
        if image.errors.len() > 0 && retry == .Val(inputs_again) -> image = x64_link_executable(names, inputs_again, LINK_RUN_LOW_BASE, link_threads, debug_info)
        errors = image.errors.copy()
        undefined = image.undefined.copy()
        executable = x64_executable_whole(image.bytes.move())
    }
    if trace_sink == .Val(sink) {
        sink.end("native.link", input_count)
        sink.progress("counters.native.link.bytes", executable.tail.len(), -1)
    }
    if errors.len() > 0 {
        if jet_cli_native_unprovided(foreign_link, undefined, errors) == .Val(message) -> return JetCLINativeLinked.Failed{failure: JetCLINativeFailure.Foreign{message: message}}
        loop error in errors -> jet_driver_ice_record(census, "-", "native.link", "link", error)
        return JetCLINativeLinked.Failed{failure: JetCLINativeFailure.Faulted}
    }
    JetCLINativeLinked.Image{executable: jet_cli_native_with_command(executable, result.command_record)}
}

// The report of a link that stopped only at C functions the program's
// foreign declarations name (`facts`) and no C input defines: the
// program's own error, reported as its C dependencies' (E2105), not a
// compiler fault. `undefined` and `errors` are the link's
// (X64ExecutableResult): each undefined symbol has its row, in the same
// order, so equal counts mean nothing else stopped the link. None when
// another finding did, or when no declaration names a symbol (the runtime
// or a C input of jet's own left it undefined).
jet_cli_native_unprovided: fn(facts: JetDriverForeignLinkFacts, undefined: [String], errors: [String]) -> String? Never! {
    if undefined.len() == 0 || undefined.len() != errors.len() -> return None
    reports := [String]{}
    loop (index, symbol) in undefined {
        declared := false
        loop declaration in facts.declarations {
            if !declared && declaration.symbol == symbol {
                reports.push("{errors[index]}: no C library the program links defines it, and the foreign function `{declaration.name}` names it")
                declared = true
            }
        }
        if !declared -> return None
    }
    Val(reports.join("; "))
}

// `executable` carrying the program's JetCommandSchema record in its
// `.jet_command` section (spec.md:4675), which `jet self completions --for`
// reads without running the program; a compile with no record adds none.
jet_cli_native_with_command: fn(executable: &&X64Executable, record: [U8]) -> X64Executable Never! {
    exe := executable.move()
    if record.len() > 0 -> x64_executable_add_section(exe, ELF_SECTION, record)
    exe
}

// Write the linked executable `executable` as the file `path`, and a split
// link's side debug file as `path`.debug. The image is written to a new file
// beside `path` and renamed over it: a program still running from the old
// file keeps that file busy (ETXTBSY), and the rename never opens it.
jet_cli_native_write: fn(path: String, executable: X64Executable) -[FS, Env]> JetCLINativeFailure? Never! {
    staged: "{path}.{cli_sys.pid()}.new"
    failure: x64_executable_write(executable, staged)
    if failure != "" {
        cli_files.remove(staged).drop("a partial image is never named `path`")
        return Val(JetCLINativeFailure.Write{what: "couldn't write {path}: {failure}"})
    }
    if cli_files.set_mode(staged, 0o755) == .Err(err) {
        cli_files.remove(staged).drop("a partial image is never named `path`")
        return Val(JetCLINativeFailure.Write{what: "couldn't make {path} executable: {err}"})
    }
    cli_files.rename(staged, path) ?? return Val(JetCLINativeFailure.Write{what: "couldn't write {path}: {err}"})
    if executable.debug_file.len() > 0 {
        cli_files.write_bytes("{path}.debug", executable.debug_file) ?? return Val(JetCLINativeFailure.Write{what: "couldn't write {path}.debug: {err}"})
    }
    None
}

// File a split link's side debug file in the package at `root`'s symbol
// store, `.jet/symbols/.build-id/<first two hex digits of the build
// id>/<the rest>.debug`, the layout debuggers and profilers search.
jet_cli_symbols_file: fn(root: String, executable: X64Executable) -[FS]> JetCLINativeFailure? Never! {
    if executable.build_id.len() == 0 -> return None
    id: sha256_hex_bytes(executable.build_id)
    dir: "{root}/.jet/symbols/.build-id/{id.slice(0, 2)}"
    cli_files.create_dir_all(dir) ?? return Val(JetCLINativeFailure.Write{what: "couldn't create the symbol store {dir}: {err}"})
    file: "{dir}/{id.slice(2, id.len())}.debug"
    cli_files.write_bytes(file, executable.debug_file) ?? return Val(JetCLINativeFailure.Write{what: "couldn't write {file}: {err}"})
    None
}

// The program's C closure as its own thread realized it
// (jet_cli_native_foreign_realize): the link inputs, else why it failed;
// then the runtime the link reads from `runtime_path` (the prelinked runtime
// image when `bound`, its file's identity `runtime_stamp` the same before and
// after the read, else empty, and without its bytes
// [runtime_gap_at, runtime_gap_at + runtime_gap), Image/Loader.jet
// x64_image_file_read; else the Jet-only object for a platform closure, else
// the pack), else why reading it failed.
JetCLIForeignRealized: struct {
    inputs: JetCLIForeignInputs?
    error: String
    runtime: [U8]?
    runtime_path: String
    runtime_stamp: [Int]
    runtime_gap_at: Int
    runtime_gap: Int
    runtime_error: String
    bound: Bool
}

// `runtime_key` is None when the object's route already fails on it: the
// runtime is then not read. The runtime is read only for a realized closure,
// as the link would read it.
// `bind`: a program with no closure at all binds to the pack's prelinked
// runtime image (Image/MemoryLink.jet), so only the image is read; a pack
// without one is read whole, as before.
jet_cli_native_foreign_realize: fn(facts: JetDriverForeignLinkFacts, rust_helper: String?, sources: JetCLIForeignSources, runtime_dir: String, runtime_key: String?, bind: Bool) -[FS, Env, Exec, Time.Wait]> JetCLIForeignRealized {
    realized := JetCLIForeignRealized{inputs: None, error: "", runtime: None, runtime_path: "", runtime_stamp: [Int]{}, runtime_gap_at: 0, runtime_gap: 0, runtime_error: "", bound: false}
    platform := false
    no_closure := false
    if jet_cli_native_c_inputs(facts, rust_helper, sources) == {
        .Ok(found) -> {
            platform = found.platform
            no_closure = found.names.len() == 0
            realized.inputs = Val(found)
        }
        .Err(error) -> {
            realized.error = error.message
            return realized
        }
    }
    if runtime_key == None -> return realized
    if bind && no_closure && !platform {
        image_path: "{runtime_dir}/{JET_CLI_RUNTIME_IMAGE_FILE}"
        // The loader maps the image part from this file when it is still
        // the one read here (Image/Loader.jet x64_executable_load).
        image := x64_image_file_read(image_path)
        if image.failure == "" {
            realized.runtime_gap_at = image.gap_at
            realized.runtime_gap = image.gap
            realized.runtime = Val(image.bytes.move())
            realized.runtime_stamp = image.stamp.move()
            realized.runtime_path = image_path
            realized.bound = true
            return realized
        }
    }
    runtime_file: if platform -> JET_CLI_RUNTIME_OBJECT_FILE else -> JET_CLI_RUNTIME_PACK_FILE
    realized.runtime_path = "{runtime_dir}/{runtime_file}"
    if cli_files.read_bytes(realized.runtime_path) == {
        .Ok(bytes) -> realized.runtime = Val(bytes)
        .Err(err) -> realized.runtime_error = "couldn't read the Jet runtime {realized.runtime_path}: {err}"
    }
    realized
}

// The runtime's key, its exports file's bytes (one exported symbol per
// line) and its thread receipt's (JET_CLI_RUNTIME_THREADS_FILE; None when
// it can't be read), else the failure jet_cli_native_object reports where
// it reads them.
JetCLIRuntimeExports: struct {
    key: String
    exports: [U8]
    threads: [U8]?
    failure: JetCLINativeFailure?
}

jet_cli_runtime_exports: fn(runtime_dir: String) -[FS]> JetCLIRuntimeExports Never! {
    key: jet_cli_runtime_key(runtime_dir) ?? return JetCLIRuntimeExports{key: "", exports: [U8]{}, threads: None, failure: Val(JetCLINativeFailure.RuntimeKey{what: "couldn't read the Jet runtime key {runtime_dir}/{JET_CLI_RUNTIME_KEY_FILE}"})}
    exports_path: "{runtime_dir}/{JET_CLI_RUNTIME_EXPORTS_FILE}"
    exports: cli_files.read_bytes(exports_path) ?? return JetCLIRuntimeExports{key: key, exports: [U8]{}, threads: None, failure: Val(JetCLINativeFailure.Runtime{what: "couldn't read the Jet runtime exports {exports_path}: {err}"})}
    threads: cli_files.read_bytes("{runtime_dir}/{JET_CLI_RUNTIME_THREADS_FILE}") ?? return JetCLIRuntimeExports{key: key, exports: exports, threads: None, failure: None}
    JetCLIRuntimeExports{key: key, exports: exports, threads: Val(threads), failure: None}
}

// Whether program `m` provably runs on one thread only, so x86-64 selection
// emits its RC updates without the lock prefix (IRModule.single_thread):
// the runtime's thread receipt was read and has no `*`, neither the program
// nor its `main` (JET_CLI_MAIN_ROUTES) calls a runtime export the receipt
// names, each foreign C call it makes (a symbol of `foreign`) is a
// JET_CLI_SINGLE_THREAD_FOREIGN leaf, and it has no foreign assembly (an
// `#FFI(asm)` leaf: the compiler's own leaves, a stop poll or a reduction,
// have no source file) and no plugin. Anything else keeps the locked forms.
jet_cli_single_thread: fn(m: IRModule, runtime: JetCLIRuntimeExports, foreign: [String:Bool]) -> Bool Never! {
    receipt: runtime.threads ?? return false
    called := [Bool]{}
    loop _ in 0..<m.names.len() -> called.push(false)
    loop f in m.functions {
        if (f.asm != None && f.source_file != "") || f.key.starts_with(IR_PLUGIN_GUEST_PREFIX) -> return false
        loop (at, op) in f.op {
            if op == .CallRuntime -> called[f.a[at]] = true
        }
    }
    starts := [String:Bool]{}
    starts["*"] = false
    loop route in JET_CLI_MAIN_ROUTES -> starts[route.copy()] = false
    loop (row, calls) in called {
        if !calls -> next
        name: m.names[row]
        if foreign.get(name) == None {
            starts[name.copy()] = false
        } else if !JET_CLI_SINGLE_THREAD_FOREIGN.contains(name) {
            return false
        }
    }
    jet_cli_runtime_exports_mark(receipt, starts)
    loop start in starts.values() {
        if start -> return false
    }
    true
}

// The program's object (jet_cli_native_executable), else why the route
// stopped before it.
JetCLINativeObject: struct {
    bytes: [U8]
    failure: JetCLINativeFailure?
}

jet_cli_native_object_failure: fn(failure: JetCLINativeFailure) -> JetCLINativeObject Never! {
    JetCLINativeObject{bytes: [U8]{}, failure: Val(failure)}
}

// Marks true each name in `wanted` that is a line of `bytes` (the runtime's
// exports file: thousands of names, one per line, sorted: Request.jet writes
// them so), comparing bytes in place: a binary search per name, then one
// walk over every line for the names it missed, so an unsorted file (a pack
// written before the sort) still answers right.
jet_cli_runtime_exports_mark: fn(bytes: [U8], wanted: &[String:Bool]) Never! {
    names := [String]{}
    rows := [[U8]]{}
    loop name in wanted.keys().to_list() {
        row: name.bytes()
        if {
            jet_cli_runtime_exports_search(bytes, row) -> wanted[name] = true
            else -> {
                names.push(name.copy())
                rows.push(row)
            }
        }
    }
    if rows.len() == 0 -> return
    start := 0
    loop start < bytes.len() {
        end := start
        loop end < bytes.len() && bytes[end] != (U8{10}) -> end += 1
        loop (k, row) in rows {
            if jet_cli_runtime_exports_compare(bytes, start, end, row) == 0 -> wanted[names[k]] = true
        }
        start = end + 1
    }
}

// Whether `row` is a line of the sorted `bytes`. Each probe takes the
// whole line around the midpoint of the lines left.
jet_cli_runtime_exports_search: fn(bytes: [U8], row: [U8]) -> Bool Never! {
    low := 0
    high := bytes.len()
    loop low < high {
        start := low + (high - low).div_euclid(2)
        loop start > low && bytes[start - 1] != (U8{10}) -> start -= 1
        end := start
        loop end < high && bytes[end] != (U8{10}) -> end += 1
        order: jet_cli_runtime_exports_compare(bytes, start, end, row)
        if order == 0 -> return true
        if order < 0 -> low = end + 1 else -> high = start
    }
    false
}

// The byte order of the line bytes[start..<end] against `row`: -1, 0 or 1.
jet_cli_runtime_exports_compare: fn(bytes: [U8], start: Int, end: Int, row: [U8]) -> Int Never! {
    at := 0
    loop start + at < end && at < row.len() {
        if bytes[start + at] != row[at] -> return if bytes[start + at] < row[at] -> -1 else -> 1
        at += 1
    }
    if {
        start + at < end -> 1
        at < row.len() -> -1
        else -> 0
    }
}

// The IR module of a native or web route: `ir.build` of every checked
// function the entry reaches (the selected tests under `harness`), the
// program's literal plugin artifacts, each runtime call the runtime must
// export, IR Lint and `ir.opt` at the options' level. Each fault is an ICE row
// of `census` and traps its function (jet_cli_ice_trap).
JetCLINativeProgram: struct {
    program: IRModule
    failure: JetCLINativeFailure?
}

jet_cli_native_program: fn(result: JetDriverCompileResult, inputs: &&JetDriverLoweringInputs, harness: IRTestHarness?, options: BuildOptions, runtime: JetCLIRuntimeExports, census: &[JetDriverIceRow], file: String, root: String) -[FS, Env, Time]> JetCLINativeProgram Never! {
    trace_sink: result.trace_sink
    level: jet_cli_native_level(options)
    checked := inputs.move()
    checks := jet_cli_ir_checks(result, checked, options)
    checks.checked_alloc = jet_cli_checked_alloc(options)
    checks.observe = options.observe
    checks.log_package = result.log_filter.copy()
    checks.log_flag = options.log.copy()
    declarations := jet_driver_checked_declarations(checked)
    // The program's C closure defines its foreign functions' symbols. An
    // `extern rust` function is called through the slot descriptor its helper
    // crate's archive defines (JetIR BuildForeign.jet ir_rust_foreign_call).
    closure_symbols := [String:Bool]{}
    loop row in declarations.foreign {
        closure_symbols[row.symbol.copy()] = true
        if row.language.starts_with("rust:") {
            closure_symbols["jet_ffi_{row.name}_cabi"] = true
            closure_symbols["jet_ffi_cabi_free"] = true
        }
    }
    entry_key: checked.entry_key ?? ""
    entry_source := ""
    loop function in checked.functions {
        if function.key == entry_key {
            entry_source = function.source_file.copy()
            break
        }
    }
    if trace_sink == .Val(sink) -> sink.begin("ir.build", "", -1, -1)
    built := if harness == .Val(plan) -> ir_build_tests(checked.functions.move(), checked.decls, declarations.type_defs.move(), declarations.impls.move(), checked.sources.move(), declarations.constants.move(), declarations.foreign.move(), plan, checks) else -> ir_build_program(checked.functions.move(), checked.decls, declarations.type_defs.move(), declarations.impls.move(), checked.sources.move(), declarations.constants.move(), declarations.foreign.move(), checked.entry_key ?? "", checks, result.compiler_threads)
    function_count: built.program.functions.len()
    if trace_sink == .Val(sink) -> sink.end("ir.build", function_count)
    loop failure in built.failures {
        message: "{failure.message} at {failure.source_file}:{failure.span.start}..{failure.span.end}"
        jet_cli_ice_trap(census, built.program, failure.key, "ir.build", "unlowered", message)
    }
    // Each literal plugin artifact becomes this program's own code (JetPlugin).
    jet_plugin_link(built.program, root)
    // A program whose stops need no process root owns its main (JetIR
    // EntryOwned.jet): its stop points go before Lint and the optimizer.
    if harness == None -> _ := ir_entry_own(built.program)
    // A runtime call the runtime does not export would fail the whole link;
    // its function fails here instead, like any construct the builder rejects.
    if runtime.failure == .Val(failure) -> return JetCLINativeProgram{program: ir_module_new(), failure: Val(failure)}
    // Each runtime call the C closure doesn't define, true once the runtime's
    // exports name it: one walk over the thousands of exports looks up only
    // the few names the program calls. The calls are read by name row, so
    // each called name is looked up once, not once per call.
    called := [Bool]{}
    loop _ in 0..<built.program.names.len() -> called.push(false)
    loop index in 0..<built.program.functions.len() {
        loop (at, op) in built.program.functions[index].op {
            if op == .CallRuntime -> called[built.program.functions[index].a[at]] = true
        }
    }
    exported := [String:Bool]{}
    loop (row, calls) in called {
        if calls && closure_symbols.get(built.program.names[row]) == None -> exported[built.program.names[row].copy()] = false
    }
    if exported.len() > 0 -> jet_cli_runtime_exports_mark(runtime.exports, exported)
    // Per name row: a runtime call of it fails its function.
    unexported := [Bool]{}
    loop (row, calls) in called -> unexported.push(calls && !(exported.get(built.program.names[row]) ?? true))
    loop index in 0..<built.program.functions.len() {
        missing := String?{None}
        loop (at, op) in built.program.functions[index].op {
            if op == .CallRuntime && unexported[built.program.functions[index].a[at]] {
                missing = Val(built.program.names[built.program.functions[index].a[at]].copy())
                break
            }
        }
        symbol: missing ?? next
        key: built.program.functions[index].key.copy()
        jet_cli_ice_trap(census, built.program, key, "ir.build", "runtime-route", "runtime route {symbol}: the Jet runtime {runtime.key} exports no `{symbol}`")
    }
    // The memory term is read now: the compile before this holds most of it.
    threads: CompilerThreads{cap: result.compiler_threads.cap, cores: result.compiler_threads.cores, memory_available: jet_cli_memory_available()}
    // At O0 only the inline Int facts run (Opt.jet ir_opt_module_facts).
    if trace_sink == .Val(sink) -> sink.begin("ir.opt", "", -1, -1)
    report: ir_optimize_module(built.program, jet_cli_opt_options(level, options), threads)
    // With JET_OPT_VERIFY, the lint of each body as the passes get it
    // (`ir.opt.prepare`) and after each pass (`ir.opt.<pass>`).
    loop finding in report.lint -> jet_cli_ice_trap(census, built.program, finding.key, finding.pass, finding.rule, finding.message)
    if trace_sink == .Val(sink) -> sink.end("ir.opt", function_count)
    // IR Lint (Lint.jet) runs once, over the module x86-64 selection reads:
    // the built module with its inline Int facts at O0, the optimized one at
    // O1 and O2. Each finding is an ICE row and traps its function.
    if trace_sink == .Val(sink) -> sink.begin("ir.lint", "", -1, -1)
    lint: ir_lint_module(built.program, if level > 0 -> "ir.opt" else -> "ir.build", threads)
    loop finding in lint -> jet_cli_ice_trap(census, built.program, finding.key, finding.pass, finding.rule, finding.message)
    if trace_sink == .Val(sink) -> sink.end("ir.lint", function_count)
    built.program.single_thread = jet_cli_single_thread(built.program, runtime, closure_symbols)
    built.program.debug_directory = jet_cli_debug_directory(file, entry_source, cli_files.cwd() ?? "")
    // A field move shares the module's rows with `built`, which would keep
    // them until the caller's object is written and free them all there; a
    // fresh module in its place leaves the route their one owner
    // (ir_x64_object frees them beside the object write).
    program := built.program.move()
    built.program = ir_module_new()
    JetCLINativeProgram{program: program.move(), failure: None}
}

// `ir.build`, `ir.opt` (jet_cli_native_program), `ir.x64` and `ir.object` of
// jet_cli_native_executable. The object lays out the functions `hot` names
// first (ir_x64_hot_order); `--trace` counts the names that name none
// (`ir.object.hot_missing`).
jet_cli_native_object: fn(result: JetDriverCompileResult, inputs: &&JetDriverLoweringInputs, harness: IRTestHarness?, options: BuildOptions, runtime: JetCLIRuntimeExports, census: &[JetDriverIceRow], file: String, root: String, hot: [String]) -[FS, Env, Time]> JetCLINativeObject Never! {
    trace_sink: result.trace_sink
    built := jet_cli_native_program(result, inputs, harness, options, runtime, census, file, root)
    if built.failure == .Val(failure) -> return jet_cli_native_object_failure(failure)
    program := built.program.move()
    built.program = ir_module_new()
    function_count: program.functions.len()
    threads: CompilerThreads{cap: result.compiler_threads.cap, cores: result.compiler_threads.cores, memory_available: jet_cli_memory_available()}
    if trace_sink == .Val(sink) -> sink.begin("ir.x64", "", -1, -1)
    compiled := ir_x64_compile_module(program, threads)
    if trace_sink == .Val(sink) -> sink.end("ir.x64", compiled.functions.len())
    // ir_x64_object hands a selection's findings back as its own: each is one row.
    selection_faulted: compiled.errors.len() > 0
    loop error in compiled.errors -> jet_driver_ice_record(census, "-", "ir.x64", "select", error)
    if trace_sink == .Val(sink) -> sink.begin("ir.object", "", -1, -1)
    hot_missing: ir_x64_hot_order(compiled, hot)
    object := ir_x64_object(compiled, build_options_value(options, "debug_info") != "false")
    if trace_sink == .Val(sink) {
        sink.end("ir.object", function_count)
        sink.progress("counters.ir.object.bytes", object.bytes.len(), -1)
        sink.progress("counters.ir.object.hot_missing", hot_missing, -1)
    }
    if !selection_faulted {
        loop error in object.errors -> jet_driver_ice_record(census, "-", "ir.object", "object", error)
    }
    if object.errors.len() > 0 && object.bytes.len() == 0 -> return jet_cli_native_object_failure(JetCLINativeFailure.Faulted)
    JetCLINativeObject{bytes: object.bytes.move(), failure: None}
}

// The compilation directory the image's DWARF records for `file`, the entry
// path the command named, whose module's source path is `source`: the part
// of `file` before `source`, relative to `cwd`, where the command ran, so a
// fault report run from there finds the source, and the image depends
// neither on where the checkout lives nor on whether the path was spelled
// absolute (a workspace member's entry always is). "" (the working
// directory) when `file` is `source` or does not end with it, when the
// directory is `cwd` itself, or when `cwd` is unknown.
jet_cli_debug_directory: fn(file: String, source: String, cwd: String) -> String Never! {
    if source == "" || file == source || !file.ends_with("/{source}") -> return ""
    directory: file.slice(0, file.len() - source.len() - 1)
    if !cli_files.is_absolute(directory) -> return directory
    if !cli_files.is_absolute(cwd) -> return ""
    relative: cli_files.relative(directory, cwd)
    if relative == "." -> "" else -> relative
}

// The body of a function the IR builder can't build: one Unreachable. Its
// slots and parameters stay, so its callers' calls still select.
jet_cli_ir_trap: fn(function: &IRFunction) Never! {
    function.op = [IROp]{IROp.Unreachable}
    function.dst = [Int]{-1}
    function.a = [Int]{-1}
    function.b = [Int]{-1}
    function.c = [Int]{-1}
    function.code_line = [Int]{0}
    function.args = [Int]{}
    function.open = [Int]{}
}

// `jet build`'s and `jet run`'s native route, at the command's level
// (jet_cli_native_level): the linked image (`binary` is where it goes), else
// the report. `jet run` links at LINK_RUN_BASE, where Image/Loader.jet maps
// it. Every compiler fault the route found is one ICE row, all reported at
// once with exit 101 (AGENTS.md I2; jet_cli_ice_census). Under JET_KEEP_GOING
// the rows also go to JET_KEEP_GOING_REPORT after the front end's, and the
// executable is still written while the route has object bytes (each faulty
// function traps).
jet_cli_build_native: fn(file: String, command: String, options: BuildOptions, result: JetDriverCompileResult, inputs: &&JetDriverLoweringInputs, snapshot: JetDriverAuthorizedSourceSnapshot, binary: String, color: Bool) -[FS, Env, Exec, Time]> JetCLIBuilt Never! {
    if result.trace_sink == .Val(sink) -> sink.begin("native.sources", "", -1, -1)
    sources: jet_cli_native_c_sources(snapshot, options) ?? return JetCLIBuilt.Failed{output: jet_cli_build_failed("couldn't realize C dependencies for `{file}`: {err.message}", jet_cli_why("E2105"), "check the declared C source/library paths and the installed C toolchain", color)}
    if result.trace_sink == .Val(sink) -> sink.end("native.sources", -1)
    census := [JetDriverIceRow]{}
    base: if command == "run" -> LINK_RUN_BASE else -> LINK_BASE
    hot: if command == "build" -> jet_cli_hot_text(snapshot.roots[0].canonical_path) else -> [String]{}
    // Only `jet build`'s image ships: the other commands run theirs, whose
    // fault reports name frames from the image's own location table.
    split_debug: command == "build" && build_options_value(options, "debug_info") == "split"
    linked := jet_cli_native_executable(result, inputs, None, sources, options, jet_cli_runtime_dir(), binary, base, census, file, jet_driver_entry_root_path(snapshot), hot, split_debug)
    if census.len() > 0 {
        // JET_KEEP_GOING still writes the image, each faulty function a trap.
        if jet_cli_keep_going_enabled() {
            if linked == .Image(executable) {
                if jet_cli_build_dir(jet_cli_parent(binary) ?? ".", color) == .Val(refused) -> return JetCLIBuilt.Failed{output: refused}
                written: jet_cli_native_write(binary, executable)
                if written == .Val(failure) -> return JetCLIBuilt.Failed{output: jet_cli_native_report(file, command, failure, color)}
            }
        }
        return JetCLIBuilt.Failed{output: jet_cli_ice_census(file, census)}
    }
    if linked.move() == {
        .Image(executable) -> JetCLIBuilt.Image{executable: executable.move(), path: binary}
        .Failed(failure) -> JetCLIBuilt.Failed{output: jet_cli_native_report(file, command, failure, color)}
    }
}

// The functions `jet build` lays out first in the package at `root`: the
// lines of its JET_CLI_HOT_TEXT_FILE in order, blank lines and `#` comments
// skipped; none when the package has no list. Compiler/JetCli's is written
// by Tools/perf/hot-text.mjs.
jet_cli_hot_text: fn(root: String) -[FS]> [String] Never! {
    text: cli_files.read("{root}/{JET_CLI_HOT_TEXT_FILE}") ?? return [String]{}
    names := [String]{}
    loop line in text.split("\n").to_list() {
        if line == "" || line.starts_with("#") -> next
        names.push(line)
    }
    names
}

// The report of why `jet {command} {file}`'s native route stopped.
jet_cli_native_report: fn(file: String, command: String, failure: JetCLINativeFailure, color: Bool) -> JetDriverVerbOutput Never! {
    if failure == {
        .RustForeign(error) -> JetDriverVerbOutput{stdout: "", stderr: jet_cli_rust_foreign_report(error, color), exit_code: JET_DRIVER_EXIT_USER_ERROR}
        .NoEntry -> JetDriverVerbOutput{stdout: "", stderr: jet_driver_report_problems(file, "", [Diagnostic]{sema_no_run_diagnostic()}, color, true), exit_code: JET_DRIVER_EXIT_USER_ERROR}
        // Every fault is a census row the caller reports first (jet_cli_ice_census).
        .Faulted -> jet_cli_ice("the native route of `jet {command} {file}` stopped on a fault it did not record")
        .Write(what) -> jet_cli_build_failed(what, jet_cli_why("E2105"), "check that the build directory is writable", color)
        .RuntimeKey(what) -> jet_cli_build_failed(what, jet_cli_why("E2105"), "build the toolchain with `jet build Compiler`, which puts the runtime key and pack beside jet", color)
        .Runtime(what) -> jet_cli_build_failed(what, jet_cli_why("E2105"), "build the toolchain with `jet build Compiler`, which puts the runtime pack and object beside jet", color)
        .Foreign(message) -> jet_cli_build_failed("couldn't realize C dependencies for `{file}`: {message}", jet_cli_why("E2105"), "check the declared C source/library paths and the installed C toolchain", color)
    }
}

// AGENTS.md I9: the backend level of the `optimize` build option: `none` is
// O0 (the stock value of run, dev and test), `basic` O1 (stock for build),
// `full` O2 (the stock `release` profile).
jet_cli_native_level: fn(options: BuildOptions) -> Int Never! {
    if build_options_value(options, "optimize") == {
        "full" -> 2
        "basic" -> 1
        else -> 0
    }
}

// The runtime checks the native build keeps: the `bounds` option's mode in
// the modules of the built package (the compile's package identity). Every
// other module, a dependency's or Core's, keeps the fatal check its writer
// built it with. `dead_code: keep` builds every function of those modules;
// `backtrace` goes to the runtime, and so does a counting `allocator:`
// policy of the entry package with its cap. The program's first word selects
// a job of the entry module: a bare, `.Dev` or `.Ship` job
// in a dev build, a `.Ship` job only in a `release` build. Any other first
// word is the unknown-job report (E1294), naming every declared job in a dev
// build and the shipped ones in a release build.
jet_cli_ir_checks: fn(result: JetDriverCompileResult, inputs: JetDriverLoweringInputs, options: BuildOptions) -> IRChecks Never! {
    bounds: build_options_value(options, "bounds")
    dead_code: build_options_value(options, "dead_code")
    modules := [String:Bool]{}
    if bounds != "fatal" || dead_code == "keep" {
        loop graph_module in inputs.modules {
            if graph_module.package_identity == result.package_identity -> modules[graph_module.module_identity.copy()] = true
        }
    }
    checks := ir_checks_of(bounds, build_options_value(options, "backtrace"), dead_code, modules)
    if result.allocator == .Counting(cap) -> checks.counting = Val(if cap == .Val(size) -> size.bytes else -> 0)
    // A release binary ships `#Job(.Ship)` jobs only: the others are not
    // declared to its unknown-job report, and a selectable one's word is
    // refused with the fix (IRJob stripped).
    release: options.profile == "release"
    loop job in inputs.jobs {
        stripped: release && !job.shipped
        if !stripped -> checks.declared_jobs.push(job.name.copy())
        if job.selectable {
            checks.jobs.push(IRJob{key: job.key.copy(), name: job.name.copy(), stripped: stripped})
        } else {
            checks.passthrough_jobs.push(job.name.copy())
        }
    }
    // A typed `run: fn(args: T)` starts at its generated CLI wrapper, which
    // parses argv itself: its words are no unknown jobs.
    if inputs.jobs.len() > 0 && inputs.entry_key == .Val(entry_key) {
        checks.unknown_jobs = true
        loop function in inputs.functions {
            if function.key == entry_key && function.name.starts_with(SEMA_CLI_ENTRY_NAME) -> checks.unknown_jobs = false
        }
    }
    checks
}

// A release binary exposes only `#Job(.Ship)` jobs, so a
// release build names the jobs it leaves out; a release can't silently lose
// a command its author expected to ship.
jet_cli_release_job_summary: fn(inputs: JetDriverLoweringInputs?, options: BuildOptions) -> String Never! {
    if options.profile != "release" -> return ""
    lowering: inputs ?? return ""
    stripped := [String]{}
    loop job in lowering.jobs {
        if !job.shipped -> stripped.push(job.name.copy())
    }
    if stripped.len() == 0 -> return ""
    "stripped {stripped.len()} dev job(s): {stripped.join(", ")} (mark #Job(.Ship) to include)\n"
}

// A resolved build option value that removes a runtime check
// (build_options_check_removals) is a `check_removal` gate of the package at
// `root`, and resolved `link_args` (build_options_link_override) its
// `link_override` gate; E3415 when its organization or
// package policy forbids one (pkg_check_project_gate, the writer every
// external gate shares).
jet_cli_build_option_gate_refusal: fn(root: String, options: BuildOptions, color: Bool) -[FS, Env]> JetDriverVerbOutput? Never! {
    loop choice in build_options_check_removals(options) {
        if jet_cli_build_option_policy(root, PolicyKey.CheckRemoval, choice, color) == .Val(refused) -> return Val(refused)
    }
    if build_options_link_override(options) == .Val(choice) -> return jet_cli_build_option_policy(root, PolicyKey.LinkOverride, choice, color)
    None
}

// The refusal of `choice`'s `key` gate, if its policy forbids it.
jet_cli_build_option_policy: fn(root: String, key: PolicyKey, choice: BuildOptionChoice, color: Bool) -[FS, Env]> JetDriverVerbOutput? Never! {
    // The registered row writes the site in backticks.
    written_site: choice.site.replace("`", "")
    site: if choice.layer == BuildOptionLayer.Flag -> "command line ({choice.written})" else -> "{choice.written} {written_site}"
    pkg_check_project_gate(root, key, site) ?? {
        return Val(JetDriverVerbOutput{stdout: "", stderr: jet_driver_report_problems("", "", err.diagnostics, color, true), exit_code: JET_DRIVER_EXIT_USER_ERROR})
    }
    None
}

JetCLIBuilt: enum {
    // The linked executable; `path` is its place in .jet/build (written
    // there by `jet build`; by `jet run` only to run it from a file).
    Image(executable: X64Executable, path: String)
    // The report that stopped the build.
    Failed(output: JetDriverVerbOutput)
}

// Build executable `name` for a compile with no errors, through the native
// route (one route at every profile), and write it to the output directory
// (jet_cli_output_dir_path) unless `command` is `run`, which runs the image
// from memory. `name` is the file stem, or a build target's name.
jet_cli_build_binary: fn(file: String, name: String, command: String, color: Bool, options: BuildOptions, result: JetDriverCompileResult, inputs: &&JetDriverLoweringInputs?, snapshot: JetDriverAuthorizedSourceSnapshot) -[Env, FS, Exec, Time]> JetCLIBuilt Never! {
    if result.internal_problem == .Val(problem) -> return JetCLIBuilt.Failed{output: jet_cli_ice(problem)}
    if !result.complete -> return JetCLIBuilt.Failed{output: jet_cli_ice("the Jet compiler stopped before finishing `{file}`")}
    if jet_cli_build_option_gate_refusal(snapshot.roots[0].canonical_path, options, color) == .Val(refused) -> return JetCLIBuilt.Failed{output: refused}
    checked := inputs.move() ?? return JetCLIBuilt.Failed{output: jet_cli_ice("the Jet compiler finished `{file}` without its checked functions")}
    build_dir: if command == "build" -> jet_cli_output_dir_path(snapshot, options) else -> jet_cli_build_dir_path(snapshot)
    binary: "{build_dir}/{name}"
    if command == "run" -> return jet_cli_build_native(file, command, options, result, checked, snapshot, binary, color)
    if jet_cli_build_dir(build_dir, color) == .Val(refused) -> return JetCLIBuilt.Failed{output: refused}
    built := jet_cli_build_native(file, command, options, result, checked, snapshot, binary, color)
    if built == .Image(executable, path) {
        if jet_cli_native_write(path, executable) == .Val(failure) -> return JetCLIBuilt.Failed{output: jet_cli_native_report(file, command, failure, color)}
        if jet_cli_symbols_file(snapshot.roots[0].canonical_path, executable) == .Val(failure) -> return JetCLIBuilt.Failed{output: jet_cli_native_report(file, command, failure, color)}
    }
    built
}

// The source root's `.jet/build` directory, where builds and runs that can't
// run from memory write their binaries.
jet_cli_build_dir_path: fn(snapshot: JetDriverAuthorizedSourceSnapshot) -> String Never! {
    "{snapshot.roots[0].canonical_path}/.jet/build"
}

// Where `jet build` writes its executables: the `output_dir` build option,
// under the source root unless it is absolute, or `.jet/build`.
jet_cli_output_dir_path: fn(snapshot: JetDriverAuthorizedSourceSnapshot, options: BuildOptions) -> String Never! {
    written: build_options_value(options, "output_dir")
    if written == "" -> return jet_cli_build_dir_path(snapshot)
    if written.starts_with("/") -> return written
    "{snapshot.roots[0].canonical_path}/{written}"
}

// Create the build directory, or the report of why it can't be.
jet_cli_build_dir: fn(build_dir: String, color: Bool) -[FS]> JetDriverVerbOutput? Never! {
    cli_files.create_dir_all(build_dir) ?? return Val(jet_cli_build_failed("couldn't create the build directory {build_dir}: {err}", jet_cli_why("E2105"), "check that the project directory is writable", color))
    None
}

// The application authority of a checked compile (jet_cli_application_authority),
// traced as `cli.authority`.
jet_cli_traced_authority: fn(invocation: JetCLIInvocationAuthority?, result: JetDriverCompileResult) -[FS, Env, Time]> JetCLIAuthority Never! {
    if result.trace_sink == .Val(sink) -> sink.begin("cli.authority", "", -1, -1)
    authority: jet_cli_application_authority(result, invocation)
    if result.trace_sink == .Val(sink) -> sink.end("cli.authority", authority.required.len())
    authority
}

// The E1803 report of `authority` (rendered as the Rust host reports it, exit
// 1), or None when it denies nothing the program requires (Authority.jet).
// `json` reports it as `jet run --json` reports its problems
// (jet_cli_run_problems).
jet_cli_authority_report: fn(file: String, source: String, color: Bool, json: Bool, authority: JetCLIAuthority) -[FS, Env]> JetDriverVerbOutput? Never! {
    refusal: jet_cli_authority_refusal(authority) ?? return None
    Val(JetDriverVerbOutput{stdout: "", stderr: jet_cli_run_problems(file, source, [Diagnostic]{refusal}, color, json), exit_code: JET_DRIVER_EXIT_USER_ERROR})
}

// The diagnostics jet_driver_report_problems shows (all but the advisory
// lints, unless `show_advisories`), presented. A presented diagnostic owns a
// copy of its file's bytes (its origin's `source`), so a report presents only
// what it shows: the self-hosted compiler unit is one 25 MB file with
// thousands of lints, whose presented copies came to ~130 GB.
jet_cli_present_shown: fn(result: JetDriverCompileResult, snapshot: JetDriverAuthorizedSourceSnapshot, show_advisories: Bool) -> [Diagnostic] Never! {
    shown := [Diagnostic]{}
    loop diagnostic in result.diagnostics {
        if show_advisories || diagnostic.severity != DIAGNOSTIC_LINT -> shown.push(diagnostic.copy())
    }
    jet_driver_present_diagnostics(shown, snapshot, result.generated_source_files)
}

// `jet build <file>`: compile through the Jet compiler, report its problems
// (under `json`, one failed `diagnostics` status on stderr), check the
// application authority, then write the executable (restored from the
// machine-wide store when unchanged, jet_cli_build_stored), or under `os: web`
// the web build (jet_cli_build_web). `sbom` (`--sbom`) also writes the SPDX
// document next to the executable (jet_cli_build_sbom). A human build ends
// with the one-line effect summary on stderr, which `quiet` leaves out; under
// `json` the same projection is the one `build.effects` status on stdout.
// `verbose` adds the store's `[build]` lines.
jet_cli_build_result: fn(file: String, name: String, source: String, color: Bool, options: BuildOptions, invocation: JetCLIInvocationAuthority?, json: Bool, sbom: Bool, quiet: Bool, verbose: Bool, result: JetDriverCompileResult, inputs: &&JetDriverLoweringInputs?, snapshot: JetDriverAuthorizedSourceSnapshot) -[Env, FS, Exec, Time, Rand]> JetDriverVerbOutput Never! {
    // Only the errors are presented (jet_cli_present_shown).
    if result.trace_sink == .Val(sink) -> sink.begin("cli.diagnostics", "", -1, -1)
    errors: jet_driver_present_diagnostics(jet_cli_errors(result.diagnostics), snapshot, result.generated_source_files)
    if result.trace_sink == .Val(sink) -> sink.end("cli.diagnostics", errors.len())
    if errors.len() > 0 {
        if json -> return JetDriverVerbOutput{stdout: "", stderr: jet_cli_reports_status_json("diagnostics", false, jet_cli_report_base(file), file, source, errors), exit_code: JET_DRIVER_EXIT_USER_ERROR}
        return JetDriverVerbOutput{stdout: "", stderr: jet_driver_report_problems(file, source, errors, color, true), exit_code: JET_DRIVER_EXIT_USER_ERROR}
    }
    authority: jet_cli_traced_authority(invocation, result)
    if jet_cli_authority_report(file, source, color, false, authority) == .Val(refusal) -> return refusal
    // A locked build refuses a widened dependency effect row before it writes
    // anything; a plain one records the rows once it has built.
    if options.locked {
        checked: jet_cli_lock_effect_rows(file, result, true, color, json)
        if checked.exit_code != JET_DRIVER_EXIT_OK -> return checked
    }
    summary: if json || quiet -> "" else -> "{jet_cli_effect_projection_line(jet_cli_effect_projection(authority))}\n"
    stripped_jobs: if json || quiet -> "" else -> jet_cli_release_job_summary(inputs, options)
    built := JetDriverVerbOutput{stdout: "", stderr: "", exit_code: JET_DRIVER_EXIT_OK}
    log := ""
    if build_options_value(options, "os") == "web" {
        built = jet_cli_build_web(file, color, options, result, inputs, snapshot)
    } else {
        if jet_cli_build_stored(file, name, color, options, result, inputs, snapshot, verbose) == {
            .Failed(failure) -> return failure
            .Written(path, lines, reused) -> {
                log = lines
                if sbom -> built = jet_cli_build_sbom(file, name, source, path, color, quiet)
                built.reused = reused
            }
        }
    }
    if built.exit_code == JET_DRIVER_EXIT_OK {
        rows: if options.locked -> JetDriverVerbOutput{stdout: "", stderr: "", exit_code: JET_DRIVER_EXIT_OK} else -> jet_cli_lock_effect_rows(file, result, false, color, json)
        if rows.exit_code != JET_DRIVER_EXIT_OK -> return rows
        if json {
            built.stdout = jet_cli_build_effects_json(authority)
        } else {
            built.stderr = "{log}{rows.stderr}{summary}{built.stderr}"
            built.stdout = "{stripped_jobs}{built.stdout}"
        }
    }
    built
}

// The `build.effects` status: `effects` repeats `required_effects` for
// readers of the effect list alone.
jet_cli_build_effects_json: fn(authority: JetCLIAuthority) -> String Never! {
    status: jet_cli_status_render("build.effects", true, [
        jet_cli_status_field("effects", jet_cli_status_texts(authority.required)), jet_cli_status_field("required_effects", jet_cli_status_texts(authority.required)),
        jet_cli_status_field("granted_effects", jet_cli_status_texts(authority.granted)), jet_cli_status_field("denied_effects", jet_cli_status_texts(authority.denied)),
        jet_cli_status_field("authority", jet_cli_status_text(authority.authority)),
    ])
    "{status}\n"
}

// `jet build --sbom`: the SPDX 2.3 document of the build's
// package and its locked dependencies (the project's `.jet/lock`; none for a
// loose file), written next to `binary` as `<name>.spdx`; `quiet` drops the
// `sbom: <path>` confirmation.
jet_cli_build_sbom: fn(file: String, name: String, source: String, binary: String, color: Bool, quiet: Bool) -[FS, Env]> JetDriverVerbOutput Never! {
    directory: jet_cli_parent(file) ?? "."
    project: jet_cli_manifest_root(directory) ?? directory
    loaded: publication_load_publish_lock(project) ? found -> found ! error -> return jet_cli_build_failed("couldn't read the lock of {project}: {error}", jet_cli_why("E2105"), "repair or regenerate `.jet/lock` with `jetpack lock`", color)
    lock: loaded ?? LockFile.empty()
    root: if jet_cli_file_manifest(file, source) == .Val(manifest) -> manifest.name else -> name
    build_dir: jet_cli_parent(binary) ?? "."
    path: "{build_dir}/{name}.spdx"
    cli_files.write(path, publication_emit_spdx(lock, root, "NOASSERTION")) ?? return jet_cli_build_failed("couldn't write the SBOM {path}: {err}", jet_cli_why("E2105"), "check that the build directory is writable", color)
    JetDriverVerbOutput{stdout: if quiet -> "" else -> "sbom: {path}\n", stderr: "", exit_code: JET_DRIVER_EXIT_OK}
}

// One build target of a package build: compile `file`, with the other
// sources the target lists (`sources`) and the modules the package's
// `build: fn` generated (`generated`) loaded beside its sources, into
// .jet/build/`name` and return, so the package build continues with its next
// target.
jet_cli_compile_target: fn(file: String, name: String, source: String, sources: [String], generated: [JetDriverGeneratedModule], color: Bool, options: BuildOptions, threads: Int?, invocation: JetCLIInvocationAuthority?, trace_sink: JetCLITraceSink?) -> JetDriverVerbOutput {
    if trace_sink == .Val(sink) -> sink.begin("sources", "", -1, -1)
    prepared: jet_cli_prepare_overlays(file, file, [JetCLIOverlay]{}, color, threads, JetDriverCompileMode.Program)
    if trace_sink == .Val(sink) -> sink.end("sources", jet_cli_prepared_file_count(prepared))
    if prepared.move() == {
        .Refused(refusal) -> refusal
        .Prepared(request, snapshot) -> {
            with_generated := request
            with_generated.generated_modules = generated
            with_generated.target_sources = sources
            compiled := jet_cli_compile_executable(JetCLIPrepared.Prepared{request: with_generated.move(), snapshot: snapshot}, None, options, None, trace_sink, color)
            if compiled.move() == {
                .Refused(refusal) -> refusal
                .Checked(result, inputs, checked_snapshot) -> jet_cli_build_result(file, name, source, color, options, invocation, false, false, false, false, result, inputs, checked_snapshot)
            }
        }
    }
}

jet_cli_compile_build: fn(file: String, source: String, color: Bool, options: BuildOptions, threads: Int?, invocation: JetCLIInvocationAuthority?, json: Bool, sbom: Bool, quiet: Bool, verbose: Bool, trace_sink: JetCLITraceSink?) -> JetDriverVerbOutput {
    members: jet_cli_build_workspace_members(file, color, options, threads, false, trace_sink)
    if members.exit_code != JET_DRIVER_EXIT_OK -> return members
    // A workspace index without its own `run: fn` is built once its members are.
    if jet_cli_top_level_function_lines(source, "run").len() == 0 && jet_cli_workspace_index_of(file, color) != None -> return members
    output := JetDriverVerbOutput{stdout: "", stderr: "", exit_code: JET_DRIVER_EXIT_OK}
    compiled := jet_cli_compile_executable_file(file, None, color, threads, options, trace_sink)
    if compiled.move() == {
        .Refused(refusal) -> output = refusal
        .Checked(result, inputs, snapshot) -> jet_cli_finish(jet_cli_build_result(file, jet_cli_stem(file), source, color, options, invocation, json, sbom, quiet, verbose, result, inputs, snapshot))
    }
    // Reached only by a refusal: a value-returning verb never ends in its
    // Never exit call.
    output
}

// The process's one exit: write a verb's output, then end the process with
// its status. `jet_cli_main` ends here, and so does every verb that holds a
// compile result (or a query that compiled), from inside the scope that owns
// it: the exit returns the whole program's memory at once, where drop glue
// would walk every IR row and fault every swapped-out page back in (minutes
// after the self-host unit's link). A verb with nothing compiled returns its
// output to `jet_cli_main` instead. Callers keep the shapes the seed backends
// lower: a value-returning function ends in a value, never in this call, and
// a `??` fallback calls it directly, not from a block of statements.
// A Jet defect (JET_CLI_EXIT_ICE, I2) ends through process.exit_unmapped
// with status 101 as it is: `process.exit` gives a program's 101 the
// user-error status 1, since no program may claim a Jet defect's status.
jet_cli_finish: fn(output: JetDriverVerbOutput) -> Never {
    jet_cli_write_output(output)
    if output.exit_code == JET_CLI_EXIT_ICE {
        #Unsafe("I2: jet alone among Jet programs ends a Jet defect with status 101, which process.exit maps to 1 for every program (S36), so its ICE exit takes the unmapped process exit") {
            cli_process.exit_unmapped(101)
        }
    }
    cli_process.exit(output.exit_code)
    // Unreachable: `exit` is `Never Never!`. Kept while a0_001 seeds the
    // round: its proof knows only direct `Never` calls, not module
    // calls (08fa56aaa). Remove once a seed carries 08fa56aaa.
    panic("the process outlived its exit")
}

// What a program `jet run` starts gets besides its image: argv[0] and
// `os.executable()` are the absolute path of `file`, then `program_args`;
// this process's environment with `vars` set over it (X64Launch.env None
// when there are none). A child started from it ends with jet (parent_death;
// jet runs this on its main thread).
// Launching its own path again runs it the way it runs now: this jet, this
// profile and build-option flags, this invocation's authority
// (`jet run [--profile=…] [--optimize=…] [--log=…] [--gate=…] [-A] [--allow=…] [--deny=…]`).
// A run confined by `--allow=FS.Read:<path>` (jet_cli_read_scope) reads
// only those paths, and JET_READ_SCOPE names them, so the runtime's refusal
// of any other read names the grant.
jet_cli_launch_plan: fn(file: String, program_args: [String], options: BuildOptions, invocation: JetCLIInvocationAuthority?, vars: [JetCLIEnvVar]) -> X64Launch {
    executable: cli_files.absolute(file) ?? file
    argv := [String]{executable}
    loop argument in program_args -> argv.push(argument.copy())
    relaunch := [String]{cli_sys.executable(), "run"}
    if options.profile != "" -> relaunch.push("--profile={options.profile}")
    loop choice in options.written {
        if choice.layer == BuildOptionLayer.Flag -> relaunch.push(choice.written)
    }
    loop setting in options.settings -> relaunch.push("--set={setting.name}={setting.value}")
    if options.observe -> relaunch.push("--observe")
    if options.log != "" -> relaunch.push("--log={options.log}")
    loop key in options.gates -> relaunch.push("--gate={policy_key_name(key)}=allow")
    if invocation == .Val(rows) {
        if rows.all -> relaunch.push("-A")
        if rows.allow.len() > 0 -> relaunch.push("--allow={rows.allow.join(",")}")
        if rows.deny.len() > 0 -> relaunch.push("--deny={rows.deny.join(",")}")
    }
    scope: jet_cli_read_scope(invocation)
    // copy: `vars` is the caller's; the launch's rows own their own.
    env_vars := vars.copy()
    if scope.len() > 0 -> env_vars.push(JetCLIEnvVar{name: "JET_READ_SCOPE", value: scope.join(", ")})
    X64Launch{argv: argv, env: jet_cli_launch_env(env_vars), executable: executable, name: jet_cli_stem(file), relaunch: relaunch, parent_death: true, read_scope: scope}
}

// The environment of an observed run (`jet run --observe`, `jet perf test`):
// JET_OBSERVE=1 and each of the five identity fields its runtime publishes
// under (ObserveLive.jet jet_rt_observe_runtime_start_from_env) that jet's
// own environment leaves unset: this run's session, `source`, and the
// `runtime` build and revision of the `game` world.
jet_cli_observe_env: fn(source: String) -> [JetCLIEnvVar] {
    vars := [JetCLIEnvVar]{JetCLIEnvVar{name: "JET_OBSERVE", value: "1"}}
    identity: [JetCLIEnvVar]{
        JetCLIEnvVar{name: "JET_DEVTOOLS_RELAY_SESSION_ID", value: "jet-observe-{cli_process.current_pid()}-{cli_time.unix_ns()}"},
        JetCLIEnvVar{name: "JET_DEVTOOLS_RELAY_SOURCE_ID", value: source},
        JetCLIEnvVar{name: "JET_DEVTOOLS_RELAY_BUILD_ID", value: "runtime"},
        JetCLIEnvVar{name: "JET_DEVTOOLS_RELAY_REVISION", value: "runtime"},
        JetCLIEnvVar{name: "JET_DEVTOOLS_RELAY_WORLD_ID", value: "game"},
    }
    loop field in identity {
        if (cli_sys.get(field.name) ?? "") == "" -> vars.push(field.copy())
    }
    vars
}

// JET_PERF_MAP=1 (Docs/spec/reference/environment.md): the program
// `executable` running from memory as `pid` gets a perf map, so `perf report`
// names its functions (Image/Loader.jet x64_image_perf_map). Unset, nothing
// is written. A spawned program also gets the map under jet's pid: jet mapped
// the image before the fork, and perf keys anonymous code by the pid that
// mapped it.
jet_cli_perf_map: fn(executable: X64Executable, pid: Int) {
    if (cli_sys.get("JET_PERF_MAP") ?? "") != "1" -> return
    jet: cli_process.current_pid()
    // copy: the map reads the whole file's bytes; the parts stay mapped.
    whole := executable.copy()
    complete: x64_executable_complete(whole)
    if complete != "" {
        cli_term.eprint("jet: no perf map for the program: {complete}")
        return
    }
    image: x64_executable_bytes(whole)
    failure := x64_image_perf_map(image, pid)
    if failure == "" && pid != jet -> failure = x64_image_perf_map(image, jet)
    if failure != "" -> cli_term.eprint("jet: no perf map for the program: {failure}")
}

// What a compiling verb's worker (jet_cli_compile_on_worker) hands the main
// thread: its output, or the program `jet run` linked, which runs on the main
// thread because only a single-threaded jet may run it in its own place
// (jet_cli_launch).
JetCLIRunStep: enum {
    Output(output: JetDriverVerbOutput)
    Launch(executable: X64Executable, file: String, binary: String, program_args: [String], options: BuildOptions, invocation: JetCLIInvocationAuthority?, verbose: Bool, color: Bool)
}

// Finish `step` on this thread: run its program (jet_cli_launch) with the
// environment that lets it write a production-failure receipt, and under
// `--observe` publish its run (jet_cli_observe_env), else return its output.
jet_cli_run_step: fn(step: &&JetCLIRunStep) -> JetDriverVerbOutput {
    if step.move() == {
        .Output(output) -> output
        .Launch(executable, file, binary, program_args, options, invocation, verbose, color) -> {
            vars := jet_cli_production_receipt_env(file, program_args)
            if options.observe {
                // copy: the observed run's fields join the receipt's.
                loop field in jet_cli_observe_env(file) -> vars.push(field.copy())
            }
            jet_cli_launch(executable, file, binary, program_args, options, invocation, vars, verbose, color)
        }
    }
}

// Run the linked program `executable` of `file` with `program_args`, and
// `vars` over this process's environment, on this process's stdin, stdout
// and stderr, as its built file would run, and end as
// it ends: in memory (Image/Loader.jet) in place of jet when jet is
// single-threaded, else in a child whose end jet mirrors (its exit code, or
// death by its signal). When the image can't run from memory (executable
// memory refused, its address range taken) it is written to the file
// `binary` and runs from there; `--verbose` says why. Returns only when jet
// must report or exit itself.
jet_cli_launch: fn(executable: X64Executable, file: String, binary: String, program_args: [String], options: BuildOptions, invocation: JetCLIInvocationAuthority?, vars: [JetCLIEnvVar], verbose: Bool, color: Bool) -> JetDriverVerbOutput {
    launch: jet_cli_launch_plan(file, program_args, options, invocation, vars)
    loaded: x64_executable_load(executable)
    reason := loaded.failure
    if reason == "" {
        // Joining the compile's scheduler threads leaves jet single-threaded,
        // so the program can take its place. The shutdown refuses while a
        // job or a timer is still pending, and a joined thread leaves
        // /proc/self/task a moment after its join returns (the kernel wakes
        // the joiner, then reaps the thread): both are waited out, every
        // 100 µs for up to 100 ms.
        joined := cli_tasks.quiesce()
        threads := x64_process_threads()
        waited := 0
        loop threads > 1 && waited < 1000 {
            x64_process_nap(100)
            if !joined -> joined = cli_tasks.quiesce()
            threads = x64_process_threads()
            waited += 1
        }
        if threads == 1 {
            jet_cli_perf_map(executable, cli_process.current_pid())
            reason = x64_image_exec(loaded, launch)
            x64_image_unload(loaded)
        } else {
            if verbose -> cli_term.eprint("jet run: running the program in a child process: {jet_cli_threads_reason(joined, threads)}")
            spawned: x64_image_spawn(loaded, launch, [Int]{})
            x64_image_unload(loaded)
            if spawned.failure == "" {
                jet_cli_perf_map(executable, spawned.pid)
                status: x64_process_wait_foreground(spawned.pid)
                if status < 0 -> return jet_cli_launch_failed("couldn't wait for the program (errno {-status})", color)
                return JetDriverVerbOutput{stdout: "", stderr: "", exit_code: x64_process_mirror(status)}
            }
            reason = spawned.failure
        }
    }
    if verbose -> cli_term.eprint("jet run: running {binary} from a file: {reason}")
    if jet_cli_build_dir(jet_cli_parent(binary) ?? ".", color) == .Val(refused) -> return refused
    if jet_cli_native_write(binary, executable) == .Val(failure) -> return jet_cli_native_report(file, "run", failure, color)
    jet_cli_launch_failed(x64_file_exec(binary, launch), color)
}

// Why jet is not single-threaded after tasks.quiesce returned `joined`
// (false: work or a timer was pending) and `threads` remain.
jet_cli_threads_reason: fn(joined: Bool, threads: Int) -> String {
    if threads < 0 -> return "/proc/self/task can't be read"
    if !joined -> return "the compile's scheduler still had a job or a timer pending"
    "{threads} threads still run after the compile's scheduler stopped"
}

jet_cli_launch_failed: fn(why: String, color: Bool) -> JetDriverVerbOutput Never! {
    jet_cli_report_output("", "E2105", "couldn't run the built program: {why}", jet_cli_why("E2105"), "correct the named problem, then run the command again", color, JET_DRIVER_EXIT_USER_ERROR)
}

// `jet run|build` of a C or C++ file (JetCLIPlan.NativeSource, #6686). The
// file compiles and links in one command of the C toolchain Jet programs
// compile their own C with (ForeignLink.jet jet_cli_native_c_tools, under the
// one native C policy), into `.jet/build/<stem>` under the nearest package
// root, else beside the file. The C driver compiles `.cc`, `.cpp` and `.cxx`
// as C++ and links no C++ standard library, as `jet c++` leaves it to a
// package dependency. The compiler's diagnostics reach stderr as it writes
// them, and a file it rejects exits 1. A run then runs the binary in place
// of jet with `program_args`, so jet ends as the program ends.
jet_cli_native_source: fn(file: String, level: Int, run: Bool, program_args: [String], color: Bool) -> JetDriverVerbOutput {
    path: cli_files.absolute(file) ?? file
    directory: jet_cli_parent(path) ?? "."
    build_dir: "{jet_cli_manifest_root(directory) ?? directory}/.jet/build"
    if jet_cli_build_dir(build_dir, color) == .Val(refused) -> return refused
    stem: jet_cli_native_source_stem(path)
    binary: "{build_dir}/{stem}"
    tools: jet_cli_native_c_tools() ?? return jet_cli_build_failed("couldn't find a C compiler for `{file}`: {err.message}", jet_cli_why("E2105"), "keep the `jetpack` this jet ships beside it, which provides jet's C toolchain pack, or name a C compiler with `CC`", color)
    argv := jet_cli_native_c_argv(tools)
    loop flag in tools.link_flags -> argv.push(flag.copy())
    loop word in ([String]{"-O{level}", file, "-o", binary}) -> argv.push(word)
    compiled: jet_cli_native_c_command(argv).stdout(.Inherit).stderr(.Inherit).run() ?? return jet_cli_build_failed("couldn't run the C compiler `{tools.compiler}`: {jet_cli_io_error_text(err)}", jet_cli_why("E2105"), "check the installed C toolchain", color)
    if !compiled.success -> return JetDriverVerbOutput{stdout: "", stderr: "", exit_code: JET_DRIVER_EXIT_USER_ERROR}
    if !run -> return JetDriverVerbOutput{stdout: "", stderr: "", exit_code: JET_DRIVER_EXIT_OK}
    argv_run := [String]{binary}
    loop argument in program_args -> argv_run.push(argument.copy())
    launch: X64Launch{argv: argv_run, env: None, executable: binary, name: stem, relaunch: [String]{}, parent_death: false, read_scope: [String]{}}
    jet_cli_launch_failed(x64_file_exec(binary, launch), color)
}

// The file name of `path` without its C or C++ extension: the binary's name.
jet_cli_native_source_stem: fn(path: String) -> String Never! {
    name: jet_cli_file_name(path)
    extension: jet_cli_source_extension(name)
    name.slice(0..<(name.len() - extension.len() - 1))
}

// Under `--verbose`, the advisory lints (not a11y) of a compile with no
// errors, written to stderr before the built program runs, so they precede
// its output on the shared streams.
jet_cli_write_verbose_lints: fn(file: String, source: String, color: Bool, json: Bool, diagnostics: [Diagnostic]) {
    lints := [Diagnostic]{}
    loop diagnostic in diagnostics {
        if diagnostic.severity == DIAGNOSTIC_LINT && !jet_driver_is_a11y_lint(diagnostic.code) -> lints.push(diagnostic.copy())
    }
    report: jet_cli_run_problems(file, source, lints, color, json)
    if report.len() > 0 {
        stderr_handle := cli_term.stderr()
        stderr_handle.write(report).drop("jet stderr")
    }
}

// The report of the problems a run shows, for stderr: the human report, or
// under `--json` the `diagnostics` status `jet check --json` prints (`ok`
// when none is an error), as the Rust host's `report_problems_with_summary`.
// Stdout stays the program's, and the report never chooses the exit code.
jet_cli_run_problems: fn(file: String, source: String, diagnostics: [Diagnostic], color: Bool, json: Bool) -[FS, Env]> String Never! {
    if !json -> return jet_driver_report_problems(file, source, diagnostics, color, true)
    if diagnostics.len() == 0 -> return ""
    jet_cli_reports_status_json("diagnostics", jet_cli_errors(diagnostics).len() == 0, jet_cli_report_base(file), file, source, diagnostics)
}

// A refused `jet run` names each file by its full path, not the root-relative
// display `jet check` uses, so the report reads the same from any directory.
jet_cli_full_path_origins: fn(diagnostics: &[Diagnostic]) Never! {
    loop index in 0..<diagnostics.len() {
        if diagnostics[index].origin == .Val(origin) -> diagnostics[index].origin = Val(DiagnosticOrigin{display: origin.path, path: origin.path, source: origin.source, revision: origin.revision})
    }
}

// `jet run <file>`'s build, as `jet build` does: problems with an error stop
// it, and so does a denied effect (E1803); `run` hides advisory lints unless
// `--verbose`, and `json` reports what it shows as JSON
// (jet_cli_run_problems). Every other effect is allowed, and the run names
// the ones nobody acknowledged (EffectNotice.jet). A `--verbose` run says on
// one stderr line which effects the program uses (the checked entry's,
// `entry_effects`). The image is linked to run from memory.
jet_cli_run_build: fn(file: String, source: String, color: Bool, options: BuildOptions, verbose: Bool, json: Bool, invocation: JetCLIInvocationAuthority?, result: JetDriverCompileResult, inputs: &&JetDriverLoweringInputs?, snapshot: JetDriverAuthorizedSourceSnapshot) -> JetCLIBuilt {
    if result.trace_sink == .Val(sink) -> sink.begin("cli.diagnostics", "", -1, -1)
    errors: jet_cli_errors(result.diagnostics)
    if result.trace_sink == .Val(sink) -> sink.end("cli.diagnostics", errors.len())
    if errors.len() > 0 {
        presented := jet_cli_present_shown(result, snapshot, verbose)
        if !json -> jet_cli_full_path_origins(presented)
        return JetCLIBuilt.Failed{output: JetDriverVerbOutput{stdout: "", stderr: jet_cli_run_problems(file, source, presented, color, json), exit_code: JET_DRIVER_EXIT_USER_ERROR}}
    }
    authority: jet_cli_traced_authority(invocation, result)
    if jet_cli_authority_report(file, source, color, json, authority) == .Val(refusal) -> return JetCLIBuilt.Failed{output: refusal}
    stopped: jet_cli_effect_notice(file, source, authority, invocation, color, json)
    if stopped.move() == .Val(output) -> return JetCLIBuilt.Failed{output: output}
    rows: jet_cli_lock_effect_rows(file, result, options.locked, color, json)
    if rows.exit_code != JET_DRIVER_EXIT_OK -> return JetCLIBuilt.Failed{output: rows}
    jet_cli_write_notice(rows.stderr)
    if verbose -> jet_cli_write_verbose_lints(file, source, color, json, jet_cli_present_shown(result, snapshot, true))
    if verbose && !json {
        used: jet_cli_sorted_set(result.entry_effects)
        listed: if used.len() == 0 -> "none" else -> used.join(", ")
        cli_term.eprint("jet run: effects used: {listed}")
    }
    jet_cli_build_binary(file, jet_cli_stem(file), "run", color, options, result, inputs, snapshot)
}

// `jet run <file>`: build it (jet_cli_run_build), then hand its program to
// the main thread (jet_cli_run_step).
jet_cli_run_result: fn(file: String, source: String, color: Bool, options: BuildOptions, verbose: Bool, json: Bool, program_args: [String], invocation: JetCLIInvocationAuthority?, result: JetDriverCompileResult, inputs: &&JetDriverLoweringInputs?, snapshot: JetDriverAuthorizedSourceSnapshot) -> JetCLIRunStep {
    built := jet_cli_run_build(file, source, color, options, verbose, json, invocation, result, inputs, snapshot)
    if built.move() == {
        .Failed(failure) -> JetCLIRunStep.Output{output: failure}
        .Image(executable, path) -> JetCLIRunStep.Launch{executable: executable.move(), file: file, binary: path, program_args: program_args, options: options, invocation: invocation, verbose: verbose, color: color}
    }
}

jet_cli_compile_run: fn(file: String, entry: String?, source: String, color: Bool, options: BuildOptions, verbose: Bool, json: Bool, threads: Int?, program_args: [String], invocation: JetCLIInvocationAuthority?, trace_sink: JetCLITraceSink?) -> JetCLIRunStep {
    // A loose script's first run fetches and locks its inline dependencies.
    if jet_cli_script_dependency_fetch(file, source, color, json) == .Val(refused) -> return JetCLIRunStep.Output{output: refused}
    // A traced or verbose run reports its compile, so only a plain run may
    // reuse a kept program; one starting at a command function is never kept.
    if !verbose && trace_sink == None && entry == None -> return jet_cli_compile_kept(file, source, color, json, options, threads, program_args, invocation)
    step := JetCLIRunStep.Output{output: JetDriverVerbOutput{stdout: "", stderr: "", exit_code: JET_DRIVER_EXIT_OK}}
    compiled := jet_cli_compile_executable_file(file, entry, color, threads, options, trace_sink)
    if compiled.move() == {
        .Refused(refusal) -> step = JetCLIRunStep.Output{output: refusal}
        .Checked(result, inputs, snapshot) -> step = jet_cli_run_settled(jet_cli_run_result(file, source, color, options, verbose, json, program_args, invocation, result, inputs, snapshot))
    }
    step
}

// A compiled run's step. A build that stopped ends the process here, inside
// the scope that owns the compile (jet_cli_finish); a linked program goes on
// to the main thread.
jet_cli_run_settled: fn(step: &&JetCLIRunStep) -> JetCLIRunStep {
    if step == .Output(output) -> jet_cli_finish(output)
    step
}

// A plain `jet run`: run the program kept for exactly these inputs, or
// compile it, keep it, and run it (ScriptCache.jet).
jet_cli_compile_kept: fn(file: String, source: String, color: Bool, json: Bool, options: BuildOptions, threads: Int?, program_args: [String], invocation: JetCLIInvocationAuthority?) -> JetCLIRunStep {
    if cli_sys.get(JET_CLI_SCRIPT_PROMOTE_ENV) != None -> return jet_cli_compile_promoted(file, source, json, options, threads, invocation)
    step := JetCLIRunStep.Output{output: JetDriverVerbOutput{stdout: "", stderr: "", exit_code: JET_DRIVER_EXIT_OK}}
    held: jet_cli_prepare_snapshot(file, file, [JetCLIOverlay]{}, color)
    keep: if held == .Held(snapshot) -> jet_cli_script_keeper(file, options, snapshot) else -> None
    if keep == .Val(kept) {
        if held == .Held(snapshot) {
            binary: "{jet_cli_build_dir_path(snapshot)}/{jet_cli_stem(file)}"
            if jet_cli_script_kept_run(kept, file, source, binary, color, json, options, program_args, invocation) == .Val(ran) -> return ran
        }
    }
    prepared: if held.move() == {
        .Held(snapshot) -> jet_cli_prepare_request(snapshot, color, threads, JetDriverCompileMode.Program)
        .Refused(refusal) -> JetCLIPrepared.Refused{output: refusal}
    }
    kept_core: jet_cli_script_with_core(keep, prepared)
    compiled := jet_cli_compile_executable(prepared, None, options, jet_cli_script_input_log(kept_core), None, color)
    if compiled.move() == {
        .Refused(refusal) -> step = JetCLIRunStep.Output{output: refusal}
        .Checked(result, inputs, snapshot) -> step = jet_cli_run_settled(jet_cli_script_build_and_run(file, source, color, json, options, program_args, invocation, result, inputs, snapshot, kept_core))
    }
    step
}

// Build a compiled `jet run` file, keep the program under `keep`
// (ScriptCache.jet), then hand it to the main thread.
jet_cli_script_build_and_run: fn(file: String, source: String, color: Bool, json: Bool, options: BuildOptions, program_args: [String], invocation: JetCLIInvocationAuthority?, result: JetDriverCompileResult, inputs: &&JetDriverLoweringInputs?, snapshot: JetDriverAuthorizedSourceSnapshot, keep: JetCLIScriptKeep?) -> JetCLIRunStep {
    // The kept program's authority is the compile's own.
    authority: jet_cli_application_authority(result, None)
    built := jet_cli_run_build(file, source, color, options, false, json, invocation, result, inputs, snapshot)
    if built.move() == {
        .Failed(failure) -> JetCLIRunStep.Output{output: failure}
        .Image(executable, path) -> jet_cli_script_launch(keep, authority, executable, file, path, program_args, options, invocation, color)
    }
}

jet_cli_script_launch: fn(keep: JetCLIScriptKeep?, authority: JetCLIAuthority, executable: &&X64Executable, file: String, binary: String, program_args: [String], options: BuildOptions, invocation: JetCLIInvocationAuthority?, color: Bool) -> JetCLIRunStep {
    if keep == .Val(kept) {
        _: jet_cli_script_keep(kept, executable, authority, build_options_value(options, "optimize"))
    }
    JetCLIRunStep.Launch{executable: executable.move(), file: file, binary: binary, program_args: program_args, options: options, invocation: invocation, verbose: false, color: color}
}

// The background `full` build a reused `none` program started
// (ScriptCache.jet jet_cli_script_promote): compile `file` as its plain run
// did, with every option of that run (`--observe` and `--log` among them)
// but the optimize level `full`, keep the program in that run's slot, and
// end without running it or printing anything. Its threads run at the
// lowest CPU priority.
jet_cli_compile_promoted: fn(file: String, source: String, json: Bool, options: BuildOptions, threads: Int?, invocation: JetCLIInvocationAuthority?) -> JetCLIRunStep {
    jet_cli_script_lower_priority()
    held: jet_cli_prepare_snapshot(file, file, [JetCLIOverlay]{}, false)
    keep: if held == .Held(snapshot) -> jet_cli_script_keeper(file, options, snapshot) else -> None
    if keep == .Val(kept) {
        lock: jet_cli_script_promotion(kept) ?? return jet_cli_promoted_end()
        full: jet_cli_build_options_set(options, "optimize", JET_CLI_SCRIPT_LEVEL_FULL)
        prepared: if held.move() == {
            .Held(snapshot) -> jet_cli_prepare_request(snapshot, false, threads, JetDriverCompileMode.Program)
            .Refused(refusal) -> JetCLIPrepared.Refused{output: refusal}
        }
        kept_core: jet_cli_script_with_core(keep, prepared) ?? return jet_cli_promoted_end()
        compiled := jet_cli_compile_executable(prepared, None, full, Val(kept_core.input_log.copy()), None, false)
        stored := false
        if compiled.move() == {
            .Refused(_) -> {}
            .Checked(result, inputs, snapshot) -> {
                authority: jet_cli_application_authority(result, None)
                built := jet_cli_run_build(file, source, false, full, false, json, invocation, result, inputs, snapshot)
                if built.move() == {
                    .Failed(_) -> {}
                    .Image(executable, _) -> stored = jet_cli_script_keep(kept_core, executable, authority, JET_CLI_SCRIPT_LEVEL_FULL)
                }
            }
        }
        jet_cli_script_promoted(lock, kept, stored)
    }
    jet_cli_promoted_end()
}

// A background build ends with success and no output, whatever it kept.
jet_cli_promoted_end: fn() -> JetCLIRunStep Never! {
    JetCLIRunStep.Output{output: JetDriverVerbOutput{stdout: "", stderr: "", exit_code: JET_DRIVER_EXIT_OK}}
}

// Put every thread of this process at the lowest CPU priority, so a
// background build takes only time no other program wants. Linux keeps the
// priority per thread, and a thread starts with its creator's, so the
// threads the compile starts later inherit it.
jet_cli_script_lower_priority: fn() {
    tasks: cli_files.list_dir("/proc/self/task") ?? return
    loop task in tasks {
        thread: Int.parse(task.name) ?? next
        #Unsafe("posix setpriority: the build lowers only its own threads, never raising one") {
            cli_sys.setpriority(thread, 19).drop("a thread left at its priority only finishes sooner")
        }
    }
}

jet_cli_native_test_unrun_check_report: fn() -> String Never! {
    row: diagnostic_registry_row("E3016") ?? panic("native output-check failure is registered")
    diagnostic: diagnostic_from_registry(row.code, None, row.what, row.why, row.fix)
    diagnostic_render_all("", "", [Diagnostic]{diagnostic}, false)
}

// `jet test <file>`: the driver's test plan (the checked tests and selected
// Check Outputs of `inputs`) built through the one native executable route
// as an IR test harness (JetIR BuildTests.jet), then run by the NativeTests
// module. ProcessSpec retains the project/snapshot/filter/shuffle/serial/capture
// policy; its stdout is ordinary output, never the framed outcome transport.
// `source` is the file as compiled, with the claims of its doctests appended;
// the outcomes of the claims of `doctests` (Doctests.jet) settle before the
// report. Under `--measure`, `measure` selects the measured claims, whose
// records (Measure.jet) settle there too.
jet_cli_test_result: fn(file: String, source: String, doctests: [JetCLIDoctestFile], measure: JetCLIMeasurePlan?, color: Bool, verbose: Bool, options: JetCLITestOptions, result: JetDriverCompileResult, inputs: &&JetDriverLoweringInputs?, snapshot: JetDriverAuthorizedSourceSnapshot) -> JetDriverVerbOutput {
    if jet_cli_errors(result.diagnostics).len() > 0 {
        shown: jet_cli_present_shown(result, snapshot, verbose)
        // As `jet build --json`: the compile reports' status line on stderr.
        if options.json -> return JetDriverVerbOutput{stdout: "", stderr: jet_cli_reports_status_json("diagnostics", false, jet_cli_report_base(file), file, source, shown), exit_code: JET_DRIVER_EXIT_USER_ERROR}
        return JetDriverVerbOutput{stdout: "", stderr: jet_driver_report_problems(file, source, shown, color, verbose), exit_code: JET_DRIVER_EXIT_USER_ERROR}
    }
    if verbose -> jet_cli_write_verbose_lints(file, source, color, false, jet_cli_present_shown(result, snapshot, true))
    if result.internal_problem == .Val(problem) -> return jet_cli_ice(problem)
    if !result.complete -> return jet_cli_ice("the Jet compiler stopped before finishing the tests of `{file}`")
    root: snapshot.roots[0].canonical_path
    if jet_cli_build_option_gate_refusal(root, options.build, color) == .Val(refused) -> return refused
    // A member that lowers its Package root's claims floor stops before the
    // harness builds. A `jet prove` child leaves the floor to its parent.
    floor := ClaimsGrade?{None}
    if measure == None && !jet_cli_test_handoff() {
        if jet_cli_test_claims_floor(snapshot.roots[0]) == {
            .Ok(found) -> floor = found
            .Err(error) -> return jet_cli_diagnostics_output(file, source, error.diagnostic, color, options.json, "")
        }
    }
    build_dir: "{root}/.jet/build"
    cli_files.create_dir_all(build_dir) ?? return jet_cli_build_failed("couldn't create the build directory {build_dir}: {err}", jet_cli_why("E2105"), "check that the project directory is writable", color)
    // Process-private: concurrent `jet test` runs of one file never replace
    // an executable another is launching.
    stem: ".test_{jet_cli_stem(file)}.{cli_process.current_pid()}"
    binary: "{build_dir}/{stem}"
    plan: inputs.move() ?? return jet_cli_ice("the Jet compiler finished tests without their checked functions")
    selected: jet_cli_native_test_selection(plan.tests, plan.functions, options.filter, options.shuffle_seed) ?? return jet_cli_ice("the test harness of `{file}` can't build:\n{err.message}")
    // `--docs` runs the doctest claims alone and `--measure` the measured
    // claims alone, without the output checks. A code suite's child
    // (JET_TEST_SUITE, TestProfile.jet) runs `test: fn` for that suite's rows
    // alone: no #Test and no output check.
    code_suite: cli_sys.get(JET_CLI_TEST_SUITE_ENV) != None
    documented: if code_suite -> [JetNativeTestCase]{} else if options.docs -> jet_cli_doctest_claims(selected, doctests) else -> selected
    measured_tests: if measure == .Val(measured) -> jet_cli_measure_claims(documented, measured) else -> documented
    // `cases` keeps the tests its file names, then `shard` I/N runs its
    // slice of them (jet_cli_test_shard).
    listed_tests: if test_settings_get(options.settings, "cases") == .Val(list) -> jet_cli_test_listed(measured_tests, cli_files.read(list) ?? "") else -> measured_tests
    native_tests: if test_settings_shard_count(options.settings) > 1 -> jet_cli_test_shard(listed_tests, options.settings) else -> listed_tests
    // `list` names the tests the run selects, and runs none.
    if test_settings_on(options.settings, "list") {
        listed: (loop test in native_tests -> "{test.name}\n").join("")
        return JetDriverVerbOutput{stdout: listed, stderr: "", exit_code: JET_DRIVER_EXIT_OK}
    }
    // `record` binds its replay before the harness builds, so a refused
    // recording leaves nothing behind (ProveReplay.jet jet_cli_replay_record_begin).
    replay_record := JetCLIReplayRecord?{None}
    if test_settings_get(options.settings, "record") == .Val(name) {
        files := [String]{}
        loop authorized in snapshot.roots {
            loop authorized_file in authorized.files -> files.push(authorized_file.path)
        }
        begun: jet_cli_replay_record_begin(file, files, name, options.profile, options.build.settings) ?? return jet_cli_prove_refused(err, color, options.json)
        replay_record = Val(begun)
    }
    claims := jet_cli_test_claims(native_tests, plan.tests, doctests, file)
    check_names := [String]{}
    checks := [IROutputCheck]{}
    if !options.docs && measure == None && !code_suite {
        loop check in plan.output_checks {
            check_names.push(check.name)
            checks.push(IROutputCheck{name: check.name, key: check.function.key})
        }
    }
    // `coverage` probes the tested file's own functions (TestCoverage.jet).
    coverage: test_settings_on(options.settings, "coverage")
    covered: if coverage -> jet_cli_coverage_functions(file, plan.functions, plan.tests, loop check in plan.output_checks -> check.function.key.copy()) else -> [JetCLICoverageFunction]{}
    harness: IRTestHarness{
        tests: loop test in native_tests -> IRTestCase{id: Int.from_u64(test.id), key: test.key, name: test.name, expected_failure: test.expected_failure, faults: test.faults},
        checks: checks,
        serial: options.serial,
        stock: options.stock,
        coverage: jet_cli_coverage_probes(covered),
    }
    // The package's `test: fn(t: Test)` runs first, and says so, unless
    // `--show-default` chose the stock harness; a code suite's child always
    // runs it.
    announce_override: !options.stock && !options.quiet && !code_suite && ir_test_override_key(plan.functions) != ""
    sources: jet_cli_native_c_sources(snapshot, options.build) ?? return jet_cli_build_failed("couldn't realize C dependencies for `{file}`: {err.message}", jet_cli_why("E2105"), "check the declared C source/library paths and the installed C toolchain", color)
    // The harness's build, object and link are one traced span.
    if result.trace_sink == .Val(sink) -> sink.begin("native.build", "", -1, -1)
    census := [JetDriverIceRow]{}
    native: jet_cli_native_executable(result, plan, Val(harness), sources, options.build, jet_cli_runtime_dir(), binary, LINK_BASE, census, file, jet_driver_entry_root_path(snapshot), [String]{}, false)
    if census.len() > 0 -> return jet_cli_ice_census(file, census)
    if native == {
        .Failed(failure) -> return jet_cli_test_native_failure(file, failure, color)
        .Image(executable) -> {
            if jet_cli_native_write(binary, executable) == .Val(failure) -> return jet_cli_test_native_failure(file, failure, color)
        }
    }
    if result.trace_sink == .Val(sink) -> sink.end("native.build", -1)
    // `jet test`'s plan step (TestSettingLayers.jet jet_cli_test_code_layer):
    // the harness calls `test: fn`, whose setting calls write the plan file,
    // and exits before any test runs.
    if cli_sys.get(TEST_SETTINGS_PLAN_ENV) != None {
        planned: cli_process.cmd([String]{binary}).stdout(.Capture).stderr(.Capture).run() ?? {
            cli_files.remove(binary).drop("the plan step already failed")
            return jet_cli_ice("couldn't run the plan step of `{file}`: {err}")
        }
        cli_files.remove(binary).drop("the plan step is one-shot; a leftover binary is harmless")
        return JetDriverVerbOutput{stdout: planned.output, stderr: planned.errors, exit_code: planned.code}
    }
    if announce_override {
        stderr_handle := cli_term.stderr()
        stderr_handle.write("jet test: using fn test override\n").drop("jet stderr")
    }
    spec := cli_process.cmd([String]{binary})
    // A code suite stamps its builds with the jet under test's identity, and
    // this jet is the one under test: its identity reaches the suite even
    // when the caller set none (jet_cli_compiler_identity reads IDENTITY).
    if code_suite && jet_cli_compiler_identity() == .Val(identity) -> spec = spec.env(JET_CLI_COMPILER_IDENTITY_ENV, identity)
    if options.project_root == .Val(project_root) -> spec = spec.env("JET_PROJECT_ROOT", project_root)
    if options.update_snapshots -> spec = spec.env("JET_UPDATE_SNAPSHOTS", "1")
    if options.filter == .Val(filter) -> spec = spec.env("JET_TEST_FILTER", filter)
    if options.shuffle_seed == .Val(seed) -> spec = spec.env("JET_TEST_SHUFFLE_SEED", seed)
    if options.serial -> spec = spec.env("JET_TEST_SERIAL", "1")
    if options.trace_tiers -> spec = spec.env("JET_TEST_TRACE_TIERS", "1")
    // The generated grade runs each property test's `iterations` cases
    // (default 1000) in place of its default budget, from the base `seed`
    // (default the fixed 0, unless the caller's JET_PROP_SEED names one), so
    // a graded run is reproducible (TestProperty.jet).
    iterations: jet_cli_test_generated_iterations(options.settings)
    if iterations == .Val(count) -> spec = spec.env("JET_FUZZ_ITERATIONS", count)
    generated_seed: jet_cli_test_generated_seed(options.settings, cli_sys.get("JET_PROP_SEED") != None)
    if generated_seed == .Val(seed) -> spec = spec.env("JET_PROP_SEED", seed)
    spec = spec.env("JET_TEST_CAPTURE", options.capture)
    if measure != None -> spec = spec.env("JET_TEST_MEASURE", "1")
    // Every test process appends the lines it entered to one file.
    coverage_path: "{build_dir}/{stem}.coverage"
    if coverage -> spec = spec.env(JET_CLI_COVERAGE_ENV, coverage_path)
    // Under `jet prove --capture-sensitive` the tests read the user's
    // terminal, and the runtime journals every stdin read.
    if cli_sys.get(JET_CLI_REPLAY_CAPTURE_ENV) != None -> spec = spec.stdin(.Inherit)
    // A recorded run's programs read the clock the recording holds.
    if replay_record == .Val(recording) -> spec = spec.env(JET_CLI_REPLAY_TIME_ENV, "{recording.run.time_ms}")
    time_limit := Duration?{None}
    limit_setting: test_settings_time_limit_ms(options.settings)
    if limit_setting == .Val(limit_ms) -> time_limit = Val(Duration.milliseconds(limit_ms) ?? return jet_cli_ice("the test time limit of {limit_ms} ms is out of range"))
    // The children's outcome records stay in memory: no test writes the disk.
    records_path: "{jet_cli_native_test_records_dir(build_dir)}/{stem}.records"
    // A plain run goes through the test-result store (TestReuse.jet): a
    // snapshot update, a measured, coverage or code-suite run, a recorded
    // one, or one `jet prove` captures always runs.
    reuse := JetCLITestReuse?{None}
    if !options.update_snapshots && measure == None && !coverage && !code_suite && replay_record == None && cli_sys.get(JET_CLI_REPLAY_CAPTURE_ENV) == None {
        names: (loop test in native_tests -> test.key).join(",")
        settings: "{options.filter ?? "-"}\n{options.shuffle_seed ?? "-"}\n{options.serial}\n{options.trace_tiers}\n{options.capture}\n{options.project_root ?? "-"}\n{options.docs}\n{limit_setting ?? -1}\n{iterations ?? "-"}\n{generated_seed ?? "-"}\n{names}\n{check_names.join(",")}"
        reuse = jet_cli_test_reuse_at(root, binary, settings, records_path)
    }
    how := JetCLITestReuseHow.Plain
    run: jet_cli_test_reuse_run(reuse, options.fresh, how, spec, native_tests, check_names, jet_cli_native_test_unrun_check_report, options.serial, records_path, time_limit) ?? {
        cli_files.remove(binary).drop("the native run already failed")
        if coverage -> cli_files.remove(coverage_path).drop("the native run already failed")
        return jet_cli_ice(err.message)
    }
    covered_report := ""
    if coverage {
        hits: jet_cli_coverage_hits(coverage_path)
        covered_report = if options.json -> jet_cli_coverage_status(file, covered, hits) else -> jet_cli_coverage_text(file, covered, hits)
    }
    wires := [String]{}
    loop wire in run.wires -> wires.push(wire)
    loop doctest_file in doctests {
        rewrites := [JetCLIDocExpectation]{}
        loop (index, test) in native_tests {
            doctest: jet_cli_doctest_named(doctest_file, test.name) ?? next
            if index >= wires.len() -> next
            mismatches := [JetCLITestStop]{}
            wires[index] = jet_cli_doctest_settle(wires[index], doctest_file, doctest, color, options.update_snapshots, rewrites, mismatches) ?? {
                cli_files.remove(binary).drop("the native run already failed")
                return jet_cli_ice(err.message)
            }
            if mismatches.len() > 0 -> claims[index].mismatch = Val(mismatches[0].copy())
        }
        if rewrites.len() > 0 {
            cli_files.write(doctest_file.path, jet_cli_doctest_rewrite(doctest_file.source, rewrites)) ?? {
                cli_files.remove(binary).drop("the native run already failed")
                return jet_cli_build_failed("couldn't update the doctest claims in `{doctest_file.shown}`: {err}", jet_cli_why("E2105"), "check that the tested file is writable", color)
            }
        }
    }
    records := [JetCLIMeasureRecord]{}
    if measure == .Val(measured) {
        loop (index, test) in native_tests {
            if index >= wires.len() -> next
            wires[index] = jet_cli_measure_settle(wires[index], test.name, measured, color, records) ?? {
                cli_files.remove(binary).drop("the native run already failed")
                return jet_cli_ice(err.message)
            }
        }
    }
    ran: jet_cli_native_test_report(spec, JetNativeTestOutcomes{wires: wires, outputs: run.outputs, errors: run.errors, contracts: run.contracts.copy()}, records_path) ?? {
        cli_files.remove(binary).drop("the native run already failed")
        return jet_cli_ice(err.message)
    }
    cli_files.remove(binary).drop("the harness is one-shot; a leftover binary is harmless")
    passed: ran.receipt.success
    if how == .Logged && reuse == .Val(store) -> jet_cli_test_reuse_keep(store, run, passed)
    exit_code: if passed -> JET_DRIVER_EXIT_OK else -> JET_DRIVER_EXIT_USER_ERROR
    recorded := ""
    if replay_record == .Val(recording) {
        path: jet_cli_replay_record_finish(recording, exit_code) ?? return jet_cli_prove_refused(err, color, options.json)
        if !options.json -> recorded = "jet test: recorded replay `{path}`\n"
    }
    show: options.capture == "all" || (!passed && options.capture == "failed")
    // The canonical report always prints; the children's own streams follow
    // the capture policy. A code suite's child runs no #Test, so its report
    // is the rows its suite recorded (TestProfile.jet), not the #Test count.
    stdout := if show -> ran.output else -> ran.receipt.output
    if code_suite -> stdout = "{stdout.removesuffix(ran.receipt.output)}{jet_cli_test_code_suite_summary()}"
    stderr: if show -> ran.errors else -> ran.receipt.errors
    if measure == None {
        outcome: jet_cli_test_outcome(file, source, options.build, wires, claims, run.contracts, passed, floor) ?? return jet_cli_ice(err.message)
        persisted: jet_cli_test_persist(outcome.report)
        // `results`: the run's verdicts as one document (TestSettingLayers.jet).
        if test_settings_get(options.settings, "results") == .Val(results_path) {
            written: jet_cli_test_results_write(results_path, jet_cli_test_record_results(outcome.report.records, "tests", "tests"), [String]{"tests"}, cli_sys.executable())
            if written == .Val(problem) -> return jet_cli_build_failed(problem, jet_cli_why("E2105"), "name a writable `results` file", color)
        }
        plural: if wires.len() == 1 -> "" else -> "s"
        notice: if how == .Reused && !options.json -> "jet test: reused {wires.len()} stored result{plural} (every read they recorded is unchanged; --fresh runs them)\n{persisted}" else -> "{persisted}{recorded}"
        below := ""
        if outcome.below == .Val(diagnostic) -> below = diagnostic_render_all("", "", [Diagnostic]{diagnostic}, color)
        floor_exit: if outcome.below != None && exit_code == JET_DRIVER_EXIT_OK -> JET_DRIVER_EXIT_USER_ERROR else -> exit_code
        // Under `--json` the status line (and coverage's) is the whole stdout;
        // the report moves to stderr, and E2942 rides in the status's `reports`.
        if options.json -> return JetDriverVerbOutput{stdout: "{outcome.status}\n{covered_report}", stderr: "{stdout}{stderr}{notice}", exit_code: floor_exit}
        return JetDriverVerbOutput{stdout: "{stdout}{covered_report}", stderr: "{stderr}{notice}{below}", exit_code: floor_exit}
    }
    rendered: (loop record in records -> jet_cli_measure_render(record, options.json)).join("")
    // Under `--json` the record lines are the whole stdout; the report moves to stderr.
    if options.json -> return JetDriverVerbOutput{stdout: "{rendered}{covered_report}", stderr: "{stdout}{stderr}", exit_code: exit_code}
    JetDriverVerbOutput{stdout: "{stdout}{rendered}{covered_report}", stderr: stderr, exit_code: exit_code}
}

// The tests of shard I of N (the `shard` setting): from the I-th of them in
// key order, every N-th, in selection order; so one shard holds the same
// tests whatever order the run picks.
jet_cli_test_shard: fn(tests: [JetNativeTestCase], settings: [TestSetting]) -> [JetNativeTestCase] Never! {
    count: test_settings_shard_count(settings)
    index: test_settings_shard_index(settings)
    keys := loop test in tests -> test.key
    keys.sort()
    picked := [String]{}
    loop (at, key) in keys {
        if at % count == index - 1 -> picked.push(key)
    }
    kept := [JetNativeTestCase]{}
    loop test in tests {
        if picked.contains(test.key) -> kept.push(test.copy()) // copy: the selection keeps every test.
    }
    kept
}

// The tests a `cases` file names, one name per line (a blank line or a `#`
// line names none), in selection order.
jet_cli_test_listed: fn(tests: [JetNativeTestCase], text: String) -> [JetNativeTestCase] Never! {
    names := [String]{}
    loop line in text.split("\n").to_list() {
        name: line.trim()
        if name != "" && !name.starts_with("#") -> names.push(name.copy())
    }
    kept := [JetNativeTestCase]{}
    loop test in tests {
        if names.contains(test.name) -> kept.push(test.copy()) // copy: the selection keeps every test.
    }
    kept
}

// Why `jet test`'s harness build stopped (jet_cli_native_executable).
jet_cli_test_native_failure: fn(file: String, failure: JetCLINativeFailure, color: Bool) -> JetDriverVerbOutput {
    if failure == {
        .RustForeign(error) -> JetDriverVerbOutput{stdout: "", stderr: jet_cli_rust_foreign_report(error, color), exit_code: JET_DRIVER_EXIT_USER_ERROR}
        .NoEntry -> jet_cli_ice("the test harness of `{file}` has no entry")
        // Every fault is a census row the caller reports first (jet_cli_ice_census).
        .Faulted -> jet_cli_ice("the test harness of `{file}` stopped on a fault it did not record")
        .Write(what) -> jet_cli_build_failed(what, jet_cli_why("E2105"), "check that the build directory is writable", color)
        .RuntimeKey(what) -> jet_cli_build_failed(what, jet_cli_why("E2105"), "package the matching test runtime beside jet", color)
        .Runtime(what) -> jet_cli_build_failed(what, jet_cli_why("E2105"), "package the matching test runtime beside jet", color)
        .Foreign(message) -> jet_cli_build_failed("couldn't realize C dependencies for `{file}`: {message}", jet_cli_why("E2105"), "check the declared C source/library paths and the installed C toolchain", color)
    }
}

jet_cli_compile_test: fn(file: String, source: String, color: Bool, verbose: Bool, threads: Int?, options: JetCLITestOptions, trace_sink: JetCLITraceSink?) -> JetDriverVerbOutput {
    if options.status.len() > 0 {
        stderr_handle := cli_term.stderr()
        stderr_handle.write(options.status).drop("jet stderr")
    }
    // A Core library source tests as the Core unit it is.
    if jet_cli_core_test_path(file) == .Val(path) -> return jet_cli_compile_core_test(file, source, path, color, verbose, threads, options, trace_sink)
    output := JetDriverVerbOutput{stdout: "", stderr: "", exit_code: JET_DRIVER_EXIT_OK}
    if trace_sink == .Val(sink) -> sink.begin("sources", "", -1, -1)
    snapshotted := jet_cli_prepare_snapshot(file, file, [JetCLIOverlay]{}, color)
    doctests := [JetCLIDoctestFile]{}
    measure := JetCLIMeasurePlan?{None}
    tested := source
    prepared := if snapshotted.move() == {
        .Refused(refusal) -> JetCLIPrepared.Refused{output: refusal}
        .Held(snapshot) -> {
            held := snapshot
            if options.measure -> measure = Val(jet_cli_measure_plan(held, options.project_root != None, options.profile))
            doctests = jet_cli_doctest_overlay(held, options.project_root != None)
            loop doctest_file in doctests {
                if doctest_file.path == held.entry_path -> tested = jet_cli_doctest_source(doctest_file)
            }
            jet_cli_prepare_request(held, color, threads, JetDriverCompileMode.Test)
        }
    }
    if trace_sink == .Val(sink) -> sink.end("sources", jet_cli_prepared_file_count(prepared))
    compiled := jet_cli_compile_executable(prepared, None, options.build, None, trace_sink, color)
    if compiled.move() == {
        .Refused(refusal) -> output = refusal
        .Checked(result, inputs, snapshot) -> jet_cli_finish(jet_cli_test_result(file, tested, doctests, measure, color, verbose, options, result, inputs, snapshot))
    }
    output
}

// `jet test` of a Core library source (jet_cli_core_test_path): the Core unit
// at the row path `path` runs its #Tests as the compiler loads it, with
// Core's privileges (JetDriverCompileRequest.core_tests). The compile's entry
// imports the module that loads it (jet_cli_core_test_source) from a scratch
// directory, which holds the test build and goes when the run ends.
jet_cli_compile_core_test: fn(file: String, source: String, path: String, color: Bool, verbose: Bool, threads: Int?, options: JetCLITestOptions, trace_sink: JetCLITraceSink?) -> JetDriverVerbOutput {
    scratch: cli_files.temp_dir("jet-test-core") ?? return JetDriverVerbOutput{stdout: "", stderr: "jet test: couldn't create a scratch directory for the Core entry: {err}\n", exit_code: JET_DRIVER_EXIT_USER_ERROR}
    entry: "{scratch.path}/core_test.jet"
    cli_files.write(entry, jet_cli_core_test_source(path)) ?? return JetDriverVerbOutput{stdout: "", stderr: "jet test: couldn't write the Core entry `{entry}`: {err}\n", exit_code: JET_DRIVER_EXIT_USER_ERROR}
    if trace_sink == .Val(sink) -> sink.begin("sources", "", -1, -1)
    measure := JetCLIMeasurePlan?{None}
    prepared := if jet_cli_prepare_snapshot(entry, entry, [JetCLIOverlay]{}, color, true) == {
        .Refused(refusal) -> JetCLIPrepared.Refused{output: refusal}
        .Held(snapshot) -> {
            if options.measure -> measure = Val(jet_cli_measure_plan(snapshot, false, options.profile))
            jet_cli_prepare_request(snapshot, color, threads, JetDriverCompileMode.Test, Val(file), path)
        }
    }
    if trace_sink == .Val(sink) -> sink.end("sources", jet_cli_prepared_file_count(prepared))
    compiled := jet_cli_compile_executable(prepared, None, options.build, None, trace_sink, color)
    if compiled.move() == {
        .Refused(refusal) -> refusal
        .Checked(result, inputs, snapshot) -> jet_cli_test_result(file, source, [JetCLIDoctestFile]{}, measure, color, verbose, options, result, inputs, snapshot)
    }
}

// `jet new` starters (`NEW_PRINT_RUN`, `NEW_CLI_RUN`, `NEW_UI_RUN`,
// `NEW_WEB_RUN`): `run.jet` for each template.
jet_cli_new_run_source: fn(template: String) -> String Never! {
    if template == {
        "cli" -> "#CLI\nGreetingArgs: struct {{\n    #Doc(\"name to greet\") name: String{{\"world\"}}\n}}\n\ngreeting: fn(name: String) -> String {{ \"hello, {{name}}\" }}\n\nrun: fn(args: GreetingArgs) {{\n    print(greeting(args.name))\n}}\n\n#Test(\"the greeting stays stable\") {{\n    assert_eq(greeting(\"world\"), \"hello, world\")\n}}\n"
        "ui" -> "use ui: core.ui\n\n#CLI\nGreetingArgs: struct {{\n    #Doc(\"name to greet\") name: String{{\"world\"}}\n}}\n\ngreeting: fn(name: String) -> String {{ \"hello, {{name}}\" }}\n\nrun: fn(args: GreetingArgs) {{\n    message: greeting(args.name)\n    print(message)\n    backend: ui.null_backend()\n    ui.reactive_render(() -> {{\n        tree: ui.text(message)\n        ui.mount(backend, tree, ui.constraint(0.0, 0.0, 320.0, 80.0))\n    }})\n}}\n\n#Test(\"the greeting stays stable\") {{\n    assert_eq(greeting(\"world\"), \"hello, world\")\n}}\n"
        "web" -> "// Start the live browser app: `jet dev`\n// Run the scaffold test: `jet test`\n// Build static browser files: `jet build --target web`\nuse {{\n    ui: core.ui\n    reactive: core.reactive\n}}\n#Target(Web)\n\nrun: fn() {{\n    count: reactive.signal(0)\n    ui.reactive_render(() -> {{\n        n := count.get()\n        tree: ui.box([\n            ui.node_color(\"Clicks: {{n}}\", 240.0, 40.0, \"#3366ff\"),\n            ui.button(\"Add one\") {{\n                count.set(count.get() + 1)\n            }}\n        ])\n        backend: ui.null_backend()\n        ui.mount(backend, tree, ui.constraint(0.0, 0.0, 320.0, 120.0))\n    }})\n}}\n\n#Test(\"the counter increments\") {{\n    count: reactive.signal(0)\n    count.set(count.get() + 1)\n    assert_eq(count.get(), 1)\n}}\n"
        else -> "greeting: fn(name: String) -> String {{ \"hello, {{name}}\" }}\n\nrun: fn() {{\n    print(greeting(\"world\"))\n}}\n\n#Test(\"the greeting stays stable\") {{\n    assert_eq(greeting(\"world\"), \"hello, world\")\n}}\n"
    }
}

// The comment-only command homes `--template overrides` writes beside
// `run.jet`, which is the `jet run` home itself, as (file, source) rows.
JET_CLI_NEW_COMMAND_HOMES: [[String]]{
    [String]{"build.jet", "// Optional `jet build` override. Uncomment one `build: fn` to replace the stock default.\n// build: fn(b: Build) {{\n//     b.add_executable(\"app\", [\"run.jet\"], [])\n// }}\n// Inspect the stock behavior with: `jet build --show-default`\n"},
    [String]{"dev.jet", "// Optional `jet dev` override. Uncomment one `dev: fn` to replace the stock default.\n// dev: fn(d: Dev) {{\n//     print(\"dev override\")\n// }}\n// Inspect the stock behavior with: `jet dev --show-default`\n"},
    [String]{"test.jet", "// Optional `jet test` override. Uncomment one `test: fn` to replace the stock default.\n// test: fn(t: Test) {{ t.run() }}\n// Inspect the stock behavior with: `jet test --show-default`\n"},
}

// The `package.jet` `jet new` writes (Package `new_template`, then
// `add_authority_hold` for each hold the template's `run.jet` needs).
jet_cli_new_manifest: fn(name: String, template: String, annotated: Bool) -> String Never! {
    allow := "IO, Mem.Alloc"
    if template == {
        "cli" -> allow = "{allow}, Exec.Args"
        "ui" -> allow = "{allow}, Exec.Args, Browser"
        "web" -> allow = "{allow}, Browser"
        else -> {}
    }
    head: "name: \"{name}\"\nversion: \"0.1.0\"\njet: \"{COMPILER_VERSION}\"\ndescription: \"\"\nlicense: \"MIT OR Apache-2.0\"\nrepository: \"\"\nauthority: {{ allow: [{allow}] }}\n\n"
    if annotated -> return "{head}// Jet package dependencies:\n// deps: {{\n//     helpers:  ../helpers,\n//     parsekit: {{ git: \"https://github.com/acme/parsekit\", tag: \"v0.4.1\" }},\n// }}\n"
    "{head}deps: {{}}\n"
}

jet_cli_zero_pad: fn(value: Int, width: Int) -> String Never! {
    text := "{value}"
    loop text.len() < width -> text = "0{text}"
    text
}

// `timestamp_now`: RFC 3339 UTC with nanoseconds.
jet_cli_rfc3339: fn(unix_ns: Int) -> String Never! {
    seconds: unix_ns /% 1000000000
    days: seconds /% 86400
    second: seconds % 86400
    z: days + 719468
    era: z /% 146097
    doe: z - era * 146097
    yoe: (doe - doe /% 1460 + doe /% 36524 - doe /% 146096) /% 365
    year := yoe + era * 400
    doy: doe - (365 * yoe + yoe /% 4 - yoe /% 100)
    month_part: (5 * doy + 2) /% 153
    day: doy - (153 * month_part + 2) /% 5 + 1
    month: if month_part < 10 -> month_part + 3 else -> month_part - 9
    if month <= 2 -> year += 1
    "{jet_cli_zero_pad(year, 4)}-{jet_cli_zero_pad(month, 2)}-{jet_cli_zero_pad(day, 2)}T{jet_cli_zero_pad(second /% 3600, 2)}:{jet_cli_zero_pad((second % 3600) /% 60, 2)}:{jet_cli_zero_pad(second % 60, 2)}.{jet_cli_zero_pad(unix_ns % 1000000000, 9)}Z"
}

// `git_output`: trimmed stdout of a successful `git -C <root> …`.
jet_cli_git_output: fn(root: String, args: [String]) -> String? {
    argv := [String]{"git", "-C", root}
    loop argument in args -> argv.push(argument.copy())
    receipt: cli_process.cmd(argv).run() ?? return None
    if !receipt.success -> return None
    Val(receipt.output.trim())
}

// The `.jet/lock` of a new project: the running toolchain pin and the build
// stamp, written as `write` lays them out.
jet_cli_new_lock: fn(root: String) -> String {
    version: COMPILER_VERSION
    parts: version.split(".").to_list()
    channel: if parts.len() >= 2 -> "{parts[0]}.{parts[1]}" else -> version
    platform: "{cli_sys.arch()}-{cli_sys.name()}"
    id: "jet-{version}-{sha256_hex("{version}:{platform}").slice(0..<8)}"
    stamp := "\n[build.stamp]\n"
    if jet_cli_git_output(root, [String]{"rev-parse", "HEAD"}) == .Val(revision) {
        status: jet_cli_git_output(root, [String]{"status", "--porcelain", "--untracked-files=all"}) ?? ""
        if {
            status.len() > 0 -> stamp = "{stamp}git = \"{revision}-dirty\"\ndirty = true\n"
            else -> stamp = "{stamp}git = \"{revision}\"\ndirty = false\n"
        }
    } else {
        stamp = "{stamp}dirty = false\n"
    }
    stamp = "{stamp}toolchain = \"{version}\"\nat = \"{jet_cli_rfc3339(cli_time.unix_ns())}\"\n"
    "version = 1\n{stamp}\n[[toolchain]]\nid = \"{id}\"\nchannel = \"{channel}\"\nversion = \"{version}\"\noutput-hash = \"\"\nplatform = \"{platform}\"\nprovenance = \"jet-{version} via toolchain\"\n\n[root]\ndependencies = []\n"
}

jet_cli_new_failed: fn(code: String, what: String, fix: String, color: Bool) -> JetDriverVerbOutput Never! {
    jet_cli_report_output("", code, what, jet_cli_why(code), fix, color, JET_DRIVER_EXIT_USER_ERROR)
}

// `jet new <name>`: the folder and `.jet/`, then package.jet, the lock, run.jet,
// the `overrides` command homes, and.gitignore, each a failure of its own; the
// status lines go to stderr, or with `json` one `new` status line names the
// folder and its files on stdout. Every Jet file goes through the formatter
// first, so a fresh project already passes `jet fmt --check`; a template the
// formatter rejects is a compiler fault.
jet_cli_new_project: fn(name: String, template: String, annotated: Bool, quiet: Bool, json: Bool, color: Bool) -> JetDriverVerbOutput {
    write_failed: "correct the named problem, then run the command again"
    manifest: jet_cli_fmt_format_source(jet_cli_new_manifest(name, template, annotated), "{name}/package.jet", false, false, color)
    if manifest.report != None || manifest.diagnostics.len() > 0 -> return jet_cli_ice("the `jet new` package.jet template does not format")
    run_source: jet_cli_fmt_format_source(jet_cli_new_run_source(template), "{name}/run.jet", false, false, color)
    if run_source.report != None || run_source.diagnostics.len() > 0 -> return jet_cli_ice("the `jet new` run.jet template `{template}` does not format")
    cli_files.create_dir_all("{name}/.jet") ?? return jet_cli_new_failed("E2105", "couldn't create `{name}`/.jet: {err}", write_failed, color)
    cli_files.write("{name}/package.jet", manifest.text) ?? return jet_cli_new_failed("E2105", "couldn't write package.jet: {err}", write_failed, color)
    cli_files.write("{name}/.jet/lock", jet_cli_new_lock(name)) ?? return jet_cli_new_failed("E1224", "couldn't write .jet/lock", "check the project lock permissions: could not write `.jet/lock`: {err}", color)
    cli_files.write("{name}/run.jet", run_source.text) ?? return jet_cli_new_failed("E2105", "couldn't write run.jet: {err}", write_failed, color)
    homes := [String]{}
    if template == "overrides" {
        loop home in JET_CLI_NEW_COMMAND_HOMES {
            home_source: jet_cli_fmt_format_source(home[1], "{name}/{home[0]}", false, false, color)
            if home_source.report != None || home_source.diagnostics.len() > 0 -> return jet_cli_ice("the `jet new` {home[0]} template does not format")
            cli_files.write("{name}/{home[0]}", home_source.text) ?? return jet_cli_new_failed("E2105", "couldn't write {home[0]}: {err}", write_failed, color)
            homes.push(home[0])
        }
    }
    cli_files.write("{name}/.gitignore", ".jet/build/\n.jet/lock\n.jet/cache/\n") ?? return jet_cli_new_failed("E2105", "couldn't write .gitignore: {err}", write_failed, color)
    files := [String]{"package.jet", "run.jet"}
    loop home in homes -> files.push(home)
    files.push(".gitignore")
    if json {
        listed: loop file in files -> jet_cli_status_text(file)
        created: jet_cli_status_object([JetCLIStatusField]{
            jet_cli_status_field("path", jet_cli_status_text("{name}/")),
            jet_cli_status_field("files", jet_cli_status_array(listed)),
        })
        return JetDriverVerbOutput{stdout: "{jet_cli_status_render("new", true, [JetCLIStatusField]{jet_cli_status_field("new", created)})}\n", stderr: "", exit_code: JET_DRIVER_EXIT_OK}
    }
    if quiet -> return JetDriverVerbOutput{stdout: "", stderr: "", exit_code: JET_DRIVER_EXIT_OK}
    status := "created {name}/\n"
    loop file in files -> status = "{status}  {file}\n"
    next_command: if template == "web" -> "dev" else -> "run"
    JetDriverVerbOutput{stdout: "", stderr: "{status}next: cd {name} && jet {next_command}\n", exit_code: JET_DRIVER_EXIT_OK}
}

// `undocumented_diagnostics` + `render_doc_diagnostics`: one L2201 per public
// item with no summary, rendered against its own module, the modules in path
// order; `json` renders each module's batch as report lines naming the module's
// physical path under `base` (jet_cli_report_base).
jet_cli_doc_undocumented_report: fn(graph: JetCLIDocGraph, modules: [JetDriverDocModule], color: Bool, json: Bool, base: JetCLIReportBase?) -> String Never! {
    paths := [String]{}
    loop item in jet_cli_doc_undocumented_public(graph) {
        if !paths.contains(item.source.path) -> paths.push(item.source.path)
    }
    jet_cli_doc_sort_strings(paths)
    rendered := ""
    loop path in paths {
        position: jet_cli_doc_module_position(modules, path) ?? next
        diagnostics := [Diagnostic]{}
        loop item in jet_cli_doc_undocumented_public(graph) {
            if item.source.path != path -> next
            name: item.qualified_name
            diagnostics.push(diagnostic_from_registry(
                "L2201",
                Val(Span{start: item.source.start, end: item.source.end}),
                "Public API item `{name}` has no documentation",
                "Generated reference documentation needs a summary for every public API item so users can find and understand the supported surface.",
                "Add a `///` summary before `{name}`, or move it into a `priv module` when it is not part of the public API.",
            ))
        }
        rendered = if json -> "{rendered}{jet_cli_render_all_json(base, modules[position].physical_path, modules[position].source, diagnostics)}" else -> "{rendered}{diagnostic_render_all(path, modules[position].source, diagnostics, color)}"
    }
    rendered
}

// `jet doc <file>`: check the file, project its documentation, then report the
// `--check` verdict, print the `--json` status, or write `docs/index.html` and
// `docs/index.md` beside the entry.
jet_cli_compile_doc: fn(file: String, source: String, color: Bool, json: Bool, check: Bool) -> JetDriverVerbOutput {
    output := JetDriverVerbOutput{stdout: "", stderr: "", exit_code: JET_DRIVER_EXIT_OK}
    compiled: jet_cli_compile_file(file, color, None, JetDriverCompileMode.Doc)
    if compiled == {
        .Refused(refusal) -> output = refusal.move()
        .Compiled(result, snapshot) -> jet_cli_finish(jet_cli_doc_result(file, source, color, json, check, result, snapshot))
    }
    output
}

jet_cli_doc_result: fn(file: String, source: String, color: Bool, json: Bool, check: Bool, result: JetDriverCompileResult, snapshot: JetDriverAuthorizedSourceSnapshot) -> JetDriverVerbOutput {
    // Errors are found on the raw rows; only a failing doc presents and prints its diagnostics.
    if jet_cli_errors(result.diagnostics).len() > 0 {
        diagnostics: jet_driver_present_diagnostics(result.diagnostics, snapshot, result.generated_source_files)
        if json -> return JetDriverVerbOutput{stdout: jet_cli_render_all_json(jet_cli_report_base(file), file, source, diagnostics), stderr: "", exit_code: JET_DRIVER_EXIT_USER_ERROR}
        return JetDriverVerbOutput{stdout: "", stderr: diagnostic_render_all(file, source, diagnostics, color), exit_code: JET_DRIVER_EXIT_USER_ERROR}
    }
    if result.internal_problem == .Val(problem) -> return jet_cli_ice(problem)
    // The runtime-library seam (Request.jet jet_cli_compile_prepared) built the checked program as the
    // runtime object and pack; packaging reads those, not pages, so no index or pages are built.
    if cli_sys.get("JET_FRONT_LIBRARY_OBJECT_OUTPUT") != None -> return JetDriverVerbOutput{stdout: "", stderr: "", exit_code: JET_DRIVER_EXIT_OK}
    graph: jet_cli_build_doc_graph(result.doc_modules, jet_cli_checked_semindex(result))
    if check {
        if jet_cli_doc_undocumented_public(graph).len() > 0 {
            if json -> return JetDriverVerbOutput{stdout: jet_cli_doc_undocumented_report(graph, result.doc_modules, color, true, jet_cli_report_base(file)), stderr: "", exit_code: JET_DRIVER_EXIT_USER_ERROR}
            return JetDriverVerbOutput{stdout: "", stderr: jet_cli_doc_undocumented_report(graph, result.doc_modules, color, false, None), exit_code: JET_DRIVER_EXIT_USER_ERROR}
        }
        if json -> return JetDriverVerbOutput{stdout: "{jet_cli_doc_status_json(graph)}\n", stderr: "", exit_code: JET_DRIVER_EXIT_OK}
        return JetDriverVerbOutput{stdout: "doc check: passed ({graph.doctests.len()} doctest block(s))\n", stderr: "", exit_code: JET_DRIVER_EXIT_OK}
    }
    if json -> return JetDriverVerbOutput{stdout: "{jet_cli_doc_status_json(graph)}\n", stderr: "", exit_code: JET_DRIVER_EXIT_OK}
    parent: jet_cli_parent(file) ?? ""
    directory: if parent == "" -> "." else -> parent
    output_dir: if parent == "" && file.starts_with("/") -> "/docs" else -> "{directory}/docs"
    unwritable: "correct the named problem, then run the command again"
    cli_files.create_dir_all(output_dir) ?? return jet_cli_build_failed("couldn't write generated documentation in `{output_dir}`: {err}", jet_cli_why("E2105"), unwritable, color)
    cli_files.write("{output_dir}/index.html", jet_cli_doc_html(graph)) ?? return jet_cli_build_failed("couldn't write generated documentation in `{output_dir}`: {err}", jet_cli_why("E2105"), unwritable, color)
    cli_files.write("{output_dir}/index.md", jet_cli_doc_markdown(graph)) ?? return jet_cli_build_failed("couldn't write generated documentation in `{output_dir}`: {err}", jet_cli_why("E2105"), unwritable, color)
    JetDriverVerbOutput{stdout: "doc: generated {output_dir}\n", stderr: "", exit_code: JET_DRIVER_EXIT_OK}
}

// `jet inspect semindex <file>`: check the entry through the Jet compiler, then
// print the semantic index summary or its `inspect.semindex` status line. Load
// or check errors are reported on stderr with exit 1.
jet_cli_compile_semindex: fn(file: String, color: Bool, json: Bool) -> JetDriverVerbOutput {
    output := JetDriverVerbOutput{stdout: "", stderr: "", exit_code: JET_DRIVER_EXIT_OK}
    compiled: jet_cli_compile_file(file, color, None, JetDriverCompileMode.Doc)
    if compiled == {
        .Refused(refusal) -> output = refusal.move()
        .Compiled(result, snapshot) -> jet_cli_finish(jet_cli_semindex_result(file, color, json, result, snapshot))
    }
    output
}

jet_cli_semindex_result: fn(file: String, color: Bool, json: Bool, result: JetDriverCompileResult, snapshot: JetDriverAuthorizedSourceSnapshot) -> JetDriverVerbOutput {
    if jet_cli_errors(result.diagnostics).len() > 0 {
        diagnostics: jet_driver_present_diagnostics(result.diagnostics, snapshot, result.generated_source_files)
        source: cli_files.read(file) ?? ""
        if json -> return JetDriverVerbOutput{stdout: jet_cli_render_all_json(jet_cli_report_base(file), file, source, diagnostics), stderr: "", exit_code: JET_DRIVER_EXIT_USER_ERROR}
        // One report per diagnostic, each followed by a blank line.
        stderr := ""
        loop diagnostic in diagnostics -> stderr = "{stderr}{diagnostic_render_all(file, source, [Diagnostic]{diagnostic}, color)}\n"
        return JetDriverVerbOutput{stdout: "", stderr: stderr, exit_code: JET_DRIVER_EXIT_USER_ERROR}
    }
    if result.internal_problem == .Val(problem) -> return jet_cli_ice(problem)
    index: jet_cli_checked_semindex(result)
    if json -> return JetDriverVerbOutput{stdout: "{jet_cli_semindex_status_json(index)}\n", stderr: "", exit_code: JET_DRIVER_EXIT_OK}
    JetDriverVerbOutput{stdout: jet_cli_semindex_text(index), stderr: "", exit_code: JET_DRIVER_EXIT_OK}
}

// ---- `jet fmt` (`run_fmt` / `run_fmt_stdin`) ----

// `IGNORED_DIRS`: directory walks never enter these.
JET_CLI_FMT_IGNORED_DIRS: [String]{"vendor", "target", "build", ".git", "node_modules", ".jet"}

// One preflight result (`run_fmt` `FileResult`); `report` is a host
// refusal already rendered (a `--explicit-copies` check that could not run).
JetCLIFmtFile: struct {
    path: String
    original: String
    formatted: String
    changed: Bool
    io_error: String?
    diagnostics: [Diagnostic]
    report: String?
}

// One formatted source, or what stopped it (`format_source_for_fmt`'s
// `Result<String, Vec<Diagnostic>>`, plus a rendered host refusal).
JetCLIFmtSource: struct {
    text: String
    diagnostics: [Diagnostic]
    report: String?
}

jet_cli_fmt_formatted: fn(text: String) -> JetCLIFmtSource Never! {
    JetCLIFmtSource{text: text, diagnostics: [Diagnostic]{}, report: None}
}

jet_cli_fmt_rejected: fn(diagnostics: [Diagnostic]) -> JetCLIFmtSource Never! {
    JetCLIFmtSource{text: "", diagnostics: diagnostics, report: None}
}

// The text after the last `needle` in `text` (Rust `rsplit_once`).
jet_cli_fmt_after_last: fn(text: String, needle: String) -> String? Never! {
    parts: text.split(needle).to_list()
    if parts.len() < 2 -> return None
    Val(parts[parts.len() - 1])
}

// `skip_fmt_walk_path`: diagnostic snapshot trees and the syntax catalog are
// not valid Jet by construction; directory walks skip them.
jet_cli_fmt_skip_walk_path: fn(path: String) -> Bool Never! {
    normalized: path.replace("\\", "/")
    rel := normalized
    if jet_cli_fmt_after_last(normalized, "/tests/") == .Val(rest) {
        rel = "tests/{rest}"
    } else if jet_cli_fmt_after_last(normalized, "/docs/") == .Val(rest) {
        rel = "docs/{rest}"
    }
    if rel == "Docs/spec/reference/syntax-surface.jet" || rel.ends_with("/Docs/spec/reference/syntax-surface.jet") || rel == "syntax-surface.jet" -> return true
    if rel.starts_with("tests/ui_lint/") || rel == "tests/ui_lint" -> return true
    if rel.starts_with("tests/fuzz/sema/invalid/") || rel == "tests/fuzz/sema/invalid" -> return true
    if rel.starts_with("tests/ui/") || rel == "tests/ui" {
        // Walk nested directories so `*.fixed.jet` is still formatted.
        if !rel.ends_with(".jet") -> return false
        return !rel.ends_with(".fixed.jet")
    }
    rel.starts_with("tests/fixtures/jetpack-config/") || rel.starts_with("tests/fixtures/jetpack-config-real/") || rel == "tests/fixtures/jetpack-project/functional-env.jet" || rel.starts_with("tests/fixtures/policy_package_unsafe_allow/") || rel == "tests/agent_workloads/inputs/build-test-recovery/invalid.jet" || rel.ends_with("/ex_concurrency_detached_task.jet")
}

jet_cli_fmt_file_name: fn(path: String) -> String Never! {
    parts: path.split("/").to_list()
    parts[parts.len() - 1]
}

// `walk_jet_files`: sorted, recursive, IGNORED_DIRS and the retired `pkg.jet`
// skipped.
jet_cli_fmt_walk: fn(directory: String, files: &[String]) {
    names := cli_files.listdir(directory) ?? return
    names.sort()
    loop name in names {
        path: if directory.ends_with("/") -> "{directory}{name}" else -> "{directory}/{name}"
        if cli_files.is_dir(path) {
            if !JET_CLI_FMT_IGNORED_DIRS.contains(name) && !jet_cli_fmt_skip_walk_path(path) -> jet_cli_fmt_walk(path, files)
        } else if name.ends_with(".jet") && name != "pkg.jet" && !jet_cli_fmt_skip_walk_path(path) {
            files.push(path)
        }
    }
}

// `is_typed_package_source`: `package.jet`, or a source whose first binding is
// a `Config` record.
jet_cli_fmt_is_typed_package_source: fn(source: String, origin: String) -> Bool Never! {
    if jet_cli_fmt_file_name(origin) == "package.jet" -> return true
    trimmed: source.trim()
    value := ""
    if trimmed.starts_with("Config") {
        value = trimmed.slice(6..<trimmed.len()).trim()
    } else if trimmed.split_once(":") == .Val(parts) {
        value = parts.after.trim()
    } else {
        return false
    }
    if !value.starts_with("Config") -> return false
    rest: value.slice(6..<value.len()).trim()
    rest.starts_with(".{{") || rest.starts_with("{{")
}

jet_cli_fmt_plural: fn(count: Int, singular: String, plural: String) -> String Never! {
    if count == 1 -> singular else -> plural
}

// `is_package_manifest_file` the one reserved Package root filename; its
// `config.jet`/`env.jet` siblings are ordinary modules.
jet_cli_fmt_is_package_manifest_file: fn(origin: String) -> Bool Never! {
    jet_cli_fmt_file_name(origin) == PACKAGE_FILE
}

// `format_package_manifest_for_fmt`: `package.jet` is formatted only by the
// typed Package model. A manifest the model cannot read stops the run with its
// registered manifest diagnostic (E1215 and family); a layout the model
// declines (authored comments) is left exactly as written.
jet_cli_fmt_package_manifest: fn(source: String, origin: String) -> JetCLIFmtSource {
    if PackageFacts.parse(source, origin) == .Err(error) -> return jet_cli_fmt_rejected([Diagnostic]{pkg_manifest_parse_diagnostic(origin, error)})
    if pkg_format_source(source, origin) == .Ok(formatted) -> return jet_cli_fmt_formatted(formatted)
    jet_cli_fmt_formatted(source)
}

// The module policy that turns every implicit copy site into a Safe `.copy()` edit.
JET_CLI_FMT_EXPLICIT_COPIES_POLICY: "#Policy(copies: .Explicit)\n"

// The Rust `format_source_for_fmt` copy materialization: `origin` must check
// clean as written, then `.copy()` goes in at every implicit copy site. The sites
// are sema's one copy-site rule (#3738): the Safe `.copy()` edits it gives the
// same bytes under `#Policy(copies: .Explicit)` are the copies the default policy
// makes implicitly. Sema spans point into the source as read, so marks go in
// before any package-target migration.
jet_cli_fmt_explicit_copies: fn(source: String, origin: String, color: Bool) -> JetCLIFmtSource {
    if jet_cli_compile_file(origin, color, None, JetDriverCompileMode.Program) == {
        .Refused(refusal) -> return JetCLIFmtSource{text: "", diagnostics: [Diagnostic]{}, report: Val(refusal.stderr)}
        .Compiled(result, snapshot) -> {
            diagnostics: jet_driver_present_diagnostics(result.diagnostics, snapshot, result.generated_source_files)
            if jet_cli_errors(diagnostics).len() > 0 -> return jet_cli_fmt_rejected(diagnostics)
        }
    }
    shift: JET_CLI_FMT_EXPLICIT_COPIES_POLICY.len()
    sites := [Int]{}
    if jet_cli_compile_entry(origin, color, None, JetDriverCompileMode.Program, Val("{JET_CLI_FMT_EXPLICIT_COPIES_POLICY}{source}"), None) == .Compiled(result, snapshot) {
        loop diagnostic in jet_driver_present_diagnostics(result.diagnostics, snapshot, result.generated_source_files) {
            owner: diagnostic.origin ?? next
            edit: diagnostic.edit ?? next
            if owner.path != snapshot.entry_path || edit.new_text != ".copy()" || edit.span.start != edit.span.end -> next
            site: edit.span.start - shift
            if site >= 0 && site <= source.len() && !sites.contains(site) -> sites.push(site)
        }
    }
    sites.sort()
    marked := ""
    cursor := 0
    loop site in sites {
        marked = "{marked}{source.slice(cursor..<site)}.copy()"
        cursor = site
    }
    jet_cli_fmt_formatted("{marked}{source.slice(cursor..<source.len())}")
}

// `format_source_for_fmt`: `package.jet` through the Package model; otherwise
// optional copy marks, the retired package-target rewrite, the Package model
// for a `Config` record, then the ordinary formatter.
jet_cli_fmt_format_source: fn(source: String, origin: String, explicit_copies: Bool, simplify: Bool, color: Bool) -> JetCLIFmtSource {
    if jet_cli_fmt_is_package_manifest_file(origin) -> return jet_cli_fmt_package_manifest(source, origin)
    marked := source
    if explicit_copies && cli_files.is_file(origin) && !jet_cli_fmt_is_typed_package_source(source, origin) {
        copies: jet_cli_fmt_explicit_copies(source, origin, color)
        if copies.report != None || copies.diagnostics.len() > 0 -> return copies
        marked = copies.text
    }
    copy_marks_inserted: marked != source
    materialized: marked
    // A Config binding also parses as ordinary Jet, but its record fields
    // belong to the Package model; prefer that formatter so the file keeps
    // the shape the typed loader accepts.
    if jet_cli_fmt_is_typed_package_source(materialized, origin) {
        if pkg_format_source(materialized, origin) == .Ok(formatted) -> return jet_cli_fmt_formatted(formatted)
    }
    result: jet_cli_fmt_ordinary(materialized, simplify)
    if result.ok -> return jet_cli_fmt_formatted(result.text)
    // The source checked clean, so marks that do not parse are a defect in
    // the copy-site data (E0122), never carets on the user's source.
    if copy_marks_inserted -> return jet_cli_fmt_rejected([Diagnostic]{pkg_manifest_diagnostic_from_row("E0122", [ManifestEntry]{ManifestEntry{key: "file", value: origin}}, None)})
    jet_cli_fmt_rejected(result.diagnostics)
}

// The ordinary formatter with one leading inline `package: { … }` carrier kept
// exactly as written: the carrier and the trivia before it are masked from the
// parser formatter and restored in front of its output, so Package fields stay
// owned by the Package model.
jet_cli_fmt_ordinary: fn(source: String, simplify: Bool) -> JetFormatResult {
    carrier: jet_driver_inline_package(source)
    if carrier.error == .Val(error) -> return JetFormatResult{ok: false, text: "", diagnostics: [Diagnostic]{error}}
    if !carrier.found -> return jet_format_source(source, simplify)
    masked := jet_driver_mask_inline_package(source, carrier).bytes()
    loop offset in 0..<carrier.start {
        if masked[offset] != (U8{10}) && masked[offset] != (U8{13}) -> masked[offset] = U8{32}
    }
    ordinary: String.from_bytes(masked) ?? panic("masking keeps the source UTF-8")
    formatted: jet_format_source(ordinary, simplify)
    if !formatted.ok -> return formatted
    kept: String.from_bytes(source.bytes()[0..<carrier.end]) ?? panic("the carrier ends on a character boundary")
    if formatted.text == "" -> return JetFormatResult{ok: true, text: kept, diagnostics: [Diagnostic]{}}
    separator: if kept.ends_with("\n") || kept.ends_with("\r") -> "" else -> "\n"
    JetFormatResult{ok: true, text: "{kept}{separator}{formatted.text}", diagnostics: [Diagnostic]{}}
}

// Format one source (`run_fmt` preflight).
jet_cli_fmt_one: fn(path: String, source: String, request: JetCLIFmtRequest) -> JetCLIFmtFile {
    formatted: jet_cli_fmt_format_source(source, path, request.explicit_copies, request.simplify, request.color)
    if formatted.report != None || formatted.diagnostics.len() > 0 {
        return JetCLIFmtFile{path: path, original: source, formatted: "", changed: false, io_error: None, diagnostics: formatted.diagnostics, report: formatted.report}
    }
    JetCLIFmtFile{
        path: path,
        original: source,
        formatted: formatted.text,
        changed: formatted.text != source,
        io_error: None,
        diagnostics: [Diagnostic]{},
        report: None,
    }
}

// One `git` query's `.jet` names joined onto `cwd` (`collect_changed_files`).
jet_cli_fmt_git_changed: fn(argv: [String], cwd: String, found: &[String]) {
    receipt: cli_process.cmd(argv).run() ?? return
    if !receipt.success -> return
    loop line in receipt.output.lines() {
        if !line.ends_with(".jet") -> next
        path: if cwd.ends_with("/") -> "{cwd}{line}" else -> "{cwd}/{line}"
        if cli_files.is_file(path) && !found.contains(path) -> found.push(path)
    }
}

// `collect_changed_files`: the `.jet` files git reports changed against HEAD or
// staged; None outside a git worktree.
jet_cli_fmt_changed_files: fn() -> [String]? {
    probe: cli_process.cmd([String]{"git", "rev-parse", "--is-inside-work-tree"}).run() ?? return None
    if !probe.success -> return None
    cwd: cli_files.cwd() ?? "."
    found := [String]{}
    jet_cli_fmt_git_changed([String]{"git", "diff", "--name-only", "HEAD"}, cwd, found)
    jet_cli_fmt_git_changed([String]{"git", "diff", "--name-only", "--cached"}, cwd, found)
    found.sort()
    Val(found)
}

// Rust `Path::strip_prefix(display_root)`, else the path as given.
jet_cli_fmt_relative: fn(path: String, root: String) -> String Never! {
    if path == root -> return ""
    prefix: if root.ends_with("/") -> root else -> "{root}/"
    if path.starts_with(prefix) -> return path.slice(prefix.len()..<path.len())
    // copy: `path` stays with the caller (`path` is a read parameter: no move out of it, E0201) and
    // the returned value owns its own.
    path.copy()
}

// ---- `jet fmt --lang` ----

// Flags the environment run takes unchanged.
JET_CLI_EXTERNAL_FMT_FORWARDED: [String]{"--trust", "--offline", "--online", "--no-color", "--json", "--flake", "--pure", "--yes", "-y"}

// Rust `str::trim_start_matches` for a string prefix.
jet_cli_trim_start_matches: fn(text: String, prefix: String) -> String Never! {
    rest := text
    loop prefix.len() > 0 && rest.starts_with(prefix) {
        rest = rest.slice(prefix.len()..<rest.len())
    }
    rest
}

jet_cli_external_fmt_fail: fn(code: String, what: String, why: String, fix: String, color: Bool, exit_code: Int) -> JetDriverVerbOutput Never! {
    jet_cli_report_output("", code, what, why, fix, color, exit_code)
}

// `find_env_root`: the nearest directory at or above `start` that holds
// `env.jet`.
jet_cli_find_env_root: fn(start: String) -[FS]> String? Never! {
    current := start
    loop {
        if cli_files.is_file(jet_cli_authority_path(current, ENV_FILE)) -> return Val(current)
        if current == "/" -> return None
        current = jet_cli_parent(current) ?? return None
    }
}

// `external_formatter_program`: the formatter package's name (no `@source`, no
// `#selector`, the last `/` or `:` segment), trimmed.
jet_cli_external_formatter_program: fn(package: String) -> String? Never! {
    name: package.split("@").to_list()[0].split("#").to_list()[0]
    start := 0
    bytes: name.bytes()
    loop index in 0..<bytes.len() {
        code: Int.from_u8(bytes[index])
        if code == 47 || code == 58 -> start = index + 1
    }
    program: name.slice(start..<name.len()).trim()
    if program == "" || envmodel_has_whitespace(program) -> return None
    Val(program)
}

// Rust `Path::extension(path) == Some(language)`: the text after the last
// `.` of the file name, when that `.` is not the name's first byte.
jet_cli_external_fmt_matches: fn(path: String, language: String) -> Bool Never! {
    name: jet_cli_fmt_file_name(path)
    bytes: name.bytes()
    dot := -1
    loop index in 0..<bytes.len() {
        if Int.from_u8(bytes[index]) == 46 -> dot = index
    }
    if dot <= 0 -> return false
    name.slice((dot + 1)..<name.len()) == language
}

// Rust `Path` ordering: component by component, so `a/b` sorts before
// `a.nix` (`BTreeSet<PathBuf>` in `collect_external_fmt_files`).
jet_cli_external_fmt_path_less: fn(left: String, right: String) -> Bool Never! {
    left_parts: left.split("/").to_list()
    right_parts: right.split("/").to_list()
    index := 0
    loop index < left_parts.len() && index < right_parts.len() {
        if left_parts[index] != right_parts[index] -> return left_parts[index] < right_parts[index]
        index += 1
    }
    left_parts.len() < right_parts.len()
}

// `walk_external_fmt_files`: sorted, recursive, the ignored directories
// skipped, symbolic links never followed.
jet_cli_external_fmt_walk: fn(directory: String, language: String, files: &[String]) {
    names := cli_files.listdir(directory) ?? return
    names.sort()
    loop name in names {
        path: jet_cli_authority_path(directory, name)
        stat: cli_files.stat(path) ?? next
        if stat.is_symlink -> next
        if stat.is_dir {
            if !JET_CLI_FMT_IGNORED_DIRS.contains(name) -> jet_cli_external_fmt_walk(path, language, files)
        } else if stat.is_file && jet_cli_external_fmt_matches(path, language) {
            files.push(path)
        }
    }
}

// `collect_external_fmt_files`: the environment root's files for `language`, or
// those under each explicit path; sorted and unique. Returns the problem text
// when an explicit path cannot be inspected.
jet_cli_external_fmt_collect: fn(cwd: String, project_dir: String, explicit_paths: [String], language: String, files: &[String]) -> String? {
    found := [String]{}
    if explicit_paths.len() == 0 {
        jet_cli_external_fmt_walk(project_dir, language, found)
    } else {
        loop raw in explicit_paths {
            path: if raw.starts_with("/") -> raw else -> jet_cli_authority_path(cwd, raw)
            stat: cli_files.stat(path) ?? return Val("{path}: {jet_cli_io_error_text(err)}")
            if stat.is_symlink -> next
            if stat.is_dir {
                jet_cli_external_fmt_walk(path, language, found)
            } else if stat.is_file && jet_cli_external_fmt_matches(path, language) {
                found.push(path)
            }
        }
    }
    position := 1
    loop position < found.len() {
        // copy: `found[position]` stays in its list (owner: `found`; no move out of an element,
        // E0225) and the binding `current` owns its own.
        current: found[position].copy()
        slot := position
        loop slot > 0 && jet_cli_external_fmt_path_less(current, found[slot - 1]) {
            found[slot] = found[slot - 1]
            slot -= 1
        }
        found[slot] = current
        position += 1
    }
    loop path in found {
        if files.len() == 0 || files[files.len() - 1] != path -> files.push(path)
    }
    None
}

// `external_fmt_changed_files`: root-relative files Git reports changed against
// HEAD, staged, or untracked. Returns the problem text when Git cannot answer a
// `diff`.
jet_cli_external_fmt_changed: fn(root: String, changed: &[String]) -> String? {
    queries: [[String]]{[String]{"diff", "--name-only", "HEAD"}, [String]{"diff", "--name-only", "--cached"}, [String]{"ls-files", "--others", "--exclude-standard"}}
    loop query in queries {
        argv := [String]{"git", "-C", root}
        loop part in query -> argv.push(part)
        receipt: cli_process.cmd(argv).run() ?? return Val(jet_cli_io_error_text(err))
        if !receipt.success && query[0] == "diff" -> return Val(receipt.errors.trim())
        loop line in receipt.output.lines() {
            relative: line.trim().replace("\\", "/")
            if relative != "" && cli_files.is_file(jet_cli_authority_path(root, relative)) && !changed.contains(relative) -> changed.push(relative)
        }
    }
    None
}

// `fmt_json_ok` / `fmt_json_dirty_*`: the `fmt` status line.
jet_cli_external_fmt_status: fn(status: String, files: [JetCLIStatusValue]?) -> String Never! {
    fields := [JetCLIStatusField]{jet_cli_status_field("status", jet_cli_status_text(status))}
    if files == .Val(entries) -> fields.push(jet_cli_status_field("files", jet_cli_status_array(entries)))
    "{jet_cli_status_render("fmt", status == "ok", [JetCLIStatusField]{jet_cli_status_field("fmt", jet_cli_status_object(fields))})}\n"
}

// A clean run: the `ok` status line under `--json`, nothing otherwise.
jet_cli_external_fmt_ok: fn(json: Bool) -> JetDriverVerbOutput Never! {
    stdout: if json -> jet_cli_external_fmt_status("ok", None) else -> ""
    JetDriverVerbOutput{stdout: stdout, stderr: "", exit_code: JET_DRIVER_EXIT_OK}
}

// A staging directory (`ExternalFmtTempDir::new`), or the problem text.
JetCLIExternalFmtTemp: struct {
    path: String
    problem: String?
}

// `ExternalFmtTempDir::new`: `jet-fmt-<ns>-<pid>-<attempt>` under the
// system temporary directory, skipping names that already exist.
jet_cli_external_fmt_temp_dir: fn() -> JetCLIExternalFmtTemp {
    base: cli_sys.get("TMPDIR") ?? "/tmp"
    stamp: cli_time.unix_ns()
    pid: cli_process.current_pid()
    loop attempt in 0..<32 {
        path: jet_cli_authority_path(base, "jet-fmt-{stamp}-{pid}-{attempt}")
        if cli_files.exists(path) -> next
        cli_files.create_dir_all(path) ?? return JetCLIExternalFmtTemp{path: "", problem: Val(jet_cli_io_error_text(err))}
        return JetCLIExternalFmtTemp{path: path, problem: None}
    }
    JetCLIExternalFmtTemp{path: "", problem: Val("could not allocate a formatter staging directory")}
}

// The staged half of `run_external_fmt`: copy each input into `temp`, run
// the formatter through `jetpack env … -- <program> <staged…>`, then hand the
// staged outputs to the continuation (ExternalFormat.jet).
jet_cli_external_fmt_staged: fn(temp: String, project_dir: String, program: String, files: [String], child_flags: [String], check_only: Bool, show_diff: Bool, json: Bool, color: Bool) -> JetDriverVerbOutput {
    command := [String]{"env"}
    loop flag in child_flags -> command.push(flag.copy())
    command.push("--")
    command.push(program.copy())
    staged := [String]{}
    befores := [[U8]]{}
    loop index in 0..<files.len() {
        source_path: files[index]
        before: cli_files.read_bytes(source_path) ?? return jet_cli_external_fmt_fail("E1340", "could not read `{source_path}`", jet_cli_io_error_text(err), "fix the file permissions and retry", color, JET_DRIVER_EXIT_USAGE)
        staged_path: jet_cli_authority_path(temp, "{jet_cli_zero_pad(index, 4)}-{jet_cli_fmt_file_name(source_path)}")
        cli_files.write_bytes(staged_path, before) ?? return jet_cli_external_fmt_fail("E1340", "could not stage formatter inputs", jet_cli_io_error_text(err), "fix the temporary directory and retry", color, JET_DRIVER_EXIT_USAGE)
        command.push(staged_path.copy())
        staged.push(staged_path)
        befores.push(before)
    }
    dispatched: jet_cli_engine_dispatch(JET_CLI_JETPACK_BINARY, "env", command)
    if dispatched.exit_code != JET_DRIVER_EXIT_OK -> return dispatched
    jet_cli_external_fmt_finish(project_dir, files, staged, befores, check_only, show_diff, json, color)
}

// `jet fmt --lang <language>`: `raw` starts at `fmt`. Jet evaluates the
// environment's formatter fact itself, stages the inputs, and asks the Jetpack
// engine only to realize the environment and run that formatter over the staged
// copies.
jet_cli_external_fmt: fn(raw: [String], color: Bool) -> JetDriverVerbOutput {
    language := String?{None}
    explicit_paths := [String]{}
    child_flags := [String]{}
    preset := String?{None}
    environment := String?{None}
    check_only := false
    show_diff := false
    changed_only := false
    index := 1
    loop index < raw.len() {
        argument: raw[index]
        if {
            argument == "--lang" -> {
                index += 1
                language = if index < raw.len() -> Val(raw[index]) else -> None
            }
            argument.starts_with("--lang=") -> language = Val(jet_cli_trim_start_matches(argument, "--lang="))
            argument == "--check" -> check_only = true
            argument == "--diff" || argument == "--dry-run" -> {
                check_only = true
                show_diff = true
            }
            argument == "--changed" -> changed_only = true
            argument == "--fixtures" || argument == "--preset" || argument == "--env" -> {
                index += 1
                if index >= raw.len() -> return jet_cli_external_fmt_fail("E2104", "{argument} needs a value", "these options select the realized environment", "pass a value after the option", color, JET_DRIVER_EXIT_USAGE)
                if argument == "--preset" -> preset = Val(raw[index])
                if argument == "--env" -> environment = Val(raw[index])
                child_flags.push(argument.copy())
                child_flags.push(raw[index])
            }
            argument.starts_with("--fixtures=") -> {
                child_flags.push("--fixtures")
                child_flags.push(jet_cli_trim_start_matches(argument, "--fixtures="))
            }
            argument.starts_with("--preset=") -> {
                preset = Val(jet_cli_trim_start_matches(argument, "--preset="))
                child_flags.push("--preset")
                child_flags.push(jet_cli_trim_start_matches(argument, "--preset="))
            }
            argument.starts_with("--env=") -> {
                environment = Val(jet_cli_trim_start_matches(argument, "--env="))
                child_flags.push("--env")
                child_flags.push(jet_cli_trim_start_matches(argument, "--env="))
            }
            JET_CLI_EXTERNAL_FMT_FORWARDED.contains(argument) || argument.starts_with("--color=") -> child_flags.push(argument.copy())
            argument == "--" -> return jet_cli_external_fmt_fail("E2104", "jet fmt --lang does not accept a command separator", "Jet supplies the staged files to the environment formatter", "pass formatter input paths before `--`", color, JET_DRIVER_EXIT_USAGE)
            argument.starts_with("-") -> return jet_cli_external_fmt_fail("E2102", "unknown external formatter option `{argument}`", "Jet forwards only environment selection and formatter mode flags", "run `jet fmt --help` or remove the unknown option", color, JET_DRIVER_EXIT_USAGE)
            else -> explicit_paths.push(argument.copy())
        }
        index += 1
    }
    named := ""
    if language == .Val(value) -> named = jet_cli_trim_start_matches(value.trim(), ".")
    if named == "" || envmodel_has_whitespace(named) || named.contains("/") || named.contains("\\") {
        return jet_cli_external_fmt_fail("E2104", "jet fmt needs --lang <language>", "non-Jet formatting is selected by a file-language name", "run `jet fmt --lang nix` or omit `--lang` for Jet files", color, JET_DRIVER_EXIT_USAGE)
    }
    json: raw.contains("--json")
    cwd: cli_files.cwd() ?? "."
    project_dir: jet_cli_find_env_root(cwd) ?? return jet_cli_external_fmt_fail("E1340", "jet fmt --lang needs an env.jet", "the external formatter is an environment package fact", "run from a realized environment project containing env.jet", color, JET_DRIVER_EXIT_USER_ERROR)
    env_path: jet_cli_authority_path(project_dir, ENV_FILE)
    source: cli_files.read(env_path) ?? return jet_cli_external_fmt_fail("E1340", "could not read `{env_path}`", jet_cli_io_error_text(err), "fix the environment file and retry", color, JET_DRIVER_EXIT_USER_ERROR)
    plan: if envmodel_evaluate_env_with_selections(source, project_dir, preset, environment) == {
        .Ok(evaluated) -> evaluated
        .Err(error) -> {
            return JetDriverVerbOutput{stdout: "", stderr: diagnostic_render_all(ENV_FILE, source, [Diagnostic]{error.diagnostic}, false), exit_code: JET_DRIVER_EXIT_USER_ERROR}
        }
    }
    formatter: plan.lifecycle.formatter ?? return jet_cli_external_fmt_fail("E1340", "no formatter is declared for language {named}", "jet fmt --lang delegates through the selected environment formatter fact", "declare a formatter package in the selected env module", color, JET_DRIVER_EXIT_USER_ERROR)
    program: jet_cli_external_formatter_program(formatter.package) ?? return jet_cli_external_fmt_fail("E1340", "the environment formatter package has no executable name", "Jetpack realizes formatter packages, and Jet invokes their package name", "use a formatter package such as `pkgs.nixfmt`", color, JET_DRIVER_EXIT_USER_ERROR)
    files := [String]{}
    if jet_cli_external_fmt_collect(cwd, project_dir, explicit_paths, named, files) == .Val(problem) {
        return jet_cli_external_fmt_fail("E1340", "could not discover formatter input files", problem, "fix the named path or run the formatter from the environment root", color, JET_DRIVER_EXIT_USAGE)
    }
    if changed_only {
        changed := [String]{}
        if jet_cli_external_fmt_changed(project_dir, changed) == .Val(problem) {
            return jet_cli_external_fmt_fail("E1340", "--changed needs a readable Git worktree", problem, "run inside a Git worktree or remove --changed", color, JET_DRIVER_EXIT_USAGE)
        }
        kept := [String]{}
        loop path in files {
            if path.starts_with("{project_dir}/") && changed.contains(jet_cli_fmt_relative(path, project_dir)) -> kept.push(path)
        }
        files = kept
    }
    if files.len() == 0 -> return jet_cli_external_fmt_ok(json)
    temp: jet_cli_external_fmt_temp_dir()
    if temp.problem == .Val(problem) -> return jet_cli_external_fmt_fail("E1340", "could not stage formatter inputs", problem, "fix the temporary directory and retry", color, JET_DRIVER_EXIT_USAGE)
    output: jet_cli_external_fmt_staged(temp.path, project_dir, program, files, child_flags, check_only, show_diff, json, color)
    cli_files.rmtree(temp.path).drop("a leftover formatter staging directory is harmless")
    output
}
// The process's stdin, stdout and stderr is-terminal host facts, as the three
// ASCII `0`/`1` bytes the receipt context identity frames (Rust IsTerminal),
// read through the compiler-private raw leaf `core.term.jet_term_is_terminal_raw`.
jet_cli_terminal_bits: fn() -> [U8] {
    bits := [U8]{}
    loop fd in 0..<3 -> bits.push(if cli_term.jet_term_is_terminal_raw(fd) -> U8{49} else -> U8{48})
    bits
}

// `run_completions` caps a program's metadata read here.
JET_CLI_COMPLETION_PROGRAM_MAX: 536870912
JET_CLI_COMPLETION_READ_CHUNK: 16777216

// `jet self completions <shell> --for <program>`: one non-blocking open
// (compiler-private raw leaf `core.files.jet_std_files_open_reader_nonblocking`, so a FIFO never
// waits for a writer), then that same handle's metadata and a bounded read.
// The program is never run.
jet_cli_completion_program: fn(shell: String, program: String, name: String) -> JetCLIPlan {
    reader: cli_files.jet_std_files_open_reader_nonblocking(program) ?? return jet_cli_program_completion_error(program, "the program could not be opened ({jet_cli_io_error_text(err)})")
    metadata: reader.stat() ?? return jet_cli_program_completion_error(program, "the opened program could not be inspected ({jet_cli_io_error_text(err)})")
    if !metadata.is_file -> return jet_cli_program_completion_error(program, "the program is not a regular file")
    if metadata.size > JET_CLI_COMPLETION_PROGRAM_MAX -> return jet_cli_program_completion_error(program, "the program is larger than the 512 MiB metadata-reader limit")
    bytes := List<U8>.try_with_capacity(metadata.size) ?? panic("program metadata allocation failed")
    loop bytes.len() <= JET_CLI_COMPLETION_PROGRAM_MAX {
        want: JET_CLI_COMPLETION_PROGRAM_MAX + 1 - bytes.len()
        chunk: reader.read(if want < JET_CLI_COMPLETION_READ_CHUNK -> want else -> JET_CLI_COMPLETION_READ_CHUNK) ?? return jet_cli_program_completion_error(program, "the opened program could not be read ({jet_cli_io_error_text(err)})")
        if chunk.len() == 0 -> break
        bytes.extend(chunk)
    }
    if bytes.len() > JET_CLI_COMPLETION_PROGRAM_MAX -> return jet_cli_program_completion_error(program, "the program grew beyond the 512 MiB metadata-reader limit while being read")
    jet_cli_program_completion_metadata(shell, name, program, bytes, JET_COMPILER_TARGET_USIZE_MAX)
}

// The project's canonical entry as an authorized load-only request (no
// semantic compile); None when the project has no readable entry.
jet_cli_project_source_request: fn(root: String, command: String, color: Bool) -> JetDriverCompileRequest? {
    notices := [String]{}
    if jet_cli_find_project_entry(root, command, color, notices) == .Entry(found) {
        if jet_cli_prepare_overlays(found.path, found.path, [JetCLIOverlay]{}, color, None, JetDriverCompileMode.Doc) == {
            .Refused(_) -> {}
            .Prepared(request, _) -> return Val(request)
        }
    }
    None
}

jet_cli_schema_host: fn(action: String, root: String, before: String, color: Bool, json: Bool) -> JetDriverVerbOutput {
    request: jet_cli_project_source_request(root, "inspect schema {action}", color)
    if action == "status" -> return jet_cli_schema_status_host(root, request)
    jet_cli_schema_squash_host(root, request, before, color, json)
}

// `jet explain` policy essays over the authorized load-only query of `file`.
jet_cli_policy_explain_host: fn(key: PolicyKey, file: String, site: String?, line: U64?, color: Bool, json: Bool) -> JetCLIPlan {
    if jet_cli_prepare_overlays(file, file, [JetCLIOverlay]{}, color, None, JetDriverCompileMode.Doc) == {
        .Refused(output) -> return JetCLIPlan.Done{output: output}
        .Prepared(request, _) -> return jet_cli_explain_loaded_policy(key, jet_driver_source_query(request), site, line, color, json)
    }
}

// `jet explain web.BadPath [file]`: the library diagnostic type's texts over
// the authorized load-only request of `file`.
jet_cli_diagnostic_type_explain_host: fn(name: String, file: String, color: Bool, json: Bool) -> JetCLIPlan {
    if jet_cli_prepare_overlays(file, file, [JetCLIOverlay]{}, color, None, JetDriverCompileMode.Doc) == {
        .Refused(output) -> return JetCLIPlan.Done{output: output}
        .Prepared(request, _) -> return jet_cli_explain_loaded_diagnostic_type(name, jet_driver_source_query(request), color, json)
    }
}

// `run`/`append_external_writers`: the authorized load-only request of `file`,
// its external gate rows extended by the canonical writers (the entry package's
// and lock's authority rows, the actual trust store's typed records, then the
// written invocation choices in `args`), queried without checking bodies.
// Transfer the prepared request when replacing its ledger; its execution host
// cannot be copied.
jet_cli_gates_run: fn(file: String, args: [String], color: Bool, json: Bool) -> JetDriverVerbOutput {
    prepared: jet_cli_prepare_overlays(file, file, [JetCLIOverlay]{}, color, None, JetDriverCompileMode.Doc)
    if prepared == {
        .Refused(output) -> return output.move()
        .Prepared(request, snapshot) -> {
            gated := request.move()
            gated.external_gate_entries = jet_cli_external_gate_rows(gated.external_gate_entries.move(), snapshot, args)
            return jet_cli_gates_host(gated, args, file, color, json)
        }
    }
}

// The request's own external gate rows, then the package/lock writers, the
// trust store's records and the invocation choices in `args`, in the order
// `append_external_writers` writes them.
jet_cli_external_gate_rows: fn(external: &&[GateEntry], snapshot: JetDriverAuthorizedSourceSnapshot, args: [String]) -> [GateEntry] {
    ledger := GateLedger{}
    loop entry in external.move() -> gate_ledger_push(ledger, entry)
    jet_cli_gate_append_package_writers(ledger, snapshot)
    store: trust_store_path()
    trusted: jet_cli_gate_trust_entries(store, trust_list_records(store))
    loop entry in trusted.move() -> gate_ledger_push(ledger, entry)
    jet_cli_gate_append_invocation(ledger, args)
    ledger.rows
}

// `run_output`: the canonical Output query (run intent, dev profile) over the
// authorized request of `file`.
jet_cli_output_run: fn(file: String, address: String?, color: Bool, json: Bool) -> JetDriverVerbOutput {
    prepared: jet_cli_prepare_overlays(file, file, [JetCLIOverlay]{}, color, None, JetDriverCompileMode.Doc)
    if prepared == {
        .Refused(output) -> return output.move()
        .Prepared(request, _) -> return jet_cli_output_host(request, address, file, json)
    }
}

jet_cli_maintenance_host: fn(action: String, args: [String], color: Bool, json: Bool) -> JetDriverVerbOutput {
    if action == {
        "new-ui" -> return jet_cli_devtools_new_ui(args, color, json)
        "check-fixture-paths" -> return jet_cli_devtools_fixture_paths(color, json)
        "reduce" -> return jet_cli_devtools_reduce(args, color, json)
        else -> return jet_cli_devtools_ice_report(args, color, json)
    }
}

// The process arguments after argv[0], with the installed compiler aliases
// (Docs/spec/reference/cc-driver.md) turned into their verbs: a `jet` binary
// invoked as `jet-cc` runs `jet cc`, and as `jet-cxx` or `jet-c++` runs
// `jet c++`. Every other name passes the arguments through unchanged.
jet_cli_alias_args: fn(argv: [String]) -> [String] Never! {
    if argv.len() == 0 -> return [String]{}
    rest: argv[1..<argv.len()]
    name: jet_cli_file_name(argv[0].replace("\\", "/"))
    stem: if name.ends_with(".exe") -> name.slice(0..<(name.len() - 4)) else -> name
    verb := ""
    if stem == "jet-cc" -> verb = "cc"
    if stem == "jet-cxx" || stem == "jet-c++" -> verb = "c++"
    if verb == "" -> return rest
    args := [String]{verb}
    loop argument in rest -> args.push(argument)
    args
}

// Unannotated because the compile verbs are (Request.jet `jet_cli_compile_file`).
// A compiling verb's compile traces through the process's one sink: the
// target of `--trace[=FILE]` (which the front door admits only on those
// verbs), else of JET_TRACE_FILE (Request.jet `jet_cli_trace_sink`).
// A verb that holds a compile result ends the process itself (jet_cli_finish);
// every other verb's output is written here, as its `--json` outcome
// (jet_cli_json_outcome), and its exit code returned to
// run.jet, which exits with it. This is round 3's entry shape: every seed
// (a0_001 included) checks and lowers it.
jet_cli_main: fn(args: [String]) -> Int {
    plan: jet_cli_front(args)
    owned: jet_cli_owned_flags(args)
    recording := JetCLICheckRecording?{None}
    if jet_cli_check_receipt_begin(args, plan) == {
        .Replay(replayed) -> {
            jet_cli_write_output(replayed)
            return replayed.exit_code
        }
        .Run(claimed) -> recording = claimed
    }
    done: if jet_cli_plan_compiles(plan) -> jet_cli_compile_on_worker(plan, jet_cli_trace_flag(owned), recording) else -> jet_cli_execute(plan)
    output: jet_cli_json_outcome(jet_cli_wants_json(owned), done)
    jet_cli_write_output(output)
    // A check that ends here (refused before its compile) is still recorded.
    if recording == .Val(claimed) -> jet_cli_check_receipt_publish(claimed, output, [JetCLIReceiptInput]{})
    output.exit_code
}

// Carry out a compiling verb's plan as a task, on a scheduler worker rather
// than the main thread. A compile recurses once per nesting level of an
// expression that it does not walk as a loop; for a left-leaning operator
// chain the deepest such recursion left is the drop of its expression tree,
// about 100 bytes a level, so a 100,000-term `a + a + ...` sum needs about
// 10 MiB (measured at the default -O0 `jet run`). That is more than the main
// thread's default 8 MiB and far less than a worker's stack (the runtime's
// thread_stack_bytes, at least 192 MiB). The program `jet run` launches keeps
// the main thread and every stack default. The trace sink is made on the
// worker, the thread the compile runs on.
jet_cli_compile_on_worker: fn(plan: &&JetCLIPlan, trace: String?, recording: JetCLICheckRecording?{None}) -> JetDriverVerbOutput {
    steps := [JetCLIRunStep]{}
    task.group compile_stack {
        compiling: task jet_cli_execute_compiling(plan, trace, recording)
        steps.push(compiling.join() ?? panic(compiler_threads_failure_text(err)))
    }
    step := steps.pop() ?? panic("the compile thread lost its step")
    jet_cli_run_step(step)
}

// A compiling plan, on its worker (jet_cli_compile_on_worker): `jet run`
// stops at the step the main thread finishes; every other verb at its output.
jet_cli_execute_compiling: fn(plan: &&JetCLIPlan, trace: String?, recording: JetCLICheckRecording?) -> JetCLIRunStep {
    trace_sink: jet_cli_trace_sink(trace)
    if plan == .Run(file, source, color, options, verbose, json, threads, program_args, invocation, notice, watch, entry) {
        if !watch {
            jet_cli_write_notice(notice)
            return jet_cli_compile_run(file, entry, source, color, options, verbose, json, threads, program_args, invocation, trace_sink)
        }
    }
    JetCLIRunStep.Output{output: jet_cli_execute(plan, trace_sink, recording)}
}

// A verb's output, written to the process's stdout and stderr.
jet_cli_write_output: fn(output: JetDriverVerbOutput) {
    if output.stdout.len() > 0 {
        out := cli_term.stdout()
        out.write(output.stdout).drop("jet stdout")
    }
    if output.stderr.len() > 0 {
        stderr_handle := cli_term.stderr()
        stderr_handle.write(output.stderr).drop("jet stderr")
    }
}

// The plans whose compile `--trace` and JET_TRACE_FILE trace.
jet_cli_plan_compiles: fn(plan: JetCLIPlan) -> Bool Never! {
    if plan == {
        .Check(_, _, _, _, _, _, _, _, _, _, _) | .CheckWorkspace(_, _, _, _, _, _, _, _, _) | .CheckPrelude(_, _, _, _, _, _) | .CheckCore(_, _, _, _, _) | .Build(_, _, _, _, _, _, _, _, _, _, _) | .BuildPackage(_, _, _, _, _, _, _, _) | .Run(_, _, _, _, _, _, _, _, _, _, _, _) | .DevWeb(_, _, _, _, _, _, _, _) | .Test(_, _, _, _, _, _) | .Emit(_, _, _, _, _, _) -> true
        else -> false
    }
}

// `jet build --locked`: the engine's locked fetch, then the build it guards,
// planned and carried out as `jet build` is (jet_cli_main).
jet_cli_locked_build_host: fn(check: [String], build: [String]) -> JetDriverVerbOutput {
    checked: jet_cli_engine_dispatch(JET_CLI_JETPACK_BINARY, "build --locked", check)
    if checked.exit_code != 0 -> return checked
    plan: jet_cli_locked_plan(jet_cli_front(build))
    if jet_cli_plan_compiles(plan) -> return jet_cli_compile_on_worker(plan, jet_cli_trace_flag(jet_cli_owned_flags(build)))
    jet_cli_execute(plan)
}

// The build `jet build --locked` guards, refusing a dependency effect row the
// lock doesn't cover (jet_cli_lock_effect_rows); a `build: fn` package build
// carries its own `locked` (jet_cli_build_package_as), and a refusal is kept.
jet_cli_locked_plan: fn(plan: &&JetCLIPlan) -> JetCLIPlan Never! {
    if plan == {
        .Build(file, source, color, options, threads, invocation, notice, json, sbom, quiet, verbose) -> {
            locked := options.move()
            locked.locked = true
            return JetCLIPlan.Build{file: file.move(), source: source.move(), color: color, options: locked, threads: threads, invocation: invocation.move(), notice: notice.move(), json: json, sbom: sbom, quiet: quiet, verbose: verbose}
        }
        else -> {}
    }
    plan
}

// Carry out one plan; a host step that finishes as a plan runs that plan.
// `trace_sink` traces a compiling verb's compile (`jet_cli_main`).
jet_cli_execute: fn(plan: &&JetCLIPlan, trace_sink: JetCLITraceSink?{None}, recording: JetCLICheckRecording?{None}) -> JetDriverVerbOutput {
    output := JetDriverVerbOutput{stdout: "", stderr: "", exit_code: 0}
    if plan == {
        .Done(done) -> output = done.move()
        .Refused(report, color, exit_code, notice) -> output = JetDriverVerbOutput{stdout: "", stderr: "{notice}{diagnostic_render_all("", "", [Diagnostic]{report}, color)}", exit_code: exit_code}
        .Diagnostics(file, source, report, color, notice) -> output = jet_cli_diagnostics_output(file, source, report, color, false, notice)
        .Check(file, source, color, quiet, threads, project, notice, json, verbose, settings, profile) -> {
            jet_cli_write_notice(notice)
            output = jet_cli_compile_check(file, source, color, quiet, threads, project, json, verbose, settings, profile, trace_sink, true, recording)
        }
        .CheckWorkspace(files, sources, color, quiet, threads, notice, json, settings, profile) -> {
            jet_cli_write_notice(notice)
            output = jet_cli_check_workspace(files, sources, color, quiet, threads, json, settings, profile, trace_sink)
        }
        .CheckPrelude(file, source, color, quiet, threads, json) -> output = jet_cli_compile_prelude_check(file, source, color, quiet, threads, json, trace_sink)
        .CheckCore(core, color, quiet, threads, json) -> output = jet_cli_compile_core_check(core, color, quiet, threads, json, trace_sink)
        .Build(file, source, color, options, threads, invocation, notice, json, sbom, quiet, verbose) -> {
            jet_cli_write_notice(notice)
            output = jet_cli_compile_build(file, source, color, options, threads, invocation, json, sbom, quiet, verbose, trace_sink)
        }
        .BuildPackage(file, color, options, build_args, threads, invocation, notice, locked) -> {
            jet_cli_write_notice(notice)
            check: locked ?? [String]{}
            checked: if check.len() > 0 -> jet_cli_engine_dispatch(JET_CLI_JETPACK_BINARY, "build --locked", check) else -> JetDriverVerbOutput{stdout: "", stderr: "", exit_code: 0}
            output = if checked.exit_code != 0 -> checked else -> jet_cli_build_package(file, color, options, build_args, threads, invocation, locked != None, trace_sink)
        }
        .LockedBuild(check, build) -> output = jet_cli_locked_build_host(check, build)
        .Run(file, source, color, options, verbose, json, threads, program_args, invocation, notice, watch, entry) -> {
            jet_cli_write_notice(notice)
            output = if watch -> jet_cli_dev_loop(file, entry, color, options, verbose, json, threads, program_args, invocation, trace_sink) else -> jet_cli_run_step(jet_cli_compile_run(file, entry, source, color, options, verbose, json, threads, program_args, invocation, trace_sink))
        }
        .NativeSource(file, level, run, program_args, color) -> output = jet_cli_native_source(file, level, run, program_args, color)
        .DevWeb(file, _, color, options, threads, invocation, notice, port) -> {
            jet_cli_write_notice(notice)
            output = jet_cli_dev_web_loop(file, color, options, threads, invocation, port, trace_sink)
        }
        .Jobs(file, color, json, notice) -> {
            jet_cli_write_notice(notice)
            output = jet_cli_compile_jobs(file, color, json)
        }
        .Test(file, source, color, verbose, threads, options) -> output = jet_cli_compile_test(file, source, color, verbose, threads, options, trace_sink)
        .TestWorkspace(names, member_args, envs, executable, heading, results, tiers, quiet) -> output = jet_cli_test_workspace(names, member_args, envs, executable, heading, results, tiers, quiet)
        .TestProfile(profile, root, settings, runs, update, quiet) -> output = jet_cli_test_profile(profile, root, settings, runs, update, quiet)
        .New(name, template, annotated, quiet, json, color) -> output = jet_cli_new_project(name, template, annotated, quiet, json, color)

        .Doc(file, source, color, json, check) -> output = jet_cli_compile_doc(file, source, color, json, check)
        .Emit(file, source, color, json, tier, function) -> output = jet_cli_compile_emit(file, source, color, json, tier, function, trace_sink)
        .Fill(target, json, color) -> output = jet_cli_compile_fill(target, json, color)
        .Structural(argv, command, json) -> output = jet_cli_structural(argv, command, json)
        .Review(argv, json, color) -> output = jet_cli_review(argv, json, color)
        .Keygen(registry, force, color) -> output = jet_cli_keygen(registry, force, color)
        .KeyBackup(registry, dest, color) -> output = jet_cli_key_backup(registry, dest, color)
        .Publish(force, no_sign, quiet, color) -> output = jet_cli_publish(force, no_sign, quiet, color)
        .Yank(version, message, color) -> output = jet_cli_yank(version, message, color)
        .Lint(file, source, color, notice, category, raw, json) -> {
            jet_cli_write_notice(notice)
            output = if category == "complexity" -> jet_cli_lint_complexity(file, source, raw, color, json) else -> jet_cli_lint_a11y(file, source, color, json)
        }
        .Fmt(request) -> output = jet_cli_format_run(request, request.json)
        .FmtLang(argv, color) -> output = jet_cli_external_fmt(argv, color)
        .Fix(file, dry_run, all, markers, color, quiet, json, notice) -> {
            jet_cli_write_notice(notice)
            output = jet_cli_fix_run(file, dry_run, all, markers, color, quiet, json)
        }
        .Inspect(job) -> output = jet_cli_inspect_host(job)
        .InspectB(inspect_plan) -> output = jet_cli_inspect_b_host(inspect_plan)
        .ForeignBind(binder, args, color) -> output = jet_cli_foreign_bind(binder, args, color)
        .Perf(argv, color) -> output = jet_cli_perf(argv, color)
        .Semindex(file, color, json) -> output = jet_cli_compile_semindex(file, color, json)
        .Find(file, query, mode, json) -> output = jet_cli_compile_find(file, query, mode, json)
        .Eval(file, pure, color, json, notice) -> {
            jet_cli_write_notice(notice)
            output = jet_cli_compile_eval(file, pure, color, json)
        }
        .Cache(cache_args, json) -> output = jet_cli_cache(cache_args, json)
        .Remote(argv, json, color) -> output = jet_cli_remote(argv, json, color)
        .Comparison(target, argv, json) -> output = jet_cli_comparison_run(target, argv, json, jet_cli_terminal_bits())
        .Try(plan_path, keep, json) -> output = jet_cli_try_run(plan_path, keep, json)
        .Maintenance(action, maintenance_args, color, json) -> output = jet_cli_maintenance_host(action, maintenance_args, color, json)
        .Completion(shell, program, name) -> output = jet_cli_execute(jet_cli_completion_program(shell, program, name))
        .Schema(action, root, before, color, json) -> output = jet_cli_schema_host(action, root, before, color, json)
        .Codemod(action, path, yes, color, json) -> output = jet_cli_codemod_host(action, path, yes, color, json)
        .PolicyExplain(key, file, site, line, color, json) -> output = jet_cli_execute(jet_cli_policy_explain_host(key, file, site, line, color, json))
        .DiagnosticTypeExplain(name, file, color, json) -> output = jet_cli_execute(jet_cli_diagnostic_type_explain_host(name, file, color, json))
        .BuildFactExplain(key, file, profile, settings, module_value, color, json) -> output = jet_cli_execute(jet_cli_build_fact_explain_host(key, file, profile, settings, module_value, color, json))
        .Gates(file, gate_args, color, json, notice) -> {
            jet_cli_write_notice(notice)
            output = jet_cli_gates_run(file, gate_args, color, json)
        }
        .Output(file, address, color, json) -> output = jet_cli_output_run(file, address, color, json)
        .Doctor(online, apply, cross_target, color) -> output = jet_cli_doctor(online, apply, cross_target, color)
        .UpdateJet(root, channel, color, json, quiet) -> output = jet_cli_update_jet_pin(root, channel, COMPILER_VERSION, color, json, quiet)
        .AuditCopies(file, source, color, json, notice) -> {
            jet_cli_write_notice(notice)
            output = jet_cli_audit_copies(file, source, color, json)
        }
        .AuditForeign(file, source, color, json, notice) -> {
            jet_cli_write_notice(notice)
            output = jet_cli_audit_foreign(file, source, color, json)
        }
        .CompilerService(op) -> output = jet_cli_compiler_service(op)
        .Repl(project, preload, invocation, color) -> output = jet_cli_repl(project, preload, invocation, color)
        .LSP -> output = jet_cli_lsp()
        .ReplChild(invocation) -> output = jet_cli_repl_child(invocation)
        .EvalExpression(source, color, json) -> output = jet_cli_eval_expression(source, color, json)
        .Prove(target, lenses, capture, replay, color, json) -> output = jet_cli_prove_run(target, lenses, capture, replay, color, json)
        .RunRemote(target, jet_argv, args, passthrough, color, quiet, verbose, threads) -> output = jet_cli_remote_run_host(target, jet_argv, args, passthrough, color, quiet, verbose, threads)
        .Budget(options, root, entry, color) -> output = jet_cli_budget_run(options, root, entry, color)
    }
    output
}

// Stock `jet dev`: build and run the program; when any source of its package
// changes, stop it, rebuild and run it again. A build with errors prints them and
// waits for the next change. A source it can't securely read refuses the first
// build and ends `jet dev`, as it ends `jet run`. Otherwise it ends only when the
// user stops it.
JetCLIDevConfigured: enum {
    Config(config: JetDriverDevConfig)
    Refused(output: JetDriverVerbOutput)
}

// The package's dev configuration: its `dev: fn(d: Dev)`, or the stock loop.
jet_cli_dev_config: fn(file: String, source: String, color: Bool, threads: Int?) -> JetCLIDevConfigured {
    prepared: jet_cli_prepare_overlays(file, file, [JetCLIOverlay]{}, color, threads, JetDriverCompileMode.Doc)
    if prepared.move() == {
        .Refused(output) -> return JetCLIDevConfigured.Refused{output: output}
        .Prepared(request, _) -> {
            queried: jet_driver_query_dev_config(request)
            if queried.internal_problem == .Val(problem) -> return JetCLIDevConfigured.Refused{output: jet_cli_ice(problem)}
            if !queried.complete || jet_cli_errors(queried.diagnostics).len() > 0 {
                return JetCLIDevConfigured.Refused{output: JetDriverVerbOutput{stdout: "", stderr: jet_driver_report_problems(file, source, jet_cli_errors(queried.diagnostics), color, false), exit_code: JET_DRIVER_EXIT_USER_ERROR}}
            }
            return JetCLIDevConfigured.Config{config: queried.config}
        }
    }
}

jet_cli_dev_loop: fn(file: String, entry: String?, color: Bool, options: BuildOptions, verbose: Bool, json: Bool, threads: Int?, program_args: [String], invocation: JetCLIInvocationAuthority?, trace_sink: JetCLITraceSink?) -> JetDriverVerbOutput {
    root: jet_cli_manifest_root(jet_cli_parent(file) ?? ".") ?? (jet_cli_parent(file) ?? ".")
    hot_noted := false
    first := true
    loop {
        source: cli_files.read(file) ?? ""
        config := jet_driver_dev_config_stock()
        configured := true
        if jet_cli_dev_config(file, source, color, threads) == {
            .Config(found) -> config = found
            .Refused(output) -> {
                cli_term.eprint(output.stderr)
                configured = false
            }
        }
        stamp: jet_cli_dev_stamp(root, config.watch)
        child := JetCLIDevChild.Idle
        if config.configured && config.reload == "Hot" && !hot_noted {
            cli_term.eprint("jet dev: in-process hot reload isn't available yet; restarting the program on each change")
            hot_noted = true
        }
        compiled := jet_cli_compile_executable_file(file, entry, color, threads, options, trace_sink)
        if compiled.move() == {
            .Refused(refusal) -> {
                // jet_cli_dev_config printed the same refusal when it refused too.
                if first -> return JetDriverVerbOutput{stdout: "", stderr: if configured -> refusal.stderr else -> "", exit_code: refusal.exit_code}
                if configured -> cli_term.eprint(refusal.stderr)
            }
            .Checked(result, inputs, snapshot) -> if configured -> child = jet_cli_dev_start(jet_cli_run_build(file, source, color, options, verbose, json, invocation, result, inputs, snapshot), file, program_args, config.port, options, invocation, verbose, color)
        }
        first = false
        cli_term.eprint("jet dev: watching {root} (Ctrl-C to stop)")
        loop jet_cli_dev_stamp(root, config.watch) == stamp -> cli_time.sleep(200ms)
        if child == {
            .Memory(pid) -> x64_process_stop(pid)
            .File(running) -> {
                running.kill().drop("the program may already have exited")
                running.wait().drop("the stopped program's status is not reported")
            }
            .Idle -> {}
        }
        cli_term.eprint("jet dev: change detected, rebuilding")
    }
}

// The program `jet dev` runs: a child running the image from memory, else
// one running its file, else none (its build failed or it couldn't start).
JetCLIDevChild: enum {
    Idle
    Memory(pid: Int)
    File(child: ProcessChild)
}

// Start `jet dev`'s program from its build `built` (a failed build prints
// its report; jet_cli_dev_launch runs a built one).
jet_cli_dev_start: fn(built: JetCLIBuilt, file: String, program_args: [String], port: Int?, options: BuildOptions, invocation: JetCLIInvocationAuthority?, verbose: Bool, color: Bool) -> JetCLIDevChild {
    if built == {
        .Failed(output) -> {
            cli_term.eprint(output.stderr)
            JetCLIDevChild.Idle
        }
        .Image(executable, binary) -> jet_cli_dev_launch(executable, binary, file, program_args, port, options, invocation, verbose, color)
    }
}

// Run `jet dev`'s program `executable`: from memory in a child, as
// jet_cli_launch runs it, else from its file `binary`, written first. It
// gets the environment that lets it write a production-failure receipt;
// `port` is the dev server's (JET_DEV_PORT).
jet_cli_dev_launch: fn(executable: X64Executable, binary: String, file: String, program_args: [String], port: Int?, options: BuildOptions, invocation: JetCLIInvocationAuthority?, verbose: Bool, color: Bool) -> JetCLIDevChild {
    vars := jet_cli_production_receipt_env(file, program_args)
    if port == .Val(number) {
        vars.push(JetCLIEnvVar{name: "JET_DEV_PORT", value: "{number}"})
        cli_term.eprint("jet dev: dev server port {number} (JET_DEV_PORT)")
    }
    launch: jet_cli_launch_plan(file, program_args, options, invocation, vars)
    loaded: x64_executable_load(executable)
    reason := loaded.failure
    if reason == "" {
        spawned: x64_image_spawn(loaded, launch, [Int]{})
        x64_image_unload(loaded)
        if spawned.failure == "" {
            jet_cli_perf_map(executable, spawned.pid)
            return JetCLIDevChild.Memory{pid: spawned.pid}
        }
        reason = spawned.failure
    }
    if verbose -> cli_term.eprint("jet dev: running {binary} from a file: {reason}")
    fix: "correct the named problem; jet dev reruns on the next change"
    if jet_cli_build_dir(jet_cli_parent(binary) ?? ".", color) == .Val(refused) {
        cli_term.eprint(refused.stderr)
        return JetCLIDevChild.Idle
    }
    if jet_cli_native_write(binary, executable) == .Val(failure) {
        cli_term.eprint(jet_cli_native_report(file, "run", failure, color).stderr)
        return JetCLIDevChild.Idle
    }
    argv := [String]{binary}
    loop argument in program_args -> argv.push(argument.copy())
    spec := cli_process.cmd(argv)
    loop variable in vars -> spec = spec.env(variable.name.copy(), variable.value.copy())
    if spec.stdin(.Inherit).stdout(.Inherit).stderr(.Inherit).spawn() == {
        .Ok(spawned) -> return JetCLIDevChild.File{child: spawned}
        .Err(error) -> cli_term.eprint(jet_cli_report("E2105", "couldn't run the built program: {error}", jet_cli_why("E2105"), fix, color))
    }
    JetCLIDevChild.Idle
}

// A change stamp over the package's .jet sources plus every file under the `d.watch` paths
// (relative to the package root): the latest modification time in nanoseconds, plus the
// file count so that an added or removed file also counts as a change. Two edits within
// one second are two changes.
jet_cli_dev_stamp: fn(root: String, watch: [String]) -[FS]> String Never! {
    files := [String]{}
    loop path in jet_cli_dev_files(root) {
        if path.ends_with(".jet") && !path.starts_with("{root}/.jet/") -> files.push(path)
    }
    loop path in watch {
        full: jet_cli_entry_join(root, path)
        if cli_files.is_dir(full) {
            loop watched in jet_cli_dev_files(full) -> files.push(watched)
        } else {
            files.push(full)
        }
    }
    latest := 0
    count := 0
    loop watched in files {
        count += 1
        info: cli_files.stat(watched) ?? next
        modified: info.modified.to_unix_ns() ?? next
        if modified > latest -> latest = modified
    }
    "{count}:{latest}"
}

// Every file under `directory`.
jet_cli_dev_files: fn(directory: String) -[FS]> [String] Never! {
    files := [String]{}
    loop item in cli_files.walk(directory, None) {
        entry: item ?? return [String]{}
        if !entry.is_dir -> files.push(entry.path)
    }
    files
}
