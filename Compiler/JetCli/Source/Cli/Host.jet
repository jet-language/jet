// The process side of the Jet-hosted `jet` (D-JETCLI-HOST1=A): run the front
// door, carry out its plan, and write the bytes. The process entry passes
// argv without the program name and exits with the returned status.
use core.files as cli_files
use core.process as cli_process
use core.term as cli_term
use jet_backend.[
    LIRFunctionID,
    lir_lower_program,
    x64_static_executable,
]
use jet_driver.[
    JetDriverAuthorizedSourceSnapshot,
    JetDriverCompileResult,
    JetDriverCompilerCheckInput,
    JetDriverVerbOutput,
    JET_DRIVER_EXIT_OK,
    JET_DRIVER_EXIT_USER_ERROR,
    jet_driver_check_outcome,
    jet_driver_present_diagnostics,
    jet_driver_report_problems,
]
use jet_foundation.[
    Diagnostic,
    DIAGNOSTIC_ERROR,
]
use jet_eval.[
    JetCompilerServicesSourceInput,
    JetCompilerServicesSourcePreparation,
    jet_eval_compiler_services_parse,
]

// crates/jet-foundation/src/ExitCodes.rs `ICE`: Jet's own defect.
JET_CLI_EXIT_ICE :: 101

// Rust host `render_internal_fault` (Diagnostics.rs `render_ice_report`).
fn jet_cli_ice(what: String) -> JetDriverVerbOutput Never! {
    JetDriverVerbOutput{
        stdout: "",
        stderr: "internal compiler error: {what}\nThis is a bug in jet, NOT in your program. Please report it,\nattaching your source file.",
        exit_code: JET_CLI_EXIT_ICE,
    }
}

fn jet_cli_errors(diagnostics: [Diagnostic]) -> [Diagnostic] Never! {
    errors := [Diagnostic]{}
    loop diagnostic in diagnostics {
        if diagnostic.severity == DIAGNOSTIC_ERROR -> &errors.push(diagnostic)
    }
    errors
}

// `jet check <file>`: compile through the Jet compiler, place each diagnostic
// on the file that owns it, and report the outcome the Rust host prints.
fn jet_cli_compile_check(file: String, source: String, color: Bool, quiet: Bool) -> JetDriverVerbOutput {
    output := JetDriverVerbOutput{stdout: "", stderr: "", exit_code: JET_DRIVER_EXIT_OK}
    compiled :: jet_cli_compile_file(file, color)
    if compiled == {
        .Refused(refusal) -> output = ~refusal
        .Compiled(result, snapshot) -> {
            diagnostics :: jet_driver_present_diagnostics(result.diagnostics, snapshot, result.generated_source_files)
            output = jet_driver_check_outcome(file, source, diagnostics, color, quiet)
            if jet_cli_errors(diagnostics).len() == 0 {
                if result.internal_problem == .Val(problem) -> output = jet_cli_ice(problem)
            }
        }
    }
    output
}

// Syntax/predicates.rs `sanitize_crate_name`: ASCII letters, digits, and `_`
// stay; any other character becomes one `_` (a UTF-8 continuation byte
// belongs to the character before it).
fn jet_cli_crate_name(stem: String) -> String Never! {
    name := ""
    loop byte in stem.bytes() {
        code :: Int.from_u8(byte)
        if code >= 128 && code < 192 -> next
        keep :: (code >= 48 && code <= 57) || (code >= 65 && code <= 90) || (code >= 97 && code <= 122) || code == 95
        piece := "_"
        if keep -> piece = String.from_bytes([U8]{byte}) ?? "_"
        name = "{name}{piece}"
    }
    if name.len() == 0 -> return "out"
    first :: Int.from_u8(name.bytes()[0])
    if first >= 48 && first <= 57 -> return "_{name}"
    name
}

// The entry's file name without `.jet`.
fn jet_cli_stem(file: String) -> String Never! {
    parts := file.split("/").to_list()
    name :: &parts.pop() ?? file
    if name.ends_with(".jet") -> return name.slice(0..<(name.len() - 4))
    name
}

fn jet_cli_build_failed(what: String, why: String, fix: String, color: Bool) -> JetDriverVerbOutput Never! {
    JetDriverVerbOutput{stdout: "", stderr: jet_cli_report("E2105", what, why, fix, color), exit_code: JET_DRIVER_EXIT_USER_ERROR}
}

// Dev builds: the Jet-native backend lowers the optimized MIR to LIR and
// writes a static x86-64 executable (D-EXEC1). A program it cannot lower yet
// is refused with the backend's first finding, never built another way.
fn jet_cli_build_native(file: String, result: JetDriverCompileResult, binary: String, color: Bool) -[FS]> JetDriverVerbOutput Never! {
    program :: result.mir ?? return jet_cli_ice("the Jet compiler finished `{file}` without a MIR program")
    entry_id :: result.entry_function ?? return jet_cli_build_failed("`{file}` has no `fn run` to build", "an executable starts at the program's `fn run`", "add `fn run()` to the file, or check it with `jet check {file}`", color)
    entry := -1
    loop (index, function) in program.functions {
        if function.id == entry_id -> entry = index
    }
    if entry < 0 -> return jet_cli_ice("the MIR program of `{file}` lost its entry function")
    lowered :: lir_lower_program(program)
    if lowered.issues.len() > 0 {
        issue :: lowered.issues[0]
        return JetDriverVerbOutput{
            stdout: "",
            stderr: jet_cli_report("E2104", "the Jet backend can't build `{file}` yet: {issue.function}: {issue.message}", jet_cli_why("E2104"), "build it with `jet build --release {file}` (rustc) until the Jet backend lowers this program", color),
            exit_code: JET_DRIVER_EXIT_USER_ERROR,
        }
    }
    image :: x64_static_executable(lowered.lir, LIRFunctionID{value: entry})
    if image.errors.len() > 0 {
        return JetDriverVerbOutput{
            stdout: "",
            stderr: jet_cli_report("E2104", "the Jet backend can't build `{file}` yet: {image.errors[0]}", jet_cli_why("E2104"), "build it with `jet build --release {file}` (rustc) until the Jet backend lowers this program", color),
            exit_code: JET_DRIVER_EXIT_USER_ERROR,
        }
    }
    cli_files.write_bytes(binary, image.bytes) ?? return jet_cli_build_failed("couldn't write {binary}: {err}", jet_cli_why("E2105"), "check that the build directory is writable", color)
    cli_files.set_mode(binary, 0o755) ?? return jet_cli_build_failed("couldn't make {binary} executable: {err}", jet_cli_why("E2105"), "check that the build directory is writable", color)
    JetDriverVerbOutput{stdout: "", stderr: "", exit_code: JET_DRIVER_EXIT_OK}
}

// Release builds: rustc/LLVM over the emitted Rust program, with the argv
// Source/CmdCompile.rs gives a native release build whose runtime is compiled
// inline (`PreparedRuntime::inline`): the release cfg and profile flags
// (main.rs `ProfileConfig::release`), the crate name pinned to the file stem,
// and the project path remapped out of debug records.
fn jet_cli_build_release(file: String, result: JetDriverCompileResult, root: String, build_dir: String, stem: String, binary: String, color: Bool) -[FS, Exec, Time.Wait]> JetDriverVerbOutput Never! {
    rust :: result.emitted_source ?? return jet_cli_ice("the Jet compiler finished `{file}` without emitting Rust")
    rust_path :: "{build_dir}/{stem}.rs"
    cli_files.write(rust_path, rust) ?? return jet_cli_build_failed("couldn't write {rust_path}: {err}", jet_cli_why("E2105"), "check that the build directory is writable", color)
    argv :: [String]{
        "rustc", "--edition", "2021",
        "--cfg", "jet_release", "--cfg", "jet_release_inspect=\"local\"",
        "-C", "opt-level=3", "-C", "strip=symbols", "-C", "lto=thin", "-C", "target-cpu=native",
        "--crate-name", jet_cli_crate_name(stem),
        "--remap-path-prefix", "{root}=/jet/project",
        rust_path, "-o", binary,
    }
    receipt :: cli_process.cmd(argv).run() ?? return jet_cli_build_failed("couldn't find `rustc` on this machine", "v1 of this language uses Rust as its backend (Docs/spec/architecture.md)", "install Rust from https://rustup.rs, then try again", color)
    if !receipt.success {
        log_path :: "{build_dir}/{stem}.rustc.log"
        cli_files.write(log_path, receipt.errors) ?? return jet_cli_ice("rustc rejected the Rust generated for `{file}`")
        return jet_cli_ice("rustc rejected the Rust generated for `{file}`; its report is in {log_path}")
    }
    JetDriverVerbOutput{stdout: "", stderr: "", exit_code: JET_DRIVER_EXIT_OK}
}

// `jet build <file>`: compile through the Jet compiler, report its problems
// the way the Rust host does, then write `.jet/build/<stem>` in the source
// root through the backend the profile selects.
fn jet_cli_build_result(file: String, source: String, color: Bool, release: Bool, result: JetDriverCompileResult, snapshot: JetDriverAuthorizedSourceSnapshot) -[FS, Exec, Time.Wait]> JetDriverVerbOutput Never! {
    errors :: jet_cli_errors(jet_driver_present_diagnostics(result.diagnostics, snapshot, result.generated_source_files))
    if errors.len() > 0 {
        return JetDriverVerbOutput{stdout: "", stderr: jet_driver_report_problems(file, source, errors, color, true), exit_code: JET_DRIVER_EXIT_USER_ERROR}
    }
    if result.internal_problem == .Val(problem) -> return jet_cli_ice(problem)
    if !result.complete -> return jet_cli_ice("the Jet compiler stopped before finishing `{file}`")
    root :: snapshot.roots[0].canonical_path
    build_dir :: "{root}/.jet/build"
    cli_files.create_dir_all(build_dir) ?? return jet_cli_build_failed("couldn't create the build directory {build_dir}: {err}", jet_cli_why("E2105"), "check that the project directory is writable", color)
    stem :: jet_cli_stem(file)
    binary :: "{build_dir}/{stem}"
    if release -> return jet_cli_build_release(file, result, root, build_dir, stem, binary, color)
    jet_cli_build_native(file, result, binary, color)
}

fn jet_cli_compile_build(file: String, source: String, color: Bool, release: Bool) -> JetDriverVerbOutput {
    output := JetDriverVerbOutput{stdout: "", stderr: "", exit_code: JET_DRIVER_EXIT_OK}
    compiled :: jet_cli_compile_file(file, color)
    if compiled == {
        .Refused(refusal) -> output = ~refusal
        .Compiled(result, snapshot) -> output = jet_cli_build_result(file, source, color, release, result, snapshot)
    }
    output
}

// Compiler inspection consumes the same authorized request as compilation,
// but asks only the shared checked query. The serializer lives in Projection.
fn jet_cli_inspect_file(file: String, color: Bool, semindex: Bool) -> JetDriverVerbOutput {
    if jet_cli_request_file(file, color) == {
        .Refused(output) -> return ~output
        .Ready(request, snapshot) -> {
            source := String?{None}
            loop root in snapshot.roots {
                loop candidate in root.files {
                    if candidate.path == snapshot.entry_path -> source = Val(candidate.source)
                }
            }
            original :: source ?? return jet_cli_ice("the authorized request lost its entry source")
            parsed :: jet_eval_compiler_services_parse(JetCompilerServicesSourceInput{source: original, preparation: Val(JetCompilerServicesSourcePreparation.Masked{source: original})}) ?? return jet_cli_ice("the compiler query could not prepare its authorized source")
            input :: JetDriverCompilerCheckInput{parsed: parsed, request: request}
            projected :: if semindex -> jet_cli_inspect_semindex(input) else -> jet_cli_inspect_compiler_check(input)
            if projected == {
                .Ok(output) -> return ~output
                .Err(error) -> {
                    if error == {
                        .Internal(message) -> return jet_cli_ice(~message)
                        .Diagnostics(diagnostics) | .Incomplete(diagnostics) -> {
                            if diagnostics.len() == 0 -> return jet_cli_ice("the checked query stopped without a diagnostic packet")
                            return JetDriverVerbOutput{stdout: "", stderr: jet_driver_report_problems(file, original, diagnostics, color, true), exit_code: JET_DRIVER_EXIT_USER_ERROR}
                        }
                    }
                }
            }
        }
    }
}

// Production execution remains a native-provider prerequisite until the
// backend installs the Main-approved O0 session seam. Never select O1/rustc.
fn jet_cli_execution_unavailable(invocation: JetCLIExecutionInvocation) -> JetDriverVerbOutput Never! {
    jet_cli_build_failed("the O0 execution host is unavailable", "run and dev require the shared in-memory runtime session", "install the native O0 execution provider for this Jet toolchain", invocation.output.profile.ansi_enabled)
}

fn jet_cli_dispatch_plan(plan: JetCLIPlan) -> JetDriverVerbOutput {
    if plan == {
        .Done(done) -> return ~done
        .Check(file, source, color, quiet) -> return jet_cli_compile_check(file, source, color, quiet)
        .Build(file, source, color, release) -> return jet_cli_compile_build(file, source, color, release)
        .Inspect(file, color, semindex) -> return jet_cli_inspect_file(file, color, semindex)
        .Run(invocation) | .Dev(invocation) -> return jet_cli_execution_unavailable(~invocation)
        .Completions(arguments) -> {
            if jet_cli_dev_completions(arguments) == {
                .Done(output) -> return ~output
                .OpenProgram(program) -> return jet_cli_dev_completion_metadata_error(program.program, "the opened-handle metadata provider is unavailable")
                .ReadOpened(_, _, _) -> return jet_cli_ice("completion planning requested a read without opening the program")
            }
        }
        .Explain(request) -> return jet_cli_build_failed("the requested explanation service is unavailable", "syntax, policy and build facts must come from the canonical compiler services", "install the explanation provider for this Jet toolchain", request.mode.color)
        .Format(_, mode) | .ExternalFormat(_, mode) | .Fix(_, mode) -> return jet_cli_build_failed("the canonical format/fix service is unavailable", "formatting and safe fixes require the shared formatter and checked publication transaction", "install the compiler formatting and transaction providers for this Jet toolchain", mode.color)
        .Status(_, json) -> {
            if json -> return JetDriverVerbOutput{stdout: StatusEnvelope.new("status", false).with_fields(StatusFields.new().with("error", "the authenticated receipt-store provider is unavailable")).json_line(), stderr: "", exit_code: JET_DRIVER_EXIT_USER_ERROR}
            return jet_cli_build_failed("the authenticated receipt-store provider is unavailable", "status reads existing authenticated receipts and never runs a producer", "install the receipt-store provider for this Jet toolchain", false)
        }
        .Test(_, mode, _) -> return jet_cli_build_failed("the canonical test execution service is unavailable", "tests require the shared checked harness, O0 runtime and authenticated evidence publication", "install the compiler test and native execution providers for this Jet toolchain", mode.color)
        .Try(_, _, mode) -> return jet_cli_build_failed("the canonical speculative-edit service is unavailable", "try uses one checked semantic index, resident overlay query and recoverable publication transaction", "install the compiler query and transaction providers for this Jet toolchain", mode.color)
        .Budget(_) -> return jet_cli_build_failed("the canonical budget service is unavailable", "budget commands require checked budget facts, authenticated measurements and baseline publication", "install the compiler budget and evidence-store providers for this Jet toolchain", false)
        .PackageDesktop(_, _, machine) -> return jet_cli_bundle_error_output("the canonical package materialization and receipt-store providers are unavailable", machine)
    }
}

// The native entry and in-process harness install their real compiler/runtime/
// watch providers here. Focused tests inject controlled hosts at this same
// boundary; they do not replace Front dispatch or implement another command.
pub fn jet_cli_dispatch_with_execution<C: JetCLIExecutionCompiler, H: JetCLIExecutionHost, W: JetCLIDevWatchHost>(args: [String], facts: JetCLIProcessFacts, compiler: &C, execution: &H, watcher: &W) -> JetDriverVerbOutput {
    plan :: jet_cli_front(args, facts)
    if plan == {
        .Run(invocation) -> return jet_cli_run_invocation<C, H>(invocation, &compiler, &execution)
        .Dev(invocation) -> return jet_cli_dev_invocation<C, H, W>(invocation, &compiler, &execution, &watcher)
        else -> return jet_cli_dispatch_plan(plan)
    }
}

pub fn jet_cli_dispatch_with_developer<H: JetCLICompletionProgramHost>(args: [String], facts: JetCLIProcessFacts, metadata: &H) -> JetDriverVerbOutput {
    plan :: jet_cli_front(args, facts)
    if plan == {
        .Completions(arguments) -> return jet_cli_run_completions<H>(&metadata, arguments)
        else -> return jet_cli_dispatch_plan(plan)
    }
}

pub fn jet_cli_dispatch_with_format<H: JetCLIFormatHost>(args: [String], facts: JetCLIProcessFacts, formatter: &H) -> JetDriverVerbOutput {
    plan :: jet_cli_front(args, facts)
    if plan == {
        .Format(options, mode) -> return jet_cli_run_fmt<H>(&formatter, ~options, ~mode)
        .ExternalFormat(options, mode) -> return jet_cli_run_external_fmt<H>(&formatter, ~options, ~mode)
        .Fix(options, mode) -> return jet_cli_run_fix<H>(&formatter, ~options, ~mode)
        else -> return jet_cli_dispatch_plan(plan)
    }
}

pub fn jet_cli_dispatch_with_explanation<H: JetCLIDevExplainHost>(args: [String], facts: JetCLIProcessFacts, explanation: &H) -> JetDriverVerbOutput {
    plan :: jet_cli_front(args, facts)
    if plan == {
        .Explain(request) -> return jet_cli_run_explain<H>(&explanation, ~request)
        else -> return jet_cli_dispatch_plan(plan)
    }
}

pub fn jet_cli_dispatch_with_status<H: JetCLIStatusHost>(args: [String], facts: JetCLIProcessFacts, receipts: &H) -> JetDriverVerbOutput {
    plan :: jet_cli_front(args, facts)
    if plan == {
        .Status(arguments, json) -> return jet_cli_run_status<H>(&receipts, ~arguments, ~json)
        else -> return jet_cli_dispatch_plan(plan)
    }
}
// The provider emits target/child/evidence reports through the same invocation
// sink that the native entry or command harness installed. Completed returns
// only its status; do not print those reports a second time.
pub fn jet_cli_dispatch_with_test<P: JetCLITestProvider, H: JetCLIExecutionHost>(args: [String], facts: JetCLIProcessFacts, provider: &P, execution: &H) -> JetDriverVerbOutput {
    plan :: jet_cli_front(args, facts)
    if plan == {
        .Test(arguments, mode, advisory) -> {
            if jet_cli_test_command<P,H>(~arguments, ~mode, advisory, &provider, &execution) == {
                .Completed(status) -> return JetDriverVerbOutput{stdout: "", stderr: "", exit_code: status}
                .TestRefused(error) -> return jet_cli_test_refusal_output(~error, ~mode)
                .OptionsRefused(refusal) -> return jet_cli_dispatch_plan(jet_cli_args_refusal_plan(~refusal, mode.color))
            }
        }
        else -> return jet_cli_dispatch_plan(plan)
    }
}

pub fn jet_cli_dispatch_with_try<H: JetCLITryHost>(args: [String], facts: JetCLIProcessFacts, host: &H) -> JetDriverVerbOutput {
    plan :: jet_cli_front(args, facts)
    if plan == {
        .Try(file, keep, mode) -> {
            if jet_cli_try_run(~file, keep, mode.json, &host) == {
                .Ok(output) -> return ~output
                .Err(.Load(entry, source, diagnostics)) -> return JetDriverVerbOutput{stdout: "", stderr: &host.render_diagnostics(entry, source, diagnostics), exit_code: JET_DRIVER_EXIT_USER_ERROR}
                .Err(.Message(message)) -> {
                    refusal := jet_cli_args_refuse("E2105", ~message, jet_cli_why("E2105"), "correct the named problem, then run the command again", mode.json)
                    refusal.exit_code = JET_DRIVER_EXIT_USER_ERROR
                    return jet_cli_dispatch_plan(jet_cli_args_refusal_plan(refusal, mode.color))
                }
            }
        }
        else -> return jet_cli_dispatch_plan(plan)
    }
}

pub fn jet_cli_dispatch_with_budget<H: JetCLIBudgetHost>(args: [String], facts: JetCLIProcessFacts, host: &H) -> JetDriverVerbOutput {
    plan :: jet_cli_front(args, facts)
    if plan == {
        .Budget(arguments) -> return jet_cli_budget_run<H>(&host, ~arguments)
        else -> return jet_cli_dispatch_plan(plan)
    }
}

pub fn jet_cli_dispatch_with_package<H: JetCLIBundleHost>(args: [String], facts: JetCLIProcessFacts, host: &H) -> JetDriverVerbOutput {
    plan :: jet_cli_front(args, facts)
    if plan == {
        .PackageDesktop(arguments, options, machine) -> return jet_cli_bundle_run_desktop<H>(arguments, options, machine, &host)
        else -> return jet_cli_dispatch_plan(plan)
    }
}


// One in-process `jet` invocation: plan it and run it, returning the bytes
// and status the process writes. `jet_cli_main` and the command harness's
// real dispatcher (Harness/Command.jet) share it; `facts` are the output
// facts the caller observed. Unannotated because the compile verbs are
// (Request.jet `jet_cli_compile_file`).
pub fn jet_cli_dispatch(args: [String], facts: JetCLIProcessFacts) -> JetDriverVerbOutput {
    jet_cli_dispatch_plan(jet_cli_front(args, facts))
}

pub fn jet_cli_main(args: [String]) -> Int {
    output :: jet_cli_dispatch(args, jet_cli_process_facts())
    if output.stdout.len() > 0 {
        out :: cli_term.stdout()
        &out.write(output.stdout).drop("jet stdout")
    }
    if output.stderr.len() > 0 {
        stderr_handle :: cli_term.stderr()
        &stderr_handle.write(output.stderr).drop("jet stderr")
    }
    output.exit_code
}
