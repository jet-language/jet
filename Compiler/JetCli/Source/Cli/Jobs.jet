// `jet jobs`: the checked entry's `#Job fn`s, every scope,
// in declaration order — the jobs a run's unknown-job report (E1294) names.
// The registry is read from the completed checked projection of the entry the
// command resolved; it never loads, parses or checks another source, and
// listing grants no job action authority.
use {
    cli_files: core.files
    jet_driver.[JetDriverCheckedProjectionResult, JetDriverCompileMode, JetDriverVerbOutput, JET_DRIVER_EXIT_OK, jet_driver_checked_projection, jet_driver_check_outcome, jet_driver_present_diagnostics]
    jet_foundation.[Item, JobRegistry, JobFact, JobArgumentSchema, JobSkip, JobCachePolicy, StringMapEntry]
}

// `jet jobs` (JetCLIPlan.Jobs): check `file`; a failing check reports as
// `jet check` does, a clean one lists its jobs, or under `json` prints the
// `jobs` status.
jet_cli_compile_jobs: fn(file: String, color: Bool, json: Bool) -> JetDriverVerbOutput {
    prepared: jet_cli_prepare_overlays(file, file, [JetCLIOverlay]{}, color, None, JetDriverCompileMode.Program)
    if prepared == {
        .Refused(output) -> return output.move()
        .Prepared(request, snapshot) -> {
            projection: jet_driver_checked_projection(request.move())
            diagnostics: jet_driver_present_diagnostics(projection.compile.diagnostics, snapshot, projection.compile.generated_source_files)
            if jet_cli_errors(diagnostics).len() > 0 {
                source: cli_files.read(file) ?? ""
                if json -> return jet_cli_check_json_outcome(file, source, diagnostics, 0)
                return jet_driver_check_outcome(file, source, diagnostics, color, false)
            }
            if projection.compile.internal_problem == .Val(problem) -> return jet_cli_ice(problem)
            registry: jet_cli_jobs_metadata_registry(projection) ?? return jet_cli_ice("a clean `jet jobs` check kept no checked entry")
            stdout: if json -> jet_cli_jobs_metadata_json(registry) else -> jet_cli_jobs_text(registry)
            return JetDriverVerbOutput{stdout: stdout, stderr: "", exit_code: JET_DRIVER_EXIT_OK}
        }
    }
}

jet_cli_jobs_metadata_registry: fn(projection: JetDriverCheckedProjectionResult) -> JobRegistry? Never! {
    if !projection.compile.complete || projection.compile.internal_problem != None -> return None
    entry: projection.entry_module ?? panic("a completed jobs projection lost its checked entry")
    if entry < 0 || entry >= projection.compile.doc_modules.len() || !projection.source_modules.contains(entry) -> panic("a completed jobs projection lost its checked entry source owner")
    // Pipeline's same-completed-check constructor correlates this OUTPUT
    // index to load.entry_module_identity before transferring the owned rows.
    // items come from graph.programs[index]; its shape-default projection only
    // updates Struct.default_ct, never Func/Job metadata. No Program is forged.
    // The jobs listed are the projection's job rows, the list E1294 names
    // (jet_driver_job_rows); the items carry their metadata.
    declared := [String:Bool]{}
    loop row in projection.job_rows -> declared[row.name] = true
    items := [Item]{}
    loop item in projection.compile.doc_modules[entry].items {
        if item == .Func(function) {
            if function.is_job && declared.get(function.name) != None -> items.push(item.copy())
        }
    }
    Val(JobRegistry.from_items(items))
}

jet_cli_job_metadata_argument: fn(argument: JobArgumentSchema) -> JetCLIStatusValue Never! {
    zone: if argument.zone == {
        .PositionalOnly -> "PositionalOnly"
        .Either -> "Either"
        .LabelOnly -> "LabelOnly"
    }
    jet_cli_status_object([JetCLIStatusField]{
        jet_cli_status_field("name", jet_cli_status_text(argument.name)),
        jet_cli_status_field("label", jet_cli_status_text(argument.label)),
        jet_cli_status_field("type", jet_cli_status_text(argument.ty)),
        jet_cli_status_field("required", jet_cli_status_bool(argument.required)),
        jet_cli_status_field("default", jet_cli_status_optional_text(argument.default)),
        jet_cli_status_field("variadic", jet_cli_status_bool(argument.variadic)),
        jet_cli_status_field("zone", jet_cli_status_text(zone)),
    })
}

jet_cli_job_metadata_skip: fn(skip: JobSkip?) -> JetCLIStatusValue Never! {
    value: skip ?? return JetCLIStatusValue.Null
    if value == {
        .Always(reason) -> jet_cli_status_object([JetCLIStatusField]{jet_cli_status_field("kind", jet_cli_status_text("always")), jet_cli_status_field("reason", jet_cli_status_text(reason))})
        .UnlessPlatform(platform) -> jet_cli_status_object([JetCLIStatusField]{jet_cli_status_field("kind", jet_cli_status_text("unless-platform")), jet_cli_status_field("platform", jet_cli_status_text(platform))})
    }
}

jet_cli_job_metadata_cache: fn(cache: JobCachePolicy) -> String Never! {
    if cache == {
        .Uncached -> "uncached"
        .Local -> "local"
        .Shared -> "shared"
    }
}

// The limits in lexical name order; a later entry of one name replaces an
// earlier one.
jet_cli_job_metadata_limits: fn(limits: [StringMapEntry]) -> [StringMapEntry] Never! {
    values := [String:String]{}
    loop entry in limits -> values[entry.key] = entry.value
    names := values.keys().to_list()
    names.sort()
    loop name in names -> StringMapEntry{key: name, value: values[name]}
}

jet_cli_job_metadata_status: fn(job: JobFact) -> JetCLIStatusValue Never! {
    arguments: loop argument in job.arguments -> jet_cli_job_metadata_argument(argument)
    limits: loop entry in jet_cli_job_metadata_limits(job.limits) -> jet_cli_status_field(entry.key, jet_cli_status_text(entry.value))
    jet_cli_status_object([JetCLIStatusField]{
        jet_cli_status_field("name", jet_cli_status_text(job.name)),
        jet_cli_status_field("scope", jet_cli_status_text(job.scope_name())),
        jet_cli_status_field("doc", jet_cli_status_optional_text(job.doc)),
        jet_cli_status_field("arguments", jet_cli_status_array(arguments)),
        jet_cli_status_field("schedule", jet_cli_status_optional_text(job.schedule)),
        jet_cli_status_field("after", jet_cli_status_texts(job.after)),
        jet_cli_status_field("inputs", jet_cli_status_texts(job.inputs)),
        jet_cli_status_field("outputs", jet_cli_status_texts(job.outputs)),
        jet_cli_status_field("packages", jet_cli_status_texts(job.packages)),
        jet_cli_status_field("cwd", jet_cli_status_optional_text(job.cwd)),
        jet_cli_status_field("skip", jet_cli_job_metadata_skip(job.skip)),
        jet_cli_status_field("cache", jet_cli_status_text(jet_cli_job_metadata_cache(job.cache))),
        jet_cli_status_field("limits", jet_cli_status_object(limits)),
        jet_cli_status_field("parallel", jet_cli_status_int(job.parallel)),
    })
}

// `jet jobs --json`: the `jobs` status, one row per declared job.
jet_cli_jobs_metadata_json: fn(registry: JobRegistry) -> String Never! {
    jobs: loop job in registry.jobs() -> jet_cli_job_metadata_status(job)
    "{jet_cli_status_render("jobs", true, [JetCLIStatusField]{jet_cli_status_field("jobs", jet_cli_status_array(jobs))})}\n"
}

// A job's listing detail: its typed arguments, documentation, schedule, and
// each policy that differs from the default (`parallel` 1 is the default).
jet_cli_job_metadata_detail: fn(job: JobFact) -> String Never! {
    parts := [String]{}
    arguments: loop argument in job.arguments -> argument.display()
    if arguments.len() > 0 -> parts.push("({arguments.join(", ")})")
    if job.doc == .Val(doc) {
        if doc != "" -> parts.push(doc.replace("\n", " "))
    }
    if job.schedule == .Val(schedule) -> parts.push("(every {schedule})")
    if job.after.len() > 0 -> parts.push("(after {job.after.join(", ")})")
    if job.inputs.len() > 0 -> parts.push("(inputs {job.inputs.join(", ")})")
    if job.outputs.len() > 0 -> parts.push("(outputs {job.outputs.join(", ")})")
    if job.packages.len() > 0 -> parts.push("(packages {job.packages.join(", ")})")
    if job.cwd == .Val(cwd) -> parts.push("(cwd {cwd})")
    if job.skip == .Val(skip) {
        label: if skip == {
            .Always(reason) -> "always ({reason})"
            .UnlessPlatform(platform) -> "unless platform is {platform}"
        }
        parts.push("(skip {label})")
    }
    if job.cache != .Uncached -> parts.push("(cache {jet_cli_job_metadata_cache(job.cache)})")
    if job.limits.len() > 0 {
        limits: loop entry in jet_cli_job_metadata_limits(job.limits) -> "{entry.key}={entry.value}"
        parts.push("(limits {limits.join(", ")})")
    }
    if job.parallel != 1 -> parts.push("(parallel {job.parallel})")
    parts.join(" ")
}

// `jet jobs`: one line per job, its name padded to the longest name, then its
// `[scope]` and its detail.
jet_cli_jobs_text: fn(registry: JobRegistry) -> String Never! {
    if registry.jobs().len() == 0 -> return "No jobs declared.\n"
    width := 0
    loop job in registry.jobs() {
        if job.name.len() > width -> width = job.name.len()
    }
    lines := [String]{}
    loop job in registry.jobs() {
        detail: jet_cli_job_metadata_detail(job)
        suffix: if detail == "" -> "" else -> " {detail}"
        lines.push("{jet_cli_pad(job.name, width)}  [{job.scope_name()}]{suffix}\n")
    }
    lines.join("")
}
