// man_page and built-in completion renderers. Every command, nested action, and
// flag comes from the canonical CLI table; the command model (JET_CLI_FORMS)
// leaves out every unported form.
use {
    jet_foundation.[JET_CLI_COMMANDS, JET_CLI_FLAGS, JetCLICommandSpec, JetCLIFlagSpec]
    jet_pkg_model.[COMPILER_VERSION]
    jet_driver.[JET_DRIVER_EXIT_OK, JET_DRIVER_EXIT_USAGE]
}

jet_cli_completion_names: fn() -> [String] Never! {
    names := [String]{}
    loop command in JET_CLI_COMMANDS {
        if jet_cli_command_listed(command.name) -> names.push(command.name)
    }
    names
}

// The actions of `command` the command model marks ported.
jet_cli_completion_actions: fn(command: JetCLICommandSpec) -> [String] Never! {
    if !jet_cli_form_ported(command.name) -> return [String]{}
    names := [String]{}
    loop action in command.actions {
        if jet_cli_form_ported("{command.name} {action.name}") -> names.push(action.name)
    }
    names
}

// Every flag with a ported scope left, with its help as shown.
jet_cli_completion_flags: fn() -> [JetCLIFlagSpec] Never! {
    flags := [JetCLIFlagSpec]{}
    loop spec in JET_CLI_FLAGS {
        help: jet_cli_flag_ported_help(spec) ?? next
        flags.push(JetCLIFlagSpec{long: spec.long, help: help})
    }
    flags
}

jet_cli_completion_zsh_escape: fn(text: String) -> String Never! {
    text.replace("'", "'\\''").replace(":", "\\:").replace("[", "\\[").replace("]", "\\]")
}

jet_cli_man_page: fn() -> String Never! {
    bin: JET_CLI_BINARY
    out := ".TH {bin.to_upper()} 1 \"\" \"{bin} {COMPILER_VERSION}\" \"Jet Manual\"\n.SH Name\n{bin} \\- the Jet compiler and project tool\n.SH Synopsis\n.B {bin}\n.RI [ command ] \" \" [ args ...]\n.SH Description\n{bin} builds, checks, runs, and tests Jet programs, and manages Jet projects and their dependencies. Output is plain when piped and colored on a terminal.\n.SH Commands\n"
    loop command in JET_CLI_COMMANDS {
        if !jet_cli_command_listed(command.name) -> next
        out = "{out}.TP\n.B {command.name}\n{command.summary.replace("\\", "\\\\")}\n"
        loop action in command.actions {
            if !jet_cli_form_ported("{command.name} {action.name}") -> next
            out = "{out}.TP\n.B {command.name} {action.name}\n{action.summary.replace("\\", "\\\\")}\n"
        }
    }
    out = "{out}.SH Flags\n"
    loop flag in jet_cli_completion_flags() {
        out = "{out}.TP\n.B {flag.long}\n{flag.help.replace("\\", "\\\\")}\n"
    }
    "{out}.SH Files\n.TP\n.B package.jet\nThe project manifest.\n.SH See Also\n{bin}-explain(1)\n"
}

jet_cli_completions_bash: fn() -> String Never! {
    bin: JET_CLI_BINARY
    names: jet_cli_completion_names().join(" ")
    flags: (loop flag in jet_cli_completion_flags() -> flag.long).join(" ")
    nested := [String]{}
    loop command in JET_CLI_COMMANDS {
        shown: jet_cli_completion_actions(command)
        if shown.len() == 0 -> next
        actions: shown.join(" ")
        nested.push("        {command.name}) COMPREPLY=( $(compgen -W \"{actions}\" -- \"$cur\") ); return 0 ;;")
    }
    "# bash completion for {bin} (generated by `{bin} self completions bash`)\n_{bin}() {{\nlocal cur prev cmds flags\nCOMPREPLY=()\ncur=\"${{COMP_WORDS[COMP_CWORD]}}\"\ncmds=\"{names}\"\nflags=\"{flags}\"\nif [[ \"$cur\" == -* ]]; then\nCOMPREPLY=( $(compgen -W \"$flags\" -- \"$cur\") )\nreturn 0\nfi\n    local job_names\njob_names=\"$({bin} --json jobs 2>/dev/null | sed -n 's/.*\"name\":\"\\([^\"]*\\)\".*/\\1/p')\"\ncmds=\"$cmds $job_names\"\n    if [[ $COMP_CWORD -eq 1 ]]; then\nCOMPREPLY=( $(compgen -W \"$cmds\" -- \"$cur\") )\nreturn 0\nfi\nif [[ $COMP_CWORD -eq 2 ]]; then\ncase \"${{COMP_WORDS[1]}}\" in\n{nested.join("\n")}\n        esac\nfi\nCOMPREPLY=( $(compgen -f -- \"$cur\") )\n}}\ncomplete -F _{bin} {bin}\n"
}

jet_cli_completions_zsh: fn() -> String Never! {
    bin: JET_CLI_BINARY
    names := ""
    nested := [String]{}
    loop command in JET_CLI_COMMANDS {
        if jet_cli_command_listed(command.name) {
            names = "{names}        '{command.name}:{jet_cli_completion_zsh_escape(command.summary)}'\n"
        }
        shown: jet_cli_completion_actions(command)
        if shown.len() == 0 -> next
        actions := [String]{}
        loop action in command.actions {
            if shown.contains(action.name) -> actions.push("'{action.name}:{jet_cli_completion_zsh_escape(action.summary)}'")
        }
        nested.push("            {command.name}) _values 'action' {actions.join(" ")} ;;")
    }
    flags := ""
    loop flag in jet_cli_completion_flags() {
        flags = "{flags}        '{flag.long}[{jet_cli_completion_zsh_escape(flag.help)}]'\n"
    }
    "#compdef {bin}\n# zsh completion for {bin} (generated by `{bin} self completions zsh`)\n_{bin}() {{\nlocal -a commands flags\ncommands=(\n{names}    )\nflags=(\n{flags}    )\nif (( CURRENT == 2 )); then\n_describe -t commands 'command' commands\n        local -a job_names\njob_names=(\"${{(@f)$({bin} --json jobs 2>/dev/null | sed -n 's/.*\"name\":\"\\([^\"]*\\)\".*/\\1/p')}}\")\n_describe -t job_names 'job' job_names\n    else\nif (( CURRENT == 3 )); then\ncase $words[2] in\n{nested.join("\n")}\n            esac\nelse\n_values 'flag' $flags\n_files\nfi\nfi\n}}\n_{bin} \"$@\"\n"
}

jet_cli_completions_fish: fn() -> String Never! {
    bin: JET_CLI_BINARY
    out := "# fish completion for {bin} (generated by `{bin} self completions fish`)\n"
    loop command in JET_CLI_COMMANDS {
        if !jet_cli_command_listed(command.name) -> next
        out = "{out}complete -c {bin} -n '__fish_use_subcommand' -a {command.name} -d '{command.summary.replace("'", "\\'")}'\n"
    }
    loop command in JET_CLI_COMMANDS {
        shown: jet_cli_completion_actions(command)
        loop action in command.actions {
            if !shown.contains(action.name) -> next
            out = "{out}complete -c {bin} -n '__fish_seen_subcommand_from {command.name}' -a {action.name} -d '{action.summary.replace("'", "\\'")}'\n"
        }
    }
    loop flag in jet_cli_completion_flags() {
        long := flag.long
        loop long.starts_with("--") -> long = long.slice(2..<long.len())
        out = "{out}complete -c {bin} -l {long} -d '{flag.help.replace("'", "\\'")}'\n"
    }
    "{out}complete -c {bin} -n '__fish_use_subcommand' -a \"({bin} --json jobs 2>/dev/null | string match -r '\\\"name\\\":\\\"[^\\\"]+\\\"' | string replace -r '.*\\\"name\\\":\\\"([^\\\"]+)\\\".*' '$1')\" -d 'job name'\n"
}

jet_cli_completions_powershell: fn() -> String Never! {
    bin: JET_CLI_BINARY
    names: (loop name in jet_cli_completion_names() -> "'{name}'").join(",")
    flags: (loop flag in jet_cli_completion_flags() -> "'{flag.long}'").join(",")
    groups := [String]{}
    loop command in JET_CLI_COMMANDS {
        shown: jet_cli_completion_actions(command)
        if shown.len() == 0 -> next
        actions: (loop name in shown -> "'{name}'").join(",")
        groups.push("'{command.name}' = @({actions})")
    }
    "# PowerShell completion for {bin} (generated by `{bin} self completions powershell`)\n$JetCommands = @({names})\n$JetFlags = @({flags})\n$JetGroups = @{{ {groups.join("; ")} }}\n$JetJobs = @((& {bin} --json jobs 2>$null | ConvertFrom-Json).jobs.name)\nRegister-ArgumentCompleter -Native -CommandName {bin} -ScriptBlock {{\nparam($wordToComplete,$commandAst,$cursorPosition)\n$words = @($commandAst.CommandElements | ForEach-Object {{ $_.Extent.Text }})\n$choices = if ($wordToComplete.StartsWith('-')) {{\n$JetFlags\n}} elseif ($words.Count -ge 2 -and $JetGroups.ContainsKey($words[1])) {{\n$JetGroups[$words[1]]\n}} else {{\n$JetCommands + $JetJobs\n}}\n$choices | Where-Object {{ $_ -like \"$wordToComplete*\" }} |\nForEach-Object {{ [System.Management.Automation.CompletionResult]::new($_,$_,\"ParameterValue\",$_) }}\n}}\n"
}

// `run_completions`: scripts are direct data, not human renderables. None
// delegates the schema-backed --for mode to its reader.
jet_cli_completions_builtin: fn(args: [String]) -> JetCLIPlan? Never! {
    shell: if args.len() > 0 -> args[0] else -> ""
    supported: shell == "bash" || shell == "zsh" || shell == "fish" || shell == "powershell"
    valid_shape: args.len() == 1 || (args.len() == 3 && args[1] == "--for")
    if !supported || !valid_shape {
        usage: "jet self completions <bash|zsh|fish|powershell> [--for PROGRAM]"
        return Val(jet_cli_done("", jet_cli_report("E2102", "Completions arguments don't match `{usage}`.", "A completion script needs one supported shell and, optionally, one compiled Jet program.", "Run `{usage}`.", false), JET_DRIVER_EXIT_USAGE))
    }
    if args.len() == 3 -> return None
    script: if shell == {
        "bash" -> jet_cli_completions_bash()
        "zsh" -> jet_cli_completions_zsh()
        "fish" -> jet_cli_completions_fish()
        else -> jet_cli_completions_powershell()
    }
    Val(jet_cli_done(script, "", JET_DRIVER_EXIT_OK))
}
