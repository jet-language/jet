// The second half of the `jet inspect` group (Source/CmdInspect.rs and the
// Source/main.rs arms its dispatch words reach): `digest`, `env`, `semindex`,
// `output`, `expand`, `schema`, `codemod`, `audit`, `sbom`, `bind`, `logs`,
// `info`, `outdated`, and `reserved`. `command` is the normalized command
// word (`inspect` for `inspect env`, which keeps its group word); `None`
// leaves the command to the caller's E2104 refusal.
use core.files as cli_files
use core.sys as cli_sys
use jet_driver.[
    JET_DRIVER_EXIT_OK,
    JET_DRIVER_EXIT_USAGE,
    JET_DRIVER_EXIT_USER_ERROR,
]
use jet_foundation.[
    CORE_MODULE_EXPORTS,
    DIAGNOSTIC_ERROR,
    DiagnosticRegistryFix,
    TAppliedRule,
    diagnostic_registry_rows,
    marker_source_read,
]

// `argv` is the normalized argv with its `--` tail (main.rs `raw`), `jet_argv`
// the words before `--`, and `args` their positional words.
pub fn jet_cli_inspect_b(argv: [String], command: String, jet_argv: [String], args: [String], color: Bool, quiet: Bool, json: Bool, threads: Int?) -[FS, Env]> JetCLIPlan? Never! {
    if command == {
        "reserved" -> return Val(jet_cli_reserved(json))
        "digest" -> return Val(jet_cli_digest(jet_cli_tail(argv, 1), color, json))
        else -> {}
    }
    None
}

// An inspect report: plain text with `color`, or the failed `cli` status line
// under `--json` (main.rs `cli_error!`).
fn jet_cli_inspect_b_fail(code: String, what: String, fix: String, color: Bool, json: Bool, exit_code: Int) -> JetCLIPlan Never! {
    if json -> return jet_cli_done(jet_cli_fail_json(code, what, jet_cli_why(code), fix), "", exit_code)
    jet_cli_fail(code, what, jet_cli_why(code), fix, color, exit_code)
}

// ---------------------------------------------------------------------------
// `jet inspect reserved [--json]` (crates/jet-cli/src/CLI.rs
// `reserved_report_text`, `reserved_report_json`; #1659 criterion 5).

// crates/jet-foundation/src/Syntax `JET_KEYWORD_LIST`: the real Jet keywords
// a user can type; the teaching words below are never in it.
JET_CLI_KEYWORD_LIST :: [String]{
    "fn", "pub", "priv", "use", "as", "extern", "module", "if", "else", "loop", "in", "break",
    "return", "defer", "struct", "enum", "alias", "impl", "policy", "wrap", "trait", "tag",
    "effect", "derive", "distinct", "migration", "rename", "add", "remove", "change", "via",
    "self", "Unsafe", "Impure", "Context", "task", "freeze", "shared", "Transact", "Job", "Test",
    "Todo", "State", "Transition", "state", "protocol", "client", "server", "marker", "validate",
    "check", "true", "false", "None", "it",
}

// Syntax `JET_TYPE_LIST`: the built-in type names a user writes in source.
JET_CLI_TYPE_LIST :: [String]{
    "Int", "Float", "Bool", "String", "()", "Char", "Err", "Shared", "SharedSnapshot",
    "SharedRevisionError", "SharedGuard", "Shared.Weak", "Condition", "Task", "Receiver",
    "Sender", "TaskFailure", "HashMap", "BTreeMap", "Map", "Queue", "Set", "Rank",
    "PriorityQueue", "Cache", "Tally", "Bits", "Bytes", "ViewIter", "I8", "I16", "I32", "I64",
    "U8", "U16", "U32", "U64", "F32", "F64",
}

// Syntax `FIRST_PARTY_RESERVED` (S51): first-party short names reserved
// before packages land.
JET_CLI_FIRST_PARTY_RESERVED :: [String]{
    "core", "jet", "c", "rust", "py", "js", "swift", "go", "java", "cs", "tcl", "lua", "fortran",
    "cobol", "ada", "pascal", "dart", "pwsh", "perl", "r", "octave", "com", "http", "regex", "csv",
    "toml", "crypto", "archive",
}

// One reserved word or sigil (CLI.rs `ReservedEntry`).
struct JetCLIReservedEntry {
    spelling: String
    kind: String
    note: String
}

// CLI.rs `TEACHING_RESERVED` (D-MEM1 / D-SHAPE-COPY1=A / D-CONST-RETIRE1):
// identifiers a user cannot bind because the lexer recognizes them only to
// redirect to their current spelling.
JET_CLI_TEACHING_RESERVED :: [JetCLIReservedEntry]{
    JetCLIReservedEntry{spelling: "copy", kind: "teaching-reserved word", note: "retired; write `~value` instead (E0991)"},
    JetCLIReservedEntry{spelling: "mut", kind: "teaching-reserved word", note: "retired; write `&value` instead (E0056)"},
    JetCLIReservedEntry{spelling: "take", kind: "teaching-reserved word", note: "retired as a bare prefix; write `^value` instead (E0057); `.take(n)` stays a valid method"},
    JetCLIReservedEntry{spelling: "const", kind: "teaching-reserved word", note: "retired; write `@name` instead (E0374)"},
    JetCLIReservedEntry{spelling: "unsafe", kind: "teaching-reserved word", note: "the foreign spelling; write `#Unsafe(\"reason\") {{ … }}` instead (E0031/E0003)"},
}

// CLI.rs `RESERVED_SIGILS`: sigils with compiler meaning outside ordinary operators.
JET_CLI_RESERVED_SIGILS :: [JetCLIReservedEntry]{
    JetCLIReservedEntry{spelling: "::", kind: "sigil", note: "bind an immutable local"},
    JetCLIReservedEntry{spelling: ":=", kind: "sigil", note: "bind a mutable local"},
    JetCLIReservedEntry{spelling: "&", kind: "sigil", note: "borrow for write (D-MEM1)"},
    JetCLIReservedEntry{spelling: "^", kind: "sigil", note: "take/move ownership (D-MEM1)"},
    JetCLIReservedEntry{spelling: "~", kind: "sigil", note: "produce an owned copy (D-SHAPE-COPY1)"},
    JetCLIReservedEntry{spelling: "$", kind: "sigil", note: "compiler fact: `T.$layout`, `$build.os`, `$sites:` (D-COMPILER-NS1)"},
    JetCLIReservedEntry{spelling: "<:", kind: "sigil", note: "open a statement-expansion fence (D-FENCE2)"},
    JetCLIReservedEntry{spelling: ":>", kind: "sigil", note: "close a statement-expansion fence (D-FENCE2)"},
    JetCLIReservedEntry{spelling: "...", kind: "sigil", note: "spread elements"},
}

// Rust `{:<width}`: `value` padded with spaces to `width` characters.
fn jet_cli_inspect_pad(value: String, width: Int) -> String Never! {
    out := value
    count := 0
    loop byte in value.bytes() {
        code :: Int.from_u8(byte)
        if code < 128 || code >= 192 -> count += 1
    }
    loop count < width {
        out = "{out} "
        count += 1
    }
    out
}

fn jet_cli_reserved_text() -> String Never! {
    out := "keywords:\n"
    loop word in JET_CLI_KEYWORD_LIST -> out = "{out}  {word}\n"
    out = "{out}\nteaching-reserved words (not valid identifiers):\n"
    loop entry in JET_CLI_TEACHING_RESERVED -> out = "{out}  {jet_cli_inspect_pad(entry.spelling, 10)} {entry.note}\n"
    out = "{out}\nsigils:\n"
    loop entry in JET_CLI_RESERVED_SIGILS -> out = "{out}  {jet_cli_inspect_pad(entry.spelling, 10)} {entry.note}\n"
    out
}

fn jet_cli_reserved_entries(entries: [JetCLIReservedEntry]) -> JetCLIStatusValue Never! {
    rows :: loop entry in entries -> jet_cli_status_object([JetCLIStatusField]{
        jet_cli_status_field("spelling", jet_cli_status_text(entry.spelling)),
        jet_cli_status_field("kind", jet_cli_status_text(entry.kind)),
        jet_cli_status_field("note", jet_cli_status_text(entry.note)),
    })
    jet_cli_status_array(rows)
}

fn jet_cli_reserved(json: Bool) -> JetCLIPlan Never! {
    if !json -> return jet_cli_done(jet_cli_reserved_text(), "", JET_DRIVER_EXIT_OK)
    payload :: jet_cli_status_object([JetCLIStatusField]{
        jet_cli_status_field("keywords", jet_cli_status_texts(JET_CLI_KEYWORD_LIST)),
        jet_cli_status_field("teaching_reserved", jet_cli_reserved_entries(JET_CLI_TEACHING_RESERVED)),
        jet_cli_status_field("sigils", jet_cli_reserved_entries(JET_CLI_RESERVED_SIGILS)),
    })
    jet_cli_done("{jet_cli_status_render("inspect.reserved", true, [JetCLIStatusField]{jet_cli_status_field("reserved", payload)})}\n", "", JET_DRIVER_EXIT_OK)
}

// ---------------------------------------------------------------------------
// `jet inspect digest [--json] [--list-topics] [--topic <name>]`
// (Source/CmdInspect.rs `run_digest`): the one-file language surface used by
// agents, projected from the compiler registries.

// The Prelude marker declarations, read from the toolchain source tree (the
// Rust host embeds the same file; MarkerSource.rs `MARKER_SOURCE`).
JET_CLI_MARKER_SOURCE_PATH :: "crates/jet-codegen/src/Prelude/Markers.jet"

// One topic: a byte range of the full digest.
struct JetCLIDigestSlice {
    topic: String
    bytes: String
}

// The digest, or the report that stopped it.
enum JetCLIDigestText {
    Text(text: String)
    Failed(plan: JetCLIPlan)
}

fn jet_cli_digest_section(title: String, body: String) -> String Never! {
    "## {title}\n\n{body.trim()}\n"
}

fn jet_cli_digest_list(values: [String]) -> String Never! {
    unique := [String]{}
    loop value in values {
        if !unique.contains(value) -> &unique.push(value)
    }
    rows :: loop value in unique -> "- {value}"
    rows.join("\n")
}

fn jet_cli_digest_quote(value: String) -> String Never! {
    value.replace("\\", "\\\\").replace("\"", "\\\"")
}

// Rust `split_whitespace().join(" ")`.
fn jet_cli_digest_one_line(value: String) -> String Never! {
    words := [String]{}
    bytes :: value.bytes()
    start := -1
    loop (index, byte) in bytes {
        code :: Int.from_u8(byte)
        space :: code == 32 || (code >= 9 && code <= 13)
        if {
            space && start >= 0 -> {
                &words.push(String.from_bytes(bytes[start..<index]) ?? "")
                start = -1
            }
            !space && start < 0 -> start = index
            else -> {}
        }
    }
    if start >= 0 -> &words.push(String.from_bytes(bytes[start..<bytes.len()]) ?? "")
    words.join(" ")
}

fn jet_cli_digest_marker_declaration(rule: TAppliedRule) -> String Never! {
    fields := [String]{}
    loop param in rule.signature.params {
        default :: if param.default_source == .Val(value) -> "{{{value}}}" else -> ""
        &fields.push("{param.name}: {param.source_type}{default}")
    }
    if rule.signature.variadic_source_type == .Val(source_type) -> &fields.push("{source_type}...")
    sites :: loop site in rule.sites -> ".{site}"
    &fields.push("@sites: [{sites.join(", ")}]")
    if rule.repeatable -> &fields.push("@repeatable: true")
    if rule.owns_menu -> &fields.push("@owns_menu: true")
    if rule.inherits -> &fields.push("@inherits: true")
    if rule.resolution != "SiteBound" -> &fields.push("@resolution: .{rule.resolution}")
    if rule.policy_scopes.len() > 0 {
        scopes :: loop scope in rule.policy_scopes -> ".{scope}"
        &fields.push("@scopes: [{scopes.join(", ")}]")
    }
    if rule.companion_site == .Val(companion) -> &fields.push("@companion: [{companion.rule}, .{companion.site}]")
    if rule.status == .Retired(replacement) -> &fields.push("@retired: \"{jet_cli_digest_quote(replacement)}\"")
    "marker {rule.name}({fields.join(", ")})"
}

fn jet_cli_digest_marker_text(rules: [TAppliedRule]) -> String Never! {
    out := "status\tname\tregistered declaration"
    loop rule in rules {
        status :: if rule.status == {
            .Active -> "active"
            .Retired(_) -> "retired"
        }
        out = "{out}\n{status}\t{rule.name}\t{jet_cli_digest_marker_declaration(rule)}"
    }
    out
}

// Diagnostics.rs `StructuredFix::source_marker`.
fn jet_cli_digest_structured_fix(fix: DiagnosticRegistryFix?) -> String Never! {
    value :: fix ?? return "-"
    if value == {
        .SourceEdit -> "source_edit"
        .SuggestedSourceEdit -> "suggested_source_edit"
        .CryptoMisuse -> "crypto_misuse"
        .Replace(from, to) -> "replace:{from}=>{to}"
        .Remove(text) -> "remove:{text}"
        .GeneratedMarkerGroup -> "generated:marker_group"
        .GeneratedMissingArms -> "generated:missing_arms"
        .GeneratedScriptRun -> "generated:script_run"
        .GeneratedCallValue -> "generated:call_value"
        .GeneratedRedundantTailReturn -> "generated:redundant_tail_return"
    }
}

fn jet_cli_digest_diagnostic_text() -> String Never! {
    out := "code\tstatus\tstage\tseverity\tmoment\tmeaning\twhat\twhy\tfix\tdetail\tstructured-fix"
    loop row in diagnostic_registry_rows() {
        status :: if row.status == {
            .Active -> "active"
            .Retired -> "retired"
            .Reserved -> "reserved"
        }
        severity :: if row.severity == DIAGNOSTIC_ERROR -> "error" else -> "lint"
        moment :: if row.moment == {
            .Compile -> "compile"
            .Run -> "run"
            .Test -> "test"
            .Tool -> "tool"
        }
        detail :: if row.detail -> "true" else -> "false"
        out = "{out}\n{row.code}\t{status}\t{row.stage}\t{severity}\t{moment}\t{jet_cli_digest_one_line(row.meaning)}\t{jet_cli_digest_one_line(row.what)}\t{jet_cli_digest_one_line(row.why)}\t{jet_cli_digest_one_line(row.fix)}\t{detail}\t{jet_cli_digest_structured_fix(row.structured_fix)}"
    }
    out
}

fn jet_cli_digest_core_module_text() -> String Never! {
    out := "module\titems"
    loop module_row in CORE_MODULE_EXPORTS {
        unique := [String]{}
        loop item in module_row.members {
            if !unique.contains(item) -> &unique.push(item)
        }
        rendered :: if unique.len() == 0 -> "(no indexed item)" else -> unique.join(", ")
        out = "{out}\n{module_row.module_name}\t{rendered}"
    }
    out
}

// CmdInspect.rs `llm_digest`.
fn jet_cli_llm_digest(color: Bool, json: Bool) -[FS, Env]> JetCLIDigestText Never! {
    fix :: "set `{JET_CLI_TOOLCHAIN_ROOT_ENV}` to the Jet toolchain source tree, the directory that holds `Core/` and `crates/`"
    toolchain :: cli_sys.get(JET_CLI_TOOLCHAIN_ROOT_ENV) ?? return JetCLIDigestText.Failed{plan: jet_cli_inspect_b_fail("E2105", "`{JET_CLI_TOOLCHAIN_ROOT_ENV}` is not set, so the marker registry can't be read", fix, color, json, JET_DRIVER_EXIT_USER_ERROR)}
    path :: jet_cli_authority_path(toolchain, JET_CLI_MARKER_SOURCE_PATH)
    markers :: cli_files.read(path) ?? return JetCLIDigestText.Failed{plan: jet_cli_inspect_b_fail("E2105", "can't read the marker registry `{path}`: {err}", fix, color, json, JET_DRIVER_EXIT_USER_ERROR)}
    marker_text :: jet_cli_digest_marker_text(marker_source_read(markers))
    idiom_suites_lines :: [String]{
        "Each idiom has one executable, golden-backed source of truth under `Examples/suites/`.",
        "",
        "- Dispatch: `Examples/suites/dispatch.jet` — ordered dispatch tables and grouped aliases.",
        "- Failure: `Examples/suites/failure.jet` — implicit failure flow, typed expert contracts, and one conversion rail.",
        "- Finite state: `Examples/suites/finite_state.jet` — enums, variant groups, tags, and typestate transitions.",
        "- Ownership: `Examples/suites/ownership.jet` — reused views, explicit `~` boundaries, and cost visibility.",
        "- Wire output: `Examples/suites/wire_output.jet` — canonical JSON writer bytes and a `#Codable` round trip.",
    }
    idiom_suites_body :: idiom_suites_lines.join("\n")
    first_program_lines :: [String]{
        "A source file ends with one `fn run()` entry. `print` is a built-in.",
        "",
        "```jet",
        "fn run() {{",
        "    greeting :: \"Hello, Jet\"",
        "    print(greeting)",
        "}}",
        "```",
        "",
        "No semicolons. Comments start with `//`. Strings use double quotes and interpolate `{{name}}`.",
    }
    first_program_body :: first_program_lines.join("\n")
    core_rules_lines :: [String]{
        "Bindings: `name :: value` is immutable; `name := value` is mutable; `name = value` reassigns a mutable binding.",
        "Functions: `fn name(parameter: Type) -> Return {{ ... }}`; an effect ceiling splits the arrow: `fn name(parameter: Type) -[Effects]> Return {{ ... }}`, and `-[]>` declares a pure function.",
        "Visibility: declarations are private by default; prefix an item with `pub` for package use.",
        "Types: `Int`, `Float`, `Bool`, `String`, `Char`; lists use `[T]`; optional values use `T?`; failures use `T E!`.",
        "Errors: failures propagate implicitly; handle `T?` or `T E!` with `?? fallback` or a pattern test. Use `Ok(value)`, `Err(error)`, `Val(value)`, and `None`.",
        "Control: `if condition {{ ... }} else {{ ... }}`; loops use `loop name in source {{ ... }}`, and a collecting loop yields a list with `loop name in source -> value`; exit with `break` and advance with `next`.",
        "Construction: use `Type{{ field: value }}`; list literals use `[T]{{ value1, value2 }}`.",
        "Calls and member access use `name(args)` and `value.member(args)`. Core imports use `use core.module as alias`.",
        "Ownership is safe by default. `&T` writes, `^T` moves, and `~value` copies. Expert unsafe code needs `#Unsafe(\"reason\")`.",
    }
    core_rules_body :: core_rules_lines.join("\n")
    marker_body :: "User marker spelling is `#Name(arguments)`; rows below are registry declarations.\n\n```text\n{marker_text}\n```"
    core_body :: "Use a module alias, then call an indexed item: `use core.term as term`; `term.print(\"hi\")`.\n\n```text\n{jet_cli_digest_core_module_text()}\n```"
    diagnostic_body :: "Diagnostic rows use current registry meaning. Match code first; follow `fix`. Rows marked retired or reserved are not current syntax.\n\n```text\n{jet_cli_digest_diagnostic_text()}\n```"
    sections :: [String]{
        "# Jet LLM surface digest",
        "",
        "Generated. Current compiler registries own markers, diagnostics, syntax names, and Core items.",
        "Read on demand with `jet inspect digest`; do not maintain a checked-in copy.",
        "Use active rows only. Retired rows teach replacement; they are not valid current source.",
        "Write one current program. Do not invent aliases, legacy spellings, or library namespaces.",
        "",
        jet_cli_digest_section("First program", first_program_body),
        jet_cli_digest_section("Core source rules", core_rules_body),
        jet_cli_digest_section("Canonical idiom suites", idiom_suites_body),
        jet_cli_digest_section("Keywords", jet_cli_digest_list(JET_CLI_KEYWORD_LIST)),
        jet_cli_digest_section("Built-in type names", jet_cli_digest_list(JET_CLI_TYPE_LIST)),
        jet_cli_digest_section("Reserved first-party names", jet_cli_digest_list(JET_CLI_FIRST_PARTY_RESERVED)),
        jet_cli_digest_section("Markers", marker_body),
        jet_cli_digest_section("Core module index", core_body),
        jet_cli_digest_section("Diagnostics", diagnostic_body),
    }
    out :: sections.join("\n")
    JetCLIDigestText.Text{text: "{jet_cli_inspect_trim_end(out)}\n"}
}

// Rust `str::trim_end` over ASCII whitespace.
fn jet_cli_inspect_trim_end(text: String) -> String Never! {
    bytes :: text.bytes()
    end := bytes.len()
    loop end > 0 {
        code :: Int.from_u8(bytes[end - 1])
        if code != 32 && (code < 9 || code > 13) -> break
        end -= 1
    }
    jet_cli_inspect_slice(text, 0, end)
}

// Rust `str` ordering: bytewise lexicographic.
fn jet_cli_inspect_less(left: String, right: String) -> Bool Never! {
    a :: left.bytes()
    b :: right.bytes()
    loop index in 0..<a.len() {
        if index >= b.len() -> return false
        if a[index] != b[index] -> return Int.from_u8(a[index]) < Int.from_u8(b[index])
    }
    a.len() < b.len()
}

// The first byte offset of `needle` in `haystack` at or after `from`.
fn jet_cli_inspect_find(haystack: String, needle: String, from: Int) -> Int? Never! {
    bytes :: haystack.bytes()
    pattern :: needle.bytes()
    if pattern.len() == 0 -> return Val(from)
    loop start in from..<bytes.len() {
        if start + pattern.len() > bytes.len() -> return None
        matched := true
        loop offset in 0..<pattern.len() {
            if bytes[start + offset] != pattern[offset] {
                matched = false
                break
            }
        }
        if matched -> return Val(start)
    }
    None
}

fn jet_cli_inspect_slice(text: String, start: Int, end: Int) -> String Never! {
    if start >= end -> return ""
    String.from_bytes(text.bytes()[start..<end]) ?? ""
}

// CmdInspect.rs `digest_slices`: byte-exact topic ranges of the one digest;
// the Core index splits into one topic per module row.
fn jet_cli_digest_slices(digest: String) -> [JetCLIDigestSlice] Never! {
    topics :: [String]{"first-program", "core.source-rules", "idioms", "syntax.keywords", "syntax.types", "syntax.reserved", "markers", "core", "diagnostics"}
    headings :: [String]{"## First program", "## Core source rules", "## Canonical idiom suites", "## Keywords", "## Built-in type names", "## Reserved first-party names", "## Markers", "## Core module index", "## Diagnostics"}
    starts :: loop heading in headings -> jet_cli_inspect_find(digest, heading, 0) ?? panic("digest heading disappeared")
    slices := [JetCLIDigestSlice]{}
    loop (index, topic) in topics {
        start :: if index == 0 -> 0 else -> starts[index]
        end :: if index + 1 < starts.len() -> starts[index + 1] else -> digest.len()
        if topic != "core" {
            &slices.push(JetCLIDigestSlice{topic: topic, bytes: jet_cli_inspect_slice(digest, start, end)})
            next
        }
        header :: "module\titems\n"
        header_at :: jet_cli_inspect_find(digest, header, start) ?? panic("core digest header disappeared")
        header_end :: header_at + header.len()
        rows := [Int]{}
        offset := header_end
        loop line in jet_cli_inspect_slice(digest, header_end, end).split("\n") {
            if offset >= end -> break
            if line.starts_with("core.") -> &rows.push(offset)
            offset += line.len() + 1
        }
        loop (row_index, row_start) in rows {
            line :: jet_cli_inspect_slice(digest, row_start, end)
            tab :: jet_cli_inspect_find(line, "\t", 0) ?? panic("core digest row lost module name")
            slice_start :: if row_index == 0 -> start else -> row_start
            slice_end :: if row_index + 1 < rows.len() -> rows[row_index + 1] else -> end
            &slices.push(JetCLIDigestSlice{topic: jet_cli_inspect_slice(line, 0, tab), bytes: jet_cli_inspect_slice(digest, slice_start, slice_end)})
        }
    }
    slices
}

// Syntax `edit_distance`: Levenshtein distance over bytes.
fn jet_cli_inspect_edit_distance(left: String, right: String) -> Int Never! {
    a :: left.bytes()
    b :: right.bytes()
    previous := loop index in 0..b.len() -> index
    loop i in 0..<a.len() {
        current := [Int]{i + 1}
        loop j in 0..<b.len() {
            cost :: if a[i] == b[j] -> 0 else -> 1
            best := previous[j] + cost
            if previous[j + 1] + 1 < best -> best = previous[j + 1] + 1
            if current[j] + 1 < best -> best = current[j] + 1
            &current.push(best)
        }
        previous = current
    }
    previous[b.len()]
}

fn jet_cli_digest_emit(digest: String, json: Bool) -> JetCLIPlan Never! {
    if !json -> return jet_cli_done(digest, "", JET_DRIVER_EXIT_OK)
    value :: jet_cli_status_object([JetCLIStatusField]{jet_cli_status_field("value", jet_cli_status_text(digest))})
    jet_cli_done("{jet_cli_status_render("inspect.digest", true, [JetCLIStatusField]{jet_cli_status_field("digest", value)})}\n", "", JET_DRIVER_EXIT_OK)
}

// `options` are the words after `digest` (CmdInspect.rs `parse_digest_args`).
fn jet_cli_digest(options: [String], color: Bool, json: Bool) -[FS, Env]> JetCLIPlan Never! {
    topic := String?{None}
    list_topics := false
    index := 0
    loop index < options.len() {
        argument :: options[index]
        if {
            argument == "--json" -> {}
            argument == "--list-topics" -> list_topics = true
            argument.starts_with("--topic=") -> topic = Val(argument.slice(8..<argument.len()))
            argument == "--topic" -> {
                if index + 1 >= options.len() || options[index + 1].starts_with("-") {
                    return jet_cli_inspect_b_fail("E2104", "`--topic` needs a value", "write `--topic <name>`; use `--list-topics` to discover names", color, json, JET_DRIVER_EXIT_USAGE)
                }
                topic = Val(options[index + 1])
                index += 1
            }
            else -> {}
        }
        index += 1
    }
    digest := ""
    if jet_cli_llm_digest(color, json) == {
        .Text(text) -> digest = text
        .Failed(plan) -> return plan
    }
    if !list_topics && topic == None -> return jet_cli_digest_emit(digest, json)
    slices :: jet_cli_digest_slices(digest)
    if list_topics {
        if topic != None -> return jet_cli_inspect_b_fail("E2104", "`--list-topics` cannot be combined with `--topic`", "use `jet inspect digest --list-topics` or `jet inspect digest --topic <name>`", color, json, JET_DRIVER_EXIT_USAGE)
        names :: loop slice in slices -> slice.topic
        if json {
            topics :: jet_cli_status_object([JetCLIStatusField]{jet_cli_status_field("topics", jet_cli_status_texts(names))})
            return jet_cli_done("{jet_cli_status_render("inspect.digest", true, [JetCLIStatusField]{jet_cli_status_field("digest", topics)})}\n", "", JET_DRIVER_EXIT_OK)
        }
        return jet_cli_done("{names.join("\n")}\n", "", JET_DRIVER_EXIT_OK)
    }
    wanted :: topic ?? ""
    loop slice in slices {
        if slice.topic == wanted -> return jet_cli_digest_emit(slice.bytes, json)
    }
    closest := "first-program"
    best := -1
    loop slice in slices {
        distance :: jet_cli_inspect_edit_distance(wanted, slice.topic)
        if best < 0 || distance < best || (distance == best && jet_cli_inspect_less(slice.topic, closest)) {
            best = distance
            closest = slice.topic
        }
    }
    jet_cli_inspect_b_fail("E2104", "unknown digest topic `{wanted}`", "use `--topic {closest}`, or list topics with `jet inspect digest --list-topics`", color, json, JET_DRIVER_EXIT_USAGE)
}
