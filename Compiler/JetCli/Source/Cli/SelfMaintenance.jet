// These commands keep direct confirmation output, even under --json/--quiet;
// only CLI diagnostic macros use machine mode.
use {
    cli_files: core.files
    jet_driver.[JetDriverCompileMode, JetDriverVerbOutput, JET_DRIVER_EXIT_OK, JET_DRIVER_EXIT_USAGE, JET_DRIVER_EXIT_USER_ERROR, jet_driver_present_diagnostics]
    jet_foundation.[diagnostic_render_all]
}

jet_cli_maintenance_error: fn(code: String, what: String, fix: String?, color: Bool, json: Bool) -> JetDriverVerbOutput Never! {
    diagnostic_copy: jet_cli_diagnostic_copy(code)
    repair: fix ?? diagnostic_copy.fix
    JetDriverVerbOutput{stdout: if json -> jet_cli_fail_json(code, what, diagnostic_copy.why, repair) else -> "", stderr: if json -> "" else -> jet_cli_report(code, what, diagnostic_copy.why, repair, color), exit_code: JET_DRIVER_EXIT_USER_ERROR}
}

jet_cli_new_ui_source: fn() -> String Never! {
    "// TODO: describe what this diagnostic demonstrates.\nrun: fn() {{\n    print(definitely_undefined_scaffold_symbol)\n}}\n"
}

jet_cli_devtools_new_ui: fn(args: [String], color: Bool, json: Bool) -> JetDriverVerbOutput {
    if args.len() == 0 -> return JetDriverVerbOutput{stdout: "", stderr: "usage: jet devtools new-ui <name>\n", exit_code: JET_DRIVER_EXIT_USAGE}
    name: args[0]
    if name == "" || name.contains("/") || name.contains(".") -> return jet_cli_maintenance_error("E2104", "`new-ui` takes a bare fixture name, no path or extension: got `{name}`", None, color, json)
    file: "tests/ui/{name}.jet"
    expected: "tests/ui/{name}.stderr"
    if cli_files.exists(file) -> return jet_cli_maintenance_error("E2104", "`{file}` already exists", None, color, json)
    cli_files.create_dir_all("tests/ui") ?? return jet_cli_maintenance_error("E2105", "couldn't create `tests/ui`: {jet_cli_io_error_text(err)}", None, color, json)
    source: jet_cli_new_ui_source()
    cli_files.write(file, source) ?? return jet_cli_maintenance_error("E2105", "couldn't write `{file}`: {jet_cli_io_error_text(err)}", None, color, json)
    actual := "(no errors)\n"
    if jet_cli_compile_file(file, false, None, JetDriverCompileMode.Program) == {
        .Refused(output) -> return output
        .Compiled(result, snapshot) -> {
            diagnostics: jet_driver_present_diagnostics(result.diagnostics, snapshot, result.generated_source_files)
            errors: jet_cli_errors(diagnostics)
            if errors.len() > 0 -> actual = diagnostic_render_all(file, source, errors, false)
            if errors.len() == 0 && result.internal_problem == .Val(problem) -> return jet_cli_ice(problem)
        }
    }
    cli_files.write(expected, actual) ?? return jet_cli_maintenance_error("E2105", "couldn't write `{expected}`: {jet_cli_io_error_text(err)}", None, color, json)
    stdout := "wrote {file}\nwrote {expected}\n"
    if actual == "(no errors)\n" -> stdout = "{stdout}note: scaffold compiled cleanly — edit `{file}` to trigger the diagnostic you want, then bless it with `jet test Compiler --profile ui -u --filter={file}`\n"
    JetDriverVerbOutput{stdout: stdout, stderr: "", exit_code: JET_DRIVER_EXIT_OK}
}

// The fixture directory a `.case` line names, beside the case file: the
// `fixture:` directive's one word, quotes and a trailing `# reason` dropped.
// Templated words ({work}, {pid}, ...) only exist at run time and are skipped.
jet_cli_case_fixture: fn(line: String) -> String? Never! {
    text: line.trim()
    if !text.starts_with("fixture:") -> return None
    value := text.slice(8..<text.len()).trim()
    value = value.split(" #").to_list()[0].trim()
    double: value.starts_with("\"") && value.ends_with("\"")
    single: value.starts_with("'") && value.ends_with("'")
    if value.len() >= 2 && (double || single) -> value = value.slice(1..<(value.len() - 1))
    if value == "" || value.contains("{{") || value.contains("}}") || value.contains(" ") -> return None
    Val(value)
}

jet_cli_collect_cases: fn(directory: String, files: &[String]) Never! -[FS]> {
    // Core's deterministic sorted enumeration keeps the report order stable.
    entries: cli_files.listdir(directory) ?? return
    loop name in entries {
        path: "{directory}/{name}"
        if cli_files.is_dir(path) {
            jet_cli_collect_cases(path, files)
        } else if name.ends_with(".case") && name != ".case" {
            files.push(path)
        }
    }
}

jet_cli_devtools_fixture_paths: fn(color: Bool, json: Bool) -> JetDriverVerbOutput {
    if !cli_files.is_dir("tests/cases") -> return jet_cli_maintenance_error("E2104", "no `tests/cases/` directory here", Val("run from the repo root"), color, json)
    cases := [String]{}
    jet_cli_collect_cases("tests/cases", cases)
    checked := 0
    missing := [String]{}
    loop file in cases {
        source: cli_files.read(file) ?? ""
        directory: cli_files.dirname(file)
        loop line in source.split("\n") {
            fixture: jet_cli_case_fixture(line) ?? next
            checked += 1
            path: "{directory}/{fixture}"
            if !cli_files.is_dir(path) -> missing.push("  {file} -> `{fixture}` is not a directory beside the case\n")
        }
    }
    if missing.len() == 0 -> return JetDriverVerbOutput{stdout: "check-fixture-paths: {checked} fixture path(s) across {cases.len()} case(s), all present\n", stderr: "", exit_code: JET_DRIVER_EXIT_OK}
    JetDriverVerbOutput{stdout: "", stderr: "check-fixture-paths: {missing.len()} missing fixture path(s):\n{missing.join("")}", exit_code: JET_DRIVER_EXIT_USER_ERROR}
}
