fn checked_value(source: &String) -> CtValue {
    (checked_diagnostics, bundle, effect_facts) :: Driver.check_eval_with_effect_facts(source, "core.compiler.jet")
    checked_value_from_parts(source, checked_diagnostics, bundle.as_ref(), effect_facts)
}
// Rust: Source/Compiler.rs:1965
fn checked_value_from_parts(source: &String, checked_diagnostics: &[Diagnostic], bundle: &AST.ProgramBundle?, effect_facts: &crate.Sema.SemIndexEffectFacts) -> CtValue {
    syntax :: parse_source(source)
    diagnostics :: checked_diagnostics.iter().map(diagnostic_view).collect()
    has_errors :: checked_diagnostics.iter().any(diagnostic -> diagnostic.severity == Severity.Error)
    syntax_value :: syntax_tree_value(syntax)
    (functions, effects, semantic_index) :: if bundle == {
        Val(bundle) -> {
            index :: from_checked(bundle, effect_facts)
            semantic_facts :: Driver.program_semantic_facts(bundle, effect_facts)
            view :: SemIndexProgramIndex { index: &index }
            program :: Comptime.build_program_info_with_index(bundle, semantic_facts, Val(&view))
            functions :: field_value(program, "functions").unwrap_or_else(() -> CtValue.List([]))
            effects :: CtValue.List(index.effects().iter().map(effect -> effect_info_value(effect.inferred.clone())).collect())
            semantic_index :: if has_errors {
                CtValue.absent(Type.Named("CompilerSemanticIndex"))
            } else {
                CtValue.Present(compiler_semantic_index_value(index, source, effect_facts.fact_registry))
            }
            (functions, effects, semantic_index)
        }
        None -> {
            functions :: syntax.items.iter().filter(node -> node.kind == SyntaxNodeKind.Function).map(compiler_function_value).collect()
            (CtValue.List(functions), CtValue.absent(Type.Named("CompilerSemanticIndex")), CtValue.absent(Type.Named("CompilerSemanticIndex")))
        }
    }
    ct_struct("CompilerChecked", [
        ("schema_version", CtValue.Int(SCHEMA_VERSION as I64)),
        ("source", CtValue.Str(source.clone())),
        ("syntax", syntax_value),
        ("diagnostics", CtValue.List(diagnostics.iter().map(diagnostic_value).collect())),
        ("functions", functions), ("effects", effects), ("semantic_index", semantic_index)
    ])
}
// Rust: Source/Compiler.rs:2035
fn source_map_value(map: &SourceMap) -> CtValue {
    ct_struct("CompilerSourceMap", [
        ("schema_version", CtValue.Int(SCHEMA_VERSION as I64)),
        ("sources", CtValue.List(map.sources.iter().cloned().map(CtValue.Str).collect())),
        ("generated_lines", CtValue.List(map.generated_lines.iter().map(line -> {
            ct_struct("CompilerGeneratedLine", [
                ("generated_line", CtValue.Int(line.generated_line as I64)),
                ("source", line.source.clone().map_or(CtValue.absent(Type.String), source -> CtValue.Present(CtValue.Str(source)))),
                ("source_line", CtValue.Int(line.source_line as I64))
            ])
        }).collect()))
    ])
}
