fn status_map_key(key: &CtKey) -> String {
    if key == {
        CtKey.Int(value) -> value.to_string()
        CtKey.Str(value) -> value.clone()
        CtKey.Bool(value) -> value.to_string()
        CtKey.Char(value) -> value.to_string()
        CtKey.Tuple(_) | CtKey.Struct { .. } | CtKey.Enum { .. } -> key.to_value().to_json()
    }
}
// Rust: Source/Compiler.rs:2564
fn status_ct_value(value: &CtValue) -> StatusValue {
    if value == {
        CtValue.Int(value) -> StatusValue.from(value)
        CtValue.Float(value) -> StatusValue.Float(value.to_json())
        CtValue.Bool(value) -> StatusValue.from(value)
        CtValue.Char(value) -> StatusValue.from(value.to_string())
        CtValue.Str(value) -> StatusValue.from(value.as_str())
        CtValue.BigInt(value) -> StatusValue.from(value.to_string_rep().as_str())
        CtValue.Bytes(values) -> StatusValue.array(values.iter().map(value -> StatusValue.from(value as I128)))
        CtValue.List(values) -> StatusValue.array(values.iter().map(status_ct_value))
        CtValue.Map(values) -> StatusValue.object(values.iter().fold(StatusFields.new(), (fields, (key, value)) -> fields.with(status_map_key(key), status_ct_value(value))))
        CtValue.Struct { fields, .. } -> StatusValue.object(fields.iter().filter((name, _) -> !Syntax.is_memo_storage_name(name))
            .fold(StatusFields.new(), (fields, (name, value)) -> fields.with(name.as_str(), status_ct_value(value))))
        CtValue.Enum { variant, args, .. } if args.is_empty() -> StatusValue.from(variant.as_str())
        CtValue.Enum { variant, args, .. } if args.iter().all((label, _) -> label.is_some()) -> {
            fields :: args.iter().fold(StatusFields.new(), (fields, (label, value)) -> fields.with(label.as_deref().expect("checked enum label"), status_ct_value(value)))
            StatusValue.object(StatusFields.new().with(variant.as_str(), StatusValue.object(fields)))
        }
        CtValue.Enum { variant, args, .. } -> StatusValue.object(StatusFields.new().with(variant.as_str(), StatusValue.array(args.iter().map((_, value) -> status_ct_value(value)))))
        CtValue.Present(value) -> status_ct_value(value)
        CtValue.Failed(CtReport.Clean(_)) | CtValue.Unit | CtValue.Closure(_) -> StatusValue.Null
        CtValue.Failed(CtReport.Told(value)) -> StatusValue.object(StatusFields.new().with("err", status_ct_value(value)))
    }
}
// Rust: Source/Compiler.rs:2619
fn source_map_from_generated_rust(rust_src: &String) -> SourceMap {
    sources := []
    current_source := None
    generated_lines := []
    loop (idx, line) in rust_src.lines().enumerate() {
        generated_line :: idx + 1
        trimmed := line.trim_start() // #4303
        if trimmed.strip_prefix("// jet:source-map source=") == Val(source) {
            current_source = Val(source.to_string())
            if !sources.iter().any(s -> s == source) { sources.push(source.to_string()) }
            continue
        }
        if trimmed.strip_prefix("// jet:line ") == Val(rest) {
            trimmed_rest := rest.trim() // #4303
            if trimmed_rest.parse::<USize>() == Ok(source_line) {
                generated_lines.push(GeneratedLine { generated_line: generated_line, source: current_source.clone(), source_line: source_line })
            }
        }
    }
    SourceMap { api_version: API_VERSION, schema_version: SCHEMA_VERSION, sources: sources, generated_lines: generated_lines }
}
// Rust: Source/Compiler.rs:2673
const POSITION_CHECKPOINT_BYTES: USize = 1024
// Rust: Source/Compiler.rs:2676
struct PositionCheckpoint { offset: USize; line: USize; column: USize }
// Rust: Source/Compiler.rs:2682
struct SourcePositionIndex {
    checkpoints: [PositionCheckpoint]
    // Rust: Source/Compiler.rs:2687
    // Byte checkpoints bound lookup scans without retaining a position per byte.
    fn new(src: &String) -> SourcePositionIndex {
        capacity :: (src.len() / POSITION_CHECKPOINT_BYTES).saturating_add(2)
        checkpoints := [PositionCheckpoint].with_capacity(capacity)
        line := 1
        column := 1
        checkpoints.push(PositionCheckpoint { offset: 0, line: line, column: column })
        next_checkpoint := POSITION_CHECKPOINT_BYTES
        loop (offset, ch) in src.char_indices() {
            loop offset >= next_checkpoint {
                checkpoints.push(PositionCheckpoint { offset: offset, line: line, column: column })
                next_checkpoint = next_checkpoint.saturating_add(POSITION_CHECKPOINT_BYTES)
            }
            if ch == '\n' { line += 1; column = 1 } else { column += 1 }
        }
        if checkpoints.last().map(checkpoint -> checkpoint.offset) != Val(src.len()) {
            checkpoints.push(PositionCheckpoint { offset: src.len(), line: line, column: column })
        }
        SourcePositionIndex { checkpoints: checkpoints }
    }
    // Rust: Source/Compiler.rs:2728
    fn line_col(self: &SourcePositionIndex, src: &String, offset: USize) -> LineCol {
        checkpoint_index :: self.checkpoints.binary_search_by_key(offset, checkpoint -> checkpoint.offset)
            .unwrap_or_else(index -> index.saturating_sub(1))
        checkpoint :: self.checkpoints[checkpoint_index]
        bytes_after_checkpoint :: offset.saturating_sub(checkpoint.offset)
        line := checkpoint.line
        column := checkpoint.column
        loop (relative, ch) in src[checkpoint.offset..].char_indices() {
            if relative >= bytes_after_checkpoint { break }
            if ch == '\n' { line += 1; column = 1 } else { column += 1 }
        }
        LineCol { line: line, column: column }
    }
}
// Rust: Source/Compiler.rs:2752
fn token_view(src: &String, token: &Token, positions: &SourcePositionIndex) -> TokenView {
    start :: positions.line_col(src, token.span.start)
    end :: positions.line_col(src, token.span.end)
    TokenView { kind: token_kind_name(token.kind), text: token_text(src, token), span: TextRange.from(token.span), start: start, end: end }
}
// Rust: Source/Compiler.rs:2764
fn diagnostic_view(diagnostic: &Diagnostic) -> DiagnosticView {
    DiagnosticView {
        code: diagnostic.code.to_string(),
        severity: if diagnostic.severity == { Severity.Error -> DiagnosticSeverity.Error; Severity.Lint -> DiagnosticSeverity.Lint },
        message: diagnostic.what.clone(), why: diagnostic.why.clone(), fix: diagnostic.fix.clone(),
        span: diagnostic.span.map(TextRange.from)
    }
}
// Rust: Source/Compiler.rs:2778
fn bundle_syntax_tree(bundle: &AST.ProgramBundle, source: &String) -> SyntaxTree {
    items := []
    loop module in bundle.modules { items.extend(module.items.iter().map(item_node)) }
    SyntaxTree { api_version: API_VERSION, schema_version: SCHEMA_VERSION, source: source.clone(), items: items, diagnostics: [] }
}
// Rust: Source/Compiler.rs:2792
fn item_node(item: &AST.Item) -> SyntaxNode {
    (kind, name, span) :: if item == {
        AST.Item.Func(f) -> (SyntaxNodeKind.Function, Val(f.name.clone()), f.name_span)
        AST.Item.Struct(s) -> (SyntaxNodeKind.Struct, Val(s.name.clone()), s.name_span)
        AST.Item.Enum(e) -> (SyntaxNodeKind.Enum, Val(e.name.clone()), e.name_span)
        AST.Item.Distinct(d) -> (SyntaxNodeKind.Distinct, Val(d.name.clone()), d.name_span)
        AST.Item.TypeAlias(a) -> (SyntaxNodeKind.TypeAlias, Val(a.name.clone()), a.name_span)
        AST.Item.UnitFamily(f) -> (SyntaxNodeKind.UnitFamily, Val(f.family.clone()), f.family_span)
        AST.Item.Trait(t) -> (SyntaxNodeKind.Trait, Val(t.name.clone()), t.name_span)
        AST.Item.Tag(t) -> (SyntaxNodeKind.Tag, Val(t.name.clone()), t.name_span)
        AST.Item.EffectDecl(effect) -> (SyntaxNodeKind.Effect, Val(effect.name.clone()), effect.name_span)
        AST.Item.Impl(i) -> (SyntaxNodeKind.Impl, Val(i.type_name.clone()), i.type_span)
        AST.Item.Const(c) -> (SyntaxNodeKind.Const, Val(c.name.clone()), c.name_span)
        AST.Item.Test(t) -> (SyntaxNodeKind.Test, t.name.clone(), t.name_span)
        AST.Item.ExternRust(e) -> (SyntaxNodeKind.ExternRust, Val(e.crate_spec.clone()), e.span)
        AST.Item.Module(m) -> (SyntaxNodeKind.Module, Val(m.name.clone()), m.name_span)
        AST.Item.CModule(m) -> (SyntaxNodeKind.CModule, Val(m.lib.clone()), m.path_span)
        AST.Item.CodeModule(m) -> (SyntaxNodeKind.CodeModule, Val(m.name.clone()), m.name_span)
        AST.Item.ErrorConv(e) -> (SyntaxNodeKind.ErrorConversion, Val("{e.from_ty} -> {e.to_ty}"), e.from_span)
        AST.Item.Migration(m) -> (SyntaxNodeKind.Migration, Val(m.type_name.clone()), m.type_span)
        AST.Item.ProtocolDecl(p) -> (SyntaxNodeKind.Protocol, Val(p.name.clone()), p.name_span)
        AST.Item.UserDerive(d) -> (SyntaxNodeKind.Derive, Val(d.trait_name.clone()), d.trait_span)
        AST.Item.GenericModule(m) -> (SyntaxNodeKind.GenericModule, Val(m.name.clone()), m.name_span)
        AST.Item.ModuleAlias(m) -> (SyntaxNodeKind.ModuleAlias, Val(m.name.clone()), m.name_span)
        AST.Item.MarkerDecl(m) -> (SyntaxNodeKind.Marker, Val(m.name.clone()), m.name_span)
        AST.Item.FactDecl(f) -> (SyntaxNodeKind.Fact, Val(f.name.clone()), f.name_span)
        // D-STRUCT-ONCE1=A: root declaration loops are nameless templates expanded by sema.
        AST.Item.TemplateLoop(l) -> (SyntaxNodeKind.TemplateLoop, None, l.span)
    }
    SyntaxNode { kind: kind, name: name, span: TextRange.from(span) }
}
// Rust: Source/Compiler.rs:2865
fn token_text(src: &String, token: &Token) -> String {
    if token.span.start <= token.span.end && token.span.end <= src.len() {
        src[token.span.start..token.span.end].to_string()
    } else { "" }
}
