struct CheckedFile { api_version: U32; schema_version: U32; diagnostics: [DiagnosticView]; syntax: SyntaxTree?; semantic_index: SemIndexView? }
// Rust: Source/Compiler.rs:2214
fn lex_source(src: &String) -> LexedSource {
    (tokens, diagnostics) :: if Package.mask_inline_package_source(src) == {
        Ok((source, _)) -> Lexer.lex(source)
        Err(error) -> ([], [error.diagnostic()])
    }
    positions :: SourcePositionIndex.new(src)
    LexedSource {
        api_version: API_VERSION, schema_version: SCHEMA_VERSION, source: src.clone(),
        tokens: tokens.iter().map(token -> token_view(src, token, positions)).collect(),
        diagnostics: diagnostics.iter().map(diagnostic_view).collect()
    }
}
// Rust: Source/Compiler.rs:2231
fn parse_source(src: &String) -> SyntaxTree {
    lexed :: lex_source(src)
    if !lexed.diagnostics.is_empty() {
        return SyntaxTree { api_version: API_VERSION, schema_version: SCHEMA_VERSION, source: src.clone(), items: [], diagnostics: lexed.diagnostics }
    }
    source_for_parse :: Package.mask_inline_package_source(src).map((source, _) -> source).unwrap_or_else(_ -> src.clone())
    (tokens, _) :: Lexer.lex(source_for_parse)
    if Parser.parse_for_check_with_source(tokens, source_for_parse) == {
        Ok((program, parse_teaching)) -> SyntaxTree {
            api_version: API_VERSION, schema_version: SCHEMA_VERSION, source: src.clone(),
            items: program.items.iter().map(item_node).collect(), diagnostics: parse_teaching.iter().map(diagnostic_view).collect()
        }
        Err(diagnostics) -> SyntaxTree {
            api_version: API_VERSION, schema_version: SCHEMA_VERSION, source: src.clone(), items: [],
            diagnostics: diagnostics.iter().map(diagnostic_view).collect()
        }
    }
}
// Rust: Source/Compiler.rs:2266
fn check_file(path: &OSPath) -> CheckedFile {
    file :: path.to_string_lossy()
    (diagnostics, bundle, facts) :: Driver.check_file_with_effect_facts(file, None, true)
    has_errors :: diagnostics.iter().any(d -> d.severity == Severity.Error)
    // GATE #4494: native retained-path file read.
    source :: fs.read_to_string(path).unwrap_or_default()
    syntax :: bundle.as_ref().map(bundle -> bundle_syntax_tree(bundle, source))
    semantic_index :: if has_errors { None } else {
        bundle.as_ref().map(bundle -> SemIndexView.from_index(from_checked(bundle, facts), source, facts.fact_registry))
    }
    CheckedFile { api_version: API_VERSION, schema_version: SCHEMA_VERSION, diagnostics: diagnostics.iter().map(diagnostic_view).collect(), syntax: syntax, semantic_index: semantic_index }
}
