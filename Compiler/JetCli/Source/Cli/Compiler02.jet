        StatusValue.object(StatusFields.new().with("kind", syntax_node_kind_name(node.kind))
            .with("name", node.name.as_deref().map(StatusValue.from).unwrap_or(StatusValue.Null))
            .with("span", StatusValue.object(StatusFields.new().with("start", node.span.start).with("end", node.span.end))))
    }))
    StatusValue.object(StatusFields.new().with("schema_version", tree.schema_version).with("api_version", tree.api_version)
        .with("source", tree.source.as_str()).with("items", items).with("diagnostics", status_diagnostics(tree.diagnostics)))
}
