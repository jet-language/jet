// `jet check --style`: the opt-in style checks, off by default. Impl
// placement (L0535, #6561) is the first: a struct or enum holds its own
// impls, so a top-level `impl T` or `impl T.Trait` in the file that declares
// `T` is flagged unless one of the lint's exception rules applies.
use {
    jet_driver.[JetDriverAuthorizedSourceSnapshot, jet_driver_apply_edits]
    jet_foundation.[Diagnostic, ImplDef, Item, Program, Span, TextEdit, diagnostic_from_registry, diagnostic_with_source_path]
    jet_parser.[parse_source]
}

// Why a top-level impl stays outside its type's body. Two exceptions need no
// rule here: a type declared in another file, module or package (a) has no
// body in this file, and an error conversion `impl A -> B` (b) parses as its
// own item, never an impl. The body holds every other impl form, `using`
// delegation and operator impls included, so no rule names a form the body
// cannot hold.
JetCLIImplPlacementRule: enum {
    // (c) `impl X.Client` or `impl X.Server`: a protocol side.
    ProtocolSide
    // (d) `#Target(OS.…)`: an impl for one target.
    TargetSpecific
    // (e) an impl a derive writes; a generated source file is never read.
    Generated
    // (g) an inherent impl with its own markers, which in the body would
    // become the type's markers.
    MarkedInherent
}

// The impl placement findings of every source file of the entry root the
// check admitted, each on its own file. A file that does not parse is left to
// the check's own report.
jet_cli_style_diagnostics: fn(snapshot: JetDriverAuthorizedSourceSnapshot) -> [Diagnostic] Never! {
    found := [Diagnostic]{}
    loop root in snapshot.roots {
        if root.identity != snapshot.entry_root_identity -> next
        loop file in root.files {
            if !file.path.ends_with(".jet") -> next
            parsed: parse_source(file.source.bytes())
            if jet_cli_errors(parsed.diagnostics).len() > 0 -> next
            loop diagnostic in jet_cli_impl_placement_lints(parsed.program) -> found.push(diagnostic_with_source_path(diagnostic, file.path, 0))
        }
    }
    found
}

// L0535 for each top-level impl of a struct or enum the same program
// declares that no exception rule keeps outside the body.
jet_cli_impl_placement_lints: fn(program: Program) -> [Diagnostic] Never! {
    declared := [String:Bool]{}
    loop item in program.items {
        if item == {
            .Struct(value) -> declared[value.name] = true
            .Enum(value) -> declared[value.name] = true
            .Func(_) | .Distinct(_) | .TypeAlias(_) | .UnitFamily(_) | .Trait(_) | .Tag(_) | .EffectDecl(_) | .Impl(_) | .Const(_) | .Test(_) | .ExternRust(_) | .Module(_) | .CModule(_) | .CodeModule(_) | .ErrorConv(_) | .Migration(_) | .ProtocolDecl(_) | .UserDerive(_) | .TemplateLoop(_) | .GenericModule(_) | .ModuleAlias(_) | .MarkerDecl(_) | .FactDecl(_) -> {}
        }
    }
    found := [Diagnostic]{}
    loop item in program.items {
        if item == .Impl(value) {
            if !declared.has_key(value.type_name) || jet_cli_impl_placement_exception(value) != None -> next
            head: if value.trait_name == .Val(name) -> "{value.type_name}.{name}" else -> value.type_name.copy()
            span: Span{start: value.span.start, end: (value.trait_span ?? value.type_span).end}
            found.push(diagnostic_from_registry("L0535", Val(span), "`impl {head}` sits outside the body of `{value.type_name}`", "`{value.type_name}` is declared in this file, and a struct or enum holds its own impls; a top-level impl stays only where it has to be somewhere else", "Move it into the body of `{value.type_name}`: its methods as `fn` members, a trait impl as a nested `impl Trait {{ … }}`"))
        }
    }
    found
}

// The exception rule that keeps `value` outside its type's body, if any.
jet_cli_impl_placement_exception: fn(value: ImplDef) -> JetCLIImplPlacementRule? Never! {
    if value.type_name.ends_with(".Client") || value.type_name.ends_with(".Server") -> return Val(JetCLIImplPlacementRule.ProtocolSide)
    if value.os_target != None -> return Val(JetCLIImplPlacementRule.TargetSpecific)
    loop marker in value.markers {
        if marker.name == "Target" -> return Val(JetCLIImplPlacementRule.TargetSpecific)
    }
    if value.is_generated_serde -> return Val(JetCLIImplPlacementRule.Generated)
    if value.trait_name == None && value.markers.len() > 0 -> return Val(JetCLIImplPlacementRule.MarkedInherent)
    None
}

// `jet fix --style`: each impl `jet check --style` flags (L0535) moves into
// its type's body, in source order, with the comment and marker lines written
// right above it: an inherent impl's members become the body's members, and
// a trait impl becomes a nested `impl Trait { … }`, its own markers kept
// where they were written. The moved text keeps its bytes; only the
// indentation and the type name of a trait impl's head change. An impl the
// fix cannot lift whole is left for a hand edit: one whose type closes its
// body on a line holding other text, or an inherent impl that opens its body
// on the head line and closes it on a later one. `deferred` counts those.
jet_cli_fix_style: fn(before: String) -> JetCLIFixApply Never! {
    unchanged: JetCLIFixApply{source: before.copy(), applied: 0, deferred: 0} // copy: the caller keeps the input.
    parsed: parse_source(before.bytes())
    if jet_cli_errors(parsed.diagnostics).len() > 0 -> return unchanged
    bytes: before.bytes()
    // Each declared type, and where the line of its closing `}` starts when
    // the brace stands alone on it (-1 when it does not).
    closes := [String:Int]{}
    loop item in parsed.program.items {
        if item == {
            .Struct(value) -> closes[value.name] = jet_cli_style_close_line(bytes, value.span)
            .Enum(value) -> closes[value.name] = jet_cli_style_close_line(bytes, value.span)
            .Func(_) | .Distinct(_) | .TypeAlias(_) | .UnitFamily(_) | .Trait(_) | .Tag(_) | .EffectDecl(_) | .Impl(_) | .Const(_) | .Test(_) | .ExternRust(_) | .Module(_) | .CModule(_) | .CodeModule(_) | .ErrorConv(_) | .Migration(_) | .ProtocolDecl(_) | .UserDerive(_) | .TemplateLoop(_) | .GenericModule(_) | .ModuleAlias(_) | .MarkerDecl(_) | .FactDecl(_) -> {}
        }
    }
    edits := [TextEdit]{}
    moved := [String:String]{}
    order := [String]{}
    deferred := 0
    // Where the last lifted impl's bytes end; the next one takes no line
    // before that.
    floor := 0
    loop item in parsed.program.items {
        if item == .Impl(value) {
            at: closes.get(value.type_name) ?? next
            if jet_cli_impl_placement_exception(value) != None -> next
            lifted := JetCLIStyleLift?{None}
            if at >= 0 -> lifted = jet_cli_style_lift(bytes, value, floor)
            if lifted == .Val(block) {
                edits.push(TextEdit{span: Span{start: block.start, end: block.end}, new_text: ""})
                floor = block.end
                if !order.contains(value.type_name) -> order.push(value.type_name.copy()) // copy: the order list keeps the name.
                moved[value.type_name] = "{moved.get(value.type_name) ?? ""}\n{block.text}"
            } else {
                deferred += 1
            }
        }
    }
    if edits.len() == 0 -> return JetCLIFixApply{source: before.copy(), applied: 0, deferred: deferred} // copy: nothing moved.
    applied: edits.len()
    loop name in order {
        at: closes.get(name) ?? next
        edits.push(TextEdit{span: Span{start: at, end: at}, new_text: moved.get(name) ?? ""})
    }
    // The edits cannot overlap: each lifted range starts at or after `floor`.
    text: jet_driver_apply_edits(before, edits) ?? return unchanged
    JetCLIFixApply{source: text, applied: applied, deferred: deferred}
}

// One impl lifted out of the file: the bytes it leaves (its comment and
// marker lines, its lines, and one blank line beside them) and the text the
// type's body takes.
JetCLIStyleLift: struct {
    start: Int
    end: Int
    text: String
}

// Where the line of the `}` closing `span` starts, or -1 when the brace
// shares its line with other text.
jet_cli_style_close_line: fn(bytes: [U8], span: Span) -> Int Never! {
    close: span.end - 1
    if close < 0 || close >= bytes.len() || bytes[close] != 125 -> return -1
    start: jet_cli_style_line_start(bytes, close)
    if !jet_cli_style_blank(bytes, start, close) -> return -1
    start
}

// `value` lifted whole, or None when it shares a line with other code.
// `floor`: where the bytes the previous lifted impl leaves end; no line
// before it is taken twice.
jet_cli_style_lift: fn(bytes: [U8], value: ImplDef, floor: Int) -> JetCLIStyleLift? Never! {
    head: jet_cli_style_line_start(bytes, value.span.start)
    if head != value.span.start -> return None
    // The impl's closing line holds nothing after it but a comment.
    after: jet_cli_style_line_end(bytes, value.span.end)
    if !jet_cli_style_blank_or_comment(bytes, value.span.end, after) -> return None
    // The comment and marker lines written right above it.
    start := head
    loop start > floor {
        above: jet_cli_style_line_start(bytes, start - 1)
        text: jet_cli_style_text(bytes, above, start).trim().copy()
        if !text.starts_with("//") && !text.starts_with("#") -> break
        start = above
    }
    leading: jet_cli_style_text(bytes, start, head)
    body := ""
    if value.trait_name == None {
        // Inherent: the members, at the indentation they already have.
        open: jet_cli_style_find(bytes, value.type_span.end, 123)
        close: value.span.end - 1
        if open < 0 || open >= close -> return None
        if jet_cli_style_blank(bytes, open + 1, jet_cli_style_line_end(bytes, open) - 1) && jet_cli_style_line_start(bytes, close) > open {
            if !jet_cli_style_blank(bytes, jet_cli_style_line_start(bytes, close), close) -> return None
            body = "{jet_cli_style_indent(leading)}{jet_cli_style_text(bytes, jet_cli_style_line_end(bytes, open), jet_cli_style_line_start(bytes, close))}"
        } else if jet_cli_style_line_start(bytes, close) == head {
            body = "{jet_cli_style_indent(leading)}    {jet_cli_style_text(bytes, open + 1, close).trim()}\n"
        } else {
            return None
        }
    } else if value.trait_span == .Val(trait_span) {
        // A trait impl: `impl T.Trait` is written `impl Trait` in the body.
        written: "{leading}{jet_cli_style_text(bytes, head, value.type_span.start)}{jet_cli_style_text(bytes, trait_span.start, after)}"
        body = jet_cli_style_indent(written)
    } else {
        return None
    }
    end := after
    // One blank line beside the impl goes with it: the one after, else the
    // one before.
    if end < bytes.len() && jet_cli_style_blank(bytes, end, jet_cli_style_line_end(bytes, end) - 1) {
        end = jet_cli_style_line_end(bytes, end)
    } else if start > floor {
        above: jet_cli_style_line_start(bytes, start - 1)
        if above >= floor && jet_cli_style_blank(bytes, above, start - 1) -> start = above
    }
    Val(JetCLIStyleLift{start: start, end: end, text: body})
}

// Every non-blank line of `text` one level (4 spaces) deeper.
jet_cli_style_indent: fn(text: String) -> String Never! {
    shifted := [String]{}
    loop line in text.split("\n").to_list() {
        shifted.push(if line.trim() == "" -> "" else -> "    {line}")
    }
    shifted.join("\n")
}

// Where the line holding `at` starts.
jet_cli_style_line_start: fn(bytes: [U8], at: Int) -> Int Never! {
    start := at
    loop start > 0 && bytes[start - 1] != 10 -> start -= 1
    start
}

// The start of the line after the one holding `at` (or the end of the file).
jet_cli_style_line_end: fn(bytes: [U8], at: Int) -> Int Never! {
    end := at
    loop end < bytes.len() && bytes[end] != 10 -> end += 1
    if end < bytes.len() -> end + 1 else -> end
}

// The first `byte` at or after `at` on its line, or -1.
jet_cli_style_find: fn(bytes: [U8], at: Int, byte: U8) -> Int Never! {
    index := at
    loop index < bytes.len() && bytes[index] != 10 {
        if bytes[index] == byte -> return index
        index += 1
    }
    -1
}

// Whether `bytes[start..<end]` is only spaces, tabs and line ends.
jet_cli_style_blank: fn(bytes: [U8], start: Int, end: Int) -> Bool Never! {
    loop index in start..<end {
        if bytes[index] != 32 && bytes[index] != 9 && bytes[index] != 10 && bytes[index] != 13 -> return false
    }
    true
}

// Whether `bytes[start..<end]` is blank or a `//` comment.
jet_cli_style_blank_or_comment: fn(bytes: [U8], start: Int, end: Int) -> Bool Never! {
    rest: jet_cli_style_text(bytes, start, end).trim().copy()
    rest == "" || rest.starts_with("//")
}

jet_cli_style_text: fn(bytes: [U8], start: Int, end: Int) -> String Never! {
    String.from_bytes(bytes[start..<end]) ?? panic("a source slice is not UTF-8")
}
