// The offline syntax dictionary's queries (crates/jet-cli and the syntax leaf
// of `lookup`) over SyntaxDictionaryData.jet. Shared with the Jetpack unit:
// `jetpack explain <token>` answers from the same one table (Rust jetpack used
// `Syntax::lookup` and `Explain::lookup`).
use jet_foundation.[DiagnosticExplanation]

// ASCII lowercase (Rust `to_ascii_lowercase`).
jet_cli_ascii_lower: fn(value: String) -> String Never! {
    bytes := [U8]{}
    loop byte in value.bytes() {
        code: Int{byte}
        if code >= 65 && code <= 90 {
            bytes.push(checked(U8{code + 32}) ?? byte)
        } else {
            bytes.push(byte)
        }
    }
    String.from_bytes(bytes) ?? value
}

// Levenshtein distance over characters.
jet_cli_edit_distance: fn(left: String, right: String) -> Int Never! {
    a: left.chars()
    b: right.chars()
    previous := [Int]{}
    loop index in 0..<b.len() + 1 -> previous.push(index)
    loop i in 0..<a.len() {
        current := [Int]{i + 1}
        loop j in 0..<b.len() {
            cost: if a[i] == b[j] -> 0 else -> 1
            best := previous[j] + cost
            if previous[j + 1] + 1 < best -> best = previous[j + 1] + 1
            if current[j] + 1 < best -> best = current[j] + 1
            current.push(best)
        }
        previous = current
    }
    previous[b.len()]
}

// An exact spelling wins before ASCII case folding: `Effect` (the type) and
// `effect` (the keyword), or `state` (the keyword) and `#State` (the marker),
// are separate rows, and each row's own display must find that row.
jet_cli_syntax_lookup: fn(query: String) -> Int? Never! {
    trimmed: query.trim()
    loop (index, row) in JET_CLI_SYNTAX_ROWS {
        if trimmed == jet_cli_syntax_display(row) -> return Val(index)
    }
    wanted: jet_cli_ascii_lower(trimmed)
    loop (index, row) in JET_CLI_SYNTAX_ROWS {
        if wanted == row.query || wanted == row.display_query -> return Val(index)
    }
    None
}

jet_cli_syntax_display: fn(row: JetCLISyntaxRow) -> String Never! {
    if row.kind == JetCLISyntaxKind.Marker -> "#{row.token}" else -> row.token
}

// The plain meaning of a row's kind, which is all a generated row has until
// prose is written on it.
jet_cli_syntax_kind_meaning: fn(row: JetCLISyntaxRow) -> JetCLISyntaxMeaning Never! {
    display: jet_cli_syntax_display(row)
    text: if row.kind == {
        .Marker -> "The marker `{display}`."
        .Literal -> "The literal `{display}`."
        .Keyword | .Operator | .Sigil | .Type | .Builtin -> "The Jet keyword `{display}`."
    }
    example: if row.kind == JetCLISyntaxKind.Literal -> display else -> "{display} …"
    JetCLISyntaxMeaning{position: "", text: text, example: example, afterwards: "", related_codes: [String]{}}
}

jet_cli_syntax_meanings_text: fn(meanings: [JetCLISyntaxMeaning]) -> String Never! {
    text := ""
    loop (index, meaning) in meanings {
        if index > 0 -> text = "{text}\n"
        indent := ""
        if meaning.position != "" {
            text = "{text}{meaning.position}:\n"
            indent = "  "
        }
        text = "{text}{indent}{meaning.text}\n{indent}Example:\n"
        loop line in meaning.example.lines() -> text = "{text}{indent}  {line}\n"
        if meaning.afterwards != "" -> text = "{text}{indent}Afterwards: {meaning.afterwards}\n"
        if meaning.related_codes.len() > 0 -> text = "{text}{indent}Related: {meaning.related_codes.join(", ")}\n"
    }
    text
}

// A row's meanings: its own, else the plain meaning of its kind.
jet_cli_syntax_plain_text: fn(row: JetCLISyntaxRow) -> String Never! {
    if row.meanings.len() > 0 -> return jet_cli_syntax_meanings_text(row.meanings)
    jet_cli_syntax_meanings_text([JetCLISyntaxMeaning]{jet_cli_syntax_kind_meaning(row)})
}

// The first line of jet_cli_syntax_plain_text's meanings.
jet_cli_syntax_first_meaning: fn(row: JetCLISyntaxRow) -> String Never! {
    if row.meanings.len() > 0 -> return row.meanings[0].text
    jet_cli_syntax_kind_meaning(row).text
}

// The syntax-registry explanation of a dictionary token, or None.
jet_cli_syntax_explanation: fn(query: String) -> DiagnosticExplanation? Never! {
    index: jet_cli_syntax_lookup(query) ?? return None
    row: JET_CLI_SYNTAX_ROWS[index]
    Val(DiagnosticExplanation{code: query.trim(), stage: "syntax registry", meaning: jet_cli_syntax_first_meaning(row), what: Val(jet_cli_syntax_plain_text(row).trim_end()), why: None, fix: None, example: None})
}

jet_cli_syntax_ascii_alphanumeric: fn(code: Int) -> Bool Never! {
    (code >= 48 && code <= 57) || (code >= 65 && code <= 90) || (code >= 97 && code <= 122)
}

// looks_like_query: package references are not typo queries.
jet_cli_syntax_query: fn(query: String) -> Bool Never! {
    text: query.trim()
    if text.starts_with("package-overlay:") -> return false
    if text.contains("@") && !text.starts_with("@") -> return false
    raw: text.bytes()
    colon := -1
    loop (index, byte) in raw {
        if byte == (U8{58}) {
            colon = index
            break
        }
    }
    if colon > 0 && colon + 1 < raw.len() {
        prefix := true
        loop index in 0..<colon {
            code: Int{raw[index]}
            if !jet_cli_syntax_ascii_alphanumeric(code) && code != 95 && code != 45 && code != 46 && code != 47 -> prefix = false
        }
        if prefix {
            loop index in (colon + 1)..<raw.len() {
                if jet_cli_syntax_ascii_alphanumeric(Int{raw[index]}) -> return false
            }
        }
    }
    if text.starts_with("@") || text.starts_with("#") || text.starts_with(":") -> return true
    loop byte in raw {
        code: Int{byte}
        if !jet_cli_syntax_ascii_alphanumeric(code) && code != 95 && code != 46 && code != 45 && code != 47 && code != 64 -> return true
    }
    false
}

jet_cli_syntax_nearest: fn(query: String) -> String Never! {
    wanted: jet_cli_ascii_lower(query.trim())
    best := -1
    closest := -1
    loop (index, row) in JET_CLI_SYNTAX_ROWS {
        distance: jet_cli_edit_distance(wanted, row.display_query)
        if best < 0 || distance < best {
            best = distance
            closest = index
        }
    }
    if closest < 0 -> "a registered syntax token" else -> jet_cli_syntax_display(JET_CLI_SYNTAX_ROWS[closest])
}
