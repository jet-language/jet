// `jet inspect choices`: the automatic choices the compiler made for the
// checked program, each with its reason, by kind.
// - Storage form: a reactive handle (`Signal`, `Derived`, `Computed`) that
//   crosses into a task, a channel or a parallel worker, or is pinned
//   `#Shared`, is kept in synchronized storage (sema's reactive upgrade
//   facts, FunctionReactive.jet). `#Local` locks the one-thread form: a
//   crossing then fails the build naming it (E1102).
// - Inlining: each call site the optimizer inlined as `jet build` optimizes
//   the program (jet_cli_decisions: the profile's level and the build option
//   flags), with why it was taken (JetIR OptInline.jet). `#Inline(Always)`
//   locks a callee inlined: a change that makes it recursive, address-taken
//   or too large fails the build naming it (E0917-E0919).
// - Collection: under `#Policy(gc)`, a binding whose returned heap graph
//   needs identity beyond its lexical owner is kept by the policy scope's
//   collector, and a binding that takes such a value from its call holds it
//   there too (sema's promotion facts, FunctionMemory.jet).
// - Copies: each copy sema puts in a body that the source does not write
//   (Checked.jet CopyFact). A binding moved by its plain name and read again
//   later is shared: the move becomes a copy. A borrowed or still-used value
//   passed to a variadic list or `debug` is materialized. `#Policy(copies:
//   .Explicit)` locks the share out: the move stays a move, and the later
//   read fails the build naming the binding (E0121).
// - Placement: in a program that opts in to the web partition (a web marker
//   or a `#Target` ceiling), the JS or Wasm bucket of each function, with
//   why (sema's `web_reason`, WebPartition.jet). `#Target(JS|Wasm)` locks
//   it: a Wasm-pinned function that uses `Browser` fails the build naming it
//   (E-WEB-TARGET-BROWSER), and so does a call across the buckets
//   (E-WEB-CROSS-PARTITION).
use {
    jet_driver.[JetDriverCompileMode, JetDriverVerbOutput, JET_DRIVER_EXIT_OK, jet_driver_present_diagnostics]
    jet_foundation.[CompilerThreads, FnBody, body_node, build_options_stock]
    jet_ir.[IROptInlined]
}

// The choice kinds the report lists, in order; a kind with no row says none.
JET_CLI_CHOICE_KINDS: [String]{"storage form", "inlining", "collection", "copies", "placement"}

// One automatic choice: its kind, the function it was made in, and what was
// chosen with its reason.
JetCLIChoice: struct {
    kind: String
    file: String
    line: Int
    function: String
    choice: String
}

jet_cli_choice_order: fn(left: JetCLIChoice, right: JetCLIChoice) -> Ordering Never! {
    file: left.file <=> right.file
    if file != Ordering.Equal -> return file
    line: left.line <=> right.line
    if line != Ordering.Equal -> return line
    kind: jet_cli_choice_kind_rank(left.kind) <=> jet_cli_choice_kind_rank(right.kind)
    if kind != Ordering.Equal -> return kind
    function: left.function <=> right.function
    if function != Ordering.Equal -> return function
    left.choice <=> right.choice
}

// Where `kind` is in JET_CLI_CHOICE_KINDS, so rows on one line keep the
// report's kind order.
jet_cli_choice_kind_rank: fn(kind: String) -> Int Never! {
    loop at in 0..<JET_CLI_CHOICE_KINDS.len() {
        if JET_CLI_CHOICE_KINDS[at] == kind -> return at
    }
    return JET_CLI_CHOICE_KINDS.len()
}

// Whether `out` has a row identical to `choice`: each instance of a generic
// body repeats its choices.
jet_cli_choice_seen: fn(out: [JetCLIChoice], choice: JetCLIChoice) -> Bool Never! {
    loop row in out {
        if row.kind == choice.kind && row.file == choice.file && row.line == choice.line && row.function == choice.function && row.choice == choice.choice -> return true
    }
    false
}

// The storage form choices of `functions`: one per reactive upgrade, at the
// function's line.
jet_cli_storage_choices: fn(functions: [FnBody]) -> [JetCLIChoice] Never! {
    out := [JetCLIChoice]{}
    loop function in functions {
        if function.synthetic -> next
        loop upgrade in function.reactive_upgrades {
            choice: JetCLIChoice{kind: "storage form", file: function.source_file.copy(), line: function.line, function: function.name.copy(), choice: upgrade.copy()}
            if !jet_cli_choice_seen(out, choice) -> out.push(choice)
        }
    }
    out
}

// The inlining choices: one per inlined call site, at the call's line.
jet_cli_inline_choices: fn(rows: [IROptInlined], out: &[JetCLIChoice]) Never! {
    loop row in rows {
        choice: JetCLIChoice{kind: "inlining", file: row.file.copy(), line: row.line, function: row.caller.copy(), choice: "{row.callee} inlined: {row.reason}"}
        if !jet_cli_choice_seen(out, choice) -> out.push(choice)
    }
}

// The collection choices of `functions`, at the function's line: each
// binding sema moves into a scoped collector (FunctionMemory.jet), with the
// policy scope that allows it and why, and each binding that takes a
// collected value its call returns.
jet_cli_collection_choices: fn(functions: [FnBody], out: &[JetCLIChoice]) Never! {
    loop function in functions {
        if function.synthetic -> next
        loop statement in function.tree.stmts {
            if statement == .Let(local, _, _, promotion, transferred, _) {
                text := ""
                if promotion == .Val(promoted) -> text = "`{local.name}` collected under the {promoted.scope} `#Policy(gc)`: {promoted.reason}"
                if text == "" && transferred -> text = "`{local.name}` holds the collected value its call returns"
                if text == "" -> next
                choice: JetCLIChoice{kind: "collection", file: function.source_file.copy(), line: function.line, function: function.name.copy(), choice: text}
                if !jet_cli_choice_seen(out, choice) -> out.push(choice)
            }
        }
    }
}

// The copies choices of `functions`, at the function's line: each share
// and each materialized copy sema records in the program's own code, naming
// the local it copies.
jet_cli_copy_choices: fn(functions: [FnBody], out: &[JetCLIChoice]) Never! {
    loop function in functions {
        if function.synthetic || function.module_identity.starts_with("<corelib>/") -> next
        loop node in function.tree.nodes {
            if node.kind == .Clone(value, fact) {
                copied: body_node(function.tree, value)
                name := "a value"
                if copied.kind == .Local(local) -> name = "`{local.name}`"
                text: if fact == {
                    .Share -> "{name} shared: a later read uses it after this move, so the move copies it"
                    .Materialize -> "{name} copied: the destination owns its value, and this scope still holds it"
                    .Explicit | .Scalar | .ViewMaterialize -> ""
                }
                if text == "" -> next
                choice: JetCLIChoice{kind: "copies", file: function.source_file.copy(), line: function.line, function: function.name.copy(), choice: text}
                if !jet_cli_choice_seen(out, choice) -> out.push(choice)
            }
        }
    }
}

// The placement choices of the program's own `functions`, at the function's
// line: the web bucket each is in and why, when the program opts in to the
// web partition (sema stamps `web_reason` only then).
jet_cli_placement_choices: fn(functions: [FnBody], out: &[JetCLIChoice]) Never! {
    loop function in functions {
        if function.synthetic || function.web_reason == "" || function.module_identity.starts_with("<corelib>/") -> next
        bucket: function.web_bucket ?? next
        name: if bucket == {
            .JS -> "JS"
            .Wasm -> "Wasm"
        }
        choice: JetCLIChoice{kind: "placement", file: function.source_file.copy(), line: function.line, function: function.name.copy(), choice: "{name}: {function.web_reason}"}
        if !jet_cli_choice_seen(out, choice) -> out.push(choice)
    }
}

jet_cli_choices_report: fn(choices: [JetCLIChoice], scope: String, file: String, profile: String, json: Bool) -> String Never! {
    if !json {
        text := "choices: scope={scope} source={file} profile={profile}\n"
        loop kind in JET_CLI_CHOICE_KINDS {
            count := 0
            loop choice in choices {
                if choice.kind != kind -> next
                text = "{text}{kind}: {choice.file}:{choice.line} in {choice.function}: {choice.choice}\n"
                count += 1
            }
            if count == 0 -> text = "{text}{kind}: none\n"
        }
        return text
    }
    rows := [JetCLIStatusValue]{}
    loop choice in choices {
        rows.push(jet_cli_status_object([
            jet_cli_status_field("kind", jet_cli_status_text(choice.kind)),
            jet_cli_status_field("file", jet_cli_status_text(choice.file)),
            jet_cli_status_field("line", jet_cli_status_int(choice.line)),
            jet_cli_status_field("function", jet_cli_status_text(choice.function)),
            jet_cli_status_field("choice", jet_cli_status_text(choice.choice)),
        ]))
    }
    fields := [JetCLIStatusField]{
        jet_cli_status_field("scope", jet_cli_status_text(scope)), jet_cli_status_field("source", jet_cli_status_text(file)), jet_cli_status_field("profile", jet_cli_status_text(profile)),
        jet_cli_status_field("kinds", jet_cli_status_texts(JET_CLI_CHOICE_KINDS)),
        jet_cli_status_field("choices", jet_cli_status_array(rows)),
    }
    "{jet_cli_status_render("inspect.choices", true, fields)}\n"
}

// The checked Program compile of the authorized sources under the job's
// profile, the check failure every inspect plane reports, then the choices
// its checked functions record and, for a program with a `run: fn`, those
// its optimization makes. The rows go in file and line order.
jet_cli_inspect_choices_host: fn(job: JetCLIInspectJob, source: String) -> JetDriverVerbOutput {
    output := JetDriverVerbOutput{stdout: "", stderr: "", exit_code: JET_DRIVER_EXIT_OK}
    prepared: jet_cli_prepare_overlays(job.file, job.file, [JetCLIOverlay]{}, job.color, job.threads, JetDriverCompileMode.Program)
    if prepared == {
        .Refused(refusal) -> output = refusal.move()
        .Prepared(value, _) -> {
            request := value.move()
            request.profile = job.profile
            sources := request.authorized_sources
            compiler_threads: request.compiler_threads.copy()
            front := jet_cli_lowering_inputs(request, None)
            errors: jet_cli_errors(jet_driver_present_diagnostics(front.compile.diagnostics, sources, front.compile.generated_source_files))
            if errors.len() > 0 -> jet_cli_inspect_finish(job, jet_cli_inspect_check_failed(job, source, errors))
            if front.compile.internal_problem == .Val(problem) -> jet_cli_inspect_finish(job, jet_cli_ice(problem))
            inputs := front.inputs.move() ?? jet_cli_inspect_finish(job, jet_cli_ice("the checked compile of `{job.file}` has no lowering inputs"))
            choices := jet_cli_storage_choices(inputs.functions)
            jet_cli_collection_choices(inputs.functions, choices)
            jet_cli_copy_choices(inputs.functions, choices)
            jet_cli_placement_choices(inputs.functions, choices)
            if inputs.entry_key != None {
                threads: CompilerThreads{cap: compiler_threads.cap, cores: compiler_threads.cores, memory_available: jet_cli_memory_available()}
                build := build_options_stock("build")
                if job.build == .Val(given) -> build = given.copy()
                decisions: jet_cli_decisions(inputs, build, threads, job.profile, front.compile.harden)
                jet_cli_inline_choices(decisions.report.inlines, choices)
            }
            // A closure comparator: a compiler older than JetIR's named-comparator fix frees a named one's result twice.
            choices.sort_by((left: JetCLIChoice, right: JetCLIChoice) -> jet_cli_choice_order(left, right))
            report: jet_cli_choices_report(choices, job.scope, job.file, job.profile, job.json)
            jet_cli_inspect_finish(job, JetDriverVerbOutput{stdout: report, stderr: "", exit_code: JET_DRIVER_EXIT_OK})
        }
    }
    output
}
