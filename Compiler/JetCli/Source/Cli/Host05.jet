// Rust: Source/CmdCompile.rs:6844
fn finish_test_evidence(report_path: &OSPath, report_id: String, file: String, toolchain: String, target: String, profile: String, source_revision: String, build_revision: String, revision: String, harness_stdout: String?, child_ok: Bool, preserve_report: Bool, mode: OutputMode) -> Bool? Err! {
    report := read_or_create_test_evidence_report(report_path, report_id, file, toolchain, target, profile, source_revision, build_revision, revision) ?? {
        if preserve_report -> return Err(err)
        jet.ReceiptStore.optional_history_notice("reading test evidence", err)
        fresh_test_evidence_report(report_id, file, toolchain, target, profile, source_revision, build_revision, revision)
    }
    build :: Evidence.EvidenceBuild.new(toolchain, target, profile)
    evidence_revision :: Evidence.EvidenceRevision.new(source_revision, build_revision, revision)
    persist := true
    if harness_stdout == .Val(stdout) {
        if append_harness_test_evidence(&report, stdout, file, report_id, build, evidence_revision, child_ok) == .Err(error) {
            if preserve_report -> return Err(error)
            jet.ReceiptStore.optional_history_notice("assembling test evidence", error)
            persist = false
        }
    }
    if report.records.is_empty() && persist {
        if !preserve_report -> _ :: fs.remove_file(report_path)
        return Ok(.None)
    }
    test_projection :: jet.Codegen.test_report.JetTestOutcomeProjection.from_records(report.records.map(fn(record) {
        terminal :: if record.kind == { .Unit, .Property, .Doctest -> true; _ -> false }
        outcome :: if record.outcome == {
            .Passed -> .Passed
            .Failed -> .Failed
            .Error -> .Error
            .Skipped -> .Skipped
            _ -> .Other
        }
        jet.Codegen.test_report.JetTestOutcomeRecord{terminal: terminal, outcome: outcome, expected_failure: record.expectation == .ExpectedFailure}
    }))
    projection :: jet.Package.ClaimsProjection.from_records(report.records)
    floor :: jet.Loader.package_facts_for_entry(OSPath.new(file)).ok().flatten().and_then(fn(facts) { facts.policy.claims_min })
    floor_met :: projection.floor_met(floor)
    grade :: projection.grade.render()
    claims :: StatusValue.object(StatusFields.new().with("grade", grade.clone()).with("floor", floor.map(fn(value) { StatusValue.String(value.render()) }).unwrap_or(.Null)).with("floorMet", floor_met).with("generatedAttempts", projection.generated_attempts).with("generated", projection.generated_successes).with("examples", projection.examples_successes))
    summaries :: StatusValue.object(StatusFields.new().with("claims", StatusValue.object(StatusFields.new().with("grade", grade))))
    test :: StatusValue.object(StatusFields.new().with("failed", test_projection.failed).with("passed", test_projection.passed).with("skipped", test_projection.skipped).with("selected", test_projection.selected()).with("expectedFailures", test_projection.expected_failures).with("unexpectedPasses", test_projection.unexpected_passes))
    evidence :: StatusValue.parse(report.json()) ?? {
        if preserve_report -> return Err(err.to_string())
        jet.ReceiptStore.optional_history_notice("encoding test evidence", err.to_string())
        persist = false
        StatusValue.Null
    }
    status := StatusEnvelope.new("test", test_projection.failed == 0 && test_projection.unexpected_passes == 0).with_field("test", test).with_field("evidence", evidence).with_field("grade", projection.grade.render()).with_field("claims", claims).with_field("summaries", summaries)
    status.ok = status.ok && child_ok && floor_met
    if preserve_report {
        persist_evidence_report(report) ?? return Err(err)
    } else if persist {
        target_inputs_sha256 :: report.revision.source.clone()
        jet.ReceiptStore.enqueue_optional_history("writing test evidence", fn() {
            if persist_optional_evidence_report_for_inputs(report, target_inputs_sha256) == .Err(error) -> jet.ReceiptStore.optional_history_notice("writing test evidence", error)
        })
    }
    if mode.json -> write_mode_machine(mode, "{status.json()}\n")
    ok :: status.ok
    if !preserve_report -> _ :: fs.remove_file(report_path)
    Ok(.Val(ok))
}

