            if finish_test_evidence(report_path, report_id, shown, evidence_toolchain, evidence_target, evidence_profile, source_revision, build_revision, revision, .Val(cached.stdout), cached.ok, preserve_report, mode) == {
                .Ok(value) -> evidence_ok = value.unwrap_or(cached.ok)
                .Err(error) -> {
                    if !preserve_report -> _ :: fs.remove_file(report_path)
                    cli_error("E2105", "couldn't finalize test evidence for `{shown}`: {error}")
                    evidence_ok = false
