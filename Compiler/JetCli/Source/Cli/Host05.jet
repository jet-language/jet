        if !preserve_report -> _ :: fs.remove_file(report_path)
        return if override_entry { .Override(false) } else { .Ran(false) }
    }
    render_native_lints(shown, src, mode, lints)
    bin :: test_bin_path(project_root, path)
    cache_mode :: if override_entry { if coverage { "testcov-override" } else { "test-override" } } else if coverage { "testcov" } else { "test" }
    cache_key :: native_cache_key(shown, profile.budget_name(), profile_tag, cache_mode, .None)
    record_request :: opts.record.map(fn(name) { (name, profile.budget_name()) })
    coverage_profile :: if coverage { .Val(profile.budget_name()) } else { .None }
    build(shown, rust_code, .None, bin.clone(), profile, ffi_link, [], false, .None, .None, .None, mode, false, cache_key)
    cov_out :: if coverage { .Val(bin.with_extension("cov")) } else { .None }
    cmd := Command.new(bin)
    if path.parent().and_then(jet.Loader.find_manifest_root) == .Val(root) -> &cmd.env("JET_PROJECT_ROOT", root)
    if update_snapshots -> &cmd.env("JET_UPDATE_SNAPSHOTS", "1")
    if cov_out == .Val(co) {
        _ :: fs.remove_file(co)
        &cmd.env("JET_COV_OUT", co)
    }
    if opts.browser_engines == .Val(engines) -> &cmd.env("JET_TEST_BROWSERS", engines)
    if opts.browser_retries == .Val(retries) -> &cmd.env("JET_TEST_RETRIES", retries.to_string())
    if opts.browser_reporter == .Val(reporter) -> &cmd.env("JET_TEST_REPORTER", reporter)
    if opts.browser_ui -> &cmd.env("JET_TEST_BROWSER_UI", "1")
    if opts.browser_visual -> &cmd.env("JET_TEST_BROWSER_VISUAL", "1")
    if opts.browser_trace {
        &cmd.env("JET_TEST_TRACE", "1")
        &cmd.env("JET_TEST_TRACE_ON_RETRY", "1")
    }
    if opts.filter == .Val(filter) -> &cmd.env("JET_TEST_FILTER", filter)
    if opts.shuffle_seed == .Val(seed) -> &cmd.env("JET_TEST_SHUFFLE_SEED", seed.to_string())
    if opts.serial -> &cmd.env("JET_TEST_SERIAL", "1")
    if opts.trace_tiers -> &cmd.env("JET_TEST_TRACE_TIERS", "1")
    if opts.measure -> &cmd.env("JET_TEST_MEASURE", "1")
    &cmd.env("JET_TEST_CAPTURE", jet_cli_test_capture_name(opts.capture))
    if mode.json -> &cmd.env("JET_TEST_JSON", "1")
    &cmd.env(Evidence.EVIDENCE_REPORT_ENV, report_path)
    &cmd.env(Evidence.EVIDENCE_REPORT_ID_ENV, report_id)
    &cmd.env(Evidence.EVIDENCE_TOOLCHAIN_ENV, evidence_toolchain)
    &cmd.env(Evidence.EVIDENCE_TARGET_ENV, evidence_target)
    &cmd.env(Evidence.EVIDENCE_PROFILE_ENV, evidence_profile)
    &cmd.env(Evidence.EVIDENCE_SOURCE_REVISION_ENV, source_revision)
    &cmd.env(Evidence.EVIDENCE_BUILD_REVISION_ENV, build_revision)
    &cmd.env(Evidence.EVIDENCE_REVISION_ENV, revision)
    record :: record_request.map(fn((name, budget)) { ProveReplay.begin_named_capture(shown, name, budget, opts.setting_overrides, mode.json) ?? exit(err) })
    out :: &cmd.output() ?? {
        _ :: fs.remove_file(bin)
        if cov_out == .Val(co) -> _ :: fs.remove_file(co)
        if finish_test_evidence(report_path, report_id, shown, evidence_toolchain, evidence_target, evidence_profile, source_revision, build_revision, revision, .None, false, preserve_report, mode) == .Err(error) -> cli_error("E2105", "couldn't finalize test evidence for `{shown}`: {error}")
        if !preserve_report -> _ :: fs.remove_file(report_path)
        cli_error("E2105", "couldn't run tests in `{shown}`: {err}")
        exit(ExitCodes.USER_ERROR)
    }
    child_ok :: out.status.success()
    stdout :: String.from_utf8_lossy(out.stdout)
    stderr :: String.from_utf8_lossy(out.stderr)
    evidence_ok := child_ok
    if finish_test_evidence(report_path, report_id, shown, evidence_toolchain, evidence_target, evidence_profile, source_revision, build_revision, revision, .Val(stdout), child_ok, preserve_report, mode) == {
        .Ok(value) -> evidence_ok = value.unwrap_or(child_ok)
        .Err(error) -> {
            if !preserve_report -> _ :: fs.remove_file(report_path)
            cli_error("E2105", "couldn't finalize test evidence for `{shown}`: {error}")
            evidence_ok = false
        }
    }
    ok :: child_ok && doctests_ok && evidence_ok
    result :: JetCLITestResultCache{ok: ok, stdout: stdout, stderr: stderr}
    if !mode.json -> emit_test_capture(result, opts.capture, mode)
    if cacheable -> test_result_cache_write(path, opts, package, result)
    if cov_out == .Val(co) {
        report_coverage(shown, co, mode, coverage_profile.expect("coverage profile retained before build"), opts.setting_overrides)
        _ :: fs.remove_file(co)
    }
    _ :: fs.remove_file(bin)
    status :: if ok { ExitCodes.OK } else if child_ok { ExitCodes.USER_ERROR } else { child_exit_code(out.status) }
    finish_recorded_artifacts(record, opts.record, .None, status, mode)
    if override_entry { .Override(ok) } else { .Ran(ok) }
}

// Rust: Source/CmdCompile.rs:8266
fn spawn_test_watch_input() -> mpsc.Receiver<U8> {
    (sender, receiver) :: mpsc.channel()
    _ :: thread.spawn(fn() {
        stdin := io.stdin()
        byte := [U8]{0}
        loop &stdin.read(&byte).ok().is_some_and(fn(count) { count != 0 }) {
            if sender.send(byte[0]).is_err() -> break
        }
    })
    receiver
}
