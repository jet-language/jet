// Rust: Source/CmdCompile.rs:7081
fn emit_doctest_result(label: String, ok: Bool, stdout: String, stderr: String, policy: JetCLITestCapturePolicy, mode: OutputMode) {
    // The existing pure projector owns capture/quiet/json policy, the host writes.
    output :: jet_cli_test_doctest_output(label, JetCLITestResultCache{ok: ok, stdout: stdout, stderr: stderr}, policy, mode)
    if !output.stdout.is_empty() -> io.print(output.stdout)
    if !output.stderr.is_empty() -> io.eprint(output.stderr)
}

