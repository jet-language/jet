// Rust: Source/CmdCompile.rs:8481
fn run_test_watch_child(path: String, opts: &JetCLITestRunOptions, filter: String?, mode: OutputMode) -> (Int, JetCLITestResultCache) {
    executable :: env.current_exe().unwrap_or(OSPath.new(Syntax.BINARY_NAME))
    command := Command.new(executable)
    &command.arg("test")
    &command.arg(path)
    &command.stdin(Stdio.null())
    &command.stdout(Stdio.piped())
    &command.stderr(Stdio.piped())
    if mode.json -> &command.arg("--json")
    if OutputAdapter.advisory_lints_visible() -> &command.arg("--verbose")
    &command.args(jet_cli_test_watch_flags(opts, filter))
    &command.env("JET_TEST_CAPTURE", "all")
    if mode.json -> &command.env("JET_TEST_JSON", "1")
    output :: &command.output() ?? return (ExitCodes.USER_ERROR, JetCLITestResultCache{ok: false, stdout: "", stderr: "jet test watcher: couldn't run child: {err}\n"})
    status :: child_exit_code(output.status)
    (status, JetCLITestResultCache{ok: output.status.success(), stdout: String.from_utf8_lossy(output.stdout), stderr: String.from_utf8_lossy(output.stderr)})
}
// Rust: Source/CmdCompile.rs:8534
fn append_test_watch_failures(failures: &[String], seen: &[String:Bool], found: [String]) {
    loop name in found {
        if !seen.has_key(name) {
            seen[name] = true
            &failures.push(name)
        }
    }
}
// Rust: Source/CmdCompile.rs:8546
fn run_test_watch_selection(path: String, opts: &JetCLITestRunOptions, policy: JetCLITestCapturePolicy, failed: [String]?, mode: OutputMode) -> (Int, [String]) {
    status := ExitCodes.OK
    failures := [String]{}
    seen := [String:Bool]{}
    if failed == {
        .Val(names) -> {
            loop name in names {
                (child_status, result) :: run_test_watch_child(path, opts, .Val(name), mode)
                emit_test_capture(result, policy, mode)
                if child_status != ExitCodes.OK {
                    status = child_status
                    found :: jet_cli_test_watch_failure_names(result.stdout, result.stderr)
                    append_test_watch_failures(&failures, &seen, if found.is_empty() { [name] } else { found })
                }
            }
        }
        .None -> {
            (child_status, result) :: run_test_watch_child(path, opts, .None, mode)
            emit_test_capture(result, policy, mode)
            status = child_status
            append_test_watch_failures(&failures, &seen, jet_cli_test_watch_failure_names(result.stdout, result.stderr))
        }
    }
    (status, failures)
}
