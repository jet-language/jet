// Rust: Source/CmdCompile.rs:7397
fn run_generated_test(path: String, opts: JetCLITestRunOptions, mode: OutputMode) -> Never {
    source_path :: OSPath.new(path)
    if !source_path.is_file() {
        cli_error("E2105", "can't find `{path}`")
        exit(ExitCodes.USER_ERROR)
    }
    source :: fs.read_to_string(source_path) ?? {
        cli_error("E2105", "couldn't read `{path}`: {err}")
        exit(ExitCodes.USER_ERROR)
    }
    project_root :: jet.build_project_root(path) ?? {
        report_problems(mode, path, source, err)
        exit(ExitCodes.USER_ERROR)
    }
    (rust_code, ffi_link) :: jet.compile_fuzz_with_path(path, opts.generated_test_name) ?? {
        if err == {
            .Diagnostics(diags) -> {
                report_problems(mode, path, source, diags)
                exit(ExitCodes.USER_ERROR)
            }
            .Target(message) -> {
                cli_error_fix("E2104", message, "name one property test with `jet test --grade=generated <file> <name>`")
                exit(ExitCodes.USAGE)
            }
        }
    }
    profile :: if opts.profile == .Val(name) { resolve_named_profile(name, path, mode) } else if opts.release { BuildProfile.Release } else { BuildProfile.Default }
    bin :: fuzz_bin_path(project_root, source_path)
    build(path, rust_code, .None, bin.clone(), profile, ffi_link, [], false, .None, .None, .None, mode, false, .None)
    corpus :: opts.generated_corpus.unwrap_or_else(fn() {
        corpus_name :: opts.generated_test_name.map(fn(name) { name.chars().map(fn(ch) { if ch.is_ascii_alphanumeric() || ch == '-' || ch == '_' { ch } else { '_' } }).collect_string() }).filter(fn(name) { !name.is_empty() }).unwrap_or_else(fn() { stem(path) })
        ".jet/fuzz/{corpus_name}"
    })
    command := Command.new(bin)
    &command.env("JET_FUZZ_CORPUS", corpus)
    &command.env("JET_FUZZ_ITERATIONS", opts.generated_iterations.unwrap_or(1000).to_string())
    &command.env("JET_FUZZ_TIME_MS", opts.generated_time_budget_ms.unwrap_or(0).to_string())
    &command.env("JET_FUZZ_SEED", opts.generated_seed.unwrap_or(0x5EED_1234_ABCD_0001).to_string())
    status :: &command.status() ?? {
        _ :: fs.remove_file(bin)
        cli_error("E2105", "couldn't run generated tests in `{path}`: {err}")
        exit(ExitCodes.USER_ERROR)
    }
    _ :: fs.remove_file(bin)
    exit(if status.success() { ExitCodes.OK } else { child_exit_code(status) })
}

// Rust: Source/CmdCompile.rs:7513
pub fn run_test_opts(path: String, opts: JetCLITestRunOptions, mode: OutputMode) {
    p :: OSPath.new(path)
    require_project_environment("test", p, mode)
    if !p.exists() {
        cli_error("E2105", "can't find `{path}`")
        exit(ExitCodes.USER_ERROR)
    }
    if opts.grade_generated -> run_generated_test(path, opts, mode)
    if opts.where_expr == .Val(expression) {
        parse_test_where(expression) ?? {
            cli_error("E2104", "invalid --where expression: {err}")
            exit(ExitCodes.USER_ERROR)
        }
    }
    if opts.watch {
        run_test_watch(path, opts, mode)
        return
    }
    if opts.fresh && !mode.quiet -> write_mode_status(mode, "jet test: fresh result run (test-result cache bypassed; build cache reusable)\n")
    if p.is_dir() {
        root :: jet.Loader.find_manifest_root(p).unwrap_or(p.clone())
        if p.join(Syntax.PACKAGE_FILE).is_file() {
            run_test_package(root, opts, mode)
            return
        }
        if !opts.show_default && resolve_package_command_override(root, "test", mode) == .Val(override_file) {
            outcome :: run_test_target(override_file, opts, mode, false)
            ok :: outcome == .Ran(true) || outcome == .Override(true) || outcome == .NoTests
            exit(if ok { ExitCodes.OK } else { ExitCodes.USER_ERROR })
        }
        ext :: Syntax.FILE_EXT
        files := [OSPath]{}
        collect_source_files_recursive(p, ext, &files)
        &files.sort()
        if files.is_empty() {
            cli_error("E2104", "no .{ext} files in `{path}` (searched subdirectories too)")
            exit(ExitCodes.USER_ERROR)
        }
        any_fail := false
        loop f in files {
            if !run_test_file(f, opts, mode) -> any_fail = true
        }
        exit(if any_fail { ExitCodes.USER_ERROR } else { ExitCodes.OK })
    }
    exit(if run_test_file(p, opts, mode) { ExitCodes.OK } else { ExitCodes.USER_ERROR })
}

// Rust: Source/CmdCompile.rs:7604
pub fn run_test_package(root: &OSPath, opts: JetCLITestRunOptions, mode: OutputMode) {
    require_project_environment("test", root, mode)
    entry :: find_project_entry(root)
    ran := 0
    any_fail := false
    if !opts.show_default && resolve_package_command_override(root, "test", mode) == .Val(override_file) {
        outcome :: run_test_target(override_file, opts, mode, false)
        ok :: outcome == .Ran(true) || outcome == .Override(true) || outcome == .NoTests
        exit(if ok { ExitCodes.OK } else { ExitCodes.USER_ERROR })
    }
    if entry.is_file() {
        if run_test_target(entry, opts, mode, true) == {
            .Override(ok) -> exit(if ok { ExitCodes.OK } else { ExitCodes.USER_ERROR })
            .Ran(ok) -> { ran += 1; any_fail = !ok }
            .NoTests -> {}
        }
    }
    loop target in jet.ProjectParts.source_files(root) {
        if target == entry || is_reserved_target_file(target) -> next
        if run_test_target(target, opts, mode, true) == {
            .Ran(ok), .Override(ok) -> { ran += 1; any_fail = any_fail || !ok }
            .NoTests -> {}
        }
    }
    if ran == 0 -> run_test_opts(entry.to_string_lossy(), opts, mode)
    exit(if any_fail { ExitCodes.USER_ERROR } else { ExitCodes.OK })
}

// Rust: Source/CmdCompile.rs:7669
pub fn collect_source_files_recursive(dir: &OSPath, ext: String, out: &[OSPath]) {
    entries :: fs.read_dir(dir) ?? return
    loop entry_result in entries {
        entry :: entry_result ?? next
        path :: entry.path()
        if path.is_dir() {
            name :: path.file_name().and_then(fn(n) { n.to_str() }).unwrap_or("")
            if name == "build" || name.starts_with(".") -> next
            collect_source_files_recursive(path, ext, &out)
        } else if path.extension().and_then(fn(e) { e.to_str() }) == .Val(ext) && !is_reserved_target_file(path) {
            &out.push(path)
        }
    }
}
// Rust: Source/CmdCompile.rs:7692
fn is_reserved_target_file(path: &OSPath) -> Bool {
    path.file_name().and_then(fn(name) { name.to_str() }).is_some_and(fn(name) {
        name == Syntax.PACKAGE_FILE || name == Syntax.ENV_FILE || name == Syntax.WORKSPACE_FILE || name == Syntax.CONFIG_FILE || Syntax.COMMAND_ROLE_FILES.contains(name)
    })
}
// Rust: Source/CmdCompile.rs:7707
enum TestTargetOutcome { Ran(Bool) NoTests Override(Bool) }
// Rust: Source/CmdCompile.rs:7714
fn run_test_file(path: &OSPath, opts: &JetCLITestRunOptions, mode: OutputMode) -> Bool {
    outcome :: run_test_target(path, opts, mode, false)
    outcome == .Ran(true) || outcome == .Override(true) || outcome == .NoTests
}

// Rust: Source/CmdCompile.rs:7725
fn run_test_target(path: &OSPath, opts: &JetCLITestRunOptions, mode: OutputMode, package: Bool) -> TestTargetOutcome {
    update_snapshots :: opts.update_snapshots
    coverage :: opts.coverage
    shown :: path.to_string_lossy()
    profile :: if opts.profile == .Val(name) { resolve_named_profile(name, shown, mode) } else if opts.release || opts.measure { BuildProfile.Release } else { BuildProfile.Default }
    profile_tag :: "{profile.cache_tag()};{setting_overrides_tag(opts.setting_overrides)};aot-target=native"
    src :: fs.read_to_string(path) ?? {
        cli_error("E2105", "couldn't read `{shown}`: {err}")
        return .Ran(false)
    }
    project_root :: jet.build_project_root(shown) ?? {
        report_problems(mode, shown, src, err)
        return .Ran(false)
    }
    computed_source_revision :: jet.SHA256.sha256_hex(src.bytes())
    source_revision :: env.var(Evidence.EVIDENCE_SOURCE_REVISION_ENV).ok().filter(fn(value) { !value.is_empty() }).unwrap_or(computed_source_revision)
    report_id :: env.var(Evidence.EVIDENCE_REPORT_ID_ENV).ok().filter(fn(value) { !value.is_empty() }).unwrap_or_else(fn() {
        run :: SystemTime.now().duration_since(UNIX_EPOCH).expect("test execution starts after the Unix epoch").as_nanos()
        prefix :: source_revision.get(0..<16).unwrap_or(source_revision)
        "test:{prefix}:{id()}:{run}"
    })
    build_revision :: env.var(Evidence.EVIDENCE_BUILD_REVISION_ENV).ok().filter(fn(value) { !value.is_empty() }).unwrap_or_else(fn() { jet.SHA256.sha256_hex("jet-test-build-v1:{source_revision}:{profile_tag}".bytes()) })
    revision :: env.var(Evidence.EVIDENCE_REVISION_ENV).ok().filter(fn(value) { !value.is_empty() }).unwrap_or_else(fn() { jet.SHA256.sha256_hex("jet-test-mir-v1:{source_revision}:{profile_tag}".bytes()) })
    inherited_report_path :: env.var_os(Evidence.EVIDENCE_REPORT_ENV).filter(fn(value) { !value.is_empty() }).map(OSPath.from)
    preserve_report :: inherited_report_path.is_some()
    report_path :: inherited_report_path.unwrap_or_else(fn() { env.temp_dir().join("jet_test_{id()}_{source_revision.get(0..<16).unwrap_or(source_revision)}.bin") })
    evidence_toolchain :: env.var(Evidence.EVIDENCE_TOOLCHAIN_ENV).ok().filter(fn(value) { !value.is_empty() }).unwrap_or(jet.VERSION)
    evidence_target :: env.var(Evidence.EVIDENCE_TARGET_ENV).ok().filter(fn(value) { !value.is_empty() }).unwrap_or_else(host_target_triple)
    evidence_profile :: env.var(Evidence.EVIDENCE_PROFILE_ENV).ok().filter(fn(value) { !value.is_empty() }).unwrap_or_else(fn() { profile.budget_name() })
    _ :: fs.remove_file(report_path)
    if opts.where_expr == .Val(expression) {
        facts :: test_target_facts(path, src, opts, package)
        if !test_where_matches(expression, facts) -> return .NoTests
    }
    has_doctests :: !jet.Doctest.discover(src).is_empty()
    override_entry :: !opts.show_default && jet.has_entry_fn(shown, "test")
    doctests_ok :: with_test_evidence_environment(report_path, report_id, evidence_toolchain, evidence_target, evidence_profile, source_revision, build_revision, revision, fn() {
        run_doctests(path, shown, src, update_snapshots, profile, opts.setting_overrides, opts.capture, mode)
    })
    // Rust: Source/CmdCompile.rs:7856 nested finish_doctest_report.
    finish_doctest_report :: fn() -> Bool {
        result :: finish_test_evidence(report_path, report_id, shown, evidence_toolchain, evidence_target, evidence_profile, source_revision, build_revision, revision, .None, doctests_ok, preserve_report, mode) ?? {
            if !preserve_report -> _ :: fs.remove_file(report_path)
            cli_error("E2105", "couldn't finalize test evidence for `{shown}`: {err}")
            return false
        }
        result.unwrap_or(doctests_ok)
    }
    if opts.docs {
        if !has_doctests {
            _ :: fs.remove_file(report_path)
            return .NoTests
        }
        return .Ran(finish_doctest_report())
    }
    if !override_entry {
        if package {
            if !jet.has_test_blocks(shown) && !jet.has_test_contracts(shown) {
                if has_doctests -> return .Ran(finish_doctest_report())
                _ :: fs.remove_file(report_path)
                return .NoTests
            }
        } else if has_doctests && !jet.has_test_blocks(shown) && !jet.has_test_contracts(shown) {
            return .Ran(finish_doctest_report())
        }
    }
