// Checked graph queries share the Driver invocation; no CLI graph reconstruction.
use {
    jet_driver.[
        JetDriverAuthorizedSourceFile, JetDriverAuthorizedSourceRoot, JetDriverAuthorizedSourceSnapshot,
        JetDriverAuthorityPolicy, JetDriverCompileRequest, JetDriverCompileResult, JetDriverComptimeInputLog, JetDriverComptimeInputRecord, JetDriverBuildQueryScope, JetDriverBuildQueryResult,
        JetDriverFailure, JetDriverGeneratedModule, JetDriverVerbOutput, jet_driver_query_build_plan, jet_driver_entry_package_has_build,
        jet_driver_present_diagnostics, jet_driver_build_plan_json, jet_driver_build_explanation,
        jet_driver_report_problems, JET_DRIVER_EXIT_OK,
        JET_DRIVER_EXIT_USAGE, JET_DRIVER_EXIT_USER_ERROR, JetDriverCompileMode,
    ]
    jet_foundation.[
        BuildOptionChoice, BuildOptionLayer, BuildOptions, Diagnostic, DIAGNOSTIC_LINT, Span,
        build_option_argument, build_option_check_removal_note, build_option_row, build_options_check_removals, build_options_value, build_options_with_code,
        diagnostic_render_all, JET_COMPTIME_TOOLCHAIN_PREFIX,
    ]
    core.build.[BuildGraph, BuildGraphNode]
    build_files: core.files
    build_math: core.math
    jetpack_artifact_store.[BuildNodeRecord, BuildRecord, ObjectHandle]
    jet_build_session.[BuildPlanExecutable, BuildPlanExecution, BuildPlanSelection, BuildSessionGeneratedModule, BuildSessionOption, BuildSessionPlan, BuildSessionValue, build_plan_contributions, build_plan_execution, build_plan_generated, build_plan_selection]
    jet_pkg_model.[
        ContributionLayer, FactContribution, FactValue, LockError, LockedBuildContribution, PackageFacts, SourceScope,
        BuildStamp, ComptimeInput, pkg_lock_build_stamp, pkg_lock_e3512, pkg_lock_e3513, pkg_lock_load, pkg_lock_locked_build_contribution_set, pkg_lock_record_build_contributions, pkg_lock_record_effect_rows, pkg_lock_record_generated_inputs, pkg_lock_sorted_contributions, pkg_lock_widened_note, pkg_manifest_parse, pkg_sha256_hex,
    ]
}

jet_cli_build_report: fn(query: JetDriverBuildQueryResult, subject: String?, json: Bool) -> String Never! {
    plan: query.plan ?? {
        if json -> return "{jet_cli_status_render("inspect.build", true, [jet_cli_status_field("build", JetCLIStatusValue.Null)])}\n"
        return "default pipeline: no root fn build\n"
    }
    if subject == .Val(name) {
        explanation: jet_driver_build_explanation(plan, name)
        if json -> return "{jet_cli_status_render("inspect.build", true, [jet_cli_status_field("label", jet_cli_status_text(explanation.label)), jet_cli_status_field("provenance", jet_cli_status_texts(explanation.provenance))])}\n"
        text := "{explanation.label}\n"
        loop fact in explanation.provenance -> text += "  {fact}\n"
        return text
    }
    if json {
        payload: jet_driver_build_plan_json(plan)
        build: jet_cli_status_from_tree(jet_cli_status_tree_parse(payload) ?? panic("checked build projection lost its JSON")) ?? panic("checked build projection lost its status value")
        return "{jet_cli_status_render("inspect.build", true, [jet_cli_status_field("build", build)])}\n"
    }
    graph: query.graph ?? panic("checked plan lost its graph")
    text := ""
    loop target in graph.targets -> text += "target\t{target.name}\t{target.kind}\n"
    loop action in graph.actions -> text += "action\t{action.name}\t{action.outputs.join(",")}\n"
    text
}

// `jet inspect build --times`: the BuildTimes the last `jet build` of the
// project `file` belongs to recorded in `.jet/build/times.json`
// (jet_cli_build_record), one row per step and target in the order each
// finished; `--json` answers with the record itself.
jet_cli_inspect_build_times: fn(file: String, json: Bool, color: Bool) -[FS]> JetCLIPlan Never! {
    root: jet_cli_parent(build_files.realpath(file) ?? file) ?? "."
    path: jet_cli_entry_join(root, ".jet/build/times.json")
    rerun: "run `jet build`, then `jet inspect build --times`"
    text: build_files.read(path) ?? return jet_cli_inspect_b_report("E2104", "no `jet build` has recorded its times at `{path}`", jet_cli_why("E2104"), rerun, color, json, JET_DRIVER_EXIT_USER_ERROR)
    malformed: jet_cli_inspect_b_report("E2104", "`{path}` is not a build times record", jet_cli_why("E2104"), rerun, color, json, JET_DRIVER_EXIT_USER_ERROR)
    times: jet_cli_status_value_parse(text) ?? return malformed
    rows: jet_cli_status_list(jet_cli_status_get(times, "rows")) ?? return malformed
    if json -> return jet_cli_done("{jet_cli_status_render("inspect.build", true, [jet_cli_status_field("times", times)])}\n", "", JET_DRIVER_EXIT_OK)
    out := "kind\tname\twall_ms\tresult\n"
    loop row in rows {
        kind: jet_cli_status_string(jet_cli_status_get(row, "kind")) ?? return malformed
        name: jet_cli_status_string(jet_cli_status_get(row, "name")) ?? return malformed
        wall: jet_cli_status_integer(jet_cli_status_get(row, "wall_ms")) ?? return malformed
        reused: jet_cli_status_boolean(jet_cli_status_get(row, "reused")) ?? return malformed
        out = "{out}{kind}\t{name}\t{wall}\t{if reused -> "reused" else -> "made"}\n"
    }
    jet_cli_done(out, "", JET_DRIVER_EXIT_OK)
}

jet_cli_build_query_failure: fn(request: JetDriverCompileRequest, query: JetDriverBuildQueryResult, file: String, json: Bool, color: Bool, verbose: Bool) -> JetDriverVerbOutput Never! {
    if query.internal_problem == .Val(problem) -> return jet_cli_ice(problem)
    diagnostics: jet_driver_present_diagnostics(query.diagnostics, request.authorized_sources, query.generated_source_files)
    errors: jet_cli_errors(diagnostics)
    if errors.len() == 0 -> return jet_cli_ice("the checked build query stopped before completing `{file}`")
    source := ""
    loop root in request.authorized_sources.roots {
        loop input in root.files {
            if input.path == request.authorized_sources.entry_path -> source = input.source
        }
    }
    shown := [Diagnostic]{}
    loop diagnostic in diagnostics {
        if verbose || diagnostic.severity != DIAGNOSTIC_LINT -> shown.push(diagnostic)
    }
    if json -> return {stdout: jet_cli_reports_status_json("diagnostics", false, jet_cli_report_base(file), file, source, shown), stderr: "", exit_code: JET_DRIVER_EXIT_USER_ERROR}
    // The reports ride along so a `--json` run reached without this flag
    // (`jet build --json`) answers with them (jet_cli_json_outcome).
    {stdout: "", stderr: jet_driver_report_problems(file, source, shown, color, verbose), exit_code: JET_DRIVER_EXIT_USER_ERROR, failure: Val(JetDriverFailure{reports: shown, notice: ""})}
}
// `jet build` of a package whose `build: fn(b: Build)` configures the build: evaluate it,
// record the values it contributes to the package's declared settings
// (jet_cli_record_build_contributions), then run its steps and selected
// targets as one graph (jet_cli_build_run_graph), each executable compiled
// from its source, named after the target.
// The options fn build set go between `options`' profile values and its flags;
// `build_args` (the words after `--`) are what its `b.args()` returns. Under
// `write_generated: on` each generated source is first written to its
// `.jet/generated/` path under the package root. Each generated source's hash
// is a `[[comptime_inputs]]` row of the project lock, recorded once the
// targets compile; a `locked` build (`--locked`) instead refuses any source
// whose hash drifted from its row (E3512), before writing one.
// A workspace index first builds its members (jet_cli_build_workspace_members),
// then its own package from that package's entry (jet_cli_workspace_package_entry).
jet_cli_build_package: fn(file: String, color: Bool, options: BuildOptions, build_args: [String], threads: Int?, invocation: JetCLIInvocationAuthority?, locked: Bool, trace_sink: JetCLITraceSink?) -> JetDriverVerbOutput {
    members: jet_cli_build_workspace_members(file, color, options, threads, locked, trace_sink)
    if members.exit_code != JET_DRIVER_EXIT_OK -> return members
    jet_cli_build_package_as(jet_cli_workspace_package_entry(file, color), color, options, build_args, threads, invocation, None, locked, trace_sink)
}

// The file a workspace index's own package builds from: the index when it
// declares `build: fn(b: Build)` itself, else the package's stock run entry,
// else the package source that declares the build entry. The build query
// reads a package's build entry through its own sources, and the index is
// the workspace's, so from the index alone it finds none. `file` itself when
// it is no workspace index.
jet_cli_workspace_package_entry: fn(file: String, color: Bool) -[FS, Env]> String Never! {
    index: jet_cli_workspace_index_of(file, color) ?? return file.copy()
    if jet_cli_declares_build_entry(build_files.read(file) ?? "") -> return file.copy()
    loop relative in JET_CLI_STOCK_ENTRIES {
        path: jet_cli_checked_file(index.root, relative) ?? next
        return path
    }
    sources := [JetDriverAuthorizedSourceFile]{}
    if jet_cli_package_sources(index.root, sources) == None {
        loop source_file in sources {
            if source_file.path != file && jet_cli_declares_build_entry(source_file.source) -> return source_file.path.copy()
        }
    }
    file.copy()
}

// `jet_cli_build_package` of one package; `member` names the workspace member
// a workspace build runs it for (jet_cli_build_run_graph).
jet_cli_build_package_as: fn(file: String, color: Bool, options: BuildOptions, build_args: [String], threads: Int?, invocation: JetCLIInvocationAuthority?, member: String?, locked: Bool, trace_sink: JetCLITraceSink?) -> JetDriverVerbOutput {
    selection := BuildPlanSelection?{None}
    execution := BuildPlanExecution?{None}
    receipt := BuildGraph?{None}
    policy := JetDriverAuthorityPolicy?{None}
    generated := [BuildSessionGeneratedModule]{}
    // The modules every target compile loads beside the package's sources.
    target_generated := [JetDriverGeneratedModule]{}
    // The plan query is the trace's `build.plan` span: the check of the
    // build entry and its `build: fn` run.
    if trace_sink == .Val(sink) -> sink.begin("build.plan", "", -1, -1)
    // What `build: fn` read through `find`, `embed_file` and `embed_bytes`.
    build_reads := [JetDriverComptimeInputRecord]{}
    prepared: jet_cli_prepare_overlays(file, file, [JetCLIOverlay]{}, color, threads, JetDriverCompileMode.Doc)
    refused := JetDriverVerbOutput?{None}
    if prepared.move() == {
        .Refused(output) -> refused = Val(output)
        .Prepared(request, snapshot) -> {
            scope := JetDriverBuildQueryScope{next_session_id: 1}
            query_request := request.move()
            query_request.build_args = build_args.copy()
            // `--gate impure=allow` opens `build: fn`'s `#Impure` file calls
            // (BuildQueries.jet config.impure_gate), as it does a compile's.
            query_request.gate_set.allowed = options.gates.copy()
            log: Shared{JetDriverComptimeInputLog{records: [JetDriverComptimeInputRecord]{}}}
            // copy: the build query records into the one shared log; this build reads it back.
            query_request.comptime_input_log = Val(log.copy())
            response := jet_driver_query_build_plan(query_request, scope)
            build_reads = jet_cli_comptime_inputs_read(log)
            query := response.query.move()
            if !query.complete || query.internal_problem != None {
                refused = Val(jet_cli_build_query_failure(response.request, query, file, false, color, false))
            } else if query.tidy.len() > 0 {
                // A `.Tidy` finding a package lint raised (`meta.report`)
                // fails `jet build`; a run, a dev session or a test keeps
                // going.
                // copy: `query` is passed whole to report the findings.
                query.diagnostics = query.tidy.copy()
                refused = Val(jet_cli_build_query_failure(response.request, query, file, false, color, false))
            } else if query.plan == .Val(plan) {
                if jet_cli_settings_package(snapshot) == .Val(package) {
                    recorded: jet_cli_record_build_contributions(plan, package, color)
                    // copy: `refusal` is a payload view of `recorded`.
                    if recorded == .Val(refusal) -> refused = Val(refusal.copy())
                }
                selection = Val(build_plan_selection(plan))
                execution = Val(build_plan_execution(plan))
                receipt = query.graph.copy()
                policy = query.authority_policy
                generated = build_plan_generated(plan)
                // copy: `query` is returned whole to report a failure above.
                target_generated = query.generated.copy()
                // A `meta.rewrite_body` row's plan source is the new body
                // alone; it is written and locked as the whole function the
                // target compiles load.
                loop index in 0..<generated.len() {
                    if generated[index].rewrites == None -> next
                    loop module_row in target_generated {
                        if module_row.relative_path == generated[index].path -> generated[index].source = module_row.source.copy()
                    }
                }
            }
        }
    }
    if trace_sink == .Val(sink) -> sink.end("build.plan", if refused == None -> 1 else -> 0)
    if refused.move() == .Val(output) -> return output
    selected: selection ?? return jet_cli_ice("the completed build query has no plan")
    if selected.unsupported.len() > 0 {
        return jet_cli_build_failed("`jet build` doesn't run these build targets yet: {selected.unsupported.join(", ")}", jet_cli_why("E2105"), "select an executable target with `b.default(...)`, or build its source file directly", color)
    }
    merged := build_options_with_code(options, jet_cli_build_code_options(file, selected.options))
    resolved_options := BuildOptions?{None}
    if merged.move() == {
        .Refused(code, what, fix) -> return jet_cli_report_output("", code, what, jet_cli_why(code), fix, color, JET_DRIVER_EXIT_USAGE)
        .Resolved(resolved, notes) -> {
            loop note in notes -> jet_cli_write_notice("{note}\n")
            // The command line and profile removals were noted before the compile (jet_cli_build_options).
            loop choice in build_options_check_removals(resolved) {
                if choice.layer == BuildOptionLayer.Code -> jet_cli_write_notice("{build_option_check_removal_note(choice)}\n")
            }
            resolved_options = Val(resolved.move())
        }
    }
    selected_options := resolved_options ?? return jet_cli_ice("the build options lost their resolution")
    // Each target's compile refuses a dependency effect row the lock doesn't
    // cover under `--locked` (jet_cli_lock_effect_rows).
    selected_options.locked = locked
    // A web build is one entry's `app.*` files (BuildWeb.jet), so a package's
    // build targets are built native only.
    if build_options_value(selected_options, "os") == "web" {
        return jet_cli_build_failed("`jet build` writes a web build of one entry file, not of a package's `build: fn` targets", jet_cli_why("E2105"), "build the entry file with `jet build --target web <file>`", color)
    }
    root: jet_cli_parent(build_files.realpath(file) ?? file) ?? "."
    graph: execution ?? return jet_cli_ice("the completed build query has no plan")
    projected: receipt ?? return jet_cli_ice("the completed build query has no graph")
    // Every source a selected target declares exists before any action runs or
    // the lock is written, so a missing one leaves neither behind. A source a
    // build action declares as its output is the action's to produce: the
    // target's compile reads it after the graph runs.
    produced := [String]{}
    loop action in graph.actions {
        loop output in action.outputs -> produced.push(output.copy())
    }
    missing: jet_cli_build_missing_sources(root, selected, generated, produced)
    if missing.len() > 0 {
        return jet_cli_build_failed("{if missing.len() == 1 -> "a build target source doesn't" else -> "{missing.len()} build target sources don't"} exist: {missing.join(", ")}", jet_cli_why("E2105"), "create the file, or remove it from the target's sources in `build: fn`", color)
    }
    // `build: fn`'s own reads are locked beside what it generated, under the
    // same `--locked` check.
    generated_inputs := jet_cli_generated_lock_inputs(generated)
    loop input in jet_cli_comptime_lock_rows(root, build_reads) -> generated_inputs.push(input)
    if locked {
        if pkg_lock_record_generated_inputs(root, generated_inputs, true, BuildStamp.default()) == .Err(error) -> return jet_cli_lock_refusal(error, color)
    }
    // Under `--locked`, what each action output held before the graph runs,
    // so one that drifts from its lock row is put back.
    before: if locked -> jet_cli_action_outputs_snapshot(root, produced) else -> [JetCLIActionOutput]{}
    shadowed: jet_cli_generated_shadow(root, generated, color)
    // copy: `shadowed` is a payload view of the check's result.
    if shadowed == .Val(refusal) -> return refusal.copy()
    if build_options_value(selected_options, "write_generated") == "on" {
        loop source_file in generated {
            path: jet_cli_entry_join(root, source_file.path)
            directory: jet_cli_parent(path) ?? root
            build_files.create_dir_all(directory) ?? return jet_cli_build_failed("couldn't write the generated source `{path}`: {err}", jet_cli_why("E2105"), "make `{directory}` writable, or build with `--write-generated=off`", color)
            build_files.write(path, source_file.source) ?? return jet_cli_build_failed("couldn't write the generated source `{path}`: {err}", jet_cli_why("E2105"), "make `{directory}` writable, or build with `--write-generated=off`", color)
        }
    }
    built: jet_cli_build_run_graph(graph, projected, generated, selected, root, policy, invocation, member, selected_options, threads, target_generated, trace_sink, color)
    if built.exit_code != JET_DRIVER_EXIT_OK -> return built
    // Each action output is locked beside what `build: fn` generated and
    // read, as a generated input of the targets. A locked build whose outputs
    // drift from their rows is refused, with the outputs restored.
    outputs: jet_cli_action_output_lock_rows(root, produced)
    drifted: if locked -> jet_cli_locked_action_drift(root, outputs) else -> None
    if drifted == .Val(path) {
        jet_cli_action_outputs_restore(root, before)
        return jet_cli_lock_refusal(LockError.Reported(pkg_lock_e3512("locked generated input `{path}` drifted", "`--locked` requires generated input and output hashes to match the unified lock exactly", "rerun without `--locked` to review and record the new generated provenance")), color)
    }
    if !locked {
        loop row in outputs -> generated_inputs.push(row)
    }
    output := JetDriverVerbOutput{stdout: "", stderr: "", exit_code: JET_DRIVER_EXIT_OK}
    // A `build: fn` that selects no executable keeps the stock build of the
    // program beside it, named after its file.
    if selected.executables.len() == 0 {
        source: build_files.read(file) ?? ""
        if jet_cli_top_level_function_lines(source, "run").len() > 0 {
            output = jet_cli_compile_target(file, jet_cli_stem(file), source, [String]{}, target_generated, color, selected_options.copy(), threads, invocation, trace_sink)
            if output.exit_code != JET_DRIVER_EXIT_OK -> return output
        }
    }
    if !locked && generated_inputs.len() > 0 {
        stamp: pkg_lock_build_stamp(root, false) ?? return jet_cli_lock_refusal(err, color)
        if pkg_lock_record_generated_inputs(root, generated_inputs, false, stamp) == .Err(error) -> return jet_cli_lock_refusal(error, color)
    }
    output
}

// The sources the selected targets declare that are neither a file under
// `root`, a module `build: fn` generated, nor an output a build action
// produces (`produced`), each as "`path` of `target`".
jet_cli_build_missing_sources: fn(root: String, selected: BuildPlanSelection, generated: [BuildSessionGeneratedModule], produced: [String]) -[FS]> [String] Never! {
    missing := [String]{}
    loop target in selected.executables -> jet_cli_build_missing_target_sources(root, target, generated, produced, missing)
    loop target in selected.libraries -> jet_cli_build_missing_target_sources(root, target, generated, produced, missing)
    missing
}

jet_cli_build_missing_target_sources: fn(root: String, target: BuildPlanExecutable, generated: [BuildSessionGeneratedModule], produced: [String], missing: &[String]) Never! -[FS]> {
    loop source in target.sources {
        if produced.contains(source) || build_files.exists(jet_cli_entry_join(root, source)) -> next
        made: loop made_module in generated {
            if made_module.path == source -> break true
        } ?? false
        if !made -> missing.push("`{source}` of `{target.name}`")
    }
}

// The `[[comptime_inputs]]` rows of `generated`: each source's package-relative
// path and the SHA-256 of its bytes.
jet_cli_generated_lock_inputs: fn(generated: [BuildSessionGeneratedModule]) -> [ComptimeInput] Never! {
    inputs := [ComptimeInput]{}
    loop source_file in generated -> inputs.push(ComptimeInput{path: source_file.path.copy(), hash: "sha256:{pkg_sha256_hex(source_file.source.bytes())}"})
    inputs
}

// One build action output before the graph ran: its package-relative path,
// and its bytes when it was a file (`present`).
JetCLIActionOutput: struct {
    path: String
    present: Bool
    bytes: [U8]
}

// The action outputs `produced` names outside the managed `.jet/` tree (the
// generated modules lock there by their own rows), each once.
jet_cli_action_output_paths: fn(produced: [String]) -> [String] Never! {
    paths := [String]{}
    loop path in produced {
        if path.starts_with(".jet/") || paths.contains(path) -> next
        paths.push(path.copy())
    }
    paths
}

// What each action output `produced` names holds under `root` now.
jet_cli_action_outputs_snapshot: fn(root: String, produced: [String]) -[FS]> [JetCLIActionOutput] Never! {
    outputs := [JetCLIActionOutput]{}
    loop path in jet_cli_action_output_paths(produced) {
        full: jet_cli_entry_join(root, path)
        present: build_files.is_file(full)
        bytes: if present -> build_files.read_bytes(full) ?? [U8]{} else -> [U8]{}
        outputs.push(JetCLIActionOutput{path: path.copy(), present: present, bytes: bytes})
    }
    outputs
}

// Put each snapshotted action output back: its old bytes, or no file. One
// that can't be put back is named in a notice beside the refusal.
jet_cli_action_outputs_restore: fn(root: String, outputs: [JetCLIActionOutput]) -[FS, IO]> {
    loop output in outputs {
        full: jet_cli_entry_join(root, output.path)
        if {
            output.present -> build_files.write_bytes(full, output.bytes) ?? jet_cli_write_notice("couldn't restore the build action output `{full}`: {err}\n")
            build_files.exists(full) -> build_files.remove(full) ?? jet_cli_write_notice("couldn't remove the build action output `{full}`: {err}\n")
        }
    }
}

// The `[[comptime_inputs]]` rows of the action outputs `produced` names: each
// file's package-relative path and the SHA-256 of its bytes. An output the
// graph didn't write has no row.
jet_cli_action_output_lock_rows: fn(root: String, produced: [String]) -[FS]> [ComptimeInput] Never! {
    rows := [ComptimeInput]{}
    loop path in jet_cli_action_output_paths(produced) {
        bytes: build_files.read_bytes(jet_cli_entry_join(root, path)) ?? next
        rows.push(ComptimeInput{path: path.copy(), hash: "sha256:{pkg_sha256_hex(bytes)}"})
    }
    rows
}

// The first of `outputs` the unified lock under `root` doesn't hold with the
// same hash.
jet_cli_locked_action_drift: fn(root: String, outputs: [ComptimeInput]) -[FS]> String? Never! {
    recorded: if pkg_lock_load(root) == .Val(lock) -> lock.comptime_inputs.copy() else -> [ComptimeInput]{}
    loop output in outputs {
        if !recorded.contains(output) -> return Val(output.path.copy())
    }
    None
}

// E3510 for the first generated module whose managed `.jet/generated/` path
// already holds something Jet didn't write there: a symlink on the way, a
// non-file, or a file whose bytes are neither this build's source nor the
// `[[comptime_inputs]]` hash the lock recorded for that path. Generation is
// additive, so a hand-written file is never overwritten or shadowed.
jet_cli_generated_shadow: fn(root: String, generated: [BuildSessionGeneratedModule], color: Bool) -[FS]> JetDriverVerbOutput? Never! {
    recorded: if pkg_lock_load(root) == .Val(lock) -> lock.comptime_inputs.copy() else -> [ComptimeInput]{}
    loop source_file in generated {
        path: jet_cli_entry_join(root, source_file.path)
        prefix := root.copy()
        linked: loop part in source_file.path.split("/") {
            prefix = jet_cli_entry_join(prefix, part)
            if build_files.is_symlink(prefix) -> break true
        } ?? false
        if !linked && !build_files.exists(path) -> next
        if !linked && build_files.is_file(path) {
            on_disk: build_files.read(path) ?? ""
            if on_disk == source_file.source -> next
            digest: "sha256:{pkg_sha256_hex(on_disk.bytes())}"
            managed: loop input in recorded {
                if input.path == source_file.path && input.hash == digest -> break true
            } ?? false
            if managed -> next
        }
        return Val(jet_cli_report_output("", "E3510", "`b.generate(\"{source_file.name}\")` would shadow the module at `{source_file.path}`", "generation is additive: what you wrote is always what compiles", "rename the generated module, or delete the hand-written one", color, JET_DRIVER_EXIT_USER_ERROR))
    }
    None
}

// `jet build` of a workspace index builds its members before its own plan,
// in dependency order (jet_cli_workspace_build_order). A member with a build
// entry runs it granted only its own package authority and the workspace's
// grant to it: the command line's grant is the root build's. A member
// without one builds its run entry stock. A clean output when every member
// built, or when `file` is not its directory's workspace index.
jet_cli_build_workspace_members: fn(file: String, color: Bool, options: BuildOptions, threads: Int?, locked: Bool, trace_sink: JetCLITraceSink?) -> JetDriverVerbOutput {
    built := JetDriverVerbOutput{stdout: "", stderr: "", exit_code: JET_DRIVER_EXIT_OK}
    index: jet_cli_workspace_index_of(file, color) ?? return built
    members := [JetCLIWorkspaceMember]{}
    if jet_cli_workspace_members(index.root, index.path, "build", color) == {
        .Refused(plan) -> return jet_cli_execute(plan)
        .Members(found) -> members = found
    }
    root: index.root
    loop member in jet_cli_workspace_build_order(root, members) {
        notices := [String]{}
        entry := JetCLIEntry?{None}
        if jet_cli_find_command_entry(jet_cli_entry_join(root, member.path), "build", true, color, notices) == {
            .Entry(found) -> entry = Val(found)
            .Refused(plan) -> return jet_cli_execute(plan)
            .Absent -> {}
        }
        loop notice in notices -> jet_cli_write_notice(notice)
        found: entry ?? next
        if jet_cli_package_declares_build_entry(found.path) {
            built = jet_cli_build_package_as(found.path, color, options.copy(), [String]{}, threads, None, Val(member.name), locked, trace_sink)
        } else {
            source: build_files.read(found.path) ?? next
            if jet_cli_top_level_function_lines(source, "run").len() == 0 -> next
            built = jet_cli_compile_target(found.path, jet_cli_stem(found.path), source, [String]{}, [JetDriverGeneratedModule]{}, color, options.copy(), threads, None, trace_sink)
        }
        if built.exit_code != JET_DRIVER_EXIT_OK -> return built
    }
    built
}

// The workspace whose index `file` is: its root directory and index path.
JetCLIWorkspaceIndex: struct {
    root: String
    path: String
}

// The workspace `file` indexes, or None when `file` is not its directory's
// workspace index (a `workspace.jet`, or a `package.jet` listing members).
jet_cli_workspace_index_of: fn(file: String, color: Bool) -[FS]> JetCLIWorkspaceIndex? Never! {
    canonical: build_files.realpath(file) ?? return None
    root: jet_cli_parent(canonical) ?? return None
    if jet_cli_workspace_source(root, color) == {
        .Index(path) -> {
            if (build_files.realpath(path) ?? path) != canonical -> return None
            return Val(JetCLIWorkspaceIndex{root: root, path: path})
        }
        .Absent | .Authority(_) | .Failed(_) -> return None
    }
}

// `members` with each after the members its manifest names as path `deps:`,
// index order among those ready; members in a dependency cycle keep index order.
jet_cli_workspace_build_order: fn(root: String, members: [JetCLIWorkspaceMember]) -[FS, Env]> [JetCLIWorkspaceMember] Never! {
    directories := [String]{}
    loop member in members {
        member_root: jet_cli_entry_join(root, member.path)
        directories.push(build_files.realpath(member_root) ?? member_root)
    }
    needs := (loop directory in directories -> jet_cli_workspace_member_needs(directory, directories))
    placed := (loop _ in directories -> false)
    order := [JetCLIWorkspaceMember]{}
    progressed := true
    loop progressed {
        progressed = false
        loop (index, member) in members {
            if placed[index] -> next
            ready: loop need in needs[index] {
                if !placed[need] -> break false
            } ?? true
            if ready {
                placed[index] = true
                order.push(member.copy())
                progressed = true
            }
        }
    }
    loop (index, member) in members {
        if !placed[index] -> order.push(member.copy())
    }
    order
}

// The indexes in `directories` of the members `directory`'s manifest names as path dependencies.
jet_cli_workspace_member_needs: fn(directory: String, directories: [String]) -[FS, Env]> [Int] Never! {
    needs := [Int]{}
    manifest_path: jet_cli_checked_file(directory, JET_CLI_PACKAGE_FILE) ?? return needs
    manifest: pkg_manifest_parse(manifest_path, build_files.read(manifest_path) ?? "") ?? return needs
    loop name in manifest.dependencies.keys() {
        if manifest.dependencies[name] == .Path(path) {
            target: build_files.realpath(jet_cli_entry_join(directory, path)) ?? next
            loop (index, candidate) in directories {
                if candidate == target && candidate != directory -> needs.push(index)
            }
        }
    }
    needs
}

// A library target builds as its importers compile it: its source, with the
// other sources it lists (`sources`) and the generated modules, checks clean
// and nothing is written, so a clean check prints nothing. Its snapshot holds
// the target's whole folder, which every listed source is in
// (jet_cli_prepare_snapshot).
jet_cli_check_library: fn(file: String, source: String, sources: [String], generated: [JetDriverGeneratedModule], color: Bool, threads: Int?, trace_sink: JetCLITraceSink?) -> JetDriverVerbOutput {
    if trace_sink == .Val(sink) -> sink.begin("sources", "", -1, -1)
    prepared: jet_cli_prepare_overlays(file, file, [JetCLIOverlay]{}, color, threads, JetDriverCompileMode.Check, false, true)
    if trace_sink == .Val(sink) -> sink.end("sources", jet_cli_prepared_file_count(prepared))
    if prepared.move() == {
        .Refused(refusal) -> refusal
        .Prepared(request, snapshot) -> {
            with_sources := request
            with_sources.generated_modules = generated
            with_sources.target_sources = sources
            compiled: jet_cli_compile_prepared(JetCLIPrepared.Prepared{request: with_sources.move(), snapshot: snapshot}, None, trace_sink)
            if compiled == {
                .Refused(refusal) -> refusal.move()
                .Compiled(result, checked_snapshot) -> {
                    errors: jet_driver_present_diagnostics(jet_cli_errors(result.diagnostics), checked_snapshot, result.generated_source_files)
                    if errors.len() > 0 -> return JetDriverVerbOutput{stdout: "", stderr: diagnostic_render_all(file, source, errors, color), exit_code: JET_DRIVER_EXIT_USER_ERROR}
                    if result.internal_problem == .Val(problem) -> return jet_cli_ice(problem)
                    JetDriverVerbOutput{stdout: "", stderr: "", exit_code: JET_DRIVER_EXIT_OK}
                }
            }
        }
    }
}

// The entry root's package when its manifest declares `settings:`. The values
// its `build: fn` contributes to them (`b.contribute`) are the package's
// `[[build.contribution]]` rows of the project lock under `root`, which every
// compile of the package folds (jet_cli_driver_request).
JetCLISettingsPackage: struct {
    root: String
    name: String
}

// The settings package of `snapshot`'s entry root, read from the snapshot's
// bytes of its manifest; None when the root declares no setting.
jet_cli_settings_package: fn(snapshot: JetDriverAuthorizedSourceSnapshot) -> JetCLISettingsPackage? Never! {
    loop root in snapshot.roots {
        if root.identity != snapshot.entry_root_identity -> next
        facts: jet_cli_root_package_facts(root) ?? return None
        if facts.settings.len() == 0 -> return None
        return Val(JetCLISettingsPackage{root: root.canonical_path.copy(), name: facts.name.copy()})
    }
    None
}

// The package facts `root` declares: its `package.jet`, else a stock entry's
// leading inline `package: { … }` block. None for an unparsable manifest: the
// compile reports it.
jet_cli_root_package_facts: fn(root: JetDriverAuthorizedSourceRoot) -> PackageFacts? Never! {
    loop file in root.files {
        if file.relative_path != "package.jet" -> next
        facts: PackageFacts.parse_uncomposed(file.source, file.path) ?? return None
        return Val(facts)
    }
    loop relative in JET_CLI_STOCK_ENTRIES {
        loop file in root.files {
            if file.relative_path != relative -> next
            inline: if PackageFacts.parse_inline(file.source, file.path) == {
                .Ok(value) -> value
                .Err(_) -> { return None }
            }
            // copy: `carrier` is a payload view of `inline`.
            if inline == .Val(carrier) -> return Val(carrier.facts.copy())
        }
    }
    None
}

// The request a compile of `owned_request` folds settings from. When its entry
// package declares settings and a `build: fn`, that build is evaluated first and
// the values it contributes are recorded (jet_cli_record_build_contributions),
// so the compile reads the rows of this evaluation. `refusal` is set when the
// build or the lock write failed.
JetCLIContributedRequest: struct {
    request: JetDriverCompileRequest
    refusal: JetDriverVerbOutput?
}

jet_cli_contributed_request: fn(owned_request: &&JetDriverCompileRequest, color: Bool) -> JetCLIContributedRequest {
    request := owned_request.move()
    package: jet_cli_settings_package(request.authorized_sources) ?? return {request: request.move(), refusal: None}
    if !jet_driver_entry_package_has_build(request) -> return {request: request.move(), refusal: None}
    scope := JetDriverBuildQueryScope{next_session_id: 1}
    response := jet_driver_query_build_plan(request, scope)
    query := response.query.move()
    if !query.complete || query.internal_problem != None {
        failure: jet_cli_build_query_failure(response.request, query, response.request.authorized_sources.entry_path, false, color, false)
        return {request: response.request.move(), refusal: Val(failure)}
    }
    contributed := response.request.move()
    plan: query.plan ?? return {request: contributed.move(), refusal: None}
    recorded: jet_cli_record_build_contributions(plan, package, color)
    if recorded == .Val(refusal) {
        // copy: `refusal` is a payload view of `recorded`.
        return JetCLIContributedRequest{request: contributed.move(), refusal: Val(refusal.copy())}
    }
    if pkg_lock_load(package.root) == .Val(lock) {
        // copy: `lock` is a payload view of the loaded lock.
        contributed.build_stamp = lock.build_stamp.copy()
        contributed.build_contributions = lock.build_contributions.copy()
    }
    {request: contributed.move(), refusal: None}
}

// Record what `plan`'s `build: fn` contributed as `package`'s
// `[[build.contribution]]` rows of the project lock: each one a function-scope
// writer at the environment layer, computed by `build: fn`. The lock is
// rewritten only when the rows changed; a new lock captures its build stamp.
// None when the rows are recorded, else the refusal.
jet_cli_record_build_contributions: fn(plan: BuildSessionPlan, package: JetCLISettingsPackage, color: Bool) -> JetDriverVerbOutput? {
    facts := [FactContribution]{}
    loop contribution in build_plan_contributions(plan) {
        value: jet_cli_build_fact_value(contribution.value) ?? return Val(jet_cli_ice("`build: fn` contributed `{contribution.key}` a value no setting holds"))
        facts.push(FactContribution{
            key: contribution.key.copy(),
            value: value,
            scope: SourceScope.Function,
            layer: ContributionLayer.Environment,
            span: Span{start: contribution.start, end: contribution.end},
            source: contribution.source.copy(),
            reason: Val("computed by fn build"),
        })
    }
    if pkg_lock_load(package.root) == .Val(lock) && lock.build_stamp != None {
        recorded := [LockedBuildContribution]{}
        loop row in lock.build_contributions {
            if row.package == package.name -> recorded.push(row.copy())
        }
        if pkg_lock_sorted_contributions(recorded) == pkg_lock_locked_build_contribution_set(package.name, facts) -> return None
    }
    stamp: pkg_lock_build_stamp(package.root, false) ?? return Val(jet_cli_lock_refusal(err, color))
    if pkg_lock_record_build_contributions(package.root, package.name, facts, false, stamp) == .Err(error) -> return Val(jet_cli_lock_refusal(error, color))
    None
}

// The fact value of a `b.contribute` value: the build session admits only
// these kinds, so any other is None.
jet_cli_build_fact_value: fn(value: BuildSessionValue) -> FactValue? Never! {
    if value == {
        .Bool(flag) -> Val(FactValue.Bool{value: flag})
        .Int(number) -> Val(FactValue.Int{value: number})
        .Char(character) -> Val(FactValue.Char{value: character})
        .Text(text) -> Val(FactValue.Text{value: text.copy()})
        .Enum(variant) -> Val(FactValue.Enum{variant: variant.copy()})
        .Unit | .List(_) | .Handle(_, _, _) | .Span(_, _, _) -> None
    }
}

// A lock check or update the project refused: its registered diagnostic,
// carried for `--json` (E3512 for a locked build's drift).
jet_cli_lock_refusal: fn(error: LockError, color: Bool) -> JetDriverVerbOutput Never! {
    // copy: `diagnostic` is a payload view of `error`.
    if error == .Reported(diagnostic) -> return jet_cli_lock_reports([Diagnostic]{diagnostic.copy()}, color)
    jet_cli_ice("the project lock refused the build: {error.message()}")
}

// The registered diagnostics a locked build stopped on, every one in one
// report, carried for `--json`.
jet_cli_lock_reports: fn(reports: [Diagnostic], color: Bool) -> JetDriverVerbOutput Never! {
    JetDriverVerbOutput{stdout: "", stderr: diagnostic_render_all("", "", reports, color), exit_code: JET_DRIVER_EXIT_USER_ERROR, failure: Val(JetDriverFailure{reports: reports.copy(), notice: ""})}
}

// After a build's or a run's checks pass: record each dependency's inferred
// effect row (the compile's `package_effects`) in the lock of `file`'s
// project (pkg_lock_record_effect_rows). The output's stderr names each
// effect a dependency's row widened by, with the call path to it; a `locked`
// build (`jet build --locked`) writes nothing and refuses every widened
// effect instead (E3513), each at the dependency function that performs it,
// presented against `snapshot`'s sources. Without dependency rows or a
// project lock there is nothing to record. `json` leaves the notes out, as it
// does the effect summary.
jet_cli_lock_effect_rows: fn(file: String, result: JetDriverCompileResult, snapshot: JetDriverAuthorizedSourceSnapshot, locked: Bool, color: Bool, json: Bool) -[FS, Env, Time]> JetDriverVerbOutput Never! {
    recorded := JetDriverVerbOutput{stdout: "", stderr: "", exit_code: JET_DRIVER_EXIT_OK}
    if result.package_effects.len() == 0 -> return recorded
    root: jet_cli_manifest_root(jet_cli_parent(file) ?? ".") ?? return recorded
    gains: pkg_lock_record_effect_rows(root, result.package_effects, locked) ?? return jet_cli_lock_refusal(err, color)
    if locked && gains.len() > 0 {
        reports := [Diagnostic]{}
        loop gain in gains {
            loop reach in gain.reaches -> reports.push(pkg_lock_e3513(gain.name, reach))
        }
        return jet_cli_lock_reports(jet_driver_present_diagnostics(reports, snapshot, result.generated_source_files), color)
    }
    if json -> return recorded
    loop gain in gains {
        loop reach in gain.reaches -> recorded.stderr = "{recorded.stderr}{pkg_lock_widened_note(gain.name, reach)}"
    }
    recorded
}

// After a build's checks pass: record each file the compile read through
// `embed_file`, `embed_bytes` or `find`, and each glob a `find` walked (the
// compile's `comptime_inputs`), as a `[[comptime_inputs]]` row of the lock
// of `file`'s project (jet_cli_comptime_lock_rows), upserted by path so an
// edited file's row takes its new digest (pkg_lock_record_generated_inputs).
// A loose file, a compile that read none and a `locked` build record nothing.
jet_cli_lock_comptime_inputs: fn(file: String, result: JetDriverCompileResult, locked: Bool, color: Bool) -[FS, Env, Exec, Time]> JetDriverVerbOutput Never! {
    recorded := JetDriverVerbOutput{stdout: "", stderr: "", exit_code: JET_DRIVER_EXIT_OK}
    if locked || result.comptime_inputs.len() == 0 -> return recorded
    root: jet_cli_manifest_root(jet_cli_parent(file) ?? ".") ?? return recorded
    physical: build_files.realpath(root) ?? root.copy()
    inputs: jet_cli_comptime_lock_rows(physical, result.comptime_inputs)
    if inputs.len() == 0 -> return recorded
    stamp: pkg_lock_build_stamp(root, false) ?? return jet_cli_lock_refusal(err, color)
    if pkg_lock_record_generated_inputs(root, inputs, false, stamp) == .Err(error) -> return jet_cli_lock_refusal(error, color)
    recorded
}

// The lock rows of the comptime inputs `read` beneath the physical project
// root `physical`: a file's path relative to it (a toolchain read keeps its
// `toolchain:` name) with the SHA-256 of its bytes, and a glob's with the
// digest of its sorted membership. A read outside the project has no row.
jet_cli_comptime_lock_rows: fn(physical: String, read: [JetDriverComptimeInputRecord]) -[FS]> [ComptimeInput] Never! {
    inputs := [ComptimeInput]{}
    loop input in read {
        if input.path.starts_with(JET_COMPTIME_TOOLCHAIN_PREFIX) {
            inputs.push(ComptimeInput{path: input.path.copy(), hash: "sha256:{input.sha256}"})
            next
        }
        file: build_files.realpath(input.file) ?? input.file.copy()
        if !file.starts_with("{physical}/") -> next
        inputs.push(ComptimeInput{path: file.slice(physical.len() + 1..<file.len()), hash: "sha256:{input.sha256}"})
    }
    inputs
}

// fn build's layer of the build options: each option `selected` set, placed
// at its call in `file` (`at build.jet:3`, relative to the package root).
jet_cli_build_code_options: fn(file: String, set: [BuildSessionOption]) -> [BuildOptionChoice] {
    choices := [BuildOptionChoice]{}
    if set.len() == 0 -> return choices
    source: build_files.read(file) ?? ""
    directory: jet_cli_parent(file) ?? "."
    root: jet_cli_manifest_root(directory) ?? directory
    relative := file.copy()
    if file.starts_with("{root}/") -> relative = file.slice(root.len() + 1..<file.len())
    bytes: source.bytes()
    loop option in set {
        end := option.start
        if end > bytes.len() -> end = bytes.len()
        line := 1
        loop index in 0..<end {
            if bytes[index] == (U8{10}) -> line += 1
        }
        row: build_option_row(option.name) ?? panic("the build session set `{option.name}`, which is no build-option row")
        value: build_option_argument(row, option.value)
        written: if option.pinned -> "b.pin(.{option.name}, {value})" else -> "b.{option.name}({value})"
        choices.push(BuildOptionChoice{name: option.name.copy(), value: option.value.copy(), layer: BuildOptionLayer.Code, written: written, site: "at {relative}:{line}", pinned: option.pinned})
    }
    choices
}

jet_cli_build_host: fn(owned_request: &&JetDriverCompileRequest, scope: &JetDriverBuildQueryScope, file: String, subject: String?, json: Bool, color: Bool, verbose: Bool) -> JetDriverVerbOutput {
    response := jet_driver_query_build_plan(owned_request, scope)
    request := response.request.move()
    query := response.query.move()
    if !query.complete || query.internal_problem != None -> return jet_cli_build_query_failure(request, query, file, json, color, verbose)
    JetDriverVerbOutput{stdout: jet_cli_build_report(query, subject, json), stderr: "", exit_code: JET_DRIVER_EXIT_OK}
}

// Exact IEEE-754 fixed-three formatting, including half-to-even and -0.
// Multiplying the binary significand by 125 is exact in Int; 1000 = 125*8.
// A floating multiply/round would double-round and diverge from Rust's {:.3}.
jet_cli_build_duration: fn(value: Float) -> String Never! {
    bits: build_math.to_bits(value)
    raw_exponent: (bits >> 52).bit_and(2047)
    if raw_exponent == 2047 -> panic("build record duration must be finite")
    significand := bits.bit_and(4503599627370495)
    exponent := -1071
    if raw_exponent != 0 {
        significand += 4503599627370496
        exponent = raw_exponent - 1072
    }
    scaled := significand * 125
    if exponent < 0 {
        shift: -exponent
        if shift > 60 -> scaled = 0
        else {
            divisor: 1 << shift
            quotient: scaled /% divisor
            remainder: scaled % divisor
            half: divisor /% 2
            scaled = quotient
            if remainder > half || (remainder == half && quotient % 2 != 0) -> scaled += 1
        }
        exponent = 0
    }
    digits := [Int]{}
    loop {
        digits.push(scaled % 10)
        scaled /%= 10
        if scaled == 0 -> break
    }
    loop exponent > 0 {
        carry := 0
        loop index in 0..<digits.len() {
            doubled: digits[index] * 2 + carry
            digits[index] = doubled % 10
            carry = doubled /% 10
        }
        if carry != 0 -> digits.push(carry)
        exponent -= 1
    }
    loop digits.len() < 4 -> digits.push(0)
    bytes := [U8]{}
    if bits < 0 -> bytes.push(U8{45})
    index := digits.len()
    loop index > 0 {
        index -= 1
        bytes.push(U8{48 + digits[index]})
        if index == 3 -> bytes.push(U8{46})
    }
    String.from_bytes(bytes) ?? panic("decimal digits are ASCII")
}

// Host must supply this pair only after successful native object production and
// CAS publication. A graph key is not an artifact/cache key: it omits target,
// profile and runtime identity. Retain the verified object handle separately;
// the current RecordIndex contract has no native-object link kind.
JetCLICompileNodeObservation: struct {
    node: BuildNodeRecord
    object: ObjectHandle
}

jet_cli_build_compile_observation: fn(executed: BuildGraphNode, duration_ms: Float, previous: BuildRecord?, object: ObjectHandle) -> JetCLICompileNodeObservation JetCLIReadError! {
    if executed.kind != "compile" -> return Err(jet_cli_read_error("native object production requires a compile node"))
    if duration_ms - duration_ms != 0.0 || duration_ms < 0.0 -> return Err(jet_cli_read_error("native compile duration is not a finite non-negative observation"))
    // CmdCompile15122-15129 names the first canonical input when a prior
    // authenticated record exists. It does not claim that input changed.
    reason: if {
        previous == None -> "first-run"
        executed.inputs.len() > 0 -> "input:{executed.inputs[0]}"
        else -> "first-run"
    }
    return Ok(JetCLICompileNodeObservation{
        node: BuildNodeRecord{kind: executed.kind, key: executed.key, subject: executed.subject, duration_ms: duration_ms, why_ran: reason, inputs: executed.inputs},
        object: object,
    })
}

// Only authenticated producer evidence can supply timing/rebuild reasons.
// Planned nodes carry only what the compiler knows before a run (kind, key,
// subject, inputs): a step that has not run gets no time and no reason, so no
// row reads as a measured run. `nodes` is empty when no build was recorded.
jet_cli_build_nodes_report: fn(program: String, record: BuildRecord?, planned: [BuildGraphNode], json: Bool) -> String Never! {
    recorded := [BuildNodeRecord]{}
    measured := false
    if record == {
        .Val(value) -> {
            recorded = value.nodes
            measured = true
        }
        .None -> measured = false
    }
    if json {
        rows := [JetCLIStatusValue]{}
        loop node in recorded {
            rows.push(jet_cli_status_object([
                jet_cli_status_field("kind", jet_cli_status_text(node.kind)),
                jet_cli_status_field("key", jet_cli_status_text(node.key)),
                jet_cli_status_field("subject", jet_cli_status_text(node.subject)),
                jet_cli_status_field("duration_ms", JetCLIStatusValue.Float{text: jet_cli_build_duration(node.duration_ms)}),
                jet_cli_status_field("why_ran", jet_cli_status_text(node.why_ran)),
                jet_cli_status_field("inputs", jet_cli_status_texts(node.inputs)),
            ]))
        }
        planned_rows := [JetCLIStatusValue]{}
        loop node in planned {
            planned_rows.push(jet_cli_status_object([
                jet_cli_status_field("kind", jet_cli_status_text(node.kind)),
                jet_cli_status_field("key", jet_cli_status_text(node.key)),
                jet_cli_status_field("subject", jet_cli_status_text(node.subject)),
                jet_cli_status_field("inputs", jet_cli_status_texts(node.inputs)),
            ]))
        }
        document: jet_cli_status_object([
            jet_cli_status_field("schema", jet_cli_status_text("jet.explain-build/v1")),
            jet_cli_status_field("program", jet_cli_status_text(program)),
            jet_cli_status_field("nodes", jet_cli_status_array(rows)),
            jet_cli_status_field("planned", jet_cli_status_array(planned_rows)),
        ])
        return "{jet_cli_status_json(document)}\n"
    }
    if !measured {
        text := "no build recorded for {program} yet; planned steps:\n"
        loop node in planned {
            text += "{node.kind}\t{node.key}\t{node.subject}\t{node.inputs.join(",")}\n"
        }
        return text
    }
    text := ""
    loop node in recorded {
        text += "{node.kind}\t{node.key}\t{node.subject}\t{jet_cli_build_duration(node.duration_ms)}\t{node.why_ran}\t{node.inputs.join(",")}\n"
    }
    text
}

// The store-owning host resolves the canonical program and supplies the
// authenticated last record, if any. With no record the command still answers
// with the planned nodes; a record for another program means the store is
// damaged and is refused with E2104.
jet_cli_build_nodes_host: fn(owned_request: &&JetDriverCompileRequest, scope: &JetDriverBuildQueryScope, file: String, program: String, record: BuildRecord?, json: Bool, color: Bool, verbose: Bool) -> JetDriverVerbOutput {
    response := jet_driver_query_build_plan(owned_request, scope)
    request := response.request.move()
    query := response.query.move()
    if !query.complete || query.internal_problem != None -> return jet_cli_build_query_failure(request, query, file, json, color, verbose)
    if record == {
        .Val(retained) -> {
            if retained.program != program -> return jet_cli_execute(jet_cli_inspect_b_report("E2104", "build execution-node evidence belongs to another program", jet_cli_why("E2104"), "select the authenticated last-build record for this program", color, json, JET_DRIVER_EXIT_USER_ERROR))
            return {stdout: jet_cli_build_nodes_report(program, Val(retained), query.nodes, json), stderr: "", exit_code: JET_DRIVER_EXIT_OK}
        }
        .None -> return {stdout: jet_cli_build_nodes_report(program, None, query.nodes, json), stderr: "", exit_code: JET_DRIVER_EXIT_OK}
    }
}
