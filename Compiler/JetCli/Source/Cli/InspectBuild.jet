// Checked graph queries share the Driver invocation; no CLI graph reconstruction.
use jet_driver.[JetDriverCompileRequest, JetDriverBuildQueryScope, JetDriverBuildQueryResult, JetDriverOptimizationQueryResult, JetDriverVerbOutput, jet_driver_query_build_plan, jet_driver_present_diagnostics, jet_driver_build_plan_json, jet_driver_build_explanation, jet_driver_optimization_query, JET_DRIVER_EXIT_OK, JET_DRIVER_EXIT_USER_ERROR]
use jet_foundation.[diagnostic_render_all, MIROptimizationDecision]
use jet_store.BuildRecord
use core.math as build_math

fn jet_cli_build_vector(query: JetDriverOptimizationQueryResult, json: Bool) -> String Never! {
    rows := [JetCLIStatusValue]{}
    text := ""
    loop function in query.functions {
        loop fact in function.vectors {
            rule :: jet_cli_optimization_vector_rule(fact.rule)
            layout :: jet_cli_optimization_vector_layout(fact.layout)
            lane :: if fact.lane_width == .Val(width) -> "{width}" else -> "none"
            decision :: if fact.decision == {.Eligible -> "accepted" .Rejected(reason) -> jet_cli_optimization_rejection(reason).code}
            if !json {
                text += "vector\t{function.key}\t{fact.span.start}..{fact.span.end}\t{rule}\t{layout}\t{lane}\t{decision}\n"
            } else {
                &rows.push(jet_cli_status_object([
                    jet_cli_status_field("function", jet_cli_status_text(function.key)),
                    jet_cli_status_field("span", jet_cli_optimization_span(fact.span)),
                    jet_cli_status_field("rule", jet_cli_status_text(rule)),
                    jet_cli_status_field("layout", jet_cli_status_text(layout)),
                    jet_cli_status_field("lane", jet_cli_status_text(lane)),
                    jet_cli_status_field("decision", jet_cli_status_text(decision)),
                ]))
            }
        }
    }
    if json -> jet_cli_status_json(jet_cli_status_array(rows)) else -> text
}

pub fn jet_cli_build_report(query: JetDriverBuildQueryResult, vector: String, subject: String?, json: Bool) -> String Never! {
    plan :: query.plan ?? {
        if json -> return "{jet_cli_status_render("inspect.build", true, [jet_cli_status_field("build", JetCLIStatusValue.Null)])}\n"
        return "default pipeline: no root fn build\n"
    }
    if subject == .Val(name) {
        explanation :: jet_driver_build_explanation(plan, name)
        if json -> return "{jet_cli_status_render("inspect.build", true, [jet_cli_status_field("label", jet_cli_status_text(explanation.label)), jet_cli_status_field("provenance", jet_cli_status_texts(explanation.provenance))])}\n"
        text := "{explanation.label}\n"
        loop fact in explanation.provenance -> text += "  {fact}\n"
        return text
    }
    if json {
        payload :: jet_driver_build_plan_json(plan, vector)
        build :: jet_cli_status_from_tree(report_status_value_parse(payload) ?? panic("checked build projection lost its JSON")) ?? panic("checked build projection lost its status value")
        return "{jet_cli_status_render("inspect.build", true, [jet_cli_status_field("build", build)])}\n"
    }
    graph :: query.graph ?? panic("checked plan lost its graph")
    text := ""
    loop target in graph.targets -> text += "target\t{target.name}\t{target.kind}\n"
    loop action in graph.actions -> text += "action\t{action.name}\t{action.outputs.join(",")}\n"
    "{text}{vector}"
}

pub fn jet_cli_build_host(request: JetDriverCompileRequest, scope: &JetDriverBuildQueryScope, file: String, subject: String?, json: Bool) -> JetDriverVerbOutput {
    query :: jet_driver_query_build_plan(request, &scope)
    if !query.complete || query.internal_problem != None {
        diagnostics :: jet_driver_present_diagnostics(query.diagnostics, request.authorized_sources, [])
        report :: if json -> jet_cli_reports_status_json("inspect", false, jet_cli_report_cwd(), file, "", diagnostics) else -> diagnostic_render_all(file, "", diagnostics, false)
        return {stdout: if json -> report else -> "", stderr: if json -> "" else -> report, exit_code: JET_DRIVER_EXIT_USER_ERROR}
    }
    vector := if json -> "[]" else -> ""
    if query.plan != None && subject == None {
        optimization :: jet_driver_optimization_query(request)
        // The reference omits vector rows on failed semantic lowering. An
        // actual completed producer, never an absent provider, supplies [].
        if optimization.compile.complete && optimization.compile.internal_problem == None -> vector = jet_cli_build_vector(optimization, json)
    }
    {stdout: jet_cli_build_report(query, vector, subject, json), stderr: "", exit_code: JET_DRIVER_EXIT_OK}
}

// Exact IEEE-754 fixed-three formatting, including half-to-even and -0.
// Multiplying the binary significand by 125 is exact in Int; 1000 = 125*8.
// A floating multiply/round would double-round and diverge from Rust's {:.3}.
fn jet_cli_build_duration(value: Float) -> String Never! {
    bits :: build_math.to_bits(value)
    raw_exponent :: (bits >> 52) & 2047
    if raw_exponent == 2047 -> panic("build record duration must be finite")
    significand := bits & 4503599627370495
    exponent := -1071
    if raw_exponent != 0 {
        significand += 4503599627370496
        exponent = raw_exponent - 1072
    }
    scaled := significand * 125
    if exponent < 0 {
        shift :: -exponent
        if shift > 60 -> scaled = 0
        else {
            divisor :: 1 << shift
            quotient :: scaled / divisor
            remainder :: scaled % divisor
            half :: divisor / 2
            scaled = quotient
            if remainder > half || (remainder == half && quotient % 2 != 0) -> scaled += 1
        }
        exponent = 0
    }
    digits := [Int]{}
    loop {
        &digits.push(scaled % 10)
        scaled /= 10
        if scaled == 0 -> break
    }
    loop exponent > 0 {
        carry := 0
        loop index in 0..<digits.len() {
            doubled :: digits[index] * 2 + carry
            digits[index] = doubled % 10
            carry = doubled / 10
        }
        if carry != 0 -> &digits.push(carry)
        exponent -= 1
    }
    loop digits.len() < 4 -> &digits.push(0)
    bytes := [U8]{}
    if bits < 0 -> &bytes.push(U8{45})
    index := digits.len()
    loop index > 0 {
        index -= 1
        &bytes.push(U8{48 + digits[index]})
        if index == 3 -> &bytes.push(U8{46})
    }
    String.from_bytes(bytes) ?? panic("decimal digits are ASCII")
}

// Only authenticated producer evidence can supply timing/rebuild reasons.
// Static node keys are not execution receipts (no synthetic first-run rows).
pub fn jet_cli_build_nodes_report(record: BuildRecord, json: Bool) -> String Never! {
    rows := [JetCLIStatusValue]{}
    text := ""
    loop node in record.nodes {
        duration :: jet_cli_build_duration(node.duration_ms)
        if json {
            &rows.push(jet_cli_status_object([
                jet_cli_status_field("kind", jet_cli_status_text(node.kind)),
                jet_cli_status_field("key", jet_cli_status_text(node.key)),
                jet_cli_status_field("subject", jet_cli_status_text(node.subject)),
                jet_cli_status_field("duration_ms", JetCLIStatusValue.Float{text: duration}),
                jet_cli_status_field("why_ran", jet_cli_status_text(node.why_ran)),
                jet_cli_status_field("inputs", jet_cli_status_texts(node.inputs)),
            ]))
        } else -> text += "{node.kind}\t{node.key}\t{node.subject}\t{duration}\t{node.why_ran}\t{node.inputs.join(",")}\n"
    }
    if json {
        document :: jet_cli_status_object([
            jet_cli_status_field("schema", jet_cli_status_text("jet.explain-build/v1")),
            jet_cli_status_field("program", jet_cli_status_text(record.program)),
            jet_cli_status_field("nodes", jet_cli_status_array(rows)),
        ])
        return "{jet_cli_status_json(document)}\n"
    }
    text
}
