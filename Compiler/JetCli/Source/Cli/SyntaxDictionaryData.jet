    {token: "Specified", query: "specified", display_query: "#specified", registry_name: "MARKER_SOURCE", kind: JetCLISyntaxKind.Marker, meanings: [JetCLISyntaxMeaning]{JetCLISyntaxMeaning{position: "Before a numbered enum", text: "Every case states its number, so adding or moving a case renumbers no other.", example: "#[Specified, Layout(U8)] Op: enum {{ Add = 1, Sub = 2 }}", afterwards: "", related_codes: [String]{"E1124", "E1125"}}}},
    {token: "Static", query: "static", display_query: "#static", registry_name: "MARKER_SOURCE", kind: JetCLISyntaxKind.Marker, meanings: [JetCLISyntaxMeaning]{JetCLISyntaxMeaning{position: "", text: "The marker `#Static`.", example: "#Static …", afterwards: "", related_codes: [String]{}}}},
    {token: "Target", query: "target", display_query: "#target", registry_name: "MARKER_SOURCE", kind: JetCLISyntaxKind.Marker, meanings: [JetCLISyntaxMeaning]{JetCLISyntaxMeaning{position: "", text: "The marker `#Target`.", example: "#Target …", afterwards: "", related_codes: [String]{}}}},
    {token: "Through", query: "through", display_query: "#through", registry_name: "MARKER_SOURCE", kind: JetCLISyntaxKind.Marker, meanings: [JetCLISyntaxMeaning]{JetCLISyntaxMeaning{position: "After a match arm's body", text: "The next arm's body runs after this one, without the next arm's bindings.", example: "1 -> {{ open() }} #Through", afterwards: "", related_codes: [String]{"E1126", "E1127", "E1128"}}}},
    {token: "Track", query: "track", display_query: "#track", registry_name: "MARKER_SOURCE", kind: JetCLISyntaxKind.Marker, meanings: [JetCLISyntaxMeaning]{JetCLISyntaxMeaning{position: "", text: "The marker `#Track`.", example: "#Track …", afterwards: "", related_codes: [String]{}}}},
    {token: "Undo", query: "undo", display_query: "#undo", registry_name: "MARKER_SOURCE", kind: JetCLISyntaxKind.Marker, meanings: [JetCLISyntaxMeaning]{JetCLISyntaxMeaning{position: "", text: "The marker `#Undo`.", example: "#Undo …", afterwards: "", related_codes: [String]{}}}},
    {token: "UnitFamily", query: "unitfamily", display_query: "#unitfamily", registry_name: "MARKER_SOURCE", kind: JetCLISyntaxKind.Marker, meanings: [JetCLISyntaxMeaning]{JetCLISyntaxMeaning{position: "", text: "The marker `#UnitFamily`.", example: "#UnitFamily …", afterwards: "", related_codes: [String]{}}}},
    {token: "Untagged", query: "untagged", display_query: "#untagged", registry_name: "MARKER_SOURCE", kind: JetCLISyntaxKind.Marker, meanings: [JetCLISyntaxMeaning]{JetCLISyntaxMeaning{position: "", text: "The marker `#Untagged`.", example: "#Untagged …", afterwards: "", related_codes: [String]{}}}},
    {token: "!", query: "!", display_query: "!", registry_name: "OP_NOT", kind: JetCLISyntaxKind.Operator, meanings: [JetCLISyntaxMeaning]{JetCLISyntaxMeaning{position: "Before a condition", text: "Flips true and false.", example: "if !done {{ keep_going() }}", afterwards: "", related_codes: [String]{}}, JetCLISyntaxMeaning{position: "After an error type in a signature", text: "`E!` marks the errors a function can fail with; `(A | B)!` lists several.", example: "parse: fn(text: String) -> Int ParseError! {{ … }}\nvalue: parse(input) ?? 0", afterwards: "A failure passes to the caller on its own; handle it where you want with `??`.", related_codes: [String]{"E0405"}}}},
    {token: "!=", query: "!=", display_query: "!=", registry_name: "OP_NE", kind: JetCLISyntaxKind.Operator, meanings: [JetCLISyntaxMeaning]{JetCLISyntaxMeaning{position: "Between two values", text: "True when the values differ.", example: "if value != None {{ use(value) }}", afterwards: "", related_codes: [String]{}}}},
    {token: "%", query: "%", display_query: "%", registry_name: "OP_PERCENT", kind: JetCLISyntaxKind.Operator, meanings: [JetCLISyntaxMeaning]{JetCLISyntaxMeaning{position: "Between two whole numbers", text: "Modulo: the answer takes the divisor's sign, so -7 % 2 is 1.", example: "slot: index % size", afterwards: "It pairs with `/%`.", related_codes: [String]{}}}},
    {token: "%%", query: "%%", display_query: "%%", registry_name: "OP_PERCENT_PERCENT", kind: JetCLISyntaxKind.Operator, meanings: [JetCLISyntaxMeaning]{JetCLISyntaxMeaning{position: "Between two whole numbers", text: "Remainder: the answer takes the dividend's sign, so -7 %% 2 is -1.", example: "left_over: total %% 3", afterwards: "It pairs with `/`.", related_codes: [String]{}}}},
    {token: "%%=", query: "%%=", display_query: "%%=", registry_name: "OP_PERCENT_PERCENT_EQ", kind: JetCLISyntaxKind.Operator, meanings: [JetCLISyntaxMeaning]{JetCLISyntaxMeaning{position: "After a mutable name", text: "Replaces the name with its remainder: `x %%= 3` is `x = x %% 3`.", example: "rest := -7\nrest %%= 3", afterwards: "The name must be mutable (`:=`) or a place marked `&`; its new value is used from here on.", related_codes: [String]{"E0111"}}}},
    {token: "%=", query: "%=", display_query: "%=", registry_name: "OP_PERCENT_EQ", kind: JetCLISyntaxKind.Operator, meanings: [JetCLISyntaxMeaning]{JetCLISyntaxMeaning{position: "After a mutable name", text: "Replaces the name with its modulo: `x %= 3` is `x = x % 3`.", example: "slot := 10\nslot %= 3", afterwards: "The name must be mutable (`:=`) or a place marked `&`; its new value is used from here on.", related_codes: [String]{"E0111"}}}},
    {token: "&&", query: "&&", display_query: "&&", registry_name: "OP_AND", kind: JetCLISyntaxKind.Operator, meanings: [JetCLISyntaxMeaning]{JetCLISyntaxMeaning{position: "Between two conditions", text: "True when both are true. The right side runs only when the left is true.", example: "if ready && count > 0 {{ start() }}", afterwards: "", related_codes: [String]{}}, JetCLISyntaxMeaning{position: "Before a parameter's type or `self`", text: "`name: &&T` says the function takes that argument for good; `&&self` takes the receiver.", example: "archive: fn(name: &&String) -> String {{ name }}\nsaved: archive(title)", afterwards: "The call is written plain. The caller's value moves into the function, and a later use is error E0209, which names the call. To keep using it, pass `title.copy()`.", related_codes: [String]{"E0209"}}, JetCLISyntaxMeaning{position: "After `task`, before a name", text: "`task &&name {{ … }}` moves one enclosing value into the task.", example: "job: Job{{id: 7}}\ntask &&job {{ job.run() }}", afterwards: "The task owns the value; a later use of the name is error E0121.", related_codes: [String]{"E0121"}}}},
    {token: "&=", query: "&=", display_query: "&=", registry_name: "OP_AMP_EQ", kind: JetCLISyntaxKind.Operator, meanings: [JetCLISyntaxMeaning]{JetCLISyntaxMeaning{position: "After a mutable name", text: "Bitwise AND in place: `x &= m` is `x = x & m`.", example: "flags := 7\nflags &= 3", afterwards: "The name must be mutable (`:=`) or a place marked `&`; its new value is used from here on.", related_codes: [String]{"E0111"}}}},
    {token: "*", query: "*", display_query: "*", registry_name: "OP_STAR", kind: JetCLISyntaxKind.Operator, meanings: [JetCLISyntaxMeaning]{JetCLISyntaxMeaning{position: "Between two numbers", text: "Multiplies the numbers.", example: "area: width * height", afterwards: "Both numbers are unchanged.", related_codes: [String]{}}, JetCLISyntaxMeaning{position: "Alone in a parameter list", text: "Starts the label-only parameters: callers must name each argument after it.", example: "draw: fn(size: Int, *, color: String) {{ … }}\ndraw(3, color: \"red\")", afterwards: "", related_codes: [String]{}}}},
    {token: "*=", query: "*=", display_query: "*=", registry_name: "OP_STAR_EQ", kind: JetCLISyntaxKind.Operator, meanings: [JetCLISyntaxMeaning]{JetCLISyntaxMeaning{position: "After a mutable name", text: "Multiplies the name in place: `x *= 2` is `x = x * 2`.", example: "size := 4\nsize *= 2", afterwards: "The name must be mutable (`:=`) or a place marked `&`; its new value is used from here on.", related_codes: [String]{"E0111"}}}},
    {token: "+", query: "+", display_query: "+", registry_name: "OP_PLUS", kind: JetCLISyntaxKind.Operator, meanings: [JetCLISyntaxMeaning]{JetCLISyntaxMeaning{position: "Between two numbers", text: "Adds the numbers.", example: "total: price + tax", afterwards: "Both numbers are unchanged; the sum is a new value.", related_codes: [String]{}}}},
    {token: "+=", query: "+=", display_query: "+=", registry_name: "OP_PLUS_EQ", kind: JetCLISyntaxKind.Operator, meanings: [JetCLISyntaxMeaning]{JetCLISyntaxMeaning{position: "After a mutable name", text: "Adds to the name in place: `x += 1` is `x = x + 1`.", example: "count := 0\ncount += 1", afterwards: "The name must be mutable (`:=`) or a place marked `&`; its new value is used from here on.", related_codes: [String]{"E0111"}}}},
    {token: "-", query: "-", display_query: "-", registry_name: "OP_MINUS", kind: JetCLISyntaxKind.Operator, meanings: [JetCLISyntaxMeaning]{JetCLISyntaxMeaning{position: "Between two numbers", text: "Subtracts the right number from the left one.", example: "change: paid - price", afterwards: "Both numbers are unchanged.", related_codes: [String]{}}, JetCLISyntaxMeaning{position: "Before a number", text: "Negates the number.", example: "below: -5\nflipped: -below", afterwards: "", related_codes: [String]{}}}},
    {token: "-=", query: "-=", display_query: "-=", registry_name: "OP_MINUS_EQ", kind: JetCLISyntaxKind.Operator, meanings: [JetCLISyntaxMeaning]{JetCLISyntaxMeaning{position: "After a mutable name", text: "Subtracts from the name in place: `x -= 1` is `x = x - 1`.", example: "lives := 3\nlives -= 1", afterwards: "The name must be mutable (`:=`) or a place marked `&`; its new value is used from here on.", related_codes: [String]{"E0111"}}}},
    {token: "->", query: "->", display_query: "->", registry_name: "OP_UNIFIED_ARROW", kind: JetCLISyntaxKind.Operator, meanings: [JetCLISyntaxMeaning]{JetCLISyntaxMeaning{position: "After parameters, a pattern, or a loop head", text: "Points to the result: a function's return type, or the value or statement of a lambda, match arm, or loop body.", example: "twice: fn(n: Int) -> Int {{ n * 2 }}\nloop value in values -> print(value)", afterwards: "Write `-[IO]>` instead of `->` to state which effects a function may use.", related_codes: [String]{}}}},
    {token: "..", query: "..", display_query: "..", registry_name: "OP_RANGE", kind: JetCLISyntaxKind.Operator, meanings: [JetCLISyntaxMeaning]{JetCLISyntaxMeaning{position: "Between two whole numbers", text: "A range from the first number to the last, both included.", example: "loop i in 1..3 {{ print(i) }}", afterwards: "The loop sees 1, 2 and 3. Use `..<` to leave out the last number.", related_codes: [String]{"E0364"}}}},
    {token: "..<", query: "..<", display_query: "..<", registry_name: "OP_RANGE_EXCLUSIVE", kind: JetCLISyntaxKind.Operator, meanings: [JetCLISyntaxMeaning]{JetCLISyntaxMeaning{position: "Between two whole numbers", text: "A range that stops just before the last number.", example: "loop i in 0..<3 {{ print(i) }}", afterwards: "The loop sees 0, 1 and 2. The range is empty when the start is not less than the end.", related_codes: [String]{}}}},
    {token: ".[", query: ".[", display_query: ".[", registry_name: "OP_MEMBER_SPREAD", kind: JetCLISyntaxKind.Operator, meanings: [JetCLISyntaxMeaning]{JetCLISyntaxMeaning{position: "After a value or module name", text: "Picks several members at once.", example: "checks: v.[length, charset]\nuse numeric.[clamp, abs]", afterwards: "On a value you get a list of those members; after `use` each name comes into scope.", related_codes: [String]{"E0961"}}}},
    {token: "/", query: "/", display_query: "/", registry_name: "OP_SLASH", kind: JetCLISyntaxKind.Operator, meanings: [JetCLISyntaxMeaning]{JetCLISyntaxMeaning{position: "Between two numbers", text: "Divides the left number by the right one. Whole numbers drop the fraction (7 / 2 is 3); `/%` rounds down instead.", example: "half: total / 2", afterwards: "Both numbers are unchanged. `%%` gives the matching remainder.", related_codes: [String]{}}, JetCLISyntaxMeaning{position: "Alone in a parameter list", text: "Ends the position-only parameters: callers pass them without names.", example: "show: fn(n: Int, /) {{ print(\"{{n}}\") }}\nshow(5)", afterwards: "", related_codes: [String]{}}}},
    {token: "/%", query: "/%", display_query: "/%", registry_name: "OP_SLASH_PERCENT", kind: JetCLISyntaxKind.Operator, meanings: [JetCLISyntaxMeaning]{JetCLISyntaxMeaning{position: "Between two whole numbers", text: "Divides and rounds down, toward negative infinity.", example: "rows: -7 /% 2", afterwards: "Here `rows` is -4. `%` gives the matching remainder.", related_codes: [String]{}}}},
    {token: "/%=", query: "/%=", display_query: "/%=", registry_name: "OP_SLASH_PERCENT_EQ", kind: JetCLISyntaxKind.Operator, meanings: [JetCLISyntaxMeaning]{JetCLISyntaxMeaning{position: "After a mutable name", text: "Divides the name in place, rounding down: `x /%= 2` is `x = x /% 2`.", example: "step := -7\nstep /%= 2", afterwards: "The name must be mutable (`:=`) or a place marked `&`; its new value is used from here on.", related_codes: [String]{"E0111"}}}},
    {token: "/=", query: "/=", display_query: "/=", registry_name: "OP_SLASH_EQ", kind: JetCLISyntaxKind.Operator, meanings: [JetCLISyntaxMeaning]{JetCLISyntaxMeaning{position: "After a mutable name", text: "Divides the name in place: `x /= 2` is `x = x / 2`.", example: "size := 8\nsize /= 2", afterwards: "The name must be mutable (`:=`) or a place marked `&`; its new value is used from here on.", related_codes: [String]{"E0111"}}}},
    {token: "<", query: "<", display_query: "<", registry_name: "OP_LT", kind: JetCLISyntaxKind.Operator, meanings: [JetCLISyntaxMeaning]{JetCLISyntaxMeaning{position: "Between two values", text: "True when the left value is smaller.", example: "if age < 18 {{ print(\"minor\") }}", afterwards: "", related_codes: [String]{}}, JetCLISyntaxMeaning{position: "After a type or function name", text: "Opens a list of type arguments, closed by `>`.", example: "counts := Tally<String>.new()\n(sender, receiver): channel<Int>()", afterwards: "", related_codes: [String]{}}}},
    {token: "<<", query: "<<", display_query: "<<", registry_name: "OP_SHL", kind: JetCLISyntaxKind.Operator, meanings: [JetCLISyntaxMeaning]{JetCLISyntaxMeaning{position: "Between two whole numbers", text: "Shifts the left number's bits left by the right number of places.", example: "eight: 1 << 3", afterwards: "", related_codes: [String]{}}}},
    {token: "<<=", query: "<<=", display_query: "<<=", registry_name: "OP_SHL_EQ", kind: JetCLISyntaxKind.Operator, meanings: [JetCLISyntaxMeaning]{JetCLISyntaxMeaning{position: "After a mutable name", text: "Shifts the name's bits left in place: `x <<= 1` is `x = x << 1`.", example: "bits := 1\nbits <<= 3", afterwards: "The name must be mutable (`:=`) or a place marked `&`; its new value is used from here on.", related_codes: [String]{"E0111"}}}},
    {token: "<=", query: "<=", display_query: "<=", registry_name: "OP_LE", kind: JetCLISyntaxKind.Operator, meanings: [JetCLISyntaxMeaning]{JetCLISyntaxMeaning{position: "Between two values", text: "True when the left value is smaller or equal.", example: "if count <= limit {{ add() }}", afterwards: "", related_codes: [String]{}}}},
    {token: "<=>", query: "<=>", display_query: "<=>", registry_name: "OP_COMPARE", kind: JetCLISyntaxKind.Operator, meanings: [JetCLISyntaxMeaning]{JetCLISyntaxMeaning{position: "Between two values", text: "Compares in one step and gives an `Ordering`: `.Less`, `.Equal` or `.Greater`.", example: "order: left <=> right", afterwards: "Match on the `Ordering` to handle each case.", related_codes: [String]{}}}},
    {token: "==", query: "==", display_query: "==", registry_name: "OP_EQ", kind: JetCLISyntaxKind.Operator, meanings: [JetCLISyntaxMeaning]{JetCLISyntaxMeaning{position: "Between two values", text: "True when the values are equal.", example: "if answer == 42 {{ print(\"found\") }}", afterwards: "`=` assigns; `==` only compares.", related_codes: [String]{}}}},
    {token: ">", query: ">", display_query: ">", registry_name: "OP_GT", kind: JetCLISyntaxKind.Operator, meanings: [JetCLISyntaxMeaning]{JetCLISyntaxMeaning{position: "Between two values", text: "True when the left value is larger.", example: "if score > best {{ best = score }}", afterwards: "", related_codes: [String]{}}, JetCLISyntaxMeaning{position: "After type arguments", text: "Closes a list of type arguments opened by `<`.", example: "counts := Tally<String>.new()", afterwards: "", related_codes: [String]{}}}},
    {token: ">=", query: ">=", display_query: ">=", registry_name: "OP_GE", kind: JetCLISyntaxKind.Operator, meanings: [JetCLISyntaxMeaning]{JetCLISyntaxMeaning{position: "Between two values", text: "True when the left value is larger or equal.", example: "if total >= 100 {{ print(\"free shipping\") }}", afterwards: "", related_codes: [String]{}}}},
    {token: ">>", query: ">>", display_query: ">>", registry_name: "OP_SHR", kind: JetCLISyntaxKind.Operator, meanings: [JetCLISyntaxMeaning]{JetCLISyntaxMeaning{position: "Between two whole numbers", text: "Shifts the left number's bits right by the right number of places.", example: "two: 16 >> 3", afterwards: "", related_codes: [String]{}}}},
    {token: ">>=", query: ">>=", display_query: ">>=", registry_name: "OP_SHR_EQ", kind: JetCLISyntaxKind.Operator, meanings: [JetCLISyntaxMeaning]{JetCLISyntaxMeaning{position: "After a mutable name", text: "Shifts the name's bits right in place: `x >>= 1` is `x = x >> 1`.", example: "bits := 16\nbits >>= 3", afterwards: "The name must be mutable (`:=`) or a place marked `&`; its new value is used from here on.", related_codes: [String]{"E0111"}}}},
    {token: "?", query: "?", display_query: "?", registry_name: "OP_TRY_SUFFIX", kind: JetCLISyntaxKind.Operator, meanings: [JetCLISyntaxMeaning]{JetCLISyntaxMeaning{position: "After a type", text: "`T?` is an optional value: it holds a `T` or nothing (`None`).", example: "find: fn(id: Int) -> Entry? {{ … }}\nentry: find(7) ?? return", afterwards: "Handle the missing case with `??`, `?.` or an `if` check before using the value.", related_codes: [String]{"E0308", "E0047"}}, JetCLISyntaxMeaning{position: "After a call, followed by a note in parentheses", text: "Adds a note to any failure that passes through this call.", example: "raw: read_raw()?(\"reading the config\")\nreturn Ok(raw)", afterwards: "On success nothing changes; on failure the caller sees the failure with the note attached.", related_codes: [String]{}}}},
    {token: "?.", query: "?.", display_query: "?.", registry_name: "OP_OPTIONAL_CHAIN", kind: JetCLISyntaxKind.Operator, meanings: [JetCLISyntaxMeaning]{JetCLISyntaxMeaning{position: "After an optional value", text: "Reads a field or calls a method only when the value is there; it stops at the first missing link.", example: "city: user?.address?.city\nname: user?.display_name()", afterwards: "The result is optional (`T?`), so handle the missing case with `??`.", related_codes: [String]{"E0047"}}}},
    {token: "??", query: "??", display_query: "??", registry_name: "OP_FALLBACK", kind: JetCLISyntaxKind.Operator, meanings: [JetCLISyntaxMeaning]{JetCLISyntaxMeaning{position: "After an optional or fallible value", text: "Supplies what to use when the left side is missing (`None`) or failed: a value, or a way out such as `return`, `break`, `next` or `panic(…)`.", example: "port: env_port() ?? 8080\nuser: load_user() ?? return", afterwards: "The result is a plain value, no longer optional. Inside a fallback after a failure, `err` names the failure.", related_codes: [String]{"E0405", "E0408"}}}},
    {token: "|>", query: "|>", display_query: "|>", registry_name: "OP_PIPE_STEP", kind: JetCLISyntaxKind.Operator, meanings: [JetCLISyntaxMeaning]{JetCLISyntaxMeaning{position: "At the start of a line after a value", text: "Starts a pipe step: the expression after `|>` runs on the value of the line above, which it reads as `<>`.", example: "port: raw\n    |> String.from_bytes(<>) ?? return 80\n    |> Int.parse(<>.trim()) ?? return 80", afterwards: "The whole pipe is one value: the last step's result. Each step may carry its own `??` route.", related_codes: [String]{"E0437", "E0438"}}}},
    {token: "<>", query: "<>", display_query: "<>", registry_name: "OP_PIPE_VALUE", kind: JetCLISyntaxKind.Operator, meanings: [JetCLISyntaxMeaning]{JetCLISyntaxMeaning{position: "Inside a `|>` step", text: "The value the step receives from the line above. A step may read it more than once; in a nested pipe or lambda the nearest step wins.", example: "total: line |> Int.parse(<>.trim()) ?? 0\nsafe: port |> if <> < 1 -> 80 else -> <>", afterwards: "Outside a step `<>` is an error; between two values it is not an operator, so write `!=` for not-equal.", related_codes: [String]{"E0437", "E0439", "E0440"}}}},
    {token: "{{", query: "{{", display_query: "{{", registry_name: "OP_NAMED_CTOR", kind: JetCLISyntaxKind.Operator, meanings: [JetCLISyntaxMeaning]{JetCLISyntaxMeaning{position: "After a type name", text: "Builds a value by naming its fields. Without a type name, the type comes from context.", example: "origin: Point{{x: 0, y: 0}}\nmove_to({{x: 3, y: 4}})", afterwards: "", related_codes: [String]{}}, JetCLISyntaxMeaning{position: "After a field or parameter type", text: "`T{{value}}` gives the field or parameter a default.", example: "greet: fn(name: String{{\"world\"}}) {{ print(\"hello, {{name}}\") }}\ngreet()", afterwards: "Callers may leave that argument out.", related_codes: [String]{"E2414"}}}},
    {token: "|", query: "|", display_query: "|", registry_name: "OP_PIPE", kind: JetCLISyntaxKind.Operator, meanings: [JetCLISyntaxMeaning]{JetCLISyntaxMeaning{position: "Between types or patterns", text: "Either alternative is accepted.", example: "load: fn(path: String) -> Config (IOError | ParseError)! {{ … }}", afterwards: "Code that handles the result must cover every alternative.", related_codes: [String]{}}, JetCLISyntaxMeaning{position: "Between two whole numbers", text: "Bitwise OR: each result bit is 1 where either number has a 1.", example: "mode: READ | WRITE", afterwards: "Both numbers are unchanged.", related_codes: [String]{}}}},
    {token: "|=", query: "|=", display_query: "|=", registry_name: "OP_PIPE_EQ", kind: JetCLISyntaxKind.Operator, meanings: [JetCLISyntaxMeaning]{JetCLISyntaxMeaning{position: "After a mutable name", text: "Bitwise OR in place: `x |= m` is `x = x | m`.", example: "flags := 1\nflags |= 4", afterwards: "The name must be mutable (`:=`) or a place marked `&`; its new value is used from here on.", related_codes: [String]{"E0111"}}}},
    {token: "||", query: "||", display_query: "||", registry_name: "OP_OR", kind: JetCLISyntaxKind.Operator, meanings: [JetCLISyntaxMeaning]{JetCLISyntaxMeaning{position: "Between two conditions", text: "True when either is true. The right side runs only when the left is false.", example: "if empty || closed {{ return }}", afterwards: "", related_codes: [String]{}}}},
    {token: "#", query: "#", display_query: "#", registry_name: "MARKER_PREFIX", kind: JetCLISyntaxKind.Sigil, meanings: [JetCLISyntaxMeaning]{JetCLISyntaxMeaning{position: "Before a name", text: "Applies a marker to what follows, such as `#Test`; `#[A, B]` applies several.", example: "#Test(\"adds\") {{\n    assert_eq(1 + 1, 2)\n}}", afterwards: "Run `jet explain #Name` to read what a marker does.", related_codes: [String]{}}, JetCLISyntaxMeaning{position: "Inside a list type", text: "`[T#N]` is a list of exactly N items.", example: "mix: fn(color: [Int#3]) -> Int {{ color[0] }}", afterwards: "The length is fixed: `push` and `pop` are errors, and a constant index past the end is caught before the program runs.", related_codes: [String]{"E0964", "E0965"}}, JetCLISyntaxMeaning{position: "After a package name", text: "Pins an exact package version.", example: "json#1.2.0", afterwards: "", related_codes: [String]{}}, JetCLISyntaxMeaning{position: "Before `{{name}}` in a derive or marker template", text: "`#{{name}}` pastes the template binding `name` into the code the template generates: a declaration name, a member or a variant.", example: "comptime loop field in T.reflect().fields {{\n    method: \"field_{{field.reflect().name}}\"\n    #{{method}}: fn(self) -> String {{ field.reflect().name }}\n}}", afterwards: "Outside a derive or marker template a paste is an error; write the name itself.", related_codes: [String]{"E0003"}}}},
    {token: "$", query: "$", display_query: "$", registry_name: "COMPTIME_MARK", kind: JetCLISyntaxKind.Sigil, meanings: [JetCLISyntaxMeaning]{JetCLISyntaxMeaning{position: "Before a name", text: "Marks a `$NAME` environment read in a config surface such as `env.jet`. Program source has no `$` words: the site values are `#here` and `#caller`, and a program reads a compiler fact through its subject, as in `Point.reflect().name`.", example: "print(Point.reflect().name)\nprint(#here)", afterwards: "A fact is known while building, so reading it costs nothing at run time. Build facts read through the compiler value `#build`, such as `#build.target.os`.", related_codes: [String]{}}}},
    {token: "&", query: "&", display_query: "&", registry_name: "SIGIL_WRITE", kind: JetCLISyntaxKind.Sigil, meanings: [JetCLISyntaxMeaning]{JetCLISyntaxMeaning{position: "Before a parameter's type or `self`", text: "`name: &T` lets the function change the caller's value; `&self` changes the receiver.", example: "bump: fn(n: &Int) {{ n += 1 }}\nscore := 41\nbump(score)", afterwards: "The call is written plain, and the change shows up in `score` afterwards.", related_codes: [String]{"E0205", "E0111"}}, JetCLISyntaxMeaning{position: "Before a range of a list bound to a name", text: "Binds a write window: writes through the name change those items of the list.", example: "values := [3, 1, 2]\nedit: &values[0..2]", afterwards: "`values` changes through `edit` while the window is open.", related_codes: [String]{"E0213"}}, JetCLISyntaxMeaning{position: "Between two whole numbers", text: "Bitwise AND: each result bit is 1 only where both numbers have a 1.", example: "flags: 6\nlow: flags & 3", afterwards: "Both numbers are unchanged; here `low` is 2.", related_codes: [String]{}}}},
    {token: "...", query: "...", display_query: "...", registry_name: "SIGIL_SPREAD", kind: JetCLISyntaxKind.Sigil, meanings: [JetCLISyntaxMeaning]{JetCLISyntaxMeaning{position: "Before a list in a call or list literal", text: "Spreads the list's items in place, as if each were written out.", example: "both: [...first, 0, ...second]\nshow(...names)", afterwards: "The spread list itself is unchanged.", related_codes: [String]{"E1311", "E1312"}}, JetCLISyntaxMeaning{position: "Before the last parameter's type", text: "`name: ...T` accepts any number of arguments and collects them into a list.", example: "total: fn(numbers: ...Int) -> Int {{ … }}\ntotal(1, 2, 3)", afterwards: "Only the last parameter can collect arguments, and it can't have a default.", related_codes: [String]{"E1310"}}}},
    {token: ":", query: ":", display_query: ":", registry_name: "SIGIL_BIND_IMMUT", kind: JetCLISyntaxKind.Sigil, meanings: [JetCLISyntaxMeaning]{JetCLISyntaxMeaning{position: "Between a name and a value", text: "Binds the name to a value that never changes.", example: "answer: 42\nprint(answer)", afterwards: "`answer` keeps this value for the rest of its block; assigning to it again is an error.", related_codes: [String]{"E0111"}}, JetCLISyntaxMeaning{position: "Between a name and a declaration kind", text: "Declares the name: `area: fn(…)` is a function, `Point: struct {{…}}` a type and `math: module {{…}}` a module.", example: "area: fn(r: Float) -> Float {{ r * r }}\nPoint: struct {{\n    x: Int\n}}", afterwards: "Each declaration is one name, one `:` and the declaration after it.", related_codes: [String]{}}, JetCLISyntaxMeaning{position: "After `#X` on its own line inside a declaration's body", text: "Writes one of the declaration's markers inside its body: `#X: v` is the same marker as `#X(v)` above it.", example: "Pixel: struct {{\n    r: U8\n    #Layout: c\n}}", afterwards: "A declaration writes its whole marker set in one place; `jet fix --markers above` moves it above.", related_codes: [String]{"E0942", "E0943"}}}},
    {token: ":=", query: ":=", display_query: ":=", registry_name: "SIGIL_BIND_MUT", kind: JetCLISyntaxKind.Sigil, meanings: [JetCLISyntaxMeaning]{JetCLISyntaxMeaning{position: "Between a name and a value", text: "Binds the name to a value that can change later with `=`.", example: "count := 0\ncount = count + 1", afterwards: "Change it with `=` or a compound form such as `+=`. A `:=` name that never changes gets a hint to use `:`.", related_codes: [String]{"L0528"}}}},
    {token: ":>", query: ":>", display_query: ":>", registry_name: "SIGIL_FENCE_CLOSE", kind: JetCLISyntaxKind.Sigil, meanings: [JetCLISyntaxMeaning]{JetCLISyntaxMeaning{position: "At the end of a list of entries", text: "Closes a fence opened with `<:`.", example: "<: low, high :>: 1\nprint(<: low, high :>)", afterwards: "The statement around the fence runs once per entry.", related_codes: [String]{"E0371"}}}},
    {token: "<:", query: "<:", display_query: "<:", registry_name: "SIGIL_FENCE_OPEN", kind: JetCLISyntaxKind.Sigil, meanings: [JetCLISyntaxMeaning]{JetCLISyntaxMeaning{position: "At the start of a list of entries", text: "Opens a fence: the whole statement repeats once for each entry between `<:` and `:>`.", example: "<: a, b, c :>: 0\nprint(<: a, b, c :>)", afterwards: "No list is created; each entry gets its own copy of the statement. Fences in one statement advance together, so they need the same number of entries.", related_codes: [String]{"E0368", "E0370"}}}},
    {token: "Pure", query: "pure", display_query: "#pure", registry_name: "KW_PURE", kind: JetCLISyntaxKind.Marker, meanings: [JetCLISyntaxMeaning]{JetCLISyntaxMeaning{position: "", text: "The marker `#Pure`.", example: "#Pure …", afterwards: "", related_codes: [String]{}}}},
    {token: "Invariant", query: "invariant", display_query: "#invariant", registry_name: "Invariant", kind: JetCLISyntaxKind.Marker, meanings: [JetCLISyntaxMeaning]{JetCLISyntaxMeaning{position: "", text: "The marker `#Invariant`.", example: "#Invariant …", afterwards: "", related_codes: [String]{}}}},
    {token: "Default", query: "default", display_query: "#default", registry_name: "MARKER_DEFAULT", kind: JetCLISyntaxKind.Marker, meanings: [JetCLISyntaxMeaning]{JetCLISyntaxMeaning{position: "", text: "The marker `#Default`.", example: "#Default …", afterwards: "", related_codes: [String]{}}}},
    {token: "InlineAlways", query: "inlinealways", display_query: "#inlinealways", registry_name: "InlineAlways", kind: JetCLISyntaxKind.Marker, meanings: [JetCLISyntaxMeaning]{JetCLISyntaxMeaning{position: "", text: "The marker `#InlineAlways`.", example: "#InlineAlways …", afterwards: "", related_codes: [String]{}}}},
    {token: "static", query: "static", display_query: "#static", registry_name: "VIEW_FROM_STATIC", kind: JetCLISyntaxKind.Marker, meanings: [JetCLISyntaxMeaning]{JetCLISyntaxMeaning{position: "", text: "The marker `#static`.", example: "#static …", afterwards: "", related_codes: [String]{}}}},
    {token: "inline", query: "inline", display_query: "#inline", registry_name: "inline", kind: JetCLISyntaxKind.Marker, meanings: [JetCLISyntaxMeaning]{JetCLISyntaxMeaning{position: "", text: "The marker `#inline`.", example: "#inline …", afterwards: "", related_codes: [String]{}}}},
    {token: "Min", query: "min", display_query: "#min", registry_name: "Min", kind: JetCLISyntaxKind.Marker, meanings: [JetCLISyntaxMeaning]{JetCLISyntaxMeaning{position: "", text: "The marker `#Min`.", example: "#Min …", afterwards: "", related_codes: [String]{}}}},
    {token: "Max", query: "max", display_query: "#max", registry_name: "Max", kind: JetCLISyntaxKind.Marker, meanings: [JetCLISyntaxMeaning]{JetCLISyntaxMeaning{position: "", text: "The marker `#Max`.", example: "#Max …", afterwards: "", related_codes: [String]{}}}},
    {token: "Wasm", query: "wasm", display_query: "#wasm", registry_name: "WEB_BUCKET_WASM", kind: JetCLISyntaxKind.Marker, meanings: [JetCLISyntaxMeaning]{JetCLISyntaxMeaning{position: "", text: "The marker `#Wasm`.", example: "#Wasm …", afterwards: "", related_codes: [String]{}}}},
    {token: "JS", query: "js", display_query: "#js", registry_name: "WEB_BUCKET_JS", kind: JetCLISyntaxKind.Marker, meanings: [JetCLISyntaxMeaning]{JetCLISyntaxMeaning{position: "", text: "The marker `#JS`.", example: "#JS …", afterwards: "", related_codes: [String]{}}}},
    {token: "Cli", query: "cli", display_query: "#cli", registry_name: "Cli", kind: JetCLISyntaxKind.Marker, meanings: [JetCLISyntaxMeaning]{JetCLISyntaxMeaning{position: "", text: "The marker `#Cli`.", example: "#Cli …", afterwards: "", related_codes: [String]{}}}},
    {token: "Abi", query: "abi", display_query: "#abi", registry_name: "Abi", kind: JetCLISyntaxKind.Marker, meanings: [JetCLISyntaxMeaning]{JetCLISyntaxMeaning{position: "", text: "The marker `#Abi`.", example: "#Abi …", afterwards: "", related_codes: [String]{}}}},
    {token: "Html", query: "html", display_query: "#html", registry_name: "Html", kind: JetCLISyntaxKind.Marker, meanings: [JetCLISyntaxMeaning]{JetCLISyntaxMeaning{position: "", text: "The marker `#Html`.", example: "#Html …", afterwards: "", related_codes: [String]{}}}},
    {token: "Sql", query: "sql", display_query: "#sql", registry_name: "Sql", kind: JetCLISyntaxKind.Marker, meanings: [JetCLISyntaxMeaning]{JetCLISyntaxMeaning{position: "", text: "The marker `#Sql`.", example: "#Sql …", afterwards: "", related_codes: [String]{}}}},
    {token: "Ref", query: "ref", display_query: "#ref", registry_name: "Ref", kind: JetCLISyntaxKind.Marker, meanings: [JetCLISyntaxMeaning]{JetCLISyntaxMeaning{position: "", text: "The marker `#Ref`.", example: "#Ref …", afterwards: "", related_codes: [String]{}}}},
    {token: "Tag", query: "tag", display_query: "#tag", registry_name: "Tag", kind: JetCLISyntaxKind.Marker, meanings: [JetCLISyntaxMeaning]{JetCLISyntaxMeaning{position: "", text: "The marker `#Tag`.", example: "#Tag …", afterwards: "", related_codes: [String]{}}}},
}
