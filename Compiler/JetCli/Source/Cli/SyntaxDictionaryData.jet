// Jet-owned offline syntax dictionary, migrated at Rust parity cutover.
// Edit token metadata and meanings here, except the trait-marker block, which
// Tools/agent/OwnedTraitRows.jet renders from Compiler/Prelude/Traits.jet.
use jet_foundation.[Marker, Type]

JetCLISyntaxKind: enum {
    Keyword
    Marker
    Operator
    Sigil
    Literal
    Type
    Builtin
}

JetCLISyntaxMeaning: struct {
    position: String
    text: String
    example: String
    afterwards: String
    related_codes: [String]
}

JetCLISyntaxRow: struct {
    token: String
    query: String
    display_query: String
    registry_name: String
    kind: JetCLISyntaxKind
    meanings: [JetCLISyntaxMeaning]
}

