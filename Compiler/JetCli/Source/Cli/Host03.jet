    ffi_link :: out.ffi
    web_out :: out.web
    web_partition_report :: out.web_partition_report
    plugin_out :: out.plugin
    library_out :: out.library
    library_config :: out.library_config
    game_runtime :: checked_runtime.is_some_and(program_uses_game_runtime) || src.contains("core.game")
    if checked_runtime == .Val(bundle) -> tier.project(&bundle.build_facts, profile)
    inject_game_crash_reporter_bootstrap(&rust_code, game_runtime)
    &progress.minor("generated Rust", "{rust_code.len()} bytes")
    if emit_rust -> write_mode_renderable(mode, rust_code)
    build_effect_json: String? := .None
    recorded_effects: (String, String)? := .None
    if cmd == "build" || cmd == "run" {
        effect_view :: reused_package_effects.or_else(fn() {
            checked :: if is_library {
                Driver.check_file_with_effect_facts_profile_and_settings_with_source_closure(file, source_closure, profile.budget_name(), setting_overrides)
            } else if output_name == .Val(output) {
                Driver.check_file_with_effect_facts_for_output_with_source_closure(file, output, source_closure, profile.budget_name(), setting_overrides)
            } else {
                Driver.check_file_with_effect_facts_for_run_and_entry_with_source_closure(file, source_closure, profile.budget_name(), setting_overrides, entry_fn)
            }
            (diagnostics, maybe_bundle, facts) :: checked
            if diagnostics.any(fn(diagnostic) { diagnostic.severity == .Error }) {
                report_problems(mode, file, src, diagnostics)
                exit(ExitCodes.USER_ERROR)
            }
            bundle :: maybe_bundle ?? {
                diagnostic :: Diagnostic.error("E2105", "could not obtain the checked effect view", "effect enforcement must use the same immutable source checked for compilation", "retry after fixing the source authority", .None)
                report_problems(mode, file, src, [diagnostic])
                exit(ExitCodes.USER_ERROR)
            }
            (projection, delegations) :: native_effect_projection(bundle, facts.summaries, entry_fn, package_manifest.map(fn((_, manifest)) { manifest }))
            .Val((jet.EffectBudget.compute_package_effects(bundle, facts.solved, facts.summaries), facts.fact_registry.clone(), jet.EffectBudget.summary_line_for_program_with_authority(bundle, facts.summaries, entry_fn.unwrap_or("run"), package_manifest.map(fn((_, manifest)) { manifest })), jet.EffectBudget.summary_json_for_program_with_authority(bundle, facts.summaries, entry_fn.unwrap_or("run"), package_manifest.map(fn((_, manifest)) { manifest })), projection, delegations))
        })
        if effect_view == .Val((entries, fact_registry, _effect_summary, _effect_json, projection, delegations)) {
            application_authority :: apply_native_effect_policy(cmd, file, src, mode, is_plugin, visible_lints, entries, fact_registry, &projection, &package_manifest, delegations, source_snapshot, invocation_authority)
            if checked_runtime == .Val(bundle) && application_authority == .Val(authority) {
                required_effects :: bundle.package_guarantees.application_authority.required_effects.clone()
                applied := authority.clone()
                applied.required_effects = ^required_effects
                bundle.package_guarantees.application_authority = ^applied
            }
            effect_summary :: jet.EffectBudget.render_effect_projection_line(projection)
            if cmd == "build" {
                effect_json :: jet.EffectBudget.render_effect_projection_json(projection)
                if mode.json { build_effect_json = .Val(effect_json.clone()) } else { write_mode_status(mode, effect_summary) }
                recorded_effects = .Val((effect_summary, effect_json))
            }
        }
    }
    if cmd == {
        "build" -> {
            &progress.major("Building", "backend artifacts")
            if is_library {
                library :: library_out ?? {
                    write_mode_diagnostic(mode, jet.Diagnostics.render_ice_report("missing Library codegen output", "", false))
                    exit(ExitCodes.ICE)
                }
                config :: library_config ?? {
                    write_mode_diagnostic(mode, jet.Diagnostics.render_ice_report("missing Library output configuration", "", false))
                    exit(ExitCodes.ICE)
                }
                paths :: build_library(project_root, rust_code, library, config, profile, ffi_link, verbose, mode) ?? {
                    if err == {
                        .GeneratedCode(stderr) -> {
                            write_mode_diagnostic(mode, jet.Diagnostics.render_ice_report("rustc rejected generated Library code", stderr, true))
                            exit(ExitCodes.ICE)
                        }
                        error -> {
                            cli_error("E2105", "couldn't publish the Library output: {error}")
                            exit(ExitCodes.USER_ERROR)
                        }
                    }
                }
                if !mode.quiet && !mode.json {
                    if paths.shared == .Val(shared) -> write_mode_renderable(mode, "built: {shared.display()}\n")
                    if paths.staticlib == .Val(staticlib) -> write_mode_renderable(mode, "built: {staticlib.display()}\n")
                    if paths.header == .Val(header) -> write_mode_renderable(mode, "built: {header.display()}\n")
                    if paths.loadable == .Val(loadable) -> write_mode_renderable(mode, "built: {loadable.display()}\n")
                    loop binding in paths.bindings -> write_mode_renderable(mode, "built: {binding.display()}\n")
                }
                &progress.finish("library artifacts")
                if mode.json -> write_mode_machine(mode, "{build_effect_json.unwrap_or("{\"effects\":[]}")}\n")
                return
            }
            artifact_path :: if is_web || is_plugin { bin_path(project_root, file) } else { build_artifact_path(project_root, file, programmable_build_target) }
            budget_profile :: profile.budget_name()
            hardened_profile :: profile == .Hardened
            build_target_machine(file, rust_code, checked_runtime, artifact_path.clone(), profile, ffi_link, clinks, verbose, cross_target, web_out, plugin_out, mode, native_cache_hit, native_key.clone(), target_machine, cranelift_dev)
            print_release_job_summary(src, release_profile, mode)
            &progress.major("Verifying", "build budgets")
            budget_target :: if is_web { "web" } else if is_plugin { "sandbox" } else { "native" }
            build_gated :: checked_runtime.map(fn(bundle) { CmdBudget.has_build_gates(bundle, budget_target, budget_profile) }).unwrap_or(true)
            if build_gated && CmdBudget.run_build_gates(file, artifact_path, budget_target, budget_profile) != 0 -> exit(ExitCodes.USER_ERROR)
            if build_receipt == .Val(receipt) && native_store == .Val(store) && native_key == .Val(key) && checked_runtime == .Val(bundle) {
                plain :: programmable_build_target.is_none() && clinks.is_empty() && !Driver.selects_build_entry(src, package_manifest.map(fn((root, _)) { root }))
                if plain {
                    if receipt.sealed_inputs(bundle) == .Val(inputs) {
                        facts := [String:String]{}
                        if DevAot.output_identity(artifact_path) == {
                            .Val(identity) -> {
                                &facts.insert("native_key", key.clone())
                                &facts.insert("dev_output", identity)
                            }
                            .None -> {
                                artifact_key :: if cranelift_dev { rustc_fallback_cache_key(key) } else { key.clone() }
                                &facts.insert("native_key", artifact_key)
                                rust :: fs.read(generated_rust_path(artifact_path, file)).unwrap_or([])
                                &facts.insert("rust_sha256", jet.SHA256.sha256_hex(rust))
                            }
                        }
                        if !build_gated -> &facts.insert("build_gates", "none")
                        if recorded_effects == .Val((line, json)) {
                            &facts.insert("effect_line", line.clone())
                            &facts.insert("effect_json", json.clone())
                        }
                        receipt.publish(store, inputs, execution_lints.clone(), facts)
                    }
                }
            }
            if !mode.quiet && !mode.json {
                artifact := if is_web {
                    "{build_output_root(project_root).join("app.wasm").display()} + {build_output_root(project_root).join("app.js").display()}"
                } else if is_plugin {
                    "{build_output_root(project_root).join("{stem(file)}.wasm").display()} (sandbox)"
                } else { artifact_path.display().to_string() }
                if hardened_profile -> artifact = "{artifact} (hardened; foreign dependencies fenced)"
                if progress.enabled { &progress.finish(artifact) } else { write_mode_renderable(mode, "built: {artifact}\n") }
            }
            if explain_partition && !mode.json && web_partition_report == .Val(report) -> write_mode_renderable(mode, "{report}\n")
            if cross_target == .Val(triple) && !mode.quiet && !mode.json -> write_mode_status(mode, "target: {triple}\n")
            if sbom -> write_sbom_for_build(file, artifact_path, mode)
            if mode.json -> write_mode_machine(mode, "{build_effect_json.unwrap_or("{\"effects\":[]}")}\n")
        }
        "run" -> {
            binary :: if is_web || is_plugin { bin_path(project_root, file) } else { build_artifact_path(project_root, file, programmable_build_target) }
            build_target_machine(file, rust_code, checked_runtime, binary.clone(), profile, ffi_link, clinks, verbose, cross_target, web_out, plugin_out, mode, false, native_key.clone(), target_machine, cranelift_dev)
            print_release_job_summary(src, release_profile, mode)
            if cross_target.is_some() {
                write_mode_status(mode, "note: cross-compiled binary cannot run on this host — use emulation (see docs/embedded.md)\n")
                finish_native_run(file, src, mode, record, record_name, production_receipt, [], .Exit(ExitCodes.OK))
            }
            run_cmd := Command.new(binary)
            loop arg in program_args -> &run_cmd.arg(arg)
            status :: &run_cmd.status() ?? finish_native_run(file, src, mode, record, record_name, production_receipt, [], .LaunchError(err.to_string()))
            finish_native_run(file, src, mode, record, record_name, production_receipt, [], .Child(status))
        }
        other -> {
            cli_error("E2101", "`{other}` isn't a {Syntax.BINARY_NAME} command")
            write_mode_diagnostic(mode, usage())
            exit(ExitCodes.USAGE)
        }
    }
}

// Rust: Source/CmdCompile.rs:4893
// User-authored dev() remains the program's ordinary native entry.
pub fn run_dev_entry(file: String, profile: BuildProfile, mode: OutputMode, setting_overrides: [String:String], program_args: [String], record_name: String?) {
    src :: fs.read_to_string(OSPath.new(file)) ?? {
        cli_error_fix("E2105", "can't find the file `{file}`", "check the spelling, or run {Syntax.BINARY_NAME} from the folder that contains it")
        exit(ExitCodes.USER_ERROR)
    }
    project_root :: jet.build_project_root(file) ?? {
        report_problems(mode, file, src, err)
        exit(ExitCodes.USER_ERROR)
    }
    production_receipt :: ProductionReceipt.prepare(file, src, program_args)
    production_receipt.install()
    record :: record_name.map(fn(name) { ProveReplay.begin_named_capture(file, name, profile.budget_name(), setting_overrides, mode.json) ?? exit(err) })
    out :: jet.compile_with_entry_and_settings(file, "dev", profile.budget_name(), setting_overrides) ?? {
        report_problems(mode, file, src, err)
        exit(ExitCodes.USER_ERROR)
    }
    CmdDevTools.render_lints(file, mode, out.lints)
    clinks :: jet.resolve_c_links(file) ?? {
        report_problems(mode, file, src, err)
        exit(ExitCodes.USER_ERROR)
    }
    bin :: bin_path(project_root, file)
    dev_profile_name :: if profile == {
        .Named(name, _) -> .Val(name)
        .Release -> .Val("release")
        .Hardened -> .Val("hardened")
        .Debug -> .Val("debug")
        .Ci -> .Val("ci")
        .Default, .Fast, .Small, .NoOs -> .None
    }
    dev_small_profile :: profile == .Small
    build(file, out.rust, .None, bin.clone(), profile, out.ffi, clinks, false, .None, .None, .None, mode, false, .None)
    dev_file :: fs.canonicalize(OSPath.new(file)).map(fn(path) { path.display().to_string() }).unwrap_or(file)
    jet_bin :: env.current_exe().map(fn(path) { path.display().to_string() }).unwrap_or(Syntax.BINARY_NAME)
    command := Command.new(bin)
    &command.args(program_args)
    &command.env("JET_DEV_FILE", dev_file)
    &command.env("JET_BIN", jet_bin)
    &command.env("JET_PROJECT_ROOT", project_root)
    &command.env("JET_DEV_SETTING_COUNT", setting_overrides.len().to_string())
    if dev_profile_name == .Val(name) { &command.env("JET_DEV_PROFILE", name) } else { &command.env_remove("JET_DEV_PROFILE") }
    if dev_small_profile { &command.env("JET_DEV_SMALL", "1") } else { &command.env_remove("JET_DEV_SMALL") }
    // Rust BTreeMap iteration is lexically sorted, including numbered env keys.
    keys := setting_overrides.keys().collect()
    &keys.sort()
    loop (index, key) in keys.enumerate() {
        &command.env("JET_DEV_SETTING_{index}_KEY", key)
        &command.env("JET_DEV_SETTING_{index}_VALUE", setting_overrides[key])
    }
    status :: &command.status() ?? {
        cli_error("E2105", "couldn't run the built program: {err}")
        exit(ExitCodes.USER_ERROR)
    }
    exit_code :: child_exit_code(status)
    finish_recorded_artifacts(record, record_name, .Val(production_receipt), exit_code, mode)
    exit(exit_code)
}

// Rust: Source/CmdCompile.rs:5036
pub fn run_web_app_dev_entry(file: String, mode: OutputMode, port: U16?, profile: &BuildProfile, setting_overrides: [String:String], record_name: String?, passthrough: [String]) {
    _src :: fs.read_to_string(OSPath.new(file)) ?? {
        cli_error("E2105", "can't find the file `{file}`")
        exit(ExitCodes.USER_ERROR)
    }
    record :: record_name.map(fn(name) { ProveReplay.begin_named_capture(file, name, profile.budget_name(), setting_overrides, mode.json) ?? exit(err) })
    dev_file :: fs.canonicalize(OSPath.new(file)).map(fn(path) { path.display().to_string() }).unwrap_or(file)
    jet_bin :: env.current_exe() ?? {
        cli_error("E2105", "couldn't locate the running Jet executable")
        exit(ExitCodes.USER_ERROR)
    }
    command := Command.new(jet_bin)
    &command.arg("run")
    &command.arg(file)
    if profile == {
        .Default, .Fast -> {}
        .Small -> &command.arg("--small")
        .NoOs -> {}
        _ -> &command.arg("--profile={profile.budget_name()}")
    }
    keys := setting_overrides.keys().collect()
    &keys.sort()
    loop key in keys -> &command.arg("--set={key}={setting_overrides[key]}")
    if !passthrough.is_empty() {
        &command.arg("--")
        &command.args(passthrough)
    }
    &command.env("JET_APP_DEV", "1")
    &command.env("JET_DEV_FILE", dev_file)
    if port == .Val(value) -> &command.env("JET_APP_PORT", value.to_string())
    status :: &command.status() ?? {
        cli_error("E2105", "couldn't run the web app: {err}")
        exit(ExitCodes.USER_ERROR)
    }
    exit_code :: child_exit_code(status)
    finish_recorded_artifacts(record, record_name, .None, exit_code, mode)
    exit(exit_code)
}

