    lints :: CmdDevTools.visible_lints(out.lints)
    visible_lints = lints.clone()
    warning_lints :: package_manifest.map(fn((_, manifest)) { jet.LintPolicy.non_denied(lints, manifest) }).unwrap_or_else(fn() { lints.clone() })
