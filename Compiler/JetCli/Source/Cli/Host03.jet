        compile_mode :: if is_plugin { .Check } else { .Run }
        compile_target :: if is_web { .None } else if is_plugin { .Val(Syntax.TARGET_SANDBOX) } else { cross_target }
        Driver.compile_bundle_path_opts_with_source_closure(file, compile_mode, no_os, gates, is_web, is_plugin, false, false, compile_target, .None, profile.budget_name(), setting_overrides, false, entry_fn, source_closure)
