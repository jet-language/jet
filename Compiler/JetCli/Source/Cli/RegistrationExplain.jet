// Explain.rs explain_fact_row: projections of canonical declarations and
// corpus-truth rows. Syntax/policy/build-writer queries keep their own order.
use jet_foundation.[DiagnosticExplanation, RegistrationFactTarget, REGISTRATION_FACT_ROWS, REGISTRATION_TRUTH_ROWS]

fn jet_cli_registration_fact_explanation(index: Int) -> DiagnosticExplanation Never! {
    row :: REGISTRATION_FACT_ROWS[index]
    target :: if row.target == {
        .Value -> "a value"
        .Scope -> "a scope"
        .Build -> "the build"
    }
    kind :: if row.target == {
        .Value -> "plane"
        .Scope -> "right"
        .Build -> "fact"
    }
    what :: if row.published_by == .Val(prover) -> "the {prover} prover publishes this row; it is read-only and carries no plane algebra." else -> "attaches to {target}."
    why :: if row.safe_direction == "none" -> "this row holds no fact that moves, so it states no safe direction" else -> "facts tighten silently in the `{row.safe_direction}` direction; loosening one is always written"
    fix :: if row.gates.len() == 0 -> "nothing loosens this row; read it and act on what it says" else -> "to loosen it, write one of: {row.gates.join(", ")}"
    DiagnosticExplanation{code: row.name, stage: "registration table", meaning: "`{row.name}` — a registered {kind} on {target}", what: Val(what), why: Val(why), fix: Val(fix), example: None}
}

fn jet_cli_registration_truth_explanation(index: Int) -> DiagnosticExplanation Never! {
    row :: REGISTRATION_TRUTH_ROWS[index]
    DiagnosticExplanation{
        code: row.name,
        stage: "registration table",
        meaning: "`{row.name}` — a truth stated once, in {row.home}",
        what: Val("rendered from there by: {row.renderers.join(", ")}."),
        why: Val("`{row.guard_test}` in {row.guard_file} proves there is no second copy; it {row.guard_proof}"),
        fix: Val("change the meaning in {row.home}; a second copy anywhere else fails the guard"),
        example: None,
    }
}

fn jet_cli_explain_registration(query: String, color: Bool, json: Bool) -> JetCLIPlan? Never! {
    name :: query.trim()
    loop index in 0..<REGISTRATION_FACT_ROWS.len() {
        if REGISTRATION_FACT_ROWS[index].name == name -> return Val(jet_cli_explanation_output(jet_cli_registration_fact_explanation(index), color, json))
    }
    loop index in 0..<REGISTRATION_TRUTH_ROWS.len() {
        row :: REGISTRATION_TRUTH_ROWS[index]
        if row.name == name -> return Val(jet_cli_explanation_output(jet_cli_registration_truth_explanation(index), color, json))
    }
    None
}
