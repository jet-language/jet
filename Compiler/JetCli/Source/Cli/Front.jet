// The `jet` front door (Source/main.rs `main` up to verb dispatch): output
// flags, retired, moved, and grouped routes, help and the greeting, unknown
// commands (E2101) and flags (E2102), then the verbs the Jet driver owns
// (`explain <CODE>`, `check [<file>|<dir>]`, `build <file>`,
// `run [<file>|<dir>]`, `test <file>`, `new <name>`, `doc <file>`, `fmt`,
// and `emit --ast|--mir|--lir|--rust <file>`; a bare or directory target
// resolves the project entry, Entry.jet), and the inspect group
// (Inspect.jet). Every report is the Rust host's exact bytes and exit
// status for the same argv, except `jet emit`'s Jet-only parts: the
// `--ast`/`--mir`/`--lir` tiers, `--fn`, and the E2102 reports for a target
// with no mode flag or with two. A command whose Jet port has not landed yet
// is refused with E2104 instead of guessing its behavior.
use core.files as cli_files
use jet_driver.[
    JetDriverVerbOutput,
    JET_DRIVER_EXIT_USER_ERROR,
    JET_DRIVER_EXIT_USAGE,
    jet_driver_explain_code,
]
use jet_foundation.[
    JET_CLI_COMMANDS,
    JET_CLI_HANDLERS,
    JET_COMPILER_SERVICE_VERB,
    Diagnostic,
    PolicyKey,
    diagnostic_from_registry,
    diagnostic_render_all,
    policy_key_parse,
]
use jet_pkg_model.[WorkspaceDeclarationCache]

enum JetCLIPlan {
    // The command finished: write these bytes and exit with this status.
    Done(output: JetDriverVerbOutput)
    // A command refused before it ran (main.rs `emit_cli_report`): one
    // spanless CLI report and its exit status; `notice` is the stderr status
    // entry resolution wrote before the refusal. `jet_cli_front` prints the
    // report as the `cli` status envelope under `--json`; the host renders it
    // as text.
    Refused(report: Diagnostic, color: Bool, exit_code: Int, notice: String)
    // main.rs `emit_cli_diagnostics`: source-owned reports use the diagnostics
    // channel, not the spanless CLI-usage envelope.
    Diagnostics(file: String, source: String, report: Diagnostic, color: Bool, notice: String)
    // `jet check <file>`: the entry as the user typed it (or as project
    // resolution chose it), its bytes, the output policy, and the
    // `--threads` cap. `project` is the project scope of a bare or directory
    // check (main.rs `check_project_scope`); `notice` is the stderr status
    // entry resolution wrote. The host compiles it and renders the outcome,
    // as machine reports when `json`.
    Check(file: String, source: String, color: Bool, quiet: Bool, threads: Int?, project: Bool, notice: String, json: Bool)
    // `jet build <file>`: the entry and its bytes; `release` compiles under
    // the `release` profile (MIR Release mode, LIR O2), otherwise `dev`;
    // `invocation` holds the `--allow`/`--deny` rows.
    Build(file: String, source: String, color: Bool, release: Bool, threads: Int?, invocation: JetCLIInvocationAuthority?, notice: String)
    // A package build its `fn build(b: Build)` in `file` configures.
    BuildPackage(file: String, color: Bool, release: Bool, threads: Int?, invocation: JetCLIInvocationAuthority?, notice: String)
    // `jet build --target=sandbox <file>` compile the entry
    // module's `pub fn` rows as a WASM Component guest against the frozen
    // `.jet/cache/api` interface, then build the component with rustc
    // wasm32 and `wasm-tools` (Source/CmdCompile.rs `write_plugin_artifacts`).
    BuildSandbox(file: String, source: String, color: Bool, quiet: Bool, threads: Int?, notice: String)
    // `jet run <file>` (or `jet <file>`): build the entry as `jet build`
    // does, then run it with `program_args`. `verbose` (`--verbose`/`-v`
    // before `--`) shows advisory lints.
    // `watch` (`jet dev`): rerun the program whenever a package source changes.
    Run(file: String, source: String, color: Bool, release: Bool, verbose: Bool, threads: Int?, program_args: [String], invocation: JetCLIInvocationAuthority?, notice: String, watch: Bool)
    // `jet test <file>`: compile the checked test harness and run it under
    // `options`; native O0 unless the release profile was selected.
    Test(file: String, source: String, color: Bool, verbose: Bool, threads: Int?, options: JetCLITestOptions)
    // `jet new <name>`: write the project folder (Source/CmdCompile.rs
    // `run_new`); `template` is "" for the print-only starter.
    New(name: String, template: String, annotated: Bool, quiet: Bool, color: Bool)
    // `jet doc <file>` (Source/CmdDoc.rs `run_doc`): `json` prints the
    // `inspect.doc` status, `check` reports undocumented public items.
    Doc(file: String, source: String, color: Bool, json: Bool, check: Bool)
    // `jet emit --ast|--mir|--lir|--rust <file>`: print one tier of the
    // entry (`--rust`: CmdDevTools.rs `run_emit_rust`); `function` is the
    // `--fn` selection of the AST, MIR and LIR tiers.
    Emit(file: String, source: String, color: Bool, json: Bool, tier: String, function: String?)
    // `jet eval <file>` (CmdDevTools.rs `run_eval`): evaluate the entry's
    // `run` and print its value; `pure` (`--pure`) adds the transitive E3401
    // purity walk; `notice` is resolution's stderr.
    Eval(file: String, pure: Bool, color: Bool, json: Bool, notice: String)
    // `jet fill <file>[:line]` (Source/main.rs `"fill"`, Fill.jet): the typed
    // goal report; `target` keeps its optional `:line` suffix.
    Fill(target: String, json: Bool, color: Bool)
    // `jet diff|merge ...` (StructuralMerge.jet): `argv` starts at the command word.
    Structural(argv: [String], command: String, json: Bool)
    // `jet lint --a11y|--complexity <file>`: the accessibility lints or the
    // cognitive-complexity view of the entry (CmdDevTools.rs `run_lint_a11y`,
    // `run_lint_complexity`); `category` is `a11y` or `complexity`, `raw` is
    // the jet argv (`--max=N`), `notice` is resolution's stderr.
    Lint(file: String, source: String, color: Bool, notice: String, category: String, raw: [String], json: Bool)
    // `jet fmt [paths…] [-]` (Source/CmdCompile.rs `run_fmt`).
    Fmt(request: JetCLIFmtRequest)
    // `jet fmt --lang <language>` (CmdCompile.rs `run_external_fmt`): the
    // environment formatter over staged files; `argv` starts at `fmt`.
    FmtLang(argv: [String], color: Bool)
    // Normal diagnostic fixes use the shared edit engine and a held codemod
    // transaction. Memory fixes retain their independent witness consumer.
    Fix(file: String, dry_run: Bool, all: Bool, color: Bool, quiet: Bool, json: Bool, notice: String)
    // An inspect projection over a checked entry (Inspect.jet): the host
    // compiles `job.file`, then projects the checked program.
    Inspect(job: JetCLIInspectJob)
    // An inspect command the host runs (InspectB.jet).
    InspectB(plan: JetCLIInspectBPlan)
    // `jet inspect semindex <file>` (Source/CmdSemIndex.rs `run_semindex`):
    // the host checks the absolute `file` and prints its semantic index.
    Semindex(file: String, color: Bool, json: Bool)
    // `jet find <query> [<entry>]` (Source/CmdSemIndex.rs `run_find`): the
    // host checks `file` (none: the language catalog alone) and searches
    // its semantic symbols for `mode`; `query` is the joined text words.
    Find(file: String?, query: String, mode: JetCLIFindMode, json: Bool)
    // `jet cache status|prune|limit` (CmdStatus.rs `run_cache`): `args` is the
    // raw tail after `cache`, option spellings and order intact.
    Cache(args: [String], json: Bool)
    // `jet remote …` (main.rs `run_remote`): `argv` is the full normalized
    // argv, starting at `remote`.
    Remote(argv: [String], json: Bool, color: Bool)
    // `jet test-compare <corpus.json>` (CmdTest.rs `run_test_compare`): the
    // corpus as typed and the jet-owned argv the receipt identity frames.
    Comparison(target: String, argv: [String], json: Bool)
    // CmdTry uses the actual invocation-owned checked projection and counters.
    // Quiet does not change its output contract; JSON selects its wire report.
    Try(plan_path: String, keep: Bool, json: Bool)
    // `jet self devtools new-ui|check-fixture-paths|reduce|ice-report|bless`
    // (CmdDevTools.rs `run_devtools`): `args` is the raw argv after the tool
    // word; their confirmations are direct bytes under --json/--quiet too.
    Maintenance(action: String, args: [String], color: Bool, json: Bool)
    // `jet self completions <shell> --for <program>` (CmdDevTools.rs
    // `run_completions`): `name` is the program's checked command name; the
    // host opens and reads the program without executing it.
    Completion(shell: String, program: String, name: String)
    // `jet inspect schema status|squash` (CmdSchema.rs `run_schema`) for the
    // project rooted at `root`; `before` is squash's cutoff.
    Schema(action: String, root: String, before: String, color: Bool, json: Bool)
    // `jet explain <policy-key> <file>` and `jet explain marker <file>:<line>
    // <policy-key>` (CmdDevTools.rs `run_explain_policy`/`run_explain_marker`):
    // the policy essay over the authorized load-only query of `file`.
    PolicyExplain(key: PolicyKey, file: String, site: String?, line: U64?, color: Bool, json: Bool)
    // `jet inspect gates` (CmdGates.rs `run`): the load-only gate ledger of
    // `file` with the canonical external writers; `args` is the entry
    // followed by the plane flags, `notice` is resolution's stderr.
    Gates(file: String, args: [String], color: Bool, json: Bool, notice: String)
    // `jet inspect output <file> [<address>]` (CmdInspect.rs `run_output`):
    // the sema-selected Output of the authorized request of `file`.
    Output(file: String, address: String?, color: Bool, json: Bool)
    // `jet __jetpack <op>` (JetpackService.jet): the internal compiler
    // service `jetpack` speaks over stdin/stdout; never in help.
    CompilerService(op: String)
}

// One native `jet fmt` invocation (Source/main.rs `"fmt"` -> `run_fmt`).
struct JetCLIFmtRequest {
    // Explicit file/directory targets; empty formats the project root.
    paths: [String]
    // `-`: format stdin to stdout under the `stdin_path` label.
    stdin_mode: Bool
    stdin_path: String?
    // `--check`/`--dry-run` report instead of writing; `diff` adds unified diffs.
    check: Bool
    diff: Bool
    // `--changed`: only the VCS-changed `.jet` files (git).
    changed: Bool
    // `--explicit-copies`: write `.copy()` at each implicit copy site sema reports.
    explicit_copies: Bool
    simplify: Bool
    color: Bool
    quiet: Bool
    // `--json`: the Rust status envelopes (`--check` clean/dirty/diff, preflight errors).
    json: Bool{false}
}

// The `jet test` options the Jet host carries out (Source/CmdCompile.rs
// `TestRunOpts`). `capture` is `failed`, `all`, or `none`; `status` is the
// stderr status text the Rust host writes before the compile.
struct JetCLITestOptions {
    release: Bool
    capture: String
    filter: String?
    shuffle_seed: String?
    serial: Bool
    trace_tiers: Bool
    update_snapshots: Bool
    project_root: String?
    status: String
}

// Commands that validate their own flags (CLI.rs `owns_flag_vocabulary`).
JET_CLI_OWNS_FLAGS :: [String]{
    "env", "cc", "c++", "remote", "shared-store", "dev", "devtools", "push", "trust", "bridge",
    "services", "image", "new", "flash", "os", "add", "remove", "bind", "lsp", "config", "update",
    "outdated", "search", "info", "import", "explain", "logs", "clean", "fetch", "publish", "yank",
    "keygen", "key", "vendor", "audit", "sbom", "repl", "notebook", "schema", "db", "semindex",
    "impact", "codemod", "generate", "expand", "diff", "merge", "review", "prove", "budget", "perf",
    "completions", "self-update",
}

// Flags whose value is the next argv word (CLI.rs `flag_takes_separate_value`).
JET_CLI_SEPARATE_VALUE_FLAGS :: [String]{
    "-p", "--fixtures", "--env", "--preset", "--set", "--builder", "--output", "--profile",
    "--target", "--endpoint", "--channel", "--platform", "--trust-key", "--gate", "--allow",
    "--deny", "--scope", "--live", "--replay", "--project", "--console-ttl", "--app", "--share",
    "--token", "--base-receipt", "--receipt", "--head-receipt", "--after-receipt", "--canvas-host",
    "--canvas-port", "--canvas-transport", "--canvas-authority", "--where", "--capture",
    "--browser", "--browser-retries", "--browser-reporter", "--filter", "--shuffle", "--verify",
    "--template", "--sort", "--threads", "--fn",
}

// `--name=value` spellings that never become positional words.
JET_CLI_VALUE_PREFIXES :: [String]{
    "--verify=", "--output=", "--where=", "--capture=", "--endpoint=", "--channel=",
    "--platform=", "--trust-key=", "--set=", "--scope=", "--kind=", "--live=", "--replay=",
    "--target=", "--app=", "--share=", "--token=", "--canvas-host=", "--canvas-port=",
    "--canvas-transport=", "--canvas-authority=", "--threads=", "--fn=",
}

// Flags an external formatter accepts with `jet fmt --lang`.
JET_CLI_EXTERNAL_FMT_FLAGS :: [String]{
    "--trust", "--offline", "--online", "--no-color", "--json", "--flake", "--pure", "--yes",
    "--fixtures", "--preset", "--env",
}

// Source/main.rs `cli_diagnostic_copy`: the shared Why line of a CLI code.
fn jet_cli_why(code: String) -> String Never! {
    if code == {
        "E2101" -> return "Jet command groups accept only commands in their named area"
        "E2102" -> return "Jet ignores no flags silently, so a typo cannot quietly change a command"
        "E2104" -> return "Jet needs valid command input before it can run this command"
        "E2105" -> return "Jet could not complete the named file, tool, or operating-system operation"
        else -> {}
    }
    "Jet could not complete this command"
}

// One spanless CLI diagnostic, rendered as the host prints it.
fn jet_cli_report(code: String, what: String, why: String, fix: String, color: Bool) -> String Never! {
    diagnostic_render_all("", "", [Diagnostic]{diagnostic_from_registry(code, None, what, why, fix)}, color)
}

fn jet_cli_done(stdout: String, stderr: String, exit_code: Int) -> JetCLIPlan Never! {
    JetCLIPlan.Done{output: JetDriverVerbOutput{stdout: stdout, stderr: stderr, exit_code: exit_code}}
}

fn jet_cli_diagnostics_output(file: String, source: String, report: Diagnostic, color: Bool, json: Bool, notice: String) -[FS, Env]> JetDriverVerbOutput Never! {
    if json -> return JetDriverVerbOutput{stdout: jet_cli_reports_status_json("diagnostics", false, jet_cli_report_cwd(), file, source, [Diagnostic]{report}), stderr: notice, exit_code: JET_DRIVER_EXIT_USER_ERROR}
    JetDriverVerbOutput{stdout: "", stderr: "{notice}{diagnostic_render_all(file, source, [Diagnostic]{report}, color)}", exit_code: JET_DRIVER_EXIT_USER_ERROR}
}

fn jet_cli_fail(code: String, what: String, why: String, fix: String, color: Bool, exit_code: Int) -> JetCLIPlan Never! {
    JetCLIPlan.Refused{report: diagnostic_from_registry(code, None, what, why, fix), color: color, exit_code: exit_code, notice: ""}
}

// A real `jet` command whose Jet port has not landed: refused, never guessed.
fn jet_cli_not_ported(command: String, color: Bool) -> JetCLIPlan Never! {
    JetCLIPlan.Done{output: jet_cli_not_ported_output(command, color)}
}

// The bytes and status of that refusal, for a host-side projection.
fn jet_cli_not_ported_output(command: String, color: Bool) -> JetDriverVerbOutput Never! {
    JetDriverVerbOutput{
        stdout: "",
        stderr: jet_cli_report("E2104", "`jet {command}` is not part of the Jet-hosted CLI yet", jet_cli_why("E2104"), "run `jet {command}` with the Rust-hosted `jet` until the Jet CLI owns it", color),
        exit_code: JET_DRIVER_EXIT_USAGE,
    }
}

fn jet_cli_prefix(items: [String], end: Int) -> [String] Never! {
    prefix := [String]{}
    loop index in 0..<end -> &prefix.push(items[index])
    prefix
}

fn jet_cli_tail(items: [String], start: Int) -> [String] Never! {
    tail := [String]{}
    loop index in start..<items.len() -> &tail.push(items[index])
    tail
}

fn jet_cli_has(items: [String], value: String) -> Bool Never! {
    items.contains(value)
}

fn jet_cli_is_help_flag(argument: String) -> Bool Never! {
    argument == "--help" || argument == "-h"
}

fn jet_cli_any_help_flag(items: [String]) -> Bool Never! {
    loop item in items {
        if jet_cli_is_help_flag(item) -> return true
    }
    false
}

// Source/main.rs `is_diagnostic_code`: `E1234`, `L1234`, or `JT1234`.
fn jet_cli_is_diagnostic_code(value: String) -> Bool Never! {
    bytes :: value.bytes()
    digits_from := 0
    if {
        bytes.len() == 5 && (bytes[0] == (U8{69}) || bytes[0] == (U8{76})) -> digits_from = 1
        bytes.len() == 6 && bytes[0] == (U8{74}) && bytes[1] == (U8{84}) -> digits_from = 2
        else -> return false
    }
    loop index in digits_from..<bytes.len() {
        digit :: Int.from_u8(bytes[index])
        if digit < 48 || digit > 57 -> return false
    }
    true
}

// Rust `{:?}` of a plain request value.
fn jet_cli_debug_quote(value: String) -> String Never! {
    "\"{value.replace("\\", "\\\\").replace("\"", "\\\"")}\""
}

// The value of `--flag=value` or `--flag value` (Source/main.rs `test_option_value`).
fn jet_cli_option_value(items: [String], flag: String) -> String? Never! {
    loop (index, item) in items {
        if item.starts_with("{flag}=") -> return Val(item.slice(flag.len() + 1..<item.len()))
        if item == flag {
            if index + 1 < items.len() -> return Val(items[index + 1])
            return None
        }
    }
    None
}

// The `jet help --sort` value; "frequency" when no order is asked for.
fn jet_cli_help_order(jet_argv: [String]) -> String Never! {
    asked := false
    loop item in jet_argv {
        if item == "--sort" || item.starts_with("--sort=") -> asked = true
    }
    if !asked -> return "frequency"
    jet_cli_option_value(jet_argv, "--sort") ?? ""
}

// E2104 for a `--sort` value other than frequency, az, or za.
fn jet_cli_bad_help_order(value: String, color: Bool) -> JetCLIPlan Never! {
    jet_cli_fail("E2104", "`{value}` is not a `jet help` order", jet_cli_why("E2104"), "choose one of {JET_CLI_HELP_ORDERS}: `jet help --sort az`", color, JET_DRIVER_EXIT_USAGE)
}

// The jet-owned positional words before `--` (Source/main.rs `args`): flags
// and the values they swallow are dropped; bare `-` stays.
fn jet_cli_positionals(jet_argv: [String]) -> [String] Never! {
    positionals := [String]{}
    skip_next := false
    explain :: jet_argv.len() > 0 && jet_argv[0] == "explain"
    loop argument in jet_argv {
        if skip_next {
            skip_next = false
            next
        }
        if JET_CLI_SEPARATE_VALUE_FLAGS.contains(argument) {
            skip_next = true
            next
        }
        prefixed := false
        loop prefix in JET_CLI_VALUE_PREFIXES {
            if argument.starts_with(prefix) -> prefixed = true
        }
        if prefixed -> next
        // `jet explain ->`: a syntax token that starts with `-` stays a query.
        explain_token :: explain && argument.starts_with("-") && !argument.starts_with("--") && argument != "-"
        if argument == "-" || !argument.starts_with("-") || explain_token -> &positionals.push(argument)
    }
    positionals
}

// Source/main.rs `check_flags`: the first unknown `--flag` teaches E2102.
fn jet_cli_check_flags(jet_argv: [String], command: String, color: Bool) -> JetCLIPlan? Never! {
    external_fmt := false
    if command == "fmt" {
        loop argument in jet_argv {
            if argument == "--lang" || argument.starts_with("--lang=") -> external_fmt = true
        }
    }
    loop argument in jet_argv {
        if !argument.starts_with("--") || argument == "--" -> next
        if jet_cli_is_known_flag(argument) -> next
        head :: argument.split("=").to_list()[0]
        if external_fmt && JET_CLI_EXTERNAL_FMT_FLAGS.contains(head) -> next
        if head == "--emit-rust" {
            return Val(jet_cli_fail("E2102", "`--emit-rust` isn't a flag jet understands", "generated output belongs to the `emit` command", "run `jet emit --rust <file.jet>`", color, JET_DRIVER_EXIT_USAGE))
        }
        program :: command == "run" || command == "test"
        fix := ""
        if jet_cli_closest_flag(head) == .Val(close) {
            if {
                program -> fix = "did you mean `{close}`? Or use `jet {command} <file> -- {head}` to pass it to your program"
                command == "jobs" -> fix = "did you mean `{close}`? Or write it after the job name, `jet {command} <name> {head}`, to pass it to the job"
                else -> fix = "did you mean `{close}`? (run `jet help` for the flags)"
            }
        } else {
            if {
                program -> fix = "use `jet {command} <file> -- {head}` to pass this flag to your program"
                command == "jobs" -> fix = "write it after the job name, `jet {command} <name> {head}`, to pass it to the job"
                else -> fix = "drop the flag, or run `jet help` to see the flags"
            }
        }
        return Val(jet_cli_fail(
            "E2102",
            "`{head}` isn't a flag jet understands",
            "flags before `--` belong to jet; everything after `--` is forwarded to your program",
            fix,
            color,
            JET_DRIVER_EXIT_USAGE,
        ))
    }
    None
}

// The directory part of `path`, as Rust `Path::parent` reads it.
fn jet_cli_parent(path: String) -> String? Never! {
    parts :: path.split("/").to_list()
    if parts.len() <= 1 -> return None
    parent :: jet_cli_prefix(parts, parts.len() - 1).join("/")
    if parent == "" -> return Val("/")
    Val(parent)
}

// Is there a `package.jet` in `directory` or above it?
fn jet_cli_has_manifest_above(directory: String) -[FS]> Bool Never! {
    current := directory
    loop {
        if cli_files.is_file("{current}/package.jet") -> return true
        current = jet_cli_parent(current) ?? return false
        if current == "/" -> return cli_files.is_file("/package.jet")
    }
}

// The nearest directory at or above `directory` with a `package.jet`.
fn jet_cli_manifest_root(directory: String) -[FS]> String? Never! {
    current := directory
    loop {
        if cli_files.is_file("{current}/package.jet") -> return Val(current)
        current = jet_cli_parent(current) ?? return None
        if current == "/" {
            if cli_files.is_file("/package.jet") -> return Val("/")
            return None
        }
    }
}

// CmdMemory.rs / CmdGc.rs `project_root`: the working directory's selected
// project root (ProjectRoot.jet), else the working directory itself.
fn jet_cli_selected_root_or_cwd() -[FS, Env]> String Never! {
    cwd :: cli_files.cwd() ?? "."
    cache := WorkspaceDeclarationCache.new()
    jet_cli_selected_project_root(&cache, cwd) ?? cwd
}

// Source/main.rs `"gc"`: `gc report` (CmdGc.rs `run`) is the only subcommand.
fn jet_cli_gc(argv: [String], args: [String], color: Bool, json: Bool) -[FS, Env, Time, Time.Wait]> JetCLIPlan Never! {
    if args.len() < 2 {
        return jet_cli_fail("E2101", "`jet gc` needs a subcommand", "`jet gc report` prints the automatic-promotion report; `jet clean` cleans the package store", "run `jet gc report`", color, JET_DRIVER_EXIT_USAGE)
    }
    if args[1] != "report" {
        return jet_cli_fail("E2101", "`{args[1]}` isn't a jet gc command", "jet gc currently exposes only the automatic-promotion report", "run `jet gc report`", color, JET_DRIVER_EXIT_USAGE)
    }
    jet_cli_gc_report_at(jet_cli_selected_root_or_cwd(), jet_cli_tail(argv, 2), color, json)
}

// Source/CmdStatus.rs `run_status`: the one target (by default the stock
// project entry, relative to the working directory) read against the
// receipt root `jet prove <target>` selects (ReceiptStore.rs
// `receipt_root_for` / `target_path`).
fn jet_cli_status(status_args: [String], color: Bool, json: Bool) -[FS, Env, Time.Wait]> JetCLIPlan Never! {
    cwd :: cli_files.cwd() ?? "."
    explicit := String?{None}
    if jet_cli_project_status_target(status_args) == {
        .Ok(found) -> explicit = found
        .Err(message) -> return jet_cli_fail("E2102", message.message, "jet status accepts one project target and registered output flags", "run `jet status [<file.jet|dir>]` with one target", color, JET_DRIVER_EXIT_USAGE)
    }
    notices := [String]{}
    target := explicit ?? ""
    if explicit == None {
        root :: jet_cli_manifest_root(cwd) ?? cwd
        entry := ""
        found_entry :: jet_cli_find_project_entry(root, "status", color, &notices)
        if found_entry == {
            .Entry(found) -> entry = found.path
            .Refused(plan) -> return jet_cli_with_notices(notices, ^plan)
            .Absent -> entry = jet_cli_entry_join(cli_files.realpath(root) ?? root, JET_CLI_DEFAULT_ENTRY_FILE)
        }
        prefix :: if cwd.ends_with("/") -> cwd else -> "{cwd}/"
        target = if entry == cwd -> "" else if entry.starts_with(prefix) -> entry.slice(prefix.len()..<entry.len()) else -> entry
    }
    candidate :: if target.starts_with("/") -> target else -> jet_cli_entry_join(cwd, target)
    start := cwd
    if cli_files.exists(candidate) || candidate.ends_with(".jet") {
        start = candidate
    } else if cli_files.is_file("{candidate}.jet") {
        start = "{candidate}.jet"
    }
    if !cli_files.is_dir(start) -> start = jet_cli_parent(start) ?? start
    cache := WorkspaceDeclarationCache.new()
    root :: jet_cli_receipt_project_root(&cache, start)
    jet_cli_with_notices(notices, jet_cli_project_status_at(root, cwd, target, json))
}

// `jet <word>` sugar for `jet run <word>` (Source/main.rs `looks_like_jet_source`).
fn jet_cli_looks_like_source(argument: String) -[FS]> Bool Never! {
    if argument.ends_with(".jet") -> return true
    if cli_files.exists(argument) -> return cli_files.is_file(argument) || cli_files.is_dir(argument)
    cli_files.exists("{argument}.jet")
}

// The commands that compile, and so take `--threads N`.
JET_CLI_THREADS_COMMANDS :: [String]{"build", "run", "check", "test", "dev", "inspect"}

// `--threads N` (or `--threads=N`) before `--`: `None` when absent, else the
// cap, or the usage error that names the flag.
// `--jobs` and `-j`, the spelling other build tools use, are refused on the
// compiling commands with a pointer to `--threads`; `jet jobs` is unchanged.
fn jet_cli_threads(jet_argv: [String], command: String, color: Bool) -> JetCLIThreads Never! {
    compiling :: JET_CLI_THREADS_COMMANDS.contains(command)
    loop (index, argument) in jet_argv {
        jobs_flag :: argument == "--jobs" || argument.starts_with("--jobs=") || argument == "-j" || (argument.starts_with("-j") && argument.len() > 2)
        if compiling && jobs_flag {
            return JetCLIThreads.Refused{plan: jet_cli_fail("E2102", "`{argument.split("=").to_list()[0]}` isn't a flag jet understands", "`jet jobs` runs your project's named jobs; the compiler's thread cap is `--threads`", "write `--threads N` to cap the compiler at N threads", color, JET_DRIVER_EXIT_USAGE)}
        }
        value := String?{None}
        if argument.starts_with("--threads=") -> value = Val(argument.slice(10..<argument.len()))
        if argument == "--threads" -> value = Val(if index + 1 < jet_argv.len() -> jet_argv[index + 1] else -> "")
        text :: value ?? next
        if !compiling {
            return JetCLIThreads.Refused{plan: jet_cli_fail("E2102", "`--threads` is only valid with a command that compiles", jet_cli_why("E2102"), "use it with `jet build`, `run`, `check`, `test`, `dev`, or `inspect`", color, JET_DRIVER_EXIT_USAGE)}
        }
        count :: Int.parse(text) ?? 0
        if count < 1 {
            return JetCLIThreads.Refused{plan: jet_cli_fail("E2104", "`--threads` needs a whole number of compiler threads, at least 1, not `{text}`", jet_cli_why("E2104"), "write `--threads 1` for one compiler thread, or leave the flag out to let jet choose", color, JET_DRIVER_EXIT_USAGE)}
        }
        return JetCLIThreads.Cap{threads: Val(count)}
    }
    JetCLIThreads.Cap{threads: None}
}

enum JetCLIThreads {
    Cap(threads: Int?)
    Refused(plan: JetCLIPlan)
}

// The commands `--trace[=FILE]` streams the compiler's trace for.
JET_CLI_TRACE_COMMANDS :: [String]{"build", "run", "check", "test", "emit"}

// The trace target `--trace` (`-`: readable lines on stderr) or
// `--trace=FILE` (the JET_TRACE_FILE trace file) names in the jet-owned
// argv; `None` without the flag. The host opens it (Request.jet
// `jet_cli_trace_sink`), the front door checks where it may appear.
fn jet_cli_trace_flag(jet_argv: [String]) -> String? Never! {
    loop argument in jet_argv {
        if argument == "--trace" -> return Val("-")
        if argument.starts_with("--trace=") -> return Val(argument.slice(8..<argument.len()))
    }
    None
}

// The usage error of a misplaced or empty `--trace`, or `None`.
fn jet_cli_trace_refusal(jet_argv: [String], command: String, color: Bool) -> JetCLIPlan? Never! {
    requested :: jet_cli_trace_flag(jet_argv) ?? return None
    if !JET_CLI_TRACE_COMMANDS.contains(command) {
        return Val(jet_cli_fail("E2102", "`--trace` is only valid with a command that compiles", jet_cli_why("E2102"), "use it with `jet build`, `run`, `check`, `test`, or `emit`", color, JET_DRIVER_EXIT_USAGE))
    }
    if requested == "" {
        return Val(jet_cli_fail("E2104", "`--trace=` needs a file name", jet_cli_why("E2104"), "write `--trace` to stream the trace to stderr, or `--trace=FILE` to write it to FILE", color, JET_DRIVER_EXIT_USAGE))
    }
    None
}

// `jet check [<file>|<dir>]`, also the target step of `build`, `run`, and
// `doc` (Source/main.rs bare dispatch and `resolve_command_target`). A bare
// command, or one aimed at a directory, resolves the project entry
// (Entry.jet) and checks it in project scope; a file target
// is read as the user typed it (or with `.jet` appended). A bare or
// directory `build` is not ported yet. `--show-default` reports the stock
// default, and `-p <member>` picks a workspace member. `json` carries
// `--json` to the check outcome.
fn jet_cli_check(jet_argv: [String], args: [String], command: String, color: Bool, quiet: Bool, threads: Int?, json: Bool) -[FS, Env]> JetCLIPlan Never! {
    show_default :: jet_argv.contains("--show-default")
    member_flag :: jet_cli_option_value(jet_argv, "-p")
    status :: if show_default && !quiet -> "jet {command}: using stock default\n" else -> ""
    if args.len() < 2 {
        directory :: cli_files.cwd() ?? "."
        if command == "build" {
            return jet_cli_fail("E2104", "no file given and no `package.jet` found in this directory or above", jet_cli_why("E2104"), "run `jet {command} <file.jet>` or cd into a project", color, JET_DRIVER_EXIT_USAGE)
        }
        notices := [String]{}
        resolved :: jet_cli_resolve_bare_entry(command, directory, member_flag, !show_default, color, &notices)
        if resolved == {
            .Entry(entry) -> return jet_cli_read_entry(entry.path, command, color, quiet, threads, command == "check", "{notices.join("")}{status}", json)
            .Refused(plan) -> return jet_cli_with_notices(notices, ^plan)
            .Absent -> return jet_cli_with_notices(notices, jet_cli_missing_bare_entry(command, directory, color))
        }
    }
    target :: args[1]
    if cli_files.is_dir(target) {
        if jet_cli_resolve_directory_target(command, target, member_flag, !show_default, color) == {
            .File(path, _, notice) -> return jet_cli_read_entry(path, command, color, quiet, threads, command == "check", "{notice}{status}", json)
            .Refused(plan) -> return plan
        }
    }
    file := target
    if !cli_files.is_file(target) && cli_files.is_file("{target}.jet") -> file = "{target}.jet"
    jet_cli_read_entry(file, command, color, quiet, threads, false, status, json)
}

// Read the entry `jet_cli_check` chose (CmdCompile.rs `run_native_execution`
// source read): an unreadable stock `run.jet` inside a project teaches how
// to create it; any other unreadable file is E2105. `notice` precedes the
// report on stderr; `json` carries `--json` to the check outcome.
fn jet_cli_read_entry(file: String, command: String, color: Bool, quiet: Bool, threads: Int?, project: Bool, notice: String, json: Bool) -[FS, Env]> JetCLIPlan Never! {
    source :: cli_files.read(file) ?? {
        parent :: jet_cli_parent(file) ?? "."
        default_entry :: file == "run.jet" || file.ends_with("/run.jet")
        fix :: if default_entry && jet_cli_has_manifest_above(parent) -> "create `run.jet` in the project, or run `jet {command} <file.jet>`" else -> "check the spelling, or run jet from the folder that contains it"
        return jet_cli_done("", "{notice}{jet_cli_report("E2105", "can't securely read the file `{file}`", jet_cli_why("E2105"), fix, color)}", JET_DRIVER_EXIT_USER_ERROR)
    }
    JetCLIPlan.Check{file: file, source: source, color: color, quiet: quiet, threads: threads, project: project, notice: notice, json: json}
}

// `jet doc [<file>]`: the entry resolves as `jet check` resolves it.
fn jet_cli_doc(jet_argv: [String], args: [String], color: Bool, quiet: Bool, json: Bool, check: Bool) -[FS, Env]> JetCLIPlan Never! {
    entry :: jet_cli_check(jet_argv, args, "doc", color, quiet, None, json)
    if entry == {
        .Check(file, source, _, _, _, _, _, _) -> return JetCLIPlan.Doc{file: file, source: source, color: color, json: json, check: check}
        else -> {}
    }
    entry
}

// Build flags whose Jet port has not landed: refused, never ignored.
JET_CLI_BUILD_UNPORTED_FLAGS :: [String]{
    "--lib", "--small", "--verify", "--sbom", "--import", "--emit-generated", "--set",
    "--builder", "--locked", "-p", "--output", "--gate",
}

// The one `--target` value the Jet host builds (jetpack_config.rs
// `TARGET_SANDBOX`); every other machine or triple is refused until ported.
JET_CLI_TARGET_SANDBOX :: "sandbox"

enum JetCLITargetFlag {
    Absent
    // `--target` with no value, or with a flag where the value belongs.
    Missing
    Named(name: String)
}

// Source/main.rs `parse_target_flag`: `--target=<v>` or `--target <v>`.
fn jet_cli_target_flag(jet_argv: [String]) -> JetCLITargetFlag Never! {
    loop (index, argument) in jet_argv {
        if argument.starts_with("--target=") {
            value :: argument.slice(9..<argument.len())
            if value == "" -> return JetCLITargetFlag.Missing
            return JetCLITargetFlag.Named{name: value}
        }
        if argument == "--target" {
            if index + 1 >= jet_argv.len() || jet_argv[index + 1].starts_with("-") -> return JetCLITargetFlag.Missing
            return JetCLITargetFlag.Named{name: jet_argv[index + 1]}
        }
    }
    JetCLITargetFlag.Absent
}

enum JetCLIProfile {
    // `release` selects the `release` profile: MIR Release mode and LIR O2.
    Selected(release: Bool)
    Refused(plan: JetCLIPlan)
}

// `--release` (or `--profile release`) compiles under the `release` profile
// (Rust CmdCompile `select_native_profile`); the default and `--profile debug`
// compile under `dev`. Other profiles are not ported yet.
fn jet_cli_profile(jet_argv: [String], command: String, color: Bool) -> JetCLIProfile Never! {
    release := jet_argv.contains("--release")
    loop (index, argument) in jet_argv {
        if argument.split("=").to_list()[0] != "--profile" -> next
        profile := ""
        if {
            argument.starts_with("--profile=") -> profile = argument.slice(10..<argument.len())
            index + 1 < jet_argv.len() -> profile = jet_argv[index + 1]
            else -> {}
        }
        if {
            profile == "release" -> release = true
            profile == "debug" -> {}
            else -> return JetCLIProfile.Refused{plan: jet_cli_not_ported("{command} --profile {profile}", color)}
        }
    }
    JetCLIProfile.Selected{release: release}
}

enum JetCLIAuthorityFlags {
    // The invocation rows (`None` when neither flag is given).
    Rows(invocation: JetCLIInvocationAuthority?)
    Refused(plan: JetCLIPlan)
}

// Source/main.rs `parse_authority_flags`: the `--allow`/`--deny` rows of a
// build or run, canonical and deduplicated; a right both allowed and denied
// is E2102.
fn jet_cli_authority_flags(jet_argv: [String], color: Bool) -> JetCLIAuthorityFlags Never! {
    allow := [String]{}
    deny := [String]{}
    index := 0
    loop index < jet_argv.len() {
        argument :: jet_argv[index]
        kind := ""
        inline := String?{None}
        if {
            argument.starts_with("--allow=") -> {
                kind = "allow"
                inline = Val(argument.slice(8..<argument.len()))
            }
            argument.starts_with("--deny=") -> {
                kind = "deny"
                inline = Val(argument.slice(7..<argument.len()))
            }
            argument == "--allow" -> kind = "allow"
            argument == "--deny" -> kind = "deny"
            else -> {}
        }
        if kind == "" {
            index += 1
            next
        }
        value := ""
        if inline == .Val(text) {
            value = text
        } else {
            if index + 1 >= jet_argv.len() || jet_argv[index + 1].starts_with("-") {
                return JetCLIAuthorityFlags.Refused{plan: jet_cli_fail("E2104", "`--{kind}` needs a comma-separated rights value", "authority is read before the program's own arguments", "use `--{kind}=FS.Read,Time`", color, JET_DRIVER_EXIT_USAGE)}
            }
            index += 1
            value = jet_argv[index]
        }
        if value.trim() == "" -> return JetCLIAuthorityFlags.Refused{plan: jet_cli_fail("E2104", "`--{kind}` needs a non-empty rights value", "authority names one or more effect roots or leaves", "use `--{kind}=FS.Read,Time`", color, JET_DRIVER_EXIT_USAGE)}
        loop raw in value.split(",") {
            right :: raw.trim()
            canonical :: jet_cli_parse_right(right) ?? return JetCLIAuthorityFlags.Refused{plan: jet_cli_fail("E2104", "unknown authority right `{right}`", "authority names match the canonical effect roots and leaves", "use `--{kind}=FS.Read,Time`", color, JET_DRIVER_EXIT_USAGE)}
            if kind == "allow" {
                if !allow.contains(canonical) -> &allow.push(canonical)
            } else {
                if !deny.contains(canonical) -> &deny.push(canonical)
            }
        }
        index += 1
    }
    loop right in allow {
        if deny.contains(right) -> return JetCLIAuthorityFlags.Refused{plan: jet_cli_fail("E2102", "authority right `{right}` is both allowed and denied", "the same exact effective right cannot be granted and denied in one invocation", "remove one of `--allow={right}` or `--deny={right}`", color, JET_DRIVER_EXIT_USAGE)}
    }
    if allow.len() == 0 && deny.len() == 0 -> return JetCLIAuthorityFlags.Rows{invocation: None}
    JetCLIAuthorityFlags.Rows{invocation: Val(JetCLIInvocationAuthority{allow: allow, deny: deny})}
}

// `jet build <file>` through the backend `jet_cli_profile` selects, or as a
// sandbox WASM Component under `--target=sandbox`. The flags above and the
// other `--target` machines are not ported yet.
fn jet_cli_build(jet_argv: [String], args: [String], color: Bool, quiet: Bool, threads: Int?) -[FS, Env]> JetCLIPlan Never! {
    loop argument in jet_argv {
        head :: argument.split("=").to_list()[0]
        if JET_CLI_BUILD_UNPORTED_FLAGS.contains(head) -> return jet_cli_not_ported("build {head}", color)
    }
    invocation := JetCLIInvocationAuthority?{None}
    if jet_cli_authority_flags(jet_argv, color) == {
        .Refused(refusal) -> return refusal
        .Rows(rows) -> invocation = rows
    }
    release := false
    if jet_cli_profile(jet_argv, "build", color) == {
        .Refused(refusal) -> return refusal
        .Selected(selected) -> release = selected
    }
    sandbox := false
    if jet_cli_target_flag(jet_argv) == {
        .Absent -> {}
        .Missing -> return jet_cli_fail("E2104", "`--target` needs a value", jet_cli_why("E2104"), "write `--target=<triple>` or `--target <triple>` before the source file", color, JET_DRIVER_EXIT_USAGE)
        .Named(name) -> {
            if name != JET_CLI_TARGET_SANDBOX -> return jet_cli_not_ported("build --target={name}", color)
            sandbox = true
        }
    }
    // A package (no file given, or a directory): its `fn build(b: Build)` when it declares one,
    // otherwise the stock build of its run entry.
    if !sandbox && (args.len() < 2 || cli_files.is_dir(args[1])) {
        directory :: if args.len() < 2 -> cli_files.cwd() ?? "." else -> args[1]
        // The directory's own `fn build` is its build entry, also for a workspace root whose
        // members are runnable (`jet build Compiler/`).
        if !jet_argv.contains("--show-default") && jet_cli_option_value(jet_argv, "-p") == None {
            if jet_cli_command_override(directory, "build", color) == {
                .Entry(found) -> return JetCLIPlan.BuildPackage{file: found.path, color: color, release: release, threads: threads, invocation: invocation, notice: ""}
                .Refused(plan) -> return ^plan
                .Absent -> {}
            }
        }
        notices := [String]{}
        resolved :: jet_cli_resolve_bare_entry("build", directory, jet_cli_option_value(jet_argv, "-p"), !jet_argv.contains("--show-default"), color, &notices)
        if resolved == {
            .Entry(found) -> {
                if (found.callable ?? "") == "build" -> return JetCLIPlan.BuildPackage{file: found.path, color: color, release: release, threads: threads, invocation: invocation, notice: notices.join("")}
                planned :: jet_cli_read_entry(found.path, "build", color, quiet, threads, false, notices.join(""), false)
                if planned == .Check(file, source, _, _, _, _, notice, _) -> return JetCLIPlan.Build{file: file, source: source, color: color, release: release, threads: threads, invocation: invocation, notice: notice}
                return planned
            }
            .Refused(plan) -> return jet_cli_with_notices(notices, ^plan)
            .Absent -> return jet_cli_with_notices(notices, jet_cli_missing_bare_entry("build", directory, color))
        }
    }
    entry :: jet_cli_check(jet_argv, args, "build", color, quiet, threads, false)
    if entry == {
        .Check(file, source, _, _, _, _, notice, _) -> {
            if sandbox -> return JetCLIPlan.BuildSandbox{file: file, source: source, color: color, quiet: quiet, threads: threads, notice: notice}
            return JetCLIPlan.Build{file: file, source: source, color: color, release: release, threads: threads, invocation: invocation, notice: notice}
        }
        else -> {}
    }
    entry
}

// The jet flags `jet run` honors. Any other registered flag on a run is
// refused until its port lands, never ignored; an unregistered one was
// already refused by E2102, or is ignored by the `jet <file>` shorthand as
// the Rust host ignores it.
JET_CLI_RUN_PORTED_FLAGS :: [String]{"--release", "--profile", "--verbose", "-v", "--quiet", "--color", "--threads", "--trace", "--allow", "--deny", "-p", "--show-default"}

// `jet run [<file>]` (`args` = `run`, the target, then the positional
// words), also the `jet <file>` shorthand (`shorthand`). The target resolves
// as `jet check` resolves it (Source/main.rs `resolve_command_target`). The
// program's arguments are the words after the first standalone `--`
// (`passthrough`), or else the positional words after the target.
fn jet_cli_run(jet_argv: [String], args: [String], passthrough: [String]?, shorthand: Bool, color: Bool, quiet: Bool, verbose: Bool, threads: Int?) -[FS, Env]> JetCLIPlan Never! {
    loop argument in jet_argv {
        if !argument.starts_with("-") || argument == "-" -> next
        head :: argument.split("=").to_list()[0]
        if JET_CLI_RUN_PORTED_FLAGS.contains(head) || !jet_cli_is_known_flag(head) -> next
        return jet_cli_not_ported("run {head}", color)
    }
    // Source/main.rs `dispatch_nixpkgs_run`: `jet run <package>@nixpkgs`.
    if !shorthand && args.len() > 1 {
        parts :: args[1].split("@").to_list()
        if parts.len() > 1 && parts[parts.len() - 1] == "nixpkgs" && args[1] != "@nixpkgs" -> return jet_cli_not_ported("run <package>@nixpkgs", color)
    }
    invocation := JetCLIInvocationAuthority?{None}
    if jet_cli_authority_flags(jet_argv, color) == {
        .Refused(refusal) -> return refusal
        .Rows(rows) -> invocation = rows
    }
    release := false
    if jet_cli_profile(jet_argv, "run", color) == {
        .Refused(refusal) -> return refusal
        .Selected(selected) -> release = selected
    }
    entry :: jet_cli_check(jet_argv, args, "run", color, quiet, threads, false)
    if entry == {
        .Check(file, source, _, _, _, _, notice, _) -> {
            program_args :: passthrough ?? jet_cli_tail(args, 2)
            return JetCLIPlan.Run{file: file, source: source, color: color, release: release, verbose: verbose, threads: threads, program_args: program_args, invocation: invocation, notice: notice, watch: false}
        }
        else -> {}
    }
    entry
}

// `jet test` flags whose Jet port has not landed: refused, never ignored.
JET_CLI_TEST_UNPORTED_FLAGS :: [String]{
    "--watch", "--docs", "--where", "--coverage", "--grade", "--iterations", "--time", "--seed",
    "--corpus", "--measure", "--record", "--browser", "--browser-retries", "--browser-reporter",
    "--browser-ui", "--browser-visual", "--browser-trace", "--browser-scaffold", "--set",
}

// Source/CmdCompile.rs `invalid_test_run_option`.
fn jet_cli_test_option_error(what: String, color: Bool) -> JetCLIPlan Never! {
    jet_cli_fail("E2104", what, jet_cli_why("E2104"), "use the canonical `jet test` flag spelling", color, JET_DRIVER_EXIT_USAGE)
}

// Source/Doctest.rs `discover` is non-empty: a ```` ```jet ```` (or bare
// ```` ``` ````) fence opened and closed inside one `///` comment run.
fn jet_cli_has_doctests(source: String) -> Bool Never! {
    lines :: source.split("\n").to_list()
    index := 0
    loop index < lines.len() {
        trimmed :: lines[index].trim()
        if trimmed.starts_with("///") {
            inner :: trimmed.slice(3..<trimmed.len()).trim()
            if inner.starts_with("```") {
                language :: inner.replace("`", "").trim()
                if language == "" || jet_cli_ascii_lower(language) == "jet" {
                    index += 1
                    loop index < lines.len() {
                        line :: lines[index].trim()
                        if !line.starts_with("///") -> break
                        if line.slice(3..<line.len()).trim().starts_with("```") -> return true
                        index += 1
                    }
                    next
                }
            }
        }
        index += 1
    }
    false
}

// `jet test [<target>] [<filter>]` (Source/CmdCompile.rs `TestRunOpts::parse`,
// `run_test_opts`, `run_test_target` up to the compile). A package directory
// (or no target inside a package) tests through its own `fn test(t: Test)` when
// it declares one, as `jet build` runs its `fn build`. Doctests, the result
// cache, and the flags above are not ported yet.
fn jet_cli_test(jet_argv: [String], color: Bool, quiet: Bool, verbose: Bool, threads: Int?) -[FS, Env]> JetCLIPlan Never! {
    options := JetCLITestOptions{release: false, capture: "failed", filter: None, shuffle_seed: None, serial: false, trace_tiers: false, update_snapshots: false, project_root: None, status: ""}
    fresh := false
    show_default := false
    positionals := [String]{}
    index := 0
    loop index < jet_argv.len() {
        argument :: jet_argv[index]
        if index == 0 && argument == "test" {
            index += 1
            next
        }
        if argument == "--" -> break
        name :: argument.split("=").to_list()[0]
        inline := String?{None}
        if name.len() < argument.len() -> inline = Val(argument.slice(name.len() + 1..<argument.len()))
        value := ""
        if name == "--capture" || name == "--filter" || name == "--profile" || ((name == "--threads" || name == "--color") && inline == None) {
            if inline == .Val(text) {
                value = text
            } else {
                if index + 1 >= jet_argv.len() -> return jet_cli_test_option_error("`{name}` needs a value", color)
                index += 1
                value = jet_argv[index]
            }
        }
        if {
            JET_CLI_TEST_UNPORTED_FLAGS.contains(name) -> return jet_cli_not_ported("test {name}", color)
            name == "--show-default" -> show_default = true
            name == "--fresh" -> fresh = true
            name == "--update-snapshots" || name == "-u" -> options.update_snapshots = true
            name == "--release" -> {}
            name == "--trace-tiers" -> options.trace_tiers = true
            name == "--serial" -> options.serial = true
            name == "--capture" -> {
                policy :: jet_cli_ascii_lower(value.trim())
                if {
                    policy == "failed" || policy == "failure" || policy == "failures" -> options.capture = "failed"
                    policy == "all" -> options.capture = "all"
                    policy == "none" || policy == "off" -> options.capture = "none"
                    else -> return jet_cli_fail("E2104", "invalid --capture value `{value}` (expected failed, all, or none)", jet_cli_why("E2104"), "correct the named argument or input, then run the command again", color, JET_DRIVER_EXIT_USER_ERROR)
                }
            }
            name == "--filter" -> {
                if options.filter == .Val(previous) {
                    if previous != value -> return jet_cli_test_option_error("conflicting test filters `{previous}` and `{value}`", color)
                } else {
                    options.filter = Val(value)
                }
            }
            name == "--shuffle" -> {
                // A bare `--shuffle` seeds from the clock, which the Jet host
                // does not read yet.
                text :: inline ?? return jet_cli_not_ported("test --shuffle", color)
                seed :: Int.parse(text) ?? return jet_cli_test_option_error("`--shuffle={text}` isn't a number", color)
                if seed < 0 -> return jet_cli_test_option_error("`--shuffle={text}` isn't a number", color)
                options.shuffle_seed = Val("{seed}")
            }
            argument.starts_with("-") -> {}
            else -> &positionals.push(argument)
        }
        index += 1
    }
    if positionals.len() > 2 -> return jet_cli_test_option_error("`jet test` accepts one target and one positional filter, got {positionals.len()} positionals", color)
    if positionals.len() == 2 {
        filter :: positionals[1]
        if options.filter == .Val(previous) {
            if previous != filter -> return jet_cli_test_option_error("conflicting test filters `{previous}` and `{filter}`", color)
        } else {
            options.filter = Val(filter)
        }
    }
    // `--profile` accepts debug and release, as `run` does.
    if jet_cli_profile(jet_argv, "test", color) == {
        .Refused(refusal) -> return refusal
        .Selected(release) -> options.release = release
    }
    if show_default && !quiet -> options.status = "jet test: using stock default\n"
    // A bare `jet test` or `jet test <dir>` tests the package: the directory's own
    // `fn test(t: Test)` file when it declares one (also for a workspace root), otherwise
    // its stock entry. The entry file loads the whole package, and the harness collects
    // every #Test of every package file.
    if positionals.len() == 0 || cli_files.is_dir(positionals[0]) {
        directory :: if positionals.len() == 0 -> cli_files.cwd() ?? "." else -> positionals[0]
        if positionals.len() == 0 && !jet_cli_has_manifest_above(directory) {
            return jet_cli_fail("E2104", "no file given and no `package.jet` found in this directory or above", jet_cli_why("E2104"), "run `jet test <file.jet>` or cd into a project", color, JET_DRIVER_EXIT_USAGE)
        }
        if !show_default {
            if jet_cli_command_override(directory, "test", color) == {
                .Entry(found) -> return jet_cli_test_file(found.path, color, verbose, threads, options, fresh, quiet)
                .Refused(plan) -> return ^plan
                .Absent -> {}
            }
        }
        if positionals.len() == 0 {
            notices := [String]{}
            if jet_cli_resolve_bare_entry("test", directory, None, !show_default, color, &notices) == {
                .Entry(entry) -> return jet_cli_test_file(entry.path, color, verbose, threads, options, fresh, quiet)
                .Refused(plan) -> return jet_cli_with_notices(notices, ^plan)
                .Absent -> return jet_cli_with_notices(notices, jet_cli_missing_bare_entry("test", directory, color))
            }
        }
        if jet_cli_resolve_directory_target("test", directory, None, !show_default, color) == {
            .File(path, _, _) -> return jet_cli_test_file(path, color, verbose, threads, options, fresh, quiet)
            .Refused(plan) -> return plan
        }
    }
    target :: positionals[0]
    // Source/main.rs `resolve_source_path`: the typed spelling, else `<target>.jet`.
    file := target
    if !cli_files.is_file(target) && cli_files.is_file("{target}.jet") -> file = "{target}.jet"
    jet_cli_test_file(file, color, verbose, threads, options, fresh, quiet)
}

// One test file (or a package entry file): the harness collects every #Test the file and
// its package load, and a `fn test(t: Test)` there runs first with the suite.
fn jet_cli_test_file(file: String, color: Bool, verbose: Bool, threads: Int?, given: JetCLITestOptions, fresh: Bool, quiet: Bool) -[FS, Env]> JetCLIPlan Never! {
    options := given
    if !cli_files.exists(file) {
        return jet_cli_done("", "{options.status}{jet_cli_report("E2105", "can't find `{file}`", jet_cli_why("E2105"), "correct the named problem, then run the command again", color)}", JET_DRIVER_EXIT_USER_ERROR)
    }
    if fresh && !quiet -> options.status = "{options.status}jet test: fresh result run (test-result cache bypassed; build cache reusable)\n"
    source :: cli_files.read(file) ?? {
        return jet_cli_done("", "{options.status}{jet_cli_report("E2105", "couldn't read `{file}`: {err}", jet_cli_why("E2105"), "correct the named problem, then run the command again", color)}", JET_DRIVER_EXIT_USER_ERROR)
    }
    if jet_cli_has_doctests(source) -> return jet_cli_not_ported("test <file with doctests>", color)
    options.project_root = jet_cli_manifest_root(jet_cli_parent(file) ?? ".")
    JetCLIPlan.Test{file: file, source: source, color: color, verbose: verbose, threads: threads, options: options}
}

// `jet explain [<CODE>|<syntax>|<policy>|<registration>]` (CmdDevTools.rs
// `run_explain`, Explain.rs `lookup`): registered diagnostic essays render
// through Explain.jet; an unregistered code-shaped subject keeps the driver's
// unknown-code report; offline syntax and standalone policies render through
// SyntaxExplain.jet, then registered facts and corpus truths through
// RegistrationExplain.jet; only then is a syntax-shaped miss the E2106 typo
// report. Build facts, `marker` sites, and a policy with a source file are
// load-only source queries and stay refused until the loader leaf lands, as
// do the views.
fn jet_cli_explain(jet_argv: [String], args: [String], color: Bool, json: Bool) -> JetCLIPlan Never! {
    if jet_cli_has(jet_argv, "--reload") || jet_cli_has(jet_argv, "--web-graph") || jet_cli_has(jet_argv, "--cost") -> return jet_cli_not_ported("explain", color)
    if jet_cli_explain_diagnostic(args, color, json) == .Val(plan) -> return plan
    if args.len() == 2 && jet_cli_is_diagnostic_code(args[1]) -> return JetCLIPlan.Done{output: jet_driver_explain_code(Val(args[1]), color)}
    query :: args[1]
    if query == "marker" {
        // CmdDevTools.rs `run_explain_marker`: extra words stay ignored.
        if args.len() < 4 -> return jet_cli_done("", "usage: jet explain marker <file>:<line> <policy-key>\n", JET_DRIVER_EXIT_USAGE)
        marker :: jet_cli_explain_marker_site(args[2]) ?? return jet_cli_fail("E2104", err.message, jet_cli_why("E2104"), "correct the named argument or input, then run the command again", color, JET_DRIVER_EXIT_USAGE)
        key :: policy_key_parse(args[3]) ?? return jet_cli_fail("E2104", "`{args[3]}` is not a registered scoped policy", jet_cli_why("E2104"), "correct the named argument or input, then run the command again", color, JET_DRIVER_EXIT_USER_ERROR)
        return JetCLIPlan.PolicyExplain{key: key, file: marker.file, site: Val(args[2]), line: Val(marker.line), color: color, json: json}
    }
    if jet_cli_explain_build_fact_name(query) != None -> return jet_cli_not_ported("explain", color)
    if args.len() > 2 && policy_key_parse(query.trim().removeprefix("@")) == .Val(key) {
        return JetCLIPlan.PolicyExplain{key: key, file: args[2], site: None, line: None, color: color, json: json}
    }
    verbose :: jet_cli_has(jet_argv, "--verbose")
    if jet_cli_syntax_lookup(query) != None && jet_cli_explain_syntax(query, verbose, color, json) == .Val(plan) -> return plan
    if args.len() == 2 && jet_cli_explain_policy(query, color, json) == .Val(plan) -> return plan
    if jet_cli_explain_registration(query, color, json) == .Val(plan) -> return plan
    if jet_cli_explain_syntax(query, verbose, color, json) == .Val(plan) -> return plan
    jet_cli_not_ported("explain", color)
}

// `jet lint --a11y|--complexity|--cost <file>` (Source/main.rs `"lint"`):
// with no target the command's help is a usage error; exactly one category
// is required (E2102). The target resolves as main.rs `resolve_source_path`
// does (a directory is its project's stock entry; a file keeps its typed
// spelling, or gains `.jet`). Every category consumes checked Driver facts.
fn jet_cli_lint(jet_argv: [String], args: [String], color: Bool, quiet: Bool, json: Bool) -[FS, Env]> JetCLIPlan Never! {
    if args.len() < 2 -> return jet_cli_done("", if quiet -> "" else -> jet_cli_command_help("lint"), JET_DRIVER_EXIT_USAGE)
    a11y :: jet_argv.contains("--a11y")
    complexity :: jet_argv.contains("--complexity")
    cost :: jet_argv.contains("--cost")
    categories := 0
    if a11y -> categories += 1
    if complexity -> categories += 1
    if cost -> categories += 1
    if categories != 1 {
        return jet_cli_fail("E2102", "usage: jet lint --a11y|--complexity|--cost <file.jet>", "`lint` needs exactly one category flag", "run `jet lint --a11y <file.jet>`, `jet lint --complexity <file.jet>`, or `jet lint --cost <file.jet>`", color, JET_DRIVER_EXIT_USAGE)
    }
    target :: args[1]
    file := target
    notice := ""
    if cli_files.is_dir(target) {
        if jet_cli_resolve_source_path("lint", target, color, [String]{}) == {
            .File(path, _, written) -> {
                file = path
                notice = written
            }
            .Refused(plan) -> return plan
        }
    } else {
        if !cli_files.is_file(target) && cli_files.is_file("{target}.jet") -> file = "{target}.jet"
    }
    source :: cli_files.read(file) ?? return jet_cli_done("", "{notice}{jet_cli_report("E2105", "can't find the file `{file}`", jet_cli_why("E2105"), "check the spelling, or run jet from the folder that contains it", color)}", JET_DRIVER_EXIT_USER_ERROR)
    JetCLIPlan.Lint{file: file, source: source, color: color, notice: notice, category: if complexity -> "complexity" else if cost -> "cost" else -> "a11y", raw: jet_argv, json: json}
}

// `jet fuzz <file> [<test-name>] [--iterations=N]` (Source/main.rs `"fuzz"`):
// with no target the command's help is a usage error; the target resolves as
// `resolve_source_path` does; Fuzz.jet reports the retirement. `--time`,
// `--seed` and `--corpus` do not change the report.
fn jet_cli_fuzz_command(jet_argv: [String], args: [String], color: Bool, quiet: Bool) -[FS, Env]> JetCLIPlan Never! {
    if args.len() < 2 -> return jet_cli_done("", if quiet -> "" else -> jet_cli_command_help("fuzz"), JET_DRIVER_EXIT_USAGE)
    target :: args[1]
    file := target
    notice := ""
    if cli_files.is_dir(target) {
        if jet_cli_resolve_source_path("fuzz", target, color, [String]{}) == {
            .File(path, _, written) -> {
                file = path
                notice = written
            }
            .Refused(plan) -> return plan
        }
    } else {
        if !cli_files.is_file(target) && cli_files.is_file("{target}.jet") -> file = "{target}.jet"
    }
    // Rust: the first `--iterations=` value, as a u64, else None.
    iterations := Int?{None}
    loop argument in jet_argv {
        if !argument.starts_with("--iterations=") -> next
        text :: argument.slice(13..<argument.len())
        // A negative or non-numeric value is not a u64: no count.
        count :: Int.parse(text) ?? -1
        if count >= 0 -> iterations = Val(count)
        break
    }
    test_name := String?{None}
    if args.len() > 2 -> test_name = Val(args[2])
    jet_cli_with_notices([String]{notice}, jet_cli_fuzz(file, test_name, iterations, color))
}

// The tiers `jet emit` prints, one mode flag each (`--ast`, `--mir`,
// `--lir`, `--rust`).
JET_CLI_EMIT_TIERS :: [String]{"ast", "mir", "lir", "rust"}

// `jet emit --ast|--mir|--lir|--rust <file>` (`--rust`: Source/main.rs
// `"emit"`, CmdDevTools.rs `run_emit_rust`): with no target the command's
// help is a usage error; a target needs exactly one mode flag (E2102); the
// file is read as typed. `--fn NAME` selects one function's tree on the
// AST, MIR and LIR tiers.
fn jet_cli_emit(jet_argv: [String], args: [String], color: Bool, quiet: Bool, json: Bool) -[FS]> JetCLIPlan Never! {
    if args.len() < 2 -> return jet_cli_done("", if quiet -> "" else -> jet_cli_command_help("emit"), JET_DRIVER_EXIT_USAGE)
    modes := [String]{}
    loop tier in JET_CLI_EMIT_TIERS {
        if jet_argv.contains("--{tier}") -> &modes.push(tier)
    }
    if modes.len() == 0 {
        return jet_cli_fail("E2102", "usage: jet emit --ast|--mir|--lir|--rust <file.jet>", "`emit` needs a mode flag naming the tier it prints", "run `jet emit --mir <file.jet>`; `--ast`, `--lir` and `--rust` print the other tiers", color, JET_DRIVER_EXIT_USAGE)
    }
    if modes.len() > 1 {
        return jet_cli_fail("E2102", "`jet emit` prints one tier, but both `--{modes[0]}` and `--{modes[1]}` were given", "`emit` writes a single tier so its output has one meaning", "keep one of the mode flags", color, JET_DRIVER_EXIT_USAGE)
    }
    tier :: modes[0]
    function := String?{None}
    asked := false
    loop argument in jet_argv {
        if argument == "--fn" || argument.starts_with("--fn=") -> asked = true
    }
    if asked {
        name :: jet_cli_option_value(jet_argv, "--fn") ?? ""
        if name == "" || name.starts_with("-") {
            return jet_cli_fail("E2104", "`--fn` needs a function name", jet_cli_why("E2104"), "write `jet emit --{tier} <file.jet> --fn <name>`", color, JET_DRIVER_EXIT_USAGE)
        }
        if tier == "rust" {
            return jet_cli_fail("E2102", "`--fn` doesn't apply to `jet emit --rust`", "`--rust` prints the whole generated program", "use `--fn` with `--ast`, `--mir` or `--lir`, or drop it", color, JET_DRIVER_EXIT_USAGE)
        }
        function = Val(name)
    }
    file :: args[1]
    source :: cli_files.read(file) ?? return jet_cli_fail("E2105", "can't find the file `{file}`", jet_cli_why("E2105"), "check the spelling, or run jet from the folder that contains it", color, JET_DRIVER_EXIT_USER_ERROR)
    JetCLIPlan.Emit{file: file, source: source, color: color, json: json, tier: tier, function: function}
}

// `jet eval <file.jet | expression>` (Source/main.rs `"eval"`): a file, a
// project directory, or a bare stem (`looks_like_jet_source`) is the file form
// and resolves as `resolve_source_path` does; a `:meta` word is REPL
// vocabulary; any other argument is the expression form (REPL `eval_once`).
fn jet_cli_eval(raw: [String], args: [String], color: Bool, json: Bool) -[FS, Env]> JetCLIPlan Never! {
    if args.len() < 2 {
        return jet_cli_fail("E2104", "`jet eval` needs a file or an expression: jet eval <file.jet | expression>", jet_cli_why("E2104"), "correct the named argument or input, then run the command again", color, JET_DRIVER_EXIT_USAGE)
    }
    argument :: args[1]
    if !jet_cli_looks_like_source(argument) {
        if argument.starts_with(":") {
            return jet_cli_fail("E2104", "`{argument}` is a jet command, not an expression", jet_cli_why("E2104"), "run `jet repl` for an interactive session, or pass an expression such as `1 + 2`", color, JET_DRIVER_EXIT_USAGE)
        }
        return jet_cli_not_ported("eval <expression>", color)
    }
    file := argument
    notice := ""
    if cli_files.is_dir(argument) {
        if jet_cli_resolve_source_path("eval", argument, color, [String]{}) == {
            .File(path, _, written) -> {
                file = path
                notice = written
            }
            .Refused(plan) -> return plan
        }
    } else {
        if !cli_files.is_file(argument) && cli_files.is_file("{argument}.jet") -> file = "{argument}.jet"
    }
    JetCLIPlan.Eval{file: file, pure: raw.contains("--pure"), color: color, json: json, notice: notice}
}

// `jet new` templates (CmdCompile.rs `NewTemplate::NAMES`).
JET_CLI_NEW_TEMPLATES :: [String]{"cli", "ui", "web", "overrides"}

// `jet new <name> [--template <t>] [--annotated]` (Source/main.rs `"new"`):
// a bare `jet new` is a usage error that prints the command's help; the
// backend scaffolds (`new service|route|job|migration`) are not ported yet.
fn jet_cli_new(jet_argv: [String], args: [String], color: Bool, quiet: Bool) -[FS]> JetCLIPlan Never! {
    if args.len() < 2 -> return jet_cli_done("", if quiet -> "" else -> jet_cli_command_help("new"), JET_DRIVER_EXIT_USAGE)
    name :: args[1]
    if name == "service" || name == "route" || name == "job" || name == "migration" -> return jet_cli_not_ported("new {name}", color)
    template := ""
    asks_template := false
    loop argument in jet_argv {
        if argument == "--template" || argument.starts_with("--template=") -> asks_template = true
    }
    if asks_template {
        template = jet_cli_option_value(jet_argv, "--template") ?? ""
        if !JET_CLI_NEW_TEMPLATES.contains(template) {
            return jet_cli_fail("E2104", "`{template}` is not a `jet new` template", jet_cli_why("E2104"), "choose one of {JET_CLI_NEW_TEMPLATES.join(", ")}: `jet new {name} --template ui`", color, JET_DRIVER_EXIT_USAGE)
        }
    }
    if name.len() == 0 || name.contains("/") || name.contains("\\") {
        return jet_cli_fail("E2104", "project name must be a simple folder name", jet_cli_why("E2104"), "try: jet new my_app", color, JET_DRIVER_EXIT_USER_ERROR)
    }
    if cli_files.exists(name) {
        return jet_cli_fail("E2104", "`{name}` already exists", jet_cli_why("E2104"), "correct the named argument or input, then run the command again", color, JET_DRIVER_EXIT_USER_ERROR)
    }
    JetCLIPlan.New{name: name, template: template, annotated: jet_argv.contains("--annotated"), quiet: quiet, color: color}
}

// `jet fmt` (Source/main.rs `"fmt"`): `--lang` selects the environment
// formatter (`argv` is the whole command line from `fmt`, `--` included);
// otherwise native `.jet` formatting.
fn jet_cli_fmt(argv: [String], jet_argv: [String], args: [String], color: Bool, quiet: Bool) -> JetCLIPlan Never! {
    loop argument in jet_argv {
        if argument == "--lang" || argument.starts_with("--lang=") -> return JetCLIPlan.FmtLang{argv: argv, color: color}
    }
    dry_run :: jet_argv.contains("--dry-run")
    stdin_path := String?{None}
    loop argument in jet_argv {
        if argument.starts_with("--stdin-path=") {
            stdin_path = Val(argument.slice(13..<argument.len()))
            break
        }
    }
    paths := [String]{}
    stdin_mode := false
    loop index in 1..<args.len() {
        if args[index] == "-" {
            stdin_mode = true
        } else {
            &paths.push(args[index])
        }
    }
    JetCLIPlan.Fmt{request: JetCLIFmtRequest{
        paths: paths,
        stdin_mode: stdin_mode,
        stdin_path: stdin_path,
        check: jet_argv.contains("--check") || dry_run,
        diff: jet_argv.contains("--diff") || dry_run,
        changed: jet_argv.contains("--changed"),
        explicit_copies: jet_argv.contains("--explicit-copies"),
        simplify: jet_argv.contains("--simplify"),
        color: color,
        quiet: quiet,
        json: jet_argv.contains("--json"),
    }}
}

// The jet-owned argv prefix before the first standalone `--`.
fn jet_cli_owned_flags(raw: [String]) -> [String] Never! {
    output_end := raw.len()
    loop (index, argument) in raw {
        if argument == "--" {
            output_end = index
            break
        }
    }
    jet_cli_prefix(raw, output_end)
}

// Source/main.rs `OutputMode::json`: `--json` before `--`, or the `compiler`
// inspect plane, which is machine output by construction.
fn jet_cli_wants_json(owned: [String]) -> Bool Never! {
    json := owned.contains("--json") || (owned.len() > 0 && owned[0] == "compiler")
    loop index in 1..<owned.len() {
        if owned[index - 1] == "inspect" && owned[index] == "compiler" -> json = true
    }
    json
}

// Plan one `jet` invocation; `raw` is argv without the program name. Under
// `--json` a refusal is the `cli` status envelope on stdout (main.rs
// `emit_cli_report`).
fn jet_cli_front(raw: [String]) -[FS, Env, Time, Exec, IO, FFI.C, FFI.Asm, Net]> JetCLIPlan Never! {
    plan :: jet_cli_plan(raw)
    if plan == {
        .Refused(report, _, exit_code, notice) -> {
            if jet_cli_wants_json(jet_cli_owned_flags(raw)) -> return jet_cli_done(jet_cli_report_status_json(report), notice, exit_code)
        }
        .Diagnostics(file, source, report, color, notice) -> return JetCLIPlan.Done{output: jet_cli_diagnostics_output(file, source, report, color, jet_cli_wants_json(jet_cli_owned_flags(raw)), notice)}
        else -> {}
    }
    plan
}

fn jet_cli_plan(raw: [String]) -[FS, Env, Time, Exec, IO, FFI.C, FFI.Asm, Net]> JetCLIPlan Never! {
    // The engine compiler aliases own every raw argument
    // (Source/main.rs `dispatch_alias`), before Jet's output/flag parsing.
    if raw.len() > 0 && (raw[0] == "cc" || raw[0] == "c++") -> return jet_cli_foreign_compile_plan(raw)
    // The internal compiler service owns its raw arguments, as the engine
    // aliases do: `jet __jetpack <op>`, nothing else.
    if raw.len() > 0 && raw[0] == JET_COMPILER_SERVICE_VERB {
        if raw.len() != 2 -> return jet_cli_done("", jet_cli_report("E2104", "`jet {JET_COMPILER_SERVICE_VERB}` takes exactly one operation", jet_cli_why("E2104"), "`jet {JET_COMPILER_SERVICE_VERB}` is spoken by `jetpack`; run the jetpack command instead", false), JET_DRIVER_EXIT_USAGE)
        return JetCLIPlan.CompilerService{op: raw[1]}
    }
    // Output flags, parsed once from the jet-owned prefix before `--`.
    owned :: jet_cli_owned_flags(raw)
    color := false
    loop argument in owned {
        if argument == "--color" -> color = true
        if argument.starts_with("--color=") {
            value :: argument.slice(8..<argument.len())
            if value == {
                "always" -> color = true
                "auto" | "never" -> color = false
                else -> return jet_cli_done("", "Error [E2104]: invalid color request {jet_cli_debug_quote(value)}; expected auto, always, or never\n", JET_DRIVER_EXIT_USAGE)
            }
        }
    }
    quiet :: owned.contains("--quiet")
    verbose :: owned.contains("--verbose") || owned.contains("-v")
    json :: jet_cli_wants_json(owned)
    if raw.len() == 0 -> return jet_cli_not_ported("repl", color)
    if raw[0] == "?" -> return jet_cli_not_ported("?", color)

    // Moved and grouped spellings (Source/main.rs `normalize_frequency_ring_argv`).
    // copy: `raw` stays with the caller (`raw` is a read parameter: no move out of it, E0201) and
    // the binding `argv` owns its own.
    argv := raw.copy()
    if jet_cli_moved_command(argv[0]) == .Val(moved) {
        group :: JET_CLI_COMMANDS[moved.group].name
        return jet_cli_fail(
            "E2101",
            "`{argv[0]}` moved under `jet {group}`.",
            "infrequent commands live in a named area so daily Jet commands stay easy to scan.",
            "run `jet {group} {argv.join(" ")}`.",
            color,
            JET_DRIVER_EXIT_USAGE,
        )
    }
    // copy: `argv[0]` stays in its list (owner: `argv`; no move out of an element, E0225) and the
    // binding `group` owns its own.
    group :: argv[0].copy()
    exhaustive := false
    if jet_cli_group_index(group) == .Val(index) {
        exhaustive = JET_CLI_COMMANDS[index].exhaustive
        second_asks :: argv.len() > 1 && (argv[1] == "help" || jet_cli_is_help_flag(argv[1]))
        asks_help :: if group == "env" -> second_asks else -> argv.len() == 1 || second_asks
        if (exhaustive || group == "env") && asks_help -> return jet_cli_renderable(jet_cli_group_help(group), json)
    }
    if argv.len() > 1 {
        // copy: `argv[1]` stays in its list (owner: `argv`; no move out of an element, E0225) and
        // the binding `sub` owns its own.
        sub :: argv[1].copy()
        nested :: jet_cli_nested_command(group, sub)
        if exhaustive && nested == None {
            return jet_cli_fail("E2101", "`{sub}` isn't a jet {group} command.", "jet {group} accepts only commands in its named area.", "run `jet {group} help`.", color, JET_DRIVER_EXIT_USAGE)
        }
        if nested == .Val(found) {
            key :: JET_CLI_COMMANDS[found.group].actions[found.action].handler
            if jet_cli_handler_index(key) == .Val(handler) {
                spec :: JET_CLI_HANDLERS[handler]
                if !spec.keeps_group {
                    rewritten := [String]{spec.dispatch_word}
                    loop word in jet_cli_tail(argv, 2) -> &rewritten.push(word)
                    argv = rewritten
                }
            }
        }
    }
    if argv[0] == "perf" -> return jet_cli_not_ported(argv[0], color)

    // Everything after the first standalone `--` belongs to the program.
    separator := argv.len()
    loop (index, argument) in argv {
        if argument == "--" {
            separator = index
            break
        }
    }
    jet_argv :: jet_cli_prefix(argv, separator)
    passthrough := [String]?{None}
    if separator < argv.len() -> passthrough = Val(jet_cli_tail(argv, separator + 1))
    loop (index, argument) in jet_argv {
        if argument != "--version" -> next
        builtin_before := false
        loop earlier in 0..<index {
            if jet_cli_is_builtin(jet_argv[earlier]) -> builtin_before = true
        }
        if !builtin_before -> return jet_cli_version(json)
        break
    }
    args :: jet_cli_positionals(jet_argv)
    if args.len() > 0 && args[0] == "lsp" -> return jet_cli_not_ported("self lsp", color)
    if args.len() == 0 {
        if jet_cli_any_help_flag(jet_argv) {
            order :: jet_cli_help_order(jet_argv)
            if !jet_cli_is_help_order(order) -> return jet_cli_bad_help_order(order, color)
            return jet_cli_renderable(jet_cli_usage_page(order), json)
        }
        return jet_cli_renderable(jet_cli_greeting(), json)
    }
    command :: args[0]

    // `--lib` and `--output` belong to the commands that produce those artifacts.
    library :: jet_argv.contains("--lib")
    if library && command != "build" {
        return jet_cli_fail("E2104", "`--lib` is only valid with `jet build`", jet_cli_why("E2104"), "run `jet build --lib <file.jet>` to emit the native Library artifacts", color, JET_DRIVER_EXIT_USAGE)
    }
    output_name := String?{None}
    loop (index, argument) in jet_argv {
        if argument.starts_with("--output=") {
            output_name = Val(argument.slice(9..<argument.len()))
            break
        }
        if argument == "--output" {
            value := ""
            if index + 1 < jet_argv.len() && !jet_argv[index + 1].starts_with("-") -> value = jet_argv[index + 1]
            output_name = Val(value)
            break
        }
    }
    if output_name == .Val(output) {
        allowed :: command == "run" || (command == "dev" && jet_argv.contains("--canvas")) || (command == "build" && library) || command == "package"
        if !allowed || output == "" {
            return jet_cli_fail("E2104", "`--output` needs a runnable Output address or `jet build --lib`", jet_cli_why("E2104"), "write `jet run --output <address> <file.jet>`, or `jet build --lib --output <name> <file.jet>`", color, JET_DRIVER_EXIT_USAGE)
        }
    }

    if !jet_cli_is_builtin(command) {
        if jet_cli_looks_like_source(command) {
            // `jet <file>` is `jet run <file>`; Source/main.rs dispatches it
            // before the help and flag checks, so it ignores both.
            threads := Int?{None}
            if !jet_cli_any_help_flag(jet_argv) {
                if jet_cli_threads(jet_argv, "run", color) == {
                    .Refused(refusal) -> return refusal
                    .Cap(cap) -> threads = cap
                }
            }
            if jet_cli_trace_refusal(jet_argv, "run", color) == .Val(refusal) -> return refusal
            run_args := [String]{"run"}
            loop word in args -> &run_args.push(word)
            return jet_cli_run(jet_argv, run_args, passthrough, true, color, quiet, verbose, threads)
        }
        fix :: if jet_cli_closest_command(command) == .Val(close) -> "did you mean `jet {close}`? Run `jet help` to see them all." else -> "run `jet help` to see every command."
        return jet_cli_fail("E2101", "`{command}` isn't a jet command.", "every jet run starts with a command like `run`, `check`, or `new`.", fix, color, JET_DRIVER_EXIT_USAGE)
    }

    owns_flags :: JET_CLI_OWNS_FLAGS.contains(command)
    bespoke_help :: command == "bind" || command == "diff" || command == "merge" || command == "perf"
    if jet_cli_any_help_flag(jet_argv) && !(owns_flags && bespoke_help) -> return jet_cli_renderable(jet_cli_command_help(command), json)
    threads := Int?{None}
    if jet_cli_threads(jet_argv, command, color) == {
        .Refused(refusal) -> return refusal
        .Cap(cap) -> threads = cap
    }
    if !owns_flags {
        if jet_cli_check_flags(jet_argv, command, color) == .Val(refusal) -> return refusal
        if jet_cli_trace_refusal(jet_argv, command, color) == .Val(refusal) -> return refusal
    }
    if command != "dev" && jet_argv.contains("--canvas") {
        return jet_cli_fail("E2102", "`--canvas` is only valid with `jet dev`", jet_cli_why("E2102"), "run `jet dev <file.jet> --canvas` to open the Canvas IDE", color, JET_DRIVER_EXIT_USAGE)
    }

    if jet_cli_engine_commands(command, argv) == .Val(plan) -> return plan
    if command == {
        "help" -> {
            bespoke :: if args.len() > 1 -> jet_cli_structural_help(args[1]) else -> String?{None}
            return jet_cli_help(jet_argv, args, bespoke, color, json)
        }
        "version" -> return jet_cli_version(json)
        "man" -> return jet_cli_renderable(jet_cli_man_page(), json)
        "completions" -> {
            tail :: jet_cli_tail(argv, 1)
            if jet_cli_completions_builtin(tail) == .Val(builtin) -> return builtin
            // Only the valid `<shell> --for <program>` shape reaches here.
            program :: tail[2]
            name :: jet_cli_program_completion_name(program) ?? return jet_cli_program_completion_error(program, "the program path has no usable command name")
            if jet_cli_program_completion_name_control(name) -> return jet_cli_program_completion_error(program, "the program command name contains a control character")
            return JetCLIPlan.Completion{shell: tail[0], program: program, name: name}
        }
        // main.rs `"devtools"`: the tools own the raw argv after their word.
        "devtools" -> {
            tool :: if argv.len() > 1 -> argv[1] else -> ""
            if tool == {
                "new-example" -> return jet_cli_devtools_new_example(jet_cli_tail(argv, 2), color)
                "new-ui" | "reduce" | "ice-report" | "bless" -> return JetCLIPlan.Maintenance{action: tool, args: jet_cli_tail(argv, 2), color: color, json: json}
                // Rust ignores extra words after `check-fixture-paths`.
                "check-fixture-paths" -> return JetCLIPlan.Maintenance{action: tool, args: [String]{}, color: color, json: json}
                else -> {}
            }
        }
        "fuzz" -> return jet_cli_fuzz_command(jet_argv, args, color, quiet)
        "explain" -> return jet_cli_explain(jet_argv, args, color, json)
        "check" -> return jet_cli_check(jet_argv, args, "check", color, quiet, threads, json)
        "build" -> return jet_cli_build(jet_argv, args, color, quiet, threads)
        "run" -> return jet_cli_run(jet_argv, args, passthrough, false, color, quiet, verbose, threads)
        // Stock `jet dev`: the `jet run` entry, rebuilt and rerun on every source change.
        // `--canvas`, `--app` and `--share` are their own dev hosts, not this loop.
        "dev" -> {
            if !jet_argv.contains("--canvas") && !jet_cli_has(jet_argv, "--app") && !jet_cli_has(jet_argv, "--share") {
                plan :: jet_cli_run(jet_argv, args, passthrough, false, color, quiet, verbose, threads)
                if plan == .Run(file, source, color_flag, release, verbose_flag, threads_cap, program_args, invocation, notice, _) {
                    return JetCLIPlan.Run{file: file, source: source, color: color_flag, release: release, verbose: verbose_flag, threads: threads_cap, program_args: program_args, invocation: invocation, notice: notice, watch: true}
                }
                return plan
            }
        }
        "test" -> return jet_cli_test(jet_argv, color, quiet, verbose, threads)
        "new" -> return jet_cli_new(jet_argv, args, color, quiet)
        "doc" -> return jet_cli_doc(jet_argv, args, color, quiet, json, jet_argv.contains("--check"))
        "emit" -> return jet_cli_emit(jet_argv, args, color, quiet, json)
        "eval" -> return jet_cli_eval(argv, args, color, json)
        "fill" -> {
            if args.len() < 2 -> return jet_cli_done("", if quiet -> "" else -> jet_cli_command_help("fill"), JET_DRIVER_EXIT_USAGE)
            return JetCLIPlan.Fill{target: args[1], json: json, color: color}
        }
        "diff" | "merge" -> {
            start := 0
            loop (index, word) in argv {
                if word == command {
                    start = index
                    break
                }
            }
            return JetCLIPlan.Structural{argv: jet_cli_tail(argv, start), command: command, json: json}
        }
        "lint" -> return jet_cli_lint(jet_argv, args, color, quiet, json)
        "fmt" -> return jet_cli_fmt(argv, jet_argv, args, color, quiet)
        "find" -> return jet_cli_find(jet_cli_tail(argv, 1), color, json)
        "parts" -> return jet_cli_project_parts(jet_cli_tail(argv, 1), color, json)
        // Source/main.rs dispatch arms over the raw argv (`raw[1..]` etc.).
        "status" -> return jet_cli_status(jet_cli_tail(argv, 1), color, json)
        "fix" -> {
            if args.len() > 1 && args[1] == "memory" -> return jet_cli_fix_memory_at(jet_cli_selected_root_or_cwd(), jet_cli_tail(argv, 2), color, json)
            if args.len() < 2 -> return jet_cli_done("", if quiet || json -> "" else -> jet_cli_command_help("fix"), JET_DRIVER_EXIT_USAGE)
            target :: args[1]
            file := target
            notice := ""
            if cli_files.is_dir(target) {
                if jet_cli_resolve_source_path("fix", target, color, [String]{}) == {
                    .File(path, _, written) -> {
                        file = path
                        notice = written
                    }
                    .Refused(plan) -> return plan
                }
            } else if !cli_files.is_file(target) && cli_files.is_file("{target}.jet") {
                file = "{target}.jet"
            }
            return JetCLIPlan.Fix{file: file, dry_run: jet_argv.contains("--dry-run"), all: jet_argv.contains("--all"), color: color, quiet: quiet, json: json, notice: notice}
        }
        "gc" -> return jet_cli_gc(argv, args, color, json)
        "cache" -> return JetCLIPlan.Cache{args: jet_cli_tail(argv, 1), json: json}
        "remote" -> return JetCLIPlan.Remote{argv: argv, json: json, color: color}
        // `jet self toolchain` (main.rs `run_toolchain`): read-only pin report.
        "toolchain" -> return jet_cli_self_toolchain(json)
        // CmdTest.rs `run_test_compare(target, jet_argv, mode)`.
        "test-compare" -> return JetCLIPlan.Comparison{target: if args.len() > 1 -> args[1] else -> "", argv: jet_argv, json: json}
        "try" -> {
            if args.len() < 2 -> return jet_cli_done("", if quiet || json -> "" else -> jet_cli_command_help("try"), JET_DRIVER_EXIT_USAGE)
            return JetCLIPlan.Try{plan_path: args[1], keep: jet_argv.contains("--keep"), json: json}
        }
        else -> {}
    }
    if jet_cli_inspect_word(command) {
        plan :: jet_cli_inspect(argv, jet_argv, args, color, quiet, json, threads)
        if plan == .Inspect(job) {
            selected := job
            selected.verbose = verbose
            return JetCLIPlan.Inspect{job: selected}
        }
        return plan
    }
    jet_cli_not_ported(command, color)
}
