// The `jet` front door (`main` up to verb dispatch): output flags, retired,
// moved, and grouped routes, help and the greeting, unknown commands (E2101)
// and flags (E2102), then the verbs the Jet driver owns (`explain <CODE>`,
// `check [<file>|<dir>]`, `build <file>`, `run [<file>|<dir>]`, `test <file>`,
// `new <name>`, `doc <file>`, `fmt`, and `emit --ast|--ir <file>`; a bare or
// directory target resolves the project entry, Entry.jet), and the inspect
// group (Inspect.jet). Every report is the Rust host's exact bytes and exit
// status for the same argv, except `jet emit`, which is Jet-only: its
// `--ast`/`--ir` tiers, `--fn`, and the E2102 reports for a target with no mode
// flag or with two. A command whose Jet port has not landed yet is refused with
// E2104 instead of guessing its behavior.
use {
    cli_files: core.files
    cli_sys: core.sys
    cli_term: core.term
    jet_driver.[
        JetDriverFailure,
        JetDriverVerbOutput,
        JET_DRIVER_EDITION,
        JET_DRIVER_EXIT_USER_ERROR,
        JET_DRIVER_EXIT_USAGE,
        jet_driver_explain_code,
        jet_driver_target_machine_by_name,
    ]
    jet_foundation.[
        BuildOptionChoice,
        BuildOptionKind,
        BuildOptionLayer,
        BuildOptions,
        BuildSettingOverride,
        build_option_accepts,
        build_option_argument,
        build_option_check_removal_note,
        build_option_flag_refusal,
        build_options_check_removals,
        build_option_flag_row,
        build_option_flags,
        build_option_level_spelling,
        build_option_profile_hint,
        build_option_refusal,
        build_option_row,
        build_options_resolve,
        build_options_stock,
        build_options_value,
        DeepChecks,
        deep_checks_malformed,
        deep_checks_read,
        JET_CLI_COMMANDS,
        JET_CLI_HANDLERS,
        JET_COMPILER_SERVICE_VERB,
        JET_TEST_SETTINGS,
        JetCLIFlagSpec,
        jet_cli_control_of_flag,
        Diagnostic,
        PolicyKey,
        TEST_SETTINGS_ENV,
        TEST_SETTINGS_PLAN_ENV,
        TestSetting,
        TestSettingKind,
        LOG_FILTER_FIX,
        log_filter_bad_pair,
        diagnostic_from_registry,
        diagnostic_registry_row,
        diagnostic_render_all,
        policy_gate_parse,
        policy_key_parse,
        test_setting_flag,
        test_setting_flag_row,
        test_setting_hint,
        test_setting_value,
        test_settings_get,
        test_settings_layered,
        test_settings_levels,
        test_settings_put,
    ]
    jet_pkg_model.[JET_VERSION, WorkspaceDeclarationCache, pkg_discover_jobs_in, pkg_jet_build, pkg_version_line]
    jet_testkit.[KIT_SOURCE_LANGUAGES, kit_source_language]
}

JetCLIPlan: enum {
    // The command finished: write these bytes and exit with this status.
    Done(output: JetDriverVerbOutput)
    // A command refused before it ran: one spanless CLI report and its exit
    // status; `notice` is the stderr status entry resolution wrote before the
    // refusal. `jet_cli_front` prints the report as the `cli` status envelope
    // under `--json`; the host renders it as text.
    Refused(report: Diagnostic, color: Bool, exit_code: Int, notice: String)
    // `emit_cli_diagnostics`: source-owned reports use the diagnostics channel,
    // not the spanless CLI-usage envelope.
    Diagnostics(file: String, source: String, report: Diagnostic, color: Bool, notice: String)
    // `jet check <file>`: the entry as the user typed it (or as project
    // resolution chose it), its bytes, the output policy, and the `--threads`
    // cap. `project` is the project scope of a bare or directory check;
    // `notice` is the stderr status entry resolution wrote. The host compiles
    // it and renders the outcome, as machine reports when `json`. `verbose`
    // (`--verbose`/`-v` on an explicit-file `jet check`) adds the check's scope
    // and proof rows on stdout (first-hour.md lesson 3). `settings` are the
    // `--set name=value` writers the compile folds (BuildFactChain.jet);
    // `profile` is the `--profile` it compiles under ("" for the default);
    // `style` (`--style`) adds the opt-in style checks (StyleCheck.jet);
    // `target` is the machine without an OS `--target` names, the program is
    // checked for ("" for the host; jet_cli_no_os_machine).
    Check(file: String, source: String, color: Bool, quiet: Bool, threads: Int?, project: Bool, notice: String, json: Bool, verbose: Bool, settings: [BuildSettingOverride], profile: String, style: Bool, target: String)
    // `jet check` of a workspace root (no `-p`): the entry and bytes of each
    // member no other member depends on (Host.jet `jet_cli_check_workspace`),
    // each compiled under the `--set` writers and the `--profile`, and with
    // the style checks under `style`.
    CheckWorkspace(files: [String], sources: [String], color: Bool, quiet: Bool, threads: Int?, notice: String, json: Bool, settings: [BuildSettingOverride], profile: String, style: Bool)
    // `jet check --prelude <file>`: one Compiler/Prelude source and its bytes,
    // checked as the compiler embeds it (Host.jet
    // `jet_cli_compile_prelude_check`).
    CheckPrelude(file: String, source: String, color: Bool, quiet: Bool, threads: Int?, json: Bool)
    // `jet check Core`: every public module of the toolchain's Core library
    // (`core`, its directory), each body checked whether a program calls it
    // or not (Host.jet `jet_cli_compile_core_check`).
    CheckCore(core: String, color: Bool, quiet: Bool, threads: Int?, json: Bool)
    // `jet build <file>`: the entry and its bytes; `options` are the build
    // options it compiles under (jet_cli_build_options: stock, profile, flags);
    // `invocation` holds the `--allow`/`--deny` rows; `json` reports its
    // compile errors as one machine status; `sbom` (`--sbom`) also writes the
    // SPDX SBOM of its lock next to the binary, and says where unless `quiet`;
    // `verbose` (`--verbose`) reports the runtime pack and each binary cache
    // decision (BuildCache.jet).
    Build(file: String, source: String, color: Bool, options: BuildOptions, threads: Int?, invocation: JetCLIInvocationAuthority?, notice: String, json: Bool, sbom: Bool, quiet: Bool, verbose: Bool)
    // `jet build --locked`: `check` is the engine's locked-fetch argv; when
    // it passes, `build` (the raw words without `--locked`) runs as `jet build`
    // does, refusing a dependency effect row the lock doesn't cover (E3513).
    LockedBuild(check: [String], build: [String])
    // A package build its `build: fn(b: Build)` in `file` configures; its
    // option calls join `options` as their `build: fn` layer, and its
    // `b.args()` returns `build_args` (the words after `--`).
    // `locked` is set by `--locked`: the engine's locked-fetch argv the host
    // runs first (empty for a package with no manifest), and the build then
    // checks its generated sources against the lock (E3512). None otherwise.
    BuildPackage(file: String, color: Bool, options: BuildOptions, build_args: [String], threads: Int?, invocation: JetCLIInvocationAuthority?, notice: String, locked: [String]?)
    // `jet run <file>` (or `jet <file>`): build the entry as `jet build`
    // does, then run it with `program_args`. `verbose` (`--verbose`/`-v`
    // before `--`) shows advisory lints; `json` (`--json`) reports the shown
    // diagnostics as the `diagnostics` status on stderr, leaving stdout to
    // the program and the exit code to the build or the program.
    // `watch` (`jet dev`): rerun the program whenever a package source changes.
    // `entry` is the command function the program starts at (`dev: fn` for a
    // `jet dev` that selected one); None starts at the package's own entry.
    Run(file: String, source: String, color: Bool, options: BuildOptions, verbose: Bool, json: Bool, threads: Int?, program_args: [String], invocation: JetCLIInvocationAuthority?, notice: String, watch: Bool, entry: String?)
    // `jet run <https-url|name#version>`: fetch and pin `target`, then run
    // the pinned entry as `Run` runs a file (RemoteRun.jet); `jet_argv` and
    // `args` are the command as written.
    RunRemote(target: JetCLIRemoteRunTarget, jet_argv: [String], args: [String], passthrough: [String]?, color: Bool, quiet: Bool, verbose: Bool, threads: Int?)
    // `jet run|build <file>` of a C or C++ file (#6686): compile and link it
    // at `-O{level}` with the C toolchain Jet programs compile their own C
    // with (Host.jet jet_cli_native_source); `run` then runs it with
    // `program_args`.
    NativeSource(file: String, level: Int, run: Bool, program_args: [String], color: Bool)
    // `jet dev` of a browser program (jet_cli_dev_web_selected): build it as
    // `jet build --target web` does under `options`, serve the build
    // directory on 127.0.0.1:`port` (0: the listener picks one), and rebuild
    // on every change (Host.jet jet_cli_dev_web_loop).
    DevWeb(file: String, source: String, color: Bool, options: BuildOptions, threads: Int?, invocation: JetCLIInvocationAuthority?, notice: String, port: Int)
    // `jet dev <file> --canvas`: check `file` (`source` is its text), serve
    // the Canvas IDE for it on `host`:`port` (0: the listener picks one),
    // and re-project its graph on every change (CanvasDev.jet
    // jet_cli_dev_canvas_loop).
    DevCanvas(file: String, source: String, color: Bool, host: String, port: Int, notice: String)
    // `jet jobs`: list the `#Job fn`s of `file`, the entry a bare `jet run`
    // resolves (Jobs.jet); `json` prints the `jobs` status, `notice` is
    // resolution's stderr.
    Jobs(file: String, color: Bool, json: Bool, notice: String)
    // `jet test <file>`: compile the checked test harness and run it under
    // `options` (native O0 unless its build options say otherwise).
    Test(file: String, source: String, color: Bool, verbose: Bool, threads: Int?, options: JetCLITestOptions)
    // `jet test` in children: a workspace root's runnable members, or one
    // run per optimize level or under another compiler. `member_args` holds
    // each child's words after the executable (`executable`, "" for this
    // jet), `envs` each child's environment as name/value pairs (empty:
    // none), and `heading` names a child in the summary (Host.jet
    // `jet_cli_test_workspace`). `results` ("" for none) is the one document
    // the runs' rows go to, each run's at its `tiers` entry.
    TestWorkspace(names: [String], member_args: [[String]], envs: [[String]], executable: String, heading: String, results: String, tiers: [String], quiet: Bool)
    // `jet test` under the test profile `profile` of the package at `root`:
    // each of `runs` is a child `jet test`, compared with its baseline, and
    // the corpus suites run in process (TestProfile.jet
    // `jet_cli_test_profile`), each under the decided `settings`
    // (TestSettingLayers.jet); `update` rewrites the baselines and blesses
    // the corpus rows.
    TestProfile(profile: String, root: String, settings: [TestSetting], runs: [JetCLITestProfileRun], update: Bool, quiet: Bool)
    // `jet new <name>`: write the project folder; `template` is "" for the
    // print-only starter. `json` prints the created files as one `new` status
    // line instead of the human recap.
    New(name: String, template: String, annotated: Bool, quiet: Bool, json: Bool, color: Bool)
    // `jet doc <file>`: `json` prints the `inspect.doc` status, `check` reports
    // undocumented public items.
    Doc(file: String, source: String, color: Bool, json: Bool, check: Bool)
    // `jet emit --ast|--ir <file>`: print one tier of the entry;
    // `function` is the `--fn` selection.
    Emit(file: String, source: String, color: Bool, json: Bool, tier: String, function: String?)
    // `jet eval <file>`: evaluate the entry's `run` and print its value; `pure`
    // (`--pure`) adds the transitive E3401 purity walk; `notice` is
    // resolution's stderr.
    Eval(file: String, pure: Bool, color: Bool, json: Bool, notice: String)
    // `jet fill <file>[:line]` (`"fill"`, Fill.jet): the typed goal report;
    // `target` keeps its optional `:line` suffix.
    Fill(target: String, json: Bool, color: Bool)
    // `jet diff|merge ...` (StructuralMerge.jet): `argv` starts at the command word.
    Structural(argv: [String], command: String, json: Bool)
    // `jet review ...` (Review.jet): `argv` starts at the command word.
    Review(argv: [String], json: Bool, color: Bool)
    // `jet registry keygen` (SigningKey.jet): create `registry`'s package-signing key.
    Keygen(registry: String, force: Bool, color: Bool)
    // `jet registry key backup` (SigningKey.jet): copy `registry`'s secret key to `dest`.
    KeyBackup(registry: String, dest: String, color: Bool)
    // `jet registry publish` (Publish.jet): the pre-publish gate, then the
    // registry index and artifact push.
    Publish(force: Bool, no_sign: Bool, quiet: Bool, color: Bool)
    // `jet registry yank <version>` (Publish.jet): flip the version's `yanked` flag.
    Yank(version: String, message: String?, color: Bool)
    // `jet lint --a11y|--complexity <file>`: the accessibility lints or the
    // cognitive-complexity view of the entry (`run_lint_a11y`,
    // `run_lint_complexity`); `category` is `a11y` or `complexity`, `raw` is
    // the jet argv (`--max=N`), `notice` is resolution's stderr.
    Lint(file: String, source: String, color: Bool, notice: String, category: String, raw: [String], json: Bool)
    // `jet fmt [paths…] [-] [-- paths…]`.
    Fmt(request: JetCLIFmtRequest)
    // `jet fmt --lang <language>`: the environment formatter over staged files;
    // `argv` starts at `fmt`.
    FmtLang(argv: [String], color: Bool)
    // Normal diagnostic fixes use the shared edit engine and a held codemod
    // transaction. Memory fixes retain their independent witness consumer.
    // `style`: `--style`, the moves the opt-in style checks name (StyleCheck.jet).
    Fix(file: String, dry_run: Bool, all: Bool, markers: String, style: Bool, color: Bool, quiet: Bool, json: Bool, notice: String)
    // An inspect projection over a checked entry (Inspect.jet): the host
    // compiles `job.file`, then projects the checked program.
    Inspect(job: JetCLIInspectJob)
    // An inspect command the host runs (InspectB.jet).
    InspectB(plan: JetCLIInspectBPlan)
    // `jet inspect bind <language> …` (ForeignBind.jet): `run_<language>_bind`
    // for the words after the language.
    ForeignBind(binder: JetCLIForeignBinder, args: [String], color: Bool)
    // `jet perf view|compare|export …` (Perf/Command.jet): `argv` starts at `perf`.
    Perf(argv: [String], color: Bool)
    // `jet inspect semindex <file>`: the host checks the absolute `file` and
    // prints its semantic index.
    Semindex(file: String, color: Bool, json: Bool)
    // `jet find <query> [<entry>]`: the host checks `file` (none: the language
    // catalog alone) and searches its semantic symbols for `mode`; `query` is
    // the joined text words.
    Find(file: String?, query: String, mode: JetCLIFindMode, json: Bool)
    // `jet cache status|prune|limit`: `args` is the
    // raw tail after `cache`, option spellings and order intact.
    Cache(args: [String], json: Bool)
    // `jet remote …`: `argv` is the full normalized argv, starting at `remote`.
    Remote(argv: [String], json: Bool, color: Bool)
    // `jet test-compare <corpus.json>`: the corpus as typed and the jet-owned
    // argv the receipt identity frames.
    Comparison(target: String, argv: [String], json: Bool)
    // CmdTry uses the actual invocation-owned checked projection and counters.
    // Quiet does not change its output contract; JSON selects its wire report.
    Try(plan_path: String, keep: Bool, json: Bool)
    // `jet self devtools new-ui|check-fixture-paths|reduce|ice-report`
    // `args` is the raw argv after the tool word; their confirmations are
    // direct bytes under --json/--quiet too.
    Maintenance(action: String, args: [String], color: Bool, json: Bool)
    // `jet self completions <shell> --for <program>`: `name` is the program's
    // checked command name; the host opens and reads the program without
    // executing it.
    Completion(shell: String, program: String, name: String)
    // `jet inspect schema status|squash` for the project rooted at `root`;
    // `before` is squash's cutoff.
    Schema(action: String, root: String, before: String, color: Bool, json: Bool)
    // `jet inspect codemod` (`run_codemod`, Codemod.jet): `action` is `plan`
    // (`<plan.json> --dry-run`), `apply`, or `undo`; `path` the plan or replay
    // log as given; `yes` confirms an apply.
    Codemod(action: String, path: String, yes: Bool, color: Bool, json: Bool)
    // `jet explain <policy-key> <file>` and `jet explain marker <file>:<line>
    // <policy-key>` (`run_explain_policy`/`run_explain_marker`): the policy
    // essay over the authorized load-only query of `file`.
    PolicyExplain(key: PolicyKey, file: String, site: String?, line: U64?, color: Bool, json: Bool)
    // `jet explain <module>.<Type> [file]`: a library diagnostic type's
    // `Diagnostic` texts as written, holes included, over the load-only
    // query of `file` (default: the current directory's project).
    DiagnosticTypeExplain(name: String, file: String, color: Bool, json: Bool)
    // `jet explain <build fact> [file] [--profile <name>] [--set name=value]`:
    // the fact's writer chain over the load of `file` (default: the current
    // directory's project), under the selected profile and `--set` writers;
    // `module_value` is the module value of a `<binding>.<function>` query
    // that the fact feeds (BuildFactExplain.jet).
    BuildFactExplain(key: String, file: String, profile: String, settings: [BuildSettingOverride], module_value: JetCLIModuleValue?, color: Bool, json: Bool)
    // `jet inspect gates`: the load-only gate ledger of `file` with the
    // canonical external writers; `args` is the entry followed by the plane
    // flags, `notice` is resolution's stderr.
    Gates(file: String, args: [String], color: Bool, json: Bool, notice: String)
    // `jet inspect output <file> [<address>]`: the sema-selected Output of the
    // authorized request of `file`.
    Output(file: String, address: String?, color: Bool, json: Bool)
    // `jet self doctor` (Doctor.jet): environment self-diagnosis; `apply` is
    // `--fix`, `cross_target` the rustc triple `--target` selects.
    Doctor(online: Bool, apply: Bool, cross_target: String?, color: Bool)
    // `jet update jet [<channel>]`: move the toolchain pin of the project at
    // `root` (ToolchainPin.jet) on the host, since its channel resolution and
    // lock write need `Exec` and `Time.Wait`.
    UpdateJet(root: String, channel: String?, color: Bool, json: Bool, quiet: Bool)
    // `jet audit copies [<entry.jet>]` / `jet audit <file.jet>`
    // (AuditCopies.jet): the implicit copies of `file`'s checked package.
    AuditCopies(file: String, source: String, color: Bool, json: Bool, notice: String)
    // `jet audit writes [<entry.jet>]` (AuditWrites.jet): the calls of
    // `file`'s checked package that change or take a named value.
    AuditWrites(file: String, source: String, color: Bool, json: Bool, notice: String)
    // `jet audit foreign [<entry.jet>]` (AuditForeign.jet): the foreign code
    // of `file`'s program and the loader needs of its linked image.
    AuditForeign(file: String, source: String, color: Bool, json: Bool, notice: String)
    // `jet __jetpack <op>` (JetpackService.jet): the internal compiler
    // service `jetpack` speaks over stdin/stdout; never in help.
    CompilerService(op: String)
    // `jet repl [file.jet] [--project <dir>]` (Repl.jet): the line session;
    // `preload` is its first positional.
    Repl(project: String?, preload: String?, invocation: JetCLIInvocationAuthority?, color: Bool)
    // `jet self lsp` (LSP.jet): the language server over stdin and stdout.
    LSP
    // `jet __jet_repl_run_stdin --session=<nonce>` (Repl.jet): the private
    // child that runs one REPL turn's binary; never in help.
    ReplChild(invocation: JetCLIInvocationAuthority?)
    // `jet eval <expression>` (Repl.jet): one REPL turn.
    EvalExpression(source: String, color: Bool, json: Bool)
    // `jet prove TARGET [--lens L]... [--capture | --capture-sensitive |
    // --replay]` (ProveReport.jet): the checked front end, the test producer,
    // the ProofReport and its artifact. `lenses` only shape the human report;
    // `capture` and `replay` add the replay preflight (ProveReplay.jet).
    Prove(target: JetCLIProveTarget, lenses: [String], capture: JetCLIProveCapture?, replay: String?, color: Bool, json: Bool)
    // `jet budget check` (Budget.jet): the checked budget specs of the
    // project entry `entry` under `root`, and their canonical report.
    Budget(options: JetCLIBudgetOptions, root: String, entry: String, color: Bool)
}

// One native `jet fmt` invocation (`"fmt"` -> `run_fmt`).
JetCLIFmtRequest: struct {
    // Explicit file/directory targets; empty formats the project root.
    paths: [String]
    // `-`: format stdin to stdout under the `stdin_path` label.
    stdin_mode: Bool
    stdin_path: String?
    // `--check`/`--dry-run` report instead of writing; `diff` adds unified diffs.
    check: Bool
    diff: Bool
    // `--changed`: only the VCS-changed `.jet` files (git).
    changed: Bool
    // `--explicit-copies`: write `.copy()` at each implicit copy site sema reports.
    explicit_copies: Bool
    simplify: Bool
    color: Bool
    quiet: Bool
    // `--json`: the Rust status envelopes (`--check` clean/dirty/diff, preflight errors).
    json: Bool{false}
}

// The `jet test` options the Jet host carries out. `capture` is `failed`,
// `all`, or `none`; `status` is the stderr status text the Rust host writes
// before the compile.
JetCLITestOptions: struct {
    build: BuildOptions
    capture: String
    filter: String?
    shuffle_seed: String?
    serial: Bool
    trace_tiers: Bool
    update_snapshots: Bool
    // `--docs`: run only the doctest claims (Doctests.jet).
    docs: Bool
    // `--measure`: run only the measured claims, timed (Measure.jet), under
    // `profile`; `--json` prints its records as JSON lines.
    measure: Bool
    json: Bool
    profile: String
    project_root: String?
    status: String
    // The decided `jet test` settings (TestSettingLayers.jet), for those
    // the harness run reads itself: shard, list, results, time_limit.
    settings: [TestSetting]{[TestSetting]{}}
    // `--show-default`: the stock harness, never the package's `test: fn`.
    stock: Bool{false}
    // `--quiet`: no status lines on stderr.
    quiet: Bool{false}
}

// Commands that validate their own flags.
JET_CLI_OWNS_FLAGS: [String]{
    "env", "cc", "c++", "remote", "dev", "devtools", "push", "trust", "bridge",
    "services", "image", "new", "flash", "os", "add", "remove", "bind", "lsp", "config", "update",
    "outdated", "search", "info", "import", "explain", "logs", "clean", "fetch", "publish", "yank",
    "keygen", "key", "vendor", "audit", "sbom", "repl", "notebook", "schema", "db", "semindex",
    "impact", "codemod", "generate", "expand", "diff", "merge", "review", "prove", "budget", "perf",
    "completions", "self-update",
}

// Flags whose value is the next argv word.
JET_CLI_SEPARATE_VALUE_FLAGS: [String]{
    "-p", "--fixtures", "--env", "--preset", "--set", "--builder", "--output", "--profile",
    "--target", "--endpoint", "--channel", "--platform", "--trust-key", "--gate", "--allow",
    "--deny", "--scope", "--live", "--replay", "--project", "--console-ttl", "--app", "--share",
    "--token", "--base-receipt", "--receipt", "--head-receipt", "--after-receipt", "--canvas-host",
    "--canvas-port", "--canvas-transport", "--canvas-authority", "--where", "--capture",
    "--browser", "--browser-retries", "--browser-reporter", "--filter", "--shuffle", "--verify",
    "--template", "--sort", "--threads", "--fn", "--markers", "--edition",
}

// `--name=value` spellings that never become positional words.
JET_CLI_VALUE_PREFIXES: [String]{
    "--verify=", "--output=", "--where=", "--capture=", "--endpoint=", "--channel=",
    "--platform=", "--trust-key=", "--set=", "--scope=", "--kind=", "--live=", "--replay=",
    "--target=", "--app=", "--share=", "--token=", "--canvas-host=", "--canvas-port=",
    "--canvas-transport=", "--canvas-authority=", "--threads=", "--fn=", "--markers=", "--edition=",
}

// Flags an external formatter accepts with `jet fmt --lang`.
JET_CLI_EXTERNAL_FMT_FLAGS: [String]{
    "--trust", "--offline", "--online", "--no-color", "--json", "--flake", "--pure", "--yes",
    "--fixtures", "--preset", "--env",
}

// `cli_diagnostic_copy`: the shared Why line of a CLI code.
jet_cli_why: fn(code: String) -> String Never! {
    if code == {
        "E2101" -> return "Jet command groups accept only commands in their named area"
        "E2102" -> return "Jet ignores no flags silently, so a typo cannot quietly change a command"
        "E2104" -> return "Jet needs valid command input before it can run this command"
        "E2105" -> return "Jet could not complete the named file, tool, or operating-system operation"
        "E2113" -> return "`b.pin(.option, .Value)` in `build: fn` fixes a build option for every build; a flag may only change values that aren't pinned"
        else -> {}
    }
    "Jet could not complete this command"
}

// One spanless CLI diagnostic, rendered as the host prints it.
jet_cli_report: fn(code: String, what: String, why: String, fix: String, color: Bool) -> String Never! {
    diagnostic_render_all("", "", [Diagnostic]{diagnostic_from_registry(code, None, what, why, fix)}, color)
}

// A failed verb with one spanless CLI diagnostic: `notice` and the rendered
// report on stderr, and the typed report a `--json` run prints in its place
// (jet_cli_json_outcome).
jet_cli_report_output: fn(notice: String, code: String, what: String, why: String, fix: String, color: Bool, exit_code: Int) -> JetDriverVerbOutput Never! {
    reports: [Diagnostic]{diagnostic_from_registry(code, None, what, why, fix)}
    stderr: "{notice}{diagnostic_render_all("", "", reports, color)}"
    JetDriverVerbOutput{stdout: "", stderr: stderr, exit_code: exit_code, failure: Val(JetDriverFailure{reports: reports, notice: notice})}
}

jet_cli_done: fn(stdout: String, stderr: String, exit_code: Int) -> JetCLIPlan Never! {
    JetCLIPlan.Done{output: JetDriverVerbOutput{stdout: stdout, stderr: stderr, exit_code: exit_code}}
}

// The plan of that failure (jet_cli_report_output).
jet_cli_report_done: fn(notice: String, code: String, what: String, why: String, fix: String, color: Bool, exit_code: Int) -> JetCLIPlan Never! {
    JetCLIPlan.Done{output: jet_cli_report_output(notice, code, what, why, fix, color, exit_code)}
}

// A failure the Rust host printed as one plain stderr line: `text` stays those
// bytes, and a `--json` run prints `code`'s typed report with `what` and `fix`
// instead.
jet_cli_plain_failure: fn(text: String, code: String, what: String, fix: String, exit_code: Int) -> JetDriverVerbOutput Never! {
    JetDriverVerbOutput{stdout: "", stderr: text, exit_code: exit_code, failure: Val(JetDriverFailure{reports: [Diagnostic]{diagnostic_from_registry(code, None, what, jet_cli_why(code), fix)}, notice: ""})}
}

jet_cli_diagnostics_output: fn(file: String, source: String, report: Diagnostic, color: Bool, json: Bool, notice: String) -[FS, Env]> JetDriverVerbOutput Never! {
    if json -> return JetDriverVerbOutput{stdout: jet_cli_reports_status_json("diagnostics", false, jet_cli_report_base(file), file, source, [Diagnostic]{report}), stderr: notice, exit_code: JET_DRIVER_EXIT_USER_ERROR}
    JetDriverVerbOutput{stdout: "", stderr: "{notice}{diagnostic_render_all(file, source, [Diagnostic]{report}, color)}", exit_code: JET_DRIVER_EXIT_USER_ERROR}
}

jet_cli_fail: fn(code: String, what: String, why: String, fix: String, color: Bool, exit_code: Int) -> JetCLIPlan Never! {
    JetCLIPlan.Refused{report: diagnostic_from_registry(code, None, what, why, fix), color: color, exit_code: exit_code, notice: ""}
}

// A real `jet` command form that is not built yet: refused, never guessed.
jet_cli_not_ported: fn(form: String, color: Bool) -> JetCLIPlan Never! {
    JetCLIPlan.Done{output: jet_cli_not_ported_output(form, color)}
}

// The bytes and status of that refusal, for a host-side projection. The Fix
// line names the Tower card the command model (JET_CLI_FORMS) gives the form.
jet_cli_not_ported_output: fn(form: String, color: Bool) -> JetDriverVerbOutput Never! {
    owner: if jet_cli_form_card(form) == .Val(card) -> " (card #{card})" else -> ""
    jet_cli_report_output("", "E2104", "`jet {form}` is not built yet", "This `jet` has no implementation of this command form yet, and no other `jet` can run it.", "Use a form this `jet` supports (`jet help` lists them); this one needs its Jet implementation first{owner}.", color, JET_DRIVER_EXIT_USAGE)
}

jet_cli_prefix: fn(items: [String], end: Int) -> [String] Never! {
    prefix := [String]{}
    loop index in 0..<end -> prefix.push(items[index])
    prefix
}

jet_cli_tail: fn(items: [String], start: Int) -> [String] Never! {
    tail := [String]{}
    loop index in start..<items.len() -> tail.push(items[index])
    tail
}

// The Rust original moves the first command word to `raw[0]`, keeping the order
// of every other word.
jet_cli_command_first: fn(items: [String], command: String) -> [String] Never! {
    at := 0
    loop (index, item) in items {
        if item == command {
            at = index
            break
        }
    }
    out := [String]{items[at].copy()}
    loop (index, item) in items {
        if index != at -> out.push(item.copy())
    }
    out
}

jet_cli_has: fn(items: [String], value: String) -> Bool Never! {
    items.contains(value)
}

jet_cli_is_help_flag: fn(argument: String) -> Bool Never! {
    argument == "--help" || argument == "-h"
}

jet_cli_any_help_flag: fn(items: [String]) -> Bool Never! {
    loop item in items {
        if jet_cli_is_help_flag(item) -> return true
    }
    false
}

// `is_diagnostic_code`: `E1234`, `L1234`, or `JT1234`.
jet_cli_is_diagnostic_code: fn(value: String) -> Bool Never! {
    bytes: value.bytes()
    digits_from := 0
    if {
        bytes.len() == 5 && (bytes[0] == (U8{69}) || bytes[0] == (U8{76})) -> digits_from = 1
        bytes.len() == 6 && bytes[0] == (U8{74}) && bytes[1] == (U8{84}) -> digits_from = 2
        else -> return false
    }
    loop index in digits_from..<bytes.len() {
        digit: Int.from_u8(bytes[index])
        if digit < 48 || digit > 57 -> return false
    }
    true
}

// Rust `{:?}` of a plain request value.
jet_cli_debug_quote: fn(value: String) -> String Never! {
    "\"{value.replace("\\", "\\\\").replace("\"", "\\\"")}\""
}

// The value of `--flag=value` or `--flag value`.
jet_cli_option_value: fn(items: [String], flag: String) -> String? Never! {
    loop (index, item) in items {
        if item.starts_with("{flag}=") -> return Val(item.slice(flag.len() + 1..<item.len()))
        if item == flag {
            if index + 1 < items.len() -> return Val(items[index + 1])
            return None
        }
    }
    None
}

// The `jet help --sort` value; "frequency" when no order is asked for.
jet_cli_help_order: fn(jet_argv: [String]) -> String Never! {
    asked := false
    loop item in jet_argv {
        if item == "--sort" || item.starts_with("--sort=") -> asked = true
    }
    if !asked -> return "frequency"
    jet_cli_option_value(jet_argv, "--sort") ?? ""
}

// E2104 for a `--sort` value other than frequency, az, or za.
jet_cli_bad_help_order: fn(value: String, color: Bool) -> JetCLIPlan Never! {
    jet_cli_fail("E2104", "`{value}` is not a `jet help` order", jet_cli_why("E2104"), "choose one of {JET_CLI_HELP_ORDERS}: `jet help --sort az`", color, JET_DRIVER_EXIT_USAGE)
}

// The jet-owned positional words before `--`: flags and the values they swallow
// are dropped; bare `-` stays.
jet_cli_positionals: fn(jet_argv: [String]) -> [String] Never! {
    positionals := [String]{}
    skip_next := false
    explain: jet_argv.len() > 0 && jet_argv[0] == "explain"
    loop argument in jet_argv {
        if skip_next {
            skip_next = false
            next
        }
        if JET_CLI_SEPARATE_VALUE_FLAGS.contains(argument) {
            skip_next = true
            next
        }
        prefixed := false
        loop prefix in JET_CLI_VALUE_PREFIXES {
            if argument.starts_with(prefix) -> prefixed = true
        }
        if prefixed -> next
        // `jet explain ->`: a syntax token that starts with `-` stays a query.
        explain_token: explain && argument.starts_with("-") && !argument.starts_with("--") && argument != "-"
        if argument == "-" || !argument.starts_with("-") || explain_token -> positionals.push(argument.copy())
    }
    positionals
}

// `check_flags`: the first flag no registry row has teaches E2102, a `--flag`
// and a single-dash word alike, and so does the first registered `--flag`
// whose registry row scopes it to other commands. The word after a
// separate-value flag is its value, never a flag.
jet_cli_check_flags: fn(jet_argv: [String], command: String, color: Bool) -> JetCLIPlan? Never! {
    external_fmt := false
    if command == "fmt" {
        loop argument in jet_argv {
            if argument == "--lang" || argument.starts_with("--lang=") -> external_fmt = true
        }
    }
    value_next := false
    loop argument in jet_argv {
        if value_next {
            value_next = false
            next
        }
        if JET_CLI_SEPARATE_VALUE_FLAGS.contains(argument) -> value_next = true
        if !argument.starts_with("-") || argument == "-" || argument == "--" -> next
        head: argument.split("=").to_list()[0]
        if jet_cli_is_help_flag(head) -> next
        if !argument.starts_with("--") {
            if jet_cli_is_known_flag(head) -> next
            return Val(jet_cli_unknown_flag(head, command, color))
        }
        if external_fmt && JET_CLI_EXTERNAL_FMT_FLAGS.contains(head) -> next
        if jet_cli_flag_spec(head) == .Val(spec) {
            if !jet_cli_flag_takes(spec, command) -> return Val(jet_cli_misplaced_flag(head, command, jet_cli_flag_commands(spec.help) ?? [String]{}, color))
            if jet_cli_control_of_flag(head) != None {
                if jet_cli_control_refusal(argument, head, color) == .Val(refusal) -> return Val(refusal)
                next
            }
            if jet_cli_flag_value_refusal(argument, head, spec, color) == .Val(refusal) -> return Val(refusal)
            next
        }
        if build_option_flag_refusal(head) == .Val(refusal) -> return Val(jet_cli_fail("E2102", "`{head}` isn't a build option jet has", refusal.law, "drop `{head}`", color, JET_DRIVER_EXIT_USAGE))
        return Val(jet_cli_unknown_flag(head, command, color))
    }
    None
}

// E2102 for a value written after a flag whose registry row takes none: a
// Switch takes no `=value` (`--check=true`), and a Bool takes only `=true`
// or `=false`. Never ignored, so a value cannot quietly turn a flag off.
jet_cli_flag_value_refusal: fn(argument: String, head: String, spec: JetCLIFlagSpec, color: Bool) -> JetCLIPlan? Never! {
    if argument == head -> return None
    value: argument.slice(head.len() + 1..<argument.len())
    if spec.value == {
        .Switch -> return Val(jet_cli_fail("E2102", "`{argument}` isn't a flag jet understands: `{head}` takes no value", jet_cli_why("E2102"), "write `{head}` alone", color, JET_DRIVER_EXIT_USAGE))
        .Bool -> {
            if value != "true" && value != "false" -> return Val(jet_cli_fail("E2102", "`{argument}` isn't a flag jet understands: `{head}` takes `=true` or `=false`", jet_cli_why("E2102"), "write `{head}` or `{head}=false`", color, JET_DRIVER_EXIT_USAGE))
        }
        .Value | .Optional | .Repeated -> {}
    }
    None
}

// Does `command` read the short level flags as `--optimize`? Every command
// does but one that validates its own flags and takes no `--optimize`.
jet_cli_takes_level_words: fn(command: String) -> Bool Never! {
    if !JET_CLI_OWNS_FLAGS.contains(command) -> return true
    spec: jet_cli_flag_spec("--optimize") ?? return false
    jet_cli_flag_takes(spec, command)
}

// `argv` with each short level flag `-O<n>` among its first `end` words
// written as its `--optimize=<value>` (AGENTS.md I9), so precedence, pins,
// conflicts and the cache identity are the long flag's. A separate-value
// flag's value word stays as written.
jet_cli_level_words: fn(argv: [String], end: Int) -> [String] Never! {
    words := [String]{}
    value_next := false
    loop (index, word) in argv {
        spelling: if index < end && !value_next -> build_option_level_spelling(word) else -> String?{None}
        value_next = index < end && !value_next && JET_CLI_SEPARATE_VALUE_FLAGS.contains(word)
        words.push(spelling ?? word.copy())
    }
    words
}

// E2102 for a flag no registry row has.
jet_cli_unknown_flag: fn(head: String, command: String, color: Bool) -> JetCLIPlan Never! {
    what: "`{head}` isn't a flag jet understands"
    why: "flags before `--` belong to jet; everything after `--` is forwarded to your program"
    program: command == "run" || command == "dev" || command == "test"
    fix := ""
    if jet_cli_closest_flag(head) == .Val(close) {
        if {
            program -> fix = "did you mean `{close}`? Or use `jet {command} <file> -- {head}` to pass it to your program"
            command == "jobs" -> fix = "did you mean `{close}`? Or write it after the job name, `jet {command} <name> {head}`, to pass it to the job"
            else -> fix = "did you mean `{close}`? (run `jet help` for the flags)"
        }
    } else {
        if {
            program -> fix = "use `jet {command} <file> -- {head}` to pass this flag to your program"
            command == "jobs" -> fix = "write it after the job name, `jet {command} <name> {head}`, to pass it to the job"
            else -> fix = "drop the flag, or run `jet help` to see the flags"
        }
    }
    jet_cli_fail("E2102", what, why, fix, color, JET_DRIVER_EXIT_USAGE)
}

// E2102 for a registered flag the command does not take: names the commands
// whose registry row takes it (the cli_registry test keeps that list nonempty).
jet_cli_misplaced_flag: fn(flag: String, command: String, takers: [String], color: Bool) -> JetCLIPlan Never! {
    names := [String]{}
    loop taker in takers -> names.push("`jet {taker}`")
    listed := names[0].copy()
    if names.len() > 1 -> listed = "{jet_cli_prefix(names, names.len() - 1).join(", ")} or {names[names.len() - 1]}"
    jet_cli_fail("E2102", "`{flag}` is only valid with {listed}", jet_cli_why("E2102"), "drop `{flag}` from `jet {command}`, or run `jet {takers[0]} {flag}`", color, JET_DRIVER_EXIT_USAGE)
}

// The directory part of `path`, as Rust `Path::parent` reads it.
jet_cli_parent: fn(path: String) -> String? Never! {
    if path == "/" -> return None
    parts: path.split("/").to_list()
    if parts.len() <= 1 -> return None
    parent: jet_cli_prefix(parts, parts.len() - 1).join("/")
    if parent == "" -> return Val("/")
    Val(parent)
}

// Is there a `package.jet` in `directory` or above it?
jet_cli_has_manifest_above: fn(directory: String) -[FS]> Bool Never! {
    current := directory
    loop {
        if cli_files.is_file("{current}/package.jet") -> return true
        current = jet_cli_parent(current) ?? return false
        if current == "/" -> return cli_files.is_file("/package.jet")
    }
}

// The nearest directory at or above `directory` with a `package.jet`.
jet_cli_manifest_root: fn(directory: String) -[FS]> String? Never! {
    current := directory
    loop {
        if cli_files.is_file("{current}/package.jet") -> return Val(current)
        current = jet_cli_parent(current) ?? return None
        if current == "/" {
            if cli_files.is_file("/package.jet") -> return Val("/")
            return None
        }
    }
}

// `project_root`: the working directory's selected project root
// (ProjectRoot.jet), else the working directory itself.
jet_cli_selected_root_or_cwd: fn() -[FS, Env]> String Never! {
    cwd: cli_files.cwd() ?? "."
    cache := WorkspaceDeclarationCache.new()
    jet_cli_selected_project_root(cache, cwd) ?? cwd
}

// `"gc"`: `gc report` is the only subcommand.
jet_cli_gc: fn(argv: [String], args: [String], color: Bool, json: Bool) -[FS, Env, Time, Time.Wait]> JetCLIPlan Never! {
    if args.len() < 2 {
        return jet_cli_fail("E2101", "`jet gc` needs a subcommand", "`jet gc report` prints the automatic-promotion report; `jet clean` cleans the package store", "run `jet gc report`", color, JET_DRIVER_EXIT_USAGE)
    }
    if args[1] != "report" {
        return jet_cli_fail("E2101", "`{args[1]}` isn't a jet gc command", "jet gc currently exposes only the automatic-promotion report", "run `jet gc report`", color, JET_DRIVER_EXIT_USAGE)
    }
    jet_cli_gc_report_at(jet_cli_selected_root_or_cwd(), jet_cli_tail(argv, 2), color, json)
}

// `run_status`: the one target (by default the stock project entry, relative to
// the working directory) read against the receipt root `jet prove <target>`
// selects (`receipt_root_for` / `target_path`).
jet_cli_status: fn(status_args: [String], color: Bool, json: Bool) -[FS, Env, Time.Wait]> JetCLIPlan Never! {
    cwd: cli_files.cwd() ?? "."
    explicit := String?{None}
    if jet_cli_project_status_target(status_args) == {
        .Ok(found) -> explicit = found
        .Err(message) -> return jet_cli_fail("E2102", message.message, "jet status accepts one project target and registered output flags", "run `jet status [<file.jet|dir>]` with one target", color, JET_DRIVER_EXIT_USAGE)
    }
    notices := [String]{}
    target := explicit ?? ""
    if explicit == None {
        root: jet_cli_manifest_root(cwd) ?? cwd
        entry := ""
        found_entry: jet_cli_find_project_entry(root, "status", color, notices)
        if found_entry == {
            .Entry(found) -> entry = found.path
            .Refused(plan) -> return jet_cli_with_notices(notices, plan)
            .Absent -> entry = jet_cli_entry_join(cli_files.realpath(root) ?? root, JET_CLI_DEFAULT_ENTRY_FILE)
        }
        prefix: if cwd.ends_with("/") -> cwd else -> "{cwd}/"
        target = if entry == cwd -> "" else if entry.starts_with(prefix) -> entry.slice(prefix.len()..<entry.len()) else -> entry
    }
    candidate: if target.starts_with("/") -> target else -> jet_cli_entry_join(cwd, target)
    start := cwd
    if cli_files.exists(candidate) || candidate.ends_with(".jet") {
        start = candidate
    } else if cli_files.is_file("{candidate}.jet") {
        start = "{candidate}.jet"
    }
    if !cli_files.is_dir(start) -> start = jet_cli_parent(start) ?? start
    cache := WorkspaceDeclarationCache.new()
    root: jet_cli_receipt_project_root(cache, start)
    jet_cli_with_notices(notices, jet_cli_project_status_at(root, cwd, target, json))
}

// `jet <word>` sugar for `jet run <word>`.
jet_cli_looks_like_source: fn(argument: String) -[FS]> Bool Never! {
    if argument.ends_with(".jet") -> return true
    if cli_files.exists(argument) -> return cli_files.is_file(argument) || cli_files.is_dir(argument)
    cli_files.exists("{argument}.jet")
}

// The extension of `path`'s last component, after its last `.`; "" when it
// has none (a leading dot alone, as in `.profile`, is none).
jet_cli_source_extension: fn(path: String) -> String Never! {
    parts := jet_cli_file_name(path).split(".").to_list()
    if parts.len() < 2 || (parts.len() == 2 && parts[0] == "") -> return ""
    parts.pop() ?? ""
}

// Jet tells a file's language by its extension (#6686, the one table
// KIT_SOURCE_LANGUAGES): `.jet` (or none) is Jet source, and `jet run` and
// `jet build` compile the C and C++ extensions with the C toolchain Jet
// programs compile their own C with (ForeignLink.jet); any other extension is
// refused (E2116). The language `path` compiles as: "c" or "c++", None for
// any other file.
jet_cli_native_language: fn(path: String) -> String? Never! {
    language: kit_source_language(jet_cli_source_extension(path)) ?? return None
    if language == "jet" -> return None
    Val(language)
}

// Whether `path` is a Jet script whatever its name: its first line is a
// `#!` line that names jet, as in `#!/usr/bin/env jet`. The kernel runs such
// a file as `jet <path>`, so its extension, if any, says nothing.
jet_cli_jet_script: fn(path: String) -[FS]> Bool Never! {
    text: cli_files.read(path) ?? return false
    if !text.starts_with("#!") -> return false
    text.partition("\n").head.contains("jet")
}

// `jet {command} <file>` of a file whose extension the command doesn't
// handle (E2116), naming the extensions it does; never read as Jet source.
jet_cli_unhandled_extension: fn(file: String, extension: String, command: String, color: Bool) -> JetCLIPlan Never! {
    accepted := [String]{}
    loop row in KIT_SOURCE_LANGUAGES {
        if row.language == "jet" || command == "run" || command == "build" -> accepted.push(row.extension.copy())
    }
    shown := ""
    loop (index, name) in accepted {
        if index > 0 -> shown = if index == accepted.len() - 1 -> "{shown} and " else -> "{shown}, "
        shown = "{shown}`.{name}`"
    }
    row: diagnostic_registry_row("E2116") ?? panic("E2116 is not registered")
    jet_cli_fail("E2116", jet_cli_extension_text(row.what, file, extension, command, shown), jet_cli_extension_text(row.why, file, extension, command, shown), jet_cli_extension_text(row.fix, file, extension, command, shown), color, JET_DRIVER_EXIT_USAGE)
}

// An E2116 row text with its holes filled.
jet_cli_extension_text: fn(text: String, file: String, extension: String, command: String, accepted: String) -> String Never! {
    text.replace("{{file}}", file).replace("{{extension}}", extension).replace("{{command}}", command).replace("{{accepted}}", accepted)
}

// The argv index of the file the `jet <file> [args...]` shorthand runs, when
// the first command word is one. Every word after it is the program's, as a
// shell hands a script its arguments, so a `#!/usr/bin/env jet` file runs
// with exactly the arguments it was launched with.
jet_cli_shorthand_file: fn(argv: [String]) -[FS]> Int? Never! {
    skip_next := false
    loop (index, argument) in argv {
        if skip_next {
            skip_next = false
            next
        }
        if argument == "--" -> return None
        if JET_CLI_SEPARATE_VALUE_FLAGS.contains(argument) {
            skip_next = true
            next
        }
        if argument.starts_with("-") && argument != "-" -> next
        if jet_cli_is_builtin(argument) || !jet_cli_looks_like_source(argument) || cli_files.is_dir(argument) -> return None
        return Val(index)
    }
    None
}

// The argv index of `jet -e CODE`'s `-e`: a flag before the first command
// word, as the `jet <file>` shorthand's file is the first, or right after a
// leading `run` (`jet run -e CODE`).
jet_cli_eval_flag_at: fn(argv: [String]) -> Int? Never! {
    skip_next := false
    command := false
    loop (index, argument) in argv {
        if skip_next {
            skip_next = false
            next
        }
        if argument == "-e" -> return Val(index)
        if argument == "run" && !command {
            command = true
            next
        }
        if argument == "--" || !argument.starts_with("-") || argument == "-" -> return None
        if JET_CLI_SEPARATE_VALUE_FLAGS.contains(argument) -> skip_next = true
    }
    None
}

// The argv index of `jet run -`'s `-`: the target word after `run`, which
// reads the program's source from standard input.
jet_cli_stdin_source_at: fn(argv: [String]) -> Int? Never! {
    skip_next := false
    command := false
    loop (index, argument) in argv {
        if skip_next {
            skip_next = false
            next
        }
        if argument == "--" -> return None
        if argument == "-" {
            if command -> return Val(index)
            return None
        }
        if argument.starts_with("-") {
            if JET_CLI_SEPARATE_VALUE_FLAGS.contains(argument) -> skip_next = true
            next
        }
        if command || argument != "run" -> return None
        command = true
    }
    None
}

// The argv indexes of `jet eval CODE`'s `eval` and CODE: CODE is the first
// word after `eval` that is not a flag, unless it names a source file or a
// project (the file form, jet_cli_eval) or is a `:meta` word. `--json` and
// `--pure`, before or after CODE (`jet eval "1 + 2" --json`), keep the
// expression form (JetCLIPlan.EvalExpression).
jet_cli_eval_code_at: fn(argv: [String]) -[FS]> (verb: Int, code: Int)? Never! {
    loop argument in argv {
        if argument == "--" -> break
        if argument == "--json" || argument == "--pure" -> return None
    }
    skip_next := false
    verb := Int?{None}
    loop (index, argument) in argv {
        if skip_next {
            skip_next = false
            next
        }
        if argument == "--" -> return None
        if argument.starts_with("-") && argument != "-" {
            if JET_CLI_SEPARATE_VALUE_FLAGS.contains(argument) -> skip_next = true
            next
        }
        if verb == .Val(at) {
            if argument.starts_with(":") || jet_cli_looks_like_source(argument) -> return None
            return Val((verb: at, code: index))
        }
        if argument != "eval" -> return None
        verb = Val(index)
    }
    None
}

// The commands that compile, and so take `--threads N`.
JET_CLI_THREADS_COMMANDS: [String]{"build", "run", "check", "test", "dev", "inspect"}

// `--threads N` (or `--threads=N`) before `--`: `None` when absent, else the
// cap, or the usage error that names the flag.
// `--jobs` and `-j`, the spelling other build tools use, are refused on the
// compiling commands with a pointer to `--threads`; `jet jobs` is unchanged,
// and `jet test --jobs=<n>` is its corpus pool's width (TestSettings.jet).
jet_cli_threads: fn(jet_argv: [String], command: String, color: Bool) -> JetCLIThreads Never! {
    compiling: JET_CLI_THREADS_COMMANDS.contains(command)
    loop (index, argument) in jet_argv {
        jobs_flag: argument == "--jobs" || argument.starts_with("--jobs=") || argument == "-j" || (argument.starts_with("-j") && argument.len() > 2)
        pool_width: command == "test" && argument.starts_with("--jobs=")
        if compiling && jobs_flag && !pool_width {
            return JetCLIThreads.Refused{plan: jet_cli_fail("E2102", "`{argument.split("=").to_list()[0]}` isn't a flag jet understands", "`jet jobs` runs your project's named jobs; the compiler's thread cap is `--threads`", "write `--threads N` to cap the compiler at N threads", color, JET_DRIVER_EXIT_USAGE)}
        }
        value := String?{None}
        if argument.starts_with("--threads=") -> value = Val(argument.slice(10..<argument.len()))
        if argument == "--threads" -> value = Val(if index + 1 < jet_argv.len() -> jet_argv[index + 1] else -> "")
        text: value ?? next
        if !compiling {
            return JetCLIThreads.Refused{plan: jet_cli_fail("E2102", "`--threads` is only valid with a command that compiles", jet_cli_why("E2102"), "use it with `jet build`, `run`, `check`, `test`, `dev`, or `inspect`", color, JET_DRIVER_EXIT_USAGE)}
        }
        count: Int.parse(text) ?? 0
        if count < 1 {
            return JetCLIThreads.Refused{plan: jet_cli_fail("E2104", "`--threads` needs a whole number of compiler threads, at least 1, not `{text}`", jet_cli_why("E2104"), "write `--threads 1` for one compiler thread, or leave the flag out to let jet choose", color, JET_DRIVER_EXIT_USAGE)}
        }
        return JetCLIThreads.Cap{threads: Val(count)}
    }
    JetCLIThreads.Cap{threads: None}
}

JetCLIThreads: enum {
    Cap(threads: Int?)
    Refused(plan: JetCLIPlan)
}

#Test("every jet test setting flag gets past the compiler's --jobs and -j refusal") {
    loop row in JET_TEST_SETTINGS {
        flag: test_setting_flag(row.name)
        if jet_cli_threads_refused([String]{"test", "{flag}=1"}, "test") -> panic("`jet test {flag}=1` is refused as a thread cap")
    }
    assert(jet_cli_threads_refused([String]{"build", "--jobs=2"}, "build"))
    assert(jet_cli_threads_refused([String]{"test", "--jobs", "2"}, "test"))
    assert(jet_cli_threads_refused([String]{"test", "-j4"}, "test"))
}

// Whether jet_cli_threads refuses `jet_argv` for `command`.
jet_cli_threads_refused: fn(jet_argv: [String], command: String) -> Bool Never! {
    if jet_cli_threads(jet_argv, command, false) == {
        .Refused(_) -> return true
        .Cap(_) -> {}
    }
    false
}

// `jet check [<file>|<dir>]`, also the target step of `build`, `run`, and `doc`
// (bare dispatch and `resolve_command_target`). A bare command, or one aimed at
// a directory, resolves the project entry (Entry.jet) and checks it in project
// scope; a file target is read as the user typed it (or with `.jet` appended).
// A bare or directory `build` is not ported yet. `--show-default` reports the
// stock default, and `-p <member>` picks a workspace member; without `-p`,
// `check` at a workspace root checks every member. `json` carries `--json` to
// the check outcome.
jet_cli_check: fn(jet_argv: [String], args: [String], command: String, color: Bool, quiet: Bool, threads: Int?, json: Bool) -[FS, Env]> JetCLIPlan Never! {
    show_default: jet_argv.contains("--show-default")
    member_flag: jet_cli_option_value(jet_argv, "-p")
    status: if show_default && !quiet -> "jet {command}: using stock default\n" else -> ""
    if args.len() < 2 {
        directory: cli_files.cwd() ?? "."
        if command == "build" {
            return jet_cli_fail("E2104", "no file given and no `package.jet` found in this directory or above", jet_cli_why("E2104"), "run `jet {command} <file.jet>` or cd into a project", color, JET_DRIVER_EXIT_USAGE)
        }
        if command == "check" && member_flag == None {
            if jet_cli_check_workspace_plan(directory, color, quiet, threads, status, json) == .Val(workspace) -> return workspace
        }
        notices := [String]{}
        resolved: jet_cli_resolve_bare_entry(command, directory, member_flag, !show_default, color, notices)
        if resolved == {
            .Entry(entry) -> return jet_cli_read_entry(entry.path, command, color, quiet, threads, command == "check", "{notices.join("")}{status}", json, false)
            .Refused(plan) -> return jet_cli_with_notices(notices, plan)
            .Absent -> return jet_cli_with_notices(notices, jet_cli_missing_bare_entry(command, directory, color))
        }
    }
    target: args[1]
    if cli_files.is_dir(target) {
        if command == "check" && jet_cli_is_core_library(target) -> return JetCLIPlan.CheckCore{core: target, color: color, quiet: quiet, threads: threads, json: json}
        if command == "check" && member_flag == None {
            if jet_cli_check_workspace_plan(target, color, quiet, threads, status, json) == .Val(workspace) -> return workspace
        }
        if jet_cli_resolve_directory_target(command, target, member_flag, !show_default, color) == {
            .File(path, _, notice) -> return jet_cli_read_entry(path, command, color, quiet, threads, command == "check", "{notice}{status}", json, false)
            .Refused(plan) -> return plan
        }
    }
    file := target
    if !cli_files.is_file(target) && cli_files.is_file("{target}.jet") -> file = "{target}.jet"
    // A file of another language is refused, never read as Jet source; `jet
    // run` and `jet build` compiled a C or C++ file before this (#6686).
    extension: jet_cli_source_extension(file)
    if extension != "" && extension != "jet" && cli_files.is_file(file) && !jet_cli_jet_script(file) -> return jet_cli_unhandled_extension(file, extension, command, color)
    verbose: command == "check" && (jet_argv.contains("--verbose") || jet_argv.contains("-v"))
    jet_cli_read_entry(file, command, color, quiet, threads, false, status, json, verbose)
}

// `jet jobs`: the jobs of the entry a bare `jet run` resolves (Jobs.jet), so
// a directory with no project refuses exactly as `jet run` does and a
// workspace with several runnable members needs `-p <member>`. The views
// (`--graph`, `--status`, `--explain`, `--watch`) are not built yet; a job
// name without a view is the teaching error naming `jet <name>`, never an
// alias (Docs/reference/cli.md).
jet_cli_jobs: fn(jet_argv: [String], args: [String], color: Bool, quiet: Bool, threads: Int?, json: Bool) -[FS, Env]> JetCLIPlan Never! {
    loop argument in jet_argv {
        flag: argument.split("=").to_list()[0]
        if flag == "--graph" || flag == "--status" || flag == "--explain" || flag == "--watch" -> return jet_cli_not_ported("jobs {flag}", color)
    }
    if args.len() > 1 {
        name: args[1]
        return jet_cli_fail("E2101", "`jet jobs {name}` isn't a jet command.", "`jet jobs` lists jobs; a job runs as its own command, `jet <name> [job args...]`.", "Run `jet {name}`.", color, JET_DRIVER_EXIT_USAGE)
    }
    directory: cli_files.cwd() ?? "."
    notices := [String]{}
    if jet_cli_resolve_bare_entry("jobs", directory, jet_cli_option_value(jet_argv, "-p"), false, color, notices) == {
        .Entry(entry) -> {
            planned: jet_cli_read_entry(entry.path, "jobs", color, quiet, threads, true, notices.join(""), json, false)
            if planned == .Check(file, _, _, _, _, _, notice, _, _, _, _, _, _) -> return JetCLIPlan.Jobs{file: file, color: color, json: json, notice: notice}
            return planned
        }
        .Refused(plan) -> return jet_cli_with_notices(notices, plan)
        .Absent -> return jet_cli_with_notices(notices, jet_cli_missing_bare_entry("run", directory, color))
    }
}

// `jet [jet flags] <name> [job args...]`: a word that is no
// command runs the visible job of that name the project's parsed source
// declares, as `jet run <entry> -- <name> [job args...]` with the jet flags
// before the name. Every word after the name reaches the job unchanged; a `--`
// right after it only separates. None outside a project, or when no visible
// job has the name.
jet_cli_project_job: fn(argv: [String], command: String, color: Bool, quiet: Bool, verbose: Bool) -[FS, Env, Exec]> JetCLIPlan? Never! {
    at := -1
    loop (index, word) in argv {
        if word == command {
            at = index
            break
        }
    }
    if at < 0 -> return None
    flags: jet_cli_prefix(argv, at)
    directory: cli_files.cwd() ?? return None
    notices := [String]{}
    if jet_cli_resolve_bare_entry("run", directory, jet_cli_option_value(flags, "-p"), false, color, notices) == .Entry(entry) {
        registry: pkg_discover_jobs_in(jet_cli_parent(entry.path) ?? directory) ?? return None
        if registry.find_visible(command) == None -> return None
        job_args := [String]{command}
        first: if at + 1 < argv.len() && argv[at + 1] == "--" -> at + 2 else -> at + 1
        loop word in jet_cli_tail(argv, first) -> job_args.push(word)
        threads := Int?{None}
        if jet_cli_threads(flags, "run", color) == {
            .Refused(refusal) -> return Val(refusal)
            .Cap(cap) -> threads = cap
        }
        return Val(jet_cli_with_notices(notices, jet_cli_run(flags, [String]{"run", entry.path}, Val(job_args), false, false, color, quiet, verbose, threads)))
    }
    None
}

// A `jet check` aimed at a workspace root checks its code rather than
// picking a runnable member (Entry.jet `jet_cli_workspace_check_entries`);
// None when the directory is not a workspace index.
jet_cli_check_workspace_plan: fn(directory: String, color: Bool, quiet: Bool, threads: Int?, status: String, json: Bool) -[FS, Env]> JetCLIPlan? Never! {
    notices := [String]{}
    entries := [String]{}
    if jet_cli_workspace_check_entries(directory, color, notices) == {
        .Absent -> return None
        .Refused(plan) -> return Val(jet_cli_with_notices(notices, plan))
        .Members(found) -> entries = found
    }
    notice: "{notices.join("")}{status}"
    files := [String]{}
    sources := [String]{}
    loop entry in entries {
        planned: jet_cli_read_entry(entry, "check", color, quiet, threads, true, notice, json, false)
        if planned == .Check(file, source, _, _, _, _, _, _, _, _, _, _, _) {
            files.push(file)
            sources.push(source)
        } else {
            return Val(planned)
        }
    }
    if files.len() == 1 -> return Val(JetCLIPlan.Check{file: files[0], source: sources[0], color: color, quiet: quiet, threads: threads, project: true, notice: notice, json: json, verbose: false, settings: [BuildSettingOverride]{}, profile: "", style: false, target: ""})
    Val(JetCLIPlan.CheckWorkspace{files: files, sources: sources, color: color, quiet: quiet, threads: threads, notice: notice, json: json, settings: [BuildSettingOverride]{}, profile: "", style: false})
}

// Read the entry `jet_cli_check` chose (`run_native_execution` source read): an
// unreadable stock `run.jet` inside a project teaches how to create it; any
// other unreadable file is E2105. `notice` precedes the report on stderr;
// `json` carries `--json` to the check outcome and `verbose` its explicit-file
// scope and proof rows.
jet_cli_read_entry: fn(file: String, command: String, color: Bool, quiet: Bool, threads: Int?, project: Bool, notice: String, json: Bool, verbose: Bool) -[FS, Env]> JetCLIPlan Never! {
    source: cli_files.read(file) ?? {
        parent: jet_cli_parent(file) ?? "."
        default_entry: file == "run.jet" || file.ends_with("/run.jet")
        fix: if default_entry && jet_cli_has_manifest_above(parent) -> "create `run.jet` in the project, or run `jet {command} <file.jet>`" else -> "check the spelling, or run jet from the folder that contains it"
        return jet_cli_report_done(notice, "E2105", "can't securely read the file `{file}`", jet_cli_why("E2105"), fix, color, JET_DRIVER_EXIT_USER_ERROR)
    }
    JetCLIPlan.Check{file: file, source: source, color: color, quiet: quiet, threads: threads, project: project, notice: notice, json: json, verbose: verbose, settings: [BuildSettingOverride]{}, profile: "", style: false, target: ""}
}

// `jet check --prelude <file>`: the one Compiler/Prelude source it names. A
// missing or second file is E2104; an unreadable one E2105.
jet_cli_check_prelude: fn(args: [String], color: Bool, quiet: Bool, threads: Int?, json: Bool) -[FS, Env]> JetCLIPlan Never! {
    if args.len() != 2 -> return jet_cli_fail("E2104", "`jet check --prelude` checks one Compiler/Prelude `.jet` file", jet_cli_why("E2104"), "run `jet check --prelude Compiler/Prelude/<name>.jet`", color, JET_DRIVER_EXIT_USAGE)
    file: args[1]
    source: cli_files.read(file) ?? return jet_cli_fail("E2105", "can't securely read the file `{file}`", jet_cli_why("E2105"), "check the spelling, or run jet from the folder that contains it", color, JET_DRIVER_EXIT_USER_ERROR)
    JetCLIPlan.CheckPrelude{file: file, source: source, color: color, quiet: quiet, threads: threads, json: json}
}

// `jet check` under its `--set name=value` writers (jet_cli_setting_flags),
// its `--profile`, its `--style` and its `--target`: the check compiles what
// `jet run` with the same writers and profile would, so an undeclared or
// conflicting writer, or a profile no member declares, is refused here too
// (jet_cli_build_options). `--style` adds the opt-in style checks. A
// `--target` naming a machine without an OS checks one file for that machine,
// as `jet build --target` does; any other value leaves the host's.
jet_cli_check_settled: fn(jet_argv: [String], args: [String], color: Bool, quiet: Bool, threads: Int?, json: Bool) -[FS, Env]> JetCLIPlan Never! {
    settings := [BuildSettingOverride]{}
    if jet_cli_setting_flags(jet_argv, color) == {
        .Refused(plan) -> return plan
        .Given(given) -> settings = given.copy()
    }
    style: jet_argv.contains("--style")
    machine := ""
    if jet_cli_target_flag(jet_argv) == .Named(name) && jet_cli_no_os_machine(name) -> machine = name
    planned: jet_cli_check(jet_argv, args, "check", color, quiet, threads, json)
    if planned == {
        .Check(file, source, _, _, _, project, notice, _, verbose, _, _, _, _) -> {
            if jet_cli_check_profile(jet_argv, [String]{file}, [String]{source}, color) == {
                .Refused(refusal) -> refusal.move()
                // copy: `profile` is a payload view of the resolved name.
                .Given(profile) -> JetCLIPlan.Check{file: file, source: source, color: color, quiet: quiet, threads: threads, project: project, notice: notice, json: json, verbose: verbose, settings: settings, profile: profile.copy(), style: style, target: machine}
            }
        }
        .CheckWorkspace(files, sources, _, _, _, notice, _, _, _, _) -> {
            if jet_cli_check_profile(jet_argv, files, sources, color) == {
                .Refused(refusal) -> refusal.move()
                // copy: `profile` is a payload view of the resolved name.
                .Given(profile) -> JetCLIPlan.CheckWorkspace{files: files, sources: sources, color: color, quiet: quiet, threads: threads, notice: notice, json: json, settings: settings, profile: profile.copy(), style: style}
            }
        }
        .Done(_) | .Refused(_, _, _, _) | .Diagnostics(_, _, _, _, _) | .CheckPrelude(_, _, _, _, _, _) | .CheckCore(_, _, _, _, _) | .Build(_, _, _, _, _, _, _, _, _, _, _) | .LockedBuild(_, _) | .BuildPackage(_, _, _, _, _, _, _, _) | .Run(_, _, _, _, _, _, _, _, _, _, _, _) | .RunRemote(_, _, _, _, _, _, _, _) | .NativeSource(_, _, _, _, _) | .DevWeb(_, _, _, _, _, _, _, _) | .DevCanvas(_, _, _, _, _, _) | .Jobs(_, _, _, _) | .Test(_, _, _, _, _, _) | .TestWorkspace(_, _, _, _, _, _, _, _) | .TestProfile(_, _, _, _, _, _) | .New(_, _, _, _, _, _) | .Doc(_, _, _, _, _) | .Emit(_, _, _, _, _, _) | .Eval(_, _, _, _, _) | .Fill(_, _, _) | .Structural(_, _, _) | .Review(_, _, _) | .Keygen(_, _, _) | .KeyBackup(_, _, _) | .Publish(_, _, _, _) | .Yank(_, _, _) | .Lint(_, _, _, _, _, _, _) | .Fmt(_) | .FmtLang(_, _) | .Fix(_, _, _, _, _, _, _, _, _) | .Inspect(_) | .InspectB(_) | .ForeignBind(_, _, _) | .Perf(_, _) | .Semindex(_, _, _) | .Find(_, _, _, _) | .Cache(_, _) | .Remote(_, _, _) | .Comparison(_, _, _) | .Try(_, _, _) | .Maintenance(_, _, _, _) | .Completion(_, _, _) | .Schema(_, _, _, _, _) | .Codemod(_, _, _, _, _) | .PolicyExplain(_, _, _, _, _, _) | .DiagnosticTypeExplain(_, _, _, _) | .BuildFactExplain(_, _, _, _, _, _, _) | .Gates(_, _, _, _, _) | .Output(_, _, _, _) | .Doctor(_, _, _, _) | .UpdateJet(_, _, _, _, _) | .AuditCopies(_, _, _, _, _) | .AuditForeign(_, _, _, _, _) | .CompilerService(_) | .Repl(_, _, _, _) | .LSP | .ReplChild(_) | .EvalExpression(_, _, _) | .Prove(_, _, _, _, _, _) | .Budget(_, _, _, _) | .AuditWrites(_, _, _, _, _) -> planned
    }
}

JetCLICheckProfile: enum {
    Given(profile: String)
    Refused(plan: JetCLIPlan)
}

// The `--profile` a check compiles under, resolved against each checked
// file's package as `jet run` resolves it: "" when none is named or it is the
// stock `debug`, else the refusal of a profile a package does not declare.
jet_cli_check_profile: fn(jet_argv: [String], files: [String], sources: [String], color: Bool) -[FS, Env]> JetCLICheckProfile Never! {
    if jet_cli_profile_name(jet_argv) == "" -> return JetCLICheckProfile.Given{profile: ""}
    profile := ""
    loop (index, file) in files {
        if jet_cli_build_options(jet_argv, "check", file, sources[index], color, true) == {
            .Refused(refusal) -> return JetCLICheckProfile.Refused{plan: refusal.move()}
            // copy: `options` is a payload view of the resolved options.
            .Selected(options, _) -> profile = options.profile.copy()
        }
    }
    JetCLICheckProfile.Given{profile: profile}
}

// `jet doc [<file>]`: the entry resolves as `jet check` resolves it.
jet_cli_doc: fn(jet_argv: [String], args: [String], color: Bool, quiet: Bool, json: Bool, check: Bool) -[FS, Env]> JetCLIPlan Never! {
    entry: jet_cli_check(jet_argv, args, "doc", color, quiet, None, json)
    if entry == {
        .Check(file, source, _, _, _, _, _, _, _, _, _, _, _) -> return JetCLIPlan.Doc{file: file, source: source, color: color, json: json, check: check}
        .Done(_) | .Refused(_, _, _, _) | .Diagnostics(_, _, _, _, _) | .CheckWorkspace(_, _, _, _, _, _, _, _, _, _) | .CheckPrelude(_, _, _, _, _, _) | .CheckCore(_, _, _, _, _) | .Build(_, _, _, _, _, _, _, _, _, _, _) | .LockedBuild(_, _) | .BuildPackage(_, _, _, _, _, _, _, _) | .Run(_, _, _, _, _, _, _, _, _, _, _, _) | .RunRemote(_, _, _, _, _, _, _, _) | .NativeSource(_, _, _, _, _) | .DevWeb(_, _, _, _, _, _, _, _) | .DevCanvas(_, _, _, _, _, _) | .Jobs(_, _, _, _) | .Test(_, _, _, _, _, _) | .TestWorkspace(_, _, _, _, _, _, _, _) | .TestProfile(_, _, _, _, _, _) | .New(_, _, _, _, _, _) | .Doc(_, _, _, _, _) | .Emit(_, _, _, _, _, _) | .Eval(_, _, _, _, _) | .Fill(_, _, _) | .Structural(_, _, _) | .Review(_, _, _) | .Keygen(_, _, _) | .KeyBackup(_, _, _) | .Publish(_, _, _, _) | .Yank(_, _, _) | .Lint(_, _, _, _, _, _, _) | .Fmt(_) | .FmtLang(_, _) | .Fix(_, _, _, _, _, _, _, _, _) | .Inspect(_) | .InspectB(_) | .ForeignBind(_, _, _) | .Perf(_, _) | .Semindex(_, _, _) | .Find(_, _, _, _) | .Cache(_, _) | .Remote(_, _, _) | .Comparison(_, _, _) | .Try(_, _, _) | .Maintenance(_, _, _, _) | .Completion(_, _, _) | .Schema(_, _, _, _, _) | .Codemod(_, _, _, _, _) | .PolicyExplain(_, _, _, _, _, _) | .DiagnosticTypeExplain(_, _, _, _) | .BuildFactExplain(_, _, _, _, _, _, _) | .Gates(_, _, _, _, _) | .Output(_, _, _, _) | .Doctor(_, _, _, _) | .UpdateJet(_, _, _, _, _) | .AuditCopies(_, _, _, _, _) | .AuditForeign(_, _, _, _, _) | .CompilerService(_) | .Repl(_, _, _, _) | .LSP | .ReplChild(_) | .EvalExpression(_, _, _) | .Prove(_, _, _, _, _, _) | .Budget(_, _, _, _) | .AuditWrites(_, _, _, _, _) -> {}
    }
    entry
}

JetCLITargetFlag: enum {
    Absent
    // `--target` with no value, or with a flag where the value belongs.
    Missing
    Named(name: String)
}

// `parse_target_flag`: `--target=<v>` or `--target <v>`.
jet_cli_target_flag: fn(jet_argv: [String]) -> JetCLITargetFlag Never! {
    loop (index, argument) in jet_argv {
        if argument.starts_with("--target=") {
            value: argument.slice(9..<argument.len())
            if value == "" -> return JetCLITargetFlag.Missing
            return JetCLITargetFlag.Named{name: value}
        }
        if argument == "--target" {
            if index + 1 >= jet_argv.len() || jet_argv[index + 1].starts_with("-") -> return JetCLITargetFlag.Missing
            return JetCLITargetFlag.Named{name: jet_argv[index + 1]}
        }
    }
    JetCLITargetFlag.Absent
}

JetCLIBuildOptions: enum {
    // `notes` is the stderr text naming each value a flag replaced.
    Selected(options: BuildOptions, notes: String)
    Refused(plan: JetCLIPlan)
}

// A build-option flag without its value or with a value outside its row,
// refused before entry resolution reads its words.
jet_cli_option_flags_refusal: fn(jet_argv: [String], color: Bool) -> JetCLIPlan? Never! {
    if build_option_flags(jet_argv) == .Refused(code, what, fix) -> return Val(jet_cli_fail(code, what, jet_cli_why(code), fix, color, JET_DRIVER_EXIT_USAGE))
    None
}

// The selected build profile, "" for none: `--release` is `--profile=release`
// and wins over another `--profile`.
jet_cli_profile_name: fn(jet_argv: [String]) -> String Never! {
    profile := ""
    loop (index, argument) in jet_argv {
        if argument == "--" -> break
        if argument == "--release" -> return "release"
        if argument.starts_with("--profile=") -> profile = argument.slice(10..<argument.len())
        if argument == "--profile" && index + 1 < jet_argv.len() -> profile = jet_argv[index + 1]
    }
    profile
}

// Is `name` a declared machine without an OS (`board.sensor_v1`, `wasm.no-os`;
// JetDriver jet_driver_target_machine_by_name)? `jet build` and `jet check`
// check a program for such a machine.
jet_cli_no_os_machine: fn(name: String) -> Bool Never! {
    machine: jet_driver_target_machine_by_name(name, JET_VERSION) ?? return false
    machine.no_os
}

// A build for a machine without an OS, once the program checks clean for it:
// no backend writes its image yet, so the build ends in the form's E2104.
// None for a host build.
jet_cli_build_machine_refusal: fn(options: BuildOptions, color: Bool) -> JetDriverVerbOutput? Never! {
    if options.target_machine == "" -> return None
    Val(jet_cli_not_ported_output("build --target={options.target_machine}", color))
}

// The build options `command` compiles `file`
// (whose bytes are `source`) under. Over the command's stock values come the
// selected profile's fields, then the flags (`--optimize=full`); a package
// build adds its `build: fn` layer between the two (jet_cli_build_package). A
// profile `package.jet` declares replaces the stock profile of that name:
// `release` is `optimize: full, debug_info: split`, `debug` `optimize: none`.
// `os_web` builds for the browser, as `--target web` does (the web preview of
// `jet dev`).
jet_cli_build_options: fn(jet_argv: [String], command: String, file: String, source: String, color: Bool, quiet: Bool, os_web: Bool{false}) -[FS, Env]> JetCLIBuildOptions Never! {
    written := [BuildOptionChoice]{}
    flags := [BuildOptionChoice]{}
    settings := [BuildSettingOverride]{}
    if jet_cli_setting_flags(jet_argv, color) == {
        .Refused(plan) -> return JetCLIBuildOptions.Refused{plan: plan}
        .Given(given) -> settings = given.copy()
    }
    gates := [PolicyKey]{}
    if jet_cli_gate_flags(jet_argv, color) == {
        .Refused(plan) -> return JetCLIBuildOptions.Refused{plan: plan}
        .Given(given) -> gates = given.copy()
    }
    deep_checks := DeepChecks{}
    if deep_checks_read(jet_argv) == {
        .Refused(argument) -> return JetCLIBuildOptions.Refused{plan: JetCLIPlan.Refused{report: deep_checks_malformed(argument), color: color, exit_code: JET_DRIVER_EXIT_USAGE, notice: ""}}
        .Read(request) -> deep_checks = request.copy()
    }
    if build_option_flags(jet_argv) == {
        .Refused(code, what, fix) -> return JetCLIBuildOptions.Refused{plan: jet_cli_fail(code, what, jet_cli_why(code), fix, color, JET_DRIVER_EXIT_USAGE)}
        .Resolved(given, _) -> flags = given.written
    }
    name: jet_cli_profile_name(jet_argv)
    profile := name
    if name != "" {
        declared := JetCLIBuildProfile?{None}
        if jet_cli_file_manifest(file, source) == .Val(manifest) {
            loop candidate in manifest.profiles {
                if candidate.name == name -> declared = Val(candidate.copy())
            }
        }
        if declared == .Val(found) {
            site: "in profile `{name}` of package.jet"
            loop field in found.fields {
                if build_option_refusal(field.name) == .Val(refusal) -> return JetCLIBuildOptions.Refused{plan: jet_cli_fail("E2104", "`{field.name}: {field.value}` {site} isn't a build option", refusal.law, "remove the `{field.name}` field", color, JET_DRIVER_EXIT_USAGE)}
                row: build_option_row(field.name) ?? next
                shown: if field.list -> build_option_argument(row, field.value) else -> field.value.copy()
                if field.list != (row.kind == BuildOptionKind.List) || !build_option_accepts(row, field.value) {
                    return JetCLIBuildOptions.Refused{plan: jet_cli_fail("E2104", "`{field.name}: {shown}` {site} isn't a value of `{field.name}`", jet_cli_why("E2104"), "write `{field.name}:` with {build_option_profile_hint(row)}", color, JET_DRIVER_EXIT_USAGE)}
                }
                written.push(BuildOptionChoice{name: field.name.copy(), value: field.value.copy(), layer: BuildOptionLayer.Profile, written: "{field.name}: {shown}", site: site.copy(), pinned: false})
            }
        } else {
            if {
                // The stock `hardened` profile builds as `release` does and
                // keeps the memory sentry (jet_cli_native_program).
                name == "release" || name == "hardened" -> written.extend(jet_cli_stock_release_choices(name))
                // The stock `debug` profile is `optimize: none` over the stock values; the front end
                // keeps its `dev` profile.
                name == "debug" -> {
                    written.extend(jet_cli_stock_debug_choices())
                    profile = ""
                }
                name == "ci" -> return JetCLIBuildOptions.Refused{plan: jet_cli_not_ported("{command} --profile {name}", color)}
                // The registered E1219 row is the unknown-profile report; its holes name the profile.
                // An undeclared profile name is a user problem (exit 1), not a malformed flag (exit 2).
                else -> {
                    row: diagnostic_registry_row("E1219") ?? panic("E1219 is not registered")
                    return JetCLIBuildOptions.Refused{plan: jet_cli_fail("E1219", row.what.replace("{{name}}", name), row.why.replace("{{name}}", name), row.fix.replace("{{name}}", name), color, JET_DRIVER_EXIT_USER_ERROR)}
                }
            }
        }
    }
    loop flag in flags -> written.push(flag)
    // `jet build --target web` is the web build (BuildWeb.jet), and so is the
    // web preview of `jet dev`: its OS is web. The preview is a `jet dev`
    // build, so its stock level is dev's (AGENTS.md I9), under any profile.
    // With no `--target` or `--os`, a file `#Target(Web)` selects the web
    // build too, unless the program is a full-stack App, which runs natively.
    web := os_web
    marked := false
    if os_web -> written.insert(0, BuildOptionChoice{name: "optimize", value: build_options_value(build_options_stock("dev"), "optimize"), layer: BuildOptionLayer.Stock, written: "", site: "", pinned: false})
    // `jet build --target=<machine>` of a machine without an OS checks the
    // program for that machine (BuildOptions.target_machine).
    machine := ""
    if jet_cli_target_flag(jet_argv) == {
        .Named(target) -> {
            if target == "web" -> web = true
            if command == "build" && jet_cli_no_os_machine(target) -> machine = target
        }
        .Absent -> {
            if command == "build" && !flags.any(fn(flag) { flag.name == "os" }) && jet_cli_declares_web_target(source) && !jet_cli_declares_web_app(source) {
                web = true
                marked = true
            }
        }
        .Missing -> {}
    }
    if command == "build" && web {
        written_as: if {
            os_web -> "the web preview of `jet dev`"
            marked -> "the file's `#Target(Web)`"
            else -> "--target web"
        }
        loop flag in flags {
            if flag.name == "os" && flag.value != "web" -> return JetCLIBuildOptions.Refused{plan: jet_cli_fail("E2104", "`{flag.written}` and {written_as} disagree", jet_cli_why("E2104"), "pass one of them", color, JET_DRIVER_EXIT_USAGE)}
        }
        written.push(BuildOptionChoice{name: "os", value: "web", layer: BuildOptionLayer.Flag, written: written_as.copy(), site: "", pinned: false})
    }
    if build_options_resolve(command, profile, written) == {
        .Refused(code, what, fix) -> return JetCLIBuildOptions.Refused{plan: jet_cli_fail(code, what, jet_cli_why(code), fix, color, JET_DRIVER_EXIT_USAGE)}
        .Resolved(options, notes) -> {
            text := ""
            if !quiet {
                loop note in notes -> text = "{text}{note}\n"
                loop choice in build_options_check_removals(options) -> text = "{text}{build_option_check_removal_note(choice)}\n"
            }
            selected := options.copy()
            selected.settings = settings
            selected.gates = gates
            selected.deep_checks = deep_checks
            selected.explain_partition = command == "build" && jet_cli_flag_before_separator(jet_argv, "--explain-partition")
            selected.target_machine = machine
            return JetCLIBuildOptions.Selected{options: selected, notes: text}
        }
    }
}

JetCLISettingFlags: enum {
    Given(settings: [BuildSettingOverride])
    Refused(plan: JetCLIPlan)
}

// `--set name=value` and `--set=name=value`, in argv order: each the
// command-line writer of one setting the package declares. A word that is
// not `name=value` is a usage error (E2104); the driver refuses a name the
// package does not declare.
jet_cli_setting_flags: fn(jet_argv: [String], color: Bool) -> JetCLISettingFlags Never! {
    settings := [BuildSettingOverride]{}
    loop (index, argument) in jet_argv {
        if argument == "--" -> break
        written := String?{None}
        if argument.starts_with("--set=") -> written = Val(argument.removeprefix("--set="))
        if argument == "--set" -> written = Val(if index + 1 < jet_argv.len() -> jet_argv[index + 1].copy() else -> "")
        word: written ?? next
        parts: word.split("=").to_list()
        if parts.len() < 2 || parts[0].trim() == "" {
            return JetCLISettingFlags.Refused{plan: jet_cli_fail("E2104", "`--set {word}` isn't `name=value`", jet_cli_why("E2104"), "write `--set name=value` for a setting the package declares", color, JET_DRIVER_EXIT_USAGE)}
        }
        value := parts[1].copy()
        loop i in 2..<parts.len() -> value = "{value}={parts[i]}"
        settings.push(BuildSettingOverride{name: parts[0].trim(), value: value})
    }
    JetCLISettingFlags.Given{settings: settings}
}

JetCLIGateFlags: enum {
    Given(gates: [PolicyKey])
    Refused(plan: JetCLIPlan)
}

// `--gate name=allow` and `--gate=name=allow`, in argv order: each opens one
// audited gate for the compile (policy_gate_parse); an owning `.Forbid` still
// refuses it (E3415). Any other word is a usage error (E2104).
jet_cli_gate_flags: fn(jet_argv: [String], color: Bool) -> JetCLIGateFlags Never! {
    gates := [PolicyKey]{}
    loop (index, argument) in jet_argv {
        if argument == "--" -> break
        written := String?{None}
        if argument.starts_with("--gate=") -> written = Val(argument.removeprefix("--gate="))
        if argument == "--gate" -> written = Val(if index + 1 < jet_argv.len() -> jet_argv[index + 1].copy() else -> "")
        spec: written ?? next
        key: if policy_gate_parse(spec) == {
            .Ok(found) -> found
            .Err(error) -> return JetCLIGateFlags.Refused{plan: jet_cli_fail("E2104", "`--gate {spec}` doesn't open a gate: {error.message}", jet_cli_why("E2104"), "write `--gate name=allow` with an audited gate name, such as `--gate impure=allow`", color, JET_DRIVER_EXIT_USAGE)}
        }
        if !gates.contains(key) -> gates.push(key)
    }
    JetCLIGateFlags.Given{gates: gates}
}

// The stock `release` profile: `optimize: full`, and `debug_info: split`,
// which `jet build` writes as a side debug file beside the image. The stock
// `hardened` profile (`name`) has the same options.
jet_cli_stock_release_choices: fn(name: String) -> [BuildOptionChoice] Never! {
    site: "of the stock `{name}` profile"
    [BuildOptionChoice]{
        {name: "optimize", value: "full", layer: BuildOptionLayer.Profile, written: "optimize: full", site: site.copy(), pinned: false},
        {name: "debug_info", value: "split", layer: BuildOptionLayer.Profile, written: "debug_info: split", site: site.copy(), pinned: false},
    }
}

// The stock `debug` profile: `optimize: none`, the level of `jet run`.
jet_cli_stock_debug_choices: fn() -> [BuildOptionChoice] Never! {
    [BuildOptionChoice]{{name: "optimize", value: "none", layer: BuildOptionLayer.Profile, written: "optimize: none", site: "of the stock `debug` profile", pinned: false}}
}

// `plan` (a build, package build, or run) with the build options its entry
// compiles under, or the refusal of a profile or flag.
jet_cli_with_build_options: fn(plan: &&JetCLIPlan, jet_argv: [String], quiet: Bool) -[FS, Env]> JetCLIPlan Never! {
    if plan == {
        .Build(file, source, color, _, threads, invocation, notice, json, sbom, build_quiet, verbose) -> {
            if jet_cli_build_options(jet_argv, "build", file, source, color, quiet) == {
                .Refused(refusal) -> return refusal
                .Selected(options, notes) -> return JetCLIPlan.Build{file: file.move(), source: source.move(), color: color, options: options.move(), threads: threads, invocation: invocation.move(), notice: "{notice}{notes}", json: json, sbom: sbom, quiet: build_quiet, verbose: verbose}
            }
        }
        .BuildPackage(file, color, _, build_args, threads, invocation, notice, _) -> {
            if jet_argv.contains("--sbom") -> return jet_cli_not_ported("build <package build with --sbom>", color)
            source: cli_files.read(file) ?? ""
            if jet_cli_build_options(jet_argv, "build", file, source, color, quiet) == {
                .Refused(refusal) -> return refusal
                .Selected(options, notes) -> {
                    // A package build runs its `build: fn` on the host, which
                    // does not check for a machine without an OS yet.
                    if options.target_machine != "" -> return jet_cli_not_ported("build --target={options.target_machine}", color)
                    return JetCLIPlan.BuildPackage{file: file.move(), color: color, options: options.move(), build_args: build_args.move(), threads: threads, invocation: invocation.move(), notice: "{notice}{notes}", locked: None}
                }
            }
        }
        .Run(file, source, color, _, verbose, json, threads, program_args, invocation, notice, watch, entry) -> {
            command: if watch -> "dev" else -> "run"
            if jet_cli_build_options(jet_argv, command, file, source, color, quiet) == {
                .Refused(refusal) -> return refusal
                .Selected(options, notes) -> {
                    // `jet run --observe` (jet_cli_run_entry admits it on a run only).
                    observed := options.move()
                    observed.observe = !watch && jet_cli_flag_before_separator(jet_argv, "--observe")
                    observed.log = jet_cli_log_flag(jet_argv) ?? return jet_cli_fail("E2104", "`--log` needs a level filter", jet_cli_why("E2104"), "write `--log=warn,shop.db=debug`: {LOG_FILTER_FIX}", color, JET_DRIVER_EXIT_USAGE)
                    if log_filter_bad_pair(observed.log) == .Val(pair) -> return jet_cli_fail("E2104", "`--log={observed.log}`: `{pair}` is not a log filter pair", jet_cli_why("E2104"), LOG_FILTER_FIX, color, JET_DRIVER_EXIT_USAGE)
                    return JetCLIPlan.Run{file: file.move(), source: source.move(), color: color, options: observed, verbose: verbose, json: json, threads: threads, program_args: program_args.move(), invocation: invocation.move(), notice: "{notice}{notes}", watch: watch, entry: entry.move()}
                }
            }
        }
        .DevWeb(file, source, color, _, threads, invocation, notice, port) -> {
            if jet_cli_build_options(jet_argv, "build", file, source, color, quiet, os_web: true) == {
                .Refused(refusal) -> return refusal
                .Selected(options, notes) -> return JetCLIPlan.DevWeb{file: file.move(), source: source.move(), color: color, options: options.move(), threads: threads, invocation: invocation.move(), notice: "{notice}{notes}", port: port}
            }
        }
        // `jet dev --canvas` checks the entry and builds nothing.
        .DevCanvas(_, _, _, _, _, _) -> {}
        .Done(_) | .Refused(_, _, _, _) | .Diagnostics(_, _, _, _, _) | .Check(_, _, _, _, _, _, _, _, _, _, _, _, _) | .CheckWorkspace(_, _, _, _, _, _, _, _, _, _) | .CheckPrelude(_, _, _, _, _, _) | .CheckCore(_, _, _, _, _) | .LockedBuild(_, _) | .RunRemote(_, _, _, _, _, _, _, _) | .NativeSource(_, _, _, _, _) | .Jobs(_, _, _, _) | .Test(_, _, _, _, _, _) | .TestWorkspace(_, _, _, _, _, _, _, _) | .TestProfile(_, _, _, _, _, _) | .New(_, _, _, _, _, _) | .Doc(_, _, _, _, _) | .Emit(_, _, _, _, _, _) | .Eval(_, _, _, _, _) | .Fill(_, _, _) | .Structural(_, _, _) | .Review(_, _, _) | .Keygen(_, _, _) | .KeyBackup(_, _, _) | .Publish(_, _, _, _) | .Yank(_, _, _) | .Lint(_, _, _, _, _, _, _) | .Fmt(_) | .FmtLang(_, _) | .Fix(_, _, _, _, _, _, _, _, _) | .Inspect(_) | .InspectB(_) | .ForeignBind(_, _, _) | .Perf(_, _) | .Semindex(_, _, _) | .Find(_, _, _, _) | .Cache(_, _) | .Remote(_, _, _) | .Comparison(_, _, _) | .Try(_, _, _) | .Maintenance(_, _, _, _) | .Completion(_, _, _) | .Schema(_, _, _, _, _) | .Codemod(_, _, _, _, _) | .PolicyExplain(_, _, _, _, _, _) | .DiagnosticTypeExplain(_, _, _, _) | .BuildFactExplain(_, _, _, _, _, _, _) | .Gates(_, _, _, _, _) | .Output(_, _, _, _) | .Doctor(_, _, _, _) | .UpdateJet(_, _, _, _, _) | .AuditCopies(_, _, _, _, _) | .AuditForeign(_, _, _, _, _) | .CompilerService(_) | .Repl(_, _, _, _) | .LSP | .ReplChild(_) | .EvalExpression(_, _, _) | .Prove(_, _, _, _, _, _) | .Budget(_, _, _, _) | .AuditWrites(_, _, _, _, _) -> {}
    }
    plan
}

JetCLIAuthorityFlags: enum {
    // The invocation rows (`None` when neither flag is given).
    Rows(invocation: JetCLIInvocationAuthority?)
    Refused(plan: JetCLIPlan)
}

// `parse_authority_flags`: the `--allow`/`--deny` rows of a build or run,
// canonical and deduplicated, and `-A` (`--allow-all`), which allows every
// right; a right both allowed and denied is E2102.
jet_cli_authority_flags: fn(jet_argv: [String], color: Bool) -> JetCLIAuthorityFlags Never! {
    all := false
    allow := [String]{}
    deny := [String]{}
    index := 0
    loop index < jet_argv.len() {
        argument: jet_argv[index]
        if argument == "-A" || argument == "--allow-all" {
            all = true
            index += 1
            next
        }
        kind := ""
        inline := String?{None}
        if {
            argument.starts_with("--allow=") -> {
                kind = "allow"
                inline = Val(argument.slice(8..<argument.len()))
            }
            argument.starts_with("--deny=") -> {
                kind = "deny"
                inline = Val(argument.slice(7..<argument.len()))
            }
            argument == "--allow" -> kind = "allow"
            argument == "--deny" -> kind = "deny"
            else -> {}
        }
        if kind == "" {
            index += 1
            next
        }
        value := ""
        if inline == .Val(text) {
            value = text
        } else {
            if index + 1 >= jet_argv.len() || jet_argv[index + 1].starts_with("-") {
                return JetCLIAuthorityFlags.Refused{plan: jet_cli_fail("E2104", "`--{kind}` needs a comma-separated rights value", "authority is read before the program's own arguments", "use `--{kind}=FS.Read,Time`", color, JET_DRIVER_EXIT_USAGE)}
            }
            index += 1
            value = jet_argv[index]
        }
        if value.trim() == "" -> return JetCLIAuthorityFlags.Refused{plan: jet_cli_fail("E2104", "`--{kind}` needs a non-empty rights value", "authority names one or more effect roots or leaves", "use `--{kind}=FS.Read,Time`", color, JET_DRIVER_EXIT_USAGE)}
        loop raw in value.split(",") {
            right: raw.trim()
            canonical: jet_cli_parse_right(right) ?? return JetCLIAuthorityFlags.Refused{plan: jet_cli_fail("E2104", "unknown authority right `{right}`", "authority names match the canonical effect roots and leaves", "use `--{kind}=FS.Read,Time`", color, JET_DRIVER_EXIT_USAGE)}
            if kind == "allow" {
                if !allow.contains(canonical) -> allow.push(canonical)
            } else {
                if !deny.contains(canonical) -> deny.push(canonical)
            }
        }
        index += 1
    }
    loop right in allow {
        if deny.contains(right) -> return JetCLIAuthorityFlags.Refused{plan: jet_cli_fail("E2102", "authority right `{right}` is both allowed and denied", "the same exact effective right cannot be granted and denied in one invocation", "remove one of `--allow={right}` or `--deny={right}`", color, JET_DRIVER_EXIT_USAGE)}
    }
    if !all && allow.len() == 0 && deny.len() == 0 -> return JetCLIAuthorityFlags.Rows{invocation: None}
    JetCLIAuthorityFlags.Rows{invocation: Val(JetCLIInvocationAuthority{all: all, allow: allow, deny: deny})}
}

// `jet build <file>` under its build options (jet_cli_build_options). The
// flags above and every `--target` but `web` are not ported yet. The words
// after `--` (`passthrough`) go to the package's `build: fn` (`b.args()`).
jet_cli_build: fn(jet_argv: [String], args: [String], passthrough: [String]?, color: Bool, quiet: Bool, threads: Int?, json: Bool) -[FS, Env]> JetCLIPlan Never! {
    jet_cli_with_build_options(jet_cli_build_entry(jet_argv, args, passthrough, color, quiet, threads, json), jet_argv, quiet)
}

// `jet build --locked`: the engine's locked fetch checks `.jet/lock` against
// the manifest and the verified store, opening no network connection, before
// the stock build runs. A `build: fn` package build runs the same check (when
// it has a manifest), then refuses generated sources that drifted from the
// lock (E3512) before writing any of them.
jet_cli_locked_build: fn(raw: [String], jet_argv: [String], args: [String], passthrough: [String]?, color: Bool, quiet: Bool, threads: Int?, json: Bool) -[FS, Env]> JetCLIPlan Never! {
    unlocked := [String]{}
    loop word in jet_argv {
        if word != "--locked" -> unlocked.push(word.copy())
    }
    planned: jet_cli_build(unlocked, args, passthrough, color, quiet, threads, json)
    if planned == {
        .Build(file, _, _, _, _, _, _, _, _, _, _) -> {
            check: jet_cli_package_engine(jet_cli_parent(file) ?? ".", [String]{"fetch", "--locked", "--quiet"}, color, json)
            if check == .InspectB(inspect) {
                if inspect == .Engine(_, _, check_argv) {
                    separator: jet_cli_owned_end(raw)
                    build := [String]{}
                    loop (index, word) in raw {
                        if index < separator && word == "--locked" -> next
                        build.push(word.copy())
                    }
                    return JetCLIPlan.LockedBuild{check: check_argv, build: build}
                }
            }
            return check
        }
        .BuildPackage(file, _, options, build_args, _, invocation, notice, _) -> {
            check := [String]{}
            directory: jet_cli_parent(file) ?? "."
            if jet_cli_manifest_root(directory) != None {
                engine: jet_cli_package_engine(directory, [String]{"fetch", "--locked", "--quiet"}, color, json)
                if engine == .InspectB(inspect) {
                    if inspect == .Engine(_, _, check_argv) -> check = check_argv.copy()
                }
                if check.len() == 0 -> return engine
            }
            return JetCLIPlan.BuildPackage{file: file.copy(), color: color, options: options.copy(), build_args: build_args.copy(), threads: threads, invocation: invocation.copy(), notice: notice.copy(), locked: Val(check)}
        }
        .Done(_) | .Refused(_, _, _, _) | .Diagnostics(_, _, _, _, _) | .Check(_, _, _, _, _, _, _, _, _, _, _, _, _) | .CheckWorkspace(_, _, _, _, _, _, _, _, _, _) | .CheckPrelude(_, _, _, _, _, _) | .CheckCore(_, _, _, _, _) | .LockedBuild(_, _) | .Run(_, _, _, _, _, _, _, _, _, _, _, _) | .RunRemote(_, _, _, _, _, _, _, _) | .NativeSource(_, _, _, _, _) | .DevWeb(_, _, _, _, _, _, _, _) | .DevCanvas(_, _, _, _, _, _) | .Jobs(_, _, _, _) | .Test(_, _, _, _, _, _) | .TestWorkspace(_, _, _, _, _, _, _, _) | .TestProfile(_, _, _, _, _, _) | .New(_, _, _, _, _, _) | .Doc(_, _, _, _, _) | .Emit(_, _, _, _, _, _) | .Eval(_, _, _, _, _) | .Fill(_, _, _) | .Structural(_, _, _) | .Review(_, _, _) | .Keygen(_, _, _) | .KeyBackup(_, _, _) | .Publish(_, _, _, _) | .Yank(_, _, _) | .Lint(_, _, _, _, _, _, _) | .Fmt(_) | .FmtLang(_, _) | .Fix(_, _, _, _, _, _, _, _, _) | .Inspect(_) | .InspectB(_) | .ForeignBind(_, _, _) | .Perf(_, _) | .Semindex(_, _, _) | .Find(_, _, _, _) | .Cache(_, _) | .Remote(_, _, _) | .Comparison(_, _, _) | .Try(_, _, _) | .Maintenance(_, _, _, _) | .Completion(_, _, _) | .Schema(_, _, _, _, _) | .Codemod(_, _, _, _, _) | .PolicyExplain(_, _, _, _, _, _) | .DiagnosticTypeExplain(_, _, _, _) | .BuildFactExplain(_, _, _, _, _, _, _) | .Gates(_, _, _, _, _) | .Output(_, _, _, _) | .Doctor(_, _, _, _) | .UpdateJet(_, _, _, _, _) | .AuditCopies(_, _, _, _, _) | .AuditForeign(_, _, _, _, _) | .CompilerService(_) | .Repl(_, _, _, _) | .LSP | .ReplChild(_) | .EvalExpression(_, _, _) | .Prove(_, _, _, _, _, _) | .Budget(_, _, _, _) | .AuditWrites(_, _, _, _, _) -> return planned
    }
}

// The `jet build` plan at the stock options, its entry resolved. Words after
// `--` are refused when no `build: fn` runs to read them.
jet_cli_build_entry: fn(jet_argv: [String], args: [String], passthrough: [String]?, color: Bool, quiet: Bool, threads: Int?, json: Bool) -[FS, Env]> JetCLIPlan Never! {
    if jet_cli_option_flags_refusal(jet_argv, color) == .Val(refusal) -> return refusal
    loop argument in jet_argv {
        head: argument.split("=").to_list()[0]
        if head.starts_with("-") && !jet_cli_form_ported("build {head}") -> return jet_cli_not_ported("build {head}", color)
    }
    invocation := JetCLIInvocationAuthority?{None}
    if jet_cli_authority_flags(jet_argv, color) == {
        .Refused(refusal) -> return refusal
        .Rows(rows) -> invocation = rows
    }
    if jet_cli_target_flag(jet_argv) == {
        .Absent -> {}
        .Missing -> return jet_cli_fail("E2104", "`--target` needs a value", jet_cli_why("E2104"), "write `--target=<triple>` or `--target <triple>` before the source file", color, JET_DRIVER_EXIT_USAGE)
        .Named(name) -> {
            // A machine without an OS is checked for that machine first; its
            // image is refused after the check (jet_cli_build_machine_refusal).
            if !jet_cli_form_ported("build --target={name}") && !jet_cli_no_os_machine(name) -> return jet_cli_not_ported("build --target={name}", color)
        }
    }
    if args.len() > 2 -> return jet_cli_build_extra_refused(args, color)
    // A package (no file given, or a directory): its `build: fn(b: Build)` when it declares one,
    // otherwise the stock build of its run entry.
    if args.len() < 2 || cli_files.is_dir(args[1]) {
        directory: if args.len() < 2 -> cli_files.cwd() ?? "." else -> args[1]
        // The directory's own `build: fn` is its build entry, also for a workspace root whose
        // members are runnable (`jet build Compiler/`).
        if !jet_argv.contains("--show-default") && jet_cli_option_value(jet_argv, "-p") == None {
            if jet_cli_command_override(directory, "build", color) == {
                .Entry(found) -> return JetCLIPlan.BuildPackage{file: found.path, color: color, options: build_options_stock("build"), build_args: passthrough ?? [String]{}, threads: threads, invocation: invocation, notice: "", locked: None}
                .Refused(plan) -> return plan.move()
                .Absent -> {}
            }
        }
        // A `workspace.jet` root without `-p` builds the workspace: each member,
        // then the index's own plan (InspectBuild.jet jet_cli_build_workspace_members).
        if jet_cli_option_value(jet_argv, "-p") == None {
            if jet_cli_workspace_source(directory, color) == .Index(index_path) {
                if jet_cli_file_name(index_path) == JET_CLI_WORKSPACE_FILE -> return jet_cli_build_entry(jet_argv, [String]{"build", index_path}, passthrough, color, quiet, threads, json)
            }
        }
        notices := [String]{}
        resolved: jet_cli_resolve_bare_entry("build", directory, jet_cli_option_value(jet_argv, "-p"), !jet_argv.contains("--show-default"), color, notices)
        if resolved == {
            .Entry(found) -> {
                // A package that declares `build: fn(b: Build)`, in the entry or
                // in another source file, builds through it.
                if (found.callable ?? "") == "build" || jet_cli_package_declares_build_entry(found.path) -> return JetCLIPlan.BuildPackage{file: found.path, color: color, options: build_options_stock("build"), build_args: passthrough ?? [String]{}, threads: threads, invocation: invocation, notice: notices.join(""), locked: None}
                if (passthrough ?? [String]{}).len() > 0 -> return jet_cli_build_args_refused(found.path, color)
                planned: jet_cli_read_entry(found.path, "build", color, quiet, threads, false, notices.join(""), json, false)
                if planned == .Check(file, source, _, _, _, _, notice, _, _, _, _, _, _) -> return JetCLIPlan.Build{file: file, source: source, color: color, options: build_options_stock("build"), threads: threads, invocation: invocation, notice: notice, json: json, sbom: jet_argv.contains("--sbom"), quiet: quiet, verbose: jet_cli_build_verbose(jet_argv)}
                return planned
            }
            .Refused(plan) -> return jet_cli_with_notices(notices, plan)
            .Absent -> return jet_cli_with_notices(notices, jet_cli_missing_bare_entry("build", directory, color))
        }
    }
    if args.len() > 1 && cli_files.is_file(args[1]) {
        if jet_cli_native_language(args[1]) == .Val(language) {
            if (passthrough ?? [String]{}).len() > 0 -> return jet_cli_build_args_refused(args[1], color)
            return jet_cli_native_source_plan(jet_argv, args[1], language, "build", [String]{}, color)
        }
    }
    entry: jet_cli_check(jet_argv, args, "build", color, quiet, threads, json)
    if entry == {
        .Check(file, source, _, _, _, _, notice, _, _, _, _, _, _) -> {
            // A file whose package declares `build: fn(b: Build)`, in it, in another
            // source file or in `package.jet`, builds through it.
            if jet_cli_declares_build_entry(source) || jet_cli_package_declares_build_entry(file) -> return JetCLIPlan.BuildPackage{file: file, color: color, options: build_options_stock("build"), build_args: passthrough ?? [String]{}, threads: threads, invocation: invocation, notice: notice, locked: None}
            if (passthrough ?? [String]{}).len() > 0 -> return jet_cli_build_args_refused(file, color)
            return JetCLIPlan.Build{file: file, source: source, color: color, options: build_options_stock("build"), threads: threads, invocation: invocation, notice: notice, json: json, sbom: jet_argv.contains("--sbom"), quiet: quiet, verbose: jet_cli_build_verbose(jet_argv)}
        }
        .Done(_) | .Refused(_, _, _, _) | .Diagnostics(_, _, _, _, _) | .CheckWorkspace(_, _, _, _, _, _, _, _, _, _) | .CheckPrelude(_, _, _, _, _, _) | .CheckCore(_, _, _, _, _) | .Build(_, _, _, _, _, _, _, _, _, _, _) | .LockedBuild(_, _) | .BuildPackage(_, _, _, _, _, _, _, _) | .Run(_, _, _, _, _, _, _, _, _, _, _, _) | .RunRemote(_, _, _, _, _, _, _, _) | .NativeSource(_, _, _, _, _) | .DevWeb(_, _, _, _, _, _, _, _) | .DevCanvas(_, _, _, _, _, _) | .Jobs(_, _, _, _) | .Test(_, _, _, _, _, _) | .TestWorkspace(_, _, _, _, _, _, _, _) | .TestProfile(_, _, _, _, _, _) | .New(_, _, _, _, _, _) | .Doc(_, _, _, _, _) | .Emit(_, _, _, _, _, _) | .Eval(_, _, _, _, _) | .Fill(_, _, _) | .Structural(_, _, _) | .Review(_, _, _) | .Keygen(_, _, _) | .KeyBackup(_, _, _) | .Publish(_, _, _, _) | .Yank(_, _, _) | .Lint(_, _, _, _, _, _, _) | .Fmt(_) | .FmtLang(_, _) | .Fix(_, _, _, _, _, _, _, _, _) | .Inspect(_) | .InspectB(_) | .ForeignBind(_, _, _) | .Perf(_, _) | .Semindex(_, _, _) | .Find(_, _, _, _) | .Cache(_, _) | .Remote(_, _, _) | .Comparison(_, _, _) | .Try(_, _, _) | .Maintenance(_, _, _, _) | .Completion(_, _, _) | .Schema(_, _, _, _, _) | .Codemod(_, _, _, _, _) | .PolicyExplain(_, _, _, _, _, _) | .DiagnosticTypeExplain(_, _, _, _) | .BuildFactExplain(_, _, _, _, _, _, _) | .Gates(_, _, _, _, _) | .Output(_, _, _, _) | .Doctor(_, _, _, _) | .UpdateJet(_, _, _, _, _) | .AuditCopies(_, _, _, _, _) | .AuditForeign(_, _, _, _, _) | .CompilerService(_) | .Repl(_, _, _, _) | .LSP | .ReplChild(_) | .EvalExpression(_, _, _) | .Prove(_, _, _, _, _, _) | .Budget(_, _, _, _) | .AuditWrites(_, _, _, _, _) -> {}
    }
    entry
}

// `jet build --verbose` (or `-v`).
jet_cli_build_verbose: fn(jet_argv: [String]) -> Bool Never! {
    jet_argv.contains("--verbose") || jet_argv.contains("-v")
}

// `jet build <entry> -- words` where no `build: fn` runs: nothing reads the
// words, so they are refused, never dropped.
jet_cli_build_args_refused: fn(file: String, color: Bool) -> JetCLIPlan Never! {
    jet_cli_fail("E2104", "`jet build {file} -- …` passes the words after `--` to `build: fn`, and this build runs none", jet_cli_why("E2104"), "remove the words after `--`, or build a package whose `build.jet` declares `build: fn(b: Build)` and reads them with `b.args()`", color, JET_DRIVER_EXIT_USAGE)
}

// `jet build <entry> <word>…`: a build takes one file or directory and no
// program arguments, so the extra words are refused, never dropped.
jet_cli_build_extra_refused: fn(args: [String], color: Bool) -> JetCLIPlan Never! {
    extra: jet_cli_tail(args, 2).join(" ")
    jet_cli_fail("E2104", "`jet build` takes one file or directory, and `{extra}` follows `{args[1]}`", jet_cli_why("E2104"), "remove `{extra}`, or pass it to `build: fn` after `--`: `jet build {args[1]} -- {extra}`", color, JET_DRIVER_EXIT_USAGE)
}

// `jet {command} <file>` of a C or C++ file (#6686): its plan at the
// optimize level the flags select, or the refusal of a flag it doesn't take.
// It takes `--release` (O2) and `--optimize=none|basic|full` (O0, O1, O2)
// over the command's stock level (run O0, build O2, as for Jet), and the
// output flags. An explicit level wins over `--release`; two that disagree
// are refused, as are the other flags, never ignored.
jet_cli_native_source_plan: fn(jet_argv: [String], file: String, language: String, command: String, program_args: [String], color: Bool) -> JetCLIPlan Never! {
    level := jet_cli_native_level(build_options_stock(command))
    named: if language == "c" -> "C" else -> "C++"
    release := false
    explicit := ""
    loop argument in jet_argv {
        if argument == "--" -> break
        if !argument.starts_with("-") || argument == "-" -> next
        head: argument.split("=").to_list()[0]
        if head == {
            "--release" -> release = true
            "--optimize" -> {}
            "--color" | "--no-color" | "--quiet" | "-q" -> {}
            else -> return jet_cli_fail("E2104", "`jet {command} {file}` compiles {named}, which takes no `{head}`", jet_cli_why("E2104"), "remove `{head}`; a C or C++ file takes `--release` or `--optimize=none|basic|full`", color, JET_DRIVER_EXIT_USAGE)
        }
        if head != "--optimize" -> next
        if argument != "--optimize=none" && argument != "--optimize=basic" && argument != "--optimize=full" {
            return jet_cli_fail("E2104", "`{argument}` isn't an optimize level", jet_cli_why("E2104"), "write `--optimize=none`, `--optimize=basic` or `--optimize=full`", color, JET_DRIVER_EXIT_USAGE)
        }
        if explicit != "" && explicit != argument -> return jet_cli_fail("E2104", "`{explicit}` and `{argument}` disagree", jet_cli_why("E2104"), "pass `--optimize` once", color, JET_DRIVER_EXIT_USAGE)
        explicit = argument.copy()
    }
    if {
        explicit == "--optimize=none" -> level = 0
        explicit == "--optimize=basic" -> level = 1
        explicit == "--optimize=full" || release -> level = 2
        else -> {}
    }
    JetCLIPlan.NativeSource{file: file, level: level, run: command == "run", program_args: program_args, color: color}
}

// The jet flags `jet run` and `jet dev` honor besides the compiler controls
// (jet_cli_run_control) (`--observe`, `--sha256` and
// `-e` are a run's alone and `--port` is a dev's alone: the other command
// refuses them as scoped to the one that owns them). `--sha256` pins a URL
// target's first fetch and is refused on a local path; a bare `--port` is
// refused for its missing value. `-e` is honored before a run's target
// (jet_cli_eval_flag_at) and refused after it. Any other registered flag on
// a run is refused until its port lands, never ignored; an unregistered one,
// a single-dash word too, is refused by E2102: on `jet run` and the
// `jet <file>` shorthand by jet_cli_check_flags, on `jet dev` by
// jet_cli_run_entry.
JET_CLI_RUN_PORTED_FLAGS: [String]{"--release", "--profile", "--verbose", "-v", "--quiet", "--json", "--color", "--no-color", "--threads", "--allow", "--allow-all", "-A", "--deny", "-p", "--show-default", "--no-prepare", "--set", "--gate", "--log", "--observe", "-e", "--sha256", "--port", "--deep-checks"}

// A compiler control (CLIControls.jet) `jet run` or `jet dev` takes: its row
// scopes it to `command`, and the command model ports the form.
jet_cli_run_control: fn(head: String, command: String) -> Bool Never! {
    if jet_cli_control_of_flag(head) == None -> return false
    spec: jet_cli_flag_spec(head) ?? return false
    jet_cli_flag_takes(spec, command) && jet_cli_form_ported("{command} {head}")
}

// `--log=<filter>` of `jet run` and `jet dev`, the last one before `--`: the
// core.log level filter the program starts with, above JET_LOG
// (Core/Log/Log.jet); "" when none is given, None for a bare `--log`.
jet_cli_log_flag: fn(jet_argv: [String]) -> String? Never! {
    filter := ""
    loop argument in jet_argv {
        if argument == "--" -> break
        if argument == "--log" -> return None
        if argument.starts_with("--log=") -> filter = argument.removeprefix("--log=").trim()
    }
    Val(filter)
}

// `jet run [<file>]` under its build options (jet_cli_build_options); `watch`
// makes it `jet dev`.
jet_cli_run: fn(jet_argv: [String], args: [String], passthrough: [String]?, shorthand: Bool, watch: Bool, color: Bool, quiet: Bool, verbose: Bool, threads: Int?) -[FS, Env, Exec]> JetCLIPlan Never! {
    jet_cli_with_build_options(jet_cli_run_entry(jet_argv, args, passthrough, shorthand, watch, color, quiet, verbose, threads), jet_argv, quiet)
}

// `jet run [<file>]` (`args` = `run`, the target, then the positional words),
// also the `jet <file>` shorthand (`shorthand`). The target resolves as `jet
// check` resolves it. The program's arguments are the words after the first
// standalone `--` (`passthrough`), or else the positional words after the
// target. A `jet dev` (`watch`) resolves its own command home and starts at the
// `dev: fn` its target declares, unless `--show-default` asks for the stock
// entry; `--watch=off` runs it once instead of rerunning it on every change.
jet_cli_run_entry: fn(jet_argv: [String], args: [String], passthrough: [String]?, shorthand: Bool, watch: Bool, color: Bool, quiet: Bool, verbose: Bool, threads: Int?) -[FS, Env, Exec]> JetCLIPlan Never! {
    if jet_cli_option_flags_refusal(jet_argv, color) == .Val(refusal) -> return refusal
    if !watch && !shorthand && args.len() > 1 {
        if jet_cli_remote_run_target(args[1]) == .Val(target) -> return jet_cli_remote_run_plan(target, jet_argv, args, passthrough, color, quiet, verbose, threads)
    }
    keep_watching := watch
    loop argument in jet_argv {
        if !argument.starts_with("-") || argument == "-" -> next
        if watch && (argument == "--watch" || argument == "--watch=on") -> next
        if watch && (argument == "--observe" || argument == "-e") -> return jet_cli_misplaced_flag(argument, "dev", [String]{"run"}, color)
        if watch && argument == "--watch=off" {
            keep_watching = false
            next
        }
        head: argument.split("=").to_list()[0]
        if head == "-e" -> return jet_cli_fail("E2104", "`-e` runs code in place of a program, so it comes before any", jet_cli_why("E2104"), "run the code alone: `jet -e 'print(1 + 2)'` or `jet run -e 'print(1 + 2)'`", color, JET_DRIVER_EXIT_USAGE)
        if head == "--sha256" && !watch {
            if argument == "--sha256" -> return jet_cli_fail("E2104", "`--sha256` needs its value", jet_cli_why("E2104"), "write `--sha256=<64 hex digits>` before the URL", color, JET_DRIVER_EXIT_USAGE)
            return jet_cli_fail("E2104", "`--sha256` pins the first fetch of a URL, and `{if args.len() > 1 -> args[1] else -> "."}` is a local path", jet_cli_why("E2104"), "drop `--sha256`; a local file runs as it is on disk", color, JET_DRIVER_EXIT_USAGE)
        }
        if watch && head == "--port" {
            if argument == "--port" -> return jet_cli_fail("E2104", "`--port` needs its value", jet_cli_why("E2104"), "write `--port=8080`, or leave it out to let the preview listener choose a port", color, JET_DRIVER_EXIT_USAGE)
            next
        }
        command: if watch -> "dev" else -> "run"
        if JET_CLI_RUN_PORTED_FLAGS.contains(head) || build_option_flag_row(head) != None || jet_cli_run_control(head, command) -> next
        // `jet run` and the `jet <file>` shorthand refused an unknown flag
        // already (jet_cli_check_flags); `jet dev` checks its own here.
        if !jet_cli_is_known_flag(head) -> return jet_cli_unknown_flag(head, command, color)
        return jet_cli_not_ported("{command} {head}", color)
    }
    // `dispatch_nixpkgs_run`: `jet run <package>@nixpkgs`.
    if !shorthand && args.len() > 1 {
        parts: args[1].split("@").to_list()
        if parts.len() > 1 && parts[parts.len() - 1] == "nixpkgs" && args[1] != "@nixpkgs" -> return jet_cli_not_ported("run <package>@nixpkgs", color)
    }
    invocation := JetCLIInvocationAuthority?{None}
    if jet_cli_authority_flags(jet_argv, color) == {
        .Refused(refusal) -> return refusal
        .Rows(rows) -> invocation = rows
    }
    // `jet dev`, and a `jet run` that refuses preparation, stop at the
    // project environment boundary before the program loads (EnvBoundary.jet).
    if watch || jet_cli_flag_before_separator(jet_argv, "--no-prepare") {
        target: if args.len() > 1 -> args[1] else -> "."
        if jet_cli_env_boundary_refusal(target, jet_argv, color) == .Val(refusal) -> return refusal
    }
    // A C or C++ file compiles with the C toolchain and runs (#6686); `jet
    // dev` takes Jet source alone.
    if !watch && args.len() > 1 && cli_files.is_file(args[1]) {
        if jet_cli_native_language(args[1]) == .Val(language) -> return jet_cli_native_source_plan(jet_argv, args[1], language, "run", passthrough ?? jet_cli_tail(args, 2), color)
    }
    command: if watch -> "dev" else -> "run"
    entry: jet_cli_check(jet_argv, args, command, color, quiet, threads, false)
    if entry == {
        .Check(file, source, _, _, _, _, notice, _, _, _, _, _, _) -> {
            // `jet dev` of a browser program serves its web build, which
            // starts no program to read words, so they are refused.
            if watch && jet_cli_dev_web_selected(jet_argv, source) {
                port: jet_cli_dev_web_port(jet_argv) ?? return jet_cli_fail("E2104", "`--port` needs a TCP port number from 0 to 65535", jet_cli_why("E2104"), "write `--port=8080`, or leave it out to let the preview listener choose a port", color, JET_DRIVER_EXIT_USAGE)
                unread: passthrough ?? jet_cli_tail(args, 2)
                if unread.len() > 0 {
                    extra: unread.join(" ")
                    return jet_cli_fail("E2104", "`jet dev` serves this program's web build, which reads no program arguments, and `{extra}` follows it", jet_cli_why("E2104"), "remove `{extra}`; `jet dev` passes words to a native program, as `jet run` does", color, JET_DRIVER_EXIT_USAGE)
                }
                return JetCLIPlan.DevWeb{file: file, source: source, color: color, options: build_options_stock("build"), threads: threads, invocation: invocation, notice: notice, port: port}
            }
            // A web-targeted program builds browser artifacts; only an
            // explicit `--target` asks for a native run of it. A full-stack
            // App entry is a server, and `jet run` serves it.
            if !watch && jet_cli_target_flag(jet_argv) == .Absent && jet_cli_declares_web_target(source) && !jet_cli_declares_web_app(source) {
                return jet_cli_fail("E-WEB-RUN", "`jet run` cannot execute a web-targeted program natively", "The web target produces browser artifacts, not a native console executable", "Use `jet dev <file.jet>` for the live browser loop, or `jet build --target=web <file.jet>` for web artifacts", color, JET_DRIVER_EXIT_USER_ERROR)
            }
            program_args: passthrough ?? jet_cli_tail(args, 2)
            selects_dev: watch && !jet_argv.contains("--show-default") && jet_cli_top_level_function_lines(source, "dev").len() > 0
            function: if selects_dev -> String?{Val("dev")} else -> String?{None}
            return JetCLIPlan.Run{file: file, source: source, color: color, options: build_options_stock("run"), verbose: verbose, json: jet_argv.contains("--json"), threads: threads, program_args: program_args, invocation: invocation, notice: notice, watch: keep_watching, entry: function}
        }
        .Done(_) | .Refused(_, _, _, _) | .Diagnostics(_, _, _, _, _) | .CheckWorkspace(_, _, _, _, _, _, _, _, _, _) | .CheckPrelude(_, _, _, _, _, _) | .CheckCore(_, _, _, _, _) | .Build(_, _, _, _, _, _, _, _, _, _, _) | .LockedBuild(_, _) | .BuildPackage(_, _, _, _, _, _, _, _) | .Run(_, _, _, _, _, _, _, _, _, _, _, _) | .RunRemote(_, _, _, _, _, _, _, _) | .NativeSource(_, _, _, _, _) | .DevWeb(_, _, _, _, _, _, _, _) | .DevCanvas(_, _, _, _, _, _) | .Jobs(_, _, _, _) | .Test(_, _, _, _, _, _) | .TestWorkspace(_, _, _, _, _, _, _, _) | .TestProfile(_, _, _, _, _, _) | .New(_, _, _, _, _, _) | .Doc(_, _, _, _, _) | .Emit(_, _, _, _, _, _) | .Eval(_, _, _, _, _) | .Fill(_, _, _) | .Structural(_, _, _) | .Review(_, _, _) | .Keygen(_, _, _) | .KeyBackup(_, _, _) | .Publish(_, _, _, _) | .Yank(_, _, _) | .Lint(_, _, _, _, _, _, _) | .Fmt(_) | .FmtLang(_, _) | .Fix(_, _, _, _, _, _, _, _, _) | .Inspect(_) | .InspectB(_) | .ForeignBind(_, _, _) | .Perf(_, _) | .Semindex(_, _, _) | .Find(_, _, _, _) | .Cache(_, _) | .Remote(_, _, _) | .Comparison(_, _, _) | .Try(_, _, _) | .Maintenance(_, _, _, _) | .Completion(_, _, _) | .Schema(_, _, _, _, _) | .Codemod(_, _, _, _, _) | .PolicyExplain(_, _, _, _, _, _) | .DiagnosticTypeExplain(_, _, _, _) | .BuildFactExplain(_, _, _, _, _, _, _) | .Gates(_, _, _, _, _) | .Output(_, _, _, _) | .Doctor(_, _, _, _) | .UpdateJet(_, _, _, _, _) | .AuditCopies(_, _, _, _, _) | .AuditForeign(_, _, _, _, _) | .CompilerService(_) | .Repl(_, _, _, _) | .LSP | .ReplChild(_) | .EvalExpression(_, _, _) | .Prove(_, _, _, _, _, _) | .Budget(_, _, _, _) | .AuditWrites(_, _, _, _, _) -> {}
    }
    entry
}

// `jet run <url>` and `jet run <package>` (RemoteRun.jet): a local run's
// flags, plus `--sha256=<hex>` on a URL and `--locked`. The host fetches,
// pins and runs the target (jet_cli_remote_run_host).
jet_cli_remote_run_plan: fn(target: JetCLIRemoteRunTarget, jet_argv: [String], args: [String], passthrough: [String]?, color: Bool, quiet: Bool, verbose: Bool, threads: Int?) -> JetCLIPlan Never! {
    registry: if target == {
        .URL(_) -> false
        .Registry(_, _) -> true
    }
    loop argument in jet_argv {
        if !argument.starts_with("-") || argument == "-" -> next
        head: argument.split("=").to_list()[0]
        if head == "-e" -> return jet_cli_fail("E2104", "`-e` runs code in place of a program, so it can't run `{args[1]}`", jet_cli_why("E2104"), "run the code alone: `jet -e 'print(1 + 2)'`, or drop `-e` to run `{args[1]}`", color, JET_DRIVER_EXIT_USAGE)
        if head == "--sha256" {
            if registry -> return jet_cli_fail("E2104", "`--sha256` pins the first fetch of a URL, and `{args[1]}` is a registry package", jet_cli_why("E2104"), "drop `--sha256`; the registry's signed index pins a package version", color, JET_DRIVER_EXIT_USAGE)
            if argument == "--sha256" -> return jet_cli_fail("E2104", "`--sha256` needs its value", jet_cli_why("E2104"), "write `--sha256=<64 hex digits>`", color, JET_DRIVER_EXIT_USAGE)
            next
        }
        if head == "--locked" || JET_CLI_RUN_PORTED_FLAGS.contains(head) || build_option_flag_row(head) != None || jet_cli_run_control(head, "run") || !jet_cli_is_known_flag(head) -> next
        return jet_cli_not_ported("run {head}", color)
    }
    if jet_cli_authority_flags(jet_argv, color) == .Refused(refusal) -> return refusal
    JetCLIPlan.RunRemote{target: target, jet_argv: jet_argv, args: args, passthrough: passthrough, color: color, quiet: quiet, verbose: verbose, threads: threads}
}

// Whether `jet dev` serves the program's web build: a `#Target(Web)`
// program, or a `--port`, the application preview listener
// (canvas-protocol.md). A full-stack App entry is a server, and `jet dev`
// runs it natively.
jet_cli_dev_web_selected: fn(jet_argv: [String], source: String) -> Bool Never! {
    if jet_cli_declares_web_app(source) -> return false
    jet_cli_declares_web_target(source) || jet_cli_dev_web_port_word(jet_argv) != None
}

// The `--port=N` word of a `jet dev` before its program's `--`, if any.
jet_cli_dev_web_port_word: fn(jet_argv: [String]) -> String? Never! {
    loop argument in jet_argv {
        if argument == "--" -> break
        if argument.starts_with("--port=") -> return Val(argument.removeprefix("--port="))
    }
    None
}

// The preview listener's port: `--port=N`, else 0 (the listener picks one);
// None for a word that isn't a TCP port number.
jet_cli_dev_web_port: fn(jet_argv: [String]) -> Int? Never! {
    word: jet_cli_dev_web_port_word(jet_argv) ?? return Val(0)
    port: Int.parse(word) ?? return None
    if port < 0 || port > 65535 || "{port}" != word -> return None
    Val(port)
}

jet_cli_test_option_error: fn(what: String, color: Bool) -> JetCLIPlan Never! {
    jet_cli_fail("E2104", what, jet_cli_why("E2104"), "use the canonical `jet test` flag spelling", color, JET_DRIVER_EXIT_USAGE)
}

// `jet test [<target>] [<filter>]` (`TestRunOpts::parse`, `run_test_opts`,
// `run_test_target` up to the compile). A package directory (or no target
// inside a package) tests through its own `test: fn(t: Test)` when it declares
// one, as `jet build` runs its `build: fn`. The tested file's doctests run as
// claims of the same harness (Doctests.jet). Each setting flag writes the
// flag layer of the test settings (TestSettingLayers.jet), over a profile's
// and `test: fn`'s; the result cache and the flags the command model
// (JET_CLI_FORMS) marks unported are not ported yet.
jet_cli_test: fn(jet_argv: [String], color: Bool, quiet: Bool, verbose: Bool, threads: Int?) -[FS, Env, Exec]> JetCLIPlan Never! {
    if jet_cli_option_flags_refusal(jet_cli_test_build_argv(jet_argv, ""), color) == .Val(refusal) -> return refusal
    options := JetCLITestOptions{build: build_options_stock("test"), capture: "failed", filter: None, shuffle_seed: None, serial: false, trace_tiers: false, update_snapshots: false, docs: false, measure: false, json: false, profile: "", project_root: None, status: ""}
    flags := [TestSetting]{}
    show_default := false
    positionals := [String]{}
    // Where the target positional is in jet_argv (-1: none).
    target_at := -1
    index := 0
    loop index < jet_argv.len() {
        argument: jet_argv[index]
        if index == 0 && argument == "test" {
            index += 1
            next
        }
        if argument == "--" -> break
        name: argument.split("=").to_list()[0]
        inline := String?{None}
        if name.len() < argument.len() -> inline = Val(argument.slice(name.len() + 1..<argument.len()))
        if test_setting_flag_row(name) == .Val(row) {
            if !row.ported -> return jet_cli_not_ported("test {name}", color)
            // A bare `--shuffle` seeds from the clock, which the Jet host
            // does not read yet.
            if name == "--shuffle" && inline == None -> return jet_cli_not_ported("test <--shuffle without a seed>", color)
            raw := inline ?? ""
            if inline == None {
                if row.kind == TestSettingKind.Switch {
                    raw = "true"
                } else {
                    if !JET_CLI_SEPARATE_VALUE_FLAGS.contains(name) || index + 1 >= jet_argv.len() -> return jet_cli_test_option_error("`{name}` needs a value", color)
                    index += 1
                    raw = jet_argv[index].copy()
                }
            }
            spelled: test_setting_flag(row.name)
            hint: test_setting_hint(row)
            value: test_setting_value(row, raw) ?? return jet_cli_fail("E2104", "`{spelled}` needs {hint}, not `{raw}`", jet_cli_why("E2104"), "write `{spelled}=` with {hint}", color, JET_DRIVER_EXIT_USAGE)
            if row.name == "filter" && test_settings_get(flags, "filter") == .Val(previous) && previous != value -> return jet_cli_test_option_error("conflicting test filters `{previous}` and `{value}`", color)
            test_settings_put(flags, TestSetting{name: row.name.copy(), value: value, source: JET_CLI_TEST_FLAG_LAYER})
            index += 1
            next
        }
        // A separate value is the flag's, never the target or filter; `--set`
        // writes a package setting the build options read
        // (jet_cli_setting_flags).
        if (name == "--profile" || name == "--threads" || name == "--color" || name == "--set") && inline == None {
            if index + 1 >= jet_argv.len() -> return jet_cli_test_option_error("`{name}` needs a value", color)
            index += 1
        }
        if {
            name.starts_with("-") && !jet_cli_form_ported("test {name}") -> return jet_cli_not_ported("test {name}", color)
            name == "--show-default" -> show_default = true
            name == "--json" -> options.json = true
            argument.starts_with("-") -> {}
            else -> {
                if positionals.len() == 0 -> target_at = index
                positionals.push(argument.copy())
            }
        }
        index += 1
    }
    if positionals.len() > 2 {
        extra: jet_cli_tail(positionals, 2).join(" ")
        return jet_cli_fail("E2104", "`jet test` takes one target and one filter, and `{extra}` follows them", jet_cli_why("E2104"), "remove `{extra}`: `jet test {positionals[0]} {positionals[1]}`", color, JET_DRIVER_EXIT_USAGE)
    }
    if positionals.len() == 2 {
        filter: positionals[1]
        if test_settings_get(flags, "filter") == .Val(previous) {
            if previous != filter -> return jet_cli_test_option_error("conflicting test filters `{previous}` and `{filter}`", color)
        } else {
            test_settings_put(flags, TestSetting{name: "filter", value: filter.copy(), source: JET_CLI_TEST_FLAG_LAYER})
        }
    }
    boundary_target: if positionals.len() > 0 -> positionals[0] else -> "."
    if jet_cli_env_boundary_refusal(boundary_target, jet_argv, color) == .Val(refusal) -> return refusal
    // `--profile <test profile>`, or a bare package run under `defaults: { test: … }`;
    // never the plan step of one (TestSettingLayers.jet jet_cli_test_code_layer).
    if cli_sys.get(TEST_SETTINGS_PLAN_ENV) == None {
        if jet_cli_test_profile_plan(jet_argv, positionals, show_default, flags, color, quiet) == .Val(plan) -> return plan
    }
    options.stock = show_default
    options.quiet = quiet
    if show_default && !quiet -> options.status = "jet test: using stock default\n"
    // A bare `jet test` or `jet test <dir>` tests the package: the directory's own
    // `test: fn(t: Test)` file when it declares one, otherwise its stock entry. The
    // entry file loads the whole package, and the harness collects every #Test of
    // every package file. A workspace root tests each member that can run `jet test`,
    // as its own child `jet test <member>`; its own test.jet declares only the code
    // suites its test profiles run (TestProfile.jet), as `jet test <root>/test.jet`.
    // `jet test <root>/workspace.jet` tests the workspace, as `jet test <root>` does.
    if positionals.len() > 0 && jet_cli_file_name(positionals[0]) == JET_CLI_WORKSPACE_FILE && cli_files.is_file(positionals[0]) {
        positionals[0] = jet_cli_parent(positionals[0]) ?? "."
    }
    if positionals.len() == 0 || cli_files.is_dir(positionals[0]) {
        directory: if positionals.len() == 0 -> cli_files.cwd() ?? "." else -> positionals[0]
        if positionals.len() == 0 && !jet_cli_has_manifest_above(directory) && !jet_cli_workspace_present(jet_cli_workspace_source(directory, color)) {
            return jet_cli_fail("E2104", "no file given and no `package.jet` found in this directory or above", jet_cli_why("E2104"), "run `jet test <file.jet>` or cd into a project", color, JET_DRIVER_EXIT_USAGE)
        }
        // A directory of the Core library tests each Core source under it
        // that declares #Tests or doctests, as its own child `jet test <file>`
        // (Host.jet jet_cli_compile_core_test).
        if positionals.len() > 0 {
            if jet_cli_core_test_files(directory) == .Val(core) -> return jet_cli_test_workspace_plan(jet_argv, target_at, core.names, core.files, color, quiet)
        }
        workspace_notices := [String]{}
        if jet_cli_workspace_test_members(directory, !show_default, color, workspace_notices) == {
            // Each child resolves its member, and writes the notices, itself.
            .Members(names, directories) -> return jet_cli_test_workspace_plan(jet_argv, target_at, names, directories, color, quiet)
            .Refused(plan) -> return jet_cli_with_notices(workspace_notices, plan)
            // Resolution below writes its own notices.
            .Absent -> {}
        }
        if !show_default {
            if jet_cli_command_override(directory, "test", color) == {
                .Entry(found) -> return jet_cli_test_file(jet_argv, found.path, color, verbose, threads, options, flags, directory, quiet)
                .Refused(plan) -> return plan.move()
                .Absent -> {}
            }
        }
        if positionals.len() == 0 {
            notices := [String]{}
            if jet_cli_resolve_bare_entry("test", directory, None, !show_default, color, notices) == {
                .Entry(entry) -> return jet_cli_test_file(jet_argv, entry.path, color, verbose, threads, options, flags, "", quiet)
                .Refused(plan) -> return jet_cli_with_notices(notices, plan)
                .Absent -> return jet_cli_with_notices(notices, jet_cli_missing_bare_entry("test", directory, color))
            }
        }
        if jet_cli_resolve_directory_target("test", directory, None, !show_default, color) == {
            .File(path, _, _) -> return jet_cli_test_file(jet_argv, path, color, verbose, threads, options, flags, "", quiet)
            .Refused(plan) -> return plan
        }
    }
    target: positionals[0]
    // `resolve_source_path`: the typed spelling, else `<target>.jet`.
    file := target
    if !cli_files.is_file(target) && cli_files.is_file("{target}.jet") -> file = "{target}.jet"
    jet_cli_test_file(jet_argv, file, color, verbose, threads, options, flags, "", quiet)
}

// Each member's `jet test` words for a workspace `jet test`: `test`, the
// member directory in place of the workspace target, then every other word
// of `jet_argv` as written (flags, the filter, words after `--`). A child's
// streams are captured, so a colored run asks for color.
jet_cli_test_workspace_plan: fn(jet_argv: [String], target_at: Int, names: [String], directories: [String], color: Bool, quiet: Bool) -> JetCLIPlan Never! {
    rest := [String]{}
    loop (index, argument) in jet_argv {
        if (index == 0 && argument == "test") || index == target_at -> next
        rest.push(argument.copy())
    }
    if color && !rest.any(fn(argument) { argument == "--color" || argument.starts_with("--color=") }) -> rest.push("--color=always")
    member_args := [[String]]{}
    loop directory in directories {
        args := [String]{"test", directory}
        loop argument in rest -> args.push(argument)
        member_args.push(args)
    }
    JetCLIPlan.TestWorkspace{names: names, member_args: member_args, envs: [[String]]{}, executable: "", heading: "member", results: "", tiers: [String]{}, quiet: quiet}
}

// One test file (or a package entry file): the harness collects every #Test the file and
// its package load, and a `test: fn(t: Test)` there runs first with the suite. The run's
// settings are `flags` over those it inherits from the run that started it, else over
// the `test: fn` layer of the package at `code_root` ("": none) (TestSettingLayers.jet).
jet_cli_test_file: fn(jet_argv: [String], file: String, color: Bool, verbose: Bool, threads: Int?, given: JetCLITestOptions, flags: [TestSetting], code_root: String, quiet: Bool) -[FS, Env, Exec]> JetCLIPlan Never! {
    options := given
    if !cli_files.exists(file) {
        return jet_cli_report_done(options.status, "E2105", "can't find `{file}`", jet_cli_why("E2105"), "correct the named problem, then run the command again", color, JET_DRIVER_EXIT_USER_ERROR)
    }
    // A child of a run takes the settings that run decided (TEST_SETTINGS_ENV).
    inherited: cli_sys.get(TEST_SETTINGS_ENV) != None
    settings := flags.copy() // copy: the caller keeps its flag layer.
    if inherited {
        decided: jet_cli_test_inherited_settings() ?? return jet_cli_test_option_error(err.message, color)
        settings = test_settings_layered(decided, flags)
    } else if code_root != "" && cli_sys.get(TEST_SETTINGS_PLAN_ENV) == None {
        code: jet_cli_test_code_layer(code_root) ?? return jet_cli_test_code_refusal(err.message, color)
        settings = test_settings_layered(code, flags)
    }
    // A file's run has no corpus suite; a profile run's children keep none
    // of the corpus-pool settings (JET_CLI_TEST_PARENT_SETTINGS).
    if jet_cli_test_settings_refusal(settings, false, color) == .Val(refusal) -> return refusal
    if jet_cli_test_settings_fan_out(jet_argv, settings, quiet) == .Val(plan) -> return plan
    jet_cli_test_settings_apply(options, settings)
    if !inherited && !quiet {
        options.status = "{options.status}{jet_cli_test_settings_notice(settings)}"
    }
    source: cli_files.read(file) ?? {
        return jet_cli_report_done(options.status, "E2105", "couldn't read `{file}`: {err}", jet_cli_why("E2105"), "correct the named problem, then run the command again", color, JET_DRIVER_EXIT_USER_ERROR)
    }
    // `--measure` builds under the release profile unless a profile is named;
    // a decided `optimize` level is the build's `--optimize`.
    levels: test_settings_levels(settings)
    argv := [String]{}
    if options.measure && jet_cli_profile_name(jet_argv) == "" -> argv.push("--release")
    loop argument in jet_cli_test_build_argv(jet_argv, if levels.len() == 1 -> levels[0] else -> "") -> argv.push(argument)
    options.profile = jet_cli_profile_name(argv)
    if jet_cli_build_options(argv, "test", file, source, color, quiet) == {
        .Refused(refusal) -> return refusal
        .Selected(selected, notes) -> {
            options.build = selected.move()
            options.status = "{options.status}{notes}"
        }
    }
    options.project_root = jet_cli_manifest_root(jet_cli_parent(file) ?? ".")
    JetCLIPlan.Test{file: file, source: source, color: color, verbose: verbose, threads: threads, options: options}
}

// `jet explain [<CODE>|<syntax>|<policy>|<registration>]` (
// `run_explain`, `lookup`): registered diagnostic essays render through
// Explain.jet; an unregistered code-shaped subject keeps the driver's
// unknown-code report; offline syntax and standalone policies render through
// SyntaxExplain.jet, then registered facts and corpus truths through
// RegistrationExplain.jet; only then is a syntax-shaped miss the E2106 typo
// report. Build facts resolve their writer chain over the load of the named
// file (BuildFactExplain.jet); `marker` sites and a policy with a source file
// are load-only source queries; `--web-graph <file>` reports the application
// graph of the checked entry and `--routes <file>` every row of its App's
// route table (WebGraph.jet). Any other query names a package:
// the Jetpack engine explains its Hangar record or last realization attempt.
// The `--reload` and `--cost` views stay refused. `log [<file|dir>]` lists
// every source of the core.log level filter (LogExplain.jet); `effects
// [<file>[:<line>]]` lists every effect cap in force at one site, nearest
// first, and `--caps` every written effect cap under a path (ExplainEffects.jet).
jet_cli_explain: fn(jet_argv: [String], args: [String], color: Bool, json: Bool, threads: Int?) -[FS, Env]> JetCLIPlan Never! {
    if jet_cli_has(jet_argv, "--reload") -> return jet_cli_not_ported("explain --reload", color)
    if jet_cli_has(jet_argv, "--cost") -> return jet_cli_not_ported("explain --cost", color)
    if jet_cli_has(jet_argv, "--web-graph") {
        if args.len() < 2 -> return jet_cli_done("", "usage: jet explain --web-graph <file.jet>\n", JET_DRIVER_EXIT_USAGE)
        return JetCLIPlan.Inspect{job: JetCLIInspectJob{action: "web-graph", file: jet_cli_inspect_absolute(args[1]), subject: None, json: json, color: false, threads: threads, notice: "", project: false}}
    }
    if jet_cli_has(jet_argv, "--routes") {
        if args.len() < 2 -> return jet_cli_done("", "usage: jet explain --routes <file.jet>\n", JET_DRIVER_EXIT_USAGE)
        return JetCLIPlan.Inspect{job: JetCLIInspectJob{action: "routes", file: jet_cli_inspect_absolute(args[1]), subject: None, json: json, color: false, threads: threads, notice: "", project: false}}
    }
    if jet_cli_explain_diagnostic(args, color, json) == .Val(plan) -> return plan
    if args.len() == 2 && jet_cli_is_diagnostic_code(args[1]) -> return JetCLIPlan.Done{output: jet_driver_explain_code(Val(args[1]), color)}
    query: args[1]
    if query == "log" -> return jet_cli_explain_log(args, color, json)
    if query == "effects" -> return jet_cli_explain_effects(jet_argv, args, color, json, threads)
    if query == "marker" {
        // `run_explain_marker`: extra words stay ignored.
        if args.len() < 4 -> return jet_cli_done("", "usage: jet explain marker <file>:<line> <policy-key>\n", JET_DRIVER_EXIT_USAGE)
        marker: jet_cli_explain_marker_site(args[2]) ?? return jet_cli_fail("E2104", err.message, jet_cli_why("E2104"), "correct the named argument or input, then run the command again", color, JET_DRIVER_EXIT_USAGE)
        key: policy_key_parse(args[3]) ?? return jet_cli_fail("E2104", "`{args[3]}` is not a registered scoped policy", jet_cli_why("E2104"), "correct the named argument or input, then run the command again", color, JET_DRIVER_EXIT_USER_ERROR)
        return JetCLIPlan.PolicyExplain{key: key, file: marker.file, site: Val(args[2]), line: Val(marker.line), color: color, json: json}
    }
    if jet_cli_explain_build_fact_name(query) == .Val(key) {
        if jet_cli_setting_flags(jet_argv, color) == {
            .Refused(plan) -> return plan
            .Given(settings) -> return JetCLIPlan.BuildFactExplain{key: key, file: if args.len() > 2 -> args[2] else -> "", profile: jet_cli_build_fact_profile(jet_argv), settings: settings.copy(), module_value: None, color: color, json: json}
        }
    }
    if args.len() > 2 && jet_cli_module_value(query, cli_files.read(args[2]) ?? "") == .Val(value) {
        if jet_cli_setting_flags(jet_argv, color) == {
            .Refused(plan) -> return plan
            .Given(settings) -> return JetCLIPlan.BuildFactExplain{key: "Build.Settings.{value.setting}", file: args[2], profile: jet_cli_build_fact_profile(jet_argv), settings: settings.copy(), module_value: Val(value), color: color, json: json}
        }
    }
    if args.len() > 2 && policy_key_parse(query.trim().removeprefix("@")) == .Val(key) {
        return JetCLIPlan.PolicyExplain{key: key, file: args[2], site: None, line: None, color: color, json: json}
    }
    verbose: jet_cli_has(jet_argv, "--verbose")
    if jet_cli_syntax_lookup(query) != None && jet_cli_explain_syntax(query, verbose, color, json) == .Val(plan) -> return plan
    if args.len() == 2 && jet_cli_explain_policy(query, color, json) == .Val(plan) -> return plan
    if jet_cli_explain_registration(query, color, json) == .Val(plan) -> return plan
    // `jet.` names Jet's own diagnostic types, every one a registry row
    // (found above): an unknown one is an unknown code, not a module to load.
    if query.starts_with("jet.") -> return JetCLIPlan.Done{output: jet_driver_explain_code(Val(query), color)}
    if jet_cli_is_diagnostic_type_path(query) -> return JetCLIPlan.DiagnosticTypeExplain{name: query, file: if args.len() > 2 -> args[2] else -> ".", color: color, json: json}
    if jet_cli_explain_syntax(query, verbose, color, json) == .Val(plan) -> return plan
    JetCLIPlan.InspectB{plan: JetCLIInspectBPlan.Engine{engine: JET_CLI_JETPACK_BINARY, verb: "explain", argv: jet_cli_command_words(jet_argv, "explain")}}
}

// `jet lint --a11y|--complexity <file>` (`"lint"`; `--cost` is not built):
// with no target the command's help is a usage error; exactly one category is
// required (E2102). The target resolves as `resolve_source_path` does (a
// directory is its project's stock entry; a file keeps its typed spelling, or
// gains `.jet`). Every category consumes checked Driver facts.
jet_cli_lint: fn(jet_argv: [String], args: [String], color: Bool, quiet: Bool, json: Bool) -[FS, Env]> JetCLIPlan Never! {
    if args.len() < 2 -> return jet_cli_missing_target("lint", quiet)
    a11y: jet_argv.contains("--a11y")
    complexity: jet_argv.contains("--complexity")
    cost: jet_argv.contains("--cost")
    categories := 0
    if a11y -> categories += 1
    if complexity -> categories += 1
    if cost -> categories += 1
    if categories != 1 {
        return jet_cli_fail("E2102", "usage: jet lint --a11y|--complexity <file.jet>", "`lint` needs exactly one category flag", "run `jet lint --a11y <file.jet>` or `jet lint --complexity <file.jet>`", color, JET_DRIVER_EXIT_USAGE)
    }
    if cost -> return jet_cli_not_ported("lint --cost", color)
    target: args[1]
    file := target
    notice := ""
    if cli_files.is_dir(target) {
        if jet_cli_resolve_source_path("lint", target, color, [String]{}) == {
            .File(path, _, written) -> {
                file = path
                notice = written
            }
            .Refused(plan) -> return plan
        }
    } else {
        if !cli_files.is_file(target) && cli_files.is_file("{target}.jet") -> file = "{target}.jet"
    }
    source: cli_files.read(file) ?? return jet_cli_report_done(notice, "E2105", "can't find the file `{file}`", jet_cli_why("E2105"), "check the spelling, or run jet from the folder that contains it", color, JET_DRIVER_EXIT_USER_ERROR)
    JetCLIPlan.Lint{file: file, source: source, color: color, notice: notice, category: if complexity -> "complexity" else -> "a11y", raw: jet_argv, json: json}
}

// A command run with no target: its help on stderr (unless `quiet`) as a
// usage error, and an E2104 report for `--json`.
jet_cli_missing_target: fn(command: String, quiet: Bool) -> JetCLIPlan Never! {
    JetCLIPlan.Done{output: jet_cli_plain_failure(if quiet -> "" else -> jet_cli_command_help(command), "E2104", "`jet {command}` needs a target", "run `jet help {command}` for its usage", JET_DRIVER_EXIT_USAGE)}
}

// The tiers `jet emit` prints, one mode flag each (`--ast`, `--ir`).
JET_CLI_EMIT_TIERS: [String]{"ast", "ir"}

// `jet emit --ast|--ir <file>`: with no target the command's help is a usage
// error; a target needs exactly one mode flag (E2102); the file is read as
// typed. `--fn NAME` selects one function's tree.
jet_cli_emit: fn(jet_argv: [String], args: [String], color: Bool, quiet: Bool, json: Bool) -[FS]> JetCLIPlan Never! {
    if args.len() < 2 -> return jet_cli_missing_target("emit", quiet)
    modes := [String]{}
    loop tier in JET_CLI_EMIT_TIERS {
        if jet_argv.contains("--{tier}") -> modes.push(tier)
    }
    if modes.len() == 0 {
        return jet_cli_fail("E2102", "usage: jet emit --ast|--ir <file.jet>", "`emit` needs a mode flag naming the tier it prints", "run `jet emit --ir <file.jet>`; `--ast` prints the parsed tier", color, JET_DRIVER_EXIT_USAGE)
    }
    if modes.len() > 1 {
        return jet_cli_fail("E2102", "`jet emit` prints one tier, but both `--{modes[0]}` and `--{modes[1]}` were given", "`emit` writes a single tier so its output has one meaning", "keep one of the mode flags", color, JET_DRIVER_EXIT_USAGE)
    }
    tier: modes[0]
    function := String?{None}
    asked := false
    loop argument in jet_argv {
        if argument == "--fn" || argument.starts_with("--fn=") -> asked = true
    }
    if asked {
        name: jet_cli_option_value(jet_argv, "--fn") ?? ""
        if name == "" || name.starts_with("-") {
            return jet_cli_fail("E2104", "`--fn` needs a function name", jet_cli_why("E2104"), "write `jet emit --{tier} <file.jet> --fn <name>`", color, JET_DRIVER_EXIT_USAGE)
        }
        function = Val(name)
    }
    file: args[1]
    source: cli_files.read(file) ?? return jet_cli_fail("E2105", "can't find the file `{file}`", jet_cli_why("E2105"), "check the spelling, or run jet from the folder that contains it", color, JET_DRIVER_EXIT_USER_ERROR)
    JetCLIPlan.Emit{file: file, source: source, color: color, json: json, tier: tier, function: function}
}

// `jet eval <file.jet | expression>` (`"eval"`): a file, a project directory,
// or a bare stem (`looks_like_jet_source`) is the file form and resolves as
// `resolve_source_path` does; a `:meta` word is REPL vocabulary. Code typed
// after `eval` runs as a `run` of its entry file (jet_cli_plan,
// jet_cli_eval_code_at), so only `--json` and `--pure` reach the expression
// form here (REPL `eval_once`).
jet_cli_eval: fn(raw: [String], args: [String], color: Bool, json: Bool) -[FS, Env]> JetCLIPlan Never! {
    if args.len() < 2 {
        return jet_cli_fail("E2104", "`jet eval` needs a file or an expression: jet eval <file.jet | expression>", jet_cli_why("E2104"), "correct the named argument or input, then run the command again", color, JET_DRIVER_EXIT_USAGE)
    }
    argument: args[1]
    if !jet_cli_looks_like_source(argument) {
        if argument.starts_with(":") {
            return jet_cli_fail("E2104", "`{argument}` is a jet command, not an expression", jet_cli_why("E2104"), "run `jet repl` for an interactive session, or pass an expression such as `1 + 2`", color, JET_DRIVER_EXIT_USAGE)
        }
        return JetCLIPlan.EvalExpression{source: argument, color: color, json: json}
    }
    file := argument
    notice := ""
    if cli_files.is_dir(argument) {
        if jet_cli_resolve_source_path("eval", argument, color, [String]{}) == {
            .File(path, _, written) -> {
                file = path
                notice = written
            }
            .Refused(plan) -> return plan
        }
    } else {
        if !cli_files.is_file(argument) && cli_files.is_file("{argument}.jet") -> file = "{argument}.jet"
    }
    JetCLIPlan.Eval{file: file, pure: raw.contains("--pure"), color: color, json: json, notice: notice}
}

// `jet new` templates.
JET_CLI_NEW_TEMPLATES: [String]{"cli", "ui", "web", "overrides"}

// `jet new <name> [--template <t>] [--annotated]` (`"new"`): a bare `jet new`
// is a usage error that prints the command's help; the
// backend scaffolds (`new service|route|job|migration`) are not ported yet.
jet_cli_new: fn(jet_argv: [String], args: [String], color: Bool, quiet: Bool, json: Bool) -[FS]> JetCLIPlan Never! {
    if args.len() < 2 -> return jet_cli_missing_target("new", quiet)
    name: args[1]
    if name == "service" || name == "route" || name == "job" || name == "migration" -> return jet_cli_not_ported("new {name}", color)
    template := ""
    asks_template := false
    loop argument in jet_argv {
        if argument == "--template" || argument.starts_with("--template=") -> asks_template = true
    }
    if asks_template {
        template = jet_cli_option_value(jet_argv, "--template") ?? ""
        if !JET_CLI_NEW_TEMPLATES.contains(template) {
            return jet_cli_fail("E2104", "`{template}` is not a `jet new` template", jet_cli_why("E2104"), "choose one of {JET_CLI_NEW_TEMPLATES.join(", ")}: `jet new {name} --template ui`", color, JET_DRIVER_EXIT_USAGE)
        }
    }
    if name.len() == 0 || name.contains("/") || name.contains("\\") {
        return jet_cli_fail("E2104", "project name must be a simple folder name", jet_cli_why("E2104"), "try: jet new my_app", color, JET_DRIVER_EXIT_USER_ERROR)
    }
    if cli_files.exists(name) {
        return jet_cli_fail("E2104", "`{name}` already exists", jet_cli_why("E2104"), "correct the named argument or input, then run the command again", color, JET_DRIVER_EXIT_USER_ERROR)
    }
    JetCLIPlan.New{name: name, template: template, annotated: jet_argv.contains("--annotated"), quiet: quiet, json: json, color: color}
}

// `jet fmt` (`"fmt"`): `--lang` selects the environment formatter (`argv` is
// the whole command line from `fmt`, `--` included); otherwise native `.jet`
// formatting. Every word after `--` is a path, never a flag.
jet_cli_fmt: fn(argv: [String], jet_argv: [String], args: [String], passthrough: [String]?, color: Bool, quiet: Bool) -> JetCLIPlan Never! {
    loop argument in jet_argv {
        if argument == "--lang" || argument.starts_with("--lang=") -> return JetCLIPlan.FmtLang{argv: argv, color: color}
    }
    // `--diff` and `--dry-run` preview, as `--check` does: none of the three
    // writes a file (`jet fmt --lang` reads them the same way).
    preview: jet_argv.contains("--check") || jet_argv.contains("--diff") || jet_argv.contains("--dry-run")
    stdin_path := String?{None}
    loop argument in jet_argv {
        if argument.starts_with("--stdin-path=") {
            stdin_path = Val(argument.slice(13..<argument.len()))
            break
        }
    }
    paths := [String]{}
    stdin_mode := false
    loop index in 1..<args.len() {
        if args[index] == "-" {
            stdin_mode = true
        } else {
            paths.push(args[index])
        }
    }
    after_separator: passthrough ?? [String]{}
    loop path in after_separator -> paths.push(path.copy())
    JetCLIPlan.Fmt{request: JetCLIFmtRequest{
        paths: paths,
        stdin_mode: stdin_mode,
        stdin_path: stdin_path,
        check: preview,
        diff: jet_argv.contains("--diff") || jet_argv.contains("--dry-run"),
        changed: jet_argv.contains("--changed"),
        explicit_copies: jet_argv.contains("--explicit-copies"),
        simplify: jet_argv.contains("--simplify"),
        color: color,
        quiet: quiet,
        json: jet_argv.contains("--json"),
    }}
}

// Where the jet-owned argv prefix ends: after the file of the `jet <file>`
// shorthand, else at the first standalone `--`.
jet_cli_owned_end: fn(raw: [String]) -[FS]> Int Never! {
    if jet_cli_shorthand_file(raw) == .Val(file) -> return file + 1
    loop (index, argument) in raw {
        if argument == "--" -> return index
    }
    raw.len()
}

// The jet-owned argv prefix (`jet_cli_owned_end`).
jet_cli_owned_flags: fn(raw: [String]) -[FS]> [String] Never! {
    jet_cli_prefix(raw, jet_cli_owned_end(raw))
}

// `OutputMode::json`: `--json` before `--`, or the `compiler` inspect plane,
// which is machine output by construction.
jet_cli_wants_json: fn(owned: [String]) -> Bool Never! {
    json := owned.contains("--json") || (owned.len() > 0 && owned[0] == "compiler")
    loop index in 1..<owned.len() {
        if owned[index - 1] == "inspect" && owned[index] == "compiler" -> json = true
    }
    json
}

// Whether the command line `raw` asks for machine output: `--json` typed
// (jet_cli_wants_json), or remembered by the settings files for its command
// (CommandLayers.jet), which jet_cli_plan adds after the typed words. A
// refusal and a failed verb answer in this output, so a `json` setting has
// the effect of the typed flag. `jet -e CODE` runs as the `jet <file>`
// shorthand does, under `run`'s settings.
jet_cli_settled_json: fn(raw: [String]) -[FS, Env]> Bool Never! {
    owned: jet_cli_owned_flags(raw)
    if jet_cli_wants_json(owned) -> return true
    found: if jet_cli_eval_flag_at(raw) != None -> String?{Val("run")} else -> jet_cli_settings_word(owned)
    word: found ?? return false
    if jet_cli_command_flag_words(word, owned, false) == .Words(words) -> return words.contains("--json")
    false
}

// Plan one `jet` invocation; `raw` is argv without the program name. Under
// `--json`, typed or set (jet_cli_settled_json), a refusal is the `cli`
// status envelope on stdout.
jet_cli_front: fn(raw: [String]) -[FS, Env, Time, Exec, IO, FFI.C, FFI.Asm, Net]> JetCLIPlan Never! {
    plan: jet_cli_plan(raw)
    if plan == {
        .Refused(report, _, exit_code, notice) -> {
            if jet_cli_settled_json(raw) -> return jet_cli_done(jet_cli_report_status_json(report), notice, exit_code)
        }
        .Diagnostics(file, source, report, color, notice) -> return JetCLIPlan.Done{output: jet_cli_diagnostics_output(file, source, report, color, jet_cli_settled_json(raw), notice)}
        .Done(_) | .Check(_, _, _, _, _, _, _, _, _, _, _, _, _) | .CheckWorkspace(_, _, _, _, _, _, _, _, _, _) | .CheckPrelude(_, _, _, _, _, _) | .CheckCore(_, _, _, _, _) | .Build(_, _, _, _, _, _, _, _, _, _, _) | .LockedBuild(_, _) | .BuildPackage(_, _, _, _, _, _, _, _) | .Run(_, _, _, _, _, _, _, _, _, _, _, _) | .RunRemote(_, _, _, _, _, _, _, _) | .NativeSource(_, _, _, _, _) | .DevWeb(_, _, _, _, _, _, _, _) | .DevCanvas(_, _, _, _, _, _) | .Jobs(_, _, _, _) | .Test(_, _, _, _, _, _) | .TestWorkspace(_, _, _, _, _, _, _, _) | .TestProfile(_, _, _, _, _, _) | .New(_, _, _, _, _, _) | .Doc(_, _, _, _, _) | .Emit(_, _, _, _, _, _) | .Eval(_, _, _, _, _) | .Fill(_, _, _) | .Structural(_, _, _) | .Review(_, _, _) | .Keygen(_, _, _) | .KeyBackup(_, _, _) | .Publish(_, _, _, _) | .Yank(_, _, _) | .Lint(_, _, _, _, _, _, _) | .Fmt(_) | .FmtLang(_, _) | .Fix(_, _, _, _, _, _, _, _, _) | .Inspect(_) | .InspectB(_) | .ForeignBind(_, _, _) | .Perf(_, _) | .Semindex(_, _, _) | .Find(_, _, _, _) | .Cache(_, _) | .Remote(_, _, _) | .Comparison(_, _, _) | .Try(_, _, _) | .Maintenance(_, _, _, _) | .Completion(_, _, _) | .Schema(_, _, _, _, _) | .Codemod(_, _, _, _, _) | .PolicyExplain(_, _, _, _, _, _) | .DiagnosticTypeExplain(_, _, _, _) | .BuildFactExplain(_, _, _, _, _, _, _) | .Gates(_, _, _, _, _) | .Output(_, _, _, _) | .Doctor(_, _, _, _) | .UpdateJet(_, _, _, _, _) | .AuditCopies(_, _, _, _, _) | .AuditForeign(_, _, _, _, _) | .CompilerService(_) | .Repl(_, _, _, _) | .LSP | .ReplChild(_) | .EvalExpression(_, _, _) | .Prove(_, _, _, _, _, _) | .Budget(_, _, _, _) | .AuditWrites(_, _, _, _, _) -> {}
    }
    plan
}

// Under `--json` a failed verb that carries typed reports answers with them
// in the `cli` status envelope on stdout and keeps only its notice on stderr,
// as a refused plan does (jet_cli_front); a verb that already wrote its own
// status envelope keeps it.
jet_cli_json_outcome: fn(json: Bool, output: &&JetDriverVerbOutput) -> JetDriverVerbOutput Never! {
    outcome := output.move()
    if !json -> return outcome
    schema: "\"schema\":\"{JET_CLI_STATUS_SCHEMA}\""
    if outcome.stdout.contains(schema) || outcome.stderr.contains(schema) -> return outcome
    if outcome.failure == .Val(failure) {
        reports := [String]{}
        loop report in failure.reports -> reports.push(jet_cli_report_json(report, None, "", "", 0))
        return JetDriverVerbOutput{stdout: "{jet_cli_status_render_with_reports("cli", false, reports, [JetCLIStatusField]{})}\n", stderr: failure.notice, exit_code: outcome.exit_code}
    }
    outcome
}

// Bare `jet`: the interactive picker (Picker.jet) on a terminal, else the
// static palette, which `--json` always gets.
jet_cli_bare: fn(color: Bool, json: Bool) -[FS, Env, IO, Time.Wait]> JetCLIPlan Never! {
    if !json && jet_cli_picker(color) == .Val(plan) -> return plan
    jet_cli_renderable(jet_cli_palette(pkg_version_line(pkg_jet_build())), json)
}

jet_cli_plan: fn(raw: [String]) -[FS, Env, Time, Exec, IO, FFI.C, FFI.Asm, Net]> JetCLIPlan Never! {
    // The compiler verbs own every raw argument, before Jet's output/flag
    // parsing; the `jet-cc`/`jet-cxx`/`jet-c++` aliases arrive here as these
    // verbs (Host.jet `jet_cli_alias_args`).
    if raw.len() > 0 && (raw[0] == "cc" || raw[0] == "c++") -> return jet_cli_foreign_compile_plan(raw)
    // The internal compiler service owns its raw arguments, as the engine
    // aliases do: `jet __jetpack <op>`, nothing else.
    if raw.len() > 0 && raw[0] == JET_COMPILER_SERVICE_VERB {
        if raw.len() != 2 -> return jet_cli_report_done("", "E2104", "`jet {JET_COMPILER_SERVICE_VERB}` takes exactly one operation", jet_cli_why("E2104"), "`jet {JET_COMPILER_SERVICE_VERB}` is spoken by `jetpack`; run the jetpack command instead", false, JET_DRIVER_EXIT_USAGE)
        return JetCLIPlan.CompilerService{op: raw[1]}
    }
    // A REPL turn's child (Repl.jet), started only by `jet repl`.
    if raw.len() > 0 && raw[0] == JET_CLI_REPL_CHILD_VERB -> return jet_cli_repl_child_plan(raw)
    // Output flags, parsed once from the jet-owned prefix before `--`.
    owned: jet_cli_owned_flags(raw)
    color := false
    loop argument in owned {
        if argument == "--color" -> color = true
        if argument == "--no-color" -> color = false
        if argument.starts_with("--color=") {
            value: argument.slice(8..<argument.len())
            if value == {
                "always" -> color = true
                "auto" | "never" -> color = false
                else -> return jet_cli_report_done("", "E2104", "invalid color request {jet_cli_debug_quote(value)}; expected auto, always, or never", jet_cli_why("E2104"), "Write `--color=auto`, `--color=always`, or `--color=never`", false, JET_DRIVER_EXIT_USAGE)
            }
        }
    }
    quiet := owned.contains("--quiet")
    verbose := owned.contains("--verbose") || owned.contains("-v")
    json := jet_cli_wants_json(owned)
    if raw.len() == 0 -> return jet_cli_bare(color, json)

    // Moved and grouped spellings. copy: `raw` stays with the caller (`raw` is a read parameter:
    // no move out of it, E0201) and the binding `argv` owns its own.
    argv := raw.copy()
    // `jet eval CODE [args...]` is `jet run <file> [args...]` of the file that
    // holds CODE as the body of `run: fn`, as `jet -e CODE` is; the flags
    // between `eval` and CODE are the run's.
    if jet_cli_eval_code_at(argv) == .Val(found) {
        file: jet_cli_eval_file(argv[found.code]) ?? return jet_cli_fail("E2105", "couldn't write the file `jet eval` runs", jet_cli_why("E2105"), "set `XDG_CACHE_HOME` or `HOME` to a writable directory", color, JET_DRIVER_EXIT_USER_ERROR)
        rewritten := jet_cli_prefix(argv, found.code)
        rewritten[found.verb] = "run"
        rewritten.push(file)
        loop word in jet_cli_tail(argv, found.code + 1) -> rewritten.push(word)
        argv = rewritten
    }
    // `jet -e CODE [args...]` is `jet <file> [args...]` of the file that
    // holds CODE as the body of `run: fn` (ScriptCache.jet jet_cli_eval_file).
    if jet_cli_eval_flag_at(argv) == .Val(at) {
        if at + 1 >= argv.len() -> return jet_cli_fail("E2104", "`-e` needs the code to run", jet_cli_why("E2104"), "write the statements after it: `jet -e 'print(1 + 2)'`", color, JET_DRIVER_EXIT_USAGE)
        file: jet_cli_eval_file(argv[at + 1]) ?? return jet_cli_fail("E2105", "couldn't write the file `-e` runs", jet_cli_why("E2105"), "set `XDG_CACHE_HOME` or `HOME` to a writable directory", color, JET_DRIVER_EXIT_USER_ERROR)
        rewritten := jet_cli_prefix(argv, at)
        rewritten.push(file)
        loop word in jet_cli_tail(argv, at + 2) -> rewritten.push(word)
        argv = rewritten
    }
    // `jet run - [args...]` runs the program read from standard input, kept
    // as the `stdin` entry file of its source (ScriptCache.jet jet_cli_entry_file).
    if jet_cli_stdin_source_at(argv) == .Val(at) {
        source: cli_term.read_all_input() ?? return jet_cli_fail("E2105", "couldn't read the program `jet run -` runs from standard input", jet_cli_why("E2105"), "pipe the source in: `jet run - < hello.jet`", color, JET_DRIVER_EXIT_USER_ERROR)
        file: jet_cli_entry_file("stdin", source) ?? return jet_cli_fail("E2105", "couldn't write the file `jet run -` runs", jet_cli_why("E2105"), "set `XDG_CACHE_HOME` or `HOME` to a writable directory", color, JET_DRIVER_EXIT_USER_ERROR)
        argv[at] = file
    }
    if jet_cli_moved_command(argv[0]) == .Val(moved) {
        group: JET_CLI_COMMANDS[moved.group].name
        return jet_cli_fail(
            "E2101",
            "`{argv[0]}` moved under `jet {group}`.",
            "infrequent commands live in a named area so daily Jet commands stay easy to scan.",
            "run `jet {group} {argv.join(" ")}`.",
            color,
            JET_DRIVER_EXIT_USAGE,
        )
    }
    // copy: `argv[0]` stays in its list (owner: `argv`; no move out of an element, E0225) and the
    // binding `group` owns its own.
    group: argv[0].copy()
    exhaustive := false
    if jet_cli_group_index(group) == .Val(index) {
        exhaustive = JET_CLI_COMMANDS[index].exhaustive
        second_asks: argv.len() > 1 && (argv[1] == "help" || jet_cli_is_help_flag(argv[1]))
        asks_help: if group == "env" -> second_asks else -> argv.len() == 1 || second_asks
        if (exhaustive || group == "env") && asks_help {
            if !jet_cli_form_ported(group) -> return jet_cli_not_ported(group, color)
            return jet_cli_renderable(jet_cli_group_help(group), json)
        }
    }
    if argv.len() > 1 {
        // copy: `argv[1]` stays in its list (owner: `argv`; no move out of an element, E0225) and
        // the binding `sub` owns its own.
        sub: argv[1].copy()
        nested: jet_cli_nested_command(group, sub)
        if exhaustive && nested == None {
            return jet_cli_fail("E2101", "`{sub}` isn't a jet {group} command.", "jet {group} accepts only commands in its named area.", "run `jet {group} help`.", color, JET_DRIVER_EXIT_USAGE)
        }
        if nested == .Val(found) {
            key: JET_CLI_COMMANDS[found.group].actions[found.action].handler
            if jet_cli_handler_index(key) == .Val(handler) {
                spec: JET_CLI_HANDLERS[handler]
                if !spec.keeps_group {
                    rewritten := [String]{spec.dispatch_word}
                    loop word in jet_cli_tail(argv, 2) -> rewritten.push(word)
                    argv = rewritten
                }
            }
        }
    }
    // `jet perf` lists its family; a built action runs (Perf/Command.jet).
    if argv[0] == "perf" {
        if argv.len() > 1 && jet_cli_nested_command("perf", argv[1]) != None && jet_cli_form_ported("perf {argv[1]}") -> return JetCLIPlan.Perf{argv: argv, color: color}
        form: if argv.len() > 1 && jet_cli_form_card("perf {argv[1]}") != None -> "perf {argv[1]}" else -> "perf"
        return jet_cli_not_ported(form, color)
    }

    // The program's words: everything after the first standalone `--`, or
    // every word after the file of the `jet <file>` shorthand (a `--` right
    // after that file still only separates).
    separator := jet_cli_owned_end(argv)
    jet_argv := jet_cli_prefix(argv, separator)
    passthrough := [String]?{None}
    if separator < argv.len() -> passthrough = Val(jet_cli_tail(argv, if argv[separator] == "--" -> separator + 1 else -> separator))
    loop (index, argument) in jet_argv {
        if argument != "--version" -> next
        builtin_before := false
        loop earlier in 0..<index {
            if jet_cli_is_builtin(jet_argv[earlier]) -> builtin_before = true
        }
        if !builtin_before -> return jet_cli_version(json)
        break
    }
    args: jet_cli_positionals(jet_argv)
    if args.len() > 0 && args[0] == "lsp" -> return JetCLIPlan.LSP
    if args.len() == 0 {
        if jet_cli_any_help_flag(jet_argv) {
            order: jet_cli_help_order(jet_argv)
            if !jet_cli_is_help_order(order) -> return jet_cli_bad_help_order(order, color)
            return jet_cli_renderable(jet_cli_usage_page(order, pkg_jet_build().version), json)
        }
        return jet_cli_bare(color, json)
    }
    command: args[0]
    if !jet_cli_is_builtin(command) && !command.ends_with(".jet") {
        if jet_cli_project_job(argv, command, color, quiet, verbose) == .Val(plan) -> return plan
    }
    // `-O0`, `-O1` and `-O2` are `--optimize=none|basic|full` from here on, on
    // every command but one that validates its own flags and takes no
    // `--optimize` (a job's or the program's words came before or stay past
    // the separator).
    if jet_cli_takes_level_words(command) {
        argv = jet_cli_level_words(argv, separator)
        jet_argv = jet_cli_prefix(argv, separator)
    }
    // The flags the settings files remember for this command
    // (CommandLayers.jet), after the words typed, or before the file of the
    // `jet <file>` shorthand, whose later words are the program's. A compiler
    // control's setting is left to its reader, which ranks it below the
    // environment variable (Controls.jet). A remembered output flag sets the
    // output as its typed word does; a typed flag's setting adds no word.
    if jet_cli_settings_word(jet_argv) == .Val(word) {
        if jet_cli_command_flag_words(word, jet_argv, false) == {
            .Refused(reports) -> return JetCLIPlan.Done{output: jet_cli_command_settings_output(reports, color)}
            .Words(words) -> if words.len() > 0 {
                at: jet_cli_shorthand_file(argv) ?? separator
                remembered := jet_cli_prefix(argv, at)
                loop item in words {
                    if item == "--quiet" -> quiet = true
                    if item == "--verbose" -> verbose = true
                    if item == "--json" -> json = true
                    if item == "--color" || item == "--color=always" -> color = true
                    if item == "--color=auto" || item == "--color=never" -> color = false
                    if item.starts_with("--color=") && item != "--color=auto" && item != "--color=always" && item != "--color=never" {
                        return jet_cli_report_done("", "E2104", "invalid color request {jet_cli_debug_quote(item.slice(8..<item.len()))}; expected auto, always, or never", jet_cli_why("E2104"), "Set the `color` setting to \"auto\", \"always\", or \"never\"", false, JET_DRIVER_EXIT_USAGE)
                    }
                    remembered.push(item.copy()) // copy: the settings keep their words.
                }
                loop item in jet_cli_tail(argv, at) -> remembered.push(item)
                argv = remembered
                separator = separator + words.len()
                jet_argv = jet_cli_prefix(argv, separator)
            }
        }
    }

    // `--lib` and `--output` belong to the commands that produce those artifacts.
    library: jet_argv.contains("--lib")
    if library && command != "build" {
        return jet_cli_fail("E2104", "`--lib` is only valid with `jet build`", jet_cli_why("E2104"), "run `jet build --lib <file.jet>` to emit the native Library artifacts", color, JET_DRIVER_EXIT_USAGE)
    }
    output_name := String?{None}
    loop (index, argument) in jet_argv {
        if argument.starts_with("--output=") {
            output_name = Val(argument.slice(9..<argument.len()))
            break
        }
        if argument == "--output" {
            value := ""
            if index + 1 < jet_argv.len() && !jet_argv[index + 1].starts_with("-") -> value = jet_argv[index + 1]
            output_name = Val(value)
            break
        }
    }
    if output_name == .Val(output) {
        // A named output for `jet build` or a plain `jet dev` is a form of
        // the command model that is not built yet.
        if command == "build" && !library -> return jet_cli_not_ported("build --output", color)
        if command == "dev" && !jet_argv.contains("--canvas") -> return jet_cli_not_ported("dev --output", color)
        allowed: command == "run" || command == "dev" || command == "build" || command == "package"
        if !allowed || output == "" {
            return jet_cli_fail("E2104", "`--output` needs a runnable Output address or `jet build --lib`", jet_cli_why("E2104"), "write `jet run --output <address> <file.jet>`, or `jet build --lib --output <name> <file.jet>`", color, JET_DRIVER_EXIT_USAGE)
        }
    }

    if !jet_cli_is_builtin(command) {
        if jet_cli_looks_like_source(command) {
            // `jet <file>` is `jet run <file>`: the words before the file are
            // jet's and are checked as `jet run` checks them; a help flag
            // among them is ignored, as the run goes ahead.
            if jet_cli_pinned_toolchain(raw, Val(command), color, quiet || json) == .Val(plan) -> return plan
            threads := Int?{None}
            if !jet_cli_any_help_flag(jet_argv) {
                if jet_cli_threads(jet_argv, "run", color) == {
                    .Refused(refusal) -> return refusal
                    .Cap(cap) -> threads = cap
                }
            }
            if jet_cli_check_flags(jet_argv, "run", color) == .Val(refusal) -> return refusal
            run_args := [String]{"run"}
            loop word in args -> run_args.push(word)
            return jet_cli_run(jet_argv, run_args, passthrough, true, false, color, quiet, verbose, threads)
        }
        if jet_cli_find_external(command) == .Val(bin) {
            forwarded := [String]{}
            named := false
            loop word in raw {
                if named {
                    forwarded.push(word.copy())
                } else if word == command {
                    named = true
                }
            }
            return JetCLIPlan.Done{output: jet_cli_external_run(bin, forwarded)}
        }
        fix: if jet_cli_closest_command(command) == .Val(close) -> "did you mean `jet {close}`? Run `jet help` to see them all." else -> "run `jet help` to see every command."
        return jet_cli_fail("E2101", "`{command}` isn't a jet command.", "every jet run starts with a command like `run`, `check`, or `new`.", fix, color, JET_DRIVER_EXIT_USAGE)
    }

    owns_flags: JET_CLI_OWNS_FLAGS.contains(command)
    bespoke_help: command == "bind" || command == "diff" || command == "merge" || command == "perf"
    if jet_cli_any_help_flag(jet_argv) && !(owns_flags && bespoke_help) {
        if !jet_cli_form_ported(command) -> return jet_cli_not_ported(command, color)
        return jet_cli_renderable(jet_cli_command_help(command), json)
    }
    threads := Int?{None}
    if jet_cli_threads(jet_argv, command, color) == {
        .Refused(refusal) -> return refusal
        .Cap(cap) -> threads = cap
    }
    if !owns_flags {
        if jet_cli_check_flags(jet_argv, command, color) == .Val(refusal) -> return refusal
    }
    if command != "dev" && jet_argv.contains("--canvas") {
        return jet_cli_fail("E2102", "`--canvas` is only valid with `jet dev`", jet_cli_why("E2102"), "run `jet dev <file.jet> --canvas` to open the Canvas IDE", color, JET_DRIVER_EXIT_USAGE)
    }
    if JET_CLI_PINNED_VERBS.contains(command) {
        target := String?{None}
        if args.len() > 1 && jet_cli_looks_like_source(args[1]) -> target = Val(args[1])
        if jet_cli_pinned_toolchain(raw, target, color, quiet || json) == .Val(plan) -> return plan
    }

    // `jet env vars` reads the controls here; the other env actions go to
    // the engine.
    if command == "env" && args.len() > 1 && args[1] == "vars" -> return jet_cli_env_vars(jet_argv, passthrough, color, json)
    if jet_cli_engine_commands(command, argv) == .Val(plan) -> return plan
    if command == {
        "help" -> {
            bespoke: if args.len() > 1 -> jet_cli_structural_help(args[1]) else -> String?{None}
            return jet_cli_help(jet_argv, args, bespoke, color, json, pkg_jet_build().version)
        }
        "version" -> return jet_cli_version(json)
        "man" -> return jet_cli_renderable(jet_cli_man_page(), json)
        "completions" -> {
            tail: jet_cli_tail(argv, 1)
            if jet_cli_completions_builtin(tail) == .Val(builtin) -> return builtin
            // Only the valid `<shell> --for <program>` shape reaches here.
            program: tail[2]
            name: jet_cli_program_completion_name(program) ?? return jet_cli_program_completion_error(program, "the program path has no usable command name")
            if jet_cli_program_completion_name_control(name) -> return jet_cli_program_completion_error(program, "the program command name contains a control character")
            return JetCLIPlan.Completion{shell: tail[0], program: program, name: name}
        }
        // `"devtools"`: the tools own the raw argv after their word.
        "devtools" -> {
            tool: if argv.len() > 1 -> argv[1] else -> ""
            if tool == {
                "grammars" -> return jet_cli_devtools_grammars(quiet, color)
                "new-example" -> return jet_cli_devtools_new_example(jet_cli_tail(argv, 2), color)
                "new-ui" | "reduce" | "ice-report" | "core-record" -> return JetCLIPlan.Maintenance{action: tool, args: jet_cli_tail(argv, 2), color: color, json: json}
                // Rust ignores extra words after `check-fixture-paths`.
                "check-fixture-paths" -> return JetCLIPlan.Maintenance{action: tool, args: [String]{}, color: color, json: json}
                // Bare `jet self devtools` names its tools.
                "" -> return jet_cli_done("", jet_cli_command_help("devtools"), JET_DRIVER_EXIT_USAGE)
                else -> {}
            }
        }
        "explain" -> return jet_cli_explain(jet_argv, args, color, json, threads)
        "crash" -> return jet_cli_crash(args, color)
        "debug" -> return jet_cli_debug(jet_argv, args, color)
        "check" -> {
            if jet_argv.contains("--prelude") -> return jet_cli_check_prelude(args, color, quiet, threads, json)
            return jet_cli_check_settled(jet_argv, args, color, quiet, threads, json)
        }
        "build" -> {
            if jet_argv.contains("--locked") -> return jet_cli_locked_build(raw, jet_argv, args, passthrough, color, quiet, threads, json)
            return jet_cli_build(jet_argv, args, passthrough, color, quiet, threads, json)
        }
        "run" -> return jet_cli_run(jet_argv, args, passthrough, false, false, color, quiet, verbose, threads)
        "jobs" -> return jet_cli_jobs(jet_argv, args, color, quiet, threads, json)
        // `jet dev`: the program rebuilt and rerun on every source change, from
        // the `dev: fn` its command home declares, else the stock `jet run` entry.
        // `--canvas`, `--app` and `--share` are their own dev hosts, not this loop.
        // A bare `jet dev` in a role-file project runs inside its environment.
        "dev" -> {
            if jet_argv.contains("--canvas") -> return jet_cli_dev_canvas_plan(jet_argv, args, color, quiet, threads)
            if jet_cli_dev_canvas_flag_alone(jet_argv, color) == .Val(refusal) -> return refusal
            if jet_cli_has(jet_argv, "--app") -> return jet_cli_not_ported("dev --app", color)
            if jet_cli_has(jet_argv, "--share") -> return jet_cli_not_ported("dev --share", color)
            if jet_cli_dev_environment_plan(cli_files.cwd() ?? ".", raw) == .Val(plan) -> return plan
            return jet_cli_run(jet_argv, args, passthrough, false, true, color, quiet, verbose, threads)
        }
        "test" -> return jet_cli_test(jet_argv, color, quiet, verbose, threads)
        "prove" -> return jet_cli_prove(jet_cli_tail(jet_cli_command_first(argv, command), 1), color, json)
        "budget" -> return jet_cli_budget_plan(jet_cli_command_first(argv, command), color)
        "new" -> return jet_cli_new(jet_argv, args, color, quiet, json)
        "doc" -> return jet_cli_doc(jet_argv, args, color, quiet, json, jet_argv.contains("--check"))
        "emit" -> return jet_cli_emit(jet_argv, args, color, quiet, json)
        "eval" -> return jet_cli_eval(argv, args, color, json)
        "repl" -> return jet_cli_repl_plan(jet_argv, args, color)
        "fill" -> {
            if args.len() < 2 -> return jet_cli_missing_target("fill", quiet)
            return JetCLIPlan.Fill{target: args[1], json: json, color: color}
        }
        "diff" | "merge" -> {
            start := 0
            loop (index, word) in argv {
                if word == command {
                    start = index
                    break
                }
            }
            return JetCLIPlan.Structural{argv: jet_cli_tail(argv, start), command: command, json: json}
        }
        "review" -> return JetCLIPlan.Review{argv: jet_cli_command_first(argv, command), json: json, color: color}
        "keygen" -> return jet_cli_keygen_plan(jet_argv, color)
        "key" -> return jet_cli_key_plan(jet_argv, color, json)
        "publish" -> return jet_cli_publish_plan(jet_argv, color, quiet)
        "yank" -> return jet_cli_yank_plan(jet_argv, color)
        "lint" -> return jet_cli_lint(jet_argv, args, color, quiet, json)
        "fmt" -> return jet_cli_fmt(argv, jet_argv, args, passthrough, color, quiet)
        "find" -> return jet_cli_find(jet_cli_tail(argv, 1), color, json)
        "parts" -> return jet_cli_project_parts(jet_cli_tail(argv, 1), color, json)
        // Dispatch arms over the raw argv (`raw[1..]` etc.).
        "status" -> return jet_cli_status(jet_cli_tail(argv, 1), color, json)
        "fix" -> {
            if args.len() > 1 && args[1] == "memory" -> return jet_cli_fix_memory_at(jet_cli_selected_root_or_cwd(), jet_cli_tail(argv, 2), color, json)
            if args.len() < 2 -> return jet_cli_done("", if quiet || json -> "" else -> jet_cli_command_help("fix"), JET_DRIVER_EXIT_USAGE)
            markers: jet_cli_option_value(jet_argv, "--markers") ?? ""
            edition: jet_cli_option_value(jet_argv, "--edition") ?? ""
            asked_markers := false
            asked_edition := false
            loop word in jet_argv {
                if word == "--markers" || word.starts_with("--markers=") -> asked_markers = true
                if word == "--edition" || word.starts_with("--edition=") -> asked_edition = true
            }
            if asked_markers && markers != "inside" && markers != "above" -> return jet_cli_fail("E2104", "`{markers}` is not a `jet fix --markers` placement", jet_cli_why("E2104"), "write `jet fix --markers inside <file>` or `jet fix --markers above <file>`", color, JET_DRIVER_EXIT_USAGE)
            style: jet_argv.contains("--style")
            if asked_markers && style -> return jet_cli_fail("E2104", "`jet fix` takes `--markers` or `--style`, not both", jet_cli_why("E2104"), "run `jet fix --markers {markers} <file>`, then `jet fix --style <file>`", color, JET_DRIVER_EXIT_USAGE)
            // `--edition` names the edition to migrate to. This jet migrates
            // to its own edition only (the ordinary fix pass); any other is
            // refused rather than run as a plain fix.
            if asked_edition && edition != JET_DRIVER_EDITION -> return jet_cli_fail("E2104", "`jet fix --edition={edition}` is not built: this jet migrates to edition {JET_DRIVER_EDITION} only", jet_cli_why("E2104"), "drop `--edition`, or write `jet fix --edition={JET_DRIVER_EDITION} <file>`", color, JET_DRIVER_EXIT_USAGE)
            target: args[1]
            file := target
            notice := ""
            if cli_files.is_dir(target) {
                if jet_cli_resolve_source_path("fix", target, color, [String]{}) == {
                    .File(path, _, written) -> {
                        file = path
                        notice = written
                    }
                    .Refused(plan) -> return plan
                }
            } else if !cli_files.is_file(target) && cli_files.is_file("{target}.jet") {
                file = "{target}.jet"
            }
            return JetCLIPlan.Fix{file: file, dry_run: jet_argv.contains("--dry-run"), all: jet_argv.contains("--all"), markers: markers, style: style, color: color, quiet: quiet, json: json, notice: notice}
        }
        "gc" -> return jet_cli_gc(argv, args, color, json)
        "cache" -> return JetCLIPlan.Cache{args: jet_cli_tail(argv, 1), json: json}
        "remote" -> return JetCLIPlan.Remote{argv: argv, json: json, color: color}
        // `jet self toolchain`: read-only pin report.
        "toolchain" -> return jet_cli_self_toolchain(json)
        "init" -> return jet_cli_init(args, color, quiet, json)
        // `jet update jet [<channel>]` moves the
        // toolchain pin; every other update refreshes dependencies through
        // the engine's package fetch.
        "update" -> {
            if args.len() > 1 && args[1] == "jet" {
                if jet_cli_require_inspect_root(cli_files.cwd() ?? ".", "error: `jet update jet` needs a project — no `package.jet` found here or above", color) == {
                    .Root(root) -> return JetCLIPlan.UpdateJet{root: root, channel: args.get(2), color: color, json: json, quiet: quiet}
                    .Refused(plan) -> return plan
                }
            }
            return jet_cli_package_engine(cli_files.cwd() ?? ".", jet_cli_command_words(jet_argv, command), color, json)
        }
        "add" | "remove" | "fetch" | "vendor" -> return jet_cli_package_engine(cli_files.cwd() ?? ".", jet_cli_command_words(jet_argv, command), color, json)
        "doctor" -> return jet_cli_doctor_plan(raw, jet_argv, color)
        // `run_test_compare(target, jet_argv, mode)`.
        "test-compare" -> return JetCLIPlan.Comparison{target: if args.len() > 1 -> args[1] else -> "", argv: jet_argv, json: json}
        "try" -> {
            if args.len() < 2 -> return jet_cli_done("", if quiet || json -> "" else -> jet_cli_command_help("try"), JET_DRIVER_EXIT_USAGE)
            return JetCLIPlan.Try{plan_path: args[1], keep: jet_argv.contains("--keep"), json: json}
        }
        // `"import"` -> CmdImport::run(&raw): raw with the command word first.
        "import" -> return JetCLIPlan.Done{output: jet_cli_import_run(jet_cli_command_first(argv, command), json)}
        else -> {}
    }
    if jet_cli_inspect_word(command) {
        plan: jet_cli_inspect(argv, jet_argv, args, color, quiet, json, threads)
        if plan == .Inspect(job) {
            selected := job
            selected.verbose = verbose
            return JetCLIPlan.Inspect{job: selected}
        }
        return plan
    }
    jet_cli_not_ported(jet_cli_dispatch_form(args), color)
}
