// The `jet` front door (Source/main.rs `main` up to verb dispatch): output
// flags, retired, moved, and grouped routes, help and the greeting, unknown
// commands (E2101) and flags (E2102), then the verbs the Jet driver owns
// (`explain <CODE>`, `check <file>`). Every report is the Rust host's exact
// bytes and exit status for the same argv. A command whose Jet port has not
// landed yet is refused with E2104 instead of guessing its behavior.
use core.files as cli_files
use jet_driver.[
    JetDriverVerbOutput,
    JET_DRIVER_EXIT_OK,
    JET_DRIVER_EXIT_USER_ERROR,
    JET_DRIVER_EXIT_USAGE,
]
use jet_foundation.[
    Diagnostic,
    diagnostic_from_registry,
    diagnostic_render_all,
    WatchPolicy,
    watch_policy_from,
]

pub enum JetCLIPlan {
    // The command finished: write these bytes and exit with this status.
    Done(output: JetDriverVerbOutput)
    // `jet check <file>`: the entry as the user typed it, its bytes, and the
    // output policy. The host compiles it and renders the outcome.
    Check(file: String, source: String, color: Bool, quiet: Bool)
    // `jet build <file>`: the entry and its bytes; `release` selects the
    // rustc/LLVM backend, otherwise the Jet-native backend builds it.
    Build(file: String, source: String, color: Bool, release: Bool)
    Inspect(file: String, color: Bool, semindex: Bool)
    Run(invocation: JetCLIExecutionInvocation)
    Dev(invocation: JetCLIExecutionInvocation)
    Completions(arguments: [String])
    Explain(request: JetCLIDevExplainRequest)
    Format(options: JetCLIFormatOptions, mode: JetCLIOutputMode)
    ExternalFormat(options: JetCLIExternalFormatOptions, mode: JetCLIOutputMode)
    Fix(options: JetCLIFixOptions, mode: JetCLIOutputMode)
    Status(arguments: [String], json: Bool)
    Test(arguments: [String], mode: JetCLIOutputMode, advisory_lints_visible: Bool)
    Try(file: String, keep: Bool, mode: JetCLIOutputMode)
    Budget(arguments: [String])
    PackageDesktop(arguments: [String], options: JetCLIBundleOptions, machine: Bool)
}

// Flags whose value is the next argv word (CLI.rs `flag_takes_separate_value`).
JET_CLI_SEPARATE_VALUE_FLAGS :: [String]{
    "-p", "--fixtures", "--env", "--preset", "--set", "--builder", "--output", "--profile",
    "--target", "--endpoint", "--channel", "--platform", "--trust-key", "--gate", "--allow",
    "--deny", "--scope", "--live", "--replay", "--project", "--console-ttl", "--app", "--share",
    "--token", "--base-receipt", "--receipt", "--head-receipt", "--after-receipt", "--canvas-host",
    "--canvas-port", "--canvas-transport", "--canvas-authority", "--where", "--capture",
    "--browser", "--browser-retries", "--browser-reporter", "--filter", "--shuffle", "--verify",
    "--template", "--sort",
}

// `--name=value` spellings that never become positional words.
JET_CLI_VALUE_PREFIXES :: [String]{
    "--verify=", "--output=", "--where=", "--capture=", "--endpoint=", "--channel=",
    "--platform=", "--trust-key=", "--set=", "--scope=", "--kind=", "--live=", "--replay=",
    "--target=", "--app=", "--share=", "--token=", "--canvas-host=", "--canvas-port=",
    "--canvas-transport=", "--canvas-authority=",
}

// Flags an external formatter accepts with `jet fmt --lang`.
JET_CLI_EXTERNAL_FMT_FLAGS :: [String]{
    "--trust", "--offline", "--online", "--no-color", "--json", "--flake", "--pure", "--yes",
    "--fixtures", "--preset", "--env",
}

// Source/main.rs `cli_diagnostic_copy`: the shared Why line of a CLI code.
fn jet_cli_why(code: String) -> String Never! {
    if code == {
        "E2101" -> return "Jet command groups accept only commands in their named area"
        "E2102" -> return "Jet ignores no flags silently, so a typo cannot quietly change a command"
        "E2104" -> return "Jet needs valid command input before it can run this command"
        "E2105" -> return "Jet could not complete the named file, tool, or operating-system operation"
        else -> {}
    }
    "Jet could not complete this command"
}

// One spanless CLI diagnostic, rendered as the host prints it.
pub fn jet_cli_report(code: String, what: String, why: String, fix: String, color: Bool) -> String Never! {
    diagnostic_render_all("", "", [Diagnostic]{diagnostic_from_registry(code, None, what, why, fix)}, color)
}

fn jet_cli_done(stdout: String, stderr: String, exit_code: Int) -> JetCLIPlan Never! {
    JetCLIPlan.Done{output: JetDriverVerbOutput{stdout: stdout, stderr: stderr, exit_code: exit_code}}
}

fn jet_cli_fail(code: String, what: String, why: String, fix: String, color: Bool, exit_code: Int) -> JetCLIPlan Never! {
    jet_cli_done("", jet_cli_report(code, what, why, fix, color), exit_code)
}

// A real `jet` command whose Jet port has not landed: refused, never guessed.
fn jet_cli_not_ported(command: String, color: Bool) -> JetCLIPlan Never! {
    jet_cli_fail(
        "E2104",
        "`jet {command}` is not part of the Jet-hosted CLI yet",
        jet_cli_why("E2104"),
        "run `jet {command}` with the Rust-hosted `jet` until the Jet CLI owns it",
        color,
        JET_DRIVER_EXIT_USAGE,
    )
}

fn jet_cli_prefix(items: [String], end: Int) -> [String] Never! {
    prefix := [String]{}
    loop index in 0..<end -> &prefix.push(items[index])
    prefix
}

fn jet_cli_tail(items: [String], start: Int) -> [String] Never! {
    tail := [String]{}
    loop index in start..<items.len() -> &tail.push(items[index])
    tail
}


fn jet_cli_any_help_flag(items: [String]) -> Bool Never! {
    loop item in items {
        if jet_cli_is_help_flag(item) -> return true
    }
    false
}


// Rust `{:?}` of a `str` (`char::escape_debug`): `\t`, `\r`, `\n`, `\\`, `\"`,
// `\0`, and every other control character as `\u{hex}`; printable text,
// including non-ASCII, stays as written.
fn jet_cli_debug_quote(value: String) -> String Never! {
    digits :: "0123456789abcdef".bytes()
    raw :: value.bytes()
    out := [U8]{U8{34}}
    index := 0
    loop index < raw.len() {
        code :: Int.from_u8(raw[index])
        escape := ""
        control := -1
        if {
            code == 9 -> escape = "\\t"
            code == 10 -> escape = "\\n"
            code == 13 -> escape = "\\r"
            code == 34 -> escape = "\\\""
            code == 92 -> escape = "\\\\"
            code == 0 -> escape = "\\0"
            code < 32 || code == 127 -> control = code
            code == 0xC2 && index + 1 < raw.len() && Int.from_u8(raw[index + 1]) >= 0x80 && Int.from_u8(raw[index + 1]) <= 0x9F -> {
                control = Int.from_u8(raw[index + 1])
                index = index + 1
            }
            else -> {}
        }
        if {
            control >= 0 -> {
                loop byte in "\\u{{".bytes() -> &out.push(byte)
                if control >= 16 -> &out.push(digits[control >> 4])
                &out.push(digits[control & 15])
                &out.push(U8{125})
            }
            escape != "" -> {
                loop byte in escape.bytes() -> &out.push(byte)
            }
            else -> &out.push(raw[index])
        }
        index = index + 1
    }
    &out.push(U8{34})
    String.from_bytes(out) ?? value
}

// The `jet help --sort` value; "frequency" when no order is asked for.
fn jet_cli_help_order(jet_argv: [String]) -> String Never! {
    asked := false
    loop item in jet_argv {
        if item == "--sort" || item.starts_with("--sort=") -> asked = true
    }
    if !asked -> return "frequency"
    jet_cli_args_option_value(jet_argv, "--sort") ?? ""
}

// E2104 for a `--sort` value other than frequency, az, or za.
fn jet_cli_bad_help_order(value: String, color: Bool) -> JetCLIPlan Never! {
    jet_cli_fail("E2104", "`{value}` is not a `jet help` order", jet_cli_why("E2104"), "choose one of {JET_CLI_HELP_ORDERS}: `jet help --sort az`", color, JET_DRIVER_EXIT_USAGE)
}

// The jet-owned positional words before `--` (Source/main.rs `args`): flags
// and the values they swallow are dropped; bare `-` stays.
fn jet_cli_positionals(jet_argv: [String]) -> [String] Never! {
    positionals := [String]{}
    skip_next := false
    explain :: jet_argv.len() > 0 && jet_argv[0] == "explain"
    loop argument in jet_argv {
        if skip_next {
            skip_next = false
            next
        }
        if jet_cli_flag_takes_separate_value(argument) {
            skip_next = true
            next
        }
        prefixed := false
        loop prefix in JET_CLI_VALUE_PREFIXES {
            if argument.starts_with(prefix) -> prefixed = true
        }
        if prefixed -> next
        // `jet explain ->`: a syntax token that starts with `-` stays a query.
        explain_token :: explain && argument.starts_with("-") && !argument.starts_with("--") && argument != "-"
        if argument == "-" || !argument.starts_with("-") || explain_token -> &positionals.push(argument)
    }
    positionals
}

// Source/main.rs `check_flags`: the first unknown `--flag` teaches E2102.
fn jet_cli_check_flags(jet_argv: [String], command: String, color: Bool) -> JetCLIPlan? Never! {
    external_fmt := false
    if command == "fmt" {
        loop argument in jet_argv {
            if argument == "--lang" || argument.starts_with("--lang=") -> external_fmt = true
        }
    }
    loop argument in jet_argv {
        if !argument.starts_with("--") || argument == "--" -> next
        if jet_cli_is_known_flag(argument) -> next
        head :: argument.split("=").to_list()[0]
        if external_fmt && JET_CLI_EXTERNAL_FMT_FLAGS.contains(head) -> next
        if head == "--emit-rust" {
            return Val(jet_cli_fail("E2102", "`--emit-rust` isn't a flag jet understands", "generated output belongs to the `emit` command", "run `jet emit --rust <file.jet>`", color, JET_DRIVER_EXIT_USAGE))
        }
        program :: command == "run" || command == "test"
        fix := ""
        if jet_cli_closest_flag(head) == .Val(close) {
            if {
                program -> fix = "did you mean `{close}`? Or use `jet {command} <file> -- {head}` to pass it to your program"
                command == "jobs" -> fix = "did you mean `{close}`? Or write it after the job name, `jet {command} <name> {head}`, to pass it to the job"
                else -> fix = "did you mean `{close}`? (run `jet help` for the flags)"
            }
        } else {
            if {
                program -> fix = "use `jet {command} <file> -- {head}` to pass this flag to your program"
                command == "jobs" -> fix = "write it after the job name, `jet {command} <name> {head}`, to pass it to the job"
                else -> fix = "drop the flag, or run `jet help` to see the flags"
            }
        }
        return Val(jet_cli_fail(
            "E2102",
            "`{head}` isn't a flag jet understands",
            "flags before `--` belong to jet; everything after `--` is forwarded to your program",
            fix,
            color,
            JET_DRIVER_EXIT_USAGE,
        ))
    }
    None
}

// The directory part of `path`, as Rust `Path::parent` reads it.
fn jet_cli_parent(path: String) -> String? Never! {
    parts :: path.split("/").to_list()
    if parts.len() <= 1 -> return None
    parent :: jet_cli_prefix(parts, parts.len() - 1).join("/")
    if parent == "" -> return Val("/")
    Val(parent)
}

// Is there a `package.jet` in `directory` or above it?
fn jet_cli_has_manifest_above(directory: String) -[FS]> Bool Never! {
    current := directory
    loop {
        if cli_files.is_file("{current}/package.jet") -> return true
        current = jet_cli_parent(current) ?? return false
        if current == "/" -> return cli_files.is_file("/package.jet")
    }
}

// `jet <word>` sugar for `jet run <word>` (Source/main.rs `looks_like_jet_source`).
fn jet_cli_looks_like_source(argument: String) -[FS]> Bool Never! {
    if argument.ends_with(".jet") -> return true
    if cli_files.exists(argument) -> return cli_files.is_file(argument) || cli_files.is_dir(argument)
    cli_files.exists("{argument}.jet")
}

// `jet check [<file>]` / `jet build [<file>]`: the bare form needs a project;
// a file target is read as the user typed it (or with `.jet` appended), and a
// missing file is E2105.
fn jet_cli_check(args: [String], command: String, color: Bool, quiet: Bool) -[FS, Env]> JetCLIPlan Never! {
    if args.len() < 2 {
        directory :: cli_files.cwd() ?? "."
        if jet_cli_has_manifest_above(directory) -> return jet_cli_not_ported(command, color)
        return jet_cli_fail("E2104", "no file given and no `package.jet` found in this directory or above", jet_cli_why("E2104"), "run `jet {command} <file.jet>` or cd into a project", color, JET_DRIVER_EXIT_USAGE)
    }
    target :: args[1]
    if cli_files.is_dir(target) -> return jet_cli_not_ported(command, color)
    file := target
    if !cli_files.is_file(target) && cli_files.is_file("{target}.jet") -> file = "{target}.jet"
    source :: cli_files.read(file) ?? {
        parent :: jet_cli_parent(file) ?? "."
        default_entry :: file == "main.jet" || file.ends_with("/main.jet")
        fix :: if default_entry && jet_cli_has_manifest_above(parent) -> "create `main.jet` in the project, or run `jet {command} <file.jet>`" else -> "check the spelling, or run jet from the folder that contains it"
        return jet_cli_fail("E2105", "can't securely read the file `{file}`", jet_cli_why("E2105"), fix, color, JET_DRIVER_EXIT_USER_ERROR)
    }
    JetCLIPlan.Check{file: file, source: source, color: color, quiet: quiet}
}

// Build flags whose Jet port has not landed: refused, never ignored.
JET_CLI_BUILD_UNPORTED_FLAGS :: [String]{
    "--lib", "--small", "--target", "--verify", "--sbom", "--import", "--emit-generated", "--set",
    "--builder", "--locked", "-p", "--output", "--allow", "--deny", "--gate",
}

// `jet build <file>`: `--release` (or `--profile release`) builds through
// rustc/LLVM; the default and `--profile debug` build through the Jet-native
// backend. Other profiles and the flags above are not ported yet.
fn jet_cli_build(jet_argv: [String], args: [String], color: Bool, quiet: Bool) -[FS, Env]> JetCLIPlan Never! {
    release := jet_argv.contains("--release")
    loop (index, argument) in jet_argv {
        head :: argument.split("=").to_list()[0]
        if JET_CLI_BUILD_UNPORTED_FLAGS.contains(head) -> return jet_cli_not_ported("build {head}", color)
        if head != "--profile" -> next
        profile := ""
        if {
            argument.starts_with("--profile=") -> profile = argument.slice(10..<argument.len())
            index + 1 < jet_argv.len() -> profile = jet_argv[index + 1]
            else -> {}
        }
        if {
            profile == "release" -> release = true
            profile == "debug" -> {}
            else -> return jet_cli_not_ported("build --profile {profile}", color)
        }
    }
    entry :: jet_cli_check(args, "build", color, quiet)
    if entry == {
        .Check(file, source, _, _) -> return JetCLIPlan.Build{file: file, source: source, color: color, release: release}
        else -> {}
    }
    entry
}

// Source/main.rs explain dispatch consumes the one Help/Explain mechanism.
fn jet_cli_explain(jet_argv: [String], args: [String], adapter: JetCLIOutputAdapter) -> JetCLIPlan Never! {
    color :: adapter.profile.ansi_enabled
    if jet_argv.contains("--reload") || jet_argv.contains("--web-graph") || jet_argv.contains("--cost") -> return jet_cli_not_ported("explain", color)
    if args.len() > 1 && args[1] == "marker" -> return jet_cli_not_ported("explain marker", color)
    code :: if args.len() > 1 -> Val(args[1]) else -> None
    fact_file :: if args.len() > 2 -> Val(args[2]) else -> None
    settings :: jet_cli_args_parse_setting_overrides(jet_argv, adapter.profile.machine_enabled) ?? return jet_cli_args_refusal_plan(err, color)
    profile :: jet_cli_args_option_value(jet_argv, "--profile") ?? "dev"
    request :: JetCLIDevExplainRequest{code: code, fact_file: fact_file, mode: jet_cli_output_mode(adapter), verbose: adapter.flags.verbose, profile: profile, setting_overrides: settings}
    if jet_cli_dev_explain(request) == {
        .Done(output) -> return JetCLIPlan.Done{output: ~output}
        .Resolve(pending) -> return JetCLIPlan.Explain{request: ~pending}
    }
}

// Plan one `jet` invocation; `input` is argv without the program name and
// `facts` the process output facts the host read once.
pub fn jet_cli_front(input: [String], facts: JetCLIProcessFacts) -[FS, Env]> JetCLIPlan Never! {
    // Source/main.rs `main`: the project-job boundary is inserted before any
    // parsing, so the later passes only see Jet's own words.
    raw := ~input
    jet_cli_separate_job_argv(&raw)
    // Every output capability is resolved once from the jet-owned prefix;
    // the standalone separator belongs to the child program (Source/main.rs
    // `main`: `OutputAdapterHost::select(&raw[..output_arg_end])`).
    owned :: jet_cli_before_argument_separator(raw)
    adapter :: jet_cli_output_adapter_select(owned, facts) ?? return jet_cli_done("", "Error [E2104]: {jet_cli_output_profile_error_message(err)}\n", JET_DRIVER_EXIT_USAGE)
    jet_cli_apply_machine_mode(adapter)
    color :: adapter.profile.ansi_enabled
    quiet :: adapter.flags.quiet
    json :: adapter.profile.machine_enabled
    if raw.len() == 0 -> return jet_cli_not_ported("repl", color)
    if raw[0] == "?" -> return jet_cli_not_ported("?", color)

    // Retired, moved, and grouped spellings (Source/main.rs `normalize_frequency_ring_argv`).
    if jet_cli_retired_report(raw, color) == .Val(report) -> return jet_cli_done("", report, JET_DRIVER_EXIT_USAGE)
    argv := ~raw
    if jet_cli_moved_command(argv[0]) == .Val(moved) {
        group :: JET_CLI_COMMANDS[moved.group].name
        return jet_cli_fail(
            "E2101",
            "`{argv[0]}` moved under `jet {group}`.",
            "infrequent commands live in a named area so daily Jet commands stay easy to scan.",
            "run `jet {group} {argv.join(" ")}`.",
            color,
            JET_DRIVER_EXIT_USAGE,
        )
    }
    group :: ~argv[0]
    exhaustive := false
    if jet_cli_group_index(group) == .Val(index) {
        exhaustive = JET_CLI_COMMANDS[index].exhaustive
        second_asks :: argv.len() > 1 && (argv[1] == "help" || jet_cli_is_help_flag(argv[1]))
        asks_help :: if group == "env" -> second_asks else -> argv.len() == 1 || second_asks
        if (exhaustive || group == "env") && asks_help -> return jet_cli_done(jet_cli_group_help(group), "", JET_DRIVER_EXIT_OK)
    }
    if argv.len() > 1 {
        sub :: ~argv[1]
        nested :: jet_cli_nested_command(group, sub)
        if exhaustive && nested == None {
            return jet_cli_fail("E2101", "`{sub}` isn't a jet {group} command.", "jet {group} accepts only commands in its named area.", "run `jet {group} help`.", color, JET_DRIVER_EXIT_USAGE)
        }
        if nested == .Val(found) {
            key :: JET_CLI_COMMANDS[found.group].actions[found.action].handler
            if jet_cli_handler_index(key) == .Val(handler) {
                spec :: JET_CLI_HANDLERS[handler]
                if !spec.keeps_group {
                    rewritten := [String]{spec.dispatch_word}
                    loop word in jet_cli_tail(argv, 2) -> &rewritten.push(word)
                    argv = rewritten
                }
            }
        }
    }
    if argv[0] == "cc" || argv[0] == "c++" || argv[0] == "perf" -> return jet_cli_not_ported(argv[0], color)
    if !jet_cli_is_builtin(argv[0]) && jet_cli_looks_like_source(argv[0]) {
        rewritten := [String]{"run"}
        loop word in argv -> &rewritten.push(word)
        argv = rewritten
    }

    // Everything after the first standalone `--` belongs to the program.
    separator := argv.len()
    loop (index, argument) in argv {
        if argument == "--" {
            separator = index
            break
        }
    }
    jet_argv :: jet_cli_prefix(argv, separator)
    loop (index, argument) in jet_argv {
        if argument != "--version" -> next
        builtin_before := false
        loop earlier in 0..<index {
            if jet_cli_is_builtin(jet_argv[earlier]) -> builtin_before = true
        }
        if !builtin_before -> return jet_cli_not_ported("--version", color)
        break
    }
    args :: jet_cli_positionals(jet_argv)
    if args.len() > 0 && args[0] == "lsp" -> return jet_cli_not_ported("self lsp", color)
    if args.len() == 0 {
        if jet_cli_any_help_flag(jet_argv) {
            order :: jet_cli_help_order(jet_argv)
            if !jet_cli_is_help_order(order) -> return jet_cli_bad_help_order(order, color)
            return jet_cli_done(jet_cli_usage_page(order), "", JET_DRIVER_EXIT_OK)
        }
        return jet_cli_done(jet_cli_greeting(), "", JET_DRIVER_EXIT_OK)
    }
    command :: args[0]
    if json && command != "run" && command != "dev" && command != "compiler" && command != "semindex" && command != "completions" && command != "man" && command != "explain" && command != "fmt" && command != "fix" && command != "status" && command != "test" && command != "try" && command != "budget" && command != "package" -> return jet_cli_not_ported("{command} --json", color)

    // `--lib` and `--output` belong to the commands that produce those artifacts.
    library :: jet_argv.contains("--lib")
    if library && command != "build" {
        return jet_cli_fail("E2104", "`--lib` is only valid with `jet build`", jet_cli_why("E2104"), "run `jet build --lib <file.jet>` to emit the native Library artifacts", color, JET_DRIVER_EXIT_USAGE)
    }
    output_name := String?{None}
    loop (index, argument) in jet_argv {
        if argument.starts_with("--output=") {
            output_name = Val(argument.slice(9..<argument.len()))
            break
        }
        if argument == "--output" {
            value := ""
            if index + 1 < jet_argv.len() && !jet_argv[index + 1].starts_with("-") -> value = jet_argv[index + 1]
            output_name = Val(value)
            break
        }
    }
    if output_name == .Val(output) {
        allowed :: command == "run" || (command == "dev" && jet_argv.contains("--canvas")) || (command == "build" && library) || command == "package"
        if !allowed || output == "" {
            return jet_cli_fail("E2104", "`--output` needs a runnable Output address or `jet build --lib`", jet_cli_why("E2104"), "write `jet run --output <address> <file.jet>`, or `jet build --lib --output <name> <file.jet>`", color, JET_DRIVER_EXIT_USAGE)
        }
    }

    if !jet_cli_is_builtin(command) {
        fix :: if jet_cli_closest_command(command) == .Val(close) -> "did you mean `jet {close}`? Run `jet help` to see them all." else -> "run `jet help` to see every command."
        return jet_cli_fail("E2101", "`{command}` isn't a jet command.", "every jet run starts with a command like `run`, `check`, or `new`.", fix, color, JET_DRIVER_EXIT_USAGE)
    }

    owns_flags :: jet_cli_owns_flag_vocabulary(command)
    bespoke_help :: command == "bind" || command == "diff" || command == "merge" || command == "perf"
    if jet_cli_any_help_flag(jet_argv) && !(owns_flags && bespoke_help) -> return jet_cli_done(jet_cli_command_help(command), "", JET_DRIVER_EXIT_OK)
    if !owns_flags {
        if jet_cli_check_flags(jet_argv, command, color) == .Val(refusal) -> return refusal
    }
    if command != "dev" && jet_argv.contains("--canvas") {
        return jet_cli_fail("E2102", "`--canvas` is only valid with `jet dev`", jet_cli_why("E2102"), "run `jet dev <file.jet> --canvas` to open the Canvas IDE", color, JET_DRIVER_EXIT_USAGE)
    }

    if command == {
        "help" -> {
            order :: jet_cli_help_order(jet_argv)
            if !jet_cli_is_help_order(order) -> return jet_cli_bad_help_order(order, color)
            if args.len() > 1 {
                if args[1] == "diff" || args[1] == "merge" -> return jet_cli_not_ported("help {args[1]}", color)
                return jet_cli_done(jet_cli_command_help(args[1]), "", JET_DRIVER_EXIT_OK)
            }
            return jet_cli_done(jet_cli_usage_page(order), "", JET_DRIVER_EXIT_OK)
        }
        "explain" -> return jet_cli_explain(jet_argv, args, adapter)
        "completions" -> return JetCLIPlan.Completions{arguments: jet_cli_tail(jet_argv, 1)}
        "man" -> return JetCLIPlan.Done{output: jet_cli_dev_man(JET_CLI_VERSION, adapter.profile)}
        // Source/main.rs `"reserved"`: the human report (machine output is not ported yet).
        "reserved" -> return jet_cli_done(jet_cli_reserved_report_text(), "", JET_DRIVER_EXIT_OK)
        // Source/main.rs `"inspect"`: the request is parsed and refused exactly as
        // Rust does; running a plane needs the checked inspection projections.
        "inspect" -> {
            if jet_cli_parse_inspect_args(argv) == .Err(error) {
                return jet_cli_fail("E2104", error.message, jet_cli_why("E2104"), "run `jet inspect <types|rights|claims|shapes|accel|decisions|structure|build|gates> [TARGET] [--live PID | --replay ARTIFACT]`", color, JET_DRIVER_EXIT_USAGE)
            }
            return jet_cli_not_ported("inspect", color)
        }
        "check" -> return jet_cli_check(args, "check", color, quiet)
        "build" -> return jet_cli_build(jet_argv, args, color, quiet)
        "run" -> return JetCLIPlan.Run{invocation: JetCLIExecutionInvocation{command: "run", arguments: jet_argv, program_arguments: jet_cli_tail(argv, separator + 1), output: adapter, reload: watch_policy_from(jet_argv, WatchPolicy.Auto)}}
        "dev" -> return JetCLIPlan.Dev{invocation: JetCLIExecutionInvocation{command: "dev", arguments: jet_argv, program_arguments: jet_cli_tail(argv, separator + 1), output: adapter, reload: watch_policy_from(jet_argv, WatchPolicy.Auto)}}
        "fmt" -> {
            external := false
            loop argument in jet_argv {
                if argument == "--lang" || argument.starts_with("--lang=") -> external = true
            }
            mode :: jet_cli_output_mode(adapter)
            if external {
                if jet_cli_external_format_options(jet_cli_tail(argv, 1)) == {
                    .Ok(options) -> return JetCLIPlan.ExternalFormat{options: ~options, mode: mode}
                    .Err(error) -> return JetCLIPlan.Done{output: jet_cli_format_parse_refusal(~error, mode)}
                }
            }
            return JetCLIPlan.Format{options: jet_cli_format_options(jet_cli_tail(jet_argv, 1), jet_cli_tail(args, 1)), mode: mode}
        }
        "fix" -> {
            if args.len() < 2 {
                output := JetDriverVerbOutput{stdout: "", stderr: "", exit_code: JET_DRIVER_EXIT_USAGE}
                jet_cli_write_status(&output, adapter.profile, jet_cli_command_help("fix"))
                return JetCLIPlan.Done{output: output}
            }
            return JetCLIPlan.Fix{options: jet_cli_fix_options(jet_cli_tail(jet_argv, 1), args[1]), mode: jet_cli_output_mode(adapter)}
        }
        "status" -> return JetCLIPlan.Status{arguments: jet_cli_tail(jet_argv, 1), json: json}
        "test" -> return JetCLIPlan.Test{arguments: jet_argv, mode: jet_cli_output_mode(adapter), advisory_lints_visible: jet_cli_advisory_lints_visible(command, adapter.flags.verbose)}
        "budget" -> return JetCLIPlan.Budget{arguments: argv}
        "package" -> {
            // Source/main.rs passes the whole jet_argv; the parser skips `package`.
            if jet_cli_bundle_parse_args(jet_argv) == {
                .Err(error) -> return JetCLIPlan.Done{output: jet_cli_bundle_error_output(error.message, json)}
                .Ok(options) -> {
                    if options.kind == BundleKind.Game -> return jet_cli_not_ported("package game", color)
                    return JetCLIPlan.PackageDesktop{arguments: jet_argv, options: options, machine: json}
                }
            }
        }
        "try" -> {
            if args.len() < 2 {
                output := JetDriverVerbOutput{stdout: "", stderr: "", exit_code: JET_DRIVER_EXIT_USAGE}
                jet_cli_write_status(&output, adapter.profile, jet_cli_command_help("try"))
                return JetCLIPlan.Done{output: output}
            }
            return JetCLIPlan.Try{file: args[1], keep: jet_argv.contains("--keep"), mode: jet_cli_output_mode(adapter)}
        }
        "compiler" -> {
            if args.len() == 3 && args[1] == "check" -> return JetCLIPlan.Inspect{file: args[2], color: color, semindex: false}
            return jet_cli_not_ported("inspect compiler", color)
        }
        "semindex" -> {
            if args.len() < 2 -> return jet_cli_fail("E2104", "`jet inspect semindex` needs an entry file", jet_cli_why("E2104"), "jet inspect semindex Examples/features/basics/hello.jet", color, JET_DRIVER_EXIT_USER_ERROR)
            if json -> return JetCLIPlan.Inspect{file: args[1], color: color, semindex: true}
            return jet_cli_not_ported("inspect semindex", color)
        }
        else -> {}
    }
    jet_cli_not_ported(command, color)
}
