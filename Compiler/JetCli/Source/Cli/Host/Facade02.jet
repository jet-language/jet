// Rust: Source/lib.rs:2706
pub fn resolve_c_links_for_bundle(bundle: &AST.ProgramBundle, target: String?) -> [String] [Diagnostic]! {
    if !bundle.cffi.links_c() -> return Ok([])
    entry :: bundle.modules.get(bundle.entry).map(module -> &module.path)
    // Link discovery is post-check work, not a semantic check.
    if target == {
        .Val(selected) -> CFFI.rustc_link_args_for_target_with_entry(&bundle.cffi, &bundle.project_root, selected, entry)
        .None -> CFFI.rustc_link_args_for_target_with_entry(&bundle.cffi, &bundle.project_root, FFI.host_target(), entry)
    }
}

