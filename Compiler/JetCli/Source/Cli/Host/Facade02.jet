// Rust: Source/lib.rs:1803
fn workspace_build_authority(file: String) -> (Authority.AuthorityResolver, WorkspaceFile.WorkspaceSource)? [Diagnostic]! {
    selected_path :: absolute_source_path(file)
    root :: selected_path.parent() ?? OSPath.from(".")
    resolver :: if Authority.AuthorityResolver.open(root) == {
        .Ok(resolver) -> ^resolver
        .Err(error) -> { if error.is_missing() -> return Ok(None); return Err([error.diagnostic()]) }
    }
    source :: resolver.resolve_workspace_source().map_err(error -> [workspace_build_root_diagnostic(selected_path, &error.workspace_diagnostic())]) ?? return Ok(None)
    entry_name :: selected_path.file_name() ?? return Ok(None)
    checked_entry :: resolver.checked_file(OSPath.from(entry_name)).map_err(error -> [error.diagnostic()])
    if checked_entry.path != source.path -> return Ok(None)
    resolver.revalidate_source(&source).map_err(error -> [error.diagnostic()])
    if source.role != WorkspaceFile.WorkspaceSourceRole.Index {
        return Err([Diagnostic.error("E1334", "workspace build entry is selected by an authority source", "workspace build execution requires the matching source to have the Index role; an authority source cannot select a workspace entry", "declare the workspace index in `workspace.jet`, or build the member entry directly", None)])
    }
    Ok(Val((^resolver, ^source)))
}

// Rust: Source/lib.rs:1852
fn absolute_source_path(file: String) -> OSPath {
    selected_path :: OSPath.from(file)
    if selected_path.is_absolute() -> selected_path
    else -> env.current_dir().unwrap_or_else(_ -> OSPath.from(".")).join(selected_path)
}

// Rust: Source/lib.rs:1863
struct CheckedBuildEntry {
    package: Authority.CheckedPackage
    file: Authority.CheckedFile?
    entry_fn: String?
    // Rust: Source/lib.rs:1870
    fn source_file(&self) -> &Authority.CheckedFile { self.file.as_ref() ?? &self.package.member.manifest.file }
    // Rust: Source/lib.rs:1876
    fn revalidate(&self, workspace_resolver: &Authority.AuthorityResolver) -> Authority.AuthorityError! {
        workspace_resolver.revalidate_member(&self.package.member)
        member_resolver :: Authority.AuthorityResolver.from_checked_directory(&self.package.member.directory)
        if &self.file == {
            .Val(file) -> member_resolver.revalidate_file(file)
            .None -> workspace_resolver.revalidate_file(&self.package.member.manifest.file)
        }
    }
}

// Rust: Source/lib.rs:1891
fn workspace_member_entry(resolver: &Authority.AuthorityResolver, member: String, checked_package: Authority.CheckedPackage) -> CheckedBuildEntry? Diagnostic! {
    resolver.revalidate_member(&checked_package.member).map_err(error -> error.diagnostic())
    member_resolver :: Authority.AuthorityResolver.from_checked_directory(&checked_package.member.directory)
    if checked_package.facts.resolve_run_entry_checked(&member_resolver).map_err(error -> Diagnostic.error("E3501", "workspace member `{member}` has an invalid typed output", error, "repair the member's typed Package output before building the workspace", None)) == {
        .Val(entry) -> return Ok(Val(CheckedBuildEntry{package: ^checked_package, file: Val(^entry.file), entry_fn: Val(^entry.callable)}))
        .None -> {}
    }
    loop candidate in [OSPath.from(Syntax.DEFAULT_ENTRY_FILE), OSPath.from("src").join(Syntax.DEFAULT_ENTRY_FILE)] {
        if member_resolver.checked_file(candidate) == {
            .Ok(file) -> return Ok(Val(CheckedBuildEntry{package: ^checked_package, file: Val(^file), entry_fn: None}))
            .Err(error) -> { if !error.is_missing() -> return Err(error.diagnostic()) }
        }
    }
    named :: OSPath.from("{checked_package.facts.name}.{Syntax.FILE_EXT}")
    if member_resolver.checked_file(named) == {
        .Ok(file) -> return Ok(Val(CheckedBuildEntry{package: ^checked_package, file: Val(^file), entry_fn: None}))
        .Err(error) -> { if !error.is_missing() -> return Err(error.diagnostic()) }
    }
    if checked_package.facts.resolve_build_entry_checked(&member_resolver).map_err(error -> {
        code :: if error.contains("two build entries for the package:") -> "E3520" else -> "E3501"
        Diagnostic.error(code, error, "a package has one checked build authority", "keep one `fn build` in the member package", None)
    }) == {
        .Val(entry) -> {
            selected_file :: if entry.path != checked_package.member.manifest.file.path -> Val(^entry) else -> None
            return Ok(Val(CheckedBuildEntry{package: ^checked_package, file: ^selected_file, entry_fn: None}))
        }
        .None -> {}
    }
    Ok(None)
}

// Rust: Source/lib.rs:1982
fn read_real_generated_file(project_root: OSPath, selected_path: OSPath) -> [U8] io.Error! {
    if path_has_symlinked_component(project_root, selected_path) || fs.symlink_metadata(selected_path).is_ok_and(metadata -> metadata.file_type().is_symlink()) {
        return Err(io.Error.new(.PermissionDenied, "generated source path contains a symlink"))
    }
    fs.read(selected_path)
}

// Rust: Source/lib.rs:1997
fn write_exported_generated_file(project_root: OSPath, selected_path: OSPath, bytes: &[U8]) -> io.Error! {
    if path_has_symlinked_component(project_root, selected_path) || fs.symlink_metadata(selected_path).is_ok_and(metadata -> metadata.file_type().is_symlink()) {
        return Err(io.Error.new(.PermissionDenied, "generated export path contains a symlink"))
    }
    parent :: selected_path.parent() ?? return Err(io.Error.new(.InvalidInput, "generated export has no parent directory"))
    ensure_real_directory(parent)
    loop attempt in 0..<100 {
        temporary :: parent.join(".jet-export-{process.id()}-{attempt}")
        // GATE #4494: native exclusive-create, write, fsync and rename.
        file := if fs.OpenOptions.new().create_new(true).write(true).open(temporary) == {
            .Ok(file) -> ^file
            .Err(error) -> { if error.kind() == .AlreadyExists -> continue; return Err(error) }
        }
        if file.write_all(bytes).and_then(_ -> file.sync_all()) == {
            .Ok(_) -> {}
            .Err(error) -> { _ :: fs.remove_file(temporary); return Err(error) }
        }
        fs.rename(temporary, selected_path)
        return Ok(())
    }
    Err(io.Error.new(.AlreadyExists, "could not allocate a unique generated export temporary file"))
}

// Rust: Source/lib.rs:2042
fn path_has_symlinked_component(root: OSPath, selected_path: OSPath) -> Bool {
    relative :: selected_path.strip_prefix(root).ok() ?? return true
    current := ~root
    loop component in relative.components() {
        part :: if component == { .Normal(part) -> part; _ -> return true }
        current.push(part)
        if fs.symlink_metadata(current).is_ok_and(metadata -> metadata.file_type().is_symlink()) -> return true
    }
    false
}

// Rust: Source/lib.rs:2061
fn ensure_real_directory(selected_path: OSPath) -> io.Error! {
    current := OSPath.new()
    loop component in selected_path.components() {
        if component == {
            .Prefix(prefix) -> current.push(prefix.as_os_str())
            // GATE #4483: native separator comes from the selected target.
            .RootDir -> current.push(path.MAIN_SEPARATOR.to_string())
            .CurDir -> {}
            .ParentDir -> return Err(io.Error.new(.InvalidInput, "generated export path contains a parent component"))
            .Normal(part) -> current.push(part)
        }
        if fs.symlink_metadata(current) == {
            .Ok(metadata) -> {
                if metadata.file_type().is_symlink() || !metadata.is_dir() {
                    return Err(io.Error.new(.PermissionDenied, "generated export directory `{current.display()}` is not real"))
                }
            }
            .Err(error) -> {
                if error.kind() != .NotFound -> return Err(error)
                fs.create_dir(current)
            }
        }
    }
    Ok(())
}

