pub fn has_entry_fn(file: String, name: String) -> Bool {
    with_compiler_stack(() -> {
        if Loader.load_entry_with_overlay(file, None, false) == {
            .Ok(bundle) -> bundle.modules[bundle.entry].items.iter().any(item -> if item == { .Func(function) -> function.name == name; _ -> false })
            .Err(_) -> false
        }
    })
}
