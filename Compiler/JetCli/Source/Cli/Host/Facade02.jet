// Rust: Source/lib.rs:3002
pub fn eval_pure_program_value(src: String, file: String) -> (CtValue, String) [Diagnostic]! { with_compiler_stack(() -> eval_pure_program_value_inner(src, file)) }
// Rust: Source/lib.rs:3009
fn eval_pure_program_value_inner(src: String, file: String) -> (CtValue, String) [Diagnostic]! {
    (diagnostics, checked_bundle, _) :: Driver.check_eval_with_effect_facts(src, file)
    if diagnostics.iter().any(diagnostic -> diagnostic.severity == Severity.Error) -> return Err(^diagnostics)
    bundle :: checked_bundle ?? return Err(^diagnostics)
    (mir, artifact) :: lower_checked_semantic_mir_program_for(&bundle, MIR.MirArtifactRequest.new(MIR.MirArtifactTarget.Interpreter, MIR.MirArtifactKind.NativeExecutable, MIR.MirArtifactBuildMode.Dev))
    globals := [String:MIR.MirValue]{:}
    loop module in &bundle.modules {
        loop item in &module.items {
            if item == {
                .Const(constant) -> {
                    if &constant.ct == {
                        .Val(value) -> {
                            converted :: Comptime.MirBridge.ct_to_mir_value(~value, Span.new(0, 0)).map_err(error -> [error])
                            _ :: globals.entry(~constant.name).or_insert(^converted)
                        }
                        .None -> {}
                    }
                }
                _ -> {}
            }
        }
    }
    config := Codegen.MIREval.MirEvalConfig.default()
    config.base_dir = ~bundle.project_root
    config.globals = ^globals
    result :: Codegen.MIREval.evaluate_mir_program_with_config(&mir, artifact, &config).map_err(error -> [error.into_diagnostic()])
    value :: Comptime.MirBridge.mir_to_ct_value(^result.value, Span.new(0, 0)).map_err(error -> [error])
    Ok((^value, ^result.stdout))
}

// Rust: Source/lib.rs:3070
pub fn eval_pure_program(src: String, file: String) -> String [Diagnostic]! { with_compiler_stack(() -> eval_pure_program_inner(src, file)) }
// Rust: Source/lib.rs:3074
fn eval_pure_program_inner(src: String, file: String) -> String [Diagnostic]! {
    (toks, lex_diags) :: Lexer.lex(src)
    if !lex_diags.is_empty() -> return Err(^lex_diags)
    prog :: Parser.parse_with_source(&toks, src)
    func_map := [String:&AST.Func]{:}
    loop item in &prog.items {
        if item == { .Func(f) -> func_map[~f.name] = &f; _ -> {} }
    }
    main_fn :: func_map.get("run") ?? return Err([Diagnostic.error("E3401", "no `run` function found for `jet eval`", "pure evaluation needs a `fn run() -[]>` entry point", "add `fn run() -[]> { … }` to the program", None)])
    base_dir :: OSPath.from(file).parent() ?? OSPath.from(".")
    sink := Comptime.DevSink.new()
    program :: Comptime.ProgramInfo.empty()
    Comptime.run_main(main_fn, &func_map, base_dir, &sink, &program).map_err(d -> [d])
    text :: ^sink.stdout
    trimmed := text.trim() // #4303
    json :: if trimmed.is_empty() -> "null"
        else if trimmed == "true" || trimmed == "false" -> trimmed.to_string()
        else if Numeric.CtBigInt.from_str(trimmed).is_ok() || trimmed.parse<F64>().is_ok() -> trimmed.to_string()
        else -> format("{:?}", trimmed) // GATE #4500: canonical escape-debug string spelling.
    Ok(json)
}
