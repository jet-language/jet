pub fn build_project_root(file: String) -> OSPath [Diagnostic]! {
    absolute :: absolute_source_path(file)
    directory :: absolute.parent() ?? OSPath.from(".")
    Loader.selected_project_root(directory).map_err(diagnostic -> [diagnostic])
}

// Rust: Source/lib.rs:2116
fn resolve_build_grants(file: String, cli: &[String]) -> [String] [Diagnostic]! {
    allowed := Set<String>.from_iter(cli.iter().cloned())
    workspace_denies := Set<String>{}
    workspace_grants := [String:Set<String>]{:}
    package_name := None
    absolute :: absolute_source_path(file)
    entry_dir :: absolute.parent() ?? OSPath.from(".")
    workspace_root :: Loader.find_workspace_root_checked(entry_dir).map_err(diagnostic -> [workspace_build_root_diagnostic(entry_dir, &diagnostic)])
    workspace_checked :: workspace_root.as_ref().map(root -> {
        resolver :: Authority.AuthorityResolver.open(root).map_err(error -> [workspace_build_root_diagnostic(root, &error.diagnostic())])
        source :: resolver.resolve_workspace_source().map_err(error -> [workspace_build_root_diagnostic(root, &error.workspace_diagnostic())]) ?? return Err([Diagnostic.error("E3503", "build policy in `{root.display()}` is malformed", "the workspace root disappeared before build policy was selected", "restore the workspace declaration before running build code", None)])
        resolver.revalidate_source(&source).map_err(error -> [error.diagnostic()])
        Ok((^resolver, ^source))
    }).transpose()
    workspace_policy :: workspace_checked.as_ref().map((resolver, source) -> load_workspace_build_policy(resolver, source)).transpose()
    workspace_path :: workspace_checked.as_ref().map((_, source) -> ~source.path)
    package_root :: Loader.find_manifest_root_checked(entry_dir).map_err(diagnostic -> [diagnostic]).filter(root -> workspace_root.as_ref().is_none_or(workspace -> Loader.is_physically_within(workspace, root)))
    if package_root.is_none() {
        if Loader.stale_manifest_name_diagnostic(entry_dir) == { .Val((_, diagnostic)) -> return Err([diagnostic]); .None -> {} }
    }
    if package_root.as_ref() == {
        .Val(dir) -> {
            package :: Loader.package_facts_for_root(dir) ?? return Err([Diagnostic.error("E3503", "package facts in `{dir.display()}` are missing", "the selected package root has no checked Package declaration", "restore the package declaration before running build code", None)])
            package_name = Val(~package.name)
            loop effect in package.build_allow {
                if Comptime.Build.BuildCapability.parse(effect) == { .Val(capability) -> { _ :: allowed.insert(capability.flag().to_string()) }; .None -> {} }
            }
        }
        .None -> {}
    }
    // Exactly one nested-workspace policy layer; never merge enclosing ceilings.
    if (workspace_policy, workspace_path.as_ref()) == {
        (.Val(policy), .Val(workspace)) -> {
            loop effect in policy.build_deny {
                capability :: Comptime.Build.BuildCapability.parse(effect) ?? return Err([Diagnostic.error("E3503", "build policy in `{workspace.display()}` is malformed", "unknown build effect `{effect}`", "use one of the declared build effects in `policy.deny`", None)])
                _ :: workspace_denies.insert(capability.flag().to_string())
            }
            // BTreeMap's sorted subject order determines the first invalid effect.
            subjects :: policy.build_grants.keys().sorted()
            loop subject in subjects {
                grants := workspace_grants.entry(subject).or_insert(Set<String>{})
                loop effect in policy.build_grants[subject] {
                    capability :: Comptime.Build.BuildCapability.parse(effect) ?? return Err([Diagnostic.error("E3503", "build policy in `{workspace.display()}` is malformed", "unknown build effect `{effect}`", "use one of the declared build effects in `policy.grants`", None)])
                    _ :: grants.insert(capability.flag().to_string())
                }
            }
        }
        _ -> {}
    }
    subject :: if package_name == {
        .Val(name) -> name
        .None -> {
            if workspace_root.is_some() -> Loader.authority_name_for_entry(absolute).map_err(diagnostic -> [diagnostic])
            else -> (absolute.file_stem().and_then(name -> name.to_str()).filter(name -> !name.is_empty()) ?? "app").to_string()
        }
    }
    if workspace_grants.get(subject) == { .Val(grants) -> allowed.extend(grants.iter().cloned()); .None -> {} }
    loop denied in workspace_denies -> { _ :: allowed.remove(denied) }
    Ok(allowed.into_iter().sorted().collect())
}

// Rust: Source/lib.rs:2263
fn load_workspace_build_policy(resolver: &Authority.AuthorityResolver, source: &WorkspaceFile.WorkspaceSource) -> Overlay.OverlayPolicy [Diagnostic]! {
    WorkspaceFile.evaluate_checked_source(source, resolver).map(plan -> ^plan.overlay_policy).map_err(diagnostic -> [workspace_build_root_diagnostic(source.path, &diagnostic)])
}
// Rust: Source/lib.rs:2277
fn production_build_policy() -> Comptime.Build.BuildPolicy {
    ci :: env.var("CI").ok().is_some_and(value -> {
        trimmed := value.trim() // #4303
        folded :: trimmed.to_ascii_lowercase()
        folded == "1" || folded == "true" || folded == "yes"
    })
    if ci -> Comptime.Build.BuildPolicy.ci_default() else -> Comptime.Build.BuildPolicy.local_default()
}

