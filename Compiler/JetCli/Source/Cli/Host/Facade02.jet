pub fn has_test_blocks(file: String) -> Bool {
    with_compiler_stack(() -> {
        if Loader.load_entry_with_overlay(file, None, false) == {
            .Ok(bundle) -> bundle.modules.iter().flat_map(module -> module.items.iter()).any(item -> if item == { .Test(_) -> true; _ -> false })
            .Err(_) -> true
        }
    })
}
// Rust: Source/lib.rs:2842
fn item_has_contracts(item: &AST.Item) -> Bool {
    if item == {
        .Func(function) -> !function.pre.is_empty() || !function.post.is_empty()
        .Impl(implementation) -> implementation.methods.iter().any(method -> !method.pre.is_empty() || !method.post.is_empty())
        .CodeModule(module) -> module.body.as_ref().is_some_and(items -> items.iter().any(item_has_contracts))
        _ -> false
    }
}
// Rust: Source/lib.rs:2862
pub fn has_test_contracts(file: String) -> Bool {
    with_compiler_stack(() -> {
        if Loader.load_entry_with_overlay(file, None, false) == {
            .Ok(bundle) -> bundle.modules.iter().flat_map(module -> module.items.iter()).any(item_has_contracts)
            .Err(_) -> true
        }
    })
}

// Rust: Source/lib.rs:2880
pub fn coverable_functions(file: String, profile: String, setting_overrides: &[String:String]) -> [(String, USize)] {
    with_compiler_stack(() -> coverable_functions_inner(file, profile, setting_overrides))
}
// Rust: Source/lib.rs:2888
fn coverable_functions_inner(file: String, profile: String, setting_overrides: &[String:String]) -> [(String, USize)] {
    (diagnostics, checked_bundle, _) :: Driver.check_file_with_effect_facts_profile_and_settings(file, None, false, profile, setting_overrides)
    bundle :: checked_bundle.unwrap_or_else(() -> {
        detail :: diagnostics.first().map(diagnostic -> "{diagnostic.code}: {diagnostic.what}") ?? "the checked bundle was unavailable"
        panic("coverage metadata unavailable for `{file}`: {detail}")
    })
    entry :: &bundle.modules[bundle.entry]
    src :: &entry.source
    line_of :: (off: USize) -> src.bytes()[0..<off.min(src.len())].iter().filter(b -> b == 10).count() + 1
    out := []
    loop item in &entry.items {
        if item == {
            .Func(f) -> { if f.name != "run" -> out.push((~f.name, line_of(f.name_span.start))) }
            .Struct(s) -> {
                loop m in &s.methods -> out.push(("{s.name}.{m.name}", line_of(m.name_span.start)))
                loop b in &s.trait_impls {
                    loop m in &b.methods -> out.push(("{s.name}.{m.name}", line_of(m.name_span.start)))
                }
            }
            .Enum(e) -> {
                loop m in &e.methods -> out.push(("{e.name}.{m.name}", line_of(m.name_span.start)))
                loop b in &e.trait_impls {
                    loop m in &b.methods -> out.push(("{e.name}.{m.name}", line_of(m.name_span.start)))
                }
            }
            .Impl(i) -> {
                loop m in &i.methods -> out.push(("{i.type_name}.{m.name}", line_of(m.name_span.start)))
            }
            _ -> {}
        }
    }
    ^out
}

