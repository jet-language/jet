//RS 
//RS /// #2083: run the programmable build front end once, up front.
//RS ///
//RS /// `jet build` used to load and type-check its program twice — once to compute
//RS /// the native content-cache key and once to compile — and a third time to
//RS /// render the effect summary. The CLI now runs this instead: it computes the
//RS /// key from the returned bundle, renders the effect summary from the returned
//RS /// facts, and hands the value straight back to
//RS /// `compile_programmable_build_opts_with_builder_and_profile_and_settings`,
//RS /// which resumes the pipeline rather than restarting it. Because the key is
//RS /// hashed from the very bundle that is then emitted, it cannot describe a
//RS /// different program than the one compiled.
//RS ///
//RS /// The front end runs behind the same `with_compiler_stack` seam as every
//RS /// other compiler entry point, so a `comptime` binding cannot observe a
//RS /// different Core API here than it does inside the compile (D-FRONTENDAPI1=A).
//RS pub fn prepare_programmable_build_front_end(
//RS     file: &str,
//RS     locked: bool,
//RS     web_target: bool,
//RS     plugin_target: bool,
//RS     cross_target: Option<&str>,
//RS     profile: &str,
//RS     setting_overrides: &BTreeMap<String, String>,
//RS ) -> Result<Driver::PreparedBuildFrontEnd, Vec<Diagnostic>> {
//RS     prepare_programmable_build_front_end_scoped(
//RS         file,
//RS         locked,
//RS         web_target,
//RS         plugin_target,
//RS         cross_target,
//RS         profile,
//RS         setting_overrides,
//RS         true,
//RS         true,
//RS     )
//RS }
//RS 
