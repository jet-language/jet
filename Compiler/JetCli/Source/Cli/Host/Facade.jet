// Rust: Source/lib.rs:1261
fn compile_programmable_build_opts_inner(file: String, grants: &[String], no_os: Bool, gates: Policy.GateSet, locked: Bool, web_target: Bool, plugin_target: Bool, cross_target: String?, emit_generated: Bool, remote_builder: String?, profile: String, setting_overrides: &[String:String], prepared: Driver.PreparedBuildFrontEnd?, package_scope: Bool, build_override: Bool, entry_fn: String?, without_codegen: Bool, project_check: Bool, overlay: (OSPath, String)?, application_authority: &jet_foundation.Authority.ApplicationAuthority?, artifact_build: Bool) -> Driver.BuildCompileOutput [Diagnostic]! {
    with_compiler_stack(() -> {
        remote :: remote_builder.map(Comptime.Build.RemoteBuildBinding.load_host).transpose().map_err(error -> [Diagnostic.error("E3502", "remote builder binding could not be loaded: {error}", "remote endpoints and credentials come only from host-owned bindings", "run `jet remote list`, or bind the builder with `jet remote bind`", None)])
        if workspace_build_authority(file) == {
            .Val(checked_workspace) -> {
                drop(^prepared)
                return compile_workspace_build_opts(file, grants, no_os, gates, locked, web_target, plugin_target, cross_target, emit_generated, ^remote, profile, setting_overrides, package_scope, build_override, project_check, application_authority, artifact_build, ^checked_workspace)
            }
            .None -> {}
        }
        resumed := ^prepared
        if resumed.is_none() {
            resumed = Val(if overlay == {
