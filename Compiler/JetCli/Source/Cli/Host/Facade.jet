// Rust: Source/lib.rs:1097
fn attach_build_program_value(prepared: &Driver.PreparedBuildFrontEnd) -> {
    if prepared.selects_build_entry() {
        program :: Compiler.program_info_value(prepared.bundle(), prepared.effect_facts())
        prepared.set_program_value(^program)
    }
}
// Rust: Source/lib.rs:1104
fn file_selects_programmable_build(file: String) -> Bool {
    source :: fs.read_to_string(OSPath.from(file)).ok() ?? return false
    project_root :: OSPath.from(file).parent().and_then(directory -> Loader.find_package_root_checked(directory).ok().flatten())
    Driver.selects_build_entry(source, project_root.as_ref())
}

// Rust: Source/lib.rs:1118
pub fn check_programmable_build_for_tier(file: String, gates: Policy.GateSet, profile: String, setting_overrides: &[String:String]) -> Result<Void, [Diagnostic]>? {
    if !file_selects_programmable_build(file) -> return None
    Val(with_compiler_stack(() -> {
        grants :: resolve_build_grants(file, &[]).iter().filter_map(grant -> Comptime.Build.BuildCapability.parse(grant)).collect()
        prepared :: prepare_programmable_build_front_end(file, false, false, false, None, profile, setting_overrides)
        Driver.compile_bundle_path_build_with_front_end(file, Driver.BuildRunOptions{
            grants: grants, policy: production_build_policy(), execute: false, gates: gates, inspect_only: false, emit_generated: false, locked: false, no_os: false, web_target: false, plugin_target: false, cross_target: None, profile: ~profile, artifact_build: false, application_authority: None, setting_overrides: ~setting_overrides, remote: None, package_scope: true, build_override: true, entry_fn: None
        }, Val(^prepared)).map(_ -> ())
    }))
}
// Rust: Source/lib.rs:1173
pub fn check_project_build_for_tier(file: String, gates: Policy.GateSet, profile: String, setting_overrides: &[String:String], target: String?, entry_fn: String?) -> Driver.BuildCompileOutput? [Diagnostic]! {
    selects_build :: file_selects_programmable_build(file) || workspace_build_authority(file).is_some()
    if !selects_build -> return Ok(None)
    output :: compile_programmable_build_opts_inner(file, &[], false, gates, false, target == Val(Syntax.BUILD_TARGET_WEB), false, target, false, None, profile, setting_overrides, None, true, true, entry_fn, false, true, None, None, false)
    Ok(Val(^output))
}
