        entry_source :: if source_file.path.file_name().and_then(name -> name.to_str()) == Val(Syntax.PACKAGE_FILE) -> Package.build_entry_source(raw_entry_source) ?? raw_entry_source
            else -> raw_entry_source
        // Workspace CLI grants are not inherited across member authority boundaries.
        resolved_member_grants :: resolve_build_grants(entry_path, &[])
        member_grants :: resolved_member_grants.iter().filter_map(grant -> Comptime.Build.BuildCapability.parse(grant)).collect()
        entry.revalidate(&workspace_resolver).map_err(error -> [error.diagnostic()])
        options :: Driver.BuildRunOptions{
            grants: member_grants, policy: production_build_policy(), execute: !project_check, gates: gates, inspect_only: false, emit_generated: false, locked: locked, no_os: no_os, web_target: web_target, plugin_target: plugin_target, cross_target: ~cross_target, profile: ~profile, artifact_build: artifact_build, application_authority: None, setting_overrides: [:], remote: ~remote, package_scope: true, build_override: true, entry_fn: ~entry.entry_fn
        }
        output :: if project_check -> Driver.compile_bundle_path_build_as_dependency_with_overlay_for_project_check(entry_path, source_file.path, entry_source, ^options)
            else -> Driver.compile_bundle_path_build_as_dependency_with_overlay(entry_path, source_file.path, entry_source, ^options)
        if emit_generated -> export_generated_sources(entry_path, &output)
    }
    resolved_workspace_grants :: resolve_build_grants(workspace_path.to_string_lossy(), grants)
    workspace_grants :: resolved_workspace_grants.iter().filter_map(grant -> Comptime.Build.BuildCapability.parse(grant)).collect()
    // Refresh authority after intentional child mutation but retain exact selected bytes.
    workspace_root :: workspace_path.parent() ?? OSPath.from(".")
    original_workspace_source :: ~workspace_source.source
    refreshed_resolver :: Authority.AuthorityResolver.open(workspace_root).map_err(error -> [error.diagnostic()])
    refreshed_source :: refreshed_resolver.resolve_workspace_source().map_err(error -> [error.workspace_diagnostic()]) ?? return Err([Diagnostic.error("E1334", "workspace source disappeared during member builds", "workspace orchestration requires the same declared source through the root build", "restore workspace.jet and retry the build", None)])
    if refreshed_source.path != workspace_path || refreshed_source.source.as_bytes() != original_workspace_source.as_bytes() {
        return Err([Diagnostic.error("E1334", "workspace source changed during member builds", "member builds cannot replace the workspace declaration selected for orchestration", "restore workspace.jet and retry the build", None)])
    }
    refreshed_resolver.revalidate_source(&refreshed_source).map_err(error -> [error.diagnostic()])
    workspace_entry_source :: if workspace_path.file_name().and_then(name -> name.to_str()) == Val(Syntax.PACKAGE_FILE) -> Package.build_entry_source(refreshed_source.source) ?? ~refreshed_source.source
        else -> ~refreshed_source.source
    options :: Driver.BuildRunOptions{
        grants: workspace_grants, policy: production_build_policy(), execute: !project_check, gates: gates, inspect_only: false, emit_generated: false, locked: locked, no_os: no_os, web_target: web_target, plugin_target: plugin_target, cross_target: ~cross_target, profile: ~profile, artifact_build: artifact_build, application_authority: application_authority.cloned(), setting_overrides: ~setting_overrides, remote: ^remote, package_scope: package_scope, build_override: build_override, entry_fn: None
    }
    output :: if project_check -> Driver.compile_bundle_path_build_with_overlay_for_project_check(workspace_path.to_string_lossy(), refreshed_source.path, workspace_entry_source, ^options)
        else -> Driver.compile_bundle_path_build_with_overlay(workspace_path.to_string_lossy(), refreshed_source.path, workspace_entry_source, ^options)
    if emit_generated -> export_generated_sources(workspace_path.to_string_lossy(), &output)
    Ok(^output)
}

// Rust: Source/lib.rs:1625
fn export_generated_sources(file: String, output: &Driver.BuildCompileOutput) -> [Diagnostic]! {
    build :: &output.build ?? return Ok(())
    project_root :: build_project_root(file)
    export_root :: project_root.join(".jet/generated")
    exports := []
    loop generated in build.generated.iter().filter(generated -> generated.path.extension().and_then(extension -> extension.to_str()) == Val(Syntax.FILE_EXT)) {
        relative :: generated.path.strip_prefix(project_root).ok().and_then(path -> path.strip_prefix(".jet/generated").ok()) ?? return Err([Diagnostic.error("E3510", "generated module `{generated.name}` is outside the project root", "the visible export must stay inside the project that produced the generated source", "run the build from the package containing the entry file", None)])
        destination :: export_root.join(relative)
        source :: read_real_generated_file(project_root, generated.path).map_err(error -> [Diagnostic.error("E3510", "could not read generated module `{generated.name}`: {error}", "the visible export must copy the exact source that was compiled", "remove the damaged generated file and rerun the build", None)])
        exports.push((generated.name.as_str(), destination, source))
    }
    paths :: exports.iter().map((_, path, _) -> ~path)
    transaction := GeneratedExportTransaction.new(project_root, paths).map_err(error -> [Diagnostic.error("E3510", "could not prepare generated export: {error}", "the visible export must be all-or-nothing and must not alter the compiled source", "make sure `.jet/generated` is writable and the generated module name is unique", None)])
    loop (name, destination, source) in exports {
        write_exported_generated_file(project_root, destination, source).map_err(error -> [Diagnostic.error("E3510", "could not write generated module `{name}`: {error}", "the visible export must be all-or-nothing and must not alter the compiled source", "make sure `.jet/generated` is writable and the generated module name is unique", None)])
    }
    transaction.commit()
    Ok(())
}

// Rust: Source/lib.rs:1701
fn workspace_build_root_diagnostic(workspace_path: OSPath, diagnostic: &Diagnostic) -> Diagnostic {
    if diagnostic.code == "E1221" -> return ~diagnostic
    Diagnostic.error("E3503", "This root build asks for authority missing from its declaration, `#Impure` gate, or effective policy.", "workspace build policy in `{workspace_path.display()}` is present but unavailable: {diagnostic.why}", "Declare the effect, gate the ambient operation with `#Impure(\"reason\")`, and grant the effect through CLI/package/workspace policy.", None)
}

// Rust: Source/lib.rs:1724
struct GeneratedExportTransaction {
    files: [(OSPath, [U8]?)]
    project_root: OSPath
    committed: Bool
    // Rust: Source/lib.rs:1731
    fn new(project_root: OSPath, paths: Iterator<OSPath>) -> Self io.Error! {
        // GATE #4499: OSPath equality/order keys retain their native semantics.
        seen := Set<OSPath>{}
        files := []
        loop path in paths {
            if !seen.insert(~path) -> continue
            if path_has_symlinked_component(project_root, path) {
                return Err(io.Error.new(.PermissionDenied, "generated export path `{path.display()}` contains a symlink"))
            }
            // GATE #4494: native no-follow metadata and bytes, not simulated IO.
            before :: if fs.symlink_metadata(path) == {
                .Ok(metadata) -> {
                    if metadata.file_type().is_symlink() -> return Err(io.Error.new(.PermissionDenied, "generated export path `{path.display()}` is a symlink"))
                    if !metadata.is_file() -> return Err(io.Error.new(.AlreadyExists, "generated export path `{path.display()}` is not a file"))
                    Val(fs.read(path))
                }
                .Err(error) -> { if error.kind() != .NotFound -> return Err(error); None }
            }
            files.push((^path, ^before))
        }
        Ok(Self{files: ^files, project_root: ~project_root, committed: false})
    }
    // Rust: Source/lib.rs:1773
    fn commit(&self) -> { self.committed = true }
    // Rust: Source/lib.rs:1779
    fn drop(&self) -> {
        if self.committed -> return
        loop (path, before) in self.files.iter().rev() {
            if path_has_symlinked_component(self.project_root, path) -> continue
            if before == {
                .Val(bytes) -> { _ :: write_exported_generated_file(self.project_root, path, bytes) }
                .None -> {
                    // GATE #4409: errors are not mistaken for positive symlink metadata.
                    if !fs.symlink_metadata(path).is_ok_and(metadata -> metadata.file_type().is_symlink()) {
                        _ :: fs.remove_file(path)
                    }
                }
            }
        }
    }
}
