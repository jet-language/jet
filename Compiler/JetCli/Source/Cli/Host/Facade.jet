// Rust: Source/lib.rs:349
pub fn check_with_path_and_settings(file: String, setting_overrides: &[String:String]) -> [Diagnostic] {
    with_compiler_stack(() -> {
        if check_workspace_file(file) == { .Val(diagnostics) -> return ^diagnostics; .None -> {} }
        if !setting_overrides.is_empty() -> return Driver.check_file_with_effect_facts_and_settings(file, None, false, setting_overrides).0
        queries := jet_driver.QueryService.CompilerQueries.new()
        ~queries.check_disk(file, false).diagnostics
    })
}
// Rust: Source/lib.rs:374
fn check_workspace_file(file: String) -> [Diagnostic]? {
    path :: absolute_source_path(file)
    root :: path.parent() ?? OSPath.from(".")
    resolver :: if Authority.AuthorityResolver.open(root) == {
        .Ok(resolver) -> ^resolver
        .Err(error) -> { if error.is_missing() -> return None; return Val([error.diagnostic()]) }
    }
    source :: if resolver.resolve_workspace_source() == {
        .Ok(.Val(source)) -> ^source
        .Ok(.None) -> return None
        .Err(error) -> return Val([error.workspace_diagnostic()])
    }
    entry_name :: path.file_name() ?? return None
    if source.path != resolver.root().join(entry_name) -> return None
    if WorkspaceFile.evaluate_checked_source(&source, &resolver) == { .Ok(_) -> Val([]); .Err(diagnostic) -> Val([diagnostic]) }
}
