// Rust: Source/lib.rs:223
pub fn run_compiler_work<R: Send>(work: fn() -> R) -> R {
    // GATE #4494: function pointer identity and unwind-restoring ambient scope.
    if Comptime.ambient_hooks().0.is_some_and(hook -> hook.address() == Compiler.eval_core_call_with_type.address()) {
        return jet_driver.run_compiler_work(^work)
    }
    Comptime.with_ambient(Val(Compiler.eval_core_call_with_type), None, None, () -> jet_driver.run_compiler_work(^work))
}
// Rust: Source/lib.rs:242
pub fn with_compiler_stack<R: Send>(work: fn() -> R) -> R { run_compiler_work(^work) }

