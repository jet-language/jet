pub struct CheckedMirSnapshot {
    pub bundle: AST.ProgramBundle
    pub facts: Sema.SemIndexEffectFacts
    pub mir: MIR.MirProgram
    pub artifact: MIR.MirArtifactId
}
// Rust: Source/lib.rs:258
pub fn lower_checked_semantic_mir_program_for(bundle: &AST.ProgramBundle, request: MIR.MirArtifactRequest) -> (MIR.MirProgram, MIR.MirArtifactId) {
    (mir, artifact) :: Codegen.TIR.lower_checked_mir_program_for(bundle, request).unwrap_or_else(error -> jet_foundation.ice(Val(error.span), "{error}"))
    mir.validate().unwrap_or_else(error -> jet_foundation.ice(None, "canonical MIR validation failed: {error}"))
    (^mir, artifact)
}
