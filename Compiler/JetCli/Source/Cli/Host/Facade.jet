fn compile_workspace_build_opts(file: String, grants: &[String], no_os: Bool, gates: Policy.GateSet, locked: Bool, web_target: Bool, plugin_target: Bool, cross_target: String?, emit_generated: Bool, remote: Comptime.Build.RemoteBuildBinding?, profile: String, setting_overrides: &[String:String], package_scope: Bool, build_override: Bool, project_check: Bool, application_authority: &jet_foundation.Authority.ApplicationAuthority?, artifact_build: Bool, checked_workspace: (Authority.AuthorityResolver, WorkspaceFile.WorkspaceSource)) -> Driver.BuildCompileOutput [Diagnostic]! {
