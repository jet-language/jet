// Rust `Term::Key` (crates/jet-repl/src/Term.rs:233-267). Decoded events only:
// the shared Tools/REPL terminal host owns byte decoding and raw-mode lifetime.
// Char is one Unicode scalar, never a byte fragment or pasted string.
pub enum JetCLITermKey {
    Char(Char)
    Enter
    Backspace
    Delete
    Tab
    Escape
    EscapeEnter
    Left
    Right
    Up
    Down
    Home
    End
    F1
    F3
    CtrlB
    CtrlP
    CtrlF
    CtrlR
    CtrlC
    EOF
    Unknown
    Idle
}
