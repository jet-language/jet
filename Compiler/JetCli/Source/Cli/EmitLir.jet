// `jet emit --lir <file>`: the LIR `jet build` lowers for the entry (before
// the LIR passes of its optimization level),
// printed for the functions an emit selects. Module-wide function, signature
// and data ids are renumbered in order of first use by those functions
// (LIR/Print.jet `LIRPrintIds`), so the dump does not change when unrelated
// Core functions do. A function the selection calls but does not show is
// listed as `declare fN name`.
use core.files as cli_files
use jet_backend.[
    LIRFunction,
    LIRInst,
    LIRModule,
    LIRPrintIds,
    LIRTerminator,
    lir_print_block_head_ids,
    lir_print_data_ids,
    lir_print_function_head_ids,
    lir_print_inst_ids,
    lir_print_ids,
    lir_print_reloc_ids,
    lir_print_signature,
    lir_print_terminator,
]
use jet_foundation.[MIRProgram]

// A module-wide id's printed number, assigned on first use.
struct JetCLIEmitLirNumbering {
    numbers: [Int:Int]
    order: [Int]
    base: Int
}

fn jet_cli_emit_lir_numbering(base: Int) -> JetCLIEmitLirNumbering Never! {
    JetCLIEmitLirNumbering{numbers: [Int:Int]{}, order: [Int]{}, base: base}
}

fn jet_cli_emit_lir_note(numbering: &JetCLIEmitLirNumbering, id: Int) Never! {
    if numbering.numbers.get(id) != None -> return
    _ := &numbering.numbers.add(id, numbering.base + numbering.order.len())
    &numbering.order.push(id)
}

// The functions of `lir` named by `keys` (a function key, or a lambda under
// it), or with no keys every function of `package`.
fn jet_cli_emit_lir_shown(lir: LIRModule, package: String, keys: [String]?) -> [Bool] Never! {
    marker :: "module:{package.len()}:{package}:"
    loop function in lir.functions -> jet_cli_emit_lir_selects(function.name, marker, keys)
}

fn jet_cli_emit_lir_selects(name: String, marker: String, keys: [String]?) -> Bool Never! {
    selected :: keys ?? return name.contains(marker)
    loop key in selected {
        if name == key || name.starts_with("{key}::") -> return true
    }
    false
}

fn jet_cli_emit_lir_nodes(lir: LIRModule, shown: [Bool]) -> [JetCLIEmitNode] Never! {
    shown_count := 0
    shown_numbers := [Int:Int]{}
    loop (index, function) in lir.functions {
        if !shown[index] -> next
        _ := &shown_numbers.add(function.id.value, shown_count)
        shown_count += 1
    }
    functions := jet_cli_emit_lir_numbering(shown_count)
    signatures := jet_cli_emit_lir_numbering(0)
    data := jet_cli_emit_lir_numbering(0)
    loop (index, function) in lir.functions {
        if !shown[index] -> next
        jet_cli_emit_lir_note(&signatures, function.signature.value)
        loop value in function.values {
            if value.drop == .Function(glue) {
                if shown_numbers.get(glue.value) == None -> jet_cli_emit_lir_note(&functions, glue.value)
            }
        }
        loop block in function.blocks {
            loop inst in block.insts -> jet_cli_emit_lir_note_inst(inst, shown_numbers, &functions, &signatures, &data)
        }
    }
    // Relocations name further data, in the order they are reached.
    cursor := 0
    loop cursor < data.order.len() {
        targets :: jet_cli_emit_lir_reloc_targets(lir, data.order[cursor])
        loop target in targets -> jet_cli_emit_lir_note(&data, target)
        cursor += 1
    }
    all_functions := shown_numbers
    loop (position, id) in functions.order -> _ := &all_functions.add(id, shown_count + position)
    ids :: LIRPrintIds{functions: all_functions, signatures: signatures.numbers, data: data.numbers}
    nodes := [JetCLIEmitNode]{}
    loop id in data.order {
        if id < 0 || id >= lir.data.len() -> next
        row :: lir.data[id]
        relocs :: loop reloc in row.relocs -> jet_cli_emit_leaf("reloc", lir_print_reloc_ids(reloc, ids))
        &nodes.push(jet_cli_emit_node("data", lir_print_data_ids(row, ids), relocs))
    }
    loop (position, id) in signatures.order {
        loop signature in lir.signatures {
            if signature.id.value == id -> &nodes.push(jet_cli_emit_leaf("signature", "sig s{position} = {lir_print_signature(signature)}"))
        }
    }
    loop (position, id) in functions.order {
        name :: if id >= 0 && id < lir.functions.len() -> lir.functions[id].name else -> "?"
        &nodes.push(jet_cli_emit_leaf("declare", "declare f{shown_count + position} {name}"))
    }
    loop (index, function) in lir.functions {
        if !shown[index] -> next
        &nodes.push(jet_cli_emit_lir_function(function, ids))
    }
    nodes
}

// The data ids the relocations of data `id` name.
fn jet_cli_emit_lir_reloc_targets(lir: LIRModule, id: Int) -> [Int] Never! {
    if id < 0 || id >= lir.data.len() -> return [Int]{}
    loop reloc in lir.data[id].relocs -> reloc.target.value
}

fn jet_cli_emit_lir_note_inst(inst: LIRInst, shown: [Int:Int], functions: &JetCLIEmitLirNumbering, signatures: &JetCLIEmitLirNumbering, data: &JetCLIEmitLirNumbering) Never! {
    if inst == {
        .Call(_, signature, callee, _) -> {
            if callee == .Function(target) {
                if shown.get(target.value) == None -> jet_cli_emit_lir_note(&functions, target.value)
            }
            jet_cli_emit_lir_note(&signatures, signature.value)
        }
        .FunctionAddress(_, target) -> {
            if shown.get(target.value) == None -> jet_cli_emit_lir_note(&functions, target.value)
        }
        .DataAddress(_, row) -> jet_cli_emit_lir_note(&data, row.value)
        else -> {}
    }
}

fn jet_cli_emit_lir_function(function: LIRFunction, ids: LIRPrintIds) -> JetCLIEmitNode Never! {
    blocks :: loop block in function.blocks -> jet_cli_emit_node("block", lir_print_block_head_ids(function, block, ids), jet_cli_emit_lir_block_rows(function, block.insts, block.terminator, ids))
    jet_cli_emit_node("function", lir_print_function_head_ids(function, ids), blocks)
}

fn jet_cli_emit_lir_block_rows(function: LIRFunction, insts: [LIRInst], terminator: LIRTerminator, ids: LIRPrintIds) -> [JetCLIEmitNode] Never! {
    rows := [JetCLIEmitNode]{}
    loop inst in insts -> &rows.push(jet_cli_emit_leaf("instruction", lir_print_inst_ids(function, inst, ids)))
    &rows.push(jet_cli_emit_leaf("terminator", lir_print_terminator(terminator)))
    rows
}

// A fault dump covers the first functions the first report rows name, so a
// failing self-host build stays bounded.
JET_CLI_EMIT_FAULT_DUMP_FUNCTIONS :: 8
JET_CLI_EMIT_FAULT_DUMP_ROWS :: 64

// The faulting functions a native build report names, written as their
// `jet emit --mir` and `jet emit --lir` text beside the build output:
// `<directory>/<n>.mir` and `<n>.lir`, numbered in report order. A row names
// a function by its LIR name (the MIR key): the whole row, or a word of it.
// The directory, or None when no row names a function or a write fails.
fn jet_cli_emit_fault_dump(program: MIRProgram, lir: LIRModule, rows: [String], directory: String) -[FS]> String? Never! {
    names := [String]{}
    loop (position, row) in rows {
        if position >= JET_CLI_EMIT_FAULT_DUMP_ROWS || names.len() >= JET_CLI_EMIT_FAULT_DUMP_FUNCTIONS -> break
        loop function in lir.functions {
            if (row == function.name || row.contains("{function.name} ")) && !names.contains(function.name) {
                &names.push(function.name)
                break
            }
        }
    }
    if names.len() == 0 -> return None
    cli_files.create_dir_all(directory) ?? return None
    mir_names :: jet_cli_emit_mir_names(program)
    loop (index, name) in names {
        functions := [JetCLIEmitNode]{}
        loop function in program.functions {
            if function.key == name -> &functions.push(jet_cli_emit_mir_function(program, mir_names, function))
        }
        if functions.len() > 0 {
            cli_files.write("{directory}/{index}.mir", jet_cli_emit_tree_text(functions)) ?? return None
        }
        shown :: loop function in lir.functions -> function.name == name
        cli_files.write("{directory}/{index}.lir", jet_cli_emit_tree_text(jet_cli_emit_lir_nodes(lir, shown))) ?? return None
    }
    Val(directory)
}

// An object fault's dump: one failing function's final LIR, written as
// `<directory>/<index>.lir` the way jet_cli_emit_fault_dump writes it. The
// per-function object jobs hand back the functions that failed
// (X64ObjectOutcome.faults), and jet_cli_native_back writes them here; the
// MIR is released before the object compile and the module is consumed by
// it. Without the module, module-wide ids print as themselves. The
// directory, or None when a write fails.
fn jet_cli_emit_fault_lir(function: LIRFunction, index: Int, directory: String) -[FS]> String? Never! {
    cli_files.create_dir_all(directory) ?? return None
    cli_files.write("{directory}/{index}.lir", jet_cli_emit_tree_text([JetCLIEmitNode]{jet_cli_emit_lir_function(function, lir_print_ids())})) ?? return None
    Val(directory)
}
