// The Rust original fix projections shared by CLI fixes and code actions.
use {
    jet_foundation.[Diagnostic, DiagnosticFixApplicability, DiagnosticFixSafety, TextEdit]
    jet_driver.[jet_driver_apply_edits]
}

JetCLIFix: struct {
    title: String
    edit: TextEdit
    applicability: DiagnosticFixApplicability
    safety: DiagnosticFixSafety
}

JetCLIFixApply: struct {
    source: String
    applied: Int
    deferred: Int
}

// A fix `jet fix` did not apply (FixCommands.jet), and why: one that needs
// review (`--all` applies it), or one whose edited file no longer checks.
// The fix log records each (jet_cli_fix_log).
JetCLIFixSkip: struct {
    title: String
    edit: TextEdit
    reason: String
}

// `jet fix` applies a diagnostic's primary edit; its alternative edits are
// the other choices an editor offers as code actions.
jet_cli_fixes_from_diagnostics: fn(diagnostics: [Diagnostic]) -> [JetCLIFix] Never! {
    fixes := [JetCLIFix]{}
    loop diagnostic in diagnostics {
        applicability: diagnostic.applicability ?? next
        safety: diagnostic.safety ?? next
        if diagnostic.edit == .Val(edit) {
            fixes.push(JetCLIFix{title: diagnostic.fix, edit: edit, applicability: applicability, safety: safety})
        }
    }
    fixes
}

jet_cli_collect_fixes_from_diagnostics: fn(diagnostics: [Diagnostic], source: String) -> [JetCLIFix] Never! {
    fixes := jet_cli_fixes_from_diagnostics(diagnostics)
    fixes
}

jet_cli_safe_fixes: fn(fixes: [JetCLIFix]) -> [JetCLIFix] Never! {
    selected := [JetCLIFix]{}
    loop fix in fixes {
        if fix.applicability == .Safe && (fix.safety == .Formatting || fix.safety == .BehaviorPreserving) {
            selected.push(fix)
        }
    }
    selected
}

jet_cli_fix_apply_non_overlapping: fn(source: String, fixes: [JetCLIFix]) -> JetCLIFixApply Never! {
    order := [Int]{}
    loop index in 0..<fixes.len() -> order.push(index)
    width := 1
    loop width < order.len() {
        merged := [Int]{}
        start := 0
        loop start < order.len() {
            middle: if start + width < order.len() -> start + width else -> order.len()
            end: if start + width * 2 < order.len() -> start + width * 2 else -> order.len()
            left := start
            right := middle
            loop left < middle || right < end {
                take_left := right >= end
                if !take_left && left < middle {
                    a: fixes[order[left]].edit.span
                    b: fixes[order[right]].edit.span
                    take_left = a.start < b.start || (a.start == b.start && a.end >= b.end)
                }
                if take_left {
                    merged.push(order[left])
                    left += 1
                } else {
                    merged.push(order[right])
                    right += 1
                }
            }
            start = end
        }
        order = merged
        width *= 2
    }
    kept := [TextEdit]{}
    deferred := 0
    previous := TextEdit?{None}
    loop index in order {
        edit: fixes[index].edit
        if previous == .Val(last) {
            if last.span.start == edit.span.start && last.span.end == edit.span.end && last.new_text == edit.new_text {
                next
            }
        }
        previous = Val(edit)
        if kept.len() > 0 && edit.span.start < kept[kept.len() - 1].span.end {
            deferred += 1
            next
        }
        kept.push(edit)
    }
    applied: kept.len()
    updated: if jet_driver_apply_edits(source, kept) == {
        .Ok(text) -> text
        .Err(_) -> source
    }
    JetCLIFixApply{source: updated, applied: applied, deferred: deferred}
}
