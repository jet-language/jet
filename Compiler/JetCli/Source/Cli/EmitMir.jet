// `jet emit --mir <file>`: the checked MIR of the entry package as EmitTree
// nodes, one `fn` node per function. Every function numbers its own values
// (`v0`), blocks (`b0`), places (`p0`), locals (`l0`) and scopes (`s0`) in
// declaration order, so a dump does not depend on the stable hashes MIR uses
// as ids. Each value shows its checked type and ownership mode where it is
// defined; operands name values, places, fields, types and callees.
use jet_backend.[lower_prelude_positions, lower_route_name, lower_semantic_name]
use jet_foundation.[
    MIRAccess,
    MIRBinaryOp,
    MIRBlockID,
    MIRCallArg,
    MIRCallee,
    MIRConstant,
    MIRCoreCallID,
    MIREnumArg,
    MIRFieldID,
    MIRFieldValue,
    MIRForeignID,
    MIRFunction,
    MIRFunctionID,
    MIRInstruction,
    MIROperation,
    MIROwnershipMode,
    MIRPayloadKind,
    MIRPlace,
    MIRPlaceID,
    MIRProgram,
    MIRProjection,
    MIRScopeKind,
    MIRStringPart,
    MIRTerminator,
    MIRTypeID,
    MIRUnaryOp,
    MIRValueID,
    mir_operation_value_uses,
    mir_semantic_op_value_uses,
    mir_type_display_name,
]

// Program-wide names for the ids instructions carry; `routes` is the
// program's Prelude position index the backend names routes through.
struct JetCLIEmitMIRNames {
    functions: [U64:String]
    types: [U64:String]
    fields: [U64:String]
    routes: [U64:Int]
}

// One function's printed numbering of its own ids.
struct JetCLIEmitMIRIds {
    values: [U64:Int]
    blocks: [U64:Int]
    places: [U64:Int]
    locals: [U64:Int]
    scopes: [U64:Int]
}

// The `function:` key prefix of every function declared in `package`
// (jet_driver_module_identity under the package identity).
fn jet_cli_emit_package_prefix(package: String) -> String Never! {
    "function:module:{package.len()}:{package}:"
}

// The functions an emit prints: with `function`, those named so (functions
// of the entry package first; another package's only when the entry package
// has none); otherwise every function the entry package declares.
fn jet_cli_emit_mir_selected(program: MIRProgram, package: String, function: String?) -> [MIRFunction] Never! {
    prefix :: jet_cli_emit_package_prefix(package)
    selected := [MIRFunction]{}
    name :: function ?? {
        loop candidate in program.functions {
            if candidate.key.starts_with(prefix) -> &selected.push(candidate)
        }
        return selected
    }
    others := [MIRFunction]{}
    loop candidate in program.functions {
        if !jet_cli_emit_mir_named(candidate, name) -> next
        if candidate.key.starts_with(prefix) -> &selected.push(candidate) else -> &others.push(candidate)
    }
    if selected.len() == 0 -> return others
    selected
}

// `name` is the function's own name or the last segment of its key
// (`Type:method`, `module::function`).
fn jet_cli_emit_mir_named(function: MIRFunction, name: String) -> Bool Never! {
    function.name == name || function.key.ends_with("::{name}") || function.key.ends_with(":{name}")
}

fn jet_cli_emit_mir_names(program: MIRProgram) -> JetCLIEmitMIRNames Never! {
    names := JetCLIEmitMIRNames{functions: [U64:String]{}, types: [U64:String]{}, fields: [U64:String]{}, routes: lower_prelude_positions(program)}
    loop function in program.functions -> _ := &names.functions.add(function.id.value, function.name)
    loop definition in program.types {
        _ := &names.types.add(definition.id.value, definition.name)
        if definition.kind == .Struct(fields, _) {
            loop field in fields -> _ := &names.fields.add(field.id.value, field.name)
        }
    }
    loop row in program.fields -> _ := &names.fields.add(row.id.value, row.field.name)
    names
}

fn jet_cli_emit_mir_ids(function: MIRFunction) -> JetCLIEmitMIRIds Never! {
    ids := JetCLIEmitMIRIds{values: [U64:Int]{}, blocks: [U64:Int]{}, places: [U64:Int]{}, locals: [U64:Int]{}, scopes: [U64:Int]{}}
    loop (index, value) in function.values -> _ := &ids.values.add(value.id.value, index)
    loop (index, block) in function.blocks -> _ := &ids.blocks.add(block.id.value, index)
    loop (index, place) in function.places -> _ := &ids.places.add(place.id.value, index)
    loop (index, local) in function.locals -> _ := &ids.locals.add(local.id.value, index)
    loop (index, scope) in function.scopes -> _ := &ids.scopes.add(scope.id.value, index)
    ids
}

// An id the function does not declare keeps its raw value after `?`.
fn jet_cli_emit_mir_short(numbering: [U64:Int], prefix: String, raw: U64) -> String Never! {
    index :: numbering.get(raw) ?? return "{prefix}?{raw}"
    "{prefix}{index}"
}

fn jet_cli_emit_mir_value(ids: JetCLIEmitMIRIds, value: MIRValueID) -> String Never! { jet_cli_emit_mir_short(ids.values, "v", value.value) }
fn jet_cli_emit_mir_block(ids: JetCLIEmitMIRIds, block: MIRBlockID) -> String Never! { jet_cli_emit_mir_short(ids.blocks, "b", block.value) }
fn jet_cli_emit_mir_place(ids: JetCLIEmitMIRIds, place: MIRPlaceID) -> String Never! { jet_cli_emit_mir_short(ids.places, "p", place.value) }

fn jet_cli_emit_mir_values(ids: JetCLIEmitMIRIds, values: [MIRValueID]) -> String Never! {
    names :: loop value in values -> jet_cli_emit_mir_value(ids, value)
    names.join(", ")
}

fn jet_cli_emit_mir_type_name(names: JetCLIEmitMIRNames, id: MIRTypeID) -> String Never! {
    names.types.get(id.value) ?? "type?{id.value}"
}

fn jet_cli_emit_mir_field_name(names: JetCLIEmitMIRNames, id: MIRFieldID) -> String Never! {
    names.fields.get(id.value) ?? "field?{id.value}"
}

fn jet_cli_emit_mir_function_name(names: JetCLIEmitMIRNames, id: MIRFunctionID) -> String Never! {
    names.functions.get(id.value) ?? "fn?{id.value}"
}

fn jet_cli_emit_mir_mode(mode: MIROwnershipMode) -> String Never! {
    if mode == {
        .Copy -> "copy"
        .Owned -> "owned"
        .Shared -> "shared"
        .ReadBorrow -> "read-borrow"
        .WriteBorrow -> "write-borrow"
        .Move -> "move"
    }
}

fn jet_cli_emit_mir_access(access: MIRAccess) -> String Never! {
    if access == {
        .Read -> ""
        .Write -> "&"
        .Move -> "^"
    }
}

// The `fn` nodes of `functions`.
fn jet_cli_emit_mir_nodes(program: MIRProgram, functions: [MIRFunction]) -> [JetCLIEmitNode] Never! {
    names :: jet_cli_emit_mir_names(program)
    loop function in functions -> jet_cli_emit_mir_function(program, names, function)
}

fn jet_cli_emit_mir_function(program: MIRProgram, names: JetCLIEmitMIRNames, function: MIRFunction) -> JetCLIEmitNode Never! {
    ids :: jet_cli_emit_mir_ids(function)
    params :: loop param in function.params -> "{jet_cli_emit_mir_access(param.access)}{param.name}: {mir_type_display_name(param.ty)}"
    children := [JetCLIEmitNode]{}
    loop (index, local) in function.locals {
        mutable :: if local.mutable -> "mut " else -> ""
        &children.push(jet_cli_emit_leaf("local", "local l{index} {mutable}{local.name}: {mir_type_display_name(local.ty)} [{jet_cli_emit_mir_mode(local.ownership.mode)}] at {jet_cli_emit_mir_place(ids, local.place)}"))
    }
    loop (index, place) in function.places {
        &children.push(jet_cli_emit_leaf("place", "place p{index} = {jet_cli_emit_mir_place_text(names, ids, place)}: {mir_type_display_name(place.ty)}"))
    }
    loop (index, scope) in function.scopes {
        label :: if scope.name == .Val(written) -> " {written}" else -> ""
        &children.push(jet_cli_emit_leaf("scope", "scope s{index} {jet_cli_emit_mir_scope_kind(scope.kind)}{label}"))
    }
    loop (index, block) in function.blocks {
        entry :: if block.id == function.entry -> " (entry)" else -> ""
        rows := [JetCLIEmitNode]{}
        loop instruction in block.instructions -> &rows.push(jet_cli_emit_leaf("instruction", jet_cli_emit_mir_instruction(program, names, ids, function, instruction)))
        &rows.push(jet_cli_emit_leaf("terminator", jet_cli_emit_mir_terminator(ids, block.terminator)))
        &children.push(jet_cli_emit_node("block", "b{index}{entry}:", rows))
    }
    jet_cli_emit_node("function", "fn {function.name}({params.join(", ")}) -> {mir_type_display_name(function.return_type)}", children)
}

fn jet_cli_emit_mir_scope_kind(kind: MIRScopeKind) -> String Never! {
    if kind == {
        .Unsafe -> "unsafe"
        .Impure -> "impure"
        .Reactive -> "reactive"
        .Shield -> "shield"
        .StopCleanup -> "stop-cleanup"
        .Region -> "region"
        .Policy -> "policy"
        .TaskGroup -> "task-group"
        .Layout -> "layout"
        .Authority -> "authority"
        .Context -> "context"
        .Live -> "live"
        .AssumeDeterministic -> "assume-deterministic"
        .Transaction -> "transaction"
        .ScopeMember -> "scope-member"
        .DebugOnly -> "debug-only"
    }
}

fn jet_cli_emit_mir_place_text(names: JetCLIEmitMIRNames, ids: JetCLIEmitMIRIds, place: MIRPlace) -> String Never! {
    base :: if place.base == {
        .Local(local) -> jet_cli_emit_mir_short(ids.locals, "l", local.value)
        .Parameter(value) -> "param {jet_cli_emit_mir_value(ids, value)}"
        .Capture(value) -> "capture {jet_cli_emit_mir_value(ids, value)}"
        .Temporary(value) -> "temp {jet_cli_emit_mir_value(ids, value)}"
        .Static(name) -> "static {name}"
    }
    projected :: loop projection in place.projections -> jet_cli_emit_mir_projection(names, ids, projection)
    "{base}{projected.join("")}"
}

fn jet_cli_emit_mir_projection(names: JetCLIEmitMIRNames, ids: JetCLIEmitMIRIds, projection: MIRProjection) -> String Never! {
    if projection == {
        .Field(field, _) -> ".{jet_cli_emit_mir_field_name(names, field)}"
        .Index(_, index, _, _, _, _, _) -> "[{jet_cli_emit_mir_value(ids, index)}]"
        .Deref(_) -> ".*"
        .Payload(kind, _) -> jet_cli_emit_mir_payload(names, kind)
        .Range(range, _, _) -> "[range {jet_cli_emit_mir_value(ids, range)}]"
        .MapLookup(lookup, optional, _) -> if optional -> "[lookup? {jet_cli_emit_mir_value(ids, lookup)}]" else -> "[lookup {jet_cli_emit_mir_value(ids, lookup)}]"
    }
}

// `v3: Int [owned] = <operation>`, or the operation alone without a result.
fn jet_cli_emit_mir_instruction(program: MIRProgram, names: JetCLIEmitMIRNames, ids: JetCLIEmitMIRIds, function: MIRFunction, instruction: MIRInstruction) -> String Never! {
    operation :: jet_cli_emit_mir_operation(program, names, ids, instruction.operation)
    result :: instruction.result ?? return operation
    index :: ids.values.get(result.value) ?? return "{jet_cli_emit_mir_value(ids, result)} = {operation}"
    fact :: function.values[index]
    ty :: instruction.ty ?? fact.ty
    "v{index}: {mir_type_display_name(ty)} [{jet_cli_emit_mir_mode(fact.ownership.mode)}] = {operation}"
}

fn jet_cli_emit_mir_args(ids: JetCLIEmitMIRIds, args: [MIRCallArg]) -> String Never! {
    texts :: loop arg in args -> jet_cli_emit_mir_arg(ids, arg)
    texts.join(", ")
}

fn jet_cli_emit_mir_arg(ids: JetCLIEmitMIRIds, arg: MIRCallArg) -> String Never! {
    value :: "{jet_cli_emit_mir_access(arg.access)}{jet_cli_emit_mir_value(ids, arg.value)}"
    label :: arg.label ?? return value
    "{label}: {value}"
}

fn jet_cli_emit_mir_callee(program: MIRProgram, names: JetCLIEmitMIRNames, ids: JetCLIEmitMIRIds, callee: MIRCallee) -> String Never! {
    if callee == {
        .User(id) -> jet_cli_emit_mir_function_name(names, id)
        .Associated(id, owner) -> "{mir_type_display_name(owner)}.{jet_cli_emit_mir_function_name(names, id)}"
        .TraitMethod(_, trait_ref, receiver) -> "{trait_ref.name} on {mir_type_display_name(receiver)}"
        .Method(id, owner) -> "{mir_type_display_name(owner)}.{jet_cli_emit_mir_function_name(names, id)}"
        .Core(call) -> "core {jet_cli_emit_mir_core_name(program, call)}"
        .Prelude(call) -> "prelude {lower_route_name(program, names.routes, call)}"
        .Foreign(id) -> "foreign {jet_cli_emit_mir_foreign_name(program, id)}"
        .Indirect(value) -> "*{jet_cli_emit_mir_value(ids, value)}"
    }
}

fn jet_cli_emit_mir_core_name(program: MIRProgram, call: MIRCoreCallID) -> String Never! {
    loop row in program.core_calls {
        if row.id == call -> return "{row.module_name}.{row.member}"
    }
    "?"
}

fn jet_cli_emit_mir_foreign_name(program: MIRProgram, id: MIRForeignID) -> String Never! {
    loop row in program.foreign {
        if row.id == id -> return row.name
    }
    "?"
}

fn jet_cli_emit_mir_field_values(names: JetCLIEmitMIRNames, ids: JetCLIEmitMIRIds, fields: [MIRFieldValue]) -> String Never! {
    texts :: loop field in fields -> "{jet_cli_emit_mir_field_name(names, field.field)}: {jet_cli_emit_mir_value(ids, field.value)}"
    texts.join(", ")
}

fn jet_cli_emit_mir_enum_arg(names: JetCLIEmitMIRNames, ids: JetCLIEmitMIRIds, arg: MIREnumArg) -> String Never! {
    value :: jet_cli_emit_mir_value(ids, arg.value)
    field :: arg.field ?? return value
    "{jet_cli_emit_mir_field_name(names, field)}: {value}"
}

fn jet_cli_emit_mir_string_part(ids: JetCLIEmitMIRIds, part: MIRStringPart) -> String Never! {
    if part.kind == {
        .Literal(text) -> jet_cli_debug_quote(text)
        .Interpolation(value, _) -> jet_cli_emit_mir_value(ids, value)
    }
}

fn jet_cli_emit_mir_optional(ids: JetCLIEmitMIRIds, label: String, value: MIRValueID?) -> String Never! {
    present :: value ?? return ""
    " {label} {jet_cli_emit_mir_value(ids, present)}"
}

fn jet_cli_emit_mir_binary(op: MIRBinaryOp) -> String Never! {
    if op == {
        .Add -> "add"
        .Sub -> "sub"
        .Mul -> "mul"
        .Div -> "div"
        .FloorDiv -> "floor-div"
        .Mod -> "mod"
        .Rem -> "rem"
        .Pow -> "pow"
        .BitAnd -> "bit-and"
        .BitOr -> "bit-or"
        .BitXor -> "bit-xor"
        .Shl -> "shl"
        .Shr -> "shr"
        .Eq -> "eq"
        .Ne -> "ne"
        .Lt -> "lt"
        .Gt -> "gt"
        .Le -> "le"
        .Ge -> "ge"
        .Compare -> "compare"
        .And -> "and"
        .Or -> "or"
    }
}

fn jet_cli_emit_mir_constant(constant: MIRConstant) -> String Never! {
    if constant == {
        .Int(value, _, spelling) -> spelling ?? "{value}"
        .Float(value, _, spelling) -> spelling ?? "{value}"
        .Bool(value) -> if value -> "true" else -> "false"
        .Char(value) -> "char {value}"
        .String(value) -> jet_cli_debug_quote(value)
        .Bytes(value) -> "bytes({value.len()})"
        .Unit -> "()"
        .SharedSite(_) -> "shared-site"
        .BigInt(decimal) -> decimal
        .List(values) -> {
            texts :: loop value in values -> jet_cli_emit_mir_constant(value)
            "[{texts.join(", ")}]"
        }
        .Map(entries) -> "map({entries.len()})"
        .Struct(owner, fields) -> {
            texts :: loop field in fields -> "{field.name}: {jet_cli_emit_mir_constant(field.value)}"
            jet_cli_emit_mir_braced(owner, texts.join(", "))
        }
        .Enum(owner, variant, args) -> {
            texts :: loop arg in args -> jet_cli_emit_mir_constant(arg.value)
            "{owner}.{variant}({texts.join(", ")})"
        }
        .Present(value) -> "Val({jet_cli_emit_mir_constant(value)})"
        .Failed(_) -> "failed"
    }
}

fn jet_cli_emit_mir_operation(program: MIRProgram, names: JetCLIEmitMIRNames, ids: JetCLIEmitMIRIds, operation: MIROperation) -> String Never! {
    if operation == {
        .Parameter(index, name) -> "param {index} {name}"
        .Capture(slot) -> "capture {slot}"
        .Global(name) -> "global {name}"
        .Phi(incoming) -> {
            rows :: loop row in incoming -> "{jet_cli_emit_mir_block(ids, row.block)}: {jet_cli_emit_mir_value(ids, row.value)}"
            "phi [{rows.join(", ")}]"
        }
        .ReadPlace(place) -> "read {jet_cli_emit_mir_place(ids, place)}"
        .MovePlace(place) -> "move-out {jet_cli_emit_mir_place(ids, place)}"
        .WritePlace(place, value) -> "write {jet_cli_emit_mir_place(ids, place)} <- {jet_cli_emit_mir_value(ids, value)}"
        .ReplacePlace(place, value) -> "replace {jet_cli_emit_mir_place(ids, place)} <- {jet_cli_emit_mir_value(ids, value)}"
        .InitializeUninit(place) -> "init-uninit {jet_cli_emit_mir_place(ids, place)}"
        .Copy(value, _) -> "copy {jet_cli_emit_mir_value(ids, value)}"
        .Move(value) -> "move {jet_cli_emit_mir_value(ids, value)}"
        .Constant(value) -> "const {jet_cli_emit_mir_constant(value)}"
        .Unary(op, value) -> "{jet_cli_emit_mir_unary(op)} {jet_cli_emit_mir_value(ids, value)}"
        .Binary(op, _, overflow, left, right) -> {
            trap :: if overflow == .Trap -> " trap" else -> ""
            "{jet_cli_emit_mir_binary(op)}{trap} {jet_cli_emit_mir_value(ids, left)}, {jet_cli_emit_mir_value(ids, right)}"
        }
        .BuildString(parts) -> {
            texts :: loop part in parts -> jet_cli_emit_mir_string_part(ids, part)
            "string [{texts.join(", ")}]"
        }
        .BuildList(values, _) -> "list [{jet_cli_emit_mir_values(ids, values)}]"
        .BuildMap(entries) -> {
            texts :: loop entry in entries -> "{jet_cli_emit_mir_value(ids, entry.key)}: {jet_cli_emit_mir_value(ids, entry.value)}"
            "map [{texts.join(", ")}]"
        }
        .MapLookup(map, key, cache) -> "map-lookup {jet_cli_emit_mir_place(ids, map)}[{jet_cli_emit_mir_value(ids, key)}] cache {jet_cli_emit_mir_place(ids, cache)}"
        .EnumIs(subject, owner, variant) -> "is {jet_cli_emit_mir_value(ids, subject)} {jet_cli_emit_mir_type_name(names, owner)}.{variant}"
        .EnumPayload(subject, owner, variant, index) -> "payload {jet_cli_emit_mir_value(ids, subject)} {jet_cli_emit_mir_type_name(names, owner)}.{variant}.{index}"
        .OptionIsSome(subject) -> "is-present {jet_cli_emit_mir_value(ids, subject)}"
        .OptionValue(subject) -> "present-value {jet_cli_emit_mir_value(ids, subject)}"
        .ResultIsOk(subject) -> "is-ok {jet_cli_emit_mir_value(ids, subject)}"
        .ResultValue(subject, ok) -> "{jet_cli_emit_mir_choice(ok, "ok-value", "err-value")} {jet_cli_emit_mir_value(ids, subject)}"
        .PatternCapture(matched, index) -> "pattern-capture {jet_cli_emit_mir_value(ids, matched)} {index}"
        .PatternMatched(matched) -> "pattern-matched {jet_cli_emit_mir_value(ids, matched)}"
        .ProjectMembers(base, members) -> {
            texts :: loop member in members -> jet_cli_emit_mir_field_name(names, member)
            "project {jet_cli_emit_mir_value(ids, base)} .[{texts.join(", ")}]"
        }
        .Index(_, base, index, _, access, _, _) -> "index {jet_cli_emit_mir_access(access)}{jet_cli_emit_mir_value(ids, base)}[{jet_cli_emit_mir_value(ids, index)}]"
        .Slice(_, base, start, end, range, _) -> "slice {jet_cli_emit_mir_value(ids, base)}[{jet_cli_emit_mir_value(ids, start)}, {jet_cli_emit_mir_value(ids, end)}]{jet_cli_emit_mir_optional(ids, "range", range)}"
        .Range(start, end, exclusive) -> "range {jet_cli_emit_mir_value(ids, start)}{jet_cli_emit_mir_choice(exclusive, "..<", "..")}{jet_cli_emit_mir_value(ids, end)}"
        .Field(base, field) -> "field {jet_cli_emit_mir_value(ids, base)}.{jet_cli_emit_mir_field_name(names, field)}"
        .Struct(type_id, fields) -> "struct {jet_cli_emit_mir_braced(jet_cli_emit_mir_type_name(names, type_id), jet_cli_emit_mir_field_values(names, ids, fields))}"
        .Enum(type_id, variant, args) -> {
            texts :: loop arg in args -> jet_cli_emit_mir_enum_arg(names, ids, arg)
            "enum {jet_cli_emit_mir_type_name(names, type_id)}.{variant}({texts.join(", ")})"
        }
        .Tuple(_, fields) -> "tuple ({jet_cli_emit_mir_field_values(names, ids, fields)})"
        .Present(value) -> "present {jet_cli_emit_mir_value(ids, value)}"
        .Convert(value, parameters, target, _) -> {
            extra :: if parameters.len() == 0 -> "" else -> " with [{jet_cli_emit_mir_values(ids, parameters)}]"
            "convert {jet_cli_emit_mir_value(ids, value)} to {mir_type_display_name(target)}{extra}"
        }
        .TraitBox(value, target) -> "trait-box {jet_cli_emit_mir_value(ids, value)} as {jet_cli_emit_mir_type_name(names, target)}"
        .Absent -> "absent"
        .ResultOk(value) -> "ok {jet_cli_emit_mir_value(ids, value)}"
        .ResultErr(value) -> "err {jet_cli_emit_mir_value(ids, value)}"
        .Call(callee, args, _) -> "call {jet_cli_emit_mir_callee(program, names, ids, callee)}({jet_cli_emit_mir_args(ids, args)})"
        .IndirectCall(callee, args, _) -> "call *{jet_cli_emit_mir_value(ids, callee)}({jet_cli_emit_mir_args(ids, args)})"
        .Closure(target, captures, _) -> "closure {jet_cli_emit_mir_function_name(names, target)} [{jet_cli_emit_mir_values(ids, mir_operation_value_uses(operation))}] ({captures.len()} captures)"
        .PtrFromAddr(address, element) -> "pointer {jet_cli_emit_mir_value(ids, address)} as {mir_type_display_name(element)}"
        .Deref(value) -> "deref {jet_cli_emit_mir_value(ids, value)}"
        .RawAddressOf(place) -> "raw-address {jet_cli_emit_mir_place(ids, place)}"
        .AddressOf(place, access) -> "address {jet_cli_emit_mir_access(access)}{jet_cli_emit_mir_place(ids, place)}"
        .CoreCall(call, _, args, _, _, _) -> "call core {jet_cli_emit_mir_core_name(program, call)}({jet_cli_emit_mir_args(ids, args)})"
        .AttachTag(value, marked) -> "tag {jet_cli_emit_mir_value(ids, value)}{jet_cli_emit_ast_suffix(" #", marked)}"
        .Todo(_, _, _) -> "todo"
        .Never(reason) -> "never {jet_cli_debug_quote(reason)}"
        .Semantic(semantic) -> "semantic {lower_semantic_name(program, names.routes, semantic)} [{jet_cli_emit_mir_values(ids, mir_semantic_op_value_uses(semantic))}]"
        .LoopRangeInit(_, start, end, step, exclusive) -> "loop-range {jet_cli_emit_mir_value(ids, start)}{jet_cli_emit_mir_choice(exclusive, "..<", "..")}{jet_cli_emit_mir_value(ids, end)}{jet_cli_emit_mir_optional(ids, "step", step)}"
        .LoopRangeHasNext(_, cursor) -> "loop-range-has-next {jet_cli_emit_mir_value(ids, cursor)}"
        .LoopRangeValue(_, cursor) -> "loop-range-value {jet_cli_emit_mir_value(ids, cursor)}"
        .LoopRangeAdvance(_, cursor) -> "loop-range-advance {jet_cli_emit_mir_value(ids, cursor)}"
        .LoopIterInit(_, collection, step, by_value, _) -> "loop-iter {jet_cli_emit_mir_choice(by_value, "^", "")}{jet_cli_emit_mir_value(ids, collection)}{jet_cli_emit_mir_optional(ids, "step", step)}"
        .LoopIterHasNext(_, cursor) -> "loop-iter-has-next {jet_cli_emit_mir_value(ids, cursor)}"
        .LoopIterValue(_, cursor) -> "loop-iter-value {jet_cli_emit_mir_value(ids, cursor)}"
        .LoopIterAdvance(_, cursor) -> "loop-iter-advance {jet_cli_emit_mir_value(ids, cursor)}"
        .ScopeEnter(scope, _) -> "scope-enter {jet_cli_emit_mir_short(ids.scopes, "s", scope.value)}"
        .ScopeExit(scope) -> "scope-exit {jet_cli_emit_mir_short(ids.scopes, "s", scope.value)}"
        .Drop(value, _) -> "drop {jet_cli_emit_mir_value(ids, value)}"
    }
}

fn jet_cli_emit_mir_terminator(ids: JetCLIEmitMIRIds, terminator: MIRTerminator) -> String Never! {
    if terminator == {
        .Jump(target) -> "jump {jet_cli_emit_mir_block(ids, target)}"
        .Branch(condition, then_target, else_target) -> "branch {jet_cli_emit_mir_value(ids, condition)}, {jet_cli_emit_mir_block(ids, then_target)}, {jet_cli_emit_mir_block(ids, else_target)}"
        .Switch(subject, arms, otherwise) -> {
            texts :: loop arm in arms -> "{jet_cli_emit_mir_value(ids, arm.condition)} -> {jet_cli_emit_mir_block(ids, arm.target)}"
            "switch {jet_cli_emit_mir_value(ids, subject)} [{texts.join(", ")}] else {jet_cli_emit_mir_block(ids, otherwise)}"
        }
        .Return(value) -> jet_cli_emit_mir_return(ids, value)
        .Yield(value, resume) -> "yield {jet_cli_emit_mir_value(ids, value)}, resume {jet_cli_emit_mir_block(ids, resume)}"
        .Break(target, value) -> "break {jet_cli_emit_mir_block(ids, target)}{jet_cli_emit_mir_optional(ids, "with", value)}"
        .Continue(target) -> "continue {jet_cli_emit_mir_block(ids, target)}"
        .Unreachable(reason) -> "unreachable {jet_cli_debug_quote(reason)}"
        .Poll(kind, resume, stop) -> "poll {jet_cli_emit_mir_choice(kind == .Check, "check", "propagate")}, resume {jet_cli_emit_mir_block(ids, resume)}, stop {jet_cli_emit_mir_block(ids, stop)}"
        .Stopped -> "stopped"
    }
}

fn jet_cli_emit_mir_return(ids: JetCLIEmitMIRIds, value: MIRValueID?) -> String Never! {
    returned :: value ?? return "return"
    "return {jet_cli_emit_mir_value(ids, returned)}"
}

fn jet_cli_emit_mir_unary(op: MIRUnaryOp) -> String Never! {
    if op == {
        .Neg -> "neg"
        .Not -> "not"
    }
}

fn jet_cli_emit_mir_choice(flag: Bool, yes: String, no: String) -> String Never! {
    if flag -> return yes.copy()
    no.copy()
}

// `head{body}`: a record spelled with its fields.
fn jet_cli_emit_mir_braced(head: String, body: String) -> String Never! {
    "{head}{JET_CLI_EMIT_OPEN}{body}{JET_CLI_EMIT_CLOSE}"
}

JET_CLI_EMIT_OPEN :: "{{"
JET_CLI_EMIT_CLOSE :: "}}"

fn jet_cli_emit_mir_payload(names: JetCLIEmitMIRNames, kind: MIRPayloadKind) -> String Never! {
    if kind == {
        .Option -> ".Val"
        .Result(ok) -> jet_cli_emit_mir_choice(ok, ".Ok", ".Err")
        .Enum(owner, variant, slot) -> ".{jet_cli_emit_mir_type_name(names, owner)}.{variant}.{slot}"
    }
}
