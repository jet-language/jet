// `jet build --target web <file>` (the build option `os: web`): the program
// partition of the checked program (JetWeb Build.jet), linked against the
// runtime partition packaged beside jet, and the host files that load the
// two, written to the output directory (jet_cli_output_dir_path): app.wasm,
// rt.wasm, web.manifest.json, app.js, jet_dom_runtime.js and index.html.
// `node app.js` runs the program, and so does index.html, the default page.
use {
    cli_files: core.files
    cli_web: core.web
    cli_term: core.term
    cli_time: core.time
    jet_driver.[
        JetDriverAuthorizedSourceSnapshot,
        JetDriverCompileResult,
        JetDriverIceRow,
        JetDriverLoweringInputs,
        JetDriverVerbOutput,
        JET_DRIVER_EXIT_OK,
        JET_DRIVER_EXIT_USER_ERROR,
        jet_driver_entry_root_path,
        jet_driver_ice_record,
    ]
    jet_foundation.[BuildOptions, FnBody, cli_schema_embed_wasm_record, module_is_core]
    jet_web.[web_app_js, web_dom_runtime_js, web_index_html, web_program]
}

// The runtime partition and its receipt beside the runtime pack
// (Compiler/build.jet).
JET_CLI_RUNTIME_WEB_FILE: "jet_runtime.wasm"
JET_CLI_RUNTIME_WEB_RECEIPT_FILE: "jet_runtime.wasm.tsv"

// The web build of a compile with no errors whose authority is allowed
// (jet_cli_build_result). The IR is the native route's (jet_cli_native_program):
// every fault, a web selection finding among them, is one ICE row, all
// reported at once with exit 101. Under `--explain-partition` the build's
// stdout is the partition report (jet_cli_web_partition_report).
jet_cli_build_web: fn(file: String, color: Bool, options: BuildOptions, result: JetDriverCompileResult, inputs: &&JetDriverLoweringInputs?, snapshot: JetDriverAuthorizedSourceSnapshot) -[Env, FS, Time, Exec.Args]> JetDriverVerbOutput Never! {
    if result.internal_problem == .Val(problem) -> return jet_cli_ice(problem)
    if !result.complete -> return jet_cli_ice("the Jet compiler stopped before finishing `{file}`")
    if jet_cli_build_option_gate_refusal(snapshot.roots[0].canonical_path, options, color) == .Val(refused) -> return refused
    checked := inputs.move() ?? return jet_cli_ice("the Jet compiler finished `{file}` without its checked functions")
    if checked.entry_key == None -> return jet_cli_native_report(file, "build", JetCLINativeFailure.NoEntry, color)
    report: if options.explain_partition -> jet_cli_web_partition_report(checked.functions) else -> ""
    runtime_dir: jet_cli_runtime_dir()
    runtime: jet_cli_runtime_exports(runtime_dir)
    if runtime.failure == .Val(failure) -> return jet_cli_native_report(file, "build", failure, color)
    partition_path: "{runtime_dir}/{JET_CLI_RUNTIME_WEB_FILE}"
    partition: cli_files.read_bytes(partition_path) ?? return jet_cli_native_report(file, "build", JetCLINativeFailure.Runtime{what: "couldn't read the Jet runtime's web partition {partition_path}: {err}"}, color)
    receipt_path: "{runtime_dir}/{JET_CLI_RUNTIME_WEB_RECEIPT_FILE}"
    receipt: cli_files.read(receipt_path) ?? return jet_cli_native_report(file, "build", JetCLINativeFailure.Runtime{what: "couldn't read the Jet runtime's web receipt {receipt_path}: {err}"}, color)
    census := [JetDriverIceRow]{}
    built := jet_cli_native_program(result, checked, None, options, runtime, census, file, jet_driver_entry_root_path(snapshot))
    if built.failure == .Val(failure) -> return jet_cli_native_report(file, "build", failure, color)
    if result.trace_sink == .Val(sink) -> sink.begin("web.module", "", -1, -1)
    web := web_program(built.program.move(), receipt)
    if result.trace_sink == .Val(sink) -> sink.end("web.module", web.bytes.len())
    loop error in web.errors -> jet_driver_ice_record(census, "-", "web", "select", error)
    if census.len() > 0 -> return jet_cli_ice_census(file, census)
    build_dir: jet_cli_output_dir_path(snapshot, options)
    if jet_cli_build_dir(build_dir, color) == .Val(refused) -> return refused
    // The program's JetCommandSchema record rides in its `jet.command`
    // custom section (spec.md:4675); the module addresses 32 bits.
    app := web.bytes.copy()
    if result.command_record.len() > 0 {
        cli_schema_embed_wasm_record(app, result.command_record, U64{4294967295}) ?? return jet_cli_ice("the web program module of `{file}` is not a well-framed Wasm module: {err.display()}")
    }
    if jet_cli_web_write(file, color, "{build_dir}/app.wasm", app) == .Val(failure) -> return failure
    if jet_cli_web_write(file, color, "{build_dir}/rt.wasm", partition) == .Val(failure) -> return failure
    if jet_cli_web_write_text(file, color, "{build_dir}/web.manifest.json", web.manifest) == .Val(failure) -> return failure
    if jet_cli_web_write_text(file, color, "{build_dir}/app.js", web_app_js()) == .Val(failure) -> return failure
    if jet_cli_web_write_text(file, color, "{build_dir}/jet_dom_runtime.js", web_dom_runtime_js()) == .Val(failure) -> return failure
    if jet_cli_web_write_text(file, color, "{build_dir}/index.html", web_index_html()) == .Val(failure) -> return failure
    JetDriverVerbOutput{stdout: report, stderr: "", exit_code: JET_DRIVER_EXIT_OK}
}

// `jet build --explain-partition`: one row per function of the program's own
// sources, named with its module and in key order, with the partition sema
// solved for it and why: its marker, else the Browser effect or entry that
// settled it.
jet_cli_web_partition_report: fn(functions: [FnBody]) -> String Never! {
    // Each row is `<key>\t<shown row>`, so sorting the rows orders them by key.
    rows := [String]{}
    loop function in functions {
        if function.synthetic || module_is_core(function.module_identity) -> next
        bucket: function.web_bucket ?? next
        qualifier: if function.module_name != "" -> "{function.module_name}." else -> ""
        browser: function.effects.solved.contains("Browser")
        reason: if function.web_marker == {
            .Val(.WasmExport) -> "#Export(wasm)"
            .Val(.Wasm) -> "#Target(Wasm)"
            .Val(.JS) -> "#Target(JS)"
            .None -> if {
                browser -> "inferred: Browser effect"
                function.name == "run" -> "entry"
                else -> "inferred: no Browser effect"
            }
        }
        partition: if bucket == {
            .JS -> "JS"
            .Wasm -> "Wasm"
        }
        effects := function.effects.solved.copy()
        effects.sort()
        shown: if effects.len() == 0 -> "(pure)" else -> effects.join(", ")
        rows.push("{function.key}\t{qualifier}{function.name} -> {partition}  {reason}  effects: {shown}")
    }
    rows.sort()
    text := "Web partition report\n"
    loop row in rows {
        shown: row.slice(row.find("\t") + 1, row.len())
        text = "{text}{shown}\n"
    }
    text
}

// Write one file of a web build, or the report of why it can't be.
jet_cli_web_write: fn(file: String, color: Bool, path: String, bytes: [U8]) -[FS]> JetDriverVerbOutput? Never! {
    cli_files.write_bytes(path, bytes) ?? return Val(jet_cli_native_report(file, "build", JetCLINativeFailure.Write{what: "couldn't write {path}: {err}"}, color))
    None
}

jet_cli_web_write_text: fn(file: String, color: Bool, path: String, text: String) -[FS]> JetDriverVerbOutput? Never! {
    cli_files.write(path, text) ?? return Val(jet_cli_native_report(file, "build", JetCLINativeFailure.Write{what: "couldn't write {path}: {err}"}, color))
    None
}

// `jet dev` of a browser program (Front.jet jet_cli_dev_web_selected): the
// web build `jet build --target web` writes, served from its directory on
// 127.0.0.1:`port` (0: the listener picks one) and rebuilt on every change
// to the package's sources. Each good build writes its revision beside the
// build as `__jet_dev_version`, so `GET /__jet_dev_version` answers the
// revision of the last good build. A failed rebuild prints its report and the
// last good build stays served; a first build that fails ends the session
// with its report, and so does a preview server that stops.
jet_cli_dev_web_loop: fn(file: String, color: Bool, options: BuildOptions, threads: Int?, invocation: JetCLIInvocationAuthority?, port: Int, trace_sink: JetCLITraceSink?) -> JetDriverVerbOutput {
    root: jet_cli_manifest_root(jet_cli_parent(file) ?? ".") ?? (jet_cli_parent(file) ?? ".")
    stamp := jet_cli_dev_stamp(root, [String]{})
    first: jet_cli_dev_web_build(file, color, options, threads, invocation, trace_sink)
    if first.output.exit_code != JET_DRIVER_EXIT_OK -> return first.output
    jet_cli_write_output(first.output)
    revision := 1
    version_path: "{first.build_dir}/__jet_dev_version"
    if jet_cli_web_write_text(file, color, version_path, "{revision}") == .Val(refused) -> return refused
    state: Shared{JetCLIDevWebState{stopped: None}}
    preview: cli_web.app().static_files("", first.build_dir)
    fix: "pass a free port with `--port=N`, or leave `--port` out to let the preview listener choose one"
    bound: preview.bind("127.0.0.1:{port}") ?? return JetDriverVerbOutput{stdout: "", stderr: jet_cli_report("E2105", "couldn't listen for the app preview on 127.0.0.1:{port}: {err}", jet_cli_why("E2105"), fix, color), exit_code: JET_DRIVER_EXIT_USER_ERROR}
    address: bound.local_addr() ?? "127.0.0.1:{port}"
    cli_term.print("App preview: http://{address}/")
    jet_cli_dev_canvas_hint(file)
    task.group dev_web {
        serving: task {
            if bound.serve() == {
                .Ok(_) -> jet_cli_dev_web_stop(state, "the preview server shut down")
                .Err(error) -> jet_cli_dev_web_stop(state, "{error}")
            }
        }
        loop jet_cli_dev_web_stopped(state) == None {
            cli_term.eprint("jet dev: watching {root} (Ctrl-C to stop)")
            loop jet_cli_dev_stamp(root, [String]{}) == stamp && jet_cli_dev_web_stopped(state) == None -> cli_time.sleep(200ms)
            if jet_cli_dev_web_stopped(state) != None -> break
            stamp = jet_cli_dev_stamp(root, [String]{})
            cli_term.eprint("jet dev: change detected, rebuilding")
            built: jet_cli_dev_web_build(file, color, options, threads, invocation, trace_sink)
            jet_cli_write_output(built.output)
            if built.output.exit_code != JET_DRIVER_EXIT_OK -> next
            revision += 1
            if jet_cli_web_write_text(file, color, version_path, "{revision}") == .Val(refused) -> jet_cli_write_output(refused)
        }
        serving.join().drop("the preview server's stop is reported from its state")
    }
    reason: jet_cli_dev_web_stopped(state) ?? "the preview server stopped"
    JetDriverVerbOutput{stdout: "", stderr: jet_cli_report("E2105", "the app preview on http://{address}/ stopped: {reason}", jet_cli_why("E2105"), fix, color), exit_code: JET_DRIVER_EXIT_USER_ERROR}
}

// Why the preview server of a web `jet dev` session stopped, once it has.
JetCLIDevWebState: struct {
    stopped: String?
}

jet_cli_dev_web_stopped: fn(state: Shared<JetCLIDevWebState>) -> String? {
    permit: state.guard_read()
    permit.value.stopped.copy()
}

jet_cli_dev_web_stop: fn(state: Shared<JetCLIDevWebState>, reason: String) {
    permit := state.guard_edit()
    permit.value.stopped = Val(reason)
}

// One web build of `file` (jet_cli_build_result under `os: web`) and the
// directory it writes.
JetCLIDevWebBuilt: struct {
    output: JetDriverVerbOutput
    build_dir: String
}

jet_cli_dev_web_build: fn(file: String, color: Bool, options: BuildOptions, threads: Int?, invocation: JetCLIInvocationAuthority?, trace_sink: JetCLITraceSink?) -> JetCLIDevWebBuilt {
    compiled := jet_cli_compile_executable_file(file, None, color, threads, options, trace_sink)
    if compiled.move() == {
        .Refused(refusal) -> JetCLIDevWebBuilt{output: refusal, build_dir: ""}
        .Checked(result, inputs, snapshot) -> {
            build_dir: jet_cli_output_dir_path(snapshot, options)
            source: cli_files.read(file) ?? ""
            output: jet_cli_build_result(file, jet_cli_stem(file), source, color, options, invocation, false, false, true, false, result, inputs, snapshot)
            JetCLIDevWebBuilt{output: output, build_dir: build_dir}
        }
    }
}