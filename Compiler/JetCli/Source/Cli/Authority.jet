// The application authority check of the Jet-hosted `jet build` and
// `jet run` (Source/CmdCompile.rs `resolve_application_authority`; the
// policy carrier is jet-foundation Authority.rs `ApplicationAuthority` and
// jet-pkg-model EffectBudget.rs `project_application_effects` and
// `application_policy_diagnostic`). The program's required effects are the
// direct effects of every function the checked entry reaches; its policy is the beginner floor, the
// entry package's `authority.holds`, and the `--allow`/`--deny`/`-A` rows of this
// invocation. A script (a file whose first line is a `#!/...` launch line)
// runs as `-A` runs a program. A required right the policy denies, or one it leaves
// undecided, stops the command with E1803 before anything is built.
use jet_driver.[
    JetDriverAuthorityPolicy,
    JetDriverCompileResult,
    JetDriverLoweringInputs,
]
use jet_foundation.[
    Diagnostic,
    MIRFunctionID,
    MIRProgram,
    TFunc,
    authority_is_deny_only,
    diagnostic_from_registry,
]
use jet_sema.[
    sema_effect_grantable_roots,
]

// A program with no authority row may print, allocate, and
// read its own arguments.
JET_CLI_AMBIENT_BASIC_EFFECTS :: [String]{"IO", "Mem.Alloc", "Exec.Args"}
JET_CLI_APPLICATION_DEFAULT :: "application default"
JET_CLI_PACKAGE_DEFAULT :: "package.jet default"

// One application's authority: the sema fact (`required`) and the policy
// facts (`granted`, `denied`, and the policy's name), each a sorted set.
struct JetCLIAuthority {
    required: [String]
    granted: [String]
    denied: [String]
    authority: String
}

// The `--allow`, `--deny` and `-A` (`--allow-all`) rows of this invocation,
// canonical and in argv order (Source/main.rs `parse_authority_flags`).
// `all` grants every grantable right; a denial still wins over it.
struct JetCLIInvocationAuthority {
    all: Bool
    allow: [String]
    deny: [String]
}

// A file whose first line is a `#!/...` launch line (`#!/usr/bin/env jet`)
// is a script: it runs with the invoking user's authority, as a shell script
// does. A byte-zero `#!Marker` refusal is not a launch line.
fn jet_cli_is_script(source: String) -> Bool Never! {
    source.starts_with("#!/")
}

// The invocation rows a build or run of `source` answers with: a script's
// rows are the `-A` rows, so the launch line and the flag are one grant.
fn jet_cli_source_invocation(source: String, invocation: JetCLIInvocationAuthority?) -> JetCLIInvocationAuthority? Never! {
    // copy: `invocation` stays with the caller (a read parameter); the rows returned own their own.
    rows := invocation.copy()
    if !jet_cli_is_script(source) -> return rows
    granted := rows ?? JetCLIInvocationAuthority{all: false, allow: [String]{}, deny: [String]{}}
    granted.all = true
    Val(granted)
}

enum JetCLIVerdict { Allowed Denied Missing }

// A sorted set of the values (Rust `BTreeSet<String>`).
fn jet_cli_sorted_set(values: [String]) -> [String] Never! {
    sorted := [String]{}
    loop value in values {
        if sorted.contains(value) -> next
        index := sorted.len()
        &sorted.push(value)
        loop index > 0 && sorted[index - 1] > value {
            sorted[index] = sorted[index - 1]
            index -= 1
        }
        sorted[index] = value
    }
    sorted
}

// Root segment of a dotted right (`FS.Read` -> `FS`).
fn jet_cli_right_root(right: String) -> String Never! {
    right.split(".").to_list()[0]
}

// Authority.rs `parse_root`: the canonical spelling of a known root, matched
// without regard to ASCII case.
fn jet_cli_parse_root(right: String) -> String? Never! {
    root :: jet_cli_ascii_lower(jet_cli_right_root(right))
    if root == "panic" -> return Val("Panic")
    if root == "mem" -> return Val("Mem")
    loop known in sema_effect_grantable_roots() {
        if jet_cli_ascii_lower(known) == root -> return Val(known)
    }
    None
}

// Authority.rs `parse_right`: a right with its root canonical and its leaf
// spelling kept; `Panic` has no leaves.
fn jet_cli_parse_right(raw: String) -> String? Never! {
    right :: raw.trim()
    root :: jet_cli_parse_root(right) ?? return None
    if root == "Panic" && right != "Panic" -> return None
    parts :: right.split(".").to_list()
    if parts.len() == 1 -> return Val(root)
    Val("{root}{right.slice(parts[0].len()..<right.len())}")
}

// Authority.rs `covers`: a bound covers itself and every descendant; a
// resource-qualified bound (`FS.Read:/data`) only across a `/` boundary.
fn jet_cli_right_covers(raw_bound: String, raw_right: String) -> Bool Never! {
    bound :: jet_cli_parse_right(raw_bound) ?? raw_bound.trim()
    right :: jet_cli_parse_right(raw_right) ?? raw_right.trim()
    if right == bound -> return true
    if !right.starts_with(bound) || right.len() == bound.len() -> return false
    next_byte :: right.bytes()[bound.bytes().len()]
    if bound.contains(":") -> return next_byte == (U8{47})
    next_byte == (U8{46}) || next_byte == (U8{58}) || next_byte == (U8{47})
}

fn jet_cli_covers_any(bounds: [String], right: String) -> Bool Never! {
    loop bound in bounds {
        if jet_cli_right_covers(bound, right) -> return true
    }
    false
}

fn jet_cli_answer(authority: JetCLIAuthority, right: String) -> JetCLIVerdict Never! {
    if jet_cli_covers_any(authority.denied, right) -> return JetCLIVerdict.Denied
    if jet_cli_covers_any(authority.granted, right) -> return JetCLIVerdict.Allowed
    JetCLIVerdict.Missing
}

// Canonical policy rows (EffectBudget.rs `policy_effects`).
fn jet_cli_policy_effects(names: [String]) -> [String] Never! {
    rights := [String]{}
    loop name in names {
        if jet_cli_parse_right(name) == .Val(right) -> &rights.push(right)
    }
    jet_cli_sorted_set(rights)
}

// EffectBudget.rs `entry_effects`: the application requires the direct
// effects of every function its entry reaches along checked call edges.
// The maximal row an open-world call (an unannotated function value, an
// extern) seeds into `solved` is a ceiling fact (E0743), not a required
// right, so it never widens the authority the application must hold.
fn jet_cli_entry_required_effects(program: MIRProgram, entry: MIRFunctionID) -> [String] Never! {
    by_key := [String:Int]{}
    pending := [Int]{}
    loop (index, function) in program.functions {
        if by_key.get(function.key) == None -> by_key[function.key] = index
        if function.id == entry -> &pending.push(index)
    }
    seen := [Int:Bool]{}
    required := [String]{}
    loop pending.len() > 0 {
        index :: &pending.pop() ?? break
        if seen.get(index) != None -> next
        seen[index] = true
        loop effect_name in program.functions[index].effects.direct -> &required.push(effect_name)
        loop edge in program.functions[index].effects.call_edges {
            if by_key.get(edge) == .Val(callee) -> &pending.push(callee)
        }
    }
    required
}

// EffectBudget.rs `project_application_effects` plus CmdCompile.rs
// `merge_invocation_authority`.
fn jet_cli_application_authority(result: JetDriverCompileResult, invocation: JetCLIInvocationAuthority?) -> JetCLIAuthority Never! {
    required := [String]{}
    if result.mir == .Val(program) {
        if result.entry_function == .Val(entry) -> required = jet_cli_entry_required_effects(program, entry)
    }
    authority := jet_cli_policy_authority(required, result.authority_policy)
    jet_cli_with_invocation(&authority, invocation)
    authority
}

// jet_cli_entry_required_effects over the checked functions the native
// route builds from: the direct effects of every function the entry `entry_key`
// reaches along checked call edges (the TIR effect facts MIR copies).
fn jet_cli_checked_required_effects(functions: [TFunc], entry_key: String) -> [String] Never! {
    by_key := [String:Int]{}
    loop (index, function) in functions {
        if by_key.get(function.key) == None -> by_key[function.key] = index
    }
    pending := [Int]{}
    if by_key.get(entry_key) == .Val(entry) -> &pending.push(entry)
    seen := [Int:Bool]{}
    required := [String]{}
    loop pending.len() > 0 {
        index :: &pending.pop() ?? break
        if seen.get(index) != None -> next
        seen[index] = true
        loop effect_name in functions[index].effects.direct -> &required.push(effect_name)
        loop edge in functions[index].effects.call_edges {
            if by_key.get(edge) == .Val(callee) -> &pending.push(callee)
        }
    }
    required
}

// jet_cli_application_authority of an executable compile (`jet build`,
// `jet run`): the effects its checked entry reaches under its package policy.
fn jet_cli_executable_authority(result: JetDriverCompileResult, inputs: JetDriverLoweringInputs?, invocation: JetCLIInvocationAuthority?) -> JetCLIAuthority Never! {
    required := [String]{}
    if inputs == .Val(checked) {
        if checked.entry_key == .Val(entry_key) -> required = jet_cli_checked_required_effects(checked.functions, entry_key)
    }
    authority := jet_cli_policy_authority(required, result.authority_policy)
    jet_cli_with_invocation(&authority, invocation)
    authority
}

// The authority of a program that requires `required` under its package
// `policy`, before this invocation's rows.
fn jet_cli_policy_authority(required: [String], authority_policy: JetDriverAuthorityPolicy?) -> JetCLIAuthority Never! {
    authority := JetCLIAuthority{required: jet_cli_sorted_set(required), granted: jet_cli_sorted_set(JET_CLI_AMBIENT_BASIC_EFFECTS), denied: [String]{}, authority: JET_CLI_APPLICATION_DEFAULT}
    policy :: authority_policy ?? JetDriverAuthorityPolicy{manifest_path: None, allow: None, deny: None}
    if policy.manifest_path != None {
        if policy.allow == None && policy.deny == None {
            authority.authority = JET_CLI_PACKAGE_DEFAULT
        } else {
            authority.granted = jet_cli_policy_effects(policy.allow ?? [String]{})
            authority.denied = jet_cli_policy_effects(policy.deny ?? [String]{})
            authority.authority = "package.jet authority.holds"
        }
    }
    authority
}

// `authority` with this invocation's rows merged in: `-A` grants every
// grantable right, `--allow` its rights, and `--deny` denies, which wins.
fn jet_cli_with_invocation(authority: &JetCLIAuthority, invocation: JetCLIInvocationAuthority?) Never! {
    rows :: invocation ?? return
    // copy: the policy rows stay in `authority` until the merged rows replace them.
    granted := authority.granted.copy()
    if rows.all {
        loop root in sema_effect_grantable_roots() -> &granted.push(root)
    }
    loop right in rows.allow -> &granted.push(right)
    // copy: as `granted` above.
    denied := authority.denied.copy()
    loop right in rows.deny -> &denied.push(right)
    authority.granted = jet_cli_sorted_set(granted)
    authority.denied = jet_cli_sorted_set(denied)
    authority.authority = "{authority.authority} + CLI invocation"
}

// Required rights with no policy verdict. Deny-only rights (the Panic and Mem
// roots and the Time.Wait leaf; jet-foundation Authority.rs `is_deny_only`)
// may be denied but never need a grant (Authority.rs `undecided_effects`).
fn jet_cli_undecided(authority: JetCLIAuthority) -> [String] Never! {
    rights := [String]{}
    loop right in authority.required {
        if !authority_is_deny_only(right) && jet_cli_answer(authority, right) == JetCLIVerdict.Missing -> &rights.push(right)
    }
    rights
}

fn jet_cli_denied_required(authority: JetCLIAuthority) -> [String] Never! {
    rights := [String]{}
    loop right in authority.required {
        if jet_cli_answer(authority, right) == JetCLIVerdict.Denied -> &rights.push(right)
    }
    rights
}

fn jet_cli_is_application_default(authority: JetCLIAuthority) -> Bool Never! {
    authority.authority.starts_with(JET_CLI_APPLICATION_DEFAULT)
}

fn jet_cli_is_beginner_floor(authority: JetCLIAuthority) -> Bool Never! {
    jet_cli_is_application_default(authority) || authority.authority.starts_with(JET_CLI_PACKAGE_DEFAULT)
}

// The complete `allow:` row a beginner-floor program must write. Deny-only
// rights never appear in a positive grant (Authority.rs `inline_allow_row`).
fn jet_cli_inline_allow_row(authority: JetCLIAuthority) -> [String] Never! {
    rights := [String]{}
    loop right in authority.required {
        if !authority_is_deny_only(right) -> &rights.push(right)
    }
    rights
}

// Authority.rs `effect_action`: plain words for what using `right` does.
fn jet_cli_effect_action(raw: String) -> String Never! {
    right :: jet_cli_parse_right(raw) ?? raw.trim()
    if right == {
        "FS.Read" -> return "reads files"
        "FS.Write" -> return "writes files"
        "Exec.Exit" -> return "ends its own process"
        "Time.Wait" -> return "waits"
        "Mem.Alloc" -> return "allocates memory"
        "DB.Read" -> return "reads a database"
        "DB.Write" -> return "writes a database"
        "Rand.Draw" -> return "draws random numbers"
        "Exec.Args" -> return "reads its arguments"
        else -> {}
    }
    if jet_cli_right_root(right) == {
        "IO" -> "prints text or reads input"
        "FS" -> "reads and writes files"
        "Net" -> "uses the network"
        "Exec" -> "starts other programs"
        "Env" -> "reads environment variables"
        "Time" -> "reads the clock"
        "Rand" -> "draws random numbers"
        "DB" -> "uses a database"
        "Log" -> "writes logs"
        "GPU" -> "uses the GPU"
        "FFI" -> "calls foreign code"
        "Browser" -> "uses browser APIs"
        "Secret" -> "reads secrets"
        "Mem" -> "allocates memory"
        "Panic" -> "can stop with a panic"
        else -> "uses an undeclared authority"
    }
}

fn jet_cli_policy_owner(authority: JetCLIAuthority) -> String Never! {
    name :: authority.authority
    if {
        jet_cli_is_application_default(authority) -> "the default for a file with no package block"
        name.starts_with(JET_CLI_PACKAGE_DEFAULT) -> "package.jet (which has no authority block)"
        name.starts_with("package.jet") -> "package.jet"
        name.starts_with("inline Package") -> "this file's package block"
        name.starts_with("jet repl") || name.starts_with("REPL") -> "this REPL session"
        else -> "`{name}`"
    }
}

// Authority.rs `policy_why`.
fn jet_cli_policy_why(authority: JetCLIAuthority) -> String Never! {
    denied :: jet_cli_denied_required(authority)
    rights :: if denied.len() == 0 -> jet_cli_undecided(authority) else -> denied
    verdict :: if denied.len() == 0 -> "has not allowed that yet" else -> "denies that"
    actions := [String]{}
    loop right in rights {
        action :: jet_cli_effect_action(right)
        if !actions.contains(action) -> &actions.push(action)
    }
    phrase := "uses no authority"
    if actions.len() == 1 -> phrase = actions[0]
    if actions.len() > 1 {
        head := [String]{}
        loop index in 0..<(actions.len() - 1) -> &head.push(actions[index])
        phrase = "{head.join(", ")} and {actions[actions.len() - 1]}"
    }
    "This program {phrase}, and {jet_cli_policy_owner(authority)} {verdict}."
}

// Authority.rs `policy_fix`.
fn jet_cli_policy_fix(authority: JetCLIAuthority) -> String Never! {
    undecided :: jet_cli_undecided(authority)
    if undecided.len() > 0 && jet_cli_is_application_default(authority) {
        return "declare the complete row `allow: [{jet_cli_inline_allow_row(authority).join(", ")}]` under `authority.holds` in a leading `package {{ … }}` block of this file (`jet fix --all` inserts it); otherwise approve the exact operation once in an interactive terminal"
    }
    step := ""
    if {
        undecided.len() == 0 -> step = "adjust the denial in `authority.holds.deny`"
        jet_cli_is_beginner_floor(authority) -> step = "add the complete row `allow: [{jet_cli_inline_allow_row(authority).join(", ")}]` under `authority.holds` in `package.jet`"
        else -> step = "add `allow: [{undecided.join(", ")}]` under `authority.holds` in `package.jet`"
    }
    "{step}; otherwise deny effects deliberately, or approve the exact operation once or for the project in an interactive terminal"
}

fn jet_cli_rights_or_none(rights: [String]) -> String Never! {
    if rights.len() == 0 -> "none" else -> rights.join(", ")
}

// Authority.rs `policy_facts`: the structured detail `--json` reports.
fn jet_cli_policy_facts(authority: JetCLIAuthority) -> String Never! {
    "authority_facts:required_effects={jet_cli_rights_or_none(authority.required)}; granted_effects={jet_cli_rights_or_none(authority.granted)}; denied_effects={jet_cli_rights_or_none(authority.denied)}; denied_required_effects={jet_cli_rights_or_none(jet_cli_denied_required(authority))}; undecided_effects={jet_cli_rights_or_none(jet_cli_undecided(authority))}; authority={authority.authority}"
}

// E1803 when the policy denies or leaves undecided a required right
// (Authority.rs `policy_refusal`; EffectBudget.rs
// `application_policy_diagnostic`). A file with no package manifest leads its
// Fix with the exact `--allow` invocation of `command` and its `-A` form.
fn jet_cli_authority_refusal(authority: JetCLIAuthority, file: String, command: String) -> Diagnostic? Never! {
    denied :: jet_cli_denied_required(authority)
    undecided :: jet_cli_undecided(authority)
    if denied.len() == 0 && undecided.len() == 0 -> return None
    what :: if denied.len() == 0 -> "application authority is undecided for `{undecided.join(", ")}`" else -> "application authority denies `{denied.join(", ")}`"
    diagnostic := diagnostic_from_registry("E1803", None, what, jet_cli_policy_why(authority), jet_cli_policy_fix(authority))
    if denied.len() == 0 && jet_cli_is_application_default(authority) {
        fix :: diagnostic.fix
        rest :: if fix.len() == 0 -> "" else -> "{jet_cli_ascii_lower(fix.slice(0..<1))}{fix.slice(1..<fix.len())}"
        diagnostic.fix = "run `jet {command} --allow={undecided.join(",")} {file}` (or `-A`/`--allow-all` for every effect) to allow it for this run, or {rest}"
    }
    diagnostic.detail = Val(jet_cli_policy_facts(authority))
    diagnostic.denial_kind = Val("authority")
    diagnostic.scope_chain = [String]{authority.authority}
    Val(diagnostic)
}
