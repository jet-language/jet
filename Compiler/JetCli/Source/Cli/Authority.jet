// The application authority of the Jet-hosted `jet build` and `jet run`
// (spec.md "Application authority"). The program's required effects are the
// direct effects of every function the checked entry reaches; its policy is
// the beginner floor, the entry package's `authority`, and the
// `--allow`/`--deny`/`-A` rows of this invocation. Every effect is allowed
// unless a row denies it: a required right the policy denies stops the
// command with E1803 before anything is built, and the rights nobody
// acknowledged are the ones a run names in its notice (EffectNotice.jet).
use {
    jet_driver.[
        JetDriverAuthorityPolicy,
        JetDriverCompileResult,
    ]
    jet_foundation.[
        AUTHORITY_AMBIENT_BASIC_EFFECTS,
        Diagnostic,
        authority_effect_action,
        authority_root,
        authority_grantable_roots,
        authority_needs_no_grant,
        authority_own_process_leaf,
        authority_parse_right,
        diagnostic_from_registry,
        effect_scope_argument_valid,
        effect_scope_covers,
        effect_scope_read_paths,
        effect_scope_split,
    ]
    jet_sema.[
        sema_effect_builtin_leaf_unknown,
    ]
    jet_semindex.[SemEffectProjection]
}

JET_CLI_APPLICATION_DEFAULT: "application default"
JET_CLI_PACKAGE_DEFAULT: "package.jet default"
JET_CLI_INLINE_PACKAGE_DEFAULT: "inline Package default"

// One application's authority: the sema fact (`required`) and the policy
// facts (`granted`, `denied`, and the policy's name), each a sorted set.
JetCLIAuthority: struct {
    required: [String]
    granted: [String]
    denied: [String]
    authority: String
    // The rights this invocation's `--deny` removed: E1803 names the command
    // line, not the policy, when one of them stops the run.
    invocation_denied: [String]
    // The only paths the run may read (jet_cli_merged_read_scope): its
    // package's `FS.Read("<path>")` grants with this invocation's. Empty when
    // its reads are not confined.
    read_scope: [String]
}

// The `--allow`, `--deny` and `-A` (`--allow-all`) rows of this invocation,
// canonical and in argv order. `all` grants every grantable right; a denial
// still wins over it. `remote` is the pinned origin of a `jet run <url>` or
// `jet run <package>` target (RemoteRun.jet), whose effect notice is a
// first-run question.
JetCLIInvocationAuthority: struct {
    all: Bool
    allow: [String]
    deny: [String]
    remote: JetCLIRemoteRunOrigin?{None}
}

// A file whose first line is a `#!/...` launch line (`#!/usr/bin/env jet`)
// is a script: a standalone program wherever it lives. A byte-zero
// `#!Marker` refusal is not a launch line.
jet_cli_is_script: fn(source: String) -> Bool Never! {
    source.starts_with("#!/")
}

JetCLIVerdict: enum { Allowed Denied Missing }

// A sorted set of the values (Rust `BTreeSet<String>`).
jet_cli_sorted_set: fn(values: [String]) -> [String] Never! {
    sorted := [String]{}
    loop value in values {
        if sorted.contains(value) -> next
        index := sorted.len()
        sorted.push(value.copy())
        loop index > 0 && sorted[index - 1] > value {
            sorted[index] = sorted[index - 1]
            index -= 1
        }
        sorted[index] = value
    }
    sorted
}

// `parse_right`: a right with its root canonical and its leaf spelling and
// scope argument kept (`FS.Read("data/")`, `Net("api.example.com")`); `Panic`
// has no leaves.
jet_cli_parse_right: fn(raw: String) -> String? Never! {
    right: authority_parse_right(raw) ?? return None
    split: effect_scope_split(right)
    if split.base.contains(".") && sema_effect_builtin_leaf_unknown(split.base) -> return None
    if split.scope == .Val(scope) && !effect_scope_argument_valid(scope) -> return None
    Val(right)
}

// `covers`: the one covers rule (EffectScope.jet) between canonical rights.
jet_cli_right_covers: fn(raw_bound: String, raw_right: String) -> Bool Never! {
    bound: jet_cli_parse_right(raw_bound) ?? raw_bound.trim()
    right: jet_cli_parse_right(raw_right) ?? raw_right.trim()
    effect_scope_covers(bound, right)
}

jet_cli_covers_any: fn(bounds: [String], right: String) -> Bool Never! {
    loop bound in bounds {
        if jet_cli_right_covers(bound, right) -> return true
    }
    false
}

jet_cli_answer: fn(authority: JetCLIAuthority, right: String) -> JetCLIVerdict Never! {
    if jet_cli_covers_any(authority.denied, right) -> return JetCLIVerdict.Denied
    if jet_cli_covers_any(authority.granted, right) -> return JetCLIVerdict.Allowed
    JetCLIVerdict.Missing
}

// Canonical policy rows.
jet_cli_policy_effects: fn(names: [String]) -> [String] Never! {
    rights := [String]{}
    loop name in names {
        if jet_cli_parse_right(name) == .Val(right) -> rights.push(right)
    }
    jet_cli_sorted_set(rights)
}

// `project_application_effects` plus `merge_invocation_authority`. The
// compile's `entry_effects` are the direct effects of every function its
// checked entry reaches (`entry_effects`, jet_driver_required_effects).
jet_cli_application_authority: fn(result: JetDriverCompileResult, invocation: JetCLIInvocationAuthority?) -> JetCLIAuthority Never! {
    authority := jet_cli_policy_authority(result.entry_effects, result.authority_policy)
    jet_cli_with_invocation(authority, invocation)
    authority
}

// The semantic index's effect roles of `authority`: the program's sets
// without this invocation's `--deny` rows, which only name the refusal.
jet_cli_effect_projection: fn(authority: JetCLIAuthority) -> SemEffectProjection Never! {
    SemEffectProjection{required: authority.required.copy(), granted: authority.granted.copy(), denied: authority.denied.copy(), authority: authority.authority.copy()}
}

// The authority of a program that requires `required` under its package
// `policy`, before this invocation's rows.
jet_cli_policy_authority: fn(required: [String], authority_policy: JetDriverAuthorityPolicy?) -> JetCLIAuthority Never! {
    authority := JetCLIAuthority{required: jet_cli_sorted_set(required), granted: jet_cli_sorted_set(AUTHORITY_AMBIENT_BASIC_EFFECTS), denied: [String]{}, authority: JET_CLI_APPLICATION_DEFAULT, invocation_denied: [String]{}, read_scope: [String]{}}
    policy: authority_policy ?? JetDriverAuthorityPolicy{manifest_path: None, inline_package: false, allow: None, deny: None}
    if policy.manifest_path != None {
        if policy.allow == None && policy.deny == None {
            authority.authority = if policy.inline_package -> JET_CLI_INLINE_PACKAGE_DEFAULT else -> JET_CLI_PACKAGE_DEFAULT
        } else {
            // A written allow row adds to the floor; deny still wins. Its
            // `FS.Read("<path>")` grants hold `FS.Read` itself and confine the
            // run's reads to their paths, as `--allow` rows do; the loader
            // resolved those paths against the manifest's directory.
            allowed: jet_cli_policy_effects(policy.allow ?? [String]{})
            granted := [String]{}
            loop right in AUTHORITY_AMBIENT_BASIC_EFFECTS -> granted.push(right)
            loop right in allowed -> granted.push(right.copy())
            authority.read_scope = policy.read_scope.copy()
            if authority.read_scope.len() > 0 -> granted.push("FS.Read")
            authority.granted = jet_cli_sorted_set(granted)
            authority.denied = jet_cli_policy_effects(policy.deny ?? [String]{})
            authority.authority = if policy.inline_package -> "inline Package authority" else -> "package.jet authority"
        }
    }
    authority
}

// `authority` with this invocation's rows merged in: `-A` grants every
// grantable right, `--allow` its rights, and `--deny` denies, which wins.
// `--allow='FS.Read("<path>")'` grants `FS.Read` itself: the run it launches
// can read only those paths (jet_cli_merged_read_scope).
jet_cli_with_invocation: fn(authority: &JetCLIAuthority, invocation: JetCLIInvocationAuthority?) Never! {
    rows: invocation ?? return
    if !rows.all && rows.allow.len() == 0 && rows.deny.len() == 0 -> return
    // copy: the policy rows stay in `authority` until the merged rows replace them.
    granted := authority.granted.copy()
    if rows.all {
        loop root in authority_grantable_roots() -> granted.push(root)
    }
    loop right in rows.allow -> granted.push(right)
    if jet_cli_read_scope(invocation).len() > 0 -> granted.push("FS.Read")
    // copy: as `granted` above.
    denied := authority.denied.copy()
    loop right in rows.deny -> denied.push(right)
    authority.read_scope = jet_cli_merged_read_scope(authority, rows)
    authority.granted = jet_cli_sorted_set(granted)
    authority.denied = jet_cli_sorted_set(denied)
    authority.invocation_denied = jet_cli_sorted_set(rows.deny)
    authority.authority = "{authority.authority} + CLI invocation"
}

// The rows of `names` that parse as rights (jet_cli_parse_right), in order.
jet_cli_parsed_rights: fn(names: [String]) -> [String] Never! {
    rights := [String]{}
    loop name in names {
        if jet_cli_parse_right(name) == .Val(right) -> rights.push(right)
    }
    rights
}

// The paths `--allow='FS.Read("<path>")'` rows confine a run's reads to: its
// launch lets the program read those files and directories and nothing else
// (Loader.jet x64_confine_reads). Empty when the invocation names none, or
// also lets it read everything (`-A`, `--allow=FS`, `--allow=FS.Read`).
jet_cli_read_scope: fn(invocation: JetCLIInvocationAuthority?) -> [String] Never! {
    rows: invocation ?? return [String]{}
    if rows.all -> return [String]{}
    effect_scope_read_paths(jet_cli_parsed_rights(rows.allow))
}

// The paths a run's reads are confined to once this invocation's `rows` join
// the package policy of `authority` (jet_cli_policy_authority): the policy's
// `FS.Read("<path>")` paths and the invocation's together, as one grant set
// reads them. None when either grants every read (`-A`, a bare `FS` or
// `FS.Read` row): a scoped grant never narrows a bare one.
jet_cli_merged_read_scope: fn(authority: JetCLIAuthority, rows: JetCLIInvocationAuthority) -> [String] Never! {
    if rows.all -> return [String]{}
    allowed: jet_cli_parsed_rights(rows.allow)
    if jet_cli_covers_any(allowed, "FS.Read") -> return [String]{}
    // The policy holds `FS.Read` with no path of its own only when its row
    // grants every read.
    if authority.read_scope.len() == 0 && jet_cli_covers_any(authority.granted, "FS.Read") -> return [String]{}
    // copy: the merged scope is the authority's new row.
    paths := authority.read_scope.copy()
    loop path in effect_scope_read_paths(allowed) {
        if !paths.contains(path) -> paths.push(path)
    }
    paths
}

// The paths a run under the package policy `authority`
// (jet_cli_policy_authority) and `invocation` may read
// (jet_cli_merged_read_scope); empty when its reads are not confined.
jet_cli_run_read_scope: fn(authority: JetCLIAuthority, invocation: JetCLIInvocationAuthority?) -> [String] Never! {
    // copy: the launch owns its scope.
    rows: invocation ?? return authority.read_scope.copy()
    jet_cli_merged_read_scope(authority, rows)
}

// The required rights nobody acknowledged: not one no policy grants (the
// deny-only Panic and Mem roots and Time.Wait leaf, and the task context;
// jet-foundation `authority_needs_no_grant`), not denied, and not granted by
// the floor, the entry package's `allow` row, `--allow` or `-A`. A run names
// these in its notice.
jet_cli_unacknowledged: fn(authority: JetCLIAuthority) -> [String] Never! {
    missing := [String]{}
    loop right in authority.required {
        if !authority_needs_no_grant(right) && jet_cli_answer(authority, right) == JetCLIVerdict.Missing -> missing.push(right.copy())
    }
    jet_cli_named_once(missing)
}

jet_cli_denied_required: fn(authority: JetCLIAuthority) -> [String] Never! {
    rights := [String]{}
    loop right in authority.required {
        if jet_cli_answer(authority, right) == JetCLIVerdict.Denied -> rights.push(right.copy())
    }
    jet_cli_named_once(rights)
}

// `rights` with each right named once: a duplicate goes, and so does a right
// another listed right covers (`FS` beside `FS.Read`/`FS.Write` lists `FS`
// only).
jet_cli_named_once: fn(rights: [String]) -> [String] Never! {
    named := [String]{}
    loop right in rights {
        if named.contains(right) -> next
        covered := false
        loop other in rights {
            if other != right && jet_cli_right_covers(other, right) {
                covered = true
                break
            }
        }
        if !covered -> named.push(right.copy())
    }
    named
}

// Who wrote the deny row a denied right came from.
jet_cli_policy_owner: fn(authority: JetCLIAuthority) -> String Never! {
    name: authority.authority
    if {
        name.starts_with("package.jet") -> "package.jet"
        name.starts_with("inline Package") -> "this file's package block"
        else -> "`{name}`"
    }
}

// Every denied required right comes from this invocation's `--deny`.
jet_cli_denied_by_invocation: fn(authority: JetCLIAuthority, denied: [String]) -> Bool Never! {
    if denied.len() == 0 -> return false
    loop right in denied {
        if !jet_cli_covers_any(authority.invocation_denied, right) -> return false
    }
    true
}

// The `--deny` entries of this invocation that deny one of `denied`.
jet_cli_invocation_denials: fn(authority: JetCLIAuthority, denied: [String]) -> [String] Never! {
    entries := [String]{}
    loop entry in authority.invocation_denied {
        loop right in denied {
            if jet_cli_right_covers(entry, right) {
                entries.push(entry.copy())
                break
            }
        }
    }
    entries
}

// Whether `right` reaches past what a list of effects can describe: `FFI`
// runs native code, and every `Exec` right but the floor's `Exec.Args` and
// `Exec.Exit` starts other programs.
jet_cli_effect_open_ended: fn(right: String) -> Bool Never! {
    root: authority_root(right)
    root == "FFI" || (root == "Exec" && !authority_own_process_leaf(right))
}

// Plain words for what a program does with `right`.
jet_cli_effect_action: fn(right: String) -> String Never! {
    if authority_root(right) == "FFI" -> return "calls native code, which can do anything"
    if jet_cli_effect_open_ended(right) -> return "starts other programs, which this list does not limit"
    authority_effect_action(right)
}

// Plain words for `rights`: the listable actions joined with `and`, then each
// open-ended one (jet_cli_effect_open_ended) as its own clause, since nothing
// after it is a complete list.
jet_cli_effect_words: fn(rights: [String]) -> String Never! {
    listed := [String]{}
    open := [String]{}
    loop right in rights {
        action: jet_cli_effect_action(right)
        if {
            jet_cli_effect_open_ended(right) -> { if !open.contains(action) -> open.push(action) }
            !listed.contains(action) -> listed.push(action)
        }
    }
    clauses := [String]{}
    if listed.len() > 0 -> clauses.push(jet_cli_and_list(listed))
    loop action in open -> clauses.push(action)
    if clauses.len() == 0 -> return "uses no authority"
    clauses.join("; it ")
}

// `items` as prose: `a`, `a and b`, `a, b and c`.
jet_cli_and_list: fn(items: [String]) -> String Never! {
    if items.len() <= 1 -> return if items.len() == 0 -> "" else -> items[0].copy()
    head := [String]{}
    loop index in 0..<(items.len() - 1) -> head.push(items[index])
    "{head.join(", ")} and {items[items.len() - 1]}"
}

// A refusal names what the denied rights do without the notice's open-ended
// remarks: the deny row already stops all of it.
jet_cli_policy_why: fn(authority: JetCLIAuthority) -> String Never! {
    denied: jet_cli_denied_required(authority)
    owner: if jet_cli_denied_by_invocation(authority, denied) -> "this command's `--deny`" else -> jet_cli_policy_owner(authority)
    actions := [String]{}
    loop right in denied {
        action: authority_effect_action(right)
        if !actions.contains(action) -> actions.push(action)
    }
    "This program {jet_cli_and_list(actions)}, and {owner} denies that."
}

jet_cli_policy_fix: fn(authority: JetCLIAuthority) -> String Never! {
    denied: jet_cli_denied_required(authority)
    if jet_cli_denied_by_invocation(authority, denied) -> return "drop `--deny={jet_cli_invocation_denials(authority, denied).join(",")}` from the command to allow it"
    "remove the right from the `deny` row of {jet_cli_policy_owner(authority)}, or stop reaching it"
}

jet_cli_rights_or_none: fn(rights: [String]) -> String Never! {
    if rights.len() == 0 -> "none" else -> rights.join(", ")
}

// `policy_facts`: the structured detail `--json` reports.
jet_cli_policy_facts: fn(authority: JetCLIAuthority) -> String Never! {
    "authority_facts:required_effects={jet_cli_rights_or_none(authority.required)}; granted_effects={jet_cli_rights_or_none(authority.granted)}; denied_effects={jet_cli_rights_or_none(authority.denied)}; denied_required_effects={jet_cli_rights_or_none(jet_cli_denied_required(authority))}; authority={authority.authority}"
}

// E1803 when the policy denies a required right (`policy_refusal`). Every
// other right is allowed: no right waits on a decision.
jet_cli_authority_refusal: fn(authority: JetCLIAuthority) -> Diagnostic? Never! {
    denied: jet_cli_denied_required(authority)
    if denied.len() == 0 -> return None
    diagnostic := diagnostic_from_registry("E1803", None, "application authority denies `{denied.join(", ")}`", jet_cli_policy_why(authority), jet_cli_policy_fix(authority))
    diagnostic.detail = Val(jet_cli_policy_facts(authority))
    diagnostic.denial_kind = Val("authority")
    diagnostic.scope_chain = [String]{authority.authority}
    Val(diagnostic)
}
