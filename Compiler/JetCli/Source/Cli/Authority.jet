// The application authority check of the Jet-hosted `jet build` and `jet run`
// (`resolve_application_authority`; the policy carrier is jet-foundation `ApplicationAuthority` and
// jet-pkg-model `project_application_effects` and `application_policy_diagnostic`). The program's
// required effects are the direct effects of every function the checked entry reaches; its policy
// is the beginner floor, the entry package's `authority`, and the `--allow`/`--deny`/`-A` rows of
// this invocation. A script (a file whose first line is a `#!/...` launch line) runs as `-A` runs a
// program. A required right the policy denies, or one it leaves undecided, stops the command with
// E1803 before anything is built.
use {
    jet_driver.[
        JetDriverAuthorityPolicy,
        JetDriverCompileResult,
    ]
    jet_foundation.[
        AUTHORITY_AMBIENT_BASIC_EFFECTS,
        Diagnostic,
        authority_effect_action,
        authority_grantable_roots,
        authority_inline_package_fix,
        authority_is_deny_only,
        authority_parse_root,
        diagnostic_from_registry,
    ]
    jet_sema.[
        sema_effect_builtin_leaf_unknown,
    ]
}

JET_CLI_APPLICATION_DEFAULT: "application default"
JET_CLI_PACKAGE_DEFAULT: "package.jet default"
JET_CLI_INLINE_PACKAGE_DEFAULT: "inline Package default"

// One application's authority: the sema fact (`required`) and the policy
// facts (`granted`, `denied`, and the policy's name), each a sorted set.
JetCLIAuthority: struct {
    required: [String]
    granted: [String]
    denied: [String]
    authority: String
    // The rights this invocation's `--deny` removed: E1803 names the command
    // line, not the policy, when one of them stops the run.
    invocation_denied: [String]
}

// The `--allow`, `--deny` and `-A` (`--allow-all`) rows of this invocation,
// canonical and in argv order. `all` grants every grantable right; a denial
// still wins over it.
JetCLIInvocationAuthority: struct {
    all: Bool
    allow: [String]
    deny: [String]
}

// A file whose first line is a `#!/...` launch line (`#!/usr/bin/env jet`)
// is a script: it runs with the invoking user's authority, as a shell script
// does. A byte-zero `#!Marker` refusal is not a launch line.
jet_cli_is_script: fn(source: String) -> Bool Never! {
    source.starts_with("#!/")
}

// The invocation rows a build or run of `source` answers with: a script's
// rows are the `-A` rows, so the launch line and the flag are one grant.
jet_cli_source_invocation: fn(source: String, invocation: JetCLIInvocationAuthority?) -> JetCLIInvocationAuthority? Never! {
    // copy: `invocation` stays with the caller (a read parameter); the rows returned own their own.
    rows := invocation.copy()
    if !jet_cli_is_script(source) -> return rows
    granted := rows ?? JetCLIInvocationAuthority{all: false, allow: [String]{}, deny: [String]{}}
    granted.all = true
    Val(granted)
}

JetCLIVerdict: enum { Allowed Denied Missing }

// A sorted set of the values (Rust `BTreeSet<String>`).
jet_cli_sorted_set: fn(values: [String]) -> [String] Never! {
    sorted := [String]{}
    loop value in values {
        if sorted.contains(value) -> next
        index := sorted.len()
        &sorted.push(value)
        loop index > 0 && sorted[index - 1] > value {
            sorted[index] = sorted[index - 1]
            index -= 1
        }
        sorted[index] = value
    }
    sorted
}

// `parse_right`: a right with its root canonical and its leaf spelling kept;
// `Panic` has no leaves.
jet_cli_parse_right: fn(raw: String) -> String? Never! {
    right: raw.trim()
    root: authority_parse_root(right) ?? return None
    if root == "Panic" && right != "Panic" -> return None
    parts: right.split(".").to_list()
    if parts.len() == 1 -> return Val(root)
    canonical: "{root}{right.slice(parts[0].len()..<right.len())}"
    if sema_effect_builtin_leaf_unknown(canonical) -> return None
    Val(canonical)
}

// `covers`: a bound covers itself and every descendant; a resource-qualified
// bound (`FS.Read:/data`) only across a `/` boundary.
jet_cli_right_covers: fn(raw_bound: String, raw_right: String) -> Bool Never! {
    bound: jet_cli_parse_right(raw_bound) ?? raw_bound.trim()
    right: jet_cli_parse_right(raw_right) ?? raw_right.trim()
    if right == bound -> return true
    if !right.starts_with(bound) || right.len() == bound.len() -> return false
    next_byte: right.bytes()[bound.bytes().len()]
    if bound.contains(":") -> return next_byte == (U8{47})
    next_byte == (U8{46}) || next_byte == (U8{58}) || next_byte == (U8{47})
}

jet_cli_covers_any: fn(bounds: [String], right: String) -> Bool Never! {
    loop bound in bounds {
        if jet_cli_right_covers(bound, right) -> return true
    }
    false
}

jet_cli_answer: fn(authority: JetCLIAuthority, right: String) -> JetCLIVerdict Never! {
    if jet_cli_covers_any(authority.denied, right) -> return JetCLIVerdict.Denied
    if jet_cli_covers_any(authority.granted, right) -> return JetCLIVerdict.Allowed
    JetCLIVerdict.Missing
}

// Canonical policy rows.
jet_cli_policy_effects: fn(names: [String]) -> [String] Never! {
    rights := [String]{}
    loop name in names {
        if jet_cli_parse_right(name) == .Val(right) -> &rights.push(right)
    }
    jet_cli_sorted_set(rights)
}

// `project_application_effects` plus `merge_invocation_authority`. The
// compile's `entry_effects` are the direct effects of every function its
// checked entry reaches (`entry_effects`, jet_driver_required_effects).
jet_cli_application_authority: fn(result: JetDriverCompileResult, invocation: JetCLIInvocationAuthority?) -> JetCLIAuthority Never! {
    authority := jet_cli_policy_authority(result.entry_effects, result.authority_policy)
    jet_cli_with_invocation(&authority, invocation)
    authority
}

// The authority of a program that requires `required` under its package
// `policy`, before this invocation's rows.
jet_cli_policy_authority: fn(required: [String], authority_policy: JetDriverAuthorityPolicy?) -> JetCLIAuthority Never! {
    authority := JetCLIAuthority{required: jet_cli_sorted_set(required), granted: jet_cli_sorted_set(AUTHORITY_AMBIENT_BASIC_EFFECTS), denied: [String]{}, authority: JET_CLI_APPLICATION_DEFAULT, invocation_denied: [String]{}}
    policy: authority_policy ?? JetDriverAuthorityPolicy{manifest_path: None, inline_package: false, allow: None, deny: None}
    if policy.manifest_path != None {
        if policy.allow == None && policy.deny == None {
            authority.authority = if policy.inline_package -> JET_CLI_INLINE_PACKAGE_DEFAULT else -> JET_CLI_PACKAGE_DEFAULT
        } else {
            // A written allow row adds to the floor (D-AUTH-AMBIENT3=A); deny still wins.
            granted := [String]{}
            loop right in AUTHORITY_AMBIENT_BASIC_EFFECTS -> &granted.push(right)
            loop right in jet_cli_policy_effects(policy.allow ?? [String]{}) -> &granted.push(right)
            authority.granted = jet_cli_sorted_set(granted)
            authority.denied = jet_cli_policy_effects(policy.deny ?? [String]{})
            authority.authority = if policy.inline_package -> "inline Package authority" else -> "package.jet authority"
        }
    }
    authority
}

// `authority` with this invocation's rows merged in: `-A` grants every
// grantable right, `--allow` its rights, and `--deny` denies, which wins.
jet_cli_with_invocation: fn(authority: &JetCLIAuthority, invocation: JetCLIInvocationAuthority?) Never! {
    rows: invocation ?? return
    // copy: the policy rows stay in `authority` until the merged rows replace them.
    granted := authority.granted.copy()
    if rows.all {
        loop root in authority_grantable_roots() -> &granted.push(root)
    }
    loop right in rows.allow -> &granted.push(right)
    // copy: as `granted` above.
    denied := authority.denied.copy()
    loop right in rows.deny -> &denied.push(right)
    authority.granted = jet_cli_sorted_set(granted)
    authority.denied = jet_cli_sorted_set(denied)
    authority.invocation_denied = jet_cli_sorted_set(rows.deny)
    authority.authority = "{authority.authority} + CLI invocation"
}

// Required rights with no policy verdict. Deny-only rights (the Panic and Mem
// roots and the Time.Wait leaf; jet-foundation `is_deny_only`) may be denied
// but never need a grant. A right another undecided right covers is named once,
// by its parent (`FS` beside `FS.Read`/`FS.Write` lists `FS` only).
jet_cli_undecided: fn(authority: JetCLIAuthority) -> [String] Never! {
    missing := [String]{}
    loop right in authority.required {
        if !authority_is_deny_only(right) && jet_cli_answer(authority, right) == JetCLIVerdict.Missing && !missing.contains(right) -> &missing.push(right)
    }
    rights := [String]{}
    loop right in missing {
        covered := false
        loop other in missing {
            if other != right && jet_cli_right_covers(other, right) {
                covered = true
                break
            }
        }
        if !covered -> &rights.push(right)
    }
    rights
}

jet_cli_denied_required: fn(authority: JetCLIAuthority) -> [String] Never! {
    rights := [String]{}
    loop right in authority.required {
        if jet_cli_answer(authority, right) == JetCLIVerdict.Denied -> &rights.push(right)
    }
    rights
}

jet_cli_is_application_default: fn(authority: JetCLIAuthority) -> Bool Never! {
    authority.authority.starts_with(JET_CLI_APPLICATION_DEFAULT)
}

// A program with no package.jet: the default, or a file's leading
// `package: { … }` block that writes `authority`.
jet_cli_is_manifest_less: fn(authority: JetCLIAuthority) -> Bool Never! {
    jet_cli_is_application_default(authority) || authority.authority.starts_with("inline Package")
}

// The `allow:` row a program writes: every required right the floor does not
// already hold (D-AUTH-AMBIENT3=A). Deny-only rights never appear in a positive
// grant.
jet_cli_inline_allow_row: fn(authority: JetCLIAuthority) -> [String] Never! {
    rights := [String]{}
    loop right in authority.required {
        if authority_is_deny_only(right) || jet_cli_covers_any(AUTHORITY_AMBIENT_BASIC_EFFECTS, right) -> next
        &rights.push(right)
    }
    rights
}

jet_cli_policy_owner: fn(authority: JetCLIAuthority) -> String Never! {
    name: authority.authority
    if {
        jet_cli_is_application_default(authority) -> "the default for a file with no package block"
        name.starts_with(JET_CLI_PACKAGE_DEFAULT) -> "package.jet (which has no authority block)"
        name.starts_with("package.jet") -> "package.jet"
        name.starts_with(JET_CLI_INLINE_PACKAGE_DEFAULT) -> "this file's package block (which has no authority block)"
        name.starts_with("inline Package") -> "this file's package block"
        name.starts_with("jet repl") || name.starts_with("REPL") -> "this REPL session"
        else -> "`{name}`"
    }
}

// Every denied required right comes from this invocation's `--deny`.
jet_cli_denied_by_invocation: fn(authority: JetCLIAuthority, denied: [String]) -> Bool Never! {
    if denied.len() == 0 -> return false
    loop right in denied {
        if !jet_cli_covers_any(authority.invocation_denied, right) -> return false
    }
    true
}

// The `--deny` entries of this invocation that deny one of `denied`.
jet_cli_invocation_denials: fn(authority: JetCLIAuthority, denied: [String]) -> [String] Never! {
    entries := [String]{}
    loop entry in authority.invocation_denied {
        loop right in denied {
            if jet_cli_right_covers(entry, right) {
                &entries.push(entry)
                break
            }
        }
    }
    entries
}

jet_cli_policy_why: fn(authority: JetCLIAuthority) -> String Never! {
    denied: jet_cli_denied_required(authority)
    rights: if denied.len() == 0 -> jet_cli_undecided(authority) else -> denied
    verdict: if denied.len() == 0 -> "has not allowed that yet" else -> "denies that"
    actions := [String]{}
    loop right in rights {
        action: authority_effect_action(right)
        if !actions.contains(action) -> &actions.push(action)
    }
    phrase := "uses no authority"
    if actions.len() == 1 -> phrase = actions[0]
    if actions.len() > 1 {
        head := [String]{}
        loop index in 0..<(actions.len() - 1) -> &head.push(actions[index])
        phrase = "{head.join(", ")} and {actions[actions.len() - 1]}"
    }
    owner: if jet_cli_denied_by_invocation(authority, denied) -> "this command's `--deny`" else -> jet_cli_policy_owner(authority)
    "This program {phrase}, and {owner} {verdict}."
}

// A program with no package.jet edits its leading `package: { … }` block. The
// floor stays granted beside a written row (D-AUTH-AMBIENT3=A), so the row
// names only the undecided rights. `jet fix --all` inserts a missing block
// only, named after `file`.
jet_cli_policy_fix: fn(authority: JetCLIAuthority, file: String) -> String Never! {
    undecided: jet_cli_undecided(authority)
    if undecided.len() > 0 && jet_cli_is_application_default(authority) -> return authority_inline_package_fix(file, undecided)
    if undecided.len() > 0 && jet_cli_is_manifest_less(authority) {
        return "add `allow: [{undecided.join(", ")}]` under `authority` in this file's leading `package: {{ … }}` block; otherwise approve the exact operation once in an interactive terminal"
    }
    denied: jet_cli_denied_required(authority)
    if undecided.len() == 0 && jet_cli_denied_by_invocation(authority, denied) {
        return "drop `--deny={jet_cli_invocation_denials(authority, denied).join(",")}` from the command to allow it"
    }
    step: if undecided.len() == 0 -> "adjust the denial in `authority.deny`" else -> "add `allow: [{undecided.join(", ")}]` under `authority` in `package.jet`"
    "{step}; otherwise deny effects deliberately, or approve the exact operation once or for the project in an interactive terminal"
}

jet_cli_rights_or_none: fn(rights: [String]) -> String Never! {
    if rights.len() == 0 -> "none" else -> rights.join(", ")
}

// `policy_facts`: the structured detail `--json` reports.
jet_cli_policy_facts: fn(authority: JetCLIAuthority) -> String Never! {
    "authority_facts:required_effects={jet_cli_rights_or_none(authority.required)}; granted_effects={jet_cli_rights_or_none(authority.granted)}; denied_effects={jet_cli_rights_or_none(authority.denied)}; denied_required_effects={jet_cli_rights_or_none(jet_cli_denied_required(authority))}; undecided_effects={jet_cli_rights_or_none(jet_cli_undecided(authority))}; authority={authority.authority}"
}

// E1803 when the policy denies or leaves undecided a required right
// (`policy_refusal`; A program with no package.jet leads its Fix with the exact
// `--allow` invocation of `command` and its `-A` form.
jet_cli_authority_refusal: fn(authority: JetCLIAuthority, file: String, command: String) -> Diagnostic? Never! {
    denied: jet_cli_denied_required(authority)
    undecided: jet_cli_undecided(authority)
    if denied.len() == 0 && undecided.len() == 0 -> return None
    what: if denied.len() == 0 -> "application authority is undecided for `{undecided.join(", ")}`" else -> "application authority denies `{denied.join(", ")}`"
    diagnostic := diagnostic_from_registry("E1803", None, what, jet_cli_policy_why(authority), jet_cli_policy_fix(authority, file))
    if denied.len() == 0 && jet_cli_is_manifest_less(authority) {
        fix: diagnostic.fix
        rest: if fix.len() == 0 -> "" else -> "{jet_cli_ascii_lower(fix.slice(0..<1))}{fix.slice(1..<fix.len())}"
        diagnostic.fix = "run `jet {command} --allow={undecided.join(",")} {file}` (or `-A`/`--allow-all` for every effect) to allow it for this run, or {rest}"
    }
    diagnostic.detail = Val(jet_cli_policy_facts(authority))
    diagnostic.denial_kind = Val("authority")
    diagnostic.scope_chain = [String]{authority.authority}
    Val(diagnostic)
}
