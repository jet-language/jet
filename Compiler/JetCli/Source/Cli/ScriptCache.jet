// A `jet run` program, kept in the user cache directory
// (`$XDG_CACHE_HOME/jet/scripts`, else `~/.cache/jet/scripts`), so a rerun
// of unchanged sources runs it without compiling. Keeping is off: a run
// reaches it only while saved work is reused (BUILD_REUSE_SAVED_WORK), so
// `jet file.jet` and `jet run file.jet` compile every time and touch nothing
// under the scripts directory; an `-e` or stdin run still stages its source
// there (jet_cli_entry_file). Each entry file has one
// slot, named by the profile and the entry's path. The slot's record names
// its kept program and what that program was built from:
// - the toolchain: this compiler, its runtime pack and the toolchain tree, and
//   the build options (`checked_alloc` among them), and each Core file the
//   compile read, by file identity (Core built into jet is part of this
//   compiler), and each Core source jet supplies as text beside a toolchain
//   tree (the jet.runtime interface units), by the SHA-256 of that text;
// - a hash of the schema snapshots its checks read, of every file of its
//   authorized source snapshot and of the source tree's shape (the
//   directories its walk enters and its source names; other files a
//   compile never reads), and
//   of the entry path as the command wrote it: the program's fault report
//   finds its source lines through the compilation directory that path
//   names (Host.jet jet_cli_debug_directory), relative to where it ran.
// A rerun whose toolchain and sources match the record runs the program and
// marks the record used. Any other compile replaces the slot, so the cache
// holds one program per entry file, and at most JET_CLI_SCRIPT_KEEP_MAX
// slots, the most recently used. A compile that read a comptime input
// (`embed_file`, `embed_bytes`, `find`) keeps nothing: those files lie
// outside the snapshot, so the record would not name them.
//
// The record names the optimize level its program was built at. A plain run
// compiles at the stock `none`, so it starts quickly. The level is one of the
// build options that name the slot, so a run at another level
// (`--optimize=full`, `-O2`, a profile) keeps its program in a slot of its own,
// and a record whose level is not the run's (a `full` program an earlier
// compiler kept in a plain run's slot) is a miss, so the run compiles again.
use {
    script_crypto: core.crypto
    cli_files: core.files
    cli_sys: core.sys
    cli_time: core.time
    jet_backend.[X64Executable, x64_executable_keep, x64_executable_kept]
    jet_driver.[
        JetDriverAuthorizedSourceSnapshot,
        JetDriverComptimeInputLog,
        JetDriverComptimeInputRecord,
        JetDriverCoreSource,
        JetDriverVerbOutput,
        jet_driver_runtime_interface_sources,
        schema_cache_dir,
    ]
    jet_foundation.[BuildOptions, build_options_key, build_options_value]
    jet_lexer.[TOKEN_COLON, TOKEN_COLON_EQ, TOKEN_DOT, TOKEN_EOF, TOKEN_IDENT, TOKEN_KW_IF, TOKEN_KW_USE, TOKEN_LBRACE, TOKEN_LBRACKET, TOKEN_LPAREN, TOKEN_RBRACE, TOKEN_RBRACKET, TOKEN_RPAREN, TOKEN_SEMI, Token, lex]
    jet_parser.[parse_source]
}

// Names the kept-program records; a new layout is a new name.
JET_CLI_SCRIPT_RECORD: "jet.script-run/v6"

// The rows of a slot record before its toolchain rows: the record name, the
// program file, the sources hash, the optimize level and the five authority
// rows. The toolchain rows end with one row per Core file the compile read.
JET_CLI_SCRIPT_RECORD_HEAD: 9

// The toolchain rows of a record (jet_cli_script_toolchain), before its Core
// rows.
JET_CLI_SCRIPT_TOOLCHAIN_ROWS: 6

// The most slots the cache holds; a keep past it removes the least recently
// used ones.
JET_CLI_SCRIPT_KEEP_MAX: 64

// How long a slot's use mark stands: a rerun within this many nanoseconds of
// the record's last write leaves the record as it is, so back-to-back reruns
// write nothing, and the trim orders slots by use to within ten minutes.
JET_CLI_SCRIPT_USED_GRAIN_NS: 600000000000

// A `jet run` compile whose program is kept when it finishes: its slot, the
// toolchain and sources it started from, the log of the comptime inputs it
// reads, the toolchain tree its Core files come from ("" for the Core built
// into jet), and the Core rows of its request (jet_cli_script_with_core).
JetCLIScriptKeep: struct {
    slot: String
    toolchain: String
    sources: String
    input_log: Shared<JetDriverComptimeInputLog>
    core_root: String
    core: [JetDriverCoreSource]
}

// A toolchain's record rows (jet_cli_script_toolchain) and the toolchain tree
// its Core files come from, "" for the Core built into jet.
JetCLIScriptToolchain: struct {
    rows: String
    core_root: String
}

// The toolchain a kept program was built with, or None when its runtime can't
// be read. The executable and the runtime pack are named by their file
// identities (size, modification time, device, inode), as `make` names its
// inputs. They are not hashed: a rerun compares them with the record's. The
// Core files are not named here: a compile reads only the few its imports
// reach, so the record names those (jet_cli_script_core_rows).
jet_cli_script_toolchain: fn(identity: String, options: BuildOptions, entry: String) -> JetCLIScriptToolchain? {
    core_root: if jet_cli_toolchain_root(entry) == {
        .Found(root) -> root
        .Missing(_, _) -> ""
    }
    runtime_dir: jet_cli_runtime_dir()
    if jet_cli_runtime_key(runtime_dir) == None -> return None
    pack: "{runtime_dir}/{JET_CLI_RUNTIME_PACK_FILE}"
    pack_stat: cli_files.stat(pack) ?? return None
    executable: cli_sys.executable()
    executable_stat: cli_files.stat(executable) ?? return None
    core_row: if core_root == "" -> "core built in" else -> "core {core_root}"
    rows: [String]{
        identity,
        "{executable} {jet_cli_script_file_identity(executable_stat)}",
        jet_cli_host_triple(cli_sys.arch(), cli_sys.name()),
        build_options_key(options),
        "{pack} {jet_cli_script_file_identity(pack_stat)}",
        core_row,
    }
    Val(JetCLIScriptToolchain{rows: rows.join("\n"), core_root: core_root})
}

// The Core files `keep`'s compile read, one row each: its path and file
// identity. Each identity is taken before the file is read again and found to
// hold the text the compile read, so a file that changed during the compile
// keeps nothing (None). A source jet supplied as text (no file) is named by
// its text's hash instead (jet_cli_script_text_identity). Core built into jet
// has no rows: the executable's row names it.
jet_cli_script_core_rows: fn(keep: JetCLIScriptKeep) -> [String]? {
    rows := [String]{}
    if keep.core_root == "" -> return Val(rows)
    loop row in keep.core {
        permit: row.text.guard_read()
        compiled: permit.value.text ?? next
        if permit.value.file == "" {
            rows.push("{row.path} {jet_cli_script_text_identity(compiled)}")
            next
        }
        file: jet_cli_authority_path(keep.core_root, row.path)
        stat: cli_files.stat(file) ?? return None
        if (cli_files.read(file) ?? return None) != compiled -> return None
        rows.push("{row.path} {jet_cli_script_file_identity(stat)}")
    }
    Val(rows)
}

// The record identity of a Core source jet supplies as text: the SHA-256 of
// that text. A file identity starts with its size, so the two never collide.
JET_CLI_SCRIPT_TEXT_IDENTITY: "sha256 "

jet_cli_script_text_identity: fn(text: String) -> String {
    "{JET_CLI_SCRIPT_TEXT_IDENTITY}{script_crypto.sha256(text.bytes()).hex()}"
}

// The identity of the Core source jet supplies as text at `path` today, or
// None when it supplies none there. The supplied sources are the ones
// Request.jet jet_cli_core_sources adds beside the toolchain tree's files.
jet_cli_script_supplied_identity: fn(path: String) -> String? {
    loop source in jet_driver_runtime_interface_sources() {
        if source.path == path -> return Val(jet_cli_script_text_identity(source.source()))
    }
    None
}

// A file's identity in a toolchain row: size, modification time in
// nanoseconds (-1 when out of range), device and inode.
jet_cli_script_file_identity: fn(stat: cli_files.Stat) -> String Never! {
    modified: if stat.modified.to_unix_ns() == {
        .Ok(value) -> value
        .Err(_) -> -1
    }
    "{stat.size} {modified} {stat.id.device} {stat.id.inode}"
}

// `text` appended to `framed` behind its byte length, so no two input lists
// frame to the same bytes.
jet_cli_script_frame: fn(framed: &[U8], text: String) Never! {
    framed.extend("{text.count_bytes()}:".bytes())
    framed.extend(text.bytes())
}

// The schema snapshots a compile of the source root `root` reads, by file identity.
jet_cli_script_schema_inputs: fn(root: String) -> String {
    directory: schema_cache_dir(root)
    listed: cli_files.list_dir(directory) ?? return directory
    names := [String]{}
    loop entry in listed -> names.push(entry.name)
    names.sort()
    rows := [String]{directory}
    loop name in names {
        stat: cli_files.stat("{directory}/{name}") ?? next
        rows.push("{name}\t{jet_cli_identity_key("file", stat)}")
    }
    rows.join("\n")
}

// The hash of the sources a compile of `snapshot` reads, entered as `entered`.
jet_cli_script_sources: fn(entered: String, snapshot: JetDriverAuthorizedSourceSnapshot) -> String {
    framed := [U8]{}
    jet_cli_script_frame(framed, entered)
    jet_cli_script_frame(framed, snapshot.entry_path)
    jet_cli_script_frame(framed, jet_cli_script_schema_inputs(snapshot.roots[0].canonical_path))
    loop root in snapshot.roots {
        jet_cli_script_frame(framed, root.canonical_path)
        loop file in root.files {
            jet_cli_script_frame(framed, file.path)
            jet_cli_script_frame(framed, file.source)
        }
        loop file in root.foreign_cache_files {
            jet_cli_script_frame(framed, file.path)
            jet_cli_script_frame(framed, file.source)
        }
        // Of each retained listing only the names a compile can read: the
        // directories the source walk entered (convention routing reads the
        // tree's shape, empty directories included, through their own
        // listings) and its sources. A directory the walk skips (a hidden one
        // such as the `.jet` a stopping program writes its fault report
        // into, or a skipped or package-bounded one) has no listing, so
        // routing never reads it. That directory, and any other file such as
        // one the program writes beside its source, changes nothing a
        // compile reads, so it must not miss the slot.
        walked := [String]{}
        loop directory in root.directories -> walked.push(directory.path)
        loop directory in root.directories {
            jet_cli_script_frame(framed, directory.path)
            loop entry in directory.entries {
                if entry.is_directory {
                    if walked.contains(entry.path) -> jet_cli_script_frame(framed, "{entry.name}/")
                } else if entry.name.ends_with(".jet") {
                    jet_cli_script_frame(framed, entry.name)
                }
            }
        }
    }
    loop dependency in snapshot.script_dependencies {
        jet_cli_script_frame(framed, "{dependency.name}@{dependency.resolved_version}#{dependency.content_hash}")
    }
    script_crypto.sha256(framed).hex()
}

// The slot of the entry file `entry_path` under the build options. A new compiler
// replaces the program in the same slot (the record's toolchain names it),
// so compilers that come and go don't add programs.
jet_cli_script_slot: fn(options: BuildOptions, entry_path: String) -> String Never! {
    framed := [U8]{}
    jet_cli_script_frame(framed, build_options_key(options))
    jet_cli_script_frame(framed, entry_path)
    script_crypto.sha256(framed).hex()
}

// The directory kept programs live in, or None when there is no user cache
// directory.
jet_cli_script_cache_dir: fn() -> String? {
    if cli_sys.get("XDG_CACHE_HOME") == .Val(cache) {
        if cache.starts_with("/") -> return Val("{cache}/jet/scripts")
    }
    home: cli_sys.home_dir() ?? return None
    Val("{home}/.cache/jet/scripts")
}

// The entry file `jet -e CODE` runs: CODE as the body of `run: fn`, its
// statements on lines of their own (jet_cli_eval_lines), its declarations
// above `run: fn` (jet_cli_eval_items), kept as the `eval` entry file of its
// source (jet_cli_entry_file). The file holds CODE as written, but for a
// final value `if` (jet_cli_eval_final_if), and opens with `use core` when
// CODE reads a Core module by its full name (jet_cli_eval_names_core): the
// compile request of an `eval` entry file (Request.jet jet_cli_driver_request)
// shows the value of its last statement (JetSema Calls/Direct.jet
// sema_eval_entry_show).
jet_cli_eval_file: fn(code: String) -> String? {
    lines: jet_cli_eval_lines(code)
    split: jet_cli_eval_items(lines)
    items: if jet_cli_eval_names_core(lines) -> "use core\n{split.items}" else -> split.items
    at: jet_cli_eval_final_if(split.body) ?? return jet_cli_entry_file("eval", "{items}{JET_CLI_EVAL_HEAD}{split.body}\n}}\n")
    head: jet_cli_repl_bytes(split.body, 0, at)
    tail: jet_cli_repl_bytes(split.body, at, split.body.count_bytes())
    jet_cli_entry_file("eval", "{items}{JET_CLI_EVAL_HEAD}{head}({tail})\n}}\n")
}

// The opening of the `run: fn` an `-e` body goes in.
JET_CLI_EVAL_HEAD: "run: fn() {{\n"

// Whether `lines` reads a Core module by its full name
// (`core.files.exists("out.txt")`) and binds no `core` of its own (`use core`,
// `use core: …`, `core: …`, `core := …`). A one-liner has no room for a `use`
// line, so its entry file gets `use core`, which binds the Core root as a
// namespace, as it does in a file.
jet_cli_eval_names_core: fn(lines: String) -> Bool Never! {
    tokens: lex(lines.bytes()).tokens
    reads := false
    loop (index, token) in tokens {
        if token.kind != TOKEN_IDENT || jet_cli_repl_bytes(lines, token.span.start, token.span.end) != "core" -> next
        before: if index > 0 -> tokens[index - 1].kind else -> TOKEN_EOF
        after: if index + 1 < tokens.len() -> tokens[index + 1].kind else -> TOKEN_EOF
        if (before == TOKEN_KW_USE && after != TOKEN_DOT) || after == TOKEN_COLON || after == TOKEN_COLON_EQ -> return false
        if after == TOKEN_DOT && before != TOKEN_DOT -> reads = true
    }
    reads
}

// Where the final `if` of `body` starts when that `if` is a value: `->`
// branches with an `else`, or a dispatch (`if x == { … }`). The body of
// `run: fn` has no result, so there such an `if` reads as a statement whose
// value arms are E0003; in parentheses (jet_cli_eval_file) it is the value
// the code ends in, and the `(` before it keeps every line number. The final
// `if` opens the last line at bracket depth zero that starts with `if`, and
// runs to the end of `body`. It counts only when a body with a result reads
// it, `run`'s body does not and the parenthesized form does, so a statement
// `if`, a syntax error and any other code stay as written. None otherwise.
jet_cli_eval_final_if: fn(body: String) -> Int? Never! {
    bytes: body.bytes()
    tokens: lex(bytes).tokens
    starts: jet_cli_eval_line_starts(bytes, tokens)
    start := -1
    line := 0
    loop token in tokens {
        if token.kind == TOKEN_EOF -> break
        if line < starts.len() && token.span.start >= starts[line] {
            if token.kind == TOKEN_KW_IF -> start = token.span.start
            loop line < starts.len() && starts[line] <= token.span.start {
                line += 1
            }
        }
    }
    if start < 0 -> return None
    tail: jet_cli_repl_bytes(body, start, bytes.len())
    if jet_cli_eval_parses(tail, "") || !jet_cli_eval_parses(tail, " -> Int") || !jet_cli_eval_parses("({tail})", "") -> return None
    Val(start)
}

// Whether `body` parses with no error as the body of a `run` function whose
// result is spelled `result` ("" for none).
jet_cli_eval_parses: fn(body: String, result: String) -> Bool Never! {
    parsed: parse_source("run: fn(){result} {{\n{body}\n}}\n".bytes())
    jet_cli_errors(parsed.diagnostics).len() == 0
}

// `lines` parted as a REPL cell parts its input: each line at bracket depth
// zero that parses alone as declarations (a type, a function, an impl, a
// `use`) is an item, in order; every other line, a binding such as `x: 1`
// included, stays in the body.
jet_cli_eval_items: fn(lines: String) -> (items: String, body: String) Never! {
    bytes: lines.bytes()
    starts: jet_cli_eval_line_starts(bytes, lex(bytes).tokens)
    items := ""
    body := [String]{}
    loop (index, start) in starts {
        end: if index + 1 < starts.len() -> starts[index + 1] - 1 else -> bytes.len()
        line: jet_cli_repl_bytes(lines, start, end)
        if jet_cli_eval_declares(line) {
            items += "{line}\n"
            next
        }
        body.push(line)
    }
    (items: items, body: body.join("\n"))
}

// The offsets at which the lines of `bytes` (lexed as `tokens`) at bracket
// depth zero start, the first line's 0 included.
jet_cli_eval_line_starts: fn(bytes: [U8], tokens: [Token]) -> [Int] Never! {
    starts := [Int]{0}
    depth := 0
    previous := 0
    loop token in tokens {
        if token.kind == TOKEN_EOF -> break
        if depth == 0 {
            loop at in previous..<token.span.start {
                if bytes[at] == (U8{10}) && starts[starts.len() - 1] < at + 1 -> starts.push(at + 1)
            }
        }
        if token.kind == TOKEN_LBRACE || token.kind == TOKEN_LPAREN || token.kind == TOKEN_LBRACKET -> depth += 1
        if (token.kind == TOKEN_RBRACE || token.kind == TOKEN_RPAREN || token.kind == TOKEN_RBRACKET) && depth > 0 -> depth -= 1
        previous = token.span.end
    }
    starts
}

// Whether `line` alone parses as declarations and nothing else: no
// constant, which in a body is the binding it spells.
jet_cli_eval_declares: fn(line: String) -> Bool Never! {
    parsed: parse_source(line.bytes())
    if jet_cli_errors(parsed.diagnostics).len() > 0 -> return false
    if parsed.program.items.len() == 0 && parsed.program.imports.len() == 0 -> return false
    loop item in parsed.program.items {
        if item == .Const(_) -> return false
    }
    true
}

// The entry file that holds `source`, a program given on the command line
// (`jet -e`) or on standard input (`jet run -`): under the kept programs'
// `kind` directory and named by its content hash, so a rerun of the same
// source is the same entry file and runs its kept program. It is written
// beside its place and renamed into it, so a concurrent run never reads part
// of it. None when there is no user cache directory to hold it.
jet_cli_entry_file: fn(kind: String, source: String) -> String? {
    scripts: jet_cli_script_cache_dir() ?? return None
    directory: "{scripts}/{kind}"
    path: "{directory}/{script_crypto.sha256(source.bytes()).hex()}.jet"
    if cli_files.read(path) == .Ok(kept) {
        if kept == source -> return Val(path)
    }
    cli_files.create_dir_all(directory) ?? return None
    staged: "{path}.{cli_sys.pid()}"
    cli_files.write(staged, source) ?? return None
    if cli_files.rename(staged, path) == .Err(_) {
        cli_files.remove(staged).drop("a staged entry file is never read")
        return None
    }
    Val(path)
}

// Whether `file` is the entry file `jet run -` wrote for its piped source
// (jet_cli_entry_file's `stdin` kind). The command named that program `-`.
jet_cli_stdin_entry: fn(file: String) -> Bool Never! {
    jet_cli_kept_entry(file, "stdin")
}

// Whether `file` is an entry file of jet_cli_entry_file's `kind`: a 64-digit
// content hash under `jet/scripts/<kind>`.
jet_cli_kept_entry: fn(file: String, kind: String) -> Bool Never! {
    if !file.ends_with(".jet") -> return false
    raw: file.bytes()
    stem: raw.len() - 4 - 64
    if stem < 0 -> return false
    head: String.from_bytes(raw[0..<stem]) ?? return false
    if !head.ends_with("/jet/scripts/{kind}/") -> return false
    loop byte in raw[stem..<(stem + 64)] {
        code: Int{byte}
        if !((code >= 48 && code <= 57) || (code >= 97 && code <= 102)) -> return false
    }
    true
}

// `jet -e` code with each `;` that separates statements made a line break,
// the boundary a file writes; a `;` inside a string or comment stays.
jet_cli_eval_lines: fn(code: String) -> String Never! {
    semicolons := [Int]{}
    loop token in lex(code.bytes()).tokens {
        if token.kind == TOKEN_SEMI -> semicolons.push(token.span.start)
    }
    bytes: code.bytes()
    lines := [U8]{}
    loop at in 0..<bytes.len() -> lines.push(if semicolons.contains(at) -> U8{10} else -> bytes[at])
    String.from_bytes(lines) ?? code.copy()
}

// A slot record: the program file it names, the sources hash, the optimize
// level the program was built at, the program's authority (its required
// rights, its package policy and the paths that policy confines its reads to,
// one row each, so a rerun checks this invocation's rows as a compile would),
// then the toolchain rows and the rows of the Core files the compile read
// (jet_cli_script_core_rows). The read paths are tab-separated: a scope
// argument can hold a comma but never a tab (effect_scope_argument_valid).
jet_cli_script_record_encode: fn(program: String, keep: JetCLIScriptKeep, level: String, authority: JetCLIAuthority, core_rows: [String]) -> String Never! {
    head: "{JET_CLI_SCRIPT_RECORD}\n{program}\n{keep.sources}\n{level}\n{authority.required.join(",")}\n{authority.granted.join(",")}\n{authority.denied.join(",")}\n{authority.authority}\n{authority.read_scope.join("\t")}\n{keep.toolchain}"
    if core_rows.len() == 0 -> return head
    "{head}\n{core_rows.join("\n")}"
}

jet_cli_script_rights: fn(row: String) -> [String] Never! {
    if row == "" -> return [String]{}
    row.split(",").to_list()
}

// The program file a slot record names, when the record is complete.
jet_cli_script_record_program: fn(rows: [String]) -> String? Never! {
    if rows.len() <= JET_CLI_SCRIPT_RECORD_HEAD || rows[0] != JET_CLI_SCRIPT_RECORD -> return None
    program: rows[1]
    if program == "" || program.contains("/") -> return None
    Val(program)
}

// The program kept in `keep`'s slot for exactly its toolchain, sources and
// optimize level, to run with this invocation's authority; None when the
// slot holds no such program, so the file compiles. The kept program runs
// from memory as a compiled one does, or from the file `binary` (Host.jet
// jet_cli_run_step). A program a concurrent keep removed before it was read
// is a miss too.
jet_cli_script_kept_run: fn(keep: JetCLIScriptKeep, file: String, source: String, binary: String, color: Bool, json: Bool, options: BuildOptions, program_args: [String], invocation: JetCLIInvocationAuthority?) -> JetCLIRunStep? {
    directory: jet_cli_script_cache_dir() ?? return None
    record: "{directory}/{keep.slot}.run"
    text: cli_files.read(record) ?? return None
    rows: text.split("\n").to_list()
    program: jet_cli_script_record_program(rows) ?? return None
    if !jet_cli_script_record_matches(rows, keep) || rows[3] != build_options_value(options, "optimize") -> return None
    executable: x64_executable_kept("{directory}/{program}") ?? return None
    read_scope: if rows[8] == "" -> [String]{} else -> rows[8].split("\t").to_list()
    authority := JetCLIAuthority{required: jet_cli_script_rights(rows[4]), granted: jet_cli_script_rights(rows[5]), denied: jet_cli_script_rights(rows[6]), authority: rows[7], invocation_denied: [String]{}, read_scope: read_scope}
    jet_cli_with_invocation(authority, invocation)
    refused: jet_cli_authority_report(file, source, color, json, authority)
    if refused.move() == .Val(report) -> return Val(JetCLIRunStep.Output{output: report})
    stopped: jet_cli_effect_notice(file, source, authority, invocation, color, json)
    if stopped.move() == .Val(output) -> return Val(JetCLIRunStep.Output{output: output})
    jet_cli_script_used(record, text)
    Val(JetCLIRunStep.Launch{executable: executable.move(), file: file, binary: binary, program_args: program_args, options: options, invocation: invocation, read_scope: authority.read_scope.copy(), verbose: false, color: color})
}

// Whether the complete slot record `rows` names exactly `keep`'s sources and
// toolchain, each Core file it names still has the identity it records, and
// each Core source jet supplies as text still hashes as recorded.
jet_cli_script_record_matches: fn(rows: [String], keep: JetCLIScriptKeep) -> Bool {
    end: JET_CLI_SCRIPT_RECORD_HEAD + JET_CLI_SCRIPT_TOOLCHAIN_ROWS
    if rows[2] != keep.sources || rows.len() < end || rows[JET_CLI_SCRIPT_RECORD_HEAD..<end].join("\n") != keep.toolchain -> return false
    loop row in rows[end..<rows.len()] {
        named: row.partition(" ")
        if named.tail.starts_with(JET_CLI_SCRIPT_TEXT_IDENTITY) {
            supplied: jet_cli_script_supplied_identity(named.head) ?? return false
            if supplied != named.tail -> return false
            next
        }
        stat: cli_files.stat(jet_cli_authority_path(keep.core_root, named.head)) ?? return false
        if jet_cli_script_file_identity(stat) != named.tail -> return false
    }
    true
}

// Mark the slot record `record`, whose text is `text`, as just used, so the
// oldest-used slots are the ones trimmed (jet_cli_script_record_put). A record
// written less than JET_CLI_SCRIPT_USED_GRAIN_NS ago is already marked, so
// the rerun leaves it alone. A keep that replaced the record meanwhile is
// undone, leaving the next run to compile again (its program may be gone).
jet_cli_script_used: fn(record: String, text: String) {
    status: cli_files.stat(record) ?? return
    written: status.modified.to_unix_ns() ?? return
    since: cli_time.unix_ns() - written
    if since >= 0 && since < JET_CLI_SCRIPT_USED_GRAIN_NS -> return
    _: jet_cli_script_record_put(record, text)
}

// Put the slot record `text` at `record`: written beside it, the old record
// removed, then renamed into the free name, so a concurrent run reads a whole
// record or none, and none compiles again. A rename over an existing file
// would make ext4 write the new file's data out first (auto_da_alloc), which
// on a busy disk waits on its journal far longer than the run. Returns
// whether the record is in place.
jet_cli_script_record_put: fn(record: String, text: String) -> Bool {
    staged: "{record}.{cli_sys.pid()}"
    cli_files.write(staged, text) ?? return false
    cli_files.remove(record).drop("a slot without a record has nothing to remove")
    if cli_files.rename(staged, record) == .Err(_) {
        cli_files.remove(staged).drop("a staged record is never read")
        return false
    }
    true
}

// Remove the least recently used slots of `directory` past
// JET_CLI_SCRIPT_KEEP_MAX, each record before its program, so the cache
// stays bounded however many entry files run. A run that read a removed
// record before its removal finds the program gone and compiles again.
jet_cli_script_trim: fn(directory: String) {
    listed: cli_files.list_dir(directory) ?? return
    names := [String]{}
    used := [Int]{}
    latest := 0
    loop entry in listed {
        if !entry.name.ends_with(".run") -> next
        status: cli_files.stat("{directory}/{entry.name}") ?? next
        modified: status.modified.to_unix_ns() ?? next
        names.push(entry.name)
        used.push(modified)
        if modified > latest -> latest = modified
    }
    // The oldest-used slot, one at a time; a removed one counts as newer than
    // any.
    excess := names.len() - JET_CLI_SCRIPT_KEEP_MAX
    loop excess > 0 {
        excess -= 1
        oldest := 0
        loop index in 1..<names.len() {
            if used[index] < used[oldest] -> oldest = index
        }
        used[oldest] = latest + 1
        record: "{directory}/{names[oldest]}"
        text: cli_files.read(record) ?? next
        cli_files.remove(record) ?? next
        if jet_cli_script_record_program(text.split("\n").to_list()) == .Val(program) {
            cli_files.remove("{directory}/{program}").drop("a run reads its program whole before it runs")
        }
    }
}

// The keeper of a `jet run` compile of `snapshot`; None keeps nothing (no
// compiler identity, or a toolchain that can't be read).
jet_cli_script_keeper: fn(entered: String, options: BuildOptions, snapshot: JetDriverAuthorizedSourceSnapshot) -> JetCLIScriptKeep? {
    identity: jet_cli_compiler_identity() ?? return None
    toolchain: jet_cli_script_toolchain(identity, options, snapshot.entry_path) ?? return None
    Val(JetCLIScriptKeep{
        slot: jet_cli_script_slot(options, snapshot.entry_path),
        toolchain: toolchain.rows,
        sources: jet_cli_script_sources(entered, snapshot),
        input_log: Shared{JetDriverComptimeInputLog{records: [JetDriverComptimeInputRecord]{}}},
        core_root: toolchain.core_root,
        core: [JetDriverCoreSource]{},
    })
}

// `keep` with the Core rows `prepared` compiles against. A copied row shares
// its text cell, so once the compile ends the rows show which Core files it
// read (jet_cli_script_core_rows).
jet_cli_script_with_core: fn(keep: JetCLIScriptKeep?, prepared: JetCLIPrepared) -> JetCLIScriptKeep? {
    kept := (keep ?? return None).copy()
    if prepared == .Prepared(request, _) -> kept.core = request.core_sources.copy()
    Val(kept.move())
}

// The comptime input log a kept compile records into.
jet_cli_script_input_log: fn(keep: JetCLIScriptKeep?) -> Shared<JetDriverComptimeInputLog>? Never! {
    kept: keep ?? return None
    // copy: the compile and the keeper share the one log.
    Val(kept.input_log.copy())
}

jet_cli_script_inputs_read: fn(log: Shared<JetDriverComptimeInputLog>) -> Int Never! {
    permit: log.guard_read()
    permit.value.records.len()
}

// Keep the program `executable` that `keep`'s compile built at the optimize
// `level`, with its `authority` before any invocation rows, in place of the
// slot's previous one, in the kept form (Image/Loader.jet
// x64_executable_keep: its program part, not a copy of the runtime image).
// Nothing is kept when the compile read a comptime input or walked a `find`,
// an empty one too (its glob is a record of its own). The record names
// the toolchain the compile started from and the Core files it read, so a
// toolchain that changed while it compiled leaves a record no later run
// matches. The program goes to a
// file of its own, named by the slot, this process and its sources. Each file
// is written beside its place and renamed into it, and the record last
// (jet_cli_script_record_put), so a concurrent run never sees a partial one.
// A cache that can't be written leaves the next run to compile again.
// Returns whether the program was kept.
jet_cli_script_keep: fn(keep: JetCLIScriptKeep, executable: X64Executable, authority: JetCLIAuthority, level: String) -> Bool {
    if jet_cli_script_inputs_read(keep.input_log) > 0 -> return false
    core_rows: jet_cli_script_core_rows(keep) ?? return false
    directory: jet_cli_script_cache_dir() ?? return false
    cli_files.create_dir_all(directory) ?? return false
    record: "{directory}/{keep.slot}.run"
    previous: if cli_files.read(record) == {
        .Ok(text) -> jet_cli_script_record_program(text.split("\n").to_list())
        .Err(_) -> None
    }
    pid: cli_sys.pid()
    program: "{keep.slot}-{pid}-{keep.sources}"
    staged: "{directory}/{program}.tmp"
    if x64_executable_keep(executable, staged) != "" {
        cli_files.remove(staged).drop("a partial program is never named by a record")
        return false
    }
    cli_files.rename(staged, "{directory}/{program}") ?? return false
    if !jet_cli_script_record_put(record, jet_cli_script_record_encode(program, keep, level, authority, core_rows)) -> return false
    if previous == .Val(old) {
        if old != program -> cli_files.remove("{directory}/{old}").drop("a stale program only takes space")
    }
    jet_cli_script_trim(directory)
    true
}
