// A `jet run` program, kept in the user cache directory
// (`$XDG_CACHE_HOME/jet/scripts`, else `~/.cache/jet/scripts`), so a rerun
// of unchanged sources runs it without compiling. Each entry file has one
// slot, named by the profile and the entry's path. The slot's record names
// its kept program and what that program was built from:
// - the toolchain: this compiler, its runtime pack and the Core sources, by
//   file identity, and the build options (`checked_alloc` among them);
// - a hash of the schema snapshots its checks read, of every file of its
//   authorized source snapshot and of the source tree's shape (the
//   directories its walk enters and its source names; other files a
//   compile never reads), and
//   of the entry path as the command wrote it: the program's fault report
//   finds its source lines through the compilation directory that path
//   names (Host.jet jet_cli_debug_directory), relative to where it ran.
// A rerun whose toolchain and sources match the record runs the program and
// marks the record used. Any other compile replaces the slot, so the cache
// holds one program per entry file, and at most JET_CLI_SCRIPT_KEEP_MAX
// slots, the most recently used. A compile that read a comptime input
// (`embed_file`, `embed_bytes`, `find`) keeps nothing: those files lie
// outside the snapshot, so the record would not name them.
//
// The record names the optimize level its program was built at. A plain run
// compiles at the stock `none`, so the first run starts quickly. A rerun that
// reuses a `none` program whose level no profile or flag chose also starts one
// background build of the same sources at `full` (jet_cli_script_promote),
// which keeps its program in the same slot. From then on a rerun runs the
// `full` program. Every level means the same, so only speed changes.
use {
    script_crypto: core.crypto
    cli_files: core.files
    cli_process: core.process
    cli_sys: core.sys
    cli_time: core.time
    jet_backend.[X64Executable, x64_executable_keep, x64_executable_kept, x64_file_spawn_detached]
    jet_driver.[
        JetDriverAuthorizedSourceSnapshot,
        JetDriverComptimeInputLog,
        JetDriverComptimeInputRecord,
        JetDriverVerbOutput,
        schema_cache_dir,
    ]
    jet_foundation.[BuildOptionLayer, BuildOptions, CORE_SOURCE_OWNED_ROWS, build_options_key]
    jet_lexer.[TOKEN_SEMI, lex]
}

// Names the kept-program records; a new layout is a new name.
JET_CLI_SCRIPT_RECORD: "jet.script-run/v4"

// The rows of a slot record before its toolchain rows: the record name, the
// program file, the sources hash, the optimize level and the four authority
// rows.
JET_CLI_SCRIPT_RECORD_HEAD: 8

// Set in the background `full` build of a reused `none` program to its slot:
// that `jet run` compiles, keeps and exits without running the program
// (Host.jet jet_cli_compile_promoted).
JET_CLI_SCRIPT_PROMOTE_ENV: "JET_RUN_FULL_BUILD"

// The level a background build keeps, and the level it replaces.
JET_CLI_SCRIPT_LEVEL_FULL: "full"
JET_CLI_SCRIPT_LEVEL_NONE: "none"

// The most slots the cache holds; a keep past it removes the least recently
// used ones.
JET_CLI_SCRIPT_KEEP_MAX: 64

// How long a slot's use mark stands: a rerun within this many nanoseconds of
// the record's last write leaves the record as it is, so back-to-back reruns
// write nothing, and the trim orders slots by use to within ten minutes.
JET_CLI_SCRIPT_USED_GRAIN_NS: 600000000000

// A `jet run` compile whose program is kept when it finishes: its slot, the
// toolchain and sources it started from, and the log of the comptime inputs
// it reads. `core_files` is whether the toolchain read found every Core row
// a regular file, so the request need not check them again
// (jet_cli_core_sources).
JetCLIScriptKeep: struct {
    slot: String
    toolchain: String
    core_files: Bool
    sources: String
    input_log: Shared<JetDriverComptimeInputLog>
}

// A toolchain's record rows (jet_cli_script_toolchain) and whether each of
// its Core rows is a regular file.
JetCLIScriptToolchain: struct {
    rows: String
    core_files: Bool
}

// The toolchain a kept program was built with, or None when this compiler
// has no toolchain root for `entry` (jet_cli_toolchain_root) or its Core sources or runtime can't be read. The
// Core files and the runtime pack are named by their file identities (size,
// modification time, device, inode), as `make` names its inputs. They are
// not hashed: a rerun compares them with the record's.
jet_cli_script_toolchain: fn(identity: String, options: BuildOptions, entry: String) -> JetCLIScriptToolchain? {
    toolchain: if jet_cli_toolchain_root(entry) == {
        .Found(root) -> root
        .Missing(_, _) -> { return None }
    }
    runtime_dir: jet_cli_runtime_dir()
    if jet_cli_runtime_key(runtime_dir) == None -> return None
    pack: "{runtime_dir}/{JET_CLI_RUNTIME_PACK_FILE}"
    pack_stat: cli_files.stat(pack) ?? return None
    executable: cli_sys.executable()
    executable_stat: cli_files.stat(executable) ?? return None
    rows := [String]{
        identity,
        "{executable} {jet_cli_script_file_identity(executable_stat)}",
        jet_cli_host_triple(cli_sys.arch(), cli_sys.name()),
        build_options_key(options),
        "{pack} {jet_cli_script_file_identity(pack_stat)}",
        toolchain,
    }
    core_files := true
    loop row in CORE_SOURCE_OWNED_ROWS {
        stat: cli_files.stat(jet_cli_authority_path(toolchain, row.path)) ?? return None
        if !stat.is_file -> core_files = false
        rows.push("{row.path} {jet_cli_script_file_identity(stat)}")
    }
    Val(JetCLIScriptToolchain{rows: rows.join("\n"), core_files: core_files})
}

// A file's identity in a toolchain row: size, modification time in
// nanoseconds (-1 when out of range), device and inode.
jet_cli_script_file_identity: fn(stat: cli_files.Stat) -> String Never! {
    modified: if stat.modified.to_unix_ns() == {
        .Ok(value) -> value
        .Err(_) -> -1
    }
    "{stat.size} {modified} {stat.id.device} {stat.id.inode}"
}

// `text` appended to `framed` behind its byte length, so no two input lists
// frame to the same bytes.
jet_cli_script_frame: fn(framed: &[U8], text: String) Never! {
    framed.extend("{text.count_bytes()}:".bytes())
    framed.extend(text.bytes())
}

// The schema snapshots a compile of the source root `root` reads, by file identity.
jet_cli_script_schema_inputs: fn(root: String) -> String {
    directory: schema_cache_dir(root)
    listed: cli_files.list_dir(directory) ?? return directory
    names := [String]{}
    loop entry in listed -> names.push(entry.name)
    names.sort()
    rows := [String]{directory}
    loop name in names {
        stat: cli_files.stat("{directory}/{name}") ?? next
        rows.push("{name}\t{jet_cli_identity_key("file", stat)}")
    }
    rows.join("\n")
}

// The hash of the sources a compile of `snapshot` reads, entered as `entered`.
jet_cli_script_sources: fn(entered: String, snapshot: JetDriverAuthorizedSourceSnapshot) -> String {
    framed := [U8]{}
    jet_cli_script_frame(framed, entered)
    jet_cli_script_frame(framed, snapshot.entry_path)
    jet_cli_script_frame(framed, jet_cli_script_schema_inputs(snapshot.roots[0].canonical_path))
    loop root in snapshot.roots {
        jet_cli_script_frame(framed, root.canonical_path)
        loop file in root.files {
            jet_cli_script_frame(framed, file.path)
            jet_cli_script_frame(framed, file.source)
        }
        loop file in root.foreign_cache_files {
            jet_cli_script_frame(framed, file.path)
            jet_cli_script_frame(framed, file.source)
        }
        // Of each retained listing only the names a compile can read: the
        // directories the source walk entered (convention routing reads the
        // tree's shape, empty directories included, through their own
        // listings) and its sources. A directory the walk skips (a hidden one
        // such as the `.jet` a stopping program writes its fault report
        // into, or a skipped or package-bounded one) has no listing, so
        // routing never reads it. That directory, and any other file such as
        // one the program writes beside its source, changes nothing a
        // compile reads, so it must not miss the slot.
        walked := [String]{}
        loop directory in root.directories -> walked.push(directory.path)
        loop directory in root.directories {
            jet_cli_script_frame(framed, directory.path)
            loop entry in directory.entries {
                if entry.is_directory {
                    if walked.contains(entry.path) -> jet_cli_script_frame(framed, "{entry.name}/")
                } else if entry.name.ends_with(".jet") {
                    jet_cli_script_frame(framed, entry.name)
                }
            }
        }
    }
    loop dependency in snapshot.script_dependencies {
        jet_cli_script_frame(framed, "{dependency.name}@{dependency.resolved_version}#{dependency.content_hash}")
    }
    script_crypto.sha256(framed).hex()
}

// The slot of the entry file `entry_path` under the build options. A new compiler
// replaces the program in the same slot (the record's toolchain names it),
// so compilers that come and go don't add programs.
jet_cli_script_slot: fn(options: BuildOptions, entry_path: String) -> String Never! {
    framed := [U8]{}
    jet_cli_script_frame(framed, build_options_key(options))
    jet_cli_script_frame(framed, entry_path)
    script_crypto.sha256(framed).hex()
}

// The directory kept programs live in, or None when there is no user cache
// directory.
jet_cli_script_cache_dir: fn() -> String? {
    if cli_sys.get("XDG_CACHE_HOME") == .Val(cache) {
        if cache.starts_with("/") -> return Val("{cache}/jet/scripts")
    }
    home: cli_sys.home_dir() ?? return None
    Val("{home}/.cache/jet/scripts")
}

// The entry file `jet -e CODE` runs: CODE as the body of `run: fn`, its
// statements on lines of their own (jet_cli_eval_lines), kept as the `eval`
// entry file of its source (jet_cli_entry_file).
jet_cli_eval_file: fn(code: String) -> String? {
    jet_cli_entry_file("eval", "run: fn() {{\n{jet_cli_eval_lines(code)}\n}}\n")
}

// The entry file that holds `source`, a program given on the command line
// (`jet -e`) or on standard input (`jet run -`): under the kept programs'
// `kind` directory and named by its content hash, so a rerun of the same
// source is the same entry file and runs its kept program. It is written
// beside its place and renamed into it, so a concurrent run never reads part
// of it. None when there is no user cache directory to hold it.
jet_cli_entry_file: fn(kind: String, source: String) -> String? {
    scripts: jet_cli_script_cache_dir() ?? return None
    directory: "{scripts}/{kind}"
    path: "{directory}/{script_crypto.sha256(source.bytes()).hex()}.jet"
    if cli_files.read(path) == .Ok(kept) {
        if kept == source -> return Val(path)
    }
    cli_files.create_dir_all(directory) ?? return None
    staged: "{path}.{cli_sys.pid()}"
    cli_files.write(staged, source) ?? return None
    if cli_files.rename(staged, path) == .Err(_) {
        cli_files.remove(staged).drop("a staged entry file is never read")
        return None
    }
    Val(path)
}

// Whether `file` is the entry file `jet run -` wrote for its piped source
// (jet_cli_entry_file's `stdin` kind). The command named that program `-`.
jet_cli_stdin_entry: fn(file: String) -> Bool Never! {
    jet_cli_kept_entry(file, "stdin")
}

// Whether `file` is an entry file of jet_cli_entry_file's `kind`: a 64-digit
// content hash under `jet/scripts/<kind>`.
jet_cli_kept_entry: fn(file: String, kind: String) -> Bool Never! {
    if !file.ends_with(".jet") -> return false
    raw: file.bytes()
    stem: raw.len() - 4 - 64
    if stem < 0 -> return false
    head: String.from_bytes(raw[0..<stem]) ?? return false
    if !head.ends_with("/jet/scripts/{kind}/") -> return false
    loop byte in raw[stem..<(stem + 64)] {
        code: Int.from_u8(byte)
        if !((code >= 48 && code <= 57) || (code >= 97 && code <= 102)) -> return false
    }
    true
}

// `jet -e` code with each `;` that separates statements made a line break,
// the boundary a file writes; a `;` inside a string or comment stays.
jet_cli_eval_lines: fn(code: String) -> String Never! {
    semicolons := [Int]{}
    loop token in lex(code.bytes()).tokens {
        if token.kind == TOKEN_SEMI -> semicolons.push(token.span.start)
    }
    bytes: code.bytes()
    lines := [U8]{}
    loop at in 0..<bytes.len() -> lines.push(if semicolons.contains(at) -> U8{10} else -> bytes[at])
    String.from_bytes(lines) ?? code.copy()
}

// A slot record: the program file it names, the sources hash, the optimize
// level the program was built at, the program's authority (its required
// rights and its package policy, one row each, so a rerun checks this
// invocation's rows as a compile would), then the toolchain rows.
jet_cli_script_record_encode: fn(program: String, keep: JetCLIScriptKeep, level: String, authority: JetCLIAuthority) -> String Never! {
    "{JET_CLI_SCRIPT_RECORD}\n{program}\n{keep.sources}\n{level}\n{authority.required.join(",")}\n{authority.granted.join(",")}\n{authority.denied.join(",")}\n{authority.authority}\n{keep.toolchain}"
}

jet_cli_script_rights: fn(row: String) -> [String] Never! {
    if row == "" -> return [String]{}
    row.split(",").to_list()
}

// The program file a slot record names, when the record is complete.
jet_cli_script_record_program: fn(rows: [String]) -> String? Never! {
    if rows.len() <= JET_CLI_SCRIPT_RECORD_HEAD || rows[0] != JET_CLI_SCRIPT_RECORD -> return None
    program: rows[1]
    if program == "" || program.contains("/") -> return None
    Val(program)
}

// The program kept in `keep`'s slot for exactly its toolchain and sources,
// to run with this invocation's authority; None when the slot holds no such
// program, so the file compiles. The kept program runs from memory as a
// compiled one does, or from the file `binary` (Host.jet jet_cli_run_step). A
// program a concurrent keep removed before it was read is a miss too. A
// reused `none` program whose level the options left at the stock starts its
// `full` build (jet_cli_script_promote).
jet_cli_script_kept_run: fn(keep: JetCLIScriptKeep, file: String, source: String, binary: String, color: Bool, json: Bool, options: BuildOptions, program_args: [String], invocation: JetCLIInvocationAuthority?) -> JetCLIRunStep? {
    directory: jet_cli_script_cache_dir() ?? return None
    record: "{directory}/{keep.slot}.run"
    text: cli_files.read(record) ?? return None
    rows: text.split("\n").to_list()
    program: jet_cli_script_record_program(rows) ?? return None
    if !jet_cli_script_record_matches(rows, keep) -> return None
    executable: x64_executable_kept("{directory}/{program}") ?? return None
    authority := JetCLIAuthority{required: jet_cli_script_rights(rows[4]), granted: jet_cli_script_rights(rows[5]), denied: jet_cli_script_rights(rows[6]), authority: rows[7], invocation_denied: [String]{}}
    jet_cli_with_invocation(authority, invocation)
    refused: jet_cli_authority_report(file, source, color, json, authority)
    if refused.move() == .Val(report) -> return Val(JetCLIRunStep.Output{output: report})
    jet_cli_effect_notice(file, authority, json)
    jet_cli_script_used(record, text)
    if rows[3] == JET_CLI_SCRIPT_LEVEL_NONE && jet_cli_script_level_stock(options) -> jet_cli_script_promote(directory, keep, file)
    Val(JetCLIRunStep.Launch{executable: executable.move(), file: file, binary: binary, program_args: program_args, options: options, invocation: invocation, verbose: false, color: color})
}

// Whether the complete slot record `rows` names exactly `keep`'s sources and
// toolchain.
jet_cli_script_record_matches: fn(rows: [String], keep: JetCLIScriptKeep) -> Bool Never! {
    rows[2] == keep.sources && rows[JET_CLI_SCRIPT_RECORD_HEAD..<rows.len()].join("\n") == keep.toolchain
}

// Whether `options` leave the optimize level at its stock value: no profile
// and no flag chose it, so a background build may raise it.
jet_cli_script_level_stock: fn(options: BuildOptions) -> Bool Never! {
    loop choice in options.values {
        if choice.name == "optimize" -> return choice.layer == BuildOptionLayer.Stock
    }
    false
}

// The lock file of `slot`'s background `full` build in `directory`: a build
// holds its lock while it runs; the file stays until the slot is trimmed.
jet_cli_script_promote_lock: fn(directory: String, slot: String) -> String Never! {
    "{directory}/{slot}.full"
}

// The file a failed background build of `slot` leaves, naming the sources it
// failed on; a later build of the slot removes it once it keeps its program.
jet_cli_script_promote_failed: fn(directory: String, slot: String) -> String Never! {
    "{directory}/{slot}.failed"
}

// Start the background `full` build of `keep`'s sources: this `jet` again with
// the same arguments and environment, with JET_CLI_SCRIPT_PROMOTE_ENV naming
// the slot, as a daemon in the idle I/O class (x64_file_spawn_detached). The
// start leaves this `jet` no thread and no child, so the reused program then
// runs in its place as a compiled one does (Host.jet jet_cli_launch), with
// its pid and its signals, and the build is never the program's child nor in
// its terminal's process group. `jet run -` is given its entry `file` in
// place of the `-`, as the build has no standard input to read. None starts
// while a build holds the slot's lock, or after one failed on these sources.
// A build that was killed leaves the `none` program in use, and a later rerun
// starts it again.
jet_cli_script_promote: fn(directory: String, keep: JetCLIScriptKeep, file: String) {
    if cli_files.read(jet_cli_script_promote_failed(directory, keep.slot)) == .Ok(text) {
        if text == keep.sources -> return
    }
    // `??` leaves on an error and on None, the lock a running build holds.
    // The build takes the lock itself; one started twice finds it held, or
    // finds the slot already holding the `full` program.
    lock: cli_files.try_lock(jet_cli_script_promote_lock(directory, keep.slot)) ?? return
    close(lock)
    arguments := cli_process.args()
    if jet_cli_stdin_source_at(arguments) == .Val(at) -> arguments[at] = file.copy()
    jet: cli_sys.executable()
    argv := [String]{jet}
    loop argument in arguments -> argv.push(argument)
    // A build that can't start leaves the `none` program in use.
    _ := x64_file_spawn_detached(jet, argv, jet_cli_launch_env([JetCLIEnvVar]{JetCLIEnvVar{name: JET_CLI_SCRIPT_PROMOTE_ENV, value: keep.slot}}))
}

// The lock of `keep`'s background build when this process is that build and
// the slot still holds the `none` program of exactly its sources and
// toolchain; None leaves the build to stop.
jet_cli_script_promotion: fn(keep: JetCLIScriptKeep) -> cli_files.FileLock? {
    if cli_sys.get(JET_CLI_SCRIPT_PROMOTE_ENV) != Val(keep.slot) -> return None
    directory: jet_cli_script_cache_dir() ?? return None
    lock: cli_files.try_lock(jet_cli_script_promote_lock(directory, keep.slot)) ?? return None
    if !jet_cli_script_promotable("{directory}/{keep.slot}.run", keep) {
        close(lock)
        return None
    }
    Val(lock)
}

// Whether `record` names the `none` program of exactly `keep`'s sources and
// toolchain.
jet_cli_script_promotable: fn(record: String, keep: JetCLIScriptKeep) -> Bool {
    text: cli_files.read(record) ?? return false
    rows: text.split("\n").to_list()
    if jet_cli_script_record_program(rows) == None -> return false
    jet_cli_script_record_matches(rows, keep) && rows[3] == JET_CLI_SCRIPT_LEVEL_NONE
}

// End the background build holding `lock`: a kept `full` program removes the
// slot's failure file, any other end writes it naming the sources.
jet_cli_script_promoted: fn(lock: &&cli_files.FileLock, keep: JetCLIScriptKeep, kept: Bool) {
    if jet_cli_script_cache_dir() == .Val(directory) {
        failed: jet_cli_script_promote_failed(directory, keep.slot)
        if kept {
            cli_files.remove(failed).drop("most builds never failed")
        } else {
            cli_files.write(failed, keep.sources).drop("an unwritten failure lets a later rerun try again")
        }
    }
    close(lock.move())
}

// Mark the slot record `record`, whose text is `text`, as just used, so the
// oldest-used slots are the ones trimmed (jet_cli_script_record_put). A record
// written less than JET_CLI_SCRIPT_USED_GRAIN_NS ago is already marked, so
// the rerun leaves it alone. A keep that replaced the record meanwhile is
// undone, leaving the next run to compile again (its program may be gone).
jet_cli_script_used: fn(record: String, text: String) {
    status: cli_files.stat(record) ?? return
    written: status.modified.to_unix_ns() ?? return
    since: cli_time.unix_ns() - written
    if since >= 0 && since < JET_CLI_SCRIPT_USED_GRAIN_NS -> return
    _: jet_cli_script_record_put(record, text)
}

// Put the slot record `text` at `record`: written beside it, the old record
// removed, then renamed into the free name, so a concurrent run reads a whole
// record or none, and none compiles again. A rename over an existing file
// would make ext4 write the new file's data out first (auto_da_alloc), which
// on a busy disk waits on its journal far longer than the run. Returns
// whether the record is in place.
jet_cli_script_record_put: fn(record: String, text: String) -> Bool {
    staged: "{record}.{cli_sys.pid()}"
    cli_files.write(staged, text) ?? return false
    cli_files.remove(record).drop("a slot without a record has nothing to remove")
    if cli_files.rename(staged, record) == .Err(_) {
        cli_files.remove(staged).drop("a staged record is never read")
        return false
    }
    true
}

// Remove the least recently used slots of `directory` past
// JET_CLI_SCRIPT_KEEP_MAX, each record before its program, its background
// build's lock file and its failure file, so the cache stays bounded however
// many entry files run. A run that read a removed record before its removal
// finds the program gone and compiles again.
jet_cli_script_trim: fn(directory: String) {
    listed: cli_files.list_dir(directory) ?? return
    names := [String]{}
    used := [Int]{}
    latest := 0
    loop entry in listed {
        if !entry.name.ends_with(".run") -> next
        status: cli_files.stat("{directory}/{entry.name}") ?? next
        modified: status.modified.to_unix_ns() ?? next
        names.push(entry.name)
        used.push(modified)
        if modified > latest -> latest = modified
    }
    // The oldest-used slot, one at a time; a removed one counts as newer than
    // any.
    excess := names.len() - JET_CLI_SCRIPT_KEEP_MAX
    loop excess > 0 {
        excess -= 1
        oldest := 0
        loop index in 1..<names.len() {
            if used[index] < used[oldest] -> oldest = index
        }
        used[oldest] = latest + 1
        record: "{directory}/{names[oldest]}"
        text: cli_files.read(record) ?? next
        cli_files.remove(record) ?? next
        if jet_cli_script_record_program(text.split("\n").to_list()) == .Val(program) {
            cli_files.remove("{directory}/{program}").drop("a run reads its program whole before it runs")
        }
        // A slot name is hex, so the record's name before its dot.
        slot: names[oldest].split(".").to_list()[0]
        cli_files.remove(jet_cli_script_promote_lock(directory, slot)).drop("a slot never rerun had no background build")
        cli_files.remove(jet_cli_script_promote_failed(directory, slot)).drop("most slots never had a failed build")
    }
}

// The keeper of a `jet run` compile of `snapshot`; None keeps nothing (no
// compiler identity, or a toolchain that can't be read).
jet_cli_script_keeper: fn(entered: String, options: BuildOptions, snapshot: JetDriverAuthorizedSourceSnapshot) -> JetCLIScriptKeep? {
    identity: jet_cli_compiler_identity() ?? return None
    toolchain: jet_cli_script_toolchain(identity, options, snapshot.entry_path) ?? return None
    Val(JetCLIScriptKeep{
        slot: jet_cli_script_slot(options, snapshot.entry_path),
        toolchain: toolchain.rows,
        core_files: toolchain.core_files,
        sources: jet_cli_script_sources(entered, snapshot),
        input_log: shared JetDriverComptimeInputLog{records: [JetDriverComptimeInputRecord]{}},
    })
}

// The comptime input log a kept compile records into.
jet_cli_script_input_log: fn(keep: JetCLIScriptKeep?) -> Shared<JetDriverComptimeInputLog>? Never! {
    kept: keep ?? return None
    // copy: the compile and the keeper share the one log.
    Val(kept.input_log.copy())
}

// Whether `keep`'s toolchain read found every Core row a regular file.
jet_cli_script_core_files: fn(keep: JetCLIScriptKeep?) -> Bool Never! {
    kept: keep ?? return false
    kept.core_files
}

jet_cli_script_inputs_read: fn(log: Shared<JetDriverComptimeInputLog>) -> Int Never! {
    permit: log.guard_read()
    permit.value.records.len()
}

// Keep the program `executable` that `keep`'s compile built at the optimize
// `level`, with its `authority` before any invocation rows, in place of the
// slot's previous one, in the kept form (Image/Loader.jet
// x64_executable_keep: its program part, not a copy of the runtime image).
// Nothing is kept when the compile read a comptime input. The record names
// the toolchain the compile started from, so a toolchain that changed while
// it compiled leaves a record no later run matches. The program goes to a
// file of its own, named by the slot, this process and its sources. Each file
// is written beside its place and renamed into it, and the record last
// (jet_cli_script_record_put), so a concurrent run never sees a partial one.
// A cache that can't be written leaves the next run to compile again.
// Returns whether the program was kept.
jet_cli_script_keep: fn(keep: JetCLIScriptKeep, executable: X64Executable, authority: JetCLIAuthority, level: String) -> Bool {
    if jet_cli_script_inputs_read(keep.input_log) > 0 -> return false
    directory: jet_cli_script_cache_dir() ?? return false
    cli_files.create_dir_all(directory) ?? return false
    record: "{directory}/{keep.slot}.run"
    previous: if cli_files.read(record) == {
        .Ok(text) -> jet_cli_script_record_program(text.split("\n").to_list())
        .Err(_) -> None
    }
    pid: cli_sys.pid()
    program: "{keep.slot}-{pid}-{keep.sources}"
    staged: "{directory}/{program}.tmp"
    if x64_executable_keep(executable, staged) != "" {
        cli_files.remove(staged).drop("a partial program is never named by a record")
        return false
    }
    cli_files.rename(staged, "{directory}/{program}") ?? return false
    if !jet_cli_script_record_put(record, jet_cli_script_record_encode(program, keep, level, authority)) -> return false
    if previous == .Val(old) {
        if old != program -> cli_files.remove("{directory}/{old}").drop("a stale program only takes space")
    }
    jet_cli_script_trim(directory)
    true
}
