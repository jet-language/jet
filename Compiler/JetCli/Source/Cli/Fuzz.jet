// Source/CmdCompile.rs::run_fuzz: generated property evidence belongs to
// the ordinary test contract; the retired command is a teaching error.
use jet_driver.[JET_DRIVER_EXIT_USAGE]

fn jet_cli_fuzz(file: String, test_name: String?, iterations: Int?, color: Bool) -> JetCLIPlan Never! {
    replacement := "jet test --grade=generated"
    if iterations == .Val(count) -> replacement = "{replacement} --iterations={count}"
    replacement = "{replacement} {file}"
    if test_name == .Val(name) -> replacement = "{replacement} {name}"
    jet_cli_fail("E2104", "`jet fuzz` is not a command; use `{replacement}`", jet_cli_why("E2104"), "correct the named argument or input, then run the command again", color, JET_DRIVER_EXIT_USAGE)
}
