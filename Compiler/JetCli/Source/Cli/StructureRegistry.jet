// The Core rows `jet inspect structure core` prints (bootstrap steps, root
// types, module declarations) are generated from Compiler/Prelude/Core.jet into
// CoreStructureRows.jet.
JetCLICoreBootstrap: struct {
    name: String
    dependencies: [String]
}
JetCLIStructureRegistryRow: struct {
    name: String
    safe_direction: String
    gates: [String]
}

JET_CLI_STRUCTURE_ROWS: [JetCLIStructureRegistryRow]{
    {name: "Structure.Liveness", safe_direction: "gain", gates: [String]{"_name"}},
    {name: "Structure.Lifecycle", safe_direction: "shrink", gates: [String]{"policy allow"}},
    {name: "Structure.ImportEdge", safe_direction: "shrink", gates: [String]{"manifest rule edit"}},
}
