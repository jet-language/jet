// CmdDevTools.rs::run_data_bind. Inference/rendering use the canonical
// Jetpack PackageModel data binders, already ported on origin/port/compiler.
use core.files as binding_files
// PackageModel's shared data binder imports this Core codec under `json`.
use core.encoding.json as json
use jet_driver.[JET_DRIVER_EXIT_OK, JET_DRIVER_EXIT_USAGE, JET_DRIVER_EXIT_USER_ERROR]
use jetpack_foundation.[foundation_generated_snake_name]
use jet_pkg_model.[pkg_generate_data]

fn jet_cli_data_bind_usage(format: String) -> String Never! {
    "usage: jet inspect bind {format} <input> [--type <Type>] [-o <output>]\n"
}

fn jet_cli_data_bind_argument_error(format: String, what: String, color: Bool) -> JetCLIPlan Never! {
    shared :: jet_cli_diagnostic_copy("E2102")
    jet_cli_done("", "{jet_cli_report("E2102", what, shared.why, shared.fix, color)}{jet_cli_data_bind_usage(format)}", JET_DRIVER_EXIT_USAGE)
}

fn jet_cli_data_bind_io_error(format: String, path: String, operation: String, why: String, color: Bool) -> JetCLIPlan Never! {
    jet_cli_fail("E2105", "Could not {operation} {format} bindings at {path}.", "{why}.", "check the input and output paths, permissions, and available disk space, then rerun `jet inspect bind {format}`.", color, JET_DRIVER_EXIT_USER_ERROR)
}

fn jet_cli_binding_generated_command(source: String) -> String? Never! {
    loop raw in source.split("\n") {
        raw_bytes :: raw.bytes()
        carriage :: raw_bytes.len() > 0 && raw_bytes[raw_bytes.len() - 1] == (U8{13})
        line :: if carriage -> raw.slice(0..<(raw.len() - 1)) else -> raw
        if line.starts_with("// generated by: ") -> return Val(line)
    }
    None
}

struct JetCLIDataBindJob {
    format: String
    input_path: String
    input: String
    root_type: String?
    output: String?
    color: Bool
}

enum JetCLIDataBindPreparation {
    Done(plan: JetCLIPlan)
    Prepared(job: JetCLIDataBindJob)
}

// The host selects Loader::selected_project_root after reading the input.
// Nearest-package discovery is not equivalent: workspace/repository win.
fn jet_cli_data_bind_prepare(format: String, args: [String], color: Bool) -[FS]> JetCLIDataBindPreparation Never! {
    if args.len() == 0 {
        return JetCLIDataBindPreparation.Done{plan: jet_cli_done("", jet_cli_data_bind_usage(format), JET_DRIVER_EXIT_USAGE)}
    }
    if args[0] == "--help" || args[0] == "-h" {
        return JetCLIDataBindPreparation.Done{plan: jet_cli_done("", jet_cli_data_bind_usage(format), JET_DRIVER_EXIT_OK)}
    }
    input_path :: args[0]
    root_type := String?{None}
    output := String?{None}
    index := 1
    loop index < args.len() {
        argument :: args[index]
        if argument == "--type" || argument == "-o" || argument == "--out" {
            flag :: if argument == "--type" -> "--type" else -> "-o"
            if index + 1 >= args.len() {
                return JetCLIDataBindPreparation.Done{plan: jet_cli_data_bind_argument_error(format, "inspect bind {format} requires a value after {flag}", color)}
            }
            value :: args[index + 1]
            if value == "" {
                field :: if argument == "--type" -> "type name" else -> "output path"
                return JetCLIDataBindPreparation.Done{plan: jet_cli_data_bind_argument_error(format, "inspect bind {format} {field} cannot be empty", color)}
            }
            if argument == "--type" -> root_type = Val(value) else -> output = Val(value)
            index += 2
        } else {
            return JetCLIDataBindPreparation.Done{plan: jet_cli_data_bind_argument_error(format, "unknown inspect bind {format} argument {argument}", color)}
        }
    }
    input :: binding_files.read(input_path) ?? return JetCLIDataBindPreparation.Done{plan: jet_cli_data_bind_io_error(format, input_path, "read", "the input could not be read ({err})", color)}
    JetCLIDataBindPreparation.Prepared{job: JetCLIDataBindJob{format: format, input_path: input_path, input: input, root_type: root_type, output: output, color: color}}
}

// selected_root is canonical for a default output and unused for explicit -o.
fn jet_cli_data_bind_finish(job: JetCLIDataBindJob, selected_root: String) -[FS, Env, Time]> JetCLIPlan Never! {
    format :: job.format
    input_path :: job.input_path
    output :: job.output
    root_type :: job.root_type
    color :: job.color
    output_path := output ?? ""
    if output == .None {
        base :: jet_cli_file_name(input_path.replace("\\", "/"))
        stem :: jet_cli_stem(base)
        safe :: foundation_generated_snake_name(stem, "schema")
        output_path = jet_cli_entry_join(selected_root, ".jet/bindings/{safe}.jet")
    }
    command := [String]{"jet", "inspect", "bind", format, input_path}
    if root_type == .Val(name) {
        &command.push("--type")
        &command.push(name)
    }
    if output == .Val(path) {
        &command.push("-o")
        &command.push(path)
    }
    result :: pkg_generate_data(format, input_path, job.input, root_type, command.join(" ")) ?? return jet_cli_fail("E3208", "Could not generate {format} bindings from {input_path}.", "{err.message}.", "provide a well-formed {format} schema and rerun `jet inspect bind {format}`.", color, JET_DRIVER_EXIT_USER_ERROR)
    if output == .None {
        held :: JetCLIRootedDirectory.open(selected_root, [String]{".jet", "bindings"}, true) ?? return jet_cli_data_bind_io_error(format, output_path, "create", err.message, color)
        owner :: held.lock("binding output") ?? return jet_cli_data_bind_io_error(format, output_path, "write", err.message, color)
        name :: jet_cli_file_name(output_path)
        prior :: if held.read(name, Int.MAX) == {
            .Val(bytes) -> Val(bytes)
            .None -> None
            .Err(error) -> { return jet_cli_data_bind_io_error(format, output_path, "inspect", error.message, color) }
        }
        if prior == .Val(bytes) {
            existing :: String.from_bytes(bytes) ?? return jet_cli_data_bind_io_error(format, output_path, "inspect", "the existing output is not UTF-8", color)
            if jet_cli_binding_generated_command(result.source) != jet_cli_binding_generated_command(existing) {
                return jet_cli_fail("E2104", "the default {format} binding output `{output_path}` is already in use", "sanitizing `{input_path}` produces the same output name as an existing binding", "rerun with `-o <different-output>` to choose an explicit path", color, JET_DRIVER_EXIT_USER_ERROR)
            }
        }
        held.replace(name, result.source.bytes(), None) ?? return jet_cli_data_bind_io_error(format, output_path, "write", err.message, color)
    } else {
        parent :: jet_cli_parent(output_path) ?? ""
        if parent != "" {
            binding_files.create_dir_all(parent) ?? return jet_cli_data_bind_io_error(format, output_path, "create", "could not create output directory {parent} ({err})", color)
        }
        binding_files.write(output_path, result.source) ?? return jet_cli_data_bind_io_error(format, output_path, "write", "could not write {output_path} ({err})", color)
    }
    plural :: if result.record_count == 1 -> "" else -> "s"
    jet_cli_done("bound {result.record_count} {format} record{plural} from {input_path} → {output_path}\n", "", JET_DRIVER_EXIT_OK)
}
