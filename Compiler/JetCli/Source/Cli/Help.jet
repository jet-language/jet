// Source/main.rs `help`: one renderer for `jet help <command>` and the
// command's --help spelling. Order validation is independent of output
// selection, so invalid --sort still reports a usage error under --json.
fn jet_cli_help(jet_argv: [String], args: [String], bespoke: String?, color: Bool, json: Bool) -> JetCLIPlan Never! {
    order :: jet_cli_help_order(jet_argv)
    if !jet_cli_is_help_order(order) -> return jet_cli_bad_help_order(order, color)
    if args.len() > 1 -> return jet_cli_renderable(bespoke ?? jet_cli_command_help(args[1]), json)
    jet_cli_renderable(jet_cli_usage_page(order), json)
}
