// Rust: Source/Compiler.rs:1085
fn syntax_node_value(node: SyntaxNode) -> CtValue {
    kind :: if node.kind == {
        .Function -> "function"
        .Struct -> "struct"
        .Enum -> "enum"
        .Trait -> "trait"
        .Tag -> "tag"
        .Effect -> "effect"
        .Impl -> "impl"
        .Const -> "const"
        .Test -> "test"
        .ExternRust -> "extern_rust"
        .Module -> "module"
        .CModule -> "c_module"
        .CodeModule -> "code_module"
        .ErrorConversion -> "error_conversion"
        .Migration -> "migration"
        .State -> "state"
        .Protocol -> "protocol"
        .Derive -> "derive"
        .GenericModule -> "generic_module"
        .ModuleAlias -> "module_alias"
        .Distinct -> "distinct"
        .TypeAlias -> "type_alias"
        .UnitFamily -> "unit_family"
        .Marker -> "marker"
        .Fact -> "fact"
        .TemplateLoop -> "template_loop"
    }
    ct_struct("CompilerNode", [("kind", CtValue.Str(kind)), ("name", compiler_option_string(node.name)), ("span", span_value(node.span))])
}
