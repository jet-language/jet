// Rust: Source/Compiler.rs:218
fn checked_inline_package(resolver: AuthorityResolver) -> (CheckedFile, Package.Blocks.InlinePackageBlock, String)? PackageReadError! {
    candidates :: [OSPath.from(Syntax.DEFAULT_ENTRY_FILE), OSPath.from("src").join(Syntax.DEFAULT_ENTRY_FILE)]
    loop relative in candidates {
        file :: if resolver.checked_file(relative) == {
            .Ok(file) -> file
            .Err(error) -> {
                if error.is_missing() -> continue
                return Err(authority_read_error(Syntax.PACKAGE_FILE, "could not read the inline package carrier", error))
            }
        }
        record_checked_file(file)
        source :: file.text().map_err(error -> authority_read_error(Syntax.PACKAGE_FILE,
            "could not decode the inline package carrier", error))?
        block :: Package.extract_inline_package(source).map_err(inline_carrier_error)?
        resolver.revalidate_file(file).map_err(error -> authority_read_error(Syntax.PACKAGE_FILE,
            "the inline package carrier changed while it was being read", error))?
        if block == .Val(block) -> return Ok(.Val((file, block, source)))
    }
    Ok(.None)
}
// Rust: Source/Compiler.rs:267
fn inline_package_facts(resolver: AuthorityResolver, carrier: CheckedFile, block: Package.Blocks.InlinePackageBlock,
    source: String) -> Package.PackageFacts PackageReadError! {
    facts := Package.PackageFacts.parse_uncomposed(block.body(source), carrier.path.display().to_string()).map_err(inline_parse_error)?
    facts.compose_configs(resolver.root()).map_err(error -> inline_authority_error(carrier, "could not compose the inline package facts", error.to_string()))?
    facts.validate_guarantees().map_err(error -> inline_authority_error(carrier, "could not validate the inline package facts", error.to_string()))?
    facts.validate_defaults().map_err(error -> inline_authority_error(carrier, "could not validate the inline package defaults", error.to_string()))?
    facts.validate_members_in(resolver.root()).map_err(error -> inline_authority_error(carrier, "could not validate the inline package members", error.to_string()))?
    Ok(facts)
}
