fn compiler_symbol_kind_value(kind: jet_semindex.SymbolKind) -> CtValue {
    (kind_name, params, ret, fields, variants, parent, mutable, ty) :: if kind == {
        .Module -> ("module", [], .None, [], [], .None, .None, .None)
        .Function{params, ret, ..} -> ("function", params.iter().map(pair -> ct_struct("CompilerParam",
            [("name", CtValue.Str(pair.0)), ("ty", CtValue.Str(pair.1))])).collect(), ret, [], [], .None, .None, .None)
        .Struct{fields} -> ("struct", [], .None, fields.iter().map(pair -> ct_struct("CompilerField",
            [("name", CtValue.Str(pair.0)), ("ty", CtValue.Str(pair.1))])).collect(), [], .None, .None, .None)
        .Enum{variants} -> ("enum", [], .None, [], variants, .None, .None, .None)
        .Trait -> ("trait", [], .None, [], [], .None, .None, .None)
        .Tag -> ("tag", [], .None, [], [], .None, .None, .None)
        .Type -> ("type", [], .None, [], [], .None, .None, .None)
        .Const -> ("const", [], .None, [], [], .None, .None, .None)
        .EnumVariant{parent} -> ("enum_variant", [], .None, [], [], .Val(parent), .None, .None)
        .Field{ty, parent} -> ("field", [], .None, [], [], .Val(parent), .None, .Val(ty))
        .Local{mutable, ty} -> ("local", [], .None, [], [], .None, .Val(mutable), ty)
        .Param{ty} -> ("param", [], .None, [], [], .None, .None, .Val(ty))
    }
    ct_struct("CompilerSymbolKind", [("kind", CtValue.Str(kind_name)), ("params", CtValue.List(params)),
        ("ret", compiler_option_string(ret)), ("fields", CtValue.List(fields)), ("variants", compiler_string_list(variants)),
        ("parent", compiler_option_string(parent)), ("mutable", mutable.map_or(CtValue.absent(Type.Bool),
            value -> CtValue.Present(CtValue.Bool(value)))), ("ty", compiler_option_string(ty))])
}
