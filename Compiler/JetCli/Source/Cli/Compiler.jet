fn record_inline_package_inputs(resolver: AuthorityResolver, carrier: CheckedFile, facts: Package.PackageFacts) -> Unit PackageReadError! {
    record_checked_file(carrier)
    loop path in facts.resolved_config_paths {
        file :: resolver.checked_file(OSPath.from(path)).map_err(cause -> authority_read_error(Syntax.PACKAGE_FILE,
            "could not revalidate an inline package configuration input", cause))?
        record_checked_file(file)
    }
    Ok(())
}
// Rust: Source/Compiler.rs:326
fn record_checked_file(file: CheckedFile) -> Unit {
    // GATE #4494: native path separator and checked descriptor bytes.
    path :: file.relative.to_string_lossy().replace(std.path.MAIN_SEPARATOR, "/")
    Comptime.record_package_input(path, SHA256.sha256_hex(file.bytes))
}
