// D-FRONTENDAPI1=A: decline other Core modules; preserve ordinary evaluation.
// Rust: Source/Compiler.rs:854
pub fn eval_core_call(module: String, method: String, args: [CtValue], span: Span) -> (CtValue Diagnostic!)? {
    eval_core_call_with_type(module, method, args, span, .None, .None)
}
// Ambient variant carries resolved return type for typed absence payloads.
// Rust: Source/Compiler.rs:866
pub fn eval_core_call_with_type(module: String, method: String, args: [CtValue], span: Span,
    _resolved_ret: Type?, _sink: DevSink?) -> (CtValue Diagnostic!)? {
    if module == "core.build" {
        result :: if (method, args.as_slice()) == {
            ("graph", [plan]) -> Comptime.Build.eval_build_graph(plan, span)
            ("receipt_diff", [before, after]) -> Comptime.Build.eval_build_receipt_diff(before, after, span)
            else -> Err(Diagnostic.error("E3502", "unsupported core.build operation `{method}`",
                "core.build exposes only the checked graph and receipt diff queries",
                "call `core.build.graph` with one BuildPlan or `core.build.receipt_diff` with two BuildGraph values", .Val(span)))
        }
        return .Val(result)
    }
    if module != "core.compiler" -> return .None
    if method == "manifest" || method == "package" || method == "lock" || method == "profiles" {
        if !args.is_empty() {
            return .Val(Ok(CtValue.failed(compiler_package_error_value(PackageReadError.new("E0956", "",
                "`core.compiler.{method}` takes no arguments",
                "call the package view from `fn build` or a comptime binding without a path argument")))))
        }
        root_option :: Comptime.package_read_root()
        if root_option.is_none() {
            return .Val(Ok(CtValue.failed(compiler_package_error_value(PackageReadError.new("E0956", "",
                "`core.compiler.{method}` is available only during package-aware compile-time evaluation",
                "call the package view from `fn build` or a comptime binding; the compiler pins the package root for you")))))
        }
        root :: root_option.unwrap()
        result :: if method == {
            "manifest" -> read_manifest(root).map(manifest_value)
            "package" -> read_package(root).map(package_value)
            "lock" -> read_lock(root).map(lock_value)
            "profiles" -> read_profiles(root).map(profile_set_value)
            else -> Err(package_read_error("", "unknown package view operation",
                "the compiler package view dispatcher received an unsupported operation"))
        }
        return .Val(Ok(if result == {
            .Ok(value) -> CtValue.Present(value)
            .Err(error) -> CtValue.failed(compiler_package_error_value(error))
        }))
    }
    source :: if args.first() == {
        .Val(.Str(source)) if args.len() == 1 && method != "check" -> source
        .Val(.Struct{type_name, fields}) if args.len() == 1 && method == "check" && type_name == "CompilerSyntaxTree" -> {
            // Preserve the first named source field, even if its value is not text.
            source_field :: fields.iter().find(pair -> pair.0 == "source").and_then(pair ->
                if pair.1 == { .Str(source) -> .Val(source), else -> .None })
            if source_field == {
                .Val(source) -> source
                .None -> return .Val(Ok(CtValue.failed(compiler_error_value("E0956",
                    "`core.compiler.check` needs a parsed syntax tree with its source", span))))
            }
        }
        else -> {
            message :: if method == "check" -> "`core.compiler.check` expects one CompilerSyntaxTree"
                else -> "`core.compiler.{method}` expects one source String"
            return .Val(Ok(CtValue.failed(compiler_error_value("E0956", message, span))))
        }
    }
    if method == "check" {
        fields :: if args.first() == {
            .Val(.Struct{fields, ..}) -> fields
            else -> unreachable("check input was validated above")
        }
        schema :: fields.iter().find(pair -> pair.0 == "schema_version").map(pair -> pair.1)
        valid :: if schema == { .Val(.Int(value)) -> value == I64(SCHEMA_VERSION), else -> false }
        if !valid {
            got :: schema.and_then(value -> if value == { .Int(value) -> .Val(value), else -> .None })
                .map_or_else(() -> "missing", value -> value.to_string())
            return .Val(Ok(CtValue.failed(compiler_error_value("E0956",
                "unsupported CompilerSyntaxTree schema version {got}", span))))
        }
    }
    value :: if method == {
        "lex" -> lexed_value(lex_source(source))
