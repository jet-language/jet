// Rust: Source/Compiler.rs:369
pub fn read_manifest(root: OSPath) -> ManifestView PackageReadError! {
    resolver :: AuthorityResolver.open(root).map_err(cause -> authority_read_error(Syntax.PACKAGE_FILE,
        "could not open the pinned package root", cause))?
    if resolver.checked_manifest(OSPath.from(".")) == {
        .Ok(manifest) -> {
            record_checked_file(manifest.file)
            Ok(PackageModel.manifest_view_from_facts(manifest.facts))
        }
        .Err(cause) -> {
            if !cause.is_missing() -> return Err(authority_read_error(Syntax.PACKAGE_FILE, "could not read the package manifest", cause))
            inline :: checked_inline_package(resolver)?
            if inline == .Val((carrier, block, source)) {
                facts :: Package.PackageFacts.parse_uncomposed(block.body(source), carrier.path.display().to_string()).map_err(inline_parse_error)?
                return Ok(PackageModel.manifest_view_from_facts(facts))
            }
            Err(package_read_error(Syntax.PACKAGE_FILE, "could not read the package manifest", "no package manifest or inline Package carrier was found"))
        }
    }
}
// Rust: Source/Compiler.rs:405
pub fn read_package(root: OSPath) -> PackageView PackageReadError! {
    resolver :: AuthorityResolver.open(root).map_err(cause -> authority_read_error(Syntax.PACKAGE_FILE,
        "could not open the pinned package root", cause))?
    if resolver.checked_root_package() == {
        .Ok(package) -> {
            record_checked_package_inputs(resolver, package)?
            Ok(PackageModel.package_view_from_facts(package.facts))
        }
        .Err(cause) -> {
            if !cause.is_missing() -> return Err(authority_read_error(Syntax.PACKAGE_FILE, "could not compose the package facts", cause))
            inline :: checked_inline_package(resolver)?
            if inline == .Val((carrier, block, source)) {
                facts :: inline_package_facts(resolver, carrier, block, source)?
                record_inline_package_inputs(resolver, carrier, facts)?
                return Ok(PackageModel.package_view_from_facts(facts))
            }
            Err(package_read_error(Syntax.PACKAGE_FILE, "could not compose the package facts", "no package manifest or inline Package carrier was found"))
        }
    }
}
// Rust: Source/Compiler.rs:438
pub fn read_lock(root: OSPath) -> LockView PackageReadError! {
    resolver :: AuthorityResolver.open(root).map_err(cause -> authority_read_error(Syntax.UNIFIED_LOCK_FILE,
        "could not open the pinned package root", cause))?
    file :: resolver.checked_file(OSPath.from(Syntax.UNIFIED_LOCK_FILE)).map_err(cause -> authority_read_error(Syntax.UNIFIED_LOCK_FILE,
        "could not read the package lock", cause))?
    record_checked_file(file)
    text :: file.text().map_err(cause -> authority_read_error(Syntax.UNIFIED_LOCK_FILE, "could not decode the package lock", cause))?
    lock :: Lock.parse(text).map_err(cause -> package_read_error(Syntax.UNIFIED_LOCK_FILE, "could not parse the package lock", cause))?
    resolver.revalidate_file(file).map_err(cause -> authority_read_error(Syntax.UNIFIED_LOCK_FILE,
        "the package lock changed while it was being read", cause))?
    Ok(PackageModel.lock_view_from_lock(lock))
}
// Rust: Source/Compiler.rs:480
struct PackageSourceLoader {
    resolver: AuthorityResolver
    checked_inputs: [CheckedFile]
    last_file: String
}
// Rust: Source/Compiler.rs:486
impl SourceLoader for PackageSourceLoader {
    // Rust: Source/Compiler.rs:487
    fn read_file(&self, relative: OSPath) -> String Diagnostic! {
        // GATE #4494: native path separator.
        self.last_file = relative.to_string_lossy().replace(std.path.MAIN_SEPARATOR, "/")
        file :: self.resolver.checked_file(relative).map_err(authority_diagnostic)?
        record_checked_file(file)
        text :: file.text().map_err(authority_diagnostic)?
        self.checked_inputs.push(file)
        Ok(text)
    }
    // Rust: Source/Compiler.rs:501
    fn list_jet_files(&self, relative: OSPath) -> [OSPath] Diagnostic! {
        // GATE #4494: native path separator.
        self.last_file = relative.to_string_lossy().replace(std.path.MAIN_SEPARATOR, "/")
        files :: self.resolver.discover_files(relative, .Val(Syntax.FILE_EXT)).map_err(authority_diagnostic)?
        loop file in files -> record_checked_file(file)
        self.checked_inputs.extend(files)
        Ok(files.iter().map(file -> file.relative).collect())
    }
    // Rust: Source/Compiler.rs:516
    fn package_facts(&self) -> Package.PackageFacts? Diagnostic! {
        self.last_file = Syntax.PACKAGE_FILE
        if self.resolver.checked_root_package() == {
            .Ok(package) -> {
                record_checked_package_inputs(self.resolver, package).map_err(error -> Diagnostic.error(error.code,
                    error.message, error.cause, "restore the package inputs and try again", .None))?
                Ok(.Val(package.facts))
            }
            .Err(error) -> {
                if !error.is_missing() -> return Err(error.diagnostic())
                facts :: Loader.package_facts_for_root(self.resolver.root()).map_err(diagnostics -> {
                    diagnostics.pop().unwrap_or_else(() -> Diagnostic.error("E1206", "package context is unavailable",
                        "the inline package facts could not be loaded", "restore the package source and try again", .None))
                })?
                Ok(facts)
            }
        }
    }
}
// Rust: Source/Compiler.rs:552
pub fn read_profiles(root: OSPath) -> ProfileSetView PackageReadError! {
    resolver :: AuthorityResolver.open(root).map_err(cause -> authority_read_error(Syntax.ENV_FILE, "could not open the pinned package root", cause))?
    env_file :: resolver.checked_file(OSPath.from(Syntax.ENV_FILE)).map_err(cause -> authority_read_error(Syntax.ENV_FILE, "could not read the profile source", cause))?
    record_checked_file(env_file)
    source :: env_file.text().map_err(cause -> authority_read_error(Syntax.ENV_FILE, "could not decode the profile source", cause))?
    base_dir :: resolver.root().to_path_buf()
    loader := PackageSourceLoader{resolver: resolver, checked_inputs: [env_file], last_file: Syntax.ENV_FILE}
    plan :: evaluate_env_with_source_loader(source, base_dir, &loader, .None, .None).map_err(cause ->
        package_read_error(loader.last_file, "could not evaluate the profile source", diagnostic_cause(cause)))?
    loop file in loader.checked_inputs {
        // GATE #4494: native path separator.
        file_name :: file.relative.to_string_lossy().replace(std.path.MAIN_SEPARATOR, "/")
        loader.resolver.revalidate_file(file).map_err(cause -> authority_read_error(file_name,
            "a profile input changed while it was being read", cause))?
    }
    profiles := PackageProfileSet.default()
    loop profile in plan.package_profiles {
        profiles.insert_checked(profile).map_err(cause -> package_read_error(Syntax.ENV_FILE, "could not compose the profile set", cause.to_string()))?
    }
    Ok(profile_set_view(profiles))
}

