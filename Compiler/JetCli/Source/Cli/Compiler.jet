// Rust: Source/Compiler.rs:98
fn authority_reason(cause: AuthorityError) -> String {
    if cause == {
        .Missing(_) -> "authority input is missing; restore the required metadata and try again"
        .ManifestParse{..} -> "package metadata is malformed; fix the metadata and try again"
        .Io{operation, ..} -> "couldn't {operation} authority metadata; restore access and try again"
        .Symlink(_) -> "authority input is a symlink; replace it with the expected file or directory"
        .WrongKind{expected, actual, ..} -> "authority input is a {actual}, but the operation requires a {expected}"
        .Escapes(_) -> "authority path escapes its root; use a relative path below the authority root"
        .AmbiguousManifest(_) -> "the package has multiple manifest roots; keep only package.jet"
        .RetiredManifest(_) -> "the retired manifest name is not accepted; use package.jet"
        .WorkspaceAmbiguous(_) -> "workspace authority is declared in multiple files; keep one authority source"
        .WorkspaceNoModule -> "the authority source has no workspace module; declare the workspace module"
        .NestedMembers{..} -> "a member Package cannot declare another members list; keep membership at one level"
        .Invalid{..} -> "authority metadata is invalid; fix the metadata fields and try again"
        .Changed(_) -> "authority input changed during resolution; restore it and retry"
        .Unsupported(_) -> "authority resolution is unavailable on this platform"
    }
}
// Rust: Source/Compiler.rs:149
fn authority_diagnostic(cause: AuthorityError) -> Diagnostic {
    Diagnostic.error(cause.diagnostic().code, "authority input is unavailable", authority_reason(cause),
        "restore the authority input and retry the operation", .None)
}
