struct Resolver {
    project_root: OSPath
    existing_lock: LockFile?
    opts: FetchOptions
    policy: Package.PackagePolicy
    advisory_policy: Result[Publish.AdvisoryPolicy?, Diagnostic]?
    resolved: [String:ResolvedPkg]
    version_seen: [String:(String, [String])]
    registry_plan: [String:Publish.IndexEntry]
    update_scope: BTreeSet[String]
    foreign: [String:jetpack.Foreign.Realization]
}
// Rust: Source/Fetch.rs:224
struct ResolvedPkg {
    version: String
    source: Lock.LockSource
    locked: LockedRevision?
    fingerprint: String
    content_hash: String?
    deps: [String]
    source_dir: OSPath
    provenance: Lock.DependencyProvenance?
    envelope: Lock.LockEnvelope?
    receipt: String?
}
impl Resolver {
    // Rust: Source/Fetch.rs:238
    fn new(project_root: OSPath, existing_lock: LockFile?, opts: FetchOptions, policy: Package.PackagePolicy) -> Resolver {
        Resolver{project_root: project_root, existing_lock: existing_lock, opts: opts, policy: policy,
            advisory_policy: None, resolved: [:], version_seen: [:], registry_plan: [:],
            update_scope: compute_update_scope(existing_lock, opts), foreign: [:]}
    }
    // Rust: Source/Fetch.rs:258
    fn resolve_manifest(&self, manifest: Manifest.Manifest) -> (LockFile, [String:OSPath]) [Diagnostic]! {
        &self.realize_foreign_dependencies(manifest)?
        self.registry_plan = self.prepare_registry_plan(manifest)?
        root_deps :: manifest.dependencies.keys().sorted()
        loop dep_name in root_deps {
            chain :: ["{manifest.package.name} (root)", dep_name.clone()]
            &self.resolve_dep(dep_name, manifest.dependencies[dep_name], self.project_root, chain)?
        }
        packages := [LockedPackage]{}
        &packages.push(LockedPackage{
            name: manifest.package.name.clone(), version: manifest.package.version.clone(), source: .Root,
            nix_closure: None, locked: None, fingerprint: "", content_hash: None,
            dependencies: root_deps.clone(), layer: Lock.layer_from_manifest(manifest), inferred_layer: None,
            effects: [], effect_grants: [], required_effects: [], granted_effects: [], denied_effects: [],
            effect_authority: None, envelope: None, receipt: None, provenance: None
        })
        loop name in self.resolved.keys().sorted() {
            pkg :: self.resolved[name]
            &packages.push(LockedPackage{
                name: name.clone(), version: pkg.version.clone(), nix_closure: None,
                source: pkg.source.clone(), locked: pkg.locked.clone(), fingerprint: pkg.fingerprint.clone(),
                content_hash: pkg.content_hash.clone(), dependencies: pkg.deps.clone(), layer: None,
                inferred_layer: None, effects: [], effect_grants: [], required_effects: [],
                granted_effects: [], denied_effects: [], effect_authority: None,
                provenance: pkg.provenance.clone(), envelope: pkg.envelope.clone(), receipt: pkg.receipt.clone()
            })
        }
        new_lock := LockFile{
            version: Lock.LOCK_VERSION, packages: ^packages, root_dependencies: ^root_deps,
            authority: if manifest.authority != Default.default() { Val(manifest.authority.clone()) } else { None },
            workspace_members: self.existing_lock.map(lock -> lock.workspace_members.clone()).unwrap_or_default(),
            workspace_source_digest: self.existing_lock.and_then(lock -> lock.workspace_source_digest.clone()),
            workspace_overlay_policy: self.existing_lock.map(lock -> lock.workspace_overlay_policy.clone()).unwrap_or_default(),
            comptime_inputs: self.existing_lock.map(lock -> lock.comptime_inputs.clone()).unwrap_or_default(),
            toolchains: self.existing_lock.map(lock -> lock.toolchains.clone()).unwrap_or_default(),
            browsers: self.existing_lock.map(lock -> lock.browsers.clone()).unwrap_or_default(),
            source_channels: self.existing_lock.map(lock -> lock.source_channels.clone()).unwrap_or_default(),
            build_stamp: self.existing_lock.and_then(lock -> lock.build_stamp.clone()),
            build_contributions: self.existing_lock.map(lock -> lock.build_contributions.clone()).unwrap_or_default()
        }
        self.preserve_unrelated_records(&new_lock)
        dep_dirs := [String:OSPath]{}
        loop name in self.resolved.keys().sorted() -> &dep_dirs.insert(name.clone(), self.resolved[name].source_dir.clone())
        Ok((new_lock, dep_dirs))
    }
    // Rust: Source/Fetch.rs:379
    fn realize_foreign_dependencies(&self, manifest: Manifest.Manifest) -> Unit [Diagnostic]! {
        if !manifest.dependencies.values().any(spec -> if spec == { .Foreign{..} -> true, else -> false }) -> return Ok(())
        roots :: jetpack.Store.resolve()
        store_dir :: roots.hangar_dir()
        fixtures :: jetpack.Provider.fixtures_from_env(None)
        context :: jetpack.Provider.Ctx{
            fixtures: fixtures, store_dir: store_dir, offline: false, project_dir: Val(self.project_root),
            nix_index: None, nix_roots: None, allow_local_nix_catalog: false
        }
        realized :: jetpack.Foreign.realize_manifest_dependencies(roots, self.project_root, manifest, context)
            .map_err(error -> [foreign_provider_diagnostic(error)])?
        self.foreign = realized.into_iter().map(item -> (item.name.clone(), item)).collect()
        Ok(())
    }
    // Rust: Source/Fetch.rs:414
    fn prepare_registry_plan(self: Resolver, manifest: Manifest.Manifest) -> [String:Publish.IndexEntry] [Diagnostic]! {
        roots := [VersionConstraint]{}
        direct := BTreeSet[String].new()
        pending := BTreeSet[String].new()
        owners := [String:BTreeSet[String]]{}
        loop name in manifest.dependencies.keys().sorted() {
            if manifest.dependencies[name] == .Registry(requirement) {
                req :: VersionReq.parse(requirement).ok_or_else(() -> [registry_diagnostic(name,
                    "invalid version requirement `{requirement}`", "use a SemVer requirement such as `1.2.0`, `^1.2`, or `>=1.0 <2.0`")])?
                &roots.push(VersionConstraint{package: name.clone(), req: req, from: "{manifest.package.name} (root)"})
                &direct.insert(name.clone())
                &pending.insert(name.clone())
                &owners.entry(name.clone()).or_default().insert(manifest.package.name.clone())
            }
        }
        if roots.is_empty() -> return Ok([:])
        visited := BTreeSet[String].new()
        candidate_map := [String:[SolverCandidate]]{}
        // GATE #4499: composite tuple keys retain exact equality and hashing.
        entry_map := [(String, String):Publish.IndexEntry]{}
        loop {
            name :: &pending.pop_first() ?? break
            if !&visited.insert(name.clone()) -> continue
            update_requested :: self.registry_update_requested(name)
            registry :: if update_requested { Publish.resolve_publish_registry() }
                else { self.locked_registry_config(name).unwrap_or_else(() -> Publish.resolve_publish_registry()) }
            (all, _warnings) :: Publish.resolve_and_verify_all(registry, name)
                .map_err(diagnostic -> [registry_diagnostic(name, diagnostic.what, diagnostic.fix)])?
            locked_version :: if !update_requested { self.find_locked_registry_version(name) } else { None }
            solver_candidates := [SolverCandidate]{}
            loop entry in all {
                if entry.yanked && locked_version != Val(entry.version) -> continue
                version :: SemVer.parse(entry.version).ok_or_else(() -> [registry_diagnostic(name,
                    "registry entry has invalid SemVer `{entry.version}`", "publish a new immutable version with a valid SemVer identity")])?
                repo :: Publish.index_repo_path(registry)
                artifact_snapshot :: Publish.snapshot_verified_artifact(repo, entry).map_err(error -> [
                    registry_diagnostic(name, "published artifact is unavailable or corrupt: {error}",
                        "refresh the registry mirror or publish the immutable source artifact")])?
                artifact :: artifact_snapshot.path()
                dep_manifest :: self.load_dep_manifest(artifact, name)?
                if dep_manifest.package.name != name || dep_manifest.package.version != entry.version {
                    return Err([registry_diagnostic(name, "published source metadata disagrees with its registry index entry",
                        "republish a new immutable version with matching payload identity")])
                }
                registry_metadata :: self.load_registry_metadata(artifact, name, entry.version)?
                registry_dependencies :: registry_dependency_edges(dep_manifest, registry_metadata, name)?
                Publish.authorize_package_candidate(self.policy, name, entry.version, dep_manifest.package.license, registry.name)
                    .map_err(error -> {
                        owner :: owners.get(name).map(values -> values.iter().collect().join(" | ")).unwrap_or_else(() -> manifest.package.name.clone())
                        edge :: "{owner} -> {name}#{entry.version}"
                        [Publish.package_policy_edge_diagnostic(owner, edge, registry.name, error)]
                    })?
                dependencies := [VersionConstraint]{}
                rejected := [String:BTreeSet[SemVer]]{}
                preferred := [String:[VersionReq]]{}
                strict := BTreeSet[String].new()
                loop dependency in registry_dependencies {
                    loop requirement in dependency.requirements {
                        req :: VersionReq.parse(requirement).ok_or_else(() -> [registry_diagnostic(dependency.name,
                            "invalid version requirement `{requirement}` in {name} {entry.version}",
                            "publish a package with a valid SemVer dependency requirement")])?
                        roles :: dependency.roles.iter().collect().join(",")
                        &dependencies.push(VersionConstraint{package: dependency.name.clone(), req: req, from: "{name} {entry.version} ({roles})"})
                    }
                    loop requirement in dependency.prefer {
                        req :: VersionReq.parse(requirement).ok_or_else(() -> [registry_diagnostic(dependency.name,
                            "registry dependency has an invalid prefer constraint", "publish a valid SemVer requirement in registry.json")])?
                        &preferred.entry(dependency.name.clone()).or_insert_with(() -> []).push(req)
                    }
                    rejected_versions := BTreeSet[SemVer].new()
                    loop version_text in dependency.reject {
                        version :: SemVer.parse(version_text).ok_or_else(() -> [registry_diagnostic(dependency.name,
                            "registry dependency has an invalid reject version", "publish exact SemVer reject values in registry.json")])?
                        &rejected_versions.insert(version)
                    }
                    if !rejected_versions.is_empty() -> &rejected.entry(dependency.name.clone()).or_insert_with(() -> BTreeSet[SemVer].new()).extend(^rejected_versions)
                    if dependency.strict -> &strict.insert(dependency.name.clone())
                    &owners.entry(dependency.name.clone()).or_default().insert("{name}#{entry.version}")
                    &pending.insert(dependency.name)
                }
                &entry_map.insert((name.clone(), entry.version.clone()), entry)
                &solver_candidates.push(SolverCandidate{version: version, dependencies: ^dependencies,
                    rejected: ^rejected, preferred: ^preferred, strict: ^strict})
            }
            &candidate_map.insert(name, solver_candidates)
        }
        locked := [String:String]{}
        if self.existing_lock == .Val(lock) {
            loop package in lock.packages {
                if package.source == .Registry{..} -> &locked.insert(package.name.clone(), package.version.clone())
            }
        }
        selected :: Publish.solve_registry(roots, candidate_map, locked, self.update_scope, self.opts.resolution, direct).map_err(d -> [d])?
        plan := [String:Publish.IndexEntry]{}
        loop name in selected.keys().sorted() {
            version :: selected[name]
            entry :: entry_map.iter().find(pair -> pair.0.0 == name
                && SemVer.parse(pair.1.version).is_some_and(candidate_version -> candidate_version == version))
                .map(pair -> pair.1.clone()).ok_or_else(() -> [registry_diagnostic(name,
                    "resolver selected a registry candidate with no immutable index entry", "refresh the registry checkpoint and retry resolution")])?
            &plan.insert(name, entry)
        }
        Ok(plan)
    }
    // Rust: Source/Fetch.rs:649
    fn preserve_unrelated_records(self: Resolver, lock: &LockFile) -> {
        target :: self.opts.update_dep ?? return
        previous :: self.existing_lock ?? return
        related := lock_closure(previous, target)
        &related.extend(lock_closure(lock, target))
        loop package in &lock.packages {
            if related.contains(package.name) -> continue
            if previous.packages.iter().find(candidate -> candidate.name == package.name) == .Val(previous_package) {
                package = previous_package.clone()
            }
        }
    }
    // Rust: Source/Fetch.rs:672
    fn resolve_dep(&self, dep_name: String, spec: DepSpec, parent_dir: OSPath, chain: [String]) -> Unit [Diagnostic]! {
        if self.resolved.contains_key(dep_name) {
            existing_version :: self.resolved[dep_name].version
            if self.version_seen.get(dep_name) == .Val((prev_version, prev_chain)) {
                if prev_version != existing_version -> return Err([Lock.e1201(dep_name, prev_version, prev_chain, existing_version, chain)])
            }
            return Ok(())
        }
        if spec == {
            .Path{path} -> {
                abs_path :: if OSPath.from(path).is_absolute() { OSPath.from(path) } else { normalize_path(parent_dir.join(path)) }
                if parent_dir != self.project_root {
                    lexical_escape :: OSPath.from(path).is_absolute() || !abs_path.starts_with(parent_dir)
                    canonical_escape :: fs.canonicalize(parent_dir).and_then(parent_root ->
                        fs.canonicalize(abs_path).map(resolved -> !resolved.starts_with(parent_root))).unwrap_or(true)
                    if lexical_escape || canonical_escape -> return Err([path_dependency_escape_diagnostic(dep_name, path, parent_dir)])
                }
                snapshot :: Store.snapshot_tree(abs_path).map_err(d -> [d])?
                source :: snapshot.path()
                dep_manifest :: self.load_dep_manifest(source, dep_name)?
                dep_version :: dep_manifest.package.version.clone()
                dep_name_in_manifest :: dep_manifest.package.name.clone()
                if self.version_seen.get(dep_name_in_manifest) == {
                    .Val((prev_ver, prev_chain)) -> {
                        if prev_ver != dep_version -> return Err([Lock.e1201(dep_name_in_manifest, prev_ver, prev_chain, dep_version, chain)])
                    }
                    None -> &self.version_seen.insert(dep_name_in_manifest.clone(), (dep_version.clone(), chain.clone()))
                }
                th :: snapshot.content_hash().to_string()
                trans_deps := [String]{}
                loop trans_name in dep_manifest.dependencies.keys().sorted() {
                    child_chain := chain.clone()
                    &child_chain.push(trans_name.clone())
                    &self.resolve_dep(trans_name, dep_manifest.dependencies[trans_name], source, child_chain)?
                    &trans_deps.push(trans_name.clone())
                }
                dep_fps :: trans_deps.iter().filter_map(d -> self.resolved.get(d).map(r -> r.fingerprint)).collect()
                cap_digest :: Publish.ApiFreeze.project_capability_digest(source)
                fp :: Lock.compute_fingerprint(th, dep_fps, cap_digest)
                (store_path, content_hash) :: Store.ensure_path_dep(dep_name, dep_version, fp, source).map_err(d -> [d])?
                Store.verify_entry(dep_name, store_path, th).map_err(d -> [d])?
                link_dir :: self.project_root.join(".jet").join("build").join("deps").join(dep_name)
                Store.link_into_project(store_path, link_dir).map_err(d -> [d])?
                provenance :: self.existing_provenance(dep_name, dep_version, content_hash)
                &self.resolved.insert(dep_name, ResolvedPkg{
                    version: dep_version, source: .Path(path.clone()), locked: None, fingerprint: fp,
                    content_hash: Val(content_hash), deps: ^trans_deps, source_dir: store_path,
                    provenance: provenance, envelope: None, receipt: None
                })
            }
            .Git{url, selector} -> {
                transport :: validate_git_transport_url(url, self.project_root).map_err(reason -> [git_transport_diagnostic(url, reason)])?
                if !git_available() -> return Err([Lock.e1203()])
                rev_to_fetch :: self.resolve_git_rev(dep_name, url, selector, transport)?
                clone_dir :: git_cache_dir(url, rev_to_fetch).map_err(d -> [d])?
                // GATE #4494/#4409: retained no-follow authority, exact NotFound classification.
                snapshot :: if Store.open_directory_authority(clone_dir) == {
                    .Ok(cache) -> Store.snapshot_directory_authority(cache).map_err(d -> [d])?
                    .Err(error) -> {
                        if error.kind() == IOErrorKind.NotFound { git_clone(url, rev_to_fetch, clone_dir, transport)? }
                        else {
                            return Err([Diagnostic.error("E1206", "couldn't open git cache `{clone_dir.display()}`: {error}",
                                "the git cache must be held through a no-follow directory authority",
                                "remove the cache entry or run `jet fetch` again", None)])
                        }
                    }
                }
                source :: snapshot.path()
                dep_manifest :: self.load_dep_manifest(source, dep_name)?
                dep_version :: dep_manifest.package.version.clone()
                // Use the source/store tree hash, not Git's HEAD^{tree} hash space.
                git_tree_hash :: snapshot.content_hash().to_string()
                dep_name_in_manifest :: dep_manifest.package.name.clone()
                if self.version_seen.get(dep_name_in_manifest) == {
                    .Val((prev_ver, prev_chain)) -> {
                        if prev_ver != dep_version -> return Err([Lock.e1201(dep_name_in_manifest, prev_ver, prev_chain, dep_version, chain)])
                    }
                    None -> &self.version_seen.insert(dep_name_in_manifest.clone(), (dep_version.clone(), chain.clone()))
                }
                trans_deps := [String]{}
                loop trans_name in dep_manifest.dependencies.keys().sorted() {
                    child_chain := chain.clone()
                    &child_chain.push(trans_name.clone())
                    &self.resolve_dep(trans_name, dep_manifest.dependencies[trans_name], source, child_chain)?
                    &trans_deps.push(trans_name.clone())
                }
                dep_fps :: trans_deps.iter().filter_map(d -> self.resolved.get(d).map(r -> r.fingerprint)).collect()
                cap_digest :: Publish.ApiFreeze.project_capability_digest(source)
                fp :: Lock.compute_fingerprint(git_tree_hash, dep_fps, cap_digest)
                (store_path, _content_hash) :: Store.ensure_git_dep(dep_name, dep_version, fp, source).map_err(d -> [d])?
                Store.verify_entry(dep_name, store_path, git_tree_hash).map_err(d -> [d])?
                link_dir :: self.project_root.join(".jet").join("build").join("deps").join(dep_name)
                Store.link_into_project(store_path, link_dir).map_err(d -> [d])?
                locked :: LockedRevision{rev: rev_to_fetch.clone(), tree_hash: git_tree_hash.clone(), last_modified: unix_now()}
                provenance :: self.existing_provenance(dep_name, dep_version, git_tree_hash)
                &self.resolved.insert(dep_name, ResolvedPkg{
                    version: dep_version, source: .Git{url: url.clone(), selector: Lock.git_selector_str(selector)},
                    locked: Val(locked), fingerprint: fp, content_hash: Val(git_tree_hash.clone()),
                    deps: ^trans_deps, source_dir: store_path, provenance: provenance, envelope: None, receipt: None
                })
            }
            .Registry(version_req) -> {
                update_requested :: self.registry_update_requested(dep_name)
                registry :: if update_requested { Publish.resolve_publish_registry() }
                    else { self.locked_registry_config(dep_name).unwrap_or_else(() -> Publish.resolve_publish_registry()) }
                (available, _warnings) :: Publish.resolve_and_verify_all(registry, dep_name)
                    .map_err(diagnostic -> [registry_diagnostic(dep_name, diagnostic.what, diagnostic.fix)])?
                requirement :: VersionReq.parse(version_req).ok_or_else(() -> [registry_diagnostic(dep_name,
                    "invalid version requirement `{version_req}`", "use a SemVer requirement such as `1.2.0`, `^1.2`, or `>=1.0 <2.0`")])?
                locked_version :: if !update_requested && self.opts.resolution == .Conservative {
                    self.find_locked_registry_version(dep_name)
                } else { None }
                locked_candidate :: locked_version.filter(version ->
                    SemVer.parse(version).is_some_and(parsed -> requirement.matches(parsed)))
                    .and_then(version -> available.iter().find(entry -> entry.version == version)).cloned()
                planned :: self.registry_plan.get(dep_name).filter(entry ->
                    SemVer.parse(entry.version).is_some_and(version -> requirement.matches(version))).cloned()
                selected :: planned.or(locked_candidate).or_else(() -> {
                    candidates := available.into_iter().filter(entry -> !entry.yanked).filter_map(entry -> {
                        version :: SemVer.parse(entry.version) ?? return None
                        if requirement.matches(version) { Val((version, entry)) } else { None }
                    }).collect()
                    versions :: candidates.iter().map(pair -> pair.0.clone()).collect()
                    constraint :: VersionConstraint{package: dep_name, req: requirement.clone(), from: chain.first().cloned().unwrap_or_default()}
                    mode :: if self.opts.resolution == {
                        .LowestDirect -> if chain.len() > 2 { ResolveMode.Latest } else { ResolveMode.LowestDirect }
