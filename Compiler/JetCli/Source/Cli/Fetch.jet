// Rust: Source/Fetch.rs:1543
fn compute_update_scope(existing_lock: LockFile?, opts: FetchOptions) -> BTreeSet[String] {
    if !opts.update -> return BTreeSet[String].new()
    if opts.update_dep == {
        None -> existing_lock.into_iter().flat_map(lock -> lock.packages.iter().map(package -> package.name.clone())).collect()
        .Val(target) -> {
            scope := existing_lock.map(lock -> lock_closure(lock, target)).unwrap_or_default()
            &scope.insert(target)
            scope
        }
    }
}
// Rust: Source/Fetch.rs:1562
fn lock_closure(lock: LockFile, target: String) -> BTreeSet[String] {
    scope := BTreeSet[String].new()
    pending := [target]
    loop {
        name :: &pending.pop() ?? break
        if !&scope.insert(name.clone()) -> continue
        if lock.packages.iter().find(package -> package.name == name) == .Val(package) {
            &pending.extend(package.dependencies.iter().cloned())
        }
    }
    scope
}
// Rust: Source/Fetch.rs:1576
fn registry_update_rationales(project_root: OSPath, lock: LockFile, manifest: Manifest.Manifest, opts: FetchOptions) -> jetpack.SemanticLock.SemanticLockFile Diagnostic! {
    packages := lock.packages.iter().filter(package -> if package.source == { .Registry{..} -> true, else -> false }).collect()
    semantic := jetpack.SemanticLock.load(project_root).unwrap_or_default()
    semantic.source_maps = manifest.policy.source_maps.keys().sorted().map(pattern ->
        jetpack.SemanticLock.SourceMapEntry{pattern: pattern.clone(), sources: manifest.policy.source_maps[pattern].clone()}).collect()
    if packages.is_empty() -> return Ok(semantic)
    if opts.update_dep == .Val(target) {
        scope :: lock_closure(lock, target)
        &packages.retain(package -> scope.contains(package.name))
    }
    if packages.is_empty() -> return Ok(semantic)
    loop package in packages {
        if package.source == .Registry{registry, reference, output, source_hash, repository, ..} {
            dep_manifest :: load_dep_manifest(OSPath.from(output), package.name).map_err(diagnostics -> {
                values := diagnostics
                &values.pop().unwrap_or_else(() -> Diagnostic.error("E1207",
                    "registry dependency `{package.name}` has no readable installed manifest",
                    "registry package policy evidence must remain explainable after ingest",
                    "repair the canonical Hangar object or rerun `jet fetch` from the trusted registry", None))
            })?
            policy_receipt :: Publish.authorize_package_candidate(manifest.policy, package.name, package.version,
                dep_manifest.package.license, registry).map_err(error -> {
                    edge :: "{manifest.package.name} -> {package.name}#{package.version}"
                    Publish.package_policy_edge_diagnostic(manifest.package.name, edge, registry, error)
                })?
            registry_metadata :: Publish.read_registry_package_metadata(OSPath.from(output), package.name, package.version)
                .map_err(error -> registry_diagnostic(package.name, "registry dependency metadata is invalid: {error}",
                    "repair the canonical Hangar object or republish registry.json"))?
            key :: "registry:{registry}:{package.name}"
            exception_suffix :: Publish.active_source_exception(manifest.policy.exceptions, package.name, package.version)
                .map(exception -> "; source-policy-exception={exception.summary()}").unwrap_or_default()
            record := jetpack.SemanticLock.SemanticRecord.new(
                jetpack.SemanticLock.LockIdentity{kind: .Package, key: key, exact: reference.clone(), hash: source_hash.clone(),
                    platform: jetpack.Envelope.host_platform()},
                jetpack.SemanticLock.LockRationale{
                    owner_package: manifest.package.name.clone(),
                    reason: "selected `{package.version}` with {opts.resolution.label()} resolution; registry policy record; package-policy={policy_receipt.summary()}{exception_suffix}",
                    source_ref: "registry:{registry};repository={Publish.redact_registry_url(repository)}",
                    provider: "jet-registry", channel_input: opts.resolution.label().to_string(), exact_output: output.clone(),
                    policy_fingerprint: Publish.policy_fingerprint(manifest.policy), recipe_id: "", adapter_id: "registry.pubgrub",
                    signature: "", cache_provenance: "verified-registry",
                    update_command: opts.update_dep.map(name -> "jet update {name}").unwrap_or_else(() -> "jet update")
                })
            if registry_metadata == .Val(metadata) -> &record.future_fields.insert("dependency-metadata", metadata.canonical().to_string())
            jetpack.SemanticLock.selective_update(&semantic, record)
        }
    }
    jetpack.SemanticLock.revalidate(semantic).map_err(issues -> Diagnostic.error("E1206",
        "couldn't record the registry resolution rationale",
        "the package lock was resolved, but its update explanation failed semantic lock validation",
        issues.iter().map(issue -> issue.message()).collect().join("; "), None))?
    Ok(semantic)
}
// Rust: Source/Fetch.rs:1732
fn semantic_policy_needs_update(project_root: OSPath, manifest: Manifest.Manifest) -> Bool {
    expected_maps := manifest.policy.source_maps.iter().map(pair ->
        jetpack.SemanticLock.SourceMapEntry{pattern: pair.0.clone(), sources: pair.1.clone()}).collect()
    &expected_maps.sort_by((left, right) -> left.pattern <=> right.pattern)
    semantic :: jetpack.SemanticLock.load(project_root).unwrap_or_default()
    if semantic.source_maps != expected_maps -> return true
    fingerprint :: Publish.policy_fingerprint(manifest.policy)
    semantic.records.iter().any(record -> record.identity.kind == .Package && record.identity.key.starts_with("registry:")
        && record.rationales.first().map(rationale -> rationale.policy_fingerprint) != Val(fingerprint))
}
// Rust: Source/Fetch.rs:1759
fn dependency_owner(chain: [String]) -> String {
    if chain.len() > 1 { chain[0..chain.len() - 1].join(" -> ") } else { "package root" }
}
// Rust: Source/Fetch.rs:1767
fn dependency_edge(chain: [String], package: String, version: String) -> String {
    "{dependency_owner(chain)} -> {package}#{version}"
}
// Rust: Source/Fetch.rs:1771
fn contextualize_dependency_diagnostic(diagnostic: Diagnostic, chain: [String], package: String, version: String) -> Diagnostic {
    result := diagnostic
    edge :: dependency_edge(chain, package, version)
    result.what = "dependency edge `{edge}` was rejected: {result.what}"
    result.why = "package `{dependency_owner(chain)}` owns this source decision; {result.why}"
    result
}
// Rust: Source/Fetch.rs:1787
fn registry_diagnostic(name: String, what: String, fix: String) -> Diagnostic {
