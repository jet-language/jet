            "every Jet package must have a `{Syntax.PACKAGE_FILE}` manifest",
            "add a `{Syntax.PACKAGE_FILE}` to `{dir.display()}`", None)])
        .Val(.Err(d)) -> Err([d])
        .Val(.Ok(m)) -> Ok(m)
    }
