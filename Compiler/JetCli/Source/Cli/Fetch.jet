// Rust: Source/Fetch.rs:44
pub struct FetchOptions {
    pub locked: Bool
    pub update: Bool
    pub update_dep: String?
    pub resolution: ResolveMode
}
// Rust: Source/Fetch.rs:57
pub fn fetch(project_root: OSPath, manifest: Manifest.Manifest, existing_lock: LockFile?, opts: FetchOptions) -> (LockFile, [String:OSPath]) [Diagnostic]! {
    manifest_path :: Manifest.manifest_path_in(project_root).display().to_string()
    check_toolchain(manifest, manifest_path).map_err(d -> [d])?
    if opts.locked {
        lock :: existing_lock.ok_or_else(() -> [Lock.e1202(project_root.join(Syntax.UNIFIED_LOCK_FILE).display().to_string())])?
        Lock.verify_lock_matches_manifest(lock, manifest, project_root.join(Syntax.UNIFIED_LOCK_FILE).display().to_string()).map_err(d -> [d])?
        Lock.verify_all_manifest_deps_locked(manifest, lock).map_err(error -> [error.diagnostic()])?
        lock.validate_completeness().map_err(error -> [error.diagnostic()])?
        enforce_provenance_policy(lock, manifest).map_err(d -> [d])?
        dep_dirs :: build_dep_dirs_from_lock(lock, project_root, manifest)?
        return Ok((lock.clone(), dep_dirs))
    }
    resolver := Resolver.new(project_root, existing_lock, opts, manifest.policy)
    (new_lock, dep_dirs) := &resolver.resolve_manifest(manifest)?
    enforce_provenance_policy(new_lock, manifest).map_err(d -> [d])?
    Lock.ensure_build_stamp(project_root, &new_lock)
    semantic_update :: if opts.update || manifest.policy.licenses.is_some() || !manifest.policy.exceptions.is_empty()
        || new_lock.packages.iter().any(package -> if package.source == { .Registry{..} -> true, else -> false })
        || semantic_policy_needs_update(project_root, manifest) {
        Val(registry_update_rationales(project_root, new_lock, manifest, opts).map_err(d -> [d])?)
    } else { None }
    lock_str :: Lock.write(new_lock)
    lock_bytes :: if semantic_update == {
        .Val(semantic) -> {
            if !semantic.records.is_empty() || !semantic.inputs.is_empty() || !semantic.source_maps.is_empty() {
                trimmed := lock_str.trim_end() // #4303
                "{trimmed}\n\n{jetpack.SemanticLock.write(semantic)}".into_bytes()
            } else { lock_str.into_bytes() }
        }
        None -> lock_str.into_bytes()
    }
    Lock.write_lock_atomically(project_root, lock_bytes).map_err(e -> [
        Diagnostic.error("E1206", "couldn't write {Syntax.UNIFIED_LOCK_FILE}",
            "the lock file records exact package versions", "check write permissions: {e}", None)
    ])?
    Ok((new_lock, dep_dirs))
}
// Rust: Source/Fetch.rs:164
fn enforce_provenance_policy(lock: LockFile, manifest: Manifest.Manifest) -> Unit Diagnostic! {
    requirement :: manifest.authority.trust.and_then(trust -> trust.require).unwrap_or(Package.ProvenanceRequirement.None)
    Lock.enforce_provenance_requirement(lock, requirement).map_err(error ->
        Diagnostic.error("E1207", error,
            "authority.trust.require is an explicit provenance floor; Jet will not silently downgrade it",
            "record the required transparency or build evidence, or set `authority: { trust: { require: none } }`", None))
}
// Rust: Source/Fetch.rs:182
fn foreign_provider_diagnostic(error: jetpack.Provider.ProviderError) -> Diagnostic {
    Diagnostic.error(error.code().unwrap_or("E1256"), "couldn't realize the foreign package provider",
        "the verified provider projection failed: {error:?}",
        "provide a pinned, hash-verified provider artifact with its generated binding, then run `jet fetch` again", None)
}
// Rust: Source/Fetch.rs:192
fn foreign_dependency_diagnostic(dep_name: String, detail: String) -> Diagnostic {
    Diagnostic.error("E1256", "foreign dependency `{dep_name}` has no valid provider projection", detail,
        "run `jet fetch` with the pinned provider artifact available; Jet will not invent or bypass a binding", None)
}
