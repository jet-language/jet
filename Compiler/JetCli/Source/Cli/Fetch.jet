// Rust: Source/Fetch.rs:1356
fn registry_dependency_edges(manifest: Manifest.Manifest, metadata: Publish.RegistryPackageMetadata?, package: String) -> [Publish.RegistryDependency] [Diagnostic]! {
    if metadata == .Val(value) {
        loop name in manifest.dependencies.keys().sorted() {
            if manifest.dependencies[name] == .Registry(_) {
                if !value.contains_dependency(name) -> return Err([registry_diagnostic(package,
                    "registry.json omits declared dependency `{name}`", "publish registry.json with every registry dependency in package.jet")])
            }
        }
        return Ok(value.active_dependencies())
    }
    dependencies := [Publish.RegistryDependency]{}
    loop name in manifest.dependencies.keys().sorted() {
        if manifest.dependencies[name] == .Registry(requirement) {
            &dependencies.push(Publish.RegistryDependency{name: name.clone(), requirements: [requirement.clone()],
                roles: BTreeSet[String].from(["normal"]), prefer: [], reject: BTreeSet[String].new(),
                strict: false, enabled_by_default: true})
        }
    }
    Ok(dependencies)
}
