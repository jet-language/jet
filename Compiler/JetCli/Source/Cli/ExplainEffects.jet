// `jet explain effects [<file>[:<line>]] [--caps] [--json]`: every effect cap
// in force at one site, nearest first, one line per rung (block, function,
// trait when the method implements a capped trait, type, module for the
// inline modules around it, the file head and the caps where the file's
// module is declared, package, run), then what the site reaches with the
// first call that reaches each effect. A type or module rung that writes
// nothing prints `(none written)`.
// The facts are the checked program's own, read through the walker `jet
// inspect rights` uses (InspectRights.jet) and the semantic index's
// witnesses; `--caps` lists every file-head, module, type and trait cap under
// a file or directory.
use {
    cli_files: core.files
    jet_driver.[
        JetDriverAuthorityPolicy,
        JetDriverCompileResult,
        JetDriverDocModule,
        JetDriverVerbOutput,
        JET_DRIVER_EXIT_OK,
        JET_DRIVER_EXIT_USAGE,
        JET_DRIVER_EXIT_USER_ERROR,
        jet_driver_display_path,
    ]
    jet_foundation.[EffectRowEntry, Expr, Func, Item, ModuleCap, Span, Stmt, ast_visit_body, diagnostic_line_at]
    jet_sema.[sema_inline_decode_generated_suffix]
    jet_semindex.[SemSummary, semindex_module_alias, semindex_summaries, semindex_summary, semindex_witness]
}

JET_CLI_EXPLAIN_EFFECTS_USAGE: "jet explain effects [<file>[:<line>]] [--caps] [--json]"

// What `run` does with an effect no rung denies.
JET_CLI_EXPLAIN_EFFECTS_RUN: "everything else allowed; --deny wins"

// One rung of the ladder: what is written there and the line that writes it.
JetCLIEffectsRung: struct {
    rung: String
    text: String
    written: Bool
    site: String
}

// One effect the site reaches: the first call chain that reaches it (the
// chain E0749 prints) and the `file:line` of its first step at the site.
JetCLIEffectsReach: struct {
    name: String
    chain: [String]
    site: String
}

// A scope inside a function body that holds the site: a `#FX` block, a
// lambda, or comptime code. A lambda carries its own checked effect facts.
JetCLIEffectsScope: struct {
    rung: String
    text: String
    span: Span
    lambda: Bool
    direct: [String]
    edges: [String]
}

// The innermost function holding the site, its effect-graph key, and the
// inline module, type and trait caps around the site, outermost first; each
// cap's `scope` names its rung.
JetCLIEffectsSite: struct {
    key: String
    function: Func?
    caps: [ModuleCap]
}

// One written cap for `--caps`: `kind` is `file`, `module`, `type` or
// `trait`, and `name` the module, type or trait it caps (empty for a file
// head).
JetCLIEffectsCapRow: struct {
    file: String
    line: Int
    cap: String
    kind: String
    name: String
}

// The site the command line names, resolved before anything is compiled. A
// `:<line>` suffix names a line; no site is the entry `jet run` would pick.
jet_cli_explain_effects: fn(jet_argv: [String], args: [String], color: Bool, json: Bool, threads: Int?) -[FS, Env]> JetCLIPlan Never! {
    fix: "run `{JET_CLI_EXPLAIN_EFFECTS_USAGE}`"
    if args.len() > 3 -> return jet_cli_fail("E2104", "`jet explain effects` explains one site", jet_cli_why("E2104"), fix, color, JET_DRIVER_EXIT_USAGE)
    caps: jet_cli_has(jet_argv, "--caps")
    target := ""
    if args.len() == 3 -> target = args[2]
    line := 0
    colon: jet_cli_effects_line_colon(target)
    if colon >= 0 {
        written_line: target.slice((colon + 1)..<target.len())
        if caps -> return jet_cli_fail("E2104", "`--caps` lists the effect caps under a file or directory, not at one line", jet_cli_why("E2104"), "drop `:{written_line}`, or drop `--caps`", color, JET_DRIVER_EXIT_USAGE)
        site: jet_cli_explain_marker_site(target) ?? return jet_cli_fail("E2104", err.message, jet_cli_why("E2104"), "correct the named argument or input, then run the command again", color, JET_DRIVER_EXIT_USAGE)
        line = Int.parse(written_line) ?? 0
        target = site.file
    }
    file := ""
    notice := ""
    if target == "" {
        directory: cli_files.cwd() ?? "."
        notices := [String]{}
        if jet_cli_resolve_bare_entry("run", directory, jet_cli_option_value(jet_argv, "-p"), false, color, notices) == {
            .Entry(entry) -> {
                file = entry.path
                notice = notices.join("")
            }
            .Refused(plan) -> return jet_cli_with_notices(notices, plan)
            .Absent -> return jet_cli_with_notices(notices, jet_cli_missing_bare_entry("run", directory, color))
        }
    } else if cli_files.is_dir(target) {
        if jet_cli_resolve_directory_target("run", target, None, false, color) == {
            .File(path, _, written) -> {
                file = path
                notice = written
            }
            .Refused(plan) -> return plan
        }
    } else {
        file = target
        if !cli_files.is_file(target) && cli_files.is_file("{target}.jet") -> file = "{target}.jet"
    }
    source: cli_files.read(file) ?? return jet_cli_report_done(notice, "E2105", "can't find the file `{file}`", jet_cli_why("E2105"), "check the spelling, or run jet from the folder that contains it", color, JET_DRIVER_EXIT_USER_ERROR)
    if line > 0 {
        lines: jet_cli_effects_line_count(source)
        if line > lines -> return jet_cli_fail("E2104", "line {line} is past the end of `{file}`, which has {lines} lines", jet_cli_why("E2104"), "name a line from 1 to {lines}", color, JET_DRIVER_EXIT_USAGE)
    }
    // A named file inside a package is explained as the package's entry loads
    // it, so the caps written where its module is declared are in force. A
    // `#!` script is its own program wherever it lives.
    site := ""
    entry_file := file
    if target != "" && !cli_files.is_dir(target) && !source.starts_with("#!") {
        if jet_cli_manifest_root(jet_cli_parent(jet_cli_inspect_absolute(file)) ?? ".") == .Val(root) {
            notices := [String]{}
            if jet_cli_resolve_bare_entry("run", root, None, false, color, notices) == .Entry(entry) {
                site = jet_cli_inspect_absolute(file)
                entry_file = entry.path
                notice = notices.join("")
            }
        }
    }
    // `--caps` lists the caps under this path: the project root with no
    // target, else the named directory or file.
    subject := String?{None}
    if caps {
        scope := file
        if target == "" {
            here: cli_files.cwd() ?? "."
            scope = jet_cli_manifest_root(here) ?? here
        }
        if cli_files.is_dir(target) -> scope = target
        subject = Val(cli_files.realpath(scope) ?? scope)
    }
    JetCLIPlan.Inspect{job: JetCLIInspectJob{action: "explain-effects", file: jet_cli_inspect_absolute(entry_file), subject: subject, json: json, color: color, threads: threads, notice: notice, project: false, site: site, line: line}}
}

// The index of the `:` before a trailing run of digits, else -1.
jet_cli_effects_line_colon: fn(target: String) -> Int Never! {
    bytes: target.bytes()
    index := bytes.len()
    loop index > 0 {
        byte: bytes[index - 1]
        if byte == (U8{58}) {
            if index == bytes.len() -> return -1
            return index - 1
        }
        if byte < (U8{48}) || byte > (U8{57}) -> return -1
        index -= 1
    }
    -1
}

// Lines in `source`; a final newline ends the last line rather than starting one.
jet_cli_effects_line_count: fn(source: String) -> Int Never! {
    bytes: source.bytes()
    count := 0
    loop byte in bytes {
        if byte == (U8{10}) -> count += 1
    }
    if bytes.len() > 0 && bytes[bytes.len() - 1] != (U8{10}) -> count += 1
    count
}

// The offset of the first non-blank byte on 1-based `line`, or -1 past the end.
jet_cli_effects_line_offset: fn(source: String, line: Int) -> Int Never! {
    bytes: source.bytes()
    current := 1
    index := 0
    loop current < line && index < bytes.len() {
        if bytes[index] == (U8{10}) -> current += 1
        index += 1
    }
    if current < line -> return -1
    loop index < bytes.len() && (bytes[index] == (U8{32}) || bytes[index] == (U8{9})) {
        index += 1
    }
    index
}

// `file:line` of `offset` in `doc_module`.
jet_cli_effects_site: fn(doc_module: JetDriverDocModule, offset: Int) -> String Never! {
    "{doc_module.path}:{diagnostic_line_at(doc_module.source, offset)}"
}

jet_cli_effects_entry_names: fn(entries: [EffectRowEntry]) -> String Never! {
    names: loop entry in entries -> entry.name
    names.join(", ")
}

jet_cli_effects_cap_text: fn(entries: [EffectRowEntry]) -> String Never! {
    "#FX({jet_cli_effects_entry_names(entries)})"
}

// A function or lambda row as written: `-[…]>`, `-[]>` for a pure
// function, or "" when none is written.
jet_cli_effects_row_text: fn(effects: [EffectRowEntry]?, is_pure: Bool) -> String Never! {
    if effects == .Val(entries) -> return "-[{jet_cli_effects_entry_names(entries)}]>"
    if is_pure -> return "-[]>"
    ""
}

jet_cli_effects_scope_rung: fn(rung: String, text: String, span: Span) -> JetCLIEffectsScope Never! {
    JetCLIEffectsScope{rung: rung, text: text, span: span, lambda: false, direct: [String]{}, edges: [String]{}}
}

jet_cli_effects_holds: fn(span: Span, offset: Int) -> Bool Never! {
    span.start <= offset && offset < span.end
}

// Every `#FX` block and comptime scope of `statements` that holds `offset`.
// Bodies inside expressions (`if` arms, lambdas) are reached through
// jet_cli_effects_note_expr.
jet_cli_effects_body_scopes: fn(statements: [Stmt], offset: Int, scopes: &[JetCLIEffectsScope]) Never! {
    loop statement in statements {
        if statement == {
            .AuthorityScope(caps, _, _, body, span) -> {
                if jet_cli_effects_holds(span, offset) {
                    names: loop cap in caps -> cap.name
                    scopes.push(jet_cli_effects_scope_rung("block", "#FX({names.join(", ")})", span))
                }
                jet_cli_effects_body_scopes(body, offset, scopes)
            }
            .ComptimeBlock(body, _, span) -> {
                if jet_cli_effects_holds(span, offset) -> scopes.push(jet_cli_effects_scope_rung("comptime", "Mem only; other effects need `#Impure(\"reason\")`", span))
                jet_cli_effects_body_scopes(body, offset, scopes)
            }
            .Impure(reason, _, body, span) -> {
                if jet_cli_effects_holds(span, offset) -> scopes.push(jet_cli_effects_scope_rung("comptime", "`#Impure(\"{reason ?? "…"}\")` lifts the Mem-only rule", span))
                jet_cli_effects_body_scopes(body, offset, scopes)
            }
            .While(_, body, _, _, _)
            | .For(_, _, _, _, body, _, _, _, _)
            | .Loop(body, _, _, _)
            | .CountedLoop(_, _, _, body, _, _, _)
            | .Unsafe(_, _, body, _)
            | .Reactive(body, _)
            | .Shield(body, _)
            | .Switched(_, body, _)
            | .Region(_, _, body, _)
            | .Policy(_, body, _)
            | .TaskGroup(_, _, _, body, _)
            | .Layout(_, _, body, _)
            | .ContextBlock(_, body, _)
            | .Live(body, _)
            | .AssumeDet(_, _, body, _)
            | .Transact(_, _, body, _, _)
            | .ScopeMember(_, _, _, _, body, _, _, _) -> jet_cli_effects_body_scopes(body, offset, scopes)
            .Switch(_, arms, else_body, _) | .ComptimeSwitch(_, arms, else_body, _) -> {
                loop arm in arms -> jet_cli_effects_body_scopes(arm.body, offset, scopes)
                if else_body == .Val(body) -> jet_cli_effects_body_scopes(body, offset, scopes)
            }
            .ComptimeIf(_, _, then_body, else_body, _, _) -> {
                jet_cli_effects_body_scopes(then_body, offset, scopes)
                if else_body == .Val(body) -> jet_cli_effects_body_scopes(body, offset, scopes)
            }
            .Expr(_) | .Val(_) | .Assign(_, _, _, _) | .Return(_, _) | .Break(_) | .BreakValue(_, _) | .Continue(_) | .BreakLabel(_, _) | .BreakLabelValue(_, _, _, _) | .ContinueLabel(_, _) | .Yield(_, _) | .DeferClose(_, _) -> {}
        }
    }
}

// The expression bodies that hold statements: a lambda holding `offset` is
// its own function rung, with the effect facts sema settled for it.
jet_cli_effects_note_expr: fn(scopes: &[JetCLIEffectsScope], expression: Expr, offset: Int) Never! {
    if expression == {
        .Lambda(lambda, _) -> {
            if jet_cli_effects_holds(lambda.span, offset) {
                row: jet_cli_effects_row_text(lambda.effects, false)
                text: if row == "" -> "lambda (none written)" else -> "lambda {row}"
                scopes.push(JetCLIEffectsScope{rung: "function", text: text, span: lambda.span, lambda: true, direct: lambda.meta.effect_direct.copy(), edges: lambda.meta.effect_call_edges.copy()})
            }
            if lambda.body == .Block(body) -> jet_cli_effects_body_scopes(body, offset, scopes)
        }
        .If(_, then_body, _, else_body, _, _, _) -> {
            jet_cli_effects_body_scopes(then_body, offset, scopes)
            jet_cli_effects_body_scopes(else_body, offset, scopes)
        }
        .Str(_, _, _) | .StrMatchLit(_, _, _) | .BinMatchLit(_, _, _) | .Int(_, _, _, _, _) | .Float(_, _, _, _, _) | .Bool(_, _, _) | .Unit(_, _) | .Char(_, _, _) | .ListLit(_, _, _) | .MemberSpread(_, _, _, _) | .Spread(_, _, _) | .MapLit(_, _, _) | .Index(_, _, _, _, _) | .Slice(_, _, _, _, _, _) | .Range(_, _, _, _, _) | .Ident(_, _, _) | .Call(_, _) | .Unary(_, _, _, _) | .Binary(_, _, _, _, _) | .CompareChain(_, _, _, _, _) | .UnitLit(_, _, _, _, _, _, _) | .Deref(_, _, _) | .RawOf(_, _, _) | .Copy(_, _, _) | .Place(_, _, _, _) | .Field(_, _, _, _) | .OptField(_, _, _, _, _, _) | .MethodCall(_, _, _, _, _, _, _) | .OptMethodCall(_, _, _, _, _, _, _) | .StructLit(_, _, _, _, _, _, _, _) | .TypedLit(_, _, _, _) | .EnumLit(_, _, _, _, _, _, _) | .Tainted(_, _, _, _) | .Present(_, _, _) | .Absent(_, _) | .Todo(_, _, _) | .NoElse(_, _) | .PatternTest(_, _, _, _) | .Ok(_, _, _) | .Err(_, _, _) | .Try(_, _, _, _, _) | .OrFallback(_, _, _, _, _) | .TupleLit(_, _, _, _) | .CallValue(_, _, _, _) | .PtrFromAddr(_, _, _, _, _, _) | .ComptimeName(_, _, _, _) | .Paren(_, _, _) | .Pipe(_, _, _, _) | .TypeValue(_, _, _) -> {}
    }
}

// Innermost first: a later start, then a shorter span.
jet_cli_effects_scopes_sorted: fn(scopes: [JetCLIEffectsScope]) -> [JetCLIEffectsScope] Never! {
    sorted := scopes
    loop index in 1..<sorted.len() {
        value: sorted[index]
        position := index
        loop position > 0 {
            previous: sorted[position - 1]
            outer: previous.span.start < value.span.start || (previous.span.start == value.span.start && previous.span.end > value.span.end)
            if !outer -> break
            sorted[position] = previous
            position -= 1
        }
        sorted[position] = value
    }
    sorted
}

// Keep `function` when it holds `offset` and starts inside the current pick.
// Its module rungs are the caps the checker binds it by (`module_caps`, set
// where the module is written, outermost first), so a function an inline
// module or a generic module instance lowered to a file-level copy keeps
// them; `caps` adds the type and trait caps around it.
jet_cli_effects_take: fn(found: &JetCLIEffectsSite, key: String, function: Func, caps: [ModuleCap], offset: Int) Never! {
    if function.compiler_generated || !jet_cli_effects_holds(function.span, offset) -> return
    if found.function == .Val(current) {
        if current.span.start >= function.span.start -> return
    }
    found.key = key
    found.function = Val(function.copy())
    // copy: the site keeps its own caps; `function` stays the caller's.
    found.caps = function.module_caps.copy()
    loop cap in caps {
        // copy: each type or trait cap is the site's own.
        if cap.scope != "module" -> found.caps.push(cap.copy())
    }
}

// The innermost function holding `offset`, keyed as `jet inspect rights`
// keys it (jet_cli_rights_collect), and the inline module, type and trait
// caps around it.
jet_cli_effects_locate: fn(items: [Item], alias: String, namespace: String, offset: Int, caps: [ModuleCap], found: &JetCLIEffectsSite) Never! {
    loop item in items {
        if item == {
            .Func(function) -> jet_cli_effects_take(found, "{alias}.{namespace}{function.name}", function, caps, offset)
            .Impl(definition) -> {
                typed := jet_cli_effects_with_cap(caps, jet_cli_effects_type_cap(items, definition.type_name), "type")
                if definition.trait_name == .Val(trait_name) -> typed = jet_cli_effects_with_cap(typed, jet_cli_effects_trait_cap(items, trait_name), "trait")
                loop method in definition.methods -> jet_cli_effects_take(found, "{alias}.{namespace}{definition.type_name}.{method.name}", method, typed, offset)
            }
            .Struct(definition) -> {
                typed: jet_cli_effects_with_cap(caps, definition.cap, "type")
                loop method in definition.methods -> jet_cli_effects_take(found, "{alias}.{namespace}{definition.name}.{method.name}", method, typed, offset)
                loop block in definition.trait_impls {
                    traited: jet_cli_effects_with_cap(typed, jet_cli_effects_trait_cap(items, block.trait_name), "trait")
                    loop method in block.methods -> jet_cli_effects_take(found, "{alias}.{namespace}{definition.name}.{method.name}", method, traited, offset)
                }
            }
            .Enum(definition) -> {
                typed: jet_cli_effects_with_cap(caps, definition.cap, "type")
                loop method in definition.methods -> jet_cli_effects_take(found, "{alias}.{namespace}{definition.name}.{method.name}", method, typed, offset)
                loop block in definition.trait_impls {
                    traited: jet_cli_effects_with_cap(typed, jet_cli_effects_trait_cap(items, block.trait_name), "trait")
                    loop method in block.methods -> jet_cli_effects_take(found, "{alias}.{namespace}{definition.name}.{method.name}", method, traited, offset)
                }
            }
            .CodeModule(nested) -> {
                if nested.body == .Val(body) && jet_cli_effects_holds(nested.span, offset) {
                    inner := caps.copy()
                    if nested.cap == .Val(cap) -> inner.push(cap.copy())
                    if found.function == None -> found.caps = inner.copy()
                    jet_cli_effects_locate(body, alias, "{namespace}{nested.name}__", offset, inner, found)
                }
            }
            .GenericModule(nested) -> {
                // A template in the checked items (its instances are lowered
                // to file-level functions, found above) holds its own cap.
                if jet_cli_effects_holds(nested.span, offset) {
                    // copy: the nested caps extend the caller's, which stay its own.
                    inner := caps.copy()
                    // copy: the template keeps its cap.
                    if nested.cap == .Val(cap) -> inner.push(cap.copy())
                    // copy: the site keeps the caps; the walk goes on with `inner`.
                    if found.function == None -> found.caps = inner.copy()
                    jet_cli_effects_locate(nested.body, alias, "{namespace}{nested.name}__", offset, inner, found)
                }
            }
            .Distinct(_) | .TypeAlias(_) | .UnitFamily(_) | .Trait(_) | .Tag(_) | .EffectDecl(_) | .Const(_) | .Test(_) | .ExternRust(_) | .Module(_) | .CModule(_) | .ErrorConv(_) | .Migration(_) | .ProtocolDecl(_) | .TemplateLoop(_) | .ModuleAlias(_) | .MarkerDecl(_) | .FactDecl(_) -> {}
        }
    }
}

// `caps` with a type or trait cap innermost, on the `scope` rung, when one
// is written.
jet_cli_effects_with_cap: fn(caps: [ModuleCap], cap: ModuleCap?, scope: String) -> [ModuleCap] Never! {
    typed := caps.copy()
    if cap == .Val(value) -> typed.push(ModuleCap{owner: value.owner.copy(), scope: scope, entries: value.entries.copy(), span: value.span})
    typed
}

// The cap of the trait `name` declared beside an impl of it.
jet_cli_effects_trait_cap: fn(items: [Item], name: String) -> ModuleCap? Never! {
    loop item in items {
        if item == .Trait(definition) && definition.name == name -> return definition.cap
    }
    None
}

// The cap of the struct or enum `name` declared beside an impl of it.
jet_cli_effects_type_cap: fn(items: [Item], name: String) -> ModuleCap? Never! {
    loop item in items {
        if item == {
            .Struct(definition) -> {
                if definition.name == name -> return definition.cap
            }
            .Enum(definition) -> {
                if definition.name == name -> return definition.cap
            }
            .Func(_) | .Distinct(_) | .TypeAlias(_) | .UnitFamily(_) | .Trait(_) | .Tag(_) | .EffectDecl(_) | .Impl(_) | .Const(_) | .Test(_) | .ExternRust(_) | .Module(_) | .CModule(_) | .CodeModule(_) | .ErrorConv(_) | .Migration(_) | .ProtocolDecl(_) | .TemplateLoop(_) | .GenericModule(_) | .ModuleAlias(_) | .MarkerDecl(_) | .FactDecl(_) -> {}
        }
    }
    None
}

// Does `name: module` declared beside `directory` name the file `target`?
// The loader reads `name.jet`, else `name/module.jet`.
jet_cli_effects_declares: fn(directory: String, name: String, target: String) -> Bool Never! {
    target == ("{directory}/{name}.jet") || target == ("{directory}/{name}/module.jet")
}

// The `#FX(…) name: module` caps over the file module `index`, nearest
// first: the cap where the file is declared, then the caps over the file
// that declares it.
jet_cli_effects_file_caps: fn(modules: [JetDriverDocModule], index: Int, depth: Int, rungs: &[JetCLIEffectsRung]) Never! {
    if depth > modules.len() -> return
    target: modules[index].physical_path
    loop (parent_index, parent) in modules {
        if parent_index == index -> next
        directory: jet_cli_parent(parent.physical_path) ?? next
        loop item in parent.items {
            if item == .CodeModule(definition) && definition.body == None {
                if !jet_cli_effects_declares(directory, definition.name, target) -> next
                if definition.cap == .Val(cap) -> rungs.push(JetCLIEffectsRung{rung: "module", text: jet_cli_effects_cap_text(cap.entries), written: true, site: jet_cli_effects_site(parent, cap.span.start)})
                jet_cli_effects_file_caps(modules, parent_index, depth + 1, rungs)
            }
        }
    }
}

// The line of the first `authority` row in the manifest, 0 when none.
jet_cli_effects_authority_line: fn(source: String) -> Int Never! {
    loop (index, text) in source.split("\n").to_list() {
        if text.trim().starts_with("authority") -> return index + 1
    }
    0
}

// The package rung: the entry package's written `authority` rows, named at
// the manifest line that writes them.
jet_cli_effects_package_rung: fn(policy: JetDriverAuthorityPolicy?) -[FS]> JetCLIEffectsRung Never! {
    none: JetCLIEffectsRung{rung: "package", text: "(none written)", written: false, site: ""}
    written: policy ?? return none
    manifest: written.manifest_path ?? return none
    rows := [String]{}
    if written.allow == .Val(allow) -> rows.push("allow: [{allow.join(", ")}]")
    if written.deny == .Val(deny) -> rows.push("deny: [{deny.join(", ")}]")
    if rows.len() == 0 -> return none
    shown: jet_driver_display_path(jet_cli_parent(manifest) ?? "", manifest)
    line: jet_cli_effects_authority_line(cli_files.read(manifest) ?? "")
    site: if line > 0 -> "{shown}:{line}" else -> shown
    JetCLIEffectsRung{rung: "package", text: rows.join(", "), written: true, site: site}
}

// Every effect the site reaches, deny-only ones (`Panic`, `Mem`,
// `Time.Wait`) too: no rung grants those, but a `deny` row or `--deny`
// refuses them, so the explanation names them. Each chain step reads as its
// source spells it.
jet_cli_effects_reach_add: fn(reaches: &[JetCLIEffectsReach], name: String, chain: [String], site: String) Never! {
    loop reach in reaches {
        if reach.name == name -> return
    }
    shown: loop step in chain -> jet_cli_effects_source_key(step)
    // copy: the reach keeps its own name and site; the caller keeps theirs.
    reaches.push(JetCLIEffectsReach{name: name.copy(), chain: shown, site: site.copy()})
}

// A function name as its source spells it: a function of an inline module
// or a generic module instance, lowered to a generated file-level name
// (`__jet_counter_dbump`), reads as its source path (`counter.bump`).
jet_cli_effects_source_name: fn(name: String) -> String Never! {
    // copy: the shown name is the caller's own; `name` stays the caller's.
    if !name.starts_with("__jet_") -> return name.copy()
    // copy: an undecodable name shows as written.
    sema_inline_decode_generated_suffix(name.removeprefix("__jet_")) ?? name.copy()
}

// An effect-graph key (`pricing.rates`, `generic.__jet_counter_dbump`)
// with each part as its source spells it.
jet_cli_effects_source_key: fn(key: String) -> String Never! {
    parts: loop part in key.split(".") -> jet_cli_effects_source_name(part)
    parts.join(".")
}

jet_cli_effects_reaches_sorted: fn(reaches: [JetCLIEffectsReach]) -> [JetCLIEffectsReach] Never! {
    sorted := reaches
    loop index in 1..<sorted.len() {
        value: sorted[index]
        position := index
        loop position > 0 && sorted[position - 1].name > value.name {
            sorted[position] = sorted[position - 1]
            position -= 1
        }
        sorted[position] = value
    }
    sorted
}

// What the function `key` of `doc_module` reaches, each effect with its first
// call chain (the semantic index witness E0749 and `jet inspect rights` name).
jet_cli_effects_function_reaches: fn(doc_module: JetDriverDocModule, key: String, summaries: [SemSummary], modules: [JetDriverDocModule], reaches: &[JetCLIEffectsReach]) {
    summary: semindex_summary(summaries, key) ?? return
    effects: if summary.solved.len() > 0 -> summary.solved else -> summary.direct
    loop name in effects {
        chain := [String]{key}
        site := ""
        if semindex_witness(key, name, summaries, [String]{}, modules) == .Val(witness) {
            if witness.path.len() > 0 -> chain = witness.path
            if witness.spans.len() > 0 && witness.spans[0].end > 0 -> site = jet_cli_effects_site(doc_module, witness.spans[0].start)
        }
        jet_cli_effects_reach_add(reaches, name, chain, site)
    }
}

jet_cli_effects_raw_summary: fn(summaries: [SemSummary], raw_key: String) -> SemSummary? Never! {
    loop summary in summaries {
        if summary.raw_key == raw_key -> return Val(summary)
    }
    None
}

// What part of a function reaches: its own `direct` effects, and through each
// call in `edges` (a checked function key at its call span) whatever that
// callee reaches.
jet_cli_effects_part_reaches: fn(doc_module: JetDriverDocModule, owner: String, direct: [EffectRowEntry], edges: [EffectRowEntry], summaries: [SemSummary], modules: [JetDriverDocModule], reaches: &[JetCLIEffectsReach]) {
    loop entry in direct -> jet_cli_effects_reach_add(reaches, entry.name, [String]{owner}, jet_cli_effects_site(doc_module, entry.span.start))
    loop edge in edges {
        callee: jet_cli_effects_raw_summary(summaries, edge.name) ?? next
        loop name in callee.solved {
            chain := [String]{owner}
            if semindex_witness(callee.key, name, summaries, [String]{}, modules) == .Val(witness) && witness.path.len() > 0 {
                loop part in witness.path -> chain.push(part.copy())
            } else {
                chain.push(callee.key.copy())
            }
            jet_cli_effects_reach_add(reaches, name, chain, jet_cli_effects_site(doc_module, edge.span.start))
        }
    }
}

// A `#FX` block or comptime scope of the function `key`: the direct effects
// and calls the checker recorded inside `span`.
jet_cli_effects_span_reaches: fn(doc_module: JetDriverDocModule, key: String, span: Span, summaries: [SemSummary], modules: [JetDriverDocModule], reaches: &[JetCLIEffectsReach]) {
    summary: semindex_summary(summaries, key) ?? return
    direct := [EffectRowEntry]{}
    loop function in doc_module.functions {
        if function.key != summary.raw_key -> next
        loop entry in function.effects.direct_spans {
            if entry.span.start >= span.start && entry.span.end <= span.end -> direct.push(EffectRowEntry{name: entry.name.copy(), span: entry.span})
        }
    }
    edges := [EffectRowEntry]{}
    loop fact in doc_module.call_facts {
        if fact.caller_key != summary.raw_key -> next
        if fact.span.start < span.start || fact.span.end > span.end -> next
        if fact.foreign_effect_root == .Val(root) -> direct.push(EffectRowEntry{name: root.copy(), span: fact.span})
        target: fact.callee ?? next
        edges.push(EffectRowEntry{name: target.key.copy(), span: fact.span})
    }
    jet_cli_effects_part_reaches(doc_module, key, direct, edges, summaries, modules, reaches)
}

// The span of the first call to `callee` inside `within`, else `within`.
jet_cli_effects_call_span: fn(doc_module: JetDriverDocModule, callee: String, within: Span) -> Span Never! {
    loop fact in doc_module.call_facts {
        target: fact.callee ?? next
        if target.key == callee && fact.span.start >= within.start && fact.span.end <= within.end -> return Span{start: fact.span.start, end: fact.span.end}
    }
    Span{start: within.start, end: within.end}
}

// `  block     #FX(Net.HTTP)   Source/sync.jet:12`: the text column is
// `width` wide so every site lines up.
jet_cli_effects_rung_line: fn(rung: JetCLIEffectsRung, width: Int) -> String Never! {
    if rung.site == "" -> return "  {jet_cli_pad(rung.rung, 10)}{rung.text}"
    "  {jet_cli_pad(rung.rung, 10)}{jet_cli_pad(rung.text, width)}{rung.site}"
}

// `FS.Read via pricing.rates (main.jet:6)`: the first call after the site's
// own function, and where the site makes it.
jet_cli_effects_reach_text: fn(reach: JetCLIEffectsReach) -> String Never! {
    via: if reach.chain.len() > 1 -> " via {reach.chain[1]}" else -> ""
    at: if reach.site != "" -> " ({reach.site})" else -> ""
    "{reach.name}{via}{at}"
}

jet_cli_effects_rung_value: fn(rung: JetCLIEffectsRung) -> JetCLIStatusValue Never! {
    jet_cli_status_object([JetCLIStatusField]{
        jet_cli_status_field("rung", jet_cli_status_text(rung.rung)),
        jet_cli_status_field("written", jet_cli_status_bool(rung.written)),
        jet_cli_status_field("text", jet_cli_status_text(rung.text)),
        jet_cli_status_field("site", jet_cli_status_text(rung.site)),
    })
}

jet_cli_effects_reach_value: fn(reach: JetCLIEffectsReach) -> JetCLIStatusValue Never! {
    jet_cli_status_object([JetCLIStatusField]{
        jet_cli_status_field("effect", jet_cli_status_text(reach.name)),
        jet_cli_status_field("chain", jet_cli_status_texts(reach.chain)),
        jet_cli_status_field("site", jet_cli_status_text(reach.site)),
    })
}

// The ladder at the job's site over one checked program.
jet_cli_explain_effects_report: fn(result: JetDriverCompileResult, job: JetCLIInspectJob) -[FS]> JetDriverVerbOutput {
    modules: result.doc_modules
    if job.subject == .Val(scope) -> return jet_cli_effects_caps_report(modules, scope, job.json)
    target: if job.site != "" -> job.site else -> job.file
    selected := -1
    loop (index, doc_module) in modules {
        if selected < 0 && jet_cli_rights_selected(doc_module, target) -> selected = index
    }
    if selected < 0 -> return jet_cli_replay_fail(job, "E2104", "`{target}` is not a module the program `{job.file}` loads", jet_cli_why("E2104"), "name a file the entry loads, or the entry itself", JET_DRIVER_EXIT_USAGE)
    doc_module: modules[selected]
    alias: semindex_module_alias(doc_module)
    summaries: semindex_summaries(modules)
    offset := -1
    if job.line > 0 -> offset = jet_cli_effects_line_offset(doc_module.source, job.line)
    found := JetCLIEffectsSite{key: "", function: None, caps: [ModuleCap]{}}
    if offset >= 0 {
        jet_cli_effects_locate(doc_module.items, alias, "", offset, [ModuleCap]{}, found)
    } else {
        // A whole file is its module, plus its `run` when it has one.
        loop item in doc_module.items {
            if item == .Func(function) && function.name == "run" && !function.compiler_generated {
                found.key = "{alias}.run"
                found.function = Val(function.copy())
            }
        }
    }
    rungs := [JetCLIEffectsRung]{}
    reaches := [JetCLIEffectsReach]{}
    site: if job.line > 0 -> "{doc_module.path}:{job.line}" else -> doc_module.path
    header := "effects at {site}, nearest first"
    if found.function == .Val(function) {
        header = "effects at {site}, in `{jet_cli_effects_source_name(function.name)}`, nearest first"
        scopes := [JetCLIEffectsScope]{}
        if offset >= 0 {
            jet_cli_effects_body_scopes(function.body, offset, scopes)
            ast_visit_body(function.body, fn(inner: Expr) { jet_cli_effects_note_expr(scopes, inner, offset) }, true)
        }
        ordered: jet_cli_effects_scopes_sorted(scopes)
        loop scope in ordered -> rungs.push(JetCLIEffectsRung{rung: scope.rung, text: scope.text, written: true, site: jet_cli_effects_site(doc_module, scope.span.start)})
        row: jet_cli_effects_row_text(function.declared_effects, function.is_pure)
        rungs.push(JetCLIEffectsRung{rung: "function", text: if row == "" -> "(none written)" else -> row, written: row != "", site: jet_cli_effects_site(doc_module, function.name_span.start)})
        if function.is_comptime -> rungs.push(JetCLIEffectsRung{rung: "comptime", text: "Mem only; other effects need `#Impure(\"reason\")`", written: true, site: jet_cli_effects_site(doc_module, function.span.start)})
        if ordered.len() == 0 {
            jet_cli_effects_function_reaches(doc_module, found.key, summaries, modules, reaches)
        } else if ordered[0].lambda {
            lambda_span: ordered[0].span
            direct: loop name in ordered[0].direct -> EffectRowEntry{name: name, span: lambda_span}
            edges: loop edge in ordered[0].edges -> EffectRowEntry{name: edge, span: jet_cli_effects_call_span(doc_module, edge, lambda_span)}
            jet_cli_effects_part_reaches(doc_module, found.key, direct, edges, summaries, modules, reaches)
        } else {
            jet_cli_effects_span_reaches(doc_module, found.key, ordered[0].span, summaries, modules, reaches)
        }
    } else {
        // A line outside every function: what the module's functions reach.
        views := [JetCLICallableView]{}
        jet_cli_rights_collect(doc_module.items, alias, "", doc_module.path, views)
        loop view in jet_cli_rights_sorted(views) -> jet_cli_effects_function_reaches(doc_module, view.key, summaries, modules, reaches)
    }
    // The trait and type rungs come before the module rungs; the file-head
    // cap is a module rung, written at the head of the file.
    type_rungs := [JetCLIEffectsRung]{}
    cap_rungs := [JetCLIEffectsRung]{}
    loop index in 0..<found.caps.len() {
        cap: found.caps[found.caps.len() - 1 - index]
        rung: JetCLIEffectsRung{rung: cap.scope, text: jet_cli_effects_cap_text(cap.entries), written: true, site: jet_cli_effects_site(doc_module, cap.span.start)}
        if cap.scope == "module" -> cap_rungs.push(rung) else -> type_rungs.push(rung)
    }
    if doc_module.file_cap == .Val(head) -> cap_rungs.push(JetCLIEffectsRung{rung: "module", text: jet_cli_effects_cap_text(head.entries), written: true, site: jet_cli_effects_site(doc_module, head.span.start)})
    jet_cli_effects_file_caps(modules, selected, 0, cap_rungs)
    type_written := false
    loop rung in type_rungs {
        if rung.rung == "type" -> type_written = true
    }
    if !type_written -> type_rungs.push(JetCLIEffectsRung{rung: "type", text: "(none written)", written: false, site: ""})
    if cap_rungs.len() == 0 -> cap_rungs.push(JetCLIEffectsRung{rung: "module", text: "(none written)", written: false, site: ""})
    loop rung in type_rungs -> rungs.push(rung)
    loop rung in cap_rungs -> rungs.push(rung)
    rungs.push(jet_cli_effects_package_rung(result.authority_policy))
    rungs.push(JetCLIEffectsRung{rung: "run", text: JET_CLI_EXPLAIN_EFFECTS_RUN, written: false, site: ""})
    reached: jet_cli_effects_reaches_sorted(reaches)
    if job.json {
        fields: [JetCLIStatusField]{
            jet_cli_status_field("site", jet_cli_status_text(site)),
            jet_cli_status_field("rungs", jet_cli_status_array(loop rung in rungs -> jet_cli_effects_rung_value(rung))),
            jet_cli_status_field("reaches", jet_cli_status_array(loop reach in reached -> jet_cli_effects_reach_value(reach))),
        }
        return JetDriverVerbOutput{stdout: "{jet_cli_status_render("explain.effects", true, fields)}\n", stderr: "", exit_code: JET_DRIVER_EXIT_OK}
    }
    width := 0
    loop rung in rungs {
        if rung.site != "" && rung.text.len() + 2 > width -> width = rung.text.len() + 2
    }
    lines: loop rung in rungs -> jet_cli_effects_rung_line(rung, width)
    parts: loop reach in reached -> jet_cli_effects_reach_text(reach)
    reach_line: if parts.len() == 0 -> "nothing" else -> parts.join(", ")
    JetDriverVerbOutput{stdout: "{header}\n{lines.join("\n")}\nreaches: {reach_line}\n", stderr: "", exit_code: JET_DRIVER_EXIT_OK}
}

jet_cli_effects_cap_row: fn(doc_module: JetDriverDocModule, cap: ModuleCap, kind: String, name: String) -> JetCLIEffectsCapRow Never! {
    JetCLIEffectsCapRow{file: doc_module.path.copy(), line: diagnostic_line_at(doc_module.source, cap.span.start), cap: jet_cli_effects_cap_text(cap.entries), kind: kind, name: name.copy()}
}

// `row` unless the same cap is listed already: a module's cap is read both
// where the module is written and from each function it binds.
jet_cli_effects_cap_add: fn(rows: &[JetCLIEffectsCapRow], row: &&JetCLIEffectsCapRow) Never! {
    loop listed in rows {
        if listed.file == row.file && listed.line == row.line && listed.cap == row.cap && listed.kind == row.kind && listed.name == row.name -> return
    }
    rows.push(row.move())
}

// The module caps that bind `function` (Func.module_caps). A generic
// module's template is gone from the checked items once its instances are
// lowered, so its cap is read from the functions it binds, under the
// template's name.
jet_cli_effects_function_caps: fn(doc_module: JetDriverDocModule, function: Func, rows: &[JetCLIEffectsCapRow]) Never! {
    loop cap in function.module_caps -> jet_cli_effects_cap_add(rows, jet_cli_effects_cap_row(doc_module, cap, "module", cap.owner))
}

jet_cli_effects_collect_caps: fn(doc_module: JetDriverDocModule, items: [Item], rows: &[JetCLIEffectsCapRow]) Never! {
    loop item in items {
        if item == {
            .CodeModule(definition) -> {
                if definition.cap == .Val(cap) -> jet_cli_effects_cap_add(rows, jet_cli_effects_cap_row(doc_module, cap, "module", definition.name))
                if definition.body == .Val(body) -> jet_cli_effects_collect_caps(doc_module, body, rows)
            }
            .GenericModule(nested) -> {
                if nested.cap == .Val(cap) -> jet_cli_effects_cap_add(rows, jet_cli_effects_cap_row(doc_module, cap, "module", nested.name))
                jet_cli_effects_collect_caps(doc_module, nested.body, rows)
            }
            .Func(function) -> jet_cli_effects_function_caps(doc_module, function, rows)
            .Impl(definition) -> {
                loop method in definition.methods -> jet_cli_effects_function_caps(doc_module, method, rows)
            }
            .Struct(definition) -> {
                if definition.cap == .Val(cap) -> jet_cli_effects_cap_add(rows, jet_cli_effects_cap_row(doc_module, cap, "type", definition.name))
                loop method in definition.methods -> jet_cli_effects_function_caps(doc_module, method, rows)
                loop block in definition.trait_impls {
                    loop method in block.methods -> jet_cli_effects_function_caps(doc_module, method, rows)
                }
            }
            .Enum(definition) -> {
                if definition.cap == .Val(cap) -> jet_cli_effects_cap_add(rows, jet_cli_effects_cap_row(doc_module, cap, "type", definition.name))
                loop method in definition.methods -> jet_cli_effects_function_caps(doc_module, method, rows)
                loop block in definition.trait_impls {
                    loop method in block.methods -> jet_cli_effects_function_caps(doc_module, method, rows)
                }
            }
            .Trait(definition) -> {
                if definition.cap == .Val(cap) -> jet_cli_effects_cap_add(rows, jet_cli_effects_cap_row(doc_module, cap, "trait", definition.name))
            }
            .Distinct(_) | .TypeAlias(_) | .UnitFamily(_) | .Tag(_) | .EffectDecl(_) | .Const(_) | .Test(_) | .ExternRust(_) | .Module(_) | .CModule(_) | .ErrorConv(_) | .Migration(_) | .ProtocolDecl(_) | .TemplateLoop(_) | .ModuleAlias(_) | .MarkerDecl(_) | .FactDecl(_) -> {}
        }
    }
}

// `--caps`: every file-head, module, type and trait cap written in a checked
// module under `scope` (a canonical file or directory path), sorted by path,
// then line.
jet_cli_effects_caps_report: fn(modules: [JetDriverDocModule], scope: String, json: Bool) -[FS]> JetDriverVerbOutput Never! {
    rows := [JetCLIEffectsCapRow]{}
    loop doc_module in modules {
        path: cli_files.realpath(doc_module.physical_path) ?? doc_module.physical_path
        if path != scope && !path.starts_with("{scope}/") -> next
        if doc_module.file_cap == .Val(head) -> rows.push(jet_cli_effects_cap_row(doc_module, head, "file", ""))
        jet_cli_effects_collect_caps(doc_module, doc_module.items, rows)
    }
    loop index in 1..<rows.len() {
        value: rows[index]
        position := index
        loop position > 0 {
            previous: rows[position - 1]
            after: previous.file > value.file || (previous.file == value.file && previous.line > value.line)
            if !after -> break
            rows[position] = previous
            position -= 1
        }
        rows[position] = value
    }
    if json {
        values: loop row in rows -> jet_cli_status_object([JetCLIStatusField]{
            jet_cli_status_field("file", jet_cli_status_text(row.file)),
            jet_cli_status_field("line", jet_cli_status_int(row.line)),
            jet_cli_status_field("cap", jet_cli_status_text(row.cap)),
            jet_cli_status_field("kind", jet_cli_status_text(row.kind)),
            jet_cli_status_field("name", jet_cli_status_text(row.name)),
        })
        fields: [JetCLIStatusField]{
            jet_cli_status_field("scope", jet_cli_status_text(scope)),
            jet_cli_status_field("caps", jet_cli_status_array(values)),
        }
        return JetDriverVerbOutput{stdout: "{jet_cli_status_render("explain.effects", true, fields)}\n", stderr: "", exit_code: JET_DRIVER_EXIT_OK}
    }
    if rows.len() == 0 -> return JetDriverVerbOutput{stdout: "(none written)\n", stderr: "", exit_code: JET_DRIVER_EXIT_OK}
    lines: loop row in rows -> if row.name == "" -> "{row.file}:{row.line}  {row.cap}  {row.kind}" else -> "{row.file}:{row.line}  {row.cap}  {row.kind} {row.name}"
    JetDriverVerbOutput{stdout: "{lines.join("\n")}\n", stderr: "", exit_code: JET_DRIVER_EXIT_OK}
}
