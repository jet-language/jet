// `jet test`'s settings (jet_foundation
// Registry/TestSettings.jet): the selected test profile's, then those of
// test.jet's `test: fn`, then the flags, each later layer replacing the
// earlier. A run decides them once; each child it starts (a profile run, an
// optimize level, another compiler) gets them whole in TEST_SETTINGS_ENV and
// decides nothing again.
use {
    cli_files: core.files
    cli_process: core.process
    cli_sys: core.sys
    jet_driver.[JET_DRIVER_EXIT_USAGE, JET_DRIVER_EXIT_USER_ERROR]
    jet_foundation.[
        DerivationRecord,
        EVIDENCE_REPORT_ENV,
        EvidenceExpectation,
        EvidenceOutcome,
        EvidenceRecord,
        evidence_merge_error_text,
        evidence_report_read,
        evidence_report_try_from_records,
        evidence_report_write,
        TEST_SETTINGS_ENV,
        TEST_SETTINGS_PLAN_ENV,
        TestSetting,
        TestSettingError,
        test_settings_get,
        test_settings_levels,
        test_settings_lines,
        test_settings_on,
        test_setting_flag,
        test_settings_parse_lines,
        test_settings_shard_count,
    ]
    jet_pkg_model.[TEST_CODE_SUITES_FILE, TEST_SUITE_TESTS, pkg_test_sets_settings]
    jet_testkit.[KitCaseResult, kit_report_document]
}

// The layer a flag writes.
JET_CLI_TEST_FLAG_LAYER: "flag"
// The settings a parent run keeps for itself: it picks the compiler and the
// optimize level of each child, writes the one `results` document, and runs
// the corpus suites, which the corpus-pool settings size and steer.
JET_CLI_TEST_PARENT_SETTINGS: [String]{"compiler", "optimize", "results", "jobs", "memory", "allow_shrink", "diagnostic_coverage", "jetpack"}
// The settings only a corpus suite acts on (TestProfile.jet
// jet_cli_test_profile_corpus): a run with no corpus suite refuses them.
JET_CLI_TEST_CORPUS_SETTINGS: [String]{"jobs", "memory", "allow_shrink", "diagnostic_coverage", "jetpack"}

// The `test: fn` layer of the package at `root`: the settings its
// `t.<setting>(…)` calls write in `jet test`'s plan step, a child
// `jet test <root>` run with TEST_SETTINGS_PLAN_ENV naming a scratch file,
// whose harness calls `test: fn` and exits before any test runs (JetIR
// BuildTests.jet). Empty, with no child, when test.jet makes no such call
// (pkg_test_sets_settings). Err is why the layer can't be read.
jet_cli_test_code_layer: fn(root: String) -[FS, Env, Exec]> [TestSetting] TestSettingError! {
    source: cli_files.read(jet_cli_rooted_join(root, TEST_CODE_SUITES_FILE)) ?? return Ok([TestSetting]{})
    if !pkg_test_sets_settings(source) -> return Ok([TestSetting]{})
    scratch: cli_files.temp_dir("jet-test-plan") ?? return Err(TestSettingError{message: "couldn't create a scratch directory for the plan step: {err}"})
    plan: jet_cli_rooted_join(scratch.path, "settings")
    ran: cli_process.cmd([String]{cli_sys.executable(), "test", root.copy()}).env(TEST_SETTINGS_PLAN_ENV, plan).stdout(.Capture).stderr(.Capture).run() ?? return Err(TestSettingError{message: "couldn't run the plan step `jet test {root}`: {err}"})
    if !ran.success -> return Err(TestSettingError{message: "the plan step that runs test.jet's `test: fn` stopped (exit code {ran.code}):\n{ran.errors.trim_end()}"})
    text: cli_files.read(plan) ?? ""
    test_settings_parse_lines(text, "fn test")
}

// A `test: fn` layer that can't be read, as its refusal.
jet_cli_test_code_refusal: fn(what: String, color: Bool) -> JetCLIPlan Never! {
    jet_cli_fail("E2104", what, jet_cli_why("E2104"), "correct the `t.<setting>(…)` call in test.jet's `test: fn`, or the test it names", color, JET_DRIVER_EXIT_USAGE)
}

// The settings this run inherits from the run that started it
// (TEST_SETTINGS_ENV), none in a run nothing started.
jet_cli_test_inherited_settings: fn() -[Env]> [TestSetting] TestSettingError! {
    lines: cli_sys.get(TEST_SETTINGS_ENV) ?? return Ok([TestSetting]{})
    test_settings_parse_lines(lines, JET_CLI_TEST_FLAG_LAYER)
}

// The layer that wrote row `name`, "" when none did.
jet_cli_test_setting_source: fn(settings: [TestSetting], name: String) -> String Never! {
    loop setting in settings {
        if setting.name == name -> return setting.source.copy()
    }
    ""
}

// The combinations no run can carry out, refused before anything builds:
// `list` runs nothing and a slice blesses only part of the rows, so neither
// takes `update_snapshots`, and `list` has no run to `record`; a corpus-pool
// setting needs a corpus suite (`corpus`: the run has one); `iterations` and
// `seed` steer the generated grade, so each needs `grade`; a `cases` file
// must be readable and a `results` file writable before any test runs.
jet_cli_test_settings_refusal: fn(settings: [TestSetting], corpus: Bool, color: Bool) -[FS]> JetCLIPlan? Never! {
    // Only a native test run is instrumented; a corpus row never is.
    if corpus && test_settings_on(settings, "coverage") -> return Val(jet_cli_not_ported("test <corpus run with --coverage>", color))
    update: test_settings_on(settings, "update_snapshots")
    blessing: "`update_snapshots` ({jet_cli_test_setting_source(settings, "update_snapshots")})"
    if update && test_settings_on(settings, "list") {
        return Val(jet_cli_fail("E2104", "`list` ({jet_cli_test_setting_source(settings, "list")}) and {blessing} don't combine", jet_cli_why("E2104"), "drop one of them: `list` runs no test, so it blesses nothing", color, JET_DRIVER_EXIT_USAGE))
    }
    if test_settings_get(settings, "record") != None && test_settings_on(settings, "list") {
        return Val(jet_cli_fail("E2104", "`list` ({jet_cli_test_setting_source(settings, "list")}) and `record` ({jet_cli_test_setting_source(settings, "record")}) don't combine", jet_cli_why("E2104"), "drop one of them: `list` runs no test, so it records nothing", color, JET_DRIVER_EXIT_USAGE))
    }
    if update && test_settings_shard_count(settings) > 1 {
        shard: test_settings_get(settings, "shard") ?? ""
        return Val(jet_cli_fail("E2104", "`shard` {shard} ({jet_cli_test_setting_source(settings, "shard")}) and {blessing} don't combine", jet_cli_why("E2104"), "run `-u` without `shard`, so every selected row is blessed at once", color, JET_DRIVER_EXIT_USAGE))
    }
    loop setting in settings {
        if corpus || setting.value == "false" || !JET_CLI_TEST_CORPUS_SETTINGS.contains(setting.name) -> next
        return Val(jet_cli_fail("E2104", "`{setting.name}` ({setting.source}) steers the corpus suites, and this run has none", jet_cli_why("E2104"), "drop `{test_setting_flag(setting.name)}`, or run a test profile whose suites include a golden, ui or cases corpus", color, JET_DRIVER_EXIT_USAGE))
    }
    loop name in JET_CLI_TEST_GENERATED_SETTINGS {
        if test_settings_get(settings, "grade") != None || test_settings_get(settings, name) == None -> next
        return Val(jet_cli_fail("E2104", "`{name}` ({jet_cli_test_setting_source(settings, name)}) steers the generated grade, and this run has no `grade`", jet_cli_why("E2104"), "add `--grade=generated`, or drop `{test_setting_flag(name)}`", color, JET_DRIVER_EXIT_USAGE))
    }
    if test_settings_get(settings, "cases") == .Val(list) {
        _: cli_files.read(list) ?? return Val(jet_cli_fail("E2104", "the `cases` file `{list}` ({jet_cli_test_setting_source(settings, "cases")}) can't be read: {err}", jet_cli_why("E2104"), "name a file that lists one test name or corpus row id per line", color, JET_DRIVER_EXIT_USER_ERROR))
    }
    if !test_settings_on(settings, "list") && test_settings_get(settings, "results") == .Val(path) {
        existed: cli_files.exists(path)
        cli_files.write(path, "") ?? return Val(jet_cli_fail("E2104", "the `results` file `{path}` ({jet_cli_test_setting_source(settings, "results")}) can't be written: {err}", jet_cli_why("E2104"), "name a file in a writable directory", color, JET_DRIVER_EXIT_USER_ERROR))
        if !existed -> cli_files.remove(path).drop("the probe only shows the file can be written; the run writes it")
    }
    None
}

// The settings line a run prints when a profile or `test: fn` wrote any of
// them: each setting and the layer it came from. "" otherwise.
jet_cli_test_settings_notice: fn(settings: [TestSetting]) -> String Never! {
    if !settings.any(fn(setting) { setting.source != JET_CLI_TEST_FLAG_LAYER }) -> return ""
    shown: (loop setting in settings -> "{setting.name} {setting.value} ({setting.source})").join(", ")
    "jet test: settings {shown}\n"
}

// Whether `argument` writes a setting the parent keeps (`--optimize=…`,
// `--jobs=4`, `--diagnostic-coverage`, …), so a child's words leave it out.
jet_cli_test_parent_word: fn(argument: String) -> Bool Never! {
    loop name in JET_CLI_TEST_PARENT_SETTINGS {
        flag: test_setting_flag(name)
        if argument == flag || argument.starts_with("{flag}=") -> return true
    }
    false
}

// `jet_argv`'s words for a child `jet test`, without the `--profile` choice
// and the settings the parent keeps; words after `--` stay as written.
jet_cli_test_child_words: fn(jet_argv: [String]) -> [String] Never! {
    words := [String]{"test"}
    index := 1
    loop index < jet_argv.len() {
        argument: jet_argv[index]
        if argument == "--" {
            loop rest in index..<jet_argv.len() -> words.push(jet_argv[rest].copy())
            break
        }
        if argument == "--profile" {
            index += 2
            next
        }
        if !argument.starts_with("--profile=") && !jet_cli_test_parent_word(argument) -> words.push(argument.copy())
        index += 1
    }
    words
}

// The settings a child inherits: all but those the parent keeps.
jet_cli_test_child_settings: fn(settings: [TestSetting]) -> [TestSetting] Never! {
    kept := [TestSetting]{}
    loop setting in settings {
        if !JET_CLI_TEST_PARENT_SETTINGS.contains(setting.name) -> kept.push(setting.copy()) // copy: the decided list stays whole for the parent.
    }
    kept
}

// `jet_argv` as the build options read it: the `--optimize` words, a test
// setting here (several levels run once each), replaced by `level`'s
// `--optimize=<level>` ("" adds none).
jet_cli_test_build_argv: fn(jet_argv: [String], level: String) -> [String] Never! {
    argv := [String]{}
    passthrough := false
    loop argument in jet_argv {
        if argument == "--" && !passthrough {
            passthrough = true
            // Before the `--`, so the build options read it.
            if level != "" -> argv.push("--optimize={level}")
        }
        if !passthrough && (argument == "--optimize" || argument.starts_with("--optimize=")) -> next
        argv.push(argument.copy())
    }
    if !passthrough && level != "" -> argv.push("--optimize={level}")
    argv
}

// `compiler` and more than one `optimize` level run the tests in children
// (Host.jet jet_cli_test_workspace): one per level, each `jet test` of the
// named compiler (else this jet) with the decided settings in
// TEST_SETTINGS_ENV and its level as `--optimize`. The `results` document
// is this run's: every child's rows, each level's at `tests at optimize
// <level>`. None runs the tests in this process.
jet_cli_test_settings_fan_out: fn(jet_argv: [String], settings: [TestSetting], quiet: Bool) -> JetCLIPlan? Never! {
    levels: test_settings_levels(settings)
    compiler: test_settings_get(settings, "compiler") ?? ""
    if compiler == "" && levels.len() < 2 -> return None
    words: jet_cli_test_child_words(jet_argv)
    inherited: test_settings_lines(jet_cli_test_child_settings(settings))
    picked: if levels.len() == 0 -> [String]{""} else -> levels
    names := [String]{}
    tiers := [String]{}
    member_args := [[String]]{}
    envs := [[String]]{}
    loop level in picked {
        args := words.copy() // copy: each level run starts from the same words.
        if level != "" -> args.push("--optimize={level}")
        names.push(if levels.len() > 1 -> "optimize {level}" else -> "compiler {compiler}")
        tiers.push(if levels.len() > 1 -> "{TEST_SUITE_TESTS} at optimize {level}" else -> TEST_SUITE_TESTS)
        member_args.push(args)
        envs.push([String]{TEST_SETTINGS_ENV, inherited.copy()}) // copy: every child gets the same settings.
    }
    // A `list` run runs no test, so it has no verdict to write.
    results: if test_settings_on(settings, "list") -> "" else -> test_settings_get(settings, "results") ?? ""
    Val(JetCLIPlan.TestWorkspace{names: names, member_args: member_args, envs: envs, executable: compiler, heading: "run", results: results, tiers: tiers, quiet: quiet})
}

// Each of `count` children's environment row: its `envs` row (none past
// its end), and with a `scratch` directory the file it hands its evidence
// report to, `<scratch>/<index>.bin`.
jet_cli_test_runs_envs: fn(envs: [[String]], count: Int, scratch: String) -> [[String]] Never! {
    rows := [[String]]{}
    loop index in 0..<count {
        row := if index < envs.len() -> envs[index].copy() else -> [String]{} // copy: each child task owns its environment row.
        if scratch != "" {
            row.push(EVIDENCE_REPORT_ENV)
            row.push(jet_cli_rooted_join(scratch, "{index}.bin"))
        }
        rows.push(row)
    }
    rows
}

// Writes the one `results` document of the runs `names`, whose children
// handed their evidence reports to `scratch` (jet_cli_test_runs_envs): each
// run's rows at its `tiers` entry, `jet` the compiler that ran them. The
// problems, one line each; "" when there are none.
jet_cli_test_runs_results_write: fn(path: String, scratch: String, names: [String], tiers: [String], jet: String) -[FS, Env]> String Never! {
    results := [KitCaseResult]{}
    problems := ""
    loop (index, tier) in tiers {
        report_path: jet_cli_rooted_join(scratch, "{index}.bin")
        // The child stopped before its tests ran; its own stderr says why.
        if !cli_files.exists(report_path) {
            problems = "{problems}jet test: run `{names[index]}`: no test ran, so `results` holds none of its rows\n"
            next
        }
        report: evidence_report_read(report_path) ?? {
            problems = "{problems}jet test: run `{names[index]}`: couldn't read its test evidence: {err.message}\n"
            next
        }
        loop result in jet_cli_test_record_results(report.records, TEST_SUITE_TESTS, tier) -> results.push(result)
    }
    if jet_cli_test_results_write(path, results, [String]{TEST_SUITE_TESTS}, jet) == .Val(problem) -> problems = "{problems}jet test: {problem}\n"
    problems
}

// Hands on the evidence of the runs `names`, whose children handed their
// reports to `scratch` (jet_cli_test_runs_envs), as one report at `path`:
// every child's records, for the parent that named `path` (a profile's
// `tests` run, `jet prove`). A child that wrote none adds none. The problems,
// one line each; "" when there are none.
jet_cli_test_runs_report_write: fn(path: String, scratch: String, names: [String]) -[FS, Env]> String Never! {
    records := [EvidenceRecord]{}
    derivations := [DerivationRecord]{}
    problems := ""
    loop (index, name) in names {
        report_path: jet_cli_rooted_join(scratch, "{index}.bin")
        // The child stopped before its tests ran; its own stderr says why.
        if !cli_files.exists(report_path) {
            problems = "{problems}jet test: run `{name}`: no test ran, so the handed-on evidence holds none of its records\n"
            next
        }
        report: evidence_report_read(report_path) ?? {
            problems = "{problems}jet test: run `{name}`: couldn't read its test evidence: {err.message}\n"
            next
        }
        loop record in report.records -> records.push(record.copy()) // copy: each child's report keeps its own.
        loop derivation in report.derivations -> derivations.push(derivation.copy())
    }
    if records.len() == 0 -> return problems
    report_id: records[0].identity.report_id.copy()
    merged: evidence_report_try_from_records(report_id, records, derivations) ?? return "{problems}jet test: couldn't merge the runs' test evidence: {evidence_merge_error_text(err)}\n"
    evidence_report_write(merged, path) ?? return "{problems}jet test: couldn't hand on the runs' test evidence: {err.message}\n"
    problems
}

// Carries the decided settings out on `options`: what the harness reads,
// and the settings themselves for the rest of the run (Host.jet
// jet_cli_test_result). Measured samples never share the machine with
// another claim, so `measure` runs serially.
jet_cli_test_settings_apply: fn(options: &JetCLITestOptions, settings: [TestSetting]) Never! {
    options.docs = test_settings_on(settings, "docs")
    options.filter = test_settings_get(settings, "filter")
    options.capture = test_settings_get(settings, "capture") ?? "failed"
    options.update_snapshots = test_settings_on(settings, "update_snapshots")
    options.shuffle_seed = test_settings_get(settings, "shuffle")
    options.measure = test_settings_on(settings, "measure")
    options.serial = test_settings_on(settings, "serial") || options.measure
    options.trace_tiers = test_settings_on(settings, "trace_tiers")
    options.settings = settings.copy() // copy: the caller's decided list stays its own.
}

// The settings that steer the generated grade alone.
JET_CLI_TEST_GENERATED_SETTINGS: [String]{"iterations", "seed"}

// The case budget of each property test under the generated grade: the
// `iterations` setting, 1000 when unset; None when the run has no `grade`
// (each property then keeps its default budget).
jet_cli_test_generated_iterations: fn(settings: [TestSetting]) -> String? Never! {
    if test_settings_get(settings, "grade") == None -> return None
    Val(test_settings_get(settings, "iterations") ?? "1000")
}

// The base seed of every property test under the generated grade: the
// `seed` setting, else JET_PROP_SEED when `inherited` (the caller's
// environment names one, so None keeps it), else the fixed 0; None when the
// run has no `grade` (each property then seeds itself).
jet_cli_test_generated_seed: fn(settings: [TestSetting], inherited: Bool) -> String? Never! {
    if test_settings_get(settings, "grade") == None -> return None
    if test_settings_get(settings, "seed") == .Val(seed) -> return Val(seed)
    if inherited -> return None
    Val("0")
}

// The verdict row of one claim outcome: PASS or FAIL, KNOWN-FAILING and
// UNEXPECTED-PASS for an expected failure, UNSUPPORTED for a claim that
// didn't run and ERROR for one that couldn't (jet_testkit's statuses).
jet_cli_test_record_status: fn(outcome: EvidenceOutcome, expected: Bool) -> String Never! {
    if outcome == {
        .Passed | .Proved | .Checked | .Generated -> if expected -> "UNEXPECTED-PASS" else -> "PASS"
        .Failed -> if expected -> "KNOWN-FAILING" else -> "FAIL"
        .Skipped | .NotObserved | .Unchecked -> "UNSUPPORTED"
        .Unavailable | .Incomplete | .Error -> "ERROR"
    }
}

// A run's evidence records as `results` rows of `suite`, each claim's row at
// `tier` (the run that made it).
jet_cli_test_record_results: fn(records: [EvidenceRecord], suite: String, tier: String) -> [KitCaseResult] Never! {
    results := [KitCaseResult]{}
    loop record in records {
        status: jet_cli_test_record_status(record.outcome, record.expectation == EvidenceExpectation.ExpectedFailure)
        // copy: the rows outlive the records and the caller's names.
        results.push(KitCaseResult{suite: suite.copy(), case: record.identity.claim_id.copy(), tier: tier.copy(), status: status, detail: record.detail.replace("\n", " "), exit: 0})
    }
    results
}

// Writes the one `results` document (jet_testkit kit_report_document) of
// `results`, whose rows come from `suites` and were made by the compiler
// `jet`; the problem when it can't.
jet_cli_test_results_write: fn(path: String, results: [KitCaseResult], suites: [String], jet: String) -[FS]> String? Never! {
    document: kit_report_document(jet, results, suites) ?? return Val("couldn't encode the `results` document: {err}")
    cli_files.write(path, document) ?? return Val("couldn't write the `results` file `{path}`: {err}")
    None
}

#Test("child words drop the profile choice and the settings the parent keeps") {
    argv: [String]{"test", "pkg", "--profile", "ui", "--optimize=none,full", "--shard=2/4", "--compiler=base/jet", "--results=r.json", "--jobs=4", "--diagnostic-coverage", "--", "--optimize=x"}
    assert_eq(jet_cli_test_child_words(argv), [String]{"test", "pkg", "--shard=2/4", "--", "--optimize=x"})
    assert_eq(jet_cli_test_build_argv(argv, "full"), [String]{"test", "pkg", "--profile", "ui", "--shard=2/4", "--compiler=base/jet", "--results=r.json", "--jobs=4", "--diagnostic-coverage", "--optimize=full", "--", "--optimize=x"})
}

#Test("a run of several levels writes one results document and hands each child a report file") {
    settings: [TestSetting]{TestSetting{name: "optimize", value: "none,full", source: "flag"}, TestSetting{name: "results", value: "r.json", source: "flag"}, TestSetting{name: "jobs", value: "4", source: "flag"}}
    plan: jet_cli_test_settings_fan_out([String]{"test", "pkg", "--optimize=none,full", "--results=r.json"}, settings, true) ?? panic("two levels fan out")
    if plan == {
        .TestWorkspace(names, member_args, envs, executable, heading, results, tiers, quiet) -> {
            assert_eq(names, [String]{"optimize none", "optimize full"})
            assert_eq(member_args[1], [String]{"test", "pkg", "--optimize=full"})
            assert_eq(results, "r.json")
            assert_eq(tiers, [String]{"tests at optimize none", "tests at optimize full"})
            assert(executable == "" && heading == "run" && quiet)
            // The children inherit neither `results` nor the corpus-pool settings.
            assert_eq(envs[0], [String]{TEST_SETTINGS_ENV, ""})
            assert_eq(jet_cli_test_runs_envs(envs, 2, "/s")[1], [String]{TEST_SETTINGS_ENV, "", EVIDENCE_REPORT_ENV, "/s/1.bin"})
        }
        .Done(_) | .Refused(_, _, _, _) | .Diagnostics(_, _, _, _, _) | .Check(_, _, _, _, _, _, _, _, _, _, _, _, _) | .CheckWorkspace(_, _, _, _, _, _, _, _, _, _) | .CheckPrelude(_, _, _, _, _, _) | .CheckCore(_, _, _, _, _) | .Build(_, _, _, _, _, _, _, _, _, _, _) | .LockedBuild(_, _) | .BuildPackage(_, _, _, _, _, _, _, _) | .Run(_, _, _, _, _, _, _, _, _, _, _, _) | .RunRemote(_, _, _, _, _, _, _, _) | .NativeSource(_, _, _, _, _) | .DevWeb(_, _, _, _, _, _, _, _) | .DevCanvas(_, _, _, _, _, _) | .Jobs(_, _, _, _) | .Test(_, _, _, _, _, _) | .TestProfile(_, _, _, _, _, _) | .New(_, _, _, _, _, _) | .Doc(_, _, _, _, _) | .Emit(_, _, _, _, _, _) | .Eval(_, _, _, _, _) | .Fill(_, _, _) | .Structural(_, _, _) | .Review(_, _, _) | .Keygen(_, _, _) | .KeyBackup(_, _, _) | .Publish(_, _, _, _) | .Yank(_, _, _) | .Lint(_, _, _, _, _, _, _) | .Fmt(_) | .FmtLang(_, _) | .Fix(_, _, _, _, _, _, _, _, _) | .Inspect(_) | .InspectB(_) | .ForeignBind(_, _, _) | .Perf(_, _) | .Semindex(_, _, _) | .Find(_, _, _, _) | .Cache(_, _) | .Remote(_, _, _) | .Comparison(_, _, _) | .Try(_, _, _) | .Maintenance(_, _, _, _) | .Completion(_, _, _) | .Schema(_, _, _, _, _) | .Codemod(_, _, _, _, _) | .PolicyExplain(_, _, _, _, _, _) | .DiagnosticTypeExplain(_, _, _, _) | .BuildFactExplain(_, _, _, _, _, _, _) | .Gates(_, _, _, _, _) | .Output(_, _, _, _) | .Doctor(_, _, _, _) | .UpdateJet(_, _, _, _, _) | .AuditCopies(_, _, _, _, _) | .AuditForeign(_, _, _, _, _) | .CompilerService(_) | .Repl(_, _, _, _) | .LSP | .ReplChild(_) | .EvalExpression(_, _, _) | .Prove(_, _, _, _, _, _) | .Budget(_, _, _, _) | .AuditWrites(_, _, _, _, _) -> panic("a fan-out is a TestWorkspace plan")
    }
}

#Test("the settings notice shows only runs a profile or fn test wrote") {
    flags: [TestSetting]{TestSetting{name: "list", value: "true", source: "flag"}}
    assert_eq(jet_cli_test_settings_notice(flags), "")
    mixed: [TestSetting]{TestSetting{name: "shard", value: "3/8", source: "fn test"}, TestSetting{name: "list", value: "true", source: "flag"}}
    assert_eq(jet_cli_test_settings_notice(mixed), "jet test: settings shard 3/8 (fn test), list true (flag)\n")
    assert_eq(jet_cli_test_child_settings([TestSetting]{TestSetting{name: "compiler", value: "j", source: "flag"}, TestSetting{name: "shard", value: "1/2", source: "flag"}}).len(), 1)
}
