// Compiler-private port of crates/jet-cli/src/OutputProfile.rs.
// Text facts are owned, valid UTF-8 octets supplied by the caller, not a
// String view or a terminal/environment probe. The process boundary owns
// their real projection. Width is the canonical x64 usize domain (U64).
use jet_foundation.[foundation_read_bytes_scalar_at]

pub enum JetCLIColorRequest {
    Auto
    Always
    Never
}
pub struct JetCLIOutputFacts {
    pub tty: Bool
    pub term: [U8]?
    pub no_color: Bool
    pub force_color: Bool
    pub requested_color: JetCLIColorRequest
    pub json: Bool
    pub width: U64?
    pub unicode: Bool
}
pub enum JetCLIOutputChannel {
    HumanStdout
    HumanStderr
    MachineStdout
    Hidden
}
pub enum JetCLIOutputKind {
    Renderable
    Status
    Log
    Progress
    Machine
}
#Error
pub enum JetCLIOutputProfileError {
    InvalidColorRequest(value: [U8])
    InvalidTerm(value: [U8])
    InvalidWidth(value: U64)
}
pub struct JetCLIOutputProfile {
    pub width: U64
    pub ansi_enabled: Bool
    pub unicode_enabled: Bool
    pub progress_enabled: Bool
    pub human_enabled: Bool
    pub machine_enabled: Bool
}

JET_CLI_COLOR_AUTO_BYTES :: prep { [U8]{97, 117, 116, 111} }
JET_CLI_COLOR_ALWAYS_BYTES :: prep { [U8]{97, 108, 119, 97, 121, 115} }
JET_CLI_COLOR_NEVER_BYTES :: prep { [U8]{110, 101, 118, 101, 114} }
JET_CLI_TERM_DUMB_BYTES :: prep { [U8]{100, 117, 109, 98} }

pub fn jet_cli_color_request(value: [U8]) -> JetCLIColorRequest JetCLIOutputProfileError! {
    if value == JET_CLI_COLOR_AUTO_BYTES -> return Ok(.Auto)
    if value == JET_CLI_COLOR_ALWAYS_BYTES -> return Ok(.Always)
    if value == JET_CLI_COLOR_NEVER_BYTES -> return Ok(.Never)
    Err(.InvalidColorRequest(~value))
}

// Rust char::is_control is Cc, not the diagnostic terminal-escape policy:
// U+2028 and U+2029 are not controls here. No scalar String/list is created.
fn jet_cli_output_term_control(term: [U8]) -> Bool Never! {
    index := 0
    loop index < term.len() {
        scalar :: foundation_read_bytes_scalar_at(term, index)
        code :: scalar.codepoint
        if code < 32 || (code >= 127 && code <= 159) -> return true
        index = scalar.next_byte
    }
    false
}

pub fn jet_cli_output_profile(facts: JetCLIOutputFacts) -> JetCLIOutputProfile JetCLIOutputProfileError! {
    dumb := false
    if facts.term == .Val(term) {
        if term.len() == 0 || jet_cli_output_term_control(term) -> return Err(.InvalidTerm(~term))
        dumb = term == JET_CLI_TERM_DUMB_BYTES
    }
    width :: facts.width ?? U64{80}
    if width == U64{0} -> return Err(.InvalidWidth(width))
    human :: !facts.json
    ansi :: if facts.requested_color == {
        .Always -> true
        .Never -> false
        .Auto -> if facts.no_color -> false else if facts.force_color -> true else -> facts.tty
    }
    Ok(JetCLIOutputProfile{
        width: width,
        ansi_enabled: human && ansi,
        unicode_enabled: human && facts.tty && facts.unicode && !dumb,
        progress_enabled: human && facts.tty && !dumb,
        human_enabled: human,
        machine_enabled: facts.json,
    })
}

pub fn jet_cli_output_channel(profile: JetCLIOutputProfile, kind: JetCLIOutputKind) -> JetCLIOutputChannel Never! {
    if profile.machine_enabled {
        if kind == .Machine -> return .MachineStdout
        return .Hidden
    }
    if kind == {
        .Renderable -> .HumanStdout
        .Status | .Log | .Progress -> .HumanStderr
        .Machine -> .Hidden
    }
}
