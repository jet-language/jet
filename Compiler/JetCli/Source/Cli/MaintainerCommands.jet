// Reduce and ice-report. Compilation and diagnostics stay with the driver;
// these leaves own only command policy, line minimization, and sequential file
// publication.
use {
    cli_files: core.files
    cli_process: core.process
    cli_sys: core.sys
    cli_term: core.term
    cli_time: core.time
    jet_driver.[JetDriverCompileMode, JetDriverVerbOutput, JET_DRIVER_EXIT_OK, JET_DRIVER_EXIT_USAGE, JET_DRIVER_EXIT_USER_ERROR, jet_driver_present_diagnostics]
    jet_foundation.[diagnostic_render_all]
}

jet_cli_maintainer_error: fn(code: String, what: String, why: String?, fix: String?, color: Bool, json: Bool, status: Int) -> JetDriverVerbOutput Never! {
    diagnostic_copy: jet_cli_diagnostic_copy(code)
    reason: why ?? diagnostic_copy.why
    repair: fix ?? diagnostic_copy.fix
    JetDriverVerbOutput{stdout: if json -> jet_cli_fail_json(code, what, reason, repair) else -> "", stderr: if json -> "" else -> jet_cli_report(code, what, reason, repair, color), exit_code: status}
}

// Path::file_stem/extension for a file the Unix host has successfully read.
// Backslash is a filename byte, not a separator; a dotfile has no extension.
// The indexes are byte offsets, so the parts are cut from the bytes
// (`String.slice` counts characters).
jet_cli_maintainer_bytes: fn(text: String, start: Int, end: Int) -> String Never! {
    bytes: text.bytes()
    String.from_bytes(bytes[start..<end]) ?? panic("a path cut at an ASCII byte is UTF-8")
}
jet_cli_maintainer_name: fn(file: String) -> String Never! {
    bytes: file.bytes()
    index := bytes.len() - 1
    loop index >= 0 {
        if bytes[index] == 47 -> return jet_cli_maintainer_bytes(file, index + 1, bytes.len())
        index -= 1
    }
    // copy: `file` stays with the caller (`file` is a read parameter: no move out of it, E0201) and
    // the returned value owns its own.
    file.copy()
}
jet_cli_maintainer_dot: fn(name: String) -> Int? Never! {
    bytes: name.bytes()
    index := bytes.len() - 1
    loop index > 0 {
        if bytes[index] == 46 -> return Val(index)
        index -= 1
    }
    None
}
jet_cli_maintainer_stem: fn(file: String) -> String Never! {
    name: jet_cli_maintainer_name(file)
    if jet_cli_maintainer_dot(name) == .Val(dot) -> return jet_cli_maintainer_bytes(name, 0, dot)
    name
}
jet_cli_reduced_path: fn(file: String) -> String Never! {
    name: jet_cli_maintainer_name(file)
    dot: jet_cli_maintainer_dot(name)
    stem: if dot == .Val(index) -> jet_cli_maintainer_bytes(name, 0, index) else -> name
    extension: if dot == .Val(index) -> jet_cli_maintainer_bytes(name, index + 1, name.bytes().len()) else -> "jet"
    replacement: "{stem}.reduced.{extension}"
    parent: jet_cli_parent(file) ?? return replacement
    jet_cli_authority_path(parent, replacement)
}

// The reducer's oracle: the reduced source still reports diagnostic `code`.
jet_cli_reduce_oracle: fn(scratch: String, source: String, code: String) -> Bool {
    cli_files.write(scratch, source) ?? return false
    if jet_cli_compile_file(scratch, false, None, JetDriverCompileMode.Program) == {
        .Refused(_) -> return false
        .Compiled(result, _) -> {
            loop diagnostic in result.diagnostics {
                if diagnostic.code == code -> return true
            }
            return false
        }
    }
    false
}

jet_cli_reduce_candidate: fn(lines: &[String], start: Int, end: Int) -> [String] Never! {
    // Build only the retained lines; do not clone and drain the whole input.
    candidate := [String]{}
    loop (index, line) in lines {
        if index < start || index >= end -> candidate.push(line.copy())
    }
    candidate
}
// The reducer owns its line buffer; candidates borrow it until accepted.
jet_cli_reduce_lines: fn(lines: &&[String], scratch: String, code: String) -> [String] {
    current := lines.move()
    chunks := 2
    loop current.len() >= 2 {
        size: (current.len() + chunks - 1) /% chunks
        if size == 0 -> break
        progress := false
        start := 0
        loop start < current.len() {
            end: if start + size < current.len() -> start + size else -> current.len()
            candidate: jet_cli_reduce_candidate(current, start, end)
            if candidate.len() > 0 && jet_cli_reduce_oracle(scratch, candidate.join("\n"), code) {
                cli_term.print("reduce: dropped lines {start + 1}..{end} -> {candidate.len()} line(s) left")
                current = candidate.move()
                chunks = if chunks > 2 -> chunks - 1 else -> 2
                progress = true
                break
            }
            start = end
        }
        if !progress {
            if chunks >= current.len() -> break
            chunks = if chunks * 2 < current.len() -> chunks * 2 else -> current.len()
        }
    }
    current
}

jet_cli_devtools_reduce: fn(args: [String], color: Bool, json: Bool) -> JetDriverVerbOutput {
    usage: "usage: jet devtools reduce <file.jet> --code EXXXX\n"
    if args.len() == 0 -> return JetDriverVerbOutput{stdout: "", stderr: usage, exit_code: JET_DRIVER_EXIT_USAGE}
    file: args[0]
    code := String?{None}
    index := 1
    loop index < args.len() {
        if args[index] != "--code" -> return jet_cli_maintainer_error("E2102", "unknown `reduce` flag `{args[index]}`", None, None, color, json, JET_DRIVER_EXIT_USAGE)
        code = if index + 1 < args.len() -> Val(args[index + 1]) else -> None
        index += 2
    }
    wanted: code ?? return JetDriverVerbOutput{stdout: "", stderr: usage, exit_code: JET_DRIVER_EXIT_USAGE}
    source: cli_files.read(file) ?? return jet_cli_maintainer_error("E2105", "couldn't read `{file}`: {jet_cli_io_error_text(err)}", None, None, color, json, JET_DRIVER_EXIT_USER_ERROR)
    name: jet_cli_maintainer_name(file)
    extension: if jet_cli_maintainer_dot(name) == .Val(dot) -> name.slice(dot + 1..<name.len()) else -> "jet"
    scratch: jet_cli_authority_path(cli_sys.temp_dir(), "jet_devtools_reduce_{cli_process.current_pid()}.{extension}")
    if !jet_cli_reduce_oracle(scratch, source, wanted) {
        return jet_cli_maintainer_error("E2104", "`{file}` doesn't reproduce the target oracle as given", Val("the front end never emits `{wanted}` for this file"), Val("confirm the case fails the way you expect, then reduce it"), color, json, JET_DRIVER_EXIT_USER_ERROR)
    }
    lines: source.lines()
    cli_term.print("reduce: starting at {lines.len()} line(s)")
    reduced: jet_cli_reduce_lines(lines, scratch, wanted)
    cli_term.print("reduce: finished at {reduced.len()} line(s)")
    text: reduced.join("\n")
    output: jet_cli_reduced_path(file)
    cli_files.write(output, if text == "" -> "" else -> "{text}\n") ?? return jet_cli_maintainer_error("E2105", "couldn't write `{output}`: {jet_cli_io_error_text(err)}", None, None, color, json, JET_DRIVER_EXIT_USER_ERROR)
    cli_files.remove(scratch).drop("the reference ignores successful reducer cleanup failures")
    JetDriverVerbOutput{stdout: "wrote {output}\n", stderr: "", exit_code: JET_DRIVER_EXIT_OK}
}

// `jet devtools ice-report <file.jet>`: bundle a case the compiler accepts but
// cannot finish (an internal compiler error) with the compiler version.
jet_cli_devtools_ice_report: fn(args: [String], color: Bool, json: Bool) -> JetDriverVerbOutput {
    if args.len() == 0 -> return JetDriverVerbOutput{stdout: "", stderr: "usage: jet devtools ice-report <file.jet>\n", exit_code: JET_DRIVER_EXIT_USAGE}
    file: args[0]
    source: cli_files.read(file) ?? return jet_cli_maintainer_error("E2105", "couldn't read `{file}`: {jet_cli_io_error_text(err)}", None, None, color, json, JET_DRIVER_EXIT_USER_ERROR)
    root := ""
    if jet_cli_compile_file(file, false, None, JetDriverCompileMode.Program) == {
        .Refused(output) -> return output
        .Compiled(result, snapshot) -> {
            errors: jet_cli_errors(jet_driver_present_diagnostics(result.diagnostics, snapshot, result.generated_source_files))
            if errors.len() > 0 {
                output := jet_cli_maintainer_error("E2105", "`{file}` doesn't reach codegen — the front end already rejects it", Val("ice-report bundles a case the front end accepts"), Val("fix the front-end errors first, or use `jet devtools reduce --code <CODE>` to shrink a front-end diagnostic instead"), color, json, JET_DRIVER_EXIT_USER_ERROR)
                output.stderr = "{output.stderr}{diagnostic_render_all(file, source, errors, color)}"
                return output
            }
            root = snapshot.roots[0].canonical_path
        }
    }
    stamp: cli_time.unix_ns() / 1000000000
    bundle: "{root}/.jet/ice-report/{jet_cli_maintainer_stem(file)}-{stamp}"
    cli_files.create_dir_all(bundle) ?? return jet_cli_maintainer_error("E2105", "couldn't create `{bundle}`: {jet_cli_io_error_text(err)}", None, None, color, json, JET_DRIVER_EXIT_USER_ERROR)
    names: [String]{"source.jet", "versions.txt"}
    contents: [String]{source, "jet {JET_CLI_VERSION}\n"}
    loop index in 0..<names.len() {
        name: names[index]
        cli_files.write("{bundle}/{name}", contents[index]) ?? return jet_cli_maintainer_error("E2105", "couldn't write `{name}`: {jet_cli_io_error_text(err)}", None, None, color, json, JET_DRIVER_EXIT_USER_ERROR)
    }
    JetDriverVerbOutput{stdout: "wrote ICE report bundle to {bundle}\n", stderr: "", exit_code: JET_DRIVER_EXIT_OK}
}

