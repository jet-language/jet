// Lookups and renders over the one command table (Commands.jet): the usage
// page, the greeting, per-command and per-group help, command usage shapes,
// command-scoped flags, retired spellings, and "did you mean" suggestions.
// Each render returns the exact bytes the Rust host prints for the same
// request (crates/jet-cli/src/CLI.rs, Source/main.rs), so both front doors
// mean one thing (I9).

// jet-foundation Syntax `BINARY_NAME` and `LANG_NAME`; the `jet` package version.
pub JET_CLI_BINARY :: prep { BINARY_NAME }
pub JET_CLI_LANG_NAME :: "Jet"
pub JET_CLI_VERSION :: "0.0.1"

// The flags every command accepts (CLI.rs `flags_for_command`).
JET_CLI_GLOBAL_FLAGS :: [String]{"--json", "--quiet", "--color"}

// One nested action: `JET_CLI_COMMANDS[group].actions[action]`.
pub struct JetCLIActionRef {
    pub group: Int
    pub action: Int
}

// Rust `RetirementCategory` (CLI.rs:1718-1722).
pub enum JetCLIRetirementCategory {
    Rename
    Semantic
}

// The literal forms of Rust's fix callbacks: function values cannot cross `prep`.
pub enum JetCLIRetiredFix {
    Fixed(String)
    Serve
    Lock(Int)
}

// Rust `RetiredCommandSpec` (CLI.rs:1724-1731).
// Semantic rows teach a hard error; the optional rewrite is only for renames.
pub struct JetCLIRetiredSpec {
    pub spelling: String
    pub category: JetCLIRetirementCategory
    pub error_code: String
    pub why: String
    pub fix: JetCLIRetiredFix
    pub rewrite: [String]?
}


// Rust `RETIRED_COMMANDS` (CLI.rs:1808-1937), in registry order.
pub JET_CLI_RETIRED :: prep { [JetCLIRetiredSpec]{
    // Rust `retired_facts_fix` (CLI.rs:1783-1785).
    JetCLIRetiredSpec{spelling: "facts", category: JetCLIRetirementCategory.Semantic, error_code: "E2101", why: "the typed facts ledger is now the `inspect types` plane (D-CLI-ONE1=A)", fix: JetCLIRetiredFix.Fixed("jet inspect types"), rewrite: None},
    // Rust `retired_authority_fix` (CLI.rs:1787-1789).
    JetCLIRetiredSpec{spelling: "authority", category: JetCLIRetirementCategory.Semantic, error_code: "E2101", why: "authority inspection is the `inspect rights` plane (D-CLI-ONE1=A)", fix: JetCLIRetiredFix.Fixed("jet inspect rights"), rewrite: None},
    // Rust `retired_unsafe_fix` (CLI.rs:1791-1793).
    JetCLIRetiredSpec{spelling: "unsafe", category: JetCLIRetirementCategory.Semantic, error_code: "E2101", why: "unsafe inspection is the `inspect gates` plane (D-CLI-ONE1=A)", fix: JetCLIRetiredFix.Fixed("jet inspect gates"), rewrite: None},
    // Rust `retired_guarantees_fix` (CLI.rs:1795-1797).
    JetCLIRetiredSpec{spelling: "guarantees", category: JetCLIRetirementCategory.Semantic, error_code: "E2101", why: "guarantees inspection is the `inspect rights` plane (D-CLI-ONE1=A)", fix: JetCLIRetiredFix.Fixed("jet inspect rights"), rewrite: None},
    // Rust `retired_report_fix` (CLI.rs:1799-1801).
    JetCLIRetiredSpec{spelling: "report", category: JetCLIRetirementCategory.Semantic, error_code: "E2101", why: "build inspection is the `inspect build` plane (D-CLI-ONE1=A)", fix: JetCLIRetiredFix.Fixed("jet inspect build"), rewrite: None},
    // Rust `retired_dossier_fix` (CLI.rs:1803-1805).
    JetCLIRetiredSpec{spelling: "dossier", category: JetCLIRetirementCategory.Semantic, error_code: "E2101", why: "build inspection is the `inspect build` plane (D-CLI-ONE1=A)", fix: JetCLIRetiredFix.Fixed("jet inspect build"), rewrite: None},
    // Rust `retired_bench_fix` (CLI.rs:1748-1750).
    JetCLIRetiredSpec{spelling: "bench", category: JetCLIRetirementCategory.Semantic, error_code: "E2101", why: "measurement is a mode of the test harness now (D-CLAIM-BENCH1=A)", fix: JetCLIRetiredFix.Fixed("jet test --measure"), rewrite: None},
    JetCLIRetiredSpec{spelling: "serve", category: JetCLIRetirementCategory.Semantic, error_code: "E2101", why: "`jet dev` is the only dev loop now; `--swap` forces its hot-swap path (D-CLI-DEVSERVE1=A)", fix: JetCLIRetiredFix.Serve, rewrite: None},
    // Rust `retired_store_fix` (CLI.rs:1752-1754).
    JetCLIRetiredSpec{spelling: "store", category: JetCLIRetirementCategory.Semantic, error_code: "E2101", why: "the store group is owned by Jetpack; project commands stay with Jet (D-VERDICT-2188-1)", fix: JetCLIRetiredFix.Fixed("jetpack hangar / jet clean / jet fetch"), rewrite: None},
    // Rust `retired_store_fetch_fix` (CLI.rs:1756-1758).
    JetCLIRetiredSpec{spelling: "store fetch", category: JetCLIRetirementCategory.Semantic, error_code: "E2101", why: "dependency fetching is the flat `jet fetch` command (D-CLI-STORE2=A)", fix: JetCLIRetiredFix.Fixed("jet fetch"), rewrite: None},
    // Rust `retired_store_verify_fix` (CLI.rs:1760-1762).
    JetCLIRetiredSpec{spelling: "store verify", category: JetCLIRetirementCategory.Semantic, error_code: "E2101", why: "package-store integrity checks belong to Jetpack's Hangar (D-VERDICT-2188-1)", fix: JetCLIRetiredFix.Fixed("jetpack hangar verify"), rewrite: None},
    // Rust `retired_store_generations_fix` (CLI.rs:1764-1766).
    JetCLIRetiredSpec{spelling: "store generations", category: JetCLIRetirementCategory.Semantic, error_code: "E2101", why: "package-store generations belong to Jetpack's Hangar (D-VERDICT-2188-1)", fix: JetCLIRetiredFix.Fixed("jetpack hangar"), rewrite: None},
    // Rust `retired_store_rollback_fix` (CLI.rs:1768-1770).
    JetCLIRetiredSpec{spelling: "store rollback", category: JetCLIRetirementCategory.Semantic, error_code: "E2101", why: "package-store rollback belongs to Jetpack's Hangar (D-VERDICT-2188-1)", fix: JetCLIRetiredFix.Fixed("jetpack hangar"), rewrite: None},
    // Rust `retired_store_gc_fix` (CLI.rs:1772-1774).
    JetCLIRetiredSpec{spelling: "store gc", category: JetCLIRetirementCategory.Semantic, error_code: "E2101", why: "package-store cleanup is the sole `jet clean` intent (D-CLI-STORE2=A)", fix: JetCLIRetiredFix.Fixed("jet clean"), rewrite: None},
    JetCLIRetiredSpec{spelling: "store lock", category: JetCLIRetirementCategory.Semantic, error_code: "E2101", why: "script locking is a `jet fetch` flag, not a separate command (D-CLI-STORE2=A)", fix: JetCLIRetiredFix.Lock(2), rewrite: None},
    JetCLIRetiredSpec{spelling: "lock", category: JetCLIRetirementCategory.Semantic, error_code: "E2101", why: "script locking is a `jet fetch` flag, not a separate command (D-CLI-STORE2=A)", fix: JetCLIRetiredFix.Lock(1), rewrite: None},
} }

// `text` left-aligned in `width` characters (Rust `{:<width}`).
pub fn jet_cli_pad(text: String, width: Int) -> String Never! {
    padding :: width - text.len()
    if padding <= 0 -> return ~text
    "{text}{" ".repeat(padding)}"
}

pub fn jet_cli_command_index(name: String) -> Int? Never! {
    loop (index, command) in JET_CLI_COMMANDS {
        if command.name == name -> return Val(index)
    }
    None
}

// A group is a command row with nested actions.
pub fn jet_cli_group_index(name: String) -> Int? Never! {
    index :: jet_cli_command_index(name) ?? return None
    if JET_CLI_COMMANDS[index].actions.len() == 0 -> return None
    Val(index)
}

pub fn jet_cli_handler_index(key: String) -> Int? Never! {
    loop (index, handler) in JET_CLI_HANDLERS {
        if handler.key == key -> return Val(index)
    }
    None
}

pub fn jet_cli_nested_command(group: String, action: String) -> JetCLIActionRef? Never! {
    group_index :: jet_cli_group_index(group) ?? return None
    loop (index, spec) in JET_CLI_COMMANDS[group_index].actions {
        if spec.name == action -> return Val(JetCLIActionRef{group: group_index, action: index})
    }
    None
}

// A bare nested-action word typed as a top-level command (`jet publish`).
// Group names, top-level commands, and actions that are also canonical at the
// top level win the bare word; E0043 keeps bare `install` for its own teaching.
pub fn jet_cli_moved_command(name: String) -> JetCLIActionRef? Never! {
    if jet_cli_command_index(name) != None -> return None
    loop command in JET_CLI_COMMANDS {
        loop action in command.actions {
            if action.name == name && action.also_canonical_top_level -> return None
        }
    }
    loop (group_index, command) in JET_CLI_COMMANDS {
        loop (action_index, action) in command.actions {
            if action.name == name {
                if action.also_canonical_top_level || action.name == "install" -> return None
                return Val(JetCLIActionRef{group: group_index, action: action_index})
            }
        }
    }
    None
}

// Rust `retired_command` prefix filter/key (CLI.rs:1943-1949).
// Registry spellings use single spaces; count while matching, without a word list.
fn jet_cli_retired_match_length(spelling: String, argv: [String]) -> Int? Never! {
    count := 0
    loop word in spelling.split(" ") {
        if count >= argv.len() || argv[count] != word -> return None
        count += 1
    }
    Val(count)
}

// Rust `retired_command` (CLI.rs:1940-1950). Last equal-length match wins.
pub fn jet_cli_retired_command(argv: [String]) -> Int? Never! {
    best := -1
    best_words := 0
    loop (index, retired) in JET_CLI_RETIRED {
        words :: jet_cli_retired_match_length(retired.spelling, argv) ?? next
        if words >= best_words {
            best = index
            best_words = words
        }
    }
    if best < 0 -> return None
    Val(best)
}

// Invoke the fix stored in the row; no second spelling switch.
pub fn jet_cli_retired_fix(retired: JetCLIRetiredSpec, argv: [String]) -> String Never! {
    if retired.fix == {
        .Fixed(text) -> ~text
        // Rust `retired_serve_fix` (CLI.rs:1734-1739).
        .Serve -> {
            if argv.len() > 1 -> return "jet dev {argv[1]} --swap"
            "jet dev <file.jet> --swap"
        }
        // Rust `retired_lock_fix` and `retired_store_lock_fix` (CLI.rs:1741-1746,1776-1781).
        .Lock(index) -> {
            if argv.len() > index -> return "jet fetch --lock {argv[index]}"
            "jet fetch --lock <script.jet>"
        }
    }
}

// E2101 for a retired route, or None when `argv` names no retired spelling.
pub fn jet_cli_retired_report(argv: [String], color: Bool) -> String? Never! {
    index :: jet_cli_retired_command(argv) ?? return None
    retired :: JET_CLI_RETIRED[index]
    Val(jet_cli_report(
        retired.error_code,
        "`{retired.spelling}` isn't a jet command",
        retired.why,
        "run `{jet_cli_retired_fix(retired, argv)}`",
        color,
    ))
}

// Rust `is_retired_root` (CLI.rs:1952-1957); every row uses single spaces.
pub fn jet_cli_is_retired_root(name: String) -> Bool Never! {
    loop retired in JET_CLI_RETIRED {
        if !retired.spelling.contains(" ") && retired.spelling == name -> return true
    }
    false
}

// Canonical top-level spellings: never a moved action, a retired root, or
// the E0043 teaching-only `install`.
// Rust `is_canonical_top_level` (CLI.rs:1963-1965).
pub fn jet_cli_is_canonical_top_level(name: String) -> Bool Never! {
    jet_cli_moved_command(name) == None && !jet_cli_is_retired_root(name) && name != "install"
}

// Is `name` a word the host dispatches: a command, a normalized handler
// word, the E0043 `install` teaching path, or a retired root?
pub fn jet_cli_is_builtin(name: String) -> Bool Never! {
    if jet_cli_command_index(name) != None -> return true
    loop command in JET_CLI_COMMANDS {
        loop action in command.actions {
            handler :: jet_cli_handler_index(action.handler) ?? next
            if JET_CLI_HANDLERS[handler].dispatch_word == name -> return true
        }
    }
    name == "install" || jet_cli_is_retired_root(name)
}

pub fn jet_cli_is_known_flag(flag: String) -> Bool Never! {
    head :: flag.split("=").to_list()[0]
    loop spec in JET_CLI_FLAGS {
        if spec.long == head -> return true
    }
    false
}

// Levenshtein distance over characters.
fn jet_cli_edit_distance(left: String, right: String) -> Int Never! {
    a :: left.chars()
    b :: right.chars()
    previous := [Int]{}
    loop index in 0..<b.len() + 1 -> &previous.push(index)
    loop i in 0..<a.len() {
        current := [Int]{i + 1}
        loop j in 0..<b.len() {
            cost :: if a[i] == b[j] -> 0 else -> 1
            best := previous[j] + cost
            if previous[j + 1] + 1 < best -> best = previous[j + 1] + 1
            if current[j] + 1 < best -> best = current[j] + 1
            &current.push(best)
        }
        previous = current
    }
    previous[b.len()]
}

// The first closest candidate within distance 3 and at most its own length.
fn jet_cli_closest(needle: String, candidates: [String]) -> String? Never! {
    best := ""
    best_distance := -1
    loop candidate in candidates {
        distance :: jet_cli_edit_distance(needle, candidate)
        if best_distance < 0 || distance < best_distance {
            best = candidate
            best_distance = distance
        }
    }
    if best_distance < 0 || best_distance > 3 || best_distance > best.len() -> return None
    Val(best)
}

pub fn jet_cli_closest_command(name: String) -> String? Never! {
    names := [String]{}
    loop command in JET_CLI_COMMANDS {
        if jet_cli_is_canonical_top_level(command.name) -> &names.push(command.name)
    }
    jet_cli_closest(name, names)
}

pub fn jet_cli_closest_flag(flag: String) -> String? Never! {
    names := [String]{}
    loop spec in JET_CLI_FLAGS -> &names.push(spec.long)
    jet_cli_closest(flag.split("=").to_list()[0], names)
}

// `registry` -> `Registry`, `shared-store` -> `Shared-Store`.
fn jet_cli_group_label(name: String) -> String Never! {
    parts := [String]{}
    loop part in name.split("-").to_list() {
        if part.len() == 0 {
            &parts.push("")
            next
        }
        &parts.push("{part.slice(0..<1).to_upper()}{part.slice(1..<part.len())}")
    }
    parts.join("-")
}

// Help-only summaries for the actions whose output carries the application
// effect projection; man and completions keep the registry summaries.
fn jet_cli_action_help_summary(group: String, action: JetCLIActionSpec) -> String Never! {
    if group == "inspect" {
        if action.name == {
            "rights" -> return "Read required, granted, denied effects, and their authority source"
            "claims" -> return "Read receipt-backed claims and their current status"
            "shapes" -> return "Read semantic shapes and their checked projections"
            "build" -> return "Read build identity, inputs, and provenance"
            "provenance" -> return "Read dependency provenance with required, granted, denied effects, and authority"
            "semindex" -> return "Search code facts plus required, granted, denied effects, and authority"
            "output" -> return "Inspect one Output with required, granted, denied effects, and authority"
            "gates" -> return "Read gates with required, granted, denied effects, and authority"
            "expand" -> return "Show expanded meaning with required, granted, denied effects, and authority"
            else -> {}
        }
    }
    ~action.summary
}

// One group's usage block: its own usage row, then one row per action form.
pub fn jet_cli_group_usage(name: String) -> String Never! {
    index :: jet_cli_group_index(name) ?? return ""
    group :: JET_CLI_COMMANDS[index]
    out := ""
    if group.usage == .Val(usage) -> out = "  {JET_CLI_BINARY} {jet_cli_pad(usage, 48)} {group.summary}\n"
    loop action in group.actions {
        summary :: jet_cli_action_help_summary(group.name, action)
        loop usage in action.usage.split("\n").to_list() {
            out = "{out}  {JET_CLI_BINARY} {group.name} {jet_cli_pad(usage, 48)} {summary}\n"
        }
    }
    out
}

// The usage shape of a live command (CLI.rs `command_usage`).
pub fn jet_cli_command_usage(name: String) -> String Never! {
    if jet_cli_group_index(name) == .Val(index) {
        if JET_CLI_COMMANDS[index].usage == .Val(usage) -> return "{JET_CLI_BINARY} {usage}"
        return "{JET_CLI_BINARY} {name} <command>"
    }
    if jet_cli_moved_command(name) == .Val(moved) {
        group :: JET_CLI_COMMANDS[moved.group]
        lines := [String]{}
        loop usage in group.actions[moved.action].usage.split("\n").to_list() {
            &lines.push("{JET_CLI_BINARY} {group.name} {usage}")
        }
        return lines.join("\n")
    }
    if jet_cli_command_index(name) == .Val(index) {
        if JET_CLI_COMMANDS[index].usage == .Val(usage) -> return "{JET_CLI_BINARY} {usage}"
    }
    "{JET_CLI_BINARY} {name} [args]"
}

// The command list of a `With <cmd>[/<cmd>,…]: ` help prefix, and the help
// text after it; None for an unscoped flag.
fn jet_cli_flag_scope(help: String) -> [String]? Never! {
    rest := ""
    if {
        help.starts_with("with ") || help.starts_with("With ") -> rest = help.slice(5..<help.len())
        else -> return None
    }
    parts :: rest.split(":").to_list()
    if parts.len() < 2 -> return None
    Val([String]{parts[0], rest.slice(parts[0].len() + 1..<rest.len()).trim()})
}

// Flags attached to one command (CLI.rs `flags_for_command`): the scoped
// flags that name it plus the global output flags, each with its help text
// after the scope prefix.
pub fn jet_cli_flags_for_command(name: String) -> [JetCLIFlagSpec] Never! {
    flags := [JetCLIFlagSpec]{}
    loop spec in JET_CLI_FLAGS {
        scope :: jet_cli_flag_scope(spec.help)
        scoped := false
        help := spec.help
        if scope == .Val(parts) {
            help = parts[1]
            loop group in parts[0].split("/").to_list() {
                loop candidate in group.split(",").to_list() {
                    if candidate.trim() == name -> scoped = true
                }
            }
        }
        if scoped || JET_CLI_GLOBAL_FLAGS.contains(spec.long) -> &flags.push(JetCLIFlagSpec{long: spec.long, help: help})
    }
    flags
}

fn jet_cli_lower_byte(byte: Int) -> Int Never! {
    if byte >= 65 && byte <= 90 -> return byte + 32
    byte
}

// Names compare ASCII-case-insensitively, so `Fold` sorts between `flash` and `fuzz`.
fn jet_cli_name_before(left: String, right: String) -> Bool Never! {
    a :: left.bytes()
    b :: right.bytes()
    loop index in 0..<a.len() {
        if index >= b.len() -> return false
        x :: jet_cli_lower_byte(Int.from_u8(a[index]))
        y :: jet_cli_lower_byte(Int.from_u8(b[index]))
        if x != y -> return x < y
    }
    a.len() < b.len()
}

fn jet_cli_command_before(left: Int, right: Int, order: String) -> Bool Never! {
    if order == "az" -> return jet_cli_name_before(JET_CLI_COMMANDS[left].name, JET_CLI_COMMANDS[right].name)
    if order == "za" -> return jet_cli_name_before(JET_CLI_COMMANDS[right].name, JET_CLI_COMMANDS[left].name)
    JET_CLI_COMMANDS[left].frequency_rank < JET_CLI_COMMANDS[right].frequency_rank
}

// The accepted `jet help --sort` values (D-HELP-SORT1=A).
pub JET_CLI_HELP_ORDERS :: "frequency, az, za"

pub fn jet_cli_is_help_order(value: String) -> Bool Never! {
    value == "frequency" || value == "az" || value == "za"
}

// Command row indices in `order` ("frequency", "az", or "za"); equal keys
// keep table order.
pub fn jet_cli_commands_in(order: String) -> [Int] Never! {
    picked := [Bool]{}
    loop _command in JET_CLI_COMMANDS -> &picked.push(false)
    ordered := [Int]{}
    loop ordered.len() < JET_CLI_COMMANDS.len() {
        best := -1
        loop index in 0..<JET_CLI_COMMANDS.len() {
            if picked[index] -> next
            if best < 0 || jet_cli_command_before(index, best, order) -> best = index
        }
        picked[best] = true
        &ordered.push(best)
    }
    ordered
}

// `jet help`: every canonical command, each group's actions, then every flag.
pub fn jet_cli_usage_page(order: String) -> String Never! {
    out := "Welcome to {JET_CLI_LANG_NAME}! (v{JET_CLI_VERSION})\n\nUsage:\n"
    commands :: jet_cli_commands_in(order)
    loop index in commands {
        command :: JET_CLI_COMMANDS[index]
        if jet_cli_is_canonical_top_level(command.name) -> out = "{out}  {jet_cli_pad(jet_cli_command_usage(command.name), 36)} {command.summary}\n"
    }
    loop index in commands {
        command :: JET_CLI_COMMANDS[index]
        if command.actions.len() > 0 -> out = "{out}\n{jet_cli_group_label(command.name)} Commands:\n{jet_cli_group_usage(command.name)}"
    }
    out = "{out}\nFlags:\n"
    loop spec in JET_CLI_FLAGS -> out = "{out}  {jet_cli_pad(spec.long, 28)} {spec.help}\n"
    out
}

// The flags-only greeting: the headline commands in `jet help` order.
pub fn jet_cli_greeting() -> String Never! {
    out := "Welcome to {JET_CLI_LANG_NAME}! (v{JET_CLI_VERSION})\n\nGet started:\n"
    loop index in jet_cli_commands_in("frequency") {
        command :: JET_CLI_COMMANDS[index]
        if command.headline -> out = "{out}  {jet_cli_pad("{JET_CLI_BINARY} {command.name}", 12)} {command.summary}\n"
    }
    "{out}\n  {jet_cli_pad("{JET_CLI_BINARY} help", 12)} see every command\n"
}

fn jet_cli_flag_rows(flags: [JetCLIFlagSpec]) -> String Never! {
    out := ""
    loop spec in flags -> out = "{out}  {jet_cli_pad(spec.long, 28)} {spec.help}\n"
    out
}

// `jet <group> help` for an exhaustive group (and `env`): summary, then usage.
pub fn jet_cli_group_help(name: String) -> String Never! {
    index :: jet_cli_group_index(name) ?? return ""
    "{JET_CLI_BINARY} {name} — {JET_CLI_COMMANDS[index].summary}\n{jet_cli_group_usage(name)}"
}

// `jet <cmd> --help` and `jet help <cmd>` (Source/main.rs `command_help`).
pub fn jet_cli_command_help(name: String) -> String Never! {
    if jet_cli_group_index(name) == .Val(index) {
        out := "{JET_CLI_BINARY} {name} — {JET_CLI_COMMANDS[index].summary}\n\n{jet_cli_group_usage(name)}"
        if name == "db" -> out = "{out}\nFlags:\n{jet_cli_flag_rows(jet_cli_flags_for_command(name))}"
        return out
    }
    if jet_cli_moved_command(name) == .Val(moved) {
        group :: JET_CLI_COMMANDS[moved.group]
        action :: group.actions[moved.action]
        lines := ""
        loop usage in action.usage.split("\n").to_list() -> lines = "{lines}  {JET_CLI_BINARY} {group.name} {usage}\n"
        return "{JET_CLI_BINARY} {group.name} {name} — {jet_cli_action_help_summary(group.name, action)}\n\n{lines}"
    }
    index :: jet_cli_command_index(name) ?? return "{JET_CLI_BINARY} {name}\n\nRun `{JET_CLI_BINARY} help` to see every command.\n"
    "{JET_CLI_BINARY} {name} — {JET_CLI_COMMANDS[index].summary}\n\n  {jet_cli_command_usage(name)}\n{jet_cli_flag_rows(jet_cli_flags_for_command(name))}"
}

// Rust `parser_inventory_violations` (CLI.rs:2412-2414).
pub fn jet_cli_parser_inventory_violations() -> [String] Never! {
    jet_cli_parser_inventory_violations_with_host(None)
}

// Rust `parser_inventory_violations_against` (CLI.rs:2416-2426).
pub fn jet_cli_parser_inventory_violations_against(host_dispatch_words: [String]?) -> [String] Never! {
    if host_dispatch_words == .Val(words) {
        return jet_cli_parser_inventory_violations_with_host(Val([[String]]{words}))
    }
    jet_cli_parser_inventory_violations_with_host(None)
}

// Rust `parser_inventory_violations_against_slices` (CLI.rs:2428-2432).
pub fn jet_cli_parser_inventory_violations_against_slices(host_dispatch_words: [[String]]?) -> [String] Never! {
    jet_cli_parser_inventory_violations_with_host(host_dispatch_words)
}

// Rust `parser_inventory_violations_with_host::host_has` (CLI.rs:2437-2443).
fn jet_cli_inventory_host_has(groups: [[String]]?, word: String) -> Bool Never! {
    if groups == .Val(slices) {
        loop words in slices { if words.contains(word) -> return true }
        return false
    }
    true
}

// Rust `parser_inventory_violations_with_host::registry_has_dispatch` (CLI.rs:2444-2458).
fn jet_cli_inventory_registry_has_dispatch(word: String) -> Bool Never! {
    if word == "install" -> return true
    loop command in JET_CLI_COMMANDS {
        if command.name == word && (command.actions.len() == 0 || !command.exhaustive) -> return true
        loop action in command.actions {
            handler :: jet_cli_handler_index(action.handler) ?? next
            if JET_CLI_HANDLERS[handler].dispatch_word == word -> return true
        }
    }
    false
}

// Rust `parser_inventory_violations_with_host` (CLI.rs:2434-2626).
// Host dispatch words are supplied by the caller, never copied from a second registry.
fn jet_cli_parser_inventory_violations_with_host(host_dispatch_words: [[String]]?) -> [String] Never! {
    violations := [String]{}
    inspect_group := Int?{None}
    loop (index, command) in JET_CLI_COMMANDS {
        if command.name.trim().is_empty() -> &violations.push("command row {index} has an empty name")
        if command.summary.trim().is_empty() -> &violations.push("command `{command.name}` has an empty summary")
        loop previous in 0..<index {
            if JET_CLI_COMMANDS[previous].name == command.name {
                &violations.push("duplicate command row `{command.name}`")
                break
            }
        }
        if command.name == "inspect" -> inspect_group = Val(index)
        if host_dispatch_words != None && command.actions.len() == 0 && jet_cli_is_canonical_top_level(command.name) && !jet_cli_inventory_host_has(host_dispatch_words, command.name) {
            &violations.push("canonical command `{command.name}` has no host dispatch route")
        }
        actions := [String]{}
        loop action in command.actions {
            if action.name.trim().is_empty() -> &violations.push("command `{command.name}` has a nested action with an empty name")
            if action.usage.trim().is_empty() -> &violations.push("nested action `{command.name} {action.name}` has empty usage")
            if action.summary.trim().is_empty() -> &violations.push("nested action `{command.name} {action.name}` has empty summary")
            if !actions.contains(action.name) {
                &actions.push(action.name)
            } else {
                &violations.push("duplicate nested action `{command.name} {action.name}`")
            }
            // Rust's HandlerKey enum guarantees a registered dispatch seam.
            handler_index :: jet_cli_handler_index(action.handler) ?? panic("unregistered CLI handler `{action.handler}`")
            handler :: JET_CLI_HANDLERS[handler_index]
            dispatch_word :: handler.dispatch_word
            keeps_group :: handler.keeps_group
            if dispatch_word.trim().is_empty() -> &violations.push("nested action `{command.name} {action.name}` has an empty dispatch word")
            if host_dispatch_words != None && !jet_cli_inventory_host_has(host_dispatch_words, dispatch_word) {
                &violations.push("nested action `{command.name} {action.name}` routes to missing host dispatch `{dispatch_word}`")
            }
            consumes_pair :: command.name == "inspect" && action.name == "env"
            if keeps_group && dispatch_word != command.name && !consumes_pair {
                &violations.push("nested action `{command.name} {action.name}` keeps a mismatched group for `{dispatch_word}`")
            }
            if !keeps_group && dispatch_word == command.name {
                &violations.push("nested action `{command.name} {action.name}` strips to its owning group `{dispatch_word}`")
            }
            if action.handler == "InspectPlane" {
                if command.name != "inspect" {
                    &violations.push("inspect plane `{action.name}` is registered under `{command.name}`")
                } else {
                    args :: [String]{"inspect", action.name}
                    if jet_cli_parse_inspect_args(args) == {
                        .Ok(request) -> {
                            if jet_cli_inspect_plane_name(request.plane) != action.name || request.scope != JetCLIInspectScope.Package || request.options.len() != 0 {
                                &violations.push("inspect parser normalized plane `{action.name}` inconsistently")
                            }
                        }
                        .Err(error) -> &violations.push("inspect parser rejected registered plane `{action.name}`: {error.message}")
                    }
                }
            }
        }
    }
    if host_dispatch_words == .Val(groups) {
        loop words in groups {
            loop word in words {
                if !jet_cli_inventory_registry_has_dispatch(word) -> &violations.push("host dispatch `{word}` has no registered parser route")
            }
        }
    }
    inspect_index :: inspect_group ?? {
        &violations.push("missing `inspect` command registry row")
        return violations
    }
    inspect :: JET_CLI_COMMANDS[inspect_index]
    loop plane in JET_CLI_INSPECT_PLANES {
        name :: jet_cli_inspect_plane_name(plane)
        count := 0
        loop action in inspect.actions {
            if action.handler == "InspectPlane" && action.name == name -> count += 1
        }
        if count != 1 -> &violations.push("inspect plane `{name}` has {count} registry rows")
    }
    loop (index, flag) in JET_CLI_FLAGS {
        if flag.long.trim().is_empty() -> &violations.push("flag row {index} has an empty name")
        loop previous in 0..<index {
            if JET_CLI_FLAGS[previous].long == flag.long {
                &violations.push("duplicate flag row `{flag.long}`")
                break
            }
        }
    }
    loop retired in JET_CLI_RETIRED {
        live := false
        loop command in JET_CLI_COMMANDS {
            if command.name == retired.spelling -> live = true
            loop action in command.actions {
                route :: "{command.name} {action.name}"
                if route == retired.spelling -> live = true
            }
        }
        if live -> &violations.push("retired route `{retired.spelling}` remains live")
    }
    violations
}

// Rust `owns_flag_vocabulary` (CLI.rs:2632-2690).
pub fn jet_cli_owns_flag_vocabulary(name: String) -> Bool Never! {
    if name == {
        "env" | "cc" | "c++" | "remote" | "shared-store" | "dev" | "devtools" |
        "push" | "trust" | "bridge" | "services" | "image" | "new" | "flash" |
        "os" | "add" | "remove" | "bind" | "lsp" | "config" | "update" |
        "outdated" | "search" | "info" | "import" | "explain" | "logs" | "clean" |
        "fetch" | "publish" | "yank" | "keygen" | "key" | "vendor" | "audit" |
        "sbom" | "repl" | "notebook" | "schema" | "db" | "semindex" | "impact" |
        "codemod" | "generate" | "expand" | "diff" | "merge" | "review" |
        "prove" | "budget" | "perf" | "completions" | "self-update" -> true
        else -> false
    }
}

// Rust `is_help_flag` (CLI.rs:2700-2702).
pub fn jet_cli_is_help_flag(argument: String) -> Bool Never! {
    argument == "--help" || argument == "-h"
}
