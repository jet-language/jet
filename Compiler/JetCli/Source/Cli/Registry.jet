// Lookups and renders over the shared foundation CLICommands.jet table: usage
// page, the greeting, per-command and per-group help, command usage shapes,
// command-scoped flags, retired spellings, and "did you mean" suggestions. Each
// render returns the exact bytes the Rust host prints for the same request, so
// both front doors mean one thing (I9).
use {
    jet_foundation.[JET_CLI_COMMANDS, JET_CLI_FORMS, JET_CLI_HANDLERS, JET_CLI_FLAGS, JET_CLI_INPUT_HELP, JET_CLI_JOB_INVOCATION_HELP, JET_CLI_RUN_INPUT_HELP, JetCLIActionSpec, JetCLIFlagSpec, JetCLIFormSpec]
    jet_pkg_model.[JET_VERSION]
}

// jet-foundation Syntax `BINARY_NAME` and `LANG_NAME`. The `jet` version is
// the package model's JET_VERSION, the one constant `jet --version`, help,
// `jet new` and the compiler identity read.
JET_CLI_BINARY: "jet"
JET_CLI_LANG_NAME: "Jet"

// The flags every command accepts.
JET_CLI_GLOBAL_FLAGS: [String]{"--json", "--quiet", "--color"}

// One nested action: `JET_CLI_COMMANDS[group].actions[action]`.
JetCLIActionRef: struct {
    group: Int
    action: Int
}

// `text` left-aligned in `width` characters (Rust `{:<width}`).
jet_cli_pad: fn(text: String, width: Int) -> String Never! {
    padding: width - text.len()
    // copy: `text` stays with the caller (`text` is a read parameter: no move out of it, E0201) and
    // the new value owns its own.
    if padding <= 0 -> return text.copy()
    "{text}{" ".repeat(padding)}"
}

jet_cli_command_index: fn(name: String) -> Int? Never! {
    loop (index, command) in JET_CLI_COMMANDS {
        if command.name == name -> return Val(index)
    }
    None
}

// A group is a command row with nested actions.
jet_cli_group_index: fn(name: String) -> Int? Never! {
    index: jet_cli_command_index(name) ?? return None
    if JET_CLI_COMMANDS[index].actions.len() == 0 -> return None
    Val(index)
}

jet_cli_handler_index: fn(key: String) -> Int? Never! {
    loop (index, handler) in JET_CLI_HANDLERS {
        if handler.key == key -> return Val(index)
    }
    None
}

jet_cli_nested_command: fn(group: String, action: String) -> JetCLIActionRef? Never! {
    group_index: jet_cli_group_index(group) ?? return None
    loop (index, spec) in JET_CLI_COMMANDS[group_index].actions {
        if spec.name == action -> return Val(JetCLIActionRef{group: group_index, action: index})
    }
    None
}

// A bare nested-action word typed as a top-level command (`jet publish`).
// Group names, top-level commands, and actions that are also canonical at the
// top level win the bare word.
jet_cli_moved_command: fn(name: String) -> JetCLIActionRef? Never! {
    if jet_cli_command_index(name) != None -> return None
    loop command in JET_CLI_COMMANDS {
        loop action in command.actions {
            if action.name == name && action.also_canonical_top_level -> return None
        }
    }
    loop (group_index, command) in JET_CLI_COMMANDS {
        loop (action_index, action) in command.actions {
            if action.name == name {
                if action.also_canonical_top_level -> return None
                return Val(JetCLIActionRef{group: group_index, action: action_index})
            }
        }
    }
    None
}

// Canonical top-level spellings: never a moved action.
jet_cli_is_canonical_top_level: fn(name: String) -> Bool Never! {
    jet_cli_moved_command(name) == None
}

// Is `name` a word the host dispatches: a command or a normalized handler
// word?
jet_cli_is_builtin: fn(name: String) -> Bool Never! {
    if jet_cli_command_index(name) != None -> return true
    loop command in JET_CLI_COMMANDS {
        loop action in command.actions {
            handler: jet_cli_handler_index(action.handler) ?? next
            if JET_CLI_HANDLERS[handler].dispatch_word == name -> return true
        }
    }
    false
}

jet_cli_is_known_flag: fn(flag: String) -> Bool Never! {
    head: flag.split("=").to_list()[0]
    loop spec in JET_CLI_FLAGS {
        if spec.long == head -> return true
    }
    false
}

// The first closest candidate within distance 3 and at most its own length.
jet_cli_closest: fn(needle: String, candidates: [String]) -> String? Never! {
    best := ""
    best_distance := -1
    loop candidate in candidates {
        distance: jet_cli_edit_distance(needle, candidate)
        if best_distance < 0 || distance < best_distance {
            best = candidate
            best_distance = distance
        }
    }
    if best_distance < 0 || best_distance > 3 || best_distance > best.len() -> return None
    Val(best)
}

jet_cli_closest_command: fn(name: String) -> String? Never! {
    names := [String]{}
    loop command in JET_CLI_COMMANDS {
        if jet_cli_is_canonical_top_level(command.name) -> names.push(command.name)
    }
    jet_cli_closest(name, names)
}

jet_cli_closest_flag: fn(flag: String) -> String? Never! {
    names := [String]{}
    loop spec in JET_CLI_FLAGS -> names.push(spec.long)
    jet_cli_closest(flag.split("=").to_list()[0], names)
}

// `registry` -> `Registry`; each hyphen-separated part is capitalized.
jet_cli_group_label: fn(name: String) -> String Never! {
    parts := [String]{}
    loop part in name.split("-").to_list() {
        if part.len() == 0 {
            parts.push("")
            next
        }
        parts.push("{part.slice(0..<1).to_upper()}{part.slice(1..<part.len())}")
    }
    parts.join("-")
}

// Help-only summaries for the actions whose output carries the application
// effect projection; man and completions keep the registry summaries.
jet_cli_action_help_summary: fn(group: String, action: JetCLIActionSpec) -> String Never! {
    if group == "inspect" {
        if action.name == {
            "rights" -> return "Read required, granted, denied effects, and their authority source"
            "claims" -> return "Read receipt-backed claims and their current status"
            "shapes" -> return "Read semantic shapes and their checked projections"
            "build" -> return "Read build identity, inputs, and provenance"
            "provenance" -> return "Read dependency provenance with required, granted, denied effects, and authority"
            "semindex" -> return "Search code facts plus required, granted, denied effects, and authority"
            "output" -> return "Inspect one Output with required, granted, denied effects, and authority"
            "gates" -> return "Read gates with required, granted, denied effects, and authority"
            "expand" -> return "Show expanded meaning with required, granted, denied effects, and authority"
            else -> {}
        }
    }
    // copy: `action.summary` stays with the caller (`action` is a read parameter: no move out of
    // it, E0201) and the returned value owns its own.
    action.summary.copy()
}

// One group's usage block: its own usage row, then one row per action form.
// The usage page, man and completions list only the actions the command model
// marks ported; the group's own help page (`family`) lists its whole family,
// and running an unbuilt action answers E2104 naming its card.
jet_cli_group_usage: fn(name: String, family: Bool) -> String Never! {
    index: jet_cli_group_index(name) ?? return ""
    group: JET_CLI_COMMANDS[index]
    out := ""
    if group.usage == .Val(usage) -> out = "  {JET_CLI_BINARY} {jet_cli_pad(usage, 48)} {group.summary}\n"
    loop action in group.actions {
        if !family && !jet_cli_form_ported("{group.name} {action.name}") -> next
        summary: jet_cli_action_help_summary(group.name, action)
        loop usage in action.usage.split("\n").to_list() {
            out = "{out}  {JET_CLI_BINARY} {group.name} {jet_cli_pad(usage, 48)} {summary}\n"
        }
    }
    out
}

// The usage shape of a live command.
jet_cli_command_usage: fn(name: String) -> String Never! {
    if jet_cli_group_index(name) == .Val(index) {
        if JET_CLI_COMMANDS[index].usage == .Val(usage) -> return "{JET_CLI_BINARY} {usage}"
        return "{JET_CLI_BINARY} {name} <command>"
    }
    if jet_cli_moved_command(name) == .Val(moved) {
        group: JET_CLI_COMMANDS[moved.group]
        lines := [String]{}
        loop usage in group.actions[moved.action].usage.split("\n").to_list() {
            lines.push("{JET_CLI_BINARY} {group.name} {usage}")
        }
        return lines.join("\n")
    }
    if jet_cli_command_index(name) == .Val(index) {
        if JET_CLI_COMMANDS[index].usage == .Val(usage) -> return "{JET_CLI_BINARY} {usage}"
    }
    "{JET_CLI_BINARY} {name} [args]"
}

// The command list of a `With <cmd>[/<cmd>,…]: ` help prefix, and the help
// text after it; None for an unscoped flag.
jet_cli_flag_scope: fn(help: String) -> [String]? Never! {
    rest := ""
    if {
        help.starts_with("with ") || help.starts_with("With ") -> rest = help.slice(5..<help.len())
        else -> return None
    }
    parts: rest.split(":").to_list()
    if parts.len() < 2 -> return None
    Val([String]{parts[0], rest.slice(parts[0].len() + 1..<rest.len()).trim()})
}

// The commands a flag's registry row scopes it to: the first command word of
// each `/`-separated form in every `With <forms>: ` clause (`fmt --check`
// names fmt, `inspect digest` inspect); None for an unscoped (global) flag.
jet_cli_flag_commands: fn(help: String) -> [String]? Never! {
    commands := [String]{}
    scoped := false
    loop clause in help.split("; ").to_list() {
        rest := ""
        if {
            clause.starts_with("with ") || clause.starts_with("With ") -> rest = clause.slice(5..<clause.len())
            else -> next
        }
        parts: rest.split(":").to_list()
        if parts.len() < 2 -> next
        scoped = true
        loop form in parts[0].split("/").to_list() {
            loop word in form.split(" ").to_list() {
                if jet_cli_command_index(word) == None && jet_cli_word_group(word) == None -> next
                if !commands.contains(word) -> commands.push(word)
                break
            }
        }
    }
    if !scoped -> return None
    Val(commands)
}

// The group a word dispatches under when it is not a top-level command: a
// group action's name (`digest`) or the word its handler normalizes the
// action to (`self update` dispatches as `self-update`).
jet_cli_word_group: fn(word: String) -> String? Never! {
    if jet_cli_command_index(word) != None -> return None
    loop command in JET_CLI_COMMANDS {
        loop action in command.actions {
            if action.name == word -> return Val(command.name.copy())
            handler: jet_cli_handler_index(action.handler) ?? next
            if JET_CLI_HANDLERS[handler].dispatch_word == word -> return Val(command.name.copy())
        }
    }
    None
}

// Does the registry row of `spec` let `command` take it? Unscoped flags go
// with every command; a short form (`-u`) goes where its long form
// (`--update-snapshots`) goes. A
// group's action (`jet inspect digest`, dispatched as `digest`) takes its
// group's flags, and a group that keeps its own word (`jet inspect expand`,
// dispatched as `inspect`) takes its actions' flags.
jet_cli_flag_takes: fn(spec: JetCLIFlagSpec, command: String) -> Bool Never! {
    short_prefix: "Short form of "
    if spec.help.starts_with(short_prefix) {
        long: spec.help.slice(short_prefix.len()..<spec.help.len()).split("=").to_list()[0]
        loop other in JET_CLI_FLAGS {
            if other.long == long -> return jet_cli_flag_takes(other, command)
        }
    }
    commands: jet_cli_flag_commands(spec.help) ?? return true
    if commands.contains(command) -> return true
    if jet_cli_word_group(command) == .Val(group) {
        if commands.contains(group) -> return true
    }
    loop word in commands {
        if jet_cli_word_group(word) == .Val(group) {
            if group == command -> return true
        }
    }
    false
}

// Flags attached to one command: the scoped flags that name it plus the global
// output flags. A scoped flag shows only the ported clauses that scope it to
// this command, each without its scope prefix, so a flag with a meaning per
// command shows this command's; a flag with no such clause (the command model
// marks it unported for the command) is left out.
jet_cli_flags_for_command: fn(name: String) -> [JetCLIFlagSpec] Never! {
    flags := [JetCLIFlagSpec]{}
    loop spec in JET_CLI_FLAGS {
        commands: jet_cli_flag_commands(spec.help) ?? [String]{}
        global: JET_CLI_GLOBAL_FLAGS.contains(spec.long)
        if !commands.contains(name) && !global -> next
        if !jet_cli_form_ported("{name} {spec.long}") -> next
        shown: jet_cli_flag_ported_help(spec) ?? next
        help: jet_cli_flag_help_for(shown, name)
        if help == "" && !global -> next
        flags.push(JetCLIFlagSpec{long: spec.long, help: if help == "" -> shown else -> help})
    }
    flags
}

// The help one command's usage shows for a flag's help line: the text of each
// `With <forms>: ` clause whose forms name the command (with the unscoped
// clauses that continue it), without the prefix and starting with a capital;
// an unscoped (global) flag's whole line.
jet_cli_flag_help_for: fn(help: String, name: String) -> String Never! {
    if jet_cli_flag_commands(help) == None -> return help.copy() // copy: the caller keeps its line.
    texts := [String]{}
    taken := false
    loop clause in help.split("; ").to_list() {
        if jet_cli_flag_scope(clause) == .Val(parts) {
            commands: jet_cli_flag_commands(clause) ?? [String]{}
            taken = commands.contains(name)
            if !taken -> next
            text: parts[1]
            texts.push("{text.slice(0..<1).to_upper()}{text.slice(1..<text.len())}")
            next
        }
        if taken -> texts.push(clause.copy()) // copy: the clause list keeps its row.
    }
    texts.join("; ")
}

// The words of a command-model form: `=` is a space.
jet_cli_form_words: fn(form: String) -> [String] Never! {
    form.replace("=", " ").split(" ").to_list().filter(fn(word) { word != "" })
}

// How closely the model row `row` decides `form`: -1 when it does not; a
// shape row decides a form that ends in its shape (`build <shape>`,
// `inspect provenance <shape>`); otherwise more matched words win, then more
// literal (not placeholder) words. A placeholder stands for a value or name,
// never for a flag.
jet_cli_form_score: fn(row: String, form: String) -> Int Never! {
    if row.starts_with("<") {
        if form.ends_with(" {row}") -> return 1000000
        return -1
    }
    words: jet_cli_form_words(form)
    pattern: jet_cli_form_words(row)
    if pattern.len() > words.len() -> return -1
    literal := 0
    loop index in 0..<pattern.len() {
        word: pattern[index]
        if word.starts_with("<") && word.ends_with(">") {
            if words[index].starts_with("-") -> return -1
            next
        }
        if word != words[index] -> return -1
        literal += 1
    }
    pattern.len() * 1000 + literal
}

// A form spelled with an action's dispatch word, spelled as the action:
// `self-update --apply` is `self update --apply`.
jet_cli_form_normal: fn(form: String) -> String Never! {
    words: jet_cli_form_words(form)
    if words.len() == 0 || jet_cli_word_group(words[0]) == None -> return form.copy() // copy: the caller keeps its form.
    head: jet_cli_dispatch_form([String]{words[0].copy()}) // copy: the word list keeps its word.
    "{head}{form.slice(words[0].len()..<form.len())}"
}

// The command-model row that decides `form`, if one does (JET_CLI_FORMS).
jet_cli_form_row: fn(form: String) -> JetCLIFormSpec? Never! {
    normal: jet_cli_form_normal(form)
    best := -1
    best_score := -1
    loop index in 0..<JET_CLI_FORMS.len() {
        score: jet_cli_form_score(JET_CLI_FORMS[index].form, normal)
        if score > best_score {
            best = index
            best_score = score
        }
    }
    if best < 0 -> return None
    Val(JET_CLI_FORMS[best].copy()) // copy: the registry keeps its row.
}

// Does this `jet` run `form`? A form no model row decides is ported.
jet_cli_form_ported: fn(form: String) -> Bool Never! {
    row: jet_cli_form_row(form) ?? return true
    row.ported
}

// The Tower card that owns the port of an unported `form`, if the model names one.
jet_cli_form_card: fn(form: String) -> Int? Never! {
    row: jet_cli_form_row(form) ?? return None
    if row.ported -> return None
    Val(row.card)
}

// A flag's help line as help, completions and man print it: each `With
// <forms>: ` clause keeps the forms whose `<form> <flag>` is ported and goes
// when none is left; None for a scoped flag with no clause left.
jet_cli_flag_ported_help: fn(spec: JetCLIFlagSpec) -> String? Never! {
    if jet_cli_flag_commands(spec.help) == None -> return Val(spec.help.copy()) // copy: the registry keeps its row.
    kept := [String]{}
    loop clause in spec.help.split("; ").to_list() {
        scoped: clause.starts_with("with ") || clause.starts_with("With ")
        rest: if scoped -> clause.slice(5..<clause.len()) else -> clause.copy() // copy: the clause list keeps its row.
        scope: rest.split(":").to_list()
        if !scoped || scope.len() < 2 {
            kept.push(clause.copy()) // copy: the clause list keeps its row.
            next
        }
        forms := [String]{}
        loop form in scope[0].split("/").to_list() {
            if jet_cli_form_ported("{form} {spec.long}") -> forms.push(form.copy()) // copy: the form list keeps its row.
        }
        if forms.len() == 0 -> next
        kept.push("with {forms.join("/")}:{rest.slice(scope[0].len() + 1..<rest.len())}")
    }
    if kept.len() == 0 -> return None
    text: kept.join("; ")
    if text.starts_with("with ") -> return Val("W{text.slice(1..<text.len())}")
    Val(text)
}

// The form a dispatch word and its next word name: `self-update` is `self
// update`, `devtools bless` is `self devtools bless`; a top-level command is
// its own word.
jet_cli_dispatch_form: fn(argv: [String]) -> String Never! {
    word: argv[0]
    group: jet_cli_word_group(word) ?? return word.copy() // copy: the argv keeps its word.
    index: jet_cli_group_index(group) ?? return word.copy() // copy: the argv keeps its word.
    loop action in JET_CLI_COMMANDS[index].actions {
        handler: jet_cli_handler_index(action.handler) ?? next
        if action.name != word && JET_CLI_HANDLERS[handler].dispatch_word != word -> next
        if argv.len() > 1 && !argv[1].starts_with("-") -> return "{group} {action.name} {argv[1]}"
        return "{group} {action.name}"
    }
    word.copy() // copy: the argv keeps its word.
}

// `jet help --all`: every form the command model marks unported, with the
// Tower card that owns its port.
jet_cli_not_built_page: fn() -> String Never! {
    out := "\nNot built yet:\n"
    loop row in JET_CLI_FORMS {
        if row.ported -> next
        form: if row.form.starts_with("<") -> "{JET_CLI_BINARY} <command> {row.form}" else -> "{JET_CLI_BINARY} {row.form}"
        out = "{out}  {jet_cli_pad(form, 48)} #{row.card}\n"
    }
    out
}

// The registry row of a known flag (`--flag` or `--flag=value`).
jet_cli_flag_spec: fn(flag: String) -> JetCLIFlagSpec? Never! {
    head: flag.split("=").to_list()[0]
    loop spec in JET_CLI_FLAGS {
        if spec.long == head -> return Val(spec.copy())
    }
    None
}

jet_cli_lower_byte: fn(byte: Int) -> Int Never! {
    if byte >= 65 && byte <= 90 -> return byte + 32
    byte
}

// Names compare ASCII-case-insensitively.
jet_cli_name_before: fn(left: String, right: String) -> Bool Never! {
    a: left.bytes()
    b: right.bytes()
    loop index in 0..<a.len() {
        if index >= b.len() -> return false
        x: jet_cli_lower_byte(Int{a[index]})
        y: jet_cli_lower_byte(Int{b[index]})
        if x != y -> return x < y
    }
    a.len() < b.len()
}

jet_cli_command_before: fn(left: Int, right: Int, order: String) -> Bool Never! {
    if order == "az" -> return jet_cli_name_before(JET_CLI_COMMANDS[left].name, JET_CLI_COMMANDS[right].name)
    if order == "za" -> return jet_cli_name_before(JET_CLI_COMMANDS[right].name, JET_CLI_COMMANDS[left].name)
    JET_CLI_COMMANDS[left].frequency_rank < JET_CLI_COMMANDS[right].frequency_rank
}

// The accepted `jet help --sort` values.
JET_CLI_HELP_ORDERS: "frequency, az, za"

jet_cli_is_help_order: fn(value: String) -> Bool Never! {
    value == "frequency" || value == "az" || value == "za"
}

// Command row indices in `order` ("frequency", "az", or "za"); equal keys
// keep table order.
jet_cli_commands_in: fn(order: String) -> [Int] Never! {
    picked := [Bool]{}
    loop _command in JET_CLI_COMMANDS -> picked.push(false)
    ordered := [Int]{}
    loop ordered.len() < JET_CLI_COMMANDS.len() {
        best := -1
        loop index in 0..<JET_CLI_COMMANDS.len() {
            if picked[index] -> next
            if best < 0 || jet_cli_command_before(index, best, order) -> best = index
        }
        picked[best] = true
        ordered.push(best)
    }
    ordered
}

// A command help, the palette, completions and man list: canonical at the top
// level and ported in the command model.
jet_cli_command_listed: fn(name: String) -> Bool Never! {
    jet_cli_is_canonical_top_level(name) && jet_cli_form_ported(name)
}

// `jet help`: every listed command, each group's ported actions, then every
// flag with its ported scopes. `version` is the running build's version, as
// `jet --version` spells it (`a0.0.43-dev+29517f5447`, or `a0.0.43` for a
// release).
jet_cli_usage_page: fn(order: String, version: String) -> String Never! {
    out := "Welcome to {JET_CLI_LANG_NAME}! ({version})\n\nUsage:\n"
    commands: jet_cli_commands_in(order)
    loop index in commands {
        command: JET_CLI_COMMANDS[index]
        if jet_cli_command_listed(command.name) -> out = "{out}  {jet_cli_pad(jet_cli_command_usage(command.name), 36)} {command.summary}\n"
    }
    loop index in commands {
        command: JET_CLI_COMMANDS[index]
        if command.actions.len() == 0 || !jet_cli_form_ported(command.name) -> next
        usage: jet_cli_group_usage(command.name, false)
        if usage != "" -> out = "{out}\n{jet_cli_group_label(command.name)} Commands:\n{usage}"
    }
    out = "{out}\nFlags:\n"
    loop spec in JET_CLI_FLAGS {
        help: jet_cli_flag_ported_help(spec) ?? next
        out = "{out}  {jet_cli_pad(spec.long, 28)} {help}\n"
    }
    out
}

// The categories of the bare `jet` command palette, in display order.
JET_CLI_PALETTE_CATEGORIES: [String]{"Build & Run", "Projects & Environments", "Packages", "Jetos", "Development Server", "Reference"}

jet_cli_palette_category: fn(name: String) -> String Never! {
    if name == {
        "run" | "check" | "test" | "build" | "debug" | "crash" | "eval" | "emit" | "package" | "flash" | "cc" | "c++" | "jobs" -> "Build & Run"
        "new" | "fmt" | "fix" | "lint" | "env" | "init" | "project" | "import" | "split" | "fold" | "generate" -> "Projects & Environments"
        "registry" | "add" | "remove" | "fetch" | "update" | "search" | "clean" | "audit" | "gc" | "cache" -> "Packages"
        "os" | "image" | "bind" | "trust" | "remote" -> "Jetos"
        "dev" | "notebook" -> "Development Server"
        else -> "Reference"
    }
}

// Bare `jet` off a terminal: the command palette, then `version_line` (the
// `jet --version` line), then every canonical command under its category.
// On a terminal bare `jet` opens the picker (Picker.jet) instead.
jet_cli_palette: fn(version_line: String) -> String Never! {
    out := "{JET_CLI_LANG_NAME} command palette\n{version_line}\n"
    commands: jet_cli_commands_in("frequency")
    loop category in JET_CLI_PALETTE_CATEGORIES {
        out = "{out}\n{category}\n"
        loop index in commands {
            command: JET_CLI_COMMANDS[index]
            if !jet_cli_command_listed(command.name) || jet_cli_palette_category(command.name) != category -> next
            out = "{out}  {jet_cli_pad("{JET_CLI_BINARY} {command.name}", 18)} {command.summary}\n"
        }
    }
    out = "{out}\nError Codes\n  {jet_cli_pad("{JET_CLI_BINARY} explain <CODE>", 18)} Show a diagnostic's full help, such as `{JET_CLI_BINARY} explain E0102`\n"
    "{out}\nRun `{JET_CLI_BINARY} help` for every command's usage and flags.\n"
}

jet_cli_flag_help_rows: fn(flags: [JetCLIFlagSpec]) -> String Never! {
    out := ""
    loop spec in flags -> out = "{out}  {jet_cli_pad(spec.long, 28)} {spec.help}\n"
    out
}

// `jet <group> help` for an exhaustive group (and `env`): summary, then the
// group's whole family.
jet_cli_group_help: fn(name: String) -> String Never! {
    index: jet_cli_group_index(name) ?? return ""
    "{JET_CLI_BINARY} {name} — {JET_CLI_COMMANDS[index].summary}\n{jet_cli_group_usage(name, true)}"
}

// `jet <cmd> --help` and `jet help <cmd>`.
jet_cli_command_help: fn(name: String) -> String Never! {
    // `diff`/`merge` carry their own structural usage (StructuralMerge.jet).
    if jet_cli_structural_help(name) == .Val(bespoke) -> return bespoke
    if jet_cli_group_index(name) == .Val(index) {
        out := "{JET_CLI_BINARY} {name} — {JET_CLI_COMMANDS[index].summary}\n\n{jet_cli_group_usage(name, true)}"
        if name == "db" -> out = "{out}\nFlags:\n{jet_cli_flag_help_rows(jet_cli_flags_for_command(name))}"
        return out
    }
    if jet_cli_moved_command(name) == .Val(moved) {
        group: JET_CLI_COMMANDS[moved.group]
        action: group.actions[moved.action]
        lines := ""
        loop usage in action.usage.split("\n").to_list() -> lines = "{lines}  {JET_CLI_BINARY} {group.name} {usage}\n"
        return "{JET_CLI_BINARY} {group.name} {name} — {jet_cli_action_help_summary(group.name, action)}\n\n{lines}"
    }
    // `input` is no command: its page lists the names a program reads through.
    if name == "input" -> return JET_CLI_INPUT_HELP
    index: jet_cli_command_index(name) ?? return "{JET_CLI_BINARY} {name}\n\nRun `{JET_CLI_BINARY} help` to see every command.\n"
    trailer: if name == {
        "jobs" -> JET_CLI_JOB_INVOCATION_HELP
        "run" -> JET_CLI_RUN_INPUT_HELP
        else -> ""
    }
    "{JET_CLI_BINARY} {name} — {JET_CLI_COMMANDS[index].summary}\n\n  {jet_cli_command_usage(name)}\n{jet_cli_flag_help_rows(jet_cli_flags_for_command(name))}{trailer}"
}
