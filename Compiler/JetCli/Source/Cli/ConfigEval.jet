// Config-surface values through the one comptime path (Rust jet-comptime
// `evaluate`, without a second evaluator; I8/I9). A config value (a field of
// an `env.jet`/`config.jet` module) is turned into typed Jet code by the
// requester (JetParser `jet_config_program`, the program both sides of
// the compiler service build): every global it reads becomes an ALL_CAPS
// module constant holding that value's literal, the source's own top-level
// functions are carried by their exact text, and the value itself becomes
// `JET_CONFIG_VALUE: comptime { <expression> }`. Here the driver checks that
// program in `JetDriverCompileMode.Comptime`, whose comptime stage lowers the
// `comptime` value to IR and runs it natively in the sealed comptime child
// (JetEval IR/Native.jet); the checked value is read
// back as a `CtValue`. The environment model reaches this evaluator through
// `jet __jetpack comptime-evaluate` (JetpackService.jet), in `jet` and in
// `jetpack` alike.
use {
    config_files: core.files
    jet_driver.[
        JetDriverAuthorizedSourceFile,
        JetDriverAuthorizedSourceRoot,
        JetDriverAuthorizedSourceSnapshot,
        JetDriverCompileMode,
        JetDriverCompileResult,
        JetDriverCoreSource,
        jet_driver_compile,
    ]
    jet_foundation.[
        DIAGNOSTIC_ERROR,
        JET_CONFIG_VALUE_FILE,
        JET_CONFIG_VALUE_NAME,
        JetConfigOutcome,
        diagnostic_from_registry,
        jet_config_eval_diagnostic,
    ]
    jet_sema.[
        SemaComptimeItemKind,
        sema_user_template_ct_value,
    ]
}

jet_config_evaluate_program: fn(program: String, base_dir: String) -> JetConfigOutcome {
    core_sources: if jet_cli_core_sources(base_dir, false) == {
        .Loaded(sources) -> sources
        .Missing(what, fix) -> { return JetConfigOutcome.Refused{diagnostic: diagnostic_from_registry("E2105", None, what, jet_cli_why("E2105"), fix)} }
    }
    result: jet_config_compile(program, core_sources, base_dir) ?? return JetConfigOutcome.Refused{diagnostic: jet_config_eval_diagnostic(None, "this config value could not be evaluated: {err}")}
    loop diagnostic in result.diagnostics {
        if diagnostic.severity == DIAGNOSTIC_ERROR -> return JetConfigOutcome.Refused{diagnostic: diagnostic_from_registry(diagnostic.code, None, diagnostic.what, diagnostic.why, diagnostic.fix)}
    }
    if result.internal_problem == .Val(problem) -> return JetConfigOutcome.Refused{diagnostic: jet_config_eval_diagnostic(None, "this config value could not be evaluated: {problem}")}
    loop value in result.comptime_values {
        if value.kind != SemaComptimeItemKind.Constant || !value.key.ends_with(":{JET_CONFIG_VALUE_NAME}") -> next
        converted: sema_user_template_ct_value(value.value) ?? return JetConfigOutcome.Refused{diagnostic: jet_config_eval_diagnostic(None, "this config value's result has a shape a config value can't hold")}
        return JetConfigOutcome.Value{value: converted}
    }
    JetConfigOutcome.Refused{diagnostic: jet_config_eval_diagnostic(None, "this config value produced no build-time value")}
}

// Check `program` as the one file of a source root at the config's own
// directory (relative `embed_file` paths resolve there) and run its comptime
// stage. The driver makes dynamic host calls with no effect bound, so this
// stays unannotated like `jet_cli_compile_file`.
jet_config_compile: fn(program: String, core_sources: [JetDriverCoreSource], base_dir: String) -> JetDriverCompileResult {
    root: config_files.realpath(base_dir) ?? base_dir
    path: if root == "/" -> "/{JET_CONFIG_VALUE_FILE}" else -> "{root}/{JET_CONFIG_VALUE_FILE}"
    identity: "config-value-root:{root}"
    snapshot: JetDriverAuthorizedSourceSnapshot{
        roots: [JetDriverAuthorizedSourceRoot]{JetDriverAuthorizedSourceRoot{
            canonical_path: root,
            identity: identity,
            allow_hardlinks: false,
            files: [JetDriverAuthorizedSourceFile]{JetDriverAuthorizedSourceFile{path: path, relative_path: JET_CONFIG_VALUE_FILE, identity: "config-value-file:{path}", source: program}},
            foreign_cache_files: [JetDriverAuthorizedSourceFile]{},
        }},
        entry_root_identity: identity,
        entry_path: path,
    }
    request := jet_cli_driver_request(snapshot, core_sources, None, JetDriverCompileMode.Comptime)
    jet_driver_compile(request)
}

