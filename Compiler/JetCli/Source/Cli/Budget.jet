// `jet budget check`: check the project entry, collect its performance budget
// specs, measure each applicable one (BudgetMeasure.jet, with the inputs
// BudgetProviders.jet gathers), and write the canonical budget report under
// `.jet/perf/reports`. The report is verified by the budget engine's own
// verifier before it is published, and a published report is never
// rewritten. A budget whose provider this `jet` has not built, or that
// compares against a named baseline's history, which this `jet` can't read
// yet, refuses with E2104 before any artifact is written. `jet budget
// update` measures the same way, then plans advancing a named baseline to
// the report (BudgetStore.jet); nothing is written until `--yes` or a
// confirmed terminal prompt applies the plan.
use {
    budget_crypto: core.crypto
    budget_term: core.term
    cli_files: core.files
    cli_sys: core.sys
    cli_time: core.time
    jet_driver.[JetDriverBudgetFacts, JetDriverBudgetSpec, JetDriverCompileMode, JetDriverVerbOutput, JET_DRIVER_EXIT_OK, JET_DRIVER_EXIT_USAGE, JET_DRIVER_EXIT_USER_ERROR, jet_driver_budget_projection, jet_driver_present_diagnostics]
    jet_foundation.[CORE_SOURCE_OWNED_ROWS, CanonicalJSON, CanonicalJSONField, Diagnostic, diagnostic_from_registry, diagnostic_render_all, perf_report_object_new, perf_stable_id]
    jet_sema.[BudgetAxis, BudgetSpec, sema_budget_ascii_lower, sema_budget_baseline_name, sema_budget_provider_identity, sema_budget_provider_kind, sema_budget_safe_relative_path]
    jet_pkg_model.[JET_VERSION]
}

JET_CLI_BUDGET_USAGE: "jet budget check [--json] [--verbose] [--quiet] [--annotations auto|none|github] | jet budget update --baseline <name> [--bootstrap|--accept-regression] [--reason <text>] [-y|--yes] [--json] [--verbose] [--quiet] [--annotations auto|none|github]"

// The parsed command line; `command` is `check` or `update`.
JetCLIBudgetOptions: struct {
    command: String
    baseline: String?
    bootstrap: Bool
    accept_regression: Bool
    reason: String?
    yes: Bool
    json: Bool
    verbose: Bool
    quiet: Bool
    annotations: String
}

// A usage error, or a failure before a valid report exists.
#Error
JetCLIBudgetFailure: struct {
    message: String
}

jet_cli_budget_failure: fn(message: String) -> JetCLIBudgetFailure Never! {
    JetCLIBudgetFailure{message: message}
}

// `jet budget` after the front: `raw` starts at the `budget` word. The
// project is the manifest root at or above the working directory, else the
// working directory, and its entry is the stock project entry.
jet_cli_budget_plan: fn(raw: [String], color: Bool) -> JetCLIPlan Never! {
    options: jet_cli_budget_parse(raw) ?? return jet_cli_fail("E2102", err.message, jet_cli_why("E2102"), JET_CLI_BUDGET_USAGE, color, JET_DRIVER_EXIT_USAGE)
    cwd: cli_sys.current_dir() ?? return JetCLIPlan.Done{output: jet_cli_budget_tool_failure(options, "cannot resolve current workspace: {jet_cli_io_error_text(err)}", color)}
    source_root: jet_cli_manifest_root(cwd) ?? cwd
    root: cli_files.realpath(source_root) ?? source_root
    notices := [String]{}
    entry: if jet_cli_find_project_entry(root, "budget", color, notices) == {
        .Entry(found) -> found.path.copy()
        .Absent -> ""
        .Refused(plan) -> { return plan.copy() }
    }
    if entry == "" || !cli_files.is_file(entry) -> return JetCLIPlan.Done{output: jet_cli_budget_tool_failure(options, "no project entry exists; add run.jet inside a project", color)}
    JetCLIPlan.Budget{options: options, root: root, entry: entry, color: color}
}

jet_cli_budget_parse: fn(raw: [String]) -> JetCLIBudgetOptions JetCLIBudgetFailure! {
    command: if raw.get(1) == {
        .Val(word) -> if word == {
            "check" | "update" -> word.copy()
            else -> { return Err(jet_cli_budget_failure("unknown `jet budget` subcommand `{word}`")) }
        }
        .None -> { return Err(jet_cli_budget_failure("`jet budget` needs `check` or `update`")) }
    }
    out := JetCLIBudgetOptions{command: command, baseline: None, bootstrap: false, accept_regression: false, reason: None, yes: false, json: false, verbose: false, quiet: false, annotations: "auto"}
    seen := [String]{}
    index := 2
    loop index < raw.len() {
        flag: raw[index]
        key: if flag == "-y" -> "--yes" else -> flag.copy()
        if seen.contains(key) -> return Err(jet_cli_budget_failure("flag `{flag}` is repeated"))
        seen.push(key)
        if flag == {
            "--json" -> out.json = true
            "--verbose" -> out.verbose = true
            "--quiet" -> out.quiet = true
            "-y" | "--yes" -> out.yes = true
            "--bootstrap" -> out.bootstrap = true
            "--accept-regression" -> out.accept_regression = true
            "--baseline" | "--reason" | "--annotations" -> {
                index = index + 1
                value: raw.get(index) ?? return Err(jet_cli_budget_failure("flag `{flag}` needs a value"))
                if value.starts_with("-") -> return Err(jet_cli_budget_failure("flag `{flag}` needs a value"))
                if flag == "--baseline" {
                    out.baseline = Val(value.copy())
                } else if flag == "--reason" {
                    out.reason = Val(value.copy())
                } else {
                    if value != "auto" && value != "none" && value != "github" -> return Err(jet_cli_budget_failure("`--annotations` accepts auto, none, or github"))
                    out.annotations = value.copy()
                }
            }
            else -> { return Err(jet_cli_budget_failure("unknown flag or argument `{flag}`")) }
        }
        index = index + 1
    }
    if command == "check" && (out.baseline != None || out.bootstrap || out.accept_regression || out.reason != None || out.yes) {
        return Err(jet_cli_budget_failure("update-only flags cannot be used with `budget check`"))
    }
    if command == "update" && out.baseline == None -> return Err(jet_cli_budget_failure("`budget update` requires `--baseline <name>`"))
    if out.baseline == .Val(baseline) && !sema_budget_baseline_name(baseline) -> return Err(jet_cli_budget_failure("invalid `--baseline` value: invalid BaselineName"))
    if out.bootstrap && out.accept_regression -> return Err(jet_cli_budget_failure("`--bootstrap` and `--accept-regression` are mutually exclusive"))
    if (out.bootstrap || out.accept_regression) != (out.reason != None) {
        return Err(jet_cli_budget_failure("`--reason` is required with, and only accepted with, bootstrap or accept-regression"))
    }
    if out.json -> out.annotations = "none"
    Ok(out)
}

// `jet budget check` and `jet budget update` (JetCLIPlan.Budget): the checked
// specs of the project entry `entry` under `root` for the native target and
// dev profile, and their report.
jet_cli_budget_run: fn(options: JetCLIBudgetOptions, root: String, entry: String, color: Bool) -> JetDriverVerbOutput {
    measured_start: jet_cli_rfc3339(cli_time.unix_ns())
    prepared: jet_cli_prepare_overlays(entry, entry, [JetCLIOverlay]{}, color, None, JetDriverCompileMode.Check)
    if prepared == {
        .Refused(output) -> return output.move()
        .Prepared(request, snapshot) -> {
            // copy: the request moves into the projection below.
            profile: request.profile.copy()
            projection: jet_driver_budget_projection(request.move())
            diagnostics: jet_driver_present_diagnostics(projection.compile.diagnostics, snapshot, projection.compile.generated_source_files)
            if jet_cli_errors(diagnostics).len() > 0 -> return jet_cli_budget_compiler_failure(options, entry, diagnostics, color)
            if projection.compile.internal_problem == .Val(problem) -> return jet_cli_ice(problem)
            active := [JetDriverBudgetSpec]{}
            loop row in projection.budget_specs {
                if jet_cli_budget_applies(row.spec, profile) -> active.push(row.copy()) // copy: the projection keeps its specs.
            }
            sources := [JetCLIBudgetSource]{}
            prefix: jet_cli_entry_join(root, "")
            loop held in snapshot.roots {
                // The measured members are the program modules; a manifest is
                // not one.
                loop file in held.files {
                    if !file.path.ends_with(".jet") || jet_cli_fmt_is_package_manifest_file(file.path) -> next
                    sources.push(JetCLIBudgetSource{path: file.path.removeprefix(prefix), sha256: budget_crypto.sha256(file.source.bytes()).hex()})
                }
            }
            return jet_cli_budget_check(options, root, entry, active, projection.budget_facts, sources, measured_start, profile, color)
        }
    }
}

// Whether a budget applies to this native run: its target and profile axes
// admit `native` and `profile`, the one the measured compile selected.
jet_cli_budget_applies: fn(spec: BudgetSpec, profile: String) -> Bool Never! {
    jet_cli_budget_axis_applies(spec.applicability.targets, "native", "Native") && jet_cli_budget_axis_applies(spec.applicability.profiles, profile, jet_cli_budget_title(profile))
}

// `word` with its first ASCII letter upper-cased: the spelling a budget's
// applicability writes a profile or target variant in (`Dev`, `Native`).
jet_cli_budget_title: fn(word: String) -> String Never! {
    bytes := word.bytes()
    if bytes.len() > 0 && bytes[0] >= 97 && bytes[0] <= 122 -> bytes[0] = bytes[0] - 32
    // copy: an unchanged word when its bytes are not text.
    String.from_bytes(bytes) ?? word.copy()
}

jet_cli_budget_axis_applies: fn(axis: BudgetAxis, current: String, title: String) -> Bool Never! {
    if axis == .Only(values) {
        loop value in values {
            if sema_budget_ascii_lower(value) == current || value.contains(title) -> return true
        }
        return false
    }
    true
}

// The measurement and projection over the applicable specs `active`:
// the toolchain identity first, then each CompilerProbe workload resolved
// and each ServiceProbe service's readiness collected, then the refusal of
// what this `jet` can't measure, then the selected artifact built when a
// BuildArtifact budget sizes it, then the report, published immutably.
// Sema admits only the closed provider set, so every provider here is one
// `jet budget` knows. `profile` is the measured compile's.
jet_cli_budget_check: fn(options: JetCLIBudgetOptions, root: String, entry: String, active: [JetDriverBudgetSpec], facts: JetDriverBudgetFacts, sources: [JetCLIBudgetSource], measured_start: String, profile: String, color: Bool) -> JetDriverVerbOutput {
    ordered := active
    ordered = loop fresh in ordered -> fresh
    ordered.sort_by((left: JetDriverBudgetSpec, right: JetDriverBudgetSpec) -> left.spec.name <=> right.spec.name)
    toolchain: jet_cli_budget_toolchain(entry) ?? return jet_cli_budget_tool_failure(options, err.message, color)
    loop row in ordered {
        if sema_budget_provider_kind(row.spec.provider) == "CompilerProbe" {
            jet_cli_budget_compile_workload(root, row.spec, profile) ?? return jet_cli_budget_tool_failure(options, err.message, color)
        }
    }
    services := [JetCLIBudgetService]{}
    loop row in ordered {
        if sema_budget_provider_kind(row.spec.provider) != "ServiceProbe" -> next
        name: sema_budget_provider_identity(row.spec.provider) ?? ""
        collected := false
        loop service in services {
            if service.name == name -> collected = true
        }
        if collected -> next
        service: jet_cli_budget_service(root, name) ?? return jet_cli_budget_tool_failure(options, err.message, color)
        services.push(service)
    }
    sized := false
    loop row in ordered {
        kind: sema_budget_provider_kind(row.spec.provider)
        metric: sema_budget_provider_kind(row.spec.metric)
        if kind == "BuildArtifact" {
            if metric != "BinarySize" && metric != "ArtifactSize" -> return jet_cli_report_output("", "E2104", "`jet budget` can't measure budget `{row.spec.name}` yet: its `BuildArtifact` provider measures only artifact size, not `{metric}`", jet_cli_why("E2104"), "remove the budget or measure it with a `jet` that runs the built artifact", color, JET_DRIVER_EXIT_USAGE)
            sized = true
        } else if kind != "CompilerFacts" && kind != "ServiceProbe" {
            return jet_cli_report_output("", "E2104", "`jet budget` can't measure budget `{row.spec.name}` yet: its `{kind}` provider is not built", jet_cli_why("E2104"), "remove the budget or measure it with a `jet` that has the `{kind}` provider", color, JET_DRIVER_EXIT_USAGE)
        }
        if row.spec.comparison_fact.baseline == .Val(baseline) -> return jet_cli_report_output("", "E2104", "`jet budget` can't measure budget `{row.spec.name}` yet: it compares against baseline `{baseline}`, and baseline history is not built", jet_cli_why("E2104"), "compare the budget with `Absolute`, or measure it with a `jet` that has baseline history", color, JET_DRIVER_EXIT_USAGE)
    }
    artifact := JetCLIBudgetArtifact?{None}
    if sized {
        built_artifact: jet_cli_budget_build_artifact(root, entry) ?? return jet_cli_budget_tool_failure(options, err.message, color)
        artifact = Val(built_artifact)
    }
    built: jet_cli_budget_build(root, ordered, facts, toolchain, sources, measured_start, profile, artifact, services) ?? return jet_cli_budget_tool_failure(options, err.message, color)
    report_path: ".jet/perf/reports/{built.report_id}.json"
    if options.command == "update" && (built.fail == 0 || options.accept_regression || options.bootstrap) -> return jet_cli_budget_update(options, root, built, report_path, color)
    created: jet_cli_budget_publish_report(root, built) ?? return jet_cli_budget_tool_failure(options, err.message, color)
    jet_cli_budget_emit(options, built, report_path, created)
}

// A CompilerProbe workload the resident compiler can't run, or whose edit
// patch is unreadable, is refused before anything is measured, so a report
// never records a workload that did not run.
jet_cli_budget_compile_workload: fn(root: String, spec: BudgetSpec, profile: String) JetCLIBudgetFailure! {
    workload: spec.compile_workload ?? return Err(jet_cli_budget_failure("CompilerProbe budget `{spec.name}` has no resolved workload"))
    if !(workload.mode == "Clean" || workload.mode == "NoChange" || workload.mode == "Edit") || workload.target == "" || profile == "" -> return Err(jet_cli_budget_failure("compile workload has an unsupported mode, empty target, or empty profile"))
    if workload.target != "cli" -> return Err(jet_cli_budget_failure("compile workload target `{workload.target}` is unsupported by the resident fixture compiler"))
    if !jet_cli_budget_compile_profile(root, profile) -> return Err(jet_cli_budget_failure("compile workload profile `{profile}` is unsupported by the resident fixture compiler"))
    if workload.mode == "Edit" && workload.patch == None -> return Err(jet_cli_budget_failure("CompileProbe Edit workload has no patch path"))
    if workload.mode != "Edit" && workload.patch != None -> return Err(jet_cli_budget_failure("only an Edit workload may name a patch path"))
    if workload.patch == .Val(patch) {
        if !sema_budget_safe_relative_path(patch) -> return Err(jet_cli_budget_failure("compile workload patch path is not project-relative"))
        segments: patch.split("/").to_list()
        parts := [String]{}
        loop index in 0..<segments.len() - 1 {
            parts.push(segments[index])
        }
        name: segments[segments.len() - 1]
        present: JetCLIRootedDirectory.present(root, parts) ?? return Err(jet_cli_budget_failure("compile workload patch is unavailable: {err.message}"))
        if !present -> return Err(jet_cli_budget_failure("compile workload patch is unavailable: `{patch}` is absent"))
        held: JetCLIRootedDirectory.open(root, parts, false) ?? return Err(jet_cli_budget_failure("compile workload patch is unavailable: {err.message}"))
        if held.read(name, JET_CLI_BUDGET_REPORT_LIMIT) == {
            .Val(_) -> {}
            .None -> { return Err(jet_cli_budget_failure("compile workload patch is unavailable: `{patch}` is absent")) }
            .Err(error) -> { return Err(jet_cli_budget_failure("cannot read compile workload patch: {error.message}")) }
        }
    }
}

// Whether `profile` is a stock profile, or one the package's `build` block
// declares.
jet_cli_budget_compile_profile: fn(root: String, profile: String) -> Bool {
    if profile == "dev" || profile == "release" || profile == "debug" || profile == "ci" || profile == "small" -> return true
    manifest: jet_cli_root_manifest(root) ?? return false
    loop declared in manifest.profiles {
        if declared.name == profile -> return true
    }
    false
}

// `jet budget update` over a report that may advance the baseline: the plan
// is shown first, and only `--yes`, or `y` at the prompt on a terminal,
// writes the report and advances the baseline.
jet_cli_budget_update: fn(options: JetCLIBudgetOptions, root: String, built: JetCLIBudgetBuilt, report_path: String, color: Bool) -> JetDriverVerbOutput {
    baseline: options.baseline ?? ""
    reason: options.reason ?? ""
    // copy: the options keep their reason.
    kind: if options.bootstrap -> JetCLIBudgetUpdateKind.Bootstrap(reason.copy()) else if options.accept_regression -> JetCLIBudgetUpdateKind.AcceptRegression(reason.copy()) else -> JetCLIBudgetUpdateKind.Pass
    plan: jet_cli_budget_plan_update(root, baseline, built.report, built.report_id, kind, jet_cli_rfc3339(cli_time.unix_ns())) ?? return jet_cli_budget_report_failure(options, built.report_id, "baseline plan refused: {err.message}", color)
    created: jet_cli_budget_report_created(root, built) ?? return jet_cli_budget_report_failure(options, built.report_id, "report inspection refused: {err.message}", color)
    if options.json {
        if options.yes {
            jet_cli_budget_accept(root, plan, built) ?? return jet_cli_budget_report_failure(options, built.report_id, err.message, color)
        }
        rows: [JetCLIStatusValue]{
            jet_cli_budget_plan_row(if created -> "create" else -> "reuse", "report", report_path, None, built.report_id),
            jet_cli_budget_plan_row("advance", "baseline", ".jet/perf/baselines/names/{baseline}.json", plan.prior_head_report_id, built.report_id),
        }
        planned: jet_cli_status_object([JetCLIStatusField]{
            jet_cli_status_field("baseline", jet_cli_status_text(baseline.copy())), // copy: the options keep their baseline.
            jet_cli_status_field("requires_confirmation", jet_cli_status_bool(false)),
            jet_cli_status_field("rows", jet_cli_status_array(rows)),
        })
        return jet_cli_budget_json(options, built, report_path, planned, options.yes, JET_DRIVER_EXIT_OK)
    }
    old: plan.prior_head_report_id ?? "none"
    stderr := "{if created -> "+" else -> "~"} report {built.report_id}\n~ baseline {baseline} {old} -> {built.report_id}\n"
    interactive: budget_term.stdin().is_tty()
    apply := options.yes
    if !apply && interactive {
        // The plan precedes the prompt on the terminal.
        console := budget_term.stderr()
        console.write(stderr).drop("budget plan")
        stderr = ""
        apply = jet_cli_budget_confirm()
    }
    if apply {
        if jet_cli_budget_accept(root, plan, built) == .Err(failure) {
            refused: jet_cli_budget_report_failure(options, built.report_id, failure.message, color)
            return JetDriverVerbOutput{stdout: refused.stdout, stderr: "{stderr}{refused.stderr}", exit_code: refused.exit_code}
        }
    } else if interactive {
        stderr = "{stderr}plan cancelled; no baseline changed\n"
    } else {
        stderr = "{stderr}plan only; pass -y or --yes to apply in a non-interactive shell\n"
    }
    JetDriverVerbOutput{stdout: "", stderr: stderr, exit_code: JET_DRIVER_EXIT_OK}
}

// The terminal confirmation: `y` or `yes`, in any case, applies.
jet_cli_budget_confirm: fn() -> Bool {
    console := budget_term.stderr()
    console.write("Apply? [y/N] ").drop("budget prompt")
    input := budget_term.stdin()
    answer: input.read_line() ?? ""
    word: sema_budget_ascii_lower(answer.trim())
    word == "y" || word == "yes"
}

// One row of the update plan: what is written where, and the head it moves from.
jet_cli_budget_plan_row: fn(operation: String, artifact: String, path: String, from_id: String?, id: String) -> JetCLIStatusValue Never! {
    // copy: the plan keeps its prior head and the report its id.
    from_value: if from_id == .Val(prior) -> jet_cli_status_text(prior.copy()) else -> JetCLIStatusValue.Null
    jet_cli_status_object([JetCLIStatusField]{
        jet_cli_status_field("artifact", jet_cli_status_text(artifact)),
        jet_cli_status_field("from_id", from_value),
        jet_cli_status_field("id", jet_cli_status_text(id.copy())),
        jet_cli_status_field("operation", jet_cli_status_text(operation)),
        jet_cli_status_field("path", jet_cli_status_text(path.copy())),
        jet_cli_status_field("to_id", jet_cli_status_text(id.copy())),
    })
}

// The report, published immutably; true when this run created it, false
// when an identical report was already there.
jet_cli_budget_publish_report: fn(root: String, built: JetCLIBudgetBuilt) -> Bool JetCLIBudgetFailure! {
    held: JetCLIRootedDirectory.open(root, [String]{".jet", "perf", "reports"}, true) ?? return Err(jet_cli_budget_failure("report write refused: {err.message}"))
    created: held.publish_immutable("{built.report_id}.json", built.bytes, None, JET_CLI_BUDGET_REPORT_LIMIT) ?? return Err(jet_cli_budget_failure("report write refused: {err.message}"))
    Ok(created)
}

// Whether publishing the report would create it.
jet_cli_budget_report_created: fn(root: String, built: JetCLIBudgetBuilt) -> Bool JetCLIBudgetFailure! {
    parts: [String]{".jet", "perf", "reports"}
    present: JetCLIRootedDirectory.present(root, parts) ?? return Err(jet_cli_budget_failure(err.message))
    if !present -> return Ok(true)
    held: JetCLIRootedDirectory.open(root, parts, false) ?? return Err(jet_cli_budget_failure(err.message))
    if held.read("{built.report_id}.json", JET_CLI_BUDGET_REPORT_LIMIT) == {
        .Val(existing) -> Ok(existing != built.bytes)
        .None -> Ok(true)
        .Err(error) -> Err(jet_cli_budget_failure(error.message))
    }
}

// The report, then the baseline advanced to it.
jet_cli_budget_accept: fn(root: String, plan: JetCLIBudgetUpdatePlan, built: JetCLIBudgetBuilt) JetCLIBudgetFailure! {
    _: jet_cli_budget_publish_report(root, built) ?? return Err(err)
    jet_cli_budget_apply_update(root, plan, built.report, built.bytes) ?? return Err(jet_cli_budget_failure("baseline apply refused: {err.message}"))
}

// The report subject: the measured member sources, sorted, the built
// artifact (Null when no budget sizes one), the profile, and the target.
jet_cli_budget_subject: fn(root: String, sources: [JetCLIBudgetSource], measured_start: String, measured_end: String, profile: String, artifact: CanonicalJSON) -> CanonicalJSON {
    ordered := sources
    ordered = loop fresh in ordered -> fresh
    ordered.sort_by((left: JetCLIBudgetSource, right: JetCLIBudgetSource) -> if left.path == right.path -> left.sha256 <=> right.sha256 else -> left.path <=> right.path)
    members: loop source in ordered -> perf_report_object_new([CanonicalJSONField]{
        CanonicalJSONField{key: "path", value: CanonicalJSON.String(source.path.copy())},
        CanonicalJSONField{key: "sha256", value: CanonicalJSON.String(source.sha256.copy())},
    })
    target_id: jet_cli_budget_package(root)
    perf_report_object_new([CanonicalJSONField]{
        CanonicalJSONField{key: "artifact", value: artifact},
        CanonicalJSONField{key: "measured_end", value: CanonicalJSON.String(measured_end)},
        CanonicalJSONField{key: "measured_start", value: CanonicalJSON.String(measured_start)},
        CanonicalJSONField{key: "member_sources", value: CanonicalJSON.Array(members)},
        CanonicalJSONField{key: "profile", value: CanonicalJSON.String(profile)},
        CanonicalJSONField{key: "target_class", value: CanonicalJSON.String("native")},
        CanonicalJSONField{key: "target_id", value: CanonicalJSON.String(target_id)},
        CanonicalJSONField{key: "target_triple", value: CanonicalJSON.String(jet_cli_host_triple(cli_sys.arch(), cli_sys.name()))},
    })
}

// The toolchain identity: the running compiler's SHA-256, this `jet`'s
// version, the runtime pack it links and the Core sources it compiles, and
// their digest. History taken under another toolchain is not comparable.
jet_cli_budget_toolchain: fn(entry: String) -> CanonicalJSON JetCLIBudgetFailure! {
    executable: cli_sys.executable()
    compiler_bytes: cli_files.read_bytes(executable) ?? return Err(jet_cli_budget_failure("jet cannot hash running compiler executable `{executable}`: {jet_cli_io_error_text(err)}"))
    runner: jet_cli_runtime_key(jet_cli_runtime_dir()) ?? return Err(jet_cli_budget_failure("cannot identify the runtime pack beside the running compiler"))
    stdlib: jet_cli_budget_stdlib_id(entry) ?? return Err(jet_cli_budget_failure("cannot hash the Core sources of this toolchain"))
    fields: [CanonicalJSONField]{
        CanonicalJSONField{key: "compiler_build_id", value: CanonicalJSON.String(budget_crypto.sha256(compiler_bytes).hex())},
        CanonicalJSONField{key: "jet_version", value: CanonicalJSON.String(JET_VERSION)},
        CanonicalJSONField{key: "runner_id", value: CanonicalJSON.String(runner)},
        CanonicalJSONField{key: "stdlib_id", value: CanonicalJSON.String(stdlib)},
    }
    digest: perf_stable_id(perf_report_object_new(fields.copy()))
    with_digest := fields
    with_digest.push(CanonicalJSONField{key: "digest", value: CanonicalJSON.String(digest)})
    Ok(perf_report_object_new(with_digest))
}

// The Core sources this toolchain compiles, each path and its bytes framed,
// hashed together; None when a source can't be read.
jet_cli_budget_stdlib_id: fn(entry: String) -> String? {
    toolchain: if jet_cli_toolchain_root(entry) == {
        .Found(root) -> root
        .Missing(_, _) -> { return None }
    }
    framed := [U8]{}
    loop row in CORE_SOURCE_OWNED_ROWS {
        bytes: cli_files.read_bytes(jet_cli_authority_path(toolchain, row.path)) ?? return None
        jet_cli_receipt_frame(framed, row.path.bytes())
        jet_cli_receipt_frame(framed, bytes)
    }
    Val(budget_crypto.sha256(framed).hex())
}

// The report's privacy statement: what it retains, and that it records
// workspace-relative paths only.
jet_cli_budget_privacy: fn() -> CanonicalJSON Never! {
    perf_report_object_new([CanonicalJSONField]{
        CanonicalJSONField{key: "excluded", value: CanonicalJSON.Array([CanonicalJSON]{})},
        CanonicalJSONField{key: "retained", value: CanonicalJSON.Array([CanonicalJSON]{CanonicalJSON.String("typed measurements"), CanonicalJSON.String("workspace source hashes")})},
        CanonicalJSONField{key: "schema", value: CanonicalJSON.Integer("1")},
        CanonicalJSONField{key: "workspace_paths_only", value: CanonicalJSON.Bool(true)},
    })
}

// A canonical value as a status value; integers keep their exact digits.
jet_cli_budget_status_value: fn(value: CanonicalJSON) -> JetCLIStatusValue Never! {
    if value == {
        .Null -> JetCLIStatusValue.Null
        .Bool(flag) -> jet_cli_status_bool(flag)
        .Integer(digits) -> JetCLIStatusValue.Float{text: digits.copy()}
        .String(text) -> jet_cli_status_text(text.copy())
        .Array(values) -> jet_cli_status_array(loop item in values -> jet_cli_budget_status_value(item))
        .Object(fields) -> jet_cli_status_object(loop field in fields -> jet_cli_status_field(field.key.copy(), jet_cli_budget_status_value(field.value)))
    }
}

// The `budget` status of a run that produced no report.
jet_cli_budget_failed_status: fn(command: String, diagnostics: [String], failure_kind: String) -> String Never! {
    reports: loop report in diagnostics -> JetCLIStatusValue.Float{text: report.copy()}
    budget: jet_cli_status_object([JetCLIStatusField]{
        jet_cli_status_field("applied", jet_cli_status_bool(false)),
        jet_cli_status_field("diagnostics", jet_cli_status_array(reports)),
        jet_cli_status_field("exit_code", jet_cli_status_int(JET_DRIVER_EXIT_USER_ERROR)),
        jet_cli_status_field("failure_kind", jet_cli_status_text(failure_kind)),
        jet_cli_status_field("plan", JetCLIStatusValue.Null),
        jet_cli_status_field("report", JetCLIStatusValue.Null),
        jet_cli_status_field("report_path", JetCLIStatusValue.Null),
        jet_cli_status_field("results", jet_cli_status_array([JetCLIStatusValue]{})),
    })
    "{jet_cli_status_render(command, false, [JetCLIStatusField]{jet_cli_status_field("budget", budget)})}\n"
}

// The entry's check failed before any budget ran.
jet_cli_budget_compiler_failure: fn(options: JetCLIBudgetOptions, entry: String, diagnostics: [Diagnostic], color: Bool) -> JetDriverVerbOutput {
    source: cli_files.read(entry) ?? ""
    if options.json {
        base: jet_cli_report_base(entry)
        reports: loop diagnostic in diagnostics -> jet_cli_report_json(diagnostic, base, entry, source, 0)
        return JetDriverVerbOutput{stdout: jet_cli_budget_failed_status(options.command, reports, "compiler"), stderr: "", exit_code: JET_DRIVER_EXIT_USER_ERROR}
    }
    JetDriverVerbOutput{stdout: "", stderr: diagnostic_render_all(entry, source, diagnostics, color), exit_code: JET_DRIVER_EXIT_USER_ERROR}
}

// A tool failure: E2908 before a valid report was produced.
jet_cli_budget_tool_failure: fn(options: JetCLIBudgetOptions, why: String, color: Bool) -> JetDriverVerbOutput Never! {
    jet_cli_budget_failure_output(options, why, "budget command failed before a valid report was produced", color)
}

// A tool failure after the report `report_id` was built but before it was
// accepted: E2908 naming the unaccepted report.
jet_cli_budget_report_failure: fn(options: JetCLIBudgetOptions, report_id: String, why: String, color: Bool) -> JetDriverVerbOutput Never! {
    jet_cli_budget_failure_output(options, why, "budget command failed · report {report_id} was not accepted", color)
}

jet_cli_budget_failure_output: fn(options: JetCLIBudgetOptions, why: String, summary: String, color: Bool) -> JetDriverVerbOutput Never! {
    diagnostic: diagnostic_from_registry("E2908", None, "performance budget operation failed", why, "correct the named failure and retry")
    if options.json {
        report: jet_cli_report_json(diagnostic, None, "", "", 0)
        return JetDriverVerbOutput{stdout: jet_cli_budget_failed_status(options.command, [String]{report}, "tool"), stderr: "", exit_code: JET_DRIVER_EXIT_USER_ERROR}
    }
    JetDriverVerbOutput{stdout: "", stderr: "{diagnostic_render_all("", "", [Diagnostic]{diagnostic}, color)}{summary}\n", exit_code: JET_DRIVER_EXIT_USER_ERROR}
}
