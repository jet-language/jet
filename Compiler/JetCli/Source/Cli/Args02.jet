// Rust: Source/ProveReplay.rs:1813
fn parse_recorded_act_payload(payload: String, sequence: U64) -> RecordedAct Err! {
    value :: parse_json(payload) ?? return Err("recorded act payload is not valid JSON")
    canonical :: canonical_json_value(&value)
    if canonical != payload -> return Err("recorded act payload is not canonical JSON")
    root :: if value == { .Object(object) -> object else -> return Err("recorded act payload must be an object") }
    require_object_keys(root, "recorded act payload", ["function", "line", "locals"], ["function", "line", "locals"])
    function :: object_field(root, "function").and_then(value -> value.as_str().ok()) ?? return Err("recorded act function must be a string")
    if function.is_empty() -> return Err("recorded act function is empty")
    line :: if object_field(root, "line") == {
        .Val(.Int(n)) -> {
            // GATE #4483: usize conversion follows selected-target width.
            if n < 0 || (n as U64) > target.usize_max() -> return Err("recorded act line is invalid")
            n as Int
        }
        else -> return Err("recorded act line must be an integer")
    }
    if line == 0 -> return Err("recorded act line must be at least 1")
    locals_value :: object_field(root, "locals") ?? return Err("recorded act locals are missing")
    locals :: if locals_value == { .Array(items) -> items else -> return Err("recorded act locals must be an array") }
    if locals.len() > 100_000 -> return Err("recorded act has too many locals")
    snapshots := [ValueSnapshot].with_capacity(locals.len())
    loop local_value in locals {
        local :: if local_value == { .Object(object) -> object else -> return Err("recorded act local must be an object") }
        require_object_keys(local, "recorded act local", ["name", "type", "value"], ["name", "type", "value"])
        name :: object_field(local, "name").and_then(value -> value.as_str().ok()) ?? return Err("recorded act local name must be a string")
        type_name :: object_field(local, "type").and_then(value -> value.as_str().ok()) ?? return Err("recorded act local type must be a string")
        text :: object_field(local, "value").and_then(value -> value.as_str().ok()) ?? return Err("recorded act local value must be a string")
        if name.is_empty() || type_name.is_empty() -> return Err("recorded act local name and type must be non-empty")
        &snapshots.push(ValueSnapshot{name: name.to_string(), type_name: type_name.to_string(), value: text.to_string()})
    }
    Ok(RecordedAct{sequence: sequence, function: function.to_string(), line: line, locals: ^snapshots})
}
// Rust: Source/ProveReplay.rs:1891
fn time_ms_from_payload(payload: String) -> I64 Err! {
    value :: parse_json(payload) ?? return Err("Time payload is not valid JSON")
    root :: if value == { .Object(object) -> object else -> return Err("Time payload must be an object") }
    ns_value :: object_field(root, "unix_ns") ?? return Err("Time payload is missing unix_ns")
    unix_ns :: if ns_value == { .Object(object) -> object else -> return Err("Time payload unix_ns must be an object") }
    text :: object_field(unix_ns, "v").and_then(value -> value.as_str().ok()) ?? return Err("Time payload unix_ns value is invalid")
    ns :: parse_canonical_u64(text)
    I64.try_from(ns / 1_000_000) ?? return Err("Time value exceeds the signed millisecond range")
}
// Rust: Source/ProveReplay.rs:1909
fn validate_time_payload(payload: String) -> Err! {
    value :: parse_json(payload) ?? return Err("Time payload is not valid JSON")
    canonical :: canonical_json_value(&value)
    if canonical != payload -> return Err("Time payload is not canonical JSON")
    root :: if value == { .Object(object) -> object else -> return Err("Time payload must be an object") }
    loop (key, _) in root {
        if !["call_id", "site_id", "unix_ns"].contains(key) -> return Err("Time payload has unknown field `{key}`")
    }
    if object_field(root, "call_id") != Val(DataTree.Int(0)) -> return Err("Time payload call_id is invalid")
    site :: object_field(root, "site_id").and_then(value -> value.as_str().ok()) ?? return Err("Time payload site_id is invalid")
    if site.len() != 64 || !site.bytes().all(byte -> byte.is_ascii_hexdigit() && !byte.is_ascii_uppercase()) || !site.bytes().any(byte -> byte != (U8{48})) {
        return Err("Time payload site_id is invalid")
    }
    ns_value :: object_field(root, "unix_ns") ?? return Err("Time payload is missing unix_ns")
    unix_ns :: if ns_value == { .Object(object) -> object else -> return Err("Time payload unix_ns must be an object") }
    require_object_keys(unix_ns, "Time payload unix_ns", ["bits", "t", "v"], ["bits", "t", "v"])
    if object_field(unix_ns, "bits") != Val(DataTree.Int(64)) || object_field(unix_ns, "t").and_then(value -> value.as_str().ok()) != Val("int") {
        return Err("Time payload unix_ns type is invalid")
    }
    text :: object_field(unix_ns, "v").and_then(value -> value.as_str().ok()) ?? return Err("Time payload unix_ns value is invalid")
    _ :: parse_canonical_u64(text) ?? return Err("Time payload unix_ns value is invalid")
    Ok()
}
// Rust: Source/ProveReplay.rs:1960
fn parse_canonical_u64(value: String) -> U64 Err! {
    if value.is_empty() -> return Err("empty unsigned integer")
    // All-digit fixed width hex is disambiguated by a leading zero.
    if value.len() == 16 && value.starts_with('0') && value.bytes().all(byte -> byte.is_ascii_hexdigit() && !byte.is_ascii_uppercase()) {
        hexadecimal :: U64.from_str_radix(value, 16) ?? return Err("unsigned integer is out of range")
        if hexadecimal <= MAX_EXACT_JSON_INTEGER -> return Err("small unsigned integer must use minimal decimal")
        return Ok(hexadecimal)
    }
    if value.bytes().all(byte -> byte.is_ascii_digit()) {
        if value.len() > 1 && value.starts_with('0') -> return Err("unsigned integer has a leading zero")
        decimal :: U64.from_str_radix(value, 10) ?? return Err("unsigned integer is out of range")
        if decimal > MAX_EXACT_JSON_INTEGER -> return Err("large unsigned integer must use fixed-width hexadecimal")
        return Ok(decimal)
    }
    if value.len() != 16 || !value.bytes().all(byte -> byte.is_ascii_hexdigit() && !byte.is_ascii_uppercase()) {
        return Err("unsigned integer is not canonical")
    }
    hexadecimal :: U64.from_str_radix(value, 16) ?? return Err("unsigned integer is out of range")
    if hexadecimal <= MAX_EXACT_JSON_INTEGER -> return Err("small unsigned integer must use minimal decimal")
    Ok(hexadecimal)
}
// Rust: Source/ProveReplay.rs:2008
fn object_field(object: [(String, DataTree)], key: String) -> &DataTree? {
    loop (name, value) in object { if name == key -> return Val(&value) }
    None
}
// Rust: Source/ProveReplay.rs:2015
fn canonical_json_value(value: &DataTree) -> String Err! {
    if value == {
        .Null -> Ok("null")
        .Bool(v) -> Ok(v.to_string())
        .Int(v) -> Ok(v.to_string())
        .Float(v) -> { if !v.is_finite() -> return Err("JSON contains a non-finite number"); Ok(v.to_string()) }
        .Number(v) -> Ok(~v)
        .TypedText(v) -> Ok(json_str(v))
        .Text(v) -> Ok(json_str(v))
        .Bytes(values) -> Ok("[{values.iter().map(byte -> byte.to_string()).collect().join(",")}]")
        .Array(values) -> {
            rendered := [String].with_capacity(values.len())
            loop item in values { text :: canonical_json_value(&item); &rendered.push(text) }
            Ok("[{rendered.join(",")}]")
        }
        .Object(object) -> {
            entries := object.iter().collect()
            &entries.sort_by((left, right) -> left.0.cmp(right.0))
            rendered := [String].with_capacity(entries.len())
            loop (key, item) in entries {
                text :: canonical_json_value(&item)
                &rendered.push("{json_str(key)}:{text}")
            }
            Ok("\{{rendered.join(",")}\}")
        }
    }
}
// Rust: Source/ProveReplay.rs:2055
fn require_object_keys(object: [(String, DataTree)], object_name: String, required: [String], allowed: [String]) -> Err! {
    loop (key, _) in object { if !allowed.contains(key) -> return Err("{object_name} has unknown field `{key}`") }
    loop key in required { if object_field(object, key).is_none() -> return Err("{object_name} is missing `{key}`") }
    Ok()
}
// Rust: Source/ProveReplay.rs:2073
fn validate_mir_identity(value: String) -> Err! {
    parsed :: parse_json(value) ?? return Err("mir_identity is not valid JSON")
    canonical :: canonical_json_value(&parsed)
    if canonical != value -> return Err("mir_identity is not canonical JSON")
    object :: if parsed == { .Object(fields) -> fields else -> return Err("mir_identity must be a JSON object") }
    keys :: ["core_ids", "function_ids", "identity_digest", "optimized_hash", "schema", "semantic_hash", "source_map", "target_facts"]
    require_object_keys(object, "mir_identity", keys, keys)
    loop key in ["identity_digest", "optimized_hash", "semantic_hash"] {
        hash :: object_field(object, key).and_then(value -> value.as_str().ok()) ?? return Err("mir_identity `{key}` must be a string")
        if hash.len() != 64 || !hash.bytes().all(byte -> byte.is_ascii_hexdigit() && !byte.is_ascii_uppercase()) {
            return Err("mir_identity `{key}` is not lowercase SHA-256 hex")
        }
    }
    if object_field(object, "schema").and_then(value -> value.as_str().ok()) != Val(MIR_IDENTITY_SCHEMA) -> return Err("mir_identity schema is unsupported")
    loop key in ["core_ids", "function_ids", "source_map", "target_facts"] {
        if object_field(object, key) == { .Val(.Array(_)) -> {} else -> return Err("mir_identity `{key}` must be an array") }
    }
    Ok()
}
// Rust: Source/ProveReplay.rs:2131
fn flatten_identity_fields(header_text: String) -> [String:String] Err! {
    parsed :: parse_json(header_text) ?? return Err("header is not valid JSON")
    canonical :: canonical_json_value(&parsed)
    if canonical != header_text -> return Err("header is not canonical JSON")
    root :: if parsed == { .Object(fields) -> fields else -> return Err("header must be a JSON object") }
    keys :: ["artifact_id", "capture", "extensions", "identity", "limits", "privacy_salt", "producer", "run", "schema", "version"]
    require_object_keys(root, "header", keys, keys)
    out := [String:String]{}
    string_field :: (object: [(String, DataTree)], key: String) -> String Err! {
        text :: object_field(object, key).and_then(value -> value.as_str().ok()) ?? return Err("header field `{key}` must be a string")
        Ok(text.to_string())
    }
    loop key in ["schema", "artifact_id"] { text :: string_field(root, key); &out.insert(key, text) }
    identity_value :: object_field(root, "identity") ?? return Err("header missing identity object")
    identity :: if identity_value == { .Object(fields) -> fields else -> return Err("header identity must be an object") }
    const IDENTITY_KEYS: [String] = ["abi", "build_digest", "core_abi", "entry", "execution_adapter", "lock_digest", "mir_schema", "mir_identity", "optimized_mir_hash", "profile", "semantic_mir_hash", "source_digest", "time_site_id", "target_triple"]
    require_object_keys(identity, "header identity", IDENTITY_KEYS, IDENTITY_KEYS)
    loop key in IDENTITY_KEYS { _ :: string_field(identity, key) }
    loop key in ["build_digest", "lock_digest", "optimized_mir_hash", "semantic_mir_hash", "source_digest", "time_site_id"] {
        text :: string_field(identity, key)
        if text.len() != 64 || !text.bytes().all(byte -> byte.is_ascii_hexdigit() && !byte.is_ascii_uppercase()) {
            return Err("header identity `{key}` is not lowercase SHA-256 hex")
        }
    }
    entry :: string_field(identity, "entry")
    entry_path :: OSPath.from(entry)
    if entry.is_empty() || entry_path.is_absolute() || entry_path.components().any(component -> if component == {
        .CurDir -> true .ParentDir -> true .RootDir -> true .Prefix(_) -> true else -> false
    }) -> return Err("header identity entry is not project-relative")
    adapter :: string_field(identity, "execution_adapter")
    if adapter != "mir-v1" -> return Err("header execution adapter `{adapter}` is unsupported")
    mir_identity :: string_field(identity, "mir_identity")
    validate_mir_identity(mir_identity)
    loop key in ["abi", "core_abi", "mir_schema", "profile", "target_triple"] {
        text :: string_field(identity, key)
        if text.is_empty() -> return Err("header identity field `{key}` is empty")
    }
    schema :: string_field(identity, "mir_schema")
    if schema != MIR_IDENTITY_SCHEMA -> return Err("header identity MIR schema is unsupported")
    loop key in ["entry", "source_digest", "execution_adapter", "target_triple"] { text :: string_field(identity, key); &out.insert(key, text) }
    loop key in ["abi", "build_digest", "core_abi", "lock_digest", "mir_schema", "mir_identity", "optimized_mir_hash", "profile", "semantic_mir_hash", "time_site_id"] { text :: string_field(identity, key); &out.insert(key, text) }
    producer :: string_field(root, "producer")
    if producer != "jet-prove" -> return Err("header producer is not jet-prove")
    salt :: object_field(root, "privacy_salt").and_then(value -> value.as_str().ok()) ?? return Err("header privacy_salt is invalid")
    if !is_base64url_32(salt) -> return Err("header privacy_salt is invalid")
    if object_field(root, "extensions") == { .Val(.Object(_)) -> {} else -> return Err("header extensions must be an object") }
    capture_value :: object_field(root, "capture") ?? return Err("header missing capture object")
    capture :: if capture_value == { .Object(fields) -> fields else -> return Err("header capture must be an object") }
    require_object_keys(capture, "header capture", ["mode", "roots"], ["mode", "roots"])
    if object_field(capture, "mode").and_then(value -> value.as_str().ok()) != Val("safe") -> return Err("header capture mode is not safe")
    if object_field(capture, "roots") == {
        .Val(.Array(roots)) -> {
            if roots.len() != 1 || roots.first().and_then(value -> value.as_str().ok()) != Val("Time") -> return Err("header capture roots are not exactly [Time]")
        }
        else -> return Err("header capture roots are not exactly [Time]")
    }
    limits_value :: object_field(root, "limits") ?? return Err("header missing limits object")
    limits :: if limits_value == { .Object(fields) -> fields else -> return Err("header limits must be an object") }
    require_object_keys(limits, "header limits", ["frames", "payload_bytes"], ["frames", "payload_bytes"])
    if object_field(limits, "frames") != Val(DataTree.Int(100_000)) || object_field(limits, "payload_bytes") != Val(DataTree.Int(268_435_456)) -> return Err("header replay limits are invalid")
    run_value :: object_field(root, "run") ?? return Err("header missing run object")
    run :: if run_value == { .Object(fields) -> fields else -> return Err("header run must be an object") }
    require_object_keys(run, "header run", ["outcome", "status"], ["outcome", "status"])
    outcome :: object_field(run, "outcome").and_then(value -> value.as_str().ok()) ?? return Err("header run outcome is invalid")
    status :: if object_field(run, "status") == {
        .Val(.Int(n)) -> { if n < 0 || n > 255 -> return Err("header run status is invalid"); n }
        else -> return Err("header run status is invalid")
    }
    if outcome != "exit" && outcome != "panic" -> return Err("header run outcome is invalid")
    if (outcome == "panic") != (status == 70) -> return Err("header run outcome and status disagree")
    &out.insert("run_outcome", outcome.to_string())
    &out.insert("run_status", status.to_string())
    version_value :: object_field(root, "version") ?? return Err("header missing version object")
    version :: if version_value == { .Object(fields) -> fields else -> return Err("header version must be an object") }
    require_object_keys(version, "header version", ["major", "minor"], ["major", "minor"])
    if object_field(version, "major") != Val(DataTree.Int(1)) || object_field(version, "minor") != Val(DataTree.Int(0)) -> return Err("header version is incompatible")
    Ok(^out)
}
// Rust: Source/ProveReplay.rs:2382
fn zero_artifact_id_header(header_text: String) -> [U8] Err! {
    value := parse_json(header_text) ?? return Err("header is not valid JSON")
    if &value == {
        .Object(root) -> {
            valid_length :: object_field(root, "artifact_id").and_then(value -> value.as_str().ok()).is_some_and(id -> id.len() == 24)
            if !valid_length -> return Err("header artifact_id must be a string with the right length")
            found := false
            loop (key, artifact_id) in &root {
                if key == "artifact_id" { artifact_id = DataTree.Text("0".repeat(24)); found = true; break }
            }
            if !found -> return Err("header artifact_id must be a string")
        }
        else -> return Err("header must be a JSON object")
    }
    text :: canonical_json_value(&value)
    Ok(text.into_bytes())
}
// Rust: Source/ProveReplay.rs:2400
fn is_base64url_32(value: String) -> Bool {
    if value.len() != 43 -> return false
    buffer := U32{0}
    bits := U8{0}
    bytes := 0
    loop byte in value.bytes() {
        digit :: if byte >= (U8{65}) && byte <= (U8{90}) -> (byte - 65) as U32
            else if byte >= (U8{97}) && byte <= (U8{122}) -> (byte - 97 + 26) as U32
            else if byte >= (U8{48}) && byte <= (U8{57}) -> (byte - 48 + 52) as U32
            else if byte == (U8{45}) -> U32{62}
            else if byte == (U8{95}) -> U32{63}
            else -> return false
        buffer = (buffer << 6) | digit
        bits = bits + 6
        loop bits >= 8 {
            bits = bits - 8
            bytes = bytes + 1
            buffer = buffer & (if bits == 0 -> U32{0} else -> (U32{1} << bits) - 1)
        }
    }
    bytes == 32 && bits == 2 && buffer == 0
}
// Rust: Source/ProveReplay.rs:2427
fn identity_matches(header: &[String:String], identity: &ReplayIdentity) -> Err! {
    loop (key, expected) in [
        ("entry", identity.entry), ("source_digest", identity.source_digest), ("build_digest", identity.build_digest),
        ("lock_digest", identity.lock_digest), ("semantic_mir_hash", identity.semantic_mir_hash), ("optimized_mir_hash", identity.optimized_mir_hash),
        ("abi", identity.abi), ("core_abi", identity.core_abi), ("profile", identity.profile), ("mir_schema", identity.mir_schema),
        ("mir_identity", identity.mir_identity), ("execution_adapter", identity.execution_adapter), ("target_triple", identity.target_triple), ("time_site_id", identity.time_site_id)
    ] {
        if header.get(key) != Val(expected) -> return Err(key.to_string())
    }
    Ok()
}
// Rust: Source/ProveReplay.rs:2457
fn privacy_salt() -> String Err! {
    bytes := [U8].filled(32, U8{0})
    getrandom_fill(&bytes)
    Ok(base64url_unpadded(bytes))
}
// Rust: Source/ProveReplay.rs:2463
fn getrandom_fill(buf: &[U8]) -> Err! {
    // GATE #4483: selected target family, not the host running the compiler.
    if target.selected_family() == target.NativeTargetFamily.Unix {
        // GATE #4494: real native /dev/urandom file, exact read; fail closed.
        file := fs.File.open(OSPath.from("/dev/urandom")) ?? return Err(err.to_string())
        &file.read_exact(&buf) ?? return Err(err.to_string())
        return Ok()
    }
    Err("privacy_salt requires OS CSPRNG")
}
// Rust: Source/ProveReplay.rs:2479
fn base64url_unpadded(bytes: [U8]) -> String {
    const T: String = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789-_"
    table :: T.bytes()
    out := ""
    i := 0
    loop i + 3 <= bytes.len() {
        n :: ((bytes[i] as U32) << 16) | ((bytes[i + 1] as U32) << 8) | (bytes[i + 2] as U32)
        &out.push(table[((n >> 18) & 63) as Int] as Char)
        &out.push(table[((n >> 12) & 63) as Int] as Char)
        &out.push(table[((n >> 6) & 63) as Int] as Char)
        &out.push(table[(n & 63) as Int] as Char)
        i = i + 3
    }
    if i < bytes.len() {
        rem :: bytes.len() - i
        n := (bytes[i] as U32) << 16
        if rem == 2 -> n = n | ((bytes[i + 1] as U32) << 8)
        &out.push(table[((n >> 18) & 63) as Int] as Char)
        &out.push(table[((n >> 12) & 63) as Int] as Char)
        if rem == 2 -> &out.push(table[((n >> 6) & 63) as Int] as Char)
    }
    ^out
}
// Rust: Source/ProveReplay.rs:2506
enum Json { Str(value: String), Int(value: I64), Raw(value: String), Obj(fields: [(String, Json)]), Arr(items: [Json]) }
// Rust: Source/ProveReplay.rs:2513
fn canonical_json(fields: [(String, Json)]) -> String {
    pairs := fields.iter().map((key, value) -> (key.to_string(), clone_json(&value))).collect()
    &pairs.sort_by((a, b) -> a.0.cmp(b.0))
    render_obj(pairs)
}
// Rust: Source/ProveReplay.rs:2522
fn clone_json(v: &Json) -> Json {
    if v == {
        .Str(s) -> Json.Str(~s)
        .Int(n) -> Json.Int(n)
        .Raw(raw) -> Json.Raw(~raw)
        .Obj(fields) -> Json.Obj(fields.iter().map((key, value) -> (~key, clone_json(&value))).collect())
        .Arr(items) -> Json.Arr(items.iter().map(item -> clone_json(&item)).collect())
    }
}
// Rust: Source/ProveReplay.rs:2537
fn render_obj(fields: [(String, Json)]) -> String {
    out := "\{"
    loop i in 0..<fields.len() {
        if i > 0 -> &out.push(',')
        &out.push_str(json_str(fields[i].0))
        &out.push(':')
        &out.push_str(render_value(&fields[i].1))
    }
    &out.push('}')
    ^out
}
// Rust: Source/ProveReplay.rs:2551
fn render_value(v: &Json) -> String {
    if v == {
        .Str(s) -> json_str(s)
        .Int(n) -> n.to_string()
        .Raw(raw) -> ~raw
        .Obj(fields) -> {
            sorted := fields.iter().map((key, value) -> (~key, clone_json(&value))).collect()
            &sorted.sort_by((a, b) -> a.0.cmp(b.0))
            render_obj(sorted)
        }
        .Arr(items) -> {
            out := "["
            loop i in 0..<items.len() {
                if i > 0 -> &out.push(',')
                &out.push_str(render_value(&items[i]))
            }
            &out.push(']')
            ^out
        }
    }
}
// Rust: Source/ProveReplay.rs:2578
pub fn json_str(value: String) -> String {
    out := "\""
    loop ch in value.chars() {
        if ch == {
            '\\' -> &out.push_str("\\\\")
            '"' -> &out.push_str("\\\"")
            '\n' -> &out.push_str("\\n")
            '\r' -> &out.push_str("\\r")
            '\t' -> &out.push_str("\\t")
            else -> { if ch < ' ' { &out.push_str("\\u{ch as U32:04x}") } else { &out.push(ch) } }
        }
    }
    &out.push('"')
    ^out
}
