// Rust: Source/CmdCompile.rs:11989
pub fn write_web_artifacts(file: String, web: &WebArtifacts, ffi: FfiLink?, verbose: Bool, output: &WebOutputAuthority, incremental_session: &WebRustcIncrementalSession?, emit_maps: Bool, mode: OutputMode) -> WebBuildPaths Err! {
    step :: fn(msg: String) -> { if verbose -> write_mode_status(mode, "[build] {msg}\n") }
    output_path :: fn(name: String) -> OSPath Err! {
        output.path_for(name) ?? return Err("error: couldn't resolve web output `{name}`: {err}")
    }
    manifest_path :: output_path("web.manifest.json")?
    dom_path :: output_path("jet_dom_runtime.js")?
    js_path :: output_path("app.js")?
    js_map_path :: output_path("app.js.map")?
    wasm_rs_path :: output_path("app_wasm.rs")?
    wasm_path :: output_path("app.wasm")?
    wasm_map_path :: output_path("app.wasm.map")?
    html_path :: output_path("index.html")?
    // D-HTMLPAIR1: explicit marker, sibling HTML, then the generated page.
    html_contents := web.index_html.clone()
    if web.explicit_html_path == .Val(rel) {
        html_contents = read_web_html_source(file, OSPath.new(rel), true)? ?? return Err("error: `#HTML(\"{rel}\")` source is missing")
    } else {
        sibling :: OSPath.new(file).with_extension("html")
        if sibling.file_name() == .Val(name) -> html_contents = read_web_html_source(file, OSPath.new(name), false)? ?? web.index_html.clone()
    }
    manifest_json :: if emit_maps -> web.manifest_json.clone() else -> strip_manifest_source_map(web.manifest_json)
    js_app := web.js_app.clone()
    if emit_maps {
        if !js_app.ends_with("\n") -> &js_app.push('\n')
        &js_app.push_str("//# sourceMappingURL=app.js.map\n")
    }
    output.replace_file("web.manifest.json", manifest_json.bytes()) ?? return Err("error: couldn't write {manifest_path.display()}: {err}")
    output.replace_file("jet_dom_runtime.js", web.dom_runtime.bytes()) ?? return Err("error: couldn't write {dom_path.display()}: {err}")
    output.replace_file("app.js", js_app.bytes()) ?? return Err("error: couldn't write {js_path.display()}: {err}")
    output.replace_file("app_wasm.rs", web.wasm_rust.bytes()) ?? return Err("error: couldn't write {wasm_rs_path.display()}: {err}")
    output.replace_file("index.html", html_contents.bytes()) ?? return Err("error: couldn't write {html_path.display()}: {err}")
    js_map_written := OSPath?{None}
    if emit_maps {
        output.replace_file("app.js.map", web.js_source_map.bytes()) ?? return Err("error: couldn't write {js_map_path.display()}: {err}")
        js_map_written = .Val(js_map_path.clone())
        step("js map     -> {js_map_path.display()}")
    } else {
        output.remove_file_if_exists("app.js.map") ?? return Err("error: couldn't remove {js_map_path.display()}: {err}")
        output.remove_file_if_exists("app.wasm.map") ?? return Err("error: couldn't remove {wasm_map_path.display()}: {err}")
    }
    step("web manifest -> {manifest_path.display()}")
    step("dom shim    -> {dom_path.display()}")
    step("js entry    -> {js_path.display()}")
    step("wasm emit   -> {wasm_rs_path.display()}")
    step("index.html  -> {html_path.display()}")
    step("rustc wasm  {wasm_rs_path.display()} -> {wasm_path.display()}")
    wasm_temp :: output.create_temp_file("jet-web-rustc", ".wasm") ?? return Err("error: couldn't create a wasm temporary: {err}")
    wasm_temp_path :: wasm_temp.path().to_path_buf()
    rustc_profile_flags :: if emit_maps -> ["-C", "opt-level=0", "-C", "debuginfo=2"] else -> ["-O"]
    incremental_dir := OSPath?{None}
    if incremental_session == .Val(session) -> incremental_dir = .Val(session.prepare_dir(web.rustc_incremental_identity, emit_maps, ffi.is_some())?)
    runtime_flags := [OsString]{OsString.from("--target"), OsString.from("wasm32-unknown-unknown")}
    loop flag in rustc_profile_flags -> &runtime_flags.push(OsString.from(flag))
    inline_runtime :: fn() -> runtime.PreparedRuntime.inline(web.wasm_rust)
    prepared_runtime := inline_runtime()
    if ffi.is_none() {
        if Store.from_env() == .Ok(store) -> prepared_runtime = runtime.prepare(store, OsStr.new("rustc"), web.wasm_rust, runtime_flags, []) ?? inline_runtime()
    }
    prepared_source := None
    split_source_path := wasm_rs_path.clone()
    if prepared_runtime.is_split() {
        if incremental_dir == .Val(dir) {
            source_path :: dir.join("app_wasm.rs")
            fs.write(source_path, prepared_runtime.rust().bytes()) ?? return Err("error: couldn't write the prepared Web rustc source {source_path.display()}: {err}")
            split_source_path = source_path
        } else {
            source := output.create_temp_file("jet-web-rustc", ".rs") ?? return Err("error: couldn't create a prepared Wasm source: {err}")
            source.write_all(prepared_runtime.rust().bytes()) ?? return Err("error: couldn't write a prepared Wasm source: {err}")
            split_source_path = source.path().to_path_buf()
            prepared_source = .Val(^source)
        }
    }
    wasm_destination :: wasm_temp_path.to_str() ?? return Err("error: web wasm temporary path is not valid UTF-8: {wasm_temp_path.display()}")
    run_rustc :: fn(source_path: &OSPath, prepared: &runtime.PreparedRuntime?) -> std.process.Output Err! {
        wasm_source :: source_path.to_str() ?? return Err("error: web source path is not valid UTF-8: {source_path.display()}")
        // GATE #4494: native process creation and OS-string arguments.
        rustc := Command.new("rustc")
        &rustc.args(["--edition", "2021", "--target", "wasm32-unknown-unknown", "--crate-type", "cdylib", "--crate-name"])
        &rustc.arg(sanitize_crate_name(wasm_rs_path.file_stem().and_then(fn(name) -> name.to_str()) ?? "out"))
        &rustc.args(rustc_profile_flags)
        if incremental_dir == .Val(dir) -> &rustc.arg("-C").arg("incremental={dir.display()}")
        if prepared == .Val(value) -> value.add_rustc_args(&rustc)
        &rustc.args([wasm_source, "-o", wasm_destination])
        if ffi == .Val(link) {
            &rustc.arg("--extern").arg("{link.crate_name}={link.rlib_path.display()}")
            loop deps_dir in link.dependency_dirs() {
                if deps_dir.is_dir() -> &rustc.arg("-L").arg("dependency={deps_dir.display()}")
            }
        }
        rustc.output() ?? return Err("error: couldn't run rustc for wasm: {err}")
    }
    used_split := prepared_runtime.is_split()
    rustc := run_rustc(split_source_path, if used_split -> .Val(&prepared_runtime) else -> None)?
    if !rustc.status.success() && used_split {
        if verbose -> step("runtime split bypassed (inline retry)")
        used_split = false
        rustc = run_rustc(wasm_rs_path, None)?
    }
    if !rustc.status.success() -> return Err(render_ice_report("rustc rejected generated wasm module", String.from_utf8_lossy(rustc.stderr), true))
    if used_split {
        status :: if prepared_runtime.cache_hit() -> "reused invariant wasm modules" else -> "stored invariant wasm modules"
        step("runtime   -> {status}")
    }
    // rustc may replace the inode; reopen its output path.
    wasm := fs.read(wasm_temp_path) ?? return Err("error: couldn't read {wasm_temp_path.display()}: {err}")
    CLISchema.embed_wasm_record(&wasm, web.command_record) ?? return Err("error: couldn't embed JetCommandSchema metadata: {err}")
    wasm_map_written := OSPath?{None}
    if emit_maps {
        wasm_map :: jet.Codegen.build_wasm_jet_source_map(wasm, web.wasm_rust, web.source_names, web.source_contents) ?? return Err("error: couldn't build app.wasm.map: {err}")
        output.replace_file("app.wasm.map", wasm_map.bytes()) ?? return Err("error: couldn't write {wasm_map_path.display()}: {err}")
        WasmDebug.embed_source_mapping_url(&wasm, "app.wasm.map") ?? return Err("error: couldn't embed wasm sourceMappingURL: {err:?}")
        wasm_map_written = .Val(wasm_map_path.clone())
        step("wasm map   -> {wasm_map_path.display()}")
    }
    output.replace_file("app.wasm", wasm) ?? return Err("error: couldn't write {wasm_path.display()}: {err}")
    WebBuildPaths{manifest: manifest_path, dom: dom_path, js: js_path, js_map: js_map_written, wasm: wasm_path, wasm_map: wasm_map_written, html: html_path}
}

// Rust: Source/CmdCompile.rs:12294
fn read_web_html_source(file: String, relative: &OSPath, required: Bool) -> String? Err! {
    source_dir :: OSPath.new(file).parent().filter(fn(parent) -> !parent.as_os_str().is_empty()) ?? OSPath.new(".")
    source_path :: source_dir.join(relative)
    resolver :: AuthorityResolver.open(source_dir) ?? return Err("error: couldn't open the pinned HTML source directory `{source_dir.display()}`: {err}")
    checked :: resolver.checked_file(relative) ?? {
        if !required && err.is_missing() -> return None
        if required && err.is_missing() -> return Err("error: `#HTML(\"{relative.display()}\")` names a file that doesn't exist: {source_path.display()} ({err})")
        return Err("error: HTML source `{source_path.display()}` is not a safe source-relative regular file: {err}")
    }
    resolver.revalidate_file(checked) ?? return Err("error: HTML source `{source_path.display()}` changed during its pinned read: {err}")
    text :: checked.text() ?? return Err("error: HTML source `{source_path.display()}` is not valid UTF-8: {err}")
    .Val(text)
}

