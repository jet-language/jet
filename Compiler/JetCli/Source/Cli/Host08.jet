fn foreign_build_import.candidate_json(candidate: &ForeignBuildCandidate) -> String {
    actions :: candidate.actions.iter().map(fn(action) -> foreign_build_import.action_json(action)).collect().join(",")
    dependencies :: candidate.inputs.iter().map(fn(pair) -> pair.0).collect()
    inputs :: candidate.inputs.iter().map(fn(pair) -> "{{\"path\":\"{json_escape(pair.0)}\",\"digest\":\"{json_escape(pair.1)}\"}}").collect().join(",")
    "{{\n  \"schema\":\"{CANDIDATE_SCHEMA}\",\n  \"selection_key\":\"{json_escape(candidate.key)}\",\n  \"kind\":\"cmake\",\n  \"build_dir\":\"{json_escape(candidate.build_dir)}\",\n  \"ownership\":\"{json_escape(candidate.ownership)}\",\n  \"argv\":[{foreign_build_import.json_strings(candidate.argv)}],\n  \"dependencies\":[{foreign_build_import.json_strings(dependencies)}],\n  \"inputs\":[{inputs}],\n  \"outputs\":[{foreign_build_import.json_strings(candidate.outputs)}],\n  \"toolchains\":[{foreign_build_import.json_pairs(candidate.toolchains)}],\n  \"environment\":[{foreign_build_import.json_pairs(candidate.environment)}],\n  \"workdirs\":[{foreign_build_import.json_strings(candidate.workdirs)}],\n  \"actions\":[{actions}],\n  \"unsupported_edges\":[{foreign_build_import.json_strings(candidate.unsupported)}]\n}}\n"
}
