fn foreign_build_import.build_candidate(root: &OSPath, request: &ForeignBuildRequest) -> (OSPath, ForeignBuildCandidate, String) ForeignBuildFailure! {
    if request.kind != "cmake" -> return Err(.User("unsupported foreign build importer `{request.kind}`; only `cmake:build` is currently supported"))
    source_bytes :: foreign_build_import.read_regular(root, "CMakeLists.txt")?
