fn foreign_build_import.relative_path(value: String) -> OSPath ForeignBuildFailure! {
    path :: OSPath.new(value)
    invalid := path.is_absolute()
    loop component in path.components() {
        if component == {
            .ParentDir -> invalid = true
            .RootDir -> invalid = true
            .Prefix(_) -> invalid = true
            _ -> {}
        }
    }
    if invalid -> return Err(.User("foreign build path `{value}` must be relative to the project"))
    path.to_path_buf()
}
// Rust: Source/CmdCompile.rs:12427
fn foreign_build_import.display_relative(path: &OSPath) -> String { path.to_string_lossy().replace("\\", "/") }
// Rust: Source/CmdCompile.rs:12431
fn foreign_build_import.ensure_directory(path: &OSPath) -> Void ForeignBuildFailure! {
    // GATE #4409: preserve NotFound and AlreadyExists distinctions.
    metadata :: fs.symlink_metadata(path) ?? {
        if err.kind() != .NotFound -> return Err(.Internal("could not inspect `{path.display()}`: {err}"))
        if path.parent() == .Val(parent) -> foreign_build_import.ensure_directory(parent)?
        fs.create_dir(path) ?? {
            if err.kind() == .AlreadyExists -> return foreign_build_import.ensure_directory(path)
            return Err(.Internal("could not create `{path.display()}`: {err}"))
        }
        return
    }
    if metadata.file_type().is_symlink() -> return Err(.Internal("refusing symlinked directory `{path.display()}`"))
    if metadata.is_dir() -> return
    Err(.Internal("foreign build cache path `{path.display()}` is not a directory"))
}
// Rust: Source/CmdCompile.rs:12464
fn foreign_build_import.read_regular(root: &OSPath, relative: String) -> [U8] ForeignBuildFailure! {
    relative_path :: foreign_build_import.relative_path(relative)?
    path :: root.join(relative_path)
    metadata :: fs.symlink_metadata(path) ?? return Err(.User("foreign build input `{relative}` is unavailable: {err}"))
    if metadata.file_type().is_symlink() || !metadata.is_file() -> return Err(.User("foreign build input `{relative}` must be a regular non-symlink file"))
    fs.read(path) ?? return Err(.User("could not read foreign build input `{relative}`: {err}"))
