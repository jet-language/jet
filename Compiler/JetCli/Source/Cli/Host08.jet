// Rust: Source/CmdCompile.rs:12665
fn foreign_build_import.custom_outputs(build_dir: String, calls: &[[String]]) -> [String] {
    outputs := [String]{}
    loop args in calls {
        key := String?{None}
        loop value in args {
            if key == .Val("OUTPUT") || key == .Val("BYPRODUCTS") {
                if !value.starts_with("$") && !OSPath.new(value).is_absolute() -> &outputs.push("{build_dir}/{value}")
                key = None
            } else if value == "OUTPUT" || value == "BYPRODUCTS" -> key = .Val(value)
        }
    }
    outputs
}
