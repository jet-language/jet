// Rust: Source/CmdCompile.rs:12697
fn foreign_build_import.write_atomic(path: &OSPath, bytes: [U8]) -> Void ForeignBuildFailure! {
    parent :: path.parent() ?? return Err(.Internal("candidate `{path.display()}` has no parent"))
    foreign_build_import.ensure_directory(parent)?
    digest :: sha256_hex(bytes).get(0..<16) ?? "candidate"
    // GATE #4494: process identity, exclusive creation, fsync and rename.
    temporary :: parent.join(".foreign-build-{std.process.id()}-{digest}.tmp")
    result :: fn() -> Void ForeignBuildFailure! {
        file := fs.OpenOptions.new().write(true).create_new(true).open(temporary) ?? return Err(.Internal("could not stage candidate: {err}"))
        file.write_all(bytes) ?? return Err(.Internal("could not write candidate: {err}"))
        file.sync_all() ?? return Err(.Internal("could not sync candidate: {err}"))
        if fs.symlink_metadata(path) == .Ok(metadata) {
            if metadata.file_type().is_symlink() || metadata.is_dir() -> return Err(.Internal("candidate destination `{path.display()}` is not replaceable"))
        }
        fs.rename(temporary, path) ?? return Err(.Internal("could not publish candidate: {err}"))
    }()
    if result.is_err() -> _ :: fs.remove_file(temporary)
    result
}
