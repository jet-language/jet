// Rust: Source/CmdCompile.rs:13137
fn foreign_build_import.load_candidate(root: &OSPath, request: &ForeignBuildRequest, expected_digest: String?) -> (DataTree, String, OSPath) ForeignBuildFailure! {
    path :: foreign_build_import.candidate_path(root, "{request.kind}:{request.build_dir}")
    metadata :: fs.symlink_metadata(path) ?? return Err(.User("no generated candidate for `{request.kind}:{request.build_dir}`; run preview first: {err}"))
    if metadata.file_type().is_symlink() || !metadata.is_file() -> return Err(.Internal("generated candidate `{path.display()}` is not a regular non-symlink file"))
    bytes :: fs.read(path) ?? return Err(.Internal("could not read generated candidate `{path.display()}`: {err}"))
    actual :: "sha256-{sha256_hex(bytes)}"
    if expected_digest == .Val(expected) {
        if expected != actual -> return Err(.User("stale plan digest: expected `{expected}`, found `{actual}`; previous selection was preserved"))
    }
    source :: String.from_utf8(bytes) ?? return Err(.Internal("generated candidate is not UTF-8"))
    tree :: parse_json(source) ?? return Err(.Internal("generated candidate is not valid JSON: {err:?}"))
    if foreign_build_import.tree_string(tree, "schema")? != CANDIDATE_SCHEMA -> return Err(.Internal("generated candidate has an unsupported schema"))
    if foreign_build_import.tree_string(tree, "selection_key")? != "{request.kind}:{request.build_dir}" -> return Err(.User("generated candidate belongs to a different foreign build; previous selection was preserved"))
    (tree, actual, path)
}
// Rust: Source/CmdCompile.rs:13188
fn foreign_build_import.verify_inputs(root: &OSPath, tree: &DataTree) -> Void ForeignBuildFailure! {
    loop (relative, expected) in foreign_build_import.candidate_inputs(tree)? {
        bytes :: foreign_build_import.read_regular(root, relative) ?? {
            if err == {
                .User(message) -> return Err(.User("candidate input drifted: `{relative}` is unavailable ({message}); previous selection was preserved"))
                .Internal(message) -> return Err(.Internal(message))
            }
        }
        actual :: "sha256-{sha256_hex(bytes)}"
        if actual != expected -> return Err(.User("candidate input drifted: `{relative}` expected `{expected}`, found `{actual}`; previous selection was preserved"))
    }
}
// Rust: Source/CmdCompile.rs:13206
fn foreign_build_import.lock_path(root: &OSPath) -> OSPath { root.join(".jet").join("lock") }
// Rust: Source/CmdCompile.rs:13210
fn foreign_build_import.selected_digest(root: &OSPath, key: String) -> String? ForeignBuildFailure! {
    path :: foreign_build_import.lock_path(root)
    metadata :: fs.symlink_metadata(path) ?? {
        if err.kind() == .NotFound -> return None
        return Err(.Internal("could not inspect `{path.display()}`: {err}"))
    }
    if metadata.file_type().is_symlink() || !metadata.is_file() -> return Err(.Internal("lock `{path.display()}` is not a regular non-symlink file"))
    raw :: fs.read_to_string(path) ?? return Err(.Internal("could not read `{path.display()}`: {err}"))
    lock :: Lock.parse(raw) ?? return Err(.Internal("could not parse `{path.display()}`: {err}"))
    lock.build_contributions.iter().find(fn(row) -> row.package == SELECTION_PACKAGE && row.key == key).map(fn(row) -> row.value.clone())
}
// Rust: Source/CmdCompile.rs:13241
fn foreign_build_import.select_plan(root: &OSPath, key: String, digest: String) -> Void ForeignBuildFailure! {
    path :: foreign_build_import.lock_path(root)
    metadata :: fs.symlink_metadata(path) ?? return Err(.User("cannot activate a foreign build without the existing `.jet/lock`: {err}"))
    if metadata.file_type().is_symlink() || !metadata.is_file() -> return Err(.User("lock `{path.display()}` is not a regular non-symlink file"))
    raw :: fs.read_to_string(path) ?? return Err(.Internal("could not read `{path.display()}`: {err}"))
    lock := Lock.parse(raw) ?? return Err(.Internal("could not parse `{path.display()}`: {err}"))
    &lock.build_contributions.retain(fn(row) -> !(row.package == SELECTION_PACKAGE && row.key == key))
    &lock.build_contributions.push(Lock.LockedBuildContribution{
        package: SELECTION_PACKAGE, key: key, value: digest, scope: "project", layer: "explicit-accept",
        source: "jet build --import", reason: "reviewed foreign build plan selected explicitly",
    })
    replacement :: Lock.write(lock)
    Lock.write_lock_atomically(root, replacement.bytes()) ?? return Err(.Internal("could not atomically select foreign plan: {err}"))
}
// Rust: Source/CmdCompile.rs:13278
fn foreign_build_import.parse_request(args: &[String]) -> ForeignBuildRequest ForeignBuildFailure! {
    position :: args.iter().position(fn(argument) -> argument == "--import") ?? return Err(.User("foreign build import requires `--import cmake:build`"))
    spec :: args.get(position + 1) ?? return Err(.User("foreign build import requires a kind and build directory"))
    (kind, build_dir) :: spec.split_once(":") ?? return Err(.User("foreign build import must use `kind:build-directory`"))
    if kind.is_empty() || build_dir.is_empty() -> return Err(.User("foreign build import must use `kind:build-directory`"))
    _ :: foreign_build_import.relative_path(build_dir)?
    preview :: args.iter().any(fn(argument) -> argument == "--preview")
    accept_position :: args.iter().position(fn(argument) -> argument == "--accept")
    if preview && accept_position.is_some() -> return Err(.User("foreign build import accepts either `--preview` or `--accept`, not both"))
    operation := ForeignBuildOperation.Preview
    if !preview {
        position :: accept_position ?? return Err(.User("foreign build import requires `--preview` or `--accept <plan-digest>`"))
        digest :: args.get(position + 1) ?? return Err(.User("foreign build import `--accept` requires a plan digest"))
        if digest.starts_with("-") -> return Err(.User("foreign build import `--accept` requires a plan digest"))
        operation = .Accept(digest.clone())
    }
    ForeignBuildRequest{kind: kind.to_string(), build_dir: foreign_build_import.display_relative(foreign_build_import.relative_path(build_dir)?), operation: operation}
}
// Rust: Source/CmdCompile.rs:13326
fn foreign_build_import.import_banned() -> Bool { env_truthy("CI") && !env_truthy("JET_ALLOW_FOREIGN_BUILD_IMPORT") }
// Rust: Source/CmdCompile.rs:13330
fn foreign_build_import.report_failure(error: ForeignBuildFailure, mode: OutputMode) -> Never {
    if error == {
        .User(message) -> {
            cli_error_fix("E2104", message, "run the preview, review every action and input, then accept the exact plan digest")
            exit(ExitCodes.USER_ERROR)
        }
        .Internal(message) -> {
            write_mode_diagnostic(mode, render_ice_report("foreign build import failed", message, false))
            exit(ExitCodes.ICE)
        }
    }
}
// Rust: Source/CmdCompile.rs:13354
fn foreign_build_import.requested(args: &[String]) -> Bool { args.iter().any(fn(argument) -> argument == "--import") }
// Rust: Source/CmdCompile.rs:13358
fn foreign_build_import.run(args: &[String], mode: OutputMode) -> Never {
    if foreign_build_import.import_banned() -> foreign_build_import.report_failure(.User("foreign build import is disabled by the CI build policy; set `JET_ALLOW_FOREIGN_BUILD_IMPORT=1` only for an explicitly reviewed job"), mode)
    request :: foreign_build_import.parse_request(args) ?? foreign_build_import.report_failure(err, mode)
    if request.operation == {
        .Preview -> {
            root :: std.env.current_dir() ?? foreign_build_import.report_failure(.Internal("could not resolve project root: {err}"), mode)
            (path, candidate, digest) :: foreign_build_import.build_candidate(root, request) ?? foreign_build_import.report_failure(err, mode)
            rendered :: foreign_build_import.candidate_json(candidate)
            if mode.json -> write_mode_machine(mode, rendered)
            else {
                custom :: candidate.actions.iter().filter(fn(action) -> action.custom).map(fn(action) -> action.id).collect().join(", ")
                unsupported :: if candidate.unsupported.is_empty() -> "none" else -> candidate.unsupported.join(" | ")
                dependencies :: candidate.inputs.iter().map(fn(pair) -> pair.0).collect().join(", ")
                commands :: candidate.actions.iter().map(fn(action) -> action.command.join(" ")).collect().join(" | ")
                toolchains :: candidate.toolchains.iter().map(fn(pair) -> "{pair.0}={pair.1}").collect().join(", ")
                inputs :: candidate.inputs.iter().map(fn(pair) -> "{pair.0} ({pair.1})").collect().join(", ")
                environment :: candidate.environment.iter().map(fn(pair) -> "{pair.0}={pair.1}").collect().join(", ")
                custom_text :: if custom.is_empty() -> "none" else -> custom
                write_mode_renderable(mode, "foreign build import preview\nplan-digest: {digest}\nselection: {candidate.key}\nownership: {candidate.ownership}\ndependencies: {dependencies}\ncommands: {commands}\ntoolchain identities: {toolchains}\ninputs: {inputs}\noutputs: {candidate.outputs.join(", ")}\nenvironment: {environment}\nworkdirs: {candidate.workdirs.join(", ")}\ncustom actions: {custom_text}\nunsupported edges: {unsupported}\ncandidate: {path.display()}\n")
            }
        }
        .Accept(digest) -> {
            root :: std.env.current_dir() ?? foreign_build_import.report_failure(.Internal("could not resolve project root: {err}"), mode)
            (tree, actual, _) :: foreign_build_import.load_candidate(root, request, .Val(digest)) ?? foreign_build_import.report_failure(err, mode)
            foreign_build_import.verify_inputs(root, tree) ?? foreign_build_import.report_failure(err, mode)
            if (foreign_build_import.tree_string(tree, "ownership") ?? "") != "partial" -> foreign_build_import.report_failure(.User("foreign build candidate did not disclose partial ownership; full ownership requires every action to be modeled"), mode)
            key :: "{request.kind}:{request.build_dir}"
            foreign_build_import.select_plan(root, key, actual) ?? foreign_build_import.report_failure(err, mode)
            if mode.json -> write_mode_machine(mode, "{{\"schema\":\"jet-ffi-build-activation-v1\",\"status\":\"accepted\",\"selection_key\":\"{json_escape(key)}\",\"plan_digest\":\"{json_escape(actual)}\",\"ownership\":\"partial\"}}\n")
            else -> write_mode_renderable(mode, "foreign build plan accepted: {key} ({actual})\n")
        }
    }
    exit(ExitCodes.OK)
}
// Rust: Source/CmdCompile.rs:13478
fn foreign_build_import.run_selected(mode: OutputMode) -> I32? {
    root :: std.env.current_dir() ?? {
        write_mode_diagnostic(mode, render_ice_report("selected foreign build failed", "could not resolve project root: {err}", false))
        return .Val(ExitCodes.ICE)
    }
    key :: (foreign_build_import.selected_digest(root, "cmake:build") ?? {
        if err == {
            .User(message) -> { cli_error("E2104", message); return .Val(ExitCodes.USER_ERROR) }
            .Internal(message) -> {
                write_mode_diagnostic(mode, render_ice_report("selected foreign build failed", message, false))
                return .Val(ExitCodes.ICE)
            }
        }
    }) ?? return None
    if foreign_build_import.import_banned() {
        cli_error_fix("E2104", "the selected foreign build is disabled by the CI build policy", "set JET_ALLOW_FOREIGN_BUILD_IMPORT=1 only for an explicitly reviewed job")
        return .Val(ExitCodes.USER_ERROR)
    }
    request :: ForeignBuildRequest{kind: "cmake", build_dir: "build", operation: .Accept(key.clone())}
    result :: fn() -> I32? ForeignBuildFailure! {
        (tree, actual, _) :: foreign_build_import.load_candidate(root, request, .Val(key))?
        foreign_build_import.verify_inputs(root, tree)?
        argv :: foreign_build_import.candidate_strings(tree, "argv")?
        outputs :: foreign_build_import.candidate_strings(tree, "outputs")?
        environment :: foreign_build_import.candidate_pairs(tree, "environment")?
        workdirs :: foreign_build_import.candidate_strings(tree, "workdirs")?
        workdir :: workdirs.first() ?? return Err(.Internal("selected foreign build has no working directory"))
        workdir_path :: root.join(foreign_build_import.relative_path(workdir)?)
        metadata :: fs.symlink_metadata(workdir_path) ?? return Err(.User("selected foreign build working directory is unavailable: {err}"))
        if metadata.file_type().is_symlink() || !metadata.is_dir() -> return Err(.User("selected foreign build working directory is not a regular directory"))
        if argv.is_empty() -> return Err(.Internal("selected foreign build has no command"))
        // GATE #4494: execute the selected foreign tool with real status/environment.
        command := Command.new(argv[0])
        &command.args(argv.iter().skip(1))
        &command.current_dir(workdir_path)
        loop (name, value) in environment -> &command.env(name, value)
        status :: command.status() ?? return Err(.User("could not run selected foreign build: {err}"))
        if !status.success() -> return .Val(status.code() ?? ExitCodes.USER_ERROR)
        loop output in outputs {
            path :: root.join(foreign_build_import.relative_path(output)?)
            metadata :: fs.symlink_metadata(path) ?? return Err(.User("selected foreign build completed without declared output `{output}`: {err}"))
            if metadata.file_type().is_symlink() || !metadata.is_file() -> return Err(.User("selected foreign build output `{output}` is not a regular file"))
        }
        if mode.json -> write_mode_machine(mode, "{{\"schema\":\"jet-ffi-build-execution-v1\",\"status\":\"built\",\"plan_digest\":\"{json_escape(actual)}\",\"ownership\":\"partial\"}}\n")
        .Val(ExitCodes.OK)
    }()
    result ?? {
        if err == {
            .User(message) -> { cli_error("E2104", message); .Val(ExitCodes.USER_ERROR) }
            .Internal(message) -> {
                write_mode_diagnostic(mode, render_ice_report("selected foreign build failed", message, false))
                .Val(ExitCodes.ICE)
            }
        }
    }
}
