//RS 
//RS /// Where `write_plugin_artifacts` put the final `.wasm` Component (and the
//RS /// intermediate `.wit`/guest-Rust files, kept for `-v` reporting).
//RS pub(crate) struct PluginBuildPaths {
//RS     pub(crate) wit: PathBuf,
//RS     pub(crate) guest_rust: PathBuf,
//RS     pub(crate) core_wasm: PathBuf,
//RS     pub(crate) component_wasm: PathBuf,
//RS }
//RS 
//RS /// D-PLUGIN1=B / D-DEP-WASM1=A (c81): whether a plugin build step failed
//RS /// because a required external tool is missing/failed to run (a clean E1259,
//RS /// never an internal-compiler-error exit — I2 reserves ICE for our own
//RS /// generated code being rejected) or because `rustc` rejected the
//RS /// jet-generated guest Rust (a genuine internal compiler error — sema should
//RS /// have caught this before codegen ever ran).
//RS pub(crate) enum PluginBuildError {
//RS     ToolFailure(String),
//RS     GeneratedCodeRejected(String),
//RS }
//RS 
//RS /// The ONE place that turns a compiled `PluginArtifacts` bundle into an actual
//RS /// `.wasm` Component Model file on disk (I8, mirrors `write_web_artifacts`):
//RS /// `rustc --target wasm32-unknown-unknown --crate-type cdylib` builds the core
//RS /// module from the guest Rust, then `wasm-tools component embed` + `component
//RS /// new` lift it into a typed component using the generated `.wit` world — no
//RS /// wit-bindgen crate, no adapter shims; scalar exports use the canonical
//RS /// Component Model ABI at the core-wasm level (including `cabi_realloc` for
//RS /// Text; see `Codegen::Plugin` module doc).
// END-PORT-PENDING 0673 Source/CmdCompile.rs:11989-13766

