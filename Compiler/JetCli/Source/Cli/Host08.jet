    cache_relative :: foreign_build_import.display_relative(foreign_build_import.relative_path("{request.build_dir}/CMakeCache.txt")?)
    cache_bytes :: foreign_build_import.read_regular(root, cache_relative)?
    cache :: String.from_utf8(cache_bytes) ?? return Err(.User("CMakeCache.txt must be UTF-8"))
    compile_commands_relative :: foreign_build_import.display_relative(foreign_build_import.relative_path("{request.build_dir}/compile_commands.json")?)
    compile_commands_present :: root.join(compile_commands_relative).is_file()
