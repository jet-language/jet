fn foreign_build_import.add_input(root: &OSPath, relative: String, inputs: &[(String, String)], unsupported: &[String]) -> Void ForeignBuildFailure! {
    relative :: foreign_build_import.display_relative(foreign_build_import.relative_path(relative)?)
    if inputs.iter().any(fn(pair) -> pair.0 == relative) -> return
    bytes :: foreign_build_import.read_regular(root, relative) ?? {
        if err == {
            .User(message) -> { &unsupported.push(message); return }
            _ -> return Err(err)
        }
    }
    &inputs.push((relative, "sha256-{sha256_hex(bytes)}"))
}
// Rust: Source/CmdCompile.rs:12510
fn foreign_build_import.cmake_calls(source: String, command: String) -> [[String]] {
    lower :: source.to_ascii_lowercase()
    needle :: command.to_ascii_lowercase()
    bytes :: lower.bytes()
    cursor := 0
    calls := [[String]]{}
    loop cursor < bytes.len() {
        found :: lower.slice(cursor..<lower.len()).find(needle) ?? break
        start :: cursor + found
        before :: if start > 0 -> .Val(bytes[start - 1]) else -> None
        after_name :: start + needle.len()
        if before.is_some_and(fn(byte) -> byte.is_ascii_alphanumeric() || byte == 95) || bytes.get(after_name).is_some_and(fn(byte) -> byte.is_ascii_alphanumeric() || byte == 95) {
            cursor = after_name
            next
        }
        open_offset :: lower.slice(after_name..<lower.len()).find("(") ?? break
        open :: after_name + open_offset
        close_offset :: source.slice((open + 1)..<source.len()).find(")") ?? break
        close :: open + 1 + close_offset
        args := [String]{}
        loop token in source.slice((open + 1)..<close).split_whitespace() {
            value := token.trim_matches(fn(character) -> character == '"' || character == '\'').trim_end_matches(';') // #4303
            if !value.is_empty() -> &args.push(value.to_string())
        }
        &calls.push(^args)
        cursor = close + 1
    }
    calls
}
// Rust: Source/CmdCompile.rs:12557
fn foreign_build_import.cmake_source_tokens(calls: &[[String]], root: &OSPath, inputs: &[(String, String)], unsupported: &[String]) -> Void ForeignBuildFailure! {
    // Rust: Source/CmdCompile.rs:12563
    FLAGS :: ["WIN32", "MACOSX_BUNDLE", "EXCLUDE_FROM_ALL", "STATIC", "SHARED", "MODULE", "OBJECT", "INTERFACE", "ALL"]
    loop args in calls {
        loop token in args.iter().skip(1) {
            if FLAGS.contains(token) || token.starts_with("$") || token.contains("=") || !token.contains(".") -> next
            path := token.trim_matches(fn(character) -> character == '"' || character == '\'') // #4303
            extension :: (OSPath.new(path).extension().and_then(fn(extension) -> extension.to_str()) ?? "").to_ascii_lowercase()
            if !["c", "cc", "cpp", "cxx", "h", "hh", "hpp", "hxx", "m", "mm"].contains(extension) -> next
            if root.join(path).is_file() -> foreign_build_import.add_input(root, path, inputs, unsupported)?
            else -> &unsupported.push("declared CMake source `{path}` is unavailable")
        }
    }
}
// Rust: Source/CmdCompile.rs:12604
fn foreign_build_import.cmake_custom_dependencies(calls: &[[String]], root: &OSPath, inputs: &[(String, String)], unsupported: &[String]) -> Void ForeignBuildFailure! {
    // Rust: Source/CmdCompile.rs:12610
    FLAGS :: ["COMMAND", "DEPENDS", "OUTPUT", "BYPRODUCTS", "VERBATIM", "WORKING_DIRECTORY", "COMMENT", "USES_TERMINAL", "COMMAND_EXPAND_LISTS"]
    loop args in calls {
        depends :: args.iter().position(fn(value) -> value == "DEPENDS") ?? next
        loop value in args.iter().skip(depends + 1) {
            token := value.trim_matches(fn(character) -> character == '"' || character == '\'') // #4303
            if token.is_empty() || FLAGS.contains(token) || token.starts_with("$") || token.contains("=") || token.starts_with("-") -> next
            if root.join(token).is_file() -> foreign_build_import.add_input(root, token, inputs, unsupported)?
            else -> &unsupported.push("declared CMake custom dependency `{token}` is unavailable")
        }
    }
}
