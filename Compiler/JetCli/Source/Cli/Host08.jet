// Rust: Source/CmdCompile.rs:13619
pub fn run_selected_foreign_build(mode: OutputMode) -> I32? { foreign_build_import.run_selected(mode) }
// Rust: Source/CmdCompile.rs:13720
fn strip_manifest_source_map(manifest: String) -> String {
    out := String.with_capacity(manifest.len())
    loop line in manifest.lines() {
        if line.trim_start().starts_with("\"sourceMap\":") -> next
        &out.push_str(line)
        &out.push('\n')
    }
    out
}
