// One ordinary private Source value for the canonical CLI startup capture.
// The runtime supplier owns raw Env/TTY facts; this factory owns only typed
// publication. Native layout and cleanup derive from normal checked Source.
RawHostStartupOutputFacts: struct {
    stdout_tty: Bool
    stderr_tty: Bool
    term: [U8]?
    no_color: Bool
    force_color: Bool
    columns: U64?
    unicode: Bool
}

jet_cli_make_host_startup_output_facts: fn(stdout_tty: Bool, stderr_tty: Bool, term: ^[U8]?, no_color: Bool, force_color: Bool, columns: U64?, unicode: Bool) -> RawHostStartupOutputFacts Never! {
    RawHostStartupOutputFacts{
        stdout_tty: stdout_tty,
        stderr_tty: stderr_tty,
        term: ^term,
        no_color: no_color,
        force_color: force_color,
        columns: columns,
        unicode: unicode,
    }
}
