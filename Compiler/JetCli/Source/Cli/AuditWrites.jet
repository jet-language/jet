// `jet audit writes [--json] [<entry.jet>]`: every call in the checked
// package of the entry that changes or takes a named value, one row per site.
// The sites are sema's call-mark rule: with `#Policy(writes: .Explicit)` laid
// over each module of the entry's source root, each plain call that changes a
// named value is an E0228 diagnostic with a Safe `&` edit, and each that takes
// one a Safe `&&` edit, at the value. Nothing is written.
use {
    jet_driver.[
        JetDriverAuthorizedSourceFile,
        JetDriverCompileMode,
        JetDriverVerbOutput,
        JET_DRIVER_EXIT_OK,
        jet_driver_present_diagnostics,
    ]
}

// The module policy that turns every plain changing or taking call into a
// Safe mark edit.
JET_CLI_AUDIT_WRITES_POLICY: "#Policy(writes: .Explicit)\n"

// One call that changes or takes a named value: `path` as the snapshot spells
// it, the 1-based line and character column of `start`, the value's byte span,
// and the mark the policy writes (`&` or `&&`).
JetCLIWriteSite: struct {
    path: String
    line: Int
    column: Int
    start: Int
    end: Int
    mark: String
}

jet_cli_audit_writes: fn(file: String, source: String, color: Bool, json: Bool) -> JetDriverVerbOutput {
    entry: jet_cli_audit_entry_modules(file, source, color, json)
    if entry.refusal == .Val(refusal) -> return refusal
    sites := jet_cli_audit_write_sites(file, entry.modules, color)
    sites.sort_by((left: JetCLIWriteSite, right: JetCLIWriteSite) -> (left.path <=> right.path).then(left.start <=> right.start))
    if json {
        rows: loop site in sites -> jet_cli_status_object([JetCLIStatusField]{
            jet_cli_status_field("path", jet_cli_status_text(site.path)),
            jet_cli_status_field("line", jet_cli_status_int(site.line)),
            jet_cli_status_field("column", jet_cli_status_int(site.column)),
            jet_cli_status_field("span", jet_cli_status_object([JetCLIStatusField]{jet_cli_status_field("start", jet_cli_status_int(site.start)), jet_cli_status_field("end", jet_cli_status_int(site.end))})),
            jet_cli_status_field("mark", jet_cli_status_text(site.mark)),
            jet_cli_status_field("access", jet_cli_status_text(jet_cli_audit_write_access(site.mark))),
        })
        return JetDriverVerbOutput{stdout: "{jet_cli_status_render("audit.writes", true, [JetCLIStatusField]{jet_cli_status_field("writes", jet_cli_status_array(rows))})}\n", stderr: "", exit_code: JET_DRIVER_EXIT_OK}
    }
    lines := "calls that change or take a named value: {sites.len()}\n"
    loop site in sites -> lines = "{lines}  {site.path}:{site.line}:{site.column}  span={site.start}..{site.end}  mark={site.mark}  access={jet_cli_audit_write_access(site.mark)}\n"
    JetDriverVerbOutput{stdout: lines, stderr: "", exit_code: JET_DRIVER_EXIT_OK}
}

jet_cli_audit_write_access: fn(mark: String) -> String Never! {
    if mark == "&&" -> "take" else -> "write"
}

// The second compile, every module under the explicit-writes policy: each
// inserting E0228 edit names one plain call of the clean compile that changes
// or takes a named value.
jet_cli_audit_write_sites: fn(file: String, modules: [JetDriverAuthorizedSourceFile], color: Bool) -> [JetCLIWriteSite] {
    shift: JET_CLI_AUDIT_WRITES_POLICY.len()
    overlays: loop member in modules -> JetCLIOverlay{path: member.path, source: "{JET_CLI_AUDIT_WRITES_POLICY}{member.source}"}
    sites := [JetCLIWriteSite]{}
    if jet_cli_compile_overlays(file, file, overlays, color, None, JetDriverCompileMode.Check, None) == .Compiled(result, snapshot) {
        loop diagnostic in jet_driver_present_diagnostics(result.diagnostics, snapshot, result.generated_source_files) {
            if diagnostic.code != "E0228" -> next
            owner: diagnostic.origin ?? next
            edit: diagnostic.edit ?? next
            if (edit.new_text != "&" && edit.new_text != "&&") || edit.span.start != edit.span.end -> next
            span: diagnostic.span ?? next
            source := ""
            found := false
            loop member in modules {
                if member.path == owner.path {
                    source = member.source
                    found = true
                }
            }
            if !found -> next
            start: span.start - shift
            end: span.end - shift
            if start < 0 || end < start || end > source.len() -> next
            duplicate := false
            loop site in sites {
                if site.path == owner.path && site.start == start -> duplicate = true
            }
            if duplicate -> next
            position: jet_cli_audit_line_column(source, start)
            sites.push(JetCLIWriteSite{path: owner.path, line: position[0], column: position[1], start: start, end: end, mark: edit.new_text})
        }
    }
    sites
}
