// CmdInspect.rs acceleration_runtime_receipt and ReceiptStore.rs typed rows.
// Files are read through the one held ReceiptStore/RecordIndex; index rows do
// not authenticate arbitrary payload paths and never stand in for measurements.
use jet_driver.[JetDriverCompileRequest, JetDriverCompileMode, JetDriverOptimizationQueryResult]
use jet_foundation.[CanonicalJSON, CanonicalJSONField, CanonicalJSONError, canonical_json_error, canonical_json_parse, JET_COMPILER_TARGET_USIZE_MAX, MIR_ACCELERATION_RECEIPT_TYPE_NAME, MIR_ACCELERATION_RECEIPT_SECTION_PREFIX, MIR_ACCELERATION_RECEIPT_SCHEMA_DIGEST, mir_acceleration_json_object, mir_acceleration_json_field, mir_acceleration_json_string, mir_acceleration_json_u64, mir_acceleration_json_usize, mir_acceleration_decision_read]
use jet_pkg_model.[AuthorityResolver, WorkspaceDeclarationCache]

fn jet_cli_acceleration_receipt_rows(receipt: JetCLIReceipt, record_sequence: U64, usize_max: U64) -> [JetCLIAccelerationRuntime] CanonicalJSONError! {
    rows := [JetCLIAccelerationRuntime]{}
    loop section in receipt.sections {
        if section.type_name != MIR_ACCELERATION_RECEIPT_TYPE_NAME || !section.name.starts_with(MIR_ACCELERATION_RECEIPT_SECTION_PREFIX) -> next
        if section.schema_digest != MIR_ACCELERATION_RECEIPT_SCHEMA_DIGEST -> return Err(canonical_json_error("acceleration section `{section.name}` has an unexpected schema digest"))
        suffix :: section.name.removeprefix(MIR_ACCELERATION_RECEIPT_SECTION_PREFIX)
        sequence :: jet_cli_remote_unsigned(suffix) ?? return Err(canonical_json_error("invalid acceleration section sequence `{section.name}`"))
        value :: canonical_json_parse(section.bytes) ?? return Err(canonical_json_error("canonical JSON is invalid: {err.message}"))
        fields :: mir_acceleration_json_object(value, "acceleration receipt", [String]{"decision", "function", "loop_header", "source"})
        function :: mir_acceleration_json_string(fields, "function")
        header :: mir_acceleration_json_u64(fields, "loop_header")
        if header > (U64{4294967295}) -> return Err(canonical_json_error("acceleration receipt loop_header is out of range"))
        source :: mir_acceleration_json_object(mir_acceleration_json_field(fields, "source"), "acceleration receipt source", [String]{"end", "start"})
        start :: mir_acceleration_json_usize(source, "start", usize_max)
        end :: mir_acceleration_json_usize(source, "end", usize_max)
        if start > end -> return Err(canonical_json_error("acceleration receipt source range is reversed"))
        decision :: mir_acceleration_decision_read(mir_acceleration_json_field(fields, "decision"), usize_max)
        &rows.push(JetCLIAccelerationRuntime{receipt_digest: receipt.digest, receipt_verb: receipt.claim.verb, record_sequence: record_sequence, sequence: sequence, function: function, loop_header: header, source: JetCLIAccelerationSpan{start: start, end: end}, decision: decision})
    }
    &rows.sort_by((left: JetCLIAccelerationRuntime, right: JetCLIAccelerationRuntime) -> left.sequence <=> right.sequence)
    loop index in 1..<rows.len() {
        if rows[index - 1].sequence == rows[index].sequence -> return Err(canonical_json_error("duplicate acceleration receipt sequence"))
    }
    Ok(rows)
}

fn jet_cli_acceleration_tree_inputs(path: String, generated: Bool, visited: &[String:Bool], paths: &[String]) Never! -[FS]> {
    info :: cli_files.stat(path) ?? return
    if info.is_symlink -> return
    if info.is_file {
        name :: jet_cli_fmt_file_name(path)
        if generated || name.ends_with(".jet") || name == "lock" -> &paths.push(path)
        return
    }
    if !info.is_dir || visited.get(path) != None -> return
    visited[path] = true
    held :: JetCLIRootedDirectory.open(path, [String]{}, false) ?? return
    entries :: held.list() ?? return
    loop entry in entries {
        child :: jet_cli_rooted_join(path, entry.name)
        if entry.is_dir {
            if ([String]{".git", "target", "build"}).contains(entry.name) -> next
            if entry.name == ".jet" {
                lock :: jet_cli_rooted_join(child, "lock")
                if jet_cli_receipt_regular(lock) -> &paths.push(lock)
                jet_cli_acceleration_tree_inputs(jet_cli_rooted_join(child, "generated"), true, &visited, &paths)
                next
            }
        }
        jet_cli_acceleration_tree_inputs(child, generated, &visited, &paths)
    }
}
fn jet_cli_acceleration_authority_inputs(cache: &WorkspaceDeclarationCache, path: String, verb: String, paths: &[String]) Never! -[FS, Env]> {
    start :: AuthorityResolver.authority_walk_root(path) ?? return
    loop root in jet_cli_receipt_authority_roots(&cache, start) {
        loop name in ([String]{"package.jet", "pkg.jet", "workspace.jet", "build.jet", ".jet/lock"}) {
            input :: jet_cli_rooted_join(root, name)
            if jet_cli_receipt_regular(input) -> &paths.push(input)
        }
        visited := [String:Bool]{}
        jet_cli_acceleration_tree_inputs(jet_cli_rooted_join(root, ".jet/generated"), true, &visited, &paths)
        if verb == "prove" {
            failures := [String]{}
            jet_cli_receipt_generated_paths(jet_cli_rooted_join(root, ".jet/records/generated"), false, &failures).drop("optional receipt inputs unavailable")
            loop input in failures -> &paths.push(input)
        }
    }
}
fn jet_cli_acceleration_target(cache: &WorkspaceDeclarationCache, cwd: String, verb: String, scope: String, target: String?) -[FS, Env]> String? Never! {
    if scope == "target" && target == .Val(selected) {
        candidate :: if selected.starts_with("/") -> selected else -> jet_cli_entry_join(cwd, selected)
        if cli_files.exists(candidate) || candidate.ends_with(".jet") -> return Val(candidate)
        resolved :: "{candidate}.jet"
        return if jet_cli_receipt_regular(resolved) -> Val(resolved) else -> None
    }
    root := cli_files.realpath(cwd) ?? cwd
    if jet_cli_find_workspace_root_checked(&cache, cwd) == .Ok(found) && found == .Val(found_root) -> root = found_root
    else if jet_cli_find_package_root_checked(&cache, cwd) == .Ok(found) && found == .Val(found_root) -> root = found_root
    if verb == "test" -> return Val(root)
    loop path in ([String]{jet_cli_rooted_join(root, "run.jet"), jet_cli_rooted_join(root, "src/run.jet")}) {
        if jet_cli_receipt_regular(path) -> return Val(path)
    }
    Val(root)
}

// One prepared input family per Rust test/prove/build invocation. The canonical
// identity helper already owns authority manifests, lock and generated inputs;
// this function only supplies the same current member closure to that helper.
fn jet_cli_acceleration_input_paths(cache: &WorkspaceDeclarationCache, selected: String, verb: String) -[FS, Env]> [String] JetCLIReadError! {
    paths := [String]{}
    info :: cli_files.stat(selected) ?? return Ok(paths)
    if info.is_dir {
        visited := [String:Bool]{}
        jet_cli_acceleration_tree_inputs(selected, false, &visited, &paths)
    } else if info.is_file && !info.is_symlink {
        // Each verb target gets its own authorized source preparation; the
        // optimization query already took the inspect request.
        prepared :: jet_cli_prepare_overlays(selected, selected, [JetCLIOverlay]{}, false, Val(1), JetDriverCompileMode.Doc)
        if prepared == {
            .Refused(output) -> { return Err(jet_cli_read_error(output.stderr)) }
            .Prepared(value, _) -> {
                if jet_cli_watch_discover(&cache, value) == {
                    .Ok(graph) -> { loop path in graph.paths -> &paths.push(path) }
                    .Err(error) -> {
                        if error.comptime_unavailable -> return Err(jet_cli_read_error(error.message))
                        // Rust discovery errors retain the explicit target and then
                        // fingerprint its authorities; only absent coverage refuses.
                        &paths.push(selected)
                    }
                }
            }
        }
        jet_cli_acceleration_authority_inputs(&cache, selected, verb, &paths)
    }
    if verb == "prove" && info.is_dir {
        start :: AuthorityResolver.authority_walk_root(selected) ?? selected
        loop root in jet_cli_receipt_authority_roots(&cache, start) {
            jet_cli_receipt_generated_paths(jet_cli_rooted_join(root, ".jet/records/generated"), false, &paths).drop("optional receipt inputs unavailable")
        }
    }
    Ok(jet_cli_lock_canonical(paths))
}

// Same newest-first ordering and adjacent deduplication as Rust. Only current
// authenticated receipts are candidates. A valid newest receipt with zero
// acceleration sections yields zero rows; never silently use an older receipt.
fn jet_cli_acceleration_select_receipt(cache: &WorkspaceDeclarationCache, file: String, identities: [String], entries: [JetCLIRecordIndexEntry], receipts: [JetCLIReceipt], usize_max: U64) -[FS, Env, Time.Wait]> [JetCLIAccelerationRuntime] Never! {
    ordered := [JetCLIRecordIndexEntry]{}
    loop entry in entries {
        if entry.kind == "receipt" && entry.identity.tool_version == JET_CLI_VERSION && identities.contains(entry.identity.target_inputs_sha256) -> &ordered.push(entry)
    }
    &ordered.sort_by((left: JetCLIRecordIndexEntry, right: JetCLIRecordIndexEntry) -> (right.recorded_sequence <=> left.recorded_sequence).then(right.artifact_id <=> left.artifact_id))
    previous := ""
    loop entry in ordered {
        if entry.artifact_id == previous -> next
        previous = entry.artifact_id
        loop receipt in receipts {
            if receipt.claim.key != entry.artifact_id -> next
            identity :: jet_cli_receipt_target_identity(&cache, file, receipt.claim.inputs) ?? break
            if !identities.contains(identity.input_sha256) -> break
            rows :: jet_cli_acceleration_receipt_rows(receipt, entry.recorded_sequence, usize_max) ?? break
            return rows
        }
    }
    [JetCLIAccelerationRuntime]{}
}

// Missing/stale/corrupt optional history is legitimately absent. The explicit
// #4736 compiler coverage gap is NOT optional-history absence: it propagates to
// the shared host as a refusal, rather than fabricating an empty runtime query.
fn jet_cli_acceleration_runtime_rows(profile: String, file: String, scope: String, target: String?) -[FS, Env, IO]> [JetCLIAccelerationRuntime] JetCLIReadError! {
    cwd :: cli_sys.current_dir() ?? return Ok([JetCLIAccelerationRuntime]{})
    cache := WorkspaceDeclarationCache.new()
    store_root := String?{None}
    identities := [String]{}
    index_roots := [String]{cwd}
    for_file :: if file.starts_with("/") -> file else -> jet_cli_entry_join(cwd, file)
    loop verb in ([String]{"test", "prove", "build"}) {
        selected :: jet_cli_acceleration_target(&cache, cwd, verb, scope, target) ?? next
        paths :: jet_cli_acceleration_input_paths(&cache, selected, verb)
        if paths.len() == 0 -> next
        start :: AuthorityResolver.authority_walk_root(selected) ?? cwd
        root :: jet_cli_receipt_project_root(&cache, start)
        if store_root == None -> store_root = Val(root)
        argv := [String]{verb}
        if scope == "target" && target == .Val(selected_target) -> &argv.push(selected_target)
        if profile != "" {
            &argv.push("--profile")
            &argv.push(profile)
        }
        claim :: jet_cli_receipt_claim(verb, paths, argv, jet_cli_terminal_bits()) ?? next
        identity :: jet_cli_receipt_target_identity(&cache, for_file, claim.inputs) ?? next
        &identities.push(identity.input_sha256)
        if !index_roots.contains(identity.authority_root) -> &index_roots.push(identity.authority_root)
    }
    root :: store_root ?? return Ok([JetCLIAccelerationRuntime]{})
    if identities.len() == 0 -> return Ok([JetCLIAccelerationRuntime]{})
    entries := [JetCLIRecordIndexEntry]{}
    loop index_root in index_roots {
        index :: jet_cli_record_index_load(index_root) ?? next
        loop entry in jet_cli_record_index_query_kind(index, "receipt", true) -> &entries.push(entry)
    }
    listed :: jet_cli_receipt_list(root) ?? return Ok([JetCLIAccelerationRuntime]{})
    current := [JetCLIReceipt]{}
    loop receipt in listed {
        if jet_cli_receipt_lookup(root, receipt.claim) == {
            .Val(value) -> &current.push(value)
            .None -> {}
            .Err(_) -> {}
        }
    }
    Ok(jet_cli_acceleration_select_receipt(&cache, for_file, identities, entries, current, JET_COMPILER_TARGET_USIZE_MAX))
}
