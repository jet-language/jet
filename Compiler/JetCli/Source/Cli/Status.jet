// The one machine status object every `--json` command writes
// (crates/jet-foundation/src/Report.rs `StatusValue`, `StatusFields`,
// `StatusEnvelope::json`, `render_status`, `report_json_string`). Producers
// build typed values; only this file turns them into JSON bytes.
use jet_foundation.[
    Diagnostic,
    DIAGNOSTIC_ERROR,
    diagnostic_from_registry,
]

pub JET_CLI_STATUS_SCHEMA :: "jet.status/v1"
JET_CLI_REPORT_SCHEMA :: "jet.report/v3"

// A typed JSON value accepted as an action-specific status field; `Float`
// holds a number already rendered as JSON text.
pub enum JetCLIStatusValue {
    Null
    Bool(value: Bool)
    Integer(value: Int)
    Float(text: String)
    Text(value: String)
    Array(values: [JetCLIStatusValue])
    Object(fields: [JetCLIStatusField])
}

// One ordered, uniquely named field of a status object.
pub struct JetCLIStatusField {
    pub name: String
    pub value: JetCLIStatusValue
}

pub fn jet_cli_status_field(name: String, value: JetCLIStatusValue) -> JetCLIStatusField Never! {
    JetCLIStatusField{name: name, value: value}
}

pub fn jet_cli_status_text(value: String) -> JetCLIStatusValue Never! {
    JetCLIStatusValue.Text{value: value}
}

pub fn jet_cli_status_bool(value: Bool) -> JetCLIStatusValue Never! {
    JetCLIStatusValue.Bool{value: value}
}

pub fn jet_cli_status_int(value: Int) -> JetCLIStatusValue Never! {
    JetCLIStatusValue.Integer{value: value}
}

pub fn jet_cli_status_object(fields: [JetCLIStatusField]) -> JetCLIStatusValue Never! {
    JetCLIStatusValue.Object{fields: fields}
}

pub fn jet_cli_status_array(values: [JetCLIStatusValue]) -> JetCLIStatusValue Never! {
    JetCLIStatusValue.Array{values: values}
}

// An array of strings.
pub fn jet_cli_status_texts(values: [String]) -> JetCLIStatusValue Never! {
    items :: loop value in values -> JetCLIStatusValue.Text{value: value}
    JetCLIStatusValue.Array{values: items}
}

// `None` -> `null`, else the string.
pub fn jet_cli_status_optional_text(value: String?) -> JetCLIStatusValue Never! {
    text :: value ?? return JetCLIStatusValue.Null
    JetCLIStatusValue.Text{value: text}
}

fn jet_cli_status_hex_digit(value: Int) -> String Never! {
    if value < 10 -> return String.from_bytes([U8{48 + value}]) ?? "0"
    String.from_bytes([U8{87 + value}]) ?? "0"
}

// Report.rs `report_json_string`: quote and escape one string. Every escaped
// character is ASCII, so the scan runs over bytes and copies the unescaped
// runs (UTF-8 sequences included) verbatim.
pub fn jet_cli_json_string(value: String) -> String Never! {
    bytes :: value.bytes()
    output := "\""
    segment_start := 0
    index := 0
    loop index < bytes.len() {
        byte :: Int.from_u8(bytes[index])
        escape :: if byte == {
            34 -> "\\\""
            92 -> "\\\\"
            10 -> "\\n"
            13 -> "\\r"
            9 -> "\\t"
            8 -> "\\b"
            12 -> "\\f"
            else -> if byte < 32 -> "\\u00{jet_cli_status_hex_digit((byte >> 4) & 15)}{jet_cli_status_hex_digit(byte & 15)}" else -> ""
        }
        if escape.len() > 0 {
            if segment_start < index {
                chunk :: String.from_bytes(bytes[segment_start..index - 1]) ?? ""
                output = "{output}{chunk}"
            }
            output = "{output}{escape}"
            segment_start = index + 1
        }
        index += 1
    }
    if segment_start < bytes.len() {
        chunk :: String.from_bytes(bytes[segment_start..bytes.len() - 1]) ?? ""
        output = "{output}{chunk}"
    }
    "{output}\""
}

// `StatusValue::json`.
pub fn jet_cli_status_json(value: JetCLIStatusValue) -> String Never! {
    if value == {
        .Null -> "null"
        .Bool(flag) -> if flag -> "true" else -> "false"
        .Integer(number) -> "{number}"
        .Float(text) -> ~text
        .Text(text) -> jet_cli_json_string(text)
        .Array(values) -> {
            rendered :: loop item in values -> jet_cli_status_json(item)
            "[{rendered.join(",")}]"
        }
        .Object(fields) -> "{{{jet_cli_status_fields_json(fields)}}}"
    }
}

// `StatusFields::json`: `"name":value` pairs joined by commas.
pub fn jet_cli_status_fields_json(fields: [JetCLIStatusField]) -> String Never! {
    rendered :: loop field in fields -> "{jet_cli_json_string(field.name)}:{jet_cli_status_json(field.value)}"
    rendered.join(",")
}

// `render_status` / `StatusEnvelope::json` with no report children:
// `{"schema":"jet.status/v1","action":…,"ok":…,"reports":[],…fields}`.
pub fn jet_cli_status_render(action: String, ok: Bool, fields: [JetCLIStatusField]) -> String Never! {
    jet_cli_status_render_with_reports(action, ok, [String]{}, fields)
}

// `StatusEnvelope::json` with already rendered report children.
pub fn jet_cli_status_render_with_reports(action: String, ok: Bool, reports: [String], fields: [JetCLIStatusField]) -> String Never! {
    flag :: if ok -> "true" else -> "false"
    out := "{{\"schema\":{jet_cli_json_string(JET_CLI_STATUS_SCHEMA)},\"action\":{jet_cli_json_string(action)},\"ok\":{flag},\"reports\":[{reports.join(",")}]"
    rendered :: jet_cli_status_fields_json(fields)
    if rendered.len() > 0 -> out = "{out},{rendered}"
    "{out}}}"
}

fn jet_cli_report_optional(value: String?) -> String Never! {
    text :: value ?? return "null"
    jet_cli_json_string(text)
}

fn jet_cli_report_strings(values: [String]) -> String Never! {
    rendered :: loop value in values -> jet_cli_json_string(value)
    "[{rendered.join(",")}]"
}

// `ReportEnvelope::json` for a spanless CLI diagnostic (Report.rs): no file,
// position, labels, causes, or edits; the registry's no-fix reason, when the
// row has one, takes the place of the empty `fix_edits`.
pub fn jet_cli_report_json(diagnostic: Diagnostic) -> String Never! {
    moment :: if diagnostic.moment == {
        .Compile -> "compile"
        .Run -> "run"
        .Test -> "test"
        .Tool -> "tool"
    }
    severity :: if diagnostic.severity == DIAGNOSTIC_ERROR -> "error" else -> "lint"
    edits := ",\"fix_edits\":[]"
    if diagnostic.no_fix_reason == .Val(reason) {
        kind :: if reason.kind == {
            .Behavior -> "behavior"
            .Design -> "design"
            .Ambiguous -> "ambiguous"
        }
        edits = ",\"no_fix_reason\":{{\"kind\":{jet_cli_json_string(kind)},\"next\":{jet_cli_json_string(reason.next)}}}"
    }
    "{{\"schema\":{jet_cli_json_string(JET_CLI_REPORT_SCHEMA)},\"moment\":{jet_cli_json_string(moment)},\"severity\":{jet_cli_json_string(severity)},\"code\":{jet_cli_json_string(diagnostic.code)},\"what\":{jet_cli_json_string(diagnostic.what)},\"why\":{jet_cli_json_string(diagnostic.why)},\"fix\":{jet_cli_json_string(diagnostic.fix)},\"detail\":{jet_cli_report_optional(diagnostic.detail)},\"denial_kind\":{jet_cli_report_optional(diagnostic.denial_kind)},\"call_chain\":{jet_cli_report_strings(diagnostic.call_chain)},\"scope_chain\":{jet_cli_report_strings(diagnostic.scope_chain)},\"nearest_granting_scope\":{jet_cli_report_optional(diagnostic.nearest_granting_scope)},\"file\":null,\"line\":null,\"col\":null,\"span\":null{edits},\"cause\":[],\"clears\":0}}"
}

// The `--json` form of a spanless CLI error (Source/main.rs `cli_error!` in
// machine mode): one failed `cli` status line on stdout.
pub fn jet_cli_fail_json(code: String, what: String, why: String, fix: String) -> String Never! {
    report :: jet_cli_report_json(diagnostic_from_registry(code, None, what, why, fix))
    "{jet_cli_status_render_with_reports("cli", false, [String]{report}, [JetCLIStatusField]{})}\n"
}
