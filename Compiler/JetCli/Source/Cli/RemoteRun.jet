// `jet run <remote>`: a target that is not a local path names code fetched
// from an `https://` URL or the package registry (`name#1.4.2`, `name#1.4`,
// or a bare `name`; spec.md "Application authority"). A local path always
// wins, and plain `http://` is refused. Jet fetches the code, pins its exact
// bytes by content hash, and runs the pinned entry as `jet run <path>` runs
// it: same flags, entry selection and authority. Nothing is written to the
// working directory. The code lives under the Hangar's `remote/` folder, and
// one record per target under `$XDG_STATE_HOME/jet/remote` (else
// `~/.local/state/jet/remote`) keeps the pin and the effects the user said
// yes to. Before the first instruction the effect notice becomes a question
// (EffectNotice.jet jet_cli_remote_run_consent): pinned bytes already
// accepted with these effects run silently, and changed bytes or new
// effects ask again. `--sha256=<hex>` pins a URL's first fetch; `--locked`
// refuses any fetch or re-resolution.
use {
    jet_driver.[JET_DRIVER_EXIT_OK, JET_DRIVER_EXIT_USER_ERROR, JetDriverVerbOutput]
    jet_foundation.[AUTHORITY_AMBIENT_BASIC_EFFECTS, Diagnostic, Span, authority_grantable_roots, authority_is_deny_only, diagnostic_from_registry]
    jet_pkg_model.[
        InlineDep, InlineDepResolved, PKG_INLINE_DEPS_FIXTURES_ENV, pkg_inline_deps_list_versions,
        pkg_inline_deps_numeric_version, pkg_inline_deps_resolve, pkg_resolve_roots,
    ]
    remote_run_crypto: core.crypto
    remote_run_files: core.files
    remote_run_sys: core.sys
    remote_run_term: core.term
    remote_run_url: core.net.url
}

// Names the records; a new layout is a new name.
JET_CLI_REMOTE_RUN_RECORD: "jet.remote/v1"
// The largest file a URL target may be.
JET_CLI_REMOTE_RUN_MAX_BYTES: 16777216
JET_CLI_REMOTE_RUN_TIMEOUT_MS: 30000

#Error
JetCLIRemoteRunError: struct { message: String }

// What `jet run <word>` reaches when `word` is not a local path.
JetCLIRemoteRunTarget: enum {
    // An `https://` URL (or a refused `http://` one).
    URL(url: String)
    // A registry package; `selector` is "" for a bare name.
    Registry(name: String, selector: String)
}

// The pin of one target: the bytes that run and the effects accepted for them.
JetCLIRemoteRunPin: struct {
    // The target as written: the URL, `name#selector` or `name`.
    source: String
    // `sha256-<hex>`: of the file for a URL, of the package tree for a package.
    content_hash: String
    // The local entry that runs: the stored file, or the package directory.
    entry: String
    // The registry version the target resolved to; "" for a URL.
    version: String
    // The effects the user said yes to for these bytes.
    accepted: [String]
}

// A pinned target, as the first-run question names it.
JetCLIRemoteRunOrigin: struct {
    pin: JetCLIRemoteRunPin
    // `tool.jet`, or `greet 1.0.0`.
    name: String
    // `example.org`, or `the registry`.
    from: String
    // A record pinned other bytes for this target, which the user accepted.
    changed: Bool
}

JetCLIRemoteRunResolved: enum {
    Pinned(origin: JetCLIRemoteRunOrigin)
    Refused(output: JetDriverVerbOutput)
}

// The remote target `word` names, or None when it names a local path. A word
// that exists as a file or directory (or as `<word>.jet`), or is written as
// a path, is local.
jet_cli_remote_run_target: fn(word: String) -[FS]> JetCLIRemoteRunTarget? Never! {
    if word.starts_with("https://") || word.starts_with("http://") -> return Val(JetCLIRemoteRunTarget.URL{url: word.copy()})
    if word == "" || remote_run_files.exists(word) || remote_run_files.exists("{word}.jet") -> return None
    parts: word.split("#").to_list()
    if parts.len() > 2 || !jet_cli_remote_run_package_name(parts[0]) -> return None
    selector: if parts.len() == 2 -> parts[1] else -> ""
    if parts.len() == 2 && pkg_inline_deps_numeric_version(selector) == None -> return None
    Val(JetCLIRemoteRunTarget.Registry{name: parts[0], selector: selector})
}

// A registry package name: a letter, then letters, digits, `-` and `_`. A
// word with a `.` or `/` is a path.
jet_cli_remote_run_package_name: fn(name: String) -> Bool Never! {
    if name == "" -> return false
    loop (index, byte) in name.bytes() {
        letter: (byte >= (U8{97}) && byte <= (U8{122})) || (byte >= (U8{65}) && byte <= (U8{90}))
        digit: byte >= (U8{48}) && byte <= (U8{57})
        if index == 0 && !letter -> return false
        if !letter && !digit && byte != (U8{45}) && byte != (U8{95}) -> return false
    }
    true
}

// The `--sha256=<hex>` value, lower-cased; None when absent. A malformed one
// is refused by the front door (jet_cli_remote_run_plan).
jet_cli_remote_run_sha256: fn(jet_argv: [String]) -> String? Never! {
    loop argument in jet_argv {
        if argument == "--" -> break
        if argument.starts_with("--sha256=") -> return Val(argument.removeprefix("--sha256=").trim().to_lower())
    }
    None
}

jet_cli_remote_run_hex: fn(value: String) -> Bool Never! {
    if value.bytes().len() != 64 -> return false
    loop byte in value.bytes() {
        if !((byte >= (U8{48}) && byte <= (U8{57})) || (byte >= (U8{97}) && byte <= (U8{102}))) -> return false
    }
    true
}

// The refusal of a remote target, as `jet_cli_report_output` renders a CLI
// report (`--json` prints the typed report instead).
jet_cli_remote_run_refused: fn(what: String, why: String, fix: String, color: Bool) -> JetCLIRemoteRunResolved Never! {
    JetCLIRemoteRunResolved.Refused{output: jet_cli_report_output("", "E1805", what, why, fix, color, JET_DRIVER_EXIT_USER_ERROR)}
}

// Resolve and pin `target`, then run the pinned entry as `jet run <entry>`
// with the rest of the command unchanged. The origin rides on the
// invocation's authority rows, so the effect notice asks before the first
// instruction (EffectNotice.jet).
jet_cli_remote_run_host: fn(target: JetCLIRemoteRunTarget, jet_argv: [String], args: [String], passthrough: [String]?, color: Bool, quiet: Bool, verbose: Bool, threads: Int?) -> JetDriverVerbOutput {
    locked: jet_argv.contains("--locked")
    sha256: jet_cli_remote_run_sha256(jet_argv)
    resolved: if target == {
        .URL(url) -> jet_cli_remote_run_url(url, sha256, locked, color)
        .Registry(name, selector) -> jet_cli_remote_run_registry(name, selector, locked, color)
    }
    origin: if resolved == {
        .Pinned(pinned) -> pinned
        .Refused(output) -> { return output }
    }
    entry_args := [String]{"run", origin.pin.entry.copy()}
    loop index in 2..<args.len() -> entry_args.push(args[index])
    entry_argv := [String]{}
    replaced := false
    loop word in jet_argv {
        if word == "--" {
            replaced = true
        }
        if !replaced && word == args[1] {
            entry_argv.push(origin.pin.entry.copy())
            replaced = true
            next
        }
        if word == "--locked" || word.starts_with("--sha256=") -> next
        entry_argv.push(word.copy())
    }
    plan: jet_cli_run(entry_argv, entry_args, passthrough, false, false, color, quiet, verbose, threads)
    trace: jet_cli_trace_flag(jet_cli_owned_flags(entry_argv))
    if plan == .Run(file, source, run_color, options, run_verbose, json, run_threads, program_args, invocation, notice, watch, entry) {
        rows := invocation.move() ?? JetCLIInvocationAuthority{all: false, allow: [String]{}, deny: [String]{}}
        rows.remote = Val(origin)
        remote_plan: JetCLIPlan.Run{file: file.move(), source: source.move(), color: run_color, options: options.move(), verbose: run_verbose, json: json, threads: run_threads, program_args: program_args.move(), invocation: Val(rows), notice: notice.move(), watch: watch, entry: entry.move()}
        return jet_cli_compile_on_worker(remote_plan, trace)
    }
    // Only a program run asks before its first instruction; any other plan
    // a pinned entry made is a refusal or usage output.
    if plan == {
        .Done(_) | .Refused(_, _, _, _) | .Diagnostics(_, _, _, _, _) -> jet_cli_execute(plan)
        .Check(_, _, _, _, _, _, _, _, _, _, _, _) | .CheckWorkspace(_, _, _, _, _, _, _, _, _, _) | .CheckPrelude(_, _, _, _, _, _) | .CheckCore(_, _, _, _, _) | .Build(_, _, _, _, _, _, _, _, _, _, _) | .LockedBuild(_, _) | .BuildPackage(_, _, _, _, _, _, _, _) | .Run(_, _, _, _, _, _, _, _, _, _, _, _) | .RunRemote(_, _, _, _, _, _, _, _) | .NativeSource(_, _, _, _, _) | .DevWeb(_, _, _, _, _, _, _, _) | .Jobs(_, _, _, _) | .Test(_, _, _, _, _, _) | .TestWorkspace(_, _, _, _, _, _, _, _) | .TestProfile(_, _, _, _, _, _) | .New(_, _, _, _, _, _) | .Doc(_, _, _, _, _) | .Emit(_, _, _, _, _, _) | .Eval(_, _, _, _, _) | .Fill(_, _, _) | .Structural(_, _, _) | .Review(_, _, _) | .Keygen(_, _, _) | .KeyBackup(_, _, _) | .Publish(_, _, _, _) | .Yank(_, _, _) | .Lint(_, _, _, _, _, _, _) | .Fmt(_) | .FmtLang(_, _) | .Fix(_, _, _, _, _, _, _, _, _) | .Inspect(_) | .InspectB(_) | .ForeignBind(_, _, _) | .Perf(_, _) | .Semindex(_, _, _) | .Find(_, _, _, _) | .Cache(_, _) | .Remote(_, _, _) | .Comparison(_, _, _) | .Try(_, _, _) | .Maintenance(_, _, _, _) | .Completion(_, _, _) | .Schema(_, _, _, _, _) | .Codemod(_, _, _, _, _) | .PolicyExplain(_, _, _, _, _, _) | .DiagnosticTypeExplain(_, _, _, _) | .BuildFactExplain(_, _, _, _, _, _, _) | .Gates(_, _, _, _, _) | .Output(_, _, _, _) | .Doctor(_, _, _, _) | .UpdateJet(_, _, _, _, _) | .AuditCopies(_, _, _, _, _) | .AuditForeign(_, _, _, _, _) | .CompilerService(_) | .Repl(_, _, _, _) | .LSP | .ReplChild(_) | .EvalExpression(_, _, _) | .Prove(_, _, _, _, _, _) | .Budget(_, _, _, _) | .AuditWrites(_, _, _, _, _) -> jet_cli_report_output("", "E1805", "`{args[1]}` isn't a program `jet run` can run", "A remote target runs as one Jet program whose effects Jet can name before it starts.", "fetch it and run the program inside it by path", color, JET_DRIVER_EXIT_USER_ERROR)
    }
}

// A URL target: the pinned file when its bytes are still in the Hangar, else
// one https GET whose bytes are hashed, checked against `--sha256`, stored
// and pinned. Refetched bytes that differ from an accepted pin ask again.
jet_cli_remote_run_url: fn(url: String, sha256: String?, locked: Bool, color: Bool) -> JetCLIRemoteRunResolved {
    if url.starts_with("http://") {
        return jet_cli_remote_run_refused("`{url}` is plain http", "Bytes sent over plain http can be changed on the way, and the bytes Jet pins and runs must be the ones the server sent.", "use the `https://` address of the same file", color)
    }
    parsed: remote_run_url.parse(url) ?? return jet_cli_remote_run_refused("`{url}` isn't a URL Jet can fetch", "A remote target is an `https://` address of one Jet file.", "check the address", color)
    host: parsed.host() ?? return jet_cli_remote_run_refused("`{url}` names no host", "A remote target is an `https://` address of one Jet file.", "check the address", color)
    if parsed.userinfo() != "" || parsed.fragment() != None {
        return jet_cli_remote_run_refused("`{url}` carries credentials or a fragment", "The address is kept in the pin record, so it may not carry a user, a password or a `#` fragment.", "remove the user, password and fragment from the address", color)
    }
    if sha256 == .Val(want) {
        if !jet_cli_remote_run_hex(want) -> return jet_cli_remote_run_refused("`--sha256={want}` isn't a sha256", "`--sha256` takes the 64 hex digits of the file's sha256.", "write `--sha256=<64 hex digits>`", color)
    }
    name: jet_cli_remote_run_file_name(parsed.path())
    record: jet_cli_remote_run_record_read(url)
    if record == .Val(pin) {
        if sha256 == .Val(want) && pin.content_hash != "sha256-{want}" {
            return jet_cli_remote_run_refused("`--sha256` doesn't match the bytes pinned for `{url}`", "This machine pinned {pin.content_hash} for that address the first time it fetched it; `--sha256` pins only a first fetch.", "drop `--sha256` to run the pinned bytes", color)
        }
        if jet_cli_remote_run_file_hash(pin.entry) == .Val(hash) && hash == pin.content_hash {
            return JetCLIRemoteRunResolved.Pinned{origin: JetCLIRemoteRunOrigin{pin: pin.copy(), name: name, from: host, changed: false}}
        }
        if locked -> return jet_cli_remote_run_refused("the pinned bytes of `{url}` are gone, and `--locked` refuses to fetch them again", "`--locked` runs only what this machine already pinned.", "run it once without `--locked` to fetch and pin it again", color)
    } else if locked {
        return jet_cli_remote_run_refused("`{url}` isn't pinned on this machine, and `--locked` refuses to fetch it", "`--locked` runs only what this machine already pinned.", "run it once without `--locked` to fetch and pin it", color)
    }
    body: jet_cli_remote_run_fetch(url, host, parsed) ?? return jet_cli_remote_run_refused("couldn't fetch `{url}`: {err.message}", "Jet fetches a remote target over https before anything runs, and nothing ran.", "check the address and the network, then run it again", color)
    hex: remote_run_crypto.sha256(body).hex()
    if sha256 == .Val(want) && want != hex {
        return jet_cli_remote_run_refused("the bytes at `{url}` don't match `--sha256`", "`--sha256={want}` pins the first fetch, and the server sent bytes whose sha256 is {hex}.", "check the `--sha256` value with the file's author", color)
    }
    entry: jet_cli_remote_run_store(hex, name, body) ?? return jet_cli_remote_run_refused("couldn't store `{url}` in the Hangar: {err.message}", "Jet runs a remote target only from its pinned copy.", "make the Hangar directory writable, then run it again", color)
    content_hash: "sha256-{hex}"
    accepted := [String]{}
    changed := false
    if record == .Val(pin) {
        if pin.content_hash == content_hash {
            accepted = pin.accepted.copy()
        } else {
            changed = pin.accepted.len() > 0
        }
    }
    pin := JetCLIRemoteRunPin{source: url.copy(), content_hash: content_hash, entry: entry, version: "", accepted: accepted}
    jet_cli_remote_run_record_write(pin)
    JetCLIRemoteRunResolved.Pinned{origin: JetCLIRemoteRunOrigin{pin: pin, name: name, from: host, changed: changed}}
}

// The stored file's name: the last segment of the URL path, as a `.jet` file.
jet_cli_remote_run_file_name: fn(path: String) -> String Never! {
    segments: path.split("/").to_list()
    last: segments[segments.len() - 1]
    if last == "" || last == "." || last == ".." -> return "main.jet"
    if last.ends_with(".jet") -> return last.copy()
    "{last}.jet"
}

// One https GET over the build transport (BuildHTTPTransport.jet): no
// redirect is followed, and only a 200 answer of at most
// JET_CLI_REMOTE_RUN_MAX_BYTES is taken.
jet_cli_remote_run_fetch: fn(url: String, host: String, parsed: remote_run_url.URL) -> [U8] JetCLIRemoteRunError! {
    port: parsed.port() ?? (parsed.default_port() ?? 443)
    transport: JetCLIBuildHTTPInputs{}
    addresses: transport.resolve(host, port) ?? return Err(JetCLIRemoteRunError{message: err.message.copy()})
    response: transport.get(url, addresses, port, JET_CLI_REMOTE_RUN_TIMEOUT_MS, JET_CLI_REMOTE_RUN_MAX_BYTES) ?? return Err(JetCLIRemoteRunError{message: err.message.copy()})
    if response.status != 200 -> return Err(JetCLIRemoteRunError{message: "the server answered {response.status}"})
    Ok(response.body.copy())
}

// `sha256-<hex>` of the file at `path`, or None when it can't be read.
jet_cli_remote_run_file_hash: fn(path: String) -> String? {
    bytes: remote_run_files.read_bytes(path) ?? return None
    Val("sha256-{remote_run_crypto.sha256(bytes).hex()}")
}

// The Hangar folder of remote code.
jet_cli_remote_run_hangar: fn() -> String {
    remote_run_files.join(pkg_resolve_roots().hangar_dir(), "remote")
}

// Store `body` as `<hangar>/remote/<hex>/<name>`, written beside its place
// and renamed into it, so no run reads part of it.
jet_cli_remote_run_store: fn(hex: String, name: String, body: [U8]) -> String JetCLIRemoteRunError! {
    directory: remote_run_files.join(jet_cli_remote_run_hangar(), hex)
    path: remote_run_files.join(directory, name)
    if jet_cli_remote_run_file_hash(path) == .Val(hash) {
        if hash == ("sha256-{hex}") -> return Ok(path)
    }
    remote_run_files.create_dir_all(directory) ?? return Err(JetCLIRemoteRunError{message: "{err}"})
    staged: "{path}.{remote_run_sys.pid()}"
    remote_run_files.write_bytes(staged, body) ?? return Err(JetCLIRemoteRunError{message: "{err}"})
    remote_run_files.rename(staged, path) ?? {
        remote_run_files.remove(staged).drop("a staged copy is never run")
        return Err(JetCLIRemoteRunError{message: "{err}"})
    }
    Ok(path)
}

// A registry target: the pinned version when its tree still hashes to the
// pin, else the version the selector resolves to through the resolver
// scripts use (`.jet/inline-deps` beside the Hangar launcher, then
// JET_INLINE_DEPS_FIXTURES); a package no local root knows is fetched by
// the engine's one registry path (`jet fetch --lock`: signed index,
// verification, Hangar). A bare name takes the highest version a local root
// knows.
jet_cli_remote_run_registry: fn(name: String, selector: String, locked: Bool, color: Bool) -> JetCLIRemoteRunResolved {
    source: if selector == "" -> name.copy() else -> "{name}#{selector}"
    launcher: remote_run_files.join(jet_cli_remote_run_hangar(), "registry")
    record: jet_cli_remote_run_record_read(source)
    if record == .Val(pin) {
        pinned: InlineDep{name: name.copy(), selector: pin.version.copy(), span: Span{start: 0, end: 0}}
        if jet_cli_remote_run_resolved(pinned, launcher) == .Val(found) {
            if found.content_hash != pin.content_hash {
                return jet_cli_remote_run_refused("`{name}` {pin.version} no longer matches its pin", "This machine pinned {pin.content_hash} for it, and its copy now hashes to {found.content_hash}; a registry version's bytes never change.", "remove the copy at `{found.dir}` so the next run fetches it again", color)
            }
            return JetCLIRemoteRunResolved.Pinned{origin: JetCLIRemoteRunOrigin{pin: pin.copy(), name: "{name} {pin.version}", from: "the registry", changed: false}}
        }
    }
    if locked {
        return jet_cli_remote_run_refused("`{source}` isn't pinned on this machine, and `--locked` refuses to resolve it", "`--locked` runs only what this machine already pinned.", "run it once without `--locked` to fetch and pin it", color)
    }
    wanted := selector.copy()
    if wanted == "" {
        wanted = jet_cli_remote_run_highest(name, launcher) ?? return jet_cli_remote_run_refused("`{name}` isn't a local path, and this machine knows no version of it", "A bare package name runs the highest version this machine already has; fetching from the registry needs a version.", "check the path, or name a version: `jet run {name}#<version>`", color)
    }
    dep: InlineDep{name: name.copy(), selector: wanted, span: Span{start: 0, end: 0}}
    found: pkg_inline_deps_resolve(dep, launcher) ?? {
        fetchable: if err == {
            .UnknownPackage -> true
            .NoMatch -> true
            .InvalidName | .InvalidSelector | .InvalidTree(_) -> false
        }
        if !fetchable -> return jet_cli_remote_run_refused("couldn't resolve `{source}`: {err.message()}", "A registry target resolves as a script's `use {name}#<version>` does, before anything runs.", "check the package name and version", color)
        if jet_cli_remote_run_engine_fetch(launcher, dep, color) == .Val(failed) -> return JetCLIRemoteRunResolved.Refused{output: failed}
        jet_cli_remote_run_resolved(dep, launcher) ?? return jet_cli_remote_run_refused("the registry fetch of `{source}` left no copy Jet can run", "A registry target resolves as a script's `use {name}#<version>` does, before anything runs.", "run `jet fetch` on a script that has `use {name}#{wanted}` to see what the registry answers", color)
    }
    accepted := [String]{}
    changed := false
    if record == .Val(pin) {
        if pin.content_hash == found.content_hash {
            accepted = pin.accepted.copy()
        } else {
            changed = pin.accepted.len() > 0
        }
    }
    pin := JetCLIRemoteRunPin{source: source, content_hash: found.content_hash.copy(), entry: found.dir.copy(), version: found.resolved_version.copy(), accepted: accepted}
    jet_cli_remote_run_record_write(pin)
    JetCLIRemoteRunResolved.Pinned{origin: JetCLIRemoteRunOrigin{pin: pin, name: "{name} {found.resolved_version}", from: "the registry", changed: changed}}
}

// The highest three-part version of `name` the launcher's managed folder or
// JET_INLINE_DEPS_FIXTURES holds.
jet_cli_remote_run_highest: fn(name: String, launcher: String) -> String? {
    roots := [String]{remote_run_files.join(remote_run_files.join(launcher, ".jet"), "inline-deps")}
    if remote_run_sys.get(PKG_INLINE_DEPS_FIXTURES_ENV) == .Val(fixtures) -> roots.push(fixtures)
    best := String?{None}
    best_parts := [U64]{}
    loop root in roots {
        candidates: pkg_inline_deps_list_versions(root, name) ?? next
        loop candidate in candidates {
            parts: pkg_inline_deps_numeric_version(candidate.version) ?? next
            if parts.len() != 3 -> next
            if best == None || jet_cli_remote_run_newer(parts, best_parts) {
                best = Val(candidate.version.copy())
                best_parts = parts
            }
        }
        if best != None -> return best
    }
    best
}

jet_cli_remote_run_newer: fn(parts: [U64], than: [U64]) -> Bool Never! {
    loop index in 0..<3 {
        if parts[index] != than[index] -> return parts[index] > than[index]
    }
    false
}

// Fetch `dep` through the engine's `jet fetch --lock` of a launcher script
// that names it, so the signed index entry is pinned in its `.lock` sidecar
// and the verified tree is copied beside it. None when it succeeded.
jet_cli_remote_run_engine_fetch: fn(launcher: String, dep: InlineDep, color: Bool) -> JetDriverVerbOutput? {
    script: remote_run_files.join(launcher, "{dep.name}.jet")
    remote_run_files.create_dir_all(launcher) ?? return Val(jet_cli_report_output("", "E1805", "couldn't prepare the registry launcher: {err}", "Jet resolves a registry target into the Hangar before anything runs.", "make the Hangar directory writable, then run it again", color, JET_DRIVER_EXIT_USER_ERROR))
    remote_run_files.write(script, "use {dep.name}#{dep.selector}\n") ?? return Val(jet_cli_report_output("", "E1805", "couldn't prepare the registry launcher: {err}", "Jet resolves a registry target into the Hangar before anything runs.", "make the Hangar directory writable, then run it again", color, JET_DRIVER_EXIT_USER_ERROR))
    argv: [String]{JET_CLI_PACKAGE_ENGINE_VERB, launcher, "", if color -> "1" else -> "0", "0", "fetch", "--lock", script, "--quiet"}
    fetched: jet_cli_engine_dispatch(JET_CLI_JETPACK_BINARY, "run", argv)
    if fetched.exit_code != JET_DRIVER_EXIT_OK -> return Val(fetched)
    None
}

// `dep` resolved against the launcher's managed folder and the fixtures, or
// None when no local root holds a matching, hashable copy.
jet_cli_remote_run_resolved: fn(dep: InlineDep, launcher: String) -> InlineDepResolved? {
    found: pkg_inline_deps_resolve(dep, launcher) ?? return None
    Val(found)
}

jet_cli_remote_run_record_path: fn(source: String) -> String? {
    directory: jet_cli_state_dir("remote") ?? return None
    Val("{directory}/{remote_run_crypto.sha256(source.bytes()).hex()}")
}

// The pin recorded for `source`, when its record is complete.
jet_cli_remote_run_record_read: fn(source: String) -> JetCLIRemoteRunPin? {
    path: jet_cli_remote_run_record_path(source) ?? return None
    text: remote_run_files.read(path) ?? return None
    rows: text.split("\n").to_list()
    if rows.len() < 6 || rows[0] != JET_CLI_REMOTE_RUN_RECORD || rows[1] != source || !rows[2].starts_with("sha256-") || rows[3] == "" -> return None
    accepted: if rows[5] == "" -> [String]{} else -> rows[5].split(",").to_list()
    Val(JetCLIRemoteRunPin{source: source.copy(), content_hash: rows[2].copy(), entry: rows[3].copy(), version: rows[4].copy(), accepted: accepted})
}

// Write the record of `pin`, beside its place and renamed into it. A record
// that can't be written only means the next run asks again.
jet_cli_remote_run_record_write: fn(pin: JetCLIRemoteRunPin) {
    path: jet_cli_remote_run_record_path(pin.source) ?? return
    remote_run_files.create_dir_all(remote_run_files.dirname(path)) ?? return
    record: "{JET_CLI_REMOTE_RUN_RECORD}\n{pin.source}\n{pin.content_hash}\n{pin.entry}\n{pin.version}\n{pin.accepted.join(",")}\n"
    staged: "{path}.{remote_run_sys.pid()}"
    remote_run_files.write(staged, record) ?? return
    if remote_run_files.rename(staged, path) == .Err(_) {
        remote_run_files.remove(staged).drop("a staged record is never read")
    }
}

// Whether the user already said yes to every right in `rights` for these bytes.
jet_cli_remote_run_accepted: fn(origin: JetCLIRemoteRunOrigin, rights: [String]) -> Bool Never! {
    if origin.changed -> return false
    loop right in rights {
        if !jet_cli_covers_any(origin.pin.accepted, right) -> return false
    }
    true
}

// The rights a remote run asks about: every required right that is not
// deny-only, not denied, and not granted by the floor or this invocation's
// `--allow`/`-A` rows. The fetched code's own `allow` row grants nothing
// here, so remote code can't wave its own effects through.
jet_cli_remote_run_unacknowledged: fn(authority: JetCLIAuthority, rows: JetCLIInvocationAuthority) -> [String] Never! {
    granted := [String]{}
    loop right in AUTHORITY_AMBIENT_BASIC_EFFECTS -> granted.push(right)
    if rows.all {
        loop root in authority_grantable_roots() -> granted.push(root)
    }
    loop right in rows.allow -> granted.push(right.copy())
    if jet_cli_read_scope(Val(rows.copy())).len() > 0 -> granted.push("FS.Read")
    missing := [String]{}
    loop right in authority.required {
        if authority_is_deny_only(right) || jet_cli_covers_any(authority.denied, right) || jet_cli_covers_any(granted, right) -> next
        missing.push(right.copy())
    }
    jet_cli_named_once(missing)
}

// The first-run question of a remote run whose effects nobody acknowledged:
// None runs it. Bytes and effects already accepted run silently. On a
// terminal (and not under `--json`) Jet names the source, its hash and the
// effects, then asks `Run it? [y/N]`; a yes is recorded for these bytes.
// Without a terminal the run stops with E1804.
jet_cli_remote_run_consent: fn(origin: JetCLIRemoteRunOrigin, file: String, source: String, rights: [String], color: Bool, json: Bool) -> JetDriverVerbOutput? {
    if rights.len() == 0 || jet_cli_remote_run_accepted(origin, rights) -> return None
    target: origin.pin.source
    if json || !remote_run_term.stdin().is_tty() {
        diagnostic: diagnostic_from_registry(
            "E1804",
            None,
            "`{target}` needs a yes before its first run, and there is no terminal to ask",
            "{origin.name} from {origin.from} {jet_cli_effect_words(rights)}, and this machine hasn't run these bytes with those effects.",
            "run `jet run -A {target}` to acknowledge its effects, or run it in a terminal and answer `y`",
        )
        return Val(JetDriverVerbOutput{stdout: "", stderr: jet_cli_run_problems(file, source, [Diagnostic]{diagnostic}, color, json), exit_code: JET_DRIVER_EXIT_USER_ERROR})
    }
    console := remote_run_term.stderr()
    console.write("{origin.name} from {origin.from} ({jet_cli_remote_run_short_hash(origin.pin.content_hash)}), {jet_cli_remote_run_status(origin)}\nit {jet_cli_effect_words(rights)}\nRun it? [y/N] ").drop("remote run question")
    input := remote_run_term.stdin()
    answer: input.read_line() ?? ""
    word: answer.trim().to_lower()
    if word != "y" && word != "yes" {
        return Val(JetDriverVerbOutput{stdout: "", stderr: "not run\n", exit_code: JET_DRIVER_EXIT_USER_ERROR})
    }
    accepted := [String]{}
    if !origin.changed {
        loop right in origin.pin.accepted -> accepted.push(right.copy())
    }
    loop right in rights {
        if !accepted.contains(right) -> accepted.push(right.copy())
    }
    pin := origin.pin.copy()
    pin.accepted = jet_cli_sorted_set(accepted)
    jet_cli_remote_run_record_write(pin)
    None
}

// `sha256 3f9a…`: the first twelve digits of a `sha256-<hex>` pin.
jet_cli_remote_run_short_hash: fn(content_hash: String) -> String Never! {
    hex: content_hash.removeprefix("sha256-")
    if hex.len() <= 12 -> return "sha256 {hex}"
    "sha256 {hex.slice(0..<12)}…"
}

jet_cli_remote_run_status: fn(origin: JetCLIRemoteRunOrigin) -> String Never! {
    if {
        origin.changed -> "changed since you said yes"
        origin.pin.accepted.len() == 0 -> "new to this machine"
        else -> "now asks for more than you said yes to"
    }
}
