// Source/RecordIndex.rs. All candidate changes are transactional: failed
// validation leaves the old snapshot intact. The stored form lives under
// `<project>/.jet/records` and is read and published only through the rooted
// store (RootedStore.jet), never by pathname.
struct JetCLIRecordIndex {
    entries: [JetCLIRecordIndexEntry]
    budget: U64
}

fn jet_cli_record_index_new(budget: U64{268435456}) -> JetCLIRecordIndex JetCLIReadError! {
    if budget == 0 -> return Err(jet_cli_read_error("record budget byte limit must be greater than zero"))
    Ok(JetCLIRecordIndex{entries: [JetCLIRecordIndexEntry]{}, budget: budget})
}

fn jet_cli_record_index_from_bytes(bytes: [U8], budget: U64{268435456}) -> JetCLIRecordIndex JetCLIReadError! {
    index := jet_cli_record_index_new(budget)
    index.entries = jet_cli_record_snapshot_parse(bytes, budget)
    Ok(index)
}

fn jet_cli_record_index_query(index: JetCLIRecordIndex, authenticated: Bool) -> [JetCLIRecordIndexEntry] Never! {
    jet_cli_record_snapshot_query(index.entries, authenticated)
}

fn jet_cli_record_index_query_identity(index: JetCLIRecordIndex, identity: JetCLIRecordIdentity, authenticated: Bool) -> [JetCLIRecordIndexEntry] Never! {
    rows := [JetCLIRecordIndexEntry]{}
    loop entry in jet_cli_record_index_query(index, authenticated) {
        if entry.identity == identity -> &rows.push(entry)
    }
    rows
}

fn jet_cli_record_index_query_kind(index: JetCLIRecordIndex, kind: String, authenticated: Bool) -> [JetCLIRecordIndexEntry] Never! {
    rows := [JetCLIRecordIndexEntry]{}
    loop entry in jet_cli_record_index_query(index, authenticated) {
        if entry.kind == kind -> &rows.push(entry)
    }
    rows
}

fn jet_cli_record_index_find(index: JetCLIRecordIndex, kind: String, artifact_id: String, authenticated: Bool) -> JetCLIRecordIndexEntry? Never! {
    loop entry in jet_cli_record_index_query(index, authenticated) {
        if entry.kind == kind && entry.artifact_id == artifact_id -> return Val(entry)
    }
    None
}

fn jet_cli_record_index_next_sequence(index: JetCLIRecordIndex) -> U64 JetCLIReadError! {
    jet_cli_record_next_sequence(index.entries)
}

fn jet_cli_record_links_to(entry: JetCLIRecordIndexEntry, target: JetCLIRecordIndexEntry) -> Bool Never! {
    loop link in entry.consumed {
        if link.kind == target.kind && link.artifact_id == target.artifact_id -> return true
    }
    loop link in entry.produced {
        if link.kind == target.kind && link.artifact_id == target.artifact_id -> return true
    }
    false
}

// Connected disposable groups cannot leave a protected record with a dangling
// link. This is Source/RecordIndex.rs eviction_groups/apply_eviction, not a
// separate recency policy: FIFO sequence, then artifact id, never timestamps.
fn jet_cli_record_index_evict(entries: &[JetCLIRecordIndexEntry], budget: U64) JetCLIReadError! {
    loop {
        total := U64{0}
        loop entry in entries {
            if !jet_cli_record_entry_is_disposable(entry) -> next
            if entry.size > U64.MAX - total -> return Err(jet_cli_read_error("record budget byte count overflows"))
            total += entry.size
        }
        if total <= budget -> return
        visited := [Bool]{}
        loop _ in 0..<entries.len() -> &visited.push(false)
        selected := [Bool]{}
        selected_sequence := U64.MAX
        selected_id := ""
        loop start in 0..<entries.len() {
            if visited[start] || !jet_cli_record_entry_is_disposable(entries[start]) -> next
            group := [Bool]{}
            loop _ in 0..<entries.len() -> &group.push(false)
            group[start] = true
            visited[start] = true
            loop {
                changed := false
                loop candidate in 0..<entries.len() {
                    if group[candidate] || !jet_cli_record_entry_is_disposable(entries[candidate]) {
                        next
                    }
                    loop member in 0..<entries.len() {
                        if !group[member] -> next
                        if jet_cli_record_links_to(entries[member], entries[candidate]) || jet_cli_record_links_to(entries[candidate], entries[member]) {
                            group[candidate] = true
                            visited[candidate] = true
                            changed = true
                            break
                        }
                    }
                }
                if !changed -> break
            }
            referenced := false
            sequence := U64.MAX
            id := ""
            loop member in 0..<entries.len() {
                if !group[member] -> next
                row :: entries[member]
                if row.recorded_sequence < sequence || (row.recorded_sequence == sequence && (id == "" || row.artifact_id < id)) {
                    sequence = row.recorded_sequence
                    id = row.artifact_id
                }
                loop outside in 0..<entries.len() {
                    if !group[outside] && jet_cli_record_links_to(entries[outside], row) {
                        referenced = true
                    }
                }
            }
            if !referenced && (selected.len() == 0 || sequence < selected_sequence || (sequence == selected_sequence && id < selected_id)) {
                selected = ^group
                selected_sequence = sequence
                selected_id = id
            }
        }
        if selected.len() == 0 {
            return Err(jet_cli_read_error("disposable history budget exceeded; no unreferenced FIFO record group can be evicted"))
        }
        kept := [JetCLIRecordIndexEntry]{}
        loop position in 0..<entries.len() {
            if !selected[position] -> &kept.push(entries[position])
        }
        entries = ^kept
    }
}

fn jet_cli_record_index_update(index: &JetCLIRecordIndex, entry: JetCLIRecordIndexEntry) JetCLIReadError! {
    row :: jet_cli_record_entry_normalize(entry)
    loop existing in index.entries {
        if existing.kind != row.kind || existing.artifact_id != row.artifact_id -> next
        if existing == row -> return
        return Err(jet_cli_read_error("record `{row.kind}/{row.artifact_id}` conflicts with an existing identity"))
    }
    candidate := index.entries
    &candidate.push(row)
    jet_cli_record_index_evict(&candidate, index.budget)
    jet_cli_record_snapshot_validate(candidate, index.budget)
    retained := false
    loop current in candidate {
        if current.kind == row.kind && current.artifact_id == row.artifact_id -> retained = true
    }
    if !retained {
        return Err(jet_cli_read_error("disposable record `{row.kind}/{row.artifact_id}` exceeds the byte budget and was not retained"))
    }
    index.entries = ^candidate
}

fn jet_cli_record_index_replace(index: &JetCLIRecordIndex, entry: JetCLIRecordIndexEntry) JetCLIReadError! {
    row :: jet_cli_record_entry_normalize(entry)
    candidate := index.entries
    found := false
    loop position in 0..<candidate.len() {
        existing :: candidate[position]
        if existing.kind != row.kind || existing.artifact_id != row.artifact_id -> next
        if existing.identity != row.identity {
            return Err(jet_cli_read_error("record `{row.kind}/{row.artifact_id}` conflicts with an existing identity"))
        }
        candidate[position] = row
        found = true
        break
    }
    if !found -> return Err(jet_cli_read_error("record `{row.kind}/{row.artifact_id}` does not exist"))
    jet_cli_record_index_evict(&candidate, index.budget)
    jet_cli_record_snapshot_validate(candidate, index.budget)
    retained := false
    loop current in candidate {
        if current.kind == row.kind && current.artifact_id == row.artifact_id -> retained = true
    }
    if !retained {
        return Err(jet_cli_read_error("disposable record `{row.kind}/{row.artifact_id}` exceeds the byte budget and was not retained"))
    }
    index.entries = ^candidate
}

fn jet_cli_record_index_set_budget(index: &JetCLIRecordIndex, budget: U64) JetCLIReadError! {
    if budget == 0 -> return Err(jet_cli_read_error("record budget byte limit must be greater than zero"))
    candidate := index.entries
    jet_cli_record_index_evict(&candidate, budget)
    jet_cli_record_snapshot_validate(candidate, budget)
    index.entries = ^candidate
    index.budget = budget
}

fn jet_cli_record_index_to_bytes(index: JetCLIRecordIndex) -> [U8] JetCLIReadError! {
    jet_cli_record_snapshot_validate(index.entries, index.budget)
    bytes := [U8]{}
    loop entry in index.entries {
        line :: jet_cli_record_index_to_jsonl(entry)
        loop byte in line.bytes() -> &bytes.push(byte)
        &bytes.push(U8{10})
        if bytes.len() > 268435456 -> return Err(jet_cli_read_error("record index exceeds the 256 MiB limit"))
    }
    Ok(bytes)
}

fn jet_cli_record_index_save_replay(index: &JetCLIRecordIndex, artifact_id: String, identity: JetCLIRecordIdentity, path: String, size: U64) -> JetCLIRecordIndexEntry JetCLIReadError! {
    saved := jet_cli_record_index_find(index, "replay", artifact_id, true) ?? return Err(jet_cli_read_error("replay `{artifact_id}` is not indexed"))
    if saved.identity != identity {
        return Err(jet_cli_read_error("replay `{artifact_id}` conflicts with the current target identity"))
    }
    saved.path = path
    saved.size = size
    saved.saved = true
    jet_cli_record_index_replace(&index, saved)
    Ok(saved)
}

fn jet_cli_record_index_saved_replays(index: JetCLIRecordIndex, identity: JetCLIRecordIdentity) -> [JetCLIRecordIndexEntry] Never! {
    rows := [JetCLIRecordIndexEntry]{}
    loop entry in index.entries {
        if entry.kind == "replay" && entry.saved && entry.identity == identity -> &rows.push(entry)
    }
    loop position in 1..<rows.len() {
        row :: rows[position]
        destination := position
        loop destination > 0 {
            previous :: rows[destination - 1]
            order :: (previous.recorded_sequence <=> row.recorded_sequence).then(previous.artifact_id <=> row.artifact_id).then(previous.path <=> row.path)
            if order != Ordering.Greater -> break
            rows[destination] = rows[destination - 1]
            destination -= 1
        }
        rows[destination] = row
    }
    rows
}

fn jet_cli_record_index_remove_replay(index: &JetCLIRecordIndex, artifact_id: String) -> JetCLIRecordIndexEntry JetCLIReadError! {
    removed :: jet_cli_record_index_find(index, "replay", artifact_id, true) ?? return Err(jet_cli_read_error("replay `{artifact_id}` is not indexed"))
    candidate := [JetCLIRecordIndexEntry]{}
    loop entry in index.entries {
        if entry.kind != "replay" || entry.artifact_id != artifact_id -> &candidate.push(entry)
    }
    jet_cli_record_snapshot_validate(candidate, index.budget)
    index.entries = ^candidate
    Ok(removed)
}

// The persisted index is reloaded under the held directory lock before every
// read/modify/write, so stale process snapshots cannot lose another producer.
fn jet_cli_record_index_load(project_root: String, budget: U64{268435456}) -[FS, Time.Wait]> JetCLIRecordIndex JetCLIReadError! {
    present :: JetCLIRootedDirectory.present(project_root, [String]{".jet", "records"}) ?? return Err(err)
    if !present -> return jet_cli_record_index_new(budget)
    held :: JetCLIRootedDirectory.open(project_root, [String]{".jet", "records"}, false) ?? return Err(err)
    if held.read("index.jsonl", 268435456) == {
        .Val(raw) -> jet_cli_record_index_from_bytes(raw, budget)
        .None -> jet_cli_record_index_new(budget)
        .Err(error) -> { return Err(error) }
    }
}

fn jet_cli_record_index_reload(held: JetCLIRootedDirectory, fallback: JetCLIRecordIndex) -[FS, Time.Wait]> JetCLIRecordIndex JetCLIReadError! {
    if held.read("index.jsonl", 268435456) == {
        .Val(raw) -> jet_cli_record_index_from_bytes(raw, fallback.budget)
        .None -> Ok(fallback)
        .Err(error) -> { return Err(error) }
    }
}

fn jet_cli_record_index_remove_disposable(project_root: String, path: String) JetCLIReadError! -[FS]> {
    parts := [String]{}
    loop part in path.split("/") {
        if part == "" || part == "." -> next
        &parts.push(part)
    }
    if parts.len() == 0 -> return Err(jet_cli_read_error("disposable artifact has no file name"))
    name :: &parts.pop() ?? return Err(jet_cli_read_error("disposable artifact has no file name"))
    present :: JetCLIRootedDirectory.present(project_root, parts) ?? return Err(err)
    if !present -> return
    held :: JetCLIRootedDirectory.open(project_root, parts, false) ?? return Err(err)
    _ :: held.remove(name) ?? return Err(err)
}

fn jet_cli_record_index_store_held(index: JetCLIRecordIndex, held: JetCLIRootedDirectory, project_root: String, previous: [JetCLIRecordIndexEntry]) JetCLIReadError! -[FS, Env, Time.Wait]> {
    bytes :: jet_cli_record_index_to_bytes(index)
    held.replace("index.jsonl", bytes, Val(0o600)) ?? return Err(err)
    loop entry in previous {
        if !jet_cli_record_entry_is_disposable(entry) -> next
        retained :: loop current in index.entries {
            if current.path == entry.path -> break true
        } ?? false
        if !retained -> jet_cli_record_index_remove_disposable(project_root, entry.path)
    }
}

fn jet_cli_record_index_fresh_sequence(index: JetCLIRecordIndex, entry: ^JetCLIRecordIndexEntry) -> JetCLIRecordIndexEntry JetCLIReadError! {
    updated := ^entry
    maximum := U64{0}
    loop existing in index.entries {
        if existing.kind == updated.kind && existing.artifact_id == updated.artifact_id -> return Ok(updated)
        if existing.recorded_sequence > maximum -> maximum = existing.recorded_sequence
    }
    if updated.recorded_sequence <= maximum {
        updated.recorded_sequence = jet_cli_record_index_next_sequence(index) ?? return Err(jet_cli_read_error("could not allocate record sequence: {err.message}"))
    }
    Ok(updated)
}

fn jet_cli_record_index_store(index: JetCLIRecordIndex, project_root: String) JetCLIReadError! -[FS, Env, Time]> {
    held :: JetCLIRootedDirectory.open(project_root, [String]{".jet", "records"}, true) ?? return Err(err)
    owner :: held.lock("record index") ?? return Err(err)
    previous :: jet_cli_record_index_reload(held, jet_cli_record_index_new(index.budget))
    jet_cli_record_index_store_held(index, held, project_root, previous.entries)
}

fn jet_cli_record_index_publish_and_store(index: &JetCLIRecordIndex, project_root: String, entry: JetCLIRecordIndexEntry, supersede: Bool{false}) JetCLIReadError! -[FS, Env, Time]> {
    held :: JetCLIRootedDirectory.open(project_root, [String]{".jet", "records"}, true) ?? return Err(err)
    owner :: held.lock("record index") ?? return Err(err)
    candidate := jet_cli_record_index_reload(held, index)
    previous :: candidate.entries
    if supersede {
        retained := [JetCLIRecordIndexEntry]{}
        loop existing in candidate.entries {
            if existing.kind != entry.kind || existing.artifact_id != entry.artifact_id -> &retained.push(existing)
        }
        candidate.entries = ^retained
    }
    copied_entry := entry.copy()
    fresh :: jet_cli_record_index_fresh_sequence(candidate, ^copied_entry)
    jet_cli_record_index_update(&candidate, fresh)
    jet_cli_record_index_store_held(candidate, held, project_root, previous)
    index = ^candidate
}

fn jet_cli_record_index_upsert_many_and_store(index: &JetCLIRecordIndex, project_root: String, entries: [JetCLIRecordIndexEntry]) JetCLIReadError! -[FS, Env, Time]> {
    held :: JetCLIRootedDirectory.open(project_root, [String]{".jet", "records"}, true) ?? return Err(err)
    owner :: held.lock("record index") ?? return Err(err)
    candidate := jet_cli_record_index_reload(held, index)
    previous :: candidate.entries
    loop entry in entries {
        if jet_cli_record_index_find(candidate, entry.kind, entry.artifact_id, true) != None {
            jet_cli_record_index_replace(&candidate, entry)
        } else {
            copied_entry := entry.copy()
            fresh :: jet_cli_record_index_fresh_sequence(candidate, ^copied_entry)
            jet_cli_record_index_update(&candidate, fresh)
        }
    }
    jet_cli_record_index_store_held(candidate, held, project_root, previous)
    index = ^candidate
}

fn jet_cli_record_index_replace_and_store(index: &JetCLIRecordIndex, project_root: String, entry: JetCLIRecordIndexEntry) JetCLIReadError! -[FS, Env, Time]> {
    held :: JetCLIRootedDirectory.open(project_root, [String]{".jet", "records"}, true) ?? return Err(err)
    owner :: held.lock("record index") ?? return Err(err)
    candidate := jet_cli_record_index_reload(held, index)
    previous :: candidate.entries
    jet_cli_record_index_replace(&candidate, entry)
    jet_cli_record_index_store_held(candidate, held, project_root, previous)
    index = ^candidate
}

fn jet_cli_record_index_save_replay_and_store(index: &JetCLIRecordIndex, project_root: String, artifact_id: String, identity: JetCLIRecordIdentity, path: String, size: U64) -[FS, Env, Time]> JetCLIRecordIndexEntry JetCLIReadError! {
    held :: JetCLIRootedDirectory.open(project_root, [String]{".jet", "records"}, true) ?? return Err(err)
    owner :: held.lock("record index") ?? return Err(err)
    candidate := jet_cli_record_index_reload(held, index)
    previous :: candidate.entries
    saved :: jet_cli_record_index_save_replay(&candidate, artifact_id, identity, path, size)
    jet_cli_record_index_store_held(candidate, held, project_root, previous)
    index = ^candidate
    Ok(saved)
}

fn jet_cli_record_index_remove_replay_and_store(index: &JetCLIRecordIndex, project_root: String, artifact_id: String) -[FS, Env, Time]> JetCLIRecordIndexEntry JetCLIReadError! {
    held :: JetCLIRootedDirectory.open(project_root, [String]{".jet", "records"}, true) ?? return Err(err)
    owner :: held.lock("record index") ?? return Err(err)
    candidate := jet_cli_record_index_reload(held, index)
    previous :: candidate.entries
    removed :: jet_cli_record_index_remove_replay(&candidate, artifact_id)
    jet_cli_record_index_store_held(candidate, held, project_root, previous)
    index = ^candidate
    Ok(removed)
}
