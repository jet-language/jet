// `jet self devtools core-record --check`: the compiler build's check of Core
// and the Prelude alone, the closed program the precompiled Core record is
// written from. It is the `jet check Core` compile (one import of each public
// Core module, jet_cli_core_check_source) over the Core sources built into
// this jet, with every Core body checked whether a program calls it or not,
// stopped right before lowering (jet_driver_lowering_inputs). It prints what
// the record would hold, or the diagnostics that keep Core from checking
// clean. `--write <file>` also writes the `jet.core/v15` record of that check
// (JetDriver CoreRecord.jet) to the file and prints each section's element
// count and bytes at once, then reads the file back and encodes every row
// again, which must give the tree it was read from; the rows read back on
// one compiler thread per core (jet_cli_core_record_threads).
// `--embed <image> <runtime-dir> <out> <identity>` writes the executable
// `image` to `out` with the record added as its JET_CLI_CORE_RECORD_PART part,
// each runtime file of `runtime-dir` (JET_CLI_RUNTIME_PART_FILES) as its
// JET_CLI_RUNTIME_PART_PREFIX part and, last, its identity as its
// JET_CLI_IDENTITY_PART part, in one pass (JetBackend ELF.jet
// x64_executable_add_parts) once the record reads back as `--write`'s does,
// and writes that identity to `identity`. The
// compiler build runs it with the jet-bare it just linked and the runtime it
// built with that jet-bare, so the jet it ships carries the record of its own
// Core, its runtime and its identity, and reads no file for any of them. A
// jet's identity is `jet@<JET_VERSION>#<digest>`, the digest the sha256 of
// the jet's bytes with its identity part's bytes zeroed (the sha256 of the
// file for a jet without one, such as jet-bare); Tools/release Release.jet
// identity_digest checks it the same way. `--embedded` reads the record part
// from the running jet's mapped image, with no file read, and checks it as
// `--write` checks the file.
use {
    record_files: core.files
    record_sys: core.sys
    record_runtime: jet.runtime.sys
    record_term: core.term
    record_time: core.time
    jet_backend.[x64_executable_add_parts]
    jet_driver.[JetDriverCompileMode, JetDriverCoreRecord, JetDriverCoreRecordCounts, JetDriverCoreRecordSectionSize, JetDriverLoweringInputs, JetDriverVerbOutput, JET_DRIVER_EXIT_OK, JET_DRIVER_EXIT_USAGE, JET_DRIVER_EXIT_USER_ERROR, jet_driver_check_outcome, jet_driver_core_record_open_embedded, jet_driver_core_record_round_trip, jet_driver_core_record_sizes, jet_driver_core_record_write, jet_driver_lowering_inputs, jet_driver_present_diagnostics]
    jet_foundation.[CompilerThreads, sha256_bytes, sha256_hex_bytes]
    jet_pkg_model.[JET_VERSION]
}

JET_CLI_CORE_RECORD_USAGE: "usage: jet self devtools core-record --check | --write <file> | --embed <image> <runtime-dir> <out> <identity> | --embedded\n"

// The name of the executable part that holds the Core record.
JET_CLI_CORE_RECORD_PART: "jet.core"

// An executable the build writes is runnable by everyone and writable by
// its owner.
JET_CLI_CORE_RECORD_IMAGE_MODE: 493

jet_cli_devtools_core_record: fn(args: [String], color: Bool, json: Bool) -> JetDriverVerbOutput {
    if args.len() == 1 && args[0] == "--embedded" -> return jet_cli_core_record_embedded()
    checking: args.len() == 1 && args[0] == "--check"
    writing: args.len() == 2 && args[0] == "--write" && jet_cli_core_record_operand(args[1])
    embedding: args.len() == 5 && args[0] == "--embed" && jet_cli_core_record_operand(args[1]) && jet_cli_core_record_operand(args[2]) && jet_cli_core_record_operand(args[3]) && jet_cli_core_record_operand(args[4])
    if !checking && !writing && !embedding -> return JetDriverVerbOutput{stdout: "", stderr: JET_CLI_CORE_RECORD_USAGE, exit_code: JET_DRIVER_EXIT_USAGE}
    watch: record_time.start()
    checked := jet_cli_core_checked(color, json)
    if checked.move() == {
        .Stopped(output) -> output
        .Checked(inputs, compiler, target) -> {
            summary: jet_cli_core_record_summary(inputs, watch.elapsed_millis())
            if checking -> return JetDriverVerbOutput{stdout: summary, stderr: "", exit_code: JET_DRIVER_EXIT_OK}
            bytes: jet_driver_core_record_write(inputs, compiler, target) ?? return jet_cli_ice("the Core record can't be written: {err}")
            sizes: jet_driver_core_record_sizes(bytes) ?? return jet_cli_ice("the Core record this jet wrote doesn't open: {err}")
            // Out before the read-back, which takes longer than the write:
            // a read-back that fails or is stopped still leaves the sizes.
            jet_cli_core_record_out("{summary}core-record written: {bytes.len()} bytes, {watch.elapsed_millis()} ms\n{jet_cli_core_record_sections(sizes)}")
            if embedding {
                image_file: args[1]
                runtime_dir: args[2]
                out: args[3]
                identity_file: args[4]
                image: record_files.read_bytes(image_file) ?? return jet_cli_maintenance_error("E2105", "couldn't read the executable `{image_file}`: {jet_cli_io_error_text(err)}", None, color, json)
                counts: jet_driver_core_record_round_trip(bytes, jet_cli_core_record_threads()) ?? return jet_cli_ice("the Core record doesn't read back: {err}")
                digest: jet_cli_core_record_digest(bytes)
                names := [String]{JET_CLI_CORE_RECORD_PART}
                payloads := [[U8]]{bytes}
                loop name in JET_CLI_RUNTIME_PART_FILES {
                    path: "{runtime_dir}/{name}"
                    payload: record_files.read_bytes(path) ?? return jet_cli_maintenance_error("E2105", "couldn't read the runtime file `{path}`: {jet_cli_io_error_text(err)}", None, color, json)
                    // The runtime must be the one this jet built: its
                    // IDENTITY names the jet-bare that lowered it, which is
                    // the compiler the record names.
                    if name == JET_CLI_IDENTITY_FILE {
                        packer: String.from_bytes(payload) ?? return jet_cli_maintenance_error("E2105", "the runtime identity `{path}` is not UTF-8", None, color, json)
                        if packer.trim() != compiler -> return jet_cli_maintenance_error("E2105", "the runtime in `{runtime_dir}` was built by `{packer.trim()}`, but the Core record is for `{compiler}`", Val("build the runtime with the jet that writes the record"), color, json)
                    }
                    names.push("{JET_CLI_RUNTIME_PART_PREFIX}{name}")
                    payloads.push(payload)
                }
                // The identity part is the file's last bytes: zeros while
                // the digest is taken, then the identity it names.
                prefix: "jet@{JET_VERSION}#"
                placeholder := [U8]{}
                loop _ in 0..<prefix.len() + 64 -> placeholder.push(U8{0})
                names.push(JET_CLI_IDENTITY_PART)
                payloads.push(placeholder)
                shipped := x64_executable_add_parts(image, names, payloads) ?? return jet_cli_maintenance_error("E2105", "couldn't add the Core record, the runtime and the identity to `{image_file}`: {err}", None, color, json)
                identity: "{prefix}{jet_cli_core_record_digest(shipped)}"
                stamp: identity.bytes()
                start: shipped.len() - stamp.len()
                loop (k, byte) in stamp -> shipped[start + k] = byte
                record_files.write_bytes(out, shipped) ?? return jet_cli_maintenance_error("E2105", "couldn't write the executable `{out}`: {jet_cli_io_error_text(err)}", None, color, json)
                record_files.set_mode(out, JET_CLI_CORE_RECORD_IMAGE_MODE) ?? return jet_cli_maintenance_error("E2105", "couldn't make `{out}` executable: {jet_cli_io_error_text(err)}", None, color, json)
                record_files.write(identity_file, "{identity}\n") ?? return jet_cli_maintenance_error("E2105", "couldn't write the identity `{identity_file}`: {jet_cli_io_error_text(err)}", None, color, json)
                return JetDriverVerbOutput{stdout: "core-record embed: {out}: {jet_cli_core_record_counts(counts)} as part `{JET_CLI_CORE_RECORD_PART}`, sha256 {digest}, {JET_CLI_RUNTIME_PART_FILES.len()} runtime parts from {runtime_dir}, identity {identity}, {watch.elapsed_millis()} ms\n", stderr: "", exit_code: JET_DRIVER_EXIT_OK}
            }
            file: args[1]
            record_files.write_bytes(file, bytes) ?? return jet_cli_maintenance_error("E2105", "couldn't write the Core record `{file}`: {jet_cli_io_error_text(err)}", None, color, json)
            stored: record_files.read_bytes(file) ?? return jet_cli_maintenance_error("E2105", "couldn't read the Core record `{file}` back: {jet_cli_io_error_text(err)}", None, color, json)
            counts: jet_driver_core_record_round_trip(stored, jet_cli_core_record_threads()) ?? return jet_cli_ice("the Core record `{file}` doesn't read back: {err}")
            JetDriverVerbOutput{stdout: "core-record write: {file}: {jet_cli_core_record_counts(counts)}, sha256 {jet_cli_core_record_digest(stored)}, every row read back and encoded to the same tree, {watch.elapsed_millis()} ms\n", stderr: "", exit_code: JET_DRIVER_EXIT_OK}
        }
    }
}

// The compiler threads a record's rows read back on: up to one per core.
jet_cli_core_record_threads: fn() -> CompilerThreads {
    cores: record_sys.cpu_count()
    CompilerThreads{cap: Val(jet_cli_default_threads(cores)), cores: cores, memory_available: jet_cli_memory_available()}
}

// The Core check of the record, which every core-record route and the Core
// code library (CoreLibrary.jet jet_cli_core_library) start from: the Core
// entry (jet_cli_core_check_source) written to a scratch directory and
// compiled with every Core body checked, stopped right before lowering,
// with the compiler identity and target the record names; else the output
// that ends the route (the diagnostics that keep Core from checking clean,
// a refusal, an internal problem).
JetCLICoreChecked: enum {
    Checked(inputs: JetDriverLoweringInputs, compiler: String, target: String)
    Stopped(output: JetDriverVerbOutput)
}

jet_cli_core_checked: fn(color: Bool, json: Bool) -> JetCLICoreChecked {
    // The compiler build's `core-record` step runs the `jet-bare` it just
    // linked, which is given no `JET_COMPILER_IDENTITY` (a made tool's step
    // is given none). Unset, this jet is named by its identity part, else
    // (jet-bare has none) by its own bytes, as BuildExecute names a
    // `b.jet()` without an identity, and so is the runtime the `runtime`
    // step built with it (RuntimePack.jet IDENTITY), which `--embed` checks.
    // The identity file is never read here: one an earlier build left behind
    // would name another compiler and make the record, and so jet, differ by
    // tree.
    if record_sys.get(JET_CLI_COMPILER_IDENTITY_ENV) == None {
        identity := jet_cli_identity_part() ?? ""
        if identity == "" {
            executable: record_sys.executable()
            image: record_files.read_bytes(executable) ?? return JetCLICoreChecked.Stopped{output: jet_cli_maintenance_error("E2105", "couldn't read this jet `{executable}` to name the compiler the record is for: {jet_cli_io_error_text(err)}", None, color, json)}
            identity = "jet@{JET_VERSION}#{jet_cli_core_record_digest(image)}"
        }
        record_sys.set(JET_CLI_COMPILER_IDENTITY_ENV, identity)
    }
    scratch: record_files.temp_dir("jet-core-record") ?? return JetCLICoreChecked.Stopped{output: jet_cli_maintenance_error("E2105", "couldn't create a scratch directory for the Core entry: {jet_cli_io_error_text(err)}", None, color, json)}
    entry: "{scratch.path}/core.jet"
    source: jet_cli_core_check_source()
    record_files.write(entry, source) ?? return JetCLICoreChecked.Stopped{output: jet_cli_maintenance_error("E2105", "couldn't write the Core entry `{entry}`: {jet_cli_io_error_text(err)}", None, color, json)}
    prepared := if jet_cli_prepare_snapshot(entry, entry, [JetCLIOverlay]{}, color, true) == {
        .Refused(refusal) -> JetCLIPrepared.Refused{output: refusal}
        .Held(snapshot) -> jet_cli_prepare_request(snapshot, color, None, JetDriverCompileMode.Check)
    }
    if prepared.move() == {
        .Refused(output) -> JetCLICoreChecked.Stopped{output: output}
        .Prepared(request, snapshot) -> {
            selected := request
            selected.every_core_body = true
            compiler: selected.host_facts.compiler_identity ?? ""
            target: selected.host_facts.target_triple ?? ""
            front := jet_driver_lowering_inputs(selected, None)
            diagnostics: jet_driver_present_diagnostics(front.compile.diagnostics, snapshot, front.compile.generated_source_files)
            if jet_cli_errors(diagnostics).len() > 0 -> return JetCLICoreChecked.Stopped{output: jet_driver_check_outcome("Core", source, diagnostics, color, false)}
            if front.compile.internal_problem == .Val(problem) -> return JetCLICoreChecked.Stopped{output: jet_cli_ice(problem)}
            inputs: front.inputs.move() ?? return JetCLICoreChecked.Stopped{output: jet_cli_ice("the Core check stopped before lowering without a diagnostic")}
            JetCLICoreChecked.Checked{inputs: inputs, compiler: compiler, target: target}
        }
    }
}

// `--embedded`: the record part of the running jet, read from its mapped
// image and checked row by row; a jet built without one fails.
jet_cli_core_record_embedded: fn() -> JetDriverVerbOutput {
    watch: record_time.start()
    size: record_runtime.image_part_size(JET_CLI_CORE_RECORD_PART) ?? return JetDriverVerbOutput{stdout: "", stderr: "error: this jet carries no Core record part `{JET_CLI_CORE_RECORD_PART}`; `jet build Compiler/` adds it\n", exit_code: JET_DRIVER_EXIT_USER_ERROR}
    bytes: record_runtime.image_part(JET_CLI_CORE_RECORD_PART, 0, size) ?? return jet_cli_ice("the Core record part `{JET_CLI_CORE_RECORD_PART}` has a size but no bytes")
    counts: jet_driver_core_record_round_trip(bytes, jet_cli_core_record_threads()) ?? return jet_cli_ice("the embedded Core record doesn't read back: {err}")
    JetDriverVerbOutput{stdout: "core-record embedded: {jet_cli_core_record_counts(counts)}, sha256 {jet_cli_core_record_digest(bytes)}, every row read back and encoded to the same tree, {watch.elapsed_millis()} ms\n{jet_cli_core_record_sections(counts.sections)}", stderr: "", exit_code: JET_DRIVER_EXIT_OK}
}

// The Core record a compile of `core_input` loads its Core modules from
// (JetDriverCompileRequest.core_record): this jet's record part, opened, when
// the compile reads the Core sources built into this jet. A toolchain tree's
// Core (jet_cli_core_sources) may differ from them, so a compile that reads
// it parses its sources, as does every compile of a jet without the part.
jet_cli_core_record: fn(core_input: String) -> JetDriverCoreRecord? Never! {
    if jet_cli_toolchain_root(core_input) == .Found(_) -> return None
    size: record_runtime.image_part_size(JET_CLI_CORE_RECORD_PART) ?? return None
    bytes: record_runtime.image_part(JET_CLI_CORE_RECORD_PART, 0, size) ?? panic("the Core record part `{JET_CLI_CORE_RECORD_PART}` has a size but no bytes")
    record: jet_driver_core_record_open_embedded(bytes) ?? panic("this jet's Core record doesn't open: {err}")
    Val(record)
}

// A file operand: present and not a flag.
jet_cli_core_record_operand: fn(text: String) -> Bool Never! { text != "" && !text.starts_with("-") }

jet_cli_core_record_digest: fn(bytes: [U8]) -> String Never! { sha256_hex_bytes(sha256_bytes(bytes[0..<bytes.len()])) }

// What a round trip read back, section by section.
jet_cli_core_record_counts: fn(counts: JetDriverCoreRecordCounts) -> String Never! {
    "{counts.modules} modules, {counts.bodies} bodies, {counts.registrations} registration rows, {counts.decls} declaration rows, {counts.values} comptime values, {counts.bytes} bytes"
}

// One line per section: its id, element count, the bytes its elements take
// and the bytes of its largest element.
jet_cli_core_record_sections: fn(sections: [JetDriverCoreRecordSectionSize]) -> String Never! {
    lines: loop section in sections -> "core-record section {section.id}: {section.elements} elements, {section.bytes} bytes, largest {section.largest} bytes\n"
    lines.join("")
}

// `text` on stdout now, flushed, ahead of the route's own output.
jet_cli_core_record_out: fn(text: String) {
    out := record_term.stdout()
    out.write(text).drop("jet stdout")
    out.flush().drop("jet stdout")
}

// One line: the checked modules other than the scratch entry, their
// functions (generic ones apart), constants, nominal types and impls, and
// the check's wall time.
jet_cli_core_record_summary: fn(inputs: JetDriverLoweringInputs, millis: Int) -> String Never! {
    modules := 0
    functions := 0
    generic := 0
    constants := 0
    nominals := 0
    impls := 0
    loop module_row in inputs.modules {
        if module_row.module_identity == inputs.entry_module_identity -> next
        modules += 1
        constants += module_row.constants.len()
        nominals += module_row.nominals.len()
        impls += module_row.impls.len()
    }
    loop function in inputs.functions {
        if function.module_identity == inputs.entry_module_identity -> next
        functions += 1
        if function.generic_params.len() > 0 -> generic += 1
    }
    "core-record check: {modules} modules, {functions} functions ({generic} generic), {constants} constants, {nominals} nominal types, {impls} impls, 0 errors, {millis} ms\n"
}
