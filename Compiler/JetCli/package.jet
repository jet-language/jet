name: "jet_cli"
version: "0.0.1"
edition: "2028"
deps: {
    jet_foundation: ../JetFoundation,
    jet_lexer: ../JetLexer,
    jet_semindex: ../JetSemIndex,
    jet_eval: ../JetEval,
    jet_driver: ../JetDriver,
    jet_backend: ../JetBackend,
}
authority: {
    holds: { allow: [Env, Exec, Exec.Args, FS, FS.Read, IO, Mem.Alloc, Time.Wait] }
}
