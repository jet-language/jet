name: "jet_cli"
version: "0.0.1"
edition: "2026"
deps: {
    jet_foundation: ../JetFoundation,
    jet_lexer: ../JetLexer,
    jet_eval: ../JetEval,
    jet_driver: ../JetDriver,
    jet_parser: ../JetParser,
    jet_backend: ../JetBackend,
    jet_ir: ../JetIR,
    jet_sema: ../JetSema,
    jet_env_model: ../../Jetpack/EnvModel,
    jet_pkg_model: ../../Jetpack/PackageModel,
    jetpack_artifact_store: ../../Jetpack/Store/Source/ArtifactStore,
    jetpack_foundation: ../../Jetpack/Foundation,
    jetpack_trust: ../../Jetpack/Trust,
    jet_build_session: ../JetBuildSession,
}
authority: {
    holds: { allow: [Env, Exec, Exec.Args, FFI.C, FFI.Asm, FS, FS.Read, IO, Mem.Alloc, Net, Rand, Time, Time.Wait] }
}
