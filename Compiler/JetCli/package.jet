name: "jet_cli"
version: "0.0.1"
edition: "2026"
deps: {
    jet_foundation: ../JetFoundation,
    jet_lexer: ../JetLexer,
    jet_codegen: ../JetCodegen,
    jet_eval: ../JetEval,
    jet_driver: ../JetDriver,
    jet_parser: ../JetParser,
    jet_backend: ../JetBackend,
}
authority: {
    holds: { allow: [Env, Exec, Exec.Args, FFI.C, FFI.Asm, FS, FS.Read, IO, Mem.Alloc, Net, Rand, Time, Time.Wait] }
}
