// The checked Package carrier reader the supply commands share. The
// dependency commands themselves (`jet add|remove|fetch|update`) run in the
// engine (Jetpack/CLI/Source/Hosts/PackageDependencyHost.jet). Source-owned
// parse errors remain direct, uncolored diagnostics, unlike spanless CLI
// input/IO errors.
use {
    jet_driver.[JET_DRIVER_EXIT_USER_ERROR, JetDriverVerbOutput]
    jet_pkg_model.[
        InlinePackageBlock, Manifest, PackageFacts, WorkspaceDeclarationCache,
        pkg_extract_inline_package, pkg_manifest_path_checked, pkg_package_facts_for_entry,
        pkg_to_manifest,
    ]
    jetpack_foundation.[FoundationFileAuthority, MAX_TREE_FILE_BYTES, foundation_open_file_authority]
    jet_foundation.[Diagnostic, diagnostic_from_registry, diagnostic_render_all]
    cli_files: core.files
    jet_cli.[
        JET_CLI_DEFAULT_ENTRY_FILE, JET_CLI_PACKAGE_FILE, jet_cli_diagnostic_copy, jet_cli_entry_join,
        jet_cli_find_project_entry, jet_cli_io_error_text, jet_cli_report_base, jet_cli_reports_status_json,
    ]
}

#Error
JetCLIDependencyError: struct { output: JetDriverVerbOutput }
JetCLIPackageInput: struct {
    path: String
    raw: String
    inline: InlinePackageBlock?
    manifest: Manifest
    notice: String{""}
    authority: FoundationFileAuthority
}

jet_cli_dependency_cli_error: fn(code: String, what: String, fix: String?, color: Bool, json: Bool) -[FS, Env]> JetCLIDependencyError Never! {
    shared: jet_cli_diagnostic_copy(code)
    report: diagnostic_from_registry(code, None, what, shared.why, fix ?? shared.fix)
    if json -> return JetCLIDependencyError{output: JetDriverVerbOutput{stdout: jet_cli_reports_status_json("cli", false, jet_cli_report_base(""), "", "", [Diagnostic]{report}), stderr: "", exit_code: JET_DRIVER_EXIT_USER_ERROR}}
    JetCLIDependencyError{output: JetDriverVerbOutput{stdout: "", stderr: diagnostic_render_all("", "", [Diagnostic]{report}, color), exit_code: JET_DRIVER_EXIT_USER_ERROR}}
}
jet_cli_dependency_source_error: fn(path: String, raw: String, report: Diagnostic) -> JetCLIDependencyError Never! {
    JetCLIDependencyError{output: JetDriverVerbOutput{stdout: "", stderr: diagnostic_render_all(path, raw, [Diagnostic]{report}, false), exit_code: JET_DRIVER_EXIT_USER_ERROR}}
}

jet_cli_dependency_read: fn(path: String, color: Bool, json: Bool) -[FS, Env]> (raw: String, authority: FoundationFileAuthority) JetCLIDependencyError! {
    authority: foundation_open_file_authority(cli_files.dirname(path), cli_files.basename(path)) ?? return Err(jet_cli_dependency_cli_error("E2105", "couldn't read {path}: {jet_cli_io_error_text(err)}", None, color, json))
    bytes: authority.read_bounded(MAX_TREE_FILE_BYTES) ?? return Err(jet_cli_dependency_cli_error("E2105", "couldn't read {path}: {jet_cli_io_error_text(err)}", None, color, json))
    raw: String.from_bytes(bytes) ?? return Err(jet_cli_dependency_cli_error("E2105", "couldn't read {path}: stream did not contain valid UTF-8", None, color, json))
    Ok((raw: raw, authority: authority))
}
jet_cli_dependency_with_notice: fn(error: JetCLIDependencyError, notice: String) -> JetCLIDependencyError Never! {
    JetCLIDependencyError{output: JetDriverVerbOutput{stdout: error.output.stdout, stderr: "{notice}{error.output.stderr}", exit_code: error.output.exit_code}}
}
jet_cli_package_input_entry: fn(root: String, color: Bool, json: Bool) -[FS, Env]> (path: String, notice: String) JetCLIDependencyError! {
    notices := [String]{}
    entry: if jet_cli_find_project_entry(root, "fetch", color, notices) == {
        .Entry(found) -> found.path
        .Refused(plan) -> {
            if plan == {
                .Refused(report, plan_color, code, notice) -> {
                    if json -> return Err(JetCLIDependencyError{output: JetDriverVerbOutput{stdout: jet_cli_reports_status_json("cli", false, jet_cli_report_base(""), "", "", [Diagnostic]{report}), stderr: "{notices.join("")}{notice}", exit_code: code}})
                    return Err(JetCLIDependencyError{output: JetDriverVerbOutput{stdout: "", stderr: "{notices.join("")}{notice}{diagnostic_render_all("", "", [Diagnostic]{report}, plan_color)}", exit_code: code}})
                }
                .Done(output) -> return Err(jet_cli_dependency_with_notice(JetCLIDependencyError{output: output}, notices.join("")))
                .Diagnostics(_, _, _, _, _) | .Check(_, _, _, _, _, _, _, _, _, _, _, _) | .CheckWorkspace(_, _, _, _, _, _, _, _, _, _) | .CheckPrelude(_, _, _, _, _, _) | .CheckCore(_, _, _, _, _) | .Build(_, _, _, _, _, _, _, _, _, _, _) | .LockedBuild(_, _) | .BuildPackage(_, _, _, _, _, _, _, _) | .Run(_, _, _, _, _, _, _, _, _, _, _, _) | .RunRemote(_, _, _, _, _, _, _, _) | .NativeSource(_, _, _, _, _) | .DevWeb(_, _, _, _, _, _, _, _) | .Jobs(_, _, _, _) | .Test(_, _, _, _, _, _) | .TestWorkspace(_, _, _, _, _, _, _, _) | .TestProfile(_, _, _, _, _, _) | .New(_, _, _, _, _, _) | .Doc(_, _, _, _, _) | .Emit(_, _, _, _, _, _) | .Eval(_, _, _, _, _) | .Fill(_, _, _) | .Structural(_, _, _) | .Review(_, _, _) | .Keygen(_, _, _) | .KeyBackup(_, _, _) | .Publish(_, _, _, _) | .Yank(_, _, _) | .Lint(_, _, _, _, _, _, _) | .Fmt(_) | .FmtLang(_, _) | .Fix(_, _, _, _, _, _, _, _, _) | .Inspect(_) | .InspectB(_) | .ForeignBind(_, _, _) | .Perf(_, _) | .Semindex(_, _, _) | .Find(_, _, _, _) | .Cache(_, _) | .Remote(_, _, _) | .Comparison(_, _, _) | .Try(_, _, _) | .Maintenance(_, _, _, _) | .Completion(_, _, _) | .Schema(_, _, _, _, _) | .Codemod(_, _, _, _, _) | .PolicyExplain(_, _, _, _, _, _) | .DiagnosticTypeExplain(_, _, _, _) | .BuildFactExplain(_, _, _, _, _, _, _) | .Gates(_, _, _, _, _) | .Output(_, _, _, _) | .Doctor(_, _, _, _) | .UpdateJet(_, _, _, _, _) | .AuditCopies(_, _, _, _, _) | .AuditForeign(_, _, _, _, _) | .CompilerService(_) | .Repl(_, _, _, _) | .LSP | .ReplChild(_) | .EvalExpression(_, _, _) | .Prove(_, _, _, _, _, _) | .Budget(_, _, _, _) | .AuditWrites(_, _, _, _, _) -> panic("project entry refusal must be a CLI report or completed output")
            }
        }
        .Absent -> jet_cli_entry_join(root, JET_CLI_DEFAULT_ENTRY_FILE)
    }
    Ok((path: entry, notice: notices.join("")))
}

jet_cli_dependency_input_at_entry: fn(root: String, entry: String, color: Bool, json: Bool) -[FS, Env]> JetCLIPackageInput JetCLIDependencyError! {
    source: jet_cli_dependency_read(entry, color, json)
    inline: if pkg_extract_inline_package(source.raw) == {
        .Ok(value) -> value
        .Err(error) -> { return Err(jet_cli_dependency_source_error(entry, source.raw, error.diagnostic())) }
    }
    cache := WorkspaceDeclarationCache.new()
    found: if pkg_package_facts_for_entry(cache, entry) == {
        .Ok(value) -> value
        .Err(error) -> { return Err(jet_cli_dependency_source_error(entry, source.raw, error.diagnostic)) }
    }
    facts: found ?? return Err(jet_cli_dependency_cli_error("E2105", "couldn't resolve package facts for {entry}", None, color, json))
    if inline == .Val(block) {
        manifest: pkg_to_manifest(facts, block.body(source.raw)) ?? return Err(jet_cli_dependency_source_error(entry, block.body(source.raw), err.diagnostic))
        return Ok(JetCLIPackageInput{path: entry, raw: source.raw, inline: inline, manifest: manifest, authority: source.authority.move()})
    }
    jet_cli_package_input_from_facts(root, facts, color, json)
}

jet_cli_package_input_from_facts: fn(root: String, facts: PackageFacts, color: Bool, json: Bool) -[FS, Env]> JetCLIPackageInput JetCLIDependencyError! {
    located: if pkg_manifest_path_checked(root) == {
        .Ok(value) -> value
        .Err(error) -> { return Err(jet_cli_dependency_source_error(JET_CLI_PACKAGE_FILE, "", error.diagnostic)) }
    }
    path: located ?? return Err(jet_cli_dependency_cli_error("E2105", "couldn't locate {JET_CLI_PACKAGE_FILE}", None, color, json))
    carrier: jet_cli_dependency_read(path, color, json)
    manifest: pkg_to_manifest(facts, carrier.raw) ?? return Err(jet_cli_dependency_source_error(path, carrier.raw, err.diagnostic))
    Ok(JetCLIPackageInput{path: path, raw: carrier.raw, inline: None, manifest: manifest, authority: carrier.authority.move()})
}
