// Execute only the validated declared invocation. NativeSandbox owns isolation.
// No programmer shell or ambient tool selection.
use {
    jet_foundation.[canonical_json_bytes]
    jetpack_foundation.[foundation_native_sandbox_status, foundation_run_native_sandboxed]
    flash_paths: core.files.path
    core.files.path.[Path]
    cli_files: core.files
    receipt_crypto: core.crypto
    jet_cli.[
        jet_cli_read_error, jet_cli_receipt_claim, jet_cli_receipt_prepare, jet_cli_receipt_publish,
    ]
}

JetCLINativeFlashHost: struct {
    captured_path: [Path]?
    impl JetCLIFlashHost {
        symlink_metadata: fn(&self, path: Path) -> JetCLIFlashMetadata JetCLIFlashError! {
            stat: cli_files.stat(path.raw) ?? return Err(jet_cli_flash_error("{err}"))
            Ok(JetCLIFlashMetadata{symlink: stat.is_symlink, regular: stat.is_file, bytes: stat.size})
        }
        canonicalize: fn(&self, path: Path) -> Path JetCLIFlashError! {
            resolved: cli_files.canonicalize(path.raw) ?? return Err(jet_cli_flash_error("{err}"))
            Ok(flash_paths.of(resolved))
        }
        metadata: fn(&self, path: Path) -> JetCLIFlashMetadata JetCLIFlashError! {
            self.symlink_metadata(path)
        }
        sha256_file: fn(&self, path: Path) -> String JetCLIFlashError! {
            bytes: cli_files.read_bytes(path.raw) ?? return Err(jet_cli_flash_error("{err}"))
            Ok(receipt_crypto.sha256(bytes).hex())
        }
        read_audit_text: fn(&self, path: Path) -> String JetCLIFlashError! {
            bytes: cli_files.read_bytes(path.raw) ?? return Err(jet_cli_flash_error("{err}"))
            String.from_bytes(bytes) ?? return Err(jet_cli_flash_error("target audit is not UTF-8"))
        }
        path_snapshot: fn(&self) -> [Path]? JetCLIFlashError! { Ok(self.captured_path) }
        utf8_filename: fn(&self, path: Path) -> String? JetCLIFlashError! {
            name: cli_files.basename(path.raw)
            Ok(if name == "" -> None else -> Val(name))
        }
    }
}
jet_cli_flash_execute: fn(plan: JetCLIFlashPlan) -[FS, Env, Exec, Time.Wait]> JetCLIFlashExecution Never! {
    status: foundation_native_sandbox_status()
    if !status.available -> return jet_cli_flash_execution_failed("authority_unavailable", "native process authority unavailable: {status.reason}", status.mechanism, status.policy)
    prefix: plan.image_sha256.slice(0..<(if plan.image_sha256.len() < 16 -> plan.image_sha256.len() else -> 16))
    output: cli_files.join(cli_sys.temp_dir(), "jet-flash-{cli_sys.pid()}-{prefix}")
    cli_files.create_dir(output) ?? return jet_cli_flash_execution_failed("authority_setup", "cannot create private flash output: {err}", status.mechanism, status.policy)
    source: cli_files.dirname(plan.image.raw)
    args := [String]{}
    // copy: `plan.argv[index]` stays with the caller (`plan` is a read parameter: no move out of
    // it, E0201) and the pushed row owns its own.
    loop index in 1..<plan.argv.len() -> args.push(plan.argv[index].copy())
    executed: foundation_run_native_sandboxed(plan.executable.raw, args, source, Val(output), [String:String]{}, false)
    cli_files.remove_all(output) ?? ()
    if executed == {
        .Err(error) -> {
            detail: if error == {
                .Unsupported(text) -> text
                .IO(text) -> text
            }
            jet_cli_flash_execution_failed("authority_spawn", detail, status.mechanism, status.policy)
        }
        .Ok(result) -> {
            code: if result.receipt.code == .Val(value) -> "Some({value})" else -> "None"
            failure: if result.receipt.success -> JetCLIFlashFailure?{None} else -> Val(JetCLIFlashFailure{kind: if result.receipt.code == None -> "tool_signal" else -> "tool_exit", detail: "declared flash tool exited with status {code}"})
            JetCLIFlashExecution{status: result.receipt.code, stdout: result.receipt.stdout, stderr: result.receipt.stderr, mechanism: result.mechanism, policy: result.policy, failure: failure}
        }
    }
}
jet_cli_flash_publish: fn(receipt_root: String, args: [String], terminal: [U8], receipt: JetCLIFlashReceipt, secret_values: [String]) -[FS, Env, Time.Wait]> String JetCLIReadError! {
    claim: jet_cli_receipt_claim("flash", [String]{receipt.plan.image.raw, receipt.plan.audit.raw}, args, terminal)
    section: jet_cli_flash_receipt_section(receipt)
    stored: jet_cli_receipt_prepare(claim, if receipt.success -> 0 else -> 1, canonical_json_bytes(jet_cli_flash_receipt_to_json(receipt)), [U8]{}, [JetCLIReceiptSection]{section}, [JetCLIRecordLink]{}, [JetCLIRecordLink]{}, secret_values)
    if !jet_cli_receipt_publish(receipt_root, stored) -> return Err(jet_cli_read_error("flash inputs changed before receipt publication"))
    Ok(stored.digest)
}
