// The Jet-hosted `jet` process entry. The start path comes first: a release
// hard link named `jet-cc`, `jet-cxx` or `jet-c++` selects that verb.
// jet_cli_main ends the process with the verb's status.
use {
    process: core.process
    sys: core.sys
}

run: fn() {
    words := [String]{sys.executable()}
    loop word in process.args() -> words.push(word)
    jet_cli_main(jet_cli_alias_args(words))
}
