// The Jet compiler workspace: the packages `jet` and its tool packages are built from.
// `jet build Compiler/` runs build.jet's `build: fn`, which builds the `jet` executable
// from JetCLI and its package dependencies.
// `jet test Compiler --profile <p>` runs a test profile below, and a bare `jet test Compiler`
// runs `quick`, every member's #Tests compared with their row baseline. The corpus suites
// run in the `jet` under test through JetTestKit, their row IDs relative to the checkout.
// `registries` runs every case, the opt-in ones too, against no baseline:
// Tools/Agent/CompilerRegistries.jet's testkit entry. `corpora` runs every corpus
// suite and none of the #Tests: the corpus pass of a collect-all closeout.
// The code suites packages (the #Tests of every other package under Compiler/, Jetpack/ and
// Tests/Guards/: each member's Tests package, the tool packages, every Jetpack package, the
// guard packages, and the claims of the Jetpack engine areas that have no package), core (every
// Core #Test at each optimize level), fuzz (the sema fuzz corpus Tests/Fuzz/Sema: invalid files
// fail `jet check`, every other file passes it, and a differential file then runs at each
// optimize level with the same exit and stdout as at O0; no jet exits 101), selfhost (the
// fixed point s2 == s3), inline_census (no `#Inline(Always)` call left after inlining in any
// build of Examples, Core or the compiler, at each optimize level) and perf (the self-compile
// against its budget) are test.jet's. `full` runs every suite but inline_census (whose
// builds repeat the core suite's and build the compiler at each level), so each package's
// #Tests run in it.
// The build profiles: `jet build --profile dev Compiler` is the fast build for targeted
// testing (no optimizer passes). `ship` pins the values the self-host stages build with
// (O1, not the stock O2 of `jet build`); the selfhost and perf suites of test.jet
// build with it. Chain, census and release stages pass no profile, since they build trees
// whose package.jet may predate these profiles: they pass `-O1` instead. `release`
// (`jet build --release Compiler`) replaces the stock one, whose `debug_info: split`
// would give jet-bare a `.gnu_debuglink`: core-embed then refuses to split jet's
// debug info out a second time. jet still gets its jet.debug from core-embed.
name: "compiler"
version: "0.0.1"
edition: "2026"
// build.jet's steps run programs and write files.
authority: {
    allow: [Exec, FS]
}
// test.jet sizes its package runs with the corpus pool's memory budget.
deps: {
    jet_testkit: ./JetTestKit,
}
members: [
    "JetFoundation",
    "JetLexer",
    "JetParser",
    "JetSema",
    "JetEval",
    "JetBackend",
    "JetIR",
    "JetWasm",
    "JetWeb",
    "JetPlugin",
    "JetSemIndex",
    "JetDebug",
    "JetLSP",
    "JetCanvas",
    "JetRepl",
    "JetDriver",
    "JetDevServer",
    "JetTestKit",
    "JetCLI",
]
suites: {
    golden: TestSuite{
        golden_corpus: "../Examples"
    },
    run: TestSuite{
        golden_corpus: "../Tests/Run"
    },
    ui: TestSuite{
        ui_corpus: "../Tests/UI"
    },
    ui_lint: TestSuite{
        ui_corpus: "../Tests/UILint"
    },
    cases: TestSuite{
        cases_corpus: "../Tests/Cases"
    },
}
build: {
    dev: Build{
        optimize: O0
    },
    ship: Build{
        optimize: O1,
        debug_info: true,
    },
    release: Build{
        optimize: O2,
        debug_info: true,
    },
}
test: {
    quick: TestProfile{
        suites: [tests]
    },
    golden: TestProfile{
        suites: [golden, run],
        baseline: "../Tests/known-failing.tsv",
    },
    ui: TestProfile{
        suites: [ui, ui_lint],
        baseline: "../Tests/known-failing.tsv",
    },
    cases: TestProfile{
        suites: [cases],
        baseline: "../Tests/known-failing.tsv",
    },
    registries: TestProfile{
        suites: [cases],
        opt_in: true,
    },
    packages: TestProfile{
        suites: [packages],
        baseline: "../Tests/known-failing.tsv",
    },
    core: TestProfile{
        suites: [core],
        baseline: "../Tests/known-failing.tsv",
    },
    fuzz: TestProfile{
        suites: [fuzz],
        baseline: "../Tests/known-failing.tsv",
    },
    selfhost: TestProfile{
        suites: [selfhost]
    },
    inline_census: TestProfile{
        suites: [inline_census]
    },
    perf: TestProfile{
        suites: [perf],
        baseline: "../Tests/known-failing.tsv",
    },
    full: TestProfile{
        suites: [tests, golden, run, ui, ui_lint, cases, packages, core, fuzz, selfhost, perf],
        baseline: "../Tests/known-failing.tsv",
    },
    corpora: TestProfile{
        suites: [golden, run, ui, ui_lint, cases],
        baseline: "../Tests/known-failing.tsv",
    },
}
defaults: {
    test: quick
}
