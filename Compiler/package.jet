// The Jet compiler workspace. `jet build Compiler/` runs build.jet's `fn build`, which builds
// the `jet` executable from the JetCli package and its package dependencies.
name: "compiler"
version: "0.0.1"
edition: "2026"
members: [
    "JetFoundation",
    "JetLexer",
    "JetParser",
    "JetSema",
    "JetCodegen",
    "JetEval",
    "JetOptimizer",
    "JetBackend",
    "JetBuildSession",
    "JetRepl",
    "JetSemIndex",
    "JetDriver",
    "JetCli",
]
