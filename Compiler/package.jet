// The Jet compiler workspace: the packages `jet` is built from. `jet build Compiler/` runs
// build.jet's `build: fn`, which builds the `jet` executable from JetCli and its package
// dependencies. Tool packages beside them (LSP, devserver, debugger) are not members.
// `jet test Compiler --profile <p>` runs a test profile below, and a bare `jet test Compiler`
// runs `quick`, every member's #Tests compared with their row baseline. The corpus suites
// run in the `jet` under test through JetTestKit, their row IDs relative to the checkout.
// `registries` runs every case, the opt-in ones too, against no baseline:
// Tools/agent/CompilerRegistries.jet's testkit entry. `corpora` runs every corpus
// suite and none of the #Tests: Tools/agent/goldens-census.mjs's corpus pass.
// The code suites packages (the #Tests of every other package under Compiler/ and Jetpack/:
// each member's Tests package, the tool packages and every Jetpack package), selfhost (the
// fixed point s2 == s3) and perf (the self-compile against its budget) are test.jet's.
// `full` runs every suite, so each package's #Tests run in it.
name: "compiler"
version: "0.0.1"
edition: "2026"
members: [
    "JetFoundation",
    "JetLexer",
    "JetParser",
    "JetSema",
    "JetEval",
    "JetBackend",
    "JetIR",
    "JetWasm",
    "JetWeb",
    "JetPlugin",
    "JetBuildSession",
    "JetRepl",
    "JetDriver",
    "JetTestKit",
    "JetCli",
]
suites: {
    golden: TestSuite{ golden_corpus: "../Examples" },
    run: TestSuite{ golden_corpus: "../tests/run" },
    ui: TestSuite{ ui_corpus: "../tests/ui" },
    ui_lint: TestSuite{ ui_corpus: "../tests/ui_lint" },
    cases: TestSuite{ cases_corpus: "../tests/cases" },
}
test: {
    quick: TestProfile{ suites: [tests] },
    golden: TestProfile{ suites: [golden, run], baseline: "../tests/known-failing.tsv" },
    ui: TestProfile{ suites: [ui, ui_lint], baseline: "../tests/known-failing.tsv" },
    cases: TestProfile{ suites: [cases], baseline: "../tests/known-failing.tsv" },
    registries: TestProfile{ suites: [cases], opt_in: true },
    packages: TestProfile{ suites: [packages] },
    selfhost: TestProfile{ suites: [selfhost] },
    perf: TestProfile{ suites: [perf] },
    full: TestProfile{ suites: [tests, golden, run, ui, ui_lint, cases, packages, selfhost, perf], baseline: "../tests/known-failing.tsv" },
    corpora: TestProfile{ suites: [golden, run, ui, ui_lint, cases], baseline: "../tests/known-failing.tsv" },
}
defaults: { test: quick }
