// Runs one registered migration plan over files.
// Usage: jet run Compiler/Migrations/Migrate.jet -- <plan> [--write] [--against DIR] [--list FILE] [--source-list FILE] PATH...
// Each PATH, and each line of a `--list` file, names a file the plan reads by
// its kind: a `.jet` or `.template` source, a `.md` file, or any other text,
// such as an expected output, or a database a plan converts in place, such as
// an SQLite job queue. Each line of a `--source-list` file names a file
// read as a Jet source whatever its name, such as a formatter's expected
// output. Without `--write` the files are only read. The run prints
// `EDIT <path> <count>` for each file the plan changes, `SKIP <site>: <reason>`
// for each site it leaves alone, and a closing `TOTAL` line.
// With `--against DIR` the run rewrites nothing: it checks that each file
// means what DIR's copy at the same path means, that copy being the file
// before the plan rewrote it. It prints `CHANGED <path>: <reason>` for each
// file whose meaning differs and a closing `SAME <same> of <files> files`
// line, and exits 1 when any file changed meaning.
use {
    files: core.files
    process: core.process
}

// A registered plan: its name on the command line and the toolchain it moves
// code to. The rows are LANGUAGE_REWRITES of the syntax registry
// (Compiler/JetFoundation/Data/Syntax/Spellings.jet), in its order.
MigrationPlan: struct {
    name: String,
    toolchain: String,
}

migration_plans: fn() -> [MigrationPlan] {
    [MigrationPlan]{
        MigrationPlan{name: "lambda-shape1", toolchain: "a0.0.45"},
        MigrationPlan{name: "codable-options1", toolchain: "a0.0.45"},
        MigrationPlan{name: "sig-arrow1", toolchain: "a0.0.45"},
        MigrationPlan{name: "bit-sigils1", toolchain: "a0.0.45"},
        MigrationPlan{name: "paren-tuple1", toolchain: "a0.0.45"},
        MigrationPlan{name: "brace-layout1", toolchain: "a0.0.45"},
        MigrationPlan{name: "american-ident1", toolchain: "a0.0.45"},
        MigrationPlan{name: "american-tokens1", toolchain: "a0.0.45"},
        MigrationPlan{name: "diagnostic-names1", toolchain: "a0.0.46"},
        MigrationPlan{name: "mark-caret1", toolchain: "a0.0.47"},
    }
}

migration_rewrite: fn(plan: String, path: String, text: String, source: Bool) -> MigrationOutcome {
    if plan == {
        "lambda-shape1" -> lambda_shape1_file(path, text, source)
        "codable-options1" -> codable_options1_file(path, text)
        "sig-arrow1" -> sig_arrow1_file(path, text, source)
        "bit-sigils1" -> bit_sigils1_file(path, text, source)
        "paren-tuple1" -> paren_tuple1_file(path, text, source)
        "brace-layout1" -> brace_layout1_file(path, text, source)
        "american-ident1" -> american_ident1_file(path, text, source)
        "american-tokens1" -> american_tokens1_file(path, text)
        "diagnostic-names1" -> diagnostic_names1_file(path, text, source)
        "mark-caret1" -> mark_caret1_file(path, text, source)
        else -> panic("no migration plan named {plan}")
    }
}

// Why a plan's rewrite `after` of `before` does not mean what `before`
// means, or None when it does.
migration_same_meaning: fn(plan: String, path: String, before: String, after: String, source: Bool) -> String? {
    if plan == {
        "paren-tuple1" -> paren_tuple1_same_meaning(path, before, after, source)
        "brace-layout1" -> brace_layout1_same_meaning(path, before, after, source)
        "american-tokens1" -> american_tokens1_same_meaning(path, before, after)
        else -> panic("the {plan} plan has no meaning check")
    }
}

// Whether the plan reads `path` as a database, which it converts in place,
// rather than as text.
migration_database: fn(plan: String, path: String) -> Bool {
    plan == "american-tokens1" && american_tokens1_database_file(path)
}

// A plan's conversion of the database at `path`, made when `write` is set.
migration_database_rewrite: fn(plan: String, path: String, write: Bool) -> MigrationOutcome {
    if plan == {
        "american-tokens1" -> american_tokens1_database(path, write)
        else -> panic("the {plan} plan converts no database")
    }
}

// Why the database `after`, the plan's conversion of `before`, does not
// mean what `before` means, or None when it does.
migration_database_same_meaning: fn(plan: String, before: String, after: String) -> String? {
    if plan == {
        "american-tokens1" -> american_tokens1_database_same_meaning(before, after)
        else -> panic("the {plan} plan converts no database")
    }
}

migration_listing: fn(path: String, into: ^[String]) {
    listing: files.read(path) ?? panic("cannot read {path}: {err}")
    loop line in listing.split("\n") {
        if line != "" -> into.push(line.copy())
    }
}

run: fn() {
    args: process.args()
    names := [String]{}
    loop known in migration_plans() -> names.push(known.name.copy())
    if args.len() == 0 || !names.contains(args[0]) {
        panic("usage: Migrate.jet -- <plan> [--write] [--against DIR] [--list FILE] [--source-list FILE] PATH...; plans: {names.join(", ")}")
    }
    plan: args[0]
    write := false
    paths := [String]{}
    sources := [String]{}
    // The index of `--against`'s DIR in `args`, or -1.
    against := -1
    index := 1
    loop index < args.len() {
        arg: args[index]
        if {
            arg == "--write" -> write = true
            arg == "--against" && index + 1 < args.len() -> {
                against = index + 1
                index += 1
            }
            arg == "--list" && index + 1 < args.len() -> {
                migration_listing(args[index + 1], paths)
                index += 1
            }
            arg == "--source-list" && index + 1 < args.len() -> {
                migration_listing(args[index + 1], sources)
                index += 1
            }
            else -> paths.push(arg.copy())
        }
        index += 1
    }
    // A file named in both lists is read once, as a source.
    loop source in sources {
        if !paths.contains(source) -> paths.push(source.copy())
    }
    if against > 0 {
        same := 0
        loop path in paths {
            if migration_database(plan, path) {
                if migration_database_same_meaning(plan, "{args[against]}/{path}", path) == .Val(why) {
                    print("CHANGED {path}: {why}")
                    next
                }
                same += 1
                next
            }
            after: files.read(path) ?? panic("cannot read {path}: {err}")
            before: files.read("{args[against]}/{path}") ?? panic("cannot read {args[against]}/{path}: {err}")
            if migration_same_meaning(plan, path, before, after, sources.contains(path)) == .Val(why) {
                print("CHANGED {path}: {why}")
                next
            }
            same += 1
        }
        print("SAME {same} of {paths.len()} files")
        if same < paths.len() -> process.exit(1)
        return
    }
    total := 0
    changed := 0
    loop path in paths {
        database: migration_database(plan, path)
        outcome := MigrationOutcome{text: "", rewritten: 0, skipped: [String]{}}
        if {
            database -> outcome = migration_database_rewrite(plan, path, write)
            else -> {
                text: files.read(path) ?? {
                    print("UNREADABLE {path}")
                    next
                }
                outcome = migration_rewrite(plan, path, text, sources.contains(path))
            }
        }
        loop line in outcome.skipped -> print("SKIP {line}")
        if outcome.rewritten == 0 -> next
        total += outcome.rewritten
        changed += 1
        print("EDIT {path} {outcome.rewritten}")
        if write && !database {
            files.write(path, outcome.text) ?? panic("cannot write {path}: {err}")
        }
    }
    print("TOTAL {total} sites in {changed} files")
}
