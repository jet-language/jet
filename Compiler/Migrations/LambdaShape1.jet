// Toolchain a0.0.45: every arrow lambda (`x -> e`, `(a, b) -> e`,
// `(p) -[E]> e`, `(p) -> { … }`) becomes the `fn(…) { … }` lambda. The arrow
// forms are not Jet from this toolchain on, so the plan finds them in the
// lexer's tokens, never in a parse: a `(…)` group or a lowercase name right
// before `->` or `-[E]>` is a lambda head when it stands where a value starts
// (after `(`, `[`, `:`, `=`, `:=`, `->`, `return`, `??` or `|>`, or after a
// comma inside `(…)` or `[…]`). A braced arm or condition list (`{ a -> … }`)
// and a marker's arguments (`#State(A -> B)`) never qualify. The body runs to
// the comma or closer that ends it, or, in a braced context, to the end of its
// line. The code spans (`…`) of Markdown prose and of string literals are
// read the same way, so a fix text teaches the `fn` form too.
use {
    jet_lexer.[Token, TokenTables, lex_generated, STRING_PART_INTERPOLATION, TOKEN_COLON, TOKEN_COLON_EQ, TOKEN_COMMA, TOKEN_DOT, TOKEN_EQ, TOKEN_GT, TOKEN_HASH, TOKEN_IDENT, TOKEN_KW_ELSE, TOKEN_LBRACE, TOKEN_LBRACKET, TOKEN_LPAREN, TOKEN_MINUS, TOKEN_PIPE_GT, TOKEN_QUESTION_DOT, TOKEN_QUESTION_QUESTION, TOKEN_RAW_STRING, TOKEN_RBRACE, TOKEN_RBRACKET, TOKEN_RETURN, TOKEN_RPAREN, TOKEN_SEMI, TOKEN_STRING, TOKEN_UNIFIED_ARROW, TOKEN_AND_AND, TOKEN_OR_OR, lexer_without_comments]
    jet_parser.[parse_generated_source]
}

LambdaShapeEdit: struct {
    start: Int
    end: Int
    text: String
    // Among closers inserted at one offset, the later-starting lambda's first.
    order: Int{0}
}

// The rewritten text, the count of lambdas rewritten and the sites left alone.
MigrationOutcome: struct {
    text: String
    rewritten: Int
    skipped: [String]
}

// Rewrites the arrow lambdas of one file: a Jet source (`source`, or a `.jet`
// or `.template` path) with the Jet programs quoted in its strings, a Markdown
// file's ```jet fences and prose code spans, or any other text, such as an
// expected output, line by line.
lambda_shape1_file: fn(path: String, text: String, source: Bool) -> MigrationOutcome {
    if source || path.ends_with(".jet") || path.ends_with(".template") -> return lambda_shape1_source(path, text)
    if path.ends_with(".md") -> return lambda_shape1_markdown(path, text)
    lambda_shape1_lines(path, text)
}

// A text's code spans, and each line without any read whole as one, so an
// expected output follows the sources and messages it shows.
lambda_shape1_lines: fn(path: String, text: String) -> MigrationOutcome {
    bytes: text.bytes()
    edits := [LambdaShapeEdit]{}
    rewritten := 0
    start := 0
    loop start < bytes.len() {
        end := start
        ticks := false
        loop end < bytes.len() && bytes[end] != 10 {
            if bytes[end] == 96 -> ticks = true
            end += 1
        }
        if {
            ticks -> rewritten += lambda_shape1_spans(bytes, start, end, 96, false, edits)
            else -> rewritten += lambda_shape1_plain(bytes, start, end, false, edits)
        }
        start = end + 1
    }
    if rewritten == 0 -> return MigrationOutcome{text: text, rewritten: 0, skipped: [String]{}}
    result: lambda_shape1_apply(bytes, edits) ?? return MigrationOutcome{text: text, rewritten: 0, skipped: [String]{"{path}: overlapping edits, file left alone"}}
    MigrationOutcome{text: result, rewritten: rewritten, skipped: [String]{}}
}

// Rewrites the arrow lambdas of one Jet source, unless the source parses
// cleanly and the result does not. A source that already has parse errors is
// not Jet either way, so its lambdas are rewritten.
lambda_shape1_source: fn(path: String, text: String) -> MigrationOutcome {
    bytes: text.bytes()
    lexed: lex_generated(bytes)
    edits := [LambdaShapeEdit]{}
    skipped := [String]{}
    rewritten := lambda_shape1_scan(path, bytes, lexed.tables, lexed.tokens, TOKEN_LBRACE, edits, skipped)
    loop token in lexed.tokens {
        if token.kind != TOKEN_RAW_STRING && token.kind != TOKEN_STRING -> next
        if lambda_shape1_quoted(path, bytes, token, skipped) == .Val(quoted_edit) {
            rewritten += quoted_edit.rewritten
            edits.push(LambdaShapeEdit{start: quoted_edit.start, end: quoted_edit.end, text: quoted_edit.text})
            next
        }
        if {
            lambda_shape1_text(bytes, token.span.start, token.span.end).contains("`") -> {
                if token.kind == TOKEN_STRING -> rewritten += lambda_shape1_spans(bytes, token.span.start, token.span.end, 96, true, edits)
            }
            // An interpolated literal's holes are code, read with the file's.
            token.literal < 0 || !lexed.tables.literals[token.literal].string_parts.any(fn(part) { part.kind == STRING_PART_INTERPOLATION }) -> rewritten += lambda_shape1_snippet(bytes, token, edits)
        }
    }
    if edits.len() == 0 -> return MigrationOutcome{text: text, rewritten: 0, skipped: skipped}
    result: lambda_shape1_apply(bytes, edits) ?? {
        skipped.push("{path}: overlapping edits, file left alone")
        return MigrationOutcome{text: text, rewritten: 0, skipped: skipped}
    }
    before_errors: lambda_shape1_errors(text)
    if before_errors == 0 {
        after_errors: lambda_shape1_errors(result)
        if after_errors > 0 {
            skipped.push("{path}: the rewrite does not parse ({after_errors} errors), file left alone")
            return MigrationOutcome{text: text, rewritten: 0, skipped: skipped}
        }
    }
    MigrationOutcome{text: result, rewritten: rewritten, skipped: skipped}
}

lambda_shape1_errors: fn(text: String) -> Int {
    parse_generated_source(text.bytes()).diagnostics.filter(fn(d) { d.code.starts_with("E") }).len()
}

LambdaShapeQuoted: struct {
    start: Int
    end: Int
    text: String
    rewritten: Int
}

// A Jet program quoted in a string literal without interpolation holes or
// unread escapes, rewritten in place when the result parses cleanly and
// declares an item, so prose that happens to hold an arrow stays as written.
lambda_shape1_quoted: fn(path: String, bytes: [U8], token: Token, skipped: &[String]) -> LambdaShapeQuoted? {
    raw: lambda_shape1_text(bytes, token.span.start, token.span.end)
    if !raw.contains("->") && !raw.contains("-[") -> return None
    quote: if token.kind == TOKEN_RAW_STRING -> lambda_shape1_fence(raw, 96) else -> lambda_shape1_fence(raw, 34)
    if quote == 0 || raw.len() < quote * 2 -> return None
    inner_raw: lambda_shape1_text(bytes, token.span.start + quote, token.span.end - quote)
    inner: if token.kind == TOKEN_RAW_STRING -> inner_raw.copy() else -> lambda_shape1_unquote(inner_raw) ?? return None
    if token.kind == TOKEN_STRING && lambda_shape1_quote(inner) != inner_raw -> return None
    outcome: lambda_shape1_source("{path}:{lambda_shape1_line(bytes, token.span.start)}", inner)
    if outcome.rewritten == 0 -> return None
    parsed: parse_generated_source(outcome.text.bytes())
    if parsed.program.items.len() == 0 || parsed.diagnostics.any(fn(d) { d.code.starts_with("E") }) -> return None
    loop reason in outcome.skipped -> skipped.push(reason.copy())
    replaced: if token.kind == TOKEN_RAW_STRING -> outcome.text.copy() else -> lambda_shape1_quote(outcome.text)
    if token.kind == TOKEN_RAW_STRING && replaced.contains(lambda_shape1_text(bytes, token.span.start, token.span.start + quote)) -> return None
    Val(LambdaShapeQuoted{start: token.span.start + quote, end: token.span.end - quote, text: replaced, rewritten: outcome.rewritten})
}

// Finds and rewrites the lambdas among one token run: a file's code tokens or
// one interpolation hole's, whose enclosing bracket is `outer`.
lambda_shape1_scan: fn(path: String, bytes: [U8], tables: TokenTables, raw: [Token], outer: Int, edits: &[LambdaShapeEdit], skipped: &[String]) -> Int {
    tokens: lexer_without_comments(raw)
    rewritten := 0
    stack := [Int]{}
    loop index in 0..<tokens.len() {
        token: tokens[index]
        if token.literal >= 0 {
            loop part in tables.literals[token.literal].string_parts {
                if part.kind == STRING_PART_INTERPOLATION -> rewritten += lambda_shape1_scan(path, bytes, tables, part.tokens, TOKEN_LPAREN, edits, skipped)
            }
        }
        enclosing: if stack.len() > 0 -> stack[stack.len() - 1] else -> outer
        params_end := -1
        if lambda_shape1_leads(bytes, tokens, index, enclosing, outer == LAMBDA_SHAPE_SPAN || outer == LAMBDA_SHAPE_TEXT) {
            if token.kind == TOKEN_LPAREN -> params_end = lambda_shape1_match(tokens, index)
            if token.kind == TOKEN_IDENT -> params_end = index
        }
        if params_end >= 0 {
            body: lambda_shape1_after_arrow(tokens, params_end + 1)
            if body > 0 && body < tokens.len() {
                end: lambda_shape1_body_end(bytes, tokens, body, enclosing, stack.len() > 0)
                reason: if end < 0 -> "unclosed group" else -> lambda_shape1_site_edits(bytes, tokens, index, params_end, body, end, edits)
                if {
                    reason == "" -> rewritten += 1
                    else -> skipped.push("{path}:{lambda_shape1_line(bytes, token.span.start)}: {reason}")
                }
            }
        }
        if {
            // A marker's arguments: enclosing `#` keeps them from leading.
            token.kind == TOKEN_LPAREN && index >= 2 && tokens[index - 1].kind == TOKEN_IDENT && tokens[index - 2].kind == TOKEN_HASH -> stack.push(TOKEN_HASH)
            // A collection literal's elements are values, as in `[…]`.
            token.kind == TOKEN_LBRACE && lambda_shape1_collection(tokens, index) -> stack.push(TOKEN_LBRACKET)
            token.kind == TOKEN_LPAREN || token.kind == TOKEN_LBRACKET || token.kind == TOKEN_LBRACE -> stack.push(token.kind)
        }
        if (token.kind == TOKEN_RPAREN || token.kind == TOKEN_RBRACKET || token.kind == TOKEN_RBRACE) && stack.len() > 0 -> _: stack.pop()
    }
    rewritten
}

// A code span (`…` in prose or a string literal, a quoted command-line
// argument): a `(…)` group leads at its start, while a bare name leads only
// inside a call or list and set apart from its arrow, since prose such as
// `value -> print(value)`, `a: b -> c` or `queued -> running` is as likely an
// arm or a path, and `n->refs` is C.
LAMBDA_SHAPE_SPAN: -1

// Text read whole (a string literal or an expected output's line without code
// spans) reads as a code span, except that nothing leads at its start: a text
// such as `(item) -> T` or `(&self) -> Bool` is a signature.
LAMBDA_SHAPE_TEXT: -2

// Whether the token at `index` stands where a value starts, so a `(…)` group or
// a lowercase name there followed by an arrow is a lambda head. A capitalized
// name before an arrow, or first in the group, is a type
// (`change note: String -> Label`, `(Int) -> Int`). A migration's `via { … }`
// converter body is a value, and so is a `(…)` group set apart from the name
// before it (`task (x: Int) -> x`), which a call never is.
lambda_shape1_leads: fn(bytes: [U8], tokens: [Token], index: Int, enclosing: Int, span: Bool) -> Bool {
    kind: tokens[index].kind
    if kind != TOKEN_LPAREN && kind != TOKEN_IDENT -> return false
    if enclosing == TOKEN_HASH -> return false
    if kind == TOKEN_IDENT && lambda_shape1_capital(bytes, tokens[index]) -> return false
    if kind == TOKEN_LPAREN && index + 1 < tokens.len() && tokens[index + 1].kind == TOKEN_IDENT && lambda_shape1_capital(bytes, tokens[index + 1]) -> return false
    if index == 0 -> return enclosing == TOKEN_LPAREN || (enclosing == LAMBDA_SHAPE_SPAN && kind == TOKEN_LPAREN)
    before: tokens[index - 1].kind
    if before == TOKEN_COMMA -> return enclosing == TOKEN_LPAREN || enclosing == TOKEN_LBRACKET
    if span && kind == TOKEN_IDENT {
        if index + 1 >= tokens.len() || tokens[index].span.end == tokens[index + 1].span.start -> return false
        return before == TOKEN_LPAREN || before == TOKEN_LBRACKET
    }
    if before == TOKEN_LBRACE -> return enclosing == TOKEN_LBRACKET || (index >= 2 && tokens[index - 2].kind == TOKEN_IDENT && lambda_shape1_text(bytes, tokens[index - 2].span.start, tokens[index - 2].span.end) == "via")
    if before == TOKEN_IDENT -> return !span && kind == TOKEN_LPAREN && tokens[index - 1].span.end < tokens[index].span.start && !lambda_shape1_capital(bytes, tokens[index - 1])
    before == TOKEN_LPAREN || before == TOKEN_LBRACKET || before == TOKEN_COLON || before == TOKEN_EQ || before == TOKEN_COLON_EQ || before == TOKEN_UNIFIED_ARROW || before == TOKEN_RETURN || before == TOKEN_QUESTION_QUESTION || before == TOKEN_PIPE_GT
}

// Whether the `{` at `index` opens a collection literal (`[T]{…}`,
// `[K: V]{…}`): it follows a `[…]` type that does not index a value.
lambda_shape1_collection: fn(tokens: [Token], index: Int) -> Bool {
    if index < 2 || tokens[index - 1].kind != TOKEN_RBRACKET -> return false
    depth := 0
    at := index - 1
    loop at >= 0 {
        kind: tokens[at].kind
        if kind == TOKEN_RBRACKET -> depth += 1
        if kind == TOKEN_LBRACKET {
            depth -= 1
            if depth == 0 -> break
        }
        at -= 1
    }
    if at <= 0 -> return at == 0
    before: tokens[at - 1].kind
    before != TOKEN_IDENT && before != TOKEN_RPAREN && before != TOKEN_RBRACKET && before != TOKEN_STRING
}

lambda_shape1_capital: fn(bytes: [U8], token: Token) -> Bool {
    bytes[token.span.start] >= 65 && bytes[token.span.start] <= 90
}

// Rewrites the arrow lambdas of the spans between `start` and `end` that one
// line's pairs of `mark` enclose: backticks around code spans, or single
// quotes around a command line's Jet argument. Inside a string literal
// (`doubled`) the inserted braces are doubled. Returns how many it rewrote.
lambda_shape1_spans: fn(bytes: [U8], start: Int, end: Int, mark: Int, doubled: Bool, edits: &[LambdaShapeEdit]) -> Int {
    rewritten := 0
    index := start
    loop index < end {
        if Int.from_u8(bytes[index]) != mark {
            index += 1
            next
        }
        run := index
        loop run < end && Int.from_u8(bytes[run]) == mark -> run += 1
        if run - index != 1 {
            index = run
            next
        }
        close := index + 1
        loop close < end && Int.from_u8(bytes[close]) != mark && bytes[close] != 10 -> close += 1
        if close >= end || Int.from_u8(bytes[close]) != mark {
            index = close
            next
        }
        rewritten += lambda_shape1_span(bytes, index + 1, close, LAMBDA_SHAPE_SPAN, doubled, edits)
        index = close + 1
    }
    rewritten
}

// A string literal without code spans read whole as one, for a quoted
// fragment such as `parse("xs.map((x) -> x + 1)")`. A literal with escapes is
// read through them and written back quoted.
lambda_shape1_snippet: fn(bytes: [U8], token: Token, edits: &[LambdaShapeEdit]) -> Int {
    raw: lambda_shape1_text(bytes, token.span.start, token.span.end)
    if !raw.contains("->") && !raw.contains("-[") -> return 0
    raw_string: token.kind == TOKEN_RAW_STRING
    quote: if raw_string -> lambda_shape1_fence(raw, 96) else -> lambda_shape1_fence(raw, 34)
    if quote == 0 || raw.len() < quote * 2 -> return 0
    from: token.span.start + quote
    to: token.span.end - quote
    inner_raw: lambda_shape1_text(bytes, from, to)
    if raw_string || !inner_raw.contains("\\") -> return lambda_shape1_plain(bytes, from, to, !raw_string, edits)
    inner: lambda_shape1_unquote(inner_raw) ?? return 0
    if lambda_shape1_quote(inner) != inner_raw -> return 0
    inner_bytes: inner.bytes()
    inner_edits := [LambdaShapeEdit]{}
    count: lambda_shape1_plain(inner_bytes, 0, inner_bytes.len(), false, inner_edits)
    if count == 0 -> return 0
    rewritten_inner: lambda_shape1_apply(inner_bytes, inner_edits) ?? return 0
    edits.push(LambdaShapeEdit{start: from, end: to, text: lambda_shape1_quote(rewritten_inner)})
    count
}

// A text without code spans: a command line's single-quoted arguments
// (`jet -e '…'`) when it has any, otherwise the whole text as one span.
lambda_shape1_plain: fn(bytes: [U8], from: Int, to: Int, doubled: Bool, edits: &[LambdaShapeEdit]) -> Int {
    loop at in from..<to {
        if bytes[at] == 39 -> return lambda_shape1_spans(bytes, from, to, 39, doubled, edits)
    }
    lambda_shape1_span(bytes, from, to, LAMBDA_SHAPE_TEXT, doubled, edits)
}

// Rewrites the arrow lambdas of one code span or text, the bytes from `from`
// to `to`, all or none; `mode` is `LAMBDA_SHAPE_SPAN` or `LAMBDA_SHAPE_TEXT`.
// Returns how many it rewrote.
lambda_shape1_span: fn(bytes: [U8], from: Int, to: Int, mode: Int, doubled: Bool, edits: &[LambdaShapeEdit]) -> Int {
    // A `…` placeholder reads as a name of its three bytes.
    written: String.from_bytes(bytes[from..<to]) ?? ""
    placeholder: written.contains("…") && !written.contains("___")
    content: if placeholder -> written.replace("…", "___").bytes() else -> written.bytes()
    lexed: lex_generated(content)
    span_edits := [LambdaShapeEdit]{}
    span_skipped := [String]{}
    count: lambda_shape1_scan("", content, lexed.tables, lexed.tokens, mode, span_edits, span_skipped)
    if count == 0 || span_skipped.len() > 0 -> return 0
    loop edit in span_edits {
        restored: if placeholder -> edit.text.replace("___", "…") else -> edit.text.copy()
        text: if doubled -> restored.replace("{{", "{{{{").replace("}}", "}}}}") else -> restored
        edits.push(LambdaShapeEdit{start: edit.start + from, end: edit.end + from, text: text, order: edit.order + from})
    }
    count
}

// The index of the first token after the arrow at `at` (`->` or `-[E]>`), or
// -1 when no arrow starts there.
lambda_shape1_after_arrow: fn(tokens: [Token], at: Int) -> Int {
    if at >= tokens.len() -> return -1
    if tokens[at].kind == TOKEN_UNIFIED_ARROW -> return at + 1
    if tokens[at].kind != TOKEN_MINUS || at + 1 >= tokens.len() || tokens[at + 1].kind != TOKEN_LBRACKET || tokens[at].span.end != tokens[at + 1].span.start -> return -1
    close: lambda_shape1_match(tokens, at + 1)
    if close < 0 || close + 1 >= tokens.len() || tokens[close + 1].kind != TOKEN_GT || tokens[close].span.end != tokens[close + 1].span.start -> return -1
    close + 2
}

// The byte offset where the body starting at token `body` ends: before the
// comma, `;` or closer at its own depth, or, in a braced context, at the end
// of the line unless the next line continues the expression. A `{` body whose
// closer lies past the text (a span quoting a lambda's first line) ends at its
// `{`. -1 when a value body inside a `(…)` or `[…]` opened in these tokens
// (`opened`) runs past the text, which is then prose with a stray parenthesis.
lambda_shape1_body_end: fn(bytes: [U8], tokens: [Token], body: Int, enclosing: Int, opened: Bool) -> Int {
    if tokens[body].kind == TOKEN_LBRACE && lambda_shape1_match(tokens, body) < 0 -> return tokens[body].span.end
    depth := 0
    last := body
    index := body
    loop index < tokens.len() {
        kind: tokens[index].kind
        closer: kind == TOKEN_RPAREN || kind == TOKEN_RBRACKET || kind == TOKEN_RBRACE
        if depth == 0 && index > body {
            if kind == TOKEN_COMMA || closer || (kind == TOKEN_SEMI && tokens[index].span.end > tokens[index].span.start && bytes[tokens[index].span.start] == 59) -> break
            if enclosing == TOKEN_LBRACE && lambda_shape1_newline(bytes, tokens[index - 1].span.end, tokens[index].span.start) && !lambda_shape1_continues(tokens, index) -> break
        }
        if kind == TOKEN_LPAREN || kind == TOKEN_LBRACKET || kind == TOKEN_LBRACE -> depth += 1
        if closer {
            if depth == 0 -> break
            depth -= 1
        }
        last = index
        index += 1
    }
    if index == tokens.len() && opened && (enclosing == TOKEN_LPAREN || enclosing == TOKEN_LBRACKET) -> return -1
    tokens[last].span.end
}

// Whether the line starting at token `index` goes on with the expression
// before it.
lambda_shape1_continues: fn(tokens: [Token], index: Int) -> Bool {
    next_kind: tokens[index].kind
    before: tokens[index - 1].kind
    next_kind == TOKEN_DOT || next_kind == TOKEN_QUESTION_DOT || next_kind == TOKEN_QUESTION_QUESTION || next_kind == TOKEN_AND_AND || next_kind == TOKEN_OR_OR || next_kind == TOKEN_PIPE_GT || next_kind == TOKEN_KW_ELSE || before == TOKEN_UNIFIED_ARROW || before == TOKEN_QUESTION_QUESTION || before == TOKEN_AND_AND || before == TOKEN_OR_OR || before == TOKEN_PIPE_GT || before == TOKEN_EQ
}

// The edits for the lambda whose head starts at token `first`, whose
// parameters end at token `params_end` and whose body runs from token `body`
// to byte `end`; or the reason it was left alone.
lambda_shape1_site_edits: fn(bytes: [U8], tokens: [Token], first: Int, params_end: Int, body: Int, end: Int, edits: &[LambdaShapeEdit]) -> String {
    start: tokens[first].span.start
    bare: tokens[first].kind == TOKEN_IDENT
    head_end: tokens[params_end].span.end
    arrow: tokens[params_end + 1]
    body_from: tokens[body - 1].span.end
    row: if arrow.kind == TOKEN_MINUS -> " {lambda_shape1_text(bytes, arrow.span.start, body_from)}" else -> ""
    body_start: tokens[body].span.start
    body_close: if tokens[body].kind == TOKEN_LBRACE -> lambda_shape1_match(tokens, body) else -> -1
    braced: tokens[body].kind == TOKEN_LBRACE && (body_close < 0 || tokens[body_close].span.end == end)
    // A value body that starts on a later line keeps its lines; its closing
    // brace then sits on its own line at the lambda line's indent.
    split: !braced && lambda_shape1_newline(bytes, body_from, body_start)
    open_body: if {
        braced -> " "
        split -> " {{{lambda_shape1_text(bytes, body_from, body_start)}"
        else -> " {{ "
    }
    close_params: if bare -> ")" else -> ""
    body_kind: tokens[body].kind
    if end <= body_start || body_kind == TOKEN_COMMA || body_kind == TOKEN_RPAREN || body_kind == TOKEN_RBRACKET || body_kind == TOKEN_RBRACE -> return "empty body"
    edits.push(LambdaShapeEdit{start: start, end: start, text: if bare -> "fn(" else -> "fn"})
    edits.push(LambdaShapeEdit{start: head_end, end: body_start, text: "{close_params}{row}{open_body}"})
    if !braced -> edits.push(LambdaShapeEdit{start: end, end: end, text: if split -> "\n{lambda_shape1_indent(bytes, start)}}}" else -> " }}", order: start})
    ""
}

// Applies `edits`; None when two overlap. At one offset, insertions precede
// replacements, and the closers of nested lambdas that end together close the
// innermost (latest-starting) first.
lambda_shape1_apply: fn(bytes: [U8], edits: &[LambdaShapeEdit]) -> String? {
    edits.sort_by(fn(left, right) {
        if {
            left.start != right.start -> left.start <=> right.start
            left.end - left.start != right.end - right.start -> (left.end - left.start) <=> (right.end - right.start)
            else -> right.order <=> left.order
        }
    })
    out := [String]{}
    cursor := 0
    loop edit in edits {
        if edit.start < cursor -> return None
        out.push(lambda_shape1_text(bytes, cursor, edit.start))
        out.push(edit.text.copy())
        cursor = edit.end
    }
    out.push(lambda_shape1_text(bytes, cursor, bytes.len()))
    Val(out.join(""))
}

// The index of the closer matching the opener at `open`, or -1.
lambda_shape1_match: fn(tokens: [Token], open: Int) -> Int {
    opener: tokens[open].kind
    closer: if {
        opener == TOKEN_LPAREN -> TOKEN_RPAREN
        opener == TOKEN_LBRACKET -> TOKEN_RBRACKET
        else -> TOKEN_RBRACE
    }
    depth := 0
    index := open
    loop index < tokens.len() {
        kind: tokens[index].kind
        if kind == opener -> depth += 1
        if kind == closer {
            depth -= 1
            if depth == 0 -> return index
        }
        index += 1
    }
    -1
}

lambda_shape1_text: fn(bytes: [U8], start: Int, end: Int) -> String {
    String.from_bytes(bytes[start..<end]) ?? ""
}

lambda_shape1_line: fn(bytes: [U8], offset: Int) -> Int {
    line := 1
    loop index in 0..<offset {
        if bytes[index] == 10 -> line += 1
    }
    line
}

lambda_shape1_newline: fn(bytes: [U8], start: Int, end: Int) -> Bool {
    loop index in start..<end {
        if bytes[index] == 10 -> return true
    }
    false
}

// The leading blanks of the line holding `offset`.
lambda_shape1_indent: fn(bytes: [U8], offset: Int) -> String {
    start := offset
    loop start > 0 && bytes[start - 1] != 10 -> start -= 1
    end := start
    loop end < bytes.len() && (bytes[end] == 32 || bytes[end] == 9) -> end += 1
    lambda_shape1_text(bytes, start, end)
}

// How many `mark` bytes open `raw`.
lambda_shape1_fence: fn(raw: String, mark: Int) -> Int {
    bytes: raw.bytes()
    count := 0
    loop count < bytes.len() && Int.from_u8(bytes[count]) == mark -> count += 1
    count
}

// A quoted string's source text: `{{`/`}}` undoubled and the escapes `\\`,
// `\"`, `\n`, `\t` read; None when it holds an interpolation hole or any
// other escape.
lambda_shape1_unquote: fn(raw: String) -> String? {
    bytes: raw.bytes()
    out := [U8]{}
    index := 0
    loop index < bytes.len() {
        byte: Int.from_u8(bytes[index])
        if byte == 92 {
            if index + 1 >= bytes.len() -> return None
            escaped: Int.from_u8(bytes[index + 1])
            if {
                escaped == 92 || escaped == 34 -> out.push(bytes[index + 1])
                escaped == 110 -> out.push(U8{10})
                escaped == 116 -> out.push(U8{9})
                else -> return None
            }
            index += 2
            next
        }
        if byte == 123 || byte == 125 {
            if index + 1 >= bytes.len() || Int.from_u8(bytes[index + 1]) != byte -> return None
            out.push(bytes[index])
            index += 2
            next
        }
        out.push(bytes[index])
        index += 1
    }
    Val(String.from_bytes(out) ?? "")
}

// The quoted-string spelling of `text`, the inverse of `lambda_shape1_unquote`.
lambda_shape1_quote: fn(text: String) -> String {
    text.replace("\\", "\\\\").replace("\"", "\\\"").replace("\n", "\\n").replace("\t", "\\t").replace("{{", "{{{{").replace("}}", "}}}}")
}

// A Markdown file: each ```jet fence is rewritten in place, and so are the
// code spans of its prose. Other fences stay as written.
lambda_shape1_markdown: fn(path: String, text: String) -> MigrationOutcome {
    lines: text.split("\n").to_list()
    out := [String]{}
    skipped := [String]{}
    rewritten := 0
    index := 0
    loop index < lines.len() {
        line: lines[index].copy()
        index += 1
        if !line.trim().starts_with("```") {
            line_bytes: line.bytes()
            edits := [LambdaShapeEdit]{}
            count: lambda_shape1_spans(line_bytes, 0, line_bytes.len(), 96, false, edits)
            if {
                count > 0 && lambda_shape1_apply(line_bytes, edits) == .Val(rewritten_line) -> {
                    rewritten += count
                    out.push(rewritten_line)
                }
                else -> out.push(line)
            }
            next
        }
        fence: line.trim() == "```jet"
        out.push(line)
        block := [String]{}
        loop index < lines.len() && lines[index].trim() != "```" {
            block.push(lines[index].copy())
            index += 1
        }
        if {
            fence && block.len() > 0 -> {
                outcome: lambda_shape1_source("{path}:{index - block.len()}", block.join("\n"))
                loop reason in outcome.skipped -> skipped.push(reason.copy())
                rewritten += outcome.rewritten
                loop rewritten_line in outcome.text.split("\n") -> out.push(rewritten_line.copy())
            }
            else -> {
                loop kept in block -> out.push(kept)
            }
        }
        // The closing fence.
        if index < lines.len() {
            out.push(lines[index].copy())
            index += 1
        }
    }
    MigrationOutcome{text: out.join("\n"), rewritten: rewritten, skipped: skipped}
}
