// The registered source migrations: one plan per breaking language change,
// named by the toolchain it moves code to and the decision it carries out.
// Each plan finds the old spelling without the parser, which no longer reads
// it, and each has an old-spelling fixture that tests/cases/migrations replays.
// Usage: jet run Compiler/Migrations/Migrate.jet -- <plan> [--write] PATH...
name: "jet_migrations"
version: "0.0.1"
edition: "2026"
authority: { allow: [FS, IO, Mem.Alloc] }
deps: {
    jet_foundation: ../JetFoundation,
    jet_lexer: ../JetLexer,
    jet_parser: ../JetParser,
}
