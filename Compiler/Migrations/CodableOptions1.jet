// Toolchain a0.0.45: every retired wire marker becomes an option of
// `#Codable`, and `#CodableAsBase` goes, since a distinct type codes as its
// base without it. `#Encode` or `#Decode` alone is `only: .Encode` or
// `only: .Decode` (both, or either beside `#Codable`, is plain `#Codable`).
// `#!Encode` and `#!Decode` are left for a person: the spelling depends on
// whether the type writes its other codec by hand, which the text does not
// say. `#DenyUnknownFields` is `unknown: .Deny`, `#Discriminant(k)` is
// `tag: .Field(k)`, `#Untagged` is `tag: .None` and `#PublishedSchema` is
// `published`; a field's `#Skip` and `#Flatten` are `#Codable(.Skip)` and
// `#Codable(.Flatten)`. The marker groups stacked on one declaration, with
// only blank space between them, share one `#Codable`, written where the first
// wire marker stood, and a group left empty goes with its line. The old
// spellings are not Jet from this toolchain on, so the plan reads the text,
// never a parse: a marker in a comment, a string (after a `\n` escape too), a
// Markdown file or an expected output is rewritten the same way.

// One entry of a marker group, `!Name(args)`.
CodableOptionsEntry: struct {
    text: String,
    name: String,
    negated: Bool,
    args: String?{None},
}

// One marker group: `#Name(args)` or `#[a, b]`, from its `#` to its end.
CodableOptionsGroup: struct {
    start: Int,
    end: Int,
    entries: [CodableOptionsEntry],
}

CodableOptionsEdit: struct {
    start: Int,
    end: Int,
    text: String,
}

// The entries the plan rewrites, from the marker groups of one declaration.
CodableOptionsMerge: struct {
    // The `#Codable` entry written in place of the wire markers; None when
    // they all go (`#CodableAsBase` alone).
    codable: String?{None},
    // Why the run is left alone; None when it is rewritten.
    problem: String?{None},
}

codable_options1_retired: fn(name: String) -> Bool {
    name == "CodableAsBase" || name == "PublishedSchema" || name == "Skip" || name == "Flatten" || name == "DenyUnknownFields" || name == "Untagged" || name == "Discriminant" || name == "Encode" || name == "Decode"
}

// Rewrites the retired wire markers of one file of any kind.
codable_options1_file: fn(path: String, text: String) -> MigrationOutcome {
    bytes: text.bytes()
    edits := [CodableOptionsEdit]{}
    skipped := [String]{}
    rewritten := 0
    at := 0
    loop at < bytes.len() {
        first: codable_options1_group(bytes, at) ?? {
            at += 1
            next
        }
        run := [CodableOptionsGroup]{first}
        end := first.end
        loop {
            more: codable_options1_group(bytes, codable_options1_blank(bytes, end)) ?? break
            end = more.end
            run.push(more)
        }
        at = end
        sites := 0
        loop group in run {
            loop entry in group.entries {
                if codable_options1_retired(entry.name) -> sites += 1
            }
        }
        if sites == 0 -> next
        merge: codable_options1_merge(run)
        if merge.problem == .Val(problem) {
            skipped.push("{path}:{codable_options1_line(bytes, run[0].start)}: {problem}")
            next
        }
        codable_options1_run_edits(bytes, run, merge.codable, edits)
        rewritten += sites
    }
    if rewritten == 0 -> return MigrationOutcome{text: text, rewritten: 0, skipped: skipped}
    out := [String]{}
    cursor := 0
    loop edit in edits {
        out.push(codable_options1_text(bytes, cursor, edit.start))
        out.push(edit.text.copy())
        cursor = edit.end
    }
    out.push(codable_options1_text(bytes, cursor, bytes.len()))
    MigrationOutcome{text: out.join(""), rewritten: rewritten, skipped: skipped}
}

// The `#Codable` entry one declaration's wire markers become.
codable_options1_merge: fn(run: [CodableOptionsGroup]) -> CodableOptionsMerge {
    wire := false
    codable := false
    encode := false
    decode := false
    form := ""
    args := [String]{}
    options := [String]{}
    loop group in run {
        loop entry in group.entries {
            if entry.negated {
                if {
                    entry.name == "Encode" -> return CodableOptionsMerge{problem: Val("`#!Encode` refuses one codec: write `#!Codable` when the type writes its decoder by hand, else `#Codable(only: .Decode)`")}
                    entry.name == "Decode" -> return CodableOptionsMerge{problem: Val("`#!Decode` refuses one codec: write `#!Codable` when the type writes its encoder by hand, else `#Codable(only: .Encode)`")}
                    codable_options1_retired(entry.name) -> return CodableOptionsMerge{problem: Val("`#!{entry.name}` has no `#Codable` option")}
                }
                next
            }
            if entry.name == "Codable" {
                wire = true
                codable = true
                if entry.args == .Val(written) -> args.push(written.copy())
                next
            }
            if !codable_options1_retired(entry.name) -> next
            if entry.name != "CodableAsBase" -> wire = true
            if entry.args != None && entry.name != "Discriminant" {
                return CodableOptionsMerge{problem: Val("`#{entry.name}` takes no arguments")}
            }
            if {
                entry.name == "Encode" -> encode = true
                entry.name == "Decode" -> decode = true
                entry.name == "DenyUnknownFields" -> options.push("unknown: .Deny")
                entry.name == "Untagged" -> options.push("tag: .None")
                entry.name == "PublishedSchema" -> options.push("published")
                entry.name == "Skip" -> form = ".Skip"
                entry.name == "Flatten" -> form = ".Flatten"
                entry.name == "Discriminant" -> {
                    key: entry.args ?? return CodableOptionsMerge{problem: Val("`#Discriminant` without its key")}
                    options.push("tag: .Field({key})")
                }
            }
        }
    }
    if !wire && form == "" && options.len() == 0 -> return CodableOptionsMerge{}
    only := ""
    if !codable {
        if {
            encode && !decode -> only = "only: .Encode"
            decode && !encode -> only = "only: .Decode"
        }
    }
    if only != "" && args.any(fn(written) { written.contains("only:") }) {
        return CodableOptionsMerge{problem: Val("`#Codable` already names its direction")}
    }
    written := [String]{}
    if form != "" -> written.push(form.copy())
    loop arg in args -> written.push(arg.copy())
    if only != "" -> written.push(only.copy())
    loop option in options -> written.push(option.copy())
    CodableOptionsMerge{codable: Val(if written.len() == 0 -> "Codable" else -> "Codable({written.join(", ")})")}
}

// The edits of one declaration's marker groups: each keeps its other entries,
// the first to hold a wire marker takes `codable` in its place, and a group
// left empty is removed, with its line when it stood alone on it.
codable_options1_run_edits: fn(bytes: [U8], run: [CodableOptionsGroup], codable: String?, edits: &[CodableOptionsEdit]) {
    placed := false
    loop group in run {
        entries := [String]{}
        changed := false
        loop entry in group.entries {
            wire: (codable_options1_retired(entry.name) || entry.name == "Codable") && !(entry.negated && entry.name == "Codable")
            if !wire {
                entries.push(entry.text.copy())
                next
            }
            changed = true
            if !placed {
                placed = true
                if codable == .Val(text) -> entries.push(text.copy())
            }
        }
        if !changed -> next
        if entries.len() > 0 {
            text: if entries.len() == 1 -> "#{entries[0]}" else -> "#[{entries.join(", ")}]"
            if text != codable_options1_text(bytes, group.start, group.end) {
                edits.push(CodableOptionsEdit{start: group.start, end: group.end, text: text})
            }
            next
        }
        start := group.start
        loop start > 0 && (bytes[start - 1] == 32 || bytes[start - 1] == 9) -> start -= 1
        end := group.end
        loop end < bytes.len() && (bytes[end] == 32 || bytes[end] == 9) -> end += 1
        alone: (start == 0 || bytes[start - 1] == 10) && (end == bytes.len() || bytes[end] == 10)
        if {
            alone && end < bytes.len() -> {
                edits.push(CodableOptionsEdit{start: start, end: end + 1, text: ""})
            }
            alone -> edits.push(CodableOptionsEdit{start: start, end: end, text: ""})
            codable_options1_escaped_break(bytes, start - 2) && codable_options1_escaped_break(bytes, end) -> {
                edits.push(CodableOptionsEdit{start: start, end: end + 2, text: ""})
            }
            else -> edits.push(CodableOptionsEdit{start: group.start, end: end, text: ""})
        }
    }
}

// The marker group whose `#` is at `at`; None when none starts there.
codable_options1_group: fn(bytes: [U8], at: Int) -> CodableOptionsGroup? {
    if at >= bytes.len() || bytes[at] != 35 -> return None
    if at > 0 && (codable_options1_word(bytes[at - 1]) || bytes[at - 1] == 35) && !codable_options1_escaped_break(bytes, at - 2) {
        return None
    }
    if at + 1 < bytes.len() && bytes[at + 1] == 91 {
        close: codable_options1_close(bytes, at + 1)
        if close < 0 -> return None
        entries := [CodableOptionsEntry]{}
        piece := at + 2
        depth := 0
        loop index in (at + 2)..<(close + 1) {
            byte: bytes[index]
            if byte == 40 || byte == 91 -> depth += 1
            if byte == 41 || byte == 93 -> depth -= 1
            if index == close || (byte == 44 && depth == 0) {
                entries.push(codable_options1_entry(codable_options1_text(bytes, piece, index).trim()) ?? return None)
                piece = index + 1
            }
        }
        return Val(CodableOptionsGroup{start: at, end: close + 1, entries: entries})
    }
    end := at + 1
    if end < bytes.len() && bytes[end] == 33 -> end += 1
    if end >= bytes.len() || bytes[end] < 65 || bytes[end] > 90 -> return None
    loop end < bytes.len() && codable_options1_word(bytes[end]) -> end += 1
    if end < bytes.len() && bytes[end] == 40 {
        close: codable_options1_close(bytes, end)
        if close < 0 -> return None
        end = close + 1
    }
    entry: codable_options1_entry(codable_options1_text(bytes, at + 1, end)) ?? return None
    Val(CodableOptionsGroup{start: at, end: end, entries: [CodableOptionsEntry]{entry}})
}

// One `!Name(args)` entry; None for any other text.
codable_options1_entry: fn(text: String) -> CodableOptionsEntry? {
    bytes: text.bytes()
    at := 0
    negated: bytes.len() > 0 && bytes[0] == 33
    if negated -> at = 1
    if at >= bytes.len() || bytes[at] < 65 || bytes[at] > 90 -> return None
    end := at
    loop end < bytes.len() && codable_options1_word(bytes[end]) -> end += 1
    name: codable_options1_text(bytes, at, end)
    if end == bytes.len() {
        return Val(CodableOptionsEntry{text: text.copy(), name: name, negated: negated})
    }
    if bytes[end] != 40 || codable_options1_close(bytes, end) != bytes.len() - 1 -> return None
    Val(CodableOptionsEntry{text: text.copy(), name: name, negated: negated, args: Val(codable_options1_text(bytes, end + 1, bytes.len() - 1))})
}

// The offset of the bracket closing the `(` or `[` at `open` on its line, or
// -1.
codable_options1_close: fn(bytes: [U8], open: Int) -> Int {
    depth := 0
    loop index in open..<bytes.len() {
        byte: bytes[index]
        if byte == 10 -> return -1
        if byte == 40 || byte == 91 -> depth += 1
        if byte == 41 || byte == 93 {
            depth -= 1
            if depth == 0 -> return index
        }
    }
    -1
}

// The offset after the blank space (spaces, tabs, line breaks, and a string's
// `\n` escapes) at `at`.
codable_options1_blank: fn(bytes: [U8], at: Int) -> Int {
    end := at
    loop end < bytes.len() {
        if bytes[end] == 32 || bytes[end] == 9 || bytes[end] == 10 || bytes[end] == 13 -> end += 1 else if codable_options1_escaped_break(bytes, end) {
            end += 2
        } else { break }
    }
    end
}

// Whether a string's `\n` escape starts at `at`: a marker after one opens a
// line of the string's text.
codable_options1_escaped_break: fn(bytes: [U8], at: Int) -> Bool {
    at >= 0 && at + 1 < bytes.len() && bytes[at] == 92 && bytes[at + 1] == 110
}

codable_options1_word: fn(byte: U8) -> Bool {
    (byte >= 48 && byte <= 57) || (byte >= 65 && byte <= 90) || (byte >= 97 && byte <= 122) || byte == 95
}

codable_options1_text: fn(bytes: [U8], start: Int, end: Int) -> String {
    String.from_bytes(bytes[start..<end]) ?? ""
}

codable_options1_line: fn(bytes: [U8], offset: Int) -> Int {
    line := 1
    loop index in 0..<offset {
        if bytes[index] == 10 -> line += 1
    }
    line
}
