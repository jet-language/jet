// Runtime-object-only C witnesses: exercise the validated private helpers
// across the real System V Float/word call and result boundary.
// Shipping sources.list deliberately does not include these test exports.
#Export(c) fn jet_rt_test_f64_bits(value: Float) -> I64 { rt_f64_bits(value) }

#Export(c) fn jet_rt_test_f64_from_bits(bits: I64) -> Float { rt_f64_from_bits(bits) }
