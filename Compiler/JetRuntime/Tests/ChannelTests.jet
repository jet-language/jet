// Runtime-only ownership/stop fixtures. No alternate queue, lock or scheduler.
// Descriptor and callback code addresses are supplied by the C transport.
fn channel_fixture_check(ok: Bool) {
    if !ok -> jet_rt_unreachable(I64{0}, I64{0})
}

#Export(c) fn jet_rt_channel_fixture_reservations(meta: I64) {
    endpoints :: jet_rt_alloc(I64{24}, I64{8})
    jet_rt_native_channel(I64{1}, I64{1}, endpoints, endpoints + I64{8})
    tx :: sync_load(endpoints)
    rx :: sync_load(endpoints + I64{8})
    sync_store(endpoints + I64{16}, I64{17})
    reservation :: channel_reserve_send(tx, meta)
    channel_fixture_check(reservation != I64{0})
    channel_fixture_check(sync_load(tx + I64{80}) == I64{1})
    channel_reservation_drop(reservation)
    channel_fixture_check(sync_load(tx + I64{80}) == I64{0})
    committed :: channel_reserve_send(tx, meta)
    channel_fixture_check(channel_reservation_commit(committed, endpoints + I64{16}))
    channel_fixture_check(jet_rt_native_receiver_receive(rx, endpoints + I64{16}) == I64{1})
    channel_fixture_check(sync_load(endpoints + I64{16}) == I64{17})
    rejected :: channel_reserve_send(tx, meta)
    jet_rt_native_receiver_close(rx)
    channel_fixture_check(!channel_reservation_commit(rejected, endpoints + I64{16}))
    channel_fixture_check(sync_load(tx + I64{80}) == I64{0})
    channel_fixture_check(sync_load(endpoints + I64{16}) == I64{17})
    jet_rt_native_sender_drop(tx)
    jet_rt_native_receiver_drop(rx)
    jet_rt_free(endpoints, I64{24}, I64{8})
}

// A real stopped callback: out is deliberately untouched and the current
// task's delivered rail is published, just as an emitted task-body stop does.
#Export(c) fn jet_rt_channel_fixture_stop(_env: I64, _input: I64, _output: I64) -> I64 {
    reason :: channel_text(I64{4})
    record :: scheduler_stop_new(I64{5}, reason)
    _ := scheduler_native_publish(record)
    I64{0}
}

#Export(c) fn jet_rt_channel_fixture_stops(meta: I64, stopped_callback: I64, owned_meta: I64, ordinary_callback: I64) {
    endpoints :: jet_rt_alloc(I64{24}, I64{8})
    save :: jet_rt_alloc(I64{32}, I64{8})
    control :: scheduler_control_new()
    jet_rt_native_channel(I64{0}, I64{0}, endpoints, endpoints + I64{8})
    tx :: sync_load(endpoints)
    rx :: sync_load(endpoints + I64{8})
    sync_store(endpoints + I64{16}, I64{42})
    jet_rt_native_sender_send(tx, endpoints + I64{16}, meta)
    scheduler_control_enter(control, save)
    scheduler_control_cancel(control)
    channel_fixture_check(!channel_iter_pull(rx, endpoints + I64{16}))
    channel_fixture_check(sync_load(endpoints + I64{16}) == I64{42})
    channel_fixture_check(jet_scheduler_native_status() == I64{1})
    jet_rt_native_sender_send(tx, endpoints + I64{16}, owned_meta)
    channel_fixture_check(sync_load(tx + I64{16}) == I64{1})
    sync_store(control + I64{16}, I64{0})
    scheduler_control_discard_stop(control)
    channel_fixture_check(channel_iter_pull(rx, endpoints + I64{16}))
    channel_fixture_check(sync_load(endpoints + I64{16}) == I64{42})
    shared :: jet_rt_native_shared_new(endpoints + I64{16}, meta, I64{0})
    sync_store(endpoints + I64{16}, I64{987})
    jet_rt_native_shared_edit(shared, I64{0}, stopped_callback, endpoints + I64{16})
    channel_fixture_check(sync_load(endpoints + I64{16}) == I64{987})
    channel_fixture_check(sync_load(shared + I64{48}) == I64{0})
    channel_fixture_check(sync_load(shared + I64{32}) == I64{0})
    channel_fixture_check(sync_load(shared + I64{72}) == I64{0})
    channel_fixture_check(jet_scheduler_native_status() == I64{5})
    scheduler_control_discard_stop(control)
    shared_acquire(shared, false)
    shared_release(shared, false)
    sync_store(shared + I64{48}, I64{-1})
    jet_rt_native_shared_edit(shared, I64{0}, ordinary_callback, endpoints + I64{16})
    channel_fixture_check(sync_load(endpoints + I64{16}) == I64{987})
    channel_fixture_check(sync_load(shared + I64{48}) == I64{-1})
    channel_fixture_check(sync_load(shared + I64{32}) == I64{0})
    channel_fixture_check(jet_scheduler_native_status() == I64{5})
    scheduler_control_discard_stop(control)
    jet_rt_native_shared_drop(shared)
    scheduler_control_leave(save)
    scheduler_control_drop(control)
    jet_rt_native_sender_drop(tx)
    jet_rt_native_receiver_drop(rx)
    jet_rt_free(endpoints, I64{24}, I64{8})
    jet_rt_free(save, I64{32}, I64{8})
}

#Export(c) fn jet_rt_channel_fixture_shared_guard_stops(meta: I64) {
    storage :: jet_rt_alloc(I64{40}, I64{8})
    sync_store(storage, I64{17})
    shared :: jet_rt_native_shared_new(storage, meta, I64{0})
    control :: scheduler_control_new()
    scheduler_control_enter(control, storage + I64{8})
    guard :: jet_rt_native_shared_guard_edit(shared)
    channel_fixture_check(guard == shared)
    channel_fixture_check(sync_load(jet_rt_native_shared_edit_guard_read(guard)) == I64{17})
    jet_rt_native_shared_edit_guard_drop(guard)
    channel_fixture_check(sync_load(shared + I64{48}) == I64{1})
    stopped :: jet_rt_native_shared_guard_edit(shared)
    _ := jet_rt_channel_fixture_stop(I64{0}, I64{0}, I64{0})
    jet_rt_native_shared_edit_guard_drop(stopped)
    channel_fixture_check(sync_load(shared + I64{48}) == I64{2})
    channel_fixture_check(jet_scheduler_native_status() == I64{5})
    scheduler_control_discard_stop(control)
    sync_store(shared + I64{48}, I64{-1})
    exhausted :: jet_rt_native_shared_guard_edit(shared)
    channel_fixture_check(jet_rt_native_shared_guard_revision(exhausted) == I64{-1})
    channel_fixture_check(jet_rt_native_shared_edit_guard_edit(exhausted) == jet_rt_native_shared_edit_guard_read(exhausted))
    jet_rt_native_shared_edit_guard_drop(exhausted)
    channel_fixture_check(sync_load(shared + I64{32}) == I64{0})
    channel_fixture_check(sync_load(shared + I64{24}) == I64{0})
    channel_fixture_check(sync_load(shared + I64{72}) == I64{0})
    channel_fixture_check(sync_load(shared) == I64{1})
    channel_fixture_check(sync_load(shared + I64{48}) == I64{-1})
    channel_fixture_check(jet_scheduler_native_status() == I64{5})
    scheduler_control_discard_stop(control)
    final_read :: jet_rt_native_shared_guard_read(shared)
    channel_fixture_check(sync_load(jet_rt_native_shared_read_guard_deref(final_read)) == I64{17})
    jet_rt_native_shared_read_guard_drop(final_read)
    jet_rt_native_shared_drop(shared)
    scheduler_control_leave(storage + I64{8})
    scheduler_control_drop(control)
    jet_rt_free(storage, I64{40}, I64{8})
}

// Read-only fixture observation of the canonical permit state. The policy
// remains in shared_acquire; there is no fixture lock implementation.
#Export(c) fn jet_rt_channel_fixture_writers_waiting(shared: I64) -> I64 {
    sync_mutex_lock(shared + I64{8})
    waiting :: sync_load(shared + I64{40})
    sync_mutex_unlock(shared + I64{8})
    waiting
}

// A selector woke on the later channel but selected an earlier arm. Both
// canonical kernels must pass the unused wake to the plain receiver.
#Export(c) fn jet_rt_channel_fixture_select_wake_handoff(meta: I64) -> I64 {
    storage :: jet_rt_alloc(I64{64}, I64{8})
    jet_rt_native_channel(I64{0}, I64{0}, storage, storage + I64{8})
    jet_rt_native_channel(I64{0}, I64{0}, storage + I64{16}, storage + I64{24})
    early :: sync_load(storage + I64{8})
    late :: sync_load(storage + I64{24})
    plain_park :: sync_park_new()
    select_park :: sync_park_new()
    plain :: channel_wait_new(plain_park)
    first :: channel_wait_new(select_park)
    second :: channel_wait_new(select_park)
    sync_mutex_lock(late)
    channel_wait_add(late, plain, false)
    channel_wait_add(late, second, false)
    sync_mutex_unlock(late)
    sync_mutex_lock(early)
    channel_wait_add(early, first, false)
    sync_mutex_unlock(early)
    sync_store(storage + I64{32}, I64{10})
    jet_rt_native_sender_send(sync_load(storage), storage + I64{32}, meta)
    sync_store(storage + I64{32}, I64{20})
    jet_rt_native_sender_send(sync_load(storage + I64{16}), storage + I64{32}, meta)
    channel_fixture_check((sync_load(first + I64{16}).bit_and(I64{1})) == I64{0})
    channel_fixture_check((sync_load(second + I64{16}).bit_and(I64{1})) == I64{0})
    // This is the selector's actual re-registration sequence after wake.
    sync_mutex_lock(early)
    channel_wait_add(early, first, false)
    sync_mutex_unlock(early)
    sync_mutex_lock(late)
    channel_wait_add(late, second, false)
    sync_mutex_unlock(late)
    receivers :: jet_rt_alloc(I64{16}, I64{8})
    sync_store(receivers, early)
    sync_store(receivers + I64{8}, late)
    result :: channel_select_probe(receivers, I64{2}, I64{0}, I64{0}, sync_now_ns(), storage + I64{40}, storage + I64{48})
    channel_fixture_check(result == I64{1})
    channel_fixture_check(sync_load(storage + I64{40}) == I64{0})
    payload :: sync_load(storage + I64{48})
    channel_fixture_check(sync_load(payload) == I64{10})
    channel_select_remove(early, first)
    channel_select_remove(late, second)
    sync_mutex_lock(late)
    handed_off :: sync_load(late + I64{16}) == I64{1} && (sync_load(plain + I64{16}).bit_and(I64{1})) == I64{0} && sync_load(plain_park) == I64{1}
    channel_wait_remove(late, plain, false)
    sync_mutex_unlock(late)
    jet_rt_free(payload, coll_size(meta), I64{8})
    jet_rt_int_drop(sync_load(storage + I64{40}))
    jet_rt_free(receivers, I64{16}, I64{8})
    jet_rt_free(first, I64{24}, I64{8})
    jet_rt_free(second, I64{24}, I64{8})
    jet_rt_free(plain, I64{24}, I64{8})
    sync_park_drop(select_park)
    sync_park_drop(plain_park)
    jet_rt_native_sender_drop(sync_load(storage))
    jet_rt_native_sender_drop(sync_load(storage + I64{16}))
    jet_rt_native_receiver_drop(early)
    jet_rt_native_receiver_drop(late)
    jet_rt_free(storage, I64{64}, I64{8})
    if handed_off -> I64{1} else -> I64{0}
}
