// Actual generated closure clone/drop glue under concurrent Shared readers.
// Eighteen runtime I64 captures give the canonical box size 24 + 18*8 = 168;
// the C driver observes its real allocator calls, not simulated drop counters.
#Import(c) fn closure_ref_test_input(index: I64) -> I64 = "jet_closure_ref_test_input"
#Import(c) fn closure_ref_test_enter() = "jet_closure_ref_test_enter"

struct ClosureRefTestHolder { call: fn() -> I64 }

fn closure_ref_test_holder() -> Shared<ClosureRefTestHolder> {
    a :: closure_ref_test_input(I64{1})
    b :: closure_ref_test_input(I64{2})
    c :: closure_ref_test_input(I64{3})
    d :: closure_ref_test_input(I64{4})
    e :: closure_ref_test_input(I64{5})
    f :: closure_ref_test_input(I64{6})
    g :: closure_ref_test_input(I64{7})
    h :: closure_ref_test_input(I64{8})
    i :: closure_ref_test_input(I64{9})
    j :: closure_ref_test_input(I64{10})
    k :: closure_ref_test_input(I64{11})
    l :: closure_ref_test_input(I64{12})
    m :: closure_ref_test_input(I64{13})
    n :: closure_ref_test_input(I64{14})
    o :: closure_ref_test_input(I64{15})
    p :: closure_ref_test_input(I64{16})
    q :: closure_ref_test_input(I64{17})
    r :: closure_ref_test_input(I64{18})
    shared ClosureRefTestHolder{call: () -> a + b + c + d + e + f + g + h + i + j + k + l + m + n + o + p + q + r}
}

fn closure_ref_test_worker(holder: Shared<ClosureRefTestHolder>) -> I64 {
    closure_ref_test_enter()
    sum := I64{0}
    loop _ in 0..<10000 {
        // Every read clones the same box while holding only a Shared read
        // guard. The local clone is retired independently on each backedge.
        callback :: holder.call
        sum += callback()
    }
    sum
}

#Export(c) fn jet_closure_ref_test_run() -> I64 {
    holder :: closure_ref_test_holder()
    sum := I64{0}
    task.group workers {
        results :: task.all {
            closure_ref_test_worker(holder), closure_ref_test_worker(holder),
            closure_ref_test_worker(holder), closure_ref_test_worker(holder),
            closure_ref_test_worker(holder), closure_ref_test_worker(holder),
            closure_ref_test_worker(holder), closure_ref_test_worker(holder),
            closure_ref_test_worker(holder), closure_ref_test_worker(holder),
            closure_ref_test_worker(holder), closure_ref_test_worker(holder),
            closure_ref_test_worker(holder), closure_ref_test_worker(holder),
            closure_ref_test_worker(holder), closure_ref_test_worker(holder),
            closure_ref_test_worker(holder), closure_ref_test_worker(holder),
            closure_ref_test_worker(holder), closure_ref_test_worker(holder),
            closure_ref_test_worker(holder), closure_ref_test_worker(holder),
            closure_ref_test_worker(holder), closure_ref_test_worker(holder),
            closure_ref_test_worker(holder), closure_ref_test_worker(holder),
            closure_ref_test_worker(holder), closure_ref_test_worker(holder),
            closure_ref_test_worker(holder), closure_ref_test_worker(holder),
            closure_ref_test_worker(holder), closure_ref_test_worker(holder),
        } ?? panic("closure workers failed")
        loop result in results -> sum += result
    }
    sum
}
