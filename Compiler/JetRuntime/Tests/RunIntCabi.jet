#!/usr/bin/env jet
// Exact Int C ABI witness: int-cabi.c links the supplied Jet-only runtime and
// runs the generated int corpus (parse/clone/from-i64, every binary operator
// and division family, shifts, powers, checked fixed widths and Float
// conversion at every rounding position), the hazard-domain race (a hazarded
// node is retired, not freed, until its reader clears) and six stopped reports. The corpus
// expectations are exact Int arithmetic; CORPUS_SHA256 freezes the corpus the
// independent BigInt oracle generated, so a regenerated corpus that differs by
// one byte fails before the witness runs. The supplied object must import no
// exact Int symbol and define no Rust symbol (read from its ELF symbol table).
// OUT keeps int-corpus.inc, the build log, each run's stdout, stderr and status.
// Usage (from the repository root):
//   jet Compiler/JetRuntime/Tests/RunIntCabi.jet OUT JET_ONLY_RUNTIME_OBJECT [LINK_INPUT...]
use {
    crypto: core.crypto
    files: core.files
    process: core.process
    re: core.regex
}

POLICY: "Compiler/JetCli/Source/Cli/native-c-policy.tsv"
CORPUS_SHA256: "7c379f2e4efd0b09e7005876c4bcc2c167e325a87b879340d73aedd25b55f867"
BINARY: [String]{"add", "sub", "mul", "bit_and", "bit_or", "bit_xor"}
DIVISION: [String]{"div", "rem", "floor_div", "mod", "div_euclid", "rem_euclid"}
STOPS: [String]{"zero", "exponent", "shift-negative", "shift-wide", "fixed", "native"}

Policy: struct {
    flags: [String]
    removed: [String]
}

Corpus: struct {
    statements: [String]
    count: Int
}

// The defined and undefined names of an ELF64 relocatable object's symbols.
Symbols: struct {
    defined: [String]
    undefined: [String]
}

fail: fn(message: String) -> Never { process.fail(1, message) }

// path.resolve against the working directory.
resolve: fn(cwd: String, path: String) -> String {
    full: if path.starts_with("/") -> path.copy() else -> "{cwd}/{path}"
    parts := [String]{}
    loop part in full.split("/").to_list() {
        if part == ".." {
            if parts.len() > 0 -> _: parts.pop()
        } else if part != "" && part != "." {
            parts.push(part)
        }
    }
    "/{parts.join("/")}"
}

pow2: fn(n: Int) -> Int { 1 << n }

raw: fn(value: Int) -> String { "parse(\"{value}\")" }

i64_constant: fn(value: Int) -> String {
    if value == 0 - pow2(63) -> return "INT64_MIN"
    if value < 0 -> return "-INT64_C({0 - value})"
    "INT64_C({value})"
}

// Truncated division, as C and BigInt divide.
trunc_div: fn(a: Int, b: Int) -> Int { (a - a %% b) /% b }

power: fn(base: Int, exponent: Int) -> Int {
    result := 1
    loop _ in 0..<exponent -> result = result * base
    result
}

bit_length: fn(value: Int) -> Int {
    if value == 0 -> return 0
    high := 1
    loop value >> high != 0 -> high = high * 2
    low := high /% 2
    loop low + 1 < high {
        middle: (low + high) /% 2
        if (value >> middle) != 0 -> low = middle else -> high = middle
    }
    high
}

// The IEEE binary64 bits of the Float nearest `value`, ties to even; past
// the largest finite Float, infinity.
float_bits: fn(value: Int) -> Int {
    sign: if value < 0 -> pow2(63) else -> 0
    magnitude: if value < 0 -> 0 - value else -> value
    if magnitude == 0 -> return 0
    length: bit_length(magnitude)
    if length <= 53 {
        mantissa: (magnitude << (53 - length)).bit_and(pow2(52) - 1)
        return sign + ((length - 1 + 1023) << 52) + mantissa
    }
    shift := length - 53
    quotient := magnitude >> shift
    rest: magnitude - (quotient << shift)
    half: pow2(shift - 1)
    if rest > half || (rest == half && quotient.bit_and(1) == 1) -> quotient = quotient + 1
    if quotient == pow2(53) {
        quotient = quotient >> 1
        shift = shift + 1
    }
    exponent: 52 + shift
    if exponent > 1023 -> return sign + (2047 << 52)
    sign + ((exponent + 1023) << 52) + quotient.bit_and(pow2(52) - 1)
}

hex16: fn(value: Int) -> String {
    digits: "0123456789abcdef".bytes()
    out := [U8]{}
    rest := value
    loop _ in 0..<16 {
        out.push(digits[rest.bit_and(15)])
        rest = rest >> 4
    }
    out.reverse()
    String.from_bytes_lossy(out)
}

// One witnessed value: the label, the C expression and its exact value.
value_row: fn(label: String, expression: String, expected: Int) -> String {
    "    value(\"{label}\", {expression}, \"{expected}\");"
}

// The int-corpus.inc statements, in the order and spelling the BigInt
// oracle wrote them, and how many of them witness a value.
corpus: fn() -> Corpus {
    statements := [String]{}
    count := 0
    values := [Int]{0, 1, -1, pow2(62) - 1, 0 - pow2(62), pow2(62), 0 - pow2(62) - 1, pow2(63) - 1, 0 - pow2(63), pow2(64), 0 - pow2(64), Int.parse("123456789012345678901234567890123456789") ?? 0}
    loop i in 0..<values.len() {
        a: values[i]
        rows := [String]{value_row("parse-{i}", raw(a), a), value_row("clone-{i}", "jet_rt_int_clone({raw(a)})", a)}
        if a >= 0 - pow2(63) && a < pow2(63) {
            constant: i64_constant(a)
            rows.push(value_row("from-i64-{i}", "jet_int_owned_from_i64({constant})", a))
            count += rows.len()
            statements.extend(rows)
            rows = [String]{}
            statements.push("    if (jet_int_owned_to_i64({raw(a)}) != {constant}) ++failures;")
        }
        loop j in 0..<values.len() {
            b: values[j]
            binary: [Int]{a + b, a - b, a * b, a.bit_and(b), a.bit_or(b), a.bit_xor(b)}
            loop k in 0..<BINARY.len() -> rows.push(value_row("{BINARY[k]}-{i}-{j}", "jet_int_{BINARY[k]}({raw(a)}, {raw(b)})", binary[k]))
            order: if a < b -> -1 else if a > b -> 1 else -> 0
            rows.push(value_row("compare-{i}-{j}", "jet_int_compare({raw(a)}, {raw(b)})", order))
            if b != 0 {
                trunc: trunc_div(a, b)
                remainder: a - trunc * b
                floor: trunc - (if remainder != 0 && (a < 0) != (b < 0) -> 1 else -> 0)
                modulo: a - floor * b
                euclid: trunc + (if remainder < 0 -> (if b < 0 -> 1 else -> -1) else -> 0)
                rest: a - euclid * b
                division: [Int]{trunc, remainder, floor, modulo, euclid, rest}
                loop k in 0..<DIVISION.len() -> rows.push(value_row("{DIVISION[k]}-{i}-{j}", "jet_int_{DIVISION[k]}({raw(a)}, {raw(b)}, NULL, 0, 0)", division[k]))
            }
        }
        loop shift in ([Int]{0, 1, 28, 29, 31, 32, 62, 63, 64, 127, 1024}) {
            rows.push(value_row("shl-{i}-{shift}", "jet_int_shl({raw(a)}, {shift}, NULL, 0, 0)", a << shift))
            rows.push(value_row("shr-{i}-{shift}", "jet_int_shr({raw(a)}, {shift}, NULL, 0, 0)", a >> shift))
        }
        loop exponent in ([Int]{0, 1, 2, 3, 7}) -> rows.push(value_row("pow-{i}-{exponent}", "jet_int_pow({raw(a)}, {exponent}, NULL, 0, 0)", power(a, exponent)))
        count += rows.len()
        statements.extend(rows)
    }
    loop kind in 0..<8 {
        bits: [Int]{8, 16, 32, 64}[kind %% 4]
        bounds: if kind < 4 -> [Int]{0 - pow2(bits - 1), pow2(bits - 1) - 1} else -> [Int]{0, pow2(bits) - 1}
        loop a in bounds {
            // BigInt.asIntN(64, a): the 64-bit word, signed.
            word: if a >= pow2(63) -> a - pow2(64) else -> a
            statements.push("    word_value(\"fixed-{kind}-{a}\", jet_int_checked_fixed({raw(a)}, {kind}, NULL, 0, 0), {i64_constant(word)});")
            count += 1
        }
    }
    // The Float inputs: the values, then the edges, then every rounding
    // position (both parity ties, just below and above ties), both signs;
    // each text once, at its first place.
    candidates := values.move()
    loop a in ([Int]{pow2(53) - 1, pow2(53), pow2(53) + 1, pow2(63), (pow2(53) - 1) << 971, pow2(1024), power(10, 450)}) {
        candidates.push(a)
        candidates.push(0 - a)
    }
    loop exponent in 53..<1024 {
        unit: pow2(exponent - 52)
        half: unit >> 1
        loop a in ([Int]{pow2(exponent) + half - 1, pow2(exponent) + half, pow2(exponent) + half + 1, pow2(exponent) + unit + half}) {
            candidates.push(a)
            candidates.push(0 - a)
        }
    }
    seen := [String: Bool]{}
    index := 0
    loop value in candidates {
        text: "{value}"
        if seen.has_key(text) -> next
        seen[text.copy()] = true
        statements.push("    float_value(\"float-{index}\", parse(\"{text}\"), UINT64_C(0x{hex16(float_bits(value))}));")
        index += 1
        count += 1
    }
    // Clone retention checks the defined atomic refcount word, not merely value.
    statements.push("    {{ int64_t x = parse(\"9223372036854775808\"); IntNode *n = (IntNode *)(uintptr_t)((uint64_t)x & ((UINT64_C(1)<<62)-1)); uint64_t before = n->refs; int64_t cloned = jet_rt_int_clone(x); if (cloned != x || n->refs != before + 1) ++failures; jet_rt_int_drop(cloned); if (n->refs != before) ++failures; jet_rt_int_drop(x); }}")
    Corpus{statements: statements, count: count}
}

le: fn(bytes: [U8], at: Int, width: Int) -> Int {
    value := 0
    loop k in 0..<width -> value = value * 256 + (Int{bytes[at + width - 1 - k]})
    value
}

c_string: fn(bytes: [U8], at: Int) -> String {
    end := at
    loop end < bytes.len() {
        if (Int{bytes[end]}) == 0 -> break
        end += 1
    }
    String.from_bytes_lossy(bytes[at..<end])
}

// The symbols of an ELF64 little-endian object: its SHT_SYMTAB section and
// the string table it links; section index 0 marks an undefined symbol.
elf_symbols: fn(bytes: [U8]) -> Symbols? {
    if bytes.len() < 64 || le(bytes, 0, 4) != 0x464c457f || (Int{bytes[4]}) != 2 || (Int{bytes[5]}) != 1 -> return None
    sections: le(bytes, 0x28, 8)
    entry: le(bytes, 0x3a, 2)
    count: le(bytes, 0x3c, 2)
    if sections + entry * count > bytes.len() -> return None
    found := Symbols{defined: [String]{}, undefined: [String]{}}
    loop index in 0..<count {
        header: sections + entry * index
        if le(bytes, header + 4, 4) != 2 -> next
        table: le(bytes, header + 24, 8)
        size: le(bytes, header + 32, 8)
        strings: sections + entry * le(bytes, header + 40, 4)
        names: le(bytes, strings + 24, 8)
        if table + size > bytes.len() -> return None
        loop at in 1..<size /% 24 {
            symbol: table + 24 * at
            name: c_string(bytes, names + le(bytes, symbol, 4))
            if name == "" -> next
            if le(bytes, symbol + 6, 2) == 0 -> found.undefined.push(name) else -> found.defined.push(name)
        }
    }
    Val(found)
}

// The exact Int symbols an object imports and the Rust symbols it defines.
foreign: fn(symbols: Symbols) -> [String] {
    found := [String]{}
    loop name in symbols.undefined {
        if name.starts_with("jet_int_") || name.starts_with("jet_rt_int_") -> found.push("imports {name}")
    }
    loop name in symbols.defined {
        if name.starts_with("_R") || name.starts_with("_ZN") || name.starts_with("__rust") || name.starts_with("rust_eh_personality") -> found.push("defines {name}")
    }
    found
}

load_policy: fn(root: String) -> Policy {
    text: files.read("{root}/{POLICY}") ?? fail("cannot read {POLICY}: {err}")
    flags := [String]{}
    removed := [String]{}
    lines: text.split("\n").to_list()
    loop index in 0..<lines.len() {
        line: lines[index]
        if line == "" || line.starts_with("#") -> next
        fields: line.split("\t").to_list()
        if fields.len() != 2 || fields[1] == "" -> fail("native-c-policy.tsv:{index + 1}: expected \"kind<TAB>value\"")
        if fields[0] == "flag" {
            flags.push(fields[1])
        } else if fields[0] == "hardening-remove" {
            removed.push(fields[1])
        } else {
            fail("native-c-policy.tsv:{index + 1}: unknown policy kind {fields[0]}")
        }
    }
    Policy{flags: flags, removed: removed}
}

// `$CC` (default `cc`) with `args` and the policy flags, as
// Tools/packaging/NativeCCompiler.jet runs it.
native_cc: fn(policy: Policy, args: [String]) -> ProcessSpec {
    removed: policy.removed
    spec := process.cmd([process.env_get_or("CC", "cc")]).args_extend(args).args_extend(policy.flags)
    if process.env_get("NIX_HARDENING_ENABLE") == .Val(enabled) {
        words: re.split(Regex{"\s+"}, enabled)
        kept: loop word in words if word != "" && !removed.contains(word) -> word
        spec = spec.env("NIX_HARDENING_ENABLE", kept.join(" "))
    }
    spec
}

write: fn(path: String, text: String) {
    files.write(path, text) ?? fail("cannot write {path}: {err}")
}

run: fn() {
    root: files.cwd() ?? fail("cannot read the working directory: {err}")
    args: process.args()
    if args.len() < 2 || args[0] == "" || args[1].starts_with("-") -> fail("usage: RunIntCabi.jet OUT JET_ONLY_RUNTIME_OBJECT [LINK_INPUT...]")
    out: resolve(root, args[0])
    files.create_dir_all(out) ?? fail("cannot create {out}: {err}")
    generated: corpus()
    text: "static void int_corpus(void) {{\n{generated.statements.join("\n")}\n}}\n"
    write("{out}/int-corpus.inc", text)
    if crypto.sha256(text.bytes()).hex() != CORPUS_SHA256 -> fail("int-corpus.inc differs from the frozen BigInt-oracle corpus")
    object: resolve(root, args[1])
    failures := [String]{}
    binary: "{out}/jet-int-cabi"
    cc_args := [String]{"-std=c11", "-O1", "-I", out.copy(), "{root}/Compiler/JetRuntime/Tests/int-cabi.c", object.copy()}
    loop input in args[2..<args.len()] -> cc_args.push(if input.starts_with("-") -> input.copy() else -> resolve(root, input))
    cc_args.extend([String]{"-ldl", "-lpthread", "-lm", "-o", binary.copy()})
    built: native_cc(load_policy(root), cc_args).run() ?? fail("jet: link: {err}")
    write("{out}/jet-build.log", "{built.output}{built.errors}")
    if built.signal != None || built.code != 0 {
        failures.push("jet: link")
    } else {
        runs := [String]{"values"}
        runs.extend(STOPS)
        loop name in runs {
            spec: if name == "values" -> process.cmd([String]{binary.copy()}) else -> process.cmd([String]{binary.copy(), name.copy()})
            ran: spec.run() ?? fail("jet: {name}: {err}")
            write("{out}/jet-{name}.stdout", ran.output)
            write("{out}/jet-{name}.stderr", ran.errors)
            status: if ran.signal == .Val(number) -> "{{\"status\":null,\"signal\":{number}}}\n" else -> "{{\"status\":{ran.code},\"signal\":null}}\n"
            write("{out}/jet-{name}.status.json", status)
            wanted: if name == "values" -> 0 else -> 70
            if ran.signal != None || ran.code != wanted -> failures.push("jet: {name}")
        }
    }
    bytes: files.read_bytes(object) ?? fail("cannot read {object}: {err}")
    symbols: elf_symbols(bytes) ?? fail("{object} is not an ELF64 little-endian object")
    write("{out}/undefined-symbols.txt", "{symbols.undefined.join("\n")}\n")
    write("{out}/defined-symbols.txt", "{symbols.defined.join("\n")}\n")
    if foreign(symbols).len() > 0 -> failures.push("Jet-only object has an exact Int fallback import or Rust definition: {foreign(symbols).join(", ")}")
    if failures.len() > 0 -> fail("exact Int ABI witness failed: {failures.join(", ")}")
    print("exact Int ABI: {generated.count} numeric/float cases + {STOPS.len()} stopped reports, clone/drop and concurrent hazard fixture; Jet-only provider")
}

#Test("floats round to nearest, ties to even, and overflow to infinity") {
    assert_eq(hex16(float_bits(1)), "3ff0000000000000")
    assert_eq(hex16(float_bits(-2)), "c000000000000000")
    assert_eq(hex16(float_bits(pow2(53) + 1)), "4340000000000000")
    assert_eq(hex16(float_bits(pow2(53) + 3)), "4340000000000002")
    assert_eq(hex16(float_bits(pow2(1024))), "7ff0000000000000")
    assert_eq(bit_length(pow2(1000)), 1001)
    assert_eq(trunc_div(-7, 2), -3)
    assert_eq(i64_constant(0 - pow2(63)), "INT64_MIN")
    assert_eq(foreign(Symbols{defined: [String]{"_ZN3foo", "jet_x"}, undefined: [String]{"jet_int_add", "memcpy"}}).len(), 2)
}
