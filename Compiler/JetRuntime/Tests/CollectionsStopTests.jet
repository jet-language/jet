// Test-only entry: never exported by the runtime manifest or packed runtime.
// Single-threaded, with no concurrent Jet allocations. This bounded fixture
// uses fewer blocks per class than one slab can hold, so no full slab can be
// unlinked during the live-total snapshot. No direct allocations are used.
// C callbacks deliver the real budget stop rail, leaving result slots unwritten.
#Export(c) fn collections_stop_test(family: I64, unary: I64, binary: I64, show: I64, release: I64, list_drop: I64) {
    snapshot :: jet_rt_alloc(I64{64}, I64{8})
    width := I64{32}
    at := I64{0}
    loop at < (I64{8}) {
        trap_store(snapshot + at * I64{8}, coll_test_live(width))
        width *= I64{2}
        at += I64{1}
    }
    meta :: coll_test_meta()
    list_meta :: coll_test_meta()
    trap_store(list_meta, I64{24})
    trap_store(list_meta + I64{48}, I64{6})
    trap_store(list_meta + I64{56}, coll_meta_copy(meta))
    trap_store(list_meta + I64{16}, list_drop)
    source :: coll_test_source()
    mapped :: if (family == I64{6} || family == I64{7} || family == I64{8}) -> source else -> jet_rt_native_iter_map(source, I64{0}, unary, release, meta)
    result := I64{0}
    if {
        (family == I64{0}) -> result = jet_rt_native_iter_cursor_init(mapped, I64{1}, I64{0})
        (family == I64{1}) -> result = jet_rt_native_iter_repeat(mapped, I64{2})
        (family == I64{2}) -> result = jet_rt_native_iter_cycle(mapped, I64{7})
        (family == I64{3}) -> result = jet_rt_native_iter_shuffle(mapped)
        (family == I64{4}) -> result = jet_rt_native_iter_drop_last(mapped, I64{1})
        (family == I64{5}) -> {
            output :: coll_list_new()
            jet_rt_native_iter_to_list(mapped, output)
            coll_test_require(trap_word(output) == I64{0} && trap_word(output + I64{8}) == I64{0} && trap_word(output + I64{16}) == I64{0})
            jet_rt_free(output, I64{24}, I64{8})
        }
        (family == I64{6}) -> {
            result = jet_rt_native_iter_dedup_by(mapped, I64{0}, unary, release, meta)
        }
        (family == I64{7}) -> {
            result = jet_rt_native_iter_chunk_while(mapped, I64{0}, binary, release, meta, list_meta)
        }
        (family == I64{8}) -> {
            trap_store(meta + I64{24}, show)
            separator :: jet_rt_string_builder_finish(jet_rt_string_builder_new())
            result = jet_rt_native_iter_join(mapped, separator, meta)
            jet_rt_string_drop(separator)
        }
        (family == I64{9}) -> coll_test_require(jet_rt_native_iter_average_int(mapped) == 0.0)
        (family == I64{10}) -> coll_test_require(jet_rt_native_iter_average_float(mapped) == 0.0)
        (family == I64{11}) -> {
            result = jet_rt_native_iter_dedup_by(mapped, I64{0}, unary, release, meta)
        }
        (family == I64{12}) -> {
            result = jet_rt_native_iter_chunk_while(mapped, I64{0}, binary, release, meta, list_meta)
        }
        else -> coll_test_require(false)
    }
    coll_test_require(jet_rt_session_propagate() != I64{0} && result == I64{0})
    coll_meta_drop(list_meta)
    coll_meta_drop(meta)
    width = I64{32}
    at = I64{0}
    loop at < (I64{8}) {
        coll_test_require(coll_test_live(width) == trap_word(snapshot + at * I64{8}))
        width *= I64{2}
        at += I64{1}
    }
    jet_rt_free(snapshot, I64{64}, I64{8})
}

// Focused review witnesses use owning pointer elements, not inert integers.
// Every case checks all eight allocator classes after its complete cleanup.
#Import(c) fn coll_stop_after_free(address: I64) = "coll_stop_after_free"
#Import(c) fn coll_stop_arm(address: I64) = "coll_stop_arm"

fn coll_stop_free(address: I64, size: I64, align: I64) {
    jet_rt_free(address, size, align)
    coll_stop_after_free(address)
}

fn coll_stop_owned_source(meta: I64, length: I64) -> I64 {
    header :: coll_list_new()
    slot :: coll_slot_new(meta)
    at := I64{0}
    loop at < length {
        payload :: jet_rt_alloc(I64{8}, I64{8})
        trap_store(payload, at)
        trap_store(slot, payload)
        coll_list_push(header, slot, meta)
        at += I64{1}
    }
    node :: jet_rt_native_iter_from_list(header, meta, I64{1})
    jet_rt_free(header, I64{24}, I64{8})
    jet_rt_free(slot, I64{8}, I64{8})
    node
}

#Export(c) fn collections_review_test(family: I64, unary: I64, binary: I64, clone: I64, drop: I64, box_drop: I64) {
    snapshot :: jet_rt_alloc(I64{64}, I64{8})
    width := I64{32}
    at := I64{0}
    loop at < (I64{8}) {
        trap_store(snapshot + at * I64{8}, coll_test_live(width))
        width *= I64{2}
        at += I64{1}
    }
    meta :: coll_test_meta()
    trap_store(meta + I64{8}, clone)
    trap_store(meta + I64{16}, drop)
    list_meta :: coll_test_meta()
    trap_store(list_meta, I64{24})
    trap_store(list_meta + I64{48}, I64{6})
    trap_store(list_meta + I64{56}, coll_meta_copy(meta))
    result := I64{0}
    if (family == I64{0}) {
        mapped :: jet_rt_native_iter_map(coll_stop_owned_source(meta, I64{5}), I64{0}, unary, I64{0}, meta)
        pair :: jet_rt_alloc(I64{48}, I64{8})
        jet_rt_native_iter_split_at(mapped, I64{1}, pair, I64{0}, I64{24})
        at = I64{0}
        loop at < (I64{6}) {
            coll_test_require(trap_word(pair + at * I64{8}) == I64{0})
            at += I64{1}
        }
        jet_rt_free(pair, I64{48}, I64{8})
    } else if (family == I64{1}) {
        mapped :: jet_rt_native_iter_map(coll_stop_owned_source(meta, I64{5}), I64{0}, unary, I64{0}, meta)
        needle :: coll_slot_new(meta)
        trap_store(needle, jet_rt_alloc(I64{8}, I64{8}))
        result = jet_rt_native_iter_last_index_of(mapped, needle, meta, I64{1})
        jet_rt_free(needle, I64{8}, I64{8})
    } else if (family >= I64{2} && family <= I64{5}) {
        a := coll_stop_owned_source(meta, I64{1})
        b := coll_stop_owned_source(meta, I64{1})
        if (family == I64{2} || family == I64{4}) {
            a = jet_rt_native_iter_map(a, I64{0}, unary, I64{0}, meta)
        } else { b = jet_rt_native_iter_map(b, I64{0}, unary, I64{0}, meta) }
        text :: jet_rt_string_builder_finish(jet_rt_string_builder_new())
        zipped := I64{0}
        if (family <= I64{3}) {
            zipped = jet_rt_native_iter_zip_strict(a, b, I64{0}, binary, I64{0}, meta, text, text, I64{0}, text, text, I64{0}, I64{0})
        } else {
            fill :: coll_slot_new(meta)
            fill_payload :: jet_rt_alloc(I64{8}, I64{8})
            trap_store(fill_payload, I64{0})
            trap_store(fill, fill_payload)
            zipped = jet_rt_native_iter_zip_pad(a, b, fill, fill, I64{0}, binary, I64{0}, meta, meta, meta, I64{0}, I64{0})
            coll_slot_free(fill, meta)
        }
        result = jet_rt_native_iter_next(zipped)
        jet_rt_native_iter_drop(zipped)
        jet_rt_string_drop(text)
    } else if (family == I64{6}) {
        mapped :: jet_rt_native_iter_map(coll_stop_owned_source(meta, I64{5}), I64{0}, unary, I64{0}, meta)
        chunks :: jet_rt_native_iter_chunks(mapped, I64{4}, list_meta)
        result = jet_rt_native_iter_next(chunks)
        jet_rt_native_iter_drop(chunks)
    } else if (family >= I64{7} && family <= I64{9}) {
        carrier :: coll_test_meta()
        trap_store(carrier + I64{48}, I64{8})
        trap_store(carrier + I64{16}, box_drop)
        value_meta :: coll_test_meta()
        if (family == I64{8}) { trap_store(value_meta + I64{48}, I64{9}) }
        trap_store(carrier + I64{56}, value_meta)
        trap_store(carrier + I64{64}, coll_meta_copy(meta))
        if (family == I64{9}) {
            header :: coll_list_new()
            slot :: coll_slot_new(carrier)
            box :: jet_rt_alloc(I64{16}, I64{8})
            trap_store(box, I64{0})
            trap_store(box + I64{8}, jet_rt_alloc(I64{8}, I64{8}))
            trap_store(slot, box)
            coll_list_push(header, slot, carrier)
            source :: jet_rt_native_iter_from_list(header, carrier, I64{1})
            jet_rt_free(header, I64{24}, I64{8})
            jet_rt_free(slot, I64{8}, I64{8})
            coll_stop_arm(box)
            // The list's element is the success type, not the carrier.
            output_meta :: coll_test_meta()
            trap_store(output_meta, I64{24})
            trap_store(output_meta + I64{56}, coll_meta_copy(value_meta))
            result = jet_rt_native_iter_try_collect(source, output_meta, meta)
            coll_meta_drop(output_meta)
        } else {
            source :: coll_stop_owned_source(meta, I64{1})
            result = if (family == I64{7}) -> jet_rt_native_iter_try_map(source, I64{0}, unary, I64{0}, carrier) else -> jet_rt_native_iter_try_filter(source, I64{0}, unary, I64{0}, carrier)
        }
        coll_meta_drop(carrier)
    } else if (family == I64{10}) {
        text :: jet_rt_string_builder_finish(jet_rt_string_builder_new())
        progress :: jet_rt_native_iter_progress(coll_stop_owned_source(meta, I64{1}), text, text)
        result = jet_rt_native_iter_next(progress)
        jet_rt_native_iter_drop(progress)
        jet_rt_string_drop(text)
    } else { coll_test_require(false) }
    coll_test_require(jet_rt_session_propagate() != I64{0} && result == I64{0})
    coll_meta_drop(list_meta)
    coll_meta_drop(meta)
    width = I64{32}
    at = I64{0}
    loop at < (I64{8}) {
        coll_test_require(coll_test_live(width) == trap_word(snapshot + at * I64{8}))
        width *= I64{2}
        at += I64{1}
    }
    jet_rt_free(snapshot, I64{64}, I64{8})
}
