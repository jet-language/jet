// Core.rs:678-860 failure/unmet and saturating Instant witnesses against the
// actual Jet cells and real scheduler stop carrier. Inputs borrow E4 C text.
#Export(c) fn jet_rt_test_scope_fault_fixture(code: I64, wrong: I64, message: I64) -> I64 {
    control :: scheduler_control_new()
    scratch :: jet_rt_alloc(I64{64}, I64{8})
    scheduler_control_enter(control, scratch)
    body :: scheduler_body_enter()
    output :: scratch + I64{32}
    jet_rt_test_expect_fail_abort()
    jet_rt_test_expect_fail_enter_scope(I64{1}, wrong, I64{0})
    jet_rt_test_record_stop(code, message)
    if !jet_rt_test_expect_fail_stopped_scope(output) -> jet_rt_unreachable(I64{0}, I64{0})
    // A mismatch cannot complete/catch the expectation and cannot be caught by
    // its own parent: the unmet bit suppresses stopped_scope thereafter.
    if jet_rt_test_expect_fail_catch_scope(output) -> jet_rt_unreachable(I64{0}, I64{0})
    if jet_rt_test_expect_fail_stopped_scope(output) -> jet_rt_unreachable(I64{0}, I64{0})
    if (scheduler_control_status(control) != I64{5}) -> jet_rt_unreachable(I64{0}, I64{0})
    stop := scheduler_control_take_stop(control)
    actual := scheduler_stop_take_message(stop)
    expected := jet_rt_test_expect_fail_error(wrong, I64{0}, code, message)
    if !jet_rt_string_eq(actual, expected) -> jet_rt_unreachable(I64{0}, I64{0})
    test_text_drop(actual)
    test_text_drop(expected)
    scheduler_stop_drop(stop)
    jet_rt_test_expect_fail_abort()
    jet_rt_test_expect_fail_enter_scope(I64{2}, I64{0}, I64{0})
    jet_rt_test_expect_fail_unmet(I64{0}, I64{0})
    if jet_rt_test_expect_fail_stopped_scope(output) -> jet_rt_unreachable(I64{0}, I64{0})
    stop = scheduler_control_take_stop(control)
    if (stop == I64{0}) -> jet_rt_unreachable(I64{0}, I64{0})
    actual = scheduler_stop_take_message(stop)
    expected = jet_rt_test_expect_fail_error(I64{0}, I64{0}, I64{0}, I64{0})
    if !jet_rt_string_eq(actual, expected) -> jet_rt_unreachable(I64{0}, I64{0})
    test_text_drop(actual)
    test_text_drop(expected)
    scheduler_stop_drop(stop)
    jet_rt_test_expect_fail_abort()
    jet_rt_test_timeout_failure(I64{7}, I64{-1})
    stop = scheduler_control_take_stop(control)
    if (stop == I64{0}) -> jet_rt_unreachable(I64{0}, I64{0})
    actual = scheduler_stop_take_message(stop)
    expected = jet_rt_test_timeout_message(I64{7}, I64{-1})
    if !jet_rt_string_eq(actual, expected) -> jet_rt_unreachable(I64{0}, I64{0})
    test_text_drop(actual)
    test_text_drop(expected)
    scheduler_stop_drop(stop)
    // Mutate only the fixture's owned timer record, not a clock provider. The
    // first record simulates Duration::as_nanos exceeding i64::MAX; the second
    // simulates Instant moving backward. Both are deterministic arithmetic.
    jet_rt_test_timeout_enter(I64{3}, I64{10})
    state :: test_capture_state()
    row :: trap_word(state + I64{104})
    now :: time_clock_read(I64{1})
    trap_store(row + I64{8}, trap_word(now) - I64{9223372037})
    if !jet_rt_test_timeout_leave(I64{3}, output) -> jet_rt_unreachable(I64{0}, I64{0})
    if (trap_word(output) != I64{9223372036854775807}) -> jet_rt_unreachable(I64{0}, I64{0})
    jet_rt_test_timeout_enter(I64{4}, I64{11})
    now_future :: time_clock_read(I64{1})
    trap_store(row + I64{8}, trap_word(now_future) + I64{3600})
    if !jet_rt_test_timeout_leave(I64{4}, output) -> jet_rt_unreachable(I64{0}, I64{0})
    if (trap_word(output) != I64{0}) -> jet_rt_unreachable(I64{0}, I64{0})
    jet_rt_test_timeout_abort()
    scheduler_body_leave(body)
    scheduler_control_leave(scratch)
    scheduler_control_drop(control)
    jet_rt_free(scratch, I64{64}, I64{8})
    I64{0}
}
