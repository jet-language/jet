#Export(c) fn jet_rt_blake_fixture(input: I64, length: I64, expected: I64) {
    scratch :: jet_rt_alloc(I64{472}, I64{8})
    output :: jet_rt_alloc(I64{64}, I64{1})
    split := I64{0}
    loop split <= length {
        rt_blake_parts(input, split, input + split, length - split, output, I64{64}, scratch)
        if (!rt_crypto_equal(output, expected, I64{64})) -> jet_rt_unreachable(I64{0}, I64{0})
        i := I64{0}
        loop {
            if (i >= I64{472}) -> break
            if (rt_text_byte(scratch + i) != I64{0}) -> jet_rt_unreachable(I64{0}, I64{0})
            i += I64{1}
        }
        split += I64{1}
    }
    jet_rt_free(output, I64{64}, I64{1})
    jet_rt_free(scratch, I64{472}, I64{8})
}
#Export(c) fn jet_rt_argon_fixture(password: I64, password_len: I64, salt: I64, secret: I64, secret_len: I64, ad: I64, ad_len: I64, memory_kib: I64, lanes: I64, expected: I64) {
    blocks :: (memory_kib / (I64{4} * lanes)) * I64{4} * lanes
    memory :: jet_rt_alloc(blocks * I64{1024}, I64{8})
    scratch :: jet_rt_alloc(I64{4800}, I64{8})
    output :: jet_rt_alloc(I64{34}, I64{1})
    rt_text_put(output, I64{165})
    rt_text_put(output + I64{33}, I64{90})
    accepted :: rt_crypto_argon2id(password, password_len, salt, I64{16}, secret, secret_len, ad, ad_len, memory_kib, I64{3}, lanes, output + I64{1}, I64{32}, memory, scratch)
    if (!accepted || !rt_crypto_equal(output + I64{1}, expected, I64{32})) -> jet_rt_unreachable(I64{0}, I64{0})
    if (rt_text_byte(output) != I64{165} || rt_text_byte(output + I64{33}) != I64{90}) -> jet_rt_unreachable(I64{0}, I64{0})
    at := I64{0}
    loop {
        if (at >= blocks * I64{1024}) -> break
        if (rt_text_word(memory + at) != I64{0}) -> jet_rt_unreachable(I64{0}, I64{0})
        at += I64{8}
    }
    at = I64{0}
    loop {
        if (at >= I64{4800}) -> break
        if (rt_text_word(scratch + at) != I64{0}) -> jet_rt_unreachable(I64{0}, I64{0})
        at += I64{8}
    }
    rt_crypto_wipe(output, I64{34})
    jet_rt_free(output, I64{34}, I64{1})
    jet_rt_free(scratch, I64{4800}, I64{8})
    jet_rt_free(memory, blocks * I64{1024}, I64{8})
}
