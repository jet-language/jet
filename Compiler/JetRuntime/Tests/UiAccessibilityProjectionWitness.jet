// Test-only doors, not production exports.
#Export(c) fn ui_projection_witness_clone(value: I64) -> I64 { ui_accessibility_projection_clone(value) }
#Export(c) fn ui_projection_witness_drop(value: I64) { ui_accessibility_projection_drop(value) }
#Export(c) fn ui_projection_witness_eq(a: I64, b: I64) -> Bool { ui_accessibility_projection_eq(a, b) }
