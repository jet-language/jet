// Isolated native carrier witness; assembled with the runtime source manifest.
// Every pointer inspection owns live allocated storage, never freed bytes.
// stdout exactly "secret tests: ok\n", exit0; a failed condition exits1.
fn secret_test_require(ok: Bool) {
    if ok -> return
    #Unsafe("a failed isolated Secret witness terminates this test process") {
        _ := os_syscall_i64(I64{231}, I64{1}, I64{0}, I64{0}, I64{0}, I64{0}, I64{0})
    }
    loop {}
}

fn secret_test_header(length: I64, capacity: I64, data: I64) -> I64 {
    header :: jet_rt_alloc(I64{24}, I64{8})
    #Unsafe("header is fresh aligned24B storage owned by the test; data is its owned capacity*8B buffer or zero for an empty List") {
        os_store_i64(header, length)
        os_store_i64(wrapping(header + I64{8}), capacity)
        os_store_i64(wrapping(header + I64{16}), data)
    }
    header
}

fn secret_test_live(pointer: I64) -> I64 {
    #Unsafe("the pointer is a live small allocation; this isolated test is the sole allocator user and can inspect its retained slab metadata") {
        slab :: os_load_i64(wrapping(pointer - I64{16}))
        return os_load_i64(wrapping(slab + I64{24}))
    }
}

fn secret_test_owned() {
    data :: jet_rt_alloc(I64{32}, I64{8})
    input :: secret_test_header(I64{3}, I64{4}, data)
    secret :: jet_rt_secret_from_bytes(input)
    secret_test_require(secret_test_live(secret) == I64{3})
    #Unsafe("input and secret are distinct live headers; adoption leaves one live buffer owner and borrowed bytes alias only that parent's header") {
        secret_test_require(os_load_i64(input) == I64{0})
        secret_test_require(os_load_i64(wrapping(input + I64{8})) == I64{0})
        secret_test_require(os_load_i64(wrapping(input + I64{16})) == I64{0})
        borrowed :: jet_rt_secret_bytes(secret)
        secret_test_require(borrowed == secret)
        secret_test_require(os_load_i64(borrowed) == I64{3})
        secret_test_require(os_load_i64(wrapping(borrowed + I64{8})) == I64{4})
        secret_test_require(os_load_i64(wrapping(borrowed + I64{16})) == data)
        at := I64{0}
        loop at < (I64{32}) {
            os_store_u8(wrapping(data + at), I64{165})
            at = wrapping(at + I64{1})
        }
        // Fixed-length Write aliases parent storage, at padded U8 stride8.
        os_store_u8(wrapping(os_load_i64(wrapping(borrowed + I64{16})) + I64{8}), I64{71})
        secret_test_require(os_load_u8(wrapping(data + I64{8})) == I64{71})
    }
    rt_secret_zero(data, I64{24})
    #Unsafe("the test retains exclusive ownership of data and checks every live slot including padding before any release") {
        at := I64{0}
        loop at < (I64{24}) {
            secret_test_require(os_load_u8(wrapping(data + at)) == I64{0})
            os_store_u8(wrapping(data + at), I64{213})
            at = wrapping(at + I64{1})
        }
        secret_test_require(os_load_u8(wrapping(data + I64{24})) == I64{165})
    }
    jet_rt_secret_close(secret)
    secret_test_require(secret_test_live(secret) == I64{2})
    #Unsafe("secret still owns its live24B header after Close; the buffer was released, and no pointer into it is used") {
        secret_test_require(os_load_i64(secret) == I64{0})
        secret_test_require(os_load_i64(wrapping(secret + I64{8})) == I64{0})
        secret_test_require(os_load_i64(wrapping(secret + I64{16})) == I64{0})
    }
    jet_rt_secret_close(secret)
    secret_test_require(secret_test_live(secret) == I64{2})
    // Reacquire storage as a NEW live owner. The slab allocator uses its first
    // word for the free link; all remaining capacity, including the nonzero
    // spare slot past len3 in cap4, must be wiped.
    reused :: jet_rt_alloc(I64{32}, I64{8})
    secret_test_require(reused == data)
    #Unsafe("reused is newly allocated live32B storage exclusively owned by this witness, not a read of freed storage") {
        at := I64{8}
        loop at < (I64{32}) {
            secret_test_require(os_load_u8(wrapping(reused + at)) == I64{0})
            at = wrapping(at + I64{1})
        }
    }
    jet_rt_free(reused, I64{32}, I64{8})
    jet_rt_secret_drop(secret)
    secret_test_require(secret_test_live(input) == I64{1})
    jet_rt_free(input, I64{24}, I64{8})
}

fn secret_test_empty() {
    input :: secret_test_header(I64{0}, I64{0}, I64{0})
    secret :: jet_rt_secret_from_bytes(input)
    jet_rt_secret_close(secret)
    jet_rt_secret_close(secret)
    secret_test_require(secret_test_live(secret) == I64{2})
    jet_rt_secret_drop(secret)
    secret_test_require(secret_test_live(input) == I64{1})
    jet_rt_free(input, I64{24}, I64{8})
}

fn run() {
    jet_rt_alloc_init()
    secret_test_owned()
    secret_test_empty()
    #Unsafe("this isolated native witness writes its17B success literal and exits without introducing any text or collection runtime dependency") {
        message :: jet_rt_alloc(I64{17}, I64{1})
        os_store_u8(message, I64{115})
        os_store_u8(wrapping(message + I64{1}), I64{101})
        os_store_u8(wrapping(message + I64{2}), I64{99})
        os_store_u8(wrapping(message + I64{3}), I64{114})
        os_store_u8(wrapping(message + I64{4}), I64{101})
        os_store_u8(wrapping(message + I64{5}), I64{116})
        os_store_u8(wrapping(message + I64{6}), I64{32})
        os_store_u8(wrapping(message + I64{7}), I64{116})
        os_store_u8(wrapping(message + I64{8}), I64{101})
        os_store_u8(wrapping(message + I64{9}), I64{115})
        os_store_u8(wrapping(message + I64{10}), I64{116})
        os_store_u8(wrapping(message + I64{11}), I64{115})
        os_store_u8(wrapping(message + I64{12}), I64{58})
        os_store_u8(wrapping(message + I64{13}), I64{32})
        os_store_u8(wrapping(message + I64{14}), I64{111})
        os_store_u8(wrapping(message + I64{15}), I64{107})
        os_store_u8(wrapping(message + I64{16}), I64{10})
        _ := os_syscall_i64(I64{1}, I64{1}, message, I64{17}, I64{0}, I64{0}, I64{0})
        jet_rt_free(message, I64{17}, I64{1})
        _ := os_syscall_i64(I64{231}, I64{0}, I64{0}, I64{0}, I64{0}, I64{0}, I64{0})
    }
}
