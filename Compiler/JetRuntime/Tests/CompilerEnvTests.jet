// Link with the composed Jet-only runtime and CompilerEnvTests.c. C supplies
// raw startup rows, duplicate names, non-Unicode bytes and expected ABI headers.
fn compiler_env_fixture_equal(left: I64, right: I64) -> Bool {
    if (rt_text_word(left) != rt_text_word(right)) -> return false
    length :: rt_text_word(left)
    if (rt_text_word(left + I64{8}) != length) -> return false
    data :: rt_text_word(left + I64{16})
    expected :: rt_text_word(right + I64{16})
    at := I64{0}
    loop at < length {
        row :: data + at * I64{24}
        other :: expected + at * I64{24}
        if (rt_text_word(row + I64{8}) != rt_text_word(row)) -> return false
        if (jet_rt_env_key_compare(row, other) != I64{0}) -> return false
        if (rt_text_word(row) == I64{0} && rt_text_word(row + I64{16}) != I64{0}) -> return false
        at += I64{1}
    }
    if (length == I64{0} && data != I64{0}) -> return false
    true
}
fn compiler_env_fixture_drop(columns: I64) {
    length :: rt_text_word(columns)
    data :: rt_text_word(columns + I64{16})
    at := I64{0}
    loop at < length {
        row :: data + at * I64{24}
        if (rt_text_word(row) != I64{0}) -> jet_rt_free(rt_text_word(row + I64{16}), rt_text_word(row), I64{8})
        at += I64{1}
    }
    if (length != I64{0}) -> jet_rt_free(data, length * I64{24}, I64{8})
}
#Export(c) fn jet_rt_compiler_env_fixture(startup_expected: I64, logical_expected: I64, changed_expected: I64) -> I64 {
    scratch :: jet_rt_alloc(I64{96}, I64{8})
    startup :: scratch
    logical :: scratch + I64{24}
    again :: scratch + I64{48}
    changed :: scratch + I64{72}
    jet_rt_startup_env_columns(startup)
    jet_rt_logical_env_columns(logical)
    if !compiler_env_fixture_equal(startup, startup_expected) -> return I64{1}
    if !compiler_env_fixture_equal(logical, logical_expected) -> return I64{2}
    // Exact stored order, not a sorted snapshot; replacement moves to the tail.
    if (jet_rt_logical_env_set(rt_static_text("Z"), rt_static_text("changed")) != I64{0}) -> return I64{3}
    if (jet_rt_logical_env_unset(rt_static_text("A")) != I64{1}) -> return I64{4}
    jet_rt_logical_env_columns(changed)
    if !compiler_env_fixture_equal(changed, changed_expected) -> return I64{5}
    // Both returned snapshots retain their original independent byte owners.
    if !compiler_env_fixture_equal(logical, logical_expected) -> return I64{6}
    if !compiler_env_fixture_equal(startup, startup_expected) -> return I64{7}
    jet_rt_startup_env_columns(again)
    if !compiler_env_fixture_equal(again, startup_expected) -> return I64{8}
    // Modifying a returned raw buffer cannot mutate the startup cell or a
    // separately returned buffer. This first key is always the nonempty Z.
    data :: rt_text_word(startup + I64{16})
    rt_text_put(rt_text_word(data + I64{16}), I64{88})
    if !compiler_env_fixture_equal(again, startup_expected) -> return I64{9}
    compiler_env_fixture_drop(startup)
    compiler_env_fixture_drop(logical)
    compiler_env_fixture_drop(again)
    compiler_env_fixture_drop(changed)
    jet_rt_free(scratch, I64{96}, I64{8})
    I64{0}
}
#Export(c) fn jet_rt_compiler_env_empty_fixture() -> I64 {
    scratch :: jet_rt_alloc(I64{48}, I64{8})
    jet_rt_startup_env_columns(scratch)
    jet_rt_logical_env_columns(scratch + I64{24})
    at := I64{0}
    loop at < (I64{6}) {
        if (rt_text_word(scratch + at * I64{8}) != I64{0}) -> return I64{1}
        at += I64{1}
    }
    jet_rt_free(scratch, I64{48}, I64{8})
    I64{0}
}
