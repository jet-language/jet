// Runs a composed UI witness binary and holds its output byte-exact to the frozen
// goldens in Compiler/JetRuntime/Tests. Each case runs the binary with its mode
// argument and writes <case>.stdout, <case>.stderr and <case>.status.json under
// OUT. A case must exit with its status: the ownership run exits 0 with the golden
// on stdout and an empty stderr; a stop exits nonzero with an empty stdout and the
// golden on stderr. The first departing case ends the run with exit 1. Each run
// is limited to 30 seconds (key: 300) by coreutils `timeout`.
// Build and link the witness binary in the native heavy lane first.
// Usage (from the repository root):
//   jet run Compiler/JetRuntime/Tests/UiWitness -- WITNESS OUT BINARY [ORACLE]
// key also takes the frozen character ORACLE its ownership run reads.
use core.files as files
use core.process as process
use core.term as term

GOLDENS :: "Compiler/JetRuntime/Tests"
SHARED_STOP :: "DataPlotStops-getter-variant.stderr"
USAGE :: "usage: jet run Compiler/JetRuntime/Tests/UiWitness -- WITNESS OUT BINARY [ORACLE]"
WITNESSES :: "accessibility-projection, browser, choices, clipboard, dialog-selection, drag, events, file-dialog, form-action-error, host-error, ime, key, raylib-metadata, shortcut-binding, slice2, slice3, view-snapshots"
OUTPUT_MISMATCH :: "byte-exact output mismatch"

struct Case {
    name: String
    args: [String]
    status: Int
    golden: String
}

// One witness: the operands its usage line names, its cases in run order, the
// per-run timeout, the spacing of its exit message, its mismatch message, the
// summary table it writes under OUT ("" for none) and its success line.
struct Witness {
    operands: String
    oracle: Bool
    cases: [Case]
    timeout_ms: Int
    exit_gap: String
    mismatch: String
    table: String
    done: String
}

// What one run of the binary left: `exited` is false when no exit status exists
// (spawn failure, signal or timeout); `signal` and `error` are "" when absent.
struct Outcome {
    stdout: [U8]
    stderr: [U8]
    status: Int
    exited: Bool
    signal: String
    error: String
}

fn ownership(golden: String) -> Case Never! { Case{name: "ownership", args: [String]{}, status: 0, golden: golden} }

fn stop(mode: String, status: Int, golden: String) -> Case Never! { Case{name: mode, args: [String]{mode}, status: status, golden: golden} }

fn plain(operand: String, golden: String, done: String) -> Witness Never! {
    Witness{operands: "OUT {operand}", oracle: false, cases: [Case]{ownership(golden)}, timeout_ms: 30000, exit_gap: "", mismatch: OUTPUT_MISMATCH, table: "", done: done}
}

// Ownership, then the shared record-variant stop (exit 70) for every mode.
fn variant_stops(operand: String, golden: String, modes: [String], exit_gap: String, done: String) -> Witness Never! {
    cases := [Case]{ownership(golden)}
    loop mode in modes {
        &cases.push(stop(mode, 70, SHARED_STOP))
    }
    Witness{operands: "OUT {operand}", oracle: false, cases: cases, timeout_ms: 30000, exit_gap: exit_gap, mismatch: OUTPUT_MISMATCH, table: "", done: done}
}

// The carrier slices: ownership, their own stops, then the four shared-sequence
// capacity and index stops (exit 101); a table of the passing cases is written.
fn sequence_stops(slice: String, operand: String, golden: String, own: [Case], done: String) -> Witness Never! {
    cases := [Case]{ownership(golden)}
    loop item in own {
        &cases.push(item.copy())
    }
    &cases.push(stop("negative-capacity", 101, "UiCarriersSlice2Stops-capacity.stderr"))
    &cases.push(stop("oversize-capacity", 101, "UiCarriersSlice2Stops-capacity.stderr"))
    &cases.push(stop("index-zero", 101, "UiCarriersSlice2Stops-index-zero.stderr"))
    &cases.push(stop("index-negative", 101, "UiCarriersSlice2Stops-index-negative.stderr"))
    Witness{operands: "OUT {operand}", oracle: false, cases: cases, timeout_ms: 30000, exit_gap: " ", mismatch: "byte-exact stdout/stderr mismatch", table: "ui-{slice}.tsv", done: done}
}

// The witness a name selects; an unknown name has no cases.
fn witness(key: String) -> Witness Never! {
    tags :: [String]{"clone-tag", "drop-tag", "eq-tag"}
    if key == "accessibility-projection" -> return plain("UI_ACCESSIBILITY_PROJECTION_WITNESS", "UiAccessibilityProjectionWitness.stdout", "UI AccessibilityProjection: real-provider ownership byte-identical")
    if key == "browser" -> return plain("UI_BROWSER_WITNESS", "UiBrowserWitness.stdout", "UI Browser: real pure producers and borrowed-kind ownership byte-identical")
    if key == "clipboard" -> return plain("UI_CLIPBOARD_WITNESS", "UiClipboardWitness.stdout", "UI Clipboard: real-provider ownership byte-identical")
    if key == "dialog-selection" -> return plain("UI_DIALOG_SELECTION_WITNESS", "UiDialogSelectionWitness.stdout", "UI DialogSelection: real-provider ownership byte-identical")
    if key == "events" -> return plain("UI_EVENTS_WITNESS", "UiEventsWitness.stdout", "UI events: real-provider ownership byte-identical")
    if key == "file-dialog" -> return plain("UI_FILE_DIALOG_WITNESS", "UiFileDialogWitness.stdout", "UI FileDialog: real-provider ownership byte-identical")
    if key == "form-action-error" -> return plain("UI_ACTION_ERROR_WITNESS", "UiFormActionErrorWitness.stdout", "UI ActionError: real consumed producers and transitive ownership byte-identical")
    if key == "raylib-metadata" -> return plain("UI_RAYLIB_METADATA_WITNESS", "UiRaylibMetadataWitness.stdout", "UI raylib metadata and canonical Cursor: real-provider ownership byte-identical")
    if key == "view-snapshots" -> return plain("UI_VIEW_SNAPSHOTS_WITNESS", "UiViewSnapshotsWitness.stdout", "UI view snapshots: real-provider ownership byte-identical")
    if key == "choices" -> return variant_stops("UI_CHOICES_WITNESS", "UiCarriersChoicesWitness.stdout", [String]{"aria-tag"}, " ", "UI choices: ownership and record-variant stop byte-identical")
    if key == "host-error" -> return variant_stops("UI_HOST_ERROR_WITNESS", "UiHostErrorWitness.stdout", tags, "", "UI HostError: seed ownership and shared variant stops byte-identical")
    if key == "ime" -> return variant_stops("UI_IME_WITNESS", "UiImeWitness.stdout", tags, "", "UI IME: seed ownership and shared variant stops byte-identical")
    if key == "shortcut-binding" -> return variant_stops("UI_SHORTCUT_BINDING_WITNESS", "UiShortcutBindingWitness.stdout", tags, "", "UI ShortcutBinding: seed ownership and shared variant stops byte-identical")
    if key == "drag" {
        modes := [String]{}
        kinds :: [String]{"phase", "operation", "item"}
        loop kind in kinds {
            loop suffix in tags {
                &modes.push("{kind}-{suffix}")
            }
        }
        return variant_stops("UI_DRAG_WITNESS", "UiDragWitness.stdout", modes, "", "UI Drag: seed ownership and shared variant stops byte-identical")
    }
    if key == "key" {
        cases :: [Case]{ownership("UiKeyWitness.stdout"), stop("key-tag", 70, SHARED_STOP)}
        return Witness{operands: "OUT UI_KEY_WITNESS FROZEN_CHAR_ORACLE", oracle: true, cases: cases, timeout_ms: 300000, exit_gap: " ", mismatch: OUTPUT_MISMATCH, table: "", done: "UI Key: exhaustive real-provider oracle and record-variant stop byte-identical"}
    }
    if key == "slice2" -> return sequence_stops("slice2", "UI_SLICE2_WITNESS", "UiCarriersSlice2Witness.stdout", [Case]{}, "UI slice2: ownership and four shared-sequence stop modes byte-identical")
    if key == "slice3" -> return sequence_stops("slice3", "UI_SLICE3_WITNESS", "UiCarriersSlice3Witness.stdout", [Case]{stop("sort-tag", 70, "DataPlotStops-ctor-range.stderr")}, "UI slice3: ownership, range stop and four shared-sequence stops byte-identical")
    Witness{operands: "", oracle: false, cases: [Case]{}, timeout_ms: 0, exit_gap: "", mismatch: "", table: "", done: ""}
}

fn fail(message: String) -[IO]> Int Never! {
    term.eprint(message)
    1
}

// An absolute path with `.`, `..` and empty segments folded, as path.resolve gives.
fn resolve(cwd: String, path: String) -> String Never! {
    full :: if path.starts_with("/") -> path.copy() else -> "{cwd}/{path}"
    parts := [String]{}
    loop part in full.split("/").to_list() {
        if part == ".." {
            if parts.len() > 0 {
                kept := [String]{}
                loop index in 0..<parts.len() - 1 {
                    &kept.push(parts[index].copy())
                }
                parts = kept
            }
        } else if part != "" && part != "." {
            &parts.push(part.copy())
        }
    }
    "/{parts.join("/")}"
}

fn same_bytes(left: [U8], right: [U8]) -> Bool Never! {
    if left.len() != right.len() -> return false
    loop index in 0..<left.len() {
        if left[index] != right[index] -> return false
    }
    true
}

fn json_text(text: String) -> String Never! {
    out := ""
    loop byte in text.bytes() {
        code :: Int.from_u8(byte)
        if code == 34 -> out = "{out}\\\""
        else if code == 92 -> out = "{out}\\\\"
        else -> out = "{out}{String.from_bytes_lossy([U8]{byte})}"
    }
    "\"{out}\""
}

fn signal_name(number: Int) -> String Never! {
    names :: [String]{"", "SIGHUP", "SIGINT", "SIGQUIT", "SIGILL", "SIGTRAP", "SIGABRT", "SIGBUS", "SIGFPE", "SIGKILL", "SIGUSR1", "SIGSEGV", "SIGUSR2", "SIGPIPE", "SIGALRM", "SIGTERM"}
    if number > 0 && number < names.len() -> return names[number].copy()
    "SIG{number}"
}

// coreutils `timeout` reports its own failures on stderr with this prefix.
TIMEOUT_FAILED :: "timeout: failed to run command"
TIMEOUT_CORE :: "timeout: the monitored command dumped core\n"

// Runs the binary under coreutils `timeout` (the per-run limit, then SIGTERM), and
// reports the run the way node's spawnSync does: no status after a signal, a
// timeout or a spawn failure, and spawn failures and timeouts as an error message.
fn run_binary(binary: String, args: [String], timeout_ms: Int) -[Exec, FS, IO, Time.Wait]> Outcome Never! {
    none :: [U8]{}
    if !files.exists(binary) -> return Outcome{stdout: none.copy(), stderr: none.copy(), status: 0, exited: false, signal: "", error: "spawnSync {binary} ENOENT"}
    argv := [String]{"timeout", "{timeout_ms /% 1000}", binary.copy()}
    loop arg in args {
        &argv.push(arg.copy())
    }
    if process.cmd(argv).run() == {
        .Ok(receipt) -> {
            stdout :: receipt.output.bytes()
            if receipt.signal == .Val(number) {
                errors :: if receipt.errors.ends_with(TIMEOUT_CORE) -> receipt.errors.replace(TIMEOUT_CORE, "") else -> receipt.errors.copy()
                return Outcome{stdout: stdout, stderr: errors.bytes(), status: 0, exited: false, signal: signal_name(number), error: ""}
            }
            if receipt.code == 124 -> return Outcome{stdout: stdout, stderr: receipt.errors.bytes(), status: 0, exited: false, signal: "SIGTERM", error: "spawnSync {binary} ETIMEDOUT"}
            if (receipt.code == 126 || receipt.code == 127) && receipt.errors.starts_with(TIMEOUT_FAILED) {
                code :: if receipt.code == 126 -> "EACCES" else -> "ENOENT"
                return Outcome{stdout: none.copy(), stderr: none.copy(), status: 0, exited: false, signal: "", error: "spawnSync {binary} {code}"}
            }
            Outcome{stdout: stdout, stderr: receipt.errors.bytes(), status: receipt.code, exited: true, signal: "", error: ""}
        }
        .Err(error) -> Outcome{stdout: none.copy(), stderr: none.copy(), status: 0, exited: false, signal: "", error: "spawnSync {binary} {error}"}
    }
}

fn write_file(path: String, bytes: [U8]) -[FS, IO]> Bool Never! {
    if files.write_bytes(path, bytes) == {
        .Ok(_) -> true
        .Err(error) -> {
            term.eprint("cannot write {path}: {error}")
            false
        }
    }
}

fn ui_witness(args: [String]) -[Exec, Env, FS, IO, Time.Wait]> Int Never! {
    if args.len() == 0 -> return fail("{USAGE}\nWITNESS is one of: {WITNESSES}")
    key :: args[0]
    spec :: witness(key)
    if spec.cases.len() == 0 -> return fail("unknown witness: {key}\nWITNESS is one of: {WITNESSES}")
    wanted :: if spec.oracle -> 4 else -> 3
    empty_operand :: args.contains("")
    if args.len() != wanted || empty_operand -> return fail("usage: jet run Compiler/JetRuntime/Tests/UiWitness -- {key} {spec.operands}")
    cwd :: files.cwd() ?? return fail("cannot read the working directory: {err}")
    out :: resolve(cwd, args[1])
    binary :: resolve(cwd, args[2])
    if files.create_dir_all(out) == {
        .Ok(_) -> {}
        .Err(error) -> return fail("cannot create {out}: {error}")
    }
    rows := [String]{}
    loop item in spec.cases {
        run_args := item.args.copy()
        if spec.oracle && item.status == 0 {
            run_args = [String]{resolve(cwd, args[3])}
        }
        outcome :: run_binary(binary, run_args, spec.timeout_ms)
        status :: if outcome.exited -> "{outcome.status}" else -> "null"
        signal :: if outcome.signal == "" -> "null" else -> json_text(outcome.signal)
        error :: if outcome.error == "" -> "null" else -> json_text(outcome.error)
        if !write_file("{out}/{item.name}.stdout", outcome.stdout) -> return 1
        if !write_file("{out}/{item.name}.stderr", outcome.stderr) -> return 1
        if !write_file("{out}/{item.name}.status.json", "{{\"status\":{status},\"signal\":{signal},\"error\":{error}}}\n".bytes()) -> return 1
        if outcome.error != "" || outcome.signal != "" || !outcome.exited || outcome.status != item.status {
            shown_signal :: if outcome.signal == "" -> "null" else -> outcome.signal
            return fail("{item.name}: expected exit{spec.exit_gap}{item.status}, got {status}/{shown_signal}/{outcome.error}")
        }
        golden_path :: "{cwd}/{GOLDENS}/{item.golden}"
        expected :: if files.read_bytes(golden_path) == {
            .Ok(value) -> value
            .Err(_) -> { return fail("ENOENT: no such file or directory, open '{golden_path}'") }
        }
        want_stdout :: if item.status == 0 -> expected.copy() else -> [U8]{}
        want_stderr :: if item.status == 0 -> [U8]{} else -> expected.copy()
        if !same_bytes(outcome.stdout, want_stdout) || !same_bytes(outcome.stderr, want_stderr) -> return fail("{item.name}: {spec.mismatch}")
        &rows.push("{item.name}\tpass\texit={item.status}\tstdout-byte-identical=true\tstderr-byte-identical=true")
    }
    if spec.table != "" {
        if !write_file("{out}/{spec.table}", "{rows.join("\n")}\n".bytes()) -> return 1
    }
    print(spec.done)
    0
}

fn run() {
    code :: ui_witness(process.args())
    if code != 0 -> process.exit(code)
}

#Test("every witness names its cases and the shared stops") {
    assert_eq(witness("drag").cases.len(), 10)
    assert_eq(witness("drag").cases[9].name, "item-eq-tag")
    assert_eq(witness("slice3").cases.len(), 6)
    assert_eq(witness("slice3").cases[2].golden, "UiCarriersSlice2Stops-capacity.stderr")
    assert_eq(witness("nope").cases.len(), 0)
    assert_eq(resolve("/a/b", "../c/./d//e"), "/a/c/d/e")
    assert_eq(resolve("/a", "/x/../y"), "/y")
}
