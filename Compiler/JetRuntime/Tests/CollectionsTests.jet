// Raw ABI ownership witnesses alongside the high-level collection goldens.
fn coll_test_require(ok: Bool) {
    if ok {
        return
    }
    trap_exit(I64{1})
    loop {

    }
}

fn coll_test_meta() -> I64 {
    meta :: jet_rt_alloc(I64{72}, I64{8})
    coll_zero(meta, I64{72})
    trap_store(meta, I64{8})
    trap_store(meta + I64{48}, I64{274877906946})
    meta
}

fn coll_test_source() -> I64 {
    meta :: coll_test_meta()
    header :: coll_list_new()
    slot :: jet_rt_alloc(I64{8}, I64{8})
    at := I64{1}
    loop at <= (I64{5}) {
        trap_store(slot, at)
        coll_list_push(header, slot, meta)
        at += I64{1}
    }
    source :: jet_rt_native_iter_from_list(header, meta, I64{1})
    coll_test_require(trap_word(header) == I64{0} && trap_word(header + I64{8}) == I64{0} && trap_word(header + I64{16}) == I64{0})
    jet_rt_free(header, I64{24}, I64{8})
    jet_rt_free(slot, I64{8}, I64{8})
    // The node must own the descriptor, not borrow this expired one.
    coll_meta_drop(meta)
    source
}

// Single-threaded bounded fixtures never fill a slab or allocate directly.
// Count each available slab's live payloads in every arena, excluding bounded
// empty caches.
fn coll_test_live(width: I64) -> I64 { alloc_available_live(width) }

fn coll_test_bytes() {
    coll_test_require(RT_HOST_U8_STRIDE == I64{1})
    snapshot :: jet_rt_alloc(I64{64}, I64{8})
    width := I64{32}
    at := I64{0}
    loop at < (I64{8}) {
        trap_store(snapshot + at * I64{8}, coll_test_live(width))
        width *= I64{2}
        at += I64{1}
    }
    meta :: coll_test_meta()
    trap_store(meta, I64{1})
    trap_store(meta + I64{48}, I64{34359738371})
    slot :: coll_slot_new(meta)
    case := I64{0}
    loop case < (I64{3}) {
        length :: if (case == I64{0}) -> I64{0} else if (case == I64{1}) -> I64{1} else -> I64{255}
        input :: coll_list_new()
        at = I64{0}
        loop at < length {
            trap_put(slot, if (length == I64{1}) -> I64{255} else -> at)
            coll_list_push(input, slot, meta)
            at += I64{1}
        }
        packed :: jet_rt_bytes_pack(input)
        coll_test_require(packed != I64{0})
        output :: jet_rt_bytes_unpack(packed, length)
        coll_test_require(trap_word(input) == length && trap_word(output) == length)
        if (length == I64{0}) {
            coll_test_require(packed == I64{1} && trap_word(output + I64{8}) == I64{0} && trap_word(output + I64{16}) == I64{0})
        } else {
            original :: trap_word(input + I64{16})
            restored :: trap_word(output + I64{16})
            coll_test_require(packed != original && restored != original && restored != packed)
            at = I64{0}
            loop at < length {
                expected :: if (length == I64{1}) -> I64{255} else -> at
                coll_test_require(trap_byte(packed + at) == expected && trap_byte(original + at) == expected && trap_byte(restored + at) == expected)
                at += I64{1}
            }
            // Unpack copies, rather than adopting the borrowed C buffer.
            trap_put(packed, I64{99})
            coll_test_require(trap_byte(restored) == (if (length == I64{1}) -> I64{255} else -> I64{0}))
        }
        jet_rt_bytes_free(packed, length)
        coll_list_drop(input, meta, I64{0})
        coll_list_drop(output, meta, I64{0})
        jet_rt_free(input, I64{24}, I64{8})
        jet_rt_free(output, I64{24}, I64{8})
        case += I64{1}
    }
    jet_rt_free(slot, coll_size(meta), I64{8})
    coll_meta_drop(meta)
    width = I64{32}
    at = I64{0}
    loop at < (I64{8}) {
        coll_test_require(coll_test_live(width) == trap_word(snapshot + at * I64{8}))
        width *= I64{2}
        at += I64{1}
    }
    jet_rt_free(snapshot, I64{64}, I64{8})
}

// Seed oracle: Core/Collections.rs:175-187 delegates all three render modes
// to the sorted list; Values.rs:369-372 spells "[", ", ", "]".
fn coll_test_bits_render(bits: I64, low: I64, high: I64, length: I64) {
    display :: jet_rt_handle_display_jet_bit_set(bits)
    show :: jet_rt_handle_show_jet_bit_set(bits)
    debug :: jet_rt_handle_debug_jet_bit_set(bits)
    coll_test_require(rt_text_len(display) == length && rt_text_len(show) == length && rt_text_len(debug) == length)
    at := I64{0}
    loop at < length {
        word :: if (at < I64{8}) -> low else -> high
        shift :: (at % I64{8}) * I64{8}
        expected :: (word >> shift).bit_and(I64{255})
        coll_test_require(trap_byte(rt_text_data(display) + at) == expected)
        coll_test_require(trap_byte(rt_text_data(show) + at) == expected)
        coll_test_require(trap_byte(rt_text_data(debug) + at) == expected)
        at += I64{1}
    }
    jet_rt_string_drop(display)
    jet_rt_string_drop(show)
    jet_rt_string_drop(debug)
}

fn coll_test_bits() {
    snapshot :: jet_rt_alloc(I64{64}, I64{8})
    width := I64{32}
    at := I64{0}
    loop at < (I64{8}) {
        trap_store(snapshot + at * I64{8}, coll_test_live(width))
        width *= I64{2}
        at += I64{1}
    }
    bits :: jet_rt_native_bits_new()
    out :: jet_rt_alloc(I64{8}, I64{8})
    trap_store(out, I64{-1})
    coll_test_require(jet_bit_set_is_empty(bits) && jet_bit_set_count(bits) == I64{0} && jet_bit_set_len(bits) == I64{0})
    coll_test_require(jet_bit_set_to_list(bits, out) == I64{0} && trap_word(out) == I64{0})
    coll_test_bits_render(bits, I64{23899}, I64{0}, I64{2})  // []
    coll_test_require(!jet_bitset_add(bits, I64{-1}) && !jet_bit_set_has(bits, I64{-1}))
    coll_test_require(jet_bitset_add(bits, I64{100}) && jet_bitset_add(bits, I64{0}) && jet_bitset_add(bits, I64{4}))
    coll_test_require(!jet_bitset_add(bits, I64{4}) && jet_bit_set_count(bits) == I64{3} && jet_bit_set_len(bits) == I64{101})
    coll_test_require(jet_bit_set_has(bits, I64{0}) && jet_bit_set_has(bits, I64{4}) && jet_bit_set_has(bits, I64{100}) && !jet_bit_set_has(bits, I64{3}))
    coll_test_bits_render(bits, I64{3539877909502898267}, I64{6107184}, I64{11})  // [0, 4, 100]
    copied :: jet_bits_copy(bits)
    empty_copy :: jet_bits_copy(bits)
    jet_rt_native_bits_clear(empty_copy)
    empty_clone :: jet_rt_handle_clone_jet_bit_set(empty_copy)
    coll_test_require(jet_bit_set_is_empty(empty_clone) && trap_word(empty_clone + I64{8}) == I64{0})
    jet_rt_handle_drop_jet_bit_set(empty_copy)
    jet_rt_handle_drop_jet_bit_set(empty_clone)
    cloned :: jet_rt_handle_clone_jet_bit_set(bits)
    index := I64{0}
    loop index < (I64{20}) {
        coll_test_require(jet_bitset_add(cloned, I64{1000} + index))
        index += I64{1}
    }
    coll_test_require(jet_bit_set_count(cloned) == I64{23} && jet_bit_set_len(cloned) == I64{1020})
    loop index > (I64{0}) {
        index -= I64{1}
        jet_bitset_remove(cloned, I64{1000} + index)
    }
    coll_test_require(jet_bit_set_count(cloned) == I64{3})
    coll_test_require(copied != bits && cloned != bits && cloned != copied)
    coll_test_require(trap_word(copied + I64{16}) != trap_word(bits + I64{16}))
    jet_bitset_remove(bits, I64{100})
    jet_bitset_remove(bits, I64{3})
    jet_bitset_remove(bits, I64{-1})
    coll_test_require(jet_bit_set_len(bits) == I64{5} && jet_bit_set_count(bits) == I64{2} && jet_bit_set_has(copied, I64{100}) && jet_bit_set_has(cloned, I64{100}))
    jet_bitset_remove(bits, I64{0})
    jet_bitset_remove(bits, I64{4})
    coll_test_require(jet_bit_set_is_empty(bits) && jet_bit_set_len(bits) == I64{0})
    // I64 indices outside the inline exact-Int rail survive both ABI seams.
    wide :: jet_int_owned_from_i64(I64{4611686018427387904})
    coll_test_require(jet_bitset_add(bits, wide) && jet_bit_set_has(bits, wide))
    extent :: jet_bit_set_len(bits)
    coll_test_require(jet_int_owned_to_i64(extent) == I64{4611686018427387905})
    jet_rt_int_drop(extent)
    coll_test_require(jet_bit_set_to_list(bits, out) == I64{1})
    data :: trap_word(out)
    listed :: trap_word(data)
    coll_test_require(jet_int_owned_to_i64(listed) == I64{4611686018427387904})
    jet_rt_handle_drop_jet_bit_set(bits)
    coll_test_require(jet_int_owned_to_i64(listed) == I64{4611686018427387904})
    jet_rt_int_drop(listed)
    jet_rt_int_drop(wide)
    jet_rt_free(data, I64{8}, I64{8})
    // A fresh sorted list owns its storage independently of the copied set.
    coll_test_require(jet_bit_set_to_list(copied, out) == I64{3})
    sorted :: trap_word(out)
    jet_rt_native_bits_clear(copied)
    coll_test_require(jet_bit_set_is_empty(copied) && trap_word(copied + I64{8}) == I64{0} && trap_word(copied + I64{16}) == I64{0})
    coll_test_require(trap_word(sorted) == I64{0} && trap_word(sorted + I64{8}) == I64{4} && trap_word(sorted + I64{16}) == I64{100})
    jet_rt_free(sorted, I64{24}, I64{8})
    jet_rt_handle_drop_jet_bit_set(copied)
    jet_rt_handle_drop_jet_bit_set(cloned)
    jet_rt_handle_drop_jet_bit_set(I64{0})
    jet_rt_free(out, I64{8}, I64{8})
    width = I64{32}
    at = I64{0}
    loop at < (I64{8}) {
        coll_test_require(coll_test_live(width) == trap_word(snapshot + at * I64{8}))
        width *= I64{2}
        at += I64{1}
    }
    jet_rt_free(snapshot, I64{64}, I64{8})
}

// The checked seed profile keeps overflow checks on even in release builds.
// A maximum index is valid membership; only its unrepresentable extent stops.
fn coll_test_bits_extent_stop() {
    jet_rt_alloc_init()
    bits :: jet_rt_native_bits_new()
    maximum :: jet_int_owned_from_i64(I64{9223372036854775807})
    coll_test_require(jet_bitset_add(bits, maximum) && jet_bit_set_has(bits, maximum))
    jet_rt_int_drop(maximum)
    _ := jet_bit_set_len(bits)
    // Reaching here is a failed witness, never a successful neutral length.
    trap_exit(I64{1})
}

fn coll_test_para_fold() {
    snapshot :: jet_rt_alloc(I64{64}, I64{8})
    width := I64{32}
    at := I64{0}
    loop at < (I64{8}) {
        trap_store(snapshot + at * I64{8}, coll_test_live(width))
        width *= I64{2}
        at += I64{1}
    }
    data :: jet_rt_alloc(I64{1536}, I64{8})
    at = I64{0}
    loop at < (I64{192}) {
        trap_store(data + at * I64{8}, rt_f64_bits(Float{1.0}))
        at += I64{1}
    }
    coll_test_require(rt_f64_bits(jet_list_para_fold_add_fixed_f64(I64{0}, I64{0}, Float{-0.0})) == I64{-9223372036854775808})
    coll_test_require(jet_list_para_fold_add_fixed_f64(data, I64{1}, Float{10.0}) == Float{11.0})
    coll_test_require(jet_list_para_fold_add_fixed_f64(data, I64{64}, Float{10.0}) == Float{74.0})
    coll_test_require(jet_list_para_fold_add_fixed_f64(data, I64{65}, Float{10.0}) == Float{85.0})
    coll_test_require(jet_list_para_fold_add_fixed_f64(data, I64{129}, Float{10.0}) == Float{159.0})
    // A left serial fold gives 1, but the canonical eight-lane tree gives 0.
    trap_store(data, rt_f64_bits(Float{10000000000000000.0}))
    trap_store(data + I64{16}, rt_f64_bits(Float{-10000000000000000.0}))
    coll_test_require(jet_list_para_fold_add_fixed_f64(data, I64{4}, Float{0.0}) == Float{0.0})
    coll_zero(data, I64{1536})
    trap_store(data, rt_f64_bits(Float{10000000000000000.0}))
    trap_store(data + I64{512}, rt_f64_bits(Float{-10000000000000000.0}))
    trap_store(data + I64{1024}, rt_f64_bits(Float{1.0}))
    // Three chunks distinguish adjacent-pair/odd-carry from right association.
    coll_test_require(jet_list_para_fold_add_fixed_f64(data, I64{192}, Float{0.0}) == Float{1.0})
    jet_rt_free(data, I64{1536}, I64{8})
    width = I64{32}
    at = I64{0}
    loop at < (I64{8}) {
        coll_test_require(coll_test_live(width) == trap_word(snapshot + at * I64{8}))
        width *= I64{2}
        at += I64{1}
    }
    jet_rt_free(snapshot, I64{64}, I64{8})
}

fn coll_test_i64_lists() {
    snapshot :: jet_rt_alloc(I64{64}, I64{8})
    width := I64{32}
    at := I64{0}
    loop at < (I64{8}) {
        trap_store(snapshot + at * I64{8}, coll_test_live(width))
        width *= I64{2}
        at += I64{1}
    }
    input :: jet_rt_alloc(I64{40}, I64{8})
    output :: jet_rt_alloc(I64{8}, I64{8})
    trap_store(input, I64{0})
    trap_store(input + I64{8}, I64{2})
    trap_store(input + I64{16}, I64{2})
    trap_store(input + I64{24}, I64{5})
    coll_test_require(jet_coll_bisect_left(input, I64{4}, I64{2}) == I64{1})
    coll_test_require(jet_coll_bisect_right(input, I64{4}, I64{2}) == I64{3})
    coll_test_require(jet_coll_bisect_left(I64{0}, I64{0}, I64{-1}) == I64{0})
    coll_test_require(jet_coll_insort_left(input, I64{4}, I64{-1}, output) == I64{5})
    data :: trap_word(output)
    coll_test_require(data != input && trap_word(data) == I64{-1} && trap_word(data + I64{32}) == I64{5})
    jet_rt_free(data, I64{40}, I64{8})
    coll_test_require(jet_coll_insort_right(input, I64{4}, I64{2}, output) == I64{5})
    inserted :: trap_word(output)
    coll_test_require(trap_word(inserted + I64{8}) == I64{2} && trap_word(inserted + I64{24}) == I64{2})
    jet_rt_free(inserted, I64{40}, I64{8})
    coll_test_require(jet_coll_merge_sorted(input, I64{2}, input + I64{16}, I64{2}, output) == I64{4})
    merged :: trap_word(output)
    coll_test_require(trap_word(merged) == I64{0} && trap_word(merged + I64{8}) == I64{2} && trap_word(merged + I64{16}) == I64{2} && trap_word(merged + I64{24}) == I64{5})
    jet_rt_free(merged, I64{32}, I64{8})
    trap_store(input, I64{4})
    trap_store(input + I64{8}, I64{1})
    trap_store(input + I64{16}, I64{3})
    trap_store(input + I64{24}, I64{2})
    trap_store(input + I64{32}, I64{5})
    coll_test_require(jet_coll_heapify(input, I64{5}, output) == I64{5})
    heap :: trap_word(output)
    coll_test_require(trap_word(heap) == I64{1} && trap_word(heap + I64{8}) == I64{2})
    coll_test_require(jet_coll_heappush(heap, I64{5}, I64{0}, output) == I64{6})
    grown :: trap_word(output)
    coll_test_require(trap_word(grown) == I64{0} && trap_word(heap) == I64{1} && trap_word(input) == I64{4})
    at = I64{1}
    loop at < (I64{6}) {
        coll_test_require(trap_word(grown + at * I64{8}) >= trap_word(grown + ((at - I64{1}) / I64{2}) * I64{8}))
        at += I64{1}
    }
    jet_rt_free(heap, I64{40}, I64{8})
    jet_rt_free(grown, I64{48}, I64{8})
    trap_store(input, I64{-9223372036854775808})
    trap_store(input + I64{32}, I64{9223372036854775807})
    coll_test_require(jet_coll_nsmallest(I64{2}, input, I64{5}, output) == I64{2})
    small :: trap_word(output)
    coll_test_require(trap_word(small) == I64{-9223372036854775808} && trap_word(small + I64{8}) == I64{1})
    jet_rt_free(small, I64{16}, I64{8})
    coll_test_require(jet_coll_nlargest(I64{8}, input, I64{5}, output) == I64{5})
    large :: trap_word(output)
    coll_test_require(trap_word(large) == I64{9223372036854775807} && trap_word(large + I64{32}) == I64{-9223372036854775808})
    jet_rt_free(large, I64{40}, I64{8})
    coll_test_require(jet_coll_nsmallest(I64{-1}, input, I64{5}, output) == I64{0} && trap_word(output) == I64{0})
    coll_test_require(jet_coll_heapify(I64{0}, I64{0}, output) == I64{0} && trap_word(output) == I64{0})
    jet_rt_free(input, I64{40}, I64{8})
    jet_rt_free(output, I64{8}, I64{8})
    width = I64{32}
    at = I64{0}
    loop at < (I64{8}) {
        coll_test_require(coll_test_live(width) == trap_word(snapshot + at * I64{8}))
        width *= I64{2}
        at += I64{1}
    }
    jet_rt_free(snapshot, I64{64}, I64{8})
}

fn coll_test_short_text(word: I64, length: I64) -> I64 {
    scratch :: jet_rt_alloc(I64{8}, I64{8})
    trap_store(scratch, word)
    text :: jet_rt_string_from_static(scratch, length)
    jet_rt_free(scratch, I64{8}, I64{8})
    text
}

fn coll_test_ordered_map() {
    snapshot :: jet_rt_alloc(I64{64}, I64{8})
    width := I64{32}
    at := I64{0}
    loop at < (I64{8}) {
        trap_store(snapshot + at * I64{8}, coll_test_live(width))
        width *= I64{2}
        at += I64{1}
    }
    a :: coll_test_short_text(I64{97}, I64{1})
    b :: coll_test_short_text(I64{98}, I64{1})
    x :: coll_test_short_text(I64{120}, I64{1})
    y :: coll_test_short_text(I64{121}, I64{1})
    nul :: coll_test_short_text(I64{6422625}, I64{3})  // a NUL b
    out :: jet_rt_alloc(I64{8}, I64{8})
    empty :: jet_coll_ordered_map()
    coll_test_require(jet_coll_map_len(empty) == I64{0} && !jet_coll_map_contains(empty, a))
    trap_store(out, I64{-1})
    coll_test_require(jet_coll_map_get(empty, a, out) == I64{0} && trap_word(out) == I64{-1})
    one :: jet_coll_map_set(empty, a, x)
    clone :: jet_rt_handle_clone_jet_ordered_map(one)
    // Independent literal oracle: OrderedMap{keys: [a], values: [x]}.
    expected :: jet_rt_alloc(I64{40}, I64{8})
    trap_store(expected, I64{5576693780593275471})
    trap_store(expected + I64{8}, I64{4211843553023455329})
    trap_store(expected + I64{16}, I64{7022836043848178464})
    trap_store(expected + I64{24}, I64{8672560942848243052})
    trap_store(expected + I64{32}, I64{32093})
    mode := I64{0}
    loop mode < (I64{3}) {
        text :: if (mode == I64{0}) -> jet_rt_handle_display_jet_ordered_map(one) else if (mode == I64{1}) -> jet_rt_handle_show_jet_ordered_map(one) else -> jet_rt_handle_debug_jet_ordered_map(one)
        coll_test_require(rt_text_len(text) == I64{34})
        at = I64{0}
        loop at < (I64{34}) {
            coll_test_require(trap_byte(rt_text_data(text) + at) == trap_byte(expected + at))
            at += I64{1}
        }
        jet_rt_string_drop(text)
        mode += I64{1}
    }
    jet_rt_free(expected, I64{40}, I64{8})
    replaced :: jet_coll_map_set(one, a, nul)
    two :: jet_coll_map_set(replaced, b, y)
    coll_test_require(jet_coll_map_len(one) == I64{1} && jet_coll_map_len(two) == I64{2})
    coll_test_require(jet_coll_map_get(one, a, out) == I64{1})
    original_value :: trap_word(out)
    coll_test_require(rt_text_len(original_value) == I64{1} && trap_byte(rt_text_data(original_value)) == I64{120})
    jet_rt_string_drop(original_value)
    coll_test_require(jet_coll_map_keys(two, out) == I64{2})
    keys :: trap_word(out)
    coll_test_require(jet_rt_string_eq(trap_word(keys), a) && jet_rt_string_eq(trap_word(keys + I64{8}), b))
    jet_rt_string_drop(trap_word(keys))
    jet_rt_string_drop(trap_word(keys + I64{8}))
    jet_rt_free(keys, I64{16}, I64{8})
    coll_test_require(jet_coll_map_values(two, out) == I64{2})
    values :: trap_word(out)
    coll_test_require(jet_rt_string_eq(trap_word(values), nul) && jet_rt_string_eq(trap_word(values + I64{8}), y))
    jet_rt_string_drop(trap_word(values))
    jet_rt_string_drop(trap_word(values + I64{8}))
    jet_rt_free(values, I64{16}, I64{8})
    missing_copy :: jet_coll_map_remove(one, b)
    removed :: jet_coll_map_remove(two, a)
    coll_test_require(missing_copy != one && jet_coll_map_len(missing_copy) == I64{1})
    coll_test_require(jet_coll_map_len(removed) == I64{1} && !jet_coll_map_contains(removed, a) && jet_coll_map_contains(removed, b))
    coll_test_require(jet_coll_map_get(two, a, out) == I64{1})
    surviving_value :: trap_word(out)
    jet_rt_handle_drop_jet_ordered_map(two)
    jet_rt_handle_drop_jet_ordered_map(replaced)
    jet_rt_handle_drop_jet_ordered_map(one)
    jet_rt_handle_drop_jet_ordered_map(empty)
    jet_rt_handle_drop_jet_ordered_map(missing_copy)
    jet_rt_handle_drop_jet_ordered_map(removed)
    jet_rt_string_drop(a)
    jet_rt_string_drop(b)
    jet_rt_string_drop(x)
    jet_rt_string_drop(y)
    jet_rt_string_drop(nul)
    coll_test_require(rt_text_len(surviving_value) == I64{3} && trap_byte(rt_text_data(surviving_value) + I64{1}) == I64{0})
    jet_rt_string_drop(surviving_value)
    coll_test_require(jet_coll_map_len(clone) == I64{1})
    jet_rt_handle_drop_jet_ordered_map(clone)
    jet_rt_handle_drop_jet_ordered_map(I64{0})
    jet_rt_free(out, I64{8}, I64{8})
    width = I64{32}
    at = I64{0}
    loop at < (I64{8}) {
        coll_test_require(coll_test_live(width) == trap_word(snapshot + at * I64{8}))
        width *= I64{2}
        at += I64{1}
    }
    jet_rt_free(snapshot, I64{64}, I64{8})
}

fn coll_test_text_slots_drop(data: I64, length: I64) {
    at := I64{0}
    loop at < length {
        jet_rt_string_drop(trap_word(data + at * I64{8}))
        at += I64{1}
    }
    if (length != I64{0}) { jet_rt_free(data, length * I64{8}, I64{8}) }
}

fn coll_test_counter() {
    snapshot :: jet_rt_alloc(I64{64}, I64{8})
    width := I64{32}
    at := I64{0}
    loop at < (I64{8}) {
        trap_store(snapshot + at * I64{8}, coll_test_live(width))
        width *= I64{2}
        at += I64{1}
    }
    a :: coll_test_short_text(I64{97}, I64{1})
    b :: coll_test_short_text(I64{98}, I64{1})
    c :: coll_test_short_text(I64{99}, I64{1})
    keys :: jet_rt_alloc(I64{24}, I64{8})
    out :: jet_rt_alloc(I64{8}, I64{8})
    trap_store(keys, a)
    trap_store(keys + I64{8}, b)
    trap_store(keys + I64{16}, a)
    empty :: jet_coll_counter()
    from :: jet_coll_counter_from(keys, I64{3})
    clone :: jet_rt_handle_clone_jet_counter(from)
    coll_test_require(jet_coll_counter_get(empty, a) == I64{0} && jet_coll_counter_get(from, a) == I64{2} && jet_coll_counter_total(from) == I64{3})
    unchanged :: jet_coll_counter_add(from, c, I64{0})
    coll_test_require(trap_word(unchanged) == I64{2} && jet_coll_counter_get(unchanged, c) == I64{0})
    inc :: jet_coll_counter_inc(from, b)
    dec :: jet_coll_counter_dec(from, b)
    coll_test_require(jet_coll_counter_get(inc, b) == I64{2} && trap_word(dec) == I64{1} && jet_coll_counter_get(dec, b) == I64{0})
    negative :: jet_coll_counter_set_count(from, a, I64{-1})
    coll_test_require(jet_coll_counter_get(negative, a) == I64{-1} && jet_coll_counter_total(negative) == I64{0})
    expected :: jet_rt_alloc(I64{40}, I64{8})
    // Independent literal: Counter{keys: [a, b], counts: [-1, 1]}.
    trap_store(expected, I64{8895283764753952579})
    trap_store(expected + I64{8}, I64{7015236279977207147})
    trap_store(expected + I64{16}, I64{8026294335821717548})
    trap_store(expected + I64{24}, I64{3268241390004629109})
    trap_store(expected + I64{32}, I64{137839209622577})
    mode := I64{0}
    loop mode < (I64{3}) {
        text :: if (mode == I64{0}) -> jet_rt_handle_display_jet_counter(negative) else if (mode == I64{1}) -> jet_rt_handle_show_jet_counter(negative) else -> jet_rt_handle_debug_jet_counter(negative)
        coll_test_require(rt_text_len(text) == I64{38})
        at = I64{0}
        loop at < (I64{38}) {
            coll_test_require(trap_byte(rt_text_data(text) + at) == trap_byte(expected + at))
            at += I64{1}
        }
        jet_rt_string_drop(text)
        mode += I64{1}
    }
    jet_rt_free(expected, I64{40}, I64{8})
    coll_test_require(jet_coll_counter_names(from, out) == I64{2})
    names :: trap_word(out)
    coll_test_require(jet_rt_string_eq(trap_word(names), a) && jet_rt_string_eq(trap_word(names + I64{8}), b))
    coll_test_text_slots_drop(names, I64{2})
    coll_test_require(jet_coll_counter_elements(negative, out) == I64{1})
    elements :: trap_word(out)
    coll_test_require(jet_rt_string_eq(trap_word(elements), b))
    coll_test_text_slots_drop(elements, I64{1})
    common :: jet_coll_counter_most_common(inc, I64{-1})
    zero :: jet_coll_counter_most_common(inc, I64{0})
    top :: jet_coll_counter_most_common(from, I64{1})
    coll_test_require(trap_word(common) == I64{2} && trap_word(zero) == I64{0} && trap_word(top) == I64{1})
    coll_test_require(jet_rt_string_eq(trap_word(trap_word(common + I64{16})), a))
    merged :: jet_coll_counter_merge_add(from, negative)
    subtracted :: jet_coll_counter_subtract(from, from)
    cleared :: jet_coll_counter_clear(from)
    coll_test_require(jet_coll_counter_get(merged, a) == I64{1} && jet_coll_counter_get(merged, b) == I64{2})
    coll_test_require(trap_word(subtracted) == I64{0} && trap_word(cleared) == I64{0} && trap_word(from) == I64{2})
    minimum :: jet_coll_counter_add(empty, a, I64{-9223372036854775808})
    wide :: jet_coll_counter_get(minimum, a)
    coll_test_require(jet_int_owned_to_i64(wide) == I64{-9223372036854775808})
    jet_rt_int_drop(wide)
    min_text :: jet_rt_handle_show_jet_counter(minimum)
    coll_test_require(rt_text_len(min_text) == I64{50})
    // Decimal formatting must not negate I64::MIN in signed arithmetic.
    coll_test_require(trap_byte(rt_text_data(min_text) + I64{28}) == I64{45} && trap_byte(rt_text_data(min_text) + I64{48}) == I64{93})
    jet_rt_string_drop(min_text)
    jet_rt_handle_drop_jet_counter(minimum)
    jet_rt_handle_drop_jet_counter(empty)
    jet_rt_handle_drop_jet_counter(from)
    jet_rt_handle_drop_jet_counter(unchanged)
    jet_rt_handle_drop_jet_counter(inc)
    jet_rt_handle_drop_jet_counter(dec)
    jet_rt_handle_drop_jet_counter(negative)
    jet_rt_handle_drop_jet_counter(common)
    jet_rt_handle_drop_jet_counter(zero)
    jet_rt_handle_drop_jet_counter(top)
    jet_rt_handle_drop_jet_counter(merged)
    jet_rt_handle_drop_jet_counter(subtracted)
    jet_rt_handle_drop_jet_counter(cleared)
    jet_rt_string_drop(a)
    jet_rt_string_drop(b)
    jet_rt_string_drop(c)
    coll_test_require(jet_coll_counter_total(clone) == I64{3})
    jet_rt_handle_drop_jet_counter(clone)
    jet_rt_handle_drop_jet_counter(I64{0})
    jet_rt_free(keys, I64{24}, I64{8})
    jet_rt_free(out, I64{8}, I64{8})
    width = I64{32}
    at = I64{0}
    loop at < (I64{8}) {
        coll_test_require(coll_test_live(width) == trap_word(snapshot + at * I64{8}))
        width *= I64{2}
        at += I64{1}
    }
    jet_rt_free(snapshot, I64{64}, I64{8})
}

fn coll_test_chain() {
    snapshot :: jet_rt_alloc(I64{64}, I64{8})
    width := I64{32}
    at := I64{0}
    loop at < (I64{8}) {
        trap_store(snapshot + at * I64{8}, coll_test_live(width))
        width *= I64{2}
        at += I64{1}
    }
    a :: coll_test_short_text(I64{97}, I64{1})
    b :: coll_test_short_text(I64{98}, I64{1})
    x :: coll_test_short_text(I64{120}, I64{1})
    y :: coll_test_short_text(I64{121}, I64{1})
    nul :: coll_test_short_text(I64{6422625}, I64{3})
    keys :: jet_rt_alloc(I64{24}, I64{8})
    values :: jet_rt_alloc(I64{16}, I64{8})
    out :: jet_rt_alloc(I64{8}, I64{8})
    trap_store(keys, a)
    trap_store(keys + I64{8}, a)
    trap_store(keys + I64{16}, b)
    trap_store(values, x)
    trap_store(values + I64{8}, y)
    empty :: jet_coll_chain()
    trap_store(out, I64{-1})
    coll_test_require(!jet_coll_chain_contains(empty, a) && jet_coll_chain_get(empty, a, out) == I64{0} && trap_word(out) == I64{-1})
    empty_clone :: jet_rt_handle_clone_jet_chain(empty)
    empty_render :: jet_rt_handle_display_jet_chain(empty_clone)
    expected :: jet_rt_alloc(I64{56}, I64{8})
    trap_store(expected, I64{7020121633308371011})
    trap_store(expected + I64{8}, I64{6727005903825036665})
    trap_store(expected + I64{16}, I64{125})
    coll_test_require(rt_text_len(empty_render) == I64{17})
    at = I64{0}
    loop at < (I64{17}) {
        coll_test_require(trap_byte(rt_text_data(empty_render) + at) == trap_byte(expected + at))
        at += I64{1}
    }
    jet_rt_string_drop(empty_render)
    one :: jet_coll_chain_push(empty, keys, I64{2}, values, I64{2})
    coll_test_require(jet_coll_chain_get(one, a, out) == I64{1})
    first :: trap_word(out)
    coll_test_require(jet_rt_string_eq(first, x))
    jet_rt_string_drop(first)
    coll_test_require(!jet_coll_chain_contains(one, b))
    layer :: trap_word(one + I64{16})
    layer_clone :: jet_rt_handle_clone_jet_layer(layer)
    chain_clone :: jet_rt_handle_clone_jet_chain(one)
    coll_test_require(layer_clone != layer && trap_word(layer_clone + I64{16}) != trap_word(layer + I64{16}))
    trap_store(expected, I64{7308070551597703500})
    trap_store(expected + I64{8}, I64{2318334952199582585})
    trap_store(expected + I64{16}, I64{8461244959896132961})
    trap_store(expected + I64{24}, I64{2318360240967021413})
    trap_store(expected + I64{32}, I64{8215929})
    mode := I64{0}
    loop mode < (I64{3}) {
        text :: if (mode == I64{0}) -> jet_rt_handle_display_jet_layer(layer_clone) else if (mode == I64{1}) -> jet_rt_handle_show_jet_layer(layer_clone) else -> jet_rt_handle_debug_jet_layer(layer_clone)
        coll_test_require(rt_text_len(text) == I64{35})
        at = I64{0}
        loop at < (I64{35}) {
            coll_test_require(trap_byte(rt_text_data(text) + at) == trap_byte(expected + at))
            at += I64{1}
        }
        jet_rt_string_drop(text)
        mode += I64{1}
    }
    trap_store(expected, I64{7020121633308371011})
    trap_store(expected + I64{8}, I64{5502026805180261753})
    trap_store(expected + I64{16}, I64{8747516029181458785})
    trap_store(expected + I64{24}, I64{6998642617586039411})
    trap_store(expected + I64{32}, I64{7310868735955315805})
    trap_store(expected + I64{40}, I64{8728024973280557683})
    trap_store(expected + I64{48}, I64{2103278941})
    mode = I64{0}
    loop mode < (I64{3}) {
        text :: if (mode == I64{0}) -> jet_rt_handle_display_jet_chain(chain_clone) else if (mode == I64{1}) -> jet_rt_handle_show_jet_chain(chain_clone) else -> jet_rt_handle_debug_jet_chain(chain_clone)
        coll_test_require(rt_text_len(text) == I64{52})
        at = I64{0}
        loop at < (I64{52}) {
            coll_test_require(trap_byte(rt_text_data(text) + at) == trap_byte(expected + at))
            at += I64{1}
        }
        jet_rt_string_drop(text)
        mode += I64{1}
    }
    mismatch :: jet_coll_chain_push(one, keys, I64{3}, values, I64{2})
    mismatch_layer :: trap_word(mismatch + I64{16})
    coll_test_require(trap_word(mismatch_layer) == I64{3} && trap_word(mismatch_layer + I64{24}) == I64{2})
    coll_test_require(jet_coll_chain_contains(mismatch, a))
    extra :: jet_coll_chain_push(one, keys, I64{1}, values, I64{2})
    coll_test_require(trap_word(trap_word(extra + I64{16}) + I64{24}) == I64{2})
    trap_store(values, y)
    override :: jet_coll_chain_push(one, keys, I64{1}, values, I64{1})
    coll_test_require(jet_coll_chain_get(override, a, out) == I64{1})
    preferred :: trap_word(out)
    coll_test_require(jet_rt_string_eq(preferred, y))
    jet_rt_string_drop(preferred)
    skipped :: jet_coll_chain_push(override, I64{0}, I64{0}, I64{0}, I64{0})
    coll_test_require(jet_coll_chain_get(skipped, a, out) == I64{1})
    survivor :: trap_word(out)
    trap_store(keys, nul)
    trap_store(values, nul)
    binary :: jet_coll_chain_push(one, keys, I64{1}, values, I64{1})
    coll_test_require(jet_coll_chain_get(binary, nul, out) == I64{1})
    binary_survivor :: trap_word(out)
    jet_rt_handle_drop_jet_chain(binary)
    jet_rt_handle_drop_jet_chain(skipped)
    jet_rt_handle_drop_jet_chain(override)
    jet_rt_handle_drop_jet_chain(extra)
    jet_rt_handle_drop_jet_chain(mismatch)
    jet_rt_handle_drop_jet_chain(one)
    jet_rt_handle_drop_jet_chain(empty)
    jet_rt_handle_drop_jet_chain(empty_clone)
    jet_rt_string_drop(a)
    jet_rt_string_drop(b)
    jet_rt_string_drop(x)
    jet_rt_string_drop(y)
    jet_rt_string_drop(nul)
    coll_test_require(rt_text_len(survivor) == I64{1} && trap_byte(rt_text_data(survivor)) == I64{121})
    coll_test_require(rt_text_len(binary_survivor) == I64{3} && trap_byte(rt_text_data(binary_survivor) + I64{1}) == I64{0})
    coll_test_require(trap_word(layer_clone) == I64{2} && trap_word(chain_clone) == I64{1})
    jet_rt_string_drop(survivor)
    jet_rt_string_drop(binary_survivor)
    jet_rt_handle_drop_jet_layer(layer_clone)
    jet_rt_handle_drop_jet_chain(chain_clone)
    jet_rt_handle_drop_jet_layer(I64{0})
    jet_rt_handle_drop_jet_chain(I64{0})
    jet_rt_free(expected, I64{56}, I64{8})
    jet_rt_free(keys, I64{24}, I64{8})
    jet_rt_free(values, I64{16}, I64{8})
    jet_rt_free(out, I64{8}, I64{8})
    width = I64{32}
    at = I64{0}
    loop at < (I64{8}) {
        coll_test_require(coll_test_live(width) == trap_word(snapshot + at * I64{8}))
        width *= I64{2}
        at += I64{1}
    }
    jet_rt_free(snapshot, I64{64}, I64{8})
}

fn coll_test_chain_bounds_stop(contains: Bool) {
    jet_rt_alloc_init()
    key :: coll_test_short_text(I64{97}, I64{1})
    input :: jet_rt_alloc(I64{8}, I64{8})
    out :: jet_rt_alloc(I64{8}, I64{8})
    trap_store(input, key)
    chain :: jet_coll_chain_push(jet_coll_chain(), input, I64{1}, I64{0}, I64{0})
    if contains -> _ := jet_coll_chain_contains(chain, key) else {
        _ := jet_coll_chain_get(chain, key, out)
    }
    // Returning from the required checked bounds panic is a witness failure.
    coll_test_require(false)
}

fn coll_test_range_walk(start: I64, end: I64, step: I64, has_step: U8, exclusive: U8, expected: I64, length: I64) {
    first :: jet_int_owned_from_i64(start)
    last :: jet_int_owned_from_i64(end)
    stride :: jet_int_owned_from_i64(step)
    cursor :: jet_loop_range_init(first, last, stride, has_step, exclusive)
    jet_rt_int_drop(first)
    jet_rt_int_drop(last)
    jet_rt_int_drop(stride)
    at := I64{0}
    loop at < length {
        coll_test_require(jet_loop_range_has_next(cursor))
        value :: jet_loop_range_value(cursor)
        coll_test_require(jet_int_owned_to_i64(value) == trap_word(expected + at * I64{8}))
        jet_rt_int_drop(value)
        jet_loop_range_advance(cursor)
        at += I64{1}
    }
    coll_test_require(!jet_loop_range_has_next(cursor))
    jet_loop_range_advance(cursor)
    coll_test_require(!jet_loop_range_has_next(cursor))
    jet_loop_cursor_drop(cursor)
}

fn coll_test_range() {
    snapshot :: jet_rt_alloc(I64{64}, I64{8})
    width := I64{32}
    at := I64{0}
    loop at < (I64{8}) {
        trap_store(snapshot + at * I64{8}, coll_test_live(width))
        width *= I64{2}
        at += I64{1}
    }
    expected :: jet_rt_alloc(I64{32}, I64{8})
    trap_store(expected, I64{1})
    trap_store(expected + I64{8}, I64{2})
    trap_store(expected + I64{16}, I64{3})
    trap_store(expected + I64{24}, I64{4})
    coll_test_range_walk(I64{1}, I64{5}, I64{0}, U8{0}, U8{255}, expected, I64{4})
    trap_store(expected + I64{8}, I64{3})
    trap_store(expected + I64{16}, I64{5})
    coll_test_range_walk(I64{1}, I64{5}, I64{2}, U8{7}, U8{0}, expected, I64{3})
    trap_store(expected, I64{5})
    trap_store(expected + I64{8}, I64{3})
    trap_store(expected + I64{16}, I64{1})
    coll_test_range_walk(I64{5}, I64{0}, I64{-2}, U8{1}, U8{1}, expected, I64{3})
    coll_test_range_walk(I64{5}, I64{1}, I64{-2}, U8{1}, U8{0}, expected, I64{3})
    coll_test_range_walk(I64{5}, I64{1}, I64{-2}, U8{1}, U8{1}, expected, I64{2})
    coll_test_range_walk(I64{3}, I64{1}, I64{1}, U8{1}, U8{0}, I64{0}, I64{0})
    coll_test_range_walk(I64{1}, I64{3}, I64{-1}, U8{1}, U8{0}, I64{0}, I64{0})
    coll_test_range_walk(I64{1}, I64{1}, I64{1}, U8{1}, U8{1}, I64{0}, I64{0})
    trap_store(expected, I64{1})
    coll_test_range_walk(I64{1}, I64{1}, I64{1}, U8{1}, U8{0}, expected, I64{1})
    // Inclusive extrema must be returned; the following overflow ends, not panics.
    trap_store(expected, I64{9223372036854775807})
    coll_test_range_walk(I64{9223372036854775807}, I64{9223372036854775807}, I64{1}, U8{1}, U8{0}, expected, I64{1})
    trap_store(expected, I64{-9223372036854775808})
    coll_test_range_walk(I64{-9223372036854775808}, I64{-9223372036854775808}, I64{-1}, U8{1}, U8{0}, expected, I64{1})
    // Ignored step owners may exceed I64: has_step=false must not narrow them.
    enormous :: jet_int_pow(I64{2}, I64{80})
    cursor :: jet_loop_range_init(I64{1}, I64{2}, enormous, U8{0}, U8{1})
    jet_rt_int_drop(enormous)
    coll_test_require(jet_loop_range_has_next(cursor))
    value :: jet_loop_range_value(cursor)
    coll_test_require(value == I64{1})
    jet_rt_int_drop(value)
    jet_loop_range_advance(cursor)
    coll_test_require(!jet_loop_range_has_next(cursor))
    jet_loop_cursor_drop(cursor)
    jet_loop_cursor_drop(I64{0})
    coll_test_require(jet_range_contains(I64{-3}, I64{3}, U8{0}, I64{-3}))
    coll_test_require(jet_range_contains(I64{-3}, I64{3}, U8{0}, I64{3}))
    coll_test_require(!jet_range_contains(I64{-3}, I64{3}, U8{255}, I64{3}))
    coll_test_require(!jet_range_contains(I64{-3}, I64{3}, U8{0}, I64{-4}))
    coll_test_require(!jet_range_contains(I64{3}, I64{-3}, U8{0}, I64{0}))
    coll_test_require(jet_range_contains(I64{9223372036854775807}, I64{9223372036854775807}, U8{0}, I64{9223372036854775807}))
    coll_test_require(!jet_range_contains(I64{9223372036854775807}, I64{9223372036854775807}, U8{1}, I64{9223372036854775807}))
    jet_rt_free(expected, I64{32}, I64{8})
    width = I64{32}
    at = I64{0}
    loop at < (I64{8}) {
        coll_test_require(coll_test_live(width) == trap_word(snapshot + at * I64{8}))
        width *= I64{2}
        at += I64{1}
    }
    jet_rt_free(snapshot, I64{64}, I64{8})
}

fn coll_test_range_argument_stop(exhausted: Bool) {
    jet_rt_alloc_init()
    if exhausted {
        cursor :: jet_loop_range_init(I64{1}, I64{1}, I64{1}, U8{1}, U8{1})
        _ := jet_loop_range_value(cursor)
    } else { _ := jet_loop_range_init(I64{1}, I64{2}, I64{0}, U8{1}, U8{0}) }
    coll_test_require(false)
}

fn collections_tests() {
    jet_rt_alloc_init()
    coll_test_bytes()
    coll_test_bits()
    coll_test_para_fold()
    coll_test_i64_lists()
    coll_test_ordered_map()
    coll_test_counter()
    coll_test_chain()
    coll_test_range()
    // Fresh ceil(5/2) differs from the remaining floor(4/2) after one pull.
    stepped :: jet_rt_native_iter_step_by(coll_test_source(), I64{2})
    coll_test_require(iter_exact_length(stepped) == I64{3})
    stepped_first :: jet_rt_native_iter_next(stepped)
    coll_test_require(trap_word(stepped_first) == I64{1})
    jet_rt_free(stepped_first, I64{8}, I64{8})
    coll_test_require(iter_exact_length(stepped) == I64{2})
    stepped_second :: jet_rt_native_iter_next(stepped)
    coll_test_require(trap_word(stepped_second) == I64{3})
    jet_rt_free(stepped_second, I64{8}, I64{8})
    coll_test_require(iter_exact_length(stepped) == I64{1})
    jet_rt_native_iter_drop(stepped)
    // Equality cannot distinguish +0.0 from -0.0; inspect the IEEE sign bit.
    float_meta :: coll_test_meta()
    float_header :: coll_list_new()
    float_slot :: coll_slot_new(float_meta)
    trap_store(float_slot, I64{-9223372036854775808})
    coll_list_push(float_header, float_slot, float_meta)
    coll_list_push(float_header, float_slot, float_meta)
    float_source :: jet_rt_native_iter_from_list(float_header, float_meta, I64{1})
    coll_test_require(rt_f64_bits(jet_rt_native_iter_average_float(float_source)) == I64{-9223372036854775808})
    jet_rt_free(float_header, I64{24}, I64{8})
    jet_rt_free(float_slot, I64{8}, I64{8})
    coll_meta_drop(float_meta)
    coll_test_bytes()
    source :: coll_test_source()
    first :: jet_rt_native_iter_next(source)
    coll_test_require(trap_word(first) == I64{1})
    jet_rt_free(first, I64{8}, I64{8})
    tail :: jet_rt_native_iter_step_by(source, I64{2})
    output :: coll_list_new()
    jet_rt_native_iter_to_list(tail, output)
    coll_test_require(trap_word(output) == I64{2})
    data :: trap_word(output + I64{16})
    coll_test_require(trap_word(data) == I64{2} && trap_word(data + I64{8}) == I64{4})
    meta :: coll_test_meta()
    coll_list_drop(output, meta, I64{0})
    jet_rt_free(output, I64{24}, I64{8})
    cursor :: jet_rt_native_iter_cursor_init(coll_test_source(), I64{2}, I64{1})
    slot :: coll_slot_new(meta)
    coll_test_require(jet_rt_native_iter_cursor_test(cursor) == I64{1})
    jet_rt_native_iter_cursor_value(cursor, slot, I64{0})
    coll_test_require(trap_word(slot) == I64{1})
    jet_rt_native_iter_cursor_advance(cursor)
    jet_rt_native_iter_cursor_value(cursor, slot, I64{1})
    coll_test_require(trap_word(slot) == I64{3})
    jet_rt_native_iter_cursor_advance(cursor)
    jet_rt_native_iter_cursor_value(cursor, slot, I64{1})
    coll_test_require(trap_word(slot) == I64{5})
    jet_rt_native_iter_cursor_advance(cursor)
    coll_test_require(jet_rt_native_iter_cursor_test(cursor) == I64{0})
    jet_rt_native_iter_cursor_advance(cursor)
    jet_rt_native_iter_cursor_drop(cursor)
    coll_test_require(jet_rt_native_iter_len(coll_test_source()) == I64{5})
    coll_test_require(jet_rt_native_iter_len(jet_rt_native_iter_take(coll_test_source(), I64{0})) == I64{0})
    coll_test_require(jet_rt_native_iter_len(jet_rt_native_iter_skip(coll_test_source(), I64{99})) == I64{0})
    coll_test_require(jet_rt_native_iter_len(jet_rt_native_iter_drop_last(coll_test_source(), I64{99})) == I64{0})
    coll_test_require(jet_rt_native_iter_average_int(coll_test_source()) == 3.0)
    // Rounding boundaries exercise carry into exponent and ties-to-even.
    coll_test_require(iter_wide_float(I64{0}, U64{9007199254740993}) == 9007199254740992.0)
    coll_test_require(iter_wide_float(I64{0}, U64{9007199254740995}) == 9007199254740996.0)
    coll_test_require(iter_wide_float(I64{1}, U64{0}) == 18446744073709551616.0)
    coll_test_require(iter_wide_float(I64{-1}, U64{0}) == -18446744073709551616.0)
    // Bool/Unit copies never read uninitialized padding bytes.
    trap_store(meta + I64{48}, I64{9})
    trap_store(slot, I64{0})
    tiny :: jet_rt_alloc(I64{1}, I64{1})
    trap_put(tiny, I64{1})
    coll_copy(tiny, slot, coll_payload(meta))
    coll_test_require(trap_word(slot) == I64{1})
    trap_store(meta + I64{48}, I64{11})
    coll_test_require(coll_payload(meta) == I64{0})
    coll_copy(I64{0}, slot, coll_payload(meta))
    jet_rt_free(tiny, I64{1}, I64{1})
    jet_rt_free(slot, I64{8}, I64{8})
    coll_meta_drop(meta)
}
