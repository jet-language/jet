// Raw ABI ownership witnesses alongside the high-level collection goldens.
fn coll_test_require(ok: Bool) {
    if ok {
        return
    }
    trap_exit(I64{1})
    loop {

    }
}

fn coll_test_meta() -> I64 {
    meta :: jet_rt_alloc(I64{72}, I64{8})
    coll_zero(meta, I64{72})
    trap_store(meta, I64{8})
    trap_store(meta + I64{48}, I64{274877906946})
    meta
}

fn coll_test_source() -> I64 {
    meta :: coll_test_meta()
    header :: coll_list_new()
    slot :: jet_rt_alloc(I64{8}, I64{8})
    at := I64{1}
    loop at <= (I64{5}) {
        trap_store(slot, at)
        coll_list_push(header, slot, meta)
        at += I64{1}
    }
    source :: jet_rt_native_iter_from_list(header, meta, I64{1})
    coll_test_require(trap_word(header) == I64{0} && trap_word(header + I64{8}) == I64{0} && trap_word(header + I64{16}) == I64{0})
    jet_rt_free(header, I64{24}, I64{8})
    jet_rt_free(slot, I64{8}, I64{8})
    // The node must own the descriptor, not borrow this expired one.
    coll_meta_drop(meta)
    source
}

// Single-threaded bounded fixtures never fill a slab or allocate directly.
// Count each available slab's live payloads, excluding bounded empty caches.
fn coll_test_live(width: I64) -> I64 {
    total := I64{0}
    slab := trap_word(alloc_head(alloc_root, width))
    loop slab != (I64{0}) {
        total += trap_word(slab + I64{24})
        slab = trap_word(slab)
    }
    total
}

fn coll_test_bytes() {
    snapshot :: jet_rt_alloc(I64{64}, I64{8})
    width := I64{32}
    at := I64{0}
    loop at < (I64{8}) {
        trap_store(snapshot + at * I64{8}, coll_test_live(width))
        width *= I64{2}
        at += I64{1}
    }
    meta :: coll_test_meta()
    trap_store(meta, I64{1})
    trap_store(meta + I64{48}, I64{34359738371})
    slot :: coll_slot_new(meta)
    case := I64{0}
    loop case < (I64{3}) {
        length :: if (case == I64{0}) -> I64{0} else if (case == I64{1}) -> I64{1} else -> I64{255}
        input :: coll_list_new()
        at = I64{0}
        loop at < length {
            trap_put(slot, if (length == I64{1}) -> I64{255} else -> at)
            coll_list_push(input, slot, meta)
            at += I64{1}
        }
        packed :: jet_rt_bytes_pack(input)
        coll_test_require(packed != I64{0})
        output :: jet_rt_bytes_unpack(packed, length)
        coll_test_require(trap_word(input) == length && trap_word(output) == length)
        if (length == I64{0}) {
            coll_test_require(packed == I64{1} && trap_word(output + I64{8}) == I64{0} && trap_word(output + I64{16}) == I64{0})
        } else {
            original :: trap_word(input + I64{16})
            restored :: trap_word(output + I64{16})
            coll_test_require(packed != original && restored != original && restored != packed)
            at = I64{0}
            loop at < length {
                expected :: if (length == I64{1}) -> I64{255} else -> at
                coll_test_require(trap_byte(packed + at) == expected && trap_byte(original + at) == expected && trap_byte(restored + at) == expected)
                at += I64{1}
            }
            // Unpack copies, rather than adopting the borrowed C buffer.
            trap_put(packed, I64{99})
            coll_test_require(trap_byte(restored) == (if (length == I64{1}) -> I64{255} else -> I64{0}))
        }
        jet_rt_bytes_free(packed, length)
        coll_list_drop(input, meta, I64{0})
        coll_list_drop(output, meta, I64{0})
        jet_rt_free(input, I64{24}, I64{8})
        jet_rt_free(output, I64{24}, I64{8})
        case += I64{1}
    }
    jet_rt_free(slot, coll_size(meta), I64{8})
    coll_meta_drop(meta)
    width = I64{32}
    at = I64{0}
    loop at < (I64{8}) {
        coll_test_require(coll_test_live(width) == trap_word(snapshot + at * I64{8}))
        width *= I64{2}
        at += I64{1}
    }
    jet_rt_free(snapshot, I64{64}, I64{8})
}

// Seed oracle: Core/Collections.rs:175-187 delegates all three render modes
// to the sorted list; Values.rs:369-372 spells "[", ", ", "]".
fn coll_test_bits_render(bits: I64, low: I64, high: I64, length: I64) {
    display :: jet_rt_handle_display_JetBitSet(bits)
    show :: jet_rt_handle_show_JetBitSet(bits)
    debug :: jet_rt_handle_debug_JetBitSet(bits)
    coll_test_require(rt_text_len(display) == length && rt_text_len(show) == length && rt_text_len(debug) == length)
    at := I64{0}
    loop at < length {
        word :: if at < I64{8} -> low else -> high
        shift :: (at % I64{8}) * I64{8}
        expected :: (word >> shift) & I64{255}
        coll_test_require(trap_byte(rt_text_data(display) + at) == expected)
        coll_test_require(trap_byte(rt_text_data(show) + at) == expected)
        coll_test_require(trap_byte(rt_text_data(debug) + at) == expected)
        at += I64{1}
    }
    jet_rt_string_drop(display)
    jet_rt_string_drop(show)
    jet_rt_string_drop(debug)
}

fn coll_test_bits() {
    snapshot :: jet_rt_alloc(I64{64}, I64{8})
    width := I64{32}
    at := I64{0}
    loop at < (I64{8}) {
        trap_store(snapshot + at * I64{8}, coll_test_live(width))
        width *= I64{2}
        at += I64{1}
    }
    bits :: jet_rt_native_bits_new()
    out :: jet_rt_alloc(I64{8}, I64{8})
    trap_store(out, I64{-1})
    coll_test_require(jet_bit_set_is_empty(bits) && jet_bit_set_count(bits) == I64{0} && jet_bit_set_len(bits) == I64{0})
    coll_test_require(jet_bit_set_to_list(bits, out) == I64{0} && trap_word(out) == I64{0})
    coll_test_bits_render(bits, I64{23899}, I64{0}, I64{2}) // []
    coll_test_require(!jet_bitset_add(bits, I64{-1}) && !jet_bit_set_has(bits, I64{-1}))
    coll_test_require(jet_bitset_add(bits, I64{100}) && jet_bitset_add(bits, I64{0}) && jet_bitset_add(bits, I64{4}))
    coll_test_require(!jet_bitset_add(bits, I64{4}) && jet_bit_set_count(bits) == I64{3} && jet_bit_set_len(bits) == I64{101})
    coll_test_require(jet_bit_set_has(bits, I64{0}) && jet_bit_set_has(bits, I64{4}) && jet_bit_set_has(bits, I64{100}) && !jet_bit_set_has(bits, I64{3}))
    coll_test_bits_render(bits, I64{3539877909502898267}, I64{6107184}, I64{11}) // [0, 4, 100]
    copy :: jet_bits_copy(bits)
    empty_copy :: jet_bits_copy(bits)
    jet_rt_native_bits_clear(empty_copy)
    empty_clone :: jet_rt_handle_clone_JetBitSet(empty_copy)
    coll_test_require(jet_bit_set_is_empty(empty_clone) && trap_word(empty_clone + I64{8}) == I64{0})
    jet_rt_handle_drop_JetBitSet(empty_copy)
    jet_rt_handle_drop_JetBitSet(empty_clone)
    cloned :: jet_rt_handle_clone_JetBitSet(bits)
    index := I64{0}
    loop index < I64{20} {
        coll_test_require(jet_bitset_add(cloned, I64{1000} + index))
        index += I64{1}
    }
    coll_test_require(jet_bit_set_count(cloned) == I64{23} && jet_bit_set_len(cloned) == I64{1020})
    loop index > I64{0} {
        index -= I64{1}
        jet_bitset_remove(cloned, I64{1000} + index)
    }
    coll_test_require(jet_bit_set_count(cloned) == I64{3})
    coll_test_require(copy != bits && cloned != bits && cloned != copy)
    coll_test_require(trap_word(copy + I64{16}) != trap_word(bits + I64{16}))
    jet_bitset_remove(bits, I64{100})
    jet_bitset_remove(bits, I64{3})
    jet_bitset_remove(bits, I64{-1})
    coll_test_require(jet_bit_set_len(bits) == I64{5} && jet_bit_set_count(bits) == I64{2} && jet_bit_set_has(copy, I64{100}) && jet_bit_set_has(cloned, I64{100}))
    jet_bitset_remove(bits, I64{0})
    jet_bitset_remove(bits, I64{4})
    coll_test_require(jet_bit_set_is_empty(bits) && jet_bit_set_len(bits) == I64{0})
    // I64 indices outside the inline exact-Int rail survive both ABI seams.
    wide :: jet_int_owned_from_i64(I64{4611686018427387904})
    coll_test_require(jet_bitset_add(bits, wide) && jet_bit_set_has(bits, wide))
    extent :: jet_bit_set_len(bits)
    coll_test_require(jet_int_owned_to_i64(extent) == I64{4611686018427387905})
    jet_rt_int_drop(extent)
    coll_test_require(jet_bit_set_to_list(bits, out) == I64{1})
    data :: trap_word(out)
    listed :: trap_word(data)
    coll_test_require(jet_int_owned_to_i64(listed) == I64{4611686018427387904})
    jet_rt_handle_drop_JetBitSet(bits)
    coll_test_require(jet_int_owned_to_i64(listed) == I64{4611686018427387904})
    jet_rt_int_drop(listed)
    jet_rt_int_drop(wide)
    jet_rt_free(data, I64{8}, I64{8})
    // A fresh sorted list owns its storage independently of the copied set.
    coll_test_require(jet_bit_set_to_list(copy, out) == I64{3})
    sorted :: trap_word(out)
    jet_rt_native_bits_clear(copy)
    coll_test_require(jet_bit_set_is_empty(copy) && trap_word(copy + I64{8}) == I64{0} && trap_word(copy + I64{16}) == I64{0})
    coll_test_require(trap_word(sorted) == I64{0} && trap_word(sorted + I64{8}) == I64{4} && trap_word(sorted + I64{16}) == I64{100})
    jet_rt_free(sorted, I64{24}, I64{8})
    jet_rt_handle_drop_JetBitSet(copy)
    jet_rt_handle_drop_JetBitSet(cloned)
    jet_rt_handle_drop_JetBitSet(I64{0})
    jet_rt_free(out, I64{8}, I64{8})
    width = I64{32}
    at = I64{0}
    loop at < (I64{8}) {
        coll_test_require(coll_test_live(width) == trap_word(snapshot + at * I64{8}))
        width *= I64{2}
        at += I64{1}
    }
    jet_rt_free(snapshot, I64{64}, I64{8})
}

fn collections_tests() {
    jet_rt_alloc_init()
    coll_test_bytes()
    coll_test_bits()
    // Fresh ceil(5/2) differs from the remaining floor(4/2) after one pull.
    stepped :: jet_rt_native_iter_step_by(coll_test_source(), I64{2})
    coll_test_require(iter_exact_length(stepped) == I64{3})
    stepped_first :: jet_rt_native_iter_next(stepped)
    coll_test_require(trap_word(stepped_first) == I64{1})
    jet_rt_free(stepped_first, I64{8}, I64{8})
    coll_test_require(iter_exact_length(stepped) == I64{2})
    stepped_second :: jet_rt_native_iter_next(stepped)
    coll_test_require(trap_word(stepped_second) == I64{3})
    jet_rt_free(stepped_second, I64{8}, I64{8})
    coll_test_require(iter_exact_length(stepped) == I64{1})
    jet_rt_native_iter_drop(stepped)
    // Equality cannot distinguish +0.0 from -0.0; inspect the IEEE sign bit.
    float_meta :: coll_test_meta()
    float_header :: coll_list_new()
    float_slot :: coll_slot_new(float_meta)
    trap_store(float_slot, I64{-9223372036854775808})
    coll_list_push(float_header, float_slot, float_meta)
    coll_list_push(float_header, float_slot, float_meta)
    float_source :: jet_rt_native_iter_from_list(float_header, float_meta, I64{1})
    coll_test_require(rt_f64_bits(jet_rt_native_iter_average_float(float_source)) == I64{-9223372036854775808})
    jet_rt_free(float_header, I64{24}, I64{8})
    jet_rt_free(float_slot, I64{8}, I64{8})
    coll_meta_drop(float_meta)
    coll_test_bytes()
    source :: coll_test_source()
    first :: jet_rt_native_iter_next(source)
    coll_test_require(trap_word(first) == I64{1})
    jet_rt_free(first, I64{8}, I64{8})
    tail :: jet_rt_native_iter_step_by(source, I64{2})
    output :: coll_list_new()
    jet_rt_native_iter_to_list(tail, output)
    coll_test_require(trap_word(output) == I64{2})
    data :: trap_word(output + I64{16})
    coll_test_require(trap_word(data) == I64{2} && trap_word(data + I64{8}) == I64{4})
    meta :: coll_test_meta()
    coll_list_drop(output, meta, I64{0})
    jet_rt_free(output, I64{24}, I64{8})
    cursor :: jet_rt_native_iter_cursor_init(coll_test_source(), I64{2}, I64{1})
    slot :: coll_slot_new(meta)
    coll_test_require(jet_rt_native_iter_cursor_test(cursor) == I64{1})
    jet_rt_native_iter_cursor_value(cursor, slot, I64{0})
    coll_test_require(trap_word(slot) == I64{1})
    jet_rt_native_iter_cursor_advance(cursor)
    jet_rt_native_iter_cursor_value(cursor, slot, I64{1})
    coll_test_require(trap_word(slot) == I64{3})
    jet_rt_native_iter_cursor_advance(cursor)
    jet_rt_native_iter_cursor_value(cursor, slot, I64{1})
    coll_test_require(trap_word(slot) == I64{5})
    jet_rt_native_iter_cursor_advance(cursor)
    coll_test_require(jet_rt_native_iter_cursor_test(cursor) == I64{0})
    jet_rt_native_iter_cursor_advance(cursor)
    jet_rt_native_iter_cursor_drop(cursor)
    coll_test_require(jet_rt_native_iter_len(coll_test_source()) == I64{5})
    coll_test_require(jet_rt_native_iter_len(jet_rt_native_iter_take(coll_test_source(), I64{0})) == I64{0})
    coll_test_require(jet_rt_native_iter_len(jet_rt_native_iter_skip(coll_test_source(), I64{99})) == I64{0})
    coll_test_require(jet_rt_native_iter_len(jet_rt_native_iter_drop_last(coll_test_source(), I64{99})) == I64{0})
    coll_test_require(jet_rt_native_iter_average_int(coll_test_source()) == 3.0)
    // Rounding boundaries exercise carry into exponent and ties-to-even.
    coll_test_require(iter_wide_float(I64{0}, U64{9007199254740993}) == 9007199254740992.0)
    coll_test_require(iter_wide_float(I64{0}, U64{9007199254740995}) == 9007199254740996.0)
    coll_test_require(iter_wide_float(I64{1}, U64{0}) == 18446744073709551616.0)
    coll_test_require(iter_wide_float(I64{-1}, U64{0}) == -18446744073709551616.0)
    // Bool/Unit copies never read uninitialized padding bytes.
    trap_store(meta + I64{48}, I64{9})
    trap_store(slot, I64{0})
    tiny :: jet_rt_alloc(I64{1}, I64{1})
    trap_put(tiny, I64{1})
    coll_copy(tiny, slot, coll_payload(meta))
    coll_test_require(trap_word(slot) == I64{1})
    trap_store(meta + I64{48}, I64{11})
    coll_test_require(coll_payload(meta) == I64{0})
    coll_copy(I64{0}, slot, coll_payload(meta))
    jet_rt_free(tiny, I64{1}, I64{1})
    jet_rt_free(slot, I64{8}, I64{8})
    coll_meta_drop(meta)
}
