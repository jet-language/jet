// Pure classifier witness uses the real executor helper, not a fake syscall.
#Export(c) fn fixture_process_exec_errno_class_raw(result: I64) -> I64 {
    spawn_exec_errno_class(result)
}
#Export(c) fn fixture_process_cpu_seconds_raw(milliseconds: I64) -> I64 {
    spawn_cpu_seconds(milliseconds)
}
#Export(c) fn fixture_journey_auto_color_raw(tty: Bool) -> Bool { journey_auto_color(tty) }
#Export(c) fn fixture_journey_columns_raw(tty: Bool) -> I64 { journey_stderr_columns(tty) }
