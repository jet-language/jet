// Compare the real process-edge writes with the exact owned report published
// by simple/rich/require stops. C supplies callback addresses, never providers.
#Export(c) fn jet_rt_trap_report_fixture(callback: I64, environment: I64, captured: Bool) -> I64 {
    if !captured {
        _ := coll_call1(callback, environment)
        jet_rt_unreachable(I64{0}, I64{0})
        return I64{101}
    }
    control :: scheduler_control_new()
    save :: jet_rt_alloc(I64{32}, I64{8})
    scheduler_control_enter(control, save)
    body :: scheduler_body_enter()
    _ := coll_call1(callback, environment)
    if (scheduler_control_status(control) != I64{5}) -> jet_rt_unreachable(I64{0}, I64{0})
    record :: scheduler_control_take_stop(control)
    if (trap_word(record + I64{48}) != I64{1}) -> jet_rt_unreachable(I64{0}, I64{0})
    report :: scheduler_stop_take_message(record)
    trap_flush_stdout()
    trap_write_handle(report)
    jet_rt_string_drop(report)
    scheduler_stop_drop(record)
    scheduler_body_leave(body)
    scheduler_control_leave(save)
    scheduler_control_drop(control)
    jet_rt_free(save, I64{32}, I64{8})
    I64{70}
}
