// A real Source raw read, not an OS-load imitation of Pointers.jet. The
// aggregate is trivially copied; a handle-containing pointee is intentionally
// refused by lower_ptr_deref's pre-existing lower_needs_drop check.
struct SentryInlinePair {
    first: I64
    second: I64
}
#Unsafe("the raw pointer deliberately escapes its frame for the sentry witness")
fn sentry_inline_dangling() -> *SentryInlinePair {
    value :: SentryInlinePair{first: I64{7}, second: I64{11}}
    pointer :: *value
    pointer
}
#[Export(c), Unsafe("an expired inline raw read must stop before any pointee byte is loaded")]
fn jet_rt_sentry_inline_stopped(_env: I64, _out: I64) -> I64 {
    live :: SentryInlinePair{first: I64{17}, second: I64{19}}
    live_pointer :: *live
    _ := live_pointer
    stale :: sentry_inline_dangling()
    pair :: (stale.*)
    pair.first
}
