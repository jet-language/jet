#!/usr/bin/env jet
// Native NFC witness: NativeTextNormalizeWitness.c links the supplied Jet-only
// runtime and checks every Unicode 17.0.0 NormalizationTest row through both
// NFC routes (jet_text_nfc and jet_text_normalize_nfc), with idempotence, ASCII
// ownership and hostile descending combining-class runs. The test file is the
// oracle: NFC(c1..c3) is c2 and NFC(c4, c5) is c4, the scalars the retired Rust
// seed run also produced. OUT keeps the build and run logs.
// Usage (from the repository root):
//   jet Compiler/JetRuntime/Tests/RunNativeTextNormalize.jet OUT JET_ONLY_RUNTIME_OBJECT_OR_ARCHIVE... [LINK_ARG...]
use {
    crypto: core.crypto
    files: core.files
    process: core.process
    re: core.regex
    term: core.term
}

HERE: "Compiler/JetRuntime/Tests"
KAT: "tests/data/unicode/NormalizationTest.txt"
KAT_SHA256: "5019ffd530751a741900c849c0e010332f142a3612234639bd200b82138a87db"
KAT_ROWS: 20034
POLICY: "Compiler/JetCli/Source/Cli/native-c-policy.tsv"

Policy: struct {
    flags: [String]
    removed: [String]
}

fail: fn(message: String) -> Never {
    term.eprint(message)
    process.exit(1)
}

// path.resolve against the working directory.
resolve: fn(cwd: String, path: String) -> String {
    full: if path.starts_with("/") -> path.copy() else -> "{cwd}/{path}"
    parts := [String]{}
    loop part in full.split("/").to_list() {
        if part == ".." {
            if parts.len() > 0 -> _: parts.pop()
        } else if part != "" && part != "." {
            parts.push(part)
        }
    }
    "/{parts.join("/")}"
}

// The data rows of a NormalizationTest file: a source column of one or more
// space-separated code points, then `;`.
data_rows: fn(text: String) -> Int {
    row: re.compile("^[0-9A-F]+( [0-9A-F]+)*;") ?? fail("row pattern: {err}")
    count := 0
    loop line in text.split("\n") {
        if row.is_match(line) -> count += 1
    }
    count
}

load_policy: fn(root: String) -> Policy {
    text: files.read("{root}/{POLICY}") ?? fail("cannot read {POLICY}: {err}")
    flags := [String]{}
    removed := [String]{}
    lines: text.split("\n").to_list()
    loop index in 0..<lines.len() {
        line: lines[index]
        if line == "" || line.starts_with("#") -> next
        fields: line.split("\t").to_list()
        if fields.len() != 2 || fields[1] == "" -> fail("native-c-policy.tsv:{index + 1}: expected \"kind<TAB>value\"")
        if fields[0] == "flag" {
            flags.push(fields[1])
        } else if fields[0] == "hardening-remove" {
            removed.push(fields[1])
        } else {
            fail("native-c-policy.tsv:{index + 1}: unknown policy kind {fields[0]}")
        }
    }
    Policy{flags: flags, removed: removed}
}

// `$CC` (default `cc`) with `args` and the policy flags, as
// Tools/packaging/NativeCCompiler.jet runs it.
native_cc: fn(policy: Policy, args: [String]) -> ProcessSpec {
    removed: policy.removed
    spec := process.cmd([process.env_get_or("CC", "cc")]).args_extend(args).args_extend(policy.flags)
    if process.env_get("NIX_HARDENING_ENABLE") == .Val(enabled) {
        words: re.split(Regex{"\s+"}, enabled)
        kept: loop word in words if word != "" && !removed.contains(word) -> word
        spec = spec.env("NIX_HARDENING_ENABLE", kept.join(" "))
    }
    spec
}

// One logged run: `exit=<code>` then its stdout and stderr in `log`; a
// signal or a non-zero exit stops the witness.
logged: fn(spec: ProcessSpec, label: String, log: String) -> ProcessReceipt {
    receipt: spec.run() ?? fail("{label}: {err}")
    code: if receipt.signal == .Val(number) -> "null (signal {number})" else -> "{receipt.code}"
    files.write(log, "exit={code}\n{receipt.output}{receipt.errors}") ?? fail("cannot write {log}: {err}")
    if receipt.signal != None || receipt.code != 0 -> fail("{label}: exit {code} (see {log})")
    receipt
}

run: fn() {
    root: files.cwd() ?? fail("cannot read the working directory: {err}")
    args: process.args()
    if args.len() < 2 || args[0] == "" -> fail("usage: RunNativeTextNormalize.jet OUT JET_ONLY_RUNTIME_OBJECT_OR_ARCHIVE... [LINK_ARG...]")
    out: resolve(root, args[0])
    files.create_dir_all(out) ?? fail("cannot create {out}: {err}")
    kat: "{root}/{KAT}"
    bytes: files.read_bytes(kat) ?? fail("cannot read {KAT}: {err}")
    if crypto.sha256(bytes.copy()).hex() != KAT_SHA256 -> fail("NormalizationTest17 checksum mismatch")
    if data_rows(String.from_bytes_lossy(bytes)) != KAT_ROWS -> fail("NormalizationTest17 row count mismatch")
    binary: "{out}/native-nfc"
    cc_args := [String]{"-std=c11", "-Wall", "-Wextra", "-Werror", "{root}/{HERE}/NativeTextNormalizeWitness.c"}
    loop input in args[1..<args.len()] -> cc_args.push(if input.starts_with("-") -> input.copy() else -> resolve(root, input))
    cc_args.extend([String]{"-lm", "-pthread", "-o", binary.copy()})
    _: logged(native_cc(load_policy(root), cc_args).cwd(root.copy()), "native-link", "{out}/native-link.log")
    executed: logged(process.cmd([String]{binary.copy(), kat.copy()}).cwd(root.copy()), "native-execute", "{out}/native-execute.log")
    expected: files.read("{root}/{HERE}/NativeTextNormalizeWitness.stdout") ?? fail("cannot read NativeTextNormalizeWitness.stdout: {err}")
    if executed.output != expected || executed.errors != "" -> fail("native witness stdout mismatch")
    print("NFC2 Unicode17 {KAT_ROWS} rows / both routes / ownership OK")
}

#Test("data rows are the lines with a hex source column") {
    text: "# comment\n@Part0\n1E0A;1E0A;0044 0307;1E0A;0044 0307; # x\n0044 0307;1E0A;0044 0307;1E0A;0044 0307;\n\n1e0a;x;\n"
    assert_eq(data_rows(text), 2)
    assert_eq(resolve("/a/b", "../c/./d"), "/a/c/d")
}
