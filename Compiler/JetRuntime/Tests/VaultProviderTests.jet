// Exact private-error predicates from tests/fixtures/vault_key_runtime.rs:503-556.
// The C transport supplies the literal expected Display/Debug text and forbidden
// sentinels; it does not format errors or implement a vault provider.
fn vault_fixture_check(condition: Bool) {
    if !condition -> jet_rt_unreachable(I64{0}, I64{0})
}
#Export(c) fn errors_and_handles_are_redacted(kind: I64, first: I64, second: I64, expected_display: I64, expected_debug: I64, forbidden: I64) {
    error :: vault_error_new(kind, first, second)
    clone :: vault_error_clone(error)
    vault_fixture_check(vault_error_equal(error, clone))
    vault_fixture_check(vault_error_tag(error) == kind)
    if (kind == I64{10}) {
        vault_fixture_check(rt_text_word(error + VAULT_ERROR_FIRST) == first)
        vault_fixture_check(rt_text_word(clone + VAULT_ERROR_FIRST) == first)
        vault_fixture_check(rt_text_word(error + VAULT_ERROR_SECOND) == I64{0})
        other :: vault_error_new(kind, (first + I64{1}) % I64{5}, I64{0})
        vault_fixture_check(!vault_error_equal(error, other))
        vault_error_drop(other)
    }
    shown :: vault_error_display(error)
    debug :: vault_error_debug(error)
    vault_fixture_check(jet_rt_string_eq(shown, expected_display))
    vault_fixture_check(jet_rt_string_eq(debug, expected_debug))
    count :: rt_text_word(forbidden + DATA_SEQUENCE_LENGTH)
    data :: rt_text_word(forbidden + DATA_SEQUENCE_DATA)
    at := I64{0}
    loop at < count {
        needle :: rt_text_word(data + at * DATA_TREE_ELEMENT_BYTES)
        vault_fixture_check(rt_text_find(shown, needle, I64{0}, false) < I64{0})
        vault_fixture_check(rt_text_find(debug, needle, I64{0}, false) < I64{0})
        at += I64{1}
    }
    jet_rt_string_drop(shown)
    jet_rt_string_drop(debug)
    vault_error_drop(error)
    vault_error_drop(clone)
}
#Export(c) fn jet_rt_vault_crypto_projection_fixture() {
    vault_fixture_check(vault_crypto_from_provider(I64{0}) == VAULT_CRYPTO_LENGTH)
    vault_fixture_check(vault_crypto_from_provider(I64{1}) == VAULT_CRYPTO_KEY_REJECTED)
    vault_fixture_check(vault_crypto_from_provider(I64{2}) == VAULT_CRYPTO_KEY_REJECTED)
    vault_fixture_check(vault_crypto_from_provider(I64{3}) == VAULT_CRYPTO_KEY_REJECTED)
    vault_fixture_check(vault_crypto_from_provider(I64{4}) == VAULT_CRYPTO_OPEN_FAILED)
    vault_fixture_check(vault_crypto_from_provider(I64{5}) == VAULT_CRYPTO_KEY_REJECTED)
    vault_fixture_check(vault_crypto_from_provider(I64{6}) == VAULT_CRYPTO_LENGTH)
    vault_fixture_check(vault_crypto_from_provider(I64{7}) == VAULT_CRYPTO_KEY_REJECTED)
    vault_fixture_check(vault_crypto_from_provider(I64{8}) == VAULT_CRYPTO_UNAVAILABLE)
    vault_fixture_check(vault_crypto_from_provider(I64{9}) == VAULT_CRYPTO_UNAVAILABLE)
    vault_fixture_check(vault_crypto_from_provider(I64{10}) == VAULT_CRYPTO_UNAVAILABLE)
}
// Supplemental real filesystem boundary, not a substitute for the original
// prepare_generate_at symlink fixture until the complete provider is composed.
#Export(c) fn jet_rt_vault_linux_dir_fixture(root: I64, expected: I64) {
    slot :: jet_rt_alloc(I64{8}, I64{8})
    rt_text_store(slot, I64{-471})
    error :: vault_linux_dir_at_root(root, slot)
    if (expected == I64{-1}) {
        vault_fixture_check(error == I64{0})
        fd :: rt_text_word(slot)
        vault_fixture_check(fd >= I64{0})
        vault_linux_close(fd)
    } else {
        vault_fixture_check(error != I64{0})
        vault_fixture_check(vault_error_tag(error) == expected)
        vault_fixture_check(rt_text_word(slot) == I64{-471})
        vault_error_drop(error)
    }
    jet_rt_free(slot, I64{8}, I64{8})
}
// Supplementary historical codec checks: exact bytes, every truncation, garbage,
// malformed UTF-8, preserved NUL/Unicode strings, and canonical domain hash.
#Export(c) fn jet_rt_vault_legacy_fixture(bytes: I64, length: I64, expected_hash: I64) {
    pairs :: vault_decode_pairs(bytes, length)
    vault_fixture_check(pairs != I64{0})
    encoded :: vault_encode_pairs(pairs)
    vault_fixture_check(rt_text_len(encoded) == length)
    at := I64{0}
    loop at < length {
        vault_fixture_check(rt_text_byte(rt_text_data(encoded) + at) == rt_text_byte(bytes + at))
        at += I64{1}
    }
    at = I64{0}
    loop at < length {
        vault_fixture_check(vault_decode_pairs(bytes, at) == I64{0})
        at += I64{1}
    }
    scratch :: jet_rt_alloc(I64{624}, I64{8})
    digest :: scratch + I64{592}
    vault_payload_hash(bytes, length, digest, scratch)
    at = I64{0}
    loop {
        if (at == I64{32}) -> break
        vault_fixture_check(rt_text_byte(digest + at) == rt_text_byte(expected_hash + at))
        at += I64{1}
    }
    garbage :: jet_rt_alloc(length + I64{1}, I64{1})
    rt_text_bytes_copy(garbage, bytes, length)
    rt_text_put(garbage + length, I64{0})
    vault_fixture_check(vault_decode_pairs(garbage, length + I64{1}) == I64{0})
    jet_rt_free(garbage, length + I64{1}, I64{1})
    jet_rt_free(scratch, I64{624}, I64{8})
    vault_pairs_drop(pairs)
    vault_text_zero(encoded)
    jet_rt_string_drop(encoded)
}
#Export(c) fn jet_rt_vault_invalid_legacy_fixture(bytes: I64, length: I64) {
    vault_fixture_check(vault_decode_pairs(bytes, length) == I64{0})
}

// Exact Rust fixture558-591; the C free wrapper observes this actual Secret
// buffer after wiping and before allocator release (not a parallel drop model).
// out receives record, deep clone, and owned Debug text for the transport.
#Export(c) fn stored_key_bytes_are_redacted_and_zeroized_on_drop(name: I64, bytes: I64, redacted: I64, forbidden: I64, out: I64) {
    secret :: vault_secret_adopt(bytes)
    record :: vault_record_allocate(name, I64{2}, I64{1}, I64{1}, I64{2}, secret)
    at := I64{0}
    loop {
        if (at == I64{16}) -> break
        rt_text_put(record + VAULT_RECORD_OPAQUE + at, I64{2})
        at += I64{1}
    }
    rt_text_store(record + VAULT_RECORD_CREATED, I64{10})
    rt_text_store(record + VAULT_RECORD_STATUS_MS, I64{10})
    scratch :: jet_rt_alloc(I64{8192}, I64{8})
    vault_fixture_check(vault_public_hash(I64{2}, secret, record + VAULT_RECORD_PUBLIC_HASH, scratch))
    vault_record_hash(record, record + VAULT_RECORD_HASH, scratch)
    jet_rt_free(scratch, I64{8192}, I64{8})
    shown :: vault_record_debug(record)
    vault_fixture_check(rt_text_find(shown, redacted, I64{0}, false) >= I64{0})
    vault_fixture_check(rt_text_find(shown, forbidden, I64{0}, false) < I64{0})
    clone :: vault_record_clone(record)
    vault_fixture_check(vault_record_equal(record, clone))
    clone_secret :: vault_secret_bytes(rt_text_word(clone + VAULT_RECORD_SECRET))
    clone_data :: rt_text_word(clone_secret + DATA_SEQUENCE_DATA)
    first :: host_u8_get(clone_data, I64{0})
    host_u8_put(clone_data, I64{0}, first ~| I64{1})
    vault_fixture_check(!vault_record_equal(record, clone))
    host_u8_put(clone_data, I64{0}, first)
    vault_fixture_check(vault_record_equal(record, clone))
    rt_text_store(out, record)
    rt_text_store(out + I64{8}, clone)
    rt_text_store(out + I64{16}, shown)
}
#Export(c) fn jet_rt_vault_record_fixture_drop(record: I64) { vault_record_drop(record) }
#Export(c) fn jet_rt_vault_record_fixture_debug(record: I64) -> I64 { vault_record_debug(record) }

// Record hashing must not overflow scratch before rejecting a long origin name.
// Hash/public metadata are otherwise the genuine native Secret fixture above.
#Export(c) fn jet_rt_vault_origin_hash_bound_fixture(record: I64, name: I64, expected: I64) {
    origin :: jet_rt_alloc(VAULT_ORIGIN_BYTES, I64{8})
    at := I64{0}
    loop {
        if (at == I64{16}) -> break
        rt_text_put(origin + VAULT_ORIGIN_UUID + at, I64{3})
        rt_text_put(origin + VAULT_ORIGIN_OPAQUE + at, I64{5})
        at += I64{1}
    }
    at = I64{0}
    loop {
        if (at == I64{32}) -> break
        rt_text_put(origin + VAULT_ORIGIN_HASH + at, I64{6})
        at += I64{1}
    }
    rt_text_store(origin + VAULT_ORIGIN_NAME, jet_rt_string_clone(name))
    rt_text_store(origin + VAULT_ORIGIN_GENERATION, I64{4})
    rt_text_store(record + VAULT_RECORD_ORIGIN, origin)
    scratch :: jet_rt_alloc(I64{8288}, I64{8})
    rt_text_store(scratch + I64{8256}, I64{72623859790382856})
    rt_text_store(scratch + I64{8264}, I64{72623859790382856})
    rt_text_store(scratch + I64{8272}, I64{72623859790382856})
    rt_text_store(scratch + I64{8280}, I64{72623859790382856})
    vault_record_hash(record, record + VAULT_RECORD_HASH, scratch)
    vault_fixture_check(rt_text_equal_bytes(record + VAULT_RECORD_HASH, expected, I64{32}))
    vault_fixture_check(vault_record_validate(record, false, scratch) == I64{0})
    first :: rt_text_byte(record + VAULT_RECORD_HASH)
    rt_text_put(record + VAULT_RECORD_HASH, first ~| I64{1})
    vault_fixture_check(vault_record_validate(record, false, scratch) == I64{8})
    // Both failures retain their seed priority and preserve the scratch fence.
    at = I64{8256}
    loop {
        if (at == I64{8288}) -> break
        vault_fixture_check(rt_text_word(scratch + at) == I64{72623859790382856})
        at += I64{8}
    }
    vault_origin_drop(origin)
    rt_text_store(record + VAULT_RECORD_ORIGIN, I64{0})
    vault_record_hash(record, record + VAULT_RECORD_HASH, scratch)
    thread_zero(scratch, I64{8288})
    jet_rt_free(scratch, I64{8288}, I64{8})
}

fn vault_fixture_store(byte: I64) -> I64 {
    uuid :: jet_rt_alloc(I64{16}, I64{8})
    at := I64{0}
    loop {
        if (at == I64{16}) -> break
        rt_text_put(uuid + at, byte)
        at += I64{1}
    }
    store :: vault_store_new(uuid)
    jet_rt_free(uuid, I64{16}, I64{8})
    rt_text_store(store + VAULT_STORE_REVISION, I64{1})
    store
}
fn vault_fixture_origin(name: I64) -> I64 {
    origin :: jet_rt_alloc(VAULT_ORIGIN_BYTES, I64{8})
    at := I64{0}
    loop {
        if (at == I64{16}) -> break
        rt_text_put(origin + VAULT_ORIGIN_UUID + at, I64{3})
        rt_text_put(origin + VAULT_ORIGIN_OPAQUE + at, I64{5})
        at += I64{1}
    }
    at = I64{0}
    loop {
        if (at == I64{32}) -> break
        rt_text_put(origin + VAULT_ORIGIN_HASH + at, I64{6})
        at += I64{1}
    }
    rt_text_store(origin + VAULT_ORIGIN_NAME, jet_rt_string_clone(name))
    rt_text_store(origin + VAULT_ORIGIN_GENERATION, I64{4})
    origin
}
fn vault_fixture_push_record(store: I64, record: I64) {
    records :: rt_text_word(store + VAULT_STORE_RECORDS)
    slot :: data_sequence_reserve(records, DATA_TREE_ELEMENT_BYTES)
    rt_text_store(slot, record)
    rt_text_store(records + DATA_SEQUENCE_LENGTH, rt_text_word(records + DATA_SEQUENCE_LENGTH) + I64{1})
}
fn vault_fixture_opaque(record: I64, byte: I64, scratch: I64) {
    at := I64{0}
    loop {
        if (at == I64{16}) -> break
        rt_text_put(record + VAULT_RECORD_OPAQUE + at, byte)
        at += I64{1}
    }
    vault_record_hash(record, record + VAULT_RECORD_HASH, scratch)
}
// Exact Rust fixture464-500: the default provider fills the final Secret buffer
// once. No replay seed or independent entropy provider participates.
#Export(c) fn imported_origin_round_trips_and_invalid_combinations_reject(name: I64, source: I64) {
    bytes :: data_sequence_new(I64{32}, RT_HOST_U8_STRIDE)
    data :: rt_text_word(bytes + DATA_SEQUENCE_DATA)
    vault_fixture_check(rt_crypto_entropy_fill(data, I64{32}) == I64{0})
    rt_text_store(bytes + DATA_SEQUENCE_LENGTH, I64{32})
    secret :: vault_secret_adopt(bytes)
    jet_rt_free(bytes, DATA_SEQUENCE_BYTES, I64{8})
    record :: vault_record_allocate(name, I64{1}, I64{1}, I64{1}, I64{2}, secret)
    origin :: vault_fixture_origin(source)
    rt_text_store(record + VAULT_RECORD_ORIGIN, origin)
    rt_text_store(record + VAULT_RECORD_CREATED, I64{10})
    rt_text_store(record + VAULT_RECORD_STATUS_MS, I64{10})
    scratch :: jet_rt_alloc(I64{8256}, I64{8})
    vault_fixture_check(vault_public_hash(I64{1}, secret, record + VAULT_RECORD_PUBLIC_HASH, scratch))
    vault_fixture_opaque(record, I64{2}, scratch)
    store :: vault_fixture_store(I64{1})
    vault_fixture_push_record(store, record)
    slots :: jet_rt_alloc(I64{16}, I64{8})
    vault_fixture_check(vault_encode_v2(store, slots) == I64{-1})
    encoded :: rt_text_word(slots)
    vault_fixture_check(vault_decode_v2(rt_text_data(encoded), rt_text_len(encoded), slots + I64{8}) == I64{-1})
    decoded :: rt_text_word(slots + I64{8})
    records :: rt_text_word(decoded + VAULT_STORE_RECORDS)
    vault_fixture_check(rt_text_word(records + DATA_SEQUENCE_LENGTH) == I64{1})
    decoded_record :: rt_text_word(rt_text_word(records + DATA_SEQUENCE_DATA))
    vault_fixture_check(vault_origin_equal(rt_text_word(decoded_record + VAULT_RECORD_ORIGIN), origin))
    vault_fixture_check(rt_text_equal_bytes(decoded_record + VAULT_RECORD_HASH, record + VAULT_RECORD_HASH, I64{32}))
    rt_text_store(record + VAULT_RECORD_PROVENANCE, I64{1})
    vault_record_hash(record, record + VAULT_RECORD_HASH, scratch)
    vault_fixture_check(vault_encode_v2(store, slots) == I64{8})
    vault_store_drop(decoded)
    vault_store_drop(store)
    vault_text_zero(encoded)
    jet_rt_string_drop(encoded)
    thread_zero(scratch, I64{8256})
    jet_rt_free(scratch, I64{8256}, I64{8})
    jet_rt_free(slots, I64{16}, I64{8})
}

// Exact original codec fixture, plus checking its InvalidName ordinal through
// the actual encoder for each rejected name (rather than fabricating an error).
#Export(c) fn jvlt2_codec_is_canonical_bounded_and_preserves_legacy_strings(name: I64, value: I64, bad: I64, non_nfc: I64, nfc: I64) {
    store :: vault_fixture_store(I64{7})
    pairs :: rt_text_word(store + VAULT_STORE_STRINGS)
    pair :: data_sequence_reserve(pairs, VAULT_PAIR_BYTES)
    rt_text_store(pair, jet_rt_string_clone(name))
    rt_text_store(pair + I64{8}, jet_rt_string_clone(value))
    rt_text_store(pairs + DATA_SEQUENCE_LENGTH, I64{1})
    slots :: jet_rt_alloc(I64{16}, I64{8})
    vault_fixture_check(vault_encode_v2(store, slots) == I64{-1})
    encoded :: rt_text_word(slots)
    length :: rt_text_len(encoded)
    bytes :: rt_text_data(encoded)
    vault_fixture_check(length == I64{100})
    vault_fixture_check(rt_text_byte(bytes) == I64{74} && rt_text_byte(bytes + I64{1}) == I64{86} &&
        rt_text_byte(bytes + I64{2}) == I64{76} && rt_text_byte(bytes + I64{3}) == I64{84})
    vault_fixture_check(rt_text_byte(bytes + I64{4}) == I64{2})
    scratch :: jet_rt_alloc(I64{8256}, I64{8})
    vault_payload_hash(bytes, I64{68}, scratch + I64{8192}, scratch)
    vault_fixture_check(rt_text_equal_bytes(bytes + I64{68}, scratch + I64{8192}, I64{32}))
    vault_fixture_check(vault_decode_v2(bytes, length, slots + I64{8}) == I64{-1})
    decoded :: rt_text_word(slots + I64{8})
    vault_fixture_check(vault_store_equal(decoded, store))
    vault_store_drop(decoded)
    trailing :: jet_rt_alloc(length + I64{1}, I64{1})
    rt_text_bytes_copy(trailing, bytes, length)
    rt_text_put(trailing + length, I64{0})
    vault_fixture_check(vault_decode_v2(trailing, length + I64{1}, slots + I64{8}) == I64{8})
    jet_rt_free(trailing, length + I64{1}, I64{1})
    vault_fixture_check(!vault_validate_text(bad, false))
    jet_rt_string_drop(rt_text_word(pair))
    rt_text_store(pair, jet_rt_string_clone(bad))
    vault_fixture_check(vault_encode_v2(store, slots) == I64{0})
    vault_fixture_check(!vault_validate_text(non_nfc, false))
    jet_rt_string_drop(rt_text_word(pair))
    rt_text_store(pair, jet_rt_string_clone(non_nfc))
    vault_fixture_check(vault_encode_v2(store, slots) == I64{0})
    vault_fixture_check(vault_validate_text(nfc, false))
    vault_fixture_check(rt_text_word(slots) == encoded)
    vault_text_zero(encoded)
    jet_rt_string_drop(encoded)
    vault_store_drop(store)
    thread_zero(scratch, I64{8256})
    jet_rt_free(scratch, I64{8256}, I64{8})
    jet_rt_free(slots, I64{16}, I64{8})
}
// Supplemental real-owner fixtures: two stable index arrays, six versions,
// duplicate IDs at the first/middle/last pair, and earlier InvalidName priority.
#Export(c) fn jet_rt_vault_codec_duplicate_fixture(base: I64, invalid_origin: I64) {
    store :: vault_fixture_store(I64{1})
    scratch :: jet_rt_alloc(I64{8256}, I64{8})
    slots :: jet_rt_alloc(I64{16}, I64{8})
    index := I64{0}
    loop {
        if (index == I64{6}) -> break
        record :: vault_record_clone(base)
        rt_text_store(record + VAULT_RECORD_GENERATION, index + I64{1})
        status :: if (index == I64{5}) -> I64{1} else -> I64{2}
        rt_text_store(record + VAULT_RECORD_STATUS, status)
        at := I64{0}
        loop {
            if (at == I64{32}) -> break
            rt_text_put(record + VAULT_RECORD_REASON_HASH + at, if (status == I64{1}) -> I64{0} else -> I64{4})
            at += I64{1}
        }
        vault_fixture_opaque(record, index + I64{1}, scratch)
        vault_fixture_push_record(store, record)
        index += I64{1}
    }
    records :: rt_text_word(store + VAULT_STORE_RECORDS)
    data :: rt_text_word(records + DATA_SEQUENCE_DATA)
    // Reverse the input owner list; encoding must canonicalize WITHOUT moving
    // its actual owners, and the decoded list must remain in canonical order.
    index = I64{0}
    loop {
        if (index == I64{3}) -> break
        left :: data + index * DATA_TREE_ELEMENT_BYTES
        right :: data + (I64{5} - index) * DATA_TREE_ELEMENT_BYTES
        save :: rt_text_word(left)
        rt_text_store(left, rt_text_word(right))
        rt_text_store(right, save)
        index += I64{1}
    }
    vault_fixture_check(vault_encode_v2(store, slots) == I64{-1})
    encoded :: rt_text_word(slots)
    bytes :: rt_text_data(encoded)
    length :: rt_text_len(encoded)
    vault_fixture_check(vault_decode_v2(bytes, length, slots + I64{8}) == I64{-1})
    decoded :: rt_text_word(slots + I64{8})
    decoded_rows :: rt_text_word(decoded + VAULT_STORE_RECORDS)
    canonical :: rt_text_word(decoded_rows + DATA_SEQUENCE_DATA)
    vault_fixture_check(rt_text_word(decoded_rows + DATA_SEQUENCE_LENGTH) == I64{6})
    index = I64{0}
    loop {
        if (index == I64{6}) -> break
        record :: rt_text_word(canonical + index * DATA_TREE_ELEMENT_BYTES)
        original :: rt_text_word(data + (I64{5} - index) * DATA_TREE_ELEMENT_BYTES)
        vault_fixture_check(vault_record_equal(record, original))
        index += I64{1}
    }
    name_length :: rt_text_len(rt_text_word(base + VAULT_RECORD_NAME))
    first_record :: I64{44} + I64{19} + name_length
    stride :: I64{219} + name_length
    // Strict truncations exercise the suffix check; rehashed truncations also
    // reach the wire parser's partial-owner cleanup paths.
    cut := I64{0}
    loop cut < length {
        vault_fixture_check(vault_decode_v2(bytes, cut, slots + I64{8}) == I64{8})
        cut += I64{1}
    }
    cut = I64{44}
    payload_length :: length - I64{32}
    loop cut < payload_length {
        truncated :: jet_rt_alloc(cut + I64{32}, I64{1})
        rt_text_bytes_copy(truncated, bytes, cut)
        vault_payload_hash(truncated, cut, truncated + cut, scratch)
        rt_text_store(slots + I64{8}, I64{1234})
        vault_fixture_check(vault_decode_v2(truncated, cut + I64{32}, slots + I64{8}) == I64{8})
        vault_fixture_check(rt_text_word(slots + I64{8}) == I64{1234})
        // A partial wire owns plaintext key material; wipe it before release.
        wipe := I64{0}
        loop wipe < (cut + I64{32}) {
            rt_text_put(truncated + wipe, I64{0})
            wipe += I64{1}
        }
        jet_rt_free(truncated, cut + I64{32}, I64{1})
        cut += I64{1}
    }
    duplicate := I64{1}
    loop {
        if (duplicate >= I64{6}) -> break
        row :: rt_text_word(canonical + duplicate * DATA_TREE_ELEMENT_BYTES)
        previous :: rt_text_word(canonical + (duplicate - I64{1}) * DATA_TREE_ELEMENT_BYTES)
        vault_fixture_opaque(row, duplicate, scratch)
        rt_text_store(slots, encoded)
        vault_fixture_check(vault_encode_v2(decoded, slots) == I64{8})
        vault_fixture_check(rt_text_word(slots) == encoded)
        wire_opaque :: first_record + duplicate * stride + I64{14} + name_length
        prior_opaque :: first_record + (duplicate - I64{1}) * stride + I64{14} + name_length
        rt_text_bytes_copy(bytes + wire_opaque, bytes + prior_opaque, I64{16})
        vault_payload_hash(bytes, length - I64{32}, bytes + length - I64{32}, scratch)
        vault_fixture_check(vault_decode_v2(bytes, length, slots + I64{8}) == I64{8})
        vault_fixture_opaque(row, duplicate + I64{1}, scratch)
        at := I64{0}
        loop {
            if (at == I64{16}) -> break
            rt_text_put(bytes + wire_opaque + at, duplicate + I64{1})
            at += I64{1}
        }
        vault_fixture_check(rt_text_word(previous + VAULT_RECORD_GENERATION) == duplicate)
        duplicate += I64{2}
    }
    first :: rt_text_word(canonical)
    last :: rt_text_word(canonical + I64{5} * DATA_TREE_ELEMENT_BYTES)
    origin :: vault_fixture_origin(invalid_origin)
    rt_text_store(first + VAULT_RECORD_ORIGIN, origin)
    vault_record_hash(first, first + VAULT_RECORD_HASH, scratch)
    vault_fixture_opaque(last, I64{5}, scratch)
    vault_fixture_check(vault_encode_v2(decoded, slots) == I64{0})
    vault_store_drop(decoded)
    vault_text_zero(encoded)
    jet_rt_string_drop(encoded)
    vault_store_drop(store)
    thread_zero(scratch, I64{8256})
    jet_rt_free(scratch, I64{8256}, I64{8})
    jet_rt_free(slots, I64{16}, I64{8})
}
