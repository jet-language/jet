// Exact private-error predicates from tests/fixtures/vault_key_runtime.rs:503-556.
// The C transport supplies the literal expected Display/Debug text and forbidden
// sentinels; it does not format errors or implement a vault provider.
fn vault_fixture_check(condition: Bool) {
    if !condition -> jet_rt_unreachable(I64{0}, I64{0})
}
#Export(c) fn errors_and_handles_are_redacted(kind: I64, first: I64, second: I64, expected_display: I64, expected_debug: I64, forbidden: I64) {
    error :: vault_error_new(kind, first, second)
    clone :: vault_error_clone(error)
    vault_fixture_check(vault_error_equal(error, clone))
    vault_fixture_check(vault_error_tag(error) == kind)
    shown :: vault_error_display(error)
    debug :: vault_error_debug(error)
    vault_fixture_check(jet_rt_string_eq(shown, expected_display))
    vault_fixture_check(jet_rt_string_eq(debug, expected_debug))
    count :: rt_text_word(forbidden + DATA_SEQUENCE_LENGTH)
    data :: rt_text_word(forbidden + DATA_SEQUENCE_DATA)
    at := I64{0}
    loop at < count {
        needle :: rt_text_word(data + at * DATA_TREE_ELEMENT_BYTES)
        vault_fixture_check(rt_text_find(shown, needle, I64{0}, false) < I64{0})
        vault_fixture_check(rt_text_find(debug, needle, I64{0}, false) < I64{0})
        at += I64{1}
    }
    jet_rt_string_drop(shown)
    jet_rt_string_drop(debug)
    vault_error_drop(error)
    vault_error_drop(clone)
}
// Supplementary historical codec checks: exact bytes, every truncation, garbage,
// malformed UTF-8, preserved NUL/Unicode strings, and canonical domain hash.
#Export(c) fn jet_rt_vault_legacy_fixture(bytes: I64, length: I64, expected_hash: I64) {
    pairs :: vault_decode_pairs(bytes, length)
    vault_fixture_check(pairs != I64{0})
    encoded :: vault_encode_pairs(pairs)
    vault_fixture_check(rt_text_len(encoded) == length)
    at := I64{0}
    loop at < length {
        vault_fixture_check(rt_text_byte(rt_text_data(encoded) + at) == rt_text_byte(bytes + at))
        at += I64{1}
    }
    at = I64{0}
    loop at < length {
        vault_fixture_check(vault_decode_pairs(bytes, at) == I64{0})
        at += I64{1}
    }
    scratch :: jet_rt_alloc(I64{624}, I64{8})
    digest :: scratch + I64{592}
    vault_payload_hash(bytes, length, digest, scratch)
    at = I64{0}
    loop {
        if (at == I64{32}) -> break
        vault_fixture_check(rt_text_byte(digest + at) == rt_text_byte(expected_hash + at))
        at += I64{1}
    }
    garbage :: jet_rt_alloc(length + I64{1}, I64{1})
    rt_text_bytes_copy(garbage, bytes, length)
    rt_text_put(garbage + length, I64{0})
    vault_fixture_check(vault_decode_pairs(garbage, length + I64{1}) == I64{0})
    jet_rt_free(garbage, length + I64{1}, I64{1})
    jet_rt_free(scratch, I64{624}, I64{8})
    vault_pairs_drop(pairs)
    vault_text_zero(encoded)
    jet_rt_string_drop(encoded)
}
#Export(c) fn jet_rt_vault_invalid_legacy_fixture(bytes: I64, length: I64) {
    vault_fixture_check(vault_decode_pairs(bytes, length) == I64{0})
}

// Exact Rust fixture558-591; the C free wrapper observes this actual Secret
// buffer after wiping and before allocator release (not a parallel drop model).
// out receives record, deep clone, and owned Debug text for the transport.
#Export(c) fn stored_key_bytes_are_redacted_and_zeroized_on_drop(name: I64, bytes: I64, redacted: I64, forbidden: I64, out: I64) {
    secret :: vault_secret_adopt(bytes)
    record :: vault_record_allocate(name, I64{2}, I64{1}, I64{1}, I64{2}, secret)
    at := I64{0}
    loop {
        if (at == I64{16}) -> break
        rt_text_put(record + VAULT_RECORD_OPAQUE + at, I64{2})
        at += I64{1}
    }
    rt_text_store(record + VAULT_RECORD_CREATED, I64{10})
    rt_text_store(record + VAULT_RECORD_STATUS_MS, I64{10})
    scratch :: jet_rt_alloc(I64{8192}, I64{8})
    vault_fixture_check(vault_public_hash(I64{2}, secret, record + VAULT_RECORD_PUBLIC_HASH, scratch))
    vault_record_hash(record, record + VAULT_RECORD_HASH, scratch)
    jet_rt_free(scratch, I64{8192}, I64{8})
    shown :: vault_record_debug(record)
    vault_fixture_check(rt_text_find(shown, redacted, I64{0}, false) >= I64{0})
    vault_fixture_check(rt_text_find(shown, forbidden, I64{0}, false) < I64{0})
    clone :: vault_record_clone(record)
    vault_fixture_check(vault_record_equal(record, clone))
    clone_secret :: vault_secret_bytes(rt_text_word(clone + VAULT_RECORD_SECRET))
    clone_data :: rt_text_word(clone_secret + DATA_SEQUENCE_DATA)
    first :: host_u8_get(clone_data, I64{0})
    host_u8_put(clone_data, I64{0}, first ~| I64{1})
    vault_fixture_check(!vault_record_equal(record, clone))
    host_u8_put(clone_data, I64{0}, first)
    vault_fixture_check(vault_record_equal(record, clone))
    rt_text_store(out, record)
    rt_text_store(out + I64{8}, clone)
    rt_text_store(out + I64{16}, shown)
}
#Export(c) fn jet_rt_vault_record_fixture_drop(record: I64) { vault_record_drop(record) }
#Export(c) fn jet_rt_vault_record_fixture_debug(record: I64) -> I64 { vault_record_debug(record) }

// Record hashing must not overflow scratch before rejecting a long origin name.
// Hash/public metadata are otherwise the genuine native Secret fixture above.
#Export(c) fn jet_rt_vault_origin_hash_bound_fixture(record: I64, name: I64, expected: I64) {
    origin :: jet_rt_alloc(VAULT_ORIGIN_BYTES, I64{8})
    at := I64{0}
    loop {
        if (at == I64{16}) -> break
        rt_text_put(origin + VAULT_ORIGIN_UUID + at, I64{3})
        rt_text_put(origin + VAULT_ORIGIN_OPAQUE + at, I64{5})
        at += I64{1}
    }
    at = I64{0}
    loop {
        if (at == I64{32}) -> break
        rt_text_put(origin + VAULT_ORIGIN_HASH + at, I64{6})
        at += I64{1}
    }
    rt_text_store(origin + VAULT_ORIGIN_NAME, jet_rt_string_clone(name))
    rt_text_store(origin + VAULT_ORIGIN_GENERATION, I64{4})
    rt_text_store(record + VAULT_RECORD_ORIGIN, origin)
    scratch :: jet_rt_alloc(I64{8288}, I64{8})
    rt_text_store(scratch + I64{8256}, I64{72623859790382856})
    rt_text_store(scratch + I64{8264}, I64{72623859790382856})
    rt_text_store(scratch + I64{8272}, I64{72623859790382856})
    rt_text_store(scratch + I64{8280}, I64{72623859790382856})
    vault_record_hash(record, record + VAULT_RECORD_HASH, scratch)
    vault_fixture_check(rt_text_equal_bytes(record + VAULT_RECORD_HASH, expected, I64{32}))
    vault_fixture_check(vault_record_validate(record, false, scratch) == I64{0})
    first :: rt_text_byte(record + VAULT_RECORD_HASH)
    rt_text_put(record + VAULT_RECORD_HASH, first ~| I64{1})
    vault_fixture_check(vault_record_validate(record, false, scratch) == I64{8})
    // Both failures retain their seed priority and preserve the scratch fence.
    at = I64{8256}
    loop {
        if (at == I64{8288}) -> break
        vault_fixture_check(rt_text_word(scratch + at) == I64{72623859790382856})
        at += I64{8}
    }
    vault_origin_drop(origin)
    rt_text_store(record + VAULT_RECORD_ORIGIN, I64{0})
    vault_record_hash(record, record + VAULT_RECORD_HASH, scratch)
    thread_zero(scratch, I64{8288})
    jet_rt_free(scratch, I64{8288}, I64{8})
}
