#!/usr/bin/env jet
// Runs a composed UI witness binary and holds its output byte-exact to the frozen
// goldens in Compiler/JetRuntime/Tests. Each case runs the binary with its mode
// argument and writes <case>.stdout, <case>.stderr and <case>.status.json under
// OUT. A case must exit with its status: the ownership run exits 0 with the golden
// on stdout and an empty stderr; a stop exits nonzero with an empty stdout and the
// golden on stderr. The first departing case ends the run with exit 1. Each run
// is limited to 30 seconds (key: 300).
// The key witness's ownership run reads the char Debug goldens for every scalar,
// rebuilt into OUT from the tracked CharDebugPlain.ranges and pinned by sha256.
// Usage (from the repository root):
//   jet Compiler/JetRuntime/Tests/UiWitness.jet WITNESS OUT BINARY
use {
    crypto: core.crypto
    files: core.files
    process: core.process
    term: core.term
}

GOLDENS: "Compiler/JetRuntime/Tests"
SHARED_STOP: "DataPlotStops-getter-variant.stderr"
USAGE: "usage: jet Compiler/JetRuntime/Tests/UiWitness.jet WITNESS OUT BINARY"
PLAIN_RANGES: "CharDebugPlain.ranges"
ORACLE_SHA256: "4df07a213d8bc130872d2b1358ef8cd04f9bba01a02db5edac23995e99427b72"
WITNESSES: "choices, cursor, events, form-action-error, key, view-snapshots"
OUTPUT_MISMATCH: "byte-exact output mismatch"

Case: struct {
    name: String
    args: [String]
    status: Int
    golden: String
}

// One witness: the operands its usage line names, its cases in run order, the
// per-run timeout, the spacing of its exit message and its success line.
Witness: struct {
    operands: String
    oracle: Bool
    cases: [Case]
    timeout: Duration
    exit_gap: String
    done: String
}

// What one run of the binary left: `exited` is false when no exit status exists
// (spawn failure, signal or timeout); `signal` and `error` are "" when absent.
Outcome: struct {
    stdout: [U8]
    stderr: [U8]
    status: Int
    exited: Bool
    signal: String
    error: String
}

ownership: fn(golden: String) -> Case Never! { Case{name: "ownership", args: [String]{}, status: 0, golden: golden} }

stop: fn(mode: String, status: Int, golden: String) -> Case Never! { Case{name: mode, args: [String]{mode}, status: status, golden: golden} }

plain: fn(operand: String, golden: String, done: String) -> Witness Never! {
    Witness{operands: "OUT {operand}", oracle: false, cases: [Case]{ownership(golden)}, timeout: 30s, exit_gap: "", done: done}
}

// Ownership, then the shared record-variant stop (exit 70) for every mode.
variant_stops: fn(operand: String, golden: String, modes: [String], exit_gap: String, done: String) -> Witness Never! {
    cases := [Case]{ownership(golden)}
    loop mode in modes {
        cases.push(stop(mode, 70, SHARED_STOP))
    }
    Witness{operands: "OUT {operand}", oracle: false, cases: cases, timeout: 30s, exit_gap: exit_gap, done: done}
}

// The witness a name selects; an unknown name has no cases.
witness: fn(key: String) -> Witness Never! {
    if key == "events" -> return plain("UI_EVENTS_WITNESS", "UiEventsWitness.stdout", "UI events: real-provider ownership byte-identical")
    if key == "form-action-error" -> return plain("UI_ACTION_ERROR_WITNESS", "UiFormActionErrorWitness.stdout", "UI ActionError: real consumed producers and transitive ownership byte-identical")
    if key == "cursor" -> return plain("UI_CURSOR_WITNESS", "UiCursorWitness.stdout", "UI canonical Cursor: real-provider ownership byte-identical")
    if key == "view-snapshots" -> return plain("UI_VIEW_SNAPSHOTS_WITNESS", "UiViewSnapshotsWitness.stdout", "UI view snapshots: real-provider ownership byte-identical")
    if key == "choices" -> return variant_stops("UI_CHOICES_WITNESS", "UiCarriersChoicesWitness.stdout", [String]{"aria-tag"}, " ", "UI choices: ownership and record-variant stop byte-identical")
    if key == "key" {
        cases: [Case]{ownership("UiKeyWitness.stdout"), stop("key-tag", 70, SHARED_STOP)}
        return Witness{operands: "OUT UI_KEY_WITNESS", oracle: true, cases: cases, timeout: 300s, exit_gap: " ", done: "UI Key: exhaustive real-provider oracle and record-variant stop byte-identical"}
    }
    Witness{operands: "", oracle: false, cases: [Case]{}, timeout: 0s, exit_gap: "", done: ""}
}

fail: fn(message: String) -[IO]> Int Never! {
    term.eprint(message)
    1
}

// An absolute path with `.`, `..` and empty segments folded, as path.resolve gives.
resolve: fn(cwd: String, path: String) -> String Never! {
    full: if path.starts_with("/") -> path.copy() else -> "{cwd}/{path}"
    parts := [String]{}
    loop part in full.split("/").to_list() {
        if part == ".." {
            if parts.len() > 0 {
                kept := [String]{}
                loop index in 0..<parts.len() - 1 {
                    kept.push(parts[index].copy())
                }
                parts = kept
            }
        } else if part != "" && part != "." {
            parts.push(part.copy())
        }
    }
    "/{parts.join("/")}"
}

same_bytes: fn(left: [U8], right: [U8]) -> Bool Never! {
    if left.len() != right.len() -> return false
    loop index in 0..<left.len() {
        if left[index] != right[index] -> return false
    }
    true
}

json_text: fn(text: String) -> String Never! {
    out := ""
    loop byte in text.bytes() {
        code: Int{byte}
        if code == 34 -> out = "{out}\\\""
        else if code == 92 -> out = "{out}\\\\"
        else -> out = "{out}{String.from_bytes_lossy([U8]{byte})}"
    }
    "\"{out}\""
}

signal_name: fn(number: Int) -> String Never! {
    names: [String]{"", "SIGHUP", "SIGINT", "SIGQUIT", "SIGILL", "SIGTRAP", "SIGABRT", "SIGBUS", "SIGFPE", "SIGKILL", "SIGUSR1", "SIGSEGV", "SIGUSR2", "SIGPIPE", "SIGALRM", "SIGTERM"}
    if number > 0 && number < names.len() -> return names[number].copy()
    "SIG{number}"
}

// Runs the binary within the per-run limit, and reports the run the way node's
// spawnSync does: no status after a signal, a timeout or a spawn failure, and
// spawn failures and timeouts as an error message.
run_binary: fn(binary: String, args: [String], timeout: Duration) -[Exec, FS, IO, Time.Wait]> Outcome Never! {
    none := [U8]{}
    if !files.exists(binary) -> return Outcome{stdout: none.copy(), stderr: none.copy(), status: 0, exited: false, signal: "", error: "spawnSync {binary} ENOENT"}
    argv := [String]{binary.copy()}
    loop arg in args {
        argv.push(arg.copy())
    }
    if process.cmd(argv).timeout(timeout).run() == {
        .Ok(receipt) -> {
            stdout: receipt.output.bytes()
            if receipt.timed_out -> return Outcome{stdout: stdout, stderr: receipt.errors.bytes(), status: 0, exited: false, signal: "SIGTERM", error: "spawnSync {binary} ETIMEDOUT"}
            if receipt.signal == .Val(number) -> return Outcome{stdout: stdout, stderr: receipt.errors.bytes(), status: 0, exited: false, signal: signal_name(number), error: ""}
            Outcome{stdout: stdout, stderr: receipt.errors.bytes(), status: receipt.code, exited: true, signal: "", error: ""}
        }
        .Err(error) -> {
            code: if error == .PermissionDenied(_) -> "EACCES" else if error == .NotFound(_) -> "ENOENT" else -> "{error}"
            Outcome{stdout: none.copy(), stderr: none.move(), status: 0, exited: false, signal: "", error: "spawnSync {binary} {code}"}
        }
    }
}

write_file: fn(path: String, bytes: [U8]) -[FS, IO]> Bool Never! {
    if files.write_bytes(path, bytes) == {
        .Ok(_) -> true
        .Err(error) -> {
            term.eprint("cannot write {path}: {error}")
            false
        }
    }
}

byte: fn(value: Int) -> U8 Never! { checked(U8{value}) ?? U8{0} }

hex_value: fn(text: String) -> Int Never! {
    value := 0
    loop digit in text.bytes() {
        code: Int{digit}
        value = value * 16 + (if code >= 97 -> code - 87 else if code >= 65 -> code - 55 else -> code - 48)
    }
    value
}

lower_hex: fn(value: Int) -> String Never! {
    digits: "0123456789abcdef".bytes()
    reversed := [U8]{digits[value % 16]}
    rest := value /% 16
    loop rest > 0 {
        reversed.push(digits[rest % 16])
        rest = rest /% 16
    }
    out := [U8]{}
    loop index in 0..<reversed.len() -> out.push(reversed[reversed.len() - 1 - index])
    String.from_bytes_lossy(out)
}

utf8: fn(scalar: Int) -> [U8] Never! {
    if scalar < 128 {
        return [U8]{byte(scalar)}
    }
    if scalar < 2048 {
        return [U8]{byte(192 + scalar /% 64), byte(128 + scalar % 64)}
    }
    if scalar < 65536 {
        return [U8]{byte(224 + scalar /% 4096), byte(128 + (scalar /% 64) % 64), byte(128 + scalar % 64)}
    }
    [U8]{byte(240 + scalar /% 262144), byte(128 + (scalar /% 4096) % 64), byte(128 + (scalar /% 64) % 64), byte(128 + scalar % 64)}
}

// The Debug text of one char: \t \n \r \' \\ use their short escapes, a
// scalar CharDebugPlain.ranges lists renders as itself, and every other scalar,
// NUL among them, renders as \u{hex}; all of them in single quotes.
char_debug: fn(scalar: Int, listed: Bool) -> [U8] Never! {
    short: if scalar == {
        9 -> "t"
        10 -> "n"
        13 -> "r"
        39 -> "'"
        92 -> "\\"
        else -> ""
    }
    if short != "" -> return "'\\{short}'".bytes()
    if !listed -> return "'\\u{{{lower_hex(scalar)}}}'".bytes()
    text := [U8]{byte(39)}
    loop part in utf8(scalar) -> text.push(part)
    text.push(byte(39))
    text
}

// The char Debug goldens for all 1,112,064 scalars, from the rows of
// CharDebugPlain.ranges (`hex` or `hex..hex`): each record is the u32le scalar,
// a u8 length, then the Debug bytes.
char_goldens: fn(ranges: String) -> [U8] Never! {
    starts := [Int]{}
    ends := [Int]{}
    loop row in ranges.trim().split("\n").to_list() {
        bounds: row.split("..").to_list()
        starts.push(hex_value(bounds[0]))
        ends.push(hex_value(bounds[bounds.len() - 1]))
    }
    goldens := [U8]{}
    range := 0
    loop scalar in 0..<1114112 {
        if scalar >= 55296 && scalar <= 57343 -> next
        loop range < starts.len() && ends[range] < scalar {
            range += 1
        }
        text: char_debug(scalar, range < starts.len() && starts[range] <= scalar)
        goldens.push(byte(scalar % 256))
        goldens.push(byte((scalar /% 256) % 256))
        goldens.push(byte(scalar /% 65536))
        goldens.push(byte(0))
        goldens.push(byte(text.len()))
        loop part in text -> goldens.push(part)
    }
    goldens
}

ui_witness: fn(args: [String]) -[Exec, Env, FS, IO, Time.Wait]> Int Never! {
    if args.len() == 0 -> return fail("{USAGE}\nWITNESS is one of: {WITNESSES}")
    key: args[0]
    spec: witness(key)
    if spec.cases.len() == 0 -> return fail("unknown witness: {key}\nWITNESS is one of: {WITNESSES}")
    if args.len() != 3 || args.contains("") -> return fail("usage: jet Compiler/JetRuntime/Tests/UiWitness.jet {key} {spec.operands}")
    cwd: files.cwd() ?? return fail("cannot read the working directory: {err}")
    out: resolve(cwd, args[1])
    binary: resolve(cwd, args[2])
    if files.create_dir_all(out) == {
        .Ok(_) -> {}
        .Err(error) -> return fail("cannot create {out}: {error}")
    }
    oracle: "{out}/char-debug-goldens.bin"
    if spec.oracle {
        ranges: files.read("{cwd}/{GOLDENS}/{PLAIN_RANGES}") ?? return fail("cannot read {GOLDENS}/{PLAIN_RANGES}: {err}")
        goldens: char_goldens(ranges)
        if crypto.sha256(goldens.copy()).hex() != ORACLE_SHA256 -> return fail("char Debug goldens differ from the frozen bytes")
        if !write_file(oracle, goldens) -> return 1
    }
    loop item in spec.cases {
        run_args := item.args.copy()
        if spec.oracle && item.status == 0 {
            run_args = [String]{oracle.copy()}
        }
        outcome: run_binary(binary, run_args, spec.timeout)
        status: if outcome.exited -> "{outcome.status}" else -> "null"
        signal: if outcome.signal == "" -> "null" else -> json_text(outcome.signal)
        error: if outcome.error == "" -> "null" else -> json_text(outcome.error)
        if !write_file("{out}/{item.name}.stdout", outcome.stdout) -> return 1
        if !write_file("{out}/{item.name}.stderr", outcome.stderr) -> return 1
        if !write_file("{out}/{item.name}.status.json", "{{\"status\":{status},\"signal\":{signal},\"error\":{error}}}\n".bytes()) -> return 1
        if outcome.error != "" || outcome.signal != "" || !outcome.exited || outcome.status != item.status {
            shown_signal: if outcome.signal == "" -> "null" else -> outcome.signal
            return fail("{item.name}: expected exit{spec.exit_gap}{item.status}, got {status}/{shown_signal}/{outcome.error}")
        }
        golden_path: "{cwd}/{GOLDENS}/{item.golden}"
        expected := if files.read_bytes(golden_path) == {
            .Ok(value) -> value
            .Err(_) -> { return fail("ENOENT: no such file or directory, open '{golden_path}'") }
        }
        want_stdout: if item.status == 0 -> expected.copy() else -> [U8]{}
        want_stderr: if item.status == 0 -> [U8]{} else -> expected.move()
        if !same_bytes(outcome.stdout, want_stdout) || !same_bytes(outcome.stderr, want_stderr) -> return fail("{item.name}: {OUTPUT_MISMATCH}")
    }
    print(spec.done)
    0
}

run: fn() {
    code: ui_witness(process.args())
    if code != 0 -> process.exit(code)
}

#Test("every witness names its cases and the shared stops") {
    assert_eq(witness("choices").cases.len(), 2)
    assert_eq(witness("choices").cases[1].name, "aria-tag")
    assert_eq(witness("choices").cases[1].golden, "DataPlotStops-getter-variant.stderr")
    assert_eq(witness("key").cases[1].status, 70)
    assert_eq(witness("nope").cases.len(), 0)
    assert_eq(resolve("/a/b", "../c/./d//e"), "/a/c/d/e")
    assert_eq(String.from_bytes_lossy(char_debug(65, true)), "'A'")
    assert_eq(String.from_bytes_lossy(char_debug(39, true)), "'\\''")
    assert_eq(String.from_bytes_lossy(char_debug(127, false)), "'\\u{{7f}}'")
    assert_eq(String.from_bytes_lossy(char_debug(0, false)), "'\\u{{0}}'")
    assert_eq(utf8(8364).len(), 3)
    assert_eq(hex_value("10FFFF"), 1114111)
    assert_eq(resolve("/a", "/x/../y"), "/y")
}
