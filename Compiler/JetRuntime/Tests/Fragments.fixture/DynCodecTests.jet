// Direct provider fixture: all scalar C input rails, owned output lifetime,
// FieldError path framing and the strict parser's exact number/error contract.
fn codec_fixture_number(tree: I64, expected: I64) -> Bool {
    kind :: data_tree_word(tree + DATA_TREE_TAG)
    text :: jet_rt_handle_show_dyn(tree)
    same :: kind == DATA_TREE_INT && jet_rt_string_eq(text, expected)
    jet_rt_string_drop(text)
    jet_rt_handle_drop_dyn(tree)
    same
}
#Export(c) fn jet_rt_dyn_codec_fixture() -> I64 {
    if !codec_fixture_number(jet_rt_codec_encode_u8(I64{-1}), rt_static_text("255")) -> return I64{1}
    if !codec_fixture_number(jet_rt_codec_encode_u16(I64{-1}), rt_static_text("65535")) -> return I64{2}
    if !codec_fixture_number(jet_rt_codec_encode_u32(I64{-1}), rt_static_text("4294967295")) -> return I64{3}
    if !codec_fixture_number(jet_rt_codec_encode_u64(I64{-1}), rt_static_text("18446744073709551615")) -> return I64{4}
    if !codec_fixture_number(jet_rt_codec_encode_u64(I64{-9223372036854775808}), rt_static_text("9223372036854775808")) -> return I64{5}
    if !codec_fixture_number(jet_rt_codec_encode_i8(I64{255}), rt_static_text("-1")) -> return I64{6}
    if !codec_fixture_number(jet_rt_codec_encode_i16(I64{32768}), rt_static_text("-32768")) -> return I64{7}
    if !codec_fixture_number(jet_rt_codec_encode_i32(I64{2147483648}), rt_static_text("-2147483648")) -> return I64{8}
    if !codec_fixture_number(jet_rt_codec_encode_i64(I64{-9223372036854775808}), rt_static_text("-9223372036854775808")) -> return I64{9}
    exact :: jet_int_owned_from_i64(I64{9223372036854775807})
    owned :: jet_rt_codec_encode_int(exact)
    jet_rt_int_drop(exact)
    if !codec_fixture_number(owned, rt_static_text("9223372036854775807")) -> return I64{10}
    boolean :: jet_rt_codec_encode_bool(U8{2})
    if (data_tree_word(boolean + DATA_TREE_TAG) != DATA_TREE_BOOL || data_tree_word(boolean + DATA_TREE_PAYLOAD) != I64{1}) -> return I64{11}
    jet_rt_handle_drop_dyn(boolean)
    real :: jet_rt_codec_encode_float(Float{-0.0})
    if (data_tree_word(real + DATA_TREE_TAG) != DATA_TREE_FLOAT || data_tree_word(real + DATA_TREE_PAYLOAD) != I64{-9223372036854775808}) -> return I64{12}
    jet_rt_handle_drop_dyn(real)
    text :: jet_rt_string_clone(rt_static_text("é"))
    string_tree :: jet_rt_codec_encode_string(text)
    typed_tree :: jet_raw_typed_text(text)
    jet_rt_string_drop(text)
    if (!jet_rt_handle_eq_dyn(string_tree, typed_tree) || !jet_rt_string_eq(data_tree_word(string_tree + DATA_TREE_PAYLOAD), rt_static_text("é"))) -> return I64{13}
    jet_rt_handle_drop_dyn(string_tree)
    jet_rt_handle_drop_dyn(typed_tree)
    scalar :: jet_rt_codec_encode_char(I64{119070})
    replacement :: jet_rt_codec_encode_char(I64{55296})
    if (!jet_rt_string_eq(data_tree_word(scalar + DATA_TREE_PAYLOAD), rt_static_text("𝄞")) || !jet_rt_string_eq(data_tree_word(replacement + DATA_TREE_PAYLOAD), rt_static_text("�"))) -> return I64{14}
    jet_rt_handle_drop_dyn(scalar)
    jet_rt_handle_drop_dyn(replacement)
    slots :: jet_rt_alloc(I64{32}, I64{8})
    source :: jet_rt_alloc(I64{24}, I64{8})
    text_glue_store(source, jet_rt_record_new_field_error(rt_static_text(""), rt_static_text("first")))
    text_glue_store(source + I64{8}, jet_rt_record_new_field_error(rt_static_text("[1].name"), rt_static_text("second")))
    text_glue_store(source + I64{16}, jet_rt_record_new_field_error(rt_static_text("name"), rt_static_text("third")))
    if (jet_rt_codec_under(rt_static_text("items"), source, I64{3}, slots) != I64{3}) -> return I64{15}
    framed :: text_glue_word(slots)
    if (!jet_rt_string_eq(text_glue_word(text_glue_word(framed) + TEXT_FIELD_PATH), rt_static_text("items")) || !jet_rt_string_eq(text_glue_word(text_glue_word(framed + I64{8}) + TEXT_FIELD_PATH), rt_static_text("items[1].name")) || !jet_rt_string_eq(text_glue_word(text_glue_word(framed + I64{16}) + TEXT_FIELD_PATH), rt_static_text("items.name"))) -> return I64{16}
    if (!jet_rt_string_eq(text_glue_word(text_glue_word(source) + TEXT_FIELD_PATH), rt_static_text("")) || !jet_rt_string_eq(text_glue_word(text_glue_word(framed + I64{8}) + TEXT_FIELD_REASON), rt_static_text("second"))) -> return I64{17}
    at := I64{0}
    loop at < (I64{3}) {
        jet_rt_handle_drop_field_error(text_glue_word(source + at * I64{8}))
        jet_rt_handle_drop_field_error(text_glue_word(framed + at * I64{8}))
        at += I64{1}
    }
    jet_rt_free(source, I64{24}, I64{8})
    jet_rt_free(framed, I64{24}, I64{8})
    if (jet_rt_codec_under(rt_static_text("x"), I64{0}, I64{0}, slots) != I64{0} || text_glue_word(slots) != I64{0}) -> return I64{18}
    text_glue_store(slots + I64{8}, I64{724})
    text_glue_store(slots + I64{16}, I64{725})
    if (jet_rt_codec_parse_json(rt_static_text("1e400"), slots, slots + I64{8}, slots + I64{16}) != I64{1}) -> return I64{19}
    if (text_glue_word(slots + I64{8}) != I64{724} || text_glue_word(slots + I64{16}) != I64{725}) -> return I64{23}
    parsed :: text_glue_word(slots)
    if (data_tree_word(parsed + DATA_TREE_TAG) != DATA_TREE_NUMBER || !jet_rt_string_eq(data_tree_word(parsed + DATA_TREE_PAYLOAD), rt_static_text("1e400"))) -> return I64{20}
    jet_rt_handle_drop_dyn(parsed)
    text_glue_store(slots, I64{723})
    if (jet_rt_codec_parse_json(rt_static_text("\n?"), slots, slots + I64{8}, slots + I64{16}) != I64{0} || text_glue_word(slots + I64{16}) != I64{1}) -> return I64{21}
    if (text_glue_word(slots) != I64{723}) -> return I64{24}
    errors :: text_glue_word(slots + I64{8})
    error :: text_glue_word(errors)
    if (!jet_rt_string_eq(text_glue_word(error + TEXT_FIELD_PATH), rt_static_text("")) || !jet_rt_string_eq(text_glue_word(error + TEXT_FIELD_REASON), rt_static_text("invalid JSON (line 2): expected a JSON value"))) -> return I64{22}
    jet_rt_handle_drop_field_error(error)
    jet_rt_free(errors, I64{8}, I64{8})
    jet_rt_free(slots, I64{32}, I64{8})
    codec_fixture_decode()
}

// One adapter failure: status 0, exactly one FieldError at the empty path
// with `reason`; releases it.
fn codec_fixture_rejects(status: I64, slots: I64, reason: I64) -> Bool {
    if (status != I64{0} || text_glue_word(slots + I64{8}) != I64{1}) -> return false
    errors :: text_glue_word(slots)
    error :: text_glue_word(errors)
    same :: jet_rt_string_eq(text_glue_word(error + TEXT_FIELD_PATH), rt_static_text("")) && jet_rt_string_eq(text_glue_word(error + TEXT_FIELD_REASON), reason)
    jet_rt_handle_drop_field_error(error)
    jet_rt_free(errors, I64{8}, I64{8})
    same
}

// Scalar Decode adapters (JetStd/Dyn.rs decode_* and EncodingTraits.rs):
// value carriers, exact-number projection, and the Rust failure texts.
fn codec_fixture_decode() -> I64 {
    slots :: jet_rt_alloc(I64{16}, I64{8})
    number :: jet_rt_record_new_dyn_number(rt_static_text("1.50e1"))
    if (jet_rt_codec_decode_i64(number, slots, slots, slots + I64{8}) != I64{1} || text_glue_word(slots) != I64{15}) -> return I64{30}
    exact :: jet_rt_record_new_dyn_number(rt_static_text("-2e20"))
    if (jet_rt_codec_decode_int(exact, slots, slots, slots + I64{8}) != I64{1}) -> return I64{31}
    big :: text_glue_word(slots)
    shown :: jet_rt_int_to_string(big)
    if !jet_rt_string_eq(shown, rt_static_text("-200000000000000000000")) -> return I64{32}
    jet_rt_string_drop(shown)
    jet_rt_int_drop(big)
    if !codec_fixture_rejects(jet_rt_codec_decode_i64(exact, slots, slots, slots + I64{8}), slots, rt_static_text("expected I64, found out-of-range Int")) -> return I64{33}
    jet_rt_handle_drop_dyn(exact)
    jet_rt_handle_drop_dyn(number)
    half :: jet_rt_record_new_dyn_number(rt_static_text("1.5"))
    if !codec_fixture_rejects(jet_rt_codec_decode_u8(half, slots, slots, slots + I64{8}), slots, rt_static_text("JSON number `1.5` is not an exact integer")) -> return I64{34}
    jet_rt_handle_drop_dyn(half)
    huge :: jet_rt_record_new_dyn_number(rt_static_text("1e400"))
    if !codec_fixture_rejects(jet_rt_codec_decode_float(huge, slots, slots, slots + I64{8}), slots, rt_static_text("expected Float, found out-of-range number 1e400")) -> return I64{35}
    if !codec_fixture_rejects(jet_rt_codec_decode_string(huge, slots, slots, slots + I64{8}), slots, rt_static_text("expected Text, found number 1e400")) -> return I64{36}
    if !codec_fixture_rejects(jet_rt_codec_decode_bool(huge, slots, slots, slots + I64{8}), slots, rt_static_text("expected Bool, found number")) -> return I64{37}
    jet_rt_handle_drop_dyn(huge)
    word :: jet_rt_record_new_dyn_int(I64{256})
    if !codec_fixture_rejects(jet_rt_codec_decode_u8(word, slots, slots, slots + I64{8}), slots, rt_static_text("expected U8, found out-of-range Int")) -> return I64{38}
    if (jet_rt_codec_decode_u16(word, slots, slots, slots + I64{8}) != I64{1} || text_glue_word(slots) != I64{256}) -> return I64{39}
    jet_rt_handle_drop_dyn(word)
    real :: jet_rt_record_new_dyn_float(Float{-3.0})
    if (jet_rt_codec_decode_i8(real, slots, slots, slots + I64{8}) != I64{1} || text_glue_word(slots) != I64{-3}) -> return I64{40}
    jet_rt_handle_drop_dyn(real)
    fraction :: jet_rt_record_new_dyn_float(Float{0.5})
    if !codec_fixture_rejects(jet_rt_codec_decode_int(fraction, slots, slots, slots + I64{8}), slots, rt_static_text("expected Int, found Float")) -> return I64{41}
    jet_rt_handle_drop_dyn(fraction)
    quoted :: jet_rt_record_new_dyn_text(rt_static_text("4\"2"))
    if !codec_fixture_rejects(jet_rt_codec_decode_int(quoted, slots, slots, slots + I64{8}), slots, rt_static_text("expected Int, found text \"4\\\"2\"")) -> return I64{42}
    if !codec_fixture_rejects(jet_rt_codec_decode_char(quoted, slots, slots, slots + I64{8}), slots, rt_static_text("expected a single Char, found \"4\\\"2\"")) -> return I64{43}
    jet_rt_handle_drop_dyn(quoted)
    clef :: jet_rt_record_new_dyn_text(rt_static_text("𝄞"))
    if (jet_rt_codec_decode_char(clef, slots, slots, slots + I64{8}) != I64{1} || text_glue_word(slots) != I64{119070}) -> return I64{44}
    if (jet_rt_codec_decode_string(clef, slots, slots, slots + I64{8}) != I64{1} || !jet_rt_string_eq(text_glue_word(slots), rt_static_text("𝄞"))) -> return I64{45}
    jet_rt_string_drop(text_glue_word(slots))
    jet_rt_handle_drop_dyn(clef)
    truth :: jet_rt_record_new_dyn_bool(true)
    text_glue_store(slots, I64{0})
    if (jet_rt_codec_decode_bool(truth, slots, slots, slots + I64{8}) != I64{1} || text_glue_word(slots) != I64{1}) -> return I64{46}
    if !codec_fixture_rejects(jet_rt_codec_decode_float(truth, slots, slots, slots + I64{8}), slots, rt_static_text("expected Float, found Bool")) -> return I64{47}
    jet_rt_handle_drop_dyn(truth)
    absent :: jet_rt_record_new_dyn_null()
    if !codec_fixture_rejects(jet_rt_codec_decode_string(absent, slots, slots, slots + I64{8}), slots, rt_static_text("expected Text, found null")) -> return I64{48}
    jet_rt_handle_drop_dyn(absent)
    jet_rt_free(slots, I64{16}, I64{8})
    codec_fixture_text_cells()
}

// JetStd/Dyn.rs text-cell scope: only inside it does a Text leaf parse into
// Int, Float or Bool (trimmed); leaving restores the previous state.
fn codec_fixture_text_cells() -> I64 {
    jet_rt_codec_text_cells_init()
    slots :: jet_rt_alloc(I64{16}, I64{8})
    cell :: jet_rt_record_new_dyn_text(rt_static_text(" 42 "))
    if !codec_fixture_rejects(jet_rt_codec_decode_i64(cell, slots, slots, slots + I64{8}), slots, rt_static_text("expected Int, found text \" 42 \"")) -> return I64{60}
    outer :: jet_rt_codec_text_cells_enter()
    if (outer != I64{0}) -> return I64{61}
    inner :: jet_rt_codec_text_cells_enter()
    if (jet_rt_codec_decode_i64(cell, slots, slots, slots + I64{8}) != I64{1} || text_glue_word(slots) != I64{42}) -> return I64{62}
    jet_rt_codec_text_cells_leave(inner)
    if (jet_rt_codec_decode_int(cell, slots, slots, slots + I64{8}) != I64{1} || text_glue_word(slots) != I64{42}) -> return I64{63}
    if (jet_rt_codec_decode_float(cell, slots, slots, slots + I64{8}) != I64{1} || rt_f64_from_bits(text_glue_word(slots)) != Float{42.0}) -> return I64{64}
    if !codec_fixture_rejects(jet_rt_codec_decode_i8(cell, slots, slots, slots + I64{8}), slots, rt_static_text("expected I8, found out-of-range Int")) -> return I64{65}
    if !codec_fixture_rejects(jet_rt_codec_decode_bool(cell, slots, slots, slots + I64{8}), slots, rt_static_text("expected Bool, found text \" 42 \"")) -> return I64{66}
    if (jet_rt_codec_decode_string(cell, slots, slots, slots + I64{8}) != I64{1} || !jet_rt_string_eq(text_glue_word(slots), rt_static_text(" 42 "))) -> return I64{67}
    jet_rt_string_drop(text_glue_word(slots))
    jet_rt_handle_drop_dyn(cell)
    big :: jet_rt_record_new_dyn_text(rt_static_text("300"))
    if !codec_fixture_rejects(jet_rt_codec_decode_u8(big, slots, slots, slots + I64{8}), slots, rt_static_text("expected U8, found out-of-range Int")) -> return I64{68}
    jet_rt_handle_drop_dyn(big)
    infinite :: jet_rt_record_new_dyn_text(rt_static_text("inf"))
    if !codec_fixture_rejects(jet_rt_codec_decode_float(infinite, slots, slots, slots + I64{8}), slots, rt_static_text("expected Float, found text \"inf\"")) -> return I64{69}
    if !codec_fixture_rejects(jet_rt_codec_decode_int(infinite, slots, slots, slots + I64{8}), slots, rt_static_text("expected Int, found text \"inf\"")) -> return I64{70}
    jet_rt_handle_drop_dyn(infinite)
    truth :: jet_rt_record_new_dyn_text(rt_static_text("\ttrue "))
    text_glue_store(slots, I64{0})
    if (jet_rt_codec_decode_bool(truth, slots, slots, slots + I64{8}) != I64{1} || text_glue_word(slots) != I64{1}) -> return I64{71}
    jet_rt_handle_drop_dyn(truth)
    jet_rt_codec_text_cells_leave(outer)
    falsity :: jet_rt_record_new_dyn_text(rt_static_text("false"))
    if !codec_fixture_rejects(jet_rt_codec_decode_bool(falsity, slots, slots, slots + I64{8}), slots, rt_static_text("expected Bool, found text \"false\"")) -> return I64{72}
    jet_rt_handle_drop_dyn(falsity)
    jet_rt_free(slots, I64{16}, I64{8})
    I64{0}
}
