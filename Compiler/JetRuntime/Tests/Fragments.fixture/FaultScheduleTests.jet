// One TLS schedule: ancestor counts, selected-only injection, allocation rail,
// saturation, shared sticky injected, and cleanup use the real provider.
#Export(c) fn jet_rt_fault_schedule_fixture() -> I64 {
    selectors :: jet_rt_alloc(I64{24}, I64{8})
    trap_store(selectors, rt_static_text("IO"))
    trap_store(selectors + I64{8}, rt_static_text("IO.Write"))
    trap_store(selectors + I64{16}, rt_static_text("IO.Flush"))
    fault_schedule_arm(selectors, I64{3}, I64{1}, I64{2})
    if jet_fault_should_fail(rt_static_text("IO.Writer")) -> return I64{1}
    if jet_fault_should_fail(rt_static_text("IO.Write")) -> return I64{2}
    if !jet_fault_should_fail(rt_static_text("IO.Write.More")) -> return I64{3}
    if jet_fault_should_fail(rt_static_text("IO.Flush")) -> return I64{4}
    state :: fault_allocation_state()
    rows :: trap_word(state + I64{40})
    if (trap_word(rows + I64{8}) != I64{4} || trap_word(rows + I64{24}) != I64{2} || trap_word(rows + I64{40}) != I64{1}) -> return I64{5}
    if (jet_rt_fault_allocation_fact(I64{1}) != I64{1}) -> return I64{6}
    if jet_fault_should_fail_allocation() -> return I64{7}
    if (jet_rt_fault_allocation_fact(I64{0}) != I64{1}) -> return I64{8}
    fault_schedule_arm(selectors, I64{3}, I64{3}, I64{1})
    if jet_fault_should_fail(rt_static_text("IO.Write")) -> return I64{9}
    if !jet_fault_should_fail_allocation() -> return I64{10}
    if jet_fault_should_fail_allocation() -> return I64{11}
    fault_schedule_arm(selectors, I64{3}, I64{-1}, I64{0})
    if jet_fault_should_fail(rt_static_text("IO.Flush")) -> return I64{12}
    trap_store(trap_word(state + I64{40}) + I64{8}, I64{-1})
    _ := jet_fault_should_fail(rt_static_text("IO.Write"))
    if (trap_word(trap_word(state + I64{40}) + I64{8}) != I64{-1}) -> return I64{13}
    jet_rt_fault_allocation_clear()
    jet_rt_free(selectors, I64{24}, I64{8})
    if jet_fault_should_fail(rt_static_text("IO.Write")) || jet_fault_should_fail_allocation() -> return I64{14}
    I64{0}
}
