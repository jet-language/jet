}
#Export(c) fn linux_openat2_rejects_a_symlinked_vault_directory(root: I64, name: I64, empty: I64) {
    slots :: jet_rt_alloc(I64{8}, I64{8})
    error :: vault_prepare_at_root(root, name, I64{1}, I64{1}, I64{0}, I64{0}, jet_rt_string_clone(empty), slots)
    if (error == I64{0}) -> panic("symlinked .jet directory was accepted")
    vault_fixture_error(error, I64{7})
