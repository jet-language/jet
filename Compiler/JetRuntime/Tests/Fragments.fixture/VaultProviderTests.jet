}
#Export(c) fn jet_rt_vault_fixture_guard(root: I64, plan: I64, out: I64) {
    vault_fixture_check(vault_acquire_lock(root, plan + VAULT_PLAN_UUID, rt_text_word(plan + VAULT_PLAN_REVISION), plan + VAULT_PLAN_START_HASH, out) == I64{0})
    vault_plan_drop(plan)
