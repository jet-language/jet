    vault_fixture_check(rt_text_byte(guard + VAULT_LOCK_NONCE) == I64{171})
    jet_rt_vault_set_test_fault(fault)
    vault_lock_drop(guard)
    jet_rt_vault_set_test_fault(I64{0})
    // F_GETFD proves ownership closed both real descriptors on either path.
    vault_fixture_check(trap_syscall(I64{72}, dir, I64{1}, I64{0}, I64{0}, I64{0}, I64{0}) == I64{-9})
    vault_fixture_check(trap_syscall(I64{72}, file, I64{1}, I64{0}, I64{0}, I64{0}, I64{0}) == I64{-9})
    thread_zero(scratch, I64{368})
    jet_rt_free(scratch, I64{368}, I64{8})
}

