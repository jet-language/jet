    next :: rt_text_data(rt_text_word(data + I64{8}))
    final_name :: rt_text_data(rt_text_word(data + I64{16}))
    lock_name :: rt_text_data(rt_text_word(data + I64{24}))
    quarantine :: rt_text_data(rt_text_word(data + I64{32}))
    acquired :: rt_text_data(rt_text_word(data + I64{40}))
