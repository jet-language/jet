    plan :: vault_fixture_prepare(root, name, I64{1}, I64{1}, I64{0}, empty, out)
    write :: vault_fixture_authorize(plan, I64{1}, reason, out + I64{8})
    rt_text_store(out, plan)
    rt_text_store(out + I64{8}, write)
}
