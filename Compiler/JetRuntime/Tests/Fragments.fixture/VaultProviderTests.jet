}
#Export(c) fn string_updates_preserve_typed_rows_in_the_shared_atomic_store(root: I64, name: I64, empty: I64, reason: I64, token: I64, value: I64) {
    slots :: jet_rt_alloc(I64{64}, I64{8})
    reference :: vault_fixture_generate(root, name, empty, reason, slots)
    pairs :: data_sequence_new(I64{1}, VAULT_PAIR_BYTES)
    pair :: rt_text_word(pairs + DATA_SEQUENCE_DATA)
    rt_text_store(pair, jet_rt_string_clone(token))
    rt_text_store(pair + I64{8}, jet_rt_string_clone(value))
    rt_text_store(pairs + DATA_SEQUENCE_LENGTH, I64{1})
    vault_fixture_check(vault_replace_strings_at_root(root, pairs) == I64{0})
    store :: vault_fixture_decoded(root, slots)
    vault_fixture_check(rt_text_word(store + VAULT_STORE_REVISION) == I64{2})
    strings :: rt_text_word(store + VAULT_STORE_STRINGS)
    vault_fixture_check(rt_text_word(strings + DATA_SEQUENCE_LENGTH) == I64{1})
    row :: rt_text_word(strings + DATA_SEQUENCE_DATA)
    vault_fixture_check(jet_rt_string_eq(rt_text_word(row), token) && jet_rt_string_eq(rt_text_word(row + I64{8}), value))
    vault_fixture_check(rt_text_word(rt_text_word(store + VAULT_STORE_RECORDS) + DATA_SEQUENCE_LENGTH) == I64{1})
    vault_fixture_load(root, reference, slots)
    vault_store_drop(store)
    vault_ref_drop(reference)
    jet_rt_vault_clear_test_authorizer()
    jet_rt_free(slots, I64{64}, I64{8})
}
#Export(c) fn lifecycle_timestamps_do_not_decrease_when_wall_clock_rolls_back(root: I64, name: I64, empty: I64, reason: I64, rotation: I64, fault: I64) {
    slots :: jet_rt_alloc(I64{64}, I64{8})
    reference :: vault_fixture_generate(root, name, empty, reason, slots)
    vault_ref_drop(reference)
    before_store :: vault_fixture_decoded(root, slots)
    before_data :: rt_text_word(rt_text_word(before_store + VAULT_STORE_RECORDS) + DATA_SEQUENCE_DATA)
    before :: rt_text_word(rt_text_word(before_data) + VAULT_RECORD_CREATED)
    vault_store_drop(before_store)
    plan :: vault_fixture_prepare(root, name, I64{1}, I64{3}, I64{0}, empty, slots)
    write :: vault_fixture_authorize(plan, I64{1}, rotation, slots)
    jet_rt_vault_set_test_fault(fault)
    vault_fixture_check(vault_commit_at_root(root, plan, write, I64{3}, I64{1}, slots, slots + I64{8}) == I64{0})
    vault_ref_drop(rt_text_word(slots))
    vault_ref_drop(rt_text_word(slots + I64{8}))
    store :: vault_fixture_decoded(root, slots)
    data :: rt_text_word(rt_text_word(store + VAULT_STORE_RECORDS) + DATA_SEQUENCE_DATA)
    status :: rt_text_word(rt_text_word(data) + VAULT_RECORD_STATUS_MS)
    created :: rt_text_word(rt_text_word(data + I64{8}) + VAULT_RECORD_CREATED)
    vault_fixture_check(!vault_unsigned_less(status, before))
    vault_fixture_check(!vault_unsigned_less(created, status))
    vault_store_drop(store)
    jet_rt_vault_set_test_fault(I64{0})
    jet_rt_vault_clear_test_authorizer()
    jet_rt_free(slots, I64{64}, I64{8})
}
#Export(c) fn decoder_rejects_a_downgraded_current_generation(root: I64, name: I64, empty: I64, first_reason: I64, second_reason: I64) {
    slots :: jet_rt_alloc(I64{64}, I64{8})
    reference :: vault_fixture_generate(root, name, empty, first_reason, slots)
    vault_ref_drop(reference)
    plan :: vault_fixture_prepare(root, name, I64{1}, I64{3}, I64{0}, empty, slots)
    write :: vault_fixture_authorize(plan, I64{1}, second_reason, slots)
    vault_fixture_check(vault_commit_at_root(root, plan, write, I64{3}, I64{1}, slots, slots + I64{8}) == I64{0})
    vault_ref_drop(rt_text_word(slots))
    vault_ref_drop(rt_text_word(slots + I64{8}))
    store :: vault_fixture_decoded(root, slots)
    vault_fixture_check(vault_encode_v2(store, slots) == I64{-1})
    bytes :: rt_text_word(slots)
    raw :: rt_text_data(bytes)
    length :: rt_text_len(bytes)
    vault_put_u64(raw + I64{47} + rt_text_len(name), I64{1})
    scratch :: jet_rt_alloc(I64{592}, I64{8})
    vault_payload_hash(raw, length - I64{32}, raw + length - I64{32}, scratch)
    vault_fixture_check(vault_decode_v2(raw, length, slots + I64{8}) == I64{8})
    vault_store_drop(store)
    vault_text_zero(bytes)
    jet_rt_string_drop(bytes)
    thread_zero(scratch, I64{592})
    jet_rt_free(scratch, I64{592}, I64{8})
    jet_rt_vault_clear_test_authorizer()
    jet_rt_free(slots, I64{64}, I64{8})
}

#Export(c) fn jet_rt_vault_fixture_import_plan(root: I64, name: I64, empty: I64, out: I64) {
    // Real signing-key generation uses the shared default entropy provider.
    key :: data_sequence_new(I64{32}, RT_HOST_U8_STRIDE)
    vault_fixture_check(rt_crypto_entropy_fill(rt_text_word(key + DATA_SEQUENCE_DATA), I64{32}) == I64{0})
    rt_text_store(key + DATA_SEQUENCE_LENGTH, I64{32})
    vault_fixture_check(vault_prepare_at_root(root, name, I64{1}, I64{2}, I64{0}, key, jet_rt_string_clone(empty), out) == I64{0})
}
fn vault_fixture_stream_hash(stream: I64, expected: I64) {
    scratch :: jet_rt_alloc(I64{608}, I64{8})
    rt_sha256_parts(rt_text_data(stream), rt_text_len(stream), I64{1}, I64{0}, scratch + I64{576}, scratch)
    vault_fixture_check(rt_text_equal_bytes(scratch + I64{576}, expected, I64{32}))
    thread_zero(scratch, I64{608})
    jet_rt_free(scratch, I64{608}, I64{8})
}
#Export(c) fn jet_rt_vault_fixture_operation(plan: I64, operation: I64) {
    vault_fixture_stream_hash(operation, plan + VAULT_PLAN_OPERATION)
}
#Export(c) fn jet_rt_vault_fixture_binding_authorize(plan: I64, reason: I64, out: I64) {
    vault_fixture_check(vault_authorize_write(plan, I64{1}, reason, out) == I64{0})
}
#Export(c) fn exact_operation_preview_provider_and_session_are_bound(root: I64, plan: I64, write: I64, preview: I64) {
    vault_fixture_stream_hash(preview, write + VAULT_WRITE_PREVIEW)
    rt_text_store(write + VAULT_WRITE_SESSION, wrapping(rt_text_word(write + VAULT_WRITE_SESSION) + I64{1}))
    slots :: jet_rt_alloc(I64{16}, I64{8})
    vault_fixture_error(vault_commit_at_root(root, plan, write, I64{2}, I64{1}, slots, slots + I64{8}), I64{6})
    jet_rt_free(slots, I64{16}, I64{8})
}
#Export(c) fn jet_rt_vault_fixture_trust(plan: I64, path: I64) {
    jet_rt_vault_set_test_trust_path(path)
    vault_fixture_check(vault_headless_granted(plan + VAULT_PLAN_UUID))
    jet_rt_vault_set_test_trust_path(I64{0})
    vault_plan_drop(plan)
    jet_rt_vault_clear_test_authorizer()
}
#Export(c) fn jet_rt_vault_fixture_legacy_cipher(recipient: I64, legacy: I64, out: I64) {
    public :: jet_rt_alloc(I64{32}, I64{8})
    vault_fixture_check(vault_crypto_decode_key(recipient, false, public))
    vault_fixture_check(vault_crypto_encrypt(public, I64{1}, legacy, out) == I64{0})
    thread_zero(public, I64{32})
    jet_rt_free(public, I64{32}, I64{8})
}
#Export(c) fn jet_rt_vault_fixture_bytes_drop(bytes: I64) { vault_imported_drop(bytes) }
#Export(c) fn historical_pairs_migrate_with_the_previewed_uuid_and_exact_start_hash(root: I64, name: I64, empty: I64, reason: I64, token: I64, value: I64, starting_stream: I64) {
    slots :: jet_rt_alloc(I64{80}, I64{8})
    plan :: vault_fixture_prepare(root, name, I64{1}, I64{1}, I64{0}, empty, slots)
    vault_fixture_check(rt_text_word(plan + VAULT_PLAN_REVISION) == I64{0})
    vault_fixture_stream_hash(starting_stream, plan + VAULT_PLAN_START_HASH)
    rt_text_bytes_copy(slots + I64{64}, plan + VAULT_PLAN_UUID, I64{16})
    write :: vault_fixture_authorize(plan, I64{1}, reason, slots)
    vault_fixture_check(vault_commit_at_root(root, plan, write, I64{1}, I64{1}, slots, slots + I64{8}) == I64{0})
    reference :: rt_text_word(slots + I64{8})
    store :: vault_fixture_decoded(root, slots)
    vault_fixture_check(rt_text_word(store + VAULT_STORE_REVISION) == I64{1})
    vault_fixture_check(rt_text_equal_bytes(store + VAULT_STORE_UUID, slots + I64{64}, I64{16}))
    vault_fixture_check(rt_text_equal_bytes(reference + VAULT_REF_UUID, slots + I64{64}, I64{16}))
    strings :: rt_text_word(store + VAULT_STORE_STRINGS)
    vault_fixture_check(rt_text_word(strings + DATA_SEQUENCE_LENGTH) == I64{1})
    pair :: rt_text_word(strings + DATA_SEQUENCE_DATA)
    vault_fixture_check(jet_rt_string_eq(rt_text_word(pair), token) && jet_rt_string_eq(rt_text_word(pair + I64{8}), value))
    vault_store_drop(store)
    vault_ref_drop(reference)
    jet_rt_vault_clear_test_authorizer()
    thread_zero(slots, I64{80})
    jet_rt_free(slots, I64{80}, I64{8})
}
#Export(c) fn jet_rt_vault_fixture_generate_plan(root: I64, name: I64, empty: I64, out: I64) {
    rt_text_store(out, vault_fixture_prepare(root, name, I64{1}, I64{1}, I64{0}, empty, out))
}

#Export(c) fn jet_rt_vault_fixture_fault_commit(root: I64, name: I64, empty: I64, reason: I64, fault: I64, expected: I64, out: I64) {
    slots :: jet_rt_alloc(I64{16}, I64{8})
    plan :: vault_fixture_prepare(root, name, I64{1}, I64{1}, I64{0}, empty, slots)
    write :: vault_fixture_authorize(plan, I64{1}, reason, slots)
    jet_rt_vault_set_test_fault(fault)
    error :: vault_commit_at_root(root, plan, write, I64{1}, I64{1}, slots, slots + I64{8})
    if (expected < I64{0}) {
        vault_fixture_check(error == I64{0})
        reference :: rt_text_word(slots + I64{8})
        vault_fixture_check(rt_text_word(reference + VAULT_REF_GENERATION) == I64{1})
        rt_text_store(out, reference)
    } else {
        vault_fixture_error(error, expected)
    }
    jet_rt_free(slots, I64{16}, I64{8})
}
#Export(c) fn jet_rt_vault_fixture_durability(root: I64, name: I64, empty: I64, reason: I64, fault: I64) {
    slots :: jet_rt_alloc(I64{64}, I64{8})
    plan :: vault_fixture_prepare(root, name, I64{1}, I64{3}, I64{0}, empty, slots)
    write :: vault_fixture_authorize(plan, I64{1}, reason, slots)
    jet_rt_vault_set_test_fault(fault)
    vault_fixture_error(vault_commit_at_root(root, plan, write, I64{3}, I64{1}, slots, slots + I64{8}), I64{9})
    store :: vault_fixture_decoded(root, slots)
    if (rt_text_word(store + VAULT_STORE_REVISION) != I64{2}) -> panic("installed revision is visible")
    vault_store_drop(store)
    jet_rt_free(slots, I64{64}, I64{8})
}
#Export(c) fn linux_install_cancellation_and_durability_boundaries_are_literal(root: I64, name: I64, first: I64) {
    slots :: jet_rt_alloc(I64{64}, I64{8})
    vault_fixture_check(vault_key_query_at_root(root, name, I64{1}, false, slots) == I64{0})
    current :: rt_text_word(slots)
    vault_fixture_check(current != I64{0} && vault_ref_equal(current, first))
    vault_ref_drop(current)
    store :: vault_fixture_decoded(root, slots)
    if (rt_text_word(store + VAULT_STORE_REVISION) != I64{1}) -> panic("next open restores authenticated backup")
    vault_store_drop(store)
    vault_ref_drop(first)
    jet_rt_vault_set_test_fault(I64{0})
    jet_rt_vault_clear_test_authorizer()
    jet_rt_free(slots, I64{64}, I64{8})
}
#Export(c) fn jet_rt_vault_fixture_concurrent_prepare(root: I64, name: I64, empty: I64, initial: I64, rotation: I64, out: I64) {
    slots :: jet_rt_alloc(I64{16}, I64{8})
    reference :: vault_fixture_generate(root, name, empty, initial, slots)
    vault_ref_drop(reference)
    plan :: vault_fixture_prepare(root, name, I64{1}, I64{3}, I64{0}, empty, slots)
    write :: vault_fixture_authorize(plan, I64{1}, rotation, slots)
    rt_text_store(out, plan)
    rt_text_store(out + I64{8}, write)
    jet_rt_free(slots, I64{16}, I64{8})
}
#Export(c) fn jet_rt_vault_fixture_spawn(entry: I64, argument: I64) -> I64 { thread_spawn(entry, argument) }
#Export(c) fn jet_rt_vault_fixture_join(handle: I64, out: I64) -> I64 { thread_join(handle, out) }
#Export(c) fn jet_rt_vault_fixture_rotation_worker(root: I64, plan: I64, write: I64, fault: I64) -> I64 {
    slots :: jet_rt_alloc(I64{16}, I64{8})
    jet_rt_vault_set_test_fault(fault)
    error :: vault_commit_at_root(root, plan, write, I64{3}, I64{1}, slots, slots + I64{8})
    jet_rt_vault_set_test_fault(I64{0})
    vault_fixture_error(error, I64{9})
    jet_rt_free(slots, I64{16}, I64{8})
    I64{9}
}
#Export(c) fn jet_rt_vault_fixture_reader_conflict(root: I64, name: I64) {
    slot :: jet_rt_alloc(I64{8}, I64{8})
    vault_fixture_error(vault_key_query_at_root(root, name, I64{1}, false, slot), I64{6})
    jet_rt_free(slot, I64{8}, I64{8})
}
#Export(c) fn concurrent_reader_defers_backup_recovery_until_writer_releases_lock(root: I64, name: I64, backup_bytes: I64) {
    slots :: jet_rt_alloc(I64{64}, I64{8})
    vault_fixture_check(vault_decode_ciphertext_at_root(root, backup_bytes, slots, slots + I64{8}, slots + I64{40}) == I64{0})
    old :: rt_text_word(slots)
    vault_fixture_check(rt_text_word(old + VAULT_STORE_REVISION) == I64{1})
    vault_store_drop(old)
    installed :: vault_fixture_decoded(root, slots)
    vault_fixture_check(rt_text_word(installed + VAULT_STORE_REVISION) == I64{2})
    vault_store_drop(installed)
    vault_fixture_check(vault_key_query_at_root(root, name, I64{1}, false, slots) == I64{0})
    current :: rt_text_word(slots)
    vault_fixture_check(current != I64{0} && rt_text_word(current + VAULT_REF_GENERATION) == I64{2})
    vault_ref_drop(current)
    jet_rt_vault_clear_test_authorizer()
    jet_rt_free(slots, I64{64}, I64{8})
}
#Export(c) fn stale_lock_requires_age_owner_dead_pid_nonce_and_unchanged_store(root: I64, plan: I64, reason: I64) {
    slots :: jet_rt_alloc(I64{16}, I64{8})
