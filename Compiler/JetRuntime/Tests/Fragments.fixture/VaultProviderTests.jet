// Supplemental commit boundary witness: every reject consumes both inputs,
// leaves outputs untouched and rejects before any filesystem/entropy access.
#Export(c)
fn jet_rt_vault_commit_boundary_fixture(name: I64, empty: I64, retired: I64, revoked: I64, rotation_hash: I64, retired_hash: I64, revoked_hash: I64, entropy: I64) {
    scratch :: jet_rt_alloc(I64{8256}, I64{8})
    out :: scratch + I64{8192}
    rt_text_store(scratch + I64{4232}, I64{28259048196697970})
    vault_reason_hash_bytes(I64{2}, scratch + I64{4232}, I64{7}, out, scratch)
    vault_fixture_check(rt_text_equal_bytes(out, rotation_hash, I64{32}))
    vault_fixture_check(vault_reason_hash(I64{2}, retired, out, scratch) == I64{0})
    vault_fixture_check(rt_text_equal_bytes(out, retired_hash, I64{32}))
    vault_fixture_check(vault_reason_hash(I64{3}, revoked, out, scratch) == I64{0})
    vault_fixture_check(rt_text_equal_bytes(out, revoked_hash, I64{32}))
    vault_fixture_check(vault_reason_hash(I64{1}, empty, out, scratch) == I64{0} && vault_bytes_zero(out, I64{32}))
    active_error :: vault_reason_hash(I64{1}, retired, out, scratch)
    vault_fixture_check(active_error != I64{0} && vault_error_tag(active_error) == I64{8})
    vault_error_drop(active_error)
    trial := I64{0}
    loop trial < (I64{7}) {
        plan :: jet_rt_alloc(VAULT_PLAN_BYTES, I64{8})
        write :: jet_rt_alloc(VAULT_WRITE_BYTES, I64{8})
        thread_zero(plan, VAULT_PLAN_BYTES)
        thread_zero(write, VAULT_WRITE_BYTES)
        rt_text_store(plan + VAULT_PLAN_ACTION, I64{2})
        rt_text_store(plan + VAULT_PLAN_NAME, jet_rt_string_clone(name))
        rt_text_store(plan + VAULT_PLAN_REASON, jet_rt_string_clone(empty))
        imported :: data_sequence_new(I64{32}, RT_HOST_U8_STRIDE)
        rt_text_store(imported + DATA_SEQUENCE_LENGTH, I64{32})
        thread_zero(rt_text_word(imported + DATA_SEQUENCE_DATA), I64{32})
        rt_text_store(plan + VAULT_PLAN_IMPORTED, imported)
        now :: vault_host_monotonic_ns()
        rt_text_store(plan + VAULT_PLAN_ISSUED, now)
        rt_text_store(plan + VAULT_PLAN_DEADLINE, now + I64{300000000000})
        rt_text_store(write + VAULT_WRITE_DEADLINE, now + I64{300000000000})
        rt_text_put(write + VAULT_WRITE_PREVIEW, I64{1})
        rt_text_store(write + VAULT_WRITE_USER, trap_syscall(I64{107}, I64{0}, I64{0}, I64{0}, I64{0}, I64{0}, I64{0}))
        rt_text_store(write + VAULT_WRITE_SESSION, trap_syscall(I64{124}, I64{0}, I64{0}, I64{0}, I64{0}, I64{0}, I64{0}))
        expected := I64{2}
        if {
            (trial == I64{0}) -> expected = I64{1}
            (trial == I64{1}) -> rt_text_store(plan + VAULT_PLAN_DEADLINE, I64{0})
            (trial == I64{2}) -> rt_text_store(write + VAULT_WRITE_DEADLINE, I64{0})
            (trial == I64{3}) -> rt_text_put(write + VAULT_WRITE_OPERATION, I64{1})
            (trial == I64{4}) -> thread_zero(write + VAULT_WRITE_PREVIEW, I64{32})
            (trial == I64{5}) -> rt_text_store(write + VAULT_WRITE_USER, I64{-1})
            else -> rt_text_store(write + VAULT_WRITE_SESSION, I64{-1})
        }
        previous :: scratch + I64{8224}
        current :: scratch + I64{8232}
        rt_text_store(previous, I64{91})
        rt_text_store(current, I64{92})
        rt_crypto_entropy_set(entropy, I64{0})
        error :: vault_commit_at_root(empty, plan, write, expected, I64{1}, previous, current)
        rt_crypto_entropy_clear()
        vault_fixture_check(error != I64{0} && vault_error_tag(error) == I64{6})
        vault_fixture_check(rt_text_word(previous) == I64{91} && rt_text_word(current) == I64{92})
        vault_error_drop(error)
        trial += I64{1}
    }
    thread_zero(scratch, I64{8256})
    jet_rt_free(scratch, I64{8256}, I64{8})
}

// Exact filesystem fixtures: transport creates only real directories/files.
fn vault_fixture_error(error: I64, expected: I64) {
    vault_fixture_check(error != I64{0} && vault_error_tag(error) == expected)
    vault_error_drop(error)
}
fn vault_fixture_prepare(root: I64, name: I64, kind: I64, action: I64, reference: I64, reason: I64, slots: I64) -> I64 {
    owned_reason := I64{0}
    if (action == I64{3}) {
        rt_text_store(slots, I64{28259048196697970})
        owned_reason = jet_rt_string_from_static(slots, I64{7})
    } else {
        owned_reason = jet_rt_string_clone(reason)
    }
    vault_fixture_check(vault_prepare_at_root(root, name, kind, action, reference, I64{0}, owned_reason, slots) == I64{0})
    rt_text_word(slots)
}
fn vault_fixture_authorize(plan: I64, kind: I64, reason: I64, slots: I64) -> I64 {
    vault_fixture_check(vault_authorize_write(plan, kind, reason, slots) == I64{0})
    rt_text_word(slots)
}
fn vault_fixture_generate(root: I64, name: I64, empty: I64, reason: I64, slots: I64) -> I64 {
    plan :: vault_fixture_prepare(root, name, I64{1}, I64{1}, I64{0}, empty, slots)
    write :: vault_fixture_authorize(plan, I64{1}, reason, slots)
    vault_fixture_check(vault_commit_at_root(root, plan, write, I64{1}, I64{1}, slots, slots + I64{8}) == I64{0})
    vault_fixture_check(rt_text_word(slots) == I64{0})
    rt_text_word(slots + I64{8})
}
fn vault_fixture_status(root: I64, reference: I64, expected: I64, slots: I64) {
    vault_fixture_check(vault_status_at_root(root, reference, I64{1}, slots) == I64{0})
    vault_fixture_check(rt_text_word(slots) == expected)
}
fn vault_fixture_load(root: I64, reference: I64, slots: I64) {
    vault_fixture_check(vault_load_at_root(root, reference, I64{1}, slots) == I64{0})
    vault_secret_drop(rt_text_word(slots))
}
fn vault_fixture_decoded(root: I64, slots: I64) -> I64 {
    // This is the unrecovered reader: observe the installed ciphertext directly.
    vault_fixture_check(vault_read_contents_unrecovered_at_root(root, slots, slots + I64{8}, slots + I64{40}) == I64{0})
    vault_fixture_check(rt_text_word(slots + I64{40}) == VAULT_START_V2)
    rt_text_word(slots)
}
#Export(c) fn jet_rt_vault_fixture_provision(out: I64) {
    vault_fixture_check(vault_crypto_keygen(out, out + I64{8}) == I64{0})
}
#Export(c) fn absent_store_reads_do_not_require_mutation_recipients(root: I64, name: I64) {
    slots :: jet_rt_alloc(I64{64}, I64{8})
    vault_fixture_check(vault_key_query_at_root(root, name, I64{1}, false, slots) == I64{0})
    vault_fixture_check(rt_text_word(slots) == I64{0})
    vault_fixture_check(vault_key_query_at_root(root, name, I64{1}, true, slots) == I64{0})
    versions :: rt_text_word(slots)
    vault_fixture_check(rt_text_word(versions + DATA_SEQUENCE_LENGTH) == I64{0})
    vault_refs_drop(versions)
    missing :: jet_rt_alloc(VAULT_REF_BYTES, I64{8})
    thread_zero(missing, VAULT_REF_BYTES)
    rt_text_store(missing + VAULT_REF_NAME, jet_rt_string_clone(name))
    rt_text_store(missing + VAULT_REF_GENERATION, I64{1})
    at := I64{0}
    loop at < (I64{32}) {
        if (at < I64{16}) {
            rt_text_put(missing + VAULT_REF_UUID + at, I64{1})
            rt_text_put(missing + VAULT_REF_OPAQUE + at, I64{2})
        }
        rt_text_put(missing + VAULT_REF_HASH + at, I64{3})
        at += I64{1}
    }
    vault_fixture_error(vault_load_at_root(root, missing, I64{1}, slots), I64{1})
    vault_fixture_error(vault_status_at_root(root, missing, I64{1}, slots), I64{1})
    vault_ref_drop(missing)
    jet_rt_free(slots, I64{64}, I64{8})
}
#Export(c) fn typed_generate_rotate_retire_revoke_and_conflict(root: I64, texts: I64) {
    data :: rt_text_word(texts + DATA_SEQUENCE_DATA)
    name :: rt_text_word(data)
    transport :: rt_text_word(data + I64{8})
    empty :: rt_text_word(data + I64{16})
    initial :: rt_text_word(data + I64{24})
    stale_reason :: rt_text_word(data + I64{32})
    quarterly :: rt_text_word(data + I64{40})
    exposure :: rt_text_word(data + I64{48})
    incident :: rt_text_word(data + I64{56})
    slots :: jet_rt_alloc(I64{64}, I64{8})
    plan :: vault_fixture_prepare(root, name, I64{1}, I64{1}, I64{0}, empty, slots)
    stale :: vault_fixture_prepare(root, transport, I64{2}, I64{1}, I64{0}, empty, slots)
    write :: vault_fixture_authorize(plan, I64{1}, initial, slots)
    vault_fixture_check(vault_commit_at_root(root, plan, write, I64{1}, I64{1}, slots, slots + I64{8}) == I64{0})
    first :: rt_text_word(slots + I64{8})
    vault_fixture_check(rt_text_word(first + VAULT_REF_GENERATION) == I64{1})
    vault_fixture_status(root, first, I64{0}, slots)
    vault_fixture_load(root, first, slots)
    stale_write :: vault_fixture_authorize(stale, I64{2}, stale_reason, slots)
    vault_fixture_error(vault_commit_at_root(root, stale, stale_write, I64{1}, I64{2}, slots, slots + I64{8}), I64{6})
    rotate :: vault_fixture_prepare(root, name, I64{1}, I64{3}, I64{0}, empty, slots)
    rotation_write :: vault_fixture_authorize(rotate, I64{1}, quarterly, slots)
    vault_fixture_check(vault_commit_at_root(root, rotate, rotation_write, I64{3}, I64{1}, slots, slots + I64{8}) == I64{0})
    previous :: rt_text_word(slots)
    current :: rt_text_word(slots + I64{8})
    vault_fixture_check(vault_ref_equal(previous, first))
    vault_fixture_check(rt_text_word(current + VAULT_REF_GENERATION) == I64{2})
    vault_fixture_status(root, first, I64{1}, slots)
    retired_load :: vault_load_at_root(root, first, I64{1}, slots)
    if (retired_load != I64{0}) -> panic("retired exact refs remain loadable")
    vault_secret_drop(rt_text_word(slots))
    revoke :: vault_fixture_prepare(root, name, I64{1}, I64{5}, vault_ref_clone(first), exposure, slots)
    revoke_write :: vault_fixture_authorize(revoke, I64{1}, incident, slots)
    vault_fixture_check(vault_commit_at_root(root, revoke, revoke_write, I64{5}, I64{1}, slots, slots + I64{8}) == I64{0})
    vault_ref_drop(rt_text_word(slots))
    vault_ref_drop(rt_text_word(slots + I64{8}))
    vault_fixture_status(root, first, I64{2}, slots)
    vault_fixture_error(vault_load_at_root(root, first, I64{1}, slots), I64{3})
    vault_fixture_check(vault_key_query_at_root(root, name, I64{1}, false, slots) == I64{0})
    queried :: rt_text_word(slots)
    vault_fixture_check(vault_ref_equal(queried, current))
    vault_ref_drop(queried)
    vault_fixture_check(vault_key_query_at_root(root, name, I64{1}, true, slots) == I64{0})
    versions :: rt_text_word(slots)
    vault_fixture_check(rt_text_word(versions + DATA_SEQUENCE_LENGTH) == I64{2})
    vault_refs_drop(versions)
    vault_ref_drop(previous)
    vault_ref_drop(current)
    vault_ref_drop(first)
    jet_rt_vault_clear_test_authorizer()
    jet_rt_free(slots, I64{64}, I64{8})
}
#Export(c) fn authority_is_exact_and_denial_generates_no_key(root: I64, name: I64, empty: I64, reason: I64) {
    slots :: jet_rt_alloc(I64{8}, I64{8})
    plan :: vault_fixture_prepare(root, name, I64{1}, I64{1}, I64{0}, empty, slots)
    vault_fixture_error(vault_authorize_write(plan, I64{1}, reason, slots), I64{5})
    vault_plan_drop(plan)
