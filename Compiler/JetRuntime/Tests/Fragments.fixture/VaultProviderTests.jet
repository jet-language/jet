        jet_rt_free(bytes, DATA_SEQUENCE_BYTES, I64{8})
        record :: vault_record_allocate(name, I64{1}, at + I64{1}, I64{2}, I64{1}, secret)
        rt_text_store(record + VAULT_RECORD_CREATED, if (at == I64{0}) -> I64{19} else -> I64{-1})
        rt_text_store(record + VAULT_RECORD_STATUS_MS, I64{7})
        slot :: data_sequence_reserve(records, DATA_TREE_ELEMENT_BYTES)
        rt_text_store(slot, record)
        rt_text_store(records + DATA_SEQUENCE_LENGTH, at + I64{1})
        at += I64{1}
    }
