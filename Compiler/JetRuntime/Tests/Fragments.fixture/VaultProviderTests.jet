    // A duplicate-invalid-name must fail before a nonexistent root is opened.
    pairs :: data_sequence_new(I64{2}, VAULT_PAIR_BYTES)
    data :: rt_text_word(pairs + DATA_SEQUENCE_DATA)
    at = I64{0}
    loop at < (I64{2}) {
        rt_text_store(data + at * VAULT_PAIR_BYTES, jet_rt_string_clone(name))
        rt_text_store(data + at * VAULT_PAIR_BYTES + I64{8}, jet_rt_string_clone(name))
        at += I64{1}
    }
    rt_text_store(pairs + DATA_SEQUENCE_LENGTH, I64{2})
    error :: vault_replace_strings_at_root(missing_root, pairs)
    vault_fixture_check(error != I64{0} && vault_error_tag(error) == I64{8})
    vault_error_drop(error)
    thread_zero(scratch, I64{32})
    jet_rt_free(scratch, I64{32}, I64{8})
}

#Export(c)
fn jet_rt_vault_reference_fixture(original: I64, display: I64, debug: I64) {
    scratch :: jet_rt_alloc(I64{8240}, I64{8})
    thread_zero(scratch, I64{16})
    store :: vault_store_new(scratch)
    name :: rt_text_word(original + VAULT_RECORD_NAME)
    at := I64{0}
    loop at < (I64{3}) {
        record :: vault_record_clone(original)
        generation :: if (at == I64{0}) -> I64{1} else if (at == I64{1}) -> I64{-1} else -> I64{-9223372036854775808}
        rt_text_store(record + VAULT_RECORD_GENERATION, generation)
        rt_text_store(record + VAULT_RECORD_STATUS, if (at == I64{1}) -> I64{1} else -> I64{2})
        vault_record_hash(record, record + VAULT_RECORD_HASH, scratch)
        vault_fixture_push_record(store, record)
        at += I64{1}
    }
    slot :: scratch + I64{8192}
    vault_fixture_check(vault_key_query_inner(store, name, I64{2}, false, slot) == I64{0})
    reference :: rt_text_word(slot)
    vault_fixture_check(rt_text_word(reference + VAULT_REF_GENERATION) == I64{-1})
    clone :: vault_ref_clone(reference)
    vault_fixture_check(vault_ref_equal(reference, clone))
    shown :: vault_ref_display(reference, false)
    detailed :: vault_ref_display(reference, true)
    vault_fixture_check(jet_rt_string_eq(shown, display) && jet_rt_string_eq(detailed, debug))
    jet_rt_string_drop(shown)
    jet_rt_string_drop(detailed)
    vault_fixture_check(vault_find(store, reference, I64{2}, slot) == I64{0})
    rt_text_store(slot, I64{91})
    wrong_type :: vault_find(store, reference, I64{1}, slot)
    vault_fixture_check(wrong_type != I64{0} && vault_error_tag(wrong_type) == I64{2})
    vault_fixture_check(rt_text_word(slot) == I64{91})
    vault_error_drop(wrong_type)
    rt_text_put(clone + VAULT_REF_HASH, rt_text_byte(clone + VAULT_REF_HASH).bit_xor(I64{1}))
    vault_fixture_check(!vault_ref_equal(reference, clone))
    missing :: vault_find(store, clone, I64{1}, slot)
    vault_fixture_check(missing != I64{0} && vault_error_tag(missing) == I64{1})
    vault_error_drop(missing)
    wrong_query :: vault_key_query_inner(store, name, I64{1}, true, slot)
    vault_fixture_check(wrong_query != I64{0} && vault_error_tag(wrong_query) == I64{2})
    vault_error_drop(wrong_query)
    vault_fixture_check(vault_key_query_inner(store, name, I64{2}, true, slot) == I64{0})
    versions :: rt_text_word(slot)
    vault_fixture_check(rt_text_word(versions + DATA_SEQUENCE_LENGTH) == I64{3})
    data :: rt_text_word(versions + DATA_SEQUENCE_DATA)
    vault_fixture_check(rt_text_word(rt_text_word(data) + VAULT_REF_GENERATION) == I64{-1})
    vault_fixture_check(rt_text_word(rt_text_word(data + I64{8}) + VAULT_REF_GENERATION) == I64{-9223372036854775808})
    vault_fixture_check(rt_text_word(rt_text_word(data + I64{16}) + VAULT_REF_GENERATION) == I64{1})
    vault_refs_drop(versions)
    vault_ref_drop(reference)
    vault_ref_drop(clone)
    vault_store_drop(store)
    vault_fixture_check(vault_status_core(I64{1}) == I64{0})
    vault_fixture_check(vault_status_core(I64{2}) == I64{1})
    vault_fixture_check(vault_status_core(I64{3}) == I64{2})
    thread_zero(scratch, I64{8240})
    jet_rt_free(scratch, I64{8240}, I64{8})
}

#Export(c)
fn jet_rt_vault_plan_auth_fixture(name: I64, empty: I64, reason: I64, expected: I64, operation_hash: I64, preview_hash: I64, granted: Bool, entropy: I64) {
    scratch :: jet_rt_alloc(I64{1632}, I64{8})
    plan :: jet_rt_alloc(VAULT_PLAN_BYTES, I64{8})
    thread_zero(plan, VAULT_PLAN_BYTES)
    rt_text_store(plan + VAULT_PLAN_ACTION, I64{2})
    rt_text_store(plan + VAULT_PLAN_NAME, jet_rt_string_clone(name))
    rt_text_store(plan + VAULT_PLAN_REASON, jet_rt_string_clone(empty))
    at := I64{0}
    loop at < (I64{16}) {
        rt_text_put(plan + VAULT_PLAN_UUID + at, I64{7})
        at += I64{1}
    }
    rt_text_store(plan + VAULT_PLAN_REVISION, I64{9})
    at = I64{0}
    loop at < (I64{32}) {
        rt_text_put(plan + VAULT_PLAN_START_HASH + at, I64{1})
        rt_text_put(plan + VAULT_PLAN_PROVIDER + at, I64{2})
        rt_text_put(plan + VAULT_PLAN_PUBLIC_HASH + at, I64{3})
        rt_text_put(plan + VAULT_PLAN_KEY_DIGEST + at, I64{4})
        at += I64{1}
    }
    rt_text_store(plan + VAULT_PLAN_TO, I64{2})
    rt_text_store(plan + VAULT_PLAN_EXPIRES, I64{123456})
    vault_instant_now(plan + VAULT_PLAN_ISSUED)
    rt_text_store(plan + VAULT_PLAN_DEADLINE, rt_text_word(plan + VAULT_PLAN_ISSUED) + I64{300000000000})
    vault_plan_operation(plan, I64{1}, scratch + I64{576}, scratch)
    vault_fixture_check(rt_text_equal_bytes(plan + VAULT_PLAN_OPERATION, operation_hash, I64{32}))
    preview :: vault_preview_text(plan, I64{1}, reason)
    vault_fixture_check(jet_rt_string_eq(preview, expected))
    jet_rt_string_drop(preview)
    slot :: scratch + I64{1536}
    rt_text_store(slot, I64{91})
    rt_crypto_entropy_set(entropy, I64{0})
    error :: vault_authorize_write(plan, I64{1}, reason, slot)
    rt_crypto_entropy_clear()
    if granted {
        vault_fixture_check(error == I64{0})
        write :: rt_text_word(slot)
        vault_fixture_check(rt_text_equal_bytes(write + VAULT_WRITE_OPERATION, operation_hash, I64{32}))
        vault_fixture_check(rt_text_equal_bytes(write + VAULT_WRITE_PREVIEW, preview_hash, I64{32}))
        vault_fixture_check(rt_text_word(write + VAULT_WRITE_USER) == trap_syscall(I64{107}, I64{0}, I64{0}, I64{0}, I64{0}, I64{0}, I64{0}))
        vault_write_drop(write)
    } else {
        vault_fixture_check(error != I64{0} && vault_error_tag(error) == I64{5})
        vault_fixture_check(rt_text_word(slot) == I64{91})
        vault_error_drop(error)
    }
    rt_text_store(plan + VAULT_PLAN_DEADLINE, I64{0})
    expired :: vault_authorize_write(plan, I64{1}, reason, slot)
    vault_fixture_check(expired != I64{0} && vault_error_tag(expired) == I64{6})
    vault_error_drop(expired)
    vault_plan_drop(plan)
    thread_zero(scratch, I64{1632})
    jet_rt_free(scratch, I64{1632}, I64{8})
}
