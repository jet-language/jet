    loop at < (I64{2}) {
        bytes :: data_sequence_new(I64{32}, RT_HOST_U8_STRIDE)
        thread_zero(rt_text_word(bytes + DATA_SEQUENCE_DATA), I64{32})
        rt_text_store(bytes + DATA_SEQUENCE_LENGTH, I64{32})
