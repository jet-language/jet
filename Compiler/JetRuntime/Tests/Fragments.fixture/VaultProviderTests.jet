// Exact private-error predicates from tests/fixtures/vault_key_runtime.rs:503-556.
// The C transport supplies the literal expected Display/Debug text and forbidden
// sentinels; it does not format errors or implement a vault provider.
fn vault_fixture_check(condition: Bool) {
    if !condition -> jet_rt_unreachable(I64{0}, I64{0})
}
#Export(c) fn errors_and_handles_are_redacted(kind: I64, first: I64, second: I64, expected_display: I64, expected_debug: I64, forbidden: I64) {
    error :: vault_error_new(kind, first, second)
    clone :: vault_error_clone(error)
    vault_fixture_check(vault_error_equal(error, clone))
    vault_fixture_check(vault_error_tag(error) == kind)
    if (kind == I64{10}) {
        vault_fixture_check(rt_text_word(error + VAULT_ERROR_FIRST) == first)
        vault_fixture_check(rt_text_word(clone + VAULT_ERROR_FIRST) == first)
        vault_fixture_check(rt_text_word(error + VAULT_ERROR_SECOND) == I64{0})
        other :: vault_error_new(kind, (first + I64{1}) % I64{5}, I64{0})
        vault_fixture_check(!vault_error_equal(error, other))
        vault_error_drop(other)
    }
    shown :: vault_error_display(error)
    debug :: vault_error_debug(error)
    vault_fixture_check(jet_rt_string_eq(shown, expected_display))
    vault_fixture_check(jet_rt_string_eq(debug, expected_debug))
    count :: rt_text_word(forbidden + DATA_SEQUENCE_LENGTH)
    data :: rt_text_word(forbidden + DATA_SEQUENCE_DATA)
    at := I64{0}
    loop at < count {
        needle :: rt_text_word(data + at * DATA_TREE_ELEMENT_BYTES)
        vault_fixture_check(rt_text_find(shown, needle, I64{0}, false) < I64{0})
        vault_fixture_check(rt_text_find(debug, needle, I64{0}, false) < I64{0})
        at += I64{1}
    }
    jet_rt_string_drop(shown)
    jet_rt_string_drop(debug)
    vault_error_drop(error)
    vault_error_drop(clone)
}
