    vault_fixture_check(temp >= I64{0})
    vault_fixture_check(vault_linux_write_all(temp, rt_text_data(payload), rt_text_len(payload)))
    vault_fixture_check(vault_linux_fsync(temp) == I64{0})
    vault_fixture_check(vault_linux_link_file(temp, dirfd, next, scratch) == I64{0})
    vault_fixture_check(vault_linux_install_exact(dirfd, next, final_name, temp, true, scratch, out) == I64{0})
    vault_linux_close(rt_text_word(out))
    vault_fixture_check(vault_linux_remove_exact(dirfd, final_name, temp, next, out, scratch) == I64{0})
    vault_fixture_check(rt_text_word(out) == I64{1})
    held :: vault_linux_openat(dirfd, lock_name, I64{193}, I64{384}, scratch)
    vault_fixture_check(held >= I64{0})
    jet_rt_vault_set_test_fault(fault)
    vault_fixture_check(vault_linux_remove_exact(dirfd, lock_name, held, quarantine, out, scratch) == I64{0})
    vault_fixture_check(rt_text_word(out) == I64{0})
    jet_rt_vault_set_test_fault(I64{0})
    replacement :: vault_linux_openat(dirfd, lock_name, I64{0}, I64{0}, scratch)
    vault_fixture_check(replacement >= I64{0})
    vault_fixture_check(!vault_linux_same_inode(replacement, held, scratch))
    vault_fixture_check(trap_syscall(I64{0}, replacement, scratch, I64{12}, I64{0}, I64{0}, I64{0}) == I64{11})
    vault_fixture_check(rt_text_word(scratch) == I64{7882815992864204146})
    vault_fixture_check(rt_text_byte(scratch + I64{8}) == I64{101} && rt_text_byte(scratch + I64{9}) == I64{110} && rt_text_byte(scratch + I64{10}) == I64{116})
    vault_fixture_check(vault_linux_remove_exact(dirfd, lock_name, replacement, quarantine, out, scratch) == I64{0})
    vault_fixture_check(rt_text_word(out) == I64{1})
    vault_fixture_check(vault_linux_remove_exact(dirfd, acquired, held, quarantine, out, scratch) == I64{0})
    vault_fixture_check(rt_text_word(out) == I64{1})
    vault_linux_close(replacement)
    vault_linux_close(held)
    vault_linux_close(temp)
    vault_linux_close(dirfd)
    jet_rt_free(scratch, I64{352}, I64{8})
}
// Supplementary real binary read proof, including exact-capacity EOF without
// growth, growth with one probe byte, and clone's shared seek position.
#Export(c) fn jet_rt_vault_linux_read_fixture(root: I64, name: I64, quarantine: I64, payload: I64) {
    scratch :: jet_rt_alloc(I64{352}, I64{8})
    out :: scratch + I64{344}
    rt_text_store(out, I64{-471})
    invalid :: vault_linux_read_file(I64{-1}, out, scratch)
    vault_fixture_check(invalid != I64{0} && vault_error_tag(invalid) == I64{4})
    vault_fixture_check(rt_text_word(out) == I64{-471})
    vault_error_drop(invalid)
    vault_fixture_check(vault_linux_read_at_root(root, name, out) == I64{0})
    vault_fixture_check(rt_text_word(out) == I64{0})
    vault_fixture_check(vault_linux_dir_at_root(root, out) == I64{0})
    dirfd :: rt_text_word(out)
    file :: vault_linux_openat(dirfd, rt_text_data(name), I64{194}, I64{384}, scratch)
    vault_fixture_check(file >= I64{0})
    vault_fixture_check(vault_linux_write_all(file, rt_text_data(payload), rt_text_len(payload)))
    vault_fixture_check(vault_linux_read_file(file, out, scratch) == I64{0})
    bytes :: rt_text_word(out)
    count :: rt_text_word(bytes + DATA_SEQUENCE_LENGTH)
    vault_fixture_check(count == rt_text_len(payload))
    vault_fixture_check(rt_text_equal_bytes(rt_text_word(bytes + DATA_SEQUENCE_DATA), rt_text_data(payload), count))
    if (count == I64{8192}) -> vault_fixture_check(rt_text_word(bytes + DATA_SEQUENCE_CAPACITY) == I64{8192})
    vault_fixture_check(trap_syscall(I64{8}, file, I64{0}, I64{1}, I64{0}, I64{0}, I64{0}) == count)
    data_sequence_drop(bytes, DATA_TREE_BYTE_LIST)
    vault_fixture_check(vault_linux_read_at_root(root, name, out) == I64{0})
    reopened :: rt_text_word(out)
    vault_fixture_check(rt_text_word(reopened + DATA_SEQUENCE_LENGTH) == count)
    vault_fixture_check(rt_text_equal_bytes(rt_text_word(reopened + DATA_SEQUENCE_DATA), rt_text_data(payload), count))
    data_sequence_drop(reopened, DATA_TREE_BYTE_LIST)
    vault_fixture_check(vault_linux_remove_exact(dirfd, rt_text_data(name), file, rt_text_data(quarantine), out, scratch) == I64{0})
    vault_fixture_check(rt_text_word(out) == I64{1})
    vault_linux_close(file)
    vault_linux_close(dirfd)
    jet_rt_free(scratch, I64{352}, I64{8})
}
// Supplementary real default-provider age persistence orchestration. No fixed
// replay material or C crypto; transport borrows only the plaintext sequence.
#Export(c) fn jet_rt_vault_crypto_fixture(plaintext: I64) {
    slots :: jet_rt_alloc(I64{48}, I64{8})
    vault_fixture_check(vault_crypto_keygen(slots, slots + I64{8}) == I64{0})
    identity :: rt_text_word(slots)
    recipient :: rt_text_word(slots + I64{8})
    public :: jet_rt_alloc(I64{32}, I64{8})
    vault_fixture_check(vault_crypto_decode_key(recipient, false, public))
    vault_fixture_check(vault_crypto_encrypt(public, I64{1}, plaintext, slots + I64{16}) == I64{0})
    ciphertext :: rt_text_word(slots + I64{16})
    vault_fixture_check(vault_crypto_decrypt(identity, ciphertext, slots + I64{24}) == I64{0})
    decoded :: rt_text_word(slots + I64{24})
    count :: rt_text_word(plaintext + DATA_SEQUENCE_LENGTH)
    vault_fixture_check(rt_text_word(decoded + DATA_SEQUENCE_LENGTH) == count)
    vault_fixture_check(rt_text_equal_bytes(rt_text_word(decoded + DATA_SEQUENCE_DATA), rt_text_word(plaintext + DATA_SEQUENCE_DATA), count))
    thread_zero(rt_text_word(decoded + DATA_SEQUENCE_DATA), rt_text_word(decoded + DATA_SEQUENCE_CAPACITY))
    data_sequence_drop(decoded, DATA_TREE_BYTE_LIST)
    vault_fixture_check(vault_crypto_keygen(slots + I64{32}, slots + I64{40}) == I64{0})
    wrong_identity :: rt_text_word(slots + I64{32})
    wrong_recipient :: rt_text_word(slots + I64{40})
    rt_text_store(slots + I64{24}, I64{-471})
    wrong :: vault_crypto_decrypt(wrong_identity, ciphertext, slots + I64{24})
    vault_fixture_check(wrong != I64{0} && vault_error_tag(wrong) == I64{4})
    vault_fixture_check(rt_text_word(slots + I64{24}) == I64{-471})
    vault_error_drop(wrong)
    data :: rt_text_word(ciphertext + DATA_SEQUENCE_DATA)
    last :: rt_text_word(ciphertext + DATA_SEQUENCE_LENGTH) - I64{1}
    rt_text_put(data + last, rt_text_byte(data + last).bit_xor(I64{1}))
    corrupt :: vault_crypto_decrypt(identity, ciphertext, slots + I64{24})
    vault_fixture_check(corrupt != I64{0} && vault_error_tag(corrupt) == I64{4})
    vault_fixture_check(rt_text_word(slots + I64{24}) == I64{-471})
    vault_error_drop(corrupt)
    data_sequence_drop(ciphertext, DATA_TREE_BYTE_LIST)
    vault_text_zero(identity)
    vault_text_zero(wrong_identity)
    jet_rt_string_drop(identity)
    jet_rt_string_drop(wrong_identity)
    jet_rt_string_drop(recipient)
    jet_rt_string_drop(wrong_recipient)
    jet_rt_free(public, I64{32}, I64{8})
    jet_rt_free(slots, I64{48}, I64{8})
}
#Export(c) fn jet_rt_vault_crypto_unavailable_fixture(callback: I64) {
