    vault_fixture_check(vault_commit_at_root(root, plan, write, I64{1}, I64{1}, slots, slots + I64{8}) == I64{0})
    reference :: rt_text_word(slots + I64{8})
    vault_fixture_check(rt_text_word(reference + VAULT_REF_GENERATION) == I64{1})
    vault_ref_drop(reference)
    jet_rt_vault_clear_test_authorizer()
