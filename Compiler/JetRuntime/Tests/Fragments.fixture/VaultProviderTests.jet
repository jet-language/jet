// Supplemental real filesystem boundary, not a substitute for the original
// prepare_generate_at symlink fixture until the complete provider is composed.
#Export(c) fn jet_rt_vault_linux_dir_fixture(root: I64, expected: I64) {
    slot :: jet_rt_alloc(I64{8}, I64{8})
    rt_text_store(slot, I64{-471})
    error :: vault_linux_dir_at_root(root, slot)
    if (expected == I64{-1}) {
        vault_fixture_check(error == I64{0})
        fd :: rt_text_word(slot)
        vault_fixture_check(fd >= I64{0})
        vault_linux_close(fd)
    } else {
        vault_fixture_check(error != I64{0})
        vault_fixture_check(vault_error_tag(error) == expected)
        vault_fixture_check(rt_text_word(slot) == I64{-471})
        vault_error_drop(error)
    }
    jet_rt_free(slot, I64{8}, I64{8})
}
// Supplemental native inode ownership proof: real anonymous file, proc-fd link,
