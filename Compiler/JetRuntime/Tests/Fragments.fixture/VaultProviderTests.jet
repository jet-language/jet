#Export(c)
fn jet_rt_vault_lock_guard_fixture(root: I64, fault: I64) {
    scratch :: jet_rt_alloc(I64{368}, I64{8})
    name :: scratch + I64{336}
    out :: scratch + I64{360}
    vault_fixture_check(vault_linux_dir_at_root(root, out) == I64{0})
