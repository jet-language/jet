// Observation only: traverse the real process-pinned World registry after all
// publishers joined. No publication, ownership or reset logic is duplicated.
#Export(c) fn jet_rt_shared_fixture_registration_count(cell: I64) -> I64 {
    count := I64{0}
    node := sync_load(shared_registered)
    loop node != (I64{0}) {
        if (sync_load(node) == cell) { count += I64{1} }
        node = sync_load(node + I64{8})
    }
    count
}
