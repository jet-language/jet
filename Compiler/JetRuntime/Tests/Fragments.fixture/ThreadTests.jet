// All fixture behavior runs in Jet. The tiny C driver only supplies relocated
// addresses of these exported Jet callbacks and calls fixture_run. No Rust or
// libc callee is reachable from the raw-clone child.
fn thread_test_require(ok: Bool) {
    if ok {
        return
    }
    #Unsafe("a failed isolated runtime witness ends the process without allocation or libc") {
        _ := os_syscall_i64(I64{231}, I64{1}, I64{0}, I64{0}, I64{0}, I64{0}, I64{0})
    }
    loop {

    }
}

#Export(c) fn jet_rt_thread_fixture_destructor(closure: I64, descriptor: I64) -> I64 {
    log :: descriptor + I64{32}
    sync_store(log, sync_load(log) * I64{10} + sync_load(closure + I64{24}))
    I64{0}
}

#Export(c) fn jet_rt_thread_fixture_rearm_destructor(closure: I64, _value: I64) -> I64 {
    count :: sync_load(closure + I64{32})
    sync_store(count, sync_load(count) + I64{1})
    // Deliberately never stops rearming; the detach bound must stop at four.
    jet_rt_tls_set(sync_load(closure + I64{24}), I64{1})
    I64{0}
}

#Export(c) fn jet_rt_thread_fixture_rearm_worker(closure: I64) -> I64 {
    jet_rt_tls_set(sync_load(closure + I64{24}), I64{1})
    I64{0}
}

fn thread_test_identity() {
    #Unsafe("gettid verifies identity without trusting the TCB under test") {
        tid :: os_syscall_i64(I64{186}, I64{0}, I64{0}, I64{0}, I64{0}, I64{0}, I64{0})
        thread_test_require(sync_load(thread_base() + I64{8}) == tid)
    }
}

#Export(c) fn jet_rt_thread_fixture_parent() -> I64 { thread_base() }

#Export(c) fn jet_rt_thread_fixture_inherited_base(scratch: I64, expected: I64) {
    #Unsafe("ARCH_GET_GS writes a caller-owned word; the inherited pointer is compared, never dereferenced") {
        status :: os_syscall_i64(I64{158}, I64{4100}, scratch, I64{0}, I64{0}, I64{0}, I64{0})
        thread_test_require(status == I64{0} && sync_load(scratch) == expected)
    }
}

#Export(c) fn jet_rt_thread_fixture_attached_child(parent: I64) -> I64 {
    thread_test_require(thread_base() != parent)
    jet_rt_thread_fixture_attached()
}

#Export(c) fn jet_rt_thread_fixture_attached() -> I64 {
    thread_test_identity()
    own :: thread_base()
    jet_rt_thread_attach()
    thread_test_require(thread_base() == own)
    I64{0}
}

#Export(c) fn jet_rt_thread_fixture_worker(descriptor: I64) -> I64 {
    pair :: sync_load(descriptor)
    id :: sync_load(descriptor + I64{8})
    first :: sync_load(descriptor + I64{16})
    second :: sync_load(descriptor + I64{24})
    sync_store(descriptor + I64{40}, thread_base())
    sync_store(descriptor + I64{48}, sync_load(thread_base() + I64{8}))
    thread_test_identity()
    thread_test_require(jet_rt_tls_get(first) == I64{0} && jet_rt_tls_get(second) == I64{0})
    jet_rt_tls_set(first, descriptor)
    jet_rt_tls_set(second, descriptor)
    thread_test_require(jet_rt_tls_get(first) == descriptor && jet_rt_tls_get(second) == descriptor)
    if sync_once_enter(pair + I64{32}) {
        sync_store(pair + I64{40}, I64{73})
        sync_once_complete(pair + I64{32})
    }
    thread_test_require(sync_load(pair + I64{40}) == I64{73})
    round := I64{0}
    loop round < (I64{1000000}) {
        sync_mutex_lock(pair)
        thread_test_require(!sync_mutex_try_lock(pair))
        loop sync_load(pair + I64{16}) != id -> _ := sync_cond_wait(pair + I64{8}, pair, I64{-1})
        sync_store(pair + I64{24}, sync_load(pair + I64{24}) + I64{1})
        sync_store(pair + I64{16}, I64{1} - id)
        sync_cond_notify_one(pair + I64{8})
        sync_mutex_unlock(pair)
        round += I64{1}
    }
    thread_test_require(jet_rt_tls_get(first) == descriptor)
    descriptor
}

#Export(c) fn jet_rt_thread_fixture_park_worker(state: I64) -> I64 {
    parker :: sync_load(state)
    notifier :: sync_load(state + I64{8})
    round := I64{0}
    loop round < (I64{100000}) {
        sync_park(parker, I64{-1})
        // The acknowledgement is a second ParkSlot, so repeated notifications
        // cannot coalesce and mask a lost wake in the first slot.
        sync_park_wake(notifier)
        round += I64{1}
    }
    I64{0}
}

#Export(c) fn jet_rt_thread_fixture_clone_worker(state: I64) -> I64 {
    // Raw clone inherits GS and FS, but bootstrap must ignore the old base.
    jet_rt_thread_bootstrap()
    _ := jet_rt_thread_fixture_attached_child(sync_load(state + I64{8}))
    key :: sync_load(state)
    jet_rt_tls_set(key, state)
    thread_test_require(jet_rt_tls_get(key) == state)
    sync_store(state + I64{8}, thread_base())
    sync_store(state + I64{16}, sync_load(thread_base() + I64{8}))
    jet_rt_thread_detach()
    I64{0}
}

fn thread_test_closure(code: I64, label: I64) -> I64 {
    closure :: jet_rt_alloc(I64{32}, I64{8})
    sync_store(closure, I64{1})
    sync_store(closure + I64{8}, code)
    sync_store(closure + I64{16}, I64{0})
    sync_store(closure + I64{24}, label)
    closure
}

fn thread_test_pairs(entry: I64, destructor: I64) {
    first :: jet_rt_tls_key_new(thread_test_closure(destructor, I64{1}))
    second :: jet_rt_tls_key_new(thread_test_closure(destructor, I64{2}))
    threads := I64{2}
    loop threads <= (I64{64}) {
        pairs :: threads /% I64{2}
        states :: jet_rt_alloc(pairs * I64{48}, I64{8})
        descriptors :: jet_rt_alloc(threads * I64{56}, I64{8})
        handles :: jet_rt_alloc(threads * I64{8}, I64{8})
        thread_zero(states, pairs * I64{48})
        thread_zero(descriptors, threads * I64{56})
        index := I64{0}
        loop index < threads {
            descriptor :: descriptors + index * I64{56}
            sync_store(descriptor, states + (index /% I64{2}) * I64{48})
            sync_store(descriptor + I64{8}, index % I64{2})
            sync_store(descriptor + I64{16}, first)
            sync_store(descriptor + I64{24}, second)
            handle :: thread_spawn(entry, descriptor)
            thread_test_require(handle > I64{0})
            sync_store(handles + index * I64{8}, handle)
            index += I64{1}
        }
        result :: jet_rt_alloc(I64{8}, I64{8})
        index = I64{0}
        loop index < threads {
            thread_test_require(thread_join(sync_load(handles + index * I64{8}), result) == I64{0})
            descriptor :: descriptors + index * I64{56}
            thread_test_require(sync_load(result) == descriptor)
            thread_test_require(sync_load(descriptor + I64{32}) == I64{21})
            thread_test_require(sync_load(descriptor + I64{40}) != thread_base())
            thread_test_require(sync_load(descriptor + I64{48}) != sync_load(thread_base() + I64{8}))
            index += I64{1}
        }
        index = I64{0}
        loop index < pairs {
            thread_test_require(sync_load(states + index * I64{48} + I64{24}) == I64{2000000})
            index += I64{1}
        }
        thread_test_require(jet_rt_tls_get(first) == I64{0} && jet_rt_tls_get(second) == I64{0})
        jet_rt_free(result, I64{8}, I64{8})
        jet_rt_free(handles, threads * I64{8}, I64{8})
        jet_rt_free(descriptors, threads * I64{56}, I64{8})
        jet_rt_free(states, pairs * I64{48}, I64{8})
        threads *= I64{2}
    }
}

fn thread_test_parks(entry: I64, detached: Bool) {
    state :: jet_rt_alloc(I64{16}, I64{8})
    parker :: sync_park_new()
    notifier :: sync_park_new()
    thread_test_require(sync_load(parker + I64{24}) == I64{1})
    sync_park_retain(parker)
    thread_test_require(sync_load(parker + I64{24}) == I64{2})
    sync_park_drop(parker)
    thread_test_require(sync_load(parker + I64{24}) == I64{1})
    sync_store(state, parker)
    sync_store(state + I64{8}, notifier)
    // Wake-before-park and repeated wake coalescing are explicit witnesses.
    sync_park_wake(parker)
    sync_park_wake(parker)
    before :: sync_now_ns()
    sync_park(parker, I64{0})
    thread_test_require(sync_now_ns() - before < I64{1000000})
    handle :: thread_spawn(entry, state)
    thread_test_require(handle > I64{0})
    if detached -> thread_test_require(thread_detach(handle) == I64{0})
    round := I64{0}
    loop round < (I64{100000}) {
        sync_park_wake(parker)
        if (round % I64{2} == I64{0}) {
            #Unsafe("sched_yield widens both sides of the check-to-wait race without timing assumptions") {
                _ := os_syscall_i64(I64{24}, I64{0}, I64{0}, I64{0}, I64{0}, I64{0}, I64{0})
            }
        }
        sync_park(notifier, I64{-1})
        round += I64{1}
    }
    if !detached -> thread_test_require(thread_join(handle, I64{0}) == I64{0})
    // The last ack may be consumed before wake() unlocks the notifier. Taking
    // that mutex guarantees the waker no longer touches either slot, including
    // for a detached thread (its remaining work is only TCB cleanup).
    sync_mutex_lock(notifier + I64{8})
    sync_mutex_unlock(notifier + I64{8})
    // Monotonic absolute timeout, no wake: elapsed lies in requested +/-1ms.
    before_timeout :: sync_now_ns()
    sync_park(parker, I64{10000000})
    elapsed :: sync_now_ns() - before_timeout
    thread_test_require(elapsed >= I64{9000000} && elapsed <= I64{11000000})
    sync_park_drop(notifier)
    sync_park_drop(parker)
    jet_rt_free(state, I64{16}, I64{8})
}

fn thread_test_clone(entry: I64) {
    state :: jet_rt_alloc(I64{24}, I64{8})
    thread_zero(state, I64{24})
    key :: jet_rt_tls_key_new(I64{0})
    sync_store(state, key)
    parent :: thread_base()
    sync_store(state + I64{8}, parent)
    control :: thread_clone_fixture(entry, state)
    thread_test_require(control > I64{0})
    thread_clone_join(control)
    thread_test_require(sync_load(state + I64{8}) != I64{0} && sync_load(state + I64{8}) != parent)
    thread_test_require(sync_load(state + I64{16}) != sync_load(parent + I64{8}))
    thread_test_require(thread_base() == parent && jet_rt_tls_get(key) == I64{0})
    jet_rt_free(state, I64{24}, I64{8})
}

fn thread_test_rearm(entry: I64, destructor: I64) {
    count :: jet_rt_alloc(I64{8}, I64{8})
    sync_store(count, I64{0})
    closure :: jet_rt_alloc(I64{40}, I64{8})
    sync_store(closure, I64{1})
    sync_store(closure + I64{8}, destructor)
    sync_store(closure + I64{16}, I64{0})
    key :: jet_rt_tls_key_new(closure)
    sync_store(closure + I64{24}, key)
    sync_store(closure + I64{32}, count)
    handle :: thread_spawn(entry, closure)
    thread_test_require(handle > I64{0})
    thread_test_require(thread_join(handle, I64{0}) == I64{0})
    thread_test_require(sync_load(count) == I64{4})
    // The process registry owns the header until exit; no thread retains a
    // nonzero value for this key, so its captured counter is now unreachable.
    jet_rt_free(count, I64{8}, I64{8})
}

fn thread_test_inherited(entry: I64) {
    parent :: thread_base()
    result :: jet_rt_alloc(I64{8}, I64{8})
    handle :: thread_spawn(entry, parent)
    thread_test_require(handle > I64{0})
    thread_test_require(thread_join(handle, result) == I64{0} && sync_load(result) == I64{0})
    thread_test_require(thread_base() == parent)
    thread_test_identity()
    jet_rt_free(result, I64{8}, I64{8})
}

#Export(c) fn jet_rt_thread_fixture_run(callbacks: I64) -> I64 {
    // .init_array already initialized alloc/thread; repeated init is harmless.
    parent :: thread_base()
    jet_rt_thread_init()
    thread_test_require(thread_base() == parent && sync_load(parent) == parent)
    thread_test_pairs(sync_load(callbacks), sync_load(callbacks + I64{24}))
    thread_test_parks(sync_load(callbacks + I64{8}), false)
    thread_test_parks(sync_load(callbacks + I64{8}), true)
    thread_test_clone(sync_load(callbacks + I64{16}))
    thread_test_rearm(sync_load(callbacks + I64{40}), sync_load(callbacks + I64{32}))
    thread_test_inherited(sync_load(callbacks + I64{48}))
    #Unsafe("heap-free fixture success line is one eight-byte write") {
        _ := os_write_word_i64(I64{1}, I64{2932874797083764}, I64{7})
    }
    I64{0}
}
