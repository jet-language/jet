// Pure classifier witness uses the real executor helper, not a fake syscall.
#Export(c) fixture_process_exec_errno_class_raw: fn(result: I64) -> I64 {
    spawn_exec_errno_class(result)
}
#Export(c) fixture_process_cpu_seconds_raw: fn(milliseconds: I64) -> I64 {
    spawn_cpu_seconds(milliseconds)
}
// journey-tls.c reads the report terminal policy through the real helpers.
#Export(c) fixture_journey_auto_color_raw: fn(tty: Bool) -> Bool {
    journey_auto_color(tty)
}
#Export(c) fixture_journey_columns_raw: fn(tty: Bool) -> I64 {
    journey_stderr_columns(tty)
}
