// Run the same fixture on a newly attached worker to witness TLS default auto.
#Export(c) fn jet_rt_terminal_color_fixture() -> I64 {
    if (jet_term_color_mode_raw() != I64{0}) -> return I64{1}
    jet_term_set_color_mode(rt_static_text("always"))
    if (jet_terminal8_color_mode() != I64{1} || !terminal_color_enabled()) -> return I64{2}
    jet_term_set_color_mode(rt_static_text("never"))
    if (jet_term_color_mode_raw() != I64{2} || terminal_color_enabled()) -> return I64{3}
    jet_term_set_color_mode(rt_static_text("unknown"))
    if (jet_term_color_mode_raw() != I64{0}) -> return I64{4}
    jet_term_set_color_mode(rt_static_text("auto"))
    I64{0}
}
