#Export(c) fn jet_rt_sha3_fixture(bits: I64, input: I64, length: I64, output: I64) {
    owned :: jet_rt_alloc(I64{456}, I64{8})
    scratch :: owned + I64{8}
    rt_text_store(owned, I64{0x42})
    rt_text_store(scratch + I64{440}, I64{0x24})
    at := I64{0}
    loop at < (I64{440}) {
        rt_text_put(scratch + at, I64{165})
        at += I64{1}
    }
    if {
        (bits == I64{224}) -> rt_crypto_sha3_224(input, length, output, scratch)
        (bits == I64{256}) -> rt_crypto_sha3_256(input, length, output, scratch)
        (bits == I64{384}) -> rt_crypto_sha3_384(input, length, output, scratch)
        else -> rt_crypto_sha3_512(input, length, output, scratch)
    }
    if (rt_text_word(owned) != I64{0x42} || rt_text_word(scratch + I64{440}) != I64{0x24}) -> jet_rt_unreachable(I64{0}, I64{0})
    at = I64{0}
    loop at < (I64{440}) {
        if (rt_text_byte(scratch + at) != I64{0}) -> jet_rt_unreachable(I64{0}, I64{0})
        at += I64{1}
    }
    jet_rt_free(owned, I64{456}, I64{8})
}
