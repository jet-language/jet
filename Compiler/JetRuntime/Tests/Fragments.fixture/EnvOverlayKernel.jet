// Supplement to a real runtime fixture unit, not an alternate environment cell.
// The consumer supplies actual main argc/argv/envp and real pack init/providers;
// Its isolated child environment must omit JET_ENV3 and JET_ENV3_B initially.
fn env_overlay_fixture_require(ok: Bool) {
    if ok -> return
    #Unsafe("failed witness terminates its isolated real-runtime process") {
        _ := os_syscall_i64(I64{231}, I64{1}, I64{0}, I64{0}, I64{0}, I64{0}, I64{0})
    }
    loop {
    }
}

fn env_overlay_fixture_text(word: I64, length: I64) -> I64 {
    value :: jet_rt_string_builder_new()
    rt_text_push_word(value, word, length)
    value
}

fn env_overlay_fixture_reused(name: I64, storage: I64, capacity: I64) {
    sync_mutex_lock(env_overlay_root)
    index :: env_overlay_find(rt_text_data(name), rt_text_len(name))
    env_overlay_fixture_require(index == encoding_word(env_overlay_root + I64{24}) - I64{1})
    row :: encoding_word(env_overlay_root + I64{16}) + index * I64{40}
    env_overlay_fixture_require(encoding_word(row) == storage)
    env_overlay_fixture_require(encoding_word(row + I64{32}) == capacity)
    sync_mutex_unlock(env_overlay_root)
}

#Export(c) fn jet_rt_env_overlay_kernel_fixture(argc: I64, argv: I64, envp: I64) {
    jet_rt_host_arguments(argc, argv, envp)
    key :: env_overlay_fixture_text(I64{3699230203790509386}, I64{8}) // JET_ENV3
    first :: env_overlay_fixture_text(I64{1701601654}, I64{4}) // vale
    second :: env_overlay_fixture_text(I64{1685349747}, I64{4}) // setd
    grown :: env_overlay_fixture_text(I64{1701601654}, I64{4})
    rt_text_push_word(grown, I64{1685349747}, I64{4}) // valesetd
    sibling_key :: env_overlay_fixture_text(I64{3699230203790509386}, I64{8})
    rt_text_push_word(sibling_key, I64{16991}, I64{2}) // JET_ENV3_B
    invalid_name :: env_overlay_fixture_text(I64{61}, I64{1})
    invalid_value :: env_overlay_fixture_text(I64{6422625}, I64{3}) // a,NUL,b
    empty :: env_overlay_fixture_text(I64{0}, I64{0})
    slots :: jet_rt_alloc(I64{24}, I64{8})
    env_overlay_fixture_require(!env_overlay_contains(key))
    env_overlay_fixture_require(!env_overlay_contains(sibling_key))

    env_overlay_fixture_require(env_overlay_try_set(invalid_name, first, slots) == I64{0})
    error :: encoding_word(slots)
    env_overlay_fixture_require(jet_rt_record_tag_env_error(error) == I64{0})
    jet_rt_handle_drop_env_error(error)
    env_overlay_fixture_require(env_overlay_try_set(empty, first, slots) == I64{0})
    error :: encoding_word(slots)
    env_overlay_fixture_require(jet_rt_record_tag_env_error(error) == I64{0})
    jet_rt_handle_drop_env_error(error)
    env_overlay_fixture_require(env_overlay_try_set(key, invalid_value, slots) == I64{0})
    error :: encoding_word(slots)
    env_overlay_fixture_require(jet_rt_record_tag_env_error(error) == I64{1})
    jet_rt_handle_drop_env_error(error)
    env_overlay_fixture_require(!env_overlay_contains(key))

    env_overlay_fixture_require(env_overlay_try_set(key, first, slots) == I64{1})
    env_overlay_fixture_require(encoding_word(slots) == I64{0})
    env_overlay_fixture_require(env_overlay_contains(key))
    sync_mutex_lock(env_overlay_root)
    initial_row :: encoding_word(env_overlay_root + I64{16}) + env_overlay_find(rt_text_data(key), rt_text_len(key)) * I64{40}
    initial_storage :: encoding_word(initial_row)
    env_overlay_fixture_require(encoding_word(initial_row + I64{32}) == I64{12})
    sync_mutex_unlock(env_overlay_root)
    snapshot_length :: env_overlay_snapshot(slots + I64{8})
    snapshot :: encoding_word(slots + I64{8})
    last :: snapshot + (snapshot_length - I64{1}) * I64{40}
    env_overlay_fixture_require(env_overlay_equal(encoding_word(last), encoding_word(last + I64{8}), rt_text_data(key), rt_text_len(key)))
    env_overlay_fixture_require(env_overlay_equal(encoding_word(last + I64{16}), encoding_word(last + I64{24}), rt_text_data(first), rt_text_len(first)))

    env_overlay_fixture_require(env_overlay_try_set(sibling_key, second, slots) == I64{1})
    env_overlay_fixture_require(env_overlay_try_set(key, grown, slots) == I64{1})
    sync_mutex_lock(env_overlay_root)
    grown_row :: encoding_word(env_overlay_root + I64{16}) + env_overlay_find(rt_text_data(key), rt_text_len(key)) * I64{40}
    grown_storage :: encoding_word(grown_row)
    env_overlay_fixture_require(grown_storage != initial_storage)
    env_overlay_fixture_require(encoding_word(grown_row + I64{32}) == I64{16})
    sync_mutex_unlock(env_overlay_root)
    env_overlay_fixture_reused(key, grown_storage, I64{16})
    length :: env_overlay_value_bytes(key, slots + I64{16})
    bytes :: encoding_word(slots + I64{16})
    env_overlay_fixture_require(env_overlay_equal(bytes, length, rt_text_data(grown), rt_text_len(grown)))
    jet_rt_free(bytes, length, I64{1})

    env_overlay_fixture_require(env_overlay_try_set(key, second, slots) == I64{1})
    env_overlay_fixture_reused(key, grown_storage, I64{16})
    length :: env_overlay_value_bytes(key, slots + I64{16})
    bytes :: encoding_word(slots + I64{16})
    env_overlay_fixture_require(env_overlay_equal(bytes, length, rt_text_data(second), rt_text_len(second)))
    if (length != I64{0}) -> jet_rt_free(bytes, length, I64{1})
    env_overlay_fixture_require(env_overlay_try_set(key, grown, slots) == I64{1})
    env_overlay_fixture_reused(key, grown_storage, I64{16})
    length :: env_overlay_value_bytes(sibling_key, slots + I64{16})
    bytes :: encoding_word(slots + I64{16})
    env_overlay_fixture_require(env_overlay_equal(bytes, length, rt_text_data(second), rt_text_len(second)))
    jet_rt_free(bytes, length, I64{1})
    // The owned atomic snapshot survives both replacement and later removal.
    env_overlay_fixture_require(env_overlay_equal(encoding_word(last + I64{16}), encoding_word(last + I64{24}), rt_text_data(first), rt_text_len(first)))

    env_overlay_fixture_require(env_overlay_try_set(key, empty, slots) == I64{1})
    env_overlay_fixture_reused(key, grown_storage, I64{16})
    env_overlay_fixture_require(env_overlay_contains(key))
    env_overlay_fixture_require(env_overlay_value_bytes(key, slots + I64{16}) == I64{0})
    env_overlay_fixture_require(encoding_word(slots + I64{16}) == I64{0})
    env_overlay_fixture_require(env_overlay_try_remove(key, slots + I64{8}, slots) == I64{1})
    env_overlay_fixture_require(encoding_word(slots + I64{8}) == I64{1})
    env_overlay_fixture_require(!env_overlay_contains(key))
    env_overlay_fixture_require(env_overlay_value_bytes(key, slots + I64{16}) == I64{-1})
    env_overlay_fixture_require(env_overlay_try_remove(key, slots + I64{8}, slots) == I64{1})
    env_overlay_fixture_require(encoding_word(slots + I64{8}) == I64{0})
    env_overlay_fixture_require(env_overlay_equal(encoding_word(last + I64{16}), encoding_word(last + I64{24}), rt_text_data(first), rt_text_len(first)))
    env_overlay_snapshot_drop(snapshot, snapshot_length)
    env_overlay_fixture_require(env_overlay_try_remove(sibling_key, slots + I64{8}, slots) == I64{1})
    env_overlay_fixture_require(encoding_word(slots + I64{8}) == I64{1})

    jet_rt_free(slots, I64{24}, I64{8})
    jet_rt_string_drop(key)
    jet_rt_string_drop(first)
    jet_rt_string_drop(second)
    jet_rt_string_drop(grown)
    jet_rt_string_drop(sibling_key)
    jet_rt_string_drop(invalid_name)
    jet_rt_string_drop(invalid_value)
    jet_rt_string_drop(empty)
}
