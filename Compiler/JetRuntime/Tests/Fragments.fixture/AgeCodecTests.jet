#Export(c) fn jet_rt_age_key_fixture(identity_text: I64, recipient_text: I64) {
    key :: jet_rt_alloc(I64{32}, I64{1})
    pubkey :: jet_rt_alloc(I64{32}, I64{1})
    encoded :: jet_rt_alloc(I64{74}, I64{1})
    scratch :: jet_rt_alloc(I64{1568}, I64{8})
    if (!rt_age_key_decode(identity_text, I64{74}, true, key)) -> jet_rt_unreachable(I64{0}, I64{0})
    if (rt_age_key_encode(key, true, encoded) != I64{74} || !rt_crypto_equal(encoded, identity_text, I64{74})) -> jet_rt_unreachable(I64{0}, I64{0})
    rt_crypto_x25519_public(key, pubkey, scratch)
    if (rt_age_key_encode(pubkey, false, encoded) != I64{62} || !rt_crypto_equal(encoded, recipient_text, I64{62})) -> jet_rt_unreachable(I64{0}, I64{0})
    if (!rt_age_key_decode(recipient_text, I64{62}, false, key) || !rt_crypto_equal(key, pubkey, I64{32})) -> jet_rt_unreachable(I64{0}, I64{0})
    rt_text_put(encoded + I64{61}, I64{113})
    if (rt_age_key_decode(encoded, I64{62}, false, key)) -> jet_rt_unreachable(I64{0}, I64{0})
    rt_crypto_wipe(key, I64{32})
    rt_crypto_wipe(encoded, I64{74})
    jet_rt_free(key, I64{32}, I64{1})
    jet_rt_free(pubkey, I64{32}, I64{1})
    jet_rt_free(encoded, I64{74}, I64{1})
    jet_rt_free(scratch, I64{1568}, I64{8})
}
#Export(c) fn jet_rt_age_base64_fixture(plain: I64, length: I64, text: I64, text_len: I64, valid: Bool) {
    encoded :: jet_rt_alloc(text_len + I64{8}, I64{1})
    decoded :: jet_rt_alloc(length + I64{8}, I64{1})
    if valid {
        if (rt_age_b64_encode(plain, length, encoded) != text_len || !rt_crypto_equal(encoded, text, text_len)) -> jet_rt_unreachable(I64{0}, I64{0})
        if (rt_age_b64_decode(text, text_len, decoded, length) != length || !rt_crypto_equal(decoded, plain, length)) -> jet_rt_unreachable(I64{0}, I64{0})
    } else {
        if (rt_age_b64_decode(text, text_len, decoded, length) != I64{-1}) -> jet_rt_unreachable(I64{0}, I64{0})
    }
    jet_rt_free(encoded, text_len + I64{8}, I64{1})
    jet_rt_free(decoded, length + I64{8}, I64{1})
}
