// Native transports only; the production fill and the one adapter site execute.
#Export(c) fn jet_rt_entropy_fixture_set(callback: I64, context: I64) {
    rt_crypto_entropy_set(callback, context)
}
#Export(c) fn jet_rt_entropy_fixture_clear() { rt_crypto_entropy_clear() }
#Export(c) fn jet_rt_entropy_fixture_fill(out: I64, count: I64) -> I64 {
    rt_crypto_entropy_fill(out, count)
}
#Export(c) fn jet_rt_entropy_fixture_error(error: I64) -> I64 {
    rt_crypto_error_display(error)
}
