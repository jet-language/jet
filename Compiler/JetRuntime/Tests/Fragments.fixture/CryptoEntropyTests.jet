// Native transports only; the production fill and the one adapter site execute.
#Export(c) jet_rt_entropy_fixture_set: fn(callback: I64, context: I64) {
    rt_crypto_entropy_set(callback, context)
}
#Export(c) jet_rt_entropy_fixture_clear: fn() { rt_crypto_entropy_clear() }
#Export(c) jet_rt_entropy_fixture_fill: fn(out: I64, count: I64) -> I64 {
    rt_crypto_entropy_fill(out, count)
}
