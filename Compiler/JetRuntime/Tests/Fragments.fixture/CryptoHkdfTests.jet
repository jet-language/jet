#Export(c) fn jet_rt_hmac_fixture(key: I64, key_len: I64, input: I64, length: I64, expected: I64) {
    scratch :: jet_rt_alloc(I64{672}, I64{8})
    output :: jet_rt_alloc(I64{32}, I64{1})
    rt_crypto_hmac(key, key_len, input, length, output, scratch)
    if (!rt_crypto_equal(output, expected, I64{32})) -> jet_rt_unreachable(I64{0}, I64{0})
    i := I64{0}
    loop {
        if (i >= I64{672}) -> break
        if (rt_text_byte(scratch + i) != I64{0}) -> jet_rt_unreachable(I64{0}, I64{0})
        i += I64{1}
    }
    jet_rt_free(output, I64{32}, I64{1})
    jet_rt_free(scratch, I64{672}, I64{8})
}
#Export(c) fn jet_rt_hkdf_fixture(ikm: I64, ikm_len: I64, salt: I64, salt_len: I64, info: I64, info_len: I64, length: I64, expected_prk: I64, expected: I64) {
    scratch :: jet_rt_alloc(I64{744}, I64{8})
    output :: jet_rt_alloc(length + I64{2}, I64{1})
    prk :: jet_rt_alloc(I64{32}, I64{1})
    rt_crypto_hmac(salt, salt_len, ikm, ikm_len, prk, scratch)
    if (!rt_crypto_equal(prk, expected_prk, I64{32})) -> jet_rt_unreachable(I64{0}, I64{0})
    rt_text_put(output, I64{165})
    rt_text_put(output + length + I64{1}, I64{90})
    if (!rt_crypto_hkdf(ikm, ikm_len, salt, salt_len, info, info_len, output + I64{1}, length, scratch)) -> jet_rt_unreachable(I64{0}, I64{0})
    if (!rt_crypto_equal(output + I64{1}, expected, length)) -> jet_rt_unreachable(I64{0}, I64{0})
    if (rt_text_byte(output) != I64{165} || rt_text_byte(output + length + I64{1}) != I64{90}) -> jet_rt_unreachable(I64{0}, I64{0})
    i := I64{0}
    loop {
        if (i >= I64{744}) -> break
        if (rt_text_byte(scratch + i) != I64{0}) -> jet_rt_unreachable(I64{0}, I64{0})
        i += I64{1}
    }
    rt_crypto_wipe(prk, I64{32})
    rt_crypto_wipe(output, length + I64{2})
    jet_rt_free(prk, I64{32}, I64{1})
    jet_rt_free(output, length + I64{2}, I64{1})
    jet_rt_free(scratch, I64{744}, I64{8})
}
