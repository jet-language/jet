fn rt_age_fixture_zero(bytes: I64, length: I64) {
    i := I64{0}
    loop i < length {
        if (rt_text_byte(bytes + i) != I64{0}) -> jet_rt_unreachable(I64{0}, I64{0})
        i += I64{1}
    }
}
// Reproduce the matching wrapped key, header MAC and every STREAM byte.
// The immutable public header/stanza spelling is retained, like the Rust reader.
fn rt_age_fixture_rebuild(identity: I64, cipher: I64, cipher_len: I64, plain: I64, plain_len: I64, rebuilt: I64, scratch: I64) {
    footer :: rt_age_header_scan(cipher, cipher_len)
    own_public :: scratch + I64{1568}
    file_key :: scratch + I64{1808}
    wrap_key :: scratch + I64{1728}
    nonce :: scratch + I64{1760}
    wrapped :: scratch + I64{1776}
    rt_crypto_x25519_public(identity, own_public, scratch)
    rt_text_bytes_copy(rebuilt, cipher, footer + I64{64})
    at := I64{22}
    found := false
    loop at < footer {
        end :: rt_age_line_end(cipher, cipher_len, at)
        body_end :: rt_age_body_end(cipher, cipher_len, end + I64{1})
        if (!found && rt_age_unwrap(identity, own_public, cipher, at, end, body_end, file_key, scratch) == I64{1}) {
            found = true
            rt_crypto_wipe(nonce, I64{12})
            if (!rt_crypto_aead_seal(wrap_key, nonce, I64{1}, I64{0}, file_key, I64{16}, wrapped, scratch)) -> jet_rt_unreachable(I64{0}, I64{0})
            rt_age_b64_encode(wrapped, I64{32}, rebuilt + end + I64{1})
        }
        at = body_end
    }
    if (!found) -> jet_rt_unreachable(I64{0}, I64{0})
    auth_tag :: scratch + I64{1824}
    rt_age_derive(file_key, I64{16}, I64{1}, I64{0}, I64{0}, wrap_key, scratch)
    rt_crypto_hmac(wrap_key, I64{32}, rebuilt, footer + I64{3}, auth_tag, scratch)
    rt_age_b64_encode(auth_tag, I64{32}, rebuilt + footer + I64{4})
    payload_key :: scratch + I64{1856}
    rt_age_derive(file_key, I64{16}, cipher + footer + I64{48}, I64{16}, I64{1}, payload_key, scratch)
    at = footer + I64{64}
    position := I64{0}
    counter := I64{0}
    loop {
        count := I64{65536}
        if (plain_len - position < count) -> count = plain_len - position
        last :: position + count == plain_len
        rt_age_stream_nonce(counter, last, nonce)
        if (!rt_crypto_aead_seal(payload_key, nonce, I64{1}, I64{0}, plain + position, count, rebuilt + at, scratch)) -> jet_rt_unreachable(I64{0}, I64{0})
        at += count + I64{16}
        position += count
        counter += I64{1}
        if last -> break
    }
    if (at != cipher_len || !rt_crypto_equal(rebuilt, cipher, cipher_len)) -> jet_rt_unreachable(I64{0}, I64{0})
    rt_crypto_wipe(scratch, I64{2048})
}
#Export(c) fn jet_rt_age_open_fixture(identity_text: I64, cipher: I64, cipher_len: I64, expected_hash: I64, check_hash: Bool, valid: Bool) {
    identity :: jet_rt_alloc(I64{32}, I64{1})
    scratch :: jet_rt_alloc(I64{2048}, I64{8})
    plain :: jet_rt_alloc(cipher_len + I64{1}, I64{1})
    rebuilt :: jet_rt_alloc(cipher_len + I64{1}, I64{1})
    digest :: jet_rt_alloc(I64{32}, I64{1})
    if (!rt_age_key_decode(identity_text, I64{74}, true, identity)) -> jet_rt_unreachable(I64{0}, I64{0})
    plain_len :: rt_age_open(identity, cipher, cipher_len, plain, cipher_len, scratch)
    rt_age_fixture_zero(scratch, I64{2048})
    if valid {
        if (plain_len < I64{0}) -> jet_rt_unreachable(I64{0}, I64{0})
        if check_hash {
            rt_sha256_parts(plain, plain_len, I64{1}, I64{0}, digest, scratch)
            if (!rt_crypto_equal(digest, expected_hash, I64{32})) -> jet_rt_unreachable(I64{0}, I64{0})
        }
        rt_age_fixture_rebuild(identity, cipher, cipher_len, plain, plain_len, rebuilt, scratch)
        rt_age_fixture_zero(scratch, I64{2048})
        // A final-tag mismatch must not expose any preceding authenticated chunk.
        rt_text_put(rebuilt + cipher_len - I64{1}, rt_text_byte(rebuilt + cipher_len - I64{1}).bit_xor(I64{1}))
        i := I64{0}
        loop i < cipher_len {
            rt_text_put(plain + i, I64{165})
            i += I64{1}
        }
        if (rt_age_open(identity, rebuilt, cipher_len, plain, cipher_len, scratch) != I64{-1}) -> jet_rt_unreachable(I64{0}, I64{0})
        rt_age_fixture_zero(scratch, I64{2048})
        prior :: if (plain_len == I64{0}) -> I64{0} else -> ((plain_len - I64{1}) / I64{65536}) * I64{65536}
        i = I64{0}
        loop i < cipher_len {
            expected :: if (i < prior) -> I64{0} else -> I64{165}
            if (rt_text_byte(plain + i) != expected) -> jet_rt_unreachable(I64{0}, I64{0})
            i += I64{1}
        }
        if (rt_age_open(identity, cipher, cipher_len - I64{1}, plain, cipher_len, scratch) != I64{-1}) -> jet_rt_unreachable(I64{0}, I64{0})
        rt_age_fixture_zero(scratch, I64{2048})
        if (rt_age_open(identity, cipher, cipher_len, plain, plain_len - I64{1}, scratch) != I64{-1}) -> jet_rt_unreachable(I64{0}, I64{0})
        rt_age_fixture_zero(scratch, I64{2048})
    } else {
        if (plain_len != I64{-1}) -> jet_rt_unreachable(I64{0}, I64{0})
    }
    rt_crypto_wipe(identity, I64{32})
    rt_crypto_wipe(plain, cipher_len + I64{1})
    jet_rt_free(identity, I64{32}, I64{1})
    jet_rt_free(scratch, I64{2048}, I64{8})
    jet_rt_free(plain, cipher_len + I64{1}, I64{1})
    jet_rt_free(rebuilt, cipher_len + I64{1}, I64{1})
    jet_rt_free(digest, I64{32}, I64{1})
}
#Export(c) fn jet_rt_age_seal_fixture(identity_text: I64, plain: I64, plain_len: I64, expected: I64, cipher_len: I64, count: I64, file_key: I64, grease: I64, grease_len: I64, capture: I64) {
    identity :: jet_rt_alloc(I64{32}, I64{1})
    recipients :: jet_rt_alloc(count * I64{32}, I64{1})
    scalars :: jet_rt_alloc(count * I64{32}, I64{1})
    file_nonce :: jet_rt_alloc(I64{16}, I64{1})
    scratch :: jet_rt_alloc(I64{2048}, I64{8})
    if (!rt_age_key_decode(identity_text, I64{74}, true, identity)) -> jet_rt_unreachable(I64{0}, I64{0})
    rt_crypto_x25519_public(identity, recipients, scratch)
    r := I64{1}
    loop r < count {
        rt_text_bytes_copy(recipients + r * I64{32}, recipients, I64{32})
        r += I64{1}
    }
    i := I64{0}
    loop {
        if (i >= count * I64{32}) -> break
        rt_text_put(scalars + i, (i * I64{7} + I64{3}).bit_and(I64{255}))
        i += I64{1}
    }
    i = I64{0}
    loop {
        if (i >= I64{16}) -> break
        rt_text_put(file_nonce + i, (i * I64{13} + I64{11}).bit_and(I64{255}))
        i += I64{1}
    }
    produced :: rt_age_seal(recipients, count, scalars, file_key, file_nonce, grease, grease_len, plain, plain_len, capture, cipher_len, scratch)
    if (produced != cipher_len || !rt_crypto_equal(capture, expected, cipher_len)) -> jet_rt_unreachable(I64{0}, I64{0})
    rt_age_fixture_zero(scratch, I64{2048})
    rt_crypto_wipe(capture, cipher_len)
    if (rt_age_seal(recipients, count, scalars, file_key, file_nonce, grease, grease_len, plain, plain_len, capture, cipher_len - I64{1}, scratch) != I64{-1}) -> jet_rt_unreachable(I64{0}, I64{0})
    rt_age_fixture_zero(capture, cipher_len)
    rt_age_fixture_zero(scratch, I64{2048})
    // Preserve admitted deterministic seals for the one-time Rust opener check.
    if (rt_age_seal(recipients, count, scalars, file_key, file_nonce, grease, grease_len, plain, plain_len, capture, cipher_len, scratch) != cipher_len) -> jet_rt_unreachable(I64{0}, I64{0})
    rt_age_fixture_zero(scratch, I64{2048})
    rt_crypto_wipe(identity, I64{32})
    rt_crypto_wipe(scalars, count * I64{32})
    jet_rt_free(identity, I64{32}, I64{1})
    jet_rt_free(recipients, count * I64{32}, I64{1})
    jet_rt_free(scalars, count * I64{32}, I64{1})
    jet_rt_free(file_nonce, I64{16}, I64{1})
    jet_rt_free(scratch, I64{2048}, I64{8})
}
