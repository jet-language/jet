// Read-only observations of the actual transaction gate and cell state.
#Export(c) jet_rt_sync_fixture_gate_depth: fn() -> I64 { sync_load(stm_root + I64{16}) }
#Export(c) jet_rt_sync_fixture_set_revision: fn(cell: I64, revision: I64) { sync_store(cell + I64{48}, revision) }
#Export(c) jet_rt_sync_fixture_cell_word: fn(cell: I64, offset: I64) -> I64 { sync_load(cell + offset) }
// A panic publishes only inside a stop domain: the rejection witness runs
// its bare control as a task body.
#Export(c) jet_rt_sync_fixture_body_enter: fn() -> I64 { scheduler_body_enter() }
#Export(c) jet_rt_sync_fixture_body_leave: fn(saved: I64) { scheduler_body_leave(saved) }
