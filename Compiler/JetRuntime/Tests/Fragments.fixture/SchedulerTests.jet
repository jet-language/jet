// C supplies code addresses only. Assertions, callbacks and all concurrency
// behavior run in the real Jet scheduler; no fake observer or stop rail.
scheduler_test_require: fn(ok: Bool) {
    if ok {
        return
    }
    _ := os_exit_group_i64(I64{1})
    loop {

    }
}

scheduler_test_env: fn(log: I64, mode: I64, value: I64) -> I64 {
    env: jet_rt_alloc(I64{32}, I64{8})
    thread_zero(env, I64{32})
    sync_store(env, log)
    sync_store(env + I64{8}, mode)
    sync_store(env + I64{16}, value)
    env
}

#Export(c) jet_rt_scheduler_fixture_clone: fn(source: I64, target: I64) {
    sync_store(target, sync_load(source))
}

#Export(c) jet_rt_scheduler_fixture_release: fn(env: I64) {
    _ := sync_add(sync_load(env), I64{1})
    jet_rt_free(env, I64{32}, I64{8})
}

// An exit closure's word at +24 is the exit log: its body appends the id at
// +32 to the order word at +0, its release counts at +8.
#Export(c) jet_rt_scheduler_fixture_exit_body: fn(closure: I64) {
    order: sync_load(closure + I64{24})
    sync_store(order, sync_load(order) * I64{10} + sync_load(closure + I64{32}))
}

#Export(c) jet_rt_scheduler_fixture_exit_release: fn(closure: I64) {
    _ := sync_add(sync_load(closure + I64{24}) + I64{8}, I64{1})
    jet_rt_free(closure, I64{40}, I64{8})
}

#Export(c) jet_rt_scheduler_fixture_exit_worker: fn(arguments: I64) -> I64 {
    closure: jet_rt_alloc(I64{40}, I64{8})
    sync_store(closure, I64{1})
    sync_store(closure + I64{8}, sync_load(arguments))
    sync_store(closure + I64{16}, sync_load(arguments + I64{8}))
    sync_store(closure + I64{24}, sync_load(arguments + I64{16}))
    sync_store(closure + I64{32}, sync_load(arguments + I64{24}))
    jet_rt_native_atexit(closure)
    I64{0}
}

#Export(c) jet_rt_scheduler_fixture_body: fn(env: I64, out: I64) -> I64 {
    mode: sync_load(env + I64{8})
    log: sync_load(env)
    _ := sync_add(log + I64{8}, I64{1})
    if {
        (mode == I64{1}) -> {
            slot: sync_park_new()
            kind: scheduler_msg_join()
            _ := scheduler_yield(kind, slot, I64{-1})
            sync_park_drop(slot)
            jet_rt_string_drop(kind)
            if (jet_scheduler_native_propagate() != I64{0}) { return I64{0} }
        }
        (mode == I64{2}) -> {
            message: scheduler_msg_canceled()
            jet_rt_panic_message(sync_load(message), sync_load(message + I64{8}))
            jet_rt_string_drop(message)
            if (jet_scheduler_native_propagate() != I64{0}) { return I64{0} }
        }
        (mode == I64{3}) -> {
            jet_task_sleep_duration_ns_defaulted(I64{1000000})
            if (jet_scheduler_native_propagate() != I64{0}) { return I64{0} }
        }
    }
    sync_store(out, sync_load(env + I64{16}))
    I64{0}
}

scheduler_test_spawn: fn(callbacks: I64, meta: I64, log: I64, mode: I64, value: I64) -> I64 {
    label: scheduler_text_new(I64{0})
    child: jet_rt_native_task_spawn(I64{17}, label, scheduler_test_env(log, mode, value), sync_load(callbacks), sync_load(callbacks + I64{8}), meta)
    jet_rt_string_drop(label)
    child
}

// An idle carrier's thread (C supplies its address): the carrier of the
// record at +0 sleeps on its own wake word until a claim stores 1, then
// leaves the idle list of the root at +8 (Scheduler.jet
// scheduler_carrier_idle). A wake that reached another word would not end
// its sleep.
#Export(c) jet_rt_scheduler_fixture_sleeper: fn(arguments: I64) -> I64 {
    record: sync_load(arguments)
    root: sync_load(arguments + I64{8})
    word: record + SCHEDULER_CARRIER_WAKE
    loop sync_load(word) == (I64{0}) -> _ := sync_futex_wait(word, I64{0}, I64{-1})
    sync_thread_lock(root)
    scheduler_idle_leave(root, record, I64{-1})
    sync_thread_unlock(root)
    I64{0}
}

// The idle list and its claims, on a root and carrier records of the test's
// own, with no timing: the carrier that idled last is claimed first; a
// claim stores 1 in the claimed carrier's own wake word and in no other, and
// its wake ends that carrier's sleep alone; one claim for work is on its way
// at a time; a claim that lands between a carrier's unlock and its futex
// wait is not lost, as the wait then returns at once; and a carrier back
// unclaimed takes itself off the list. `sleeper` is the address of
// jet_rt_scheduler_fixture_sleeper.
scheduler_test_idle_claims: fn(sleeper: I64) {
    root: jet_rt_alloc(SCHEDULER_ROOT_BYTES, I64{8})
    thread_zero(root, SCHEDULER_ROOT_BYTES)
    records: jet_rt_alloc(SCHEDULER_CARRIER_BYTES * I64{3}, I64{8})
    thread_zero(records, SCHEDULER_CARRIER_BYTES * I64{3})
    first: records
    second: first + SCHEDULER_CARRIER_BYTES
    third: second + SCHEDULER_CARRIER_BYTES
    sync_store(first + SCHEDULER_CARRIER_WAKE, I64{1})
    sync_thread_lock(root)
    scheduler_test_require(scheduler_idle_enter(root, first) == I64{-1})
    scheduler_test_require(scheduler_idle_enter(root, second) == I64{-1} && scheduler_idle_enter(root, third) == I64{-1})
    scheduler_test_require(sync_load(root + I64{120}) == I64{3} && sync_load(root + I64{24}) == third && sync_load(first + SCHEDULER_CARRIER_WAKE) == I64{0})
    // The three carriers unlocked and have not reached their futex waits
    // yet when a submit claims one: the last to idle.
    sync_thread_unlock(root)
    sync_thread_lock(root)
    claimed: scheduler_wake_work(root)
    sync_thread_unlock(root)
    scheduler_kick_idle(claimed)
    scheduler_test_require(claimed == third && sync_load(third + SCHEDULER_CARRIER_WAKE) == I64{1})
    scheduler_test_require(sync_load(second + SCHEDULER_CARRIER_WAKE) == I64{0} && sync_load(first + SCHEDULER_CARRIER_WAKE) == I64{0})
    scheduler_test_require(sync_load(root + I64{160}) == I64{1} && sync_load(root + I64{24}) == second)
    // The claimed carrier's wait, after the claim and its wake, returns at
    // once (-EAGAIN), not at its 10 s deadline (-ETIMEDOUT).
    scheduler_test_require(sync_futex_wait(third + SCHEDULER_CARRIER_WAKE, I64{0}, sync_deadline(I64{10000000000})) == I64{-11})
    sync_thread_lock(root)
    // Until the claimed carrier runs, work claims no other: it claims the
    // next itself once it finds work still waiting.
    scheduler_test_require(scheduler_wake_work(root) == I64{-1})
    scheduler_idle_leave(root, third, I64{-1})
    scheduler_test_require(sync_load(root + I64{160}) == I64{0} && sync_load(root + I64{120}) == I64{2} && sync_load(root + I64{24}) == second)
    sync_thread_unlock(root)
    // The other two sleep on threads of their own. A claim wakes the second,
    // which leaves; the first, whose word no claim touched, stays listed.
    arguments: jet_rt_alloc(I64{32}, I64{8})
    sync_store(arguments, first)
    sync_store(arguments + I64{8}, root)
    sync_store(arguments + I64{16}, second)
    sync_store(arguments + I64{24}, root)
    first_thread: thread_spawn(sleeper, arguments)
    second_thread: thread_spawn(sleeper, arguments + I64{16})
    scheduler_test_require(first_thread > I64{0} && second_thread > I64{0})
    sync_thread_lock(root)
    claimed_second: scheduler_wake_work(root)
    sync_thread_unlock(root)
    scheduler_test_require(claimed_second == second)
    scheduler_kick_idle(claimed_second)
    scheduler_test_require(thread_join(second_thread, I64{0}) == I64{0})
    sync_thread_lock(root)
    scheduler_test_require(sync_load(first + SCHEDULER_CARRIER_WAKE) == I64{0} && sync_load(root + I64{24}) == first)
    scheduler_test_require(sync_load(root + I64{120}) == I64{1} && sync_load(root + I64{160}) == I64{0})
    claimed_first: scheduler_wake_work(root)
    sync_thread_unlock(root)
    scheduler_test_require(claimed_first == first)
    scheduler_kick_idle(claimed_first)
    scheduler_test_require(thread_join(first_thread, I64{0}) == I64{0})
    scheduler_test_require(sync_load(root + I64{24}) == I64{0} && sync_load(root + I64{120}) == I64{0} && sync_load(root + I64{160}) == I64{0})
    // A carrier back unclaimed (its deadline passed) takes itself off the
    // middle of the list and leaves the claims as they were.
    sync_thread_lock(root)
    _ := scheduler_idle_enter(root, first)
    _ := scheduler_idle_enter(root, second)
    _ := scheduler_idle_enter(root, third)
    scheduler_idle_leave(root, second, I64{-1})
    scheduler_test_require(sync_load(root + I64{24}) == third && sync_load(third + SCHEDULER_CARRIER_NEXT) == first && sync_load(root + I64{120}) == I64{2})
    scheduler_test_require(scheduler_wake_work(root) == third && scheduler_wake_work(root) == I64{-1} && sync_load(root + I64{24}) == first)
    sync_thread_unlock(root)
    jet_rt_free(arguments, I64{32}, I64{8})
    jet_rt_free(records, SCHEDULER_CARRIER_BYTES * I64{3}, I64{8})
    jet_rt_free(root, SCHEDULER_ROOT_BYTES, I64{8})
}

#Export(c) jet_rt_scheduler_fixture_run: fn(callbacks: I64) -> I64 {
    meta: jet_rt_alloc(I64{72}, I64{8})
    thread_zero(meta, I64{72})
    sync_store(meta, I64{8})
    sync_store(meta + I64{8}, sync_load(callbacks + I64{16}))
    sync_store(meta + I64{48}, I64{274877906946})
    log: jet_rt_alloc(I64{24}, I64{8})
    thread_zero(log, I64{24})
    // An exit handler belongs to the process: one an OS worker registers
    // survives that worker's normal exit, neither run nor released, and runs
    // at the process exit's handler step between main's earlier and later
    // registrations.
    exit_log: jet_rt_alloc(I64{16}, I64{8})
    thread_zero(exit_log, I64{16})
    exit_args: jet_rt_alloc(I64{32}, I64{8})
    sync_store(exit_args, sync_load(callbacks + I64{32}))
    sync_store(exit_args + I64{8}, sync_load(callbacks + I64{40}))
    sync_store(exit_args + I64{16}, exit_log)
    sync_store(exit_args + I64{24}, I64{1})
    _ := jet_rt_scheduler_fixture_exit_worker(exit_args)
    sync_store(exit_args + I64{24}, I64{2})
    exit_thread: thread_spawn(sync_load(callbacks + I64{24}), exit_args)
    scheduler_test_require(exit_thread > I64{0} && thread_join(exit_thread, I64{0}) == I64{0})
    scheduler_test_require(sync_load(exit_log) == I64{0} && sync_load(exit_log + I64{8}) == I64{0})
    sync_store(exit_args + I64{24}, I64{3})
    _ := jet_rt_scheduler_fixture_exit_worker(exit_args)
    scheduler_test_idle_claims(sync_load(callbacks + I64{48}))
    out: jet_rt_alloc(I64{32}, I64{8})
    root: scheduler_control_new()
    save: jet_rt_alloc(I64{32}, I64{8})
    scheduler_control_enter(root, save)
    // 10k spawn/join, exact outputs and exactly-once environment release.
    at := I64{0}
    loop at < (I64{10000}) {
        child: scheduler_test_spawn(callbacks, meta, log, I64{0}, at)
        scheduler_test_require(jet_rt_native_task_join(child, I64{0}, out) == I64{1})
        scheduler_test_require(sync_load(out) == at)
        at += I64{1}
    }
    scheduler_test_require(sync_load(log) == I64{10000} && sync_load(log + I64{8}) == I64{10000})
    // A group's join returns once its task published its outcome, which may
    // be before the task's carrier, back on its own stack, counts it off the
    // running work. A quiesce right after waits that carrier out: it joins
    // the threads every round and never refuses.
    quiesce_log: jet_rt_alloc(I64{24}, I64{8})
    thread_zero(quiesce_log, I64{24})
    round := I64{0}
    loop round < (I64{1000}) {
        group: jet_rt_native_task_group_new()
        label: scheduler_text_new(I64{0})
        child: jet_rt_native_group_spawn(group, I64{1}, label, scheduler_test_env(quiesce_log, I64{0}, round), sync_load(callbacks), sync_load(callbacks + I64{8}), meta)
        jet_rt_string_drop(label)
        scheduler_test_require(jet_rt_native_task_join(child, I64{0}, out) == I64{1})
        scheduler_test_require(sync_load(out) == round)
        jet_rt_handle_drop_jet_task_group(group)
        scheduler_test_require(jet_rt_scheduler_shutdown() >= I64{0})
        round += I64{1}
    }
    scheduler_test_require(sync_load(quiesce_log) == I64{1000} && sync_load(quiesce_log + I64{8}) == I64{1000})
    jet_rt_free(quiesce_log, I64{24}, I64{8})
    // A cancel is delivered at the task's next check (Scheduler.jet
    // scheduler_check_loops): the poll a loop iteration starts with or the
    // poll after a call. The check takes the attention bit once; the cancel
    // flag stays for the wait points, so no later check delivers it again.
    scheduler_control_cancel(root)
    scheduler_test_require(jet_scheduler_native_poll() == I64{1})
    scheduler_test_require(sync_load(root + I64{24}) & SCHEDULER_ATTEND_CANCEL == I64{0} && sync_load(root + I64{16}) == I64{1})
    scheduler_control_discard_stop(root)
    scheduler_test_require(jet_scheduler_native_poll() == I64{0} && jet_rt_session_propagate() == I64{0})
    sync_store(root + I64{16}, I64{0})
    scheduler_control_cancel(root)
    scheduler_test_require(jet_rt_session_propagate() == I64{1})
    scheduler_control_discard_stop(root)
    sync_store(root + I64{16}, I64{0})
    // An explicit session interrupt is Check-delivered even once its cancel
    // was consumed, and never Propagate-delivered.
    scheduler_control_interrupt(root)
    scheduler_control_cancel_consume(root)
    scheduler_test_require(jet_rt_session_propagate() == I64{0})
    scheduler_test_require(jet_rt_session_poll() == I64{1})
    scheduler_control_discard_stop(root)
    // First stop wins; deadline supersedes cancellation and preserves its text.
    _ := scheduler_control_publish(root, scheduler_stop_new(I64{1}, scheduler_text_new(I64{0})))
    deadline_text: scheduler_msg_deadline_head()
    _ := scheduler_control_publish(root, scheduler_stop_new(I64{2}, deadline_text))
    _ := scheduler_control_publish(root, scheduler_stop_new(I64{3}, scheduler_text_new(I64{0})))
    scheduler_test_require(jet_scheduler_native_status() == I64{2})
    record: scheduler_control_take_stop(root)
    scheduler_test_require(sync_load(record) == I64{2} && sync_load(record + I64{40}) == deadline_text)
    scheduler_stop_drop(record)
    // Nested shields mask a delivered rail but raw status remains observable.
    jet_scheduler_shield_enter()
    jet_scheduler_shield_enter()
    scheduler_control_interrupt(root)
    scheduler_test_require(jet_rt_session_poll() == I64{0})
    jet_scheduler_shield_leave()
    scheduler_test_require(jet_rt_session_propagate() == I64{0})
    jet_scheduler_shield_leave()
    scheduler_test_require(jet_rt_session_status() == I64{1})
    scheduler_control_discard_stop(root)
    // Stops of kinds 3 and 4 cross shields immediately; cancellation waits
    // for the outer shield exit, and is then visible on the same rail. A
    // panic (kind 5) publishes only inside a stop domain (jet_rt_stop_domain):
    // this bare control is neither a process root nor a task body, so it
    // refuses one.
    kind := I64{3}
    loop kind <= (I64{4}) {
        jet_scheduler_shield_enter()
        _ := scheduler_control_publish(root, scheduler_stop_new(kind, scheduler_text_new(I64{0})))
        scheduler_test_require(jet_rt_session_poll() == kind)
        scheduler_test_require(jet_rt_session_propagate() == kind)
        jet_scheduler_shield_leave()
        scheduler_control_discard_stop(root)
        kind += I64{1}
    }
    jet_scheduler_shield_enter()
    scheduler_test_require(!scheduler_control_publish(root, scheduler_stop_new(I64{5}, scheduler_text_new(I64{0}))))
    scheduler_test_require(jet_rt_session_poll() == I64{0})
    jet_scheduler_shield_leave()
    jet_scheduler_shield_enter()
    scheduler_control_cancel(root)
    scheduler_test_require(jet_rt_session_poll() == I64{0})
    scheduler_test_require(jet_rt_session_propagate() == I64{0})
    jet_scheduler_shield_leave()
    scheduler_test_require(jet_rt_session_propagate() == I64{1})
    scheduler_control_discard_stop(root)
    sync_store(root + I64{16}, I64{0})
    sync_store(root + I64{48}, I64{0})
    // Cancel wakes a task parked on a non-arriving event; child failure is typed.
    child: scheduler_test_spawn(callbacks, meta, log, I64{1}, I64{0})
    slot: sync_park_new()
    loop sync_load(log + I64{8}) != (I64{10001}) -> sync_park(slot, I64{1000000})
    jet_rt_native_task_cancel(child)
    scheduler_test_require(jet_rt_native_task_join(child, I64{0}, out) == I64{0})
    failure: sync_load(out)
    scheduler_test_require(jet_rt_record_tag_jet_task_failure(failure) == I64{0})
    jet_rt_handle_drop_jet_task_failure(failure)
    // Intentional task panic produces an owned failure with no stderr report.
    panicked: scheduler_test_spawn(callbacks, meta, log, I64{2}, I64{0})
    scheduler_test_require(jet_rt_native_task_join(panicked, I64{0}, out) == I64{0})
    panic_failure: sync_load(out)
    scheduler_test_require(jet_rt_record_tag_jet_task_failure(panic_failure) == I64{2})
    reason: jet_rt_record_get_jet_task_failure_panicked(panic_failure)
    scheduler_test_require(sync_load(reason + I64{8}) > I64{0})
    jet_rt_string_drop(reason)
    jet_rt_handle_drop_jet_task_failure(panic_failure)
    // Save/restore two nested deadlines, including exact i64 minimum parsing.
    deadline_save: jet_rt_alloc(I64{32}, I64{8})
    jet_ctx_push_deadline(deadline_wall_now_ms() + I64{10000}, deadline_save)
    first: jet_ctx_deadline_ms()
    jet_ctx_push_deadline(first + I64{1000}, deadline_save + I64{16})
    jet_ctx_pop_deadline(deadline_save + I64{16})
    scheduler_test_require(jet_ctx_deadline_ms() == first)
    jet_ctx_pop_deadline(deadline_save)
    scheduler_test_require(!jet_ctx_deadline_present())
    minimum: scheduler_text_new(I64{20})
    sync_store(sync_load(minimum), I64{3618417120593983789})
    sync_store(sync_load(minimum) + I64{8}, I64{3978706198986109744})
    sync_store(sync_load(minimum) + I64{16}, I64{942684213})
    scheduler_test_require(deadline_parse_i64(minimum, out) && sync_load(out) == I64{-9223372036854775808})
    maximum: scheduler_text_new(I64{19})
    coll_copy(sync_load(minimum) + I64{1}, sync_load(maximum), I64{19})
    rt_text_put(sync_load(maximum) + I64{18}, I64{55})
    scheduler_test_require(deadline_parse_i64(maximum, out) && sync_load(out) == I64{9223372036854775807})
    rt_text_put(sync_load(maximum) + I64{18}, I64{56})
    scheduler_test_require(!deadline_parse_i64(maximum, out))
    rt_text_put(sync_load(minimum) + I64{19}, I64{57})
    scheduler_test_require(!deadline_parse_i64(minimum, out))
    rt_text_put(sync_load(maximum) + I64{17}, I64{49})
    rt_text_put(sync_load(maximum) + I64{18}, I64{48})
    rt_text_put(sync_load(minimum) + I64{18}, I64{49})
    rt_text_put(sync_load(minimum) + I64{19}, I64{48})
    scheduler_test_require(!deadline_parse_i64(maximum, out) && !deadline_parse_i64(minimum, out))
    jet_rt_string_drop(maximum)
    sign_only: scheduler_text_new(I64{1})
    rt_text_put(sync_load(sign_only), I64{43})
    scheduler_test_require(!deadline_parse_i64(sign_only, out))
    rt_text_put(sync_load(sign_only), I64{45})
    scheduler_test_require(!deadline_parse_i64(sign_only, out))
    sync_store(sign_only + I64{8}, I64{0})
    scheduler_test_require(!deadline_parse_i64(sign_only, out))
    jet_rt_string_drop(sign_only)
    jet_rt_string_drop(minimum)
    // Real wheel timer wakes, cancellation synchronizes with freeing the slot.
    start: sync_now_ns()
    timer: scheduler_timer_schedule(start + I64{10000000}, slot, I64{0})
    sync_park(slot, I64{100000000})
    scheduler_timer_cancel(timer)
    scheduler_test_require(sync_now_ns() - start >= I64{9000000})
    // A detached task still releases its environment and completes before drain.
    detached: scheduler_test_spawn(callbacks, meta, log, I64{3}, I64{55})
    jet_rt_native_task_detach(detached)
    jet_scheduler_drain_after_exit()
    // Bounded admission can park without starving a one-worker pool. A cloned
    // group handle is non-owning and must not close the lexical owner.
    group: jet_rt_native_task_group_with_limit(I64{1})
    // Admission can claim a permit after a stop was published. Rejected spawn
    // must return that permit/ref and release the callback without registering.
    // The open group holds two refs: its owning handle and the running
    // control's listing of its open groups (TaskGroup.jet task_group_open).
    stopped_state: sync_load(group)
    scheduler_test_require(sync_load(stopped_state) == I64{2})
    label_stopped: scheduler_text_new(I64{0})
    released_before: sync_load(log)
    _ := scheduler_control_publish(root, scheduler_stop_new(I64{1}, scheduler_text_new(I64{0})))
    rejected: jet_rt_native_group_spawn(group, I64{3}, label_stopped, scheduler_test_env(log, I64{0}, I64{0}), sync_load(callbacks), sync_load(callbacks + I64{8}), meta)
    scheduler_test_require(rejected == I64{0} && sync_load(stopped_state + I64{32}) == I64{0})
    scheduler_test_require(sync_load(stopped_state) == I64{2} && sync_load(stopped_state + I64{48}) == I64{0})
    scheduler_test_require(sync_load(log) == released_before + I64{1})
    scheduler_control_discard_stop(root)
    jet_rt_string_drop(label_stopped)
    group_clone: jet_rt_handle_clone_jet_task_group(group)
    jet_rt_handle_drop_jet_task_group(group_clone)
    label: scheduler_text_new(I64{0})
    first_task: jet_rt_native_group_spawn(group, I64{1}, label, scheduler_test_env(log, I64{3}, I64{91}), sync_load(callbacks), sync_load(callbacks + I64{8}), meta)
    second_task: jet_rt_native_group_spawn(group, I64{2}, label, scheduler_test_env(log, I64{0}, I64{92}), sync_load(callbacks), sync_load(callbacks + I64{8}), meta)
    jet_rt_string_drop(label)
    jet_rt_handle_drop_jet_task_group(group)
    handles: jet_rt_alloc(I64{16}, I64{8})
    offsets: jet_rt_alloc(I64{16}, I64{8})
    sync_store(handles, first_task)
    sync_store(handles + I64{8}, second_task)
    sync_store(offsets, I64{0})
    sync_store(offsets + I64{8}, I64{8})
    // `_result` must tolerate non-Result tuple children instead of dereferencing
    // an ordinary machine result as though it were a boxed Result.
    scheduler_test_require(jet_rt_native_task_all_tuple(handles, I64{2}, I64{1}, offsets, out) == I64{1})
    scheduler_test_require(sync_load(out) == I64{91} && sync_load(out + I64{8}) == I64{92})
    jet_rt_free(handles, I64{16}, I64{8})
    jet_rt_free(offsets, I64{16}, I64{8})
    // Every environment released exactly once: the 10000 joined tasks, then
    // the canceled, panicked, detached, rejected and two group tasks.
    scheduler_test_require(sync_load(log) == I64{10006})
    // No fiber stays parked, and the 10000 tasks ran on at most the pool's
    // carriers: a waiting task holds no thread of its own.
    stats: jet_rt_alloc(I64{24}, I64{8})
    scheduler_fiber_stats(stats)
    scheduler_test_require(sync_load(stats) == I64{0} && sync_load(stats + I64{8}) <= sync_load(scheduler_root + I64{112}))
    jet_rt_free(stats, I64{24}, I64{8})
    sync_park_drop(slot)
    jet_rt_free(deadline_save, I64{32}, I64{8})
    scheduler_control_leave(save)
    scheduler_control_drop(root)
    jet_rt_free(save, I64{32}, I64{8})
    jet_rt_free(out, I64{32}, I64{8})
    jet_rt_free(log, I64{24}, I64{8})
    // The process exit's handler step runs each handler once, in
    // registration order, then releases it; a second drain finds none.
    jet_rt_task_exit_handlers()
    scheduler_test_require(sync_load(exit_log) == I64{123} && sync_load(exit_log + I64{8}) == I64{3})
    jet_rt_task_exit_handlers()
    scheduler_test_require(sync_load(exit_log) == I64{123} && sync_load(exit_log + I64{8}) == I64{3})
    jet_rt_free(exit_args, I64{32}, I64{8})
    jet_rt_free(exit_log, I64{16}, I64{8})
    coll_meta_drop(meta)
    I64{0}
}

#Export(c) jet_rt_scheduler_fixture_root_panic: fn() -> I64 {
    message: scheduler_msg_canceled()
    jet_rt_panic_message(sync_load(message), sync_load(message + I64{8}))
    I64{1}
}
