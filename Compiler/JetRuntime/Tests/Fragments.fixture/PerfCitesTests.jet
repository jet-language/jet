// Composed with the Jet-only runtime by
// Tests/Cases/RuntimeFragments/the_perf_cites_fragment_decodes_to_the_samples_kept.case:
// perf_cites_tests keeps CPU-time sample records through the writer every
// buffered record takes (PerfSamples.jet perf_samples_keep, whose side is
// written out by perf_samples_side_write, citing each sample's outermost
// call sites that repeat the sample before's: perf_samples_cite) into a
// memfd begun as a samples file is (perf_samples_header), then reads each
// case's writes back and requires them to decode to exactly the samples
// kept: each its own address, time, task and count word, its call sites its
// own and those it shares of the sample before in the same write, cited
// exactly where that sample shares 2 or more outermost call sites.
// The CLI reads cites the same way (SourceSampling.jet jet_cli_perf_sites,
// Compiler/JetCLI/Tests/Perf.jet). Not Core API.

// A test's words: the memfd, the side, the samples kept, their rows, the
// record being built, and the call sites of the sample before and of the
// sample being decoded.
PERF_CITES_FD: I64{0}

PERF_CITES_SIDE: I64{8}

PERF_CITES_COUNT: I64{16}

PERF_CITES_ROWS: I64{24}

PERF_CITES_RECORD: I64{32}

PERF_CITES_BEFORE: I64{40}

PERF_CITES_NOW: I64{48}

PERF_CITES_BYTES: I64{56}

// A kept sample's row: its address, stack, callers, time, task, the file
// offset its side's next write begins at and its count word.
PERF_CITES_ROW_WORDS: I64{7}

PERF_CITES_MOST: I64{1024}

// The bytes of a record being built, and of each decoded sample's call
// sites: at most 60 callers.
PERF_CITES_RECORD_BYTES: I64{512}

PERF_CITES_CALLERS: I64{60}

// A failed check stops the process (status 101) with what failed on stderr.
perf_cites_require: fn(ok: Bool, what: I64) {
    if ok {
        return
    }
    jet_rt_unreachable(rt_text_data(what), rt_text_len(what))
}

// Call site `k` of stack `stack` with `callers` callers, innermost first:
// stacks whose numbers agree above their low 4 bits agree in each call
// site the same distance from their outermost, and their innermost call
// site adds the low 4 bits, the branch taken there.
perf_cites_frame: fn(stack: I64, k: I64, callers: I64) -> I64 {
    branch: if (k == I64{1}) -> stack & I64{15} else -> I64{0}
    wrapping(wrapping(wrapping(I64{5242880} + wrapping((stack >> I64{4}) * I64{65536})) + wrapping(wrapping(callers - k) * I64{16})) + branch)
}

// How many outermost call sites the samples of rows `earlier` and `later`
// share, as the stacks' frames say.
perf_cites_shared: fn(earlier: I64, later: I64) -> I64 {
    first_stack: rt_text_word(wrapping(earlier + I64{8}))
    first_callers: rt_text_word(wrapping(earlier + I64{16}))
    second_stack: rt_text_word(wrapping(later + I64{8}))
    second_callers: rt_text_word(wrapping(later + I64{16}))
    ^shared: I64{0}
    loop shared < wrapping(first_callers - I64{1}) && shared < wrapping(second_callers - I64{1}) && perf_cites_frame(first_stack, wrapping(wrapping(first_callers - I64{1}) - shared), first_callers) == perf_cites_frame(second_stack, wrapping(wrapping(second_callers - I64{1}) - shared), second_callers) {
        shared = wrapping(shared + I64{1})
    }
    shared
}

// Builds the record of the next sample, on `stack` with `callers` callers,
// in the test's record words: its own address, time, task and count word,
// one of two samplers' (PERF_SAMPLES_TIMED).
perf_cites_build: fn(test: I64, stack: I64, callers: I64) -> I64 {
    n: rt_text_word(wrapping(test + PERF_CITES_COUNT))
    record: rt_text_word(wrapping(test + PERF_CITES_RECORD))
    rt_text_store(record, wrapping(I64{4198400} + wrapping(n * I64{4})) | (wrapping(callers + PERF_SAMPLES_TIMED) << PERF_SAMPLES_ADDRESS_BITS))
    ^k: I64{1}
    loop k < callers {
        rt_text_store(wrapping(record + wrapping(k * I64{8})), perf_cites_frame(stack, k, callers))
        k = wrapping(k + I64{1})
    }
    rt_text_store(wrapping(record + wrapping(callers * I64{8})), wrapping(I64{1000007} + wrapping(n * I64{1000})))
    rt_text_store(wrapping(record + wrapping(wrapping(callers + I64{1}) * I64{8})), wrapping((n % I64{3}) + I64{1}))
    rt_text_store(wrapping(record + wrapping(wrapping(callers + I64{2}) * I64{8})), (wrapping((n % I64{2}) + I64{1}) << PERF_SAMPLES_ADDRESS_BITS) | wrapping(wrapping(n * I64{125000}) + I64{7}))
    record
}

// Keeps the next sample through the writer, and its row.
perf_cites_keep: fn(test: I64, stack: I64, callers: I64) {
    n: rt_text_word(wrapping(test + PERF_CITES_COUNT))
    perf_cites_require(n < PERF_CITES_MOST, rt_static_text("perf cites: more samples than the rows hold"))
    perf_cites_require(callers >= I64{1} && callers <= PERF_CITES_CALLERS, rt_static_text("perf cites: more callers than a record holds"))
    fd: rt_text_word(wrapping(test + PERF_CITES_FD))
    record: perf_cites_build(test, stack, callers)
    perf_samples_keep(fd, rt_text_word(wrapping(test + PERF_CITES_SIDE)), record, wrapping(wrapping(callers + PERF_SAMPLES_TIMED) * I64{8}))
    // lseek(fd, 0, SEEK_CUR): where the side's next write begins.
    block: observe_syscall(I64{8}, fd, I64{0}, I64{1}, I64{0})
    row: wrapping(rt_text_word(wrapping(test + PERF_CITES_ROWS)) + wrapping(wrapping(n * PERF_CITES_ROW_WORDS) * I64{8}))
    rt_text_store(row, rt_text_word(record) & I64{281474976710655})
    rt_text_store(wrapping(row + I64{8}), stack)
    rt_text_store(wrapping(row + I64{16}), callers)
    rt_text_store(wrapping(row + I64{24}), rt_text_word(wrapping(record + wrapping(callers * I64{8}))))
    rt_text_store(wrapping(row + I64{32}), rt_text_word(wrapping(record + wrapping(wrapping(callers + I64{1}) * I64{8}))))
    rt_text_store(wrapping(row + I64{40}), block)
    rt_text_store(wrapping(row + I64{48}), rt_text_word(wrapping(record + wrapping(wrapping(callers + I64{2}) * I64{8}))))
    rt_text_store(wrapping(test + PERF_CITES_COUNT), wrapping(n + I64{1}))
}

// Keeps `times` samples on `stack`.
perf_cites_repeat: fn(test: I64, stack: I64, callers: I64, times: I64) {
    ^at: I64{0}
    loop at < times {
        perf_cites_keep(test, stack, callers)
        at = wrapping(at + I64{1})
    }
}

// Where the file ends: lseek(fd, 0, SEEK_END).
perf_cites_end: fn(test: I64) -> I64 {
    observe_syscall(I64{8}, rt_text_word(wrapping(test + PERF_CITES_FD)), I64{0}, I64{2}, I64{0})
}

// Writes out the records the side holds, as cited.
perf_cites_write: fn(test: I64) {
    side: rt_text_word(wrapping(test + PERF_CITES_SIDE))
    perf_samples_side_write(rt_text_word(wrapping(test + PERF_CITES_FD)), side, rt_text_word(side))
}

// Writes out the side, then reads the file back from byte `from`, the end
// of the case before, each record decoded as the sample of the next row
// from row `first`: a cite exactly where the sample before in its write
// shares 2 or more outermost call sites, sharing just those, and its call
// sites its own. How many records are cites.
perf_cites_decode: fn(test: I64, from: I64, first: I64) -> I64 {
    perf_cites_write(test)
    fd: rt_text_word(wrapping(test + PERF_CITES_FD))
    size: perf_cites_end(test)
    perf_cites_require(size >= from && from >= I64{16}, rt_static_text("perf cites: the file has no header"))
    length: wrapping(size - from)
    bytes: jet_rt_alloc(wrapping(length + I64{8}), I64{8})
    // pread64(fd, bytes, length, from)
    perf_cites_require(observe_syscall(I64{17}, fd, bytes, length, from) == length, rt_static_text("perf cites: the file cannot be read back"))
    rows: rt_text_word(wrapping(test + PERF_CITES_ROWS))
    count: rt_text_word(wrapping(test + PERF_CITES_COUNT))
    ^before: rt_text_word(wrapping(test + PERF_CITES_BEFORE))
    ^now: rt_text_word(wrapping(test + PERF_CITES_NOW))
    // The file offset of the sample before's record, 0 for none; its call
    // sites, in `before`.
    ^previous: I64{0}
    ^depth_before: I64{0}
    ^cites: I64{0}
    ^at: I64{0}
    ^n: first
    loop at < length {
        perf_cites_require(n < count, rt_static_text("perf cites: the file holds more records than samples kept"))
        row: wrapping(rows + wrapping(wrapping(n * PERF_CITES_ROW_WORDS) * I64{8}))
        record: wrapping(bytes + at)
        head: rt_text_word(record)
        words: (head >> PERF_SAMPLES_ADDRESS_BITS) & I64{2047}
        perf_cites_require((head >> PERF_SAMPLES_KIND_BITS) == I64{0} && words > PERF_SAMPLES_TIMED && wrapping(at + wrapping(words * I64{8})) <= length, rt_static_text("perf cites: a record is not a CPU-time sample's"))
        perf_cites_require((head & I64{281474976710655}) == rt_text_word(row), rt_static_text("perf cites: a sample lost its own address"))
        perf_cites_require(rt_text_word(wrapping(record + wrapping(wrapping(words - I64{3}) * I64{8}))) == rt_text_word(wrapping(row + I64{24})), rt_static_text("perf cites: a sample lost its own time"))
        perf_cites_require(rt_text_word(wrapping(record + wrapping(wrapping(words - I64{2}) * I64{8}))) == rt_text_word(wrapping(row + I64{32})), rt_static_text("perf cites: a sample lost its own task"))
        perf_cites_require(rt_text_word(wrapping(record + wrapping(wrapping(words - I64{1}) * I64{8}))) == rt_text_word(wrapping(row + I64{48})), rt_static_text("perf cites: a sample lost its own count word"))
        block: rt_text_word(wrapping(row + I64{40}))
        offset: wrapping(from + at)
        // The sample before shares call sites only within one write: its
        // side held both records.
        same: n > first && block == rt_text_word(wrapping(row + wrapping(I64{40} - wrapping(PERF_CITES_ROW_WORDS * I64{8}))))
        expected: if (same) -> perf_cites_shared(wrapping(row - wrapping(PERF_CITES_ROW_WORDS * I64{8})), row) else -> I64{0}
        ^own: wrapping(wrapping(words - PERF_SAMPLES_TIMED) - I64{1})
        last: if (own > I64{0}) -> rt_text_word(wrapping(record + wrapping(own * I64{8}))) else -> I64{0}
        ^depth: own
        if (last < I64{0}) {
            back: last & I64{4294967295}
            shared: (last >> PERF_SAMPLES_CITE_SHARED) & I64{65535}
            perf_cites_require(previous != I64{0} && wrapping(offset - wrapping(back * I64{8})) == previous, rt_static_text("perf cites: a cite does not reach the sample before it"))
            perf_cites_require(previous >= block, rt_static_text("perf cites: a cite reaches past the write it is in"))
            perf_cites_require(shared >= PERF_SAMPLES_CITE_LEAST && shared <= depth_before, rt_static_text("perf cites: a cite shares fewer call sites than a cite does, or more than the sample before holds"))
            perf_cites_require(shared == expected, rt_static_text("perf cites: a cite shares other call sites than the sample before does"))
            own = wrapping(own - I64{1})
            depth = wrapping(own + shared)
            ^index: I64{0}
            loop index < shared {
                rt_text_store(wrapping(now + wrapping(wrapping(own + index) * I64{8})), rt_text_word(wrapping(before + wrapping(wrapping(wrapping(depth_before - shared) + index) * I64{8}))))
                index = wrapping(index + I64{1})
            }
            cites = wrapping(cites + I64{1})
        } else {
            perf_cites_require(expected < PERF_SAMPLES_CITE_LEAST, rt_static_text("perf cites: a sample sharing call sites with the sample before is whole"))
        }
        perf_samples_words_copy(wrapping(record + I64{8}), now, own)
        callers: rt_text_word(wrapping(row + I64{16}))
        perf_cites_require(wrapping(depth + I64{1}) == callers, rt_static_text("perf cites: a sample's stack has another depth"))
        stack: rt_text_word(wrapping(row + I64{8}))
        ^k: I64{1}
        loop k < callers {
            perf_cites_require(rt_text_word(wrapping(now + wrapping(wrapping(k - I64{1}) * I64{8}))) == perf_cites_frame(stack, k, callers), rt_static_text("perf cites: a sample's call site is not its own"))
            k = wrapping(k + I64{1})
        }
        previous = offset
        depth_before = depth
        swapped: before
        before = now
        now = swapped
        at = wrapping(at + wrapping(words * I64{8}))
        n = wrapping(n + I64{1})
    }
    perf_cites_require(n == count, rt_static_text("perf cites: the file holds fewer records than samples kept"))
    jet_rt_free(bytes, wrapping(length + I64{8}), I64{8})
    cites
}

perf_cites_tests: fn() {
    test: jet_rt_alloc(PERF_CITES_BYTES, I64{8})
    name: jet_rt_alloc(I64{8}, I64{8})
    // "s", NUL-ended: memfd_create(name, MFD_CLOEXEC).
    rt_text_store(name, I64{115})
    fd: observe_syscall(I64{319}, name, I64{1}, I64{0}, I64{0})
    jet_rt_free(name, I64{8}, I64{8})
    perf_cites_require(fd >= I64{0}, rt_static_text("perf cites: memfd_create failed"))
    perf_cites_require(perf_samples_header(fd) == I64{0}, rt_static_text("perf cites: the header cannot begin the file"))
    side_bytes: perf_samples_side_bytes()
    side: jet_rt_alloc(side_bytes, I64{8})
    thread_zero(side, side_bytes)
    rows_bytes: wrapping(wrapping(PERF_CITES_MOST * PERF_CITES_ROW_WORDS) * I64{8})
    sites_bytes: wrapping(PERF_CITES_CALLERS * I64{8})
    rt_text_store(wrapping(test + PERF_CITES_FD), fd)
    rt_text_store(wrapping(test + PERF_CITES_SIDE), side)
    rt_text_store(wrapping(test + PERF_CITES_COUNT), I64{0})
    rt_text_store(wrapping(test + PERF_CITES_ROWS), jet_rt_alloc(rows_bytes, I64{8}))
    rt_text_store(wrapping(test + PERF_CITES_RECORD), jet_rt_alloc(PERF_CITES_RECORD_BYTES, I64{8}))
    rt_text_store(wrapping(test + PERF_CITES_BEFORE), jet_rt_alloc(sites_bytes, I64{8}))
    rt_text_store(wrapping(test + PERF_CITES_NOW), jet_rt_alloc(sites_bytes, I64{8}))

    // Repeated: one stack five times is one whole record and four cites,
    // each sharing all 4 call sites.
    ^from: perf_cites_end(test)
    ^first: rt_text_word(wrapping(test + PERF_CITES_COUNT))
    perf_cites_repeat(test, I64{16}, I64{5}, I64{5})
    perf_cites_require(perf_cites_decode(test, from, first) == I64{4}, rt_static_text("perf cites: a repeated stack is not cited"))

    // Distinct: stacks with no call site in common are each whole; so are
    // samples of one call site, which share too few to cite. Two of two
    // call sites share both, keeping none of their own.
    from = perf_cites_end(test)
    first = rt_text_word(wrapping(test + PERF_CITES_COUNT))
    perf_cites_keep(test, I64{32}, I64{5})
    perf_cites_keep(test, I64{48}, I64{5})
    perf_cites_keep(test, I64{64}, I64{5})
    perf_cites_repeat(test, I64{80}, I64{2}, I64{2})
    perf_cites_repeat(test, I64{96}, I64{3}, I64{2})
    perf_cites_require(perf_cites_decode(test, from, first) == I64{1}, rt_static_text("perf cites: a distinct stack is cited, or two of two call sites are not"))

    // Alternating branches: each sample's innermost call site is another
    // branch, so each cites the outermost 4 of the one before.
    from = perf_cites_end(test)
    first = rt_text_word(wrapping(test + PERF_CITES_COUNT))
    ^branch: I64{0}
    loop branch < (I64{6}) {
        perf_cites_keep(test, wrapping(I64{112} + wrapping((branch % I64{2}) + I64{1})), I64{6})
        branch = wrapping(branch + I64{1})
    }
    perf_cites_require(perf_cites_decode(test, from, first) == I64{5}, rt_static_text("perf cites: an alternating branch does not cite the call sites under it"))

    // Deep recursion: in from 2 call sites to 27 and back out, 7448 bytes,
    // one write; each sample cites the call sites the one before shares
    // with it.
    from = perf_cites_end(test)
    first = rt_text_word(wrapping(test + PERF_CITES_COUNT))
    ^deep: I64{3}
    loop deep <= (I64{28}) {
        perf_cites_keep(test, I64{128}, deep)
        deep = wrapping(deep + I64{1})
    }
    deep = I64{27}
    loop deep >= (I64{3}) {
        perf_cites_keep(test, I64{128}, deep)
        deep = wrapping(deep - I64{1})
    }
    perf_cites_require(perf_cites_decode(test, from, first) == I64{50}, rt_static_text("perf cites: a recursion's call sites are not cited"))

    // A write's boundary: one stack repeats until the side is written out
    // as it fills; the first record of the next write is whole, and every
    // other one cites the sample before.
    from = perf_cites_end(test)
    first = rt_text_word(wrapping(test + PERF_CITES_COUNT))
    perf_cites_keep(test, I64{144}, I64{6})
    written: perf_cites_end(test)
    ^crossed: false
    ^tries: I64{0}
    loop !crossed && tries < (I64{512}) {
        perf_cites_keep(test, I64{144}, I64{6})
        crossed = perf_cites_end(test) != written
        tries = wrapping(tries + I64{1})
    }
    perf_cites_require(crossed, rt_static_text("perf cites: the side was never written out"))
    perf_cites_keep(test, I64{144}, I64{6})
    perf_cites_require(perf_cites_decode(test, from, first) == tries, rt_static_text("perf cites: a cite crosses a write, or a repeat within one is not cited"))

    // Random stacks: recursion in and out, branches taken in turn, jumps
    // of depth, other stacks and writes at random, each decoded exactly.
    from = perf_cites_end(test)
    first = rt_text_word(wrapping(test + PERF_CITES_COUNT))
    ^state: I64{20261118}
    ^stack: I64{160}
    ^callers: I64{4}
    ^kept: I64{0}
    loop kept < (I64{300}) {
        state = wrapping(wrapping(state * I64{1103515245}) + I64{12345}) & I64{2147483647}
        choice: (state >> I64{8}) % I64{8}
        if (choice <= I64{2}) {
            if (callers < PERF_CITES_CALLERS) { callers = wrapping(callers + I64{1}) }
        } else if (choice <= I64{4}) {
            if (callers > I64{1}) { callers = wrapping(callers - I64{1}) }
        } else if (choice == I64{5}) { stack = (stack & I64{-16}) | ((stack & I64{15}) ~ I64{1}) } else if (choice == I64{6}) {
            callers = if (callers > I64{24}) -> I64{3} else -> wrapping(callers + I64{20})
        } else if (((state >> I64{12}) % I64{4}) == I64{0}) {
            stack = wrapping(I64{160} + wrapping(((state >> I64{14}) % I64{4}) * I64{16}))
        }
        perf_cites_keep(test, stack, callers)
        if (((state >> I64{16}) % I64{37}) == I64{0}) { perf_cites_write(test) }
        kept = wrapping(kept + I64{1})
    }
    perf_cites_require(perf_cites_decode(test, from, first) > I64{0}, rt_static_text("perf cites: no random stack is cited"))

    ^_: observe_syscall(I64{3}, fd, I64{0}, I64{0}, I64{0})
    jet_rt_free(rt_text_word(wrapping(test + PERF_CITES_NOW)), sites_bytes, I64{8})
    jet_rt_free(rt_text_word(wrapping(test + PERF_CITES_BEFORE)), sites_bytes, I64{8})
    jet_rt_free(rt_text_word(wrapping(test + PERF_CITES_RECORD)), PERF_CITES_RECORD_BYTES, I64{8})
    jet_rt_free(rt_text_word(wrapping(test + PERF_CITES_ROWS)), rows_bytes, I64{8})
    jet_rt_free(side, side_bytes, I64{8})
    jet_rt_free(test, PERF_CITES_BYTES, I64{8})
}
