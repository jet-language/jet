// Isolated native carrier witness; assembled with the runtime source manifest.
// Every pointer inspection owns live allocated storage, never freed bytes.
// stdout exactly "secret tests: ok\n", exit0; a failed condition exits1.
fn secret_test_require(ok: Bool) {
    if ok -> return
    #Unsafe("a failed isolated Secret witness terminates this test process") {
        _ := os_syscall_i64(I64{231}, I64{1}, I64{0}, I64{0}, I64{0}, I64{0}, I64{0})
    }
    loop {}
}

fn secret_test_header(length: I64, capacity: I64, data: I64) -> I64 {
    header :: jet_rt_alloc(I64{24}, I64{8})
    #Unsafe("header is fresh aligned24B storage owned by the test; data owns cap times the host U8 stride bytes or is zero for an empty List") {
        os_store_i64(header, length)
        os_store_i64(wrapping(header + I64{8}), capacity)
        os_store_i64(wrapping(header + I64{16}), data)
    }
    header
}

fn secret_test_live(pointer: I64) -> I64 {
    #Unsafe("the pointer is a live small allocation; this isolated test is the sole allocator user and can inspect its retained slab metadata") {
        slab :: os_load_i64(wrapping(pointer - I64{16}))
        return os_load_i64(wrapping(slab + I64{24}))
    }
}

fn secret_test_owned() {
    capacity :: I64{32} /% RT_HOST_U8_STRIDE
    allocation_bytes :: capacity * RT_HOST_U8_STRIDE
    data :: jet_rt_alloc(allocation_bytes, I64{8})
    input :: secret_test_header(I64{3}, capacity, data)
    secret :: jet_rt_secret_from_bytes(input)
    secret_test_require(secret_test_live(secret) == I64{3})
    #Unsafe("input and secret are distinct live headers; adoption leaves one live buffer owner and borrowed bytes alias only that parent's header") {
        secret_test_require(os_load_i64(input) == I64{0})
        secret_test_require(os_load_i64(wrapping(input + I64{8})) == I64{0})
        secret_test_require(os_load_i64(wrapping(input + I64{16})) == I64{0})
        borrowed :: jet_rt_secret_bytes(secret)
        secret_test_require(borrowed == secret)
        secret_test_require(os_load_i64(borrowed) == I64{3})
        secret_test_require(os_load_i64(wrapping(borrowed + I64{8})) == capacity)
        secret_test_require(os_load_i64(wrapping(borrowed + I64{16})) == data)
        at := I64{0}
        loop at < allocation_bytes {
            os_store_u8(wrapping(data + at), I64{165})
            at = wrapping(at + I64{1})
        }
        // Fixed-length Write aliases parent storage at the canonical U8 stride.
        os_store_u8(wrapping(os_load_i64(wrapping(borrowed + I64{16})) + RT_HOST_U8_STRIDE), I64{71})
        secret_test_require(os_load_u8(wrapping(data + RT_HOST_U8_STRIDE)) == I64{71})
        secret_test_require(os_load_u8(wrapping(data + I64{2} * RT_HOST_U8_STRIDE)) == I64{165})
    }
    initialized_bytes :: I64{3} * RT_HOST_U8_STRIDE
    rt_secret_zero(data, initialized_bytes)
    #Unsafe("the test owns data and checks the initialized U8 slots, including epoch padding, before any release") {
        at := I64{0}
        loop at < initialized_bytes {
            secret_test_require(os_load_u8(wrapping(data + at)) == I64{0})
            os_store_u8(wrapping(data + at), I64{213})
            at = wrapping(at + I64{1})
        }
        secret_test_require(os_load_u8(wrapping(data + initialized_bytes)) == I64{165})
    }
    jet_rt_secret_close(secret)
    secret_test_require(secret_test_live(secret) == I64{2})
    #Unsafe("secret still owns its live24B header after Close; the buffer was released, and no pointer into it is used") {
        secret_test_require(os_load_i64(secret) == I64{0})
        secret_test_require(os_load_i64(wrapping(secret + I64{8})) == I64{0})
        secret_test_require(os_load_i64(wrapping(secret + I64{16})) == I64{0})
    }
    jet_rt_secret_close(secret)
    secret_test_require(secret_test_live(secret) == I64{2})
    // Reacquire storage as a NEW live owner. The slab allocator uses its first
    // word for the free link; all remaining capacity, including the nonzero
    // spare storage past len3 in the canonical capacity, must be wiped.
    reused :: jet_rt_alloc(allocation_bytes, I64{8})
    secret_test_require(reused == data)
    #Unsafe("reused is newly allocated live32B storage exclusively owned by this witness, not a read of freed storage") {
        at := I64{8}
        loop at < allocation_bytes {
            secret_test_require(os_load_u8(wrapping(reused + at)) == I64{0})
            at = wrapping(at + I64{1})
        }
    }
    jet_rt_free(reused, allocation_bytes, I64{8})
    jet_rt_secret_drop(secret)
    secret_test_require(secret_test_live(input) == I64{1})
    jet_rt_free(input, I64{24}, I64{8})
}

fn secret_test_empty() {
    input :: secret_test_header(I64{0}, I64{0}, I64{0})
    secret :: jet_rt_secret_from_bytes(input)
    jet_rt_secret_close(secret)
    jet_rt_secret_close(secret)
    secret_test_require(secret_test_live(secret) == I64{2})
    jet_rt_secret_drop(secret)
    secret_test_require(secret_test_live(input) == I64{1})
    jet_rt_free(input, I64{24}, I64{8})
}

fn secret_test_storage_size() {
    capacity :: I64{4}
    allocation_size :: capacity * RT_HOST_U8_STRIDE
    // Close supplies this production byte count to BOTH rt_secret_zero and
    // jet_rt_free. Compare it to the real List allocation, not a private stride.
    wipe_and_free_size :: rt_secret_buffer_bytes(capacity)
    secret_test_require(wipe_and_free_size == allocation_size)
    data :: jet_rt_alloc(allocation_size, I64{8})
    #Unsafe("data is this test's live List allocation; every capacity byte is dirtied before the wipe") {
        at := I64{0}
        loop at < allocation_size {
            os_store_u8(data + at, I64{213})
            at += I64{1}
        }
    }
    rt_secret_zero(data, wipe_and_free_size)
    #Unsafe("the same live allocation remains exclusively owned while this test checks all wiped bytes") {
        at := I64{0}
        loop at < allocation_size {
            secret_test_require(os_load_u8(data + at) == I64{0})
            at += I64{1}
        }
    }
    input :: secret_test_header(I64{3}, capacity, data)
    secret :: jet_rt_secret_from_bytes(input)
    jet_rt_secret_drop(secret)
    jet_rt_free(input, I64{24}, I64{8})
}

// A buffer another List still holds, or a frozen one, is never adopted: the
// Secret wipes and frees what it holds, so it takes a copy of the bytes, and
// the moved header's reference to the shared buffer is released.
fn secret_test_shared() {
    capacity :: I64{32} /% RT_HOST_U8_STRIDE
    bytes :: capacity * RT_HOST_U8_STRIDE
    data :: jet_rt_alloc(bytes, I64{8})
    #Unsafe("data is this test's fresh live allocation of bytes bytes") {
        at := I64{0}
        loop at < bytes {
            os_store_u8(wrapping(data + at), I64{165})
            at = wrapping(at + I64{1})
        }
    }
    // The other holder's reference.
    jet_rt_block_retain(data)
    input :: secret_test_header(I64{3}, capacity, data)
    secret :: jet_rt_secret_from_bytes(input)
    initialized_bytes :: I64{3} * RT_HOST_U8_STRIDE
    #Unsafe("secret is a live Secret header over its own buffer; data stays live through the retained reference") {
        own :: os_load_i64(wrapping(secret + I64{16}))
        secret_test_require(own != data)
        secret_test_require(os_load_i64(secret) == I64{3})
        secret_test_require(os_load_i64(wrapping(secret + I64{8})) == I64{3})
        secret_test_require(os_load_i64(input) == I64{0} && os_load_i64(wrapping(input + I64{16})) == I64{0})
        secret_test_require(jet_rt_block_unique(data))
        at := I64{0}
        loop at < initialized_bytes {
            secret_test_require(os_load_u8(wrapping(own + at)) == I64{165})
            at = wrapping(at + I64{1})
        }
    }
    jet_rt_secret_close(secret)
    #Unsafe("data is still live: the other holder's reference was never released") {
        at := I64{0}
        loop at < bytes {
            secret_test_require(os_load_u8(wrapping(data + at)) == I64{165})
            at = wrapping(at + I64{1})
        }
    }
    jet_rt_secret_drop(secret)
    // A frozen buffer (capacity 0) is copied the same way and never released.
    frozen_input :: secret_test_header(I64{3}, I64{0}, data)
    frozen :: jet_rt_secret_from_bytes(frozen_input)
    #Unsafe("frozen is a live Secret header over its own buffer") {
        secret_test_require(os_load_i64(wrapping(frozen + I64{16})) != data)
        secret_test_require(os_load_i64(wrapping(frozen + I64{8})) == I64{3})
    }
    secret_test_require(secret_test_registered(frozen) >= I64{1})
    jet_rt_secret_drop(frozen)
    secret_test_require(jet_rt_block_unique(data))
    jet_rt_free(data, bytes, I64{8})
    jet_rt_free(input, I64{24}, I64{8})
    jet_rt_free(frozen_input, I64{24}, I64{8})
}

// The registered Secrets a crash scrub reaches: the live one, never a closed
// one. Returns how many are registered, and requires `only` to be one of them.
fn secret_test_registered(only: I64) -> I64 {
    count := I64{0}
    found := false
    page := sync_load(secret_root)
    loop page != (I64{0}) {
        word := wrapping(page + I64{8})
        loop word < wrapping(page + I64{4096}) {
            entry :: sync_load(word)
            if (entry != I64{0}) -> count = wrapping(count + I64{1})
            if (entry == only) -> found = true
            word = wrapping(word + I64{8})
        }
        page = sync_load(page)
    }
    secret_test_require(found)
    count
}

// #5478: an ending process zeroes every live Secret's bytes (spare capacity
// too) and leaves its header; a closed Secret is no longer registered.
fn secret_test_scrub() {
    jet_rt_secret_init()
    capacity :: I64{32} /% RT_HOST_U8_STRIDE
    bytes :: capacity * RT_HOST_U8_STRIDE
    kept_data :: jet_rt_alloc(bytes, I64{8})
    closed_data :: jet_rt_alloc(bytes, I64{8})
    #Unsafe("both buffers are this test's fresh live allocations of bytes bytes") {
        at := I64{0}
        loop at < bytes {
            os_store_u8(wrapping(kept_data + at), I64{165})
            os_store_u8(wrapping(closed_data + at), I64{165})
            at = wrapping(at + I64{1})
        }
    }
    kept_input :: secret_test_header(I64{3}, capacity, kept_data)
    kept :: jet_rt_secret_from_bytes(kept_input)
    closed_input :: secret_test_header(I64{3}, capacity, closed_data)
    closed :: jet_rt_secret_from_bytes(closed_input)
    secret_test_require(secret_test_registered(kept) == I64{2})
    jet_rt_secret_close(closed)
    secret_test_require(secret_test_registered(kept) == I64{1})
    secret_scrub()
    // The scrub marks the process ending; this witness goes on.
    main_process_ending = I64{0}
    #Unsafe("kept is a live Secret header and kept_data its live buffer; the scrub only zeroes the buffer") {
        secret_test_require(os_load_i64(kept) == I64{3})
        secret_test_require(os_load_i64(wrapping(kept + I64{8})) == capacity)
        secret_test_require(os_load_i64(wrapping(kept + I64{16})) == kept_data)
        at := I64{0}
        loop at < bytes {
            secret_test_require(os_load_u8(wrapping(kept_data + at)) == I64{0})
            at = wrapping(at + I64{1})
        }
    }
    jet_rt_secret_drop(kept)
    jet_rt_secret_drop(closed)
    jet_rt_free(kept_input, I64{24}, I64{8})
    jet_rt_free(closed_input, I64{24}, I64{8})
}

fn run() {
    jet_rt_alloc_init()
    secret_test_owned()
    secret_test_empty()
    secret_test_storage_size()
    secret_test_scrub()
    secret_test_shared()
    #Unsafe("this isolated native witness writes its17B success literal and exits without introducing any text or collection runtime dependency") {
        message :: jet_rt_alloc(I64{17}, I64{1})
        os_store_u8(message, I64{115})
        os_store_u8(wrapping(message + I64{1}), I64{101})
        os_store_u8(wrapping(message + I64{2}), I64{99})
        os_store_u8(wrapping(message + I64{3}), I64{114})
        os_store_u8(wrapping(message + I64{4}), I64{101})
        os_store_u8(wrapping(message + I64{5}), I64{116})
        os_store_u8(wrapping(message + I64{6}), I64{32})
        os_store_u8(wrapping(message + I64{7}), I64{116})
        os_store_u8(wrapping(message + I64{8}), I64{101})
        os_store_u8(wrapping(message + I64{9}), I64{115})
        os_store_u8(wrapping(message + I64{10}), I64{116})
        os_store_u8(wrapping(message + I64{11}), I64{115})
        os_store_u8(wrapping(message + I64{12}), I64{58})
        os_store_u8(wrapping(message + I64{13}), I64{32})
        os_store_u8(wrapping(message + I64{14}), I64{111})
        os_store_u8(wrapping(message + I64{15}), I64{107})
        os_store_u8(wrapping(message + I64{16}), I64{10})
        _ := os_syscall_i64(I64{1}, I64{1}, message, I64{17}, I64{0}, I64{0}, I64{0})
        jet_rt_free(message, I64{17}, I64{1})
        _ := os_syscall_i64(I64{231}, I64{0}, I64{0}, I64{0}, I64{0}, I64{0}, I64{0})
    }
}
