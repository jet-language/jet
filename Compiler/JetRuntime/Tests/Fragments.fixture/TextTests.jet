// Runtime-only ownership/UTF-8 witnesses; no String-valued test scaffolding.
fn text_test_require(ok: Bool) {
    if ok {
        return
    }
    #Unsafe("a failed text runtime witness terminates only its isolated process") {
        _ := os_syscall_i64(I64{231}, I64{1}, I64{0}, I64{0}, I64{0}, I64{0}, I64{0})
    }
    loop {

    }
}

fn text_test_word(word: I64, len: I64) -> I64 {
    value :: jet_rt_string_builder_new()
    rt_text_push_word(value, word, len)
    value
}

fn text_test_piece(state: I64, expected: I64) {
    slot :: text_iter_pull(state)
    text_test_require(slot != I64{0})
    value :: rt_text_word(slot)
    text_test_require(jet_rt_string_eq(value, expected))
    jet_rt_string_drop(value)
    jet_rt_free(slot, I64{8}, I64{8})
}

fn text_test_find_reference(data: I64, len: I64, pattern: I64, n: I64, start: I64, last: Bool) -> I64 {
    if n > len - start -> return I64{-1}
    at := if last -> len - n else -> start
    loop at >= start && at <= len - n {
        if rt_text_equal_bytes(data + at, pattern, n) -> return at
        if last -> at -= I64{1} else { at += I64{1} }
    }
    I64{-1}
}

fn text_test_search() {
    // Exhaust short binary-alphabet haystacks and needles, both directions
    // and every start offset: exercise periodic/nonperiodic factorization.
    data :: jet_rt_alloc(I64{6}, I64{1})
    pattern :: jet_rt_alloc(I64{3}, I64{1})
    len := I64{0}
    loop len <= (I64{6}) {
        bits := I64{0}
        loop bits < (I64{1} << len) {
            at := I64{0}
            loop at < len {
                rt_text_put(data + at, I64{97} + ((bits >> at).bit_and(I64{1})))
                at += I64{1}
            }
            n := I64{0}
            loop n <= (I64{3}) {
                needle_bits := I64{0}
                loop needle_bits < (I64{1} << n) {
                    at = I64{0}
                    loop at < n {
                        rt_text_put(pattern + at, I64{97} + ((needle_bits >> at).bit_and(I64{1})))
                        at += I64{1}
                    }
                    start := I64{0}
                    loop start <= len {
                        text_test_require(rt_text_find_bytes(data, len, pattern, n, start, false) == text_test_find_reference(data, len, pattern, n, start, false))
                        text_test_require(rt_text_find_bytes(data, len, pattern, n, start, true) == text_test_find_reference(data, len, pattern, n, start, true))
                        start += I64{1}
                    }
                    needle_bits += I64{1}
                }
                n += I64{1}
            }
            bits += I64{1}
        }
        len += I64{1}
    }
    jet_rt_free(pattern, I64{3}, I64{1})
    jet_rt_free(data, I64{6}, I64{1})
}

// Bounded, single-threaded cases do not fill a slab or allocate directly.
fn text_test_live(width: I64) -> I64 { alloc_live_blocks(width) }

fn text_test_concat() {
    snapshot :: jet_rt_alloc(I64{64}, I64{8})
    width := I64{32}
    at := I64{0}
    loop at < (I64{8}) {
        rt_text_store(snapshot + at * I64{8}, text_test_live(width))
        width *= I64{2}
        at += I64{1}
    }
    case := I64{0}
    loop case < (I64{7}) {
        left :: jet_rt_string_builder_new()
        right :: if (case == I64{5}) -> left else -> jet_rt_string_builder_new()
        if (case == I64{0} || case == I64{3} || case == I64{5}) {
            rt_text_push_word(left, I64{6513249}, I64{3})
        }
        if (case == I64{0} || case == I64{2}) { rt_text_push_word(right, I64{8026488}, I64{3}) }
        if (case == I64{1}) {
            rt_text_push_scalar(left, I64{233})
            rt_text_push_scalar(right, I64{128578})
        }
        if (case == I64{6}) {
            rt_text_push_scalar(left, I64{97})
            rt_text_push_scalar(left, I64{0})
            rt_text_push_scalar(right, I64{98})
        }
        left_len :: rt_text_len(left)
        right_len :: rt_text_len(right)
        len :: left_len + right_len
        joined :: jet_rt_string_concat(left, right)
        text_test_require(joined != left && joined != right)
        text_test_require(rt_text_len(joined) == len && rt_text_word(joined + I64{16}) == len)
        data :: rt_text_data(joined)
        if (len == I64{0}) { text_test_require(data == I64{1}) } else {
            text_test_require(data != rt_text_data(left) && data != rt_text_data(right))
        }
        at = I64{0}
        loop at < len {
            expected :: if (at < left_len) -> rt_text_byte(rt_text_data(left) + at) else -> rt_text_byte(rt_text_data(right) + at - left_len)
            text_test_require(rt_text_byte(data + at) == expected)
            at += I64{1}
        }
        jet_rt_string_drop(left)
        if (case != I64{5}) { jet_rt_string_drop(right) }
        // Inputs can die before the independent result's bytes are inspected.
        if (len != I64{0}) {
            text_test_require(rt_text_byte(data) == (if (case == I64{1}) -> I64{195} else if (case == I64{2}) -> I64{120} else -> I64{97}))
        }
        jet_rt_string_drop(joined)
        width = I64{32}
        at = I64{0}
        loop at < (I64{8}) {
            text_test_require(text_test_live(width) == rt_text_word(snapshot + at * I64{8}))
            width *= I64{2}
            at += I64{1}
        }
        case += I64{1}
    }
    jet_rt_free(snapshot, I64{64}, I64{8})
}

fn text_test_routes() {
    empty :: jet_rt_string_builder_new()
    unicode :: jet_rt_string_builder_new()
    rt_text_push_scalar(unicode, I64{65})
    rt_text_push_scalar(unicode, I64{233})
    rt_text_push_scalar(unicode, I64{128512})
    copied :: jet_string_copy(unicode)
    text_test_require(copied != unicode && jet_rt_string_eq(copied, unicode))
    text_test_require(jet_int_owned_to_i64(jet_string_count_bytes(unicode)) == I64{7})
    slot :: jet_rt_alloc(I64{8}, I64{8})
    text_test_require(jet_string_chars(unicode, slot) == I64{3})
    column :: rt_text_word(slot)
    text_test_require(rt_text_word(column) == I64{65} && rt_text_word(column + I64{8}) == I64{233} && rt_text_word(column + I64{16}) == I64{128512})
    jet_rt_free(column, I64{24}, I64{8})
    text_test_require(jet_string_chars(empty, slot) == I64{0} && rt_text_word(slot) == I64{0})
    lines :: jet_rt_string_builder_new()
    rt_text_push_scalar(lines, I64{13})
    rt_text_push_scalar(lines, I64{10})
    jet_rt_string_builder_push(lines, unicode)
    rt_text_push_scalar(lines, I64{13})
    rt_text_push_scalar(lines, I64{10})
    rt_text_push_scalar(lines, I64{13})
    text_test_require(jet_string_lines(lines, slot) == I64{3})
    column2 :: rt_text_word(slot)
    first :: rt_text_word(column2)
    second :: rt_text_word(column2 + I64{8})
    last :: rt_text_word(column2 + I64{16})
    text_test_require(jet_string_is_empty(first) && jet_rt_string_eq(second, unicode))
    text_test_require(rt_text_len(last) == I64{1} && rt_text_byte(rt_text_data(last)) == I64{13})
    jet_rt_string_drop(first)
    jet_rt_string_drop(second)
    jet_rt_string_drop(last)
    jet_rt_free(column2, I64{24}, I64{8})
    text_test_require(jet_string_lines(empty, slot) == I64{0} && rt_text_word(slot) == I64{0})
    newline :: text_test_word(I64{10}, I64{1})
    text_test_require(jet_string_lines(newline, slot) == I64{1})
    column3 :: rt_text_word(slot)
    text_test_require(jet_string_is_empty(rt_text_word(column3)))
    jet_rt_string_drop(rt_text_word(column3))
    jet_rt_free(column3, I64{8}, I64{8})
    repeated :: jet_string_repeat(unicode, jet_int_owned_from_i64(I64{3}))
    text_test_require(rt_text_len(repeated) == I64{21} && jet_char_len(repeated) == I64{9})
    text_test_require(rt_text_equal_bytes(rt_text_data(repeated) + I64{14}, rt_text_data(unicode), I64{7}))
    negative :: jet_string_repeat(unicode, jet_int_owned_from_i64(I64{-1}))
    huge :: jet_int_owned_from_i64(I64{9223372036854775807})
    huge_empty :: jet_string_repeat(empty, huge)
    int_discard(huge)
    text_test_require(jet_string_is_empty(negative) && jet_string_is_empty(huge_empty))
    ascii :: text_test_word(I64{65}, I64{1})
    changed :: jet_string_replace(unicode, ascii, empty)
    text_test_require(jet_char_len(changed) == I64{2} && rt_text_decode(rt_text_data(changed)) == I64{233})
    inserted :: jet_string_replace(unicode, empty, ascii)
    text_test_require(jet_char_len(inserted) == I64{7} && rt_text_len(inserted) == I64{11})
    unchanged :: jet_string_replace(unicode, newline, ascii)
    text_test_require(unchanged != unicode && jet_rt_string_eq(unchanged, unicode))
    lower :: jet_text_ascii_lower(unicode)
    upper :: jet_text_ascii_upper(lower)
    text_test_require(rt_text_byte(rt_text_data(lower)) == I64{97} && jet_rt_string_eq(upper, unicode))
    text_test_require(rt_text_equal_bytes(rt_text_data(lower) + I64{1}, rt_text_data(unicode) + I64{1}, I64{6}))
    sliced :: jet_string_slice_builtin(unicode, jet_int_owned_from_i64(I64{1}), jet_int_owned_from_i64(I64{3}))
    located :: jet_string_slice(unicode, jet_int_owned_from_i64(I64{1}), jet_int_owned_from_i64(I64{3}), empty, jet_int_owned_from_i64(I64{0}))
    exhausted :: jet_string_slice_builtin(unicode, jet_int_owned_from_i64(I64{3}), jet_int_owned_from_i64(I64{3}))
    text_test_require(jet_rt_string_eq(sliced, changed) && jet_rt_string_eq(located, sliced) && jet_string_is_empty(exhausted))
    jet_rt_string_drop(exhausted)
    jet_rt_string_drop(located)
    jet_rt_string_drop(sliced)
    jet_rt_string_drop(upper)
    jet_rt_string_drop(lower)
    jet_rt_string_drop(unchanged)
    jet_rt_string_drop(inserted)
    jet_rt_string_drop(changed)
    jet_rt_string_drop(ascii)
    jet_rt_string_drop(huge_empty)
    jet_rt_string_drop(negative)
    jet_rt_string_drop(repeated)
    jet_rt_string_drop(newline)
    jet_rt_string_drop(lines)
    jet_rt_free(slot, I64{8}, I64{8})
    jet_rt_string_drop(copied)
    jet_rt_string_drop(unicode)
    jet_rt_string_drop(empty)
}

fn text_tests() {
    jet_rt_alloc_init()
    text_test_concat()
    text_test_search()
    text_test_routes()
    empty :: jet_rt_string_builder_new()
    text_test_require(rt_text_data(empty) == I64{1} && rt_text_word(empty + I64{16}) == I64{0})
    text_test_require(jet_string_is_empty(empty) && jet_char_len(empty) == I64{0})
    word :: text_test_word(I64{6513249}, I64{3})  // abc
    clone :: jet_rt_string_clone(word)
    text_test_require(word != clone && rt_text_data(word) != rt_text_data(clone))
    text_test_require(jet_rt_string_eq(word, clone) && jet_rt_string_compare(word, clone) == I64{0})
    suffix :: text_test_word(I64{25442}, I64{2})  // bc
    text_test_require(jet_string_contains(word, suffix) && jet_string_ends_with(word, suffix))
    text_test_require(!jet_string_starts_with(word, suffix) && jet_string_starts_with(word, empty) && jet_string_ends_with(word, empty))
    text_test_require(jet_rt_string_compare(word, suffix) == I64{-1} && jet_rt_string_compare(suffix, word) == I64{1})
    after :: jet_string_after(word, suffix)
    before :: jet_string_before(word, suffix)
    text_test_require(jet_string_is_empty(after) && rt_text_len(before) == I64{1} && rt_text_byte(rt_text_data(before)) == I64{97})
    miss :: text_test_word(I64{122}, I64{1})
    unchanged :: jet_string_after(word, miss)
    text_test_require(jet_rt_string_eq(unchanged, word) && unchanged != word)
    // Self-alias append must work both with and without buffer relocation.
    jet_rt_string_builder_push(clone, clone)
    jet_rt_string_builder_push(clone, clone)
    jet_rt_string_builder_push(clone, clone)
    text_test_require(rt_text_len(clone) == I64{24} && jet_char_len(clone) == I64{24})
    at := I64{0}
    loop at < (I64{24}) {
        text_test_require(rt_text_byte(rt_text_data(clone) + at) == I64{97} + at % I64{3})
        at += I64{1}
    }
    unicode :: jet_rt_string_builder_new()
    rt_text_push_scalar(unicode, I64{65})
    rt_text_push_scalar(unicode, I64{233})
    rt_text_push_scalar(unicode, I64{8364})
    rt_text_push_scalar(unicode, I64{128512})
    text_test_require(jet_char_len(unicode) == I64{4} && rt_text_len(unicode) == I64{10})
    packed :: jet_rt_c_string_pack(unicode)
    text_test_require(packed != I64{0} && rt_text_byte(packed + I64{10}) == I64{0})
    unpacked :: jet_rt_c_string_unpack(packed)
    unpacked_suffix :: jet_rt_c_string_unpack(packed + I64{1})
    expected_suffix :: rt_text_slice(unicode, I64{1}, I64{10})
    jet_rt_c_string_free(packed, I64{11})
    text_test_require(jet_rt_string_eq(unpacked, unicode))
    text_test_require(jet_rt_string_eq(unpacked_suffix, expected_suffix))
    jet_rt_string_drop(unpacked)
    jet_rt_string_drop(unpacked_suffix)
    jet_rt_string_drop(expected_suffix)
    packed_empty :: jet_rt_c_string_pack(empty)
    text_test_require(packed_empty != I64{0} && rt_text_byte(packed_empty) == I64{0})
    unpacked_empty :: jet_rt_c_string_unpack(packed_empty)
    jet_rt_c_string_free(packed_empty, I64{1})
    text_test_require(rt_text_len(unpacked_empty) == I64{0} && rt_text_data(unpacked_empty) == I64{1})
    jet_rt_string_drop(unpacked_empty)
    sliced :: jet_rt_string_slice_range(unicode, I64{1}, I64{3}, U8{1}, I64{1}, I64{0}, I64{0})
    text_test_require(jet_char_len(sliced) == I64{2} && rt_text_len(sliced) == I64{5})
    text_test_require(rt_text_decode(rt_text_data(sliced)) == I64{233} && rt_text_decode(rt_text_data(sliced) + I64{2}) == I64{8364})
    padded :: jet_rt_string_builder_new()
    rt_text_push_scalar(padded, I64{8195})
    jet_rt_string_builder_push(padded, unicode)
    rt_text_push_scalar(padded, I64{160})
    trimmed :: rt_text_trim(padded)
    text_test_require(jet_rt_string_eq(trimmed, unicode))
    raw :: jet_rt_alloc(I64{5}, I64{1})
    rt_text_put(raw, I64{240})
    rt_text_put(raw + I64{1}, I64{144})
    rt_text_put(raw + I64{2}, I64{65})
    rt_text_put(raw + I64{3}, I64{226})
    rt_text_put(raw + I64{4}, I64{130})
    lossy :: jet_rt_string_from_static(raw, I64{5})
    text_test_require(jet_char_len(lossy) == I64{3} && rt_text_len(lossy) == I64{7})
    text_test_require(rt_text_decode(rt_text_data(lossy)) == I64{65533})
    text_test_require(rt_text_byte(rt_text_data(lossy) + I64{3}) == I64{65})
    text_test_require(rt_text_decode(rt_text_data(lossy) + I64{4}) == I64{65533})
    jet_rt_free(raw, I64{5}, I64{1})
    // Empty delimiter: leading empty, each scalar, trailing empty, then None.
    state :: text_iter_state(sliced, empty)
    text_test_piece(state, empty)
    scalar :: jet_rt_string_builder_new()
    rt_text_push_scalar(scalar, I64{233})
    text_test_piece(state, scalar)
    jet_rt_string_drop(scalar)
    euro :: jet_rt_string_builder_new()
    rt_text_push_scalar(euro, I64{8364})
    text_test_piece(state, euro)
    text_test_piece(state, empty)
    text_test_require(text_iter_pull(state) == I64{0} && text_iter_pull(state) == I64{0})
    text_iter_drop(state)
    // Nonempty delimiter: trailing empty is preserved and source is cloned.
    state2 :: text_iter_state(word, suffix)
    jet_rt_string_drop(word)
    text_test_piece(state2, before)
    text_test_piece(state2, empty)
    text_test_require(text_iter_pull(state2) == I64{0})
    text_iter_drop(state2)
    jet_rt_string_drop(euro)
    jet_rt_string_drop(lossy)
    jet_rt_string_drop(trimmed)
    jet_rt_string_drop(padded)
    jet_rt_string_drop(sliced)
    jet_rt_string_drop(unicode)
    jet_rt_string_drop(unchanged)
    jet_rt_string_drop(miss)
    jet_rt_string_drop(before)
    jet_rt_string_drop(after)
    jet_rt_string_drop(suffix)
    jet_rt_string_drop(clone)
    jet_rt_string_drop(empty)
    jet_rt_string_drop(I64{0})
}

fn text_c_string_nul_stop() {
    jet_rt_alloc_init()
    value :: jet_rt_string_builder_new()
    rt_text_push_scalar(value, I64{65})
    rt_text_push_scalar(value, I64{0})
    _packed :: jet_rt_c_string_pack(value)
}

fn text_c_string_invalid_stop() {
    jet_rt_alloc_init()
    ptr :: jet_rt_alloc(I64{2}, I64{1})
    rt_text_put(ptr, I64{240})
    rt_text_put(ptr + I64{1}, I64{0})
    _unpacked :: jet_rt_c_string_unpack(ptr)
}

fn text_c_string_null_stop() {
    jet_rt_alloc_init()
    _unpacked :: jet_rt_c_string_unpack(I64{0})
}

fn text_concat_capacity_stop() {
    jet_rt_alloc_init()
    // Synthetic boundary headers exercise the size guard without allocating
    // impossible buffers. Their data must never be inspected on this edge.
    left :: jet_rt_alloc(I64{24}, I64{8})
    right :: jet_rt_alloc(I64{24}, I64{8})
    rt_text_store(left, I64{1})
    rt_text_store(left + I64{8}, I64{9223372036854775807})
    rt_text_store(left + I64{16}, I64{9223372036854775807})
    rt_text_store(right, I64{1})
    rt_text_store(right + I64{8}, I64{1})
    rt_text_store(right + I64{16}, I64{1})
    _joined :: jet_rt_string_concat(left, right)
}
