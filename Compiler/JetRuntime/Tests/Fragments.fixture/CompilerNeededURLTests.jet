// Native E4 route fixtures, derived directly from UrlMime.rs:16-75,
// 234-247,316-372,718-904,997-1006,1048-1099. No Rust oracle execution.
// The driver calls this export once; return zero means all fixtures passed.
fn compiler_url_fixture_success(input: I64, scheme: I64, host: I64, path: I64, query: I64, raw: I64, port: I64, explicit: Bool) -> Bool {
    slots :: jet_rt_alloc(I64{16}, I64{8})
    rt_text_store(slots, I64{771})
    rt_text_store(slots + I64{8}, I64{772})
    status :: jet_url_parse(input, slots, slots + I64{8})
    if (status != I64{1} || rt_text_word(slots + I64{8}) != I64{772}) {
        jet_rt_free(slots, I64{16}, I64{8})
        return false
    }
    value :: rt_text_word(slots)
    cloned_url :: jet_rt_handle_clone_jet_url(value)
    good := cloned_url != value && jet_rt_handle_eq_jet_url(value, cloned_url)
    good = good && jet_rt_string_eq(rt_text_word(value), scheme)
    good = good && jet_rt_string_eq(rt_text_word(value + I64{24}), host)
    good = good && jet_rt_string_eq(rt_text_word(value + I64{48}), path)
    good = good && jet_rt_string_eq(rt_text_word(value + I64{56}), query)
    good = good && jet_rt_string_eq(rt_text_word(value + I64{72}), raw)
    good = good && rt_text_word(value + I64{32}) == port && jet_rt_record_get_jet_url_port_explicit(value) == explicit
    getter :: jet_rt_record_get_jet_url_host(value)
    good = good && getter != rt_text_word(value + I64{24}) && jet_rt_string_eq(getter, host)
    jet_rt_string_drop(getter)
    exact_port :: jet_rt_record_get_jet_url_port(value)
    good = good && jet_int_owned_to_i64(exact_port) == port
    jet_rt_int_drop(exact_port)
    shown :: jet_rt_handle_show_jet_url(value)
    good = good && jet_rt_string_eq(shown, raw)
    jet_rt_string_drop(shown)
    jet_rt_handle_drop_jet_url(value)
    // The clone must retain independent text ownership after its origin dies.
    cloned_host :: jet_rt_record_get_jet_url_host(cloned_url)
    good = good && jet_rt_string_eq(cloned_host, host)
    jet_rt_string_drop(cloned_host)
    jet_rt_handle_drop_jet_url(cloned_url)
    jet_rt_free(slots, I64{16}, I64{8})
    good
}
fn compiler_url_fixture_error(input: I64, expected: I64) -> Bool {
    slots :: jet_rt_alloc(I64{16}, I64{8})
    rt_text_store(slots, I64{771})
    rt_text_store(slots + I64{8}, I64{772})
    status :: jet_url_parse(input, slots, slots + I64{8})
    if (status != I64{0} || rt_text_word(slots) != I64{771}) {
        if (status == I64{1}) -> jet_rt_handle_drop_jet_url(rt_text_word(slots))
        jet_rt_free(slots, I64{16}, I64{8})
        return false
    }
    text :: rt_text_word(slots + I64{8})
    good :: jet_rt_string_eq(text, expected)
    jet_rt_string_drop(text)
    jet_rt_free(slots, I64{16}, I64{8})
    good
}
#Export(c) fn jet_rt_compiler_needed_url_fixture() -> I64 {
    if !compiler_url_fixture_success(rt_static_text("　HTTPS://BÜCHER.example:00443/a/%2e%2e/b/./c/?x=a+b&&x=%2f#"), rt_static_text("https"), rt_static_text("xn--bcher-2pa.example"), rt_static_text("/b/c/"), rt_static_text("x=a%2Bb&=&x=%2F"), rt_static_text("https://xn--bcher-2pa.example:443/b/c/?x=a%2Bb&=&x=%2F#"), I64{443}, true) -> return I64{1}
    if !compiler_url_fixture_success(rt_static_text("https://bücher.example"), rt_static_text("https"), rt_static_text("xn--bcher-kva.example"), rt_static_text("/"), rt_static_text(""), rt_static_text("https://xn--bcher-kva.example/"), I64{443}, false) -> return I64{2}
    if !compiler_url_fixture_success(rt_static_text("HtTp://u%40:p%3A@EXAMPLE.COM...:80/a//b?x&"), rt_static_text("http"), rt_static_text("example.com"), rt_static_text("/a//b"), rt_static_text("x=&="), rt_static_text("http://u%40:p%3A@example.com:80/a//b?x=&="), I64{80}, true) -> return I64{3}
    if !compiler_url_fixture_success(rt_static_text("http://[::AB]:+80/a.b//c"), rt_static_text("http"), rt_static_text("[::ab]"), rt_static_text("/a.b/c"), rt_static_text(""), rt_static_text("http://[::ab]:80/a.b/c"), I64{80}, true) -> return I64{4}
    if !compiler_url_fixture_success(rt_static_text("http://[a..B]/"), rt_static_text("http"), rt_static_text("[a..b]"), rt_static_text("/"), rt_static_text(""), rt_static_text("http://[a..b]/"), I64{80}, false) -> return I64{5}
    if !compiler_url_fixture_success(rt_static_text("data:text/plain,a%FF/../b?x=%41#%E2%82%AC"), rt_static_text("data"), rt_static_text(""), rt_static_text("text/plain,a%FF/../b"), rt_static_text("x=A"), rt_static_text("data:text/plain,a%FF/../b?x=A#%E2%82%AC"), I64{-1}, false) -> return I64{6}
    if !compiler_url_fixture_success(rt_static_text("custom:a/../../b/."), rt_static_text("custom"), rt_static_text(""), rt_static_text("b"), rt_static_text(""), rt_static_text("custom:b"), I64{-1}, false) -> return I64{7}
    if !compiler_url_fixture_success(rt_static_text("http://:@HOST:0/#"), rt_static_text("http"), rt_static_text("host"), rt_static_text("/"), rt_static_text(""), rt_static_text("http://:@host:0/#"), I64{0}, true) -> return I64{8}
    // Rust does not reject a nonnumeric unbracketed :suffix as a port.
    if !compiler_url_fixture_success(rt_static_text("x://host:abc/p"), rt_static_text("x"), rt_static_text("host:abc"), rt_static_text("/p"), rt_static_text(""), rt_static_text("x://host:abc/p"), I64{-1}, false) -> return I64{9}
    if !compiler_url_fixture_success(rt_static_text("file:/tmp/%E2%82%AC"), rt_static_text("file"), rt_static_text(""), rt_static_text("/tmp/€"), rt_static_text(""), rt_static_text("file:/tmp/%E2%82%AC"), I64{-1}, false) -> return I64{10}
    if !compiler_url_fixture_error(rt_static_text("no-scheme"), rt_static_text("URL needs a scheme")) -> return I64{20}
    if !compiler_url_fixture_error(rt_static_text("1http://host"), rt_static_text("invalid URL scheme `1http`")) -> return I64{21}
    if !compiler_url_fixture_error(rt_static_text(":foo"), rt_static_text("invalid URL scheme ``")) -> return I64{22}
    if !compiler_url_fixture_error(rt_static_text("HTTP:path"), rt_static_text("http URL needs `//host`")) -> return I64{23}
    if !compiler_url_fixture_error(rt_static_text("http:///path"), rt_static_text("URL host is empty")) -> return I64{24}
    if !compiler_url_fixture_error(rt_static_text("http://.host/"), rt_static_text("URL host has an empty label")) -> return I64{25}
    if !compiler_url_fixture_error(rt_static_text("http://host..name/"), rt_static_text("URL host has an empty label")) -> return I64{26}
    if !compiler_url_fixture_error(rt_static_text("http://host:65536/"), rt_static_text("URL port out of range `65536`")) -> return I64{27}
    if !compiler_url_fixture_error(rt_static_text("http://host:9223372036854775808/"), rt_static_text("invalid URL port `9223372036854775808`")) -> return I64{28}
    if !compiler_url_fixture_error(rt_static_text("http://[::1"), rt_static_text("IPv6 host is missing `]`")) -> return I64{29}
    if !compiler_url_fixture_error(rt_static_text("http://[::1]oops/"), rt_static_text("invalid text after IPv6 host")) -> return I64{30}
    if !compiler_url_fixture_error(rt_static_text("http://[::1]:/"), rt_static_text("invalid URL port ``")) -> return I64{31}
    if !compiler_url_fixture_error(rt_static_text("http://[::1]:-1/"), rt_static_text("URL port out of range `-1`")) -> return I64{32}
    if !compiler_url_fixture_error(rt_static_text("http://[::1]:-9223372036854775808/"), rt_static_text("URL port out of range `-9223372036854775808`")) -> return I64{33}
    if !compiler_url_fixture_error(rt_static_text("http://u%@host/"), rt_static_text("truncated percent escape")) -> return I64{34}
    if !compiler_url_fixture_error(rt_static_text("http://host/%GG"), rt_static_text("invalid percent escape `%GG`")) -> return I64{35}
    if !compiler_url_fixture_error(rt_static_text("http://host/%FF"), rt_static_text("percent escape is not valid UTF-8")) -> return I64{36}
    if !compiler_url_fixture_error(rt_static_text("http:///bad?x=%GG#%"), rt_static_text("truncated percent escape")) -> return I64{37}
    if !compiler_url_fixture_error(rt_static_text("http:///bad?x=%GG"), rt_static_text("invalid percent escape `%GG`")) -> return I64{38}
    if !compiler_url_fixture_error(rt_static_text("x:a?x=%C0%80"), rt_static_text("percent escape is not valid UTF-8")) -> return I64{39}
    jet_rt_handle_drop_jet_url(I64{0})
    I64{0}
}
