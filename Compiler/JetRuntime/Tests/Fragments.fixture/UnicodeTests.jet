// Raw E4 witnesses omitted by ordinary quoted-text goldens: embedded NUL,
// successful Option payload writes and an absent result preserving its slot.
// Assemble with the runtime-only manifest, not the compiler bootstrap unit.
fn unicode_test_require(ok: Bool) {
    if ok {
        return
    }
    #Unsafe("a failed Unicode runtime witness ends only its isolated test process") {
        _ := os_syscall_i64(I64{231}, I64{1}, I64{0}, I64{0}, I64{0}, I64{0}, I64{0})
    }
    loop {

    }
}

fn unicode_tests() {
    jet_rt_alloc_init()
    value :: rt_text_builder_with_capacity(I64{6})
    rt_text_push_scalar(value, I64{223})  // sharp s
    rt_text_push_scalar(value, I64{64259})  // ffi ligature
    rt_text_push_scalar(value, I64{0})  // literal NUL survives the first lane
    upper :: jet_unicode_upper(value)
    unicode_test_require(rt_text_len(upper) == I64{6})
    data :: rt_text_data(upper)
    unicode_test_require(rt_text_byte(data) == I64{83})
    unicode_test_require(rt_text_byte(data + I64{1}) == I64{83})
    unicode_test_require(rt_text_byte(data + I64{2}) == I64{70})
    unicode_test_require(rt_text_byte(data + I64{3}) == I64{70})
    unicode_test_require(rt_text_byte(data + I64{4}) == I64{73})
    unicode_test_require(rt_text_byte(data + I64{5}) == I64{0})
    lower :: jet_unicode_lower(value)
    unicode_test_require(jet_rt_string_eq(lower, value))
    nul :: rt_text_builder_with_capacity(I64{1})
    rt_text_push_scalar(nul, I64{0})
    slot :: jet_rt_alloc(I64{8}, I64{8})
    unicode_test_require(jet_unicode_index_of(value, nul, slot) == I64{1})
    unicode_test_require(rt_text_word(slot) == I64{2})
    unicode_test_require(jet_unicode_last_index_of(value, nul, slot) == I64{1})
    unicode_test_require(rt_text_word(slot) == I64{2})
    unicode_test_require(jet_unicode_count(value, nul) == I64{1})
    absent :: rt_text_builder_with_capacity(I64{1})
    rt_text_push_scalar(absent, I64{120})
    rt_text_store(slot, I64{999})
    unicode_test_require(jet_unicode_index_of(value, absent, slot) == I64{0})
    unicode_test_require(rt_text_word(slot) == I64{999})
    unicode_test_require(jet_unicode_last_index_of(value, absent, slot) == I64{0})
    unicode_test_require(rt_text_word(slot) == I64{999})
    empty :: jet_rt_string_builder_new()
    unicode_test_require(jet_unicode_index_of(value, empty, slot) == I64{1})
    unicode_test_require(rt_text_word(slot) == I64{0})
    unicode_test_require(jet_unicode_last_index_of(value, empty, slot) == I64{1})
    unicode_test_require(rt_text_word(slot) == I64{3})
    unicode_test_require(jet_unicode_count(value, empty) == I64{0})
    trimmed :: jet_unicode_trim(value)
    unicode_test_require(jet_rt_string_eq(trimmed, value))
    jet_rt_string_drop(trimmed)
    jet_rt_string_drop(empty)
    jet_rt_string_drop(absent)
    jet_rt_free(slot, I64{8}, I64{8})
    jet_rt_string_drop(nul)
    jet_rt_string_drop(lower)
    jet_rt_string_drop(upper)
    jet_rt_string_drop(value)
}
