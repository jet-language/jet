    value := rt_text_word(slot)
    if !jet_rt_string_eq(value, rt_static_text("exit status: 7")) -> return I64{2}
    jet_rt_string_drop(value)
    at := I64{0}
    loop at < (I64{64}) {
        compiler_process_record_exit_status(I64{20000000} + at, I64{0})
        at += I64{1}
