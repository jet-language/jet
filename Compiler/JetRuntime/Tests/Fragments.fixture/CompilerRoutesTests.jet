// Link with the composed Jet-only runtime and CompilerRoutesTests.c. The C
// caller supplies one disk-backed temporary root and real forked child pids.
fn compiler_routes_path(root: I64, suffix: I64) -> I64 {
    text :: jet_rt_string_builder_new()
    jet_rt_string_builder_push(text, root)
    jet_rt_string_builder_push(text, suffix)
    jet_rt_string_builder_finish(text)
}
fn compiler_routes_bytes_drop(data: I64, length: I64) {
    if (length != I64{0}) -> jet_rt_free(data, length * RT_HOST_U8_STRIDE, I64{8})
}
