#Export(c) fn jet_rt_compiler_wait_fixture(pid: I64, expected: I64) -> I64 {
    slots :: jet_rt_alloc(I64{48}, I64{8})
    rt_text_store(slots, I64{731})
    if (jet_process_exit_status_raw(pid, slots) != I64{0} || rt_text_word(slots) != I64{731}) -> return I64{1}
    child :: spawn_child_new()
    fd_put(child, I64{8}, pid)
    if (jet_process_wait_raw(child, false, slots + I64{8}, slots + I64{16}) != pid) -> return I64{2}
    jet_process_drop_raw(child)
    if (jet_process_exit_status_raw(pid, slots) != I64{1}) -> return I64{3}
    value :: rt_text_word(slots)
    if !jet_rt_string_eq(value, expected) -> return I64{4}
    jet_rt_string_drop(value)
    jet_rt_free(slots, I64{48}, I64{8})
    I64{0}
}
#Export(c) fn jet_rt_compiler_status_history_fixture() -> I64 {
    slot :: jet_rt_alloc(I64{8}, I64{8})
