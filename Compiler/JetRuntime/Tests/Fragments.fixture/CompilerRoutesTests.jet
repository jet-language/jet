    if (jet_process_exit_status_raw(I64{10000001}, slot) != I64{0} || rt_text_word(slot) != I64{732}) -> return I64{3}
    value = compiler_process_status_text(I64{139})
    if !jet_rt_string_eq(value, rt_static_text("signal: 11 (SIGSEGV) (core dumped)")) -> return I64{4}
    jet_rt_string_drop(value)
    name :: jet_std_os_name()
    arch :: jet_std_os_arch()
    if !jet_rt_string_eq(name, rt_static_text("linux")) || !jet_rt_string_eq(arch, rt_static_text("x86_64")) -> return I64{5}
    jet_rt_string_drop(name)
    jet_rt_string_drop(arch)
    jet_rt_free(slot, I64{8}, I64{8})
    I64{0}
}
