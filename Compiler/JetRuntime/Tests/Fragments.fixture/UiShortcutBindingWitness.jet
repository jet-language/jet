// Test-only C doors, not production exports.
#Export(c) fn ui_binding_witness_clone(value: I64) -> I64 { ui_shortcut_binding_clone(value) }
#Export(c) fn ui_binding_witness_drop(value: I64) { ui_shortcut_binding_drop(value) }
#Export(c) fn ui_binding_witness_eq(a: I64, b: I64) -> Bool { ui_shortcut_binding_eq(a, b) }
#Export(c) fn ui_dispatch_witness_clone(value: I64) -> I64 { ui_shortcut_dispatch_clone(value) }
#Export(c) fn ui_dispatch_witness_drop(value: I64) { ui_shortcut_dispatch_drop(value) }
#Export(c) fn ui_dispatch_witness_eq(a: I64, b: I64) -> Bool { ui_shortcut_dispatch_eq(a, b) }
