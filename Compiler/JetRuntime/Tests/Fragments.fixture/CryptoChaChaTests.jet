#Export(c) fn jet_rt_chacha_fixture(mode: I64, key: I64, nonce: I64, counter: I64, input: I64, length: I64, expected: I64) {
    scratch :: jet_rt_alloc(I64{368}, I64{8})
    output :: jet_rt_alloc(length + I64{2}, I64{1})
    rt_text_put(output, I64{165})
    rt_text_put(output + length + I64{1}, I64{90})
    if {
        (mode == I64{0}) -> rt_crypto_chacha_block(key, nonce, counter, output + I64{1}, scratch)
        (mode == I64{1}) -> rt_crypto_hchacha(key, nonce, output + I64{1}, scratch)
        (mode == I64{2}) -> {
            if (!rt_crypto_chacha_xor(key, nonce, counter, input, length, output + I64{1}, scratch)) -> jet_rt_unreachable(I64{0}, I64{0})
        }
        else -> {
            if (!rt_crypto_xchacha_xor(key, nonce, counter, input, length, output + I64{1}, scratch)) -> jet_rt_unreachable(I64{0}, I64{0})
        }
    }
    i := I64{0}
    loop i < length {
        if (rt_text_byte(output + I64{1} + i) != rt_text_byte(expected + i)) -> jet_rt_unreachable(I64{0}, I64{0})
        i += I64{1}
    }
    if (rt_text_byte(output) != I64{165} || rt_text_byte(output + length + I64{1}) != I64{90}) -> jet_rt_unreachable(I64{0}, I64{0})
    wiped := I64{368}
    if (mode == I64{0}) -> wiped = I64{256}
    if (mode == I64{1}) -> wiped = I64{128}
    i = I64{0}
    if (mode == I64{2}) -> wiped = I64{320}
    loop i < wiped {
        if (rt_text_byte(scratch + i) != I64{0}) -> jet_rt_unreachable(I64{0}, I64{0})
        i += I64{1}
    }
    jet_rt_free(output, length + I64{2}, I64{1})
    jet_rt_free(scratch, I64{368}, I64{8})
}
