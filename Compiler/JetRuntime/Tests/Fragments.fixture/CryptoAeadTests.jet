#Export(c) fn jet_rt_poly_fixture(key: I64, input: I64, length: I64, expected: I64) {
    scratch :: jet_rt_alloc(I64{160}, I64{8})
    output :: jet_rt_alloc(I64{16}, I64{1})
    rt_crypto_poly1305(key, input, length, output, scratch)
    if (!rt_crypto_equal(output, expected, I64{16})) -> jet_rt_unreachable(I64{0}, I64{0})
    i := I64{0}
    loop {
        if (i >= I64{160}) -> break
        if (rt_text_byte(scratch + i) != I64{0}) -> jet_rt_unreachable(I64{0}, I64{0})
        i += I64{1}
    }
    jet_rt_free(output, I64{16}, I64{1})
    jet_rt_free(scratch, I64{160}, I64{8})
}
#Export(c) fn jet_rt_aead_fixture(extended: Bool, key: I64, nonce: I64, aad: I64, aad_len: I64, plain: I64, length: I64, expected: I64) {
    scratch :: jet_rt_alloc(I64{608}, I64{8})
    cipher :: jet_rt_alloc(length + I64{16}, I64{1})
    output :: jet_rt_alloc(length + I64{2}, I64{1})
    valid :: if extended -> rt_crypto_xaead_seal(key, nonce, aad, aad_len, plain, length, cipher, scratch) else -> rt_crypto_aead_seal(key, nonce, aad, aad_len, plain, length, cipher, scratch)
    if (!valid || !rt_crypto_equal(cipher, expected, length + I64{16})) -> jet_rt_unreachable(I64{0}, I64{0})
    rt_text_put(output, I64{165})
    rt_text_put(output + length + I64{1}, I64{90})
    accepted :: if extended -> rt_crypto_xaead_open(key, nonce, aad, aad_len, cipher, length + I64{16}, output + I64{1}, scratch) else -> rt_crypto_aead_open(key, nonce, aad, aad_len, cipher, length + I64{16}, output + I64{1}, scratch)
    if (!accepted || !rt_crypto_equal(output + I64{1}, plain, length)) -> jet_rt_unreachable(I64{0}, I64{0})
    // Every tag byte is independently corrupted; no partial plaintext is emitted.
    tag_index := I64{0}
    loop {
        if (tag_index >= I64{16}) -> break
        i := I64{0}
        loop i < length {
            rt_text_put(output + I64{1} + i, I64{165})
            i += I64{1}
        }
        at :: cipher + length + tag_index
        original :: rt_text_byte(at)
        rt_text_put(at, original.bit_xor(I64{1}))
        bad :: if extended -> rt_crypto_xaead_open(key, nonce, aad, aad_len, cipher, length + I64{16}, output + I64{1}, scratch) else -> rt_crypto_aead_open(key, nonce, aad, aad_len, cipher, length + I64{16}, output + I64{1}, scratch)
        if bad -> jet_rt_unreachable(I64{0}, I64{0})
        rt_text_put(at, original)
        i = I64{0}
        loop i < length {
            if (rt_text_byte(output + I64{1} + i) != I64{165}) -> jet_rt_unreachable(I64{0}, I64{0})
            i += I64{1}
        }
        wiped :: if extended -> I64{608} else -> I64{560}
        i = I64{0}
        loop i < wiped {
            if (rt_text_byte(scratch + i) != I64{0}) -> jet_rt_unreachable(I64{0}, I64{0})
            i += I64{1}
        }
        tag_index += I64{1}
    }
    if (rt_text_byte(output) != I64{165} || rt_text_byte(output + length + I64{1}) != I64{90}) -> jet_rt_unreachable(I64{0}, I64{0})
    rt_crypto_wipe(output, length + I64{2})
    jet_rt_free(output, length + I64{2}, I64{1})
    jet_rt_free(cipher, length + I64{16}, I64{1})
    jet_rt_free(scratch, I64{608}, I64{8})
}
