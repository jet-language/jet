// Assemble with JetRuntime/Source and the fixed-width OS leaves. Native exit
// witness once E1/E2 land: stdout exactly "alloc tests: ok\n", status 0. A failed
// witness names itself on stderr ("alloc tests: <witness> failed") and exits 1,
// without requiring containers or any runtime layer past process-static text.
// Tests are single-threaded on the attached main thread, so small blocks pass
// through its cache; a test that inspects slab metadata first returns the
// cache (alloc_cache_flush). Raw metadata inspection owns the heap but for the
// blocks the host's registration keeps for the process (its environment index,
// HostStartup.jet host_environment_index), whose classes follow the size of
// the environment the process starts with.

// The running witness's name (a process-static text); alloc_tests names one
// before its first check.
alloc_test_witness := I64{0}

alloc_test_named: fn(name: I64) {
    #Unsafe("the witnesses run one at a time on the main thread") { alloc_test_witness = name }
}

alloc_test_require: fn(ok: Bool) {
    if ok {
        return
    }
    #Unsafe("a failed allocator witness writes three process-static texts to stderr with raw writes, which take no heap, and terminates this isolated test process") {
        head: rt_static_text("alloc tests: ")
        _ := os_write_i64(I64{2}, rt_text_data(head), rt_text_len(head))
        _ := os_write_i64(I64{2}, rt_text_data(alloc_test_witness), rt_text_len(alloc_test_witness))
        tail: rt_static_text(" failed\n")
        _ := os_write_i64(I64{2}, rt_text_data(tail), rt_text_len(tail))
        _ := os_exit_group_i64(I64{1})
    }
    loop {

    }
}

priv alloc_test_payload: fn(size: I64, align: I64) {
    first: jet_rt_alloc(size, align)
    second: jet_rt_alloc(size, align)
    count: if (size == I64{0}) -> I64{1} else -> size
    alloc_test_require(first != I64{0} && second != I64{0} && first != second)
    alloc_test_require((first & wrapping(align - I64{1})) == I64{0})
    alloc_test_require((second & wrapping(align - I64{1})) == I64{0})
    alloc_test_require(wrapping(first + count) <= second || wrapping(second + count) <= first)
    #Unsafe("both allocations own count bytes; touching their endpoints must not alias each other or their metadata") {
        os_store_u8(first, I64{17})
        os_store_u8(wrapping(first + count - I64{1}), I64{29})
        os_store_u8(second, I64{43})
        os_store_u8(wrapping(second + count - I64{1}), I64{61})
        alloc_test_require(os_load_u8(wrapping(first + count - I64{1})) == I64{29})
        alloc_test_require(os_load_u8(wrapping(second + count - I64{1})) == I64{61})
        if (count > I64{1}) {
            alloc_test_require(os_load_u8(first) == I64{17})
            alloc_test_require(os_load_u8(second) == I64{43})
        }
    }
    jet_rt_free(second, size, align)
    jet_rt_free(first, size, align)
}

alloc_test_boundaries: fn(align: I64) {
    slot := I64{32}
    loop slot <= (I64{4096}) {
        boundary: wrapping(slot - alloc_header(align) - (if (align == I64{8}) -> I64{0} else -> wrapping(align - I64{1})))
        if {
            boundary > (I64{0}) -> {
                alloc_test_require(alloc_class(boundary, align, ALLOC_CLASS_LIMIT) == slot)
                alloc_test_require(alloc_class(wrapping(boundary + I64{1}), align, ALLOC_CLASS_LIMIT) == (if (slot == I64{4096}) -> I64{0} else -> wrapping(slot * I64{2})))
                alloc_test_payload(wrapping(boundary - I64{1}), align)
                alloc_test_payload(boundary, align)
                alloc_test_payload(wrapping(boundary + I64{1}), align)
            }
            else -> alloc_test_payload(slot, align)
        }
        slot = wrapping(slot * I64{2})
    }
}

// The fast paths' row of every size and small align is alloc_class's class:
// row k for class 32 << k, and a row of 8 or more for a size no class holds.
alloc_test_row_classes: fn() {
    align := I64{1}
    loop align <= (I64{8}) {
        size := I64{0}
        loop size < (I64{4200}) {
            slot: alloc_class(size, align, ALLOC_CLASS_LIMIT)
            row: alloc_row(wrapping(wrapping((if (size == I64{0}) -> I64{1} else -> size) + alloc_header(align)) + (if (align == I64{8}) -> I64{0} else -> wrapping(align - I64{1}))))
            alloc_test_require(if (slot == I64{0}) -> row >= I64{8} else -> row < I64{8} && (I64{32} << row) == slot)
            size = wrapping(size + I64{1})
        }
        align = wrapping(align * I64{2})
    }
}

alloc_test_reuse: fn() {
    // Every refill below runs on this thread, so one arena (alloc_arena)
    // serves them all. A block an earlier test left cached may come from
    // another arena (one a thread without a TCB chose by its stack band), so
    // the cache starts empty, and `first` comes from this thread's refill.
    alloc_cache_flush()
    first: jet_rt_alloc(I64{8}, I64{8})
    arena := I64{0}
    slab := I64{0}
    #Unsafe("first's private header names its live slab, whose arena word is fixed") {
        slab = os_load_i64(wrapping(first - I64{16}))
        arena = os_load_i64(wrapping(slab + I64{40}))
    }
    jet_rt_free(first, I64{8}, I64{8})
    // The cache is LIFO: the block just freed serves the next allocation.
    pin: jet_rt_alloc(I64{8}, I64{8})
    alloc_test_require(first == pin)
    // `pin` stays live until the end, so the slab never empties: it is never
    // retired, and no retained empty slab of the class is linked ahead of it.
    alloc_cache_flush()
    // The slab must serve every iteration: not merely an equal virtual
    // address obtained by munmap/mmap. The refill took its blocks from the
    // class's head slab, and the flush returned them (relinking the slab at
    // the head if the refill had used up its free blocks), so the slab is
    // the head, and its live count returns to `resting` after each iteration.
    head: alloc_head(arena, I64{32})
    resting := I64{0}
    #Unsafe("the flushed cache left the slab linked at its class head; its live count and the class cell are stable while this thread is the heap's only user") {
        resting = os_load_i64(wrapping(slab + I64{24}))
        alloc_test_require(resting >= I64{1} && os_load_i64(head) == slab)
    }
    iteration := I64{0}
    loop iteration < (I64{1000}) {
        pointer: jet_rt_alloc(I64{8}, I64{8})
        #Unsafe("pointer's private header identifies its still-live slab, which must be the same mapping") {
            alloc_test_require(os_load_i64(wrapping(pointer - I64{16})) == slab)
        }
        jet_rt_free(pointer, I64{8}, I64{8})
        alloc_cache_flush()
        #Unsafe("no other thread touches the slab or its class list") {
            alloc_test_require(os_load_i64(head) == slab && os_load_i64(wrapping(slab + I64{24})) == resting)
        }
        iteration = wrapping(iteration + I64{1})
    }
    jet_rt_free(pin, I64{8}, I64{8})
}

// A freed large mapping of a cached class serves the next allocation of that
// class: the same address, the class-rounded length, no munmap/mmap between.
alloc_test_large_reuse: fn() {
    first: jet_rt_alloc(I64{65537}, I64{8})
    bytes := I64{0}
    #Unsafe("first's private header holds its mapping base and length") {
        bytes = os_load_i64(wrapping(first - I64{8}))
    }
    class: alloc_large_class(bytes)
    alloc_test_require(class >= I64{0} && wrapping(alloc_large_class_pages(class) * I64{4096}) == bytes)
    alloc_test_require(alloc_large_class(wrapping(bytes + I64{4096})) == wrapping(class + I64{1}))
    jet_rt_free(first, I64{65537}, I64{8})
    second: jet_rt_alloc(I64{65537}, I64{8})
    alloc_test_require(second == first)
    jet_rt_free(second, I64{65537}, I64{8})
}

// The kept bytes of the calling thread's large row `index`, 0 when empty.
alloc_test_large_row: fn(index: I64) -> I64 {
    sync_load(wrapping(alloc_large_rows() + wrapping(wrapping(index * I64{16}) + I64{8})))
}

// A thread keeps its first ALLOC_LARGE_ROW_COUNT freed class mappings in its
// rows and shelves the next on its class list, all counted as cached; thread
// exit's flush shelves the kept ones, still counted. Every one then serves a
// later allocation of the class: none was unmapped.
alloc_test_large_rows: fn() {
    alloc_large_rows_flush()
    count: wrapping(ALLOC_LARGE_ROW_COUNT + I64{1})
    held: jet_rt_alloc(wrapping(count * I64{8}), I64{8})
    at := I64{0}
    loop at < count {
        sync_store(wrapping(held + wrapping(at * I64{8})), jet_rt_alloc(I64{65537}, I64{8}))
        at = wrapping(at + I64{1})
    }
    cached: sync_load(wrapping(alloc_root + I64{224}))
    at = I64{0}
    loop at < count {
        jet_rt_free(sync_load(wrapping(held + wrapping(at * I64{8}))), I64{65537}, I64{8})
        at = wrapping(at + I64{1})
    }
    bytes: alloc_test_large_row(I64{0})
    alloc_test_require(bytes > I64{65537} && alloc_test_large_row(wrapping(ALLOC_LARGE_ROW_COUNT - I64{1})) == bytes)
    alloc_test_require(sync_load(wrapping(alloc_root + I64{224})) == wrapping(cached + wrapping(count * bytes)))
    alloc_large_rows_flush()
    alloc_test_require(alloc_test_large_row(I64{0}) == I64{0})
    alloc_test_require(sync_load(wrapping(alloc_root + I64{224})) == wrapping(cached + wrapping(count * bytes)))
    taken := I64{0}
    loop taken < count {
        again: jet_rt_alloc(I64{65537}, I64{8})
        found := false
        at = I64{0}
        loop at < count {
            if (sync_load(wrapping(held + wrapping(at * I64{8}))) == again) { found = true }
            at = wrapping(at + I64{1})
        }
        alloc_test_require(found)
        taken = wrapping(taken + I64{1})
    }
    alloc_test_require(sync_load(wrapping(alloc_root + I64{224})) == cached)
    at = I64{0}
    loop at < count {
        jet_rt_free(sync_load(wrapping(held + wrapping(at * I64{8}))), I64{65537}, I64{8})
        at = wrapping(at + I64{1})
    }
    jet_rt_free(held, wrapping(count * I64{8}), I64{8})
    alloc_large_rows_flush()
}

alloc_test_full_slabs: fn() {
    // Class 4096 has 15 blocks/slab, and a full slab leaves its class list, so
    // the block after a slab's last must come from a second mapping. Keep our
    // pointer chain inside owned payloads, not a Jet list.
    // Start from an empty cache: the first allocation's refill takes every
    // free block of the class's head slab and none of another
    // (alloc_slab_take: its limit of 32 is past a slab's 15), so that slab is
    // then full, its live count all 15 blocks. Blocks the host kept before the
    // witness ran may share it, so the slab serves exactly the blocks that
    // refill took, and the next allocation is the second mapping's.
    alloc_cache_flush()
    chain := I64{0}
    first_slab := I64{0}
    arena := I64{0}
    own := I64{0}
    count := I64{0}
    loop count < (I64{16}) {
        pointer: jet_rt_alloc(I64{2048}, I64{16})
        #Unsafe("the test owns the full payload and can read its allocator header; the slab's live count and this thread's cache row hold still while it is the heap's only user") {
            slab: os_load_i64(wrapping(pointer - I64{16}))
            if (count == I64{0}) {
                first_slab = slab
                arena = os_load_i64(wrapping(slab + I64{40}))
                alloc_test_require(os_load_i64(wrapping(slab + I64{24})) == I64{15})
                // The refill's blocks: this one and the ones left cached.
                own = wrapping(os_load_i64(wrapping(alloc_cache_row(I64{4096}) + I64{8})) + I64{1})
                alloc_test_require(own >= I64{1} && own <= I64{15})
            }
            if (count < own) { alloc_test_require(slab == first_slab) } else {
                alloc_test_require(slab != first_slab)
            }
            alloc_test_require(os_load_i64(wrapping(slab + I64{40})) == arena)
            os_store_i64(pointer, chain)
        }
        chain = pointer
        count = wrapping(count + I64{1})
    }
    loop chain != (I64{0}) {
        pointer: chain
        #Unsafe("the chain word remains readable until its payload is freed") {
            chain = os_load_i64(pointer)
        }
        jet_rt_free(pointer, I64{2048}, I64{16})
    }
    alloc_cache_flush()
    head: alloc_head(arena, I64{4096})
    #Unsafe("after all payloads are freed, the class keeps its emptied slabs linked up to ALLOC_RETAINED_EMPTY_SLABS and counts each; any further empty slab went onto the free-slab stack; a first slab the host's blocks share never empties, so it stays linked") {
        retained: os_load_i64(wrapping(head + I64{64}))
        alloc_test_require(retained > I64{0} && retained <= ALLOC_RETAINED_EMPTY_SLABS)
        if (own < I64{15}) {
            alloc_test_require(os_load_i64(wrapping(first_slab + I64{24})) == wrapping(I64{15} - own))
        }
        empty := I64{0}
        previous := I64{0}
        slab := os_load_i64(head)
        loop slab != (I64{0}) {
            alloc_test_require(os_load_i64(wrapping(slab + I64{8})) == previous)
            alloc_test_require(os_load_i64(wrapping(slab + I64{40})) == arena)
            if (os_load_i64(wrapping(slab + I64{24})) == I64{0}) {
                empty = wrapping(empty + I64{1})
            }
            previous = slab
            slab = os_load_i64(slab)
        }
        alloc_test_require(empty == retained)
    }
}

// Ten slabs of class 4096 emptied at once: the class keeps at most
// ALLOC_RETAINED_EMPTY_SLABS of them, the rest go on the arena's free-slab
// stack still mapped, and the arena's next slab of any class is the stack's
// top.
alloc_test_slab_stack: fn() {
    alloc_cache_flush()
    chain := I64{0}
    count := I64{0}
    loop count < (I64{150}) {
        pointer: jet_rt_alloc(I64{2048}, I64{16})
        #Unsafe("the test owns the full payload and keeps its chain word there") {
            os_store_i64(pointer, chain)
        }
        chain = pointer
        count = wrapping(count + I64{1})
    }
    loop chain != (I64{0}) {
        pointer: chain
        #Unsafe("the chain word remains readable until its payload is freed") {
            chain = os_load_i64(pointer)
        }
        jet_rt_free(pointer, I64{2048}, I64{16})
    }
    alloc_cache_flush()
    arena: alloc_arena()
    stacked := I64{0}
    #Unsafe("this thread is the heap's only user; the stack word is read once and the stacked slab's link word stays mapped") {
        // A spill past ALLOC_ARENA_FREE_SLAB_CAP leaves the arena more
        // slabs than it moves, so the stack is never empty after a retire.
        stacked = os_load_i64(wrapping(arena + I64{216}))
        alloc_test_require(stacked != I64{0})
        os_store_i64(wrapping(stacked + I64{8}), I64{1})
    }
    alloc_lock(arena)
    taken: alloc_slab_map(arena)
    alloc_test_require(taken == stacked)
    // One slab fewer on the stack and then one more: no spill.
    alloc_slab_retire(arena, taken)
    alloc_unlock(arena)
    #Unsafe("the retired slab is the stack's top again; its pages were never unmapped") {
        alloc_test_require(os_load_i64(wrapping(arena + I64{216})) == stacked)
        alloc_test_require(os_load_i64(wrapping(stacked + I64{8})) == I64{1})
    }
}

alloc_test_nullable: fn() {
    alloc_test_require(alloc_try(I64{1}, I64{0}) == I64{0})
    alloc_test_require(alloc_try(I64{1}, I64{3}) == I64{0})
    alloc_test_require(alloc_try(I64{-1}, I64{8}) == I64{0})
    // Valid Layout, but the allocator's mapping overhead cannot fit.
    alloc_test_require(alloc_try(I64{9223372036854775807}, I64{1}) == I64{0})
    // The actual kernel refuses an address-space-sized mapping.
    alloc_test_require(alloc_map_try(I64{-1}) == I64{0})
    small: alloc_try(I64{8}, I64{8})
    alloc_test_require(small != I64{0})
    jet_rt_free(small, I64{8}, I64{8})
    aligned: alloc_try(I64{0}, I64{8192})
    alloc_test_require(aligned != I64{0} && (aligned & I64{8191}) == I64{0})
    jet_rt_free(aligned, I64{0}, I64{8192})
}

// #5041 P2: every align >= 8 block (small, large, over-aligned) starts with
// one owner in the count word 24 bytes before its payload; the block
// protocol shares it, and byte blocks (align < 8) carry no count.
priv alloc_test_count: fn(size: I64) {
    pointer: jet_rt_alloc(size, I64{8})
    #Unsafe("the test owns this fresh align-8 block and its count word") {
        alloc_test_require(os_load_i64(wrapping(pointer - I64{24})) == I64{1})
    }
    alloc_test_require(jet_rt_block_unique(pointer))
    jet_rt_block_retain(pointer)
    alloc_test_require(!jet_rt_block_unique(pointer))
    alloc_test_require(!jet_rt_block_release(pointer))
    alloc_test_require(jet_rt_block_unique(pointer))
    alloc_test_require(jet_rt_block_release(pointer))
    jet_rt_free(pointer, size, I64{8})
}

alloc_test_counts: fn() {
    alloc_test_count(I64{8})
    alloc_test_count(I64{24})
    alloc_test_count(I64{4000})
    alloc_test_count(I64{65537})
    over: jet_rt_alloc(I64{40}, I64{64})
    alloc_test_require(jet_rt_block_unique(over) && over & I64{63} == I64{0})
    jet_rt_free(over, I64{40}, I64{64})
}

// A block marked zero-at-free keeps its owner count in the low bits, is
// unique once one owner remains, keeps its bytes while an owner remains, and
// is zeroed by the free after its last release. A cached free reuses only the
// header words, so the payload stays readable here.
priv alloc_test_zero_mark: fn(size: I64, entry_8: Bool) {
    pointer: jet_rt_alloc(size, I64{8})
    at := I64{0}
    #Unsafe("the test owns this fresh align-8 block of size bytes") {
        loop at < size {
            os_store_u8(wrapping(pointer + at), I64{165})
            at = wrapping(at + I64{1})
        }
    }
    jet_rt_block_retain(pointer)
    jet_rt_block_mark_zero(pointer)
    jet_rt_block_mark_zero(pointer)
    #Unsafe("the test holds both owners of this block and its count word") {
        alloc_test_require(os_load_i64(wrapping(pointer - I64{24})) == RC_ZERO_MARK | I64{2})
    }
    alloc_test_require(!jet_rt_block_unique(pointer))
    alloc_test_require(!jet_rt_block_release(pointer))
    alloc_test_require(jet_rt_block_unique(pointer))
    #Unsafe("the test still owns this block") {
        alloc_test_require(os_load_u8(pointer) == I64{165} && os_load_u8(wrapping(pointer + size - I64{1})) == I64{165})
    }
    alloc_test_require(jet_rt_block_release(pointer))
    if entry_8 -> jet_rt_free_8(pointer, size) else -> jet_rt_free(pointer, size, I64{8})
    at = I64{0}
    #Unsafe("a cached small block stays mapped; its payload bytes are not cache links") {
        loop at < size {
            alloc_test_require(os_load_u8(wrapping(pointer + at)) == I64{0})
            at = wrapping(at + I64{1})
        }
    }
}

// A copy of a marked block is marked; a copy of an unmarked one is not.
alloc_test_zero_inherit: fn() {
    marked: jet_rt_alloc(I64{40}, I64{8})
    plain: jet_rt_alloc(I64{40}, I64{8})
    jet_rt_block_mark_zero(marked)
    inherited: jet_rt_alloc(I64{40}, I64{8})
    jet_rt_block_inherit_zero(plain, inherited)
    #Unsafe("the test owns these fresh align-8 blocks and their count words") {
        alloc_test_require(os_load_i64(wrapping(inherited - I64{24})) == I64{1})
    }
    jet_rt_block_inherit_zero(marked, inherited)
    #Unsafe("the test owns these fresh align-8 blocks and their count words") {
        alloc_test_require(os_load_i64(wrapping(inherited - I64{24})) == RC_ZERO_MARK | I64{1})
    }
    alloc_test_require(jet_rt_block_unique(inherited) && jet_rt_block_release(inherited))
    jet_rt_free(inherited, I64{40}, I64{8})
    jet_rt_free(plain, I64{40}, I64{8})
    jet_rt_free(marked, I64{40}, I64{8})
}

alloc_test_zero_marks: fn() {
    alloc_test_zero_mark(I64{40}, true)
    alloc_test_zero_mark(I64{40}, false)
    alloc_test_zero_mark(I64{1000}, true)
    alloc_test_zero_inherit()
}

// The thread cache: refills arrive 32 blocks at a time, a row holds at most
// 64 blocks, a full row returns 32 of them before taking one more, every
// cached block still counts as live in its slab, the witness nets the cached
// blocks out, and a flush returns them all.
alloc_test_cache: fn() {
    alloc_cache_flush()
    baseline: alloc_live_blocks(I64{64})
    row: alloc_cache_row(I64{64})
    alloc_test_require(row != I64{0})
    chain := I64{0}
    count := I64{0}
    loop count < (I64{100}) {
        pointer: jet_rt_alloc(I64{40}, I64{8})
        #Unsafe("the test owns the payload and keeps its chain word there") {
            os_store_i64(pointer, chain)
        }
        chain = pointer
        count = wrapping(count + I64{1})
    }
    alloc_test_require(alloc_live_blocks(I64{64}) == wrapping(baseline + I64{100}))
    // Four refills of 32 served the 100 allocations: 28 blocks stay cached.
    expected := I64{0}
    #Unsafe("row is this thread's own cache row") { expected = os_load_i64(wrapping(row + I64{8})) }
    alloc_test_require(expected == I64{28})
    loop chain != (I64{0}) {
        pointer: chain
        #Unsafe("the chain word remains readable until its payload is freed") {
            chain = os_load_i64(pointer)
        }
        jet_rt_free(pointer, I64{40}, I64{8})
        if (expected >= I64{64}) { expected = wrapping(expected - I64{32}) }
        expected = wrapping(expected + I64{1})
        #Unsafe("row is this thread's own cache row") {
            alloc_test_require(os_load_i64(wrapping(row + I64{8})) == expected)
        }
    }
    alloc_test_require(expected == I64{64})
    alloc_test_require(alloc_live_blocks(I64{64}) == baseline)
    alloc_cache_flush()
    #Unsafe("after the flush the row is empty") {
        alloc_test_require(os_load_i64(row) == I64{0} && os_load_i64(wrapping(row + I64{8})) == I64{0})
    }
    alloc_test_require(alloc_live_blocks(I64{64}) == baseline)
}

// The cached block count of the class `width` row of this thread.
priv alloc_test_row_count: fn(width: I64) -> I64 {
    row: alloc_cache_row(width)
    count := I64{0}
    #Unsafe("row is this thread's own cache row") { count = os_load_i64(wrapping(row + I64{8})) }
    count
}

// A block of jet_rt_alloc_8 is an align-8 payload with its count and block
// header words, one block out of the class `width` row: the count that row
// holds now.
priv alloc_test_row_taken: fn(width: I64, pointer: I64) -> I64 {
    alloc_test_require(pointer != I64{0} && pointer & I64{7} == I64{0})
    #Unsafe("the test owns this fresh align-8 block and its header words") {
        alloc_test_require(os_load_i64(wrapping(pointer - I64{24})) == I64{1})
        alloc_test_require(os_load_i64(wrapping(pointer - I64{8})) == wrapping(pointer - I64{24}))
    }
    alloc_test_require(jet_rt_block_unique(pointer))
    alloc_test_row_count(width)
}

// The align-8 entries (jet_rt_alloc_8, jet_rt_free_8): each row's smallest
// and largest size goes through its row's cache (an empty row's first
// request refills it by the general entry, so the second takes one more
// cached block and the frees put both back), a block of either kind of entry
// may be freed by the other, and a size past the rows is a direct mapping.
alloc_test_rows: fn() {
    alloc_cache_flush()
    width := I64{32}
    // Row `width` serves the sizes past the previous row's, row 32 from 0.
    smallest := I64{0}
    loop width <= (I64{4096}) {
        largest: wrapping(width - I64{24})
        first: jet_rt_alloc_8(smallest)
        cached: alloc_test_row_taken(width, first)
        second: jet_rt_alloc_8(largest)
        alloc_test_require(alloc_test_row_taken(width, second) == wrapping(cached - I64{1}))
        jet_rt_free_8(first, smallest)
        jet_rt_free_8(second, largest)
        alloc_test_require(alloc_test_row_count(width) == wrapping(cached + I64{1}))
        // Either kind of entry frees the other's block.
        general: jet_rt_alloc(largest, I64{8})
        alloc_test_require(alloc_test_row_taken(width, general) == cached)
        jet_rt_free_8(general, largest)
        entry: jet_rt_alloc_8(smallest)
        alloc_test_require(alloc_test_row_taken(width, entry) == cached)
        jet_rt_free(entry, smallest, I64{8})
        alloc_test_require(alloc_test_row_count(width) == wrapping(cached + I64{1}))
        smallest = wrapping(largest + I64{1})
        width = wrapping(width + width)
    }
    // Past the largest row: a direct mapping, no row block.
    held: alloc_test_row_count(I64{4096})
    large: jet_rt_alloc_8(I64{4073})
    alloc_test_require(large != I64{0} && alloc_test_row_count(I64{4096}) == held)
    jet_rt_free_8(large, I64{4073})
    alloc_test_require(alloc_test_row_count(I64{4096}) == held)
    // Null is a no-op, as for jet_rt_free.
    jet_rt_free_8(I64{0}, I64{200})
    alloc_cache_flush()
}

// A region takes its units from the region window, registered in the page
// map with no lock, and keeps its record in the window's slot for its first
// unit, with no heap block. An ended run's pages are dropped, and it is the
// next run of its class. A region larger than the largest class maps on its
// own, outside the window, with its record on the heap. The system refuses
// the window only under a finite address-space limit (RLIMIT_AS reads -1
// when unlimited) below its reservation; then a region is its own registered
// mapping, writable until its release, which unregisters it.
alloc_test_window: fn() {
    first: jet_rt_mem_region_reserve(I64{65536})
    window: sync_load(wrapping(alloc_root + ALLOC_WINDOW))
    if (window == I64{0}) {
        alloc_test_require(thread_rlimit_soft(I64{9}) >= I64{0})
        alloc_test_require(first != I64{0} && alloc_page_region(first) != I64{0})
        #Unsafe("the region owns its 64 KiB until its release below") {
            os_store_i64(wrapping(first + I64{65528}), I64{9})
            alloc_test_require(os_load_i64(wrapping(first + I64{65528})) == I64{9})
        }
        jet_rt_mem_region_release(first, I64{65536})
        alloc_test_require(alloc_page_region(first) == I64{0})
        alloc_cache_flush()
        return
    }
    end: wrapping(window + ALLOC_WINDOW_BYTES)
    alloc_test_require(first != I64{0} && first >= window && first < end)
    alloc_test_require(first & wrapping(ALLOC_PAGE_UNIT - I64{1}) == I64{0} && alloc_page_region(first) != I64{0})
    records: wrapping(window + ALLOC_WINDOW_RECORDS)
    alloc_test_require(alloc_page_region(first) == wrapping(records + wrapping(alloc_test_unit(window, first) * ALLOC_REGION_RECORD_BYTES)))
    #Unsafe("the region owns its 64 KiB until its release below") {
        os_store_i64(first, I64{7})
        os_store_i64(wrapping(first + I64{65528}), I64{9})
        alloc_test_require(os_load_i64(first) == I64{7} && os_load_i64(wrapping(first + I64{65528})) == I64{9})
    }
    two: jet_rt_mem_region_reserve(I64{65537})
    alloc_test_require(two != I64{0} && two != first && two >= window && two < end)
    #Unsafe("the region owns its two units until its release below") {
        os_store_i64(wrapping(two + I64{65536}), I64{5})
    }
    jet_rt_mem_region_release(first, I64{65536})
    alloc_test_require(alloc_page_region(first) == I64{0})
    again: jet_rt_mem_region_reserve(I64{100})
    alloc_test_require(again == first && alloc_page_region(again) != I64{0})
    #Unsafe("the run's pages were dropped at its release, and it stays writable for this region") {
        alloc_test_require(os_load_i64(again) == I64{0} && os_load_i64(wrapping(again + I64{65528})) == I64{0})
    }
    jet_rt_mem_region_release(again, I64{100})
    jet_rt_mem_region_release(two, I64{65537})
    largest: ALLOC_PAGE_UNIT << wrapping(ALLOC_WINDOW_CLASSES - I64{1})
    alone: jet_rt_mem_region_reserve(wrapping(largest + I64{1}))
    alloc_test_require(alone != I64{0} && (alone < window || alone >= end) && alloc_page_region(alone) != I64{0})
    alone_record: alloc_page_region(alone)
    alloc_test_require(alone_record < records || alone_record >= wrapping(window + wrapping(ALLOC_WINDOW_LINK_UNITS * ALLOC_PAGE_UNIT)))
    jet_rt_mem_region_release(alone, wrapping(largest + I64{1}))
    alloc_test_require(alloc_page_region(alone) == I64{0})
    back: jet_rt_mem_region_reserve(I64{131072})
    alloc_test_require(back == two)
    #Unsafe("the region owns its two units until its release below") {
        alloc_test_require(os_load_i64(wrapping(back + I64{65536})) == I64{0})
    }
    jet_rt_mem_region_release(back, I64{131072})
    // Registration and release of a window run take no page lock.
    lock: wrapping(alloc_root + ALLOC_PAGE_LOCK)
    alloc_lock(lock)
    held: jet_rt_mem_region_reserve(I64{65536})
    registered: held != I64{0} && alloc_page_region(held) != I64{0}
    jet_rt_mem_region_release(held, I64{65536})
    alloc_unlock(lock)
    alloc_test_require(registered && alloc_page_region(held) == I64{0})
    alloc_cache_flush()
}

// The window unit of `address`, inside the window at `window`.
alloc_test_unit: fn(window: I64, address: I64) -> I64 { wrapping(address - window) >> I64{16} }

// A thread's ended runs go on its own stack, up to ALLOC_WINDOW_ROW_LIMIT a
// class, and its next region of that class takes the latest back; the rest
// go on the shared stack. A fiber's switch moves the rows, a class the
// target already keeps runs of shelves the moved ones, and thread exit
// shelves them all.
alloc_test_window_rows: fn() {
    alloc_window_rows_flush()
    window: sync_load(wrapping(alloc_root + ALLOC_WINDOW))
    // No window, no runs to keep: alloc_test_window checked the fallback.
    if (window == I64{0}) {
        return
    }
    stack: wrapping(alloc_root + ALLOC_WINDOW_STACKS)
    row: alloc_window_row(I64{0})
    alloc_test_require(row != I64{0} && sync_load(row) == I64{0})
    count: wrapping(ALLOC_WINDOW_ROW_LIMIT + I64{1})
    runs: jet_rt_alloc(wrapping(count * I64{8}), I64{8})
    #Unsafe("runs holds count words this test owns, and the window's link words stay mapped") {
        at := I64{0}
        loop at < count {
            run: jet_rt_mem_region_reserve(I64{65536})
            alloc_test_require(run != I64{0} && run >= window && run < wrapping(window + ALLOC_WINDOW_BYTES))
            os_store_i64(wrapping(runs + wrapping(at * I64{8})), run)
            at += I64{1}
        }
        at = I64{0}
        loop at < count {
            jet_rt_mem_region_release(os_load_i64(wrapping(runs + wrapping(at * I64{8}))), I64{65536})
            at += I64{1}
        }
        last_kept: os_load_i64(wrapping(runs + wrapping(wrapping(ALLOC_WINDOW_ROW_LIMIT - I64{1}) * I64{8})))
        spilled: os_load_i64(wrapping(runs + wrapping(ALLOC_WINDOW_ROW_LIMIT * I64{8})))
        kept: sync_load(row)
        alloc_test_require(kept >> I64{20} == ALLOC_WINDOW_ROW_LIMIT && kept & ALLOC_WINDOW_INDEX == alloc_test_unit(window, last_kept))
        alloc_test_require(sync_load(stack) & ALLOC_WINDOW_INDEX == alloc_test_unit(window, spilled))
        again: jet_rt_mem_region_reserve(I64{65536})
        alloc_test_require(again == last_kept && sync_load(row) >> I64{20} == wrapping(ALLOC_WINDOW_ROW_LIMIT - I64{1}))
        jet_rt_mem_region_release(again, I64{65536})
        // A fiber takes the rows and gives them back.
        tcb: thread_base()
        fiber_tcb: jet_rt_alloc(context_tcb_bytes(), I64{64})
        thread_zero(fiber_tcb, context_tcb_bytes())
        alloc_window_rows_move(tcb, fiber_tcb)
        alloc_test_require(sync_load(row) == I64{0} && sync_load(wrapping(fiber_tcb + ALLOC_WINDOW_ROWS)) == kept)
        held: jet_rt_mem_region_reserve(I64{65536})
        jet_rt_mem_region_release(held, I64{65536})
        alloc_window_rows_move(fiber_tcb, tcb)
        first: os_load_i64(runs)
        alloc_test_require(sync_load(wrapping(fiber_tcb + ALLOC_WINDOW_ROWS)) == I64{0} && sync_load(row) & ALLOC_WINDOW_INDEX == alloc_test_unit(window, held))
        alloc_test_require(sync_load(stack) & ALLOC_WINDOW_INDEX == alloc_test_unit(window, first))
        jet_rt_free(fiber_tcb, context_tcb_bytes(), I64{64})
        alloc_window_rows_flush()
        alloc_test_require(sync_load(row) == I64{0} && sync_load(stack) & ALLOC_WINDOW_INDEX == alloc_test_unit(window, held))
        jet_rt_free(runs, wrapping(count * I64{8}), I64{8})
    }
}

// Probes for AllocCacheWitness.c, the multi-thread cache witness.
#Export(c) alloc_test_live_blocks: fn(width: I64) -> I64 { alloc_live_blocks(width) }

#Export(c) alloc_test_cache_flush: fn() { alloc_cache_flush() }

alloc_tests: fn() {
    alloc_test_named(rt_static_text("layout"))
    jet_rt_alloc_init()
    jet_rt_alloc_init()
    alloc_test_require(alloc_layout_valid(I64{0}, I64{1}))
    alloc_test_require(!alloc_layout_valid(I64{1}, I64{0}))
    alloc_test_require(!alloc_layout_valid(I64{1}, I64{3}))
    alloc_test_require(!alloc_layout_valid(I64{-1}, I64{8}))
    alloc_test_require(!alloc_layout_valid(I64{9223372036854775807}, I64{8}))
    // Null must remain a no-op even with an otherwise-invalid layout.
    jet_rt_free(I64{0}, I64{-1}, I64{0})
    alloc_test_named(rt_static_text("nullable"))
    alloc_test_nullable()
    alloc_test_named(rt_static_text("row classes"))
    alloc_test_row_classes()
    alloc_test_named(rt_static_text("boundaries at align 1"))
    alloc_test_boundaries(I64{1})
    alloc_test_named(rt_static_text("boundaries at align 8"))
    alloc_test_boundaries(I64{8})
    alloc_test_named(rt_static_text("boundaries at align 16"))
    alloc_test_boundaries(I64{16})
    alloc_test_named(rt_static_text("boundaries at align 64"))
    alloc_test_boundaries(I64{64})
    alloc_test_named(rt_static_text("boundaries at align 4096"))
    alloc_test_boundaries(I64{4096})
    alloc_test_named(rt_static_text("payload of 0 bytes at align 1"))
    alloc_test_payload(I64{0}, I64{1})
    alloc_test_named(rt_static_text("payload of 0 bytes at align 8192"))
    alloc_test_payload(I64{0}, I64{8192})
    alloc_test_named(rt_static_text("payload of 1 byte at align 8192"))
    alloc_test_payload(I64{1}, I64{8192})
    alloc_test_named(rt_static_text("payload of 65537 bytes at align 8192"))
    alloc_test_payload(I64{65537}, I64{8192})
    alloc_test_named(rt_static_text("large reuse"))
    alloc_test_large_reuse()
    alloc_test_named(rt_static_text("large rows"))
    alloc_test_large_rows()
    alloc_test_named(rt_static_text("reuse"))
    alloc_test_reuse()
    alloc_test_named(rt_static_text("full slabs"))
    alloc_test_full_slabs()
    alloc_test_named(rt_static_text("slab stack"))
    alloc_test_slab_stack()
    alloc_test_named(rt_static_text("counts"))
    alloc_test_counts()
    alloc_test_named(rt_static_text("zero marks"))
    alloc_test_zero_marks()
    alloc_test_named(rt_static_text("cache"))
    alloc_test_cache()
    alloc_test_named(rt_static_text("rows"))
    alloc_test_rows()
    alloc_test_named(rt_static_text("window"))
    alloc_test_window()
    alloc_test_named(rt_static_text("window rows"))
    alloc_test_window_rows()
    #Unsafe("the exact success line is two bounded stack words written to stdout") {
        _ := os_write_word_i64(I64{1}, I64{7310503706572385377}, I64{8})
        _ := os_write_word_i64(I64{1}, I64{750815947097601139}, I64{8})
    }
}
