// Witness-only C doors into the real non-exported production helpers.
// Compose this test unit beside JetRuntime sources, never in sources/exports.list.
#Export(c) fn ui_host_error_witness_clone(value: I64) -> I64 { ui_host_error_clone(value) }
#Export(c) fn ui_host_error_witness_drop(value: I64) { ui_host_error_drop(value) }
#Export(c) fn ui_host_error_witness_eq(a: I64, b: I64) -> Bool { ui_host_error_eq(a, b) }
