// Direct FD72 fixture: a line spanning several refills, preserved CR/LF,
// read/line interleaving, logical SEEK_CUR and EOF. Path belongs to the caller.
fn compiler_file_fixture_bytes(slots: I64, expected: I64, size: I64) -> Bool {
    data :: rt_text_word(slots)
    count :: rt_text_word(slots + I64{8})
    same := count == size
    if same {
        at := I64{0}
        loop at < size {
            if (host_u8_get(data, at) != rt_text_byte(rt_text_data(expected) + at)) -> same = false
            at += I64{1}
        }
    }
    if (count != I64{0}) -> jet_rt_free(data, count * RT_HOST_U8_STRIDE, I64{8})
    same
}
#Export(c) fn jet_rt_compiler_file_leaves_fixture(path: I64) -> I64 {
    slots :: jet_rt_alloc(I64{80}, I64{8})
    data :: jet_rt_alloc(I64{20010} * RT_HOST_U8_STRIDE, I64{8})
    at := I64{0}
    loop at < (I64{20000}) {
        host_u8_put(data, at, I64{97})
        at += I64{1}
    }
    carriage :: jet_rt_char_to_string(I64{13})
    target :: jet_rt_string_builder_new()
    jet_rt_string_builder_push(target, carriage)
    jet_rt_string_builder_push(target, carriage)
    jet_rt_string_builder_push(target, rt_static_text("\nb\ntail"))
    jet_rt_string_builder_push(target, carriage)
    jet_rt_string_drop(carriage)
    tail :: jet_rt_string_builder_finish(target)
    at = I64{0}
    loop at < (I64{10}) {
        host_u8_put(data, I64{20000} + at, rt_text_byte(rt_text_data(tail) + at))
        at += I64{1}
    }
    if (jet_files_write_bytes_os(path, data, I64{20010}, slots + I64{16}) != I64{1}) -> return I64{1}
    jet_rt_free(data, I64{20010} * RT_HOST_U8_STRIDE, I64{8})
    if (jet_std_files_open_reader_nonblocking(path, slots, slots + I64{16}) != I64{1}) -> return I64{2}
    reader :: rt_text_word(slots)
    if (jet_file_reader_line_bytes_raw(reader, slots, slots + I64{8}, slots + I64{16}) != I64{1} || rt_text_word(slots + I64{8}) != I64{20003}) -> return I64{3}
    first :: rt_text_word(slots)
    at = I64{0}
    loop at < (I64{20000}) {
        if (host_u8_get(first, at) != I64{97}) -> return I64{4}
        at += I64{1}
    }
    if (host_u8_get(first, I64{20000}) != I64{13} || host_u8_get(first, I64{20001}) != I64{13} || host_u8_get(first, I64{20002}) != I64{10}) -> return I64{5}
    jet_rt_free(first, I64{20003} * RT_HOST_U8_STRIDE, I64{8})
    if (jet_file_reader_line_bytes_raw(reader, slots, slots + I64{8}, slots + I64{16}) != I64{1} || !compiler_file_fixture_bytes(slots, rt_static_text("b\n"), I64{2})) -> return I64{6}
    raw :: jet_rt_alloc(I64{2}, I64{8})
    if (jet_fd_read_raw(reader, raw, I64{2}, slots + I64{40}) != I64{2} || rt_text_byte(raw) != I64{116} || rt_text_byte(raw + I64{1}) != I64{97}) -> return I64{7}
    jet_rt_free(raw, I64{2}, I64{8})
    // Descriptor is ahead at EOF, but the reader's logical cursor is at 20007.
    if (jet_fd_seek_raw(reader, I64{0}, I64{1}, slots + I64{40}, slots + I64{72}) != I64{20007}) -> return I64{8}
    suffix :: rt_text_copy(rt_text_data(tail) + I64{7}, I64{3})
    if (jet_file_reader_line_bytes_raw(reader, slots, slots + I64{8}, slots + I64{16}) != I64{1} || !compiler_file_fixture_bytes(slots, suffix, I64{3})) -> return I64{9}
    jet_rt_string_drop(suffix)
    jet_rt_string_drop(tail)
    if (jet_file_reader_line_bytes_raw(reader, slots, slots + I64{8}, slots + I64{16}) != I64{1} || rt_text_word(slots) != I64{0} || rt_text_word(slots + I64{8}) != I64{0}) -> return I64{10}
    jet_fd_close_raw(reader, slots + I64{40}, slots + I64{72})
    if (jet_file_reader_line_bytes_raw(reader, slots, slots + I64{8}, slots + I64{16}) != I64{0}) -> return I64{11}
    jet_rt_handle_drop_io_error(rt_text_word(slots + I64{16}))
    jet_fd_drop_raw(reader)
    jet_rt_free(slots, I64{80}, I64{8})
    I64{0}
}
