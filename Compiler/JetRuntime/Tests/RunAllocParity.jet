#!/usr/bin/env jet
// Jet-only allocator failure witness: two standalone C hosts link the supplied
// Jet-authored runtime and every case holds its exit, signal and stderr.
// CAbiDriver.c (built with C_ABI_ALLOC_ONLY) starts the runtime as a program's
// main does (jet_rt_host_arguments); EmbedHost.c is a foreign host that never
// does. A system linker keeps every runtime .init_array hook, the checked
// heap's (Alloc.jet jet_rt_alloc_check_init) among them, so both hosts run in
// checked mode, as a Jet program built with `--checked-alloc` does: every bad
// free traps with a report naming the case's own function (the call site), then
// SIGABRT, and a clean case stays silent. OUT keeps each build log, each case's
// stdout, stderr and status, and alloc-parity.tsv.
// Usage (from the repository root):
//   jet Compiler/JetRuntime/Tests/RunAllocParity.jet OUT JET_ONLY_RUNTIME_OBJECT_OR_ARCHIVE... [LINK_ARG...]
use {
    files: core.files
    process: core.process
    re: core.regex
}

POLICY: "Compiler/JetCli/Source/Cli/native-c-policy.tsv"
// isize::MAX - 7, aligned to 8 on x86-64.
HUGE: "9223372036854775800"
TRAP: "jet checked allocator: "

// One case: the host tier that runs it, its exit status (or signal), and the
// stderr it must equal exactly, start with, and contain.
Case: struct {
    name: String
    tier: String
    status: Int?
    signal: String
    exact: String?
    prefix: String
    contains: [String]
}

// One child run: no status after a signal or a spawn failure; `signal` and
// `error` are "" when absent.
Ran: struct {
    stdout: String
    stderr: String
    status: Int?
    signal: String
    error: String
}

Policy: struct {
    flags: [String]
    removed: [String]
}

fail: fn(message: String) -> Never { process.fail(1, message) }

trapped: fn(name: String, tier: String, prefix: String, contains: [String]) -> Case {
    Case{name: name, tier: tier, status: None, signal: "SIGABRT", exact: None, prefix: prefix, contains: contains}
}

cases: fn() -> [Case] {
    [Case]{
        Case{name: "alloc-invalid-layout", tier: "native", status: Val(70), signal: "", exact: None, prefix: "Stop [E3001]: `panic: invalid box layout`\n  --> <core.prelude>:0\n", contains: [String]{}},
        Case{name: "alloc-failure", tier: "native", status: None, signal: "SIGABRT", exact: Val("memory allocation of {HUGE} bytes failed\n"), prefix: "", contains: [String]{}},
        Case{name: "alloc-checked-clean", tier: "native", status: Val(0), signal: "", exact: Val(""), prefix: "", contains: [String]{}},
        trapped("alloc-double-free", "native", "{TRAP}double free of 0x", [String]{"(40 bytes, align 8)\n  at:\n", " alloc_double_free+0x", "  first freed at:\n", "  allocated at:\n"}),
        trapped("alloc-foreign-free", "native", "{TRAP}free of 0x", [String]{"(16 bytes, align 8), which this heap never handed out", " alloc_foreign_free+0x"}),
        trapped("alloc-layout-mismatch", "native", "{TRAP}free of 0x", [String]{"(16 bytes, align 8), allocated as (24 bytes, align 8)", " alloc_layout_mismatch+0x"}),
        trapped("alloc-overflow", "native", "{TRAP}write past the end of 0x", [String]{"(20 bytes, align 1), found at its free", " alloc_overflow+0x"}),
        trapped("alloc-write-after-free", "native", "{TRAP}write after free into 0x", [String]{"(40 bytes, align 8) at byte offset 3\n", "  freed at:\n", " alloc_write_after_free+0x"}),
        Case{name: "embed-clean", tier: "embed", status: Val(0), signal: "", exact: Val(""), prefix: "", contains: [String]{}},
        trapped("embed-double-free", "embed", "{TRAP}double free of 0x", [String]{"(40 bytes, align 8)\n  at:\n", " embed_double_free+0x"}),
    }
}

// path.resolve against the working directory.
resolve: fn(cwd: String, path: String) -> String {
    full: if path.starts_with("/") -> path.copy() else -> "{cwd}/{path}"
    parts := [String]{}
    loop part in full.split("/").to_list() {
        if part == ".." {
            if parts.len() > 0 -> _: parts.pop()
        } else if part != "" && part != "." {
            parts.push(part)
        }
    }
    "/{parts.join("/")}"
}

signal_name: fn(number: Int) -> String {
    names: [String]{"", "SIGHUP", "SIGINT", "SIGQUIT", "SIGILL", "SIGTRAP", "SIGABRT", "SIGBUS", "SIGFPE", "SIGKILL", "SIGUSR1", "SIGSEGV", "SIGUSR2", "SIGPIPE", "SIGALRM", "SIGTERM"}
    if number > 0 && number < names.len() -> return names[number].copy()
    "SIG{number}"
}

ran_of: fn(spec: ProcessSpec) -> Ran {
    if spec.run() == {
        .Ok(receipt) -> {
            if receipt.signal == .Val(number) -> return Ran{stdout: receipt.output, stderr: receipt.errors, status: None, signal: signal_name(number), error: ""}
            Ran{stdout: receipt.output, stderr: receipt.errors, status: Val(receipt.code), signal: "", error: ""}
        }
        .Err(error) -> Ran{stdout: "", stderr: "", status: None, signal: "", error: "{error}"}
    }
}

// The rows of Compiler/JetCli/Source/Cli/native-c-policy.tsv: compiler flags
// and the NIX_HARDENING_ENABLE features they remove.
load_policy: fn(root: String) -> Policy {
    text: files.read("{root}/{POLICY}") ?? fail("cannot read {POLICY}: {err}")
    flags := [String]{}
    removed := [String]{}
    lines: text.split("\n").to_list()
    loop index in 0..<lines.len() {
        line: lines[index]
        if line == "" || line.starts_with("#") -> next
        fields: line.split("\t").to_list()
        if fields.len() != 2 || fields[1] == "" -> fail("native-c-policy.tsv:{index + 1}: expected \"kind<TAB>value\"")
        if fields[0] == "flag" {
            flags.push(fields[1])
        } else if fields[0] == "hardening-remove" {
            removed.push(fields[1])
        } else {
            fail("native-c-policy.tsv:{index + 1}: unknown policy kind {fields[0]}")
        }
    }
    Policy{flags: flags, removed: removed}
}

// `$CC` (default `cc`) with `args` and the policy flags, as
// Tools/packaging/NativeCCompiler.jet runs it.
native_cc: fn(policy: Policy, args: [String]) -> Ran {
    removed: policy.removed
    spec := process.cmd([process.env_get_or("CC", "cc")]).args_extend(args).args_extend(policy.flags)
    if process.env_get("NIX_HARDENING_ENABLE") == .Val(enabled) {
        words: re.split(Regex{"\s+"}, enabled)
        kept: loop word in words if word != "" && !removed.contains(word) -> word
        spec = spec.env("NIX_HARDENING_ENABLE", kept.join(" "))
    }
    ran_of(spec)
}

status_json: fn(ran: Ran) -> String {
    status: if ran.status == .Val(code) -> "{code}" else -> "null"
    signal: if ran.signal == "" -> "null" else -> "\"{ran.signal}\""
    error: if ran.error == "" -> "null" else -> "\"{ran.error.replace("\\", "\\\\").replace("\"", "\\\"")}\""
    "{{\"status\":{status},\"signal\":{signal},\"error\":{error}}}\n"
}

write: fn(path: String, text: String) {
    files.write(path, text) ?? fail("cannot write {path}: {err}")
}

// Every way the case's run departs from its expectations.
departures: fn(item: Case, ran: Ran) -> [String] {
    found := [String]{}
    label: "{item.name}/{item.tier}"
    if ran.error != "" || ran.status != item.status || ran.signal != item.signal || ran.stdout != "" {
        found.push("{label}: unexpected status, signal, spawn error or stdout; see captured status/bytes")
    }
    if item.exact == .Val(text) {
        if ran.stderr != text -> found.push("{label}: allocation failure bytes differ from required diagnostic")
    }
    if !ran.stderr.starts_with(item.prefix) -> found.push("{label}: diagnostic prefix differs")
    loop part in item.contains {
        if !ran.stderr.contains(part) -> found.push("{label}: diagnostic lacks {part.replace("\n", "\\n")}")
    }
    found
}

run: fn() {
    root: files.cwd() ?? fail("cannot read the working directory: {err}")
    policy: load_policy(root)
    args: process.args()
    if args.len() < 2 || args[0] == "" -> fail("usage: RunAllocParity.jet OUT JET_ONLY_RUNTIME_OBJECT_OR_ARCHIVE... [LINK_ARG...]")
    out: resolve(root, args[0])
    files.create_dir_all(out) ?? fail("cannot create {out}: {err}")
    inputs: loop input in args[1..<args.len()] -> if input.starts_with("-") -> input.copy() else -> resolve(root, input)
    errors := [String]{}
    built := [String]{}
    loop tier in ([String]{"native", "embed"}) {
        cc_args := [String]{"-std=c11", "-Wall", "-Wextra", "-Werror", "-pedantic"}
        if tier == "native" {
            cc_args.push("-DC_ABI_ALLOC_ONLY=1")
            cc_args.push("{root}/Compiler/JetRuntime/Tests/CAbiDriver.c")
        } else {
            cc_args.push("{root}/Compiler/JetRuntime/Tests/EmbedHost.c")
        }
        loop input in inputs -> cc_args.push(input.copy())
        cc_args.extend([String]{"-lpthread", "-ldl", "-lm", "-o", "{out}/alloc-{tier}"})
        ran: native_cc(policy, cc_args)
        write("{out}/{tier}.build.stdout", ran.stdout)
        write("{out}/{tier}.build.stderr", ran.stderr)
        if ran.error != "" || ran.signal != "" || ran.status != .Val(0) {
            errors.push("{tier} fixture build failed; see {tier}.build.stderr")
        } else {
            built.push(tier.copy())
        }
    }
    rows := [String]{"case\tresult\tstatus\tsignal"}
    loop item in cases() {
        before: errors.len()
        if built.contains(item.tier) {
            ran: ran_of(process.cmd([String]{"{out}/alloc-{item.tier}", item.name.copy()}))
            stem: "{out}/{item.name}.{item.tier}"
            write("{stem}.stdout", ran.stdout)
            write("{stem}.stderr", ran.stderr)
            write("{stem}.status.json", status_json(ran))
            errors.extend(departures(item, ran))
        } else {
            errors.push("{item.name}/{item.tier}: build failed")
        }
        status: if item.status == .Val(code) -> "{code}" else -> ""
        verdict: if errors.len() == before -> "PASS" else -> "FAIL"
        rows.push("{item.name}\t{verdict}\t{status}\t{item.signal}")
    }
    write("{out}/alloc-parity.tsv", "{rows.join("\n")}\n")
    if errors.len() > 0 -> fail(errors.join("\n"))
    print("alloc parity: {cases().len()} checked-allocator cases passed")
}

#Test("every case expects one outcome and a bad run departs") {
    loop item in cases() {
        assert(item.status != None || item.signal == "SIGABRT")
        assert(item.tier == "native" || item.tier == "embed")
    }
    clean: cases()[2]
    assert_eq(departures(clean, Ran{stdout: "", stderr: "", status: Val(0), signal: "", error: ""}).len(), 0)
    assert_eq(departures(clean, Ran{stdout: "x", stderr: "y", status: Val(0), signal: "", error: ""}).len(), 2)
    double: cases()[3]
    report: "{TRAP}double free of 0x10 (40 bytes, align 8)\n  at:\n  alloc_double_free+0x4\n  first freed at:\n  allocated at:\n"
    assert_eq(departures(double, Ran{stdout: "", stderr: report, status: None, signal: "SIGABRT", error: ""}).len(), 0)
    assert_eq(resolve("/a/b", "../c/./d"), "/a/c/d")
}
