# Audited C platform imports of the full Jet runtime object.
# All Jet-owned iterator, hazard, Observe and environment policies resolve
# within the ONE checked runtime object; no Rust provider is permitted.
pthread_attr_destroy
pthread_attr_init
pthread_attr_setstacksize
pthread_create
pthread_detach
pthread_join
# Platform resolver; musl until glibc dynamic linking.
getaddrinfo
freeaddrinfo
gai_strerror
__errno_location
# Scalar libm functions supplied by the permitted C platform archive.
acos
acosh
asin
asinh
atan
atan2
atanh
cbrt
ceil
cos
cosh
exp
expm1
exp2
floor
fma
fmod
hypot
log
log1p
log10
log2
pow
sin
sinh
sqrt
tan
tanh
trunc
round
# core.sys initgroups (RouteSys.jet), read with errno; musl applies it to every thread.
initgroups
# The fault report every image link writes (Image/StaticLink.jet link_fault_report);
# a platform link of this object adds Tools/packaging/fault-report-object.mjs.
jet_rt_fault_report
