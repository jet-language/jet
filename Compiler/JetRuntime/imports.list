# Audited C platform imports of the full Jet runtime object.
# All Jet-owned iterator, hazard, Observe and environment policies resolve
# within the ONE checked runtime object; no Rust provider is permitted.
pthread_attr_destroy
pthread_attr_init
pthread_attr_setstacksize
pthread_create
pthread_detach
pthread_join
# The fault report every image link writes (Image/StaticLink.jet link_fault_report);
# a platform link of this object adds Tools/packaging/fault-report-object.mjs.
jet_rt_fault_report
