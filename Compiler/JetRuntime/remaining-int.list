# Remaining Rust-owned exact-Int node machinery in native packs after L4a.
# These are Rust source identities. The only C-ABI import of the Jet object
# is jet_rt_int_retire_zero, approved as a shared-domain memory-only seam.
# Their monomorphized/inlined object names are recorded by run-int-cabi.mjs.
# Native scalar Int is LowerRepr.Word and lower_drop returns LIRDrop.Trivial:
# user-owned boxed native values currently lack general drop/copy-retain glue.
# jet_rt_int_drop implements atomic owner decrement; NativeInteg2 owns wiring
# lowering's general drop/copy-retain glue. int_discard is private refs1 only.
jet_int_allocate
jet_int_free
jet_int_try_node
JetIntNode::limbs
JetIntNode::to_big
JetIntNode::try_to_big
JetIntNode::to_i64
JetIntNode::compare_big
jet_int_hazard_record
JetIntReadGuard::enter
JetIntReadGuard::protect
JetIntReadGuard::drop
jet_int_push_retired
jet_int_is_hazard
jet_int_deallocate
jet_int_retire_zero
jet_int_retire_raw_zero
jet_rt_int_retire_zero
jet_int_reclaim_retired
jet_int_try_retain
jet_int_retain
jet_int_release
