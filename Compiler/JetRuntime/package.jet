name: "jet_runtime"
version: "0.0.1"
edition: "2026"
outputs: {
    runtime: .Library{
        name: "jet_runtime_jet",
        native: true
    }
}
// The memory kernel: the raw word and byte leaves, the allocator, the
// atomics and locks, threads, fibers and their stack segments, fault and
// secret storage, and the compiler's mapped files. A composed runtime unit
// lists these by checkout path (Toolchain/RuntimePack.jet unit_manifest).
policy: {
    memory: .Kernel(["Source/RawWords.jet", "Source/Alloc.jet", "Source/Sync.jet", "Source/Thread.jet", "Source/Fiber.jet", "Source/StackSegment.jet", "Source/Fault.jet", "Source/Secret.jet", "Source/CompilerMapped.jet"]),
}
