    rt_text_store(plan + VAULT_PLAN_ACTION, action)
    rt_text_store(plan + VAULT_PLAN_NAME, name)
    rt_text_store(plan + VAULT_PLAN_TARGET, target)
    rt_text_store(plan + VAULT_PLAN_IMPORTED, imported)
    rt_text_store(plan + VAULT_PLAN_REASON, reason)
    read_error :: vault_read_at_root(root, scratch + I64{8480}, plan + VAULT_PLAN_START_HASH, plan + VAULT_PLAN_PROVIDER, plan + VAULT_PLAN_KIND)
    if (read_error != I64{0}) -> return read_error
