    rt_text_push_word(target, I64{8314037927948153961}, I64{8})
    rt_text_push_word(target, I64{540700271}, I64{4})
    jet_rt_string_builder_push(target, reason)
    rt_text_push_word(target, I64{7310021076952883259}, I64{8})
    rt_text_push_word(target, I64{7881150267141742451}, I64{8})
    rt_text_push_word(target, I64{2112115}, I64{3})
