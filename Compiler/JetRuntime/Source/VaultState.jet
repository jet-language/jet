// Owned native provider state; Record key storage is the canonical native
// Secret, not a Rust Vec/key object. Raw u64 bit words retain the entire
// reference range (including its high bit).
VAULT_STORE_BYTES: I64{40}
VAULT_STORE_UUID: I64{0}
VAULT_STORE_REVISION: I64{16}
VAULT_STORE_STRINGS: I64{24}
VAULT_STORE_RECORDS: I64{32}
VAULT_RECORD_BYTES: I64{184}
VAULT_RECORD_NAME: I64{0}
VAULT_RECORD_TYPE: I64{8}
VAULT_RECORD_GENERATION: I64{16}
VAULT_RECORD_STATUS: I64{24}
VAULT_RECORD_PROVENANCE: I64{32}
VAULT_RECORD_OPAQUE: I64{40}
VAULT_RECORD_CREATED: I64{56}
VAULT_RECORD_STATUS_MS: I64{64}
VAULT_RECORD_HASH: I64{72}
VAULT_RECORD_PUBLIC_HASH: I64{104}
VAULT_RECORD_REASON_HASH: I64{136}
VAULT_RECORD_ORIGIN: I64{168}
VAULT_RECORD_SECRET: I64{176}
VAULT_ORIGIN_BYTES: I64{80}
VAULT_ORIGIN_UUID: I64{0}
VAULT_ORIGIN_NAME: I64{16}
VAULT_ORIGIN_GENERATION: I64{24}
VAULT_ORIGIN_OPAQUE: I64{32}
VAULT_ORIGIN_HASH: I64{48}
vault_unsigned_less: fn(left: I64, right: I64) -> Bool {
    (left.bit_xor(I64{-9223372036854775808})) < (right.bit_xor(I64{-9223372036854775808}))
}
vault_bytes_zero: fn(data: I64, length: I64) -> Bool {
    at := I64{0}
    loop at < length {
        if (rt_text_byte(wrapping(data + at)) != I64{0}) -> return false
        at += I64{1}
    }
    true
}
vault_put_u64: fn(target: I64, value: I64) {
    at := I64{0}
    loop {
        if (at == I64{8}) -> break
        rt_text_put(wrapping(target + at), (value >> (at * I64{8})).bit_and(I64{255}))
        at += I64{1}
    }
}
// UTF-8 preflight only protects the raw test boundary. NFC is the shared native
// provider48a5f5ae9, never Rust JetCString reinterpretation.
vault_validate_text: fn(text: I64, reason: Bool) -> Bool {
    length: rt_text_len(text)
    limit: if reason -> I64{256} else -> I64{128}
    if (length == I64{0} || length > limit) -> return false
    data: rt_text_data(text)
    if !vault_utf8_valid(data, length) -> return false
    if !reason && (rt_text_byte(data) == I64{46}) && (length == I64{1} || (length == I64{2} && rt_text_byte(wrapping(data + I64{1})) == I64{46})) -> return false
    normalized: jet_text_nfc(text)
    same: jet_rt_string_eq(text, normalized)
    jet_rt_string_drop(normalized)
    if !same -> return false
    at := I64{0}
    loop at < length {
        cp: rt_text_decode(wrapping(data + at))
        width: rt_text_width(wrapping(data + at))
        if (cp < I64{32} || (cp >= I64{127} && cp <= I64{159})) -> return false
        if ((at == I64{0} || at + width == length) && unicode_is_white_space(cp)) -> return false
        if (!reason && (cp == I64{47} || cp == I64{92})) -> return false
        if (reason && (cp == I64{8232} || cp == I64{8233})) -> return false
        at += width
    }
    true
}
vault_origin_clone: fn(origin: I64) -> I64 {
    if (origin == I64{0}) -> return I64{0}
    result: jet_rt_alloc(VAULT_ORIGIN_BYTES, I64{8})
    rt_text_bytes_copy(result, origin, VAULT_ORIGIN_BYTES)
    rt_text_store(wrapping(result + VAULT_ORIGIN_NAME), jet_rt_string_clone(rt_text_word(wrapping(origin + VAULT_ORIGIN_NAME))))
    result
}
vault_origin_drop: fn(origin: I64) {
    if (origin == I64{0}) -> return
    jet_rt_string_drop(rt_text_word(wrapping(origin + VAULT_ORIGIN_NAME)))
    jet_rt_free(origin, VAULT_ORIGIN_BYTES, I64{8})
}
vault_origin_equal: fn(left: I64, right: I64) -> Bool {
    if (left == I64{0} || right == I64{0}) -> return left == right
    rt_text_equal_bytes(wrapping(left + VAULT_ORIGIN_UUID), wrapping(right + VAULT_ORIGIN_UUID), I64{16}) &&
        jet_rt_string_eq(rt_text_word(wrapping(left + VAULT_ORIGIN_NAME)), rt_text_word(wrapping(right + VAULT_ORIGIN_NAME))) &&
        rt_text_word(wrapping(left + VAULT_ORIGIN_GENERATION)) == rt_text_word(wrapping(right + VAULT_ORIGIN_GENERATION)) &&
        rt_text_equal_bytes(wrapping(left + VAULT_ORIGIN_OPAQUE), wrapping(right + VAULT_ORIGIN_OPAQUE), I64{16}) &&
        rt_text_equal_bytes(wrapping(left + VAULT_ORIGIN_HASH), wrapping(right + VAULT_ORIGIN_HASH), I64{32})
}
// Allocates a fully initialized owner and adopts its sole Secret. Persistence
// commits set the immutable identity/time/hash fields before encoding it.
vault_record_allocate_owned: fn(name: I64, key_type: I64, generation: I64, status: I64, provenance: I64, secret: I64) -> I64 {
    result: jet_rt_alloc(VAULT_RECORD_BYTES, I64{8})
    thread_zero(result, VAULT_RECORD_BYTES)
    rt_text_store(wrapping(result + VAULT_RECORD_NAME), name)
    rt_text_store(wrapping(result + VAULT_RECORD_TYPE), key_type)
    rt_text_store(wrapping(result + VAULT_RECORD_GENERATION), generation)
    rt_text_store(wrapping(result + VAULT_RECORD_STATUS), status)
    rt_text_store(wrapping(result + VAULT_RECORD_PROVENANCE), provenance)
    rt_text_store(wrapping(result + VAULT_RECORD_SECRET), secret)
    result
}
vault_record_allocate: fn(name: I64, key_type: I64, generation: I64, status: I64, provenance: I64, secret: I64) -> I64 {
    vault_record_allocate_owned(jet_rt_string_clone(name), key_type, generation, status, provenance, secret)
}
vault_record_clone: fn(record: I64) -> I64 {
    result: jet_rt_alloc(VAULT_RECORD_BYTES, I64{8})
    rt_text_bytes_copy(result, record, VAULT_RECORD_BYTES)
    rt_text_store(wrapping(result + VAULT_RECORD_NAME), jet_rt_string_clone(rt_text_word(wrapping(record + VAULT_RECORD_NAME))))
    rt_text_store(wrapping(result + VAULT_RECORD_ORIGIN), vault_origin_clone(rt_text_word(wrapping(record + VAULT_RECORD_ORIGIN))))
    bytes: data_sequence_clone(jet_rt_secret_bytes(rt_text_word(wrapping(record + VAULT_RECORD_SECRET))), DYN_BYTE_LIST)
    rt_text_store(wrapping(result + VAULT_RECORD_SECRET), jet_rt_secret_from_bytes(bytes))
    // Secret adopts the buffer and clears, but does not free, the donor shell.
    jet_rt_free(bytes, DATA_SEQUENCE_BYTES, I64{8})
    result
}
vault_record_drop: fn(record: I64) {
    if (record == I64{0}) -> return
    jet_rt_string_drop(rt_text_word(wrapping(record + VAULT_RECORD_NAME)))
    vault_origin_drop(rt_text_word(wrapping(record + VAULT_RECORD_ORIGIN)))
    jet_rt_secret_drop(rt_text_word(wrapping(record + VAULT_RECORD_SECRET)))
    jet_rt_free(record, VAULT_RECORD_BYTES, I64{8})
}
// Rust derive compares key bytes too; immutable hashes never replace equality.
vault_record_equal: fn(left: I64, right: I64) -> Bool {
    if !jet_rt_string_eq(rt_text_word(wrapping(left + VAULT_RECORD_NAME)), rt_text_word(wrapping(right + VAULT_RECORD_NAME))) -> return false
    at := VAULT_RECORD_TYPE
    loop at < VAULT_RECORD_ORIGIN {
        if rt_text_word(wrapping(left + at)) != rt_text_word(wrapping(right + at)) -> return false
        at += I64{8}
    }
    if !vault_origin_equal(rt_text_word(wrapping(left + VAULT_RECORD_ORIGIN)), rt_text_word(wrapping(right + VAULT_RECORD_ORIGIN))) -> return false
    a: jet_rt_secret_bytes(rt_text_word(wrapping(left + VAULT_RECORD_SECRET)))
    b: jet_rt_secret_bytes(rt_text_word(wrapping(right + VAULT_RECORD_SECRET)))
    count: rt_text_word(wrapping(a + DATA_SEQUENCE_LENGTH))
    if count != rt_text_word(wrapping(b + DATA_SEQUENCE_LENGTH)) -> return false
    ad: rt_text_word(wrapping(a + DATA_SEQUENCE_DATA))
    bd: rt_text_word(wrapping(b + DATA_SEQUENCE_DATA))
    at = I64{0}
    loop at < count {
        if host_u8_get(ad, at) != host_u8_get(bd, at) -> return false
        at += I64{1}
    }
    true
}
vault_store_new: fn(uuid: I64) -> I64 {
    result: jet_rt_alloc(VAULT_STORE_BYTES, I64{8})
    rt_text_bytes_copy(wrapping(result + VAULT_STORE_UUID), uuid, I64{16})
    rt_text_store(wrapping(result + VAULT_STORE_REVISION), I64{0})
    rt_text_store(wrapping(result + VAULT_STORE_STRINGS), data_sequence_new(I64{0}, VAULT_PAIR_BYTES))
    rt_text_store(wrapping(result + VAULT_STORE_RECORDS), data_sequence_new(I64{0}, DYN_ELEMENT_BYTES))
    result
}
vault_records_drop: fn(records: I64) {
    if (records == I64{0}) -> return
    count: rt_text_word(wrapping(records + DATA_SEQUENCE_LENGTH))
    data: rt_text_word(wrapping(records + DATA_SEQUENCE_DATA))
    at := I64{0}
    loop at < count {
        vault_record_drop(rt_text_word(wrapping(data + at * DYN_ELEMENT_BYTES)))
        at += I64{1}
    }
    capacity: rt_text_word(wrapping(records + DATA_SEQUENCE_CAPACITY))
    if (capacity != I64{0}) -> jet_rt_free(data, capacity * DYN_ELEMENT_BYTES, I64{8})
    jet_rt_free(records, DATA_SEQUENCE_BYTES, I64{8})
}
vault_store_drop: fn(store: I64) {
    if (store == I64{0}) -> return
    vault_pairs_drop(rt_text_word(wrapping(store + VAULT_STORE_STRINGS)))
    vault_records_drop(rt_text_word(wrapping(store + VAULT_STORE_RECORDS)))
    jet_rt_free(store, VAULT_STORE_BYTES, I64{8})
}
vault_store_equal: fn(left: I64, right: I64) -> Bool {
    if !rt_text_equal_bytes(wrapping(left + VAULT_STORE_UUID), wrapping(right + VAULT_STORE_UUID), I64{16}) -> return false
    if rt_text_word(wrapping(left + VAULT_STORE_REVISION)) != rt_text_word(wrapping(right + VAULT_STORE_REVISION)) -> return false
    ap: rt_text_word(wrapping(left + VAULT_STORE_STRINGS))
    bp: rt_text_word(wrapping(right + VAULT_STORE_STRINGS))
    count: rt_text_word(wrapping(ap + DATA_SEQUENCE_LENGTH))
    if count != rt_text_word(wrapping(bp + DATA_SEQUENCE_LENGTH)) -> return false
    ad: rt_text_word(wrapping(ap + DATA_SEQUENCE_DATA))
    bd: rt_text_word(wrapping(bp + DATA_SEQUENCE_DATA))
    at := I64{0}
    loop at < count {
        if !jet_rt_string_eq(rt_text_word(wrapping(ad + at * VAULT_PAIR_BYTES)), rt_text_word(wrapping(bd + at * VAULT_PAIR_BYTES))) -> return false
        if !jet_rt_string_eq(rt_text_word(wrapping(wrapping(ad + at * VAULT_PAIR_BYTES) + I64{8})), rt_text_word(wrapping(wrapping(bd + at * VAULT_PAIR_BYTES) + I64{8}))) -> return false
        at += I64{1}
    }
    ar: rt_text_word(wrapping(left + VAULT_STORE_RECORDS))
    br: rt_text_word(wrapping(right + VAULT_STORE_RECORDS))
    count_records: rt_text_word(wrapping(ar + DATA_SEQUENCE_LENGTH))
    if count_records != rt_text_word(wrapping(br + DATA_SEQUENCE_LENGTH)) -> return false
    ar_data: rt_text_word(wrapping(ar + DATA_SEQUENCE_DATA))
    br_data: rt_text_word(wrapping(br + DATA_SEQUENCE_DATA))
    at = I64{0}
    loop at < count_records {
        if !vault_record_equal(rt_text_word(wrapping(ar_data + at * DYN_ELEMENT_BYTES)), rt_text_word(wrapping(br_data + at * DYN_ELEMENT_BYTES))) -> return false
        at += I64{1}
    }
    true
}
// Unsigned decimal without an exact Int, temporary string, or digit allocation.
// q=floor((word unsigned)/10); recursion has at most20 fixed-width frames.
vault_push_u64: fn(target: I64, value: I64) {
    half: (value >> I64{1}).bit_and(I64{9223372036854775807})
    quotient: half / I64{5}
    remainder: (half % I64{5}) * I64{2} + (value.bit_and(I64{1}))
    if (quotient != I64{0}) -> vault_push_u64(target, quotient)
    rt_text_push_word(target, I64{48} + remainder, I64{1})
}
vault_debug_bytes: fn(target: I64, bytes: I64, length: I64) {
    rt_text_push_word(target, I64{91}, I64{1})
    at := I64{0}
    loop at < length {
        if (at != I64{0}) -> rt_text_push_word(target, I64{8236}, I64{2}) // ", "
        vault_push_u64(target, rt_text_byte(wrapping(bytes + at)))
        at += I64{1}
    }
    rt_text_push_word(target, I64{93}, I64{1})
}
vault_origin_debug: fn(target: I64, origin: I64) {
    // "JetVaultOrigin { repo_uuid: "
    jet_rt_string_builder_push(target, rt_static_text("JetVaultOrigin {{ repo_uuid: "))
    vault_debug_bytes(target, wrapping(origin + VAULT_ORIGIN_UUID), I64{16})
    rt_text_push_word(target, I64{2322280078323359788}, I64{8}) // ", name: "
    rt_text_push_rust_debug_str(target, rt_text_word(wrapping(origin + VAULT_ORIGIN_NAME)))
    // ", generation: "
    rt_text_push_word(target, I64{7021786293846089772}, I64{8})
    rt_text_push_word(target, I64{35435332987252}, I64{6})
    vault_push_u64(target, rt_text_word(wrapping(origin + VAULT_ORIGIN_GENERATION)))
    // ", opaque_id: "
    rt_text_push_word(target, I64{7310874233417965612}, I64{8})
    rt_text_push_word(target, I64{138418612575}, I64{5})
    vault_debug_bytes(target, wrapping(origin + VAULT_ORIGIN_OPAQUE), I64{16})
    // ", record_hash: "
    rt_text_push_word(target, I64{7237970023832231980}, I64{8})
    rt_text_push_word(target, I64{9071419541514335}, I64{7})
    vault_debug_bytes(target, wrapping(origin + VAULT_ORIGIN_HASH), I64{32})
    rt_text_push_word(target, I64{32032}, I64{2}) // " }"
}
vault_record_debug: fn(record: I64) -> I64 {
    target: jet_rt_string_builder_new()
    // "VaultRecord { name: "
    jet_rt_string_builder_push(target, rt_static_text("VaultRecord {{ name: "))
    rt_text_push_rust_debug_str(target, rt_text_word(wrapping(record + VAULT_RECORD_NAME)))
    // ", key_type: "
    rt_text_push_word(target, I64{8751724950884917292}, I64{8})
    rt_text_push_word(target, I64{540697968}, I64{4})
    vault_push_u64(target, rt_text_word(wrapping(record + VAULT_RECORD_TYPE)))
    // ", generation: "
    rt_text_push_word(target, I64{7021786293846089772}, I64{8})
    rt_text_push_word(target, I64{35435332987252}, I64{6})
    vault_push_u64(target, rt_text_word(wrapping(record + VAULT_RECORD_GENERATION)))
    // ", status: "
    rt_text_push_word(target, I64{8319683848551211052}, I64{8})
    rt_text_push_word(target, I64{8250}, I64{2})
    status: rt_text_word(wrapping(record + VAULT_RECORD_STATUS))
    if {
        (status == I64{1}) -> rt_text_push_word(target, I64{111559249781569}, I64{6}) // "Active"
        (status == I64{2}) -> rt_text_push_word(target, I64{28259039740978514}, I64{7}) // "Retired"
        (status == I64{3}) -> rt_text_push_word(target, I64{28259009777001810}, I64{7}) // "Revoked"
        else -> panic("record variant index out of range")
    }
    // ", provenance: "
    rt_text_push_word(target, I64{7954894537853247532}, I64{8})
    rt_text_push_word(target, I64{35435181207137}, I64{6})
    provenance: rt_text_word(wrapping(record + VAULT_RECORD_PROVENANCE))
    if (provenance == I64{1}) {
        rt_text_push_word(target, I64{7310575239085057351}, I64{8}) // "Generate"
        rt_text_push_word(target, I64{100}, I64{1}) // "d"
    } else if (provenance == I64{2}) {
        rt_text_push_word(target, I64{7234316411285302601}, I64{8}) // "Imported"
    } else {
        panic("record variant index out of range")
    }
    // ", opaque_id: "
    rt_text_push_word(target, I64{7310874233417965612}, I64{8})
    rt_text_push_word(target, I64{138418612575}, I64{5})
    vault_debug_bytes(target, wrapping(record + VAULT_RECORD_OPAQUE), I64{16})
    // ", created_unix_ms: "
    jet_rt_string_builder_push(target, rt_static_text(", created_unix_ms: "))
    vault_push_u64(target, rt_text_word(wrapping(record + VAULT_RECORD_CREATED)))
    // ", status_unix_ms: "
    jet_rt_string_builder_push(target, rt_static_text(", status_unix_ms: "))
    vault_push_u64(target, rt_text_word(wrapping(record + VAULT_RECORD_STATUS_MS)))
    // ", record_hash: "
    rt_text_push_word(target, I64{7237970023832231980}, I64{8})
    rt_text_push_word(target, I64{9071419541514335}, I64{7})
    vault_debug_bytes(target, wrapping(record + VAULT_RECORD_HASH), I64{32})
    // ", public_key_hash: "
    jet_rt_string_builder_push(target, rt_static_text(", public_key_hash: "))
    vault_debug_bytes(target, wrapping(record + VAULT_RECORD_PUBLIC_HASH), I64{32})
    // ", reason_hash: "
    rt_text_push_word(target, I64{7957705928737955884}, I64{8})
    rt_text_push_word(target, I64{9071419541514335}, I64{7})
    vault_debug_bytes(target, wrapping(record + VAULT_RECORD_REASON_HASH), I64{32})
    rt_text_push_word(target, I64{7956003919315804204}, I64{8}) // ", origin"
    rt_text_push_word(target, I64{8250}, I64{2}) // ": "
    origin: rt_text_word(wrapping(record + VAULT_RECORD_ORIGIN))
    if (origin == I64{0}) { rt_text_push_word(target, I64{1701736270}, I64{4}) } else {
        rt_text_push_word(target, I64{173500362579}, I64{5}) // "Some("
        vault_origin_debug(target, origin)
        rt_text_push_word(target, I64{41}, I64{1})
    }
    // ", key: \"<redacted>\""
    jet_rt_string_builder_push(target, rt_static_text(", key: \"<redacted>\""))
    rt_text_push_word(target, I64{32032}, I64{2})
    jet_rt_string_builder_finish(target)
}

vault_put_u16: fn(target: I64, value: I64) {
    rt_text_put(target, value.bit_and(I64{255}))
    rt_text_put(wrapping(target + I64{1}), (value >> I64{8}).bit_and(I64{255}))
}
// Scratch8192 is exclusive; the output32 must not alias it. Crypto primitives
// consume raw packed key32, never a nominal Rust signing/X25519 carrier.
vault_public_hash_bytes: fn(key_type: I64, key: I64, count: I64, digest: I64, scratch: I64) -> Bool {
    if (count != I64{32}) -> return false
    public: wrapping(scratch + I64{4160})
    if (key_type == I64{1}) {
        rt_crypto_ed25519_public(key, public, scratch)
    } else if (key_type == I64{2}) {
        rt_crypto_x25519_public(key, public, scratch)
    } else { return false }
    domain: wrapping(scratch + I64{4096})
    rt_text_store(domain, I64{8462299100363904586}) // "JVLT2 pu"
    rt_text_store(wrapping(domain + I64{8}), I64{8747515638088035426}) // "blic key"
    rt_text_put(wrapping(domain + I64{16}), key_type)
    rt_sha256_parts(domain, I64{17}, public, I64{32}, digest, scratch)
    thread_zero(scratch, I64{8192})
    true
}
vault_public_hash: fn(key_type: I64, secret: I64, digest: I64, scratch: I64) -> Bool {
    bytes: jet_rt_secret_bytes(secret)
    vault_public_hash_bytes(key_type, rt_text_word(wrapping(bytes + DATA_SEQUENCE_DATA)), rt_text_word(wrapping(bytes + DATA_SEQUENCE_LENGTH)), digest, scratch)
}
// Internal to the immutable-record hash: its digest lives in the same scratch,
// so only the SHA schedule/domain are wiped here. The enclosing call wipes all.
vault_key_digest_bytes: fn(key_type: I64, key: I64, count: I64, digest: I64, scratch: I64) {
    domain: wrapping(scratch + I64{4096})
    rt_text_store(domain, I64{7307970220873504330}) // "JVLT2 ke"
    rt_text_store(wrapping(domain + I64{8}), I64{32481173248811129}) // "y bytes"
    rt_text_put(wrapping(domain + I64{15}), key_type)
    rt_sha256_parts(domain, I64{16}, key, count, digest, scratch)
    rt_text_store(domain, I64{0})
    rt_text_store(wrapping(domain + I64{8}), I64{0})
}
vault_key_digest: fn(record: I64, digest: I64, scratch: I64) {
    bytes: jet_rt_secret_bytes(rt_text_word(wrapping(record + VAULT_RECORD_SECRET)))
    vault_key_digest_bytes(rt_text_word(wrapping(record + VAULT_RECORD_TYPE)), rt_text_word(wrapping(bytes + DATA_SEQUENCE_DATA)), I64{32}, digest, scratch)
}
// Caller has validated the record name <=128/key32. Encoder hashes BEFORE
// validating an optional origin name; that borrowed span is deliberately
// unbounded here. Prefix<=269 plus tail56 use fixed scratch, and parts4 streams
// the origin bytes without a concatenation allocation.
vault_record_hash: fn(record: I64, digest: I64, scratch: I64) {
    key_digest: wrapping(scratch + I64{4192})
    vault_key_digest(record, key_digest, scratch)
    buffer: wrapping(scratch + I64{4352})
    rt_text_store(buffer, I64{7883868023223506506}) // "JVLT2 im"
    rt_text_store(wrapping(buffer + I64{8}), I64{2334391151659087213}) // "mutable "
    rt_text_store(wrapping(buffer + I64{16}), I64{110442657834354}) // "record"
    cursor := I64{22}
    rt_text_put(wrapping(buffer + cursor), rt_text_word(wrapping(record + VAULT_RECORD_TYPE)))
    rt_text_put(wrapping(wrapping(buffer + cursor) + I64{1}), rt_text_word(wrapping(record + VAULT_RECORD_PROVENANCE)))
    cursor += I64{2}
    name: rt_text_word(wrapping(record + VAULT_RECORD_NAME))
    name_length: rt_text_len(name)
    vault_put_u16(wrapping(buffer + cursor), name_length)
    cursor += I64{2}
    rt_text_bytes_copy(wrapping(buffer + cursor), rt_text_data(name), name_length)
    cursor += name_length
    vault_put_u64(wrapping(buffer + cursor), rt_text_word(wrapping(record + VAULT_RECORD_GENERATION)))
    cursor += I64{8}
    rt_text_bytes_copy(wrapping(buffer + cursor), wrapping(record + VAULT_RECORD_OPAQUE), I64{16})
    cursor += I64{16}
    vault_put_u64(wrapping(buffer + cursor), rt_text_word(wrapping(record + VAULT_RECORD_CREATED)))
    cursor += I64{8}
    rt_text_bytes_copy(wrapping(buffer + cursor), wrapping(record + VAULT_RECORD_PUBLIC_HASH), I64{32})
    cursor += I64{32}
    rt_text_bytes_copy(wrapping(buffer + cursor), key_digest, I64{32})
    cursor += I64{32}
    origin: rt_text_word(wrapping(record + VAULT_RECORD_ORIGIN))
    if (origin == I64{0}) {
        end: cursor + I64{75}
        loop cursor < end {
            rt_text_put(wrapping(buffer + cursor), I64{0})
            cursor += I64{1}
        }
        rt_sha256_parts(buffer, cursor, I64{1}, I64{0}, digest, scratch)
        thread_zero(scratch, I64{8192})
        return
    }
    rt_text_put(wrapping(buffer + cursor), I64{1})
    cursor += I64{1}
    rt_text_bytes_copy(wrapping(buffer + cursor), wrapping(origin + VAULT_ORIGIN_UUID), I64{16})
    cursor += I64{16}
    origin_name: rt_text_word(wrapping(origin + VAULT_ORIGIN_NAME))
    origin_length: rt_text_len(origin_name)
    vault_put_u16(wrapping(buffer + cursor), origin_length.bit_and(I64{65535}))
    cursor += I64{2}
    tail: wrapping(scratch + I64{4800})
    vault_put_u64(tail, rt_text_word(wrapping(origin + VAULT_ORIGIN_GENERATION)))
    rt_text_bytes_copy(wrapping(tail + I64{8}), wrapping(origin + VAULT_ORIGIN_OPAQUE), I64{16})
    rt_text_bytes_copy(wrapping(tail + I64{24}), wrapping(origin + VAULT_ORIGIN_HASH), I64{32})
    rt_sha256_parts4(buffer, cursor, rt_text_data(origin_name), origin_length, tail, I64{56}, I64{1}, I64{0}, digest, scratch)
    thread_zero(scratch, I64{8192})
}

// -1 success, else private error ordinal; scratch8256 is caller-owned.
// Encode955-991 hashes before optional origin-name validation. Decode1175-1187
// validates lifecycle/public material before deriving its missing record hash;
// its origin was already validated by the wire parser.
vault_record_validate: fn(record: I64, decoded: Bool, scratch: I64) -> I64 {
    status: rt_text_word(wrapping(record + VAULT_RECORD_STATUS))
    created: rt_text_word(wrapping(record + VAULT_RECORD_CREATED))
    changed: rt_text_word(wrapping(record + VAULT_RECORD_STATUS_MS))
    if (decoded && (created == I64{0} || vault_unsigned_less(changed, created))) -> return I64{8}
    key_type: rt_text_word(wrapping(record + VAULT_RECORD_TYPE))
    secret: rt_text_word(wrapping(record + VAULT_RECORD_SECRET))
    if !vault_public_hash(key_type, secret, wrapping(scratch + I64{8192}), scratch) -> return I64{8}
    if !rt_text_equal_bytes(wrapping(scratch + I64{8192}), wrapping(record + VAULT_RECORD_PUBLIC_HASH), I64{32}) -> return I64{8}
    if !decoded {
        vault_record_hash(record, wrapping(scratch + I64{8224}), scratch)
        if !rt_text_equal_bytes(wrapping(scratch + I64{8224}), wrapping(record + VAULT_RECORD_HASH), I64{32}) -> return I64{8}
    }
    reason_zero: vault_bytes_zero(wrapping(record + VAULT_RECORD_REASON_HASH), I64{32})
    if (status == I64{1} && (changed != created || !reason_zero)) -> return I64{8}
    // Do not impose the decoder's inactive-reason/timestamp rules on encode.
    if (decoded && status != I64{1} && reason_zero) -> return I64{8}
    origin: rt_text_word(wrapping(record + VAULT_RECORD_ORIGIN))
    if (!decoded && origin != I64{0}) {
        if (rt_text_word(wrapping(record + VAULT_RECORD_PROVENANCE)) != I64{2} ||
            vault_bytes_zero(wrapping(origin + VAULT_ORIGIN_UUID), I64{16}) ||
            vault_bytes_zero(wrapping(origin + VAULT_ORIGIN_OPAQUE), I64{16}) ||
            vault_bytes_zero(wrapping(origin + VAULT_ORIGIN_HASH), I64{32}) ||
            rt_text_word(wrapping(origin + VAULT_ORIGIN_GENERATION)) == I64{0}) -> return I64{8}
        if !vault_validate_text(rt_text_word(wrapping(origin + VAULT_ORIGIN_NAME)), false) -> return I64{0}
    }
    if decoded {
        vault_record_hash(record, wrapping(scratch + I64{8224}), scratch)
        rt_text_bytes_copy(wrapping(record + VAULT_RECORD_HASH), wrapping(scratch + I64{8224}), I64{32})
    }
    I64{-1}
}

// Canonicalizes owned pair slots by moving owners, never cloning them.
// Duplicate detection precedes ANY name/value validation. On failure pairs
// retain their original ordering and out is unchanged.
vault_canonical_pairs: fn(pairs: I64, out: I64) -> I64 {
    count: rt_text_word(wrapping(pairs + DATA_SEQUENCE_LENGTH))
    if (count > VAULT_MAX_STRINGS) -> return vault_error_new(I64{8}, I64{0}, I64{0})
    data: rt_text_word(wrapping(pairs + DATA_SEQUENCE_DATA))
    index_bytes: count * DYN_ELEMENT_BYTES * I64{2}
    indices: if (index_bytes == I64{0}) -> I64{8} else -> jet_rt_alloc(index_bytes, I64{8})
    second: indices + index_bytes /% I64{2}
    sorted: vault_sorted_indices(data, count, false, indices, second)
    at := I64{1}
    loop at < count {
        previous: rt_text_word(rt_text_word(wrapping(sorted + (at - I64{1}) * DYN_ELEMENT_BYTES)))
        name: rt_text_word(rt_text_word(wrapping(sorted + at * DYN_ELEMENT_BYTES)))
        if jet_rt_string_eq(previous, name) {
            if (index_bytes != I64{0}) -> jet_rt_free(indices, index_bytes, I64{8})
            return vault_error_new(I64{8}, I64{0}, I64{0})
        }
        at += I64{1}
    }
    length := I64{4}
    at = I64{0}
    loop at < count {
        pair: rt_text_word(wrapping(sorted + at * DYN_ELEMENT_BYTES))
        name: rt_text_word(pair)
        value: rt_text_word(wrapping(pair + I64{8}))
        if !vault_validate_text(name, false) {
            if (index_bytes != I64{0}) -> jet_rt_free(indices, index_bytes, I64{8})
            return vault_error_new(I64{0}, I64{0}, I64{0})
        }
        if (rt_text_len(value) > I64{1048576}) {
            if (index_bytes != I64{0}) -> jet_rt_free(indices, index_bytes, I64{8})
            return vault_error_new(I64{8}, I64{0}, I64{0})
        }
        length += I64{6} + rt_text_len(name) + rt_text_len(value)
        at += I64{1}
    }
    canonical: data_sequence_new(length, RT_HOST_U8_STRIDE)
    encoded: rt_text_word(wrapping(canonical + DATA_SEQUENCE_DATA))
    vault_put_u32(encoded, count)
    cursor := I64{4}
    at = I64{0}
    loop at < count {
        pair: rt_text_word(wrapping(sorted + at * DYN_ELEMENT_BYTES))
        name: rt_text_word(pair)
        value: rt_text_word(wrapping(pair + I64{8}))
        name_length: rt_text_len(name)
        value_length: rt_text_len(value)
        vault_put_u16(wrapping(encoded + cursor), name_length)
        cursor += I64{2}
        rt_text_bytes_copy(wrapping(encoded + cursor), rt_text_data(name), name_length)
        cursor += name_length
        vault_put_u32(wrapping(encoded + cursor), value_length)
        cursor += I64{4}
        rt_text_bytes_copy(wrapping(encoded + cursor), rt_text_data(value), value_length)
        cursor += value_length
        at += I64{1}
    }
    visited: if sorted == indices -> second else -> indices
    if (count != I64{0}) -> thread_zero(visited, count * DYN_ELEMENT_BYTES)
    first := I64{0}
    loop first < count {
        if (rt_text_word(wrapping(visited + first * DYN_ELEMENT_BYTES)) == I64{0}) {
            source_first: (rt_text_word(wrapping(sorted + first * DYN_ELEMENT_BYTES)) - data) /% VAULT_PAIR_BYTES
            if source_first == first {
                rt_text_store(wrapping(visited + first * DYN_ELEMENT_BYTES), I64{1})
                first += I64{1}
                next
            }
            saved_name: rt_text_word(wrapping(data + first * VAULT_PAIR_BYTES))
            saved_value: rt_text_word(wrapping(wrapping(data + first * VAULT_PAIR_BYTES) + I64{8}))
            destination := first
            loop {
                rt_text_store(wrapping(visited + destination * DYN_ELEMENT_BYTES), I64{1})
                source: (rt_text_word(wrapping(sorted + destination * DYN_ELEMENT_BYTES)) - data) /% VAULT_PAIR_BYTES
                target: wrapping(data + destination * VAULT_PAIR_BYTES)
                if source == first {
                    rt_text_store(target, saved_name)
                    rt_text_store(wrapping(target + I64{8}), saved_value)
                    break
                }
                rt_text_store(target, rt_text_word(wrapping(data + source * VAULT_PAIR_BYTES)))
                rt_text_store(wrapping(target + I64{8}), rt_text_word(wrapping(wrapping(data + source * VAULT_PAIR_BYTES) + I64{8})))
                destination = source
            }
        }
        first += I64{1}
    }
    if (index_bytes != I64{0}) -> jet_rt_free(indices, index_bytes, I64{8})
    rt_text_store(wrapping(canonical + DATA_SEQUENCE_LENGTH), length)
    rt_text_store(out, canonical)
    I64{0}
}
VAULT_START_ABSENT: I64{0}
VAULT_START_HISTORICAL: I64{1}
VAULT_START_V2: I64{2}
// Scratch608 = SHA576 + disjoint domain32. Digest32 is caller-owned/disjoint.
vault_start_hash: fn(kind: I64, bytes: I64, length: I64, out: I64, scratch: I64) {
    domain: wrapping(scratch + I64{576})
    if (kind == VAULT_START_ABSENT) {
        rt_text_store(domain, I64{7088982680402679370})
        rt_text_store(wrapping(domain + I64{8}), I64{8031170618737976691})
        rt_text_store(wrapping(domain + I64{16}), I64{25970})
        rt_sha256_parts(domain, I64{18}, I64{1}, I64{0}, out, scratch)
    } else {
        rt_text_store(domain, if (kind == VAULT_START_HISTORICAL) -> I64{8391085926961141322} else -> I64{8391085931256108618})
        rt_text_store(wrapping(domain + I64{8}), I64{8295744237529756257})
        rt_text_store(wrapping(domain + I64{16}), I64{1701998452})
        rt_sha256_parts(domain, I64{20}, bytes, length, out, scratch)
    }
}
// The caller retains the Zeroizing plaintext owner. Outputs adopt one complete
// store/hash/kind only after every check succeeds.
vault_decode_plaintext: fn(plaintext: I64, store_out: I64, hash_out: I64, kind_out: I64) -> I64 {
    bytes: rt_text_word(wrapping(plaintext + DATA_SEQUENCE_DATA))
    length: rt_text_word(wrapping(plaintext + DATA_SEQUENCE_LENGTH))
    scratch: jet_rt_alloc(I64{624}, I64{8})
    store_slot: wrapping(scratch + I64{608})
    encoded_slot: wrapping(scratch + I64{616})
    typed: length >= I64{4} && rt_text_byte(bytes) == I64{74} && rt_text_byte(wrapping(bytes + I64{1})) == I64{86} &&
        rt_text_byte(wrapping(bytes + I64{2})) == I64{76} && rt_text_byte(wrapping(bytes + I64{3})) == I64{84}
    if typed {
        status: vault_decode_v2(bytes, length, store_slot)
        if (status != I64{-1}) {
            jet_rt_free(scratch, I64{624}, I64{8})
            return vault_error_new(status, I64{0}, I64{0})
        }
        store: rt_text_word(store_slot)
        encoded_status: vault_encode_v2(store, encoded_slot)
        if (encoded_status != I64{-1}) {
            vault_store_drop(store)
            jet_rt_free(scratch, I64{624}, I64{8})
            return vault_error_new(encoded_status, I64{0}, I64{0})
        }
        encoded: rt_text_word(encoded_slot)
        identical: rt_text_len(encoded) == length && rt_text_equal_bytes(rt_text_data(encoded), bytes, length)
        vault_text_zero(encoded)
        jet_rt_string_drop(encoded)
        if !identical {
            vault_store_drop(store)
            jet_rt_free(scratch, I64{624}, I64{8})
            return vault_error_new(I64{8}, I64{0}, I64{0})
        }
        vault_start_hash(VAULT_START_V2, bytes, length, hash_out, scratch)
        rt_text_store(store_out, store)
        rt_text_store(kind_out, VAULT_START_V2)
    } else {
        pairs: vault_decode_pairs(bytes, length)
        if (pairs == I64{0}) {
            jet_rt_free(scratch, I64{624}, I64{8})
            return vault_error_new(I64{8}, I64{0}, I64{0})
        }
        error: vault_canonical_pairs(pairs, encoded_slot)
        if (error != I64{0}) {
            vault_pairs_drop(pairs)
            jet_rt_free(scratch, I64{624}, I64{8})
            return error
        }
        canonical: rt_text_word(encoded_slot)
        thread_zero(scratch, I64{16})
        store: vault_store_new(scratch)
        vault_pairs_drop(rt_text_word(wrapping(store + VAULT_STORE_STRINGS)))
        rt_text_store(wrapping(store + VAULT_STORE_STRINGS), pairs)
        vault_start_hash(VAULT_START_HISTORICAL, rt_text_word(wrapping(canonical + DATA_SEQUENCE_DATA)), rt_text_word(wrapping(canonical + DATA_SEQUENCE_LENGTH)), hash_out, scratch)
        thread_zero(rt_text_word(wrapping(canonical + DATA_SEQUENCE_DATA)), rt_text_word(wrapping(canonical + DATA_SEQUENCE_CAPACITY)))
        data_sequence_drop(canonical, DYN_BYTE_LIST)
        rt_text_store(store_out, store)
        rt_text_store(kind_out, VAULT_START_HISTORICAL)
    }
    thread_zero(scratch, I64{624})
    jet_rt_free(scratch, I64{624}, I64{8})
    I64{0}
}
// Identity and plaintext bytes are real owned sequences; a borrowed E4 view
// passes identity text without a second copy.
vault_decode_ciphertext_at_root: fn(root: I64, ciphertext: I64, store_out: I64, hash_out: I64, kind_out: I64) -> I64 {
    scratch: jet_rt_alloc(I64{40}, I64{8})
    error: vault_identity_read_at_root(root, scratch)
    if (error != I64{0}) {
        jet_rt_free(scratch, I64{40}, I64{8})
        return error
    }
    identity: rt_text_word(scratch)
    view: wrapping(scratch + I64{16})
    rt_text_store(view, rt_text_word(wrapping(identity + DATA_SEQUENCE_DATA)))
    rt_text_store(wrapping(view + I64{8}), rt_text_word(wrapping(identity + DATA_SEQUENCE_LENGTH)))
    rt_text_store(wrapping(view + I64{16}), I64{0})
    opened: vault_crypto_decrypt(view, ciphertext, wrapping(scratch + I64{8}))
    thread_zero(rt_text_word(wrapping(identity + DATA_SEQUENCE_DATA)), rt_text_word(wrapping(identity + DATA_SEQUENCE_CAPACITY)))
    data_sequence_drop(identity, DYN_BYTE_LIST)
    if (opened != I64{0}) {
        jet_rt_free(scratch, I64{40}, I64{8})
        return opened
    }
    plaintext: rt_text_word(wrapping(scratch + I64{8}))
    decoded: vault_decode_plaintext(plaintext, store_out, hash_out, kind_out)
    thread_zero(rt_text_word(wrapping(plaintext + DATA_SEQUENCE_DATA)), rt_text_word(wrapping(plaintext + DATA_SEQUENCE_CAPACITY)))
    data_sequence_drop(plaintext, DYN_BYTE_LIST)
    jet_rt_free(scratch, I64{40}, I64{8})
    decoded
}
// No recipients or identity read on absence. Recovery is deliberately NOT
// hidden here: the seed's recovered caller must explicitly run its lock-aware
// recovery before entering this unrecovered path.
vault_read_contents_unrecovered_at_root: fn(root: I64, store_out: I64, hash_out: I64, kind_out: I64) -> I64 {
    scratch: jet_rt_alloc(I64{640}, I64{8})
    name: wrapping(scratch + I64{576})
    rt_text_store(name, I64{3347146927126046067})
    rt_text_store(wrapping(name + I64{8}), I64{6645601})
    view: wrapping(scratch + I64{608})
    rt_text_store(view, name)
    rt_text_store(wrapping(view + I64{8}), I64{11})
    rt_text_store(wrapping(view + I64{16}), I64{0})
    slot: wrapping(scratch + I64{632})
    error: vault_linux_read_at_root(root, view, slot)
    if (error != I64{0}) {
        jet_rt_free(scratch, I64{640}, I64{8})
        return error
    }
    ciphertext: rt_text_word(slot)
    if (ciphertext == I64{0}) {
        thread_zero(scratch, I64{16})
        store: vault_store_new(scratch)
        vault_start_hash(VAULT_START_ABSENT, I64{1}, I64{0}, hash_out, scratch)
        rt_text_store(store_out, store)
        rt_text_store(kind_out, VAULT_START_ABSENT)
        thread_zero(scratch, I64{640})
        jet_rt_free(scratch, I64{640}, I64{8})
        return I64{0}
    }
    result: vault_decode_ciphertext_at_root(root, ciphertext, store_out, hash_out, kind_out)
    data_sequence_drop(ciphertext, DYN_BYTE_LIST)
    thread_zero(scratch, I64{640})
    jet_rt_free(scratch, I64{640}, I64{8})
    result
}

// Recovery errors propagate before any read output is written; callers needing
// a lock-held snapshot use the unrecovered path.
vault_read_contents_at_root: fn(root: I64, store_out: I64, hash_out: I64, kind_out: I64) -> I64 {
    error: vault_recover_backup_at_root(root)
    if (error != I64{0}) -> return error
    vault_read_contents_unrecovered_at_root(root, store_out, hash_out, kind_out)
}

// Provider policy stays in the shared recipient decoder. Adopt a snapshot only
// after both store and provider are available.
vault_read_at_root: fn(root: I64, store_out: I64, hash_out: I64, provider_out: I64, kind_out: I64) -> I64 {
    scratch: jet_rt_alloc(I64{88}, I64{8})
    error: vault_read_contents_at_root(root, scratch, wrapping(scratch + I64{8}), wrapping(scratch + I64{72}))
    if (error != I64{0}) {
        thread_zero(scratch, I64{88})
        jet_rt_free(scratch, I64{88}, I64{8})
        return error
    }
    provider_error: vault_recipients_at_root(root, wrapping(scratch + I64{80}), wrapping(scratch + I64{40}))
    store: rt_text_word(scratch)
    if (provider_error != I64{0}) {
        vault_store_drop(store)
        thread_zero(scratch, I64{88})
        jet_rt_free(scratch, I64{88}, I64{8})
        return provider_error
    }
    data_sequence_drop(rt_text_word(wrapping(scratch + I64{80})), DYN_BYTE_LIST)
    rt_text_store(store_out, store)
    rt_text_bytes_copy(hash_out, wrapping(scratch + I64{8}), I64{32})
    rt_text_bytes_copy(provider_out, wrapping(scratch + I64{40}), I64{32})
    rt_text_store(kind_out, rt_text_word(wrapping(scratch + I64{72})))
    thread_zero(scratch, I64{88})
    jet_rt_free(scratch, I64{88}, I64{8})
    I64{0}
}

// SystemTime::duration_since(UNIX_EPOCH).as_millis, checked as u64.
// out borrows8, scratch borrows16; preserve out on pre-epoch/syscall/overflow.
vault_wall_unix_ms: fn(out: I64, scratch: I64) -> Bool {
    if (trap_syscall(I64{228}, I64{0}, scratch, I64{0}, I64{0}, I64{0}, I64{0}) != I64{0}) -> return false
    seconds: rt_text_word(scratch)
    fraction: rt_text_word(wrapping(scratch + I64{8})) /% I64{1000000}
    if (seconds < I64{0} || seconds > I64{18446744073709551} || (seconds == I64{18446744073709551} && fraction > I64{615})) -> return false
    rt_text_store(out, wrapping(seconds * I64{1000} + fraction))
    true
}
// Fold EVERY record, not only the active generation.
vault_lifecycle_unix_ms: fn(store: I64, out: I64) -> I64 {
    scratch: jet_rt_alloc(I64{80}, I64{8})
    rollback: vault_writer_fault(I64{8030531024808012899}, I64{118074579774572}, I64{0}, I64{0}, I64{14}, scratch)
    if rollback {
        rt_text_store(wrapping(scratch + I64{64}), I64{1})
    } else if !vault_wall_unix_ms(wrapping(scratch + I64{64}), scratch) {
        thread_zero(scratch, I64{80})
        jet_rt_free(scratch, I64{80}, I64{8})
        return vault_error_new(I64{7}, I64{0}, I64{0})
    }
    latest := rt_text_word(wrapping(scratch + I64{64}))
    records: rt_text_word(wrapping(store + VAULT_STORE_RECORDS))
    count: rt_text_word(wrapping(records + DATA_SEQUENCE_LENGTH))
    data: rt_text_word(wrapping(records + DATA_SEQUENCE_DATA))
    at := I64{0}
    loop at < count {
        record: rt_text_word(wrapping(data + at * DYN_ELEMENT_BYTES))
        created: rt_text_word(wrapping(record + VAULT_RECORD_CREATED))
        status: rt_text_word(wrapping(record + VAULT_RECORD_STATUS_MS))
        if vault_unsigned_less(latest, created) -> latest = created
        if vault_unsigned_less(latest, status) -> latest = status
        at += I64{1}
    }
    rt_text_store(out, latest)
    thread_zero(scratch, I64{80})
    jet_rt_free(scratch, I64{80}, I64{8})
    I64{0}
}
// Decode and take, never clone the typed strings.
vault_strings_from_plaintext: fn(plaintext: I64, out: I64) -> I64 {
    bytes: rt_text_word(wrapping(plaintext + DATA_SEQUENCE_DATA))
    length: rt_text_word(wrapping(plaintext + DATA_SEQUENCE_LENGTH))
    scratch: jet_rt_alloc(I64{8}, I64{8})
    typed: length >= I64{4} && rt_text_byte(bytes) == I64{74} && rt_text_byte(wrapping(bytes + I64{1})) == I64{86} &&
        rt_text_byte(wrapping(bytes + I64{2})) == I64{76} && rt_text_byte(wrapping(bytes + I64{3})) == I64{84}
    if typed {
        status: vault_decode_v2(bytes, length, scratch)
        if (status != I64{-1}) {
            jet_rt_free(scratch, I64{8}, I64{8})
            return vault_error_new(status, I64{0}, I64{0})
        }
        store: rt_text_word(scratch)
        pairs: rt_text_word(wrapping(store + VAULT_STORE_STRINGS))
        rt_text_store(wrapping(store + VAULT_STORE_STRINGS), I64{0})
        vault_store_drop(store)
        rt_text_store(out, pairs)
    } else {
        pairs: vault_decode_pairs(bytes, length)
        if (pairs == I64{0}) {
            jet_rt_free(scratch, I64{8}, I64{8})
            return vault_error_new(I64{8}, I64{0}, I64{0})
        }
        error: vault_canonical_pairs(pairs, scratch)
        if (error != I64{0}) {
            vault_pairs_drop(pairs)
            jet_rt_free(scratch, I64{8}, I64{8})
            return error
        }
        canonical: rt_text_word(scratch)
        thread_zero(rt_text_word(wrapping(canonical + DATA_SEQUENCE_DATA)), rt_text_word(wrapping(canonical + DATA_SEQUENCE_CAPACITY)))
        data_sequence_drop(canonical, DYN_BYTE_LIST)
        rt_text_store(out, pairs)
    }
    thread_zero(scratch, I64{8})
    jet_rt_free(scratch, I64{8}, I64{8})
    I64{0}
}
vault_revision_overflow: fn(scratch: I64) -> I64 {
    rt_text_store(scratch, I64{7309955123234824566})
    rt_text_store(wrapping(scratch + I64{8}), I64{121424789596534})
    incident: jet_rt_string_from_static(scratch, I64{14})
    error: jet_rt_alloc(VAULT_ERROR_BYTES, I64{8})
    rt_text_store(wrapping(error + VAULT_ERROR_TAG), I64{12})
    rt_text_store(wrapping(error + VAULT_ERROR_FIRST), incident)
    rt_text_store(wrapping(error + VAULT_ERROR_SECOND), I64{0})
    error
}
// Canonicalization precedes every filesystem read. Scratch192 tracks all
// owners; adopted pairs are consumed even on an error.
vault_replace_strings_inner: fn(root: I64, scratch: I64) -> I64 {
    pairs: rt_text_word(scratch)
    canonical_error: vault_canonical_pairs(pairs, wrapping(scratch + I64{8}))
    if (canonical_error != I64{0}) -> return canonical_error
    canonical: rt_text_word(wrapping(scratch + I64{8}))
    thread_zero(rt_text_word(wrapping(canonical + DATA_SEQUENCE_DATA)), rt_text_word(wrapping(canonical + DATA_SEQUENCE_CAPACITY)))
    data_sequence_drop(canonical, DYN_BYTE_LIST)
    error: vault_read_at_root(root, wrapping(scratch + I64{16}), wrapping(scratch + I64{40}), wrapping(scratch + I64{72}), wrapping(scratch + I64{104}))
    if (error != I64{0}) -> return error
    if (rt_text_word(wrapping(scratch + I64{104})) != VAULT_START_V2) -> return vault_error_new(I64{8}, I64{0}, I64{0})
    store: rt_text_word(wrapping(scratch + I64{16}))
    revision: rt_text_word(wrapping(store + VAULT_STORE_REVISION))
    lock_error: vault_acquire_lock(root, wrapping(store + VAULT_STORE_UUID), revision, wrapping(scratch + I64{40}), wrapping(scratch + I64{32}))
    if (lock_error != I64{0}) -> return lock_error
    current_error: vault_read_at_root(root, wrapping(scratch + I64{24}), wrapping(scratch + I64{112}), wrapping(scratch + I64{144}), wrapping(scratch + I64{176}))
    if (current_error != I64{0}) -> return current_error
    current: rt_text_word(wrapping(scratch + I64{24}))
    if (!vault_writer_snapshot_matches(current, wrapping(scratch + I64{112}), wrapping(scratch + I64{144}), rt_text_word(wrapping(scratch + I64{176})), wrapping(scratch + I64{40}), wrapping(scratch + I64{72}), VAULT_START_V2, revision) ||
        !rt_text_equal_bytes(wrapping(current + VAULT_STORE_UUID), wrapping(store + VAULT_STORE_UUID), I64{16})) -> return vault_error_new(I64{6}, I64{0}, I64{0})
    // pairs_drop wipes VALUES and drops keys without wiping their bytes.
    vault_pairs_drop(rt_text_word(wrapping(store + VAULT_STORE_STRINGS)))
    rt_text_store(wrapping(store + VAULT_STORE_STRINGS), pairs)
    rt_text_store(scratch, I64{0})
    if (revision == I64{-1}) -> return vault_revision_overflow(wrapping(scratch + I64{112}))
    rt_text_store(wrapping(store + VAULT_STORE_REVISION), wrapping(revision + I64{1}))
    lock: rt_text_word(wrapping(scratch + I64{32}))
    rt_text_store(wrapping(scratch + I64{32}), I64{0})
    vault_write_at_root(root, store, wrapping(scratch + I64{40}), wrapping(scratch + I64{72}), rt_text_word(wrapping(scratch + I64{104})), revision, lock)
}
vault_replace_strings_at_root: fn(root: I64, pairs: I64) -> I64 {
    scratch: jet_rt_alloc(I64{192}, I64{8})
    thread_zero(scratch, I64{192})
    rt_text_store(scratch, pairs)
    error: vault_replace_strings_inner(root, scratch)
    vault_pairs_drop(rt_text_word(scratch))
    vault_store_drop(rt_text_word(wrapping(scratch + I64{16})))
    vault_store_drop(rt_text_word(wrapping(scratch + I64{24})))
    vault_lock_drop(rt_text_word(wrapping(scratch + I64{32})))
    thread_zero(scratch, I64{192})
    jet_rt_free(scratch, I64{192}, I64{8})
    error
}

// Existing name-mapped JetVaultKeyRef<T>. T is phantom: the provider receives
// its checked key tag as a parameter.
VAULT_REF_BYTES: I64{88}
VAULT_REF_PROVIDER: I64{0}
VAULT_REF_UUID: I64{8}
VAULT_REF_NAME: I64{24}
VAULT_REF_GENERATION: I64{32}
VAULT_REF_OPAQUE: I64{40}
VAULT_REF_HASH: I64{56}
vault_ref: fn(store: I64, record: I64) -> I64 {
    reference: jet_rt_alloc(VAULT_REF_BYTES, I64{8})
    rt_text_store(wrapping(reference + VAULT_REF_PROVIDER), I64{0})
    rt_text_bytes_copy(wrapping(reference + VAULT_REF_UUID), wrapping(store + VAULT_STORE_UUID), I64{16})
    rt_text_store(wrapping(reference + VAULT_REF_NAME), jet_rt_string_clone(rt_text_word(wrapping(record + VAULT_RECORD_NAME))))
    rt_text_store(wrapping(reference + VAULT_REF_GENERATION), rt_text_word(wrapping(record + VAULT_RECORD_GENERATION)))
    rt_text_bytes_copy(wrapping(reference + VAULT_REF_OPAQUE), wrapping(record + VAULT_RECORD_OPAQUE), I64{16})
    rt_text_bytes_copy(wrapping(reference + VAULT_REF_HASH), wrapping(record + VAULT_RECORD_HASH), I64{32})
    reference
}
vault_ref_clone: fn(reference: I64) -> I64 {
    result: jet_rt_alloc(VAULT_REF_BYTES, I64{8})
    rt_text_bytes_copy(result, reference, VAULT_REF_BYTES)
    rt_text_store(wrapping(result + VAULT_REF_NAME), jet_rt_string_clone(rt_text_word(wrapping(reference + VAULT_REF_NAME))))
    result
}
vault_ref_drop: fn(reference: I64) {
    if (reference == I64{0}) -> return
    jet_rt_string_drop(rt_text_word(wrapping(reference + VAULT_REF_NAME)))
    jet_rt_free(reference, VAULT_REF_BYTES, I64{8})
}
vault_ref_equal: fn(left: I64, right: I64) -> Bool {
    rt_text_word(wrapping(left + VAULT_REF_PROVIDER)) == rt_text_word(wrapping(right + VAULT_REF_PROVIDER)) &&
        rt_text_equal_bytes(wrapping(left + VAULT_REF_UUID), wrapping(right + VAULT_REF_UUID), I64{16}) &&
        jet_rt_string_eq(rt_text_word(wrapping(left + VAULT_REF_NAME)), rt_text_word(wrapping(right + VAULT_REF_NAME))) &&
        rt_text_word(wrapping(left + VAULT_REF_GENERATION)) == rt_text_word(wrapping(right + VAULT_REF_GENERATION)) &&
        rt_text_equal_bytes(wrapping(left + VAULT_REF_OPAQUE), wrapping(right + VAULT_REF_OPAQUE), I64{16}) &&
        rt_text_equal_bytes(wrapping(left + VAULT_REF_HASH), wrapping(right + VAULT_REF_HASH), I64{32})
}
// Display/Debug never reveal repository hashes or key material.
vault_ref_display: fn(reference: I64, debug: Bool) -> I64 {
    target: jet_rt_string_builder_new()
    rt_text_push_word(target, I64{250977740146}, I64{5}) // repo:
    jet_rt_string_builder_push(target, rt_text_word(wrapping(reference + VAULT_REF_NAME)))
    rt_text_push_word(target, I64{30272}, I64{2}) // @v
    vault_push_u64(target, rt_text_word(wrapping(reference + VAULT_REF_GENERATION)))
    if debug {
        rt_text_push_word(target, I64{35}, I64{1})
        at := I64{0}
        loop at < (I64{8}) {
            byte: rt_text_byte(wrapping(wrapping(reference + VAULT_REF_OPAQUE) + at /% I64{2}))
            nibble: if (at % I64{2} == I64{0}) -> byte >> I64{4} else -> byte.bit_and(I64{15})
            rt_text_push_word(target, if (nibble < I64{10}) -> nibble + I64{48} else -> nibble + I64{87}, I64{1})
            at += I64{1}
        }
    }
    jet_rt_string_builder_finish(target)
}
vault_ref_matches: fn(record: I64, reference: I64) -> Bool {
    jet_rt_string_eq(rt_text_word(wrapping(record + VAULT_RECORD_NAME)), rt_text_word(wrapping(reference + VAULT_REF_NAME))) &&
        rt_text_word(wrapping(record + VAULT_RECORD_GENERATION)) == rt_text_word(wrapping(reference + VAULT_REF_GENERATION)) &&
        rt_text_equal_bytes(wrapping(record + VAULT_RECORD_OPAQUE), wrapping(reference + VAULT_REF_OPAQUE), I64{16}) &&
        rt_text_equal_bytes(wrapping(record + VAULT_RECORD_HASH), wrapping(reference + VAULT_REF_HASH), I64{32})
}
// Seed1691-1715: identity first, then key type, then immutable hash validation.
// Success lends the store's record; caller retains the store for the whole use.
vault_find: fn(store: I64, reference: I64, key_type: I64, out: I64) -> I64 {
    if (rt_text_word(wrapping(reference + VAULT_REF_PROVIDER)) != I64{0} ||
        !rt_text_equal_bytes(wrapping(store + VAULT_STORE_UUID), wrapping(reference + VAULT_REF_UUID), I64{16})) -> return vault_error_new(I64{1}, I64{0}, I64{0})
    records: rt_text_word(wrapping(store + VAULT_STORE_RECORDS))
    count: rt_text_word(wrapping(records + DATA_SEQUENCE_LENGTH))
    data: rt_text_word(wrapping(records + DATA_SEQUENCE_DATA))
    at := I64{0}
    loop at < count {
        record: rt_text_word(wrapping(data + at * DYN_ELEMENT_BYTES))
        if vault_ref_matches(record, reference) {
            if (rt_text_word(wrapping(record + VAULT_RECORD_TYPE)) != key_type) -> return vault_error_new(I64{2}, I64{0}, I64{0})
            scratch: jet_rt_alloc(I64{8224}, I64{8})
            vault_record_hash(record, wrapping(scratch + I64{8192}), scratch)
            same: rt_text_equal_bytes(wrapping(scratch + I64{8192}), wrapping(record + VAULT_RECORD_HASH), I64{32})
            thread_zero(scratch, I64{8224})
            jet_rt_free(scratch, I64{8224}, I64{8})
            if !same -> return vault_error_new(I64{8}, I64{0}, I64{0})
            rt_text_store(out, record)
            return I64{0}
        }
        at += I64{1}
    }
    vault_error_new(I64{1}, I64{0}, I64{0})
}
vault_refs_drop: fn(references: I64) {
    count: rt_text_word(wrapping(references + DATA_SEQUENCE_LENGTH))
    data: rt_text_word(wrapping(references + DATA_SEQUENCE_DATA))
    at := I64{0}
    loop at < count {
        vault_ref_drop(rt_text_word(wrapping(data + at * DYN_ELEMENT_BYTES)))
        at += I64{1}
    }
    capacity: rt_text_word(wrapping(references + DATA_SEQUENCE_CAPACITY))
    if (capacity != I64{0}) -> jet_rt_free(data, capacity * DYN_ELEMENT_BYTES, I64{8})
    jet_rt_free(references, DATA_SEQUENCE_BYTES, I64{8})
}
// current and versions share seed1717-1755's validation and wrong-type FIRST.
vault_key_query_inner: fn(store: I64, name: I64, key_type: I64, versions: Bool, out: I64) -> I64 {
    records: rt_text_word(wrapping(store + VAULT_STORE_RECORDS))
    count: rt_text_word(wrapping(records + DATA_SEQUENCE_LENGTH))
    data: rt_text_word(wrapping(records + DATA_SEQUENCE_DATA))
    at := I64{0}
    matches := I64{0}
    active := I64{0}
    loop at < count {
        record: rt_text_word(wrapping(data + at * DYN_ELEMENT_BYTES))
        if jet_rt_string_eq(rt_text_word(wrapping(record + VAULT_RECORD_NAME)), name) {
            if (rt_text_word(wrapping(record + VAULT_RECORD_TYPE)) != key_type) -> return vault_error_new(I64{2}, I64{0}, I64{0})
            matches += I64{1}
            if (active == I64{0} && rt_text_word(wrapping(record + VAULT_RECORD_STATUS)) == I64{1}) -> active = record
        }
        at += I64{1}
    }
    if !versions {
        rt_text_store(out, if (active == I64{0}) -> I64{0} else -> vault_ref(store, active))
        return I64{0}
    }
    result: data_sequence_new(matches, DYN_ELEMENT_BYTES)
    if (matches != I64{0}) {
        // Only matching records are sorted: type/name are constant, so the
        // existing comparator sorts unsigned generation ascending. Valid
        // decoded rows have unique generations (seed1108-1113); reverse yields seed order.
        index_bytes: matches * I64{24}
        indices: jet_rt_alloc(index_bytes, I64{8})
        cursor := I64{0}
        at = I64{0}
        loop at < count {
            record: rt_text_word(wrapping(data + at * DYN_ELEMENT_BYTES))
            if jet_rt_string_eq(rt_text_word(wrapping(record + VAULT_RECORD_NAME)), name) {
                rt_text_store(wrapping(indices + cursor * DYN_ELEMENT_BYTES), record)
                cursor += I64{1}
            }
            at += I64{1}
        }
        sorted: vault_sorted_indices(indices, matches, true, wrapping(indices + matches * I64{8}), indices + matches * I64{16})
        output: rt_text_word(wrapping(result + DATA_SEQUENCE_DATA))
        at = I64{0}
        loop at < matches {
            record: rt_text_word(wrapping(sorted + (matches - at - I64{1}) * DYN_ELEMENT_BYTES))
            rt_text_store(wrapping(output + at * DYN_ELEMENT_BYTES), vault_ref(store, record))
            at += I64{1}
        }
        jet_rt_free(indices, index_bytes, I64{8})
    }
    rt_text_store(wrapping(result + DATA_SEQUENCE_LENGTH), matches)
    rt_text_store(out, result)
    I64{0}
}
vault_key_query_at_root: fn(root: I64, name: I64, key_type: I64, versions: Bool, out: I64) -> I64 {
    if !vault_validate_text(name, false) -> return vault_error_new(I64{0}, I64{0}, I64{0})
    scratch: jet_rt_alloc(I64{48}, I64{8})
    error: vault_read_contents_at_root(root, scratch, wrapping(scratch + I64{8}), wrapping(scratch + I64{40}))
    if (error != I64{0}) {
        jet_rt_free(scratch, I64{48}, I64{8})
        return error
    }
    store: rt_text_word(scratch)
    result: vault_key_query_inner(store, name, key_type, versions, out)
    vault_store_drop(store)
    thread_zero(scratch, I64{48})
    jet_rt_free(scratch, I64{48}, I64{8})
    result
}
vault_current_at_root: fn(root: I64, name: I64, key_type: I64, out: I64) -> I64 {
    vault_key_query_at_root(root, name, key_type, false, out)
}
// The Core `KeyRef<T>` a runtime ref crosses as (Core/Crypto/Vault.jet): a
// 40-byte shell of its declared fields, name String @0, version exact Int @8
// and the private `identity: [U8]` List header @16 holding the store uuid,
// record opaque id and record hash (64 bytes). With the provider word 0 and
// the generation, that is every word of the runtime ref, so a later vault
// call rebuilds the exact ref and vault_find re-verifies it.
VAULT_KEY_REF_SHELL_BYTES: I64{40}
VAULT_KEY_REF_IDENTITY_BYTES: I64{64}
vault_key_ref_shell: fn(reference: I64) -> I64 {
    shell: jet_rt_alloc(VAULT_KEY_REF_SHELL_BYTES, I64{8})
    rt_text_store(shell, jet_rt_string_clone(rt_text_word(wrapping(reference + VAULT_REF_NAME))))
    rt_text_store(wrapping(shell + I64{8}), jet_int_owned_from_i64(rt_text_word(wrapping(reference + VAULT_REF_GENERATION))))
    identity: jet_rt_alloc(VAULT_KEY_REF_IDENTITY_BYTES * RT_HOST_U8_STRIDE, I64{8})
    rt_text_bytes_copy(identity, wrapping(reference + VAULT_REF_UUID), I64{16})
    rt_text_bytes_copy(wrapping(identity + I64{16}), wrapping(reference + VAULT_REF_OPAQUE), I64{16})
    rt_text_bytes_copy(wrapping(identity + I64{32}), wrapping(reference + VAULT_REF_HASH), I64{32})
    rt_text_store(wrapping(wrapping(shell + I64{16}) + DATA_SEQUENCE_LENGTH), VAULT_KEY_REF_IDENTITY_BYTES)
    rt_text_store(wrapping(wrapping(shell + I64{16}) + DATA_SEQUENCE_CAPACITY), VAULT_KEY_REF_IDENTITY_BYTES)
    rt_text_store(wrapping(wrapping(shell + I64{16}) + DATA_SEQUENCE_DATA), identity)
    shell
}
// `vault.current<T>(name)` over the repository at the working directory
// (IR route jet_vault_current_impl). `key_type` is the exact Int tag of T
// (1 SigningKey, 2 X25519SecretKey). Ok answers 1 and writes the Option tag
// at `some` and, when present, the KeyRef<T> shell at `value`, whose shell
// (not its fields) the caller frees. Err answers 0 and writes the
// VaultError record at `err`.
#Export(c) jet_vault_current_impl: fn(name: I64, key_type: I64, some: I64, value: I64, err: I64) -> I64 {
    slot: jet_rt_alloc(I64{8}, I64{8})
    rt_text_store(slot, I64{0})
    error: vault_current_at_root(rt_static_text("."), name, jet_int_owned_to_i64(key_type), slot)
    reference: rt_text_word(slot)
    jet_rt_free(slot, I64{8}, I64{8})
    if (error != I64{0}) {
        rt_text_store(err, error)
        return I64{0}
    }
    if (reference == I64{0}) {
        rt_text_store(some, I64{0})
        return I64{1}
    }
    rt_text_store(some, I64{1})
    rt_text_store(value, vault_key_ref_shell(reference))
    vault_ref_drop(reference)
    I64{1}
}
// Status uses wire1/2/3 internally. Only this boundary projects by variant name
// into Core KeyStatus Active0/Retired1/Revoked2; no runtime enum carrier.
vault_status_core: fn(wire: I64) -> I64 {
    if (wire == I64{1}) -> return I64{0}
    if (wire == I64{2}) -> return I64{1}
    if (wire == I64{3}) -> return I64{2}
    panic("record variant index out of range")
}
vault_key_access_at_root: fn(root: I64, reference: I64, key_type: I64, load: Bool, out: I64) -> I64 {
    scratch: jet_rt_alloc(I64{56}, I64{8})
    error: vault_read_contents_at_root(root, scratch, wrapping(scratch + I64{8}), wrapping(scratch + I64{40}))
    if (error != I64{0}) {
        jet_rt_free(scratch, I64{56}, I64{8})
        return error
    }
    store: rt_text_word(scratch)
    found: vault_find(store, reference, key_type, wrapping(scratch + I64{48}))
    if (found != I64{0}) {
        vault_store_drop(store)
        thread_zero(scratch, I64{56})
        jet_rt_free(scratch, I64{56}, I64{8})
        return found
    }
    record: rt_text_word(wrapping(scratch + I64{48}))
    status: rt_text_word(wrapping(record + VAULT_RECORD_STATUS))
    result := I64{0}
    if !load {
        rt_text_store(out, vault_status_core(status))
    } else if (status == I64{3}) {
        result = vault_error_new(I64{3}, I64{0}, I64{0})
    } else {
        bytes: data_sequence_clone(jet_rt_secret_bytes(rt_text_word(wrapping(record + VAULT_RECORD_SECRET))), DYN_BYTE_LIST)
        if (rt_text_word(wrapping(bytes + DATA_SEQUENCE_LENGTH)) != I64{32}) {
            thread_zero(rt_text_word(wrapping(bytes + DATA_SEQUENCE_DATA)), rt_text_word(wrapping(bytes + DATA_SEQUENCE_CAPACITY)))
            data_sequence_drop(bytes, DYN_BYTE_LIST)
            result = vault_error_new(I64{8}, I64{0}, I64{0})
        } else {
            secret: jet_rt_secret_from_bytes(bytes)
            jet_rt_free(bytes, DATA_SEQUENCE_BYTES, I64{8})
            rt_text_store(out, secret)
        }
    }
    vault_store_drop(store)
    thread_zero(scratch, I64{56})
    jet_rt_free(scratch, I64{56}, I64{8})
    result
}
vault_load_at_root: fn(root: I64, reference: I64, key_type: I64, out: I64) -> I64 {
    vault_key_access_at_root(root, reference, key_type, true, out)
}
vault_status_at_root: fn(root: I64, reference: I64, key_type: I64, out: I64) -> I64 {
    vault_key_access_at_root(root, reference, key_type, false, out)
}

// Name-mapped seed carriers. No runtime T field.
VAULT_PLAN_BYTES: I64{288}
VAULT_PLAN_ACTION: I64{0}
VAULT_PLAN_NAME: I64{8}
VAULT_PLAN_TARGET: I64{16}
VAULT_PLAN_IMPORTED: I64{24}
VAULT_PLAN_REASON: I64{32}
VAULT_PLAN_UUID: I64{40}
VAULT_PLAN_REVISION: I64{56}
VAULT_PLAN_START_HASH: I64{64}
VAULT_PLAN_PROVIDER: I64{96}
VAULT_PLAN_PUBLIC_HASH: I64{128}
VAULT_PLAN_KEY_DIGEST: I64{160}
VAULT_PLAN_FROM: I64{192}
VAULT_PLAN_TO: I64{200}
VAULT_PLAN_KIND: I64{208}
VAULT_PLAN_OPERATION: I64{216}
VAULT_PLAN_ISSUED: I64{248}
VAULT_PLAN_DEADLINE: I64{264}
VAULT_PLAN_EXPIRES: I64{280}
VAULT_WRITE_BYTES: I64{96}
VAULT_WRITE_OPERATION: I64{0}
VAULT_WRITE_PREVIEW: I64{32}
VAULT_WRITE_USER: I64{64}
VAULT_WRITE_SESSION: I64{72}
VAULT_WRITE_DEADLINE: I64{80}
vault_imported_drop: fn(bytes: I64) {
    if (bytes == I64{0}) -> return
    thread_zero(rt_text_word(wrapping(bytes + DATA_SEQUENCE_DATA)), rt_text_word(wrapping(bytes + DATA_SEQUENCE_CAPACITY)))
    data_sequence_drop(bytes, DYN_BYTE_LIST)
}
vault_plan_drop: fn(plan: I64) {
    if (plan == I64{0}) -> return
    jet_rt_string_drop(rt_text_word(wrapping(plan + VAULT_PLAN_NAME)))
    vault_ref_drop(rt_text_word(wrapping(plan + VAULT_PLAN_TARGET)))
    vault_imported_drop(rt_text_word(wrapping(plan + VAULT_PLAN_IMPORTED)))
    jet_rt_string_drop(rt_text_word(wrapping(plan + VAULT_PLAN_REASON)))
    thread_zero(plan, VAULT_PLAN_BYTES)
    jet_rt_free(plan, VAULT_PLAN_BYTES, I64{8})
}
vault_write_drop: fn(write: I64) {
    if (write == I64{0}) -> return
    thread_zero(write, VAULT_WRITE_BYTES)
    jet_rt_free(write, VAULT_WRITE_BYTES, I64{8})
}
vault_incident: fn(first: I64, second: I64, length: I64, scratch: I64) -> I64 {
    rt_text_store(scratch, first)
    rt_text_store(wrapping(scratch + I64{8}), second)
    incident: jet_rt_string_from_static(scratch, length)
    error: jet_rt_alloc(VAULT_ERROR_BYTES, I64{8})
    rt_text_store(wrapping(error + VAULT_ERROR_TAG), I64{12})
    rt_text_store(wrapping(error + VAULT_ERROR_FIRST), incident)
    rt_text_store(wrapping(error + VAULT_ERROR_SECOND), I64{0})
    error
}
// Seed1884-1904 exact operation byte sequence. Validated names/reasons fit the
// caller's buffer1024; SHA scratch576 and final digest32 are disjoint.
vault_plan_operation: fn(plan: I64, key_type: I64, buffer: I64, scratch: I64) {
    name: rt_text_word(wrapping(plan + VAULT_PLAN_NAME))
    reason: rt_text_word(wrapping(plan + VAULT_PLAN_REASON))
    rt_text_store(buffer, I64{8101729655197554250})
    rt_text_store(wrapping(buffer + I64{8}), I64{31084746152964709})
    rt_text_bytes_copy(wrapping(buffer + I64{15}), wrapping(plan + VAULT_PLAN_UUID), I64{16})
    vault_put_u64(wrapping(buffer + I64{31}), rt_text_word(wrapping(plan + VAULT_PLAN_REVISION)))
    rt_text_bytes_copy(wrapping(buffer + I64{39}), wrapping(plan + VAULT_PLAN_START_HASH), I64{32})
    rt_text_bytes_copy(wrapping(buffer + I64{71}), wrapping(plan + VAULT_PLAN_PROVIDER), I64{32})
    rt_text_put(wrapping(buffer + I64{103}), rt_text_word(wrapping(plan + VAULT_PLAN_ACTION)))
    rt_text_put(wrapping(buffer + I64{104}), key_type)
    vault_put_u16(wrapping(buffer + I64{105}), rt_text_len(name))
    rt_text_bytes_copy(wrapping(buffer + I64{107}), rt_text_data(name), rt_text_len(name))
    at := I64{107} + rt_text_len(name)
    target: rt_text_word(wrapping(plan + VAULT_PLAN_TARGET))
    rt_text_put(wrapping(buffer + at), if (target == I64{0}) -> I64{0} else -> I64{1})
    at += I64{1}
    if (target == I64{0}) {
        thread_zero(wrapping(buffer + at), I64{72})
    } else {
        rt_text_bytes_copy(wrapping(buffer + at), wrapping(target + VAULT_REF_UUID), I64{16})
        vault_put_u64(wrapping(wrapping(buffer + at) + I64{16}), rt_text_word(wrapping(target + VAULT_REF_GENERATION)))
        rt_text_bytes_copy(wrapping(wrapping(buffer + at) + I64{24}), wrapping(target + VAULT_REF_OPAQUE), I64{16})
        rt_text_bytes_copy(wrapping(wrapping(buffer + at) + I64{40}), wrapping(target + VAULT_REF_HASH), I64{32})
    }
    at += I64{72}
    vault_put_u16(wrapping(buffer + at), rt_text_len(reason))
    at += I64{2}
    rt_text_bytes_copy(wrapping(buffer + at), rt_text_data(reason), rt_text_len(reason))
    at += rt_text_len(reason)
    rt_text_bytes_copy(wrapping(buffer + at), wrapping(plan + VAULT_PLAN_PUBLIC_HASH), I64{32})
    rt_text_bytes_copy(wrapping(wrapping(buffer + at) + I64{32}), wrapping(plan + VAULT_PLAN_KEY_DIGEST), I64{32})
    thread_zero(wrapping(wrapping(buffer + at) + I64{64}), I64{32})
    rt_sha256_parts(buffer, at + I64{96}, I64{1}, I64{0}, wrapping(plan + VAULT_PLAN_OPERATION), scratch)
}
vault_prepare_inner: fn(root: I64, name: I64, key_type: I64, action: I64, target: I64, imported: I64, reason: I64, out: I64, scratch: I64) -> I64 {
    plan: wrapping(scratch + I64{8192})
    rt_text_store(wrapping(plan + VAULT_PLAN_ACTION), action)
    rt_text_store(wrapping(plan + VAULT_PLAN_NAME), name)
    rt_text_store(wrapping(plan + VAULT_PLAN_TARGET), target)
    rt_text_store(wrapping(plan + VAULT_PLAN_IMPORTED), imported)
    rt_text_store(wrapping(plan + VAULT_PLAN_REASON), reason)
    read_error: vault_read_at_root(root, wrapping(scratch + I64{8480}), wrapping(plan + VAULT_PLAN_START_HASH), wrapping(plan + VAULT_PLAN_PROVIDER), wrapping(plan + VAULT_PLAN_KIND))
    if (read_error != I64{0}) -> return read_error
    store: rt_text_word(wrapping(scratch + I64{8480}))
    if (rt_text_word(wrapping(plan + VAULT_PLAN_KIND)) != VAULT_START_V2) {
        if (rt_crypto_entropy_fill(wrapping(store + VAULT_STORE_UUID), I64{16}) != I64{0}) -> return vault_error_new(I64{10}, VAULT_CRYPTO_UNAVAILABLE, I64{0})
        if vault_bytes_zero(wrapping(store + VAULT_STORE_UUID), I64{16}) -> return vault_incident(I64{7312206923048509814}, I64{28263450869067634}, I64{15}, scratch)
    }
    rt_text_bytes_copy(wrapping(plan + VAULT_PLAN_UUID), wrapping(store + VAULT_STORE_UUID), I64{16})
    rt_text_store(wrapping(plan + VAULT_PLAN_REVISION), rt_text_word(wrapping(store + VAULT_STORE_REVISION)))
    records: rt_text_word(wrapping(store + VAULT_STORE_RECORDS))
    data: rt_text_word(wrapping(records + DATA_SEQUENCE_DATA))
    count: rt_text_word(wrapping(records + DATA_SEQUENCE_LENGTH))
    any_name := false
    active := I64{0}
    maximum := I64{0}
    at := I64{0}
    loop at < count {
        record: rt_text_word(wrapping(data + at * DYN_ELEMENT_BYTES))
        if jet_rt_string_eq(rt_text_word(wrapping(record + VAULT_RECORD_NAME)), name) {
            if (rt_text_word(wrapping(record + VAULT_RECORD_TYPE)) != key_type) -> return vault_error_new(I64{2}, I64{0}, I64{0})
            any_name = true
            if (active == I64{0} && rt_text_word(wrapping(record + VAULT_RECORD_STATUS)) == I64{1}) -> active = record
            generation: rt_text_word(wrapping(record + VAULT_RECORD_GENERATION))
            if vault_unsigned_less(maximum, generation) -> maximum = generation
        }
        at += I64{1}
    }
    if (action == I64{1} && any_name) -> return vault_error_new(I64{6}, I64{0}, I64{0})
    if ((action == I64{2} || action == I64{6}) && active != I64{0}) -> return vault_error_new(I64{6}, I64{0}, I64{0})
    if (action == I64{3} && active == I64{0}) -> return vault_error_new(I64{1}, I64{0}, I64{0})
    if (action == I64{4} || action == I64{5}) {
        if (target == I64{0}) -> return vault_error_new(I64{1}, I64{0}, I64{0})
        found: vault_find(store, target, key_type, wrapping(scratch + I64{8488}))
        if (found != I64{0}) -> return found
        record: rt_text_word(wrapping(scratch + I64{8488}))
        status: rt_text_word(wrapping(record + VAULT_RECORD_STATUS))
        if (action == I64{4} && status != I64{1}) -> return vault_error_new(if (status == I64{3}) -> I64{3} else -> I64{6}, I64{0}, I64{0})
        if (action == I64{5} && status == I64{3}) -> return vault_error_new(I64{3}, I64{0}, I64{0})
    }
    if (imported != I64{0}) {
        key: rt_text_word(wrapping(imported + DATA_SEQUENCE_DATA))
        key_length: rt_text_word(wrapping(imported + DATA_SEQUENCE_LENGTH))
        if !vault_public_hash_bytes(key_type, key, key_length, wrapping(plan + VAULT_PLAN_PUBLIC_HASH), scratch) -> return vault_error_new(I64{8}, I64{0}, I64{0})
        vault_key_digest_bytes(key_type, key, key_length, wrapping(plan + VAULT_PLAN_KEY_DIGEST), scratch)
    }
    if (maximum == I64{-1}) -> return vault_incident(I64{7306858898491007350}, I64{7957695015158965614}, I64{16}, scratch)
    next: wrapping(maximum + I64{1})
    if (action == I64{3}) {
        rt_text_store(wrapping(plan + VAULT_PLAN_FROM), rt_text_word(wrapping(active + VAULT_RECORD_GENERATION)))
        rt_text_store(wrapping(plan + VAULT_PLAN_TO), next)
    } else if (action == I64{4} || action == I64{5}) {
        rt_text_store(wrapping(plan + VAULT_PLAN_FROM), rt_text_word(wrapping(target + VAULT_REF_GENERATION)))
    } else {
        rt_text_store(wrapping(plan + VAULT_PLAN_TO), next)
    }
    vault_plan_operation(plan, key_type, wrapping(scratch + I64{576}), scratch)
    vault_instant_now(wrapping(plan + VAULT_PLAN_ISSUED))
    issued: rt_text_word(wrapping(plan + VAULT_PLAN_ISSUED))
    if (issued > I64{9223371736854775807}) -> return vault_error_new(I64{7}, I64{0}, I64{0})
    rt_text_store(wrapping(plan + VAULT_PLAN_DEADLINE), issued + I64{300000000000})
    rt_text_store(wrapping(wrapping(plan + VAULT_PLAN_DEADLINE) + I64{8}), I64{0})
    if !vault_wall_unix_ms(wrapping(plan + VAULT_PLAN_EXPIRES), scratch) -> return vault_error_new(I64{7}, I64{0}, I64{0})
    wall: rt_text_word(wrapping(plan + VAULT_PLAN_EXPIRES))
    if vault_unsigned_less(I64{-300001}, wall) -> return vault_error_new(I64{7}, I64{0}, I64{0})
    rt_text_store(wrapping(plan + VAULT_PLAN_EXPIRES), wrapping(wall + I64{300000}))
    result: jet_rt_alloc(VAULT_PLAN_BYTES, I64{8})
    rt_text_bytes_copy(result, plan, VAULT_PLAN_BYTES)
    rt_text_store(wrapping(result + VAULT_PLAN_NAME), jet_rt_string_clone(name))
    rt_text_store(out, result)
    I64{0}
}
// Adopts target/imported/reason, exactly once, whether preparation succeeds or
// fails. Name is borrowed. Final plan allocation follows all seed checks.
vault_prepare_at_root: fn(root: I64, name: I64, key_type: I64, action: I64, target: I64, imported: I64, reason: I64, out: I64) -> I64 {
    error := I64{0}
    if !vault_validate_text(name, false) {
        error = vault_error_new(I64{0}, I64{0}, I64{0})
    } else if ((action == I64{3} || action == I64{4} || action == I64{5}) && !vault_validate_text(reason, true)) {
        error = vault_error_new(I64{0}, I64{0}, I64{0})
    } else {
        scratch: jet_rt_alloc(I64{8512}, I64{8})
        thread_zero(wrapping(scratch + I64{8192}), I64{320})
        error = vault_prepare_inner(root, name, key_type, action, target, imported, reason, out, scratch)
        vault_store_drop(rt_text_word(wrapping(scratch + I64{8480})))
        thread_zero(scratch, I64{8512})
        jet_rt_free(scratch, I64{8512}, I64{8})
    }
    if (error != I64{0}) {
        vault_ref_drop(target)
        vault_imported_drop(imported)
        jet_rt_string_drop(reason)
    }
    error
}

// fb3361756's ONE shared host monotonic provider, never a second raw clock.
// The 1:1 seed Instant slot keeps its position; only ordering/deadline semantics
// are observable. Native stores ns in word0 and zero in the reserved word1.
vault_instant_now: fn(out: I64) {
    rt_text_store(out, jet_time_raw_host_monotonic_ns())
    rt_text_store(wrapping(out + I64{8}), I64{0})
}

// Exact seed2137-2153 preview bytes, not the human-readable prompt.
vault_preview_hash: fn(plan: I64, key_type: I64, reason: I64, out: I64, buffer: I64, scratch: I64) {
    name: rt_text_word(wrapping(plan + VAULT_PLAN_NAME))
    lifecycle_reason: rt_text_word(wrapping(plan + VAULT_PLAN_REASON))
    rt_text_store(buffer, I64{8458076975713244746})
    rt_text_store(wrapping(buffer + I64{8}), I64{2340029477635975284})
    rt_text_store(wrapping(buffer + I64{16}), I64{33607025860899440})
    rt_text_bytes_copy(wrapping(buffer + I64{23}), wrapping(plan + VAULT_PLAN_OPERATION), I64{32})
    rt_text_put(wrapping(buffer + I64{55}), rt_text_word(wrapping(plan + VAULT_PLAN_ACTION)))
    rt_text_put(wrapping(buffer + I64{56}), key_type)
    rt_text_bytes_copy(wrapping(buffer + I64{57}), wrapping(plan + VAULT_PLAN_UUID), I64{16})
    vault_put_u64(wrapping(buffer + I64{73}), rt_text_word(wrapping(plan + VAULT_PLAN_REVISION)))
    vault_put_u16(wrapping(buffer + I64{81}), rt_text_len(name))
    rt_text_bytes_copy(wrapping(buffer + I64{83}), rt_text_data(name), rt_text_len(name))
    at := I64{83} + rt_text_len(name)
    vault_put_u64(wrapping(buffer + at), rt_text_word(wrapping(plan + VAULT_PLAN_FROM)))
    vault_put_u64(wrapping(wrapping(buffer + at) + I64{8}), rt_text_word(wrapping(plan + VAULT_PLAN_TO)))
    vault_put_u16(wrapping(wrapping(buffer + at) + I64{16}), rt_text_len(lifecycle_reason))
    at += I64{18}
    rt_text_bytes_copy(wrapping(buffer + at), rt_text_data(lifecycle_reason), rt_text_len(lifecycle_reason))
    at += rt_text_len(lifecycle_reason)
    vault_put_u16(wrapping(buffer + at), rt_text_len(reason))
    at += I64{2}
    rt_text_bytes_copy(wrapping(buffer + at), rt_text_data(reason), rt_text_len(reason))
    at += rt_text_len(reason)
    vault_put_u64(wrapping(buffer + at), rt_text_word(wrapping(plan + VAULT_PLAN_EXPIRES)))
    rt_sha256_parts(buffer, at + I64{8}, I64{1}, I64{0}, out, scratch)
}
vault_action_text: fn(target: I64, action: I64) {
    if (action == I64{1}) {
        rt_text_push_word(target, I64{7310575239085057383}, I64{8})
    } else if (action == I64{2}) {
        rt_text_push_word(target, I64{435711603827}, I64{5})
    } else if (action == I64{3}) {
        rt_text_push_word(target, I64{111550525632370}, I64{6})
    } else if (action == I64{4}) {
        rt_text_push_word(target, I64{111542069912946}, I64{6})
    } else if (action == I64{5}) {
        rt_text_push_word(target, I64{111512105936242}, I64{6})
    } else if (action == I64{6}) {
        rt_text_push_word(target, I64{8030038433885282674}, I64{8})
        rt_text_push_word(target, I64{29810}, I64{2})
    } else {
        panic("record variant index out of range")
    }
}
vault_key_type_text: fn(target: I64, key_type: I64) {
    if (key_type == I64{1}) {
        rt_text_push_word(target, I64{5433432874548685139}, I64{8})
        rt_text_push_word(target, I64{31077}, I64{2})
    } else if (key_type == I64{2}) {
        rt_text_push_word(target, I64{7301242304406565464}, I64{8})
        rt_text_push_word(target, I64{34169846931747427}, I64{7})
    } else {
        panic("record variant index out of range")
    }
}
// Seed2154, byte-exact including "<none>" and the authority reason.
vault_preview_text: fn(plan: I64, key_type: I64, reason: I64) -> I64 {
    target: jet_rt_string_builder_new()
    vault_action_text(target, rt_text_word(wrapping(plan + VAULT_PLAN_ACTION)))
    rt_text_push_word(target, I64{32}, I64{1})
    vault_key_type_text(target, key_type)
    rt_text_push_word(target, I64{32}, I64{1})
    jet_rt_string_builder_push(target, rt_text_word(wrapping(plan + VAULT_PLAN_NAME)))
    rt_text_push_word(target, I64{32}, I64{1})
    vault_push_u64(target, rt_text_word(wrapping(plan + VAULT_PLAN_FROM)))
    rt_text_push_word(target, I64{540945696}, I64{4})
    vault_push_u64(target, rt_text_word(wrapping(plan + VAULT_PLAN_TO)))
    rt_text_push_word(target, I64{8030029676446378272}, I64{8})
    rt_text_push_word(target, I64{9140731657873779}, I64{7})
    at := I64{0}
    loop at < (I64{32}) {
        byte: rt_text_byte(wrapping(wrapping(plan + VAULT_PLAN_UUID) + at /% I64{2}))
        nibble: if (at % I64{2} == I64{0}) -> byte >> I64{4} else -> byte.bit_and(I64{15})
        rt_text_push_word(target, if (nibble < I64{10}) -> nibble + I64{48} else -> nibble + I64{87}, I64{1})
        at += I64{1}
    }
    rt_text_push_word(target, I64{7599372962079465760}, I64{8})
    rt_text_push_word(target, I64{139291748723}, I64{5})
    vault_push_u64(target, rt_text_word(wrapping(plan + VAULT_PLAN_REVISION)))
    rt_text_push_word(target, I64{7957705928737955899}, I64{8})
    rt_text_push_word(target, I64{8250}, I64{2})
    lifecycle: rt_text_word(wrapping(plan + VAULT_PLAN_REASON))
    if (rt_text_len(lifecycle) == I64{0}) {
        rt_text_push_word(target, I64{68605365415484}, I64{6})
    } else {
        jet_rt_string_builder_push(target, lifecycle)
    }
    jet_rt_string_builder_push(target, rt_static_text("; authority reason: "))
    jet_rt_string_builder_push(target, reason)
    jet_rt_string_builder_push(target, rt_static_text("; expires_unix_ms: "))
    vault_push_u64(target, rt_text_word(wrapping(plan + VAULT_PLAN_EXPIRES)))
    jet_rt_string_builder_finish(target)
}
// Seed2127-2166. Candidate96 is scratch only; allocate the write after grant
// and authority identity have succeeded. The borrowed plan/reason stay live.
vault_authorize_write: fn(plan: I64, key_type: I64, reason: I64, out: I64) -> I64 {
    if !vault_validate_text(reason, true) -> return vault_error_new(I64{0}, I64{0}, I64{0})
    now: jet_time_raw_host_monotonic_ns()
    issued: rt_text_word(wrapping(plan + VAULT_PLAN_ISSUED))
    if (now > rt_text_word(wrapping(plan + VAULT_PLAN_DEADLINE)) || (now > issued && now - issued > I64{300000000000})) -> return vault_error_new(I64{6}, I64{0}, I64{0})
    scratch: jet_rt_alloc(I64{1632}, I64{8})
    candidate: wrapping(scratch + I64{1536})
    thread_zero(candidate, VAULT_WRITE_BYTES)
    rt_text_bytes_copy(wrapping(candidate + VAULT_WRITE_OPERATION), wrapping(plan + VAULT_PLAN_OPERATION), I64{32})
    vault_preview_hash(plan, key_type, reason, wrapping(candidate + VAULT_WRITE_PREVIEW), wrapping(scratch + I64{576}), scratch)
    preview: vault_preview_text(plan, key_type, reason)
    granted: vault_native_authorize(preview, wrapping(plan + VAULT_PLAN_UUID))
    jet_rt_string_drop(preview)
    if !granted {
        thread_zero(scratch, I64{1632})
        jet_rt_free(scratch, I64{1632}, I64{8})
        return vault_error_new(I64{5}, I64{0}, I64{0})
    }
    user: trap_syscall(I64{107}, I64{0}, I64{0}, I64{0}, I64{0}, I64{0}, I64{0})
    session: trap_syscall(I64{124}, I64{0}, I64{0}, I64{0}, I64{0}, I64{0}, I64{0})
    if (session < I64{0}) {
        thread_zero(scratch, I64{1632})
        jet_rt_free(scratch, I64{1632}, I64{8})
        return vault_error_new(I64{7}, I64{0}, I64{0})
    }
    rt_text_store(wrapping(candidate + VAULT_WRITE_USER), user)
    rt_text_store(wrapping(candidate + VAULT_WRITE_SESSION), session)
    rt_text_bytes_copy(wrapping(candidate + VAULT_WRITE_DEADLINE), wrapping(plan + VAULT_PLAN_DEADLINE), I64{16})
    write: jet_rt_alloc(VAULT_WRITE_BYTES, I64{8})
    rt_text_bytes_copy(write, candidate, VAULT_WRITE_BYTES)
    rt_text_store(out, write)
    thread_zero(scratch, I64{1632})
    jet_rt_free(scratch, I64{1632}, I64{8})
    I64{0}
}

// The active reason is empty/zero; all inactive reasons use one
// domain-separated algorithm, including the literal rotation.
vault_reason_hash_bytes: fn(status: I64, data: I64, length: I64, out: I64, scratch: I64) {
    prefix: wrapping(scratch + I64{4096})
    rt_text_store(prefix, I64{8391085931256108618})
    rt_text_store(wrapping(prefix + I64{8}), I64{7018141078028383329})
    rt_text_store(wrapping(prefix + I64{16}), I64{7237491})
    rt_text_put(wrapping(prefix + I64{19}), status)
    vault_put_u16(wrapping(prefix + I64{20}), length)
    rt_sha256_parts(prefix, I64{22}, data, length, out, scratch)
    thread_zero(prefix, I64{24})
}
vault_reason_hash: fn(status: I64, reason: I64, out: I64, scratch: I64) -> I64 {
    if (status == I64{1}) {
        if (rt_text_len(reason) != I64{0}) -> return vault_error_new(I64{8}, I64{0}, I64{0})
        thread_zero(out, I64{32})
        return I64{0}
    }
    if !vault_validate_text(reason, true) -> return vault_error_new(I64{0}, I64{0}, I64{0})
    vault_reason_hash_bytes(status, rt_text_data(reason), rt_text_len(reason), out, scratch)
    I64{0}
}
// Seed2550-2719. The final 208 bytes of scratch hold owners/output slots;
// the first8192 are exclusively crypto scratch and can be wiped by hashing.
vault_commit_inner: fn(root: I64, plan: I64, write: I64, expected: I64, key_type: I64, scratch: I64) -> I64 {
    now: jet_time_raw_host_monotonic_ns()
    user: trap_syscall(I64{107}, I64{0}, I64{0}, I64{0}, I64{0}, I64{0}, I64{0})
    session: trap_syscall(I64{124}, I64{0}, I64{0}, I64{0}, I64{0}, I64{0}, I64{0})
    if (session < I64{0}) -> return vault_error_new(I64{7}, I64{0}, I64{0})
    issued: rt_text_word(wrapping(plan + VAULT_PLAN_ISSUED))
    if (rt_text_word(wrapping(plan + VAULT_PLAN_ACTION)) != expected
        || now > rt_text_word(wrapping(plan + VAULT_PLAN_DEADLINE))
        || (now > issued && now - issued > I64{300000000000})
        || now > rt_text_word(wrapping(write + VAULT_WRITE_DEADLINE))
        || !rt_text_equal_bytes(wrapping(write + VAULT_WRITE_OPERATION), wrapping(plan + VAULT_PLAN_OPERATION), I64{32})
        || vault_bytes_zero(wrapping(write + VAULT_WRITE_PREVIEW), I64{32})
        || rt_text_word(wrapping(write + VAULT_WRITE_USER)) != user
        || rt_text_word(wrapping(write + VAULT_WRITE_SESSION)) != session) -> return vault_error_new(I64{6}, I64{0}, I64{0})
    lock_slot: wrapping(scratch + I64{8200})
    lock_error: vault_acquire_lock(root, wrapping(plan + VAULT_PLAN_UUID), rt_text_word(wrapping(plan + VAULT_PLAN_REVISION)), wrapping(plan + VAULT_PLAN_START_HASH), lock_slot)
    if (lock_error != I64{0}) -> return lock_error
    read_error: vault_read_at_root(root, wrapping(scratch + I64{8192}), wrapping(scratch + I64{8232}), wrapping(scratch + I64{8264}), wrapping(scratch + I64{8296}))
    if (read_error != I64{0}) -> return read_error
    store: rt_text_word(wrapping(scratch + I64{8192}))
    kind: rt_text_word(wrapping(scratch + I64{8296}))
    if (kind != rt_text_word(wrapping(plan + VAULT_PLAN_KIND))
        || !rt_text_equal_bytes(wrapping(scratch + I64{8232}), wrapping(plan + VAULT_PLAN_START_HASH), I64{32})
        || !rt_text_equal_bytes(wrapping(scratch + I64{8264}), wrapping(plan + VAULT_PLAN_PROVIDER), I64{32})) -> return vault_error_new(I64{6}, I64{0}, I64{0})
    if (kind == VAULT_START_V2) {
        if (!rt_text_equal_bytes(wrapping(store + VAULT_STORE_UUID), wrapping(plan + VAULT_PLAN_UUID), I64{16})
            || rt_text_word(wrapping(store + VAULT_STORE_REVISION)) != rt_text_word(wrapping(plan + VAULT_PLAN_REVISION))) -> return vault_error_new(I64{6}, I64{0}, I64{0})
    } else {
        if (!vault_bytes_zero(wrapping(store + VAULT_STORE_UUID), I64{16})
            || rt_text_word(wrapping(store + VAULT_STORE_REVISION)) != I64{0}
            || rt_text_word(wrapping(plan + VAULT_PLAN_REVISION)) != I64{0}) -> return vault_error_new(I64{6}, I64{0}, I64{0})
        rt_text_bytes_copy(wrapping(store + VAULT_STORE_UUID), wrapping(plan + VAULT_PLAN_UUID), I64{16})
    }
    records: rt_text_word(wrapping(store + VAULT_STORE_RECORDS))
    length: rt_text_word(wrapping(records + DATA_SEQUENCE_LENGTH))
    data: rt_text_word(wrapping(records + DATA_SEQUENCE_DATA))
    name: rt_text_word(wrapping(plan + VAULT_PLAN_NAME))
    at := I64{0}
    loop at < length {
        record: rt_text_word(wrapping(data + at * DYN_ELEMENT_BYTES))
        if (jet_rt_string_eq(rt_text_word(wrapping(record + VAULT_RECORD_NAME)), name)
            && rt_text_word(wrapping(record + VAULT_RECORD_TYPE)) == key_type
            && rt_text_word(wrapping(record + VAULT_RECORD_STATUS)) == I64{1}) {
            rt_text_store(wrapping(scratch + I64{8208}), vault_ref(store, record))
            break
        }
        at += I64{1}
    }
    time_error: vault_lifecycle_unix_ms(store, wrapping(scratch + I64{8368}))
    if (time_error != I64{0}) -> return time_error
    unix_ms: rt_text_word(wrapping(scratch + I64{8368}))
    action: rt_text_word(wrapping(plan + VAULT_PLAN_ACTION))
    if (action == I64{1} || action == I64{2} || action == I64{3} || action == I64{6}) {
        if (action == I64{3}) {
            at = I64{0}
            loop at < length {
                record: rt_text_word(wrapping(data + at * DYN_ELEMENT_BYTES))
                if (jet_rt_string_eq(rt_text_word(wrapping(record + VAULT_RECORD_NAME)), name)
                    && rt_text_word(wrapping(record + VAULT_RECORD_TYPE)) == key_type
                    && rt_text_word(wrapping(record + VAULT_RECORD_STATUS)) == I64{1}) {
                    rt_text_store(wrapping(record + VAULT_RECORD_STATUS), I64{2})
                    rt_text_store(wrapping(record + VAULT_RECORD_STATUS_MS), unix_ms)
                    rt_text_store(wrapping(scratch + I64{4232}), I64{28259048196697970})
                    vault_reason_hash_bytes(I64{2}, wrapping(scratch + I64{4232}), I64{7}, wrapping(record + VAULT_RECORD_REASON_HASH), scratch)
                }
                at += I64{1}
            }
        }
        bytes := rt_text_word(wrapping(plan + VAULT_PLAN_IMPORTED))
        if (bytes != I64{0}) {
            rt_text_store(wrapping(plan + VAULT_PLAN_IMPORTED), I64{0})
            if (rt_text_word(wrapping(bytes + DATA_SEQUENCE_LENGTH)) != I64{32}) {
                vault_imported_drop(bytes)
                return vault_error_new(I64{8}, I64{0}, I64{0})
            }
        } else {
            bytes = data_sequence_new(I64{32}, RT_HOST_U8_STRIDE)
            rt_text_store(wrapping(bytes + DATA_SEQUENCE_LENGTH), I64{32})
            if (rt_crypto_entropy_fill(rt_text_word(wrapping(bytes + DATA_SEQUENCE_DATA)), I64{32}) != I64{0}) {
                vault_imported_drop(bytes)
                return vault_error_new(I64{10}, VAULT_CRYPTO_UNAVAILABLE, I64{0})
            }
        }
        secret: jet_rt_secret_from_bytes(bytes)
        jet_rt_free(bytes, DATA_SEQUENCE_BYTES, I64{8})
        rt_text_store(wrapping(scratch + I64{8224}), secret)
        if !vault_public_hash(key_type, secret, wrapping(scratch + I64{8304}), scratch) -> return vault_error_new(I64{8}, I64{0}, I64{0})
        key: jet_rt_secret_bytes(secret)
        vault_key_digest_bytes(key_type, rt_text_word(wrapping(key + DATA_SEQUENCE_DATA)), I64{32}, wrapping(scratch + I64{8336}), scratch)
        if (action != I64{1} && action != I64{3}
            && (!rt_text_equal_bytes(wrapping(scratch + I64{8304}), wrapping(plan + VAULT_PLAN_PUBLIC_HASH), I64{32})
                || !rt_text_equal_bytes(wrapping(scratch + I64{8336}), wrapping(plan + VAULT_PLAN_KEY_DIGEST), I64{32}))) -> return vault_error_new(I64{6}, I64{0}, I64{0})
        maximum := I64{0}
        at = I64{0}
        loop at < length {
            record: rt_text_word(wrapping(data + at * DYN_ELEMENT_BYTES))
            if (jet_rt_string_eq(rt_text_word(wrapping(record + VAULT_RECORD_NAME)), name) && rt_text_word(wrapping(record + VAULT_RECORD_TYPE)) == key_type) {
                generation: rt_text_word(wrapping(record + VAULT_RECORD_GENERATION))
                if vault_unsigned_less(maximum, generation) -> maximum = generation
            }
            at += I64{1}
        }
        if (maximum == I64{-1}) -> return vault_incident(I64{7306858898491007350}, I64{7957695015158965614}, I64{16}, scratch)
        generation: wrapping(maximum + I64{1})
        if (generation != rt_text_word(wrapping(plan + VAULT_PLAN_TO))) -> return vault_error_new(I64{6}, I64{0}, I64{0})
        opaque: wrapping(scratch + I64{8376})
        if (rt_crypto_entropy_fill(opaque, I64{16}) != I64{0}) -> return vault_error_new(I64{10}, VAULT_CRYPTO_UNAVAILABLE, I64{0})
        if vault_bytes_zero(opaque, I64{16}) -> return vault_incident(I64{7312206923048509814}, I64{431261314930}, I64{13}, scratch)
        provenance: if (action == I64{1} || action == I64{3}) -> I64{1} else -> I64{2}
        record: vault_record_allocate(name, key_type, generation, I64{1}, provenance, secret)
        rt_text_store(wrapping(scratch + I64{8224}), I64{0})
        rt_text_store(wrapping(scratch + I64{8392}), record)
        rt_text_bytes_copy(wrapping(record + VAULT_RECORD_OPAQUE), opaque, I64{16})
        rt_text_store(wrapping(record + VAULT_RECORD_CREATED), unix_ms)
        rt_text_store(wrapping(record + VAULT_RECORD_STATUS_MS), unix_ms)
        rt_text_bytes_copy(wrapping(record + VAULT_RECORD_PUBLIC_HASH), wrapping(scratch + I64{8304}), I64{32})
        vault_record_hash(record, wrapping(record + VAULT_RECORD_HASH), scratch)
        rt_text_store(wrapping(scratch + I64{8216}), vault_ref(store, record))
        slot: data_sequence_reserve(records, DYN_ELEMENT_BYTES)
        rt_text_store(slot, record)
        rt_text_store(wrapping(records + DATA_SEQUENCE_LENGTH), length + I64{1})
        rt_text_store(wrapping(scratch + I64{8392}), I64{0})
    } else {
        target: rt_text_word(wrapping(plan + VAULT_PLAN_TARGET))
        if (target == I64{0}) -> return vault_error_new(I64{1}, I64{0}, I64{0})
        found := I64{0}
        at = I64{0}
        loop at < length {
            record: rt_text_word(wrapping(data + at * DYN_ELEMENT_BYTES))
            if vault_ref_matches(record, target) {
                found = record
                break
            }
            at += I64{1}
        }
        if (found == I64{0}) -> return vault_error_new(I64{1}, I64{0}, I64{0})
        if (rt_text_word(wrapping(found + VAULT_RECORD_TYPE)) != key_type) -> return vault_error_new(I64{2}, I64{0}, I64{0})
        if (rt_text_word(wrapping(found + VAULT_RECORD_STATUS)) == I64{3}) -> return vault_error_new(I64{3}, I64{0}, I64{0})
        status: if (action == I64{4}) -> I64{2} else -> I64{3}
        rt_text_store(wrapping(found + VAULT_RECORD_STATUS), status)
        rt_text_store(wrapping(found + VAULT_RECORD_STATUS_MS), unix_ms)
        reason_error: vault_reason_hash(status, rt_text_word(wrapping(plan + VAULT_PLAN_REASON)), wrapping(found + VAULT_RECORD_REASON_HASH), scratch)
        if (reason_error != I64{0}) -> return reason_error
    }
    revision: rt_text_word(wrapping(store + VAULT_STORE_REVISION))
    if (revision == I64{-1}) -> return vault_incident(I64{7309955123234824566}, I64{121424789596534}, I64{14}, scratch)
    rt_text_store(wrapping(store + VAULT_STORE_REVISION), wrapping(revision + I64{1}))
    lock: rt_text_word(lock_slot)
    rt_text_store(lock_slot, I64{0})
    vault_write_at_root(root, store, wrapping(plan + VAULT_PLAN_START_HASH), wrapping(plan + VAULT_PLAN_PROVIDER), rt_text_word(wrapping(plan + VAULT_PLAN_KIND)), rt_text_word(wrapping(plan + VAULT_PLAN_REVISION)), lock)
}
// Consume both authority objects, including on pre-filesystem conflict.
// Only success transfers the independently owned previous/current references.
vault_commit_at_root: fn(root: I64, plan: I64, write: I64, expected: I64, key_type: I64, previous_out: I64, current_out: I64) -> I64 {
    scratch: jet_rt_alloc(I64{8400}, I64{8})
    thread_zero(scratch, I64{8400})
    error: vault_commit_inner(root, plan, write, expected, key_type, scratch)
    previous: rt_text_word(wrapping(scratch + I64{8208}))
    current: rt_text_word(wrapping(scratch + I64{8216}))
    if (error == I64{0}) {
        rt_text_store(previous_out, previous)
        rt_text_store(current_out, current)
    } else {
        vault_ref_drop(current)
        vault_ref_drop(previous)
    }
    vault_record_drop(rt_text_word(wrapping(scratch + I64{8392})))
    secret: rt_text_word(wrapping(scratch + I64{8224}))
    if (secret != I64{0}) -> jet_rt_secret_drop(secret)
    vault_store_drop(rt_text_word(wrapping(scratch + I64{8192})))
    vault_lock_drop(rt_text_word(wrapping(scratch + I64{8200})))
    vault_write_drop(write)
    vault_plan_drop(plan)
    thread_zero(scratch, I64{8400})
    jet_rt_free(scratch, I64{8400}, I64{8})
    error
}
