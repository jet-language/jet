    }
    rt_text_bytes_copy(plan + VAULT_PLAN_UUID, store + VAULT_STORE_UUID, I64{16})
    rt_text_store(plan + VAULT_PLAN_REVISION, rt_text_word(store + VAULT_STORE_REVISION))
    records :: rt_text_word(store + VAULT_STORE_RECORDS)
    data :: rt_text_word(records + DATA_SEQUENCE_DATA)
    count :: rt_text_word(records + DATA_SEQUENCE_LENGTH)
    any_name := false
    active := I64{0}
    maximum := I64{0}
    at := I64{0}
    loop at < count {
        record :: rt_text_word(data + at * DATA_TREE_ELEMENT_BYTES)
        if jet_rt_string_eq(rt_text_word(record + VAULT_RECORD_NAME), name) {
            if (rt_text_word(record + VAULT_RECORD_TYPE) != key_type) -> return vault_error_new(I64{2}, I64{0}, I64{0})
            any_name = true
            if (active == I64{0} && rt_text_word(record + VAULT_RECORD_STATUS) == I64{1}) -> active = record
            generation :: rt_text_word(record + VAULT_RECORD_GENERATION)
            if vault_unsigned_less(maximum, generation) -> maximum = generation
        }
        at += I64{1}
    }
    if (action == I64{1} && any_name) -> return vault_error_new(I64{6}, I64{0}, I64{0})
    if ((action == I64{2} || action == I64{6}) && active != I64{0}) -> return vault_error_new(I64{6}, I64{0}, I64{0})
    if (action == I64{3} && active == I64{0}) -> return vault_error_new(I64{1}, I64{0}, I64{0})
    if (action == I64{4} || action == I64{5}) {
        if (target == I64{0}) -> return vault_error_new(I64{1}, I64{0}, I64{0})
        found :: vault_find(store, target, key_type, scratch + I64{8488})
        if (found != I64{0}) -> return found
        record :: rt_text_word(scratch + I64{8488})
        status :: rt_text_word(record + VAULT_RECORD_STATUS)
        if (action == I64{4} && status != I64{1}) -> return vault_error_new(if (status == I64{3}) -> I64{3} else -> I64{6}, I64{0}, I64{0})
        if (action == I64{5} && status == I64{3}) -> return vault_error_new(I64{3}, I64{0}, I64{0})
    }
    if (imported != I64{0}) {
        key :: rt_text_word(imported + DATA_SEQUENCE_DATA)
        key_length :: rt_text_word(imported + DATA_SEQUENCE_LENGTH)
        if !vault_public_hash_bytes(key_type, key, key_length, plan + VAULT_PLAN_PUBLIC_HASH, scratch) -> return vault_error_new(I64{8}, I64{0}, I64{0})
        vault_key_digest_bytes(key_type, key, key_length, plan + VAULT_PLAN_KEY_DIGEST, scratch)
    }
    if (maximum == I64{-1}) -> return vault_incident(I64{7306858898491007350}, I64{7957695015158965614}, I64{16}, scratch)
    next :: wrapping(maximum + I64{1})
    if (action == I64{3}) {
        rt_text_store(plan + VAULT_PLAN_FROM, rt_text_word(active + VAULT_RECORD_GENERATION))
        rt_text_store(plan + VAULT_PLAN_TO, next)
    } else if (action == I64{4} || action == I64{5}) {
        rt_text_store(plan + VAULT_PLAN_FROM, rt_text_word(target + VAULT_REF_GENERATION))
    } else {
        rt_text_store(plan + VAULT_PLAN_TO, next)
    }
    vault_plan_operation(plan, key_type, scratch + I64{576}, scratch)
    vault_instant_now(plan + VAULT_PLAN_ISSUED)
    issued :: rt_text_word(plan + VAULT_PLAN_ISSUED)
    if (issued > I64{9223371736854775807}) -> return vault_error_new(I64{7}, I64{0}, I64{0})
    rt_text_store(plan + VAULT_PLAN_DEADLINE, issued + I64{300000000000})
