    vault_put_u64(buffer + at + I64{8}, rt_text_word(plan + VAULT_PLAN_TO))
    vault_put_u16(buffer + at + I64{16}, rt_text_len(lifecycle_reason))
    at += I64{18}
    rt_text_bytes_copy(buffer + at, rt_text_data(lifecycle_reason), rt_text_len(lifecycle_reason))
    at += rt_text_len(lifecycle_reason)
    vault_put_u16(buffer + at, rt_text_len(reason))
    at += I64{2}
    rt_text_bytes_copy(buffer + at, rt_text_data(reason), rt_text_len(reason))
    at += rt_text_len(reason)
