        rt_text_equal_bytes(left + VAULT_REF_UUID, right + VAULT_REF_UUID, I64{16}) &&
        jet_rt_string_eq(rt_text_word(left + VAULT_REF_NAME), rt_text_word(right + VAULT_REF_NAME)) &&
        rt_text_word(left + VAULT_REF_GENERATION) == rt_text_word(right + VAULT_REF_GENERATION) &&
        rt_text_equal_bytes(left + VAULT_REF_OPAQUE, right + VAULT_REF_OPAQUE, I64{16}) &&
        rt_text_equal_bytes(left + VAULT_REF_HASH, right + VAULT_REF_HASH, I64{32})
