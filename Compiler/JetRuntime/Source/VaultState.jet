    if !vault_wall_unix_ms(plan + VAULT_PLAN_EXPIRES, scratch) -> return vault_error_new(I64{7}, I64{0}, I64{0})
    wall :: rt_text_word(plan + VAULT_PLAN_EXPIRES)
    if vault_unsigned_less(I64{-300001}, wall) -> return vault_error_new(I64{7}, I64{0}, I64{0})
    rt_text_store(plan + VAULT_PLAN_EXPIRES, wrapping(wall + I64{300000}))
    result :: jet_rt_alloc(VAULT_PLAN_BYTES, I64{8})
    rt_text_bytes_copy(result, plan, VAULT_PLAN_BYTES)
    rt_text_store(result + VAULT_PLAN_NAME, jet_rt_string_clone(name))
    rt_text_store(out, result)
