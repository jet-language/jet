// Adopts target/imported/reason, exactly once, whether preparation succeeds or
// fails. Name is borrowed. Final plan allocation follows all seed checks.
fn vault_prepare_at_root(root: I64, name: I64, key_type: I64, action: I64, target: I64, imported: I64, reason: I64, out: I64) -> I64 {
    error := I64{0}
    if !vault_validate_text(name, false) {
        error = vault_error_new(I64{0}, I64{0}, I64{0})
    } else if ((action == I64{3} || action == I64{4} || action == I64{5}) && !vault_validate_text(reason, true)) {
        error = vault_error_new(I64{0}, I64{0}, I64{0})
    } else {
        scratch :: jet_rt_alloc(I64{8512}, I64{8})
        thread_zero(scratch + I64{8192}, I64{320})
        error = vault_prepare_inner(root, name, key_type, action, target, imported, reason, out, scratch)
        vault_store_drop(rt_text_word(scratch + I64{8480}))
        thread_zero(scratch, I64{8512})
        jet_rt_free(scratch, I64{8512}, I64{8})
    }
    if (error != I64{0}) {
        vault_ref_drop(target)
        vault_imported_drop(imported)
        jet_rt_string_drop(reason)
    }
    error
}

// fb3361756's ONE shared host monotonic provider, never a second raw clock.
#Import(c) fn vault_host_monotonic_ns() -> I64 = "jet_time_raw_host_monotonic_ns"
// The 1:1 seed Instant slot keeps its position; only ordering/deadline semantics
// are observable. Native stores ns in word0 and zero in the reserved word1.
fn vault_instant_now(out: I64) {
    rt_text_store(out, vault_host_monotonic_ns())
    rt_text_store(out + I64{8}, I64{0})
}

