                    rt_text_store(record + VAULT_RECORD_STATUS_MS, unix_ms)
                    rt_text_store(scratch + I64{4232}, I64{28259048196697970})
                    vault_reason_hash_bytes(I64{2}, scratch + I64{4232}, I64{7}, record + VAULT_RECORD_REASON_HASH, scratch)
                }
                at += I64{1}
            }
        }
        bytes := rt_text_word(plan + VAULT_PLAN_IMPORTED)
        if (bytes != I64{0}) {
            rt_text_store(plan + VAULT_PLAN_IMPORTED, I64{0})
            if (rt_text_word(bytes + DATA_SEQUENCE_LENGTH) != I64{32}) {
                vault_imported_drop(bytes)
                return vault_error_new(I64{8}, I64{0}, I64{0})
            }
        } else {
            bytes = data_sequence_new(I64{32}, RT_HOST_U8_STRIDE)
            rt_text_store(bytes + DATA_SEQUENCE_LENGTH, I64{32})
            if (rt_crypto_entropy_fill(rt_text_word(bytes + DATA_SEQUENCE_DATA), I64{32}) != I64{0}) {
                vault_imported_drop(bytes)
                return vault_error_new(I64{10}, VAULT_CRYPTO_UNAVAILABLE, I64{0})
            }
        }
        secret :: vault_secret_adopt(bytes)
        jet_rt_free(bytes, DATA_SEQUENCE_BYTES, I64{8})
        rt_text_store(scratch + I64{8224}, secret)
        if !vault_public_hash(key_type, secret, scratch + I64{8304}, scratch) -> return vault_error_new(I64{8}, I64{0}, I64{0})
        key :: vault_secret_bytes(secret)
        vault_key_digest_bytes(key_type, rt_text_word(key + DATA_SEQUENCE_DATA), I64{32}, scratch + I64{8336}, scratch)
        if (action != I64{1} && action != I64{3}
            && (!rt_text_equal_bytes(scratch + I64{8304}, plan + VAULT_PLAN_PUBLIC_HASH, I64{32})
                || !rt_text_equal_bytes(scratch + I64{8336}, plan + VAULT_PLAN_KEY_DIGEST, I64{32}))) -> return vault_error_new(I64{6}, I64{0}, I64{0})
        maximum := I64{0}
        at = I64{0}
        loop at < length {
            record :: rt_text_word(data + at * DATA_TREE_ELEMENT_BYTES)
            if (jet_rt_string_eq(rt_text_word(record + VAULT_RECORD_NAME), name) && rt_text_word(record + VAULT_RECORD_TYPE) == key_type) {
                generation :: rt_text_word(record + VAULT_RECORD_GENERATION)
                if vault_unsigned_less(maximum, generation) -> maximum = generation
            }
            at += I64{1}
        }
        if (maximum == I64{-1}) -> return vault_incident(I64{7306858898491007350}, I64{7957695015158965614}, I64{16}, scratch)
        generation :: wrapping(maximum + I64{1})
        if (generation != rt_text_word(plan + VAULT_PLAN_TO)) -> return vault_error_new(I64{6}, I64{0}, I64{0})
        opaque :: scratch + I64{8376}
        if (rt_crypto_entropy_fill(opaque, I64{16}) != I64{0}) -> return vault_error_new(I64{10}, VAULT_CRYPTO_UNAVAILABLE, I64{0})
        if vault_bytes_zero(opaque, I64{16}) -> return vault_incident(I64{7312206923048509814}, I64{431261314930}, I64{13}, scratch)
        provenance :: if (action == I64{1} || action == I64{3}) -> I64{1} else -> I64{2}
        record :: vault_record_allocate(name, key_type, generation, I64{1}, provenance, secret)
        rt_text_store(scratch + I64{8224}, I64{0})
        rt_text_store(scratch + I64{8392}, record)
        rt_text_bytes_copy(record + VAULT_RECORD_OPAQUE, opaque, I64{16})
        rt_text_store(record + VAULT_RECORD_CREATED, unix_ms)
        rt_text_store(record + VAULT_RECORD_STATUS_MS, unix_ms)
        rt_text_bytes_copy(record + VAULT_RECORD_PUBLIC_HASH, scratch + I64{8304}, I64{32})
        vault_record_hash(record, record + VAULT_RECORD_HASH, scratch)
        rt_text_store(scratch + I64{8216}, vault_ref(store, record))
        slot :: data_sequence_reserve(records, DATA_TREE_ELEMENT_BYTES)
        rt_text_store(slot, record)
        rt_text_store(records + DATA_SEQUENCE_LENGTH, length + I64{1})
        rt_text_store(scratch + I64{8392}, I64{0})
    } else {
        target :: rt_text_word(plan + VAULT_PLAN_TARGET)
        if (target == I64{0}) -> return vault_error_new(I64{1}, I64{0}, I64{0})
        found := I64{0}
        at = I64{0}
        loop at < length {
            record :: rt_text_word(data + at * DATA_TREE_ELEMENT_BYTES)
            if vault_ref_matches(record, target) {
                found = record
                break
            }
            at += I64{1}
        }
        if (found == I64{0}) -> return vault_error_new(I64{1}, I64{0}, I64{0})
        if (rt_text_word(found + VAULT_RECORD_TYPE) != key_type) -> return vault_error_new(I64{2}, I64{0}, I64{0})
        if (rt_text_word(found + VAULT_RECORD_STATUS) == I64{3}) -> return vault_error_new(I64{3}, I64{0}, I64{0})
        status :: if (action == I64{4}) -> I64{2} else -> I64{3}
        rt_text_store(found + VAULT_RECORD_STATUS, status)
        rt_text_store(found + VAULT_RECORD_STATUS_MS, unix_ms)
        reason_error :: vault_reason_hash(status, rt_text_word(plan + VAULT_PLAN_REASON), found + VAULT_RECORD_REASON_HASH, scratch)
        if (reason_error != I64{0}) -> return reason_error
    }
    revision :: rt_text_word(store + VAULT_STORE_REVISION)
    if (revision == I64{-1}) -> return vault_incident(I64{7309955123234824566}, I64{121424789596534}, I64{14}, scratch)
    rt_text_store(store + VAULT_STORE_REVISION, wrapping(revision + I64{1}))
    lock :: rt_text_word(lock_slot)
    rt_text_store(lock_slot, I64{0})
    vault_write_at_root(root, store, plan + VAULT_PLAN_START_HASH, plan + VAULT_PLAN_PROVIDER, rt_text_word(plan + VAULT_PLAN_KIND), rt_text_word(plan + VAULT_PLAN_REVISION), lock)
}
// Consume both authority objects, including on pre-filesystem conflict.
// Only success transfers the independently owned previous/current references.
fn vault_commit_at_root(root: I64, plan: I64, write: I64, expected: I64, key_type: I64, previous_out: I64, current_out: I64) -> I64 {
    scratch :: jet_rt_alloc(I64{8400}, I64{8})
    thread_zero(scratch, I64{8400})
    error :: vault_commit_inner(root, plan, write, expected, key_type, scratch)
    previous :: rt_text_word(scratch + I64{8208})
    current :: rt_text_word(scratch + I64{8216})
    if (error == I64{0}) {
        rt_text_store(previous_out, previous)
        rt_text_store(current_out, current)
    } else {
        vault_ref_drop(current)
        vault_ref_drop(previous)
    }
    vault_record_drop(rt_text_word(scratch + I64{8392}))
    secret :: rt_text_word(scratch + I64{8224})
    if (secret != I64{0}) -> vault_secret_drop(secret)
    vault_store_drop(rt_text_word(scratch + I64{8192}))
    vault_lock_drop(rt_text_word(scratch + I64{8200}))
    vault_write_drop(write)
    vault_plan_drop(plan)
    thread_zero(scratch, I64{8400})
    jet_rt_free(scratch, I64{8400}, I64{8})
    error
}
