// HTTPServer.rs:606-612 / frozen seed177302-307: Copy/Clone four i64 fields.
// CAbiRoutes.rs:10594-10619: ctor borrows exact Int inputs and checked-native
// converts all four before allocation; getters return fresh exact Int owners.
HTTP_SHUTDOWN_BYTES :: I64{32}
HTTP_SHUTDOWN_ACCEPTED :: I64{0}
HTTP_SHUTDOWN_OVERLOADED :: I64{8}
HTTP_SHUTDOWN_COMPLETED :: I64{16}
HTTP_SHUTDOWN_CANCELLED :: I64{24}
#Export(c) fn jet_rt_record_new_jet_http_shutdown_report(accepted: I64, overloaded: I64, completed: I64, cancelled: I64) -> I64 {
    raw_accepted :: jet_int_owned_to_i64(accepted)
    raw_overloaded :: jet_int_owned_to_i64(overloaded)
    raw_completed :: jet_int_owned_to_i64(completed)
    raw_cancelled :: jet_int_owned_to_i64(cancelled)
    result :: jet_rt_alloc(HTTP_SHUTDOWN_BYTES, I64{8})
    encoding_store(result + HTTP_SHUTDOWN_ACCEPTED, raw_accepted)
    encoding_store(result + HTTP_SHUTDOWN_OVERLOADED, raw_overloaded)
    encoding_store(result + HTTP_SHUTDOWN_COMPLETED, raw_completed)
    encoding_store(result + HTTP_SHUTDOWN_CANCELLED, raw_cancelled)
    result
}
#Export(c) fn jet_rt_handle_clone_jet_http_shutdown_report(value: I64) -> I64 {
    result :: jet_rt_alloc(HTTP_SHUTDOWN_BYTES, I64{8})
    coll_copy(value, result, HTTP_SHUTDOWN_BYTES)
    result
}
#Export(c) fn jet_rt_handle_drop_jet_http_shutdown_report(value: I64) {
    if (value != I64{0}) -> jet_rt_free(value, HTTP_SHUTDOWN_BYTES, I64{8})
}
#Export(c) fn jet_rt_record_get_jet_http_shutdown_report_user_accepted(value: I64) -> I64 { jet_int_owned_from_i64(encoding_word(value + HTTP_SHUTDOWN_ACCEPTED)) }
#Export(c) fn jet_rt_record_get_jet_http_shutdown_report_user_overloaded(value: I64) -> I64 { jet_int_owned_from_i64(encoding_word(value + HTTP_SHUTDOWN_OVERLOADED)) }
#Export(c) fn jet_rt_record_get_jet_http_shutdown_report_user_completed(value: I64) -> I64 { jet_int_owned_from_i64(encoding_word(value + HTTP_SHUTDOWN_COMPLETED)) }
#Export(c) fn jet_rt_record_get_jet_http_shutdown_report_user_cancelled(value: I64) -> I64 { jet_int_owned_from_i64(encoding_word(value + HTTP_SHUTDOWN_CANCELLED)) }
