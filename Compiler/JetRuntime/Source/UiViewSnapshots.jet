// WebVirtual.rs292-309 VirtualPlan.
// A private data snapshot only, not a signal-backed viewport resource.
fn ui_virtual_measurements_clone(value: I64) -> I64 {
    length :: ui_carrier_word(wrapping(value + DATA_SEQUENCE_LENGTH))
    result :: data_sequence_new(length, UI_VIRTUAL_PAIR_BYTES)
    source :: ui_carrier_word(wrapping(value + DATA_SEQUENCE_DATA))
    target :: ui_carrier_word(wrapping(result + DATA_SEQUENCE_DATA))
    at := I64{0}
    loop at < length {
        offset :: at * UI_VIRTUAL_PAIR_BYTES
        ui_carrier_store(wrapping(target + offset), ui_carrier_word(wrapping(source + offset)))
        ui_carrier_store(wrapping(wrapping(target + offset) + UI_VIRTUAL_WORD_BYTES), ui_carrier_word(wrapping(wrapping(source + offset) + UI_VIRTUAL_WORD_BYTES)))
        at += I64{1}
    }
    ui_carrier_store(wrapping(result + DATA_SEQUENCE_LENGTH), length)
    result
}
fn ui_virtual_measurements_drop(value: I64) {
    capacity :: ui_carrier_word(wrapping(value + DATA_SEQUENCE_CAPACITY))
    if (capacity != I64{0}) -> jet_rt_free(ui_carrier_word(wrapping(value + DATA_SEQUENCE_DATA)), capacity * UI_VIRTUAL_PAIR_BYTES, I64{8})
    jet_rt_free(value, DATA_SEQUENCE_BYTES, I64{8})
}
#Export(c) fn jet_rt_handle_clone_jet_web_virtual_plan(value: I64) -> I64 {
    result :: jet_rt_alloc(UI_VIRTUAL_BYTES, I64{8})
    offset := I64{0}
    loop offset < UI_VIRTUAL_MEASUREMENTS {
        ui_carrier_store(wrapping(result + offset), ui_carrier_word(wrapping(value + offset)))
        offset += UI_VIRTUAL_WORD_BYTES
    }
    ui_carrier_store(wrapping(result + UI_VIRTUAL_MEASUREMENTS), ui_virtual_measurements_clone(ui_carrier_word(wrapping(value + UI_VIRTUAL_MEASUREMENTS))))
    result
}
#Export(c) fn jet_rt_handle_drop_jet_web_virtual_plan(value: I64) {
    if (value == I64{0}) -> return
    ui_virtual_measurements_drop(ui_carrier_word(wrapping(value + UI_VIRTUAL_MEASUREMENTS)))
    jet_rt_free(value, UI_VIRTUAL_BYTES, I64{8})
}
#Export(c) fn jet_rt_handle_eq_jet_web_virtual_plan(a: I64, b: I64) -> Bool {
    offset := I64{0}
    loop offset < UI_VIRTUAL_MEASUREMENTS {
        if (ui_carrier_word(wrapping(a + offset)) != ui_carrier_word(wrapping(b + offset))) -> return false
        offset += UI_VIRTUAL_WORD_BYTES
    }
    ah :: ui_carrier_word(wrapping(a + UI_VIRTUAL_MEASUREMENTS))
    bh :: ui_carrier_word(wrapping(b + UI_VIRTUAL_MEASUREMENTS))
    length :: ui_carrier_word(wrapping(ah + DATA_SEQUENCE_LENGTH))
    if (length != ui_carrier_word(wrapping(bh + DATA_SEQUENCE_LENGTH))) -> return false
    ap :: ui_carrier_word(wrapping(ah + DATA_SEQUENCE_DATA))
    bp :: ui_carrier_word(wrapping(bh + DATA_SEQUENCE_DATA))
    offset = I64{0}
    loop offset < length * UI_VIRTUAL_PAIR_BYTES {
        if (ui_carrier_word(wrapping(ap + offset)) != ui_carrier_word(wrapping(bp + offset))) -> return false
        offset += UI_VIRTUAL_WORD_BYTES
    }
    true
}
