// The runtime's one stdin buffer, and the whole-input read over it.
//
// terminal_input_root is the stdin lock (word 0) and its buffer: +8 the
// TERM_INPUT_CAPACITY-byte buffer, made on the first read; +16 the offset of
// the next unread byte; +24 the end of the buffered bytes. Every stdin reader
// holds the lock and takes the buffered bytes before it reads again, so
// lines, delimiters, chunks, keys and the whole input mixed in any order see
// each byte once. A refill is one read of up to the capacity: a pipe or file
// costs one syscall per 64 KiB rather than per byte, and a terminal or a pipe
// still returns as soon as a line arrives. Before any read of stdin, pending
// stdout is written (jet_rt_stdout_flush): whatever the program printed is
// out before it waits for more input, a prompt on a terminal and a filter's
// lines on a pipe alike, while a pipe-to-pipe copy still writes stdout once
// per buffer.
terminal_input_root := I64{0}
TERM_INPUT_CAPACITY: I64{65536}
// runtime-init: 4 when terminal_input_root
#Export(c) jet_rt_terminal_input_init: fn() {
    if (terminal_input_root != I64{0}) -> return
    root: jet_rt_alloc(I64{32}, I64{8})
    thread_zero(root, I64{32})
    #Unsafe("runtime-init runs before any other thread exists") {
        terminal_input_root = root
    }
}

// Caller holds the stdin lock: the number of buffered unread bytes.
term_input_buffered: fn() -> I64 {
    rt_text_word(wrapping(terminal_input_root + I64{24})) - rt_text_word(wrapping(terminal_input_root + I64{16}))
}

// Caller holds the stdin lock: the address of the next unread byte.
term_input_next: fn() -> I64 {
    rt_text_word(wrapping(terminal_input_root + I64{8})) + rt_text_word(wrapping(terminal_input_root + I64{16}))
}

// Caller holds the stdin lock: marks `count` buffered bytes read.
term_input_consume: fn(count: I64) {
    rt_text_store(wrapping(terminal_input_root + I64{16}), rt_text_word(wrapping(terminal_input_root + I64{16})) + count)
}

// The length of the `count` bytes at `start` through their first LF, or
// `count` when they hold none: the stdin line reader's and the terminal
// stdout's line split. Eight bytes a step: a word holds an LF exactly when
// its xor with 0x0A..0A has a zero byte (the SWAR zero-byte test).
rt_line_run: fn(start: I64, count: I64) -> I64 {
    at := I64{0}
    words: count - count % I64{8}
    loop at < words {
        word: rt_text_word(wrapping(start + at)).bit_xor(I64{723401728380766730})
        if (wrapping(word - I64{72340172838076673}).bit_and(word.bit_xor(I64{-1})).bit_and(I64{-9187201950435737472}) != I64{0}) -> break
        at += I64{8}
    }
    loop at < count {
        if (rt_text_byte(wrapping(start + at)) == I64{10}) -> return at + I64{1}
        at += I64{1}
    }
    count
}

// Caller holds the stdin lock and has used every buffered byte: one read
// refills the buffer. Returns the count read, 0 at end of input, or -errno;
// EINTR is retried when `retry`, and EBADF is end of input when `ebadf_eof`
// (std's stdin handle_ebadf).
term_input_fill: fn(retry: Bool, ebadf_eof: Bool) -> I64 {
    root: terminal_input_root
    buffer := rt_text_word(wrapping(root + I64{8}))
    if (buffer == I64{0}) {
        buffer = jet_rt_alloc(TERM_INPUT_CAPACITY, I64{8})
        rt_text_store(wrapping(root + I64{8}), buffer)
    }
    rt_text_store(wrapping(root + I64{16}), I64{0})
    rt_text_store(wrapping(root + I64{24}), I64{0})
    jet_rt_stdout_flush()
    loop {
        got: rt_prove_stdin_read(buffer, TERM_INPUT_CAPACITY)
        if (got == I64{-4} && retry) -> next
        if (got == I64{-9} && ebadf_eof) -> return I64{0}
        if (got > I64{0}) -> rt_text_store(wrapping(root + I64{24}), got)
        return got
    }
}

// Caller holds the stdin lock: up to `capacity` bytes into `into`, from the
// buffer when it holds any, else from one direct read of stdin (no EINTR
// retry), as read() would return them. The count, 0 at end of input, or
// -errno (EBADF included: each caller maps it as before).
term_input_take: fn(into: I64, capacity: I64) -> I64 {
    buffered: term_input_buffered()
    if (buffered > I64{0}) {
        count: if (buffered < capacity) -> buffered else -> capacity
        rt_text_bytes_copy(into, term_input_next(), count)
        term_input_consume(count)
        return count
    }
    jet_rt_stdout_flush()
    rt_prove_stdin_read(into, capacity)
}

// Locked stdin read_to_string, publishing either owned UTF-8 text or empty text
// plus an owned IO error. Tuple<String, Option<String>>: text, optional-error
// tag and payload slots.
#Export(c) jet_terminal8_read_all: fn(output: I64, error_tag: I64, error: I64) {
    if (jet_scheduler_native_propagate() != I64{0}) -> return
    value: jet_rt_string_builder_new()
    failure := I64{0}
    sync_mutex_lock(terminal_input_root)
    loop {
        buffered: term_input_buffered()
        if (buffered > I64{0}) {
            rt_text_append(value, term_input_next(), buffered)
            term_input_consume(buffered)
        }
        got: term_input_fill(true, false)
        if (got == I64{0}) -> break
        if (got < I64{0}) {
            failure = host_errno_cause(-got)
            break
        }
    }
    sync_mutex_unlock(terminal_input_root)
    invalid: text_bytes_utf8_error(rt_text_data(value), rt_text_len(value))
    if (invalid != I64{0}) {
        jet_rt_string_drop(invalid)
        if (failure != I64{0}) -> jet_rt_string_drop(failure)
        failure = jet_rt_string_clone(rt_static_text("stream did not contain valid UTF-8"))
    }
    if (failure != I64{0}) {
        jet_rt_string_drop(value)
        rt_text_store(output, jet_rt_string_builder_new())
        rt_text_store(error_tag, I64{1})
        rt_text_store(error, failure)
    } else {
        rt_text_store(output, value)
        rt_text_store(error_tag, I64{0})
    }
}
