// HTTPClient.rs:16-21 / frozen seed176189-194: one Follow variant.
// Native Redirect16 stores raw signed max and a low-byte Bool word.
HTTP_REDIRECT_BYTES :: comptime { I64{16} }
HTTP_REDIRECT_MAX :: comptime { I64{0} }
HTTP_REDIRECT_SAME_ORIGIN :: comptime { I64{8} }
#Export(c) fn jet_rt_handle_clone_jet_http_redirect_policy(value: I64) -> I64 {
    result :: jet_rt_alloc(HTTP_REDIRECT_BYTES, I64{8})
    encoding_store(result + HTTP_REDIRECT_MAX, encoding_word(value + HTTP_REDIRECT_MAX))
    same_origin :: encoding_word(value + HTTP_REDIRECT_SAME_ORIGIN).bit_and(I64{255})
    encoding_store(result + HTTP_REDIRECT_SAME_ORIGIN, if (same_origin == I64{0}) -> I64{0} else -> I64{1})
    result
}
#Export(c) fn jet_rt_handle_drop_jet_http_redirect_policy(value: I64) {
    if (value != I64{0}) -> jet_rt_free(value, HTTP_REDIRECT_BYTES, I64{8})
}
