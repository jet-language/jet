// Native exact-Int's ONE hazard domain, port. Root16: hazards0, retired8;
// Hazard16: protectedNode0, next8. Hazard records are append-only
// PROCESS-LIFETIME; the TCB word INT_HAZARD_TCB_RECORD holds this thread's
// record, which a fiber borrows from the carrier it runs on
// (int_hazard_lend). Numeric nodes use Int.jet's established immutable
// Node48/limbs ABI. Native arithmetic and carrier sites retire nodes through
// this Jet domain.
int_hazard_root := I64{0}

// The TCB word of this thread's hazard record (Thread.jet's layout).
INT_HAZARD_TCB_RECORD: I64{736}

// Allocator init0 precedes this root. Any code that reads the root keeps this
// guarded hook, whose init-array run precedes all user code/Int spills.
// runtime-init: 4 when int_hazard_root
#Export(c) jet_rt_int_hazard_init: fn() {
    if (int_hazard_root != I64{0}) {
        return
    }
    root: jet_rt_alloc(I64{16}, I64{8})
    #Unsafe("runtime-init runs before any other thread exists") { int_hazard_root = root }
    thread_zero(int_hazard_root, I64{16})
}

#Export(c) jet_rt_int_hazard_enter: fn() -> I64 {
    base: thread_base()
    record := sync_load(wrapping(base + INT_HAZARD_TCB_RECORD))
    if (record != I64{0}) { return record }
    record = jet_rt_alloc(I64{16}, I64{8})
    sync_store(record, I64{0})
    loop {
        head: sync_load(int_hazard_root)
        sync_store(wrapping(record + I64{8}), head)
        if sync_cas(int_hazard_root, head, record) == head -> break
    }
    sync_store(wrapping(base + INT_HAZARD_TCB_RECORD), record)
    record
}

// Hands the hazard record `from`'s TCB holds to `to`'s: a carrier lends its
// record to the fiber it switches to and takes back the one the fiber holds
// when it switches out, so the carrier keeps a record the fiber made. No
// guard spans a switch, so the running TCB alone uses the record.
int_hazard_lend: fn(from: I64, to: I64) {
    sync_store(wrapping(to + INT_HAZARD_TCB_RECORD), sync_load(wrapping(from + INT_HAZARD_TCB_RECORD)))
}

#Export(c) jet_rt_int_hazard_protect: fn(record: I64, node: I64) {
    // SeqCst publication before the atomic word is reloaded/validated.
    _ := sync_swap(record, node)
}

int_hazard_contains: fn(node: I64) -> Bool {
    record := sync_load(int_hazard_root)
    loop record != (I64{0}) {
        if sync_load(record) == node -> return true
        record = sync_load(wrapping(record + I64{8}))
    }
    false
}

int_hazard_push_retired: fn(node: I64) {
    head_slot: wrapping(int_hazard_root + I64{8})
    loop {
        head: sync_load(head_slot)
        int_store(wrapping(node + I64{8}), head)
        if sync_cas(head_slot, head, node) == head {
            return
        }
    }
}

#Export(c) jet_rt_int_hazard_reclaim: fn() {
    cursor := sync_swap(wrapping(int_hazard_root + I64{8}), I64{0})
    loop cursor != (I64{0}) {
        next_node: int_load(wrapping(cursor + I64{8}))
        if int_hazard_contains(cursor) -> int_hazard_push_retired(cursor) else {
            int_free_node(cursor)
        }
        cursor = next_node
    }
}

#Export(c) jet_rt_int_hazard_clear: fn(record: I64) {
    sync_store(record, I64{0})
    // Seed threshold is ANY pending node, not a new batch.
    if (sync_load(wrapping(int_hazard_root + I64{8})) != I64{0}) { jet_rt_int_hazard_reclaim() }
}

#Export(c) jet_rt_int_retire_zero: fn(node: I64) {
    // refs already0 and the publication owner has been removed. A reader
    // publishing after this scan MUST revalidate before any node dereference.
    if int_hazard_contains(node) -> int_hazard_push_retired(node) else -> int_free_node(node)
    if (sync_load(wrapping(int_hazard_root + I64{8})) != I64{0}) { jet_rt_int_hazard_reclaim() }
}

#Export(c) jet_rt_int_hazard_try_retain: fn(node: I64) -> Bool {
    loop {
        refs: int_load(node)
        if (refs == I64{0}) { return false }
        if (refs < I64{0} || refs == I64{9223372036854775807}) {
            jet_rt_unreachable(I64{0}, I64{0})
        }
        if sync_cas(node, refs, refs + I64{1}) == refs -> return true
    }
}

int_hazard_reload: fn(place: I64, callback: I64, context: I64) -> I64 {
    if (callback == I64{0}) { return sync_load(place) }
    // The native numeric forwarder lends a pure reload callback and its live
    // closure context for this synchronous call.
    coll_call_box(callback, context)
}

int_hazard_clone: fn(place: I64, initial: I64, callback: I64, context: I64) -> I64 {
    raw := initial
    record := I64{0}
    loop {
        current: int_hazard_reload(place, callback, context)
        if current != raw -> raw = current
        if int_inline(raw) {
            if (record != I64{0}) { jet_rt_int_hazard_clear(record) }
            return raw
        }
        if (record == I64{0}) { record = jet_rt_int_hazard_enter() }
        jet_rt_int_hazard_protect(record, int_node(raw))
        validated: int_hazard_reload(place, callback, context)
        if validated != raw {
            raw = validated
            jet_rt_int_hazard_clear(record)
            next
        }
        if !jet_rt_int_hazard_try_retain(int_node(raw)) {
            raw = int_hazard_reload(place, callback, context)
            jet_rt_int_hazard_clear(record)
            next
        }
        jet_rt_int_hazard_clear(record)
        return raw
    }
}

#Export(c) jet_rt_int_clone_atomic: fn(place: I64) -> I64 {
    int_hazard_clone(place, sync_load(place), I64{0}, I64{0})
}

#Export(c) jet_rt_int_clone_atomic_reload: fn(initial: I64, callback: I64, context: I64) -> I64 {
    int_hazard_clone(I64{0}, initial, callback, context)
}
