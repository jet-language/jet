// pow, cbrt and hypot, ported from musl 1.2.5 src/math (pow.c from ARM
// optimized-routines; cbrt.c from FreeBSD msun; hypot.c); see Libm.jet for
// the porting conventions. pow's exp step shares exp.c's table
// (LibmExpLog.jet); its log step's table is pow_data.c's {invc, logc,
// logctail} rows as binary64 bit words. x86_64 musl is built without
// __FP_FAST_FMA and without signaling-NaN support, so the port takes
// musl's non-fma branches and issignaling_inline is false.

// pow.c OFF: z is in [OFF, 2*OFF).
LIBM_POW_OFF: I64{4604531861337669632}
// SIGN_BIAS, 0x800 << EXP_TABLE_BITS
LIBM_POW_SIGN_BIAS: I64{262144}
// -1ULL << 27
LIBM_POW_SPLIT: I64{-134217728}

// pow.c specialcase(): as exp.c's, but the scale may be negative.
libm_pow_special: fn(tmp: Float, sbits: I64, ki: I64) -> Float {
    if (ki.bit_and(I64{2147483648}) == I64{0}) {
        // k > 0, the exponent of scale might have overflowed by <= 460.
        scale: rt_f64_from_bits(wrapping(sbits - (I64{1009} << I64{52})))
        return LIBM_P1009 * (scale + scale * tmp)
    }
    // k < 0, need special care in the subnormal range; sbits is signed scale.
    signed: wrapping(sbits + (I64{1022} << I64{52}))
    scale: rt_f64_from_bits(signed)
    y := scale + scale * tmp
    if (libm_fabs(y) < Float{1.0}) {
        // Round y to the right precision before scaling it into the subnormal
        // range to avoid double rounding.
        one: if (y < Float{0.0}) -> Float{-1.0} else -> Float{1.0}
        lo := scale - y + scale * tmp
        hi: one + y
        lo = one - hi + y + lo
        y = (hi + lo) - one
        // Fix the sign of 0.
        if (y == Float{0.0}) -> y = rt_f64_from_bits(signed.bit_and(LIBM_SIGN))
    }
    LIBM_DBL_MIN * y
}

// pow.c exp_inline(): sign*exp(x+xtail) where |xtail| < 2^-8/N and
// |xtail| <= |x|; sign_bias is LIBM_POW_SIGN_BIAS or 0 and sets the sign to
// -1 or 1.
libm_pow_exp: fn(x: Float, xtail: Float, sign_bias: I64) -> Float {
    bits: rt_f64_bits(x)
    abstop := libm_exponent(bits)
    if (abstop < LIBM_EXP_TOP_TINY || abstop >= LIBM_EXP_TOP_HUGE) {
        if (abstop < LIBM_EXP_TOP_TINY) {
            // Avoid spurious underflow for tiny x.
            one: Float{1.0} + x
            return if (sign_bias != I64{0}) -> -one else -> one
        }
        if (abstop >= LIBM_EXP_TOP_OVER) {
            // Note: inf and nan are already handled; __math_uflow and
            // __math_oflow carry the sign.
            magnitude: if (bits < I64{0}) -> I64{0} else -> LIBM_EXP_INF
            return rt_f64_from_bits(if (sign_bias != I64{0}) -> magnitude.bit_or(LIBM_SIGN) else -> magnitude)
        }
        // Large x is special cased below.
        abstop = I64{0}
    }
    // exp(x) = 2^(k/N) * exp(r), with exp(r) in [2^(-1/2N),2^(1/2N)].
    z: LIBM_EXP_INVLN2N * x
    // z - kd is in [-1, 1] in non-nearest rounding modes.
    shifted: z + LIBM_TOINT_HALF
    ki: rt_f64_bits(shifted)
    kd: shifted - LIBM_TOINT_HALF
    r := x + kd * LIBM_EXP_NEGLN2HIN + kd * LIBM_EXP_NEGLN2LON
    // The code assumes 2^-200 < |xtail| < 2^-8/N.
    r = r + xtail
    // 2^(k/N) ~= scale * (1 + tail), from table row k mod N. sign_bias has
    // no low bits, so ki + sign_bias indexes the same row.
    row: Int.from_i64(ki.bit_and(I64{127}) * I64{2})
    tail: rt_f64_from_bits(LIBM_EXP_TABLE[row])
    sbits: wrapping(LIBM_EXP_TABLE[row + 1] + libm_shl(wrapping(ki + sign_bias), I64{45}))
    r2: r * r
    tmp: tail + r + r2 * (Float{0.49999999999996786} + r * Float{0.16666666666665886}) + r2 * r2 * (Float{0.0416666808410674} + r * Float{0.008333335853059549})
    if (abstop == I64{0}) -> return libm_pow_special(tmp, sbits, ki)
    scale: rt_f64_from_bits(sbits)
    scale + scale * tmp
}

// pow.c checkint(): 0 if not int, 1 if odd int, 2 if even int, for the bits
// of a non-zero finite value.
libm_pow_checkint: fn(iy: I64) -> I64 {
    e: libm_exponent(iy)
    if (e < I64{0x3ff}) -> return I64{0}
    if (e > I64{0x3ff} + I64{52}) -> return I64{2}
    unit: I64{1} << (I64{0x3ff} + I64{52} - e)
    if (iy.bit_and(unit - I64{1}) != I64{0}) -> return I64{0}
    if (iy.bit_and(unit) != I64{0}) -> return I64{1}
    I64{2}
}

// pow.c zeroinfnan(): whether i is the bits of 0, infinity or nan.
libm_pow_zeroinfnan: fn(i: I64) -> Bool {
    // 2 * asuint64(INFINITY) - 1
    !libm_ult(wrapping(libm_shl(i, I64{1}) - I64{1}), I64{-9007199254740993})
}

// pow.c
libm_pow: fn(x: Float, y: Float) -> Float {
    ix := rt_f64_bits(x)
    iy: rt_f64_bits(y)
    topx := libm_shr(ix, I64{52})
    topy: libm_shr(iy, I64{52})
    ty: topy.bit_and(I64{0x7ff})
    sign_bias := I64{0}
    if (topx == I64{0} || topx >= I64{0x7ff} || ty < I64{0x3be} || ty >= I64{0x43e}) {
        // Special cases: (x < 0x1p-126 or inf or nan) or
        // (|y| < 0x1p-65 or |y| >= 0x1p63 or nan).
        if libm_pow_zeroinfnan(iy) -> return libm_pow_y_special(x, y, ix, iy)
        if libm_pow_zeroinfnan(ix) {
            x2 := x * x
            if (ix < I64{0} && libm_pow_checkint(iy) == I64{1}) -> x2 = -x2
            return if (iy < I64{0}) -> Float{1.0} / x2 else -> x2
        }
        // Here x and y are non-zero finite.
        if (ix < I64{0}) {
            // Finite x < 0.
            yint: libm_pow_checkint(iy)
            if (yint == I64{0}) -> return libm_invalid(x)
            if (yint == I64{1}) -> sign_bias = LIBM_POW_SIGN_BIAS
            ix = ix.bit_and(LIBM_ABS)
            topx = topx.bit_and(I64{0x7ff})
        }
        if (ty < I64{0x3be} || ty >= I64{0x43e}) {
            // Note: sign_bias == 0 here because y is not odd.
            if (ix == LIBM_ONE_BITS) -> return Float{1.0}
            // |y| < 2^-65, x^y ~= 1 + y*log(x).
            if (ty < I64{0x3be}) -> return if (ix > LIBM_ONE_BITS) -> Float{1.0} + y else -> Float{1.0} - y
            return if ((ix > LIBM_ONE_BITS) == (topy < I64{0x800})) -> rt_f64_from_bits(LIBM_EXP_INF) else -> Float{0.0}
        }
        if (topx == I64{0}) {
            // Normalize subnormal x so exponent becomes negative.
            ix = wrapping(rt_f64_bits(x * LIBM_TOINT).bit_and(LIBM_ABS) - (I64{52} << I64{52}))
        }
    }
    // pow.c log_inline(): log(x) as log_hi + log_lo, log_lo carrying about
    // 15 more bits; ix is x's bits, normalized in the subnormal range using
    // the sign bit for the exponent.
    // x = 2^k z; where z is in range [OFF,2*OFF) and exact.
    tmp: wrapping(ix - LIBM_POW_OFF)
    i: Int.from_i64(libm_shr(tmp, I64{45}).bit_and(I64{127}) * I64{3})
    // arithmetic shift
    k: tmp >> I64{52}
    iz: wrapping(ix - tmp.bit_and(LIBM_TOP12_MASK))
    z: rt_f64_from_bits(iz)
    kd: libm_small_float(k)
    // log(x) = k*Ln2 + log(c) + log1p(z/c-1).
    invc: rt_f64_from_bits(LIBM_POW_LOG_TABLE[i])
    logc: rt_f64_from_bits(LIBM_POW_LOG_TABLE[i + 1])
    logctail: rt_f64_from_bits(LIBM_POW_LOG_TABLE[i + 2])
    // Split z such that rhi, rlo and rhi*rhi are exact and |rlo| <= |r|.
    zhi: rt_f64_from_bits((iz + (I64{1} << I64{31})).bit_and(LIBM_HIGH_WORD))
    zlo: z - zhi
    rhi: zhi * invc - Float{1.0}
    rlo: zlo * invc
    r: rhi + rlo
    // k*Ln2 + log(c) + r.
    t1: kd * Float{0.6931471805598903} + logc
    t2: t1 + r
    lo1: kd * Float{5.497923018708371e-14} + logctail
    lo2: t1 - t2 + r
    // A[0] = -0.5.
    ar: Float{-0.5} * r
    ar2: r * ar
    ar3: r * ar2
    // k*Ln2 + log(c) + r + A[0]*r*r.
    arhi: Float{-0.5} * rhi
    arhi2: rhi * arhi
    hi: t2 + arhi2
    lo3: rlo * (ar + arhi)
    lo4: t2 - hi + arhi2
    // p = log1p(r) - r - A[0]*r*r.
    p: ar3 * (Float{-0.6666666666666679} + r * Float{0.5000000000000007} + ar2 * (Float{0.7999999995323976} + r * Float{-0.6666666663487739} + ar2 * (Float{-1.142909628459501} + r * Float{1.0000415263675542})))
    lo: lo1 + lo2 + lo3 + lo4 + p
    log_hi: hi + lo
    log_lo: hi - log_hi + lo
    yhi: rt_f64_from_bits(iy.bit_and(LIBM_POW_SPLIT))
    ylo: y - yhi
    lhi: rt_f64_from_bits(rt_f64_bits(log_hi).bit_and(LIBM_POW_SPLIT))
    llo: log_hi - lhi + log_lo
    ehi: yhi * lhi
    // |elo| < |ehi| * 2^-25.
    elo: ylo * lhi + y * llo
    libm_pow_exp(ehi, elo, sign_bias)
}

// pow.c for y = 0, infinity or nan.
libm_pow_y_special: fn(x: Float, y: Float, ix: I64, iy: I64) -> Float {
    if (libm_shl(iy, I64{1}) == I64{0}) -> return Float{1.0}
    if (ix == LIBM_ONE_BITS) -> return Float{1.0}
    infinity2: libm_shl(LIBM_EXP_INF, I64{1})
    if (libm_ult(infinity2, libm_shl(ix, I64{1})) || libm_ult(infinity2, libm_shl(iy, I64{1}))) -> return x + y
    one2: libm_shl(LIBM_ONE_BITS, I64{1})
    if (libm_shl(ix, I64{1}) == one2) -> return Float{1.0}
    // |x|<1 && y==inf or |x|>1 && y==-inf.
    if (libm_ult(libm_shl(ix, I64{1}), one2) == (iy >= I64{0})) -> return Float{0.0}
    y * y
}

// cbrt.c: B1 = (1023-1023/3-0.03306235651)*2**20 and
// B2 = (1023-1023/3-54/3-0.03306235651)*2**20.
LIBM_CBRT_B1: I64{715094163}
LIBM_CBRT_B2: I64{696219795}

// cbrt.c
libm_cbrt: fn(x: Float) -> Float {
    bits: rt_f64_bits(x)
    hx := (bits >> I64{32}).bit_and(I64{0x7fffffff})
    // cbrt(NaN,INF) is itself
    if (hx >= I64{0x7ff00000}) -> return x + x
    // Rough cbrt to 5 bits: integer division of the biased exponent.
    if (hx < I64{0x00100000}) {
        // zero or subnormal: scale by 0x1p54
        hx = (rt_f64_bits(x * Float{18014398509481984.0}) >> I64{32}).bit_and(I64{0x7fffffff})
        // cbrt(0) is itself
        if (hx == I64{0}) -> return x
        hx = hx / I64{3} + LIBM_CBRT_B2
    } else {
        hx = hx / I64{3} + LIBM_CBRT_B1
    }
    t := rt_f64_from_bits(bits.bit_and(LIBM_SIGN).bit_or(hx << I64{32}))
    // New cbrt to 23 bits: cbrt(x) = t*cbrt(x/t**3) ~= t*P(t**3/x), P
    // approximating 1/cbrt(r) to within 2**-23.5 when |r - 1| < 1/10.
    r := (t * t) * (t / x)
    t = t * ((Float{1.87595182427177} + r * (Float{-1.8849797954337717} + r * Float{1.6214297201053545})) + ((r * r) * r) * (Float{-0.758397934778766} + r * Float{0.14599619288661245}))
    // Round t away from zero to 23 bits.
    t = rt_f64_from_bits(wrapping(rt_f64_bits(t) + I64{0x80000000}).bit_and(I64{-1073741824}))
    // one step Newton iteration to 53 bits with error < 0.667 ulps
    s: t * t
    r = x / s
    w: t + t
    r = (r - t) / (w + r)
    t + t * r
}

// hypot.c sq(): x*x as hi + lo.
LibmSquare: struct { hi: Float, lo: Float }

libm_square: fn(x: Float) -> LibmSquare {
    // SPLIT, 0x1p27 + 1
    xc: x * Float{134217729.0}
    xh: x - xc + xc
    xl: x - xh
    hi: x * x
    LibmSquare{hi: hi, lo: xh * xh - hi + Float{2.0} * xh * xl + xl * xl}
}

// hypot.c
libm_hypot: fn(x: Float, y: Float) -> Float {
    // arrange |x| >= |y|
    ux := rt_f64_bits(x).bit_and(LIBM_ABS)
    uy := rt_f64_bits(y).bit_and(LIBM_ABS)
    if (ux < uy) {
        swapped: ux
        ux = uy
        uy = swapped
    }
    ex: ux >> I64{52}
    ey: uy >> I64{52}
    a := rt_f64_from_bits(ux)
    b := rt_f64_from_bits(uy)
    // hypot(inf,nan) == inf
    if (ey == I64{0x7ff}) -> return b
    if (ex == I64{0x7ff} || uy == I64{0}) -> return a
    // hypot(x,y) ~= x + y*y/x/2 with inexact for small y/x
    if (ex - ey > I64{64}) -> return a + b
    // precise sqrt argument in nearest rounding mode without overflow
    z := Float{1.0}
    if (ex > I64{0x3ff} + I64{510}) {
        z = Float{5.260135901548374e+210}
        a = a * Float{1.90109156629516e-211}
        b = b * Float{1.90109156629516e-211}
    } else if (ey < I64{0x3ff} - I64{450}) {
        z = Float{1.90109156629516e-211}
        a = a * Float{5.260135901548374e+210}
        b = b * Float{5.260135901548374e+210}
    }
    hx: libm_square(a)
    hy: libm_square(b)
    z * libm_sqrt(hy.lo + hx.lo + hy.hi + hx.hi)
}

