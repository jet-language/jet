fn unicode_is_control(cp: I64) -> Bool Never! {
    if {
        (cp < I64{127}) -> {
            if {
                (cp < I64{0}) -> return false
                (cp > I64{31}) -> return false
                else -> return true
            }
        }
        (cp > I64{159}) -> return false
        else -> return true
    }
}

