// Native-private flat records. All offsets live in DataABI.jet.
// Seed declaration/derive cites: DataPlot.rs:409-413,585-593,834-840,
// 885-890,1046-1052,1080-1087,1181-1187. CAbiRoutes record constructors
// clone borrowed text; getters own text clones; sequence reads lend.
// Axis.ticks: CAbiRoutes.rs:9759-9766; SourceFacts.rows:10097-10116.
// Both Rust fields are i64: raw private words, checked Int conversion only
// at constructors, fresh exact Int owners only at getters; never Int drops.
fn data_plot_flag(value: U8) -> I64 { if (value == U8{0}) -> I64{0} else -> I64{1} }
fn data_plot_tag(value: I64, count: I64) -> I64 {
    // CAbiRoutes.rs:11-13, ctor range_stop uses the shared arithmetic stop.
    if (value < I64{0} || value >= count) -> trap_native_index_range_stop()
    value
}
fn data_plot_text_header(text: I64, out: I64) {
    // Borrowed C text header is [ptr,len,cap], matching E4 text storage.
    data_tree_store(out, rt_text_data(text))
    data_tree_store(out + I64{8}, rt_text_len(text))
    data_tree_store(out + I64{16}, data_tree_word(text + I64{16}))
}
#Export(c) fn jet_rt_record_new_jet_data_plot_field(m0: I64, m1: I64, m2: I64) -> I64 {
    value :: jet_rt_alloc(DP_FIELD_BYTES, I64{8})
    data_tree_store(value + DP_FIELD_ID, jet_rt_string_clone(m0))
    data_tree_store(value + DP_FIELD_NAME, jet_rt_string_clone(m1))
    data_tree_store(value + DP_FIELD_TYPE_NAME, jet_rt_string_clone(m2))
    value
}
#Export(c) fn jet_rt_handle_clone_jet_data_plot_field(value: I64) -> I64 { jet_rt_record_new_jet_data_plot_field(data_tree_word(value + DP_FIELD_ID), data_tree_word(value + DP_FIELD_NAME), data_tree_word(value + DP_FIELD_TYPE_NAME)) }
#Export(c) fn jet_rt_handle_drop_jet_data_plot_field(value: I64) {
    if (value == I64{0}) -> return
    jet_rt_string_drop(data_tree_word(value + DP_FIELD_ID))
    jet_rt_string_drop(data_tree_word(value + DP_FIELD_NAME))
    jet_rt_string_drop(data_tree_word(value + DP_FIELD_TYPE_NAME))
    jet_rt_free(value, DP_FIELD_BYTES, I64{8})
}
#Export(c) fn jet_rt_handle_eq_jet_data_plot_field(a: I64, b: I64) -> Bool {
    jet_rt_string_eq(data_tree_word(a + DP_FIELD_ID), data_tree_word(b + DP_FIELD_ID)) && jet_rt_string_eq(data_tree_word(a + DP_FIELD_NAME), data_tree_word(b + DP_FIELD_NAME)) && jet_rt_string_eq(data_tree_word(a + DP_FIELD_TYPE_NAME), data_tree_word(b + DP_FIELD_TYPE_NAME))
}
#Export(c) fn jet_rt_record_get_jet_data_plot_field_id(value: I64) -> I64 { jet_rt_string_clone(data_tree_word(value + DP_FIELD_ID)) }
#Export(c) fn jet_rt_record_get_jet_data_plot_field_name(value: I64) -> I64 { jet_rt_string_clone(data_tree_word(value + DP_FIELD_NAME)) }
#Export(c) fn jet_rt_record_get_jet_data_plot_field_type_name(value: I64) -> I64 { jet_rt_string_clone(data_tree_word(value + DP_FIELD_TYPE_NAME)) }
