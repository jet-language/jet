// Same borrowed sequence ABI as Dyn; push consumes the child handle.
fn data_plot_sequence_push(sequence: I64, item: I64) {
    slot :: data_sequence_reserve(sequence, DATA_TREE_ELEMENT_BYTES)
    data_tree_store(slot, item)
    data_tree_store(sequence + DATA_SEQUENCE_LENGTH, data_tree_word(sequence + DATA_SEQUENCE_LENGTH) + I64{1})
}
#Export(c) fn jet_rt_record_seq_list_rec_jet_data_plot_field_new(capacity: I64) -> I64 { data_sequence_new(capacity, DATA_TREE_ELEMENT_BYTES) }
#Export(c) fn jet_rt_record_seq_list_rec_jet_data_plot_field_len(value: I64) -> I64 { data_tree_word(value + DATA_SEQUENCE_LENGTH) }
