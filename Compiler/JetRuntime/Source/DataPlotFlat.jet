    coll_copy(value, result, DP_LAYOUT_BYTES)
    result
}
#Export(c) fn jet_rt_handle_drop_jet_data_plot_layout(value: I64) { if (value != I64{0}) -> jet_rt_free(value, DP_LAYOUT_BYTES, I64{8}) }
#Export(c) fn jet_rt_handle_eq_jet_data_plot_layout(a: I64, b: I64) -> Bool {
    rt_f64_from_bits(data_tree_word(a + DP_LAYOUT_WIDTH)) == rt_f64_from_bits(data_tree_word(b + DP_LAYOUT_WIDTH)) && rt_f64_from_bits(data_tree_word(a + DP_LAYOUT_HEIGHT)) == rt_f64_from_bits(data_tree_word(b + DP_LAYOUT_HEIGHT)) && rt_f64_from_bits(data_tree_word(a + DP_LAYOUT_TOP)) == rt_f64_from_bits(data_tree_word(b + DP_LAYOUT_TOP)) && rt_f64_from_bits(data_tree_word(a + DP_LAYOUT_RIGHT)) == rt_f64_from_bits(data_tree_word(b + DP_LAYOUT_RIGHT)) && rt_f64_from_bits(data_tree_word(a + DP_LAYOUT_BOTTOM)) == rt_f64_from_bits(data_tree_word(b + DP_LAYOUT_BOTTOM)) && rt_f64_from_bits(data_tree_word(a + DP_LAYOUT_LEFT)) == rt_f64_from_bits(data_tree_word(b + DP_LAYOUT_LEFT))
}
