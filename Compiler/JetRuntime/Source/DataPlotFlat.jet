    value :: jet_rt_alloc(DP_LAYOUT_BYTES, I64{8})
    data_tree_store(value + DP_LAYOUT_WIDTH, rt_f64_bits(m0))
    data_tree_store(value + DP_LAYOUT_HEIGHT, rt_f64_bits(m1))
    data_tree_store(value + DP_LAYOUT_TOP, rt_f64_bits(m2))
    data_tree_store(value + DP_LAYOUT_RIGHT, rt_f64_bits(m3))
    data_tree_store(value + DP_LAYOUT_BOTTOM, rt_f64_bits(m4))
    data_tree_store(value + DP_LAYOUT_LEFT, rt_f64_bits(m5))
    value
}
#Export(c) fn jet_rt_handle_clone_jet_data_plot_layout(value: I64) -> I64 {
