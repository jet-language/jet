// Native homogeneous payload channels. State176: mutex0, refs8, queue
// len16/cap24/data32/head40, bound48, owned meta56, recvwait64/sendwait72,
// reservations80, closed88/canceled96, kind104 (0 channel,1 timer,2 interval),
// delay112, senders120/receivers128, observe136,
// recvwaitcount144/sendwaitcount152, replay id160 (RecordReplay.jet: each
// send, receive, close and endpoint drop is a sync event, logged under the
// mutex, and a select's chosen arm), sender ledger168. Endpoint handles are
// the opaque state pointer, each retaining one ref and one logical endpoint.
// WaitNode24: next0, park8, flags16 (linked1, ever-woken2), under lock.
// Single wake is Vec.pop (LIFO); close walks Vec insertion order (FIFO).

channel_update: fn(channel: I64) {
    jet_rt_observe_channel_update(sync_load(wrapping(channel + I64{136})), sync_load(wrapping(channel + I64{16})), sync_load(wrapping(channel + I64{152})), sync_load(wrapping(channel + I64{144})), sync_load(wrapping(channel + I64{88})))
}

// A wait on `channel`, for its record under `jet perf run`: the channel's
// observed id (PerfSamples.jet perf_samples_object).
channel_wait_object: fn(channel: I64) -> I64 {
    perf_samples_object(PERF_SAMPLES_OBJECT_CHANNEL, sync_load(wrapping(channel + I64{136})))
}

channel_new: fn(bound: I64, kind: I64, delay_ms: I64) -> I64 {
    channel: jet_rt_alloc(CHANNEL_BYTES, I64{8})
    thread_zero(channel, CHANNEL_BYTES)
    ledger: jet_rt_alloc(I64{32}, I64{8})
    thread_zero(ledger, I64{32})
    sync_store(wrapping(channel + I64{168}), ledger)
    sync_store(wrapping(channel + I64{8}), I64{1})
    sync_store(wrapping(channel + I64{48}), bound)
    sync_store(wrapping(channel + I64{104}), kind)
    sync_store(wrapping(channel + I64{112}), delay_ms)
    sync_store(wrapping(channel + I64{128}), I64{1})
    sync_store(wrapping(channel + I64{136}), jet_rt_observe_channel_new(if (bound >= I64{0}) -> I64{1} else -> I64{0}, bound))
    sync_store(wrapping(channel + I64{160}), replay_object_new())
    channel_update(channel)
    channel
}

channel_retain: fn(channel: I64) { _ := sync_add(wrapping(channel + I64{8}), I64{1}) }

channel_release: fn(channel: I64) {
    if (sync_add(wrapping(channel + I64{8}), I64{-1}) != I64{1}) {
        return
    }
    meta: sync_load(wrapping(channel + I64{56}))
    capacity: sync_load(wrapping(channel + I64{24}))
    data: sync_load(wrapping(channel + I64{32}))
    stride: if (meta == I64{0}) -> I64{0} else -> coll_size(meta)
    if (meta != I64{0}) {
        jet_rt_session_shield_enter()
        length: sync_load(wrapping(channel + I64{16}))
        head: sync_load(wrapping(channel + I64{40}))
        at := I64{0}
        loop at < length {
            coll_slot_drop(data + ((head + at) % capacity) * coll_size(meta), meta)
            at += I64{1}
        }
        coll_meta_drop(meta)
        jet_rt_session_shield_leave()
    }
    if (capacity != I64{0}) { jet_rt_free(data, capacity * stride, I64{8}) }
    jet_rt_observe_channel_drop(sync_load(wrapping(channel + I64{136})))
    channel_ledger_drop(sync_load(wrapping(channel + I64{168})))
    jet_rt_free(channel, CHANNEL_BYTES, I64{8})
}

CHANNEL_BYTES: I64{176}

// The sender ledger: the tasks holding a channel's Senders, so a receive's
// wait names its holders (WaitCycle.jet). Ledger32 at state168: count0
// capacity8 lost16 rows24, a row per holding task: control0 (retained)
// held8. A Sender counts where it is made, cloned and dropped, and moves
// with the task body that owns it (jet_rt_native_sender_pass, _take). A
// task a Sender may leave any other way stops counting as a holder (its
// control's leaky208, jet_rt_native_sender_leak); a Sender used or dropped
// where no row counts it, or a holder past CHANNEL_LEDGER_ROWS, loses the
// ledger for good, and a Shared value that may hold a Sender loses every
// ledger (channel_senders_escaped). Under the channel's mutex.
CHANNEL_LEDGER_ROWS: I64{64}

channel_senders_escaped := I64{0}

channel_ledger_drop: fn(ledger: I64) {
    count: sync_load(ledger)
    rows: sync_load(wrapping(ledger + I64{24}))
    at := I64{0}
    loop at < count {
        scheduler_control_drop(sync_load(wrapping(rows + at * I64{16})))
        at += I64{1}
    }
    capacity: sync_load(wrapping(ledger + I64{8}))
    if (capacity != I64{0}) { jet_rt_free(rows, capacity * I64{16}, I64{8}) }
    jet_rt_free(ledger, I64{32}, I64{8})
}

// The row of `control` in `ledger`, or 0.
channel_ledger_row: fn(ledger: I64, control: I64) -> I64 {
    count: sync_load(ledger)
    rows: sync_load(wrapping(ledger + I64{24}))
    at := I64{0}
    loop at < count {
        row: wrapping(rows + at * I64{16})
        if (sync_load(row) == control) { return row }
        at += I64{1}
    }
    I64{0}
}

channel_ledger_lose: fn(ledger: I64) { sync_store(wrapping(ledger + I64{16}), I64{1}) }

// Adds `delta` (1 or -1) to the Senders of `channel` that task `control`
// holds. The control to drop once the mutex is free when its row ends,
// else 0.
channel_ledger_add: fn(channel: I64, control: I64, delta: I64) -> I64 {
    ledger: sync_load(wrapping(channel + I64{168}))
    if (sync_load(wrapping(ledger + I64{16})) != I64{0}) { return I64{0} }
    row: if (control == I64{0}) -> I64{0} else -> channel_ledger_row(ledger, control)
    count: sync_load(ledger)
    if (row == I64{0}) {
        if (control == I64{0} || delta < I64{0} || count >= CHANNEL_LEDGER_ROWS) {
            channel_ledger_lose(ledger)
            return I64{0}
        }
        capacity: sync_load(wrapping(ledger + I64{8}))
        if (count == capacity) {
            grown: if (capacity == I64{0}) -> I64{4} else -> capacity * I64{2}
            rows: jet_rt_alloc(grown * I64{16}, I64{8})
            old: sync_load(wrapping(ledger + I64{24}))
            at := I64{0}
            loop at < (count * I64{2}) {
                sync_store(wrapping(rows + at * I64{8}), sync_load(wrapping(old + at * I64{8})))
                at += I64{1}
            }
            if (capacity != I64{0}) { jet_rt_free(old, capacity * I64{16}, I64{8}) }
            sync_store(wrapping(ledger + I64{8}), grown)
            sync_store(wrapping(ledger + I64{24}), rows)
        }
        added: wrapping(sync_load(wrapping(ledger + I64{24})) + count * I64{16})
        scheduler_control_retain(control)
        sync_store(added, control)
        sync_store(wrapping(added + I64{8}), delta)
        sync_store(ledger, count + I64{1})
        return I64{0}
    }
    held: sync_load(wrapping(row + I64{8})) + delta
    if (held != I64{0}) {
        sync_store(wrapping(row + I64{8}), held)
        return I64{0}
    }
    last: wrapping(sync_load(wrapping(ledger + I64{24})) + (count - I64{1}) * I64{16})
    sync_store(row, sync_load(last))
    sync_store(wrapping(row + I64{8}), sync_load(wrapping(last + I64{8})))
    sync_store(ledger, count - I64{1})
    control
}

// A send by the running task: a Sender no row counts loses the ledger.
channel_ledger_use: fn(channel: I64) {
    ledger: sync_load(wrapping(channel + I64{168}))
    if (sync_load(wrapping(ledger + I64{16})) != I64{0}) {
        return
    }
    control: scheduler_control_current()
    if (control == I64{0} || channel_ledger_row(ledger, control) == I64{0}) {
        channel_ledger_lose(ledger)
    }
}

// Moves one Sender of `channel` to or from the running task's row.
channel_ledger_move: fn(channel: I64, delta: I64) {
    if (channel == I64{0}) {
        return
    }
    sync_mutex_lock(channel)
    dropped: channel_ledger_add(channel, scheduler_control_current(), delta)
    sync_mutex_unlock(channel)
    scheduler_control_drop(dropped)
}

// A task body takes over a Sender its spawner handed it (JetIR
// BuildChannels.jet ir_hand_senders): the spawner's row gives it up before
// the spawn, the task's row takes it as the body starts.
#Export(c) jet_rt_native_sender_pass: fn(channel: I64) { channel_ledger_move(channel, I64{-1}) }

#Export(c) jet_rt_native_sender_take: fn(channel: I64) { channel_ledger_move(channel, I64{1}) }

// A value that may hold a Sender leaves the running task some other way
// (a send, a capture of a lambda that escapes or of a task body): no ledger
// counts the task as a holder from now on.
#Export(c) jet_rt_native_sender_leak: fn() {
    control: scheduler_control_current()
    if (control != I64{0}) { sync_store(wrapping(control + I64{208}), I64{1}) }
}

// A Shared value that may hold a Sender, which any task it reaches may take
// out, was made: no ledger names holders from now on.
#Export(c) jet_rt_native_sender_escape: fn() {
    #Unsafe("an idempotent flag: every writer stores the same 1") {
        channel_senders_escaped = I64{1}
    }
}

// The tasks holding `channel`'s Senders, while each waits in an armed wait
// and the channel is an empty, open, unreserved plain channel whose ledger
// counts every Sender: how many, each added to `walk` (WaitCycle.jet; 0 for
// none) and named on `text` (0 for none). 0 when any of that does not hold.
// Under the wait lock, which keeps each armed holder alive.
channel_senders: fn(channel: I64, walk: I64, text: I64) -> I64 {
    sync_mutex_lock(channel)
    ledger: sync_load(wrapping(channel + I64{168}))
    senders: sync_load(wrapping(channel + I64{120}))
    count: sync_load(ledger)
    rows: sync_load(wrapping(ledger + I64{24}))
    known := channel_senders_escaped == I64{0} && sync_load(wrapping(ledger + I64{16})) == I64{0} && senders > I64{0} && sync_load(wrapping(channel + I64{104})) == I64{0} && sync_load(wrapping(channel + I64{88})) == I64{0} && sync_load(wrapping(channel + I64{16})) == I64{0} && sync_load(wrapping(channel + I64{80})) == I64{0}
    held := I64{0}
    at := I64{0}
    loop known && at < count {
        control: sync_load(wrapping(rows + at * I64{16}))
        if (sync_load(wrapping(control + I64{208})) != I64{0} || sync_load(wrapping(control + I64{176})) == I64{0} || sync_load(wrapping(control + I64{184})) != I64{0}) {
            known = false
        }
        held += sync_load(wrapping(rows + at * I64{16} + I64{8}))
        at += I64{1}
    }
    if (held != senders) { known = false }
    at = I64{0}
    loop known && at < count {
        control: sync_load(wrapping(rows + at * I64{16}))
        if (walk != I64{0} && !wait_cycle_walk_add(walk, control)) { known = false }
        if (text != I64{0}) {
            if (at > I64{0}) {
                wait_cycle_push(text, if (at == count - I64{1}) -> rt_static_text(" and ") else -> rt_static_text(", "))
            }
            wait_cycle_name(text, control, false)
        }
        at += I64{1}
    }
    sync_mutex_unlock(channel)
    if known -> count else -> I64{0}
}

channel_grow: fn(channel: I64, needed: I64) {
    capacity: sync_load(wrapping(channel + I64{24}))
    if (needed <= capacity) {
        return
    }
    grown := if (capacity == I64{0}) -> I64{4} else -> capacity
    loop grown < needed -> grown *= I64{2}
    bound: sync_load(wrapping(channel + I64{48}))
    if (bound > I64{0} && grown > bound) { grown = bound }
    meta: sync_load(wrapping(channel + I64{56}))
    stride: coll_size(meta)
    buffer: jet_rt_alloc(grown * stride, I64{8})
    data: sync_load(wrapping(channel + I64{32}))
    length: sync_load(wrapping(channel + I64{16}))
    head: sync_load(wrapping(channel + I64{40}))
    at := I64{0}
    loop at < length {
        coll_copy(wrapping(data + ((head + at) % capacity) * stride), wrapping(buffer + at * stride), coll_payload(meta))
        at += I64{1}
    }
    if (capacity != I64{0}) { jet_rt_free(data, capacity * stride, I64{8}) }
    sync_store(wrapping(channel + I64{24}), grown)
    sync_store(wrapping(channel + I64{32}), buffer)
    sync_store(wrapping(channel + I64{40}), I64{0})
}

channel_wait_add: fn(channel: I64, node: I64, sending: Bool) {
    offset: if sending -> I64{72} else -> I64{64}
    count: if sending -> I64{152} else -> I64{144}
    sync_store(node, sync_load(wrapping(channel + offset)))
    sync_store(wrapping(node + I64{16}), (sync_load(wrapping(node + I64{16})) & I64{2}) | I64{1})
    sync_store(wrapping(channel + offset), node)
    _ := sync_add(wrapping(channel + count), I64{1})
}

channel_wait_remove: fn(channel: I64, node: I64, sending: Bool) {
    if ((sync_load(wrapping(node + I64{16})) & I64{1}) == I64{0}) {
        return
    }
    link := channel + (if sending -> I64{72} else -> I64{64})
    loop sync_load(link) != (I64{0}) {
        if (sync_load(link) == node) {
            sync_store(link, sync_load(node))
            sync_store(wrapping(node + I64{16}), sync_load(wrapping(node + I64{16})) & I64{2})
            _ := sync_add(wrapping(channel + (if sending -> I64{152} else -> I64{144})), I64{-1})
            return
        }
        link = sync_load(link)
    }
}

channel_wake_one: fn(channel: I64, sending: Bool) {
    offset: if sending -> I64{72} else -> I64{64}
    node: sync_load(wrapping(channel + offset))
    if (node == I64{0}) {
        return
    }
    sync_store(wrapping(channel + offset), sync_load(node))
    sync_store(wrapping(node + I64{16}), I64{2})
    _ := sync_add(wrapping(channel + (if sending -> I64{152} else -> I64{144})), I64{-1})
    sync_park_wake(sync_load(wrapping(node + I64{8})))
}

channel_wake_all: fn(channel: I64, sending: Bool) {
    offset: if sending -> I64{72} else -> I64{64}
    node := sync_load(wrapping(channel + offset))
    sync_store(wrapping(channel + offset), I64{0})
    sync_store(wrapping(channel + (if sending -> I64{152} else -> I64{144})), I64{0})
    ordered := I64{0}
    loop node != (I64{0}) {
        following: sync_load(node)
        sync_store(node, ordered)
        ordered = node
        node = following
    }
    loop ordered != (I64{0}) {
        following: sync_load(ordered)
        sync_store(wrapping(ordered + I64{16}), I64{2})
        sync_park_wake(sync_load(wrapping(ordered + I64{8})))
        ordered = following
    }
}

// Return a consumed selector wake to a remaining receiver if another arm won.
// Wake history survives re-registration; waiter layout remains 24 bytes.
channel_select_remove: fn(channel: I64, node: I64) {
    sync_mutex_lock(channel)
    woken: (sync_load(wrapping(node + I64{16})) & I64{2}) != I64{0}
    channel_wait_remove(channel, node, false)
    if (woken && sync_load(wrapping(channel + I64{16})) != I64{0}) {
        channel_wake_one(channel, false)
    }
    channel_update(channel)
    sync_mutex_unlock(channel)
}

channel_close: fn(channel: I64, canceled: Bool) {
    object: sync_load(wrapping(channel + I64{160}))
    ticket: replay_take(REPLAY_CLOSE, object)
    sync_mutex_lock(channel)
    sync_store(wrapping(channel + I64{88}), I64{1})
    if canceled -> sync_store(wrapping(channel + I64{96}), I64{1})
    channel_wake_all(channel, false)
    channel_wake_all(channel, true)
    channel_update(channel)
    replay_log(REPLAY_CLOSE, object)
    sync_mutex_unlock(channel)
    replay_give(ticket)
}

channel_pop_locked: fn(channel: I64, out: I64) -> Bool {
    length: sync_load(wrapping(channel + I64{16}))
    if (length == I64{0}) { return false }
    head: sync_load(wrapping(channel + I64{40}))
    meta: sync_load(wrapping(channel + I64{56}))
    coll_copy(wrapping(sync_load(wrapping(channel + I64{32})) + head * coll_size(meta)), out, coll_payload(meta))
    sync_store(wrapping(channel + I64{40}), (head + I64{1}) % sync_load(wrapping(channel + I64{24})))
    sync_store(wrapping(channel + I64{16}), length - I64{1})
    channel_wake_one(channel, true)
    true
}

// A parked owner allocates once per blocked operation, never on a fast send
// or receive. The node cannot be freed until its link is removed under lock.
channel_wait_new: fn(slot: I64) -> I64 {
    node: jet_rt_alloc(I64{24}, I64{8})
    thread_zero(node, I64{24})
    sync_store(wrapping(node + I64{8}), slot)
    node
}

// Each wait notes the channel, so a receive that closes a wait cycle stops
// with it (WaitCycle.jet).
channel_receive: fn(channel: I64, out: I64) -> Bool {
    object: sync_load(wrapping(channel + I64{160}))
    ticket: replay_take(REPLAY_RECEIVE, object)
    slot := I64{0}
    node := I64{0}
    reason := I64{0}
    received := false
    control: scheduler_control_current()
    wait_cycle_note(control, WAIT_CYCLE_RECEIVE, channel)
    loop {
        if (scheduler_wait_point_cancel_check() != I64{0} || scheduler_root_cancel_observed()) {
            break
        }
        sync_mutex_lock(channel)
        if channel_pop_locked(channel, out) {
            received = true
            channel_update(channel)
            replay_log(REPLAY_RECEIVE, object)
            sync_mutex_unlock(channel)
            break
        }
        if (sync_load(wrapping(channel + I64{88})) != I64{0}) {
            channel_update(channel)
            replay_log(REPLAY_RECEIVE + REPLAY_FAILED, object)
            sync_mutex_unlock(channel)
            break
        }
        if (slot == I64{0}) {
            slot = sync_park_new()
            node = channel_wait_new(slot)
            reason = channel_text(I64{0})
        }
        channel_wait_add(channel, node, false)
        channel_update(channel)
        sync_mutex_unlock(channel)
        status: scheduler_yield_policy(reason, slot, I64{-1}, true, channel_wait_object(channel))
        sync_mutex_lock(channel)
        channel_wait_remove(channel, node, false)
        channel_update(channel)
        sync_mutex_unlock(channel)
        if (status != I64{0}) { break }
    }
    wait_cycle_note(control, I64{0}, I64{0})
    if (node != I64{0}) { jet_rt_free(node, I64{24}, I64{8}) }
    if (slot != I64{0}) { sync_park_drop(slot) }
    if (reason != I64{0}) { jet_rt_string_drop(reason) }
    replay_give(ticket)
    received
}

#Export(c) jet_rt_native_channel: fn(bounded: I64, capacity: I64, tx: I64, rx: I64) {
    bound := I64{-1}
    if ((bounded & I64{255}) != I64{0}) {
        bound = jet_int_owned_to_i64(capacity)
        if (jet_scheduler_native_propagate() != I64{0}) {
            return
        }
        // Public bound validation is owned by the current Core channel body;
        // the scheduler reference itself defaults capacity.max(1).
        if (bound < I64{1}) { bound = I64{1} }
    }
    channel: channel_new(bound, I64{0}, I64{0})
    sync_store(wrapping(channel + I64{120}), I64{1})
    _ := channel_ledger_add(channel, scheduler_control_current(), I64{1})
    channel_retain(channel)
    sync_store(tx, channel)
    sync_store(rx, channel)
}

// 1 when the channel took the value at `slot`, else 0: the receivers are
// gone or the task was canceled while it waited, and the value stays at
// `slot`, owned by the caller (the sender's `SendError`).
#Export(c) jet_rt_native_sender_send: fn(channel: I64, slot: I64, meta: I64) -> I64 {
    object: sync_load(wrapping(channel + I64{160}))
    ticket: replay_take(REPLAY_SEND, object)
    park := I64{0}
    node := I64{0}
    reason := I64{0}
    accepted := I64{0}
    loop {
        if (scheduler_wait_point_cancel_check() != I64{0} || scheduler_root_cancel_observed()) {
            break
        }
        sync_mutex_lock(channel)
        if (sync_load(wrapping(channel + I64{88})) != I64{0} || sync_load(wrapping(channel + I64{128})) == I64{0}) {
            channel_update(channel)
            replay_log(REPLAY_SEND + REPLAY_FAILED, object)
            sync_mutex_unlock(channel)
            break
        }
        channel_ledger_use(channel)
        bound: sync_load(wrapping(channel + I64{48}))
        length: sync_load(wrapping(channel + I64{16}))
        reserved: sync_load(wrapping(channel + I64{80}))
        if (bound < I64{0} || length + reserved < bound) {
            if (sync_load(wrapping(channel + I64{56})) == I64{0}) {
                sync_store(wrapping(channel + I64{56}), coll_meta_copy(meta))
            }
            channel_grow(channel, length + reserved + I64{1})
            target: wrapping(sync_load(wrapping(channel + I64{32})) + ((sync_load(wrapping(channel + I64{40})) + length) % sync_load(wrapping(channel + I64{24}))) * coll_size(meta))
            coll_copy(slot, target, coll_payload(meta))
            sync_store(wrapping(channel + I64{16}), length + I64{1})
            channel_wake_one(channel, false)
            channel_update(channel)
            replay_log(REPLAY_SEND, object)
            sync_mutex_unlock(channel)
            accepted = I64{1}
            break
        }
        if (park == I64{0}) {
            park = sync_park_new()
            node = channel_wait_new(park)
            reason = channel_text(I64{1})
        }
        channel_wait_add(channel, node, true)
        channel_update(channel)
        sync_mutex_unlock(channel)
        status: scheduler_yield_policy(reason, park, I64{-1}, true, channel_wait_object(channel))
        sync_mutex_lock(channel)
        channel_wait_remove(channel, node, true)
        channel_update(channel)
        sync_mutex_unlock(channel)
        if (status != I64{0}) { break }
    }
    if (node != I64{0}) { jet_rt_free(node, I64{24}, I64{8}) }
    if (park != I64{0}) { sync_park_drop(park) }
    if (reason != I64{0}) { jet_rt_string_drop(reason) }
    replay_give(ticket)
    accepted
}

#Export(c) jet_rt_native_sender_close: fn(channel: I64) { channel_close(channel, false) }

#Export(c) jet_rt_native_receiver_close: fn(channel: I64) { channel_close(channel, false) }

#Export(c) jet_rt_native_sender_clone: fn(channel: I64) -> I64 {
    channel_retain(channel)
    sync_mutex_lock(channel)
    _ := sync_add(wrapping(channel + I64{120}), I64{1})
    _ := channel_ledger_add(channel, scheduler_control_current(), I64{1})
    channel_update(channel)
    sync_mutex_unlock(channel)
    channel
}

#Export(c) jet_rt_native_receiver_clone: fn(channel: I64) -> I64 {
    channel_retain(channel)
    sync_mutex_lock(channel)
    _ := sync_add(wrapping(channel + I64{128}), I64{1})
    channel_update(channel)
    sync_mutex_unlock(channel)
    channel
}

#Export(c) jet_rt_native_sender_drop: fn(channel: I64) {
    if (channel == I64{0}) {
        return
    }
    object: sync_load(wrapping(channel + I64{160}))
    ticket: replay_take(REPLAY_SENDER_DROP, object)
    sync_mutex_lock(channel)
    dropped: channel_ledger_add(channel, scheduler_control_current(), I64{-1})
    if (sync_add(wrapping(channel + I64{120}), I64{-1}) == I64{1}) {
        sync_store(wrapping(channel + I64{88}), I64{1})
        channel_wake_all(channel, false)
    }
    channel_update(channel)
    replay_log(REPLAY_SENDER_DROP, object)
    sync_mutex_unlock(channel)
    replay_give(ticket)
    scheduler_control_drop(dropped)
    channel_release(channel)
}

#Export(c) jet_rt_native_receiver_drop: fn(channel: I64) {
    if (channel == I64{0}) {
        return
    }
    object: sync_load(wrapping(channel + I64{160}))
    ticket: replay_take(REPLAY_RECEIVER_DROP, object)
    sync_mutex_lock(channel)
    if (sync_add(wrapping(channel + I64{128}), I64{-1}) == I64{1}) {
        sync_store(wrapping(channel + I64{88}), I64{1})
        channel_wake_all(channel, true)
    }
    channel_update(channel)
    replay_log(REPLAY_RECEIVER_DROP, object)
    sync_mutex_unlock(channel)
    replay_give(ticket)
    channel_release(channel)
}

#Export(c) jet_rt_native_receiver_is_ready: fn(channel: I64) -> I64 {
    sync_mutex_lock(channel)
    ready: sync_load(wrapping(channel + I64{16})) != I64{0} || sync_load(wrapping(channel + I64{88})) != I64{0}
    sync_mutex_unlock(channel)
    if ready -> I64{1} else -> I64{0}
}

// Receiver metadata: kind104 (1 timer, 2 interval), canceled96 and the
// delay112 of a timer channel, read under the state lock.
channel_word: fn(channel: I64, offset: I64) -> I64 {
    sync_mutex_lock(channel)
    value: sync_load(wrapping(channel + offset))
    sync_mutex_unlock(channel)
    value
}

#Export(c) jet_rt_native_receiver_is_timer: fn(channel: I64) -> I64 {
    if (channel_word(channel, I64{104}) == I64{1}) -> I64{1} else -> I64{0}
}

#Export(c) jet_rt_native_receiver_is_interval: fn(channel: I64) -> I64 {
    if (channel_word(channel, I64{104}) == I64{2}) -> I64{1} else -> I64{0}
}

#Export(c) jet_rt_native_receiver_is_canceled: fn(channel: I64) -> I64 {
    if (channel_word(channel, I64{96}) != I64{0}) -> I64{1} else -> I64{0}
}

#Export(c) jet_rt_native_receiver_delay_ms: fn(channel: I64) -> I64 {
    jet_int_owned_from_i64(channel_word(channel, I64{112}))
}

// Under `jet debug --replay` a recorded empty answer stays empty, though a
// value may already be there (RecordReplay.jet).
#Export(c) jet_rt_native_receiver_try_receive: fn(channel: I64, meta: I64) -> I64 {
    object: sync_load(wrapping(channel + I64{160}))
    ticket: replay_take(REPLAY_TRY_RECEIVE, object)
    sync_mutex_lock(channel)
    result := I64{0}
    if (ticket != REPLAY_TRY_RECEIVE + REPLAY_FAILED && sync_load(wrapping(channel + I64{16})) != I64{0}) {
        result = coll_slot_new(meta)
        _ := channel_pop_locked(channel, result)
    }
    channel_update(channel)
    replay_log(if (result == I64{0}) -> REPLAY_TRY_RECEIVE + REPLAY_FAILED else -> REPLAY_TRY_RECEIVE, object)
    sync_mutex_unlock(channel)
    replay_give(ticket)
    result
}

#Export(c) jet_rt_native_receiver_receive: fn(channel: I64, out: I64) -> I64 {
    if channel_receive(channel, out) -> return I64{1}
    if (jet_rt_session_propagate() != I64{0}) { return I64{0} }
    // Closed is zero-sized: preserve Box<Closed>'s non-null dangling owner.
    sync_store(out, I64{1})
    I64{0}
}

channel_iter_pull: fn(channel: I64, out: I64) -> Bool { channel_receive(channel, out) }

#Export(c) jet_rt_native_receiver_iter: fn(channel: I64, by_value: I64, meta: I64) -> I64 {
    receiver: if ((by_value & I64{255}) != I64{0}) -> channel else -> jet_rt_native_receiver_clone(channel)
    iter_channel_new(receiver, meta)
}

// Prepared Source sends reserve before extracting an owned payload. The
// reservation keeps only physical state alive, not a logical sender endpoint.
// Reservation16 {state0,active8}, released exactly once by commit/drop.
channel_reserve_send: fn(channel: I64, meta: I64) -> I64 {
    park := I64{0}
    node := I64{0}
    reason := I64{0}
    reservation := I64{0}
    loop {
        if (scheduler_wait_point_cancel_check() != I64{0} || scheduler_root_cancel_observed()) {
            break
        }
        sync_mutex_lock(channel)
        if (sync_load(wrapping(channel + I64{88})) != I64{0} || sync_load(wrapping(channel + I64{128})) == I64{0}) {
            channel_update(channel)
            sync_mutex_unlock(channel)
            break
        }
        length: sync_load(wrapping(channel + I64{16}))
        reserved: sync_load(wrapping(channel + I64{80}))
        bound: sync_load(wrapping(channel + I64{48}))
        if (bound < I64{0} || length + reserved < bound) {
            if (sync_load(wrapping(channel + I64{56})) == I64{0}) {
                sync_store(wrapping(channel + I64{56}), coll_meta_copy(meta))
            }
            channel_grow(channel, length + reserved + I64{1})
            sync_store(wrapping(channel + I64{80}), reserved + I64{1})
            channel_retain(channel)
            reservation = jet_rt_alloc(I64{16}, I64{8})
            sync_store(reservation, channel)
            sync_store(wrapping(reservation + I64{8}), I64{1})
            channel_update(channel)
            sync_mutex_unlock(channel)
            break
        }
        if (park == I64{0}) {
            park = sync_park_new()
            node = channel_wait_new(park)
            reason = channel_text(I64{1})
        }
        channel_wait_add(channel, node, true)
        channel_update(channel)
        sync_mutex_unlock(channel)
        status: scheduler_yield_policy(reason, park, I64{-1}, true, channel_wait_object(channel))
        sync_mutex_lock(channel)
        channel_wait_remove(channel, node, true)
        channel_update(channel)
        sync_mutex_unlock(channel)
        if (status != I64{0}) { break }
    }
    if (node != I64{0}) { jet_rt_free(node, I64{24}, I64{8}) }
    if (park != I64{0}) { sync_park_drop(park) }
    if (reason != I64{0}) { jet_rt_string_drop(reason) }
    reservation
}

channel_reservation_drop: fn(reservation: I64) {
    if (reservation == I64{0}) {
        return
    }
    channel: sync_load(reservation)
    sync_mutex_lock(channel)
    if (sync_load(wrapping(reservation + I64{8})) != I64{0}) {
        sync_store(wrapping(reservation + I64{8}), I64{0})
        _ := sync_add(wrapping(channel + I64{80}), I64{-1})
        channel_wake_one(channel, true)
    }
    channel_update(channel)
    sync_mutex_unlock(channel)
    jet_rt_free(reservation, I64{16}, I64{8})
    channel_release(channel)
}

// False leaves payload ownership with the caller. No callback runs while the
// state mutex is held, and already reserved capacity cannot be stolen. The
// commit is the send's sync event (RecordReplay.jet).
channel_reservation_commit: fn(reservation: I64, slot: I64) -> Bool {
    channel: sync_load(reservation)
    object: sync_load(wrapping(channel + I64{160}))
    ticket: replay_take(REPLAY_SEND, object)
    sync_mutex_lock(channel)
    accepted: sync_load(wrapping(channel + I64{88})) == I64{0} && sync_load(wrapping(channel + I64{128})) != I64{0}
    _ := sync_add(wrapping(channel + I64{80}), I64{-1})
    sync_store(wrapping(reservation + I64{8}), I64{0})
    if {
        accepted -> {
            length: sync_load(wrapping(channel + I64{16}))
            meta: sync_load(wrapping(channel + I64{56}))
            target: wrapping(sync_load(wrapping(channel + I64{32})) + ((sync_load(wrapping(channel + I64{40})) + length) % sync_load(wrapping(channel + I64{24}))) * coll_size(meta))
            coll_copy(slot, target, coll_payload(meta))
            sync_store(wrapping(channel + I64{16}), length + I64{1})
            channel_wake_one(channel, false)
        }
        else -> channel_wake_one(channel, true)
    }
    channel_update(channel)
    replay_log(if accepted -> REPLAY_SEND else -> REPLAY_SEND + REPLAY_FAILED, object)
    sync_mutex_unlock(channel)
    replay_give(ticket)
    jet_rt_free(reservation, I64{16}, I64{8})
    channel_release(channel)
    accepted
}

// Probe priorities are exactly recvs in source order, expired timer arms in
// source order, then all-closed (when there are no timer arms).
channel_select_probe: fn(receivers: I64, count: I64, timer_data: I64, timer_count: I64, now: I64, arm: I64, value: I64) -> I64 {
    closed := true
    at := I64{0}
    loop at < count {
        channel: sync_load(wrapping(receivers + at * I64{8}))
        sync_mutex_lock(channel)
        if (sync_load(wrapping(channel + I64{16})) != I64{0}) {
            payload: coll_slot_new(sync_load(wrapping(channel + I64{56})))
            _ := channel_pop_locked(channel, payload)
            channel_update(channel)
            replay_log(REPLAY_SELECT, at)
            sync_mutex_unlock(channel)
            sync_store(arm, jet_int_owned_from_i64(at))
            sync_store(value, payload)
            return I64{1}
        }
        if (sync_load(wrapping(channel + I64{88})) == I64{0}) { closed = false }
        sync_mutex_unlock(channel)
        at += I64{1}
    }
    at = I64{0}
    loop at < timer_count {
        if (now >= sync_load(wrapping(timer_data + at * I64{16}))) {
            sync_store(arm, jet_int_owned_from_i64(count + at))
            replay_log(REPLAY_SELECT, count + at)
            sync_store(value, I64{0})
            return I64{1}
        }
        at += I64{1}
    }
    if (closed && timer_count == I64{0}) {
        replay_log(REPLAY_SELECT, REPLAY_SELECT_CLOSED)
        return I64{2}
    }
    I64{0}
}

// A replayed select takes its recorded arm, without probing or parking: the
// recorded value is in its channel by its turn, a timer arm has fired, and a
// probing select that found nothing finds nothing again.
channel_select_replayed: fn(receivers: I64, count: I64, arm: I64, value: I64) -> I64 {
    chosen: replay_recorded(I64{16})
    if (chosen == REPLAY_SELECT_NONE) { return I64{0} }
    if (chosen == REPLAY_SELECT_CLOSED) { return I64{2} }
    payload := I64{0}
    if (chosen < count) {
        channel: sync_load(wrapping(receivers + chosen * I64{8}))
        sync_mutex_lock(channel)
        if (sync_load(wrapping(channel + I64{16})) != I64{0}) {
            payload = coll_slot_new(sync_load(wrapping(channel + I64{56})))
            _ := channel_pop_locked(channel, payload)
        }
        channel_update(channel)
        sync_mutex_unlock(channel)
        if (payload == I64{0}) {
            replay_mismatch(REPLAY_SELECT + REPLAY_FAILED, chosen)
            return I64{0}
        }
    }
    sync_store(arm, jet_int_owned_from_i64(chosen))
    sync_store(value, payload)
    I64{1}
}

// Consumed select lists share one cleanup on stopped and completed paths.
channel_select_drop_inputs: fn(receivers: I64, count: I64, capacity: I64, converted: I64, timer_count: I64) {
    at := I64{0}
    loop at < count {
        jet_rt_native_receiver_drop(sync_load(wrapping(receivers + at * I64{8})))
        at += I64{1}
    }
    if (capacity != I64{0}) { jet_rt_free(receivers, capacity * I64{8}, I64{8}) }
    if (timer_count != I64{0}) { jet_rt_free(converted, timer_count * I64{16}, I64{8}) }
}

#Export(c) jet_rt_native_select_wait: fn(recvs: I64, timers: I64, probing: I64, arm: I64, value: I64) {
    count: sync_load(recvs)
    capacity: sync_load(wrapping(recvs + I64{8}))
    receivers: sync_load(wrapping(recvs + I64{16}))
    timer_count: sync_load(timers)
    timer_capacity: sync_load(wrapping(timers + I64{8}))
    durations: sync_load(wrapping(timers + I64{16}))
    thread_zero(recvs, I64{24})
    thread_zero(timers, I64{24})
    converted := I64{0}
    if (timer_count != I64{0}) {
        converted = jet_rt_alloc(timer_count * I64{16}, I64{8})
        thread_zero(converted, timer_count * I64{16})
    }
    started: sync_now_ns()
    at := I64{0}
    stopped := false
    loop at < timer_count {
        raw: sync_load(wrapping(durations + at * I64{8}))
        nanoseconds: jet_int_owned_to_i64(raw)
        jet_rt_int_drop(raw)
        if (jet_scheduler_native_propagate() != I64{0}) {
            stopped = true
            at += I64{1}
            break
        }
        // duration.to_millis truncates towards zero; negative delays default0.
        millis: nanoseconds /% I64{1000000}
        delay: if (millis < I64{0}) -> I64{0} else -> millis * I64{1000000}
        deadline: if (delay > I64{9223372036854775807} - started) -> I64{9223372036854775807} else -> started + delay
        sync_store(wrapping(converted + at * I64{16}), deadline)
        at += I64{1}
    }
    if stopped {
        loop at < timer_count {
            jet_rt_int_drop(sync_load(wrapping(durations + at * I64{8})))
            at += I64{1}
        }
        if (timer_capacity != I64{0}) { jet_rt_free(durations, timer_capacity * I64{8}, I64{8}) }
        channel_select_drop_inputs(receivers, count, capacity, converted, timer_count)
        return
    }
    if (timer_capacity != I64{0}) { jet_rt_free(durations, timer_capacity * I64{8}, I64{8}) }
    park := I64{0}
    registrations := I64{0}
    // Under `jet debug --replay` the select takes its recorded turn and arm.
    ticket: replay_take(REPLAY_SELECT, I64{0})
    result := if (ticket >= I64{0}) -> channel_select_replayed(receivers, count, arm, value) else if (count == I64{0} && timer_count == I64{0}) -> I64{3} else -> channel_select_probe(receivers, count, converted, timer_count, started, arm, value)
    if (result == I64{0} && (probing & I64{255}) == I64{0} && ticket < I64{0}) {
        park = sync_park_new()
        if (count != I64{0}) {
            registrations = jet_rt_alloc(count * I64{24}, I64{8})
            thread_zero(registrations, count * I64{24})
        }
        at = I64{0}
        loop at < count {
            channel: sync_load(wrapping(receivers + at * I64{8}))
            node: registrations + at * I64{24}
            sync_store(wrapping(node + I64{8}), park)
            sync_mutex_lock(channel)
            channel_wait_add(channel, node, false)
            channel_update(channel)
            sync_mutex_unlock(channel)
            at += I64{1}
        }
        at = I64{0}
        loop at < timer_count {
            sync_store(wrapping(wrapping(converted + at * I64{16}) + I64{8}), scheduler_timer_schedule(sync_load(wrapping(converted + at * I64{16})), park))
            at += I64{1}
        }
        reason: channel_text(I64{2})
        loop {
            if (scheduler_wait_point_cancel_check() != I64{0} || scheduler_root_cancel_observed()) {
                break
            }
            at = I64{0}
            loop at < count {
                channel: sync_load(wrapping(receivers + at * I64{8}))
                node: registrations + at * I64{24}
                sync_mutex_lock(channel)
                if ((sync_load(wrapping(node + I64{16})) & I64{1}) == I64{0}) {
                    channel_wait_add(channel, node, false)
                }
                sync_mutex_unlock(channel)
                at += I64{1}
            }
            // Reprobe after registration: close/send racing registration must
            // never disappear between the initial probe and first park.
            result = channel_select_probe(receivers, count, converted, timer_count, sync_now_ns(), arm, value)
            if (result != I64{0}) { break }
            if (scheduler_yield(reason, park, I64{-1}) != I64{0}) { break }
        }
        jet_rt_string_drop(reason)
        at = I64{0}
        loop at < count {
            channel: sync_load(wrapping(receivers + at * I64{8}))
            channel_select_remove(channel, wrapping(registrations + at * I64{24}))
            at += I64{1}
        }
        at = I64{0}
        loop at < timer_count {
            scheduler_timer_cancel(sync_load(wrapping(wrapping(converted + at * I64{16}) + I64{8})))
            at += I64{1}
        }
        if (count != I64{0}) { jet_rt_free(registrations, count * I64{24}, I64{8}) }
        sync_park_drop(park)
    }
    if (result == I64{0} && (probing & I64{255}) != I64{0}) {
        replay_log(REPLAY_SELECT, REPLAY_SELECT_NONE)
    }
    replay_give(ticket)
    channel_select_drop_inputs(receivers, count, capacity, converted, timer_count)
    // The selected payload and arm have already transferred to the caller.
    // Do not turn a completed selection into a stopped, uninitialized output.
    if (result == I64{1}) {
        return
    }
    if (jet_rt_session_propagate() != I64{0}) {
        return
    }
    if (result == I64{3}) {
        channel_fatal(I64{5})
        return
    }
    if ((probing & I64{255}) == I64{0} && result == I64{2}) {
        channel_fatal(I64{4})
        return
    }
    sync_store(arm, jet_int_owned_from_i64(I64{-1}))
    sync_store(value, I64{0})
}

// The six exact E4 messages below are emitted without Core String values.
channel_text: fn(kind: I64) -> I64 {
    length: if (kind == I64{0}) -> I64{15} else if (kind == I64{1}) -> I64{12} else if (kind == I64{2}) -> I64{11} else if (kind == I64{3}) -> I64{36} else if (kind == I64{4}) -> I64{13} else -> I64{26}
    text: scheduler_text_new(length)
    buffer: sync_load(text)
    if {
        (kind == I64{0} || kind == I64{1}) -> {
            sync_store(buffer, I64{2336353831671130211})
            if {
                (kind == I64{0}) -> sync_store(wrapping(buffer + I64{8}), I64{28559167692432754})
                else -> sync_store(wrapping(buffer + I64{8}), I64{1684956531})
            }
        }
        (kind == I64{2}) -> {
            sync_store(buffer, I64{8583988860020352371})
            sync_store(wrapping(buffer + I64{8}), I64{7629153})
        }
        (kind == I64{3}) -> {
            sync_store(buffer, I64{8223683306451986515})
            sync_store(wrapping(buffer + I64{8}), I64{2336927755350406757})
            sync_store(wrapping(buffer + I64{16}), I64{7598805615236769127})
            sync_store(wrapping(buffer + I64{24}), I64{8458156441480490607})
            sync_store(wrapping(buffer + I64{32}), I64{1684370547})
        }
        (kind == I64{4}) -> {
            sync_store(buffer, I64{7142836979261793651})
            sync_store(wrapping(buffer + I64{8}), I64{431198793580})
        }
        else -> {
            sync_store(buffer, I64{2322296528115098995})
            sync_store(wrapping(buffer + I64{8}), I64{2338332969558634350})
            sync_store(wrapping(buffer + I64{16}), I64{8243122732010005874})
            sync_store(wrapping(buffer + I64{24}), I64{25701})
        }
    }
    text
}

channel_fatal: fn(kind: I64) {
    message: channel_text(kind)
    scheduler_fatal(message)
}

// One-variant zero-sized Closed enum, deriving Clone and PartialEq. The Rust
// original shows exactly "Closed". The generated C ABI emits these four
// operations (no Display/Debug adapter).
#Export(c) jet_rt_handle_clone_closed: fn(_value: I64) -> I64 { I64{1} }

#Export(c) jet_rt_handle_drop_closed: fn(_value: I64) {}

#Export(c) jet_rt_handle_eq_closed: fn(_left: I64, _right: I64) -> Bool { true }

#Export(c) jet_rt_handle_show_closed: fn(_value: I64) -> I64 {
    text: scheduler_text_new(I64{6})
    sync_store(sync_load(text), I64{110386891156547})
    text
}
