// read_until('\n') on the one shared reader. No fault checkpoint, UTF-8
// validation or line trimming belongs to this leaf. FD72 owns refill/position;
// HostFiles read/seek consume this same state.
#Export(c) jet_file_reader_line_bytes_raw: fn(reader: I64, output: I64, length: I64, error: I64) -> I64 {
    bytes := I64{0}
    capacity := I64{0}
    used := I64{0}
    failure := I64{0}
    fd_lock(reader)
    if (fd_word(reader, I64{16}) != I64{0}) {
        failure = I64{-9}
    } else {
        fd_put(reader, I64{40}, I64{8192})
        buffer: fd_buffer(reader)
        loop {
            position := fd_word(reader, I64{56})
            filled := fd_word(reader, I64{48})
            if (position == filled) {
                count: host_call(I64{0}, fd_word(reader, I64{8}), buffer, I64{8192})
                if (count == I64{-4}) -> next
                if (count <= I64{0}) {
                    failure = count
                    break
                }
                position = I64{0}
                filled = count
                fd_put(reader, I64{56}, I64{0})
                fd_put(reader, I64{48}, filled)
            }
            newline: rt_text_find_byte(buffer, filled, I64{10}, position, false)
            found: newline >= I64{0}
            end: if found -> newline + I64{1} else -> filled
            count: end - position
            required: used + count
            if (required > capacity) {
                // A line found whole in the buffer gets exactly its bytes,
                // which compiler_fs_bytes_take hands on without a copy.
                grown := if (capacity == I64{0}) -> I64{128} else -> capacity
                if (capacity == I64{0} && found) { grown = count }
                loop grown < required -> grown *= I64{2}
                next_bytes: jet_rt_alloc_8(grown)
                if (used != I64{0}) -> rt_text_bytes_copy(next_bytes, bytes, used)
                if (capacity != I64{0}) -> jet_rt_free_8(bytes, capacity)
                bytes = next_bytes
                capacity = grown
            }
            rt_text_bytes_copy(wrapping(bytes + used), wrapping(buffer + position), count)
            used = required
            fd_put(reader, I64{56}, end)
            if found -> break
        }
    }
    fd_unlock(reader)
    if (failure < I64{0}) {
        if (capacity != I64{0}) -> jet_rt_free_8(bytes, capacity)
        return compiler_fs_errno(HOST_IO_OP_READ, fd_word(reader, I64{24}), -failure, error)
    }
    if (capacity == I64{0}) {
        rt_text_store(output, I64{0})
        rt_text_store(length, I64{0})
    } else {
        compiler_fs_bytes_take(bytes, capacity, used, output, length)
    }
    I64{1}
}

// `loop line in reader.lines()` (JetIR BuildLazy ir_line_next_body): Core
// __reader_read_line (Core/Files/Files.jet) without its Result and Option
// boxes or the [U8] it trims, validates and copies. The "FS.Read" fault
// checkpoint, then one line: 1 with the line, its trailing LFs and CRs
// removed, moved into `output`; 0 at end of file; 2 with the IOError
// __reader_read_line would return in `error` (the fault's Other, a read
// error's errno arm, or InvalidInput for a line that is not UTF-8). A line
// already whole in the reader's buffer is found and checked for ASCII in one
// pass (RouteTerm.jet stdin_line_scan), validated only when it is not ASCII
// and copied out once at its final length; one that spans a refill is
// gathered a run at a time.
#Export(c) jet_file_reader_lines_next: fn(reader: I64, output: I64, error: I64) -> I64 {
    if jet_fault_should_fail(rt_static_text("FS.Read")) {
        _ := host_io_other_take(HOST_IO_OP_READ, jet_fd_path_raw(reader), jet_rt_string_clone(rt_static_text("fault injected: FS.Read")), error)
        return I64{2}
    }
    fd_lock(reader)
    // The buffer holds read data while the reader is open and in read mode
    // (fd_word 40, which this leaf and jet_file_reader_line_bytes_raw set).
    if (fd_word(reader, I64{16}) == I64{0} && fd_word(reader, I64{40}) == I64{8192}) {
        position: fd_word(reader, I64{56})
        filled: fd_word(reader, I64{48})
        if (position < filled) {
            start: wrapping(fd_word(reader, I64{32}) + position)
            scan: stdin_line_scan(start, filled - position)
            run: if (scan < I64{0}) -> wrapping(I64{0} - scan) else -> scan
            if (rt_text_byte(wrapping(wrapping(start + run) - I64{1})) == I64{10}) {
                end: stdin_line_end(start, run)
                invalid: if (scan < I64{0}) -> text_bytes_utf8_error(start, end) else -> I64{0}
                line: if (invalid == I64{0}) -> rt_text_copy(start, end) else -> I64{0}
                fd_put(reader, I64{56}, wrapping(position + run))
                fd_unlock(reader)
                if (invalid != I64{0}) {
                    jet_rt_string_drop(invalid)
                    return file_line_utf8_error(reader, error)
                }
                rt_text_store(output, line)
                return I64{1}
            }
        }
    }
    value: jet_rt_string_builder_new()
    failure := I64{0}
    if (fd_word(reader, I64{16}) != I64{0}) {
        failure = I64{-9}
    } else {
        fd_put(reader, I64{40}, I64{8192})
        buffer: fd_buffer(reader)
        loop {
            position := fd_word(reader, I64{56})
            filled := fd_word(reader, I64{48})
            if (position == filled) {
                count: host_call(I64{0}, fd_word(reader, I64{8}), buffer, I64{8192})
                if (count == I64{-4}) -> next
                if (count <= I64{0}) {
                    failure = count
                    break
                }
                position = I64{0}
                filled = count
                fd_put(reader, I64{56}, I64{0})
                fd_put(reader, I64{48}, filled)
            }
            newline: rt_text_find_byte(buffer, filled, I64{10}, position, false)
            end: if (newline >= I64{0}) -> newline + I64{1} else -> filled
            rt_text_append(value, wrapping(buffer + position), end - position)
            fd_put(reader, I64{56}, end)
            if (newline >= I64{0}) -> break
        }
    }
    fd_unlock(reader)
    if (failure < I64{0}) {
        jet_rt_string_drop(value)
        _ := compiler_fs_errno(HOST_IO_OP_READ, fd_word(reader, I64{24}), -failure, error)
        return I64{2}
    }
    if (rt_text_len(value) == I64{0}) {
        jet_rt_string_drop(value)
        return I64{0}
    }
    invalid: text_bytes_utf8_error(rt_text_data(value), rt_text_len(value))
    if (invalid != I64{0}) {
        jet_rt_string_drop(invalid)
        jet_rt_string_drop(value)
        return file_line_utf8_error(reader, error)
    }
    rt_text_store(wrapping(value + I64{8}), stdin_line_end(rt_text_data(value), rt_text_len(value)))
    rt_text_store(output, value)
    I64{1}
}

// Core io_err("read", path, "stream did not contain valid UTF-8") in `error`:
// 2, jet_file_reader_lines_next's IOError status.
file_line_utf8_error: fn(reader: I64, error: I64) -> I64 {
    _ := compiler_fs_error(HOST_IO_KIND_INVALID_INPUT, HOST_IO_OP_READ, fd_word(reader, I64{24}), I64{0}, jet_rt_string_clone(rt_static_text("stream did not contain valid UTF-8")), error)
    I64{2}
}
