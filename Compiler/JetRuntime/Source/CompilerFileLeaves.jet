// read_until('\n') on the one shared reader. No fault checkpoint, UTF-8
// validation or line trimming belongs to this leaf. FD72 owns refill/position;
// HostFiles read/seek consume this same state.
#Export(c) fn jet_file_reader_line_bytes_raw(reader: I64, output: I64, length: I64, error: I64) -> I64 {
    bytes := I64{0}
    capacity := I64{0}
    used := I64{0}
    failure := I64{0}
    fd_lock(reader)
    if (fd_word(reader, I64{16}) != I64{0}) {
        failure = I64{-9}
    } else {
        fd_put(reader, I64{40}, I64{8192})
        buffer :: fd_buffer(reader)
        loop {
            position := fd_word(reader, I64{56})
            filled := fd_word(reader, I64{48})
            if (position == filled) {
                count :: host_call(I64{0}, fd_word(reader, I64{8}), buffer, I64{8192})
                if (count == I64{-4}) -> next
                if (count <= I64{0}) {
                    failure = count
                    break
                }
                position = I64{0}
                filled = count
                fd_put(reader, I64{56}, I64{0})
                fd_put(reader, I64{48}, filled)
            }
            newline :: rt_text_find_byte(buffer, filled, I64{10}, position, false)
            found :: newline >= I64{0}
            end :: if found -> newline + I64{1} else -> filled
            count :: end - position
            required :: used + count
            if (required > capacity) {
                // A line found whole in the buffer gets exactly its bytes,
                // which compiler_fs_bytes_take hands on without a copy.
                grown := if (capacity == I64{0}) -> I64{128} else -> capacity
                if (capacity == I64{0} && found) { grown = count }
                loop grown < required -> grown *= I64{2}
                next_bytes :: jet_rt_alloc_8(grown)
                if (used != I64{0}) -> rt_text_bytes_copy(next_bytes, bytes, used)
                if (capacity != I64{0}) -> jet_rt_free_8(bytes, capacity)
                bytes = next_bytes
                capacity = grown
            }
            rt_text_bytes_copy(wrapping(bytes + used), wrapping(buffer + position), count)
            used = required
            fd_put(reader, I64{56}, end)
            if found -> break
        }
    }
    fd_unlock(reader)
    if (failure < I64{0}) {
        if (capacity != I64{0}) -> jet_rt_free_8(bytes, capacity)
        return compiler_fs_errno(HOST_IO_OP_READ, fd_word(reader, I64{24}), -failure, error)
    }
    if (capacity == I64{0}) {
        rt_text_store(output, I64{0})
        rt_text_store(length, I64{0})
    } else {
        compiler_fs_bytes_take(bytes, capacity, used, output, length)
    }
    I64{1}
}
