// A 24B snapshot [iteration0,result8,runner16]. The harness TLS state keeps the
// runner's raw I64 pair; a snapshot holds both as owned exact-Int words, so
// `t.iteration` / `t.result` read in place and `run` returns its exact Int,
// jet_int_from_i64 did. The runner is a named-fn box using
// Lower/Closures.jet:3-16,291-315: [refs0,code8,release16], called with box
// first and inline pair output second. TLS uses the one dynamic-key mechanism,
// with detach owning its state free.
test_suite_key := I64{0}

fn rt_test_suite_state_drop_address() -> I64 {
    loop { jet_rt_unreachable(I64{0}, I64{0}) }
}

// runtime-init: 3 when test_suite_key
#Export(c) fn jet_rt_test_suite_init() {
    if (test_suite_key != I64{0}) -> return
    closure :: jet_rt_alloc(I64{24}, I64{8})
    trap_store(closure, I64{1})
    trap_store(wrapping(closure + I64{8}), rt_test_suite_state_drop_address())
    trap_store(wrapping(closure + I64{16}), I64{0})
    #Unsafe("runtime-init runs before any other thread exists") {
        test_suite_key = jet_rt_tls_key_new(closure)
    }
}

fn test_suite_state() -> I64 { jet_rt_tls_get(test_suite_key) }

fn test_suite_state_ensure() -> I64 {
    state := test_suite_state()
    if (state == I64{0}) {
        state = jet_rt_alloc(I64{24}, I64{8})
        thread_zero(state, I64{24})
        jet_rt_tls_set(test_suite_key, state)
    }
    state
}

// Runtime-only harness ingress, not a public Core API. The harness supplies a
// live, thread-confined named-fn box, never a capturing closure. One permanent
// process-lifetime pin per install intentionally leaks a reference to model the
// seed's static fn pointer: old snapshots remain valid even after reinstall.
// Match the generated non-atomic clone (Closures.jet:432-447); do not introduce
// an atomic/non-atomic mix or duplicate its unref/release logic (:407-427).
#Export(c) fn jet_test_suite_install(runner: I64) {
    trap_store(runner, trap_word(runner) + I64{1})
    state :: test_suite_state_ensure()
    trap_store(state, I64{0})
    trap_store(wrapping(state + I64{8}), I64{0})
    trap_store(wrapping(state + I64{16}), runner)
}

#Export(c) fn jet_test_suite_new() -> I64 {
    suite :: jet_rt_alloc(I64{24}, I64{8})
    state :: test_suite_state()
    if (state == I64{0}) {
        thread_zero(suite, I64{24})
    } else {
        trap_store(suite, jet_int_owned_from_i64(trap_word(state)))
        trap_store(wrapping(suite + I64{8}), jet_int_owned_from_i64(trap_word(wrapping(state + I64{8}))))
        trap_store(wrapping(suite + I64{16}), trap_word(wrapping(state + I64{16})))
    }
    suite
}

#Export(c) fn jet_rt_handle_clone_jet_test_suite(suite: I64) -> I64 {
    cloned :: jet_rt_alloc(I64{24}, I64{8})
    trap_store(cloned, jet_rt_int_clone(trap_word(suite)))
    trap_store(wrapping(cloned + I64{8}), jet_rt_int_clone(trap_word(wrapping(suite + I64{8}))))
    trap_store(wrapping(cloned + I64{16}), trap_word(wrapping(suite + I64{16})))
    cloned
}

#Export(c) fn jet_rt_handle_drop_jet_test_suite(suite: I64) {
    jet_rt_int_drop(trap_word(suite))
    jet_rt_int_drop(trap_word(wrapping(suite + I64{8})))
    jet_rt_free(suite, I64{24}, I64{8})
}

#Export(c) fn jet_test_suite_run(suite: I64) -> I64 {
    runner :: trap_word(wrapping(suite + I64{16}))
    if (runner == I64{0}) { return jet_rt_int_clone(trap_word(wrapping(suite + I64{8}))) }
    state :: test_suite_state_ensure()
    // The two inline result words go directly to TLS, never to the receiver.
    // Tuple result stores happen on return, after the runner's user code, so
    // no extra heap workspace or Rust/C pair-return convention is needed.
    #Unsafe("the pinned named-fn box code takes its box and writable inline 16B result storage") {
        _ := os_call_address_two_i64(trap_word(wrapping(runner + I64{8})), runner, state)
    }
    jet_int_owned_from_i64(trap_word(wrapping(state + I64{8})))
}

#Export(c) fn jet_test_suite_status() -> I64 {
    state :: test_suite_state()
    if (state == I64{0}) -> I64{0} else -> trap_word(wrapping(state + I64{8}))
}

// `t.<setting>(…)` (Registry/TestSettings.jet): in `jet test`'s plan step the
// environment variable `key` names the plan file, and `line`
// (`name<TAB>value<NL>`) is appended to it; any other run ignores the call.
// A plan the parent cannot read whole is a protocol failure (exit 103), as
// for the harness's own records (TestContracts.jet).
#Export(c) fn jet_test_setting(_suite: I64, key: I64, line: I64) {
    path :: rt_env_get(key)
    if (path == I64{0}) -> return
    error :: jet_rt_alloc(I64{8}, I64{8})
    trap_store(error, I64{0})
    if (jet_files_append_bytes_os(path, rt_text_data(line), rt_text_len(line), error) == I64{0}) {
        message :: jet_rt_handle_show_io_error(trap_word(error))
        jet_rt_test_eprint(message)
        jet_std_process_exit_owned(I64{103})
    }
    jet_rt_free(error, I64{8}, I64{8})
    jet_rt_string_drop(path)
}

#Export(c) fn jet_rt_test_suite_state_drop(_closure: I64, state: I64) -> I64 {
    // Thread clears the cell before this callback; only its state is owned.
    // The runner's intentional process-lifetime pin is never released here.
    jet_rt_free(state, I64{24}, I64{8})
    I64{0}
}

#Export(c) fn jet_rt_handle_show_jet_test_suite(suite: I64) -> I64 {
    text :: jet_rt_string_builder_new()
    rt_text_push_word(text, I64{0x69207b2074736554}, I64{8})
    rt_text_push_word(text, I64{0x6e6f697461726574}, I64{8})
    rt_text_push_word(text, I64{0x203a}, I64{2})
    rt_text_push_number(text, jet_int_owned_to_i64(trap_word(suite)))
    rt_text_push_word(text, I64{0x746c75736572202c}, I64{8})
    rt_text_push_word(text, I64{0x203a}, I64{2})
    rt_text_push_number(text, jet_int_owned_to_i64(trap_word(wrapping(suite + I64{8}))))
    rt_text_push_word(text, I64{0x7d20}, I64{2})
    text
}
