// The Rust original owns one OnceLock<RwLock<JetEnvEntries>>. Native main
// captures startup before threads and creates the process default cell; the
// first reader or writer (each calls jet_rt_logical_env_seed) seeds it, once,
// from the immutable startup byte index, which logical writes never change.
// A deterministic World owns a cell of its own (World.jet world_environment),
// seeded from the same startup index on its first use; while a World is
// active, every read and write goes to that cell, so a World and its
// descendants never read, change or clear the process default.
// Each cell: Shared's existing reader/writer protocol occupies bytes 0..79;
// once is @80 (process default only). The cell uses @56=head and @64=tail.
// Each owned entry is [next, compact key bytes, key length, compact value
// bytes, value length].
logical_env_root := I64{0}

LOGICAL_ENVIRONMENT_BYTES: I64{88}

logical_environment_copy: fn(bytes: I64, length: I64) -> I64 {
    if (length == I64{0}) { return I64{0} }
    owned: jet_rt_alloc(length, I64{1})
    rt_text_bytes_copy(owned, bytes, length)
    owned
}

logical_environment_find: fn(root: I64, bytes: I64, length: I64) -> I64 {
    entry := rt_text_word(wrapping(root + I64{56}))
    loop entry != (I64{0}) {
        if (rt_text_word(wrapping(entry + I64{16})) == length && rt_text_equal_bytes(rt_text_word(wrapping(entry + I64{8})), bytes, length)) { return entry }
        entry = rt_text_word(entry)
    }
    I64{0}
}

logical_environment_entry_free: fn(entry: I64) {
    jet_rt_free(rt_text_word(wrapping(entry + I64{8})), rt_text_word(wrapping(entry + I64{16})), I64{1})
    jet_rt_free(rt_text_word(wrapping(entry + I64{24})), rt_text_word(wrapping(entry + I64{32})), I64{1})
    jet_rt_free(entry, I64{40}, I64{8})
}

logical_environment_remove: fn(root: I64, entry: I64) {
    previous := I64{0}
    current := rt_text_word(wrapping(root + I64{56}))
    loop current != entry {
        previous = current
        current = rt_text_word(current)
    }
    next_entry: rt_text_word(entry)
    if (previous == I64{0}) -> rt_text_store(wrapping(root + I64{56}), next_entry)
    else -> rt_text_store(previous, next_entry)
    if (rt_text_word(wrapping(root + I64{64})) == entry) -> rt_text_store(wrapping(root + I64{64}), previous)
    logical_environment_entry_free(entry)
}

logical_environment_append: fn(root: I64, key: I64, key_length: I64, value: I64, value_length: I64) {
    // Rust removes an existing match, then pushes the new pair at the end.
    old: logical_environment_find(root, key, key_length)
    if (old != I64{0}) -> logical_environment_remove(root, old)
    entry: jet_rt_alloc(I64{40}, I64{8})
    rt_text_store(entry, I64{0})
    rt_text_store(wrapping(entry + I64{8}), logical_environment_copy(key, key_length))
    rt_text_store(wrapping(entry + I64{16}), key_length)
    rt_text_store(wrapping(entry + I64{24}), logical_environment_copy(value, value_length))
    rt_text_store(wrapping(entry + I64{32}), value_length)
    tail: rt_text_word(wrapping(root + I64{64}))
    if (tail == I64{0}) -> rt_text_store(wrapping(root + I64{56}), entry)
    else -> rt_text_store(tail, entry)
    rt_text_store(wrapping(root + I64{64}), entry)
}

// Appends every startup pair to `root`, in startup order.
logical_environment_fill: fn(root: I64) {
    index := I64{0}
    loop index < host_env_length {
        row: wrapping(host_env_rows + index * I64{24})
        key: rt_text_word(row)
        value: wrapping(key + rt_text_word(wrapping(row + I64{16})))
        logical_environment_append(root, key, rt_text_word(wrapping(row + I64{8})), value, host_startup_byte_length(value))
        index = wrapping(index + I64{1})
    }
}

logical_environment_seed: fn() {
    if !(sync_once_enter(wrapping(logical_env_root + I64{80}))) {
        return
    }
    logical_environment_fill(logical_env_root)
    sync_once_complete(wrapping(logical_env_root + I64{80}))
}

// A new cell holding the startup pairs; the caller owns it.
logical_environment_new: fn() -> I64 {
    host_environment_require()
    root: jet_rt_alloc(LOGICAL_ENVIRONMENT_BYTES, I64{8})
    thread_zero(root, LOGICAL_ENVIRONMENT_BYTES)
    logical_environment_fill(root)
    root
}

// Frees a cell from logical_environment_new and every entry in it.
logical_environment_drop: fn(root: I64) {
    entry := rt_text_word(wrapping(root + I64{56}))
    loop entry != (I64{0}) {
        next_entry: rt_text_word(entry)
        logical_environment_entry_free(entry)
        entry = next_entry
    }
    jet_rt_free(root, LOGICAL_ENVIRONMENT_BYTES, I64{8})
}

// Called only by the single-threaded host argument registration, before its
// published argc lets user code enter. No global-address intrinsic is needed.
// Seeding waits for the first use: every reader and writer seeds first, and
// the startup index it reads never changes, so a later seed holds the same
// pairs, and a program that never reads the environment never copies it.
logical_environment_startup: fn() {
    #Unsafe("host argument registration is single-threaded and precedes user code") {
        logical_env_root = jet_rt_alloc(LOGICAL_ENVIRONMENT_BYTES, I64{8})
    }
    thread_zero(logical_env_root, LOGICAL_ENVIRONMENT_BYTES)
}

#Export(c) jet_rt_logical_env_seed: fn() {
    host_environment_require()
    logical_environment_seed()
}

// The cell this thread reads and writes: the active World's own cell, else
// the seeded process default.
logical_environment_current: fn() -> I64 {
    world: world_current()
    if (world != I64{0}) -> return world_environment(world)
    jet_rt_logical_env_seed()
    logical_env_root
}

// The Rust original is Option<String>, not Result: absent and a present
// non-Unicode value both return None. Raw OS lookup preserves bytes.
#Export(c) jet_rt_logical_env_get: fn(key: I64) -> I64 {
    rt_test_reads_text(I64{69}, key)
    root: logical_environment_current()
    shared_acquire(root, false)
    entry: logical_environment_find(root, rt_text_data(key), rt_text_len(key))
    result := I64{0}
    if (entry != I64{0}) {
        bytes: rt_text_word(wrapping(entry + I64{24}))
        length: rt_text_word(wrapping(entry + I64{32}))
        at := I64{0}
        valid := true
        loop at < length {
            width: rt_text_valid_width(wrapping(bytes + at), length - at, I64{1})
            if (width < I64{0}) {
                valid = false
                break
            }
            at = wrapping(at + width)
        }
        if valid -> result = rt_text_copy(bytes, length)
    }
    shared_release(root, false)
    result
}

// Presence: 0 absent / 1 present. Both outputs are always initialized. Present
// empty is (1,0,0); nonempty bytes transfer one allocation, length/align=1.
#Export(c) jet_rt_logical_env_get_os: fn(key: I64, data_out: I64, len_out: I64) -> I64 {
    rt_test_reads_text(I64{69}, key)
    root: logical_environment_current()
    rt_text_store(data_out, I64{0})
    rt_text_store(len_out, I64{0})
    shared_acquire(root, false)
    entry: logical_environment_find(root, rt_text_data(key), rt_text_len(key))
    present := I64{0}
    if (entry != I64{0}) {
        length: rt_text_word(wrapping(entry + I64{32}))
        rt_text_store(data_out, logical_environment_copy(rt_text_word(wrapping(entry + I64{24})), length))
        rt_text_store(len_out, length)
        present = I64{1}
    }
    shared_release(root, false)
    present
}

logical_environment_valid_name: fn(name: I64) -> Bool {
    length: rt_text_len(name)
    if (length == I64{0}) { return false }
    at := I64{0}
    loop at < length {
        byte: rt_text_byte(wrapping(rt_text_data(name) + at))
        if (byte == I64{0} || byte == I64{61}) { return false }
        at = wrapping(at + I64{1})
    }
    true
}

// Status: 0 success, -1 InvalidName, -2 InvalidValue; no OS environment write.
#Export(c) jet_rt_logical_env_set: fn(key: I64, value: I64) -> I64 {
    if !(logical_environment_valid_name(key)) { return I64{-1} }
    at := I64{0}
    loop at < rt_text_len(value) {
        if (rt_text_byte(wrapping(rt_text_data(value) + at)) == I64{0}) { return I64{-2} }
        at = wrapping(at + I64{1})
    }
    root: logical_environment_current()
    shared_acquire(root, true)
    logical_environment_append(root, rt_text_data(key), rt_text_len(key), rt_text_data(value), rt_text_len(value))
    shared_release(root, true)
    I64{0}
}

// Status: 0 absent, 1 removed, -1 InvalidName.
#Export(c) jet_rt_logical_env_unset: fn(key: I64) -> I64 {
    if !(logical_environment_valid_name(key)) { return I64{-1} }
    root: logical_environment_current()
    shared_acquire(root, true)
    entry: logical_environment_find(root, rt_text_data(key), rt_text_len(key))
    removed := I64{0}
    if (entry != I64{0}) {
        logical_environment_remove(root, entry)
        removed = I64{1}
    }
    shared_release(root, true)
    removed
}
