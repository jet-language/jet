// The Rust original derive Clone/PartialEq.
#Export(c) jet_rt_record_new_watch_event: fn(domain: I64, kind: I64, path: I64, detail: I64, pid: I64, port: I64) -> I64 {
    if (domain < I64{0} || domain > I64{2} || kind < I64{0} || kind > I64{5}) {
        trap_native_index_range_stop()
        if (jet_scheduler_native_propagate() != I64{0}) -> return I64{0}
    }
    p: jet_int_owned_to_i64(pid)
    if (jet_scheduler_native_propagate() != I64{0}) -> return I64{0}
    n: jet_int_owned_to_i64(port)
    if (jet_scheduler_native_propagate() != I64{0}) -> return I64{0}
    value: jet_rt_alloc(WATCH_EVENT_BYTES, I64{8})
    dyn_store(wrapping(value + WATCH_EVENT_DOMAIN), domain)
    dyn_store(wrapping(value + WATCH_EVENT_KIND), kind)
    dyn_store(wrapping(value + WATCH_EVENT_PATH), jet_rt_string_clone(path))
    dyn_store(wrapping(value + WATCH_EVENT_DETAIL), jet_rt_string_clone(detail))
    dyn_store(wrapping(value + WATCH_EVENT_PID), p)
    dyn_store(wrapping(value + WATCH_EVENT_PORT), n)
    value
}
#Export(c) jet_rt_record_get_watch_event_domain: fn(value: I64) -> I64 { dyn_word(wrapping(value + WATCH_EVENT_DOMAIN)) }
#Export(c) jet_rt_record_get_watch_event_kind: fn(value: I64) -> I64 { dyn_word(wrapping(value + WATCH_EVENT_KIND)) }
#Export(c) jet_rt_record_get_watch_event_path: fn(value: I64) -> I64 { jet_rt_string_clone(dyn_word(wrapping(value + WATCH_EVENT_PATH))) }
#Export(c) jet_rt_record_get_watch_event_detail: fn(value: I64) -> I64 { jet_rt_string_clone(dyn_word(wrapping(value + WATCH_EVENT_DETAIL))) }
#Export(c) jet_rt_record_get_watch_event_pid: fn(value: I64) -> I64 { jet_int_owned_from_i64(dyn_word(wrapping(value + WATCH_EVENT_PID))) }
#Export(c) jet_rt_record_get_watch_event_port: fn(value: I64) -> I64 { jet_int_owned_from_i64(dyn_word(wrapping(value + WATCH_EVENT_PORT))) }
#Export(c) jet_rt_handle_clone_watch_event: fn(value: I64) -> I64 {
    result: jet_rt_alloc(WATCH_EVENT_BYTES, I64{8})
    coll_copy(value, result, WATCH_EVENT_BYTES)
    dyn_store(wrapping(result + WATCH_EVENT_PATH), jet_rt_string_clone(dyn_word(wrapping(value + WATCH_EVENT_PATH))))
    dyn_store(wrapping(result + WATCH_EVENT_DETAIL), jet_rt_string_clone(dyn_word(wrapping(value + WATCH_EVENT_DETAIL))))
    result
}
#Export(c) jet_rt_handle_drop_watch_event: fn(value: I64) {
    if (value == I64{0}) -> return
    jet_rt_string_drop(dyn_word(wrapping(value + WATCH_EVENT_PATH)))
    jet_rt_string_drop(dyn_word(wrapping(value + WATCH_EVENT_DETAIL)))
    jet_rt_free(value, WATCH_EVENT_BYTES, I64{8})
}
#Export(c) jet_rt_handle_eq_watch_event: fn(left: I64, right: I64) -> Bool {
    if dyn_word(wrapping(left + WATCH_EVENT_DOMAIN)) != dyn_word(wrapping(right + WATCH_EVENT_DOMAIN)) -> return false
    if dyn_word(wrapping(left + WATCH_EVENT_KIND)) != dyn_word(wrapping(right + WATCH_EVENT_KIND)) -> return false
    if !jet_rt_string_eq(dyn_word(wrapping(left + WATCH_EVENT_PATH)), dyn_word(wrapping(right + WATCH_EVENT_PATH))) -> return false
    if !jet_rt_string_eq(dyn_word(wrapping(left + WATCH_EVENT_DETAIL)), dyn_word(wrapping(right + WATCH_EVENT_DETAIL))) -> return false
    if dyn_word(wrapping(left + WATCH_EVENT_PID)) != dyn_word(wrapping(right + WATCH_EVENT_PID)) -> return false
    dyn_word(wrapping(left + WATCH_EVENT_PORT)) == dyn_word(wrapping(right + WATCH_EVENT_PORT))
}
// Custom JetShow omits pid/port and does NOT quote/escape path/detail. Stream
// into the existing builder, no formatter copy.
#Export(c) jet_rt_handle_show_watch_event: fn(value: I64) -> I64 {
    result: jet_rt_string_builder_new()
    jet_rt_string_builder_push(result, rt_static_text("WatchEvent {{ domain: "))
    domain: dyn_word(wrapping(value + WATCH_EVENT_DOMAIN))
    if (domain == I64{0}) { rt_text_push_word(result, I64{1701603654}, I64{4}) } else if (domain == I64{1}) { rt_text_push_word(result, I64{32496501618864720}, I64{7}) } else { rt_text_push_word(result, I64{1953656656}, I64{4}) }
    rt_text_push_word(result, I64{2322278983240720428}, I64{8})
    kind: dyn_word(wrapping(value + WATCH_EVENT_KIND))
    if (kind == I64{0}) { rt_text_push_word(result, I64{28259048195715651}, I64{7}) } else if (kind == I64{1}) { rt_text_push_word(result, I64{7234304265016340301}, I64{8}) } else if (kind == I64{2}) { rt_text_push_word(result, I64{28259057021052242}, I64{7}) } else if (kind == I64{3}) { rt_text_push_word(result, I64{491496043077}, I64{5}) } else if (kind == I64{4}) { rt_text_push_word(result, I64{110386907543621}, I64{6}) } else { rt_text_push_word(result, I64{521375147346}, I64{5}) }
    rt_text_push_word(result, I64{2322283406923145260}, I64{8})
    jet_rt_string_builder_push(result, dyn_word(wrapping(value + WATCH_EVENT_PATH)))
    rt_text_push_word(result, I64{7811882181195997228}, I64{8})
    rt_text_push_word(result, I64{8250}, I64{2})
    jet_rt_string_builder_push(result, dyn_word(wrapping(value + WATCH_EVENT_DETAIL)))
    rt_text_push_word(result, I64{32032}, I64{2})
    result
}
#Export(c) jet_rt_handle_clone_watch_kind: fn(value: I64) -> I64 { encoding_enum_clone(value) }
#Export(c) jet_rt_handle_drop_watch_kind: fn(value: I64) { encoding_enum_drop(value) }
#Export(c) jet_rt_handle_eq_watch_kind: fn(left: I64, right: I64) -> Bool { encoding_enum_eq(left, right) }
