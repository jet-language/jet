// Native execution. An authority-bound spec launches as its bubblewrap
// sandbox spec (ProcessExecutionAuthority); the child keeps the bound spec
// for its receipt.
// ExecutionChild168: mutex0 refs8 Child104*16 owned Spec192*24 worker32 done40
// receipt48 error56 waiter64 startNs72 output80 errors88 captured96 timeout104
// limit112 stop120 stdoutPipe128 stderrPipe136 stdoutAt144 stderrAt152
// reader160.
// Worker owns one ref; every public alias owns one ref. waiter is the park
// slot (one reference) of the first explicit waiter, woken when done is set.
// Each pipe is the Pipe40 cell the child lends as `child.stdout` /
// `child.stderr`, made on first use; each At is how far its readers have
// consumed that capture. reader is the park slot (one reference) of the first
// stream reader waiting for captured bytes, woken when the collector captures
// bytes, closes a stream or sets done.
PROCESS_EXECUTION_BYTES: I64{168}
PROCESS_EXECUTION_STDOUT: I64{128}
PROCESS_EXECUTION_STDERR: I64{136}
PROCESS_EXECUTION_READER: I64{160}
rt_process_execution_worker_address: fn() -> I64 { loop { jet_rt_unreachable(I64{0}, I64{0}) } }
process_execution_native: fn(child: I64) -> I64 { fd_word(child, I64{16}) }
process_execution_now: fn() -> I64 { sync_now_ns() }
// A refused `.keep_open(handle, at:)` is reported before any child exists.
// So is a kept handle on an authority-bound spec: its sandbox plan and
// receipt would not name the descriptor the child received.
process_execution_keep_refused: fn(spec: I64, err: I64) -> Bool {
    refusal: fd_word(spec, PROCESS_SPEC_KEEP_REFUSAL)
    if (refusal == PROCESS_KEEP_REFUSED_SLOT) {
        _ := process_execution_invalid(spec, rt_static_text("keep_open needs a descriptor slot from 3 to 2147483646; 0 to 2 are the standard streams"), err)
        return true
    }
    if (refusal == PROCESS_KEEP_REFUSED_TAKEN) {
        _ := process_execution_invalid(spec, rt_static_text("keep_open's descriptor slot is already kept for this process"), err)
        return true
    }
    if (refusal > I64{0}) {
        _ := compiler_fs_error(HOST_IO_KIND_OTHER, HOST_IO_OP_RESOLVE, process_execution_resource(spec), refusal, host_errno_cause(refusal), err)
        return true
    }
    if !process_authority_bound(spec) -> return false
    dirs: fd_word(spec, PROCESS_SPEC_DIRECTORIES)
    if (dirs == I64{0}) -> return false
    at := I64{0}
    loop at < fd_word(dirs, I64{0}) {
        if (fd_word(fd_word(dirs, I64{16}), at * I64{24} + I64{8}) >= I64{3}) {
            _ := process_authority_refuse(spec, rt_static_text("authority-bound process execution cannot keep a parent handle open; refusing before spawn"), err)
            return true
        }
        at += I64{1}
    }
    false
}
process_execution_launch: fn(spec: I64, collect: Bool, err: I64) -> I64 {
    jet_rt_world_reject_uncontrolled(I64{0})
    if (jet_scheduler_native_propagate() != I64{0}) -> return I64{0}
    if process_execution_keep_refused(spec, err) -> return I64{0}
    sandboxed := I64{0}
    if process_authority_bound(spec) {
        sandboxed = process_authority_sandbox(spec, err)
        if (sandboxed == I64{0}) -> return I64{0}
    }
    native: process_execution_launch_native(if (sandboxed == I64{0}) -> spec else -> sandboxed, err)
    jet_rt_handle_drop_process_spec(sandboxed)
    if (native == I64{0}) -> return I64{0}
    child: jet_rt_alloc(PROCESS_EXECUTION_BYTES, I64{8})
    coll_zero(child, PROCESS_EXECUTION_BYTES)
    fd_put(child, I64{8}, I64{1})
    fd_put(child, I64{16}, native)
    fd_put(child, I64{24}, process_spec_clone(spec, false))
    fd_put(child, I64{72}, process_execution_now())
    fd_put(child, I64{80}, jet_rt_string_builder_new())
    fd_put(child, I64{88}, jet_rt_string_builder_new())
    if (collect && !process_execution_collect_start(child, err)) {
        jet_rt_handle_drop_process_child(child)
        return I64{0}
    }
    child
}
#Export(c) jet_process_spec_plan: fn(spec: I64, ok: I64, err: I64) -> I64 {
    if process_execution_keep_refused(spec, err) -> return I64{0}
    if !process_authority_bound(spec) -> return process_execution_invalid(spec, rt_static_text("ProcessSpec.plan() requires an authority policy from .under(...)"), err)
    plan: process_authority_plan(spec, I64{0}, err)
    if (plan == I64{0}) -> return I64{0}
    fd_put(ok, I64{0}, plan)
    I64{1}
}
#Export(c) jet_process_spec_spawn: fn(spec: I64, ok: I64, err: I64) -> I64 {
    child: process_execution_launch(spec, true, err)
    if (child == I64{0}) -> return I64{0}
    fd_put(ok, I64{0}, child)
    I64{1}
}
#Export(c) jet_process_spec_run: fn(spec: I64, ok: I64, err: I64) -> I64 {
    child: process_execution_launch(spec, true, err)
    if (child == I64{0}) -> return I64{0}
    result: process_execution_wait(child, ok, err)
    jet_rt_handle_drop_process_child(child)
    result
}
#Export(c) jet_process_spec_run_checked: fn(spec: I64, ok: I64, err: I64) -> I64 {
    scratch: jet_rt_alloc(I64{8}, I64{8})
    result: jet_process_spec_run(spec, scratch, err)
    if (result == I64{0}) {
        jet_rt_free(scratch, I64{8}, I64{8})
        return I64{0}
    }
    receipt: fd_word(scratch, I64{0})
    jet_rt_free(scratch, I64{8}, I64{8})
    if (fd_word(receipt, I64{24}) != I64{0}) {
        fd_put(ok, I64{0}, receipt)
        return I64{1}
    }
    cause: jet_rt_string_builder_new()
    jet_rt_string_builder_push(cause, rt_static_text("process exited unsuccessfully: code="))
    rt_text_push_number(cause, jet_int_owned_to_i64(fd_word(receipt, I64{0})))
    signal: fd_word(receipt, I64{32})
    if (signal != INT_OPTION_NONE) {
        jet_rt_string_builder_push(cause, rt_static_text(", signal="))
        rt_text_push_number(cause, jet_int_owned_to_i64(signal))
    }
    jet_rt_string_builder_push(cause, rt_static_text(", stderr="))
    errors: fd_word(receipt, I64{16})
    end := if (rt_text_len(errors) > I64{4096}) -> { I64{4096} } else -> { rt_text_len(errors) }
    loop end > (I64{0}) && end < rt_text_len(errors) && rt_text_byte(wrapping(rt_text_data(errors) + end)).bit_and(I64{192}) == (I64{128}) -> end -= I64{1}
    rt_text_append(cause, rt_text_data(errors), end)
    jet_rt_handle_drop_process_receipt(receipt)
    process_execution_error(spec, HOST_IO_OP_CLOSE, jet_rt_string_builder_finish(cause), err)
}
#Export(c) jet_process_child_wait: fn(child: I64, ok: I64, err: I64) -> I64 { process_execution_wait(child, ok, err) }
#Export(c) jet_process_child_id: fn(child: I64) -> I64 {
    jet_int_owned_from_i64(if (fd_word(child, I64{120}).bit_and(I64{2}) != I64{0}) -> { I64{0} } else -> { fd_word(process_execution_native(child), I64{8}) })
}
#Export(c) jet_rt_handle_show_process_child: fn(_child: I64) -> I64 { jet_rt_string_clone(rt_static_text("ProcessChild")) }
