// HTTPMessage.rs:195-270: Clone/PartialEq/JetShow for five HTTP primitives.
// Text wrappers are the E4 owner itself, not an extra box. Status and Version
// own the EncodingABI one-word carrier; no Rust layout participates.
#Export(c) fn jet_rt_handle_clone_JetHTTPMethod(value: I64) -> I64 { jet_rt_string_clone(value) }
#Export(c) fn jet_rt_handle_drop_JetHTTPMethod(value: I64) { jet_rt_string_drop(value) }
#Export(c) fn jet_rt_handle_eq_JetHTTPMethod(left: I64, right: I64) -> Bool { jet_rt_string_eq(left, right) }
#Export(c) fn jet_rt_handle_show_JetHTTPMethod(value: I64) -> I64 { jet_rt_string_clone(value) }
#Export(c) fn jet_rt_handle_clone_JetHTTPHeaderName(value: I64) -> I64 { jet_rt_string_clone(value) }
#Export(c) fn jet_rt_handle_drop_JetHTTPHeaderName(value: I64) { jet_rt_string_drop(value) }
#Export(c) fn jet_rt_handle_eq_JetHTTPHeaderName(left: I64, right: I64) -> Bool { jet_rt_string_eq(left, right) }
#Export(c) fn jet_rt_handle_show_JetHTTPHeaderName(value: I64) -> I64 { jet_rt_string_clone(value) }
#Export(c) fn jet_rt_handle_clone_JetHTTPHeaderValue(value: I64) -> I64 { jet_rt_string_clone(value) }
#Export(c) fn jet_rt_handle_drop_JetHTTPHeaderValue(value: I64) { jet_rt_string_drop(value) }
#Export(c) fn jet_rt_handle_eq_JetHTTPHeaderValue(left: I64, right: I64) -> Bool { jet_rt_string_eq(left, right) }
#Export(c) fn jet_rt_handle_show_JetHTTPHeaderValue(value: I64) -> I64 { jet_rt_string_clone(value) }
#Export(c) fn jet_rt_handle_clone_JetHTTPStatus(value: I64) -> I64 { encoding_enum_clone(value) }
#Export(c) fn jet_rt_handle_drop_JetHTTPStatus(value: I64) { encoding_enum_drop(value) }
#Export(c) fn jet_rt_handle_eq_JetHTTPStatus(left: I64, right: I64) -> Bool { encoding_enum_eq(left, right) }
#Export(c) fn jet_rt_handle_show_JetHTTPStatus(value: I64) -> I64 {
    jet_rt_i64_to_string(encoding_word(value + ENCODING_ENUM_TAG))
}
#Export(c) fn jet_rt_handle_clone_JetHTTPVersion(value: I64) -> I64 { encoding_enum_clone(value) }
#Export(c) fn jet_rt_handle_drop_JetHTTPVersion(value: I64) { encoding_enum_drop(value) }
#Export(c) fn jet_rt_handle_eq_JetHTTPVersion(left: I64, right: I64) -> Bool { encoding_enum_eq(left, right) }
#Export(c) fn jet_rt_handle_show_JetHTTPVersion(value: I64) -> I64 {
    ordinal :: encoding_word(value + ENCODING_ENUM_TAG)
    if (ordinal == I64{0}) -> return display_literal(I64{3471766442030158920}, I64{8}) // HTTP/1.0
    if (ordinal == I64{1}) -> return display_literal(I64{3543824036068086856}, I64{8}) // HTTP/1.1
    if (ordinal == I64{2}) -> return display_literal(I64{55178792555592}, I64{6}) // HTTP/2
    jet_rt_unreachable(I64{0}, I64{0})
    I64{0} // unreachable provider terminates with status 101
}
