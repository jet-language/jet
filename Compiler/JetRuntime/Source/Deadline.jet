// #Context deadlines use absolute wall-millisecond budget in the current Context record
// (Context.jet). Save slots are {present, ms}; no ownership transfer.
deadline_ms_to_ns: fn(ms: I64) -> I64 {
    if (ms <= I64{0}) -> return I64{0}
    if (ms > I64{9223372036854}) -> I64{9223372036854775807} else -> ms * I64{1000000}
}

jet_ctx_deadline_present: fn() -> Bool { sync_load(wrapping(context_current() + CONTEXT_DEADLINE_PRESENT)) != I64{0} }
jet_ctx_deadline_ms: fn() -> I64 { sync_load(wrapping(context_current() + CONTEXT_DEADLINE_MS)) }

#Export(c) jet_ctx_push_deadline: fn(deadline_ms: I64, save: I64) {
    record: context_current()
    sync_store(save, sync_load(wrapping(record + CONTEXT_DEADLINE_PRESENT)))
    sync_store(wrapping(save + I64{8}), sync_load(wrapping(record + CONTEXT_DEADLINE_MS)))
    sync_store(wrapping(record + CONTEXT_DEADLINE_PRESENT), I64{1})
    sync_store(wrapping(record + CONTEXT_DEADLINE_MS), deadline_ms)
}
#Export(c) jet_ctx_pop_deadline: fn(save: I64) {
    record: context_current()
    sync_store(wrapping(record + CONTEXT_DEADLINE_PRESENT), sync_load(save))
    sync_store(wrapping(record + CONTEXT_DEADLINE_MS), sync_load(wrapping(save + I64{8})))
}
#Export(c) jet_ctx_set_deadline_min: fn(deadline_ms: I64) {
    if !jet_ctx_deadline_present() || deadline_ms < jet_ctx_deadline_ms() {
        sync_store(wrapping(context_current() + CONTEXT_DEADLINE_PRESENT), I64{1})
        sync_store(wrapping(context_current() + CONTEXT_DEADLINE_MS), deadline_ms)
    }
}
// `task.timeout(duration)`: the task deadline becomes the
// earlier of the installed one and now plus the Duration's whole
// milliseconds, a negative delay counting as none (Rust
// jet_task_timeout_duration_ns).
#Export(c) jet_task_timeout_duration_ns: fn(nanos: I64) {
    millis: if (nanos <= I64{0}) -> I64{0} else -> nanos /% I64{1000000}
    now: jet_std_time_now()
    jet_ctx_set_deadline_min(if (now > I64{9223372036854775807} - millis) -> I64{9223372036854775807} else -> now + millis)
}

// Rust str::parse has no whitespace trimming, accepts one leading '+'; signed
// parsing also accepts '-'. out is an exclusively borrowed word. Negative
// accumulation admits i64::MIN without negation overflow.
deadline_parse_i64: fn(text: I64, out: I64) -> Bool {
    if (text == I64{0}) -> return false
    length: sync_load(wrapping(text + I64{8}))
    if (length == I64{0}) -> return false
    data: sync_load(text)
    at := I64{0}
    negative := false
    first: trap_byte(data)
    if (first == I64{43} || first == I64{45}) {
        negative = first == I64{45}
        at = I64{1}
        if at == length -> return false
    }
    value := I64{0}
    limit: if negative -> I64{-9223372036854775808} else -> I64{-9223372036854775807}
    loop at < length {
        byte: trap_byte(wrapping(data + at))
        if (byte < I64{48} || byte > I64{57}) -> return false
        digit: byte - I64{48}
        // /% floors negative values; the multiply guard needs truncation.
        if (value < I64{-922337203685477580}) -> return false
        multiplied: value * I64{10}
        if multiplied < limit + digit -> return false
        value = multiplied - digit
        at += I64{1}
    }
    sync_store(out, if negative -> value else -> -value)
    true
}

deadline_wall_now_ms: fn() -> I64 {
    scratch: wrapping(thread_base() + I64{232})
    sync_clock_read(I64{0}, scratch)
    seconds: sync_load(scratch)
    if (seconds < I64{0}) -> return I64{0}
    wrapping(seconds * I64{1000} + sync_load(wrapping(scratch + I64{8})) /% I64{1000000})
}

// CoreReview2 #49 Rust's std::env reads the immutable host
// startup capture, never the Jet env overlay. RtL7 owns the one rt_env_get view.
// That capture never changes, so the replay or epoch override it names is
// parsed once (time_host_root @32..55) instead of on every clock read.
jet_std_time_now: fn() -> I64 {
    world: world_current()
    if (world != I64{0}) -> return jet_world_now(world)
    root: time_host_root
    once: wrapping(root + I64{32})
    if sync_once_enter(once) {
        value: wrapping(root + I64{48})
        key: scheduler_msg_replay()
        replay: rt_env_get(key)
        jet_rt_string_drop(key)
        accepted := deadline_parse_i64(replay, value)
        jet_rt_string_drop(replay)
        if !accepted {
            epoch_key: scheduler_msg_epoch()
            epoch: rt_env_get(epoch_key)
            jet_rt_string_drop(epoch_key)
            accepted = deadline_parse_i64(epoch, value)
            jet_rt_string_drop(epoch)
        }
        sync_store(wrapping(root + I64{40}), if accepted -> I64{1} else -> I64{0})
        sync_once_complete(once)
    }
    if (sync_load(wrapping(root + I64{40})) != I64{0}) -> return sync_load(wrapping(root + I64{48}))
    deadline_wall_now_ms()
}

jet_deadline_remaining_ms: fn() -> I64 {
    if !jet_ctx_deadline_present() -> return I64{9223372036854775807}
    deadline: jet_ctx_deadline_ms()
    now: jet_std_time_now()
    if (now > I64{0} && deadline < I64{-9223372036854775808} + now) -> return I64{-9223372036854775808}
    if (now < I64{0} && deadline > I64{9223372036854775807} + now) -> return I64{9223372036854775807}
    deadline - now
}

scheduler_deadline_message: fn(wait_kind: I64) -> I64 {
    head: scheduler_msg_deadline_head()
    middle: scheduler_text_concat(head, wait_kind)
    jet_rt_string_drop(head)
    tail: scheduler_msg_deadline_tail()
    result: scheduler_text_concat(middle, tail)
    jet_rt_string_drop(middle)
    jet_rt_string_drop(tail)
    result
}

scheduler_deliver_deadline: fn(wait_kind: I64) {
    _ := scheduler_native_publish(scheduler_stop_new(I64{2}, scheduler_deadline_message(wait_kind)))
}

scheduler_deadline_check: fn(wait_kind: I64) -> I64 {
    if (!scheduler_shielded() && jet_ctx_deadline_present() && jet_deadline_remaining_ms() <= I64{0}) -> scheduler_deliver_deadline(wait_kind)
    jet_scheduler_native_propagate()
}
