// #Context deadlines use the same absolute wall-millisecond budget as Rust
// Deadline.rs. Save slots are two words {present, ms}; no ownership transfer.
fn deadline_ms_to_ns(ms: I64) -> I64 {
    if (ms <= I64{0}) -> return I64{0}
    if (ms > I64{9223372036854}) -> I64{9223372036854775807} else -> ms * I64{1000000}
}

fn jet_ctx_deadline_present() -> Bool { sync_load(thread_base() + I64{48}) != I64{0} }
fn jet_ctx_deadline_ms() -> I64 { sync_load(thread_base() + I64{56}) }

#Export(c) fn jet_ctx_push_deadline(deadline_ms: I64, save: I64) {
    base :: thread_base()
    sync_store(save, sync_load(base + I64{48}))
    sync_store(save + I64{8}, sync_load(base + I64{56}))
    sync_store(base + I64{48}, I64{1})
    sync_store(base + I64{56}, deadline_ms)
}
#Export(c) fn jet_ctx_pop_deadline(save: I64) {
    base :: thread_base()
    sync_store(base + I64{48}, sync_load(save))
    sync_store(base + I64{56}, sync_load(save + I64{8}))
}
#Export(c) fn jet_ctx_set_deadline_min(deadline_ms: I64) {
    if !jet_ctx_deadline_present() || deadline_ms < jet_ctx_deadline_ms() {
        sync_store(thread_base() + I64{48}, I64{1})
        sync_store(thread_base() + I64{56}, deadline_ms)
    }
}

// Rust str::parse has no whitespace trimming, accepts one leading '+'; signed
// parsing also accepts '-'. out is an exclusively borrowed word. Negative
// accumulation admits i64::MIN without negation overflow.
fn deadline_parse_i64(text: I64, out: I64) -> Bool {
    if (text == I64{0}) -> return false
    length :: sync_load(text + I64{8})
    if (length == I64{0}) -> return false
    data :: sync_load(text)
    at := I64{0}
    negative := false
    first :: trap_byte(data)
    if (first == I64{43} || first == I64{45}) {
        negative = first == I64{45}
        at = I64{1}
        if at == length -> return false
    }
    value := I64{0}
    limit :: if negative -> I64{-9223372036854775808} else -> I64{-9223372036854775807}
    loop at < length {
        byte :: trap_byte(data + at)
        if (byte < I64{48} || byte > I64{57}) -> return false
        digit :: byte - I64{48}
        // /% floors negative values; the multiply guard needs truncation.
        if (value < I64{-922337203685477580}) -> return false
        multiplied :: value * I64{10}
        if multiplied < limit + digit -> return false
        value = multiplied - digit
        at += I64{1}
    }
    sync_store(out, if negative -> value else -> -value)
    true
}

fn deadline_wall_now_ms() -> I64 {
    scratch :: thread_base() + I64{232}
    #Unsafe("clock_gettime writes two thread-owned TCB words, not retained after the syscall") {
        result :: os_syscall_i64(I64{228}, I64{0}, scratch, I64{0}, I64{0}, I64{0}, I64{0})
        if (result != I64{0}) -> jet_rt_unreachable(I64{0}, I64{0})
    }
    seconds :: sync_load(scratch)
    if (seconds < I64{0}) -> return I64{0}
    wrapping(seconds * I64{1000} + sync_load(scratch + I64{8}) /% I64{1000000})
}

// CoreReview2 #49 / D-ENV-MUTATE1=A: Rust's std::env reads the immutable host
// startup capture, never the Jet env overlay. RtL7 owns the one rt_env_get view.
fn jet_std_time_now() -> I64 {
    world :: world_current()
    if (world != I64{0}) -> return jet_world_now(world)
    key :: scheduler_msg_replay()
    replay :: rt_env_get(key)
    jet_rt_string_drop(key)
    scratch :: thread_base() + I64{248}
    accepted :: deadline_parse_i64(replay, scratch)
    jet_rt_string_drop(replay)
    if accepted -> return sync_load(scratch)
    epoch_key :: scheduler_msg_epoch()
    epoch :: rt_env_get(epoch_key)
    jet_rt_string_drop(epoch_key)
    epoch_accepted :: deadline_parse_i64(epoch, scratch)
    jet_rt_string_drop(epoch)
    if epoch_accepted -> return sync_load(scratch)
    deadline_wall_now_ms()
}

fn jet_deadline_remaining_ms() -> I64 {
    if !jet_ctx_deadline_present() -> return I64{9223372036854775807}
    deadline :: jet_ctx_deadline_ms()
    now :: jet_std_time_now()
    if (now > I64{0} && deadline < I64{-9223372036854775808} + now) -> return I64{-9223372036854775808}
    if (now < I64{0} && deadline > I64{9223372036854775807} + now) -> return I64{9223372036854775807}
    deadline - now
}

fn scheduler_deadline_message(wait_kind: I64) -> I64 {
    head :: scheduler_msg_deadline_head()
    middle :: scheduler_text_concat(head, wait_kind)
    jet_rt_string_drop(head)
    tail :: scheduler_msg_deadline_tail()
    result :: scheduler_text_concat(middle, tail)
    jet_rt_string_drop(middle)
    jet_rt_string_drop(tail)
    result
}

fn scheduler_deliver_deadline(wait_kind: I64) {
    _ := scheduler_native_publish(scheduler_stop_new(I64{2}, scheduler_deadline_message(wait_kind)))
}

fn scheduler_deadline_check(wait_kind: I64) -> I64 {
    if (!scheduler_shielded() && jet_ctx_deadline_present() && jet_deadline_remaining_ms() <= I64{0}) -> scheduler_deliver_deadline(wait_kind)
    jet_scheduler_native_propagate()
}
