#Export(c) fn jet_rt_record_get_JetNetError_ConnectionReset(value: I64) -> I64 { net_error_get(value, NET_ERROR_CONNECTION_RESET) }
#Export(c) fn jet_rt_record_new_JetNetError_NotConnected(payload: I64) -> I64 { net_error_new(NET_ERROR_NOT_CONNECTED, payload) }
#Export(c) fn jet_rt_record_get_JetNetError_NotConnected(value: I64) -> I64 { net_error_get(value, NET_ERROR_NOT_CONNECTED) }
#Export(c) fn jet_rt_record_new_JetNetError_Closed(payload: I64) -> I64 { net_error_new(NET_ERROR_CLOSED, payload) }
#Export(c) fn jet_rt_record_get_JetNetError_Closed(value: I64) -> I64 { net_error_get(value, NET_ERROR_CLOSED) }
