#Export(c) jet_rt_record_get_jet_net_error_unsupported: fn(value: I64) -> I64 { net_error_get(value, NET_ERROR_UNSUPPORTED) }
#Export(c) jet_rt_record_new_jet_net_error_dns: fn(payload: I64) -> I64 { net_error_new(NET_ERROR_DNS, payload) }
#Export(c) jet_rt_record_get_jet_net_error_dns: fn(value: I64) -> I64 { net_error_get(value, NET_ERROR_DNS) }
#Export(c) jet_rt_record_new_jet_net_error_tls: fn(payload: I64) -> I64 { net_error_new(NET_ERROR_TLS, payload) }
#Export(c) jet_rt_record_get_jet_net_error_tls: fn(value: I64) -> I64 { net_error_get(value, NET_ERROR_TLS) }
