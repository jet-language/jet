#Export(c) jet_rt_record_get_jet_net_error_address_unavailable: fn(value: I64) -> I64 { net_error_get(value, NET_ERROR_ADDRESS_UNAVAILABLE) }
#Export(c) jet_rt_record_new_jet_net_error_connection_refused: fn(payload: I64) -> I64 { net_error_new(NET_ERROR_CONNECTION_REFUSED, payload) }
#Export(c) jet_rt_record_get_jet_net_error_connection_refused: fn(value: I64) -> I64 { net_error_get(value, NET_ERROR_CONNECTION_REFUSED) }
#Export(c) jet_rt_record_new_jet_net_error_connection_reset: fn(payload: I64) -> I64 { net_error_new(NET_ERROR_CONNECTION_RESET, payload) }
#Export(c) jet_rt_record_get_jet_net_error_connection_reset: fn(value: I64) -> I64 { net_error_get(value, NET_ERROR_CONNECTION_RESET) }
#Export(c) jet_rt_record_new_jet_net_error_not_connected: fn(payload: I64) -> I64 { net_error_new(NET_ERROR_NOT_CONNECTED, payload) }
#Export(c) jet_rt_record_get_jet_net_error_not_connected: fn(value: I64) -> I64 { net_error_get(value, NET_ERROR_NOT_CONNECTED) }
#Export(c) jet_rt_record_new_jet_net_error_closed: fn(payload: I64) -> I64 { net_error_new(NET_ERROR_CLOSED, payload) }
#Export(c) jet_rt_record_get_jet_net_error_closed: fn(value: I64) -> I64 { net_error_get(value, NET_ERROR_CLOSED) }
#Export(c) jet_rt_record_new_jet_net_error_timeout: fn(payload: I64) -> I64 { net_error_new(NET_ERROR_TIMEOUT, payload) }
#Export(c) jet_rt_record_get_jet_net_error_timeout: fn(value: I64) -> I64 { net_error_get(value, NET_ERROR_TIMEOUT) }
