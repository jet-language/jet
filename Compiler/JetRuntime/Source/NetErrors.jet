// The Rust original derives clone/eq. Reuse
// EncodingErrors raw-word/optional-int helpers; native layouts are separate.
net_optional_text_clone: fn(text: I64) -> I64 {
    if (text == I64{0}) -> I64{0} else -> jet_rt_string_clone(text)
}
net_optional_text_input: fn(pointer: I64) -> I64 {
    if (pointer == I64{0}) -> I64{0} else -> jet_rt_string_clone(encoding_word(pointer))
}
net_optional_text_eq: fn(left: I64, right: I64) -> Bool {
    if (left == I64{0} || right == I64{0}) -> return left == right
    jet_rt_string_eq(left, right)
}
net_optional_text_get: fn(value: I64, field: I64, some: I64) -> I64 {
    text: encoding_word(wrapping(value + field))
    if (text == I64{0}) -> return I64{0}
    encoding_store(some, jet_rt_string_clone(text))
    I64{1}
}
#Export(c) jet_rt_record_new_jet_net_error_detail: fn(operation: I64, address: I64, name: I64, message: I64, os_code: I64) -> I64 {
    // Convert optional exact Int before allocation; text pointer options borrow.
    code: encoding_optional_input(os_code)
    result: jet_rt_alloc(NET_DETAIL_BYTES, I64{8})
    encoding_store(wrapping(result + NET_DETAIL_OPERATION), jet_rt_string_clone(operation))
    encoding_store(wrapping(result + NET_DETAIL_ADDRESS), net_optional_text_input(address))
    encoding_store(wrapping(result + NET_DETAIL_NAME), net_optional_text_input(name))
    encoding_store(wrapping(result + NET_DETAIL_MESSAGE), jet_rt_string_clone(message))
    encoding_store(wrapping(result + NET_DETAIL_OS_PRESENT), if (os_code == I64{0}) -> I64{0} else -> I64{1})
    encoding_store(wrapping(result + NET_DETAIL_OS_CODE), code)
    result
}
#Export(c) jet_rt_handle_clone_jet_net_error_detail: fn(value: I64) -> I64 {
    result: jet_rt_alloc(NET_DETAIL_BYTES, I64{8})
    encoding_store(wrapping(result + NET_DETAIL_OPERATION), jet_rt_string_clone(encoding_word(wrapping(value + NET_DETAIL_OPERATION))))
    encoding_store(wrapping(result + NET_DETAIL_ADDRESS), net_optional_text_clone(encoding_word(wrapping(value + NET_DETAIL_ADDRESS))))
    encoding_store(wrapping(result + NET_DETAIL_NAME), net_optional_text_clone(encoding_word(wrapping(value + NET_DETAIL_NAME))))
    encoding_store(wrapping(result + NET_DETAIL_MESSAGE), jet_rt_string_clone(encoding_word(wrapping(value + NET_DETAIL_MESSAGE))))
    encoding_store(wrapping(result + NET_DETAIL_OS_PRESENT), encoding_word(wrapping(value + NET_DETAIL_OS_PRESENT)))
    encoding_store(wrapping(result + NET_DETAIL_OS_CODE), encoding_word(wrapping(value + NET_DETAIL_OS_CODE)))
    result
}
#Export(c) jet_rt_handle_drop_jet_net_error_detail: fn(value: I64) {
    if (value == I64{0}) -> return
    jet_rt_string_drop(encoding_word(wrapping(value + NET_DETAIL_OPERATION)))
    jet_rt_string_drop(encoding_word(wrapping(value + NET_DETAIL_ADDRESS)))
    jet_rt_string_drop(encoding_word(wrapping(value + NET_DETAIL_NAME)))
    jet_rt_string_drop(encoding_word(wrapping(value + NET_DETAIL_MESSAGE)))
    jet_rt_free(value, NET_DETAIL_BYTES, I64{8})
}
#Export(c) jet_rt_handle_eq_jet_net_error_detail: fn(left: I64, right: I64) -> Bool {
    jet_rt_string_eq(encoding_word(wrapping(left + NET_DETAIL_OPERATION)), encoding_word(wrapping(right + NET_DETAIL_OPERATION))) &&
        net_optional_text_eq(encoding_word(wrapping(left + NET_DETAIL_ADDRESS)), encoding_word(wrapping(right + NET_DETAIL_ADDRESS))) &&
        net_optional_text_eq(encoding_word(wrapping(left + NET_DETAIL_NAME)), encoding_word(wrapping(right + NET_DETAIL_NAME))) &&
        jet_rt_string_eq(encoding_word(wrapping(left + NET_DETAIL_MESSAGE)), encoding_word(wrapping(right + NET_DETAIL_MESSAGE))) &&
        encoding_optional_eq(left, right, NET_DETAIL_OS_PRESENT, NET_DETAIL_OS_CODE)
}
#Export(c) jet_rt_record_get_jet_net_error_detail_operation: fn(value: I64) -> I64 { jet_rt_string_clone(encoding_word(wrapping(value + NET_DETAIL_OPERATION))) }
#Export(c) jet_rt_record_get_jet_net_error_detail_address: fn(value: I64, some: I64) -> I64 { net_optional_text_get(value, NET_DETAIL_ADDRESS, some) }
#Export(c) jet_rt_record_get_jet_net_error_detail_name: fn(value: I64, some: I64) -> I64 { net_optional_text_get(value, NET_DETAIL_NAME, some) }
#Export(c) jet_rt_record_get_jet_net_error_detail_message: fn(value: I64) -> I64 { jet_rt_string_clone(encoding_word(wrapping(value + NET_DETAIL_MESSAGE))) }
#Export(c) jet_rt_record_get_jet_net_error_detail_os_code: fn(value: I64, some: I64) -> I64 { encoding_optional_get(value, NET_DETAIL_OS_PRESENT, NET_DETAIL_OS_CODE, some) }
net_dns_new: fn(ordinal: I64, text: I64) -> I64 {
    if (ordinal < NET_DNS_NOT_FOUND || ordinal > NET_DNS_FAILURE) -> trap_native_index_range_stop()
    result: jet_rt_alloc(NET_DNS_BYTES, I64{8})
    encoding_store(wrapping(result + NET_DNS_TAG), ordinal)
    encoding_store(wrapping(result + NET_DNS_TEXT), jet_rt_string_clone(text))
    result
}
net_dns_get: fn(value: I64, ordinal: I64) -> I64 {
    if encoding_word(wrapping(value + NET_DNS_TAG)) != ordinal -> rt_record_variant_panic()
    jet_rt_string_clone(encoding_word(wrapping(value + NET_DNS_TEXT)))
}
#Export(c) jet_rt_record_tag_jet_net_dns_error: fn(value: I64) -> I64 { encoding_word(wrapping(value + NET_DNS_TAG)) }
#Export(c) jet_rt_record_new_jet_net_dns_error_not_found: fn(text: I64) -> I64 { net_dns_new(NET_DNS_NOT_FOUND, text) }
#Export(c) jet_rt_record_new_jet_net_dns_error_failure: fn(text: I64) -> I64 { net_dns_new(NET_DNS_FAILURE, text) }
#Export(c) jet_rt_record_get_jet_net_dns_error_not_found: fn(value: I64) -> I64 { net_dns_get(value, NET_DNS_NOT_FOUND) }
#Export(c) jet_rt_record_get_jet_net_dns_error_failure: fn(value: I64) -> I64 { net_dns_get(value, NET_DNS_FAILURE) }
#Export(c) jet_rt_handle_clone_jet_net_dns_error: fn(value: I64) -> I64 { net_dns_new(encoding_word(wrapping(value + NET_DNS_TAG)), encoding_word(wrapping(value + NET_DNS_TEXT))) }
#Export(c) jet_rt_handle_drop_jet_net_dns_error: fn(value: I64) {
    if (value == I64{0}) -> return
    jet_rt_string_drop(encoding_word(wrapping(value + NET_DNS_TEXT)))
    jet_rt_free(value, NET_DNS_BYTES, I64{8})
}
#Export(c) jet_rt_handle_eq_jet_net_dns_error: fn(left: I64, right: I64) -> Bool {
    encoding_word(wrapping(left + NET_DNS_TAG)) == encoding_word(wrapping(right + NET_DNS_TAG)) &&
        jet_rt_string_eq(encoding_word(wrapping(left + NET_DNS_TEXT)), encoding_word(wrapping(right + NET_DNS_TEXT)))
}
net_error_new: fn(ordinal: I64, payload: I64) -> I64 {
    if (ordinal < NET_ERROR_INVALID_INPUT || ordinal > NET_ERROR_OTHER) -> trap_native_index_range_stop()
    result: jet_rt_alloc(NET_ERROR_BYTES, I64{8})
    encoding_store(wrapping(result + NET_ERROR_TAG), ordinal)
    encoding_store(wrapping(result + NET_ERROR_PAYLOAD), payload) // CAbiRoutes consumes Box::from_raw
    result
}
net_error_get: fn(value: I64, ordinal: I64) -> I64 {
    if encoding_word(wrapping(value + NET_ERROR_TAG)) != ordinal -> rt_record_variant_panic()
    payload: encoding_word(wrapping(value + NET_ERROR_PAYLOAD))
    if ordinal == NET_ERROR_DNS -> jet_rt_handle_clone_jet_net_dns_error(payload) else -> jet_rt_handle_clone_jet_net_error_detail(payload)
}
#Export(c) jet_rt_record_tag_jet_net_error: fn(value: I64) -> I64 { encoding_word(wrapping(value + NET_ERROR_TAG)) }
#Export(c) jet_rt_handle_clone_jet_net_error: fn(value: I64) -> I64 {
    ordinal: encoding_word(wrapping(value + NET_ERROR_TAG))
    net_error_new(ordinal, net_error_get(value, ordinal))
}
#Export(c) jet_rt_handle_drop_jet_net_error: fn(value: I64) {
    if (value == I64{0}) -> return
    payload: encoding_word(wrapping(value + NET_ERROR_PAYLOAD))
    if encoding_word(wrapping(value + NET_ERROR_TAG)) == NET_ERROR_DNS -> jet_rt_handle_drop_jet_net_dns_error(payload)
    else -> jet_rt_handle_drop_jet_net_error_detail(payload)
    jet_rt_free(value, NET_ERROR_BYTES, I64{8})
}
#Export(c) jet_rt_handle_eq_jet_net_error: fn(left: I64, right: I64) -> Bool {
    ordinal: encoding_word(wrapping(left + NET_ERROR_TAG))
    if ordinal != encoding_word(wrapping(right + NET_ERROR_TAG)) -> return false
    a: encoding_word(wrapping(left + NET_ERROR_PAYLOAD))
    b: encoding_word(wrapping(right + NET_ERROR_PAYLOAD))
    if ordinal == NET_ERROR_DNS -> jet_rt_handle_eq_jet_net_dns_error(a, b) else -> jet_rt_handle_eq_jet_net_error_detail(a, b)
}
// One explicit conversion table: CAbiRoutes declaration tags -> NetHTTP530-558 render surface.
net_render_ordinal: fn(ordinal: I64) -> I64 {
    if {
        ordinal == NET_ERROR_DNS -> NET_RENDER_DNS
        ordinal == NET_ERROR_TLS -> NET_RENDER_TLS
        ordinal == NET_ERROR_PROTOCOL -> NET_RENDER_PROTOCOL
        ordinal == NET_ERROR_OTHER -> NET_RENDER_OTHER
        else -> ordinal
    }
}
#Export(c) jet_rt_handle_show_jet_net_error: fn(value: I64) -> I64 {
    ordinal: net_render_ordinal(encoding_word(wrapping(value + NET_ERROR_TAG)))
    payload: encoding_word(wrapping(value + NET_ERROR_PAYLOAD))
    // Every detail is message-only; DNS Failure also message-only.
    if ordinal != NET_RENDER_DNS -> return jet_rt_string_clone(encoding_word(wrapping(payload + NET_DETAIL_MESSAGE)))
    text: encoding_word(wrapping(payload + NET_DNS_TEXT))
    if encoding_word(wrapping(payload + NET_DNS_TAG)) == NET_DNS_FAILURE -> return jet_rt_string_clone(text)
    target: jet_rt_string_builder_new()
    rt_text_push_word(target, I64{7308604895908810308}, I64{8}) // "DNS name"
    rt_text_push_word(target, I64{8462094514430897696}, I64{8}) // " not fou"
    rt_text_push_word(target, I64{412857558126}, I64{5}) // "nd: `"
    jet_rt_string_builder_push(target, text)
    rt_text_push_word(target, I64{96}, I64{1})
    jet_rt_string_builder_finish(target)
}
#Export(c) jet_rt_handle_display_jet_net_error: fn(value: I64) -> I64 { jet_rt_handle_show_jet_net_error(value) }
#Export(c) jet_rt_handle_debug_jet_net_error: fn(value: I64) -> I64 { jet_rt_handle_show_jet_net_error(value) }
#Export(c) jet_rt_record_new_jet_net_error_invalid_input: fn(payload: I64) -> I64 { net_error_new(NET_ERROR_INVALID_INPUT, payload) }
#Export(c) jet_rt_record_get_jet_net_error_invalid_input: fn(value: I64) -> I64 { net_error_get(value, NET_ERROR_INVALID_INPUT) }
