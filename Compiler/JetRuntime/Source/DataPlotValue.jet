// Value declaration/derive: DataPlot.rs:359-366. No cross-variant coercion.
// Float equality is IEEE, even when comparing the same native allocation.
// Integer CAbiRoutes.rs:10137-10144: Rust i64, not an exact Int owner.
fn data_plot_value_new(kind: I64, payload: I64) -> I64 {
    value :: jet_rt_alloc(DP_VALUE_BYTES, I64{8})
    data_tree_store(value + DP_VALUE_TAG, kind)
    data_tree_store(value + DP_VALUE_PAYLOAD, payload)
    value
}
fn data_plot_value_payload(value: I64, kind: I64) -> I64 {
    if data_tree_word(value + DP_VALUE_TAG) != kind -> panic("record variant index out of range")
    data_tree_word(value + DP_VALUE_PAYLOAD)
}
#Export(c) fn jet_rt_record_tag_JetDataPlotValue(value: I64) -> I64 { data_tree_word(value + DP_VALUE_TAG) }
#Export(c) fn jet_rt_record_new_JetDataPlotValue_Text(value: I64) -> I64 { data_plot_value_new(DP_VALUE_TEXT, jet_rt_string_clone(value)) }
#Export(c) fn jet_rt_record_new_JetDataPlotValue_Integer(value: I64) -> I64 { data_plot_value_new(DP_VALUE_INT, jet_int_owned_to_i64(value)) }
#Export(c) fn jet_rt_record_new_JetDataPlotValue_Number(value: F64) -> I64 { data_plot_value_new(DP_VALUE_FLOAT, rt_f64_bits(value)) }
#Export(c) fn jet_rt_record_new_JetDataPlotValue_Boolean(value: U8) -> I64 { data_plot_value_new(DP_VALUE_BOOL, data_plot_flag(value)) }
#Export(c) fn jet_rt_record_new_JetDataPlotValue_Null() -> I64 { data_plot_value_new(DP_VALUE_NULL, I64{0}) }
#Export(c) fn jet_rt_record_get_JetDataPlotValue_Text(value: I64) -> I64 { jet_rt_string_clone(data_plot_value_payload(value, DP_VALUE_TEXT)) }
#Export(c) fn jet_rt_record_get_JetDataPlotValue_Integer(value: I64) -> I64 { jet_int_owned_from_i64(data_plot_value_payload(value, DP_VALUE_INT)) }
#Export(c) fn jet_rt_record_get_JetDataPlotValue_Number(value: I64) -> F64 { rt_f64_from_bits(data_plot_value_payload(value, DP_VALUE_FLOAT)) }
#Export(c) fn jet_rt_record_get_JetDataPlotValue_Boolean(value: I64) -> Bool { data_plot_value_payload(value, DP_VALUE_BOOL) != I64{0} }
#Export(c) fn jet_rt_handle_clone_JetDataPlotValue(value: I64) -> I64 {
    kind :: data_tree_word(value + DP_VALUE_TAG)
    payload := data_tree_word(value + DP_VALUE_PAYLOAD)
    if kind == DP_VALUE_TEXT { payload = jet_rt_string_clone(payload) }
    data_plot_value_new(kind, payload)
}
#Export(c) fn jet_rt_handle_drop_JetDataPlotValue(value: I64) {
    if (value == I64{0}) -> return
    kind :: data_tree_word(value + DP_VALUE_TAG)
    payload :: data_tree_word(value + DP_VALUE_PAYLOAD)
    if kind == DP_VALUE_TEXT { jet_rt_string_drop(payload) }
    jet_rt_free(value, DP_VALUE_BYTES, I64{8})
}
#Export(c) fn jet_rt_handle_eq_JetDataPlotValue(left: I64, right: I64) -> Bool {
    kind :: data_tree_word(left + DP_VALUE_TAG)
    if kind != data_tree_word(right + DP_VALUE_TAG) -> return false
    a :: data_tree_word(left + DP_VALUE_PAYLOAD)
    b :: data_tree_word(right + DP_VALUE_PAYLOAD)
    if kind == DP_VALUE_NULL -> return true
    if kind == DP_VALUE_TEXT -> return jet_rt_string_eq(a, b)
    if kind == DP_VALUE_FLOAT -> return rt_f64_from_bits(a) == rt_f64_from_bits(b)
    a == b
}
