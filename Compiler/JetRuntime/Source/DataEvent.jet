// Native DataEvent hand carrier; DataABI.jet owns all tags and offsets. The
// Rust original derives Clone/PartialEq; the Rust original defines ctor/getter
// ownership. Bytes borrows on get and consumes on new.
data_event_word: fn(address: I64) -> I64 {
    #Unsafe("address borrows an initialized word in a live native DataEvent or List") { return os_load_i64(address) }
}
data_event_store: fn(address: I64, value: I64) {
    #Unsafe("address owns a writable word in a native DataEvent") { os_store_i64(address, value) }
}
data_event_new: fn(kind: I64, payload: I64) -> I64 {
    event: jet_rt_alloc(DATA_EVENT_BYTES, I64{8})
    data_event_store(wrapping(event + DATA_EVENT_TAG), kind)
    data_event_store(wrapping(event + DATA_EVENT_PAYLOAD), payload)
    event
}
data_event_payload: fn(event: I64, kind: I64) -> I64 {
    if data_event_word(wrapping(event + DATA_EVENT_TAG)) != kind {
        rt_record_variant_panic()
        if (jet_scheduler_native_propagate() != I64{0}) -> return I64{0}
    }
    data_event_word(wrapping(event + DATA_EVENT_PAYLOAD))
}
data_event_text: fn(kind: I64) -> Bool {
    kind == DATA_EVENT_NUMBER || kind == DATA_EVENT_TEXT || kind == DATA_EVENT_KEY
}
#Export(c) jet_rt_handle_clone_data_event: fn(event: I64) -> I64 {
    kind: data_event_word(wrapping(event + DATA_EVENT_TAG))
    payload := data_event_word(wrapping(event + DATA_EVENT_PAYLOAD))
    if data_event_text(kind) { payload = jet_rt_string_clone(payload) } else if kind == DATA_EVENT_BYTE_LIST { payload = data_sequence_clone(payload, DATA_TREE_BYTE_LIST) }
    data_event_new(kind, payload)
}
#Export(c) jet_rt_handle_drop_data_event: fn(event: I64) {
    if (event == I64{0}) -> return
    kind: data_event_word(wrapping(event + DATA_EVENT_TAG))
    payload: data_event_word(wrapping(event + DATA_EVENT_PAYLOAD))
    if data_event_text(kind) { jet_rt_string_drop(payload) } else if kind == DATA_EVENT_BYTE_LIST { data_sequence_drop(payload, DATA_TREE_BYTE_LIST) }
    jet_rt_free(event, DATA_EVENT_BYTES, I64{8})
}
#Export(c) jet_rt_handle_eq_data_event: fn(left: I64, right: I64) -> Bool {
    kind: data_event_word(wrapping(left + DATA_EVENT_TAG))
    if kind != data_event_word(wrapping(right + DATA_EVENT_TAG)) -> return false
    a: data_event_word(wrapping(left + DATA_EVENT_PAYLOAD))
    b: data_event_word(wrapping(right + DATA_EVENT_PAYLOAD))
    if (kind == DATA_EVENT_BOOL || kind == DATA_EVENT_INT) -> return a == b
    if kind == DATA_EVENT_FLOAT -> return rt_f64_from_bits(a) == rt_f64_from_bits(b)
    if data_event_text(kind) -> return jet_rt_string_eq(a, b)
    if kind != DATA_EVENT_BYTE_LIST -> return true
    length: data_event_word(wrapping(a + DATA_SEQUENCE_LENGTH))
    if length != data_event_word(wrapping(b + DATA_SEQUENCE_LENGTH)) -> return false
    ap: data_event_word(wrapping(a + DATA_SEQUENCE_DATA))
    bp: data_event_word(wrapping(b + DATA_SEQUENCE_DATA))
    at := I64{0}
    loop at < length {
        if host_u8_get(ap, at) != host_u8_get(bp, at) -> return false
        at += I64{1}
    }
    true
}
#Export(c) jet_rt_record_tag_data_event: fn(event: I64) -> I64 { data_event_word(wrapping(event + DATA_EVENT_TAG)) }
#Export(c) jet_rt_record_new_data_event_null: fn() -> I64 { data_event_new(DATA_EVENT_NULL, I64{0}) }
#Export(c) jet_rt_record_new_data_event_bool: fn(value: U8) -> I64 { data_event_new(DATA_EVENT_BOOL, if (value == U8{0}) -> I64{0} else -> I64{1}) }
#Export(c) jet_rt_record_new_data_event_int: fn(value: I64) -> I64 {
    raw: jet_int_owned_to_i64(value)
    if (jet_scheduler_native_propagate() != I64{0}) -> return I64{0}
    data_event_new(DATA_EVENT_INT, raw)
}
#Export(c) jet_rt_record_new_data_event_float: fn(value: Float) -> I64 { data_event_new(DATA_EVENT_FLOAT, rt_f64_bits(value)) }
#Export(c) jet_rt_record_new_data_event_number: fn(value: I64) -> I64 { data_event_new(DATA_EVENT_NUMBER, jet_rt_string_clone(value)) }
#Export(c) jet_rt_record_new_data_event_text: fn(value: I64) -> I64 { data_event_new(DATA_EVENT_TEXT, jet_rt_string_clone(value)) }
#Export(c) jet_rt_record_new_data_event_bytes: fn(value: I64) -> I64 { data_event_new(DATA_EVENT_BYTE_LIST, value) }
#Export(c) jet_rt_record_new_data_event_array_start: fn() -> I64 { data_event_new(DATA_EVENT_ARRAY_START, I64{0}) }
#Export(c) jet_rt_record_new_data_event_array_end: fn() -> I64 { data_event_new(DATA_EVENT_ARRAY_END, I64{0}) }
#Export(c) jet_rt_record_new_data_event_object_start: fn() -> I64 { data_event_new(DATA_EVENT_OBJECT_START, I64{0}) }
#Export(c) jet_rt_record_new_data_event_key: fn(value: I64) -> I64 { data_event_new(DATA_EVENT_KEY, jet_rt_string_clone(value)) }
#Export(c) jet_rt_record_new_data_event_object_end: fn() -> I64 { data_event_new(DATA_EVENT_OBJECT_END, I64{0}) }
#Export(c) jet_rt_record_get_data_event_bool: fn(event: I64) -> Bool { data_event_payload(event, DATA_EVENT_BOOL) != I64{0} }
#Export(c) jet_rt_record_get_data_event_int: fn(event: I64) -> I64 {
    payload: data_event_payload(event, DATA_EVENT_INT)
    if (jet_scheduler_native_propagate() != I64{0}) -> return I64{0}
    jet_int_owned_from_i64(payload)
}
#Export(c) jet_rt_record_get_data_event_float: fn(event: I64) -> Float {
    payload: data_event_payload(event, DATA_EVENT_FLOAT)
    if (jet_scheduler_native_propagate() != I64{0}) -> return Float{0.0}
    rt_f64_from_bits(payload)
}
#Export(c) jet_rt_record_get_data_event_number: fn(event: I64) -> I64 {
    payload: data_event_payload(event, DATA_EVENT_NUMBER)
    if (jet_scheduler_native_propagate() != I64{0}) -> return I64{0}
    jet_rt_string_clone(payload)
}
#Export(c) jet_rt_record_get_data_event_text: fn(event: I64) -> I64 {
    payload: data_event_payload(event, DATA_EVENT_TEXT)
    if (jet_scheduler_native_propagate() != I64{0}) -> return I64{0}
    jet_rt_string_clone(payload)
}
#Export(c) jet_rt_record_get_data_event_bytes: fn(event: I64) -> I64 { data_event_payload(event, DATA_EVENT_BYTE_LIST) }
#Export(c) jet_rt_record_get_data_event_key: fn(event: I64) -> I64 {
    payload: data_event_payload(event, DATA_EVENT_KEY)
    if (jet_scheduler_native_propagate() != I64{0}) -> return I64{0}
    jet_rt_string_clone(payload)
}
