// . One process-wide stdout buffer: lines on a TTY,
// blocks on files/pipes. stderr is unbuffered and drains stdout first.
// All state is protected by the same lock, including the cached TTY fact.
// The runtime object's init/fini arrays own startup and normal-exit draining.
// Layout: lock @0, stdout length @8, TTY @16, a print line's elision @24,
// ioctl scratch @32, HOST_STDOUT_BYTES stdout bytes @128, then the number
// formatting workspace (HOST_FORMAT_SCRATCH). The mapping is process-lifetime
// runtime metadata.
^host_root: I64{0}

// The stdout buffer's bytes: a file or pipe is written 64 KiB at a time, a
// terminal at each LF (host_stdout_write).
HOST_STDOUT_BYTES: I64{65536}

// Where a print holding the output lock formats a Float's shortest digits
// (Display.jet display_scratch): its DISPLAY_SCRATCH_BYTES follow the
// buffer.
HOST_FORMAT_SCRATCH: I64{65664}

// The host root's mapping: its words, the buffer at 128 and the formatting
// workspace, in whole pages.
HOST_ROOT_BYTES: I64{69632}

// runtime-init: 1 when host_root
#Export(c) jet_rt_host_init: fn() {
    if (host_root != I64{0}) {
        return
    }
    // Runtime startup owns a fresh anonymous mapping before any program thread
    // exists.
    root: alloc_map(HOST_ROOT_BYTES, HOST_ROOT_BYTES)
    // TCGETS identifies the stream once; any failure means non-terminal.
    ^tty: I64{0}
    #Unsafe("TCGETS writes its termios into the fresh mapping's scratch at 32 and retains no pointer") {
        tty = host_syscall(I64{16}, I64{1}, I64{21505}, wrapping(root + I64{32}), I64{0}, I64{0}, I64{0})
    }
    rt_text_store(wrapping(root + I64{16}), if (tty == I64{0}) -> I64{1} else -> I64{0})
    #Unsafe("runtime startup publishes the root before any program thread exists") {
        host_root = root
    }
}

// SIGPIPE is ignored for program mains, not for host-loaded libraries. The
// native program-main wrapper calls this after init arrays; entryless hosts
// retain their signal disposition unless opting in explicitly.
#Export(c) jet_rt_host_program_start: fn() {
    #Unsafe("rt_sigaction synchronously borrows the four-word SIG_IGN action; no signal handler or restorer runs for ignored SIGPIPE") {
        status: os_syscall_stack4_i64(I64{13}, I64{13}, I64{1}, I64{0}, I64{0}, I64{0}, I64{8})
        if (status < I64{0}) { host_sigpipe_refused() }
    }
}

host_lock: fn() { sync_mutex_lock(host_root) }

host_unlock: fn() { sync_mutex_unlock(host_root) }

// Linux returns -errno; retry only interrupted writes and advance after a short
// write. Linux errno occupies 1..4095, so -4096 is a distinct private
// WriteZero fact, never an OS errno or a boxed exact-Int carrier.
HOST_WRITE_ZERO: I64{-4096}

host_write_all: fn(fd: I64, bytes: I64, length: I64) -> I64 {
    ^at: I64{0}
    #Unsafe("the caller lends length readable bytes for the complete synchronous write") {
        loop at < length {
            count: host_syscall(I64{1}, fd, wrapping(bytes + at), wrapping(length - at), I64{0}, I64{0}, I64{0})
            if (count == I64{-4}) { next }
            if (count < I64{0}) { return count }
            if (count == I64{0}) { return HOST_WRITE_ZERO }
            at = wrapping(at + count)
        }
    }
    I64{0}
}

// `length` bytes, then an LF, to `fd` with no buffer, a writev a pass
// (os_write_line_i64), retrying interrupted ones: 0, -errno or
// HOST_WRITE_ZERO, as host_write_all. Under `jet perf run` each writev is
// counted and timed as HostProcess.jet host_syscall counts its calls.
host_write_line: fn(fd: I64, bytes: I64, length: I64) -> I64 {
    #Unsafe("the caller lends length readable bytes; writev borrows its own LF until return") {
        ^at: I64{0}
        loop at <= length {
            table: perf_system
            row: if (table == I64{0}) -> I64{0} else -> perf_syscall_row(table, I64{20})
            began: if (row == I64{0}) -> I64{0} else -> perf_syscall_now()
            count: os_write_line_i64(fd, wrapping(bytes + at), wrapping(length - at))
            perf_syscall_spent(row, began)
            if (count == I64{-4}) { next }
            if (count == I64{0}) { return HOST_WRITE_ZERO }
            if (count < I64{0}) { return count }
            at = wrapping(at + count)
        }
    }
    I64{0}
}

// One register of the processor's identification: CPUID with `leaf` in
// eax and `subleaf` in ecx, then `register`, one of HOST_CPUID_EAX, _EBX,
// _ECX and _EDX. Every register reads 0 on WebAssembly (JetWeb Leaf.jet).
HOST_CPUID_EAX: I64{0}

HOST_CPUID_EBX: I64{1}

HOST_CPUID_ECX: I64{2}

HOST_CPUID_EDX: I64{3}

host_cpuid: fn(leaf: I64, subleaf: I64, register: I64) -> I64 {
    #Unsafe("cpuid only reports processor identification") {
        if (register == HOST_CPUID_EAX) { return os_cpuid_eax_i64(leaf, subleaf) }
        if (register == HOST_CPUID_EBX) { return os_cpuid_ebx_i64(leaf, subleaf) }
        if (register == HOST_CPUID_ECX) { return os_cpuid_ecx_i64(leaf, subleaf) }
        return os_cpuid_edx_i64(leaf, subleaf)
    }
}

// 1 while `jet debug` runs an evaluation in the stopped program, which
// writes this word itself and puts it back after (the runtime object exports
// it, JetBackend X64_DEBUG_EVAL_STORAGE); nothing in the program writes it.
// Then stdout's bytes go straight to their write, which the debugger keeps
// from the kernel and shows, and stderr leaves the program's pending stdout
// bytes in the buffer: an evaluation's print never joins the program's
// output.
^host_stdout_direct: I64{0}

// Caller holds the lock. Preserve unwritten bytes after a failed/short flush,
// so a subsequent explicit flush has the same pending suffix, not duplicates.
host_stdout_flush_locked: fn() -> I64 {
    #Unsafe("the output lock exclusively owns the initialized buffer and length; write borrows its pending bytes") {
        length: rt_text_word(wrapping(host_root + I64{8}))
        bytes: wrapping(host_root + I64{128})
        ^at: I64{0}
        ^failure: I64{0}
        loop at < length {
            count: host_syscall(I64{1}, I64{1}, wrapping(bytes + at), wrapping(length - at), I64{0}, I64{0}, I64{0})
            if (count == I64{-4}) { next }
            if (count <= I64{0}) {
                failure = if (count == I64{0}) -> HOST_WRITE_ZERO else -> count
                break
            }
            at = wrapping(at + count)
        }
        remaining: wrapping(length - at)
        if (at != I64{0}) {
            ^index: I64{0}
            loop index < remaining {
                rt_text_put(wrapping(bytes + index), rt_text_byte(wrapping(wrapping(bytes + at) + index)))
                index = wrapping(index + I64{1})
            }
        }
        rt_text_store(wrapping(host_root + I64{8}), remaining)
        return failure
    }
}

// Bytes are borrowed, never copied into an intermediate String/line
// allocation (host_stdout_put_locked). The output lock is elided while one
// thread runs (Sync.jet sync_sole_enter). Each write is a sync event of a
// recording or replay (RecordReplay.jet), logged under the lock.
host_stdout_write: fn(bytes: I64, length: I64, line: Bool, flush: Bool) -> I64 {
    if (host_stdout_direct != I64{0}) {
        if (line) { return host_write_line(I64{1}, bytes, length) }
        return host_write_all(I64{1}, bytes, length)
    }
    ticket: replay_take(REPLAY_PRINT, I64{0})
    replay_output_check(ticket, REPLAY_PRINT, bytes, length, line)
    sole: sync_sole_enter(host_root)
    ^failure: host_stdout_put_locked(bytes, length)
    if (failure == I64{0} && line) { failure = host_stdout_line_end_locked() }
    if (failure == I64{0} && flush) { failure = host_stdout_flush_locked() }
    replay_output_log(REPLAY_PRINT, bytes, length, line)
    sync_sole_exit(host_root, sole)
    replay_give(ticket)
    failure
}

// Caller holds the output lock and lends `length` bytes. They go into the
// HOST_STDOUT_BYTES buffer a run at a time (a word copy): a full buffer is
// written out, and on a terminal so is each run that ends in an LF (line
// buffering). 0, or the failure of the write that dropped the rest.
host_stdout_put_locked: fn(bytes: I64, length: I64) -> I64 {
    ^failure: I64{0}
    ^index: I64{0}
    ^pending: rt_text_word(wrapping(host_root + I64{8}))
    tty: rt_text_word(wrapping(host_root + I64{16})) != I64{0}
    loop index < length {
        room: wrapping(HOST_STDOUT_BYTES - pending)
        left: wrapping(length - index)
        ^run: if (left < room) -> left else -> room
        ^ends_line: false
        if (tty && run > I64{0}) {
            lf: rt_line_run(wrapping(bytes + index), run)
            ends_line = rt_text_byte(wrapping(bytes + index + lf - I64{1})) == I64{10}
            run = lf
        }
        rt_text_bytes_copy(wrapping(host_root + I64{128} + pending), wrapping(bytes + index), run)
        pending = wrapping(pending + run)
        index = wrapping(index + run)
        if (pending == HOST_STDOUT_BYTES || ends_line) {
            rt_text_store(wrapping(host_root + I64{8}), pending)
            failure = host_stdout_flush_locked()
            if (failure != I64{0}) { return failure }
            pending = rt_text_word(wrapping(host_root + I64{8}))
        }
    }
    rt_text_store(wrapping(host_root + I64{8}), pending)
    I64{0}
}

// Caller holds the output lock: print's LF. A full buffer is written out
// first, and the LF flushes on a terminal or when it fills the buffer.
host_stdout_line_end_locked: fn() -> I64 {
    ^failure: I64{0}
    ^pending: rt_text_word(wrapping(host_root + I64{8}))
    if (pending == HOST_STDOUT_BYTES) {
        failure = host_stdout_flush_locked()
        if (failure != I64{0}) { return failure }
        pending = rt_text_word(wrapping(host_root + I64{8}))
    }
    rt_text_put(wrapping(host_root + I64{128} + pending), I64{10})
    pending = wrapping(pending + I64{1})
    rt_text_store(wrapping(host_root + I64{8}), pending)
    if (pending == HOST_STDOUT_BYTES || rt_text_word(wrapping(host_root + I64{16})) != I64{0}) {
        failure = host_stdout_flush_locked()
    }
    failure
}

// Caller holds the output lock: where `count` (at most HOST_STDOUT_BYTES)
// more bytes, none an LF, go in the buffer, a full buffer written out first;
// 0 when that write failed and the bytes are dropped.
// host_stdout_commit_locked then publishes them.
host_stdout_reserve_locked: fn(count: I64) -> I64 {
    ^pending: rt_text_word(wrapping(host_root + I64{8}))
    if (wrapping(pending + count) > HOST_STDOUT_BYTES) {
        if (host_stdout_flush_locked() != I64{0}) { return I64{0} }
        pending = rt_text_word(wrapping(host_root + I64{8}))
    }
    wrapping(host_root + I64{128} + pending)
}

host_stdout_commit_locked: fn(count: I64) {
    rt_text_store(wrapping(host_root + I64{8}), wrapping(rt_text_word(wrapping(host_root + I64{8})) + count))
}

// Display.jet display_scratch's workspace while a print holds the output
// lock.
host_format_scratch: fn() -> I64 { wrapping(host_root + HOST_FORMAT_SCRATCH) }

host_stderr_write: fn(bytes: I64, length: I64) -> I64 {
    ticket: replay_take(REPLAY_EPRINT, I64{0})
    replay_output_check(ticket, REPLAY_EPRINT, bytes, length, false)
    host_lock()
    // An stdout failure must not suppress the requested stderr report.
    if (host_stdout_direct == I64{0}) { ^_: host_stdout_flush_locked() }
    failure: host_write_all(I64{2}, bytes, length)
    replay_output_log(REPLAY_EPRINT, bytes, length, false)
    host_unlock()
    replay_give(ticket)
    failure
}

host_stderr_line: fn(bytes: I64, length: I64) -> I64 {
    ticket: replay_take(REPLAY_EPRINT, I64{0})
    replay_output_check(ticket, REPLAY_EPRINT, bytes, length, true)
    host_lock()
    if (host_stdout_direct == I64{0}) { ^_: host_stdout_flush_locked() }
    failure: host_write_line(I64{2}, bytes, length)
    replay_output_log(REPLAY_EPRINT, bytes, length, true)
    host_unlock()
    replay_give(ticket)
    failure
}

host_is_tty: fn(fd: I64) -> Bool {
    host_lock()
    #Unsafe("the held host lock lends enough scratch for Linux TCGETS") {
        result: host_syscall(I64{16}, fd, I64{21505}, wrapping(host_root + I64{32}), I64{0}, I64{0}, I64{0})
        host_unlock()
        return result == I64{0}
    }
}

// Runtime-private host fact for TUI capability sampling: raw native fd, not Int.
#Export(c) jet_rt_host_is_tty: fn(fd: I64) -> I64 {
    if host_is_tty(fd & I64{4294967295}) -> I64{1} else -> I64{0}
}

// core.term.jet_term_is_terminal_raw: only stdin, stdout and stderr are
// standard streams; any other Int reads false. The binding lends the fd as
// its exact-Int carrier, read saturated (Int.jet int_saturated).
#Export(c) jet_term_is_terminal_raw: fn(fd_int: I64) -> Bool {
    fd: int_saturated(fd_int)
    if (fd < I64{0} || fd > I64{2}) { return false }
    host_is_tty(fd)
}

// runtime-fini: 1 when host_root
#Export(c) jet_rt_stdout_flush: fn() {
    // A terminal host fault may precede the runtime's init array.
    if (host_root == I64{0}) {
        return
    }
    host_lock()
    ^_: host_stdout_flush_locked()
    host_unlock()
}

// A fork's hold on stdout (RouteSys.jet jet_sys_fork_raw): the lock, with
// pending bytes drained first so the child never re-emits bytes the parent
// already printed. The forking thread blocks on the lock and never parks a
// fiber, as for the fork gate.
host_fork_hold: fn() {
    if (host_root == I64{0}) {
        return
    }
    sync_thread_lock(host_root)
    ^_: host_stdout_flush_locked()
}

// The parent unlocks. The child, whose only thread is the forking one,
// stores the lock's initial state.
host_fork_release: fn(child: Bool) {
    if (host_root == I64{0}) {
        return
    }
    if child -> sync_store(host_root, I64{0}) else -> host_unlock()
}

// The fault report's flush (Fault.jet): skipped when the lock is held, since
// the faulting thread may hold it mid-write and would wait forever.
host_stdout_flush_fault: fn() {
    if (host_root == I64{0}) {
        return
    }
    if !sync_mutex_try_lock(host_root) {
        return
    }
    ^_: host_stdout_flush_locked()
    host_unlock()
}

// TestCapture.jet jet_rt_test_capture_print_hook once a thread holds test
// state, else 0: a program that never runs a test prints straight through.
^host_print_capture_code: I64{0}

host_print_capture_install: fn(code: I64) {
    #Unsafe("an idempotent install: every writer stores the same code address") {
        host_print_capture_code = code
    }
}

// print in every program, one that owns its main included (JetIR
// EntryOwned.jet): one stdout buffer, so print, eprint and the stop and
// fault reports keep their order on every main.
#Export(c) jet_term_write_stdout_line: fn(value: I64, flush: U8) {
    capture: host_print_capture_code
    if (capture != I64{0} && coll_call1(capture, value) != I64{0}) {
        return
    }
    // `value` is a borrowed E4 JetCText header; stdout copies its bytes before
    // returning.
    ^_: host_stdout_write(rt_text_word(value), rt_text_word(wrapping(value + I64{8})), true, flush != U8{0})
}

// The text sink of the stdout buffer itself (Text.jet rt_sink_append): a
// builder is a nonzero aligned address, so 1 is never one.
HOST_STDOUT_SINK: I64{1}

// A print whose line is pieces, a String literal's parts or one number
// (JetIR BuildExpr.jet ir_print), writes them straight into the stdout
// buffer: this takes the output lock and answers HOST_STDOUT_SINK, each
// piece is a builder push into it (Text.jet, Display.jet) and
// jet_term_stdout_line_end ends the line and lets the lock go. The caller
// runs nothing else in between: every piece's value is ready first. A
// debugger evaluation's direct output, a test's print capture and a
// recording or replay, which take the line whole, get a fresh builder
// instead, which jet_term_stdout_line_end prints as
// jet_term_write_stdout_line does.
#Export(c) jet_term_stdout_line_begin: fn() -> I64 {
    if (host_stdout_direct != I64{0} || host_print_capture_code != I64{0} || replay_mode != REPLAY_OFF) {
        return rt_text_builder_with_capacity(I64{0})
    }
    sole: sync_sole_enter(host_root)
    rt_text_store(wrapping(host_root + I64{24}), if sole -> I64{1} else -> I64{0})
    HOST_STDOUT_SINK
}

// `flush` 1 writes the buffer out after the line's LF. A builder line is
// printed and dropped, unless building it failed (its stop pending).
#Export(c) jet_term_stdout_line_end: fn(sink: I64, flush: U8) {
    if (sink != HOST_STDOUT_SINK) {
        if (sink == I64{0}) {
            return
        }
        if (scheduler_stop_pending() == I64{0}) { jet_term_write_stdout_line(sink, flush) }
        jet_rt_string_drop(sink)
        return
    }
    if (host_stdout_line_end_locked() == I64{0} && flush != U8{0}) {
        ^_: host_stdout_flush_locked()
    }
    sync_sole_exit(host_root, rt_text_word(wrapping(host_root + I64{24})) != I64{0})
}
