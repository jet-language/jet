// . One process-wide stdout buffer: lines on a TTY,
// blocks on files/pipes. stderr is unbuffered and drains stdout first.
// All state is protected by the same lock, including the cached TTY fact.
// The runtime object's init/fini arrays own startup and normal-exit draining.
// Layout: lock @0, stdout length @8, TTY @16, ioctl scratch @32,
// 8192 stdout bytes @128. The mapping is process-lifetime runtime metadata.
host_root := I64{0}

// runtime-init: 1 when host_root
#Export(c) jet_rt_host_init: fn() {
    if (host_root != I64{0}) {
        return
    }
    #Unsafe("runtime startup owns a fresh anonymous mapping before any program thread exists") {
        root: os_syscall_i64(I64{9}, I64{0}, I64{12288}, I64{3}, I64{34}, I64{-1}, I64{0})
        if (root < I64{0}) { alloc_out_of_memory(I64{12288}) }
        // TCGETS identifies the stream once; any failure means non-terminal.
        tty: os_syscall_i64(I64{16}, I64{1}, I64{21505}, wrapping(root + I64{32}), I64{0}, I64{0}, I64{0})
        os_store_i64(wrapping(root + I64{16}), if (tty == I64{0}) -> I64{1} else -> I64{0})
        host_root = root
    }
}

// Rust lang_start ignores SIGPIPE for program mains, not for host-loaded
// libraries. The native program-main wrapper calls this after init arrays;
// entryless hosts retain their signal disposition unless opting in explicitly.
#Export(c) jet_rt_host_program_start: fn() {
    #Unsafe("rt_sigaction synchronously borrows the four-word SIG_IGN action; no signal handler or restorer runs for ignored SIGPIPE") {
        status: os_syscall_stack4_i64(I64{13}, I64{13}, I64{1}, I64{0}, I64{0}, I64{0}, I64{8})
        if (status < I64{0}) -> host_sigpipe_refused()
    }
}

host_lock: fn() { sync_mutex_lock(host_root) }

host_unlock: fn() { sync_mutex_unlock(host_root) }

// Linux returns -errno; retry only interrupted writes and advance after a short
// write. Linux errno occupies 1..4095, so -4096 is a distinct private
// WriteZero fact, never an OS errno or a boxed exact-Int carrier.
HOST_WRITE_ZERO: I64{-4096}

host_write_all: fn(fd: I64, bytes: I64, length: I64) -> I64 {
    at := I64{0}
    #Unsafe("the caller lends length readable bytes for the complete synchronous write") {
        loop at < length {
            count: os_syscall_i64(I64{1}, fd, wrapping(bytes + at), wrapping(length - at), I64{0}, I64{0}, I64{0})
            if (count == I64{-4}) { next }
            if (count < I64{0}) { return count }
            if (count == I64{0}) { return HOST_WRITE_ZERO }
            at = wrapping(at + count)
        }
    }
    I64{0}
}

// Caller holds the lock. Preserve unwritten bytes after a failed/short flush,
// so a subsequent explicit flush has the same pending suffix, not duplicates.
host_stdout_flush_locked: fn() -> I64 {
    #Unsafe("the output lock exclusively owns the initialized buffer and length") {
        length: os_load_i64(wrapping(host_root + I64{8}))
        bytes: wrapping(host_root + I64{128})
        at := I64{0}
        failure := I64{0}
        loop at < length {
            count: os_syscall_i64(I64{1}, I64{1}, wrapping(bytes + at), wrapping(length - at), I64{0}, I64{0}, I64{0})
            if (count == I64{-4}) { next }
            if (count <= I64{0}) {
                failure = if (count == I64{0}) -> HOST_WRITE_ZERO else -> count
                break
            }
            at = wrapping(at + count)
        }
        remaining: wrapping(length - at)
        if (at != I64{0}) {
            index := I64{0}
            loop index < remaining {
                os_store_u8(wrapping(bytes + index), os_load_u8(wrapping(wrapping(bytes + at) + index)))
                index = wrapping(index + I64{1})
            }
        }
        os_store_i64(wrapping(host_root + I64{8}), remaining)
        return failure
    }
}

// Bytes are borrowed, never copied into an intermediate String/line
// allocation. They go into the 8192-byte buffer a run at a time (a word copy):
// a full buffer is written out, and on a terminal so is each run that ends in
// an LF (line buffering). The output lock is elided while one thread runs
// (Sync.jet sync_sole_enter).
host_stdout_write: fn(bytes: I64, length: I64, line: Bool, flush: Bool) -> I64 {
    sole: sync_sole_enter(host_root)
    failure := I64{0}
    #Unsafe("the caller lends length bytes; the output lock owns the destination buffer") {
        index := I64{0}
        pending := os_load_i64(wrapping(host_root + I64{8}))
        tty: os_load_i64(wrapping(host_root + I64{16})) != I64{0}
        loop index < length {
            room: wrapping(I64{8192} - pending)
            left: wrapping(length - index)
            run := if (left < room) -> left else -> room
            ends_line := false
            if (tty && run > I64{0}) {
                lf: rt_line_run(wrapping(bytes + index), run)
                ends_line = rt_text_byte(wrapping(bytes + index + lf - I64{1})) == I64{10}
                run = lf
            }
            rt_text_bytes_copy(wrapping(host_root + I64{128} + pending), wrapping(bytes + index), run)
            pending = wrapping(pending + run)
            index = wrapping(index + run)
            if (pending == I64{8192} || ends_line) {
                os_store_i64(wrapping(host_root + I64{8}), pending)
                failure = host_stdout_flush_locked()
                if (failure != I64{0}) { break }
                pending = os_load_i64(wrapping(host_root + I64{8}))
            }
        }
        // print's LF joins the same pass: a full buffer is written out
        // first, and the LF flushes on a terminal or when it fills the buffer.
        if (failure == I64{0} && line) {
            if (pending == I64{8192}) {
                os_store_i64(wrapping(host_root + I64{8}), pending)
                failure = host_stdout_flush_locked()
                pending = os_load_i64(wrapping(host_root + I64{8}))
            }
            if (failure == I64{0}) {
                os_store_u8(wrapping(host_root + I64{128} + pending), I64{10})
                pending = wrapping(pending + I64{1})
                if (pending == I64{8192} || tty) {
                    os_store_i64(wrapping(host_root + I64{8}), pending)
                    failure = host_stdout_flush_locked()
                    pending = os_load_i64(wrapping(host_root + I64{8}))
                }
            }
        }
        if (failure == I64{0}) { os_store_i64(wrapping(host_root + I64{8}), pending) }
        if (failure == I64{0} && flush) { failure = host_stdout_flush_locked() }
    }
    sync_sole_exit(host_root, sole)
    failure
}

host_stderr_write: fn(bytes: I64, length: I64) -> I64 {
    host_lock()
    // An stdout failure must not suppress the requested stderr report.
    _ := host_stdout_flush_locked()
    failure: host_write_all(I64{2}, bytes, length)
    host_unlock()
    failure
}

host_stderr_line: fn(bytes: I64, length: I64) -> I64 {
    host_lock()
    _ := host_stdout_flush_locked()
    at := I64{0}
    failure := I64{0}
    #Unsafe("bytes lends length readable bytes; writev borrows its own LF until return") {
        loop at <= length {
            count: os_write_line_i64(I64{2}, wrapping(bytes + at), wrapping(length - at))
            if (count == I64{-4}) { next }
            if (count <= I64{0}) {
                failure = if (count == I64{0}) -> HOST_WRITE_ZERO else -> count
                break
            }
            at = wrapping(at + count)
        }
    }
    host_unlock()
    failure
}

host_is_tty: fn(fd: I64) -> Bool {
    host_lock()
    #Unsafe("the held host lock lends enough scratch for Linux TCGETS") {
        result: os_syscall_i64(I64{16}, fd, I64{21505}, wrapping(host_root + I64{32}), I64{0}, I64{0}, I64{0})
        host_unlock()
        return result == I64{0}
    }
}

// Runtime-private host fact for TUI capability sampling: raw native fd, not Int.
#Export(c) jet_rt_host_is_tty: fn(fd: I64) -> I64 {
    if host_is_tty(fd.bit_and(I64{4294967295})) -> I64{1} else -> I64{0}
}

// core.term.jet_term_is_terminal_raw: only stdin, stdout and stderr are
// standard streams; any other Int reads false. An exact Int 0..2 is its own
// inline word, so the borrowed word compares directly.
#Export(c) jet_term_is_terminal_raw: fn(fd: I64) -> Bool {
    if (fd < I64{0} || fd > I64{2}) -> return false
    host_is_tty(fd)
}

// runtime-fini: 1 when host_root
#Export(c) jet_rt_stdout_flush: fn() {
    // A terminal host fault may precede the runtime's init array.
    if (host_root == I64{0}) -> return
    host_lock()
    _ := host_stdout_flush_locked()
    host_unlock()
}

// A fork's hold on stdout (RouteSys.jet jet_sys_fork_raw): the lock, with
// pending bytes drained first so the child never re-emits bytes the parent
// already printed (Rust's line writer holds none). The forking thread
// blocks on the lock and never parks a fiber, as for the fork gate.
host_fork_hold: fn() {
    if (host_root == I64{0}) -> return
    sync_thread_lock(host_root)
    _ := host_stdout_flush_locked()
}

// The parent unlocks. The child, whose only thread is the forking one,
// stores the lock's initial state.
host_fork_release: fn(child: Bool) {
    if (host_root == I64{0}) -> return
    if child { sync_store(host_root, I64{0}) } else { host_unlock() }
}

// The fault report's flush (Fault.jet): skipped when the lock is held, since
// the faulting thread may hold it mid-write and would wait forever.
host_stdout_flush_fault: fn() {
    if (host_root == I64{0}) -> return
    if !sync_mutex_try_lock(host_root) -> return
    _ := host_stdout_flush_locked()
    host_unlock()
}

// TestCapture.jet jet_rt_test_capture_print_hook once a thread holds test
// state, else 0: a program that never runs a test prints straight through.
host_print_capture_code := I64{0}

host_print_capture_install: fn(code: I64) {
    #Unsafe("an idempotent install: every writer stores the same code address") {
        host_print_capture_code = code
    }
}

#Export(c) jet_term_write_stdout_line: fn(value: I64, flush: U8) {
    capture: host_print_capture_code
    if (capture != I64{0} && coll_call1(capture, value) != I64{0}) -> return
    #Unsafe("value is a borrowed E4 JetCText header; stdout copies its bytes before returning") {
        _ := host_stdout_write(os_load_i64(value), os_load_i64(wrapping(value + I64{8})), true, flush != U8{0})
    }
}

// print in a program that owns its main (JetIR EntryOwned.jet): such a
// program links no other stdout writer, no runtime root to hold a buffer,
// and runs no test capture. The line and its newline go straight to fd 1,
// with no buffer and no lock: the same bytes, in the same order, as
// jet_term_write_stdout_line's buffered writes. A failed write is dropped,
// as there.
#Export(c) jet_term_write_stdout_line_direct: fn(value: I64, flush: U8) {
    #Unsafe("value is a borrowed E4 JetCText header; writev borrows its bytes and its own LF until return") {
        bytes: os_load_i64(value)
        length: os_load_i64(wrapping(value + I64{8}))
        at := I64{0}
        loop at <= length {
            count: os_write_line_i64(I64{1}, wrapping(bytes + at), wrapping(length - at))
            if (count == I64{-4}) { next }
            if (count <= I64{0}) { return }
            at = wrapping(at + count)
        }
    }
}
