// D-STDOUT-BUFFER1=A. One process-wide stdout buffer: lines on a TTY,
// blocks on files/pipes. stderr is unbuffered and drains stdout first.
// All state is protected by the same lock, including the cached TTY fact.
// The runtime object's init/fini arrays own startup and normal-exit draining.
// Layout: lock @0, stdout length @8, TTY @16, ioctl scratch @32,
// 8192 stdout bytes @128. The mapping is process-lifetime runtime metadata.
host_root := I64{0}

// runtime-init: 1
#Export(c)
fn jet_rt_host_init() {
    if (host_root != I64{0}) -> return
    #Unsafe("runtime startup owns a fresh anonymous mapping before any program thread exists") {
        root :: os_syscall_i64(I64{9}, I64{0}, I64{12288}, I64{3}, I64{34}, I64{-1}, I64{0})
        if (root < I64{0}) -> alloc_stop(false, I64{12288})
        // TCGETS identifies the stream once; any failure means non-terminal.
        tty :: os_syscall_i64(I64{16}, I64{1}, I64{21505}, wrapping(root + I64{32}), I64{0}, I64{0}, I64{0})
        os_store_i64(wrapping(root + I64{16}), if (tty == I64{0}) -> I64{1} else -> I64{0})
        host_root = root
    }
}

fn host_lock() {
    #Unsafe("the init-array-created lock word is live; CAS protects all host metadata and output") {
        loop (os_cas_i64(host_root, I64{0}, I64{1}) != I64{0}) -> os_spin_pause()
    }
}

fn host_unlock() {
    #Unsafe("only the holder releases the host output lock") {
        os_store_i64(host_root, I64{0})
    }
}

// Linux returns -errno; retry only interrupted writes and advance after a short
// write. A zero write is WriteZero (EIO at this raw syscall boundary).
fn host_write_all(fd: I64, bytes: I64, length: I64) -> I64 {
    at := I64{0}
    #Unsafe("the caller lends length readable bytes for the complete synchronous write") {
        loop at < length {
            count :: os_syscall_i64(I64{1}, fd, wrapping(bytes + at), wrapping(length - at), I64{0}, I64{0}, I64{0})
            if (count == I64{-4}) -> next
            if (count < I64{0}) -> return count
            if (count == I64{0}) -> return I64{-5}
            at = wrapping(at + count)
        }
    }
    I64{0}
}

// Caller holds the lock. Preserve unwritten bytes after a failed/short flush,
// so a subsequent explicit flush has the same pending suffix, not duplicates.
fn host_stdout_flush_locked() -> I64 {
    #Unsafe("the output lock exclusively owns the initialized buffer and length") {
        length :: os_load_i64(wrapping(host_root + I64{8}))
        bytes :: wrapping(host_root + I64{128})
        at := I64{0}
        failure := I64{0}
        loop at < length {
            count :: os_syscall_i64(I64{1}, I64{1}, wrapping(bytes + at), wrapping(length - at), I64{0}, I64{0}, I64{0})
            if (count == I64{-4}) -> next
            if (count <= I64{0}) {
                failure = if (count == I64{0}) -> I64{-5} else -> count
                break
            }
            at = wrapping(at + count)
        }
        remaining :: wrapping(length - at)
        index := I64{0}
        loop index < remaining {
            os_store_u8(wrapping(bytes + index), os_load_u8(wrapping(bytes + at + index)))
            index = wrapping(index + I64{1})
        }
        os_store_i64(wrapping(host_root + I64{8}), remaining)
        return failure
    }
}

fn host_stdout_byte_locked(byte: I64) -> I64 {
    #Unsafe("the caller holds the output lock; each byte stays within the 8192-byte mapping-owned buffer") {
        length :: os_load_i64(wrapping(host_root + I64{8}))
        if (length == I64{8192}) {
            failure :: host_stdout_flush_locked()
            if (failure != I64{0}) -> return failure
        }
        used :: os_load_i64(wrapping(host_root + I64{8}))
        os_store_u8(wrapping(host_root + I64{128} + used), byte)
        os_store_i64(wrapping(host_root + I64{8}), wrapping(used + I64{1}))
        if (used == I64{8191} || (byte == I64{10} && os_load_i64(wrapping(host_root + I64{16})) != I64{0})) -> return host_stdout_flush_locked()
    }
    I64{0}
}

// Bytes are borrowed, never copied into an intermediate String/line allocation.
fn host_stdout_write(bytes: I64, length: I64, line: Bool, flush: Bool) -> I64 {
    host_lock()
    failure := I64{0}
    #Unsafe("the caller lends length bytes; the output lock owns the destination buffer") {
        index := I64{0}
        pending := os_load_i64(wrapping(host_root + I64{8}))
        tty :: os_load_i64(wrapping(host_root + I64{16})) != I64{0}
        loop index < length {
            if (pending == I64{8192}) {
                failure = host_stdout_flush_locked()
                if (failure != I64{0}) -> break
                pending = I64{0}
            }
            byte :: os_load_u8(wrapping(bytes + index))
            os_store_u8(wrapping(host_root + I64{128} + pending), byte)
            pending = wrapping(pending + I64{1})
            index = wrapping(index + I64{1})
            if (pending == I64{8192} || (tty && byte == I64{10})) {
                os_store_i64(wrapping(host_root + I64{8}), pending)
                failure = host_stdout_flush_locked()
                if (failure != I64{0}) -> break
                pending = I64{0}
            }
        }
        if (failure == I64{0}) -> os_store_i64(wrapping(host_root + I64{8}), pending)
        if (failure == I64{0} && line) -> failure = host_stdout_byte_locked(I64{10})
        if (failure == I64{0} && flush) -> failure = host_stdout_flush_locked()
    }
    host_unlock()
    failure
}

fn host_stderr_write(bytes: I64, length: I64) -> I64 {
    host_lock()
    // An stdout failure must not suppress the requested stderr report.
    _ := host_stdout_flush_locked()
    failure :: host_write_all(I64{2}, bytes, length)
    host_unlock()
    failure
}

// runtime-fini: 1
#Export(c)
fn jet_rt_stdout_flush() {
    host_lock()
    _ := host_stdout_flush_locked()
    host_unlock()
}

#Export(c)
fn jet_term_write_stdout_line(value: I64, flush: U8) {
    #Unsafe("value is a borrowed E4 JetCText header; stdout copies its bytes before returning") {
        _ := host_stdout_write(os_load_i64(value), os_load_i64(wrapping(value + I64{8})), true, flush != U8{0})
    }
}
