// core.mod's load-site provider (Core/Mod/Mod.jet sequences these leaves).
// The caller grants read roots; identity, metadata and ABI checks complete
// before the payload is staged to a file or mapped. Every refusal is
// `<Case>: <reason>` (Denied, NotFound, Invalid or Unsupported) except the
// header parser's, which Core reports as Invalid.
//
// A loader context is the address of one owned record (MOD_CONTEXT_BYTES):
// the artifact bytes, the parsed header as byte spans into them, and the
// staged payload path. Core closes it exactly once (`__LoadContext.Close`),
// after `__finish_context` has moved the staged path out on success.
//
// The static native runtime has no dynamic loader (musl's static dlopen
// refuses every library), so mapping a checked payload is Unsupported and a
// context never holds a native handle.

MOD_BYTES: I64{0}
MOD_LENGTH: I64{8}
MOD_CAPACITY: I64{16}
MOD_PAYLOAD: I64{24}
MOD_CURSOR: I64{32}
MOD_STAGED: I64{40}
MOD_SCRATCH: I64{48}
MOD_EXPORT_COUNT: I64{56}
MOD_EXPORTS: I64{64}
MOD_EFFECT_COUNT: I64{72}
MOD_EFFECTS: I64{80}
MOD_ABI_VERSION: I64{88}
MOD_ENTRY_PRESENT: I64{96}
// Byte spans [offset, length] into MOD_BYTES.
MOD_COMPILER_VERSION: I64{104}
MOD_COMPILER_BUILD: I64{120}
MOD_LIBRARY_NAME: I64{136}
MOD_ENTRY: I64{152}
MOD_TARGET: I64{168}
MOD_TARGET_TRIPLE: I64{184}
MOD_LINKER: I64{200}
MOD_ABI_IDENTITY: I64{216}
MOD_DIGEST: I64{232}
MOD_CONTEXT_BYTES: I64{248}
// An export row: name span, symbol span, scalar tag (3 is Text).
MOD_EXPORT_BYTES: I64{40}
MOD_EFFECT_BYTES: I64{16}
MOD_MAX_HEADER_ITEMS: I64{4096}
MOD_MAX_FIELD_BYTES: I64{1048576}
MOD_MAX_EXPORT_PARAMS: I64{4096}
MOD_ABI_VERSION_ACCEPTED: I64{2}
// O_WRONLY|O_CREAT|O_EXCL|O_CLOEXEC: OpenOptions::write().create_new().
MOD_STAGE_FLAGS: I64{524481}
// JetMod: [native handle, staged payload path].
MOD_HANDLE_BYTES: I64{16}

mod_word: fn(base: I64, field: I64) -> I64 { rt_text_word(wrapping(base + field)) }

mod_put: fn(base: I64, field: I64, value: I64) { rt_text_store(wrapping(base + field), value) }

// A `<Case>: ` reason opened with its first static piece.
mod_reason: fn(opening: I64, text: I64) -> I64 {
    reason: jet_rt_string_builder_new()
    jet_rt_string_builder_push(reason, opening)
    jet_rt_string_builder_push(reason, text)
    reason
}

mod_push_span: fn(target: I64, context: I64, span: I64) {
    rt_text_append(target, wrapping(mod_word(context, MOD_BYTES) + mod_word(context, span)), mod_word(context, wrapping(span + I64{8})))
}

mod_span_text: fn(context: I64, span: I64) -> I64 {
    rt_text_copy(wrapping(mod_word(context, MOD_BYTES) + mod_word(context, span)), mod_word(context, wrapping(span + I64{8})))
}

mod_span_is: fn(context: I64, span: I64, text: I64) -> Bool {
    length: mod_word(context, wrapping(span + I64{8}))
    length == rt_text_len(text) && rt_text_equal_bytes(wrapping(mod_word(context, MOD_BYTES) + mod_word(context, span)), rt_text_data(text), length)
}

mod_bytes_have_nul: fn(data: I64, length: I64) -> Bool {
    at := I64{0}
    loop at < length {
        if (rt_text_byte(wrapping(data + at)) == I64{0}) -> return true
        at += I64{1}
    }
    false
}

// The span is empty or holds a NUL byte.
mod_span_invalid: fn(context: I64, span: I64) -> Bool {
    length: mod_word(context, wrapping(span + I64{8}))
    length == I64{0} || mod_bytes_have_nul(wrapping(mod_word(context, MOD_BYTES) + mod_word(context, span)), length)
}

mod_spans_equal: fn(context: I64, left: I64, right: I64) -> Bool {
    length: mod_word(context, wrapping(left + I64{8}))
    bytes: mod_word(context, MOD_BYTES)
    length == mod_word(context, wrapping(right + I64{8})) && rt_text_equal_bytes(wrapping(bytes + mod_word(context, left)), wrapping(bytes + mod_word(context, right)), length)
}

mod_texts_equal: fn(left: I64, right: I64) -> Bool {
    rt_text_len(left) == rt_text_len(right) && rt_text_equal_bytes(rt_text_data(left), rt_text_data(right), rt_text_len(left))
}

// Path::display of exact path bytes.
mod_push_display: fn(target: I64, path: I64) {
    shown: rt_text_lossy(rt_text_data(path), rt_text_len(path))
    jet_rt_string_builder_push(target, shown)
    jet_rt_string_drop(shown)
}

mod_unlink: fn(path: I64) {
    name: fd_c_path(path)
    _ := host_call(I64{87}, name, I64{0}, I64{0})
    fd_c_path_drop(name, path)
}

// std::fs::metadata (following links) st_mode, or -1 when it fails.
mod_metadata_mode: fn(path: I64) -> I64 {
    scratch: jet_rt_alloc(I64{160}, I64{8})
    jet_fs_stat_raw(path, true, scratch, wrapping(scratch + I64{128}))
    failed: rt_text_word(wrapping(scratch + I64{128})) != I64{0}
    mode: rt_text_word(wrapping(scratch + I64{16})).bit_and(I64{61440})
    jet_rt_free(scratch, I64{160}, I64{8})
    if failed -> return I64{-1}
    mode
}

// reject_reparse_components: lstat every component prefix of the absolute
// path. A symlink is Denied; a component that does not exist is skipped;
// any other inspection failure is Invalid. Returns the reason or 0.
mod_reject_reparse: fn(path: I64, label: I64) -> I64 {
    absolute := I64{0}
    if jet_fs_host_path_is_absolute_raw(path) {
        absolute = jet_rt_string_clone(path)
    } else {
        scratch: jet_rt_alloc(I64{16}, I64{8})
        if (jet_sys_current_dir_raw(scratch, wrapping(scratch + I64{8})) == I64{0}) {
            cause: rt_text_word(wrapping(scratch + I64{8}))
            jet_rt_free(scratch, I64{16}, I64{8})
            reason: mod_reason(rt_static_text("Invalid: "), rt_static_text("cannot resolve "))
            jet_rt_string_builder_push(reason, label)
            jet_rt_string_builder_push(reason, rt_static_text(": "))
            jet_rt_string_builder_push(reason, cause)
            jet_rt_string_drop(cause)
            return reason
        }
        current: rt_text_word(scratch)
        jet_rt_free(scratch, I64{16}, I64{8})
        absolute = jet_fs_host_path_join_raw(current, path)
        jet_rt_string_drop(current)
    }
    data: rt_text_data(absolute)
    length: rt_text_len(absolute)
    prefix: jet_rt_alloc(wrapping(length + I64{1}), I64{1})
    failure := I64{0}
    start := I64{0}
    at := I64{0}
    loop at <= length && failure == (I64{0}) {
        boundary: at == length || rt_text_byte(wrapping(data + at)) == I64{47}
        if !boundary {
            at += I64{1}
            next
        }
        // The root, then each non-empty component other than `.`.
        component: at - start
        root: at == I64{0} && length > I64{0}
        dot: component == I64{1} && rt_text_byte(wrapping(data + start)) == I64{46}
        if root || (component > I64{0} && !dot) {
            end: if root -> I64{1} else -> at
            rt_text_bytes_copy(prefix, data, end)
            rt_text_put(wrapping(prefix + end), I64{0})
            mode: if mod_bytes_have_nul(data, end) -> I64{-22} else -> files_lstat_c(prefix)
            if (mode == I64{-2}) {
                // NotFound: the component is not there yet.
            } else if (mode < I64{0}) {
                failure = mod_reason(rt_static_text("Invalid: "), rt_static_text("cannot inspect "))
                jet_rt_string_builder_push(failure, label)
                jet_rt_string_builder_push(failure, rt_static_text(": "))
                if (mode == I64{-22}) {
                    jet_rt_string_builder_push(failure, rt_static_text("file name contained an unexpected NUL byte"))
                } else {
                    host_errno_cause_append(failure, -mode)
                }
            } else if (mode.bit_and(I64{61440}) == I64{40960}) {
                failure = mod_reason(rt_static_text("Denied: "), label)
                jet_rt_string_builder_push(failure, rt_static_text(" contains a symlink or reparse point"))
            }
        }
        at += I64{1}
        start = at
    }
    jet_rt_free(prefix, wrapping(length + I64{1}), I64{1})
    jet_rt_string_drop(absolute)
    failure
}

// std::fs::canonicalize as exact path bytes; a failure stores the tagged
// reason (NotFound for ENOENT, else Invalid) and returns 0.
mod_realpath: fn(path: I64, label: I64, error: I64) -> I64 {
    name: fd_c_path(path)
    scratch: jet_rt_alloc(I64{48}, I64{8})
    bytes: jet_process_path_canonicalize_raw(name, scratch, wrapping(scratch + I64{8}), wrapping(scratch + I64{16}))
    fd_c_path_drop(name, path)
    if (bytes == I64{0}) {
        code: rt_text_word(wrapping(scratch + I64{24}))
        jet_rt_free(scratch, I64{48}, I64{8})
        opening: if (code == I64{2}) -> rt_static_text("NotFound: ") else -> rt_static_text("Invalid: ")
        reason: mod_reason(opening, rt_static_text("cannot resolve "))
        jet_rt_string_builder_push(reason, label)
        jet_rt_string_builder_push(reason, rt_static_text(" `"))
        mod_push_display(reason, path)
        jet_rt_string_builder_push(reason, rt_static_text("`: "))
        host_errno_cause_append(reason, code)
        rt_text_store(error, reason)
        return I64{0}
    }
    result: rt_text_copy(bytes, rt_text_word(scratch))
    jet_rt_free(bytes, rt_text_word(wrapping(scratch + I64{8})), I64{1})
    jet_rt_free(scratch, I64{48}, I64{8})
    result
}

// canonical_revalidated: reject reparse components, canonicalize, repeat
// both, and require the two resolutions to agree.
mod_canonical: fn(path: I64, label: I64, error: I64) -> I64 {
    refused := mod_reject_reparse(path, label)
    if (refused != I64{0}) {
        rt_text_store(error, refused)
        return I64{0}
    }
    first: mod_realpath(path, label, error)
    if (first == I64{0}) -> return I64{0}
    refused = mod_reject_reparse(path, label)
    if (refused != I64{0}) {
        jet_rt_string_drop(first)
        rt_text_store(error, refused)
        return I64{0}
    }
    second: mod_realpath(path, label, error)
    if (second == I64{0}) {
        jet_rt_string_drop(first)
        return I64{0}
    }
    same: mod_texts_equal(first, second)
    jet_rt_string_drop(first)
    if !same {
        jet_rt_string_drop(second)
        reason: mod_reason(rt_static_text("Invalid: "), label)
        jet_rt_string_builder_push(reason, rt_static_text(" changed while it was being resolved"))
        rt_text_store(error, reason)
        return I64{0}
    }
    second
}

// Path::strip_prefix: `path` is `root` or lies below it, component-wise.
mod_within: fn(path: I64, root: I64) -> Bool {
    length: rt_text_len(root)
    if (rt_text_len(path) < length || !rt_text_equal_bytes(rt_text_data(path), rt_text_data(root), length)) -> return false
    if (rt_text_len(path) == length) -> return true
    if (length > I64{0} && rt_text_byte(wrapping(rt_text_data(root) + length - I64{1})) == I64{47}) -> return true
    rt_text_byte(wrapping(rt_text_data(path) + length)) == I64{47}
}

mod_outside: fn(path: I64, error: I64) -> I64 {
    reason: mod_reason(rt_static_text("Denied: "), rt_static_text("library path `"))
    jet_rt_string_builder_push(reason, path)
    jet_rt_string_builder_push(reason, rt_static_text("` is outside the granted read roots"))
    rt_text_store(error, reason)
    I64{0}
}

// granted_path: the canonical library path when it is a regular file under
// one of the granted roots; else the tagged refusal and 0.
mod_granted_path: fn(path: I64, roots: I64, count: I64, error: I64) -> I64 {
    if (count == I64{0}) {
        rt_text_store(error, jet_rt_string_clone(rt_static_text("Denied: Mod.load requires a non-empty `read` grant")))
        return I64{0}
    }
    canonical: mod_canonical(path, rt_static_text("library path"), error)
    if (canonical == I64{0}) -> return I64{0}
    if (mod_metadata_mode(canonical) != I64{32768}) {
        jet_rt_string_drop(canonical)
        reason: mod_reason(rt_static_text("Invalid: "), rt_static_text("library path `"))
        jet_rt_string_builder_push(reason, path)
        jet_rt_string_builder_push(reason, rt_static_text("` is not a regular file"))
        rt_text_store(error, reason)
        return I64{0}
    }
    index := I64{0}
    loop index < count {
        granted: rt_text_word(wrapping(roots + index * I64{8}))
        index += I64{1}
        root: mod_canonical(granted, rt_static_text("read grant root"), error)
        if (root == I64{0}) {
            jet_rt_string_drop(canonical)
            return I64{0}
        }
        kind: mod_metadata_mode(root)
        if (kind != I64{16384} && kind != I64{32768}) {
            jet_rt_string_drop(root)
            next
        }
        root_again: mod_canonical(root, rt_static_text("read grant root"), error)
        if (root_again == I64{0}) {
            jet_rt_string_drop(root)
            jet_rt_string_drop(canonical)
            return I64{0}
        }
        canonical_again: mod_canonical(path, rt_static_text("library path"), error)
        if (canonical_again == I64{0}) {
            jet_rt_string_drop(root_again)
            jet_rt_string_drop(root)
            jet_rt_string_drop(canonical)
            return I64{0}
        }
        stable: mod_texts_equal(root, root_again) && mod_texts_equal(canonical, canonical_again)
        jet_rt_string_drop(root_again)
        jet_rt_string_drop(canonical_again)
        if !stable {
            jet_rt_string_drop(root)
            jet_rt_string_drop(canonical)
            rt_text_store(error, jet_rt_string_clone(rt_static_text("Invalid: library path or read grant root changed while it was being checked")))
            return I64{0}
        }
        inside: mod_within(canonical, root)
        jet_rt_string_drop(root)
        if inside -> return canonical
    }
    jet_rt_string_drop(canonical)
    mod_outside(path, error)
}

#Export(c) jet_mod_supported_raw: fn() -> Bool { true }

#Export(c) jet_mod_os_raw: fn() -> I64 { jet_rt_string_clone(rt_static_text("linux")) }

// Grant the path, then read the whole artifact into a new loader context.
#Export(c) jet_mod_read_context_raw: fn(path: I64, roots: I64, count: I64, ok: I64, err: I64) -> I64 {
    granted: if (roots == I64{0} || count <= I64{0}) -> I64{0} else -> count
    source: mod_granted_path(path, roots, granted, err)
    if (source == I64{0}) -> return I64{0}
    name: fd_c_path(source)
    output: jet_rt_alloc(I64{24}, I64{8})
    code: walk_read_file(name, output)
    fd_c_path_drop(name, source)
    if (code < I64{0}) {
        jet_rt_free(output, I64{24}, I64{8})
        opening: if (code == I64{-2}) -> rt_static_text("NotFound: ") else -> rt_static_text("Invalid: ")
        reason: mod_reason(opening, rt_static_text("cannot read library `"))
        mod_push_display(reason, source)
        jet_rt_string_builder_push(reason, rt_static_text("`: "))
        host_errno_cause_append(reason, -code)
        jet_rt_string_drop(source)
        rt_text_store(err, reason)
        return I64{0}
    }
    jet_rt_string_drop(source)
    context: jet_rt_alloc(MOD_CONTEXT_BYTES, I64{8})
    at := I64{0}
    loop at < MOD_CONTEXT_BYTES {
        mod_put(context, at, I64{0})
        at += I64{8}
    }
    mod_put(context, MOD_BYTES, rt_text_word(output))
    mod_put(context, MOD_LENGTH, rt_text_word(wrapping(output + I64{8})))
    mod_put(context, MOD_CAPACITY, rt_text_word(wrapping(output + I64{16})))
    jet_rt_free(output, I64{24}, I64{8})
    rt_text_store(ok, context)
    I64{1}
}

mod_header_error: fn(head: I64, what: I64, tail: I64) -> I64 {
    reason: mod_reason(head, what)
    jet_rt_string_builder_push(reason, tail)
    reason
}

// A big-endian unsigned field of `width` bytes at `at`.
mod_be: fn(context: I64, at: I64, width: I64) -> I64 {
    data: wrapping(mod_word(context, MOD_BYTES) + at)
    value := I64{0}
    index := I64{0}
    loop index < width {
        value = (value << I64{8}).bit_or(rt_text_byte(wrapping(data + index)))
        index += I64{1}
    }
    value
}

mod_rest: fn(context: I64) -> I64 { mod_word(context, MOD_LENGTH) - mod_word(context, MOD_CURSOR) }

// jetlib_take: a u32 length-prefixed field stored as a span at `span`.
mod_take: fn(context: I64, what: I64, span: I64) -> I64 {
    at: mod_word(context, MOD_CURSOR)
    rest: mod_rest(context)
    if (rest < I64{4}) -> return mod_header_error(rt_static_text("truncated .jetlib header ("), what, rt_static_text(" length)"))
    size: mod_be(context, at, I64{4})
    if (size > MOD_MAX_FIELD_BYTES) -> return mod_header_error(rt_static_text(".jetlib header "), what, rt_static_text(" is too large"))
    if (rest - I64{4} < size) -> return mod_header_error(rt_static_text("truncated .jetlib header ("), what, rt_static_text(")"))
    rt_text_store(span, at + I64{4})
    rt_text_store(wrapping(span + I64{8}), size)
    mod_put(context, MOD_CURSOR, at + I64{4} + size)
    I64{0}
}

// jetlib_string: a field that must be UTF-8.
mod_string: fn(context: I64, what: I64, span: I64) -> I64 {
    failure: mod_take(context, what, span)
    if (failure != I64{0}) -> return failure
    if !files_utf8_valid(wrapping(mod_word(context, MOD_BYTES) + rt_text_word(span)), rt_text_word(wrapping(span + I64{8}))) {
        return mod_header_error(rt_static_text(".jetlib header "), what, rt_static_text(" is not UTF-8"))
    }
    I64{0}
}

mod_u32: fn(context: I64, what: I64, out: I64) -> I64 {
    if (mod_rest(context) < I64{4}) -> return mod_header_error(rt_static_text("truncated .jetlib header ("), what, rt_static_text(")"))
    at: mod_word(context, MOD_CURSOR)
    rt_text_store(out, mod_be(context, at, I64{4}))
    mod_put(context, MOD_CURSOR, at + I64{4})
    I64{0}
}

mod_byte: fn(context: I64, what: I64, out: I64) -> I64 {
    if (mod_rest(context) < I64{1}) -> return mod_header_error(rt_static_text("truncated .jetlib header ("), what, rt_static_text(")"))
    at: mod_word(context, MOD_CURSOR)
    rt_text_store(out, rt_text_byte(wrapping(mod_word(context, MOD_BYTES) + at)))
    mod_put(context, MOD_CURSOR, at + I64{1})
    I64{0}
}

// jetlib_count: a u32 item count of at most MOD_MAX_HEADER_ITEMS.
mod_count: fn(context: I64, counted: I64, what: I64, out: I64) -> I64 {
    failure: mod_u32(context, counted, out)
    if (failure != I64{0}) -> return failure
    if (rt_text_word(out) > MOD_MAX_HEADER_ITEMS) -> return mod_header_error(rt_static_text(".jetlib header has too many "), what, rt_static_text(" entries"))
    I64{0}
}

mod_tag_error: fn(head: I64, value: I64) -> I64 {
    reason: jet_rt_string_builder_new()
    jet_rt_string_builder_push(reason, head)
    rt_text_push_number(reason, value)
    reason
}

mod_parse_exports: fn(context: I64) -> I64 {
    failure := mod_count(context, rt_static_text("export count"), rt_static_text("export"), wrapping(context + MOD_SCRATCH))
    if (failure != I64{0}) -> return failure
    count: mod_word(context, MOD_SCRATCH)
    if (count > I64{0}) {
        mod_put(context, MOD_EXPORTS, jet_rt_alloc(count * MOD_EXPORT_BYTES, I64{8}))
        mod_put(context, MOD_EXPORT_COUNT, count)
    }
    index := I64{0}
    loop index < count {
        row: wrapping(mod_word(context, MOD_EXPORTS) + index * MOD_EXPORT_BYTES)
        index += I64{1}
        failure = mod_string(context, rt_static_text("export name"), row)
        if (failure != I64{0}) -> return failure
        failure = mod_string(context, rt_static_text("export symbol"), wrapping(row + I64{16}))
        if (failure != I64{0}) -> return failure
        failure = mod_byte(context, rt_static_text("export scalar"), wrapping(row + I64{32}))
        if (failure != I64{0}) -> return failure
        scalar: rt_text_word(wrapping(row + I64{32}))
        if (scalar > I64{3}) -> return mod_tag_error(rt_static_text("unknown .jetlib scalar tag "), scalar)
        failure = mod_u32(context, rt_static_text("export parameter count"), wrapping(context + MOD_SCRATCH))
        if (failure != I64{0}) -> return failure
        params: mod_word(context, MOD_SCRATCH)
        if (params > MOD_MAX_EXPORT_PARAMS) -> return jet_rt_string_clone(rt_static_text(".jetlib export has too many parameters"))
        // Each access convention is checked here; the parsed list always
        // has exactly `params` entries, so no later count check can fail.
        convention := I64{0}
        loop convention < params {
            failure = mod_byte(context, rt_static_text("access convention"), wrapping(context + MOD_SCRATCH))
            if (failure != I64{0}) -> return failure
            access: mod_word(context, MOD_SCRATCH)
            if (access > I64{2}) -> return mod_tag_error(rt_static_text("unknown .jetlib access-convention tag "), access)
            convention += I64{1}
        }
    }
    I64{0}
}

mod_parse_effects: fn(context: I64) -> I64 {
    failure := mod_count(context, rt_static_text("effect count"), rt_static_text("effect"), wrapping(context + MOD_SCRATCH))
    if (failure != I64{0}) -> return failure
    count: mod_word(context, MOD_SCRATCH)
    if (count > I64{0}) {
        mod_put(context, MOD_EFFECTS, jet_rt_alloc(count * MOD_EFFECT_BYTES, I64{8}))
        mod_put(context, MOD_EFFECT_COUNT, count)
    }
    index := I64{0}
    loop index < count {
        failure = mod_string(context, rt_static_text("effect"), wrapping(mod_word(context, MOD_EFFECTS) + index * MOD_EFFECT_BYTES))
        if (failure != I64{0}) -> return failure
        index += I64{1}
    }
    I64{0}
}

// jetlib_header over the context bytes; the reason (untagged) or 0.
mod_parse: fn(context: I64) -> I64 {
    bytes: mod_word(context, MOD_BYTES)
    if (mod_word(context, MOD_LENGTH) < I64{14} || !rt_text_equal_bytes(bytes, rt_text_data(rt_static_text("jet-jetlib-v3")), I64{13}) || rt_text_byte(wrapping(bytes + I64{13})) != I64{0}) {
        return jet_rt_string_clone(rt_static_text("not a .jetlib artifact (bad magic)"))
    }
    mod_put(context, MOD_CURSOR, I64{14})
    failure := mod_string(context, rt_static_text("compiler version"), wrapping(context + MOD_COMPILER_VERSION))
    if (failure != I64{0}) -> return failure
    failure = mod_string(context, rt_static_text("compiler build"), wrapping(context + MOD_COMPILER_BUILD))
    if (failure != I64{0}) -> return failure
    failure = mod_string(context, rt_static_text("library name"), wrapping(context + MOD_LIBRARY_NAME))
    if (failure != I64{0}) -> return failure
    failure = mod_byte(context, rt_static_text("output entry presence"), wrapping(context + MOD_ENTRY_PRESENT))
    if (failure != I64{0}) -> return failure
    present: mod_word(context, MOD_ENTRY_PRESENT)
    if (present > I64{1}) -> return mod_tag_error(rt_static_text("invalid .jetlib output entry presence tag "), present)
    if (present == I64{1}) {
        failure = mod_string(context, rt_static_text("output entry"), wrapping(context + MOD_ENTRY))
        if (failure != I64{0}) -> return failure
    }
    failure = mod_string(context, rt_static_text("target"), wrapping(context + MOD_TARGET))
    if (failure != I64{0}) -> return failure
    failure = mod_string(context, rt_static_text("target triple"), wrapping(context + MOD_TARGET_TRIPLE))
    if (failure != I64{0}) -> return failure
    failure = mod_string(context, rt_static_text("linker identity"), wrapping(context + MOD_LINKER))
    if (failure != I64{0}) -> return failure
    failure = mod_string(context, rt_static_text("ABI identity"), wrapping(context + MOD_ABI_IDENTITY))
    if (failure != I64{0}) -> return failure
    failure = mod_u32(context, rt_static_text("ABI version"), wrapping(context + MOD_ABI_VERSION))
    if (failure != I64{0}) -> return failure
    failure = mod_parse_exports(context)
    if (failure != I64{0}) -> return failure
    failure = mod_parse_effects(context)
    if (failure != I64{0}) -> return failure
    failure = mod_string(context, rt_static_text("payload digest"), wrapping(context + MOD_DIGEST))
    if (failure != I64{0}) -> return failure
    if (mod_rest(context) < I64{8}) -> return jet_rt_string_clone(rt_static_text("truncated .jetlib artifact (payload length)"))
    at: mod_word(context, MOD_CURSOR)
    declared: mod_be(context, at, I64{8})
    found: mod_rest(context) - I64{8}
    if (declared != found) {
        reason: jet_rt_string_builder_new()
        jet_rt_string_builder_push(reason, rt_static_text("truncated .jetlib artifact (payload declares "))
        vault_push_u64(reason, declared)
        jet_rt_string_builder_push(reason, rt_static_text(" bytes, found "))
        rt_text_push_number(reason, found)
        jet_rt_string_builder_push(reason, rt_static_text(")"))
        return reason
    }
    mod_put(context, MOD_PAYLOAD, at + I64{8})
    I64{0}
}

#Export(c) jet_mod_parse_context_raw: fn(id: I64, err: I64) -> I64 {
    failure: mod_parse(jet_int_owned_to_i64(id))
    if (failure != I64{0}) {
        rt_text_store(err, failure)
        return I64{0}
    }
    I64{1}
}

// `sha256-` and 64 lowercase hex digits.
mod_digest_valid: fn(context: I64) -> Bool {
    if (mod_word(context, wrapping(MOD_DIGEST + I64{8})) != I64{71}) -> return false
    data: wrapping(mod_word(context, MOD_BYTES) + mod_word(context, MOD_DIGEST))
    if !rt_text_equal_bytes(data, rt_text_data(rt_static_text("sha256-")), I64{7}) -> return false
    at := I64{7}
    loop at < (I64{71}) {
        byte: rt_text_byte(wrapping(data + at))
        if !((byte >= I64{48} && byte <= I64{57}) || (byte >= I64{97} && byte <= I64{102})) -> return false
        at += I64{1}
    }
    true
}

// c_symbol(name): each char that is not an ASCII letter, digit or `_`
// becomes one `_`; an empty or digit-led result gains a leading `_`.
mod_c_symbol: fn(context: I64, span: I64) -> I64 {
    data: wrapping(mod_word(context, MOD_BYTES) + mod_word(context, span))
    length: mod_word(context, wrapping(span + I64{8}))
    out: jet_rt_string_builder_new()
    first: if (length > I64{0}) -> rt_text_byte(data) else -> I64{0}
    if (length == I64{0} || (first >= I64{48} && first <= I64{57})) -> rt_text_push_word(out, I64{95}, I64{1})
    at := I64{0}
    loop at < length {
        byte: rt_text_byte(wrapping(data + at))
        at += I64{1}
        if ((byte >= I64{48} && byte <= I64{57}) || (byte >= I64{65} && byte <= I64{90}) || (byte >= I64{97} && byte <= I64{122}) || byte == I64{95}) {
            rt_text_push_word(out, byte, I64{1})
            next
        }
        rt_text_push_word(out, I64{95}, I64{1})
        // Skip the char's UTF-8 continuation bytes.
        loop at < length && rt_text_byte(wrapping(data + at)).bit_and(I64{192}) == (I64{128}) {
            at += I64{1}
        }
    }
    out
}

mod_library_error: fn(opening: I64, context: I64, tail: I64) -> I64 {
    reason: mod_reason(opening, rt_static_text("E1341: library `"))
    mod_push_span(reason, context, MOD_LIBRARY_NAME)
    jet_rt_string_builder_push(reason, tail)
    reason
}

mod_check_exports: fn(context: I64) -> I64 {
    count: mod_word(context, MOD_EXPORT_COUNT)
    if (count == I64{0}) -> return mod_library_error(rt_static_text("Invalid: "), context, rt_static_text("` has no exported functions"))
    rows: mod_word(context, MOD_EXPORTS)
    index := I64{0}
    loop index < count {
        row: wrapping(rows + index * MOD_EXPORT_BYTES)
        name: wrapping(row - context)
        symbol: wrapping(name + I64{16})
        if mod_span_invalid(context, name) -> return jet_rt_string_clone(rt_static_text("Invalid: E1341: .jetlib metadata has an invalid export name"))
        expected: mod_c_symbol(context, name)
        matches: mod_span_is(context, symbol, expected)
        jet_rt_string_drop(expected)
        if (mod_span_invalid(context, symbol) || !matches) {
            reason: mod_reason(rt_static_text("Invalid: "), rt_static_text("E1341: .jetlib export `"))
            mod_push_span(reason, context, name)
            jet_rt_string_builder_push(reason, rt_static_text("` has an invalid native symbol `"))
            mod_push_span(reason, context, symbol)
            jet_rt_string_builder_push(reason, rt_static_text("`"))
            return reason
        }
        earlier := I64{0}
        loop earlier < index {
            other: wrapping(wrapping(rows + earlier * MOD_EXPORT_BYTES) - context)
            if mod_spans_equal(context, name, other) {
                reason: mod_reason(rt_static_text("Invalid: "), rt_static_text("E1341: .jetlib metadata repeats export `"))
                mod_push_span(reason, context, name)
                jet_rt_string_builder_push(reason, rt_static_text("`"))
                return reason
            }
            earlier += I64{1}
        }
        earlier = I64{0}
        loop earlier < index {
            other: wrapping(wrapping(wrapping(rows + earlier * MOD_EXPORT_BYTES) - context) + I64{16})
            if mod_spans_equal(context, symbol, other) {
                reason: mod_reason(rt_static_text("Invalid: "), rt_static_text("E1341: .jetlib metadata repeats native symbol `"))
                mod_push_span(reason, context, symbol)
                jet_rt_string_builder_push(reason, rt_static_text("`"))
                return reason
            }
            earlier += I64{1}
        }
        index += I64{1}
    }
    I64{0}
}

// check_before_map: compiler identity first, then ABI, metadata, target,
// exports and declared effects. Every refusal is tagged.
mod_check: fn(context: I64) -> I64 {
    // The runtime ships with its compiler at one Jet version (JET_VERSION,
    // which tests/guards/jet_version.jet holds this literal to); a library
    // from another is E1338.
    if !mod_span_is(context, MOD_COMPILER_VERSION, rt_static_text("a0.0.44")) {
        reason: mod_reason(rt_static_text("Unsupported: "), rt_static_text("E1338: library `"))
        mod_push_span(reason, context, MOD_LIBRARY_NAME)
        jet_rt_string_builder_push(reason, rt_static_text("` was built by Jet `"))
        mod_push_span(reason, context, MOD_COMPILER_VERSION)
        jet_rt_string_builder_push(reason, rt_static_text("`, but the loader uses Jet `a0.0.44`"))
        return reason
    }
    version: mod_word(context, MOD_ABI_VERSION)
    if (version != MOD_ABI_VERSION_ACCEPTED) {
        reason: mod_library_error(rt_static_text("Unsupported: "), context, rt_static_text("` uses unsupported .jetlib ABI version "))
        rt_text_push_number(reason, version)
        jet_rt_string_builder_push(reason, rt_static_text("; this loader accepts ABI version 2"))
        return reason
    }
    if mod_span_invalid(context, MOD_LIBRARY_NAME) -> return jet_rt_string_clone(rt_static_text("Invalid: E1341: .jetlib metadata has no valid Library name"))
    if (mod_word(context, MOD_ENTRY_PRESENT) == I64{1} && mod_span_invalid(context, MOD_ENTRY)) -> return jet_rt_string_clone(rt_static_text("Invalid: E1341: .jetlib metadata has an invalid output entry"))
    if mod_span_invalid(context, MOD_COMPILER_BUILD) -> return jet_rt_string_clone(rt_static_text("Invalid: E1341: .jetlib metadata has no valid compiler build"))
    if mod_span_invalid(context, MOD_TARGET_TRIPLE) -> return jet_rt_string_clone(rt_static_text("Invalid: E1341: .jetlib metadata has no valid target triple"))
    if mod_span_invalid(context, MOD_LINKER) -> return jet_rt_string_clone(rt_static_text("Invalid: E1341: .jetlib metadata has no valid linker identity"))
    if !mod_span_is(context, MOD_ABI_IDENTITY, rt_static_text("jet.library.abi.v2;call=extern-c;scalar=homogeneous;access=read-write-move;text=jet-text-v1;ptr-len=checked-utf8")) {
        reason: mod_library_error(rt_static_text("Unsupported: "), context, rt_static_text("` uses unsupported native ABI identity `"))
        mod_push_span(reason, context, MOD_ABI_IDENTITY)
        jet_rt_string_builder_push(reason, rt_static_text("`"))
        return reason
    }
    if !mod_digest_valid(context) -> return mod_library_error(rt_static_text("Invalid: "), context, rt_static_text("` has no valid native payload digest"))
    if !mod_span_is(context, MOD_TARGET, rt_static_text("linux-x86_64")) {
        reason: mod_library_error(rt_static_text("Unsupported: "), context, rt_static_text("` targets `"))
        mod_push_span(reason, context, MOD_TARGET)
        jet_rt_string_builder_push(reason, rt_static_text("`, but this loader targets `linux-x86_64`"))
        return reason
    }
    failure: mod_check_exports(context)
    if (failure != I64{0}) -> return failure
    // The load-site grant spells filesystem roots only, so a library may
    // declare `FS` or an `FS.` effect and nothing else.
    effects: mod_word(context, MOD_EFFECTS)
    index := I64{0}
    loop index < mod_word(context, MOD_EFFECT_COUNT) {
        declared: wrapping(wrapping(effects + index * MOD_EFFECT_BYTES) - context)
        index += I64{1}
        length: mod_word(context, wrapping(declared + I64{8}))
        data: wrapping(mod_word(context, MOD_BYTES) + mod_word(context, declared))
        if mod_span_is(context, declared, rt_static_text("FS")) -> next
        if (length >= I64{3} && rt_text_equal_bytes(data, rt_text_data(rt_static_text("FS.")), I64{3})) -> next
        reason: mod_reason(rt_static_text("Denied: "), rt_static_text("E1339: library `"))
        mod_push_span(reason, context, MOD_LIBRARY_NAME)
        jet_rt_string_builder_push(reason, rt_static_text("` declares `"))
        mod_push_span(reason, context, declared)
        jet_rt_string_builder_push(reason, rt_static_text("`, which this load site does not grant"))
        return reason
    }
    I64{0}
}

#Export(c) jet_mod_check_context_raw: fn(id: I64, err: I64) -> I64 {
    failure: mod_check(jet_int_owned_to_i64(id))
    if (failure != I64{0}) {
        rt_text_store(err, failure)
        return I64{0}
    }
    I64{1}
}

#Export(c) jet_mod_context_name_raw: fn(id: I64) -> I64 {
    mod_span_text(jet_int_owned_to_i64(id), MOD_LIBRARY_NAME)
}

// The payload's `sha256-<hex>` digest equals the header's.
#Export(c) jet_mod_context_digest_raw: fn(id: I64) -> Bool {
    context: jet_int_owned_to_i64(id)
    payload: mod_word(context, MOD_PAYLOAD)
    scratch: jet_rt_alloc(I64{608}, I64{8})
    jet_rt_native_sha256(wrapping(mod_word(context, MOD_BYTES) + payload), mod_word(context, MOD_LENGTH) - payload, scratch, wrapping(scratch + I64{32}))
    actual: jet_rt_string_builder_new()
    jet_rt_string_builder_push(actual, rt_static_text("sha256-"))
    digits: rt_static_text("0123456789abcdef")
    at := I64{0}
    loop at < (I64{32}) {
        byte: rt_text_byte(wrapping(scratch + at))
        rt_text_append(actual, wrapping(rt_text_data(digits) + (byte >> I64{4})), I64{1})
        rt_text_append(actual, wrapping(rt_text_data(digits) + byte.bit_and(I64{15})), I64{1})
        at += I64{1}
    }
    jet_rt_free(scratch, I64{608}, I64{8})
    same: mod_span_is(context, MOD_DIGEST, actual)
    jet_rt_string_drop(actual)
    same
}

mod_stage_error: fn(errno: I64) -> I64 {
    reason: jet_rt_string_clone(rt_static_text("cannot stage library payload: "))
    reason_text: jet_rt_string_builder_new()
    jet_rt_string_builder_push(reason_text, reason)
    jet_rt_string_drop(reason)
    host_errno_cause_append(reason_text, errno)
    reason_text
}

// Write the payload to a new `$TMPDIR/jet-mod-<pid>-<serial>.so` (created
// exclusively; the first free serial). Close removes it unless finish kept it.
#Export(c) jet_mod_stage_context_raw: fn(id: I64, err: I64) -> I64 {
    context: jet_int_owned_to_i64(id)
    directory: jet_fs_temp_directory_raw()
    pid: host_call(I64{39}, I64{0}, I64{0}, I64{0})
    serial := I64{0}
    staged := I64{0}
    fd := I64{0}
    loop {
        leaf: jet_rt_string_builder_new()
        jet_rt_string_builder_push(leaf, rt_static_text("jet-mod-"))
        rt_text_push_number(leaf, pid)
        jet_rt_string_builder_push(leaf, rt_static_text("-"))
        rt_text_push_number(leaf, serial)
        jet_rt_string_builder_push(leaf, rt_static_text(".so"))
        staged = jet_fs_host_path_join_raw(directory, leaf)
        jet_rt_string_drop(leaf)
        name: fd_c_path(staged)
        loop {
            fd = host_call(I64{2}, name, MOD_STAGE_FLAGS, I64{438})
            if (fd != I64{-4}) -> break
        }
        fd_c_path_drop(name, staged)
        if (fd != I64{-17}) -> break
        jet_rt_string_drop(staged)
        serial += I64{1}
    }
    jet_rt_string_drop(directory)
    if (fd < I64{0}) {
        jet_rt_string_drop(staged)
        rt_text_store(err, mod_stage_error(-fd))
        return I64{0}
    }
    data: wrapping(mod_word(context, MOD_BYTES) + mod_word(context, MOD_PAYLOAD))
    length: mod_word(context, MOD_LENGTH) - mod_word(context, MOD_PAYLOAD)
    written := I64{0}
    failure := I64{0}
    loop written < length {
        count: host_call(I64{1}, fd, wrapping(data + written), length - written)
        if (count == I64{-4}) -> next
        if (count < I64{0}) {
            failure = -count
            break
        }
        if (count == I64{0}) {
            // write_all: a zero-byte write is WriteZero.
            failure = I64{-1}
            break
        }
        written += count
    }
    _ := host_call(I64{3}, fd, I64{0}, I64{0})
    if (failure != I64{0}) {
        mod_unlink(staged)
        jet_rt_string_drop(staged)
        if (failure < I64{0}) {
            rt_text_store(err, jet_rt_string_clone(rt_static_text("cannot stage library payload: failed to write whole buffer")))
        } else {
            rt_text_store(err, mod_stage_error(failure))
        }
        return I64{0}
    }
    mod_put(context, MOD_STAGED, staged)
    I64{1}
}

// Mapping needs the OS loader, which the static runtime does not have.
#Export(c) jet_mod_open_context_raw: fn(id: I64, err: I64) -> I64 {
    context: jet_int_owned_to_i64(id)
    reason: mod_reason(rt_static_text("Unsupported: "), rt_static_text("cannot map library `"))
    mod_push_span(reason, context, MOD_LIBRARY_NAME)
    jet_rt_string_builder_push(reason, rt_static_text("`: the statically linked Jet runtime has no native library loader"))
    rt_text_store(err, reason)
    I64{0}
}

#Export(c) jet_mod_exports_count_raw: fn(id: I64) -> I64 {
    mod_word(jet_int_owned_to_i64(id), MOD_EXPORT_COUNT)
}

#Export(c) jet_mod_export_info_raw: fn(id: I64, index: I64, name: I64, symbol: I64, text: I64) {
    context: jet_int_owned_to_i64(id)
    row: wrapping(wrapping(mod_word(context, MOD_EXPORTS) + jet_int_owned_to_i64(index) * MOD_EXPORT_BYTES) - context)
    sync_store(name, mod_span_text(context, row))
    sync_store(symbol, mod_span_text(context, wrapping(row + I64{16})))
    rt_text_put(text, if (mod_word(context, wrapping(row + I64{32})) == I64{3}) -> I64{1} else -> I64{0})
}

// Symbol lookup needs a mapped payload; no context holds one.
mod_unmapped: fn(err: I64) -> I64 {
    rt_text_store(err, jet_rt_string_clone(rt_static_text("native loader is unavailable on this target")))
    I64{0}
}

#Export(c) jet_mod_resolve_export_raw: fn(_id: I64, _index: I64, err: I64) -> I64 { mod_unmapped(err) }

#Export(c) jet_mod_resolve_symbol_raw: fn(_id: I64, _symbol: I64, err: I64) -> I64 { mod_unmapped(err) }

// Release the context; a payload still staged here is removed.
#Export(c) jet_mod_close_context_raw: fn(id: I64) {
    context: jet_int_owned_to_i64(id)
    if (context == I64{0}) -> return
    staged: mod_word(context, MOD_STAGED)
    if (staged != I64{0}) {
        mod_unlink(staged)
        jet_rt_string_drop(staged)
    }
    exports: mod_word(context, MOD_EXPORTS)
    if (exports != I64{0}) -> jet_rt_free(exports, mod_word(context, MOD_EXPORT_COUNT) * MOD_EXPORT_BYTES, I64{8})
    effects: mod_word(context, MOD_EFFECTS)
    if (effects != I64{0}) -> jet_rt_free(effects, mod_word(context, MOD_EFFECT_COUNT) * MOD_EFFECT_BYTES, I64{8})
    jet_rt_free(mod_word(context, MOD_BYTES), mod_word(context, MOD_CAPACITY), I64{1})
    jet_rt_free(context, MOD_CONTEXT_BYTES, I64{8})
}

// Move the staged payload into the loaded Mod; the later Close finds none.
#Export(c) jet_mod_finish_context_raw: fn(id: I64) -> I64 {
    context: jet_int_owned_to_i64(id)
    loaded: jet_rt_alloc(MOD_HANDLE_BYTES, I64{8})
    mod_put(loaded, I64{0}, I64{0})
    mod_put(loaded, I64{8}, mod_word(context, MOD_STAGED))
    mod_put(context, MOD_STAGED, I64{0})
    loaded
}

#Export(c) jet_rt_handle_drop_jet_mod: fn(value: I64) {
    if (value == I64{0}) -> return
    staged: mod_word(value, I64{8})
    if (staged != I64{0}) {
        mod_unlink(staged)
        jet_rt_string_drop(staged)
    }
    jet_rt_free(value, MOD_HANDLE_BYTES, I64{8})
}
