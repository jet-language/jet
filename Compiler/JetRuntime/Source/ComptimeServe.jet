// Compile-time code's native server. The compiler starts one child per
// compile running this runtime's image bound to a small entry program, whose
// entry hands this server its table (the SIGSYS handler); the compiler then
// loads each comptime batch's code into the child (MAP, WRITE, PROTECT) and
// drives it over two inherited descriptors: commands arrive on fd 3,
// replies leave on fd 4 (JetBackend Image/ComptimeWire.jet spells the
// frames). The compiler reads the child's values and writes host answers
// itself, through READ/WRITE/ALLOC commands, so the child stays a dumb
// server running the image's own runtime: no second runtime and no host
// value code lives here.
//
// Frames are eight little-endian words: kind, then up to seven operands.
// Commands: 1 CALL(address, a0..a4, steps) -> DONE(result); 2 READ(address,
// length) -> the raw bytes; 3 WRITE(address, length) + bytes; 4 ALLOC(size,
// align) -> DONE(pointer); 5 TEXT(length) + bytes -> DONE(String);
// 6 INT(length) + decimal bytes -> DONE(Int); 7 RETURN(word) answers the
// innermost host request; 8 EXIT; 9 FILTER(handler, length, cookie,
// tracer) + BPF program -> DONE(sigaction, prctl, seccomp, ptracer
// results); 10 MAP(address,
// length) -> DONE(mmap result): fresh read-write pages exactly there; 11
// PROTECT(address, length, protection) -> DONE(mprotect result); 12
// ADMIT(flag): the refusal handler reissues a trapped call while the flag is
// set (an admitted `#Impure` block), with no reply.
// Replies: 0 HELLO(count) + count entry words; 1 DONE(words); 2 HOST(kind,
// operands, count, result area); 3 STOP(kind, words); 4 REFUSED(system
// call, first argument), or REFUSED(effect) with a negative effect
// (comptime_serve_refuse).

// The outermost serve frame while the image serves the compiler, else 0.
comptime_serve_root := I64{0}

comptime_serving: fn() -> Bool { comptime_serve_root != I64{0} }

// The filter's cookie (FILTER), and whether the compiler admits the calls
// the code now running makes (ADMIT): the refusal handler then reissues a
// trapped call with the cookie as its sixth argument, which the filter
// allows for a file call (JetBackend ComptimeWire.jet
// x64_comptime_admit_block).
comptime_serve_cookie := I64{0}

comptime_serve_admitted := I64{0}

// The steps the running CALL has left (its seventh operand). Each turn poll
// of compile-time code (a loop's iteration, a recursive body's entry)
// spends one inline (JetIR X64Select.jet ir_x64_armed_poll); once the word
// is below zero the turn's routine stops the call
// (comptime_serve_out_of_steps). A step is counted, never timed, so a
// program's limit gives the same answer on every machine.
comptime_serve_steps := I64{0}

comptime_serve_move: fn(fd: I64, number: I64, address: I64, count: I64) {
    at := I64{0}
    loop at < count {
        moved: trap_syscall(number, fd, address + at, count - at, I64{0}, I64{0}, I64{0})
        if (moved == I64{-4}) { next }
        // The compiler went away or sent a bad address: nothing is left to serve.
        if (moved <= I64{0}) {
            trap_defect_exit(I64{125})
            return
        }
        at += moved
    }
}

comptime_serve_receive: fn(address: I64, count: I64) {
    comptime_serve_move(I64{3}, I64{0}, address, count)
}

comptime_serve_send: fn(address: I64, count: I64) {
    comptime_serve_move(I64{4}, I64{1}, address, count)
}

// Fills `frame` with `kind` and four words (the rest zero).
comptime_serve_fill: fn(frame: I64, kind: I64, a: I64, b: I64, c: I64, d: I64) {
    thread_zero(frame, I64{64})
    trap_store(frame, kind)
    trap_store(wrapping(frame + I64{8}), a)
    trap_store(wrapping(frame + I64{16}), b)
    trap_store(wrapping(frame + I64{24}), c)
    trap_store(wrapping(frame + I64{32}), d)
}

comptime_serve_reply: fn(frame: I64, kind: I64, a: I64, b: I64, c: I64, d: I64) {
    comptime_serve_fill(frame, kind, a, b, c, d)
    comptime_serve_send(frame, I64{64})
}

// `length` bytes from the compiler in a scratch buffer, made the runtime
// value `kind` names (5: a String, 6: an Int from its decimal).
comptime_serve_value: fn(kind: I64, length: I64) -> I64 {
    size: if (length < I64{8}) -> I64{8} else -> length
    scratch: jet_rt_alloc(size, I64{8})
    comptime_serve_receive(scratch, length)
    value: if (kind == I64{5}) -> jet_rt_string_from_static(scratch, length) else -> jet_rt_int_from_static(scratch, length)
    jet_rt_free(scratch, size, I64{8})
    value
}

// Installs the SIGSYS handler `handler` (the object's
// __jet_comptime_refused) and then the compiler's seccomp program of
// `length` bytes: a refused system call traps to the handler instead of
// reaching the host. `cookie` marks the handler's reissued calls. A
// nonzero `tracer` is the compiler's process id under `jet debug --build`:
// that process and its helpers may trace this one (PR_SET_PTRACER), as the
// system's ptrace scope otherwise lets only an ancestor; 0 sets nothing.
comptime_serve_filter: fn(frame: I64, handler: I64, length: I64, cookie: I64, tracer: I64) {
    #Unsafe("the filter is installed once, on the image's only thread, before any call it traps") {
        comptime_serve_cookie = cookie
    }
    program: jet_rt_alloc(if (length < I64{8}) -> I64{8} else -> length, I64{8})
    comptime_serve_receive(program, length)
    action: jet_rt_alloc(I64{32}, I64{8})
    // SA_SIGINFO | SA_RESTORER | SA_ONSTACK; a handler that answered an
    // admitted call returns through the runtime's rt_sigreturn rail, and runs
    // on the thread's alternate stack.
    trap_store(action, handler)
    trap_store(wrapping(action + I64{8}), I64{201326596})
    trap_store(wrapping(action + I64{16}), rt_process_signal_restore_address())
    trap_store(wrapping(action + I64{24}), I64{0})
    installed: trap_syscall(I64{13}, I64{31}, action, I64{0}, I64{8}, I64{0}, I64{0})
    private: trap_syscall(I64{157}, I64{38}, I64{1}, I64{0}, I64{0}, I64{0}, I64{0})
    // PR_SET_PTRACER, before the filter that would refuse it.
    traced: if (tracer != I64{0}) -> trap_syscall(I64{157}, I64{1499557217}, tracer, I64{0}, I64{0}, I64{0}, I64{0}) else -> I64{0}
    fprog: jet_rt_alloc(I64{16}, I64{8})
    trap_store(fprog, length /% I64{8})
    trap_store(wrapping(fprog + I64{8}), program)
    // SECCOMP_FILTER_FLAG_TSYNC: the runtime's own threads are refused too.
    filtered: trap_syscall(I64{317}, I64{1}, I64{1}, fprog, I64{0}, I64{0}, I64{0})
    jet_rt_free(fprog, I64{16}, I64{8})
    jet_rt_free(action, I64{32}, I64{8})
    jet_rt_free(program, if (length < I64{8}) -> I64{8} else -> length, I64{8})
    comptime_serve_reply(frame, I64{1}, installed, private, filtered, traced)
}

// Serves commands on `frame` until a RETURN, whose word it returns.
comptime_serve_loop: fn(frame: I64) -> I64 {
    loop {
        comptime_serve_receive(frame, I64{64})
        kind: trap_word(frame)
        a: trap_word(wrapping(frame + I64{8}))
        b: trap_word(wrapping(frame + I64{16}))
        c: trap_word(wrapping(frame + I64{24}))
        d: trap_word(wrapping(frame + I64{32}))
        e: trap_word(wrapping(frame + I64{40}))
        f: trap_word(wrapping(frame + I64{48}))
        if (kind == I64{1}) {
            // The compiler calls an entry of this image's table, or a runtime
            // export it resolved, on the word arguments that entry's System V
            // signature takes, with the call's step limit.
            steps: trap_word(wrapping(frame + I64{56}))
            #Unsafe("the step word is set on the image's only serving thread, before the call that spends it") {
                comptime_serve_steps = steps
            }
            result: coll_call5(a, b, c, d, e, f)
            // The call runs as jet_rt_main's entry (the serve entry's root):
            // a stop it published there rather than served (process.exit,
            // whose status is no stop to serve) ends the child here, as
            // jet_rt_main ends a stopped entry, with its report on standard
            // error and its code as the exit status; the compiler reports
            // that (JetEval Native.jet jet_eval_native_ended). Answering DONE
            // would hand the compiler the unwound call's garbage word.
            main_call_stopped()
            // Output the call buffered is its own effect, made before it answers.
            jet_rt_stdout_flush()
            comptime_serve_reply(frame, I64{1}, result, I64{0}, I64{0}, I64{0})
            next
        }
        if (kind == I64{2}) {
            comptime_serve_send(a, b)
            next
        }
        if (kind == I64{3}) {
            comptime_serve_receive(a, b)
            next
        }
        if (kind == I64{4}) {
            comptime_serve_reply(frame, I64{1}, jet_rt_alloc(a, b), I64{0}, I64{0}, I64{0})
            next
        }
        if (kind == I64{5} || kind == I64{6}) {
            comptime_serve_reply(frame, I64{1}, comptime_serve_value(kind, a), I64{0}, I64{0}, I64{0})
            next
        }
        if (kind == I64{7}) { return a }
        if (kind == I64{9}) {
            comptime_serve_filter(frame, a, b, c, d)
            next
        }
        if (kind == I64{10}) {
            // MAP_PRIVATE | MAP_ANONYMOUS | MAP_FIXED_NOREPLACE, read-write.
            comptime_serve_reply(frame, I64{1}, trap_map(a, b, I64{1048610}), I64{0}, I64{0}, I64{0})
            next
        }
        if (kind == I64{11}) {
            comptime_serve_reply(frame, I64{1}, trap_syscall(I64{10}, a, b, c, I64{0}, I64{0}, I64{0}), I64{0}, I64{0}, I64{0})
            next
        }
        if (kind == I64{12}) {
            #Unsafe("the compiler admits between calls of the one thread it drives; the handler only reads the flag") {
                comptime_serve_admitted = a
            }
            next
        }
        if comptime_serve_shm_cmd(frame, kind, a, b) -> next
        trap_defect_exit(I64{0})
        return I64{0}
    }
}

// The object's entry: `table` holds `count` words, the image's entries in
// the compiler's order (ComptimeWire.jet). Serves until the compiler's EXIT.
#Export(c) jet_rt_comptime_serve: fn(table: I64, count: I64) {
    frame: jet_rt_alloc(I64{64}, I64{8})
    #Unsafe("the serve entry runs once, on the image's only thread, before it serves") {
        comptime_serve_root = frame
        comptime_serve_stop_code = rt_comptime_serve_stop_address()
        comptime_serve_shm = comptime_serve_shm_init()
    }
    comptime_serve_reply(frame, I64{0}, count, if (comptime_serve_shm != I64{0}) -> I64{1} else -> I64{0}, I64{0}, I64{0})
    comptime_serve_send(table, count * I64{8})
    _ := comptime_serve_loop(frame)
    trap_defect_exit(I64{0})
}

comptime_serve_shm := I64{0}

// Maps the shared staging memfd passed on fd 6 and closes fd 6 immediately
// so seccomp and `#Impure` file opens start cleanly from fd 6.
comptime_serve_shm_init: fn() -> I64 {
    mapped: trap_syscall(I64{9}, I64{0}, I64{4194304}, I64{3}, I64{1}, I64{6}, I64{0})
    _ := trap_syscall(I64{3}, I64{6}, I64{0}, I64{0}, I64{0}, I64{0}, I64{0})
    if (mapped > I64{0}) -> mapped else -> I64{0}
}

// Handles SHM_TEXT (13), SHM_WRITE (14), and SHM_LOAD (15) from the shared
// staging window; false for any other frame kind.
comptime_serve_shm_cmd: fn(frame: I64, kind: I64, a: I64, b: I64) -> Bool {
    if (comptime_serve_shm == I64{0}) { return false }
    if (kind == I64{13}) {
        comptime_serve_reply(frame, I64{1}, jet_rt_string_from_static(comptime_serve_shm, a), I64{0}, I64{0}, I64{0})
        return true
    }
    if (kind == I64{14}) {
        if (b > I64{0}) { rt_text_bytes_copy(a, comptime_serve_shm, b) }
        comptime_serve_reply(frame, I64{1}, I64{0}, I64{0}, I64{0}, I64{0})
        return true
    }
    if (kind == I64{15}) {
        comptime_serve_reply(frame, I64{1}, comptime_serve_shm_load(a), I64{0}, I64{0}, I64{0})
        return true
    }
    false
}

// Loads `count` segments described in the shared staging window (six words per
// segment: low, map_size, vaddr, file_size, protection, shm_offset); returns 0
// or the first failing mmap/mprotect result.
comptime_serve_shm_load: fn(count: I64) -> I64 {
    index := I64{0}
    loop index < count {
        row: wrapping(comptime_serve_shm + index * I64{48})
        low: trap_word(row)
        map_size: trap_word(wrapping(row + I64{8}))
        vaddr: trap_word(wrapping(row + I64{16}))
        file_size: trap_word(wrapping(row + I64{24}))
        protection: trap_word(wrapping(row + I64{32}))
        shm_offset: trap_word(wrapping(row + I64{40}))
        mapped: trap_map(low, map_size, I64{1048610})
        if (mapped != low) { return mapped }
        if (file_size > I64{0}) {
            rt_text_bytes_copy(vaddr, wrapping(comptime_serve_shm + shm_offset), file_size)
        }
        protected: trap_syscall(I64{10}, low, map_size, protection, I64{0}, I64{0}, I64{0})
        if (protected != I64{0}) { return protected }
        index += I64{1}
    }
    I64{0}
}

// A host route of compile-time code (JetIR ir_host_route): `count` operand
// words at `operands`, which the compiler reads and answers. The answer is
// the RETURN word; a `result` area receives an aggregate answer in place.
comptime_serve_request: fn(kind: I64, operands: I64, count: I64, result: I64) -> I64 {
    if !comptime_serving() {
        jet_rt_unreachable(I64{0}, I64{0})
        return I64{0}
    }
    frame: jet_rt_alloc(I64{64}, I64{8})
    comptime_serve_reply(frame, I64{2}, kind, operands, count, result)
    word: comptime_serve_loop(frame)
    jet_rt_free(frame, I64{64}, I64{8})
    word
}

#Export(c) jet_comptime_host: fn(kind: I64, operands: I64, count: I64) -> I64 {
    comptime_serve_request(kind, operands, count, I64{0})
}

#Export(c) jet_comptime_host_into: fn(result: I64, kind: I64, operands: I64, count: I64) -> I64 {
    _ := comptime_serve_request(kind, operands, count, result)
    result
}

rt_comptime_serve_stop_address: fn() -> I64 {
    loop { jet_rt_unreachable(I64{0}, I64{0}) }
}

// jet_rt_comptime_serve_stop while the image serves the compiler, else 0:
// every runtime stop asks it first (Trap.jet trap_stop), so only the serve
// entry installs it and a program that never serves links no serve loop.
comptime_serve_stop_code := I64{0}

// A runtime stop of served code (Trap.jet): its kind and words go to the
// compiler, which reads their texts. The child then serves on above the
// stopped call's frames, which never resume, so one child serves a whole
// compile. Buffered output is flushed first, as the stop's own report would.
// A refused effect (COMPTIME_STOP_REFUSED, comptime_serve_refuse) is
// REFUSED instead, and the child exits as the SIGSYS handler's refusal does.
#Export(c) jet_rt_comptime_serve_stop: fn(kind: I64, a: I64, b: I64, c: I64, d: I64) -> I64 {
    if (kind == COMPTIME_STOP_REFUSED) {
        refusal: alloc_map_try(I64{4096})
        if (refusal > I64{0}) { comptime_serve_reply(refusal, I64{4}, a, I64{0}, I64{0}, I64{0}) }
        trap_defect_exit(I64{0})
        return I64{0}
    }
    jet_rt_stdout_flush()
    frame: jet_rt_alloc(I64{64}, I64{8})
    comptime_serve_fill(frame, I64{3}, kind, a, b, c)
    trap_store(wrapping(frame + I64{40}), d)
    comptime_serve_send(frame, I64{64})
    _ := comptime_serve_loop(frame)
    trap_defect_exit(I64{0})
    I64{0}
}

// The SIGSYS handler's body: system call `si_syscall` (siginfo + 24) with
// its arguments in ucontext gregs (rdi + 104, rsi + 112, rdx + 136, r10 +
// 56, r8 + 40) trapped. Inside an admitted `#Impure` block the handler
// reissues it with the cookie; a file call the filter allows answers in rax
// (+ 144) and the code resumes after its `syscall`. Any other call is
// refused: allocation may be mid-flight, so the frame is a fresh mapping
// made untracked (trap_map's sentry account allocates); no checked code
// reaches it before the process exits.
#Export(c) jet_rt_comptime_refused: fn(info: I64, context: I64) {
    number: trap_word(wrapping(info + I64{24})) & I64{4294967295}
    first: trap_word(wrapping(context + I64{104}))
    if (comptime_serve_admitted != I64{0}) {
        result: trap_syscall(number, first, trap_word(wrapping(context + I64{112})), trap_word(wrapping(context + I64{136})), trap_word(wrapping(context + I64{56})), trap_word(wrapping(context + I64{40})), comptime_serve_cookie)
        if (result != I64{-4095}) {
            trap_store(wrapping(context + I64{144}), result)
            return
        }
    }
    frame: alloc_map_try(I64{4096})
    if (frame > I64{0}) { comptime_serve_reply(frame, I64{4}, number, first, I64{0}, I64{0}) }
    trap_defect_exit(I64{0})
}

// Effects of served code the filter can't refuse by name: the environment,
// which no system call reads (the child starts with none, so a read would
// answer None where the program sees the host's value), and a process
// launch, whose first trapped call is a pipe. JetBackend ComptimeWire.jet
// names the same numbers.
COMPTIME_REFUSED_ENVIRONMENT: I64{-1}

COMPTIME_REFUSED_PROCESS: I64{-2}

// While the image serves the compiler, refuses the effect `refused` names as
// the SIGSYS handler refuses a call: the stop door (Trap.jet trap_stop) hands
// it to jet_rt_comptime_serve_stop, which sends REFUSED and ends the child.
// Otherwise returns.
comptime_serve_refuse: fn(refused: I64) {
    if !comptime_serving() {
        return
    }
    trap_stop(COMPTIME_STOP_REFUSED, refused, I64{0}, I64{0}, I64{0})
}

// The stop kind a refused effect reaches the stop door with. It never leaves
// the child: the compiler's stop kinds (JetBackend Image/ComptimeWire.jet)
// are 1 through 5 and COMPTIME_STOP_STEPS.
COMPTIME_STOP_REFUSED: I64{6}

// The stop kind of a call that spent its step limit (JetBackend
// ComptimeWire.jet X64_COMPTIME_STOP_STEPS); the compiler reports it as the
// limit's error.
COMPTIME_STOP_STEPS: I64{7}

// While the image serves the compiler, stops the running call, which spent
// its steps (comptime_serve_steps), as a STOP of COMPTIME_STOP_STEPS; the
// child serves on. Otherwise returns.
comptime_serve_out_of_steps: fn() {
    if !comptime_serving() {
        return
    }
    trap_stop(COMPTIME_STOP_STEPS, I64{0}, I64{0}, I64{0}, I64{0})
}
