// The trigonometric functions and their inverses, with the argument
// reduction, ported from musl 1.2.5 src/math (FreeBSD msun lineage); see
// Libm.jet for the porting conventions.

// __rem_pio2.c: x - n*pi/2 = y0 + y1, |y0 + y1| <~ pi/4.
LibmReduced: struct { n: I64, y0: Float, y1: Float }

// 1.5/DBL_EPSILON: adding then subtracting it rounds to an integer, and the
// sum's low significand bits are that integer.
LIBM_TOINT_HALF: Float{6755399441055744.0}
LIBM_PIO4: Float{0.7853981633974483}
LIBM_INVPIO2: Float{0.6366197723675814}
LIBM_PIO2_1: Float{1.5707963267341256}
LIBM_PIO2_1T: Float{6.077100506506192e-11}
LIBM_PIO2_2: Float{6.077100506303966e-11}
LIBM_PIO2_2T: Float{2.0222662487959506e-21}
LIBM_PIO2_3: Float{2.0222662487111665e-21}
LIBM_PIO2_3T: Float{8.4784276603689e-32}
LIBM_P24: Float{16777216.0}
LIBM_PM24: Float{5.960464477539063e-8}

// __rem_pio2.c for |x| ~<= 9pi/4 away from a multiple of pi/2: k*pi/2 is
// removed in two parts.
libm_rem_pio2_near: fn(x: Float, negative: Bool, k: I64) -> LibmReduced {
    multiple: Float{k}
    if negative {
        z: x + multiple * LIBM_PIO2_1
        y0: z + multiple * LIBM_PIO2_1T
        return LibmReduced{n: I64{0} - k, y0: y0, y1: (z - y0) + multiple * LIBM_PIO2_1T}
    }
    z: x - multiple * LIBM_PIO2_1
    y0: z - multiple * LIBM_PIO2_1T
    LibmReduced{n: k, y0: y0, y1: (z - y0) - multiple * LIBM_PIO2_1T}
}

// __rem_pio2.c: the caller handles |x| ~<= pi/4, which needs no reduction.
libm_rem_pio2: fn(x: Float) -> LibmReduced {
    bits: rt_f64_bits(x)
    negative: bits < I64{0}
    ix: (bits >> I64{32}).bit_and(I64{2147483647})
    if (ix <= I64{0x400f6a7a}) {
        // |x| ~<= 5pi/4; |x| ~= pi/2 or 2pi/2 cancels, so takes the medium case
        if (ix.bit_and(I64{0xfffff}) != I64{0x921fb}) {
            // |x| ~<= 3pi/4
            if (ix <= I64{0x4002d97c}) -> return libm_rem_pio2_near(x, negative, I64{1})
            return libm_rem_pio2_near(x, negative, I64{2})
        }
    } else if (ix <= I64{0x401c463b}) {
        // |x| ~<= 9pi/4; |x| ~= 3pi/2 or 4pi/2 takes the medium case
        if (ix <= I64{0x4015fdbc}) {
            if (ix != I64{0x4012d97c}) -> return libm_rem_pio2_near(x, negative, I64{3})
        } else if (ix != I64{0x401921fb}) {
            return libm_rem_pio2_near(x, negative, I64{4})
        }
    } else if (ix >= I64{0x413921fb}) {
        return libm_rem_pio2_big(x, bits, ix)
    }
    // |x| ~< 2^20*(pi/2), medium size: rint(x/(pi/2))
    shifted: x * LIBM_INVPIO2 + LIBM_TOINT_HALF
    whole := shifted - LIBM_TOINT_HALF
    n := rt_f64_bits(shifted) - rt_f64_bits(LIBM_TOINT_HALF)
    r := x - whole * LIBM_PIO2_1
    // 1st round, good to 85 bits
    w := whole * LIBM_PIO2_1T
    // Matters with directed rounding.
    if (r - w < Float{0.0} - LIBM_PIO4) {
        n -= I64{1}
        whole = whole - Float{1.0}
        r = x - whole * LIBM_PIO2_1
        w = whole * LIBM_PIO2_1T
    } else if (r - w > LIBM_PIO4) {
        n += I64{1}
        whole = whole + Float{1.0}
        r = x - whole * LIBM_PIO2_1
        w = whole * LIBM_PIO2_1T
    }
    y0 := r - w
    ex: ix >> I64{20}
    if (ex - libm_exponent(rt_f64_bits(y0)) > I64{16}) {
        // 2nd round, good to 118 bits
        t := r
        w = whole * LIBM_PIO2_2
        r = t - w
        w = whole * LIBM_PIO2_2T - ((t - r) - w)
        y0 = r - w
        if (ex - libm_exponent(rt_f64_bits(y0)) > I64{49}) {
            // 3rd round, good to 151 bits, covers all cases
            t = r
            w = whole * LIBM_PIO2_3
            r = t - w
            w = whole * LIBM_PIO2_3T - ((t - r) - w)
            y0 = r - w
        }
    }
    LibmReduced{n: n, y0: y0, y1: (r - y0) - w}
}

// __rem_pio2.c for large arguments, infinities and NaNs.
libm_rem_pio2_big: fn(x: Float, bits: I64, ix: I64) -> LibmReduced {
    if (ix >= I64{0x7ff00000}) {
        // x is inf or NaN
        nan: x - x
        return LibmReduced{n: I64{0}, y0: nan, y1: nan}
    }
    // set z = scalbn(|x|,-ilogb(x)+23)
    z := rt_f64_from_bits(bits.bit_and(LIBM_MANTISSA).bit_or(I64{1046} << I64{52}))
    t0: libm_trunc(z)
    z = (z - t0) * LIBM_P24
    t1: libm_trunc(z)
    z = (z - t1) * LIBM_P24
    t2: z
    // skip zero terms, first term is non-zero
    terms := I64{3}
    if (t2 == Float{0.0}) {
        terms = I64{2}
        if (t1 == Float{0.0}) -> terms = I64{1}
    }
    reduced: libm_rem_pio2_large(t0, t1, t2, (ix >> I64{20}) - I64{1046}, terms)
    if (bits < I64{0}) -> return LibmReduced{n: I64{0} - reduced.n, y0: -reduced.y0, y1: -reduced.y1}
    reduced
}

// __rem_pio2_large.c ipio2: 2/pi in 24-bit integers; a double argument
// reads at most these 66.
LIBM_IPIO2: comptime { [I64]{
    I64{0xA2F983}, I64{0x6E4E44}, I64{0x1529FC}, I64{0x2757D1}, I64{0xF534DD}, I64{0xC0DB62},
    I64{0x95993C}, I64{0x439041}, I64{0xFE5163}, I64{0xABDEBB}, I64{0xC561B7}, I64{0x246E3A},
    I64{0x424DD2}, I64{0xE00649}, I64{0x2EEA09}, I64{0xD1921C}, I64{0xFE1DEB}, I64{0x1CB129},
    I64{0xA73EE8}, I64{0x8235F5}, I64{0x2EBB44}, I64{0x84E99C}, I64{0x7026B4}, I64{0x5F7E41},
    I64{0x3991D6}, I64{0x398353}, I64{0x39F49C}, I64{0x845F8B}, I64{0xBDF928}, I64{0x3B1FF8},
    I64{0x97FFDE}, I64{0x05980F}, I64{0xEF2F11}, I64{0x8B5A0A}, I64{0x6D1F6D}, I64{0x367ECF},
    I64{0x27CB09}, I64{0xB74F46}, I64{0x3F669E}, I64{0x5FEA2D}, I64{0x7527BA}, I64{0xC7EBE5},
    I64{0xF17B3D}, I64{0x0739F7}, I64{0x8A5292}, I64{0xEA6BFB}, I64{0x5FB11F}, I64{0x8D5D08},
    I64{0x560330}, I64{0x46FC7B}, I64{0x6BABF0}, I64{0xCFBC20}, I64{0x9AF436}, I64{0x1DA9E3},
    I64{0x91615E}, I64{0xE61B08}, I64{0x659985}, I64{0x5F14A0}, I64{0x68408D}, I64{0xFFD880},
    I64{0x4D7327}, I64{0x310606}, I64{0x1556CA}, I64{0x73A8C9}, I64{0x60E27B}, I64{0xC08C6B},
} }

// __rem_pio2_large.c PIo2: pi/2 in 24-bit pieces; double precision reads
// the first jp+1 = 5.
libm_pio2_piece: fn(k: I64) -> Float {
    if {
        (k == I64{0}) -> Float{1.570796251296997}
        (k == I64{1}) -> Float{7.549789415861596e-8}
        (k == I64{2}) -> Float{5.390302529957765e-15}
        (k == I64{3}) -> Float{3.282003415807913e-22}
        else -> Float{1.270655753080676e-29}
    }
}

// __rem_pio2_large.c iq[20]: the 24-bit chunks of the reduced value.
LibmDigits: struct {
    d0: I64, d1: I64, d2: I64, d3: I64, d4: I64, d5: I64, d6: I64, d7: I64, d8: I64, d9: I64,
    d10: I64, d11: I64, d12: I64, d13: I64, d14: I64, d15: I64, d16: I64, d17: I64, d18: I64, d19: I64,
}

libm_digit: fn(digits: LibmDigits, at: I64) -> I64 {
    if {
        (at == I64{0}) -> digits.d0
        (at == I64{1}) -> digits.d1
        (at == I64{2}) -> digits.d2
        (at == I64{3}) -> digits.d3
        (at == I64{4}) -> digits.d4
        (at == I64{5}) -> digits.d5
        (at == I64{6}) -> digits.d6
        (at == I64{7}) -> digits.d7
        (at == I64{8}) -> digits.d8
        (at == I64{9}) -> digits.d9
        (at == I64{10}) -> digits.d10
        (at == I64{11}) -> digits.d11
        (at == I64{12}) -> digits.d12
        (at == I64{13}) -> digits.d13
        (at == I64{14}) -> digits.d14
        (at == I64{15}) -> digits.d15
        (at == I64{16}) -> digits.d16
        (at == I64{17}) -> digits.d17
        (at == I64{18}) -> digits.d18
        else -> digits.d19
    }
}

libm_digit_set: fn(digits: LibmDigits, at: I64, value: I64) -> LibmDigits {
    out := digits
    if {
        (at == I64{0}) -> out.d0 = value
        (at == I64{1}) -> out.d1 = value
        (at == I64{2}) -> out.d2 = value
        (at == I64{3}) -> out.d3 = value
        (at == I64{4}) -> out.d4 = value
        (at == I64{5}) -> out.d5 = value
        (at == I64{6}) -> out.d6 = value
        (at == I64{7}) -> out.d7 = value
        (at == I64{8}) -> out.d8 = value
        (at == I64{9}) -> out.d9 = value
        (at == I64{10}) -> out.d10 = value
        (at == I64{11}) -> out.d11 = value
        (at == I64{12}) -> out.d12 = value
        (at == I64{13}) -> out.d13 = value
        (at == I64{14}) -> out.d14 = value
        (at == I64{15}) -> out.d15 = value
        (at == I64{16}) -> out.d16 = value
        (at == I64{17}) -> out.d17 = value
        (at == I64{18}) -> out.d18 = value
        else -> out.d19 = value
    }
    out
}

// (int32_t)x of an integral double well inside the int32 range.
libm_whole: fn(x: Float) -> I64 { runtime_duration_float_word(x) }

// __rem_pio2_large.c q[i] = sum x[j]*f[jx+i-j], where f[k] = ipio2[jv-jx+k]
// (0.0 below index 0). The setup and the recomputation both fill f by that
// rule, so each q[i] is computed where it is read.
libm_pio2_product: fn(t0: Float, t1: Float, t2: Float, jx: I64, jv: I64, i: I64) -> Float {
    table: LIBM_IPIO2
    sum := Float{0.0}
    j := I64{0}
    loop j <= jx {
        term: if (j == I64{0}) -> t0 else -> if (j == I64{1}) -> t1 else -> t2
        index: jv + i - j
        f: if (index < I64{0}) -> Float{0.0} else -> Float{table[Int.from_i64(index)]}
        sum = sum + term * f
        j += I64{1}
    }
    sum
}

// __rem_pio2_large.c fq[m] = sum PIo2[k]*q[jz-m+k] over k <= jp, after the
// chunks became q[i] = 2^(q0-24*(jz-i)) * iq[i] (exact products).
libm_pio2_tail: fn(digits: LibmDigits, jz: I64, q0: I64, m: I64) -> Float {
    i: jz - m
    sum := Float{0.0}
    k := I64{0}
    loop k <= (I64{4}) && k <= m {
        chunk: libm_scalbn(Float{1.0}, q0 - I64{24} * (jz - i - k)) * Float{libm_digit(digits, i + k)}
        sum = sum + libm_pio2_piece(k) * chunk
        k += I64{1}
    }
    sum
}

// __rem_pio2_large.c with prec 1 (53-bit double): x is t0..t2 (nx terms),
// e0 the exponent of t0; returns n mod 8 and the two-double remainder.
libm_rem_pio2_large: fn(t0: Float, t1: Float, t2: Float, e0: I64, nx: I64) -> LibmReduced {
    // initialize jk; jp = jk
    jk: I64{4}
    // determine jx,jv,q0, note that 3>q0
    jx: nx - I64{1}
    jv := (e0 - I64{3}) / I64{24}
    if (jv < I64{0}) -> jv = I64{0}
    q0 := e0 - I64{24} * (jv + I64{1})
    jz := jk
    digits := LibmDigits{d0: I64{0}, d1: I64{0}, d2: I64{0}, d3: I64{0}, d4: I64{0}, d5: I64{0}, d6: I64{0}, d7: I64{0}, d8: I64{0}, d9: I64{0}, d10: I64{0}, d11: I64{0}, d12: I64{0}, d13: I64{0}, d14: I64{0}, d15: I64{0}, d16: I64{0}, d17: I64{0}, d18: I64{0}, d19: I64{0}}
    z := Float{0.0}
    n := I64{0}
    ih := I64{0}
    loop {
        // recompute: distill q[] into iq[] reversingly
        i := I64{0}
        j := jz
        z = libm_pio2_product(t0, t1, t2, jx, jv, jz)
        loop j > (I64{0}) {
            fw: libm_trunc(LIBM_PM24 * z)
            digits = libm_digit_set(digits, i, libm_whole(z - LIBM_P24 * fw))
            z = libm_pio2_product(t0, t1, t2, jx, jv, j - I64{1}) + fw
            i += I64{1}
            j -= I64{1}
        }
        // compute n
        // actual value of z
        z = libm_scalbn(z, q0)
        // trim off integer >= 8
        z = z - Float{8.0} * libm_floor(z * Float{0.125})
        n = libm_whole(libm_trunc(z))
        z = z - Float{n}
        ih = I64{0}
        if (q0 > I64{0}) {
            // need iq[jz-1] to determine n
            top: libm_digit(digits, jz - I64{1})
            high: top >> (I64{24} - q0)
            n += high
            rest: top - (high << (I64{24} - q0))
            digits = libm_digit_set(digits, jz - I64{1}, rest)
            ih = rest >> (I64{23} - q0)
        } else if (q0 == I64{0}) {
            ih = libm_digit(digits, jz - I64{1}) >> I64{23}
        } else if (z >= Float{0.5}) {
            ih = I64{2}
        }
        if (ih > I64{0}) {
            // q > 0.5
            n += I64{1}
            carry := false
            i = I64{0}
            loop i < jz {
                // compute 1-q
                digit: libm_digit(digits, i)
                if carry {
                    digits = libm_digit_set(digits, i, I64{0xffffff} - digit)
                } else if (digit != I64{0}) {
                    carry = true
                    digits = libm_digit_set(digits, i, I64{0x1000000} - digit)
                }
                i += I64{1}
            }
            // rare case: chance is 1 in 12
            if (q0 == I64{1}) -> digits = libm_digit_set(digits, jz - I64{1}, libm_digit(digits, jz - I64{1}).bit_and(I64{0x7fffff}))
            if (q0 == I64{2}) -> digits = libm_digit_set(digits, jz - I64{1}, libm_digit(digits, jz - I64{1}).bit_and(I64{0x3fffff}))
            if (ih == I64{2}) {
                z = Float{1.0} - z
                if carry -> z = z - libm_scalbn(Float{1.0}, q0)
            }
        }
        // check if recomputation is needed
        if (z != Float{0.0}) -> break
        any := I64{0}
        i = jz - I64{1}
        loop i >= jk {
            any = any.bit_or(libm_digit(digits, i))
            i -= I64{1}
        }
        if (any != I64{0}) -> break
        // need recomputation: k = no. of terms needed
        k := I64{1}
        loop libm_digit(digits, jk - k) == (I64{0}) -> k += I64{1}
        jz += k
    }
    // chop off zero terms
    if (z == Float{0.0}) {
        jz -= I64{1}
        q0 -= I64{24}
        loop libm_digit(digits, jz) == (I64{0}) {
            jz -= I64{1}
            q0 -= I64{24}
        }
    } else {
        // break z into 24-bit if necessary
        z = libm_scalbn(z, I64{0} - q0)
        if (z >= LIBM_P24) {
            fw: libm_trunc(LIBM_PM24 * z)
            digits = libm_digit_set(digits, jz, libm_whole(z - LIBM_P24 * fw))
            jz += I64{1}
            q0 += I64{24}
            digits = libm_digit_set(digits, jz, libm_whole(fw))
        } else {
            digits = libm_digit_set(digits, jz, libm_whole(z))
        }
    }
    // compress fq[] into y[]
    fw := Float{0.0}
    m := jz
    loop m >= (I64{0}) {
        fw = fw + libm_pio2_tail(digits, jz, q0, m)
        m -= I64{1}
    }
    y0: if (ih == I64{0}) -> fw else -> -fw
    fw = libm_pio2_tail(digits, jz, q0, I64{0}) - fw
    m = I64{1}
    loop m <= jz {
        fw = fw + libm_pio2_tail(digits, jz, q0, m)
        m += I64{1}
    }
    y1: if (ih == I64{0}) -> fw else -> -fw
    LibmReduced{n: n.bit_and(I64{7}), y0: y0, y1: y1}
}

// __sin.c: sin on ~[-pi/4, pi/4]; y is the tail of x, tail says it is nonzero.
libm_kernel_sin: fn(x: Float, y: Float, tail: Bool) -> Float {
    z: x * x
    w: z * z
    r: Float{0.00833333333332249} + z * (Float{-0.0001984126982985795} + z * Float{0.0000027557313707070068}) + z * w * (Float{-2.5050760253406863e-8} + z * Float{1.58969099521155e-10})
    v: z * x
    if !tail -> return x + v * (Float{-0.16666666666666632} + z * r)
    x - ((z * (Float{0.5} * y - v * r) - y) - v * Float{-0.16666666666666632})
}

// __cos.c: cos on [-pi/4, pi/4]; y is the tail of x.
libm_kernel_cos: fn(x: Float, y: Float) -> Float {
    z: x * x
    w: z * z
    r: z * (Float{0.0416666666666666} + z * (Float{-0.001388888888887411} + z * Float{0.00002480158728947673})) + w * w * (Float{-2.7557314351390663e-7} + z * (Float{2.087572321298175e-9} + z * Float{-1.1359647557788195e-11}))
    hz: Float{0.5} * z
    one_minus: Float{1.0} - hz
    one_minus + (((Float{1.0} - one_minus) - hz) + (z * r - x * y))
}

// __tan.c: tan (odd false) or -1/tan (odd true) on ~[-pi/4, pi/4]; y is the
// tail of x.
libm_kernel_tan: fn(x0: Float, y0: Float, odd: Bool) -> Float {
    hx: (rt_f64_bits(x0) >> I64{32}).bit_and(I64{4294967295})
    // |x| >= 0.6744
    big: hx.bit_and(I64{2147483647}) >= I64{0x3FE59428}
    negative: hx >= I64{2147483648}
    x := x0
    y := y0
    if big {
        if negative {
            x = -x
            y = -y
        }
        x = (LIBM_PIO4 - x) + (Float{3.061616997868383e-17} - y)
        y = Float{0.0}
    }
    z: x * x
    w: z * z
    // Break x^5*(T[1]+x^2*T[2]+...) into
    // x^5(T[1]+x^4*T[3]+...+x^20*T[11]) +
    // x^5(x^2*(T[2]+x^4*T[4]+...+x^22*[T12]))
    r := Float{0.13333333333320124} + w * (Float{0.021869488294859542} + w * (Float{0.0035920791075913124} + w * (Float{0.0005880412408202641} + w * (Float{0.00007817944429395571} + w * Float{-0.000018558637485527546}))))
    v := z * (Float{0.05396825397622605} + w * (Float{0.0088632398235993} + w * (Float{0.0014562094543252903} + w * (Float{0.0002464631348184699} + w * (Float{0.00007140724913826082} + w * Float{0.00002590730518636337})))))
    s := z * x
    r = y + z * (s * (r + v) + y) + s * Float{0.3333333333333341}
    sum: x + r
    if big {
        s = if odd -> Float{-1.0} else -> Float{1.0}
        v = s - Float{2.0} * (x + (r - sum * sum / (sum + s)))
        return if negative -> -v else -> v
    }
    if !odd -> return sum
    // -1.0/(x+r) has up to 2ulp error, so compute it accurately
    w0: rt_f64_from_bits(rt_f64_bits(sum).bit_and(I64{-4294967296}))
    // w0+v = r+x
    v = r - (w0 - x)
    a: Float{-1.0} / sum
    a0: rt_f64_from_bits(rt_f64_bits(a).bit_and(I64{-4294967296}))
    a0 + a * (Float{1.0} + a0 * w0 + a0 * v)
}

// sin.c
libm_sin: fn(x: Float) -> Float {
    ix: (rt_f64_bits(x) >> I64{32}).bit_and(I64{2147483647})
    // |x| ~< pi/4
    if (ix <= I64{0x3fe921fb}) {
        // |x| < 2**-26
        if (ix < I64{0x3e500000}) -> return x
        return libm_kernel_sin(x, Float{0.0}, false)
    }
    // sin(Inf or NaN) is NaN
    if (ix >= I64{0x7ff00000}) -> return x - x
    // argument reduction needed
    reduced: libm_rem_pio2(x)
    quadrant: reduced.n.bit_and(I64{3})
    if {
        (quadrant == I64{0}) -> libm_kernel_sin(reduced.y0, reduced.y1, true)
        (quadrant == I64{1}) -> libm_kernel_cos(reduced.y0, reduced.y1)
        (quadrant == I64{2}) -> -libm_kernel_sin(reduced.y0, reduced.y1, true)
        else -> -libm_kernel_cos(reduced.y0, reduced.y1)
    }
}

// cos.c
libm_cos: fn(x: Float) -> Float {
    ix: (rt_f64_bits(x) >> I64{32}).bit_and(I64{2147483647})
    // |x| ~< pi/4
    if (ix <= I64{0x3fe921fb}) {
        // |x| < 2**-27 * sqrt(2)
        if (ix < I64{0x3e46a09e}) -> return Float{1.0}
        return libm_kernel_cos(x, Float{0.0})
    }
    // cos(Inf or NaN) is NaN
    if (ix >= I64{0x7ff00000}) -> return x - x
    // argument reduction
    reduced: libm_rem_pio2(x)
    quadrant: reduced.n.bit_and(I64{3})
    if {
        (quadrant == I64{0}) -> libm_kernel_cos(reduced.y0, reduced.y1)
        (quadrant == I64{1}) -> -libm_kernel_sin(reduced.y0, reduced.y1, true)
        (quadrant == I64{2}) -> -libm_kernel_cos(reduced.y0, reduced.y1)
        else -> libm_kernel_sin(reduced.y0, reduced.y1, true)
    }
}

// tan.c
libm_tan: fn(x: Float) -> Float {
    ix: (rt_f64_bits(x) >> I64{32}).bit_and(I64{2147483647})
    // |x| ~< pi/4
    if (ix <= I64{0x3fe921fb}) {
        // |x| < 2**-27
        if (ix < I64{0x3e400000}) -> return x
        return libm_kernel_tan(x, Float{0.0}, false)
    }
    // tan(Inf or NaN) is NaN
    if (ix >= I64{0x7ff00000}) -> return x - x
    // argument reduction
    reduced: libm_rem_pio2(x)
    libm_kernel_tan(reduced.y0, reduced.y1, reduced.n.bit_and(I64{1}) != I64{0})
}

// fabs.c
libm_fabs: fn(x: Float) -> Float { rt_f64_from_bits(rt_f64_bits(x).bit_and(LIBM_ABS)) }

// 0x1p-120f, the tiny addend musl uses to raise inexact.
LIBM_PM120: Float{7.52316384526264e-37}
LIBM_PIO2_HI: Float{1.5707963267948966}
LIBM_PIO2_LO: Float{6.123233995736766e-17}

// asin.c and acos.c R(): the rational approximation of (asin(x)-x)/x^3.
libm_asin_ratio: fn(z: Float) -> Float {
    p: z * (Float{0.16666666666666666} + z * (Float{-0.3255658186224009} + z * (Float{0.20121253213486293} + z * (Float{-0.04005553450067941} + z * (Float{0.0007915349942898145} + z * Float{0.00003479331075960212})))))
    q: Float{1.0} + z * (Float{-2.403394911734414} + z * (Float{2.0209457602335057} + z * (Float{-0.6882839716054533} + z * Float{0.07703815055590194})))
    p / q
}

// asin.c
libm_asin: fn(x: Float) -> Float {
    bits: rt_f64_bits(x)
    ix: (bits >> I64{32}).bit_and(I64{2147483647})
    // |x| >= 1 or nan
    if (ix >= I64{0x3ff00000}) {
        // asin(1) = +-pi/2 with inexact
        if (ix == I64{0x3ff00000} && bits.bit_and(I64{4294967295}) == I64{0}) -> return x * LIBM_PIO2_HI + LIBM_PM120
        return Float{0.0} / (x - x)
    }
    // |x| < 0.5
    if (ix < I64{0x3fe00000}) {
        // if 0x1p-1022 <= |x| < 0x1p-26, avoid raising underflow
        if (ix < I64{0x3e500000} && ix >= I64{0x00100000}) -> return x
        return x + x * libm_asin_ratio(x * x)
    }
    // 1 > |x| >= 0.5
    z: (Float{1.0} - libm_fabs(x)) * Float{0.5}
    s: libm_sqrt(z)
    r: libm_asin_ratio(z)
    y := Float{0.0}
    if (ix >= I64{0x3fef3333}) {
        // if |x| > 0.975
        y = LIBM_PIO2_HI - (Float{2.0} * (s + s * r) - LIBM_PIO2_LO)
    } else {
        // f+c = sqrt(z)
        f: rt_f64_from_bits(rt_f64_bits(s).bit_and(I64{-4294967296}))
        c: (z - f * f) / (s + f)
        y = Float{0.5} * LIBM_PIO2_HI - (Float{2.0} * s * r - (LIBM_PIO2_LO - Float{2.0} * c) - (Float{0.5} * LIBM_PIO2_HI - Float{2.0} * f))
    }
    if (bits < I64{0}) -> return -y
    y
}

// acos.c
libm_acos: fn(x: Float) -> Float {
    bits: rt_f64_bits(x)
    ix: (bits >> I64{32}).bit_and(I64{2147483647})
    // |x| >= 1 or nan
    if (ix >= I64{0x3ff00000}) {
        if (ix == I64{0x3ff00000} && bits.bit_and(I64{4294967295}) == I64{0}) {
            // acos(1)=0, acos(-1)=pi
            if (bits < I64{0}) -> return Float{2.0} * LIBM_PIO2_HI + LIBM_PM120
            return Float{0.0}
        }
        return Float{0.0} / (x - x)
    }
    // |x| < 0.5
    if (ix < I64{0x3fe00000}) {
        // |x| < 2**-57
        if (ix <= I64{0x3c600000}) -> return LIBM_PIO2_HI + LIBM_PM120
        return LIBM_PIO2_HI - (x - (LIBM_PIO2_LO - x * libm_asin_ratio(x * x)))
    }
    // x < -0.5
    if (bits < I64{0}) {
        z: (Float{1.0} + x) * Float{0.5}
        s: libm_sqrt(z)
        w: libm_asin_ratio(z) * s - LIBM_PIO2_LO
        return Float{2.0} * (LIBM_PIO2_HI - (s + w))
    }
    // x > 0.5
    z: (Float{1.0} - x) * Float{0.5}
    s: libm_sqrt(z)
    df: rt_f64_from_bits(rt_f64_bits(s).bit_and(I64{-4294967296}))
    c: (z - df * df) / (s + df)
    w: libm_asin_ratio(z) * s + c
    Float{2.0} * (df + w)
}

// atan.c atanhi[id] and atanlo[id]: atan(0.5), atan(1.0), atan(1.5),
// atan(inf) as two doubles.
libm_atan_high: fn(id: I64) -> Float {
    if {
        (id == I64{0}) -> Float{0.4636476090008061}
        (id == I64{1}) -> Float{0.7853981633974483}
        (id == I64{2}) -> Float{0.982793723247329}
        else -> Float{1.5707963267948966}
    }
}

libm_atan_low: fn(id: I64) -> Float {
    if {
        (id == I64{0}) -> Float{2.2698777452961687e-17}
        (id == I64{1}) -> Float{3.061616997868383e-17}
        (id == I64{2}) -> Float{1.3903311031230998e-17}
        else -> Float{6.123233995736766e-17}
    }
}

// atan.c
libm_atan: fn(x0: Float) -> Float {
    bits: rt_f64_bits(x0)
    negative: bits < I64{0}
    ix: (bits >> I64{32}).bit_and(I64{2147483647})
    if (ix >= I64{0x44100000}) {
        // if |x| >= 2^66
        if (x0 != x0) -> return x0
        z: libm_atan_high(I64{3}) + LIBM_PM120
        return if negative -> -z else -> z
    }
    x := x0
    id := I64{-1}
    if (ix < I64{0x3fdc0000}) {
        // |x| < 0.4375; |x| < 2^-27 returns x
        if (ix < I64{0x3e400000}) -> return x0
    } else {
        x = libm_fabs(x0)
        if (ix < I64{0x3ff30000}) {
            // |x| < 1.1875
            if (ix < I64{0x3fe60000}) {
                // 7/16 <= |x| < 11/16
                id = I64{0}
                x = (Float{2.0} * x - Float{1.0}) / (Float{2.0} + x)
            } else {
                // 11/16 <= |x| < 19/16
                id = I64{1}
                x = (x - Float{1.0}) / (x + Float{1.0})
            }
        } else if (ix < I64{0x40038000}) {
            // |x| < 2.4375
            id = I64{2}
            x = (x - Float{1.5}) / (Float{1.0} + Float{1.5} * x)
        } else {
            // 2.4375 <= |x| < 2^66
            id = I64{3}
            x = Float{-1.0} / x
        }
    }
    // end of argument reduction
    z: x * x
    w: z * z
    // break sum from i=0 to 10 aT[i]z**(i+1) into odd and even poly
    s1: z * (Float{0.3333333333333293} + w * (Float{0.14285714272503466} + w * (Float{0.09090887133436507} + w * (Float{0.06661073137387531} + w * (Float{0.049768779946159324} + w * Float{0.016285820115365782})))))
    s2: w * (Float{-0.19999999999876483} + w * (Float{-0.11111110405462356} + w * (Float{-0.0769187620504483} + w * (Float{-0.058335701337905735} + w * Float{-0.036531572744216916}))))
    if (id < I64{0}) -> return x - x * (s1 + s2)
    result: libm_atan_high(id) - (x * (s1 + s2) - libm_atan_low(id) - x)
    if negative -> -result else -> result
}

LIBM_PI: Float{3.141592653589793}
LIBM_PI_LO: Float{1.2246467991473532e-16}

// atan2.c
libm_atan2: fn(y: Float, x: Float) -> Float {
    // musl's x + y; its x86_64 build adds y + x, and addsd keeps the first
    // operand's NaN, so a NaN y is the one returned.
    if (x != x || y != y) -> return y + x
    xbits: rt_f64_bits(x)
    ybits: rt_f64_bits(y)
    // x = 1.0
    if (xbits == I64{0x3ff0000000000000}) -> return libm_atan(y)
    // 2*sign(x)+sign(y)
    m: (if (ybits < I64{0}) -> I64{1} else -> I64{0}) + (if (xbits < I64{0}) -> I64{2} else -> I64{0})
    ix: (xbits >> I64{32}).bit_and(I64{2147483647})
    iy: (ybits >> I64{32}).bit_and(I64{2147483647})
    // when y = 0
    if (ybits.bit_and(LIBM_ABS) == I64{0}) {
        return if {
            (m <= I64{1}) -> y
            (m == I64{2}) -> LIBM_PI
            else -> -LIBM_PI
        }
    }
    // when x = 0
    if (xbits.bit_and(LIBM_ABS) == I64{0}) -> return if (m.bit_and(I64{1}) != I64{0}) -> -LIBM_PI / Float{2.0} else -> LIBM_PI / Float{2.0}
    // when x is INF
    if (ix == I64{0x7ff00000}) {
        if (iy == I64{0x7ff00000}) {
            return if {
                (m == I64{0}) -> LIBM_PI / Float{4.0}
                (m == I64{1}) -> -LIBM_PI / Float{4.0}
                (m == I64{2}) -> Float{3.0} * LIBM_PI / Float{4.0}
                else -> Float{-3.0} * LIBM_PI / Float{4.0}
            }
        }
        return if {
            (m == I64{0}) -> Float{0.0}
            (m == I64{1}) -> Float{-0.0}
            (m == I64{2}) -> LIBM_PI
            else -> -LIBM_PI
        }
    }
    // |y/x| > 0x1p64
    if (ix + (I64{64} << I64{20}) < iy || iy == I64{0x7ff00000}) -> return if (m.bit_and(I64{1}) != I64{0}) -> -LIBM_PI / Float{2.0} else -> LIBM_PI / Float{2.0}
    // z = atan(|y/x|) without spurious underflow; |y/x| < 0x1p-64, x<0
    z: if (m.bit_and(I64{2}) != I64{0} && iy + (I64{64} << I64{20}) < ix) -> Float{0.0} else -> libm_atan(libm_fabs(y / x))
    if {
        // atan(+,+)
        (m == I64{0}) -> z
        // atan(-,+)
        (m == I64{1}) -> -z
        // atan(+,-)
        (m == I64{2}) -> LIBM_PI - (z - LIBM_PI_LO)
        // atan(-,-)
        else -> (z - LIBM_PI_LO) - LIBM_PI
    }
}
