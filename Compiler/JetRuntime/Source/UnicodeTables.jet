unicode_is_white_space: fn(cp: I64) -> Bool Never! {
    if (cp < I64{128}) { return unicode_table_dense(rt_static_text("#########$$$$$##################$###############################################################################################"), cp, I64{1}) != I64{0} }
    unicode_table_find(rt_static_text(",###0###C###C###(%##(%##C%##C%###=$##=$###%#-#%#K#%#L#%#R#%#R#%#B$%#B$%###&###&#"), I64{10}, I64{4}, I64{0}, cp) >= I64{0}
}

unicode_is_cased: fn(cp: I64) -> Bool Never! {
    if (cp < I64{128}) { return unicode_table_dense(rt_static_text("#################################################################$$$$$$$$$$$$$$$$$$$$$$$$$$######$$$$$$$$$$$$$$$$$$$$$$$$$$#####"), cp, I64{1}) != I64{0} }
