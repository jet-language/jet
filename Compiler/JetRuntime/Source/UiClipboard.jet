fn ui_text_range_clone(value: I64) -> I64 {
    if (value == I64{0}) -> return I64{0}
    result :: jet_rt_alloc(UI_TEXT_RANGE_BYTES, I64{8})
    ui_carrier_store(result + UI_TEXT_RANGE_START, ui_carrier_word(value + UI_TEXT_RANGE_START))
    ui_carrier_store(result + UI_TEXT_RANGE_END, ui_carrier_word(value + UI_TEXT_RANGE_END))
    result
}
fn ui_text_range_drop(value: I64) {
    if (value != I64{0}) -> jet_rt_free(value, UI_TEXT_RANGE_BYTES, I64{8})
}
fn ui_text_range_eq(a: I64, b: I64) -> Bool {
    if (a == I64{0} || b == I64{0}) -> return a == b
    ui_carrier_word(a + UI_TEXT_RANGE_START) == ui_carrier_word(b + UI_TEXT_RANGE_START) && ui_carrier_word(a + UI_TEXT_RANGE_END) == ui_carrier_word(b + UI_TEXT_RANGE_END)
}
