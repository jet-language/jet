}
fn ui_clipboard_text_eq(a: I64, b: I64) -> Bool {
    jet_rt_string_eq(ui_carrier_word(a + UI_CLIPBOARD_TEXT_TEXT), ui_carrier_word(b + UI_CLIPBOARD_TEXT_TEXT)) && ui_text_range_eq(ui_carrier_word(a + UI_CLIPBOARD_TEXT_SELECTION), ui_carrier_word(b + UI_CLIPBOARD_TEXT_SELECTION))
