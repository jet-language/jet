// HTTPServer.rs:6357-6363 / frozen seed183048-54: derive(Clone).
// CAbiRoutes.rs:12610-12630 lends fields. Text outputs are stack E4 headers
// over borrowed bytes, never owned/freed; callers may clone them while live.
HTTP_CORS_POLICY_BYTES :: comptime { I64{48} }
HTTP_CORS_POLICY_ORIGINS :: comptime { I64{0} }
HTTP_CORS_POLICY_METHODS :: comptime { I64{16} }
HTTP_CORS_POLICY_HEADERS :: comptime { I64{24} }
HTTP_CORS_POLICY_CREDENTIALS :: comptime { I64{32} }
HTTP_CORS_POLICY_MAX_AGE :: comptime { I64{40} }
#Export(c) fn jet_rt_handle_clone_jet_http_cors_policy(value: I64) -> I64 {
    result :: jet_rt_alloc(HTTP_CORS_POLICY_BYTES, I64{8})
    http_cors_origins_copy(value + HTTP_CORS_POLICY_ORIGINS, result + HTTP_CORS_POLICY_ORIGINS)
    encoding_store(result + HTTP_CORS_POLICY_METHODS, jet_rt_string_clone(encoding_word(value + HTTP_CORS_POLICY_METHODS)))
    encoding_store(result + HTTP_CORS_POLICY_HEADERS, jet_rt_string_clone(encoding_word(value + HTTP_CORS_POLICY_HEADERS)))
    credentials :: encoding_word(value + HTTP_CORS_POLICY_CREDENTIALS).bit_and(I64{255})
    encoding_store(result + HTTP_CORS_POLICY_CREDENTIALS, if (credentials == I64{0}) -> I64{0} else -> I64{1})
    encoding_store(result + HTTP_CORS_POLICY_MAX_AGE, encoding_word(value + HTTP_CORS_POLICY_MAX_AGE))
    result
}
#Export(c) fn jet_rt_handle_drop_jet_http_cors_policy(value: I64) {
    if (value == I64{0}) -> return
    http_cors_origins_drop_child(value + HTTP_CORS_POLICY_ORIGINS)
    jet_rt_string_drop(encoding_word(value + HTTP_CORS_POLICY_METHODS))
    jet_rt_string_drop(encoding_word(value + HTTP_CORS_POLICY_HEADERS))
    jet_rt_free(value, HTTP_CORS_POLICY_BYTES, I64{8})
}
#Export(c) fn jet_rt_handle_field_jet_http_cors_policy_origins(value: I64) -> I64 { value + HTTP_CORS_POLICY_ORIGINS }
#Export(c) fn jet_rt_handle_field_jet_http_cors_policy_credentials(value: I64) -> I64 { value + HTTP_CORS_POLICY_CREDENTIALS }
#Export(c) fn jet_rt_handle_field_jet_http_cors_policy_allow_methods(value: I64, output: I64) {
    coll_copy(encoding_word(value + HTTP_CORS_POLICY_METHODS), output, I64{24})
}
#Export(c) fn jet_rt_handle_field_jet_http_cors_policy_allow_headers(value: I64, output: I64) {
    coll_copy(encoding_word(value + HTTP_CORS_POLICY_HEADERS), output, I64{24})
}
