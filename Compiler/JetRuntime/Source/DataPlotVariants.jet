// Domain and Transform are native-private variant carriers. No public
// constructors are invented: future behavior producers must use DataABI.
// Seed declaration/derived ownership and equality: DataPlot.rs:692-711,
// 772-776,798-804,961-967. Borrowed field pointers never clone children.
fn data_plot_texts_clone(sequence: I64) -> I64 {
    length :: data_tree_word(sequence + DATA_SEQUENCE_LENGTH)
    result :: data_sequence_new(length, DATA_TREE_ELEMENT_BYTES)
    at := I64{0}
    loop at < length {
        data_plot_sequence_push(result, jet_rt_string_clone(data_tree_word(data_sequence_slot(sequence, at, DATA_TREE_ELEMENT_BYTES))))
        at += I64{1}
    }
    result
}
fn data_plot_texts_drop(sequence: I64) {
    length :: data_tree_word(sequence + DATA_SEQUENCE_LENGTH)
    at := I64{0}
    loop at < length {
        jet_rt_string_drop(data_tree_word(data_sequence_slot(sequence, at, DATA_TREE_ELEMENT_BYTES)))
        at += I64{1}
    }
    data_plot_sequence_shell_drop(sequence, DATA_TREE_ELEMENT_BYTES)
}
fn data_plot_texts_eq(a: I64, b: I64) -> Bool {
    length :: data_tree_word(a + DATA_SEQUENCE_LENGTH)
    if length != data_tree_word(b + DATA_SEQUENCE_LENGTH) -> return false
    at := I64{0}
    loop at < length {
        if !jet_rt_string_eq(data_tree_word(data_sequence_slot(a, at, DATA_TREE_ELEMENT_BYTES)), data_tree_word(data_sequence_slot(b, at, DATA_TREE_ELEMENT_BYTES))) -> return false
        at += I64{1}
    }
    true
}
#Export(c) fn jet_rt_handle_clone_jet_data_plot_domain(value: I64) -> I64 {
    kind :: data_tree_word(value + DP_DOMAIN_TAG)
    result :: jet_rt_alloc(DP_DOMAIN_BYTES, I64{8})
    data_tree_store(result + DP_DOMAIN_TAG, kind)
    first := I64{0}
    second := I64{0}
    if kind == DP_DOMAIN_NUMERIC {
        first = data_tree_word(value + DP_DOMAIN_FIRST)
        second = data_tree_word(value + DP_DOMAIN_SECOND)
    } else if kind == DP_DOMAIN_CATEGORIES { first = data_plot_texts_clone(data_tree_word(value + DP_DOMAIN_FIRST)) }
    data_tree_store(result + DP_DOMAIN_FIRST, first)
    data_tree_store(result + DP_DOMAIN_SECOND, second)
    result
}
#Export(c) fn jet_rt_handle_drop_jet_data_plot_domain(value: I64) {
    if (value == I64{0}) -> return
    if data_tree_word(value + DP_DOMAIN_TAG) == DP_DOMAIN_CATEGORIES -> data_plot_texts_drop(data_tree_word(value + DP_DOMAIN_FIRST))
    jet_rt_free(value, DP_DOMAIN_BYTES, I64{8})
}
#Export(c) fn jet_rt_handle_eq_jet_data_plot_domain(a: I64, b: I64) -> Bool {
    kind :: data_tree_word(a + DP_DOMAIN_TAG)
    if kind != data_tree_word(b + DP_DOMAIN_TAG) -> return false
    if kind == DP_DOMAIN_AUTO -> return true
    if kind == DP_DOMAIN_NUMERIC -> return rt_f64_from_bits(data_tree_word(a + DP_DOMAIN_FIRST)) == rt_f64_from_bits(data_tree_word(b + DP_DOMAIN_FIRST)) && rt_f64_from_bits(data_tree_word(a + DP_DOMAIN_SECOND)) == rt_f64_from_bits(data_tree_word(b + DP_DOMAIN_SECOND))
    data_plot_texts_eq(data_tree_word(a + DP_DOMAIN_FIRST), data_tree_word(b + DP_DOMAIN_FIRST))
}
fn data_plot_transform_clone(value: I64) -> I64 {
    kind :: data_tree_word(value + DP_TRANSFORM_TAG)
    result :: jet_rt_alloc(DP_TRANSFORM_BYTES, I64{8})
    data_tree_store(result + DP_TRANSFORM_TAG, kind)
    first := data_tree_word(value + DP_TRANSFORM_FIRST)
    second := data_tree_word(value + DP_TRANSFORM_SECOND)
    // A borrowed bool field may have only its low byte initialized.
    if kind == DP_TRANSFORM_SORT { second = second.bit_and(I64{255}) }
    third := I64{0}
    if kind == DP_TRANSFORM_AGGREGATE {
        first = data_plot_fields_clone(first)
        second = jet_rt_handle_clone_jet_data_plot_field(second)
        third = data_tree_word(value + DP_TRANSFORM_THIRD)
    } else {
        first = jet_rt_handle_clone_jet_data_plot_field(first)
        if kind == DP_TRANSFORM_FILTER { third = jet_rt_handle_clone_jet_data_plot_value(data_tree_word(value + DP_TRANSFORM_THIRD)) }
    }
    data_tree_store(result + DP_TRANSFORM_FIRST, first)
    data_tree_store(result + DP_TRANSFORM_SECOND, second)
    data_tree_store(result + DP_TRANSFORM_THIRD, third)
    result
}
fn data_plot_transform_drop(value: I64) {
    kind :: data_tree_word(value + DP_TRANSFORM_TAG)
    if kind == DP_TRANSFORM_AGGREGATE {
        data_plot_fields_drop(data_tree_word(value + DP_TRANSFORM_FIRST))
        jet_rt_handle_drop_jet_data_plot_field(data_tree_word(value + DP_TRANSFORM_SECOND))
    } else {
        jet_rt_handle_drop_jet_data_plot_field(data_tree_word(value + DP_TRANSFORM_FIRST))
        if kind == DP_TRANSFORM_FILTER { jet_rt_handle_drop_jet_data_plot_value(data_tree_word(value + DP_TRANSFORM_THIRD)) }
    }
    jet_rt_free(value, DP_TRANSFORM_BYTES, I64{8})
}
fn data_plot_transform_eq(a: I64, b: I64) -> Bool {
    kind :: data_tree_word(a + DP_TRANSFORM_TAG)
    if kind != data_tree_word(b + DP_TRANSFORM_TAG) -> return false
    if kind == DP_TRANSFORM_AGGREGATE -> return data_plot_fields_eq(data_tree_word(a + DP_TRANSFORM_FIRST), data_tree_word(b + DP_TRANSFORM_FIRST)) && jet_rt_handle_eq_jet_data_plot_field(data_tree_word(a + DP_TRANSFORM_SECOND), data_tree_word(b + DP_TRANSFORM_SECOND)) && data_tree_word(a + DP_TRANSFORM_THIRD) == data_tree_word(b + DP_TRANSFORM_THIRD)
    if !jet_rt_handle_eq_jet_data_plot_field(data_tree_word(a + DP_TRANSFORM_FIRST), data_tree_word(b + DP_TRANSFORM_FIRST)) -> return false
    if kind == DP_TRANSFORM_BIN -> return rt_f64_from_bits(data_tree_word(a + DP_TRANSFORM_SECOND)) == rt_f64_from_bits(data_tree_word(b + DP_TRANSFORM_SECOND))
    if kind == DP_TRANSFORM_SORT -> return (data_tree_word(a + DP_TRANSFORM_SECOND).bit_and(I64{255})) == (data_tree_word(b + DP_TRANSFORM_SECOND).bit_and(I64{255}))
    if data_tree_word(a + DP_TRANSFORM_SECOND) != data_tree_word(b + DP_TRANSFORM_SECOND) -> return false
    if kind == DP_TRANSFORM_FILTER -> return jet_rt_handle_eq_jet_data_plot_value(data_tree_word(a + DP_TRANSFORM_THIRD), data_tree_word(b + DP_TRANSFORM_THIRD))
    true
}
fn data_plot_transforms_clone(sequence: I64) -> I64 {
    length :: data_tree_word(sequence + DATA_SEQUENCE_LENGTH)
    result :: data_sequence_new(length, DATA_TREE_ELEMENT_BYTES)
    at := I64{0}
    loop at < length {
        data_plot_sequence_push(result, data_plot_transform_clone(data_tree_word(data_sequence_slot(sequence, at, DATA_TREE_ELEMENT_BYTES))))
        at += I64{1}
    }
    result
}
fn data_plot_transforms_drop(sequence: I64) {
    length :: data_tree_word(sequence + DATA_SEQUENCE_LENGTH)
    at := I64{0}
    loop at < length {
        data_plot_transform_drop(data_tree_word(data_sequence_slot(sequence, at, DATA_TREE_ELEMENT_BYTES)))
        at += I64{1}
    }
    data_plot_sequence_shell_drop(sequence, DATA_TREE_ELEMENT_BYTES)
}
fn data_plot_transforms_eq(a: I64, b: I64) -> Bool {
    length :: data_tree_word(a + DATA_SEQUENCE_LENGTH)
    if length != data_tree_word(b + DATA_SEQUENCE_LENGTH) -> return false
    at := I64{0}
    loop at < length {
        if !data_plot_transform_eq(data_tree_word(data_sequence_slot(a, at, DATA_TREE_ELEMENT_BYTES)), data_tree_word(data_sequence_slot(b, at, DATA_TREE_ELEMENT_BYTES))) -> return false
        at += I64{1}
    }
    true
}
#Export(c) fn jet_rt_handle_clone_jet_data_plot_scale(value: I64) -> I64 {
    result :: jet_rt_alloc(DP_SCALE_BYTES, I64{8})
    coll_copy(value, result, DP_SCALE_BYTES)
    data_tree_store(result + DP_SCALE_DOMAIN, jet_rt_handle_clone_jet_data_plot_domain(data_tree_word(value + DP_SCALE_DOMAIN)))
    data_tree_store(result + DP_SCALE_CLAMP, data_tree_word(value + DP_SCALE_CLAMP).bit_and(I64{255}))
    data_tree_store(result + DP_SCALE_REVERSE, data_tree_word(value + DP_SCALE_REVERSE).bit_and(I64{255}))
    result
}
#Export(c) fn jet_rt_handle_drop_jet_data_plot_scale(value: I64) {
    if (value == I64{0}) -> return
    jet_rt_handle_drop_jet_data_plot_domain(data_tree_word(value + DP_SCALE_DOMAIN))
    jet_rt_free(value, DP_SCALE_BYTES, I64{8})
}
#Export(c) fn jet_rt_handle_eq_jet_data_plot_scale(a: I64, b: I64) -> Bool {
    data_tree_word(a + DP_SCALE_CHANNEL) == data_tree_word(b + DP_SCALE_CHANNEL) && data_tree_word(a + DP_SCALE_KIND) == data_tree_word(b + DP_SCALE_KIND) && jet_rt_handle_eq_jet_data_plot_domain(data_tree_word(a + DP_SCALE_DOMAIN), data_tree_word(b + DP_SCALE_DOMAIN)) && (data_tree_word(a + DP_SCALE_CLAMP).bit_and(I64{255})) == (data_tree_word(b + DP_SCALE_CLAMP).bit_and(I64{255})) && (data_tree_word(a + DP_SCALE_REVERSE).bit_and(I64{255})) == (data_tree_word(b + DP_SCALE_REVERSE).bit_and(I64{255}))
}
#Export(c) fn jet_rt_handle_field_jet_data_plot_scale_domain(value: I64) -> I64 { data_tree_word(value + DP_SCALE_DOMAIN) }
#Export(c) fn jet_rt_handle_field_jet_data_plot_scale_clamp(value: I64) -> I64 { value + DP_SCALE_CLAMP }
#Export(c) fn jet_rt_handle_field_jet_data_plot_scale_reverse(value: I64) -> I64 { value + DP_SCALE_REVERSE }
#Export(c) fn jet_rt_record_seq_list_rec_jet_data_plot_scale_new(capacity: I64) -> I64 { data_sequence_new(capacity, DATA_TREE_ELEMENT_BYTES) }
#Export(c) fn jet_rt_record_seq_list_rec_jet_data_plot_scale_len(value: I64) -> I64 { data_tree_word(value + DATA_SEQUENCE_LENGTH) }
#Export(c) fn jet_rt_record_seq_list_rec_jet_data_plot_scale_get(value: I64, index: I64) -> I64 { data_tree_word(data_sequence_slot(value, index, DATA_TREE_ELEMENT_BYTES)) }
#Export(c) fn jet_rt_record_seq_list_rec_jet_data_plot_scale_push(value: I64, item: I64) { data_plot_sequence_push(value, item) }
#Export(c) fn jet_rt_handle_clone_jet_data_plot_layer(value: I64) -> I64 {
    result :: jet_rt_alloc(DP_LAYER_BYTES, I64{8})
    data_tree_store(result + DP_LAYER_NAME, jet_rt_string_clone(data_tree_word(value + DP_LAYER_NAME)))
    data_tree_store(result + DP_LAYER_MARK, data_tree_word(value + DP_LAYER_MARK))
    data_tree_store(result + DP_LAYER_ENCODINGS, data_plot_encodings_clone(data_tree_word(value + DP_LAYER_ENCODINGS)))
    data_tree_store(result + DP_LAYER_TRANSFORMS, data_plot_transforms_clone(data_tree_word(value + DP_LAYER_TRANSFORMS)))
    data_tree_store(result + DP_LAYER_OPACITY, data_tree_word(value + DP_LAYER_OPACITY))
    result
}
#Export(c) fn jet_rt_handle_drop_jet_data_plot_layer(value: I64) {
    if (value == I64{0}) -> return
    jet_rt_string_drop(data_tree_word(value + DP_LAYER_NAME))
    data_plot_encodings_drop(data_tree_word(value + DP_LAYER_ENCODINGS))
    data_plot_transforms_drop(data_tree_word(value + DP_LAYER_TRANSFORMS))
    jet_rt_free(value, DP_LAYER_BYTES, I64{8})
}
#Export(c) fn jet_rt_handle_eq_jet_data_plot_layer(a: I64, b: I64) -> Bool {
    jet_rt_string_eq(data_tree_word(a + DP_LAYER_NAME), data_tree_word(b + DP_LAYER_NAME)) && data_tree_word(a + DP_LAYER_MARK) == data_tree_word(b + DP_LAYER_MARK) && data_plot_encodings_eq(data_tree_word(a + DP_LAYER_ENCODINGS), data_tree_word(b + DP_LAYER_ENCODINGS)) && data_plot_transforms_eq(data_tree_word(a + DP_LAYER_TRANSFORMS), data_tree_word(b + DP_LAYER_TRANSFORMS)) && rt_f64_from_bits(data_tree_word(a + DP_LAYER_OPACITY)) == rt_f64_from_bits(data_tree_word(b + DP_LAYER_OPACITY))
}
#Export(c) fn jet_rt_handle_field_jet_data_plot_layer_name(value: I64, out: I64) { data_plot_text_header(data_tree_word(value + DP_LAYER_NAME), out) }
#Export(c) fn jet_rt_handle_field_jet_data_plot_layer_opacity(value: I64) -> I64 { value + DP_LAYER_OPACITY }
#Export(c) fn jet_rt_record_seq_list_rec_jet_data_plot_layer_new(capacity: I64) -> I64 { data_sequence_new(capacity, DATA_TREE_ELEMENT_BYTES) }
#Export(c) fn jet_rt_record_seq_list_rec_jet_data_plot_layer_len(value: I64) -> I64 { data_tree_word(value + DATA_SEQUENCE_LENGTH) }
#Export(c) fn jet_rt_record_seq_list_rec_jet_data_plot_layer_get(value: I64, index: I64) -> I64 { data_tree_word(data_sequence_slot(value, index, DATA_TREE_ELEMENT_BYTES)) }
#Export(c) fn jet_rt_record_seq_list_rec_jet_data_plot_layer_push(value: I64, item: I64) { data_plot_sequence_push(value, item) }
