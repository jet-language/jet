// Native process-edge stops. The Rust originals are the behavioral reference:
// registered stops exit 70; IR Never is a defect (101). Text handles borrow the
// one E4 JetText ABI: [ptr, byte length, capacity], three 8-byte words. No
// String/Vec Rust layout is read here. These exports replace the corresponding
// Rust exports when E2 cuts the pack over.

trap_word: fn(address: I64) -> I64 {
    #Unsafe("the caller borrows an initialized word of a live JetText or static require descriptor") {
        return os_load_i64(address)
    }
}

trap_byte: fn(address: I64) -> I64 {
    #Unsafe("the caller borrows exactly one initialized byte of a live UTF-8 carrier") {
        return os_load_u8(address)
    }
}

trap_store: fn(address: I64, value: I64) {
    #Unsafe("the caller owns eight writable bytes in a scratch mapping or allocated JetText storage") {
        os_store_i64(address, value)
    }
}

trap_put: fn(address: I64, value: I64) {
    #Unsafe("address is one writable byte in the allocated debug-text buffer; value is a byte") {
        os_store_u8(address, value)
    }
}

trap_syscall: fn(number: I64, a1: I64, a2: I64, a3: I64, a4: I64, a5: I64, a6: I64) -> I64 {
    #Unsafe("audited runtime syscall: write borrows live text, mmap creates scratch, munmap releases it, exit_group ends the process; getcwd, mkdir, open and close name caller-owned scratch or a descriptor") {
        return os_syscall_i64(number, a1, a2, a3, a4, a5, a6)
    }
}

// The stop rail's root half (Scheduler.jet jet_rt_trap_root): a code word
// that every control's creation installs (scheduler_control_new). Only a
// control holds a capture or makes a stop the root's, so the paths below
// that find one always find the word installed. A program that never makes
// a control links none of the root's publication and capture.
trap_root_rail_code := I64{0}

TRAP_ROOT_PREPARE: I64{0}
TRAP_ROOT_WRITE: I64{1}
TRAP_ROOT_WRITE_WORD: I64{2}
TRAP_ROOT_EXIT: I64{3}
TRAP_ROOT_DROP: I64{4}

// jet_rt_trap_root's `op` with its three words; 0 when no control exists.
trap_root: fn(op: I64, a: I64, b: I64, c: I64) -> I64 {
    rail: trap_root_rail_code
    if (rail == I64{0}) -> return I64{0}
    coll_call4(rail, op, a, b, c)
}

trap_write: fn(address: I64, count: I64) {
    capture: scheduler_root_capture_pointer(scheduler_report_control_current())
    if (capture != I64{0} && trap_root(TRAP_ROOT_WRITE, capture, address, count) != I64{0}) -> return
    at := I64{0}
    loop at < count {
        written: trap_syscall(I64{1}, I64{2}, address + at, count - at, I64{0}, I64{0}, I64{0})
        if (written == I64{-4}) -> next
        if (written <= I64{0}) -> return
        at += written
    }
}

// Generated report literals use this path even when the allocator is failing.
trap_write_word: fn(word: I64, count: I64) {
    capture: scheduler_root_capture_pointer(scheduler_report_control_current())
    if (capture != I64{0} && trap_root(TRAP_ROOT_WRITE_WORD, capture, word, count) != I64{0}) -> return
    trap_write_word_raw(word, count)
}

// A generated report literal's process-static text (rt_static_text): its
// bytes are in the image, so writing them needs no heap.
trap_write_static: fn(text: I64) { trap_write(rt_text_data(text), rt_text_len(text)) }

// Canonical host-defect rows can write without a GS probe or capture lookup.
// The allocator's GS failure reaches this from every program, so its
// arithmetic cannot stop: the count stays in 1..=8 and each shift is constant
// (Alloc.jet alloc_write_word), linking no numeric or shift-stop report.
trap_write_word_raw: fn(word: I64, count: I64) {
    remaining := word
    length := count
    loop length > (I64{0}) {
        written := I64{0}
        #Unsafe("the OS leaf borrows a stack word; generated calls have 1..8 valid bytes") {
            written = os_write_word_i64(I64{2}, remaining, length)
        }
        if (written == I64{-4}) -> next
        if (written <= I64{0} || written >= length) -> return
        length = wrapping(length - written)
        dropped := I64{0}
        loop dropped < written {
            remaining = remaining >> I64{8}
            dropped = wrapping(dropped + I64{1})
        }
    }
}

// An invalid allocation layout is a stop (E3001) and exits 70 like every
// other (trap_footer): before jet_rt_main or a process exit has claimed a
// status there is none to finish with (#6416).
rt_trap_invalid_box_layout: fn() {
    trap_root_prepare()
    jet_rt_stdout_flush()
    trap_invalid_layout_head()
    trap_footer(I64{0})
}

trap_write_handle: fn(handle: I64) {
    trap_write(trap_word(handle), trap_word(wrapping(handle + I64{8})))
}

// A stop under the process root is published to it (the root half returns
// 1); any other ends the process.
trap_exit: fn(status: I64) {
    if (scheduler_report_domain() == I64{1} && trap_root(TRAP_ROOT_EXIT, status, I64{0}, I64{0}) != I64{0}) -> return
    trap_defect_exit(status)
}
trap_defect_prepare: fn() {
    control: scheduler_report_control_current()
    if (control != I64{0}) -> _ := trap_root(TRAP_ROOT_DROP, control, I64{0}, I64{0})
}
// Every exit_group of a stop, process.exit or defect: the live Secrets are
// scrubbed first, as no drop will clear them (#5478).
trap_defect_exit: fn(status: I64) {
    secret_scrub()
    _ := trap_syscall(I64{231}, status, I64{0}, I64{0}, I64{0}, I64{0}, I64{0})
}

// A failed GS syscall cannot establish ownership of any TCB. Host stdout
// metadata is already initialized before Thread's bootstrap/attach stage; its
// unbounded raw mutex/flush path has no TLS, allocation, or user callbacks.
trap_gs_failure: fn() {
    jet_rt_stdout_flush()
    trap_defect_unreachable_head()
    trap_defect_newline()
    loop { trap_defect_exit(I64{101}) }
}
// A stop under the process root begins the root's captured report. Any other
// stop while jet_rt_main runs its entry is a process stop too (spec.md,
// Cleanup at a process stop): it claims the process exit and runs the exit
// handlers before its first report byte, so their output precedes the
// report. One claim wins; a concurrent loser parks, and a stop inside that
// cleanup exits with the first status (Main.jet main_exit_claim). With no
// live jet_rt_main (an embedding or library host) the report goes straight
// to fd 2.
trap_root_prepare: fn() {
    if (scheduler_report_domain() == I64{1}) {
        _ := trap_root(TRAP_ROOT_PREPARE, I64{0}, I64{0}, I64{0})
        return
    }
    claim: main_process_stop_code
    if (claim != I64{0} && main_root_control != I64{0}) -> _ := coll_call1(claim, I64{70})
}

// Keep both the value and divisor non-positive: neither I64.MIN's negation
// nor I64.MIN / -1 is evaluated. Decimal output needs no heap or scratch map.
trap_number: fn(value: I64) {
    number := if (value > I64{0}) -> -value else -> value
    divisor := I64{-1}
    // Both operands are negative, hence the floor quotient is nonnegative.
    // Negating divisor is safe (its magnitude never exceeds 10^18).
    loop number /% (I64{-10}) >= -divisor -> divisor *= I64{10}
    if (value < I64{0}) -> trap_write_word(I64{45}, I64{1})
    loop {
        // Same-sign operands make floor division the decimal digit quotient.
        trap_write_word(I64{48} + number /% divisor, I64{1})
        number %= divisor
        // Divide two negatives before negation: -1 /% -10 is 0, not -1.
        divisor = -(divisor /% I64{-10})
        if (divisor == I64{0}) -> break
    }
}

trap_line: fn(line: I64) -> I64 Never! {
    if (line < I64{0} || line > I64{4294967295}) -> return I64{0}
    line
}

trap_header: fn(code: I64) {
    trap_root_prepare()
    trap_header_bytes(code)
}
trap_header_bytes: fn(code: I64) {
    jet_rt_stdout_flush()
    if {
        (code == I64{0}) -> trap_msg_header_panic()
        (code == I64{1}) -> trap_msg_header_numeric()
        else -> trap_msg_header_todo()
    }
}

trap_context: fn(file: I64, file_len: I64, line: I64, function: I64, function_len: I64, source: I64, source_len: I64, column: I64, caret: I64) {
    if (file_len != I64{0}) {
        trap_msg_location()
        trap_write(file, file_len)
        trap_msg_colon()
        trap_number(line)
        if (function_len != I64{0}) {
            trap_msg_in_function()
            trap_write(function, function_len)
        }
        trap_msg_newline()
    }
    if (source_len == I64{0}) -> return
    digits := I64{1}
    remainder := line
    loop remainder >= (I64{10}) {
        digits += I64{1}
        // trap_line clamps the line number to a nonnegative value.
        remainder = remainder /% I64{10}
    }
    spaces := I64{0}
    loop spaces < digits + (I64{3}) {
        trap_msg_space()
        spaces += I64{1}
    }
    trap_msg_gutter_line()
    trap_number(line)
    trap_msg_gutter_source()
    trap_write(source, source_len)
    trap_msg_newline()
    spaces = I64{0}
    loop spaces < digits + (I64{3}) {
        trap_msg_space()
        spaces += I64{1}
    }
    trap_msg_gutter_caret()
    spaces = I64{1}
    loop spaces < column {
        trap_msg_space()
        spaces += I64{1}
    }
    spaces = I64{0}
    length: if (caret < I64{1}) -> I64{1} else -> caret
    loop spaces < length {
        trap_msg_caret()
        spaces += I64{1}
    }
    trap_msg_newline()
}

trap_footer: fn(code: I64) {
    trap_footer_bytes(code)
    trap_exit(I64{70})
}
trap_footer_bytes: fn(code: I64) {
    // Exact active registry rows; backticks protect the raw message from the
    // sentence-case pass.
    if {
        (code == I64{0}) -> trap_footer_e3001()
        (code == I64{1}) -> trap_footer_e3010()
        else -> trap_footer_e3011()
    }
}

// A transported Task panic owns only its reason. Render before publishing
// the Root record, reusing the original registered bytes and retaining its
// metadata. No second publication or formatter runs on an existing stop.
trap_root_panic_report: fn(message: I64) -> I64 {
    scheduler_root_capture_begin()
    trap_header_bytes(I64{0})
    trap_write_handle(message)
    trap_msg_prelude_end()
    trap_footer_bytes(I64{0})
    scheduler_root_capture_take(scheduler_control_current())
}

trap_simple: fn(code: I64, file: I64, file_len: I64, line: I64, message: I64, message_len: I64) {
    // jet_runtime_stop_unwind carries the raw message into the task runner, not
    // this process report (jet_scheduler_panic_message).
    comptime_serve_stop(I64{1}, message, message_len, I64{0}, I64{0})
    if rt_task_panic_publish(message, message_len, code) -> return
    production_receipt_write(code, file, file_len, trap_line(line), I64{0}, I64{0})
    trap_header(code)
    trap_write(message, message_len)
    trap_msg_message_end()
    trap_context(file, file_len, trap_line(line), I64{0}, I64{0}, I64{0}, I64{0}, I64{1}, I64{1})
    trap_footer(code)
}

// trap_simple's report without a file, for the whole process: no task stop
// and no root capture (Scheduler.jet scheduler_start_failed), exit 70. Served
// comptime code reports it to the compiler as a panic message.
trap_process_stop: fn(code: I64, message: I64, message_len: I64) {
    comptime_serve_stop(I64{1}, message, message_len, I64{0}, I64{0})
    trap_defect_prepare()
    trap_header_bytes(code)
    trap_write(message, message_len)
    trap_msg_message_end()
    trap_context(I64{0}, I64{0}, trap_line(I64{0}), I64{0}, I64{0}, I64{0}, I64{0}, I64{1}, I64{1})
    trap_footer_bytes(code)
    trap_defect_exit(I64{70})
}

#Export(c) jet_rt_numeric_stop: fn(file: I64, file_len: I64, line: I64, message: I64, message_len: I64) {
    trap_simple(I64{1}, file, file_len, line, message, message_len)
}

// core.rt.__coded_stop(code, message): a Core library stop carrying its
// registered diagnostic code (Core/Http/Server.jet E2804/E2805). The caller
// renders the row's `what` into `message`; the Why/Fix footer is generated
// from the same registry row (Tools/agent/RuntimeGenerators.jet coded_stops).
// Program-side, so exit 70. A task body publishes the raw message. A code
// with no generated footer is a Jet defect: the host form, exit 101.
#Export(c) jet_rt_coded_stop: fn(code: I64, message: I64) {
    data: rt_text_data(message)
    length: rt_text_len(message)
    comptime_serve_stop(I64{1}, data, length, I64{0}, I64{0})
    code_data: rt_text_data(code)
    code_length: rt_text_len(code)
    word_length: if (code_length > I64{8}) -> I64{8} else -> code_length
    word := I64{0}
    at := I64{0}
    loop at < word_length {
        word = word.bit_or(host_u8_get(code_data, at) << (at * I64{8}))
        at += I64{1}
    }
    test_scope_record_raw_stop(word, word_length, data, length)
    if rt_task_panic_publish_recorded(data, length) -> return
    trap_root_prepare()
    jet_rt_stdout_flush()
    if (code_length != I64{5} || !trap_coded_registered(word)) {
        trap_msg_inactive_row_head()
        trap_write(code_data, code_length)
        trap_msg_inactive_row_tail()
        trap_msg_newline()
        trap_exit(I64{101})
        return
    }
    trap_msg_coded_head()
    trap_write(code_data, code_length)
    trap_msg_coded_mid()
    trap_write(data, length)
    trap_msg_newline()
    trap_coded_footer(word)
    trap_exit(I64{70})
}

// ShiftOutOfRange: "Shifting {left|right} by {count} bits is out of range (this
// type is {bits} bits wide)". The count prints in the shifted type's signedness
// (1 = unsigned), as the seed's i128 operand does.
#Export(c) jet_rt_fixed_shift_stop: fn(direction: I64, count: I64, count_unsigned: I64, bits: I64, file: I64, file_len: I64, line: I64) {
    comptime_serve_stop(I64{2}, count, count_unsigned, bits, I64{0})
    message: jet_rt_string_builder_new()
    jet_rt_string_builder_push(message, rt_static_text("Shifting "))
    jet_rt_string_builder_push(message, if (direction == I64{0}) -> rt_static_text("left") else -> rt_static_text("right"))
    jet_rt_string_builder_push(message, rt_static_text(" by "))
    digits: if (count_unsigned != I64{0}) -> jet_rt_u64_to_string(count) else -> jet_rt_i64_to_string(count)
    jet_rt_string_builder_push(message, digits)
    jet_rt_string_drop(digits)
    jet_rt_string_builder_push(message, rt_static_text(" bits is out of range (this type is "))
    width: jet_rt_i64_to_string(bits)
    jet_rt_string_builder_push(message, width)
    jet_rt_string_drop(width)
    jet_rt_string_builder_push(message, rt_static_text(" bits wide)"))
    trap_simple(I64{1}, file, file_len, line, rt_text_data(message), rt_text_len(message))
    jet_rt_string_drop(message)
}

// Publish the seed's raw native-Int range reason. Root rendering stays separate
// so task publication never prints a report.
trap_native_index_range_stop: fn() {
    message: trap_msg_native_index_range_text()
    if rt_task_panic_publish(rt_text_data(message), rt_text_len(message), I64{1}) -> return
    trap_native_index_range_root()
}

trap_native_index_range_root: fn() {
    trap_header(I64{1})
    trap_msg_native_index_range()
    trap_msg_prelude_end()
    trap_footer(I64{1})
}

// Registered E3010 overflow: tasks carry the exact root message; the root
// report stays unchanged even where the seed uses raw Rust arithmetic.
#Export(c) jet_rt_panic_overflow: fn() {
    message: trap_msg_overflow_text()
    if rt_task_panic_publish(rt_text_data(message), rt_text_len(message), I64{1}) -> return
    trap_header(I64{1})
    trap_msg_overflow()
    trap_msg_prelude_end()
    trap_footer(I64{1})
}

#Export(c) jet_rt_panic_division_by_zero: fn() {
    trap_header(I64{1})
    trap_msg_divide_zero()
    trap_msg_prelude_end()
    trap_footer(I64{1})
}

#Export(c) jet_rt_panic_message: fn(message: I64, message_len: I64) {
    comptime_serve_stop(I64{1}, message, message_len, I64{0}, I64{0})
    if rt_task_panic_publish(message, message_len, I64{0}) -> return
    trap_header(I64{0})
    trap_write(message, message_len)
    trap_msg_prelude_end()
    trap_footer(I64{0})
}

// The sole Int export parameter is the lowering's exact list-index carrier.
// This ABI-preserving index seam is permitted until the L4a numeric cutover;
// no Int arithmetic or asm reinterpretation occurs here.
#Export(c) jet_rt_panic_list_bounds: fn(len: I64, index: Int) {
    native: I64.from_int(index) ?? {
        trap_native_index_range_stop()
        if (jet_scheduler_native_propagate() != I64{0}) -> return
        return
    }
    comptime_serve_stop(I64{3}, len, native, I64{0}, I64{0})
    message: trap_list_bounds_reason(len, native)
    published: rt_task_panic_publish(rt_text_data(message), rt_text_len(message), I64{1})
    jet_rt_string_drop(message)
    if published -> return
    trap_header(I64{1})
    trap_msg_list_head()
    trap_number(len)
    trap_msg_list_noun(len)
    trap_msg_list_position()
    trap_number(native)
    trap_msg_list_end()
    trap_footer(I64{1})
}

// The Rust original supplies the one list-index reason, as an owned String.
// Reuse the existing decimal formatter, including I64.MIN.
trap_list_bounds_reason: fn(len: I64, index: I64) -> I64 {
    message: jet_rt_string_builder_new()
    trap_build_msg_list_head(message)
    rt_text_push_number(message, len)
    trap_build_msg_list_noun(message, len)
    trap_build_msg_list_position(message)
    rt_text_push_number(message, index)
    rt_text_push_word(message, I64{8369779874393449504}, I64{8})
    rt_text_push_word(message, I64{128039039558944}, I64{6})
    message
}

// " item" for a one-item list, " items" otherwise (#4627).
trap_msg_list_noun: fn(len: I64) {
    trap_msg_list_item()
    if (len != I64{1}) { trap_msg_list_plural() }
}

trap_build_msg_list_noun: fn(builder: I64, len: I64) {
    trap_build_msg_list_item(builder)
    if (len != I64{1}) { trap_build_msg_list_plural(builder) }
}

// The list-index stop of compiled code (jet_runtime_stop): the IR's native word
// index, reported at the indexing file and line.
#Export(c) jet_rt_list_bounds_stop: fn(len: I64, index: I64, file: I64, file_len: I64, line: I64) {
    comptime_serve_stop(I64{3}, len, index, I64{0}, I64{0})
    message: trap_list_bounds_reason(len, index)
    trap_simple(I64{1}, file, file_len, line, rt_text_data(message), rt_text_len(message))
    jet_rt_string_drop(message)
}

// `bounds: report` (JetIR ir_list_bounds_report): a failed list bounds check
// of code built with the `check_removal` gate writes one line to stderr,
// naming the indexing file and line, and the program goes on with the
// access. The index is the native word the check compared, so no exact-Int
// seam is crossed and nothing here stops.
#Export(c) jet_rt_report_list_bounds: fn(len: I64, index: I64, file: I64, file_len: I64, line: I64) {
    jet_rt_stdout_flush()
    trap_msg_report_list_head()
    trap_number(len)
    trap_msg_list_noun(len)
    trap_msg_list_position()
    trap_number(index)
    trap_msg_report_list_at()
    trap_write(file, file_len)
    trap_write_word(I64{58}, I64{1})
    trap_number(trap_line(line))
    trap_msg_report_list_end()
}

// An uncaught host payload is a defect, not an E3001 stop. Rust's
// thread/source/backtrace panic-hook framing is host implementation detail;
// retain the payload bytes and the host-fault exit class. Like
// jet_rt_unreachable it exits at once: no program stop publication.
trap_host_fault: fn(message: I64, length: I64) {
    trap_defect_prepare()
    jet_rt_stdout_flush()
    trap_write(message, length)
    trap_msg_newline()
    trap_defect_exit(I64{101})
}

// IR Never is not a program-side stop. The Rust host's thread/source/backtrace
// prefix is not Jet semantics; preserve the unreachable! body and status 101.
#Export(c) jet_rt_unreachable: fn(reason: I64, length: I64) {
    comptime_serve_stop(I64{1}, reason, length, I64{0}, I64{0})
    trap_defect_prepare()
    jet_rt_stdout_flush()
    trap_msg_unreachable()
    trap_write(reason, length)
    trap_msg_newline()
    trap_defect_exit(I64{101})
}

// Vec::with_capacity(capacity as usize) and growth overflow are foreign
// Rust String panics under CAbi guard: body + newline, exit 101, not a Jet stop.
rt_seq_capacity_overflow_stop: fn() {
    trap_defect_prepare()
    jet_rt_stdout_flush()
    trap_write_static(rt_static_text("capacity overflow"))
    trap_msg_newline()
    trap_defect_exit(I64{101})
}

// These CAbi getters index Vec[index as usize]. Their bounds panic is a
// foreign String host defect, not a Jet record-variant or Root program stop.
// Keep the raw reason and the x64 unsigned index, including negative I64.
rt_seq_index_oob_stop: fn(length: I64, index: I64) {
    trap_defect_prepare()
    jet_rt_stdout_flush()
    alloc_write_word(I64{8462017926321696361}, I64{8})
    alloc_write_word(I64{8462090116149485684}, I64{8})
    alloc_write_word(I64{7307218077177046126}, I64{8})
    alloc_write_word(I64{2338328219547429920}, I64{8})
    alloc_write_size(length)
    alloc_write_word(I64{7307218078150255136}, I64{8})
    alloc_write_word(I64{7575186950109161760}, I64{8})
    alloc_write_word(I64{8307}, I64{2})
    if (index >= I64{0}) {
        alloc_write_size(index)
    } else {
        // Unsigned index = 2 * half + lowBit. Both the decimal quotient and
        // last digit fit signed I64; no MIN negation or unsigned cast is used.
        half: (index >> I64{1}).bit_and(I64{9223372036854775807})
        quotient: half /% I64{5}
        last: (half % I64{5}) * I64{2} + (index.bit_and(I64{1}))
        alloc_write_size(quotient)
        alloc_write_word(I64{48} + last, I64{1})
    }
    alloc_write_word(I64{10}, I64{1})
    trap_defect_exit(I64{101})
}

#Export(c) jet_panic: fn(file: I64, line: I64, message: I64) {
    trap_simple(I64{0}, trap_word(file), trap_word(wrapping(file + I64{8})), trap_line(line), trap_word(message), trap_word(wrapping(message + I64{8})))
}

// record_index_stop publishes this exact seed reason: "record variant index out
// of range". jet_rt_panic_message owns the one task-publication path. At root
// its header + message + prelude_end + footer is byte-identical to
// jet_panic("<core.prelude>", 0, message).
rt_record_variant_panic: fn() {
    message: rt_static_text("record variant index out of range")
    jet_rt_panic_message(rt_text_data(message), rt_text_len(message))
}

trap_rich: fn(file: I64, line: I64, function: I64, source: I64, column: I64, caret: I64, message: I64, locals: I64) {
    // Task bodies receive the original message, never the rendered report
    // (architecture.md TaskFailure.Panicked.
    if rt_task_panic_publish(trap_word(message), trap_word(wrapping(message + I64{8})), I64{0}) -> return
    production_receipt_write(I64{0}, trap_word(file), trap_word(wrapping(file + I64{8})), trap_line(line), trap_word(function), trap_word(wrapping(function + I64{8})))
    trap_header(I64{0})
    trap_write_handle(message)
    trap_msg_message_end()
    trap_context(trap_word(file), trap_word(wrapping(file + I64{8})), trap_line(line), trap_word(function), trap_word(wrapping(function + I64{8})), trap_word(source), trap_word(wrapping(source + I64{8})), trap_line(column), trap_line(caret))
    if (locals != I64{0}) {
        if (trap_word(wrapping(locals + I64{8})) > I64{0}) {
            trap_msg_locals()
            trap_write_handle(locals)
            trap_msg_newline()
        }
    }
    trap_footer(I64{0})
}

#Export(c) jet_panic_rich: fn(file: I64, line: I64, function: I64, source: I64, column: I64, caret: I64, message: I64, locals: I64) {
    trap_rich(file, line, function, source, column, caret, message, locals)
}

#Export(c) jet_todo_stop: fn(file: I64, line: I64, expected_type: I64) {
    comptime_serve_stop(I64{5}, file, line, expected_type, I64{0})
    trap_header(I64{2})
    trap_msg_todo()
    trap_write_handle(file)
    trap_msg_colon()
    trap_number(trap_line(line))
    trap_msg_todo_expected()
    trap_write_handle(expected_type)
    trap_msg_message_end()
    trap_context(trap_word(file), trap_word(wrapping(file + I64{8})), trap_line(line), I64{0}, I64{0}, I64{0}, I64{0}, I64{1}, I64{1})
    trap_footer(I64{2})
}

// A pending core.testing evidence failure (`golden`, `snap`, `fixture`) is
// what a failed `assert`/`assert_eq` of that result reports: its message is
// the stop's message and its detail (the path, then any bounded diff) the
// locals line. An explicit `panic` (kind 2) and a failed contract clause
// (kind 3) keep their own text. The stop does not return, so the pair stays
// owned by the thread's test state.
#Export(c) jet_rt_require_stop: fn(kind: I64, descriptor: I64, message: I64, left: I64, right: I64, locals: I64) {
    state: if (kind >= I64{2}) -> I64{0} else -> test_scope_pending_failure()
    if (state == I64{0}) {
        trap_require_stop(kind, descriptor, message, left, right, locals)
        return
    }
    trap_require_stop(I64{0}, descriptor, trap_word(wrapping(state + I64{120})), I64{0}, I64{0}, trap_word(wrapping(state + I64{128})))
}

trap_require_stop: fn(kind: I64, descriptor: I64, message: I64, left: I64, right: I64, locals: I64) {
    comptime_serve_stop(I64{4}, kind, message, left, right)
    if (kind == I64{3}) {
        trap_contract_stop(descriptor, message, locals)
        return
    }
    // Same raw task message as trap_rich; equality stops carry their text.
    // Every domain offers it to rt_task_panic_publish, which records the raw
    // stop on each open `.expect_fail` frame before it checks for a task: a
    // root test body (domain 1) renders below, and its region's
    // jet_rt_test_catch_for_scope must still see the stop (#6196).
    raw := message
    if (kind == I64{1}) {
        raw = jet_rt_string_builder_new()
        trap_build_msg_expected(raw)
        jet_rt_string_builder_push(raw, right)
        trap_build_msg_got(raw)
        jet_rt_string_builder_push(raw, left)
    }
    published: rt_task_panic_publish(trap_word(raw), trap_word(wrapping(raw + I64{8})), I64{0})
    if (kind == I64{1}) -> jet_rt_string_drop(raw)
    if published -> return
    production_receipt_write(I64{0}, trap_word(descriptor), trap_word(wrapping(descriptor + I64{8})), trap_line(trap_word(wrapping(descriptor + I64{16}))), trap_word(wrapping(descriptor + I64{24})), trap_word(wrapping(descriptor + I64{32})))
    trap_header(I64{0})
    if (kind < I64{2}) -> test_stop_assertion_mark()
    if {
        (kind == I64{1}) -> {
            trap_msg_expected()
            trap_write_handle(right)
            trap_msg_got()
            trap_write_handle(left)
        }
        else -> trap_write_handle(message)
    }
    trap_msg_message_end()
    trap_descriptor_context(descriptor, locals)
    trap_footer(I64{0})
}

// A require-style stop's location (IR ir_stop's 88-byte descriptor) and its
// locals line, when it has any.
trap_descriptor_context: fn(descriptor: I64, locals: I64) {
    trap_context(trap_word(descriptor), trap_word(wrapping(descriptor + I64{8})), trap_line(trap_word(wrapping(descriptor + I64{16}))), trap_word(wrapping(descriptor + I64{24})), trap_word(wrapping(descriptor + I64{32})), trap_word(wrapping(descriptor + I64{40})), trap_word(wrapping(descriptor + I64{48})), trap_line(trap_word(wrapping(descriptor + I64{56}))), trap_line(trap_word(wrapping(descriptor + I64{64}))))
    if (locals != I64{0}) {
        if (trap_word(wrapping(locals + I64{8})) > I64{0}) {
            trap_msg_locals()
            trap_write_handle(locals)
            trap_msg_newline()
        }
    }
}

// A failed `#Pre`/`#Post` clause (JetIR BuildContracts.jet ir_contract) is
// E3005: its message is the clause's report (`#Pre contract failed: …`) and
// the row's Why quotes it. A task body publishes that message as a `panic`
// does; an expectation frame records it under E3005.
trap_contract_stop: fn(descriptor: I64, message: I64, locals: I64) {
    data: trap_word(message)
    length: trap_word(wrapping(message + I64{8}))
    test_scope_record_raw_stop(TEST_SCOPE_E3005, I64{5}, data, length)
    if rt_task_panic_publish_recorded(data, length) -> return
    trap_root_prepare()
    jet_rt_stdout_flush()
    trap_msg_header_contract()
    trap_write_handle(message)
    trap_msg_newline()
    trap_descriptor_context(descriptor, locals)
    trap_footer_e3005_head()
    trap_write_handle(message)
    trap_footer_e3005_tail()
    trap_exit(I64{70})
}

trap_range_end: fn(start: I64, end: I64, exclusive: U8, len: I64) -> I64 Never! {
    if (start < I64{0} || end < I64{0} || start > end) -> return I64{-1}
    if (exclusive != U8{0}) {
        if end <= len -> return end
        return I64{-1}
    }
    // end < len proves end + 1 cannot overflow, even at I64.MAX.
    if end < len -> return end + I64{1}
    I64{-1}
}

trap_range_stop: fn(view: Bool, start: I64, end: I64, exclusive: U8, len: I64, file: I64, file_len: I64, line: I64) {
    trap_header(I64{0})
    trap_msg_range_head()
    if view -> trap_msg_range_view()
    else -> trap_msg_range_slice()
    trap_msg_space()
    trap_number(len)
    trap_msg_range_items()
    trap_number(start)
    trap_msg_range_to()
    trap_number(end)
    trap_msg_range_open()
    if (exclusive != U8{0}) -> trap_msg_exclusive()
    else -> trap_msg_inclusive()
    trap_msg_range_end()
    trap_context(file, file_len, trap_line(line), I64{0}, I64{0}, I64{0}, I64{0}, I64{1}, I64{1})
    trap_footer(I64{0})
}

#Export(c) jet_rt_slice_end: fn(start: I64, end: I64, exclusive: U8, len: I64, file: I64, file_len: I64, line: I64) -> I64 {
    result: trap_range_end(start, end, exclusive, len)
    if (result >= I64{0}) -> return result
    trap_range_stop(false, start, end, exclusive, len, file, file_len, line)
    I64{0}
}

#Export(c) jet_rt_view_end: fn(start: I64, end: I64, exclusive: U8, len: I64, file: I64, file_len: I64, line: I64) -> I64 {
    result: trap_range_end(start, end, exclusive, len)
    if (result >= I64{0}) -> return result
    trap_range_stop(true, start, end, exclusive, len, file, file_len, line)
    I64{0}
}

trap_debug_escaped: fn(code: I64) -> Bool Never! {
    ranges: TRAP_DEBUG_RANGES
    low := I64{0}
    high := TRAP_DEBUG_RANGE_COUNT
    loop low < high {
        // Both bounds are nonnegative interval-table indices.
        middle: low + (high - low) /% I64{2}
        first: ranges[Int.from_i64(middle * I64{2})]
        last: ranges[Int.from_i64(middle * I64{2} + I64{1})]
        if {
            code < first -> high = middle
            code > last -> low = middle + I64{1}
            else -> return true
        }
    }
    false
}

// Every E4 producer validates UTF-8; this decoder only borrows those bytes.
TrapScalar: struct { code: I64, width: I64 }
trap_scalar: fn(address: I64) -> TrapScalar {
    first: trap_byte(address)
    if (first < I64{128}) -> return TrapScalar{code: first, width: I64{1}}
    second: trap_byte(wrapping(address + I64{1})).bit_and(I64{63})
    if (first < I64{224}) -> return TrapScalar{code: (first.bit_and(I64{31})) * I64{64} + second, width: I64{2}}
    third: trap_byte(wrapping(address + I64{2})).bit_and(I64{63})
    if (first < I64{240}) -> return TrapScalar{code: (first.bit_and(I64{15})) * I64{4096} + second * I64{64} + third, width: I64{3}}
    fourth: trap_byte(wrapping(address + I64{3})).bit_and(I64{63})
    TrapScalar{code: (first.bit_and(I64{7})) * I64{262144} + second * I64{4096} + third * I64{64} + fourth, width: I64{4}}
}

// NUL uses the generic \u{0} escape, CR uses \r, and
// printable braces are copied unchanged so the result lexes to equal text.
trap_debug_short: fn(code: I64) -> I64 Never! {
    if (code == I64{9}) -> return I64{116}
    if (code == I64{10}) -> return I64{110}
    if (code == I64{13}) -> return I64{114}
    if (code == I64{34} || code == I64{92}) -> return code
    I64{-1}
}

// Jet text quoting shares the exact Rust debug escaper, except
// NUL is \u{0} here rather than Rust's \0. One table, decoder and escape loop.
#Export(c) jet_rt_require_debug_string: fn(value: I64) -> I64 {
    capacity: rt_text_len(value) * I64{10} + I64{2}
    result: rt_text_builder_with_capacity(capacity)
    rt_text_push_debug_str(result, value, false)
    result
}
