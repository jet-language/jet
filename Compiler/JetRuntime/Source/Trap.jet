// Native process-edge stops. Core.rs and RuntimeDiagnosticCore.rs are the
// behavioral reference: registered stops exit 70; MIR Never is a defect (101).
// Text handles borrow the one E4 JetText ABI: [ptr, byte length, capacity],
// three 8-byte words. No String/Vec Rust layout is read here. These exports
// replace the corresponding Rust exports when E2 cuts the pack over.

#[Unsafe("borrows the native String handle without changing its owner; E4 fixes its three-word JetText layout"), FFI(asm)]
fn trap_text_handle(value: String) -> I64 {
    """
    mov rax, {value} ; -> return
    """
}

fn trap_word(address: I64) -> I64 {
    #Unsafe("the caller borrows an initialized word of a live JetText or static require descriptor") {
        return os_load_i64(address)
    }
}

fn trap_byte(address: I64) -> I64 {
    #Unsafe("the caller borrows exactly one initialized byte of a live UTF-8 carrier") {
        return os_load_u8(address)
    }
}

fn trap_store(address: I64, value: I64) {
    #Unsafe("the caller owns eight writable bytes in a scratch mapping or allocated JetText storage") {
        os_store_i64(address, value)
    }
}

fn trap_put(address: I64, value: I64) {
    #Unsafe("address is one writable byte in the allocated debug-text buffer; value is a byte") {
        os_store_u8(address, value)
    }
}

fn trap_syscall(number: I64, a1: I64, a2: I64, a3: I64, a4: I64, a5: I64, a6: I64) -> I64 {
    #Unsafe("audited runtime syscall: write borrows live text, mmap creates scratch, munmap releases it, exit_group ends the process") {
        return os_syscall_i64(number, a1, a2, a3, a4, a5, a6)
    }
}

fn trap_write(address: I64, count: I64) {
    at := I64{0}
    loop at < count {
        written :: trap_syscall(I64{1}, I64{2}, address + at, count - at, I64{0}, I64{0}, I64{0})
        if (written == I64{-4}) -> next
        if (written <= I64{0}) -> return
        at += written
    }
}

// Generated report literals use this path even when the allocator is failing.
fn trap_write_word(word: I64, count: I64) {
    remaining := word
    length := count
    loop (length > I64{0}) {
        written := I64{0}
        #Unsafe("the OS leaf borrows a stack word; generated calls have 1..8 valid bytes") {
            written = os_write_word_i64(I64{2}, remaining, length)
        }
        if (written == I64{-4}) -> next
        if (written <= I64{0} || written >= length) -> return
        remaining >>= written * I64{8}
        length -= written
    }
}

fn rt_trap_invalid_box_layout() {
    trap_invalid_layout_head()
    trap_footer_e3001()
    trap_exit(I64{70})
}

fn trap_write_handle(handle: I64) {
    trap_write(trap_word(handle), trap_word(handle + I64{8}))
}

fn trap_literal(value: String) {
    #Unsafe("the read-only identity leaf borrows value for this call; its owner remains live through write") {
        trap_write_handle(trap_text_handle(value))
    }
}

fn trap_exit(status: I64) {
    _ := trap_syscall(I64{231}, status, I64{0}, I64{0}, I64{0}, I64{0}, I64{0})
}

// Keep both the value and divisor non-positive: neither I64.MIN's negation
// nor I64.MIN / -1 is evaluated. Decimal output needs no heap or scratch map.
fn trap_number(value: I64) {
    number := if (value > I64{0}) -> -value else -> value
    divisor := I64{-1}
    loop (number / I64{10} <= divisor) -> divisor *= I64{10}
    if (value < I64{0}) -> trap_write_word(I64{45}, I64{1})
    loop {
        trap_write_word(I64{48} + number / divisor, I64{1})
        number %= divisor
        divisor /= I64{10}
        if (divisor == I64{0}) -> break
    }
}

fn trap_line(line: I64) -> I64 Never! {
    if (line < I64{0} || line > I64{4294967295}) -> return I64{0}
    line
}

fn trap_header(code: I64) {
    if (code == I64{0}) -> trap_literal("Stop [E3001]: `panic: ")
    else if (code == I64{1}) -> trap_literal("Stop [E3010]: `")
    else -> trap_literal("Stop [E3011]: `")
}

fn trap_context(file: I64, file_len: I64, line: I64, function: I64, function_len: I64, source: I64, source_len: I64, column: I64, caret: I64) {
    if (file_len != I64{0}) {
        trap_literal("  --> ")
        trap_write(file, file_len)
        trap_literal(":")
        trap_number(line)
        if (function_len != I64{0}) {
            trap_literal(" in ")
            trap_write(function, function_len)
        }
        trap_literal("\n")
    }
    if (source_len == I64{0}) -> return
    digits := I64{1}
    remainder := line
    loop (remainder >= I64{10}) {
        digits += I64{1}
        remainder /= I64{10}
    }
    spaces := I64{0}
    loop (spaces < digits + I64{3}) {
        trap_literal(" ")
        spaces += I64{1}
    }
    trap_literal("|\n")
    trap_number(line)
    trap_literal(" | ")
    trap_write(source, source_len)
    trap_literal("\n")
    spaces = I64{0}
    loop (spaces < digits + I64{3}) {
        trap_literal(" ")
        spaces += I64{1}
    }
    trap_literal("| ")
    spaces = I64{1}
    loop spaces < column {
        trap_literal(" ")
        spaces += I64{1}
    }
    spaces = I64{0}
    length :: if (caret < I64{1}) -> I64{1} else -> caret
    loop spaces < length {
        trap_literal("^")
        spaces += I64{1}
    }
    trap_literal("\n")
}

fn trap_footer(code: I64) {
    // Exact active registry rows; backticks protect the raw message from the
    // sentence-case pass in RuntimeDiagnosticCore.rs.
    if (code == I64{0}) -> trap_footer_e3001()
    else if (code == I64{1}) -> trap_footer_e3010()
    else -> trap_footer_e3011()
    trap_exit(I64{70})
}

fn trap_simple(code: I64, file: I64, file_len: I64, line: I64, message: I64, message_len: I64) {
    trap_header(code)
    trap_write(message, message_len)
    trap_literal("`\n")
    trap_context(file, file_len, trap_line(line), I64{0}, I64{0}, I64{0}, I64{0}, I64{1}, I64{1})
    trap_footer(code)
}

#Export(c) fn jet_rt_numeric_stop(file: I64, file_len: I64, line: I64, message: I64, message_len: I64) {
    trap_simple(I64{1}, file, file_len, line, message, message_len)
}

fn trap_prelude(code: I64, message: String) {
    #Unsafe("both borrowed String handles outlive the synchronous stop renderer") {
        file_text :: "<core.prelude>"
        file :: trap_text_handle(file_text)
        text :: trap_text_handle(message)
        trap_simple(code, trap_word(file), trap_word(file + I64{8}), I64{0}, trap_word(text), trap_word(text + I64{8}))
    }
}

#Export(c) fn jet_rt_panic_overflow() {
    trap_prelude(I64{1}, "This arithmetic overflows the value's type (the result is outside its range)")
}

#Export(c) fn jet_rt_panic_division_by_zero() {
    trap_prelude(I64{1}, "divided by zero")
}

#Export(c) fn jet_rt_panic_message(message: I64, message_len: I64) {
    #Unsafe("the literal's String carrier remains alive until the process exits") {
        file_text :: "<core.prelude>"
        file :: trap_text_handle(file_text)
        trap_simple(I64{0}, trap_word(file), trap_word(file + I64{8}), I64{0}, message, message_len)
    }
}

#Export(c) fn jet_rt_panic_list_bounds(len: I64, index: I64) {
    trap_header(I64{1})
    trap_literal("the list has ")
    trap_number(len)
    trap_literal(" items, so position ")
    trap_number(index)
    trap_literal(" doesn't exist`\n  --> <core.prelude>:0\n")
    trap_footer(I64{1})
}

// MIR Never is not a program-side stop. The Rust host's thread/source/backtrace
// prefix is not Jet semantics; preserve the unreachable! body and status 101.
#Export(c) fn jet_rt_unreachable(reason: I64, length: I64) {
    trap_literal("internal error: entered unreachable code: ")
    trap_write(reason, length)
    trap_literal("\n")
    trap_exit(I64{101})
}

#Export(c) fn jet_panic(file: I64, line: I64, message: I64) {
    trap_simple(I64{0}, trap_word(file), trap_word(file + I64{8}), trap_line(line), trap_word(message), trap_word(message + I64{8}))
}

fn trap_rich(file: I64, line: I64, function: I64, source: I64, column: I64, caret: I64, message: I64, locals: I64) {
    trap_header(I64{0})
    trap_write_handle(message)
    trap_literal("`\n")
    trap_context(trap_word(file), trap_word(file + I64{8}), trap_line(line), trap_word(function), trap_word(function + I64{8}), trap_word(source), trap_word(source + I64{8}), trap_line(column), trap_line(caret))
    if (locals != I64{0}) {
        if (trap_word(locals + I64{8}) > I64{0}) {
            trap_literal("locals: ")
            trap_write_handle(locals)
            trap_literal("\n")
        }
    }
    trap_footer(I64{0})
}

#Export(c) fn jet_panic_rich(file: I64, line: I64, function: I64, source: I64, column: I64, caret: I64, message: I64, locals: I64) {
    trap_rich(file, line, function, source, column, caret, message, locals)
}

#Export(c) fn jet_todo_stop(file: I64, line: I64, expected_type: I64) {
    trap_header(I64{2})
    trap_literal("#Todo at ")
    trap_write_handle(file)
    trap_literal(":")
    trap_number(trap_line(line))
    trap_literal(" — expected ")
    trap_write_handle(expected_type)
    trap_literal("`\n")
    trap_context(trap_word(file), trap_word(file + I64{8}), trap_line(line), I64{0}, I64{0}, I64{0}, I64{0}, I64{1}, I64{1})
    trap_footer(I64{2})
}

#Export(c) fn jet_rt_require_stop(kind: I64, descriptor: I64, message: I64, left: I64, right: I64, locals: I64) {
    trap_header(I64{0})
    if (kind == I64{1}) {
        trap_literal("expected: ")
        trap_write_handle(right)
        trap_literal(", got: ")
        trap_write_handle(left)
    } else -> trap_write_handle(message)
    trap_literal("`\n")
    trap_context(trap_word(descriptor), trap_word(descriptor + I64{8}), trap_line(trap_word(descriptor + I64{16})), trap_word(descriptor + I64{24}), trap_word(descriptor + I64{32}), trap_word(descriptor + I64{40}), trap_word(descriptor + I64{48}), trap_line(trap_word(descriptor + I64{56})), trap_line(trap_word(descriptor + I64{64})))
    if (locals != I64{0}) {
        if (trap_word(locals + I64{8}) > I64{0}) {
            trap_literal("locals: ")
            trap_write_handle(locals)
            trap_literal("\n")
        }
    }
    trap_footer(I64{0})
}

fn trap_range_end(start: I64, end: I64, exclusive: U8, len: I64) -> I64 Never! {
    if (start < I64{0} || end < I64{0} || start > end) -> return I64{-1}
    if (exclusive != U8{0}) {
        if end <= len -> return end
        return I64{-1}
    }
    // end < len proves end + 1 cannot overflow, even at I64.MAX.
    if end < len -> return end + I64{1}
    I64{-1}
}

fn trap_range_stop(action: String, start: I64, end: I64, exclusive: U8, len: I64, file: I64, file_len: I64, line: I64) {
    trap_header(I64{0})
    trap_literal("can't ")
    trap_literal(action)
    trap_literal(" ")
    trap_number(len)
    trap_literal(" items from ")
    trap_number(start)
    trap_literal(" to ")
    trap_number(end)
    trap_literal(" (")
    if (exclusive != U8{0}) -> trap_literal("exclusive")
    else -> trap_literal("inclusive")
    trap_literal(")`\n")
    trap_context(file, file_len, trap_line(line), I64{0}, I64{0}, I64{0}, I64{0}, I64{1}, I64{1})
    trap_footer(I64{0})
}

#Export(c) fn jet_rt_slice_end(start: I64, end: I64, exclusive: U8, len: I64, file: I64, file_len: I64, line: I64) -> I64 {
    result :: trap_range_end(start, end, exclusive, len)
    if (result >= I64{0}) -> return result
    trap_range_stop("slice", start, end, exclusive, len, file, file_len, line)
    I64{0}
}

#Export(c) fn jet_rt_view_end(start: I64, end: I64, exclusive: U8, len: I64, file: I64, file_len: I64, line: I64) -> I64 {
    result :: trap_range_end(start, end, exclusive, len)
    if (result >= I64{0}) -> return result
    trap_range_stop("view", start, end, exclusive, len, file, file_len, line)
    I64{0}
}

fn trap_debug_escaped(code: I64) -> Bool Never! {
    ranges :: TRAP_DEBUG_RANGES
    low := I64{0}
    high := TRAP_DEBUG_RANGE_COUNT
    loop low < high {
        middle :: low + (high - low) / I64{2}
        first :: ranges[Int.from_i64(middle * I64{2})]
        last :: ranges[Int.from_i64(middle * I64{2} + I64{1})]
        if code < first -> high = middle
        else if code > last -> low = middle + I64{1}
        else -> return true
    }
    false
}

// Every E4 producer validates UTF-8; this decoder only borrows those bytes.
struct TrapScalar { code: I64, width: I64 }
fn trap_scalar(address: I64) -> TrapScalar {
    first :: trap_byte(address)
    if (first < I64{128}) -> return TrapScalar{code: first, width: I64{1}}
    second :: trap_byte(address + I64{1}) & I64{63}
    if (first < I64{224}) -> return TrapScalar{code: (first & I64{31}) * I64{64} + second, width: I64{2}}
    third :: trap_byte(address + I64{2}) & I64{63}
    if (first < I64{240}) -> return TrapScalar{code: (first & I64{15}) * I64{4096} + second * I64{64} + third, width: I64{3}}
    fourth :: trap_byte(address + I64{3}) & I64{63}
    TrapScalar{code: (first & I64{7}) * I64{262144} + second * I64{4096} + third * I64{64} + fourth, width: I64{4}}
}

fn trap_debug_short(code: I64) -> I64 Never! {
    if (code == I64{0}) -> return I64{48}
    if (code == I64{9}) -> return I64{116}
    if (code == I64{10}) -> return I64{110}
    if (code == I64{13}) -> return I64{114}
    if (code == I64{34} || code == I64{92}) -> return code
    I64{-1}
}

// Rust str::Debug quoting, including non-printable/grapheme-extending scalars.
// The owned result is an E4 header and buffer allocated by the one Jet heap.
// Worst case is one ten-byte escape per input byte. One pass avoids repeatedly
// growing and copying the result; the actual byte length is recorded separately.
#Export(c) fn jet_rt_require_debug_string(value: I64) -> I64 {
    input :: trap_word(value)
    length :: trap_word(value + I64{8})
    capacity :: length * I64{10} + I64{2}
    output :: jet_rt_alloc(capacity, I64{1})
    at := I64{0}
    used := I64{1}
    trap_put(output, I64{34})
    loop at < length {
        scalar :: trap_scalar(input + at)
        short :: trap_debug_short(scalar.code)
        if (short >= I64{0}) {
            trap_put(output + used, I64{92})
            trap_put(output + used + I64{1}, short)
            used += I64{2}
        } else if (scalar.code < I64{32} || scalar.code == I64{127} || (scalar.code >= I64{128} && trap_debug_escaped(scalar.code))) {
            trap_put(output + used, I64{92})
            trap_put(output + used + I64{1}, I64{117})
            trap_put(output + used + I64{2}, I64{123})
            used += I64{3}
            divisor := I64{1}
            loop (scalar.code / divisor >= I64{16}) -> divisor *= I64{16}
            loop {
                digit :: scalar.code / divisor % I64{16}
                trap_put(output + used, if (digit < I64{10}) -> I64{48} + digit else -> I64{87} + digit)
                used += I64{1}
                divisor /= I64{16}
                if (divisor == I64{0}) -> break
            }
            trap_put(output + used, I64{125})
            used += I64{1}
        } else {
            byte := I64{0}
            loop byte < scalar.width {
                trap_put(output + used, trap_byte(input + at + byte))
                used += I64{1}
                byte += I64{1}
            }
        }
        at += scalar.width
    }
    trap_put(output + used, I64{34})
    used += I64{1}
    header :: jet_rt_alloc(I64{24}, I64{8})
    trap_store(header, output)
    trap_store(header + I64{8}, used)
    trap_store(header + I64{16}, capacity)
    header
}
