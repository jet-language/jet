// Native unit outcomes and reporting use the one E4 text carrier. The Rust
// tier keeps TEST_PRELUDE; the native pack replaces only these exports.
// Outcome layout: [flags, owned name, owned stdout, owned stderr] (32 bytes).
// Flags: ok=1, expected_failure=2, skipped=4. No property engine is present;
// property rows are refused by the producer and by this wire consumer.
// Capture is in TestCapture; unit invocation still needs L8a's stop boundary.

fn test_text_new(length: I64) -> I64 {
    text :: jet_rt_alloc(I64{24}, I64{8})
    data :: if (length == I64{0}) -> I64{1} else -> jet_rt_alloc(length, I64{1})
    trap_store(text, data)
    trap_store(text + I64{8}, length)
    trap_store(text + I64{16}, length)
    text
}

fn test_copy_bytes(destination: I64, source: I64, length: I64) {
    at := I64{0}
    loop at < length {
        trap_put(destination + at, trap_byte(source + at))
        at += I64{1}
    }
}

fn test_text_clone(text: I64) -> I64 {
    length :: trap_word(text + I64{8})
    cloned :: test_text_new(length)
    test_copy_bytes(trap_word(cloned), trap_word(text), length)
    cloned
}

fn test_text_drop(text: I64) {
    if (text == I64{0}) {
        return
    }
    capacity :: trap_word(text + I64{16})
    if (capacity != I64{0}) { jet_rt_free(trap_word(text), capacity, I64{1}) }
    jet_rt_free(text, I64{24}, I64{8})
}

// name is borrowed. stdout and error are owned; null error denotes success.
// The remaining task adapter collects capture/skip and transfers these handles.
#Export(c) fn jet_rt_test_unit_outcome(name: I64, expected: Bool, skipped: Bool, stdout: I64, error: I64) -> I64 {
    failed :: error != I64{0}
    ok :: skipped || failed == expected
    flags :: (if ok -> I64{1} else -> I64{0}).bit_or((if expected -> I64{2} else -> I64{0})).bit_or((if skipped -> I64{4} else -> I64{0}))
    outcome :: jet_rt_alloc(I64{32}, I64{8})
    trap_store(outcome, flags)
    trap_store(outcome + I64{8}, test_text_clone(name))
    trap_store(outcome + I64{16}, stdout)
    trap_store(outcome + I64{24}, if failed -> error else -> test_text_new(I64{0}))
    outcome
}

fn test_decimal_bytes(destination: I64, value: I64) -> I64 {
    divisor := I64{1}
    loop divisor <= value /% (I64{10}) -> divisor *= I64{10}
    number := value
    used := I64{0}
    loop {
        trap_put(destination + used, I64{48} + number /% divisor)
        used += I64{1}
        number %= divisor
        divisor = divisor /% I64{10}
        if (divisor == I64{0}) { break }
    }
    used
}

#Export(c) fn jet_rt_test_outcome_wire(outcome: I64) -> I64 {
    name :: trap_word(outcome + I64{8})
    stdout :: trap_word(outcome + I64{16})
    stderr :: trap_word(outcome + I64{24})
    name_len :: trap_word(name + I64{8})
    stdout_len :: trap_word(stdout + I64{8})
    stderr_len :: trap_word(stderr + I64{8})
    // At most 3*19 decimal length digits + flags + separators + '-\n'.
    wire :: test_text_new(I64{64} + name_len + stdout_len + stderr_len)
    data :: trap_word(wire)
    used := test_decimal_bytes(data, trap_word(outcome))
    trap_put(data + used, I64{32})
    used += I64{1}
    used += test_decimal_bytes(data + used, name_len)
    trap_put(data + used, I64{32})
    used += I64{1}
    used += test_decimal_bytes(data + used, stdout_len)
    trap_put(data + used, I64{32})
    used += I64{1}
    used += test_decimal_bytes(data + used, stderr_len)
    trap_put(data + used, I64{32})
    trap_put(data + used + I64{1}, I64{45})
    trap_put(data + used + I64{2}, I64{10})
    used += I64{3}
    test_copy_bytes(data + used, trap_word(name), name_len)
    used += name_len
    test_copy_bytes(data + used, trap_word(stdout), stdout_len)
    used += stdout_len
    test_copy_bytes(data + used, trap_word(stderr), stderr_len)
    used += stderr_len
    trap_store(wire + I64{8}, used)
    jet_rt_test_outcome_drop(outcome)
    wire
}

#Export(c) fn jet_rt_test_outcome_drop(outcome: I64) {
    test_text_drop(trap_word(outcome + I64{8}))
    test_text_drop(trap_word(outcome + I64{16}))
    test_text_drop(trap_word(outcome + I64{24}))
    jet_rt_free(outcome, I64{32}, I64{8})
}

fn test_write_word(fd: I64, word: I64, length: I64) {
    if (fd == I64{2}) {
        trap_write_word(word, length)
        return
    }
    bytes := word
    remaining := length
    loop remaining > (I64{0}) {
        written := I64{0}
        #Unsafe("the OS leaf borrows at most eight initialized bytes from its own stack word") {
            written = os_write_word_i64(fd, bytes, remaining)
        }
        if (written == I64{-4}) { next }
        if (written <= I64{0} || written >= remaining) {
            return
        }
        bytes >>= written * I64{8}
        remaining -= written
    }
}

fn test_write(fd: I64, address: I64, length: I64) {
    if (fd == I64{2}) {
        trap_write(address, length)
        return
    }
    at := I64{0}
    loop at < length {
        written :: trap_syscall(I64{1}, fd, address + at, length - at, I64{0}, I64{0}, I64{0})
        if (written == I64{-4}) { next }
        if (written <= I64{0}) {
            return
        }
        at += written
    }
}

fn test_number(value: I64) {
    divisor := I64{1}
    loop divisor <= value /% (I64{10}) -> divisor *= I64{10}
    number := value
    loop {
        test_write_word(I64{1}, I64{48} + number /% divisor, I64{1})
        number %= divisor
        divisor = divisor /% I64{10}
        if (divisor == I64{0}) { break }
    }
}

// Malformed wires are internal host-corruption paths, never user diagnostics.
// Their single defect message deliberately replaces Rust's per-field invariant
// panic prose; valid unit outcomes retain byte-identical product reports.
fn test_invalid() {
    trap_defect_prepare()
    test_msg_invalid(I64{2})
    trap_defect_exit(I64{101})
}

// Header parsing is bounded by the borrowed wire, not a sentinel. A record
// descriptor holds flags, then pointer/length pairs, then the next byte offset.
fn test_parse_number(data: I64, end: I64, cursor: I64) -> I64 {
    at := trap_word(cursor)
    if (at < end && trap_byte(data + at) == I64{43}) { at += I64{1} }
    start :: at
    value := I64{0}
    loop at < end {
        byte :: trap_byte(data + at)
        if (byte == I64{32}) { break }
        if (byte < I64{48} || byte > I64{57}) {
            test_invalid()
            return I64{0}
        }
        digit :: byte - I64{48}
        if (value > (I64{9223372036854775807} - digit) /% I64{10}) {
            test_invalid()
            return I64{0}
        }
        value = value * I64{10} + digit
        at += I64{1}
    }
    if (at == start || at >= end) {
        test_invalid()
        return I64{0}
    }
    trap_store(cursor, at + I64{1})
    value
}

fn test_utf8(data: I64, length: I64) -> Bool {
    at := I64{0}
    loop at < length {
        first :: trap_byte(data + at)
        width := I64{1}
        low := I64{128}
        high := I64{191}
        if {
            (first >= I64{194} && first <= I64{223}) -> width = I64{2}
            (first >= I64{224} && first <= I64{239}) -> {
                width = I64{3}
                if (first == I64{224}) { low = I64{160} }
                if (first == I64{237}) { high = I64{159} }
            }
            (first >= I64{240} && first <= I64{244}) -> {
                width = I64{4}
                if (first == I64{240}) { low = I64{144} }
                if (first == I64{244}) { high = I64{143} }
            }
            (first >= I64{128}) -> return false
        }
        if (width > length - at) { return false }
        if (width > I64{1}) {
            second :: trap_byte(data + at + I64{1})
            if (second < low || second > high) { return false }
        }
        part := I64{2}
        loop part < width {
            byte :: trap_byte(data + at + part)
            if (byte < I64{128} || byte > I64{191}) { return false }
            part += I64{1}
        }
        at += width
    }
    true
}

fn test_parse_record(data: I64, end: I64, start: I64, record: I64) {
    cursor :: record + I64{56}
    trap_store(cursor, start)
    flags :: test_parse_number(data, end, cursor)
    if (flags >= I64{8}) {
        test_invalid()
        return
    }
    trap_store(record, flags)
    name_len :: test_parse_number(data, end, cursor)
    stdout_len :: test_parse_number(data, end, cursor)
    stderr_len :: test_parse_number(data, end, cursor)
    at := trap_word(cursor)
    if (end - at < I64{2}) {
        test_invalid()
        return
    }
    if (trap_byte(data + at) != I64{45}) {
        trap_root_prepare()
        test_msg_property_gap(I64{2})
        jet_rt_process_exit_finish()
        return
    }
    if (trap_byte(data + at + I64{1}) != I64{10}) {
        test_invalid()
        return
    }
    at += I64{2}
    if (name_len > end - at) {
        test_invalid()
        return
    }
    trap_store(record + I64{8}, data + at)
    trap_store(record + I64{16}, name_len)
    at += name_len
    if (stdout_len > end - at) {
        test_invalid()
        return
    }
    trap_store(record + I64{24}, data + at)
    trap_store(record + I64{32}, stdout_len)
    at += stdout_len
    if (stderr_len > end - at) {
        test_invalid()
        return
    }
    trap_store(record + I64{40}, data + at)
    trap_store(record + I64{48}, stderr_len)
    at += stderr_len
    if (!test_utf8(trap_word(record + I64{8}), name_len) || !test_utf8(trap_word(record + I64{24}), stdout_len) || !test_utf8(trap_word(record + I64{40}), stderr_len)) {
        test_invalid()
        return
    }
    trap_store(cursor, at)
}

fn test_environment(key: I64) -> I64 {
    slot :: jet_rt_alloc(I64{8}, I64{8})
    trap_store(slot, I64{0})
    present :: jet_std_env_get(key, slot)
    value :: if (present != I64{0}) -> trap_word(slot) else -> I64{0}
    jet_rt_free(slot, I64{8}, I64{8})
    test_text_drop(key)
    value
}

fn test_capture_mode() -> I64 {
    value :: test_environment(test_key_capture())
    if (value == I64{0}) { return I64{0} }
    data :: trap_word(value)
    length :: trap_word(value + I64{8})
    mode := I64{0}
    if (length == I64{3} && trap_byte(data) == I64{97} && trap_byte(data + I64{1}) == I64{108} && trap_byte(data + I64{2}) == I64{108}) {
        mode = I64{1}
    }
    if (length == I64{4} && trap_byte(data) == I64{110} && trap_byte(data + I64{1}) == I64{111} && trap_byte(data + I64{2}) == I64{110} && trap_byte(data + I64{3}) == I64{101}) {
        mode = I64{2}
    }
    test_text_drop(value)
    mode
}

fn test_capture(mode: I64, flags: I64) -> Bool {
    mode == I64{1} || (mode == I64{0} && (flags.bit_and(I64{1})) == I64{0})
}

fn test_hex(value: I64) -> I64 { if (value < I64{10}) -> I64{48} + value else -> I64{87} + value }

fn test_json_quote(data: I64, length: I64) {
    test_write_word(I64{1}, I64{34}, I64{1})
    at := I64{0}
    plain := I64{0}
    loop at < length {
        byte :: trap_byte(data + at)
        control := byte
        width := I64{1}
        if (byte == I64{194} && at + I64{1} < length) {
            second :: trap_byte(data + at + I64{1})
            if (second <= I64{159}) {
                control = second
                width = I64{2}
            }
        }
        escaped :: byte == I64{34} || byte == I64{92} || control < I64{32} || byte == I64{127} || width == I64{2}
        if {
            escaped -> {
                test_write(I64{1}, data + plain, at - plain)
                test_write_word(I64{1}, I64{92}, I64{1})
                if {
                    (byte == I64{34} || byte == I64{92}) -> test_write_word(I64{1}, byte, I64{1})
                    (byte == I64{10}) -> test_write_word(I64{1}, I64{110}, I64{1})
                    (byte == I64{13}) -> test_write_word(I64{1}, I64{114}, I64{1})
                    (byte == I64{9}) -> test_write_word(I64{1}, I64{116}, I64{1})
                    else -> {
                        test_write_word(I64{1}, I64{3158133}, I64{3})
                        test_write_word(I64{1}, test_hex(control /% I64{16}), I64{1})
                        test_write_word(I64{1}, test_hex(control % I64{16}), I64{1})
                    }
                }
                at += width
                plain = at
            }
            else -> at += I64{1}
        }
    }
    test_write(I64{1}, data + plain, length - plain)
    test_write_word(I64{1}, I64{34}, I64{1})
}

fn test_bool(value: Bool) {
    if value -> test_msg_true(I64{1}) else -> test_msg_false(I64{1})
}

fn test_report_json(record: I64, capture: I64) {
    flags :: trap_word(record)
    test_msg_json_name(I64{1})
    test_json_quote(trap_word(record + I64{8}), trap_word(record + I64{16}))
    test_msg_json_ok(I64{1})
    test_bool((flags.bit_and(I64{1})) != I64{0})
    test_msg_json_expectation(I64{1})
    test_bool((flags.bit_and(I64{2})) != I64{0})
    test_msg_json_skip(I64{1})
    test_bool((flags.bit_and(I64{4})) != I64{0})
    shown :: test_capture(capture, flags)
    test_msg_json_stdout(I64{1})
    test_json_quote(trap_word(record + I64{24}), if shown -> trap_word(record + I64{32}) else -> I64{0})
    test_msg_json_stderr(I64{1})
    test_json_quote(trap_word(record + I64{40}), if shown -> trap_word(record + I64{48}) else -> I64{0})
    test_write_word(I64{1}, I64{125}, I64{1})
}

fn test_report_text(record: I64, capture: I64) {
    flags :: trap_word(record)
    if test_capture(capture, flags) {
        test_write(I64{1}, trap_word(record + I64{24}), trap_word(record + I64{32}))
        stderr_len :: trap_word(record + I64{48})
        if (stderr_len != I64{0}) {
            test_write(I64{2}, trap_word(record + I64{40}), stderr_len)
            test_write_word(I64{2}, I64{10}, I64{1})
        }
    }
    test_write(I64{1}, trap_word(record + I64{8}), trap_word(record + I64{16}))
    test_write_word(I64{1}, I64{8250}, I64{2})
    if {
        ((flags.bit_and(I64{4})) != I64{0}) -> test_msg_skip(I64{1})
        ((flags.bit_and(I64{2})) != I64{0}) -> {
            if {
                ((flags.bit_and(I64{1})) != I64{0}) -> test_msg_expected(I64{1})
                else -> test_msg_unexpected(I64{1})
            }
        }
        else -> {
            if ((flags.bit_and(I64{1})) != I64{0}) -> test_msg_pass(I64{1}) else -> test_msg_fail(I64{1})
        }
    }
    test_write_word(I64{1}, I64{10}, I64{1})
}

// Borrow wire; validate all records before emitting anything, just as the
// canonical Rust consumer builds its complete outcome list before finishing.
#Export(c) fn jet_rt_test_finish_wire(wire: I64) -> Bool {
    data :: trap_word(wire)
    end :: trap_word(wire + I64{8})
    record :: jet_rt_alloc(I64{64}, I64{8})
    at := I64{0}
    passed := I64{0}
    failed := I64{0}
    skipped := I64{0}
    expected := I64{0}
    unexpected := I64{0}
    ok := true
    loop at < end {
        test_parse_record(data, end, at, record)
        flags :: trap_word(record)
        if {
            ((flags.bit_and(I64{4})) != I64{0}) -> skipped += I64{1}
            ((flags.bit_and(I64{2})) != I64{0}) -> {
                if ((flags.bit_and(I64{1})) != I64{0}) -> expected += I64{1} else -> unexpected += I64{1}
            }
            else -> {
                if ((flags.bit_and(I64{1})) != I64{0}) -> passed += I64{1} else -> failed += I64{1}
            }
        }
        if ((flags.bit_and(I64{5})) == I64{0}) { ok = false }
        at = trap_word(record + I64{56})
    }
    json_key :: test_key_json()
    json :: jet_rt_env_present(json_key)
    test_text_drop(json_key)
    capture :: test_capture_mode()
    if {
        json -> {
            test_msg_json_schema(I64{1})
            test_bool(ok)
            test_msg_json_passed(I64{1})
            test_number(passed)
            test_msg_json_failed(I64{1})
            test_number(failed)
            test_msg_json_skipped(I64{1})
            test_number(skipped)
            test_msg_json_expected(I64{1})
            test_number(expected)
            test_msg_json_unexpected(I64{1})
            test_number(unexpected)
            test_msg_json_tests(I64{1})
        }
        else -> test_report_shuffle()
    }
    at = I64{0}
    loop at < end {
        test_parse_record(data, end, at, record)
        if {
            json -> {
                if (at != I64{0}) { test_write_word(I64{1}, I64{44}, I64{1}) }
                test_report_json(record, capture)
            }
            else -> test_report_text(record, capture)
        }
        at = trap_word(record + I64{56})
    }
    if json -> test_write_word(I64{1}, I64{687453}, I64{3}) else {
        test_number(passed)
        test_msg_passed(I64{1})
        test_number(failed)
        test_msg_failed(I64{1})
        test_number(skipped)
        test_msg_skipped(I64{1})
        if (expected != I64{0}) {
            test_write_word(I64{1}, I64{8236}, I64{2})
            test_number(expected)
            test_msg_expected_count(I64{1})
        }
        if (unexpected != I64{0}) {
            test_write_word(I64{1}, I64{8236}, I64{2})
            test_number(unexpected)
            test_msg_unexpected_count(I64{1})
        }
        test_write_word(I64{1}, I64{10}, I64{1})
    }
    jet_rt_free(record, I64{64}, I64{8})
    ok
}

// Seeds are full u64, including values above I64.MAX. Validate overflow with
// lexicographic comparison to MAX, then print canonical digits without an Int.
fn test_report_shuffle() {
    seed :: test_environment(test_key_shuffle())
    if (seed == I64{0}) {
        return
    }
    data :: trap_word(seed)
    end :: trap_word(seed + I64{8})
    at := I64{0}
    if (end > I64{0} && trap_byte(data) == I64{43}) { at = I64{1} }
    valid := at < end
    loop at < end && trap_byte(data + at) == (I64{48}) -> at += I64{1}
    first :: at
    loop at < end {
        byte :: trap_byte(data + at)
        if (byte < I64{48} || byte > I64{57}) { valid = false }
        at += I64{1}
    }
    digits :: end - first
    if (digits > I64{20}) { valid = false }
    if (valid && digits == I64{20}) {
        // ASCII bytes of 18446744073709551615, split into three words.
        at = I64{0}
        decided := false
        loop at < (I64{20}) && !decided {
            word :: if {
                (at < I64{8}) -> I64{3761692294704805937}
                (at < I64{16}) -> I64{3834033537023162160}
                else -> I64{892417585}
            }
            shift :: (at % I64{8}) * I64{8}
            maximum :: (word >> shift).bit_and(I64{255})
            actual :: trap_byte(data + first + at)
            if (actual > maximum) { valid = false }
            if (actual != maximum) { decided = true }
            at += I64{1}
        }
    }
    if valid {
        test_msg_shuffle(I64{1})
        if {
            (digits == I64{0}) -> test_write_word(I64{1}, I64{48}, I64{1})
            else -> test_write(I64{1}, data + first, digits)
        }
        test_write_word(I64{1}, I64{10}, I64{1})
    }
    test_text_drop(seed)
}
