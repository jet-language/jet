// Owned descriptors and shared memory for core.sys `Fd` and `SharedMemory`
// and the descriptors core.net passes over Unix sockets.
//
// No descriptor number or mapping address reaches Jet: every one lives in
// this process-wide table and Core holds only a token, (generation << 20) |
// index. A token whose entry was closed or never issued names nothing, so
// each leaf refuses it with EBADF instead of touching another descriptor.
// Core owns each token once (its Fd/SharedMemory Close returns it), checks
// every range first, and the leaves check them again against the entry.
//
// Hazards closed by construction: every descriptor is O_CLOEXEC; shared
// memory is a memfd sealed against shrinking and growing once sized, so no
// peer can truncate it under the mapping (SIGBUS); descriptors received from
// a peer are never mapped, only read with pread; pipes are read and written
// only once ppoll says they are ready, so a stalled peer costs at most the
// caller's timeout; every syscall retries EINTR.

HOST_DESCRIPTOR_ENTRY: I64{32}
HOST_DESCRIPTOR_INDEX_BITS: I64{20}
HOST_DESCRIPTOR_INDEX_MASK: I64{1048575}
HOST_SHARED_MAX: I64{1073741824}
HOST_READ_MAX: I64{16777216}

// Header: +0 mutex, +8 entries, +16 capacity, +24 issued entries. Entry:
// +0 descriptor (-1 when free), +8 mapping address (0 when unmapped),
// +16 mapping size, +24 generation.
host_descriptor_table := I64{0}

// runtime-init: 20 when host_descriptor_table
#Export(c) jet_rt_descriptor_table_init: fn() {
    if (host_descriptor_table != I64{0}) -> return
    table: jet_rt_alloc(I64{32}, I64{8})
    thread_zero(table, I64{32})
    #Unsafe("runtime-init runs before any other thread exists") {
        host_descriptor_table = table
    }
}

host_descriptor_entry_at: fn(index: I64) -> I64 {
    wrapping(net_word(host_descriptor_table, I64{8}) + index * HOST_DESCRIPTOR_ENTRY)
}

// The entry a live token names, or 0. The caller holds the table mutex.
host_descriptor_find: fn(token: I64) -> I64 {
    if (token <= I64{0}) -> return I64{0}
    index: token.bit_and(HOST_DESCRIPTOR_INDEX_MASK)
    if (index >= net_word(host_descriptor_table, I64{24})) -> return I64{0}
    entry: host_descriptor_entry_at(index)
    if (net_word(entry, I64{0}) < I64{0}) -> return I64{0}
    if (net_word(entry, I64{24}) != (token >> HOST_DESCRIPTOR_INDEX_BITS)) -> return I64{0}
    entry
}

// Files `descriptor` (and its mapping) and returns its token, or -1 when the
// table cannot grow; the caller then still owns `descriptor`.
host_descriptor_insert: fn(descriptor: I64, address: I64, size: I64) -> I64 {
    sync_mutex_lock(host_descriptor_table)
    issued: net_word(host_descriptor_table, I64{24})
    index := I64{0}
    loop index < issued && net_word(host_descriptor_entry_at(index), I64{0}) >= (I64{0}) {
        index += I64{1}
    }
    if (index == issued) {
        capacity: net_word(host_descriptor_table, I64{16})
        if (issued == capacity) {
            grown: if (capacity == I64{0}) -> I64{16} else -> capacity * I64{2}
            if (grown > HOST_DESCRIPTOR_INDEX_MASK) {
                sync_mutex_unlock(host_descriptor_table)
                return I64{-1}
            }
            entries: jet_rt_alloc(grown * HOST_DESCRIPTOR_ENTRY, I64{8})
            old: net_word(host_descriptor_table, I64{8})
            if (capacity > I64{0}) {
                rt_text_bytes_copy(entries, old, capacity * HOST_DESCRIPTOR_ENTRY)
                jet_rt_free(old, capacity * HOST_DESCRIPTOR_ENTRY, I64{8})
            }
            net_put(host_descriptor_table, I64{8}, entries)
            net_put(host_descriptor_table, I64{16}, grown)
        }
        net_put(host_descriptor_entry_at(index), I64{24}, I64{0})
        net_put(host_descriptor_table, I64{24}, issued + I64{1})
    }
    entry: host_descriptor_entry_at(index)
    generation: net_word(entry, I64{24}) + I64{1}
    net_put(entry, I64{0}, descriptor)
    net_put(entry, I64{8}, address)
    net_put(entry, I64{16}, size)
    net_put(entry, I64{24}, generation)
    sync_mutex_unlock(host_descriptor_table)
    (generation << HOST_DESCRIPTOR_INDEX_BITS).bit_or(index)
}

// Copies the live entry of `token` into the three words at `out`
// (descriptor, address, size); false when the token names nothing.
host_descriptor_read: fn(token: I64, out: I64) -> Bool {
    sync_mutex_lock(host_descriptor_table)
    entry: host_descriptor_find(token)
    if (entry != I64{0}) {
        net_put(out, I64{0}, net_word(entry, I64{0}))
        net_put(out, I64{8}, net_word(entry, I64{8}))
        net_put(out, I64{16}, net_word(entry, I64{16}))
    }
    sync_mutex_unlock(host_descriptor_table)
    entry != I64{0}
}

// The descriptor `token` names, or -1.
host_descriptor_number: fn(token: I64) -> I64 {
    out: jet_rt_alloc(I64{24}, I64{8})
    descriptor: if host_descriptor_read(token, out) -> net_word(out, I64{0}) else -> I64{-1}
    jet_rt_free(out, I64{24}, I64{8})
    descriptor
}

// Unmaps and closes what `token` names and retires the token.
host_descriptor_release: fn(token: I64) {
    sync_mutex_lock(host_descriptor_table)
    entry: host_descriptor_find(token)
    descriptor := I64{-1}
    address := I64{0}
    size := I64{0}
    if (entry != I64{0}) {
        descriptor = net_word(entry, I64{0})
        address = net_word(entry, I64{8})
        size = net_word(entry, I64{16})
        net_put(entry, I64{0}, I64{-1})
        net_put(entry, I64{8}, I64{0})
        net_put(entry, I64{16}, I64{0})
    }
    sync_mutex_unlock(host_descriptor_table)
    if (address != I64{0}) {
        #Unsafe("the retired entry owned this mapping of exactly `size` bytes and no token names it now") {
            _ := os_syscall_i64(I64{11}, address, size, I64{0}, I64{0}, I64{0}, I64{0})
        }
    }
    // close is not retried: Linux releases the descriptor even when it reports EINTR.
    if (descriptor >= I64{0}) -> _ := host_call(I64{3}, descriptor, I64{0}, I64{0})
}

host_descriptor_closed: fn(operation: I64, error: I64) -> I64 { compiler_fs_errno(operation, I64{0}, I64{9}, error) }

host_descriptor_range: fn(operation: I64, error: I64) -> I64 { compiler_fs_errno(operation, I64{0}, I64{22}, error) }

// A syscall through host_call, retried while it reports EINTR.
host_call_restarting: fn(number: I64, a1: I64, a2: I64, a3: I64) -> I64 {
    result := I64{-4}
    loop result == (I64{-4}) { result = host_call(number, a1, a2, a3) }
    result
}

#Export(c) jet_sys_fd_close_raw: fn(token: I64) {
    native: host_native_int(token)
    if (jet_scheduler_native_propagate() != I64{0}) -> return
    host_descriptor_release(native)
}

// pread of at most min(limit, 16 MiB) bytes at `offset`; fewer at end of file.
#Export(c) jet_sys_fd_read_at_raw: fn(token: I64, offset: I64, limit: I64, output: I64, length: I64, error: I64) -> I64 {
    native: host_native_int(token)
    at: host_native_int(offset)
    requested: host_native_int(limit)
    if (jet_scheduler_native_propagate() != I64{0}) -> return I64{0}
    if (at < I64{0} || requested < I64{1}) -> return host_descriptor_range(HOST_IO_OP_READ, error)
    descriptor: host_descriptor_number(native)
    if (descriptor < I64{0}) -> return host_descriptor_closed(HOST_IO_OP_READ, error)
    cap: if (requested < HOST_READ_MAX) -> requested else -> HOST_READ_MAX
    bytes: jet_rt_alloc_8(cap)
    count := I64{-4}
    loop count == (I64{-4}) {
        #Unsafe("bytes owns cap writable bytes; pread retains no pointer and the caller's Fd keeps the descriptor open") {
            count = os_syscall_i64(I64{17}, descriptor, bytes, cap, at, I64{0}, I64{0})
        }
    }
    if (count < I64{0}) {
        jet_rt_free_8(bytes, cap)
        return compiler_fs_errno(HOST_IO_OP_READ, I64{0}, -count, error)
    }
    compiler_fs_bytes_take(bytes, cap, count, output, length)
    I64{1}
}

// fstat st_size.
#Export(c) jet_sys_fd_size_raw: fn(token: I64, output: I64, error: I64) -> I64 {
    native: host_native_int(token)
    if (jet_scheduler_native_propagate() != I64{0}) -> return I64{0}
    descriptor: host_descriptor_number(native)
    if (descriptor < I64{0}) -> return host_descriptor_closed(HOST_IO_OP_READ, error)
    stat: jet_rt_alloc(I64{144}, I64{8})
    result: host_call_restarting(I64{5}, descriptor, stat, I64{0})
    size: net_word(stat, I64{48})
    jet_rt_free(stat, I64{144}, I64{8})
    if (result < I64{0}) -> return compiler_fs_errno(HOST_IO_OP_READ, I64{0}, -result, error)
    rt_text_store(output, jet_int_owned_from_i64(size))
    I64{1}
}

// fcntl(F_DUPFD_CLOEXEC, 3): a second descriptor for the same open file
// under its own token, never mapped.
#Export(c) jet_sys_fd_duplicate_raw: fn(token: I64, output: I64, error: I64) -> I64 {
    native: host_native_int(token)
    if (jet_scheduler_native_propagate() != I64{0}) -> return I64{0}
    descriptor: host_descriptor_number(native)
    if (descriptor < I64{0}) -> return host_descriptor_closed(HOST_IO_OP_READ, error)
    copied: host_call_restarting(I64{72}, descriptor, I64{1030}, I64{3})
    if (copied < I64{0}) -> return compiler_fs_errno(HOST_IO_OP_READ, I64{0}, -copied, error)
    filed: host_descriptor_insert(copied, I64{0}, I64{0})
    if (filed < I64{0}) {
        _ := host_call(I64{3}, copied, I64{0}, I64{0})
        return compiler_fs_errno(HOST_IO_OP_READ, I64{0}, I64{24}, error)
    }
    rt_text_store(output, jet_int_owned_from_i64(filed))
    I64{1}
}

// pipe2(O_CLOEXEC): the read end's token, then the write end's, as eight
// little-endian bytes each. Both ends block, so a peer handed one sees an
// ordinary pipe; jet_sys_fd_read_raw and jet_sys_fd_write_raw wait in
// ppoll first, so neither blocks past its timeout.
#Export(c) jet_sys_fd_pipe_raw: fn(output: I64, length: I64, error: I64) -> I64 {
    if (jet_scheduler_native_propagate() != I64{0}) -> return I64{0}
    ends: jet_rt_alloc(I64{8}, I64{8})
    thread_zero(ends, I64{8})
    made: host_call_restarting(I64{293}, ends, I64{524288}, I64{0})
    reader: net_load_uint(ends, I64{4})
    writer: net_load_uint(wrapping(ends + I64{4}), I64{4})
    jet_rt_free(ends, I64{8}, I64{8})
    if (made < I64{0}) -> return compiler_fs_errno(HOST_IO_OP_READ, I64{0}, -made, error)
    host_descriptor_pair_take(reader, writer, I64{0}, I64{2}, output, length, error)
}

// socketpair(AF_UNIX, SOCK_STREAM | SOCK_CLOEXEC): two connected blocking
// stream ends, as pipe's two tokens. Each end reads what the other writes.
#Export(c) jet_sys_fd_socket_pair_raw: fn(output: I64, length: I64, error: I64) -> I64 {
    if (jet_scheduler_native_propagate() != I64{0}) -> return I64{0}
    ends: jet_rt_alloc(I64{8}, I64{8})
    thread_zero(ends, I64{8})
    made: host_call4(I64{53}, I64{1}, I64{524289}, I64{0}, ends)
    first: net_load_uint(ends, I64{4})
    second: net_load_uint(wrapping(ends + I64{4}), I64{4})
    jet_rt_free(ends, I64{8}, I64{8})
    if (made < I64{0}) -> return compiler_fs_errno(HOST_IO_OP_READ, I64{0}, -made, error)
    host_descriptor_pair_take(first, second, I64{0}, I64{2}, output, length, error)
}

// posix_openpt(O_RDWR | O_NOCTTY | O_CLOEXEC), unlockpt and the secondary
// opened through TIOCGPTPEER (as spawn_pty does, without the process-global
// ptsname buffer): the primary's token, the secondary's token and the pts
// number, eight little-endian bytes each.
#Export(c) jet_sys_fd_pseudoterminal_raw: fn(output: I64, length: I64, error: I64) -> I64 {
    if (jet_scheduler_native_propagate() != I64{0}) -> return I64{0}
    // "/dev/ptmx\0" at 0, the ioctl int at 16.
    scratch: jet_rt_alloc(I64{24}, I64{8})
    thread_zero(scratch, I64{24})
    net_store_uint(scratch, I64{8}, I64{7887052196584711215})
    net_store_uint(wrapping(scratch + I64{8}), I64{8}, I64{120})
    primary: host_call4(I64{257}, I64{-100}, scratch, I64{524546}, I64{0})
    if (primary < I64{0}) {
        jet_rt_free(scratch, I64{24}, I64{8})
        return compiler_fs_errno(HOST_IO_OP_READ, I64{0}, -primary, error)
    }
    result := host_call(I64{16}, primary, I64{1074025521}, wrapping(scratch + I64{16}))
    if (result == I64{0}) {
        result = host_call(I64{16}, primary, I64{2147767344}, wrapping(scratch + I64{16}))
    }
    number: net_load_uint(wrapping(scratch + I64{16}), I64{4})
    jet_rt_free(scratch, I64{24}, I64{8})
    secondary: if (result < I64{0}) -> result else -> host_call(I64{16}, primary, I64{21569}, I64{524546})
    if (secondary < I64{0}) {
        _ := host_call(I64{3}, primary, I64{0}, I64{0})
        return compiler_fs_errno(HOST_IO_OP_READ, I64{0}, -secondary, error)
    }
    host_descriptor_pair_take(primary, secondary, number, I64{3}, output, length, error)
}

// Files the fresh descriptors `first` and `second` under tokens and hands
// back their tokens, then `extra` when `words` is 3, as eight little-endian
// bytes each. When the table is full, both descriptors are closed: EMFILE.
host_descriptor_pair_take: fn(first: I64, second: I64, extra: I64, words: I64, output: I64, length: I64, error: I64) -> I64 {
    first_token: host_descriptor_insert(first, I64{0}, I64{0})
    if (first_token < I64{0}) {
        _ := host_call(I64{3}, first, I64{0}, I64{0})
        _ := host_call(I64{3}, second, I64{0}, I64{0})
        return compiler_fs_errno(HOST_IO_OP_READ, I64{0}, I64{24}, error)
    }
    second_token: host_descriptor_insert(second, I64{0}, I64{0})
    if (second_token < I64{0}) {
        host_descriptor_release(first_token)
        _ := host_call(I64{3}, second, I64{0}, I64{0})
        return compiler_fs_errno(HOST_IO_OP_READ, I64{0}, I64{24}, error)
    }
    size: words * I64{8}
    bytes: jet_rt_alloc_8(size)
    net_store_uint(bytes, I64{8}, first_token)
    net_store_uint(wrapping(bytes + I64{8}), I64{8}, second_token)
    if (words == I64{3}) -> net_store_uint(wrapping(bytes + I64{16}), I64{8}, extra)
    compiler_fs_bytes_take(bytes, size, size, output, length)
    I64{1}
}

// Waits on the calling OS thread until `descriptor` has `events` (POLLIN
// 1, POLLOUT 4), hangs up or fails, or `limit` nanoseconds pass; a
// negative limit waits without one. 1 when ready (the read or write then
// says which), 0 when the time ran out, else -errno. EINTR is retried
// with the time left.
host_descriptor_wait: fn(descriptor: I64, events: I64, limit: I64) -> I64 {
    // pollfd at 0, timespec at 8, clock sample at 24.
    scratch: jet_rt_alloc(I64{40}, I64{8})
    end := I64{-1}
    if (limit >= I64{0}) {
        sync_clock_read(I64{1}, wrapping(scratch + I64{24}))
        now: net_word(scratch, I64{24}) * I64{1000000000} + net_word(scratch, I64{32})
        end = if (limit > I64{9223372036854775807} - now) -> I64{9223372036854775807} else -> now + limit
    }
    ready := I64{-4}
    loop ready == (I64{-4}) {
        left := I64{-1}
        if (end >= I64{0}) {
            sync_clock_read(I64{1}, wrapping(scratch + I64{24}))
            now: net_word(scratch, I64{24}) * I64{1000000000} + net_word(scratch, I64{32})
            left = if (end > now) -> end - now else -> I64{0}
            net_put(scratch, I64{8}, left /% I64{1000000000})
            net_put(scratch, I64{16}, left %% I64{1000000000})
        }
        // struct pollfd {fd, events} with revents cleared.
        net_put(scratch, I64{0}, descriptor.bit_and(I64{4294967295}).bit_or(events << I64{32}))
        #Unsafe("scratch lends the pollfd and timespec and ppoll retains neither; the caller's Fd keeps the descriptor open") {
            ready = os_syscall_i64(I64{271}, scratch, I64{1}, if (left < I64{0}) -> I64{0} else -> wrapping(scratch + I64{8}), I64{0}, I64{8}, I64{0})
        }
    }
    jet_rt_free(scratch, I64{40}, I64{8})
    if (ready > I64{0}) -> I64{1} else -> ready
}

// One read of at most min(limit, 16 MiB) bytes once the descriptor is
// readable, waiting at most `timeout` nanoseconds (negative: without
// limit). An empty list is end of stream; a wait that runs out fails with
// ETIMEDOUT.
#Export(c) jet_sys_fd_read_raw: fn(token: I64, limit: I64, timeout: I64, output: I64, length: I64, error: I64) -> I64 {
    native: host_native_int(token)
    requested: host_native_int(limit)
    wait: host_native_int(timeout)
    if (jet_scheduler_native_propagate() != I64{0}) -> return I64{0}
    if (requested < I64{1}) -> return host_descriptor_range(HOST_IO_OP_READ, error)
    descriptor: host_descriptor_number(native)
    if (descriptor < I64{0}) -> return host_descriptor_closed(HOST_IO_OP_READ, error)
    ready: host_descriptor_wait(descriptor, I64{1}, wait)
    if (ready < I64{0}) -> return compiler_fs_errno(HOST_IO_OP_READ, I64{0}, -ready, error)
    if (ready == I64{0}) -> return compiler_fs_errno(HOST_IO_OP_READ, I64{0}, I64{110}, error)
    cap: if (requested < HOST_READ_MAX) -> requested else -> HOST_READ_MAX
    bytes: jet_rt_alloc_8(cap)
    count := I64{-4}
    loop count == (I64{-4}) {
        #Unsafe("bytes owns cap writable bytes; read retains no pointer and the caller's Fd keeps the descriptor open") {
            count = os_syscall_i64(I64{0}, descriptor, bytes, cap, I64{0}, I64{0}, I64{0})
        }
    }
    if (count < I64{0}) {
        jet_rt_free_8(bytes, cap)
        return compiler_fs_errno(HOST_IO_OP_READ, I64{0}, -count, error)
    }
    compiler_fs_bytes_take(bytes, cap, count, output, length)
    I64{1}
}

// One write of at most PIPE_BUF (4096) bytes once the descriptor is
// writable, waiting at most `timeout` nanoseconds (negative: without
// limit): a pipe takes that much whole once it polls writable, so the
// write never blocks. The result is the count written; a wait that runs
// out fails with ETIMEDOUT, and a reader gone fails with EPIPE.
#Export(c) jet_sys_fd_write_raw: fn(token: I64, data: I64, length: I64, timeout: I64, output: I64, error: I64) -> I64 {
    native: host_native_int(token)
    wait: host_native_int(timeout)
    if (jet_scheduler_native_propagate() != I64{0}) -> return I64{0}
    descriptor: host_descriptor_number(native)
    if (descriptor < I64{0}) -> return host_descriptor_closed(HOST_IO_OP_WRITE, error)
    if (length <= I64{0}) {
        rt_text_store(output, jet_int_owned_from_i64(I64{0}))
        return I64{1}
    }
    ready: host_descriptor_wait(descriptor, I64{4}, wait)
    if (ready < I64{0}) -> return compiler_fs_errno(HOST_IO_OP_WRITE, I64{0}, -ready, error)
    if (ready == I64{0}) -> return compiler_fs_errno(HOST_IO_OP_WRITE, I64{0}, I64{110}, error)
    count: if (length < I64{4096}) -> length else -> I64{4096}
    packed: if (RT_HOST_U8_STRIDE == I64{1}) -> data else -> jet_rt_alloc(count, I64{8})
    if (RT_HOST_U8_STRIDE != I64{1}) -> net_copy_packed(data, count, packed)
    wrote := I64{-4}
    loop wrote == (I64{-4}) {
        #Unsafe("packed lends count bytes; write retains no pointer and the caller's Fd keeps the descriptor open") {
            wrote = os_syscall_i64(I64{1}, descriptor, packed, count, I64{0}, I64{0}, I64{0})
        }
    }
    if (RT_HOST_U8_STRIDE != I64{1}) -> jet_rt_free(packed, count, I64{8})
    // EAGAIN: another writer filled the pipe since it polled writable.
    if (wrote == I64{-11}) {
        rt_text_store(output, jet_int_owned_from_i64(I64{0}))
        return I64{1}
    }
    if (wrote < I64{0}) -> return compiler_fs_errno(HOST_IO_OP_WRITE, I64{0}, -wrote, error)
    rt_text_store(output, jet_int_owned_from_i64(wrote))
    I64{1}
}

// memfd_create("jet-shared", MFD_CLOEXEC|MFD_ALLOW_SEALING), sized, sealed
// with F_SEAL_SHRINK|F_SEAL_GROW, then mapped shared read-write.
#Export(c) jet_sys_shared_create_raw: fn(size: I64, output: I64, error: I64) -> I64 {
    bytes: host_native_int(size)
    if (jet_scheduler_native_propagate() != I64{0}) -> return I64{0}
    if (bytes < I64{1} || bytes > HOST_SHARED_MAX) -> return host_descriptor_range(HOST_IO_OP_WRITE, error)
    name: jet_rt_alloc(I64{16}, I64{8})
    // "jet-shared\0" as little-endian words.
    rt_text_store(name, I64{8241983636957848938})
    rt_text_store(wrapping(name + I64{8}), I64{25701})
    descriptor: host_call_restarting(I64{319}, name, I64{3}, I64{0})
    jet_rt_free(name, I64{16}, I64{8})
    if (descriptor < I64{0}) -> return compiler_fs_errno(HOST_IO_OP_WRITE, I64{0}, -descriptor, error)
    failure := host_call_restarting(I64{77}, descriptor, bytes, I64{0})
    if (failure >= I64{0}) -> failure = host_call_restarting(I64{72}, descriptor, I64{1033}, I64{6})
    address := I64{0}
    if (failure >= I64{0}) {
        #Unsafe("a fresh shared mapping of this sealed memfd; host_descriptor_release unmaps it exactly once with this size") {
            address = os_syscall_i64(I64{9}, I64{0}, bytes, I64{3}, I64{1}, descriptor, I64{0})
        }
        if (address < I64{0} && address >= I64{-4095}) {
            failure = address
            address = I64{0}
        }
    }
    if (failure < I64{0}) {
        _ := host_call(I64{3}, descriptor, I64{0}, I64{0})
        return compiler_fs_errno(HOST_IO_OP_WRITE, I64{0}, -failure, error)
    }
    filed: host_descriptor_insert(descriptor, address, bytes)
    if (filed < I64{0}) {
        #Unsafe("the mapping made above was never filed, so this is its only owner") {
            _ := os_syscall_i64(I64{11}, address, bytes, I64{0}, I64{0}, I64{0}, I64{0})
        }
        _ := host_call(I64{3}, descriptor, I64{0}, I64{0})
        return compiler_fs_errno(HOST_IO_OP_WRITE, I64{0}, I64{24}, error)
    }
    rt_text_store(output, jet_int_owned_from_i64(filed))
    I64{1}
}

// The mapping of `token` when offset..offset+count lies inside it, else 0.
host_shared_span: fn(token: I64, offset: I64, count: I64) -> I64 {
    out: jet_rt_alloc(I64{24}, I64{8})
    base := I64{0}
    if host_descriptor_read(token, out) {
        address: net_word(out, I64{8})
        size: net_word(out, I64{16})
        if (address != I64{0} && offset >= I64{0} && count >= I64{0} && offset <= size && count <= size - offset) {
            base = wrapping(address + offset)
        }
    }
    jet_rt_free(out, I64{24}, I64{8})
    base
}

#Export(c) jet_sys_shared_write_raw: fn(token: I64, offset: I64, data: I64, length: I64, error: I64) -> I64 {
    native: host_native_int(token)
    at: host_native_int(offset)
    if (jet_scheduler_native_propagate() != I64{0}) -> return I64{0}
    base: host_shared_span(native, at, length)
    if (base == I64{0}) -> return host_descriptor_range(HOST_IO_OP_WRITE, error)
    if (length > I64{0}) {
        if (RT_HOST_U8_STRIDE == I64{1}) { rt_text_bytes_copy(base, data, length) } else { net_copy_packed(data, length, base) }
    }
    I64{1}
}

// A rectangle of an RGBA image, `stride` bytes per row, converted into the
// same rectangle of an image of the same stride at byte `offset` of the
// mapping, as a 32-bit format whose fourth byte is padding: order 0 is
// XRGB8888 (B, G, R, X in memory), 1 is XBGR8888 (R, G, B, X). Only the
// rectangle's rows are touched, two pixels per 8-byte load and store,
// straight into the mapping, so a frame costs no allocation.
#Export(c) jet_sys_shared_write_pixels_raw: fn(token: I64, offset: I64, data: I64, length: I64, stride: I64, left: I64, top: I64, columns: I64, rows: I64, order: I64, error: I64) -> I64 {
    native: host_native_int(token)
    at: host_native_int(offset)
    row_bytes: host_native_int(stride)
    x: host_native_int(left)
    y: host_native_int(top)
    width: host_native_int(columns)
    height: host_native_int(rows)
    layout: host_native_int(order)
    if (jet_scheduler_native_propagate() != I64{0}) -> return I64{0}
    if (layout < I64{0} || layout > I64{1} || row_bytes <= I64{0} || row_bytes.bit_and(I64{3}) != I64{0} || row_bytes > HOST_SHARED_MAX) -> return host_descriptor_range(HOST_IO_OP_WRITE, error)
    if (x < I64{0} || y < I64{0} || width < I64{0} || height < I64{0} || width > row_bytes /% I64{4} - x || height > HOST_SHARED_MAX /% row_bytes - y) -> return host_descriptor_range(HOST_IO_OP_WRITE, error)
    if (width == I64{0} || height == I64{0}) -> return I64{1}
    end: (y + height) * row_bytes
    if (end > length) -> return host_descriptor_range(HOST_IO_OP_WRITE, error)
    base: host_shared_span(native, at, end)
    if (base == I64{0}) -> return host_descriptor_range(HOST_IO_OP_WRITE, error)
    span: width * I64{4}
    row := y
    loop row < y + height {
        start: row * row_bytes + x * I64{4}
        index := I64{0}
        #Unsafe("host_shared_span proved end bytes from base lie inside the live mapping and end <= length bounds data's packed bytes; start + span <= end") {
            loop wrapping(index + I64{8}) <= span {
                os_store_i64(wrapping(base + start + index), host_pixels_padded(os_load_i64(wrapping(data + start + index)), layout))
                index += I64{8}
            }
        }
        if (index < span) -> net_store_uint(wrapping(base + start + index), I64{4}, host_pixels_padded(net_load_uint(wrapping(data + start + index), I64{4}), layout).bit_and(I64{4294967295}))
        row += I64{1}
    }
    I64{1}
}

// Two RGBA pixels in one little-endian word, in the padded `layout`.
host_pixels_padded: fn(pair: I64, layout: I64) -> I64 {
    // 0xFF000000FF000000: both padding bytes.
    padding: I64{-72057589759737856}
    if (layout == I64{1}) -> return pair.bit_or(padding)
    // 0x000000FF000000FF and 0x0000FF000000FF00.
    red_blue: I64{1095216660735}
    green: I64{280375465148160}
    swapped: (pair.bit_and(red_blue) << I64{16}).bit_or(pair.bit_and(green)).bit_or((pair >> I64{16}).bit_and(red_blue))
    swapped.bit_or(padding)
}

#Export(c) jet_sys_shared_read_raw: fn(token: I64, offset: I64, count: I64, output: I64, length: I64, error: I64) -> I64 {
    native: host_native_int(token)
    at: host_native_int(offset)
    total: host_native_int(count)
    if (jet_scheduler_native_propagate() != I64{0}) -> return I64{0}
    base: host_shared_span(native, at, total)
    if (base == I64{0}) -> return host_descriptor_range(HOST_IO_OP_READ, error)
    if (total == I64{0}) {
        rt_text_store(output, I64{0})
        rt_text_store(length, I64{0})
        return I64{1}
    }
    bytes: jet_rt_alloc_8(total)
    rt_text_bytes_copy(bytes, base, total)
    compiler_fs_bytes_take(bytes, total, total, output, length)
    I64{1}
}

// `count` little-endian copies of the 32-bit `value` from byte `offset`;
// pairs go as one 8-byte store.
#Export(c) jet_sys_shared_fill_raw: fn(token: I64, offset: I64, count: I64, value: I64, error: I64) -> I64 {
    native: host_native_int(token)
    at: host_native_int(offset)
    total: host_native_int(count)
    pixel: host_native_int(value).bit_and(I64{4294967295})
    if (jet_scheduler_native_propagate() != I64{0}) -> return I64{0}
    if (total < I64{0} || total > HOST_SHARED_MAX) -> return host_descriptor_range(HOST_IO_OP_WRITE, error)
    base: host_shared_span(native, at, total * I64{4})
    if (base == I64{0}) -> return host_descriptor_range(HOST_IO_OP_WRITE, error)
    pair: pixel.bit_or(pixel << I64{32})
    index := I64{0}
    #Unsafe("host_shared_span proved count * 4 bytes from base lie inside the live mapping") {
        loop wrapping(index + I64{2}) <= total {
            os_store_i64(wrapping(base + index * I64{4}), pair)
            index += I64{2}
        }
    }
    if (index < total) -> net_store_uint(wrapping(base + index * I64{4}), I64{4}, pixel)
    I64{1}
}

// The address of the 8-byte word at `offset` of `token`'s mapping when
// `offset` is a multiple of 8 and the word lies inside it, else 0. The
// mapping is page-aligned, so the word is aligned for the atomic mappings.
host_shared_word: fn(token: I64, offset: I64) -> I64 {
    if (offset.bit_and(I64{7}) != I64{0}) -> return I64{0}
    host_shared_span(token, offset, I64{8})
}

// The SeqCst atomic accesses to one word of shared memory, in the same
// mappings as core.mem's Atomic (Atomic.jet): every process that maps the
// memory and uses these sees one order of them, and a store publishes the
// plain writes made before it to a load that reads it.
#Export(c) jet_sys_shared_load_raw: fn(token: I64, offset: I64, output: I64, error: I64) -> I64 {
    native: host_native_int(token)
    at: host_native_int(offset)
    if (jet_scheduler_native_propagate() != I64{0}) -> return I64{0}
    place: host_shared_word(native, at)
    if (place == I64{0}) -> return host_descriptor_range(HOST_IO_OP_READ, error)
    rt_text_store(output, jet_int_owned_from_i64(atomic_word_load(place)))
    I64{1}
}

#Export(c) jet_sys_shared_store_raw: fn(token: I64, offset: I64, value: I64, error: I64) -> I64 {
    native: host_native_int(token)
    at: host_native_int(offset)
    word: host_native_int(value)
    if (jet_scheduler_native_propagate() != I64{0}) -> return I64{0}
    place: host_shared_word(native, at)
    if (place == I64{0}) -> return host_descriptor_range(HOST_IO_OP_WRITE, error)
    atomic_word_store(place, word)
    I64{1}
}

// 1 when the word held `expected` and now holds `replacement`, else 0.
#Export(c) jet_sys_shared_compare_exchange_raw: fn(token: I64, offset: I64, expected: I64, replacement: I64, output: I64, error: I64) -> I64 {
    native: host_native_int(token)
    at: host_native_int(offset)
    old: host_native_int(expected)
    fresh: host_native_int(replacement)
    if (jet_scheduler_native_propagate() != I64{0}) -> return I64{0}
    place: host_shared_word(native, at)
    if (place == I64{0}) -> return host_descriptor_range(HOST_IO_OP_WRITE, error)
    swapped: if atomic_word_cas(place, old, fresh) -> I64{1} else -> I64{0}
    rt_text_store(output, jet_int_owned_from_i64(swapped))
    I64{1}
}
