// Native Authority is one owning List24 of byte-sorted unique E4 Text handles.
// Producers and glue share this layout; no Rust BTreeSet allocation is read.
authority_sift: fn(data: I64, start: I64, count: I64) {
    root := start
    loop root < (count /% I64{2}) {
        child := root * I64{2} + I64{1}
        if (child + I64{1} < count && jet_rt_string_compare(rt_text_word(wrapping(data + child * I64{8})), rt_text_word(wrapping(data + (child + I64{1}) * I64{8}))) < I64{0}) -> child += I64{1}
        if (jet_rt_string_compare(rt_text_word(wrapping(data + root * I64{8})), rt_text_word(wrapping(data + child * I64{8}))) >= I64{0}) -> return
        coll_i64_swap(data, root, child)
        root = child
    }
}
authority_sort: fn(data: I64, count: I64) {
    root := count /% I64{2}
    loop root > (I64{0}) {
        root -= I64{1}
        authority_sift(data, root, count)
    }
    end := count
    loop end > (I64{1}) {
        end -= I64{1}
        coll_i64_swap(data, I64{0}, end)
        authority_sift(data, I64{0}, end)
    }
}
#Export(c) jet_authority_from_rights: fn(slots: I64, count: I64) -> I64 {
    // Match list_in: a null pointer or nonpositive length denotes an empty list.
    length: if (slots == I64{0} || count <= I64{0}) -> I64{0} else -> count
    result: data_sequence_new(length, I64{8})
    data: rt_text_word(wrapping(result + DATA_SEQUENCE_DATA))
    coll_copy(slots, data, length * I64{8})
    authority_sort(data, length)
    // Sort borrowed pointers in the final buffer, then clone only unique rights.
    // Tail slots remain nonowners and are never read/dropped beyond final len.
    at := I64{0}
    unique := I64{0}
    previous := I64{0}
    loop at < length {
        right: rt_text_word(wrapping(data + at * I64{8}))
        if (at == I64{0} || !jet_rt_string_eq(previous, right)) {
            rt_text_store(wrapping(data + unique * I64{8}), jet_rt_string_clone(right))
            unique += I64{1}
        }
        previous = right
        at += I64{1}
    }
    rt_text_store(wrapping(result + DATA_SEQUENCE_LENGTH), unique)
    result
}
#Export(c) jet_rt_handle_clone_jet_authority: fn(value: I64) -> I64 {
    result: jet_rt_alloc(DATA_SEQUENCE_BYTES, I64{8})
    data_text_list_copy_into(value, result)
    result
}
#Export(c) jet_rt_handle_drop_jet_authority: fn(value: I64) {
    if (value == I64{0}) -> return
    coll_text_list_drop(value, true)
    jet_rt_free(value, DATA_SEQUENCE_BYTES, I64{8})
}
#Export(c) jet_rt_handle_eq_jet_authority: fn(left: I64, right: I64) -> Bool {
    length: rt_text_word(wrapping(left + DATA_SEQUENCE_LENGTH))
    if (length != rt_text_word(wrapping(right + DATA_SEQUENCE_LENGTH))) -> return false
    a: rt_text_word(wrapping(left + DATA_SEQUENCE_DATA))
    b: rt_text_word(wrapping(right + DATA_SEQUENCE_DATA))
    at := I64{0}
    loop at < length {
        if (!jet_rt_string_eq(rt_text_word(wrapping(a + at * I64{8})), rt_text_word(wrapping(b + at * I64{8})))) -> return false
        at += I64{1}
    }
    true
}
// The one covers rule (spec.md "Effect scopes"), which the compiler's checks
// ask too (jet_foundation EffectScope.jet): a right covers itself and every
// leaf below it, a bare right covers every scoped instance of itself and its
// leaves, and a scoped right (`FS.Read("repo")`) covers only scoped rights
// its scope's law admits. Paths cover by whole components after
// normalization, hosts by ASCII-case-insensitive equality without a trailing
// `.`, and every other scope by equality.
//
// The byte offset of the `("` that opens `right`'s scope argument, or -1
// when `right` is bare.
authority_scope_open: fn(right: I64) -> I64 { authority_scope_open_bytes(rt_text_data(right), rt_text_len(right)) }
authority_scope_open_bytes: fn(data: I64, length: I64) -> I64 {
    if (length < I64{4} || rt_text_byte(wrapping(wrapping(data + length) - I64{1})) != I64{41} || rt_text_byte(wrapping(wrapping(data + length) - I64{2})) != I64{34}) -> return I64{-1}
    at := I64{0}
    loop at + (I64{4}) <= length {
        if (rt_text_byte(wrapping(data + at)) == I64{40} && rt_text_byte(wrapping(wrapping(data + at) + I64{1})) == I64{34}) -> return at
        at += I64{1}
    }
    I64{-1}
}
// Whether the bare right `held[0..held_len]` covers `need[0..need_len]`:
// itself, and every leaf below it.
authority_base_covers: fn(held: I64, held_len: I64, need: I64, need_len: I64) -> Bool {
    if (held_len > need_len || !rt_text_equal_bytes(held, need, held_len)) -> return false
    held_len == need_len || rt_text_byte(wrapping(need + held_len)) == I64{46}
}
// The scope law of a right's root: 1 for the paths of `FS`, 2 for the hosts
// of `Net`, 0 for every other root, whose scopes cover by equality.
authority_scope_kind: fn(base: I64, length: I64) -> I64 {
    root := I64{0}
    loop root < length && rt_text_byte(wrapping(base + root)) != (I64{46}) -> root += I64{1}
    if (root == I64{2} && rt_text_byte(base) == I64{70} && rt_text_byte(wrapping(base + I64{1})) == I64{83}) -> return I64{1}
    if (root == I64{3} && rt_text_byte(base) == I64{78} && rt_text_byte(wrapping(base + I64{1})) == I64{101} && rt_text_byte(wrapping(base + I64{2})) == I64{116}) -> return I64{2}
    I64{0}
}
// `path[0..length]` normalized into `out` (capacity `length + 1`), returning
// the bytes written: `.` and empty components go, and `..` takes back the
// component before it. An absolute path keeps its leading `/`, and a `..`
// above it stays at the root; a `..` above a relative start is kept.
authority_path_normal: fn(path: I64, length: I64, out: I64) -> I64 {
    rooted: length > I64{0} && rt_text_byte(path) == I64{47}
    floor: if rooted -> I64{1} else -> I64{0}
    if rooted -> rt_text_put(out, I64{47})
    used := floor
    at := I64{0}
    loop at < length {
        start := at
        loop at < length && rt_text_byte(wrapping(path + at)) != (I64{47}) -> at += I64{1}
        size: at - start
        at += I64{1}
        if (size == I64{0} || (size == I64{1} && rt_text_byte(wrapping(path + start)) == I64{46})) -> next
        if (size == I64{2} && rt_text_byte(wrapping(path + start)) == I64{46} && rt_text_byte(wrapping(wrapping(path + start) + I64{1})) == I64{46}) {
            last := used
            loop last > floor && rt_text_byte(wrapping(wrapping(out + last) - I64{1})) != (I64{47}) -> last -= I64{1}
            parent_is_up: used - last == I64{2} && rt_text_byte(wrapping(out + last)) == I64{46} && rt_text_byte(wrapping(wrapping(out + last) + I64{1})) == I64{46}
            if (used > floor && !parent_is_up) {
                used = if last > floor -> last - I64{1} else -> floor
                next
            }
            if rooted -> next
        }
        if used > floor {
            rt_text_put(wrapping(out + used), I64{47})
            used += I64{1}
        }
        coll_copy(wrapping(path + start), wrapping(out + used), size)
        used += size
    }
    used
}
// The path law: `held` covers `need` when its normalized components are a
// prefix of the need's and the need does not climb past them with a kept
// `..` (`..` never covers `../..`, nor `.` covers `../a`).
authority_path_covers: fn(held: I64, held_len: I64, need: I64, need_len: I64) -> Bool {
    held_out: jet_rt_alloc(held_len + I64{1}, I64{1})
    need_out: jet_rt_alloc(need_len + I64{1}, I64{1})
    h: authority_path_normal(held, held_len, held_out)
    n: authority_path_normal(need, need_len, need_out)
    prefix: h == I64{0} || (h <= n && rt_text_equal_bytes(held_out, need_out, h) && (h == n || rt_text_byte(wrapping(need_out + h)) == I64{47} || (h == I64{1} && rt_text_byte(held_out) == I64{47})))
    // Only a relative need keeps a `..`, and only at its start or right
    // after a prefix made of `..` alone.
    rest: if (h == I64{0}) -> I64{0} else -> h + I64{1}
    climbs: rest + I64{2} <= n && rt_text_byte(need_out) != I64{47} && rt_text_byte(wrapping(need_out + rest)) == I64{46} && rt_text_byte(wrapping(wrapping(need_out + rest) + I64{1})) == I64{46} && (rest + I64{2} == n || rt_text_byte(wrapping(wrapping(need_out + rest) + I64{2})) == I64{47})
    jet_rt_free(held_out, held_len + I64{1}, I64{1})
    jet_rt_free(need_out, need_len + I64{1}, I64{1})
    prefix && !climbs
}
// A host's length without the one trailing `.` of a fully qualified name.
authority_host_len: fn(host: I64, length: I64) -> I64 {
    if (length > I64{0} && rt_text_byte(wrapping(wrapping(host + length) - I64{1})) == I64{46}) -> return length - I64{1}
    length
}
// The ASCII lower case of one byte.
authority_lower: fn(byte: I64) -> I64 {
    if (byte >= I64{65} && byte <= I64{90}) -> return byte + I64{32}
    byte
}
// The host law: equality after ASCII lower-casing.
authority_host_covers: fn(held: I64, held_len: I64, need: I64, need_len: I64) -> Bool {
    h: authority_host_len(held, held_len)
    if (h != authority_host_len(need, need_len)) -> return false
    at := I64{0}
    loop at < h {
        if (authority_lower(rt_text_byte(wrapping(held + at))) != authority_lower(rt_text_byte(wrapping(need + at)))) -> return false
        at += I64{1}
    }
    true
}
authority_covers: fn(held: I64, requested: I64) -> Bool { authority_covers_bytes(rt_text_data(held), rt_text_len(held), rt_text_data(requested), rt_text_len(requested)) }
// The covers rule over `held[0..length]` and `requested[0..other]`.
authority_covers_bytes: fn(held: I64, length: I64, requested: I64, other: I64) -> Bool {
    if (length == other && rt_text_equal_bytes(held, requested, length)) -> return true
    held_open: authority_scope_open_bytes(held, length)
    need_open: authority_scope_open_bytes(requested, other)
    held_base: if (held_open < I64{0}) -> length else -> held_open
    need_base: if (need_open < I64{0}) -> other else -> need_open
    if !authority_base_covers(held, held_base, requested, need_base) -> return false
    if (held_open < I64{0}) -> return true
    if (need_open < I64{0}) -> return false
    held_scope: wrapping(wrapping(held + held_open) + I64{2})
    held_scope_len: length - held_open - I64{4}
    need_scope: wrapping(wrapping(requested + need_open) + I64{2})
    need_scope_len: other - need_open - I64{4}
    kind: authority_scope_kind(held, held_base)
    if (kind == I64{1}) -> return authority_path_covers(held_scope, held_scope_len, need_scope, need_scope_len)
    if (kind == I64{2}) -> return authority_host_covers(held_scope, held_scope_len, need_scope, need_scope_len)
    held_scope_len == need_scope_len && rt_text_equal_bytes(held_scope, need_scope, held_scope_len)
}
// The one covers rule as the jet.runtime.authority binding `covers`
// (Public/Authority.jet), which the compiler's checks call (jet_foundation
// Policy/EffectScope.jet): whether the right `held` covers the right `need`.
#Export(c) jet_authority_right_covers: fn(held: I64, need: I64) -> Bool { authority_covers(held, need) }
authority_narrow_failure: fn(requested: I64) -> I64 {
    length: rt_text_len(requested)
    if (length > I64{9223372036854775807} - I64{60}) -> rt_text_capacity_stop()
    message: rt_text_builder_with_capacity(length + I64{60})
    // One exact seed message: E0712: authority cannot narrow to `...` outside its held rights.
    jet_rt_string_builder_push(message, rt_static_text("E0712: authority cannot narrow to `"))
    rt_text_append(message, rt_text_data(requested), length)
    jet_rt_string_builder_push(message, rt_static_text("` outside its held rights"))
    // NL21: seed raw Rust panic/exit101 is a seed defect. Use the one Jet panic
    // mechanism (task publication, otherwise root report/exit70), not a new stop.
    jet_rt_panic_message(rt_text_data(message), rt_text_len(message))
    jet_rt_string_drop(message)
    I64{0} // canonical stopped handle if the scheduler published the failure
}
#Export(c) jet_authority_with: fn(value: I64, requested: I64) -> I64 {
    length: rt_text_word(wrapping(value + DATA_SEQUENCE_LENGTH))
    data: rt_text_word(wrapping(value + DATA_SEQUENCE_DATA))
    at := I64{0}
    loop at < length {
        if (authority_covers(rt_text_word(wrapping(data + at * I64{8})), requested)) {
            result: data_sequence_new(I64{1}, I64{8})
            rt_text_store(rt_text_word(wrapping(result + DATA_SEQUENCE_DATA)), jet_rt_string_clone(requested))
            rt_text_store(wrapping(result + DATA_SEQUENCE_LENGTH), I64{1})
            return result
        }
        at += I64{1}
    }
    authority_narrow_failure(requested)
}
#Export(c) jet_authority_without: fn(value: I64, requested: I64) -> I64 {
    length: rt_text_word(wrapping(value + DATA_SEQUENCE_LENGTH))
    data: rt_text_word(wrapping(value + DATA_SEQUENCE_DATA))
    at := I64{0}
    kept := I64{0}
    loop at < length {
        if (!authority_covers(requested, rt_text_word(wrapping(data + at * I64{8})))) -> kept += I64{1}
        at += I64{1}
    }
    result: data_sequence_new(kept, I64{8})
    target: rt_text_word(wrapping(result + DATA_SEQUENCE_DATA))
    at = I64{0}
    kept = I64{0}
    loop at < length {
        right: rt_text_word(wrapping(data + at * I64{8}))
        if (!authority_covers(requested, right)) {
            rt_text_store(wrapping(target + kept * I64{8}), jet_rt_string_clone(right))
            kept += I64{1}
        }
        at += I64{1}
    }
    rt_text_store(wrapping(result + DATA_SEQUENCE_LENGTH), kept)
    result
}
// The one Authority wire encoder: the sorted rights joined with LF, with no
// trailing LF. A process policy and the checked plugin boundary both send this
// text.
#Export(c) jet_authority_to_wire: fn(value: I64) -> I64 {
    result: jet_rt_string_builder_new()
    length: rt_text_word(wrapping(value + DATA_SEQUENCE_LENGTH))
    data: rt_text_word(wrapping(value + DATA_SEQUENCE_DATA))
    at := I64{0}
    loop at < length {
        if at != (I64{0}) -> rt_text_push_word(result, I64{10}, I64{1})
        right: rt_text_word(wrapping(data + at * I64{8}))
        rt_text_append(result, rt_text_data(right), rt_text_len(right))
        at += I64{1}
    }
    result
}
// The seed workspace rights are defined once, directly in the final owners.
authority_workspace_right: fn(write: Bool) -> I64 {
    text: rt_text_builder_with_capacity(if write -> I64{22} else -> I64{15})
    jet_rt_string_builder_push(text, if write -> rt_static_text("FS.Write(\".jet/build\")") else -> rt_static_text("FS.Read(\"repo\")"))
    text
}
#Export(c) jet_authority_workspace: fn() -> I64 {
    result: data_sequence_new(I64{2}, I64{8})
    data: rt_text_word(wrapping(result + DATA_SEQUENCE_DATA))
    rt_text_store(data, authority_workspace_right(false))
    rt_text_store(wrapping(data + I64{8}), authority_workspace_right(true))
    rt_text_store(wrapping(result + DATA_SEQUENCE_LENGTH), I64{2})
    result
}

// Effect-scope frames (spec.md "Effect scopes"): the run-time half of a
// written row that scopes FS or Net. Such a function runs inside a frame
// naming its row, and a Core scope publisher (jet_foundation
// effect_scope_published_effect) inside a marker naming the effect it
// publishes; both are entered on entry and left by every return and stop
// edge (JetIR ir_effect_scope_frame). The current Context record's
// CONTEXT_EFFECT_SCOPE word holds the innermost one, so a spawned task
// inherits them. A host leaf a publisher reaches checks the resource it is
// about to touch, resolved as the kernel resolves it (the working directory,
// links, `..`), against every frame in force: a frame whose row allows some
// effect of the resource's root must allow one covering it, and no denial in
// it may cover it. Only a publisher's marker arms the check, so a leaf Core
// reaches for its own ends (a TLS trust store read under `Net`) is no FS
// resource of the program. The check runs before the system call, so a path
// replaced in between is the kernel's to confine (Landlock).
//
// A frame is an interned Node40 [parent@0, descriptor@8, descriptor
// length@16, first child@24, next sibling@32], found under its parent by its
// static descriptor, made once and never freed: entering one allocates
// nothing in steady state. A frame's descriptor is the function's name, then
// its row's FS and Net entries, one per line (a denial keeps its `!`); a
// marker's is `@` and the effect it publishes.
EFFECT_SCOPE_NODE_BYTES: I64{40}
// The work area of one path check: a C path of up to 8200 bytes @0, a
// realpath result @8200, the resolved resource @12296, a resolved scope root
// @20496 and the refusing frame's verdict word @28696.
EFFECT_SCOPE_WORK_BYTES: I64{28704}
EFFECT_SCOPE_REAL: I64{8200}
EFFECT_SCOPE_RESOURCE: I64{12296}
EFFECT_SCOPE_ROOT: I64{20496}
EFFECT_SCOPE_VERDICT: I64{28696}
// The list head of the frames entered with none in force.
effect_scope_roots := I64{0}
// runtime-init: 4 when effect_scope_roots
#Export(c) jet_rt_effect_scope_init: fn() {
    if (effect_scope_roots != I64{0}) -> return
    roots: jet_rt_alloc(I64{8}, I64{8})
    sync_store(roots, I64{0})
    #Unsafe("runtime-init runs before any other thread exists") {
        effect_scope_roots = roots
    }
}

effect_scope_slot: fn() -> I64 { wrapping(context_current() + CONTEXT_EFFECT_SCOPE) }

effect_scope_marker: fn(descriptor: I64, length: I64) -> Bool { length > I64{0} && rt_text_byte(descriptor) == I64{64} }

// Enters the frame of static `descriptor[0..length]` under the one in force
// and returns the one it replaces, which jet_rt_effect_scope_leave restores.
// A marker with no frame in force, or a frame already in force (a recursive
// call), enters nothing.
#Export(c) jet_rt_effect_scope_enter: fn(descriptor: I64, length: I64) -> I64 {
    slot: effect_scope_slot()
    previous: sync_load(slot)
    if (previous == I64{0} && effect_scope_marker(descriptor, length)) -> return previous
    at := previous
    loop at != (I64{0}) {
        if (sync_load(wrapping(at + I64{8})) == descriptor) -> return previous
        at = sync_load(at)
    }
    sync_store(slot, effect_scope_node(previous, descriptor, length))
    previous
}

#Export(c) jet_rt_effect_scope_leave: fn(previous: I64) { sync_store(effect_scope_slot(), previous) }

// The interned frame of `descriptor` under `parent` (0: none in force). A
// new one goes onto the front of its parent's child list by compare-and-swap;
// a thread that loses the race to the same frame frees its copy.
effect_scope_node: fn(parent: I64, descriptor: I64, length: I64) -> I64 {
    list: if (parent == I64{0}) -> effect_scope_roots else -> wrapping(parent + I64{24})
    fresh := I64{0}
    loop {
        head: sync_load(list)
        node := head
        loop node != (I64{0}) {
            if (sync_load(wrapping(node + I64{8})) == descriptor) {
                if (fresh != I64{0}) -> jet_rt_free(fresh, EFFECT_SCOPE_NODE_BYTES, I64{8})
                return node
            }
            node = sync_load(wrapping(node + I64{32}))
        }
        if (fresh == I64{0}) {
            fresh = jet_rt_alloc(EFFECT_SCOPE_NODE_BYTES, I64{8})
            sync_store(fresh, parent)
            sync_store(wrapping(fresh + I64{8}), descriptor)
            sync_store(wrapping(fresh + I64{16}), length)
            sync_store(wrapping(fresh + I64{24}), I64{0})
        }
        sync_store(wrapping(fresh + I64{32}), head)
        if (sync_cas(list, head, fresh) == head) -> return fresh
    }
}

// The innermost frame when it is the marker of a publisher of root kind
// `kind` (1 FS, 2 Net; authority_scope_kind), else 0.
effect_scope_publisher: fn(kind: I64) -> I64 {
    node: sync_load(effect_scope_slot())
    if (node == I64{0}) -> return I64{0}
    data: sync_load(wrapping(node + I64{8}))
    size: sync_load(wrapping(node + I64{16}))
    if (!effect_scope_marker(data, size) || authority_scope_kind(wrapping(data + I64{1}), size - I64{1}) != kind) -> return I64{0}
    node
}

effect_scope_line_end: fn(data: I64, size: I64, at: I64) -> I64 {
    end := at
    loop end < size && rt_text_byte(wrapping(data + end)) != (I64{10}) -> end += I64{1}
    end
}

// `path[0..length]` as the kernel reaches it, into `out` (8200 bytes):
// absolute, with every link and `..` of its longest existing prefix
// resolved and the rest normalized onto it. An operation that does not
// follow a final link resolves the parent and keeps the final name. The
// bytes written, or -1 when the path resolves to nothing.
effect_scope_resolve: fn(path: I64, length: I64, follow: Bool, work: I64, out: I64) -> I64 {
    if (length == I64{0} || length >= I64{4096}) -> return I64{-1}
    if (follow || rt_text_byte(wrapping(wrapping(path + length) - I64{1})) == I64{47}) -> return effect_scope_resolve_prefix(path, length, work, out)
    start := length
    loop start > (I64{0}) && rt_text_byte(wrapping(wrapping(path + start) - I64{1})) != (I64{47}) -> start -= I64{1}
    size: length - start
    name: wrapping(path + start)
    dot: size == I64{1} && rt_text_byte(name) == I64{46}
    up: size == I64{2} && rt_text_byte(name) == I64{46} && rt_text_byte(wrapping(name + I64{1})) == I64{46}
    if (dot || up) -> return effect_scope_resolve_prefix(path, length, work, out)
    used := I64{0}
    if (start == I64{0}) {
        here: rt_static_text(".")
        used = effect_scope_resolve_prefix(rt_text_data(here), I64{1}, work, out)
    } else {
        used = effect_scope_resolve_prefix(path, if (start == I64{1}) -> I64{1} else -> start - I64{1}, work, out)
    }
    if (used < I64{0}) -> return used
    if (used != I64{1} || rt_text_byte(out) != I64{47}) {
        rt_text_put(wrapping(out + used), I64{47})
        used += I64{1}
    }
    coll_copy(name, wrapping(out + used), size)
    used + size
}

// The realpath of the longest prefix of `path[0..length]` that exists, then
// the rest normalized onto it, into `out`. Only a missing component (or a
// file where a folder is named) moves to a shorter prefix; any other failure
// resolves nothing.
effect_scope_resolve_prefix: fn(path: I64, length: I64, work: I64, out: I64) -> I64 {
    real: wrapping(work + EFFECT_SCOPE_REAL)
    cut := length
    loop {
        if (cut == I64{0}) {
            rt_text_put(work, I64{46})
            rt_text_put(wrapping(work + I64{1}), I64{0})
        } else {
            coll_copy(path, work, cut)
            rt_text_put(wrapping(work + cut), I64{0})
        }
        errno: process_realpath(work, real)
        if (errno == I64{0}) -> break
        if ((errno != I64{2} && errno != I64{20}) || cut == I64{0}) -> return I64{-1}
        loop cut > (I64{0}) && rt_text_byte(wrapping(wrapping(path + cut) - I64{1})) == (I64{47}) -> cut -= I64{1}
        loop cut > (I64{0}) && rt_text_byte(wrapping(wrapping(path + cut) - I64{1})) != (I64{47}) -> cut -= I64{1}
        loop cut > (I64{1}) && rt_text_byte(wrapping(wrapping(path + cut) - I64{1})) == (I64{47}) -> cut -= I64{1}
    }
    used := I64{0}
    loop rt_text_byte(wrapping(real + used)) != (I64{0}) -> used += I64{1}
    coll_copy(real, work, used)
    if (cut < length) {
        if (rt_text_byte(wrapping(path + cut)) != I64{47}) {
            rt_text_put(wrapping(work + used), I64{47})
            used += I64{1}
        }
        coll_copy(wrapping(path + cut), wrapping(work + used), length - cut)
        used += length - cut
    }
    authority_path_normal(work, used, out)
}

// Whether resolved path `root[0..root_len]` contains resolved path
// `path[0..length]`: itself, or a path below it by whole components.
effect_scope_contains: fn(root: I64, root_len: I64, path: I64, length: I64) -> Bool {
    if (root_len == I64{1} && rt_text_byte(root) == I64{47}) -> return length > I64{0} && rt_text_byte(path) == I64{47}
    root_len <= length && rt_text_equal_bytes(root, path, root_len) && (root_len == length || rt_text_byte(wrapping(path + root_len)) == I64{47})
}

// Whether scope `scope[0..scope_len]` of root kind `kind` covers resource
// `resource[0..length]` (-1: a path that resolves to nothing, which no scope
// covers). A folder scope is resolved like the resource, from the working
// directory; a host covers by authority_host_covers.
effect_scope_scope_covers: fn(kind: I64, scope: I64, scope_len: I64, resource: I64, length: I64, work: I64) -> Bool {
    if (length < I64{0}) -> return false
    if (kind == I64{2}) -> return authority_host_covers(scope, scope_len, resource, length)
    root: wrapping(work + EFFECT_SCOPE_ROOT)
    root_len: effect_scope_resolve(scope, scope_len, true, work, root)
    root_len >= I64{0} && effect_scope_contains(root, root_len, resource, length)
}

// Frame `node`'s verdict on effect `base[0..base_len]` of root kind `kind`
// over `resource[0..length]`: 0 admits, 1 when its row allows some effect of
// that root but none covering this one, 2 when a denial in it covers it.
effect_scope_verdict: fn(node: I64, base: I64, base_len: I64, kind: I64, resource: I64, length: I64, work: I64) -> I64 {
    data: sync_load(wrapping(node + I64{8}))
    size: sync_load(wrapping(node + I64{16}))
    at := effect_scope_line_end(data, size, I64{0}) + I64{1}
    speaks := false
    allowed := false
    loop at < size {
        end: effect_scope_line_end(data, size, at)
        deny: rt_text_byte(wrapping(data + at)) == I64{33}
        entry: if deny -> wrapping(wrapping(data + at) + I64{1}) else -> wrapping(data + at)
        entry_len: if deny -> end - at - I64{1} else -> end - at
        open: authority_scope_open_bytes(entry, entry_len)
        entry_base: if (open < I64{0}) -> entry_len else -> open
        if (authority_scope_kind(entry, entry_base) == kind) {
            if !deny -> speaks = true
            if (authority_base_covers(entry, entry_base, base, base_len) && (open < I64{0} || effect_scope_scope_covers(kind, wrapping(wrapping(entry + open) + I64{2}), entry_len - open - I64{4}, resource, length, work))) {
                if deny -> return I64{2}
                allowed = true
            }
        }
        at = end + I64{1}
    }
    if (speaks && !allowed) -> return I64{1}
    I64{0}
}

// The first frame in force above `marker` that refuses its effect over
// `resource[0..length]`, its verdict stored at `verdict`; 0 when every
// frame admits it.
effect_scope_refusing: fn(marker: I64, resource: I64, length: I64, work: I64, verdict: I64) -> I64 {
    base: wrapping(sync_load(wrapping(marker + I64{8})) + I64{1})
    base_len: sync_load(wrapping(marker + I64{16})) - I64{1}
    kind: authority_scope_kind(base, base_len)
    node := sync_load(marker)
    loop node != (I64{0}) {
        if !effect_scope_marker(sync_load(wrapping(node + I64{8})), sync_load(wrapping(node + I64{16}))) {
            found: effect_scope_verdict(node, base, base_len, kind, resource, length, work)
            if (found != I64{0}) {
                sync_store(verdict, found)
                return node
            }
        }
        node = sync_load(node)
    }
    I64{0}
}

// The cause of frame `node`'s refusal of marker `marker`'s effect over
// `resource[0..length]`: E0749 when a denial in its row covers it, else
// E0740 (the row's scopes do not reach it).
effect_scope_cause: fn(node: I64, verdict: I64, marker: I64, resource: I64, length: I64) -> I64 {
    data: sync_load(wrapping(node + I64{8}))
    size: sync_load(wrapping(node + I64{16}))
    name_end: effect_scope_line_end(data, size, I64{0})
    text: jet_rt_string_builder_new()
    jet_rt_string_builder_push(text, if (verdict == I64{2}) -> rt_static_text("E0749: `") else -> rt_static_text("E0740: `"))
    rt_text_append(text, data, name_end)
    jet_rt_string_builder_push(text, rt_static_text("` reached "))
    rt_text_append(text, wrapping(sync_load(wrapping(marker + I64{8})) + I64{1}), sync_load(wrapping(marker + I64{16})) - I64{1})
    jet_rt_string_builder_push(text, rt_static_text("(\""))
    rt_text_append(text, resource, length)
    jet_rt_string_builder_push(text, if (verdict == I64{2}) -> rt_static_text("\"), which its row denies: -[") else -> rt_static_text("\"), outside its row's scopes -["))
    at := name_end + I64{1}
    loop at < size {
        end: effect_scope_line_end(data, size, at)
        if (at != name_end + I64{1}) -> jet_rt_string_builder_push(text, rt_static_text(", "))
        rt_text_append(text, wrapping(data + at), end - at)
        at = end + I64{1}
    }
    jet_rt_string_builder_push(text, rt_static_text("]>"))
    text
}

// Whether the FS leaf about to touch `path` (a Text) may. A leaf no FS
// publisher's marker arms always may; an armed leaf's path, resolved
// (following a final link when `follow`), must be admitted by every frame in
// force, else its IOError, PermissionDenied with the refusal as its cause,
// goes through `error`.
effect_scope_admit_path: fn(path: I64, follow: Bool, operation: I64, error: I64) -> Bool {
    marker: effect_scope_publisher(I64{1})
    if (marker == I64{0}) -> return true
    work: jet_rt_alloc(EFFECT_SCOPE_WORK_BYTES, I64{8})
    resource := wrapping(work + EFFECT_SCOPE_RESOURCE)
    length := effect_scope_resolve(rt_text_data(path), rt_text_len(path), follow, work, resource)
    verdict: wrapping(work + EFFECT_SCOPE_VERDICT)
    node: effect_scope_refusing(marker, resource, length, work, verdict)
    if (node != I64{0}) {
        if (length < I64{0}) {
            resource = rt_text_data(path)
            length = rt_text_len(path)
        }
        cause: effect_scope_cause(node, sync_load(verdict), marker, resource, length)
        _ := compiler_fs_error(HOST_IO_KIND_PERMISSION_DENIED, operation, path, I64{0}, cause, error)
    }
    jet_rt_free(work, EFFECT_SCOPE_WORK_BYTES, I64{8})
    node == I64{0}
}

// Whether the Net leaf about to reach `host` (a Text, without brackets or
// port) may, as effect_scope_admit_path; a refusal's cause is stored at
// `error` as the leaf's error text.
effect_scope_admit_host: fn(host: I64, error: I64) -> Bool {
    marker: effect_scope_publisher(I64{2})
    if (marker == I64{0}) -> return true
    verdict: jet_rt_alloc(I64{8}, I64{8})
    node: effect_scope_refusing(marker, rt_text_data(host), rt_text_len(host), I64{0}, verdict)
    if (node != I64{0}) -> rt_text_store(error, effect_scope_cause(node, sync_load(verdict), marker, rt_text_data(host), rt_text_len(host)))
    jet_rt_free(verdict, I64{8}, I64{8})
    node == I64{0}
}
