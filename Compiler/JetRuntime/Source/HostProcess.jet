// Linux host facts have no policy/default layer. PID/UID/GID values are at
// most 32 bits and therefore already have the inline exact-Int carrier form.
// Shared output is drained before every child/blocking/exit syscall here.
fn host_call(number: I64, a1: I64, a2: I64, a3: I64) -> I64 {
    #Unsafe("the audited caller supplies the Linux syscall's valid word arguments") {
        return os_syscall_i64(number, a1, a2, a3, I64{0}, I64{0}, I64{0})
    }
}

fn host_i32(value: I64) -> I64 Never! {
    low :: value & I64{4294967295}
    if (low >= I64{2147483648}) -> wrapping(low - I64{4294967296}) else -> low
}

#Export(c)
fn jet_std_os_pid() -> I64 { host_call(I64{39}, I64{0}, I64{0}, I64{0}) }

#Export(c)
fn jet_std_os_getpid() -> I64 { jet_std_os_pid() }

#Export(c)
fn jet_std_os_getppid() -> I64 { host_call(I64{110}, I64{0}, I64{0}, I64{0}) }

#Export(c)
fn jet_std_os_getuid() -> I64 { host_call(I64{102}, I64{0}, I64{0}, I64{0}) }

#Export(c)
fn jet_std_os_geteuid() -> I64 { host_call(I64{107}, I64{0}, I64{0}, I64{0}) }

#Export(c)
fn jet_std_os_getgid() -> I64 { host_call(I64{104}, I64{0}, I64{0}, I64{0}) }

#Export(c)
fn jet_std_os_getegid() -> I64 { host_call(I64{108}, I64{0}, I64{0}, I64{0}) }

#Export(c)
fn jet_std_os_getpgrp() -> I64 { host_call(I64{111}, I64{0}, I64{0}, I64{0}) }

#Export(c)
fn jet_std_os_close_fd(fd: I64) {
    _ := host_call(I64{3}, host_i32(fd), I64{0}, I64{0})
}

#Export(c)
fn jet_std_os_sync() {
    jet_rt_stdout_flush()
    _ := host_call(I64{162}, I64{0}, I64{0}, I64{0})
}

#Export(c)
fn jet_std_process_exit(code: I64) {
    jet_rt_stdout_flush()
    _ := host_call(I64{231}, host_i32(code), I64{0}, I64{0})
}

// Raw tuples marshal into the generator's separate out slots, never a boxed
// tuple. Bool is one byte; exact Int success/error facts fit inline words.
fn host_sample_out(result: I64, available: I64, value: I64, errno: I64) {
    host_sample_fields(if (result < I64{0}) -> I64{-1} else -> result, if (result < I64{0}) -> wrapping(-result) else -> I64{0}, available, value, errno)
}

fn host_sample_fields(result: I64, error: I64, available: I64, value: I64, errno: I64) {
    #Unsafe("the caller lends the C-ABI tuple's Bool byte and two writable Int words") {
        os_store_u8(available, I64{1})
        os_store_i64(value, result)
        os_store_i64(errno, error)
    }
}

#Export(c)
fn jet_sys_getpgid_raw(pid: I64, available: I64, value: I64, errno: I64) {
    host_sample_out(host_call(I64{121}, host_i32(pid), I64{0}, I64{0}), available, value, errno)
}

#Export(c)
fn jet_sys_getsid_raw(pid: I64, available: I64, value: I64, errno: I64) {
    host_sample_out(host_call(I64{124}, host_i32(pid), I64{0}, I64{0}), available, value, errno)
}

#Export(c)
fn jet_sys_setuid_raw(uid: I64, available: I64, value: I64, errno: I64) {
    host_sample_out(host_call(I64{105}, uid & I64{4294967295}, I64{0}, I64{0}), available, value, errno)
}

#Export(c)
fn jet_sys_setgid_raw(gid: I64, available: I64, value: I64, errno: I64) {
    host_sample_out(host_call(I64{106}, gid & I64{4294967295}, I64{0}, I64{0}), available, value, errno)
}

#Export(c)
fn jet_sys_setpgid_raw(pid: I64, pgid: I64, available: I64, value: I64, errno: I64) {
    host_sample_out(host_call(I64{109}, host_i32(pid), host_i32(pgid), I64{0}), available, value, errno)
}

#Export(c)
fn jet_sys_setpgrp_raw(available: I64, value: I64, errno: I64) {
    host_sample_out(host_call(I64{109}, I64{0}, I64{0}, I64{0}), available, value, errno)
}

#Export(c)
fn jet_sys_setsid_raw(available: I64, value: I64, errno: I64) {
    host_sample_out(host_call(I64{112}, I64{0}, I64{0}, I64{0}), available, value, errno)
}

#Export(c)
fn jet_sys_kill_raw(pid: I64, signal: I64, available: I64, value: I64, errno: I64) {
    host_sample_out(host_call(I64{62}, host_i32(pid), host_i32(signal), I64{0}), available, value, errno)
}

#Export(c)
fn jet_sys_getpriority_raw(who: I64, available: I64, value: I64, errno: I64) {
    result :: host_call(I64{140}, I64{0}, who & I64{4294967295}, I64{0})
    // getpriority can legitimately return negative nice values on success.
    if (result < I64{0}) -> host_sample_out(result, available, value, errno)
    else -> host_sample_fields(wrapping(I64{20} - result), I64{0}, available, value, errno)
}

#Export(c)
fn jet_sys_setpriority_raw(who: I64, priority: I64, available: I64, value: I64, errno: I64) {
    host_sample_out(host_call(I64{141}, I64{0}, who & I64{4294967295}, host_i32(priority)), available, value, errno)
}

#Export(c)
fn jet_sys_umask_raw(mask: I64, some: I64) -> I64 {
    result :: host_call(I64{95}, mask & I64{4294967295}, I64{0}, I64{0})
    #Unsafe("some lends a writable C-ABI Option success word") { os_store_i64(some, result) }
    I64{1}
}

#Export(c)
fn jet_sys_waitpid_raw(pid: I64, options: I64, available: I64, value: I64, errno: I64, status: I64) {
    jet_rt_stdout_flush()
    #Unsafe("status lends an eight-byte out slot; wait4 writes its low four bytes and retains no pointer") {
        os_store_i64(status, I64{0})
        result :: os_syscall_i64(I64{61}, host_i32(pid), status, host_i32(options), I64{0}, I64{0}, I64{0})
        host_sample_out(result, available, value, errno)
    }
}

#Export(c)
fn jet_sys_wait_raw(available: I64, value: I64, errno: I64, status: I64) {
    jet_sys_waitpid_raw(I64{-1}, I64{0}, available, value, errno, status)
}

#Export(c)
fn jet_sys_pipe_raw(available: I64, value: I64, errno: I64, read_fd: I64, write_fd: I64) {
    #Unsafe("read_fd lends eight writable bytes to pipe's two u32 results; split both facts into the caller's separate word slots") {
        os_store_i64(read_fd, I64{0})
        result :: host_call(I64{22}, read_fd, I64{0}, I64{0})
        packed :: os_load_i64(read_fd)
        os_store_i64(read_fd, packed & I64{4294967295})
        os_store_i64(write_fd, (packed >> I64{32}) & I64{4294967295})
        host_sample_out(result, available, value, errno)
    }
}
