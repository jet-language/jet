// Linux host facts have no policy/default layer. PID/UID/GID values are at
// most 32 bits and therefore already have the inline exact-Int carrier form.
// Shared output is drained before every child/blocking/exit syscall here.
host_call: fn(number: I64, a1: I64, a2: I64, a3: I64) -> I64 {
    // `jet test`'s read recorder (TestReads.jet) sees every path syscall here.
    if (test_reads_fd >= I64{0}) -> rt_test_reads_call(number, a1, a2, a3)
    #Unsafe("the audited caller supplies the Linux syscall's valid word arguments") {
        return os_syscall_i64(number, a1, a2, a3, I64{0}, I64{0}, I64{0})
    }
}

// Route Int arguments are encoded exact-Int words, not necessarily i64.
// The canonical L4 conversion reads without consuming the borrowed owner.
host_native_int: fn(value: I64) -> I64 { jet_int_owned_to_i64(value) }

host_i32: fn(value: I64) -> I64 {
    native: host_native_int(value)
    if (jet_scheduler_native_propagate() != I64{0}) -> return I64{0}
    low: native.bit_and(I64{4294967295})
    if (low >= I64{2147483648}) -> wrapping(low - I64{4294967296}) else -> low
}

#Export(c) jet_std_os_pid: fn() -> I64 { host_call(I64{39}, I64{0}, I64{0}, I64{0}) }

#Export(c) jet_std_os_getpid: fn() -> I64 { jet_std_os_pid() }

#Export(c) jet_std_os_getppid: fn() -> I64 { host_call(I64{110}, I64{0}, I64{0}, I64{0}) }

#Export(c) jet_std_os_getuid: fn() -> I64 { host_call(I64{102}, I64{0}, I64{0}, I64{0}) }

#Export(c) jet_std_os_geteuid: fn() -> I64 { host_call(I64{107}, I64{0}, I64{0}, I64{0}) }

#Export(c) jet_std_os_getgid: fn() -> I64 { host_call(I64{104}, I64{0}, I64{0}, I64{0}) }

#Export(c) jet_std_os_getegid: fn() -> I64 { host_call(I64{108}, I64{0}, I64{0}, I64{0}) }

#Export(c) jet_std_os_getpgrp: fn() -> I64 { host_call(I64{111}, I64{0}, I64{0}, I64{0}) }

// jet_sys_getuid_raw: unix getuid(2) cannot fail, so Some.
#Export(c) jet_sys_getuid_raw: fn(some: I64) -> I64 {
    rt_text_store(some, jet_std_os_getuid())
    I64{1}
}

// std::thread::available_parallelism: the runtime's one probe
// (HostParallelism.jet: cgroup quota, affinity, online fallback) shared with
// the scheduler pool. Rust's Err is None; Some carries the exact-Int word.
#Export(c) jet_sys_cpu_count_raw: fn(some: I64) -> I64 {
    count: scheduler_available_parallelism(I64{0})
    if (jet_rt_session_propagate() != I64{0} || count <= I64{0}) -> return I64{0}
    rt_text_store(some, jet_int_owned_from_i64(count))
    I64{1}
}

#Export(c) jet_std_os_close_fd: fn(fd: I64) {
    native: host_i32(fd)
    if (jet_scheduler_native_propagate() != I64{0}) -> return
    _ := host_call(I64{3}, native, I64{0}, I64{0})
}

#Export(c) jet_std_os_sync: fn() {
    jet_rt_stdout_flush()
    _ := host_call(I64{162}, I64{0}, I64{0}, I64{0})
}

// Under the process root (jet_rt_main) the exit is a root stop: every frame
// cleans up on its stop edge, then the root runs the exit handlers and
// exits with `code`. Elsewhere (a task's body, an exit handler) the exit
// handlers run and the process exits here.
#Export(c) jet_std_process_exit: fn(code: I64) {
    native: host_i32(code)
    if (jet_scheduler_native_propagate() != I64{0}) -> return
    if (jet_rt_stop_domain() == I64{1}) {
        _ := jet_rt_root_publish_rendered(I64{0}, I64{0}, native)
        return
    }
    jet_rt_process_exit(native)
}

// process.exit in a program that owns its main (JetIR EntryOwned.jet): it
// runs under no root and starts no task, so no stop is ever delivered to it
// and jet_std_process_exit would take its last step: the exit handlers run
// and the process exits here. It links none of the root's stop publishing.
#Export(c) jet_std_process_exit_owned: fn(code: I64) {
    jet_rt_process_exit(host_i32(code))
}

// Raw tuples marshal into the generator's separate out slots, never a boxed
// tuple. Bool is one byte; exact Int success/error facts fit inline words.
host_sample_out: fn(result: I64, available: I64, value: I64, errno: I64) {
    host_sample_fields(if (result < I64{0}) -> I64{-1} else -> result, if (result < I64{0}) -> wrapping(I64{0} - result) else -> I64{0}, available, value, errno)
}

host_sample_fields: fn(result: I64, error: I64, available: I64, value: I64, errno: I64) {
    #Unsafe("the caller lends the C-ABI tuple's Bool byte and two writable Int words") {
        os_store_u8(available, I64{1})
        os_store_i64(value, result)
        os_store_i64(errno, error)
    }
}

#Export(c) jet_sys_getpgid_raw: fn(pid: I64, available: I64, value: I64, errno: I64) {
    native: host_i32(pid)
    if (jet_scheduler_native_propagate() != I64{0}) -> return
    host_sample_out(host_call(I64{121}, native, I64{0}, I64{0}), available, value, errno)
}

#Export(c) jet_sys_getsid_raw: fn(pid: I64, available: I64, value: I64, errno: I64) {
    native: host_i32(pid)
    if (jet_scheduler_native_propagate() != I64{0}) -> return
    host_sample_out(host_call(I64{124}, native, I64{0}, I64{0}), available, value, errno)
}

#Export(c) jet_sys_setuid_raw: fn(uid: I64, available: I64, value: I64, errno: I64) {
    native: host_native_int(uid)
    if (jet_scheduler_native_propagate() != I64{0}) -> return
    host_sample_out(host_call(I64{105}, native.bit_and(I64{4294967295}), I64{0}, I64{0}), available, value, errno)
}

#Export(c) jet_sys_setgid_raw: fn(gid: I64, available: I64, value: I64, errno: I64) {
    native: host_native_int(gid)
    if (jet_scheduler_native_propagate() != I64{0}) -> return
    host_sample_out(host_call(I64{106}, native.bit_and(I64{4294967295}), I64{0}, I64{0}), available, value, errno)
}

#Export(c) jet_sys_setpgid_raw: fn(pid: I64, pgid: I64, available: I64, value: I64, errno: I64) {
    native_pid: host_i32(pid)
    if (jet_scheduler_native_propagate() != I64{0}) -> return
    native_pgid: host_i32(pgid)
    if (jet_scheduler_native_propagate() != I64{0}) -> return
    host_sample_out(host_call(I64{109}, native_pid, native_pgid, I64{0}), available, value, errno)
}

#Export(c) jet_sys_setpgrp_raw: fn(available: I64, value: I64, errno: I64) {
    host_sample_out(host_call(I64{109}, I64{0}, I64{0}, I64{0}), available, value, errno)
}

#Export(c) jet_sys_setsid_raw: fn(available: I64, value: I64, errno: I64) {
    host_sample_out(host_call(I64{112}, I64{0}, I64{0}, I64{0}), available, value, errno)
}

#Export(c) jet_sys_kill_raw: fn(pid: I64, signal: I64, available: I64, value: I64, errno: I64) {
    native_pid: host_i32(pid)
    if (jet_scheduler_native_propagate() != I64{0}) -> return
    native_signal: host_i32(signal)
    if (jet_scheduler_native_propagate() != I64{0}) -> return
    host_sample_out(host_call(I64{62}, native_pid, native_signal, I64{0}), available, value, errno)
}

#Export(c) jet_sys_getpriority_raw: fn(who: I64, available: I64, value: I64, errno: I64) {
    native: host_native_int(who)
    if (jet_scheduler_native_propagate() != I64{0}) -> return
    result: host_call(I64{140}, I64{0}, native.bit_and(I64{4294967295}), I64{0})
    // getpriority can legitimately return negative nice values on success.
    if (result < I64{0}) { host_sample_out(result, available, value, errno) } else {
        host_sample_fields(wrapping(I64{20} - result), I64{0}, available, value, errno)
    }
}

#Export(c) jet_sys_setpriority_raw: fn(who: I64, priority: I64, available: I64, value: I64, errno: I64) {
    native_who: host_native_int(who)
    if (jet_scheduler_native_propagate() != I64{0}) -> return
    native_priority: host_i32(priority)
    if (jet_scheduler_native_propagate() != I64{0}) -> return
    host_sample_out(host_call(I64{141}, I64{0}, native_who.bit_and(I64{4294967295}), native_priority), available, value, errno)
}

// prlimit64(0, resource, NULL, &old): this program's (soft, hard) limit.
// RLIM_INFINITY (all ones) reads as -1; core.sys maps a negative to None.
#Export(c) jet_sys_rlimit_raw: fn(resource: I64, available: I64, soft: I64, hard: I64, errno: I64) {
    native: host_i32(resource)
    if (jet_scheduler_native_propagate() != I64{0}) -> return
    buffer: jet_rt_alloc(I64{16}, I64{8})
    thread_zero(buffer, I64{16})
    #Unsafe("buffer owns the sixteen-byte struct rlimit64 the kernel writes; the caller lends the tuple's Bool byte and three Int words") {
        result: os_syscall_i64(I64{302}, I64{0}, native, I64{0}, buffer, I64{0}, I64{0})
        os_store_u8(available, I64{1})
        os_store_i64(soft, jet_int_owned_from_i64(if (result < I64{0}) -> I64{0} else -> os_load_i64(buffer)))
        os_store_i64(hard, jet_int_owned_from_i64(if (result < I64{0}) -> I64{0} else -> os_load_i64(wrapping(buffer + I64{8}))))
        os_store_i64(errno, if (result < I64{0}) -> wrapping(I64{0} - result) else -> I64{0})
    }
    jet_rt_free(buffer, I64{16}, I64{8})
}

// prlimit64(0, resource, &new, NULL): -1 passes RLIM_INFINITY. Children
// inherit the new limit; raising a hard limit needs privilege (EPERM).
#Export(c) jet_sys_set_rlimit_raw: fn(resource: I64, soft: I64, hard: I64, available: I64, value: I64, errno: I64) {
    native: host_i32(resource)
    if (jet_scheduler_native_propagate() != I64{0}) -> return
    low: host_native_int(soft)
    if (jet_scheduler_native_propagate() != I64{0}) -> return
    high: host_native_int(hard)
    if (jet_scheduler_native_propagate() != I64{0}) -> return
    buffer: jet_rt_alloc(I64{16}, I64{8})
    #Unsafe("buffer owns the sixteen-byte struct rlimit64 the kernel reads and does not retain") {
        os_store_i64(buffer, low)
        os_store_i64(wrapping(buffer + I64{8}), high)
        host_sample_out(os_syscall_i64(I64{302}, I64{0}, native, buffer, I64{0}, I64{0}, I64{0}), available, value, errno)
    }
    jet_rt_free(buffer, I64{16}, I64{8})
}

// getrusage(who, &usage): user and system time in microseconds, and the
// peak resident set, which Linux counts in KiB, in bytes.
#Export(c) jet_sys_rusage_raw: fn(who: I64, available: I64, user: I64, system: I64, peak: I64, errno: I64) {
    native: host_i32(who)
    if (jet_scheduler_native_propagate() != I64{0}) -> return
    buffer: jet_rt_alloc(I64{144}, I64{8})
    thread_zero(buffer, I64{144})
    result: host_call(I64{98}, native, buffer, I64{0})
    #Unsafe("buffer owns the 144-byte struct rusage the kernel writes; the caller lends the tuple's Bool byte and four Int words") {
        os_store_u8(available, I64{1})
        os_store_i64(user, jet_int_owned_from_i64(os_load_i64(buffer) * I64{1000000} + os_load_i64(wrapping(buffer + I64{8}))))
        os_store_i64(system, jet_int_owned_from_i64(os_load_i64(wrapping(buffer + I64{16})) * I64{1000000} + os_load_i64(wrapping(buffer + I64{24}))))
        os_store_i64(peak, jet_int_owned_from_i64(os_load_i64(wrapping(buffer + I64{32})) * I64{1024}))
        os_store_i64(errno, if (result < I64{0}) -> wrapping(I64{0} - result) else -> I64{0})
    }
    jet_rt_free(buffer, I64{144}, I64{8})
}

#Export(c) jet_sys_umask_raw: fn(mask: I64, some: I64) -> I64 {
    native: host_native_int(mask)
    if (jet_scheduler_native_propagate() != I64{0}) -> return I64{0}
    result: host_call(I64{95}, native.bit_and(I64{4294967295}), I64{0}, I64{0})
    #Unsafe("some lends a writable C-ABI Option success word") { os_store_i64(some, result) }
    I64{1}
}

#Export(c) jet_sys_waitpid_raw: fn(pid: I64, options: I64, available: I64, value: I64, errno: I64, status: I64) {
    native_pid: host_i32(pid)
    if (jet_scheduler_native_propagate() != I64{0}) -> return
    native_options: host_i32(options)
    if (jet_scheduler_native_propagate() != I64{0}) -> return
    jet_rt_stdout_flush()
    #Unsafe("status lends an eight-byte out slot; wait4 writes its low four bytes and retains no pointer") {
        os_store_i64(status, I64{0})
        result: os_syscall_i64(I64{61}, native_pid, status, native_options, I64{0}, I64{0}, I64{0})
        host_sample_out(result, available, value, errno)
    }
}

#Export(c) jet_sys_wait_raw: fn(available: I64, value: I64, errno: I64, status: I64) {
    jet_sys_waitpid_raw(I64{-1}, I64{0}, available, value, errno, status)
}

#Export(c) jet_sys_pipe_raw: fn(available: I64, value: I64, errno: I64, read_fd: I64, write_fd: I64) {
    #Unsafe("read_fd lends eight writable bytes to pipe's two u32 results; split both facts into the caller's separate word slots") {
        os_store_i64(read_fd, I64{0})
        result: host_call(I64{22}, read_fd, I64{0}, I64{0})
        packed: os_load_i64(read_fd)
        os_store_i64(read_fd, packed.bit_and(I64{4294967295}))
        os_store_i64(write_fd, (packed >> I64{32}).bit_and(I64{4294967295}))
        host_sample_out(result, available, value, errno)
    }
}
