// Shared Native64 owner, #4828 Arc/Mutex clone semantics. The seed RNG is
// xorshift(13,7,17), NOT Core's divergent SplitMix64 source.
#Export(c) jet_reservoir_sampler_new: fn(capacity: I64) -> I64 {
    value: jet_rt_alloc(RESERVOIR_BYTES, I64{8})
    thread_zero(value, RESERVOIR_BYTES)
    sync_store(wrapping(value + RESERVOIR_REFS), I64{1})
    dyn_store(wrapping(value + RESERVOIR_LIMIT), if (capacity < I64{1}) -> I64{1} else -> capacity)
    dyn_store(wrapping(value + RESERVOIR_RNG), iter_signed(U64{0xdeadbeefcafebabe}))
    dyn_store(wrapping(wrapping(value + RESERVOIR_SEQUENCE) + DATA_SEQUENCE_DATA), I64{8})
    value
}
#Export(c) jet_rt_handle_clone_jet_reservoir_sampler: fn(value: I64) -> I64 {
    _ := sync_add(wrapping(value + RESERVOIR_REFS), I64{1})
    value
}
#Export(c) jet_rt_handle_drop_jet_reservoir_sampler: fn(value: I64) {
    if (value == I64{0}) -> return
    if (sync_add(wrapping(value + RESERVOIR_REFS), I64{-1}) != I64{1}) -> return
    coll_text_list_drop(wrapping(value + RESERVOIR_SEQUENCE), true)
    jet_rt_free(value, RESERVOIR_BYTES, I64{8})
}
#Export(c) jet_rt_native_reservoir_add: fn(value: I64, text: I64) {
    sync_mutex_lock(wrapping(value + RESERVOIR_MUTEX))
    old_count: iter_unsigned(dyn_word(wrapping(value + RESERVOIR_COUNT)))
    // RJ18: canonical checked integer overflow before any mutation, no new rail.
    if (old_count == U64{18446744073709551615}) {
        jet_rt_panic_overflow()
        sync_mutex_unlock(wrapping(value + RESERVOIR_MUTEX))
        return
    }
    count: old_count + U64{1}
    dyn_store(wrapping(value + RESERVOIR_COUNT), iter_signed(count))
    sequence: wrapping(value + RESERVOIR_SEQUENCE)
    length: dyn_word(wrapping(sequence + DATA_SEQUENCE_LENGTH))
    limit: dyn_word(wrapping(value + RESERVOIR_LIMIT))
    if (length < limit) {
        process_text_list_push(sequence, text)
        sync_mutex_unlock(wrapping(value + RESERVOIR_MUTEX))
        return
    }
    state := iter_unsigned(dyn_word(wrapping(value + RESERVOIR_RNG)))
    state = state.bit_xor(state << U64{13})
    state = state.bit_xor(state >> U64{7})
    state = state.bit_xor(state << U64{17})
    dyn_store(wrapping(value + RESERVOIR_RNG), iter_signed(state))
    index: state % count
    if (index < wrapping(U64{limit})) {
        slot: wrapping(dyn_word(wrapping(sequence + DATA_SEQUENCE_DATA)) + wrapping(I64{index}) * DYN_ELEMENT_BYTES)
        replacement: jet_rt_string_clone(text)
        jet_rt_string_drop(dyn_word(slot))
        dyn_store(slot, replacement)
    }
    sync_mutex_unlock(wrapping(value + RESERVOIR_MUTEX))
}
#Export(c) jet_rt_native_reservoir_sample: fn(value: I64) -> I64 {
    sync_mutex_lock(wrapping(value + RESERVOIR_MUTEX))
    // Lists.jet:1-7: canonical inline len/cap/data, owned E4 elements (stride8).
    result: process_text_list_clone(wrapping(value + RESERVOIR_SEQUENCE), false)
    sync_mutex_unlock(wrapping(value + RESERVOIR_MUTEX))
    result
}
#Export(c) jet_rt_handle_show_jet_reservoir_sampler: fn(value: I64) -> I64 {
    sync_mutex_lock(wrapping(value + RESERVOIR_MUTEX))
    count: iter_unsigned(dyn_word(wrapping(value + RESERVOIR_COUNT)))
    sync_mutex_unlock(wrapping(value + RESERVOIR_MUTEX))
    text: jet_rt_string_builder_new()
    rt_text_push_word(text, I64{7597421330097726802}, I64{8}) // Reservoi
    rt_text_push_word(text, I64{8243113923098792818}, I64{8}) // rSampler
    rt_text_push_word(text, I64{4025896}, I64{3}) // (n=
    divisor := U64{1}
    loop count /% divisor >= (U64{10}) { divisor *= U64{10} }
    loop {
        digit: (count /% divisor) % U64{10}
        rt_text_push_word(text, wrapping(I64{digit}) + I64{48}, I64{1})
        if (divisor == U64{1}) -> break
        divisor = divisor /% U64{10}
    }
    rt_text_push_word(text, I64{41}, I64{1})
    jet_rt_string_builder_finish(text)
}
