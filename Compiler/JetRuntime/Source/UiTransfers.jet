// C route inputs borrow owners and return a fresh cloned node. Replacement
// drops only the clone's former metadata, never the input owner.
#Export(c) jet_ui_raw_accessibility_transfer: fn(node: I64, accessibility: I64, present: U8) -> I64 {
    result: jet_rt_handle_clone_jet_ui_node(node)
    previous: ui_carrier_word(wrapping(result + UI_NODE_ACCESSIBILITY))
    if (previous != I64{0}) -> jet_rt_handle_drop_jet_ui_accessibility(previous)
    ui_carrier_store(wrapping(result + UI_NODE_ACCESSIBILITY), if (present != U8{0}) -> jet_rt_handle_clone_jet_ui_accessibility(accessibility) else -> I64{0})
    result
}
#Export(c) jet_ui_raw_shortcut_transfer: fn(node: I64, shortcut: I64, present: U8) -> I64 {
    result: jet_rt_handle_clone_jet_ui_node(node)
    previous: ui_carrier_word(wrapping(result + UI_NODE_SHORTCUT))
    if (previous != I64{0}) -> jet_rt_handle_drop_jet_ui_shortcut(previous)
    ui_carrier_store(wrapping(result + UI_NODE_SHORTCUT), if (present != U8{0}) -> jet_rt_handle_clone_jet_ui_shortcut(shortcut) else -> I64{0})
    result
}

// jet_ui_raw_node_transfer (route): Jet packs the tags and absent slots; this
// only unpacks them into a fresh Node160. Text and the children List are
// borrowed (each child is cloned); exact Int carriers are borrowed words. The
// wire carries no present optional slot: absent must be 63 (accessibility, IME,
// key, click, drop, shortcut). An off-contract carrier is the reference's
// unreachable!/assert, a host defect.
ui_transfer_defect: fn() {
    reason: rt_static_text("invalid audited UI node carrier")
    jet_rt_unreachable(rt_text_data(reason), rt_text_len(reason))
}
ui_transfer_color: fn(node: I64, offset: I64, kind_word: I64, word: I64) {
    kind: jet_int_owned_to_i64(kind_word)
    if (kind < I64{0} || kind > I64{3}) -> ui_transfer_defect()
    ui_carrier_store(wrapping(node + offset), kind)
    ui_carrier_store(wrapping(wrapping(node + offset) + I64{8}), ui_node_color_payload(kind, jet_int_owned_to_i64(word)))
}
#Export(c) jet_ui_raw_node_transfer: fn(label: I64, width: Float, height: Float, role_tag: I64, kind_tag: I64, children_data: I64, children_length: I64, color_present: U8, color: I64, absent_slots: I64, style_present: U8, foreground_kind: I64, foreground_word: I64, background_kind: I64, background_word: I64, style_flags: I64) -> I64 {
    role: jet_int_owned_to_i64(role_tag)
    kind: jet_int_owned_to_i64(kind_tag)
    if (role < I64{-1} || role > I64{3} || kind < I64{0} || kind > I64{4}) -> ui_transfer_defect()
    if (jet_int_owned_to_i64(absent_slots) != I64{63}) -> ui_transfer_defect()
    node: jet_rt_alloc(UI_NODE_BYTES, I64{8})
    ui_carrier_store(wrapping(node + UI_NODE_LABEL), jet_rt_string_clone(label))
    ui_carrier_store(wrapping(node + UI_NODE_WIDTH), rt_f64_bits(width))
    ui_carrier_store(wrapping(node + UI_NODE_HEIGHT), rt_f64_bits(height))
    ui_carrier_store(wrapping(node + UI_NODE_ROLE), role)
    ui_carrier_store(wrapping(node + UI_NODE_KIND), kind)
    children: data_sequence_new(children_length, UI_NODE_CHILD_BYTES)
    target: ui_carrier_word(wrapping(children + DATA_SEQUENCE_DATA))
    index := I64{0}
    loop index < children_length {
        ui_carrier_store(wrapping(target + index * UI_NODE_CHILD_BYTES), jet_rt_handle_clone_jet_ui_node(ui_carrier_word(wrapping(children_data + index * UI_NODE_CHILD_BYTES))))
        index += I64{1}
    }
    ui_carrier_store(wrapping(children + DATA_SEQUENCE_LENGTH), children_length)
    ui_carrier_store(wrapping(node + UI_NODE_CHILDREN), children)
    ui_carrier_store(wrapping(node + UI_NODE_COLOR), if (color_present != U8{0}) -> jet_rt_string_clone(color) else -> I64{0})
    if (style_present != U8{0}) {
        ui_carrier_store(wrapping(node + UI_NODE_STYLE_PRESENT), I64{1})
        ui_transfer_color(node, UI_NODE_FOREGROUND_KIND, foreground_kind, foreground_word)
        ui_transfer_color(node, UI_NODE_BACKGROUND_KIND, background_kind, background_word)
        ui_carrier_store(wrapping(node + UI_NODE_STYLE_FLAGS), jet_int_owned_to_i64(style_flags).bit_and(I64{7}))
    } else {
        offset := UI_NODE_STYLE_PRESENT
        loop offset <= UI_NODE_STYLE_FLAGS {
            ui_carrier_store(wrapping(node + offset), I64{0})
            offset += I64{8}
        }
    }
    ui_carrier_store(wrapping(node + UI_NODE_ABSENT_MASK), UI_NODE_OPTION_MASK)
    ui_carrier_store(wrapping(node + UI_NODE_IME), I64{0})
    ui_carrier_store(wrapping(node + UI_NODE_CLICK_FN), I64{0})
    ui_carrier_store(wrapping(node + UI_NODE_DROP_FN), I64{0})
    ui_carrier_store(wrapping(node + UI_NODE_ACCESSIBILITY), I64{0})
    ui_carrier_store(wrapping(node + UI_NODE_SHORTCUT), I64{0})
    ui_carrier_store(wrapping(node + UI_NODE_KEY), I64{0})
    node
}
// jet_ui_text_input (route): a TextInput node of the borrowed `state` text,
// one scalar per column on one row, with its IME slot present as the
// UIIMEMode variant word `ime` (0 Native, 1 Disabled).
ui_text_scalars: fn(text: I64) -> I64 {
    data: rt_text_data(text)
    length: rt_text_len(text)
    at := I64{0}
    count := I64{0}
    loop at < length {
        count += I64{1}
        at += rt_text_width(wrapping(data + at))
    }
    count
}
#Export(c) jet_ui_text_input: fn(state: I64, ime: I64) -> I64 {
    if (ime < I64{0} || ime > I64{1}) -> ui_transfer_defect()
    node: jet_rt_alloc(UI_NODE_BYTES, I64{8})
    offset := I64{0}
    loop offset < UI_NODE_BYTES {
        ui_carrier_store(wrapping(node + offset), I64{0})
        offset += I64{8}
    }
    ui_carrier_store(wrapping(node + UI_NODE_LABEL), jet_rt_string_clone(state))
    ui_carrier_store(wrapping(node + UI_NODE_WIDTH), rt_f64_bits(Float{ui_text_scalars(state)}))
    ui_carrier_store(wrapping(node + UI_NODE_HEIGHT), rt_f64_bits(Float{1.0}))
    ui_carrier_store(wrapping(node + UI_NODE_ROLE), UI_ROLE_TEXT_INPUT)
    ui_carrier_store(wrapping(node + UI_NODE_KIND), UI_KIND_TEXT_INPUT)
    ui_carrier_store(wrapping(node + UI_NODE_CHILDREN), data_sequence_new(I64{0}, UI_NODE_CHILD_BYTES))
    ui_carrier_store(wrapping(node + UI_NODE_ABSENT_MASK), UI_NODE_OPTION_MASK.bit_and(I64{-1} - UI_NODE_SLOT_IME))
    ui_carrier_store(wrapping(node + UI_NODE_IME), ime)
    node
}
