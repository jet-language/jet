fn layout_append_literal(target: I64, kind: I64) {
    entry :: layout_literal_root + kind * I64{16}
    jet_rt_string_builder_push_static(target, layout_word(entry), layout_word(entry + I64{8}))
}
fn layout_append_index(target: I64, index: I64) {
    divisor := I64{1}
    loop divisor <= index /% (I64{10}) { divisor *= I64{10} }
    remainder := index
    loop divisor > (I64{0}) {
        rt_text_push_scalar(target, I64{48} + remainder /% divisor)
        remainder = remainder %% divisor
        divisor = divisor /% I64{10}
    }
}
fn layout_row_label(index: I64, op: I64) -> I64 {
    target :: jet_rt_string_builder_new()
    layout_append_literal(target, I64{1})
    layout_append_index(target, index)
    layout_append_literal(target, I64{2} + op)
    target
}
fn layout_stop_owned(message: I64) {
    jet_rt_panic_message(rt_text_data(message), rt_text_len(message))
    // Task panic publishes Stop then returns. All callers must return immediately.
    jet_rt_string_drop(message)
}
fn layout_term_overflow() {
    target :: jet_rt_string_builder_new()
    layout_append_literal(target, I64{0})
    layout_stop_owned(target)
}
