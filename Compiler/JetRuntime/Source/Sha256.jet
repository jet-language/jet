    }
}
fn rt_sha256_rotate(word: I64, shift: I64) -> I64 {
    ((word >> shift).bit_or((word << (I64{32} - shift)))).bit_and(I64{0xffffffff})
}
fn rt_sha256_byte(left: I64, left_len: I64, right: I64, right_len: I64, third: I64, third_len: I64, fourth: I64, length: I64, at: I64, end: I64) -> I64 {
    if (at < left_len) -> return rt_text_byte(left + at)
    if (at < left_len + right_len) -> return rt_text_byte(right + at - left_len)
    if (at < left_len + right_len + third_len) -> return rt_text_byte(third + at - left_len - right_len)
    if (at < length) -> return rt_text_byte(fourth + at - left_len - right_len - third_len)
    if (at == length) -> return I64{128}
    if (at >= end - I64{8}) {
        shift :: (end - I64{1} - at) * I64{8}
        if (shift == I64{0}) -> return (length.bit_and(I64{31})) << I64{3}
        return (length >> (shift - I64{3})).bit_and(I64{255})
    }
    I64{0}
}
// Four borrowed spans support HMAC/HKDF without concatenating secret input.
// Guard the sum incrementally before any overflow; digest disjoint from inputs.
fn rt_sha2_32_parts4(left: I64, left_len: I64, right: I64, right_len: I64, third: I64, third_len: I64, fourth: I64, fourth_len: I64, digest: I64, scratch: I64, short: Bool) {
    if (left_len < I64{0} || right_len < I64{0} || third_len < I64{0} || fourth_len < I64{0} || left_len > I64{9223372036854775735} - right_len) {
        jet_rt_unreachable(I64{0}, I64{0})
        return
    }
    first_two :: left_len + right_len
    if (third_len > I64{9223372036854775735} - first_two) {
        jet_rt_unreachable(I64{0}, I64{0})
        return
    }
    first_three :: first_two + third_len
    if (fourth_len > I64{9223372036854775735} - first_three) {
        jet_rt_unreachable(I64{0}, I64{0})
        return
    }
    length :: first_three + fourth_len
    end :: ((length + I64{8}) / I64{64} + I64{1}) * I64{64}
    if short {
        rt_text_store(scratch, I64{0xc1059ed8})
        rt_text_store(scratch + I64{8}, I64{0x367cd507})
        rt_text_store(scratch + I64{16}, I64{0x3070dd17})
        rt_text_store(scratch + I64{24}, I64{0xf70e5939})
        rt_text_store(scratch + I64{32}, I64{0xffc00b31})
        rt_text_store(scratch + I64{40}, I64{0x68581511})
        rt_text_store(scratch + I64{48}, I64{0x64f98fa7})
        rt_text_store(scratch + I64{56}, I64{0xbefa4fa4})
    } else {
        rt_text_store(scratch, I64{0x6a09e667})
        rt_text_store(scratch + I64{8}, I64{0xbb67ae85})
        rt_text_store(scratch + I64{16}, I64{0x3c6ef372})
        rt_text_store(scratch + I64{24}, I64{0xa54ff53a})
        rt_text_store(scratch + I64{32}, I64{0x510e527f})
        rt_text_store(scratch + I64{40}, I64{0x9b05688c})
        rt_text_store(scratch + I64{48}, I64{0x1f83d9ab})
        rt_text_store(scratch + I64{56}, I64{0x5be0cd19})
    }
    schedule :: scratch + I64{64}
    off := I64{0}
    loop off < end {
        t := I64{0}
        loop {
            if (t >= I64{16}) -> break
            word := I64{0}
            j := I64{0}
            loop {
                if (j >= I64{4}) -> break
                word = (word << I64{8}).bit_or(rt_sha256_byte(left, left_len, right, right_len, third, third_len, fourth, length, off + t * I64{4} + j, end))
                j += I64{1}
            }
            rt_text_store(schedule + t * I64{8}, word)
            t += I64{1}
        }
        loop {
            if (t >= I64{64}) -> break
            x :: rt_text_word(schedule + (t - I64{15}) * I64{8})
            y :: rt_text_word(schedule + (t - I64{2}) * I64{8})
            s0 :: rt_sha256_rotate(x, I64{7}).bit_xor(rt_sha256_rotate(x, I64{18})).bit_xor((x >> I64{3}))
            s1 :: rt_sha256_rotate(y, I64{17}).bit_xor(rt_sha256_rotate(y, I64{19})).bit_xor((y >> I64{10}))
            rt_text_store(schedule + t * I64{8}, (rt_text_word(schedule + (t - I64{16}) * I64{8}) + s0 + rt_text_word(schedule + (t - I64{7}) * I64{8}) + s1).bit_and(I64{0xffffffff}))
            t += I64{1}
        }
        a := rt_text_word(scratch)
        b := rt_text_word(scratch + I64{8})
        c := rt_text_word(scratch + I64{16})
        d := rt_text_word(scratch + I64{24})
        e := rt_text_word(scratch + I64{32})
        f := rt_text_word(scratch + I64{40})
        g := rt_text_word(scratch + I64{48})
        h := rt_text_word(scratch + I64{56})
        t = I64{0}
        loop {
            if (t >= I64{64}) -> break
            s1 :: rt_sha256_rotate(e, I64{6}).bit_xor(rt_sha256_rotate(e, I64{11})).bit_xor(rt_sha256_rotate(e, I64{25}))
            ch :: (e.bit_and(f)).bit_xor(((e.bit_xor(I64{0xffffffff})).bit_and(g)))
            temp1 :: h + s1 + ch + rt_sha256_k(t) + rt_text_word(schedule + t * I64{8})
            s0 :: rt_sha256_rotate(a, I64{2}).bit_xor(rt_sha256_rotate(a, I64{13})).bit_xor(rt_sha256_rotate(a, I64{22}))
            maj :: (a.bit_and(b)).bit_xor((a.bit_and(c))).bit_xor((b.bit_and(c)))
            h = g
            g = f
            f = e
            e = (d + temp1).bit_and(I64{0xffffffff})
            d = c
            c = b
            b = a
            a = (temp1 + s0 + maj).bit_and(I64{0xffffffff})
            t += I64{1}
        }
        rt_text_store(scratch, (rt_text_word(scratch) + a).bit_and(I64{0xffffffff}))
        rt_text_store(scratch + I64{8}, (rt_text_word(scratch + I64{8}) + b).bit_and(I64{0xffffffff}))
        rt_text_store(scratch + I64{16}, (rt_text_word(scratch + I64{16}) + c).bit_and(I64{0xffffffff}))
        rt_text_store(scratch + I64{24}, (rt_text_word(scratch + I64{24}) + d).bit_and(I64{0xffffffff}))
        rt_text_store(scratch + I64{32}, (rt_text_word(scratch + I64{32}) + e).bit_and(I64{0xffffffff}))
        rt_text_store(scratch + I64{40}, (rt_text_word(scratch + I64{40}) + f).bit_and(I64{0xffffffff}))
        rt_text_store(scratch + I64{48}, (rt_text_word(scratch + I64{48}) + g).bit_and(I64{0xffffffff}))
        rt_text_store(scratch + I64{56}, (rt_text_word(scratch + I64{56}) + h).bit_and(I64{0xffffffff}))
        off += I64{64}
    }
    at := I64{0}
    output_length :: if short -> I64{28} else -> I64{32}
    loop {
        if (at >= output_length) -> break
        word :: rt_text_word(scratch + (at / I64{4}) * I64{8})
        rt_text_put(digest + at, (word >> (I64{24} - (at % I64{4}) * I64{8})).bit_and(I64{255}))
        at += I64{1}
    }
    // The schedule holds secret-derived words for vault callers. Wipe before
    // returning; the scratch owner is responsible for its eventual free.
    at = I64{0}
    loop {
        if (at >= I64{576}) -> break
        rt_text_store(scratch + at, I64{0})
        at += I64{8}
    }
}
fn rt_sha256_parts4(left: I64, left_len: I64, right: I64, right_len: I64, third: I64, third_len: I64, fourth: I64, fourth_len: I64, digest: I64, scratch: I64) {
    rt_sha2_32_parts4(left, left_len, right, right_len, third, third_len, fourth, fourth_len, digest, scratch, false)
}
// SHA-224 is the same compression function, with its FIPS180-4 IV and output28.
fn rt_crypto_sha224(input: I64, length: I64, output: I64, scratch: I64) {
    rt_sha2_32_parts4(input, length, I64{1}, I64{0}, I64{1}, I64{0}, I64{1}, I64{0}, output, scratch, true)
}
fn rt_sha256_parts(left: I64, left_len: I64, right: I64, right_len: I64, digest: I64, scratch: I64) {
    rt_sha256_parts4(left, left_len, right, right_len, I64{1}, I64{0}, I64{1}, I64{0}, digest, scratch)
}
#Export(c) fn jet_rt_native_sha256(bytes: I64, length: I64, digest: I64, scratch: I64) {
    rt_sha256_parts(bytes, length, I64{1}, I64{0}, digest, scratch)
}
