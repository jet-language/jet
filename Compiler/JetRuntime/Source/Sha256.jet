// Adapted without algorithm changes from
// Core/Crypto/runtime/kernel_sha256.jet:6-110@5933a61b2 (FIPS 180-4).
// Borrowed raw byte spans; caller supplies 576 bytes of word-aligned scratch
// (8 state words, 64 schedule words) and 32 writable digest bytes. No allocation,
// padded-message copy, or owning Core list crosses this runtime boundary.
// The runtime driver currently lacks addressable static tables; the fixed
// round constants become one static table when it supports that storage.
fn rt_sha256_k(round: I64) -> I64 {
    if {
        (round == I64{0}) -> I64{0x428a2f98}
        (round == I64{1}) -> I64{0x71374491}
        (round == I64{2}) -> I64{0xb5c0fbcf}
        (round == I64{3}) -> I64{0xe9b5dba5}
        (round == I64{4}) -> I64{0x3956c25b}
        (round == I64{5}) -> I64{0x59f111f1}
        (round == I64{6}) -> I64{0x923f82a4}
        (round == I64{7}) -> I64{0xab1c5ed5}
        (round == I64{8}) -> I64{0xd807aa98}
        (round == I64{9}) -> I64{0x12835b01}
        (round == I64{10}) -> I64{0x243185be}
        (round == I64{11}) -> I64{0x550c7dc3}
        (round == I64{12}) -> I64{0x72be5d74}
        (round == I64{13}) -> I64{0x80deb1fe}
        (round == I64{14}) -> I64{0x9bdc06a7}
        (round == I64{15}) -> I64{0xc19bf174}
        (round == I64{16}) -> I64{0xe49b69c1}
        (round == I64{17}) -> I64{0xefbe4786}
        (round == I64{18}) -> I64{0x0fc19dc6}
        (round == I64{19}) -> I64{0x240ca1cc}
        (round == I64{20}) -> I64{0x2de92c6f}
        (round == I64{21}) -> I64{0x4a7484aa}
        (round == I64{22}) -> I64{0x5cb0a9dc}
        (round == I64{23}) -> I64{0x76f988da}
        (round == I64{24}) -> I64{0x983e5152}
        (round == I64{25}) -> I64{0xa831c66d}
        (round == I64{26}) -> I64{0xb00327c8}
        (round == I64{27}) -> I64{0xbf597fc7}
        (round == I64{28}) -> I64{0xc6e00bf3}
        (round == I64{29}) -> I64{0xd5a79147}
        (round == I64{30}) -> I64{0x06ca6351}
        (round == I64{31}) -> I64{0x14292967}
        (round == I64{32}) -> I64{0x27b70a85}
        (round == I64{33}) -> I64{0x2e1b2138}
        (round == I64{34}) -> I64{0x4d2c6dfc}
        (round == I64{35}) -> I64{0x53380d13}
        (round == I64{36}) -> I64{0x650a7354}
        (round == I64{37}) -> I64{0x766a0abb}
        (round == I64{38}) -> I64{0x81c2c92e}
        (round == I64{39}) -> I64{0x92722c85}
        (round == I64{40}) -> I64{0xa2bfe8a1}
        (round == I64{41}) -> I64{0xa81a664b}
        (round == I64{42}) -> I64{0xc24b8b70}
        (round == I64{43}) -> I64{0xc76c51a3}
        (round == I64{44}) -> I64{0xd192e819}
        (round == I64{45}) -> I64{0xd6990624}
        (round == I64{46}) -> I64{0xf40e3585}
        (round == I64{47}) -> I64{0x106aa070}
        (round == I64{48}) -> I64{0x19a4c116}
        (round == I64{49}) -> I64{0x1e376c08}
        (round == I64{50}) -> I64{0x2748774c}
        (round == I64{51}) -> I64{0x34b0bcb5}
        (round == I64{52}) -> I64{0x391c0cb3}
        (round == I64{53}) -> I64{0x4ed8aa4a}
        (round == I64{54}) -> I64{0x5b9cca4f}
        (round == I64{55}) -> I64{0x682e6ff3}
        (round == I64{56}) -> I64{0x748f82ee}
        (round == I64{57}) -> I64{0x78a5636f}
        (round == I64{58}) -> I64{0x84c87814}
        (round == I64{59}) -> I64{0x8cc70208}
        (round == I64{60}) -> I64{0x90befffa}
        (round == I64{61}) -> I64{0xa4506ceb}
        (round == I64{62}) -> I64{0xbef9a3f7}
