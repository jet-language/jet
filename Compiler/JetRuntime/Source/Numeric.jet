// NumericConversion.rs:31-56, D-NUMWIDEN-CROSS1=E. Fixed-width source bits
// cross into Float only if their discarded low bits are zero. All U64 values
// are within F32's finite range, so accepted values need no narrowing round.
// Native LowerRoute533 carries raw word, flags, borrowed E4 text, raw line;
// the seed Rust CAbiRoutes17253 adapter uses its own JetCString text header.
fn numeric_widen_stop(file: I64, line: I64) {
    trap_header(I64{1})
    // Exact JET_NUMERIC_WIDEN_TRAP text; generated little-endian word literals.
    trap_write_word(I64{8461736369858766967}, I64{8})
    trap_write_word(I64{7953747407922356845}, I64{8})
    trap_write_word(I64{8317992806848425838}, I64{8})
    trap_write_word(I64{8367810653513654387}, I64{8})
    trap_write_word(I64{7883941909811455336}, I64{8})
    trap_write_word(I64{8027794332106910817}, I64{8})
    trap_write_word(I64{7956017139119322229}, I64{8})
    trap_write_word(I64{8316287474279129191}, I64{8})
    trap_write_word(I64{7237481}, I64{3})
    trap_msg_message_end()
    trap_context(sync_load(file), sync_load(file + I64{8}), trap_line(line), I64{0}, I64{0}, I64{0}, I64{0}, I64{1}, I64{1})
    trap_footer(I64{1})
}

#Export(c) fn jet_numeric_checked_widen_at(raw: I64, signed: Bool, target_f32: Bool, file: I64, line: I64) -> Float {
    magnitude :: if (signed && raw < I64{0}) -> wrapping(-raw) else -> raw
    significant := I64{0}
    trailing := I64{0}
    remaining := magnitude
    loop remaining != (I64{0}) {
        significant += I64{1}
        remaining = (remaining >> I64{1}) & I64{9223372036854775807}
    }
    remaining = magnitude
    trailing_more := remaining != I64{0} && (remaining & I64{1}) == I64{0}
    loop trailing_more {
        trailing += I64{1}
        remaining = (remaining >> I64{1}) & I64{9223372036854775807}
        trailing_more = remaining != I64{0} && (remaining & I64{1}) == I64{0}
    }
    precision :: if target_f32 -> I64{24} else -> I64{53}
    if (significant > precision && trailing < significant - precision) {
        numeric_widen_stop(file, line)
        loop { jet_rt_unreachable(I64{0}, I64{0}) }
    }
    if (signed || raw >= I64{0}) -> return Float{raw}
    // Split unsigned conversion at bit63 without a U64->I64 checked cast.
    // Acceptance above guarantees exact conversion, including this split.
    half :: (raw >> I64{1}) & I64{9223372036854775807}
    return Float{half} * Float{2} + Float{raw & I64{1}}
}

// CommonTypes.rs:3586-3603/5074-5080: exact Int checked widening.
// The native carrier is borrowed, never cloned into the hazard domain. One
// private limb workspace computes width, trailing zeros and the float's top
// 53 bits in the same pass; no second conversion workspace is allocated.
#Export(c) fn jet_int_checked_widen(value: I64, target_f32: Bool, file: I64, line: I64) -> Float {
    if int_inline(value) -> return jet_numeric_checked_widen_at(value, true, target_f32, file, line)
    negative :: int_negative(value)
    node :: int_copy(value, I64{0})
    bits := I64{0}
    trailing := I64{0}
    significant := false
    top := I64{0}
    maximum :: if target_f32 -> I64{128} else -> I64{1024}
    loop !(int_load(node + I64{32}) == I64{1} && int_get(node, I64{0}) == I64{0}) {
        bit :: int_div_small(node, I64{2})
        if !significant {
            if (bit == I64{0}) -> trailing += I64{1} else -> significant = true
        }
        if (bits < I64{53}) -> top |= bit << bits else -> top = (top >> I64{1}) | (bit << I64{52})
        bits += I64{1}
        // Any wider magnitude is outside the target's finite range. Stop
        // scanning after that proof rather than divide an unbounded integer.
        if (bits > maximum) -> break
    }
    int_free_node(node)
    precision :: if target_f32 -> I64{24} else -> I64{53}
    if (bits > maximum || (bits > precision && trailing < bits - precision)) {
        numeric_widen_stop(file, line)
        loop { jet_rt_unreachable(I64{0}, I64{0}) }
    }
    result := Float{top}
    shift := bits - I64{53}
    scale := Float{2.0}
    loop shift > (I64{0}) {
        if ((shift & I64{1}) != I64{0}) -> result *= scale
        shift >>= I64{1}
        if (shift != I64{0}) -> scale *= scale
    }
    return if negative -> -result else -> result
}
