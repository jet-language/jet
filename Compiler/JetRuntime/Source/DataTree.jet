// Native DataTree provider; DataABI.jet is the only offset/tag table.
// Rust behavior: foundation/DataTree.rs:8-22 (ordered derive PartialEq),
// JetStd/JSONDataTree.rs:27-94 and JetStd/DataTree.rs:49-64 (compact JSON).
// C ownership: gen-c-abi-routes.mjs:1399-1546. Sequence getters lend;
// scalar owners clone, sequence constructors consume, text constructors clone.
fn data_tree_word(address: I64) -> I64 {
    #Unsafe("address borrows an initialized word in a live native DataTree or List") { return os_load_i64(address) }
}
fn data_tree_store(address: I64, value: I64) {
    #Unsafe("address owns a writable word in a native DataTree or List") { os_store_i64(address, value) }
}
fn data_tree_new(kind: I64, payload: I64) -> I64 {
    tree :: jet_rt_alloc(DATA_TREE_BYTES, I64{8})
    data_tree_store(tree + DATA_TREE_TAG, kind)
    data_tree_store(tree + DATA_TREE_PAYLOAD, payload)
    tree
}
fn data_tree_payload(tree: I64, kind: I64) -> I64 {
    if data_tree_word(tree + DATA_TREE_TAG) != kind -> panic("record variant index out of range")
    data_tree_word(tree + DATA_TREE_PAYLOAD)
}
fn data_sequence_new(capacity: I64, stride: I64) -> I64 {
    if (capacity < I64{0} || capacity > I64{9223372036854775807} /% stride) -> jet_rt_panic_overflow()
    header :: jet_rt_alloc(DATA_SEQUENCE_BYTES, I64{8})
    data :: if (capacity == I64{0}) -> I64{8} else -> jet_rt_alloc(capacity * stride, I64{8})
    data_tree_store(header + DATA_SEQUENCE_LENGTH, I64{0})
    data_tree_store(header + DATA_SEQUENCE_CAPACITY, capacity)
    data_tree_store(header + DATA_SEQUENCE_DATA, data)
    header
}
fn data_sequence_slot(sequence: I64, index: I64, stride: I64) -> I64 {
    length :: data_tree_word(sequence + DATA_SEQUENCE_LENGTH)
    if (index < I64{0} || index >= length) -> panic("record sequence index out of range")
    data_tree_word(sequence + DATA_SEQUENCE_DATA) + index * stride
}
fn data_sequence_reserve(sequence: I64, stride: I64) -> I64 {
    length :: data_tree_word(sequence + DATA_SEQUENCE_LENGTH)
    capacity :: data_tree_word(sequence + DATA_SEQUENCE_CAPACITY)
    old :: data_tree_word(sequence + DATA_SEQUENCE_DATA)
    if length < capacity -> return old + length * stride
    // Check before multiplying, including length+1 at the maximum capacity.
    limit :: I64{9223372036854775807} /% stride
    if capacity >= limit -> jet_rt_panic_overflow()
    next :: if (capacity == I64{0}) -> I64{4} else if (capacity > limit /% I64{2}) -> limit else -> capacity * I64{2}
    data :: jet_rt_alloc(next * stride, I64{8})
    coll_copy(old, data, length * stride)
    if (capacity != I64{0}) -> jet_rt_free(old, capacity * stride, I64{8})
    data_tree_store(sequence + DATA_SEQUENCE_CAPACITY, next)
    data_tree_store(sequence + DATA_SEQUENCE_DATA, data)
    data + length * stride
}
fn data_sequence_push(sequence: I64, key: I64, child: I64, entries: Bool) {
    stride :: if entries -> DATA_TREE_ENTRY_BYTES else -> DATA_TREE_ELEMENT_BYTES
    slot :: data_sequence_reserve(sequence, stride)
    if entries {
        data_tree_store(slot + DATA_TREE_ENTRY_KEY, jet_rt_string_clone(key))
        data_tree_store(slot + DATA_TREE_ENTRY_VALUE, child)
    } else { data_tree_store(slot, child) }
    data_tree_store(sequence + DATA_SEQUENCE_LENGTH, data_tree_word(sequence + DATA_SEQUENCE_LENGTH) + I64{1})
}
fn data_sequence_clone(sequence: I64, kind: I64) -> I64 {
    stride :: if kind == DATA_TREE_OBJECT -> DATA_TREE_ENTRY_BYTES else if kind == DATA_TREE_BYTE_LIST -> RT_HOST_U8_STRIDE else -> DATA_TREE_ELEMENT_BYTES
    length :: data_tree_word(sequence + DATA_SEQUENCE_LENGTH)
    result :: data_sequence_new(length, stride)
    source :: data_tree_word(sequence + DATA_SEQUENCE_DATA)
    target :: data_tree_word(result + DATA_SEQUENCE_DATA)
    at := I64{0}
    loop at < length {
        if kind == DATA_TREE_BYTE_LIST { host_u8_put(target, at, host_u8_get(source, at)) } else if kind == DATA_TREE_OBJECT {
            data_tree_store(target + at * stride + DATA_TREE_ENTRY_KEY, jet_rt_string_clone(data_tree_word(source + at * stride + DATA_TREE_ENTRY_KEY)))
            data_tree_store(target + at * stride + DATA_TREE_ENTRY_VALUE, jet_rt_handle_clone_DataTree(data_tree_word(source + at * stride + DATA_TREE_ENTRY_VALUE)))
        } else { data_tree_store(target + at * stride, jet_rt_handle_clone_DataTree(data_tree_word(source + at * stride))) }
        at += I64{1}
    }
    data_tree_store(result + DATA_SEQUENCE_LENGTH, length)
    result
}
fn data_sequence_drop(sequence: I64, kind: I64) {
    stride :: if kind == DATA_TREE_OBJECT -> DATA_TREE_ENTRY_BYTES else if kind == DATA_TREE_BYTE_LIST -> RT_HOST_U8_STRIDE else -> DATA_TREE_ELEMENT_BYTES
    length :: data_tree_word(sequence + DATA_SEQUENCE_LENGTH)
    capacity :: data_tree_word(sequence + DATA_SEQUENCE_CAPACITY)
    data :: data_tree_word(sequence + DATA_SEQUENCE_DATA)
    at := I64{0}
    loop kind != DATA_TREE_BYTE_LIST && at < length {
        if kind == DATA_TREE_OBJECT {
            jet_rt_string_drop(data_tree_word(data + at * stride + DATA_TREE_ENTRY_KEY))
            jet_rt_handle_drop_DataTree(data_tree_word(data + at * stride + DATA_TREE_ENTRY_VALUE))
        } else { jet_rt_handle_drop_DataTree(data_tree_word(data + at * stride)) }
        at += I64{1}
    }
    if (capacity != I64{0}) -> jet_rt_free(data, capacity * stride, I64{8})
    jet_rt_free(sequence, DATA_SEQUENCE_BYTES, I64{8})
}
#Export(c) fn jet_rt_handle_clone_DataTree(tree: I64) -> I64 {
    kind :: data_tree_word(tree + DATA_TREE_TAG)
    payload := data_tree_word(tree + DATA_TREE_PAYLOAD)
    if kind == DATA_TREE_INT { payload = jet_rt_int_clone(payload) } else if kind >= DATA_TREE_NUMBER && kind <= DATA_TREE_TEXT { payload = jet_rt_string_clone(payload) } else if kind >= DATA_TREE_BYTE_LIST { payload = data_sequence_clone(payload, kind) }
    data_tree_new(kind, payload)
}
#Export(c) fn jet_rt_handle_drop_DataTree(tree: I64) {
    if (tree == I64{0}) -> return
    kind :: data_tree_word(tree + DATA_TREE_TAG)
    payload :: data_tree_word(tree + DATA_TREE_PAYLOAD)
    if kind == DATA_TREE_INT { jet_rt_int_drop(payload) } else if kind >= DATA_TREE_NUMBER && kind <= DATA_TREE_TEXT { jet_rt_string_drop(payload) } else if kind >= DATA_TREE_BYTE_LIST { data_sequence_drop(payload, kind) }
    jet_rt_free(tree, DATA_TREE_BYTES, I64{8})
}
#Export(c) fn jet_rt_handle_eq_DataTree(left: I64, right: I64) -> Bool {
    kind :: data_tree_word(left + DATA_TREE_TAG)
    if kind != data_tree_word(right + DATA_TREE_TAG) -> return false
    a :: data_tree_word(left + DATA_TREE_PAYLOAD)
    b :: data_tree_word(right + DATA_TREE_PAYLOAD)
    if kind == DATA_TREE_NULL -> return true
    if kind == DATA_TREE_INT -> return jet_int_compare(a, b) == I64{0}
    // Do not shortcut pointer identity: derived f64 equality rejects NaN even
    // in a tree compared with itself, and treats -0 and +0 as equal.
    if kind == DATA_TREE_FLOAT -> return rt_f64_from_bits(a) == rt_f64_from_bits(b)
    if kind == DATA_TREE_BOOL -> return a == b
    if kind <= DATA_TREE_TEXT -> return jet_rt_string_eq(a, b)
    length :: data_tree_word(a + DATA_SEQUENCE_LENGTH)
    if length != data_tree_word(b + DATA_SEQUENCE_LENGTH) -> return false
    ap :: data_tree_word(a + DATA_SEQUENCE_DATA)
    bp :: data_tree_word(b + DATA_SEQUENCE_DATA)
    stride :: if kind == DATA_TREE_OBJECT -> DATA_TREE_ENTRY_BYTES else -> DATA_TREE_ELEMENT_BYTES
    at := I64{0}
    loop at < length {
        if kind == DATA_TREE_BYTE_LIST {
            if host_u8_get(ap, at) != host_u8_get(bp, at) -> return false
        } else if kind == DATA_TREE_OBJECT {
            if !jet_rt_string_eq(data_tree_word(ap + at * stride + DATA_TREE_ENTRY_KEY), data_tree_word(bp + at * stride + DATA_TREE_ENTRY_KEY)) -> return false
            if !jet_rt_handle_eq_DataTree(data_tree_word(ap + at * stride + DATA_TREE_ENTRY_VALUE), data_tree_word(bp + at * stride + DATA_TREE_ENTRY_VALUE)) -> return false
        } else if !jet_rt_handle_eq_DataTree(data_tree_word(ap + at * stride), data_tree_word(bp + at * stride)) -> return false
        at += I64{1}
    }
    true
}
// Stream into one builder; avoid allocating one String for every delimiter.
fn data_tree_quote(target: I64, text: I64) {
    rt_text_push_word(target, I64{34}, I64{1})
    data :: rt_text_data(text)
    length :: rt_text_len(text)
    at := I64{0}
    loop at < length {
        byte :: rt_text_byte(data + at)
        if (byte == I64{34} || byte == I64{92}) {
            rt_text_push_word(target, I64{92}, I64{1})
            rt_text_push_word(target, byte, I64{1})
        } else if (byte == I64{8}) { rt_text_push_word(target, I64{25180}, I64{2}) } else if (byte == I64{9}) { rt_text_push_word(target, I64{29788}, I64{2}) } else if (byte == I64{10}) { rt_text_push_word(target, I64{28252}, I64{2}) } else if (byte == I64{12}) { rt_text_push_word(target, I64{26204}, I64{2}) } else if (byte == I64{13}) { rt_text_push_word(target, I64{29276}, I64{2}) } else if (byte < I64{32}) {
            rt_text_push_word(target, I64{808482140}, I64{4})
            high :: byte >> I64{4}
            low :: byte & I64{15}
            rt_text_push_word(target, if (high < I64{10}) -> high + I64{48} else -> high + I64{87}, I64{1})
            rt_text_push_word(target, if (low < I64{10}) -> low + I64{48} else -> low + I64{87}, I64{1})
        } else { rt_text_push_word(target, byte, I64{1}) }
        at += I64{1}
    }
    rt_text_push_word(target, I64{34}, I64{1})
}
fn data_tree_render(target: I64, tree: I64) {
    kind :: data_tree_word(tree + DATA_TREE_TAG)
    value :: data_tree_word(tree + DATA_TREE_PAYLOAD)
    if kind == DATA_TREE_NULL {
        rt_text_push_word(target, I64{1819047278}, I64{4})
        return
    }
    if kind == DATA_TREE_BOOL {
        if (value == I64{0}) { rt_text_push_word(target, I64{435728179558}, I64{5}) } else { rt_text_push_word(target, I64{1702195828}, I64{4}) }
        return
    }
    if kind == DATA_TREE_INT || kind == DATA_TREE_FLOAT {
        if (kind == DATA_TREE_FLOAT && ((value & I64{9223372036854775807}) >> I64{52}) == I64{2047}) -> panic("JSON cannot encode a non-finite Float")
        text :: if kind == DATA_TREE_INT -> jet_rt_int_to_string(value) else -> jet_rt_float_debug(rt_f64_from_bits(value))
        jet_rt_string_builder_push(target, text)
        jet_rt_string_drop(text)
        return
    }
    if kind == DATA_TREE_NUMBER {
        jet_rt_string_builder_push(target, value)
        return
    }
    if kind == DATA_TREE_TYPED_TEXT || kind == DATA_TREE_TEXT {
        data_tree_quote(target, value)
        return
    }
    object :: kind == DATA_TREE_OBJECT
    rt_text_push_word(target, if object -> I64{123} else -> I64{91}, I64{1})
    length :: data_tree_word(value + DATA_SEQUENCE_LENGTH)
    data :: data_tree_word(value + DATA_SEQUENCE_DATA)
    at := I64{0}
    loop at < length {
        if (at != I64{0}) -> rt_text_push_word(target, I64{44}, I64{1})
        if kind == DATA_TREE_BYTE_LIST {
            text :: jet_rt_i64_to_string(host_u8_get(data, at))
            jet_rt_string_builder_push(target, text)
            jet_rt_string_drop(text)
        } else if object {
            data_tree_quote(target, data_tree_word(data + at * DATA_TREE_ENTRY_BYTES + DATA_TREE_ENTRY_KEY))
            rt_text_push_word(target, I64{58}, I64{1})
            data_tree_render(target, data_tree_word(data + at * DATA_TREE_ENTRY_BYTES + DATA_TREE_ENTRY_VALUE))
        } else { data_tree_render(target, data_tree_word(data + at * DATA_TREE_ELEMENT_BYTES)) }
        at += I64{1}
    }
    rt_text_push_word(target, if object -> I64{125} else -> I64{93}, I64{1})
}
#Export(c) fn jet_rt_handle_show_DataTree(tree: I64) -> I64 {
    target :: jet_rt_string_builder_new()
    data_tree_render(target, tree)
    jet_rt_string_builder_finish(target)
}
#Export(c) fn jet_rt_handle_display_DataTree(tree: I64) -> I64 { jet_rt_handle_show_DataTree(tree) }
#Export(c) fn jet_rt_handle_debug_DataTree(tree: I64) -> I64 { jet_rt_handle_show_DataTree(tree) }
#Export(c) fn jet_rt_record_tag_DataTree(tree: I64) -> I64 { data_tree_word(tree + DATA_TREE_TAG) }
#Export(c) fn jet_rt_record_new_DataTree_Null() -> I64 { data_tree_new(DATA_TREE_NULL, I64{0}) }
#Export(c) fn jet_rt_record_new_DataTree_Bool(value: U8) -> I64 { data_tree_new(DATA_TREE_BOOL, if (value == U8{0}) -> I64{0} else -> I64{1}) }
#Export(c) fn jet_rt_record_new_DataTree_Int(value: I64) -> I64 { data_tree_new(DATA_TREE_INT, jet_rt_int_clone(value)) }
#Export(c) fn jet_rt_record_new_DataTree_Float(value: Float) -> I64 { data_tree_new(DATA_TREE_FLOAT, rt_f64_bits(value)) }
#Export(c) fn jet_rt_record_new_DataTree_Number(value: I64) -> I64 { data_tree_new(DATA_TREE_NUMBER, jet_rt_string_clone(value)) }
#Export(c) fn jet_rt_record_new_DataTree_TypedText(value: I64) -> I64 { data_tree_new(DATA_TREE_TYPED_TEXT, jet_rt_string_clone(value)) }
#Export(c) fn jet_rt_record_new_DataTree_Text(value: I64) -> I64 { data_tree_new(DATA_TREE_TEXT, jet_rt_string_clone(value)) }
#Export(c) fn jet_rt_record_new_DataTree_Bytes(value: I64) -> I64 { data_tree_new(DATA_TREE_BYTE_LIST, value) }
#Export(c) fn jet_rt_record_new_DataTree_Array(value: I64) -> I64 { data_tree_new(DATA_TREE_ARRAY, value) }
#Export(c) fn jet_rt_record_new_DataTree_Object(value: I64) -> I64 { data_tree_new(DATA_TREE_OBJECT, value) }
#Export(c) fn jet_rt_record_get_DataTree_Bool(tree: I64) -> Bool { data_tree_payload(tree, DATA_TREE_BOOL) != I64{0} }
#Export(c) fn jet_rt_record_get_DataTree_Int(tree: I64) -> I64 { jet_rt_int_clone(data_tree_payload(tree, DATA_TREE_INT)) }
#Export(c) fn jet_rt_record_get_DataTree_Float(tree: I64) -> Float { rt_f64_from_bits(data_tree_payload(tree, DATA_TREE_FLOAT)) }
#Export(c) fn jet_rt_record_get_DataTree_Number(tree: I64) -> I64 { jet_rt_string_clone(data_tree_payload(tree, DATA_TREE_NUMBER)) }
#Export(c) fn jet_rt_record_get_DataTree_TypedText(tree: I64) -> I64 { jet_rt_string_clone(data_tree_payload(tree, DATA_TREE_TYPED_TEXT)) }
#Export(c) fn jet_rt_record_get_DataTree_Text(tree: I64) -> I64 { jet_rt_string_clone(data_tree_payload(tree, DATA_TREE_TEXT)) }
#Export(c) fn jet_rt_record_get_DataTree_Bytes(tree: I64) -> I64 { data_tree_payload(tree, DATA_TREE_BYTE_LIST) }
#Export(c) fn jet_rt_record_get_DataTree_Array(tree: I64) -> I64 { data_tree_payload(tree, DATA_TREE_ARRAY) }
#Export(c) fn jet_rt_record_get_DataTree_Object(tree: I64) -> I64 { data_tree_payload(tree, DATA_TREE_OBJECT) }
#Export(c) fn jet_rt_record_seq_List_Rec_DataTree_new(capacity: I64) -> I64 { data_sequence_new(capacity, DATA_TREE_ELEMENT_BYTES) }
#Export(c) fn jet_rt_record_seq_List_Rec_DataTree_len(sequence: I64) -> I64 { data_tree_word(sequence + DATA_SEQUENCE_LENGTH) }
#Export(c) fn jet_rt_record_seq_List_Rec_DataTree_get(sequence: I64, index: I64) -> I64 { data_tree_word(data_sequence_slot(sequence, index, DATA_TREE_ELEMENT_BYTES)) }
#Export(c) fn jet_rt_record_seq_List_Rec_DataTree_push(sequence: I64, tree: I64) { data_sequence_push(sequence, I64{0}, tree, false) }
#Export(c) fn jet_rt_record_seq_Entries_Rec_DataTree_new(capacity: I64) -> I64 { data_sequence_new(capacity, DATA_TREE_ENTRY_BYTES) }
#Export(c) fn jet_rt_record_seq_Entries_Rec_DataTree_len(sequence: I64) -> I64 { data_tree_word(sequence + DATA_SEQUENCE_LENGTH) }
#Export(c) fn jet_rt_record_seq_Entries_Rec_DataTree_get(sequence: I64, index: I64, key: I64) -> I64 {
    slot :: data_sequence_slot(sequence, index, DATA_TREE_ENTRY_BYTES)
    data_tree_store(key, jet_rt_string_clone(data_tree_word(slot + DATA_TREE_ENTRY_KEY)))
    data_tree_word(slot + DATA_TREE_ENTRY_VALUE)
}
#Export(c) fn jet_rt_record_seq_Entries_Rec_DataTree_push(sequence: I64, key: I64, tree: I64) { data_sequence_push(sequence, key, tree, true) }
