// Strict additionally rejects small-order A/R; mixed-order A remains allowed.
// Borrowed public_key32/message/signature64; exclusive aligned5472 wiped.
fn rt_crypto_ed25519_verify(public_key: I64, message: I64, length: I64, signature: I64, strict: Bool, scratch: I64) -> Bool {
