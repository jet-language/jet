        carry := I64{0}
        start :: i - I64{32}
        end :: i - I64{12}
        j := start
        loop j < end {
            value :: rt_text_word(x + j * I64{8}) + carry - I64{16} * high * rt_ed25519_l(j - start)
            carry = (value + I64{128}) >> I64{8}
            rt_text_store(x + j * I64{8}, value - (carry << I64{8}))
            j += I64{1}
        }
        rt_text_store(x + j * I64{8}, rt_text_word(x + j * I64{8}) + carry)
        rt_text_store(x + i * I64{8}, I64{0})
        i -= I64{1}
    }
    top :: rt_text_word(x + I64{248}) >> I64{4}
    carry := I64{0}
    j := I64{0}
    loop j < (I64{32}) {
        value :: rt_text_word(x + j * I64{8}) + carry - top * rt_ed25519_l(j)
        carry = value >> I64{8}
        rt_text_store(x + j * I64{8}, value.bit_and(I64{255}))
        j += I64{1}
    }
    j = I64{0}
    loop j < (I64{32}) {
        rt_text_store(x + j * I64{8}, rt_text_word(x + j * I64{8}) - carry * rt_ed25519_l(j))
        j += I64{1}
    }
    i = I64{0}
    loop i < (I64{32}) {
        value :: rt_text_word(x + i * I64{8})
        next :: x + (i + I64{1}) * I64{8}
        rt_text_store(next, rt_text_word(next) + (value >> I64{8}))
