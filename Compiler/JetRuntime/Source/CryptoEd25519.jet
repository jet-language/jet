    rt_text_put(hash, rt_text_byte(hash).bit_and(I64{248}))
    rt_text_put(hash + I64{31}, (rt_text_byte(hash + I64{31}).bit_and(I64{63})).bit_or(I64{64}))
    p :: scratch + I64{768}
    q :: scratch + I64{1280}
    temporaries :: scratch + I64{1792}
    work :: scratch + I64{2816}
    d2 :: scratch + I64{3072}
    rt_ed25519_d2_init(d2)
    rt_ed25519_base(q, work)
    rt_ed25519_mul(p, q, hash, temporaries, d2, work)
