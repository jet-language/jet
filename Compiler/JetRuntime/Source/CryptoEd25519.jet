    left :: scratch + I64{4096}
    rt_text_bytes_copy(left, p, I64{512})
    rt_ed25519_base(q, work)
    rt_ed25519_mul(p, q, signature + I64{32}, temporaries, d2, work)
    rt_ed25519_add(p, left, temporaries, d2, work)
    expected :: scratch + I64{4928}
    rt_ed25519_pack(expected, p, temporaries, work, scratch + I64{3200}, scratch + I64{3328})
    ok :: rt_crypto_equal(signature, expected, I64{32})
    rt_crypto_wipe(scratch, I64{5472})
    return ok
}
