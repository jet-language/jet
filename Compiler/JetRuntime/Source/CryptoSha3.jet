        (index == I64{0}) -> I64{0}
        (index == I64{1}) -> I64{1}
        (index == I64{2}) -> I64{62}
        (index == I64{3}) -> I64{28}
        (index == I64{4}) -> I64{27}
        (index == I64{5}) -> I64{36}
        (index == I64{6}) -> I64{44}
        (index == I64{7}) -> I64{6}
        (index == I64{8}) -> I64{55}
        (index == I64{9}) -> I64{20}
        (index == I64{10}) -> I64{3}
        (index == I64{11}) -> I64{10}
        (index == I64{12}) -> I64{43}
