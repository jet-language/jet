        y = I64{0}
        loop y < (I64{5}) {
            x = I64{0}
            loop x < (I64{5}) {
                lane :: rt_text_word(permuted + (x + I64{5} * y) * I64{8})
                left :: rt_text_word(permuted + ((x + I64{1}) % I64{5} + I64{5} * y) * I64{8})
                right :: rt_text_word(permuted + ((x + I64{2}) % I64{5} + I64{5} * y) * I64{8})
                rt_text_store(state + (x + I64{5} * y) * I64{8}, lane.bit_xor(((left.bit_xor(I64{-1})).bit_and(right))))
                x += I64{1}
