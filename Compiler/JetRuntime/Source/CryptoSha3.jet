// Private valid rates/output pairs only; borrowed input/output disjoint from
// exclusive scratch440. Final absorption is virtual, not a copied block.
// Canonical FIPS202 padding intentionally differs from the KNOWN SEED BUG at
// length%rate==rate-1: domain0x06 and final0x80 combine into one byte0x86.
fn rt_crypto_sha3(input: I64, length: I64, rate: I64, output: I64, count: I64, scratch: I64) {
    rt_crypto_wipe(scratch, I64{440})
    at := I64{0}
    loop {
        remaining :: length - at
        full :: remaining >= rate
        lane := I64{0}
        loop lane < (rate / I64{8}) {
            word := I64{0}
            b := I64{0}
            loop b < (I64{8}) {
                index :: lane * I64{8} + b
                byte := if (index < remaining) -> rt_text_byte(input + at + index) else -> I64{0}
                if !full {
                    if (index == remaining) -> byte = byte.bit_or(I64{6})
                    if (index == rate - I64{1}) -> byte = byte.bit_or(I64{128})
                }
                word = word.bit_or((byte << (b * I64{8})))
                b += I64{1}
            }
            p :: scratch + lane * I64{8}
            rt_text_store(p, rt_text_word(p).bit_xor(word))
            lane += I64{1}
        }
        rt_keccak_f(scratch)
        if !full -> break
        at += rate
    }
    // Native target is little-endian x86_64; state lanes are LE digest bytes.
    rt_text_bytes_copy(output, scratch, count)
    rt_crypto_wipe(scratch, I64{440})
}
fn rt_crypto_sha3_224(input: I64, length: I64, output: I64, scratch: I64) {
    rt_crypto_sha3(input, length, I64{144}, output, I64{28}, scratch)
}
fn rt_crypto_sha3_256(input: I64, length: I64, output: I64, scratch: I64) {
