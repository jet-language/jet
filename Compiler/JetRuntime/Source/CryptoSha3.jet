fn rt_keccak_rotl(value: I64, count: I64) -> I64 {
    if (count == I64{0}) -> return value
    return (value << count).bit_or(rt_crypto_shr64(value, I64{64} - count))
}
fn rt_keccak_f(state: I64) {
    column :: state + I64{200}
    permuted :: state + I64{240}
    round := I64{0}
    loop round < (I64{24}) {
        x := I64{0}
        loop x < (I64{5}) {
            rt_text_store(column + x * I64{8}, rt_text_word(state + x * I64{8}).bit_xor(rt_text_word(state + (x + I64{5}) * I64{8})).bit_xor(rt_text_word(state + (x + I64{10}) * I64{8})).bit_xor(rt_text_word(state + (x + I64{15}) * I64{8})).bit_xor(rt_text_word(state + (x + I64{20}) * I64{8})))
            x += I64{1}
