        x = I64{0}
        loop x < (I64{5}) {
            delta :: rt_text_word(column + ((x + I64{4}) % I64{5}) * I64{8}).bit_xor(rt_keccak_rotl(rt_text_word(column + ((x + I64{1}) % I64{5}) * I64{8}), I64{1}))
            y := I64{0}
