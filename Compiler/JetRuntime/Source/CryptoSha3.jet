        (round == I64{3}) -> rt_crypto_word64(I64{0x80000000}, I64{0x80008000})
        (round == I64{4}) -> I64{0x000000000000808b}
        (round == I64{5}) -> I64{0x0000000080000001}
        (round == I64{6}) -> rt_crypto_word64(I64{0x80000000}, I64{0x80008081})
        (round == I64{7}) -> rt_crypto_word64(I64{0x80000000}, I64{0x00008009})
        (round == I64{8}) -> I64{0x000000000000008a}
        (round == I64{9}) -> I64{0x0000000000000088}
        (round == I64{10}) -> I64{0x0000000080008009}
        (round == I64{11}) -> I64{0x000000008000000a}
        (round == I64{12}) -> I64{0x000000008000808b}
        (round == I64{13}) -> rt_crypto_word64(I64{0x80000000}, I64{0x0000008b})
        (round == I64{14}) -> rt_crypto_word64(I64{0x80000000}, I64{0x00008089})
        (round == I64{15}) -> rt_crypto_word64(I64{0x80000000}, I64{0x00008003})
