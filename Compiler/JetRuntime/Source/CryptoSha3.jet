                p :: state + (x + I64{5} * y) * I64{8}
                rt_text_store(p, rt_text_word(p).bit_xor(delta))
                y += I64{1}
            }
            x += I64{1}
        }
        y := I64{0}
        loop y < (I64{5}) {
            x = I64{0}
            loop x < (I64{5}) {
                index :: x + I64{5} * y
                target :: y + I64{5} * ((I64{2} * x + I64{3} * y) % I64{5})
                rt_text_store(permuted + target * I64{8}, rt_keccak_rotl(rt_text_word(state + index * I64{8}), rt_keccak_rot(index)))
                x += I64{1}
            }
            y += I64{1}
