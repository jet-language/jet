// TextGlueABI owns private layouts. CAbiRoutes9527-9542/11800-11809/
// 12089-12098/12117-12126: borrowed Text ctor/getters clone E4 owners.
// Reads borrow an initialized aligned word of a live native text diagnostic;
// writes own a word of a fresh one. RawWords.jet performs the access.
text_glue_word: fn(address: I64) -> I64 { rt_text_word(address) }

text_glue_store: fn(address: I64, value: I64) { rt_text_store(address, value) }

text_error_new: fn(message: I64) -> I64 {
    result: jet_rt_alloc(TEXT_ERROR_BYTES, I64{8})
    text_glue_store(wrapping(result + TEXT_ERROR_MESSAGE), jet_rt_string_clone(message))
    result
}

text_error_get: fn(value: I64) -> I64 {
    jet_rt_string_clone(text_glue_word(wrapping(value + TEXT_ERROR_MESSAGE)))
}

text_error_drop: fn(value: I64) {
    if (value == I64{0}) {
        return
    }
    jet_rt_string_drop(text_glue_word(wrapping(value + TEXT_ERROR_MESSAGE)))
    jet_rt_free(value, TEXT_ERROR_BYTES, I64{8})
}

text_error_equal: fn(left: I64, right: I64) -> Bool {
    jet_rt_string_eq(text_glue_word(wrapping(left + TEXT_ERROR_MESSAGE)), text_glue_word(wrapping(right + TEXT_ERROR_MESSAGE)))
}

// CommonTypes6647-6696: all three renders clone the single stored message.
#Export(c) jet_rt_record_new_text_error: fn(message: I64) -> I64 { text_error_new(message) }

#Export(c) jet_rt_record_get_text_error_message: fn(value: I64) -> I64 { text_error_get(value) }

#Export(c) jet_rt_handle_clone_text_error: fn(value: I64) -> I64 {
    text_error_new(text_glue_word(wrapping(value + TEXT_ERROR_MESSAGE)))
}

#Export(c) jet_rt_handle_drop_text_error: fn(value: I64) { text_error_drop(value) }

#Export(c) jet_rt_handle_eq_text_error: fn(left: I64, right: I64) -> Bool {
    text_error_equal(left, right)
}

#Export(c) jet_rt_handle_show_text_error: fn(value: I64) -> I64 { text_error_get(value) }

#Export(c) jet_rt_handle_display_text_error: fn(value: I64) -> I64 { text_error_get(value) }

#Export(c) jet_rt_handle_debug_text_error: fn(value: I64) -> I64 { text_error_get(value) }

#Export(c) jet_rt_record_new_utf8_error: fn(message: I64) -> I64 { text_error_new(message) }

#Export(c) jet_rt_record_get_utf8_error_message: fn(value: I64) -> I64 { text_error_get(value) }

#Export(c) jet_rt_handle_clone_utf8_error: fn(value: I64) -> I64 {
    text_error_new(text_glue_word(wrapping(value + TEXT_ERROR_MESSAGE)))
}

#Export(c) jet_rt_handle_drop_utf8_error: fn(value: I64) { text_error_drop(value) }

#Export(c) jet_rt_handle_eq_utf8_error: fn(left: I64, right: I64) -> Bool {
    text_error_equal(left, right)
}

#Export(c) jet_rt_handle_show_utf8_error: fn(value: I64) -> I64 { text_error_get(value) }

#Export(c) jet_rt_handle_display_utf8_error: fn(value: I64) -> I64 { text_error_get(value) }

#Export(c) jet_rt_handle_debug_utf8_error: fn(value: I64) -> I64 { text_error_get(value) }

#Export(c) jet_rt_record_new_range_error: fn(reason: I64) -> I64 { text_error_new(reason) }

#Export(c) jet_rt_record_get_range_error_reason: fn(value: I64) -> I64 { text_error_get(value) }

#Export(c) jet_rt_handle_clone_range_error: fn(value: I64) -> I64 {
    text_error_new(text_glue_word(wrapping(value + TEXT_ERROR_MESSAGE)))
}

#Export(c) jet_rt_handle_drop_range_error: fn(value: I64) { text_error_drop(value) }

#Export(c) jet_rt_handle_eq_range_error: fn(left: I64, right: I64) -> Bool {
    text_error_equal(left, right)
}

#Export(c) jet_rt_handle_show_range_error: fn(value: I64) -> I64 { text_error_get(value) }

#Export(c) jet_rt_handle_display_range_error: fn(value: I64) -> I64 { text_error_get(value) }

#Export(c) jet_rt_handle_debug_range_error: fn(value: I64) -> I64 { text_error_get(value) }

#Export(c) jet_rt_record_new_field_error: fn(path: I64, reason: I64) -> I64 {
    result: jet_rt_alloc(TEXT_FIELD_BYTES, I64{8})
    text_glue_store(wrapping(result + TEXT_FIELD_PATH), jet_rt_string_clone(path))
    text_glue_store(wrapping(result + TEXT_FIELD_REASON), jet_rt_string_clone(reason))
    result
}

#Export(c) jet_rt_handle_clone_field_error: fn(value: I64) -> I64 {
    jet_rt_record_new_field_error(text_glue_word(wrapping(value + TEXT_FIELD_PATH)), text_glue_word(wrapping(value + TEXT_FIELD_REASON)))
}

#Export(c) jet_rt_handle_drop_field_error: fn(value: I64) {
    if (value == I64{0}) {
        return
    }
    jet_rt_string_drop(text_glue_word(wrapping(value + TEXT_FIELD_PATH)))
    jet_rt_string_drop(text_glue_word(wrapping(value + TEXT_FIELD_REASON)))
    jet_rt_free(value, TEXT_FIELD_BYTES, I64{8})
}

#Export(c) jet_rt_handle_eq_field_error: fn(left: I64, right: I64) -> Bool {
    jet_rt_string_eq(text_glue_word(wrapping(left + TEXT_FIELD_PATH)), text_glue_word(wrapping(right + TEXT_FIELD_PATH))) && jet_rt_string_eq(text_glue_word(wrapping(left + TEXT_FIELD_REASON)), text_glue_word(wrapping(right + TEXT_FIELD_REASON)))
}

#Export(c) jet_rt_record_get_field_error_path: fn(value: I64) -> I64 {
    jet_rt_string_clone(text_glue_word(wrapping(value + TEXT_FIELD_PATH)))
}

#Export(c) jet_rt_record_get_field_error_reason: fn(value: I64) -> I64 {
    jet_rt_string_clone(text_glue_word(wrapping(value + TEXT_FIELD_REASON)))
}

#Export(c) jet_rt_handle_show_field_error: fn(value: I64) -> I64 {
    // FieldError display -> Core/FieldError10-16: byte-exact backtick prefix.
    path: text_glue_word(wrapping(value + TEXT_FIELD_PATH))
    reason: text_glue_word(wrapping(value + TEXT_FIELD_REASON))
    if (rt_text_len(path) == I64{0}) { return jet_rt_string_clone(reason) }
    target: jet_rt_string_builder_new()
    rt_text_push_word(target, I64{1612739681}, I64{4})  // "at `"
    jet_rt_string_builder_push(target, path)
    rt_text_push_word(target, I64{2112096}, I64{3})  // "`: "
    jet_rt_string_builder_push(target, reason)
    jet_rt_string_builder_finish(target)
}

#Export(c) jet_rt_handle_display_field_error: fn(value: I64) -> I64 {
    jet_rt_handle_show_field_error(value)
}

#Export(c) jet_rt_handle_debug_field_error: fn(value: I64) -> I64 {
    jet_rt_handle_show_field_error(value)
}
