// Canonical C marshalling, not a second launch policy. Inputs borrow
// E4/List24/Spec136, except a ProcessSpec a builder route consumes and returns
// changed (ProcessSpec.jet); every returned carrier owns its children.
process_route_text_list: fn(data: I64, length: I64) -> I64 {
    count: if data == (I64{0}) || length <= (I64{0}) -> I64{0} else -> length
    result: data_sequence_new(count, DYN_ELEMENT_BYTES)
    index := I64{0}
    loop index < count {
        process_text_list_push(result, encoding_word(wrapping(data + index * DYN_ELEMENT_BYTES)))
        index += I64{1}
    }
    result
}
process_route_optional_word: fn(present: Bool, value: I64) -> I64 {
    if present -> process_raw_box(value) else -> I64{0}
}
process_route_stream_mode: fn(mode: I64) {
    if mode < PROCESS_STREAM_STREAM || mode > PROCESS_STREAM_STDOUT -> trap_native_index_range_stop()
}
#Export(c) jet_process_spec_fields_raw: fn(cmd: I64, cmd_length: I64, has_cwd: Bool, cwd: I64, env_clear: Bool, names: I64, names_length: I64, values: I64, values_length: I64, removals: I64, removals_length: I64, has_stdin: Bool, stdin: I64, stdout: I64, stderr: I64, has_timeout: Bool, timeout: I64, has_output: Bool, output: I64, has_cpu: Bool, cpu: I64, has_memory: Bool, memory: I64, has_files: Bool, files: I64, detached: Bool, has_terminal: Bool, terminal: I64, has_policy: Bool, policy: I64) -> I64 {
    process_route_stream_mode(stdin)
    process_route_stream_mode(stdout)
    process_route_stream_mode(stderr)
    if jet_scheduler_native_propagate() != (I64{0}) -> return I64{0}
    result: jet_rt_alloc(PROCESS_SPEC_BYTES, I64{8})
    coll_zero(result, PROCESS_SPEC_BYTES)
    encoding_store(wrapping(result + PROCESS_SPEC_CMD), process_route_text_list(cmd, cmd_length))
    encoding_store(wrapping(result + PROCESS_SPEC_CWD), if has_cwd -> jet_rt_string_clone(cwd) else -> I64{0})
    encoding_store(wrapping(result + PROCESS_SPEC_ENV_CLEAR), if env_clear -> I64{1} else -> I64{0})
    // Rust Vec::zip stops at the shorter column; absent pointer means empty.
    name_count: if names == (I64{0}) || names_length <= (I64{0}) -> I64{0} else -> names_length
    value_count: if values == (I64{0}) || values_length <= (I64{0}) -> I64{0} else -> values_length
    count: if name_count < value_count -> name_count else -> value_count
    pairs: data_sequence_new(count, DYN_ENTRY_BYTES)
    index := I64{0}
    loop index < count {
        slot: data_sequence_reserve(pairs, DYN_ENTRY_BYTES)
        encoding_store(wrapping(slot + DYN_ENTRY_KEY), jet_rt_string_clone(encoding_word(wrapping(names + index * DYN_ELEMENT_BYTES))))
        encoding_store(wrapping(slot + DYN_ENTRY_VALUE), jet_rt_string_clone(encoding_word(wrapping(values + index * DYN_ELEMENT_BYTES))))
        encoding_store(wrapping(pairs + DATA_SEQUENCE_LENGTH), index + I64{1})
        index += I64{1}
    }
    encoding_store(wrapping(result + PROCESS_SPEC_ENV_SET), pairs)
    encoding_store(wrapping(result + PROCESS_SPEC_ENV_REMOVE), process_route_text_list(removals, removals_length))
    encoding_store(wrapping(result + PROCESS_SPEC_STDIN), process_route_optional_word(has_stdin, stdin))
    encoding_store(wrapping(result + PROCESS_SPEC_STDOUT), stdout)
    encoding_store(wrapping(result + PROCESS_SPEC_STDERR), stderr)
    encoding_store(wrapping(result + PROCESS_SPEC_TIMEOUT), process_route_optional_word(has_timeout, timeout))
    encoding_store(wrapping(result + PROCESS_SPEC_OUTPUT_LIMIT), process_route_optional_word(has_output, output))
    encoding_store(wrapping(result + PROCESS_SPEC_CPU_TIME_LIMIT), process_route_optional_word(has_cpu, cpu))
    encoding_store(wrapping(result + PROCESS_SPEC_MEMORY_LIMIT), process_route_optional_word(has_memory, memory))
    encoding_store(wrapping(result + PROCESS_SPEC_OPEN_FILE_LIMIT), process_route_optional_word(has_files, files))
    encoding_store(wrapping(result + PROCESS_SPEC_DETACHED), if detached -> I64{1} else -> I64{0})
    encoding_store(wrapping(result + PROCESS_SPEC_TERMINAL), if has_terminal -> jet_rt_handle_clone_terminal_policy(terminal) else -> I64{0})
    encoding_store(wrapping(result + PROCESS_SPEC_POLICY_WIRE), if has_policy -> jet_rt_string_clone(policy) else -> I64{0})
    // The zeroed private directory tail is the original empty inherited Vec.
    result
}
#Export(c) jet_std_process_spec_under: fn(value: I64, authority: I64) -> I64 {
    result: value
    jet_rt_string_drop(encoding_word(wrapping(result + PROCESS_SPEC_POLICY_WIRE)))
    encoding_store(wrapping(result + PROCESS_SPEC_POLICY_WIRE), jet_authority_to_wire(authority))
    encoding_store(wrapping(result + PROCESS_SPEC_ENV_CLEAR), I64{1})
    result
}
process_route_i32: fn(value: I64) -> I64 {
    bits: value.bit_and(I64{4294967295})
    if bits >= (I64{2147483648}) -> bits - I64{4294967296} else -> bits
}
// Whether `spec` already passes a held directory at child slot `target`.
process_spec_directory_slot_taken: fn(spec: I64, target: I64) -> Bool {
    directories: encoding_word(wrapping(spec + PROCESS_SPEC_DIRECTORIES))
    if directories == (I64{0}) -> return false
    index := I64{0}
    loop index < encoding_word(directories) {
        if encoding_word(wrapping(encoding_word(wrapping(directories + I64{16})) + index * I64{24} + I64{8})) == target -> return true
        index += I64{1}
    }
    false
}
#Export(c) jet_process_spec_keep_open_raw: fn(value: I64, source_fd: I64, child_fd: I64, as_cwd: Bool, spec_out: I64, supported_out: I64, assigned_out: I64, errno_out: I64) {
    // Duplicate its lent fd, never reopen a pathname. The spec is consumed:
    // its earlier rows move into the returned one, so each passed descriptor
    // has one owner and closes once. The duplicate is the parent's carrier at
    // or above the child slot; the spawn moves it into the slot, so only a
    // slot this spec already passes is refused (assigned -1, errno 0).
    // A slot outside 3..2147483646 is refused the same way. A negative
    // source is a handle with no descriptor (EBADF), or
    // PROCESS_KEEP_REFUSED_UNSUPPORTED for a handle this runtime cannot keep.
    // The spec records its first refusal for launch to report.
    result: value
    target: process_route_i32(child_fd)
    assigned := I64{-1}
    error := I64{0}
    refusal := I64{0}
    if (source_fd == PROCESS_KEEP_REFUSED_UNSUPPORTED) {
        refusal = PROCESS_KEEP_REFUSED_UNSUPPORTED
    } else if (source_fd < I64{0}) {
        error = I64{9}
        refusal = error
    } else if (child_fd < I64{3} || child_fd > I64{2147483646}) {
        refusal = PROCESS_KEEP_REFUSED_SLOT
    } else if process_spec_directory_slot_taken(result, target) {
        refusal = PROCESS_KEEP_REFUSED_TAKEN
    } else {
        duplicated: host_call(I64{72}, process_route_i32(source_fd), I64{1030}, target)
        if duplicated < (I64{0}) {
            error = -duplicated
            refusal = error
        } else {
            assigned = duplicated
            directory: jet_fd_adopt_unbuffered_raw(duplicated, I64{0})
            directories := encoding_word(wrapping(result + PROCESS_SPEC_DIRECTORIES))
            if directories == (I64{0}) {
                directories = data_sequence_new(I64{1}, I64{24})
                encoding_store(wrapping(result + PROCESS_SPEC_DIRECTORIES), directories)
            }
            slot: data_sequence_reserve(directories, I64{24})
            encoding_store(slot, directory)
            encoding_store(wrapping(slot + I64{8}), target)
            encoding_store(wrapping(slot + I64{16}), if as_cwd -> I64{1} else -> I64{0})
            encoding_store(wrapping(directories + DATA_SEQUENCE_LENGTH), encoding_word(wrapping(directories + DATA_SEQUENCE_LENGTH)) + I64{1})
        }
    }
    if (refusal != I64{0} && encoding_word(wrapping(result + PROCESS_SPEC_KEEP_REFUSAL)) == I64{0}) -> encoding_store(wrapping(result + PROCESS_SPEC_KEEP_REFUSAL), refusal)
    encoding_store(spec_out, result)
    // bool is exactly one C byte; do not overwrite adjacent caller storage.
    #Unsafe("supported_out lends exactly one writable C bool byte; Linux implements F_DUPFD_CLOEXEC") {
        os_store_u8(supported_out, I64{1})
    }
    encoding_store(assigned_out, assigned)
    encoding_store(errno_out, error)
}
