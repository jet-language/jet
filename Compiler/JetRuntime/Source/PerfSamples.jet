// `jet perf run` (JetCLI CLI/Perf/Session.jet): the program's samples. When
// JET_PERF_SAMPLES names a file, the observation start (ObserveLive.jet
// jet_rt_observe_runtime_start_from_env) opens it and, under the `cpu` lens
// (JET_PERF_LENSES), arms the process's profiling timer (setitimer
// ITIMER_PROF), which sends SIGPROF for each PERF_SAMPLES_INTERVAL_US of
// CPU time the process uses, to the thread that was running. Each SIGPROF
// appends one record: the program counter it interrupted, then the call
// site of each caller, innermost first, each less the image's load bias:
// by the image's call frame information through frames without a frame
// pointer, then up the frame pointer chain. Each is a link-time address in
// the image `jet run` writes beside the file, where the image's location
// table names its function and line, as Linux perf names the same image's
// samples. A record is one write of little-endian words; its first word
// holds the record's word count in bits 48..58 above the program counter's
// low 48, and its kind in bits 59..62: 0 for a CPU-time sample, a
// counter's index plus one for that counter's sample, PERF_SAMPLES_SPAWN
// for a task's spawn and PERF_SAMPLES_JOIN for a join's wait. The handler
// allocates nothing and never waits. Beside the samples, `<samples>.spans`
// keeps a row for each core.log span the program closes (RouteALog.jet
// log_span_row_write).
//
// Under the `memory` lens, which JET_PERF_LENSES names as it names `cpu`,
// the start opens four counters of the thread that starts the observation,
// the program's main thread, each with perf_event_open to count in user
// mode only, and has each signal that thread with PERF_COUNTERS_SIGNAL, its
// descriptor in the siginfo, once per its period of events. The same
// handler appends a record like a CPU-time sample's for it, of the
// counter's kind, then arms the counter for its next period
// (PERF_EVENT_IOC_REFRESH). `<samples>.counters` keeps two words for each
// counter in order: its period, or 0, and the errno the kernel refused it
// with, or 0. Other threads' events are not counted. The `memory` lens
// without `cpu` arms no profiling timer, so the file holds no CPU-time
// sample.

// O_WRONLY|O_CREAT|O_APPEND|O_CLOEXEC.
PERF_SAMPLES_OPEN: I64{525377}

PERF_SAMPLES_SIGNAL: I64{27}

// One sample per millisecond of CPU time.
PERF_SAMPLES_INTERVAL_US: I64{1000}

// The most words one record keeps: its program counter and the call sites
// of its innermost callers.
PERF_SAMPLES_DEPTH: I64{1024}

// A record's first word: the word count above bit 48, the address below.
PERF_SAMPLES_ADDRESS_BITS: I64{48}

PERF_SAMPLES_ADDRESS_MASK: I64{281474976710655}

// A record's first word: its kind above bit 59, its word count below.
PERF_SAMPLES_KIND_BITS: I64{59}

// The kinds of a task's spawn record (perf_samples_spawn) and of a join's
// wait record (perf_samples_join), above every counter's.
PERF_SAMPLES_SPAWN: I64{15}

PERF_SAMPLES_JOIN: I64{14}

// The most call sites a spawn record keeps.
PERF_SAMPLES_SPAWN_DEPTH: I64{32}

// A realtime signal, so that each counter's overflow is queued with its
// own siginfo, never merged with another's or with SIGPROF.
PERF_COUNTERS_SIGNAL: I64{63}

// L1D, LLC and dTLB read misses, and page faults.
PERF_COUNTERS_COUNT: I64{4}

// The lenses JET_PERF_LENSES names, one bit each: `cpu`, the CPU-time
// samples, and `memory`, the counters. The session writes `cpu`, `memory`
// or `cpu,memory`; a run without it samples CPU time alone.
PERF_LENS_CPU: I64{1}

PERF_LENS_MEMORY: I64{2}

// The samples file, -1 until the start opens it, and the bias its addresses
// are taken less.
perf_samples_fd := I64{-1}

perf_samples_bias := I64{0}

// The image's code at link time, [low, high): a frame whose address is in
// it is Jet code or a C library function of the image, which the call frame
// information or the frame pointer chain walks.
perf_samples_code_low := I64{0}

perf_samples_code_high := I64{0}

// The record buffer: its first word is 1 while a handler fills the
// PERF_SAMPLES_DEPTH words after it; 0 when the start could not map it.
// After them come the PERF_COUNTERS_COUNT counters' descriptors, -1 for
// one that is not open.
perf_samples_buffer := I64{0}

// The log spans file, `<samples>.spans`, -1 unless the start opened it.
perf_spans_fd := I64{-1}

// Start sampling when JET_PERF_SAMPLES names a file; once per process.
perf_samples_start: fn() {
    if (perf_samples_fd >= I64{0}) {
        return
    }
    path: rt_env_get(env_name_jet_perf_samples())
    if (path == I64{0}) {
        return
    }
    lenses: perf_samples_lenses()
    fd := I64{-1}
    counters := I64{-1}
    if (rt_text_len(path) != I64{0}) {
        name: fd_c_path(path)
        fd = host_call(I64{2}, name, PERF_SAMPLES_OPEN, I64{384})
        fd_c_path_drop(name, path)
        if (fd >= I64{0}) {
            perf_spans_fd_set(perf_samples_open_beside(path, rt_static_text(".spans")))
            counters = perf_counters_open(path, lenses)
        }
    }
    jet_rt_string_drop(path)
    if (fd < I64{0}) {
        return
    }
    image: alloc_check_image()
    bias: alloc_check_bias(image)
    low: perf_samples_code_edge(image, false)
    high: perf_samples_code_edge(image, true)
    perf_cfi_start(image)
    buffer: alloc_map_try(wrapping(wrapping(wrapping(PERF_SAMPLES_DEPTH + I64{1}) + PERF_COUNTERS_COUNT) * I64{8}))
    #Unsafe("the observation start runs before the timer whose handler reads these is armed") {
        perf_samples_bias = bias
        perf_samples_code_low = low
        perf_samples_code_high = high
        perf_samples_buffer = buffer
        perf_samples_fd = fd
    }
    status := I64{0}
    // sa_flags SA_SIGINFO | SA_RESTORER | SA_ONSTACK | SA_RESTART: the
    // handler reads the interrupted context, runs on the thread's alternate
    // signal stack where it has one, and an interrupted system call resumes.
    #Unsafe("rt_sigaction borrows the four-word action on the stack; the handler is this runtime's three-word C-ABI export and the restorer its rt_sigreturn rail") {
        status = os_syscall_stack4_i64(I64{13}, PERF_SAMPLES_SIGNAL, rt_perf_samples_signal_address(), I64{469762052}, rt_process_signal_restore_address(), I64{0}, I64{8})
    }
    if (status >= I64{0} && (lenses & PERF_LENS_CPU) != I64{0}) {
        // The itimerval: the interval, then the first expiry, each as
        // seconds and microseconds; no old value is read back.
        #Unsafe("setitimer borrows the four-word itimerval on the stack") {
            status = os_syscall_stack4_i64(I64{38}, I64{2}, I64{0}, PERF_SAMPLES_INTERVAL_US, I64{0}, PERF_SAMPLES_INTERVAL_US, I64{0})
        }
    }
    if (status < I64{0}) {
        #Unsafe("no timer is armed, so no handler reads the descriptor") {
            perf_samples_fd = I64{-1}
        }
        _ := host_call(I64{3}, fd, I64{0}, I64{0})
        if (counters >= I64{0}) { _ := host_call(I64{3}, counters, I64{0}, I64{0}) }
        return
    }
    perf_counters_start(buffer, counters)
}

// The file `<samples><suffix>`, opened to append to as the samples file is,
// or -1 when it cannot be.
perf_samples_open_beside: fn(samples: I64, suffix: I64) -> I64 {
    builder: jet_rt_string_builder_new()
    jet_rt_string_builder_push(builder, samples)
    jet_rt_string_builder_push(builder, suffix)
    path: jet_rt_string_builder_finish(builder)
    name: fd_c_path(path)
    fd: host_call(I64{2}, name, PERF_SAMPLES_OPEN, I64{384})
    fd_c_path_drop(name, path)
    jet_rt_string_drop(path)
    fd
}

// Keep `<samples>.spans` for the closed log spans' rows; a file that cannot
// be opened (-1) leaves the spans without rows, as before.
perf_spans_fd_set: fn(fd: I64) {
    if (fd < I64{0}) {
        return
    }
    #Unsafe("the observation start runs before the entry, whose span closes read it") {
        perf_spans_fd = fd
    }
}

// The record of task `id`'s spawn, under `jet perf run`: the id in place of
// a sample's program counter, then the call site of each caller up the
// spawning thread's frame pointer chain, innermost first, each less the
// load bias, while it is Jet code (Alloc.jet alloc_check_frames). `jet perf
// run` names the task's spawn by the innermost of them on a line of the
// checked source.
perf_samples_spawn: fn(id: I64) {
    fd: perf_samples_fd
    if (fd < I64{0} || id == I64{0}) {
        return
    }
    size: wrapping(wrapping(PERF_SAMPLES_SPAWN_DEPTH + I64{1}) * I64{8})
    record: jet_rt_alloc(size, I64{8})
    chain: wrapping(record + I64{8})
    alloc_check_frames(chain, PERF_SAMPLES_SPAWN_DEPTH)
    bias: perf_samples_bias
    count := I64{0}
    loop count < PERF_SAMPLES_SPAWN_DEPTH {
        address: rt_text_word(wrapping(chain + wrapping(count * I64{8})))
        if (address == I64{0}) { break }
        site: wrapping(wrapping(address - I64{1}) - bias)
        if (!perf_samples_in_code(site)) { break }
        rt_text_store(wrapping(chain + wrapping(count * I64{8})), site)
        count = wrapping(count + I64{1})
    }
    words: wrapping(count + I64{1})
    rt_text_store(record, (id & PERF_SAMPLES_ADDRESS_MASK) | (words << PERF_SAMPLES_ADDRESS_BITS) | (PERF_SAMPLES_SPAWN << PERF_SAMPLES_KIND_BITS))
    _ := host_write_all(fd, record, wrapping(words * I64{8}))
    jet_rt_free(record, size, I64{8})
}

// The record of a join's wait, under `jet perf run`: the joining task's id
// in place of a sample's program counter, then the awaited task's id and
// the wait's start (`start`) and end on the monotonic clock, the clock of
// the log spans' rows.
perf_samples_join: fn(joiner: I64, awaited: I64, start: I64) {
    fd: perf_samples_fd
    if (fd < I64{0} || awaited == I64{0}) {
        return
    }
    record: jet_rt_alloc(I64{32}, I64{8})
    rt_text_store(record, (joiner & PERF_SAMPLES_ADDRESS_MASK) | (I64{4} << PERF_SAMPLES_ADDRESS_BITS) | (PERF_SAMPLES_JOIN << PERF_SAMPLES_KIND_BITS))
    rt_text_store(wrapping(record + I64{8}), awaited)
    rt_text_store(wrapping(record + I64{16}), start)
    rt_text_store(wrapping(record + I64{24}), time_host_monotonic_i64())
    _ := host_write_all(fd, record, I64{32})
    jet_rt_free(record, I64{32}, I64{8})
}

// The lenses JET_PERF_LENSES names: `cpu` when it starts with `cpu`,
// `memory` when it ends with `memory`; `cpu` alone when it is unset.
perf_samples_lenses: fn() -> I64 {
    value: rt_env_get(env_name_jet_perf_lenses())
    if (value == I64{0}) { return PERF_LENS_CPU }
    len: rt_text_len(value)
    data: rt_text_data(value)
    lenses := I64{0}
    if (len >= I64{3} && rt_text_equal_bytes(data, rt_text_data(rt_static_text("cpu")), I64{3})) {
        lenses = wrapping(lenses + PERF_LENS_CPU)
    }
    if (len >= I64{6} && rt_text_equal_bytes(wrapping(data + wrapping(len - I64{6})), rt_text_data(rt_static_text("memory")), I64{6})) {
        lenses = wrapping(lenses + PERF_LENS_MEMORY)
    }
    jet_rt_string_drop(value)
    lenses
}

// `<samples>.counters` when `lenses` hold the memory lens, else -1.
perf_counters_open: fn(samples: I64, lenses: I64) -> I64 {
    if ((lenses & PERF_LENS_MEMORY) == I64{0}) { return I64{-1} }
    perf_samples_open_beside(samples, rt_static_text(".counters"))
}

// The perf_event_attr type, config and sample period of counter `index`:
// L1D, LLC and dTLB read misses (PERF_TYPE_HW_CACHE, the cache's id | read
// << 8 | miss << 16), then page faults (PERF_TYPE_SOFTWARE PAGE_FAULTS).
// The periods are primes, so that a sample does not keep landing on the
// same iteration of a loop.
perf_counter_type: fn(index: I64) -> I64 {
    if (index == I64{3}) { return I64{1} }
    I64{3}
}

perf_counter_config: fn(index: I64) -> I64 {
    if (index == I64{0}) { return I64{65536} }
    if (index == I64{1}) { return I64{65538} }
    if (index == I64{2}) { return I64{65539} }
    I64{2}
}

perf_counter_period: fn(index: I64) -> I64 {
    if (index == I64{0}) { return I64{10007} }
    if (index == I64{3}) { return I64{1} }
    I64{1009}
}

// The raw event (PERF_TYPE_RAW) that counts LLC read misses where the
// kernel has no generic one: on AMD family 19h and later (Zen 3, 4 and 5),
// whose core PMU refuses the generic event with ENOENT, event 0x43
// (ls_dmnd_fills_from_sys) with every source past the core's own L2 and L3
// in its unit mask (0xFC): the demand data-cache fills from another CCX's
// cache or from DRAM, each a demand read that missed the LLC. 0 on any
// other CPU. "AuthenticAMD" is CPUID.0's EBX, EDX, ECX: "Auth", "enti",
// "cAMD".
perf_counter_llc_raw: fn() -> I64 {
    #Unsafe("cpuid only reports processor identification") {
        amd: os_cpuid_ebx_i64(I64{0}, I64{0}) == I64{1752462657} && os_cpuid_edx_i64(I64{0}, I64{0}) == I64{1769238117} && os_cpuid_ecx_i64(I64{0}, I64{0}) == I64{1145913699}
        if (!amd) { return I64{0} }
        signature: os_cpuid_eax_i64(I64{1}, I64{0})
        family: wrapping(((signature >> I64{8}) & I64{15}) + ((signature >> I64{20}) & I64{255}))
        if (family < I64{25}) { return I64{0} }
    }
    I64{64579}
}

// The counters' descriptors in the record buffer `buffer`.
perf_counters_table: fn(buffer: I64) -> I64 {
    wrapping(buffer + wrapping(wrapping(PERF_SAMPLES_DEPTH + I64{1}) * I64{8}))
}

// Open and arm each counter on this thread, the handler installed for
// PERF_COUNTERS_SIGNAL first, and write each one's period or errno to
// `file` (`<samples>.counters`, or -1 when none was asked for). A buffer
// that could not be mapped leaves every counter unavailable (ENOMEM). The
// start holds the record buffer meanwhile, as a handler does, since it
// builds each counter's attribute words in it.
perf_counters_start: fn(buffer: I64, file: I64) {
    if (file < I64{0}) {
        return
    }
    status := I64{-12}
    if (buffer != I64{0}) {
        #Unsafe("rt_sigaction borrows the four-word action on the stack; the handler is this runtime's three-word C-ABI export and the restorer its rt_sigreturn rail") {
            status = os_syscall_stack4_i64(I64{13}, PERF_COUNTERS_SIGNAL, rt_perf_samples_signal_address(), I64{469762052}, rt_process_signal_restore_address(), I64{0}, I64{8})
        }
    }
    if (status >= I64{0}) {
        loop {
            if (sync_cas(buffer, I64{0}, I64{1}) == I64{0}) { break }
        }
        index := I64{0}
        loop index < PERF_COUNTERS_COUNT {
            rt_text_store(wrapping(perf_counters_table(buffer) + wrapping(index * I64{8})), I64{-1})
            index = wrapping(index + I64{1})
        }
    }
    tid: thread_tid()
    index := I64{0}
    loop index < PERF_COUNTERS_COUNT {
        result := status
        if (status >= I64{0}) { result = perf_counter_arm(buffer, index, tid) }
        period := I64{0}
        errno := I64{0}
        if (result >= I64{0}) { period = perf_counter_period(index) } else {
            errno = wrapping(I64{0} - result)
        }
        #Unsafe("two writes of a stack-local word, which the kernel copies before each call returns") {
            _ := os_write_word_i64(file, period, I64{8})
            _ := os_write_word_i64(file, errno, I64{8})
        }
        index = wrapping(index + I64{1})
    }
    if (status >= I64{0}) { sync_store(buffer, I64{0}) }
    _ := host_call(I64{3}, file, I64{0}, I64{0})
}

// Open counter `index` on this thread (`tid`), its attribute words built in
// `buffer`, have it signal this thread at each overflow and arm it for its
// first period; its descriptor goes in the table before it is armed. An LLC
// counter the kernel has no generic event for (ENOENT) opens the CPU's raw
// one instead, where perf_counter_llc_raw knows it. 0, or the negated errno
// of the call the kernel refused.
perf_counter_arm: fn(buffer: I64, index: I64, tid: I64) -> I64 {
    attr: wrapping(buffer + I64{8})
    fd := perf_counter_event_open(attr, perf_counter_type(index), perf_counter_config(index), perf_counter_period(index))
    if (fd == I64{-2} && index == I64{1}) {
        raw: perf_counter_llc_raw()
        if (raw != I64{0}) {
            fd = perf_counter_event_open(attr, I64{4}, raw, perf_counter_period(index))
        }
    }
    if (fd < I64{0}) { return fd }
    result := I64{0}
    // fcntl F_SETFL O_ASYNC, F_SETSIG PERF_COUNTERS_SIGNAL, then
    // F_SETOWN_EX with the f_owner_ex {F_OWNER_TID, tid}: each overflow
    // signals this thread, the descriptor in its siginfo.
    #Unsafe("fcntl reads the two-word f_owner_ex the held buffer keeps") {
        result = os_syscall_i64(I64{72}, fd, I64{4}, I64{8192}, I64{0}, I64{0}, I64{0})
        if (result >= I64{0}) {
            result = os_syscall_i64(I64{72}, fd, I64{10}, PERF_COUNTERS_SIGNAL, I64{0}, I64{0}, I64{0})
        }
        if (result >= I64{0}) {
            rt_text_store(attr, tid << I64{32})
            result = os_syscall_i64(I64{72}, fd, I64{15}, attr, I64{0}, I64{0}, I64{0})
        }
    }
    slot: wrapping(perf_counters_table(buffer) + wrapping(index * I64{8}))
    if (result >= I64{0}) {
        rt_text_store(slot, fd)
        result = perf_counter_refresh(fd)
    }
    if (result < I64{0}) {
        rt_text_store(slot, I64{-1})
        _ := host_call(I64{3}, fd, I64{0}, I64{0})
        return result
    }
    I64{0}
}

// perf_event_open of the counter of type `kind`, `config` and `period` on
// this thread, any CPU, no group, PERF_FLAG_FD_CLOEXEC, its attribute words
// built at `attr`: perf_event_attr's first 64 bytes (PERF_ATTR_SIZE_VER0),
// its type and size, config, sample_period, sample_type and read_format,
// then its flags, disabled | exclude_kernel | exclude_hv, the rest zero. Its
// descriptor, or the negated errno.
perf_counter_event_open: fn(attr: I64, kind: I64, config: I64, period: I64) -> I64 {
    rt_text_store(attr, kind | (I64{64} << I64{32}))
    rt_text_store(wrapping(attr + I64{8}), config)
    rt_text_store(wrapping(attr + I64{16}), period)
    rt_text_store(wrapping(attr + I64{24}), I64{0})
    rt_text_store(wrapping(attr + I64{32}), I64{0})
    rt_text_store(wrapping(attr + I64{40}), I64{97})
    rt_text_store(wrapping(attr + I64{48}), I64{0})
    rt_text_store(wrapping(attr + I64{56}), I64{0})
    #Unsafe("perf_event_open reads the attribute words the held buffer keeps") {
        return os_syscall_i64(I64{298}, attr, I64{0}, I64{-1}, I64{-1}, I64{8}, I64{0})
    }
}

// Arm counter descriptor `fd` for one more overflow (PERF_EVENT_IOC_REFRESH
// 1): at it the kernel disables the counter and signals the thread.
perf_counter_refresh: fn(fd: I64) -> I64 {
    #Unsafe("ioctl PERF_EVENT_IOC_REFRESH takes its count as a word") {
        return os_syscall_i64(I64{16}, fd, I64{9218}, I64{1}, I64{0}, I64{0}, I64{0})
    }
}

// Arm counter `counter` (an index, or -1 for a CPU-time sample) for its
// next period, after the handler wrote its sample.
perf_counter_rearm: fn(buffer: I64, counter: I64) {
    if (counter < I64{0}) {
        return
    }
    _ := perf_counter_refresh(rt_text_word(wrapping(perf_counters_table(buffer) + wrapping(counter * I64{8}))))
}

// The index of the counter whose overflow `info` reports (a siginfo of
// si_code POLL_IN..POLL_HUP, si_fd at 24 a counter's descriptor), or -1.
perf_counter_of: fn(info: I64, buffer: I64) -> I64 {
    if (info == I64{0} || buffer == I64{0}) { return I64{-1} }
    code: rt_text_word(wrapping(info + I64{8})) & I64{4294967295}
    if (code < I64{1} || code > I64{6}) { return I64{-1} }
    fd: rt_text_word(wrapping(info + I64{24})) & I64{4294967295}
    table: perf_counters_table(buffer)
    index := I64{0}
    loop index < PERF_COUNTERS_COUNT {
        if (rt_text_word(wrapping(table + wrapping(index * I64{8}))) == fd) { return index }
        index = wrapping(index + I64{1})
    }
    I64{-1}
}

// Checked FunctionAddress intrinsic in the canonical RuntimeLibrary table.
rt_perf_samples_signal_address: fn() -> I64 {
    loop { jet_rt_unreachable(I64{0}, I64{0}) }
}

// The first byte (`end` false) or the end (`end` true) of the executable
// segments (PT_LOAD with PF_X) of the ELF64 file `image` (alloc_check_image,
// a read-only mapping of the whole file, its program header table inside
// it), as link-time addresses; 0 when it has none. A `jet run` image keeps
// the program's code in a segment of its own after the runtime's, so the
// code is every such segment, not the first.
perf_samples_code_edge: fn(image: I64, end: Bool) -> I64 {
    if (image == I64{0}) { return I64{0} }
    // e_phoff; e_phentsize is bits 48..63 of the word at 48, e_phnum bits
    // 0..15 of the word at 56.
    table: rt_text_word(wrapping(image + I64{32}))
    entry: (rt_text_word(wrapping(image + I64{48})) >> I64{48}) & I64{65535}
    count: rt_text_word(wrapping(image + I64{56})) & I64{65535}
    edge := I64{0}
    index := I64{0}
    loop index < count {
        header: wrapping(image + wrapping(table + wrapping(index * entry)))
        kind: rt_text_word(header)
        if (kind & I64{4294967295} == I64{1} && (kind >> I64{32}) & I64{1} != I64{0}) {
            // p_vaddr and p_memsz of the program header.
            start: rt_text_word(wrapping(header + I64{16}))
            if (end) {
                last: wrapping(start + rt_text_word(wrapping(header + I64{40})))
                if (last > edge) { edge = last }
            } else if (edge == I64{0} || start < edge) { edge = start }
        }
        index = wrapping(index + I64{1})
    }
    edge
}

// Whether link-time address `address` is in the image's code.
perf_samples_in_code: fn(address: I64) -> Bool {
    address >= perf_samples_code_low && address < perf_samples_code_high
}

// Code without a frame pointer chain (an O2 leaf like the stop poll, the
// frame-free prefix before a function's `push rbp`, a C library function)
// unwinds by the image's call frame information (.eh_frame), which the
// backend writes for every Jet function and the C objects bring with
// theirs. The start reads each FDE into a table of [begin, end) link-time
// ranges and the FDE's address in the image mapping, sorted by begin; the
// handler finds the sample's FDE, runs its CIE's and its own rules up to the
// address, and steps out through rsp-based frames until a frame keeps rbp,
// where the frame pointer walk takes over. 0 when the image has none.
perf_cfi_table := I64{0}

perf_cfi_count := I64{0}

// One page the handler interprets an FDE's rules in, while it holds the
// record buffer (perf_samples_buffer's first word), so one thread at a time.
perf_cfi_scratch := I64{0}

// The scratch page's words: the read cursor, the CIE's code and data
// alignment, return address column and pointer encoding, whether it has
// augmentation data ('z'), then the rule row (CFA register and offset, rbp's
// and the return address's rule and offset), the CIE's initial rbp and
// return address rules (DW_CFA_restore), and the remember stack's depth and
// rows.
PERF_CFI_CURSOR: I64{0}

PERF_CFI_CODE_ALIGN: I64{8}

PERF_CFI_DATA_ALIGN: I64{16}

PERF_CFI_RA_COLUMN: I64{24}

PERF_CFI_ENCODING: I64{32}

PERF_CFI_AUGMENTED: I64{40}

PERF_CFI_ROW: I64{48}

PERF_CFI_CFA_REG: I64{48}

PERF_CFI_CFA_OFFSET: I64{56}

PERF_CFI_RBP_RULE: I64{64}

PERF_CFI_RBP_OFFSET: I64{72}

PERF_CFI_RA_RULE: I64{80}

PERF_CFI_RA_OFFSET: I64{88}

PERF_CFI_INITIAL: I64{96}

PERF_CFI_DEPTH: I64{128}

PERF_CFI_STACK: I64{136}

// A rule row's bytes, and the most rows DW_CFA_remember_state keeps.
PERF_CFI_ROW_BYTES: I64{48}

PERF_CFI_STACK_ROWS: I64{4}

// A register's rule: unchanged from the caller (same value), saved at CFA +
// offset, or one the unwinder cannot follow.
PERF_CFI_SAME: I64{0}

PERF_CFI_SAVED: I64{1}

PERF_CFI_UNKNOWN: I64{2}

// The DWARF x86-64 numbers of rbp and rsp.
PERF_CFI_RBP: I64{6}

PERF_CFI_RSP: I64{7}

// A pointer the unwinder cannot decode.
PERF_CFI_BAD: I64{-1}

perf_cfi_u16: fn(at: I64) -> I64 {
    rt_text_byte(at) | (rt_text_byte(wrapping(at + I64{1})) << I64{8})
}

perf_cfi_u32: fn(at: I64) -> I64 {
    perf_cfi_u16(at) | (perf_cfi_u16(wrapping(at + I64{2})) << I64{16})
}

perf_cfi_u64: fn(at: I64) -> I64 {
    perf_cfi_u32(at) | (perf_cfi_u32(wrapping(at + I64{4})) << I64{32})
}

// The byte at the scratch page's cursor, which moves past it.
perf_cfi_byte: fn(scratch: I64) -> I64 {
    at: rt_text_word(scratch)
    rt_text_store(scratch, wrapping(at + I64{1}))
    rt_text_byte(at)
}

// The unsigned (`signed` false) or signed LEB128 number at the cursor.
perf_cfi_leb: fn(scratch: I64, signed: Bool) -> I64 {
    value := I64{0}
    shift := I64{0}
    byte := I64{0}
    more := true
    loop more {
        byte = perf_cfi_byte(scratch)
        if (shift < I64{64}) { value = value | ((byte & I64{127}) << shift) }
        shift = wrapping(shift + I64{7})
        more = byte & I64{128} != I64{0}
    }
    if (signed && shift < I64{64} && byte & I64{64} != I64{0}) {
        value = value | wrapping(I64{0} - (I64{1} << shift))
    }
    value
}

// The bytes a pointer in `encoding` takes: its low four bits; 0 for a
// format the unwinder does not read.
perf_cfi_pointer_size: fn(encoding: I64) -> I64 {
    format: encoding & I64{15}
    if {
        (format == I64{0} || format == I64{4} || format == I64{12}) -> I64{8}
        (format == I64{3} || format == I64{11}) -> I64{4}
        (format == I64{2} || format == I64{10}) -> I64{2}
        else -> I64{0}
    }
}

// The pointer in `encoding` at the cursor, which moves past it: absolute,
// or relative to its own field, whose link-time address is `address` plus
// its distance from `bytes`, the section's first byte in the mapping.
// PERF_CFI_BAD for an encoding the unwinder does not read.
perf_cfi_pointer: fn(scratch: I64, encoding: I64, bytes: I64, address: I64) -> I64 {
    at: rt_text_word(scratch)
    size: perf_cfi_pointer_size(encoding)
    if (size == I64{0}) { return PERF_CFI_BAD }
    format: encoding & I64{15}
    value := if {
        (size == I64{8}) -> perf_cfi_u64(at)
        (size == I64{4}) -> perf_cfi_u32(at)
        else -> perf_cfi_u16(at)
    }
    if (format == I64{11} && value >= I64{2147483648}) { value = wrapping(value - I64{4294967296}) }
    if (format == I64{10} && value >= I64{32768}) { value = wrapping(value - I64{65536}) }
    rt_text_store(scratch, wrapping(at + size))
    application: encoding & I64{112}
    if (application == I64{16}) {
        return wrapping(value + wrapping(address + wrapping(at - bytes)))
    }
    if (application != I64{0}) { return PERF_CFI_BAD }
    value
}

// Give register `register` the rule `rule` at CFA + `offset`; only rbp and
// the return address are followed.
perf_cfi_set: fn(scratch: I64, register: I64, rule: I64, offset: I64) {
    at: if {
        (register == PERF_CFI_RBP) -> PERF_CFI_RBP_RULE
        (register == rt_text_word(wrapping(scratch + PERF_CFI_RA_COLUMN))) -> PERF_CFI_RA_RULE
        else -> I64{-1}
    }
    if (at < I64{0}) {
        return
    }
    rt_text_store(wrapping(scratch + at), rule)
    rt_text_store(wrapping(scratch + wrapping(at + I64{8})), offset)
}

// DW_CFA_restore: register `register` takes its rule after the CIE's
// initial instructions back.
perf_cfi_restore: fn(scratch: I64, register: I64) {
    initial: wrapping(scratch + PERF_CFI_INITIAL)
    if {
        (register == PERF_CFI_RBP) -> {
            perf_cfi_set(scratch, register, rt_text_word(initial), rt_text_word(wrapping(initial + I64{8})))
        }
        else -> {
            perf_cfi_set(scratch, register, rt_text_word(wrapping(initial + I64{16})), rt_text_word(wrapping(initial + I64{24})))
        }
    }
}

// Copy one rule row of PERF_CFI_ROW_BYTES from `source` to `target`.
perf_cfi_copy_row: fn(target: I64, source: I64) {
    at := I64{0}
    loop at < PERF_CFI_ROW_BYTES {
        rt_text_store(wrapping(target + at), rt_text_word(wrapping(source + at)))
        at = wrapping(at + I64{8})
    }
}

// Run the call frame instructions from the cursor to `end`, the first row
// at link-time address `location`, until the row that holds `target`.
// False on an instruction the unwinder does not follow.
perf_cfi_run: fn(scratch: I64, end: I64, location: I64, target: I64) -> Bool {
    code_align: rt_text_word(wrapping(scratch + PERF_CFI_CODE_ALIGN))
    data_align: rt_text_word(wrapping(scratch + PERF_CFI_DATA_ALIGN))
    at := location
    loop rt_text_word(scratch) < end {
        op: perf_cfi_byte(scratch)
        high: op & I64{192}
        low: op & I64{63}
        advance := I64{-1}
        if {
            (high == I64{64}) -> advance = low
            (high == I64{128}) -> perf_cfi_set(scratch, low, PERF_CFI_SAVED, wrapping(perf_cfi_leb(scratch, false) * data_align))
            (high == I64{192}) -> perf_cfi_restore(scratch, low)
            (op == I64{0}) -> {}
            (op == I64{2}) -> advance = perf_cfi_byte(scratch)
            (op == I64{3}) -> {
                advance = perf_cfi_u16(rt_text_word(scratch))
                rt_text_store(scratch, wrapping(rt_text_word(scratch) + I64{2}))
            }
            (op == I64{4}) -> {
                advance = perf_cfi_u32(rt_text_word(scratch))
                rt_text_store(scratch, wrapping(rt_text_word(scratch) + I64{4}))
            }
            (op == I64{5} || op == I64{17} || op == I64{47}) -> {
                // offset_extended, offset_extended_sf, GNU_negative_offset_extended.
                register: perf_cfi_leb(scratch, false)
                factored: perf_cfi_leb(scratch, op == I64{17})
                offset: wrapping(factored * data_align)
                perf_cfi_set(scratch, register, PERF_CFI_SAVED, if (op == I64{47}) -> wrapping(I64{0} - offset) else -> offset)
            }
            (op == I64{6}) -> perf_cfi_restore(scratch, perf_cfi_leb(scratch, false))
            (op == I64{7} || op == I64{9} || op == I64{20} || op == I64{21}) -> {
                // undefined, register, val_offset, val_offset_sf: a rule the
                // unwinder does not follow for rbp or the return address.
                register: perf_cfi_leb(scratch, false)
                if (op != I64{7}) { _ := perf_cfi_leb(scratch, op == I64{21}) }
                perf_cfi_set(scratch, register, PERF_CFI_UNKNOWN, I64{0})
            }
            (op == I64{8}) -> perf_cfi_set(scratch, perf_cfi_leb(scratch, false), PERF_CFI_SAME, I64{0})
            (op == I64{10}) -> {
                depth: rt_text_word(wrapping(scratch + PERF_CFI_DEPTH))
                if (depth >= PERF_CFI_STACK_ROWS) { return false }
                perf_cfi_copy_row(wrapping(scratch + wrapping(PERF_CFI_STACK + wrapping(depth * PERF_CFI_ROW_BYTES))), wrapping(scratch + PERF_CFI_ROW))
                rt_text_store(wrapping(scratch + PERF_CFI_DEPTH), wrapping(depth + I64{1}))
            }
            (op == I64{11}) -> {
                depth: rt_text_word(wrapping(scratch + PERF_CFI_DEPTH))
                if (depth <= I64{0}) { return false }
                perf_cfi_copy_row(wrapping(scratch + PERF_CFI_ROW), wrapping(scratch + wrapping(PERF_CFI_STACK + wrapping(wrapping(depth - I64{1}) * PERF_CFI_ROW_BYTES))))
                rt_text_store(wrapping(scratch + PERF_CFI_DEPTH), wrapping(depth - I64{1}))
            }
            (op == I64{12} || op == I64{18}) -> {
                rt_text_store(wrapping(scratch + PERF_CFI_CFA_REG), perf_cfi_leb(scratch, false))
                offset: if (op == I64{18}) -> wrapping(perf_cfi_leb(scratch, true) * data_align) else -> perf_cfi_leb(scratch, false)
                rt_text_store(wrapping(scratch + PERF_CFI_CFA_OFFSET), offset)
            }
            (op == I64{13}) -> rt_text_store(wrapping(scratch + PERF_CFI_CFA_REG), perf_cfi_leb(scratch, false))
            (op == I64{14}) -> rt_text_store(wrapping(scratch + PERF_CFI_CFA_OFFSET), perf_cfi_leb(scratch, false))
            (op == I64{19}) -> rt_text_store(wrapping(scratch + PERF_CFI_CFA_OFFSET), wrapping(perf_cfi_leb(scratch, true) * data_align))
            (op == I64{15} || op == I64{16} || op == I64{22}) -> {
                // def_cfa_expression, expression, val_expression: the block
                // is skipped and what it computes is not followed.
                register := I64{-1}
                if (op != I64{15}) { register = perf_cfi_leb(scratch, false) }
                length: perf_cfi_leb(scratch, false)
                rt_text_store(scratch, wrapping(rt_text_word(scratch) + length))
                if {
                    (op == I64{15}) -> rt_text_store(wrapping(scratch + PERF_CFI_CFA_REG), I64{-1})
                    else -> perf_cfi_set(scratch, register, PERF_CFI_UNKNOWN, I64{0})
                }
            }
            // GNU_args_size.
            (op == I64{46}) -> { _ := perf_cfi_leb(scratch, false) }
            // set_loc and any other instruction.
            else -> return false
        }
        if (advance >= I64{0}) {
            at = wrapping(at + wrapping(advance * code_align))
            if (at > target) { return true }
        }
    }
    true
}

// Read the CIE at `cie` (its length word) into the scratch page and run its
// initial instructions; the cursor is left past them. False for a CIE the
// unwinder does not read.
perf_cfi_cie: fn(scratch: I64, cie: I64) -> Bool {
    length: perf_cfi_u32(cie)
    if (length == I64{0} || length == I64{4294967295} || perf_cfi_u32(wrapping(cie + I64{4})) != I64{0}) {
        return false
    }
    end: wrapping(cie + wrapping(length + I64{4}))
    version: rt_text_byte(wrapping(cie + I64{8}))
    augmentation: wrapping(cie + I64{9})
    at := augmentation
    loop rt_text_byte(at) != (I64{0}) -> at = wrapping(at + I64{1})
    rt_text_store(scratch, wrapping(at + I64{1}))
    augmented: rt_text_byte(augmentation) == I64{122}
    if (rt_text_byte(augmentation) != I64{0} && !augmented) { return false }
    rt_text_store(wrapping(scratch + PERF_CFI_CODE_ALIGN), perf_cfi_leb(scratch, false))
    rt_text_store(wrapping(scratch + PERF_CFI_DATA_ALIGN), perf_cfi_leb(scratch, true))
    column: if (version == I64{1}) -> perf_cfi_byte(scratch) else -> perf_cfi_leb(scratch, false)
    rt_text_store(wrapping(scratch + PERF_CFI_RA_COLUMN), column)
    encoding := I64{0}
    if (augmented) {
        size: perf_cfi_leb(scratch, false)
        data: rt_text_word(scratch)
        field := data
        letter := wrapping(augmentation + I64{1})
        loop rt_text_byte(letter) != (I64{0}) {
            kind: rt_text_byte(letter)
            // 'R' the FDE pointer encoding, 'P' a personality pointer, 'L'
            // the LSDA encoding; 'S' and 'B' carry no data.
            if {
                (kind == I64{82}) -> {
                    encoding = rt_text_byte(field)
                    field = wrapping(field + I64{1})
                }
                (kind == I64{80}) -> {
                    skip: perf_cfi_pointer_size(rt_text_byte(field))
                    if (skip == I64{0}) { return false }
                    field = wrapping(field + wrapping(skip + I64{1}))
                }
                (kind == I64{76}) -> field = wrapping(field + I64{1})
                (kind != I64{83} && kind != I64{66}) -> return false
                else -> {}
            }
            letter = wrapping(letter + I64{1})
        }
        rt_text_store(scratch, wrapping(data + size))
    }
    rt_text_store(wrapping(scratch + PERF_CFI_ENCODING), encoding)
    rt_text_store(wrapping(scratch + PERF_CFI_AUGMENTED), if (augmented) -> I64{1} else -> I64{0})
    // Until the instructions say otherwise: no CFA, rbp unchanged, the
    // return address unknown.
    rt_text_store(wrapping(scratch + PERF_CFI_CFA_REG), I64{-1})
    rt_text_store(wrapping(scratch + PERF_CFI_CFA_OFFSET), I64{0})
    rt_text_store(wrapping(scratch + PERF_CFI_RBP_RULE), PERF_CFI_SAME)
    rt_text_store(wrapping(scratch + PERF_CFI_RBP_OFFSET), I64{0})
    rt_text_store(wrapping(scratch + PERF_CFI_RA_RULE), PERF_CFI_UNKNOWN)
    rt_text_store(wrapping(scratch + PERF_CFI_RA_OFFSET), I64{0})
    rt_text_store(wrapping(scratch + PERF_CFI_DEPTH), I64{0})
    if (!perf_cfi_run(scratch, end, I64{0}, I64{-1})) { return false }
    initial: wrapping(scratch + PERF_CFI_INITIAL)
    rt_text_store(initial, rt_text_word(wrapping(scratch + PERF_CFI_RBP_RULE)))
    rt_text_store(wrapping(initial + I64{8}), rt_text_word(wrapping(scratch + PERF_CFI_RBP_OFFSET)))
    rt_text_store(wrapping(initial + I64{16}), rt_text_word(wrapping(scratch + PERF_CFI_RA_RULE)))
    rt_text_store(wrapping(initial + I64{24}), rt_text_word(wrapping(scratch + PERF_CFI_RA_OFFSET)))
    true
}

// The rule row at link-time address `address` of the FDE at `fde`, whose
// range starts at `begin`, in the scratch page. False when its CIE or
// instructions are ones the unwinder does not read.
perf_cfi_rule: fn(scratch: I64, fde: I64, begin: I64, address: I64) -> Bool {
    pointer: wrapping(fde + I64{4})
    if (!perf_cfi_cie(scratch, wrapping(pointer - perf_cfi_u32(pointer)))) { return false }
    end: wrapping(fde + wrapping(perf_cfi_u32(fde) + I64{4}))
    // The range's begin and length are the table's; past them, the FDE's
    // augmentation data when its CIE has a 'z'.
    size: perf_cfi_pointer_size(rt_text_word(wrapping(scratch + PERF_CFI_ENCODING)))
    if (size == I64{0}) { return false }
    rt_text_store(scratch, wrapping(fde + wrapping(I64{8} + wrapping(size * I64{2}))))
    if (rt_text_word(wrapping(scratch + PERF_CFI_AUGMENTED)) != I64{0}) {
        skip: perf_cfi_leb(scratch, false)
        rt_text_store(scratch, wrapping(rt_text_word(scratch) + skip))
    }
    perf_cfi_run(scratch, end, begin, address)
}

// The table entry (begin, end, FDE) whose range holds link-time address
// `address`, or 0.
perf_cfi_find: fn(address: I64) -> I64 {
    table: perf_cfi_table
    low := I64{0}
    high := perf_cfi_count
    // The last entry that begins at or below the address.
    loop low < high {
        middle: wrapping(low + ((high - low) >> I64{1}))
        if {
            (rt_text_word(wrapping(table + wrapping(middle * I64{24}))) <= address) -> {
                low = wrapping(middle + I64{1})
            }
            else -> high = middle
        }
    }
    if (low == I64{0}) { return I64{0} }
    entry: wrapping(table + wrapping(wrapping(low - I64{1}) * I64{24}))
    if (address < rt_text_word(wrapping(entry + I64{8}))) -> entry else -> I64{0}
}

// The FDEs of the .eh_frame section at `bytes` in the mapping, `size` bytes
// from link-time address `address`: counted when `table` is 0, else written
// to it from entry `first` on. The entries written or counted.
perf_cfi_section: fn(scratch: I64, bytes: I64, size: I64, address: I64, table: I64, first: I64) -> I64 {
    written := first
    at := bytes
    stop: wrapping(bytes + size)
    loop wrapping(at + I64{8}) <= stop {
        length: perf_cfi_u32(at)
        if (length == I64{0} || length == I64{4294967295}) { break }
        pointer: wrapping(at + I64{4})
        if (perf_cfi_u32(pointer) != I64{0}) {
            if {
                (table == I64{0}) -> written = wrapping(written + I64{1})
                (perf_cfi_cie(scratch, wrapping(pointer - perf_cfi_u32(pointer)))) -> {
                    encoding: rt_text_word(wrapping(scratch + PERF_CFI_ENCODING))
                    rt_text_store(scratch, wrapping(at + I64{8}))
                    begin: perf_cfi_pointer(scratch, encoding, bytes, address)
                    extent: perf_cfi_pointer(scratch, encoding & I64{15}, bytes, address)
                    if (begin != PERF_CFI_BAD && extent != PERF_CFI_BAD && extent > I64{0}) {
                        entry: wrapping(table + wrapping(written * I64{24}))
                        rt_text_store(entry, begin)
                        rt_text_store(wrapping(entry + I64{8}), wrapping(begin + extent))
                        rt_text_store(wrapping(entry + I64{16}), at)
                        written = wrapping(written + I64{1})
                    }
                }
                else -> {}
            }
        }
        at = wrapping(pointer + length)
    }
    written
}

// The FDEs of every section named `.eh_frame` of the ELF64 file `image`:
// counted when `table` is 0, else written to it.
perf_cfi_sections: fn(image: I64, scratch: I64, table: I64) -> I64 {
    sections: wrapping(image + rt_text_word(wrapping(image + I64{40})))
    entry: rt_text_word(wrapping(image + I64{58})) & I64{65535}
    count: rt_text_word(wrapping(image + I64{60})) & I64{65535}
    strings: wrapping(image + rt_text_word(wrapping(wrapping(sections + wrapping((rt_text_word(wrapping(image + I64{62})) & I64{65535}) * entry)) + I64{24})))
    found := I64{0}
    index := I64{0}
    loop index < count {
        section: wrapping(sections + wrapping(index * entry))
        name: wrapping(strings + perf_cfi_u32(section))
        // ".eh_fram", then "e" and the name's end.
        if (perf_cfi_u64(name) == I64{7881706606887986478} && rt_text_byte(wrapping(name + I64{8})) == I64{101} && rt_text_byte(wrapping(name + I64{9})) == I64{0}) {
            bytes: wrapping(image + rt_text_word(wrapping(section + I64{24})))
            found = perf_cfi_section(scratch, bytes, rt_text_word(wrapping(section + I64{32})), rt_text_word(wrapping(section + I64{16})), table, found)
        }
        index = wrapping(index + I64{1})
    }
    found
}

// The FDE table of the ELF64 file `image` (alloc_check_image), sorted by
// begin.
perf_cfi_start: fn(image: I64) {
    if (image == I64{0}) {
        return
    }
    scratch: alloc_map_try(I64{4096})
    if (scratch == I64{0}) {
        return
    }
    found: perf_cfi_sections(image, scratch, I64{0})
    if (found == I64{0}) {
        return
    }
    table: alloc_map_try(wrapping(found * I64{24}))
    if (table == I64{0}) {
        return
    }
    total: perf_cfi_sections(image, scratch, table)
    perf_cfi_sort(table, total)
    #Unsafe("the observation start runs before the timer whose handler reads these is armed") {
        perf_cfi_table = table
        perf_cfi_count = total
        perf_cfi_scratch = scratch
    }
}

// Sort the `count` three-word entries of `table` by their first word, in
// place: a shell sort, as the runtime's sort would allocate.
perf_cfi_sort: fn(table: I64, count: I64) {
    gap := count >> I64{1}
    loop gap > (I64{0}) {
        index := gap
        loop index < count {
            moving: wrapping(table + wrapping(index * I64{24}))
            begin: rt_text_word(moving)
            end: rt_text_word(wrapping(moving + I64{8}))
            fde: rt_text_word(wrapping(moving + I64{16}))
            slot := index
            loop slot >= gap && rt_text_word(wrapping(table + wrapping(wrapping(slot - gap) * I64{24}))) > begin {
                to: wrapping(table + wrapping(slot * I64{24}))
                from: wrapping(table + wrapping(wrapping(slot - gap) * I64{24}))
                rt_text_store(to, rt_text_word(from))
                rt_text_store(wrapping(to + I64{8}), rt_text_word(wrapping(from + I64{8})))
                rt_text_store(wrapping(to + I64{16}), rt_text_word(wrapping(from + I64{16})))
                slot = wrapping(slot - gap)
            }
            to: wrapping(table + wrapping(slot * I64{24}))
            rt_text_store(to, begin)
            rt_text_store(wrapping(to + I64{8}), end)
            rt_text_store(wrapping(to + I64{16}), fde)
            index = wrapping(index + I64{1})
        }
        gap = gap >> I64{1}
    }
}

// The SIGPROF handler (SA_SIGINFO), and PERF_COUNTERS_SIGNAL's: the
// interrupted rip, rbp and rsp are ucontext_t's mcontext gregs[16], [10]
// and [15], at 168, 120 and 160. When rip is in the image's code, the call
// frame information (perf_cfi_rule) first steps out through each frame
// whose CFA is rsp-based, a function without a frame pointer or one before
// its prologue sets it, reading the return address and, where it was
// saved, rbp from below its CFA. At the first frame that keeps rbp, rbp is
// a frame of the chain, and the walk follows each [saved rbp][return
// address] pair while the call site is in the image's code, as the fault
// report's walk does (Fault.jet trace_frames). A frame neither can follow
// ends the stack there. One thread fills the record buffer at a time;
// another thread's sample meanwhile, or one outside the image's code, is
// its program counter alone. A write the kernel refuses loses that one
// sample; O_APPEND puts each record after the last. A counter's record has
// its kind, and the counter is armed again once it is written.
#Export(c) jet_rt_perf_samples_signal: fn(signal: I64, info: I64, context: I64) -> I64 {
    fd: perf_samples_fd
    if (fd < I64{0} || context == I64{0}) { return I64{0} }
    buffer: perf_samples_buffer
    counter := I64{-1}
    if (signal == PERF_COUNTERS_SIGNAL) {
        counter = perf_counter_of(info, buffer)
        if (counter < I64{0}) { return I64{0} }
    }
    kind: wrapping(counter + I64{1}) << PERF_SAMPLES_KIND_BITS
    bias: perf_samples_bias
    pc: wrapping(rt_text_word(wrapping(context + I64{168})) - bias)
    if (buffer == I64{0} || !perf_samples_in_code(pc) || sync_cas(buffer, I64{0}, I64{1}) != I64{0}) {
        #Unsafe("one write of a stack-local word, which the kernel copies before the call returns") {
            _ := os_write_word_i64(fd, (pc & PERF_SAMPLES_ADDRESS_MASK) | (I64{1} << PERF_SAMPLES_ADDRESS_BITS) | kind, I64{8})
        }
        perf_counter_rearm(buffer, counter)
        return I64{0}
    }
    count := I64{1}
    stack: rt_text_word(wrapping(context + I64{160}))
    frame := rt_text_word(wrapping(context + I64{120}))
    scratch: perf_cfi_scratch
    sp := stack
    address := pc
    loop scratch != (I64{0}) && count < PERF_SAMPLES_DEPTH {
        entry: perf_cfi_find(address)
        if (entry == I64{0} || !perf_cfi_rule(scratch, rt_text_word(wrapping(entry + I64{16})), rt_text_word(entry), address)) {
            break
        }
        register: rt_text_word(wrapping(scratch + PERF_CFI_CFA_REG))
        // A frame that keeps rbp: the walk below takes it from here.
        if (register == PERF_CFI_RBP) { break }
        cfa: wrapping(sp + rt_text_word(wrapping(scratch + PERF_CFI_CFA_OFFSET)))
        if (register != PERF_CFI_RSP || rt_text_word(wrapping(scratch + PERF_CFI_RA_RULE)) != PERF_CFI_SAVED || cfa <= sp || cfa & I64{7} != I64{0} || wrapping(cfa - stack) >= I64{16777216}) {
            frame = I64{0}
            break
        }
        // cfa is above the interrupted rsp on the thread's stack, so the
        // return address and the saved rbp below it are words of that stack.
        rule: rt_text_word(wrapping(scratch + PERF_CFI_RBP_RULE))
        if {
            (rule == PERF_CFI_SAVED) -> {
                frame = rt_text_word(wrapping(cfa + rt_text_word(wrapping(scratch + PERF_CFI_RBP_OFFSET))))
            }
            (rule == PERF_CFI_UNKNOWN) -> frame = I64{0}
            else -> {}
        }
        site: wrapping(wrapping(rt_text_word(wrapping(cfa + rt_text_word(wrapping(scratch + PERF_CFI_RA_OFFSET)))) - I64{1}) - bias)
        if (!perf_samples_in_code(site)) {
            frame = I64{0}
            break
        }
        rt_text_store(wrapping(buffer + wrapping(wrapping(count + I64{1}) * I64{8})), site)
        count = wrapping(count + I64{1})
        sp = cfa
        address = site
    }
    if (frame < sp || wrapping(frame - stack) >= I64{16777216}) { frame = I64{0} }
    loop count < PERF_SAMPLES_DEPTH {
        if (frame == I64{0} || frame & I64{7} != I64{0}) { break }
        // frame is a [saved rbp][return address] pair of the interrupted
        // thread's chain: rbp of a frame that keeps it, or the saved rbp of
        // its caller.
        site: wrapping(wrapping(rt_text_word(wrapping(frame + I64{8})) - I64{1}) - bias)
        if (!perf_samples_in_code(site)) { break }
        rt_text_store(wrapping(buffer + wrapping(wrapping(count + I64{1}) * I64{8})), site)
        count = wrapping(count + I64{1})
        #Unsafe("each followed link ascends by less than 16 MiB or crosses a stack segment's bridge frame, so frame stays on the thread's chain") {
            frame = stack_frame_caller(frame)
        }
    }
    rt_text_store(wrapping(buffer + I64{8}), pc | (count << PERF_SAMPLES_ADDRESS_BITS) | kind)
    #Unsafe("one write of the record's words, which the kernel copies before the call returns") {
        _ := os_syscall_i64(I64{1}, fd, wrapping(buffer + I64{8}), wrapping(count * I64{8}), I64{0}, I64{0}, I64{0})
    }
    sync_store(buffer, I64{0})
    perf_counter_rearm(buffer, counter)
    I64{0}
}
