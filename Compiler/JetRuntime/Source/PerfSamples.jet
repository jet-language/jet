// `jet perf run` (JetCLI CLI/Perf/Session.jet): the program's samples. When
// JET_PERF_SAMPLES names a file, the observation start (ObserveLive.jet
// jet_rt_observe_runtime_start_from_env) opens it and, under the `cpu` lens
// (JET_PERF_LENSES), arms a timer on its own thread's CPU clock, and each
// thread Thread.jet starts afterwards arms one on its own
// (perf_samples_thread_start): each sends its thread SIGPROF for each
// PERF_SAMPLES_INTERVAL_US of CPU time that thread uses, so threads that
// run at once each keep their own samples. Where the kernel allows a perf
// event of the thread's own, each thread arms that instead
// (perf_precise_choose): the task clock, or, where perf_event_paranoid is
// at most 1, a precise sampler, IBS op sampling or PEBS, whose sample's
// program counter is the instruction the sampler names rather than the one
// its interrupt landed on; the start writes which source it chose to
// `<samples>.pc`. A perf event's kernel takes each sample, with the user
// registers, its frame pointer walk and a copy of the stack's top, into the
// thread's ring, which the program drains in batches with no signal for
// each sample (perf_samples_ring_drain). A handler or a drain fills a
// record buffer of its own (perf_samples_claim), so a sample on one thread
// never costs another thread's its stack. Each sample appends one record:
// the program counter it interrupted, then the call site of each caller,
// innermost first, each less the image's load bias: by the image's call frame
// information through frames without a frame pointer, then up the frame
// pointer chain. Each is a link-time address in the image `jet run` writes
// beside the file, where the image's location table names its function and
// line, as Linux perf names the same image's samples. A record is
// little-endian words, written whole: a sample handler's among the others
// its buffer's side keeps (perf_samples_keep), any other in a write of its
// own; its first word holds the record's word count in bits 48..58 above
// the program counter's low 48, and its kind in bits
// 59..62: 0 for a CPU-time sample, a counter's index plus one for that
// counter's sample, PERF_SAMPLES_TOPDOWN for a topdown event's sample,
// PERF_SAMPLES_SPAWN for a task's spawn,
// PERF_SAMPLES_WAIT for a task's wait, PERF_SAMPLES_WAKE for the wake of a
// waiter, PERF_SAMPLES_IO for a file or network transfer,
// PERF_SAMPLES_HEAP_MARK and PERF_SAMPLES_HEAP_SITE for a heap snapshot and
// PERF_SAMPLES_CLOCK for the CPU time the process used while sampled,
// written at exit (perf_samples_exit). The handler allocates nothing and
// never waits. Beside the samples, `<samples>.spans` keeps a row for each
// core.log span the program closes (RouteALog.jet log_span_row_write).
//
// Under the `memory` lens, which JET_PERF_LENSES names as it names `cpu`,
// the start opens four counters of the thread that starts the observation,
// the program's main thread, each with perf_event_open to count in user
// mode only, and has each signal that thread with PERF_COUNTERS_SIGNAL, its
// descriptor in the siginfo, once per its period of events. The same
// handler appends a record like a CPU-time sample's for it, of the
// counter's kind, then arms the counter for its next period
// (PERF_EVENT_IOC_REFRESH). `<samples>.counters` keeps two words for each
// counter in order: its period, or 0, and the errno the kernel refused it
// with, or 0. Other threads' events are not counted. The `memory` lens
// without `cpu` arms no thread's timer, so the file holds no CPU-time
// sample.
//
// Under the `topdown` lens the start opens, on the same thread and through
// the same handler, the events the CPU's top-down formulas take
// (perf_topdown_start), each sampled once per its period in a record of
// kind PERF_SAMPLES_TOPDOWN, its event's index above its program counter.
// `<samples>.topdown` keeps which formulas the CPU has, the CPU, each
// event's PMU type, config, period and errno, and at exit each event's
// count, with the time it was enabled and the time it ran
// (perf_topdown_exit), which scale a multiplexed event's count.
//
// Under the `alloc` lens the session builds the program with
// `--checked-alloc`, whose every block keeps its allocating chain, and the
// start has the checked heap track its live blocks (Alloc.jet
// alloc_check_track_start). A heap snapshot, at each
// `core.perf.heap_mark(name)` (jet_perf_heap_mark) and at exit, holds the
// live list while it forks: the copy-on-write child walks the list as it
// stood, groups the live blocks by their allocating call sites, writes the
// snapshot's records and exits, while the program's other threads allocate
// on; the marking thread waits for the child (perf_samples_heap). The same
// take that links a block counts its allocation and its bytes at its
// allocating call sites (perf_samples_alloc_site), and at exit each
// distinct chain becomes an allocations' record (perf_samples_alloc_write).

// O_WRONLY|O_CREAT|O_APPEND|O_CLOEXEC.
PERF_SAMPLES_OPEN: I64{525377}

PERF_SAMPLES_SIGNAL: I64{27}

// One sample per 125 microseconds of CPU time, 8 kHz.
PERF_SAMPLES_INTERVAL_US: I64{125}

// The most periods past its own one sample stands for (perf_samples_periods):
// a second of CPU time.
PERF_SAMPLES_OVERRUNS: I64{8000}

// The most words one record keeps: its program counter and the call sites
// of its innermost callers.
PERF_SAMPLES_DEPTH: I64{1024}

// The words a CPU-time sample's record ends with, when a record buffer
// holds it (jet_rt_perf_samples_signal): its time and its task.
PERF_SAMPLES_TIMED: I64{2}

// A record's first word: the word count above bit 48, the address below.
PERF_SAMPLES_ADDRESS_BITS: I64{48}

PERF_SAMPLES_ADDRESS_MASK: I64{281474976710655}

// A record's first word: its kind above bit 59, its word count below.
PERF_SAMPLES_KIND_BITS: I64{59}

// The kinds of a task's spawn record (perf_samples_spawn), of a task's wait
// record (perf_samples_wait) and of a wake's record (perf_samples_wake),
// above every counter's.
PERF_SAMPLES_SPAWN: I64{15}

PERF_SAMPLES_WAIT: I64{14}

PERF_SAMPLES_WAKE: I64{12}

// The kind of a topdown event's sample (perf_topdown_start): a record like
// a counter's, with the event's index in the address bits from
// PERF_TOPDOWN_EVENT_BITS, above its program counter's distance past the
// start of the image's code plus one, 0 outside that code. An image `jet
// run` maps lies above PERF_TOPDOWN_EVENT_BITS's reach, so its program
// counter does not fit below the index; the distance does.
PERF_SAMPLES_TOPDOWN: I64{7}

PERF_TOPDOWN_EVENT_BITS: I64{40}

// The kind of the record of the CPU time the process used since sampling
// started (perf_samples_exit): its second word, in nanoseconds.
PERF_SAMPLES_CLOCK: I64{13}

// The kind of a file or network transfer's record (perf_samples_io).
PERF_SAMPLES_IO: I64{11}

// The kinds of a heap snapshot's records (perf_samples_heap): its mark,
// then one per group of its live blocks, then the retention records
// (perf_samples_heap_refs), one or more per live block and the roots'.
PERF_SAMPLES_HEAP_MARK: I64{10}

PERF_SAMPLES_HEAP_SITE: I64{9}

PERF_SAMPLES_HEAP_BLOCK: I64{6}

PERF_SAMPLES_HEAP_ROOT: I64{5}

// What a heap snapshot's root record holds, its second word: the frames of
// the snapshot's thread, the words of those frames that refer to live
// blocks, or the words of the image's writable segments that do.
PERF_SAMPLES_ROOT_FRAMES: I64{0}

PERF_SAMPLES_ROOT_STACK: I64{1}

PERF_SAMPLES_ROOT_DATA: I64{2}

// The most words a heap snapshot's record holds: its first word keeps the
// count in the 11 bits from PERF_SAMPLES_ADDRESS_BITS.
PERF_SAMPLES_HEAP_RECORD: I64{2047}

// The most bytes of its name a heap snapshot's mark record keeps.
PERF_SAMPLES_HEAP_NAME: I64{256}

// The call sites a heap snapshot keeps of a block's allocating chain: the
// ten the checked prefix holds (Alloc.jet alloc_check_frames).
PERF_SAMPLES_HEAP_DEPTH: I64{10}

// The words of one group of a heap snapshot's table: its blocks, its bytes,
// then its key, the call sites' count and PERF_SAMPLES_HEAP_DEPTH sites.
PERF_SAMPLES_HEAP_GROUP: I64{13}

// The groups a snapshot's table starts with, a power of two.
PERF_SAMPLES_HEAP_GROUPS: I64{1024}

// The bytes of a snapshot's output buffer, written whenever it fills.
PERF_SAMPLES_HEAP_BUFFER: I64{65536}

// Under the alloc lens, the allocations the program made by their
// allocating call sites (perf_samples_alloc_site), 0 otherwise: a mapping
// of its own holding the table's address 0, its capacity 8, a power of two,
// its groups 16, the allocations counted 24, the nanoseconds the lens's
// work on them took 32 and a key's scratch 40 (perf_samples_heap_key). The
// table's groups are a heap snapshot's (PERF_SAMPLES_HEAP_GROUP words: the
// allocations, their bytes, then the key). The checked heap's quarantine
// lock, which each tracking take holds while it counts, guards all of it.
perf_alloc_state := I64{0}

PERF_ALLOC_STATE_BYTES: I64{4096}

PERF_ALLOC_KEY: I64{40}

// The bit of an allocations' record's first word that marks it, the sign
// bit: the record's allocations below PERF_SAMPLES_ADDRESS_BITS and its
// word count from there, past every kind's bits.
PERF_ALLOC_RECORD: I64{-9223372036854775808}

// What a transfer moved its bytes to or from (perf_samples_io): a file by
// the path the program opened it by, a descriptor by its number when the
// runtime holds no path for it, or a socket by its peer's address, the
// kernel's sockaddr bytes.
PERF_SAMPLES_TARGET_PATH: I64{1}

PERF_SAMPLES_TARGET_FD: I64{2}

PERF_SAMPLES_TARGET_SOCKET: I64{3}

// A transfer's direction.
PERF_SAMPLES_IO_READ: I64{0}

PERF_SAMPLES_IO_WRITE: I64{1}

// The most bytes of its target a transfer's record keeps.
PERF_SAMPLES_IO_TARGET: I64{1024}

// The record buffers besides perf_samples_buffer, for the handlers of
// threads sampled at the same moment: each a busy word, PERF_SAMPLES_DEPTH
// record words, then PERF_CFI_SCRATCH_BYTES of call frame rules.
PERF_SAMPLES_SLOTS: I64{64}

// The bytes of records a buffer's side holds before its handler writes
// them (perf_samples_keep): one write for many samples, not one each.
PERF_SAMPLES_OUT_BYTES: I64{8192}

// The most call sites a spawn, wait or wake record keeps.
PERF_SAMPLES_STACK_DEPTH: I64{32}

// The threads the system table keeps rows for (perf_system), the main
// thread's the first, and the words of each row.
PERF_THREADS_ROWS: I64{256}

PERF_THREADS_ROW_WORDS: I64{40}

// The rows of distinct host calls the system table keeps, each a number
// and a calling stack (a power of two: perf_syscall_row probes its rows
// from its key's bits), and the words of each row.
PERF_SYSCALLS_ROWS: I64{1024}

PERF_SYSCALLS_ROW_WORDS: I64{36}

// The most bytes of its wait's name a wait record keeps.
PERF_SAMPLES_WAIT_NAME: I64{256}

// What a wait is for (perf_samples_object), above its id's 48 bits: a task
// a join awaits, a channel by its observed id (Observe.jet
// jet_rt_observe_channel_new), a Shared value's lock, which has no id, or a
// socket by its descriptor, whose wait waits for the socket to be ready
// (HostNetPoller.jet host_net_ready).
PERF_SAMPLES_OBJECT_TASK: I64{1}

PERF_SAMPLES_OBJECT_CHANNEL: I64{2}

PERF_SAMPLES_OBJECT_LOCK: I64{3}

PERF_SAMPLES_OBJECT_SOCKET: I64{4}

// A realtime signal, so that each counter's overflow is queued with its
// own siginfo, never merged with another's or with SIGPROF.
PERF_COUNTERS_SIGNAL: I64{63}

// L1D, LLC and dTLB read misses, and page faults.
PERF_COUNTERS_COUNT: I64{4}

// The most events the topdown lens opens (perf_topdown_events), and the
// descriptors the record buffer keeps: the memory lens's counters', then
// the topdown lens's events'.
PERF_TOPDOWN_MAX: I64{24}

PERF_COUNTERS_SLOTS: I64{28}

// The lenses JET_PERF_LENSES names, one bit each: `cpu`, the CPU-time
// samples, `memory`, the counters, `alloc`, the heap snapshots, `topdown`,
// the top-down events, and `causal`, the virtual speedup experiments
// (perf_causal_tick), which the session names beside `cpu`. The session
// writes them comma-separated in that order; a run without it samples CPU
// time alone.
PERF_LENS_CPU: I64{1}

PERF_LENS_MEMORY: I64{2}

PERF_LENS_ALLOC: I64{4}

PERF_LENS_CAUSAL: I64{8}

PERF_LENS_TOPDOWN: I64{16}

// The SIGPROFs the start sends its own thread to time the kernel's part of
// one sample (perf_samples_delivery).
PERF_SAMPLES_CALIBRATIONS: I64{64}

// The interrupted thread's two TCB words (Thread.jet) the handler reads
// the monotonic clock into (perf_samples_clock).
PERF_SAMPLES_TCB_CLOCK: I64{744}

// The samples file, -1 until the start opens it, and the bias its addresses
// are taken less.
perf_samples_fd := I64{-1}

perf_samples_bias := I64{0}

// The image's ELF file (Alloc.jet alloc_check_image), whose writable
// segments a heap snapshot scans for roots (perf_samples_heap_roots).
perf_samples_image := I64{0}

// The image's code at link time, [low, high): a frame whose address is in
// it is Jet code or a C library function of the image, which the call frame
// information or the frame pointer chain walks.
perf_samples_code_low := I64{0}

perf_samples_code_high := I64{0}

// The record buffer: its first word is 1 while a handler fills the
// PERF_SAMPLES_DEPTH words after it; 0 when the start could not map it.
// After them come PERF_COUNTERS_SLOTS counters' descriptors, -1 for one
// that is not open: PERF_COUNTERS_COUNT for the memory lens, then the
// topdown lens's events; then the nanoseconds every handler has run
// (perf_samples_charge), then how many recorded lock waits are blocked now
// (perf_samples_lock_block), then how many records the program made and
// could not write (perf_samples_send), then the rings' tallies
// (PERF_SAMPLES_RING_COUNT).
perf_samples_buffer := I64{0}

// The rings' tallies, words of the record buffer after the lost records'
// (perf_samples_tally): the samples the drains took from the rings
// (perf_samples_ring_sample), the picoseconds the kernel took to write
// them (perf_precise_cost), and how many of them the kernel's callchain
// cut at perf_precise_depth entries.
PERF_SAMPLES_RING_COUNT: I64{3}

PERF_SAMPLES_RING_PS: I64{4}

PERF_SAMPLES_RING_CUT: I64{5}

// The words of the record buffer past its PERF_SAMPLES_DEPTH + 1 and its
// counters' slots: the handlers' nanoseconds, the blocked lock waits, the
// lost records and the rings' three tallies.
PERF_SAMPLES_TALLIES: I64{6}

// PERF_SAMPLES_SLOTS more record buffers (perf_samples_claim), 0 when the
// start could not map them; the process's CPU time in nanoseconds when
// sampling started; and the nanoseconds the kernel takes to deliver one
// SIGPROF and return from its handler (perf_samples_delivery), each for
// perf_samples_exit.
perf_samples_slots := I64{0}

perf_samples_cpu_start := I64{0}

perf_samples_delivery_ns := I64{0}

// Per record buffer, perf_samples_buffer's first and then each of
// perf_samples_slots', perf_samples_side_bytes its handler alone uses
// while it holds the buffer (perf_samples_side): the bytes of the records
// it has made and not yet written, those records (PERF_SAMPLES_OUT_BYTES),
// then the rule rows of the addresses its walks met (perf_cfi_cached). 0
// when the start could not map them: each handler then writes its record
// as it makes it and interprets every frame's rules.
perf_samples_sides := I64{0}

// 1 while a handler keeps its records in its buffer's side, to write them
// once PERF_SAMPLES_OUT_BYTES of them fill it: under `jet perf run`, whose
// file the session reads after the run, from the start to the exit, which
// writes what the sides hold (perf_samples_flush), and in a flight
// recorder's zones window, whose close writes them to the window file
// (perf_flight_window_close). Outside a window the flight recorder's
// records are datagrams, each written as it is made.
perf_samples_buffered := I64{0}

// The lenses the start found (perf_samples_lenses): under `cpu` each
// thread arms its timer (perf_samples_thread_start); under `memory` alone
// none does.
perf_samples_lens_mask := I64{0}

// The microseconds of a thread's CPU time each sample stands for:
// PERF_SAMPLES_INTERVAL_US, or PERF_FLIGHT_INTERVAL_US for the flight
// recorder (perf_flight_open) outside an attach's zones window, in which it
// is PERF_SAMPLES_INTERVAL_US (perf_flight_window_open). A thread arms its
// timer at it as it starts (perf_samples_thread_start), and every timer is
// armed again as it changes (perf_samples_rate).
perf_samples_interval_us := PERF_SAMPLES_INTERVAL_US

// Under the flight recorder, the first page of the table of the threads'
// sampler timers (perf_samples_timer_keep), which a rate change arms again;
// 0 otherwise.
perf_samples_timers := I64{0}

// The log spans file, `<samples>.spans`, -1 unless the start opened it.
perf_spans_fd := I64{-1}

// The thread and host call table (perf_system_start) under `jet perf run`,
// 0 until the start maps it and for the flight recorder: the pid that
// mapped it@0, how many thread rows were claimed@8, how many host calls
// found no row@16, then PERF_THREADS_ROWS thread rows and
// PERF_SYSCALLS_ROWS host call rows. A thread's row (perf_threads_spawn):
// its kernel id (0 until it runs)@0, its entry less the load bias (0 for
// the main thread)@8, its stack's bytes@16, the monotonic clock as it
// began@24 and ended@32, its CPU time@40, 1 once it ended@48, the count of
// the call sites that spawned it@56, then those sites
// (perf_samples_stack)@64. A host call row (perf_syscall_row): its key (0
// while free)@0, the call's number@8, how many calls@16, their
// nanoseconds@24, then their calling sites, 0 after the last
// (perf_syscall_key)@32.
perf_system := I64{0}

// The files the exit writes the table's threads and host calls to
// (perf_system_exit), `<samples>.threads` and `<samples>.syscalls`.
perf_threads_fd := I64{-1}

perf_syscalls_fd := I64{-1}

// Nonzero while zones are recorded (perf_zones_set). A compiled zone site
// (JetIR X64Select.jet ir_x64_zone_site) of an image's code is a `jmp`
// over its call that the runtime patches while zones are on
// (perf_zone_tables_turn); a site of code no table lists tests this word
// through the runtime's data symbol jet_rt_perf_zones. Either calls
// jet_perf_zone_open and _close only then.
perf_zones_on := I64{0}

// The rows not yet written to the spans file (perf_zone_row), 0 until the
// start opens the file.
perf_spans_buffer := I64{0}

// The topdown lens's file, `<samples>.topdown`, -1 unless the start opened
// it, which stays open for the events' counts at exit (perf_topdown_exit),
// and how many events it lists.
perf_topdown_fd := I64{-1}

perf_topdown_count := I64{0}

// The CPU lens's sampler (perf_precise_choose): PERF_PC_TIMER, each
// thread's CPU-time timer, whose SIGPROF charges the program counter the
// signal interrupted, some instructions past the one that spent the time
// (its skid), and which the kernel checks once a tick, so a thread's
// samples come at most once a tick; PERF_PC_TASK_CLOCK, a perf event on
// each thread's own CPU clock, sampled exactly once per period of it from
// the interrupt that ends the period; or a precise source, a perf event on
// each thread whose samples name the instruction itself: AMD's IBS op
// sampling (PERF_PC_IBS_OP) or Intel's PEBS (PERF_PC_PEBS).
PERF_PC_TIMER: I64{0}

PERF_PC_IBS_OP: I64{1}

PERF_PC_PEBS: I64{2}

PERF_PC_TASK_CLOCK: I64{3}

perf_precise_source := PERF_PC_TIMER

// A precise source's period, in CPU cycles (perf_precise_cycles), set
// before its first sampler is armed.
perf_precise_period := I64{0}

// The perf_event_paranoid word of a kernel with no
// /proc/sys/kernel/perf_event_paranoid, and so no perf events.
PERF_PARANOID_NONE: I64{1000}

// Under the task clock or a precise source, each thread's sampler's ring by
// its descriptor, a table of PERF_PRECISE_FDS words, 0 for a descriptor
// that is none, then the exit's word (PERF_PRECISE_EXITING); 0 under the
// timer.
perf_precise_rings := I64{0}

PERF_PRECISE_FDS: I64{65536}

// The table's word after its descriptors: 1 once the exit drains every ring
// (perf_precise_rings_drain), after which an ending thread's ring stays
// mapped (perf_precise_end).
PERF_PRECISE_EXITING: I64{524288}

// A sampler's ring: its control page, then PERF_PRECISE_PAGES of samples.
// The kernel signals the thread each time half of them fill
// (perf_precise_open's watermark).
PERF_PRECISE_PAGE: I64{4096}

PERF_PRECISE_PAGES: I64{16}

// The control page's word, past the kernel's, that is 1 while a drain
// holds the ring (perf_samples_ring_drain), so one drain at a time moves
// its tail.
PERF_PRECISE_LOCK: I64{2048}

// The bytes of the thread's stack, from rsp up, each sample copies, for
// the call frame information's steps out of frames that keep no frame
// pointer (perf_samples_ring_sample).
PERF_PRECISE_STACK: I64{512}

// A sample's callchain starts with this context marker, PERF_CONTEXT_USER,
// then the interrupted rip and each return address of the kernel's frame
// pointer walk.
PERF_PRECISE_CONTEXT_USER: I64{-512}

// The most callchain entries the kernel writes of a sample's stack
// (/proc/sys/kernel/perf_event_max_stack), 0 under the timer; read before
// the first sampler is armed.
perf_precise_depth := I64{0}

// The kernel's cap on a sample's callchain entries where it has no
// perf_event_max_stack setting (PERF_MAX_STACK_DEPTH).
PERF_PRECISE_MAX_STACK: I64{127}

// The kernel's time to take one sample into a ring, as the start timed it
// (perf_precise_cost): picoseconds per sample, and per callchain entry.
perf_precise_cost_ps := I64{0}

perf_precise_frame_ps := I64{0}

// A thread's perf event sampler (perf_samples_thread_start) is its descriptor
// with this bit, which no timer id has.
PERF_PRECISE_TAG: I64{4294967296}

// The TCB word (Thread.jet) that holds the ring of the thread's sampler, 0
// for none; a fiber borrows its carrier's (perf_rings_lend), so the turns
// that change the task a sample is charged to drain the ring first
// (perf_samples_turn).
PERF_SAMPLES_TCB_RING: I64{776}

// Start sampling once per process: into the file JET_PERF_SAMPLES names,
// or, when it is unset, into the flight recorder's ring (perf_flight_open),
// CPU time alone at PERF_FLIGHT_INTERVAL_US.
perf_samples_start: fn() {
    if (perf_samples_fd >= I64{0}) {
        return
    }
    path: rt_env_get(env_name_jet_perf_samples())
    flight: path == I64{0}
    lenses: if (flight) -> PERF_LENS_CPU else -> perf_samples_lenses()
    fd := I64{-1}
    counters := I64{-1}
    topdown := I64{-1}
    sampler := I64{-1}
    threads := I64{-1}
    calls := I64{-1}
    if (flight) { fd = perf_flight_open() }
    if (!flight && rt_text_len(path) != I64{0}) {
        name: fd_c_path(path)
        fd = host_call(I64{2}, name, PERF_SAMPLES_OPEN, I64{384})
        fd_c_path_drop(name, path)
        if (fd >= I64{0}) {
            perf_spans_fd_set(perf_samples_open_beside(path, rt_static_text(".spans")))
            counters = perf_counters_open(path, lenses)
            topdown = perf_topdown_open(path, lenses)
            if ((lenses & PERF_LENS_CPU) != I64{0}) {
                sampler = perf_samples_open_beside(path, rt_static_text(".pc"))
            }
            threads = perf_samples_open_beside(path, rt_static_text(".threads"))
            calls = perf_samples_open_beside(path, rt_static_text(".syscalls"))
        }
    }
    if (!flight) { jet_rt_string_drop(path) }
    if (fd < I64{0}) {
        return
    }
    interval: if (flight) -> PERF_FLIGHT_INTERVAL_US else -> PERF_SAMPLES_INTERVAL_US
    image: alloc_check_image()
    bias: alloc_check_bias(image)
    low: perf_samples_code_edge(image, false)
    high: perf_samples_code_edge(image, true)
    perf_cfi_start(image)
    // The spawn, wait and wake records walk their stacks (perf_samples_stack).
    alloc_frames_start()
    buffer: alloc_map_try(wrapping(wrapping(wrapping(wrapping(PERF_SAMPLES_DEPTH + I64{1}) + PERF_COUNTERS_SLOTS) + PERF_SAMPLES_TALLIES) * I64{8}))
    if (buffer != I64{0}) {
        // No counter is open yet (perf_counter_of).
        index := I64{0}
        loop index < PERF_COUNTERS_SLOTS {
            rt_text_store(wrapping(perf_counters_table(buffer) + wrapping(index * I64{8})), I64{-1})
            index = wrapping(index + I64{1})
        }
    }
    slots: alloc_map_try(wrapping(PERF_SAMPLES_SLOTS * perf_samples_slot_bytes()))
    sides: alloc_map_try(wrapping(wrapping(PERF_SAMPLES_SLOTS + I64{1}) * perf_samples_side_bytes()))
    causal: if ((lenses & PERF_LENS_CAUSAL) != I64{0}) -> perf_causal_open(image) else -> I64{0}
    timers: if (flight) -> alloc_map_try(PERF_SAMPLES_TIMER_PAGE) else -> I64{0}
    #Unsafe("the observation start runs before the timer whose handler reads these is armed") {
        perf_causal_state = causal
        perf_samples_bias = bias
        perf_samples_image = image
        perf_samples_code_low = low
        perf_samples_code_high = high
        perf_samples_buffer = buffer
        perf_samples_slots = slots
        perf_samples_sides = sides
        perf_samples_buffered = if (flight || sides == I64{0}) -> I64{0} else -> I64{1}
        perf_samples_lens_mask = lenses
        perf_samples_interval_us = interval
        perf_samples_timers = timers
    }
    status := I64{0}
    // sa_flags SA_SIGINFO | SA_RESTORER | SA_ONSTACK | SA_RESTART: the
    // handler reads the interrupted context, runs on the thread's alternate
    // signal stack where it has one, and an interrupted system call resumes.
    #Unsafe("rt_sigaction borrows the four-word action on the stack; the handler is this runtime's three-word C-ABI export and the restorer its rt_sigreturn rail") {
        status = os_syscall_stack4_i64(I64{13}, PERF_SAMPLES_SIGNAL, rt_perf_samples_signal_address(), I64{469762052}, rt_process_signal_restore_address(), I64{0}, I64{8})
    }
    if (status >= I64{0}) {
        // While the descriptor is still -1 the handler returns at once.
        delivery: perf_samples_delivery()
        #Unsafe("no timer is armed yet, so no handler reads these before they are set") {
            perf_samples_delivery_ns = delivery
            perf_samples_fd = fd
        }
    }
    if (status >= I64{0} && (lenses & PERF_LENS_CPU) != I64{0}) {
        // This thread's own sampler, a perf event's where this thread can
        // open one, else its timer; each thread spawned from now on arms
        // its own as it starts.
        status = perf_precise_choose(sampler, flight || (lenses & PERF_LENS_CAUSAL) != I64{0})
        sampler = I64{-1}
        if (status < I64{0}) { status = perf_samples_thread_start() }
    }
    if (status < I64{0}) {
        #Unsafe("no timer is armed, so no handler reads the descriptor") {
            perf_samples_fd = I64{-1}
        }
        _ := host_call(I64{3}, fd, I64{0}, I64{0})
        if (counters >= I64{0}) { _ := host_call(I64{3}, counters, I64{0}, I64{0}) }
        if (topdown >= I64{0}) { _ := host_call(I64{3}, topdown, I64{0}, I64{0}) }
        if (sampler >= I64{0}) { _ := host_call(I64{3}, sampler, I64{0}, I64{0}) }
        if (threads >= I64{0}) { _ := host_call(I64{3}, threads, I64{0}, I64{0}) }
        if (calls >= I64{0}) { _ := host_call(I64{3}, calls, I64{0}, I64{0}) }
        return
    }
    // The CPU time sampled starts once the sampler is chosen, after the
    // time the choice and its cost's calibration took (perf_precise_cost).
    cpu: perf_samples_process_cpu_ns()
    #Unsafe("only the exit reads it, and no exit runs before the start returns") {
        perf_samples_cpu_start = cpu
    }
    perf_counters_start(buffer, counters)
    perf_topdown_start(buffer, topdown)
    perf_system_start(threads, calls)
    // A flight recorder of a checked image (`jet run --observe
    // --checked-alloc`) keeps the live list too, which `jet perf attach
    // --lens=alloc` snapshots (perf_flight_heap); only the alloc lens has
    // its takes count their allocations as well.
    counting: (lenses & PERF_LENS_ALLOC) != I64{0}
    if ((flight || counting) && alloc_check_track_start() && counting) { perf_samples_alloc_open() }
    // The record of the CPU time sampled, written at exit.
    observe_exit_install()
}

// The nanoseconds the kernel takes to deliver one SIGPROF to this thread
// and return from a handler that returns at once: PERF_SAMPLES_CALIBRATIONS
// signals the thread sends itself (tgkill) timed together, each also paying
// the call that sends it, as a timer's expiry pays the kernel's tick. They
// are timed on the thread's CPU clock, which counts the kernel's work for
// the thread but not the time it waits preempted, so on a busy machine the
// other programs' time is not charged to every signal of the run.
perf_samples_delivery: fn() -> I64 {
    pid: host_call(I64{39}, I64{0}, I64{0}, I64{0})
    tid: thread_tid()
    began: perf_samples_cpu_clock_ns(I64{3})
    index := I64{0}
    loop index < PERF_SAMPLES_CALIBRATIONS {
        #Unsafe("tgkill takes this process's and thread's ids and a signal whose handler returns at once") {
            _ := os_syscall_i64(I64{234}, pid, tid, PERF_SAMPLES_SIGNAL, I64{0}, I64{0}, I64{0})
        }
        index = wrapping(index + I64{1})
    }
    wrapping(perf_samples_cpu_clock_ns(I64{3}) - began) / PERF_SAMPLES_CALIBRATIONS
}

// The monotonic clock in nanoseconds, for the handler: read into the
// interrupted thread's PERF_SAMPLES_TCB_CLOCK words, which nothing else
// uses, so it never overwrites the clock words the interrupted code may be
// reading (sync_now_ns's).
perf_samples_clock: fn() -> I64 {
    scratch := I64{0}
    #Unsafe("clock_gettime writes the sampler's two words of the thread-owned TCB; no pointer escapes") {
        scratch = wrapping(os_tls_base_i64() + PERF_SAMPLES_TCB_CLOCK)
        sync_clock_read(I64{1}, scratch)
    }
    wrapping(wrapping(rt_text_word(scratch) * I64{1000000000}) + rt_text_word(wrapping(scratch + I64{8})))
}

// Add the nanoseconds since `began` (perf_samples_clock) to those every
// handler has run, the record buffer's last word.
perf_samples_charge: fn(buffer: I64, began: I64) {
    if (buffer == I64{0}) {
        return
    }
    _ := sync_add(wrapping(buffer + wrapping(wrapping(wrapping(PERF_SAMPLES_DEPTH + I64{1}) + PERF_COUNTERS_SLOTS) * I64{8})), wrapping(perf_samples_clock() - began))
}

// Arm this thread's sampler while the process samples CPU time: the perf
// event of the source the start chose (perf_precise_arm), else a timer on
// this thread's CPU clock (CLOCK_THREAD_CPUTIME_ID) that sends this thread
// SIGPROF (SIGEV_THREAD_ID) for each perf_samples_interval_us of CPU time
// it uses: its handle, for perf_samples_thread_end; the negated errno the
// kernel refused it with; -1 when the process does not sample CPU time.
// A thread whose perf event the kernel refuses goes unsampled.
perf_samples_thread_start: fn() -> I64 {
    if (perf_samples_fd < I64{0} || (perf_samples_lens_mask & PERF_LENS_CPU) == I64{0}) {
        return I64{-1}
    }
    if (perf_precise_rings != I64{0}) { return perf_precise_arm(perf_precise_source) }
    // The sigevent's 64 bytes, the timer id the kernel writes after them,
    // then the itimerspec.
    scratch: jet_rt_alloc(I64{104}, I64{8})
    thread_zero(scratch, I64{104})
    // sigev_signo SIGPROF and sigev_notify SIGEV_THREAD_ID (4) after the
    // value word, then the thread's tid.
    rt_text_store(wrapping(scratch + I64{8}), PERF_SAMPLES_SIGNAL | (I64{4} << I64{32}))
    rt_text_store(wrapping(scratch + I64{16}), thread_tid())
    status := I64{0}
    #Unsafe("timer_create reads the sigevent and writes the timer id in the scratch words") {
        status = os_syscall_i64(I64{222}, I64{3}, scratch, wrapping(scratch + I64{64}), I64{0}, I64{0}, I64{0})
    }
    id: rt_text_word(wrapping(scratch + I64{64})) & I64{4294967295}
    if (status >= I64{0}) {
        // Kept before it is armed: a rate change (perf_samples_rate) either
        // finds it in the table or stores its interval before the arming
        // below reads it.
        perf_samples_timer_keep(id)
        // The interval, then the first expiry, each as seconds and
        // nanoseconds: the interval in force, armed again while a rate
        // change moved it meanwhile.
        spec: wrapping(scratch + I64{72})
        armed := I64{0}
        loop status >= (I64{0}) && armed != perf_samples_interval_us {
            armed = perf_samples_interval_us
            rt_text_store(wrapping(spec + I64{8}), wrapping(armed * I64{1000}))
            rt_text_store(wrapping(spec + I64{24}), wrapping(armed * I64{1000}))
            #Unsafe("timer_settime reads the itimerspec in the scratch words") {
                status = os_syscall_i64(I64{223}, id, I64{0}, spec, I64{0}, I64{0}, I64{0})
            }
        }
        if (status < I64{0}) {
            // A timer the kernel refuses to arm is deleted.
            perf_samples_timer_drop(id)
            #Unsafe("timer_delete takes the id timer_create just gave") {
                _ := os_syscall_i64(I64{226}, id, I64{0}, I64{0}, I64{0}, I64{0}, I64{0})
            }
        }
    }
    jet_rt_free(scratch, I64{104}, I64{8})
    if (status < I64{0}) -> status else -> id
}

// End this thread's sampler (perf_samples_thread_start, `sampler`) as the
// thread ends: a perf event's ring drained (perf_samples_turn) and the
// event closed, a timer deleted; nothing when it has none.
perf_samples_thread_end: fn(sampler: I64) {
    if (sampler < I64{0}) {
        return
    }
    if ((sampler & PERF_PRECISE_TAG) != I64{0}) {
        tcb: thread_base()
        perf_samples_turn(tcb)
        sync_store(wrapping(tcb + PERF_SAMPLES_TCB_RING), I64{0})
        perf_precise_end(sampler & I64{4294967295})
        return
    }
    perf_samples_timer_drop(sampler)
    #Unsafe("timer_delete takes the id this thread's start was given") {
        _ := os_syscall_i64(I64{226}, sampler, I64{0}, I64{0}, I64{0}, I64{0}, I64{0})
    }
}

// The table of sampler timers (perf_samples_timers): pages of
// PERF_SAMPLES_TIMER_PAGE bytes, each its next page's address, 0 for none,
// then one word per timer, its id plus one, 0 while free. A page fills
// before the next is mapped, and none is unmapped, so a rate change walks
// them while threads start and end.
PERF_SAMPLES_TIMER_PAGE: I64{4096}

// Keep timer `id` in the table's first free word, mapping a page when every
// one is taken. Where no page can be mapped the timer is not kept, and keeps
// the interval it was armed at.
perf_samples_timer_keep: fn(id: I64) {
    page := perf_samples_timers
    loop page != (I64{0}) {
        at := I64{8}
        loop at < PERF_SAMPLES_TIMER_PAGE {
            if (sync_cas(wrapping(page + at), I64{0}, wrapping(id + I64{1})) == I64{0}) {
                return
            }
            at = wrapping(at + I64{8})
        }
        if (sync_load(page) == I64{0}) {
            fresh: alloc_map_try(PERF_SAMPLES_TIMER_PAGE)
            if (fresh == I64{0}) {
                return
            }
            // Another thread's page may have been linked first.
            if (sync_cas(page, I64{0}, fresh) != I64{0}) {
                alloc_unmap(fresh, PERF_SAMPLES_TIMER_PAGE)
            }
        }
        page = sync_load(page)
    }
}

// Free the table's word of timer `id`, before the timer is deleted.
perf_samples_timer_drop: fn(id: I64) {
    page := perf_samples_timers
    loop page != (I64{0}) {
        at := I64{8}
        loop at < PERF_SAMPLES_TIMER_PAGE {
            if (sync_cas(wrapping(page + at), wrapping(id + I64{1}), I64{0}) == wrapping(id + I64{1})) {
                return
            }
            at = wrapping(at + I64{8})
        }
        page = sync_load(page)
    }
}

// Sample each thread's CPU time once per `interval_us` from now on: the
// interval a starting thread arms its timer at (perf_samples_thread_start),
// then every timer the table keeps armed again at it. The locked read
// orders the interval's store before the table's reads, as a starting
// thread keeps its timer before it reads the interval, so each timer ends
// armed at the newest. A timer its thread deleted meanwhile is refused.
perf_samples_rate: fn(interval_us: I64) {
    #Unsafe("only the observation writer changes it, under the flight recorder's lock; a starting thread reads it again after it arms") {
        perf_samples_interval_us = interval_us
    }
    page := perf_samples_timers
    if (page == I64{0}) {
        return
    }
    _ := sync_add(page, I64{0})
    spec: jet_rt_alloc(I64{32}, I64{8})
    thread_zero(spec, I64{32})
    rt_text_store(wrapping(spec + I64{8}), wrapping(interval_us * I64{1000}))
    rt_text_store(wrapping(spec + I64{24}), wrapping(interval_us * I64{1000}))
    loop page != (I64{0}) {
        at := I64{8}
        loop at < PERF_SAMPLES_TIMER_PAGE {
            kept: sync_load(wrapping(page + at))
            if (kept != I64{0}) {
                #Unsafe("timer_settime reads the itimerspec this call owns") {
                    _ := os_syscall_i64(I64{223}, wrapping(kept - I64{1}), I64{0}, spec, I64{0}, I64{0}, I64{0})
                }
            }
            at = wrapping(at + I64{8})
        }
        page = sync_load(page)
    }
    jet_rt_free(spec, I64{32}, I64{8})
}

// Map the thread and host call table (perf_system) once the start has
// armed sampling, keeping `threads` and `calls`, the files the exit writes
// it to (perf_system_exit), the main thread, which starts sampling, its
// first row. Without both files or the table's pages the run keeps no
// table, and the files are closed.
perf_system_start: fn(threads: I64, calls: I64) {
    table: if (threads >= I64{0} && calls >= I64{0}) -> alloc_map_try(perf_system_bytes()) else -> I64{0}
    if (table == I64{0}) {
        if (threads >= I64{0}) { _ := host_call(I64{3}, threads, I64{0}, I64{0}) }
        if (calls >= I64{0}) { _ := host_call(I64{3}, calls, I64{0}, I64{0}) }
        return
    }
    rt_text_store(table, perf_system_pid())
    main: perf_threads_claim(table)
    // RLIMIT_STACK's soft limit, 0 for none.
    soft: thread_rlimit_soft(I64{3})
    rt_text_store(wrapping(main + I64{16}), if (soft < I64{0}) -> I64{0} else -> soft)
    rt_text_store(wrapping(main + I64{24}), time_host_monotonic_i64())
    rt_text_store(main, thread_tid())
    #Unsafe("set once, before the table is published; a host call or spawn that reads perf_system 0 keeps no row") {
        perf_threads_fd = threads
        perf_syscalls_fd = calls
        perf_system = table
    }
}

// The bytes of the system table (perf_system), and where its host call
// rows start.
perf_system_bytes: fn() -> I64 {
    wrapping(perf_syscalls_offset() + wrapping(PERF_SYSCALLS_ROWS * wrapping(PERF_SYSCALLS_ROW_WORDS * I64{8})))
}

perf_syscalls_offset: fn() -> I64 {
    wrapping(I64{24} + wrapping(PERF_THREADS_ROWS * wrapping(PERF_THREADS_ROW_WORDS * I64{8})))
}

// This process's id, read without a host call, which the table would count.
perf_system_pid: fn() -> I64 {
    #Unsafe("getpid takes no arguments") {
        return os_syscall_i64(I64{39}, I64{0}, I64{0}, I64{0}, I64{0}, I64{0}, I64{0})
    }
}

// The next thread row of `table` (perf_system), 0 once every row is taken.
perf_threads_claim: fn(table: I64) -> I64 {
    index: sync_add(wrapping(table + I64{8}), I64{1})
    if (index >= PERF_THREADS_ROWS) -> I64{0} else -> wrapping(wrapping(table + I64{24}) + wrapping(index * wrapping(PERF_THREADS_ROW_WORDS * I64{8})))
}

// The row of a thread Thread.jet thread_spawn starts to run `entry`, under
// `jet perf run`: claimed by the spawner, which keeps the entry and its own
// calling stack (perf_samples_stack) there, for the thread to fill in as
// it begins and ends (perf_threads_begin, perf_threads_end); 0 without a
// table or once every row is taken. The row of a thread that never starts
// keeps id 0.
perf_threads_spawn: fn(entry: I64) -> I64 {
    table: perf_system
    if (table == I64{0}) { return I64{0} }
    row: perf_threads_claim(table)
    if (row == I64{0}) { return I64{0} }
    rt_text_store(wrapping(row + I64{8}), wrapping(entry - perf_samples_bias))
    rt_text_store(wrapping(row + I64{56}), perf_samples_stack(wrapping(row + I64{64})))
    row
}

// A spawned thread's first words in its row `row` (perf_threads_spawn; 0
// for none): its stack's bytes, the monotonic clock now, then its id.
perf_threads_begin: fn(row: I64, stack_bytes: I64) {
    if (row == I64{0}) {
        return
    }
    rt_text_store(wrapping(row + I64{16}), stack_bytes)
    rt_text_store(wrapping(row + I64{24}), time_host_monotonic_i64())
    sync_store(row, thread_tid())
}

// A spawned thread's last words in its row `row` (0 for none), as its
// entry returns: the monotonic clock now, its CPU time, then its end mark.
perf_threads_end: fn(row: I64) {
    if (row == I64{0}) {
        return
    }
    rt_text_store(wrapping(row + I64{32}), time_host_monotonic_i64())
    rt_text_store(wrapping(row + I64{40}), perf_samples_cpu_clock_ns(I64{3}))
    sync_store(wrapping(row + I64{48}), I64{1})
}

// A host call (HostProcess.jet host_call) under `jet perf run`: counted at
// its row (perf_syscall_row) before it enters the kernel, so an execve
// that succeeds, which never returns, counts too, and timed on the
// monotonic clock once it returns. The child of a vfork (HostSpawn.jet
// spawn_vfork) counts its calls, its PATH's execve probes, in the table it
// shares with its parent, which waits meanwhile.
perf_syscall_call: fn(number: I64, a1: I64, a2: I64, a3: I64) -> I64 {
    row: perf_syscall_row(perf_system, number)
    began: time_host_monotonic_i64()
    result := I64{0}
    #Unsafe("host_call's audited caller supplies the Linux syscall's valid word arguments") {
        result = os_syscall_i64(number, a1, a2, a3, I64{0}, I64{0}, I64{0})
    }
    if (row != I64{0}) {
        _ := sync_add(wrapping(row + I64{24}), wrapping(time_host_monotonic_i64() - began))
    }
    result
}

// The row of host call `number` from this thread's calling stack in
// `table` (perf_system), its call counted: the row whose key
// (perf_syscall_key) matches, else a free one it claims and fills with
// the number and the calling sites; 0, counted as lost, when every row is
// another's. Nothing here allocates.
perf_syscall_row: fn(table: I64, number: I64) -> I64 {
    key: perf_syscall_key(number, I64{0}) | I64{1}
    rows: wrapping(table + perf_syscalls_offset())
    mask: wrapping(PERF_SYSCALLS_ROWS - I64{1})
    first: (key >> I64{32}) & mask
    probe := I64{0}
    loop probe < PERF_SYSCALLS_ROWS {
        row: wrapping(rows + wrapping(((first + probe) & mask) * wrapping(PERF_SYSCALLS_ROW_WORDS * I64{8})))
        held: sync_cas(row, I64{0}, key)
        if (held == I64{0}) {
            rt_text_store(wrapping(row + I64{8}), number)
            _ := perf_syscall_key(number, wrapping(row + I64{32}))
        }
        if (held == I64{0} || held == key) {
            _ := sync_add(wrapping(row + I64{16}), I64{1})
            return row
        }
        probe = wrapping(probe + I64{1})
    }
    _ := sync_add(wrapping(table + I64{16}), I64{1})
    I64{0}
}

// The key of host call `number` from this thread's calling stack: the
// number hashed with the call sites up the frame pointer chain, at most
// PERF_SAMPLES_STACK_DEPTH of them, each less the load bias, while it is in
// the image's code, as perf_samples_stack walks them (Alloc.jet
// alloc_frames_key). With `into` not 0 it also stores those sites there.
// It allocates nothing.
perf_syscall_key: fn(number: I64, into: I64) -> I64 {
    alloc_frames_key(wrapping(number * I64{-7046029254386353131}), into, PERF_SAMPLES_STACK_DEPTH, perf_samples_bias, perf_samples_code_low, perf_samples_code_high)
}

// At the exit (perf_samples_exit): the system table into its files, each
// emptied first, so that a later exit's replaces an earlier's.
// `<samples>.threads`: PERF_THREADS_ROW_WORDS, how many rows were claimed
// (past PERF_THREADS_ROWS, the threads that got none), then the rows kept,
// a thread still running with the exit as its end and its CPU time so far
// (its end mark still 0). `<samples>.syscalls`: the words of a row less its
// key, how many rows follow, how many calls found no row, then each taken
// row less its key. A forked child that inherited the table writes none.
// Its two buffers are the observation's own blocks (Alloc.jet
// alloc_check_own_enter), which the exit's heap snapshot, taken after,
// leaves out: an ending process's frees give nothing back (Alloc.jet
// alloc_give, #5478), so a tracked buffer would stay on the live list as a
// block with no line of the program's.
perf_system_exit: fn() {
    table: perf_system
    if (table == I64{0} || rt_text_word(table) != perf_system_pid()) {
        return
    }
    alloc_check_own_enter()
    now: time_host_monotonic_i64()
    claimed: sync_load(wrapping(table + I64{8}))
    kept: if (claimed > PERF_THREADS_ROWS) -> PERF_THREADS_ROWS else -> claimed
    row_bytes: wrapping(PERF_THREADS_ROW_WORDS * I64{8})
    size: wrapping(I64{16} + wrapping(kept * row_bytes))
    out: jet_rt_alloc(size, I64{8})
    rt_text_store(out, PERF_THREADS_ROW_WORDS)
    rt_text_store(wrapping(out + I64{8}), claimed)
    index := I64{0}
    loop index < kept {
        row: wrapping(wrapping(table + I64{24}) + wrapping(index * row_bytes))
        written: wrapping(wrapping(out + I64{16}) + wrapping(index * row_bytes))
        rt_text_bytes_copy(written, row, row_bytes)
        tid: rt_text_word(row)
        if (tid != I64{0} && sync_load(wrapping(row + I64{48})) == I64{0}) {
            // The thread's own CPU-time clock: MAKE_THREAD_CPUCLOCK(tid,
            // CPUCLOCK_SCHED).
            rt_text_store(wrapping(written + I64{32}), now)
            rt_text_store(wrapping(written + I64{40}), perf_samples_cpu_clock_ns(((tid ~ I64{-1}) << I64{3}) | I64{6}))
        }
        index = wrapping(index + I64{1})
    }
    perf_system_write(perf_threads_fd, out, size)
    jet_rt_free(out, size, I64{8})
    rows: wrapping(table + perf_syscalls_offset())
    call_bytes: wrapping(PERF_SYSCALLS_ROW_WORDS * I64{8})
    taken := I64{0}
    index = I64{0}
    loop index < PERF_SYSCALLS_ROWS {
        if (sync_load(wrapping(rows + wrapping(index * call_bytes))) != I64{0}) {
            taken = wrapping(taken + I64{1})
        }
        index = wrapping(index + I64{1})
    }
    kept_bytes: wrapping(call_bytes - I64{8})
    calls_size: wrapping(I64{24} + wrapping(taken * kept_bytes))
    calls: jet_rt_alloc(calls_size, I64{8})
    rt_text_store(calls, wrapping(PERF_SYSCALLS_ROW_WORDS - I64{1}))
    rt_text_store(wrapping(calls + I64{8}), taken)
    rt_text_store(wrapping(calls + I64{16}), sync_load(wrapping(table + I64{16})))
    // A row taken since the count is left out once the count's are written.
    at := I64{24}
    index = I64{0}
    loop index < PERF_SYSCALLS_ROWS {
        row: wrapping(rows + wrapping(index * call_bytes))
        if (sync_load(row) != I64{0} && wrapping(at + kept_bytes) <= calls_size) {
            rt_text_bytes_copy(wrapping(calls + at), wrapping(row + I64{8}), kept_bytes)
            at = wrapping(at + kept_bytes)
        }
        index = wrapping(index + I64{1})
    }
    perf_system_write(perf_syscalls_fd, calls, calls_size)
    jet_rt_free(calls, calls_size, I64{8})
    alloc_check_own_leave()
}

// The `size` bytes at `bytes` as the whole of the file `fd`, which appends.
perf_system_write: fn(fd: I64, bytes: I64, size: I64) {
    if (fd < I64{0}) {
        return
    }
    #Unsafe("ftruncate takes the table's own descriptor") {
        _ := os_syscall_i64(I64{77}, fd, I64{0}, I64{0}, I64{0}, I64{0}, I64{0})
    }
    _ := host_write_all(fd, bytes, size)
}

// Choose the CPU lens's sampler once, on the thread that starts sampling,
// the program's main thread, by arming it there. Where perf_event_paranoid
// is at most 1, a precise source: IBS op sampling, then PEBS, each every
// perf_precise_period cycles. Else, or where neither opens, at most 2, the
// task clock. Else (-1) each thread's timer, which the flight recorder and
// the causal lens keep (`timer`), since a causal experiment's periods are
// CPU time's. A perf event's cost per sample is timed once it is armed
// (perf_precise_cost). Writes eight words to `file` (`<samples>.pc`, -1 for
// none), and closes it: the source, the errno IBS op sampling, PEBS and the
// task clock were each refused with, or 0, perf_event_paranoid
// (PERF_PARANOID_NONE where the kernel has none), the source's period (in
// cycles for a precise one, else in nanoseconds of CPU time), 1 where
// `timer` kept the timer, and the most callchain entries the kernel writes
// of a perf event's sample (perf_precise_depth, 0 under the timer). The
// armed sampler's handle (perf_precise_arm), or -1.
perf_precise_choose: fn(file: I64, timer: Bool) -> I64 {
    ibs := I64{0}
    pebs := I64{0}
    task := I64{0}
    paranoid: perf_samples_sysctl(rt_static_text("/proc/sys/kernel/perf_event_paranoid"))
    handle := I64{-1}
    rings: if (timer) -> I64{0} else -> alloc_map_try(wrapping(PERF_PRECISE_EXITING + I64{8}))
    if (rings != I64{0}) {
        max: perf_samples_sysctl(rt_static_text("/proc/sys/kernel/perf_event_max_stack"))
        #Unsafe("the table and the depth are set before the first sampler is armed, so no handler reads them before") {
            perf_precise_rings = rings
            perf_precise_depth = if (max == PERF_PARANOID_NONE) -> PERF_PRECISE_MAX_STACK else -> max
        }
        if (paranoid <= I64{1}) {
            cycles: perf_precise_cycles()
            if (cycles < I64{0}) {
                ibs = wrapping(I64{0} - cycles)
                pebs = ibs
            } else {
                #Unsafe("no sampler is armed yet, so no thread reads the source or its period") {
                    perf_precise_period = cycles
                    perf_precise_source = PERF_PC_IBS_OP
                }
                handle = perf_precise_arm(PERF_PC_IBS_OP)
                if (handle < I64{0}) {
                    ibs = wrapping(I64{0} - handle)
                    #Unsafe("no sampler is armed yet, so no thread reads the source") {
                        perf_precise_source = PERF_PC_PEBS
                    }
                    handle = perf_precise_arm(PERF_PC_PEBS)
                    if (handle < I64{0}) { pebs = wrapping(I64{0} - handle) }
                }
            }
        }
        if (handle < I64{0} && paranoid <= I64{2}) {
            #Unsafe("no sampler is armed yet, so no thread reads the source") {
                perf_precise_source = PERF_PC_TASK_CLOCK
            }
            handle = perf_precise_arm(PERF_PC_TASK_CLOCK)
            if (handle < I64{0}) { task = wrapping(I64{0} - handle) }
        }
        if (handle < I64{0}) {
            #Unsafe("no sampler is armed, so no handler reads the table") {
                perf_precise_rings = I64{0}
                perf_precise_source = PERF_PC_TIMER
                perf_precise_depth = I64{0}
            }
            alloc_unmap(rings, wrapping(PERF_PRECISE_EXITING + I64{8}))
        } else { perf_precise_cost(perf_precise_source, handle & I64{4294967295}) }
    }
    if (file >= I64{0}) {
        precise: perf_precise_source == PERF_PC_IBS_OP || perf_precise_source == PERF_PC_PEBS
        period: if (precise) -> perf_precise_period else -> wrapping(perf_samples_interval_us * I64{1000})
        #Unsafe("eight writes of a stack-local word, which the kernel copies before each call returns") {
            _ := os_write_word_i64(file, perf_precise_source, I64{8})
            _ := os_write_word_i64(file, ibs, I64{8})
            _ := os_write_word_i64(file, pebs, I64{8})
            _ := os_write_word_i64(file, task, I64{8})
            _ := os_write_word_i64(file, paranoid, I64{8})
            _ := os_write_word_i64(file, period, I64{8})
            _ := os_write_word_i64(file, if (timer) -> I64{1} else -> I64{0}, I64{8})
            _ := os_write_word_i64(file, perf_precise_depth, I64{8})
        }
        _ := host_call(I64{3}, file, I64{0}, I64{0})
    }
    handle
}

// The kernel setting the text `path` names under /proc/sys (such as
// perf_event_paranoid), a decimal number with an optional sign;
// PERF_PARANOID_NONE where it can't be read.
perf_samples_sysctl: fn(path: I64) -> I64 {
    name: fd_c_path(path)
    fd: host_call(I64{2}, name, I64{524288}, I64{0})
    fd_c_path_drop(name, path)
    if (fd < I64{0}) { return PERF_PARANOID_NONE }
    scratch: jet_rt_alloc(I64{16}, I64{8})
    thread_zero(scratch, I64{16})
    count: host_call(I64{0}, fd, scratch, I64{16})
    _ := host_call(I64{3}, fd, I64{0}, I64{0})
    negative: count > I64{0} && rt_text_byte(scratch) == I64{45}
    at := if (negative) -> I64{1} else -> I64{0}
    first: at
    value := I64{0}
    loop at < count {
        digit: rt_text_byte(wrapping(scratch + at))
        if (digit < I64{48} || digit > I64{57}) { break }
        value = wrapping(wrapping(value * I64{10}) + wrapping(digit - I64{48}))
        at = wrapping(at + I64{1})
    }
    jet_rt_free(scratch, I64{16}, I64{8})
    if (at == first) { return PERF_PARANOID_NONE }
    if (negative) -> wrapping(I64{0} - value) else -> value
}

// The CPU cycles this thread runs in perf_samples_interval_us of its CPU
// time, a multiple of 16 as IBS's period must be: a cycles counter of this
// thread, read until it has run that long; the negated errno of the call
// the kernel refused, EIO where the counter never ran. A precise source
// counts cycles, so at this period its rate follows the clock speed the
// cores run at: the measured one gives the timer's rate as sampling
// starts.
perf_precise_cycles: fn() -> I64 {
    attr: jet_rt_alloc(I64{72}, I64{8})
    thread_zero(attr, I64{72})
    // PERF_TYPE_HARDWARE's cycles counted, with read_format
    // PERF_FORMAT_TOTAL_TIME_RUNNING and the flag exclude_hv.
    rt_text_store(attr, I64{72} << I64{32})
    rt_text_store(wrapping(attr + I64{32}), I64{2})
    rt_text_store(wrapping(attr + I64{40}), I64{64})
    fd := I64{-1}
    #Unsafe("perf_event_open reads the attribute words of the scratch") {
        fd = os_syscall_i64(I64{298}, attr, I64{0}, I64{-1}, I64{-1}, I64{8}, I64{0})
    }
    if (fd < I64{0}) {
        jet_rt_free(attr, I64{72}, I64{8})
        return fd
    }
    // Each read writes the count, then the nanoseconds the counter ran,
    // over the attribute's first two words.
    goal: wrapping(perf_samples_interval_us * I64{1000})
    read := I64{0}
    tries := I64{0}
    loop tries < (I64{1000000}) {
        read = host_call(I64{0}, fd, attr, I64{16})
        if (read != I64{16} || rt_text_word(wrapping(attr + I64{8})) >= goal) { break }
        tries = wrapping(tries + I64{1})
    }
    _ := host_call(I64{3}, fd, I64{0}, I64{0})
    count: rt_text_word(attr)
    ran: rt_text_word(wrapping(attr + I64{8}))
    jet_rt_free(attr, I64{72}, I64{8})
    if (read != I64{16} || ran <= I64{0} || count <= I64{0}) { return I64{-5} }
    cycles: wrapping(count * goal) / ran
    if (cycles < I64{16}) -> I64{16} else -> cycles & I64{-16}
}

// Arm this thread's sampler of `source` (perf_precise_open) at its period:
// once per perf_samples_interval_us of the thread's CPU time for the task
// clock, once per perf_precise_period cycles for a precise source, its ring
// kept in the table by its descriptor (perf_precise_attach). The
// descriptor with PERF_PRECISE_TAG, or the negated errno of the call the
// kernel refused, ENOENT where there is no `ibs_op` PMU.
perf_precise_arm: fn(source: I64) -> I64 {
    attr: jet_rt_alloc(I64{96}, I64{8})
    period: if (source == PERF_PC_TASK_CLOCK) -> wrapping(perf_samples_interval_us * I64{1000}) else -> perf_precise_period
    fd := perf_precise_open(attr, source, period)
    if (fd >= I64{0}) { fd = perf_precise_attach(fd, attr) }
    jet_rt_free(attr, I64{96}, I64{8})
    fd
}

// perf_event_open of a sampler of `source` on this thread in user mode,
// once per `period`, disabled, its attribute words built in the 96 bytes at
// `attr`. The task clock is the software event of this thread's CPU clock,
// its period in nanoseconds of it; time in the kernel takes no sample. IBS
// op sampling is the PMU whose sysfs directory is `ibs_op`, filtered to
// user mode in software (swfilt, config2 bit 0); PEBS is the core PMU's
// cycles at precise_ip 2; each period in cycles. Each sample is the
// kernel's: the sampled instruction pointer, its time on the monotonic
// clock, the callchain of the kernel's frame pointer walk of the user
// stack, at most perf_precise_depth entries, the user rbp, rsp and rip, and
// PERF_PRECISE_STACK bytes of the stack from rsp (the record
// perf_samples_ring_sample reads), and the kernel signals the thread's
// owner once half the ring fills. The descriptor, or the negated errno of
// the call the kernel refused.
perf_precise_open: fn(attr: I64, source: I64, period: I64) -> I64 {
    thread_zero(attr, I64{96})
    kind := if (source == PERF_PC_TASK_CLOCK) -> I64{1} else -> I64{0}
    if (source == PERF_PC_IBS_OP) {
        kind = perf_topdown_pmu(rt_static_text("/sys/bus/event_source/devices/ibs_op/type"), attr)
    }
    if (kind < I64{0}) { return kind }
    // perf_event_attr through clockid (PERF_ATTR_SIZE_VER3): its type and
    // size, config 0 (IBS's cycle count, or cycles) or 1
    // (PERF_COUNT_SW_TASK_CLOCK), the sample period, sample_type
    // PERF_SAMPLE_IP | TIME | CALLCHAIN | REGS_USER | STACK_USER, the flags
    // disabled | exclude_kernel | exclude_hv | watermark |
    // exclude_callchain_kernel | use_clockid, with precise_ip 2 for PEBS,
    // the wakeup watermark, config2, sample_regs_user rbp, rsp and rip
    // (bits 6, 7 and 8), sample_stack_user and clockid CLOCK_MONOTONIC.
    clock: source == PERF_PC_TASK_CLOCK
    rt_text_store(attr, kind | (I64{96} << I64{32}))
    rt_text_store(wrapping(attr + I64{8}), if (clock) -> I64{1} else -> I64{0})
    rt_text_store(wrapping(attr + I64{16}), period)
    rt_text_store(wrapping(attr + I64{24}), I64{12325})
    rt_text_store(wrapping(attr + I64{40}), if (source == PERF_PC_PEBS) -> I64{35733601} else -> I64{35668065})
    rt_text_store(wrapping(attr + I64{48}), wrapping(PERF_PRECISE_PAGES * PERF_PRECISE_PAGE) >> I64{1})
    rt_text_store(wrapping(attr + I64{64}), if (source == PERF_PC_IBS_OP) -> I64{1} else -> I64{0})
    rt_text_store(wrapping(attr + I64{80}), I64{448})
    rt_text_store(wrapping(attr + I64{88}), PERF_PRECISE_STACK | (I64{1} << I64{32}))
    #Unsafe("perf_event_open reads the attribute words of the scratch") {
        return os_syscall_i64(I64{298}, attr, I64{0}, I64{-1}, I64{-1}, I64{8}, I64{0})
    }
}

// Map sampler `fd`'s ring into the table, write its tail once, have the
// ring signal this thread with SIGPROF as it fills (perf_event_signal, its
// f_owner_ex built at `owner`), enable it and keep it in this thread's
// TCB (PERF_SAMPLES_TCB_RING). A sampler the kernel refuses any of that
// for is closed. Its handle, or the negated errno of the call the kernel
// refused.
perf_precise_attach: fn(fd: I64, owner: I64) -> I64 {
    if (fd >= PERF_PRECISE_FDS) {
        _ := host_call(I64{3}, fd, I64{0}, I64{0})
        return I64{-24}
    }
    ring: alloc_map_shared(perf_precise_ring_bytes(), fd)
    result := if (ring < I64{0}) -> ring else -> I64{0}
    if (result >= I64{0}) {
        // The first store to a perf ring's first page takes a write fault
        // that the kernel abandons, and retries from user mode, whenever a
        // signal is pending. The memory lens's page-fault counter queues
        // PERF_COUNTERS_SIGNAL at each fault it counts, the retry included,
        // so a drain's first tail store (perf_samples_ring_drain) made once
        // that counter is armed faults forever. The tail's first store is
        // made here, before this sampler is enabled; the main thread
        // attaches its sampler before perf_counters_start arms the
        // counters, and they count the main thread alone, so no armed
        // counter counts this store's fault. The drain lock shares the page.
        sync_store(wrapping(ring + I64{1032}), I64{0})
        sync_store(wrapping(perf_precise_rings + wrapping(fd * I64{8})), ring)
        result = perf_event_signal(fd, PERF_SAMPLES_SIGNAL, owner, thread_tid())
    }
    if (result >= I64{0}) {
        #Unsafe("ioctl PERF_EVENT_IOC_ENABLE takes no argument") {
            result = os_syscall_i64(I64{16}, fd, I64{9216}, I64{0}, I64{0}, I64{0}, I64{0})
        }
    }
    if (result < I64{0}) {
        perf_precise_end(fd)
        return result
    }
    sync_store(wrapping(thread_base() + PERF_SAMPLES_TCB_RING), ring)
    fd | PERF_PRECISE_TAG
}

// The bytes of a sampler's ring mapping.
perf_precise_ring_bytes: fn() -> I64 {
    wrapping(wrapping(PERF_PRECISE_PAGES + I64{1}) * PERF_PRECISE_PAGE)
}

// Close sampler `fd` and unmap its ring, its table slot cleared first, so
// that a signal still pending finds no ring. The ring is unmapped once no
// drain holds it; once the exit drains every ring
// (perf_precise_rings_drain), which may have read it from the table before
// it was cleared, it stays mapped for the process's last moments.
perf_precise_end: fn(fd: I64) {
    rings: perf_precise_rings
    slot: wrapping(rings + wrapping(fd * I64{8}))
    ring: sync_load(slot)
    sync_store(slot, I64{0})
    _ := host_call(I64{3}, fd, I64{0}, I64{0})
    if (ring == I64{0}) {
        return
    }
    // The lock's swap orders the cleared slot before the exit word's read,
    // as the exit's swap of that word orders it before its reads of the
    // table, so either the exit finds the slot cleared or this finds the
    // exit.
    loop sync_cas(wrapping(ring + PERF_PRECISE_LOCK), I64{0}, I64{1}) != (I64{0}) {
        _ := host_call(I64{24}, I64{0}, I64{0}, I64{0})
    }
    if (sync_load(wrapping(rings + PERF_PRECISE_EXITING)) == I64{0}) {
        alloc_unmap(ring, perf_precise_ring_bytes())
    }
}

// Time the kernel's part of one sample of `source`, whose armed sampler
// `fd` is held disabled meanwhile: a second sampler of `source`, with no
// signal, samples perf_precise_spin's steps at a twelfth of the source's
// period, first called from here and then PERF_PRECISE_DEEP calls deeper,
// each against the same steps with that sampler disabled, the fastest of
// PERF_PRECISE_ROUNDS each, on the monotonic clock, which counts the
// interrupt's time that the thread's CPU clock may leave out. The
// difference per sample at each depth gives the kernel's picoseconds per
// sample and per callchain entry (perf_precise_cost_ps,
// perf_precise_frame_ps), which each drained sample adds to the tally
// (PERF_SAMPLES_RING_PS). Both stay 0 where the second sampler does not
// open or its samples do not tell the depths apart.
perf_precise_cost: fn(source: I64, fd: I64) {
    #Unsafe("ioctl PERF_EVENT_IOC_DISABLE takes no argument") {
        _ := os_syscall_i64(I64{16}, fd, I64{9217}, I64{0}, I64{0}, I64{0}, I64{0})
    }
    // The attribute's 96 bytes, then the counts of a round: its samples and
    // their callchain entries.
    scratch: jet_rt_alloc(I64{112}, I64{8})
    period: if (source == PERF_PC_TASK_CLOCK) -> PERF_PRECISE_COST_NS else -> (perf_precise_period / I64{12}) & I64{-16}
    timer: perf_precise_open(scratch, source, if (period < I64{16}) -> I64{16} else -> period)
    ring: if (timer < I64{0}) -> I64{-1} else -> alloc_map_shared(perf_precise_ring_bytes(), timer)
    if (ring >= I64{0}) {
        sync_store(wrapping(ring + I64{1032}), I64{0})
        shallow: perf_precise_cost_at(timer, ring, scratch, I64{0})
        frames: rt_text_word(wrapping(scratch + I64{104}))
        deep: perf_precise_cost_at(timer, ring, scratch, PERF_PRECISE_DEEP)
        more: wrapping(rt_text_word(wrapping(scratch + I64{104})) - frames)
        each: if (more >= PERF_PRECISE_DEEP / I64{2} && deep > shallow) -> wrapping(wrapping(deep - shallow) * I64{1000}) / more else -> I64{0}
        base: wrapping(wrapping(shallow * I64{1000}) - wrapping(each * frames))
        #Unsafe("the main thread's sampler is disabled and no other thread samples yet, so no drain reads the cost") {
            perf_precise_cost_ps = if (base < I64{0}) -> I64{0} else -> base
            perf_precise_frame_ps = each
        }
        alloc_unmap(ring, perf_precise_ring_bytes())
    }
    if (timer >= I64{0}) { _ := host_call(I64{3}, timer, I64{0}, I64{0}) }
    jet_rt_free(scratch, I64{112}, I64{8})
    #Unsafe("ioctl PERF_EVENT_IOC_ENABLE takes no argument") {
        _ := os_syscall_i64(I64{16}, fd, I64{9216}, I64{0}, I64{0}, I64{0}, I64{0})
    }
}

// The task clock's period while its cost is timed (perf_precise_cost): 10
// microseconds, the shortest the kernel's timer takes.
PERF_PRECISE_COST_NS: I64{10000}

// The rounds of each depth's timing, the steps of perf_precise_spin each
// of a round's PERF_PRECISE_CHUNKS takes, and the calls deeper the deep
// timing runs them: few enough samples between chunks that the ring never
// fills, and a deep stack the kernel's walk still reads whole.
PERF_PRECISE_ROUNDS: I64{3}

PERF_PRECISE_CHUNKS: I64{8}

PERF_PRECISE_SPIN: I64{100000}

PERF_PRECISE_DEEP: I64{64}

// The nanoseconds per sample the sampler `timer`, whose ring is `ring`,
// adds to perf_precise_spin's steps run `depth` calls below this one: the
// fastest round with it enabled less the fastest without, over the samples
// of the fastest enabled round, 0 for none. The words of `scratch` at 96
// and 104 hold that round's samples and their callchain entries.
perf_precise_cost_at: fn(timer: I64, ring: I64, scratch: I64, depth: I64) -> I64 {
    off := I64{-1}
    on := I64{-1}
    samples := I64{0}
    entries := I64{0}
    round := I64{0}
    loop round < wrapping(PERF_PRECISE_ROUNDS * I64{2}) {
        enabled: round & I64{1} != I64{0}
        if (enabled) {
            #Unsafe("ioctl PERF_EVENT_IOC_ENABLE takes no argument") {
                _ := os_syscall_i64(I64{16}, timer, I64{9216}, I64{0}, I64{0}, I64{0}, I64{0})
            }
        }
        rt_text_store(wrapping(scratch + I64{96}), I64{0})
        rt_text_store(wrapping(scratch + I64{104}), I64{0})
        began: perf_samples_cpu_clock_ns(I64{1})
        chunk := I64{0}
        seed := round
        loop chunk < PERF_PRECISE_CHUNKS {
            seed = perf_precise_deep(depth, seed)
            perf_precise_ring_count(ring, scratch)
            chunk = wrapping(chunk + I64{1})
        }
        took: wrapping(perf_samples_cpu_clock_ns(I64{1}) - began)
        if (enabled) {
            #Unsafe("ioctl PERF_EVENT_IOC_DISABLE takes no argument") {
                _ := os_syscall_i64(I64{16}, timer, I64{9217}, I64{0}, I64{0}, I64{0}, I64{0})
            }
            perf_precise_ring_count(ring, scratch)
            if (on < I64{0} || took < on) {
                on = took
                samples = rt_text_word(wrapping(scratch + I64{96}))
                entries = rt_text_word(wrapping(scratch + I64{104}))
            }
        } else if (off < I64{0} || took < off) { off = took }
        // The steps' last state, kept where no optimizer drops them.
        rt_text_store(scratch, seed)
        round = wrapping(round + I64{1})
    }
    rt_text_store(wrapping(scratch + I64{96}), samples)
    rt_text_store(wrapping(scratch + I64{104}), if (samples == I64{0}) -> I64{0} else -> entries / samples)
    if (samples == I64{0} || on <= off) -> I64{0} else -> wrapping(on - off) / samples
}

// perf_precise_spin `depth` calls below this one; its last state.
perf_precise_deep: fn(depth: I64, seed: I64) -> I64 {
    if (depth <= I64{0}) { return perf_precise_spin(seed) }
    wrapping(perf_precise_deep(wrapping(depth - I64{1}), seed) + I64{1})
}

// PERF_PRECISE_SPIN steps of a linear congruential generator from `seed`;
// its last state.
perf_precise_spin: fn(seed: I64) -> I64 {
    state := seed
    step := I64{0}
    loop step < PERF_PRECISE_SPIN {
        state = wrapping(wrapping(state * I64{6364136223846793005}) + I64{1442695040888963407})
        step = wrapping(step + I64{1})
    }
    state
}

// Count the samples ring `ring` holds past its tail into the words of
// `scratch` at 96 (samples) and 104 (their callchain entries), and free
// them for the kernel.
perf_precise_ring_count: fn(ring: I64, scratch: I64) {
    data: wrapping(ring + PERF_PRECISE_PAGE)
    mask: wrapping(wrapping(PERF_PRECISE_PAGES * PERF_PRECISE_PAGE) - I64{1})
    filled: sync_load(wrapping(ring + I64{1024}))
    tail := rt_text_word(wrapping(ring + I64{1032}))
    loop tail < filled {
        header: rt_text_word(wrapping(data + (tail & mask)))
        size: (header >> I64{48}) & I64{65535}
        if (size == I64{0}) { break }
        if ((header & I64{4294967295}) == I64{9}) {
            rt_text_store(wrapping(scratch + I64{96}), wrapping(rt_text_word(wrapping(scratch + I64{96})) + I64{1}))
            rt_text_store(wrapping(scratch + I64{104}), wrapping(rt_text_word(wrapping(scratch + I64{104})) + rt_text_word(wrapping(data + (wrapping(tail + I64{24}) & mask)))))
        }
        tail = wrapping(tail + size)
    }
    sync_store(wrapping(ring + I64{1032}), filled)
}

// The ring of the sampler whose sample the SIGPROF `info` reports (a
// siginfo of si_code POLL_IN..POLL_HUP, si_fd at 24 a sampler's
// descriptor): 0 under the timer, whose SIGPROF is its sample; -1 for a
// signal that names no sampler's ring.
perf_precise_ring: fn(info: I64) -> I64 {
    rings: perf_precise_rings
    if (rings == I64{0}) { return I64{0} }
    if (info == I64{0}) { return I64{-1} }
    code: rt_text_word(wrapping(info + I64{8})) & I64{4294967295}
    if (code < I64{1} || code > I64{6}) { return I64{-1} }
    fd: rt_text_word(wrapping(info + I64{24})) & I64{4294967295}
    if (fd >= PERF_PRECISE_FDS) { return I64{-1} }
    ring: sync_load(wrapping(rings + wrapping(fd * I64{8})))
    if (ring == I64{0}) -> I64{-1} else -> ring
}

// Write a timer's sample: `pc`, once for each of its `periods`, the
// `record` words after its first, whose first word, `head` (its word count
// and kind) above a program counter, each write fills in; or, where
// `record` is 0, that first word alone. `side` is the record buffer's side
// (perf_samples_side), 0 for none.
perf_samples_put: fn(fd: I64, side: I64, record: I64, head: I64, pc: I64, periods: I64) {
    written := I64{0}
    loop written < periods {
        perf_samples_put_one(fd, side, record, head, pc)
        written = wrapping(written + I64{1})
    }
}

// Under a perf event the kernel takes each sample into the thread's ring,
// its stack walked there, and the program drains the ring in batches, with
// no signal for each sample: at each turn that changes the task its
// samples are charged to (perf_samples_turn), when the kernel signals that
// half the ring filled (jet_rt_perf_samples_signal), as the thread ends
// (perf_samples_thread_end) and at exit (perf_precise_rings_drain). A drain
// holds the ring's lock (PERF_PRECISE_LOCK), so a handler that finds
// another drain holding it leaves the ring to that drain, which reads on
// until the ring holds nothing past its tail. Each sample
// (PERF_RECORD_SAMPLE, type 9) is written in a record buffer the drain
// claims (perf_samples_ring_sample), charged to the task the TCB `tcb`
// runs (perf_samples_task_of), 0 for none; the samples the kernel found no
// room for (PERF_RECORD_LOST, type 2, its count after its id) count as
// lost records. The rings' tallies (PERF_SAMPLES_RING_COUNT) add the
// drained samples, the kernel's time for them and those the kernel's
// callchain cut. Each tail store frees what the drain read for the kernel.
perf_samples_ring_drain: fn(ring: I64, tcb: I64) {
    fd: perf_samples_fd
    lock: wrapping(ring + PERF_PRECISE_LOCK)
    if (fd < I64{0} || sync_cas(lock, I64{0}, I64{1}) != I64{0}) {
        return
    }
    buffer: perf_samples_buffer
    task: perf_samples_task_of(tcb)
    data: wrapping(ring + PERF_PRECISE_PAGE)
    slot := I64{0}
    samples := I64{0}
    entries := I64{0}
    cut := I64{0}
    tail := rt_text_word(wrapping(ring + I64{1032}))
    filled := sync_load(wrapping(ring + I64{1024}))
    loop tail != filled {
        if (slot == I64{0} && buffer != I64{0}) { slot = perf_samples_claim(buffer) }
        loop tail < filled {
            header: perf_samples_ring_word(data, tail)
            size: (header >> I64{48}) & I64{65535}
            if (size == I64{0}) {
                tail = filled
                break
            }
            kind: header & I64{4294967295}
            if (kind == I64{9}) {
                chain: perf_samples_ring_sample(fd, buffer, slot, data, tail, task)
                samples = wrapping(samples + I64{1})
                entries = wrapping(entries + chain)
                if (wrapping(chain - I64{1}) >= perf_precise_depth) { cut = wrapping(cut + I64{1}) }
            } else if (kind == I64{2}) {
                lost: perf_samples_lost_word()
                if (lost != I64{0}) {
                    _ := sync_add(lost, perf_samples_ring_word(data, wrapping(tail + I64{16})))
                }
            }
            tail = wrapping(tail + size)
        }
        sync_store(wrapping(ring + I64{1032}), tail)
        filled = sync_load(wrapping(ring + I64{1024}))
    }
    if (slot != I64{0}) { sync_store(slot, I64{0}) }
    sync_store(lock, I64{0})
    if (buffer != I64{0} && samples != I64{0}) {
        _ := sync_add(perf_samples_tally(buffer, PERF_SAMPLES_RING_COUNT), samples)
        _ := sync_add(perf_samples_tally(buffer, PERF_SAMPLES_RING_PS), wrapping(wrapping(samples * perf_precise_cost_ps) + wrapping(entries * perf_precise_frame_ps)))
        if (cut != I64{0}) { _ := sync_add(perf_samples_tally(buffer, PERF_SAMPLES_RING_CUT), cut) }
    }
}

// The word of a sampler's ring at `at` past `data`, its samples, which
// wrap at PERF_PRECISE_PAGES; each of a record's words is 8-aligned, so
// none straddles the wrap.
perf_samples_ring_word: fn(data: I64, at: I64) -> I64 {
    rt_text_word(wrapping(data + (at & wrapping(wrapping(PERF_PRECISE_PAGES * PERF_PRECISE_PAGE) - I64{1}))))
}

// The address of tally `index` of the record buffer `buffer`: its words
// past its PERF_SAMPLES_DEPTH + 1 and its counters' slots.
perf_samples_tally: fn(buffer: I64, index: I64) -> I64 {
    wrapping(buffer + wrapping(wrapping(wrapping(wrapping(PERF_SAMPLES_DEPTH + I64{1}) + PERF_COUNTERS_SLOTS) + index) * I64{8}))
}

// Write the sample at `at` of a ring (perf_samples_ring_drain), past
// `data`, as a CPU-time sample's record in the record buffer `slot`
// (perf_samples_claim), charged to task `task`: its instruction pointer
// alone where `slot` is 0. The kernel read the user registers and walked
// the stack as it took the sample. Where the interrupted rip is in the
// image's code, the call frame information (perf_cfi_rules) first steps out
// of each frame whose CFA is rsp-based, a function without a frame pointer
// or one before its prologue sets it, reading the return address and,
// where it was saved, rbp from the sample's copy of the stack
// (perf_samples_ring_stack). At the first frame that keeps rbp, when rbp
// is still the sampled one, the callers are the kernel's frame pointer
// walk from it, past the context marker and the interrupted rip, while the
// call site is in the image's code; when the rules restored another rbp,
// its chain is followed while it stays in the copy. The record ends in the
// sample's time on the process-relative monotonic clock zones are timed on
// and its task (PERF_SAMPLES_TIMED), and is written by the sampled
// instruction pointer, under the callers perf_samples_put_precise finds.
// The callchain's entry count, which the drain tallies.
perf_samples_ring_sample: fn(fd: I64, buffer: I64, slot: I64, data: I64, at: I64, task: I64) -> I64 {
    bias: perf_samples_bias
    precise: wrapping(perf_samples_ring_word(data, wrapping(at + I64{8})) - bias)
    entries: perf_samples_ring_word(data, wrapping(at + I64{24}))
    if (slot == I64{0}) {
        perf_samples_put_one(fd, I64{0}, I64{0}, I64{1} << PERF_SAMPLES_ADDRESS_BITS, precise)
        return entries
    }
    chain: wrapping(at + I64{32})
    regs: wrapping(chain + wrapping(entries * I64{8}))
    abi: perf_samples_ring_word(data, regs)
    pc: if (abi == I64{0}) -> precise else -> wrapping(perf_samples_ring_word(data, wrapping(regs + I64{24})) - bias)
    room: wrapping(PERF_SAMPLES_DEPTH - PERF_SAMPLES_TIMED)
    count := I64{2}
    side: perf_samples_side(slot, buffer)
    rows: if (side == I64{0}) -> I64{0} else -> perf_samples_side_rows(side)
    rules: perf_samples_scratch(slot, buffer)
    if (abi != I64{0} && perf_samples_in_code(pc)) {
        bp: perf_samples_ring_word(data, wrapping(regs + I64{8}))
        stack: perf_samples_ring_word(data, wrapping(regs + I64{16}))
        // The copy's size word, its bytes, then how many of them the
        // kernel copied.
        sized: wrapping(regs + I64{32})
        size: perf_samples_ring_word(data, sized)
        bytes: wrapping(sized + I64{8})
        copied: if (size == I64{0}) -> I64{0} else -> perf_samples_ring_word(data, wrapping(bytes + size))
        frame := bp
        sp := stack
        address := pc
        loop rules != (I64{0}) && count < room {
            row: perf_cfi_rules(rows, rules, address)
            if (row == I64{0}) { break }
            register: rt_text_word(wrapping(row + PERF_CFI_CFA_REG))
            // A frame that keeps rbp: the walks below take it from here.
            if (register == PERF_CFI_RBP) { break }
            cfa: wrapping(sp + rt_text_word(wrapping(row + PERF_CFI_CFA_OFFSET)))
            if (register != PERF_CFI_RSP || rt_text_word(wrapping(row + PERF_CFI_RA_RULE)) != PERF_CFI_SAVED || cfa <= sp || cfa & I64{7} != I64{0}) {
                frame = I64{0}
                break
            }
            rule: rt_text_word(wrapping(row + PERF_CFI_RBP_RULE))
            if {
                (rule == PERF_CFI_SAVED) -> {
                    frame = perf_samples_ring_stack(data, bytes, copied, stack, wrapping(cfa + rt_text_word(wrapping(row + PERF_CFI_RBP_OFFSET))))
                }
                (rule == PERF_CFI_UNKNOWN) -> frame = I64{0}
                else -> {}
            }
            site: wrapping(wrapping(perf_samples_ring_stack(data, bytes, copied, stack, wrapping(cfa + rt_text_word(wrapping(row + PERF_CFI_RA_OFFSET)))) - I64{1}) - bias)
            if (!perf_samples_in_code(site)) {
                frame = I64{0}
                break
            }
            rt_text_store(wrapping(slot + wrapping(wrapping(count + I64{1}) * I64{8})), site)
            count = wrapping(count + I64{1})
            sp = cfa
            address = site
        }
        if (frame == bp && frame >= sp && perf_samples_ring_word(data, chain) == PERF_PRECISE_CONTEXT_USER) {
            index := I64{2}
            loop index < entries && count < room {
                site: wrapping(wrapping(perf_samples_ring_word(data, wrapping(chain + wrapping(index * I64{8}))) - I64{1}) - bias)
                if (!perf_samples_in_code(site)) { break }
                rt_text_store(wrapping(slot + wrapping(wrapping(count + I64{1}) * I64{8})), site)
                count = wrapping(count + I64{1})
                index = wrapping(index + I64{1})
            }
        } else {
            loop frame != (I64{0}) && count < room {
                if (frame < sp || frame & I64{7} != I64{0}) { break }
                site: wrapping(wrapping(perf_samples_ring_stack(data, bytes, copied, stack, wrapping(frame + I64{8})) - I64{1}) - bias)
                if (!perf_samples_in_code(site)) { break }
                rt_text_store(wrapping(slot + wrapping(wrapping(count + I64{1}) * I64{8})), site)
                count = wrapping(count + I64{1})
                caller: perf_samples_ring_stack(data, bytes, copied, stack, frame)
                frame = if (caller > frame) -> caller else -> I64{0}
            }
        }
    }
    // Its time from the process epoch, as the handler times a timer's
    // sample (jet_rt_perf_samples_signal): the kernel took it on the same
    // monotonic clock.
    epoch: time_host_epoch_ns(perf_zone_clock)
    time: perf_samples_ring_word(data, wrapping(at + I64{16}))
    rt_text_store(wrapping(slot + wrapping(wrapping(count + I64{1}) * I64{8})), if (epoch == I64{0}) -> I64{-1} else -> wrapping(time - epoch))
    rt_text_store(wrapping(slot + wrapping(wrapping(count + I64{2}) * I64{8})), task)
    count = wrapping(count + PERF_SAMPLES_TIMED)
    perf_samples_put_precise(fd, side, rules, wrapping(slot + I64{8}), count << PERF_SAMPLES_ADDRESS_BITS, pc, precise)
    entries
}

// The word at `address` of the stack a sample copied: `copied` bytes from
// rsp `stack`, at `bytes` past `data` in its ring; 0 outside them.
perf_samples_ring_stack: fn(data: I64, bytes: I64, copied: I64, stack: I64, address: I64) -> I64 {
    offset: wrapping(address - stack)
    if (offset < I64{0} || offset & I64{7} != I64{0} || wrapping(offset + I64{8}) > copied) {
        return I64{0}
    }
    perf_samples_ring_word(data, wrapping(bytes + offset))
}

// The task a CPU-time sample taken while the TCB `tcb` ran is charged to:
// 0 outside every task's or root's control and for no TCB, else the
// observed task its TLS names (Observe.jet observe_current_task), 1 for
// none.
perf_samples_task_of: fn(tcb: I64) -> I64 {
    if (tcb == I64{0} || sync_load(wrapping(tcb + I64{16})) == I64{0}) { return I64{0} }
    id: perf_flight_task(tcb, false)
    if (id == I64{0}) -> I64{1} else -> id
}

// Drain the ring of the sampler the TCB `tcb` holds (PERF_SAMPLES_TCB_RING)
// before the task it runs changes, so each sample is charged to the task
// that ran as it was taken: as a carrier switches to a fiber and back
// (Fiber.jet fiber_run), and as a task starts and finishes on it (Task.jet
// task_run). Nothing while the ring holds nothing past its tail. Its time
// is the handlers' (perf_samples_charge); a handler that interrupts it
// between the clock's read and its words' only makes it start later.
perf_samples_turn: fn(tcb: I64) {
    ring: sync_load(wrapping(tcb + PERF_SAMPLES_TCB_RING))
    if (ring == I64{0} || sync_load(wrapping(ring + I64{1024})) == rt_text_word(wrapping(ring + I64{1032}))) {
        return
    }
    began: perf_samples_clock()
    perf_samples_ring_drain(ring, tcb)
    perf_samples_charge(perf_samples_buffer, began)
}

// At exit, drain every sampler's ring (perf_samples_ring_drain): this
// thread's charged to its task, every other thread's to none, 0, since
// another thread's task is not read while it runs. The exit word, set
// first, keeps the ring of a thread that ends meanwhile mapped
// (perf_precise_end).
perf_precise_rings_drain: fn() {
    rings: perf_precise_rings
    if (rings == I64{0}) {
        return
    }
    _ := sync_cas(wrapping(rings + PERF_PRECISE_EXITING), I64{0}, I64{1})
    began: perf_samples_clock()
    tcb: thread_base()
    own: sync_load(wrapping(tcb + PERF_SAMPLES_TCB_RING))
    if (own != I64{0}) { perf_samples_ring_drain(own, tcb) }
    index := I64{0}
    loop index < PERF_PRECISE_FDS {
        ring: sync_load(wrapping(rings + wrapping(index * I64{8})))
        if (ring != I64{0} && ring != own) { perf_samples_ring_drain(ring, I64{0}) }
        index = wrapping(index + I64{1})
    }
    perf_samples_charge(perf_samples_buffer, began)
}

// One write of a precise sample's record (perf_samples_ring_sample) at
// program counter `precise`. The drain walked the stack the kernel read at
// the sampler's interrupt: `record`'s word 1 is left for the interrupted
// program counter `pc`, and the words after it, to `head`'s count, are its
// callers. A precise source's interrupt comes some instructions past the
// sampled one (its skid), so the interrupted code can be another
// function's: the sampled function's caller, once it returned, or its
// callee, once it called one. So the callers are those of the innermost
// walked frame in the sampled function (its call frame information's
// range); when none is, the sampled function returned before the interrupt
// came, and the interrupted frame is its caller. A sample outside every
// range keeps the interrupted frame's callers. A CPU-time sample's record
// (kind 0) ends in PERF_SAMPLES_TIMED words, which are no callers.
perf_samples_put_precise: fn(fd: I64, side: I64, scratch: I64, record: I64, head: I64, pc: I64, precise: I64) {
    if (record == I64{0}) {
        perf_samples_put_one(fd, side, I64{0}, head, precise)
        return
    }
    trailer: if ((head >> PERF_SAMPLES_KIND_BITS) == I64{0}) -> PERF_SAMPLES_TIMED else -> I64{0}
    count: wrapping(((head >> PERF_SAMPLES_ADDRESS_BITS) & I64{2047}) - trailer)
    rt_text_store(wrapping(record + I64{8}), pc)
    // The sampled function's range: its rule row's when the side caches
    // them, else its entry's; an empty one outside every function.
    begin := I64{0}
    end := I64{0}
    if (side != I64{0} && scratch != I64{0}) {
        row: perf_cfi_cached(perf_samples_side_rows(side), scratch, precise)
        begin = rt_text_word(wrapping(row + I64{8}))
        end = rt_text_word(wrapping(row + I64{16}))
    } else {
        entry: perf_cfi_find(precise)
        if (entry != I64{0}) {
            begin = rt_text_word(entry)
            end = rt_text_word(wrapping(entry + I64{8}))
        }
    }
    at := I64{1}
    if (begin < end) {
        loop at < count {
            frame: rt_text_word(wrapping(record + wrapping(at * I64{8})))
            if (frame >= begin && frame < end) { break }
            at = wrapping(at + I64{1})
        }
        if (at == count) { at = I64{0} }
    }
    // The record from the frame in the sampled function on, its program
    // counter the sampled one: that word is put back after the write, for
    // the ring's next sample.
    from: wrapping(record + wrapping(at * I64{8}))
    kept: rt_text_word(from)
    perf_samples_put_one(fd, side, from, wrapping(head - (at << PERF_SAMPLES_ADDRESS_BITS)), precise)
    rt_text_store(from, kept)
}

// One sample's record (perf_samples_put) at program counter `pc`: kept in
// `side` while records are buffered (perf_samples_keep), else written, and
// counted lost when the write fails (perf_samples_send).
perf_samples_put_one: fn(fd: I64, side: I64, record: I64, head: I64, pc: I64) {
    word: (pc & PERF_SAMPLES_ADDRESS_MASK) | head
    if (record == I64{0}) {
        written := I64{0}
        #Unsafe("one write of a stack-local word, which the kernel copies before the call returns") {
            written = os_write_word_i64(fd, word, I64{8})
        }
        if (written != I64{8}) { perf_samples_lost_add() }
        return
    }
    rt_text_store(record, word)
    bytes: wrapping(((head >> PERF_SAMPLES_ADDRESS_BITS) & I64{2047}) * I64{8})
    if (side != I64{0} && perf_samples_buffered != I64{0}) {
        perf_samples_keep(fd, side, record, bytes)
        return
    }
    perf_samples_send(fd, record, bytes)
}

// Write the `bytes` of the record at `record` to the samples file `fd`, or
// count the record lost when the write fails: under the flight recorder
// `fd` is the record socket, whose datagrams are sent whole or, while it
// is full, not at all (perf_flight_open), and a record it refuses is gone.
perf_samples_send: fn(fd: I64, record: I64, bytes: I64) {
    if (host_write_all(fd, record, bytes) != I64{0}) { perf_samples_lost_add() }
}

// The record buffer's count of records the program made and could not
// write (perf_samples_send); 0 when the start could not map the buffer.
perf_samples_lost_word: fn() -> I64 {
    buffer: perf_samples_buffer
    if (buffer == I64{0}) -> I64{0} else -> wrapping(buffer + wrapping(wrapping(wrapping(PERF_SAMPLES_DEPTH + I64{3}) + PERF_COUNTERS_SLOTS) * I64{8}))
}

perf_samples_lost_add: fn() {
    word: perf_samples_lost_word()
    if (word != I64{0}) { _ := sync_add(word, I64{1}) }
}

// How many records the program made and could not write so far.
perf_samples_lost: fn() -> I64 {
    word: perf_samples_lost_word()
    if (word == I64{0}) -> I64{0} else -> sync_load(word)
}

// Appends the `bytes` of the record at `record` to the records `side`
// holds, writing those out first when the record would not fit.
perf_samples_keep: fn(fd: I64, side: I64, record: I64, bytes: I64) {
    used := rt_text_word(side)
    if (wrapping(used + bytes) > PERF_SAMPLES_OUT_BYTES) {
        _ := host_write_all(fd, wrapping(side + I64{8}), used)
        used = I64{0}
    }
    out: wrapping(wrapping(side + I64{8}) + used)
    at := I64{0}
    loop at < bytes {
        rt_text_store(wrapping(out + at), rt_text_word(wrapping(record + at)))
        at = wrapping(at + I64{8})
    }
    rt_text_store(side, wrapping(used + bytes))
}

// The bytes of one record buffer's side (perf_samples_sides): its used
// count, its records, its rule rows.
perf_samples_side_bytes: fn() -> I64 {
    wrapping(wrapping(I64{8} + PERF_SAMPLES_OUT_BYTES) + wrapping(PERF_CFI_CACHE_ROWS * PERF_CFI_CACHE_ROW_BYTES))
}

// The side of record buffer `slot` (perf_samples_claim) of the handler
// holding it, 0 when the start could not map the sides.
perf_samples_side: fn(slot: I64, buffer: I64) -> I64 {
    sides: perf_samples_sides
    if (sides == I64{0}) { return I64{0} }
    index: if (slot == buffer) -> I64{0} else -> wrapping(wrapping(wrapping(slot - perf_samples_slots) / perf_samples_slot_bytes()) + I64{1})
    wrapping(sides + wrapping(index * perf_samples_side_bytes()))
}

// The rule rows of side `side` (perf_cfi_cached).
perf_samples_side_rows: fn(side: I64) -> I64 {
    wrapping(wrapping(side + I64{8}) + PERF_SAMPLES_OUT_BYTES)
}

// At the exit, before the clock record, and as a flight recorder's zones
// window closes (perf_flight_window_close), to the window file: writes the
// records every side holds, each record buffer held as its handler holds
// it, so that none fills meanwhile; a handler that holds one finishes
// first. Records are written as they are made from then on: a handler
// reads perf_samples_buffered once it holds its buffer, after this clears
// it.
perf_samples_flush: fn(fd: I64) {
    sides: perf_samples_sides
    if (sides == I64{0} || perf_samples_buffered == I64{0}) {
        return
    }
    #Unsafe("the exit and a window's close, under the flight recorder's lock, alone clear it; a handler reads it only while it holds its buffer, which the claims below order") {
        perf_samples_buffered = I64{0}
    }
    buffer: perf_samples_buffer
    slots: perf_samples_slots
    index := I64{0}
    loop index <= PERF_SAMPLES_SLOTS {
        busy: if (index == I64{0}) -> buffer else if (slots == I64{0}) -> I64{0} else -> wrapping(slots + wrapping(wrapping(index - I64{1}) * perf_samples_slot_bytes()))
        if (busy != I64{0}) {
            // sched_yield while a handler holds it.
            loop sync_cas(busy, I64{0}, I64{1}) != (I64{0}) {
                _ := host_call(I64{24}, I64{0}, I64{0}, I64{0})
            }
            side: wrapping(sides + wrapping(index * perf_samples_side_bytes()))
            used: rt_text_word(side)
            if (used > I64{0}) {
                _ := host_write_all(fd, wrapping(side + I64{8}), used)
                rt_text_store(side, I64{0})
            }
            sync_store(busy, I64{0})
        }
        index = wrapping(index + I64{1})
    }
}

// The process's CPU time (CLOCK_PROCESS_CPUTIME_ID) in nanoseconds, 0 when
// it cannot be read.
perf_samples_process_cpu_ns: fn() -> I64 { perf_samples_cpu_clock_ns(I64{2}) }

// The CPU-time clock `clock` (CLOCK_PROCESS_CPUTIME_ID 2 or
// CLOCK_THREAD_CPUTIME_ID 3) in nanoseconds, 0 when it cannot be read. Its
// scratch is the observation's own block (Alloc.jet alloc_check_own_enter):
// a heap snapshot leaves it out, and the alloc lens does not count it.
perf_samples_cpu_clock_ns: fn(clock: I64) -> I64 {
    alloc_check_own_enter()
    scratch: jet_rt_alloc(I64{16}, I64{8})
    alloc_check_own_leave()
    status := I64{-1}
    #Unsafe("clock_gettime writes the two timespec words of the scratch") {
        status = os_syscall_i64(I64{228}, clock, scratch, I64{0}, I64{0}, I64{0}, I64{0})
    }
    ns: if (status == I64{0}) -> wrapping(wrapping(rt_text_word(scratch) * I64{1000000000}) + rt_text_word(wrapping(scratch + I64{8}))) else -> I64{0}
    jet_rt_free(scratch, I64{16}, I64{8})
    ns
}

// At exit (Observe.jet jet_rt_observe_exit), under `jet perf run`: the
// record of what sampling cost, so that the session can say how many of the
// samples the CPU time should give it kept and what the sampler took of
// that time. Its words after the first: the CPU time the process used since
// sampling started, the time every handler and drain ran
// (perf_samples_charge), the kernel's time for one signal
// (perf_samples_delivery), each in nanoseconds, then the allocations the
// alloc lens counted and the nanoseconds it spent on them
// (perf_samples_alloc_write), then the records the program made and could
// not write (perf_samples_lost), then the samples the drains took from the
// kernel's rings, the kernel's nanoseconds for them as the start timed it
// (perf_precise_cost), and those whose callchain the kernel cut at
// perf_precise_depth entries (PERF_SAMPLES_RING_COUNT), all 0 under the
// timer. A second exit writes a later one. Under the alloc lens the heap
// snapshot named `exit` comes first (perf_samples_heap), then the
// allocations' records. An attach's zones window still open closes first
// (perf_flight_window_end), so the clock record goes to the record socket.
// Every ring's samples are drained first (perf_precise_rings_drain), then
// the spans buffer's rows and the records the handlers keep
// (perf_samples_flush) are written out, then the causal lens's idle table
// (perf_causal_idle_write) and tasks' timings (perf_causal_rows_write), and
// the threads and host calls (perf_system_exit).
perf_samples_exit: fn() {
    perf_flight_window_end()
    perf_spans_flush()
    fd: perf_samples_fd
    if (fd < I64{0}) {
        return
    }
    perf_precise_rings_drain()
    perf_samples_flush(fd)
    perf_causal_idle_write(fd)
    perf_causal_rows_write(fd)
    perf_system_exit()
    perf_samples_heap(rt_static_text("exit"))
    buffer: perf_samples_buffer
    record: jet_rt_alloc(I64{80}, I64{8})
    thread_zero(record, I64{80})
    perf_samples_alloc_write(fd, wrapping(record + I64{32}))
    rt_text_store(record, (I64{10} << PERF_SAMPLES_ADDRESS_BITS) | (PERF_SAMPLES_CLOCK << PERF_SAMPLES_KIND_BITS))
    rt_text_store(wrapping(record + I64{8}), wrapping(perf_samples_process_cpu_ns() - perf_samples_cpu_start))
    rt_text_store(wrapping(record + I64{24}), perf_samples_delivery_ns)
    rt_text_store(wrapping(record + I64{48}), perf_samples_lost())
    if (buffer != I64{0}) {
        rt_text_store(wrapping(record + I64{16}), sync_load(perf_samples_tally(buffer, I64{0})))
        rt_text_store(wrapping(record + I64{56}), sync_load(perf_samples_tally(buffer, PERF_SAMPLES_RING_COUNT)))
        rt_text_store(wrapping(record + I64{64}), sync_load(perf_samples_tally(buffer, PERF_SAMPLES_RING_PS)) / I64{1000})
        rt_text_store(wrapping(record + I64{72}), sync_load(perf_samples_tally(buffer, PERF_SAMPLES_RING_CUT)))
    }
    perf_samples_send(fd, record, I64{80})
    jet_rt_free(record, I64{80}, I64{8})
    perf_topdown_exit()
}

// core.perf.heap_mark(name): the heap snapshot named by the borrowed text
// `name` under `jet perf run --lens=alloc`, nothing otherwise.
#Export(c) jet_perf_heap_mark: fn(name: I64) { perf_samples_heap(name) }

// What a row of the spans file (perf_spans_fd) is, in the high half of its
// length word (perf_zone_row): a closed core.log span, a closed
// core.perf.zone, a frame mark, a plotted value, zones that could not
// turn on, the row's name saying why (perf_zones_refused), the file's
// last row, written when it reached its bound (perf_spans_write), or an
// attach's zones window, its name five words (perf_flight_window_close).
PERF_ZONE_LOG: I64{0}

PERF_ZONE_ZONE: I64{1}

PERF_ZONE_FRAME: I64{2}

PERF_ZONE_PLOT: I64{3}

PERF_ZONE_REFUSED: I64{4}

PERF_ZONE_CUT: I64{5}

PERF_ZONE_WINDOW: I64{6}

// The first zone-site table registered (jet_perf_zone_table), 0 until one
// is: a library's, so registering it while zones are off is one store.
// Further tables (an image with more than one library) go on
// perf_zone_tables. A program's own sites register nothing: its image names
// them in a part note (perf_zone_image_table).
perf_zone_table_first := I64{0}

// The page of further zone-site tables, 0 until the second registers: the
// count, then each table's address, PERF_ZONE_TABLES_ROOM at most.
perf_zone_tables := I64{0}

PERF_ZONE_TABLES_BYTES: I64{4096}

PERF_ZONE_TABLES_ROOM: I64{500}

// The lock word every patch of the sites holds (perf_zone_tables_turn),
// 0 until the first turn of zones (perf_zones_set) allocates it, before it
// stores the zones word.
perf_zone_lock := I64{0}

// The time root (HostTime.jet time_host_root) and the task key (Observe.jet
// observe_task_key) the zone routes read, copied by perf_zone_roots_take
// before zones first turn on. A zone route reads them only once it has
// read the zones word on, so the routes keep neither init hook in an image
// that no profiler observes; an observed image keeps both through the
// code that turns zones on.
perf_zone_clock := I64{0}

perf_zone_task_key := I64{0}

// The zones' clock, fixed as zones first turn on (perf_zone_calibrate): 1
// when a zone's edges read the processor's time-stamp counter, which the
// drain of the zone rings (perf_zone_rings_drain) converts to the
// timeline's nanoseconds; 0 when they read the timeline itself
// (perf_zone_now). The counter's pair at the calibration: its count and the
// timeline's nanoseconds, read between two counts.
perf_zone_tsc := I64{0}

perf_zone_tsc_base := I64{0}

perf_zone_ns_base := I64{0}

// How long after the calibration's pair the conversion's second pair is
// read (perf_zone_scale): 1 ms, so the clock reads' own jitter moves the
// scale by a few parts in a hundred thousand at most, and less as the run
// goes on.
PERF_ZONE_CALIBRATION_NS: I64{1000000}

// The word heading the zone rings (perf_zone_ring), 0 until zones first
// turn on. A ring is one thread's: its head (bytes written, which its
// thread alone stores)@0, the next ring@8, its tail (bytes drained, which
// only a drainer stores, under the spans buffer's lock)@64, then
// PERF_ZONE_RING_BYTES of records from PERF_ZONE_RING_AT. A record: the
// zone's start and end on the zones' clock, its task, the name's byte
// length with its kind from bit 32, then the name, padded to a word. A
// record that would cross the ring's end starts it over, behind a skip
// record when 32 bytes are left and none when fewer are.
perf_zone_rings := I64{0}

PERF_ZONE_RING_TAIL: I64{64}

PERF_ZONE_RING_AT: I64{128}

PERF_ZONE_RING_BYTES: I64{65536}

PERF_ZONE_RING_MASK: I64{65535}

PERF_ZONE_RING_SKIP: I64{15}

// A record past this goes to the spans buffer itself (perf_zone_row).
PERF_ZONE_RING_RECORD_MOST: I64{4096}

// The TCB word (Thread.jet's layout) of the thread's zone ring, which a
// fiber borrows from the carrier it runs on (perf_rings_lend).
PERF_ZONE_TCB_RING: I64{760}

// A site's opcode byte: `test eax, imm32`, whose flags nothing reads,
// falls through while zones are off; `jmp rel32`, over the same four bytes,
// enters the site's stub while they are on, which makes the call and jumps
// back (JetIR X64Select.jet ir_x64_zone_stub). One byte changes, so a
// thread running the site meets one whole instruction or the other.
PERF_ZONE_SITE_OFF: I64{169}

PERF_ZONE_SITE_ON: I64{233}

// Registers the zone-site table at `table` (JetBackend Image/Object.jet
// x64_object_zone_sites): its site count, then per site a rel32 to its
// function and the site's offset there. A library's constructor registers
// its own at load; the sites turn on at once when zones already are.
// Registrations never overlap: constructors run one at a time. A turn of
// zones may run meanwhile (perf_zones_set): the fence orders the table's
// store before the zones word's read, as the turn orders the word's store
// before the tables' read, so a turn and a registration racing see each
// other at least once.
#Export(c) jet_perf_zone_table: fn(table: I64) {
    if (perf_zone_table_first == I64{0}) {
        #Unsafe("registrations never overlap (see above)") { perf_zone_table_first = table }
    } else if (!perf_zone_tables_add(table)) {
        perf_zone_turn(I64{0})
        return
    }
    // The swap of thread-owned TCB scratch is a full fence.
    _ := sync_swap(wrapping(thread_base() + I64{232}), I64{0})
    perf_zone_turn(I64{1})
}

// The code of jet_rt_perf_zone_turn, 0 until the first turn of zones
// (perf_zones_set) stores it, before it stores the zones word. A
// registration reaches the sites' patches only through it, so an image
// that no profiler observes links neither the patches nor what they need.
perf_zone_turn_code := I64{0}

// Checked FunctionAddress intrinsic in the canonical RuntimeLibrary table.
rt_perf_zone_turn_address: fn() -> I64 {
    loop { jet_rt_unreachable(I64{0}, I64{0}) }
}

// A registration's part while zones are on (jet_perf_zone_table): the
// sites' turn (`added` 1), or the refusal when the table could not be
// added (0). The zones word is read before the code word, which turned
// zones store in the other order.
perf_zone_turn: fn(added: I64) {
    if (perf_zones_on != I64{0}) { _ := coll_call1(perf_zone_turn_code, added) }
}

#Export(c) jet_rt_perf_zone_turn: fn(added: I64) -> I64 {
    if (added == I64{0}) { perf_zones_refused() } else { perf_zone_tables_turn() }
    I64{0}
}

// Adds `table` to perf_zone_tables, its page mapped at the first; false
// when the page cannot be mapped or is full. The count is stored after the
// address, so a turn reading them meanwhile reads only whole entries.
perf_zone_tables_add: fn(table: I64) -> Bool {
    tables := perf_zone_tables
    if (tables == I64{0}) {
        tables = alloc_map_try(PERF_ZONE_TABLES_BYTES)
        if (tables == I64{0}) { return false }
        #Unsafe("registrations never overlap, and a turn reads the page only once it is stored") {
            perf_zone_tables = tables
        }
    }
    count: sync_load(tables)
    if (count >= PERF_ZONE_TABLES_ROOM) { return false }
    sync_store(wrapping(wrapping(tables + I64{8}) + count * I64{8}), table)
    sync_store(tables, wrapping(count + I64{1}))
    true
}

// Copies the time root and the task key the zone routes read
// (perf_zone_clock, perf_zone_task_key). The observation start and its
// writer call it before they store the zones word or the spans file.
perf_zone_roots_take: fn() {
    #Unsafe("the observation start, before the entry, and then its writer store the same roots") {
        perf_zone_clock = time_host_root
        perf_zone_task_key = observe_task_key
    }
}

// Turns zones on (`on` nonzero) or off: the zones word, then every site of
// the image's part note and of each registered table
// (perf_zone_tables_turn). The observation start, before the entry, and
// then the writer it starts turn zones, one at a time, so the first turn
// allocates the patches' lock and the rings' head and fixes the zones'
// clock (perf_zone_calibrate) alone. The fence orders the word's store
// before the tables' read (see jet_perf_zone_table).
perf_zones_set: fn(on: I64) {
    perf_zone_roots_take()
    if (perf_zone_lock == I64{0}) {
        #Unsafe("turns run one at a time (see above), and a registration reads the code only after the zones word") {
            perf_zone_turn_code = rt_perf_zone_turn_address()
        }
        perf_zone_calibrate()
        rings: jet_rt_alloc(I64{8}, I64{8})
        sync_store(rings, I64{0})
        lock: jet_rt_alloc(I64{8}, I64{8})
        sync_store(lock, I64{0})
        #Unsafe("turns run one at a time (see above), and a zone route reads the rings' head and a registration the lock only after the zones word") {
            perf_zone_rings = rings
            perf_zone_lock = lock
        }
    }
    #Unsafe("turns run one at a time; the lock orders their patches with a registration's") {
        perf_zones_on = on
    }
    _ := sync_swap(wrapping(thread_base() + I64{232}), I64{0})
    perf_zone_tables_turn()
}

// Patches every site of the image's part note (perf_zone_image_table) and
// of each registered table to the zones word as it stands under the
// patches' lock: of a turn and a registration racing, the later word wins.
// Where the system refuses to rewrite code, zones on says so
// (perf_zones_refused).
perf_zone_tables_turn: fn() {
    lock: perf_zone_lock
    sync_thread_lock(lock)
    now_on: perf_zones_on != I64{0}
    want: if (now_on) -> PERF_ZONE_SITE_ON else -> PERF_ZONE_SITE_OFF
    patched := true
    image: perf_zone_image_table()
    if (image != I64{0}) { patched = perf_zone_table_patch(image, want) }
    first: perf_zone_table_first
    if (first != I64{0} && patched) { patched = perf_zone_table_patch(first, want) }
    tables: perf_zone_tables
    count: if (tables == I64{0}) -> I64{0} else -> sync_load(tables)
    index := I64{0}
    loop index < count && patched {
        patched = perf_zone_table_patch(sync_load(wrapping(wrapping(tables + I64{8}) + index * I64{8})), want)
        index += I64{1}
    }
    sync_thread_unlock(lock)
    if (!patched && now_on) { perf_zones_refused() }
}

// The zone-site table of the image's own code, which its link names in a
// part note (JetBackend Image/StaticLink.jet link_zone_write) in the form a
// registered table takes; 0 when the image has none, or when the note is
// too short for the count it states.
perf_zone_image_table: fn() -> I64 {
    name: rt_static_text("jet.zone_sites")
    note: host_image_part(name)
    if (note == I64{0}) { return I64{0} }
    table: wrapping(wrapping(note + I64{16}) + host_image_part_label(name))
    size: host_image_part_length(note, name)
    if (size < I64{8} || rt_text_word(table) > (size - I64{8}) >> I64{3}) { return I64{0} }
    table
}

// Writes opcode byte `want` into every site of the zone-site table at
// `table` whose byte differs, the patches' lock held: through a writable
// mapping of the site's page (mprotect, back to read and execute after),
// or where the system refuses that, through /proc/self/mem. False when
// both are refused.
perf_zone_table_patch: fn(table: I64, want: I64) -> Bool {
    page := I64{0}
    mem := I64{-1}
    refused := false
    sites: rt_text_word(table)
    at := I64{0}
    loop at < sites && !refused {
        field: wrapping(wrapping(table + I64{8}) + at * I64{8})
        entry: rt_text_word(field)
        rel: wrapping(((entry & I64{4294967295}) ~ I64{2147483648}) - I64{2147483648})
        site: wrapping(wrapping(wrapping(field + I64{4}) + rel) + ((entry >> I64{32}) & I64{4294967295}))
        if (rt_text_byte(site) != want) {
            if (mem < I64{0}) {
                target: site & I64{-4096}
                if (target != page) {
                    if (page != I64{0}) { _ := perf_zone_protect(page, I64{5}) }
                    page = I64{0}
                    if (perf_zone_protect(target, I64{7})) { page = target } else {
                        mem = perf_zone_mem_open()
                        refused = mem < I64{0}
                    }
                }
            }
            if (!refused && mem < I64{0}) { rt_text_put(site, want) }
            if (!refused && mem >= I64{0}) { refused = !perf_zone_mem_put(mem, site, want) }
        }
        at += I64{1}
    }
    if (page != I64{0}) { _ := perf_zone_protect(page, I64{5}) }
    if (mem >= I64{0}) { _ := observe_syscall(I64{3}, mem, I64{0}, I64{0}, I64{0}) }
    !refused
}

// mprotect of the code page at `page` to `protection` (7: read, write and
// execute; 5: read and execute); false when refused.
perf_zone_protect: fn(page: I64, protection: I64) -> Bool {
    observe_syscall(I64{10}, page, I64{4096}, protection, I64{0}) == I64{0}
}

// /proc/self/mem opened for writing, or a negative errno.
perf_zone_mem_open: fn() -> I64 {
    path: rt_static_text("/proc/self/mem")
    name: observe_cstring(path)
    // openat(AT_FDCWD, name, O_RDWR|O_CLOEXEC)
    fd: observe_syscall(I64{257}, I64{-100}, name, I64{524290}, I64{0})
    jet_rt_free(name, wrapping(rt_text_len(path) + I64{1}), I64{1})
    fd
}

// Writes byte `value` at `address` through /proc/self/mem (`mem`), which
// writes a read-only code page too; false when refused.
perf_zone_mem_put: fn(mem: I64, address: I64, value: I64) -> Bool {
    scratch: wrapping(thread_base() + I64{232})
    rt_text_put(scratch, value)
    #Unsafe("pwrite64 copies one byte from the thread-owned TCB scratch and retains no pointer") {
        return os_syscall_i64(I64{18}, mem, scratch, I64{1}, address, I64{0}, I64{0}) == I64{1}
    }
}

// Zones were asked for but their sites stay skipped: the system refuses to
// rewrite the program's code. Says so on stderr and as a PERF_ZONE_REFUSED
// row, which `jet perf` reports, so an empty timeline is never left
// unexplained.
perf_zones_refused: fn() {
    reason: rt_static_text("the system refuses to rewrite the program's code (mprotect and /proc/self/mem), so zone sites stay skipped")
    said: rt_static_text("jet perf: zones off: ")
    _ := host_write_all(I64{2}, rt_text_data(said), rt_text_len(said))
    _ := host_write_all(I64{2}, rt_text_data(reason), rt_text_len(reason))
    newline: rt_static_text("\n")
    _ := host_write_all(I64{2}, rt_text_data(newline), rt_text_len(newline))
    now: perf_zone_now()
    perf_zone_row(PERF_ZONE_REFUSED, now, now, reason)
}

// core.perf.zone(name): the zone's start on the zones' clock while zones
// are on (under `jet perf run`, or while `jet perf attach` holds them on),
// 0 otherwise: the time-stamp counter, or the timeline where the counter
// does not serve (perf_zone_calibrate). A native zone site calls it only
// while zones are on, so a zone no profiler records costs its site's skip.
#Export(c) jet_perf_zone_open: fn() -> I64 {
    jet_int_owned_from_i64(if (perf_zones_on == I64{0}) -> I64{0} else -> perf_zone_edge())
}

// Now on the zones' clock (perf_zone_tsc): one read of the time-stamp
// counter, or of the timeline (perf_zone_now). Inlined into the zone's open
// and close on every tier, as is perf_zone_ticks, so an edge is the
// counter's instructions in the export's own body: x86-64 selection writes
// a call of the `#FFI(asm)` leaf as its template in place (X64Select.jet
// ir_x64_asm_inline), and the template keeps r8 and r9.
#Inline(Always) perf_zone_edge: fn() -> I64 {
    if (perf_zone_tsc == I64{0}) { return perf_zone_now() }
    perf_zone_ticks()
}

#Inline(Always) perf_zone_ticks: fn() -> I64 {
    #Unsafe("rdtsc only reads the time-stamp counter, which the zones' calibration found invariant and enabled for this process") {
        return os_rdtsc_i64()
    }
}

// Fixes the zones' clock as zones first turn on: the time-stamp counter
// where it is invariant (CPUID.80000007H:EDX bit 8: one rate on every core
// through every power state) and this process may read it (prctl
// PR_GET_TSC), with its calibration pair; the timeline otherwise, as in a
// guest whose host hides the bit.
perf_zone_calibrate: fn() {
    if (!perf_zone_tsc_usable()) {
        return
    }
    before: perf_zone_ticks()
    now: perf_zone_now()
    after: perf_zone_ticks()
    #Unsafe("the first turn of zones runs alone, before it stores the zones word that every zone route reads first") {
        perf_zone_tsc_base = wrapping(before + wrapping(after - before) / I64{2})
        perf_zone_ns_base = now
        perf_zone_tsc = I64{1}
    }
}

perf_zone_tsc_usable: fn() -> Bool {
    #Unsafe("cpuid only reports processor identification") {
        if (os_cpuid_eax_i64(I64{2147483648}, I64{0}) < I64{2147483655}) { return false }
        if ((os_cpuid_edx_i64(I64{2147483655}, I64{0}) & I64{256}) == I64{0}) { return false }
    }
    // prctl(PR_GET_TSC, &state) into the TCB's scratch word: rdtsc faults
    // unless the state is PR_TSC_ENABLE (1).
    scratch: wrapping(thread_base() + I64{232})
    rt_text_store(scratch, I64{0})
    if (observe_syscall(I64{157}, I64{25}, scratch, I64{0}, I64{0}) != I64{0}) { return false }
    rt_text_word(scratch) == I64{1}
}

// The scale from the zones' clock to the timeline's nanoseconds, in
// nanoseconds per count with 30 fraction bits: the calibration's pair
// against one read now, at least PERF_ZONE_CALIBRATION_NS after it (a
// conversion that soon after the calibration waits out the rest). 0 when
// the zones' clock is the timeline.
perf_zone_scale: fn() -> I64 {
    if (perf_zone_tsc == I64{0}) { return I64{0} }
    ticks := I64{0}
    elapsed := I64{0}
    loop {
        before: perf_zone_ticks()
        now: perf_zone_now()
        after: perf_zone_ticks()
        ticks = wrapping(wrapping(before + wrapping(after - before) / I64{2}) - perf_zone_tsc_base)
        elapsed = wrapping(now - perf_zone_ns_base)
        if (elapsed >= PERF_ZONE_CALIBRATION_NS) { break }
        #Unsafe("x86 pause only hints that this thread is waiting in a spin loop") {
            os_spin_pause()
        }
    }
    if (ticks <= I64{0}) { return I64{0} }
    // elapsed / ticks to 30 fraction bits by long division: no product
    // leaves 64 bits however long the run.
    scale := elapsed / ticks
    rest := wrapping(elapsed - wrapping(scale * ticks))
    bit := I64{0}
    loop bit < (I64{30}) {
        rest = rest << I64{1}
        scale = scale << I64{1}
        if (rest >= ticks) {
            rest = wrapping(rest - ticks)
            scale = wrapping(scale + I64{1})
        }
        bit = wrapping(bit + I64{1})
    }
    scale
}

// The timeline's nanoseconds of `edge` on the zones' clock, by `scale`
// (perf_zone_scale), saturated at 0 as the timeline is.
perf_zone_ns: fn(edge: I64, scale: I64) -> I64 {
    if (perf_zone_tsc == I64{0}) { return edge }
    since: wrapping(edge - perf_zone_tsc_base)
    span: if (since < I64{0}) -> wrapping(I64{0} - since) else -> since
    // span * scale >> 30 in two halves: the high word's product shifted up,
    // the low word's down.
    high: wrapping(wrapping((span >> I64{32}) * scale) * I64{4})
    low: wrapping((span & I64{4294967295}) * scale) >> I64{30}
    scaled: wrapping(high + low)
    now: if (since < I64{0}) -> wrapping(perf_zone_ns_base - scaled) else -> wrapping(perf_zone_ns_base + scaled)
    if (now < I64{0}) -> I64{0} else -> now
}

// Now on the monotonic clock of the run's timeline (HostTime.jet
// time_host_monotonic_i64), through the time root zones copied as they
// turned on (perf_zone_clock): only a route that has read the zones word
// on calls it. Once the root's epoch is set, one clock read less that
// epoch, saturated at 0 as the timeline saturates a backwards clock: the
// root's words are only loaded, so a zone pays no once's atomic exchange;
// before it, the timeline's own first read sets it.
perf_zone_now: fn() -> I64 {
    epoch: time_host_epoch_ns(perf_zone_clock)
    if (epoch == I64{0}) { return time_host_monotonic_i64_at(perf_zone_clock) }
    now: wrapping(sync_now_ns() - epoch)
    if (now < I64{0}) -> I64{0} else -> now
}

// The observed task this thread runs (Observe.jet observe_current_task),
// through the task key zones copied as they turned on
// (perf_zone_task_key): 1 outside every task.
perf_zone_task: fn() -> I64 {
    current: jet_rt_tls_get(perf_zone_task_key)
    if (current == I64{0}) -> I64{1} else -> current
}

// The close of the zone named by the borrowed text `name` that opened at
// `start` (jet_perf_zone_open): its record, from `start` to now, in this
// thread's zone ring (perf_zone_ring_put). A close publishes no stop, so its
// call is no stop point, and a zone that closes on a stop edge still
// records.
#Export(c) jet_perf_zone_close: fn(name: I64, start: I64) {
    began: host_native_int(start)
    if (began == I64{0} || perf_zones_on == I64{0}) {
        return
    }
    perf_zone_ring_put(began, perf_zone_edge(), name)
    // A closed zone is a progress point of the causal lens.
    perf_causal_progress(name)
}

// The zone's record in this thread's ring: plain stores, then one store of
// the head, which publishes it to the drain (perf_zone_rings_drain); no
// lock. A ring with no room for it is drained first, under the spans
// buffer's lock (perf_zone_ring_spill). A thread without a ring, or a name
// too long for one, writes its row to the spans buffer itself.
perf_zone_ring_put: fn(start: I64, end: I64, name: I64) {
    length: rt_text_len(name)
    size: wrapping(I64{32} + (wrapping(length + I64{7}) & I64{-8}))
    ring: perf_zone_ring()
    if (ring == I64{0} || size > PERF_ZONE_RING_RECORD_MOST) {
        scale: perf_zone_scale()
        perf_zone_row(PERF_ZONE_ZONE, perf_zone_ns(start, scale), perf_zone_ns(end, scale), name)
        return
    }
    head := sync_load(ring)
    room: wrapping(PERF_ZONE_RING_BYTES - (head & PERF_ZONE_RING_MASK))
    taken: if (room < size) -> wrapping(room + size) else -> size
    if (wrapping(wrapping(head + taken) - sync_load(wrapping(ring + PERF_ZONE_RING_TAIL))) > PERF_ZONE_RING_BYTES) {
        perf_zone_ring_spill(ring)
    }
    data: wrapping(ring + PERF_ZONE_RING_AT)
    if (room < size) {
        if (room >= I64{32}) {
            rt_text_store(wrapping(wrapping(data + (head & PERF_ZONE_RING_MASK)) + I64{24}), PERF_ZONE_RING_SKIP << I64{32})
        }
        head = wrapping(head + room)
    }
    task: if (scheduler_control_current() == I64{0}) -> I64{0} else -> perf_zone_task()
    perf_zone_row_store(wrapping(data + (head & PERF_ZONE_RING_MASK)), PERF_ZONE_ZONE, start, end, task, rt_text_data(name), length)
    sync_store(ring, wrapping(head + size))
}

// This thread's zone ring, made on its first zone and linked on the rings'
// head for the drain; 0 when its pages cannot be mapped. The ring stays
// with the process: a thread that ends leaves its records for the drain.
perf_zone_ring: fn() -> I64 {
    base: thread_base()
    held: sync_load(wrapping(base + PERF_ZONE_TCB_RING))
    if (held != I64{0}) { return held }
    // Fresh pages read zero: an empty ring, its head and tail at 0.
    ring: alloc_map_try(wrapping(PERF_ZONE_RING_AT + PERF_ZONE_RING_BYTES))
    if (ring == I64{0}) { return I64{0} }
    rings: perf_zone_rings
    loop {
        first: sync_load(rings)
        sync_store(wrapping(ring + I64{8}), first)
        if (sync_cas(rings, first, ring) == first) { break }
    }
    sync_store(wrapping(base + PERF_ZONE_TCB_RING), ring)
    ring
}

// Hands the zone ring and the sampler's ring `from`'s TCB holds to `to`'s
// (PERF_ZONE_TCB_RING, PERF_SAMPLES_TCB_RING), as the hazard record is
// (IntHazard.jet int_hazard_lend): a carrier lends its rings to the fiber
// it switches to and takes back the ones the fiber holds when it switches
// out, so one thread at a time writes a zone ring, and the fiber's turns
// drain the carrier's sampler (perf_samples_turn).
perf_rings_lend: fn(from: I64, to: I64) {
    sync_store(wrapping(to + PERF_ZONE_TCB_RING), sync_load(wrapping(from + PERF_ZONE_TCB_RING)))
    sync_store(wrapping(to + PERF_SAMPLES_TCB_RING), sync_load(wrapping(from + PERF_SAMPLES_TCB_RING)))
}

// Drains the full ring `ring` of this thread into the spans buffer, or
// drops its records where there is no buffer.
perf_zone_ring_spill: fn(ring: I64) {
    buffer: perf_spans_buffer
    if (buffer == I64{0}) {
        sync_store(wrapping(ring + PERF_ZONE_RING_TAIL), sync_load(ring))
        return
    }
    sync_thread_lock(buffer)
    perf_zone_ring_drain(buffer, ring, perf_zone_scale())
    sync_thread_unlock(buffer)
}

// Moves every zone ring's records into the spans buffer `buffer`, whose
// lock the caller holds, each edge on the timeline (perf_zone_ns) by one
// scale for the whole drain.
perf_zone_rings_drain: fn(buffer: I64) {
    rings: perf_zone_rings
    if (rings == I64{0}) {
        return
    }
    ring := sync_load(rings)
    if (ring == I64{0}) {
        return
    }
    scale: perf_zone_scale()
    loop ring != (I64{0}) {
        perf_zone_ring_drain(buffer, ring, scale)
        ring = sync_load(wrapping(ring + I64{8}))
    }
}

// The records of `ring` its head has published, from its tail, as rows of
// the spans buffer `buffer` (perf_spans_put), whose lock the caller holds;
// then the tail, which frees their bytes for the ring's thread.
perf_zone_ring_drain: fn(buffer: I64, ring: I64, scale: I64) {
    head: sync_load(ring)
    tail := sync_load(wrapping(ring + PERF_ZONE_RING_TAIL))
    data: wrapping(ring + PERF_ZONE_RING_AT)
    loop tail != head {
        at: tail & PERF_ZONE_RING_MASK
        room: wrapping(PERF_ZONE_RING_BYTES - at)
        record: wrapping(data + at)
        shape: if (room < I64{32}) -> PERF_ZONE_RING_SKIP << I64{32} else -> rt_text_word(wrapping(record + I64{24}))
        kind: shape >> I64{32}
        if (kind == PERF_ZONE_RING_SKIP) {
            tail = wrapping(tail + room)
            next
        }
        length: shape & I64{4294967295}
        start: perf_zone_ns(rt_text_word(record), scale)
        end: perf_zone_ns(rt_text_word(wrapping(record + I64{8})), scale)
        perf_spans_put(buffer, kind, start, end, rt_text_word(wrapping(record + I64{16})), wrapping(record + I64{32}), length)
        tail = wrapping(tail + wrapping(I64{32} + (wrapping(length + I64{7}) & I64{-8})))
    }
    sync_store(wrapping(ring + PERF_ZONE_RING_TAIL), tail)
}

// core.perf.progress(name): one pass of the progress point the borrowed
// text `name` names, which the causal lens counts; nothing outside it.
#Export(c) jet_perf_progress: fn(name: I64) {
    if (jet_scheduler_native_propagate() != I64{0}) {
        return
    }
    perf_causal_progress(name)
}

// core.perf.frame(): a frame mark at now, while zones are on.
#Export(c) jet_perf_frame: fn() {
    if (perf_zones_on == I64{0}) {
        return
    }
    now: perf_zone_now()
    perf_zone_row(PERF_ZONE_FRAME, now, now, rt_static_text("frame"))
}

// core.perf.plot(name, value): `value`, its float bits in the row, at now,
// on the plot named by the borrowed text `name`, while zones are on.
#Export(c) jet_perf_plot_float: fn(name: I64, value: Float) {
    if (jet_scheduler_native_propagate() != I64{0}) {
        return
    }
    if (perf_zones_on == I64{0}) {
        return
    }
    perf_zone_row(PERF_ZONE_PLOT, perf_zone_now(), rt_f64_bits(value), name)
}

// One row of the spans file, the one timeline that log spans, zones, frame
// marks and plots share: `start`, `end` (a plot's value bits), the
// current task (0 outside every task), the byte length of the text `name`
// with `kind` (PERF_ZONE_LOG and the others) from bit 32, each a
// little-endian word, then the name. Rows gather in the spans buffer
// (perf_spans_buffer), written out when it fills and at exit
// (perf_spans_flush); a row larger than the buffer is written alone, after
// the rows before it. A zone's row comes through its thread's zone ring
// (perf_zone_ring_put).
perf_zone_row: fn(kind: I64, start: I64, end: I64, name: I64) {
    buffer: perf_spans_buffer
    if (buffer == I64{0}) {
        return
    }
    length: rt_text_len(name)
    task: if (scheduler_control_current() == I64{0}) -> I64{0} else -> perf_zone_task()
    sync_thread_lock(buffer)
    perf_spans_put(buffer, kind, start, end, task, rt_text_data(name), length)
    sync_thread_unlock(buffer)
}

// One row into the spans buffer `buffer`, whose lock the caller holds, its
// name the `length` bytes at `data`: the rows it holds are written out
// first when it has no room for the row.
perf_spans_put: fn(buffer: I64, kind: I64, start: I64, end: I64, task: I64, data: I64, length: I64) {
    size: I64{32} + length
    used := rt_text_word(wrapping(buffer + I64{8}))
    if (size > PERF_SPANS_BUFFER_BYTES || used + size > PERF_SPANS_BUFFER_BYTES) {
        perf_spans_write(buffer, wrapping(buffer + PERF_SPANS_HEADER_BYTES), used)
        used = I64{0}
    }
    if (size > PERF_SPANS_BUFFER_BYTES) {
        row: jet_rt_alloc(size, I64{8})
        perf_zone_row_store(row, kind, start, end, task, data, length)
        perf_spans_write(buffer, row, size)
        jet_rt_free(row, size, I64{8})
    } else {
        perf_zone_row_store(wrapping(wrapping(buffer + PERF_SPANS_HEADER_BYTES) + used), kind, start, end, task, data, length)
        used += size
    }
    rt_text_store(wrapping(buffer + I64{8}), used)
}

perf_zone_row_store: fn(row: I64, kind: I64, start: I64, end: I64, task: I64, data: I64, length: I64) {
    rt_text_store(row, start)
    rt_text_store(wrapping(row + I64{8}), end)
    rt_text_store(wrapping(row + I64{16}), task)
    rt_text_store(wrapping(row + I64{24}), length | (kind << I64{32}))
    coll_copy(data, wrapping(row + I64{32}), length)
}

// The spans buffer's bytes for rows, and its header: the lock word, the
// bytes used, then the bytes the spans file holds (perf_spans_write), -1 once
// it reached its bound.
PERF_SPANS_BUFFER_BYTES: I64{65536}

PERF_SPANS_HEADER_BYTES: I64{24}

// The most bytes of rows the spans file holds: a run or an attach window
// that closes more zones, log spans, frames and plots than fit keeps the
// first of them, then a PERF_ZONE_CUT row that says the rest were dropped,
// so the file can't fill the runtime directory it lives in.
PERF_SPANS_FILE_BYTES: I64{16777216}

// Write the `size` bytes of whole rows at `rows` to the spans file, whose
// buffer `buffer` the caller holds locked, while they fit its bound
// (PERF_SPANS_FILE_BYTES). The first rows that don't are dropped, and a
// PERF_ZONE_CUT row, past the bound, says so; every row after it is dropped
// too, until the file is emptied (perf_spans_truncate).
perf_spans_write: fn(buffer: I64, rows: I64, size: I64) {
    if (size <= I64{0}) {
        return
    }
    held: rt_text_word(wrapping(buffer + I64{16}))
    if (held < I64{0}) {
        return
    }
    if (held + size <= PERF_SPANS_FILE_BYTES) {
        _ := host_write_all(perf_spans_fd, rows, size)
        rt_text_store(wrapping(buffer + I64{16}), held + size)
        return
    }
    reason: rt_static_text("the spans file reached its 16 MiB bound, so the rows after this were dropped")
    length: rt_text_len(reason)
    row: jet_rt_alloc(I64{32} + length, I64{8})
    now: perf_zone_now()
    perf_zone_row_store(row, PERF_ZONE_CUT, now, now, I64{0}, rt_text_data(reason), length)
    _ := host_write_all(perf_spans_fd, row, I64{32} + length)
    jet_rt_free(row, I64{32} + length, I64{8})
    rt_text_store(wrapping(buffer + I64{16}), I64{-1})
}

// Write out the rows the spans buffer holds (perf_zone_row) and those of
// the zone rings (perf_zone_rings_drain); at exit (perf_samples_exit),
// before the samples' last record, and at each publication of a flight
// recorder whose zones `jet perf attach` turned on (perf_flight_zones).
perf_spans_flush: fn() {
    buffer: perf_spans_buffer
    if (buffer == I64{0} || perf_spans_fd < I64{0}) {
        return
    }
    sync_thread_lock(buffer)
    perf_zone_rings_drain(buffer)
    perf_spans_write(buffer, wrapping(buffer + PERF_SPANS_HEADER_BYTES), rt_text_word(wrapping(buffer + I64{8})))
    rt_text_store(wrapping(buffer + I64{8}), I64{0})
    sync_thread_unlock(buffer)
}

// Empty the spans file and its buffer, so a later attach reads only its
// own rows and has the whole bound (PERF_SPANS_FILE_BYTES) for them. The
// rows the zone rings hold go too.
perf_spans_truncate: fn() {
    buffer: perf_spans_buffer
    if (buffer == I64{0} || perf_spans_fd < I64{0}) {
        return
    }
    sync_thread_lock(buffer)
    perf_zone_rings_drain(buffer)
    // ftruncate; the file is opened O_APPEND, so the next row lands at 0.
    _ := observe_syscall(I64{77}, perf_spans_fd, I64{0}, I64{0}, I64{0})
    rt_text_store(wrapping(buffer + I64{8}), I64{0})
    rt_text_store(wrapping(buffer + I64{16}), I64{0})
    sync_thread_unlock(buffer)
}

// The heap snapshot named by text `name`, under the alloc lens
// (perf_samples_heap_take). The frames the snapshot scans for roots are the
// ones above this call's.
perf_samples_heap: fn(name: I64) {
    fd: perf_samples_fd
    if (fd < I64{0} || (perf_samples_lens_mask & PERF_LENS_ALLOC) == I64{0}) {
        return
    }
    _ := perf_samples_heap_take(fd, name, alloc_check_caller_frame())
}

// Write the heap snapshot named by text `name` to `fd`, its roots the frames
// above `frame` (none for 0) and the image's writable segments: the live
// list held (Alloc.jet alloc_check_track_hold) across a fork, whose child
// writes the snapshot (perf_samples_heap_write) and exits, and whose parent
// releases the list and waits for the child. Where the fork fails, this
// thread writes it while it holds the list. The nanoseconds the list was
// held, while every allocation and free of the program's waited on it.
perf_samples_heap_take: fn(fd: I64, name: I64, frame: I64) -> I64 {
    number: alloc_check_track_hold()
    began: sync_now_ns()
    pid := I64{-1}
    #Unsafe("fork copies the held live list into a child whose only thread writes the snapshot and exits, never returning from here") {
        pid = os_syscall_i64(I64{57}, I64{0}, I64{0}, I64{0}, I64{0}, I64{0}, I64{0})
    }
    if (pid <= I64{0}) { perf_samples_heap_write(fd, number, name, frame) }
    if (pid == I64{0}) { perf_samples_heap_child_exit() }
    held: wrapping(sync_now_ns() - began)
    alloc_check_track_release()
    if (pid > I64{0}) {
        reaped := I64{-4}
        loop reaped == (I64{-4}) {
            #Unsafe("wait4 reaps the snapshot's child and writes no status") {
                reaped = os_syscall_i64(I64{61}, pid, I64{0}, I64{0}, I64{0}, I64{0}, I64{0})
            }
        }
    }
    held
}

// End the heap snapshot's forked child once it has written the snapshot.
// The child is not the process a compiler serves, and it owns nothing to
// flush.
perf_samples_heap_child_exit: fn() {
    #Unsafe("exit_group ends the snapshot's child, which owns nothing to flush") {
        _ := os_syscall_i64(I64{231}, I64{0}, I64{0}, I64{0}, I64{0}, I64{0}, I64{0})
    }
}

// Write heap snapshot `number`, named by text `name`, to the samples file
// `fd`: the live list's blocks grouped by their allocating call sites in a
// table of PERF_SAMPLES_HEAP_GROUP words a group, then its mark record, one
// record per group and the retention records (perf_samples_heap_refs) of
// the roots in the frames above `frame`. It allocates nothing from the
// heap, whose locks other threads may hold: the table, the output buffer
// and the retention's index are mappings of their own. The mark record: the
// number in place of a sample's program counter, the blocks, their bytes,
// the name's byte length (at most PERF_SAMPLES_HEAP_NAME) and the name in
// whole words. A group's record: the number, the group's blocks, their
// bytes, then its call sites, innermost first, each a link-time address in
// the image's code, as a spawn record's (perf_samples_stack).
perf_samples_heap_write: fn(fd: I64, number: I64, name: I64, frame: I64) {
    group_bytes: wrapping(PERF_SAMPLES_HEAP_GROUP * I64{8})
    capacity := PERF_SAMPLES_HEAP_GROUPS
    table := alloc_map_try(wrapping(capacity * group_bytes))
    out: alloc_map_try(PERF_SAMPLES_HEAP_BUFFER)
    if (table == I64{0} || out == I64{0}) {
        if (table != I64{0}) { alloc_unmap(table, wrapping(capacity * group_bytes)) }
        if (out != I64{0}) { alloc_unmap(out, PERF_SAMPLES_HEAP_BUFFER) }
        return
    }
    groups := I64{0}
    blocks := I64{0}
    bytes := I64{0}
    // The output buffer holds each block's key while the walk runs.
    block := I64{0}
    #Unsafe("this thread holds the live list, or is the fork's child, whose copy of it its one thread held") {
        block = alloc_check_live_next(I64{0})
    }
    loop block != (I64{0}) {
        if (wrapping(groups * I64{2}) >= capacity) {
            grown: perf_samples_heap_grow(table, capacity)
            if (grown == I64{0}) { break }
            table = grown
            capacity = wrapping(capacity * I64{2})
        }
        size := I64{0}
        #Unsafe("block is a tracked live payload of the held live list") {
            size = alloc_check_live_size(block)
        }
        perf_samples_heap_key(alloc_check_live_chain(block), out)
        group: perf_samples_heap_slot(table, capacity, out)
        if (rt_text_word(group) == I64{0}) {
            rt_text_bytes_copy(wrapping(group + I64{16}), out, wrapping(wrapping(PERF_SAMPLES_HEAP_DEPTH + I64{1}) * I64{8}))
            groups = wrapping(groups + I64{1})
        }
        rt_text_store(group, wrapping(rt_text_word(group) + I64{1}))
        rt_text_store(wrapping(group + I64{8}), wrapping(rt_text_word(wrapping(group + I64{8})) + size))
        blocks = wrapping(blocks + I64{1})
        bytes = wrapping(bytes + size)
        #Unsafe("block is a tracked live payload of the held live list") {
            block = alloc_check_live_next(block)
        }
    }
    full: rt_text_len(name)
    length: if (full > PERF_SAMPLES_HEAP_NAME) -> PERF_SAMPLES_HEAP_NAME else -> full
    words: wrapping(I64{4} + wrapping(wrapping(length + I64{7}) / I64{8}))
    rt_text_store(wrapping(out + wrapping(wrapping(words - I64{1}) * I64{8})), I64{0})
    rt_text_store(out, (number & PERF_SAMPLES_ADDRESS_MASK) | (words << PERF_SAMPLES_ADDRESS_BITS) | (PERF_SAMPLES_HEAP_MARK << PERF_SAMPLES_KIND_BITS))
    rt_text_store(wrapping(out + I64{8}), blocks)
    rt_text_store(wrapping(out + I64{16}), bytes)
    rt_text_store(wrapping(out + I64{24}), length)
    rt_text_bytes_copy(wrapping(out + I64{32}), rt_text_data(name), length)
    used := wrapping(words * I64{8})
    // Once a group's record is written, its ordinal among the snapshot's
    // group records, from 1, takes the place of its blocks, so a block's
    // record names its group (perf_samples_heap_refs).
    ordinal := I64{0}
    index := I64{0}
    loop index < capacity {
        group: wrapping(table + wrapping(index * group_bytes))
        if (rt_text_word(group) != I64{0}) {
            depth: rt_text_word(wrapping(group + I64{16}))
            record: wrapping(wrapping(depth + I64{3}) * I64{8})
            if (wrapping(used + record) > PERF_SAMPLES_HEAP_BUFFER) {
                _ := host_write_all(fd, out, used)
                used = I64{0}
            }
            at: wrapping(out + used)
            rt_text_store(at, (number & PERF_SAMPLES_ADDRESS_MASK) | (wrapping(depth + I64{3}) << PERF_SAMPLES_ADDRESS_BITS) | (PERF_SAMPLES_HEAP_SITE << PERF_SAMPLES_KIND_BITS))
            rt_text_store(wrapping(at + I64{8}), rt_text_word(group))
            rt_text_store(wrapping(at + I64{16}), rt_text_word(wrapping(group + I64{8})))
            rt_text_bytes_copy(wrapping(at + I64{24}), wrapping(group + I64{24}), wrapping(depth * I64{8}))
            used = wrapping(used + record)
            ordinal = wrapping(ordinal + I64{1})
            rt_text_store(group, ordinal)
        }
        index = wrapping(index + I64{1})
    }
    used = perf_samples_heap_refs(fd, number, out, used, table, capacity, frame)
    _ := host_write_all(fd, out, used)
    alloc_unmap(table, wrapping(capacity * group_bytes))
    alloc_unmap(out, PERF_SAMPLES_HEAP_BUFFER)
}

// Write heap snapshot `number`'s retention records to `fd` through `out`,
// whose first `used` bytes hold records not yet written; the bytes it holds
// then. The live blocks, sorted by address into a mapping of their own (no
// records when it cannot be mapped), each get a block record: the block's
// address, its size and the ordinal of its group's record in `table` of
// `capacity` groups (perf_samples_heap_write; 0 for a block no group took),
// then each word of its payload that points into another live block, as
// the word's offset and that block's address, in further records of the
// same three words past PERF_SAMPLES_HEAP_RECORD words. The root records
// follow (perf_samples_heap_roots).
perf_samples_heap_refs: fn(fd: I64, number: I64, out: I64, used: I64, table: I64, capacity: I64, frame: I64) -> I64 {
    count := I64{0}
    block := I64{0}
    #Unsafe("this thread holds the live list, or is the fork's child, whose copy of it its one thread held") {
        block = alloc_check_live_next(I64{0})
        loop block != (I64{0}) {
            count = wrapping(count + I64{1})
            block = alloc_check_live_next(block)
        }
    }
    key_bytes: wrapping(wrapping(PERF_SAMPLES_HEAP_DEPTH + I64{1}) * I64{8})
    index_bytes: wrapping(wrapping(count * I64{16}) + key_bytes)
    sorted: alloc_map_try(index_bytes)
    if (sorted == I64{0}) { return used }
    key: wrapping(sorted + wrapping(count * I64{16}))
    at := sorted
    #Unsafe("this thread holds the live list, or is the fork's child, whose copy of it its one thread held") {
        block = alloc_check_live_next(I64{0})
        loop block != (I64{0}) {
            rt_text_store(at, block)
            rt_text_store(wrapping(at + I64{8}), alloc_check_live_size(block))
            at = wrapping(at + I64{16})
            block = alloc_check_live_next(block)
        }
    }
    perf_samples_heap_sort(sorted, count)
    taken := used
    #Unsafe("this thread holds the live list, or is the fork's child, whose copy of it its one thread held") {
        block = alloc_check_live_next(I64{0})
    }
    loop block != (I64{0}) {
        size := I64{0}
        #Unsafe("block is a tracked live payload of the held live list") {
            size = alloc_check_live_size(block)
        }
        perf_samples_heap_key(alloc_check_live_chain(block), key)
        group: rt_text_word(perf_samples_heap_slot(table, capacity, key))
        taken = perf_samples_heap_room(fd, out, taken)
        at = wrapping(out + taken)
        words := perf_samples_heap_open(at, block, size, group)
        offset := I64{0}
        loop wrapping(offset + I64{8}) <= size {
            target: perf_samples_heap_find(sorted, count, rt_text_word(wrapping(block + offset)))
            if (target != I64{0} && target != block) {
                if (wrapping(words + I64{2}) > PERF_SAMPLES_HEAP_RECORD) {
                    perf_samples_heap_close(at, number, words, PERF_SAMPLES_HEAP_BLOCK)
                    taken = perf_samples_heap_room(fd, out, wrapping(taken + wrapping(words * I64{8})))
                    at = wrapping(out + taken)
                    words = perf_samples_heap_open(at, block, size, group)
                }
                rt_text_store(wrapping(at + wrapping(words * I64{8})), offset)
                rt_text_store(wrapping(at + wrapping(wrapping(words + I64{1}) * I64{8})), target)
                words = wrapping(words + I64{2})
            }
            offset = wrapping(offset + I64{8})
        }
        perf_samples_heap_close(at, number, words, PERF_SAMPLES_HEAP_BLOCK)
        taken = wrapping(taken + wrapping(words * I64{8}))
        #Unsafe("block is a tracked live payload of the held live list") {
            block = alloc_check_live_next(block)
        }
    }
    taken = perf_samples_heap_roots(fd, number, out, taken, sorted, count, frame)
    alloc_unmap(sorted, index_bytes)
    taken
}

// Heap snapshot `number`'s root records, through `out` as
// perf_samples_heap_refs writes them, of the live blocks `sorted` holds
// `count` of. The frames of this thread above `frame`, a frame of its frame
// pointer chain: each as the call site in its function (a link-time
// address, as a group's record keeps them), its frame pointer and the
// lowest address of its frame. Then the words of those frames that point
// into a live block, as the word's address and that block's: a frame is
// the words from its callee's return address up to its own frame pointer,
// none where the call crossed into another stack segment. Then the words of
// the image's writable segments that do, as the word's link-time address
// and the block's; the live list's own head is no such word.
perf_samples_heap_roots: fn(fd: I64, number: I64, out: I64, used: I64, sorted: I64, count: I64, frame: I64) -> I64 {
    bias: perf_samples_bias
    taken := perf_samples_heap_room(fd, out, used)
    at := wrapping(out + taken)
    rt_text_store(wrapping(at + I64{8}), PERF_SAMPLES_ROOT_FRAMES)
    words := I64{2}
    link := frame
    depth := I64{0}
    loop link != (I64{0}) && depth < PERF_SAMPLES_DEPTH {
        address: rt_text_word(wrapping(link + I64{8}))
        above := I64{0}
        #Unsafe("link is a live [saved rbp][return address] pair of this thread's frame pointer chain, above the snapshot's own frames") {
            above = stack_frame_caller(link)
        }
        if (above == I64{0}) { break }
        if (wrapping(words + I64{3}) > PERF_SAMPLES_HEAP_RECORD) {
            perf_samples_heap_close(at, number, words, PERF_SAMPLES_HEAP_ROOT)
            taken = perf_samples_heap_room(fd, out, wrapping(taken + wrapping(words * I64{8})))
            at = wrapping(out + taken)
            rt_text_store(wrapping(at + I64{8}), PERF_SAMPLES_ROOT_FRAMES)
            words = I64{2}
        }
        rt_text_store(wrapping(at + wrapping(words * I64{8})), wrapping(wrapping(address - I64{1}) - bias))
        rt_text_store(wrapping(at + wrapping(wrapping(words + I64{1}) * I64{8})), above)
        rt_text_store(wrapping(at + wrapping(wrapping(words + I64{2}) * I64{8})), wrapping(link + I64{16}))
        words = wrapping(words + I64{3})
        link = above
        depth = wrapping(depth + I64{1})
    }
    perf_samples_heap_close(at, number, words, PERF_SAMPLES_HEAP_ROOT)
    taken = perf_samples_heap_room(fd, out, wrapping(taken + wrapping(words * I64{8})))
    at = wrapping(out + taken)
    rt_text_store(wrapping(at + I64{8}), PERF_SAMPLES_ROOT_STACK)
    words = I64{2}
    link = frame
    depth = I64{0}
    loop link != (I64{0}) && depth < PERF_SAMPLES_DEPTH {
        above := I64{0}
        #Unsafe("link is a live [saved rbp][return address] pair of this thread's frame pointer chain, above the snapshot's own frames") {
            above = stack_frame_caller(link)
        }
        if (above == I64{0}) { break }
        if (above > link && wrapping(above - link) < I64{16777216}) {
            slot := wrapping(link + I64{16})
            loop slot < above {
                target: perf_samples_heap_find(sorted, count, rt_text_word(slot))
                if (target != I64{0}) {
                    if (wrapping(words + I64{2}) > PERF_SAMPLES_HEAP_RECORD) {
                        perf_samples_heap_close(at, number, words, PERF_SAMPLES_HEAP_ROOT)
                        taken = perf_samples_heap_room(fd, out, wrapping(taken + wrapping(words * I64{8})))
                        at = wrapping(out + taken)
                        rt_text_store(wrapping(at + I64{8}), PERF_SAMPLES_ROOT_STACK)
                        words = I64{2}
                    }
                    rt_text_store(wrapping(at + wrapping(words * I64{8})), slot)
                    rt_text_store(wrapping(at + wrapping(wrapping(words + I64{1}) * I64{8})), target)
                    words = wrapping(words + I64{2})
                }
                slot = wrapping(slot + I64{8})
            }
        }
        link = above
        depth = wrapping(depth + I64{1})
    }
    perf_samples_heap_close(at, number, words, PERF_SAMPLES_HEAP_ROOT)
    taken = perf_samples_heap_room(fd, out, wrapping(taken + wrapping(words * I64{8})))
    at = wrapping(out + taken)
    rt_text_store(wrapping(at + I64{8}), PERF_SAMPLES_ROOT_DATA)
    words = I64{2}
    head := I64{0}
    #Unsafe("this thread holds the live list, or is the fork's child, whose copy of it its one thread held; the head goes back below") {
        head = alloc_check_live_swap(I64{0})
    }
    image: perf_samples_image
    if (image != I64{0}) {
        // e_phoff, e_phentsize (bits 48..63 of the word at 48) and e_phnum
        // (bits 0..15 of the word at 56), as perf_samples_code_edge reads them.
        headers: rt_text_word(wrapping(image + I64{32}))
        entry: (rt_text_word(wrapping(image + I64{48})) >> I64{48}) & I64{65535}
        segments: rt_text_word(wrapping(image + I64{56})) & I64{65535}
        index := I64{0}
        loop index < segments {
            header: wrapping(image + wrapping(headers + wrapping(index * entry)))
            kind: rt_text_word(header)
            // A PT_LOAD segment both readable (PF_R) and writable (PF_W), at
            // its p_vaddr for p_memsz bytes.
            if (kind & I64{4294967295} == I64{1} && (kind >> I64{32}) & I64{6} == I64{6}) {
                start: wrapping(rt_text_word(wrapping(header + I64{16})) + bias)
                end: wrapping(start + rt_text_word(wrapping(header + I64{40})))
                slot := wrapping(start + I64{7}) & I64{-8}
                loop wrapping(slot + I64{8}) <= end {
                    target: perf_samples_heap_find(sorted, count, rt_text_word(slot))
                    if (target != I64{0}) {
                        if (wrapping(words + I64{2}) > PERF_SAMPLES_HEAP_RECORD) {
                            perf_samples_heap_close(at, number, words, PERF_SAMPLES_HEAP_ROOT)
                            taken = perf_samples_heap_room(fd, out, wrapping(taken + wrapping(words * I64{8})))
                            at = wrapping(out + taken)
                            rt_text_store(wrapping(at + I64{8}), PERF_SAMPLES_ROOT_DATA)
                            words = I64{2}
                        }
                        rt_text_store(wrapping(at + wrapping(words * I64{8})), wrapping(slot - bias))
                        rt_text_store(wrapping(at + wrapping(wrapping(words + I64{1}) * I64{8})), target)
                        words = wrapping(words + I64{2})
                    }
                    slot = wrapping(slot + I64{8})
                }
            }
            index = wrapping(index + I64{1})
        }
    }
    #Unsafe("the head this scan took from the live list goes back before the list is let go") {
        _ := alloc_check_live_swap(head)
    }
    perf_samples_heap_close(at, number, words, PERF_SAMPLES_HEAP_ROOT)
    wrapping(taken + wrapping(words * I64{8}))
}

// `used`, the bytes of `out` holding records not yet written to `fd`, or 0
// once it writes them where another record of PERF_SAMPLES_HEAP_RECORD
// words would not fit.
perf_samples_heap_room: fn(fd: I64, out: I64, used: I64) -> I64 {
    if (wrapping(used + wrapping(PERF_SAMPLES_HEAP_RECORD * I64{8})) <= PERF_SAMPLES_HEAP_BUFFER) {
        return used
    }
    _ := host_write_all(fd, out, used)
    I64{0}
}

// Open a block record at `at`: the block's address, size and group
// ordinal after the first word; the words it holds.
perf_samples_heap_open: fn(at: I64, block: I64, size: I64, group: I64) -> I64 {
    rt_text_store(wrapping(at + I64{8}), block)
    rt_text_store(wrapping(at + I64{16}), size)
    rt_text_store(wrapping(at + I64{24}), group)
    I64{4}
}

// Close the record of `words` words at `at`, of kind `kind` and heap
// snapshot `number`, with its first word.
perf_samples_heap_close: fn(at: I64, number: I64, words: I64, kind: I64) {
    rt_text_store(at, (number & PERF_SAMPLES_ADDRESS_MASK) | (words << PERF_SAMPLES_ADDRESS_BITS) | (kind << PERF_SAMPLES_KIND_BITS))
}

// The address of the live block of the `count` (address, size) entries of
// `sorted`, sorted by address, whose payload holds address `value`; 0 when
// none does.
perf_samples_heap_find: fn(sorted: I64, count: I64, value: I64) -> I64 {
    low := I64{0}
    high := count
    // The last entry that starts at or below the value.
    loop low < high {
        middle: wrapping(low + ((high - low) >> I64{1}))
        if (rt_text_word(wrapping(sorted + wrapping(middle * I64{16}))) <= value) {
            low = wrapping(middle + I64{1})
        } else { high = middle }
    }
    if (low == I64{0}) { return I64{0} }
    entry: wrapping(sorted + wrapping(wrapping(low - I64{1}) * I64{16}))
    start: rt_text_word(entry)
    if (value < wrapping(start + rt_text_word(wrapping(entry + I64{8})))) -> start else -> I64{0}
}

// Sort the `count` two-word entries of `sorted` by their first word, in
// place: a heap sort, as the runtime's sort would allocate and a snapshot
// may index millions of blocks.
perf_samples_heap_sort: fn(sorted: I64, count: I64) {
    start := count >> I64{1}
    loop start > (I64{0}) {
        start = wrapping(start - I64{1})
        perf_samples_heap_sift(sorted, start, count)
    }
    end := count
    loop end > (I64{1}) {
        end = wrapping(end - I64{1})
        perf_samples_heap_swap(sorted, I64{0}, end)
        perf_samples_heap_sift(sorted, I64{0}, end)
    }
}

// Sift entry `root` of the first `count` entries of `sorted` down to its
// place in their max-heap.
perf_samples_heap_sift: fn(sorted: I64, root: I64, count: I64) {
    at := root
    loop {
        child := wrapping(wrapping(at * I64{2}) + I64{1})
        if (child >= count) {
            return
        }
        if (wrapping(child + I64{1}) < count && rt_text_word(wrapping(sorted + wrapping(wrapping(child + I64{1}) * I64{16}))) > rt_text_word(wrapping(sorted + wrapping(child * I64{16})))) {
            child = wrapping(child + I64{1})
        }
        if (rt_text_word(wrapping(sorted + wrapping(at * I64{16}))) >= rt_text_word(wrapping(sorted + wrapping(child * I64{16})))) {
            return
        }
        perf_samples_heap_swap(sorted, at, child)
        at = child
    }
}

perf_samples_heap_swap: fn(sorted: I64, first: I64, second: I64) {
    one: wrapping(sorted + wrapping(first * I64{16}))
    other: wrapping(sorted + wrapping(second * I64{16}))
    start: rt_text_word(one)
    size: rt_text_word(wrapping(one + I64{8}))
    rt_text_store(one, rt_text_word(other))
    rt_text_store(wrapping(one + I64{8}), rt_text_word(wrapping(other + I64{8})))
    rt_text_store(other, start)
    rt_text_store(wrapping(other + I64{8}), size)
}

// A heap snapshot's key of a live block at `key`: how many call sites its
// allocating `chain` (Alloc.jet alloc_check_live_chain) keeps in the
// image's code, then PERF_SAMPLES_HEAP_DEPTH words of those sites, each
// less the load bias as perf_samples_stack keeps them, 0 past the last.
perf_samples_heap_key: fn(chain: I64, key: I64) {
    bias: perf_samples_bias
    depth := I64{0}
    loop depth < PERF_SAMPLES_HEAP_DEPTH {
        address: rt_text_word(wrapping(chain + wrapping(depth * I64{8})))
        if (address == I64{0}) { break }
        site: wrapping(wrapping(address - I64{1}) - bias)
        if (!perf_samples_in_code(site)) { break }
        rt_text_store(wrapping(key + wrapping(wrapping(depth + I64{1}) * I64{8})), site)
        depth = wrapping(depth + I64{1})
    }
    rest := depth
    loop rest < PERF_SAMPLES_HEAP_DEPTH {
        rt_text_store(wrapping(key + wrapping(wrapping(rest + I64{1}) * I64{8})), I64{0})
        rest = wrapping(rest + I64{1})
    }
    rt_text_store(key, depth)
}

// The group of `key` (perf_samples_heap_key) in a snapshot's `table` of
// `capacity` groups, a power of two: the group whose key it is, else the
// empty one, with no blocks, where its probe stops.
perf_samples_heap_slot: fn(table: I64, capacity: I64, key: I64) -> I64 {
    key_bytes: wrapping(wrapping(PERF_SAMPLES_HEAP_DEPTH + I64{1}) * I64{8})
    hash := I64{0}
    at := I64{0}
    loop at < key_bytes {
        hash = wrapping((hash ~ rt_text_word(wrapping(key + at))) * I64{1099511628211})
        at = wrapping(at + I64{8})
    }
    mask: wrapping(capacity - I64{1})
    slot := (hash ~ (hash >> I64{29})) & mask
    loop {
        group: wrapping(table + wrapping(slot * wrapping(PERF_SAMPLES_HEAP_GROUP * I64{8})))
        if (rt_text_word(group) == I64{0} || rt_text_equal_bytes(wrapping(group + I64{16}), key, key_bytes)) {
            return group
        }
        slot = wrapping(slot + I64{1}) & mask
    }
}

// A snapshot's `table` of `capacity` groups moved into a new table of twice
// as many, which it returns, or 0, keeping `table`, when it cannot be mapped.
perf_samples_heap_grow: fn(table: I64, capacity: I64) -> I64 {
    group_bytes: wrapping(PERF_SAMPLES_HEAP_GROUP * I64{8})
    larger: wrapping(capacity * I64{2})
    grown: alloc_map_try(wrapping(larger * group_bytes))
    if (grown == I64{0}) { return I64{0} }
    index := I64{0}
    loop index < capacity {
        group: wrapping(table + wrapping(index * group_bytes))
        if (rt_text_word(group) != I64{0}) {
            rt_text_bytes_copy(perf_samples_heap_slot(grown, larger, wrapping(group + I64{16})), group, group_bytes)
        }
        index = wrapping(index + I64{1})
    }
    alloc_unmap(table, wrapping(capacity * group_bytes))
    grown
}

// Under the alloc lens, the alloc lens's count of the program's allocations
// (perf_alloc_state) mapped before the program runs, its table of
// PERF_SAMPLES_HEAP_GROUPS groups; none when either mapping fails, and the
// lens's records then hold no allocation.
perf_samples_alloc_open: fn() {
    state: alloc_map_try(PERF_ALLOC_STATE_BYTES)
    if (state == I64{0}) {
        return
    }
    table: alloc_map_try(wrapping(PERF_SAMPLES_HEAP_GROUPS * wrapping(PERF_SAMPLES_HEAP_GROUP * I64{8})))
    if (table == I64{0}) {
        alloc_unmap(state, PERF_ALLOC_STATE_BYTES)
        return
    }
    rt_text_store(state, table)
    rt_text_store(wrapping(state + I64{8}), PERF_SAMPLES_HEAP_GROUPS)
    #Unsafe("the observation start runs before the program's entry, whose takes read it") {
        perf_alloc_state = state
    }
}

// The time a tracking take's allocation starts costing the alloc lens
// (Alloc.jet jet_rt_alloc_check_take), before it waits for the quarantine
// lock; 0 when the lens counts nothing.
perf_samples_alloc_began: fn() -> I64 {
    if (perf_alloc_state == I64{0}) -> I64{0} else -> sync_now_ns()
}

// Count a tracking take's allocation of `size` bytes at its allocating
// `chain` (Alloc.jet alloc_check_live_chain), and the nanoseconds since
// `began` (perf_samples_alloc_began) the lens spent on it: the lock's wait,
// the live list's link and this count. The take holds the quarantine lock.
// A chain new to a table that is full, and cannot grow, counts in the
// totals alone.
perf_samples_alloc_site: fn(chain: I64, size: I64, began: I64) {
    state: perf_alloc_state
    if (state == I64{0}) {
        return
    }
    table := rt_text_word(state)
    capacity := rt_text_word(wrapping(state + I64{8}))
    groups: rt_text_word(wrapping(state + I64{16}))
    if (wrapping(groups * I64{2}) >= capacity) {
        grown: perf_samples_heap_grow(table, capacity)
        if (grown != I64{0}) {
            table = grown
            capacity = wrapping(capacity * I64{2})
            rt_text_store(state, table)
            rt_text_store(wrapping(state + I64{8}), capacity)
        }
    }
    key: wrapping(state + PERF_ALLOC_KEY)
    perf_samples_heap_key(chain, key)
    group: perf_samples_heap_slot(table, capacity, key)
    count: rt_text_word(group)
    // One group stays empty, so every probe ends.
    if (count != I64{0} || wrapping(groups + I64{1}) < capacity) {
        if (count == I64{0}) {
            rt_text_bytes_copy(wrapping(group + I64{16}), key, wrapping(wrapping(PERF_SAMPLES_HEAP_DEPTH + I64{1}) * I64{8}))
            rt_text_store(wrapping(state + I64{16}), wrapping(groups + I64{1}))
        }
        rt_text_store(group, wrapping(count + I64{1}))
        rt_text_store(wrapping(group + I64{8}), wrapping(rt_text_word(wrapping(group + I64{8})) + size))
    }
    rt_text_store(wrapping(state + I64{24}), wrapping(rt_text_word(wrapping(state + I64{24})) + I64{1}))
    rt_text_store(wrapping(state + I64{32}), wrapping(rt_text_word(wrapping(state + I64{32})) + wrapping(sync_now_ns() - began)))
}

// At exit, the alloc lens's count to `fd`: an allocations' record for each
// chain that allocated, its first word the allocations, then the number of
// words after it from PERF_SAMPLES_ADDRESS_BITS and PERF_ALLOC_RECORD; then
// their bytes and the chain's call sites (perf_samples_heap_key). The
// allocations counted and the nanoseconds the lens spent on them go to
// `totals`, two words, 0 each without the lens. Under the quarantine lock,
// so a take still running elsewhere waits for the count to be written; the
// count then ends, so a second exit writes no allocation twice.
perf_samples_alloc_write: fn(fd: I64, totals: I64) {
    rt_text_store(totals, I64{0})
    rt_text_store(wrapping(totals + I64{8}), I64{0})
    if (perf_alloc_state == I64{0}) {
        return
    }
    out: alloc_map_try(PERF_SAMPLES_HEAP_BUFFER)
    alloc_check_track_lock()
    state: perf_alloc_state
    table: rt_text_word(state)
    capacity: rt_text_word(wrapping(state + I64{8}))
    group_bytes: wrapping(PERF_SAMPLES_HEAP_GROUP * I64{8})
    used := I64{0}
    index := I64{0}
    // No buffer, no record.
    limit: if (out == I64{0}) -> I64{0} else -> capacity
    loop index < limit {
        group: wrapping(table + wrapping(index * group_bytes))
        count: rt_text_word(group)
        if (count != I64{0}) {
            depth: rt_text_word(wrapping(group + I64{16}))
            record: wrapping(wrapping(depth + I64{2}) * I64{8})
            if (wrapping(used + record) > PERF_SAMPLES_HEAP_BUFFER) {
                _ := host_write_all(fd, out, used)
                used = I64{0}
            }
            at: wrapping(out + used)
            rt_text_store(at, (count & PERF_SAMPLES_ADDRESS_MASK) | (wrapping(depth + I64{1}) << PERF_SAMPLES_ADDRESS_BITS) | PERF_ALLOC_RECORD)
            rt_text_store(wrapping(at + I64{8}), rt_text_word(wrapping(group + I64{8})))
            rt_text_bytes_copy(wrapping(at + I64{16}), wrapping(group + I64{24}), wrapping(depth * I64{8}))
            used = wrapping(used + record)
        }
        index = wrapping(index + I64{1})
    }
    rt_text_store(totals, rt_text_word(wrapping(state + I64{24})))
    rt_text_store(wrapping(totals + I64{8}), rt_text_word(wrapping(state + I64{32})))
    #Unsafe("the held quarantine lock guards the count; every take reads it under the lock") {
        perf_alloc_state = I64{0}
    }
    alloc_check_track_release()
    alloc_unmap(table, wrapping(capacity * group_bytes))
    alloc_unmap(state, PERF_ALLOC_STATE_BYTES)
    if (out != I64{0}) {
        _ := host_write_all(fd, out, used)
        alloc_unmap(out, PERF_SAMPLES_HEAP_BUFFER)
    }
}

// The bytes of one of perf_samples_slots' record buffers.
perf_samples_slot_bytes: fn() -> I64 {
    wrapping(wrapping(wrapping(PERF_SAMPLES_DEPTH + I64{1}) * I64{8}) + PERF_CFI_SCRATCH_BYTES)
}

// A record buffer for one handler: perf_samples_buffer, or else the first
// of the PERF_SAMPLES_SLOTS more that no other handler holds. Its busy
// word, now 1, or 0 when another handler holds every one.
perf_samples_claim: fn(buffer: I64) -> I64 {
    if (sync_cas(buffer, I64{0}, I64{1}) == I64{0}) { return buffer }
    slots: perf_samples_slots
    if (slots == I64{0}) { return I64{0} }
    size: perf_samples_slot_bytes()
    index := I64{0}
    loop index < PERF_SAMPLES_SLOTS {
        slot: wrapping(slots + wrapping(index * size))
        if (sync_cas(slot, I64{0}, I64{1}) == I64{0}) { return slot }
        index = wrapping(index + I64{1})
    }
    I64{0}
}

// The call frame rules' scratch of the record buffer `slot`
// (perf_samples_claim): perf_cfi_scratch for perf_samples_buffer, the bytes
// after its record words for one of perf_samples_slots; 0 when the image's
// call frame information was not read.
perf_samples_scratch: fn(slot: I64, buffer: I64) -> I64 {
    if (perf_cfi_scratch == I64{0}) { return I64{0} }
    if (slot == buffer) -> perf_cfi_scratch else -> wrapping(slot + wrapping(wrapping(PERF_SAMPLES_DEPTH + I64{1}) * I64{8}))
}

// The file `<samples><suffix>`, opened to append to as the samples file is,
// or -1 when it cannot be.
perf_samples_open_beside: fn(samples: I64, suffix: I64) -> I64 {
    builder: jet_rt_string_builder_new()
    jet_rt_string_builder_push(builder, samples)
    jet_rt_string_builder_push(builder, suffix)
    path: jet_rt_string_builder_finish(builder)
    name: fd_c_path(path)
    fd: host_call(I64{2}, name, PERF_SAMPLES_OPEN, I64{384})
    fd_c_path_drop(name, path)
    jet_rt_string_drop(path)
    fd
}

// Keep `<samples>.spans` for the closed log spans' rows, with its buffer
// (perf_zone_row), and turn zones on; a file that cannot be opened (-1)
// leaves the spans without rows and zones off, as before.
perf_spans_fd_set: fn(fd: I64) {
    if (fd < I64{0}) {
        return
    }
    // A log span's row (perf_zone_row) reads the task key from the file's store on.
    perf_zone_roots_take()
    buffer: jet_rt_alloc(PERF_SPANS_HEADER_BYTES + PERF_SPANS_BUFFER_BYTES, I64{8})
    rt_text_store(buffer, I64{0})
    rt_text_store(wrapping(buffer + I64{8}), I64{0})
    rt_text_store(wrapping(buffer + I64{16}), I64{0})
    #Unsafe("the observation start runs before the entry, whose span closes read it") {
        perf_spans_buffer = buffer
        perf_spans_fd = fd
    }
    perf_zones_set(I64{1})
}

// The record of task `id`'s spawn by task `parent`, under `jet perf run`:
// the id in place of a sample's program counter, the parent's id, then the
// spawning stack (perf_samples_stack). `jet perf run` names the task's
// spawn by the innermost of its call sites on a line of the checked source,
// and gives the task a trace row under its parent's when no observation
// saw it.
perf_samples_spawn: fn(id: I64, parent: I64) {
    fd: perf_samples_fd
    if (fd < I64{0} || id == I64{0}) {
        return
    }
    size: wrapping(wrapping(PERF_SAMPLES_STACK_DEPTH + I64{2}) * I64{8})
    record: jet_rt_alloc(size, I64{8})
    rt_text_store(wrapping(record + I64{8}), parent)
    words: wrapping(perf_samples_stack(wrapping(record + I64{16})) + I64{2})
    rt_text_store(record, (id & PERF_SAMPLES_ADDRESS_MASK) | (words << PERF_SAMPLES_ADDRESS_BITS) | (PERF_SAMPLES_SPAWN << PERF_SAMPLES_KIND_BITS))
    perf_samples_send(fd, record, wrapping(words * I64{8}))
    jet_rt_free(record, size, I64{8})
}

// The call site of each caller up this thread's frame pointer chain, into
// the PERF_SAMPLES_STACK_DEPTH words at `chain`, innermost first, each less
// the load bias, while it is in the image's code (Alloc.jet
// alloc_check_frames): how many it stored.
perf_samples_stack: fn(chain: I64) -> I64 {
    alloc_check_frames(chain, PERF_SAMPLES_STACK_DEPTH)
    bias: perf_samples_bias
    count := I64{0}
    loop count < PERF_SAMPLES_STACK_DEPTH {
        address: rt_text_word(wrapping(chain + wrapping(count * I64{8})))
        if (address == I64{0}) { break }
        site: wrapping(wrapping(address - I64{1}) - bias)
        if (!perf_samples_in_code(site)) { break }
        rt_text_store(wrapping(chain + wrapping(count * I64{8})), site)
        count = wrapping(count + I64{1})
    }
    count
}

// What a wait is for, as its record keeps it (perf_samples_wait): `class`
// (PERF_SAMPLES_OBJECT_TASK and the others; 0 for nothing the wait names)
// above the low 48 bits of `id`.
perf_samples_object: fn(class: I64, id: I64) -> I64 {
    (class << PERF_SAMPLES_ADDRESS_BITS) | (id & PERF_SAMPLES_ADDRESS_MASK)
}

// The record of a task's wait on `slot`, under `jet perf run`, from `start`
// to now on the monotonic clock, the clock of the log spans' rows: the
// waiting task's id in place of a sample's program counter, then the slot,
// the start, the end, `object` (perf_samples_object), the byte lengths of
// the wait's name `name` (the text its task's observed state shows, at most
// PERF_SAMPLES_WAIT_NAME bytes of it), of the socket's own address and of
// its peer's address, 16 bits each from bit 0 (perf_samples_sockaddr; both
// 0 unless `object` is a PERF_SAMPLES_OBJECT_SOCKET), the name and the two
// addresses in whole words, then the waiting stack (perf_samples_stack).
// The wake that ended the wait is the last wake of the same slot before its
// end (perf_samples_wake); a wait with none ended by its own timeout.
perf_samples_wait: fn(slot: I64, name: I64, object: I64, start: I64) {
    fd: perf_samples_fd
    if (fd < I64{0}) {
        return
    }
    end: time_host_monotonic_i64()
    full: if (name == I64{0}) -> I64{0} else -> rt_text_len(name)
    length: if (full > PERF_SAMPLES_WAIT_NAME) -> PERF_SAMPLES_WAIT_NAME else -> full
    // A socket's two addresses, the socket's own at `ends` and its peer's
    // 128 bytes on.
    ends: if ((object >> PERF_SAMPLES_ADDRESS_BITS) == PERF_SAMPLES_OBJECT_SOCKET) -> jet_rt_alloc(I64{256}, I64{8}) else -> I64{0}
    own: if (ends == I64{0}) -> I64{0} else -> perf_samples_sockaddr(object & PERF_SAMPLES_ADDRESS_MASK, false, ends)
    peer: if (ends == I64{0}) -> I64{0} else -> perf_samples_sockaddr(object & PERF_SAMPLES_ADDRESS_MASK, true, wrapping(ends + I64{128}))
    text_words: wrapping(wrapping(wrapping(length + own) + peer) + I64{7}) >> I64{3}
    head: wrapping(I64{6} + text_words)
    size: wrapping(wrapping(head + PERF_SAMPLES_STACK_DEPTH) * I64{8})
    record: jet_rt_alloc(size, I64{8})
    rt_text_store(wrapping(record + I64{8}), slot)
    rt_text_store(wrapping(record + I64{16}), start)
    rt_text_store(wrapping(record + I64{24}), end)
    rt_text_store(wrapping(record + I64{32}), object)
    rt_text_store(wrapping(record + I64{40}), length | (own << I64{16}) | (peer << I64{32}))
    if (text_words != I64{0}) {
        text: wrapping(record + I64{48})
        thread_zero(text, wrapping(text_words * I64{8}))
        if (length != I64{0}) { rt_text_bytes_copy(text, rt_text_data(name), length) }
        if (own != I64{0}) { rt_text_bytes_copy(wrapping(text + length), ends, own) }
        if (peer != I64{0}) {
            rt_text_bytes_copy(wrapping(wrapping(text + length) + own), wrapping(ends + I64{128}), peer)
        }
    }
    if (ends != I64{0}) { jet_rt_free(ends, I64{256}, I64{8}) }
    words: wrapping(head + perf_samples_stack(wrapping(record + wrapping(head * I64{8}))))
    rt_text_store(record, (observe_current_task() & PERF_SAMPLES_ADDRESS_MASK) | (words << PERF_SAMPLES_ADDRESS_BITS) | (PERF_SAMPLES_WAIT << PERF_SAMPLES_KIND_BITS))
    perf_samples_send(fd, record, wrapping(words * I64{8}))
    jet_rt_free(record, size, I64{8})
}

// The socket `descriptor`'s peer's address (getpeername) when `peer` holds,
// else its own (getsockname), as the kernel's sockaddr bytes, at most 110
// of them (a Unix socket's), into the 128 bytes at `into`, whose 4 at 112
// take the length the kernel reports: how many it stored, 0 when the kernel
// names none.
perf_samples_sockaddr: fn(descriptor: I64, peer: Bool, into: I64) -> I64 {
    size: wrapping(into + I64{112})
    net_store_uint(size, I64{4}, I64{110})
    named: host_call(if peer -> I64{52} else -> I64{51}, descriptor, into, size) == I64{0}
    length: if named -> net_load_uint(size, I64{4}) else -> I64{0}
    if (length > I64{110}) -> I64{110} else -> length
}

// The record of a wake of `slot` at `at` on the monotonic clock, read
// before the wake was published, so never later than the end of the wait it
// ends: the waking task's id in place of a sample's program counter, then
// the slot, `at` and the waking stack (perf_samples_stack). `waker` -1 is
// the current task, 0 outside every task (the runtime: an I/O poller, a
// timer); any other is the id of a task whose body has returned (Task.jet
// task_run's wake of its joiner), whose wake keeps no stack: the stack is
// its carrier's.
perf_samples_wake: fn(slot: I64, at: I64, waker: I64) {
    fd: perf_samples_fd
    if (fd < I64{0}) {
        return
    }
    size: wrapping(wrapping(PERF_SAMPLES_STACK_DEPTH + I64{3}) * I64{8})
    record: jet_rt_alloc(size, I64{8})
    rt_text_store(wrapping(record + I64{8}), slot)
    rt_text_store(wrapping(record + I64{16}), at)
    current: waker < I64{0}
    words: if current -> wrapping(perf_samples_stack(wrapping(record + I64{24})) + I64{3}) else -> I64{3}
    id := waker
    if current {
        id = if (scheduler_control_current() == I64{0}) -> I64{0} else -> observe_current_task()
    }
    rt_text_store(record, (id & PERF_SAMPLES_ADDRESS_MASK) | (words << PERF_SAMPLES_ADDRESS_BITS) | (PERF_SAMPLES_WAKE << PERF_SAMPLES_KIND_BITS))
    perf_samples_send(fd, record, wrapping(words * I64{8}))
    jet_rt_free(record, size, I64{8})
}

// The record buffer's count of recorded lock waits blocked now; 0 when the
// start could not map the buffer.
perf_samples_lock_count: fn() -> I64 {
    buffer: perf_samples_buffer
    if (buffer == I64{0}) -> I64{0} else -> wrapping(buffer + wrapping(wrapping(wrapping(PERF_SAMPLES_DEPTH + I64{2}) + PERF_COUNTERS_SLOTS) * I64{8}))
}

// Under `jet perf run`, a task about to block on a Shared value's lock,
// holding the lock's mutex: one more recorded lock wait blocked, and the
// monotonic clock now, for its perf_samples_lock_wait; 0, recording
// nothing, outside `jet perf run` or outside every task.
perf_samples_lock_block: fn() -> I64 {
    count: perf_samples_lock_count()
    if (perf_samples_fd < I64{0} || count == I64{0} || scheduler_control_current() == I64{0}) {
        return I64{0}
    }
    _ := sync_add(count, I64{1})
    time_host_monotonic_i64()
}

// The record of the lock wait perf_samples_lock_block began at `start`
// (none when 0), on the lock's condition word `slot`, which the wait no
// longer holds the mutex of.
perf_samples_lock_wait: fn(slot: I64, start: I64) {
    if (start == I64{0}) {
        return
    }
    _ := sync_add(perf_samples_lock_count(), I64{-1})
    perf_samples_wait(slot, rt_static_text("shared lock"), perf_samples_object(PERF_SAMPLES_OBJECT_LOCK, I64{0}), start)
}

// A Shared value's release, holding its mutex, before it wakes the waiters
// on its condition word: the monotonic clock now, for the release's
// perf_samples_wake once it no longer holds the mutex, while a recorded lock
// wait is blocked; else 0, and the release records nothing. A waiter counts
// itself under the same mutex (perf_samples_lock_block), so none is missed.
perf_samples_lock_release: fn() -> I64 {
    count: perf_samples_lock_count()
    if (perf_samples_fd < I64{0} || count == I64{0} || sync_load(count) == I64{0}) { return I64{0} }
    time_host_monotonic_i64()
}

// Under `jet perf run`, the monotonic clock now, as the start of the file
// or network transfer an I/O leaf is about to make, for its
// perf_samples_io; else 0, and the leaf records nothing.
perf_samples_io_start: fn() -> I64 {
    if (perf_samples_fd < I64{0}) -> I64{0} else -> time_host_monotonic_i64()
}

// The record of one file or network transfer from `start`
// (perf_samples_io_start; none when 0) to now on the monotonic clock: the
// current task's id in place of a sample's program counter, 0 outside
// every task, then `operation` (PERF_SAMPLES_IO_READ or
// PERF_SAMPLES_IO_WRITE, with a socket's peer's address's byte length from
// bit 16, perf_samples_io_peer) with the target's `class`
// (PERF_SAMPLES_TARGET_*) above its low 8 bits, the start, the end, `result`
// (the bytes moved, or the negated errno the kernel refused it with), the
// target's byte length, the target in whole words (`length` bytes at
// `target`, at most PERF_SAMPLES_IO_TARGET of them; for
// PERF_SAMPLES_TARGET_FD, `target` is the descriptor's number, one word),
// then the transferring stack (perf_samples_stack). A try the kernel turned
// away as not ready (EAGAIN) or interrupted (EINTR) moved nothing and
// records nothing: the task's wait for readiness is its own record.
perf_samples_io: fn(start: I64, operation: I64, result: I64, class: I64, target: I64, length: I64) {
    fd: perf_samples_fd
    if (start == I64{0} || fd < I64{0} || result == I64{-11} || result == I64{-4}) {
        return
    }
    end: time_host_monotonic_i64()
    kept: if {
        (class == PERF_SAMPLES_TARGET_FD) -> I64{8}
        (length < I64{0}) -> I64{0}
        (length > PERF_SAMPLES_IO_TARGET) -> PERF_SAMPLES_IO_TARGET
        else -> length
    }
    text_words: wrapping(kept + I64{7}) >> I64{3}
    head: wrapping(I64{6} + text_words)
    size: wrapping(wrapping(head + PERF_SAMPLES_STACK_DEPTH) * I64{8})
    record: jet_rt_alloc(size, I64{8})
    rt_text_store(wrapping(record + I64{8}), operation | (class << I64{8}))
    rt_text_store(wrapping(record + I64{16}), start)
    rt_text_store(wrapping(record + I64{24}), end)
    rt_text_store(wrapping(record + I64{32}), result)
    rt_text_store(wrapping(record + I64{40}), kept)
    if (text_words != I64{0}) {
        text: wrapping(record + I64{48})
        thread_zero(text, wrapping(text_words * I64{8}))
        if {
            (class == PERF_SAMPLES_TARGET_FD) -> rt_text_store(text, target)
            else -> rt_text_bytes_copy(text, target, kept)
        }
    }
    words: wrapping(head + perf_samples_stack(wrapping(record + wrapping(head * I64{8}))))
    id: if (scheduler_control_current() == I64{0}) -> I64{0} else -> observe_current_task()
    rt_text_store(record, (id & PERF_SAMPLES_ADDRESS_MASK) | (words << PERF_SAMPLES_ADDRESS_BITS) | (PERF_SAMPLES_IO << PERF_SAMPLES_KIND_BITS))
    perf_samples_send(fd, record, wrapping(words * I64{8}))
    jet_rt_free(record, size, I64{8})
}

// The record of a transfer on the FD72 `state` (HostFiles.jet), from
// `start`: its target the path the program opened it by, else its
// descriptor's number.
perf_samples_io_file: fn(start: I64, operation: I64, result: I64, state: I64) {
    if (start == I64{0}) {
        return
    }
    path: fd_word(state, I64{24})
    if (path == I64{0}) {
        perf_samples_io(start, operation, result, PERF_SAMPLES_TARGET_FD, fd_word(state, I64{8}), I64{8})
        return
    }
    perf_samples_io(start, operation, result, PERF_SAMPLES_TARGET_PATH, rt_text_data(path), rt_text_len(path))
}

// The record of a transfer on the connected socket `state` (HostSockets.jet),
// from `start`: its target the peer's address as getpeername gives it, then
// the socket's own as getsockname gives it, either empty when the kernel
// names none, the peer's byte length in the operation's bits from 16.
perf_samples_io_peer: fn(start: I64, operation: I64, result: I64, state: I64) {
    if (start == I64{0} || result == I64{-11} || result == I64{-4}) {
        return
    }
    // The peer's address, then the socket's own fetched 256 bytes on and
    // moved to follow it.
    scratch: jet_rt_alloc(I64{384}, I64{8})
    descriptor: fd_word(state, I64{8})
    peer: perf_samples_sockaddr(descriptor, true, scratch)
    own: perf_samples_sockaddr(descriptor, false, wrapping(scratch + I64{256}))
    if (own != I64{0}) {
        rt_text_bytes_copy(wrapping(scratch + peer), wrapping(scratch + I64{256}), own)
    }
    perf_samples_io(start, operation | (peer << I64{16}), result, PERF_SAMPLES_TARGET_SOCKET, scratch, wrapping(peer + own))
    jet_rt_free(scratch, I64{384}, I64{8})
}

// The lenses JET_PERF_LENSES names, comma-separated (perf_samples_lens);
// `cpu` alone when it is unset.
perf_samples_lenses: fn() -> I64 {
    value: rt_env_get(env_name_jet_perf_lenses())
    if (value == I64{0}) { return PERF_LENS_CPU }
    len: rt_text_len(value)
    data: rt_text_data(value)
    lenses := I64{0}
    start := I64{0}
    loop start <= len {
        end := start
        loop end < len && rt_text_byte(wrapping(data + end)) != (I64{44}) {
            end = wrapping(end + I64{1})
        }
        lenses = lenses | perf_samples_lens(wrapping(data + start), wrapping(end - start))
        start = wrapping(end + I64{1})
    }
    jet_rt_string_drop(value)
    lenses
}

// The lens bit the `length` bytes at `item` name, 0 for none.
perf_samples_lens: fn(item: I64, length: I64) -> I64 {
    if (length == I64{3} && rt_text_equal_bytes(item, rt_text_data(rt_static_text("cpu")), I64{3})) {
        return PERF_LENS_CPU
    }
    if (length == I64{6} && rt_text_equal_bytes(item, rt_text_data(rt_static_text("memory")), I64{6})) {
        return PERF_LENS_MEMORY
    }
    if (length == I64{5} && rt_text_equal_bytes(item, rt_text_data(rt_static_text("alloc")), I64{5})) {
        return PERF_LENS_ALLOC
    }
    if (length == I64{6} && rt_text_equal_bytes(item, rt_text_data(rt_static_text("causal")), I64{6})) {
        return PERF_LENS_CAUSAL
    }
    if (length == I64{7} && rt_text_equal_bytes(item, rt_text_data(rt_static_text("topdown")), I64{7})) {
        return PERF_LENS_TOPDOWN
    }
    I64{0}
}

// `<samples>.counters` when `lenses` hold the memory lens, else -1.
perf_counters_open: fn(samples: I64, lenses: I64) -> I64 {
    if ((lenses & PERF_LENS_MEMORY) == I64{0}) { return I64{-1} }
    perf_samples_open_beside(samples, rt_static_text(".counters"))
}

// The perf_event_attr type, config and sample period of counter `index`:
// L1D, LLC and dTLB read misses (PERF_TYPE_HW_CACHE, the cache's id | read
// << 8 | miss << 16), then page faults (PERF_TYPE_SOFTWARE PAGE_FAULTS).
// The periods are primes, so that a sample does not keep landing on the
// same iteration of a loop.
perf_counter_type: fn(index: I64) -> I64 {
    if (index == I64{3}) { return I64{1} }
    I64{3}
}

perf_counter_config: fn(index: I64) -> I64 {
    if (index == I64{0}) { return I64{65536} }
    if (index == I64{1}) { return I64{65538} }
    if (index == I64{2}) { return I64{65539} }
    I64{2}
}

perf_counter_period: fn(index: I64) -> I64 {
    if (index == I64{0}) { return I64{10007} }
    if (index == I64{3}) { return I64{1} }
    I64{1009}
}

// The raw event (PERF_TYPE_RAW) that counts LLC read misses where the
// kernel has no generic one: on AMD family 19h and later (Zen 3, 4 and 5),
// whose core PMU refuses the generic event with ENOENT, event 0x43
// (ls_dmnd_fills_from_sys) with every source past the core's own L2 and L3
// in its unit mask (0xFC): the demand data-cache fills from another CCX's
// cache or from DRAM, each a demand read that missed the LLC. 0 on any
// other CPU. "AuthenticAMD" is CPUID.0's EBX, EDX, ECX: "Auth", "enti",
// "cAMD".
perf_counter_llc_raw: fn() -> I64 {
    #Unsafe("cpuid only reports processor identification") {
        amd: os_cpuid_ebx_i64(I64{0}, I64{0}) == I64{1752462657} && os_cpuid_edx_i64(I64{0}, I64{0}) == I64{1769238117} && os_cpuid_ecx_i64(I64{0}, I64{0}) == I64{1145913699}
        if (!amd) { return I64{0} }
        signature: os_cpuid_eax_i64(I64{1}, I64{0})
        family: wrapping(((signature >> I64{8}) & I64{15}) + ((signature >> I64{20}) & I64{255}))
        if (family < I64{25}) { return I64{0} }
    }
    I64{64579}
}

// The counters' descriptors in the record buffer `buffer`.
perf_counters_table: fn(buffer: I64) -> I64 {
    wrapping(buffer + wrapping(wrapping(PERF_SAMPLES_DEPTH + I64{1}) * I64{8}))
}

// Open and arm each counter on this thread, the handler installed for
// PERF_COUNTERS_SIGNAL first, and write each one's period or errno to
// `file` (`<samples>.counters`, or -1 when none was asked for). A buffer
// that could not be mapped leaves every counter unavailable (ENOMEM). The
// start holds the record buffer meanwhile, as a handler does, since it
// builds each counter's attribute words in it.
perf_counters_start: fn(buffer: I64, file: I64) {
    if (file < I64{0}) {
        return
    }
    status := I64{-12}
    if (buffer != I64{0}) {
        #Unsafe("rt_sigaction borrows the four-word action on the stack; the handler is this runtime's three-word C-ABI export and the restorer its rt_sigreturn rail") {
            status = os_syscall_stack4_i64(I64{13}, PERF_COUNTERS_SIGNAL, rt_perf_samples_signal_address(), I64{469762052}, rt_process_signal_restore_address(), I64{0}, I64{8})
        }
    }
    if (status >= I64{0}) {
        loop {
            if (sync_cas(buffer, I64{0}, I64{1}) == I64{0}) { break }
        }
    }
    tid: thread_tid()
    index := I64{0}
    loop index < PERF_COUNTERS_COUNT {
        result := status
        if (status >= I64{0}) { result = perf_counter_arm(buffer, index, tid) }
        period := I64{0}
        errno := I64{0}
        if (result >= I64{0}) { period = perf_counter_period(index) } else {
            errno = wrapping(I64{0} - result)
        }
        #Unsafe("two writes of a stack-local word, which the kernel copies before each call returns") {
            _ := os_write_word_i64(file, period, I64{8})
            _ := os_write_word_i64(file, errno, I64{8})
        }
        index = wrapping(index + I64{1})
    }
    if (status >= I64{0}) { sync_store(buffer, I64{0}) }
    _ := host_call(I64{3}, file, I64{0}, I64{0})
}

// Open counter `index` on this thread (`tid`), its attribute words built in
// `buffer`, and attach it (perf_counter_attach). An LLC counter the kernel
// has no generic event for (ENOENT) opens the CPU's raw one instead, where
// perf_counter_llc_raw knows it. 0, or the negated errno of the call the
// kernel refused.
perf_counter_arm: fn(buffer: I64, index: I64, tid: I64) -> I64 {
    attr: wrapping(buffer + I64{8})
    fd := perf_counter_event_open(attr, perf_counter_type(index), perf_counter_config(index), perf_counter_period(index), I64{0})
    if (fd == I64{-2} && index == I64{1}) {
        raw: perf_counter_llc_raw()
        if (raw != I64{0}) {
            fd = perf_counter_event_open(attr, I64{4}, raw, perf_counter_period(index), I64{0})
        }
    }
    if (fd < I64{0}) { return fd }
    perf_counter_attach(buffer, index, fd, tid)
}

// Have counter descriptor `fd` signal thread `tid` at each overflow and arm
// it for its first period, its descriptor in slot `index` of the table
// before it is armed; the held `buffer` keeps the f_owner_ex. A counter
// the kernel refuses any of that for is closed. 0, or the negated errno of
// the call the kernel refused.
perf_counter_attach: fn(buffer: I64, index: I64, fd: I64, tid: I64) -> I64 {
    result := perf_event_signal(fd, PERF_COUNTERS_SIGNAL, wrapping(buffer + I64{8}), tid)
    slot: wrapping(perf_counters_table(buffer) + wrapping(index * I64{8}))
    if (result >= I64{0}) {
        rt_text_store(slot, fd)
        result = perf_counter_refresh(fd)
    }
    if (result < I64{0}) {
        rt_text_store(slot, I64{-1})
        _ := host_call(I64{3}, fd, I64{0}, I64{0})
        return result
    }
    I64{0}
}

// Have perf event `fd` signal thread `tid` with `signal` at each overflow,
// its descriptor in the siginfo: fcntl F_SETFL O_ASYNC, F_SETSIG `signal`,
// then F_SETOWN_EX with the f_owner_ex {F_OWNER_TID, tid}, built in the
// word at `owner`. 0, or the negated errno of the call the kernel refused.
perf_event_signal: fn(fd: I64, signal: I64, owner: I64, tid: I64) -> I64 {
    result := I64{0}
    #Unsafe("fcntl reads the two-word f_owner_ex built at `owner`") {
        result = os_syscall_i64(I64{72}, fd, I64{4}, I64{8192}, I64{0}, I64{0}, I64{0})
        if (result >= I64{0}) {
            result = os_syscall_i64(I64{72}, fd, I64{10}, signal, I64{0}, I64{0}, I64{0})
        }
        if (result >= I64{0}) {
            rt_text_store(owner, tid << I64{32})
            result = os_syscall_i64(I64{72}, fd, I64{15}, owner, I64{0}, I64{0}, I64{0})
        }
    }
    result
}

// perf_event_open of the counter of type `kind`, `config` and `period` on
// this thread, any CPU, no group, PERF_FLAG_FD_CLOEXEC, its attribute words
// built at `attr`: perf_event_attr's first 64 bytes (PERF_ATTR_SIZE_VER0),
// its type and size, config, sample_period, sample_type and read_format
// (`format`), then its flags, disabled | exclude_kernel | exclude_hv, the
// rest zero. Its descriptor, or the negated errno.
perf_counter_event_open: fn(attr: I64, kind: I64, config: I64, period: I64, format: I64) -> I64 {
    rt_text_store(attr, kind | (I64{64} << I64{32}))
    rt_text_store(wrapping(attr + I64{8}), config)
    rt_text_store(wrapping(attr + I64{16}), period)
    rt_text_store(wrapping(attr + I64{24}), I64{0})
    rt_text_store(wrapping(attr + I64{32}), format)
    rt_text_store(wrapping(attr + I64{40}), I64{97})
    rt_text_store(wrapping(attr + I64{48}), I64{0})
    rt_text_store(wrapping(attr + I64{56}), I64{0})
    #Unsafe("perf_event_open reads the attribute words the held buffer keeps") {
        return os_syscall_i64(I64{298}, attr, I64{0}, I64{-1}, I64{-1}, I64{8}, I64{0})
    }
}

// Arm counter descriptor `fd` for one more overflow (PERF_EVENT_IOC_REFRESH
// 1): at it the kernel disables the counter and signals the thread.
perf_counter_refresh: fn(fd: I64) -> I64 {
    #Unsafe("ioctl PERF_EVENT_IOC_REFRESH takes its count as a word") {
        return os_syscall_i64(I64{16}, fd, I64{9218}, I64{1}, I64{0}, I64{0}, I64{0})
    }
}

// Arm counter `counter` (a slot of the table, or -1 for a CPU-time sample)
// for its next period, after the handler wrote its sample.
perf_counter_rearm: fn(buffer: I64, counter: I64) {
    if (counter < I64{0}) {
        return
    }
    _ := perf_counter_refresh(rt_text_word(wrapping(perf_counters_table(buffer) + wrapping(counter * I64{8}))))
}

// The table slot of the counter whose overflow `info` reports (a siginfo of
// si_code POLL_IN..POLL_HUP, si_fd at 24 a counter's descriptor), or -1.
perf_counter_of: fn(info: I64, buffer: I64) -> I64 {
    if (info == I64{0} || buffer == I64{0}) { return I64{-1} }
    code: rt_text_word(wrapping(info + I64{8})) & I64{4294967295}
    if (code < I64{1} || code > I64{6}) { return I64{-1} }
    fd: rt_text_word(wrapping(info + I64{24})) & I64{4294967295}
    table: perf_counters_table(buffer)
    index := I64{0}
    loop index < PERF_COUNTERS_SLOTS {
        if (rt_text_word(wrapping(table + wrapping(index * I64{8}))) == fd) { return index }
        index = wrapping(index + I64{1})
    }
    I64{-1}
}

// The top-down formulas the topdown lens knows, by the
// CPU's model: AMD Zen 4 (family 19h, models 10h-1Fh, 60h-7Fh and A0h-AFh)
// and Zen 5 (family 1Ah, models below 80h), whose six and eight dispatch
// slots a cycle the same events count; Intel's Golden Cove cores alone
// (Sapphire and Emerald Rapids, family 6 models 8Fh and CFh); Alder and
// Raptor Lake's two core types (models 97h, 9Ah, B7h, BAh and BFh), each
// with its own events on its own PMU; and Gracemont cores alone (Alder
// Lake-N, model BEh). Any other CPU, and any virtual machine, whose
// counters are not the hardware's, has none (0). JetCLI
// CLI/Perf/Topdown.jet holds the formulas over each table's events.
PERF_TOPDOWN_ZEN4: I64{1}

PERF_TOPDOWN_ZEN5: I64{2}

PERF_TOPDOWN_GOLDEN_COVE: I64{3}

PERF_TOPDOWN_HYBRID: I64{4}

PERF_TOPDOWN_GRACEMONT: I64{5}

// The CPU's vendor (perf_topdown_vendor).
PERF_TOPDOWN_AMD: I64{1}

PERF_TOPDOWN_INTEL: I64{2}

// The events of a Golden Cove or Gracemont table; Zen's has twelve.
PERF_TOPDOWN_CORE_EVENTS: I64{9}

// `<samples>.topdown` when `lenses` hold the topdown lens, else -1.
perf_topdown_open: fn(samples: I64, lenses: I64) -> I64 {
    if ((lenses & PERF_LENS_TOPDOWN) == I64{0}) { return I64{-1} }
    perf_samples_open_beside(samples, rt_static_text(".topdown"))
}

// The CPU's vendor by CPUID.0's EBX, EDX and ECX: PERF_TOPDOWN_AMD for
// "AuthenticAMD", PERF_TOPDOWN_INTEL for "GenuineIntel", else 0.
perf_topdown_vendor: fn() -> I64 {
    #Unsafe("cpuid only reports processor identification") {
        ebx: os_cpuid_ebx_i64(I64{0}, I64{0})
        edx: os_cpuid_edx_i64(I64{0}, I64{0})
        ecx: os_cpuid_ecx_i64(I64{0}, I64{0})
        if (ebx == I64{1752462657} && edx == I64{1769238117} && ecx == I64{1145913699}) {
            return PERF_TOPDOWN_AMD
        }
        if (ebx == I64{1970169159} && edx == I64{1231384169} && ecx == I64{1818588270}) {
            return PERF_TOPDOWN_INTEL
        }
    }
    I64{0}
}

// The formulas of `vendor`'s CPU whose CPUID.1 EAX is `signature`, 0 for
// none: its family is the base family plus, for base family Fh, the
// extended one; its model the base model plus, for families 6 and Fh, the
// extended model's four bits above it.
perf_topdown_set: fn(vendor: I64, signature: I64, hypervisor: Bool) -> I64 {
    if (hypervisor) { return I64{0} }
    base: (signature >> I64{8}) & I64{15}
    family: if (base == I64{15}) -> wrapping(base + ((signature >> I64{20}) & I64{255})) else -> base
    extended: if (base == I64{6} || base == I64{15}) -> ((signature >> I64{16}) & I64{15}) << I64{4} else -> I64{0}
    model: ((signature >> I64{4}) & I64{15}) | extended
    if (vendor == PERF_TOPDOWN_AMD && family == I64{25}) {
        if ((model >= I64{16} && model < I64{32}) || (model >= I64{96} && model < I64{128}) || (model >= I64{160} && model < I64{176})) {
            return PERF_TOPDOWN_ZEN4
        }
    }
    if (vendor == PERF_TOPDOWN_AMD && family == I64{26} && model < I64{128}) {
        return PERF_TOPDOWN_ZEN5
    }
    if (vendor == PERF_TOPDOWN_INTEL && family == I64{6}) {
        if (model == I64{143} || model == I64{207}) { return PERF_TOPDOWN_GOLDEN_COVE }
        if (model == I64{151} || model == I64{154} || model == I64{183} || model == I64{186} || model == I64{191}) {
            return PERF_TOPDOWN_HYBRID
        }
        if (model == I64{190}) { return PERF_TOPDOWN_GRACEMONT }
    }
    I64{0}
}

// The events formulas `set` takes: Zen's table, one core type's, or on a
// hybrid chip Golden Cove's then Gracemont's.
perf_topdown_events: fn(set: I64) -> I64 {
    if (set == PERF_TOPDOWN_ZEN4 || set == PERF_TOPDOWN_ZEN5) { return I64{12} }
    if (set == PERF_TOPDOWN_GOLDEN_COVE || set == PERF_TOPDOWN_GRACEMONT) {
        return PERF_TOPDOWN_CORE_EVENTS
    }
    if (set == PERF_TOPDOWN_HYBRID) { return wrapping(PERF_TOPDOWN_CORE_EVENTS * I64{2}) }
    I64{0}
}

// The table event `index` of `set` is a row of: Zen 4's or Zen 5's,
// PERF_TOPDOWN_GOLDEN_COVE or PERF_TOPDOWN_GRACEMONT.
perf_topdown_table: fn(set: I64, index: I64) -> I64 {
    if (set == PERF_TOPDOWN_HYBRID) {
        return if (index < PERF_TOPDOWN_CORE_EVENTS) -> PERF_TOPDOWN_GOLDEN_COVE else -> PERF_TOPDOWN_GRACEMONT
    }
    set
}

// The config of row `row` of `table`, a raw event: its event select's low
// byte, its unit mask from bit 8 and its counter mask from bit 24, and on
// AMD the event select's high nibble from bit 32.
// Zen: ls_not_halted_cyc (76h); de_no_dispatch_per_slot (1A0h) of
// no_ops_from_frontend (01h), backend_stalls (1Eh) and smt_contention
// (60h); de_src_op_disp.all (AAh 07h); ex_ret_ops (C1h); the cycles
// the frontend dispatched no op at all (1A0h 01h, counter mask 6 on Zen 4
// and 8 on Zen 5, its dispatch width);
// ex_ret_brn_misp (C3h); resyncs_or_nc_redirects (96h);
// ex_no_retire.load_not_complete (D6h A2h) and .not_complete (D6h 02h);
// ex_ret_ucode_ops (1C1h).
// Golden Cove: TOPDOWN.SLOTS_P (A4h 01h); IDQ_BUBBLES.CORE (9Ch 01h);
// TOPDOWN.BAD_SPEC_SLOTS (A4h 04h); TOPDOWN.BACKEND_BOUND_SLOTS (A4h 02h);
// UOPS_RETIRED.SLOTS (C2h 02h); IDQ_BUBBLES.CYCLES_0_UOPS_DELIV.CORE (9Ch
// 01h, counter mask 6); TOPDOWN.BR_MISPREDICT_SLOTS (A4h 08h);
// TOPDOWN.MEMORY_BOUND_SLOTS (A4h 10h); UOPS_RETIRED.HEAVY (C2h 01h).
// Gracemont: CPU_CLK_UNHALTED.CORE_P (3Ch); TOPDOWN_FE_BOUND.ALL (71h);
// TOPDOWN_BAD_SPECULATION.ALL (73h); TOPDOWN_BE_BOUND.ALL (74h);
// TOPDOWN_RETIRING.ALL (C2h); TOPDOWN_FE_BOUND.FRONTEND_LATENCY (71h 72h);
// TOPDOWN_BAD_SPECULATION.MISPREDICT (73h 04h);
// TOPDOWN_BE_BOUND.ALLOC_RESTRICTIONS (74h 01h); UOPS_RETIRED.MS (C2h 01h).
perf_topdown_config: fn(table: I64, row: I64) -> I64 {
    if (table == PERF_TOPDOWN_GOLDEN_COVE) {
        if (row == I64{0}) { return I64{420} }
        if (row == I64{1}) { return I64{412} }
        if (row == I64{2}) { return I64{1188} }
        if (row == I64{3}) { return I64{676} }
        if (row == I64{4}) { return I64{706} }
        if (row == I64{5}) { return I64{100663708} }
        if (row == I64{6}) { return I64{2212} }
        if (row == I64{7}) { return I64{4260} }
        return I64{450}
    }
    if (table == PERF_TOPDOWN_GRACEMONT) {
        if (row == I64{0}) { return I64{60} }
        if (row == I64{1}) { return I64{113} }
        if (row == I64{2}) { return I64{115} }
        if (row == I64{3}) { return I64{116} }
        if (row == I64{4}) { return I64{194} }
        if (row == I64{5}) { return I64{29297} }
        if (row == I64{6}) { return I64{1139} }
        if (row == I64{7}) { return I64{372} }
        return I64{450}
    }
    if (row == I64{0}) { return I64{118} }
    if (row == I64{1}) { return I64{4294967712} }
    if (row == I64{2}) { return I64{4294975136} }
    if (row == I64{3}) { return I64{4294992032} }
    if (row == I64{4}) { return I64{1962} }
    if (row == I64{5}) { return I64{193} }
    if (row == I64{6}) {
        return if (table == PERF_TOPDOWN_ZEN5) -> I64{4429185440} else -> I64{4395631008}
    }
    if (row == I64{7}) { return I64{195} }
    if (row == I64{8}) { return I64{150} }
    if (row == I64{9}) { return I64{41686} }
    if (row == I64{10}) { return I64{726} }
    I64{4294967489}
}

// The sample period of row `row` of `table`, a prime by how often the
// event counts: a cycle's events once per million cycles, a slot's
// once per six million slots (five on Gracemont), stall cycles and memory
// slots once per 200003, mispredicts, heavy and microcode ops once per
// 20011, and Zen's pipeline restarts once per 2003.
perf_topdown_period: fn(table: I64, row: I64) -> I64 {
    if (table == PERF_TOPDOWN_ZEN4 || table == PERF_TOPDOWN_ZEN5) {
        if (row == I64{0}) { return I64{1000003} }
        if (row < I64{6}) { return I64{6000011} }
        if (row == I64{7} || row == I64{11}) { return I64{20011} }
        if (row == I64{8}) { return I64{2003} }
        return I64{200003}
    }
    if (row == I64{0} && table == PERF_TOPDOWN_GRACEMONT) { return I64{1000003} }
    if (row < I64{5}) {
        return if (table == PERF_TOPDOWN_GRACEMONT) -> I64{5000011} else -> I64{6000011}
    }
    if (row == I64{6} || row == I64{8}) { return I64{20011} }
    I64{200003}
}

// The PMU type the sysfs file `path` holds (an event source's `type`, its
// decimal number), read into the word at `scratch`; the negated errno of a
// file that can't be opened, ENOENT of one that holds no number.
perf_topdown_pmu: fn(path: I64, scratch: I64) -> I64 {
    name: fd_c_path(path)
    fd: host_call(I64{2}, name, I64{524288}, I64{0})
    fd_c_path_drop(name, path)
    if (fd < I64{0}) { return fd }
    rt_text_store(scratch, I64{0})
    count: host_call(I64{0}, fd, scratch, I64{8})
    _ := host_call(I64{3}, fd, I64{0}, I64{0})
    value := I64{0}
    at := I64{0}
    loop at < count {
        digit: rt_text_byte(wrapping(scratch + at))
        if (digit < I64{48} || digit > I64{57}) { break }
        value = wrapping(wrapping(value * I64{10}) + wrapping(digit - I64{48}))
        at = wrapping(at + I64{1})
    }
    if (at == I64{0}) { return I64{-2} }
    value
}

// Under the topdown lens: write the CPU's formulas (perf_topdown_set), its
// vendor, its CPUID.1 EAX, whether CPUID says a hypervisor runs it and the
// count of the formulas' events to `file` (`<samples>.topdown`, or -1 when
// none was asked for); then open each event on this thread, in user mode,
// to report its count with the time it was enabled and the time it ran,
// sampled once per its period as a counter is, in the table's slots past
// the memory lens's, and write its PMU type, config, period (0 for one the
// kernel refused) and errno. Raw events go to the core PMU (PERF_TYPE_RAW);
// on a hybrid chip each core type's go to its own PMU, the type
// `cpu_core`'s and `cpu_atom`'s sysfs directories name, so each counts
// while the thread runs on that core type. The file stays open for the
// counts at exit (perf_topdown_exit). The start holds the record buffer
// meanwhile, as perf_counters_start does.
perf_topdown_start: fn(buffer: I64, file: I64) {
    if (file < I64{0}) {
        return
    }
    vendor: perf_topdown_vendor()
    signature := I64{0}
    hypervisor := false
    #Unsafe("cpuid only reports processor identification") {
        signature = os_cpuid_eax_i64(I64{1}, I64{0})
        hypervisor = ((os_cpuid_ecx_i64(I64{1}, I64{0}) >> I64{31}) & I64{1}) != I64{0}
    }
    set: perf_topdown_set(vendor, signature, hypervisor)
    count: perf_topdown_events(set)
    #Unsafe("five writes of a stack-local word, which the kernel copies before each call returns") {
        _ := os_write_word_i64(file, set, I64{8})
        _ := os_write_word_i64(file, vendor, I64{8})
        _ := os_write_word_i64(file, signature, I64{8})
        _ := os_write_word_i64(file, if (hypervisor) -> I64{1} else -> I64{0}, I64{8})
        _ := os_write_word_i64(file, count, I64{8})
    }
    status := I64{-12}
    if (buffer != I64{0} && count > I64{0}) {
        #Unsafe("rt_sigaction borrows the four-word action on the stack; the handler is this runtime's three-word C-ABI export and the restorer its rt_sigreturn rail") {
            status = os_syscall_stack4_i64(I64{13}, PERF_COUNTERS_SIGNAL, rt_perf_samples_signal_address(), I64{469762052}, rt_process_signal_restore_address(), I64{0}, I64{8})
        }
    }
    if (status >= I64{0}) {
        loop {
            if (sync_cas(buffer, I64{0}, I64{1}) == I64{0}) { break }
        }
    }
    big := I64{4}
    little := I64{4}
    if (status >= I64{0} && set == PERF_TOPDOWN_HYBRID) {
        // The word past the attribute words reads each type.
        big = perf_topdown_pmu(rt_static_text("/sys/bus/event_source/devices/cpu_core/type"), wrapping(buffer + I64{72}))
        little = perf_topdown_pmu(rt_static_text("/sys/bus/event_source/devices/cpu_atom/type"), wrapping(buffer + I64{72}))
    }
    tid: thread_tid()
    attr: wrapping(buffer + I64{8})
    index := I64{0}
    loop index < count {
        table: perf_topdown_table(set, index)
        row: if (set == PERF_TOPDOWN_HYBRID && index >= PERF_TOPDOWN_CORE_EVENTS) -> wrapping(index - PERF_TOPDOWN_CORE_EVENTS) else -> index
        kind := I64{4}
        if (set == PERF_TOPDOWN_HYBRID) {
            kind = if (table == PERF_TOPDOWN_GRACEMONT) -> little else -> big
        }
        config: perf_topdown_config(table, row)
        period: perf_topdown_period(table, row)
        result := status
        if (result >= I64{0} && kind < I64{0}) { result = kind }
        if (result >= I64{0}) {
            // read_format TOTAL_TIME_ENABLED | TOTAL_TIME_RUNNING.
            fd: perf_counter_event_open(attr, kind, config, period, I64{3})
            result = if (fd < I64{0}) -> fd else -> perf_counter_attach(buffer, wrapping(PERF_COUNTERS_COUNT + index), fd, tid)
        }
        #Unsafe("four writes of a stack-local word, which the kernel copies before each call returns") {
            _ := os_write_word_i64(file, if (kind < I64{0}) -> I64{0} else -> kind, I64{8})
            _ := os_write_word_i64(file, config, I64{8})
            _ := os_write_word_i64(file, if (result < I64{0}) -> I64{0} else -> period, I64{8})
            _ := os_write_word_i64(file, if (result < I64{0}) -> wrapping(I64{0} - result) else -> I64{0}, I64{8})
        }
        index = wrapping(index + I64{1})
    }
    if (status >= I64{0}) { sync_store(buffer, I64{0}) }
    #Unsafe("the observation start runs before the exit that reads these") {
        perf_topdown_fd = file
        perf_topdown_count = count
    }
}

// At exit (perf_samples_exit), under the topdown lens: three words for
// each event in `<samples>.topdown`, its count, the nanoseconds it was
// enabled and the nanoseconds it ran, all 0 for one that is not open; then
// the file is closed. A second exit writes nothing.
perf_topdown_exit: fn() {
    file: perf_topdown_fd
    if (file < I64{0}) {
        return
    }
    #Unsafe("the exit runs on one thread, after the start set these") { perf_topdown_fd = I64{-1} }
    buffer: perf_samples_buffer
    values: jet_rt_alloc(I64{24}, I64{8})
    index := I64{0}
    loop index < perf_topdown_count {
        fd: if (buffer == I64{0}) -> I64{-1} else -> rt_text_word(wrapping(perf_counters_table(buffer) + wrapping(wrapping(PERF_COUNTERS_COUNT + index) * I64{8})))
        read: if (fd < I64{0}) -> I64{0} else -> host_call(I64{0}, fd, values, I64{24})
        if (read != I64{24}) {
            rt_text_store(values, I64{0})
            rt_text_store(wrapping(values + I64{8}), I64{0})
            rt_text_store(wrapping(values + I64{16}), I64{0})
        }
        _ := host_write_all(file, values, I64{24})
        index = wrapping(index + I64{1})
    }
    jet_rt_free(values, I64{24}, I64{8})
    _ := host_call(I64{3}, file, I64{0}, I64{0})
}

// Checked FunctionAddress intrinsic in the canonical RuntimeLibrary table.
rt_perf_samples_signal_address: fn() -> I64 {
    loop { jet_rt_unreachable(I64{0}, I64{0}) }
}

// The first byte (`end` false) or the end (`end` true) of the executable
// segments (PT_LOAD with PF_X) of the ELF64 file `image` (alloc_check_image,
// a read-only mapping of the whole file, its program header table inside
// it), as link-time addresses; 0 when it has none. A `jet run` image keeps
// the program's code in a segment of its own after the runtime's, so the
// code is every such segment, not the first.
perf_samples_code_edge: fn(image: I64, end: Bool) -> I64 {
    if (image == I64{0}) { return I64{0} }
    // e_phoff; e_phentsize is bits 48..63 of the word at 48, e_phnum bits
    // 0..15 of the word at 56.
    table: rt_text_word(wrapping(image + I64{32}))
    entry: (rt_text_word(wrapping(image + I64{48})) >> I64{48}) & I64{65535}
    count: rt_text_word(wrapping(image + I64{56})) & I64{65535}
    edge := I64{0}
    index := I64{0}
    loop index < count {
        header: wrapping(image + wrapping(table + wrapping(index * entry)))
        kind: rt_text_word(header)
        if (kind & I64{4294967295} == I64{1} && (kind >> I64{32}) & I64{1} != I64{0}) {
            // p_vaddr and p_memsz of the program header.
            start: rt_text_word(wrapping(header + I64{16}))
            if (end) {
                last: wrapping(start + rt_text_word(wrapping(header + I64{40})))
                if (last > edge) { edge = last }
            } else if (edge == I64{0} || start < edge) { edge = start }
        }
        index = wrapping(index + I64{1})
    }
    edge
}

// Whether link-time address `address` is in the image's code.
perf_samples_in_code: fn(address: I64) -> Bool {
    address >= perf_samples_code_low && address < perf_samples_code_high
}

// Code without a frame pointer chain (an O2 leaf like the stop poll, the
// frame-free prefix before a function's `push rbp`, a C library function)
// unwinds by the image's call frame information (.eh_frame), which the
// backend writes for every Jet function and the C objects bring with
// theirs. The start reads each FDE into a table of [begin, end) link-time
// ranges and the FDE's address in the image mapping, sorted by begin; the
// handler finds the sample's FDE, runs its CIE's and its own rules up to the
// address, and steps out through rsp-based frames until a frame keeps rbp,
// where the frame pointer walk takes over. 0 when the image has none.
perf_cfi_table := I64{0}

perf_cfi_count := I64{0}

// One page the start reads the call frame information in, then the scratch
// of the handler that holds perf_samples_buffer; each of perf_samples_slots
// has PERF_CFI_SCRATCH_BYTES of its own (perf_samples_scratch).
perf_cfi_scratch := I64{0}

// The scratch page's words: the read cursor, the CIE's code and data
// alignment, return address column and pointer encoding, whether it has
// augmentation data ('z'), then the rule row (CFA register and offset, rbp's
// and the return address's rule and offset), the CIE's initial rbp and
// return address rules (DW_CFA_restore), and the remember stack's depth and
// rows.
PERF_CFI_CURSOR: I64{0}

PERF_CFI_CODE_ALIGN: I64{8}

PERF_CFI_DATA_ALIGN: I64{16}

PERF_CFI_RA_COLUMN: I64{24}

PERF_CFI_ENCODING: I64{32}

PERF_CFI_AUGMENTED: I64{40}

PERF_CFI_ROW: I64{48}

PERF_CFI_CFA_REG: I64{48}

PERF_CFI_CFA_OFFSET: I64{56}

PERF_CFI_RBP_RULE: I64{64}

PERF_CFI_RBP_OFFSET: I64{72}

PERF_CFI_RA_RULE: I64{80}

PERF_CFI_RA_OFFSET: I64{88}

PERF_CFI_INITIAL: I64{96}

PERF_CFI_DEPTH: I64{128}

PERF_CFI_STACK: I64{136}

// A rule row's bytes, and the most rows DW_CFA_remember_state keeps.
PERF_CFI_ROW_BYTES: I64{48}

PERF_CFI_STACK_ROWS: I64{4}

// The scratch bytes the handler interprets rules in: through the remember
// stack's last row, PERF_CFI_STACK plus PERF_CFI_STACK_ROWS rows.
PERF_CFI_SCRATCH_BYTES: I64{328}

// A register's rule: unchanged from the caller (same value), saved at CFA +
// offset, or one the unwinder cannot follow.
PERF_CFI_SAME: I64{0}

PERF_CFI_SAVED: I64{1}

PERF_CFI_UNKNOWN: I64{2}

// The DWARF x86-64 numbers of rbp and rsp.
PERF_CFI_RBP: I64{6}

PERF_CFI_RSP: I64{7}

// A pointer the unwinder cannot decode.
PERF_CFI_BAD: I64{-1}

// A side's rule rows (perf_cfi_cached): how many, the bytes of each, and
// the offset of each one's copy of a rule row.
PERF_CFI_CACHE_ROWS: I64{256}

PERF_CFI_CACHE_ROW_BYTES: I64{72}

PERF_CFI_CACHED: I64{24}

perf_cfi_u16: fn(at: I64) -> I64 {
    rt_text_byte(at) | (rt_text_byte(wrapping(at + I64{1})) << I64{8})
}

perf_cfi_u32: fn(at: I64) -> I64 {
    perf_cfi_u16(at) | (perf_cfi_u16(wrapping(at + I64{2})) << I64{16})
}

perf_cfi_u64: fn(at: I64) -> I64 {
    perf_cfi_u32(at) | (perf_cfi_u32(wrapping(at + I64{4})) << I64{32})
}

// The byte at the scratch page's cursor, which moves past it.
perf_cfi_byte: fn(scratch: I64) -> I64 {
    at: rt_text_word(scratch)
    rt_text_store(scratch, wrapping(at + I64{1}))
    rt_text_byte(at)
}

// The unsigned (`signed` false) or signed LEB128 number at the cursor.
perf_cfi_leb: fn(scratch: I64, signed: Bool) -> I64 {
    value := I64{0}
    shift := I64{0}
    byte := I64{0}
    more := true
    loop more {
        byte = perf_cfi_byte(scratch)
        if (shift < I64{64}) { value = value | ((byte & I64{127}) << shift) }
        shift = wrapping(shift + I64{7})
        more = byte & I64{128} != I64{0}
    }
    if (signed && shift < I64{64} && byte & I64{64} != I64{0}) {
        value = value | wrapping(I64{0} - (I64{1} << shift))
    }
    value
}

// The bytes a pointer in `encoding` takes: its low four bits; 0 for a
// format the unwinder does not read.
perf_cfi_pointer_size: fn(encoding: I64) -> I64 {
    format: encoding & I64{15}
    if {
        (format == I64{0} || format == I64{4} || format == I64{12}) -> I64{8}
        (format == I64{3} || format == I64{11}) -> I64{4}
        (format == I64{2} || format == I64{10}) -> I64{2}
        else -> I64{0}
    }
}

// The pointer in `encoding` at the cursor, which moves past it: absolute,
// or relative to its own field, whose link-time address is `address` plus
// its distance from `bytes`, the section's first byte in the mapping.
// PERF_CFI_BAD for an encoding the unwinder does not read.
perf_cfi_pointer: fn(scratch: I64, encoding: I64, bytes: I64, address: I64) -> I64 {
    at: rt_text_word(scratch)
    size: perf_cfi_pointer_size(encoding)
    if (size == I64{0}) { return PERF_CFI_BAD }
    format: encoding & I64{15}
    value := if {
        (size == I64{8}) -> perf_cfi_u64(at)
        (size == I64{4}) -> perf_cfi_u32(at)
        else -> perf_cfi_u16(at)
    }
    if (format == I64{11} && value >= I64{2147483648}) { value = wrapping(value - I64{4294967296}) }
    if (format == I64{10} && value >= I64{32768}) { value = wrapping(value - I64{65536}) }
    rt_text_store(scratch, wrapping(at + size))
    application: encoding & I64{112}
    if (application == I64{16}) {
        return wrapping(value + wrapping(address + wrapping(at - bytes)))
    }
    if (application != I64{0}) { return PERF_CFI_BAD }
    value
}

// Give register `register` the rule `rule` at CFA + `offset`; only rbp and
// the return address are followed.
perf_cfi_set: fn(scratch: I64, register: I64, rule: I64, offset: I64) {
    at: if {
        (register == PERF_CFI_RBP) -> PERF_CFI_RBP_RULE
        (register == rt_text_word(wrapping(scratch + PERF_CFI_RA_COLUMN))) -> PERF_CFI_RA_RULE
        else -> I64{-1}
    }
    if (at < I64{0}) {
        return
    }
    rt_text_store(wrapping(scratch + at), rule)
    rt_text_store(wrapping(scratch + wrapping(at + I64{8})), offset)
}

// DW_CFA_restore: register `register` takes its rule after the CIE's
// initial instructions back.
perf_cfi_restore: fn(scratch: I64, register: I64) {
    initial: wrapping(scratch + PERF_CFI_INITIAL)
    if {
        (register == PERF_CFI_RBP) -> {
            perf_cfi_set(scratch, register, rt_text_word(initial), rt_text_word(wrapping(initial + I64{8})))
        }
        else -> {
            perf_cfi_set(scratch, register, rt_text_word(wrapping(initial + I64{16})), rt_text_word(wrapping(initial + I64{24})))
        }
    }
}

// Copy one rule row of PERF_CFI_ROW_BYTES from `source` to `target`.
perf_cfi_copy_row: fn(target: I64, source: I64) {
    at := I64{0}
    loop at < PERF_CFI_ROW_BYTES {
        rt_text_store(wrapping(target + at), rt_text_word(wrapping(source + at)))
        at = wrapping(at + I64{8})
    }
}

// Run the call frame instructions from the cursor to `end`, the first row
// at link-time address `location`, until the row that holds `target`.
// False on an instruction the unwinder does not follow.
perf_cfi_run: fn(scratch: I64, end: I64, location: I64, target: I64) -> Bool {
    code_align: rt_text_word(wrapping(scratch + PERF_CFI_CODE_ALIGN))
    data_align: rt_text_word(wrapping(scratch + PERF_CFI_DATA_ALIGN))
    at := location
    loop rt_text_word(scratch) < end {
        op: perf_cfi_byte(scratch)
        high: op & I64{192}
        low: op & I64{63}
        advance := I64{-1}
        if {
            (high == I64{64}) -> advance = low
            (high == I64{128}) -> perf_cfi_set(scratch, low, PERF_CFI_SAVED, wrapping(perf_cfi_leb(scratch, false) * data_align))
            (high == I64{192}) -> perf_cfi_restore(scratch, low)
            (op == I64{0}) -> {}
            (op == I64{2}) -> advance = perf_cfi_byte(scratch)
            (op == I64{3}) -> {
                advance = perf_cfi_u16(rt_text_word(scratch))
                rt_text_store(scratch, wrapping(rt_text_word(scratch) + I64{2}))
            }
            (op == I64{4}) -> {
                advance = perf_cfi_u32(rt_text_word(scratch))
                rt_text_store(scratch, wrapping(rt_text_word(scratch) + I64{4}))
            }
            (op == I64{5} || op == I64{17} || op == I64{47}) -> {
                // offset_extended, offset_extended_sf, GNU_negative_offset_extended.
                register: perf_cfi_leb(scratch, false)
                factored: perf_cfi_leb(scratch, op == I64{17})
                offset: wrapping(factored * data_align)
                perf_cfi_set(scratch, register, PERF_CFI_SAVED, if (op == I64{47}) -> wrapping(I64{0} - offset) else -> offset)
            }
            (op == I64{6}) -> perf_cfi_restore(scratch, perf_cfi_leb(scratch, false))
            (op == I64{7} || op == I64{9} || op == I64{20} || op == I64{21}) -> {
                // undefined, register, val_offset, val_offset_sf: a rule the
                // unwinder does not follow for rbp or the return address.
                register: perf_cfi_leb(scratch, false)
                if (op != I64{7}) { _ := perf_cfi_leb(scratch, op == I64{21}) }
                perf_cfi_set(scratch, register, PERF_CFI_UNKNOWN, I64{0})
            }
            (op == I64{8}) -> perf_cfi_set(scratch, perf_cfi_leb(scratch, false), PERF_CFI_SAME, I64{0})
            (op == I64{10}) -> {
                depth: rt_text_word(wrapping(scratch + PERF_CFI_DEPTH))
                if (depth >= PERF_CFI_STACK_ROWS) { return false }
                perf_cfi_copy_row(wrapping(scratch + wrapping(PERF_CFI_STACK + wrapping(depth * PERF_CFI_ROW_BYTES))), wrapping(scratch + PERF_CFI_ROW))
                rt_text_store(wrapping(scratch + PERF_CFI_DEPTH), wrapping(depth + I64{1}))
            }
            (op == I64{11}) -> {
                depth: rt_text_word(wrapping(scratch + PERF_CFI_DEPTH))
                if (depth <= I64{0}) { return false }
                perf_cfi_copy_row(wrapping(scratch + PERF_CFI_ROW), wrapping(scratch + wrapping(PERF_CFI_STACK + wrapping(wrapping(depth - I64{1}) * PERF_CFI_ROW_BYTES))))
                rt_text_store(wrapping(scratch + PERF_CFI_DEPTH), wrapping(depth - I64{1}))
            }
            (op == I64{12} || op == I64{18}) -> {
                rt_text_store(wrapping(scratch + PERF_CFI_CFA_REG), perf_cfi_leb(scratch, false))
                offset: if (op == I64{18}) -> wrapping(perf_cfi_leb(scratch, true) * data_align) else -> perf_cfi_leb(scratch, false)
                rt_text_store(wrapping(scratch + PERF_CFI_CFA_OFFSET), offset)
            }
            (op == I64{13}) -> rt_text_store(wrapping(scratch + PERF_CFI_CFA_REG), perf_cfi_leb(scratch, false))
            (op == I64{14}) -> rt_text_store(wrapping(scratch + PERF_CFI_CFA_OFFSET), perf_cfi_leb(scratch, false))
            (op == I64{19}) -> rt_text_store(wrapping(scratch + PERF_CFI_CFA_OFFSET), wrapping(perf_cfi_leb(scratch, true) * data_align))
            (op == I64{15} || op == I64{16} || op == I64{22}) -> {
                // def_cfa_expression, expression, val_expression: the block
                // is skipped and what it computes is not followed.
                register := I64{-1}
                if (op != I64{15}) { register = perf_cfi_leb(scratch, false) }
                length: perf_cfi_leb(scratch, false)
                rt_text_store(scratch, wrapping(rt_text_word(scratch) + length))
                if {
                    (op == I64{15}) -> rt_text_store(wrapping(scratch + PERF_CFI_CFA_REG), I64{-1})
                    else -> perf_cfi_set(scratch, register, PERF_CFI_UNKNOWN, I64{0})
                }
            }
            // GNU_args_size.
            (op == I64{46}) -> { _ := perf_cfi_leb(scratch, false) }
            // set_loc and any other instruction.
            else -> return false
        }
        if (advance >= I64{0}) {
            at = wrapping(at + wrapping(advance * code_align))
            if (at > target) { return true }
        }
    }
    true
}

// Read the CIE at `cie` (its length word) into the scratch page and run its
// initial instructions; the cursor is left past them. False for a CIE the
// unwinder does not read.
perf_cfi_cie: fn(scratch: I64, cie: I64) -> Bool {
    length: perf_cfi_u32(cie)
    if (length == I64{0} || length == I64{4294967295} || perf_cfi_u32(wrapping(cie + I64{4})) != I64{0}) {
        return false
    }
    end: wrapping(cie + wrapping(length + I64{4}))
    version: rt_text_byte(wrapping(cie + I64{8}))
    augmentation: wrapping(cie + I64{9})
    at := augmentation
    loop rt_text_byte(at) != (I64{0}) -> at = wrapping(at + I64{1})
    rt_text_store(scratch, wrapping(at + I64{1}))
    augmented: rt_text_byte(augmentation) == I64{122}
    if (rt_text_byte(augmentation) != I64{0} && !augmented) { return false }
    rt_text_store(wrapping(scratch + PERF_CFI_CODE_ALIGN), perf_cfi_leb(scratch, false))
    rt_text_store(wrapping(scratch + PERF_CFI_DATA_ALIGN), perf_cfi_leb(scratch, true))
    column: if (version == I64{1}) -> perf_cfi_byte(scratch) else -> perf_cfi_leb(scratch, false)
    rt_text_store(wrapping(scratch + PERF_CFI_RA_COLUMN), column)
    encoding := I64{0}
    if (augmented) {
        size: perf_cfi_leb(scratch, false)
        data: rt_text_word(scratch)
        field := data
        letter := wrapping(augmentation + I64{1})
        loop rt_text_byte(letter) != (I64{0}) {
            kind: rt_text_byte(letter)
            // 'R' the FDE pointer encoding, 'P' a personality pointer, 'L'
            // the LSDA encoding; 'S' and 'B' carry no data.
            if {
                (kind == I64{82}) -> {
                    encoding = rt_text_byte(field)
                    field = wrapping(field + I64{1})
                }
                (kind == I64{80}) -> {
                    skip: perf_cfi_pointer_size(rt_text_byte(field))
                    if (skip == I64{0}) { return false }
                    field = wrapping(field + wrapping(skip + I64{1}))
                }
                (kind == I64{76}) -> field = wrapping(field + I64{1})
                (kind != I64{83} && kind != I64{66}) -> return false
                else -> {}
            }
            letter = wrapping(letter + I64{1})
        }
        rt_text_store(scratch, wrapping(data + size))
    }
    rt_text_store(wrapping(scratch + PERF_CFI_ENCODING), encoding)
    rt_text_store(wrapping(scratch + PERF_CFI_AUGMENTED), if (augmented) -> I64{1} else -> I64{0})
    // Until the instructions say otherwise: no CFA, rbp unchanged, the
    // return address unknown.
    rt_text_store(wrapping(scratch + PERF_CFI_CFA_REG), I64{-1})
    rt_text_store(wrapping(scratch + PERF_CFI_CFA_OFFSET), I64{0})
    rt_text_store(wrapping(scratch + PERF_CFI_RBP_RULE), PERF_CFI_SAME)
    rt_text_store(wrapping(scratch + PERF_CFI_RBP_OFFSET), I64{0})
    rt_text_store(wrapping(scratch + PERF_CFI_RA_RULE), PERF_CFI_UNKNOWN)
    rt_text_store(wrapping(scratch + PERF_CFI_RA_OFFSET), I64{0})
    rt_text_store(wrapping(scratch + PERF_CFI_DEPTH), I64{0})
    if (!perf_cfi_run(scratch, end, I64{0}, I64{-1})) { return false }
    initial: wrapping(scratch + PERF_CFI_INITIAL)
    rt_text_store(initial, rt_text_word(wrapping(scratch + PERF_CFI_RBP_RULE)))
    rt_text_store(wrapping(initial + I64{8}), rt_text_word(wrapping(scratch + PERF_CFI_RBP_OFFSET)))
    rt_text_store(wrapping(initial + I64{16}), rt_text_word(wrapping(scratch + PERF_CFI_RA_RULE)))
    rt_text_store(wrapping(initial + I64{24}), rt_text_word(wrapping(scratch + PERF_CFI_RA_OFFSET)))
    true
}

// The rule row at link-time address `address` of the FDE at `fde`, whose
// range starts at `begin`, in the scratch page. False when its CIE or
// instructions are ones the unwinder does not read.
perf_cfi_rule: fn(scratch: I64, fde: I64, begin: I64, address: I64) -> Bool {
    pointer: wrapping(fde + I64{4})
    if (!perf_cfi_cie(scratch, wrapping(pointer - perf_cfi_u32(pointer)))) { return false }
    end: wrapping(fde + wrapping(perf_cfi_u32(fde) + I64{4}))
    // The range's begin and length are the table's; past them, the FDE's
    // augmentation data when its CIE has a 'z'.
    size: perf_cfi_pointer_size(rt_text_word(wrapping(scratch + PERF_CFI_ENCODING)))
    if (size == I64{0}) { return false }
    rt_text_store(scratch, wrapping(fde + wrapping(I64{8} + wrapping(size * I64{2}))))
    if (rt_text_word(wrapping(scratch + PERF_CFI_AUGMENTED)) != I64{0}) {
        skip: perf_cfi_leb(scratch, false)
        rt_text_store(scratch, wrapping(rt_text_word(scratch) + skip))
    }
    perf_cfi_run(scratch, end, begin, address)
}

// The table entry (begin, end, FDE) whose range holds link-time address
// `address`, or 0.
perf_cfi_find: fn(address: I64) -> I64 {
    table: perf_cfi_table
    low := I64{0}
    high := perf_cfi_count
    // The last entry that begins at or below the address.
    loop low < high {
        middle: wrapping(low + ((high - low) >> I64{1}))
        if {
            (rt_text_word(wrapping(table + wrapping(middle * I64{24}))) <= address) -> {
                low = wrapping(middle + I64{1})
            }
            else -> high = middle
        }
    }
    if (low == I64{0}) { return I64{0} }
    entry: wrapping(table + wrapping(wrapping(low - I64{1}) * I64{24}))
    if (address < rt_text_word(wrapping(entry + I64{8}))) -> entry else -> I64{0}
}

// The rule row of link-time address `address` in `rows`, a side's
// PERF_CFI_CACHE_ROWS rows (perf_samples_side_rows), each kept by its
// address: its address plus one, the range of the table entry holding it
// (0 and 0 for none), then the rule row's words from PERF_CFI_CFA_REG on,
// each -1 where the entry has no row the unwinder reads. A row the side
// does not hold yet is interpreted in `scratch` (perf_cfi_rule) into it,
// over whichever address held it before: a handler's samples come back to
// the same few program counters and call sites, so most interpret none.
perf_cfi_cached: fn(rows: I64, scratch: I64, address: I64) -> I64 {
    // The product's top 8 bits, one of the 256 rows.
    index: (wrapping(address * I64{-7046029254386353131}) >> I64{56}) & I64{255}
    row: wrapping(rows + wrapping(index * PERF_CFI_CACHE_ROW_BYTES))
    key: wrapping(address + I64{1})
    if (rt_text_word(row) == key) { return row }
    entry: perf_cfi_find(address)
    begin := I64{0}
    end := I64{0}
    ruled := false
    if (entry != I64{0}) {
        begin = rt_text_word(entry)
        end = rt_text_word(wrapping(entry + I64{8}))
        ruled = perf_cfi_rule(scratch, rt_text_word(wrapping(entry + I64{16})), begin, address)
    }
    rt_text_store(wrapping(row + I64{8}), begin)
    rt_text_store(wrapping(row + I64{16}), end)
    at := I64{0}
    loop at < PERF_CFI_ROW_BYTES {
        word: if (ruled) -> rt_text_word(wrapping(wrapping(scratch + PERF_CFI_ROW) + at)) else -> I64{-1}
        rt_text_store(wrapping(wrapping(row + PERF_CFI_CACHED) + at), word)
        at = wrapping(at + I64{8})
    }
    rt_text_store(row, key)
    row
}

// The rule row of link-time address `address` the walk reads, at the
// offsets it has in a scratch (PERF_CFI_ROW on): `rows`' (perf_cfi_cached)
// where the handler's side holds rows, else interpreted in `scratch`; 0
// where the image's call frame information gives none the unwinder reads.
perf_cfi_rules: fn(rows: I64, scratch: I64, address: I64) -> I64 {
    if (rows == I64{0}) {
        entry: perf_cfi_find(address)
        if (entry == I64{0} || !perf_cfi_rule(scratch, rt_text_word(wrapping(entry + I64{16})), rt_text_word(entry), address)) {
            return I64{0}
        }
        return scratch
    }
    row: perf_cfi_cached(rows, scratch, address)
    if (rt_text_word(wrapping(row + PERF_CFI_CACHED)) < I64{0}) { return I64{0} }
    wrapping(row + wrapping(PERF_CFI_CACHED - PERF_CFI_ROW))
}

// The FDEs of the .eh_frame section at `bytes` in the mapping, `size` bytes
// from link-time address `address`: counted when `table` is 0, else written
// to it from entry `first` on. The entries written or counted.
perf_cfi_section: fn(scratch: I64, bytes: I64, size: I64, address: I64, table: I64, first: I64) -> I64 {
    written := first
    at := bytes
    stop: wrapping(bytes + size)
    loop wrapping(at + I64{8}) <= stop {
        length: perf_cfi_u32(at)
        if (length == I64{0} || length == I64{4294967295}) { break }
        pointer: wrapping(at + I64{4})
        if (perf_cfi_u32(pointer) != I64{0}) {
            if {
                (table == I64{0}) -> written = wrapping(written + I64{1})
                (perf_cfi_cie(scratch, wrapping(pointer - perf_cfi_u32(pointer)))) -> {
                    encoding: rt_text_word(wrapping(scratch + PERF_CFI_ENCODING))
                    rt_text_store(scratch, wrapping(at + I64{8}))
                    begin: perf_cfi_pointer(scratch, encoding, bytes, address)
                    extent: perf_cfi_pointer(scratch, encoding & I64{15}, bytes, address)
                    if (begin != PERF_CFI_BAD && extent != PERF_CFI_BAD && extent > I64{0}) {
                        entry: wrapping(table + wrapping(written * I64{24}))
                        rt_text_store(entry, begin)
                        rt_text_store(wrapping(entry + I64{8}), wrapping(begin + extent))
                        rt_text_store(wrapping(entry + I64{16}), at)
                        written = wrapping(written + I64{1})
                    }
                }
                else -> {}
            }
        }
        at = wrapping(pointer + length)
    }
    written
}

// The FDEs of every section named `.eh_frame` of the ELF64 file `image`:
// counted when `table` is 0, else written to it.
perf_cfi_sections: fn(image: I64, scratch: I64, table: I64) -> I64 {
    sections: wrapping(image + rt_text_word(wrapping(image + I64{40})))
    entry: rt_text_word(wrapping(image + I64{58})) & I64{65535}
    count: rt_text_word(wrapping(image + I64{60})) & I64{65535}
    strings: wrapping(image + rt_text_word(wrapping(wrapping(sections + wrapping((rt_text_word(wrapping(image + I64{62})) & I64{65535}) * entry)) + I64{24})))
    found := I64{0}
    index := I64{0}
    loop index < count {
        section: wrapping(sections + wrapping(index * entry))
        name: wrapping(strings + perf_cfi_u32(section))
        // ".eh_fram", then "e" and the name's end.
        if (perf_cfi_u64(name) == I64{7881706606887986478} && rt_text_byte(wrapping(name + I64{8})) == I64{101} && rt_text_byte(wrapping(name + I64{9})) == I64{0}) {
            bytes: wrapping(image + rt_text_word(wrapping(section + I64{24})))
            found = perf_cfi_section(scratch, bytes, rt_text_word(wrapping(section + I64{32})), rt_text_word(wrapping(section + I64{16})), table, found)
        }
        index = wrapping(index + I64{1})
    }
    found
}

// The FDE table of the ELF64 file `image` (alloc_check_image), sorted by
// begin.
perf_cfi_start: fn(image: I64) {
    if (image == I64{0}) {
        return
    }
    scratch: alloc_map_try(I64{4096})
    if (scratch == I64{0}) {
        return
    }
    found: perf_cfi_sections(image, scratch, I64{0})
    if (found == I64{0}) {
        return
    }
    table: alloc_map_try(wrapping(found * I64{24}))
    if (table == I64{0}) {
        return
    }
    total: perf_cfi_sections(image, scratch, table)
    perf_cfi_sort(table, total)
    #Unsafe("the observation start runs before the timer whose handler reads these is armed") {
        perf_cfi_table = table
        perf_cfi_count = total
        perf_cfi_scratch = scratch
    }
}

// Sort the `count` three-word entries of `table` by their first word, in
// place: a shell sort, as the runtime's sort would allocate.
perf_cfi_sort: fn(table: I64, count: I64) {
    gap := count >> I64{1}
    loop gap > (I64{0}) {
        index := gap
        loop index < count {
            moving: wrapping(table + wrapping(index * I64{24}))
            begin: rt_text_word(moving)
            end: rt_text_word(wrapping(moving + I64{8}))
            fde: rt_text_word(wrapping(moving + I64{16}))
            slot := index
            loop slot >= gap && rt_text_word(wrapping(table + wrapping(wrapping(slot - gap) * I64{24}))) > begin {
                to: wrapping(table + wrapping(slot * I64{24}))
                from: wrapping(table + wrapping(wrapping(slot - gap) * I64{24}))
                rt_text_store(to, rt_text_word(from))
                rt_text_store(wrapping(to + I64{8}), rt_text_word(wrapping(from + I64{8})))
                rt_text_store(wrapping(to + I64{16}), rt_text_word(wrapping(from + I64{16})))
                slot = wrapping(slot - gap)
            }
            to: wrapping(table + wrapping(slot * I64{24}))
            rt_text_store(to, begin)
            rt_text_store(wrapping(to + I64{8}), end)
            rt_text_store(wrapping(to + I64{16}), fde)
            index = wrapping(index + I64{1})
        }
        gap = gap >> I64{1}
    }
}

// The SIGPROF handler (SA_SIGINFO), and PERF_COUNTERS_SIGNAL's: the
// interrupted rip, rbp and rsp are ucontext_t's mcontext gregs[16], [10]
// and [15], at 168, 120 and 160. When rip is in the image's code, the call
// frame information (perf_cfi_rule) first steps out through each frame
// whose CFA is rsp-based, a function without a frame pointer or one before
// its prologue sets it, reading the return address and, where it was
// saved, rbp from below its CFA. At the first frame that keeps rbp, rbp is
// a frame of the chain, and the walk follows each [saved rbp][return
// address] pair while the call site is in the image's code, as the fault
// report's walk does (Fault.jet trace_frames). A frame neither can follow
// ends the stack there. Each handler fills a record buffer of its own, with
// its own scratch for the rules (perf_samples_claim, perf_samples_scratch);
// a sample outside the image's code keeps no callers, and one taken while
// other handlers hold every buffer is its program counter alone. A
// CPU-time sample's record in a buffer ends in its time, the handler's
// start on the process-relative monotonic clock zones are timed on, and its
// task as a zone's row names it (perf_zone_row), so the session counts each
// sample in the zones of its task that hold it (PERF_SAMPLES_TIMED). A
// timer's SIGPROF stands for its own period and each the kernel folded into
// it while it was pending (perf_samples_periods), so its record is written
// once for each, as many samples as the CPU time it covers gives. The
// handler keeps its records in its buffer's side to write many at once
// (perf_samples_keep), and reads each frame's rules from the rows the side
// keeps (perf_cfi_cached); a write the kernel refuses loses those records,
// and O_APPEND puts each write after the last. Under the task clock or a
// precise source (perf_precise_choose) the kernel takes each sample into
// the thread's ring with its stack, and a SIGPROF says the ring filled to
// its watermark: the handler drains it (perf_samples_ring_drain), and
// charges the signal's delivery with its own time, since no record counts
// that signal. A counter's record has its kind, and the counter is armed
// again once it is written. A topdown event's record is one word, its
// program counter alone, 0 outside the image's code, and its event's index
// above it.
#Export(c) jet_rt_perf_samples_signal: fn(signal: I64, info: I64, context: I64) -> I64 {
    if (signal == PERF_FLIGHT_CAPTURE_SIGNAL) {
        perf_flight_capture(context)
        return I64{0}
    }
    fd: perf_samples_fd
    if (fd < I64{0} || context == I64{0}) { return I64{0} }
    buffer: perf_samples_buffer
    began: perf_samples_clock()
    counter := I64{-1}
    if (signal == PERF_COUNTERS_SIGNAL) {
        counter = perf_counter_of(info, buffer)
        if (counter < I64{0}) { return I64{0} }
    }
    topdown: counter >= PERF_COUNTERS_COUNT
    kind: if (topdown) -> PERF_SAMPLES_TOPDOWN << PERF_SAMPLES_KIND_BITS else -> wrapping(counter + I64{1}) << PERF_SAMPLES_KIND_BITS
    bias: perf_samples_bias
    pc: wrapping(rt_text_word(wrapping(context + I64{168})) - bias)
    if (topdown) {
        own: if (perf_samples_in_code(pc)) -> wrapping(wrapping(pc - perf_samples_code_low) + I64{1}) else -> I64{0}
        word: own | (wrapping(counter - PERF_COUNTERS_COUNT) << PERF_TOPDOWN_EVENT_BITS) | (I64{1} << PERF_SAMPLES_ADDRESS_BITS) | kind
        #Unsafe("one write of a stack-local word, which the kernel copies before the call returns") {
            _ := os_write_word_i64(fd, word, I64{8})
        }
        perf_counter_rearm(buffer, counter)
        perf_samples_charge(buffer, began)
        return I64{0}
    }
    // Under a perf event, the signal is its ring's (perf_precise_ring).
    ring: if (signal == PERF_SAMPLES_SIGNAL) -> perf_precise_ring(info) else -> I64{0}
    if (ring > I64{0}) {
        perf_samples_ring_drain(ring, thread_base())
        perf_samples_charge(buffer, wrapping(began - perf_samples_delivery_ns))
        return I64{0}
    }
    if (ring < I64{0}) {
        perf_samples_charge(buffer, began)
        return I64{0}
    }
    // A program counter outside the image's code keeps no callers, but a
    // CPU-time sample's record still takes its time and task. The causal
    // lens drops the periods its pauses spent (perf_causal_tick).
    raw: perf_samples_periods(signal, info)
    periods: if (signal == PERF_SAMPLES_SIGNAL) -> perf_causal_tick(pc, raw) else -> raw
    if (periods == I64{0}) {
        perf_samples_charge(buffer, began)
        return I64{0}
    }
    walked: perf_samples_in_code(pc)
    slot: if (buffer == I64{0}) -> I64{0} else -> perf_samples_claim(buffer)
    if (slot == I64{0}) {
        perf_samples_put(fd, I64{0}, I64{0}, (I64{1} << PERF_SAMPLES_ADDRESS_BITS) | kind, pc, periods)
        perf_counter_rearm(buffer, counter)
        perf_samples_charge(buffer, began)
        return I64{0}
    }
    // A CPU-time sample's record ends in PERF_SAMPLES_TIMED words.
    timed: kind == I64{0}
    room: if (timed) -> wrapping(PERF_SAMPLES_DEPTH - PERF_SAMPLES_TIMED) else -> PERF_SAMPLES_DEPTH
    count := I64{1}
    stack: rt_text_word(wrapping(context + I64{160}))
    frame := if (walked) -> rt_text_word(wrapping(context + I64{120})) else -> I64{0}
    // The buffer's side keeps the records not yet written and the rule
    // rows its walks met (perf_samples_side, perf_cfi_rules).
    side: perf_samples_side(slot, buffer)
    rows: if (side == I64{0}) -> I64{0} else -> perf_samples_side_rows(side)
    rules: perf_samples_scratch(slot, buffer)
    scratch: if (walked) -> rules else -> I64{0}
    sp := stack
    address := pc
    loop scratch != (I64{0}) && count < room {
        row: perf_cfi_rules(rows, scratch, address)
        if (row == I64{0}) { break }
        register: rt_text_word(wrapping(row + PERF_CFI_CFA_REG))
        // A frame that keeps rbp: the walk below takes it from here.
        if (register == PERF_CFI_RBP) { break }
        cfa: wrapping(sp + rt_text_word(wrapping(row + PERF_CFI_CFA_OFFSET)))
        if (register != PERF_CFI_RSP || rt_text_word(wrapping(row + PERF_CFI_RA_RULE)) != PERF_CFI_SAVED || cfa <= sp || cfa & I64{7} != I64{0} || wrapping(cfa - stack) >= I64{16777216}) {
            frame = I64{0}
            break
        }
        // cfa is above the interrupted rsp on the thread's stack, so the
        // return address and the saved rbp below it are words of that stack.
        rule: rt_text_word(wrapping(row + PERF_CFI_RBP_RULE))
        if {
            (rule == PERF_CFI_SAVED) -> {
                frame = rt_text_word(wrapping(cfa + rt_text_word(wrapping(row + PERF_CFI_RBP_OFFSET))))
            }
            (rule == PERF_CFI_UNKNOWN) -> frame = I64{0}
            else -> {}
        }
        site: wrapping(wrapping(rt_text_word(wrapping(cfa + rt_text_word(wrapping(row + PERF_CFI_RA_OFFSET)))) - I64{1}) - bias)
        if (!perf_samples_in_code(site)) {
            frame = I64{0}
            break
        }
        rt_text_store(wrapping(slot + wrapping(wrapping(count + I64{1}) * I64{8})), site)
        count = wrapping(count + I64{1})
        sp = cfa
        address = site
    }
    if (frame < sp || wrapping(frame - stack) >= I64{16777216}) { frame = I64{0} }
    loop count < room {
        if (frame == I64{0} || frame & I64{7} != I64{0}) { break }
        // frame is a [saved rbp][return address] pair of the interrupted
        // thread's chain: rbp of a frame that keeps it, or the saved rbp of
        // its caller.
        site: wrapping(wrapping(rt_text_word(wrapping(frame + I64{8})) - I64{1}) - bias)
        if (!perf_samples_in_code(site)) { break }
        rt_text_store(wrapping(slot + wrapping(wrapping(count + I64{1}) * I64{8})), site)
        count = wrapping(count + I64{1})
        #Unsafe("each followed link ascends by less than 16 MiB or crosses a stack segment's bridge frame, so frame stays on the thread's chain") {
            frame = stack_frame_caller(frame)
        }
    }
    if (timed) {
        // Its time from the process epoch, the clock zones, waits and log
        // spans are timed on (time_host_monotonic_i64); before that epoch is
        // set no zone has opened, so -1 lies before every one. The epoch is
        // read through the time root zones copied as they turned on
        // (perf_zone_clock), 0 while they are off, so the handler keeps no
        // time init hook in an image whose zones never turn on.
        epoch: time_host_epoch_ns(perf_zone_clock)
        rt_text_store(wrapping(slot + wrapping(wrapping(count + I64{1}) * I64{8})), if (epoch == I64{0}) -> I64{-1} else -> wrapping(began - epoch))
        rt_text_store(wrapping(slot + wrapping(wrapping(count + I64{2}) * I64{8})), perf_samples_task_of(thread_base()))
        count = wrapping(count + PERF_SAMPLES_TIMED)
    }
    perf_samples_put(fd, side, wrapping(slot + I64{8}), (count << PERF_SAMPLES_ADDRESS_BITS) | kind, pc, periods)
    sync_store(slot, I64{0})
    perf_counter_rearm(buffer, counter)
    perf_samples_charge(buffer, began)
    I64{0}
}

// The periods of CPU time the SIGPROF `info` reports stands for: its
// timer's expiry and each the kernel counted while the signal was still
// pending (si_overrun, the high half of the word at 16 of a siginfo of
// si_code SI_TIMER), at most PERF_SAMPLES_OVERRUNS more; 1 for any other
// signal, a counter's or one the start sends itself (perf_samples_delivery).
perf_samples_periods: fn(signal: I64, info: I64) -> I64 {
    if (signal != PERF_SAMPLES_SIGNAL || info == I64{0}) { return I64{1} }
    if (rt_text_word(wrapping(info + I64{8})) & I64{4294967295} != I64{4294967294}) {
        return I64{1}
    }
    overrun: (rt_text_word(wrapping(info + I64{16})) >> I64{32}) & I64{2147483647}
    if (overrun > PERF_SAMPLES_OVERRUNS) { return wrapping(PERF_SAMPLES_OVERRUNS + I64{1}) }
    wrapping(overrun + I64{1})
}

// The flight recorder: a run observed outside `jet
// perf run` (JET_OBSERVE=1 without JET_PERF_SAMPLES) still samples its CPU
// time, one sample per PERF_FLIGHT_INTERVAL_US, and records its tasks'
// spawns, waits, wakes and transfers, into a ring instead of a file.
// perf_samples_fd is then the write end of a nonblocking datagram socket
// pair, so each record is one datagram, sent whole or, while the socket is
// full, lost and counted (perf_samples_send): no handler ever waits. The
// observation writer (ObserveLive.jet jet_rt_observe_writer) drains the
// socket into the ring at each publication (perf_flight_publish), dropping
// the oldest records once the ring fills, keeps the count of lost records
// in it as a tally record whenever the count grew (perf_flight_tally), and
// publishes it as `jet-flight-<pid>.samples` in this user's private
// directory (perf_flight_home), the image beside it as `.image`: the pair
// `jet perf attach` reads. The ring's new records are written into that
// file in place (perf_flight_ring), so a reader that holds it open reads on
// into them, and at the exit the last turn's records and a tally that says
// the run ended go into it before it is removed (perf_flight_end). A stop
// that ends the process writes a typed dump that holds the ring
// (perf_flight_dump), which `jet debug` opens.
PERF_FLIGHT_INTERVAL_US: I64{10000}

// An attach's zones window (perf_flight_window_open): the window file's
// descriptor, `<ring>.window`, opened at the first window and kept, -1
// before; the record socket the samples descriptor returns to as the window
// closes; and as it opened, its time on the zones' clock, -1 while no window
// is open, the process's CPU time, the nanoseconds the handlers had run and
// the records lost. Only the observation writer opens and closes a window,
// under the flight recorder's lock, and the exit (perf_flight_window_end).
perf_flight_window_fd := I64{-1}

perf_flight_socket := I64{-1}

perf_flight_window_at := I64{-1}

perf_flight_window_cpu := I64{0}

perf_flight_window_handled := I64{0}

perf_flight_window_lost := I64{0}

// How long an attach's zones request stands unrenewed (Session.jet
// jet_cli_perf_attach_zones writes it every 250 ms): 1 s. One older was
// left by an attach that died, so it is removed, which closes the window.
PERF_FLIGHT_LEASE_NS: I64{1000000000}

// An attach's zones window opens as zones turn on (perf_flight_zones): the
// handlers' records go to the window file `<path>.window`, emptied, kept in
// their sides until PERF_SAMPLES_OUT_BYTES of them fill one
// (perf_samples_buffered), not to the record socket, whose ring holds too
// few for a window sampled at 8 kHz; each thread then samples its CPU time
// every PERF_SAMPLES_INTERVAL_US (perf_samples_rate), as under `jet perf
// run`; then the window's opening time, CPU time, handler time and lost
// records are taken. Without the file no window opens, and zones are on at
// the flight recorder's interval.
perf_flight_window_open: fn(path: I64) {
    if (perf_flight_window_at >= I64{0} || perf_samples_fd < I64{0}) {
        return
    }
    fd := perf_flight_window_fd
    if (fd < I64{0}) {
        window: perf_flight_beside(path, rt_static_text(".window"))
        file: observe_cstring(window)
        // O_WRONLY|O_CREAT|O_TRUNC|O_APPEND|O_CLOEXEC, mode 0600.
        fd = observe_syscall(I64{257}, I64{-100}, file, I64{525889}, I64{384})
        jet_rt_free(file, wrapping(rt_text_len(window) + I64{1}), I64{1})
        jet_rt_string_drop(window)
        if (fd < I64{0}) {
            return
        }
        #Unsafe("only the observation writer opens a window, under the flight recorder's lock") {
            perf_flight_window_fd = fd
        }
    } else {
        // ftruncate; the file appends, so the window's first record lands at 0.
        _ := observe_syscall(I64{77}, fd, I64{0}, I64{0}, I64{0})
    }
    #Unsafe("only the observation writer opens a window, under the flight recorder's lock; a handler reads the descriptor once, and the buffering only while it holds its buffer (perf_samples_flush)") {
        perf_flight_socket = perf_samples_fd
        perf_samples_buffered = if (perf_samples_sides == I64{0}) -> I64{0} else -> I64{1}
        perf_samples_fd = fd
    }
    perf_samples_rate(PERF_SAMPLES_INTERVAL_US)
    buffer: perf_samples_buffer
    cpu: perf_samples_process_cpu_ns()
    handled: if (buffer == I64{0}) -> I64{0} else -> sync_load(perf_samples_tally(buffer, I64{0}))
    lost: perf_samples_lost()
    opened: perf_zone_now()
    #Unsafe("only the observation writer opens a window, under the flight recorder's lock") {
        perf_flight_window_cpu = cpu
        perf_flight_window_handled = handled
        perf_flight_window_lost = lost
        perf_flight_window_at = opened
    }
}

// The window closes as zones turn off, its attach's request gone or its
// lease lapsed (perf_flight_zones), and at the exit (perf_flight_window_end):
// its end, CPU time, handler time and lost records are taken first; each
// thread then samples at the flight recorder's interval again, the records
// go to the record socket again, and those the sides kept are written to
// the window file (perf_samples_flush). Its PERF_ZONE_WINDOW row then goes
// to the spans buffer: from its opening to its end on the zones' clock,
// then five words, the interval its samples stand for in microseconds, the
// process's CPU time in it, the nanoseconds the handlers ran in it, the
// kernel's to deliver one signal (perf_samples_delivery), and the records
// lost in it.
perf_flight_window_close: fn() {
    opened: perf_flight_window_at
    if (opened < I64{0}) {
        return
    }
    end: perf_zone_now()
    cpu: perf_samples_process_cpu_ns()
    buffer: perf_samples_buffer
    handled: if (buffer == I64{0}) -> I64{0} else -> sync_load(perf_samples_tally(buffer, I64{0}))
    lost: perf_samples_lost()
    perf_samples_rate(PERF_FLIGHT_INTERVAL_US)
    #Unsafe("only the observation writer and the exit close a window, under the flight recorder's lock; a handler reads the descriptor once") {
        perf_samples_fd = perf_flight_socket
        perf_flight_window_at = I64{-1}
    }
    perf_samples_flush(perf_flight_window_fd)
    spans: perf_spans_buffer
    if (spans == I64{0}) {
        return
    }
    words: jet_rt_alloc(I64{40}, I64{8})
    rt_text_store(words, PERF_SAMPLES_INTERVAL_US)
    rt_text_store(wrapping(words + I64{8}), wrapping(cpu - perf_flight_window_cpu))
    rt_text_store(wrapping(words + I64{16}), wrapping(handled - perf_flight_window_handled))
    rt_text_store(wrapping(words + I64{24}), perf_samples_delivery_ns)
    rt_text_store(wrapping(words + I64{32}), wrapping(lost - perf_flight_window_lost))
    sync_thread_lock(spans)
    perf_spans_put(spans, PERF_ZONE_WINDOW, opened, end, I64{0}, words, I64{40})
    sync_thread_unlock(spans)
    jet_rt_free(words, I64{40}, I64{8})
}

// At the exit (perf_samples_exit): close a window still open, under the
// flight recorder's lock, which a publication may hold meanwhile.
perf_flight_window_end: fn() {
    state: perf_flight_state
    if (state == I64{0} || perf_flight_window_at < I64{0} || !perf_flight_lock(state, I64{100000000})) {
        return
    }
    perf_flight_window_close()
    sync_store(state, I64{0})
}

// The real-time clock (CLOCK_REALTIME) in nanoseconds, the clock a file's
// modification time is on.
perf_flight_realtime: fn() -> I64 {
    scratch: jet_rt_alloc(I64{16}, I64{8})
    sync_clock_read(I64{0}, scratch)
    now: wrapping(wrapping(rt_text_word(scratch) * I64{1000000000}) + rt_text_word(wrapping(scratch + I64{8})))
    jet_rt_free(scratch, I64{16}, I64{8})
    now
}

// The flight recorder's state mapping (perf_flight_state): its lock word,
// then the socket's read end, the ring's bytes in use, whether the image
// was published, whether the dump was written, whether the run ended
// (perf_flight_end), the dump name's program prefix length and the dump's
// task rows claimed (perf_flight_tasks); then one datagram's receive
// buffer, the ring, the dump's scratch for its task rows, /proc/self/maps
// and directory entries, the dump's text page, its redacted copy's vectors
// and table of Secrets, its redacted copy (perf_flight_redacted), and the
// tables of its walk of reachable memory (perf_flight_reach); then the
// ring's bytes the published file holds, -1 once the ring dropped records
// the file holds (perf_flight_ring), and the lost records the ring's last
// tally counted (perf_flight_tally).
PERF_FLIGHT_READ: I64{8}

PERF_FLIGHT_USED: I64{16}

PERF_FLIGHT_IMAGE: I64{24}

PERF_FLIGHT_DUMPED: I64{32}

PERF_FLIGHT_ENDED: I64{40}

PERF_FLIGHT_PREFIX: I64{48}

PERF_FLIGHT_CLAIMED: I64{56}

PERF_FLIGHT_RECEIVE_AT: I64{64}

PERF_FLIGHT_RECEIVE: I64{8192}

PERF_FLIGHT_RING_AT: I64{8256}

PERF_FLIGHT_RING: I64{262144}

PERF_FLIGHT_SCRATCH_AT: I64{270400}

PERF_FLIGHT_SCRATCH: I64{360448}

PERF_FLIGHT_TEXT_AT: I64{630848}

PERF_FLIGHT_VECTORS_AT: I64{634944}

PERF_FLIGHT_SECRETS_AT: I64{634976}

// The most Secrets a dump redacts by their bytes (Secret.jet
// secret_redact_table): their table's 40-byte head, then 16 bytes each.
PERF_FLIGHT_SECRETS: I64{256}

PERF_FLIGHT_COPY_AT: I64{639168}

PERF_FLIGHT_COPY: I64{1048576}

// The walk's words: its spans' count, the queue's head and tail, the bytes
// held, the cut rows and bytes, the end of the image's copy, two words a
// read fills, and the pages marked. Then its tables: the writable spans of
// /proc/self/maps, PERF_FLIGHT_SPANS rows of [start, end); the pages held or
// cut off, an open-addressed table of PERF_FLIGHT_SEEN words, each a page's
// number shifted left once, plus 1 when it was cut off; the ranges to
// write, PERF_FLIGHT_QUEUE rows of [address, bytes]; and the cut section:
// the budget, the bytes held, the bytes cut off and the rows, then
// PERF_FLIGHT_CUTS rows of [address, bytes].
PERF_FLIGHT_WALK_AT: I64{1687744}

PERF_FLIGHT_SPANS_AT: I64{1687824}

PERF_FLIGHT_SPANS: I64{4096}

PERF_FLIGHT_SEEN_AT: I64{1753360}

PERF_FLIGHT_SEEN: I64{32768}

PERF_FLIGHT_QUEUE_AT: I64{2015504}

PERF_FLIGHT_QUEUE: I64{16384}

PERF_FLIGHT_CUTS_AT: I64{2277648}

PERF_FLIGHT_CUTS: I64{8192}

PERF_FLIGHT_PUBLISHED: I64{2408752}

PERF_FLIGHT_TALLIED: I64{2408760}

PERF_FLIGHT_BYTES: I64{2408768}

// A tally record's words (perf_flight_tally): its first, of the clock
// record's kind with 1 in its address bits, then the records the program
// made and could not write, then 1 once the run ended.
PERF_FLIGHT_TALLY_WORDS: I64{3}

// A page's address bits, and the most frame pointers a stack's chain
// follows.
PERF_FLIGHT_PAGE_MASK: I64{-4096}

PERF_FLIGHT_FRAMES: I64{65536}

// The dump's text page: the dump's path from its start, then the dump's
// header words, the build hashes of the kept dumps while their images
// rotate (perf_flight_images), the image copy's path while it is written
// (perf_flight_image) and the oldest dump's name while the dumps rotate
// (perf_flight_rotate), the image copy's staging path, the word the
// threads the dump captures wait on
// (PERF_FLIGHT_CAPTURING, PERF_FLIGHT_CLOSED once their rows are taken,
// PERF_FLIGHT_RELEASED once the dump is written), the count of rows they
// wrote, the tid of the stopping thread, which captures itself, and the
// registers it was interrupted at, its rip (0 until it is captured), rsp
// and PERF_FLIGHT_TASK_REGISTERS general registers (perf_flight_capture),
// and zeros that stand for bytes the dump could not read.
PERF_FLIGHT_WORDS_AT: I64{1024}

PERF_FLIGHT_KEPT_AT: I64{1216}

PERF_FLIGHT_KEPT_MOST: I64{8}

PERF_FLIGHT_OLDEST_AT: I64{1280}

PERF_FLIGHT_STAGING_AT: I64{1664}

PERF_FLIGHT_RELEASE_AT: I64{2048}

PERF_FLIGHT_ANSWERED_AT: I64{2056}

PERF_FLIGHT_SELF_AT: I64{2064}

PERF_FLIGHT_STOP_AT: I64{2072}

PERF_FLIGHT_CAPTURING: I64{0}

PERF_FLIGHT_CLOSED: I64{1}

PERF_FLIGHT_RELEASED: I64{2}

PERF_FLIGHT_ZEROS_AT: I64{3072}

PERF_FLIGHT_ZEROS: I64{1024}

// "JETDUMP1", the dump's first word, then its version.
PERF_FLIGHT_MAGIC: I64{3553425134609253706}

PERF_FLIGHT_VERSION: I64{5}

// The dump's header: its words before the sections.
PERF_FLIGHT_HEADER: I64{96}

// The build hash's FNV-1a offset and prime (perf_flight_fold), and its
// hexadecimal digits in an image copy's name.
PERF_FLIGHT_BUILD_OFFSET: I64{-3750763034362895579}

PERF_FLIGHT_BUILD_PRIME: I64{1099511628211}

PERF_FLIGHT_BUILD_DIGITS: I64{16}

// The kinds of the dump's sections after its words, each [kind, address,
// bytes] and the bytes padded to a word: a range of reachable memory, the
// ring, the tasks (perf_flight_tasks), the ranges cut off past the budget
// (perf_flight_reach), and the end.
PERF_FLIGHT_SECTION_END: I64{0}

PERF_FLIGHT_SECTION_MEMORY: I64{1}

PERF_FLIGHT_SECTION_RING: I64{2}

PERF_FLIGHT_SECTION_TASKS: I64{3}

PERF_FLIGHT_SECTION_CUT: I64{4}

// A row of the dump's tasks: the task's id, how its registers were had,
// its rip, rsp and rbp, its thread's tid (0 for a parked task's), which of
// the general registers that follow are known (bit k for the k-th), then
// PERF_FLIGHT_TASK_REGISTERS general registers in the kernel's order
// (user_regs_struct): r15, r14, r13, r12, rbp, rbx, r11, r10, r9, r8, rax,
// rcx, rdx, rsi and rdi, 0 for one not known. The rows fill the state's
// scratch while the threads are captured, at most PERF_FLIGHT_TASKS_MAX of
// them.
PERF_FLIGHT_TASK_WORDS: I64{22}

PERF_FLIGHT_TASK_REGISTERS: I64{15}

// Which general registers of a row are known: every one, a thread's a
// signal interrupted; r15, r14, r13, r12, rbp and rbx, a parked fiber's
// its last switch saved and the stopping thread's as its tgkill returns;
// rbp alone, the stopping thread's as its caller resumes.
PERF_FLIGHT_TASK_KNOWN: I64{32767}

PERF_FLIGHT_TASK_SAVED: I64{63}

PERF_FLIGHT_TASK_RBP: I64{16}

// Per general register of a row, 4 bits each from the first's: the index
// of ucontext_t's general register that holds it (REG_R15 7, REG_R14 6,
// REG_R13 5, REG_R12 4, REG_RBP 10, REG_RBX 11, REG_R11 3, REG_R10 2,
// REG_R9 1, REG_R8 0, REG_RAX 13, REG_RCX 14, REG_RDX 12, REG_RSI 9 and
// REG_RDI 8).
PERF_FLIGHT_TASK_GREGS: I64{620631437820446055}

PERF_FLIGHT_TASKS_MAX: I64{2048}

// How a row's registers were had: the stopping thread's own, a thread's
// that PERF_FLIGHT_CAPTURE_SIGNAL interrupted, or a parked or queued
// fiber's that its last switch saved (Linux.jet os_fiber_switch_i64).
PERF_FLIGHT_TASK_STOPPED: I64{0}

PERF_FLIGHT_TASK_RUNNING: I64{1}

PERF_FLIGHT_TASK_PARKED: I64{2}

// The real-time signal the dump captures each other thread with; its
// handler is the sampler's (jet_rt_perf_samples_signal).
PERF_FLIGHT_CAPTURE_SIGNAL: I64{62}

// How long the dump waits for the captured threads' rows: 200ms.
PERF_FLIGHT_CAPTURE_NS: I64{200000000}

// How long a deadlocked task waits for the root's dump (perf_flight_await):
// 10s.
PERF_FLIGHT_HOLD_NS: I64{10000000000}

// The most reachable memory one dump holds, 32 MiB: past it a reached
// range is cut off (perf_flight_reach).
PERF_FLIGHT_DUMP_BUDGET: I64{33554432}

// The newest dumps of a program `.jet/dumps` keeps.
PERF_FLIGHT_DUMPS_KEPT: I64{3}

// The flight recorder's state, 0 outside it.
perf_flight_state := I64{0}

// Map the flight recorder's state and its socket pair: the write end, the
// samples descriptor, or -1 when either cannot be had.
perf_flight_open: fn() -> I64 {
    state: alloc_map_try(PERF_FLIGHT_BYTES)
    if (state == I64{0}) { return I64{-1} }
    pair: wrapping(state + PERF_FLIGHT_RECEIVE_AT)
    status := I64{-1}
    // AF_UNIX, SOCK_DGRAM | SOCK_NONBLOCK | SOCK_CLOEXEC.
    #Unsafe("socketpair writes its two descriptors into the fresh state's receive buffer") {
        status = os_syscall_i64(I64{53}, I64{1}, I64{526338}, I64{0}, pair, I64{0}, I64{0})
    }
    if (status < I64{0}) {
        alloc_unmap(state, PERF_FLIGHT_BYTES)
        return I64{-1}
    }
    ends: rt_text_word(pair)
    rt_text_store(pair, I64{0})
    rt_text_store(wrapping(state + PERF_FLIGHT_READ), ends & I64{4294967295})
    // No file of this run's is published yet: the first publication stages
    // one, whatever an earlier process of the same pid left at its path.
    rt_text_store(wrapping(state + PERF_FLIGHT_PUBLISHED), I64{-1})
    #Unsafe("the observation start runs before the writer and the stop that read it") {
        perf_flight_state = state
    }
    (ends >> I64{32}) & I64{4294967295}
}

// Take the state's lock word within `tries` attempts.
perf_flight_lock: fn(state: I64, tries: I64) -> Bool {
    tried := I64{0}
    loop tried < tries {
        if (sync_cas(state, I64{0}, I64{1}) == I64{0}) { return true }
        tried = wrapping(tried + I64{1})
    }
    false
}

// Move every datagram the socket holds into the ring; the lock is held.
perf_flight_drain: fn(state: I64) {
    read: rt_text_word(wrapping(state + PERF_FLIGHT_READ))
    buffer: wrapping(state + PERF_FLIGHT_RECEIVE_AT)
    loop {
        count := I64{0}
        #Unsafe("read fills the state's receive buffer with one datagram") {
            count = os_syscall_i64(I64{0}, read, buffer, PERF_FLIGHT_RECEIVE, I64{0}, I64{0}, I64{0})
        }
        if (count == I64{-4}) { next }
        if (count <= I64{0}) {
            return
        }
        perf_flight_keep(state, buffer, count & I64{-8})
    }
}

// Append the `bytes` of whole records at `record` to the ring. When they
// would not fit, the oldest records go first, down to half the ring, so
// the ring moves its records once per half ring of new ones; the published
// file then no longer starts the ring, and the tally may have gone.
perf_flight_keep: fn(state: I64, record: I64, bytes: I64) {
    if (bytes <= I64{0} || bytes > PERF_FLIGHT_RING / I64{2}) {
        return
    }
    ring: wrapping(state + PERF_FLIGHT_RING_AT)
    used: rt_text_word(wrapping(state + PERF_FLIGHT_USED))
    kept := used
    if (wrapping(used + bytes) > PERF_FLIGHT_RING) {
        gone := I64{0}
        loop gone < used && wrapping(used - gone) > (PERF_FLIGHT_RING / I64{2}) {
            words: (rt_text_word(wrapping(ring + gone)) >> PERF_SAMPLES_ADDRESS_BITS) & PERF_SAMPLES_HEAP_RECORD
            gone = if (words == I64{0}) -> used else -> wrapping(gone + wrapping(words * I64{8}))
        }
        if (gone > used) { gone = used }
        kept = wrapping(used - gone)
        rt_text_store(wrapping(state + PERF_FLIGHT_PUBLISHED), I64{-1})
        rt_text_store(wrapping(state + PERF_FLIGHT_TALLIED), I64{0})
        at := I64{0}
        loop at < kept {
            rt_text_store(wrapping(ring + at), rt_text_word(wrapping(wrapping(ring + gone) + at)))
            at = wrapping(at + I64{8})
        }
    }
    rt_text_bytes_copy(wrapping(ring + kept), record, bytes)
    rt_text_store(wrapping(state + PERF_FLIGHT_USED), wrapping(kept + bytes))
}

// `<home>/jet-flight-<pid>.samples`, a fresh text.
perf_flight_path: fn(directory: I64) -> I64 {
    builder: jet_rt_string_builder_new()
    observe_append_directory(builder, directory)
    jet_rt_string_builder_push(builder, rt_static_text("jet-flight-"))
    observe_decimal_unsigned(builder, observe_syscall(I64{39}, I64{0}, I64{0}, I64{0}, I64{0}))
    jet_rt_string_builder_push(builder, rt_static_text(".samples"))
    jet_rt_string_builder_finish(builder)
}

// Write the `length` bytes at `bytes` to the file `path` names, staged
// beside it and renamed over it, owner-only; whether it was.
perf_flight_file: fn(path: I64, bytes: I64, length: I64) -> Bool {
    builder: jet_rt_string_builder_new()
    jet_rt_string_builder_push(builder, path)
    jet_rt_string_builder_push(builder, rt_static_text(".stage"))
    staged: jet_rt_string_builder_finish(builder)
    name: observe_cstring(staged)
    done := false
    // O_WRONLY|O_CREAT|O_TRUNC|O_CLOEXEC, mode 0600.
    fd: observe_syscall(I64{257}, I64{-100}, name, I64{524865}, I64{384})
    if (fd >= I64{0}) {
        written: host_write_all(fd, bytes, length)
        _ := observe_syscall(I64{3}, fd, I64{0}, I64{0}, I64{0})
        if (written == I64{0}) {
            target: observe_cstring(path)
            done = observe_syscall(I64{82}, name, target, I64{0}, I64{0}) == I64{0}
            jet_rt_free(target, wrapping(rt_text_len(path) + I64{1}), I64{1})
        }
    }
    if (!done) { _ := observe_syscall(I64{87}, name, I64{0}, I64{0}, I64{0}) }
    jet_rt_free(name, wrapping(rt_text_len(staged) + I64{1}), I64{1})
    jet_rt_string_drop(staged)
    done
}

// Remove the file the text `path` names.
perf_flight_unlink: fn(path: I64) {
    name: observe_cstring(path)
    _ := observe_syscall(I64{87}, name, I64{0}, I64{0}, I64{0})
    jet_rt_free(name, wrapping(rt_text_len(path) + I64{1}), I64{1})
}

// `path` with `suffix` after it, a fresh text.
perf_flight_beside: fn(path: I64, suffix: I64) -> I64 {
    builder: jet_rt_string_builder_new()
    jet_rt_string_builder_push(builder, path)
    jet_rt_string_builder_push(builder, suffix)
    jet_rt_string_builder_finish(builder)
}

// The flight recorder's own directory, apart from the temporary directory
// other users share: `jet` in `$XDG_RUNTIME_DIR` when that names an
// absolute path, else `jet-<euid>` in `temp`, made owner-only when missing
// (Session.jet jet_cli_perf_flight_home finds the same one). A fresh text;
// 0 when it is not this user's alone (another user's, a link, or open to
// others), and then nothing is published there and no request is read
// from it.
perf_flight_home: fn(temp: I64) -> I64 {
    builder: jet_rt_string_builder_new()
    runtime: jet_rt_logical_env_get(rt_static_text("XDG_RUNTIME_DIR"))
    if (runtime != I64{0} && rt_text_len(runtime) > I64{0} && trap_byte(rt_text_data(runtime)) == I64{47}) {
        observe_append_directory(builder, runtime)
        jet_rt_string_builder_push(builder, rt_static_text("jet"))
    } else {
        observe_append_directory(builder, temp)
        jet_rt_string_builder_push(builder, rt_static_text("jet-"))
        // geteuid
        observe_decimal_unsigned(builder, observe_syscall(I64{107}, I64{0}, I64{0}, I64{0}, I64{0}))
    }
    if (runtime != I64{0}) { jet_rt_string_drop(runtime) }
    home: jet_rt_string_builder_finish(builder)
    name: observe_cstring(home)
    // mkdir(name, 0700); one already there is checked as a new one is.
    _ := observe_syscall(I64{83}, name, I64{448}, I64{0}, I64{0})
    private: perf_flight_owned_at(name, I64{16384}) >= I64{0}
    jet_rt_free(name, wrapping(rt_text_len(home) + I64{1}), I64{1})
    if (!private) {
        jet_rt_string_drop(home)
        return I64{0}
    }
    home
}

// When the C string `name` names, its final link not followed, a file of
// `kind` (S_IFDIR or S_IFREG) this user owns, closed to others when it is a
// directory: its last modification on the real-time clock, in nanoseconds;
// else -1. A request another user left is not this user's, so it is
// ignored.
perf_flight_owned_at: fn(name: I64, kind: I64) -> I64 {
    facts: jet_rt_alloc(I64{144}, I64{8})
    // lstat: st_mode, then st_uid, at byte 24; st_mtim at byte 88.
    found: observe_syscall(I64{6}, name, facts, I64{0}, I64{0}) == I64{0}
    word: if (found) -> rt_text_word(wrapping(facts + I64{24})) else -> I64{0}
    modified: wrapping(wrapping(rt_text_word(wrapping(facts + I64{88})) * I64{1000000000}) + rt_text_word(wrapping(facts + I64{96})))
    jet_rt_free(facts, I64{144}, I64{8})
    mode: word & I64{65535}
    // geteuid
    owner: observe_syscall(I64{107}, I64{0}, I64{0}, I64{0}, I64{0})
    owned: (mode & I64{61440}) == kind && ((word >> I64{32}) & I64{4294967295}) == owner && (kind != I64{16384} || (mode & I64{63}) == I64{0})
    if (owned) -> modified else -> I64{-1}
}

// At each of the observation writer's publications: drain the socket into
// the ring, tally its lost records, and publish it in this user's private
// directory beside the temporary directory `directory` (perf_flight_home;
// perf_flight_ring), the image beside it the first time, answering an
// attach's zones (perf_flight_zones) and heap snapshot (perf_flight_heap)
// requests. A publication that finds the lock held (a dump) skips its turn.
perf_flight_publish: fn(directory: I64) {
    state: perf_flight_state
    if (state == I64{0} || !perf_flight_lock(state, I64{1})) {
        return
    }
    if (rt_text_word(wrapping(state + PERF_FLIGHT_ENDED)) == I64{0}) {
        perf_flight_drain(state)
        perf_flight_tally(state, I64{0})
        home: perf_flight_home(directory)
        if (home == I64{0}) {
            // No request stands where others could have left it.
            if (perf_zones_on != I64{0}) {
                perf_flight_window_close()
                perf_zones_set(I64{0})
            }
        } else {
            path: perf_flight_path(home)
            jet_rt_string_drop(home)
            perf_flight_zones(path)
            if (rt_text_word(wrapping(state + PERF_FLIGHT_IMAGE)) == I64{0}) {
                image: perf_flight_beside(path, rt_static_text(".image"))
                if (perf_flight_file(image, perf_samples_image, perf_flight_image_bytes(perf_samples_image))) {
                    rt_text_store(wrapping(state + PERF_FLIGHT_IMAGE), I64{1})
                }
                jet_rt_string_drop(image)
            }
            // After the image, which the attach reads the snapshot beside.
            perf_flight_heap(path)
            perf_flight_ring(state, path, false)
            jet_rt_string_drop(path)
        }
    }
    sync_store(state, I64{0})
}

// `jet perf attach` turns zones on in a flight-recorded run by leaving
// `<ring>.zones` beside the published ring `path`, renewing it every 250 ms,
// and off by removing it. Only a request this user owns counts
// (perf_flight_owned_at), and only while it was renewed within
// PERF_FLIGHT_LEASE_NS: an older one was left by an attach that died, and is
// removed. While the request stands, zones, frame marks, plots and log
// spans write their rows to `<ring>.spans` (perf_spans_fd_set), emptied
// when a request turns zones on and written out at each publication, and
// the zones window is open (perf_flight_window_open); once it is gone the
// window closes, the zones word is cleared, and the rows stay for the
// attach to read. Log spans keep writing rows while zones are off, within
// the file's bound (PERF_SPANS_FILE_BYTES).
perf_flight_zones: fn(path: I64) {
    request: perf_flight_beside(path, rt_static_text(".zones"))
    name: observe_cstring(request)
    renewed: perf_flight_owned_at(name, I64{32768})
    lapsed: renewed >= I64{0} && wrapping(perf_flight_realtime() - renewed) > PERF_FLIGHT_LEASE_NS
    // unlink
    if (lapsed) { _ := observe_syscall(I64{87}, name, I64{0}, I64{0}, I64{0}) }
    jet_rt_free(name, wrapping(rt_text_len(request) + I64{1}), I64{1})
    jet_rt_string_drop(request)
    wanted: renewed >= I64{0} && !lapsed
    if (wanted && perf_zones_on == I64{0}) {
        if (perf_spans_fd < I64{0}) {
            spans: perf_flight_beside(path, rt_static_text(".spans"))
            file: observe_cstring(spans)
            // O_WRONLY|O_CREAT|O_TRUNC|O_APPEND|O_CLOEXEC, mode 0600.
            fd: observe_syscall(I64{257}, I64{-100}, file, I64{525889}, I64{384})
            jet_rt_free(file, wrapping(rt_text_len(spans) + I64{1}), I64{1})
            jet_rt_string_drop(spans)
            perf_spans_fd_set(fd)
        } else {
            // A later attach reads only its own rows.
            perf_spans_truncate()
            perf_zones_set(I64{1})
        }
        if (perf_zones_on != I64{0}) { perf_flight_window_open(path) }
    }
    if (!wanted && perf_zones_on != I64{0}) {
        perf_flight_window_close()
        perf_zones_set(I64{0})
    }
    perf_spans_flush()
}

// `jet perf attach --lens=alloc` asks a flight-recorded run for a heap
// snapshot by leaving `<ring>.heap-request`, a file this user owns
// (perf_flight_owned_at), beside the published ring
// `path`. The publication that finds it answers in `<ring>.heap`, staged
// beside it and renamed over it, then removes the request: first a word,
// the nanoseconds the snapshot held the program's allocations and frees
// (perf_samples_heap_take), or -1 where the run keeps no live list (it was
// not started with `--checked-alloc`); then the snapshot `attach`'s
// records, as a samples file keeps them. Its roots are the image's writable
// segments alone: this thread's frames are the writer's, not the
// program's.
perf_flight_heap: fn(path: I64) {
    request: perf_flight_beside(path, rt_static_text(".heap-request"))
    asked: observe_cstring(request)
    wanted: perf_flight_owned_at(asked, I64{32768}) >= I64{0}
    if (wanted) {
        answer: perf_flight_beside(path, rt_static_text(".heap"))
        staged: perf_flight_beside(path, rt_static_text(".heap.stage"))
        file: observe_cstring(staged)
        word: jet_rt_alloc(I64{8}, I64{8})
        tracked: alloc_check_track_on()
        rt_text_store(word, if (tracked) -> I64{0} else -> I64{-1})
        // O_WRONLY|O_CREAT|O_TRUNC|O_CLOEXEC, mode 0600.
        fd: observe_syscall(I64{257}, I64{-100}, file, I64{524865}, I64{384})
        if (fd >= I64{0}) {
            written := host_write_all(fd, word, I64{8})
            if (written == I64{0} && tracked) {
                // The child writes its records after the word; the hold
                // then takes the word's place (pwrite64 at offset 0).
                rt_text_store(word, perf_samples_heap_take(fd, rt_static_text("attach"), I64{0}))
                if (observe_syscall(I64{18}, fd, word, I64{8}, I64{0}) != I64{8}) {
                    written = I64{-1}
                }
            }
            _ := observe_syscall(I64{3}, fd, I64{0}, I64{0}, I64{0})
            if (written == I64{0}) {
                target: observe_cstring(answer)
                _ := observe_syscall(I64{82}, file, target, I64{0}, I64{0})
                jet_rt_free(target, wrapping(rt_text_len(answer) + I64{1}), I64{1})
            } else { _ := observe_syscall(I64{87}, file, I64{0}, I64{0}, I64{0}) }
        }
        _ := observe_syscall(I64{87}, asked, I64{0}, I64{0}, I64{0})
        jet_rt_free(word, I64{8}, I64{8})
        jet_rt_free(file, wrapping(rt_text_len(staged) + I64{1}), I64{1})
        jet_rt_string_drop(staged)
        jet_rt_string_drop(answer)
    }
    jet_rt_free(asked, wrapping(rt_text_len(request) + I64{1}), I64{1})
    jet_rt_string_drop(request)
}

// Keep a tally record in the ring when the count of records the program
// made and could not write (perf_samples_lost) grew since the ring's last
// tally, or, with `ended` 1, at the exit; the lock is held. The receive
// buffer, which only a drain fills, holds it on its way.
perf_flight_tally: fn(state: I64, ended: I64) {
    lost: perf_samples_lost()
    if (ended == I64{0} && lost == rt_text_word(wrapping(state + PERF_FLIGHT_TALLIED))) {
        return
    }
    record: wrapping(state + PERF_FLIGHT_RECEIVE_AT)
    rt_text_store(record, I64{1} | (PERF_FLIGHT_TALLY_WORDS << PERF_SAMPLES_ADDRESS_BITS) | (PERF_SAMPLES_CLOCK << PERF_SAMPLES_KIND_BITS))
    rt_text_store(wrapping(record + I64{8}), lost)
    rt_text_store(wrapping(record + I64{16}), ended)
    perf_flight_keep(state, record, wrapping(PERF_FLIGHT_TALLY_WORDS * I64{8}))
    rt_text_store(wrapping(state + PERF_FLIGHT_TALLIED), lost)
}

// Publish the ring at `path`; the lock is held. While the file holds the
// ring's first PERF_FLIGHT_PUBLISHED bytes, the records after them are
// written into it in place, so a reader that holds the file open reads on
// into them (one that reads it meanwhile may find the last record cut
// short). Once the ring dropped records the file holds, the whole ring is
// staged beside it and renamed over it, or, the `last` time, written over
// the file's own bytes, which a reader holding it open reads from its
// start; the last time writes nothing where no file was published.
perf_flight_ring: fn(state: I64, path: I64, last: Bool) {
    ring: wrapping(state + PERF_FLIGHT_RING_AT)
    used: rt_text_word(wrapping(state + PERF_FLIGHT_USED))
    published: rt_text_word(wrapping(state + PERF_FLIGHT_PUBLISHED))
    fd := I64{-1}
    if (published >= I64{0} || last) {
        name: observe_cstring(path)
        // O_WRONLY|O_CLOEXEC: the file the last publication left.
        fd = observe_syscall(I64{257}, I64{-100}, name, I64{524289}, I64{0})
        jet_rt_free(name, wrapping(rt_text_len(path) + I64{1}), I64{1})
    }
    if (fd < I64{0}) {
        if (!last && perf_flight_file(path, ring, used)) {
            rt_text_store(wrapping(state + PERF_FLIGHT_PUBLISHED), used)
        }
        return
    }
    from: if (published < I64{0}) -> I64{0} else -> published
    written := perf_flight_pwrite(fd, wrapping(ring + from), wrapping(used - from), from)
    // ftruncate: the whole ring written over a longer file's bytes.
    if (written && published < I64{0}) {
        written = observe_syscall(I64{77}, fd, used, I64{0}, I64{0}) == I64{0}
    }
    _ := observe_syscall(I64{3}, fd, I64{0}, I64{0}, I64{0})
    rt_text_store(wrapping(state + PERF_FLIGHT_PUBLISHED), if (written) -> used else -> I64{-1})
}

// Write the `length` bytes at `bytes` to `fd` from its byte `offset`
// (pwrite64); whether all were.
perf_flight_pwrite: fn(fd: I64, bytes: I64, length: I64, offset: I64) -> Bool {
    at := I64{0}
    loop at < length {
        count: observe_syscall(I64{18}, fd, wrapping(bytes + at), wrapping(length - at), wrapping(offset + at))
        if (count == I64{-4}) { next }
        if (count <= I64{0}) { return false }
        at = wrapping(at + count)
    }
    true
}

// At a run's exit (Observe.jet jet_rt_observe_exit), after the clock
// record (perf_samples_exit): the socket is drained a last time and the
// ring, its last tally saying the run ended, is written into the published
// file in place (perf_flight_ring), so a reader that holds it open reads
// the run's last turn; then the published ring, its image, its zones'
// rows (`.spans`) and its last zones window's records (`.window`) go, at
// once, and no publication follows. A killed run
// removes none of them; the next `jet perf run` or attach does (Session.jet
// jet_cli_perf_sweep).
perf_flight_end: fn() {
    state: perf_flight_state
    if (state == I64{0} || observe_root == I64{0} || !perf_flight_lock(state, I64{100000000})) {
        return
    }
    rt_text_store(wrapping(state + PERF_FLIGHT_ENDED), I64{1})
    writer: sync_load(wrapping(observe_root + I64{72}))
    if (writer != I64{0}) {
        home: perf_flight_home(sync_load(wrapping(writer + I64{96})))
        if (home != I64{0}) {
            path: perf_flight_path(home)
            jet_rt_string_drop(home)
            perf_flight_drain(state)
            perf_flight_tally(state, I64{1})
            perf_flight_ring(state, path, true)
            image: perf_flight_beside(path, rt_static_text(".image"))
            spans: perf_flight_beside(path, rt_static_text(".spans"))
            window: perf_flight_beside(path, rt_static_text(".window"))
            perf_flight_unlink(path)
            perf_flight_unlink(image)
            perf_flight_unlink(spans)
            perf_flight_unlink(window)
            jet_rt_string_drop(window)
            jet_rt_string_drop(spans)
            jet_rt_string_drop(image)
            jet_rt_string_drop(path)
        }
    }
    sync_store(state, I64{0})
}

// The bytes of the ELF file `image`: through its section headers and the
// furthest section's file bytes.
perf_flight_image_bytes: fn(image: I64) -> I64 {
    if (image == I64{0}) { return I64{0} }
    table: rt_text_word(wrapping(image + I64{40}))
    entry: rt_text_word(wrapping(image + I64{58})) & I64{65535}
    count: rt_text_word(wrapping(image + I64{60})) & I64{65535}
    end := wrapping(table + wrapping(entry * count))
    index := I64{0}
    loop index < count {
        header: wrapping(wrapping(image + table) + wrapping(index * entry))
        // SHT_NOBITS takes no file bytes.
        if (rt_text_word(wrapping(header + I64{4})) & I64{4294967295} != I64{8}) {
            last: wrapping(rt_text_word(wrapping(header + I64{24})) + rt_text_word(wrapping(header + I64{32})))
            if (last > end) { end = last }
        }
        index = wrapping(index + I64{1})
    }
    end
}

// Fold the `length` bytes at `bytes` into the FNV-1a hash in the word at
// `digest`.
perf_flight_fold: fn(digest: I64, bytes: I64, length: I64) {
    hash := rt_text_word(digest)
    at := I64{0}
    loop at < length {
        hash = wrapping((hash ~ rt_text_byte(wrapping(bytes + at))) * PERF_FLIGHT_BUILD_PRIME)
        at = wrapping(at + I64{1})
    }
    rt_text_store(digest, hash)
}

// `value` as PERF_FLIGHT_BUILD_DIGITS lowercase hexadecimal digits at
// `at`, the most significant first; the address past them.
perf_flight_hex_digits: fn(at: I64, value: I64) -> I64 {
    index := I64{0}
    loop index < PERF_FLIGHT_BUILD_DIGITS {
        digit: (value >> wrapping(I64{60} - wrapping(index * I64{4}))) & I64{15}
        rt_text_put(wrapping(at + index), if (digit < I64{10}) -> wrapping(I64{48} + digit) else -> wrapping(I64{87} + digit))
        index = wrapping(index + I64{1})
    }
    wrapping(at + PERF_FLIGHT_BUILD_DIGITS)
}

// Copy the image beside the dump as `.jet/dumps/<program>-<build>.image`,
// `build` its hash in hexadecimal, unless a copy of that build is there:
// redacted as the dump is, owner-only, written beside it with `~` after
// its name and renamed over it, so a copy is whole or absent. Whether the
// copy is there. The dump's path at `text` names the directory and the
// program (perf_flight_dump_open).
perf_flight_image: fn(state: I64, text: I64, zeros: I64, image: I64, length: I64, build: I64) -> Bool {
    named: wrapping(text + PERF_FLIGHT_OLDEST_AT)
    head: wrapping(I64{11} + rt_text_word(wrapping(state + PERF_FLIGHT_PREFIX)))
    rt_text_bytes_copy(named, text, head)
    end: perf_flight_text(perf_flight_hex_digits(wrapping(named + head), build), rt_static_text(".image"))
    // faccessat(AT_FDCWD, named, F_OK)
    if (perf_flight_syscall(I64{269}, I64{-100}, named, I64{0}) == I64{0}) { return true }
    staging: wrapping(text + PERF_FLIGHT_STAGING_AT)
    size: wrapping(end - named)
    rt_text_bytes_copy(staging, named, size)
    _ := perf_flight_text(wrapping(staging + size), rt_static_text("~"))
    // O_WRONLY|O_CREAT|O_TRUNC|O_CLOEXEC, mode 0600.
    fd := I64{-1}
    #Unsafe("openat reads the image copy's NUL-terminated path in the state's text page") {
        fd = os_syscall_i64(I64{257}, I64{-100}, staging, I64{524865}, I64{384}, I64{0}, I64{0})
    }
    if (fd < I64{0}) { return false }
    good: perf_flight_redacted(fd, state, zeros, image, length, false, I64{0})
    _ := perf_flight_syscall(I64{3}, fd, I64{0}, I64{0})
    // rename
    if (good && perf_flight_syscall(I64{82}, staging, named, I64{0}) == I64{0}) { return true }
    _ := perf_flight_syscall(I64{87}, staging, I64{0}, I64{0})
    false
}

// A stop that ends the process (Trap.jet trap_root_prepare, through
// Observe.jet jet_rt_observe_exit), under the flight recorder: the typed
// dump `jet debug` opens, `.jet/dumps/<program>-<UTC time>.jetdump`,
// owner-only, of which the newest PERF_FLIGHT_DUMPS_KEPT stay. Its words:
// PERF_FLIGHT_MAGIC, PERF_FLIGHT_VERSION, the pid, the Unix time, the load
// bias, the stopping thread's rip, rsp and rbp, where it captured itself in
// this frame (perf_flight_capture) or else as its caller resumes, its
// tid, the image's byte count, the task registry's root (Observe.jet
// observe_root), whose tasks name their controls and so the wait a
// deadlock held each in, and the image's build hash (perf_flight_fold);
// then the sections: the ring, every task's registers
// (perf_flight_tasks), the memory the stop reaches from every thread's and
// task's stack and the globals within PERF_FLIGHT_DUMP_BUDGET, and the
// ranges cut off past it (perf_flight_reach). The image is not in the
// dump: the hash names its copy beside it, written once per build
// (perf_flight_image), so a dump holds the stop alone. The other
// threads wait in their capture until the dump is written, so the stacks
// it holds are the ones their registers name. Every byte after its words
// is written redacted (perf_flight_redacted), so no dump holds a live
// Secret's bytes nor a copy's in memory, and no image copy its literal's;
// the live Secrets are scrubbed once both are written. Nothing here
// allocates: the state's scratch serves every buffer.
perf_flight_dump: fn() {
    state: perf_flight_state
    if (state == I64{0} || sync_swap(wrapping(state + PERF_FLIGHT_DUMPED), I64{1}) != I64{0}) {
        return
    }
    frame: alloc_check_caller_frame()
    scrub: secret_scrub_code
    text: wrapping(state + PERF_FLIGHT_TEXT_AT)
    words: wrapping(text + PERF_FLIGHT_WORDS_AT)
    zeros: wrapping(text + PERF_FLIGHT_ZEROS_AT)
    // The stopping thread's callee-saved registers, rip, rsp and rbp, as
    // perf_flight_capture takes them when the tgkill to itself returns
    // here, in this frame the dump outlives, so its debugger unwinds the
    // callee-saved registers from here (the frames' call frame rules).
    // Without the capture, its rip, rsp and rbp as its caller resumes.
    stop: wrapping(text + PERF_FLIGHT_STOP_AT)
    // What the captured threads and the held tasks (perf_flight_await) wait
    // on: PERF_FLIGHT_RELEASED once the dump is written or can't be.
    release: wrapping(text + PERF_FLIGHT_RELEASE_AT)
    process: perf_flight_syscall(I64{39}, I64{0}, I64{0}, I64{0})
    me: thread_tid()
    sync_store(wrapping(text + PERF_FLIGHT_SELF_AT), me)
    if (perf_flight_handle() >= I64{0}) {
        #Unsafe("tgkill of this thread, whose handler copies the registers it interrupts into the text page and returns") {
            _ := os_syscall_i64(I64{234}, process, me, PERF_FLIGHT_CAPTURE_SIGNAL, I64{0}, I64{0}, I64{0})
        }
    }
    if (rt_text_word(wrapping(stop + I64{16})) == I64{0} && frame != I64{0}) {
        rt_text_store(wrapping(stop + I64{16}), rt_text_word(wrapping(frame + I64{8})))
        rt_text_store(wrapping(stop + I64{24}), wrapping(frame + I64{16}))
        rt_text_store(wrapping(stop + I64{32}), rt_text_word(frame))
        rt_text_store(wrapping(stop + I64{48}), PERF_FLIGHT_TASK_RBP)
        rt_text_store(wrapping(stop + I64{88}), rt_text_word(frame))
    }
    fd: perf_flight_dump_open(state, text, words)
    if (fd < I64{0}) {
        if (scrub != I64{0}) { _ := coll_call1(scrub, I64{0}) }
        sync_store(release, PERF_FLIGHT_RELEASED)
        sync_futex_wake(release, I64{2147483647})
        return
    }
    image: perf_samples_image
    length: perf_flight_image_bytes(image)
    // Header word 11, the image's build: the FNV-1a hash of its bytes as
    // its copy holds them (perf_flight_image), redacted as they are
    // written, so a reader checks the copy against it.
    rt_text_store(wrapping(words + I64{88}), PERF_FLIGHT_BUILD_OFFSET)
    _ := perf_flight_redacted(I64{-1}, state, zeros, image, length, false, wrapping(words + I64{88}))
    build: rt_text_word(wrapping(words + I64{88}))
    rt_text_store(words, PERF_FLIGHT_MAGIC)
    rt_text_store(wrapping(words + I64{8}), PERF_FLIGHT_VERSION)
    rt_text_store(wrapping(words + I64{16}), process)
    // perf_flight_time read the clock into the words at 128.
    rt_text_store(wrapping(words + I64{24}), rt_text_word(wrapping(words + I64{128})))
    rt_text_store(wrapping(words + I64{32}), perf_samples_bias)
    rt_text_store(wrapping(words + I64{40}), rt_text_word(wrapping(stop + I64{16})))
    rt_text_store(wrapping(words + I64{48}), rt_text_word(wrapping(stop + I64{24})))
    rt_text_store(wrapping(words + I64{56}), rt_text_word(wrapping(stop + I64{32})))
    rt_text_store(wrapping(words + I64{64}), me)
    rt_text_store(wrapping(words + I64{72}), length)
    rt_text_store(wrapping(words + I64{80}), observe_root)
    rt_text_store(wrapping(words + I64{88}), build)
    good := perf_flight_bytes(fd, zeros, words, PERF_FLIGHT_HEADER)
    if (good && perf_flight_lock(state, I64{10000000})) {
        perf_flight_drain(state)
        good = perf_flight_section(fd, state, words, zeros, PERF_FLIGHT_SECTION_RING, I64{0}, wrapping(state + PERF_FLIGHT_RING_AT), rt_text_word(wrapping(state + PERF_FLIGHT_USED)))
        sync_store(state, I64{0})
    }
    if (good) { good = perf_flight_tasks(fd, state, words, zeros) }
    if (good) { good = perf_flight_reach(fd, state, words, zeros) }
    if (good) {
        _ := perf_flight_section(fd, state, words, zeros, PERF_FLIGHT_SECTION_END, I64{0}, I64{0}, I64{0})
    }
    // The image's copy is redacted as the dump is, so it is written before
    // the Secrets are scrubbed.
    if (good) { _ := perf_flight_image(state, text, zeros, image, length, build) }
    if (scrub != I64{0}) { _ := coll_call1(scrub, I64{0}) }
    _ := perf_flight_syscall(I64{3}, fd, I64{0}, I64{0})
    sync_store(release, PERF_FLIGHT_RELEASED)
    sync_futex_wake(release, I64{2147483647})
    perf_flight_rotate(state, text)
    said: rt_static_text("dump written: ")
    _ := perf_flight_syscall(I64{1}, I64{2}, rt_text_data(said), rt_text_len(said))
    _ := perf_flight_syscall(I64{1}, I64{2}, text, perf_flight_length(text))
    newline: rt_static_text("\n")
    _ := perf_flight_syscall(I64{1}, I64{2}, rt_text_data(newline), rt_text_len(newline))
}

// A task of a deadlock whose cycle holds the root (WaitCycle.jet
// wait_cycle_stop), under the flight recorder: it waits where it waited
// until the root's stop has written its dump, so the dump holds its stack,
// its frames and their locals as the deadlock left them, not the task's
// unwinding. It blocks its thread on the futex, a fiber's carrier too, so
// the dump captures it as a running thread (perf_flight_capture), and the
// dump's futex wake, which takes no lock, lets it go on to its own stop
// while the root's cleanup runs. Should no dump come within
// PERF_FLIGHT_HOLD_NS, it goes on all the same.
perf_flight_await: fn() {
    state: perf_flight_state
    if (state == I64{0}) {
        return
    }
    release: wrapping(wrapping(state + PERF_FLIGHT_TEXT_AT) + PERF_FLIGHT_RELEASE_AT)
    deadline: sync_deadline(PERF_FLIGHT_HOLD_NS)
    loop sync_load(release) != PERF_FLIGHT_RELEASED {
        if (sync_futex_wait(release, sync_load(release), deadline) == I64{-110}) {
            return
        }
    }
}

// The dump's task rows (PERF_FLIGHT_SECTION_TASKS): the stopping thread's
// first, as it captured itself (perf_flight_dump), then each other
// thread's of the live registry (Thread.jet thread_register_tcb), each
// captured by PERF_FLIGHT_CAPTURE_SIGNAL in its handler
// (perf_flight_capture), which writes its row and waits there, and each
// parked or queued fiber's, from the stack its last switch saved: the
// resume address, then six callee-saved registers, rbp the last. The
// registry's lock is held while the threads are signaled and the fibers
// read, so none starts or ends meanwhile; the rows of the threads that
// have not answered within PERF_FLIGHT_CAPTURE_NS are left out.
perf_flight_tasks: fn(fd: I64, state: I64, words: I64, zeros: I64) -> Bool {
    scratch: wrapping(state + PERF_FLIGHT_SCRATCH_AT)
    text: wrapping(state + PERF_FLIGHT_TEXT_AT)
    answered: wrapping(text + PERF_FLIGHT_ANSWERED_AT)
    release: wrapping(text + PERF_FLIGHT_RELEASE_AT)
    thread_zero(scratch, wrapping(wrapping(PERF_FLIGHT_TASKS_MAX * PERF_FLIGHT_TASK_WORDS) * I64{8}))
    process: perf_flight_syscall(I64{39}, I64{0}, I64{0}, I64{0})
    me: thread_tid()
    stop: wrapping(text + PERF_FLIGHT_STOP_AT)
    first: perf_flight_row(state, I64{0}, perf_flight_task(thread_base(), me == process), PERF_FLIGHT_TASK_STOPPED, rt_text_word(wrapping(stop + I64{16})), rt_text_word(wrapping(stop + I64{24})), rt_text_word(wrapping(stop + I64{32})), me)
    word := I64{6}
    loop word < PERF_FLIGHT_TASK_WORDS {
        rt_text_store(wrapping(first + wrapping(word * I64{8})), rt_text_word(wrapping(stop + wrapping(word * I64{8}))))
        word = wrapping(word + I64{1})
    }
    sync_store(wrapping(state + PERF_FLIGHT_CLAIMED), I64{1})
    sync_store(answered, I64{0})
    sync_store(release, PERF_FLIGHT_CAPTURING)
    registry: thread_tls_registry
    if (registry != I64{0}) {
        sync_mutex_lock(registry)
        live: wrapping(registry + I64{64})
        data: sync_load(wrapping(live + I64{16}))
        count: sync_load(live)
        status := I64{1}
        sent := I64{0}
        at := I64{0}
        loop at < count {
            tid: sync_load(wrapping(data + wrapping(at * I64{8})))
            tcb: sync_load(wrapping(data + wrapping(wrapping(at + I64{1}) * I64{8})))
            at = wrapping(at + I64{2})
            // A fiber's row is [tcb, tcb].
            if (tid == tcb) {
                perf_flight_fiber(state, tcb)
                next
            }
            if (tid == me) { next }
            if (status == I64{1}) { status = perf_flight_handle() }
            if (status < I64{0}) { next }
            // tgkill of a live registered thread of this process.
            if (perf_flight_syscall(I64{234}, process, tid, PERF_FLIGHT_CAPTURE_SIGNAL) == I64{0}) {
                sent = wrapping(sent + I64{1})
            }
        }
        deadline: sync_deadline(PERF_FLIGHT_CAPTURE_NS)
        loop sync_load(answered) < sent {
            if (sync_futex_wait(answered, sync_load(answered), deadline) == I64{-110}) { break }
        }
        sync_mutex_unlock(registry)
    }
    sync_store(release, PERF_FLIGHT_CLOSED)
    claimed: sync_load(wrapping(state + PERF_FLIGHT_CLAIMED))
    rows: if (claimed > PERF_FLIGHT_TASKS_MAX) -> PERF_FLIGHT_TASKS_MAX else -> claimed
    perf_flight_section(fd, state, words, zeros, PERF_FLIGHT_SECTION_TASKS, I64{0}, scratch, wrapping(wrapping(rows * PERF_FLIGHT_TASK_WORDS) * I64{8}))
}

// The row of a parked or queued fiber whose TCB is `tcb` and that runs a
// task, from the stack its last switch saved; a fresh fiber, not yet
// switched from, has none.
perf_flight_fiber: fn(state: I64, tcb: I64) {
    fiber: sync_load(wrapping(tcb + I64{56}))
    if (fiber == I64{0}) {
        return
    }
    status: sync_load(fiber)
    job: sync_load(wrapping(fiber + I64{56}))
    saved: sync_load(wrapping(fiber + I64{8}))
    if ((status != FIBER_PARKED && status != FIBER_RUNNABLE) || job == I64{0} || job == FIBER_JOB_TEARDOWN || saved == I64{0}) {
        return
    }
    resume: rt_text_word(saved)
    id: perf_flight_task(tcb, false)
    if (resume == rt_fiber_entry_address() || id == I64{0}) {
        return
    }
    index: sync_add(wrapping(state + PERF_FLIGHT_CLAIMED), I64{1})
    if (index < PERF_FLIGHT_TASKS_MAX) {
        row: perf_flight_row(state, index, id, PERF_FLIGHT_TASK_PARKED, resume, wrapping(saved + I64{56}), rt_text_word(wrapping(saved + I64{48})), I64{0})
        // r15, r14, r13 and r12 as the kernel orders them; rbx and rbp
        // the other way round.
        rt_text_store(wrapping(row + I64{56}), rt_text_word(wrapping(saved + I64{8})))
        rt_text_store(wrapping(row + I64{64}), rt_text_word(wrapping(saved + I64{16})))
        rt_text_store(wrapping(row + I64{72}), rt_text_word(wrapping(saved + I64{24})))
        rt_text_store(wrapping(row + I64{80}), rt_text_word(wrapping(saved + I64{32})))
        rt_text_store(wrapping(row + I64{88}), rt_text_word(wrapping(saved + I64{48})))
        rt_text_store(wrapping(row + I64{96}), rt_text_word(wrapping(saved + I64{40})))
        rt_text_store(wrapping(row + I64{48}), PERF_FLIGHT_TASK_SAVED)
    }
}

// A thread the dump captures (perf_flight_tasks), in the handler of
// PERF_FLIGHT_CAPTURE_SIGNAL: its row, from the registers it was
// interrupted at (perf_flight_context), then it waits until the dump is
// written, so its stack stays as its row says. A capture the dump no
// longer waits for writes no row. The stopping thread, which signals
// itself (perf_flight_dump), only leaves its registers in the text page.
// Where the signal interrupts a frame that holds nothing but its link (rsp
// at rbp: os_syscall_i64's, when the tgkill is a call), the dump's own
// calls overwrite that frame before it copies the stack, so the registers
// are those of its caller, perf_flight_dump, as the frame returns into it:
// the saved rbp and return address read while they last, the callee-saved
// registers as the frame left them, the rest unknown.
perf_flight_capture: fn(context: I64) {
    state: perf_flight_state
    if (state == I64{0} || context == I64{0}) {
        return
    }
    text: wrapping(state + PERF_FLIGHT_TEXT_AT)
    tid: thread_tid()
    if (tid == sync_load(wrapping(text + PERF_FLIGHT_SELF_AT))) {
        stop: wrapping(text + PERF_FLIGHT_STOP_AT)
        perf_flight_context(stop, context)
        frame: rt_text_word(wrapping(context + I64{120}))
        if (frame != I64{0} && frame == rt_text_word(wrapping(context + I64{160}))) {
            caller: rt_text_word(frame)
            rt_text_store(wrapping(stop + I64{16}), rt_text_word(wrapping(frame + I64{8})))
            rt_text_store(wrapping(stop + I64{24}), wrapping(frame + I64{16}))
            rt_text_store(wrapping(stop + I64{32}), caller)
            rt_text_store(wrapping(stop + I64{48}), PERF_FLIGHT_TASK_SAVED)
            rt_text_store(wrapping(stop + I64{88}), caller)
            word := I64{6}
            loop word < PERF_FLIGHT_TASK_REGISTERS {
                rt_text_store(wrapping(stop + wrapping(I64{56} + wrapping(word * I64{8}))), I64{0})
                word = wrapping(word + I64{1})
            }
        }
        return
    }
    release: wrapping(text + PERF_FLIGHT_RELEASE_AT)
    if (sync_load(release) != PERF_FLIGHT_CAPTURING) {
        return
    }
    index: sync_add(wrapping(state + PERF_FLIGHT_CLAIMED), I64{1})
    if (index < PERF_FLIGHT_TASKS_MAX) {
        main: tid == perf_flight_syscall(I64{39}, I64{0}, I64{0}, I64{0})
        row: perf_flight_row(state, index, perf_flight_task(thread_base(), main), PERF_FLIGHT_TASK_RUNNING, I64{0}, I64{0}, I64{0}, tid)
        perf_flight_context(row, context)
    }
    answered: wrapping(text + PERF_FLIGHT_ANSWERED_AT)
    _ := sync_add(answered, I64{1})
    sync_futex_wake(answered, I64{1})
    loop sync_load(release) != PERF_FLIGHT_RELEASED {
        _ := sync_futex_wait(release, sync_load(release), I64{-1})
    }
}

// The observed task the TCB `tcb` runs (Observe.jet observe_task_key, read
// from its TLS as jet_rt_tls_get reads it): the process's main thread,
// `main`, outside every other task is task 1; any other thread outside
// every task is 0.
perf_flight_task: fn(tcb: I64, main: Bool) -> I64 {
    key: observe_task_key
    table: if (tcb == I64{0}) -> I64{0} else -> sync_load(wrapping(tcb + I64{208}))
    id: if (table == I64{0} || key <= I64{0} || key > sync_load(table)) -> I64{0} else -> sync_load(wrapping(sync_load(wrapping(table + I64{16})) + wrapping(wrapping(key - I64{1}) * I64{8})))
    if (id == I64{0} && main) -> I64{1} else -> id
}

// Row `index` of the dump's tasks in the state's scratch; its address.
perf_flight_row: fn(state: I64, index: I64, id: I64, how: I64, rip: I64, rsp: I64, rbp: I64, tid: I64) -> I64 {
    row: wrapping(wrapping(state + PERF_FLIGHT_SCRATCH_AT) + wrapping(wrapping(index * PERF_FLIGHT_TASK_WORDS) * I64{8}))
    rt_text_store(row, id)
    rt_text_store(wrapping(row + I64{8}), how)
    rt_text_store(wrapping(row + I64{16}), rip)
    rt_text_store(wrapping(row + I64{24}), rsp)
    rt_text_store(wrapping(row + I64{32}), rbp)
    rt_text_store(wrapping(row + I64{40}), tid)
    row
}

// The registers of the row at `row` from the ones a signal interrupted
// (ucontext_t's general registers from 40, in their own order, the k-th
// of the row's the one PERF_FLIGHT_TASK_GREGS names at bits 4k), all
// known: its rip, rsp and rbp at 168, 160 and 120, then the general ones.
perf_flight_context: fn(row: I64, context: I64) {
    rt_text_store(wrapping(row + I64{16}), rt_text_word(wrapping(context + I64{168})))
    rt_text_store(wrapping(row + I64{24}), rt_text_word(wrapping(context + I64{160})))
    rt_text_store(wrapping(row + I64{32}), rt_text_word(wrapping(context + I64{120})))
    word := I64{0}
    loop word < PERF_FLIGHT_TASK_REGISTERS {
        greg: (PERF_FLIGHT_TASK_GREGS >> wrapping(word * I64{4})) & I64{15}
        rt_text_store(wrapping(row + wrapping(I64{56} + wrapping(word * I64{8}))), rt_text_word(wrapping(context + wrapping(I64{40} + wrapping(greg * I64{8})))))
        word = wrapping(word + I64{1})
    }
    rt_text_store(wrapping(row + I64{48}), PERF_FLIGHT_TASK_KNOWN)
}

// Install the sampler's handler (jet_rt_perf_samples_signal) for
// PERF_FLIGHT_CAPTURE_SIGNAL; the status, negative when it cannot be.
perf_flight_handle: fn() -> I64 {
    status := I64{-1}
    #Unsafe("rt_sigaction borrows the four-word action on the stack; the handler is this runtime's three-word C-ABI export and the restorer its rt_sigreturn rail") {
        status = os_syscall_stack4_i64(I64{13}, PERF_FLIGHT_CAPTURE_SIGNAL, rt_perf_samples_signal_address(), I64{469762052}, rt_process_signal_restore_address(), I64{0}, I64{8})
    }
    status
}

// A raw system call of the dump's, which neither allocates nor records.
perf_flight_syscall: fn(number: I64, a: I64, b: I64, c: I64) -> I64 {
    #Unsafe("the dump's file, directory and clock calls borrow the state's scratch or the process's own mappings for their duration") {
        return os_syscall_i64(number, a, b, c, I64{0}, I64{0}, I64{0})
    }
}

// Write `length` bytes at `address` to the dump; zeros stand for a page
// the kernel cannot read. False when the file refuses them.
perf_flight_bytes: fn(fd: I64, zeros: I64, address: I64, length: I64) -> Bool {
    at := I64{0}
    loop at < length {
        count: perf_flight_syscall(I64{1}, fd, wrapping(address + at), wrapping(length - at))
        if (count == I64{-4}) { next }
        if (count == I64{-14}) {
            // EFAULT: zeros up to the next PERF_FLIGHT_ZEROS boundary.
            offset: wrapping(address + at) & wrapping(PERF_FLIGHT_ZEROS - I64{1})
            gap := wrapping(PERF_FLIGHT_ZEROS - offset)
            if (gap > wrapping(length - at)) { gap = wrapping(length - at) }
            if (perf_flight_syscall(I64{1}, fd, zeros, gap) != gap) { return false }
            at = wrapping(at + gap)
            next
        }
        if (count <= I64{0}) { return false }
        at = wrapping(at + count)
    }
    true
}

// One section of the dump: its three words, then its `length` bytes at
// `bytes`, redacted and padded to a word.
perf_flight_section: fn(fd: I64, state: I64, words: I64, zeros: I64, kind: I64, address: I64, bytes: I64, length: I64) -> Bool {
    head: wrapping(words + I64{96})
    rt_text_store(head, kind)
    rt_text_store(wrapping(head + I64{8}), address)
    rt_text_store(wrapping(head + I64{16}), length)
    perf_flight_bytes(fd, zeros, head, I64{24}) && perf_flight_redacted(fd, state, zeros, bytes, length, false, I64{0}) && perf_flight_bytes(fd, zeros, zeros, wrapping(I64{0} - length) & I64{7})
}

// Write `length` bytes at `address` as perf_flight_bytes does, with every
// run of a live Secret's bytes and every byte of a live Secret's buffer
// zeroed (Secret.jet secret_redact). Each window of PERF_FLIGHT_COPY bytes
// is copied to the state's copy and redacted there, and written up to where
// a run could still start that the window does not hold whole; the next
// window starts there, and zeroes the rest of a run this one began. When
// `scan`, each window written reaches what its words point to
// (perf_flight_scan), so it is staged even with no Secret live. With a
// `digest` word, the bytes are folded into its hash (perf_flight_fold)
// as they would be written, and `fd` is not written.
perf_flight_redacted: fn(fd: I64, state: I64, zeros: I64, address: I64, length: I64, scan: Bool, digest: I64) -> Bool {
    table: wrapping(state + PERF_FLIGHT_SECRETS_AT)
    width: secret_redact_table(table, PERF_FLIGHT_SECRETS, PERF_FLIGHT_COPY / I64{2})
    if (width == I64{0} && !scan && digest == I64{0}) {
        return perf_flight_bytes(fd, zeros, address, length)
    }
    staged: wrapping(state + PERF_FLIGHT_COPY_AT)
    reach := I64{0}
    at := I64{0}
    loop at < length {
        left: wrapping(length - at)
        window: if (left < PERF_FLIGHT_COPY) -> left else -> PERF_FLIGHT_COPY
        perf_flight_read(state, staged, wrapping(address + at), window)
        step := window
        if (width != I64{0}) {
            until: if (reach > at) -> wrapping(reach - at) else -> I64{0}
            reach = wrapping(at + secret_redact(table, staged, window, wrapping(address + at), until))
            if (window < left) { step = wrapping(window - wrapping(width - I64{1})) }
        }
        if (scan) { perf_flight_scan(state, staged, wrapping(address + at), step) }
        if (digest != I64{0}) { perf_flight_fold(digest, staged, step) }
        if (digest == I64{0} && !perf_flight_bytes(fd, zeros, staged, step)) { return false }
        at = wrapping(at + step)
    }
    true
}

// Copy `length` bytes at `address` to `into` through process_vm_readv, so
// a page the kernel cannot read copies as zeros instead of faulting.
perf_flight_read: fn(state: I64, into: I64, address: I64, length: I64) {
    vectors: wrapping(state + PERF_FLIGHT_VECTORS_AT)
    process: perf_flight_syscall(I64{39}, I64{0}, I64{0}, I64{0})
    at := I64{0}
    loop at < length {
        rt_text_store(vectors, wrapping(into + at))
        rt_text_store(wrapping(vectors + I64{8}), wrapping(length - at))
        rt_text_store(wrapping(vectors + I64{16}), wrapping(address + at))
        rt_text_store(wrapping(vectors + I64{24}), wrapping(length - at))
        count: perf_flight_readv(process, vectors)
        if (count == I64{-4}) { next }
        if (count > I64{0}) {
            at = wrapping(at + count)
            next
        }
        gap := wrapping(I64{4096} - (wrapping(address + at) & I64{4095}))
        if (gap > wrapping(length - at)) { gap = wrapping(length - at) }
        end: wrapping(at + gap)
        loop at < end {
            rt_text_put(wrapping(into + at), I64{0})
            at = wrapping(at + I64{1})
        }
    }
}

// process_vm_readv of this process: the one local and one remote vector at
// `vectors`.
perf_flight_readv: fn(process: I64, vectors: I64) -> I64 {
    #Unsafe("the vectors name the state's copy and a range of this process's own mappings; the kernel copies between them, faulting on neither") {
        return os_syscall_i64(I64{310}, process, vectors, I64{1}, wrapping(vectors + I64{16}), I64{1}, I64{0})
    }
}

// The digit value of hexadecimal byte `byte`, or -1.
perf_flight_hex: fn(byte: I64) -> I64 {
    if (byte >= I64{48} && byte <= I64{57}) { return wrapping(byte - I64{48}) }
    if (byte >= I64{97} && byte <= I64{102}) { return wrapping(byte - I64{87}) }
    I64{-1}
}

// The hexadecimal number at `at` in the `length` bytes at `scratch`, and
// the offset past it, in the words at `into`.
perf_flight_number: fn(scratch: I64, length: I64, at: I64, into: I64) {
    value := I64{0}
    cursor := at
    loop cursor < length && perf_flight_hex(rt_text_byte(wrapping(scratch + cursor))) >= (I64{0}) {
        value = (value << I64{4}) | perf_flight_hex(rt_text_byte(wrapping(scratch + cursor)))
        cursor = wrapping(cursor + I64{1})
    }
    rt_text_store(into, value)
    rt_text_store(wrapping(into + I64{8}), cursor)
}

// The memory the dump holds: what the stop can reach, within
// PERF_FLIGHT_DUMP_BUDGET. The roots are each task row's stack, from the
// page of its rsp less the red zone up past the outermost frame its
// frame-pointer chain reaches in that mapping, and each mapping the chain
// reaches (a deeper stack segment's bridge frame names the one it grew
// from: StackSegment.jet), then the image's
// writable segments, its globals. Each range held is written as a memory
// section and every aligned word in it that points into a writable mapping
// of /proc/self/maps reaches more: the pointer's page (a small block never
// crosses one: Alloc.jet), or a large block's whole mapping when the two
// words before the pointer name the mapping that starts on its page. Ranges
// are held whole pages at a time in the order they are reached, each page
// once; past the budget the rest of a reached range is cut off and listed
// in the cut section, so `jet debug` shows a value there as cut off. The
// walk is conservative, a superset of what the program's typed pointers
// reach: the stop cannot read the image's types without allocating.
perf_flight_reach: fn(fd: I64, state: I64, words: I64, zeros: I64) -> Bool {
    walk: wrapping(state + PERF_FLIGHT_WALK_AT)
    image: perf_samples_image
    rt_text_store(wrapping(walk + I64{48}), wrapping(image + perf_flight_image_bytes(image)))
    perf_flight_spans(state, words)
    // The task rows perf_flight_tasks left in the scratch.
    claimed: sync_load(wrapping(state + PERF_FLIGHT_CLAIMED))
    rows: if (claimed > PERF_FLIGHT_TASKS_MAX) -> PERF_FLIGHT_TASKS_MAX else -> claimed
    scratch: wrapping(state + PERF_FLIGHT_SCRATCH_AT)
    index := I64{0}
    loop index < rows {
        row: wrapping(scratch + wrapping(wrapping(index * PERF_FLIGHT_TASK_WORDS) * I64{8}))
        perf_flight_stack(state, rt_text_word(wrapping(row + I64{24})), rt_text_word(wrapping(row + I64{32})))
        index = wrapping(index + I64{1})
    }
    perf_flight_globals(state)
    queue: wrapping(state + PERF_FLIGHT_QUEUE_AT)
    loop rt_text_word(wrapping(walk + I64{8})) < rt_text_word(wrapping(walk + I64{16})) {
        head: rt_text_word(wrapping(walk + I64{8}))
        rt_text_store(wrapping(walk + I64{8}), wrapping(head + I64{1}))
        entry: wrapping(queue + wrapping(head * I64{16}))
        address: rt_text_word(entry)
        length: rt_text_word(wrapping(entry + I64{8}))
        if (!perf_flight_section_scanned(fd, state, words, zeros, address, length)) { return false }
    }
    cuts: wrapping(state + PERF_FLIGHT_CUTS_AT)
    rt_text_store(cuts, PERF_FLIGHT_DUMP_BUDGET)
    rt_text_store(wrapping(cuts + I64{8}), rt_text_word(wrapping(walk + I64{24})))
    rt_text_store(wrapping(cuts + I64{16}), rt_text_word(wrapping(walk + I64{40})))
    rt_text_store(wrapping(cuts + I64{24}), rt_text_word(wrapping(walk + I64{32})))
    perf_flight_section(fd, state, words, zeros, PERF_FLIGHT_SECTION_CUT, I64{0}, cuts, wrapping(I64{32} + wrapping(rt_text_word(wrapping(walk + I64{32})) * I64{16})))
}

// A memory section of the `length` bytes at `address`, each aligned word
// of them reaching more (perf_flight_follow).
perf_flight_section_scanned: fn(fd: I64, state: I64, words: I64, zeros: I64, address: I64, length: I64) -> Bool {
    head: wrapping(words + I64{96})
    rt_text_store(head, PERF_FLIGHT_SECTION_MEMORY)
    rt_text_store(wrapping(head + I64{8}), address)
    rt_text_store(wrapping(head + I64{16}), length)
    perf_flight_bytes(fd, zeros, head, I64{24}) && perf_flight_redacted(fd, state, zeros, address, length, true, I64{0}) && perf_flight_bytes(fd, zeros, zeros, wrapping(I64{0} - length) & I64{7})
}

// Each readable and writable mapping of /proc/self/maps, in address order,
// into the walk's spans, at most PERF_FLIGHT_SPANS of them. The maps' text
// is read into the state's copy, which the walk's sections reuse after.
perf_flight_spans: fn(state: I64, words: I64) {
    walk: wrapping(state + PERF_FLIGHT_WALK_AT)
    spans: wrapping(state + PERF_FLIGHT_SPANS_AT)
    text: wrapping(state + PERF_FLIGHT_COPY_AT)
    path: wrapping(words + I64{160})
    _ := perf_flight_text(path, rt_static_text("/proc/self/maps"))
    // O_RDONLY|O_CLOEXEC.
    maps: perf_flight_syscall(I64{257}, I64{-100}, path, I64{524288})
    if (maps < I64{0}) {
        return
    }
    length := I64{0}
    loop length < PERF_FLIGHT_COPY {
        count: perf_flight_syscall(I64{0}, maps, wrapping(text + length), wrapping(PERF_FLIGHT_COPY - length))
        if (count == I64{-4}) { next }
        if (count <= I64{0}) { break }
        length = wrapping(length + count)
    }
    _ := perf_flight_syscall(I64{3}, maps, I64{0}, I64{0})
    parsed: wrapping(words + I64{144})
    held := I64{0}
    at := I64{0}
    loop at < length && held < PERF_FLIGHT_SPANS {
        perf_flight_number(text, length, at, parsed)
        start: rt_text_word(parsed)
        perf_flight_number(text, length, wrapping(rt_text_word(wrapping(parsed + I64{8})) + I64{1}), parsed)
        end: rt_text_word(parsed)
        at = wrapping(rt_text_word(wrapping(parsed + I64{8})) + I64{1})
        // The permissions: `r` then `w`.
        writable: wrapping(at + I64{1}) < length && rt_text_byte(wrapping(text + at)) == I64{114} && rt_text_byte(wrapping(wrapping(text + at) + I64{1})) == I64{119}
        loop at < length && rt_text_byte(wrapping(text + at)) != (I64{10}) {
            at = wrapping(at + I64{1})
        }
        at = wrapping(at + I64{1})
        if (writable && end > start) {
            row: wrapping(spans + wrapping(held * I64{16}))
            rt_text_store(row, start)
            rt_text_store(wrapping(row + I64{8}), end)
            held = wrapping(held + I64{1})
        }
    }
    rt_text_store(walk, held)
}

// The index of the walk's span that holds `address`, or -1.
perf_flight_span: fn(state: I64, address: I64) -> I64 {
    spans: wrapping(state + PERF_FLIGHT_SPANS_AT)
    low := I64{0}
    high := rt_text_word(wrapping(state + PERF_FLIGHT_WALK_AT))
    loop low < high {
        middle: wrapping(low + high) >> I64{1}
        row: wrapping(spans + wrapping(middle * I64{16}))
        if (address < rt_text_word(row)) {
            high = middle
            next
        }
        if (address >= rt_text_word(wrapping(row + I64{8}))) {
            low = wrapping(middle + I64{1})
            next
        }
        return middle
    }
    I64{-1}
}

// The start (`end` false) or end of the walk's span `index`.
perf_flight_span_bound: fn(state: I64, index: I64, end: Bool) -> I64 {
    row: wrapping(wrapping(state + PERF_FLIGHT_SPANS_AT) + wrapping(index * I64{16}))
    if (end) { return rt_text_word(wrapping(row + I64{8})) }
    rt_text_word(row)
}

// The stack of a task row whose registers are `rsp` and `rbp`: from rsp
// less the red zone, then from each frame where the frame-pointer chain
// enters another mapping, each up past the chain's outermost frame there
// (perf_flight_stack_run), each from its page's start (perf_flight_take).
// A stack's mapping is no bound: fiber stacks share one mapping (Fiber.jet
// fiber_new), so its end would take every neighbor's whole stack.
perf_flight_stack: fn(state: I64, rsp: I64, rbp: I64) {
    span: perf_flight_span(state, rsp)
    if (span < I64{0}) {
        return
    }
    low: perf_flight_span_bound(state, span, false)
    holder := span
    start := if (wrapping(rsp - I64{128}) < low) -> low else -> wrapping(rsp - I64{128})
    top := I64{0}
    read: wrapping(wrapping(state + PERF_FLIGHT_WALK_AT) + I64{56})
    frame := rbp
    steps := I64{0}
    loop frame != (I64{0}) && (frame & I64{7}) == (I64{0}) && steps < PERF_FLIGHT_FRAMES {
        within: perf_flight_span(state, frame)
        if (within < I64{0}) { break }
        if (within != holder) {
            perf_flight_stack_run(state, holder, start, top)
            holder = within
            start = frame
        }
        top = frame
        perf_flight_read(state, read, frame, I64{8})
        caller: rt_text_word(read)
        // Within a mapping the chain only climbs.
        if (caller <= frame && perf_flight_span(state, caller) == holder) { break }
        frame = caller
        steps = wrapping(steps + I64{1})
    }
    perf_flight_stack_run(state, holder, start, top)
}

// Hold one run of a stack in the walk's span `span`: from `start` through
// the page after the one that holds the link of `top`, the outermost frame
// the chain reached there. That covers the entry's words above it and, on
// a fiber, the header at its stack's top. With no frame there (`top` 0),
// to the span's end.
perf_flight_stack_run: fn(state: I64, span: I64, start: I64, top: I64) {
    high: perf_flight_span_bound(state, span, true)
    if (top == I64{0}) {
        perf_flight_take(state, start, high)
        return
    }
    past: wrapping(top + I64{8})
    page: past & PERF_FLIGHT_PAGE_MASK
    end: wrapping(page + I64{8192})
    perf_flight_take(state, start, if (end < high) -> end else -> high)
}

// The image's writable segments at their load addresses: the globals.
perf_flight_globals: fn(state: I64) {
    image: perf_samples_image
    if (image == I64{0}) {
        return
    }
    table: rt_text_word(wrapping(image + I64{32}))
    entry: rt_text_word(wrapping(image + I64{54})) & I64{65535}
    count: rt_text_word(wrapping(image + I64{56})) & I64{65535}
    index := I64{0}
    loop index < count {
        header: wrapping(wrapping(image + table) + wrapping(index * entry))
        kind: rt_text_word(header)
        // PT_LOAD with PF_W.
        if ((kind & I64{4294967295}) == I64{1} && ((kind >> I64{32}) & I64{2}) != I64{0}) {
            start: wrapping(rt_text_word(wrapping(header + I64{16})) + perf_samples_bias)
            perf_flight_take(state, start, wrapping(start + rt_text_word(wrapping(header + I64{40}))))
        }
        index = wrapping(index + I64{1})
    }
}

// Each aligned word of the `length` bytes at `staged`, a copy of the
// memory at `address`, reaches what it points to.
perf_flight_scan: fn(state: I64, staged: I64, address: I64, length: I64) {
    at := wrapping(I64{0} - address) & I64{7}
    loop wrapping(at + I64{8}) <= length {
        perf_flight_follow(state, rt_text_word(wrapping(staged + at)))
        at = wrapping(at + I64{8})
    }
}

// Reach the memory `value` points to when it points into a writable
// mapping outside the flight state and the image's copy, and the walk does
// not hold its page yet: its page, or the large block's mapping it starts.
perf_flight_follow: fn(state: I64, value: I64) {
    if (value < I64{65536} || value >= I64{140737488355328}) {
        return
    }
    if (value >= state && value < wrapping(state + PERF_FLIGHT_BYTES)) {
        return
    }
    walk: wrapping(state + PERF_FLIGHT_WALK_AT)
    if (value >= perf_samples_image && value < rt_text_word(wrapping(walk + I64{48}))) {
        return
    }
    page: value & PERF_FLIGHT_PAGE_MASK
    if (perf_flight_seen(state, page) != I64{0}) {
        return
    }
    span: perf_flight_span(state, value)
    if (span < I64{0}) {
        return
    }
    high: perf_flight_span_bound(state, span, true)
    end := if (wrapping(page + I64{4096}) < high) -> wrapping(page + I64{4096}) else -> high
    // A large block: [mapping base][mapping bytes] just before its payload.
    if ((value & I64{7}) == I64{0} && wrapping(value - page) >= I64{16}) {
        read: wrapping(walk + I64{56})
        perf_flight_read(state, read, wrapping(value - I64{16}), I64{16})
        bytes: rt_text_word(wrapping(read + I64{8}))
        if (rt_text_word(read) == page && bytes > I64{4096} && (bytes & I64{4095}) == I64{0} && bytes <= wrapping(high - page)) {
            end = wrapping(page + bytes)
        }
    }
    perf_flight_take(state, page, end)
}

// Hold [start, end) page by page in the walk's order, skipping each page it
// holds already: each run of new pages, while the budget has a page left,
// goes on the queue; once it has none, the rest is cut off. A page is held
// whole, from its start even when `start` is past it: a pointer into the
// page finds it held and reaches no more of it (perf_flight_follow), as a
// frame chain's last word may name a heap block another block shares a
// page with.
perf_flight_take: fn(state: I64, start: I64, end: I64) {
    walk: wrapping(state + PERF_FLIGHT_WALK_AT)
    at := start & PERF_FLIGHT_PAGE_MASK
    loop at < end {
        run := at
        loop run < end {
            if (!perf_flight_hold(state, run & PERF_FLIGHT_PAGE_MASK)) { break }
            next_page: wrapping((run & PERF_FLIGHT_PAGE_MASK) + I64{4096})
            run = if (next_page < end) -> next_page else -> end
        }
        if (run > at) {
            tail: rt_text_word(wrapping(walk + I64{16}))
            entry: wrapping(wrapping(state + PERF_FLIGHT_QUEUE_AT) + wrapping(tail * I64{16}))
            rt_text_store(entry, at)
            rt_text_store(wrapping(entry + I64{8}), wrapping(run - at))
            rt_text_store(wrapping(walk + I64{16}), wrapping(tail + I64{1}))
            at = run
            next
        }
        seen: perf_flight_seen(state, at & PERF_FLIGHT_PAGE_MASK)
        // A page cut off already was cut with the rest of its range.
        if (seen == I64{2}) {
            return
        }
        if (seen == I64{1}) {
            next_page: wrapping((at & PERF_FLIGHT_PAGE_MASK) + I64{4096})
            at = if (next_page < end) -> next_page else -> end
            next
        }
        perf_flight_cut(state, at, end)
        return
    }
}

// Hold the new `page` against the budget, when the queue has a row left,
// the walk holds no part of the page, the budget has a page left and the
// page table room.
perf_flight_hold: fn(state: I64, page: I64) -> Bool {
    walk: wrapping(state + PERF_FLIGHT_WALK_AT)
    kept: rt_text_word(wrapping(walk + I64{24}))
    if (rt_text_word(wrapping(walk + I64{16})) >= PERF_FLIGHT_QUEUE || perf_flight_seen(state, page) != I64{0}) {
        return false
    }
    if (wrapping(kept + I64{4096}) > PERF_FLIGHT_DUMP_BUDGET || !perf_flight_mark(state, page, I64{0})) {
        return false
    }
    rt_text_store(wrapping(walk + I64{24}), wrapping(kept + I64{4096}))
    true
}

// List [start, end) as cut off, while the cut table has room, and mark
// its first page so another pointer into it does not list it again.
perf_flight_cut: fn(state: I64, start: I64, end: I64) {
    walk: wrapping(state + PERF_FLIGHT_WALK_AT)
    rows: rt_text_word(wrapping(walk + I64{32}))
    if (rows >= PERF_FLIGHT_CUTS || !perf_flight_mark(state, start & PERF_FLIGHT_PAGE_MASK, I64{1})) {
        return
    }
    row: wrapping(wrapping(wrapping(state + PERF_FLIGHT_CUTS_AT) + I64{32}) + wrapping(rows * I64{16}))
    rt_text_store(row, start)
    rt_text_store(wrapping(row + I64{8}), wrapping(end - start))
    rt_text_store(wrapping(walk + I64{32}), wrapping(rows + I64{1}))
    rt_text_store(wrapping(walk + I64{40}), wrapping(rt_text_word(wrapping(walk + I64{40})) + wrapping(end - start)))
}

// The slot of the walk's page table where `page` is or would go.
perf_flight_slot: fn(state: I64, page: I64) -> I64 {
    table: wrapping(state + PERF_FLIGHT_SEEN_AT)
    key: page >> I64{12}
    index := (wrapping(key * I64{-7046029254386353131}) >> I64{40}) & wrapping(PERF_FLIGHT_SEEN - I64{1})
    loop {
        slot: wrapping(table + wrapping(index * I64{8}))
        held: rt_text_word(slot)
        if (held == I64{0} || (held >> I64{1}) == key) { return slot }
        index = wrapping(index + I64{1}) & wrapping(PERF_FLIGHT_SEEN - I64{1})
    }
}

// Whether the walk holds `page` (1), cut it off (2) or neither (0).
perf_flight_seen: fn(state: I64, page: I64) -> I64 {
    held: rt_text_word(perf_flight_slot(state, page))
    if (held == I64{0}) { return I64{0} }
    wrapping((held & I64{1}) + I64{1})
}

// Mark `page` held (`cut` 0) or cut off (1); false when the table is
// three quarters full, so it never fills.
perf_flight_mark: fn(state: I64, page: I64, cut: I64) -> Bool {
    walk: wrapping(state + PERF_FLIGHT_WALK_AT)
    marked: rt_text_word(wrapping(walk + I64{72}))
    if (wrapping(marked * I64{4}) >= wrapping(PERF_FLIGHT_SEEN * I64{3})) { return false }
    rt_text_store(perf_flight_slot(state, page), ((page >> I64{12}) << I64{1}) | cut)
    rt_text_store(wrapping(walk + I64{72}), wrapping(marked + I64{1}))
    true
}

// Copy the static text `value` to `at` with a NUL after it; the NUL's
// address.
perf_flight_text: fn(at: I64, value: I64) -> I64 {
    length: rt_text_len(value)
    rt_text_bytes_copy(at, rt_text_data(value), length)
    end: wrapping(at + length)
    rt_text_put(end, I64{0})
    end
}

// The bytes of the NUL-terminated name at `at`.
perf_flight_length: fn(at: I64) -> I64 {
    count := I64{0}
    loop rt_text_byte(wrapping(at + count)) != (I64{0}) -> count = wrapping(count + I64{1})
    count
}

// `value`'s last `width` decimal digits at `at`; the address past them.
perf_flight_digits: fn(at: I64, value: I64, width: I64) -> I64 {
    left := value
    index := width
    loop index > (I64{0}) {
        index = wrapping(index - I64{1})
        rt_text_put(wrapping(at + index), I64{48} + left % I64{10})
        left /= I64{10}
    }
    wrapping(at + width)
}

// The program's name at `at`, the base name of the path its loader gave
// (or /proc/self/exe's) up to its first dot, at most 64 bytes; the address
// past it. The words at 176 hold /proc/self/exe's path while it is read.
perf_flight_program: fn(at: I64, words: I64, spare: I64) -> I64 {
    source := host_getauxval(HOST_AT_EXECUTABLE)
    if (source == I64{0}) {
        exe: wrapping(words + I64{176})
        _ := perf_flight_text(exe, rt_static_text("/proc/self/exe"))
        count: perf_flight_syscall(I64{89}, exe, spare, I64{511})
        rt_text_put(spare, I64{0})
        if (count > I64{0}) { rt_text_put(wrapping(spare + count), I64{0}) }
        source = spare
    }
    base := source
    cursor := source
    loop rt_text_byte(cursor) != (I64{0}) {
        if (rt_text_byte(cursor) == I64{47}) { base = wrapping(cursor + I64{1}) }
        cursor = wrapping(cursor + I64{1})
    }
    written := I64{0}
    loop written < (I64{64}) {
        byte: rt_text_byte(wrapping(base + written))
        if (byte == I64{0} || byte == I64{46}) { break }
        rt_text_put(wrapping(at + written), byte)
        written = wrapping(written + I64{1})
    }
    if (written == I64{0}) { return perf_flight_text(at, rt_static_text("program")) }
    wrapping(at + written)
}

// The UTC time now, YYYY-MM-DDTHH-MM-SS, at `at`; the address past it.
// The clock's two words stay at `words` + 128 for the dump's header.
perf_flight_time: fn(at: I64, words: I64) -> I64 {
    clock: wrapping(words + I64{128})
    _ := perf_flight_syscall(I64{228}, I64{0}, clock, I64{0})
    seconds: rt_text_word(clock)
    days: seconds / I64{86400}
    rest: seconds % I64{86400}
    // The proleptic Gregorian date of `days` since 1970-01-01, by eras of
    // 400 years that begin on March 1.
    shifted: days + I64{719468}
    era: shifted / I64{146097}
    of_era: shifted - era * I64{146097}
    year_of_era: (of_era - of_era / I64{1460} + of_era / I64{36524} - of_era / I64{146096}) / I64{365}
    of_year: of_era - (I64{365} * year_of_era + year_of_era / I64{4} - year_of_era / I64{100})
    shifted_month: (I64{5} * of_year + I64{2}) / I64{153}
    day: of_year - (I64{153} * shifted_month + I64{2}) / I64{5} + I64{1}
    month: if (shifted_month < I64{10}) -> shifted_month + I64{3} else -> shifted_month - I64{9}
    year: year_of_era + era * I64{400} + (if (month <= I64{2}) -> I64{1} else -> I64{0})
    cursor := perf_flight_digits(at, year, I64{4})
    rt_text_put(cursor, I64{45})
    cursor = perf_flight_digits(wrapping(cursor + I64{1}), month, I64{2})
    rt_text_put(cursor, I64{45})
    cursor = perf_flight_digits(wrapping(cursor + I64{1}), day, I64{2})
    rt_text_put(cursor, I64{84})
    cursor = perf_flight_digits(wrapping(cursor + I64{1}), rest / I64{3600}, I64{2})
    rt_text_put(cursor, I64{45})
    cursor = perf_flight_digits(wrapping(cursor + I64{1}), rest / I64{60} % I64{60}, I64{2})
    rt_text_put(cursor, I64{45})
    perf_flight_digits(wrapping(cursor + I64{1}), rest % I64{60}, I64{2})
}

// Create `.jet/dumps` and the dump's file in it, its path at `text`:
// `<program>-<time>.jetdump`, `~<n>` after the time when a dump of the
// same second is there. The descriptor, or the negated errno.
perf_flight_dump_open: fn(state: I64, text: I64, words: I64) -> I64 {
    at := perf_flight_text(text, rt_static_text(".jet"))
    _ := perf_flight_syscall(I64{83}, text, I64{448}, I64{0})
    at = perf_flight_text(at, rt_static_text("/dumps"))
    _ := perf_flight_syscall(I64{83}, text, I64{448}, I64{0})
    rt_text_put(at, I64{47})
    name: wrapping(at + I64{1})
    at = perf_flight_program(name, words, wrapping(text + PERF_FLIGHT_OLDEST_AT))
    rt_text_put(at, I64{45})
    at = wrapping(at + I64{1})
    rt_text_store(wrapping(state + PERF_FLIGHT_PREFIX), wrapping(at - name))
    stamp: perf_flight_time(at, words)
    attempt := I64{0}
    loop attempt < (I64{100}) {
        end := stamp
        if (attempt > I64{0}) {
            rt_text_put(end, I64{126})
            end = perf_flight_digits(wrapping(end + I64{1}), attempt, if (attempt < I64{10}) -> I64{1} else -> I64{2})
        }
        _ := perf_flight_text(end, rt_static_text(".jetdump"))
        // O_WRONLY|O_CREAT|O_EXCL|O_CLOEXEC, mode 0600.
        fd := I64{-1}
        #Unsafe("openat reads the dump's NUL-terminated path in the state's text page") {
            fd = os_syscall_i64(I64{257}, I64{-100}, text, I64{524481}, I64{384}, I64{0}, I64{0})
        }
        if (fd != I64{-17}) { return fd }
        attempt = wrapping(attempt + I64{1})
    }
    I64{-17}
}

// Whether the NUL-terminated name `name` sorts before `other`.
perf_flight_before: fn(name: I64, other: I64) -> Bool {
    at := I64{0}
    loop {
        left: rt_text_byte(wrapping(name + at))
        right: rt_text_byte(wrapping(other + at))
        if (left != right) { return left < right }
        if (left == I64{0}) { return false }
        at = wrapping(at + I64{1})
    }
    false
}

// Whether `name` is a dump of this program's: the `length` bytes of
// `prefix`, then anything, then `.jetdump`.
perf_flight_dump_name: fn(name: I64, prefix: I64, length: I64) -> Bool {
    count: perf_flight_length(name)
    suffix: rt_static_text(".jetdump")
    tail: rt_text_len(suffix)
    count >= wrapping(length + tail) && rt_text_equal_bytes(name, prefix, length) && rt_text_equal_bytes(wrapping(name + wrapping(count - tail)), rt_text_data(suffix), tail)
}

// Keep the newest PERF_FLIGHT_DUMPS_KEPT of this program's dumps: the
// names sort by their time, so the least goes while more are there.
perf_flight_rotate: fn(state: I64, text: I64) {
    // `.jet/dumps` alone while the directory opens.
    rt_text_put(wrapping(text + I64{10}), I64{0})
    // O_RDONLY|O_DIRECTORY|O_CLOEXEC.
    directory: perf_flight_syscall(I64{257}, I64{-100}, text, I64{589824})
    rt_text_put(wrapping(text + I64{10}), I64{47})
    if (directory < I64{0}) {
        return
    }
    prefix: wrapping(text + I64{11})
    length: rt_text_word(wrapping(state + PERF_FLIGHT_PREFIX))
    scratch: wrapping(state + PERF_FLIGHT_SCRATCH_AT)
    oldest: wrapping(text + PERF_FLIGHT_OLDEST_AT)
    loop {
        _ := perf_flight_syscall(I64{8}, directory, I64{0}, I64{0})
        rt_text_put(oldest, I64{0})
        count := I64{0}
        loop {
            got: perf_flight_syscall(I64{217}, directory, scratch, PERF_FLIGHT_SCRATCH)
            if (got <= I64{0}) { break }
            at := I64{0}
            loop at < got {
                entry: wrapping(scratch + at)
                name: wrapping(entry + I64{19})
                if (perf_flight_dump_name(name, prefix, length)) {
                    count = wrapping(count + I64{1})
                    if (rt_text_byte(oldest) == I64{0} || perf_flight_before(name, oldest)) {
                        size: perf_flight_length(name)
                        if (size < I64{511}) {
                            rt_text_bytes_copy(oldest, name, size)
                            rt_text_put(wrapping(oldest + size), I64{0})
                        }
                    }
                }
                step: perf_cfi_u16(wrapping(entry + I64{16}))
                if (step == I64{0}) { break }
                at = wrapping(at + step)
            }
        }
        if (count <= PERF_FLIGHT_DUMPS_KEPT || rt_text_byte(oldest) == I64{0}) { break }
        // unlinkat
        if (perf_flight_syscall(I64{263}, directory, oldest, I64{0}) != I64{0}) { break }
    }
    perf_flight_images(state, text, directory)
    _ := perf_flight_syscall(I64{3}, directory, I64{0}, I64{0})
}

// Whether `name` is a copy of this program's image: the `length` bytes of
// `prefix`, PERF_FLIGHT_BUILD_DIGITS digits, then `.image`.
perf_flight_image_name: fn(name: I64, prefix: I64, length: I64) -> Bool {
    count: perf_flight_length(name)
    suffix: rt_static_text(".image")
    tail: rt_text_len(suffix)
    count == wrapping(wrapping(length + PERF_FLIGHT_BUILD_DIGITS) + tail) && rt_text_equal_bytes(name, prefix, length) && rt_text_equal_bytes(wrapping(name + wrapping(count - tail)), rt_text_data(suffix), tail)
}

// Remove each copy of this program's image that no kept dump names: a
// `<program>-<build>.image` whose build is in none of the headers of the
// program's dumps in `directory`. A dump of an earlier version names no
// copy; one whose header can't be read, or more dumps than
// PERF_FLIGHT_KEPT_MOST, keep every copy.
perf_flight_images: fn(state: I64, text: I64, directory: I64) {
    prefix: wrapping(text + I64{11})
    length: rt_text_word(wrapping(state + PERF_FLIGHT_PREFIX))
    scratch: wrapping(state + PERF_FLIGHT_SCRATCH_AT)
    header: wrapping(state + PERF_FLIGHT_COPY_AT)
    kept: wrapping(text + PERF_FLIGHT_KEPT_AT)
    count := I64{0}
    _ := perf_flight_syscall(I64{8}, directory, I64{0}, I64{0})
    loop {
        got: perf_flight_syscall(I64{217}, directory, scratch, PERF_FLIGHT_SCRATCH)
        if (got <= I64{0}) { break }
        at := I64{0}
        loop at < got {
            entry: wrapping(scratch + at)
            name: wrapping(entry + I64{19})
            if (perf_flight_dump_name(name, prefix, length)) {
                if (count >= PERF_FLIGHT_KEPT_MOST) {
                    return
                }
                // O_RDONLY|O_CLOEXEC
                fd: perf_flight_syscall(I64{257}, directory, name, I64{524288})
                if (fd < I64{0}) {
                    return
                }
                read: perf_flight_syscall(I64{0}, fd, header, PERF_FLIGHT_HEADER)
                _ := perf_flight_syscall(I64{3}, fd, I64{0}, I64{0})
                if (read != PERF_FLIGHT_HEADER || rt_text_word(header) != PERF_FLIGHT_MAGIC) {
                    return
                }
                if (rt_text_word(wrapping(header + I64{8})) == PERF_FLIGHT_VERSION) {
                    rt_text_store(wrapping(kept + wrapping(count * I64{8})), rt_text_word(wrapping(header + I64{88})))
                    count = wrapping(count + I64{1})
                }
            }
            step: perf_cfi_u16(wrapping(entry + I64{16}))
            if (step == I64{0}) { break }
            at = wrapping(at + step)
        }
    }
    _ := perf_flight_syscall(I64{8}, directory, I64{0}, I64{0})
    loop {
        got: perf_flight_syscall(I64{217}, directory, scratch, PERF_FLIGHT_SCRATCH)
        if (got <= I64{0}) { break }
        at := I64{0}
        loop at < got {
            entry: wrapping(scratch + at)
            name: wrapping(entry + I64{19})
            if (perf_flight_image_name(name, prefix, length)) {
                build := I64{0}
                digits := I64{0}
                loop digits < PERF_FLIGHT_BUILD_DIGITS {
                    digit: perf_flight_hex(rt_text_byte(wrapping(wrapping(name + length) + digits)))
                    if (digit < I64{0}) { break }
                    build = (build << I64{4}) | digit
                    digits = wrapping(digits + I64{1})
                }
                named := digits != PERF_FLIGHT_BUILD_DIGITS
                index := I64{0}
                loop index < count {
                    if (rt_text_word(wrapping(kept + wrapping(index * I64{8}))) == build) {
                        named = true
                    }
                    index = wrapping(index + I64{1})
                }
                // unlinkat
                if (!named) { _ := perf_flight_syscall(I64{263}, directory, name, I64{0}) }
            }
            step: perf_cfi_u16(wrapping(entry + I64{16}))
            if (step == I64{0}) { break }
            at = wrapping(at + step)
        }
    }
}

// The causal lens (`jet perf run --lens=causal`): Coz's virtual speedup
// experiments, run by the CPU-time samples' handler (perf_causal_tick).
// Each experiment lasts PERF_CAUSAL_EXPERIMENT_NS of wall time. One in two
// is a baseline; the others take the source line of the sample that starts
// them (a line of the program's own files, every address range of it in its
// function, from the image's location table) and speed it up by
// PERF_CAUSAL_SPEEDUP virtually: each sample that lands in the line adds
// that share of the time the line took to its thread's own count of
// delays, the global delay is the most any thread has counted, as in Coz
// (perf_causal_raise), and every thread that has counted less pauses at its
// next sample until it has paid up to it, so the line runs as if faster
// relative to everything else. Threads in the line at once each count their
// own share and none pays another's: were the global delay their sum, each
// would pause for its siblings' shares, as if the line ran slower than it
// does. A pause holds its thread's CPU (perf_causal_pause), so the pauses
// slow the rest of the program as the line's own time would, and the
// samples its CPU time sets off are dropped. The time a sample
// stands for is its thread's wall time since its last sample when the
// thread wasn't blocked meanwhile, and its CPU time when that is more or
// the thread was blocked: under load a running thread waits for a CPU
// between its samples, and that wait is part of the line's time, which a
// faster line would save too. A thread whose last sample is older than
// PERF_CAUSAL_BLOCKED_NS and that has since given up its CPU of its own
// accord was blocked and owes nothing for that time (perf_causal_blocked).
// Progress points count passes: each closed zone by its
// name, each `core.perf.progress(name)`, each finished task (`task`). At
// each experiment's end a PERF_SAMPLES_CAUSAL record goes to the samples
// file: 0 in its low bits, then the line's sampled address (0 for a
// baseline), the speedup in thousandths, the wall time, the delay inserted
// meanwhile, the run time and the runqueue wait the program's threads took
// meanwhile, the highest and the lowest clock, in kHz, of the CPUs those
// of them that ran last ran on (perf_causal_schedstat), then
// PERF_CAUSAL_POINTS words by slot for each of: each progress point's
// passes after its first one in the experiment, the wall time from that
// first pass to its last and the delay inserted between them. A point's
// rate is taken between its own passes:
// the experiment's target is the line of the sample that ends the one
// before, and which line runs depends on how far into a pass the program
// is, so an experiment's start falls at a different distance from the next
// pass for each line, and passes counted over its whole wall time would
// favor the lines that start near one. The first pass of each point writes
// a record naming its slot: 1 in its low bits, then the slot, the name's
// length and the name. At exit the idle table follows, 2 in its low bits
// (perf_causal_idle_write), then the tasks' timings (perf_causal_rows_write):
// 4 in its low bits and the tasks that ended, then a record per task kept,
// 3 in its low bits. JetCLI CLI/Perf/Causal.jet turns them into the
// predictions.
PERF_SAMPLES_CAUSAL: I64{8}

PERF_CAUSAL_EXPERIMENT_NS: I64{25000000}

PERF_CAUSAL_SPEEDUP: I64{300}

PERF_CAUSAL_BLOCKED_NS: I64{5000000}

// The most a thread pauses at once.
PERF_CAUSAL_PAUSE_MAX_NS: I64{100000000}

PERF_CAUSAL_RANGES: I64{32}

PERF_CAUSAL_POINTS: I64{32}

PERF_CAUSAL_THREADS: I64{512}

// The lens's state, one mapping: the rollover lock, the experiment's start,
// the global delay and its value at the start, the speedup, the target's
// range count and address, the random state, the location table's start
// and end, the target's ranges, the progress points (name hash, then in
// the experiment: the time of its first pass and of its last, the global
// delay at each, the passes after the first), the record being written,
// then one entry per thread (tid, delay paid, last sample, voluntary
// context switches by then, a timespec, a struct rusage, the CPU time its
// pauses took whose samples are still to drop, whether it is pausing, its
// schedstat run time and wait at the last experiment's end, the task it
// runs: perf_causal_task_start, and its timing: perf_causal_rows_write),
// then the scratch the schedstat reads go through, the idle table
// (perf_causal_idle_write), the experiment's ordinal, and the tasks'
// timings' mapping and how many tasks claimed a row of it.
PERF_CAUSAL_START: I64{8}

PERF_CAUSAL_DELAY: I64{16}

PERF_CAUSAL_DELAY_START: I64{24}

PERF_CAUSAL_SPEED: I64{32}

PERF_CAUSAL_RANGE_COUNT: I64{40}

PERF_CAUSAL_TARGET: I64{48}

PERF_CAUSAL_RANDOM: I64{56}

PERF_CAUSAL_TABLE: I64{64}

PERF_CAUSAL_TABLE_END: I64{72}

PERF_CAUSAL_RANGE_AT: I64{80}

PERF_CAUSAL_POINT_AT: I64{592}

PERF_CAUSAL_POINT_BYTES: I64{48}

PERF_CAUSAL_RECORD: I64{2128}

PERF_CAUSAL_THREAD_AT: I64{2976}

PERF_CAUSAL_THREAD_BYTES: I64{352}

PERF_CAUSAL_THREAD_SPUN: I64{192}

PERF_CAUSAL_THREAD_PAUSING: I64{200}

PERF_CAUSAL_THREAD_RUN: I64{208}

PERF_CAUSAL_THREAD_WAIT: I64{216}

// When the thread last ended a task (0 before its first), the task it runs
// now (0 when none), the task's start, the global delay then, the idle gap
// before it and the idle table's cell its run goes to (0 when none).
PERF_CAUSAL_THREAD_IDLE_FROM: I64{224}

PERF_CAUSAL_THREAD_TASK: I64{232}

PERF_CAUSAL_THREAD_TASK_FROM: I64{240}

PERF_CAUSAL_THREAD_TASK_DELAY: I64{248}

PERF_CAUSAL_THREAD_GAP: I64{256}

PERF_CAUSAL_THREAD_CELL: I64{264}

// The pauses' wall time and CPU time so far, the samples taken so far, and
// at the start of the task it runs: its thread's CPU time, those three,
// the experiment's ordinal, the CPU it began on and its body's address.
PERF_CAUSAL_THREAD_PAUSED: I64{272}

PERF_CAUSAL_THREAD_PAUSE_CPU: I64{280}

PERF_CAUSAL_THREAD_TICKS: I64{288}

PERF_CAUSAL_THREAD_TASK_CPU: I64{296}

PERF_CAUSAL_THREAD_TASK_PAUSED: I64{304}

PERF_CAUSAL_THREAD_TASK_PAUSE_CPU: I64{312}

PERF_CAUSAL_THREAD_TASK_TICKS: I64{320}

PERF_CAUSAL_THREAD_TASK_ORDINAL: I64{328}

PERF_CAUSAL_THREAD_TASK_CORE: I64{336}

PERF_CAUSAL_THREAD_TASK_BODY: I64{344}

// Past the last thread's entry: PERF_CAUSAL_THREAD_AT + PERF_CAUSAL_THREADS *
// PERF_CAUSAL_THREAD_BYTES. It holds SCHEDULER_STAT_BYTES.
PERF_CAUSAL_SCRATCH: I64{183200}

// Past the scratch: the idle table, as the record perf_causal_idle_write
// writes. Its header word, then PERF_CAUSAL_KINDS rows, one per task body
// by its address (0 for a free row): the address, then PERF_CAUSAL_GAPS
// cells, one per octave of the idle gap in microseconds (the last holds
// every longer gap), each of three words: the tasks that ran after such a
// gap, their run time and their gaps, in nanoseconds.
PERF_CAUSAL_IDLE_AT: I64{183712}

PERF_CAUSAL_KINDS: I64{8}

PERF_CAUSAL_GAPS: I64{16}

// 8 + PERF_CAUSAL_GAPS * 24.
PERF_CAUSAL_KIND_BYTES: I64{392}

// The record's words: its header and PERF_CAUSAL_KINDS rows.
PERF_CAUSAL_IDLE_WORDS: I64{393}

// Past the idle table: the experiment's ordinal, the tasks' timings'
// mapping (0 when it could not be mapped), the tasks that claimed a row,
// and the three words of the record perf_causal_rows_write writes first.
PERF_CAUSAL_ORDINAL: I64{186856}

PERF_CAUSAL_ROWS: I64{186864}

PERF_CAUSAL_ROW_COUNT: I64{186872}

PERF_CAUSAL_ROW_HEAD: I64{186880}

PERF_CAUSAL_BYTES: I64{188416}

// The tasks whose timings the lens keeps, and the words of each one's
// record (perf_causal_rows_write).
PERF_CAUSAL_ROWS_MAX: I64{65536}

PERF_CAUSAL_ROW_WORDS: I64{14}

// The causal lens's state, 0 unless the lens is on.
perf_causal_state := I64{0}

// The lens's state for the image `image`: its location table found, the
// first experiment a baseline started now, the tasks' timings mapped (a
// fresh anonymous mapping, so zero until a task's row is written); 0 when
// it cannot be mapped or the image keeps no location table.
perf_causal_open: fn(image: I64) -> I64 {
    if (image == I64{0}) { return I64{0} }
    state: alloc_map_try(PERF_CAUSAL_BYTES)
    if (state == I64{0}) { return I64{0} }
    thread_zero(state, PERF_CAUSAL_BYTES)
    if (!perf_causal_table(state, image)) { return I64{0} }
    now: perf_samples_clock()
    rt_text_store(wrapping(state + PERF_CAUSAL_START), now)
    rt_text_store(wrapping(state + PERF_CAUSAL_RANDOM), now | I64{1})
    rt_text_store(wrapping(state + PERF_CAUSAL_ROWS), alloc_map_try(wrapping(PERF_CAUSAL_ROWS_MAX * wrapping(PERF_CAUSAL_ROW_WORDS * I64{8}))))
    state
}

// Find the image's .debug_jetline section and keep its bounds in `state`.
perf_causal_table: fn(state: I64, image: I64) -> Bool {
    table := I64{0}
    table_end := I64{0}
    offset: rt_text_word(wrapping(image + I64{40}))
    entry: trace_u16(wrapping(image + I64{58}))
    count: trace_u16(wrapping(image + I64{60}))
    names_index: trace_u16(wrapping(image + I64{62}))
    if (offset > I64{0} && names_index < count) {
        sections: wrapping(image + offset)
        names: wrapping(image + rt_text_word(wrapping(wrapping(sections + wrapping(names_index * entry)) + I64{24})))
        index := I64{0}
        loop index < count {
            section: wrapping(sections + wrapping(index * entry))
            name: wrapping(names + trace_u32(section))
            // ".debug_jetline\0", little-endian.
            if (rt_text_word(name) == I64{7664958844667520046} && rt_text_word(wrapping(name + I64{8})) & I64{72057594037927935} == I64{111524889523301}) {
                table = wrapping(image + rt_text_word(wrapping(section + I64{24})))
                table_end = wrapping(table + rt_text_word(wrapping(section + I64{32})))
                break
            }
            index = wrapping(index + I64{1})
        }
    }
    if (table == I64{0}) { return false }
    rt_text_store(wrapping(state + PERF_CAUSAL_TABLE), table)
    rt_text_store(wrapping(state + PERF_CAUSAL_TABLE_END), table_end)
    true
}

// From the CPU-time samples' handler, for a sample at link-time address
// `pc` standing for `periods` periods: add the target line's share of the
// sample's time to this thread's count when the sample is in it, pay what
// it owes, and end the experiment once its time is up. The periods the
// sample keeps: those its thread's pauses spent are dropped, as a pause is
// the lens's time and not the interrupted line's, and a sample that keeps
// none is not written.
perf_causal_tick: fn(pc: I64, periods: I64) -> I64 {
    state: perf_causal_state
    if (state == I64{0}) { return periods }
    now: perf_samples_clock()
    thread: perf_causal_thread(state)
    period: wrapping(perf_samples_interval_us * I64{1000})
    kept := periods
    if (thread != I64{0}) {
        ticks: wrapping(thread + PERF_CAUSAL_THREAD_TICKS)
        rt_text_store(ticks, wrapping(rt_text_word(ticks) + I64{1}))
        spun: wrapping(thread + PERF_CAUSAL_THREAD_SPUN)
        // A sample taken in a pause outside the handler (perf_causal_task_end)
        // is the pause's: its periods come off what the pause will add.
        if (sync_load(wrapping(thread + PERF_CAUSAL_THREAD_PAUSING)) != I64{0}) {
            _ := sync_add(spun, wrapping(I64{0} - wrapping(period * periods)))
            return I64{0}
        }
        // A pause in the handler holds the timer's signal back, so the next
        // sample also stands for the periods the pause spent.
        owed: sync_load(spun) / period
        if (owed > I64{0}) {
            dropped: if (owed < periods) -> owed else -> periods
            _ := sync_add(spun, wrapping(I64{0} - wrapping(period * dropped)))
            kept = wrapping(periods - dropped)
            // A sample that keeps none came of the pause's CPU time alone:
            // its signal's delivery and this handler are the pause's time,
            // which the thread paid as it paid the spin (perf_causal_pay).
            if (kept == I64{0}) {
                cost: wrapping(wrapping(perf_samples_clock() - now) + perf_samples_delivery_ns)
                rt_text_store(wrapping(thread + I64{8}), wrapping(rt_text_word(wrapping(thread + I64{8})) + cost))
                return I64{0}
            }
        }
    }
    delay: sync_load(wrapping(state + PERF_CAUSAL_DELAY))
    // The sample's time: its CPU time, or the wall time since this
    // thread's last sample when it was ready to run all of it and that is
    // more. A thread that was not owes nothing for the delays meanwhile.
    spent := wrapping(period * kept)
    ready := false
    if (thread != I64{0}) {
        last: rt_text_word(wrapping(thread + I64{16}))
        ready = last != I64{0} && !perf_causal_blocked(thread, wrapping(now - last))
        if (ready) {
            if (wrapping(now - last) > spent) { spent = wrapping(now - last) }
        } else if (rt_text_word(wrapping(thread + I64{8})) < delay) {
            rt_text_store(wrapping(thread + I64{8}), delay)
        }
    }
    count: sync_load(wrapping(state + PERF_CAUSAL_RANGE_COUNT))
    if (count > I64{0} && perf_causal_in_target(state, pc, count)) {
        share: wrapping(wrapping(sync_load(wrapping(state + PERF_CAUSAL_SPEED)) * spent) / I64{1000})
        if (thread != I64{0}) {
            local: wrapping(rt_text_word(wrapping(thread + I64{8})) + share)
            rt_text_store(wrapping(thread + I64{8}), local)
            perf_causal_raise(state, local)
        } else { _ := sync_add(wrapping(state + PERF_CAUSAL_DELAY), share) }
    }
    if (ready) {
        perf_causal_pay(thread, rt_text_word(wrapping(thread + I64{8})), sync_load(wrapping(state + PERF_CAUSAL_DELAY)))
    }
    // After the pause: a pause the experiment's end left out of its wall
    // time would still count in its delay and its passes.
    after: perf_samples_clock()
    if (thread != I64{0}) { perf_causal_mark(thread, after) }
    if (wrapping(after - sync_load(wrapping(state + PERF_CAUSAL_START))) >= PERF_CAUSAL_EXPERIMENT_NS && sync_cas(state, I64{0}, I64{1}) == I64{0}) {
        perf_causal_next(state, pc, after)
        sync_store(state, I64{0})
    }
    kept
}

// Raise the global delay to `local`, a thread's count, when that is more:
// the global delay is the most any thread has counted, so a thread that
// counted it owes none of it and every other thread owes the difference.
perf_causal_raise: fn(state: I64, local: I64) {
    at: wrapping(state + PERF_CAUSAL_DELAY)
    loop {
        seen: sync_load(at)
        if (seen >= local || sync_cas(at, seen, local) == seen) {
            return
        }
    }
}

// Whether this thread was blocked since its last sample, `gap` ago: that
// long off its CPU, and of its own accord at least once (a voluntary
// context switch). A thread only preempted that long, as under load or with
// more threads than cores, was ready to run and owes its delays as any
// other does: forgiven them, it would leave delays unpaid that its
// experiment takes off the wall time.
perf_causal_blocked: fn(thread: I64, gap: I64) -> Bool {
    if (gap <= PERF_CAUSAL_BLOCKED_NS) { return false }
    switches: perf_causal_switches(thread)
    switches < I64{0} || switches != rt_text_word(wrapping(thread + I64{24}))
}

// Note in this thread's entry its last sample (or sync point) at `now` and
// its voluntary context switches by then.
perf_causal_mark: fn(thread: I64, now: I64) {
    rt_text_store(wrapping(thread + I64{16}), now)
    rt_text_store(wrapping(thread + I64{24}), perf_causal_switches(thread))
}

// This thread's voluntary context switches so far (getrusage's ru_nvcsw
// for RUSAGE_THREAD), read into its entry's struct rusage; -1 when the
// kernel refuses.
perf_causal_switches: fn(thread: I64) -> I64 {
    usage: wrapping(thread + I64{48})
    status := I64{-1}
    #Unsafe("getrusage writes the struct rusage in this thread's own entry") {
        status = os_syscall_i64(I64{98}, I64{1}, usage, I64{0}, I64{0}, I64{0}, I64{0})
    }
    if (status != I64{0}) { return I64{-1} }
    rt_text_word(wrapping(usage + I64{128}))
}

// A task's start and end are the lens's sync points, as a thread's wake
// and its wake of another are Coz's. A worker that starts a task was idle or
// blocked, so it owes nothing for the delays inserted before; a task that
// ends pays what it owes before its joiner can see it. Without them a short
// task finishes between samples and pays its delay later, in whatever its
// thread runs next, which can be the line the experiment speeds up. A
// thread's park another thread wakes is the third (perf_causal_woken).
//
// They also time each task against the idle gap before it, for the idle
// table: `task` is the task, `body` its body's address. The gap is the time
// since its thread last ended a task, when it runs none now: a carrier
// parks between tasks, and a CPU that idled clocks down, so a task begun
// after a long gap runs slower. A task is counted when the global delay
// stayed put while it ran, so no pause is in its run time, and when it
// ends on the thread that started it; one started inside another task's
// run (a join that runs it) had no gap and is not. Both reuse the clock
// read their mark takes: with the lens on, a task costs a few stores, a
// row lookup and three atomic adds more, and for its timing
// (perf_causal_row) a CPU clock read at each end and a getcpu at its start;
// with it off, nothing past the state's test.
perf_causal_task_start: fn(task: I64, body: I64) {
    state: perf_causal_state
    if (state == I64{0}) {
        return
    }
    thread: perf_causal_thread(state)
    if (thread == I64{0}) {
        return
    }
    delay: sync_load(wrapping(state + PERF_CAUSAL_DELAY))
    // What a pause paid past its request still counts (perf_causal_pay).
    if (rt_text_word(wrapping(thread + I64{8})) < delay) {
        rt_text_store(wrapping(thread + I64{8}), delay)
    }
    now: perf_samples_clock()
    perf_causal_mark(thread, now)
    idle_from: rt_text_word(wrapping(thread + PERF_CAUSAL_THREAD_IDLE_FROM))
    running: rt_text_word(wrapping(thread + PERF_CAUSAL_THREAD_TASK))
    gap: wrapping(now - idle_from)
    cell: if (idle_from == I64{0} || running != I64{0} || gap < I64{0}) -> I64{0} else -> perf_causal_idle_cell(state, body, gap)
    rt_text_store(wrapping(thread + PERF_CAUSAL_THREAD_TASK), task)
    rt_text_store(wrapping(thread + PERF_CAUSAL_THREAD_TASK_FROM), now)
    rt_text_store(wrapping(thread + PERF_CAUSAL_THREAD_TASK_DELAY), delay)
    rt_text_store(wrapping(thread + PERF_CAUSAL_THREAD_GAP), if (idle_from == I64{0} || running != I64{0} || gap < I64{0}) -> I64{-1} else -> gap)
    rt_text_store(wrapping(thread + PERF_CAUSAL_THREAD_CELL), cell)
    rt_text_store(wrapping(thread + PERF_CAUSAL_THREAD_TASK_BODY), body)
    rt_text_store(wrapping(thread + PERF_CAUSAL_THREAD_TASK_ORDINAL), sync_load(wrapping(state + PERF_CAUSAL_ORDINAL)))
    rt_text_store(wrapping(thread + PERF_CAUSAL_THREAD_TASK_PAUSED), rt_text_word(wrapping(thread + PERF_CAUSAL_THREAD_PAUSED)))
    rt_text_store(wrapping(thread + PERF_CAUSAL_THREAD_TASK_PAUSE_CPU), rt_text_word(wrapping(thread + PERF_CAUSAL_THREAD_PAUSE_CPU)))
    rt_text_store(wrapping(thread + PERF_CAUSAL_THREAD_TASK_TICKS), rt_text_word(wrapping(thread + PERF_CAUSAL_THREAD_TICKS)))
    rt_text_store(wrapping(thread + PERF_CAUSAL_THREAD_TASK_CORE), perf_causal_core(thread))
    rt_text_store(wrapping(thread + PERF_CAUSAL_THREAD_TASK_CPU), perf_causal_clock(thread, I64{3}))
}

perf_causal_task_end: fn(task: I64) {
    state: perf_causal_state
    if (state == I64{0}) {
        return
    }
    thread: perf_causal_thread(state)
    if (thread == I64{0}) {
        return
    }
    delay: sync_load(wrapping(state + PERF_CAUSAL_DELAY))
    perf_causal_pay(thread, rt_text_word(wrapping(thread + I64{8})), delay)
    now: perf_samples_clock()
    perf_causal_mark(thread, now)
    cell: rt_text_word(wrapping(thread + PERF_CAUSAL_THREAD_CELL))
    started: rt_text_word(wrapping(thread + PERF_CAUSAL_THREAD_TASK)) == task
    if (started) {
        perf_causal_row(state, thread, now, sync_load(wrapping(state + PERF_CAUSAL_DELAY)))
    }
    if (started && cell != I64{0} && rt_text_word(wrapping(thread + PERF_CAUSAL_THREAD_TASK_DELAY)) == delay) {
        _ := sync_add(cell, I64{1})
        _ := sync_add(wrapping(cell + I64{8}), wrapping(now - rt_text_word(wrapping(thread + PERF_CAUSAL_THREAD_TASK_FROM))))
        _ := sync_add(wrapping(cell + I64{16}), rt_text_word(wrapping(thread + PERF_CAUSAL_THREAD_GAP)))
    }
    // Whichever task ended, the thread ran until now.
    rt_text_store(wrapping(thread + PERF_CAUSAL_THREAD_TASK), I64{0})
    rt_text_store(wrapping(thread + PERF_CAUSAL_THREAD_CELL), I64{0})
    rt_text_store(wrapping(thread + PERF_CAUSAL_THREAD_IDLE_FROM), now)
}

// The CPU this thread runs on (getcpu), read into its entry's word for it;
// -1 when the kernel refuses.
perf_causal_core: fn(thread: I64) -> I64 {
    word: wrapping(thread + PERF_CAUSAL_THREAD_TASK_CORE)
    rt_text_store(word, I64{0})
    status := I64{-1}
    #Unsafe("getcpu writes the CPU's 32-bit number into this thread's own entry") {
        status = os_syscall_i64(I64{309}, word, I64{0}, I64{0}, I64{0}, I64{0}, I64{0})
    }
    if (status != I64{0}) { return I64{-1} }
    rt_text_word(word)
}

// The timing of the task this thread started, which ended `now` with the
// global delay at `delay`, as its row of the lens's tasks' timings, when
// a row is left: its PERF_SAMPLES_CAUSAL header, 3 in its low bits, stored
// last, so that perf_causal_rows_write passes over a row still being
// written; then its body's link-time address, its start and end, the
// experiments' ordinals then (perf_causal_next), the CPU time its thread
// took meanwhile, the wall time and the CPU time its pauses took, the
// samples its thread took, the global delay at its start and its end, the
// CPU it began on, and the idle gap before it (-1 when it had none: its
// thread's first task, or one begun inside another's run). The pauses at
// its end (perf_causal_task_end) are in it.
perf_causal_row: fn(state: I64, thread: I64, now: I64, delay: I64) {
    rows: rt_text_word(wrapping(state + PERF_CAUSAL_ROWS))
    if (rows == I64{0}) {
        return
    }
    index: sync_add(wrapping(state + PERF_CAUSAL_ROW_COUNT), I64{1})
    if (index >= PERF_CAUSAL_ROWS_MAX) {
        return
    }
    row: wrapping(rows + wrapping(index * wrapping(PERF_CAUSAL_ROW_WORDS * I64{8})))
    cpu: perf_causal_clock(thread, I64{3})
    rt_text_store(wrapping(row + I64{8}), wrapping(rt_text_word(wrapping(thread + PERF_CAUSAL_THREAD_TASK_BODY)) - perf_samples_bias))
    rt_text_store(wrapping(row + I64{16}), rt_text_word(wrapping(thread + PERF_CAUSAL_THREAD_TASK_FROM)))
    rt_text_store(wrapping(row + I64{24}), now)
    rt_text_store(wrapping(row + I64{32}), rt_text_word(wrapping(thread + PERF_CAUSAL_THREAD_TASK_ORDINAL)))
    rt_text_store(wrapping(row + I64{40}), sync_load(wrapping(state + PERF_CAUSAL_ORDINAL)))
    rt_text_store(wrapping(row + I64{48}), wrapping(cpu - rt_text_word(wrapping(thread + PERF_CAUSAL_THREAD_TASK_CPU))))
    rt_text_store(wrapping(row + I64{56}), wrapping(rt_text_word(wrapping(thread + PERF_CAUSAL_THREAD_PAUSED)) - rt_text_word(wrapping(thread + PERF_CAUSAL_THREAD_TASK_PAUSED))))
    rt_text_store(wrapping(row + I64{64}), wrapping(rt_text_word(wrapping(thread + PERF_CAUSAL_THREAD_PAUSE_CPU)) - rt_text_word(wrapping(thread + PERF_CAUSAL_THREAD_TASK_PAUSE_CPU))))
    rt_text_store(wrapping(row + I64{72}), wrapping(rt_text_word(wrapping(thread + PERF_CAUSAL_THREAD_TICKS)) - rt_text_word(wrapping(thread + PERF_CAUSAL_THREAD_TASK_TICKS))))
    rt_text_store(wrapping(row + I64{80}), rt_text_word(wrapping(thread + PERF_CAUSAL_THREAD_TASK_DELAY)))
    rt_text_store(wrapping(row + I64{88}), delay)
    rt_text_store(wrapping(row + I64{96}), rt_text_word(wrapping(thread + PERF_CAUSAL_THREAD_TASK_CORE)))
    rt_text_store(wrapping(row + I64{104}), rt_text_word(wrapping(thread + PERF_CAUSAL_THREAD_GAP)))
    sync_store(row, (PERF_SAMPLES_CAUSAL << PERF_SAMPLES_KIND_BITS) | (PERF_CAUSAL_ROW_WORDS << PERF_SAMPLES_ADDRESS_BITS) | I64{3})
}

// Write the tasks' timings to the samples file `fd`: a PERF_SAMPLES_CAUSAL
// record with 4 in its low bits, the tasks that claimed a row and the rows
// the lens keeps (PERF_CAUSAL_ROWS_MAX), then the rows written whole, in
// runs of one write each. A later exit's hold an earlier one's.
perf_causal_rows_write: fn(fd: I64) {
    state: perf_causal_state
    if (state == I64{0}) {
        return
    }
    claimed: sync_load(wrapping(state + PERF_CAUSAL_ROW_COUNT))
    head: wrapping(state + PERF_CAUSAL_ROW_HEAD)
    rt_text_store(head, (PERF_SAMPLES_CAUSAL << PERF_SAMPLES_KIND_BITS) | (I64{3} << PERF_SAMPLES_ADDRESS_BITS) | I64{4})
    rt_text_store(wrapping(head + I64{8}), claimed)
    rt_text_store(wrapping(head + I64{16}), PERF_CAUSAL_ROWS_MAX)
    _ := host_write_all(fd, head, I64{24})
    rows: rt_text_word(wrapping(state + PERF_CAUSAL_ROWS))
    if (rows == I64{0}) {
        return
    }
    count: if (claimed > PERF_CAUSAL_ROWS_MAX) -> PERF_CAUSAL_ROWS_MAX else -> claimed
    bytes: wrapping(PERF_CAUSAL_ROW_WORDS * I64{8})
    from := I64{0}
    index := I64{0}
    loop index <= count {
        whole: index < count && sync_load(wrapping(rows + wrapping(index * bytes))) != I64{0}
        if (!whole) {
            if (index > from) {
                _ := host_write_all(fd, wrapping(rows + wrapping(from * bytes)), wrapping(wrapping(index - from) * bytes))
            }
            from = wrapping(index + I64{1})
        }
        index = wrapping(index + I64{1})
    }
}

// The idle table's cell for a task of body `body` begun after an idle gap
// of `gap` nanoseconds: its body's row (claimed when new) and the octave of
// the gap in microseconds; 0 when every row is another body's.
perf_causal_idle_cell: fn(state: I64, body: I64, gap: I64) -> I64 {
    octave := I64{0}
    micros := gap / I64{1000}
    loop micros > (I64{0}) && octave < wrapping(PERF_CAUSAL_GAPS - I64{1}) {
        micros = micros >> I64{1}
        octave = wrapping(octave + I64{1})
    }
    index := I64{0}
    loop index < PERF_CAUSAL_KINDS {
        row: wrapping(wrapping(state + wrapping(PERF_CAUSAL_IDLE_AT + I64{8})) + wrapping(index * PERF_CAUSAL_KIND_BYTES))
        held: sync_load(row)
        if (held == body || (held == I64{0} && sync_cas(row, I64{0}, body) == I64{0})) {
            return wrapping(wrapping(row + I64{8}) + wrapping(octave * I64{24}))
        }
        index = wrapping(index + I64{1})
    }
    I64{0}
}

// Write the idle table, as a PERF_SAMPLES_CAUSAL record with 2 in its low
// bits, to the samples file `fd`: the counts since the lens started, so a
// later exit's record holds an earlier one's. JetCLI CLI/Perf/Causal.jet
// fits how much slower a task runs the longer its CPU idled before it.
perf_causal_idle_write: fn(fd: I64) {
    state: perf_causal_state
    if (state == I64{0}) {
        return
    }
    record: wrapping(state + PERF_CAUSAL_IDLE_AT)
    rt_text_store(record, (PERF_SAMPLES_CAUSAL << PERF_SAMPLES_KIND_BITS) | (PERF_CAUSAL_IDLE_WORDS << PERF_SAMPLES_ADDRESS_BITS) | I64{2})
    _ := host_write_all(fd, record, wrapping(PERF_CAUSAL_IDLE_WORDS * I64{8}))
}

// The global delay as this thread parks (Sync.jet sync_park), for
// perf_causal_woken; -1 when the lens is off.
perf_causal_block: fn() -> I64 {
    state: perf_causal_state
    if (state == I64{0}) { return I64{-1} }
    sync_load(wrapping(state + PERF_CAUSAL_DELAY))
}

// After a park another thread's wake ended, which began when the global
// delay was `blocked` (perf_causal_block): the delays inserted meanwhile
// are forgiven, as in Coz's post_block. The waker ran through them and
// paid them (a task's end before its joiner can see it, any other thread
// at its samples), so the work the wake lets this thread do comes after
// them already. Charged them, a thread that parks often but never long
// enough to count as blocked at its next sample (perf_causal_blocked), as
// a joiner of short tasks does, pauses for them again on top of its
// waker's pause: on the critical path, that slows the program as no faster
// line would, and every line's prediction reads lower. The park is also no
// time of the thread's own: its next sample measures from the wake.
perf_causal_woken: fn(blocked: I64) {
    state: perf_causal_state
    if (blocked < I64{0} || state == I64{0}) {
        return
    }
    thread: perf_causal_thread(state)
    if (thread == I64{0}) {
        return
    }
    meanwhile: wrapping(sync_load(wrapping(state + PERF_CAUSAL_DELAY)) - blocked)
    rt_text_store(wrapping(thread + I64{8}), wrapping(rt_text_word(wrapping(thread + I64{8})) + meanwhile))
    perf_causal_mark(thread, perf_causal_clock(thread, I64{1}))
}

// This thread's entry, claimed by its tid on its first sample; 0 when the
// table is full.
perf_causal_thread: fn(state: I64) -> I64 {
    tid: thread_tid()
    probe := wrapping(tid * I64{2654435761}) & wrapping(PERF_CAUSAL_THREADS - I64{1})
    tries := I64{0}
    loop tries < PERF_CAUSAL_THREADS {
        entry: wrapping(wrapping(state + PERF_CAUSAL_THREAD_AT) + wrapping(probe * PERF_CAUSAL_THREAD_BYTES))
        held: sync_load(entry)
        if (held == tid) { return entry }
        if (held == I64{0} && sync_cas(entry, I64{0}, tid) == I64{0}) { return entry }
        probe = wrapping(probe + I64{1}) & wrapping(PERF_CAUSAL_THREADS - I64{1})
        tries = wrapping(tries + I64{1})
    }
    I64{0}
}

// Pay this thread's owed delay, `delay` less the `local` it has paid, and
// keep what it paid. A pause runs past its request by its own clock reads,
// by a preemption, and by the samples its spin sets off (perf_causal_tick),
// and the excess counts toward the delays inserted after it, as in Coz:
// were it dropped, every pause would add time the experiment's accounting
// (its wall time less the delay inserted) leaves in, and every line's
// prediction would read lower by the pauses' total excess, more the more
// often its threads pause, so the more samples a second the lens takes.
perf_causal_pay: fn(thread: I64, local: I64, delay: I64) {
    paid := local
    if (local < delay) {
        paid = wrapping(local + perf_causal_pause(thread, wrapping(delay - local)))
    }
    // A pause cut at PERF_CAUSAL_PAUSE_MAX_NS forgives the rest.
    rt_text_store(wrapping(thread + I64{8}), if (paid < delay) -> delay else -> paid)
}

// Pause this thread for `ns`, at most PERF_CAUSAL_PAUSE_MAX_NS: the time it
// paused. The pause spins on the clock and keeps its CPU. Coz sleeps, which
// is the same while every thread has a CPU of its own; but with more
// threads ready than CPUs (a loaded machine, or a cgroup's cap on the
// program's share) a sleeping thread's CPU goes to the program's other
// threads, the target line's among them, which then run faster in fact,
// not virtually, and the experiment credits the line with their gain on top
// of the delay. Spinning, the paused thread takes the CPU its own work
// would have taken, as a line slower by the delay would. The CPU time it
// spins is the lens's, so the samples it sets off are dropped
// (perf_causal_tick): while it pauses outside the handler its entry says
// so, and the CPU time it spun is kept for the sample the handler held back.
// Its wall time and CPU time also add to the entry's totals, for the
// timing of the task it ran in (perf_causal_row).
perf_causal_pause: fn(thread: I64, ns: I64) -> I64 {
    wait: if (ns > PERF_CAUSAL_PAUSE_MAX_NS) -> PERF_CAUSAL_PAUSE_MAX_NS else -> ns
    pausing: wrapping(thread + PERF_CAUSAL_THREAD_PAUSING)
    sync_store(pausing, I64{1})
    began: perf_causal_clock(thread, I64{1})
    cpu: perf_causal_clock(thread, I64{3})
    deadline: wrapping(began + wait)
    now := began
    loop now < deadline -> now = perf_causal_clock(thread, I64{1})
    spent: wrapping(perf_causal_clock(thread, I64{3}) - cpu)
    _ := sync_add(wrapping(thread + PERF_CAUSAL_THREAD_SPUN), spent)
    sync_store(pausing, I64{0})
    paused: wrapping(perf_causal_clock(thread, I64{1}) - began)
    rt_text_store(wrapping(thread + PERF_CAUSAL_THREAD_PAUSED), wrapping(rt_text_word(wrapping(thread + PERF_CAUSAL_THREAD_PAUSED)) + paused))
    rt_text_store(wrapping(thread + PERF_CAUSAL_THREAD_PAUSE_CPU), wrapping(rt_text_word(wrapping(thread + PERF_CAUSAL_THREAD_PAUSE_CPU)) + spent))
    paused
}

// The clock `clock` (CLOCK_MONOTONIC 1 or CLOCK_THREAD_CPUTIME_ID 3) in
// nanoseconds, read into this thread's entry's timespec. A pause outside the
// handler reads its clocks there, not in the handler's words
// (perf_samples_clock), which a sample taken meanwhile overwrites; such a
// sample leaves the entry's timespec alone (perf_causal_tick).
perf_causal_clock: fn(thread: I64, clock: I64) -> I64 {
    spec: wrapping(thread + I64{32})
    sync_clock_read(clock, spec)
    wrapping(wrapping(rt_text_word(spec) * I64{1000000000}) + rt_text_word(wrapping(spec + I64{8})))
}

// Whether `pc` is in one of the target's `count` ranges.
perf_causal_in_target: fn(state: I64, pc: I64, count: I64) -> Bool {
    index := I64{0}
    loop index < count && index < PERF_CAUSAL_RANGES {
        range: wrapping(wrapping(state + PERF_CAUSAL_RANGE_AT) + wrapping(index * I64{16}))
        if (pc >= rt_text_word(range) && pc < rt_text_word(wrapping(range + I64{8}))) {
            return true
        }
        index = wrapping(index + I64{1})
    }
    false
}

// Store at `out` the run time and the runqueue wait, in nanoseconds, that
// the threads of the table took since the last experiment's end: the first
// two fields of each one's /proc/self/task/<tid>/schedstat, less what they
// read then. A thread read for the first time, or whose counts went back
// (its tid now another thread's), counts from then; a thread gone or a
// kernel without schedstat counts nothing. The wait is the time
// a thread was ready to run but had no CPU: on a machine whose CPUs other
// work holds, or under a cgroup's cap on the program's share, whose
// throttled time the kernel counts as wait too. Then the highest and the
// lowest clock, in kHz, of the CPUs the threads that ran meanwhile last ran
// on (perf_causal_khz); 0 for both when none could be read. A CPU that
// idled clocks down, and a task begun on it runs slower than its siblings
// until it clocks up, which no line of the program causes. JetCLI
// CLI/Perf/Causal.jet withholds the predictions of a run whose threads
// waited too long, and flags those of one whose CPUs clocked down.
perf_causal_schedstat: fn(state: I64, out: I64) {
    buffer: wrapping(state + PERF_CAUSAL_SCRATCH)
    run := I64{0}
    wait := I64{0}
    high := I64{0}
    low := I64{0}
    index := I64{0}
    loop index < PERF_CAUSAL_THREADS {
        entry: wrapping(wrapping(state + PERF_CAUSAL_THREAD_AT) + wrapping(index * PERF_CAUSAL_THREAD_BYTES))
        index = wrapping(index + I64{1})
        tid: sync_load(entry)
        if (tid == I64{0}) { next }
        got: scheduler_task_file(tid, rt_static_text("schedstat"), buffer)
        if (got <= I64{0}) { next }
        ran: perf_causal_field(buffer, got, I64{0})
        waited: perf_causal_field(buffer, got, I64{1})
        last_run: wrapping(entry + PERF_CAUSAL_THREAD_RUN)
        last_wait: wrapping(entry + PERF_CAUSAL_THREAD_WAIT)
        counted: rt_text_word(last_run) != I64{0} && ran >= rt_text_word(last_run) && waited >= rt_text_word(last_wait)
        // Only the CPUs of threads that ran meanwhile: an idle thread's
        // CPU clocks down with no work of the program's on it.
        moved: counted && ran > rt_text_word(last_run)
        if (counted) {
            run = wrapping(run + wrapping(ran - rt_text_word(last_run)))
            wait = wrapping(wait + wrapping(waited - rt_text_word(last_wait)))
        }
        rt_text_store(last_run, ran)
        rt_text_store(last_wait, waited)
        if (moved) {
            khz: perf_causal_khz(tid, buffer)
            if (khz > high) { high = khz }
            if (khz > I64{0} && (low == I64{0} || khz < low)) { low = khz }
        }
    }
    rt_text_store(out, run)
    rt_text_store(wrapping(out + I64{8}), wait)
    rt_text_store(wrapping(out + I64{16}), high)
    rt_text_store(wrapping(out + I64{24}), low)
}

// The clock, in kHz, of the CPU thread `tid` last ran on: field 39 of its
// /proc/self/task/<tid>/stat, then that CPU's
// /sys/devices/system/cpu/cpu<N>/cpufreq/scaling_cur_freq; 0 when either
// cannot be read, as on a kernel without cpufreq. `buffer` holds
// SCHEDULER_STAT_BYTES.
perf_causal_khz: fn(tid: I64, buffer: I64) -> I64 {
    got: scheduler_task_file(tid, rt_static_text("stat"), buffer)
    // The fields after the name's last `)` are numbers but the state, the
    // third, which follows it and a space; the CPU is the 37th after that.
    paren := wrapping(got - I64{1})
    loop paren >= (I64{0}) && rt_text_byte(wrapping(buffer + paren)) != (I64{41}) {
        paren = wrapping(paren - I64{1})
    }
    if (paren < I64{0} || wrapping(paren + I64{2}) >= got) { return I64{0} }
    cpu: perf_causal_field(wrapping(buffer + paren + I64{2}), wrapping(got - paren - I64{2}), I64{36})
    prefix: rt_static_text("/sys/devices/system/cpu/cpu")
    at := rt_text_len(prefix)
    rt_text_bytes_copy(buffer, rt_text_data(prefix), at)
    at = wrapping(at + scheduler_put_number(wrapping(buffer + at), cpu))
    name: rt_static_text("/cpufreq/scaling_cur_freq")
    rt_text_bytes_copy(wrapping(buffer + at), rt_text_data(name), rt_text_len(name))
    rt_text_put(wrapping(buffer + at + rt_text_len(name)), I64{0})
    read: scheduler_read_path(buffer)
    if (read <= I64{0}) { return I64{0} }
    perf_causal_field(buffer, read, I64{0})
}

// The decimal number that field `field` (from 0) of the `length` bytes at
// `buffer`, separated by spaces, starts with.
perf_causal_field: fn(buffer: I64, length: I64, field: I64) -> I64 {
    at := I64{0}
    skipped := I64{0}
    loop at < length && skipped < field {
        if (rt_text_byte(wrapping(buffer + at)) == I64{32}) { skipped = wrapping(skipped + I64{1}) }
        at = wrapping(at + I64{1})
    }
    value := I64{0}
    loop at < length {
        digit: wrapping(rt_text_byte(wrapping(buffer + at)) - I64{48})
        if (digit < I64{0} || digit > I64{9}) { break }
        value = wrapping(wrapping(value * I64{10}) + digit)
        at = wrapping(at + I64{1})
    }
    value
}

// End the experiment that ran until `now`: write its record, then start the
// next, a baseline or the line holding `pc`, one ordinal on: the tasks'
// timings name the experiment by the count of records before its own.
perf_causal_next: fn(state: I64, pc: I64, now: I64) {
    record: wrapping(state + PERF_CAUSAL_RECORD)
    words: wrapping(I64{9} + wrapping(PERF_CAUSAL_POINTS * I64{3}))
    column: wrapping(PERF_CAUSAL_POINTS * I64{8})
    delay: sync_load(wrapping(state + PERF_CAUSAL_DELAY))
    rt_text_store(record, (PERF_SAMPLES_CAUSAL << PERF_SAMPLES_KIND_BITS) | (words << PERF_SAMPLES_ADDRESS_BITS))
    rt_text_store(wrapping(record + I64{8}), rt_text_word(wrapping(state + PERF_CAUSAL_TARGET)))
    rt_text_store(wrapping(record + I64{16}), rt_text_word(wrapping(state + PERF_CAUSAL_SPEED)))
    rt_text_store(wrapping(record + I64{24}), wrapping(now - rt_text_word(wrapping(state + PERF_CAUSAL_START))))
    rt_text_store(wrapping(record + I64{32}), wrapping(delay - rt_text_word(wrapping(state + PERF_CAUSAL_DELAY_START))))
    perf_causal_schedstat(state, wrapping(record + I64{40}))
    _ := sync_add(wrapping(state + PERF_CAUSAL_ORDINAL), I64{1})
    index := I64{0}
    loop index < PERF_CAUSAL_POINTS {
        point: wrapping(wrapping(state + PERF_CAUSAL_POINT_AT) + wrapping(index * PERF_CAUSAL_POINT_BYTES))
        first: sync_load(wrapping(point + I64{8}))
        out: wrapping(wrapping(record + I64{72}) + wrapping(index * I64{8}))
        rt_text_store(out, if (first == I64{0}) -> I64{0} else -> sync_load(wrapping(point + I64{40})))
        rt_text_store(wrapping(out + column), if (first == I64{0}) -> I64{0} else -> wrapping(sync_load(wrapping(point + I64{16})) - first))
        rt_text_store(wrapping(wrapping(out + column) + column), if (first == I64{0}) -> I64{0} else -> wrapping(sync_load(wrapping(point + I64{32})) - sync_load(wrapping(point + I64{24}))))
        sync_store(wrapping(point + I64{8}), I64{0})
        sync_store(wrapping(point + I64{40}), I64{0})
        index = wrapping(index + I64{1})
    }
    fd: perf_samples_fd
    if (fd >= I64{0}) {
        #Unsafe("one write of the record's words in the lens's own mapping, which the kernel copies before the call returns") {
            _ := os_syscall_i64(I64{1}, fd, record, wrapping(words * I64{8}), I64{0}, I64{0}, I64{0})
        }
    }
    sync_store(wrapping(state + PERF_CAUSAL_RANGE_COUNT), I64{0})
    random := rt_text_word(wrapping(state + PERF_CAUSAL_RANDOM))
    random = random ~ (random << I64{13})
    random = random ~ ((random >> I64{7}) & I64{144115188075855871})
    random = random ~ (random << I64{17})
    rt_text_store(wrapping(state + PERF_CAUSAL_RANDOM), random)
    count := I64{0}
    if (random & I64{1} != I64{0}) { count = perf_causal_line(state, pc) }
    rt_text_store(wrapping(state + PERF_CAUSAL_TARGET), if (count > I64{0}) -> pc else -> I64{0})
    sync_store(wrapping(state + PERF_CAUSAL_SPEED), if (count > I64{0}) -> PERF_CAUSAL_SPEEDUP else -> I64{0})
    rt_text_store(wrapping(state + PERF_CAUSAL_DELAY_START), sync_load(wrapping(state + PERF_CAUSAL_DELAY)))
    rt_text_store(wrapping(state + PERF_CAUSAL_START), perf_samples_clock())
    sync_store(wrapping(state + PERF_CAUSAL_RANGE_COUNT), count)
}

// The ranges of the source line that holds link-time address `pc`, in the
// function that holds it, stored as the target's: their count, 0 when no
// function of the program's own files holds it (a file whose name starts
// with `<` is Core's or the runtime's). The table's layout is
// Fault.jet trace_frame's.
perf_causal_line: fn(state: I64, pc: I64) -> I64 {
    table: rt_text_word(wrapping(state + PERF_CAUSAL_TABLE))
    table_end: rt_text_word(wrapping(state + PERF_CAUSAL_TABLE_END))
    block := table
    loop wrapping(block + I64{20}) <= table_end {
        end: wrapping(wrapping(block + I64{4}) + trace_u32(block))
        if (end < wrapping(block + I64{20}) || end > table_end) { return I64{0} }
        count: trace_u32(wrapping(block + I64{4}))
        strings: wrapping(block + trace_u32(wrapping(block + I64{8})))
        low := I64{0}
        low = rt_text_word(wrapping(block + I64{12}))
        cursor := wrapping(block + I64{20})
        left := count
        loop left > (I64{0}) && cursor < end {
            low = wrapping(low + trace_sleb(cursor))
            cursor = trace_leb_end(cursor)
            high: wrapping(low + trace_uleb(cursor))
            cursor = trace_leb_end(cursor)
            cursor = trace_leb_end(cursor)
            file: trace_uleb(cursor)
            cursor = trace_leb_end(trace_leb_end(cursor))
            rows_length: trace_uleb(cursor)
            cursor = trace_leb_end(cursor)
            rows_end: wrapping(cursor + rows_length)
            if (rows_end > end) { return I64{0} }
            if (pc >= low && pc < high) {
                if (trace_u16(wrapping(strings + file)) & I64{255} == I64{60}) { return I64{0} }
                line: trace_statement_line(cursor, rows_end, low, high, pc)
                if (line == I64{0}) { return I64{0} }
                return perf_causal_ranges(state, cursor, rows_end, low, high, line)
            }
            cursor = rows_end
            low = high
            left = wrapping(left - I64{1})
        }
        block = end
    }
    I64{0}
}

// Store each row range of line `line` in the function [low, high) whose
// rows are [rows, rows_end) (Fault.jet trace_statement_line's walk: its
// call rows left out) as the target's; their count.
perf_causal_ranges: fn(state: I64, rows: I64, rows_end: I64, low: I64, high: I64, line: I64) -> I64 {
    at := rows
    address := low
    current := I64{1}
    previous := I64{-1}
    previous_line := I64{0}
    count := I64{0}
    loop at < rows_end {
        advance: trace_uleb(at)
        address = wrapping(address + (advance >> I64{1}))
        at = trace_leb_end(at)
        call: advance & I64{1} != I64{0}
        if (call) { at = trace_leb_end(at) }
        current = wrapping(current + trace_sleb(at))
        at = trace_leb_end(at)
        if (call) { next }
        if (previous >= I64{0} && previous_line == line && address > previous && count < PERF_CAUSAL_RANGES) {
            perf_causal_range(state, count, previous, address)
            count = wrapping(count + I64{1})
        }
        previous = address
        previous_line = current
    }
    if (previous >= I64{0} && previous_line == line && high > previous && count < PERF_CAUSAL_RANGES) {
        perf_causal_range(state, count, previous, high)
        count = wrapping(count + I64{1})
    }
    count
}

perf_causal_range: fn(state: I64, index: I64, low: I64, high: I64) {
    range: wrapping(wrapping(state + PERF_CAUSAL_RANGE_AT) + wrapping(index * I64{16}))
    rt_text_store(range, low)
    rt_text_store(wrapping(range + I64{8}), high)
}

// One pass of the progress point the borrowed text `name` names, under the
// causal lens: its slot, by the name's hash, claimed on its first pass,
// which writes the slot's name record.
perf_causal_progress: fn(name: I64) {
    state: perf_causal_state
    if (state == I64{0}) {
        return
    }
    data: rt_text_data(name)
    length: rt_text_len(name)
    hash := I64{-3750763034362895579}
    index := I64{0}
    loop index < length {
        hash = wrapping((hash ~ rt_text_byte(wrapping(data + index))) * I64{1099511628211})
        index = wrapping(index + I64{1})
    }
    hash = hash | I64{1}
    tries := I64{0}
    slot := hash & wrapping(PERF_CAUSAL_POINTS - I64{1})
    loop tries < PERF_CAUSAL_POINTS {
        point: wrapping(wrapping(state + PERF_CAUSAL_POINT_AT) + wrapping(slot * PERF_CAUSAL_POINT_BYTES))
        held: sync_load(point)
        if (held == hash) {
            perf_causal_pass(state, point)
            return
        }
        if (held == I64{0} && sync_cas(point, I64{0}, hash) == I64{0}) {
            perf_causal_name(slot, data, length)
            perf_causal_pass(state, point)
            return
        }
        slot = wrapping(slot + I64{1}) & wrapping(PERF_CAUSAL_POINTS - I64{1})
        tries = wrapping(tries + I64{1})
    }
}

// One pass of the progress point held at `point`, in its span in the
// experiment: its time and the global delay then, as the first pass's when
// it is the first, else one more pass after the first; as the last's always.
perf_causal_pass: fn(state: I64, point: I64) {
    now: perf_samples_clock()
    delay: sync_load(wrapping(state + PERF_CAUSAL_DELAY))
    if (sync_cas(wrapping(point + I64{8}), I64{0}, now) == I64{0}) {
        sync_store(wrapping(point + I64{24}), delay)
    } else { _ := sync_add(wrapping(point + I64{40}), I64{1}) }
    sync_store(wrapping(point + I64{16}), now)
    sync_store(wrapping(point + I64{32}), delay)
}

// The record naming progress point slot `slot`: the `length` bytes at
// `data`, cut to 256.
perf_causal_name: fn(slot: I64, data: I64, length: I64) {
    fd: perf_samples_fd
    if (fd < I64{0}) {
        return
    }
    kept: if (length > I64{256}) -> I64{256} else -> length
    words: wrapping(I64{3} + (wrapping(kept + I64{7}) >> I64{3}))
    bytes: wrapping(words * I64{8})
    record: jet_rt_alloc(bytes, I64{8})
    thread_zero(record, bytes)
    rt_text_store(record, (PERF_SAMPLES_CAUSAL << PERF_SAMPLES_KIND_BITS) | (words << PERF_SAMPLES_ADDRESS_BITS) | I64{1})
    rt_text_store(wrapping(record + I64{8}), slot)
    rt_text_store(wrapping(record + I64{16}), kept)
    rt_text_bytes_copy(wrapping(record + I64{24}), data, kept)
    #Unsafe("one write of the record, which the kernel copies before the call returns") {
        _ := os_syscall_i64(I64{1}, fd, record, bytes, I64{0}, I64{0}, I64{0})
    }
    jet_rt_free(record, bytes, I64{8})
}
