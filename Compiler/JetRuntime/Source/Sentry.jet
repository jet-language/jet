// D-MEM-SENTRY1. Gate/fence/frame stack are per-thread at TCB128..184.
// Process112: mutex0 hardened8 release16 nextFrame24 nextSeq32 heapList40
// expiredStackList64 liveFrameList88. Heap rows5: start,len,live,owner,seq.
// Frame32: unique id0 and triple (start,len,seq) native word List at8.
// Expired stack ranges deduplicate by (start,len), retaining the newest seq.
// Source literals borrowed by gate scopes remain alive with the calling image.
// S36 / D-FAIL-EXIT1: metadata and the stop boundary share this fault status.
SENTRY_RUNTIME_EXIT_CODE :: prep { I64{70} }
sentry_root := I64{0}

// runtime-init: 4
#Export(c) fn jet_rt_sentry_init() {
    if (sentry_root != I64{0}) -> return
    sentry_root = alloc_required_valid(I64{112}, I64{8})
    thread_zero(sentry_root, I64{112})
    sync_store(sentry_root + I64{24}, I64{1})
}
fn sentry_available() -> Bool {
    sync_load(sentry_root + I64{16}) == I64{0} || sync_load(sentry_root + I64{8}) != I64{0} || sync_load(thread_base() + I64{176}) != I64{0}
}
#Export(c) fn jet_rt_sentry_set_hardened(enabled: I64) { _ := sync_swap(sentry_root + I64{8}, enabled) }
#Export(c) fn jet_rt_sentry_set_release(enabled: I64) { _ := sync_swap(sentry_root + I64{16}, enabled) }
fn sentry_save(save: I64) { coll_copy(thread_base() + I64{128}, save, I64{56}) }
#Export(c) fn jet_rt_sentry_scope_enter(save: I64, enabled: I64, fenced: I64, file: I64, file_len: I64, line: I64, reason: I64, reason_len: I64) {
    sentry_save(save)
    base :: thread_base()
    if (fenced != I64{0}) {
        depth :: sync_load(base + I64{176})
        if (depth != I64{-1}) -> sync_store(base + I64{176}, wrapping(depth + I64{1}))
    }
    sync_store(base + I64{128}, if (enabled != I64{0} && sentry_available()) -> I64{1} else -> I64{0})
    sync_store(base + I64{136}, file)
    sync_store(base + I64{144}, file_len)
    sync_store(base + I64{152}, line.bit_and(I64{4294967295}))
    sync_store(base + I64{160}, reason)
    sync_store(base + I64{168}, reason_len)
}
#Export(c) fn jet_rt_sentry_policy_enter(save: I64, enabled: I64) {
    sentry_save(save)
    sync_store(thread_base() + I64{128}, if (enabled != I64{0} && sentry_available()) -> I64{1} else -> I64{0})
}
#Export(c) fn jet_rt_sentry_scope_leave(save: I64) { coll_copy(save, thread_base() + I64{128}, I64{56}) }
fn sentry_sequence() -> I64 {
    sequence :: wrapping(sync_load(sentry_root + I64{32}) + I64{1})
    sync_store(sentry_root + I64{32}, sequence)
    sequence
}
fn sentry_stack() -> I64 {
    stack := sync_load(thread_base() + I64{184})
    if (stack == I64{0}) {
        stack = alloc_required_valid(I64{24}, I64{8})
        thread_zero(stack, I64{24})
        sync_store(thread_base() + I64{184}, stack)
    }
    stack
}
#Export(c) fn jet_rt_sentry_frame_enter() -> I64 {
    if !sentry_available() -> return I64{0}
    frame :: alloc_required_valid(I64{32}, I64{8})
    thread_zero(frame, I64{32})
    sync_mutex_lock(sentry_root)
    sync_store(frame, sync_load(sentry_root + I64{24}))
    sync_store(sentry_root + I64{24}, wrapping(sync_load(frame) + I64{1}))
    scheduler_words_push(sentry_root + I64{88}, frame)
    sync_mutex_unlock(sentry_root)
    scheduler_words_push(sentry_stack(), frame)
    frame
}
fn sentry_current_frame() -> I64 {
    stack :: sync_load(thread_base() + I64{184})
    if (stack == I64{0} || sync_load(stack) == I64{0}) -> return I64{0}
    sync_load(sync_load(stack + I64{16}) + (sync_load(stack) - I64{1}) * I64{8})
}
fn sentry_words_remove(header: I64, at: I64, width: I64) {
    count :: sync_load(header) - width
    data :: sync_load(header + I64{16})
    if at < count -> coll_copy(data + count * I64{8}, data + at * I64{8}, width * I64{8})
    sync_store(header, count)
}
fn sentry_expire(start: I64, length: I64, sequence: I64) {
    header :: sentry_root + I64{64}
    data :: sync_load(header + I64{16})
    at := I64{0}
    loop at < sync_load(header) {
        row :: data + at * I64{8}
        if (sync_load(row) == start && sync_load(row + I64{8}) == length) {
            if world_unsigned_before(sync_load(row + I64{16}), sequence) -> sync_store(row + I64{16}, sequence)
            return
        }
        at += I64{3}
    }
    scheduler_words_push(header, start)
    scheduler_words_push(header, length)
    scheduler_words_push(header, sequence)
}
#Export(c) fn jet_rt_sentry_frame_leave(frame: I64) {
    if (frame == I64{0}) -> return
    stack :: sync_load(thread_base() + I64{184})
    count :: sync_load(stack)
    data :: sync_load(stack + I64{16})
    at := I64{0}
    // Stable removal supports Rust's explicit out-of-order guard drop too.
    loop at < count {
        if (sync_load(data + at * I64{8}) == frame) {
            index := at
            loop index + (I64{1}) < count {
                sync_store(data + index * I64{8}, sync_load(data + (index + I64{1}) * I64{8}))
                index += I64{1}
            }
            sync_store(stack, count - I64{1})
            break
        }
        at += I64{1}
    }
    sync_mutex_lock(sentry_root)
    header :: frame + I64{8}
    rows :: sync_load(header + I64{16})
    at = I64{0}
    loop at < sync_load(header) {
        row :: rows + at * I64{8}
        sentry_expire(sync_load(row), sync_load(row + I64{8}), sync_load(row + I64{16}))
        at += I64{3}
    }
    live :: sentry_root + I64{88}
    entries :: sync_load(live + I64{16})
    at = I64{0}
    loop at < sync_load(live) {
        if (sync_load(entries + at * I64{8}) == frame) {
            sentry_words_remove(live, at, I64{1})
            break
        }
        at += I64{1}
    }
    sync_mutex_unlock(sentry_root)
    capacity :: sync_load(header + I64{8})
    if (capacity != I64{0}) -> jet_rt_free(rows, capacity * I64{8}, I64{8})
    alloc_release_valid(frame, I64{32}, I64{8})
}
fn sentry_thread_detach() {
    stack :: sync_load(thread_base() + I64{184})
    if (stack == I64{0}) -> return
    loop sync_load(stack) != (I64{0}) -> jet_rt_sentry_frame_leave(sentry_current_frame())
    scheduler_words_drop(stack)
    sync_store(thread_base() + I64{184}, I64{0})
}
fn sentry_register(owner: I64, frame: I64, start: I64, bytes: I64) {
    if (!sentry_available() || start == I64{0}) -> return
    length :: if (bytes == I64{0}) -> I64{1} else -> bytes
    sync_mutex_lock(sentry_root)
    sequence :: sentry_sequence()
    if (frame == I64{0}) {
        heap :: sentry_root + I64{40}
        scheduler_words_push(heap, start)
        scheduler_words_push(heap, length)
        scheduler_words_push(heap, I64{1})
        scheduler_words_push(heap, owner)
        scheduler_words_push(heap, sequence)
    } else {
        header :: frame + I64{8}
        data :: sync_load(header + I64{16})
        at := I64{0}
        loop at < sync_load(header) {
            row :: data + at * I64{8}
            if (sync_load(row) == start && sync_load(row + I64{8}) == length) {
                sync_store(row + I64{16}, sequence)
                sync_mutex_unlock(sentry_root)
                return
            }
            at += I64{3}
        }
        scheduler_words_push(header, start)
        scheduler_words_push(header, length)
        scheduler_words_push(header, sequence)
    }
    sync_mutex_unlock(sentry_root)
}
#Export(c) fn jet_rt_sentry_register_allocation(start: I64, bytes: I64) { sentry_register(I64{0}, I64{0}, start, bytes) }
#Export(c) fn jet_rt_sentry_register_owned_allocation(owner: I64, start: I64, bytes: I64) { sentry_register(owner, I64{0}, start, bytes) }
#Export(c) fn jet_rt_sentry_register_stack_allocation(start: I64, bytes: I64) {
    frame :: sentry_current_frame()
    if (frame != I64{0}) -> sentry_register(I64{0}, frame, start, bytes)
}
#Export(c) fn jet_rt_sentry_stack_address_of(start: I64, bytes: I64) -> I64 {
    jet_rt_sentry_register_stack_allocation(start, bytes)
    start
}
#Export(c) fn jet_rt_sentry_quarantine_owner(owner: I64) {
    if !sentry_available() -> return
    sync_mutex_lock(sentry_root)
    header :: sentry_root + I64{40}
    data :: sync_load(header + I64{16})
    at := I64{0}
    loop at < sync_load(header) {
        row :: data + at * I64{8}
        if (sync_load(row + I64{24}) == owner) -> sync_store(row + I64{16}, I64{0})
        at += I64{5}
    }
    sync_mutex_unlock(sentry_root)
}
#Export(c) fn jet_rt_sentry_quarantine(start: I64, bytes: I64) {
    if (!sentry_available() || start == I64{0}) -> return
    sync_mutex_lock(sentry_root)
    heap :: sentry_root + I64{40}
    data :: sync_load(heap + I64{16})
    poisoned := false
    at := I64{0}
    loop at < sync_load(heap) {
        row :: data + at * I64{8}
        if (sync_load(row) == start && sync_load(row + I64{16}) != I64{0}) {
            sync_store(row + I64{16}, I64{0})
            poisoned = true
        }
        at += I64{5}
    }
    live :: sentry_root + I64{88}
    frames :: sync_load(live + I64{16})
    index := I64{0}
    loop index < sync_load(live) {
        header :: sync_load(frames + index * I64{8}) + I64{8}
        rows :: sync_load(header + I64{16})
        at = I64{0}
        loop at < sync_load(header) {
            row :: rows + at * I64{8}
            if (sync_load(row) == start) {
                sentry_expire(start, sync_load(row + I64{8}), sync_load(row + I64{16}))
                sentry_words_remove(header, at, I64{3})
                poisoned = true
            } else { at += I64{3} }
        }
        index += I64{1}
    }
    if poisoned {
        at = I64{0}
        loop at < bytes {
            trap_put(start + at, I64{221})
            at += I64{1}
