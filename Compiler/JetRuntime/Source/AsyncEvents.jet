// Scheduler-backed typed events. One meaning with the Rust reference:
// JetDispatchReport, JetAsyncEntry, JetAsyncEvent. An AsyncEvent is shared
// across threads: every core field below moves under the core's mutex, and the
// counts of cores, entries and reports are atomic.
//
// AsyncCore184: refs0 owners8 lock16 listeners{len24 cap32 data40}
//   queued{len48 cap56 data64} blocked{len72 cap80 data88} running96
//   closed104 cancelled112 capacity120 overflow128 failure136 sequence144
//   next_id152 e_meta160 r_meta168 running_entry176
//   refs counts the handles, entries and scopes holding the core; owners
//   counts the handles (Rust's owner Arc): the last owner hard-cancels.
//   sequence is the futex word every state change bumps. e_meta describes
//   the failure E and r_meta a handler's `Result<Unit, E>`.
// AsyncListener: the Listener64 layout (Events.jet); its refs move under the
//   core lock. Its subscription has no EventCore (Rust JetSubscription::shared:
//   the active flag is the state), so unsubscribe only clears the flag and
//   the next registration or dispatch prunes the row.
// AsyncEntry72: refs0 core8 phase16 payload24 meta32 report40 accepted48
//   trace56 control64
//   One emit_async: its task holds a count, and so does each list holding it.
//   trace holds the ASYNC_TRACE_* steps it took; control is its task's
//   scheduler control (retained) once it runs, so a hard cancel reaches it.
// DispatchReport64: refs0 accepted8 state16 delivered24 summary32 queued40
//   failures48 e_meta56
//   summary is the owned trace text (its steps joined by " -> "); failures
//   is 0 or a heap word vector {len cap data} of [kind, value] pairs, a
//   Handler's value an E slot under e_meta, a Panic's its owned message.

ASYNC_PENDING: I64{0}
ASYNC_QUEUED: I64{1}
ASYNC_RUNNING: I64{2}
ASYNC_TERMINAL: I64{3}

ASYNC_TRACE_PENDING: I64{1}
ASYNC_TRACE_QUEUED: I64{2}
ASYNC_TRACE_RUNNING: I64{4}

// JetEventOverflow :822-826, JetFailurePolicy and JetDispatchState :880-888
// ordinals.
ASYNC_BLOCK: I64{0}
ASYNC_DROP_NEWEST: I64{1}
ASYNC_DROP_OLDEST: I64{2}
FAILURE_STOP_FIRST: I64{0}
FAILURE_COLLECT: I64{1}
FAILURE_LOG: I64{2}
DISPATCH_DELIVERED: I64{0}
DISPATCH_HANDLER_FAILED: I64{1}
DISPATCH_DROPPED_NEWEST: I64{2}
DISPATCH_DROPPED_OLDEST: I64{3}
DISPATCH_CLOSED: I64{4}
DISPATCH_CANCELLED: I64{5}
DISPATCH_DEADLINE_EXCEEDED: I64{6}

// A report failure's kind word: DispatchFailure.Handler or .Panic.
DISPATCH_FAILURE_HANDLER: I64{0}
DISPATCH_FAILURE_PANIC: I64{1}

// The DispatchFailure<E> layout words the lowering passes to
// jet_dispatch_report_failures.
FAILURE_BYTES: I64{0}
FAILURE_HANDLER_INDEX: I64{8}
FAILURE_HANDLER_AT: I64{16}
FAILURE_PANIC_INDEX: I64{24}
FAILURE_PANIC_AT: I64{32}

async_lock: fn(core: I64) { sync_mutex_lock(wrapping(core + I64{16})) }
async_unlock: fn(core: I64) { sync_mutex_unlock(wrapping(core + I64{16})) }

// Wakes every entry task waiting for its turn (Rust: each entry's wake slot).
async_notify: fn(core: I64) { sync_cond_notify_all(wrapping(core + I64{144})) }

// The entry task's inherited deadline has passed.
async_deadline_passed: fn() -> Bool {
    jet_ctx_deadline_present() && jet_deadline_remaining_ms() <= I64{0}
}

// Waits, lock held, for the next state change or the inherited deadline;
// the lock is held again on return. The wait is a blocking one for the
// scheduler's compensation.
async_wait: fn(core: I64) {
    before: sync_load(wrapping(core + I64{144}))
    deadline := I64{-1}
    if jet_ctx_deadline_present() {
        remaining: jet_deadline_remaining_ms()
        if (remaining < I64{9000000000000}) -> deadline = sync_deadline(remaining * I64{1000000})
    }
    async_unlock(core)
    _ := sync_wait(core + I64{144}, before, deadline)
    async_lock(core)
}

// ---- DispatchReport --------------------------------------------------------

// The report takes `lines` (the handlers' trace steps, or 0) and `failures`.
dispatch_report_new: fn(accepted: Bool, state: I64, delivered: I64, trace: I64, lines: I64, failures: I64, e_meta: I64) -> I64 {
    report: jet_rt_alloc(I64{64}, I64{8})
    sync_store(report, I64{1})
    sync_store(wrapping(report + I64{8}), if accepted -> I64{1} else -> I64{0})
    sync_store(wrapping(report + I64{16}), state)
    sync_store(wrapping(report + I64{24}), delivered)
    sync_store(wrapping(report + I64{32}), async_trace_text(trace, lines, state))
    sync_store(wrapping(report + I64{40}), if (trace.bit_and(ASYNC_TRACE_QUEUED) != I64{0}) -> I64{1} else -> I64{0})
    sync_store(wrapping(report + I64{48}), failures)
    sync_store(wrapping(report + I64{56}), if (failures != I64{0}) -> coll_meta_copy(e_meta) else -> I64{0})
    jet_rt_string_drop(lines)
    report
}

// `pending -> queued -> running -> {lines}terminal:{State}`, each step only
// when the entry took it.
async_trace_text: fn(trace: I64, lines: I64, state: I64) -> I64 {
    text: jet_rt_string_builder_new()
    if (trace.bit_and(ASYNC_TRACE_PENDING) != I64{0}) -> jet_rt_string_builder_push(text, rt_static_text("pending -> "))
    if (trace.bit_and(ASYNC_TRACE_QUEUED) != I64{0}) -> jet_rt_string_builder_push(text, rt_static_text("queued -> "))
    if (trace.bit_and(ASYNC_TRACE_RUNNING) != I64{0}) -> jet_rt_string_builder_push(text, rt_static_text("running -> "))
    if (lines != I64{0}) -> jet_rt_string_builder_push(text, lines)
    jet_rt_string_builder_push(text, rt_static_text("terminal:"))
    if {
        state == DISPATCH_DELIVERED -> jet_rt_string_builder_push(text, rt_static_text("Delivered"))
        state == DISPATCH_HANDLER_FAILED -> jet_rt_string_builder_push(text, rt_static_text("HandlerFailed"))
        state == DISPATCH_DROPPED_NEWEST -> jet_rt_string_builder_push(text, rt_static_text("DroppedNewest"))
        state == DISPATCH_DROPPED_OLDEST -> jet_rt_string_builder_push(text, rt_static_text("DroppedOldest"))
        state == DISPATCH_CLOSED -> jet_rt_string_builder_push(text, rt_static_text("Closed"))
        state == DISPATCH_CANCELLED -> jet_rt_string_builder_push(text, rt_static_text("Cancelled"))
        else -> jet_rt_string_builder_push(text, rt_static_text("DeadlineExceeded"))
    }
    jet_rt_string_builder_finish(text)
}

async_failures_free: fn(failures: I64, e_meta: I64) {
    if (failures == I64{0}) -> return
    length: event_word(failures)
    at := I64{0}
    loop at < length {
        value: event_words_get(failures, at + I64{1})
        if (event_words_get(failures, at) == DISPATCH_FAILURE_HANDLER) -> coll_slot_free(value, e_meta) else -> jet_rt_string_drop(value)
        at += I64{2}
    }
    event_words_free(event_word(wrapping(failures + I64{16})), event_word(wrapping(failures + I64{8})))
    jet_rt_free(failures, I64{24}, I64{8})
}

async_failures_push: fn(failures: I64, kind: I64, value: I64) -> I64 {
    vector := failures
    if (vector == I64{0}) {
        vector = jet_rt_alloc(I64{24}, I64{8})
        coll_zero(vector, I64{24})
    }
    event_words_push(vector, kind)
    event_words_push(vector, value)
    vector
}

#Export(c) jet_rt_handle_clone_jet_dispatch_report: fn(report: I64) -> I64 {
    _ := sync_add(report, I64{1})
    report
}

#Export(c) jet_rt_handle_drop_jet_dispatch_report: fn(report: I64) {
    if (report == I64{0}) -> return
    if (sync_add(report, I64{-1}) != I64{1}) -> return
    e_meta: sync_load(wrapping(report + I64{56}))
    jet_rt_string_drop(sync_load(wrapping(report + I64{32})))
    async_failures_free(sync_load(wrapping(report + I64{48})), e_meta)
    coll_meta_drop(e_meta)
    jet_rt_free(report, I64{64}, I64{8})
}

#Export(c) jet_dispatch_report_accepted: fn(report: I64) -> Bool {
    sync_load(wrapping(report + I64{8})) != I64{0}
}

#Export(c) jet_dispatch_report_delivered_handlers: fn(report: I64) -> I64 {
    jet_int_owned_from_i64(sync_load(wrapping(report + I64{24})))
}

// DispatchState is a payload-free program enum: its ordinal word.
#Export(c) jet_dispatch_report_state: fn(report: I64) -> I64 {
    sync_load(wrapping(report + I64{16}))
}

// trace :907-915: delivered handlers, whether the entry was queued, whether
// an overflow policy dropped it, and its steps.
#Export(c) jet_dispatch_report_trace: fn(report: I64) -> I64 {
    state: sync_load(wrapping(report + I64{16}))
    dropped: if (state == DISPATCH_DROPPED_NEWEST || state == DISPATCH_DROPPED_OLDEST) -> I64{1} else -> I64{0}
    event_trace_with_summary(sync_load(wrapping(report + I64{24})), sync_load(wrapping(report + I64{40})), dropped, jet_rt_string_clone(sync_load(wrapping(report + I64{32}))))
}

// failures :903-905: the [DispatchFailure<E>] header at `out`, each
// element a fresh enum box laid out by the `layout` words (FAILURE_*).
#Export(c) jet_dispatch_report_failures: fn(report: I64, layout: I64, out: I64) {
    failures: sync_load(wrapping(report + I64{48}))
    e_meta: sync_load(wrapping(report + I64{56}))
    count: if (failures == I64{0}) -> I64{0} else -> event_word(failures) / I64{2}
    bytes: event_word(wrapping(layout + FAILURE_BYTES))
    data: if (count == I64{0}) -> I64{0} else -> jet_rt_alloc(count * I64{8}, I64{8})
    at := I64{0}
    loop at < count {
        kind: event_words_get(failures, at * I64{2})
        value: event_words_get(failures, at * I64{2} + I64{1})
        boxed: jet_rt_alloc(bytes, I64{8})
        coll_zero(boxed, bytes)
        if (kind == DISPATCH_FAILURE_HANDLER) {
            event_store(boxed, event_word(wrapping(layout + FAILURE_HANDLER_INDEX)))
            hook_value_clone(value, wrapping(boxed + event_word(wrapping(layout + FAILURE_HANDLER_AT))), e_meta)
        } else {
            event_store(boxed, event_word(wrapping(layout + FAILURE_PANIC_INDEX)))
            event_store(wrapping(boxed + event_word(wrapping(layout + FAILURE_PANIC_AT))), jet_rt_string_clone(value))
        }
        event_store(wrapping(data + at * I64{8}), boxed)
        at += I64{1}
    }
    event_store(out, count)
    event_store(wrapping(out + I64{8}), count)
    event_store(wrapping(out + I64{16}), data)
}

// ---- AsyncEvent ------------------------------------------------------------

// JetAsyncEvent::new :1055-1072 borrows its validated policy (Core source
// rejects a capacity below 1 first); the FailurePolicy is its ordinal word.
// It keeps copies of the failure E's and the handler result's descriptors.
#Export(c) jet_async_event_new: fn(policy: I64, failures: I64, e_meta: I64, r_meta: I64) -> I64 {
    core: jet_rt_alloc(I64{184}, I64{8})
    coll_zero(core, I64{184})
    sync_store(core, I64{1})
    sync_store(wrapping(core + I64{8}), I64{1})
    sync_store(wrapping(core + I64{120}), dyn_word(wrapping(policy + ASYNC_POLICY_CAPACITY)))
    sync_store(wrapping(core + I64{128}), dyn_word(wrapping(policy + ASYNC_POLICY_OVERFLOW)))
    sync_store(wrapping(core + I64{136}), failures)
    sync_store(wrapping(core + I64{160}), coll_meta_copy(e_meta))
    sync_store(wrapping(core + I64{168}), coll_meta_copy(r_meta))
    core
}

async_core_retain: fn(core: I64) { _ := sync_add(core, I64{1}) }

// The last count frees the core: no entry or scope holds it any more, so
// its queues are empty and only the listener rows remain.
async_core_release: fn(core: I64) {
    if (sync_add(core, I64{-1}) != I64{1}) -> return
    base: wrapping(core + I64{24})
    length: event_word(base)
    data: event_word(wrapping(base + I64{16}))
    at := I64{0}
    loop at < length {
        event_listener_release(event_word(wrapping(data + at * I64{8})))
        at += I64{1}
    }
    event_words_free(data, event_word(wrapping(base + I64{8})))
    event_words_free(event_word(wrapping(core + I64{64})), event_word(wrapping(core + I64{56})))
    event_words_free(event_word(wrapping(core + I64{88})), event_word(wrapping(core + I64{80})))
    coll_meta_drop(sync_load(wrapping(core + I64{160})))
    coll_meta_drop(sync_load(wrapping(core + I64{168})))
    jet_rt_free(core, I64{184}, I64{8})
}

#Export(c) jet_rt_handle_clone_jet_async_event: fn(core: I64) -> I64 {
    _ := sync_add(wrapping(core + I64{8}), I64{1})
    async_core_retain(core)
    core
}

// Drop for JetAsyncEvent :1040-1046: the last owner hard-cancels.
#Export(c) jet_rt_handle_drop_jet_async_event: fn(core: I64) {
    if (core == I64{0}) -> return
    if (sync_add(wrapping(core + I64{8}), I64{-1}) == I64{1}) -> async_hard_cancel(core)
    async_core_release(core)
}

// ---- Entries ---------------------------------------------------------------

async_entry_retain: fn(entry: I64) { _ := sync_add(entry, I64{1}) }

async_entry_release: fn(entry: I64) {
    if (sync_add(entry, I64{-1}) != I64{1}) -> return
    meta: sync_load(wrapping(entry + I64{32}))
    payload: sync_load(wrapping(entry + I64{24}))
    if (payload != I64{0}) -> coll_slot_free(payload, meta)
    coll_meta_drop(meta)
    jet_rt_handle_drop_jet_dispatch_report(sync_load(wrapping(entry + I64{40})))
    scheduler_control_drop(sync_load(wrapping(entry + I64{64})))
    async_core_release(sync_load(wrapping(entry + I64{8})))
    jet_rt_free(entry, I64{72}, I64{8})
}

async_entry_trace: fn(entry: I64, step: I64) {
    sync_store(wrapping(entry + I64{56}), sync_load(wrapping(entry + I64{56})).bit_or(step))
}

// Removes `entry` from the list at `base` and drops the list's count; the
// caller holds its own count, so this is never the last.
async_list_remove: fn(base: I64, entry: I64) {
    at := I64{0}
    loop at < event_word(base) {
        if (event_words_get(base, at) == entry) {
            event_words_remove(base, at)
            _ := sync_add(entry, I64{-1})
            return
        }
        at += I64{1}
    }
}

async_list_push: fn(base: I64, entry: I64) {
    async_entry_retain(entry)
    event_words_push(base, entry)
}

// complete_entry :1271-1310, lock held: the entry turns terminal with its
// report and its payload ends there; a terminal entry stays terminal.
async_complete: fn(entry: I64, accepted: Bool, state: I64) {
    async_finish(entry, accepted, state, I64{0}, I64{0}, I64{0}, I64{0})
}

// async_complete for a dispatch: its delivered count, handler trace lines
// and failures (both taken) go to the report.
async_finish: fn(entry: I64, accepted: Bool, state: I64, delivered: I64, lines: I64, failures: I64, e_meta: I64) {
    if (sync_load(wrapping(entry + I64{16})) == ASYNC_TERMINAL) {
        jet_rt_string_drop(lines)
        async_failures_free(failures, e_meta)
        return
    }
    sync_store(wrapping(entry + I64{16}), ASYNC_TERMINAL)
    sync_store(wrapping(entry + I64{48}), if accepted -> I64{1} else -> I64{0})
    sync_store(wrapping(entry + I64{40}), dispatch_report_new(accepted, state, delivered, sync_load(wrapping(entry + I64{56})), lines, failures, e_meta))
    payload: sync_load(wrapping(entry + I64{24}))
    sync_store(wrapping(entry + I64{24}), I64{0})
    if (payload != I64{0}) -> async_payload_free(payload, sync_load(wrapping(entry + I64{32})))
}

// An entry's payload drop is its own cleanup, not a wait point: a deadline
// or cancel it outlives stays with the report and is not published.
async_payload_free: fn(payload: I64, meta: I64) {
    jet_scheduler_shield_enter()
    coll_slot_free(payload, meta)
    scheduler_shield_leave_finished()
}

// hard_cancel_state :1316-1339: once; every queued and blocked entry ends
// Cancelled (a queued one accepted), and the running one's task is
// cancelled so its handler stops at its next wait.
async_hard_cancel: fn(core: I64) {
    async_lock(core)
    if (sync_load(wrapping(core + I64{112})) != I64{0}) {
        async_unlock(core)
        return
    }
    sync_store(wrapping(core + I64{112}), I64{1})
    async_drain(wrapping(core + I64{48}), true, DISPATCH_CANCELLED)
    async_drain(wrapping(core + I64{72}), false, DISPATCH_CANCELLED)
    running: sync_load(wrapping(core + I64{176}))
    control: if (running != I64{0}) -> sync_load(wrapping(running + I64{64})) else -> I64{0}
    scheduler_control_retain(control)
    async_notify(core)
    async_unlock(core)
    if (control != I64{0}) {
        scheduler_control_cancel(control)
        scheduler_control_drop(control)
    }
}

// Completes and unlists every entry of the list at `base`, lock held.
async_drain: fn(base: I64, accepted: Bool, state: I64) {
    length: event_word(base)
    data: event_word(wrapping(base + I64{16}))
    at := I64{0}
    loop at < length {
        entry: event_word(wrapping(data + at * I64{8}))
        async_complete(entry, accepted, state)
        _ := sync_add(entry, I64{-1})
        at += I64{1}
    }
    event_store(base, I64{0})
}

// ---- Registration ----------------------------------------------------------

// Keeps only listeners whose subscription is still active, lock held
// (run_entry_inner :1477). A row's last count can drop here, which runs its
// closure's release under the lock.
async_prune_listeners: fn(core: I64) {
    base: wrapping(core + I64{24})
    data: event_word(wrapping(base + I64{16}))
    kept := I64{0}
    at := I64{0}
    loop at < event_word(base) {
        listener: event_word(wrapping(data + at * I64{8}))
        if event_sub_active(event_word(wrapping(listener + I64{32}))) {
            event_store(wrapping(data + kept * I64{8}), listener)
            kept += I64{1}
        } else {
            event_listener_release(listener)
        }
        at += I64{1}
    }
    event_store(base, kept)
}

// JetAsyncEvent::add :1086-1128 (on / once / on_priority): the scope tracks
// the subscription and the event's hard cancel; a cancelled scope returns
// the subscription inactive and the handler is released unregistered.
#Export(c) jet_async_event_listen: fn(core: I64, scope: I64, priority: I64, once: I64, env: I64, invoke: I64, release: I64) -> I64 {
    sub: event_sub_new()
    event_scope_track(scope, sub)
    if !event_sub_active(sub) {
        event_release_closure(env, release)
        return sub
    }
    event_scope_track_hard_cancel(scope, core)
    listener: jet_rt_alloc(I64{64}, I64{8})
    event_store(listener, I64{1})
    event_store(wrapping(listener + I64{16}), priority)
    event_store(wrapping(listener + I64{24}), if (once != I64{0}) -> I64{1} else -> I64{0})
    event_store(wrapping(listener + I64{32}), event_sub_retain(sub))
    event_store(wrapping(listener + I64{40}), env)
    event_store(wrapping(listener + I64{48}), invoke)
    event_store(wrapping(listener + I64{56}), release)
    async_lock(core)
    async_prune_listeners(core)
    id: sync_load(wrapping(core + I64{152}))
    sync_store(wrapping(core + I64{152}), id + I64{1})
    event_store(wrapping(listener + I64{8}), id)
    event_words_push(wrapping(core + I64{24}), listener)
    async_unlock(core)
    sub
}

// close :1500-1511: once; every blocked entry ends Closed, unaccepted.
#Export(c) jet_async_event_close: fn(core: I64) {
    async_lock(core)
    if (sync_load(wrapping(core + I64{104})) == I64{0}) {
        sync_store(wrapping(core + I64{104}), I64{1})
        async_drain(wrapping(core + I64{72}), false, DISPATCH_CLOSED)
        async_notify(core)
    }
    async_unlock(core)
}

async_count: fn(core: I64, offset: I64) -> I64 {
    async_lock(core)
    count: sync_load(wrapping(core + offset))
    async_unlock(core)
    jet_int_owned_from_i64(count)
}

#Export(c) jet_async_event_queued_count: fn(core: I64) -> I64 { async_count(core, I64{48}) }
#Export(c) jet_async_event_running_count: fn(core: I64) -> I64 { async_count(core, I64{96}) }
#Export(c) jet_async_event_blocked_count: fn(core: I64) -> I64 { async_count(core, I64{72}) }

#Export(c) jet_async_event_listener_count: fn(core: I64) -> I64 {
    async_lock(core)
    count: event_active_listeners(core)
    async_unlock(core)
    jet_int_owned_from_i64(count)
}

// ---- Dispatch --------------------------------------------------------------

// emit_async :1131-1140 and enqueue_async :1155-1250: the entry takes over
// the moved payload's bytes at `payload` under a copy of `meta`, joins the
// queue (or the blocked list, or ends at once by the overflow policy) and a
// task runs it; the task's result is its DispatchReport under `report_meta`.
#Export(c) jet_async_event_emit: fn(core: I64, payload: I64, meta: I64, report_meta: I64) -> I64 {
    entry: jet_rt_alloc(I64{72}, I64{8})
    coll_zero(entry, I64{72})
    sync_store(entry, I64{1})
    async_core_retain(core)
    sync_store(wrapping(entry + I64{8}), core)
    owned: coll_meta_copy(meta)
    slot: coll_slot_new(owned)
    coll_copy(payload, slot, coll_payload(owned))
    sync_store(wrapping(entry + I64{24}), slot)
    sync_store(wrapping(entry + I64{32}), owned)
    async_lock(core)
    capacity: sync_load(wrapping(core + I64{120}))
    closed: sync_load(wrapping(core + I64{104})) != I64{0}
    cancelled: sync_load(wrapping(core + I64{112})) != I64{0}
    has_room: event_word(wrapping(core + I64{48})) < capacity
    policy: sync_load(wrapping(core + I64{128}))
    if {
        closed -> async_complete(entry, false, DISPATCH_CLOSED)
        cancelled -> async_complete(entry, false, DISPATCH_CANCELLED)
        has_room -> async_enqueue(core, entry)
        policy == ASYNC_BLOCK -> {
            async_entry_trace(entry, ASYNC_TRACE_PENDING)
            async_list_push(wrapping(core + I64{72}), entry)
        }
        policy == ASYNC_DROP_NEWEST -> async_complete(entry, false, DISPATCH_DROPPED_NEWEST)
        else -> {
            if (event_word(wrapping(core + I64{48})) != I64{0}) {
                oldest: event_words_get(wrapping(core + I64{48}), I64{0})
                event_words_remove(wrapping(core + I64{48}), I64{0})
                async_complete(oldest, true, DISPATCH_DROPPED_OLDEST)
                _ := sync_add(oldest, I64{-1})
            }
            async_enqueue(core, entry)
        }
    }
    async_notify(core)
    async_unlock(core)
    task_spawn_typed_deadline(rt_static_text(""), entry, rt_async_entry_invoke_address(), rt_async_entry_release_address(), report_meta)
}

async_enqueue: fn(core: I64, entry: I64) {
    sync_store(wrapping(entry + I64{16}), ASYNC_QUEUED)
    sync_store(wrapping(entry + I64{48}), I64{1})
    async_entry_trace(entry, ASYNC_TRACE_QUEUED)
    async_list_push(wrapping(core + I64{48}), entry)
}

// RuntimeLower resolves these checked addresses through its sole intrinsic table.
rt_async_entry_invoke_address: fn() -> I64 {
    loop { jet_rt_unreachable(I64{0}, I64{0}) }
}
rt_async_entry_release_address: fn() -> I64 {
    loop { jet_rt_unreachable(I64{0}, I64{0}) }
}

// The entry task's body: its DispatchReport into the task's result slot.
#Export(c) jet_async_entry_invoke: fn(entry: I64, out: I64) -> I64 {
    report: async_entry_run(entry)
    if (report != I64{0}) -> sync_store(out, report)
    I64{0}
}

#Export(c) jet_async_entry_release: fn(entry: I64) -> I64 {
    async_entry_release(entry)
    I64{0}
}

// run_entry_inner :1342-1497: the entry waits for its turn. A blocked entry
// joins the queue once there is room (or ends Closed); the queue's front
// runs when nothing else is running. Past the deadline its task inherited, a
// waiting entry leaves its list and ends DeadlineExceeded with no handler
// run. Its due listeners are snapshot under the lock in priority order (a
// once listener reserved by clearing its flag), then each runs with the
// payload lent.
async_entry_run: fn(entry: I64) -> I64 {
    core: sync_load(wrapping(entry + I64{8}))
    async_lock(core)
    loop {
        phase: sync_load(wrapping(entry + I64{16}))
        if (phase == ASYNC_TERMINAL) {
            report: jet_rt_handle_clone_jet_dispatch_report(sync_load(wrapping(entry + I64{40})))
            async_unlock(core)
            return report
        }
        if (sync_load(wrapping(core + I64{112})) != I64{0}) {
            async_complete(entry, sync_load(wrapping(entry + I64{48})) != I64{0}, DISPATCH_CANCELLED)
            next
        }
        if async_deadline_passed() {
            async_list_remove(wrapping(core + I64{48}), entry)
            async_list_remove(wrapping(core + I64{72}), entry)
            async_complete(entry, sync_load(wrapping(entry + I64{48})) != I64{0}, DISPATCH_DEADLINE_EXCEEDED)
            async_notify(core)
            next
        }
        if (phase == ASYNC_PENDING) {
            if (sync_load(wrapping(core + I64{104})) != I64{0}) {
                async_list_remove(wrapping(core + I64{72}), entry)
                async_complete(entry, false, DISPATCH_CLOSED)
                next
            }
            if (event_word(wrapping(core + I64{48})) < sync_load(wrapping(core + I64{120}))) {
                async_list_remove(wrapping(core + I64{72}), entry)
                async_enqueue(core, entry)
            }
        }
        front: event_word(wrapping(core + I64{48})) != I64{0} && event_words_get(wrapping(core + I64{48}), I64{0}) == entry
        if (sync_load(wrapping(entry + I64{16})) == ASYNC_QUEUED && sync_load(wrapping(core + I64{96})) == I64{0} && front) {
            return async_dispatch(core, entry)
        }
        async_wait(core)
    }
}

// The listener rows due for one dispatch, lock held: each retained, ordered
// by priority (highest first) then registration.
async_snapshot: fn(core: I64) -> I64 {
    base: wrapping(core + I64{24})
    length: event_word(base)
    snapshot: jet_rt_alloc((length + I64{2}) * I64{8}, I64{8})
    event_store(wrapping(snapshot + I64{8}), length)
    rows: wrapping(snapshot + I64{16})
    count := I64{0}
    at := I64{0}
    loop at < length {
        listener: event_words_get(base, at)
        sub: event_word(wrapping(listener + I64{32}))
        once: event_word(wrapping(listener + I64{24})) != I64{0}
        due: if once -> sync_cas(wrapping(sub + I64{8}), I64{1}, I64{0}) == I64{1} else -> event_sub_active(sub)
        if due {
            event_listener_retain(listener)
            event_snapshot_insert(rows, count, listener)
            count += I64{1}
        }
        at += I64{1}
    }
    event_store(snapshot, count)
    snapshot
}

// `handler:{index}:{outcome}` then the step separator.
async_handler_line: fn(lines: I64, index: I64, outcome: I64) {
    jet_rt_string_builder_push(lines, rt_static_text("handler:"))
    rt_text_push_number(lines, index)
    jet_rt_string_builder_push(lines, rt_static_text(":"))
    jet_rt_string_builder_push(lines, outcome)
}

// Runs the front entry, lock held on entry and released on return. Each
// handler's `Result<Unit, E>` lands in `scratch`: an Err is a failure the
// FailurePolicy keeps (StopFirst and Collect), logs or ignores. A panic is a
// Panic failure that ends the run HandlerFailed; a cancel or deadline stop
// ends it Cancelled or DeadlineExceeded, and any other stop ends the task
// with no report.
async_dispatch: fn(core: I64, entry: I64) -> I64 {
    event_words_remove(wrapping(core + I64{48}), I64{0})
    sync_store(wrapping(entry + I64{16}), ASYNC_RUNNING)
    async_entry_trace(entry, ASYNC_TRACE_RUNNING)
    control: scheduler_control_current()
    scheduler_control_retain(control)
    sync_store(wrapping(entry + I64{64}), control)
    sync_store(wrapping(core + I64{96}), I64{1})
    sync_store(wrapping(core + I64{176}), entry)
    snapshot: async_snapshot(core)
    payload: sync_load(wrapping(entry + I64{24}))
    sync_store(wrapping(entry + I64{24}), I64{0})
    e_meta: sync_load(wrapping(core + I64{160}))
    r_meta: sync_load(wrapping(core + I64{168}))
    policy: sync_load(wrapping(core + I64{136}))
    async_notify(core)
    async_unlock(core)
    scratch: coll_slot_new(r_meta)
    lines: jet_rt_string_builder_new()
    failures := I64{0}
    state := DISPATCH_DELIVERED
    delivered := I64{0}
    // 0 ran to the end, else the stop kind that ended the run.
    stop := I64{0}
    count: event_snapshot_count(snapshot)
    at := I64{0}
    loop at < count {
        listener: event_snapshot_get(snapshot, at)
        once: event_word(wrapping(listener + I64{24})) != I64{0}
        if (once || event_sub_active(event_word(wrapping(listener + I64{32})))) {
            delivered += I64{1}
            event_listener_call(listener, payload, scratch)
            if (jet_rt_session_propagate() != I64{0}) {
                record: scheduler_control_take_stop(control)
                kind: if (record == I64{0}) -> I64{1} else -> sync_load(record)
                if (kind == I64{5}) {
                    message: scheduler_stop_take_message(record)
                    scheduler_stop_drop(record)
                    async_handler_line(lines, at, rt_static_text("panic:"))
                    jet_rt_string_builder_push(lines, message)
                    jet_rt_string_builder_push(lines, rt_static_text(" -> "))
                    failures = async_failures_push(failures, DISPATCH_FAILURE_PANIC, message)
                    state = DISPATCH_HANDLER_FAILED
                } else if (kind == I64{1} || kind == I64{2}) {
                    scheduler_stop_drop(record)
                    if (kind == I64{1}) -> scheduler_control_cancel_consume(control)
                    stop = kind
                } else {
                    _ := scheduler_native_publish(record)
                    stop = kind
                }
                break
            }
            // Past its wait points a handler's outcome is decided: recording
            // it (and dropping its result) runs under the runtime's own
            // shield, so a cancel arriving meanwhile waits for the next
            // handler instead of failing a finished payload.
            jet_scheduler_shield_enter()
            boxed: event_word(scratch)
            if (event_word(boxed) == I64{1}) {
                async_handler_line(lines, at, rt_static_text("delivered -> "))
            } else if (policy == FAILURE_STOP_FIRST || policy == FAILURE_COLLECT || policy == FAILURE_LOG) {
                async_handler_line(lines, at, rt_static_text("failed -> "))
                if (policy == FAILURE_LOG) {
                    _ := host_stdio_text_failure(rt_static_text("event handler failed"), true, true, false)
                } else {
                    failure: coll_slot_new(e_meta)
                    hook_value_clone(wrapping(boxed + I64{8}), failure, e_meta)
                    failures = async_failures_push(failures, DISPATCH_FAILURE_HANDLER, failure)
                    state = DISPATCH_HANDLER_FAILED
                }
            }
            coll_slot_drop(scratch, r_meta)
            coll_zero(scratch, coll_size(r_meta))
            scheduler_shield_leave_finished()
            if (state == DISPATCH_HANDLER_FAILED && policy == FAILURE_STOP_FIRST) -> break
        }
        at += I64{1}
    }
    // Every handler has run: the terminal is decided, and the bookkeeping
    // below (listener releases can run closure drops) cannot deliver a late
    // cancel that would fail the task instead of publishing its report.
    jet_scheduler_shield_enter()
    jet_rt_free(scratch, coll_size(r_meta), I64{8})
    async_payload_free(payload, sync_load(wrapping(entry + I64{32})))
    text: jet_rt_string_builder_finish(lines)
    async_lock(core)
    at = I64{0}
    loop at < count {
        event_listener_release(event_snapshot_get(snapshot, at))
        at += I64{1}
    }
    event_snapshot_free(snapshot)
    sync_store(wrapping(core + I64{96}), I64{0})
    sync_store(wrapping(core + I64{176}), I64{0})
    async_prune_listeners(core)
    report := I64{0}
    if (stop == I64{0}) {
        async_finish(entry, true, state, delivered, text, failures, e_meta)
        report = jet_rt_handle_clone_jet_dispatch_report(sync_load(wrapping(entry + I64{40})))
    } else {
        jet_rt_string_drop(text)
        async_failures_free(failures, e_meta)
        terminal: if (stop == I64{2}) -> DISPATCH_DEADLINE_EXCEEDED else -> DISPATCH_CANCELLED
        async_complete(entry, true, terminal)
        if (stop == I64{1} || stop == I64{2}) -> report = jet_rt_handle_clone_jet_dispatch_report(sync_load(wrapping(entry + I64{40})))
    }
    // The queue's list count passes to the run, which ends here.
    _ := sync_add(entry, I64{-1})
    async_notify(core)
    async_unlock(core)
    scheduler_shield_leave_finished()
    report
}
