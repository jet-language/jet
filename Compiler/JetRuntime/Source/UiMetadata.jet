// Reused metadata ownership/order from 78f5f6471 and reserved-name fix
// 4d4c53097. The Core UIAccessibility, UIAccessibilityState, UIShortcut and
// UIShortcutModifiers structs cross runtime routes as these records (JetIR
// RuntimeRoutes.jet IR_GENERATED_RECORDS). UiABI only.
ui_optional_text_clone: fn(value: I64) -> I64 {
    if (value == I64{0}) -> I64{0} else -> jet_rt_string_clone(value)
}
ui_optional_text_drop: fn(value: I64) {
    if (value != I64{0}) -> jet_rt_string_drop(value)
}
ui_optional_text_eq: fn(left: I64, right: I64) -> Bool {
    if (left == I64{0} || right == I64{0}) -> return left == right
    jet_rt_string_eq(left, right)
}
// An Option getter's present text: an owned copy through `some`.
ui_optional_text_get: fn(value: I64, some: I64) -> I64 {
    if (value == I64{0}) -> return I64{0}
    ui_carrier_store(some, jet_rt_string_clone(value))
    I64{1}
}
// Bool occupies a byte, not the uninitialized rest of its carrier word.
ui_carrier_bool: fn(address: I64) -> I64 { if ((ui_carrier_word(address).bit_and(I64{255})) == I64{0}) -> I64{0} else -> I64{1} }
ui_borrow_text: fn(value: I64, out: I64) {
    ui_carrier_store(out, ui_carrier_word(value))
    ui_carrier_store(wrapping(out + I64{8}), ui_carrier_word(wrapping(value + I64{8})))
    ui_carrier_store(wrapping(out + I64{16}), ui_carrier_word(wrapping(value + I64{16})))
}

// UIAccessibilityState: a UI_STATE_BYTES state, inline in its accessibility's
// states or boxed alone (a constructed record, before the sequence adopts it).
ui_state_new: fn(kind: I64, payload: I64) -> I64 {
    state: jet_rt_alloc(UI_STATE_BYTES, I64{8})
    ui_carrier_store(state, kind)
    ui_carrier_store(wrapping(state + UI_STATE_PAYLOAD), payload)
    state
}
ui_state_flag: fn(value: U8) -> I64 { if (value == U8{0}) -> I64{0} else -> I64{1} }
ui_state_payload: fn(state: I64, kind: I64) -> I64 {
    // The IR reads a variant's payload only after its tag selected it.
    if (ui_carrier_word(state) != kind) -> jet_rt_unreachable(I64{0}, I64{0})
    wrapping(state + UI_STATE_PAYLOAD)
}
ui_state_copy: fn(state: I64, target: I64) {
    state_kind: ui_carrier_word(state)
    ui_carrier_store(target, state_kind)
    payload: if {
        state_kind == UI_STATE_VALUE -> jet_rt_string_clone(ui_carrier_word(wrapping(state + UI_STATE_PAYLOAD)))
        state_kind == UI_STATE_EXPANDED || state_kind == UI_STATE_CHECKED || state_kind == UI_STATE_SELECTED -> ui_carrier_bool(wrapping(state + UI_STATE_PAYLOAD))
        else -> I64{0}
    }
    ui_carrier_store(wrapping(target + UI_STATE_PAYLOAD), payload)
}
ui_state_fields_drop: fn(state: I64) {
    if (ui_carrier_word(state) == UI_STATE_VALUE) -> jet_rt_string_drop(ui_carrier_word(wrapping(state + UI_STATE_PAYLOAD)))
}
ui_state_eq: fn(a: I64, b: I64) -> Bool {
    state_kind: ui_carrier_word(a)
    if (state_kind != ui_carrier_word(b)) -> return false
    if (state_kind == UI_STATE_VALUE) -> return jet_rt_string_eq(ui_carrier_word(wrapping(a + UI_STATE_PAYLOAD)), ui_carrier_word(wrapping(b + UI_STATE_PAYLOAD)))
    if (state_kind == UI_STATE_EXPANDED || state_kind == UI_STATE_CHECKED || state_kind == UI_STATE_SELECTED) -> return ui_carrier_bool(wrapping(a + UI_STATE_PAYLOAD)) == ui_carrier_bool(wrapping(b + UI_STATE_PAYLOAD))
    true
}
#Export(c) jet_rt_record_new_jet_ui_accessibility_state_disabled: fn() -> I64 { ui_state_new(UI_STATE_DISABLED, I64{0}) }
#Export(c) jet_rt_record_new_jet_ui_accessibility_state_busy: fn() -> I64 { ui_state_new(UI_STATE_BUSY, I64{0}) }
#Export(c) jet_rt_record_new_jet_ui_accessibility_state_expanded: fn(value: U8) -> I64 { ui_state_new(UI_STATE_EXPANDED, ui_state_flag(value)) }
#Export(c) jet_rt_record_new_jet_ui_accessibility_state_checked: fn(value: U8) -> I64 { ui_state_new(UI_STATE_CHECKED, ui_state_flag(value)) }
#Export(c) jet_rt_record_new_jet_ui_accessibility_state_selected: fn(value: U8) -> I64 { ui_state_new(UI_STATE_SELECTED, ui_state_flag(value)) }
#Export(c) jet_rt_record_new_jet_ui_accessibility_state_required: fn() -> I64 { ui_state_new(UI_STATE_REQUIRED, I64{0}) }
#Export(c) jet_rt_record_new_jet_ui_accessibility_state_value: fn(value: I64) -> I64 { ui_state_new(UI_STATE_VALUE, jet_rt_string_clone(value)) }
#Export(c) jet_rt_record_tag_jet_ui_accessibility_state: fn(state: I64) -> I64 { ui_carrier_word(state) }
#Export(c) jet_rt_record_get_jet_ui_accessibility_state_expanded: fn(state: I64) -> Bool { ui_carrier_bool(ui_state_payload(state, UI_STATE_EXPANDED)) != I64{0} }
#Export(c) jet_rt_record_get_jet_ui_accessibility_state_checked: fn(state: I64) -> Bool { ui_carrier_bool(ui_state_payload(state, UI_STATE_CHECKED)) != I64{0} }
#Export(c) jet_rt_record_get_jet_ui_accessibility_state_selected: fn(state: I64) -> Bool { ui_carrier_bool(ui_state_payload(state, UI_STATE_SELECTED)) != I64{0} }
#Export(c) jet_rt_record_get_jet_ui_accessibility_state_value: fn(state: I64) -> I64 { jet_rt_string_clone(ui_carrier_word(ui_state_payload(state, UI_STATE_VALUE))) }
#Export(c) jet_rt_handle_clone_jet_ui_accessibility_state: fn(state: I64) -> I64 {
    result: jet_rt_alloc(UI_STATE_BYTES, I64{8})
    ui_state_copy(state, result)
    result
}
#Export(c) jet_rt_handle_drop_jet_ui_accessibility_state: fn(state: I64) {
    if (state == I64{0}) -> return
    ui_state_fields_drop(state)
    jet_rt_free(state, UI_STATE_BYTES, I64{8})
}
#Export(c) jet_rt_handle_eq_jet_ui_accessibility_state: fn(left: I64, right: I64) -> Bool { ui_state_eq(left, right) }
// The states sequence holds the states inline; `get` lends one, and `push`
// moves a boxed state's words in and frees its box.
#Export(c) jet_rt_record_seq_list_rec_jet_ui_accessibility_state_new: fn(capacity: I64) -> I64 { data_sequence_new(capacity, UI_STATE_BYTES) }
#Export(c) jet_rt_record_seq_list_rec_jet_ui_accessibility_state_len: fn(sequence: I64) -> I64 { ui_carrier_word(wrapping(sequence + DATA_SEQUENCE_LENGTH)) }
#Export(c) jet_rt_record_seq_list_rec_jet_ui_accessibility_state_get: fn(sequence: I64, index: I64) -> I64 { data_sequence_slot(sequence, index, UI_STATE_BYTES) }
#Export(c) jet_rt_record_seq_list_rec_jet_ui_accessibility_state_push: fn(sequence: I64, state: I64) {
    target: data_sequence_reserve(sequence, UI_STATE_BYTES)
    ui_carrier_store(target, ui_carrier_word(state))
    ui_carrier_store(wrapping(target + UI_STATE_PAYLOAD), ui_carrier_word(wrapping(state + UI_STATE_PAYLOAD)))
    jet_rt_free(state, UI_STATE_BYTES, I64{8})
    ui_carrier_store(wrapping(sequence + DATA_SEQUENCE_LENGTH), ui_carrier_word(wrapping(sequence + DATA_SEQUENCE_LENGTH)) + I64{1})
}

// UIAccessibility.
ui_accessibility_copy: fn(value: I64, result: I64) {
    ui_carrier_store(wrapping(result + UI_ACCESSIBILITY_NAME), ui_optional_text_clone(ui_carrier_word(wrapping(value + UI_ACCESSIBILITY_NAME))))
    ui_carrier_store(wrapping(result + UI_ACCESSIBILITY_DESCRIPTION), ui_optional_text_clone(ui_carrier_word(wrapping(value + UI_ACCESSIBILITY_DESCRIPTION))))
    length: ui_carrier_word(wrapping(value + UI_ACCESSIBILITY_LENGTH))
    source: ui_carrier_word(wrapping(value + UI_ACCESSIBILITY_DATA))
    data: if (length == I64{0}) -> I64{0} else -> jet_rt_alloc(length * UI_STATE_BYTES, I64{8})
    index := I64{0}
    loop index < length {
        ui_state_copy(wrapping(source + index * UI_STATE_BYTES), wrapping(data + index * UI_STATE_BYTES))
        index += I64{1}
    }
    ui_carrier_store(wrapping(result + UI_ACCESSIBILITY_LENGTH), length)
    ui_carrier_store(wrapping(result + UI_ACCESSIBILITY_CAPACITY), length)
    ui_carrier_store(wrapping(result + UI_ACCESSIBILITY_DATA), data)
}
// The constructor borrows its texts' Option boxes (null is None) and takes the
// states sequence, whose header words it adopts inline.
#Export(c) jet_rt_record_new_jet_ui_accessibility: fn(name: I64, description: I64, states: I64) -> I64 {
    result: jet_rt_alloc(UI_ACCESSIBILITY_BYTES, I64{8})
    ui_carrier_store(wrapping(result + UI_ACCESSIBILITY_NAME), if (name == I64{0}) -> I64{0} else -> jet_rt_string_clone(ui_carrier_word(name)))
    ui_carrier_store(wrapping(result + UI_ACCESSIBILITY_DESCRIPTION), if (description == I64{0}) -> I64{0} else -> jet_rt_string_clone(ui_carrier_word(description)))
    ui_carrier_store(wrapping(result + UI_ACCESSIBILITY_LENGTH), ui_carrier_word(wrapping(states + DATA_SEQUENCE_LENGTH)))
    ui_carrier_store(wrapping(result + UI_ACCESSIBILITY_CAPACITY), ui_carrier_word(wrapping(states + DATA_SEQUENCE_CAPACITY)))
    ui_carrier_store(wrapping(result + UI_ACCESSIBILITY_DATA), ui_carrier_word(wrapping(states + DATA_SEQUENCE_DATA)))
    jet_rt_free(states, DATA_SEQUENCE_BYTES, I64{8})
    result
}
#Export(c) jet_rt_record_get_jet_ui_accessibility_name: fn(value: I64, some: I64) -> I64 { ui_optional_text_get(ui_carrier_word(wrapping(value + UI_ACCESSIBILITY_NAME)), some) }
#Export(c) jet_rt_record_get_jet_ui_accessibility_description: fn(value: I64, some: I64) -> I64 { ui_optional_text_get(ui_carrier_word(wrapping(value + UI_ACCESSIBILITY_DESCRIPTION)), some) }
#Export(c) jet_rt_record_get_jet_ui_accessibility_states: fn(value: I64) -> I64 { wrapping(value + UI_ACCESSIBILITY_LENGTH) }
#Export(c) jet_rt_handle_clone_jet_ui_accessibility: fn(value: I64) -> I64 {
    result: jet_rt_alloc(UI_ACCESSIBILITY_BYTES, I64{8})
    ui_accessibility_copy(value, result)
    result
}
ui_accessibility_fields_drop: fn(value: I64) {
    ui_optional_text_drop(ui_carrier_word(wrapping(value + UI_ACCESSIBILITY_NAME)))
    ui_optional_text_drop(ui_carrier_word(wrapping(value + UI_ACCESSIBILITY_DESCRIPTION)))
    length: ui_carrier_word(wrapping(value + UI_ACCESSIBILITY_LENGTH))
    capacity: ui_carrier_word(wrapping(value + UI_ACCESSIBILITY_CAPACITY))
    data: ui_carrier_word(wrapping(value + UI_ACCESSIBILITY_DATA))
    index := I64{0}
    loop index < length {
        ui_state_fields_drop(wrapping(data + index * UI_STATE_BYTES))
        index += I64{1}
    }
    if (capacity != I64{0}) -> jet_rt_free(data, capacity * UI_STATE_BYTES, I64{8})
}
#Export(c) jet_rt_handle_drop_jet_ui_accessibility: fn(value: I64) {
    if (value == I64{0}) -> return
    ui_accessibility_fields_drop(value)
    jet_rt_free(value, UI_ACCESSIBILITY_BYTES, I64{8})
}
#Export(c) jet_rt_handle_eq_jet_ui_accessibility: fn(left: I64, right: I64) -> Bool {
    if !ui_optional_text_eq(ui_carrier_word(wrapping(left + UI_ACCESSIBILITY_NAME)), ui_carrier_word(wrapping(right + UI_ACCESSIBILITY_NAME))) -> return false
    if !ui_optional_text_eq(ui_carrier_word(wrapping(left + UI_ACCESSIBILITY_DESCRIPTION)), ui_carrier_word(wrapping(right + UI_ACCESSIBILITY_DESCRIPTION))) -> return false
    length: ui_carrier_word(wrapping(left + UI_ACCESSIBILITY_LENGTH))
    if (length != ui_carrier_word(wrapping(right + UI_ACCESSIBILITY_LENGTH))) -> return false
    left_data: ui_carrier_word(wrapping(left + UI_ACCESSIBILITY_DATA))
    right_data: ui_carrier_word(wrapping(right + UI_ACCESSIBILITY_DATA))
    index := I64{0}
    loop index < length {
        if !ui_state_eq(wrapping(left_data + index * UI_STATE_BYTES), wrapping(right_data + index * UI_STATE_BYTES)) -> return false
        index += I64{1}
    }
    true
}

// UIShortcutModifiers: its modifier bits (the low byte) as one word.
#Export(c) jet_rt_record_new_jet_ui_shortcut_modifiers: fn(bits: I64) -> I64 {
    raw: jet_int_owned_to_i64(bits)
    if (jet_scheduler_native_propagate() != I64{0}) -> return I64{0}
    result: jet_rt_alloc(UI_SHORTCUT_MODIFIERS_BYTES, I64{8})
    ui_carrier_store(result, raw.bit_and(I64{255}))
    result
}
#Export(c) jet_rt_record_get_jet_ui_shortcut_modifiers_bits: fn(value: I64) -> I64 { jet_int_owned_from_i64(ui_carrier_word(value)) }
#Export(c) jet_rt_handle_clone_jet_ui_shortcut_modifiers: fn(value: I64) -> I64 {
    result: jet_rt_alloc(UI_SHORTCUT_MODIFIERS_BYTES, I64{8})
    ui_carrier_store(result, ui_carrier_word(value))
    result
}
#Export(c) jet_rt_handle_drop_jet_ui_shortcut_modifiers: fn(value: I64) {
    if (value != I64{0}) -> jet_rt_free(value, UI_SHORTCUT_MODIFIERS_BYTES, I64{8})
}
#Export(c) jet_rt_handle_eq_jet_ui_shortcut_modifiers: fn(left: I64, right: I64) -> Bool { ui_carrier_word(left) == ui_carrier_word(right) }

// UIShortcut.
ui_shortcut_copy: fn(value: I64, result: I64) {
    ui_carrier_store(wrapping(result + UI_SHORTCUT_KEY), jet_rt_string_clone(ui_carrier_word(wrapping(value + UI_SHORTCUT_KEY))))
    ui_carrier_store(wrapping(result + UI_SHORTCUT_MODIFIERS), ui_carrier_word(wrapping(value + UI_SHORTCUT_MODIFIERS)).bit_and(I64{255}))
}
ui_shortcut_fields_drop: fn(value: I64) {
    jet_rt_string_drop(ui_carrier_word(wrapping(value + UI_SHORTCUT_KEY)))
}
// The constructor borrows the key and takes the modifiers record.
#Export(c) jet_rt_record_new_jet_ui_shortcut: fn(key: I64, modifiers: I64) -> I64 {
    result: jet_rt_alloc(UI_SHORTCUT_BYTES, I64{8})
    ui_carrier_store(wrapping(result + UI_SHORTCUT_KEY), jet_rt_string_clone(key))
    ui_carrier_store(wrapping(result + UI_SHORTCUT_MODIFIERS), ui_carrier_word(modifiers))
    jet_rt_handle_drop_jet_ui_shortcut_modifiers(modifiers)
    result
}
#Export(c) jet_rt_record_get_jet_ui_shortcut_key: fn(value: I64) -> I64 { jet_rt_string_clone(ui_carrier_word(wrapping(value + UI_SHORTCUT_KEY))) }
#Export(c) jet_rt_record_get_jet_ui_shortcut_modifiers: fn(value: I64) -> I64 {
    result: jet_rt_alloc(UI_SHORTCUT_MODIFIERS_BYTES, I64{8})
    ui_carrier_store(result, ui_carrier_word(wrapping(value + UI_SHORTCUT_MODIFIERS)).bit_and(I64{255}))
    result
}
#Export(c) jet_rt_handle_clone_jet_ui_shortcut: fn(value: I64) -> I64 {
    result: jet_rt_alloc(UI_SHORTCUT_BYTES, I64{8})
    ui_shortcut_copy(value, result)
    result
}
#Export(c) jet_rt_handle_drop_jet_ui_shortcut: fn(value: I64) {
    if (value == I64{0}) -> return
    ui_shortcut_fields_drop(value)
    jet_rt_free(value, UI_SHORTCUT_BYTES, I64{8})
}
#Export(c) jet_rt_handle_eq_jet_ui_shortcut: fn(left: I64, right: I64) -> Bool {
    jet_rt_string_eq(ui_carrier_word(wrapping(left + UI_SHORTCUT_KEY)), ui_carrier_word(wrapping(right + UI_SHORTCUT_KEY))) && (ui_carrier_word(wrapping(left + UI_SHORTCUT_MODIFIERS)).bit_and(I64{255})) == (ui_carrier_word(wrapping(right + UI_SHORTCUT_MODIFIERS)).bit_and(I64{255}))
}
