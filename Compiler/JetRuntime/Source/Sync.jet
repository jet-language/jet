// Linux x86-64 futex synchronization. All state words are aligned I64s;
// futex observes their low 32 bits, while the atomic leaves publish all 64.
// Mutex: 0 unlocked, 1 locked/uncontended, 2 locked/contended. Condvar: a
// wrapping sequence. ParkSlot: one consumable notification, one parker.
// A wait on a fiber (Fiber.jet) parks the fiber, not its carrier thread:
// sync_wait goes to the fiber parking lot and sync_wake wakes the lot's
// waiters on the word before the futex's; a plain thread waits on the futex.
// The fiber side is reached only through the hooks the lot records
// (Fiber.jet sync_lot), which exists once a fiber may run, so these
// primitives link no fiber or scheduler code into a program.
sync_load: fn(address: I64) -> I64 {
    #Unsafe("borrows an aligned live synchronization word") { return os_load_i64(address) }
}

sync_store: fn(address: I64, value: I64) {
    #Unsafe("publishes an aligned live synchronization word with x86 release ordering") {
        os_store_i64(address, value)
    }
}

sync_swap: fn(address: I64, value: I64) -> I64 {
    #Unsafe("atomic exchange on an aligned live synchronization word") {
        return os_swap_i64(address, value)
    }
}

sync_add: fn(address: I64, value: I64) -> I64 {
    #Unsafe("atomic fetch-add on an aligned live synchronization word") {
        return os_fetch_add_i64(address, value)
    }
}

sync_cas: fn(address: I64, expected: I64, desired: I64) -> I64 {
    #Unsafe("atomic compare-exchange on an aligned live synchronization word") {
        return os_cas_i64(address, expected, desired)
    }
}

sync_wake: fn(address: I64, count: I64) {
    lot: sync_lot
    remaining := count
    // The locked read orders it after the store this wake publishes.
    if (lot != I64{0} && sync_add(lot, I64{0}) != I64{0}) {
        remaining = remaining - coll_call3(sync_load(wrapping(lot + I64{16})), lot, address, count)
        if (remaining <= I64{0}) -> return
    }
    sync_futex_wake(address, remaining)
}

sync_futex_wake: fn(address: I64, count: I64) {
    #Unsafe("futex wake borrows a live aligned word and retains no pointer") {
        _ := os_syscall_i64(I64{202}, address, I64{129}, count, I64{0}, I64{0}, I64{0})
    }
}

// deadline_ns = -1 means unbounded. An absolute monotonic deadline survives
// EINTR, spurious wakes and sequence changes without extending the wait.
sync_wait: fn(address: I64, expected: I64, deadline_ns: I64) -> I64 {
    fiber: fiber_current()
    if (fiber != I64{0}) -> return coll_call4(sync_load(wrapping(sync_lot + I64{8})), fiber, address, expected, deadline_ns)
    sync_futex_wait(address, expected, deadline_ns)
}

// The futex wait itself: it blocks the calling OS thread, fiber or not.
sync_futex_wait: fn(address: I64, expected: I64, deadline_ns: I64) -> I64 {
    #Unsafe("futex borrows live state; timed wait uses this attached thread's reserved TCB scratch until the syscall returns") {
        if (deadline_ns < I64{0}) {
            return os_syscall_i64(I64{202}, address, I64{128}, expected, I64{0}, I64{0}, I64{0})
        }
        timeout: wrapping(os_tls_base_i64() + I64{216})
        os_store_i64(timeout, deadline_ns /% I64{1000000000})
        os_store_i64(wrapping(timeout + I64{8}), deadline_ns % I64{1000000000})
        return os_syscall_i64(I64{202}, address, I64{137}, expected, timeout, I64{0}, I64{4294967295})
    }
}

// The kernel's vDSO clock_gettime reads its time page in user space; a raw
// syscall 228 enters the kernel on every clock read. 0 until resolved, then
// the code address, or 1 for none (no vDSO image or symbol).
sync_vdso_clock := I64{0}

// musl's __vdsosym("__vdso_clock_gettime") over the vDSO image the kernel
// maps at AT_SYSINFO_EHDR: the first PT_LOAD gives the load bias, PT_DYNAMIC
// the DT_HASH, DT_SYMTAB and DT_STRTAB tables, and the symbol is a defined
// global or weak one of an untyped, object, function or common type. 1 when
// there is none.
sync_vdso_lookup: fn() -> I64 {
    image: host_getauxval(I64{33})
    if (image == I64{0}) -> return I64{1}
    headers: wrapping(image + sync_word(image, I64{32}))
    entry: net_load_uint(wrapping(image + I64{54}), I64{2})
    count: net_load_uint(wrapping(image + I64{56}), I64{2})
    bias := I64{0}
    loaded := false
    dynamic := I64{0}
    at := I64{0}
    loop at < count {
        header: wrapping(headers + at * entry)
        kind: net_load_uint(header, I64{4})
        if (kind == I64{1} && !loaded) {
            bias = wrapping(wrapping(image + sync_word(header, I64{8})) - sync_word(header, I64{16}))
            loaded = true
        } else if (kind == I64{2}) {
            dynamic = wrapping(image + sync_word(header, I64{8}))
        }
        at += I64{1}
    }
    if (!loaded || dynamic == I64{0}) -> return I64{1}
    hash := I64{0}
    strings := I64{0}
    symbols := I64{0}
    field := sync_word(dynamic, I64{0})
    loop field != (I64{0}) {
        value: wrapping(bias + sync_word(dynamic, I64{8}))
        if (field == I64{4}) -> hash = value
        if (field == I64{5}) -> strings = value
        if (field == I64{6}) -> symbols = value
        dynamic = wrapping(dynamic + I64{16})
        field = sync_word(dynamic, I64{0})
    }
    if (hash == I64{0} || strings == I64{0} || symbols == I64{0}) -> return I64{1}
    name: rt_static_text("__vdso_clock_gettime")
    total: net_load_uint(wrapping(hash + I64{4}), I64{4})
    at = I64{0}
    loop at < total {
        symbol: wrapping(symbols + at * I64{24})
        info: net_load_uint(wrapping(symbol + I64{4}), I64{1})
        typed: (I64{1} << info.bit_and(I64{15})).bit_and(I64{39}) != I64{0}
        bound: (I64{1} << (info >> I64{4})).bit_and(I64{1030}) != I64{0}
        defined: net_load_uint(wrapping(symbol + I64{6}), I64{2}) != I64{0}
        if (typed && bound && defined && sync_vdso_name(wrapping(strings + net_load_uint(symbol, I64{4})), name)) {
            return wrapping(bias + sync_word(symbol, I64{8}))
        }
        at += I64{1}
    }
    I64{1}
}

// One word of the vDSO image, which the kernel maps readable for the
// process lifetime.
sync_word: fn(base: I64, offset: I64) -> I64 {
    #Unsafe("base points into the kernel's vDSO image, mapped readable for the process lifetime") {
        return os_load_i64(wrapping(base + offset))
    }
}

// Whether the NUL-terminated symbol name at `text` is the static text `name`.
sync_vdso_name: fn(text: I64, name: I64) -> Bool {
    data: rt_text_word(name)
    length: rt_text_word(wrapping(name + I64{8}))
    at := I64{0}
    loop at < length {
        if (rt_text_byte(wrapping(text + at)) != rt_text_byte(wrapping(data + at))) -> return false
        at += I64{1}
    }
    rt_text_byte(wrapping(text + length)) == I64{0}
}

// Reads `clock` into the two words at `timespec` (seconds, nanoseconds), as
// musl's clock_gettime: the vDSO's call, then the system call unless the vDSO
// refused the clock (EINVAL).
sync_clock_read: fn(clock: I64, timespec: I64) {
    code := sync_vdso_clock
    if (code == I64{0}) {
        code = sync_vdso_lookup()
        #Unsafe("an idempotent install: every writer stores the same resolved address") { sync_vdso_clock = code }
    }
    status := I64{-38}
    if (code != I64{1}) {
        #Unsafe("the vDSO's clock_gettime(clockid_t, struct timespec *) writes the caller's two timespec words") {
            status = net_i32(os_call_address_two_i64(code, clock, timespec))
        }
    }
    if (status != I64{0} && status != I64{-22}) {
        #Unsafe("clock_gettime writes the caller's two timespec words") {
            status = os_syscall_i64(I64{228}, clock, timespec, I64{0}, I64{0}, I64{0}, I64{0})
        }
    }
    if (status != I64{0}) { jet_rt_unreachable(I64{0}, I64{0}) }
}

sync_now_ns: fn() -> I64 {
    #Unsafe("clock_gettime writes two words of thread-owned TCB scratch; no pointer escapes") {
        scratch: wrapping(os_tls_base_i64() + I64{232})
        sync_clock_read(I64{1}, scratch)
        return wrapping(os_load_i64(scratch) * I64{1000000000} + os_load_i64(wrapping(scratch + I64{8})))
    }
}

sync_deadline: fn(timeout_ns: I64) -> I64 {
    if (timeout_ns < I64{0}) { return I64{-1} }
    now: sync_now_ns()
    if (timeout_ns > I64{9223372036854775807} - now) { return I64{9223372036854775807} }
    now + timeout_ns
}

sync_mutex_lock: fn(address: I64) {
    if (sync_cas(address, I64{0}, I64{1}) == I64{0}) {
        return
    }
    loop {
        if (sync_swap(address, I64{2}) == I64{0}) {
            return
        }
        _ := sync_wait(address, I64{2}, I64{-1})
    }
}

sync_mutex_try_lock: fn(address: I64) -> Bool { sync_cas(address, I64{0}, I64{1}) == I64{0} }

sync_mutex_unlock: fn(address: I64) {
    if (sync_swap(address, I64{0}) == I64{2}) { sync_wake(address, I64{1}) }
}

// A lock whose waiters block their OS thread even on a fiber: the
// scheduler's own short critical sections (its root, the fiber timers, the
// lot buckets), which a fiber wake itself takes and which no holder parks in.
// Every carrier takes the root, and each section is a few loads and stores,
// so an acquirer spins briefly (test before each CAS, as alloc_lock does)
// before it sleeps on the futex.
sync_thread_lock: fn(address: I64) {
    if (sync_cas(address, I64{0}, I64{1}) == I64{0}) -> return
    spins := I64{0}
    loop spins < (I64{128}) {
        #Unsafe("x86 pause only hints that this thread is waiting in a spin loop") {
            os_spin_pause()
        }
        if (sync_load(address) == I64{0} && sync_cas(address, I64{0}, I64{1}) == I64{0}) -> return
        spins += I64{1}
    }
    loop {
        if (sync_swap(address, I64{2}) == I64{0}) -> return
        _ := sync_futex_wait(address, I64{2}, I64{-1})
    }
}

sync_thread_unlock: fn(address: I64) {
    if (sync_swap(address, I64{0}) == I64{2}) -> sync_futex_wake(address, I64{1})
}

// Sole-thread lock elision (#6444). A hot lock (stdout's, the stdin buffer's)
// costs two locked instructions, each a full fence draining the store buffer
// the copy before it filled. While only one thread can run Jet code, the lock
// word is set and cleared with plain stores instead: no other thread reads
// it, and a fault report on this thread still finds it held.
// sync_sole is 1 from process start until a second thread may run Jet code:
// thread_spawn and the raw clone clear it before the thread exists, and an
// attach (jet_rt_thread_attach, jet_rt_thread_bootstrap) from any thread but
// the process's main one clears it there, since a host thread may attach
// while the main thread is inside an elided section. sync_sole_inflight
// counts this thread's open elided sections; it is written before
// sync_sole is read (sync_sole_enter), and sync_sole_end, after clearing the
// flag, makes every thread's earlier stores visible with membarrier before it
// waits for the count to drain (an asymmetric Dekker fence: either the main
// thread read the cleared flag and locks for real, or its count is seen).
sync_sole := I64{1}
sync_sole_inflight := I64{0}

// true: the lock word was set with a plain store (an elided section); release
// it with sync_sole_exit(address, true). false: the mutex is held.
sync_sole_enter: fn(address: I64) -> Bool {
    #Unsafe("sync_sole_inflight is this sole thread's own count until sync_sole is cleared; sync_sole_end reads it only after a membarrier") {
        sync_sole_inflight = wrapping(sync_sole_inflight + I64{1})
        if (sync_sole != I64{0}) {
            os_store_i64(address, I64{1})
            return true
        }
        sync_sole_inflight = wrapping(sync_sole_inflight - I64{1})
    }
    sync_mutex_lock(address)
    false
}

sync_sole_exit: fn(address: I64, sole: Bool) {
    if !sole {
        sync_mutex_unlock(address)
        return
    }
    #Unsafe("an elided section: only this thread has written the lock word and the count since sync_sole_enter") {
        os_store_i64(address, I64{0})
        sync_sole_inflight = wrapping(sync_sole_inflight - I64{1})
    }
}

// Ends elision for good before a second thread runs Jet code. Each clearer
// stores 0, issues the barrier (MEMBARRIER_CMD_PRIVATE_EXPEDITED after its
// registration, else MEMBARRIER_CMD_GLOBAL) and yields until every elided
// section still open on the main thread has closed.
sync_sole_end: fn() {
    if (sync_sole == I64{0}) -> return
    #Unsafe("membarrier and sched_yield retain no memory; sync_sole only ever goes from 1 to 0") {
        sync_sole = I64{0}
        fenced := os_syscall_i64(I64{324}, I64{16}, I64{0}, I64{0}, I64{0}, I64{0}, I64{0}) == I64{0}
        if fenced { fenced = os_syscall_i64(I64{324}, I64{8}, I64{0}, I64{0}, I64{0}, I64{0}, I64{0}) == I64{0} }
        if !fenced { _ := os_syscall_i64(I64{324}, I64{1}, I64{0}, I64{0}, I64{0}, I64{0}, I64{0}) }
        loop {
            if (sync_sole_inflight == I64{0}) { break }
            _ := os_syscall_i64(I64{24}, I64{0}, I64{0}, I64{0}, I64{0}, I64{0}, I64{0})
        }
    }
}

// Caller holds mutex, checks its predicate in a loop, and keeps the same
// absolute deadline across repetitions. Mutex is held again on return.
sync_cond_wait: fn(sequence: I64, mutex: I64, deadline_ns: I64) -> Bool {
    before: sync_load(sequence)
    sync_mutex_unlock(mutex)
    result: sync_wait(sequence, before, deadline_ns)
    sync_mutex_lock(mutex)
    result != I64{-110}
}

sync_cond_notify_one: fn(sequence: I64) {
    _ := sync_add(sequence, I64{1})
    sync_wake(sequence, I64{1})
}

sync_cond_notify_all: fn(sequence: I64) {
    _ := sync_add(sequence, I64{1})
    sync_wake(sequence, I64{2147483647})
}

// ParkSlot32: state@0, reserved@8/@16, atomic references@24. state: 0 empty,
// 1 notified, 2 a thread waits on the futex, else the parked fiber (a
// 64-aligned header, so never 1 or 2 in its low 32 bits). There is exactly
// one parker; timer rows and waiter guards may retain it.
sync_park_new: fn() -> I64 {
    slot: jet_rt_alloc(I64{32}, I64{8})
    sync_store(slot, I64{0})
    sync_store(wrapping(slot + I64{8}), I64{0})
    sync_store(wrapping(slot + I64{16}), I64{0})
    sync_store(wrapping(slot + I64{24}), I64{1})
    slot
}

sync_park_retain: fn(slot: I64) { _ := sync_add(wrapping(slot + I64{24}), I64{1}) }
sync_park_drop: fn(slot: I64) {
    if (sync_add(wrapping(slot + I64{24}), I64{-1}) == I64{1}) -> jet_rt_free(slot, I64{32}, I64{8})
}

// Consumes a notification, waiting for one up to timeout_ns (-1 unbounded).
sync_park: fn(slot: I64, timeout_ns: I64) {
    if (sync_swap(slot, I64{0}) != I64{0}) -> return
    fiber: fiber_current()
    if (fiber != I64{0}) {
        _ := coll_call3(sync_load(wrapping(sync_lot + I64{24})), fiber, slot, timeout_ns)
        return
    }
    if (sync_cas(slot, I64{0}, I64{2}) != I64{0}) {
        _ := sync_swap(slot, I64{0})
        return
    }
    deadline: sync_deadline(timeout_ns)
    loop sync_load(slot) == (I64{2}) {
        if (deadline >= I64{0} && sync_now_ns() >= deadline) {
            if (sync_cas(slot, I64{2}, I64{0}) == I64{2}) -> return
            break
        }
        _ := sync_futex_wait(slot, I64{2}, deadline)
    }
    _ := sync_swap(slot, I64{0})
}

sync_park_wake: fn(slot: I64) {
    previous: sync_swap(slot, I64{1})
    if (previous == I64{2}) -> sync_futex_wake(slot, I64{1})
    if (previous > I64{2}) -> _ := coll_call1(sync_load(wrapping(sync_lot + I64{32})), previous)
}

// Once: 0 empty, 1 initializer running, 2 published. The initializer must not
// unwind across Jet frames. Recursive initialization is the caller's defect.
sync_once_enter: fn(state: I64) -> Bool {
    loop {
        old: sync_cas(state, I64{0}, I64{1})
        if (old == I64{0}) { return true }
        if (old == I64{2}) { return false }
        _ := sync_wait(state, I64{1}, I64{-1})
    }
}

sync_once_complete: fn(state: I64) {
    _ := sync_swap(state, I64{2})
    sync_wake(state, I64{2147483647})
}
