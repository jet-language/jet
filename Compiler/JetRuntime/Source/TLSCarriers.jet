// Native TLS data ownership, not a transport implementation. Frozen seed
// preregeneration-runtime.rs:106776-106791; CAbiRoutes.rs:11413-11453.
// Root24 is inline List24 [len,capacity,data]. Trust32=[tag,inline Root24].
// Byte buffers use the canonical host U8 stride, never a Rust Vec layout.
#Export(c) fn jet_rt_handle_clone_jet_tls_root_certificates(value: I64) -> I64 {
    result :: jet_rt_alloc(I64{24}, I64{8})
    data_u8_list_copy_into(value, result)
    result
}
#Export(c) fn jet_rt_handle_drop_jet_tls_root_certificates(value: I64) {
    if (value == I64{0}) -> return
    data_u8_list_drop_fields(value)
    jet_rt_free(value, I64{24}, I64{8})
}
#Export(c) fn jet_rt_record_new_jet_tls_root_certificates(pem: I64) -> I64 {
    result :: jet_rt_alloc(I64{24}, I64{8})
    coll_copy(pem, result, I64{24})
    jet_rt_free(pem, I64{24}, I64{8})
    result
}
// The field lends the parent's inline header; no independent owner is created.
#Export(c) fn jet_rt_record_get_jet_tls_root_certificates_pem(value: I64) -> I64 { value }
#Export(c) fn jet_rt_record_tag_jet_tls_trust(value: I64) -> I64 { rt_text_word(value) }
#Export(c) fn jet_rt_record_new_jet_tls_trust_system() -> I64 {
    result :: jet_rt_alloc(I64{32}, I64{8})
    coll_zero(result, I64{32})
    result
}
fn tls_trust_take(kind: I64, roots: I64) -> I64 {
    result :: jet_rt_alloc(I64{32}, I64{8})
    rt_text_store(result, kind)
    coll_copy(roots, result + I64{8}, I64{24})
    jet_rt_free(roots, I64{24}, I64{8})
    result
}
#Export(c) fn jet_rt_record_new_jet_tls_trust_system_plus(roots: I64) -> I64 { tls_trust_take(I64{1}, roots) }
#Export(c) fn jet_rt_record_new_jet_tls_trust_custom_only(roots: I64) -> I64 { tls_trust_take(I64{2}, roots) }
fn tls_trust_get(value: I64, kind: I64) -> I64 {
    if (rt_text_word(value) != kind) {
        rt_record_variant_panic()
        if (jet_scheduler_native_propagate() != I64{0}) -> return I64{0}
    }
    jet_rt_handle_clone_jet_tls_root_certificates(value + I64{8})
}
#Export(c) fn jet_rt_record_get_jet_tls_trust_system_plus(value: I64) -> I64 { tls_trust_get(value, I64{1}) }
#Export(c) fn jet_rt_record_get_jet_tls_trust_custom_only(value: I64) -> I64 { tls_trust_get(value, I64{2}) }
fn tls_trust_copy_into(source: I64, target: I64) {
    coll_zero(target, I64{32})
    kind :: rt_text_word(source)
    rt_text_store(target, kind)
    if (kind != I64{0}) -> data_u8_list_copy_into(source + I64{8}, target + I64{8})
}
fn tls_trust_drop_fields(value: I64) {
    if (rt_text_word(value) != I64{0}) -> data_u8_list_drop_fields(value + I64{8})
}
#Export(c) fn jet_rt_handle_clone_jet_tls_trust(value: I64) -> I64 {
    result :: jet_rt_alloc(I64{32}, I64{8})
    tls_trust_copy_into(value, result)
    result
}
#Export(c) fn jet_rt_handle_drop_jet_tls_trust(value: I64) {
    if (value == I64{0}) -> return
    tls_trust_drop_fields(value)
    jet_rt_free(value, I64{32}, I64{8})
}

// Frozen seed:106957-106974. Inline list/record fields give borrowed field
// projections their parent's lifetime without allocating temporary owners.
TLS_CERT_BYTES :: I64{128}
TLS_PEER_BYTES :: I64{176}
fn tls_cert_clone_into(source: I64, target: I64) {
    data_u8_list_copy_into(source, target)
    data_u8_list_copy_into(source + I64{24}, target + I64{24})
    data_u8_list_copy_into(source + I64{48}, target + I64{48})
    data_text_list_copy_into(source + I64{72}, target + I64{72})
    rt_text_store(target + I64{96}, rt_text_word(source + I64{96}))
    rt_text_store(target + I64{104}, rt_text_word(source + I64{104}))
    rt_text_store(target + I64{112}, jet_rt_string_clone(rt_text_word(source + I64{112})))
    rt_text_store(target + I64{120}, jet_rt_string_clone(rt_text_word(source + I64{120})))
}
fn tls_cert_drop_fields(value: I64) {
    data_u8_list_drop_fields(value)
    data_u8_list_drop_fields(value + I64{24})
    data_u8_list_drop_fields(value + I64{48})
    coll_text_list_drop(value + I64{72}, true)
    jet_rt_string_drop(rt_text_word(value + I64{112}))
    jet_rt_string_drop(rt_text_word(value + I64{120}))
}
#Export(c) fn jet_rt_handle_clone_jet_tls_certificate(value: I64) -> I64 {
    result :: jet_rt_alloc(TLS_CERT_BYTES, I64{8})
    tls_cert_clone_into(value, result)
    result
}
#Export(c) fn jet_rt_handle_drop_jet_tls_certificate(value: I64) {
    if (value == I64{0}) -> return
    tls_cert_drop_fields(value)
    jet_rt_free(value, TLS_CERT_BYTES, I64{8})
}
// CAbiRoutes.rs:12982-13014 lends Text through caller-owned E4 out headers.
// These descriptors MUST NOT be dropped/grown/taken as owned text.
fn tls_borrow_text_out(value: I64, offset: I64, output: I64) {
    coll_copy(rt_text_word(value + offset), output, I64{24})
}
#Export(c) fn jet_rt_handle_field_jet_tls_certificate_subject(value: I64, output: I64) { tls_borrow_text_out(value, I64{112}, output) }
#Export(c) fn jet_rt_handle_field_jet_tls_certificate_issuer(value: I64, output: I64) { tls_borrow_text_out(value, I64{120}, output) }

// CAbiRoutes.rs:8431-8440: capacities/indices are raw C i64, not exact Int.
#Export(c) fn jet_rt_record_seq_list_rec_jet_tls_certificate_new(capacity: I64) -> I64 { data_sequence_new(capacity, TLS_CERT_BYTES) }
#Export(c) fn jet_rt_record_seq_list_rec_jet_tls_certificate_len(value: I64) -> I64 { rt_text_word(value) }
#Export(c) fn jet_rt_record_seq_list_rec_jet_tls_certificate_get(value: I64, index: I64) -> I64 { data_sequence_slot(value, index, TLS_CERT_BYTES) }
#Export(c) fn jet_rt_record_seq_list_rec_jet_tls_certificate_push(value: I64, item: I64) {
    target :: data_sequence_reserve(value, TLS_CERT_BYTES)
    coll_copy(item, target, TLS_CERT_BYTES)
    jet_rt_free(item, TLS_CERT_BYTES, I64{8})
    rt_text_store(value, rt_text_word(value) + I64{1})
}
fn tls_cert_list_copy_into(source: I64, target: I64) {
    length :: rt_text_word(source)
    data :: if (length == I64{0}) -> I64{0} else -> jet_rt_alloc(length * TLS_CERT_BYTES, I64{8})
    rt_text_store(target, length)
    rt_text_store(target + I64{8}, length)
    rt_text_store(target + I64{16}, data)
    original :: rt_text_word(source + I64{16})
    at := I64{0}
    loop at < length {
        tls_cert_clone_into(original + at * TLS_CERT_BYTES, data + at * TLS_CERT_BYTES)
        at += I64{1}
    }
}
fn tls_cert_list_drop_fields(value: I64) {
    data :: rt_text_word(value + I64{16})
    length :: rt_text_word(value)
    at := I64{0}
    loop at < length {
        tls_cert_drop_fields(data + at * TLS_CERT_BYTES)
        at += I64{1}
    }
    capacity :: rt_text_word(value + I64{8})
    if (capacity != I64{0}) -> jet_rt_free(data, capacity * TLS_CERT_BYTES, I64{8})
}
#Export(c) fn jet_rt_handle_clone_jet_tls_peer_identity(value: I64) -> I64 {
    result :: jet_rt_alloc(TLS_PEER_BYTES, I64{8})
    rt_text_store(result, jet_rt_string_clone(rt_text_word(value)))
    tls_cert_clone_into(value + I64{8}, result + I64{8})
    tls_cert_list_copy_into(value + I64{136}, result + I64{136})
    rt_text_store(result + I64{160}, jet_rt_string_clone(rt_text_word(value + I64{160})))
    rt_text_store(result + I64{168}, rt_text_word(value + I64{168}))
    result
