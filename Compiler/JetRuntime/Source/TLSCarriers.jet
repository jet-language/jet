#Export(c) fn jet_rt_handle_drop_jet_tls_peer_identity(value: I64) {
    if (value == I64{0}) -> return
    jet_rt_string_drop(rt_text_word(value))
    tls_cert_drop_fields(value + I64{8})
    tls_cert_list_drop_fields(value + I64{136})
    jet_rt_string_drop(rt_text_word(value + I64{160}))
    jet_rt_free(value, TLS_PEER_BYTES, I64{8})
