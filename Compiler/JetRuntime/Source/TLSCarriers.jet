    at := I64{0}
    loop at < length {
        host_u8_put(data, at, host_u8_get(original, at))
        at += I64{1}
    }
}
fn tls_u8_list_drop_buffer(value: I64) {
    capacity :: rt_text_word(value + I64{8})
    if (capacity != I64{0}) -> jet_rt_free(rt_text_word(value + I64{16}), capacity * RT_HOST_U8_STRIDE, I64{8})
