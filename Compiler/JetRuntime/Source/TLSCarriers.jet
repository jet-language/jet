#Export(c) fn jet_rt_handle_field_jet_tls_peer_identity_verified_server_name(value: I64, output: I64) { tls_borrow_text_out(value, I64{0}, output) }
#Export(c) fn jet_rt_handle_field_jet_tls_peer_identity_leaf(value: I64) -> I64 { value + I64{8} }
#Export(c) fn jet_rt_handle_field_jet_tls_peer_identity_cipher_suite(value: I64, output: I64) { tls_borrow_text_out(value, I64{160}, output) }

