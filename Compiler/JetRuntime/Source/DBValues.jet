// DBPluginWire.rs:25-61,149-170; frozen seed:73753-73786,73877-73898.
// DBValue32=[tag,active union24]. Blob is inline List24 at8; numeric values
// are Rust raw i64 / IEEE f64, never a Rust enum or Jet exact-Int field.
// DBError8 owns one E4 pointer. No DBValue variant recursively owns DBValue.
fn db_value_new(kind: I64) -> I64 {
    result :: jet_rt_alloc(I64{32}, I64{8})
    coll_zero(result, I64{32})
    rt_text_store(result, kind)
    result
}
fn db_value_payload(value: I64, kind: I64) -> I64 {
    if (rt_text_word(value) != kind) -> rt_record_variant_panic()
    rt_text_word(value + I64{8})
}
#Export(c) fn jet_rt_record_tag_db_value(value: I64) -> I64 { rt_text_word(value) }
#Export(c) fn jet_rt_record_new_db_value_null() -> I64 { db_value_new(I64{0}) }
#Export(c) fn jet_rt_record_new_db_value_int(payload: I64) -> I64 {
    native :: jet_int_owned_to_i64(payload)
    result :: db_value_new(I64{1})
    rt_text_store(result + I64{8}, native)
    result
}
#Export(c) fn jet_rt_record_get_db_value_int(value: I64) -> I64 { jet_int_owned_from_i64(db_value_payload(value, I64{1})) }
#Export(c) fn jet_rt_record_new_db_value_float(payload: Float) -> I64 {
    result :: db_value_new(I64{2})
    rt_text_store(result + I64{8}, rt_f64_bits(payload))
    result
}
#Export(c) fn jet_rt_record_get_db_value_float(value: I64) -> Float { rt_f64_from_bits(db_value_payload(value, I64{2})) }
#Export(c) fn jet_rt_record_new_db_value_text(payload: I64) -> I64 {
    result :: db_value_new(I64{3})
    rt_text_store(result + I64{8}, jet_rt_string_clone(payload))
    result
}
#Export(c) fn jet_rt_record_get_db_value_text(value: I64) -> I64 { jet_rt_string_clone(db_value_payload(value, I64{3})) }
#Export(c) fn jet_rt_record_new_db_value_bool(payload: U8) -> I64 {
    result :: db_value_new(I64{4})
    rt_text_store(result + I64{8}, if (payload != U8{0}) -> I64{1} else -> I64{0})
    result
}
#Export(c) fn jet_rt_record_get_db_value_bool(value: I64) -> Bool { (db_value_payload(value, I64{4}).bit_and(I64{255})) != I64{0} }
#Export(c) fn jet_rt_record_new_db_value_blob(payload: I64) -> I64 {
    result :: db_value_new(I64{5})
    coll_copy(payload, result + I64{8}, I64{24})
    jet_rt_free(payload, I64{24}, I64{8})
    result
}
#Export(c) fn jet_rt_record_get_db_value_blob(value: I64) -> I64 {
    if (rt_text_word(value) != I64{5}) -> rt_record_variant_panic()
    value + I64{8}
}
#Export(c) fn jet_rt_handle_clone_db_value(value: I64) -> I64 {
    kind :: rt_text_word(value)
    result :: db_value_new(kind)
    if (kind == I64{5}) {
        data_u8_list_copy_into(value + I64{8}, result + I64{8})
    } else {
        word := rt_text_word(value + I64{8})
        if (kind == I64{3}) -> word = jet_rt_string_clone(word)
        if (kind == I64{4}) -> word = if ((word.bit_and(I64{255})) != I64{0}) -> I64{1} else -> I64{0}
        if (kind != I64{0}) -> rt_text_store(result + I64{8}, word)
    }
    result
}
#Export(c) fn jet_rt_handle_drop_db_value(value: I64) {
    if (value == I64{0}) -> return
    kind :: rt_text_word(value)
    if (kind == I64{3}) -> jet_rt_string_drop(rt_text_word(value + I64{8}))
    if (kind == I64{5}) -> data_u8_list_drop_fields(value + I64{8})
    jet_rt_free(value, I64{32}, I64{8})
}
#Export(c) fn jet_rt_handle_eq_db_value(left: I64, right: I64) -> Bool {
    kind :: rt_text_word(left)
    if (kind != rt_text_word(right)) -> return false
    if (kind == I64{0}) -> return true
    a :: rt_text_word(left + I64{8})
    b :: rt_text_word(right + I64{8})
    if (kind == I64{1}) -> return a == b
    if (kind == I64{2}) -> return rt_f64_from_bits(a) == rt_f64_from_bits(b)
    if (kind == I64{3}) -> return jet_rt_string_compare(a, b) == I64{0}
    if (kind == I64{4}) -> return ((a.bit_and(I64{255})) != I64{0}) == ((b.bit_and(I64{255})) != I64{0})
    if (a != b) -> return false
    left_data :: rt_text_word(left + I64{24})
    right_data :: rt_text_word(right + I64{24})
    at := I64{0}
    loop at < a {
        if (host_u8_get(left_data, at) != host_u8_get(right_data, at)) -> return false
        at += I64{1}
    }
    true
}
#Export(c) fn jet_rt_handle_show_db_value(value: I64) -> I64 {
    kind :: rt_text_word(value)
    if (kind == I64{0}) -> return display_literal(I64{1819047278}, I64{4})
    if (kind == I64{1}) -> return jet_rt_i64_to_string(rt_text_word(value + I64{8}))
    // eb41b09af's existing shared core: Rust f64 Display, not Jet Float Debug.
    if (kind == I64{2}) -> return display_float(rt_f64_from_bits(rt_text_word(value + I64{8})), false)
    if (kind == I64{3}) -> return jet_rt_string_clone(rt_text_word(value + I64{8}))
    if (kind == I64{4}) -> return if ((rt_text_word(value + I64{8}).bit_and(I64{255})) != I64{0}) -> display_literal(I64{1702195828}, I64{4}) else -> display_literal(I64{435728179558}, I64{5})
    result :: jet_rt_string_builder_new()
    rt_text_push_word(result, I64{91}, I64{1})
    length :: rt_text_word(value + I64{8})
    data :: rt_text_word(value + I64{24})
    at := I64{0}
    loop at < length {
        if (at != I64{0}) -> rt_text_push_word(result, I64{8236}, I64{2}) // ", "
        rt_text_push_number(result, host_u8_get(data, at))
        at += I64{1}
    }
    rt_text_push_word(result, I64{93}, I64{1})
    jet_rt_string_builder_finish(result)
}
#Export(c) fn jet_rt_handle_display_db_value(value: I64) -> I64 { jet_rt_handle_show_db_value(value) }
#Export(c) fn jet_rt_record_new_db_error(message: I64) -> I64 {
    result :: jet_rt_alloc(I64{8}, I64{8})
    rt_text_store(result, jet_rt_string_clone(message))
    result
}
#Export(c) fn jet_rt_handle_clone_db_error(value: I64) -> I64 { jet_rt_record_new_db_error(rt_text_word(value)) }
#Export(c) fn jet_rt_handle_drop_db_error(value: I64) {
    if (value == I64{0}) -> return
    jet_rt_string_drop(rt_text_word(value))
    jet_rt_free(value, I64{8}, I64{8})
}
#Export(c) fn jet_rt_handle_eq_db_error(left: I64, right: I64) -> Bool { jet_rt_string_compare(rt_text_word(left), rt_text_word(right)) == I64{0} }
#Export(c) fn jet_rt_record_get_db_error_message(value: I64) -> I64 { jet_rt_string_clone(rt_text_word(value)) }
#Export(c) fn jet_rt_handle_show_db_error(value: I64) -> I64 { jet_rt_record_get_db_error_message(value) }
#Export(c) fn jet_rt_handle_display_db_error(value: I64) -> I64 { jet_rt_record_get_db_error_message(value) }
#Export(c) fn jet_rt_handle_debug_db_error(value: I64) -> I64 { jet_rt_record_get_db_error_message(value) }
