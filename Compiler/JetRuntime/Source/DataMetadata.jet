// Native mirrors of Core/Data/Data.jet:29,164-187; not source-module registrations.
// The Rust original owns field order. DataABI owns the private offsets. Text fields
// own E4 headers; nested records and text lists own deep carriers.
#Export(c) jet_rt_handle_clone_data_format: fn(value: I64) -> I64 { encoding_enum_clone(value) }
#Export(c) jet_rt_handle_drop_data_format: fn(value: I64) { encoding_enum_drop(value) }
#Export(c) jet_rt_handle_eq_data_format: fn(a: I64, b: I64) -> Bool { encoding_enum_eq(a, b) }
#Export(c) jet_rt_handle_clone_data_loader_kind: fn(value: I64) -> I64 { encoding_enum_clone(value) }
#Export(c) jet_rt_handle_drop_data_loader_kind: fn(value: I64) { encoding_enum_drop(value) }
#Export(c) jet_rt_handle_eq_data_loader_kind: fn(a: I64, b: I64) -> Bool { encoding_enum_eq(a, b) }
data_metadata_format: fn(target: I64, ordinal: I64) {
    if {
        (ordinal == I64{0}) -> rt_text_push_word(target, I64{7762787}, I64{3})
        (ordinal == I64{1}) -> rt_text_push_word(target, I64{1852797802}, I64{4})
        (ordinal == I64{2}) -> rt_text_push_word(target, I64{465709265770}, I64{5})
        (ordinal == I64{3}) -> rt_text_push_word(target, I64{32762652387336560}, I64{7})
        (ordinal == I64{4}) -> rt_text_push_word(target, I64{512970879585}, I64{5})
        else -> trap_native_index_range_stop()
    }
}
#Export(c) jet_rt_handle_show_data_format: fn(value: I64) -> I64 {
    result: jet_rt_string_builder_new()
    data_metadata_format(result, encoding_word(value))
    jet_rt_string_builder_finish(result)
}
#Export(c) jet_rt_handle_show_data_loader_kind: fn(value: I64) -> I64 {
    result: jet_rt_string_builder_new()
    data_metadata_kind(result, encoding_word(value))
    jet_rt_string_builder_finish(result)
}
data_metadata_kind: fn(target: I64, ordinal: I64) {
    if {
        (ordinal == I64{0}) -> rt_text_push_word(target, I64{1701603654}, I64{4})
        (ordinal == I64{1}) -> rt_text_push_word(target, I64{5001813}, I64{3})
        (ordinal == I64{2}) -> rt_text_push_word(target, I64{7310293695322153284}, I64{8})
        (ordinal == I64{3}) -> rt_text_push_word(target, I64{435761733974}, I64{5})
        else -> trap_native_index_range_stop()
    }
}
#Export(c) jet_rt_record_new_data_authority: fn(scope: I64, revision: I64) -> I64 {
    result: jet_rt_alloc(DATA_AUTHORITY_BYTES, I64{8})
    encoding_store(wrapping(result + DATA_AUTHORITY_SCOPE), jet_rt_string_clone(scope))
    encoding_store(wrapping(result + DATA_AUTHORITY_REVISION), jet_rt_string_clone(revision))
    result
}
#Export(c) jet_rt_handle_clone_data_authority: fn(value: I64) -> I64 {
    jet_rt_record_new_data_authority(encoding_word(wrapping(value + DATA_AUTHORITY_SCOPE)), encoding_word(wrapping(value + DATA_AUTHORITY_REVISION)))
}
#Export(c) jet_rt_handle_drop_data_authority: fn(value: I64) {
    if (value == I64{0}) -> return
    jet_rt_string_drop(encoding_word(wrapping(value + DATA_AUTHORITY_SCOPE)))
    jet_rt_string_drop(encoding_word(wrapping(value + DATA_AUTHORITY_REVISION)))
    jet_rt_free(value, DATA_AUTHORITY_BYTES, I64{8})
}
#Export(c) jet_rt_handle_eq_data_authority: fn(a: I64, b: I64) -> Bool {
    jet_rt_string_eq(encoding_word(wrapping(a + DATA_AUTHORITY_SCOPE)), encoding_word(wrapping(b + DATA_AUTHORITY_SCOPE))) && jet_rt_string_eq(encoding_word(wrapping(a + DATA_AUTHORITY_REVISION)), encoding_word(wrapping(b + DATA_AUTHORITY_REVISION)))
}
#Export(c) jet_rt_record_get_data_authority_scope: fn(value: I64) -> I64 { jet_rt_string_clone(encoding_word(wrapping(value + DATA_AUTHORITY_SCOPE))) }
#Export(c) jet_rt_record_get_data_authority_revision: fn(value: I64) -> I64 { jet_rt_string_clone(encoding_word(wrapping(value + DATA_AUTHORITY_REVISION))) }
#Export(c) jet_rt_handle_clone_data_source_identity: fn(value: I64) -> I64 {
    result: jet_rt_alloc(DATA_SOURCE_BYTES, I64{8})
    encoding_store(wrapping(result + DATA_SOURCE_KIND), encoding_word(wrapping(value + DATA_SOURCE_KIND)))
    encoding_store(wrapping(result + DATA_SOURCE_LOCATOR), jet_rt_string_clone(encoding_word(wrapping(value + DATA_SOURCE_LOCATOR))))
    encoding_store(wrapping(result + DATA_SOURCE_MEMBER), jet_rt_string_clone(encoding_word(wrapping(value + DATA_SOURCE_MEMBER))))
    encoding_store(wrapping(result + DATA_SOURCE_PARAMETERS), process_text_list_clone(encoding_word(wrapping(value + DATA_SOURCE_PARAMETERS)), false))
    result
}
#Export(c) jet_rt_handle_drop_data_source_identity: fn(value: I64) {
    if (value == I64{0}) -> return
    jet_rt_string_drop(encoding_word(wrapping(value + DATA_SOURCE_LOCATOR)))
    jet_rt_string_drop(encoding_word(wrapping(value + DATA_SOURCE_MEMBER)))
    process_text_list_drop(encoding_word(wrapping(value + DATA_SOURCE_PARAMETERS)), false)
    jet_rt_free(value, DATA_SOURCE_BYTES, I64{8})
}
#Export(c) jet_rt_handle_eq_data_source_identity: fn(a: I64, b: I64) -> Bool {
    encoding_word(wrapping(a + DATA_SOURCE_KIND)) == encoding_word(wrapping(b + DATA_SOURCE_KIND))
        && jet_rt_string_eq(encoding_word(wrapping(a + DATA_SOURCE_LOCATOR)), encoding_word(wrapping(b + DATA_SOURCE_LOCATOR)))
        && jet_rt_string_eq(encoding_word(wrapping(a + DATA_SOURCE_MEMBER)), encoding_word(wrapping(b + DATA_SOURCE_MEMBER)))
        && process_text_list_eq(encoding_word(wrapping(a + DATA_SOURCE_PARAMETERS)), encoding_word(wrapping(b + DATA_SOURCE_PARAMETERS)), false)
}
// Out receives a read-only view (data, len, cap) with no owner word of its own:
// a caller copies the bytes to own the text, never clones or drops the view.
#Export(c) jet_rt_handle_field_data_source_identity_locator: fn(value: I64, out: I64) { coll_copy(encoding_word(wrapping(value + DATA_SOURCE_LOCATOR)), out, I64{24}) }
#Export(c) jet_rt_handle_field_data_source_identity_member: fn(value: I64, out: I64) { coll_copy(encoding_word(wrapping(value + DATA_SOURCE_MEMBER)), out, I64{24}) }
#Export(c) jet_rt_handle_clone_data_provenance: fn(value: I64) -> I64 {
    result: jet_rt_alloc(DATA_PROVENANCE_BYTES, I64{8})
    encoding_store(wrapping(result + DATA_PROVENANCE_SOURCE), jet_rt_handle_clone_data_source_identity(encoding_word(wrapping(value + DATA_PROVENANCE_SOURCE))))
    encoding_store(wrapping(result + DATA_PROVENANCE_FORMAT), encoding_word(wrapping(value + DATA_PROVENANCE_FORMAT)))
    encoding_store(wrapping(result + DATA_PROVENANCE_AUTHORITY), jet_rt_handle_clone_data_authority(encoding_word(wrapping(value + DATA_PROVENANCE_AUTHORITY))))
    result
}
#Export(c) jet_rt_handle_drop_data_provenance: fn(value: I64) {
    if (value == I64{0}) -> return
    jet_rt_handle_drop_data_source_identity(encoding_word(wrapping(value + DATA_PROVENANCE_SOURCE)))
    jet_rt_handle_drop_data_authority(encoding_word(wrapping(value + DATA_PROVENANCE_AUTHORITY)))
    jet_rt_free(value, DATA_PROVENANCE_BYTES, I64{8})
}
#Export(c) jet_rt_handle_eq_data_provenance: fn(a: I64, b: I64) -> Bool {
    jet_rt_handle_eq_data_source_identity(encoding_word(wrapping(a + DATA_PROVENANCE_SOURCE)), encoding_word(wrapping(b + DATA_PROVENANCE_SOURCE)))
        && encoding_word(wrapping(a + DATA_PROVENANCE_FORMAT)) == encoding_word(wrapping(b + DATA_PROVENANCE_FORMAT))
        && jet_rt_handle_eq_data_authority(encoding_word(wrapping(a + DATA_PROVENANCE_AUTHORITY)), encoding_word(wrapping(b + DATA_PROVENANCE_AUTHORITY)))
}
#Export(c) jet_rt_handle_field_data_provenance_source: fn(value: I64) -> I64 { encoding_word(wrapping(value + DATA_PROVENANCE_SOURCE)) }
#Export(c) jet_rt_handle_field_data_provenance_authority: fn(value: I64) -> I64 { encoding_word(wrapping(value + DATA_PROVENANCE_AUTHORITY)) }
#Export(c) jet_rt_record_new_data_snapshot_identity: fn(id: I64, source: I64, content: I64, schema: I64, format: I64) -> I64 {
    if (format < I64{0} || format > I64{4}) -> trap_native_index_range_stop()
    result: jet_rt_alloc(DATA_SNAPSHOT_BYTES, I64{8})
    encoding_store(wrapping(result + DATA_SNAPSHOT_ID), jet_rt_string_clone(id))
    encoding_store(wrapping(result + DATA_SNAPSHOT_SOURCE), jet_rt_string_clone(source))
    encoding_store(wrapping(result + DATA_SNAPSHOT_CONTENT), jet_rt_string_clone(content))
    encoding_store(wrapping(result + DATA_SNAPSHOT_SCHEMA), jet_rt_string_clone(schema))
    encoding_store(wrapping(result + DATA_SNAPSHOT_FORMAT), format)
    result
}
#Export(c) jet_rt_handle_clone_data_snapshot_identity: fn(value: I64) -> I64 {
    jet_rt_record_new_data_snapshot_identity(encoding_word(wrapping(value + DATA_SNAPSHOT_ID)), encoding_word(wrapping(value + DATA_SNAPSHOT_SOURCE)), encoding_word(wrapping(value + DATA_SNAPSHOT_CONTENT)), encoding_word(wrapping(value + DATA_SNAPSHOT_SCHEMA)), encoding_word(wrapping(value + DATA_SNAPSHOT_FORMAT)))
}
#Export(c) jet_rt_handle_drop_data_snapshot_identity: fn(value: I64) {
    if (value == I64{0}) -> return
    jet_rt_string_drop(encoding_word(wrapping(value + DATA_SNAPSHOT_ID)))
    jet_rt_string_drop(encoding_word(wrapping(value + DATA_SNAPSHOT_SOURCE)))
    jet_rt_string_drop(encoding_word(wrapping(value + DATA_SNAPSHOT_CONTENT)))
    jet_rt_string_drop(encoding_word(wrapping(value + DATA_SNAPSHOT_SCHEMA)))
    jet_rt_free(value, DATA_SNAPSHOT_BYTES, I64{8})
}
#Export(c) jet_rt_handle_eq_data_snapshot_identity: fn(a: I64, b: I64) -> Bool {
    jet_rt_string_eq(encoding_word(wrapping(a + DATA_SNAPSHOT_ID)), encoding_word(wrapping(b + DATA_SNAPSHOT_ID)))
        && jet_rt_string_eq(encoding_word(wrapping(a + DATA_SNAPSHOT_SOURCE)), encoding_word(wrapping(b + DATA_SNAPSHOT_SOURCE)))
        && jet_rt_string_eq(encoding_word(wrapping(a + DATA_SNAPSHOT_CONTENT)), encoding_word(wrapping(b + DATA_SNAPSHOT_CONTENT)))
        && jet_rt_string_eq(encoding_word(wrapping(a + DATA_SNAPSHOT_SCHEMA)), encoding_word(wrapping(b + DATA_SNAPSHOT_SCHEMA)))
        && encoding_word(wrapping(a + DATA_SNAPSHOT_FORMAT)) == encoding_word(wrapping(b + DATA_SNAPSHOT_FORMAT))
}
#Export(c) jet_rt_record_get_data_snapshot_identity_id: fn(value: I64) -> I64 { jet_rt_string_clone(encoding_word(wrapping(value + DATA_SNAPSHOT_ID))) }
#Export(c) jet_rt_record_get_data_snapshot_identity_source: fn(value: I64) -> I64 { jet_rt_string_clone(encoding_word(wrapping(value + DATA_SNAPSHOT_SOURCE))) }
#Export(c) jet_rt_record_get_data_snapshot_identity_content: fn(value: I64) -> I64 { jet_rt_string_clone(encoding_word(wrapping(value + DATA_SNAPSHOT_CONTENT))) }
#Export(c) jet_rt_record_get_data_snapshot_identity_schema: fn(value: I64) -> I64 { jet_rt_string_clone(encoding_word(wrapping(value + DATA_SNAPSHOT_SCHEMA))) }
#Export(c) jet_rt_record_get_data_snapshot_identity_format: fn(value: I64) -> I64 { encoding_word(wrapping(value + DATA_SNAPSHOT_FORMAT)) }
#Export(c) jet_rt_handle_show_data_snapshot_identity: fn(value: I64) -> I64 {
    result: jet_rt_string_builder_new()
    jet_rt_string_builder_push(result, rt_static_text("SnapshotIdentity {{ id: "))
    jet_rt_string_builder_push(result, encoding_word(wrapping(value + DATA_SNAPSHOT_ID)))
    rt_text_push_word(result, I64{7305808869231632428}, I64{8})
    rt_text_push_word(result, I64{8250}, I64{2})
    jet_rt_string_builder_push(result, encoding_word(wrapping(value + DATA_SNAPSHOT_SOURCE)))
    rt_text_push_word(result, I64{7954892334483841068}, I64{8})
    rt_text_push_word(result, I64{2112116}, I64{3})
    jet_rt_string_builder_push(result, encoding_word(wrapping(value + DATA_SNAPSHOT_CONTENT)))
    rt_text_push_word(result, I64{7020378893159964716}, I64{8})
    rt_text_push_word(result, I64{8250}, I64{2})
    jet_rt_string_builder_push(result, encoding_word(wrapping(value + DATA_SNAPSHOT_SCHEMA)))
    rt_text_push_word(result, I64{8386104319403237420}, I64{8})
    rt_text_push_word(result, I64{8250}, I64{2})
    data_metadata_format(result, encoding_word(wrapping(value + DATA_SNAPSHOT_FORMAT)))
    rt_text_push_word(result, I64{32032}, I64{2})
    jet_rt_string_builder_finish(result)
}
#Export(c) jet_rt_handle_show_data_authority: fn(value: I64) -> I64 {
    result: jet_rt_string_builder_new()
    data_public_authority_part(result, encoding_word(wrapping(value + DATA_AUTHORITY_SCOPE)))
    revision: encoding_word(wrapping(value + DATA_AUTHORITY_REVISION))
    if (rt_text_len(revision) != I64{0}) {
        rt_text_push_scalar(result, I64{64})
        data_public_authority_part(result, revision)
    }
    jet_rt_string_builder_finish(result)
}
#Export(c) jet_rt_handle_show_data_source_identity: fn(value: I64) -> I64 {
    result: jet_rt_string_builder_new()
    data_metadata_kind(result, encoding_word(wrapping(value + DATA_SOURCE_KIND)))
    rt_text_push_scalar(result, I64{58})
    data_public_locator(result, encoding_word(wrapping(value + DATA_SOURCE_LOCATOR)))
    member: encoding_word(wrapping(value + DATA_SOURCE_MEMBER))
    if (rt_text_len(member) != I64{0}) {
        rt_text_push_scalar(result, I64{35})
        data_public_bounded(result, rt_text_data(member), rt_text_len(member))
    }
    parameters: encoding_word(wrapping(value + DATA_SOURCE_PARAMETERS))
    length: encoding_word(wrapping(parameters + DATA_SEQUENCE_LENGTH))
    data: encoding_word(wrapping(parameters + DATA_SEQUENCE_DATA))
    at := I64{0}
    loop at < length {
        rt_text_push_scalar(result, if (at == I64{0}) -> I64{63} else -> I64{38})
        parameter: encoding_word(wrapping(data + at * DYN_ELEMENT_BYTES))
        data_public_parameter(result, rt_text_data(parameter), rt_text_len(parameter))
        at += I64{1}
    }
    jet_rt_string_builder_finish(result)
}
