// CommonTypes423-427 derives recursive Clone and fields-then-line equality.
// CSVGlueABI owns CSV offsets; List24 allocation/access primitives are shared.
#Export(c) jet_rt_handle_clone_csv_row: fn(value: I64) -> I64 {
    fields: dyn_word(wrapping(value + CSV_ROW_FIELDS))
    length: dyn_word(wrapping(fields + DATA_SEQUENCE_LENGTH))
    source: dyn_word(wrapping(fields + DATA_SEQUENCE_DATA))
    copied: data_sequence_new(length, CSV_FIELD_STRIDE)
    target: dyn_word(wrapping(copied + DATA_SEQUENCE_DATA))
    at := I64{0}
    loop at < length {
        dyn_store(wrapping(target + at * CSV_FIELD_STRIDE), jet_rt_string_clone(dyn_word(wrapping(source + at * CSV_FIELD_STRIDE))))
        at += I64{1}
    }
    dyn_store(wrapping(copied + DATA_SEQUENCE_LENGTH), length)
    result: jet_rt_alloc(CSV_ROW_BYTES, I64{8})
    dyn_store(wrapping(result + CSV_ROW_FIELDS), copied)
    dyn_store(wrapping(result + CSV_ROW_LINE), dyn_word(wrapping(value + CSV_ROW_LINE)))
    result
}
#Export(c) jet_rt_handle_drop_csv_row: fn(value: I64) {
    if (value == I64{0}) -> return
    fields: dyn_word(wrapping(value + CSV_ROW_FIELDS))
    length: dyn_word(wrapping(fields + DATA_SEQUENCE_LENGTH))
    capacity: dyn_word(wrapping(fields + DATA_SEQUENCE_CAPACITY))
    data: dyn_word(wrapping(fields + DATA_SEQUENCE_DATA))
    at := I64{0}
    loop at < length {
        jet_rt_string_drop(dyn_word(wrapping(data + at * CSV_FIELD_STRIDE)))
        at += I64{1}
    }
    if (capacity != I64{0}) -> jet_rt_free(data, capacity * CSV_FIELD_STRIDE, I64{8})
    jet_rt_free(fields, DATA_SEQUENCE_BYTES, I64{8})
    jet_rt_free(value, CSV_ROW_BYTES, I64{8})
}
#Export(c) jet_rt_handle_eq_csv_row: fn(left: I64, right: I64) -> Bool {
    a: dyn_word(wrapping(left + CSV_ROW_FIELDS))
    b: dyn_word(wrapping(right + CSV_ROW_FIELDS))
    length: dyn_word(wrapping(a + DATA_SEQUENCE_LENGTH))
    if length != dyn_word(wrapping(b + DATA_SEQUENCE_LENGTH)) -> return false
    first: dyn_word(wrapping(a + DATA_SEQUENCE_DATA))
    second: dyn_word(wrapping(b + DATA_SEQUENCE_DATA))
    at := I64{0}
    loop at < length {
        if !jet_rt_string_eq(dyn_word(wrapping(first + at * CSV_FIELD_STRIDE)), dyn_word(wrapping(second + at * CSV_FIELD_STRIDE))) -> return false
        at += I64{1}
    }
    dyn_word(wrapping(left + CSV_ROW_LINE)) == dyn_word(wrapping(right + CSV_ROW_LINE))
}
