#Export(c) fn jet_rt_record_new_jet_data_plot_facet(m0: I64, m1: I64, m2: I64, m3: I64, m4: I64) -> I64 {
    kind :: data_plot_tag(m1, I64{2})
    columns :: jet_int_owned_to_i64(m3)
    rows :: jet_int_owned_to_i64(m4)
    value :: jet_rt_alloc(DP_FACET_BYTES, I64{8})
    data_tree_store(value + DP_FACET_FIELD, m0)
    data_tree_store(value + DP_FACET_KIND, kind)
    data_tree_store(value + DP_FACET_TITLE, jet_rt_string_clone(m2))
    data_tree_store(value + DP_FACET_COLUMNS, columns)
    data_tree_store(value + DP_FACET_ROWS, rows)
    value
}
#Export(c) fn jet_rt_handle_clone_jet_data_plot_facet(value: I64) -> I64 {
    result :: jet_rt_alloc(DP_FACET_BYTES, I64{8})
    coll_copy(value, result, DP_FACET_BYTES)
    data_tree_store(result + DP_FACET_FIELD, jet_rt_handle_clone_jet_data_plot_field(data_tree_word(value + DP_FACET_FIELD)))
    data_tree_store(result + DP_FACET_TITLE, jet_rt_string_clone(data_tree_word(value + DP_FACET_TITLE)))
    result
}
#Export(c) fn jet_rt_handle_drop_jet_data_plot_facet(value: I64) {
    if (value == I64{0}) -> return
    jet_rt_handle_drop_jet_data_plot_field(data_tree_word(value + DP_FACET_FIELD))
    jet_rt_string_drop(data_tree_word(value + DP_FACET_TITLE))
    jet_rt_free(value, DP_FACET_BYTES, I64{8})
}
#Export(c) fn jet_rt_handle_eq_jet_data_plot_facet(a: I64, b: I64) -> Bool {
    jet_rt_handle_eq_jet_data_plot_field(data_tree_word(a + DP_FACET_FIELD), data_tree_word(b + DP_FACET_FIELD)) && data_tree_word(a + DP_FACET_KIND) == data_tree_word(b + DP_FACET_KIND) && jet_rt_string_eq(data_tree_word(a + DP_FACET_TITLE), data_tree_word(b + DP_FACET_TITLE)) && data_tree_word(a + DP_FACET_COLUMNS) == data_tree_word(b + DP_FACET_COLUMNS) && data_tree_word(a + DP_FACET_ROWS) == data_tree_word(b + DP_FACET_ROWS)
}
