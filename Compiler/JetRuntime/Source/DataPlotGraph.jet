    data_tree_store(value + DP_ENCODING_FIELD, m1)
    data_tree_store(value + DP_ENCODING_AGGREGATE, aggregate)
    value
}
#Export(c) fn jet_rt_handle_clone_jet_data_plot_encoding(value: I64) -> I64 {
    result :: jet_rt_alloc(DP_ENCODING_BYTES, I64{8})
    data_tree_store(result + DP_ENCODING_CHANNEL, data_tree_word(value + DP_ENCODING_CHANNEL))
    data_tree_store(result + DP_ENCODING_FIELD, jet_rt_handle_clone_jet_data_plot_field(data_tree_word(value + DP_ENCODING_FIELD)))
    data_tree_store(result + DP_ENCODING_AGGREGATE, data_tree_word(value + DP_ENCODING_AGGREGATE))
    result
}
#Export(c) fn jet_rt_handle_drop_jet_data_plot_encoding(value: I64) {
    if (value == I64{0}) -> return
    jet_rt_handle_drop_jet_data_plot_field(data_tree_word(value + DP_ENCODING_FIELD))
    jet_rt_free(value, DP_ENCODING_BYTES, I64{8})
}
#Export(c) fn jet_rt_handle_eq_jet_data_plot_encoding(a: I64, b: I64) -> Bool {
    data_tree_word(a + DP_ENCODING_CHANNEL) == data_tree_word(b + DP_ENCODING_CHANNEL) && jet_rt_handle_eq_jet_data_plot_field(data_tree_word(a + DP_ENCODING_FIELD), data_tree_word(b + DP_ENCODING_FIELD)) && data_tree_word(a + DP_ENCODING_AGGREGATE) == data_tree_word(b + DP_ENCODING_AGGREGATE)
}
#Export(c) fn jet_rt_record_get_jet_data_plot_encoding_channel(value: I64) -> I64 { data_tree_word(value + DP_ENCODING_CHANNEL) }
#Export(c) fn jet_rt_record_get_jet_data_plot_encoding_field(value: I64) -> I64 { jet_rt_handle_clone_jet_data_plot_field(data_tree_word(value + DP_ENCODING_FIELD)) }
#Export(c) fn jet_rt_record_get_jet_data_plot_encoding_aggregate(value: I64) -> I64 { data_tree_word(value + DP_ENCODING_AGGREGATE) }
#Export(c) fn jet_rt_record_seq_list_rec_jet_data_plot_encoding_new(capacity: I64) -> I64 { data_sequence_new(capacity, DATA_TREE_ELEMENT_BYTES) }
#Export(c) fn jet_rt_record_seq_list_rec_jet_data_plot_encoding_len(value: I64) -> I64 { data_tree_word(value + DATA_SEQUENCE_LENGTH) }
#Export(c) fn jet_rt_record_seq_list_rec_jet_data_plot_encoding_get(value: I64, index: I64) -> I64 { data_tree_word(data_sequence_slot(value, index, DATA_TREE_ELEMENT_BYTES)) }
