// Native-private ownership graph; DataABI.jet is the only layout table.
// Seed derives/declarations DataPlot.rs:481-485,662-666,692-711,772-804,
// 929-935,961-967,1243-1253. Sequence getters lend, nested getters clone.
// Facet i64 codec CAbiRoutes.rs:9905-9918; Error.index:9870-9883.
fn data_plot_fields_clone(sequence: I64) -> I64 {
    length :: data_tree_word(sequence + DATA_SEQUENCE_LENGTH)
    result :: data_sequence_new(length, DATA_TREE_ELEMENT_BYTES)
    at := I64{0}
    loop at < length {
        data_plot_sequence_push(result, jet_rt_handle_clone_jet_data_plot_field(data_tree_word(data_sequence_slot(sequence, at, DATA_TREE_ELEMENT_BYTES))))
        at += I64{1}
    }
    result
}
fn data_plot_fields_drop(sequence: I64) {
    length :: data_tree_word(sequence + DATA_SEQUENCE_LENGTH)
    at := I64{0}
    loop at < length {
        jet_rt_handle_drop_jet_data_plot_field(data_tree_word(data_sequence_slot(sequence, at, DATA_TREE_ELEMENT_BYTES)))
        at += I64{1}
    }
    data_plot_sequence_shell_drop(sequence, DATA_TREE_ELEMENT_BYTES)
}
fn data_plot_fields_eq(a: I64, b: I64) -> Bool {
    length :: data_tree_word(a + DATA_SEQUENCE_LENGTH)
    if length != data_tree_word(b + DATA_SEQUENCE_LENGTH) -> return false
    at := I64{0}
    loop at < length {
        if !jet_rt_handle_eq_jet_data_plot_field(data_tree_word(data_sequence_slot(a, at, DATA_TREE_ELEMENT_BYTES)), data_tree_word(data_sequence_slot(b, at, DATA_TREE_ELEMENT_BYTES))) -> return false
        at += I64{1}
    }
    true
}
fn data_plot_sequence_shell_drop(sequence: I64, stride: I64) {
    capacity :: data_tree_word(sequence + DATA_SEQUENCE_CAPACITY)
    if (capacity != I64{0}) -> jet_rt_free(data_tree_word(sequence + DATA_SEQUENCE_DATA), capacity * stride, I64{8})
    jet_rt_free(sequence, DATA_SEQUENCE_BYTES, I64{8})
}
#Export(c) fn jet_rt_record_new_jet_data_plot_schema(m0: I64, m1: I64, m2: I64) -> I64 {
    value :: jet_rt_alloc(DP_SCHEMA_BYTES, I64{8})
    data_tree_store(value + DP_SCHEMA_ID, jet_rt_string_clone(m0))
    data_tree_store(value + DP_SCHEMA_ROW_TYPE, jet_rt_string_clone(m1))
    data_tree_store(value + DP_SCHEMA_COLUMNS, m2)
    value
}
#Export(c) fn jet_rt_handle_clone_jet_data_plot_schema(value: I64) -> I64 {
    result :: jet_rt_alloc(DP_SCHEMA_BYTES, I64{8})
    data_tree_store(result + DP_SCHEMA_ID, jet_rt_string_clone(data_tree_word(value + DP_SCHEMA_ID)))
    data_tree_store(result + DP_SCHEMA_ROW_TYPE, jet_rt_string_clone(data_tree_word(value + DP_SCHEMA_ROW_TYPE)))
    data_tree_store(result + DP_SCHEMA_COLUMNS, data_plot_fields_clone(data_tree_word(value + DP_SCHEMA_COLUMNS)))
    result
}
#Export(c) fn jet_rt_handle_drop_jet_data_plot_schema(value: I64) {
    if (value == I64{0}) -> return
    jet_rt_string_drop(data_tree_word(value + DP_SCHEMA_ID))
    jet_rt_string_drop(data_tree_word(value + DP_SCHEMA_ROW_TYPE))
    data_plot_fields_drop(data_tree_word(value + DP_SCHEMA_COLUMNS))
    jet_rt_free(value, DP_SCHEMA_BYTES, I64{8})
}
#Export(c) fn jet_rt_handle_eq_jet_data_plot_schema(a: I64, b: I64) -> Bool {
    jet_rt_string_eq(data_tree_word(a + DP_SCHEMA_ID), data_tree_word(b + DP_SCHEMA_ID)) && jet_rt_string_eq(data_tree_word(a + DP_SCHEMA_ROW_TYPE), data_tree_word(b + DP_SCHEMA_ROW_TYPE)) && data_plot_fields_eq(data_tree_word(a + DP_SCHEMA_COLUMNS), data_tree_word(b + DP_SCHEMA_COLUMNS))
}
#Export(c) fn jet_rt_record_get_jet_data_plot_schema_identity(value: I64) -> I64 { jet_rt_string_clone(data_tree_word(value + DP_SCHEMA_ID)) }
#Export(c) fn jet_rt_record_get_jet_data_plot_schema_row_type(value: I64) -> I64 { jet_rt_string_clone(data_tree_word(value + DP_SCHEMA_ROW_TYPE)) }
#Export(c) fn jet_rt_record_get_jet_data_plot_schema_columns(value: I64) -> I64 { data_tree_word(value + DP_SCHEMA_COLUMNS) }
#Export(c) fn jet_rt_record_new_jet_data_plot_encoding(m0: I64, m1: I64, m2: I64) -> I64 {
    channel :: data_plot_tag(m0, I64{6})
    aggregate :: data_plot_tag(m2, I64{6})
    value :: jet_rt_alloc(DP_ENCODING_BYTES, I64{8})
