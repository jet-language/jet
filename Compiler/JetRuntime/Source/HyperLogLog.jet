// Exact positive IEEE round (ties away), then Rust's saturating as-i64.
fn hll_round(value: Float) -> I64 {
    bits :: rt_f64_bits(value)
    exponent :: ((bits >> I64{52}).bit_and(I64{2047})) - I64{1023}
    if (exponent >= I64{63}) -> return I64{9223372036854775807}
    if (exponent < I64{-1}) -> return I64{0}
    if (exponent == I64{-1}) -> return I64{1}
    significand :: (bits.bit_and(I64{4503599627370495})).bit_or(I64{4503599627370496})
    if (exponent >= I64{52}) -> return significand << (exponent - I64{52})
    shift :: I64{52} - exponent
    (significand >> shift) + ((significand >> (shift - I64{1})).bit_and(I64{1}))
}
fn hll_count(value: I64) -> I64 {
    sync_mutex_lock(value + HLL_MUTEX)
    empty := I64{0}
    at := I64{0}
    loop at < HLL_REGISTERS {
        rank :: rt_text_byte(value + HLL_DATA + at * HLL_REGISTER_BYTES)
        if (rank == I64{0}) -> empty += I64{1}
        at += I64{1}
    }
    if (empty > I64{0}) {
        sync_mutex_unlock(value + HLL_MUTEX)
        return hll_linear(empty)
    }
    sum := Float{-0.0}
    at = I64{0}
    loop at < HLL_REGISTERS {
        rank :: rt_text_byte(value + HLL_DATA + at * HLL_REGISTER_BYTES)
        // Every U8 rank0..255 gives a normal, exact power-of-two exponent.
        sum += rt_f64_from_bits((I64{1023} - rank) << I64{52})
        at += I64{1}
    }
    sync_mutex_unlock(value + HLL_MUTEX)
    alpha :: Float{0.7213} / (Float{1.0} + Float{1.079} / Float{256.0})
    hll_round(alpha * Float{256.0} * Float{256.0} / sum)
}
#Export(c) fn jet_hyper_log_log_new() -> I64 {
    value :: jet_rt_alloc(HLL_BYTES, I64{8})
    thread_zero(value, HLL_BYTES)
    sync_store(value + HLL_REFS, I64{1})
    value
}
#Export(c) fn jet_rt_handle_clone_jet_hyper_log_log(value: I64) -> I64 {
    _ := sync_add(value + HLL_REFS, I64{1})
    value
}
#Export(c) fn jet_rt_handle_drop_jet_hyper_log_log(value: I64) {
    if (value == I64{0}) -> return
    if (sync_add(value + HLL_REFS, I64{-1}) == I64{1}) -> jet_rt_free(value, HLL_BYTES, I64{8})
}
#Export(c) fn jet_rt_native_hll_add(value: I64, text: I64) {
    hash :: cms_hash(text, I64{-3750763034362895579})
    index :: hash.bit_and(I64{255})
    rest := (hash >> I64{8}).bit_and(I64{72057594037927935})
    rank := I64{57}
    if (rest != I64{0}) {
        // Logical shift left eight high zeros in the seed's u64 rest.
        rank = I64{9}
        bit := I64{36028797018963968}
        loop {
            if ((rest.bit_and(bit)) != I64{0}) -> break
            rank += I64{1}
            bit >>= I64{1}
        }
    }
    sync_mutex_lock(value + HLL_MUTEX)
    address :: value + HLL_DATA + index * HLL_REGISTER_BYTES
    if (rank > rt_text_byte(address)) {
        #Unsafe("one native HLL mutex protects this packed register byte") { os_store_u8(address, rank) }
    }
    sync_mutex_unlock(value + HLL_MUTEX)
}
#Export(c) fn jet_rt_native_hll_count(value: I64) -> I64 { jet_int_owned_from_i64(hll_count(value)) }
#Export(c) fn jet_rt_handle_show_jet_hyper_log_log(value: I64) -> I64 {
    count :: hll_count(value)
    text :: jet_rt_string_builder_new()
    rt_text_push_word(text, I64{7453259962533312840}, I64{8}) // HyperLog
    rt_text_push_word(text, I64{7959390388117532492}, I64{8}) // Log(coun
    rt_text_push_word(text, I64{15732}, I64{2}) // t=
    rt_text_push_number(text, count)
    rt_text_push_word(text, I64{41}, I64{1})
    jet_rt_string_builder_finish(text)
}
