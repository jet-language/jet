// Registry-plain EmailError: exact native enum layout, not a Rust Error box.
// Lower/Values.jet:49-55,65-74,111-127,137-145: tag then four pointer words.
// The server option is a nullable pointer to a one-word Text-handle box; the
// code option is an inline Int? word (INT_OPTION_NONE when absent), which
// jet_rt_int_clone/jet_rt_int_drop pass through.
// Producers are checked Core literals and native SMTP; no constructor facade.
// ProcessSpec.jet:4-7 allocates ENCODING_ENUM_BYTES with alignment 8;
// EncodingErrors.jet:16-17 frees that same ENCODING_ENUM_BYTES/alignment 8.
// Both implement the canonical eight-byte Option payload box contract.
fn email_error_tag(value: I64) -> I64 {
    ordinal :: encoding_word(value + EMAIL_ERROR_TAG)
    if (ordinal < I64{0} || ordinal > I64{10}) -> rt_record_variant_panic()
    ordinal
}
fn email_error_text_option_clone(value: I64) -> I64 {
    if (value == I64{0}) -> return I64{0}
    process_raw_box(jet_rt_string_clone(encoding_word(value)))
}
fn email_error_text_option_drop(value: I64) {
    if (value == I64{0}) -> return
    jet_rt_string_drop(encoding_word(value))
    encoding_enum_drop(value)
}
fn email_error_text_option_eq(left: I64, right: I64) -> Bool {
    if (left == I64{0} || right == I64{0}) -> return left == right
    jet_rt_string_eq(encoding_word(left), encoding_word(right))
}
fn email_error_code_eq(left: I64, right: I64) -> Bool {
    if (left == INT_OPTION_NONE || right == INT_OPTION_NONE) -> return left == right
    jet_int_compare(left, right) == I64{0}
}
#Export(c) fn jet_rt_handle_clone_error(value: I64) -> I64 {
    ordinal :: email_error_tag(value)
    result :: jet_rt_alloc(EMAIL_ERROR_BYTES, I64{8})
    encoding_store(result + EMAIL_ERROR_TAG, ordinal)
    encoding_store(result + EMAIL_ERROR_OPERATION, jet_rt_string_clone(encoding_word(value + EMAIL_ERROR_OPERATION)))
    encoding_store(result + EMAIL_ERROR_SERVER, email_error_text_option_clone(encoding_word(value + EMAIL_ERROR_SERVER)))
    encoding_store(result + EMAIL_ERROR_CODE, jet_rt_int_clone(encoding_word(value + EMAIL_ERROR_CODE)))
    encoding_store(result + EMAIL_ERROR_REASON, jet_rt_string_clone(encoding_word(value + EMAIL_ERROR_REASON)))
    result
}
#Export(c) fn jet_rt_handle_drop_error(value: I64) {
    if (value == I64{0}) -> return
    email_error_tag(value)
    jet_rt_string_drop(encoding_word(value + EMAIL_ERROR_OPERATION))
    email_error_text_option_drop(encoding_word(value + EMAIL_ERROR_SERVER))
    jet_rt_int_drop(encoding_word(value + EMAIL_ERROR_CODE))
    jet_rt_string_drop(encoding_word(value + EMAIL_ERROR_REASON))
    jet_rt_free(value, EMAIL_ERROR_BYTES, I64{8})
}
#Export(c) fn jet_rt_handle_eq_error(left: I64, right: I64) -> Bool {
    a :: email_error_tag(left)
    b :: email_error_tag(right)
    if (a != b) -> return false
    if !jet_rt_string_eq(encoding_word(left + EMAIL_ERROR_OPERATION), encoding_word(right + EMAIL_ERROR_OPERATION)) -> return false
    if !email_error_text_option_eq(encoding_word(left + EMAIL_ERROR_SERVER), encoding_word(right + EMAIL_ERROR_SERVER)) -> return false
    if !email_error_code_eq(encoding_word(left + EMAIL_ERROR_CODE), encoding_word(right + EMAIL_ERROR_CODE)) -> return false
    jet_rt_string_eq(encoding_word(left + EMAIL_ERROR_REASON), encoding_word(right + EMAIL_ERROR_REASON))
}
