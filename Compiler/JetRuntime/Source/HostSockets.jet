// Raw nonblocking socket facts. Core owns retries, deadlines, limits and error
// selection. Every syscall is a single attempt; readiness uses HostNetPoller.
// FD72 is the sole descriptor/closed owner, including logical network close.
// Setup calls own 128B scratch; no scratch pointer survives the syscall.
// No operation yields with a lock or couples networking to the stdout mutex.
net_socket_domain: fn(family: I64) -> I64 {
    if (family == I64{4}) -> I64{2} else if (family == I64{6}) -> I64{10} else -> family
}
net_socket_call: fn(state: I64, number: I64, a2: I64, a3: I64, a4: I64, a5: I64, a6: I64) -> I64 {
    fd_lock(state)
    result := I64{-9}
    if (fd_word(state, I64{16}) == I64{0}) {
        #Unsafe("the FD72 lock prevents native descriptor close/reuse throughout this nonblocking syscall") {
            result = os_syscall_i64(number, fd_word(state, I64{8}), a2, a3, a4, a5, a6)
        }
    }
    fd_unlock(state)
    result
}
#Export(c) jet_socket_create_raw: fn(family: I64, kind: I64, protocol: I64, error: I64) -> I64 {
    jet_rt_world_reject_uncontrolled(I64{1})
    if (jet_scheduler_native_propagate() != I64{0}) -> return I64{0}
    result: host_call(I64{41}, net_socket_domain(family), (kind.bit_and(I64{15})).bit_or(I64{526336}), protocol)
    _ := fd_error(result, error)
    if (result < I64{0}) -> I64{0} else -> jet_fd_adopt_unbuffered_raw(result, I64{0})
}
net_socket_address_call: fn(state: I64, address: I64, number: I64) -> I64 {
    fd_lock(state)
    result := I64{-9}
    if (fd_word(state, I64{16}) == I64{0}) {
        scratch: jet_rt_alloc(I64{128}, I64{8})
        length: jet_socket_address_encode_raw(address, scratch)
        result = host_call(number, fd_word(state, I64{8}), scratch, length)
        jet_rt_free(scratch, I64{128}, I64{8})
    }
    fd_unlock(state)
    result
}
#Export(c) jet_socket_bind_raw: fn(state: I64, address: I64, error: I64) -> I64 {
    fd_error(net_socket_address_call(state, address, I64{49}), error)
}
#Export(c) jet_socket_connect_raw: fn(state: I64, address: I64, error: I64) -> I64 {
    // EINPROGRESS is an errno fact, not a successful connection. Core waits for
    // writable readiness and reads SO_ERROR before reporting connected.
    fd_error(net_socket_address_call(state, address, I64{42}), error)
}
#Export(c) jet_socket_listen_raw: fn(state: I64, backlog: I64, error: I64) -> I64 {
    fd_error(net_socket_call(state, I64{50}, backlog, I64{0}, I64{0}, I64{0}, I64{0}), error)
}
#Export(c) jet_socket_accept_raw: fn(state: I64, address_out: I64, error: I64) -> I64 {
    fd_lock(state)
    result := I64{-9}
    if (fd_word(state, I64{16}) == I64{0}) {
        if (address_out == I64{0}) {
            #Unsafe("accept4 retains no address pointers and atomically sets CLOEXEC/NONBLOCK on the accepted socket") {
                result = os_syscall_i64(I64{288}, fd_word(state, I64{8}), I64{0}, I64{0}, I64{526336}, I64{0}, I64{0})
            }
        } else {
            scratch: jet_rt_alloc(I64{128}, I64{8})
            size: wrapping(scratch + I64{32})
            net_store_uint(size, I64{4}, I64{32})
            #Unsafe("private scratch lends sockaddr bytes and its exact 4B socklen; accept4 retains neither pointer") {
                result = os_syscall_i64(I64{288}, fd_word(state, I64{8}), scratch, size, I64{526336}, I64{0}, I64{0})
            }
            if (result >= I64{0} && !net_socket_decode(scratch, net_load_uint(size, I64{4}), address_out)) {
                _ := host_call(I64{3}, result, I64{0}, I64{0})
                result = I64{-22}
            }
            jet_rt_free(scratch, I64{128}, I64{8})
        }
    }
    fd_unlock(state)
    _ := fd_error(result, error)
    if (result < I64{0}) -> I64{0} else -> jet_fd_adopt_unbuffered_raw(result, I64{0})
}
#Export(c) jet_socket_address_raw: fn(state: I64, peer: Bool, address_out: I64, error: I64) -> I64 {
    fd_lock(state)
    result := I64{-9}
    if (fd_word(state, I64{16}) == I64{0}) {
        scratch: jet_rt_alloc(I64{128}, I64{8})
        size: wrapping(scratch + I64{32})
        net_store_uint(size, I64{4}, I64{32})
        result = host_call(if peer -> I64{52} else -> I64{51}, fd_word(state, I64{8}), scratch, size)
        if (result >= I64{0} && !net_socket_decode(scratch, net_load_uint(size, I64{4}), address_out)) -> result = I64{-22}
        jet_rt_free(scratch, I64{128}, I64{8})
    }
    fd_unlock(state)
    fd_error(result, error)
}
#Export(c) jet_socket_option_get_raw: fn(state: I64, level: I64, option: I64, value_out: I64, error: I64) -> I64 {
    fd_lock(state)
    result := I64{-9}
    if (fd_word(state, I64{16}) == I64{0}) {
        scratch: jet_rt_alloc(I64{128}, I64{8})
        size: wrapping(scratch + I64{8})
        net_store_uint(size, I64{4}, I64{4})
        #Unsafe("private scratch lends one native int and its 4B socklen; getsockopt retains neither pointer") {
            result = os_syscall_i64(I64{55}, fd_word(state, I64{8}), level, option, scratch, size, I64{0})
        }
        if (result >= I64{0}) -> net_put(value_out, I64{0}, net_load_uint(scratch, I64{4}))
        jet_rt_free(scratch, I64{128}, I64{8})
    }
    fd_unlock(state)
    fd_error(result, error)
}
#Export(c) jet_socket_option_set_raw: fn(state: I64, level: I64, option: I64, value: I64, error: I64) -> I64 {
    fd_lock(state)
    result := I64{-9}
    if (fd_word(state, I64{16}) == I64{0}) {
        scratch: jet_rt_alloc(I64{128}, I64{8})
        net_store_uint(scratch, I64{4}, value)
        #Unsafe("private scratch lends exactly one native int; setsockopt retains no pointer") {
            result = os_syscall_i64(I64{54}, fd_word(state, I64{8}), level, option, scratch, I64{4}, I64{0})
        }
        jet_rt_free(scratch, I64{128}, I64{8})
    }
    fd_unlock(state)
    fd_error(result, error)
}
#Export(c) jet_socket_shutdown_raw: fn(state: I64, how: I64, error: I64) -> I64 {
    fd_error(net_socket_call(state, I64{48}, how, I64{0}, I64{0}, I64{0}, I64{0}), error)
}
#Export(c) jet_socket_mark_closed_raw: fn(state: I64) {
    // Rust network close is logical while the owning socket remains alive.
    // Last FD72 drop closes its still-owned descriptor, even when closed16=1.
    fd_lock(state)
    if (fd_word(state, I64{16}) == I64{0}) {
        fd_put(state, I64{16}, I64{1})
        _ := net_fd_closed(state)
    }
    fd_unlock(state)
}

net_copy_packed: fn(data: I64, length: I64, output: I64) {
    at := I64{0}
    #Unsafe("data lends length native U8 elements; output owns length compact bytes") {
        loop at < length {
            os_store_u8(wrapping(output + at), host_u8_get(data, at))
            at = at + I64{1}
        }
    }
}
net_socket_transfer: fn(state: I64, data: I64, length: I64, reading: Bool, error: I64) -> I64 {
    fd_lock(state)
    result := I64{-9}
    if (fd_word(state, I64{16}) == I64{0}) {
        temporary: RT_HOST_U8_STRIDE != I64{1} && length != I64{0}
        packed: if temporary -> jet_rt_alloc(length, I64{8}) else -> data
        if (!reading && temporary) -> net_copy_packed(data, length, packed)
        #Unsafe("the held FD72 lock lends its live nonblocking socket; packed lends exactly length bytes; no pointer survives recvfrom/sendto") {
            result = os_syscall_i64(if reading -> I64{45} else -> I64{44}, fd_word(state, I64{8}), packed, length, if reading -> I64{0} else -> I64{16384}, I64{0}, I64{0})
        }
        if (temporary && reading && result > I64{0}) {
            at := I64{0}
            #Unsafe("recvfrom initialized result compact bytes; data owns the corresponding mutable native U8 slots") {
                loop at < result {
                    host_u8_put(data, at, os_load_u8(wrapping(packed + at)))
                    at = at + I64{1}
                }
            }
        }
        if temporary -> jet_rt_free(packed, length, I64{8})
    }
    fd_unlock(state)
    fd_error(result, error)
}
#Export(c) jet_socket_read_raw: fn(state: I64, data: I64, length: I64, error: I64) -> I64 {
    net_socket_transfer(state, data, length, true, error)
}
#Export(c) jet_socket_write_raw: fn(state: I64, data: I64, length: I64, error: I64) -> I64 {
    // std's Unix socket write uses MSG_NOSIGNAL independent of the embedding
    // host's SIGPIPE disposition. This is not a process-wide signal change.
    net_socket_transfer(state, data, length, false, error)
}
#Export(c) jet_socket_send_to_raw: fn(state: I64, data: I64, length: I64, address: I64, error: I64) -> I64 {
    fd_lock(state)
    result := I64{-9}
    if (fd_word(state, I64{16}) == I64{0}) {
        // Word epoch needs one combined conversion/address allocation. Packed
        // epoch lends the input directly and owns only the address scratch.
        size: if (RT_HOST_U8_STRIDE == I64{1}) -> I64{128} else -> wrapping(I64{128} + length)
        scratch: jet_rt_alloc(size, I64{8})
        packed: if (RT_HOST_U8_STRIDE == I64{1}) -> data else -> wrapping(scratch + I64{128})
        if (RT_HOST_U8_STRIDE != I64{1}) -> net_copy_packed(data, length, packed)
        address_length: jet_socket_address_encode_raw(address, scratch)
        #Unsafe("the FD72 lock retains the socket; private scratch lends sockaddr bytes; packed lends length bytes; sendto retains no pointers") {
            result = os_syscall_i64(I64{44}, fd_word(state, I64{8}), packed, length, I64{16384}, scratch, address_length)
        }
        jet_rt_free(scratch, size, I64{8})
    }
    fd_unlock(state)
    fd_error(result, error)
}
#Export(c) jet_socket_receive_from_raw: fn(state: I64, data: I64, length: I64, address_out: I64, error: I64) -> I64 {
    fd_lock(state)
    result := I64{-9}
    if (fd_word(state, I64{16}) == I64{0}) {
        size: if (RT_HOST_U8_STRIDE == I64{1}) -> I64{128} else -> wrapping(I64{128} + length)
        scratch: jet_rt_alloc(size, I64{8})
        packed: if (RT_HOST_U8_STRIDE == I64{1}) -> data else -> wrapping(scratch + I64{128})
        address_length: wrapping(scratch + I64{32})
        net_store_uint(address_length, I64{4}, I64{32})
        #Unsafe("private scratch lends sockaddr/socklen and packed lends length mutable bytes; MSG_TRUNC returns the complete datagram length while writing at most length bytes") {
            result = os_syscall_i64(I64{45}, fd_word(state, I64{8}), packed, length, I64{32}, scratch, address_length)
        }
        if (result >= I64{0}) {
            if !net_socket_decode(scratch, net_load_uint(address_length, I64{4}), address_out) {
                result = I64{-22}
            } else if (RT_HOST_U8_STRIDE != I64{1}) {
                used: if (result < length) -> result else -> length
                at := I64{0}
                #Unsafe("recvfrom initialized used compact bytes; the caller owns used mutable native U8 elements") {
                    loop at < used {
                        host_u8_put(data, at, os_load_u8(wrapping(packed + at)))
                        at = at + I64{1}
                    }
                }
            }
        }
        jet_rt_free(scratch, size, I64{8})
    }
    fd_unlock(state)
    fd_error(result, error)
}

// Rust 1.90 library/std/src/os/unix/net/addr.rs sockaddr_un:33-45.
// NUL is checked FIRST, including an overlength path containing NUL. These
// are logical InvalidInput facts, not counterfeit Linux errno. Core maps the
// named status to the exact std message and os_code=None.
HOST_UNIX_PATH_TOO_LONG: I64{-4097}
HOST_UNIX_PATH_NUL: I64{-4098}
net_unix_path_status: fn(path: I64) -> I64 {
    length: rt_text_len(path)
    source: rt_text_data(path)
    at := I64{0}
    #Unsafe("path lends its immutable E4 bytes for std-compatible sockaddr_un validation") {
        loop at < length {
            if (os_load_u8(wrapping(source + at)) == I64{0}) -> return HOST_UNIX_PATH_NUL
            at = at + I64{1}
        }
    }
    if (length >= I64{108}) -> HOST_UNIX_PATH_TOO_LONG else -> I64{0}
}
// A pathname of SUN_LEN bytes or more is reached through its directory: the
// directory is opened O_PATH and the socket is named
// /proc/self/fd/<fd>/<name>, which Linux resolves through that open
// descriptor. On success this returns the descriptor (the caller closes it
// after the call), writes the alias pathname with its zero byte at
// `address` + 2 and its length at `address` + 120. A path with no directory
// part, or a name too long for the alias, stays HOST_UNIX_PATH_TOO_LONG; a
// directory that cannot be opened is its negative errno.
net_unix_long_alias: fn(path: I64, address: I64) -> I64 {
    length: rt_text_len(path)
    data: rt_text_data(path)
    slash := length - I64{1}
    loop slash >= (I64{0}) && rt_text_byte(wrapping(data + slash)) != (I64{47}) -> slash -= I64{1}
    if (slash < I64{0}) -> return HOST_UNIX_PATH_TOO_LONG
    name_length: length - slash - I64{1}
    // "/proc/self/fd/", at most 10 digits, "/", the name and its zero byte.
    if (name_length == I64{0} || name_length > I64{82}) -> return HOST_UNIX_PATH_TOO_LONG
    directory_length: if (slash == I64{0}) -> I64{1} else -> slash
    directory: jet_rt_alloc(directory_length + I64{1}, I64{8})
    rt_text_bytes_copy(directory, data, directory_length)
    net_store_uint(wrapping(directory + directory_length), I64{1}, I64{0})
    // openat(AT_FDCWD, directory, O_PATH | O_DIRECTORY | O_CLOEXEC).
    descriptor: host_call(I64{257}, I64{-100}, directory, I64{2686976})
    jet_rt_free(directory, directory_length + I64{1}, I64{8})
    if (descriptor < I64{0}) -> return descriptor
    prefix: rt_static_text("/proc/self/fd/")
    at := wrapping(address + I64{2})
    rt_text_bytes_copy(at, rt_text_data(prefix), rt_text_len(prefix))
    at = wrapping(at + rt_text_len(prefix))
    digits := I64{1}
    scale := I64{10}
    loop descriptor >= scale {
        digits += I64{1}
        scale = scale * I64{10}
    }
    value := descriptor
    place := digits
    loop place > (I64{0}) {
        place -= I64{1}
        net_store_uint(wrapping(at + place), I64{1}, I64{48} + value % I64{10})
        value = value /% I64{10}
    }
    at = wrapping(at + digits)
    net_store_uint(at, I64{1}, I64{47})
    rt_text_bytes_copy(wrapping(at + I64{1}), wrapping(data + slash + I64{1}), name_length)
    net_store_uint(wrapping(at + I64{1} + name_length), I64{1}, I64{0})
    rt_text_store(wrapping(address + I64{120}), rt_text_len(prefix) + digits + I64{1} + name_length)
    descriptor
}
net_socket_unix_call: fn(state: I64, path: I64, number: I64, error: I64) -> I64 {
    refusal := net_unix_path_status(path)
    scratch: jet_rt_alloc(I64{128}, I64{8})
    alias := I64{-1}
    if (refusal == HOST_UNIX_PATH_TOO_LONG) {
        opened: net_unix_long_alias(path, scratch)
        if (opened >= I64{0}) {
            alias = opened
            refusal = I64{0}
        } else if (opened != HOST_UNIX_PATH_TOO_LONG) {
            jet_rt_free(scratch, I64{128}, I64{8})
            return fd_error(opened, error)
        }
    }
    if (refusal != I64{0}) {
        jet_rt_free(scratch, I64{128}, I64{8})
        host_error_out(I64{0}, I64{0}, error)
        return refusal
    }
    fd_lock(state)
    result := I64{-9}
    if (fd_word(state, I64{16}) == I64{0}) {
        length: if (alias >= I64{0}) -> rt_text_word(wrapping(scratch + I64{120})) else -> rt_text_len(path)
        net_store_uint(scratch, I64{2}, I64{1})
        if (alias < I64{0}) {
            rt_text_bytes_copy(wrapping(scratch + I64{2}), rt_text_data(path), length)
            if (length != I64{0}) -> net_store_uint(wrapping(scratch + I64{2} + length), I64{1}, I64{0})
        }
        // Empty path is addrlen=2, exactly std's SUN_PATH_OFFSET; no invented
        // pathname, abstract-name policy, unlink or terminator-length change.
        address_length: I64{2} + length + (if (length == I64{0}) -> I64{0} else -> I64{1})
        result = host_call(number, fd_word(state, I64{8}), scratch, address_length)
    }
    fd_unlock(state)
    if (alias >= I64{0}) -> _ := host_call(I64{3}, alias, I64{0}, I64{0})
    jet_rt_free(scratch, I64{128}, I64{8})
    fd_error(result, error)
}
#Export(c) jet_socket_unix_bind_raw: fn(state: I64, path: I64, error: I64) -> I64 {
    net_socket_unix_call(state, path, I64{49}, error)
}
#Export(c) jet_socket_unix_connect_raw: fn(state: I64, path: I64, error: I64) -> I64 {
    net_socket_unix_call(state, path, I64{42}, error)
}
