// (core.sys identity, facts and POSIX control). Each call is the Linux system
// call musl's function of the same name makes, with musl's result: -1 and the
// errno for a failure, else the call's value. initgroups alone still calls
// musl, which applies setgroups to every thread; its sample sets errno to 0
// first, calls, then reads errno, as jet_sys_call_sample does.
#Import(c) sys_initgroups: fn(user: I64, group: I64) -> I64 = "initgroups"

sys_errno_clear: fn() { net_store_uint(net_errno_location(), I64{4}, I64{0}) }

sys_errno: fn() -> I64 { net_i32(net_load_uint(net_errno_location(), I64{4})) }

// jet_sys_call_sample: (true, value, errno) as owned exact Ints.
sys_sample: fn(value: I64, available: I64, result: I64, errno: I64) {
    code: sys_errno()
    #Unsafe("the caller lends the C-ABI tuple's Bool byte and two writable Int words") {
        os_store_u8(available, I64{1})
        os_store_i64(result, jet_int_owned_from_i64(value))
        os_store_i64(errno, jet_int_owned_from_i64(code))
    }
}

sys_some: fn(some: I64, value: I64) -> I64 {
    #Unsafe("some lends a writable C-ABI Option success word") { os_store_i64(some, jet_int_owned_from_i64(value)) }
    I64{1}
}

// Unix identity calls cannot fail, so each is Some.
#Export(c) jet_sys_getppid_raw: fn(some: I64) -> I64 { sys_some(some, host_call(I64{110}, I64{0}, I64{0}, I64{0})) }
#Export(c) jet_sys_geteuid_raw: fn(some: I64) -> I64 { sys_some(some, host_call(I64{107}, I64{0}, I64{0}, I64{0})) }
#Export(c) jet_sys_getgid_raw: fn(some: I64) -> I64 { sys_some(some, host_call(I64{104}, I64{0}, I64{0}, I64{0})) }
#Export(c) jet_sys_getegid_raw: fn(some: I64) -> I64 { sys_some(some, host_call(I64{108}, I64{0}, I64{0}, I64{0})) }
#Export(c) jet_sys_getpgrp_raw: fn(some: I64) -> I64 { sys_some(some, host_call(I64{111}, I64{0}, I64{0}, I64{0})) }

// The Rust original getgroups(0, NULL): the count (or -1).
#Export(c) jet_sys_groups_count_raw: fn(some: I64) -> I64 { sys_some(some, sys_groups(I64{0}, I64{0})) }

// getgroups(size, list): the kernel's count, or -1.
sys_groups: fn(size: I64, list: I64) -> I64 {
    count: host_call(I64{115}, size, list, I64{0})
    if (count < I64{0}) -> I64{-1} else -> count
}

// Capacity is already checked against the nonnegative i32 range by Core. The
// List is [count, gid0..., gid(capacity-1)], every slot an owned exact Int;
// failure is never interpreted here.
#Export(c) jet_sys_groups_fill_raw: fn(capacity: I64, data_out: I64) -> I64 {
    native: jet_int_owned_to_i64(capacity)
    if (jet_scheduler_native_propagate() != I64{0}) -> return I64{0}
    // Eight bytes of slack keep the last u32 read inside the allocation.
    gids: jet_rt_alloc(native * I64{4} + I64{8}, I64{8})
    thread_zero(gids, native * I64{4} + I64{8})
    count: sys_groups(native, gids)
    length: native + I64{1}
    data: jet_rt_alloc(length * I64{8}, I64{8})
    trap_store(data, jet_int_owned_from_i64(count))
    at := I64{0}
    loop at < native {
        trap_store(wrapping(data + (at + I64{1}) * I64{8}), jet_int_owned_from_i64(net_load_uint(wrapping(gids + at * I64{4}), I64{4})))
        at += I64{1}
    }
    jet_rt_free(gids, native * I64{4} + I64{8}, I64{8})
    trap_store(data_out, data)
    length
}

// Pending stdout is drained first so the child never re-emits bytes the parent
// already printed (Rust's line writer holds none).
#Export(c) jet_sys_fork_raw: fn(available: I64, value: I64, errno: I64) {
    jet_rt_stdout_flush()
    host_sample_out(host_call(I64{57}, I64{0}, I64{0}, I64{0}), available, value, errno)
}

// The Rust original initgroups(user, group as u32); Core checked NUL absence.
#Export(c) jet_sys_initgroups_raw: fn(user: I64, group: I64, available: I64, value: I64, errno: I64) {
    native: jet_int_owned_to_i64(group)
    if (jet_scheduler_native_propagate() != I64{0}) -> return
    name: fd_c_path(user)
    sys_errno_clear()
    result: net_i32(sys_initgroups(name, native.bit_and(I64{4294967295})))
    fd_c_path_drop(name, user)
    sys_sample(result, available, value, errno)
}

// mkfifo(path, mode as u32): mknod(path, mode | S_IFIFO, 0).
#Export(c) jet_sys_mkfifo_raw: fn(path: I64, mode: I64, available: I64, value: I64, errno: I64) {
    native: jet_int_owned_to_i64(mode)
    if (jet_scheduler_native_propagate() != I64{0}) -> return
    name: fd_c_path(path)
    result: host_call(I64{133}, name, native.bit_and(I64{4294967295}).bit_or(I64{4096}), I64{0})
    fd_c_path_drop(name, path)
    host_sample_out(result, available, value, errno)
}

// getloadavg(avg, 3): (true, count, avg0, avg1, avg2). musl reads sysinfo's
// three loads, each a 16-bit binary fraction; the doubles cross as their raw
// f64 bits in the Float out slots. A host without sysinfo (the web) has no
// averages: count -1.
#Export(c) jet_sys_loadavg_raw: fn(available: I64, count: I64, first: I64, second: I64, third: I64) {
    info: jet_rt_alloc(I64{112}, I64{8})
    thread_zero(info, I64{112})
    result: host_call(I64{99}, info, I64{0}, I64{0})
    #Unsafe("info owns the initialized struct sysinfo; the caller lends the tuple's Bool byte, Int word and three Float words") {
        os_store_u8(available, I64{1})
        os_store_i64(count, jet_int_owned_from_i64(if (result < I64{0}) -> I64{-1} else -> I64{3}))
        os_store_i64(first, sys_load_bits(info, result, I64{8}))
        os_store_i64(second, sys_load_bits(info, result, I64{16}))
        os_store_i64(third, sys_load_bits(info, result, I64{24}))
    }
    jet_rt_free(info, I64{112}, I64{8})
}

// One sysinfo load (an unsigned long at `offset`) over 65536 as f64 bits; 0
// when sysinfo failed.
sys_load_bits: fn(info: I64, result: I64, offset: I64) -> I64 {
    if (result < I64{0}) -> return I64{0}
    load: trap_word(wrapping(info + offset))
    rt_f64_bits(Float{load} / Float{65536.0})
}

// utime(path, {actime, modtime}): utimensat(AT_FDCWD, path, {{actime, 0},
// {modtime, 0}}, 0).
#Export(c) jet_sys_utime_raw: fn(path: I64, atime: I64, mtime: I64, available: I64, value: I64, errno: I64) {
    access: jet_int_owned_to_i64(atime)
    if (jet_scheduler_native_propagate() != I64{0}) -> return
    modified: jet_int_owned_to_i64(mtime)
    if (jet_scheduler_native_propagate() != I64{0}) -> return
    times: jet_rt_alloc(I64{32}, I64{8})
    trap_store(times, access)
    trap_store(wrapping(times + I64{8}), I64{0})
    trap_store(wrapping(times + I64{16}), modified)
    trap_store(wrapping(times + I64{24}), I64{0})
    name: fd_c_path(path)
    result := I64{0}
    #Unsafe("utimensat borrows the NUL-terminated path and the two owned timespecs for the synchronous call") {
        result = os_syscall_i64(I64{280}, I64{-100}, name, times, I64{0}, I64{0}, I64{0})
    }
    fd_c_path_drop(name, path)
    jet_rt_free(times, I64{32}, I64{8})
    host_sample_out(result, available, value, errno)
}

// The Rust original times(&tms) and sysconf(_SC_CLK_TCK): (true, utime, stime,
// cutime, cstime, elapsed, ticks). musl's times is the raw system call and its
// _SC_CLK_TCK the constant 100.
#Export(c) jet_sys_times_raw: fn(available: I64, user: I64, system: I64, child_user: I64, child_system: I64, elapsed: I64, ticks: I64) {
    buffer: jet_rt_alloc(I64{32}, I64{8})
    thread_zero(buffer, I64{32})
    now: host_call(I64{100}, buffer, I64{0}, I64{0})
    #Unsafe("buffer owns an initialized struct tms; the caller lends the tuple's Bool byte and six Int words") {
        os_store_u8(available, I64{1})
        os_store_i64(user, jet_int_owned_from_i64(os_load_i64(buffer)))
        os_store_i64(system, jet_int_owned_from_i64(os_load_i64(wrapping(buffer + I64{8}))))
        os_store_i64(child_user, jet_int_owned_from_i64(os_load_i64(wrapping(buffer + I64{16}))))
        os_store_i64(child_system, jet_int_owned_from_i64(os_load_i64(wrapping(buffer + I64{24}))))
        os_store_i64(elapsed, jet_int_owned_from_i64(now))
        os_store_i64(ticks, jet_int_owned_from_i64(I64{100}))
    }
    jet_rt_free(buffer, I64{32}, I64{8})
}

// std::env::set_current_dir: a NUL byte is std's CString refusal; otherwise
// chdir and io::Error's Display of the errno.
#Export(c) jet_sys_set_current_dir_raw: fn(path: I64, error: I64) -> I64 {
    length: rt_text_len(path)
    at := I64{0}
    loop at < length {
        if (rt_text_byte(wrapping(rt_text_data(path) + at)) == I64{0}) {
            rt_text_store(error, jet_rt_string_clone(rt_static_text("file name contained an unexpected NUL byte")))
            return I64{0}
        }
        at += I64{1}
    }
    name: fd_c_path(path)
    result: host_call(I64{80}, name, I64{0}, I64{0})
    fd_c_path_drop(name, path)
    if (result < I64{0}) {
        rt_text_store(error, host_errno_cause(-result))
        return I64{0}
    }
    I64{1}
}

// core.sys.decode's Dotenv.file read: std::fs::read_to_string, taking no
// injected FS checkpoint. The error is (not_found, io::Error's Display); a
// NUL byte is std's CString refusal.
#Export(c) jet_sys_dotenv_read_raw: fn(path: I64, ok: I64, not_found: I64, cause: I64) -> I64 {
    rt_text_store(not_found, I64{0})
    if testing_has_nul(path) {
        rt_text_store(cause, jet_rt_string_clone(rt_static_text("file name contained an unexpected NUL byte")))
        return I64{0}
    }
    out: jet_rt_alloc(I64{8}, I64{8})
    status: env_read_file(path, out)
    value: rt_text_word(out)
    jet_rt_free(out, I64{8}, I64{8})
    if (status == I64{1}) {
        rt_text_store(ok, value)
        return I64{1}
    }
    if (status == I64{0}) {
        rt_text_store(not_found, I64{1})
        rt_text_store(cause, host_errno_cause(I64{2}))
        return I64{0}
    }
    rt_text_store(cause, value)
    I64{0}
}

// std::env::var_os(name).into_encoded_bytes(): the process environment (the
// logical overlay never writes it). musl getenv finds no name holding '=' (or
// empty); std refuses an interior NUL as absent.
#Export(c) jet_sys_host_env_raw: fn(name: I64, data_out: I64, length_out: I64) -> I64 {
    rt_test_reads_text(I64{69}, name)
    host_arguments_require()
    length: rt_text_len(name)
    if (length == I64{0}) -> return I64{0}
    at := I64{0}
    loop at < length {
        byte: rt_text_byte(wrapping(rt_text_data(name) + at))
        if (byte == I64{0} || byte == I64{61}) -> return I64{0}
        at += I64{1}
    }
    value: host_environment_value_bytes(rt_text_data(name), length)
    if (value == I64{0}) -> return I64{0}
    size: host_startup_byte_length(value)
    rt_text_store(data_out, host_startup_bytes(value, size))
    rt_text_store(length_out, size)
    I64{1}
}
