// NetHTTP.rs:278-291,621-624; CAbiRoutes.rs:3411-3415,6351-6353.
// Native112: id0, owned FD72*8, readpresent16/readms24, writepresent32/ms40,
// borrowed callbacks wants48/readReady56/read64/write72/close80/closeWrite88/
// peerSnapshot96, nullable owned PeerIdentity176*104. No Rust layouts.
// Drop follows declaration order: TcpStream then peer_identity. There is no
// seed Drop hook calling the TLS close callback; callbacks are never owners.
// Canonical FD release: HostFiles.jet (047fb460b), jet_fd_drop_raw.
TLS_STREAM_BYTES :: I64{112}
#Export(c) fn jet_rt_handle_drop_jet_tls_stream(value: I64) {
    if (value == I64{0}) -> return
    jet_fd_drop_raw(rt_text_word(value + I64{8}))
    jet_rt_handle_drop_jet_tls_peer_identity(rt_text_word(value + I64{104}))
    jet_rt_free(value, TLS_STREAM_BYTES, I64{8})
}
#Export(c) fn jet_rt_handle_show_jet_tls_stream(value: I64) -> I64 {
    target :: jet_rt_string_builder_new()
    rt_text_push_word(target, I64{7018141438266526804}, I64{8}) // TLSStrea
    rt_text_push_word(target, I64{10349}, I64{2}) // m(
    rt_text_push_number(target, rt_text_word(value))
    rt_text_push_word(target, I64{41}, I64{1})
    jet_rt_string_builder_finish(target)
}
