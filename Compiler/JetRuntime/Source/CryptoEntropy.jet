// D-CRYPTO-RNG1 / D-TESTFAULT1 card #4827: ONE Rand adapter.
// CryptoEntropy.rs:184-232; Linux x86-64 only, as the native runtime target.
// out exclusively borrows count initialized writable bytes. No allocation/copy
// on production fills. Short reads continue on the suffix; EINTR wipes just
// that suffix and retries. All other failures wipe the entire attempted span.
// The private native harness owns callback/context lifetime until clear; each
// OS thread owns its adapter state. The destructor also clears on thread exit.
crypto_entropy_key := I64{0}

fn rt_crypto_entropy_drop_address() -> I64 {
    loop { jet_rt_unreachable(I64{0}, I64{0}) }
}
// runtime-init: 3
#Export(c) fn jet_rt_crypto_entropy_init() {
    if (crypto_entropy_key != I64{0}) -> return
    closure :: jet_rt_alloc(I64{24}, I64{8})
    rt_text_store(closure, I64{1})
    rt_text_store(closure + I64{8}, rt_crypto_entropy_drop_address())
    rt_text_store(closure + I64{16}, I64{0})
    crypto_entropy_key = jet_rt_tls_key_new(closure)
}
#Export(c) fn jet_rt_crypto_entropy_drop(_closure: I64, state: I64) -> I64 {
    rt_crypto_wipe(state, I64{16})
    jet_rt_free(state, I64{16}, I64{8})
    return I64{0}
}
fn rt_crypto_entropy_clear() {
    if (crypto_entropy_key == I64{0}) -> return
    state :: jet_rt_tls_get(crypto_entropy_key)
    if (state == I64{0}) -> return
    jet_rt_tls_set(crypto_entropy_key, I64{0})
    _ := jet_rt_crypto_entropy_drop(I64{0}, state)
}
// Internal test/fault adapter installation, not a Core API. The callback ABI is
// (context, suffix, remaining)->I64: >0 Filled(n), -4 Interrupted, else Failed.
// A callback of zero resets to the real provider. No second Rand hook exists.
fn rt_crypto_entropy_set(callback: I64, context: I64) {
    rt_crypto_entropy_clear()
    if (callback == I64{0}) -> return
    state :: jet_rt_alloc(I64{16}, I64{8})
    rt_text_store(state, callback)
    rt_text_store(state + I64{8}, context)
    jet_rt_tls_set(crypto_entropy_key, state)
}
fn rt_crypto_entropy_step(out: I64, count: I64) -> I64 {
    if (crypto_entropy_key != I64{0}) {
        state :: jet_rt_tls_get(crypto_entropy_key)
        if (state != I64{0}) {
            #Unsafe("the test/fault harness owns the synchronous callback and context until reset; the callback borrows only this writable suffix") {
                return os_call3_i64(rt_text_word(state), rt_text_word(state + I64{8}), out, count)
            }
        }
    }
    #Unsafe("Linux getrandom flags0 writes only the exclusively borrowed writable span and retains no address; kernel negative errno is preserved") {
        return os_syscall_i64(I64{318}, out, count, I64{0}, I64{0}, I64{0}, I64{0})
    }
}
fn rt_crypto_entropy_fill(out: I64, count: I64) -> I64 {
    // Bounds belong to Core too; this raw ABI rejects invalid spans before
    // dereference. An invalid count has no valid borrowed span to wipe.
    if (count < I64{0} || count > I64{1048576}) -> return I64{1}
    if (count == I64{0}) -> return I64{0}
    filled := I64{0}
    loop filled < count {
        n :: rt_crypto_entropy_step(out + filled, count - filled)
        if (n > I64{0} && n <= count - filled) {
            filled += n
        } else if (n == I64{-4}) {
            rt_crypto_wipe(out + filled, count - filled)
        } else {
            rt_crypto_wipe(out, count)
            return I64{1}
        }
    }
    return I64{0}
}

// Core.__zeroize consumes the bytes; this C ABI borrows the marshaller's live
// initialized payload. Wipe that payload itself, not a staging copy. The
// marshaller retains ownership and is solely responsible for later release.
// Capacity slack is not represented by (ptr,len) and belongs to its owner.
#Export(c) fn jet_crypto_zeroize(bytes: I64, length: I64) {
    rt_crypto_wipe(bytes, wrapping(length * RT_HOST_U8_STRIDE))
}

// CAbiRoutes:15924 Option<List<U8>> transfers payload pointer/count on Some;
// None leaves both out slots untouched. No list header crosses this boundary.
#Export(c) fn jet_random_os_entropy(count: I64, some: I64, some_len: I64) -> I64 {
    jet_rt_world_reject_uncontrolled(I64{3})
    if (jet_scheduler_native_propagate() != I64{0}) -> return I64{0}
    if (count < I64{0} || count > I64{1048576}) -> return I64{0}
    if (count == I64{0}) {
        rt_text_store(some, I64{0})
        rt_text_store(some_len, I64{0})
        return I64{1}
    }
    capacity :: count * RT_HOST_U8_STRIDE
    bytes :: jet_rt_alloc(capacity, I64{8})
    if (rt_crypto_entropy_fill(bytes, count) != I64{0}) {
        rt_crypto_wipe(bytes, capacity)
        jet_rt_free(bytes, capacity, I64{8})
        return I64{0}
    }
    // The provider filled packed bytes in the FINAL allocation. Widen from the
    // end so padding initialization cannot overwrite a byte not yet consumed.
    if (RT_HOST_U8_STRIDE != I64{1}) {
        at := count
        loop at > (I64{0}) {
            at -= I64{1}
            host_u8_put(bytes, at, rt_text_byte(bytes + at))
        }
    }
    rt_text_store(some, bytes)
    rt_text_store(some_len, count)
    I64{1}
}
