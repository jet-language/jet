// `.memory_scope(bytes)`: the child and every process it starts run in a
// cgroup v2 scope of their own, capped at `bytes` (memory.max, no swap, and
// memory.oom.group, so an overrun kills the whole scope, never this process).
// The scope is made next to this process's own cgroup, so its parent must be
// writable and have the memory controller, as a systemd user session's
// app.slice has. The child runs in the scope's `main` leaf, and the scope
// hands the memory controller to its children, so a Jet program inside it
// that asks for a memory_scope of its own gets one inside this scope, under
// this cap. At the reap the scope's memory.peak is the receipt's peak; then
// every process still in it is killed (cgroup.kill) and the scope removed.
// O_WRONLY|O_CLOEXEC and O_RDONLY|O_CLOEXEC.
PROCESS_SCOPE_WRITE: I64{524289}
PROCESS_SCOPE_READ: I64{524288}
// How long the removal waits for killed processes to exit: 10000 tries 1 ms
// apart. A process stuck in uninterruptible sleep past that keeps the scope.
PROCESS_SCOPE_DRAIN_TRIES: I64{10000}
PROCESS_SCOPE_DRAIN_NS: I64{1000000}

// A cgroup interface file (or /proc file) as an owned text, or 0.
process_scope_read: fn(path: I64) -> I64 {
    name: fd_c_path(path)
    file := I64{-4}
    loop file == (I64{-4}) -> file = host_call(I64{2}, name, PROCESS_SCOPE_READ, I64{0})
    fd_c_path_drop(name, path)
    if (file < I64{0}) -> return I64{0}
    scratch: jet_rt_alloc(I64{4096}, I64{1})
    text: jet_rt_string_builder_new()
    good := true
    loop {
        count: host_call(I64{0}, file, scratch, I64{4096})
        if (count == I64{-4}) -> next
        if (count <= I64{0}) {
            good = count == I64{0}
            break
        }
        rt_text_append(text, scratch, count)
    }
    spawn_close(file)
    jet_rt_free(scratch, I64{4096}, I64{1})
    result: jet_rt_string_builder_finish(text)
    if good -> return result
    jet_rt_string_drop(result)
    I64{0}
}

// Writes `value` to `dir` + `file`: 0, or -errno.
process_scope_write: fn(dir: I64, file: I64, value: I64) -> I64 {
    path: scheduler_text_concat(dir, file)
    name: fd_c_path(path)
    fd := I64{-4}
    loop fd == (I64{-4}) -> fd = host_call(I64{2}, name, PROCESS_SCOPE_WRITE, I64{0})
    fd_c_path_drop(name, path)
    jet_rt_string_drop(path)
    if (fd < I64{0}) -> return fd
    written := I64{-4}
    loop written == (I64{-4}) -> written = host_call(I64{1}, fd, rt_text_data(value), rt_text_len(value))
    spawn_close(fd)
    if (written < I64{0}) -> written else -> I64{0}
}

// mkdir `dir` + `leaf` (0755): 0, or -errno.
process_scope_mkdir: fn(dir: I64, leaf: I64) -> I64 {
    path: scheduler_text_concat(dir, leaf)
    name: fd_c_path(path)
    made: host_call(I64{83}, name, I64{493}, I64{0})
    fd_c_path_drop(name, path)
    jet_rt_string_drop(path)
    made
}

// The cgroup this process's scope goes next to: the parent of its own
// cgroup v2 path (the `0::` row of /proc/self/cgroup), under /sys/fs/cgroup,
// as an owned text; 0 when the row is missing.
process_scope_parent: fn() -> I64 {
    rows: process_scope_read(rt_static_text("/proc/self/cgroup"))
    if (rows == I64{0}) -> return I64{0}
    at := I64{0}
    found := I64{-1}
    loop at < rt_text_len(rows) {
        if (rt_text_find(rows, rt_static_text("0::"), at, false) == at) {
            found = at + I64{3}
            break
        }
        next_row: rt_text_find(rows, rt_static_text("\n"), at, false)
        if (next_row < I64{0}) -> break
        at = next_row + I64{1}
    }
    if (found < I64{0}) {
        jet_rt_string_drop(rows)
        return I64{0}
    }
    end := rt_text_find(rows, rt_static_text("\n"), found, false)
    if (end < I64{0}) -> end = rt_text_len(rows)
    // The parent: everything before the path's last `/`.
    slash: rt_text_find_byte(rt_text_data(rows), end, I64{47}, found, true)
    cut: if (slash < found) -> found else -> slash
    text: jet_rt_string_builder_new()
    jet_rt_string_builder_push(text, rt_static_text("/sys/fs/cgroup"))
    rt_text_append(text, wrapping(rt_text_data(rows) + found), cut - found)
    jet_rt_string_drop(rows)
    jet_rt_string_builder_finish(text)
}

// Makes a scope capped at `bytes` and opens its main leaf's cgroup.procs, which
// the child writes "0" to before exec. The scope directory as an owned text,
// with the descriptor in `procs`; on failure 0, with -errno in `procs` and the
// path that failed (owned) in `failed`.
process_scope_open: fn(bytes: I64, procs: I64, failed: I64) -> I64 {
    fd_put(procs, I64{0}, I64{-2})
    fd_put(failed, I64{0}, I64{0})
    parent: process_scope_parent()
    if (parent == I64{0}) {
        fd_put(failed, I64{0}, jet_rt_string_clone(rt_static_text("/proc/self/cgroup")))
        return I64{0}
    }
    name: jet_rt_string_builder_new()
    jet_rt_string_builder_push(name, parent)
    jet_rt_string_builder_push(name, rt_static_text("/jet-scope-"))
    rt_text_push_number(name, host_call(I64{39}, I64{0}, I64{0}, I64{0}))
    jet_rt_string_builder_push(name, rt_static_text("-"))
    rt_text_push_number(name, sync_now_ns())
    dir: jet_rt_string_builder_finish(name)
    made: process_scope_mkdir(dir, rt_static_text(""))
    if (made < I64{0}) {
        fd_put(procs, I64{0}, made)
        fd_put(failed, I64{0}, parent)
        jet_rt_string_drop(dir)
        return I64{0}
    }
    jet_rt_string_drop(parent)
    limit: jet_rt_string_builder_new()
    rt_text_push_number(limit, bytes)
    max: jet_rt_string_builder_finish(limit)
    step := rt_static_text("/memory.max")
    result := process_scope_write(dir, step, max)
    jet_rt_string_drop(max)
    // No swap file to cap means no swap accounting: nothing to turn off.
    if (result == I64{0}) {
        step = rt_static_text("/memory.swap.max")
        result = process_scope_write(dir, step, rt_static_text("0"))
        if (result == I64{-2}) -> result = I64{0}
    }
    if (result == I64{0}) {
        step = rt_static_text("/memory.oom.group")
        result = process_scope_write(dir, step, rt_static_text("1"))
    }
    if (result == I64{0}) {
        step = rt_static_text("/cgroup.subtree_control")
        result = process_scope_write(dir, step, rt_static_text("+memory"))
    }
    if (result == I64{0}) {
        step = rt_static_text("/main")
        result = process_scope_mkdir(dir, step)
    }
    if (result == I64{0}) {
        step = rt_static_text("/main/cgroup.procs")
        path: scheduler_text_concat(dir, step)
        c_path: fd_c_path(path)
        fd := I64{-4}
        loop fd == (I64{-4}) -> fd = host_call(I64{2}, c_path, PROCESS_SCOPE_WRITE, I64{0})
        fd_c_path_drop(c_path, path)
        jet_rt_string_drop(path)
        if (fd >= I64{0}) {
            fd_put(procs, I64{0}, fd)
            return dir
        }
        result = fd
    }
    fd_put(procs, I64{0}, result)
    fd_put(failed, I64{0}, scheduler_text_concat(dir, step))
    process_scope_remove(dir)
    jet_rt_string_drop(dir)
    I64{0}
}

// rmdir `name` under `parent` after every cgroup below it, depth first; the
// interface files go with their directory. 0, or -errno (EBUSY while a
// process is still in it).
process_scope_remove_tree: fn(parent: I64, name: I64) -> I64 {
    fd := I64{-4}
    loop fd == (I64{-4}) -> fd = host_call(I64{257}, parent, name, FILES_TREE_OPEN)
    if (fd == I64{-2}) -> return I64{0}
    if (fd < I64{0}) -> return fd
    buffer: jet_rt_alloc(FILES_DIRENT_BYTES, I64{8})
    failure := I64{0}
    loop failure == (I64{0}) {
        count: host_call(I64{217}, fd, buffer, FILES_DIRENT_BYTES)
        if (count == I64{-4}) -> next
        if (count == I64{0} || count == I64{-2}) -> break
        if (count < I64{0}) {
            failure = count
            break
        }
        at := I64{0}
        loop at < count {
            record: wrapping(buffer + at)
            at += rt_text_byte(wrapping(record + I64{16})).bit_or((rt_text_byte(wrapping(record + I64{17})) << I64{8}))
            entry: wrapping(record + I64{19})
            if files_dot_entry(entry) -> next
            if (rt_text_byte(wrapping(record + I64{18})) != I64{4}) -> next
            result: process_scope_remove_tree(fd, entry)
            if (result < I64{0}) {
                failure = result
                break
            }
        }
    }
    jet_rt_free(buffer, FILES_DIRENT_BYTES, I64{8})
    spawn_close(fd)
    if (failure < I64{0}) -> return failure
    removed: host_call(I64{263}, parent, name, I64{512})
    if (removed < I64{0} && removed != I64{-2}) -> removed else -> I64{0}
}

// Kills every process left in the scope, waits for them to exit, and removes
// the scope with every cgroup a nested Jet process left inside it.
process_scope_remove: fn(dir: I64) {
    _ := process_scope_write(dir, rt_static_text("/cgroup.kill"), rt_static_text("1"))
    name: fd_c_path(dir)
    tries := I64{0}
    loop {
        removed: process_scope_remove_tree(FILES_AT_FDCWD, name)
        if (removed != I64{-16} || tries >= PROCESS_SCOPE_DRAIN_TRIES) -> break
        fs_lock_sleep(PROCESS_SCOPE_DRAIN_NS)
        tries += I64{1}
    }
    fd_c_path_drop(name, dir)
}

// The scope's memory.peak in bytes, or -1.
process_scope_peak: fn(dir: I64) -> I64 {
    path: scheduler_text_concat(dir, rt_static_text("/memory.peak"))
    text: process_scope_read(path)
    jet_rt_string_drop(path)
    if (text == I64{0}) -> return I64{-1}
    value := I64{0}
    digits := I64{0}
    loop digits < rt_text_len(text) {
        byte: rt_text_byte(wrapping(rt_text_data(text) + digits))
        if (byte < I64{48} || byte > I64{57}) -> break
        value = value * I64{10} + (byte - I64{48})
        digits += I64{1}
    }
    jet_rt_string_drop(text)
    if (digits == I64{0}) -> I64{-1} else -> value
}
