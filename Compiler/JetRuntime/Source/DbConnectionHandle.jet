// HandlesRaylib.rs:25-35, CAbiRoutes.rs:1533-1537. The seed wrapper holds
// only a u64 backend ID and has no Drop implementation: close is explicit.
// Releasing the wrapper must not invent a database-close or resource callback.
#Export(c) fn jet_rt_handle_drop_jet_db_connection(value: I64) {
    if (value != I64{0}) -> jet_rt_free(value, I64{8}, I64{8})
}
