// core.game.raylib on the static native runtime: CoreLib/Top/HandlesRaylib.rs
// :744-1065 with jet_raylib_api() == None. The display bridge dlopens
// libraylib (HandlesRaylib.rs:664-735), which a static musl executable cannot
// do, so windows are never native, input is inert and sticks read 0. Drawing
// is real: Core scan-converts every primitive into clipped runs and this file
// owns the RGBA canvas they paint and the decoded textures sprites blit from.
// Atlas metadata is the shared Core/Raylib.rs:67-147 parse. Carriers are
// UiRaylibMetadata.jet's RaylibWindow32/RaylibTextureAtlas64/Region40.

// Each leaf narrows its exact-Int words as the C adapter does before the call.
fn raylib_words(a: I64, b: I64, c: I64, d: I64) -> Bool {
    _ := jet_int_owned_to_i64(a)
    _ := jet_int_owned_to_i64(b)
    _ := jet_int_owned_to_i64(c)
    _ := jet_int_owned_to_i64(d)
    jet_scheduler_native_propagate() == I64{0}
}

#Export(c) fn jet_raylib_window_open(width: I64, height: I64, title: I64) -> I64 {
    native_width :: jet_int_owned_to_i64(width)
    native_height :: jet_int_owned_to_i64(height)
    if (jet_scheduler_native_propagate() != I64{0}) -> return I64{0}
    ui_raylib_window_new(native_width, native_height, title, I64{0})
}
#Export(c) fn jet_raylib_window_should_close(_window: I64) -> Bool { true }
#Export(c) fn jet_raylib_window_ready(window: I64) -> Bool { ui_carrier_bool(wrapping(window + UI_RAYLIB_WINDOW_NATIVE)) != I64{0} }

// The software canvas: row-major RGBA8, width * height * 4 bytes, zeroed when
// begin_drawing (re)sizes it to the window and kept across same-size frames.
// Drawing is single-threaded, as in raylib's own context.
RAYLIB_CANVAS_SIDE_MAX :: I64{16384}
raylib_canvas_pixels := I64{0}
raylib_canvas_width := I64{0}
raylib_canvas_height := I64{0}

fn raylib_canvas_side(value: I64) -> I64 {
    if (value < I64{0}) -> return I64{0}
    if (value > RAYLIB_CANVAS_SIDE_MAX) -> return RAYLIB_CANVAS_SIDE_MAX
    value
}

#Export(c) fn jet_raylib_begin_drawing(window: I64) {
    width :: raylib_canvas_side(ui_carrier_word(wrapping(window + UI_RAYLIB_WINDOW_WIDTH)))
    height :: raylib_canvas_side(ui_carrier_word(wrapping(window + UI_RAYLIB_WINDOW_HEIGHT)))
    if (width == raylib_canvas_width && height == raylib_canvas_height) -> return
    if (raylib_canvas_pixels != I64{0}) -> jet_rt_free(raylib_canvas_pixels, raylib_canvas_width * raylib_canvas_height * I64{4}, I64{1})
    #Unsafe("the raylib canvas belongs to the one thread that drives the window") {
        raylib_canvas_pixels = I64{0}
    }
    bytes :: width * height * I64{4}
    if (bytes != I64{0}) {
        #Unsafe("the raylib canvas belongs to the one thread that drives the window") {
            raylib_canvas_pixels = jet_rt_alloc(bytes, I64{1})
        }
        coll_zero(raylib_canvas_pixels, bytes)
    }
    #Unsafe("the raylib canvas belongs to the one thread that drives the window") {
        raylib_canvas_width = width
        raylib_canvas_height = height
    }
}

// Both sides fit 16 bits, so one word carries width << 16 | height.
#Export(c) fn jet_raylib_canvas_extent() -> I64 {
    jet_int_owned_from_i64((raylib_canvas_width << I64{16}).bit_or(raylib_canvas_height))
}

// One run of 0xRRGGBBAA. A replace copies the color (ClearBackground);
// otherwise every channel, alpha included, blends src-over with rounding:
// (src * a + dst * (255 - a) + 127) / 255, raylib's BLEND_ALPHA. The run is
// clipped again here; the canvas never trusts its caller with its bounds.
// A run that spans whole canvas rows is one contiguous span, so a clear is
// one bulk fill.
#Export(c) fn jet_raylib_fill_rect(x: I64, y: I64, width: I64, height: I64, rgba: I64, replace: Bool) {
    if (raylib_inline_sign(x).bit_or(raylib_inline_sign(y)).bit_or(raylib_inline_sign(width)).bit_or(raylib_inline_sign(height)).bit_or(raylib_inline_sign(rgba)) >= I64{0}) {
        raylib_fill(x, y, width, height, rgba, replace)
        return
    }
    left :: raylib_native(x)
    top :: raylib_native(y)
    run_width :: raylib_native(width)
    run_height :: raylib_native(height)
    color :: raylib_native(rgba)
    if (jet_scheduler_native_propagate() != I64{0}) -> return
    raylib_fill(left, top, run_width, run_height, color, replace)
}

// A 1-bit glyph mask in one call: bit 8 * c + r (c < 7, r < 8) paints the
// scale x scale cell at (x + c * scale, y + r * scale). Each column's set
// rows paint as one run per stretch, top to bottom, blended as
// jet_raylib_fill_rect blends. A scale below 1 or above 2^32 paints nothing,
// and so does a pen beyond the inline Int range, which no cell can bring
// back onto a canvas; within those bounds no cell offset overflows.
#Export(c) fn jet_raylib_fill_mask(x: I64, y: I64, scale: I64, mask: I64, rgba: I64) {
    bits :: raylib_native(mask)
    color :: raylib_native(rgba)
    if (!(int_inline(mask) && int_inline(rgba)) && jet_scheduler_native_propagate() != I64{0}) -> return
    if (!(int_inline(x) && int_inline(y) && int_inline(scale)) || scale < I64{1} || scale > RAYLIB_MASK_CELL_MAX) -> return
    column := I64{0}
    loop column < (I64{7}) {
        rows := (bits >> (column * I64{8})).bit_and(I64{255})
        row := I64{0}
        loop rows != (I64{0}) {
            if (rows.bit_and(I64{1}) == I64{0}) {
                rows = rows >> I64{1}
                row += I64{1}
                next
            }
            start :: row
            loop rows.bit_and(I64{1}) != (I64{0}) {
                rows = rows >> I64{1}
                row += I64{1}
            }
            raylib_fill(x + column * scale, y + start * scale, scale, (row - start) * scale, color, false)
        }
        column += I64{1}
    }
}

RAYLIB_MASK_CELL_MAX :: I64{4294967296}

// An inline Int is its own machine word; only a big node takes the call,
// which may raise a stop the caller then propagates.
fn raylib_native(value: I64) -> I64 {
    if int_inline(value) -> return value
    jet_int_owned_to_i64(value)
}

// Negative exactly when `value` is not an inline Int: bits 63 and 62 of an
// inline one agree, so one sign test covers several values or-ed together.
fn raylib_inline_sign(value: I64) -> I64 {
    value.bit_xor(value << I64{1})
}

// No sum or product below can overflow: a clipped corner lies on the canvas
// (each side at most 16384), and left + run_width is taken only when left is
// negative or the sum stays within the canvas width (likewise for top). One
// test per early return keeps each a single compare and branch.
fn raylib_fill(left: I64, top: I64, run_width: I64, run_height: I64, color: I64, replace: Bool) {
    alpha :: color.bit_and(I64{255})
    pixels :: raylib_canvas_pixels
    canvas_width :: raylib_canvas_width
    canvas_height :: raylib_canvas_height
    if (pixels == I64{0}) -> return
    if (run_width <= I64{0}) -> return
    if (run_height <= I64{0}) -> return
    opaque := replace
    if (alpha == I64{255}) {
        opaque = true
    }
    if (alpha == I64{0}) {
        if (!replace) -> return
    }
    x0 := left
    x1 := canvas_width
    if (left < I64{0}) {
        x0 = I64{0}
        x1 = raylib_canvas_side_min(wrapping(left + run_width), canvas_width)
    } else {
        if (left >= canvas_width) -> return
        if (run_width < canvas_width - left) {
            x1 = wrapping(left + run_width)
        }
    }
    y0 := top
    y1 := canvas_height
    if (top < I64{0}) {
        y0 = I64{0}
        y1 = raylib_canvas_side_min(wrapping(top + run_height), canvas_height)
    } else {
        if (top >= canvas_height) -> return
        if (run_height < canvas_height - top) {
            y1 = wrapping(top + run_height)
        }
    }
    if (x1 <= x0) -> return
    if (y1 <= y0) -> return
    span := wrapping(x1 - x0)
    rows := wrapping(y1 - y0)
    if (x0 == I64{0}) {
        if (x1 == canvas_width) {
            span = wrapping(rows * canvas_width)
            rows = I64{1}
        }
    }
    stride :: wrapping(canvas_width * I64{4})
    at :: wrapping(pixels + wrapping(wrapping(wrapping(y0 * canvas_width) + x0) * I64{4}))
    stop :: wrapping(at + wrapping(rows * stride))
    if (opaque) {
        word :: raylib_canvas_word(color)
        raylib_fill_rows(at, stop, stride, span, word.bit_or(word << I64{32}))
        return
    }
    // The blend runs on 16-bit lanes: low lanes carry red and blue, high
    // lanes green and alpha, each source term premultiplied with its +128.
    red :: (color >> I64{24}).bit_and(I64{255})
    green :: (color >> I64{16}).bit_and(I64{255})
    blue :: (color >> I64{8}).bit_and(I64{255})
    low :: (red * alpha + I64{128}).bit_or((blue * alpha + I64{128}) << I64{16})
    high :: (green * alpha + I64{128}).bit_or((alpha * alpha + I64{128}) << I64{16})
    raylib_blend_rows(at, stop, stride, span, low.bit_or(low << I64{32}), high.bit_or(high << I64{32}), I64{255} - alpha)
}

fn raylib_canvas_side_min(a: I64, b: I64) -> I64 {
    if (a < b) -> return a
    b
}

// A pixel's bytes R, G, B, A as one little-endian 32-bit word.
fn raylib_canvas_word(color: I64) -> I64 {
    (color >> I64{24}).bit_and(I64{255}).bit_or((color >> I64{8}).bit_and(I64{65280})).bit_or((color << I64{8}).bit_and(I64{16711680})).bit_or((color << I64{24}).bit_and(I64{4278190080}))
}

// Paint count pixels from each row start in [at, stop), stride bytes apart,
// with one word, two pixels per store. An odd count ends with a store
// overlapping the previous pair, which writes the same bytes again. A row of
// at most 16 pixels is straight-line stores from both ends, overlapping in
// the middle. A long row is one string store, which outruns the store loop
// past its startup.
RAYLIB_STRING_FILL :: I64{256}
RAYLIB_SHORT_FILL :: I64{16}

fn raylib_fill_rows(at: I64, stop: I64, stride: I64, count: I64, pair: I64) {
    #Unsafe("each row start in [at, stop) lends count writable canvas pixels of four bytes each, inside the live canvas") {
        row := at
        if (count == I64{1}) {
            loop row < stop {
                os_store_u8(row, pair.bit_and(I64{255}))
                os_store_u8(wrapping(row + I64{1}), (pair >> I64{8}).bit_and(I64{255}))
                os_store_u8(wrapping(row + I64{2}), (pair >> I64{16}).bit_and(I64{255}))
                os_store_u8(wrapping(row + I64{3}), (pair >> I64{24}).bit_and(I64{255}))
                row = wrapping(row + stride)
            }
            return
        }
        tail :: count * I64{4} - I64{8}
        if (count <= RAYLIB_SHORT_FILL) {
            raylib_fill_short_rows(at, stop, stride, tail, pair)
            return
        }
        if (count >= RAYLIB_STRING_FILL) {
            words :: count >> I64{1}
            loop row < stop {
                os_fill_words_i64(row, pair, words)
                os_store_i64(wrapping(row + tail), pair)
                row = wrapping(row + stride)
            }
            return
        }
        loop row < stop {
            last :: wrapping(row + tail)
            block_last :: wrapping(last - I64{24})
            cursor := row
            loop cursor < block_last {
                os_store_i64(cursor, pair)
                os_store_i64(wrapping(cursor + I64{8}), pair)
                os_store_i64(wrapping(cursor + I64{16}), pair)
                os_store_i64(wrapping(cursor + I64{24}), pair)
                cursor = wrapping(cursor + I64{32})
            }
            loop cursor < last {
                os_store_i64(cursor, pair)
                cursor = wrapping(cursor + I64{8})
            }
            os_store_i64(last, pair)
            row = wrapping(row + stride)
        }
    }
}

// Rows of 2 to 16 pixels: the last store sits at tail bytes, 0 to 56.
fn raylib_fill_short_rows(at: I64, stop: I64, stride: I64, tail: I64, pair: I64) {
    #Unsafe("each row start in [at, stop) lends tail + 8 writable canvas bytes, inside the live canvas") {
        row := at
        if (tail >= I64{24}) {
            back :: tail - I64{24}
            loop row < stop {
                os_store_i64(row, pair)
                os_store_i64(wrapping(row + I64{8}), pair)
                os_store_i64(wrapping(row + I64{16}), pair)
                os_store_i64(wrapping(row + I64{24}), pair)
                end :: wrapping(row + back)
                os_store_i64(end, pair)
                os_store_i64(wrapping(end + I64{8}), pair)
                os_store_i64(wrapping(end + I64{16}), pair)
                os_store_i64(wrapping(end + I64{24}), pair)
                row = wrapping(row + stride)
            }
            return
        }
        if (tail >= I64{8}) {
            back :: tail - I64{8}
            loop row < stop {
                os_store_i64(row, pair)
                os_store_i64(wrapping(row + I64{8}), pair)
                end :: wrapping(row + back)
                os_store_i64(end, pair)
                os_store_i64(wrapping(end + I64{8}), pair)
                row = wrapping(row + stride)
            }
            return
        }
        loop row < stop {
            os_store_i64(row, pair)
            os_store_i64(wrapping(row + tail), pair)
            row = wrapping(row + stride)
        }
    }
}

RAYLIB_LANES :: I64{0x00FF00FF00FF00FF}
// RAYLIB_LANES << 8, 0xFF00FF00FF00FF00.
RAYLIB_LANES_HIGH :: I64{-71777214294589696}

// Blend count pixels in place from each row start in [at, stop), stride
// bytes apart, two pixels per 64-bit word. Each 16-bit lane holds
// y = s * a + 128 + d * (255 - a) <= 65153, and (y + (y >> 8)) >> 8 is
// exactly (y - 1) / 255, the rounded s * a + d * (255 - a) over 255, over
// that range, so no lane carries into the next.
fn raylib_blend_rows(at: I64, stop: I64, stride: I64, count: I64, source_low: I64, source_high: I64, keep: I64) {
    #Unsafe("each row start in [at, stop) lends count readable and writable canvas pixels of four bytes each, inside the live canvas") {
        pairs :: (count - count.bit_and(I64{1})) * I64{4}
        odd :: count.bit_and(I64{1}) != I64{0}
        row := at
        loop row < stop {
            last :: wrapping(row + pairs)
            cursor := row
            loop cursor < last {
                os_store_i64(cursor, raylib_blend_word(os_load_i64(cursor), source_low, source_high, keep))
                cursor = wrapping(cursor + I64{8})
            }
            if (odd) {
                word :: os_load_u8(cursor).bit_or(os_load_u8(wrapping(cursor + I64{1})) << I64{8}).bit_or(os_load_u8(wrapping(cursor + I64{2})) << I64{16}).bit_or(os_load_u8(wrapping(cursor + I64{3})) << I64{24})
                blended :: raylib_blend_word(word, source_low, source_high, keep)
                os_store_u8(cursor, blended.bit_and(I64{255}))
                os_store_u8(wrapping(cursor + I64{1}), (blended >> I64{8}).bit_and(I64{255}))
                os_store_u8(wrapping(cursor + I64{2}), (blended >> I64{16}).bit_and(I64{255}))
                os_store_u8(wrapping(cursor + I64{3}), (blended >> I64{24}).bit_and(I64{255}))
            }
            row = wrapping(row + stride)
        }
    }
}

fn raylib_blend_word(word: I64, source_low: I64, source_high: I64, keep: I64) -> I64 {
    low :: wrapping(wrapping(word.bit_and(RAYLIB_LANES) * keep) + source_low)
    high :: wrapping(wrapping((word >> I64{8}).bit_and(RAYLIB_LANES) * keep) + source_high)
    low_quotient :: (wrapping(low + (low >> I64{8}).bit_and(RAYLIB_LANES)) >> I64{8}).bit_and(RAYLIB_LANES)
    // The high quotients land in place: (q >> 8) << 8 keeps each lane's top byte.
    high_quotient :: wrapping(high + (high >> I64{8}).bit_and(RAYLIB_LANES)).bit_and(RAYLIB_LANES_HIGH)
    low_quotient.bit_or(high_quotient)
}

// One channel src-over with rounding, for sprite pixels whose source varies.
fn raylib_blend(source: I64, target: I64, alpha: I64) -> I64 {
    (source * alpha + target * (I64{255} - alpha) + I64{127}) /% I64{255}
}

// With $JET_RAYLIB_CAPTURE set to a path, each presented frame overwrites that
// file with the canvas as a PAM image (P7, RGB_ALPHA). The startup environment
// value is NUL-terminated, so it is the open path as is. A capture that cannot
// be written is skipped; the frame itself is unaffected.
#Export(c) fn jet_raylib_end_drawing() {
    if (raylib_canvas_pixels == I64{0}) -> return
    path :: host_environment_value(rt_static_text("JET_RAYLIB_CAPTURE"))
    if (path == I64{0} || rt_text_byte(path) == I64{0}) -> return
    fd := I64{-4}
    loop {
        // O_WRONLY | O_CREAT | O_TRUNC | O_CLOEXEC, mode 0644.
        fd = host_call(I64{2}, path, I64{524865}, I64{420})
        if (fd != I64{-4}) -> break
    }
    if (fd < I64{0}) -> return
    header :: jet_rt_string_builder_new()
    raylib_push_static(header, rt_static_text("P7\nWIDTH "))
    rt_text_push_number(header, raylib_canvas_width)
    raylib_push_static(header, rt_static_text("\nHEIGHT "))
    rt_text_push_number(header, raylib_canvas_height)
    raylib_push_static(header, rt_static_text("\nDEPTH 4\nMAXVAL 255\nTUPLTYPE RGB_ALPHA\nENDHDR\n"))
    text :: jet_rt_string_builder_finish(header)
    if (host_write_all(fd, rt_text_data(text), rt_text_len(text)) == I64{0}) {
        _ := host_write_all(fd, raylib_canvas_pixels, raylib_canvas_width * raylib_canvas_height * I64{4})
    }
    jet_rt_string_drop(text)
    _ := host_call(I64{3}, fd, I64{0}, I64{0})
}

fn raylib_push_static(builder: I64, text: I64) { rt_text_append(builder, rt_text_data(text), rt_text_len(text)) }

// CloseWindow releases the canvas and every texture, as raylib's context
// takes its GPU memory with it; a later begin_drawing allocates afresh.
#Export(c) fn jet_raylib_close_window(_window: I64) {
    if (raylib_canvas_pixels != I64{0}) -> jet_rt_free(raylib_canvas_pixels, raylib_canvas_width * raylib_canvas_height * I64{4}, I64{1})
    #Unsafe("the raylib canvas belongs to the one thread that drives the window") {
        raylib_canvas_pixels = I64{0}
        raylib_canvas_width = I64{0}
        raylib_canvas_height = I64{0}
    }
    at := I64{0}
    loop at < raylib_texture_count {
        entry :: wrapping(raylib_textures + at * RAYLIB_TEXTURE_ENTRY_BYTES)
        jet_rt_free(ui_carrier_word(wrapping(entry + RAYLIB_TEXTURE_PIXELS)), ui_carrier_word(wrapping(entry + RAYLIB_TEXTURE_WIDTH)) * ui_carrier_word(wrapping(entry + RAYLIB_TEXTURE_HEIGHT)) * I64{4}, I64{1})
        at += I64{1}
    }
    if (raylib_textures != I64{0}) -> jet_rt_free(raylib_textures, raylib_texture_capacity * RAYLIB_TEXTURE_ENTRY_BYTES, I64{8})
    #Unsafe("the raylib textures belong to the one thread that drives the window") {
        raylib_textures = I64{0}
        raylib_texture_count = I64{0}
        raylib_texture_capacity = I64{0}
    }
}
#Export(c) fn jet_raylib_set_target_fps(fps: I64) { _ := raylib_words(fps, I64{0}, I64{0}, I64{0}) }
#Export(c) fn jet_raylib_key_down(_name: I64) -> Bool { false }
#Export(c) fn jet_raylib_gamepad_down(gamepad: I64, _button: I64) -> Bool {
    _ := raylib_words(gamepad, I64{0}, I64{0}, I64{0})
    false
}
#Export(c) fn jet_raylib_gamepad_axis(gamepad: I64, _axis: I64) -> Float {
    _ := raylib_words(gamepad, I64{0}, I64{0}, I64{0})
    Float{0.0}
}

// The software device's texture memory: one entry per bound texture, holding
// its id, size and row-major RGBA8 pixels. An atlas names its texture by
// raylib's Texture2D (id, width, height, mipmaps, format), so atlas clones
// share one texture as raylib's do. Ids are never reused.
RAYLIB_TEXTURE_ENTRY_BYTES :: I64{32}
RAYLIB_TEXTURE_ID :: I64{0}
RAYLIB_TEXTURE_WIDTH :: I64{8}
RAYLIB_TEXTURE_HEIGHT :: I64{16}
RAYLIB_TEXTURE_PIXELS :: I64{24}
RAYLIB_TEXTURE_ID_MAX :: I64{2147483647}
// raylib's PIXELFORMAT_UNCOMPRESSED_R8G8B8A8.
RAYLIB_TEXTURE_FORMAT_RGBA8 :: I64{7}
raylib_textures := I64{0}
raylib_texture_count := I64{0}
raylib_texture_capacity := I64{0}
raylib_texture_last_id := I64{0}

// The texture path the atlas resolved, or "" when it has none.
#Export(c) fn jet_raylib_atlas_texture_path(atlas: I64) -> I64 {
    texture :: ui_carrier_word(wrapping(atlas + UI_RAYLIB_ATLAS_TEXTURE_PATH))
    if (texture == I64{0}) -> return jet_rt_string_clone(rt_static_text(""))
    jet_rt_string_clone(texture)
}

// Copies Core's decoded RGBA8 pixels (length bytes, `width` per row) into a
// new texture and returns a clone of the atlas that names it. Pixels that do
// not form whole rows within the canvas side cap bind nothing.
#Export(c) fn jet_raylib_atlas_bind_texture(atlas: I64, data: I64, length: I64, width: I64) -> I64 {
    columns :: jet_int_owned_to_i64(width)
    result :: jet_rt_handle_clone_raylib_texture_atlas(atlas)
    if (jet_scheduler_native_propagate() != I64{0}) -> return result
    if (columns <= I64{0} || columns > RAYLIB_CANVAS_SIDE_MAX || raylib_texture_last_id >= RAYLIB_TEXTURE_ID_MAX) -> return result
    rows :: length /% (columns * I64{4})
    if (rows <= I64{0} || rows > RAYLIB_CANVAS_SIDE_MAX || rows * columns * I64{4} != length) -> return result
    if (raylib_texture_count == raylib_texture_capacity) {
        capacity :: if (raylib_texture_capacity == I64{0}) -> I64{4} else -> raylib_texture_capacity * I64{2}
        grown :: jet_rt_alloc(capacity * RAYLIB_TEXTURE_ENTRY_BYTES, I64{8})
        if (raylib_textures != I64{0}) {
            coll_copy(raylib_textures, grown, raylib_texture_count * RAYLIB_TEXTURE_ENTRY_BYTES)
            jet_rt_free(raylib_textures, raylib_texture_capacity * RAYLIB_TEXTURE_ENTRY_BYTES, I64{8})
        }
        #Unsafe("the raylib textures belong to the one thread that drives the window") {
            raylib_textures = grown
            raylib_texture_capacity = capacity
        }
    }
    pixels :: jet_rt_alloc(length, I64{1})
    rt_text_bytes_copy(pixels, data, length)
    #Unsafe("the raylib textures belong to the one thread that drives the window") {
        raylib_texture_last_id += I64{1}
    }
    id :: raylib_texture_last_id
    entry :: wrapping(raylib_textures + raylib_texture_count * RAYLIB_TEXTURE_ENTRY_BYTES)
    ui_carrier_store(wrapping(entry + RAYLIB_TEXTURE_ID), id)
    ui_carrier_store(wrapping(entry + RAYLIB_TEXTURE_WIDTH), columns)
    ui_carrier_store(wrapping(entry + RAYLIB_TEXTURE_HEIGHT), rows)
    ui_carrier_store(wrapping(entry + RAYLIB_TEXTURE_PIXELS), pixels)
    #Unsafe("the raylib textures belong to the one thread that drives the window") {
        raylib_texture_count += I64{1}
    }
    ui_carrier_store(wrapping(result + UI_RAYLIB_ATLAS_TEXTURE_PRESENT), I64{1})
    ui_carrier_store(wrapping(result + UI_RAYLIB_ATLAS_TEXTURE), id.bit_or(columns << I64{32}))
    ui_carrier_store(wrapping(result + UI_RAYLIB_ATLAS_TEXTURE_SECOND), rows.bit_or(I64{1} << I64{32}))
    ui_carrier_store(wrapping(result + UI_RAYLIB_ATLAS_TEXTURE_LAST), RAYLIB_TEXTURE_FORMAT_RGBA8)
    result
}

// The live texture entry with this id, or 0 once close_window released it.
fn raylib_texture_find(id: I64) -> I64 {
    at := I64{0}
    loop at < raylib_texture_count {
        entry :: wrapping(raylib_textures + at * RAYLIB_TEXTURE_ENTRY_BYTES)
        if (ui_carrier_word(wrapping(entry + RAYLIB_TEXTURE_ID)) == id) -> return entry
        at += I64{1}
    }
    I64{0}
}

// The first region record named `name`, or 0.
fn raylib_region_find(regions: I64, name: I64) -> I64 {
    length :: rt_text_len(name)
    data :: ui_carrier_word(wrapping(regions + DATA_SEQUENCE_DATA))
    count :: ui_carrier_word(wrapping(regions + DATA_SEQUENCE_LENGTH))
    at := I64{0}
    loop at < count {
        region :: wrapping(data + at * UI_RAYLIB_REGION_BYTES)
        label :: ui_carrier_word(region)
        if (rt_text_len(label) == length && rt_text_equal_bytes(rt_text_data(label), rt_text_data(name), length)) -> return region
        at += I64{1}
    }
    I64{0}
}

// a - b, saturated to the i64 range; the blit bounds below compare these
// against small sizes, where saturation keeps every comparison exact.
fn raylib_saturating_sub(a: I64, b: I64) -> I64 {
    most :: I64{9223372036854775807}
    least :: I64{0} - most - I64{1}
    if (b < I64{0} && a > most + b) -> return most
    if (b > I64{0} && a < least + b) -> return least
    a - b
}

fn raylib_max3(a: I64, b: I64, c: I64) -> I64 {
    ab :: if (a > b) -> a else -> b
    if (ab > c) -> ab else -> c
}

fn raylib_min3(a: I64, b: I64, c: I64) -> I64 {
    ab :: if (a < b) -> a else -> b
    if (ab < c) -> ab else -> c
}

// Blits region `name` of the atlas's texture with its top-left corner at
// (x, y). Offset k along a side is drawn when it lies in the region, maps
// into the texture (start + k) and onto the canvas (x + k); each pixel blends
// src-over exactly as jet_raylib_fill_rect does, so alpha 0 leaves the canvas
// unchanged.
#Export(c) fn jet_raylib_draw_sprite(atlas: I64, name: I64, x: I64, y: I64) {
    left :: jet_int_owned_to_i64(x)
    top :: jet_int_owned_to_i64(y)
    if (jet_scheduler_native_propagate() != I64{0}) -> return
    if (raylib_canvas_pixels == I64{0} || ui_carrier_bool(wrapping(atlas + UI_RAYLIB_ATLAS_TEXTURE_PRESENT)) == I64{0}) -> return
    texture :: raylib_texture_find(ui_carrier_word(wrapping(atlas + UI_RAYLIB_ATLAS_TEXTURE)).bit_and(I64{4294967295}))
    if (texture == I64{0}) -> return
    region :: raylib_region_find(ui_carrier_word(wrapping(atlas + UI_RAYLIB_ATLAS_REGIONS)), name)
    if (region == I64{0}) -> return
    source_x :: ui_carrier_word(wrapping(region + UI_RAYLIB_REGION_X))
    source_y :: ui_carrier_word(wrapping(wrapping(region + UI_RAYLIB_REGION_X) + I64{8}))
    source_width :: ui_carrier_word(wrapping(wrapping(region + UI_RAYLIB_REGION_X) + I64{16}))
    source_height :: ui_carrier_word(wrapping(wrapping(region + UI_RAYLIB_REGION_X) + I64{24}))
    texture_width :: ui_carrier_word(wrapping(texture + RAYLIB_TEXTURE_WIDTH))
    texture_height :: ui_carrier_word(wrapping(texture + RAYLIB_TEXTURE_HEIGHT))
    first_column :: raylib_max3(I64{0}, raylib_saturating_sub(I64{0}, source_x), raylib_saturating_sub(I64{0}, left))
    end_column :: raylib_min3(source_width, raylib_saturating_sub(texture_width, source_x), raylib_saturating_sub(raylib_canvas_width, left))
    first_row :: raylib_max3(I64{0}, raylib_saturating_sub(I64{0}, source_y), raylib_saturating_sub(I64{0}, top))
    end_row :: raylib_min3(source_height, raylib_saturating_sub(texture_height, source_y), raylib_saturating_sub(raylib_canvas_height, top))
    if (first_column >= end_column || first_row >= end_row) -> return
    pixels :: ui_carrier_word(wrapping(texture + RAYLIB_TEXTURE_PIXELS))
    row := first_row
    loop row < end_row {
        from := pixels + ((source_y + row) * texture_width + source_x + first_column) * I64{4}
        at := raylib_canvas_pixels + ((top + row) * raylib_canvas_width + left + first_column) * I64{4}
        stop :: at + (end_column - first_column) * I64{4}
        loop at < stop {
            alpha :: rt_text_byte(wrapping(from + I64{3}))
            if (alpha == I64{255}) {
                coll_copy(from, at, I64{4})
            } else if (alpha != I64{0}) {
                rt_text_put(at, raylib_blend(rt_text_byte(from), rt_text_byte(at), alpha))
                rt_text_put(wrapping(at + I64{1}), raylib_blend(rt_text_byte(wrapping(from + I64{1})), rt_text_byte(wrapping(at + I64{1})), alpha))
                rt_text_put(wrapping(at + I64{2}), raylib_blend(rt_text_byte(wrapping(from + I64{2})), rt_text_byte(wrapping(at + I64{2})), alpha))
                rt_text_put(wrapping(at + I64{3}), raylib_blend(alpha, rt_text_byte(wrapping(at + I64{3})), alpha))
            }
            from += I64{4}
            at += I64{4}
        }
        row += I64{1}
    }
}

// `str::parse::<i64>()` of data[start..end): optional sign, decimal digits.
fn raylib_parse_i64(data: I64, start: I64, end: I64, out: I64) -> Bool {
    at := start
    negative :: at < end && rt_text_byte(wrapping(data + at)) == I64{45}
    if (at < end && (negative || rt_text_byte(wrapping(data + at)) == I64{43})) -> at += I64{1}
    if (at >= end) -> return false
    limit :: if negative -> U64{9223372036854775808} else -> U64{9223372036854775807}
    value := U64{0}
    loop at < end {
        digit :: rt_text_byte(wrapping(data + at)) - I64{48}
        if (digit < I64{0} || digit > I64{9}) -> return false
        if (value > (limit - U64{digit}) /% U64{10}) -> return false
        value = value * U64{10} + U64{digit}
        at += I64{1}
    }
    rt_text_store(out, if negative -> I64{0} - I64{value} else -> I64{value})
    true
}

// The next split_whitespace field of data[at..end): writes [start, stop) to
// out and returns the offset after it, or -1 when no field remains.
fn raylib_field(data: I64, at: I64, end: I64, out: I64) -> I64 {
    from := at
    loop from < end && encoding_white_space(encoding_scalar_at(data, from)) -> from += rt_text_width(wrapping(data + from))
    if (from >= end) -> return I64{-1}
    to := from
    loop to < end && !encoding_white_space(encoding_scalar_at(data, to)) -> to += rt_text_width(wrapping(data + to))
    rt_text_store(out, from)
    rt_text_store(wrapping(out + I64{8}), to)
    to
}

fn raylib_has_prefix(data: I64, start: I64, end: I64, prefix: I64) -> Bool {
    length :: rt_text_len(prefix)
    if (end - start < length) -> return false
    at := I64{0}
    loop at < length {
        if (rt_text_byte(wrapping(wrapping(data + start) + at)) != rt_text_byte(wrapping(rt_text_data(prefix) + at))) -> return false
        at += I64{1}
    }
    true
}

// jet_raylib_atlas_region: "region:" or "region " then name x y width height.
fn raylib_region_push(regions: I64, data: I64, start: I64, end: I64, scratch: I64) {
    rest := I64{0}
    if raylib_has_prefix(data, start, end, rt_static_text("region:")) {
        rest = start + I64{7}
    } else if raylib_has_prefix(data, start, end, rt_static_text("region ")) {
        rest = start + I64{7}
    } else {
        return
    }
    at := raylib_field(data, rest, end, scratch)
    if (at < I64{0}) -> return
    name_start :: rt_text_word(scratch)
    name_end :: rt_text_word(wrapping(scratch + I64{8}))
    index := I64{0}
    loop index < (I64{4}) {
        at = raylib_field(data, at, end, scratch)
        if (at < I64{0}) -> return
        if !raylib_parse_i64(data, rt_text_word(scratch), rt_text_word(wrapping(scratch + I64{8})), wrapping(wrapping(scratch + I64{16}) + index * I64{8})) -> return
        index += I64{1}
    }
    slot :: data_sequence_reserve(regions, UI_RAYLIB_REGION_BYTES)
    ui_carrier_store(slot, rt_text_copy(wrapping(data + name_start), name_end - name_start))
    coll_copy(wrapping(scratch + I64{16}), wrapping(slot + UI_RAYLIB_REGION_X), I64{32})
    ui_carrier_store(wrapping(regions + DATA_SEQUENCE_LENGTH), ui_carrier_word(wrapping(regions + DATA_SEQUENCE_LENGTH)) + I64{1})
}

// The end of data[0..end) without the trailing separators and "." components
// that Path's Components skip.
fn raylib_trim_end(data: I64, end: I64) -> I64 {
    at := end
    loop {
        loop at > (I64{0}) && rt_text_byte(wrapping(wrapping(data + at) - I64{1})) == (I64{47}) -> at -= I64{1}
        if (at >= I64{2} && rt_text_byte(wrapping(wrapping(data + at) - I64{1})) == I64{46} && rt_text_byte(wrapping(wrapping(data + at) - I64{2})) == I64{47}) {
            at -= I64{2}
            next
        }
        break
    }
    at
}

// Path::file_name, the last normal component of data[0..length): [start, end),
// or start -1 for none ("", "/", a lone ".", a trailing "..").
fn raylib_file_name(data: I64, length: I64, out: I64) {
    end :: raylib_trim_end(data, length)
    start := end
    loop start > (I64{0}) && rt_text_byte(wrapping(wrapping(data + start) - I64{1})) != (I64{47}) -> start -= I64{1}
    dot :: end - start == I64{1} && rt_text_byte(wrapping(data + start)) == I64{46}
    dotdot :: end - start == I64{2} && rt_text_byte(wrapping(data + start)) == I64{46} && rt_text_byte(wrapping(wrapping(data + start) + I64{1})) == I64{46}
    rt_text_store(out, if (end == start || dot || dotdot) -> I64{-1} else -> start)
    rt_text_store(wrapping(out + I64{8}), end)
}

// Path::file_stem: the name before its last '.', unless that dot leads it.
fn raylib_stem_end(data: I64, start: I64, end: I64) -> I64 {
    dot := end - I64{1}
    loop dot > start && rt_text_byte(wrapping(data + dot)) != (I64{46}) -> dot -= I64{1}
    if (dot <= start) -> return end
    dot
}

// Path::parent: the path before its last component ("/" keeps the root), or
// -1 when the last component is the root or there is none.
fn raylib_parent_end(data: I64, length: I64) -> I64 {
    end := raylib_trim_end(data, length)
    if (end == I64{0}) -> return I64{-1}
    loop end > (I64{0}) && rt_text_byte(wrapping(wrapping(data + end) - I64{1})) != (I64{47}) -> end -= I64{1}
    stop :: raylib_trim_end(data, end)
    if (stop == I64{0} && end > I64{0}) -> return I64{1}
    stop
}

// jet_raylib_atlas_texture_path: an absolute texture stays; otherwise it
// joins the atlas's parent ("." for none).
fn raylib_texture_path(path: I64, data: I64, start: I64, end: I64) -> I64 {
    if (rt_text_byte(wrapping(data + start)) == I64{47}) -> return rt_text_copy(wrapping(data + start), end - start)
    base :: rt_text_data(path)
    parent :: raylib_parent_end(base, rt_text_len(path))
    result :: rt_text_builder_with_capacity(I64{0})
    if (parent < I64{0}) {
        rt_text_push_word(result, I64{46}, I64{1})
    } else {
        rt_text_append(result, base, parent)
    }
    length :: rt_text_len(result)
    if (length != I64{0} && rt_text_byte(wrapping(wrapping(rt_text_data(result) + length) - I64{1})) != I64{47}) -> rt_text_push_word(result, I64{47}, I64{1})
    rt_text_append(result, data + start, end - start)
    jet_rt_string_builder_finish(result)
}

// Path::with_extension("png"): the path truncated after its file stem, then
// ".png"; a path without a file name is unchanged.
fn raylib_png_path(path: I64, scratch: I64) -> I64 {
    data :: rt_text_data(path)
    raylib_file_name(data, rt_text_len(path), scratch)
    start :: rt_text_word(scratch)
    if (start < I64{0}) -> return jet_rt_string_clone(path)
    stem :: raylib_stem_end(data, start, rt_text_word(wrapping(scratch + I64{8})))
    result :: rt_text_builder_with_capacity(stem + I64{4})
    rt_text_append(result, data, stem)
    rt_text_push_word(result, I64{1735290926}, I64{4}) // .png
    jet_rt_string_builder_finish(result)
}

#Export(c) fn jet_raylib_load_texture_atlas(path: I64) -> I64 {
    data :: rt_text_data(path)
    length :: rt_text_len(path)
    scratch :: jet_rt_alloc(I64{48}, I64{8})
    raylib_file_name(data, length, scratch)
    name := I64{0}
    file_start :: rt_text_word(scratch)
    if (file_start >= I64{0}) {
        file_end :: rt_text_word(wrapping(scratch + I64{8}))
        name = rt_text_copy(wrapping(data + file_start), raylib_stem_end(data, file_start, file_end) - file_start)
    } else {
        name = jet_rt_string_clone(rt_static_text("atlas"))
    }
    texture := I64{0}
    regions :: data_sequence_new(I64{0}, UI_RAYLIB_REGION_BYTES)
    // std::fs::read_to_string(path).ok(): any failure, a NUL or non-UTF-8 is no text.
    text := I64{0}
    if !walk_has_nul(data, length) {
        c_path :: fd_c_path(path)
        if (walk_read_file(c_path, scratch) == I64{0}) {
            if files_utf8_valid(rt_text_word(scratch), rt_text_word(wrapping(scratch + I64{8}))) {
                text = rt_text_copy(rt_text_word(scratch), rt_text_word(wrapping(scratch + I64{8})))
            }
            jet_rt_free(rt_text_word(scratch), rt_text_word(wrapping(scratch + I64{16})), I64{1})
        }
        fd_c_path_drop(c_path, path)
    }
    if (text != I64{0}) {
        bytes :: rt_text_data(text)
        total :: rt_text_len(text)
        line := I64{0}
        loop line < total {
            stop := line
            loop stop < total && rt_text_byte(wrapping(bytes + stop)) != (I64{10}) -> stop += I64{1}
            next_line :: stop + I64{1}
            if (stop > line && rt_text_byte(wrapping(wrapping(bytes + stop) - I64{1})) == I64{13}) -> stop -= I64{1}
            encoding_trim(bytes, line, stop, scratch)
            from :: rt_text_word(scratch)
            to :: rt_text_word(wrapping(scratch + I64{8}))
            if (to > from) {
                if raylib_has_prefix(bytes, from, to, rt_static_text("atlas:")) {
                    encoding_trim(bytes, from + I64{6}, to, scratch)
                    if (rt_text_word(wrapping(scratch + I64{8})) > rt_text_word(scratch)) {
                        jet_rt_string_drop(name)
                        name = rt_text_copy(wrapping(bytes + rt_text_word(scratch)), rt_text_word(wrapping(scratch + I64{8})) - rt_text_word(scratch))
                    }
                } else if raylib_has_prefix(bytes, from, to, rt_static_text("texture:")) {
                    encoding_trim(bytes, from + I64{8}, to, scratch)
                    if (rt_text_word(wrapping(scratch + I64{8})) > rt_text_word(scratch)) {
                        if (texture != I64{0}) -> jet_rt_string_drop(texture)
                        texture = raylib_texture_path(path, bytes, rt_text_word(scratch), rt_text_word(wrapping(scratch + I64{8})))
                    }
                } else {
                    raylib_region_push(regions, bytes, from, to, scratch)
                }
            }
            line = next_line
        }
        jet_rt_string_drop(text)
    }
    if (texture == I64{0}) -> texture = raylib_png_path(path, scratch)
    jet_rt_free(scratch, I64{48}, I64{8})
    result :: jet_rt_alloc(UI_RAYLIB_ATLAS_BYTES, I64{8})
    thread_zero(result, UI_RAYLIB_ATLAS_BYTES)
    ui_carrier_store(wrapping(result + UI_RAYLIB_ATLAS_PATH), jet_rt_string_clone(path))
    ui_carrier_store(wrapping(result + UI_RAYLIB_ATLAS_NAME), name)
    ui_carrier_store(wrapping(result + UI_RAYLIB_ATLAS_TEXTURE_PATH), texture)
    ui_carrier_store(wrapping(result + UI_RAYLIB_ATLAS_REGIONS), regions)
    result
}

// RaylibColor record (r,g,b,a: Int): RaylibColor32 of raw words.
RAYLIB_COLOR_BYTES :: I64{32}
#Export(c) fn jet_rt_record_new_raylib_color(r: I64, g: I64, b: I64, a: I64) -> I64 {
    words :: jet_rt_alloc(RAYLIB_COLOR_BYTES, I64{8})
    ui_carrier_store(words, jet_int_owned_to_i64(r))
    ui_carrier_store(wrapping(words + I64{8}), jet_int_owned_to_i64(g))
    ui_carrier_store(wrapping(words + I64{16}), jet_int_owned_to_i64(b))
    ui_carrier_store(wrapping(words + I64{24}), jet_int_owned_to_i64(a))
    if (jet_scheduler_native_propagate() != I64{0}) {
        jet_rt_free(words, RAYLIB_COLOR_BYTES, I64{8})
        return I64{0}
    }
    words
}
#Export(c) fn jet_rt_record_get_raylib_color_r(value: I64) -> I64 { jet_int_owned_from_i64(ui_carrier_word(value)) }
#Export(c) fn jet_rt_record_get_raylib_color_g(value: I64) -> I64 { jet_int_owned_from_i64(ui_carrier_word(wrapping(value + I64{8}))) }
#Export(c) fn jet_rt_record_get_raylib_color_b(value: I64) -> I64 { jet_int_owned_from_i64(ui_carrier_word(wrapping(value + I64{16}))) }
#Export(c) fn jet_rt_record_get_raylib_color_a(value: I64) -> I64 { jet_int_owned_from_i64(ui_carrier_word(wrapping(value + I64{24}))) }
#Export(c) fn jet_rt_handle_clone_raylib_color(value: I64) -> I64 {
    result :: jet_rt_alloc(RAYLIB_COLOR_BYTES, I64{8})
    coll_copy(value, result, RAYLIB_COLOR_BYTES)
    result
}
#Export(c) fn jet_rt_handle_drop_raylib_color(value: I64) {
    if (value != I64{0}) -> jet_rt_free(value, RAYLIB_COLOR_BYTES, I64{8})
}
