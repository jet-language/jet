// core.game.raylib on the static native runtime: CoreLib/Top/HandlesRaylib.rs
// :744-1065 with jet_raylib_api() == None. The display bridge dlopens
// libraylib (HandlesRaylib.rs:664-735), which a static musl executable cannot
// do, so windows are never native, input is inert and sticks read 0. Drawing
// is real: Core scan-converts every primitive into clipped runs and this file
// owns the RGBA canvas they paint. Atlas metadata is the shared
// Core/Raylib.rs:67-147 parse; no texture is ever loaded. Carriers are
// UiRaylibMetadata.jet's RaylibWindow32/RaylibTextureAtlas64/Region40.

// Each leaf narrows its exact-Int words as the C adapter does before the call.
fn raylib_words(a: I64, b: I64, c: I64, d: I64) -> Bool {
    _ := jet_int_owned_to_i64(a)
    _ := jet_int_owned_to_i64(b)
    _ := jet_int_owned_to_i64(c)
    _ := jet_int_owned_to_i64(d)
    jet_scheduler_native_propagate() == I64{0}
}

#Export(c) fn jet_raylib_window_open(width: I64, height: I64, title: I64) -> I64 {
    native_width :: jet_int_owned_to_i64(width)
    native_height :: jet_int_owned_to_i64(height)
    if (jet_scheduler_native_propagate() != I64{0}) -> return I64{0}
    ui_raylib_window_new(native_width, native_height, title, I64{0})
}
#Export(c) fn jet_raylib_window_should_close(_window: I64) -> Bool { true }
#Export(c) fn jet_raylib_window_ready(window: I64) -> Bool { ui_carrier_bool(window + UI_RAYLIB_WINDOW_NATIVE) != I64{0} }

// The software canvas: row-major RGBA8, width * height * 4 bytes, zeroed when
// begin_drawing (re)sizes it to the window and kept across same-size frames.
// Drawing is single-threaded, as in raylib's own context.
RAYLIB_CANVAS_SIDE_MAX :: I64{16384}
raylib_canvas_pixels := I64{0}
raylib_canvas_width := I64{0}
raylib_canvas_height := I64{0}

fn raylib_canvas_side(value: I64) -> I64 {
    if (value < I64{0}) -> return I64{0}
    if (value > RAYLIB_CANVAS_SIDE_MAX) -> return RAYLIB_CANVAS_SIDE_MAX
    value
}

#Export(c) fn jet_raylib_begin_drawing(window: I64) {
    width :: raylib_canvas_side(ui_carrier_word(window + UI_RAYLIB_WINDOW_WIDTH))
    height :: raylib_canvas_side(ui_carrier_word(window + UI_RAYLIB_WINDOW_HEIGHT))
    if (width == raylib_canvas_width && height == raylib_canvas_height) -> return
    if (raylib_canvas_pixels != I64{0}) -> jet_rt_free(raylib_canvas_pixels, raylib_canvas_width * raylib_canvas_height * I64{4}, I64{1})
    raylib_canvas_pixels = I64{0}
    bytes :: width * height * I64{4}
    if (bytes != I64{0}) {
        raylib_canvas_pixels = jet_rt_alloc(bytes, I64{1})
        coll_zero(raylib_canvas_pixels, bytes)
    }
    raylib_canvas_width = width
    raylib_canvas_height = height
}

// Both sides fit 16 bits, so one word carries width << 16 | height.
#Export(c) fn jet_raylib_canvas_extent() -> I64 {
    jet_int_owned_from_i64((raylib_canvas_width << I64{16}).bit_or(raylib_canvas_height))
}

// One run of 0xRRGGBBAA. A replace copies the color (ClearBackground);
// otherwise every channel, alpha included, blends src-over with rounding:
// (src * a + dst * (255 - a) + 127) / 255, raylib's BLEND_ALPHA. The run is
// clipped again here; the canvas never trusts its caller with its bounds.
#Export(c) fn jet_raylib_fill_rect(x: I64, y: I64, width: I64, height: I64, rgba: I64, replace: Bool) {
    left :: jet_int_owned_to_i64(x)
    top :: jet_int_owned_to_i64(y)
    run_width :: jet_int_owned_to_i64(width)
    run_height :: jet_int_owned_to_i64(height)
    color :: jet_int_owned_to_i64(rgba)
    if (jet_scheduler_native_propagate() != I64{0}) -> return
    alpha :: color.bit_and(I64{255})
    if (raylib_canvas_pixels == I64{0} || run_width <= I64{0} || run_height <= I64{0} || (!replace && alpha == I64{0})) -> return
    x0 :: if (left < I64{0}) -> I64{0} else -> left
    y0 :: if (top < I64{0}) -> I64{0} else -> top
    if (x0 >= raylib_canvas_width || y0 >= raylib_canvas_height) -> return
    x1 :: if (left >= I64{0} && run_width > raylib_canvas_width - left) -> raylib_canvas_width else -> raylib_canvas_side_min(left + run_width, raylib_canvas_width)
    y1 :: if (top >= I64{0} && run_height > raylib_canvas_height - top) -> raylib_canvas_height else -> raylib_canvas_side_min(top + run_height, raylib_canvas_height)
    if (x1 <= x0 || y1 <= y0) -> return
    red :: (color >> I64{24}).bit_and(I64{255})
    green :: (color >> I64{16}).bit_and(I64{255})
    blue :: (color >> I64{8}).bit_and(I64{255})
    opaque :: replace || alpha == I64{255}
    row := y0
    loop row < y1 {
        at := raylib_canvas_pixels + (row * raylib_canvas_width + x0) * I64{4}
        stop :: raylib_canvas_pixels + (row * raylib_canvas_width + x1) * I64{4}
        loop at < stop {
            if (opaque) {
                rt_text_put(at, red)
                rt_text_put(at + I64{1}, green)
                rt_text_put(at + I64{2}, blue)
                rt_text_put(at + I64{3}, alpha)
            } else {
                rt_text_put(at, raylib_blend(red, rt_text_byte(at), alpha))
                rt_text_put(at + I64{1}, raylib_blend(green, rt_text_byte(at + I64{1}), alpha))
                rt_text_put(at + I64{2}, raylib_blend(blue, rt_text_byte(at + I64{2}), alpha))
                rt_text_put(at + I64{3}, raylib_blend(alpha, rt_text_byte(at + I64{3}), alpha))
            }
            at += I64{4}
        }
        row += I64{1}
    }
}

fn raylib_canvas_side_min(a: I64, b: I64) -> I64 {
    if (a < b) -> return a
    b
}

fn raylib_blend(source: I64, target: I64, alpha: I64) -> I64 {
    (source * alpha + target * (I64{255} - alpha) + I64{127}) /% I64{255}
}

// With $JET_RAYLIB_CAPTURE set to a path, each presented frame overwrites that
// file with the canvas as a PAM image (P7, RGB_ALPHA). The startup environment
// value is NUL-terminated, so it is the open path as is. A capture that cannot
// be written is skipped; the frame itself is unaffected.
#Export(c) fn jet_raylib_end_drawing() {
    if (raylib_canvas_pixels == I64{0}) -> return
    path :: host_environment_value(rt_static_text("JET_RAYLIB_CAPTURE"))
    if (path == I64{0} || rt_text_byte(path) == I64{0}) -> return
    fd := I64{-4}
    loop {
        // O_WRONLY | O_CREAT | O_TRUNC | O_CLOEXEC, mode 0644.
        fd = host_call(I64{2}, path, I64{524865}, I64{420})
        if (fd != I64{-4}) -> break
    }
    if (fd < I64{0}) -> return
    header :: jet_rt_string_builder_new()
    raylib_push_static(header, rt_static_text("P7\nWIDTH "))
    rt_text_push_number(header, raylib_canvas_width)
    raylib_push_static(header, rt_static_text("\nHEIGHT "))
    rt_text_push_number(header, raylib_canvas_height)
    raylib_push_static(header, rt_static_text("\nDEPTH 4\nMAXVAL 255\nTUPLTYPE RGB_ALPHA\nENDHDR\n"))
    text :: jet_rt_string_builder_finish(header)
    if (host_write_all(fd, rt_text_data(text), rt_text_len(text)) == I64{0}) {
        _ := host_write_all(fd, raylib_canvas_pixels, raylib_canvas_width * raylib_canvas_height * I64{4})
    }
    jet_rt_string_drop(text)
    _ := host_call(I64{3}, fd, I64{0}, I64{0})
}

fn raylib_push_static(builder: I64, text: I64) { rt_text_append(builder, rt_text_data(text), rt_text_len(text)) }

// CloseWindow releases the canvas; a later begin_drawing allocates afresh.
#Export(c) fn jet_raylib_close_window(_window: I64) {
    if (raylib_canvas_pixels != I64{0}) -> jet_rt_free(raylib_canvas_pixels, raylib_canvas_width * raylib_canvas_height * I64{4}, I64{1})
    raylib_canvas_pixels = I64{0}
    raylib_canvas_width = I64{0}
    raylib_canvas_height = I64{0}
}
#Export(c) fn jet_raylib_set_target_fps(fps: I64) { _ := raylib_words(fps, I64{0}, I64{0}, I64{0}) }
#Export(c) fn jet_raylib_key_down(_name: I64) -> Bool { false }
#Export(c) fn jet_raylib_gamepad_down(gamepad: I64, _button: I64) -> Bool {
    _ := raylib_words(gamepad, I64{0}, I64{0}, I64{0})
    false
}
#Export(c) fn jet_raylib_gamepad_axis(gamepad: I64, _axis: I64) -> Float {
    _ := raylib_words(gamepad, I64{0}, I64{0}, I64{0})
    Float{0.0}
}

// The sprite's draw-call record (Core/Raylib.rs:38) has no reader on any
// tier and there is no native texture to draw.
#Export(c) fn jet_raylib_draw_sprite(_atlas: I64, _region: I64, x: I64, y: I64) { _ := raylib_words(x, y, I64{0}, I64{0}) }

// `str::parse::<i64>()` of data[start..end): optional sign, decimal digits.
fn raylib_parse_i64(data: I64, start: I64, end: I64, out: I64) -> Bool {
    at := start
    negative :: at < end && rt_text_byte(data + at) == I64{45}
    if (at < end && (negative || rt_text_byte(data + at) == I64{43})) -> at += I64{1}
    if (at >= end) -> return false
    limit :: if negative -> U64{9223372036854775808} else -> U64{9223372036854775807}
    value := U64{0}
    loop at < end {
        digit :: rt_text_byte(data + at) - I64{48}
        if (digit < I64{0} || digit > I64{9}) -> return false
        if (value > (limit - U64{digit}) /% U64{10}) -> return false
        value = value * U64{10} + U64{digit}
        at += I64{1}
    }
    rt_text_store(out, if negative -> I64{0} - I64{value} else -> I64{value})
    true
}

// The next split_whitespace field of data[at..end): writes [start, stop) to
// out and returns the offset after it, or -1 when no field remains.
fn raylib_field(data: I64, at: I64, end: I64, out: I64) -> I64 {
    from := at
    loop from < end && encoding_white_space(encoding_scalar_at(data, from)) -> from += rt_text_width(data + from)
    if (from >= end) -> return I64{-1}
    to := from
    loop to < end && !encoding_white_space(encoding_scalar_at(data, to)) -> to += rt_text_width(data + to)
    rt_text_store(out, from)
    rt_text_store(out + I64{8}, to)
    to
}

fn raylib_has_prefix(data: I64, start: I64, end: I64, prefix: I64) -> Bool {
    length :: rt_text_len(prefix)
    if (end - start < length) -> return false
    at := I64{0}
    loop at < length {
        if (rt_text_byte(data + start + at) != rt_text_byte(rt_text_data(prefix) + at)) -> return false
        at += I64{1}
    }
    true
}

// jet_raylib_atlas_region: "region:" or "region " then name x y width height.
fn raylib_region_push(regions: I64, data: I64, start: I64, end: I64, scratch: I64) {
    rest := I64{0}
    if raylib_has_prefix(data, start, end, rt_static_text("region:")) {
        rest = start + I64{7}
    } else if raylib_has_prefix(data, start, end, rt_static_text("region ")) {
        rest = start + I64{7}
    } else {
        return
    }
    at := raylib_field(data, rest, end, scratch)
    if (at < I64{0}) -> return
    name_start :: rt_text_word(scratch)
    name_end :: rt_text_word(scratch + I64{8})
    index := I64{0}
    loop index < (I64{4}) {
        at = raylib_field(data, at, end, scratch)
        if (at < I64{0}) -> return
        if !raylib_parse_i64(data, rt_text_word(scratch), rt_text_word(scratch + I64{8}), scratch + I64{16} + index * I64{8}) -> return
        index += I64{1}
    }
    slot :: data_sequence_reserve(regions, UI_RAYLIB_REGION_BYTES)
    ui_carrier_store(slot, rt_text_copy(data + name_start, name_end - name_start))
    coll_copy(scratch + I64{16}, slot + UI_RAYLIB_REGION_X, I64{32})
    ui_carrier_store(regions + DATA_SEQUENCE_LENGTH, ui_carrier_word(regions + DATA_SEQUENCE_LENGTH) + I64{1})
}

// The end of data[0..end) without the trailing separators and "." components
// that Path's Components skip.
fn raylib_trim_end(data: I64, end: I64) -> I64 {
    at := end
    loop {
        loop at > (I64{0}) && rt_text_byte(data + at - I64{1}) == (I64{47}) -> at -= I64{1}
        if (at >= I64{2} && rt_text_byte(data + at - I64{1}) == I64{46} && rt_text_byte(data + at - I64{2}) == I64{47}) {
            at -= I64{2}
            next
        }
        break
    }
    at
}

// Path::file_name, the last normal component of data[0..length): [start, end),
// or start -1 for none ("", "/", a lone ".", a trailing "..").
fn raylib_file_name(data: I64, length: I64, out: I64) {
    end :: raylib_trim_end(data, length)
    start := end
    loop start > (I64{0}) && rt_text_byte(data + start - I64{1}) != (I64{47}) -> start -= I64{1}
    dot :: end - start == I64{1} && rt_text_byte(data + start) == I64{46}
    dotdot :: end - start == I64{2} && rt_text_byte(data + start) == I64{46} && rt_text_byte(data + start + I64{1}) == I64{46}
    rt_text_store(out, if (end == start || dot || dotdot) -> I64{-1} else -> start)
    rt_text_store(out + I64{8}, end)
}

// Path::file_stem: the name before its last '.', unless that dot leads it.
fn raylib_stem_end(data: I64, start: I64, end: I64) -> I64 {
    dot := end - I64{1}
    loop dot > start && rt_text_byte(data + dot) != (I64{46}) -> dot -= I64{1}
    if (dot <= start) -> return end
    dot
}

// Path::parent: the path before its last component ("/" keeps the root), or
// -1 when the last component is the root or there is none.
fn raylib_parent_end(data: I64, length: I64) -> I64 {
    end := raylib_trim_end(data, length)
    if (end == I64{0}) -> return I64{-1}
    loop end > (I64{0}) && rt_text_byte(data + end - I64{1}) != (I64{47}) -> end -= I64{1}
    stop :: raylib_trim_end(data, end)
    if (stop == I64{0} && end > I64{0}) -> return I64{1}
    stop
}

// jet_raylib_atlas_texture_path: an absolute texture stays; otherwise it
// joins the atlas's parent ("." for none).
fn raylib_texture_path(path: I64, data: I64, start: I64, end: I64) -> I64 {
    if (rt_text_byte(data + start) == I64{47}) -> return rt_text_copy(data + start, end - start)
    base :: rt_text_data(path)
    parent :: raylib_parent_end(base, rt_text_len(path))
    result :: rt_text_builder_with_capacity(I64{0})
    if (parent < I64{0}) {
        rt_text_push_word(result, I64{46}, I64{1})
    } else {
        rt_text_append(result, base, parent)
    }
    length :: rt_text_len(result)
    if (length != I64{0} && rt_text_byte(rt_text_data(result) + length - I64{1}) != I64{47}) -> rt_text_push_word(result, I64{47}, I64{1})
    rt_text_append(result, data + start, end - start)
    jet_rt_string_builder_finish(result)
}

// Path::with_extension("png"): the path truncated after its file stem, then
// ".png"; a path without a file name is unchanged.
fn raylib_png_path(path: I64, scratch: I64) -> I64 {
    data :: rt_text_data(path)
    raylib_file_name(data, rt_text_len(path), scratch)
    start :: rt_text_word(scratch)
    if (start < I64{0}) -> return jet_rt_string_clone(path)
    stem :: raylib_stem_end(data, start, rt_text_word(scratch + I64{8}))
    result :: rt_text_builder_with_capacity(stem + I64{4})
    rt_text_append(result, data, stem)
    rt_text_push_word(result, I64{1735290926}, I64{4}) // .png
    jet_rt_string_builder_finish(result)
}

#Export(c) fn jet_raylib_load_texture_atlas(path: I64) -> I64 {
    data :: rt_text_data(path)
    length :: rt_text_len(path)
    scratch :: jet_rt_alloc(I64{48}, I64{8})
    raylib_file_name(data, length, scratch)
    name := I64{0}
    file_start :: rt_text_word(scratch)
    if (file_start >= I64{0}) {
        file_end :: rt_text_word(scratch + I64{8})
        name = rt_text_copy(data + file_start, raylib_stem_end(data, file_start, file_end) - file_start)
    } else {
        name = jet_rt_string_clone(rt_static_text("atlas"))
    }
    texture := I64{0}
    regions :: data_sequence_new(I64{0}, UI_RAYLIB_REGION_BYTES)
    // std::fs::read_to_string(path).ok(): any failure, a NUL or non-UTF-8 is no text.
    text := I64{0}
    if !walk_has_nul(data, length) {
        c_path :: fd_c_path(path)
        if (walk_read_file(c_path, scratch) == I64{0}) {
            if files_utf8_valid(rt_text_word(scratch), rt_text_word(scratch + I64{8})) {
                text = rt_text_copy(rt_text_word(scratch), rt_text_word(scratch + I64{8}))
            }
            jet_rt_free(rt_text_word(scratch), rt_text_word(scratch + I64{16}), I64{1})
        }
        fd_c_path_drop(c_path, path)
    }
    if (text != I64{0}) {
        bytes :: rt_text_data(text)
        total :: rt_text_len(text)
        line := I64{0}
        loop line < total {
            stop := line
            loop stop < total && rt_text_byte(bytes + stop) != (I64{10}) -> stop += I64{1}
            next_line :: stop + I64{1}
            if (stop > line && rt_text_byte(bytes + stop - I64{1}) == I64{13}) -> stop -= I64{1}
            encoding_trim(bytes, line, stop, scratch)
            from :: rt_text_word(scratch)
            to :: rt_text_word(scratch + I64{8})
            if (to > from) {
                if raylib_has_prefix(bytes, from, to, rt_static_text("atlas:")) {
                    encoding_trim(bytes, from + I64{6}, to, scratch)
                    if (rt_text_word(scratch + I64{8}) > rt_text_word(scratch)) {
                        jet_rt_string_drop(name)
                        name = rt_text_copy(bytes + rt_text_word(scratch), rt_text_word(scratch + I64{8}) - rt_text_word(scratch))
                    }
                } else if raylib_has_prefix(bytes, from, to, rt_static_text("texture:")) {
                    encoding_trim(bytes, from + I64{8}, to, scratch)
                    if (rt_text_word(scratch + I64{8}) > rt_text_word(scratch)) {
                        if (texture != I64{0}) -> jet_rt_string_drop(texture)
                        texture = raylib_texture_path(path, bytes, rt_text_word(scratch), rt_text_word(scratch + I64{8}))
                    }
                } else {
                    raylib_region_push(regions, bytes, from, to, scratch)
                }
            }
            line = next_line
        }
        jet_rt_string_drop(text)
    }
    if (texture == I64{0}) -> texture = raylib_png_path(path, scratch)
    jet_rt_free(scratch, I64{48}, I64{8})
    result :: jet_rt_alloc(UI_RAYLIB_ATLAS_BYTES, I64{8})
    thread_zero(result, UI_RAYLIB_ATLAS_BYTES)
    ui_carrier_store(result + UI_RAYLIB_ATLAS_PATH, jet_rt_string_clone(path))
    ui_carrier_store(result + UI_RAYLIB_ATLAS_NAME, name)
    ui_carrier_store(result + UI_RAYLIB_ATLAS_TEXTURE_PATH, texture)
    ui_carrier_store(result + UI_RAYLIB_ATLAS_REGIONS, regions)
    result
}

// RaylibColor record (r,g,b,a: Int): RaylibColor32 of raw words.
RAYLIB_COLOR_BYTES :: I64{32}
#Export(c) fn jet_rt_record_new_raylib_color(r: I64, g: I64, b: I64, a: I64) -> I64 {
    words :: jet_rt_alloc(RAYLIB_COLOR_BYTES, I64{8})
    ui_carrier_store(words, jet_int_owned_to_i64(r))
    ui_carrier_store(words + I64{8}, jet_int_owned_to_i64(g))
    ui_carrier_store(words + I64{16}, jet_int_owned_to_i64(b))
    ui_carrier_store(words + I64{24}, jet_int_owned_to_i64(a))
    if (jet_scheduler_native_propagate() != I64{0}) {
        jet_rt_free(words, RAYLIB_COLOR_BYTES, I64{8})
        return I64{0}
    }
    words
}
#Export(c) fn jet_rt_record_get_raylib_color_r(value: I64) -> I64 { jet_int_owned_from_i64(ui_carrier_word(value)) }
#Export(c) fn jet_rt_record_get_raylib_color_g(value: I64) -> I64 { jet_int_owned_from_i64(ui_carrier_word(value + I64{8})) }
#Export(c) fn jet_rt_record_get_raylib_color_b(value: I64) -> I64 { jet_int_owned_from_i64(ui_carrier_word(value + I64{16})) }
#Export(c) fn jet_rt_record_get_raylib_color_a(value: I64) -> I64 { jet_int_owned_from_i64(ui_carrier_word(value + I64{24})) }
#Export(c) fn jet_rt_handle_clone_raylib_color(value: I64) -> I64 {
    result :: jet_rt_alloc(RAYLIB_COLOR_BYTES, I64{8})
    coll_copy(value, result, RAYLIB_COLOR_BYTES)
    result
}
#Export(c) fn jet_rt_handle_drop_raylib_color(value: I64) {
    if (value != I64{0}) -> jet_rt_free(value, RAYLIB_COLOR_BYTES, I64{8})
}
