// Services.rs:112-116 unit enum; :1080-1087,1111-1120 all render via show.
#Export(c) fn jet_rt_handle_clone_jet_task_status(value: I64) -> I64 { encoding_enum_clone(value) }
#Export(c) fn jet_rt_handle_drop_jet_task_status(value: I64) { encoding_enum_drop(value) }
#Export(c) fn jet_rt_handle_eq_jet_task_status(left: I64, right: I64) -> Bool { encoding_enum_eq(left, right) }
#Export(c) fn jet_rt_handle_show_jet_task_status(value: I64) -> I64 {
    kind :: encoding_word(value + ENCODING_ENUM_TAG)
    result :: jet_rt_string_builder_new()
    if (kind == I64{0}) {
        rt_text_push_word(result, I64{29113321704551762}, I64{7})
    } else if (kind == I64{1}) {
        rt_text_push_word(result, I64{110386891546960}, I64{6})
    } else {
        rt_text_push_word(result, I64{7301017128636670275}, I64{8})
        rt_text_push_word(result, I64{28259048497706353}, I64{7})
    }
    result
}
#Export(c) fn jet_rt_handle_debug_jet_task_status(value: I64) -> I64 { jet_rt_handle_show_jet_task_status(value) }
#Export(c) fn jet_rt_handle_display_jet_task_status(value: I64) -> I64 { jet_rt_handle_show_jet_task_status(value) }
