// The Rust original derives Clone/PartialEq over ordered (name,value) entries.
// Both fields are case-preserving text; equality does not use the case-insensitive
// lookup policy. The Rust original own the shell. Carrier is DataABI sequence24,
// not Rust Vec layout.
HTTP_HEADER_ENTRY_BYTES: I64{16}
HTTP_HEADER_NAME: I64{0}
HTTP_HEADER_VALUE: I64{8}
#Export(c) jet_rt_handle_clone_jet_http_headers: fn(value: I64) -> I64 {
    length: dyn_word(wrapping(value + DATA_SEQUENCE_LENGTH))
    result: data_sequence_new(length, HTTP_HEADER_ENTRY_BYTES)
    source: dyn_word(wrapping(value + DATA_SEQUENCE_DATA))
    target: dyn_word(wrapping(result + DATA_SEQUENCE_DATA))
    at := I64{0}
    loop at < length {
        input: wrapping(source + at * HTTP_HEADER_ENTRY_BYTES)
        output: wrapping(target + at * HTTP_HEADER_ENTRY_BYTES)
        dyn_store(wrapping(output + HTTP_HEADER_NAME), jet_rt_string_clone(dyn_word(wrapping(input + HTTP_HEADER_NAME))))
        dyn_store(wrapping(output + HTTP_HEADER_VALUE), jet_rt_string_clone(dyn_word(wrapping(input + HTTP_HEADER_VALUE))))
        at += I64{1}
    }
    dyn_store(wrapping(result + DATA_SEQUENCE_LENGTH), length)
    result
}
#Export(c) jet_rt_handle_drop_jet_http_headers: fn(value: I64) {
    if (value == I64{0}) -> return
    length: dyn_word(wrapping(value + DATA_SEQUENCE_LENGTH))
    capacity: dyn_word(wrapping(value + DATA_SEQUENCE_CAPACITY))
    data: dyn_word(wrapping(value + DATA_SEQUENCE_DATA))
    at := I64{0}
    loop at < length {
        entry: wrapping(data + at * HTTP_HEADER_ENTRY_BYTES)
        jet_rt_string_drop(dyn_word(wrapping(entry + HTTP_HEADER_NAME)))
        jet_rt_string_drop(dyn_word(wrapping(entry + HTTP_HEADER_VALUE)))
        at += I64{1}
    }
    if (capacity != I64{0}) -> jet_rt_free(data, capacity * HTTP_HEADER_ENTRY_BYTES, I64{8})
    jet_rt_free(value, DATA_SEQUENCE_BYTES, I64{8})
}
#Export(c) jet_rt_handle_eq_jet_http_headers: fn(left: I64, right: I64) -> Bool {
    length: dyn_word(wrapping(left + DATA_SEQUENCE_LENGTH))
    if (length != dyn_word(wrapping(right + DATA_SEQUENCE_LENGTH))) -> return false
    a: dyn_word(wrapping(left + DATA_SEQUENCE_DATA))
    b: dyn_word(wrapping(right + DATA_SEQUENCE_DATA))
    at := I64{0}
    loop at < length {
        offset: at * HTTP_HEADER_ENTRY_BYTES
        if !jet_rt_string_eq(dyn_word(wrapping(wrapping(a + offset) + HTTP_HEADER_NAME)), dyn_word(wrapping(wrapping(b + offset) + HTTP_HEADER_NAME))) -> return false
        if !jet_rt_string_eq(dyn_word(wrapping(wrapping(a + offset) + HTTP_HEADER_VALUE)), dyn_word(wrapping(wrapping(b + offset) + HTTP_HEADER_VALUE))) -> return false
        at += I64{1}
    }
    true
}
