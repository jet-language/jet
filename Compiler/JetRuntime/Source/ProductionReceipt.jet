// The development receipt of a production failure. `jet run` and `jet dev`
// give the program the JET_DEVELOPMENT_RECEIPT_* environment (JetCli
// ProductionReceipt.jet): the receipt directory, the project-relative entry,
// and digests of the run's source, closure, arguments and target. A root stop
// writes the receipt once, in the format Jetpack Foundation
// DevelopmentReceipt.jet renders: only those digests, the argument count, the
// target and the stop's code, file, line and function reach it, never its
// message, source text, locals, argument values or environment values. With no
// complete environment, or an unsafe directory, nothing is written.

// O_WRONLY|O_CREAT|O_EXCL|O_CLOEXEC.
PRODUCTION_RECEIPT_OPEN: I64{524481}
PRODUCTION_RECEIPT_CWD_BYTES: I64{4096}

// trap_header numbering: 0 E3001, 1 E3010, else E3011.
production_receipt_code: fn(code: I64) -> I64 {
    if (code == I64{0}) -> return rt_static_text("E3001")
    if (code == I64{1}) -> return rt_static_text("E3010")
    rt_static_text("E3011")
}

production_receipt_write: fn(code: I64, file: I64, file_len: I64, line: I64, function: I64, function_len: I64) {
    directory: rt_env_get(rt_static_text("JET_DEVELOPMENT_RECEIPT_DIRECTORY"))
    if (directory == I64{0}) -> return
    entry: rt_env_get(rt_static_text("JET_DEVELOPMENT_RECEIPT_ENTRY"))
    source: rt_env_get(rt_static_text("JET_DEVELOPMENT_RECEIPT_SOURCE_DIGEST"))
    closure: rt_env_get(rt_static_text("JET_DEVELOPMENT_RECEIPT_CLOSURE_DIGEST"))
    input: rt_env_get(rt_static_text("JET_DEVELOPMENT_RECEIPT_INPUT_DIGEST"))
    count: rt_env_get(rt_static_text("JET_DEVELOPMENT_RECEIPT_INPUT_COUNT"))
    count_digest: rt_env_get(rt_static_text("JET_DEVELOPMENT_RECEIPT_INPUT_COUNT_DIGEST"))
    target: rt_env_get(rt_static_text("JET_DEVELOPMENT_RECEIPT_TARGET"))
    target_digest: rt_env_get(rt_static_text("JET_DEVELOPMENT_RECEIPT_TARGET_DIGEST"))
    complete: entry != I64{0} && source != I64{0} && closure != I64{0} && input != I64{0} && count_digest != I64{0} && target != I64{0} && target_digest != I64{0} && production_receipt_count_ok(count)
    if complete {
        failure_file: production_receipt_path(file, file_len, entry)
        receipt: jet_rt_string_builder_new()
        jet_rt_string_builder_push(receipt, rt_static_text("jet-development-receipt-v1\n"))
        production_receipt_line(receipt, rt_static_text("act"), rt_static_text(""), rt_static_text("production-failure"))
        production_receipt_line(receipt, rt_static_text("closure"), rt_static_text(""), closure)
        // Ordered by (name, digest) as the renderer sorts them.
        production_receipt_line(receipt, rt_static_text("input"), rt_static_text("argv"), input)
        production_receipt_line(receipt, rt_static_text("input"), rt_static_text("argv-count"), count_digest)
        production_receipt_line(receipt, rt_static_text("input"), rt_static_text("entry"), source)
        production_receipt_line(receipt, rt_static_text("input"), rt_static_text("target"), target_digest)
        production_receipt_line(receipt, rt_static_text("action"), rt_static_text("planned"), rt_static_text("sha256-2baa4c66edeaf54e166ff66bdd4c914c3076a7621a98c90f9a577c9b825be3b3"))
        production_receipt_line(receipt, rt_static_text("activation-proof"), rt_static_text(""), rt_static_text("sha256-b8846cc6a6dfb698b445cafa1f316a814f70d56520598e8efcdbd42970999378"))
        production_receipt_line(receipt, rt_static_text("parent-generation"), rt_static_text(""), rt_static_text(""))
        witness: jet_rt_string_builder_new()
        jet_rt_string_builder_push(witness, rt_static_text("jet-runtime;target="))
        jet_rt_string_builder_push(witness, target)
        jet_rt_string_builder_push(witness, rt_static_text(";argv-count="))
        jet_rt_string_builder_push(witness, count)
        jet_rt_string_builder_push(witness, rt_static_text(";redaction=by-construction"))
        production_receipt_line(receipt, rt_static_text("witness"), rt_static_text(""), witness)
        jet_rt_string_drop(witness)
        production_receipt_line(receipt, rt_static_text("failure-path"), rt_static_text("code"), production_receipt_code(code))
        production_receipt_line(receipt, rt_static_text("failure-path"), rt_static_text("file"), failure_file)
        digits: jet_rt_string_builder_new()
        rt_text_push_number(digits, line)
        production_receipt_line(receipt, rt_static_text("failure-path"), rt_static_text("line"), digits)
        jet_rt_string_drop(digits)
        named: jet_rt_string_builder_new()
        if (function_len == I64{0}) -> jet_rt_string_builder_push(named, rt_static_text("<unknown>"))
        else -> rt_text_append(named, function, function_len)
        production_receipt_line(receipt, rt_static_text("failure-path"), rt_static_text("function"), named)
        jet_rt_string_drop(named)
        production_receipt_line(receipt, rt_static_text("outcome"), rt_static_text(""), rt_static_text("failed"))
        production_receipt_publish(directory, receipt)
        jet_rt_string_drop(receipt)
        jet_rt_string_drop(failure_file)
    }
    jet_rt_string_drop(directory)
    jet_rt_string_drop(entry)
    jet_rt_string_drop(source)
    jet_rt_string_drop(closure)
    jet_rt_string_drop(input)
    jet_rt_string_drop(count)
    jet_rt_string_drop(count_digest)
    jet_rt_string_drop(target)
    jet_rt_string_drop(target_digest)
}

// The argument count is a decimal number, as the CLI wrote it.
production_receipt_count_ok: fn(count: I64) -> Bool {
    if (count == I64{0}) -> return false
    length: rt_text_len(count)
    if (length == I64{0} || length > I64{19}) -> return false
    data: rt_text_data(count)
    at := I64{0}
    loop at < length {
        byte: rt_text_byte(wrapping(data + at))
        if (byte < I64{48} || byte > I64{57}) -> return false
        at += I64{1}
    }
    true
}

// One `kind\thex(name)\thex(value)\n` record line.
production_receipt_line: fn(target: I64, kind: I64, name: I64, value: I64) {
    jet_rt_string_builder_push(target, kind)
    rt_text_push_word(target, I64{9}, I64{1})
    production_receipt_hex(target, rt_text_data(name), rt_text_len(name))
    rt_text_push_word(target, I64{9}, I64{1})
    production_receipt_hex(target, rt_text_data(value), rt_text_len(value))
    rt_text_push_word(target, I64{10}, I64{1})
}

production_receipt_hex: fn(target: I64, data: I64, length: I64) {
    at := I64{0}
    loop at < length {
        byte: rt_text_byte(wrapping(data + at))
        high: byte >> I64{4}
        low: byte.bit_and(I64{15})
        rt_text_push_word(target, if (high < I64{10}) -> high + I64{48} else -> high + I64{87}, I64{1})
        rt_text_push_word(target, if (low < I64{10}) -> low + I64{48} else -> low + I64{87}, I64{1})
        at += I64{1}
    }
}

// The stop's file as the receipt names it: the entry when the stop has none;
// a `<…>` pseudo-file as it is; an absolute path relative to the working
// directory; `<external>` for a path outside it.
production_receipt_path: fn(file: I64, file_len: I64, entry: I64) -> I64 {
    data := file
    length := file_len
    if (length == I64{0}) {
        data = rt_text_data(entry)
        length = rt_text_len(entry)
    }
    out: jet_rt_string_builder_new()
    if (length == I64{0}) {
        jet_rt_string_builder_push(out, rt_static_text("<unknown>"))
        return out
    }
    if (rt_text_byte(data) == I64{60}) {
        rt_text_append(out, data, length)
        return out
    }
    start := I64{0}
    if (rt_text_byte(data) == I64{47}) {
        start = production_receipt_cwd_prefix(data, length)
        if (start < I64{0}) {
            jet_rt_string_builder_push(out, rt_static_text("<external>"))
            return out
        }
    }
    at := start
    loop at < length {
        byte: rt_text_byte(wrapping(data + at))
        rt_text_push_word(out, if (byte == I64{92}) -> I64{47} else -> byte, I64{1})
        at += I64{1}
    }
    if production_receipt_external(out) {
        jet_rt_string_drop(out)
        external: jet_rt_string_builder_new()
        jet_rt_string_builder_push(external, rt_static_text("<external>"))
        return external
    }
    out
}

// Empty, `.`, `..`, `../…` or `/…`: not a path inside the project.
production_receipt_external: fn(path: I64) -> Bool {
    length: rt_text_len(path)
    if (length == I64{0}) -> return true
    data: rt_text_data(path)
    first: rt_text_byte(data)
    if (first == I64{47}) -> return true
    if (first != I64{46}) -> return false
    if (length == I64{1}) -> return true
    second: rt_text_byte(wrapping(data + I64{1}))
    if (second != I64{46}) -> return false
    length == I64{2} || rt_text_byte(wrapping(data + I64{2})) == I64{47}
}

// How many leading bytes of the absolute path `data` name the working
// directory and its separator, or -1 when the path is not inside it.
production_receipt_cwd_prefix: fn(data: I64, length: I64) -> I64 {
    buffer: jet_rt_alloc(PRODUCTION_RECEIPT_CWD_BYTES, I64{8})
    // getcwd counts the NUL it wrote.
    written: host_call(I64{79}, buffer, PRODUCTION_RECEIPT_CWD_BYTES, I64{0})
    prefix := I64{-1}
    if (written > I64{1}) {
        cwd_len: written - I64{1}
        if (cwd_len == I64{1}) {
            prefix = I64{1}
        } else if (length > cwd_len && rt_text_equal_bytes(data, buffer, cwd_len) && rt_text_byte(wrapping(data + cwd_len)) == I64{47}) {
            prefix = cwd_len + I64{1}
        }
    }
    jet_rt_free(buffer, PRODUCTION_RECEIPT_CWD_BYTES, I64{8})
    prefix
}

// `directory/receipt`, created 0600 only when absent; an existing receipt
// (the first failure's) stays. The directory chain is created 0700 and never
// passes through a symbolic link.
production_receipt_publish: fn(directory: I64, receipt: I64) {
    if !receipt_section_directory(directory) -> return
    path: receipt_section_join(directory, rt_static_text("/"), rt_static_text("receipt"))
    name: fd_c_path(path)
    facts: jet_rt_alloc(I64{128}, I64{8})
    found: receipt_section_lstat(name, facts)
    jet_rt_free(facts, I64{128}, I64{8})
    if (found == I64{-2}) {
        fd: host_call(I64{2}, name, PRODUCTION_RECEIPT_OPEN, I64{384})
        if (fd >= I64{0}) {
            _ := receipt_section_write_all(fd, rt_text_data(receipt), rt_text_len(receipt))
            _ := host_call(I64{3}, fd, I64{0}, I64{0})
        }
    }
    fd_c_path_drop(name, path)
    jet_rt_string_drop(path)
}
