// Type-directed native List ownership. No erased callbacks/element casts.
// Every child is the private carrier declared in DataABI, never Rust/MIR.
fn data_plot_scales_clone(value: I64) -> I64 {
    length :: data_tree_word(value + DATA_SEQUENCE_LENGTH)
    result :: data_sequence_new(length, DATA_TREE_ELEMENT_BYTES)
    at := I64{0}
    loop at < length {
        data_plot_sequence_push(result, jet_rt_handle_clone_jet_data_plot_scale(data_tree_word(data_sequence_slot(value, at, DATA_TREE_ELEMENT_BYTES))))
        at += I64{1}
    }
    result
}
fn data_plot_scales_drop(value: I64) {
    length :: data_tree_word(value + DATA_SEQUENCE_LENGTH)
    at := I64{0}
    loop at < length {
        jet_rt_handle_drop_jet_data_plot_scale(data_tree_word(data_sequence_slot(value, at, DATA_TREE_ELEMENT_BYTES)))
        at += I64{1}
    }
    data_plot_sequence_shell_drop(value, DATA_TREE_ELEMENT_BYTES)
}
fn data_plot_scales_eq(a: I64, b: I64) -> Bool {
    length :: data_tree_word(a + DATA_SEQUENCE_LENGTH)
    if length != data_tree_word(b + DATA_SEQUENCE_LENGTH) -> return false
    at := I64{0}
    loop at < length {
        if !jet_rt_handle_eq_jet_data_plot_scale(data_tree_word(data_sequence_slot(a, at, DATA_TREE_ELEMENT_BYTES)), data_tree_word(data_sequence_slot(b, at, DATA_TREE_ELEMENT_BYTES))) -> return false
        at += I64{1}
    }
    true
}
