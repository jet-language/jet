// Rust Vec<i64> and unit-enum vectors store raw words, not Int/enum handles.
fn data_plot_words_clone(value: I64) -> I64 {
    length :: data_tree_word(value + DATA_SEQUENCE_LENGTH)
    result :: data_sequence_new(length, DATA_TREE_ELEMENT_BYTES)
    coll_copy(data_tree_word(value + DATA_SEQUENCE_DATA), data_tree_word(result + DATA_SEQUENCE_DATA), length * DATA_TREE_ELEMENT_BYTES)
    data_tree_store(result + DATA_SEQUENCE_LENGTH, length)
    result
}
fn data_plot_words_eq(a: I64, b: I64) -> Bool {
    length :: data_tree_word(a + DATA_SEQUENCE_LENGTH)
    if length != data_tree_word(b + DATA_SEQUENCE_LENGTH) -> return false
    ap :: data_tree_word(a + DATA_SEQUENCE_DATA)
    bp :: data_tree_word(b + DATA_SEQUENCE_DATA)
    at := I64{0}
    loop at < length {
        if data_tree_word(ap + at * DATA_TREE_ELEMENT_BYTES) != data_tree_word(bp + at * DATA_TREE_ELEMENT_BYTES) -> return false
        at += I64{1}
    }
    true
}
