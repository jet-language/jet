            error :: fd_word(row, I64{104})
            fd_put(row, I64{104}, I64{0})
            jet_rt_handle_drop_io_error(wait_error)
            return pipeline_fail(top, rows, error, err)
        }
        at -= I64{1}
    }
    // Drains: stdout first, then stderr in stage order (Process.rs:1399-1432).
    drained :: scratch + I64{16384}
    fd_put(drained, I64{0}, I64{0})
    if (fd_word(top, I64{16}) != I64{0}) {
        fd_put(drained, I64{0}, fd_word(top, I64{16}))
        fd_put(top, I64{16}, I64{0})
    } else {
        _ := process_execution_validate_text(fd_word(top, I64{8}), rt_static_text("pipeline stdout"), drained)
    }
    errors :: jet_rt_string_builder_new()
    at = I64{0}
    loop at < count {
        row :: pipeline_row(rows, at)
        failed := I64{0}
        if (fd_word(row, I64{120}) != I64{0}) {
            failed = fd_word(row, I64{120})
            fd_put(row, I64{120}, I64{0})
        } else {
            slot :: scratch + I64{16392}
            fd_put(slot, I64{0}, I64{0})
            if process_execution_validate_text(fd_word(row, I64{32}), rt_static_text("pipeline stderr"), slot) {
                text :: fd_word(row, I64{32})
                rt_text_append(errors, rt_text_data(text), rt_text_len(text))
            } else {
                failed = fd_word(slot, I64{0})
            }
        }
        if (failed != I64{0}) {
            if (fd_word(drained, I64{0}) == I64{0}) -> fd_put(drained, I64{0}, failed) else -> jet_rt_handle_drop_io_error(failed)
        }
        at += I64{1}
    }
    if (fd_word(drained, I64{0}) != I64{0}) {
        jet_rt_string_drop(errors)
        jet_rt_handle_drop_io_error(wait_error)
        return pipeline_fail(top, rows, fd_word(drained, I64{0}), err)
    }
    if (wait_error != I64{0}) {
        jet_rt_string_drop(errors)
        return pipeline_fail(top, rows, wait_error, err)
    }
    if (resource_limit >= I64{0}) {
        jet_rt_string_drop(errors)
        return pipeline_fail(top, rows, jet_rt_record_new_io_error_resource_limit(resource_limit), err)
    }
    if (fd_word(top, I64{40}) != I64{0} || output_limit_exceeded || fd_word(top, I64{24}) != I64{0}) {
        jet_rt_string_drop(errors)
        return pipeline_fail(top, rows, jet_rt_record_new_io_error_resource_limit(PROCESS_RESOURCE_OUTPUT), err)
    }
    output :: pipeline_text(fd_word(top, I64{8}))
    error_text :: pipeline_text(errors)
    jet_rt_string_drop(errors)
    secrets :: pipeline_secrets(specs, count)
    receipt :: process_receipt_build(fd_word(specs, (count - I64{1}) * I64{8}), I64{0}, code, success, I64{0}, timed_out, output, error_text, secrets)
    process_text_list_drop(secrets, false)
    jet_rt_string_drop(output)
    jet_rt_string_drop(error_text)
    pipeline_free(top, rows)
    fd_put(ok, I64{0}, receipt)
    I64{1}
}
