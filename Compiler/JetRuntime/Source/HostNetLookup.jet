// The platform resolver for Rust's LookupHost hints (AF_UNSPEC, SOCK_STREAM,
// no flags, no service): an IP literal, then /etc/hosts, then DNS through
// /etc/resolv.conf's nameservers and search list, ordered by musl's RFC 6724
// subset. Parsing, queries and transport are a port of musl 1.2.6's
// src/network/{lookup_name,lookup_ipliteral,inet_aton,if_nametoindex,
// resolvconf,res_mkquery,res_msend,dns_parse,gai_strerror}.c and the stdio
// fgets they read through (https://git.musl-libc.org/cgit/musl/tree/src?h=v1.2.6);
// the search follows Go's pure resolver instead (lk_dns, lk_dns_search): a
// failed candidate moves on to the next, either type's answer stands when
// the other fails, a name with ndots dots still tries the search list after
// itself, and .onion names never reach DNS. Like musl it reads no
// nsswitch.conf and never rotates nameservers, and it reads both files with
// plain system calls. Every socket wait is a poller readiness wait on the
// calling task, so no lookup blocks a carrier.
// Replies are checked as Go's dnsPacketRoundTrip and dnsStreamRoundTrip
// check them (lk_reply_for): a UDP packet that does not answer the question
// asked is ignored and the wait goes on, and such a TCP answer fails its
// query. A malformed answer is a non-recoverable failure, though the
// addresses read before the fault stand. Query ids are random.

LK_ADDRESSES: I64{48}
LK_ROW: I64{56}
LK_ANSWER: I64{4800}
LK_QUERY: I64{280}
LK_FRAME: I64{288}
LK_READ: I64{1024}

// musl's EAI codes.
LK_BADFLAGS: I64{-1}
LK_NONAME: I64{-2}
LK_AGAIN: I64{-3}
LK_FAIL: I64{-4}
LK_NODATA: I64{-5}
LK_SYSTEM: I64{-11}
// Outcomes beside musl's: the task's native propagate is set (LK_STOP), or a
// typed lookup was cancelled (LK_CANCEL) or passed its deadline (LK_TIMEOUT).
LK_STOP: I64{-1000}
LK_CANCEL: I64{-1001}
LK_TIMEOUT: I64{-1002}

// Look528: errno0 (musl's errno as the lookup leaves it), typed8,
// deadline16, owned Socket56 rows24 (48 entries), parsed answers32;
// resolv.conf's three Socket56 nameservers40, count208, ndots216,
// timeout224 (seconds), attempts232; inet_aton parts240..271; search
// list272..527 (NUL-terminated).
LK_ERRNO: I64{0}
LK_TYPED: I64{8}
LK_DEADLINE: I64{16}
LK_ROWS: I64{24}
LK_COUNT: I64{32}
LK_NS: I64{40}
LK_NNS: I64{208}
LK_NDOTS: I64{216}
LK_TIMEOUT_S: I64{224}
LK_ATTEMPTS: I64{232}
LK_PARTS: I64{240}
LK_SEARCH: I64{272}
LK_BYTES: I64{528}

// Queries10832 for res_msend: two 280-byte queries0, two 4800-byte
// answers560, two 288-byte TCP frames10160 (length prefix and query), then
// two-word arrays: query lengths10736, answer lengths10752 (0 none, -1 TCP
// pending, DQ_INVALID an invalid TCP answer), TCP FD72 states10768, TCP bytes
// sent10784, TCP bytes received10800, TCP length prefixes10816.
DQ_ANSWER: I64{560}
DQ_FRAME: I64{10160}
DQ_QLEN: I64{10736}
DQ_ALEN: I64{10752}
DQ_TCP: I64{10768}
DQ_SENT: I64{10784}
DQ_RECEIVED: I64{10800}
DQ_PREFIX: I64{10816}
DQ_BYTES: I64{10832}
DQ_INVALID: I64{-2}

lk_space: fn(c: I64) -> Bool { c == I64{32} || (c >= I64{9} && c <= I64{13}) }
lk_digit: fn(c: I64) -> Bool { c >= I64{48} && c <= I64{57} }
lk_digit_value: fn(c: I64) -> I64 {
    if (c >= I64{48} && c <= I64{57}) -> return c - I64{48}
    lower: c.bit_or(I64{32})
    if (lower >= I64{97} && lower <= I64{122}) -> return lower - I64{87}
    I64{99}
}
lk_errno: fn(look: I64, errno: I64) { net_put(look, LK_ERRNO, errno) }
lk_now_ms: fn() -> I64 { sync_now_ns() /% I64{1000000} }

lk_strlen: fn(text: I64) -> I64 {
    at := I64{0}
    loop rt_text_byte(wrapping(text + at)) != (I64{0}) -> at += I64{1}
    at
}
lk_strnlen: fn(text: I64, limit: I64) -> I64 {
    at := I64{0}
    loop at < limit && rt_text_byte(wrapping(text + at)) != (I64{0}) -> at += I64{1}
    at
}
// strchr for a nonzero byte: its index, or -1.
lk_strchr: fn(text: I64, byte: I64) -> I64 {
    at := I64{0}
    loop {
        c: rt_text_byte(wrapping(text + at))
        if (c == byte) -> return at
        if (c == I64{0}) -> return I64{-1}
        at += I64{1}
    }
}
lk_same: fn(left: I64, right: I64, length: I64) -> Bool {
    at := I64{0}
    loop at < length {
        if (rt_text_byte(wrapping(left + at)) != rt_text_byte(wrapping(right + at))) -> return false
        at += I64{1}
    }
    true
}
// strstr(text + from, needle) for a needle of `length` nonzero bytes: the
// match's index in `text`, or -1.
lk_find: fn(text: I64, from: I64, needle: I64, length: I64) -> I64 {
    at := from
    loop rt_text_byte(wrapping(text + at)) != (I64{0}) {
        if lk_same(wrapping(text + at), needle, length) -> return at
        at += I64{1}
    }
    I64{-1}
}
lk_prefix: fn(line: I64, word: I64) -> Bool { lk_same(line, rt_text_data(word), rt_text_len(word)) }

LkScan: struct { value: I64, end: I64 }

// musl strtoul/strtoull (src/internal/intscan.c) in base 0 (`any_base`) or
// 10: leading space and sign, then digits. `end` is the first unparsed byte,
// or `text` when no digit was read (errno EINVAL). Past the unsigned 64-bit
// range the value saturates to all ones with errno ERANGE.
lk_strtoul: fn(look: I64, text: I64, any_base: Bool) -> LkScan {
    at := text
    loop lk_space(rt_text_byte(at)) -> at = wrapping(at + I64{1})
    negative: rt_text_byte(at) == I64{45}
    if (negative || rt_text_byte(at) == I64{43}) -> at = wrapping(at + I64{1})
    base := I64{10}
    if (any_base && rt_text_byte(at) == I64{48}) {
        if (rt_text_byte(wrapping(at + I64{1})).bit_or(I64{32}) == I64{120}) {
            // "0x" without a hex digit scans as the lone 0.
            if (lk_digit_value(rt_text_byte(wrapping(at + I64{2}))) >= I64{16}) -> return LkScan{value: I64{0}, end: wrapping(at + I64{1})}
            base = I64{16}
            at = wrapping(at + I64{2})
        } else {
            base = I64{8}
        }
    } else if (lk_digit_value(rt_text_byte(at)) >= base) {
        lk_errno(look, I64{22})
        return LkScan{value: I64{0}, end: text}
    }
    // The largest value that takes one more digit, and that digit's bound.
    limit: if (base == I64{8}) -> I64{2305843009213693951} else if (base == I64{10}) -> I64{1844674407370955161} else -> I64{1152921504606846975}
    last: if (base == I64{10}) -> I64{5} else -> base - I64{1}
    value := I64{0}
    over := false
    loop {
        digit: lk_digit_value(rt_text_byte(at))
        if (digit >= base) -> break
        if !over {
            if (value < I64{0} || value > limit || (value == limit && digit > last)) {
                over = true
            } else {
                value = wrapping(value * base + digit)
            }
        }
        at = wrapping(at + I64{1})
    }
    if over {
        lk_errno(look, I64{34})
        return LkScan{value: I64{-1}, end: at}
    }
    LkScan{value: if negative -> wrapping(I64{0} - value) else -> value, end: at}
}

// musl __inet_aton: one to four numbers of any base, the last filling the
// remaining bytes; each part must start with a digit.
lk_inet_aton: fn(look: I64, text: I64, output: I64) -> Bool {
    parts: wrapping(look + LK_PARTS)
    thread_zero(parts, I64{32})
    s := text
    index := I64{0}
    loop index < (I64{4}) {
        scan: lk_strtoul(look, s, true)
        stop: rt_text_byte(scan.end)
        if (scan.end == s || (stop != I64{0} && stop != I64{46}) || !lk_digit(rt_text_byte(s))) -> return false
        net_put(parts, index * I64{8}, scan.value)
        if (stop == I64{0}) -> break
        s = wrapping(scan.end + I64{1})
        index += I64{1}
    }
    if (index == I64{4}) -> return false
    a0 := net_word(parts, I64{0})
    a1 := net_word(parts, I64{8})
    a2 := net_word(parts, I64{16})
    a3 := net_word(parts, I64{24})
    // A part past 2^63 fails the byte check whatever shift it takes.
    if (a0 < I64{0} || a1 < I64{0} || a2 < I64{0} || a3 < I64{0}) -> return false
    if (index == I64{0}) {
        a1 = a0.bit_and(I64{16777215})
        a0 = a0 >> I64{24}
    }
    if (index <= I64{1}) {
        a2 = a1.bit_and(I64{65535})
        a1 = a1 >> I64{16}
    }
    if (index <= I64{2}) {
        a3 = a2.bit_and(I64{255})
        a2 = a2 >> I64{8}
    }
    if (a0 > I64{255} || a1 > I64{255} || a2 > I64{255} || a3 > I64{255}) -> return false
    rt_text_put(output, a0)
    rt_text_put(wrapping(output + I64{1}), a1)
    rt_text_put(wrapping(output + I64{2}), a2)
    rt_text_put(wrapping(output + I64{3}), a3)
    true
}

// musl if_nametoindex: SIOCGIFINDEX through an AF_UNIX datagram socket; 0
// when either call fails.
lk_if_index: fn(look: I64, name: I64) -> I64 {
    fd := I64{0}
    #Unsafe("socket(AF_UNIX, SOCK_DGRAM|SOCK_CLOEXEC, 0) takes no pointer") {
        fd = os_syscall_i64(I64{41}, I64{1}, I64{524290}, I64{0}, I64{0}, I64{0}, I64{0})
    }
    if (fd < I64{0}) {
        lk_errno(look, I64{0} - fd)
        return I64{0}
    }
    request: jet_rt_alloc(I64{40}, I64{8})
    thread_zero(request, I64{40})
    at := I64{0}
    loop at < (I64{16}) && rt_text_byte(wrapping(name + at)) != (I64{0}) {
        rt_text_put(wrapping(request + at), rt_text_byte(wrapping(name + at)))
        at += I64{1}
    }
    result := I64{0}
    #Unsafe("ioctl(SIOCGIFINDEX) reads and writes exactly the owned 40-byte ifreq; close releases the descriptor opened here") {
        result = os_syscall_i64(I64{16}, fd, I64{35123}, request, I64{0}, I64{0}, I64{0})
        _ := os_syscall_i64(I64{3}, fd, I64{0}, I64{0}, I64{0}, I64{0}, I64{0})
    }
    index := I64{0}
    if (result < I64{0}) { lk_errno(look, I64{0} - result) } else { index = net_load_uint(wrapping(request + I64{16}), I64{4}) }
    jet_rt_free(request, I64{40}, I64{8})
    index
}

// musl __lookup_ipliteral for AF_UNSPEC into the Socket56 `row`: 1 for an
// inet_aton or inet_pton address (with any %scope), 0 when `name` is no
// literal, EAI_NONAME for a scope it cannot use.
lk_ipliteral: fn(look: I64, name: I64, row: I64) -> I64 {
    thread_zero(row, LK_ROW)
    if lk_inet_aton(look, name, wrapping(row + I64{8})) {
        net_put(row, I64{0}, I64{4})
        return I64{1}
    }
    percent: lk_strchr(name, I64{37})
    text := name
    head := I64{0}
    if (percent >= I64{0} && percent < I64{64}) {
        head = jet_rt_alloc(I64{64}, I64{1})
        rt_text_bytes_copy(head, name, percent)
        rt_text_put(wrapping(head + percent), I64{0})
        text = head
    }
    parsed: net_i32(net_route_inet_pton(I64{10}, text, wrapping(row + I64{8}))) == I64{1}
    if (head != I64{0}) -> jet_rt_free(head, I64{64}, I64{1})
    if !parsed -> return I64{0}
    net_put(row, I64{0}, I64{6})
    if (percent < I64{0}) -> return I64{1}
    p: wrapping(wrapping(name + percent) + I64{1})
    scope := I64{0}
    stop := wrapping(p - I64{1})
    if lk_digit(rt_text_byte(p)) {
        scan: lk_strtoul(look, p, false)
        scope = scan.value
        stop = scan.end
    }
    if (rt_text_byte(stop) != I64{0}) {
        b0: rt_text_byte(wrapping(row + I64{8}))
        b1: rt_text_byte(wrapping(row + I64{9}))
        link_local: b0 == I64{254} && b1.bit_and(I64{192}) == I64{128}
        multicast_link_local: b0 == I64{255} && b1.bit_and(I64{15}) == I64{2}
        if (!link_local && !multicast_link_local) -> return LK_NONAME
        scope = lk_if_index(look, p)
        if (scope == I64{0}) -> return LK_NONAME
    }
    if (scope < I64{0} || scope > I64{4294967295}) -> return LK_NONAME
    net_put(row, I64{40}, scope)
    I64{1}
}

// Reader48 over one read-only descriptor, as musl's FILE: fd0, buffer8
// (LK_READ bytes), position16, end24, end-of-file32.
lk_open: fn(look: I64, path: I64) -> I64 {
    name: fd_c_path(path)
    fd := I64{0}
    #Unsafe("open(2) reads the owned NUL-terminated path; O_RDONLY|O_CLOEXEC retains no pointer") {
        fd = os_syscall_i64(I64{2}, name, I64{524288}, I64{0}, I64{0}, I64{0}, I64{0})
    }
    fd_c_path_drop(name, path)
    if (fd < I64{0}) {
        lk_errno(look, I64{0} - fd)
        return I64{0}
    }
    reader: jet_rt_alloc(I64{48}, I64{8})
    thread_zero(reader, I64{48})
    net_put(reader, I64{0}, fd)
    net_put(reader, I64{8}, jet_rt_alloc(LK_READ, I64{1}))
    reader
}
lk_close: fn(reader: I64) {
    #Unsafe("close(2) releases the descriptor lk_open opened") {
        _ := os_syscall_i64(I64{3}, net_word(reader, I64{0}), I64{0}, I64{0}, I64{0}, I64{0}, I64{0})
    }
    jet_rt_free(net_word(reader, I64{8}), LK_READ, I64{1})
    jet_rt_free(reader, I64{48}, I64{8})
}
lk_eof: fn(reader: I64) -> Bool { net_word(reader, I64{32}) != I64{0} }
// getc: the next byte, or -1 at end of file (which sticks) or on a read
// error (which a later call retries, as musl's does).
lk_getc: fn(look: I64, reader: I64) -> I64 {
    buffer: net_word(reader, I64{8})
    if (net_word(reader, I64{16}) == net_word(reader, I64{24})) {
        if lk_eof(reader) -> return I64{-1}
        count := I64{0}
        #Unsafe("read(2) fills at most LK_READ bytes of the reader's owned buffer") {
            count = os_syscall_i64(I64{0}, net_word(reader, I64{0}), buffer, LK_READ, I64{0}, I64{0}, I64{0})
        }
        if (count <= I64{0}) {
            if (count == I64{0}) { net_put(reader, I64{32}, I64{1}) } else { lk_errno(look, I64{0} - count) }
            return I64{-1}
        }
        net_put(reader, I64{16}, I64{0})
        net_put(reader, I64{24}, count)
    }
    at: net_word(reader, I64{16})
    net_put(reader, I64{16}, at + I64{1})
    rt_text_byte(wrapping(buffer + at))
}
// fgets: at most size-1 bytes through the first newline, NUL-terminated;
// false at end of file with nothing read, or after a read error.
lk_fgets: fn(look: I64, reader: I64, line: I64, size: I64) -> Bool {
    room := size - I64{1}
    at := I64{0}
    loop room > (I64{0}) {
        c: lk_getc(look, reader)
        if (c < I64{0}) {
            if (at == I64{0} || !lk_eof(reader)) -> return false
            break
        }
        rt_text_put(wrapping(line + at), c)
        at += I64{1}
        room -= I64{1}
        if (c == I64{10}) -> break
    }
    rt_text_put(wrapping(line + at), I64{0})
    true
}

// musl name_from_hosts: each /etc/hosts line naming `name` (case-sensitive,
// space-delimited, after the first column) adds its address. A missing or
// unreadable file is no answer.
lk_hosts: fn(look: I64, name: I64, rows: I64) -> I64 {
    length: lk_strlen(name)
    reader: lk_open(look, rt_static_text("/etc/hosts"))
    if (reader == I64{0}) {
        errno: net_word(look, LK_ERRNO)
        if (errno == I64{2} || errno == I64{20} || errno == I64{13}) -> return I64{0}
        return LK_SYSTEM
    }
    line: jet_rt_alloc(I64{512}, I64{1})
    thread_zero(line, I64{512})
    count := I64{0}
    bad := I64{0}
    loop lk_fgets(look, reader, line, I64{512}) && count < LK_ADDRESSES {
        hash: lk_strchr(line, I64{35})
        if (hash >= I64{0}) {
            rt_text_put(wrapping(line + hash), I64{10})
            rt_text_put(wrapping(wrapping(line + hash) + I64{1}), I64{0})
        }
        at := I64{1}
        found := false
        loop {
            match: lk_find(line, at, name, length)
            if (match < I64{0}) -> break
            if (lk_space(rt_text_byte(wrapping(wrapping(line + match) - I64{1}))) && lk_space(rt_text_byte(wrapping(wrapping(line + match) + length)))) {
                found = true
                break
            }
            at = match + I64{1}
        }
        if !found -> next
        end := I64{0}
        loop rt_text_byte(wrapping(line + end)) != (I64{0}) && !lk_space(rt_text_byte(wrapping(line + end))) -> end += I64{1}
        rt_text_put(wrapping(line + end), I64{0})
        result: lk_ipliteral(look, line, wrapping(rows + count * LK_ROW))
        if (result == I64{1}) {
            count += I64{1}
        } else if (result != I64{0}) {
            bad = LK_NODATA
        }
    }
    lk_close(reader)
    jet_rt_free(line, I64{512}, I64{1})
    if (count != I64{0}) -> count else -> bad
}

// One `options` key: a number (or, for timeout:, a leading '.') capped at `cap`.
lk_option: fn(look: I64, line: I64, key: I64, offset: I64, cap: I64, dot: Bool) {
    length: rt_text_len(key)
    at: lk_find(line, I64{0}, rt_text_data(key), length)
    if (at < I64{0}) -> return
    p: wrapping(wrapping(line + at) + length)
    c: rt_text_byte(p)
    if (!lk_digit(c) && !(dot && c == I64{46})) -> return
    scan: lk_strtoul(look, p, false)
    if (scan.end == p) -> return
    net_put(look, offset, if (scan.value < I64{0} || scan.value > cap) -> cap else -> scan.value)
}

// musl __get_resolv_conf: ndots 1, timeout 5, attempts 2 and 127.0.0.1
// unless /etc/resolv.conf says otherwise; 0, or -1 when it cannot be read.
lk_resolv_conf: fn(look: I64) -> I64 {
    net_put(look, LK_NDOTS, I64{1})
    net_put(look, LK_TIMEOUT_S, I64{5})
    net_put(look, LK_ATTEMPTS, I64{2})
    search: wrapping(look + LK_SEARCH)
    rt_text_put(search, I64{0})
    count := I64{0}
    reader: lk_open(look, rt_static_text("/etc/resolv.conf"))
    if (reader == I64{0}) {
        errno: net_word(look, LK_ERRNO)
        if (errno != I64{2} && errno != I64{20} && errno != I64{13}) -> return I64{-1}
    } else {
        line: jet_rt_alloc(I64{256}, I64{1})
        thread_zero(line, I64{256})
        loop lk_fgets(look, reader, line, I64{256}) {
            if (lk_strchr(line, I64{10}) < I64{0} && !lk_eof(reader)) {
                // A truncated line is skipped rather than misread.
                loop {
                    c: lk_getc(look, reader)
                    if (c == I64{10} || c < I64{0}) -> break
                }
                next
            }
            if (lk_prefix(line, rt_static_text("options")) && lk_space(rt_text_byte(wrapping(line + I64{7})))) {
                lk_option(look, line, rt_static_text("ndots:"), LK_NDOTS, I64{15}, false)
                lk_option(look, line, rt_static_text("attempts:"), LK_ATTEMPTS, I64{10}, false)
                lk_option(look, line, rt_static_text("timeout:"), LK_TIMEOUT_S, I64{60}, true)
                next
            }
            if (lk_prefix(line, rt_static_text("nameserver")) && lk_space(rt_text_byte(wrapping(line + I64{10})))) {
                if (count >= I64{3}) -> next
                p := wrapping(line + I64{11})
                loop lk_space(rt_text_byte(p)) -> p = wrapping(p + I64{1})
                stop := p
                loop rt_text_byte(stop) != (I64{0}) && !lk_space(rt_text_byte(stop)) -> stop = wrapping(stop + I64{1})
                rt_text_put(stop, I64{0})
                if (lk_ipliteral(look, p, wrapping(wrapping(look + LK_NS) + count * LK_ROW)) > I64{0}) -> count += I64{1}
                next
            }
            if (!lk_prefix(line, rt_static_text("domain")) && !lk_prefix(line, rt_static_text("search"))) -> next
            if !lk_space(rt_text_byte(wrapping(line + I64{6}))) -> next
            p := wrapping(line + I64{7})
            loop lk_space(rt_text_byte(p)) -> p = wrapping(p + I64{1})
            length: lk_strlen(p)
            if (length >= I64{256}) -> next
            rt_text_bytes_copy(search, p, length + I64{1})
        }
        lk_close(reader)
        jet_rt_free(line, I64{256}, I64{1})
    }
    if (count == I64{0}) {
        loopback: rt_static_text("127.0.0.1")
        text: fd_c_path(loopback)
        _ := lk_ipliteral(look, text, wrapping(look + LK_NS))
        fd_c_path_drop(text, loopback)
        count = I64{1}
    }
    net_put(look, LK_NNS, count)
    I64{0}
}

// musl __res_mkquery(QUERY, name, IN, kind): the query's length, or -1.
lk_mkquery: fn(name: I64, kind: I64, query: I64) -> I64 {
    length := lk_strnlen(name, I64{255})
    if (length > I64{0} && rt_text_byte(wrapping(wrapping(name + length) - I64{1})) == I64{46}) -> length -= I64{1}
    if (length > I64{0} && rt_text_byte(wrapping(wrapping(name + length) - I64{1})) == I64{46}) -> return I64{-1}
    size: I64{17} + length + (if (length > I64{0}) -> I64{1} else -> I64{0})
    if (length > I64{253}) -> return I64{-1}
    thread_zero(query, LK_QUERY)
    rt_text_put(wrapping(query + I64{2}), I64{1})
    rt_text_put(wrapping(query + I64{3}), I64{32})
    rt_text_put(wrapping(query + I64{5}), I64{1})
    rt_text_bytes_copy(wrapping(query + I64{13}), name, length)
    at := I64{13}
    loop rt_text_byte(wrapping(query + at)) != (I64{0}) {
        end := at
        loop rt_text_byte(wrapping(query + end)) != (I64{0}) && rt_text_byte(wrapping(query + end)) != (I64{46}) -> end += I64{1}
        if (end - at == I64{0} || end - at > I64{63}) -> return I64{-1}
        rt_text_put(wrapping(wrapping(query + at) - I64{1}), end - at)
        at = end + I64{1}
    }
    rt_text_put(wrapping(wrapping(query + at) + I64{1}), kind)
    rt_text_put(wrapping(wrapping(query + at) + I64{3}), I64{1})
    // Go's id: random (the kernel's getrandom), so an off-path sender cannot
    // guess it; musl's realtime-clock nanoseconds only when that fails.
    id := I64{0}
    random: jet_rt_alloc(I64{8}, I64{8})
    thread_zero(random, I64{8})
    if (rt_crypto_entropy_fill(random, I64{2}) == I64{0}) {
        id = net_load_uint(random, I64{2})
    } else {
        clock: jet_rt_alloc(I64{16}, I64{8})
        sync_clock_read(I64{0}, clock)
        nanoseconds: net_word(clock, I64{8})
        jet_rt_free(clock, I64{16}, I64{8})
        id = (nanoseconds + nanoseconds /% I64{65536}).bit_and(I64{65535})
    }
    jet_rt_free(random, I64{8}, I64{8})
    rt_text_put(query, id >> I64{8})
    rt_text_put(wrapping(query + I64{1}), id.bit_and(I64{255}))
    size
}

// One readiness wait of at most `milliseconds` on the calling task: >0
// ready, 0 not ready. An untyped lookup waits as host_net_ready does, the
// task's own cancel and deadline ending it with LK_STOP; a typed one waits
// shielded in 10 ms slices and reports its own cancel or deadline.
lk_wait: fn(look: I64, state: I64, interest: I64, milliseconds: I64) -> I64 {
    error: jet_rt_alloc(I64{32}, I64{8})
    thread_zero(error, I64{32})
    budget: if (milliseconds < I64{0}) -> I64{0} else -> milliseconds * I64{1000000}
    result := I64{0}
    if (net_word(look, LK_TYPED) == I64{0}) {
        ready: host_net_ready(state, interest, budget, host_net_wait_kind(), error)
        if (jet_scheduler_native_propagate() != I64{0}) { result = LK_STOP } else if (ready > I64{0}) { result = ready }
    } else {
        until: sync_now_ns() + budget
        deadline: net_word(look, LK_DEADLINE)
        loop {
            if (scheduler_task_cancelled() && !scheduler_shielded()) {
                result = LK_CANCEL
                break
            }
            now: sync_now_ns()
            if (now >= deadline) {
                result = LK_TIMEOUT
                break
            }
            slice := until - now
            if (deadline - now < slice) -> slice = deadline - now
            if (slice > I64{10000000}) -> slice = I64{10000000}
            if (slice < I64{0}) -> slice = I64{0}
            // Leaving without delivery: this lookup reports its own cancel.
            jet_scheduler_shield_enter()
            ready: host_net_ready(state, interest, slice, host_net_wait_kind(), error)
            scheduler_shield_leave_finished()
            if (jet_scheduler_native_propagate() != I64{0}) {
                result = LK_STOP
                break
            }
            if (ready > I64{0}) {
                result = ready
                break
            }
            if (sync_now_ns() >= until) -> break
        }
    }
    jet_rt_free(error, I64{32}, I64{8})
    result
}

lk_send_to: fn(state: I64, data: I64, length: I64, address: I64, flags: I64) -> I64 {
    scratch: jet_rt_alloc(I64{32}, I64{8})
    size: jet_socket_address_encode_raw(address, scratch)
    result: net_socket_call(state, I64{44}, data, length, flags, scratch, size)
    jet_rt_free(scratch, I64{32}, I64{8})
    result
}
// recvfrom with MSG_TRUNC: the datagram's full length (at most `length`
// bytes stored) and its sender in Socket56 `from`, or -errno.
lk_receive: fn(state: I64, data: I64, length: I64, from: I64) -> I64 {
    scratch: jet_rt_alloc(I64{64}, I64{8})
    size: wrapping(scratch + I64{32})
    net_store_uint(size, I64{4}, I64{32})
    result := net_socket_call(state, I64{45}, data, length, I64{32}, scratch, size)
    if (result >= I64{0} && !net_socket_decode(scratch, net_load_uint(size, I64{4}), from)) -> result = I64{-22}
    jet_rt_free(scratch, I64{64}, I64{8})
    result
}
lk_same_address: fn(left: I64, right: I64) -> Bool {
    at := I64{0}
    loop at < LK_ROW {
        if (net_word(left, at) != net_word(right, at)) -> return false
        at += I64{8}
    }
    true
}

dq_query: fn(queries: I64, index: I64) -> I64 { wrapping(queries + index * LK_QUERY) }
dq_answer: fn(queries: I64, index: I64) -> I64 { wrapping(wrapping(queries + DQ_ANSWER) + index * LK_ANSWER) }
dq_get: fn(queries: I64, base: I64, index: I64) -> I64 { net_word(queries, base + index * I64{8}) }
dq_set: fn(queries: I64, base: I64, index: I64, value: I64) { net_put(queries, base + index * I64{8}, value) }

// Go's checkResponse: `reply` (length bytes) answers `query` (qlength bytes)
// when it is at least a header long, has the QR bit and the query's id, and
// holds exactly one question, the query's own: the same name ignoring ASCII
// case (label lengths stay below 'A'), then the same type and class.
lk_reply_for: fn(reply: I64, length: I64, query: I64, qlength: I64) -> Bool {
    if (length < I64{12} || length < qlength) -> return false
    if (rt_text_byte(wrapping(reply + I64{2})).bit_and(I64{128}) == I64{0}) -> return false
    if (rt_text_byte(reply) != rt_text_byte(query) || rt_text_byte(wrapping(reply + I64{1})) != rt_text_byte(wrapping(query + I64{1}))) -> return false
    if (rt_text_byte(wrapping(reply + I64{4})) != I64{0} || rt_text_byte(wrapping(reply + I64{5})) != I64{1}) -> return false
    at := I64{12}
    loop at < qlength {
        left := rt_text_byte(wrapping(reply + at))
        right := rt_text_byte(wrapping(query + at))
        if (at < qlength - I64{4}) {
            if (left >= I64{65} && left <= I64{90}) -> left += I64{32}
            if (right >= I64{65} && right <= I64{90}) -> right += I64{32}
        }
        if (left != right) -> return false
        at += I64{1}
    }
    true
}

// res_msend's start_tcp: the length-prefixed query sent with the SYN where
// TCP Fast Open allows, else a nonblocking connect; the send pass writes what
// is left. A stream that cannot start leaves the answer pending (-1).
lk_tcp_start: fn(look: I64, queries: I64, index: I64, family: I64, server: I64) {
    length: dq_get(queries, DQ_QLEN, index)
    frame: wrapping(wrapping(queries + DQ_FRAME) + index * LK_FRAME)
    rt_text_put(frame, length >> I64{8})
    rt_text_put(wrapping(frame + I64{1}), length.bit_and(I64{255}))
    rt_text_bytes_copy(wrapping(frame + I64{2}), dq_query(queries, index), length)
    error: jet_rt_alloc(I64{32}, I64{8})
    thread_zero(error, I64{32})
    stream: jet_socket_create_raw(family, I64{1}, I64{0}, error)
    if (stream == I64{0}) {
        lk_errno(look, net_word(error, I64{8}))
        jet_rt_free(error, I64{32}, I64{8})
        return
    }
    sent := I64{-1}
    // TCP_FASTOPEN_CONNECT, then sendto with MSG_FASTOPEN|MSG_NOSIGNAL.
    if (jet_socket_option_set_raw(stream, I64{6}, I64{30}, I64{1}, error) >= I64{0}) {
        result: lk_send_to(stream, frame, length + I64{2}, server, I64{536887296})
        if (result >= I64{0}) {
            sent = result
        } else {
            lk_errno(look, I64{0} - result)
            if (result == I64{-115}) -> sent = I64{0}
        }
    } else {
        lk_errno(look, net_word(error, I64{8}))
    }
    if (sent < I64{0}) {
        if (jet_socket_connect_raw(stream, server, error) < I64{0}) {
            errno: net_word(error, I64{8})
            lk_errno(look, errno)
            if (errno != I64{115}) {
                jet_fd_drop_raw(stream)
                jet_rt_free(error, I64{32}, I64{8})
                return
            }
        }
        sent = I64{0}
    }
    jet_rt_free(error, I64{32}, I64{8})
    dq_set(queries, DQ_TCP, index, stream)
    dq_set(queries, DQ_SENT, index, sent)
    dq_set(queries, DQ_RECEIVED, index, I64{0})
}
// Writes what the stream takes of the frame; false when the write failed
// (musl's `goto out`).
lk_tcp_send: fn(look: I64, queries: I64, index: I64, stream: I64) -> Bool {
    total: dq_get(queries, DQ_QLEN, index) + I64{2}
    frame: wrapping(wrapping(queries + DQ_FRAME) + index * LK_FRAME)
    loop dq_get(queries, DQ_SENT, index) < total {
        sent: dq_get(queries, DQ_SENT, index)
        result: net_socket_call(stream, I64{44}, wrapping(frame + sent), total - sent, I64{16384}, I64{0}, I64{0})
        if (result == I64{-11}) -> return true
        if (result < I64{0}) {
            lk_errno(look, I64{0} - result)
            return false
        }
        dq_set(queries, DQ_SENT, index, sent + result)
    }
    true
}
// Reads what the stream has of the length-prefixed answer, committing it
// once complete; false for an error or end of stream (musl's `goto out`).
// As in Go's dnsStreamRoundTrip, an answer shorter than a header or not the
// reply to this query fails the query (lk_tcp_invalid); any rcode stands.
lk_tcp_receive: fn(look: I64, queries: I64, index: I64, stream: I64) -> Bool {
    prefix: wrapping(wrapping(queries + DQ_PREFIX) + index * I64{8})
    answer: dq_answer(queries, index)
    loop {
        received: dq_get(queries, DQ_RECEIVED, index)
        result: if (received < I64{2}) -> net_socket_call(stream, I64{45}, wrapping(prefix + received), I64{2} - received, I64{0}, I64{0}, I64{0}) else -> net_socket_call(stream, I64{45}, wrapping(answer + (received - I64{2})), LK_ANSWER - (received - I64{2}), I64{0}, I64{0}, I64{0})
        if (result == I64{-11}) -> return true
        if (result <= I64{0}) {
            if (result < I64{0}) -> lk_errno(look, I64{0} - result)
            return false
        }
        total: received + result
        dq_set(queries, DQ_RECEIVED, index, total)
        if (total < I64{2}) -> next
        length: rt_text_byte(prefix) * I64{256} + rt_text_byte(wrapping(prefix + I64{1}))
        if (length < I64{12}) -> return lk_tcp_invalid(queries, index, stream)
        if (total < length + I64{2} && total < LK_ANSWER + I64{2}) -> next
        kept: if (length > LK_ANSWER) -> LK_ANSWER else -> length
        if !lk_reply_for(answer, kept, dq_query(queries, index), dq_get(queries, DQ_QLEN, index)) -> return lk_tcp_invalid(queries, index, stream)
        dq_set(queries, DQ_ALEN, index, length)
        jet_fd_drop_raw(stream)
        dq_set(queries, DQ_TCP, index, I64{0})
        return true
    }
}
// Go's errInvalidDNSResponse: the query is done, with no answer (DQ_INVALID),
// and its stream is closed; the other query goes on.
lk_tcp_invalid: fn(queries: I64, index: I64, stream: I64) -> Bool {
    dq_set(queries, DQ_ALEN, index, DQ_INVALID)
    jet_fd_drop_raw(stream)
    dq_set(queries, DQ_TCP, index, I64{0})
    true
}

// musl __res_msend_rc: every query to every nameserver over one UDP socket,
// resent each timeout/attempts interval, a SERVFAIL retried at once (twice
// per query per round), a truncated answer retried over TCP. 0 with the
// answer lengths set (0 for none), -1 when no socket could be set up, or an
// LK_STOP/LK_CANCEL/LK_TIMEOUT from a wait.
lk_msend: fn(look: I64, queries: I64, count: I64) -> I64 {
    timeout: I64{1000} * net_word(look, LK_TIMEOUT_S)
    attempts: net_word(look, LK_ATTEMPTS)
    if (attempts == I64{0}) -> return I64{-1}
    nns: net_word(look, LK_NNS)
    servers: jet_rt_alloc(I64{3} * LK_ROW, I64{8})
    coll_copy(wrapping(look + LK_NS), servers, I64{3} * LK_ROW)
    family := I64{4}
    j := I64{0}
    loop j < nns {
        net_put(wrapping(servers + j * LK_ROW), I64{24}, I64{53})
        if (net_word(wrapping(servers + j * LK_ROW), I64{0}) == I64{6}) -> family = I64{6}
        j += I64{1}
    }
    error: jet_rt_alloc(I64{32}, I64{8})
    thread_zero(error, I64{32})
    socket := jet_socket_create_raw(family, I64{2}, I64{0}, error)
    if (socket == I64{0} && family == I64{6} && net_word(error, I64{8}) == I64{97}) {
        // Without IPv6, only a list holding an IPv4 server goes on (over IPv4).
        lk_errno(look, I64{97})
        j = I64{0}
        loop j < nns && net_word(wrapping(servers + j * LK_ROW), I64{0}) == (I64{6}) -> j += I64{1}
        if (j == nns) {
            jet_rt_free(error, I64{32}, I64{8})
            jet_rt_free(servers, I64{3} * LK_ROW, I64{8})
            return I64{-1}
        }
        socket = jet_socket_create_raw(I64{4}, I64{2}, I64{0}, error)
        family = I64{4}
    }
    bound := I64{-1}
    if (socket != I64{0}) {
        if (family == I64{6}) {
            if (jet_socket_option_set_raw(socket, I64{41}, I64{26}, I64{0}, error) < I64{0}) -> lk_errno(look, net_word(error, I64{8}))
            // IPv4 servers become v4-mapped on the dual-stack socket.
            j = I64{0}
            loop j < nns {
                server: wrapping(servers + j * LK_ROW)
                if (net_word(server, I64{0}) == I64{4}) {
                    address: net_load_uint(wrapping(server + I64{8}), I64{4})
                    thread_zero(wrapping(server + I64{8}), I64{16})
                    rt_text_put(wrapping(server + I64{18}), I64{255})
                    rt_text_put(wrapping(server + I64{19}), I64{255})
                    net_store_uint(wrapping(server + I64{20}), I64{4}, address)
                    net_put(server, I64{0}, I64{6})
                    net_put(server, I64{32}, I64{0})
                    net_put(server, I64{40}, I64{0})
                }
                j += I64{1}
            }
        }
        any: jet_rt_alloc(LK_ROW, I64{8})
        thread_zero(any, LK_ROW)
        net_put(any, I64{0}, family)
        bound = jet_socket_bind_raw(socket, any, error)
        jet_rt_free(any, LK_ROW, I64{8})
    }
    if (bound < I64{0}) {
        stopped: jet_scheduler_native_propagate() != I64{0}
        if !stopped -> lk_errno(look, net_word(error, I64{8}))
        jet_fd_drop_raw(socket)
        jet_rt_free(error, I64{32}, I64{8})
        jet_rt_free(servers, I64{3} * LK_ROW, I64{8})
        return if stopped -> LK_STOP else -> I64{-1}
    }
    from: jet_rt_alloc(LK_ROW, I64{8})
    thread_zero(from, LK_ROW)
    retry: timeout /% attempts
    head := I64{0}
    t0: lk_now_ms()
    t2 := t0
    t1 := t2 - retry
    servfail := I64{0}
    listening := true
    outcome := I64{0}
    loop t2 - t0 < timeout {
        answered := I64{0}
        loop answered < count && (dq_get(queries, DQ_ALEN, answered) > (I64{0}) || dq_get(queries, DQ_ALEN, answered) == DQ_INVALID) -> answered += I64{1}
        if (answered == count) -> break
        if (t2 - t1 >= retry) {
            i := I64{0}
            loop i < count {
                if (dq_get(queries, DQ_ALEN, i) == I64{0}) {
                    j = I64{0}
                    loop j < nns {
                        _ := lk_send_to(socket, dq_query(queries, i), dq_get(queries, DQ_QLEN, i), wrapping(servers + j * LK_ROW), I64{16384})
                        j += I64{1}
                    }
                }
                i += I64{1}
            }
            t1 = t2
            servfail = I64{2} * count
        }
        // musl polls the UDP socket and every TCP stream at once; this waits
        // on one of them, in 10 ms slices while another could also wake it.
        target := I64{0}
        interest := I64{1}
        waitable := if listening -> I64{1} else -> I64{0}
        i := count - I64{1}
        loop i >= (I64{0}) {
            stream: dq_get(queries, DQ_TCP, i)
            if (stream != I64{0}) {
                target = stream
                interest = if (dq_get(queries, DQ_SENT, i) < dq_get(queries, DQ_QLEN, i) + I64{2}) -> I64{4} else -> I64{1}
                waitable += I64{1}
            }
            i -= I64{1}
        }
        if (target == I64{0} && listening) -> target = socket
        // Nothing left to hear from: musl would sleep out the timeout.
        if (target == I64{0}) -> break
        milliseconds := t1 + retry - t2
        if (waitable > I64{1} && milliseconds > I64{10}) -> milliseconds = I64{10}
        waited: lk_wait(look, target, interest, milliseconds)
        if (waited < I64{0}) {
            outcome = waited
            break
        }
        // A nonblocking attempt on a socket that is not ready changes
        // nothing, so each pass tries what musl's poll would report.
        fresh := I64{0}
        loop listening && head < count {
            buffer: dq_answer(queries, head)
            received: lk_receive(socket, buffer, LK_ANSWER, from)
            if (received < I64{0}) -> break
            truncated: received > LK_ANSWER
            length: if truncated -> LK_ANSWER else -> received
            // Ignore replies from elsewhere and packets that answer none of
            // the questions: Go treats them as possible forgeries and waits on.
            server := I64{0}
            loop server < nns && !lk_same_address(wrapping(servers + server * LK_ROW), from) -> server += I64{1}
            if (server == nns) -> next
            index := head
            loop index < count && !lk_reply_for(buffer, length, dq_query(queries, index), dq_get(queries, DQ_QLEN, index)) -> index += I64{1}
            if (index == count) -> next
            if (dq_get(queries, DQ_ALEN, index) != I64{0}) -> next
            code: rt_text_byte(wrapping(buffer + I64{3})).bit_and(I64{15})
            if (code == I64{2}) {
                if (servfail != I64{0}) {
                    servfail -= I64{1}
                    _ := lk_send_to(socket, dq_query(queries, index), dq_get(queries, DQ_QLEN, index), wrapping(servers + server * LK_ROW), I64{16384})
                }
                next
            }
            if (code != I64{0} && code != I64{3}) -> next
            dq_set(queries, DQ_ALEN, index, length)
            if (index == head) {
                loop head < count && dq_get(queries, DQ_ALEN, head) != (I64{0}) -> head += I64{1}
            } else {
                rt_text_bytes_copy(dq_answer(queries, index), buffer, length)
            }
            if (head == count) -> listening = false
            if (rt_text_byte(wrapping(dq_answer(queries, index) + I64{2})).bit_and(I64{2}) != I64{0} || truncated) {
                dq_set(queries, DQ_ALEN, index, I64{-1})
                lk_tcp_start(look, queries, index, family, wrapping(servers + server * LK_ROW))
                fresh = fresh.bit_or(I64{1} << index)
            }
        }
        // Streams started above, and those still sending, wait for the next
        // pass to read, as their poll entries would.
        sending := fresh
        failed := false
        i = I64{0}
        loop i < count {
            stream: dq_get(queries, DQ_TCP, i)
            if (stream != I64{0} && fresh.bit_and(I64{1} << i) == I64{0} && dq_get(queries, DQ_SENT, i) < dq_get(queries, DQ_QLEN, i) + I64{2}) {
                sending = sending.bit_or(I64{1} << i)
                if !lk_tcp_send(look, queries, i, stream) {
                    failed = true
                    break
                }
            }
            i += I64{1}
        }
        if failed -> break
        i = I64{0}
        loop i < count {
            stream: dq_get(queries, DQ_TCP, i)
            if (stream != I64{0} && sending.bit_and(I64{1} << i) == I64{0} && !lk_tcp_receive(look, queries, i, stream)) {
                failed = true
                break
            }
            i += I64{1}
        }
        if failed -> break
        t2 = lk_now_ms()
    }
    // Incomplete TCP answers count as none.
    i := I64{0}
    loop i < count {
        stream: dq_get(queries, DQ_TCP, i)
        if (stream != I64{0}) {
            jet_fd_drop_raw(stream)
            dq_set(queries, DQ_TCP, i, I64{0})
        }
        if (dq_get(queries, DQ_ALEN, i) == I64{-1}) -> dq_set(queries, DQ_ALEN, i, I64{0})
        i += I64{1}
    }
    jet_fd_drop_raw(socket)
    jet_rt_free(from, LK_ROW, I64{8})
    jet_rt_free(error, I64{32}, I64{8})
    jet_rt_free(servers, I64{3} * LK_ROW, I64{8})
    outcome
}

// dns_parse_callback: an A or AAAA record of the queried kind becomes the
// next address; CNAME records only rename (unused here); -1 for a record of
// the wrong size, which ends the parse.
lk_record: fn(look: I64, kind: I64, data: I64, size: I64, wanted: I64) -> I64 {
    if (kind == I64{5}) -> return I64{0}
    count: net_word(look, LK_COUNT)
    if (count >= LK_ADDRESSES) -> return I64{0}
    if (kind != wanted) -> return I64{0}
    if ((kind == I64{1} && size != I64{4}) || (kind == I64{28} && size != I64{16})) -> return I64{-1}
    row: wrapping(net_word(look, LK_ROWS) + count * LK_ROW)
    thread_zero(row, LK_ROW)
    net_put(row, I64{0}, if (kind == I64{1}) -> I64{4} else -> I64{6})
    rt_text_bytes_copy(wrapping(row + I64{8}), data, size)
    net_put(look, LK_COUNT, count + I64{1})
    I64{0}
}
// One encoded name from `at`: the offset past it, or -1 when it runs past
// `length`, has a reserved label type, is longer than 255 bytes, or ends in
// a compression pointer that does not point back before the name (so no
// chain of them can loop).
lk_skip_name: fn(packet: I64, at: I64, length: I64) -> I64 {
    p := at
    total := I64{0}
    loop p < length {
        size: rt_text_byte(wrapping(packet + p))
        if (size == I64{0}) -> return p + I64{1}
        if (size >= I64{192}) {
            if (p + I64{2} > length) -> return I64{-1}
            target: (size - I64{192}) * I64{256} + rt_text_byte(wrapping(wrapping(packet + p) + I64{1}))
            if (target >= at) -> return I64{-1}
            return p + I64{2}
        }
        if (size >= I64{64}) -> return I64{-1}
        total += size + I64{1}
        if (total > I64{255}) -> return I64{-1}
        p += size + I64{1}
    }
    I64{-1}
}
// musl __dns_parse with each name checked (lk_skip_name) and full 16-bit
// record types: skips the questions, then hands each answer record to
// lk_record. False for a malformed packet: a name, record header or record
// data running past the end, or an A/AAAA record of the wrong size. The
// records before the fault stand, as Go's goLookupIPCNAMEOrder keeps them.
lk_parse: fn(look: I64, packet: I64, length: I64, wanted: I64) -> Bool {
    if (length < I64{12}) -> return false
    if (rt_text_byte(wrapping(packet + I64{3})).bit_and(I64{15}) != I64{0}) -> return true
    at := I64{12}
    questions := rt_text_byte(wrapping(packet + I64{4})) * I64{256} + rt_text_byte(wrapping(packet + I64{5}))
    answers := rt_text_byte(wrapping(packet + I64{6})) * I64{256} + rt_text_byte(wrapping(packet + I64{7}))
    loop questions > (I64{0}) {
        questions -= I64{1}
        at = lk_skip_name(packet, at, length)
        if (at < I64{0} || at + I64{4} > length) -> return false
        at += I64{4}
    }
    loop answers > (I64{0}) {
        answers -= I64{1}
        at = lk_skip_name(packet, at, length)
        if (at < I64{0} || at + I64{10} > length) -> return false
        record: wrapping(packet + at)
        kind: rt_text_byte(record) * I64{256} + rt_text_byte(wrapping(record + I64{1}))
        size: rt_text_byte(wrapping(record + I64{8})) * I64{256} + rt_text_byte(wrapping(record + I64{9}))
        if (size + I64{10} > length - at) -> return false
        if (lk_record(look, kind, wrapping(record + I64{10}), size, wanted) < I64{0}) -> return false
        at += I64{10} + size
    }
    true
}

// One query's outcome by its answer: 0 for NOERROR (its records are the
// answer, maybe none), else an EAI code: no answer or SERVFAIL LK_AGAIN,
// NXDOMAIN LK_NONAME, an invalid TCP answer or any other rcode LK_FAIL.
lk_outcome: fn(queries: I64, index: I64) -> I64 {
    if (dq_get(queries, DQ_ALEN, index) == DQ_INVALID) -> return LK_FAIL
    if (dq_get(queries, DQ_ALEN, index) < I64{12}) -> return LK_AGAIN
    code: rt_text_byte(wrapping(dq_answer(queries, index) + I64{3})).bit_and(I64{15})
    if (code == I64{0}) -> return I64{0}
    if (code == I64{2}) -> return LK_AGAIN
    if (code == I64{3}) -> return LK_NONAME
    LK_FAIL
}

// Of two failures of one name, the one it reports: NXDOMAIN (the name does
// not exist, whatever the type) over a temporary failure (a retry may still
// find an address) over a server's refusal over no address of either type.
lk_rank: fn(code: I64) -> I64 {
    if (code == LK_NONAME) -> return I64{4}
    if (code == LK_AGAIN) -> return I64{3}
    if (code == LK_FAIL) -> return I64{2}
    if (code == LK_NODATA) -> return I64{1}
    I64{0}
}

// name_from_dns with Go's per-type outcome (net/dnsclient_unix.go
// goLookupIPCNAMEOrder): A and AAAA queries for `name` sent together, the
// addresses either answers, so an A answer stands when the AAAA query times
// out or fails, as an AAAA answer does when the A query does. With no
// address, the failure lk_rank puts first (LK_NODATA when both answered with
// none, LK_FAIL for a malformed answer), LK_NONAME for a name no query can
// encode, or a failure to send.
lk_dns: fn(look: I64, name: I64) -> I64 {
    queries: jet_rt_alloc(DQ_BYTES, I64{8})
    thread_zero(queries, DQ_BYTES)
    i := I64{0}
    loop i < (I64{2}) {
        query: dq_query(queries, i)
        length: lk_mkquery(name, if (i == I64{0}) -> I64{1} else -> I64{28}, query)
        if (length == I64{-1}) {
            jet_rt_free(queries, DQ_BYTES, I64{8})
            return LK_NONAME
        }
        dq_set(queries, DQ_QLEN, i, length)
        // No AD flag; distinct query ids.
        rt_text_put(wrapping(query + I64{3}), I64{0})
        if (i == I64{1} && rt_text_byte(query) == rt_text_byte(queries)) -> rt_text_put(query, (rt_text_byte(query) + I64{1}).bit_and(I64{255}))
        i += I64{1}
    }
    sent: lk_msend(look, queries, I64{2})
    if (sent != I64{0}) {
        jet_rt_free(queries, DQ_BYTES, I64{8})
        if (sent == I64{-1}) -> return LK_SYSTEM
        return sent
    }
    net_put(look, LK_COUNT, I64{0})
    failure := LK_NODATA
    i = I64{1}
    loop i >= (I64{0}) {
        outcome: lk_outcome(queries, i)
        if (outcome == I64{0}) {
            length: dq_get(queries, DQ_ALEN, i)
            // Go's errCannotUnmarshalDNSMessage; an answer longer than the
            // buffer is cut short here, not malformed.
            if (!lk_parse(look, dq_answer(queries, i), if (length > LK_ANSWER) -> LK_ANSWER else -> length, if (i == I64{0}) -> I64{1} else -> I64{28}) && length <= LK_ANSWER && lk_rank(LK_FAIL) > lk_rank(failure)) -> failure = LK_FAIL
        } else if (lk_rank(outcome) > lk_rank(failure)) {
            failure = outcome
        }
        i -= I64{1}
    }
    found: net_word(look, LK_COUNT)
    jet_rt_free(queries, DQ_BYTES, I64{8})
    if (found != I64{0}) -> return found
    failure
}

// RFC 7686: a name in .onion (any case, one trailing dot allowed) never
// goes to DNS.
lk_onion: fn(name: I64) -> Bool {
    length := lk_strlen(name)
    if (length > I64{0} && rt_text_byte(wrapping(wrapping(name + length) - I64{1})) == I64{46}) -> length -= I64{1}
    if (length < I64{6}) -> return false
    tail: wrapping(wrapping(name + length) - I64{6})
    if (rt_text_byte(tail) != I64{46}) -> return false
    word: rt_static_text("onion")
    at := I64{0}
    loop at < (I64{5}) {
        if (rt_text_byte(wrapping(wrapping(tail + I64{1}) + at)).bit_or(I64{32}) != rt_text_byte(wrapping(rt_text_data(word) + at))) -> return false
        at += I64{1}
    }
    true
}

// One search candidate: its addresses or its failure; a .onion candidate is
// skipped (0).
lk_candidate: fn(look: I64, candidate: I64) -> I64 {
    if lk_onion(candidate) -> return I64{0}
    lk_dns(look, candidate)
}

// An outcome that ends the search: addresses, or a failure no other
// candidate can fare better with (no socket, the task's stop, cancel or
// deadline).
lk_settled: fn(outcome: I64) -> Bool {
    outcome > I64{0} || outcome == LK_SYSTEM || outcome == LK_STOP || outcome == LK_CANCEL || outcome == LK_TIMEOUT
}

// Go's search (net/dnsconfig.go nameList, net/dnsclient_unix.go
// goLookupIPCNAMEOrder): a name with a trailing dot is tried alone; one with
// at least ndots dots is tried as is and then with each search domain;
// any other with each search domain and then as is. The first candidate with
// an address answers; a failed candidate moves on to the next. With none,
// the name's own failure, else the first candidate's (LK_NONAME when every
// candidate was skipped).
lk_dns_search: fn(look: I64, name: I64) -> I64 {
    if (lk_resolv_conf(look) < I64{0}) -> return LK_BADFLAGS
    search: wrapping(look + LK_SEARCH)
    length := I64{0}
    dots := I64{0}
    loop rt_text_byte(wrapping(name + length)) != (I64{0}) {
        if (rt_text_byte(wrapping(name + length)) == I64{46}) -> dots += I64{1}
        length += I64{1}
    }
    trailing: rt_text_byte(wrapping(wrapping(name + length) - I64{1})) == I64{46}
    if trailing {
        rt_text_put(search, I64{0})
        length -= I64{1}
    }
    if (length == I64{0} || rt_text_byte(wrapping(wrapping(name + length) - I64{1})) == I64{46}) -> return LK_NONAME
    if (length >= I64{256}) -> return LK_NONAME
    named_first: trailing || dots >= net_word(look, LK_NDOTS)
    own := I64{0}
    first := I64{0}
    if named_first {
        own = lk_candidate(look, name)
        if lk_settled(own) -> return own
    }
    canon: jet_rt_alloc(I64{256}, I64{1})
    rt_text_bytes_copy(canon, name, length)
    rt_text_put(wrapping(canon + length), I64{46})
    p := search
    loop rt_text_byte(p) != (I64{0}) {
        loop lk_space(rt_text_byte(p)) -> p = wrapping(p + I64{1})
        stop := p
        loop rt_text_byte(stop) != (I64{0}) && !lk_space(rt_text_byte(stop)) -> stop = wrapping(stop + I64{1})
        if (stop == p) -> break
        size: stop - p
        if (size < I64{256} - length - I64{1}) {
            rt_text_bytes_copy(wrapping(wrapping(canon + length) + I64{1}), p, size)
            rt_text_put(wrapping(wrapping(wrapping(canon + length) + I64{1}) + size), I64{0})
            outcome: lk_candidate(look, canon)
            if lk_settled(outcome) {
                jet_rt_free(canon, I64{256}, I64{1})
                return outcome
            }
            if (first == I64{0}) -> first = outcome
        }
        p = stop
    }
    jet_rt_free(canon, I64{256}, I64{1})
    if !named_first {
        own = lk_candidate(look, name)
        if lk_settled(own) -> return own
    }
    if (own != I64{0}) -> return own
    if (first != I64{0}) -> return first
    LK_NONAME
}

lk_zero: fn(address: I64, length: I64) -> Bool {
    at := I64{0}
    loop at < length {
        if (rt_text_byte(wrapping(address + at)) != I64{0}) -> return false
        at += I64{1}
    }
    true
}
// RFC 6724's default policy table for a 16-byte address: precedence << 8 |
// label. musl's defpolicy drops the deprecated rows (::/96, fec0::/10,
// 3ffe::/16); Go's rfc6724policyTable keeps them, so those addresses rank
// last as the RFC orders them.
lk_policy: fn(address: I64) -> I64 {
    b0: rt_text_byte(address)
    b1: rt_text_byte(wrapping(address + I64{1}))
    if (lk_zero(address, I64{15}) && rt_text_byte(wrapping(address + I64{15})) == I64{1}) -> return I64{50} << I64{8}
    if (lk_zero(address, I64{10}) && rt_text_byte(wrapping(address + I64{10})) == I64{255} && rt_text_byte(wrapping(address + I64{11})) == I64{255}) -> return (I64{35} << I64{8}).bit_or(I64{4})
    if (lk_zero(address, I64{12})) -> return (I64{1} << I64{8}).bit_or(I64{3})
    if (b0 == I64{32} && b1 == I64{2}) -> return (I64{30} << I64{8}).bit_or(I64{2})
    if (b0 == I64{32} && b1 == I64{1} && rt_text_byte(wrapping(address + I64{2})) == I64{0} && rt_text_byte(wrapping(address + I64{3})) == I64{0}) -> return (I64{5} << I64{8}).bit_or(I64{5})
    if (b0 == I64{63} && b1 == I64{254}) -> return (I64{1} << I64{8}).bit_or(I64{12})
    if (b0 == I64{254} && b1.bit_and(I64{192}) == I64{192}) -> return (I64{1} << I64{8}).bit_or(I64{11})
    if (b0.bit_and(I64{254}) == I64{252}) -> return (I64{3} << I64{8}).bit_or(I64{13})
    (I64{40} << I64{8}).bit_or(I64{1})
}
// RFC 6724 3.2 scope: IPv4 loopback (127/8) and link-local (169.254/16)
// are link-local scope, as in Go's classifyScope; musl's scopeof makes every
// IPv4 address global.
lk_scope: fn(address: I64) -> I64 {
    b0: rt_text_byte(address)
    b1: rt_text_byte(wrapping(address + I64{1}))
    if (lk_zero(address, I64{10}) && rt_text_byte(wrapping(address + I64{10})) == I64{255} && rt_text_byte(wrapping(address + I64{11})) == I64{255}) {
        b12: rt_text_byte(wrapping(address + I64{12}))
        if (b12 == I64{127}) -> return I64{2}
        if (b12 == I64{169} && rt_text_byte(wrapping(address + I64{13})) == I64{254}) -> return I64{2}
        return I64{14}
    }
    if (b0 == I64{255}) -> return b1.bit_and(I64{15})
    if (b0 == I64{254} && b1.bit_and(I64{192}) == I64{128}) -> return I64{2}
    if (lk_zero(address, I64{15}) && rt_text_byte(wrapping(address + I64{15})) == I64{1}) -> return I64{2}
    if (b0 == I64{254} && b1.bit_and(I64{192}) == I64{192}) -> return I64{5}
    I64{14}
}
lk_common_bits: fn(left: I64, right: I64) -> I64 {
    bit := I64{0}
    loop bit < (I64{128}) {
        mask: I64{128} >> (bit.bit_and(I64{7}))
        if ((rt_text_byte(wrapping(left + (bit >> I64{3}))).bit_xor(rt_text_byte(wrapping(right + (bit >> I64{3}))))).bit_and(mask) != I64{0}) -> break
        bit += I64{1}
    }
    bit
}

// RFC 6724 destination order, the rules musl implements as Go's net/addrselect.go
// applies it: one key per address from a connected UDP probe (usable,
// matching scope and label, and for IPv6 alone the common prefix with the
// source, which for IPv4 would undo round-robin DNS), the destination's
// precedence and scope, then the original order; sorted by key, highest
// first.
lk_sort: fn(rows: I64, count: I64) -> I64 {
    destination: jet_rt_alloc(I64{16}, I64{8})
    source: jet_rt_alloc(I64{16}, I64{8})
    target: jet_rt_alloc(LK_ROW, I64{8})
    local: jet_rt_alloc(LK_ROW, I64{8})
    error: jet_rt_alloc(I64{32}, I64{8})
    thread_zero(error, I64{32})
    i := I64{0}
    loop i < count {
        row: wrapping(rows + i * LK_ROW)
        family: net_word(row, I64{0})
        thread_zero(destination, I64{16})
        thread_zero(source, I64{16})
        if (family == I64{6}) {
            rt_text_bytes_copy(destination, wrapping(row + I64{8}), I64{16})
        } else {
            rt_text_put(wrapping(source + I64{10}), I64{255})
            rt_text_put(wrapping(source + I64{11}), I64{255})
            rt_text_put(wrapping(destination + I64{10}), I64{255})
            rt_text_put(wrapping(destination + I64{11}), I64{255})
            rt_text_bytes_copy(wrapping(destination + I64{12}), wrapping(row + I64{8}), I64{4})
        }
        policy: lk_policy(destination)
        scope: lk_scope(destination)
        key := I64{0}
        prefix := I64{0}
        probe: jet_socket_create_raw(family, I64{2}, I64{17}, error)
        if (probe != I64{0}) {
            thread_zero(target, LK_ROW)
            net_put(target, I64{0}, family)
            rt_text_bytes_copy(wrapping(target + I64{8}), wrapping(row + I64{8}), if (family == I64{6}) -> I64{16} else -> I64{4})
            net_put(target, I64{24}, I64{65535})
            if (family == I64{6}) -> net_put(target, I64{40}, net_word(row, I64{40}))
            if (jet_socket_connect_raw(probe, target, error) >= I64{0}) {
                key = key.bit_or(I64{1073741824})
                if (jet_socket_address_raw(probe, false, local, error) >= I64{0}) {
                    if (family == I64{6}) { rt_text_bytes_copy(source, wrapping(local + I64{8}), I64{16}) } else { rt_text_bytes_copy(wrapping(source + I64{12}), wrapping(local + I64{8}), I64{4}) }
                    if (scope == lk_scope(source)) -> key = key.bit_or(I64{536870912})
                    if (policy.bit_and(I64{255}) == lk_policy(source).bit_and(I64{255})) -> key = key.bit_or(I64{268435456})
                    if (family == I64{6}) -> prefix = lk_common_bits(source, destination)
                }
            }
            jet_fd_drop_raw(probe)
        }
        key = key.bit_or((policy >> I64{8}) << I64{20}).bit_or((I64{15} - scope) << I64{16}).bit_or(prefix << I64{8}).bit_or(LK_ADDRESSES - i)
        net_put(row, I64{48}, key)
        i += I64{1}
    }
    jet_rt_free(destination, I64{16}, I64{8})
    jet_rt_free(source, I64{16}, I64{8})
    jet_rt_free(target, LK_ROW, I64{8})
    jet_rt_free(error, I64{32}, I64{8})
    if (jet_scheduler_native_propagate() != I64{0}) {
        jet_rt_free(local, LK_ROW, I64{8})
        return LK_STOP
    }
    // Keys are distinct (the low byte is 48 - position), so any sort agrees
    // with musl's qsort.
    i = I64{1}
    loop i < count {
        coll_copy(wrapping(rows + i * LK_ROW), local, LK_ROW)
        key: net_word(local, I64{48})
        j := i
        loop j > (I64{0}) && net_word(wrapping(rows + (j - I64{1}) * LK_ROW), I64{48}) < key {
            coll_copy(wrapping(rows + (j - I64{1}) * LK_ROW), wrapping(rows + j * LK_ROW), LK_ROW)
            j -= I64{1}
        }
        coll_copy(local, wrapping(rows + j * LK_ROW), LK_ROW)
        i += I64{1}
    }
    jet_rt_free(local, LK_ROW, I64{8})
    count
}

// The ordered Socket56 rows for C text `name` (`length` bytes, no NUL), each
// with `port`: 1 with an owned count*56 buffer in rows_out/count_out, else a
// negative EAI code (errno_out holds the errno an EAI_SYSTEM reports),
// LK_STOP, or for a typed lookup LK_CANCEL/LK_TIMEOUT against `deadline`.
net_lookup: fn(name: I64, length: I64, port: I64, typed: Bool, deadline: I64, rows_out: I64, count_out: I64, errno_out: I64) -> I64 {
    look: jet_rt_alloc(LK_BYTES, I64{8})
    thread_zero(look, LK_BYTES)
    net_put(look, LK_TYPED, if typed -> I64{1} else -> I64{0})
    net_put(look, LK_DEADLINE, deadline)
    rows := I64{0}
    status := LK_NONAME
    // musl __lookup_name: a 1..254 byte name, the literal before any file.
    if (length > I64{0} && length < I64{255}) {
        rows = jet_rt_alloc(LK_ROW, I64{8})
        status = lk_ipliteral(look, name, rows)
        if (status == I64{0}) {
            jet_rt_free(rows, LK_ROW, I64{8})
            rows = jet_rt_alloc(LK_ADDRESSES * LK_ROW, I64{8})
            net_put(look, LK_ROWS, rows)
            status = lk_hosts(look, name, rows)
            if (status == I64{0}) -> status = lk_dns_search(look, name)
            if (status >= I64{2}) -> status = lk_sort(rows, status)
            if (status > I64{0}) {
                owned: jet_rt_alloc(status * LK_ROW, I64{8})
                coll_copy(rows, owned, status * LK_ROW)
                jet_rt_free(rows, LK_ADDRESSES * LK_ROW, I64{8})
                rows = owned
            } else {
                jet_rt_free(rows, LK_ADDRESSES * LK_ROW, I64{8})
                rows = I64{0}
            }
        } else if (status < I64{0}) {
            jet_rt_free(rows, LK_ROW, I64{8})
            rows = I64{0}
        }
    }
    if (status > I64{0}) {
        at := I64{0}
        loop at < status {
            row: wrapping(rows + at * LK_ROW)
            net_put(row, I64{24}, port)
            net_put(row, I64{48}, I64{0})
            at += I64{1}
        }
        net_put(rows_out, I64{0}, rows)
        net_put(count_out, I64{0}, status)
        status = I64{1}
    }
    net_put(errno_out, I64{0}, net_word(look, LK_ERRNO))
    jet_rt_free(look, LK_BYTES, I64{8})
    status
}

// musl gai_strerror.
net_gai_text: fn(status: I64) -> I64 {
    if (status == I64{-1}) -> return rt_static_text("Invalid flags")
    if (status == I64{-2}) -> return rt_static_text("Name does not resolve")
    if (status == I64{-3}) -> return rt_static_text("Try again")
    if (status == I64{-4}) -> return rt_static_text("Non-recoverable error")
    if (status == I64{-5}) -> return rt_static_text("Name has no usable address")
    if (status == I64{-6}) -> return rt_static_text("Unrecognized address family or invalid length")
    if (status == I64{-7}) -> return rt_static_text("Unrecognized socket type")
    if (status == I64{-8}) -> return rt_static_text("Unrecognized service")
    if (status == I64{-10}) -> return rt_static_text("Out of memory")
    if (status == I64{-11}) -> return rt_static_text("System error")
    if (status == I64{-12}) -> return rt_static_text("Overflow")
    rt_static_text("Unknown error")
}
