test_scope_push_name: fn(builder: I64, code: I64) {
    word: test_scope_code_word(code)
    if {
        (word == I64{241360252997}) -> test_scope_name_e0128(builder)
        (word == I64{215574065221}) -> test_scope_name_e0712(builder)
        (word == I64{232854401605}) -> test_scope_name_e2476(builder)
        (word == I64{237149368901}) -> test_scope_name_e2477(builder)
        (word == I64{211261862725}) -> test_scope_name_e3001(builder)
        (word == I64{215556830021}) -> test_scope_name_e3002(builder)
        (word == I64{219851797317}) -> test_scope_name_e3003(builder)
        (word == I64{228441731909}) -> test_scope_name_e3005(builder)
        (word == I64{232736699205}) -> test_scope_name_e3006(builder)
        (word == I64{206983672645}) -> test_scope_name_e3010(builder)
        (word == I64{211278639941}) -> test_scope_name_e3011(builder)
        (word == I64{215573607237}) -> test_scope_name_e3012(builder)
        (word == I64{228458509125}) -> test_scope_name_e3015(builder)
        (word == I64{232753476421}) -> test_scope_name_e3016(builder)
        (word == I64{211262321221}) -> test_scope_name_e2701(builder)
        (word == I64{219852255813}) -> test_scope_name_e2703(builder)
        (word == I64{224147223109}) -> test_scope_name_e2704(builder)
        (word == I64{232753738309}) -> test_scope_name_e2416(builder)
        (word == I64{224147288645}) -> test_scope_name_e2804(builder)
        (word == I64{228442255941}) -> test_scope_name_e2805(builder)
        (word == I64{241327157829}) -> test_scope_name_e2808(builder)
        (word == I64{245622125125}) -> test_scope_name_e2809(builder)
        (word == I64{211262386258}) -> test_scope_name_r0801(builder)
        (word == I64{215557353554}) -> test_scope_name_r0802(builder)
        (word == I64{219852320850}) -> test_scope_name_r0803(builder)
        else -> jet_rt_string_builder_push(builder, code)
    }
}

test_scope_ordinary: fn(text: I64) -> Bool {
    if (text == I64{0}) { return false }
    if (trap_word(wrapping(text + I64{8})) != I64{29}) { return false }
    data: trap_word(text)
    if (trap_byte(wrapping(data + I64{0})) != I64{95}) { return false }
    if (trap_byte(wrapping(data + I64{1})) != I64{95}) { return false }
    if (trap_byte(wrapping(data + I64{2})) != I64{106}) { return false }
    if (trap_byte(wrapping(data + I64{3})) != I64{101}) { return false }
    if (trap_byte(wrapping(data + I64{4})) != I64{116}) { return false }
    if (trap_byte(wrapping(data + I64{5})) != I64{95}) { return false }
    if (trap_byte(wrapping(data + I64{6})) != I64{116}) { return false }
    if (trap_byte(wrapping(data + I64{7})) != I64{101}) { return false }
    if (trap_byte(wrapping(data + I64{8})) != I64{115}) { return false }
    if (trap_byte(wrapping(data + I64{9})) != I64{116}) { return false }
    if (trap_byte(wrapping(data + I64{10})) != I64{95}) { return false }
    if (trap_byte(wrapping(data + I64{11})) != I64{111}) { return false }
    if (trap_byte(wrapping(data + I64{12})) != I64{114}) { return false }
    if (trap_byte(wrapping(data + I64{13})) != I64{100}) { return false }
    if (trap_byte(wrapping(data + I64{14})) != I64{105}) { return false }
    if (trap_byte(wrapping(data + I64{15})) != I64{110}) { return false }
    if (trap_byte(wrapping(data + I64{16})) != I64{97}) { return false }
    if (trap_byte(wrapping(data + I64{17})) != I64{114}) { return false }
    if (trap_byte(wrapping(data + I64{18})) != I64{121}) { return false }
    if (trap_byte(wrapping(data + I64{19})) != I64{95}) { return false }
    if (trap_byte(wrapping(data + I64{20})) != I64{102}) { return false }
    if (trap_byte(wrapping(data + I64{21})) != I64{97}) { return false }
    if (trap_byte(wrapping(data + I64{22})) != I64{105}) { return false }
    if (trap_byte(wrapping(data + I64{23})) != I64{108}) { return false }
    if (trap_byte(wrapping(data + I64{24})) != I64{117}) { return false }
    if (trap_byte(wrapping(data + I64{25})) != I64{114}) { return false }
    if (trap_byte(wrapping(data + I64{26})) != I64{101}) { return false }
    if (trap_byte(wrapping(data + I64{27})) != I64{95}) { return false }
    if (trap_byte(wrapping(data + I64{28})) != I64{95}) { return false }
    true
}
