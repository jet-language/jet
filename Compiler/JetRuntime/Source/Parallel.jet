// A range callback borrows env until every worker has finished. Chunk
// failures are isolated, all chunks run, and the lowest failing chunk start
// wins. Each worker is a scheduler job (scheduler_run_job) that runs on a
// pool fiber, so a worker whose item waits parks and frees its carrier: the
// carriers bound how many items run at once, and a para_map's `limit` bounds
// how many are in flight.
// Worker144: job0 (PARALLEL_JOB) len8 chunks16 workers24 index32 env40
// invoke48 stop56 start64 join72 (the walk's count of unfinished workers)
// size80 (items per chunk) queue88 (the scheduler FIFO link) save96 (points
// into the 32-byte control scope at 104) stack136 (the walking task's stack
// size, which the worker's fiber takes: Fiber.jet fiber_stack_class).
PARALLEL_JOB: I64{-1}
PARALLEL_WORKER_BYTES: I64{144}
// BuildParallel's PARA_EVERY_WORKER: a para_map without `limit`, more
// workers than any host has, so it gets the available ones.
PARALLEL_EVERY_WORKER: U64{1073741824}

parallel_limit: fn(limit: I64, cap: I64) -> I64 {
    // Rust's Option<i64> -> usize accepts zero, rejects negative/too-wide.
    if int_negative(limit) || !int_fits(limit, U64{9223372036854775807}) -> return cap
    count: int_word(limit)
    if (count == I64{0}) -> I64{1} else if count < cap -> count else -> cap
}

// Items per chunk: the items spread over `limited` workers, at most 64. A
// para_map, para_filter or para_partition passes its `limit` or more
// workers than the host has, so a short list of costly items still reaches
// every worker. para_fold passes a negative limit and keeps exactly 64: its
// per-chunk seeds and merge tree are built on 64-item chunks.
parallel_chunk_size: fn(length: I64, limit: I64, limited: I64) -> I64 {
    if int_negative(limit) -> return I64{64}
    size: (length + limited - I64{1}) / limited
    if size < (I64{64}) -> size else -> I64{64}
}

parallel_worker_run: fn(worker: I64) {
    chunk := sync_load(wrapping(worker + I64{32}))
    chunks: sync_load(wrapping(worker + I64{16}))
    stride: sync_load(wrapping(worker + I64{24}))
    length: sync_load(wrapping(worker + I64{8}))
    save: sync_load(wrapping(worker + I64{96}))
    size: sync_load(wrapping(worker + I64{80}))
    loop chunk < chunks {
        start: chunk * size
        remaining: length - start
        end: start + (if remaining < size -> remaining else -> size)
        control: scheduler_control_new()
        sync_store(wrapping(control + I64{104}), SCHEDULER_SCOPE_TASK)
        scheduler_control_enter(control, save)
        body: scheduler_body_enter()
        #Unsafe("checked System V (env,start,end)->Unit callback; env remains borrowed and each range has exclusive output slots") {
            os_call3_unit_i64(sync_load(wrapping(worker + I64{48})), sync_load(wrapping(worker + I64{40})), start, end)
        }
        scheduler_body_leave(body)
        record: scheduler_control_take_stop(control)
        scheduler_control_leave(save)
        scheduler_control_drop(control)
        if (record != I64{0}) {
            // This worker's cyclic chunk indices only increase.
            if (sync_load(wrapping(worker + I64{56})) == I64{0}) {
                sync_store(wrapping(worker + I64{56}), record)
                sync_store(wrapping(worker + I64{64}), start)
            } else { scheduler_stop_drop(record) }
        }
        if stride >= chunks - chunk -> break
        chunk += stride
    }
}

// A worker job on its pool fiber. The walk may free the worker once the
// join count reaches zero, so the wake names only the join word's address.
parallel_job_run: fn(worker: I64) {
    parallel_worker_run(worker)
    join: sync_load(wrapping(worker + I64{72}))
    if (sync_add(join, I64{-1}) == I64{1}) -> sync_wake(join, I64{1})
}

parallel_raise: fn(record: I64) {
    if (record == I64{0}) {
        return
    }
    if (scheduler_control_current() != I64{0}) {
        if (sync_load(record) == I64{5}) {
            if (jet_rt_stop_domain() != I64{0} && !scheduler_stop_fatal()) {
                _ := scheduler_panic_publish_record(record)
                return
            }
        } else {
            _ := scheduler_native_publish(record)
            return
        }
    }
    // The process edge has no parent control, and a process-fatal panic is
    // never published (scheduler_stop_fatal). Replay the captured diagnostic,
    // not a replacement panic; the owned stop is released before process exit.
    message: scheduler_stop_take_message(record)
    form: sync_load(wrapping(record + I64{48}))
    scheduler_stop_drop(record)
    if (form == I64{0}) {
        trap_header(I64{0})
        trap_write_handle(message)
        trap_msg_prelude_end()
        jet_rt_string_drop(message)
        trap_footer(I64{0})
    } else {
        trap_write_handle(message)
        jet_rt_string_drop(message)
        trap_exit(EXIT_RUNTIME_PANIC)
    }
}

#Export(c) jet_rt_native_para_walk: fn(length: I64, limit: I64, env: I64, invoke: I64) {
    if (length < I64{0}) { jet_rt_unreachable(I64{0}, I64{0}) }
    if (length == I64{0}) {
        return
    }
    serving: comptime_serving()
    cap: if serving -> I64{1} else -> scheduler_available_parallelism(I64{1})
    if (jet_rt_session_propagate() != I64{0}) -> return
    // Parked items hold no carrier, so an explicit `limit` is not cut to the
    // available parallelism: it alone bounds the items in flight.
    every: int_negative(limit) || !int_fits(limit, PARALLEL_EVERY_WORKER - U64{1})
    limited: if (serving || every) -> parallel_limit(limit, cap) else -> parallel_limit(limit, length)
    size: parallel_chunk_size(length, limit, limited)
    chunks: length / size + (if (length % size == I64{0}) -> I64{0} else -> I64{1})
    count: if limited < chunks -> limited else -> chunks
    // Each worker owns its descriptor and its control save slot until it
    // counts itself out of the join word at the block's head.
    bytes: I64{8} + count * PARALLEL_WORKER_BYTES
    block: jet_rt_alloc(bytes, I64{8})
    if (block == I64{0} && jet_rt_session_propagate() != I64{0}) -> return
    thread_zero(block, bytes)
    workers: wrapping(block + I64{8})
    sync_store(block, count)
    stack: fiber_stack_current()
    at := I64{0}
    loop at < count {
        worker: workers + at * PARALLEL_WORKER_BYTES
        sync_store(worker, PARALLEL_JOB)
        sync_store(wrapping(worker + I64{8}), length)
        sync_store(wrapping(worker + I64{16}), chunks)
        sync_store(wrapping(worker + I64{24}), count)
        sync_store(wrapping(worker + I64{32}), at)
        sync_store(wrapping(worker + I64{40}), env)
        sync_store(wrapping(worker + I64{48}), invoke)
        sync_store(wrapping(worker + I64{72}), block)
        sync_store(wrapping(worker + I64{80}), size)
        sync_store(wrapping(worker + I64{96}), worker + I64{104})
        sync_store(wrapping(worker + I64{136}), stack)
        at += I64{1}
    }
    if (count == I64{1}) { parallel_worker_run(workers) } else {
        at = I64{0}
        loop at < count {
            scheduler_submit(workers + at * PARALLEL_WORKER_BYTES)
            at += I64{1}
        }
        // The workers borrow env and the block: the walk waits for every
        // one, whatever stop it is asked to deliver meanwhile.
        loop {
            left: sync_load(block)
            if (left == I64{0}) -> break
            _ := sync_wait(block, left, I64{-1})
        }
    }
    first := I64{0}
    index := length
    at = I64{0}
    loop at < count {
        worker: workers + at * PARALLEL_WORKER_BYTES
        record: sync_load(wrapping(worker + I64{56}))
        start: sync_load(wrapping(worker + I64{64}))
        if (record != I64{0}) {
            if start < index {
                scheduler_stop_drop(first)
                first = record
                index = start
            } else { scheduler_stop_drop(record) }
        }
        at += I64{1}
    }
    jet_rt_free(block, bytes, I64{8})
    if (jet_rt_session_propagate() != I64{0}) {
        scheduler_stop_drop(first)
        return
    }
    parallel_raise(first)
}
