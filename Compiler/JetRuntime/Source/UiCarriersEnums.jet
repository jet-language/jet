// Native-private carriers only; UiCarriersABI.jet supplies every layout. Seed
// Clone/PartialEq; Source record enum fields cross as raw declaration-order
// tags, not handles.
// Reads borrow an initialized native UI carrier or E4 header word; writes own
// one native UI carrier word. RawWords.jet performs the access.
ui_carrier_word: fn(address: I64) -> I64 { rt_text_word(address) }

ui_carrier_store: fn(address: I64, word: I64) { rt_text_store(address, word) }

ui_carrier_checked_tag: fn(value: I64, count: I64) -> I64 {
    // Existing range_stop: E3010, <core.prelude>:0, exit 70.
    if (value < I64{0} || value >= count) {
        trap_native_index_range_stop()
        if (jet_scheduler_native_propagate() != I64{0}) { return I64{0} }
    }
    value
}

ui_carrier_scalar_new: fn(word: I64) -> I64 {
    result: jet_rt_alloc(UI_CARRIER_SCALAR_BYTES, I64{8})
    ui_carrier_store(result, word)
    result
}

ui_carrier_scalar_drop: fn(value: I64) {
    if (value != I64{0}) { jet_rt_free(value, UI_CARRIER_SCALAR_BYTES, I64{8}) }
}

#Export(c) jet_rt_handle_clone_terminal_mode: fn(value: I64) -> I64 {
    ui_carrier_scalar_new(ui_carrier_word(value))
}

#Export(c) jet_rt_handle_drop_terminal_mode: fn(value: I64) { ui_carrier_scalar_drop(value) }

#Export(c) jet_rt_handle_eq_terminal_mode: fn(a: I64, b: I64) -> Bool {
    ui_carrier_word(a) == ui_carrier_word(b)
}

#Export(c) jet_rt_handle_clone_text_width_ambiguous: fn(value: I64) -> I64 {
    ui_carrier_scalar_new(ui_carrier_word(value))
}

#Export(c) jet_rt_handle_drop_text_width_ambiguous: fn(value: I64) { ui_carrier_scalar_drop(value) }

#Export(c) jet_rt_handle_eq_text_width_ambiguous: fn(a: I64, b: I64) -> Bool {
    ui_carrier_word(a) == ui_carrier_word(b)
}

#Export(c) jet_rt_handle_clone_text_width_controls: fn(value: I64) -> I64 {
    ui_carrier_scalar_new(ui_carrier_word(value))
}

#Export(c) jet_rt_handle_drop_text_width_controls: fn(value: I64) { ui_carrier_scalar_drop(value) }

#Export(c) jet_rt_handle_eq_text_width_controls: fn(a: I64, b: I64) -> Bool {
    ui_carrier_word(a) == ui_carrier_word(b)
}

#Export(c) jet_rt_handle_clone_jet_tui_direction: fn(value: I64) -> I64 {
    ui_carrier_scalar_new(ui_carrier_word(value))
}

#Export(c) jet_rt_handle_drop_jet_tui_direction: fn(value: I64) { ui_carrier_scalar_drop(value) }

#Export(c) jet_rt_handle_eq_jet_tui_direction: fn(a: I64, b: I64) -> Bool {
    ui_carrier_word(a) == ui_carrier_word(b)
}
