// `jet prove --capture-sensitive` and its `--replay` (JetCli ProveReplay.jet):
// the raw authority values a test program reads, journaled in read order.
// Only a test harness arms the journal (jet_rt_test_contracts_open runs once,
// before any test), so the `jet` processes around it never record their own
// reads.
//
// Capture: JET_PROVE_CAPTURE_JOURNAL names a file each read appends one
// record to. Replay: JET_PROVE_REPLAY_JOURNAL names the records the parent
// wrote from the artifact, served in order instead of the OS, and
// JET_PROVE_REPLAY_TRACE a file that gains `C` for each record served and one
// `D` at the first read the next record does not answer, and, before each
// replayed HTTP hop, `Q`, u64 LE length, and the hop's request as Core
// encoded it, for the parent to check against the artifact. A later harness
// of the same run (a rerun child) starts after the records the trace shows
// served. After `D` every read fails, as an unrecorded authority would.
//
// A record: u8 kind, u64 LE request, u64 LE result, then, for an uppercase
// kind, the result's bytes. Kinds: `R` Rand bytes (result = request), `r` a
// Rand read the OS refused (result 0), `I` a stdin read of up to `request`
// bytes that delivered `result` (0 at end of input), `i` one that failed
// (result = errno), `N` one HTTP hop (request 0) with the `result` bytes Core
// encoded (Core/Http/Client.jet `__client_net_tape`; on replay, the parent's
// shorter replay form).
// Root48: lock0, mode8 (1 capture, 2 replay, 3 diverged), path16 (owned
// journal or trace path), records24, length32, at40.
PROVE_JOURNAL_HEAD: I64{17}
PROVE_JOURNAL_RAND: I64{82}
PROVE_JOURNAL_STDIN: I64{73}
PROVE_JOURNAL_NET: I64{78}
PROVE_JOURNAL_REQUEST: I64{81}
prove_journal_root := I64{0}

rt_prove_journal_open: fn() {
    if (prove_journal_root != I64{0}) -> return
    capture_key: jet_rt_string_clone(env_name_jet_prove_capture_journal())
    capture: rt_env_get(capture_key)
    test_text_drop(capture_key)
    if (capture != I64{0}) {
        rt_prove_journal_publish(rt_prove_journal_root_new(I64{1}, capture))
        return
    }
    records_key: jet_rt_string_clone(env_name_jet_prove_replay_journal())
    records: rt_env_get(records_key)
    test_text_drop(records_key)
    if (records == I64{0}) -> return
    trace_key: jet_rt_string_clone(env_name_jet_prove_replay_trace())
    trace: rt_env_get(trace_key)
    test_text_drop(trace_key)
    if (trace == I64{0}) {
        jet_rt_string_drop(records)
        return
    }
    root: rt_prove_journal_root_new(I64{2}, trace)
    out: jet_rt_alloc(I64{16}, I64{8})
    thread_zero(out, I64{16})
    if (jet_time_raw_zone_file_bytes(records, out, wrapping(out + I64{8})) == I64{0}) {
        trap_store(wrapping(root + I64{8}), I64{3})
        rt_prove_journal_trace(root, I64{68})
    } else {
        trap_store(wrapping(root + I64{24}), trap_word(out))
        trap_store(wrapping(root + I64{32}), trap_word(wrapping(out + I64{8})))
        // A missing trace is a run nothing has read from yet.
        trap_store(out, I64{0})
        trap_store(wrapping(out + I64{8}), I64{0})
        if (jet_time_raw_zone_file_bytes(trace, out, wrapping(out + I64{8})) != I64{0}) {
            served: trap_word(wrapping(out + I64{8}))
            data: trap_word(out)
            seen := I64{0}
            loop seen < served {
                mark: rt_text_byte(wrapping(data + seen))
                if (mark == PROVE_JOURNAL_REQUEST && seen + I64{9} <= served) {
                    seen += I64{9} + rt_prove_le(wrapping(data + seen + I64{1}))
                } else if (mark != I64{67} || !rt_prove_journal_skip(root)) {
                    trap_store(wrapping(root + I64{8}), I64{3})
                    break
                } else {
                    seen += I64{1}
                }
            }
            if (served != I64{0}) -> jet_rt_free(trap_word(out), served, I64{8})
        }
    }
    jet_rt_free(out, I64{16}, I64{8})
    jet_rt_string_drop(records)
    rt_prove_journal_publish(root)
}

rt_prove_journal_root_new: fn(mode: I64, path: I64) -> I64 {
    root: jet_rt_alloc(I64{48}, I64{8})
    thread_zero(root, I64{48})
    trap_store(wrapping(root + I64{8}), mode)
    trap_store(wrapping(root + I64{16}), path)
    root
}

rt_prove_journal_publish: fn(root: I64) {
    #Unsafe("the harness main arms the journal before any test, so before any other thread reads it") {
        prove_journal_root = root
    }
}

// `rt_crypto_entropy_fill` for a test program's Core-visible OS entropy
// (jet_random_os_entropy): capture records each read, replay serves it.
rt_prove_rand_fill: fn(out: I64, count: I64) -> I64 {
    root: prove_journal_root
    if (root == I64{0}) -> return rt_crypto_entropy_fill(out, count)
    sync_mutex_lock(root)
    status := I64{1}
    if (trap_word(wrapping(root + I64{8})) == I64{1}) {
        status = rt_crypto_entropy_fill(out, count)
        if (status == I64{0}) {
            rt_prove_journal_record(root, PROVE_JOURNAL_RAND, count, count, out)
        } else {
            rt_prove_journal_record(root, PROVE_JOURNAL_RAND + I64{32}, count, I64{0}, out)
        }
    } else {
        at: rt_prove_journal_take(root, PROVE_JOURNAL_RAND, count)
        if (at >= I64{0}) {
            records: trap_word(wrapping(root + I64{24}))
            if (rt_text_byte(wrapping(records + at)) == PROVE_JOURNAL_RAND && rt_prove_le(wrapping(records + at + I64{9})) == count) {
                test_copy_bytes(out, wrapping(records + at + PROVE_JOURNAL_HEAD), count)
                status = I64{0}
            }
        }
    }
    sync_mutex_unlock(root)
    status
}

// One raw read of up to `capacity` stdin bytes into `into` for the runtime's
// stdin buffer (TerminalInput.jet): the count, 0 at end of input, or -errno.
// Capture records each answer; replay serves it, and a replay that diverged
// fails the read with EIO rather than reading the real stdin.
rt_prove_stdin_read: fn(into: I64, capacity: I64) -> I64 {
    root: prove_journal_root
    if (root == I64{0}) -> return rt_prove_stdin_os_read(into, capacity)
    sync_mutex_lock(root)
    got := I64{-5}
    if (trap_word(wrapping(root + I64{8})) == I64{1}) {
        got = rt_prove_stdin_terminal_read(into, capacity)
        if (got >= I64{0}) {
            rt_prove_journal_record(root, PROVE_JOURNAL_STDIN, capacity, got, into)
        } else {
            rt_prove_journal_record(root, PROVE_JOURNAL_STDIN + I64{32}, capacity, I64{0} - got, into)
        }
    } else {
        at: rt_prove_journal_take(root, PROVE_JOURNAL_STDIN, capacity)
        if (at >= I64{0}) {
            records: trap_word(wrapping(root + I64{24}))
            result: rt_prove_le(wrapping(records + at + I64{9}))
            if (rt_text_byte(wrapping(records + at)) == PROVE_JOURNAL_STDIN) {
                test_copy_bytes(into, wrapping(records + at + PROVE_JOURNAL_HEAD), result)
                got = result
            } else {
                got = I64{0} - result
            }
        }
    }
    sync_mutex_unlock(root)
    got
}

rt_prove_stdin_os_read: fn(into: I64, capacity: I64) -> I64 {
    got := I64{0}
    #Unsafe("into lends `capacity` writable bytes for a raw Linux read of stdin") {
        got = os_syscall_i64(I64{0}, I64{0}, into, capacity, I64{0}, I64{0}, I64{0})
    }
    got
}

// A capture's harness runs in its own process group (HostSpawn.jet), so a
// read of the user's terminal would stop it with SIGTTIN. For the read it
// takes the terminal's foreground, with SIGTTOU blocked so the kernel allows
// that, then gives it back. Stdin that is no terminal reads as it is.
rt_prove_stdin_terminal_read: fn(into: I64, capacity: I64) -> I64 {
    // cell0: a process group id; cell8: the SIGTTOU mask; cell16: the old mask.
    cell: jet_rt_alloc(I64{24}, I64{8})
    thread_zero(cell, I64{24})
    owner := I64{0}
    own := I64{0}
    #Unsafe("cell lends 24 writable bytes to TIOCGPGRP and getpgrp takes none") {
        if (os_syscall_i64(I64{16}, I64{0}, I64{21519}, cell, I64{0}, I64{0}, I64{0}) == I64{0}) -> owner = trap_word(cell).bit_and(I64{4294967295})
        own = os_syscall_i64(I64{111}, I64{0}, I64{0}, I64{0}, I64{0}, I64{0}, I64{0})
    }
    handoff: owner > I64{0} && own > I64{0} && owner != own
    if handoff {
        trap_store(wrapping(cell + I64{8}), I64{1} << I64{21})
        trap_store(cell, own)
        #Unsafe("cell lends the new and old signal masks and the group id to rt_sigprocmask and TIOCSPGRP") {
            _ := os_syscall_i64(I64{14}, I64{0}, wrapping(cell + I64{8}), wrapping(cell + I64{16}), I64{8}, I64{0}, I64{0})
            _ := os_syscall_i64(I64{16}, I64{0}, I64{21520}, cell, I64{0}, I64{0}, I64{0})
        }
    }
    got: rt_prove_stdin_os_read(into, capacity)
    if handoff {
        trap_store(cell, owner)
        #Unsafe("cell lends the group id to TIOCSPGRP and the old mask to rt_sigprocmask") {
            _ := os_syscall_i64(I64{16}, I64{0}, I64{21520}, cell, I64{0}, I64{0}, I64{0})
            _ := os_syscall_i64(I64{14}, I64{2}, wrapping(cell + I64{16}), I64{0}, I64{8}, I64{0}, I64{0})
        }
    }
    jet_rt_free(cell, I64{24}, I64{8})
    got
}

// Core/Net/Tls.jet's `__host_prove_mode` row, which Core/Http/Client.jet
// `__client_once` reads: 0 outside `jet prove`, 1 capture, 2 replay
// (diverged included).
#Export(c) jet_prove_net_mode: fn() -> I64 {
    root: prove_journal_root
    if (root == I64{0}) -> return I64{0}
    if (trap_word(wrapping(root + I64{8})) == I64{1}) -> return I64{1}
    I64{2}
}

// A capture appends one hop as an `N` record. `data` lends `length` packed
// bytes for this call.
#Export(c) jet_prove_net_record: fn(data: I64, length: I64) {
    root: prove_journal_root
    if (root == I64{0} || length <= I64{0}) -> return
    sync_mutex_lock(root)
    if (trap_word(wrapping(root + I64{8})) == I64{1}) -> rt_prove_journal_record(root, PROVE_JOURNAL_NET, I64{0}, length, data)
    sync_mutex_unlock(root)
}

// A replay traces the hop's request (`Q`, u64 LE length, the `length` bytes
// `data` lends) and serves the next `N` record: 1 with a copy of its bytes
// stored in the `out` and `out_length` words, which the caller's [u8] owns
// (the `__host_prove_take` row's Option<[u8]>), 0 once the run diverged.
#Export(c) jet_prove_net_take: fn(data: I64, length: I64, out: I64, out_length: I64) -> I64 {
    root: prove_journal_root
    if (root == I64{0} || length < I64{0}) -> return I64{0}
    sync_mutex_lock(root)
    served := I64{-1}
    if (trap_word(wrapping(root + I64{8})) == I64{2}) {
        total: I64{9} + length
        request: jet_rt_alloc(total, I64{8})
        trap_put(request, PROVE_JOURNAL_REQUEST)
        rt_prove_put_le(wrapping(request + I64{1}), length)
        test_copy_bytes(wrapping(request + I64{9}), data, length)
        rt_prove_journal_write(root, request, total)
        jet_rt_free(request, total, I64{8})
        served = rt_prove_journal_take(root, PROVE_JOURNAL_NET, I64{0})
    }
    found := I64{0}
    if (served >= I64{0}) {
        records: trap_word(wrapping(root + I64{24}))
        rt_prove_net_bytes_out(wrapping(records + served + PROVE_JOURNAL_HEAD), rt_prove_le(wrapping(records + served + I64{9})), out, out_length)
        found = I64{1}
    }
    sync_mutex_unlock(root)
    found
}

// Copy `length` journal bytes at `source` into a fresh list allocation of
// native U8 elements, as compiler_fs_bytes_take returns a read: the caller's
// list owns it and frees it with jet_rt_free_8. An empty record allocates
// nothing and stores address 0.
rt_prove_net_bytes_out: fn(source: I64, length: I64, out: I64, out_length: I64) {
    data := I64{0}
    if (length != I64{0}) {
        if (RT_HOST_U8_STRIDE == I64{1}) {
            data = jet_rt_alloc_8(length)
            rt_text_bytes_copy(data, source, length)
        } else {
            data = jet_rt_alloc(length * RT_HOST_U8_STRIDE, I64{8})
            at := I64{0}
            loop at < length {
                host_u8_put(data, at, rt_text_byte(wrapping(source + at)))
                at += I64{1}
            }
        }
    }
    trap_store(out, data)
    trap_store(out_length, length)
}

// The next record when it is a `kind` read (or its failed lowercase twin)
// asking for `request`: its offset, with `C` traced. Otherwise -1, with `D`
// traced once, and every later read fails. The caller holds the lock.
rt_prove_journal_take: fn(root: I64, kind: I64, request: I64) -> I64 {
    if (trap_word(wrapping(root + I64{8})) != I64{2}) -> return I64{-1}
    at: trap_word(wrapping(root + I64{40}))
    records: trap_word(wrapping(root + I64{24}))
    if rt_prove_journal_skip(root) {
        found: rt_text_byte(wrapping(records + at))
        if ((found == kind || found == kind + I64{32}) && rt_prove_le(wrapping(records + at + I64{1})) == request) {
            rt_prove_journal_trace(root, I64{67})
            return at
        }
    }
    trap_store(wrapping(root + I64{8}), I64{3})
    rt_prove_journal_trace(root, I64{68})
    I64{-1}
}

// Moves past the record at the cursor; false when it does not fit.
rt_prove_journal_skip: fn(root: I64) -> Bool {
    at: trap_word(wrapping(root + I64{40}))
    length: trap_word(wrapping(root + I64{32}))
    if (at + PROVE_JOURNAL_HEAD > length) -> return false
    records: trap_word(wrapping(root + I64{24}))
    payload: if (rt_text_byte(wrapping(records + at)) < I64{97}) -> rt_prove_le(wrapping(records + at + I64{9})) else -> I64{0}
    if (payload < I64{0} || payload > length - at - PROVE_JOURNAL_HEAD) -> return false
    trap_store(wrapping(root + I64{40}), at + PROVE_JOURNAL_HEAD + payload)
    true
}

// Appends one record, with `result` bytes from `data` for an uppercase kind.
rt_prove_journal_record: fn(root: I64, kind: I64, request: I64, result: I64, data: I64) {
    payload: if (kind < I64{97}) -> result else -> I64{0}
    total: PROVE_JOURNAL_HEAD + payload
    record: jet_rt_alloc(total, I64{8})
    trap_put(record, kind)
    rt_prove_put_le(wrapping(record + I64{1}), request)
    rt_prove_put_le(wrapping(record + I64{9}), result)
    test_copy_bytes(wrapping(record + PROVE_JOURNAL_HEAD), data, payload)
    rt_prove_journal_write(root, record, total)
    jet_rt_free(record, total, I64{8})
}

rt_prove_journal_trace: fn(root: I64, mark: I64) {
    byte: jet_rt_alloc(I64{8}, I64{8})
    trap_put(byte, mark)
    rt_prove_journal_write(root, byte, I64{1})
    jet_rt_free(byte, I64{8}, I64{8})
}

// A journal the parent cannot read whole is a protocol failure (exit 103),
// as for the harness's own records (TestContracts.jet).
rt_prove_journal_write: fn(root: I64, data: I64, length: I64) {
    error: jet_rt_alloc(I64{8}, I64{8})
    trap_store(error, I64{0})
    if (jet_files_append_bytes_os(trap_word(wrapping(root + I64{16})), data, length, error) == I64{0}) {
        message: jet_rt_handle_show_io_error(trap_word(error))
        jet_rt_test_eprint(message)
        jet_std_process_exit_owned(I64{103})
    }
    jet_rt_free(error, I64{8}, I64{8})
}

rt_prove_le: fn(address: I64) -> I64 {
    value := I64{0}
    at := I64{8}
    first: I64{0}
    loop at > first {
        at -= I64{1}
        value = value * I64{256} + rt_text_byte(wrapping(address + at))
    }
    value
}

rt_prove_put_le: fn(address: I64, value: I64) {
    rest := value
    at := I64{0}
    width: I64{8}
    loop at < width {
        trap_put(wrapping(address + at), rest.bit_and(I64{255}))
        rest = rest >> I64{8}
        at += I64{1}
    }
}
