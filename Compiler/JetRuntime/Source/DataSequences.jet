// Shared native List header geometry and ownership; never Rust Vec layouts.
// Sequence stops remain the canonical foreign index/capacity stops in Trap.
// Existing native List ABI (Collections.jet:1-3); holders own their shell.
DATA_SEQUENCE_BYTES :: I64{24}
DATA_SEQUENCE_LENGTH :: I64{0}
DATA_SEQUENCE_CAPACITY :: I64{8}
DATA_SEQUENCE_DATA :: I64{16}
fn data_sequence_new(capacity: I64, stride: I64) -> I64 {
    if (capacity < I64{0} || capacity > I64{9223372036854775807} /% stride) -> rt_seq_capacity_overflow_stop()
    header :: jet_rt_alloc(DATA_SEQUENCE_BYTES, I64{8})
    data :: if (capacity == I64{0}) -> I64{8} else -> jet_rt_alloc(capacity * stride, I64{8})
    rt_text_store(header + DATA_SEQUENCE_LENGTH, I64{0})
    rt_text_store(header + DATA_SEQUENCE_CAPACITY, capacity)
    rt_text_store(header + DATA_SEQUENCE_DATA, data)
    header
}
fn data_sequence_slot(sequence: I64, index: I64, stride: I64) -> I64 {
    length :: rt_text_word(sequence + DATA_SEQUENCE_LENGTH)
    if (index < I64{0} || index >= length) -> rt_seq_index_oob_stop(length, index)
    rt_text_word(sequence + DATA_SEQUENCE_DATA) + index * stride
}
fn data_sequence_reserve(sequence: I64, stride: I64) -> I64 {
    length :: rt_text_word(sequence + DATA_SEQUENCE_LENGTH)
    capacity :: rt_text_word(sequence + DATA_SEQUENCE_CAPACITY)
    old :: rt_text_word(sequence + DATA_SEQUENCE_DATA)
    if length < capacity -> return old + length * stride
    // Check before multiplying, including length+1 at the maximum capacity.
    limit :: I64{9223372036854775807} /% stride
    if capacity >= limit -> rt_seq_capacity_overflow_stop()
    next :: if (capacity == I64{0}) -> I64{4} else if (capacity > limit /% I64{2}) -> limit else -> capacity * I64{2}
    data :: jet_rt_alloc(next * stride, I64{8})
    coll_copy(old, data, length * stride)
    if (capacity != I64{0}) -> jet_rt_free(old, capacity * stride, I64{8})
    rt_text_store(sequence + DATA_SEQUENCE_CAPACITY, next)
    rt_text_store(sequence + DATA_SEQUENCE_DATA, data)
    data + length * stride
}
fn data_u8_list_copy_into(source: I64, target: I64) {
    length :: rt_text_word(source + DATA_SEQUENCE_LENGTH)
    data :: if (length == I64{0}) -> I64{0} else -> jet_rt_alloc(length * RT_HOST_U8_STRIDE, I64{8})
    rt_text_store(target + DATA_SEQUENCE_LENGTH, length)
    rt_text_store(target + DATA_SEQUENCE_CAPACITY, length)
    rt_text_store(target + DATA_SEQUENCE_DATA, data)
    original :: rt_text_word(source + DATA_SEQUENCE_DATA)
    at := I64{0}
    loop at < length {
        host_u8_put(data, at, host_u8_get(original, at))
        at += I64{1}
    }
}
fn data_u8_list_drop_fields(value: I64) {
    capacity :: rt_text_word(value + DATA_SEQUENCE_CAPACITY)
    if (capacity != I64{0}) -> jet_rt_free(rt_text_word(value + DATA_SEQUENCE_DATA), capacity * RT_HOST_U8_STRIDE, I64{8})
}
fn data_text_list_copy_into(source: I64, target: I64) {
    length :: rt_text_word(source)
    data :: if (length == I64{0}) -> I64{0} else -> jet_rt_alloc(length * I64{8}, I64{8})
    rt_text_store(target, length)
    rt_text_store(target + I64{8}, length)
    rt_text_store(target + I64{16}, data)
    original :: rt_text_word(source + I64{16})
    at := I64{0}
    loop at < length {
        rt_text_store(data + at * I64{8}, jet_rt_string_clone(rt_text_word(original + at * I64{8})))
        at += I64{1}
    }
}
