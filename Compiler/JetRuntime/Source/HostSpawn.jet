        fd_put(fallback_argv, I64{0}, wrapping(scratch + I64{96}))
        fd_put(fallback_argv, I64{8}, I64{0})
        at = I64{1}
        loop at < argc {
            fd_put(fallback_argv, wrapping((at + I64{1}) * I64{8}), fd_word(argv, wrapping(at * I64{8})))
            at = wrapping(at + I64{1})
