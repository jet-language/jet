    }
    fallback_argv := I64{0}
    fallback_size := I64{0}
    if (failure == I64{0} && fd_word(candidates, I64{0}) != I64{0} && fd_word(candidates, I64{16}) != I64{0}) {
        // Parent-prepared /bin/sh NUL bytes and argv; child changes only argv[1].
        fd_put(scratch, I64{96}, I64{29400045130965551})
