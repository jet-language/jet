// Private mechanical ProcessSpec216, align8; NOT a public ProcessSpec alias.
// cmd0; has_cwd8/cwd16; env_clear24; env_names32/env_values40/env_remove48;
// has_stdin56/stdin64; stdout72/stderr80; has_timeout88/timeout96;
// has_output_limit104/output_limit112; has_cpu120/cpu_ms128;
// has_memory136/memory_bytes144; has_open152/open_files160; start_session168;
// has_terminal176/terminal184; has_policy192/policy200; inherited_dirs208.
// E4 texts and List24 [len,cap,data] headers are owned. Directory rows24:
// retained FD72@0, target child fd@8, as_cwd@16. Terminal24: cols,rows,mode.
// Optional absent children are zero; source prepares/validates all policy.
// Launch borrows ExecCandidates32: count@0, NUL candidate column@8,
// scriptFallback I64@16, searched I64@24 (Linux ignores searched), and Core's
// NUL argv/env pointer columns. Source alone computes PATH and fallback policy.
// no PATH search, environment read/write, authority, digest, or error policy.
// Child72 shared carrier: mutex0,pid8,reaped16,status24,stdin32,stdout40,
// stderr48,pty56,refs64. A native descriptor of -1 is absent/closed.
// shared aliases; last release closes streams. Source owns kill/reap/drop
// cleanup policy and calls the corresponding raw operations explicitly.
// Launch stage facts: 0 success,1 prepare,2 fork,3 cwd,4 descriptor mapping,
// 5 session/controlling terminal,6 resource limit,7 exec,8 handshake.
// PTY prepare stages:9 openpt,10 unlockpt,11 slave peer,12 winsize,
// 13 tcgetattr,14 tcsetattr. ErrorOut32 is shared with HostFiles.
// WindowsLaunchFacts136 align8 (all borrowed for launch): appcontainer U32@0,
// internetClient U32@4, name LENGTH-DELIMITED E4*@8 (not a NUL column);
// grantCount I64@16, paths NUL UTF8/WTF8 column@24, access U32*@32,
// inheritance U32*@40, mode U32*@48; job U32@56, hasCpu U32@60, cpuMs I64@64;
// hasMemory U32@72, hasOpen U32@76, memoryBytes I64@80, openFiles I64@88;
// pty U32@96, creationFlags U32@100, cols U16@104, rows U16@106, pad U32@108=0.
// jobActiveProcesses U32@112, jobLimitFlags U32@116,
// jobProcessMemory U64@120, jobMemory U64@128.
// The Windows seed converts each column losslessly and owns OS sidecar
// resources; Linux and macOS receive osFacts=0.
fn spawn_text_list_clone(list: I64) -> I64 {
    if (list == I64{0}) { return I64{0} }
    length :: fd_word(list, I64{0})
    out :: jet_rt_alloc(I64{24}, I64{8})
    data :: if (length == I64{0}) -> I64{0} else -> jet_rt_alloc(wrapping(length * I64{8}), I64{8})
    fd_put(out, I64{0}, length)
    fd_put(out, I64{8}, length)
    fd_put(out, I64{16}, data)
    at := I64{0}
    loop at < length {
        fd_put(data, wrapping(at * I64{8}), jet_rt_string_clone(fd_word(fd_word(list, I64{16}), wrapping(at * I64{8}))))
        at = wrapping(at + I64{1})
    }
    out
}

fn spawn_list_free(list: I64, stride: I64) {
    data :: fd_word(list, I64{16})
    if (data != I64{0}) { jet_rt_free(data, wrapping(fd_word(list, I64{8}) * stride), I64{8}) }
    jet_rt_free(list, I64{24}, I64{8})
}

fn spawn_text_list_drop(list: I64) {
    if (list == I64{0}) {
        return
    }
    at := I64{0}
    loop at < fd_word(list, I64{0}) {
        jet_rt_string_drop(fd_word(fd_word(list, I64{16}), wrapping(at * I64{8})))
        at = wrapping(at + I64{1})
    }
    spawn_list_free(list, I64{8})
}

fn spawn_dirs_clone(list: I64) -> I64 {
    if (list == I64{0}) { return I64{0} }
    length :: fd_word(list, I64{0})
    out :: jet_rt_alloc(I64{24}, I64{8})
    data :: if (length == I64{0}) -> I64{0} else -> jet_rt_alloc(wrapping(length * I64{24}), I64{8})
    fd_put(out, I64{0}, length)
    fd_put(out, I64{8}, length)
    fd_put(out, I64{16}, data)
    at := I64{0}
    loop at < length {
        source :: wrapping(fd_word(list, I64{16}) + at * I64{24})
        target :: wrapping(data + at * I64{24})
        fd_put(target, I64{0}, jet_fd_retain_raw(fd_word(source, I64{0})))
        fd_put(target, I64{8}, fd_word(source, I64{8}))
        fd_put(target, I64{16}, fd_word(source, I64{16}))
        at = wrapping(at + I64{1})
    }
    out
}

// Consumes only the owned child pointers in the source-built mechanical row;
// the caller retains its 216-byte packing storage. This is not __spec_fields.
#Export(c) fn jet_process_spec_take_raw(words: I64) -> I64 {
    spec :: jet_rt_alloc(I64{216}, I64{8})
    rt_text_bytes_copy(spec, words, I64{216})
    spec
}

#Export(c) fn jet_process_spec_clone_raw(spec: I64) -> I64 {
    out :: jet_rt_alloc(I64{216}, I64{8})
    rt_text_bytes_copy(out, spec, I64{216})
    fd_put(out, I64{0}, spawn_text_list_clone(fd_word(spec, I64{0})))
    fd_put(out, I64{16}, if (fd_word(spec, I64{16}) == I64{0}) -> I64{0} else -> jet_rt_string_clone(fd_word(spec, I64{16})))
    fd_put(out, I64{32}, spawn_text_list_clone(fd_word(spec, I64{32})))
    fd_put(out, I64{40}, spawn_text_list_clone(fd_word(spec, I64{40})))
    fd_put(out, I64{48}, spawn_text_list_clone(fd_word(spec, I64{48})))
    terminal :: fd_word(spec, I64{184})
    if (terminal != I64{0}) {
        copied :: jet_rt_alloc(I64{24}, I64{8})
        rt_text_bytes_copy(copied, terminal, I64{24})
        fd_put(out, I64{184}, copied)
    }
    fd_put(out, I64{200}, if (fd_word(spec, I64{200}) == I64{0}) -> I64{0} else -> jet_rt_string_clone(fd_word(spec, I64{200})))
    fd_put(out, I64{208}, spawn_dirs_clone(fd_word(spec, I64{208})))
    out
}

#Export(c) fn jet_process_spec_drop_raw(spec: I64) {
    if (spec == I64{0}) {
        return
    }
    spawn_text_list_drop(fd_word(spec, I64{0}))
    jet_rt_string_drop(fd_word(spec, I64{16}))
    spawn_text_list_drop(fd_word(spec, I64{32}))
    spawn_text_list_drop(fd_word(spec, I64{40}))
    spawn_text_list_drop(fd_word(spec, I64{48}))
    terminal :: fd_word(spec, I64{184})
    if (terminal != I64{0}) { jet_rt_free(terminal, I64{24}, I64{8}) }
    jet_rt_string_drop(fd_word(spec, I64{200}))
    dirs :: fd_word(spec, I64{208})
    if (dirs != I64{0}) {
        at := I64{0}
        loop at < fd_word(dirs, I64{0}) {
            jet_fd_drop_raw(fd_word(fd_word(dirs, I64{16}), wrapping(at * I64{24})))
            at = wrapping(at + I64{1})
        }
        spawn_list_free(dirs, I64{24})
    }
    jet_rt_free(spec, I64{216}, I64{8})
}

// Prepare a CLOEXEC pipe; each half is immediately moved above every child
// target before any fork or dup2. scratch borrows one eight-byte pipe2 output.
fn spawn_pipe(scratch: I64, minimum: I64, read_out: I64, write_out: I64) -> I64 {
    fd_put(scratch, I64{0}, I64{0})
    result :: host_call(I64{293}, scratch, I64{524288}, I64{0})
    if (result < I64{0}) { return result }
    packed :: fd_word(scratch, I64{0})
    a :: packed.bit_and(I64{4294967295})
    b :: (packed >> I64{32}).bit_and(I64{4294967295})
    x :: host_call(I64{72}, a, I64{1030}, minimum)
    y :: if (x < I64{0}) -> x else -> host_call(I64{72}, b, I64{1030}, minimum)
    _ := host_call(I64{3}, a, I64{0}, I64{0})
    _ := host_call(I64{3}, b, I64{0}, I64{0})
    if (y < I64{0}) {
        if (x >= I64{0}) { _ := host_call(I64{3}, x, I64{0}, I64{0}) }
        return y
    }
    fd_put(read_out, I64{0}, x)
    fd_put(write_out, I64{0}, y)
    I64{0}
}

fn spawn_dup_above(state: I64, minimum: I64) -> I64 {
    fd_lock(state)
    result :: if (fd_word(state, I64{16}) != I64{0}) -> I64{-9} else -> host_call(I64{72}, fd_word(state, I64{8}), I64{1030}, minimum)
    fd_unlock(state)
    result
}

fn spawn_close(number: I64) {
    if (number >= I64{0}) { _ := host_call(I64{3}, number, I64{0}, I64{0}) }
}

fn spawn_child_new() -> I64 {
    child :: jet_rt_alloc(I64{72}, I64{8})
    fd_put(child, I64{0}, I64{0})
    fd_put(child, I64{8}, I64{0})
    fd_put(child, I64{16}, I64{0})
    fd_put(child, I64{24}, I64{0})
    fd_put(child, I64{32}, I64{-1})
    fd_put(child, I64{40}, I64{-1})
    fd_put(child, I64{48}, I64{-1})
    fd_put(child, I64{56}, I64{-1})
    fd_put(child, I64{64}, I64{1})
    child
}

fn spawn_plan_close(plan: I64, count: I64) {
    at := I64{0}
    loop at < count {
        spawn_close(fd_word(plan, wrapping(at * I64{16})))
        at = wrapping(at + I64{1})
    }
}

// Parent-only PTY setup mirrors ProcessPty.rs's posix_openpt/unlockpt/open
// plus Term.rs configure_fd(cfmakeraw). Linux TIOCGPTPEER avoids libc's
// process-global ptsname buffer without changing the opened slave.
fn spawn_pty(terminal: I64, scratch: I64, minimum: I64, child: I64) -> I64 {
    fd_put(scratch, I64{64}, I64{9})
    fd_put(scratch, I64{96}, I64{7887052196584711215})
    fd_put(scratch, I64{104}, I64{120})
    master :: host_call(I64{2}, wrapping(scratch + I64{96}), I64{524546}, I64{0})
    if (master < I64{0}) { return master }
    fd_put(scratch, I64{0}, I64{0})
    fd_put(scratch, I64{64}, I64{10})
    result := host_call(I64{16}, master, I64{1074025521}, scratch)
    slave := I64{-1}
    if (result == I64{0}) {
        fd_put(scratch, I64{64}, I64{11})
        slave = host_call(I64{16}, master, I64{21569}, I64{524546})
        if (slave < I64{0}) { result = slave }
    }
    if (result == I64{0}) {
        fd_put(scratch, I64{64}, I64{12})
        fd_put(scratch, I64{0}, (fd_word(terminal, I64{8}).bit_and(I64{65535})).bit_or(((fd_word(terminal, I64{0}).bit_and(I64{65535})) << I64{16})))
        result = host_call(I64{16}, slave, I64{21524}, scratch)
    }
    if (result == I64{0}) {
        fd_put(scratch, I64{64}, I64{13})
        result = host_call(I64{16}, slave, I64{21505}, scratch)
        if (result == I64{0}) {
            if (fd_word(terminal, I64{16}) == HOST_TERMINAL_MODE_RAW) {
                input_output :: fd_word(scratch, I64{0})
                control_local :: fd_word(scratch, I64{8})
                fd_put(scratch, I64{0}, (input_output.bit_and(I64{4294965780})).bit_or((((input_output >> I64{32}).bit_and(I64{4294967294})) << I64{32})))
                fd_put(scratch, I64{8}, ((control_local.bit_and(I64{4294966991})).bit_or(I64{48})).bit_or((((control_local >> I64{32}).bit_and(I64{4294934452})) << I64{32})))
                #Unsafe("Linux TCGETS initialized the 36-byte termios buffer; cfmakeraw sets VMIN=1, VTIME=0 in its control-character array") {
                    os_store_u8(wrapping(scratch + I64{23}), I64{1})
                    os_store_u8(wrapping(scratch + I64{22}), I64{0})
                }
            }
            fd_put(scratch, I64{64}, I64{14})
            result = host_call(I64{16}, slave, I64{21506}, scratch)
        }
    }
    if (result == I64{0}) { fd_put(scratch, I64{64}, I64{1}) }
    copied_master :: if (result < I64{0}) -> result else -> host_call(I64{72}, master, I64{1030}, minimum)
    copied_slave :: if (copied_master < I64{0}) -> copied_master else -> host_call(I64{72}, slave, I64{1030}, minimum)
    spawn_close(master)
    spawn_close(slave)
    if (copied_slave < I64{0}) {
        if (copied_master >= I64{0}) { spawn_close(copied_master) }
        return copied_slave
    }
    fd_put(child, I64{56}, copied_master)
    copied_slave
}

fn spawn_cpu_seconds(milliseconds: I64) -> I64 {
    // ProcessPty.rs max(0).saturating_add(999)/1000, after source normalization.
    rounded :: if (milliseconds > I64{9223372036854774808}) -> I64{9223372036854775807} else -> wrapping(milliseconds + I64{999})
    rounded /% I64{1000}
}
// glibc posix/execvpe.c on the pinned Linux floor: 0 stops, 1 continues,
// 2 records EACCES and continues. Pure syscall errno facts, no source policy.
fn spawn_exec_errno_class(result: I64) -> I64 {
    if (result == I64{-13}) { return I64{2} }
    if (result == I64{-2} || result == I64{-116} || result == I64{-20} || result == I64{-19} || result == I64{-110}) {
        return I64{1}
    }
    I64{0}
}

// ONLY raw word loads/stores/syscalls are reachable after fork. In particular
// there is no allocation, exact-Int/Text helper, mutex, or inherited TLS use.
// Mirrors std::process's Unix fork+pre_exec path used by ProcessPty.rs.
fn spawn_exec_child(plan: I64, count: I64, child: I64, scratch: I64, err_read: I64, err_write: I64, candidates: I64, argv: I64, envp: I64, fallback_argv: I64, cwd: I64, dirs: I64, session: Bool, terminal: Bool, cpu: Bool, memory: Bool, files: Bool) {
    spawn_close(err_read)
    spawn_close(fd_word(child, I64{32}))
    spawn_close(fd_word(child, I64{40}))
    spawn_close(fd_word(child, I64{48}))
    spawn_close(fd_word(child, I64{56}))
    result := I64{0}
    stage := I64{4}
    at := I64{0}
    loop at < (I64{3}) {
        source :: fd_word(plan, wrapping(at * I64{16}))
        target :: fd_word(plan, wrapping(at * I64{16} + I64{8}))
        if (source >= I64{0} && target >= I64{0}) {
            result = host_call(I64{33}, source, target, I64{0})
        }
        if (result < I64{0}) { break }
        at = wrapping(at + I64{1})
    }
    if (result >= I64{0} && cwd != I64{0}) {
        stage = I64{3}
        result = host_call(I64{80}, cwd, I64{0}, I64{0})
    }
    if (result >= I64{0}) {
        stage = I64{5}
        if !session -> result = host_call(I64{109}, I64{0}, I64{0}, I64{0})
        if (result >= I64{0}) {
            // std do_exec resets SIGPIPE after fd/cwd/process-group actions.
            #Unsafe("rt_sigaction borrows four initialized stack words; no allocator, mutex or TLS is touched after fork") {
                result = os_syscall_stack4_i64(I64{13}, I64{13}, I64{0}, I64{0}, I64{0}, I64{0}, I64{8})
            }
        }
    }
    // Held-directory pre_exec was registered first: each dup2 then its fchdir,
    // after stdio/cwd/group/SIGPIPE and before the limits/session closure.
    if (result >= I64{0}) {
        at = I64{3}
        loop at < count {
            stage = I64{4}
            source :: fd_word(plan, wrapping(at * I64{16}))
            target :: fd_word(plan, wrapping(at * I64{16} + I64{8}))
            result = host_call(I64{33}, source, target, I64{0})
            if (result < I64{0}) { break }
            row :: wrapping(fd_word(dirs, I64{16}) + (at - I64{3}) * I64{24})
            if (fd_word(row, I64{16}) != I64{0}) {
                stage = I64{3}
                result = host_call(I64{81}, source, I64{0}, I64{0})
                if (result < I64{0}) { break }
            }
            at = wrapping(at + I64{1})
        }
    }
    if (result >= I64{0}) {
        stage = I64{6}
        if cpu -> result = host_call(I64{160}, I64{0}, wrapping(scratch + I64{16}), I64{0})
        if (result >= I64{0} && memory) {
            result = host_call(I64{160}, I64{9}, wrapping(scratch + I64{32}), I64{0})
        }
        if (result >= I64{0} && files) {
            result = host_call(I64{160}, I64{7}, wrapping(scratch + I64{48}), I64{0})
        }
    }
    if (result >= I64{0}) {
        stage = I64{5}
        if session -> result = host_call(I64{112}, I64{0}, I64{0}, I64{0})
        if (result >= I64{0} && terminal) {
            result = host_call(I64{16}, I64{0}, I64{21518}, I64{0})
        }
    }
    spawn_plan_close(plan, count)
    if (result >= I64{0}) {
        stage = I64{7}
        result = I64{-2}
        denied := false
        at = I64{0}
        loop at < fd_word(candidates, I64{0}) {
            name :: fd_word(fd_word(candidates, I64{8}), wrapping(at * I64{8}))
            result = host_call(I64{59}, name, argv, envp)
            if (result == I64{-8} && fallback_argv != I64{0}) {
                fd_put(fallback_argv, I64{8}, name)
                result = host_call(I64{59}, wrapping(scratch + I64{96}), fallback_argv, envp)
            }
            class :: spawn_exec_errno_class(result)
            if (class == I64{0}) { break }
            if (class == I64{2}) { denied = true }
            at = wrapping(at + I64{1})
        }
        if (at == fd_word(candidates, I64{0}) && denied) { result = I64{-13} }
    }
    fd_put(scratch, I64{64}, stage)
    fd_put(scratch, I64{72}, wrapping(I64{0} - result))
    at = I64{0}
    loop at < (I64{16}) {
        sent :: host_call(I64{1}, err_write, wrapping(scratch + I64{64} + at), wrapping(I64{16} - at))
        if (sent == I64{-4}) { next }
        if (sent <= I64{0}) { break }
        at = wrapping(at + sent)
    }
    _ := host_call(I64{231}, I64{127}, I64{0}, I64{0})
}

#Export(c) fn jet_process_spawn_raw(spec: I64, candidates: I64, argv: I64, envp: I64, os_facts: I64, error: I64) -> I64 {
    dirs :: fd_word(spec, I64{208})
    dir_count :: if (dirs == I64{0}) -> I64{0} else -> fd_word(dirs, I64{0})
    count :: wrapping(dir_count + I64{3})
    plan_size :: wrapping(count * I64{16})
    plan :: jet_rt_alloc(plan_size, I64{8})
    scratch :: jet_rt_alloc(I64{128}, I64{8})
    child :: spawn_child_new()
    // This target's source supplies osFacts=0, never a fake platform fallback.
    fd_put(scratch, I64{64}, I64{1})
    minimum := I64{3}
    at := I64{0}
    loop at < count {
        fd_put(plan, wrapping(at * I64{16}), I64{-1})
        fd_put(plan, wrapping(at * I64{16} + I64{8}), I64{-1})
        at = wrapping(at + I64{1})
    }
    at = I64{0}
    loop at < dir_count {
        target :: fd_word(fd_word(dirs, I64{16}), wrapping(at * I64{24} + I64{8}))
        if (target >= minimum) { minimum = wrapping(target + I64{1}) }
        at = wrapping(at + I64{1})
    }
    err_read := I64{-1}
    err_write := I64{-1}
    result :: spawn_pipe(scratch, minimum, wrapping(scratch + I64{8}), wrapping(scratch + I64{112}))
    failure := result
    if (result == I64{0}) {
        err_read = fd_word(scratch, I64{8})
        err_write = fd_word(scratch, I64{112})
    }
    terminal :: fd_word(spec, I64{176}) != I64{0}
    session :: fd_word(spec, I64{168}) != I64{0}
    if (failure == I64{0} && terminal) {
        slave :: spawn_pty(fd_word(spec, I64{184}), scratch, minimum, child)
        if (slave < I64{0}) { failure = slave } else {
            fd_put(plan, I64{0}, slave)
            fd_put(plan, I64{8}, I64{0})
            second :: host_call(I64{72}, slave, I64{1030}, minimum)
            third :: if (second < I64{0}) -> second else -> host_call(I64{72}, slave, I64{1030}, minimum)
            if (third < I64{0}) {
                failure = third
                if (second >= I64{0}) { spawn_close(second) }
            } else {
                fd_put(plan, I64{16}, second)
                fd_put(plan, I64{24}, I64{1})
                fd_put(plan, I64{32}, third)
                fd_put(plan, I64{40}, I64{2})
            }
        }
    }
    if (failure == I64{0} && !terminal) {
        index := I64{0}
        loop index < (I64{3}) {
            mode :: fd_word(spec, wrapping(I64{64} + index * I64{8}))
            target :: wrapping(plan + index * I64{16})
            // Null=3 is private prepared transport data, not a public enum arm.
            if ((index == I64{0} && fd_word(spec, I64{56}) == I64{0}) || mode == I64{3}) {
                fd_put(scratch, I64{96}, I64{7815273878500238383})
                fd_put(scratch, I64{104}, I64{108})
                null_fd :: host_call(I64{2}, wrapping(scratch + I64{96}), I64{524288}.bit_or((if (index == I64{0}) -> I64{0} else -> I64{1})), I64{0})
                copied :: if (null_fd < I64{0}) -> null_fd else -> host_call(I64{72}, null_fd, I64{1030}, minimum)
                spawn_close(null_fd)
                if (copied < I64{0}) {
                    failure = copied
                    break
                }
                fd_put(target, I64{0}, copied)
                fd_put(target, I64{8}, index)
            } else if (mode != HOST_PROCESS_STREAM_INHERIT) {
                pipe_result :: spawn_pipe(scratch, minimum, wrapping(scratch + I64{8}), wrapping(scratch + I64{112}))
                if (pipe_result < I64{0}) {
                    failure = pipe_result
                    break
                }
                a :: fd_word(scratch, I64{8})
                b :: fd_word(scratch, I64{112})
                fd_put(target, I64{0}, if (index == I64{0}) -> a else -> b)
                fd_put(target, I64{8}, index)
                fd_put(child, wrapping(I64{32} + index * I64{8}), if (index == I64{0}) -> b else -> a)
            }
            index = wrapping(index + I64{1})
        }
    }
    if (failure == I64{0}) {
        at = I64{0}
        loop at < dir_count {
            row :: wrapping(fd_word(dirs, I64{16}) + at * I64{24})
            copied :: spawn_dup_above(fd_word(row, I64{0}), minimum)
            if (copied < I64{0}) {
                failure = copied
                break
            }
