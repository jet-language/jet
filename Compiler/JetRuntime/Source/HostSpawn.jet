        fd_put(fallback_argv, wrapping((slots - I64{1}) * I64{8}), I64{0})
    }
    cwd :: if (failure != I64{0} || fd_word(spec, I64{8}) == I64{0}) -> I64{0} else -> fd_c_path(fd_word(spec, I64{16}))
    cpu :: fd_word(spec, I64{120}) != I64{0}
    memory :: fd_word(spec, I64{136}) != I64{0}
    files :: fd_word(spec, I64{152}) != I64{0}
    // Source-normalized fixed i64 limits; prepare only the requested syscalls.
    if cpu {
        seconds :: spawn_cpu_seconds(fd_word(spec, I64{128}))
        fd_put(scratch, I64{16}, seconds)
        fd_put(scratch, I64{24}, wrapping(seconds + I64{1}))
    }
    if memory {
        fd_put(scratch, I64{32}, fd_word(spec, I64{144}))
        fd_put(scratch, I64{40}, fd_word(spec, I64{144}))
    }
    if files {
        fd_put(scratch, I64{48}, fd_word(spec, I64{160}))
        fd_put(scratch, I64{56}, fd_word(spec, I64{160}))
    }
    pid := I64{-1}
    stage := fd_word(scratch, I64{64})
    if (failure == I64{0}) {
        jet_rt_stdout_flush()
        pid = host_call(I64{57}, I64{0}, I64{0}, I64{0})
        if (pid == I64{0}) {
            spawn_exec_child(plan, count, child, scratch, err_read, err_write, candidates, argv, envp, fallback_argv, cwd, dirs, session, terminal, cpu, memory, files)
        }
        if (pid < I64{0}) {
            failure = pid
            stage = I64{2}
        } else {
            spawn_close(err_write)
            err_write = I64{-1}
            fd_put(child, I64{8}, pid)
            got := I64{0}
            loop got < (I64{16}) {
                read_count :: host_call(I64{0}, err_read, wrapping(scratch + I64{64} + got), wrapping(I64{16} - got))
                if (read_count == I64{-4}) { next }
                if (read_count < I64{0}) {
                    failure = read_count
                    stage = I64{8}
                    break
                }
                if (read_count == I64{0}) { break }
                got = wrapping(got + read_count)
            }
            if (failure == I64{0} && got != I64{0}) {
                if (got == I64{16}) {
                    stage = fd_word(scratch, I64{64})
                    failure = wrapping(I64{0} - fd_word(scratch, I64{72}))
                } else {
                    stage = I64{8}
                    failure = I64{-5}
                }
            }
        }
    }
    spawn_plan_close(plan, count)
    spawn_close(err_read)
    spawn_close(err_write)
    if (cwd != I64{0}) { fd_c_path_drop(cwd, fd_word(spec, I64{16})) }
    if (fallback_argv != I64{0}) { jet_rt_free(fallback_argv, fallback_size, I64{8}) }
    jet_rt_free(plan, plan_size, I64{8})
    if (failure != I64{0}) {
        if (pid > I64{0}) {
            if (stage == I64{8}) { _ := host_call(I64{62}, pid, I64{9}, I64{0}) }
            loop {
                reaped :: host_call(I64{61}, pid, wrapping(scratch + I64{80}), I64{0})
                if (reaped != I64{-4}) { break }
