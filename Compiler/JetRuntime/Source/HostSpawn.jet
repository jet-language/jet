        }
        spawn_close(fd_word(child, I64{32}))
        spawn_close(fd_word(child, I64{40}))
        spawn_close(fd_word(child, I64{48}))
        spawn_close(fd_word(child, I64{56}))
        jet_rt_free(child, I64{72}, I64{8})
    }
    jet_rt_free(scratch, I64{128}, I64{8})
    host_error_out(failure, stage, error)
    if (failure == I64{0}) -> child else -> I64{0}
}

#Export(c) fn jet_process_retain_raw(child: I64) -> I64 {
    sync_mutex_lock(child)
    fd_put(child, I64{64}, wrapping(fd_word(child, I64{64}) + I64{1}))
    sync_mutex_unlock(child)
    child
}

#Export(c) fn jet_process_drop_raw(child: I64) {
    if (child == I64{0}) {
        return
    }
    sync_mutex_lock(child)
    refs :: wrapping(fd_word(child, I64{64}) - I64{1})
    fd_put(child, I64{64}, refs)
    if (refs != I64{0}) {
        sync_mutex_unlock(child)
        return
    }
    spawn_close(fd_word(child, I64{32}))
    spawn_close(fd_word(child, I64{40}))
    spawn_close(fd_word(child, I64{48}))
    spawn_close(fd_word(child, I64{56}))
    jet_rt_free(child, I64{72}, I64{8})
}

#Export(c) fn jet_process_id_raw(child: I64) -> I64 { fd_word(child, I64{8}) }

#Export(c) fn jet_process_wait_raw(child: I64, nohang: Bool, status: I64, error: I64) -> I64 {
    pid :: fd_word(child, I64{8})
    loop {
        sync_mutex_lock(child)
        reaped :: fd_word(child, I64{16})
        if (reaped == I64{1}) {
            fd_put(status, I64{0}, fd_word(child, I64{24}))
            sync_mutex_unlock(child)
            host_error_out(I64{0}, I64{0}, error)
            return pid
        }
        if (reaped == I64{-1}) {
            sync_mutex_unlock(child)
            if nohang {
                host_error_out(I64{0}, I64{0}, error)
                return I64{0}
            }
            _ := sync_wait(wrapping(child + I64{16}), I64{4294967295}, I64{-1})
            next
        }
        fd_put(child, I64{16}, I64{-1})
        sync_mutex_unlock(child)
        fd_put(status, I64{0}, I64{0})
        result := I64{0}
        loop {
            result = host_call(I64{61}, pid, status, if nohang -> I64{1} else -> I64{0})
            if (result != I64{-4}) { break }
        }
        sync_mutex_lock(child)
        if (result > I64{0}) {
            fd_put(child, I64{24}, fd_word(status, I64{0}).bit_and(I64{4294967295}))
            compiler_process_record_exit_status(pid, fd_word(child, I64{24}))
            fd_put(child, I64{16}, I64{1})
        } else { fd_put(child, I64{16}, I64{0}) }
        sync_mutex_unlock(child)
        sync_wake(wrapping(child + I64{16}), I64{2147483647})
        return fd_error(result, error)
    }
}

#Export(c) fn jet_process_kill_raw(child: I64, signal: I64, group: Bool, error: I64) {
    native_signal :: host_i32(signal)
    if (jet_scheduler_native_propagate() != I64{0}) -> return
    sync_mutex_lock(child)
    pid :: fd_word(child, I64{8})
    // std::process::Child::kill succeeds after its cached reap. Explicit
    // group signalling can still clean descendants after their leader exits.
    result :: if (!group && fd_word(child, I64{16}) == I64{1}) -> I64{0} else -> host_call(I64{62}, if group -> wrapping(I64{0} - pid) else -> pid, native_signal, I64{0})
    sync_mutex_unlock(child)
    _ := fd_error(result, error)
}

fn spawn_stream_offset(child: I64, stream: I64) -> I64 {
    // Terminal stdin/stdout share the master, stderr stays absent.
    if (fd_word(child, I64{56}) >= I64{0} && stream != I64{2}) { return I64{56} }
    wrapping(I64{32} + stream * I64{8})
}

fn spawn_stream_dup(child: I64, stream: I64) -> I64 {
    sync_mutex_lock(child)
    offset :: spawn_stream_offset(child, stream)
    original :: fd_word(child, offset)
    result :: if (original < I64{0}) -> I64{-9} else -> host_call(I64{72}, original, I64{1030}, I64{3})
    sync_mutex_unlock(child)
    if (result >= I64{0} && offset == I64{56}) -> result.bit_or(I64{4294967296}) else -> result
}

fn spawn_stream_io(child: I64, stream: I64, bytes: I64, length: I64, number: I64, error: I64) -> I64 {
    index :: host_native_int(stream)
    if (jet_scheduler_native_propagate() != I64{0}) -> return I64{0}
    requested :: host_native_int(length)
    if (jet_scheduler_native_propagate() != I64{0}) -> return I64{0}
    packed :: spawn_stream_dup(child, index)
    if (packed < I64{0}) { return fd_error(packed, error) }
    native :: packed.bit_and(I64{4294967295})
    result := I64{0}
    loop {
        result = host_call(number, native, bytes, requested)
        if (result != I64{-4}) { break }
    }
    spawn_close(native)
    // Capture PTY-ness before blocking so an alias's concurrent close does
    // not turn the Linux hung-up PTY EIO fact into a different source error.
    if (number == I64{0} && result == I64{-5} && (packed.bit_and(I64{4294967296})) != I64{0}) {
        result = I64{0}
    }
    fd_error(result, error)
}

#Export(c) fn jet_process_read_raw(child: I64, stream: I64, bytes: I64, length: I64, error: I64) -> I64 {
    spawn_stream_io(child, stream, bytes, length, I64{0}, error)
}

#Export(c) fn jet_process_write_raw(child: I64, stream: I64, bytes: I64, length: I64, error: I64) -> I64 {
    spawn_stream_io(child, stream, bytes, length, I64{1}, error)
}

#Export(c) fn jet_process_close_stream_raw(child: I64, stream: I64, error: I64) {
    index :: host_native_int(stream)
    if (jet_scheduler_native_propagate() != I64{0}) -> return
    sync_mutex_lock(child)
    offset :: spawn_stream_offset(child, index)
    native :: fd_word(child, offset)
    fd_put(child, offset, I64{-1})
    result :: if (native < I64{0}) -> I64{0} else -> host_call(I64{3}, native, I64{0}, I64{0})
    sync_mutex_unlock(child)
    _ := fd_error(result, error)
}

#Export(c) fn jet_process_resize_raw(child: I64, cols: I64, rows: I64, error: I64) {
    native_rows :: host_native_int(rows)
    if (jet_scheduler_native_propagate() != I64{0}) -> return
    native_cols :: host_native_int(cols)
    if (jet_scheduler_native_propagate() != I64{0}) -> return
    size :: (native_rows.bit_and(I64{65535})).bit_or(((native_cols.bit_and(I64{65535})) << I64{16}))
    sync_mutex_lock(child)
    master :: fd_word(child, I64{56})
    result := I64{-9}
    if (master >= I64{0}) {
        #Unsafe("ioctl borrows one stack word of source-validated winsize dimensions; no pointer escapes") {
            result = os_ioctl_word_i64(master, I64{21524}, size)
        }
    }
    sync_mutex_unlock(child)
    _ := fd_error(result, error)
}

// Mechanical libc OS floor, ledgered like the resolver. realpath writes into
// caller-owned Jet memory, never libc malloc, so allocator domains cannot mix.
#Import(c) fn process_realpath(path: I64, buffer: I64) -> I64 = "realpath"

#Export(c) fn jet_process_path_stat_raw(path: I64, facts: I64, error: I64) {
    result := I64{0}
    #Unsafe("source lends a NUL-terminated raw path including non-Unicode bytes and a writable 128-byte stat fact row") {
        result = os_stat_facts_i64(I64{4}, path, facts)
    }
    _ := fd_error(result, error)
}

// Returns a compact byte buffer owned by the caller: length excludes NUL,
// capacity is exactly 4096. Unpack once and free(buffer, capacity, 1), NOT len.
#Export(c) fn jet_process_path_canonicalize_raw(path: I64, length: I64, capacity: I64, error: I64) -> I64 {
    buffer :: jet_rt_alloc(I64{4096}, I64{1})
    result := I64{0}
    #Unsafe("the source-approved native NUL path and Jet-owned PATH_MAX buffer are live across the mechanical realpath call") {
        result = process_realpath(path, buffer)
    }
    if (result == I64{0}) {
        errno := I64{0}
        #Unsafe("libc __errno_location returns this calling thread's live errno int; read only its initialized four bytes") {
            at :: net_errno_location()
            errno = os_load_u8(at).bit_or((os_load_u8(wrapping(at + I64{1})) << I64{8})).bit_or((os_load_u8(wrapping(at + I64{2})) << I64{16})).bit_or((os_load_u8(wrapping(at + I64{3})) << I64{24}))
        }
        jet_rt_free(buffer, I64{4096}, I64{1})
        fd_put(length, I64{0}, I64{0})
        fd_put(capacity, I64{0}, I64{0})
        host_error_out(wrapping(I64{0} - errno), I64{0}, error)
        return I64{0}
    }
    count := I64{0}
    #Unsafe("successful realpath NUL-terminates its result within the PATH_MAX byte buffer") {
        loop os_load_u8(wrapping(buffer + count)) != (I64{0}) -> count = wrapping(count + I64{1})
    }
    fd_put(length, I64{0}, count)
    fd_put(capacity, I64{0}, I64{4096})
    host_error_out(I64{0}, I64{0}, error)
    buffer
}

#Export(c) fn jet_host_os_error_text_raw(_domain: I64, code: I64) -> I64 {
    jet_sys_errno_text_raw(code)
}

// Transfers a pipe fd into an independently owned FD72. Terminal stdin and
// stdout mirror the predecessor's try_clone(master): each view owns a dup,
// while the terminal session keeps the original. -2 marks an already-taken
// terminal view; it is never passed to a syscall.
#Export(c) fn jet_process_take_stream_raw(child: I64, stream: I64, error: I64) -> I64 {
    index :: host_native_int(stream)
    if (jet_scheduler_native_propagate() != I64{0}) -> return I64{0}
    sync_mutex_lock(child)
    offset :: wrapping(I64{32} + index * I64{8})
    master :: fd_word(child, I64{56})
    number := I64{-1}
    failure := I64{0}
    if (master >= I64{0} && index < I64{2}) {
        if (fd_word(child, offset) != I64{-2}) {
            number = host_call(I64{72}, master, I64{1030}, I64{3})
            if (number < I64{0}) { failure = number } else { fd_put(child, offset, I64{-2}) }
        }
    } else {
        number = fd_word(child, offset)
        fd_put(child, offset, I64{-1})
    }
    sync_mutex_unlock(child)
    host_error_out(failure, I64{0}, error)
    if (failure < I64{0} || number < I64{0}) { return I64{0} }
    state :: fd_new(number, I64{0}, false)
    fd_put(state, I64{40}, I64{0})
    state
}
