// TCP handle policy over Stream64/Listener8 and FD72, never Rust Word
// limits/counts are raw i64; Duration Word parameters borrow exact ns. List
// bytes follow RT_HOST_U8_STRIDE. Logical close retains the descriptor.
net_tcp_direction_open: fn(stream: I64, reading: Bool, operation: I64, error: I64) -> Bool {
    mask: if reading -> I64{3} else -> I64{5}
    if (jet_socket_stream_flags_raw(stream).bit_and(mask) == I64{0}) -> return true
    _ := net_route_fail_take(NET_ERROR_CLOSED, operation, I64{0}, net_route_message(operation, rt_static_text(" failed: socket is closed")), I64{0}, error)
    false
}
net_tcp_deadline: fn(stream: I64, reading: Bool, save: I64) {
    sync_mutex_lock(wrapping(stream + I64{48}))
    milliseconds: net_word(stream, if reading -> I64{32} else -> I64{40})
    sync_mutex_unlock(wrapping(stream + I64{48}))
    if (milliseconds < I64{0}) {
        net_put(save, I64{0}, if jet_ctx_deadline_present() -> I64{1} else -> I64{0})
        net_put(save, I64{8}, jet_ctx_deadline_ms())
    } else { net_route_deadline_push(milliseconds, save) }
}
net_tcp_timeout_valid: fn(milliseconds: I64, operation: I64, error: I64) -> Bool {
    if (milliseconds >= I64{0}) -> return true
    _ := net_route_fail_take(NET_ERROR_INVALID_INPUT, operation, I64{0}, jet_rt_string_clone(rt_static_text("network timeout must be non-negative")), I64{0}, error)
    false
}
// Duration::as_millis truncates towards zero (-1ns is 0ms, a valid timeout);
// `/%` floors, so drop the truncated remainder first.
net_deadline_millis: fn(deadline: I64) -> I64 {
    nanoseconds: host_native_int(deadline)
    (nanoseconds - nanoseconds %% I64{1000000}) /% I64{1000000}
}
net_tcp_wait: fn(state: I64, interest: I64, operation: I64, scratch: I64, error: I64) -> I64 {
    remaining: if jet_ctx_deadline_present() -> jet_deadline_remaining_ms() else -> I64{-1}
    if (jet_ctx_deadline_present() && remaining <= I64{0}) -> return net_route_timeout(operation, error)
    timeout: if (remaining < I64{0}) -> I64{-1} else if (remaining > I64{9223372036854}) -> I64{9223372036854775807} else -> remaining * I64{1000000}
    // The wait is named by its operation (`tcp accept`, `udp receive`, …).
    ready: host_net_ready(state, interest, timeout, jet_rt_string_clone(operation), scratch)
    if net_route_wait_stop(operation, error) -> return I64{0}
    if (jet_scheduler_native_propagate() != I64{0}) -> return I64{0}
    if (ready < I64{0}) -> return net_route_errno(operation, I64{0}, net_word(scratch, I64{8}), error)
    if (ready == I64{0}) -> return net_route_timeout(operation, error)
    ready
}
// The seed applies both OS timeout options before each read/write, even though
// the socket is nonblocking. Preserve that observable error/order contract.
net_tcp_apply_deadlines: fn(stream: I64, operation: I64, scratch: I64, error: I64) -> Bool {
    if !jet_ctx_deadline_present() -> return true
    remaining: jet_deadline_remaining_ms()
    if (remaining <= I64{0}) {
        _ := net_route_timeout(operation, error)
        return false
    }
    net_put(scratch, I64{0}, remaining /% I64{1000})
    net_put(scratch, I64{8}, remaining % I64{1000} * I64{1000})
    state: jet_socket_stream_fd_raw(stream)
    option := I64{20}
    loop option <= (I64{21}) {
        result: net_socket_call(state, I64{54}, I64{1}, option, scratch, I64{16}, I64{0})
        if (result < I64{0}) {
            name: net_route_message(operation, if (option == I64{20}) -> rt_static_text(" read timeout") else -> rt_static_text(" write timeout"))
            _ := net_route_errno(name, I64{0}, -result, error)
            jet_rt_string_drop(name)
            return false
        }
        option += I64{1}
    }
    true
}
net_tcp_read_result: fn(stream: I64, limit: I64, output: I64, length: I64, text: Bool, explicit: Bool, error: I64) -> I64 {
    operation: rt_static_text("tcp read")
    if !net_tcp_direction_open(stream, true, operation, error) -> return I64{0}
    if (limit < I64{0}) -> return net_route_fail_take(NET_ERROR_INVALID_INPUT, operation, I64{0}, jet_rt_string_clone(rt_static_text("tcp read limit must be non-negative")), I64{0}, error)
    cap: if (limit < I64{16777216}) -> limit else -> I64{16777216}
    if (cap == I64{0}) {
        net_put(output, I64{0}, if text -> jet_rt_string_clone(rt_static_text("")) else -> I64{1})
        if !text -> net_put(length, I64{0}, I64{0})
        return I64{1}
    }
    if (!text && net_carry_bytes(stream, cap, output, length)) -> return I64{1}
    scratch: jet_rt_alloc(I64{48}, I64{8})
    net_tcp_deadline(stream, true, wrapping(scratch + I64{32}))
    result := I64{0}
    if net_tcp_apply_deadlines(stream, operation, scratch, error) {
        size: net_read_size(stream, cap, text)
        block: net_read_buffer_take(stream, size)
        bytes: wrapping(block + I64{8})
        filled := if text -> net_carry_take(stream, bytes) else -> I64{0}
        result = I64{-1}
        if (filled > I64{0}) -> result = net_read_text_publish(stream, bytes, filled, false, explicit, rt_static_text("tcp read text"), output, error)
        loop result < (I64{0}) {
            want: if (filled < cap) -> cap - filled else -> size - filled
            count: jet_socket_read_raw(jet_socket_stream_fd_raw(stream), wrapping(bytes + filled * RT_HOST_U8_STRIDE), want, scratch)
            if (count >= I64{0}) {
                if text {
                    filled += count
                    result = net_read_text_publish(stream, bytes, filled, count == I64{0}, explicit, rt_static_text("tcp read text"), output, error)
                } else {
                    // The output ABI carries len but no capacity; publish exactly
                    // len slots so its ordinary list destructor has the right layout.
                    net_read_publish_bytes(bytes, count, output, length)
                    result = I64{1}
                }
            } else {
                code: net_word(scratch, I64{8})
                if (code != I64{11}) {
                    _ := net_route_errno(operation, I64{0}, code, error)
                    result = I64{0}
                } else if (net_tcp_wait(jet_socket_stream_fd_raw(stream), I64{1}, operation, scratch, error) == I64{0}) {
                    result = I64{0}
                }
                // A read that fails after the start of a character keeps it.
                if (result == I64{0} && filled > I64{0}) -> net_carry_keep(stream, bytes, I64{0}, filled)
            }
        }
        net_read_buffer_give(stream, block)
    }
    jet_ctx_pop_deadline(wrapping(scratch + I64{32}))
    jet_rt_free(scratch, I64{48}, I64{8})
    result
}

// A text read never drops bytes (#4648). One that stops inside a UTF-8
// character, or at bytes that are not UTF-8, keeps them on the stream as its
// carry: Stream64 word 8 is 0, or a block [count@0][bytes@8 at
// RT_HOST_U8_STRIDE]. The next text read starts with the carry, so a
// character split across segments or by the read limit reads whole, and
// bytes that are not UTF-8 fail each text read without being consumed. A
// byte read returns the carry first, without reading the socket. TCP and
// Unix streams share the holder and these helpers.
net_carry_count: fn(stream: I64) -> I64 {
    mutex: wrapping(stream + I64{48})
    sync_mutex_lock(mutex)
    block: net_word(stream, I64{8})
    count: if (block == I64{0}) -> I64{0} else -> net_word(block, I64{0})
    sync_mutex_unlock(mutex)
    count
}
// Moves the carry into `into`, which has room for it, and clears it.
net_carry_take: fn(stream: I64, into: I64) -> I64 {
    mutex: wrapping(stream + I64{48})
    sync_mutex_lock(mutex)
    block: net_word(stream, I64{8})
    net_put(stream, I64{8}, I64{0})
    sync_mutex_unlock(mutex)
    if (block == I64{0}) -> return I64{0}
    count: net_word(block, I64{0})
    rt_text_bytes_copy(into, wrapping(block + I64{8}), count * RT_HOST_U8_STRIDE)
    jet_rt_free(block, I64{8} + count * RT_HOST_U8_STRIDE, I64{8})
    count
}
// Keeps `count` bytes of `bytes` from index `from` as the carry, which is empty.
net_carry_keep: fn(stream: I64, bytes: I64, from: I64, count: I64) {
    block: jet_rt_alloc(I64{8} + count * RT_HOST_U8_STRIDE, I64{8})
    net_put(block, I64{0}, count)
    rt_text_bytes_copy(wrapping(block + I64{8}), wrapping(bytes + from * RT_HOST_U8_STRIDE), count * RT_HOST_U8_STRIDE)
    mutex: wrapping(stream + I64{48})
    sync_mutex_lock(mutex)
    net_put(stream, I64{8}, block)
    sync_mutex_unlock(mutex)
}
net_carry_drop: fn(stream: I64) {
    block: net_word(stream, I64{8})
    if (block != I64{0}) -> jet_rt_free(block, I64{8} + net_word(block, I64{0}) * RT_HOST_U8_STRIDE, I64{8})
}
// The stream's read buffer (Stream64 word 56, #4666): 0, or a block
// [capacity@0][bytes@8 at RT_HOST_U8_STRIDE] that every read on the stream
// reuses, so a read allocates only the bytes it returns. A read takes the
// block out under the metadata mutex and gives it back after, so two readers
// of one holder never share it. A block wider than NET_READ_BUFFER_KEEP serves
// its one read and is freed, so an idle stream holds at most that many bytes.
NET_READ_BUFFER_KEEP: I64{262144}
net_read_block_free: fn(block: I64) {
    jet_rt_free(block, I64{8} + net_word(block, I64{0}) * RT_HOST_U8_STRIDE, I64{8})
}
// A block with room for `size` bytes: the stream's own when it is wide enough,
// else a new one sized to the next power of two from 4 KiB.
net_read_buffer_take: fn(stream: I64, size: I64) -> I64 {
    mutex: wrapping(stream + I64{48})
    sync_mutex_lock(mutex)
    kept: net_word(stream, I64{56})
    net_put(stream, I64{56}, I64{0})
    sync_mutex_unlock(mutex)
    if (kept != I64{0}) {
        if (net_word(kept, I64{0}) >= size) -> return kept
        net_read_block_free(kept)
    }
    capacity := I64{4096}
    loop capacity < size { capacity = capacity * I64{2} }
    block: jet_rt_alloc(I64{8} + capacity * RT_HOST_U8_STRIDE, I64{8})
    net_put(block, I64{0}, capacity)
    block
}
net_read_buffer_give: fn(stream: I64, block: I64) {
    if (net_word(block, I64{0}) > NET_READ_BUFFER_KEEP) {
        net_read_block_free(block)
        return
    }
    mutex: wrapping(stream + I64{48})
    sync_mutex_lock(mutex)
    kept: net_word(stream, I64{56})
    if (kept == I64{0}) -> net_put(stream, I64{56}, block)
    sync_mutex_unlock(mutex)
    if (kept != I64{0}) -> net_read_block_free(block)
}
net_read_buffer_drop: fn(stream: I64) {
    block: net_word(stream, I64{56})
    if (block != I64{0}) -> net_read_block_free(block)
}
// A byte read's list: exactly `count` slots copied out of the read buffer.
net_read_publish_bytes: fn(bytes: I64, count: I64, output: I64, length: I64) {
    owned: if (count == I64{0}) -> I64{1} else -> jet_rt_alloc(count * RT_HOST_U8_STRIDE, I64{8})
    if (count != I64{0}) -> rt_text_bytes_copy(owned, bytes, count * RT_HOST_U8_STRIDE)
    net_put(output, I64{0}, owned)
    net_put(length, I64{0}, count)
}
// A byte read's carry: at most `cap` of its bytes, the rest kept. False when
// there is no carry and the read goes to the socket.
net_carry_bytes: fn(stream: I64, cap: I64, output: I64, length: I64) -> Bool {
    carried: net_carry_count(stream)
    if (carried == I64{0}) -> return false
    bytes: jet_rt_alloc(carried * RT_HOST_U8_STRIDE, I64{8})
    _ := net_carry_take(stream, bytes)
    count: if (carried < cap) -> carried else -> cap
    owned := bytes
    if (count < carried) {
        net_carry_keep(stream, bytes, count, carried - count)
        owned = jet_rt_alloc(count * RT_HOST_U8_STRIDE, I64{8})
        rt_text_bytes_copy(owned, bytes, count * RT_HOST_U8_STRIDE)
        jet_rt_free(bytes, carried * RT_HOST_U8_STRIDE, I64{8})
    }
    net_put(output, I64{0}, owned)
    net_put(length, I64{0}, count)
    true
}
// The read size: `cap` bytes for a byte read. A text read also holds its
// carry, and at least one whole character, so a limit under a character's
// width returns that character.
net_read_size: fn(stream: I64, cap: I64, text: Bool) -> I64 {
    if !text -> return cap
    carried: net_carry_count(stream)
    size := if (cap < carried) -> carried else -> cap
    if (size < I64{4}) -> size = I64{4}
    size
}
// Publishes the longest UTF-8 prefix of `count` bytes (the carry first) as
// the read's text and keeps the rest as the carry. Returns 1; 0 on an
// error, the bytes kept; or -1 when they are only the start of one
// character and the stream has not `ended`, so the caller reads more.
// operation is "tcp read text" or "unix read text"; both name it in the message.
net_read_text_publish: fn(stream: I64, bytes: I64, count: I64, ended: Bool, explicit: Bool, operation: I64, output: I64, error: I64) -> I64 {
    valid := I64{0}
    width := I64{0}
    loop valid < count {
        width = rt_text_valid_width(wrapping(bytes + valid * RT_HOST_U8_STRIDE), count - valid, RT_HOST_U8_STRIDE)
        if (width < I64{0}) -> break
        valid += width
    }
    if (valid == I64{0} && count > I64{0}) {
        lead: host_u8_get(bytes, I64{0})
        expected: if (lead >= I64{194} && lead <= I64{223}) -> I64{2} else if (lead >= I64{224} && lead <= I64{239}) -> I64{3} else if (lead >= I64{240} && lead <= I64{244}) -> I64{4} else -> I64{1}
        incomplete: expected > I64{1} && -width == count
        if (incomplete && !ended) -> return I64{-1}
        net_carry_keep(stream, bytes, I64{0}, count)
        message: jet_rt_string_builder_new()
        jet_rt_string_builder_push(message, operation)
        jet_rt_string_builder_push(message, if explicit -> rt_static_text(" failed: ") else -> rt_static_text(" failed: invalid UTF-8: "))
        if incomplete {
            jet_rt_string_builder_push(message, rt_static_text("incomplete utf-8 byte sequence from index 0"))
        } else {
            jet_rt_string_builder_push(message, rt_static_text("invalid utf-8 sequence of "))
            rt_text_push_number(message, -width)
            jet_rt_string_builder_push(message, rt_static_text(" bytes from index 0"))
        }
        return net_route_fail_take(NET_ERROR_INVALID_INPUT, operation, I64{0}, jet_rt_string_builder_finish(message), I64{0}, error)
    }
    if (valid < count) -> net_carry_keep(stream, bytes, valid, count - valid)
    builder: jet_rt_string_builder_new()
    if (RT_HOST_U8_STRIDE == I64{1}) {
        rt_text_append(builder, bytes, valid)
    } else {
        at := I64{0}
        loop at < valid {
            rt_text_append(builder, bytes + at * RT_HOST_U8_STRIDE, I64{1})
            at += I64{1}
        }
    }
    net_put(output, I64{0}, jet_rt_string_builder_finish(builder))
    I64{1}
}
#Export(c) jet_net_tcp_read_bytes: fn(stream: I64, limit: I64, output: I64, length: I64, error: I64) -> I64 { net_tcp_read_result(stream, limit, output, length, false, false, error) }
#Export(c) jet_net_tcp_read_text: fn(stream: I64, limit: I64, output: I64, error: I64) -> I64 { net_tcp_read_result(stream, limit, output, I64{0}, true, false, error) }
#Export(c) jet_net_tcp_read: fn(stream: I64, output: I64, error: I64) -> I64 { jet_net_tcp_read_text(stream, I64{8192}, output, error) }
net_tcp_read_deadline: fn(stream: I64, limit: I64, milliseconds: I64, output: I64, length: I64, text: Bool, error: I64) -> I64 {
    if (jet_scheduler_native_propagate() != I64{0}) -> return I64{0}
    if !net_tcp_timeout_valid(milliseconds, rt_static_text("tcp read"), error) -> return I64{0}
    save: jet_rt_alloc(I64{16}, I64{8})
    net_route_deadline_push(milliseconds, save)
    result: net_tcp_read_result(stream, limit, output, length, text, true, error)
    jet_ctx_pop_deadline(save)
    jet_rt_free(save, I64{16}, I64{8})
    result
}
#Export(c) jet_net_tcp_read_bytes_deadline: fn(stream: I64, limit: I64, deadline: I64, output: I64, length: I64, error: I64) -> I64 { net_tcp_read_deadline(stream, limit, net_deadline_millis(deadline), output, length, false, error) }
#Export(c) jet_net_tcp_read_text_deadline: fn(stream: I64, limit: I64, deadline: I64, output: I64, error: I64) -> I64 { net_tcp_read_deadline(stream, limit, net_deadline_millis(deadline), output, I64{0}, true, error) }
// `read_into` (#5976): one read of at most `limit` bytes appended to the
// caller's List<U8> at `header` [len@0][capacity@8][data@16]; the count is
// the output, 0 at end of stream, and a limit below 1 is invalid input. A
// List without room for the read and its scratch grows
// (rt_host_u8_list_room), so a caller that clears and reuses its List reads
// without allocating: the bytes go straight into its buffer, and the scratch
// words sit in its spare room. A carry a text read left is appended first,
// without reading the socket.
// `milliseconds` is an explicit deadline, or -1 for the stream's own.
// TCP and Unix streams share it; Unix also retries an interrupted read.
NET_READ_INTO_SCRATCH: I64{72}
net_read_into: fn(stream: I64, header: I64, word: I64, milliseconds: I64, tcp: Bool, output: I64, error: I64) -> I64 {
    operation: if tcp -> rt_static_text("tcp read") else -> rt_static_text("unix read")
    limit: host_native_int(word)
    if (jet_scheduler_native_propagate() != I64{0}) -> return I64{0}
    if !net_tcp_direction_open(stream, true, operation, error) -> return I64{0}
    if (limit <= I64{0}) {
        message: if tcp -> rt_static_text("tcp read_into limit must be positive") else -> rt_static_text("unix read_into limit must be positive")
        return net_route_fail_take(NET_ERROR_INVALID_INPUT, operation, I64{0}, jet_rt_string_clone(message), I64{0}, error)
    }
    cap: if (limit < I64{16777216}) -> limit else -> I64{16777216}
    carried: net_carry_count(stream)
    if (carried > I64{0}) {
        rt_host_u8_list_room(header, carried)
        held: net_word(header, I64{0})
        end: wrapping(net_word(header, I64{16}) + held * RT_HOST_U8_STRIDE)
        _ := net_carry_take(stream, end)
        taken: if (carried < cap) -> carried else -> cap
        if (taken < carried) -> net_carry_keep(stream, end, taken, carried - taken)
        net_put(header, I64{0}, held + taken)
        net_put(output, I64{0}, taken)
        return I64{1}
    }
    // The read's 64 scratch bytes (errno words, the stream's deadline save at
    // 32 and an explicit deadline's at 48) sit word-aligned in the List's spare
    // room past the `cap` bytes the read may fill: no block is taken, and a
    // reused List keeps the room, so the steady loop allocates nothing.
    rt_host_u8_list_room(header, cap + NET_READ_INTO_SCRATCH)
    held: net_word(header, I64{0})
    past: wrapping(net_word(header, I64{16}) + (held + cap) * RT_HOST_U8_STRIDE)
    scratch: wrapping(past + I64{7}).bit_and(I64{-8})
    save: wrapping(scratch + I64{48})
    if (milliseconds >= I64{0}) -> net_route_deadline_push(milliseconds, save)
    net_tcp_deadline(stream, true, wrapping(scratch + I64{32}))
    result := I64{0}
    if (!tcp || net_tcp_apply_deadlines(stream, operation, scratch, error)) {
        length: net_word(header, I64{0})
        into: wrapping(net_word(header, I64{16}) + length * RT_HOST_U8_STRIDE)
        result = I64{-1}
        loop result < (I64{0}) {
            count: jet_socket_read_raw(jet_socket_stream_fd_raw(stream), into, cap, scratch)
            if (count >= I64{0}) {
                net_put(header, I64{0}, length + count)
                net_put(output, I64{0}, count)
                result = I64{1}
            } else {
                code: net_word(scratch, I64{8})
                if (code != I64{11} && (tcp || code != I64{4})) {
                    _ := net_route_errno(operation, I64{0}, code, error)
                    result = I64{0}
                } else if (net_tcp_wait(jet_socket_stream_fd_raw(stream), I64{1}, operation, scratch, error) == I64{0}) {
                    result = I64{0}
                }
            }
        }
    }
    jet_ctx_pop_deadline(wrapping(scratch + I64{32}))
    if (milliseconds >= I64{0}) -> jet_ctx_pop_deadline(save)
    result
}
net_read_into_deadline: fn(stream: I64, header: I64, word: I64, deadline: I64, tcp: Bool, output: I64, error: I64) -> I64 {
    milliseconds: net_deadline_millis(deadline)
    if (jet_scheduler_native_propagate() != I64{0}) -> return I64{0}
    if !net_tcp_timeout_valid(milliseconds, if tcp -> rt_static_text("tcp read") else -> rt_static_text("unix read"), error) -> return I64{0}
    net_read_into(stream, header, word, milliseconds, tcp, output, error)
}
#Export(c) jet_net_tcp_read_into: fn(stream: I64, header: I64, limit: I64, output: I64, error: I64) -> I64 { net_read_into(stream, header, limit, I64{-1}, true, output, error) }
#Export(c) jet_net_tcp_read_into_deadline: fn(stream: I64, header: I64, limit: I64, deadline: I64, output: I64, error: I64) -> I64 { net_read_into_deadline(stream, header, limit, deadline, true, output, error) }
net_tcp_write_current: fn(stream: I64, data: I64, length: I64, scratch: I64, error: I64) -> I64 {
    operation: rt_static_text("tcp write")
    if !net_tcp_direction_open(stream, false, operation, error) -> return I64{-1}
    if !net_tcp_apply_deadlines(stream, operation, scratch, error) -> return I64{-1}
    loop {
        count: jet_socket_write_raw(jet_socket_stream_fd_raw(stream), data, length, scratch)
        if (count >= I64{0}) -> return count
        code: net_word(scratch, I64{8})
        if (code != I64{11}) {
            _ := net_route_errno(operation, I64{0}, code, error)
            return I64{-1}
        }
        if (net_tcp_wait(jet_socket_stream_fd_raw(stream), I64{4}, operation, scratch, error) == I64{0}) -> return I64{-1}
    }
}
net_tcp_write_result: fn(stream: I64, data: I64, length: I64, all: Bool, output: I64, error: I64) -> I64 {
    if (all && length == I64{0}) -> return I64{1}
    scratch: jet_rt_alloc(I64{48}, I64{8})
    net_tcp_deadline(stream, false, wrapping(scratch + I64{32}))
    result := I64{1}
    offset := I64{0}
    loop !all || offset < length {
        count: net_tcp_write_current(stream, wrapping(data + offset * RT_HOST_U8_STRIDE), length - offset, scratch, error)
        if (count < I64{0}) {
            result = I64{0}
            break
        }
        if (!all) {
            net_put(output, I64{0}, count)
            break
        }
        if (count == I64{0}) {
            result = net_route_fail_take(NET_ERROR_CONNECTION_RESET, rt_static_text("tcp write all"), I64{0}, jet_rt_string_clone(rt_static_text("tcp write all failed: zero bytes written")), I64{0}, error)
            break
        }
        offset += count
    }
    jet_ctx_pop_deadline(wrapping(scratch + I64{32}))
    jet_rt_free(scratch, I64{48}, I64{8})
    result
}
#Export(c) jet_net_tcp_write_bytes: fn(stream: I64, data: I64, length: I64, output: I64, error: I64) -> I64 { net_tcp_write_result(stream, data, length, false, output, error) }
#Export(c) jet_net_tcp_write_all_bytes: fn(stream: I64, data: I64, length: I64, error: I64) -> I64 { net_tcp_write_result(stream, data, length, true, I64{0}, error) }
net_tcp_write_deadline: fn(stream: I64, data: I64, length: I64, milliseconds: I64, all: Bool, output: I64, error: I64) -> I64 {
    if (jet_scheduler_native_propagate() != I64{0}) -> return I64{0}
    if !net_tcp_timeout_valid(milliseconds, if all -> rt_static_text("tcp write all") else -> rt_static_text("tcp write"), error) -> return I64{0}
    save: jet_rt_alloc(I64{16}, I64{8})
    net_route_deadline_push(milliseconds, save)
    result: net_tcp_write_result(stream, data, length, all, output, error)
    jet_ctx_pop_deadline(save)
    jet_rt_free(save, I64{16}, I64{8})
    result
}
#Export(c) jet_net_tcp_write_bytes_deadline: fn(stream: I64, data: I64, length: I64, deadline: I64, output: I64, error: I64) -> I64 { net_tcp_write_deadline(stream, data, length, net_deadline_millis(deadline), false, output, error) }
#Export(c) jet_net_tcp_write_all_bytes_deadline: fn(stream: I64, data: I64, length: I64, deadline: I64, error: I64) -> I64 { net_tcp_write_deadline(stream, data, length, net_deadline_millis(deadline), true, I64{0}, error) }
net_tcp_write_text_result: fn(stream: I64, text: I64, explicit: Bool, milliseconds: I64, error: I64) -> I64 {
    if (explicit && jet_scheduler_native_propagate() != I64{0}) -> return I64{0}
    length: rt_text_len(text)
    bytes: if (RT_HOST_U8_STRIDE == I64{1} || length == I64{0}) -> rt_text_data(text) else -> jet_rt_alloc(length * RT_HOST_U8_STRIDE, I64{8})
    if (RT_HOST_U8_STRIDE != I64{1} && length != I64{0}) {
        at := I64{0}
        loop at < length {
            host_u8_put(bytes, at, rt_text_byte(wrapping(rt_text_data(text) + at)))
            at += I64{1}
        }
    }
    result: if explicit -> net_tcp_write_deadline(stream, bytes, length, milliseconds, true, I64{0}, error) else -> jet_net_tcp_write_all_bytes(stream, bytes, length, error)
    if (RT_HOST_U8_STRIDE != I64{1} && length != I64{0}) -> jet_rt_free(bytes, length * RT_HOST_U8_STRIDE, I64{8})
    result
}
#Export(c) jet_net_tcp_write_text: fn(stream: I64, text: I64, error: I64) -> I64 { net_tcp_write_text_result(stream, text, false, I64{0}, error) }
#Export(c) jet_net_tcp_write_text_deadline: fn(stream: I64, text: I64, deadline: I64, error: I64) -> I64 { net_tcp_write_text_result(stream, text, true, net_deadline_millis(deadline), error) }
#Export(c) jet_net_tcp_write: fn(stream: I64, text: I64, error: I64) -> I64 { jet_net_tcp_write_text(stream, text, error) }
// TCP and Unix streams share Stream64, so shutdown/ready/accept-deadline take
// the reference operation name ("tcp shutdown"/"unix shutdown", ...).
net_stream_shutdown: fn(stream: I64, how: I64, operation: I64, error: I64) -> I64 {
    if (how < I64{0} || how > I64{2}) {
        host_record_index_refused()
        return I64{0}
    }
    if !net_route_stream_open(stream, operation, error) -> return I64{0}
    scratch: jet_rt_alloc(I64{32}, I64{8})
    result: jet_socket_shutdown_raw(jet_socket_stream_fd_raw(stream), how, scratch)
    code: net_word(scratch, I64{8})
    jet_rt_free(scratch, I64{32}, I64{8})
    if (result < I64{0}) -> return net_route_errno(operation, I64{0}, code, error)
    jet_socket_stream_mark_shutdown_raw(stream, how)
    I64{1}
}
#Export(c) jet_net_tcp_shutdown: fn(stream: I64, how: I64, error: I64) -> I64 { net_stream_shutdown(stream, how, rt_static_text("tcp shutdown"), error) }
#Export(c) jet_net_tcp_close: fn(stream: I64, error: I64) -> I64 {
    if (jet_socket_stream_flags_raw(stream).bit_and(I64{1}) != I64{0}) -> return I64{1}
    scratch: jet_rt_alloc(I64{32}, I64{8})
    result: jet_socket_shutdown_raw(jet_socket_stream_fd_raw(stream), I64{2}, scratch)
    code: net_word(scratch, I64{8})
    jet_rt_free(scratch, I64{32}, I64{8})
    if (result < I64{0} && code != I64{107}) -> return net_route_errno(rt_static_text("tcp close"), I64{0}, code, error)
    jet_socket_stream_mark_closed_raw(stream)
    I64{1}
}
net_stream_ready: fn(stream: I64, interest: I64, deadline: I64, operation: I64, output: I64, error: I64) -> I64 {
    milliseconds: net_deadline_millis(deadline)
    if (jet_scheduler_native_propagate() != I64{0}) -> return I64{0}
    if (interest < I64{0} || interest > I64{2}) {
        host_record_index_refused()
        return I64{0}
    }
    if !net_route_stream_open(stream, operation, error) -> return I64{0}
    if !net_tcp_timeout_valid(milliseconds, operation, error) -> return I64{0}
    scratch: jet_rt_alloc(I64{48}, I64{8})
    net_route_deadline_push(milliseconds, wrapping(scratch + I64{32}))
    mask: if (interest == I64{0}) -> I64{1} else if (interest == I64{1}) -> I64{4} else -> I64{5}
    ready: net_tcp_wait(jet_socket_stream_fd_raw(stream), mask, operation, scratch, error)
    jet_ctx_pop_deadline(wrapping(scratch + I64{32}))
    jet_rt_free(scratch, I64{48}, I64{8})
    if (ready == I64{0}) -> return I64{0}
    value: jet_rt_alloc(I64{16}, I64{8})
    net_put(value, I64{0}, if (ready.bit_and(I64{1}) != I64{0}) -> I64{1} else -> I64{0})
    net_put(value, I64{8}, if (ready.bit_and(I64{4}) != I64{0}) -> I64{1} else -> I64{0})
    net_put(output, I64{0}, value)
    I64{1}
}
#Export(c) jet_net_tcp_ready_deadline: fn(stream: I64, interest: I64, deadline: I64, output: I64, error: I64) -> I64 { net_stream_ready(stream, interest, deadline, rt_static_text("tcp ready"), output, error) }
net_listener_accept_deadline: fn(listener: I64, deadline: I64, operation: I64, output: I64, error: I64) -> I64 {
    milliseconds: net_deadline_millis(deadline)
    if (jet_scheduler_native_propagate() != I64{0}) -> return I64{0}
    if !net_tcp_timeout_valid(milliseconds, operation, error) -> return I64{0}
    save: jet_rt_alloc(I64{16}, I64{8})
    net_route_deadline_push(milliseconds, save)
    result: net_route_accept(listener, operation, output, error)
    jet_ctx_pop_deadline(save)
    jet_rt_free(save, I64{16}, I64{8})
    result
}
#Export(c) jet_net_tcp_accept_deadline: fn(listener: I64, deadline: I64, output: I64, error: I64) -> I64 { net_listener_accept_deadline(listener, deadline, rt_static_text("tcp accept"), output, error) }
net_tcp_address_text: fn(holder: I64, listener: Bool, peer: Bool, output: I64, error: I64) -> I64 {
    slot: jet_rt_alloc(I64{8}, I64{8})
    result: net_route_socket_address(holder, listener, peer, slot, error)
    if (result != I64{0}) {
        address: net_word(slot, I64{0})
        net_put(output, I64{0}, net_route_socket_text(address))
        jet_rt_free(address, I64{56}, I64{8})
    }
    jet_rt_free(slot, I64{8}, I64{8})
    result
}
#Export(c) jet_net_tcp_local_addr: fn(stream: I64, output: I64, error: I64) -> I64 { net_tcp_address_text(stream, false, false, output, error) }
#Export(c) jet_net_tcp_peer_addr: fn(stream: I64, output: I64, error: I64) -> I64 { net_tcp_address_text(stream, false, true, output, error) }
// core.net.__tcp_fd: the borrowed stream's nonblocking OS socket descriptor
// (FD72 word 8), or -1 once the stream is closed, for core.http's upgrade
// cell (Core/Http/Server.jet). The TCPStream keeps owning the descriptor.
#Export(c) jet_net_tcp_fd: fn(stream: I64) -> I64 {
    state: jet_socket_stream_fd_raw(stream)
    fd_lock(state)
    fd: if (fd_word(state, I64{16}) == I64{0}) -> fd_word(state, I64{8}) else -> I64{-1}
    fd_unlock(state)
    jet_int_owned_from_i64(fd)
}
#Export(c) jet_net_listener_local_addr: fn(listener: I64, output: I64, error: I64) -> I64 { net_tcp_address_text(listener, true, false, output, error) }
net_tcp_show: fn(holder: I64, listener: Bool) -> I64 {
    scratch: jet_rt_alloc(I64{16}, I64{8})
    thread_zero(scratch, I64{16})
    builder: jet_rt_string_builder_new()
    jet_rt_string_builder_push(builder, if listener -> rt_static_text("TcpListener(") else -> rt_static_text("TcpStream("))
    if (net_tcp_address_text(holder, listener, !listener, scratch, wrapping(scratch + I64{8})) != I64{0}) {
        address: net_word(scratch, I64{0})
        jet_rt_string_builder_push(builder, address)
        jet_rt_string_drop(address)
    } else {
        failure: net_word(scratch, I64{8})
        jet_rt_string_builder_push(builder, if listener -> rt_static_text("address unavailable: ") else -> rt_static_text("peer unavailable: "))
        host_errno_cause_append(builder, net_word(net_word(failure, NET_ERROR_PAYLOAD), NET_DETAIL_OS_CODE))
        jet_rt_handle_drop_jet_net_error(failure)
    }
    jet_rt_string_builder_push(builder, rt_static_text(")"))
    jet_rt_free(scratch, I64{16}, I64{8})
    jet_rt_string_builder_finish(builder)
}
#Export(c) jet_rt_handle_show_jet_tcp_stream: fn(stream: I64) -> I64 { net_tcp_show(stream, false) }
#Export(c) jet_rt_handle_show_jet_tcp_listener: fn(listener: I64) -> I64 { net_tcp_show(listener, true) }
#Export(c) jet_rt_handle_clone_jet_tcp_listener: fn(listener: I64) -> I64 {
    scratch: jet_rt_alloc(I64{32}, I64{8})
    cloned: jet_tcp_listener_clone_raw(listener, scratch)
    if (cloned == I64{0}) {
        message: jet_rt_string_builder_new()
        jet_rt_string_builder_push(message, rt_static_text("TcpListener try_clone for spawn capture: "))
        host_errno_cause_append(message, net_word(scratch, I64{8}))
        text: jet_rt_string_builder_finish(message)
        jet_rt_panic_message(rt_text_data(text), rt_text_len(text))
        jet_rt_string_drop(text)
    }
    jet_rt_free(scratch, I64{32}, I64{8})
    cloned
}
#Export(c) jet_net_sendfile: fn(stream: I64, path: I64, output: I64, error: I64) -> I64 {
    if !net_tcp_direction_open(stream, false, rt_static_text("tcp sendfile"), error) -> return I64{0}
    scratch: jet_rt_alloc(I64{48}, I64{8})
    file: jet_fd_open_raw(path, I64{1}, I64{0}, scratch)
    if (file == I64{0}) {
        result: if (jet_scheduler_native_propagate() == I64{0}) -> net_route_errno(rt_static_text("tcp sendfile open"), path, net_word(scratch, I64{8}), error) else -> I64{0}
        jet_rt_free(scratch, I64{48}, I64{8})
        return result
    }
    net_tcp_deadline(stream, false, wrapping(scratch + I64{32}))
    bytes: jet_rt_alloc(I64{8192} * RT_HOST_U8_STRIDE, I64{8})
    written := I64{0}
    result := I64{1}
    loop {
        count: jet_fd_read_raw(file, bytes, I64{8192}, scratch)
        if (count < I64{0}) {
            result = net_route_errno(rt_static_text("tcp sendfile read"), path, net_word(scratch, I64{8}), error)
            break
        }
        if (count == I64{0}) -> break
        // File reads initialize compact bytes; expand backwards only in the
        // word-stride epoch, retaining the single reusable transfer buffer.
        if (RT_HOST_U8_STRIDE != I64{1}) {
            at := count
            loop at > (I64{0}) {
                at -= I64{1}
                host_u8_put(bytes, at, rt_text_byte(wrapping(bytes + at)))
            }
        }
        if (jet_net_tcp_write_all_bytes(stream, bytes, count, error) == I64{0}) {
            result = I64{0}
            break
        }
        written = if (written > I64{9223372036854775807} - count) -> I64{9223372036854775807} else -> written + count
    }
    jet_rt_free(bytes, I64{8192} * RT_HOST_U8_STRIDE, I64{8})
    jet_ctx_pop_deadline(wrapping(scratch + I64{32}))
    jet_fd_drop_raw(file)
    jet_rt_free(scratch, I64{48}, I64{8})
    if (result != I64{0}) -> net_put(output, I64{0}, written)
    result
}
