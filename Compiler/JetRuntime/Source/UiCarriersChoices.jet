// Ui4 unit choices only: Ui.rs:38-43/2468-2477, WebForms.rs:1116-1120.
// Canonical EncodingABI8 owned enum handles (e1306aee0), no new enum layout.
#Export(c) fn jet_rt_handle_clone_jet_ui_aria_role(value: I64) -> I64 { encoding_enum_clone(value) }
#Export(c) fn jet_rt_handle_drop_jet_ui_aria_role(value: I64) { encoding_enum_drop(value) }
#Export(c) fn jet_rt_handle_eq_jet_ui_aria_role(a: I64, b: I64) -> Bool { encoding_enum_eq(a, b) }
#Export(c) fn jet_rt_handle_show_jet_ui_aria_role(value: I64) -> I64 {
    ordinal :: ui_carrier_word(value)
    if (ordinal < I64{0} || ordinal >= I64{4}) -> rt_record_variant_panic()
    target :: jet_rt_string_builder_new()
    if {
        (ordinal == I64{0}) -> rt_text_push_word(target, I64{121424974214466}, I64{6}) // Button
        (ordinal == I64{1}) -> {
            rt_text_push_word(target, I64{8462384961594877268}, I64{8}) // TextInpu
            rt_text_push_word(target, I64{116}, I64{1})
        }
        (ordinal == I64{2}) -> rt_text_push_word(target, I64{465557414220}, I64{5}) // Label
        else -> {
            rt_text_push_word(target, I64{7308895112555032387}, I64{8}) // Containe
            rt_text_push_word(target, I64{114}, I64{1})
        }
    }
    jet_rt_string_builder_finish(target)
}
#Export(c) fn jet_rt_handle_clone_jet_web_form_validation_timing(value: I64) -> I64 { encoding_enum_clone(value) }
#Export(c) fn jet_rt_handle_drop_jet_web_form_validation_timing(value: I64) { encoding_enum_drop(value) }
#Export(c) fn jet_rt_handle_eq_jet_web_form_validation_timing(a: I64, b: I64) -> Bool { encoding_enum_eq(a, b) }
