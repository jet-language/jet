// Plain ProcessSpec collector/lifecycle on the existing Child104 syscall seam.
// ExecutionChild160 and launch/receipt metadata are owned by ProcessExecutionRoutes.
// stop120 bits: requested=1, closed=2, explicit wait=4, group swept=8.
process_execution_flags_add: fn(child: I64, flag: I64) {
    loop {
        before: sync_load(wrapping(child + I64{120}))
        if (sync_cas(wrapping(child + I64{120}), before, before.bit_or(flag)) == before) -> return
    }
}
process_execution_first_error: fn(child: I64, operation: I64, path: I64, cause: I64) {
    sync_mutex_lock(child)
    if (fd_word(child, I64{56}) == I64{0}) {
        _ := host_io_other_take(operation, process_optional_text_clone(path), cause, wrapping(child + I64{56}))
    } else { jet_rt_string_drop(cause) }
    sync_mutex_unlock(child)
}
process_execution_sweep: fn(child: I64) {
    result: host_call(I64{62}, -fd_word(process_execution_native(child), I64{8}), I64{9}, I64{0})
    if (result < I64{0} && result != I64{-3}) -> process_execution_first_error(child, HOST_IO_OP_CLOSE, rt_static_text("process"), host_errno_cause(-result))
    process_execution_flags_add(child, I64{8})
}
process_execution_reap_stopped: fn(child: I64) {
    scratch: jet_rt_alloc(I64{40}, I64{8})
    result: jet_process_wait_raw(process_execution_native(child), false, scratch, wrapping(scratch + I64{8}))
    if (result < I64{0}) -> process_execution_first_error(child, HOST_IO_OP_CLOSE, rt_static_text("process"), host_errno_cause(fd_word(scratch, I64{16})))
    jet_rt_free(scratch, I64{40}, I64{8})
}
process_execution_await_cleanup: fn(child: I64) {
    loop sync_load(wrapping(child + I64{40})) == (I64{0}) {
        _ := sync_wait(child + I64{40}, I64{0}, sync_deadline(I64{1000000}))
    }
}
process_execution_stop: fn(child: I64) {
    process_execution_flags_add(child, I64{1})
    // Cleanup runs even after scheduler stop delivery, without re-entering the
    // public authority/cancellation boundary.
    process_execution_sweep(child)
}
process_execution_release: fn(child: I64) {
    if (sync_add(wrapping(child + I64{8}), I64{-1}) != I64{1}) -> return
    jet_process_drop_raw(process_execution_native(child))
    jet_rt_handle_drop_process_spec(fd_word(child, I64{24}))
    jet_rt_handle_drop_process_receipt(fd_word(child, I64{48}))
    jet_rt_handle_drop_io_error(fd_word(child, I64{56}))
    jet_rt_string_drop(fd_word(child, I64{80}))
    jet_rt_string_drop(fd_word(child, I64{88}))
    pipe_drop(fd_word(child, PROCESS_EXECUTION_STDOUT))
    pipe_drop(fd_word(child, PROCESS_EXECUTION_STDERR))
    jet_rt_free(child, PROCESS_EXECUTION_BYTES, I64{8})
}
#Export(c) jet_rt_handle_clone_process_child: fn(child: I64) -> I64 {
    _ := sync_add(wrapping(child + I64{8}), I64{1})
    child
}
#Export(c) jet_rt_handle_eq_process_child: fn(a: I64, b: I64) -> Bool { a == b }
#Export(c) jet_rt_handle_drop_process_child: fn(child: I64) {
    if (child == I64{0}) -> return
    sync_mutex_lock(child)
    worker: fd_word(child, I64{32}) != I64{0}
    last: fd_word(child, I64{8}) == (if worker -> I64{2} else -> I64{1})
    detached: fd_word(fd_word(child, I64{24}), PROCESS_SPEC_DETACHED).bit_and(I64{255}) != I64{0}
    unfinished: sync_load(wrapping(child + I64{40})) == I64{0}
    sync_mutex_unlock(child)
    // Never hold the child mutex while joining: the collector publishes its
    // receipt under that lock before releasing its independent reference.
    if (last && !detached && unfinished) {
        process_execution_stop(child)
        if worker -> process_execution_await_cleanup(child) else -> process_execution_reap_stopped(child)
    }
    process_execution_release(child)
}
process_execution_collect_start: fn(child: I64, err: I64) -> Bool {
    sync_mutex_lock(child)
    if (fd_word(child, I64{32}) != I64{0}) {
        sync_mutex_unlock(child)
        return true
    }
    _ := sync_add(wrapping(child + I64{8}), I64{1})
    fd_put(child, I64{32}, I64{1})
    handle: thread_spawn(rt_process_execution_worker_address(), child)
    if (handle < I64{0}) {
        fd_put(child, I64{32}, I64{0})
        sync_mutex_unlock(child)
        process_execution_stop(child)
        process_execution_reap_stopped(child)
        process_execution_release(child)
        _ := process_execution_error(fd_word(child, I64{24}), HOST_IO_OP_RESOLVE, host_errno_cause(-handle), err)
        return false
    }
    _ := thread_detach(handle)
    sync_mutex_unlock(child)
    true
}
// Closes the captured streams the collector still reads: a run past its
// timeout stops waiting for an EOF a lingering descendant would never send.
process_execution_drain_stop: fn(native: I64) {
    sync_mutex_lock(native)
    stream := I64{1}
    loop stream <= (I64{2}) {
        offset: spawn_stream_offset(native, stream)
        spawn_close(fd_word(native, offset))
        fd_put(native, offset, I64{-1})
        stream += I64{1}
    }
    sync_mutex_unlock(native)
}
process_execution_capture: fn(child: I64, native: I64, stream: I64, scratch: I64) -> Bool {
    offset: spawn_stream_offset(native, stream)
    number: fd_word(native, offset)
    if (number < I64{0}) -> return true
    spec: fd_word(child, I64{24})
    limit: fd_word(spec, PROCESS_SPEC_OUTPUT_LIMIT)
    loop {
        count: host_call(I64{0}, number, scratch, I64{8192})
        if (count == I64{-4}) -> next
        if (count == I64{-11}) -> return false
        if (count < I64{0} && !(offset == I64{56} && count == I64{-5})) {
            process_execution_first_error(child, HOST_IO_OP_READ, if (stream == I64{1}) -> rt_static_text("process stdout") else -> rt_static_text("process stderr"), host_errno_cause(-count))
            process_execution_stop(child)
        }
        // A terminal master reads EIO once the child closes its last slave
        // descriptor, which it may do before it exits (cat closes stdout in its
        // exit handler). Closing the master then hangs up the terminal and
        // SIGHUPs a child that has not exited yet, so the master stays open
        // until the collector has reaped the child.
        if (offset == I64{56} && count == I64{-5}) -> return true
        if (count <= I64{0}) {
            sync_mutex_lock(native)
            spawn_close(fd_word(native, offset))
            fd_put(native, offset, I64{-1})
            sync_mutex_unlock(native)
            return true
        }
        kept := count
        if (limit != I64{0}) {
            maximum: fd_word(limit, I64{0})
            remaining: maximum - fd_word(child, I64{96})
            if (kept > remaining) { kept = if (remaining < I64{0}) -> I64{0} else -> remaining }
            if (kept != count) {
                fd_put(child, I64{112}, I64{1})
                process_execution_stop(child)
            }
        }
        sync_mutex_lock(child)
        rt_text_append(fd_word(child, if (stream == I64{1}) -> I64{80} else -> I64{88}), scratch, kept)
        fd_put(child, I64{96}, fd_word(child, I64{96}) + kept)
        sync_mutex_unlock(child)
        return false
    }
}
#Export(c) jet_rt_process_execution_worker: fn(child: I64) -> I64 {
    native: process_execution_native(child)
    spec: fd_word(child, I64{24})
    scratch: jet_rt_alloc(I64{8280}, I64{8})
    stream := I64{1}
    loop stream <= (I64{2}) {
        number: fd_word(native, spawn_stream_offset(native, stream))
        if (number >= I64{0}) {
            flags: host_call(I64{72}, number, I64{3}, I64{0})
            result: if (flags < I64{0}) -> flags else -> host_call(I64{72}, number, I64{4}, flags.bit_or(I64{2048}))
            if (result < I64{0}) {
                process_execution_first_error(child, HOST_IO_OP_READ, if (stream == I64{1}) -> rt_static_text("process stdout") else -> rt_static_text("process stderr"), host_errno_cause(-result))
                process_execution_stop(child)
                // Do not enter a blocking read after nonblocking setup failed.
                sync_mutex_lock(native)
                offset: spawn_stream_offset(native, stream)
                spawn_close(fd_word(native, offset))
                fd_put(native, offset, I64{-1})
                sync_mutex_unlock(native)
            }
        }
        stream += I64{1}
    }
    // The child's exit wakes the idle collector through its pidfd (Linux
    // 5.3+); without one the collector polls the exit every millisecond.
    pidfd: host_call(I64{434}, fd_word(native, I64{8}), I64{0}, I64{0})
    exited := false
    output_done := false
    errors_done := false
    status := I64{0}
    resource_limit := I64{-1}
    loop {
        if !output_done -> output_done = process_execution_capture(child, native, I64{1}, scratch)
        if !errors_done -> errors_done = process_execution_capture(child, native, I64{2}, scratch)
        if !exited {
            if (resource_limit < I64{0}) {
                resource_limit = process_execution_live_limit(child, scratch)
                if (resource_limit >= I64{0}) -> process_execution_stop(child)
            }
            result: jet_process_wait_raw(native, true, wrapping(scratch + I64{8192}), wrapping(scratch + I64{8200}))
            if (result > I64{0}) {
                status = fd_word(scratch, I64{8192})
                exited = true
            }
            if (result < I64{0}) {
                process_execution_first_error(child, HOST_IO_OP_CLOSE, rt_static_text("process"), host_errno_cause(fd_word(scratch, I64{8208})))
                process_execution_stop(child)
                exited = true
            }
        }
        // The timeout bounds the whole run, output included: a descendant that
        // left the child's process group can hold a captured pipe (or the
        // terminal) open long after the child exits, and its EOF never comes.
        // Past the limit the collector stops the child and then stops reading.
        timeout: fd_word(spec, PROCESS_SPEC_TIMEOUT)
        expired: timeout != I64{0} && fd_word(timeout, I64{0}) >= I64{0} && (process_execution_now() - fd_word(child, I64{72})) /% I64{1000000} >= fd_word(timeout, I64{0})
        if (expired && !exited) {
            fd_put(child, I64{104}, I64{1})
            process_execution_stop(child)
        }
        if (expired && exited && !(output_done && errors_done)) {
            fd_put(child, I64{104}, I64{1})
            process_execution_drain_stop(native)
            output_done = true
            errors_done = true
        }
        detached: fd_word(spec, PROCESS_SPEC_DETACHED).bit_and(I64{255}) != I64{0}
        contained: !detached || sync_load(wrapping(child + I64{120})).bit_and(I64{4}) != I64{0}
        if (exited && contained && sync_load(wrapping(child + I64{120})).bit_and(I64{8}) == I64{0}) {
            process_execution_sweep(child)
        }
        if (exited && output_done && errors_done) -> break
        process_execution_idle(child, native, pidfd, exited, output_done, errors_done, wrapping(scratch + I64{8256}))
    }
    spawn_close(pidfd)
    sync_mutex_lock(native)
    spawn_close(fd_word(native, I64{32}))
    fd_put(native, I64{32}, I64{-1})
    // The terminal master the capture kept open past the child's last slave close.
    spawn_close(fd_word(native, I64{56}))
    fd_put(native, I64{56}, I64{-1})
    sync_mutex_unlock(native)
    sync_mutex_lock(child)
    if !process_execution_validate_output(child, wrapping(scratch + I64{8232})) {
        jet_rt_handle_drop_io_error(fd_word(child, I64{56}))
        fd_put(child, I64{56}, fd_word(scratch, I64{8232}))
    }
    if (fd_word(child, I64{112}) != I64{0} && fd_word(child, I64{56}) == I64{0}) -> fd_put(child, I64{56}, jet_rt_record_new_io_error_resource_limit(PROCESS_RESOURCE_OUTPUT))
    if (resource_limit >= I64{0} && fd_word(child, I64{56}) == I64{0}) -> fd_put(child, I64{56}, jet_rt_record_new_io_error_resource_limit(resource_limit))
    if (status.bit_and(I64{127}) == I64{24} && fd_word(spec, PROCESS_SPEC_CPU_TIME_LIMIT) != I64{0} && fd_word(child, I64{56}) == I64{0}) -> fd_put(child, I64{56}, jet_rt_record_new_io_error_resource_limit(PROCESS_RESOURCE_CPU_TIME))
    if (fd_word(child, I64{56}) == I64{0}) -> fd_put(child, I64{48}, process_execution_receipt(child, status))
    waiter: fd_word(child, I64{64})
    fd_put(child, I64{64}, I64{0})
    sync_store(wrapping(child + I64{40}), I64{1})
    sync_wake(child + I64{40}, I64{2147483647})
    sync_mutex_unlock(child)
    if (waiter != I64{0}) {
        sync_park_wake(waiter)
        sync_park_drop(waiter)
    }
    jet_rt_free(scratch, I64{8280}, I64{8})
    process_execution_release(child)
    I64{0}
}
// Sleeps until the child exits or a captured stream has bytes or EOF: poll(2)
// on the pidfd and the open pipes, as PollFd8 rows at `fds` (fd I32, events
// I16 = POLLIN, revents I16). The exit of a child with no pidfd, a spec
// timeout and a live resource limit still need their 1 ms check; otherwise
// the 50 ms timeout only bounds an event that never comes.
process_execution_idle: fn(child: I64, native: I64, pidfd: I64, exited: Bool, output_done: Bool, errors_done: Bool, fds: I64) {
    count := I64{0}
    if (!exited && pidfd >= I64{0}) {
        fd_put(fds, I64{0}, pidfd.bit_or(I64{4294967296}))
        count = I64{1}
    }
    stream := I64{1}
    loop stream <= (I64{2}) {
        done: if (stream == I64{1}) -> output_done else -> errors_done
        number: fd_word(native, spawn_stream_offset(native, stream))
        if (!done && number >= I64{0}) {
            fd_put(fds, count * I64{8}, number.bit_or(I64{4294967296}))
            count += I64{1}
        }
        stream += I64{1}
    }
    spec: fd_word(child, I64{24})
    periodic: !exited && (pidfd < I64{0} || fd_word(spec, PROCESS_SPEC_TIMEOUT) != I64{0} || fd_word(spec, PROCESS_SPEC_MEMORY_LIMIT) != I64{0} || fd_word(spec, PROCESS_SPEC_OPEN_FILE_LIMIT) != I64{0})
    _ := host_call(I64{7}, fds, count, if periodic -> I64{1} else -> I64{50})
}
process_execution_wait: fn(child: I64, ok: I64, err: I64) -> I64 {
    flags: sync_load(wrapping(child + I64{120}))
    if (flags.bit_and(I64{2}) != I64{0} && flags.bit_and(I64{4}) == I64{0}) {
        return compiler_fs_error(HOST_IO_KIND_CLOSED, HOST_IO_OP_CLOSE, rt_static_text("process"), I64{0}, jet_rt_string_clone(rt_static_text("process child wait result is unavailable")), err)
    }
    process_execution_flags_add(child, I64{4})
    if !process_execution_collect_start(child, err) -> return I64{0}
    // Rust's wait drops the public readers before joining the collector: a
    // stream read after an explicit wait is at EOF.
    park: sync_park_new()
    sync_mutex_lock(child)
    pipe_detach(fd_word(child, PROCESS_EXECUTION_STDOUT))
    pipe_detach(fd_word(child, PROCESS_EXECUTION_STDERR))
    // The first waiter lends the collector a reference to its park slot,
    // which the collector wakes as it sets done. An aliased waiter behind it
    // keeps the seed's 10ms scheduler poll on its own slot.
    if (fd_word(child, I64{64}) == I64{0} && sync_load(wrapping(child + I64{40})) == I64{0}) {
        sync_park_retain(park)
        fd_put(child, I64{64}, park)
    }
    sync_mutex_unlock(child)
    loop sync_load(wrapping(child + I64{40})) == (I64{0}) {
        if (scheduler_yield(rt_static_text("process wait"), park, I64{10000000}) != I64{0}) {
            process_execution_park_return(child, park)
            process_execution_stop(child)
            process_execution_await_cleanup(child)
            return I64{0}
        }
    }
    process_execution_park_return(child, park)
    // Detached spawn/drop does not sweep descendants. Explicit wait does.
    if (sync_load(wrapping(child + I64{120})).bit_and(I64{8}) == I64{0}) -> process_execution_sweep(child)
    sync_mutex_lock(child)
    error: fd_word(child, I64{56})
    if (error != I64{0}) {
        fd_put(err, I64{0}, jet_rt_handle_clone_io_error(error))
        sync_mutex_unlock(child)
        return I64{0}
    }
    fd_put(ok, I64{0}, jet_rt_handle_clone_process_receipt(fd_word(child, I64{48})))
    sync_mutex_unlock(child)
    I64{1}
}
// Drops the waiter's park slot, and the collector's reference with it when the
// collector has not taken that reference to wake the slot.
process_execution_park_return: fn(child: I64, park: I64) {
    sync_mutex_lock(child)
    lent: fd_word(child, I64{64}) == park
    if lent -> fd_put(child, I64{64}, I64{0})
    sync_mutex_unlock(child)
    if lent -> sync_park_drop(park)
    sync_park_drop(park)
}
#Export(c) jet_process_child_exited: fn(child: I64, ok: I64, err: I64) -> I64 {
    if (sync_load(wrapping(child + I64{120})).bit_and(I64{2}) != I64{0}) {
        #Unsafe("ok is the canonical writable Bool output slot") { os_store_u8(ok, I64{1}) }
        return I64{1}
    }
    scratch: jet_rt_alloc(I64{40}, I64{8})
    result: jet_process_wait_raw(process_execution_native(child), true, scratch, wrapping(scratch + I64{8}))
    code: fd_word(scratch, I64{16})
    jet_rt_free(scratch, I64{40}, I64{8})
    if (result < I64{0}) -> return process_execution_error(fd_word(child, I64{24}), HOST_IO_OP_CLOSE, host_errno_cause(code), err)
    #Unsafe("ok lends exactly the C ABI Bool byte") { os_store_u8(ok, if (result > I64{0}) -> I64{1} else -> I64{0}) }
    I64{1}
}
process_execution_signal: fn(child: I64, signal: I64, err: I64) -> I64 {
    native: process_execution_native(child)
    if (sync_load(wrapping(child + I64{120})).bit_and(I64{2}) != I64{0}) -> return I64{1}
    if (fd_word(native, I64{16}) == I64{1}) -> return I64{1}
    result: host_call(I64{62}, -fd_word(native, I64{8}), signal, I64{0})
    // ESRCH: the group has nobody left to signal, because the child already
    // exited and was reaped. Signalling a finished child succeeds.
    if (result == I64{-3}) -> return I64{1}
    if (result < I64{0}) -> return process_execution_error(fd_word(child, I64{24}), HOST_IO_OP_CLOSE, host_errno_cause(-result), err)
    I64{1}
}
#Export(c) jet_process_child_kill: fn(child: I64, err: I64) -> I64 { process_execution_signal(child, I64{9}, err) }
#Export(c) jet_process_child_terminate: fn(child: I64, err: I64) -> I64 { process_execution_signal(child, I64{15}, err) }
#Export(c) jet_process_child_interrupt: fn(child: I64, err: I64) -> I64 { process_execution_signal(child, I64{2}, err) }
#Export(c) jet_process_child_close: fn(child: I64) {
    process_execution_flags_add(child, I64{2})
    detached: fd_word(fd_word(child, I64{24}), PROCESS_SPEC_DETACHED).bit_and(I64{255}) != I64{0}
    if (!detached && sync_load(wrapping(child + I64{40})) == I64{0}) {
        process_execution_stop(child)
        if (fd_word(child, I64{32}) != I64{0}) {
            process_execution_await_cleanup(child)
        } else {
            process_execution_reap_stopped(child)
            sync_store(wrapping(child + I64{40}), I64{1})
        }
    }
    native: process_execution_native(child)
    sync_mutex_lock(native)
    spawn_close(fd_word(native, I64{32}))
    fd_put(native, I64{32}, I64{-1})
    sync_mutex_unlock(native)
}

// child.stdin is Rc<RefCell<Option<ProcessStdin>>> shared with its child. The
// native ProcessStdin handle is the retained HostSpawn Child104; stdin32 = -1 is
// the taken writer, seen by every alias.
process_stdin_closed: fn(err: I64) -> I64 {
    compiler_fs_error(HOST_IO_KIND_CLOSED, HOST_IO_OP_WRITE, rt_static_text("process stdin"), I64{0}, jet_rt_string_clone(rt_static_text("process stdin closed")), err)
}
// BrokenPipe and NotConnected are the closed writer; other errno is Other.
process_stdin_failure: fn(errno: I64, err: I64) -> I64 {
    if (errno == I64{32} || errno == I64{107}) -> return process_stdin_closed(err)
    host_io_other_take(HOST_IO_OP_WRITE, jet_rt_string_clone(rt_static_text("process stdin")), host_errno_cause(errno), err)
}
// Borrowed: the field lends the child's own Child104 for the place's lifetime.
#Export(c) jet_rt_handle_field_process_child_stdin: fn(child: I64) -> I64 { process_execution_native(child) }
#Export(c) jet_rt_handle_clone_process_stdin: fn(stdin: I64) -> I64 { jet_process_retain_raw(stdin) }
#Export(c) jet_rt_handle_drop_process_stdin: fn(stdin: I64) { jet_process_drop_raw(stdin) }
// Borrowed: each field lends the child's own Pipe40 cell for the place's
// lifetime, made on first use. Like Rust's ProcessReader::Shared, the cell
// reads the collector's capture of its stream rather than the pipe itself, so
// the receipt keeps every byte and the child never blocks on an unread pipe.
#Export(c) jet_rt_handle_field_process_child_stdout: fn(child: I64) -> I64 { process_execution_pipe(child, I64{1}) }
#Export(c) jet_rt_handle_field_process_child_stderr: fn(child: I64) -> I64 { process_execution_pipe(child, I64{2}) }
// Some only for a child spawned on a terminal, whose Child104 holds the master
// at 56. The session retains that Child104, so it outlives every alias of the
// child; `some` receives it and the selector says whether it was written.
#Export(c) jet_rt_handle_field_process_child_terminal: fn(child: I64, some: I64) -> I64 {
    native: process_execution_native(child)
    sync_mutex_lock(native)
    master: fd_word(native, I64{56})
    sync_mutex_unlock(native)
    if (master < I64{0}) -> return I64{0}
    fd_put(some, I64{0}, jet_terminal_session_from_child_raw(native))
    I64{1}
}
process_execution_pipe: fn(child: I64, stream: I64) -> I64 {
    slot: if (stream == I64{1}) -> PROCESS_EXECUTION_STDOUT else -> PROCESS_EXECUTION_STDERR
    sync_mutex_lock(child)
    if (fd_word(child, slot) == I64{0}) -> fd_put(child, slot, pipe_shared(child, stream))
    pipe: fd_word(child, slot)
    sync_mutex_unlock(child)
    pipe
}
// The next bytes of `child`'s captured stream `stream` (1 stdout, 2 stderr)
// past what its readers consumed: through the first newline when `line`, else
// up to `maximum` bytes. Waits on the collector until it captures them or the
// stream ends; at the end it returns what remains, and none is EOF. Writes
// owned data+len, or 0/0: the native U8 List buffer the route adopts, an
// align-8 block for a line (the line ABI of HostPipe.jet) and the buffer
// compiler_fs_bytes_take makes for a read.
process_execution_stream_bytes: fn(child: I64, stream: I64, maximum: I64, line: Bool, data_out: I64, len_out: I64) {
    fd_put(data_out, I64{0}, I64{0})
    fd_put(len_out, I64{0}, I64{0})
    native: process_execution_native(child)
    capture: if (stream == I64{1}) -> I64{80} else -> I64{88}
    consumed: if (stream == I64{1}) -> I64{144} else -> I64{152}
    park := I64{0}
    loop {
        // Read before the capture: the collector appends a stream's last
        // bytes before it marks that stream closed.
        sync_mutex_lock(native)
        closed: fd_word(native, spawn_stream_offset(native, stream)) < I64{0}
        sync_mutex_unlock(native)
        sync_mutex_lock(child)
        text: fd_word(child, capture)
        data: rt_text_data(text)
        filled: rt_text_len(text)
        at: fd_word(child, consumed)
        end := at
        found := false
        loop end < filled && end - at < maximum {
            byte := I64{0}
            #Unsafe("the child mutex holds the capture builder's initialized bytes") {
                byte = os_load_u8(wrapping(data + end))
            }
            end = wrapping(end + I64{1})
            if (line && byte == I64{10}) {
                found = true
                break
            }
        }
        if (found || closed || (!line && end > at)) {
            count: end - at
            if (count > I64{0} && line) {
                bytes: jet_rt_alloc_8(count)
                rt_text_bytes_copy(bytes, wrapping(data + at), count)
                fd_put(data_out, I64{0}, bytes)
                fd_put(len_out, I64{0}, count)
            }
            if (count > I64{0} && !line) {
                bytes: jet_rt_alloc(count, I64{8})
                rt_text_bytes_copy(bytes, wrapping(data + at), count)
                compiler_fs_bytes_take(bytes, count, count, data_out, len_out)
            }
            fd_put(child, consumed, end)
            sync_mutex_unlock(child)
            break
        }
        sync_mutex_unlock(child)
        if (park == I64{0}) -> park = sync_park_new()
        // Cancellation propagates through the scheduler; the read ends empty.
        if (scheduler_yield(rt_static_text("process stream"), park, I64{10000000}) != I64{0}) -> break
    }
    if (park != I64{0}) -> sync_park_drop(park)
}
// Writes every byte on a private dup so a concurrent close cannot recycle the
// descriptor mid-write; Ok(0) is the closed writer, EINTR retries.
process_stdin_write_bytes: fn(stdin: I64, data: I64, length: I64, err: I64) -> I64 {
    packed: spawn_stream_dup(stdin, I64{0})
    if (packed == I64{-9}) -> return process_stdin_closed(err)
    if (packed < I64{0}) -> return process_stdin_failure(-packed, err)
    native: packed.bit_and(I64{4294967295})
    offset := I64{0}
    failure := I64{0}
    loop offset < length {
        written: host_call(I64{1}, native, wrapping(data + offset), length - offset)
        if (written == I64{-4}) -> next
        if (written == I64{0}) {
            failure = I64{32}
            break
        }
        if (written < I64{0}) {
            failure = -written
            break
        }
        offset += written
    }
    spawn_close(native)
    if (failure != I64{0}) -> return process_stdin_failure(failure, err)
    I64{1}
}
// ProcessStdin.write(bytes): one ChildStdin::write of a native U8 list on a
// private dup; Ok is the count the pipe took, EINTR retries.
#Export(c) jet_process_stdin_write: fn(stdin: I64, data: I64, length: I64, ok: I64, err: I64) -> I64 {
    packed: spawn_stream_dup(stdin, I64{0})
    if (packed == I64{-9}) -> return process_stdin_closed(err)
    if (packed < I64{0}) -> return process_stdin_failure(-packed, err)
    native: packed.bit_and(I64{4294967295})
    written := host_call(I64{1}, native, data, length)
    loop written == (I64{-4}) {
        written = host_call(I64{1}, native, data, length)
    }
    spawn_close(native)
    if (written < I64{0}) -> return process_stdin_failure(-written, err)
    rt_text_store(ok, jet_int_owned_from_i64(written))
    I64{1}
}
#Export(c) jet_process_stdin_write_text: fn(stdin: I64, text: I64, err: I64) -> I64 {
    process_stdin_write_bytes(stdin, rt_text_data(text), rt_text_len(text), err)
}
// ProcessStdin.write_all(bytes): ChildStdin::write_all of a native U8 list
// (RT_HOST_U8_STRIDE is 1: the list data is the bytes).
#Export(c) jet_process_stdin_write_all: fn(stdin: I64, data: I64, length: I64, err: I64) -> I64 {
    process_stdin_write_bytes(stdin, data, length, err)
}
// Option::take: closing sends EOF once; repeated close is harmless. A terminal
// child's input shares the PTY master with its output, which stays open.
#Export(c) jet_process_stdin_close: fn(stdin: I64) {
    sync_mutex_lock(stdin)
    native: fd_word(stdin, I64{32})
    fd_put(stdin, I64{32}, I64{-1})
    sync_mutex_unlock(stdin)
    spawn_close(native)
}
