    loop at < length {
        offset :: at * HTTP_CORS_TEXT_STRIDE
        data_tree_store(target + offset, jet_rt_string_clone(data_tree_word(source + offset)))
        at += I64{1}
    }
    data_tree_store(result + DATA_SEQUENCE_LENGTH, length)
