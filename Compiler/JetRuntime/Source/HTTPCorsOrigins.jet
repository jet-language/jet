}
fn http_cors_origins_copy(source: I64, target: I64) {
    ordinal :: http_cors_origins_ordinal(source)
    payload :: if (ordinal == I64{1}) -> http_cors_text_list_clone(encoding_word(source + HTTP_CORS_ORIGINS_PAYLOAD)) else -> I64{0}
