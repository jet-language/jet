// HTTPServer.rs:6350-6354 / frozen seed183042-45: Any0, List1(Vec<Text>).
// Native Origins16 owns no child for Any, and a sequence24 of E4 owners for
// List. Policy embeds these two words; child helpers never free that shell.
HTTP_CORS_ORIGINS_BYTES :: prep { I64{16} }
HTTP_CORS_ORIGINS_TAG :: prep { I64{0} }
HTTP_CORS_ORIGINS_PAYLOAD :: prep { I64{8} }
HTTP_CORS_TEXT_STRIDE :: prep { I64{8} }
fn http_cors_origins_ordinal(value: I64) -> I64 {
    ordinal :: encoding_word(value + HTTP_CORS_ORIGINS_TAG)
    if (ordinal < I64{0} || ordinal > I64{1}) -> rt_record_variant_panic()
    ordinal
}
fn http_cors_text_list_clone(value: I64) -> I64 {
    length :: data_tree_word(value + DATA_SEQUENCE_LENGTH)
    result :: data_sequence_new(length, HTTP_CORS_TEXT_STRIDE)
    source :: data_tree_word(value + DATA_SEQUENCE_DATA)
    target :: data_tree_word(result + DATA_SEQUENCE_DATA)
