#Export(c) fn jet_rt_handle_clone_jet_http_cors_origins(value: I64) -> I64 {
    result :: jet_rt_alloc(HTTP_CORS_ORIGINS_BYTES, I64{8})
    http_cors_origins_copy(value, result)
