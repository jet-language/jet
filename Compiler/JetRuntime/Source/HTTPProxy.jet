// Frozen seed176181-185: Clone enum, ordinal order. Url ctor borrows+clones
// Text, getter returns a fresh Text owner, wrong variant takes the core
// record-variant panic.
HTTP_PROXY_BYTES: I64{16}
HTTP_PROXY_TAG: I64{0}
HTTP_PROXY_PAYLOAD: I64{8}
http_proxy_ordinal: fn(value: I64) -> I64 {
    ordinal: encoding_word(wrapping(value + HTTP_PROXY_TAG))
    if (ordinal < I64{0} || ordinal > I64{2}) -> rt_record_variant_panic()
    ordinal
}
http_proxy_new: fn(ordinal: I64, payload: I64) -> I64 {
    result: jet_rt_alloc(HTTP_PROXY_BYTES, I64{8})
    encoding_store(wrapping(result + HTTP_PROXY_TAG), ordinal)
    encoding_store(wrapping(result + HTTP_PROXY_PAYLOAD), payload)
    result
}
#Export(c) jet_rt_record_new_jet_http_proxy_from_environment: fn() -> I64 { http_proxy_new(I64{0}, I64{0}) }
#Export(c) jet_rt_record_new_jet_http_proxy_none: fn() -> I64 { http_proxy_new(I64{1}, I64{0}) }
#Export(c) jet_rt_record_new_jet_http_proxy_url: fn(payload: I64) -> I64 { http_proxy_new(I64{2}, jet_rt_string_clone(payload)) }
#Export(c) jet_rt_record_tag_jet_http_proxy: fn(value: I64) -> I64 { http_proxy_ordinal(value) }
#Export(c) jet_rt_record_get_jet_http_proxy_url: fn(value: I64) -> I64 {
    if (http_proxy_ordinal(value) != I64{2}) -> rt_record_variant_panic()
    jet_rt_string_clone(encoding_word(wrapping(value + HTTP_PROXY_PAYLOAD)))
}
#Export(c) jet_rt_handle_clone_jet_http_proxy: fn(value: I64) -> I64 {
    ordinal: http_proxy_ordinal(value)
    payload: if (ordinal == I64{2}) -> jet_rt_string_clone(encoding_word(wrapping(value + HTTP_PROXY_PAYLOAD))) else -> I64{0}
    http_proxy_new(ordinal, payload)
}
#Export(c) jet_rt_handle_drop_jet_http_proxy: fn(value: I64) {
    if (value == I64{0}) -> return
    if (http_proxy_ordinal(value) == I64{2}) -> jet_rt_string_drop(encoding_word(wrapping(value + HTTP_PROXY_PAYLOAD)))
    jet_rt_free(value, HTTP_PROXY_BYTES, I64{8})
}
