// std::thread::ThreadId: a process-unique counter, assigned to a thread the
// first time it is asked for and kept for its lifetime.
testing_thread_key := I64{0}
testing_thread_next := I64{0}

fn testing_thread_id() -> I64 {
    if (testing_thread_key == I64{0}) {
        host_lock()
        if (testing_thread_key == I64{0}) -> testing_thread_key = jet_rt_tls_key_new(I64{0})
        host_unlock()
    }
    id := jet_rt_tls_get(testing_thread_key)
    if (id == I64{0}) {
        host_lock()
        testing_thread_next = testing_thread_next + I64{1}
        id = testing_thread_next
        host_unlock()
        jet_rt_tls_set(testing_thread_key, id)
    }
    id
}

// TestingShared.rs:43: std::process::id() and format!("{:?}", ThreadId).
#Export(c) fn jet_testing_temp_facts_raw() -> I64 {
    thread :: jet_rt_string_builder_new()
    jet_rt_string_builder_push(thread, rt_static_text("ThreadId("))
    rt_text_push_number(thread, testing_thread_id())
    jet_rt_string_builder_push(thread, rt_static_text(")"))
    testing_facts_new(host_call(I64{39}, I64{0}, I64{0}, I64{0}), thread)
}

// TempPath32: inline List<U8> header@0 (len, cap, data), owned text@24.
#Export(c) fn jet_rt_record_new_jet_testing_temp_path(path: I64, text: I64) -> I64 {
    value :: jet_rt_alloc(I64{32}, I64{8})
    coll_copy(path, value, I64{24})
    jet_rt_free(path, I64{24}, I64{8})
    rt_text_store(value + I64{24}, jet_rt_string_clone(text))
    value
}
#Export(c) fn jet_rt_record_get_jet_testing_temp_path_path(value: I64) -> I64 { value }
#Export(c) fn jet_rt_record_get_jet_testing_temp_path_text(value: I64) -> I64 { jet_rt_string_clone(rt_text_word(value + I64{24})) }
#Export(c) fn jet_rt_handle_clone_jet_testing_temp_path(value: I64) -> I64 {
    result :: jet_rt_alloc(I64{32}, I64{8})
    data_u8_list_copy_into(value, result)
    rt_text_store(result + I64{24}, jet_rt_string_clone(rt_text_word(value + I64{24})))
    result
}
#Export(c) fn jet_rt_handle_drop_jet_testing_temp_path(value: I64) {
    if (value == I64{0}) -> return
    data_u8_list_drop_fields(value)
    jet_rt_string_drop(rt_text_word(value + I64{24}))
    jet_rt_free(value, I64{32}, I64{8})
}
#Export(c) fn jet_rt_handle_eq_jet_testing_temp_path(left: I64, right: I64) -> Bool {
    length :: rt_text_word(left)
    if (length != rt_text_word(right)) -> return false
    if !rt_text_equal_bytes(rt_text_word(left + I64{16}), rt_text_word(right + I64{16}), length) -> return false
    jet_rt_string_eq(rt_text_word(left + I64{24}), rt_text_word(right + I64{24}))
}

// TestingShared.rs:50: std::env::temp_dir() (TMPDIR from the process
// environment, else /tmp) joined with `name` (Path::push: an absolute name
// replaces; otherwise one separator unless the base is empty or ends in /).
#Export(c) fn jet_testing_temp_join_raw(name: I64) -> I64 {
    host_arguments_require()
    base := host_environment_value(rt_static_text("TMPDIR"))
    base_length := I64{0}
    if (base == I64{0}) {
        base = rt_text_data(rt_static_text("/tmp"))
        base_length = I64{4}
    } else {
        base_length = host_startup_byte_length(base)
    }
    bytes :: jet_rt_string_builder_new()
    name_length :: rt_text_len(name)
    absolute :: name_length > I64{0} && rt_text_byte(rt_text_data(name)) == I64{47}
    if !absolute {
        rt_text_append(bytes, base, base_length)
        if (base_length > I64{0} && rt_text_byte(base + base_length - I64{1}) != I64{47}) -> rt_text_append(bytes, rt_text_data(rt_static_text("/")), I64{1})
    }
    rt_text_append(bytes, rt_text_data(name), name_length)
    length :: rt_text_len(bytes)
    value :: jet_rt_alloc(I64{32}, I64{8})
    rt_text_store(value, length)
    rt_text_store(value + I64{8}, length)
    rt_text_store(value + I64{16}, host_startup_bytes(rt_text_data(bytes), length))
    rt_text_store(value + I64{24}, rt_text_lossy(rt_text_data(bytes), length))
    jet_rt_string_drop(bytes)
    value
}

