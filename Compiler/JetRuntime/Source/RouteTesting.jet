// Core.rs:674-688 and TestingShared.rs: core.testing's physical leaves.
// Evidence classification, sanitation and lifecycle ordering stay in Core.

// Core.rs:674/684: the thread's one pending testing failure (TestScope.jet).
#Export(c) fn jet_testing_record_failure(message: I64, detail: I64) { jet_rt_testing_record_failure(message, detail) }
#Export(c) fn jet_testing_clear_failure() { jet_rt_testing_clear_failure() }

fn testing_flag(value: Bool) -> I64 { if value -> I64{1} else -> I64{0} }

fn testing_has_nul(text: I64) -> Bool {
    at := I64{0}
    loop at < rt_text_len(text) {
        if (rt_text_byte(rt_text_data(text) + at) == I64{0}) -> return true
        at += I64{1}
    }
    false
}

// EvidenceRead24: ok@0, owned text@8, missing@16.
fn testing_evidence_new(ok: I64, text: I64, missing: I64) -> I64 {
    value :: jet_rt_alloc(I64{24}, I64{8})
    rt_text_store(value, ok)
    rt_text_store(value + I64{8}, text)
    rt_text_store(value + I64{16}, missing)
    value
}
#Export(c) fn jet_rt_record_new_jet_testing_evidence_read(ok: Bool, text: I64, missing: Bool) -> I64 { testing_evidence_new(testing_flag(ok), jet_rt_string_clone(text), testing_flag(missing)) }
#Export(c) fn jet_rt_record_get_jet_testing_evidence_read_ok(value: I64) -> Bool { rt_text_word(value) != I64{0} }
#Export(c) fn jet_rt_record_get_jet_testing_evidence_read_text(value: I64) -> I64 { jet_rt_string_clone(rt_text_word(value + I64{8})) }
#Export(c) fn jet_rt_record_get_jet_testing_evidence_read_missing(value: I64) -> Bool { rt_text_word(value + I64{16}) != I64{0} }
#Export(c) fn jet_rt_handle_clone_jet_testing_evidence_read(value: I64) -> I64 { testing_evidence_new(rt_text_word(value), jet_rt_string_clone(rt_text_word(value + I64{8})), rt_text_word(value + I64{16})) }
#Export(c) fn jet_rt_handle_drop_jet_testing_evidence_read(value: I64) {
    if (value == I64{0}) -> return
    jet_rt_string_drop(rt_text_word(value + I64{8}))
    jet_rt_free(value, I64{24}, I64{8})
}
#Export(c) fn jet_rt_handle_eq_jet_testing_evidence_read(left: I64, right: I64) -> Bool {
    rt_text_word(left) == rt_text_word(right) && rt_text_word(left + I64{16}) == rt_text_word(right + I64{16}) &&
        jet_rt_string_eq(rt_text_word(left + I64{8}), rt_text_word(right + I64{8}))
}

// TestingShared.rs:32 std::fs::read_to_string: NotFound is `missing`; every
// other failure (including invalid UTF-8 and std's NUL refusal) is not.
#Export(c) fn jet_testing_evidence_read_raw(path: I64) -> I64 {
    if testing_has_nul(path) -> return testing_evidence_new(I64{0}, jet_rt_string_builder_new(), I64{0})
    scratch :: jet_rt_alloc(I64{8}, I64{8})
    status :: env_read_file(path, scratch)
    out :: rt_text_word(scratch)
    jet_rt_free(scratch, I64{8}, I64{8})
    if (status == I64{1}) -> return testing_evidence_new(I64{1}, out, I64{0})
    if (status < I64{0}) -> jet_rt_string_drop(out)
    testing_evidence_new(I64{0}, jet_rt_string_builder_new(), if (status == I64{0}) -> I64{1} else -> I64{0})
}

