// TestingShared.rs:64 std::fs::remove_dir_all over the opaque path bytes.
#Export(c) fn jet_testing_temp_remove_raw(data: I64, length: I64) -> I64 {
    path :: rt_text_copy(data, length)
    result :: if testing_has_nul(path) -> I64{-2147483648} else -> files_remove_dir_all(path)
    jet_rt_string_drop(path)
    if (result == I64{-2147483648}) -> return testing_remove_new(I64{0}, I64{0}, jet_rt_string_clone(rt_static_text("file name contained an unexpected NUL byte")))
    if (result < I64{0}) -> return testing_remove_new(I64{0}, if (result == I64{-2}) -> I64{1} else -> I64{0}, host_errno_cause(-result))
    testing_remove_new(I64{1}, I64{0}, jet_rt_string_builder_new())
}

