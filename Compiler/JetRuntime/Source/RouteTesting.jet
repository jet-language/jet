// stat (following links) reports a directory.
fn testing_is_dir(path: I64, length: I64) -> Bool {
    text :: rt_text_copy(path, length)
    scratch :: jet_rt_alloc(I64{160}, I64{8})
    jet_fs_stat_raw(text, true, scratch, scratch + I64{128})
    code :: files_out_errno(scratch + I64{128})
    mode :: rt_text_word(scratch + I64{16}).bit_and(I64{4294967295})
    jet_rt_free(scratch, I64{160}, I64{8})
    jet_rt_string_drop(text)
    code == I64{0} && (mode.bit_and(I64{61440})) == I64{16384}
}

fn testing_mkdir(path: I64, length: I64) -> I64 {
    name :: jet_rt_alloc(length + I64{1}, I64{1})
    rt_text_bytes_copy(name, path, length)
    rt_text_put(name + length, I64{0})
    result := I64{-4}
    loop result == (I64{-4}) -> result = host_call(I64{83}, name, I64{511}, I64{0})
    jet_rt_free(name, length + I64{1}, I64{1})
    if (result < I64{0}) -> result else -> I64{0}
}

// Path::parent's byte length: drop trailing separators, the last component,
// then its separators (a root keeps its "/"); -1 when there is no parent.
fn testing_parent_length(path: I64, length: I64) -> I64 {
    end := length
    loop end > (I64{1}) && rt_text_byte(path + end - I64{1}) == (I64{47}) -> end -= I64{1}
    if (end == I64{1} && rt_text_byte(path) == I64{47}) -> return I64{-1}
    loop end > (I64{0}) && rt_text_byte(path + end - I64{1}) != (I64{47}) -> end -= I64{1}
    loop end > (I64{1}) && rt_text_byte(path + end - I64{1}) == (I64{47}) -> end -= I64{1}
    end
}

// std DirBuilder::create_dir_all (mode 0o777). Returns 0 or -errno; -1 with
// errno 0 is std's "failed to create whole tree".
fn testing_create_dir_all(path: I64, length: I64) -> I64 {
    if (length == I64{0}) -> return I64{0}
    first :: testing_mkdir(path, length)
    if (first == I64{0}) -> return I64{0}
    if (first != I64{-2}) {
        if testing_is_dir(path, length) -> return I64{0}
        return first
    }
    parent :: testing_parent_length(path, length)
    if (parent < I64{0}) -> return I64{-2147483647}
    upper :: testing_create_dir_all(path, parent)
    if (upper < I64{0}) -> return upper
    second :: testing_mkdir(path, length)
    if (second == I64{0} || testing_is_dir(path, length)) -> return I64{0}
    second
}

// TestingShared.rs:75 std::fs::create_dir_all over the opaque path bytes.
#Export(c) fn jet_testing_temp_create_raw(data: I64, length: I64) -> I64 {
    owned :: rt_text_copy(data, length)
    nul :: testing_has_nul(owned)
    jet_rt_string_drop(owned)
    if nul -> return testing_create_new(I64{0}, jet_rt_string_clone(rt_static_text("file name contained an unexpected NUL byte")))
    result :: testing_create_dir_all(data, length)
    if (result == I64{-2147483647}) -> return testing_create_new(I64{0}, jet_rt_string_clone(rt_static_text("failed to create whole tree")))
    if (result < I64{0}) -> return testing_create_new(I64{0}, host_errno_cause(-result))
    testing_create_new(I64{1}, jet_rt_string_builder_new())
}

// TestingShared.rs:82 text[start..end]: Core passes in-bounds char-boundary
// byte offsets as U64 words.
#Export(c) fn jet_testing_text_window_raw(text: I64, start: I64, end: I64) -> I64 {
    first :: jet_int_owned_to_i64(start)
    if (jet_scheduler_native_propagate() != I64{0}) -> return I64{0}
    last :: jet_int_owned_to_i64(end)
    if (jet_scheduler_native_propagate() != I64{0}) -> return I64{0}
    rt_text_copy(rt_text_data(text) + first, last - first)
}
