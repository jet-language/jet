// `jet test`'s read recorder (JetCli TestReuse.jet): the paths
// and environment names a test program reads, so a later run reuses its
// stored results while every recorded read is unchanged. JET_TEST_READS_PATH,
// which `jet test` sets on the harness alone, names a file each read appends
// one record to with a single O_APPEND write, so threads and the processes a
// test starts (which inherit the variable) never interleave a record. A
// program without the variable records nothing: it pays one environment
// lookup at its first host call or recorded read, and one compare after.
//
// A record: one kind byte, the name's bytes, then NUL. Kinds: `F` a path
// opened for reading (its contents, or a directory's listing, are read),
// `S` a path whose existence, kind, size or time is read (stat, readlink, an
// O_PATH open), `E` an environment variable read by name, `A` the whole
// environment read. A relative path is recorded absolute: against the open
// directory it is relative to, else the working directory.
//
// The recorder's log descriptor; -1 when nothing records, and
// TEST_READS_UNRESOLVED from a main's registration until its first use looks
// JET_TEST_READS_PATH up in the startup envp, so startup never scans it.
test_reads_fd := I64{-1}

TEST_READS_UNRESOLVED: I64{-2}

// Startup (HostStartup.jet host_arguments_register), single-threaded and
// before user code. A main's envp lives for the process, so its lookup waits
// for the recorder's first use (rt_test_reads_on); an entryless host only
// lends envp to this call, so its recorder is armed now. A restart's
// registration (jet_rt_host_restart) stops the recorder the old environment
// armed, so only the new environment arms one.
rt_test_reads_arm: fn(envp: I64, main: Bool) {
    old: test_reads_fd
    armed: if main -> TEST_READS_UNRESOLVED else -> rt_test_reads_open_log(envp)
    #Unsafe("startup is single-threaded and precedes user code") {
        // close(2) of the recorder's own descriptor.
        if (old >= I64{0}) {
            _ := os_syscall_i64(I64{3}, old, I64{0}, I64{0}, I64{0}, I64{0}, I64{0})
        }
        test_reads_fd = armed
    }
}

// The log JET_TEST_READS_PATH names in `envp`, opened for appending, or -1.
rt_test_reads_open_log: fn(envp: I64) -> I64 {
    name: env_name_jet_test_reads_path()
    path: host_envp_value(envp, rt_text_data(name), rt_text_len(name))
    if (path == I64{0}) -> return I64{-1}
    fd := I64{-1}
    // O_WRONLY|O_APPEND|O_CLOEXEC: never a read, so never recorded.
    #Unsafe("the startup entry is a live NUL-terminated path for open") {
        fd = os_syscall_i64(I64{2}, path, I64{525313}, I64{0}, I64{0}, I64{0}, I64{0})
    }
    if (fd >= I64{0}) -> fd else -> I64{-1}
}

// Whether the recorder records, looking a main's JET_TEST_READS_PATH up on
// first use. Threads that race on that first use each open the same O_APPEND
// log and install their own descriptor; every record still lands whole in it.
rt_test_reads_on: fn() -> Bool {
    fd: test_reads_fd
    if (fd != TEST_READS_UNRESOLVED) -> return fd >= I64{0}
    opened: rt_test_reads_open_log(host_envp)
    #Unsafe("an idempotent install: every racing first use opens the same log") {
        test_reads_fd = opened
    }
    opened >= I64{0}
}

// A syscall through host_call (HostProcess.jet): open and openat record `F`
// for a read or read-write open and `S` for an O_PATH one; stat, lstat and
// readlink record `S`.
rt_test_reads_call: fn(number: I64, a1: I64, a2: I64, a3: I64) {
    if !rt_test_reads_on() -> return
    if (number == I64{2}) {
        rt_test_reads_open(I64{-100}, a1, a2)
    } else if (number == I64{257}) {
        rt_test_reads_open(a1, a2, a3)
    } else if (number == I64{4} || number == I64{6} || number == I64{89}) {
        rt_test_reads_path(I64{83}, I64{-100}, a1)
    }
}

// An open of the NUL-terminated `name` relative to `directory` (-100: the
// working directory) with Linux `flags`. A write-only open reads nothing.
rt_test_reads_open: fn(directory: I64, name: I64, flags: I64) {
    if !rt_test_reads_on() -> return
    if (flags.bit_and(I64{2097152}) != I64{0}) {
        rt_test_reads_path(I64{83}, directory, name)
    } else if (flags.bit_and(I64{3}) != I64{1}) {
        rt_test_reads_path(I64{70}, directory, name)
    }
}

// One `kind` record for the NUL-terminated `name` relative to `directory`.
rt_test_reads_path: fn(kind: I64, directory: I64, name: I64) {
    if (name == I64{0} || !rt_test_reads_on()) -> return
    length: host_startup_byte_length(name)
    // The base: none for an absolute name, else the directory's own path
    // (/proc/self/fd/<n>) or the working directory, each at most PATH_MAX.
    buffer: jet_rt_alloc(wrapping(length + I64{4100}), I64{1})
    trap_put(buffer, kind)
    at := I64{1}
    if (rt_text_byte(name) != I64{47}) {
        base := I64{-1}
        if (directory == I64{-100}) {
            #Unsafe("buffer lends 4096 writable bytes after the kind byte to getcwd") {
                base = os_syscall_i64(I64{79}, wrapping(buffer + I64{1}), I64{4096}, I64{0}, I64{0}, I64{0}, I64{0})
            }
            // getcwd counts the NUL it wrote.
            if (base > I64{0}) -> base = base - I64{1}
        } else {
            link: rt_test_reads_fd_link(directory)
            #Unsafe("link is a live NUL-terminated /proc path and buffer lends 4096 writable bytes after the kind byte") {
                base = os_syscall_i64(I64{89}, link, wrapping(buffer + I64{1}), I64{4096}, I64{0}, I64{0}, I64{0})
            }
            jet_rt_free(link, I64{32}, I64{1})
        }
        // A base the recorder cannot name makes the record unkeyable: `U`.
        if (base <= I64{0}) {
            trap_put(buffer, I64{85})
        } else {
            at = wrapping(base + I64{1})
            trap_put(wrapping(buffer + at), I64{47})
            at += I64{1}
        }
    }
    test_copy_bytes(wrapping(buffer + at), name, length)
    at = wrapping(at + length)
    trap_put(wrapping(buffer + at), I64{0})
    rt_test_reads_write(buffer, wrapping(at + I64{1}))
    jet_rt_free(buffer, wrapping(length + I64{4100}), I64{1})
}

// `/proc/self/fd/<directory>` NUL-terminated in a fresh 32-byte block.
rt_test_reads_fd_link: fn(directory: I64) -> I64 {
    link: jet_rt_alloc(I64{32}, I64{1})
    prefix: rt_static_text("/proc/self/fd/")
    test_copy_bytes(link, rt_text_data(prefix), rt_text_len(prefix))
    digits := I64{1}
    rest := directory / I64{10}
    loop rest > (I64{0}) {
        digits += I64{1}
        rest = rest / I64{10}
    }
    end: wrapping(rt_text_len(prefix) + digits)
    value := directory
    at := end
    loop at > (rt_text_len(prefix)) {
        at -= I64{1}
        trap_put(wrapping(link + at), I64{48} + value % I64{10})
        value = value / I64{10}
    }
    trap_put(wrapping(link + end), I64{0})
    link
}

// One `kind` record for the bytes of the runtime String `name` (an
// environment variable), or `A` with no name.
rt_test_reads_text: fn(kind: I64, name: I64) {
    if !rt_test_reads_on() -> return
    length: if (name == I64{0}) -> I64{0} else -> rt_text_len(name)
    buffer: jet_rt_alloc(wrapping(length + I64{2}), I64{1})
    trap_put(buffer, kind)
    if (length > I64{0}) -> test_copy_bytes(wrapping(buffer + I64{1}), rt_text_data(name), length)
    trap_put(wrapping(buffer + length + I64{1}), I64{0})
    rt_test_reads_write(buffer, wrapping(length + I64{2}))
    jet_rt_free(buffer, wrapping(length + I64{2}), I64{1})
}

// One O_APPEND write per record. A record the file did not take whole leaves
// the run unkeyable: `jet test` stores no results for a malformed log.
rt_test_reads_write: fn(data: I64, length: I64) {
    #Unsafe("data lends `length` initialized bytes to one write") {
        _ := os_syscall_i64(I64{1}, test_reads_fd, data, length, I64{0}, I64{0}, I64{0})
    }
}
