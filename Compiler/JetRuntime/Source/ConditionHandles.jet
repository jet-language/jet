// Clones share the protocol. ONE native Condition48 from Condition.jet:8-22, not
// an Arc/Box layout alias. Native nominal route admission/seed regeneration is a
// separate composition gate.
#Export(c) jet_rt_handle_clone_jet_condition: fn(value: I64) -> I64 { jet_rt_native_condition_clone(value) }
#Export(c) jet_rt_handle_drop_jet_condition: fn(value: I64) {
    if (value != I64{0}) -> jet_rt_native_condition_drop(value)
}
