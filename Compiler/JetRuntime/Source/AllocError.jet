// Core/Mem AllocError {requested_bytes: Int, allocator: String}: the record
// Lower's fallible-capacity helpers build (Builtins.jet, Lists.jet, Atomic.jet)
// and read back field by field. Box16 is requested_bytes (i64 word) at 0 and
// the owned allocator text at 8.
ALLOC_ERROR_BYTES: I64{16}
ALLOC_ERROR_REQUESTED: I64{0}
ALLOC_ERROR_ALLOCATOR: I64{8}

#Export(c) jet_rt_record_new_alloc_error: fn(requested_bytes: I64, allocator: I64) -> I64 {
    raw: jet_int_owned_to_i64(requested_bytes)
    if (jet_scheduler_native_propagate() != I64{0}) -> return I64{0}
    value: jet_rt_alloc(ALLOC_ERROR_BYTES, I64{8})
    dyn_store(wrapping(value + ALLOC_ERROR_REQUESTED), raw)
    dyn_store(wrapping(value + ALLOC_ERROR_ALLOCATOR), jet_rt_string_clone(allocator))
    value
}
#Export(c) jet_rt_record_get_alloc_error_requested_bytes: fn(value: I64) -> I64 { jet_int_owned_from_i64(dyn_word(wrapping(value + ALLOC_ERROR_REQUESTED))) }
#Export(c) jet_rt_record_get_alloc_error_allocator: fn(value: I64) -> I64 { jet_rt_string_clone(dyn_word(wrapping(value + ALLOC_ERROR_ALLOCATOR))) }
#Export(c) jet_rt_handle_clone_alloc_error: fn(value: I64) -> I64 {
    result: jet_rt_alloc(ALLOC_ERROR_BYTES, I64{8})
    dyn_store(wrapping(result + ALLOC_ERROR_REQUESTED), dyn_word(wrapping(value + ALLOC_ERROR_REQUESTED)))
    dyn_store(wrapping(result + ALLOC_ERROR_ALLOCATOR), jet_rt_string_clone(dyn_word(wrapping(value + ALLOC_ERROR_ALLOCATOR))))
    result
}
#Export(c) jet_rt_handle_drop_alloc_error: fn(value: I64) {
    if (value == I64{0}) -> return
    jet_rt_string_drop(dyn_word(wrapping(value + ALLOC_ERROR_ALLOCATOR)))
    jet_rt_free(value, ALLOC_ERROR_BYTES, I64{8})
}
#Export(c) jet_rt_handle_eq_alloc_error: fn(left: I64, right: I64) -> Bool {
    if dyn_word(wrapping(left + ALLOC_ERROR_REQUESTED)) != dyn_word(wrapping(right + ALLOC_ERROR_REQUESTED)) -> return false
    jet_rt_string_eq(dyn_word(wrapping(left + ALLOC_ERROR_ALLOCATOR)), dyn_word(wrapping(right + ALLOC_ERROR_ALLOCATOR)))
}
// AllocError JetShow, which its Display and Debug repeat: `AllocError {
// requested_bytes: <i64>, allocator: <String {:?}> }`.
#Export(c) jet_rt_handle_show_alloc_error: fn(value: I64) -> I64 {
    target: jet_rt_string_builder_new()
    jet_rt_string_builder_push(target, rt_static_text("AllocError {{ requested_bytes: "))
    rt_text_push_number(target, dyn_word(wrapping(value + ALLOC_ERROR_REQUESTED)))
    jet_rt_string_builder_push(target, rt_static_text(", allocator: "))
    rt_text_push_debug_str(target, dyn_word(wrapping(value + ALLOC_ERROR_ALLOCATOR)), true)
    jet_rt_string_builder_push(target, rt_static_text(" }}"))
    jet_rt_string_builder_finish(target)
}
#Export(c) jet_rt_handle_display_alloc_error: fn(value: I64) -> I64 { jet_rt_handle_show_alloc_error(value) }
#Export(c) jet_rt_handle_debug_alloc_error: fn(value: I64) -> I64 { jet_rt_handle_show_alloc_error(value) }
