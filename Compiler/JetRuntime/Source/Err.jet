// Outcome.rs:100-254 canonical native Err88 ownership. Public three-field
// source shape is NEVER the native carrier. ErrLayout.jet is the shared ABI.
fn err_zero(value: I64, bytes: I64) {
    at := I64{0}
    loop at < bytes {
        rt_text_store(value + at, I64{0})
        at += I64{8}
    }
}
fn err_text_clone(value: I64) -> I64 {
    if (value == I64{0}) -> I64{0} else -> jet_rt_string_clone(value)
}
fn err_text_eq(left: I64, right: I64) -> Bool {
    if (left == I64{0} || right == I64{0}) -> return left == right
    rt_text_len(left) == rt_text_len(right) && rt_text_equal_bytes(rt_text_data(left), rt_text_data(right), rt_text_len(left))
}
// Inline List24 [len,capacity,data], rows contain two E4s then scalar words.
// Used by Context24/Conversion16/Field16; their values are not opaque handles.
fn err_rows_clone(source: I64, target: I64, stride: I64) {
    count :: rt_text_word(source)
    data :: if (count == I64{0}) -> I64{0} else -> jet_rt_alloc(count * stride, I64{8})
    rt_text_store(target, count)
    rt_text_store(target + I64{8}, count)
    rt_text_store(target + I64{16}, data)
    row := I64{0}
    loop row < count {
        old :: rt_text_word(source + I64{16}) + row * stride
        fresh :: data + row * stride
        rt_text_store(fresh, err_text_clone(rt_text_word(old)))
        rt_text_store(fresh + I64{8}, err_text_clone(rt_text_word(old + I64{8})))
        at := I64{16}
        loop at < stride {
            rt_text_store(fresh + at, rt_text_word(old + at))
            at += I64{8}
        }
        row += I64{1}
    }
}
fn err_rows_drop(list: I64, stride: I64) {
    data :: rt_text_word(list + I64{16})
    count :: rt_text_word(list)
    row := I64{0}
    loop row < count {
        jet_rt_string_drop(rt_text_word(data + row * stride))
        jet_rt_string_drop(rt_text_word(data + row * stride + I64{8}))
        row += I64{1}
    }
    if (data != I64{0}) -> jet_rt_free(data, rt_text_word(list + I64{8}) * stride, I64{8})
}
fn err_rows_eq(left: I64, right: I64, stride: I64) -> Bool {
    count :: rt_text_word(left)
    if count != rt_text_word(right) -> return false
    row := I64{0}
    loop row < count {
        a :: rt_text_word(left + I64{16}) + row * stride
        b :: rt_text_word(right + I64{16}) + row * stride
        if !err_text_eq(rt_text_word(a), rt_text_word(b)) || !err_text_eq(rt_text_word(a + I64{8}), rt_text_word(b + I64{8})) -> return false
        at := I64{16}
        loop at < stride {
            if rt_text_word(a + at) != rt_text_word(b + at) -> return false
            at += I64{8}
        }
        row += I64{1}
    }
    true
}
fn err_rows_append(list: I64, stride: I64) -> I64 {
    count :: rt_text_word(list)
    capacity :: rt_text_word(list + I64{8})
    data := rt_text_word(list + I64{16})
    if count == capacity {
        next_capacity :: if (capacity == I64{0}) -> I64{4} else -> capacity * I64{2}
        if (next_capacity < capacity || next_capacity > I64{9223372036854775807} /% stride) { rt_text_capacity_stop() }
        fresh :: jet_rt_alloc(next_capacity * stride, I64{8})
        rt_text_bytes_copy(fresh, data, count * stride)
        if (data != I64{0}) -> jet_rt_free(data, capacity * stride, I64{8})
        data = fresh
        rt_text_store(list + I64{8}, next_capacity)
        rt_text_store(list + I64{16}, data)
    }
    rt_text_store(list, count + I64{1})
    data + count * stride
}
fn err_new_take(message: I64, code: I64, cause: I64) -> I64 {
    result :: jet_rt_alloc(ERR_BYTES, I64{8})
    err_zero(result, ERR_BYTES)
    rt_text_store(result + ERR_MESSAGE, message)
    rt_text_store(result + ERR_CODE, code)
    rt_text_store(result + ERR_CAUSE, cause)
    result
}
// CAbi.rs:372-377: borrow+clone message/code, TAKE cause, borrow option box.
#Export(c) fn jet_rt_record_new_jet_err(message: I64, code: I64, cause: I64) -> I64 {
    err_new_take(jet_rt_string_clone(message), if (code == I64{0}) -> I64{0} else -> jet_rt_string_clone(rt_text_word(code)), cause)
}
#Export(c) fn jet_err_from_message(message: I64) -> I64 {
    err_new_take(jet_rt_string_clone(message), I64{0}, I64{0})
}
#Export(c) fn jet_rt_record_get_jet_err_message(error: I64) -> I64 { jet_rt_string_clone(rt_text_word(error + ERR_MESSAGE)) }
#Export(c) fn jet_rt_record_get_jet_err_code(error: I64, some: I64) -> I64 {
    code :: rt_text_word(error + ERR_CODE)
    if (code == I64{0}) -> return I64{0}
    rt_text_store(some, jet_rt_string_clone(code))
    I64{1}
}
#Export(c) fn jet_rt_record_get_jet_err_cause(error: I64, some: I64) -> I64 {
    cause :: rt_text_word(error + ERR_CAUSE)
    if (cause == I64{0}) -> return I64{0}
    rt_text_store(some, jet_rt_handle_clone_jet_err(cause))
    I64{1}
}
fn err_details_clone(value: I64) -> I64 {
    if (value == I64{0}) -> return I64{0}
    result :: jet_rt_alloc(ERR_DETAILS_BYTES, I64{8})
    rt_text_store(result + ERR_DETAILS_VARIANT, jet_rt_string_clone(rt_text_word(value + ERR_DETAILS_VARIANT)))
    err_rows_clone(value + ERR_DETAILS_FIELDS, result + ERR_DETAILS_FIELDS, ERR_FIELD_BYTES)
    rt_text_store(result + ERR_DETAILS_HAS_SPAN, rt_text_word(value + ERR_DETAILS_HAS_SPAN))
    rt_text_store(result + ERR_DETAILS_START, rt_text_word(value + ERR_DETAILS_START))
    rt_text_store(result + ERR_DETAILS_END, rt_text_word(value + ERR_DETAILS_END))
    result
}
#Export(c) fn jet_rt_handle_clone_jet_err(value: I64) -> I64 {
    if (value == I64{0}) -> return I64{0}
    result :: err_new_take(err_text_clone(rt_text_word(value + ERR_MESSAGE)), err_text_clone(rt_text_word(value + ERR_CODE)), jet_rt_handle_clone_jet_err(rt_text_word(value + ERR_CAUSE)))
    rt_text_store(result + ERR_IDENTITY, err_text_clone(rt_text_word(value + ERR_IDENTITY)))
    err_rows_clone(value + ERR_CONTEXT, result + ERR_CONTEXT, ERR_CONTEXT_BYTES)
    err_rows_clone(value + ERR_CONVERSIONS, result + ERR_CONVERSIONS, ERR_CONVERSION_BYTES)
    rt_text_store(result + ERR_DETAILS, err_details_clone(rt_text_word(value + ERR_DETAILS)))
    result
}
#Export(c) fn jet_rt_handle_drop_jet_err(value: I64) {
    if (value == I64{0}) -> return
    jet_rt_string_drop(rt_text_word(value + ERR_MESSAGE))
    jet_rt_string_drop(rt_text_word(value + ERR_CODE))
    jet_rt_handle_drop_jet_err(rt_text_word(value + ERR_CAUSE))
    jet_rt_string_drop(rt_text_word(value + ERR_IDENTITY))
    err_rows_drop(value + ERR_CONTEXT, ERR_CONTEXT_BYTES)
    err_rows_drop(value + ERR_CONVERSIONS, ERR_CONVERSION_BYTES)
    details :: rt_text_word(value + ERR_DETAILS)
    if (details != I64{0}) {
        jet_rt_string_drop(rt_text_word(details + ERR_DETAILS_VARIANT))
        err_rows_drop(details + ERR_DETAILS_FIELDS, ERR_FIELD_BYTES)
        jet_rt_free(details, ERR_DETAILS_BYTES, I64{8})
    }
    jet_rt_free(value, ERR_BYTES, I64{8})
}
#Export(c) fn jet_rt_handle_eq_jet_err(left: I64, right: I64) -> Bool {
    if (left == I64{0} || right == I64{0}) -> return left == right
    if !err_text_eq(rt_text_word(left + ERR_MESSAGE), rt_text_word(right + ERR_MESSAGE)) || !err_text_eq(rt_text_word(left + ERR_CODE), rt_text_word(right + ERR_CODE)) || !err_text_eq(rt_text_word(left + ERR_IDENTITY), rt_text_word(right + ERR_IDENTITY)) -> return false
    if !jet_rt_handle_eq_jet_err(rt_text_word(left + ERR_CAUSE), rt_text_word(right + ERR_CAUSE)) -> return false
    if !err_rows_eq(left + ERR_CONTEXT, right + ERR_CONTEXT, ERR_CONTEXT_BYTES) || !err_rows_eq(left + ERR_CONVERSIONS, right + ERR_CONVERSIONS, ERR_CONVERSION_BYTES) -> return false
    a :: rt_text_word(left + ERR_DETAILS)
    b :: rt_text_word(right + ERR_DETAILS)
    if (a == I64{0} || b == I64{0}) -> return a == b
    if !err_text_eq(rt_text_word(a + ERR_DETAILS_VARIANT), rt_text_word(b + ERR_DETAILS_VARIANT)) || !err_rows_eq(a + ERR_DETAILS_FIELDS, b + ERR_DETAILS_FIELDS, ERR_FIELD_BYTES) -> return false
    if rt_text_word(a + ERR_DETAILS_HAS_SPAN) != rt_text_word(b + ERR_DETAILS_HAS_SPAN) -> return false
    if (rt_text_word(a + ERR_DETAILS_HAS_SPAN) == I64{0}) -> return true
    rt_text_word(a + ERR_DETAILS_START) == rt_text_word(b + ERR_DETAILS_START) && rt_text_word(a + ERR_DETAILS_END) == rt_text_word(b + ERR_DETAILS_END)
}
// Values.rs:317-330: JetDisplay, JetShow and JetDebug all return message only;
// Outcome's root report is a separate operation, never these trait adapters.
#Export(c) fn jet_rt_handle_display_jet_err(value: I64) -> I64 { jet_rt_record_get_jet_err_message(value) }
#Export(c) fn jet_rt_handle_show_jet_err(value: I64) -> I64 { jet_rt_record_get_jet_err_message(value) }
#Export(c) fn jet_rt_handle_debug_jet_err(value: I64) -> I64 { jet_rt_record_get_jet_err_message(value) }
#Export(c) fn jet_err_apply_conversion(value: I64, source: I64, target: I64) -> I64 {
    result :: jet_rt_handle_clone_jet_err(value)
    if (rt_text_word(result + ERR_IDENTITY) == I64{0}) -> rt_text_store(result + ERR_IDENTITY, jet_rt_string_clone(source))
    row :: err_rows_append(result + ERR_CONVERSIONS, ERR_CONVERSION_BYTES)
    rt_text_store(row, jet_rt_string_clone(source))
    rt_text_store(row + I64{8}, jet_rt_string_clone(target))
    result
}
