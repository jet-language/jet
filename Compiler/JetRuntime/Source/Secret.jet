// Native Secret owns exactly one native List<U8> header, never a Rust Vec.
// Lists.jet/Values.jet define [len,cap,data]; U8 uses RT_HOST_U8_STRIDE.
// Borrowed .bytes access returns this header; indexed Write stays within len.
// No List length-changing operation is permitted while it is a Secret owner.

// One byte-count contract governs the native List allocation, wipe, and free.
fn rt_secret_buffer_bytes(capacity: I64) -> I64 { wrapping(capacity * RT_HOST_U8_STRIDE) }

fn rt_secret_zero(address: I64, bytes: I64) {
    at := I64{0}
    #Unsafe("address names the caller-owned live Secret buffer; effectful asm stores wipe every byte including spare capacity before release") {
        loop at < bytes {
            os_store_u8(wrapping(address + at), I64{0})
            at = wrapping(at + I64{1})
        }
    }
}

// The live Secrets, for the scrub a process end runs (#5478). secret_root
// holds one word: the first registry page, or 0 before any Secret. A page is
// a never-freed 4 KiB mapping: word 0 links the next page, words 1..511 each
// hold one live Secret header or 0. Adoption claims a 0 word by CAS and Close
// clears the header's word, so jet_rt_secret_scrub walks the chain with no
// lock and no allocation, as a fatal-signal handler must.
secret_root := I64{0}

// runtime-init: 3
#Export(c) fn jet_rt_secret_init() {
    if (secret_root != I64{0}) -> return
    root :: jet_rt_alloc(I64{8}, I64{8})
    sync_store(root, I64{0})
    secret_root = root
}

fn secret_register(secret: I64) {
    if (secret_root == I64{0}) -> return
    link := secret_root
    loop {
        page := sync_load(link)
        if (page == I64{0}) {
            fresh :: alloc_map_try(I64{4096})
            // No page: the Secret stays, only its crash scrub is lost.
            if (fresh == I64{0}) -> return
            page = sync_cas(link, I64{0}, fresh)
            if (page == I64{0}) {
                page = fresh
            } else {
                alloc_unmap(fresh, I64{4096})
            }
        }
        word := wrapping(page + I64{8})
        loop word < wrapping(page + I64{4096}) {
            if (sync_load(word) == I64{0} && sync_cas(word, I64{0}, secret) == I64{0}) -> return
            word = wrapping(word + I64{8})
        }
        link = page
    }
}

fn secret_unregister(secret: I64) {
    if (secret_root == I64{0}) -> return
    page := sync_load(secret_root)
    loop page != (I64{0}) {
        word := wrapping(page + I64{8})
        loop word < wrapping(page + I64{4096}) {
            if (sync_load(word) == secret) {
                sync_store(word, I64{0})
                return
            }
            word = wrapping(word + I64{8})
        }
        page = sync_load(page)
    }
}

// Zero every live Secret's bytes: the last act of a process that ends
// without its drops (an exit, a stop, a normal return with no task left, a
// fatal signal, an abort). Loads and stores only. The process is ending from
// here, so frees are no-ops and a buffer another thread's Close releases
// meanwhile stays mapped.
fn secret_scrub() {
    main_process_end()
    if (secret_root == I64{0}) -> return
    page := sync_load(secret_root)
    loop page != (I64{0}) {
        word := wrapping(page + I64{8})
        loop word < wrapping(page + I64{4096}) {
            secret :: sync_load(word)
            if (secret != I64{0}) {
                #Unsafe("secret is a registered live Secret header (Close unregisters before it clears); its buffer holds capacity bytes") {
                    rt_secret_zero(os_load_i64(wrapping(secret + I64{16})), rt_secret_buffer_bytes(os_load_i64(wrapping(secret + I64{8}))))
                }
            }
            word = wrapping(word + I64{8})
        }
        page = sync_load(page)
    }
}

// Keep a Secret buffer's pages out of core dumps (madvise MADV_DONTDUMP) and
// swap (mlock), best effort: a refused call (RLIMIT_MEMLOCK) changes nothing
// else. The pages stay so after Close, with any other block on them.
fn secret_guard_pages(data: I64, bytes: I64) {
    if (bytes == I64{0}) -> return
    start :: data.bit_and(I64{-4096})
    length :: wrapping(wrapping(wrapping(data + bytes) + I64{4095}).bit_and(I64{-4096}) - start)
    #Unsafe("start..start+length covers the Secret buffer's mapped pages; madvise and mlock change only their dump and residency attributes") {
        _ := os_syscall_i64(I64{28}, start, length, I64{16}, I64{0}, I64{0}, I64{0})
        _ := os_syscall_i64(I64{149}, start, length, I64{0}, I64{0}, I64{0}, I64{0})
    }
}

// The compiler transfers the complete List header and invalidates the moved
// input. Its header still belongs to its former holder's storage, not us.
// The Secret wipes and frees the buffer it holds, so it holds a buffer no
// one else does: a shared buffer (another List still reads it) or a frozen
// one (static bytes) is copied, and the moved header's reference released.
#Export(c)
fn jet_rt_secret_from_bytes(bytes: I64) -> I64 {
    secret :: jet_rt_alloc(I64{24}, I64{8})
    length := I64{0}
    capacity := I64{0}
    data := I64{0}
    #Unsafe("bytes is the moved native List<U8> header; secret is fresh aligned24B storage and takes over its buffer reference without copying secret material") {
        length = os_load_i64(bytes)
        capacity = os_load_i64(wrapping(bytes + I64{8}))
        data = os_load_i64(wrapping(bytes + I64{16}))
        os_store_i64(bytes, I64{0})
        os_store_i64(wrapping(bytes + I64{8}), I64{0})
        os_store_i64(wrapping(bytes + I64{16}), I64{0})
    }
    if ((capacity == I64{0} && length != I64{0}) || (capacity != I64{0} && !jet_rt_block_unique(data))) {
        own := I64{0}
        if (length != I64{0}) {
            own = jet_rt_alloc(rt_secret_buffer_bytes(length), I64{8})
            coll_copy(data, own, rt_secret_buffer_bytes(length))
        }
        // U8 elements own nothing: the last owner only frees the buffer.
        if (capacity != I64{0} && jet_rt_block_release(data)) -> jet_rt_free(data, rt_secret_buffer_bytes(capacity), I64{8})
        data = own
        capacity = length
    }
    #Unsafe("secret is fresh aligned24B storage this call owns exclusively") {
        os_store_i64(secret, length)
        os_store_i64(wrapping(secret + I64{8}), capacity)
        os_store_i64(wrapping(secret + I64{16}), data)
    }
    if (capacity != I64{0}) {
        secret_guard_pages(data, rt_secret_buffer_bytes(capacity))
        secret_register(secret)
    }
    secret
}

// Both read and fixed-length Write borrow the real parent's List header.
// The caller's loan prevents Close/drop for the complete borrowed use.
#Export(c)
fn jet_rt_secret_bytes(secret: I64) -> I64 { secret }

#Export(c)
fn jet_rt_secret_close(secret: I64) {
    #Unsafe("secret is a live exclusively borrowed native24B Secret header; len/cap/data follow the native List layout and all byte owners remain inside its buffer") {
        capacity :: os_load_i64(wrapping(secret + I64{8}))
        data :: os_load_i64(wrapping(secret + I64{16}))
        bytes :: rt_secret_buffer_bytes(capacity)
        // Out of the crash scrub's reach before the buffer is cleared.
        if (capacity != I64{0}) -> secret_unregister(secret)
        // Match zeroize1.9.0 Vec<Z>::zeroize (lib.rs520-537): clear
        // initialized elements AND spare capacity. A List may have been shrunk
        // before adoption, leaving secret bytes past its current length.
        rt_secret_zero(data, bytes)
        // Clear before freeing, so an explicit second Close is harmless.
        os_store_i64(secret, I64{0})
        os_store_i64(wrapping(secret + I64{8}), I64{0})
        os_store_i64(wrapping(secret + I64{16}), I64{0})
        if (capacity != I64{0}) -> jet_rt_free(data, bytes, I64{8})
    }
}

// Explicit Close retains the header. Only final owner drop frees it, once.
#Export(c)
fn jet_rt_secret_drop(secret: I64) {
    jet_rt_secret_close(secret)
    jet_rt_free(secret, I64{24}, I64{8})
}
