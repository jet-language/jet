// Native Secret owns exactly one native [U8] header.
// Lists.jet/Values.jet define [len,cap,data]; U8 uses RT_HOST_U8_STRIDE.
// Borrowed .bytes access returns this header; indexed Write stays within len.
// No List length-changing operation is permitted while it is a Secret owner.

// One byte-count contract governs the native List allocation, wipe, and free.
rt_secret_buffer_bytes: fn(capacity: I64) -> I64 { wrapping(capacity * RT_HOST_U8_STRIDE) }

// Secret Close, crypto.wipe and the allocator's zero-at-free mark share this
// wipe. Each byte is an effectful asm store, so no optimization drops it.
priv rt_wipe_bytes: fn(address: I64, bytes: I64) {
    at := I64{0}
    #Unsafe("address names bytes bytes of live storage the caller owns or is freeing; effectful asm stores wipe every byte before release or reuse") {
        loop at < bytes {
            os_store_u8(wrapping(address + at), I64{0})
            at = wrapping(at + I64{1})
        }
    }
}

// The live Secrets, for the scrub a process end runs (#5478). secret_root
// holds one word: the first registry page, or 0 before any Secret. A page is
// a never-freed 4 KiB mapping: word 0 links the next page, words 1..511 each
// hold one live native Secret header, a core.crypto.Secret's record of its
// header (jet_rt_crypto_secret_keep), or 0. Adoption claims a 0 word by CAS
// and Close clears the header's word, so jet_rt_secret_scrub walks the chain
// with no lock and no allocation, as a fatal-signal handler must.
secret_root := I64{0}

// jet_rt_secret_scrub, installed by jet_rt_secret_init: a program that
// keeps no Secret has none to scrub, so its process end links no scrub.
secret_scrub_code := I64{0}

// runtime-init: 3 when secret_root
#Export(c) jet_rt_secret_init: fn() {
    if (secret_root != I64{0}) {
        return
    }
    root: jet_rt_alloc(I64{8}, I64{8})
    sync_store(root, I64{0})
    #Unsafe("runtime-init runs before any other thread exists") {
        secret_root = root
        secret_scrub_code = rt_secret_scrub_address()
    }
}

rt_secret_scrub_address: fn() -> I64 {
    // Native-approved RuntimeLibrary FunctionAddress intrinsic (arity 1).
    loop { jet_rt_unreachable(I64{0}, I64{0}) }
}

secret_register: fn(secret: I64) {
    if (secret_root == I64{0}) {
        return
    }
    link := secret_root
    loop {
        page := sync_load(link)
        if (page == I64{0}) {
            // Untracked: the crash scrub reads the registry where allocating
            // is not allowed, and no checked code reads it.
            fresh: alloc_map_try(I64{4096})
            // No page: the Secret stays, only its crash scrub is lost.
            if (fresh == I64{0}) {
                return
            }
            page = sync_cas(link, I64{0}, fresh)
            if (page == I64{0}) { page = fresh } else { alloc_unmap(fresh, I64{4096}) }
        }
        word := wrapping(page + I64{8})
        loop word < wrapping(page + I64{4096}) {
            if (sync_load(word) == I64{0} && sync_cas(word, I64{0}, secret) == I64{0}) {
                return
            }
            word = wrapping(word + I64{8})
        }
        link = page
    }
}

secret_unregister: fn(secret: I64) {
    if (secret_root == I64{0}) {
        return
    }
    page := sync_load(secret_root)
    loop page != (I64{0}) {
        word := wrapping(page + I64{8})
        loop word < wrapping(page + I64{4096}) {
            if (sync_load(word) == secret) {
                sync_store(word, I64{0})
                return
            }
            word = wrapping(word + I64{8})
        }
        page = sync_load(page)
    }
}

// crypto.__secret_keep(bytes) (BuildRoutes.jet ir_core_crypto_header), as a
// core.crypto.Secret is made: its bytes join the live Secrets a dump redacts
// and a process end scrubs, as a 24-byte record of the written native [U8]
// header's [len, cap, data] words; no byte of the buffer is read. Frozen
// static bytes (capacity 0) are redacted and never scrubbed. The Secret's
// Close wipes the buffer through jet_rt_crypto_wipe, which drops the record
// (secret_forget). An empty List keeps nothing.
#Export(c) jet_rt_crypto_secret_keep: fn(header: I64) {
    if (secret_root == I64{0}) {
        return
    }
    length: trap_word(header)
    capacity: trap_word(wrapping(header + I64{8}))
    if (capacity == I64{0} && length == I64{0}) {
        return
    }
    record: jet_rt_alloc(I64{24}, I64{8})
    sync_store(record, length)
    sync_store(wrapping(record + I64{8}), capacity)
    sync_store(wrapping(record + I64{16}), trap_word(wrapping(header + I64{16})))
    secret_register(record)
}

// Drop one record jet_rt_crypto_secret_keep made for the buffer at `data`,
// as crypto.wipe takes that buffer from the List `header`. A native Secret's
// own header (`header` itself) stays registered: its Close unregisters it.
secret_forget: fn(header: I64, data: I64) {
    if (secret_root == I64{0} || data == I64{0}) {
        return
    }
    page := sync_load(secret_root)
    loop page != (I64{0}) {
        word := wrapping(page + I64{8})
        loop word < wrapping(page + I64{4096}) {
            record: sync_load(word)
            if (record != I64{0} && record != header && sync_load(wrapping(record + I64{16})) == data && sync_cas(word, record, I64{0}) == record) {
                jet_rt_free(record, I64{24}, I64{8})
                return
            }
            word = wrapping(word + I64{8})
        }
        page = sync_load(page)
    }
}

// Zero every live Secret's bytes: the last act of a process that ends
// without its drops (an exit, a stop, a normal return with no task left, a
// fatal signal, an abort). Loads and stores only. The process is ending from
// here, so frees are no-ops and a buffer another thread's Close releases
// meanwhile stays mapped.
secret_scrub: fn() {
    main_process_end()
    code: secret_scrub_code
    if (code != I64{0}) { _ := coll_call1(code, I64{0}) }
}

// secret_scrub's walk of the live Secrets (secret_scrub_code).
#Export(c) jet_rt_secret_scrub: fn(_unused: I64) -> I64 {
    if (secret_root == I64{0}) { return I64{0} }
    page := sync_load(secret_root)
    loop page != (I64{0}) {
        word := wrapping(page + I64{8})
        loop word < wrapping(page + I64{4096}) {
            secret: sync_load(word)
            if (secret != I64{0}) {
                #Unsafe("secret is a registered live Secret header (Close unregisters before it clears); its buffer holds capacity bytes") {
                    rt_wipe_bytes(os_load_i64(wrapping(secret + I64{16})), rt_secret_buffer_bytes(os_load_i64(wrapping(secret + I64{8}))))
                }
            }
            word = wrapping(word + I64{8})
        }
        page = sync_load(page)
    }
    I64{0}
}

// A dump's redaction of the live Secrets (PerfSamples.jet perf_flight_dump):
// every run of a live Secret's bytes in what it writes is zeroed, and every
// byte of a live Secret's buffer. Loads and stores only, as the scrub. A run
// shorter than SECRET_REDACT_MIN stays: it would zero every like run of the
// dump's code and data; such a Secret's own buffer is still zeroed.
SECRET_REDACT_MIN: I64{4}

// The words of `table` before its entries: the count, then a 256-bit set
// of the entries' first bytes.
SECRET_REDACT_HEAD: I64{40}

// Fill `table` with the live Secrets a dump redacts by their bytes: their
// count, the set of their first bytes, then [data, length] each, at most
// `room` of them, of lengths SECRET_REDACT_MIN through `limit`. The longest
// length among them; 1 when every live Secret is shorter or longer; 0 with
// none live.
secret_redact_table: fn(table: I64, room: I64, limit: I64) -> I64 {
    thread_zero(table, SECRET_REDACT_HEAD)
    if (secret_root == I64{0}) { return I64{0} }
    width := I64{0}
    count := I64{0}
    page := sync_load(secret_root)
    loop page != (I64{0}) {
        word := wrapping(page + I64{8})
        loop word < wrapping(page + I64{4096}) {
            secret: sync_load(word)
            if (secret != I64{0}) {
                if (width == I64{0}) { width = I64{1} }
                length := I64{0}
                data := I64{0}
                #Unsafe("secret is a registered live Secret header; its length and data words are read") {
                    length = os_load_i64(secret)
                    data = os_load_i64(wrapping(secret + I64{16}))
                }
                if (length >= SECRET_REDACT_MIN && length <= limit && count < room) {
                    entry: wrapping(wrapping(table + SECRET_REDACT_HEAD) + wrapping(count * I64{16}))
                    sync_store(entry, data)
                    sync_store(wrapping(entry + I64{8}), length)
                    first: rt_text_byte(data)
                    bits: wrapping(wrapping(table + I64{8}) + wrapping((first >> I64{6}) * I64{8}))
                    sync_store(bits, sync_load(bits) | (I64{1} << (first & I64{63})))
                    count = wrapping(count + I64{1})
                    if (length > width) { width = length }
                }
            }
            word = wrapping(word + I64{8})
        }
        page = sync_load(page)
    }
    sync_store(table, count)
    width
}

// Zero, in the `length` bytes at `buffer` copied from `source`, every run of
// a Secret of `table` (secret_redact_table) that starts in them and ends in
// them, and every byte of a live Secret's buffer. The bytes before `until`
// are the rest of a run an earlier copy found. Each start is matched before
// its byte is zeroed, so runs that overlap are all found. The offset past
// the last run zeroed, at least `until`.
secret_redact: fn(table: I64, buffer: I64, length: I64, source: I64, until: I64) -> I64 {
    count: sync_load(table)
    reach := until
    at := I64{0}
    loop at < length {
        byte: rt_text_byte(wrapping(buffer + at))
        bits: sync_load(wrapping(wrapping(table + I64{8}) + wrapping((byte >> I64{6}) * I64{8})))
        if ((bits >> (byte & I64{63})) & I64{1} != I64{0}) {
            index := I64{0}
            loop index < count {
                entry: wrapping(wrapping(table + SECRET_REDACT_HEAD) + wrapping(index * I64{16}))
                end: wrapping(at + sync_load(wrapping(entry + I64{8})))
                if (end > reach && end <= length && rt_text_equal_bytes(wrapping(buffer + at), sync_load(entry), wrapping(end - at))) {
                    reach = end
                }
                index = wrapping(index + I64{1})
            }
        }
        if (at < reach) { rt_text_put(wrapping(buffer + at), I64{0}) }
        at = wrapping(at + I64{1})
    }
    secret_redact_buffers(buffer, length, source)
    reach
}

// Zero, in the `length` bytes at `buffer` copied from `source`, those that
// were in a live Secret's buffer, its spare capacity too.
secret_redact_buffers: fn(buffer: I64, length: I64, source: I64) {
    if (secret_root == I64{0}) {
        return
    }
    last: wrapping(source + length)
    page := sync_load(secret_root)
    loop page != (I64{0}) {
        word := wrapping(page + I64{8})
        loop word < wrapping(page + I64{4096}) {
            secret: sync_load(word)
            if (secret != I64{0}) {
                data := I64{0}
                capacity := I64{0}
                #Unsafe("secret is a registered live Secret header; its capacity and data words are read") {
                    capacity = os_load_i64(wrapping(secret + I64{8}))
                    data = os_load_i64(wrapping(secret + I64{16}))
                }
                low: if (data > source) -> data else -> source
                high_end: wrapping(data + rt_secret_buffer_bytes(capacity))
                high: if (high_end < last) -> high_end else -> last
                if (low < high) {
                    rt_wipe_bytes(wrapping(buffer + wrapping(low - source)), wrapping(high - low))
                }
            }
            word = wrapping(word + I64{8})
        }
        page = sync_load(page)
    }
}

// Keep a Secret buffer's pages out of core dumps (madvise MADV_DONTDUMP) and
// swap (mlock), best effort: a refused call (RLIMIT_MEMLOCK) changes nothing
// else. The pages stay so after Close, with any other block on them.
secret_guard_pages: fn(data: I64, bytes: I64) {
    if (bytes == I64{0}) {
        return
    }
    start: data & I64{-4096}
    length: wrapping((wrapping(wrapping(data + bytes) + I64{4095}) & I64{-4096}) - start)
    #Unsafe("start..start+length covers the Secret buffer's mapped pages; madvise and mlock change only their dump and residency attributes") {
        _ := os_madvise_i64(start, length, I64{16})
        _ := host_syscall(I64{149}, start, length, I64{0}, I64{0}, I64{0}, I64{0})
    }
}

// The compiler transfers the complete List header and invalidates the moved
// input. Its header still belongs to its former holder's storage, not us.
// The Secret wipes and frees the buffer it holds, so it holds a buffer no
// one else does: a shared buffer (another List still reads it) or a frozen
// one (static bytes) is copied, and the moved header's reference released.
// A shared buffer is marked zero-at-free first, so its secret bytes are
// wiped when its last other owner releases it.
#Export(c) priv jet_rt_secret_from_bytes: fn(bytes: I64) -> I64 {
    secret: jet_rt_alloc(I64{24}, I64{8})
    length := I64{0}
    capacity := I64{0}
    data := I64{0}
    #Unsafe("bytes is the moved native [U8] header; secret is fresh aligned24B storage and takes over its buffer reference without copying secret material") {
        length = os_load_i64(bytes)
        capacity = os_load_i64(wrapping(bytes + I64{8}))
        data = os_load_i64(wrapping(bytes + I64{16}))
        os_store_i64(bytes, I64{0})
        os_store_i64(wrapping(bytes + I64{8}), I64{0})
        os_store_i64(wrapping(bytes + I64{16}), I64{0})
    }
    if ((capacity == I64{0} && length != I64{0}) || (capacity != I64{0} && !jet_rt_block_unique(data))) {
        own := I64{0}
        if (length != I64{0}) {
            own = jet_rt_alloc(rt_secret_buffer_bytes(length), I64{8})
            coll_copy(data, own, rt_secret_buffer_bytes(length))
        }
        // U8 elements own nothing: the last owner only frees the buffer.
        if (capacity != I64{0}) {
            jet_rt_block_mark_zero(data)
            if (jet_rt_block_release(data)) {
                jet_rt_free(data, rt_secret_buffer_bytes(capacity), I64{8})
            }
        }
        data = own
        capacity = length
    }
    #Unsafe("secret is fresh aligned24B storage this call owns exclusively") {
        os_store_i64(secret, length)
        os_store_i64(wrapping(secret + I64{8}), capacity)
        os_store_i64(wrapping(secret + I64{16}), data)
    }
    if (capacity != I64{0}) {
        secret_guard_pages(data, rt_secret_buffer_bytes(capacity))
        secret_register(secret)
    }
    secret
}

// Both read and fixed-length Write borrow the real parent's List header.
// The caller's loan prevents Close/drop for the complete borrowed use.
#Export(c) jet_rt_secret_bytes: fn(secret: I64) -> I64 { secret }

#Export(c) priv jet_rt_secret_close: fn(secret: I64) {
    #Unsafe("secret is a live exclusively borrowed native24B Secret header; len/cap/data follow the native List layout and all byte owners remain inside its buffer") {
        capacity: os_load_i64(wrapping(secret + I64{8}))
        data: os_load_i64(wrapping(secret + I64{16}))
        bytes: rt_secret_buffer_bytes(capacity)
        // Out of the crash scrub's reach before the buffer is cleared.
        if (capacity != I64{0}) { secret_unregister(secret) }
        // Match zeroize1.9.0 Vec<Z>.zeroize: clear initialized elements AND
        // spare capacity. A List may have been shrunk before adoption, leaving
        // secret bytes past its current length.
        rt_wipe_bytes(data, bytes)
        // Clear before freeing, so an explicit second Close is harmless.
        os_store_i64(secret, I64{0})
        os_store_i64(wrapping(secret + I64{8}), I64{0})
        os_store_i64(wrapping(secret + I64{16}), I64{0})
        if (capacity != I64{0}) { jet_rt_free(data, bytes, I64{8}) }
    }
}

// Explicit Close retains the header. Only final owner drop frees it, once.
#Export(c) jet_rt_secret_drop: fn(secret: I64) {
    jet_rt_secret_close(secret)
    jet_rt_free(secret, I64{24}, I64{8})
}
