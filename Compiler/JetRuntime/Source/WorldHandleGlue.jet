// Clones share the world state and its condition variable, never deep-copy
// it. The existing native producer World.jet18/425 owns
// World144 refs0; its callbacks and all world routes use this pointer. Core's
// `DeterministicWorld` struct carries the pointer as its `priv handle`, and
// its methods' jet.runtime.testing leaves take it. Reuse the existing native
// leases.
#Export(c) jet_rt_handle_clone_jet_deterministic_world: fn(value: I64) -> I64 {
    jet_rt_world_clone(value)
}

#Export(c) jet_rt_handle_drop_jet_deterministic_world: fn(value: I64) { jet_rt_world_drop(value) }
