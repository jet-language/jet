// CAbiRoutes8223-8232 List.Byte four-route family. Existing DataSequences
// 6d4fa9ba6 supplies native List24 geometry/reserve/index checks at composition.
// Byte payloads are packed stride1, not word lanes; capacity/length are raw
// machine counts, and u64 item conversion is checked before any mutation.
#Export(c) jet_rt_record_seq_list_byte_new: fn(capacity: I64) -> I64 {
    data_sequence_new(capacity, RT_HOST_U8_STRIDE)
}
#Export(c) jet_rt_record_seq_list_byte_len: fn(value: I64) -> I64 {
    rt_text_word(wrapping(value + DATA_SEQUENCE_LENGTH))
}
#Export(c) jet_rt_record_seq_list_byte_get: fn(value: I64, index: I64) -> U64 {
    wrapping(U64{rt_text_byte(data_sequence_slot(value, index, RT_HOST_U8_STRIDE))})
}
#Export(c) jet_rt_record_seq_list_byte_push: fn(value: I64, item: U64) {
    if (item > U64{255}) -> trap_native_index_range_stop()
    slot: data_sequence_reserve(value, RT_HOST_U8_STRIDE)
    rt_text_put(slot, wrapping(I64{item}))
    rt_text_store(wrapping(value + DATA_SEQUENCE_LENGTH), rt_text_word(wrapping(value + DATA_SEQUENCE_LENGTH)) + I64{1})
}
