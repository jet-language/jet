// CAbiRoutes8223-8232 List.Byte four-route family. Existing DataSequences
// 6d4fa9ba6 supplies native List24 geometry/reserve/index checks at composition.
// Byte payloads are packed stride1, not word lanes; capacity/length are raw
// machine counts, and u64 item conversion is checked before any mutation.
#Export(c) fn jet_rt_record_seq_list_byte_new(capacity: I64) -> I64 {
    data_sequence_new(capacity, RT_HOST_U8_STRIDE)
}
#Export(c) fn jet_rt_record_seq_list_byte_len(value: I64) -> I64 {
    rt_text_word(value + DATA_SEQUENCE_LENGTH)
}
#Export(c) fn jet_rt_record_seq_list_byte_get(value: I64, index: I64) -> U64 {
    U64{rt_text_byte(data_sequence_slot(value, index, RT_HOST_U8_STRIDE))}
}
#Export(c) fn jet_rt_record_seq_list_byte_push(value: I64, item: U64) {
    if (item > U64{255}) -> trap_native_index_range_stop()
    slot :: data_sequence_reserve(value, RT_HOST_U8_STRIDE)
    rt_text_put(slot, I64{item})
    rt_text_store(value + DATA_SEQUENCE_LENGTH, rt_text_word(value + DATA_SEQUENCE_LENGTH) + I64{1})
}
