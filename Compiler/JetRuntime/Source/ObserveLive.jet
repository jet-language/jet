// Observe.rs:285-320,344-380,387-541. Native records contain only the
// canonical identity/decision/event metadata, never payloads or Rust layouts.
// Writer120: mutex0, exited8, sequence16, started24, CPU-present32/CPU40,
// start-id48, identity56..88, directory96, path104, periodic-started112.
// Value48: next0, canonical five E4 fields8..40 (rendered0 means None).
// Event128: next0, canonical fifteen fields8..120, five owned E4 strings.
fn observe_text_clone(value: I64) -> I64 {
    if value == (I64{0}) -> return I64{0}
    rt_text_copy(rt_text_data(value), rt_text_len(value))
}
fn observe_text_cmp(a: I64, b: I64) -> I64 {
    al :: rt_text_len(a)
    bl :: rt_text_len(b)
    at := I64{0}
    loop at < al && at < bl {
        av :: trap_byte(rt_text_data(a) + at)
        bv :: trap_byte(rt_text_data(b) + at)
        if av != bv -> return av - bv
        at += I64{1}
    }
    al - bl
}
fn observe_text_controls(value: I64) -> Bool {
    if value == (I64{0}) -> return false
    at := I64{0}
    loop at < rt_text_len(value) {
        cp :: rt_text_decode(rt_text_data(value) + at)
        if cp < (I64{32}) || (cp >= I64{127} && cp <= I64{159}) -> return true
        at += rt_text_width(rt_text_data(value) + at)
    }
    false
}
fn observe_value_drop(node: I64) {
    at := I64{8}
    loop at <= (I64{40}) {
        text :: sync_load(node + at)
        if text != (I64{0}) -> jet_rt_string_drop(text)
        at += I64{8}
    }
    jet_rt_free(node, I64{48}, I64{8})
}
// The source carrier has exactly Foundation's JetLiveValueDecision fields:
// value_id/type_identity/disposition/reason/rendered_value. Retain by copying
// E4 text; the producer continues owning its source and optional text owner.
#Export(c) fn jet_observe_record_live_value(source: I64) {
    sync_mutex_lock(observe_root)
    link := observe_root + I64{112}
    id :: sync_load(source)
    previous := I64{0}
    loop sync_load(link) != (I64{0}) {
        node :: sync_load(link)
        order :: observe_text_cmp(sync_load(node + I64{8}), id)
        if order >= (I64{0}) {
            if order == (I64{0}) -> previous = node
            break
        }
        link = node
    }
    if previous == (I64{0}) && sync_load(observe_root + I64{120}) >= (I64{4096}) {
        sync_mutex_unlock(observe_root)
        return
    }
    node :: jet_rt_alloc(I64{48}, I64{8})
    sync_store(node, if previous == (I64{0}) -> sync_load(link) else -> sync_load(previous))
    at := I64{0}
    loop at < (I64{40}) {
        sync_store(node + at + I64{8}, observe_text_clone(sync_load(source + at)))
        at += I64{8}
    }
    sync_store(link, node)
    if previous == (I64{0}) -> _ := sync_add(observe_root + I64{120}, I64{1})
    sync_mutex_unlock(observe_root)
    if previous != (I64{0}) -> observe_value_drop(previous)
}
fn observe_event_text_field(offset: I64) -> Bool {
    offset == I64{8} || offset == I64{48} || offset == I64{88} || offset == I64{104} || offset == I64{112}
}
fn observe_event_drop(node: I64) {
    at := I64{0}
    loop at < (I64{120}) {
        if observe_event_text_field(at) -> jet_rt_string_drop(sync_load(node + at + I64{8}))
        at += I64{8}
