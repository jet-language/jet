// Observe.rs:285-320,344-380,387-541. Native records contain only the
// canonical identity/event metadata, never payloads or Rust layouts.
// Writer120: mutex0, exited8, sequence16, started24, CPU-ticks32, clock-hz40,
// boot-ns48, identity56..88, directory96, path104, periodic-started112.
// Value48: next0, canonical five E4 fields8..40 (rendered0 means None).
// Event128: next0, canonical fifteen fields8..120, five owned E4 strings.
//
// The published snapshot is raw facts, not a rendered view (D-SIZE-PAYUSE1
// A); `jet inspect` (JetCli LiveSnapshot.jet) validates and renders them.
// Little-endian words, then sections:
//   magic "JETLIVE1", sequence, pid, captured unix ms (0 when the clock
//   fails), elapsed ns since the run started, boot-clock ns when the writer
//   started, CPU ticks (times(2)) when the run started, AT_CLKTCK, exit,
//   arenas, arena allocations, arena bytes, workers, queued; the five
//   identity texts.
//   Sections, each a tag word and a record count: 1 tasks (id, parent,
//   spawn site, state, deadline present, deadline, cancelled; label and
//   wait texts), 2 channels (id, depth, bounded, capacity, send and receive
//   waiters, closed), 3 values (five texts), 4 events (the fifteen fields,
//   five of them texts). Tag 0 ends the snapshot.
//   A text is its byte length (-1 when absent) and the bytes of at most its
//   first 160 scalars.
// Tasks are written by every writer (the run's root task is one). The
// channel, value and event sections are written through code words their
// producers install, so a program pays for a section only with its feature.
OBSERVE_RAW_MAGIC :: I64{3550338754064696650}
observe_values_code := I64{0}
observe_events_code := I64{0}

fn observe_text_clone(value: I64) -> I64 {
    if value == (I64{0}) -> return I64{0}
    rt_text_copy(rt_text_data(value), rt_text_len(value))
}
fn observe_text_cmp(a: I64, b: I64) -> I64 {
    al :: rt_text_len(a)
    bl :: rt_text_len(b)
    at := I64{0}
    loop at < al && at < bl {
        av :: trap_byte(rt_text_data(a) + at)
        bv :: trap_byte(rt_text_data(b) + at)
        if av != bv -> return av - bv
        at += I64{1}
    }
    al - bl
}
fn observe_text_controls(value: I64) -> Bool {
    if value == (I64{0}) -> return false
    at := I64{0}
    loop at < rt_text_len(value) {
        cp :: rt_text_decode(rt_text_data(value) + at)
        if cp < (I64{32}) || (cp >= I64{127} && cp <= I64{159}) -> return true
        at += rt_text_width(rt_text_data(value) + at)
    }
    false
}
fn observe_value_drop(node: I64) {
    at := I64{8}
    loop at <= (I64{40}) {
        text :: sync_load(node + at)
        if text != (I64{0}) -> jet_rt_string_drop(text)
        at += I64{8}
    }
    jet_rt_free(node, I64{48}, I64{8})
}
// The source carrier has exactly Foundation's JetLiveValueDecision fields:
// value_id/type_identity/disposition/reason/rendered_value. Retain by copying
// E4 text; the producer continues owning its source and optional text owner.
#Export(c) fn jet_observe_record_live_value(source: I64) {
    if observe_values_code == (I64{0}) -> observe_values_code = rt_observe_raw_values_address()
    sync_mutex_lock(observe_root)
    link := observe_root + I64{112}
    id :: sync_load(source)
    previous := I64{0}
    loop sync_load(link) != (I64{0}) {
        node :: sync_load(link)
        order :: observe_text_cmp(sync_load(node + I64{8}), id)
        if order >= (I64{0}) {
            if order == (I64{0}) -> previous = node
            break
        }
        link = node
    }
    if previous == (I64{0}) && sync_load(observe_root + I64{120}) >= (I64{4096}) {
        sync_mutex_unlock(observe_root)
        return
    }
    node :: jet_rt_alloc(I64{48}, I64{8})
    sync_store(node, if previous == (I64{0}) -> sync_load(link) else -> sync_load(previous))
    at := I64{0}
    loop at < (I64{40}) {
        sync_store(node + at + I64{8}, observe_text_clone(sync_load(source + at)))
        at += I64{8}
    }
    sync_store(link, node)
    if previous == (I64{0}) -> _ := sync_add(observe_root + I64{120}, I64{1})
    sync_mutex_unlock(observe_root)
    if previous != (I64{0}) -> observe_value_drop(previous)
}
fn observe_event_text_field(offset: I64) -> Bool {
    offset == I64{8} || offset == I64{48} || offset == I64{88} || offset == I64{104} || offset == I64{112}
}
fn observe_event_drop(node: I64) {
    at := I64{0}
    loop at < (I64{120}) {
        if observe_event_text_field(at) -> jet_rt_string_drop(sync_load(node + at + I64{8}))
        at += I64{8}
    }
    jet_rt_free(node, I64{128}, I64{8})
}
// Source has canonical Event fields in Observe.rs:49-65 order; sequence is
// assigned under the same lock as append, as the Rust VecDeque producer does.
#Export(c) fn jet_observe_event(source: I64) {
    if observe_events_code == (I64{0}) -> observe_events_code = rt_observe_raw_events_address()
    node :: jet_rt_alloc(I64{128}, I64{8})
    sync_store(node, I64{0})
    at := I64{8}
    loop at < (I64{120}) {
        word :: sync_load(source + at)
        sync_store(node + at + I64{8}, if observe_event_text_field(at) -> observe_text_clone(word) else -> word)
        at += I64{8}
    }
    sync_mutex_lock(observe_root)
    sync_store(node + I64{8}, sync_add(observe_root + I64{80}, I64{1}))
    tail :: sync_load(observe_root + I64{96})
    if tail == (I64{0}) -> sync_store(observe_root + I64{88}, node) else -> sync_store(tail, node)
    sync_store(observe_root + I64{96}, node)
    retired := I64{0}
    if {
        sync_load(observe_root + I64{104}) == (I64{256}) -> {
            retired = sync_load(observe_root + I64{88})
            sync_store(observe_root + I64{88}, sync_load(retired))
        }
        else -> _ := sync_add(observe_root + I64{104}, I64{1})
    }
    sync_mutex_unlock(observe_root)
    if retired != (I64{0}) -> observe_event_drop(retired)
}
fn observe_raw_word(builder: I64, word: I64) {
    rt_text_append_raw_word(builder, word, I64{8})
}
fn observe_raw_text(builder: I64, value: I64) {
    if value == (I64{0}) {
        observe_raw_word(builder, I64{-1})
        return
    }
    data :: rt_text_data(value)
    length :: rt_text_len(value)
    at := I64{0}
    scalars := I64{0}
    loop at < length && scalars < (I64{160}) {
        at += rt_text_width(data + at)
        scalars += I64{1}
    }
    observe_raw_word(builder, at)
    rt_text_append(builder, data, at)
}
// The section writers run with the registry mutex held (observe_snapshot).
fn observe_raw_tasks(builder: I64) {
    observe_raw_word(builder, I64{1})
    observe_raw_word(builder, sync_load(observe_root + I64{32}))
    node := sync_load(observe_root + I64{24})
    loop node != (I64{0}) {
        at := I64{8}
        loop at <= (I64{72}) {
            if at != (I64{32}) && at != (I64{48}) -> observe_raw_word(builder, sync_load(node + at))
            at += I64{8}
        }
        observe_raw_text(builder, sync_load(node + I64{32}))
        observe_raw_text(builder, sync_load(node + I64{48}))
        node = sync_load(node)
    }
}
// RuntimeLower resolves these checked function-address entries, never the bodies.
fn rt_observe_raw_channels_address() -> I64 {
    loop { jet_rt_unreachable(I64{0}, I64{0}) }
}
fn rt_observe_raw_values_address() -> I64 {
    loop { jet_rt_unreachable(I64{0}, I64{0}) }
}
fn rt_observe_raw_events_address() -> I64 {
    loop { jet_rt_unreachable(I64{0}, I64{0}) }
}
#Export(c) fn jet_rt_observe_raw_channels(builder: I64) -> I64 {
    count := I64{0}
    node := sync_load(observe_root + I64{40})
    loop node != (I64{0}) {
        count += I64{1}
        node = sync_load(node)
    }
    observe_raw_word(builder, I64{2})
    observe_raw_word(builder, count)
    node = sync_load(observe_root + I64{40})
    loop node != (I64{0}) {
        at := I64{8}
        loop at <= (I64{56}) {
            observe_raw_word(builder, sync_load(node + at))
            at += I64{8}
        }
        node = sync_load(node)
    }
    I64{0}
}
#Export(c) fn jet_rt_observe_raw_values(builder: I64) -> I64 {
    observe_raw_word(builder, I64{3})
    observe_raw_word(builder, sync_load(observe_root + I64{120}))
    node := sync_load(observe_root + I64{112})
    loop node != (I64{0}) {
        at := I64{8}
        loop at <= (I64{40}) {
            observe_raw_text(builder, sync_load(node + at))
            at += I64{8}
        }
        node = sync_load(node)
    }
    I64{0}
}
#Export(c) fn jet_rt_observe_raw_events(builder: I64) -> I64 {
    observe_raw_word(builder, I64{4})
    observe_raw_word(builder, sync_load(observe_root + I64{104}))
    node := sync_load(observe_root + I64{88})
    loop node != (I64{0}) {
        at := I64{8}
        loop at <= (I64{120}) {
            if at != (I64{8}) && observe_event_text_field(at - I64{8}) -> observe_raw_text(builder, sync_load(node + at)) else -> observe_raw_word(builder, sync_load(node + at))
            at += I64{8}
        }
        node = sync_load(node)
    }
    I64{0}
}
fn observe_cstring(text: I64) -> I64 {
    length :: rt_text_len(text)
    buffer :: jet_rt_alloc(length + I64{1}, I64{1})
    rt_text_bytes_copy(buffer, rt_text_data(text), length)
    trap_put(buffer + length, I64{0})
    buffer
}
fn observe_syscall(number: I64, a: I64, b: I64, c: I64, d: I64) -> I64 {
    #Unsafe("vetted Observe Linux file/clock syscalls borrow native buffers only for their duration") {
        return os_syscall_i64(number, a, b, c, d, I64{0}, I64{0})
    }
}
// The raw snapshot (layout at the top of this file). The writer's lock is
// held by the caller.
fn observe_snapshot(writer: I64, exit: I64) -> I64 {
    text :: jet_rt_string_builder_new()
    scratch :: jet_rt_alloc(I64{24}, I64{8})
    observe_raw_word(text, OBSERVE_RAW_MAGIC)
    observe_raw_word(text, sync_load(writer + I64{16}))
    observe_raw_word(text, observe_syscall(I64{39}, I64{0}, I64{0}, I64{0}, I64{0}))
    captured := I64{0}
    if observe_syscall(I64{228}, I64{0}, scratch, I64{0}, I64{0}) == (I64{0}) -> captured = sync_load(scratch) * I64{1000} + sync_load(scratch + I64{8}) /% I64{1000000}
    observe_raw_word(text, captured)
    observe_raw_word(text, sync_now_ns() - sync_load(writer + I64{24}))
    observe_raw_word(text, sync_load(writer + I64{48}))
    observe_raw_word(text, sync_load(writer + I64{32}))
    observe_raw_word(text, sync_load(writer + I64{40}))
    observe_raw_word(text, exit)
    // These are the canonical Mem/Arena producer's three actual counters,
    // not program allocation counts or inferred registry cardinalities.
    jet_rt_mem_resources(scratch)
    observe_raw_word(text, sync_load(scratch))
    observe_raw_word(text, sync_load(scratch + I64{8}))
    observe_raw_word(text, sync_load(scratch + I64{16}))
    jet_rt_free(scratch, I64{24}, I64{8})
    sync_mutex_lock(observe_root)
    observe_raw_word(text, sync_load(observe_root + I64{48}))
    observe_raw_word(text, sync_load(observe_root + I64{56}))
    at := I64{56}
    loop at <= (I64{88}) {
        observe_raw_text(text, sync_load(writer + at))
        at += I64{8}
    }
    observe_raw_tasks(text)
    if observe_channels_code != (I64{0}) -> _ := coll_call1(observe_channels_code, text)
    if observe_values_code != (I64{0}) -> _ := coll_call1(observe_values_code, text)
    if observe_events_code != (I64{0}) -> _ := coll_call1(observe_events_code, text)
    sync_mutex_unlock(observe_root)
    observe_raw_word(text, I64{0})
    text
}
fn observe_append_directory(target: I64, directory: I64) {
    length :: rt_text_len(directory)
    rt_text_append(target, rt_text_data(directory), length)
    if length != (I64{0}) && trap_byte(rt_text_data(directory) + length - I64{1}) != (I64{47}) -> rt_text_push_scalar(target, I64{47})
}

// Holds the run mutex through staging+rename. A periodic publication that
// loses to final publication cannot overwrite it; failed publication still
// closes this run, matching Observe.rs:525-533.
fn observe_publish(writer: I64, exit: I64) {
    sync_mutex_lock(writer)
    if sync_load(writer + I64{8}) != (I64{0}) {
        sync_mutex_unlock(writer)
        return
    }
    sequence :: wrapping(sync_load(writer + I64{16}) + I64{1})
    sync_store(writer + I64{16}, sequence)
    snapshot :: observe_snapshot(writer, exit)
    stage :: jet_rt_string_builder_new()
    directory :: sync_load(writer + I64{96})
    observe_append_directory(stage, directory)
    observe_msg_stage_head(stage)
    observe_decimal_unsigned(stage, observe_syscall(I64{39}, I64{0}, I64{0}, I64{0}, I64{0}))
    rt_text_push_scalar(stage, I64{45})
    observe_decimal_unsigned(stage, sync_load(writer + I64{48}))
    rt_text_push_scalar(stage, I64{45})
    observe_decimal_unsigned(stage, sequence)
    observe_msg_stage_tail(stage)
    name :: observe_cstring(stage)
    if rt_text_len(snapshot) <= (I64{1048576}) {
        fd :: observe_syscall(I64{257}, I64{-100}, name, I64{524481}, I64{384})
        if fd >= (I64{0}) {
            at := I64{0}
            loop at < rt_text_len(snapshot) {
                written :: observe_syscall(I64{1}, fd, rt_text_data(snapshot) + at, rt_text_len(snapshot) - at, I64{0})
                if written == (I64{-4}) -> next
                if written <= (I64{0}) -> break
                at += written
            }
            if at == rt_text_len(snapshot) && observe_syscall(I64{74}, fd, I64{0}, I64{0}, I64{0}) == (I64{0}) {
                target :: observe_cstring(sync_load(writer + I64{104}))
                _ := observe_syscall(I64{82}, name, target, I64{0}, I64{0})
                jet_rt_free(target, rt_text_len(sync_load(writer + I64{104})) + I64{1}, I64{1})
            }
            _ := observe_syscall(I64{3}, fd, I64{0}, I64{0}, I64{0})
        }
    }
    _ := observe_syscall(I64{87}, name, I64{0}, I64{0}, I64{0})
    jet_rt_free(name, rt_text_len(stage) + I64{1}, I64{1})
    jet_rt_string_drop(stage)
    jet_rt_string_drop(snapshot)
    sync_store(writer + I64{8}, exit)
    sync_mutex_unlock(writer)
}
fn observe_publish_exit() {
    writer :: sync_load(observe_root + I64{72})
    if writer != (I64{0}) -> observe_publish(writer, I64{1})
}
// Accepted startup identity is the five canonical nonempty control-free E4
// fields, not an inferred identity. Directory is the host's actual temp_dir.
// The caller performs JET_OBSERVE=1/environment identity agreement before entry.
fn observe_live_start(identity: I64, directory: I64) -> I64 {
    at := I64{0}
    loop at < (I64{40}) {
        value :: sync_load(identity + at)
        if value == (I64{0}) || rt_text_len(value) == (I64{0}) || observe_text_controls(value) -> return I64{0}
        at += I64{8}
    }
    // The process facts `jet inspect` compares with /proc/<pid>/stat: CPU
    // ticks so far (times(2) counts the clock that file shows; AT_CLKTCK
    // below) and the boot clock, which bounds the process start time.
    facts :: jet_rt_alloc(I64{32}, I64{8})
    _ := observe_syscall(I64{100}, facts, I64{0}, I64{0}, I64{0})
    cpu :: wrapping(sync_load(facts) + sync_load(facts + I64{8}))
    boot :: if observe_syscall(I64{228}, I64{7}, facts, I64{0}, I64{0}) == (I64{0}) -> wrapping(sync_load(facts) * I64{1000000000} + sync_load(facts + I64{8})) else -> I64{0}
    sync_mutex_lock(observe_root)
    writer := sync_load(observe_root + I64{72})
    fresh :: writer == I64{0}
    if fresh {
        writer = jet_rt_alloc(I64{120}, I64{8})
        thread_zero(writer, I64{120})
        at = I64{0}
        loop at < (I64{40}) {
            sync_store(writer + I64{56} + at, observe_text_clone(sync_load(identity + at)))
            at += I64{8}
        }
        sync_store(writer + I64{96}, observe_text_clone(directory))
        sync_store(writer + I64{48}, boot)
        path :: jet_rt_string_builder_new()
        observe_append_directory(path, directory)
        observe_msg_path_head(path)
        observe_decimal_unsigned(path, observe_syscall(I64{39}, I64{0}, I64{0}, I64{0}, I64{0}))
        observe_msg_path_tail(path)
        sync_store(writer + I64{104}, path)
        root := observe_task_find(I64{1})
        if root == (I64{0}) {
            root = jet_rt_alloc(I64{88}, I64{8})
            thread_zero(root, I64{88})
            sync_store(root, sync_load(observe_root + I64{24}))
            sync_store(root + I64{8}, I64{1})
            label :: jet_rt_string_builder_new()
            observe_msg_root_label(label)
            sync_store(root + I64{32}, label)
            sync_store(root + I64{40}, I64{1})
            sync_store(observe_root + I64{24}, root)
            _ := sync_add(observe_root + I64{32}, I64{1})
        }
        sync_store(observe_root + I64{72}, writer)
        observe_exit_report_install()
    }
    sync_mutex_unlock(observe_root)
    sync_mutex_lock(writer)
    sync_store(writer + I64{24}, sync_now_ns())
    sync_store(writer + I64{32}, cpu)
    sync_store(writer + I64{40}, host_getauxval(I64{17}))
    sync_store(writer + I64{8}, I64{0})
    jet_rt_free(facts, I64{32}, I64{8})
    sync_store(observe_root + I64{64}, I64{0})
    sync_mutex_unlock(writer)
    writer
}

// RuntimeLower resolves this checked function-address entry, never the body.
fn rt_observe_writer_address() -> I64 {
    loop { jet_rt_unreachable(I64{0}, I64{0}) }
}

// The periodic writer shares the same run lock and never publishes after
// final publication until a resident host restarts the run.
#Export(c) fn jet_rt_observe_writer(argument: I64) -> I64 {
    writer :: argument
    slot :: sync_park_new()
    loop {
        observe_publish(writer, I64{0})
        sync_park(slot, I64{100000000})
    }
    I64{0}
}

fn observe_env_key(index: I64) -> I64 {
    key :: jet_rt_string_builder_new()
    if {
        index == (I64{0}) -> observe_msg_env_session(key)
        index == (I64{1}) -> observe_msg_env_source(key)
        index == (I64{2}) -> observe_msg_env_build(key)
        index == (I64{3}) -> observe_msg_env_revision(key)
        else -> observe_msg_env_world(key)
    }
    key
}

// Observe.rs:683-700. Read the ONE logical Env cell, not startup environ.
// All five supplied components must be present, nonempty, <=16KiB and Cc-free.
#Export(c) fn jet_rt_observe_runtime_start_from_env() {
    key :: jet_rt_string_builder_new()
    observe_msg_env_observe(key)
    enabled :: jet_rt_logical_env_get(key)
    jet_rt_string_drop(key)
    if enabled == (I64{0}) -> return
    live :: rt_text_len(enabled) == I64{1} && trap_byte(rt_text_data(enabled)) == I64{49}
    jet_rt_string_drop(enabled)
    if !live -> return
    inputs :: jet_rt_alloc(I64{56}, I64{8})
    thread_zero(inputs, I64{56})
    at := I64{0}
    valid := true
    loop at < (I64{5}) {
        name :: observe_env_key(at)
        value :: jet_rt_logical_env_get(name)
        jet_rt_string_drop(name)
        sync_store(inputs + at * I64{8}, value)
        if {
            value == (I64{0}) -> valid = false
            else -> {
                if rt_text_len(value) == (I64{0}) || rt_text_len(value) > (I64{16384}) || observe_text_controls(value) -> valid = false
            }
        }
        at += I64{1}
    }
    if valid {
        name :: jet_rt_string_builder_new()
        observe_msg_env_tmpdir(name)
        present :: jet_rt_logical_env_get_os(name, inputs + I64{40}, inputs + I64{48})
        jet_rt_string_drop(name)
        directory := I64{0}
        if {
            present == (I64{0}) -> {
                directory = jet_rt_string_builder_new()
                observe_msg_default_tmpdir(directory)
            }
            else -> {
                // OS path bytes can be non-UTF8. This private buffer is used
                // only for Linux path syscalls, never as a public String.
                data :: sync_load(inputs + I64{40})
                length :: sync_load(inputs + I64{48})
                directory = rt_text_copy(data, length)
                if length != (I64{0}) -> jet_rt_free(data, length, I64{1})
            }
        }
        writer :: observe_live_start(inputs, directory)
        jet_rt_string_drop(directory)
        if writer != (I64{0}) && sync_cas(writer + I64{112}, I64{0}, I64{1}) == (I64{0}) {
            handle :: thread_spawn(rt_observe_writer_address(), writer)
            if handle < (I64{0}) -> scheduler_start_failed()
            _ := thread_detach(handle)
        }
    }
    at = I64{0}
    loop at < (I64{5}) {
        value :: sync_load(inputs + at * I64{8})
        if value != (I64{0}) -> jet_rt_string_drop(value)
        at += I64{1}
    }
    jet_rt_free(inputs, I64{56}, I64{8})
}
