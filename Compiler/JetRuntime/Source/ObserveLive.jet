        jet_rt_string_drop(result)
        return I64{0}
    }
    result
}
fn observe_unsigned_less(a: I64, b: I64) -> Bool {
    if (a < I64{0}) != (b < I64{0}) -> return b < I64{0}
    a < b
}
fn observe_parse_unsigned(data: I64, length: I64, out: I64) -> Bool {
    if length == (I64{0}) -> return false
    value := I64{0}
    at := I64{0}
    loop at < length {
        digit :: trap_byte(data + at) - I64{48}
        if digit < (I64{0}) || digit > (I64{9}) -> return false
        if observe_unsigned_less(I64{1844674407370955161}, value) || (value == I64{1844674407370955161} && digit > I64{5}) -> return false
        value = wrapping(value * I64{10} + digit)
        at += I64{1}
    }
    sync_store(out, value)
    true
}
fn observe_unsigned_div(value: I64, divisor: I64) -> I64 {
    if value >= (I64{0}) -> return value /% divisor
    low :: value.bit_and(I64{9223372036854775807})
    q :: I64{9223372036854775807} /% divisor
    r :: I64{9223372036854775807} % divisor
    // Divisors here come from positive AT_CLKTCK (normally100). Avoid adding
    // the two remainders until their carry is resolved.
    tail :: low % divisor
    carry :: if tail >= (divisor - r - I64{1}) -> I64{1} else -> I64{0}
    wrapping(q + low /% divisor + carry)
}
// Output32: owned start-id0, optional CPU-present8/CPU16, parsed temporary24.
fn observe_process_facts(out: I64) {
    thread_zero(out, I64{32})
    start :: jet_rt_string_builder_new()
    sync_store(out, start)
    path := jet_rt_string_builder_new()
    observe_msg_proc_stat(path)
    stat :: observe_read_file(path)
    jet_rt_string_drop(path)
    if stat == (I64{0}) -> return
    data :: rt_text_data(stat)
    length :: rt_text_len(stat)
    tail := I64{-1}
    at := I64{0}
    loop at + (I64{1}) < length {
        if trap_byte(data + at) == (I64{41}) && trap_byte(data + at + I64{1}) == (I64{32}) -> tail = at + I64{2}
        at += I64{1}
    }
    field := I64{0}
    user := I64{0}
    system := I64{0}
    if tail < (I64{0}) {
        jet_rt_string_drop(stat)
        return
    }
    valid := true
    at = tail
    loop at < length {
        loop at < length && trap_byte(data + at) <= (I64{32}) -> at += I64{1}
        begin :: at
        loop at < length && trap_byte(data + at) > (I64{32}) -> at += I64{1}
        if at == begin -> break
        if field == (I64{11}) || field == (I64{12}) {
            parsed :: observe_parse_unsigned(data + begin, at - begin, out + I64{24})
            valid = valid && parsed
            if field == (I64{11}) -> user = sync_load(out + I64{24}) else -> system = sync_load(out + I64{24})
        }
        if field == (I64{19}) {
            rt_text_append(start, data + begin, at - begin)
            break
        }
        field += I64{1}
    }
    jet_rt_string_drop(stat)
    if !valid || field != (I64{19}) -> return
    path = jet_rt_string_builder_new()
    observe_msg_proc_auxv(path)
    aux :: observe_read_file(path)
    jet_rt_string_drop(path)
    if aux == (I64{0}) -> return
    hz := I64{0}
    at = I64{0}
    loop at + (I64{16}) <= rt_text_len(aux) {
        if sync_load(rt_text_data(aux) + at) == (I64{17}) {
            hz = sync_load(rt_text_data(aux) + at + I64{8})
            break
        }
        at += I64{16}
    }
    jet_rt_string_drop(aux)
    ticks :: wrapping(user + system)
    if hz <= (I64{0}) || observe_unsigned_less(ticks, user) || observe_unsigned_less(I64{18446744073}, ticks) -> return
    sync_store(out + I64{8}, I64{1})
    sync_store(out + I64{16}, observe_unsigned_div(wrapping(ticks * I64{1000000000}), hz))
}
fn observe_quote(builder: I64, text: I64) {
    rt_text_push_scalar(builder, I64{34})
