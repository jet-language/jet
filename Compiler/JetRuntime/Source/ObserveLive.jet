        observe_escape(builder, wait)
        observe_msg_deadline(builder)
        if sync_load(node + I64{56}) != (I64{0}) -> observe_decimal_signed(builder, sync_load(node + I64{64})) else -> observe_msg_null(builder)
        observe_msg_cancelled(builder)
        cancelled :: sync_load(node + I64{72})
        observe_bool(builder, cancelled)
        rt_text_push_scalar(builder, I64{125})
        if state == (I64{2}) {
            _ := sync_add(counters, I64{1})
            if observe_contains_word(wait, I64{2336353831671130211}, I64{8}, true) -> _ := sync_add(counters + I64{8}, I64{1})
            if observe_contains_word(wait, I64{139140622708}, I64{5}, true) -> _ := sync_add(counters + I64{16}, I64{1})
            if observe_contains_word(wait, I64{7365492}, I64{3}, false) || observe_contains_word(wait, I64{30243645579093358}, I64{7}, false) || observe_contains_word(wait, I64{2125673}, I64{3}, true) -> _ := sync_add(counters + I64{24}, I64{1})
        }
        if cancelled != (I64{0}) -> _ := sync_add(counters + I64{32}, I64{1})
        if state == (I64{1}) -> _ := sync_add(counters + I64{40}, I64{1})
        at += I64{1}
    }
    jet_rt_free(array, count * I64{8}, I64{8})
}
