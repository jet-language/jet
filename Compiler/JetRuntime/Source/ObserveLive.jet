}
fn observe_array(list: I64, count: I64) -> I64 {
    array :: jet_rt_alloc(count * I64{8}, I64{8})
    node := list
    at := I64{0}
    loop at < count {
        sync_store(array + at * I64{8}, node)
        node = sync_load(node)
        at += I64{1}
    }
    at = count /% I64{2}
    loop at > (I64{0}) {
        at -= I64{1}
        observe_task_sift(array, count, at)
