    jet_rt_mem_resources(scratch)
    observe_msg_live_arenas(text)
    observe_decimal_unsigned(text, sync_load(scratch))
    observe_msg_live_allocs(text)
    observe_decimal_unsigned(text, sync_load(scratch + I64{8}))
    observe_msg_live_bytes(text)
    observe_decimal_unsigned(text, sync_load(scratch + I64{16}))
    observe_msg_live_runtime(text)
    observe_decimal_unsigned(text, sync_now_ns() - sync_load(writer + I64{24}))
    observe_process_facts(scratch)
    observe_msg_live_cpu(text)
    if {
        (sync_load(writer + I64{32}) == I64{0} || sync_load(scratch + I64{8}) == I64{0}) -> observe_msg_null(text)
        else -> {
            start :: sync_load(writer + I64{40})
            now :: sync_load(scratch + I64{16})
            observe_decimal_unsigned(text, if observe_unsigned_less(now, start) -> I64{0} else -> wrapping(now - start))
        }
    }
    jet_rt_string_drop(sync_load(scratch))
    jet_rt_free(scratch, I64{48}, I64{8})
    observe_msg_live_exit(text)
    observe_bool(text, exit)
    observe_msg_live_end(text)
    text
}
fn observe_append_directory(target: I64, directory: I64) {
    length :: rt_text_len(directory)
    rt_text_append(target, rt_text_data(directory), length)
    if length != (I64{0}) && trap_byte(rt_text_data(directory) + length - I64{1}) != (I64{47}) -> rt_text_push_scalar(target, I64{47})
}

// Holds the run mutex through staging+rename. A periodic publication that
// loses to final publication cannot overwrite it; failed publication still
// closes this run, matching Observe.rs:525-533.
fn observe_publish(writer: I64, exit: I64) {
    sync_mutex_lock(writer)
    if sync_load(writer + I64{8}) != (I64{0}) {
        sync_mutex_unlock(writer)
        return
    }
    sequence :: wrapping(sync_load(writer + I64{16}) + I64{1})
    sync_store(writer + I64{16}, sequence)
    snapshot :: observe_snapshot(writer, exit)
    stage :: jet_rt_string_builder_new()
    directory :: sync_load(writer + I64{96})
    observe_append_directory(stage, directory)
    observe_msg_stage_head(stage)
    observe_decimal_unsigned(stage, observe_syscall(I64{39}, I64{0}, I64{0}, I64{0}, I64{0}))
    rt_text_push_scalar(stage, I64{45})
    start :: sync_load(writer + I64{48})
    rt_text_append(stage, rt_text_data(start), rt_text_len(start))
    rt_text_push_scalar(stage, I64{45})
    observe_decimal_unsigned(stage, sequence)
    observe_msg_stage_tail(stage)
    name :: observe_cstring(stage)
    if rt_text_len(snapshot) <= (I64{1048576}) {
        fd :: observe_syscall(I64{257}, I64{-100}, name, I64{524481}, I64{384})
        if fd >= (I64{0}) {
            at := I64{0}
            loop at < rt_text_len(snapshot) {
                written :: observe_syscall(I64{1}, fd, rt_text_data(snapshot) + at, rt_text_len(snapshot) - at, I64{0})
                if written == (I64{-4}) -> next
                if written <= (I64{0}) -> break
                at += written
            }
            if at == rt_text_len(snapshot) && observe_syscall(I64{74}, fd, I64{0}, I64{0}, I64{0}) == (I64{0}) {
                target :: observe_cstring(sync_load(writer + I64{104}))
                _ := observe_syscall(I64{82}, name, target, I64{0}, I64{0})
                jet_rt_free(target, rt_text_len(sync_load(writer + I64{104})) + I64{1}, I64{1})
            }
            _ := observe_syscall(I64{3}, fd, I64{0}, I64{0}, I64{0})
        }
    }
    _ := observe_syscall(I64{87}, name, I64{0}, I64{0}, I64{0})
    jet_rt_free(name, rt_text_len(stage) + I64{1}, I64{1})
    jet_rt_string_drop(stage)
    jet_rt_string_drop(snapshot)
    sync_store(writer + I64{8}, exit)
    sync_mutex_unlock(writer)
}
fn observe_publish_exit() {
    writer :: sync_load(observe_root + I64{72})
    if writer != (I64{0}) -> observe_publish(writer, I64{1})
}
// Accepted startup identity is the five canonical nonempty control-free E4
// fields, not an inferred identity. Directory is the host's actual temp_dir.
// The caller performs JET_OBSERVE=1/environment identity agreement before entry.
fn observe_live_start(identity: I64, directory: I64) -> I64 {
    at := I64{0}
    loop at < (I64{40}) {
        value :: sync_load(identity + at)
        if value == (I64{0}) || rt_text_len(value) == (I64{0}) || observe_text_controls(value) -> return I64{0}
        at += I64{8}
    }
    facts :: jet_rt_alloc(I64{32}, I64{8})
    observe_process_facts(facts)
    sync_mutex_lock(observe_root)
    writer := sync_load(observe_root + I64{72})
    fresh :: writer == I64{0}
    if fresh {
        writer = jet_rt_alloc(I64{120}, I64{8})
        thread_zero(writer, I64{120})
        at = I64{0}
        loop at < (I64{40}) {
            sync_store(writer + I64{56} + at, observe_text_clone(sync_load(identity + at)))
            at += I64{8}
        }
        sync_store(writer + I64{96}, observe_text_clone(directory))
        sync_store(writer + I64{48}, sync_load(facts))
        path :: jet_rt_string_builder_new()
        observe_append_directory(path, directory)
        observe_msg_path_head(path)
        observe_decimal_unsigned(path, observe_syscall(I64{39}, I64{0}, I64{0}, I64{0}, I64{0}))
        observe_msg_path_tail(path)
        sync_store(writer + I64{104}, path)
        root := observe_task_find(I64{1})
        if root == (I64{0}) {
            root = jet_rt_alloc(I64{88}, I64{8})
            thread_zero(root, I64{88})
            sync_store(root, sync_load(observe_root + I64{24}))
            sync_store(root + I64{8}, I64{1})
            label :: jet_rt_string_builder_new()
            observe_msg_root_label(label)
            sync_store(root + I64{32}, label)
            sync_store(root + I64{40}, I64{1})
            sync_store(observe_root + I64{24}, root)
            _ := sync_add(observe_root + I64{32}, I64{1})
        }
        sync_store(observe_root + I64{72}, writer)
    }
    sync_mutex_unlock(observe_root)
    sync_mutex_lock(writer)
    sync_store(writer + I64{24}, sync_now_ns())
    sync_store(writer + I64{32}, sync_load(facts + I64{8}))
    sync_store(writer + I64{40}, sync_load(facts + I64{16}))
    sync_store(writer + I64{8}, I64{0})
    if !fresh -> jet_rt_string_drop(sync_load(facts))
    jet_rt_free(facts, I64{32}, I64{8})
    sync_store(observe_root + I64{64}, I64{0})
    sync_mutex_unlock(writer)
    writer
}

// RuntimeLower resolves this checked function-address entry, never the body.
fn rt_observe_writer_address() -> I64 {
    loop { jet_rt_unreachable(I64{0}, I64{0}) }
}

// The periodic writer shares the same run lock and never publishes after
// final publication until a resident host restarts the run.
#Export(c) fn jet_rt_observe_writer(argument: I64) -> I64 {
    writer :: argument
    slot :: sync_park_new()
    loop {
        observe_publish(writer, I64{0})
        sync_park(slot, I64{100000000})
    }
    I64{0}
}

fn observe_env_key(index: I64) -> I64 {
    key :: jet_rt_string_builder_new()
    if {
        index == (I64{0}) -> observe_msg_env_session(key)
        index == (I64{1}) -> observe_msg_env_source(key)
        index == (I64{2}) -> observe_msg_env_build(key)
        index == (I64{3}) -> observe_msg_env_revision(key)
        else -> observe_msg_env_world(key)
    }
    key
}

// Observe.rs:683-700. Read the ONE logical Env cell, not startup environ.
// All five supplied components must be present, nonempty, <=16KiB and Cc-free.
#Export(c) fn jet_rt_observe_runtime_start_from_env() {
    key :: jet_rt_string_builder_new()
    observe_msg_env_observe(key)
    enabled :: jet_rt_logical_env_get(key)
    jet_rt_string_drop(key)
    if enabled == (I64{0}) -> return
    live :: rt_text_len(enabled) == I64{1} && trap_byte(rt_text_data(enabled)) == I64{49}
    jet_rt_string_drop(enabled)
    if !live -> return
    inputs :: jet_rt_alloc(I64{56}, I64{8})
    thread_zero(inputs, I64{56})
    at := I64{0}
    valid := true
    loop at < (I64{5}) {
        name :: observe_env_key(at)
        value :: jet_rt_logical_env_get(name)
        jet_rt_string_drop(name)
        sync_store(inputs + at * I64{8}, value)
        if {
            value == (I64{0}) -> valid = false
            else -> {
                if rt_text_len(value) == (I64{0}) || rt_text_len(value) > (I64{16384}) || observe_text_controls(value) -> valid = false
            }
        }
        at += I64{1}
    }
    if valid {
        name :: jet_rt_string_builder_new()
        observe_msg_env_tmpdir(name)
        present :: jet_rt_logical_env_get_os(name, inputs + I64{40}, inputs + I64{48})
        jet_rt_string_drop(name)
        directory := I64{0}
        if {
            present == (I64{0}) -> {
                directory = jet_rt_string_builder_new()
                observe_msg_default_tmpdir(directory)
            }
            else -> {
                // OS path bytes can be non-UTF8. This private buffer is used
                // only for Linux path syscalls, never as a public String.
                data :: sync_load(inputs + I64{40})
                length :: sync_load(inputs + I64{48})
                directory = rt_text_copy(data, length)
                if length != (I64{0}) -> jet_rt_free(data, length, I64{1})
            }
        }
        writer :: observe_live_start(inputs, directory)
        jet_rt_string_drop(directory)
        if writer != (I64{0}) && sync_cas(writer + I64{112}, I64{0}, I64{1}) == (I64{0}) {
            handle :: thread_spawn(rt_observe_writer_address(), writer)
            if handle < (I64{0}) -> scheduler_fatal(scheduler_msg_start_failed())
            _ := thread_detach(handle)
        }
    }
    at = I64{0}
    loop at < (I64{5}) {
        value :: sync_load(inputs + at * I64{8})
        if value != (I64{0}) -> jet_rt_string_drop(value)
        at += I64{1}
    }
    jet_rt_free(inputs, I64{56}, I64{8})
}
