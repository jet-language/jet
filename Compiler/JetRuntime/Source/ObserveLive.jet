// Counters48: blocked0/channel8/time16/io24/cancelled32/running40.
fn observe_tasks_json(builder: I64, counters: I64) {
    count :: sync_load(observe_root + I64{32})
    array :: observe_array(sync_load(observe_root + I64{24}), count)
    at := I64{0}
    loop at < count {
        node :: sync_load(array + at * I64{8})
        if at != (I64{0}) -> rt_text_push_scalar(builder, I64{44})
        observe_msg_task_begin(builder)
        observe_decimal_unsigned(builder, sync_load(node + I64{8}))
        observe_msg_parent(builder)
        observe_decimal_unsigned(builder, sync_load(node + I64{16}))
        observe_msg_label(builder)
        observe_escape(builder, sync_load(node + I64{32}))
        observe_msg_spawn(builder)
        observe_decimal_unsigned(builder, sync_load(node + I64{24}))
        observe_msg_state(builder)
        state :: sync_load(node + I64{40})
        if {
            state == (I64{0}) -> observe_msg_queued(builder)
            state == (I64{1}) -> observe_msg_running(builder)
            state == (I64{2}) -> observe_msg_blocked(builder)
            else -> observe_msg_paused(builder)
