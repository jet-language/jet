    observe_msg_live_io(text)
    observe_decimal_unsigned(text, sync_load(scratch + I64{24}))
    observe_msg_live_resources(text)
    observe_decimal_unsigned(text, sync_load(observe_root + I64{48}))
    observe_msg_live_running(text)
    observe_decimal_unsigned(text, sync_load(scratch + I64{40}))
    observe_msg_live_queued(text)
