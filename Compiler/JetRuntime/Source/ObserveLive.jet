fn observe_contains_word(text: I64, word: I64, length: I64, prefix: Bool) -> Bool {
    if text == (I64{0}) -> return false
    limit :: rt_text_len(text) - length
    at := I64{0}
    loop at <= limit {
        byte := I64{0}
        loop byte < length && trap_byte(rt_text_data(text) + at + byte) == ((word >> (byte * I64{8})).bit_and(I64{255})) -> byte += I64{1}
        if byte == length -> return true
        if prefix -> return false
        at += I64{1}
    }
    false
