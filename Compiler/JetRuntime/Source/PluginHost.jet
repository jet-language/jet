// The plugin host (#4717): `core.plugin` loads a WebAssembly Component that
// the JetPlugin link step translated into this program's own code. The guest
// entry is `guest(op, instance, area) -> word`: op -1 returns the descriptor
// blob, op -2 runs the core start functions, op k >= 0 runs thunk k over the
// u64 slots at `area` (flat arguments in, the flat result word out in slot 0).
// Translated guest code reads and writes the instance words below and calls
// back into the jet_plugin_* helpers for traps, frames, memory, tables and
// host imports. This file is the one host interface; nothing else crosses.
//
// Descriptor words (offsets are relative to the descriptor start):
//   0 version, 1-2 load error, 3-4 component name, 5-6 artifact bytes,
//   7-8 exports (12 words: name, name len, thunk, param count, params,
//       result, realloc, post-return, memory, unsupported, field count,
//       fields: a tuple result's field codes in order),
//   9-10 imports (8 words: name, name len, param count, params, result,
//       memory, realloc, reserved), 11-12 memories (min, max),
//   13-14 tables (min, max), 15-16 globals (init bits),
//   17-18 data (active, memory, offset, bytes, len),
//   19-20 elements (mode, table, offset, items, count; an item is fid + 1),
//   21-22 functions (name, name len, module, module len, signature class),
//   23-24 the loading package's `authority.needs` (one right per line).
// Value codes: 0 bool, 1 s8, 2 u8, 3 s16, 4 u16, 5 s32, 6 u32, 7 s64, 8 u64,
// 9 f32, 10 f64, 11 char, 12 string, 13 unsupported, 14 tuple (a tuple or
// record of scalar fields); result -1 is none.

PG_PLUGIN_RC: I64{0}
PG_PLUGIN_GUEST: I64{8}
PG_PLUGIN_INST: I64{16}
PG_PLUGIN_DESC: I64{24}
PG_PLUGIN_FAILURE: I64{32}
PG_PLUGIN_WIRE: I64{40}
PG_PLUGIN_ARGS: I64{48}
PG_PLUGIN_ARG_DATA: I64{56}
PG_PLUGIN_ARG_CAP: I64{64}
PG_PLUGIN_PATH: I64{72}
PG_PLUGIN_AREA: I64{80}
PG_PLUGIN_ACTIVE: I64{88}
PG_PLUGIN_BYTES: I64{96}
PG_ARG_BYTES: I64{24}
PG_AREA_BYTES: I64{512}

PG_INST_TRAP: I64{0}
PG_INST_MESSAGE: I64{8}
PG_INST_FUEL: I64{16}
PG_INST_DEPTH: I64{24}
PG_INST_FRAME_COUNT: I64{32}
PG_INST_FRAMES: I64{40}
PG_INST_MEMORIES: I64{48}
PG_INST_TABLES: I64{56}
PG_INST_GLOBALS: I64{64}
PG_INST_DESC: I64{72}
PG_INST_PLUGIN: I64{80}
PG_INST_DATA_DROPPED: I64{88}
PG_INST_ELEM_DROPPED: I64{96}
PG_INST_FUEL_RESERVE: I64{104}
PG_INST_DEADLINE: I64{112}
PG_INST_BYTES: I64{120}

// Trap kinds in PG_INST_TRAP.
PG_TRAP_GUEST: I64{1}
PG_TRAP_DENIED: I64{2}
PG_TRAP_FUEL: I64{3}
PG_TRAP_MEMORY: I64{4}
PG_TRAP_TABLE: I64{5}
PG_TRAP_DEFECT: I64{6}
PG_TRAP_USER: I64{7}
PG_TRAP_TIME: I64{8}

// Budgets: fuel per call, wall-clock time per call, linear-memory pages, table
// elements, trap frames, and the bytes one string argument or result may carry
// across the wire. Fuel is handed out in slices: the instance's fuel word holds
// the current slice and the reserve the rest; the deadline is checked each
// time a slice runs out.
PG_FUEL: I64{10000000}
PG_FUEL_SLICE: I64{4096}
PG_TIME_NS: I64{1000000000}
PG_MAX_PAGES: I64{256}
PG_PAGE: I64{65536}
PG_MAX_TABLE: I64{10000}
PG_MAX_FRAMES: I64{32}
PG_MAX_FLAT: I64{16}
PG_MAX_WIRE: I64{1048576}
PG_U32: I64{4294967295}
PG_VALUE_STRING: I64{12}
PG_VALUE_TUPLE: I64{14}
PG_EXPORT_BYTES: I64{96}

PG_LIMIT_FUEL: I64{0}
PG_LIMIT_MEMORY: I64{1}
PG_LIMIT_TABLE: I64{2}
PG_LIMIT_TIME: I64{3}
PG_LIMIT_WIRE: I64{4}

pg_word: fn(address: I64) -> I64 { dyn_word(address) }
pg_store: fn(address: I64, value: I64) { dyn_store(address, value) }
pg_desc: fn(desc: I64, index: I64) -> I64 { dyn_word(wrapping(desc + index * I64{8})) }

pg_u32: fn(address: I64) -> I64 {
    rt_text_byte(address).bit_or(rt_text_byte(wrapping(address + I64{1})) << I64{8}).bit_or(rt_text_byte(wrapping(address + I64{2})) << I64{16}).bit_or(rt_text_byte(wrapping(address + I64{3})) << I64{24})
}

pg_put_u32: fn(address: I64, value: I64) {
    rt_text_put(address, value.bit_and(I64{255}))
    rt_text_put(wrapping(address + I64{1}), (value >> I64{8}).bit_and(I64{255}))
    rt_text_put(wrapping(address + I64{2}), (value >> I64{16}).bit_and(I64{255}))
    rt_text_put(wrapping(address + I64{3}), (value >> I64{24}).bit_and(I64{255}))
}

pg_mmap: fn(bytes: I64) -> I64 {
    // PROT_READ|PROT_WRITE, MAP_PRIVATE|MAP_ANONYMOUS|MAP_NORESERVE: zeroed, lazily backed.
    address: trap_syscall(I64{9}, I64{0}, bytes, I64{3}, I64{16418}, I64{-1}, I64{0})
    if (address < I64{0}) -> return I64{0}
    address
}

pg_munmap: fn(address: I64, bytes: I64) {
    if (address != I64{0}) {
        _ := trap_syscall(I64{11}, address, bytes, I64{0}, I64{0}, I64{0}, I64{0})
    }
}

pg_call: fn(code: I64, op: I64, instance: I64, area: I64) -> I64 {
    #Unsafe("the linked guest entry reads the live instance and argument area only for this synchronous call") {
        return os_call3_i64(code, op, instance, area)
    }
}

pg_guest: fn(plugin: I64, op: I64) -> I64 {
    pg_call(pg_word(wrapping(plugin + PG_PLUGIN_GUEST)), op, pg_word(wrapping(plugin + PG_PLUGIN_INST)), pg_word(wrapping(plugin + PG_PLUGIN_AREA)))
}

// ---- failures --------------------------------------------------------------

pg_prefix: fn(target: I64, kind: I64) {
    if (kind == PLUGIN_ERROR_GUEST) {
        jet_rt_string_builder_push(target, rt_static_text("user-error:"))
    } else if (kind == PLUGIN_ERROR_DENIED) {
        jet_rt_string_builder_push(target, rt_static_text("denied-authority:"))
    } else if (kind == PLUGIN_ERROR_BUDGET) {
        jet_rt_string_builder_push(target, rt_static_text("budget-exhausted:"))
    } else {
        jet_rt_string_builder_push(target, rt_static_text("internal-defect:"))
    }
}

// A PluginError owning a fresh fault; `detail` and `frames` are adopted,
// `export_name` is borrowed. A call failure names the export in its message.
pg_failure: fn(kind: I64, limit: I64, export_name: I64, call: Bool, detail: I64, frames: I64) -> I64 {
    message: jet_rt_string_builder_new()
    pg_prefix(message, kind)
    if call {
        jet_rt_string_builder_push(message, rt_static_text("plugin call `"))
        jet_rt_string_builder_push(message, export_name)
        jet_rt_string_builder_push(message, rt_static_text("`: "))
    }
    jet_rt_string_builder_push(message, detail)
    jet_rt_string_drop(detail)
    fault: jet_rt_record_new_plugin_fault(export_name, message, frames)
    jet_rt_string_drop(message)
    error: jet_rt_alloc(PLUGIN_ERROR_BYTES, I64{8})
    pg_store(wrapping(error + PLUGIN_ERROR_TAG), kind)
    pg_store(wrapping(error + PLUGIN_ERROR_FAULT), fault)
    pg_store(wrapping(error + PLUGIN_ERROR_LIMIT), limit)
    error
}

pg_no_frames: fn() -> I64 { jet_rt_record_seq_list_rec_plugin_frame_new(I64{0}) }

pg_load_failure: fn(kind: I64, detail: I64) -> I64 {
    pg_failure(kind, I64{0}, rt_static_text("load"), false, detail, pg_no_frames())
}

pg_text: fn(data: I64, length: I64) -> I64 { rt_text_copy(data, length) }

pg_desc_text: fn(desc: I64, index: I64) -> I64 { pg_text(wrapping(desc + pg_desc(desc, index)), pg_desc(desc, index + I64{1})) }

// `plugin `{path}` {middle}` style detail texts.
pg_path_detail: fn(lead: I64, path: I64, tail: I64) -> I64 {
    detail: jet_rt_string_builder_new()
    jet_rt_string_builder_push(detail, lead)
    jet_rt_string_builder_push(detail, path)
    jet_rt_string_builder_push(detail, tail)
    detail
}

// ---- the instance trap state -------------------------------------------------

pg_set_trap: fn(instance: I64, kind: I64, message: I64) {
    if (pg_word(wrapping(instance + PG_INST_TRAP)) != I64{0}) {
        jet_rt_string_drop(message)
        return
    }
    pg_store(wrapping(instance + PG_INST_TRAP), kind)
    jet_rt_string_drop(pg_word(wrapping(instance + PG_INST_MESSAGE)))
    pg_store(wrapping(instance + PG_INST_MESSAGE), message)
}

#Export(c) jet_plugin_frame: fn(instance: I64, fid: I64, offset: I64) {
    count: pg_word(wrapping(instance + PG_INST_FRAME_COUNT))
    if (count >= PG_MAX_FRAMES) -> return
    frame: wrapping(pg_word(wrapping(instance + PG_INST_FRAMES)) + count * I64{16})
    pg_store(frame, fid)
    pg_store(wrapping(frame + I64{8}), offset)
    pg_store(wrapping(instance + PG_INST_FRAME_COUNT), count + I64{1})
}

pg_trap_text: fn(code: I64) -> I64 {
    if (code == I64{0}) -> return rt_static_text("wasm `unreachable` instruction executed")
    if (code == I64{1}) -> return rt_static_text("out of bounds memory access")
    if (code == I64{2}) -> return rt_static_text("integer divide by zero")
    if (code == I64{3}) -> return rt_static_text("integer overflow")
    if (code == I64{4}) -> return rt_static_text("invalid conversion to integer")
    if (code == I64{5}) -> return rt_static_text("undefined element: out of bounds table access")
    if (code == I64{6}) -> return rt_static_text("uninitialized element")
    if (code == I64{7}) -> return rt_static_text("indirect call type mismatch")
    if (code == I64{8}) -> return rt_static_text("call stack exhausted")
    if (code == I64{10}) -> return rt_static_text("out of bounds table access")
    rt_static_text("fuel budget exhausted")
}

// Code 9 is the fuel budget; every other code is a guest trap.
#Export(c) jet_plugin_trap: fn(instance: I64, code: I64, fid: I64, offset: I64) {
    text: pg_trap_text(code)
    pg_set_trap(instance, if (code == I64{9}) -> PG_TRAP_FUEL else -> PG_TRAP_GUEST, jet_rt_string_clone(text))
    jet_plugin_frame(instance, fid, offset)
}

pg_trap_at: fn(instance: I64, code: I64, fid: I64, offset: I64) -> I64 {
    jet_plugin_trap(instance, code, fid, offset)
    I64{0}
}

// The guest has spent its fuel slice. A call whose reserve is gone has spent
// its fuel budget, and one past its deadline its time budget; either records
// the trap with this frame. Otherwise the next slice comes out of the
// reserve, with the unit that ran out already spent from it.
#Export(c) jet_plugin_fuel: fn(instance: I64, fid: I64, offset: I64) {
    reserve: pg_word(wrapping(instance + PG_INST_FUEL_RESERVE))
    if (reserve <= I64{0}) {
        jet_plugin_trap(instance, I64{9}, fid, offset)
        return
    }
    if (time_host_monotonic_i64() > pg_word(wrapping(instance + PG_INST_DEADLINE))) {
        pg_set_trap(instance, PG_TRAP_TIME, jet_rt_string_clone(rt_static_text("time budget exhausted")))
        jet_plugin_frame(instance, fid, offset)
        return
    }
    slice: if (reserve < PG_FUEL_SLICE) -> reserve else -> PG_FUEL_SLICE
    pg_store(wrapping(instance + PG_INST_FUEL_RESERVE), reserve - slice)
    pg_store(wrapping(instance + PG_INST_FUEL), slice - I64{1})
}

// ---- memories and tables -------------------------------------------------------

pg_memory: fn(instance: I64, index: I64) -> I64 { pg_word(wrapping(instance + PG_INST_MEMORIES)) + index * I64{24} }
pg_table: fn(instance: I64, index: I64) -> I64 { pg_word(wrapping(instance + PG_INST_TABLES)) + index * I64{24} }

pg_in_bounds: fn(start: I64, count: I64, size: I64) -> Bool {
    start >= I64{0} && count >= I64{0} && start <= size && count <= size - start
}

#Export(c) jet_plugin_memory_grow: fn(instance: I64, index: I64, delta: I64, fid: I64, offset: I64) -> I64 {
    memory: pg_memory(instance, index)
    pages: pg_word(wrapping(memory + I64{8})) /% PG_PAGE
    more: delta.bit_and(PG_U32)
    wanted: pages + more
    maximum: pg_word(wrapping(memory + I64{16}))
    if (maximum >= I64{0} && wanted > maximum) -> return I64{-1}
    if (wanted > PG_MAX_PAGES) {
        pg_set_trap(instance, PG_TRAP_MEMORY, jet_rt_string_clone(rt_static_text("memory budget exhausted")))
        jet_plugin_frame(instance, fid, offset)
        return I64{-1}
    }
    pg_store(wrapping(memory + I64{8}), wanted * PG_PAGE)
    pages
}

#Export(c) jet_plugin_memory_fill: fn(instance: I64, index: I64, target: I64, value: I64, count: I64, fid: I64, offset: I64) {
    memory: pg_memory(instance, index)
    start: target.bit_and(PG_U32)
    length: count.bit_and(PG_U32)
    if !pg_in_bounds(start, length, pg_word(wrapping(memory + I64{8}))) {
        _: pg_trap_at(instance, I64{1}, fid, offset)
        return
    }
    base: wrapping(pg_word(memory) + start)
    byte: value.bit_and(I64{255})
    at := I64{0}
    loop at < length {
        rt_text_put(wrapping(base + at), byte)
        at += I64{1}
    }
}

#Export(c) jet_plugin_memory_copy: fn(instance: I64, target_memory: I64, source_memory: I64, target: I64, source: I64, count: I64, fid: I64, offset: I64) {
    to: pg_memory(instance, target_memory)
    from: pg_memory(instance, source_memory)
    start: target.bit_and(PG_U32)
    origin: source.bit_and(PG_U32)
    length: count.bit_and(PG_U32)
    if (!pg_in_bounds(start, length, pg_word(wrapping(to + I64{8}))) || !pg_in_bounds(origin, length, pg_word(wrapping(from + I64{8})))) {
        _: pg_trap_at(instance, I64{1}, fid, offset)
        return
    }
    jet_rt_mem_move(wrapping(pg_word(to) + start), wrapping(pg_word(from) + origin), length)
}

#Export(c) jet_plugin_memory_init: fn(instance: I64, index: I64, segment: I64, target: I64, source: I64, count: I64, fid: I64, offset: I64) {
    desc: pg_word(wrapping(instance + PG_INST_DESC))
    record: wrapping(wrapping(desc + pg_desc(desc, I64{18})) + segment * I64{40})
    dropped: rt_text_byte(wrapping(pg_word(wrapping(instance + PG_INST_DATA_DROPPED)) + segment)) != I64{0}
    available: if dropped -> I64{0} else -> pg_word(wrapping(record + I64{32}))
    memory: pg_memory(instance, index)
    start: target.bit_and(PG_U32)
    origin: source.bit_and(PG_U32)
    length: count.bit_and(PG_U32)
    if (!pg_in_bounds(start, length, pg_word(wrapping(memory + I64{8}))) || !pg_in_bounds(origin, length, available)) {
        _: pg_trap_at(instance, I64{1}, fid, offset)
        return
    }
    jet_rt_mem_move(wrapping(pg_word(memory) + start), wrapping(wrapping(desc + pg_word(wrapping(record + I64{24}))) + origin), length)
}

#Export(c) jet_plugin_data_drop: fn(instance: I64, segment: I64) {
    rt_text_put(wrapping(pg_word(wrapping(instance + PG_INST_DATA_DROPPED)) + segment), I64{1})
}

#Export(c) jet_plugin_table_size: fn(instance: I64, index: I64) -> I64 { pg_word(wrapping(pg_table(instance, index) + I64{8})) }

#Export(c) jet_plugin_table_grow: fn(instance: I64, index: I64, value: I64, delta: I64, fid: I64, offset: I64) -> I64 {
    table: pg_table(instance, index)
    size: pg_word(wrapping(table + I64{8}))
    wanted: size + delta.bit_and(PG_U32)
    maximum: pg_word(wrapping(table + I64{16}))
    if (maximum >= I64{0} && wanted > maximum) -> return I64{-1}
    if (wanted > PG_MAX_TABLE) {
        pg_set_trap(instance, PG_TRAP_TABLE, jet_rt_string_clone(rt_static_text("table budget exhausted")))
        jet_plugin_frame(instance, fid, offset)
        return I64{-1}
    }
    data: pg_word(table)
    at := size
    loop at < wanted {
        pg_store(wrapping(data + at * I64{8}), value)
        at += I64{1}
    }
    pg_store(wrapping(table + I64{8}), wanted)
    size
}

#Export(c) jet_plugin_table_get: fn(instance: I64, index: I64, slot: I64, fid: I64, offset: I64) -> I64 {
    table: pg_table(instance, index)
    at: slot.bit_and(PG_U32)
    if (at >= pg_word(wrapping(table + I64{8}))) -> return pg_trap_at(instance, I64{10}, fid, offset)
    pg_word(wrapping(pg_word(table) + at * I64{8}))
}

#Export(c) jet_plugin_table_set: fn(instance: I64, index: I64, slot: I64, value: I64, fid: I64, offset: I64) {
    table: pg_table(instance, index)
    at: slot.bit_and(PG_U32)
    if (at >= pg_word(wrapping(table + I64{8}))) {
        _: pg_trap_at(instance, I64{10}, fid, offset)
        return
    }
    pg_store(wrapping(pg_word(table) + at * I64{8}), value)
}

#Export(c) jet_plugin_table_fill: fn(instance: I64, index: I64, slot: I64, value: I64, count: I64, fid: I64, offset: I64) {
    table: pg_table(instance, index)
    start: slot.bit_and(PG_U32)
    length: count.bit_and(PG_U32)
    if !pg_in_bounds(start, length, pg_word(wrapping(table + I64{8}))) {
        _: pg_trap_at(instance, I64{10}, fid, offset)
        return
    }
    at := I64{0}
    loop at < length {
        pg_store(wrapping(pg_word(table) + (start + at) * I64{8}), value)
        at += I64{1}
    }
}

#Export(c) jet_plugin_table_copy: fn(instance: I64, target_table: I64, source_table: I64, target: I64, source: I64, count: I64, fid: I64, offset: I64) {
    to: pg_table(instance, target_table)
    from: pg_table(instance, source_table)
    start: target.bit_and(PG_U32)
    origin: source.bit_and(PG_U32)
    length: count.bit_and(PG_U32)
    if (!pg_in_bounds(start, length, pg_word(wrapping(to + I64{8}))) || !pg_in_bounds(origin, length, pg_word(wrapping(from + I64{8})))) {
        _: pg_trap_at(instance, I64{10}, fid, offset)
        return
    }
    jet_rt_mem_move(wrapping(pg_word(to) + start * I64{8}), wrapping(pg_word(from) + origin * I64{8}), length * I64{8})
}

#Export(c) jet_plugin_table_init: fn(instance: I64, index: I64, segment: I64, target: I64, source: I64, count: I64, fid: I64, offset: I64) {
    desc: pg_word(wrapping(instance + PG_INST_DESC))
    record: wrapping(wrapping(desc + pg_desc(desc, I64{20})) + segment * I64{40})
    dropped: rt_text_byte(wrapping(pg_word(wrapping(instance + PG_INST_ELEM_DROPPED)) + segment)) != I64{0}
    available: if dropped -> I64{0} else -> pg_word(wrapping(record + I64{32}))
    table: pg_table(instance, index)
    start: target.bit_and(PG_U32)
    origin: source.bit_and(PG_U32)
    length: count.bit_and(PG_U32)
    if (!pg_in_bounds(start, length, pg_word(wrapping(table + I64{8}))) || !pg_in_bounds(origin, length, available)) {
        _: pg_trap_at(instance, I64{10}, fid, offset)
        return
    }
    coll_copy(wrapping(wrapping(desc + pg_word(wrapping(record + I64{24}))) + origin * I64{8}), wrapping(pg_word(table) + start * I64{8}), length * I64{8})
}

#Export(c) jet_plugin_elem_drop: fn(instance: I64, segment: I64) {
    rt_text_put(wrapping(pg_word(wrapping(instance + PG_INST_ELEM_DROPPED)) + segment), I64{1})
}

// call_indirect: the checked target function index, or 0 with the trap set
// (the caller tests the trap word before using the result).
#Export(c) jet_plugin_table_fid: fn(instance: I64, index: I64, slot: I64, signature: I64, fid: I64, offset: I64) -> I64 {
    table: pg_table(instance, index)
    at: slot.bit_and(PG_U32)
    if (at >= pg_word(wrapping(table + I64{8}))) -> return pg_trap_at(instance, I64{5}, fid, offset)
    entry: pg_word(wrapping(pg_word(table) + at * I64{8}))
    if (entry == I64{0}) -> return pg_trap_at(instance, I64{6}, fid, offset)
    target: entry - I64{1}
    desc: pg_word(wrapping(instance + PG_INST_DESC))
    if (pg_word(wrapping(wrapping(wrapping(desc + pg_desc(desc, I64{22})) + target * I64{40}) + I64{32})) != signature) -> return pg_trap_at(instance, I64{7}, fid, offset)
    target
}

// ---- numeric helpers -------------------------------------------------------------

#Export(c) jet_plugin_clz: fn(value: I64, width: I64) -> I64 {
    count := I64{0}
    bit := width - I64{1}
    loop bit >= (I64{0}) && (value >> bit).bit_and(I64{1}) == (I64{0}) {
        count += I64{1}
        bit -= I64{1}
    }
    count
}

#Export(c) jet_plugin_ctz: fn(value: I64, width: I64) -> I64 {
    count := I64{0}
    loop count < width && (value >> count).bit_and(I64{1}) == (I64{0}) -> count += I64{1}
    count
}

#Export(c) jet_plugin_popcnt: fn(value: I64, width: I64) -> I64 {
    count := I64{0}
    bit := I64{0}
    loop bit < width {
        count += (value >> bit).bit_and(I64{1})
        bit += I64{1}
    }
    count
}

// Float -> integer truncation over the IEEE bits. mode: 1 unsigned, 2 64-bit
// target, 4 saturating. A non-saturating NaN or out-of-range input traps.
#Export(c) jet_plugin_trunc: fn(instance: I64, value: Float, mode: I64, fid: I64, offset: I64) -> I64 {
    bits: rt_f64_bits(value)
    unsigned: mode.bit_and(I64{1}) != I64{0}
    wide: mode.bit_and(I64{2}) != I64{0}
    saturating: mode.bit_and(I64{4}) != I64{0}
    negative: bits < I64{0}
    exponent: (bits >> I64{52}).bit_and(I64{2047})
    fraction: bits.bit_and(I64{4503599627370495})
    if (exponent == I64{2047} && fraction != I64{0}) {
        if saturating -> return I64{0}
        return pg_trap_at(instance, I64{4}, fid, offset)
    }
    // Magnitude bound: the integer part must stay below 2^limit (2^63 for
    // signed 64, 2^64 for unsigned 64), where signed negatives may reach -2&&(limit).
    limit: if wide -> (if unsigned -> I64{64} else -> I64{63}) else -> (if unsigned -> I64{32} else -> I64{31})
    power: exponent - I64{1023}
    overflow := exponent == I64{2047} || power >= limit
    if (negative && !unsigned && power == limit && fraction == I64{0} && exponent != I64{2047}) -> overflow = false
    magnitude := I64{0}
    if (!overflow && power >= I64{0}) {
        mantissa: fraction.bit_or(I64{4503599627370496})
        magnitude = if (power >= I64{52}) -> mantissa << (power - I64{52}) else -> mantissa >> (I64{52} - power)
    }
    if (unsigned && negative && magnitude != I64{0}) -> overflow = true
    if overflow {
        if !saturating -> return pg_trap_at(instance, I64{4}, fid, offset)
        if negative -> return if unsigned -> I64{0} else -> (if wide -> I64{-9223372036854775807} - I64{1} else -> I64{-2147483648})
        if unsigned -> return if wide -> I64{-1} else -> PG_U32
        return if wide -> I64{9223372036854775807} else -> I64{2147483647}
    }
    if negative -> return wrapping(I64{0} - magnitude)
    magnitude
}

// The Float nearest the unsigned 64-bit `magnitude` with `digits` significant
// bits (53 for an f64, 24 for an f32), ties to even. Every step is exact, so
// the value rounds once, and the f32 demote of a 24-bit result is exact.
pg_round_magnitude: fn(magnitude: I64, digits: I64) -> Float {
    if (magnitude >= I64{0} && magnitude < (I64{1} << digits)) -> return Float{magnitude}
    // `shift` drops the bits below the kept `digits`: a set top bit is bit 63.
    shift := if (magnitude < I64{0}) -> I64{64} - digits else -> I64{1}
    loop magnitude >= (I64{0}) && (magnitude >> (digits + shift)) != (I64{0}) {
        shift = shift + I64{1}
    }
    kept := (magnitude >> shift).bit_and(I64{9223372036854775807} >> (shift - I64{1}))
    rest: magnitude.bit_and((I64{1} << shift) - I64{1})
    half: I64{1} << (shift - I64{1})
    if (rest > half || (rest == half && kept.bit_and(I64{1}) != I64{0})) -> kept = kept + I64{1}
    Float{kept} * Float{I64{1} << shift}
}

#Export(c) jet_plugin_f64_from_u64: fn(value: I64) -> Float { pg_round_magnitude(value, I64{53}) }

// f32.convert_i64_s (`unsigned` 0) and f32.convert_i64_u (`unsigned` 1): the
// nearest f32, as the Float that holds it exactly.
#Export(c) jet_plugin_f32_from_i64: fn(value: I64, unsigned: I64) -> Float {
    if (unsigned != I64{0} || value >= I64{0}) -> return pg_round_magnitude(value, I64{24})
    // i64 min negates to itself, which reads as the unsigned 2^63.
    jet_plugin_f64_neg(pg_round_magnitude(wrapping(I64{0} - value), I64{24}))
}

#Export(c) jet_plugin_f64_min: fn(left: Float, right: Float) -> Float {
    if (left != left) -> return left
    if (right != right) -> return right
    if (left == right) -> return if (rt_f64_bits(left) < I64{0}) -> left else -> right
    if (left < right) -> left else -> right
}

#Export(c) jet_plugin_f64_max: fn(left: Float, right: Float) -> Float {
    if (left != left) -> return left
    if (right != right) -> return right
    if (left == right) -> return if (rt_f64_bits(left) < I64{0}) -> right else -> left
    if (left > right) -> left else -> right
}

#Export(c) jet_plugin_f64_copysign: fn(magnitude: Float, sign: Float) -> Float {
    bits: rt_f64_bits(magnitude).bit_and(I64{9223372036854775807})
    rt_f64_from_bits(bits.bit_or(rt_f64_bits(sign).bit_and(I64{-9223372036854775807} - I64{1})))
}

#Export(c) jet_plugin_f64_abs: fn(value: Float) -> Float { rt_f64_from_bits(rt_f64_bits(value).bit_and(I64{9223372036854775807})) }

#Export(c) jet_plugin_f64_neg: fn(value: Float) -> Float { rt_f64_from_bits(rt_f64_bits(value).bit_xor(I64{-9223372036854775807} - I64{1})) }

#Export(c) jet_plugin_f64_nearest: fn(value: Float) -> Float {
    if (value != value) -> return value
    low: jet_std_math_floor(value)
    diff: value - low
    result := low
    if (diff > Float{0.5}) {
        result = low + Float{1.0}
    } else if (diff == Float{0.5}) {
        half: low * Float{0.5}
        if (jet_std_math_floor(half) != half) -> result = low + Float{1.0}
    }
    jet_plugin_f64_copysign(result, value)
}

#Export(c) jet_plugin_f64_bits: fn(value: Float) -> I64 { rt_f64_bits(value) }
#Export(c) jet_plugin_f64_from_bits: fn(bits: I64) -> Float { rt_f64_from_bits(bits) }

// ---- authority and artifact reads -----------------------------------------

pg_starts: fn(text: I64, data: I64, length: I64) -> Bool {
    rt_text_len(text) >= length && rt_text_equal_bytes(rt_text_data(text), data, length)
}

// Whether some held right covers the right family `family` (or names a
// resource scope below it).
pg_holds_family: fn(wire: I64, family: I64) -> Bool {
    data: rt_text_data(wire)
    length: rt_text_len(wire)
    start := I64{0}
    at := I64{0}
    loop at <= length {
        if (at == length || rt_text_byte(wrapping(data + at)) == I64{10}) {
            if (at > start) {
                right: rt_text_copy(wrapping(data + start), at - start)
                covered: authority_covers(right, family) || authority_covers(family, right)
                jet_rt_string_drop(right)
                if covered -> return true
            }
            start = at + I64{1}
        }
        at += I64{1}
    }
    false
}

// The cwd-relative path below one explicit `{family}("root")` right: 0 when it
// does not apply, else the remainder after the root as an owned Text. Root
// `repo` and `.` admit any relative path. `error` receives a policy refusal.
pg_relative: fn(path: I64, root: I64, error: I64) -> I64 {
    length: rt_text_len(path)
    data: rt_text_data(path)
    if (length > I64{0} && rt_text_byte(data) == I64{47}) {
        if (rt_text_len(root) == I64{0} || rt_text_byte(rt_text_data(root)) != I64{47}) {
            pg_store(error, jet_rt_string_clone(rt_static_text("an absolute plugin path requires an absolute explicit FS.Read root")))
            return I64{0}
        }
    } else {
        // Reject `..` components in a relative path.
        at := I64{0}
        start := I64{0}
        loop at <= length {
            if (at == length || rt_text_byte(wrapping(data + at)) == I64{47}) {
                if (at - start == I64{2} && rt_text_byte(wrapping(data + start)) == I64{46} && rt_text_byte(wrapping(wrapping(data + start) + I64{1})) == I64{46}) {
                    pg_store(error, jet_rt_string_clone(rt_static_text("plugin path must be relative and must not contain `..`")))
                    return I64{0}
                }
                start = at + I64{1}
            }
            at += I64{1}
        }
    }
    root_len: rt_text_len(root)
    root_data: rt_text_data(root)
    any: (root_len == I64{4} && rt_text_equal_bytes(root_data, rt_text_data(rt_static_text("repo")), I64{4})) || (root_len == I64{1} && rt_text_byte(root_data) == I64{46})
    if any -> return rt_text_copy(data, length)
    trimmed := root_len
    loop trimmed > (I64{1}) && rt_text_byte(wrapping(wrapping(root_data + trimmed) - I64{1})) == (I64{47}) -> trimmed -= I64{1}
    if (length <= trimmed || !rt_text_equal_bytes(data, root_data, trimmed) || rt_text_byte(wrapping(data + trimmed)) != I64{47}) -> return I64{0}
    rest := trimmed + I64{1}
    loop rest < length && rt_text_byte(wrapping(data + rest)) == (I64{47}) -> rest += I64{1}
    if (rest == length) {
        pg_store(error, jet_rt_string_clone(rt_static_text("plugin path names the FS.Read root, not a file")))
        return I64{0}
    }
    rt_text_copy(wrapping(data + rest), length - rest)
}

pg_root_text: fn(root: I64) -> I64 {
    if (rt_text_len(root) == I64{4} && rt_text_equal_bytes(rt_text_data(root), rt_text_data(rt_static_text("repo")), I64{4})) -> return jet_rt_string_clone(rt_static_text("."))
    jet_rt_string_clone(root)
}

pg_errno_text: fn(errno: I64) -> I64 {
    if (errno == I64{-40}) -> return jet_rt_string_clone(rt_static_text("file authority path contains a symlink"))
    if (errno == I64{-18}) -> return jet_rt_string_clone(rt_static_text("file authority path escapes its root"))
    if (errno == I64{-2}) -> return jet_rt_string_clone(rt_static_text("No such file or directory (os error 2)"))
    if (errno == I64{-13}) -> return jet_rt_string_clone(rt_static_text("Permission denied (os error 13)"))
    text: jet_rt_string_builder_new()
    jet_rt_string_builder_push(text, rt_static_text("os error "))
    rt_text_push_number(text, I64{0} - errno)
    text
}

// Reads all of `fd` into a fresh Text, or returns 0 (errno in `error`).
pg_read_fd: fn(fd: I64, error: I64) -> I64 {
    text: jet_rt_string_builder_new()
    chunk: jet_rt_alloc(I64{65536}, I64{8})
    loop {
        count: trap_syscall(I64{0}, fd, chunk, I64{65536}, I64{0}, I64{0}, I64{0})
        if (count > I64{0}) {
            rt_text_append(text, chunk, count)
        } else if (count == I64{0}) {
            jet_rt_free(chunk, I64{65536}, I64{8})
            return text
        } else if (count != I64{-4}) {
            jet_rt_free(chunk, I64{65536}, I64{8})
            jet_rt_string_drop(text)
            pg_store(error, count)
            return I64{0}
        }
    }
}

// Linux x86-64 open flags for the rooted read: O_CLOEXEC, O_NOFOLLOW,
// O_DIRECTORY, and openat2's RESOLVE_BENEATH | RESOLVE_NO_SYMLINKS.
PG_O_CLOEXEC: I64{524288}
PG_O_NOFOLLOW: I64{131072}
PG_O_DIRECTORY: I64{65536}
PG_RESOLVE_BENEATH_NO_SYMLINKS: I64{12}

// An owned NUL-terminated copy of `path` (length + 1 bytes), or 0 when the
// text holds a NUL byte.
pg_cpath: fn(path: I64) -> I64 {
    length: rt_text_len(path)
    data: rt_text_data(path)
    at := I64{0}
    loop at < length {
        if (rt_text_byte(wrapping(data + at)) == I64{0}) -> return I64{0}
        at += I64{1}
    }
    result: jet_rt_alloc(length + I64{1}, I64{1})
    rt_text_bytes_copy(result, data, length)
    rt_text_put(wrapping(result + length), I64{0})
    result
}

// close(2); not retried, since Linux releases the descriptor even on EINTR.
pg_close: fn(fd: I64) {
    if (fd >= I64{0}) {
        _ := trap_syscall(I64{3}, fd, I64{0}, I64{0}, I64{0}, I64{0}, I64{0})
    }
}

// openat(2) of the root directory (following symlinks, as the root right
// names it), retrying EINTR.
pg_open_dir: fn(path: I64) -> I64 {
    fd := I64{-4}
    loop fd == (I64{-4}) {
        fd = trap_syscall(I64{257}, I64{-100}, path, PG_O_DIRECTORY.bit_or(PG_O_CLOEXEC), I64{0}, I64{0}, I64{0})
    }
    fd
}

// openat2(2) of `name` below `dir`, read-only, refusing every symlink and
// any escape from `dir`. `how` is 24 writable scratch bytes.
pg_open_beneath: fn(dir: I64, name: I64, how: I64) -> I64 {
    rt_text_store(how, PG_O_NOFOLLOW.bit_or(PG_O_CLOEXEC))
    rt_text_store(wrapping(how + I64{8}), I64{0})
    rt_text_store(wrapping(how + I64{16}), PG_RESOLVE_BENEATH_NO_SYMLINKS)
    trap_syscall(I64{437}, dir, name, how, I64{24}, I64{0}, I64{0})
}

// Opens `relative` below `root` without following any symlink and reads it.
// Returns the bytes, or 0 with an owned message in `error`.
pg_read_below: fn(root: I64, relative: I64, error: I64) -> I64 {
    root_path: pg_cpath(root)
    name: pg_cpath(relative)
    if (root_path == I64{0} || name == I64{0}) {
        if (root_path != I64{0}) -> jet_rt_free(root_path, rt_text_len(root) + I64{1}, I64{1})
        if (name != I64{0}) -> jet_rt_free(name, rt_text_len(relative) + I64{1}, I64{1})
        pg_store(error, jet_rt_string_clone(rt_static_text("file authority path contains a NUL byte")))
        return I64{0}
    }
    scratch: jet_rt_alloc(I64{32}, I64{8})
    dir: pg_open_dir(root_path)
    file := dir
    if (dir >= I64{0}) {
        file = pg_open_beneath(dir, name, scratch)
        pg_close(dir)
    }
    jet_rt_free(root_path, rt_text_len(root) + I64{1}, I64{1})
    jet_rt_free(name, rt_text_len(relative) + I64{1}, I64{1})
    if (file < I64{0}) {
        jet_rt_free(scratch, I64{32}, I64{8})
        pg_store(error, pg_errno_text(file))
        return I64{0}
    }
    pg_store(scratch, I64{0})
    bytes: pg_read_fd(file, scratch)
    pg_close(file)
    if (bytes == I64{0}) -> pg_store(error, pg_errno_text(pg_word(scratch)))
    jet_rt_free(scratch, I64{32}, I64{8})
    bytes
}

// The scoped read behind the guest's FS.Read import: the file below the first
// `{family}("root")` right that admits `path`, read without following symlinks.
// Returns the bytes, or 0 with an owned message in `error` and the failure
// kind in `error + 8` (Denied for policy, Guest for the read itself).
pg_scoped_read: fn(path: I64, wire: I64, family: I64, error: I64) -> I64 {
    data: rt_text_data(wire)
    length: rt_text_len(wire)
    prefix: jet_rt_string_builder_new()
    jet_rt_string_builder_push(prefix, family)
    jet_rt_string_builder_push(prefix, rt_static_text("(\""))
    saw := false
    last := I64{0}
    start := I64{0}
    at := I64{0}
    loop at <= length {
        if (at == length || rt_text_byte(wrapping(data + at)) == I64{10}) {
            right: rt_text_copy(wrapping(data + start), at - start)
            start = at + I64{1}
            if (pg_starts(right, rt_text_data(prefix), rt_text_len(prefix)) && authority_scope_open(right) == rt_text_len(family)) {
                saw = true
                root_raw: rt_text_copy(wrapping(rt_text_data(right) + rt_text_len(prefix)), rt_text_len(right) - rt_text_len(prefix) - I64{2})
                jet_rt_string_drop(right)
                if (rt_text_len(root_raw) == I64{0}) {
                    jet_rt_string_drop(root_raw)
                    jet_rt_string_drop(prefix)
                    jet_rt_string_drop(last)
                    detail: jet_rt_string_builder_new()
                    jet_rt_string_builder_push(detail, rt_static_text("plugin "))
                    jet_rt_string_builder_push(detail, family)
                    jet_rt_string_builder_push(detail, rt_static_text(" authority names an empty root"))
                    pg_store(error, detail)
                    pg_store(wrapping(error + I64{8}), PLUGIN_ERROR_DENIED)
                    return I64{0}
                }
                refusal: jet_rt_alloc(I64{8}, I64{8})
                pg_store(refusal, I64{0})
                relative: pg_relative(path, root_raw, refusal)
                if (pg_word(refusal) != I64{0}) {
                    jet_rt_string_drop(root_raw)
                    jet_rt_string_drop(prefix)
                    jet_rt_string_drop(last)
                    pg_store(error, pg_word(refusal))
                    pg_store(wrapping(error + I64{8}), PLUGIN_ERROR_DENIED)
                    jet_rt_free(refusal, I64{8}, I64{8})
                    return I64{0}
                }
                jet_rt_free(refusal, I64{8}, I64{8})
                if (relative != I64{0}) {
                    root: pg_root_text(root_raw)
                    failure: jet_rt_alloc(I64{8}, I64{8})
                    bytes: pg_read_below(root, relative, failure)
                    jet_rt_string_drop(root)
                    jet_rt_string_drop(relative)
                    if (bytes != I64{0}) {
                        jet_rt_free(failure, I64{8}, I64{8})
                        jet_rt_string_drop(root_raw)
                        jet_rt_string_drop(prefix)
                        jet_rt_string_drop(last)
                        return bytes
                    }
                    jet_rt_string_drop(last)
                    last = pg_word(failure)
                    jet_rt_free(failure, I64{8}, I64{8})
                }
                jet_rt_string_drop(root_raw)
            } else {
                jet_rt_string_drop(right)
            }
        }
        at += I64{1}
    }
    detail: jet_rt_string_builder_new()
    if !saw {
        jet_rt_string_builder_push(detail, rt_static_text("plugin operation requires an explicit resource-scoped "))
        jet_rt_string_builder_push(detail, family)
        jet_rt_string_builder_push(detail, rt_static_text(" authority"))
        pg_store(wrapping(error + I64{8}), PLUGIN_ERROR_DENIED)
    } else if (last == I64{0}) {
        jet_rt_string_builder_push(detail, rt_static_text("path `"))
        jet_rt_string_builder_push(detail, path)
        jet_rt_string_builder_push(detail, rt_static_text("` is outside the granted "))
        jet_rt_string_builder_push(detail, family)
        jet_rt_string_builder_push(detail, rt_static_text(" roots"))
        pg_store(wrapping(error + I64{8}), PLUGIN_ERROR_DENIED)
    } else {
        jet_rt_string_builder_push(detail, last)
        pg_store(wrapping(error + I64{8}), PLUGIN_ERROR_GUEST)
    }
    jet_rt_string_drop(last)
    jet_rt_string_drop(prefix)
    pg_store(error, detail)
    I64{0}
}

// ---- load and instantiation --------------------------------------------------

pg_leaf_right: fn(name: I64) -> I64 {
    data: rt_text_data(name)
    end := rt_text_len(name)
    loop end > (I64{0}) && pg_separator(rt_text_byte(wrapping(wrapping(data + end) - I64{1}))) -> end -= I64{1}
    start := end
    loop start > (I64{0}) && !pg_separator(rt_text_byte(wrapping(wrapping(data + start) - I64{1}))) -> start -= I64{1}
    raw_leaf: rt_text_copy(wrapping(data + start), end - start)
    leaf: rt_text_ascii(raw_leaf, false)
    jet_rt_string_drop(raw_leaf)
    right := I64{0}
    if (pg_is(leaf, rt_static_text("read")) || pg_is(leaf, rt_static_text("read_bytes")) || pg_is(leaf, rt_static_text("readbytes"))) {
        right = rt_static_text("FS.Read")
    } else if (pg_is(leaf, rt_static_text("write")) || pg_is(leaf, rt_static_text("write_bytes")) || pg_is(leaf, rt_static_text("writebytes"))) {
        right = rt_static_text("FS.Write")
    } else if (pg_is(leaf, rt_static_text("connect")) || pg_is(leaf, rt_static_text("request"))) {
        right = rt_static_text("Net.Connect")
    } else if (pg_is(leaf, rt_static_text("run")) || pg_is(leaf, rt_static_text("exec"))) {
        right = rt_static_text("Exec")
    }
    jet_rt_string_drop(leaf)
    right
}

pg_separator: fn(byte: I64) -> Bool { byte == I64{58} || byte == I64{47} || byte == I64{46} || byte == I64{64} || byte == I64{45} }

pg_is: fn(text: I64, other: I64) -> Bool { jet_rt_string_eq(text, other) }

// Import preflight: every import names a right family that the loading
// package's `authority.needs` declares and the load authority holds, before
// anything runs.
pg_preflight: fn(plugin: I64, desc: I64, path: I64) -> I64 {
    wire: pg_word(wrapping(plugin + PG_PLUGIN_WIRE))
    needs: pg_desc_text(desc, I64{23})
    count: pg_desc(desc, I64{9})
    records: wrapping(desc + pg_desc(desc, I64{10}))
    at := I64{0}
    loop at < count {
        record: wrapping(records + at * I64{64})
        name: pg_text(wrapping(desc + pg_word(record)), pg_word(wrapping(record + I64{8})))
        right: pg_leaf_right(name)
        detail: jet_rt_string_builder_new()
        kind := I64{-1}
        if (right == I64{0}) {
            jet_rt_string_builder_push(detail, rt_static_text("plugin import `"))
            jet_rt_string_builder_push(detail, name)
            jet_rt_string_builder_push(detail, rt_static_text("` has no declared authority fact"))
            kind = PLUGIN_ERROR_GUEST
        } else if !pg_holds_family(needs, right) {
            jet_rt_string_builder_push(detail, rt_static_text("plugin host import `"))
            jet_rt_string_builder_push(detail, name)
            jet_rt_string_builder_push(detail, rt_static_text("` denied: the loading package's `authority.needs` does not declare `"))
            jet_rt_string_builder_push(detail, right)
            rt_text_push_word(detail, I64{96}, I64{1})
            kind = PLUGIN_ERROR_DENIED
        } else if !pg_holds_family(wire, right) {
            jet_rt_string_builder_push(detail, rt_static_text("plugin host import `"))
            jet_rt_string_builder_push(detail, name)
            jet_rt_string_builder_push(detail, rt_static_text("` denied: missing `"))
            jet_rt_string_builder_push(detail, right)
            rt_text_push_word(detail, I64{96}, I64{1})
            kind = PLUGIN_ERROR_DENIED
        }
        jet_rt_string_drop(name)
        if (kind >= I64{0}) {
            message: pg_path_detail(rt_static_text("plugin `"), path, rt_static_text("` host-import preflight failed: "))
            jet_rt_string_builder_push(message, detail)
            jet_rt_string_drop(detail)
            jet_rt_string_drop(needs)
            return pg_load_failure(kind, message)
        }
        jet_rt_string_drop(detail)
        at += I64{1}
    }
    jet_rt_string_drop(needs)
    I64{0}
}

// Allocates the instance, its memories, tables and globals, applies the
// active segments and runs the start functions. 0, or the load failure.
pg_instantiate: fn(plugin: I64, desc: I64, path: I64) -> I64 {
    instance: jet_rt_alloc(PG_INST_BYTES, I64{8})
    coll_zero(instance, PG_INST_BYTES)
    pg_store(wrapping(plugin + PG_PLUGIN_INST), instance)
    pg_store(wrapping(instance + PG_INST_DESC), desc)
    pg_store(wrapping(instance + PG_INST_PLUGIN), plugin)
    pg_store(wrapping(instance + PG_INST_FRAMES), jet_rt_alloc(PG_MAX_FRAMES * I64{16}, I64{8}))
    memories: pg_desc(desc, I64{11})
    pg_store(wrapping(instance + PG_INST_MEMORIES), jet_rt_alloc(memories * I64{24} + I64{8}, I64{8}))
    tables: pg_desc(desc, I64{13})
    pg_store(wrapping(instance + PG_INST_TABLES), jet_rt_alloc(tables * I64{24} + I64{8}, I64{8}))
    globals: pg_desc(desc, I64{15})
    pg_store(wrapping(instance + PG_INST_GLOBALS), jet_rt_alloc(globals * I64{8} + I64{8}, I64{8}))
    datas: pg_desc(desc, I64{17})
    pg_store(wrapping(instance + PG_INST_DATA_DROPPED), jet_rt_alloc(datas + I64{8}, I64{8}))
    coll_zero(pg_word(wrapping(instance + PG_INST_DATA_DROPPED)), datas + I64{8})
    elems: pg_desc(desc, I64{19})
    pg_store(wrapping(instance + PG_INST_ELEM_DROPPED), jet_rt_alloc(elems + I64{8}, I64{8}))
    coll_zero(pg_word(wrapping(instance + PG_INST_ELEM_DROPPED)), elems + I64{8})
    at := I64{0}
    loop at < memories {
        record: desc + pg_desc(desc, I64{12}) + at * I64{16}
        memory: pg_memory(instance, at)
        pg_store(memory, I64{0})
        pg_store(wrapping(memory + I64{8}), I64{0})
        pg_store(wrapping(memory + I64{16}), pg_word(wrapping(record + I64{8})))
        at += I64{1}
    }
    at = I64{0}
    loop at < tables {
        table: pg_table(instance, at)
        pg_store(table, I64{0})
        pg_store(wrapping(table + I64{8}), I64{0})
        pg_store(wrapping(table + I64{16}), I64{0})
        at += I64{1}
    }
    at = I64{0}
    loop at < memories {
        record: desc + pg_desc(desc, I64{12}) + at * I64{16}
        pages: pg_word(record)
        if (pages > PG_MAX_PAGES) -> return pg_instantiate_failure(PLUGIN_ERROR_BUDGET, PG_LIMIT_MEMORY, path, rt_static_text("memory budget exhausted"))
        base: pg_mmap(PG_MAX_PAGES * PG_PAGE)
        if (base == I64{0}) -> return pg_instantiate_failure(PLUGIN_ERROR_DEFECT, I64{0}, path, rt_static_text("couldn't reserve plugin linear memory"))
        memory: pg_memory(instance, at)
        pg_store(memory, base)
        pg_store(wrapping(memory + I64{8}), pages * PG_PAGE)
        at += I64{1}
    }
    at = I64{0}
    loop at < tables {
        record: desc + pg_desc(desc, I64{14}) + at * I64{16}
        size: pg_word(record)
        if (size > PG_MAX_TABLE) -> return pg_instantiate_failure(PLUGIN_ERROR_BUDGET, PG_LIMIT_TABLE, path, rt_static_text("table budget exhausted"))
        data: pg_mmap(PG_MAX_TABLE * I64{8})
        if (data == I64{0}) -> return pg_instantiate_failure(PLUGIN_ERROR_DEFECT, I64{0}, path, rt_static_text("couldn't reserve a plugin table"))
        table: pg_table(instance, at)
        pg_store(table, data)
        pg_store(wrapping(table + I64{8}), size)
        pg_store(wrapping(table + I64{16}), pg_word(wrapping(record + I64{8})))
        at += I64{1}
    }
    at = I64{0}
    loop at < globals {
        pg_store(wrapping(pg_word(wrapping(instance + PG_INST_GLOBALS)) + at * I64{8}), pg_word(wrapping(wrapping(desc + pg_desc(desc, I64{16})) + at * I64{8})))
        at += I64{1}
    }
    at = I64{0}
    loop at < datas {
        record: desc + pg_desc(desc, I64{18}) + at * I64{40}
        if (pg_word(record) == I64{1}) {
            memory: pg_memory(instance, pg_word(wrapping(record + I64{8})))
            start: pg_word(wrapping(record + I64{16})).bit_and(PG_U32)
            length: pg_word(wrapping(record + I64{32}))
            if !pg_in_bounds(start, length, pg_word(wrapping(memory + I64{8}))) -> return pg_instantiate_failure(PLUGIN_ERROR_GUEST, I64{0}, path, rt_static_text("out of bounds memory access"))
            jet_rt_mem_move(wrapping(pg_word(memory) + start), wrapping(desc + pg_word(wrapping(record + I64{24}))), length)
            rt_text_put(wrapping(pg_word(wrapping(instance + PG_INST_DATA_DROPPED)) + at), I64{1})
        }
        at += I64{1}
    }
    at = I64{0}
    loop at < elems {
        record: desc + pg_desc(desc, I64{20}) + at * I64{40}
        mode: pg_word(record)
        if (mode == I64{0}) {
            table: pg_table(instance, pg_word(wrapping(record + I64{8})))
            start: pg_word(wrapping(record + I64{16})).bit_and(PG_U32)
            length: pg_word(wrapping(record + I64{32}))
            if !pg_in_bounds(start, length, pg_word(wrapping(table + I64{8}))) -> return pg_instantiate_failure(PLUGIN_ERROR_GUEST, I64{0}, path, rt_static_text("out of bounds table access"))
            coll_copy(wrapping(desc + pg_word(wrapping(record + I64{24}))), wrapping(pg_word(table) + start * I64{8}), length * I64{8})
        }
        if (mode != I64{1}) -> rt_text_put(wrapping(pg_word(wrapping(instance + PG_INST_ELEM_DROPPED)) + at), I64{1})
        at += I64{1}
    }
    pg_reset(instance)
    _: pg_guest(plugin, I64{-2})
    kind: pg_word(wrapping(instance + PG_INST_TRAP))
    if (kind != I64{0}) {
        error: pg_trap_failure(instance, kind, I64{0}, false)
        detail: pg_path_detail(rt_static_text("plugin `"), path, rt_static_text("` couldn't be instantiated under its authority scope: "))
        fault: pg_word(wrapping(error + PLUGIN_ERROR_FAULT))
        jet_rt_string_builder_push(detail, pg_word(wrapping(fault + PLUGIN_FAULT_MESSAGE)))
        result: pg_load_failure(pg_word(wrapping(error + PLUGIN_ERROR_TAG)), detail)
        pg_store(wrapping(result + PLUGIN_ERROR_LIMIT), pg_word(wrapping(error + PLUGIN_ERROR_LIMIT)))
        jet_rt_handle_drop_plugin_error(error)
        return result
    }
    I64{0}
}

pg_instantiate_failure: fn(kind: I64, limit: I64, path: I64, reason: I64) -> I64 {
    detail: pg_path_detail(rt_static_text("plugin `"), path, rt_static_text("` couldn't be instantiated under its authority scope: "))
    jet_rt_string_builder_push(detail, reason)
    result: pg_load_failure(kind, detail)
    pg_store(wrapping(result + PLUGIN_ERROR_LIMIT), limit)
    result
}

pg_reset: fn(instance: I64) {
    pg_store(wrapping(instance + PG_INST_TRAP), I64{0})
    jet_rt_string_drop(pg_word(wrapping(instance + PG_INST_MESSAGE)))
    pg_store(wrapping(instance + PG_INST_MESSAGE), I64{0})
    pg_store(wrapping(instance + PG_INST_FUEL), PG_FUEL_SLICE)
    pg_store(wrapping(instance + PG_INST_FUEL_RESERVE), PG_FUEL - PG_FUEL_SLICE)
    pg_store(wrapping(instance + PG_INST_DEADLINE), time_host_monotonic_i64() + PG_TIME_NS)
    pg_store(wrapping(instance + PG_INST_DEPTH), I64{0})
    pg_store(wrapping(instance + PG_INST_FRAME_COUNT), I64{0})
}

pg_load: fn(plugin: I64, path: I64, wire: I64) -> I64 {
    if (pg_word(wrapping(plugin + PG_PLUGIN_GUEST)) == I64{0}) {
        return pg_load_failure(PLUGIN_ERROR_GUEST, pg_path_detail(rt_static_text("couldn't load plugin `"), path, rt_static_text("`: the artifact was not embedded when this program was built (plugin.load needs a literal artifact path)")))
    }
    desc: pg_guest(plugin, I64{-1})
    pg_store(wrapping(plugin + PG_PLUGIN_DESC), desc)
    if !pg_holds_family(wire, rt_static_text("FS.Read")) -> return pg_load_failure(PLUGIN_ERROR_DENIED, jet_rt_string_clone(rt_static_text("plugin load requires an FS.Read authority")))
    error: jet_rt_alloc(I64{16}, I64{8})
    bytes: pg_scoped_read(path, wire, rt_static_text("FS.Read"), error)
    if (bytes == I64{0}) {
        kind: pg_word(wrapping(error + I64{8}))
        detail: pg_word(error)
        jet_rt_free(error, I64{16}, I64{8})
        return pg_load_failure(kind, detail)
    }
    jet_rt_free(error, I64{16}, I64{8})
    built: pg_desc(desc, I64{6})
    same: rt_text_len(bytes) == built && rt_text_equal_bytes(rt_text_data(bytes), wrapping(desc + pg_desc(desc, I64{5})), built)
    jet_rt_string_drop(bytes)
    if !same -> return pg_load_failure(PLUGIN_ERROR_GUEST, pg_path_detail(rt_static_text("couldn't load plugin `"), path, rt_static_text("`: the artifact changed since this program was built; rebuild the host")))
    if (pg_desc(desc, I64{2}) != I64{0}) {
        detail: pg_path_detail(rt_static_text("couldn't load plugin `"), path, rt_static_text("`: "))
        rt_text_append(detail, desc + pg_desc(desc, I64{1}), pg_desc(desc, I64{2}))
        return pg_load_failure(PLUGIN_ERROR_GUEST, detail)
    }
    preflight: pg_preflight(plugin, desc, path)
    if (preflight != I64{0}) -> return preflight
    pg_instantiate(plugin, desc, path)
}

#Export(c) jet_plugin_load: fn(path: I64, wire: I64, guest: I64) -> I64 {
    code: jet_int_owned_to_i64(guest)
    plugin: jet_rt_alloc(PG_PLUGIN_BYTES, I64{8})
    coll_zero(plugin, PG_PLUGIN_BYTES)
    pg_store(wrapping(plugin + PG_PLUGIN_RC), I64{1})
    pg_store(wrapping(plugin + PG_PLUGIN_GUEST), code)
    pg_store(wrapping(plugin + PG_PLUGIN_WIRE), jet_rt_string_clone(wire))
    pg_store(wrapping(plugin + PG_PLUGIN_PATH), jet_rt_string_clone(path))
    pg_store(wrapping(plugin + PG_PLUGIN_AREA), jet_rt_alloc(PG_AREA_BYTES, I64{8}))
    pg_store(wrapping(plugin + PG_PLUGIN_ARG_CAP), I64{8})
    pg_store(wrapping(plugin + PG_PLUGIN_ARG_DATA), jet_rt_alloc(I64{8} * PG_ARG_BYTES, I64{8}))
    pg_store(wrapping(plugin + PG_PLUGIN_FAILURE), pg_load(plugin, path, wire))
    plugin
}

#Export(c) jet_rt_handle_clone_jet_plugin: fn(plugin: I64) -> I64 {
    pg_store(wrapping(plugin + PG_PLUGIN_RC), pg_word(wrapping(plugin + PG_PLUGIN_RC)) + I64{1})
    plugin
}

#Export(c) jet_rt_handle_drop_jet_plugin: fn(plugin: I64) {
    if (plugin == I64{0}) -> return
    count: pg_word(wrapping(plugin + PG_PLUGIN_RC)) - I64{1}
    pg_store(wrapping(plugin + PG_PLUGIN_RC), count)
    if (count > I64{0}) -> return
    pg_clear_args(plugin)
    jet_rt_free(pg_word(wrapping(plugin + PG_PLUGIN_ARG_DATA)), pg_word(wrapping(plugin + PG_PLUGIN_ARG_CAP)) * PG_ARG_BYTES, I64{8})
    jet_rt_free(pg_word(wrapping(plugin + PG_PLUGIN_AREA)), PG_AREA_BYTES, I64{8})
    jet_rt_string_drop(pg_word(wrapping(plugin + PG_PLUGIN_WIRE)))
    jet_rt_string_drop(pg_word(wrapping(plugin + PG_PLUGIN_PATH)))
    jet_rt_handle_drop_plugin_error(pg_word(wrapping(plugin + PG_PLUGIN_FAILURE)))
    instance: pg_word(wrapping(plugin + PG_PLUGIN_INST))
    if (instance != I64{0}) {
        desc: pg_word(wrapping(instance + PG_INST_DESC))
        memories: pg_desc(desc, I64{11})
        at := I64{0}
        loop at < memories {
            pg_munmap(pg_word(pg_memory(instance, at)), PG_MAX_PAGES * PG_PAGE)
            at += I64{1}
        }
        tables: pg_desc(desc, I64{13})
        at = I64{0}
        loop at < tables {
            pg_munmap(pg_word(pg_table(instance, at)), PG_MAX_TABLE * I64{8})
            at += I64{1}
        }
        jet_rt_free(pg_word(wrapping(instance + PG_INST_MEMORIES)), memories * I64{24} + I64{8}, I64{8})
        jet_rt_free(pg_word(wrapping(instance + PG_INST_TABLES)), tables * I64{24} + I64{8}, I64{8})
        jet_rt_free(pg_word(wrapping(instance + PG_INST_GLOBALS)), pg_desc(desc, I64{15}) * I64{8} + I64{8}, I64{8})
        jet_rt_free(pg_word(wrapping(instance + PG_INST_DATA_DROPPED)), pg_desc(desc, I64{17}) + I64{8}, I64{8})
        jet_rt_free(pg_word(wrapping(instance + PG_INST_ELEM_DROPPED)), pg_desc(desc, I64{19}) + I64{8}, I64{8})
        jet_rt_free(pg_word(wrapping(instance + PG_INST_FRAMES)), PG_MAX_FRAMES * I64{16}, I64{8})
        jet_rt_string_drop(pg_word(wrapping(instance + PG_INST_MESSAGE)))
        jet_rt_free(instance, PG_INST_BYTES, I64{8})
    }
    jet_rt_free(plugin, PG_PLUGIN_BYTES, I64{8})
}

// ---- argument staging --------------------------------------------------------------

pg_push_arg: fn(plugin: I64, kind: I64, value: I64) {
    count: pg_word(wrapping(plugin + PG_PLUGIN_ARGS))
    capacity: pg_word(wrapping(plugin + PG_PLUGIN_ARG_CAP))
    if (count == capacity) {
        old: pg_word(wrapping(plugin + PG_PLUGIN_ARG_DATA))
        grown: jet_rt_alloc(capacity * I64{2} * PG_ARG_BYTES, I64{8})
        coll_copy(old, grown, capacity * PG_ARG_BYTES)
        jet_rt_free(old, capacity * PG_ARG_BYTES, I64{8})
        pg_store(wrapping(plugin + PG_PLUGIN_ARG_DATA), grown)
        pg_store(wrapping(plugin + PG_PLUGIN_ARG_CAP), capacity * I64{2})
    }
    entry: wrapping(pg_word(wrapping(plugin + PG_PLUGIN_ARG_DATA)) + count * PG_ARG_BYTES)
    pg_store(entry, kind)
    pg_store(wrapping(entry + I64{8}), value)
    pg_store(wrapping(entry + I64{16}), I64{0})
    pg_store(wrapping(plugin + PG_PLUGIN_ARGS), count + I64{1})
}

pg_clear_args: fn(plugin: I64) {
    count: pg_word(wrapping(plugin + PG_PLUGIN_ARGS))
    data: pg_word(wrapping(plugin + PG_PLUGIN_ARG_DATA))
    at := I64{0}
    loop at < count {
        entry: wrapping(data + at * PG_ARG_BYTES)
        if (pg_word(entry) == I64{3}) -> jet_rt_string_drop(pg_word(wrapping(entry + I64{8})))
        at += I64{1}
    }
    pg_store(wrapping(plugin + PG_PLUGIN_ARGS), I64{0})
}

#Export(c) jet_plugin_arg_bool: fn(plugin: I64, value: U8) { pg_push_arg(plugin, I64{0}, if (value != U8{0}) -> I64{1} else -> I64{0}) }
#Export(c) jet_plugin_arg_float: fn(plugin: I64, value: Float) { pg_push_arg(plugin, I64{1}, rt_f64_bits(value)) }
#Export(c) jet_plugin_arg_int: fn(plugin: I64, value: I64) { pg_push_arg(plugin, I64{2}, jet_int_owned_to_i64(value)) }
#Export(c) jet_plugin_arg_text: fn(plugin: I64, value: I64) { pg_push_arg(plugin, I64{3}, jet_rt_string_clone(value)) }

// ---- calls ----------------------------------------------------------------------------

pg_type_name: fn(code: I64) -> I64 {
    if (code == I64{0}) -> return rt_static_text("bool")
    if (code == I64{1}) -> return rt_static_text("s8")
    if (code == I64{2}) -> return rt_static_text("u8")
    if (code == I64{3}) -> return rt_static_text("s16")
    if (code == I64{4}) -> return rt_static_text("u16")
    if (code == I64{5}) -> return rt_static_text("s32")
    if (code == I64{6}) -> return rt_static_text("u32")
    if (code == I64{7}) -> return rt_static_text("s64")
    if (code == I64{8}) -> return rt_static_text("u64")
    if (code == I64{9}) -> return rt_static_text("float32")
    if (code == I64{10}) -> return rt_static_text("float64")
    if (code == I64{11}) -> return rt_static_text("char")
    if (code == I64{12}) -> return rt_static_text("string")
    if (code == PG_VALUE_TUPLE) -> return rt_static_text("tuple")
    rt_static_text("unsupported type")
}

pg_arg_fits: fn(kind: I64, value: I64, code: I64) -> Bool {
    if (kind == I64{0}) -> return code == I64{0}
    if (kind == I64{1}) -> return code == I64{9} || code == I64{10}
    if (kind == I64{3}) -> return code == I64{12}
    if (code == I64{1}) -> return value >= I64{-128} && value <= I64{127}
    if (code == I64{2}) -> return value >= I64{0} && value <= I64{255}
    if (code == I64{3}) -> return value >= I64{-32768} && value <= I64{32767}
    if (code == I64{4}) -> return value >= I64{0} && value <= I64{65535}
    if (code == I64{5}) -> return value >= I64{-2147483648} && value <= I64{2147483647}
    if (code == I64{6}) -> return value >= I64{0} && value <= PG_U32
    if (code == I64{7}) -> return true
    if (code == I64{8}) -> return value >= I64{0}
    false
}

// Whether result `code` is the one `want` lifts: -1 unit, 0 bool, 1 float,
// 2 int, 3 text, 4 a tuple's words.
pg_result_fits: fn(want: I64, code: I64) -> Bool {
    if (want == I64{-1}) -> return code == I64{-1}
    if (want == I64{0}) -> return code == I64{0}
    if (want == I64{1}) -> return code == I64{9} || code == I64{10}
    if (want == I64{3}) -> return code == PG_VALUE_STRING
    if (want == I64{4}) -> return code == PG_VALUE_TUPLE
    code >= I64{1} && code <= I64{8}
}

pg_find_export: fn(desc: I64, name: I64) -> I64 {
    count: pg_desc(desc, I64{7})
    records: wrapping(desc + pg_desc(desc, I64{8}))
    length: rt_text_len(name)
    data: rt_text_data(name)
    at := I64{0}
    loop at < count {
        record: wrapping(records + at * PG_EXPORT_BYTES)
        if (pg_word(wrapping(record + I64{8})) == length) {
            text: wrapping(desc + pg_word(record))
            same := true
            index := I64{0}
            loop same && index < length {
                byte: rt_text_byte(wrapping(text + index))
                folded: if (byte == I64{45}) -> I64{95} else -> byte
                if (folded != rt_text_byte(wrapping(data + index))) -> same = false
                index += I64{1}
            }
            if same -> return record
        }
        at += I64{1}
    }
    I64{0}
}

// The PluginError for the trap recorded in `instance`.
pg_trap_failure: fn(instance: I64, kind: I64, name: I64, call: Bool) -> I64 {
    message := pg_word(wrapping(instance + PG_INST_MESSAGE))
    pg_store(wrapping(instance + PG_INST_MESSAGE), I64{0})
    if (message == I64{0}) -> message = jet_rt_string_clone(rt_static_text("host/runtime failed while executing the guest"))
    detail: jet_rt_string_builder_new()
    if (kind == PG_TRAP_GUEST) -> jet_rt_string_builder_push(detail, rt_static_text("guest trapped: "))
    jet_rt_string_builder_push(detail, message)
    jet_rt_string_drop(message)
    keep: kind == PG_TRAP_GUEST || kind == PG_TRAP_FUEL || kind == PG_TRAP_TIME || kind == PG_TRAP_MEMORY || kind == PG_TRAP_TABLE
    count: if keep -> pg_word(wrapping(instance + PG_INST_FRAME_COUNT)) else -> I64{0}
    frames: jet_rt_record_seq_list_rec_plugin_frame_new(count)
    desc: pg_word(wrapping(instance + PG_INST_DESC))
    at := I64{0}
    loop at < count {
        slot: wrapping(pg_word(wrapping(instance + PG_INST_FRAMES)) + at * I64{16})
        record: wrapping(wrapping(desc + pg_desc(desc, I64{22})) + pg_word(slot) * I64{40})
        function: pg_text(wrapping(desc + pg_word(record)), pg_word(wrapping(record + I64{8})))
        component: if (pg_word(wrapping(record + I64{24})) != I64{0}) -> pg_text(wrapping(desc + pg_word(wrapping(record + I64{16}))), pg_word(wrapping(record + I64{24}))) else -> pg_desc_text(desc, I64{3})
        frame: jet_rt_record_new_plugin_frame(function, component, jet_int_owned_from_i64(pg_word(wrapping(slot + I64{8}))))
        jet_rt_string_drop(function)
        jet_rt_string_drop(component)
        if (frame != I64{0}) -> jet_rt_record_seq_list_rec_plugin_frame_push(frames, frame)
        at += I64{1}
    }
    error_kind: if (kind == PG_TRAP_DENIED) -> PLUGIN_ERROR_DENIED else if (kind == PG_TRAP_DEFECT) -> PLUGIN_ERROR_DEFECT else if (kind == PG_TRAP_GUEST || kind == PG_TRAP_USER) -> PLUGIN_ERROR_GUEST else -> PLUGIN_ERROR_BUDGET
    limit: if (kind == PG_TRAP_MEMORY) -> PG_LIMIT_MEMORY else if (kind == PG_TRAP_TABLE) -> PG_LIMIT_TABLE else if (kind == PG_TRAP_TIME) -> PG_LIMIT_TIME else -> PG_LIMIT_FUEL
    export_name: if call -> name else -> rt_static_text("load")
    pg_failure(error_kind, if (error_kind == PLUGIN_ERROR_BUDGET) -> limit else -> I64{0}, export_name, call, detail, frames)
}

pg_call_failure: fn(name: I64, kind: I64, detail: I64) -> I64 {
    pg_failure(kind, I64{0}, name, true, detail, pg_no_frames())
}

pg_count_detail: fn(want: I64, got: I64) -> I64 {
    detail: jet_rt_string_builder_new()
    jet_rt_string_builder_push(detail, rt_static_text("expects "))
    rt_text_push_number(detail, want)
    jet_rt_string_builder_push(detail, rt_static_text(" argument(s), got "))
    rt_text_push_number(detail, got)
    detail
}

// Runs the export `name` over the staged arguments. `want`: -1 unit, 0 bool,
// 1 float, 2 int, 3 text, 4 tuple. Returns 0 with the PluginError in
// `error`, or 1 with the lifted result word in `error` (Text owned, Float
// bits, int raw, a tuple's buffer of field words from pg_lift_fields).
pg_invoke: fn(plugin: I64, name: I64, want: I64, error: I64) -> I64 {
    failure: pg_word(wrapping(plugin + PG_PLUGIN_FAILURE))
    if (failure != I64{0}) {
        pg_clear_args(plugin)
        pg_store(error, jet_rt_handle_clone_plugin_error(failure))
        return I64{0}
    }
    status: pg_invoke_loaded(plugin, name, want, error)
    pg_clear_args(plugin)
    status
}

pg_invoke_loaded: fn(plugin: I64, name: I64, want: I64, error: I64) -> I64 {
    if (pg_word(wrapping(plugin + PG_PLUGIN_ACTIVE)) != I64{0}) {
        pg_store(error, pg_call_failure(name, PLUGIN_ERROR_DEFECT, jet_rt_string_clone(rt_static_text("plugin re-entry is not supported during an active call"))))
        return I64{0}
    }
    desc: pg_word(wrapping(plugin + PG_PLUGIN_DESC))
    instance: pg_word(wrapping(plugin + PG_PLUGIN_INST))
    record: pg_find_export(desc, name)
    if (record == I64{0}) {
        pg_store(error, pg_call_failure(name, PLUGIN_ERROR_GUEST, jet_rt_string_clone(rt_static_text("no exported function has this name"))))
        return I64{0}
    }
    count: pg_word(wrapping(plugin + PG_PLUGIN_ARGS))
    params: pg_word(wrapping(record + I64{24}))
    if (count != params) {
        pg_store(error, pg_call_failure(name, PLUGIN_ERROR_GUEST, pg_count_detail(params, count)))
        return I64{0}
    }
    types: wrapping(desc + pg_word(wrapping(record + I64{32})))
    args: pg_word(wrapping(plugin + PG_PLUGIN_ARG_DATA))
    flat := I64{0}
    at := I64{0}
    loop at < count {
        entry: args + at * PG_ARG_BYTES
        code: pg_word(wrapping(types + at * I64{8}))
        if !pg_arg_fits(pg_word(entry), pg_word(wrapping(entry + I64{8})), code) {
            detail: jet_rt_string_builder_new()
            jet_rt_string_builder_push(detail, rt_static_text("argument "))
            rt_text_push_number(detail, at + I64{1})
            jet_rt_string_builder_push(detail, rt_static_text(" does not match the declared type ("))
            jet_rt_string_builder_push(detail, pg_type_name(code))
            rt_text_push_word(detail, I64{41}, I64{1})
            pg_store(error, pg_call_failure(name, PLUGIN_ERROR_GUEST, detail))
            return I64{0}
        }
        if (pg_word(entry) == I64{3}) {
            length: rt_text_len(pg_word(wrapping(entry + I64{8})))
            if (length > PG_MAX_WIRE) {
                detail: jet_rt_string_builder_new()
                jet_rt_string_builder_push(detail, rt_static_text("argument "))
                rt_text_push_number(detail, at + I64{1})
                pg_store(error, pg_wire_failure(name, detail, length))
                return I64{0}
            }
        }
        flat += if (code == I64{12}) -> I64{2} else -> I64{1}
        at += I64{1}
    }
    result_code: pg_word(wrapping(record + I64{40}))
    if (!pg_result_fits(want, result_code)) {
        detail: jet_rt_string_builder_new()
        jet_rt_string_builder_push(detail, rt_static_text("returns an unsupported Component Model type ("))
        jet_rt_string_builder_push(detail, pg_type_name(result_code))
        rt_text_push_word(detail, I64{41}, I64{1})
        pg_store(error, pg_call_failure(name, PLUGIN_ERROR_GUEST, detail))
        return I64{0}
    }
    if (flat > PG_MAX_FLAT || pg_word(wrapping(record + I64{72})) != I64{0}) {
        pg_store(error, pg_call_failure(name, PLUGIN_ERROR_GUEST, jet_rt_string_clone(rt_static_text("the export's signature is outside the supported Component Model subset"))))
        return I64{0}
    }
    pg_store(wrapping(plugin + PG_PLUGIN_ACTIVE), I64{1})
    pg_reset(instance)
    area: pg_word(wrapping(plugin + PG_PLUGIN_AREA))
    // Lower the strings first: realloc runs guest code over the same area.
    at = I64{0}
    loop at < count {
        entry: args + at * PG_ARG_BYTES
        if (pg_word(entry) == I64{3}) {
            pointer: pg_lower_text(plugin, record, pg_word(wrapping(entry + I64{8})))
            if (pointer < I64{0}) -> return pg_call_trapped(plugin, name, error)
            pg_store(wrapping(entry + I64{16}), pointer)
        }
        at += I64{1}
    }
    slot := I64{0}
    at = I64{0}
    loop at < count {
        entry: args + at * PG_ARG_BYTES
        kind: pg_word(entry)
        if (kind == I64{3}) {
            pg_store(wrapping(area + slot * I64{8}), pg_word(wrapping(entry + I64{16})))
            pg_store(wrapping(area + (slot + I64{1}) * I64{8}), rt_text_len(pg_word(wrapping(entry + I64{8}))))
            slot += I64{2}
        } else {
            pg_store(wrapping(area + slot * I64{8}), pg_word(wrapping(entry + I64{8})))
            slot += I64{1}
        }
        at += I64{1}
    }
    _: pg_guest(plugin, pg_word(wrapping(record + I64{16})))
    if (pg_word(wrapping(instance + PG_INST_TRAP)) != I64{0}) -> return pg_call_trapped(plugin, name, error)
    raw: pg_word(area)
    value := pg_lift_flat(result_code, raw)
    if (result_code == PG_VALUE_STRING || result_code == PG_VALUE_TUPLE) {
        if (result_code == PG_VALUE_STRING) {
            length: pg_text_result_length(instance, pg_word(wrapping(record + I64{64})), raw.bit_and(PG_U32))
            if (length > PG_MAX_WIRE) {
                pg_store(wrapping(plugin + PG_PLUGIN_ACTIVE), I64{0})
                detail: jet_rt_string_builder_new()
                jet_rt_string_builder_push(detail, rt_static_text("the string result"))
                pg_store(error, pg_wire_failure(name, detail, length))
                return I64{0}
            }
        }
        lifted: if (result_code == PG_VALUE_STRING) -> pg_lift_text(instance, pg_word(wrapping(record + I64{64})), raw.bit_and(PG_U32)) else -> pg_lift_fields(instance, record, desc, raw)
        if (lifted == I64{0}) {
            detail: jet_rt_string_builder_new()
            jet_rt_string_builder_push(detail, rt_static_text("returned an unsupported Component Model value ("))
            jet_rt_string_builder_push(detail, pg_type_name(result_code))
            rt_text_push_word(detail, I64{41}, I64{1})
            pg_store(wrapping(plugin + PG_PLUGIN_ACTIVE), I64{0})
            pg_store(error, pg_call_failure(name, PLUGIN_ERROR_GUEST, detail))
            return I64{0}
        }
        value = lifted
    }
    post: pg_word(wrapping(record + I64{56}))
    if (post >= I64{0}) {
        pg_store(area, raw)
        _: pg_guest(plugin, post)
        if (pg_word(wrapping(instance + PG_INST_TRAP)) != I64{0}) {
            if (result_code == PG_VALUE_STRING) -> jet_rt_string_drop(value)
            if (result_code == PG_VALUE_TUPLE) -> pg_drop_fields(record, desc, value, pg_word(wrapping(record + I64{80})))
            return pg_call_trapped(plugin, name, error)
        }
    }
    pg_store(wrapping(plugin + PG_PLUGIN_ACTIVE), I64{0})
    pg_store(error, value)
    I64{1}
}

pg_call_trapped: fn(plugin: I64, name: I64, error: I64) -> I64 {
    instance: pg_word(wrapping(plugin + PG_PLUGIN_INST))
    pg_store(wrapping(plugin + PG_PLUGIN_ACTIVE), I64{0})
    pg_store(error, pg_trap_failure(instance, pg_word(wrapping(instance + PG_INST_TRAP)), name, true))
    I64{0}
}

// cabi_realloc(0, 0, 1, len) then copy: the guest address, or -1 with the
// instance trap set.
pg_lower_text: fn(plugin: I64, record: I64, text: I64) -> I64 {
    instance: pg_word(wrapping(plugin + PG_PLUGIN_INST))
    length: rt_text_len(text)
    realloc: pg_word(wrapping(record + I64{48}))
    memory_index: pg_word(wrapping(record + I64{64}))
    if (realloc < I64{0} || memory_index < I64{0}) {
        pg_set_trap(instance, PG_TRAP_USER, jet_rt_string_clone(rt_static_text("a string argument needs the export's realloc and memory options")))
        return I64{-1}
    }
    area: pg_word(wrapping(plugin + PG_PLUGIN_AREA))
    pg_store(area, I64{0})
    pg_store(wrapping(area + I64{8}), I64{0})
    pg_store(wrapping(area + I64{16}), I64{1})
    pg_store(wrapping(area + I64{24}), length)
    _: pg_guest(plugin, realloc)
    if (pg_word(wrapping(instance + PG_INST_TRAP)) != I64{0}) -> return I64{-1}
    pointer: pg_word(area).bit_and(PG_U32)
    memory: pg_memory(instance, memory_index)
    if !pg_in_bounds(pointer, length, pg_word(wrapping(memory + I64{8}))) {
        pg_set_trap(instance, PG_TRAP_USER, jet_rt_string_clone(rt_static_text("realloc returned an out-of-bounds string buffer")))
        return I64{-1}
    }
    rt_text_bytes_copy(wrapping(pg_word(memory) + pointer), rt_text_data(text), length)
    pointer
}

// The length a canonical (pointer, length) pair in guest memory declares, read
// before anything is copied out; -1 when the pair itself is out of bounds.
pg_text_result_length: fn(instance: I64, memory_index: I64, at: I64) -> I64 {
    if (memory_index < I64{0}) -> return I64{-1}
    memory: pg_memory(instance, memory_index)
    if !pg_in_bounds(at, I64{8}, pg_word(wrapping(memory + I64{8}))) -> return I64{-1}
    pg_u32(wrapping(wrapping(pg_word(memory) + at) + I64{4}))
}

// Budget(.Wire): a string argument or result over PG_MAX_WIRE bytes fails
// before the host or the guest allocates room for it. `detail` names the
// value and is adopted.
pg_wire_failure: fn(name: I64, detail: I64, length: I64) -> I64 {
    jet_rt_string_builder_push(detail, rt_static_text(" is "))
    rt_text_push_number(detail, length)
    jet_rt_string_builder_push(detail, rt_static_text(" bytes, over the "))
    rt_text_push_number(detail, PG_MAX_WIRE)
    jet_rt_string_builder_push(detail, rt_static_text("-byte wire budget"))
    pg_failure(PLUGIN_ERROR_BUDGET, PG_LIMIT_WIRE, name, true, detail, pg_no_frames())
}

// The string at a canonical (pointer, length) pair in guest memory, or 0.
pg_lift_text: fn(instance: I64, memory_index: I64, at: I64) -> I64 {
    if (memory_index < I64{0}) -> return I64{0}
    memory: pg_memory(instance, memory_index)
    size: pg_word(wrapping(memory + I64{8}))
    base: pg_word(memory)
    if !pg_in_bounds(at, I64{8}, size) -> return I64{0}
    pointer: pg_u32(wrapping(base + at))
    length: pg_u32(wrapping(wrapping(base + at) + I64{4}))
    if !pg_in_bounds(pointer, length, size) -> return I64{0}
    if !env_utf8(wrapping(base + pointer), length) -> return I64{0}
    rt_text_copy(wrapping(base + pointer), length)
}

// Scalar `code`'s value from its core word: an integer sign- or zero-extended
// from its width, a bool 0 or 1, anything else the word itself.
pg_lift_flat: fn(code: I64, raw: I64) -> I64 {
    if (code == I64{0}) -> return if (raw.bit_and(PG_U32) != I64{0}) -> I64{1} else -> I64{0}
    if (code == I64{1}) -> return ((raw << I64{56}) >> I64{56})
    if (code == I64{2}) -> return raw.bit_and(I64{255})
    if (code == I64{3}) -> return ((raw << I64{48}) >> I64{48})
    if (code == I64{4}) -> return raw.bit_and(I64{65535})
    if (code == I64{5}) -> return ((raw << I64{32}) >> I64{32})
    if (code == I64{6}) -> return raw.bit_and(PG_U32)
    raw
}

// A scalar field's canonical ABI alignment, which is also its size in
// memory (a string is a 4-aligned pointer and length).
pg_field_align: fn(code: I64) -> I64 {
    if (code <= I64{2}) -> return I64{1}
    if (code <= I64{4}) -> return I64{2}
    if (code == I64{7} || code == I64{8} || code == I64{10}) -> return I64{8}
    I64{4}
}

// A tuple result's fields as a buffer of words, one per field in order
// (pg_lift_flat's value, a float's binary64 bits, a string owned), or 0 when
// the guest's result does not hold them. Fields that flatten to one core
// value arrive as the core result itself; more arrive in the return area the
// core result points at, each field at its canonical ABI alignment.
pg_lift_fields: fn(instance: I64, record: I64, desc: I64, raw: I64) -> I64 {
    count: pg_word(wrapping(record + I64{80}))
    codes: wrapping(desc + pg_word(wrapping(record + I64{88})))
    flat := I64{0}
    align := I64{1}
    at := I64{0}
    loop at < count {
        code: pg_word(wrapping(codes + at * I64{8}))
        flat += if (code == PG_VALUE_STRING) -> I64{2} else -> I64{1}
        if (pg_field_align(code) > align) -> align = pg_field_align(code)
        at += I64{1}
    }
    if (count == I64{0}) -> return I64{0}
    buffer: jet_rt_alloc(count * I64{8}, I64{8})
    if (flat == I64{1}) {
        // A lone float32 crosses the thunk already widened to binary64.
        pg_store(buffer, pg_lift_flat(pg_word(codes), raw))
        return buffer
    }
    memory_index: pg_word(wrapping(record + I64{64}))
    area: raw.bit_and(PG_U32)
    if (memory_index < I64{0} || area.bit_and(align - I64{1}) != I64{0}) {
        jet_rt_free(buffer, count * I64{8}, I64{8})
        return I64{0}
    }
    memory: pg_memory(instance, memory_index)
    size: pg_word(wrapping(memory + I64{8}))
    base: pg_word(memory)
    offset := I64{0}
    at = I64{0}
    loop at < count {
        code: pg_word(wrapping(codes + at * I64{8}))
        field_align: pg_field_align(code)
        offset = (offset + field_align - I64{1}).bit_and(I64{0} - field_align)
        width: if (code == PG_VALUE_STRING) -> I64{8} else -> field_align
        start: area + offset
        target: wrapping(buffer + at * I64{8})
        fits := pg_in_bounds(start, width, size)
        if (fits && code == PG_VALUE_STRING) {
            text: pg_lift_text(instance, memory_index, start)
            fits = text != I64{0}
            pg_store(target, text)
        } else if fits {
            field: wrapping(base + start)
            loaded: if (width == I64{1}) -> rt_text_byte(field) else if (width == I64{2}) -> rt_text_byte(field).bit_or(rt_text_byte(wrapping(field + I64{1})) << I64{8}) else if (width == I64{4}) -> pg_u32(field) else -> pg_word(field)
            pg_store(target, if (code == I64{9}) -> rt_f64_bits(jet_std_math_from_bits_f32(loaded)) else -> pg_lift_flat(code, loaded))
        }
        if !fits {
            pg_drop_fields(record, desc, buffer, at)
            return I64{0}
        }
        offset += width
        at += I64{1}
    }
    buffer
}

// Frees a pg_lift_fields buffer and the strings among its first `lifted`
// fields.
pg_drop_fields: fn(record: I64, desc: I64, buffer: I64, lifted: I64) {
    count: pg_word(wrapping(record + I64{80}))
    codes: wrapping(desc + pg_word(wrapping(record + I64{88})))
    at := I64{0}
    loop at < lifted {
        if (pg_word(wrapping(codes + at * I64{8})) == PG_VALUE_STRING) -> jet_rt_string_drop(pg_word(wrapping(buffer + at * I64{8})))
        at += I64{1}
    }
    jet_rt_free(buffer, count * I64{8}, I64{8})
}

pg_finish: fn(status: I64, slot: I64, ok: I64, err: I64) -> I64 {
    if (status == I64{0}) {
        pg_store(err, pg_word(slot))
        jet_rt_free(slot, I64{8}, I64{8})
        return I64{0}
    }
    jet_rt_free(slot, I64{8}, I64{8})
    I64{1}
}

#Export(c) jet_plugin_call: fn(plugin: I64, name: I64, err: I64) -> I64 {
    slot: jet_rt_alloc(I64{8}, I64{8})
    status: pg_invoke(plugin, name, I64{-1}, slot)
    pg_finish(status, slot, I64{0}, err)
}

#Export(c) jet_plugin_call_bool: fn(plugin: I64, name: I64, ok: I64, err: I64) -> I64 {
    slot: jet_rt_alloc(I64{8}, I64{8})
    status: pg_invoke(plugin, name, I64{0}, slot)
    if (status != I64{0}) -> rt_text_put(ok, pg_word(slot))
    pg_finish(status, slot, ok, err)
}

#Export(c) jet_plugin_call_float: fn(plugin: I64, name: I64, ok: I64, err: I64) -> I64 {
    slot: jet_rt_alloc(I64{8}, I64{8})
    status: pg_invoke(plugin, name, I64{1}, slot)
    // A float32 result crosses the thunk already widened to binary64.
    if (status != I64{0}) -> pg_store(ok, pg_word(slot))
    pg_finish(status, slot, ok, err)
}

#Export(c) jet_plugin_call_int: fn(plugin: I64, name: I64, ok: I64, err: I64) -> I64 {
    slot: jet_rt_alloc(I64{8}, I64{8})
    status: pg_invoke(plugin, name, I64{2}, slot)
    if (status != I64{0}) {
        desc: pg_word(wrapping(plugin + PG_PLUGIN_DESC))
        record: pg_find_export(desc, name)
        raw: pg_word(slot)
        unsigned: record != I64{0} && pg_word(wrapping(record + I64{40})) == I64{8} && raw < I64{0}
        pg_store(ok, if unsigned -> pg_int_u64(raw) else -> jet_int_owned_from_i64(raw))
    }
    pg_finish(status, slot, ok, err)
}

pg_int_u64: fn(raw: I64) -> I64 {
    low: jet_int_owned_from_i64(raw.bit_and(I64{9223372036854775807}))
    half: jet_int_owned_from_i64(I64{4611686018427387904})
    high: jet_int_add(half, half)
    jet_int_add(low, high)
}

#Export(c) jet_plugin_call_text: fn(plugin: I64, name: I64, ok: I64, err: I64) -> I64 {
    slot: jet_rt_alloc(I64{8}, I64{8})
    status: pg_invoke(plugin, name, I64{3}, slot)
    if (status != I64{0}) -> pg_store(ok, pg_word(slot))
    pg_finish(status, slot, ok, err)
}

// A tuple result: one word per field at `out` (an integer as its owned exact
// Int, a bool 0 or 1, a float's binary64 bits, a string owned) and 1, or the
// PluginError at `out` and 0. `count` is the host's field count.
#Export(c) jet_plugin_call_words: fn(plugin: I64, name: I64, out: I64, count: I64) -> I64 {
    slot: jet_rt_alloc(I64{8}, I64{8})
    status := pg_invoke(plugin, name, I64{4}, slot)
    if (status != I64{0}) {
        desc: pg_word(wrapping(plugin + PG_PLUGIN_DESC))
        record: pg_find_export(desc, name)
        buffer: pg_word(slot)
        fields: pg_word(wrapping(record + I64{80}))
        if (fields != count) {
            pg_drop_fields(record, desc, buffer, fields)
            pg_store(slot, pg_call_failure(name, PLUGIN_ERROR_DEFECT, jet_rt_string_clone(rt_static_text("the export's tuple fields differ from the host's"))))
            status = I64{0}
        } else {
            codes: wrapping(desc + pg_word(wrapping(record + I64{88})))
            at := I64{0}
            loop at < count {
                code: pg_word(wrapping(codes + at * I64{8}))
                raw: pg_word(wrapping(buffer + at * I64{8}))
                word: if (code == I64{8} && raw < I64{0}) -> pg_int_u64(raw) else if (code >= I64{1} && code <= I64{8}) -> jet_int_owned_from_i64(raw) else -> raw
                pg_store(wrapping(out + at * I64{8}), word)
                at += I64{1}
            }
            jet_rt_free(buffer, count * I64{8}, I64{8})
        }
    }
    pg_finish(status, slot, out, out)
}

// ---- host imports ----------------------------------------------------------------------

// A lowered host import: `area` holds the flat core arguments. Returns the
// flat result word; a refusal sets the instance trap (the caller tests it).
#Export(c) jet_plugin_host_import: fn(instance: I64, index: I64, area: I64, count: I64) -> I64 {
    plugin: pg_word(wrapping(instance + PG_INST_PLUGIN))
    desc: pg_word(wrapping(instance + PG_INST_DESC))
    record: wrapping(wrapping(desc + pg_desc(desc, I64{10})) + index * I64{64})
    name: pg_text(wrapping(desc + pg_word(record)), pg_word(wrapping(record + I64{8})))
    right: pg_leaf_right(name)
    result: pg_host_import(plugin, instance, record, name, right, area, count)
    jet_rt_string_drop(name)
    result
}

pg_import_refusal: fn(instance: I64, kind: I64, name: I64, lead: I64, middle: I64, tail: I64) -> I64 {
    detail: jet_rt_string_builder_new()
    jet_rt_string_builder_push(detail, rt_static_text("plugin host import `"))
    jet_rt_string_builder_push(detail, name)
    jet_rt_string_builder_push(detail, lead)
    jet_rt_string_builder_push(detail, middle)
    jet_rt_string_builder_push(detail, tail)
    pg_set_trap(instance, kind, detail)
    I64{0}
}

pg_host_import: fn(plugin: I64, instance: I64, record: I64, name: I64, right: I64, area: I64, count: I64) -> I64 {
    wire: pg_word(wrapping(plugin + PG_PLUGIN_WIRE))
    if (right == I64{0} || !pg_holds_family(wire, right)) {
        return pg_import_refusal(instance, PG_TRAP_DENIED, name, rt_static_text("` denied: missing `"), if (right == I64{0}) -> rt_static_text("authority") else -> right, rt_static_text("`"))
    }
    if !pg_is(right, rt_static_text("FS.Read")) {
        return pg_import_refusal(instance, PG_TRAP_DEFECT, name, rt_static_text("` has no runtime adapter for `"), right, rt_static_text("`"))
    }
    desc: pg_word(wrapping(instance + PG_INST_DESC))
    params: pg_word(wrapping(record + I64{16}))
    types: wrapping(desc + pg_word(wrapping(record + I64{24})))
    memory_index: pg_word(wrapping(record + I64{40}))
    if (params != I64{1} || pg_word(types) != I64{12} || memory_index < I64{0} || count < I64{2}) {
        return pg_import_refusal(instance, PG_TRAP_USER, name, rt_static_text("` requires a Text path"), rt_static_text(""), rt_static_text(""))
    }
    memory: pg_memory(instance, memory_index)
    pointer: pg_word(area).bit_and(PG_U32)
    length: pg_word(wrapping(area + I64{8})).bit_and(PG_U32)
    if (!pg_in_bounds(pointer, length, pg_word(wrapping(memory + I64{8}))) || !env_utf8(wrapping(pg_word(memory) + pointer), length)) {
        return pg_import_refusal(instance, PG_TRAP_USER, name, rt_static_text("` requires a Text path"), rt_static_text(""), rt_static_text(""))
    }
    path: rt_text_copy(wrapping(pg_word(memory) + pointer), length)
    error: jet_rt_alloc(I64{16}, I64{8})
    bytes: pg_scoped_read(path, wire, rt_static_text("FS.Read"), error)
    if (bytes == I64{0}) {
        detail: pg_word(error)
        kind: pg_word(wrapping(error + I64{8}))
        jet_rt_free(error, I64{16}, I64{8})
        lead: jet_rt_string_builder_new()
        jet_rt_string_builder_push(lead, rt_static_text("` rejected path `"))
        jet_rt_string_builder_push(lead, path)
        jet_rt_string_builder_push(lead, rt_static_text("`: "))
        _: pg_import_refusal(instance, if (kind == PLUGIN_ERROR_DENIED) -> PG_TRAP_DENIED else -> PG_TRAP_USER, name, lead, detail, rt_static_text(""))
        jet_rt_string_drop(lead)
        jet_rt_string_drop(detail)
        jet_rt_string_drop(path)
        return I64{0}
    }
    jet_rt_free(error, I64{16}, I64{8})
    jet_rt_string_drop(path)
    // A string result is lowered through realloc to the trailing return pointer.
    realloc: pg_word(wrapping(record + I64{48}))
    if (pg_word(wrapping(record + I64{32})) != I64{12} || realloc < I64{0} || count < I64{3}) {
        jet_rt_string_drop(bytes)
        return pg_import_refusal(instance, PG_TRAP_USER, name, rt_static_text("` must return Text or list<u8>"), rt_static_text(""), rt_static_text(""))
    }
    if !env_utf8(rt_text_data(bytes), rt_text_len(bytes)) {
        jet_rt_string_drop(bytes)
        return pg_import_refusal(instance, PG_TRAP_USER, name, rt_static_text("` returned non-UTF-8 data for Text"), rt_static_text(""), rt_static_text(""))
    }
    retptr: pg_word(wrapping(area + I64{16})).bit_and(PG_U32)
    scratch: jet_rt_alloc(I64{32}, I64{8})
    pg_store(scratch, I64{0})
    pg_store(wrapping(scratch + I64{8}), I64{0})
    pg_store(wrapping(scratch + I64{16}), I64{1})
    pg_store(wrapping(scratch + I64{24}), rt_text_len(bytes))
    _: pg_call(pg_word(wrapping(plugin + PG_PLUGIN_GUEST)), realloc, instance, scratch)
    target: pg_word(scratch).bit_and(PG_U32)
    jet_rt_free(scratch, I64{32}, I64{8})
    if (pg_word(wrapping(instance + PG_INST_TRAP)) != I64{0}) {
        jet_rt_string_drop(bytes)
        return I64{0}
    }
    size: pg_word(wrapping(memory + I64{8}))
    if (!pg_in_bounds(target, rt_text_len(bytes), size) || !pg_in_bounds(retptr, I64{8}, size)) {
        jet_rt_string_drop(bytes)
        return pg_import_refusal(instance, PG_TRAP_DEFECT, name, rt_static_text("` result lowering left guest memory"), rt_static_text(""), rt_static_text(""))
    }
    rt_text_bytes_copy(wrapping(pg_word(memory) + target), rt_text_data(bytes), rt_text_len(bytes))
    pg_put_u32(wrapping(pg_word(memory) + retptr), target)
    pg_put_u32(wrapping(wrapping(pg_word(memory) + retptr) + I64{4}), rt_text_len(bytes))
    jet_rt_string_drop(bytes)
    I64{0}
}
