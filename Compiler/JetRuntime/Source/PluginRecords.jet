#Export(c) jet_rt_record_new_plugin_frame: fn(function: I64, component: I64, offset: I64) -> I64 {
    raw: jet_int_owned_to_i64(offset)
    if (jet_scheduler_native_propagate() != I64{0}) -> return I64{0}
    frame: jet_rt_alloc(PLUGIN_FRAME_BYTES, I64{8})
    dyn_store(wrapping(frame + PLUGIN_FRAME_FUNCTION), jet_rt_string_clone(function))
    dyn_store(wrapping(frame + PLUGIN_FRAME_COMPONENT), jet_rt_string_clone(component))
    dyn_store(wrapping(frame + PLUGIN_FRAME_OFFSET), raw)
    frame
}
#Export(c) jet_rt_record_get_plugin_frame_function: fn(frame: I64) -> I64 { jet_rt_string_clone(dyn_word(wrapping(frame + PLUGIN_FRAME_FUNCTION))) }
#Export(c) jet_rt_record_get_plugin_frame_component: fn(frame: I64) -> I64 { jet_rt_string_clone(dyn_word(wrapping(frame + PLUGIN_FRAME_COMPONENT))) }
#Export(c) jet_rt_record_get_plugin_frame_offset: fn(frame: I64) -> I64 { jet_int_owned_from_i64(dyn_word(wrapping(frame + PLUGIN_FRAME_OFFSET))) }
plugin_frame_clone_into: fn(source: I64, target: I64) {
    dyn_store(wrapping(target + PLUGIN_FRAME_FUNCTION), jet_rt_string_clone(dyn_word(wrapping(source + PLUGIN_FRAME_FUNCTION))))
    dyn_store(wrapping(target + PLUGIN_FRAME_COMPONENT), jet_rt_string_clone(dyn_word(wrapping(source + PLUGIN_FRAME_COMPONENT))))
    dyn_store(wrapping(target + PLUGIN_FRAME_OFFSET), dyn_word(wrapping(source + PLUGIN_FRAME_OFFSET)))
}
plugin_frame_drop_fields: fn(frame: I64) {
    jet_rt_string_drop(dyn_word(wrapping(frame + PLUGIN_FRAME_FUNCTION)))
    jet_rt_string_drop(dyn_word(wrapping(frame + PLUGIN_FRAME_COMPONENT)))
}
#Export(c) jet_rt_handle_clone_plugin_frame: fn(frame: I64) -> I64 {
    result: jet_rt_alloc(PLUGIN_FRAME_BYTES, I64{8})
    plugin_frame_clone_into(frame, result)
    result
}
#Export(c) jet_rt_handle_drop_plugin_frame: fn(frame: I64) {
    if (frame == I64{0}) -> return
    plugin_frame_drop_fields(frame)
    jet_rt_free(frame, PLUGIN_FRAME_BYTES, I64{8})
}
#Export(c) jet_rt_handle_eq_plugin_frame: fn(left: I64, right: I64) -> Bool {
    if !jet_rt_string_eq(dyn_word(wrapping(left + PLUGIN_FRAME_FUNCTION)), dyn_word(wrapping(right + PLUGIN_FRAME_FUNCTION))) -> return false
    if !jet_rt_string_eq(dyn_word(wrapping(left + PLUGIN_FRAME_COMPONENT)), dyn_word(wrapping(right + PLUGIN_FRAME_COMPONENT))) -> return false
    dyn_word(wrapping(left + PLUGIN_FRAME_OFFSET)) == dyn_word(wrapping(right + PLUGIN_FRAME_OFFSET))
}
#Export(c) jet_rt_record_seq_list_rec_plugin_frame_new: fn(capacity: I64) -> I64 { data_sequence_new(capacity, PLUGIN_FRAME_BYTES) }
#Export(c) jet_rt_record_seq_list_rec_plugin_frame_len: fn(sequence: I64) -> I64 { dyn_word(wrapping(sequence + DATA_SEQUENCE_LENGTH)) }
#Export(c) jet_rt_record_seq_list_rec_plugin_frame_get: fn(sequence: I64, index: I64) -> I64 {
    length: dyn_word(wrapping(sequence + DATA_SEQUENCE_LENGTH))
    // The Rust original indexes vec[index as usize]: fatal foreign OOB, not the
    // Jet language panic used by Dyn's own sequence policy.
    if (index < I64{0} || index >= length) -> rt_seq_index_oob_stop(length, index)
    dyn_word(wrapping(sequence + DATA_SEQUENCE_DATA)) + index * PLUGIN_FRAME_BYTES
}
#Export(c) jet_rt_record_seq_list_rec_plugin_frame_push: fn(sequence: I64, frame: I64) {
    target: data_sequence_reserve(sequence, PLUGIN_FRAME_BYTES)
    // Move fields into inline storage, consume only the source shell.
    coll_copy(frame, target, PLUGIN_FRAME_BYTES)
    jet_rt_free(frame, PLUGIN_FRAME_BYTES, I64{8})
    dyn_store(wrapping(sequence + DATA_SEQUENCE_LENGTH), dyn_word(wrapping(sequence + DATA_SEQUENCE_LENGTH)) + I64{1})
}
plugin_frames_clone: fn(sequence: I64) -> I64 {
    length: dyn_word(wrapping(sequence + DATA_SEQUENCE_LENGTH))
    result: data_sequence_new(length, PLUGIN_FRAME_BYTES)
    source: dyn_word(wrapping(sequence + DATA_SEQUENCE_DATA))
    target: dyn_word(wrapping(result + DATA_SEQUENCE_DATA))
    at := I64{0}
    loop at < length {
        plugin_frame_clone_into(wrapping(source + at * PLUGIN_FRAME_BYTES), wrapping(target + at * PLUGIN_FRAME_BYTES))
        at += I64{1}
    }
    dyn_store(wrapping(result + DATA_SEQUENCE_LENGTH), length)
    result
}
plugin_frames_drop: fn(sequence: I64) {
    length: dyn_word(wrapping(sequence + DATA_SEQUENCE_LENGTH))
    capacity: dyn_word(wrapping(sequence + DATA_SEQUENCE_CAPACITY))
    data: dyn_word(wrapping(sequence + DATA_SEQUENCE_DATA))
    at := I64{0}
    loop at < length {
        plugin_frame_drop_fields(wrapping(data + at * PLUGIN_FRAME_BYTES))
        at += I64{1}
    }
    if (capacity != I64{0}) -> jet_rt_free(data, capacity * PLUGIN_FRAME_BYTES, I64{8})
    jet_rt_free(sequence, DATA_SEQUENCE_BYTES, I64{8})
}
plugin_frames_eq: fn(left: I64, right: I64) -> Bool {
    length: dyn_word(wrapping(left + DATA_SEQUENCE_LENGTH))
    if length != dyn_word(wrapping(right + DATA_SEQUENCE_LENGTH)) -> return false
    a: dyn_word(wrapping(left + DATA_SEQUENCE_DATA))
    b: dyn_word(wrapping(right + DATA_SEQUENCE_DATA))
    at := I64{0}
    loop at < length {
        if !jet_rt_handle_eq_plugin_frame(wrapping(a + at * PLUGIN_FRAME_BYTES), wrapping(b + at * PLUGIN_FRAME_BYTES)) -> return false
        at += I64{1}
    }
    true
}
#Export(c) jet_rt_record_new_plugin_fault: fn(export_name: I64, message: I64, frames: I64) -> I64 {
    fault: jet_rt_alloc(PLUGIN_FAULT_BYTES, I64{8})
    dyn_store(wrapping(fault + PLUGIN_FAULT_EXPORT), jet_rt_string_clone(export_name))
    dyn_store(wrapping(fault + PLUGIN_FAULT_MESSAGE), jet_rt_string_clone(message))
    dyn_store(wrapping(fault + PLUGIN_FAULT_FRAMES), frames)
    fault
}
#Export(c) jet_rt_record_get_plugin_fault_export: fn(fault: I64) -> I64 { jet_rt_string_clone(dyn_word(wrapping(fault + PLUGIN_FAULT_EXPORT))) }
#Export(c) jet_rt_record_get_plugin_fault_message: fn(fault: I64) -> I64 { jet_rt_string_clone(dyn_word(wrapping(fault + PLUGIN_FAULT_MESSAGE))) }
#Export(c) jet_rt_record_get_plugin_fault_frames: fn(fault: I64) -> I64 { dyn_word(wrapping(fault + PLUGIN_FAULT_FRAMES)) }
#Export(c) jet_rt_handle_clone_plugin_fault: fn(fault: I64) -> I64 {
    result: jet_rt_alloc(PLUGIN_FAULT_BYTES, I64{8})
    dyn_store(wrapping(result + PLUGIN_FAULT_EXPORT), jet_rt_string_clone(dyn_word(wrapping(fault + PLUGIN_FAULT_EXPORT))))
    dyn_store(wrapping(result + PLUGIN_FAULT_MESSAGE), jet_rt_string_clone(dyn_word(wrapping(fault + PLUGIN_FAULT_MESSAGE))))
    dyn_store(wrapping(result + PLUGIN_FAULT_FRAMES), plugin_frames_clone(dyn_word(wrapping(fault + PLUGIN_FAULT_FRAMES))))
    result
}
#Export(c) jet_rt_handle_drop_plugin_fault: fn(fault: I64) {
    if (fault == I64{0}) -> return
    jet_rt_string_drop(dyn_word(wrapping(fault + PLUGIN_FAULT_EXPORT)))
    jet_rt_string_drop(dyn_word(wrapping(fault + PLUGIN_FAULT_MESSAGE)))
    plugin_frames_drop(dyn_word(wrapping(fault + PLUGIN_FAULT_FRAMES)))
    jet_rt_free(fault, PLUGIN_FAULT_BYTES, I64{8})
}
#Export(c) jet_rt_handle_eq_plugin_fault: fn(left: I64, right: I64) -> Bool {
    if !jet_rt_string_eq(dyn_word(wrapping(left + PLUGIN_FAULT_EXPORT)), dyn_word(wrapping(right + PLUGIN_FAULT_EXPORT))) -> return false
    if !jet_rt_string_eq(dyn_word(wrapping(left + PLUGIN_FAULT_MESSAGE)), dyn_word(wrapping(right + PLUGIN_FAULT_MESSAGE))) -> return false
    plugin_frames_eq(dyn_word(wrapping(left + PLUGIN_FAULT_FRAMES)), dyn_word(wrapping(right + PLUGIN_FAULT_FRAMES)))
}
#Export(c) jet_rt_handle_clone_plugin_limit: fn(value: I64) -> I64 { encoding_enum_clone(value) }
#Export(c) jet_rt_handle_drop_plugin_limit: fn(value: I64) { encoding_enum_drop(value) }
#Export(c) jet_rt_handle_eq_plugin_limit: fn(left: I64, right: I64) -> Bool { encoding_enum_eq(left, right) }
