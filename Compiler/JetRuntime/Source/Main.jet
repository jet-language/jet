// Native process entry. Object's libc main captures host arguments first; the
// logical Env seed validates that ONE captured cell, never creates another.

// Both flush results are ignored; raw facts avoid creating an
// unused IOError owner. Scratch is one live 16-byte runtime allocation.
fn main_flush(scratch: I64) {
    jet_stdio_stdout_flush_raw(scratch, scratch + I64{8})
    jet_stdio_stderr_flush_raw(scratch, scratch + I64{8})
}

fn main_write_report(text: I64, scratch: I64) {
    // The real stream policy flushes pending stdout BEFORE stderr output.
    jet_stdio_stderr_write_raw(text, false, scratch, scratch + I64{8})
}

// Process32: atomic winning Linux tid@0, winning signed32 code@8, distinct
// borrowed report/flush output words@16/@24. Initialized before any user body;
// only the winning thread accesses the outputs. This is not a second Env/TLS.
main_exit_root := I64{0}
// runtime-init: 5 when main_exit_root
#Export(c) fn jet_rt_process_exit_init() {
    if (main_exit_root != I64{0}) -> return
    main_exit_root = jet_rt_alloc(I64{32}, I64{8})
    thread_zero(main_exit_root, I64{32})
}

// #5478: nonzero once this process is ending: process.exit's winning claim,
// a stop the process root (jet_rt_main's, main_root_control) accepts, or
// the program entry returning with no task in flight. From then on the heap
// is the kernel's to reclaim: jet_rt_free returns at once and
// jet_rt_rc_release gives up no owner, so no drop walks or frees a counted
// block on any tier, while user cleanup (closes, guards, defers, exit
// handlers, rollback hooks) still runs. A stop or exit ends the process;
// only jet_rt_main's normal return clears it, for a loaded-image host that
// runs another entry.
main_process_ending := I64{0}
main_root_control := I64{0}
// jet_rt_main_stopped once a stop is published to main_root_control
// (Scheduler.jet scheduler_control_publish), else 0: an entry nothing
// stopped has nothing to take.
main_stopped_code := I64{0}

fn main_stopped_install(code: I64) { main_stopped_code = code }

fn main_process_end() { main_process_ending = I64{1} }

// core.perf's raw fidelity word, zero until written
// (Core/Perf reads zero as the default). A loaded-image host's next entry
// starts from zero again, as a fresh process would.
main_perf_bits := I64{0}

#Export(c) fn jet_perf_read_bits() -> I64 { jet_int_owned_from_i64(main_perf_bits) }

#Export(c) fn jet_perf_write_bits(bits: I64) {
    word :: host_native_int(bits)
    if (jet_scheduler_native_propagate() != I64{0}) -> return
    main_perf_bits = word
}

// The program entry returning, before its drops (JetIR ir_emit_return). A
// task still in flight keeps the heap reclaimed: it may run long after.
#Export(c) fn jet_rt_process_entry_return() {
    if (main_root_control != I64{0} && scheduler_idle()) -> main_process_end()
}

fn main_exit_claim(code: I64) {
    tid :: thread_tid()
    owner :: sync_cas(main_exit_root, I64{0}, tid)
    if (owner == I64{0}) {
        sync_store(main_exit_root + I64{8}, (code << I64{32}) >> I64{32})
        return
    }
    if (owner == tid) {
        // A cleanup callback can itself stop. Do not recurse into callbacks
        // or issue another report; preserve the first claimed exit status.
        main_flush(main_exit_root + I64{16})
        trap_exit(sync_load(main_exit_root + I64{8}))
    }
    // A concurrent loser must not race exit_group or emit a second report.
    // pause parks independently of the normal-return claim's later reset;
    // retry every signal interruption without allocating another wait slot.
    loop {
        _ := trap_syscall(I64{34}, I64{0}, I64{0}, I64{0}, I64{0}, I64{0}, I64{0})
    }
}

// The process exit's two optional steps, zero until a program needs them:
// the first exit-handler registration (Task.jet jet_rt_task_exit_init)
// installs the handlers' drain, the first observed task or the observe
// writer (Observe.jet observe_exit_report_install) the parked-task report.
// A program with neither links neither.
main_exit_handlers_code := I64{0}
main_parked_report_code := I64{0}

fn main_exit_handlers_install(code: I64) { main_exit_handlers_code = code }
fn main_parked_report_install(code: I64) { main_parked_report_code = code }

fn main_exit_cleanup() -> I64 {
    // Exit callbacks run before the observer's report.
    handlers :: main_exit_handlers_code
    if (handlers != I64{0}) -> _ := coll_call1(handlers, I64{0})
    parked :: main_parked_report_code
    if (parked == I64{0}) -> return I64{0}
    scratch :: main_exit_root + I64{16}
    present :: coll_call2(parked, scratch, scratch + I64{8})
    if (present == I64{0}) -> return I64{0}
    rendered :: trap_word(scratch)
    code :: trap_word(scratch + I64{8})
    main_write_report(rendered, scratch)
    jet_rt_string_drop(rendered)
    code
}

// Called BEFORE the first fatal diagnostic byte, so callback/parked output
// precedes the original stop report, rather than follows it.
#Export(c) fn jet_rt_process_exit_begin(code: I64) {
    main_exit_claim(code)
    // Only the winner gets here, and it always ends the process.
    main_process_end()
    _ := main_exit_cleanup()
    // Fatal/explicit process::exit does not join other threads. Never drain
    // here: the winner may be a live scheduler worker counted as in-flight.
    main_flush(main_exit_root + I64{16})
}

#Export(c) fn jet_rt_process_exit_finish() {
    // Only the claimant's footer can reach this function.
    main_flush(main_exit_root + I64{16})
    trap_exit(sync_load(main_exit_root + I64{8}))
}

#Export(c) fn jet_rt_process_exit(code: I64) {
    jet_rt_process_exit_begin(code)
    jet_rt_process_exit_finish()
}

fn rt_main_stopped_address() -> I64 {
    loop { jet_rt_unreachable(I64{0}, I64{0}) }
}

// jet_rt_main's end of an entry that published a stop to its root (via
// main_stopped_code): take the stop, leave the root, run the exit
// handlers, write the captured report and exit with the stop's code.
// Returns 0, the root still entered, when the root holds no stop.
#Export(c) fn jet_rt_main_stopped(root: I64, save: I64) -> I64 {
    record :: jet_rt_root_take_stop(root, save + I64{32})
    if (record == I64{0}) -> return I64{0}
    jet_rt_root_leave(root, save)
    main_root_control = I64{0}
    code :: trap_word(save + I64{32})
    report :: scheduler_stop_take_message(record)
    scheduler_stop_drop(record)
    jet_rt_free(save, I64{40}, I64{8})
    main_exit_claim(code)
    _ := main_exit_cleanup()
    main_flush(main_exit_root + I64{16})
    if (report != I64{0}) {
        trap_write_handle(report)
        jet_rt_string_drop(report)
    }
    jet_rt_process_exit_finish()
    I64{0}
}

// SysV int32 callers observe eax only: Image/Object.jet:70-80 returns it to
// libc main; Image/Loader.jet x64_image_exec explicitly truncates/sign-normalizes it.
// Returning an I64 low word needs no ABI thunk or new I32 export admission.
#Export(c) fn jet_rt_main(entry: I64) -> I64 {
    // Startup (HostStartup.jet jet_rt_host_arguments) has captured and
    // seeded the environment when the program reads it. The runtime's
    // .init_array has already run; these idempotent initializers also make
    // the explicit loaded-image boundary usable.
    host_arguments_require()
    // JET_CHECKED_ALLOC=1 never runs a program built without the checker.
    alloc_check_require()
    jet_rt_thread_init()
    jet_rt_scheduler_init()
    // No jet_rt_observe_init here: its hook (Observe.jet) is kept exactly
    // when the program links code that reads the task registry, and runs
    // before this; a program with none links no registry.
    jet_rt_process_exit_init()
    // Fatal signals print the fault report (Fault.jet), stack overflow too.
    fault_start()
    // Exactly once, after TLS/registry initialization and before
    // the checked no-argument entry. Object main must not start Observe itself.
    // The start is a code word: only a program that links something to observe
    // (a task, a channel, a live value or an event) has it installed
    // (ObserveLive.jet jet_rt_observe_start_init); any other program links no
    // observation writer, and JET_OBSERVE=1 has nothing to publish there.
    observe :: observe_start_code
    if (observe != I64{0}) -> _ := coll_call1(observe, I64{0})
    // The entry runs under the process root control: a stop (a panic, a
    // numeric stop, process.exit, os.stop) is published there and every
    // generated frame leaves by its stop edge, running its closes, drops
    // and guards (JetIR Build.jet ir_stop_check). The root then takes it:
    // exit handlers run, then the captured report is written, then the
    // process exits with the stop's code (D-FAIL-EXIT1).
    save :: jet_rt_alloc(I64{40}, I64{8})
    root :: jet_rt_root_begin(save)
    main_root_control = root
    #Unsafe("entry is the loader/object's checked executable System V void(void) address, not a closure header") {
        os_call0_unit(entry)
    }
    stopped :: main_stopped_code
    if (stopped != I64{0}) -> _ := coll_call2(stopped, root, save)
    jet_rt_root_leave(root, save)
    main_root_control = I64{0}
    jet_rt_free(save, I64{40}, I64{8})
    main_exit_claim(I64{0})
    parked_code :: main_exit_cleanup()
    // ONLY normal main-thread return drains. Fatal/explicit exit never joins
    // the worker executing the process boundary and cannot self-wait.
    jet_scheduler_drain_after_exit()
    // JET_CHECKED_ALLOC=1 (Alloc.jet): a write after one of the last frees
    // traps here rather than going unseen.
    alloc_check_sweep()
    main_flush(main_exit_root + I64{16})
    if (parked_code != I64{0}) {
        // A parked-task stop exits rather than returning to a loaded-image host.
        sync_store(main_exit_root + I64{8}, parked_code)
        jet_rt_process_exit_finish()
    }
    // Loaded-image hosts can run another normal entry in this same process,
    // which frees again. Fatal/explicit claims never reach this release. An
    // ending process dropped nothing, so its live Secrets are scrubbed here.
    if (main_process_ending != I64{0}) -> secret_scrub()
    main_process_ending = I64{0}
    main_perf_bits = I64{0}
    sync_store(main_exit_root, I64{0})
    // Normal entry returns zero, not the entry's unused register.
    I64{0}
}
