// Native process entry: CAbi.rs:178-184, EnvInit.rs:24-27 and
// Core.rs:1182-1194. Object's libc main captures host arguments first; the
// logical Env seed validates that ONE captured cell, never creates another.

#Import(c) fn main_env_seed() = "jet_rt_logical_env_seed"
#Import(c) fn main_observe_init() = "jet_rt_observe_init"
#Import(c) fn main_observe_start() = "jet_rt_observe_runtime_start_from_env"
#Import(c) fn main_observe_report(rendered: I64, code: I64) -> I64 = "jet_rt_observe_parked_tasks_report"
#Import(c) fn main_stdout_flush(errno: I64, write_zero: I64) = "jet_stdio_stdout_flush_raw"
#Import(c) fn main_stderr_flush(errno: I64, write_zero: I64) = "jet_stdio_stderr_flush_raw"
#Import(c) fn main_stderr_write(text: I64, newline: Bool, errno: I64, write_zero: I64) = "jet_stdio_stderr_write_raw"

// Core.rs:1177-1178 ignores both flush results; raw facts avoid creating an
// unused IOError owner. Scratch is one live 16-byte runtime allocation.
fn main_flush(scratch: I64) {
    main_stdout_flush(scratch, scratch + I64{8})
    main_stderr_flush(scratch, scratch + I64{8})
}

fn main_write_report(text: I64, scratch: I64) {
    // The real stream policy flushes pending stdout BEFORE stderr output.
    main_stderr_write(text, false, scratch, scratch + I64{8})
}

// SysV int32 callers observe eax only: Image/Object.jet:70-80 returns it to
// libc main; Image/Loader.jet:130-133 explicitly truncates/sign-normalizes it.
// Returning an I64 low word needs no ABI thunk or new I32 export admission.
#Export(c) fn jet_rt_main(entry: I64) -> I64 {
    main_env_seed()
    // Allocator .init_array has already run (Alloc.jet:20). These idempotent
    // initializers also make the explicit loaded-image boundary usable.
    jet_rt_thread_init()
    jet_rt_scheduler_init()
    jet_rt_task_exit_init()
    main_observe_init()
    // EnvInit.rs:27: exactly once, after TLS/registry initialization and before
    // the checked no-argument entry. Object main must not start Observe itself.
    main_observe_start()
    #Unsafe("entry is the loader/object's checked executable System V void(void) address, not a closure header") {
        os_call0_unit(entry)
    }
    // Core.rs:1188-1190: callbacks BEFORE the single parked report, then drain.
    jet_rt_task_exit_handlers()
    scratch :: jet_rt_alloc(I64{16}, I64{8})
    present :: main_observe_report(scratch, scratch + I64{8})
    code := I64{0}
    if (present != I64{0}) {
        rendered :: trap_word(scratch)
        code = trap_word(scratch + I64{8})
        main_write_report(rendered, scratch)
        jet_rt_string_drop(rendered)
    }
    jet_scheduler_drain_after_exit()
    main_flush(scratch)
    jet_rt_free(scratch, I64{16}, I64{8})
    if (present != I64{0}) {
        // Core.rs:1192 exits, rather than returning through a loaded-image host.
        trap_exit(code)
    }
    // CAbi.rs:182: normal entry returns zero, not the entry's unused register.
    I64{0}
}
