// Native compiler math routes, parity: Jet-only (Rust frozen). Every route
// is Jet, ported from musl 1.2.5 with its algorithms: Libm.jet computes
// floor, ceil, trunc, round, fmod, fma and sqrt, LibmTrig.jet sin, cos, tan,
// asin, acos, atan and atan2, LibmExpLog.jet exp, exp2, expm1, log, log2,
// log10 and log1p, LibmPow.jet pow, cbrt and hypot, and LibmHyperbolic.jet
// sinh, cosh, tanh, asinh, acosh and atanh. Nothing here imports C. Never
// approximate a function or unfuse mul_add.

#Export(c) jet_std_math_acos: fn(x: Float) -> Float { libm_acos(x) }
#Export(c) jet_std_math_acosh: fn(x: Float) -> Float { libm_acosh(x) }
#Export(c) jet_std_math_asin: fn(x: Float) -> Float { libm_asin(x) }
#Export(c) jet_std_math_asinh: fn(x: Float) -> Float { libm_asinh(x) }
#Export(c) jet_std_math_atan: fn(x: Float) -> Float { libm_atan(x) }
#Export(c) jet_std_math_atan2: fn(y: Float, x: Float) -> Float { libm_atan2(y, x) }
#Export(c) jet_std_math_atanh: fn(x: Float) -> Float { libm_atanh(x) }
#Export(c) jet_std_math_cbrt: fn(x: Float) -> Float { libm_cbrt(x) }
#Export(c) jet_std_math_ceil: fn(x: Float) -> Float { libm_ceil(x) }
#Export(c) jet_std_math_cos: fn(x: Float) -> Float { libm_cos(x) }
#Export(c) jet_std_math_cosh: fn(x: Float) -> Float { libm_cosh(x) }
#Export(c) jet_std_math_exp: fn(x: Float) -> Float { libm_exp(x) }
#Export(c) jet_std_math_exp_m1: fn(x: Float) -> Float { libm_expm1(x) }
#Export(c) jet_std_math_exp2: fn(x: Float) -> Float { libm_exp2(x) }
#Export(c) jet_std_math_floor: fn(x: Float) -> Float { libm_floor(x) }
#Export(c) jet_std_math_fma: fn(a: Float, b: Float, c: Float) -> Float { libm_fma(a, b, c) }
#Export(c) jet_std_math_fmod: fn(x: Float, y: Float) -> Float { libm_fmod(x, y) }
#Export(c) jet_std_math_hypot: fn(x: Float, y: Float) -> Float { libm_hypot(x, y) }
#Export(c) jet_std_math_ln: fn(x: Float) -> Float { libm_log(x) }
#Export(c) jet_std_math_ln_1p: fn(x: Float) -> Float { libm_log1p(x) }
#Export(c) jet_std_math_log10: fn(x: Float) -> Float { libm_log10(x) }
#Export(c) jet_std_math_log2: fn(x: Float) -> Float { libm_log2(x) }
// Float `**` (jet_pow: f64::powf); native programs call this export.
#Export(c) jet_std_math_pow: fn(x: Float, y: Float) -> Float { libm_pow(x, y) }
#Export(c) jet_std_math_sin: fn(x: Float) -> Float { libm_sin(x) }
#Export(c) jet_std_math_sinh: fn(x: Float) -> Float { libm_sinh(x) }
#Export(c) jet_std_math_sqrt: fn(x: Float) -> Float { libm_sqrt(x) }
#Export(c) jet_std_math_tan: fn(x: Float) -> Float { libm_tan(x) }
#Export(c) jet_std_math_tanh: fn(x: Float) -> Float { libm_tanh(x) }
#Export(c) jet_std_math_trunc: fn(x: Float) -> Float { libm_trunc(x) }

// abs is a sign-bit clear, including -0 and signaling NaN payloads.
#Export(c) jet_std_math_abs_f64: fn(x: Float) -> Float {
    rt_f64_from_bits(rt_f64_bits(x).bit_and(I64{9223372036854775807}))
}
#Export(c) jet_std_math_is_nan: fn(x: Float) -> Bool {
    (rt_f64_bits(x).bit_and(I64{9223372036854775807})) > I64{9218868437227405312}
}
#Export(c) jet_std_math_is_infinite: fn(x: Float) -> Bool {
    (rt_f64_bits(x).bit_and(I64{9223372036854775807})) == I64{9218868437227405312}
}
#Export(c) jet_std_math_is_finite: fn(x: Float) -> Bool {
    (rt_f64_bits(x).bit_and(I64{9223372036854775807})) < I64{9218868437227405312}
}
// partial_cmp: equal zeros; all NaNs equal and after numbers.
#Export(c) jet_std_math_cmp: fn(a: Float, b: Float) -> I64 {
    if (a < b) -> return I64{-1}
    if (a == b) -> return I64{0}
    if (a > b) -> return I64{1}
    if jet_std_math_is_nan(a) {
        return if jet_std_math_is_nan(b) -> I64{0} else -> I64{1}
    }
    I64{-1}
}
// FloatBits.jet supplies the already-audited native IR bitcast intrinsic.
// Native Word inputs are exact Int carriers. int_word is the existing
// allocation-free wrapping-u64 projection, matching evaluator wrapping_bits.
#Export(c) jet_std_math_from_bits: fn(bits: I64) -> Float {
    raw: if int_inline(bits) -> bits else -> int_word(bits)
    rt_f64_from_bits(raw)
}
#Export(c) jet_std_math_to_bits: fn(x: Float) -> I64 { jet_int_owned_from_i64(rt_f64_bits(x)) }
// Rust f64::sin_cos evaluates the separate sin/cos calls, in that tuple order.
#Export(c) jet_std_math_sin_cos: fn(x: Float, sine: I64, cosine: I64) {
    s: libm_sin(x)
    c: libm_cos(x)
    rt_text_store(sine, rt_f64_bits(s))
    rt_text_store(cosine, rt_f64_bits(c))
}
