// Native compiler math routes, parity: Jet-only (Rust frozen). The Rust
// originals delegate these operations to f64's platform intrinsics/libm. Import
// that same C operation, never approximate transcendental functions or unfuse
// mul_add. The runtime link supplies libm.
#Import(c) compiler_math_acos: fn(x: Float) -> Float = "acos"
#Import(c) compiler_math_acosh: fn(x: Float) -> Float = "acosh"
#Import(c) compiler_math_asin: fn(x: Float) -> Float = "asin"
#Import(c) compiler_math_asinh: fn(x: Float) -> Float = "asinh"
#Import(c) compiler_math_atan: fn(x: Float) -> Float = "atan"
#Import(c) compiler_math_atan2: fn(y: Float, x: Float) -> Float = "atan2"
#Import(c) compiler_math_atanh: fn(x: Float) -> Float = "atanh"
#Import(c) compiler_math_cbrt: fn(x: Float) -> Float = "cbrt"
#Import(c) compiler_math_ceil: fn(x: Float) -> Float = "ceil"
#Import(c) compiler_math_cos: fn(x: Float) -> Float = "cos"
#Import(c) compiler_math_cosh: fn(x: Float) -> Float = "cosh"
#Import(c) compiler_math_exp: fn(x: Float) -> Float = "exp"
#Import(c) compiler_math_exp_m1: fn(x: Float) -> Float = "expm1"
#Import(c) compiler_math_exp2: fn(x: Float) -> Float = "exp2"
#Import(c) compiler_math_floor: fn(x: Float) -> Float = "floor"
#Import(c) compiler_math_fma: fn(a: Float, b: Float, c: Float) -> Float = "fma"
#Import(c) compiler_math_fmod: fn(x: Float, y: Float) -> Float = "fmod"
#Import(c) compiler_math_hypot: fn(x: Float, y: Float) -> Float = "hypot"
#Import(c) compiler_math_ln: fn(x: Float) -> Float = "log"
#Import(c) compiler_math_ln_1p: fn(x: Float) -> Float = "log1p"
#Import(c) compiler_math_log10: fn(x: Float) -> Float = "log10"
#Import(c) compiler_math_log2: fn(x: Float) -> Float = "log2"
#Import(c) compiler_math_pow: fn(x: Float, y: Float) -> Float = "pow"
#Import(c) compiler_math_sin: fn(x: Float) -> Float = "sin"
#Import(c) compiler_math_sinh: fn(x: Float) -> Float = "sinh"
#Import(c) compiler_math_sqrt: fn(x: Float) -> Float = "sqrt"
#Import(c) compiler_math_tan: fn(x: Float) -> Float = "tan"
#Import(c) compiler_math_tanh: fn(x: Float) -> Float = "tanh"
#Import(c) compiler_math_trunc: fn(x: Float) -> Float = "trunc"

#Export(c) jet_std_math_acos: fn(x: Float) -> Float { compiler_math_acos(x) }
#Export(c) jet_std_math_acosh: fn(x: Float) -> Float { compiler_math_acosh(x) }
#Export(c) jet_std_math_asin: fn(x: Float) -> Float { compiler_math_asin(x) }
#Export(c) jet_std_math_asinh: fn(x: Float) -> Float { compiler_math_asinh(x) }
#Export(c) jet_std_math_atan: fn(x: Float) -> Float { compiler_math_atan(x) }
#Export(c) jet_std_math_atan2: fn(y: Float, x: Float) -> Float { compiler_math_atan2(y, x) }
#Export(c) jet_std_math_atanh: fn(x: Float) -> Float { compiler_math_atanh(x) }
#Export(c) jet_std_math_cbrt: fn(x: Float) -> Float { compiler_math_cbrt(x) }
#Export(c) jet_std_math_ceil: fn(x: Float) -> Float { compiler_math_ceil(x) }
#Export(c) jet_std_math_cos: fn(x: Float) -> Float { compiler_math_cos(x) }
#Export(c) jet_std_math_cosh: fn(x: Float) -> Float { compiler_math_cosh(x) }
#Export(c) jet_std_math_exp: fn(x: Float) -> Float { compiler_math_exp(x) }
#Export(c) jet_std_math_exp_m1: fn(x: Float) -> Float { compiler_math_exp_m1(x) }
#Export(c) jet_std_math_exp2: fn(x: Float) -> Float { compiler_math_exp2(x) }
#Export(c) jet_std_math_floor: fn(x: Float) -> Float { compiler_math_floor(x) }
#Export(c) jet_std_math_fma: fn(a: Float, b: Float, c: Float) -> Float { compiler_math_fma(a, b, c) }
#Export(c) jet_std_math_fmod: fn(x: Float, y: Float) -> Float { compiler_math_fmod(x, y) }
#Export(c) jet_std_math_hypot: fn(x: Float, y: Float) -> Float { compiler_math_hypot(x, y) }
#Export(c) jet_std_math_ln: fn(x: Float) -> Float { compiler_math_ln(x) }
#Export(c) jet_std_math_ln_1p: fn(x: Float) -> Float { compiler_math_ln_1p(x) }
#Export(c) jet_std_math_log10: fn(x: Float) -> Float { compiler_math_log10(x) }
#Export(c) jet_std_math_log2: fn(x: Float) -> Float { compiler_math_log2(x) }
// Float `**` (jet_pow: f64::powf). Native programs call this export: the
// runtime pack's platform libm is private to the pack.
#Export(c) jet_std_math_pow: fn(x: Float, y: Float) -> Float { compiler_math_pow(x, y) }
#Export(c) jet_std_math_sin: fn(x: Float) -> Float { compiler_math_sin(x) }
#Export(c) jet_std_math_sinh: fn(x: Float) -> Float { compiler_math_sinh(x) }
#Export(c) jet_std_math_sqrt: fn(x: Float) -> Float { compiler_math_sqrt(x) }
#Export(c) jet_std_math_tan: fn(x: Float) -> Float { compiler_math_tan(x) }
#Export(c) jet_std_math_tanh: fn(x: Float) -> Float { compiler_math_tanh(x) }
#Export(c) jet_std_math_trunc: fn(x: Float) -> Float { compiler_math_trunc(x) }

// abs is a sign-bit clear, including -0 and signaling NaN payloads.
#Export(c) jet_std_math_abs_f64: fn(x: Float) -> Float {
    rt_f64_from_bits(rt_f64_bits(x).bit_and(I64{9223372036854775807}))
}
#Export(c) jet_std_math_is_nan: fn(x: Float) -> Bool {
    (rt_f64_bits(x).bit_and(I64{9223372036854775807})) > I64{9218868437227405312}
}
#Export(c) jet_std_math_is_infinite: fn(x: Float) -> Bool {
    (rt_f64_bits(x).bit_and(I64{9223372036854775807})) == I64{9218868437227405312}
}
#Export(c) jet_std_math_is_finite: fn(x: Float) -> Bool {
    (rt_f64_bits(x).bit_and(I64{9223372036854775807})) < I64{9218868437227405312}
}
// partial_cmp: equal zeros; all NaNs equal and after numbers.
#Export(c) jet_std_math_cmp: fn(a: Float, b: Float) -> I64 {
    if (a < b) -> return I64{-1}
    if (a == b) -> return I64{0}
    if (a > b) -> return I64{1}
    if jet_std_math_is_nan(a) {
        return if jet_std_math_is_nan(b) -> I64{0} else -> I64{1}
    }
    I64{-1}
}
// FloatBits.jet supplies the already-audited native IR bitcast intrinsic.
// Native Word inputs are exact Int carriers. int_word is the existing
// allocation-free wrapping-u64 projection, matching evaluator wrapping_bits.
#Export(c) jet_std_math_from_bits: fn(bits: I64) -> Float {
    raw: if int_inline(bits) -> bits else -> int_word(bits)
    rt_f64_from_bits(raw)
}
#Export(c) jet_std_math_to_bits: fn(x: Float) -> I64 { jet_int_owned_from_i64(rt_f64_bits(x)) }
// Rust f64::sin_cos evaluates the separate sin/cos calls, in that tuple order.
#Export(c) jet_std_math_sin_cos: fn(x: Float, sine: I64, cosine: I64) {
    s: compiler_math_sin(x)
    c: compiler_math_cos(x)
    rt_text_store(sine, rt_f64_bits(s))
    rt_text_store(cosine, rt_f64_bits(c))
}
