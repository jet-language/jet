// Adapted ownership loops/borrowed field ABI from c1896f121/4d4c53097.
// Ui.rs:64-101 determines semantics, including key and raw Option<i64>
// callbacks. UiABI.jet is the only layout; no transfers, closures or refcounts.
fn ui_node_children_clone(header: I64) -> I64 {
    length :: ui_carrier_word(header + DATA_SEQUENCE_LENGTH)
    result :: data_sequence_new(length, UI_NODE_CHILD_BYTES)
    source :: ui_carrier_word(header + DATA_SEQUENCE_DATA)
    target :: ui_carrier_word(result + DATA_SEQUENCE_DATA)
    index := I64{0}
    loop index < length {
        ui_carrier_store(target + index * UI_NODE_CHILD_BYTES, jet_rt_handle_clone_jet_ui_node(ui_carrier_word(source + index * UI_NODE_CHILD_BYTES)))
        index += I64{1}
    }
    ui_carrier_store(result + DATA_SEQUENCE_LENGTH, length)
    result
}
fn ui_node_children_drop(header: I64) {
    length :: ui_carrier_word(header + DATA_SEQUENCE_LENGTH)
    capacity :: ui_carrier_word(header + DATA_SEQUENCE_CAPACITY)
    data :: ui_carrier_word(header + DATA_SEQUENCE_DATA)
    index := I64{0}
    loop index < length {
        jet_rt_handle_drop_jet_ui_node(ui_carrier_word(data + index * UI_NODE_CHILD_BYTES))
        index += I64{1}
    }
    if (capacity != I64{0}) -> jet_rt_free(data, capacity * UI_NODE_CHILD_BYTES, I64{8})
    jet_rt_free(header, DATA_SEQUENCE_BYTES, I64{8})
}
fn ui_node_children_eq(left: I64, right: I64) -> Bool {
    length :: ui_carrier_word(left + DATA_SEQUENCE_LENGTH)
    if (length != ui_carrier_word(right + DATA_SEQUENCE_LENGTH)) -> return false
    a :: ui_carrier_word(left + DATA_SEQUENCE_DATA)
    b :: ui_carrier_word(right + DATA_SEQUENCE_DATA)
    index := I64{0}
    loop index < length {
        if !jet_rt_handle_eq_jet_ui_node(ui_carrier_word(a + index * UI_NODE_CHILD_BYTES), ui_carrier_word(b + index * UI_NODE_CHILD_BYTES)) -> return false
        index += I64{1}
    }
    true
}
// Node's inline optional color has one-based tags (0 absent).
fn ui_node_color_payload(kind: I64, word: I64) -> I64 {
    if {
        (kind == I64{0}) -> I64{0}
        (kind == I64{3}) -> word.bit_and(I64{16777215})
        else -> word.bit_and(I64{255})
    }
}
fn ui_node_color_clone(source: I64, target: I64) {
    kind :: ui_carrier_word(source)
    ui_carrier_store(target, kind)
    ui_carrier_store(target + I64{8}, if (kind == I64{0}) -> I64{0} else -> ui_node_color_payload(kind, ui_carrier_word(source + I64{8})))
}
fn ui_node_color_eq(left: I64, right: I64) -> Bool {
    kind :: ui_carrier_word(left)
    if (kind != ui_carrier_word(right)) -> return false
    if (kind == I64{0}) -> return true
    ui_node_color_payload(kind, ui_carrier_word(left + I64{8})) == ui_node_color_payload(kind, ui_carrier_word(right + I64{8}))
}
fn ui_node_option_clone(source: I64, target: I64, mask: I64, slot: I64, offset: I64) {
    ui_carrier_store(target + offset, if ((mask.bit_and(slot)) != I64{0}) -> I64{0} else -> ui_carrier_word(source + offset))
}
fn ui_node_option_eq(left: I64, right: I64, a: I64, b: I64, slot: I64, offset: I64) -> Bool {
    if ((a.bit_and(slot)) != (b.bit_and(slot))) -> return false
    if ((a.bit_and(slot)) != I64{0}) -> return true
    ui_carrier_word(left + offset) == ui_carrier_word(right + offset)
}
#Export(c) fn jet_rt_handle_clone_jet_ui_node(value: I64) -> I64 {
    result :: jet_rt_alloc(UI_NODE_BYTES, I64{8})
    ui_carrier_store(result + UI_NODE_LABEL, jet_rt_string_clone(ui_carrier_word(value + UI_NODE_LABEL)))
    ui_carrier_store(result + UI_NODE_WIDTH, ui_carrier_word(value + UI_NODE_WIDTH))
    ui_carrier_store(result + UI_NODE_HEIGHT, ui_carrier_word(value + UI_NODE_HEIGHT))
    ui_carrier_store(result + UI_NODE_ROLE, ui_carrier_word(value + UI_NODE_ROLE))
    accessibility :: ui_carrier_word(value + UI_NODE_ACCESSIBILITY)
    ui_carrier_store(result + UI_NODE_ACCESSIBILITY, if (accessibility == I64{0}) -> I64{0} else -> jet_rt_handle_clone_jet_ui_accessibility(accessibility))
    mask :: ui_carrier_word(value + UI_NODE_ABSENT_MASK).bit_and(UI_NODE_OPTION_MASK)
    ui_carrier_store(result + UI_NODE_ABSENT_MASK, mask)
    ui_node_option_clone(value, result, mask, UI_NODE_SLOT_IME, UI_NODE_IME)
    ui_carrier_store(result + UI_NODE_COLOR, ui_optional_text_clone(ui_carrier_word(value + UI_NODE_COLOR)))
    style :: ui_carrier_bool(value + UI_NODE_STYLE_PRESENT)
    ui_carrier_store(result + UI_NODE_STYLE_PRESENT, style)
    if {
        (style != I64{0}) -> {
            ui_node_color_clone(value + UI_NODE_FOREGROUND_KIND, result + UI_NODE_FOREGROUND_KIND)
            ui_node_color_clone(value + UI_NODE_BACKGROUND_KIND, result + UI_NODE_BACKGROUND_KIND)
            ui_carrier_store(result + UI_NODE_STYLE_FLAGS, ui_carrier_word(value + UI_NODE_STYLE_FLAGS).bit_and(I64{7}))
        }
        else -> {
            offset := UI_NODE_FOREGROUND_KIND
            loop offset <= UI_NODE_STYLE_FLAGS {
                ui_carrier_store(result + offset, I64{0})
                offset += I64{8}
            }
        }
    }
    ui_carrier_store(result + UI_NODE_KIND, ui_carrier_word(value + UI_NODE_KIND))
    ui_carrier_store(result + UI_NODE_CHILDREN, ui_node_children_clone(ui_carrier_word(value + UI_NODE_CHILDREN)))
    ui_carrier_store(result + UI_NODE_KEY, ui_optional_text_clone(ui_carrier_word(value + UI_NODE_KEY)))
    ui_node_option_clone(value, result, mask, UI_NODE_SLOT_CLICK, UI_NODE_CLICK_FN)
    ui_node_option_clone(value, result, mask, UI_NODE_SLOT_DROP, UI_NODE_DROP_FN)
    shortcut :: ui_carrier_word(value + UI_NODE_SHORTCUT)
    ui_carrier_store(result + UI_NODE_SHORTCUT, if (shortcut == I64{0}) -> I64{0} else -> jet_rt_handle_clone_jet_ui_shortcut(shortcut))
    result
}
#Export(c) fn jet_rt_handle_drop_jet_ui_node(value: I64) {
    if (value == I64{0}) -> return
    jet_rt_string_drop(ui_carrier_word(value + UI_NODE_LABEL))
    accessibility :: ui_carrier_word(value + UI_NODE_ACCESSIBILITY)
    if (accessibility != I64{0}) -> jet_rt_handle_drop_jet_ui_accessibility(accessibility)
    ui_optional_text_drop(ui_carrier_word(value + UI_NODE_COLOR))
    ui_node_children_drop(ui_carrier_word(value + UI_NODE_CHILDREN))
    ui_optional_text_drop(ui_carrier_word(value + UI_NODE_KEY))
    shortcut :: ui_carrier_word(value + UI_NODE_SHORTCUT)
    if (shortcut != I64{0}) -> jet_rt_handle_drop_jet_ui_shortcut(shortcut)
    jet_rt_free(value, UI_NODE_BYTES, I64{8})
}
#Export(c) fn jet_rt_handle_eq_jet_ui_node(left: I64, right: I64) -> Bool {
    if !jet_rt_string_eq(ui_carrier_word(left + UI_NODE_LABEL), ui_carrier_word(right + UI_NODE_LABEL)) -> return false
    // IEEE PartialEq even on the same owner: NaN != NaN, -0 == +0.
    if (rt_f64_from_bits(ui_carrier_word(left + UI_NODE_WIDTH)) != rt_f64_from_bits(ui_carrier_word(right + UI_NODE_WIDTH))) -> return false
    if (rt_f64_from_bits(ui_carrier_word(left + UI_NODE_HEIGHT)) != rt_f64_from_bits(ui_carrier_word(right + UI_NODE_HEIGHT))) -> return false
    if (ui_carrier_word(left + UI_NODE_ROLE) != ui_carrier_word(right + UI_NODE_ROLE)) -> return false
    accessibility_a :: ui_carrier_word(left + UI_NODE_ACCESSIBILITY)
    accessibility_b :: ui_carrier_word(right + UI_NODE_ACCESSIBILITY)
    if {
        (accessibility_a == I64{0} || accessibility_b == I64{0}) -> {
            if (accessibility_a != accessibility_b) -> return false
        }
        else -> {
            if !jet_rt_handle_eq_jet_ui_accessibility(accessibility_a, accessibility_b) -> return false
        }
    }
    a :: ui_carrier_word(left + UI_NODE_ABSENT_MASK)
    b :: ui_carrier_word(right + UI_NODE_ABSENT_MASK)
    if !ui_node_option_eq(left, right, a, b, UI_NODE_SLOT_IME, UI_NODE_IME) -> return false
    if !ui_optional_text_eq(ui_carrier_word(left + UI_NODE_COLOR), ui_carrier_word(right + UI_NODE_COLOR)) -> return false
    style :: ui_carrier_bool(left + UI_NODE_STYLE_PRESENT)
    if (style != ui_carrier_bool(right + UI_NODE_STYLE_PRESENT)) -> return false
    if (style != I64{0}) {
        if !ui_node_color_eq(left + UI_NODE_FOREGROUND_KIND, right + UI_NODE_FOREGROUND_KIND) -> return false
        if !ui_node_color_eq(left + UI_NODE_BACKGROUND_KIND, right + UI_NODE_BACKGROUND_KIND) -> return false
        if ((ui_carrier_word(left + UI_NODE_STYLE_FLAGS).bit_and(I64{7})) != (ui_carrier_word(right + UI_NODE_STYLE_FLAGS).bit_and(I64{7}))) -> return false
    }
    if (ui_carrier_word(left + UI_NODE_KIND) != ui_carrier_word(right + UI_NODE_KIND)) -> return false
    if !ui_node_children_eq(ui_carrier_word(left + UI_NODE_CHILDREN), ui_carrier_word(right + UI_NODE_CHILDREN)) -> return false
    if !ui_optional_text_eq(ui_carrier_word(left + UI_NODE_KEY), ui_carrier_word(right + UI_NODE_KEY)) -> return false
    if !ui_node_option_eq(left, right, a, b, UI_NODE_SLOT_CLICK, UI_NODE_CLICK_FN) -> return false
    if !ui_node_option_eq(left, right, a, b, UI_NODE_SLOT_DROP, UI_NODE_DROP_FN) -> return false
    shortcut_a :: ui_carrier_word(left + UI_NODE_SHORTCUT)
    shortcut_b :: ui_carrier_word(right + UI_NODE_SHORTCUT)
    if {
        (shortcut_a == I64{0} || shortcut_b == I64{0}) -> {
            if (shortcut_a != shortcut_b) -> return false
        }
        else -> {
            if !jet_rt_handle_eq_jet_ui_shortcut(shortcut_a, shortcut_b) -> return false
        }
    }
    true
}
#Export(c) fn jet_rt_handle_field_jet_ui_node_label(value: I64, out: I64) { ui_borrow_text(ui_carrier_word(value + UI_NODE_LABEL), out) }
#Export(c) fn jet_rt_handle_field_jet_ui_node_width(value: I64) -> I64 { value + UI_NODE_WIDTH }
#Export(c) fn jet_rt_handle_field_jet_ui_node_height(value: I64) -> I64 { value + UI_NODE_HEIGHT }
#Export(c) fn jet_rt_record_seq_list_rec_jet_ui_node_new(capacity: I64) -> I64 { data_sequence_new(capacity, UI_NODE_CHILD_BYTES) }
#Export(c) fn jet_rt_record_seq_list_rec_jet_ui_node_len(value: I64) -> I64 { ui_carrier_word(value + DATA_SEQUENCE_LENGTH) }
#Export(c) fn jet_rt_record_seq_list_rec_jet_ui_node_get(value: I64, index: I64) -> I64 { ui_carrier_word(data_sequence_slot(value, index, UI_NODE_CHILD_BYTES)) }
#Export(c) fn jet_rt_record_seq_list_rec_jet_ui_node_push(value: I64, item: I64) {
    ui_carrier_store(data_sequence_reserve(value, UI_NODE_CHILD_BYTES), item)
    ui_carrier_store(value + DATA_SEQUENCE_LENGTH, ui_carrier_word(value + DATA_SEQUENCE_LENGTH) + I64{1})
}
