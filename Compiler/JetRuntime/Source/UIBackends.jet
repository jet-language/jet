// The Rect/Size/InputEvent records core.ui's backends cross the runtime
// with, a web build's scene, and the click slots of buttons and the drop and
// change slots of text inputs. The backends themselves are Jet
// (Core/UI/UI.jet).
UI_RECT_BYTES: I64{32}

UI_SIZE_BYTES: I64{16}

// ---- Rect / Size / InputEvent records -------------------------------------

#Export(c) jet_rt_record_new_jet_rect: fn(x: Float, y: Float, width: Float, height: Float) -> I64 {
    ui_rect_new(x, y, width, height)
}

#Export(c) jet_rt_handle_drop_jet_rect: fn(value: I64) { geometry_drop(value, UI_RECT_BYTES) }

#Export(c) jet_rt_record_new_jet_size: fn(width: Float, height: Float) -> I64 {
    result: jet_rt_alloc(UI_SIZE_BYTES, I64{8})
    ui_carrier_store(result, rt_f64_bits(width))
    ui_carrier_store(wrapping(result + I64{8}), rt_f64_bits(height))
    result
}

#Export(c) jet_rt_handle_drop_jet_size: fn(value: I64) { geometry_drop(value, UI_SIZE_BYTES) }

#Export(c) jet_rt_record_get_jet_size_width: fn(value: I64) -> Float { ui_float_at(value) }

#Export(c) jet_rt_record_get_jet_size_height: fn(value: I64) -> Float {
    ui_float_at(wrapping(value + I64{8}))
}

// Key borrows its code; Resize takes the Size record over (its two lanes
// move inline, UiEvents.jet's layout).
#Export(c) jet_rt_record_new_jet_input_event_key: fn(code: I64) -> I64 {
    result: jet_rt_alloc(UI_EVENT_BYTES, I64{8})
    ui_carrier_store(wrapping(result + UI_EVENT_KIND), I64{0})
    ui_carrier_store(wrapping(result + UI_EVENT_FIRST), jet_rt_string_clone(code))
    ui_carrier_store(wrapping(result + UI_EVENT_SECOND), I64{0})
    result
}

#Export(c) jet_rt_record_new_jet_input_event_resize: fn(size: I64) -> I64 {
    result: jet_rt_alloc(UI_EVENT_BYTES, I64{8})
    ui_carrier_store(wrapping(result + UI_EVENT_KIND), I64{1})
    ui_carrier_store(wrapping(result + UI_EVENT_FIRST), ui_carrier_word(size))
    ui_carrier_store(wrapping(result + UI_EVENT_SECOND), ui_carrier_word(wrapping(size + I64{8})))
    geometry_drop(size, UI_SIZE_BYTES)
    result
}

ui_float_at: fn(address: I64) -> Float { rt_f64_from_bits(ui_carrier_word(address)) }

ui_float_store: fn(address: I64, value: Float) { ui_carrier_store(address, rt_f64_bits(value)) }

ui_rect_new: fn(x: Float, y: Float, width: Float, height: Float) -> I64 {
    result: jet_rt_alloc(UI_RECT_BYTES, I64{8})
    ui_float_store(result, x)
    ui_float_store(wrapping(result + I64{8}), y)
    ui_float_store(wrapping(result + I64{16}), width)
    ui_float_store(wrapping(result + I64{24}), height)
    result
}

// ---- web scene --------------------------------------------------------------

// A web build's page attaches before its module runs; from then on each
// paint hands over its scene (core.ui's scene records), which the host takes
// once per paint.
ui_web_attached := I64{0}

ui_web_scene := I64{0}

ui_web_scene_fresh := I64{0}

#Export(c) jet_ui_web_attach: fn() {
    #Unsafe("a web page's module runs on one thread") { ui_web_attached = I64{1} }
}

// core.ui.__web_attached: whether a web page attached.
#Export(c) jet_ui_web_attached: fn() -> Bool { ui_web_attached != I64{0} }

// core.ui.__web_scene: keeps a copy of the borrowed scene as the latest.
#Export(c) jet_ui_web_scene: fn(text: I64) {
    scene: jet_rt_string_clone(text)
    if (ui_web_scene != I64{0}) { jet_rt_string_drop(ui_web_scene) }
    #Unsafe("only an attached web build records, on its one thread") {
        ui_web_scene = scene
        ui_web_scene_fresh = I64{1}
    }
}

// 1 once per paint since the host last asked, then the scene's bytes are
// jet_ui_web_scene_data and jet_ui_web_scene_length; else 0.
#Export(c) jet_ui_web_scene_take: fn() -> I64 {
    fresh: ui_web_scene_fresh
    #Unsafe("a web page's module runs on one thread") { ui_web_scene_fresh = I64{0} }
    fresh
}

#Export(c) jet_ui_web_scene_data: fn() -> I64 {
    if (ui_web_scene == I64{0}) { return I64{0} }
    rt_text_data(ui_web_scene)
}

#Export(c) jet_ui_web_scene_length: fn() -> I64 {
    if (ui_web_scene == I64{0}) { return I64{0} }
    rt_text_len(ui_web_scene)
}

// ---- click and drop slots ---------------------------------------------------

// ids from 1; each slot keeps its handler (env, invoke, release) for the
// process, as the reference's registry does. A button or text input may be
// built on any task, so registration runs under the host lock. Each registry
// is one word vector (len0 cap8 data16, Events.jet event_words_*): the click
// slots, which keep any callback closure (a button's click handler, a text
// input's change handler), and the drop slots of text inputs.
ui_click_slots := I64{0}

ui_drop_slots := I64{0}

ui_slots_new: fn() -> I64 {
    base: jet_rt_alloc(I64{24}, I64{8})
    ui_carrier_store(base, I64{0})
    ui_carrier_store(wrapping(base + I64{8}), I64{0})
    ui_carrier_store(wrapping(base + I64{16}), I64{0})
    base
}

// Keeps the handler in registry `base`, which the host lock holder owns, and
// returns its id.
ui_slots_push: fn(base: I64, env: I64, invoke: I64, release: I64) -> I64 {
    event_words_push(base, env)
    event_words_push(base, invoke)
    event_words_push(base, release)
    ui_carrier_word(base) / I64{3}
}

// `ui.button(…, () -> { on_click })` and `ui.text_input(…, on_change: (text)
// -> { … })`: the click slot keeping the handler closure, which it takes
// over, as the Int core.ui's `__button_click` and `text_input_change` store.
#Export(c) jet_ui_click_slot: fn(env: I64, invoke: I64, release: I64) -> I64 {
    host_lock()
    if (ui_click_slots == I64{0}) {
        #Unsafe("written under the host lock") { ui_click_slots = ui_slots_new() }
    }
    id: ui_slots_push(ui_click_slots, env, invoke, release)
    host_unlock()
    jet_int_owned_from_i64(id)
}

// `ui.text_input(…, on_drop: (item) -> { … })`: the drop slot keeping the
// handler closure, which it takes over, as the Int core.ui's
// `text_input_drop` stores.
#Export(c) jet_ui_drop_slot: fn(env: I64, invoke: I64, release: I64) -> I64 {
    host_lock()
    if (ui_drop_slots == I64{0}) {
        #Unsafe("written under the host lock") { ui_drop_slots = ui_slots_new() }
    }
    id: ui_slots_push(ui_drop_slots, env, invoke, release)
    host_unlock()
    jet_int_owned_from_i64(id)
}

// core.ui.__click, and a web host's click on a scene element: runs the
// handler click slot `id` keeps, as the reactive runtime runs an effect body
// (invoke(env, out) with no result slot). The slot is read under the host
// lock, as any task may be registering one; the handler runs after it. An
// unknown id does nothing.
#Export(c) jet_ui_click: fn(id: I64) {
    host_lock()
    base: ui_click_slots
    known: base != I64{0} && id >= I64{1} && id * I64{3} <= ui_carrier_word(base)
    first: (id - I64{1}) * I64{3}
    invoke: if (known) -> event_words_get(base, first + I64{1}) else -> I64{0}
    env: if (known) -> event_words_get(base, first) else -> I64{0}
    host_unlock()
    if (!known) {
        return
    }
    _ := coll_call2(invoke, env, I64{0})
}

// The UTF-8 text a web host hands over, the item it is dropping or what a
// text input now holds: the host writes it into the bytes
// jet_ui_web_text_buffer returns, then jet_ui_web_drop or
// jet_ui_web_change takes them.
ui_web_text_bytes := I64{0}

ui_web_text_length := I64{0}

#Export(c) jet_ui_web_text_buffer: fn(length: I64) -> I64 {
    bytes: jet_rt_alloc(wrapping(length + I64{1}), I64{1})
    #Unsafe("a web page's module runs on one thread") {
        ui_web_text_bytes = bytes
        ui_web_text_length = length
    }
    bytes
}

// The String of the text in jet_ui_web_text_buffer's bytes, which it frees;
// 0 when the host wrote none.
ui_web_text_take: fn() -> I64 {
    bytes: ui_web_text_bytes
    length: ui_web_text_length
    if (bytes == I64{0}) { return I64{0} }
    #Unsafe("a web page's module runs on one thread") {
        ui_web_text_bytes = I64{0}
        ui_web_text_length = I64{0}
    }
    text: rt_text_copy(bytes, length)
    jet_rt_free(bytes, wrapping(length + I64{1}), I64{1})
    text
}

// A web host's drop of one item on a scene element: the drop of a Text
// (kind 0) or URI (kind 1) item over the text in jet_ui_web_text_buffer's
// bytes on drop slot `id` (ui_drop_run).
#Export(c) jet_ui_web_drop: fn(id: I64, kind: I64) {
    text: ui_web_text_take()
    if (text == I64{0}) {
        return
    }
    ui_drop_run(id, kind, text)
}

// core.ui.__drop: a native window's drop of one item on a text input, as
// jet_ui_web_drop, over a copy of the borrowed text.
#Export(c) jet_ui_drop: fn(id: I64, kind: I64, text: I64) {
    ui_drop_run(id, kind, jet_rt_string_clone(text))
}

// Runs the handler drop slot `id` keeps on a Text (kind 0) or URI (kind 1)
// item whose text it takes over, through the slot's lazy.ui_drop adapter
// (invoke(env, kind, text), which takes the text over). The slot is read
// under the host lock, as jet_ui_click's is. An unknown id or kind drops
// the text and does nothing.
ui_drop_run: fn(id: I64, kind: I64, text: I64) {
    host_lock()
    base: ui_drop_slots
    known: base != I64{0} && id >= I64{1} && id * I64{3} <= ui_carrier_word(base) && (kind == I64{0} || kind == I64{1})
    first: (id - I64{1}) * I64{3}
    invoke: if (known) -> event_words_get(base, first + I64{1}) else -> I64{0}
    env: if (known) -> event_words_get(base, first) else -> I64{0}
    host_unlock()
    if (!known) {
        jet_rt_string_drop(text)
        return
    }
    _ := coll_call3(invoke, env, kind, text)
}

// A web host's input in a text input: what the input holds now, the text in
// jet_ui_web_text_buffer's bytes, on its change handler's click slot `id`
// (ui_change_run).
#Export(c) jet_ui_web_change: fn(id: I64) {
    text: ui_web_text_take()
    if (text == I64{0}) {
        return
    }
    ui_change_run(id, text)
}

// core.ui.__change: a native window's typing in a text input, as
// jet_ui_web_change, over a copy of the borrowed text.
#Export(c) jet_ui_change: fn(id: I64, text: I64) { ui_change_run(id, jet_rt_string_clone(text)) }

// Runs the change handler click slot `id` keeps on `text`, which it takes
// over, through the slot's lazy.callback adapter (invoke(env, the address
// of a word holding the text, out), which borrows the text), then drops the
// text. The slot is read under the host lock, as jet_ui_click's is. An
// unknown id drops the text and does nothing.
ui_change_run: fn(id: I64, text: I64) {
    host_lock()
    base: ui_click_slots
    known: base != I64{0} && id >= I64{1} && id * I64{3} <= ui_carrier_word(base)
    first: (id - I64{1}) * I64{3}
    invoke: if (known) -> event_words_get(base, first + I64{1}) else -> I64{0}
    env: if (known) -> event_words_get(base, first) else -> I64{0}
    host_unlock()
    if (known) {
        lent: jet_rt_alloc(I64{8}, I64{8})
        ui_carrier_store(lent, text)
        _ := coll_call3(invoke, env, lent, I64{0})
        jet_rt_free(lent, I64{8}, I64{8})
    }
    jet_rt_string_drop(text)
}
