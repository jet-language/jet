// Compiler-required whole-file leaves. Core/Files owns the fault checkpoints,
// UTF-8 validation and mapped-writer refusal; these leaves do only host work.
// Linux transport uses the existing HostFiles/HostProcess and audited OS layer.
compiler_fs_error: fn(kind: I64, operation: I64, path: I64, code: I64, cause: I64, error: I64) -> I64 {
    value: jet_rt_alloc(I64{56}, I64{8})
    rt_text_store(value, kind)
    rt_text_store(wrapping(value + I64{8}), operation)
    rt_text_store(wrapping(value + I64{16}), if (path == I64{0}) -> I64{0} else -> jet_rt_string_clone(path))
    rt_text_store(wrapping(value + I64{24}), if (code == I64{0}) -> I64{0} else -> I64{1})
    rt_text_store(wrapping(value + I64{32}), code)
    rt_text_store(wrapping(value + I64{40}), cause)
    rt_text_store(wrapping(value + I64{48}), I64{0})
    rt_text_store(error, value)
    I64{0}
}
// jet_std::io_error_at: only these std ErrorKinds have their own IOError arm.
// AlreadyExists, Unsupported and the rest are Other.
compiler_fs_errno: fn(operation: I64, path: I64, code: I64, error: I64) -> I64 {
    kind: if {
        (code == I64{2}) -> HOST_IO_KIND_NOT_FOUND
        (code == I64{1} || code == I64{13}) -> HOST_IO_KIND_PERMISSION_DENIED
        (code == I64{22}) -> HOST_IO_KIND_INVALID_INPUT
        (code == I64{32} || code == I64{107}) -> HOST_IO_KIND_CLOSED
        (code == I64{110}) -> HOST_IO_KIND_TIMED_OUT
        else -> HOST_IO_KIND_OTHER
    }
    compiler_fs_error(kind, operation, path, code, compiler_fs_cause(operation, code), error)
}
// The cause of OS error `code`. A run that `jet run --allow='FS.Read("<path>")'`
// confined (JET_READ_SCOPE names the paths; JetBackend Loader.jet
// x64_confine_reads) is refused every other read with EACCES: that cause
// names the refusal E1803 and the paths the run may read.
compiler_fs_cause: fn(operation: I64, code: I64) -> I64 {
    cause: host_errno_cause(code)
    if (code != I64{13} || operation != HOST_IO_OP_READ) -> return cause
    scope: rt_env_get(env_name_jet_read_scope())
    if (scope == I64{0}) -> return cause
    jet_rt_string_builder_push(cause, rt_static_text("; E1803: this run may read only "))
    jet_rt_string_builder_push(cause, scope)
    jet_rt_string_builder_push(cause, rt_static_text(" (`--allow='FS.Read(\"<path>\")'`)"))
    jet_rt_string_drop(scope)
    cause
}
// Whether a leaf may pass `path` to the kernel: no NUL byte, and the effect
// scopes in force admit it (Authority.jet effect_scope_admit_path) as an
// operation that follows a final link; compiler_fs_link_path is the one that
// does not. Else the leaf's IOError goes through `error`.
compiler_fs_path: fn(path: I64, operation: I64, error: I64) -> Bool { compiler_fs_admit(path, operation, true, error) }
compiler_fs_link_path: fn(path: I64, operation: I64, error: I64) -> Bool { compiler_fs_admit(path, operation, false, error) }
compiler_fs_admit: fn(path: I64, operation: I64, follow: Bool, error: I64) -> Bool {
    at := I64{0}
    loop at < rt_text_len(path) {
        if (rt_text_byte(wrapping(rt_text_data(path) + at)) == I64{0}) {
            _ := compiler_fs_error(HOST_IO_KIND_INVALID_INPUT, operation, path, I64{0}, jet_rt_string_clone(rt_static_text("file name contained an unexpected NUL byte")), error)
            return false
        }
        at += I64{1}
    }
    effect_scope_admit_path(path, follow, operation, error)
}
compiler_fs_fault: fn(path: I64, error: I64) -> Bool {
    if !jet_fault_should_fail(rt_static_text("FS.Read")) -> return false
    _ := host_io_other_take(HOST_IO_OP_READ, jet_rt_string_clone(path), jet_rt_string_clone(rt_static_text("fault injected: FS.Read")), error)
    true
}
// Return exactly len native U8 elements; the caller's list owns this allocation.
compiler_fs_bytes_take: fn(bytes: I64, capacity: I64, length: I64, output: I64, len: I64) {
    data := I64{0}
    if (length != I64{0}) {
        if (RT_HOST_U8_STRIDE == I64{1} && length == capacity) { data = bytes } else if (RT_HOST_U8_STRIDE == I64{1}) {
            data = jet_rt_alloc_8(length)
            rt_text_bytes_copy(data, bytes, length)
        } else {
            data = jet_rt_alloc(length * RT_HOST_U8_STRIDE, I64{8})
            at := I64{0}
            loop at < length {
                host_u8_put(data, at, rt_text_byte(wrapping(bytes + at)))
                at += I64{1}
            }
        }
    }
    if (data != bytes) -> jet_rt_free_8(bytes, capacity)
    rt_text_store(output, data)
    rt_text_store(len, length)
}
#Export(c) jet_files_read_bytes_os: fn(path: I64, output: I64, len: I64, error: I64) -> I64 {
    if !compiler_fs_path(path, HOST_IO_OP_READ, error) -> return I64{0}
    name: fd_c_path(path)
    fd: host_call(I64{2}, name, I64{524288}, I64{0})
    if (fd < I64{0}) {
        fd_c_path_drop(name, path)
        return compiler_fs_errno(HOST_IO_OP_READ, path, -fd, error)
    }
    capacity := I64{8192}
    // A regular file's size sizes the buffer once: the reads fill it exactly
    // and the EOF probe ends them, with no growth copies and no final copy.
    facts: jet_rt_alloc(I64{144}, I64{8})
    if (host_call(I64{5}, fd, facts, I64{0}) == I64{0}) {
        size: rt_text_word(wrapping(facts + I64{48}))
        if (rt_text_word(wrapping(facts + I64{24})).bit_and(I64{61440}) == I64{32768} && size > I64{0}) -> capacity = size
    }
    jet_rt_free(facts, I64{144}, I64{8})
    bytes := jet_rt_alloc(capacity, I64{8})
    used := I64{0}
    failure := I64{0}
    loop {
        // Probe EOF before growing, avoiding a final unnecessary reallocation.
        if (used == capacity) {
            // The now-unused terminated path allocation lends its first byte.
            probe: name
            count := I64{0}
            loop {
                count = host_call(I64{0}, fd, probe, I64{1})
                if (count != I64{-4}) -> break
            }
            if (count <= I64{0}) {
                failure = count
                break
            }
            grown: capacity * I64{2}
            next_bytes: jet_rt_alloc(grown, I64{8})
            rt_text_bytes_copy(next_bytes, bytes, used)
            rt_text_put(wrapping(next_bytes + used), rt_text_byte(probe))
            jet_rt_free(bytes, capacity, I64{8})
            bytes = next_bytes
            capacity = grown
            used += I64{1}
        }
        count: host_call(I64{0}, fd, bytes + used, capacity - used)
        if (count == I64{-4}) -> next
        if (count <= I64{0}) {
            failure = count
            break
        }
        used += count
    }
    _ := host_call(I64{3}, fd, I64{0}, I64{0})
    fd_c_path_drop(name, path)
    if (failure < I64{0}) {
        jet_rt_free(bytes, capacity, I64{8})
        return compiler_fs_errno(HOST_IO_OP_READ, path, -failure, error)
    }
    compiler_fs_bytes_take(bytes, capacity, used, output, len)
    I64{1}
}
#Export(c) jet_files_write_bytes_os: fn(path: I64, data: I64, length: I64, error: I64) -> I64 {
    // O_WRONLY | O_CREAT | O_TRUNC | O_CLOEXEC
    compiler_fs_write_open(path, data, length, error, I64{524865})
}
#Export(c) jet_files_append_bytes_os: fn(path: I64, data: I64, length: I64, error: I64) -> I64 {
    // O_WRONLY | O_CREAT | O_APPEND | O_CLOEXEC
    compiler_fs_write_open(path, data, length, error, I64{525377})
}
// Opens `path` with `flags` (mode 0666 before the umask) and writes all of
// `data`; 1, or 0 with the IOError written through `error`.
compiler_fs_write_open: fn(path: I64, data: I64, length: I64, error: I64, flags: I64) -> I64 {
    if !compiler_fs_path(path, HOST_IO_OP_WRITE, error) -> return I64{0}
    name: fd_c_path(path)
    fd: host_call(I64{2}, name, flags, I64{438})
    fd_c_path_drop(name, path)
    if (fd < I64{0}) -> return compiler_fs_errno(HOST_IO_OP_WRITE, path, -fd, error)
    temporary: RT_HOST_U8_STRIDE != I64{1} && length != I64{0}
    packed: if temporary -> jet_rt_alloc(length, I64{8}) else -> data
    if temporary -> net_copy_packed(data, length, packed)
    at := I64{0}
    failure := I64{0}
    loop at < length {
        count: host_call(I64{1}, fd, packed + at, length - at)
        if (count == I64{-4}) -> next
        if (count <= I64{0}) {
            failure = if (count == I64{0}) -> HOST_WRITE_ZERO else -> count
            break
        }
        at += count
    }
    if temporary -> jet_rt_free(packed, length, I64{8})
    _ := host_call(I64{3}, fd, I64{0}, I64{0})
    if (failure == HOST_WRITE_ZERO) -> return host_io_other_take(HOST_IO_OP_WRITE, jet_rt_string_clone(path), host_write_zero_text(), error)
    if (failure < I64{0}) -> return compiler_fs_errno(HOST_IO_OP_WRITE, path, -failure, error)
    I64{1}
}
// mkdir of the NUL-terminated prefix name[0, at): 1 when made, 0 when a directory is
// already there, else the negative errno (-2 when a parent is missing).
compiler_fs_mkdir_prefix: fn(name: I64, at: I64, scratch: I64) -> I64 {
    saved: rt_text_byte(wrapping(name + at))
    rt_text_put(wrapping(name + at), I64{0})
    result := host_call(I64{83}, name, I64{511}, I64{0})
    if (result < I64{0}) {
        // create_dir_all accepts existing directories, not existing files.
        #Unsafe("the prefix remains terminated and scratch lends 128 writable portable stat-fact bytes") {
            stat: os_stat_facts_i64(I64{4}, name, scratch)
            if (stat >= I64{0} && (rt_text_word(wrapping(scratch + I64{16})).bit_and(I64{61440})) == I64{16384}) -> result = I64{0}
        }
    } else {
        result = I64{1}
    }
    rt_text_put(wrapping(name + at), saved)
    result
}
// An existing directory costs one stat. Otherwise mkdir walks back from the whole path to
// the deepest prefix that exists, then forward making the rest: mkdir of a name that is
// already there takes its parent's directory lock, so creating every prefix from the root
// would contend with every other creator under the same ancestors.
#Export(c) jet_files_create_dirs_os: fn(path: I64, error: I64) -> I64 {
    if !compiler_fs_path(path, HOST_IO_OP_WRITE, error) -> return I64{0}
    length: rt_text_len(path)
    if (length == I64{0}) -> return I64{1}
    name: fd_c_path(path)
    scratch: jet_rt_alloc(I64{128}, I64{8})
    present := false
    #Unsafe("name is NUL-terminated and scratch lends 128 writable portable stat-fact bytes") {
        present = os_stat_facts_i64(I64{4}, name, scratch) >= I64{0} && (rt_text_word(wrapping(scratch + I64{16})).bit_and(I64{61440})) == I64{16384}
    }
    result := I64{1}
    if !present {
        at := length
        loop {
            result = compiler_fs_mkdir_prefix(name, at, scratch)
            if (result != I64{-2}) -> break
            back := at - I64{1}
            loop back > (I64{0}) && rt_text_byte(wrapping(name + back)) != (I64{47}) {
                back -= I64{1}
            }
            if (back <= I64{0}) -> break
            at = back
        }
        loop result >= (I64{0}) && at < length {
            at += I64{1}
            loop at < length && rt_text_byte(wrapping(name + at)) != (I64{47}) {
                at += I64{1}
            }
            result = compiler_fs_mkdir_prefix(name, at, scratch)
        }
    }
    jet_rt_free(scratch, I64{128}, I64{8})
    fd_c_path_drop(name, path)
    if (result < I64{0}) -> return compiler_fs_errno(HOST_IO_OP_WRITE, path, -result, error)
    I64{1}
}
#Export(c) jet_files_read_link_os: fn(path: I64, output: I64, error: I64) -> I64 {
    if !compiler_fs_link_path(path, HOST_IO_OP_READ, error) -> return I64{0}
    scratch: jet_rt_alloc(I64{32}, I64{8})
    capacity := I64{256}
    loop {
        bytes: jet_rt_alloc(capacity, I64{8})
        count: jet_fs_readlink_raw(path, bytes, capacity, scratch)
        if (count < I64{0}) {
            code: rt_text_word(wrapping(scratch + I64{8}))
            jet_rt_free(bytes, capacity, I64{8})
            jet_rt_free(scratch, I64{32}, I64{8})
            return compiler_fs_errno(HOST_IO_OP_READ, path, code, error)
        }
        if (count < capacity) {
            rt_text_store(output, rt_text_lossy(bytes, count))
            jet_rt_free(bytes, capacity, I64{8})
            jet_rt_free(scratch, I64{32}, I64{8})
            return I64{1}
        }
        jet_rt_free(bytes, capacity, I64{8})
        capacity *= I64{2}
    }
}
// JetFileReader's sole descriptor owner is the shared FD72 carrier. No Rust
// BufReader or second descriptor registry survives the nonblocking open.
#Export(c) jet_std_files_open_reader_nonblocking: fn(path: I64, output: I64, error: I64) -> I64 {
    if compiler_fs_fault(path, error) -> return I64{0}
    if !compiler_fs_path(path, HOST_IO_OP_READ, error) -> return I64{0}
    name: fd_c_path(path)
    fd: host_call(I64{2}, name, I64{526336}, I64{0})
    fd_c_path_drop(name, path)
    if (fd < I64{0}) -> return compiler_fs_errno(HOST_IO_OP_READ, path, -fd, error)
    rt_text_store(output, fd_new(fd, path, false))
    I64{1}
}
#Export(c) jet_rt_handle_drop_jet_file_reader: fn(reader: I64) { jet_fd_drop_raw(reader) }
#Export(c) jet_std_file_reader_path: fn(reader: I64) -> I64 { jet_fd_path_raw(reader) }
#Export(c) jet_rt_record_get_jet_file_reader_path: fn(reader: I64) -> I64 { jet_fd_path_raw(reader) }
#Export(c) jet_std_file_reader_read: fn(reader: I64, maximum: I64, output: I64, len: I64, error: I64) -> I64 {
    path: fd_word(reader, I64{24})
    if compiler_fs_fault(path, error) -> return I64{0}
    limit := I64{16777216}
    if (jet_int_compare(maximum, limit) < I64{0}) {
        if (jet_int_compare(maximum, I64{0}) <= I64{0}) {
            count: if int_fits(maximum, U64{9223372036854775808}) -> jet_int_owned_to_i64(maximum) else -> I64{-9223372036854775808}
            cause: jet_rt_string_builder_new()
            jet_rt_string_builder_push(cause, rt_static_text("read needs a positive byte count, got "))
            rt_text_push_number(cause, count)
            return compiler_fs_error(HOST_IO_KIND_INVALID_INPUT, HOST_IO_OP_READ, path, I64{0}, jet_rt_string_builder_finish(cause), error)
        }
        limit = jet_int_owned_to_i64(maximum)
    }
    scratch: jet_rt_alloc(I64{32}, I64{8})
    bytes: jet_rt_alloc(limit, I64{8})
    count := I64{0}
    loop {
        count = jet_fd_read_raw(reader, bytes, limit, scratch)
        if (count >= I64{0} || rt_text_word(wrapping(scratch + I64{8})) != I64{4}) -> break
    }
    if (count < I64{0}) {
        code: rt_text_word(wrapping(scratch + I64{8}))
        jet_rt_free(bytes, limit, I64{8})
        jet_rt_free(scratch, I64{32}, I64{8})
        return compiler_fs_errno(HOST_IO_OP_READ, path, code, error)
    }
    jet_rt_free(scratch, I64{32}, I64{8})
    compiler_fs_bytes_take(bytes, limit, count, output, len)
    I64{1}
}
// FileReader.read_into(buffer, limit) (#5976): one read of at most `limit`
// bytes appended to the caller's [U8] at `header` [len@0][capacity@8]
// [data@16]; the count is the output, 0 at end of file. A List without room
// grows (rt_host_u8_list_room), so a caller that clears and reuses its List
// reads without allocating: the bytes go straight into it, and the read's
// 32 error words sit in its spare capacity past the read.
#Export(c) jet_std_file_reader_read_into: fn(reader: I64, header: I64, maximum: I64, output: I64, error: I64) -> I64 {
    path: fd_word(reader, I64{24})
    if compiler_fs_fault(path, error) -> return I64{0}
    if (jet_int_compare(maximum, I64{0}) <= I64{0}) {
        count: if int_fits(maximum, U64{9223372036854775808}) -> jet_int_owned_to_i64(maximum) else -> I64{-9223372036854775808}
        cause: jet_rt_string_builder_new()
        jet_rt_string_builder_push(cause, rt_static_text("read_into needs a positive byte count, got "))
        rt_text_push_number(cause, count)
        return compiler_fs_error(HOST_IO_KIND_INVALID_INPUT, HOST_IO_OP_READ, path, I64{0}, jet_rt_string_builder_finish(cause), error)
    }
    limit := I64{16777216}
    if (jet_int_compare(maximum, limit) < I64{0}) -> limit = jet_int_owned_to_i64(maximum)
    rt_host_u8_list_room(header, limit + I64{40})
    length: rt_text_word(header)
    into: wrapping(rt_text_word(wrapping(header + I64{16})) + length * RT_HOST_U8_STRIDE)
    scratch: wrapping(into + limit * RT_HOST_U8_STRIDE + I64{7}).bit_and(I64{-8})
    count := I64{0}
    loop {
        count = jet_fd_read_raw(reader, into, limit, scratch)
        if (count >= I64{0} || rt_text_word(wrapping(scratch + I64{8})) != I64{4}) -> break
    }
    if (count < I64{0}) -> return compiler_fs_errno(HOST_IO_OP_READ, path, rt_text_word(wrapping(scratch + I64{8})), error)
    rt_text_store(header, length + count)
    rt_text_store(output, jet_int_owned_from_i64(count))
    I64{1}
}
// FileReader.seek(position): std Seek::seek(SeekFrom::Start(position)) on
// the reader's descriptor. jet_fd_seek_raw drops buffered read-ahead, so the
// next read, read_line or lines starts at `position`.
#Export(c) jet_std_file_reader_seek: fn(reader: I64, position: I64, error: I64) -> I64 {
    path: fd_word(reader, I64{24})
    if compiler_fs_fault(path, error) -> return I64{0}
    if (jet_int_compare(position, I64{0}) < I64{0}) {
        offset: if int_fits(position, U64{9223372036854775808}) -> jet_int_owned_to_i64(position) else -> I64{-9223372036854775808}
        cause: jet_rt_string_builder_new()
        jet_rt_string_builder_push(cause, rt_static_text("seek needs a non-negative byte position, got "))
        rt_text_push_number(cause, offset)
        return compiler_fs_error(HOST_IO_KIND_INVALID_INPUT, HOST_IO_OP_READ, path, I64{0}, jet_rt_string_builder_finish(cause), error)
    }
    scratch: jet_rt_alloc(I64{40}, I64{8})
    result: jet_fd_seek_raw(reader, position, I64{0}, scratch, wrapping(scratch + I64{32}))
    if (jet_scheduler_native_propagate() != I64{0}) {
        jet_rt_free(scratch, I64{40}, I64{8})
        return I64{0}
    }
    if (rt_text_word(scratch) != I64{0} || result == I64{-1}) {
        code: rt_text_word(wrapping(scratch + I64{8}))
        jet_rt_free(scratch, I64{40}, I64{8})
        return compiler_fs_errno(HOST_IO_OP_READ, path, code, error)
    }
    jet_rt_int_drop(result)
    jet_rt_free(scratch, I64{40}, I64{8})
    I64{1}
}

compiler_fs_time_ns: fn(seconds: I64, nanos: I64) -> I64 {
    scaled: if (seconds > I64{9223372036}) -> I64{9223372036854775807} else if (seconds < I64{-9223372036}) -> I64{-9223372036854775808} else -> seconds * I64{1000000000}
    if (scaled > I64{9223372036854775807} - nanos) -> I64{9223372036854775807} else -> scaled + nanos
}
// jet_fs_stat_row from StatFacts128 and BirthTime24: kind, size, mode,
// readonly, device, inode, links, owner, size_on_disk, modified_ns, changed_ns,
// created present, created_ns. Shared by every stat.
compiler_fs_stat_row: fn(facts: I64, birth: I64, output: I64, len: I64) {
    mode: rt_text_word(wrapping(facts + I64{16}))
    bits: mode.bit_and(I64{61440})
    kind: if {
        (bits == I64{32768}) -> I64{0}
        (bits == I64{16384}) -> I64{1}
        (bits == I64{40960}) -> I64{2}
        (bits == I64{4096}) -> I64{3}
        (bits == I64{49152}) -> I64{4}
        (bits == I64{8192}) -> I64{5}
        (bits == I64{24576}) -> I64{6}
        else -> I64{7}
    }
    row: jet_rt_alloc(I64{104}, I64{8})
    rt_text_store(row, kind)
    rt_text_store(wrapping(row + I64{8}), rt_text_word(wrapping(facts + I64{56})))
    rt_text_store(wrapping(row + I64{16}), mode.bit_and(I64{4095}))
    rt_text_store(wrapping(row + I64{24}), if ((mode.bit_and(I64{146})) == I64{0}) -> I64{1} else -> I64{0})
    rt_text_store(wrapping(row + I64{32}), rt_text_word(facts))
    rt_text_store(wrapping(row + I64{40}), rt_text_word(wrapping(facts + I64{8})))
    rt_text_store(wrapping(row + I64{48}), rt_text_word(wrapping(facts + I64{24})))
    rt_text_store(wrapping(row + I64{56}), rt_text_word(wrapping(facts + I64{32})))
    blocks: rt_text_word(wrapping(facts + I64{112}))
    rt_text_store(wrapping(row + I64{64}), if (blocks > I64{18014398509481983}) -> I64{9223372036854775807} else if (blocks < I64{-18014398509481984}) -> I64{-9223372036854775808} else -> blocks * I64{512})
    rt_text_store(wrapping(row + I64{72}), compiler_fs_time_ns(rt_text_word(wrapping(facts + I64{80})), rt_text_word(wrapping(facts + I64{88}))))
    rt_text_store(wrapping(row + I64{80}), compiler_fs_time_ns(rt_text_word(wrapping(facts + I64{96})), rt_text_word(wrapping(facts + I64{104}))))
    present: rt_text_word(birth) != I64{0}
    rt_text_store(wrapping(row + I64{88}), if present -> I64{1} else -> I64{0})
    rt_text_store(wrapping(row + I64{96}), if present -> compiler_fs_time_ns(rt_text_word(wrapping(birth + I64{8})), rt_text_word(wrapping(birth + I64{16}))) else -> I64{0})
    rt_text_store(output, row)
    rt_text_store(len, I64{13})
}
// Blocks times the block unit, saturated: statfs counts are unsigned.
compiler_fs_space_bytes: fn(blocks: I64, unit: I64) -> I64 {
    if (unit <= I64{0} || blocks == I64{0}) -> return I64{0}
    if (blocks < I64{0} || blocks > I64{9223372036854775807} / unit) -> return I64{9223372036854775807}
    blocks * unit
}
// jet_fs_space: statfs(2) for the file system holding `path`, as the row
// total, free, available in bytes. Each count is scaled by f_frsize, or by
// f_bsize when the kernel reports no fragment size, as statvfs(3) does.
// The 120-byte statfs reply holds f_bsize@8, f_blocks@16, f_bfree@24,
// f_bavail@32 and f_frsize@72.
#Export(c) jet_fs_space: fn(path: I64, output: I64, len: I64, error: I64) -> I64 {
    if !compiler_fs_path(path, HOST_IO_OP_READ, error) -> return I64{0}
    name: fd_c_path(path)
    facts: jet_rt_alloc(I64{120}, I64{8})
    result: host_call(I64{137}, name, facts, I64{0})
    fd_c_path_drop(name, path)
    if (result < I64{0}) {
        jet_rt_free(facts, I64{120}, I64{8})
        if (result == I64{-38}) -> return compiler_fs_error(HOST_IO_KIND_UNSUPPORTED, HOST_IO_OP_READ, path, I64{38}, jet_rt_string_clone(rt_static_text("this system has no statfs")), error)
        return compiler_fs_errno(HOST_IO_OP_READ, path, -result, error)
    }
    fragment: rt_text_word(wrapping(facts + I64{72}))
    unit: if (fragment > I64{0}) -> fragment else -> rt_text_word(wrapping(facts + I64{8}))
    row: jet_rt_alloc(I64{24}, I64{8})
    rt_text_store(row, compiler_fs_space_bytes(rt_text_word(wrapping(facts + I64{16})), unit))
    rt_text_store(wrapping(row + I64{8}), compiler_fs_space_bytes(rt_text_word(wrapping(facts + I64{24})), unit))
    rt_text_store(wrapping(row + I64{16}), compiler_fs_space_bytes(rt_text_word(wrapping(facts + I64{32})), unit))
    jet_rt_free(facts, I64{120}, I64{8})
    rt_text_store(output, row)
    rt_text_store(len, I64{3})
    I64{1}
}
#Export(c) jet_std_file_reader_stat: fn(reader: I64, output: I64, len: I64, error: I64) -> I64 {
    scratch: jet_rt_alloc(I64{184}, I64{8})
    facts: scratch
    birth: wrapping(scratch + I64{128})
    errno: wrapping(scratch + I64{152})
    jet_fd_stat_raw(reader, facts, errno)
    if (rt_text_word(errno) != I64{0}) {
        code: rt_text_word(wrapping(errno + I64{8}))
        jet_rt_free(scratch, I64{184}, I64{8})
        return compiler_fs_errno(HOST_IO_OP_READ, fd_word(reader, I64{24}), code, error)
    }
    jet_fd_created_raw(reader, birth, errno)
    compiler_fs_stat_row(facts, birth, output, len)
    jet_rt_free(scratch, I64{184}, I64{8})
    I64{1}
}
