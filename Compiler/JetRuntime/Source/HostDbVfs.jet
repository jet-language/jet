// core.db's VFS leaves: the host steps of SQLite 3.45.0's unix VFS
// (os_unix.c), one system call each, for the Jet SQLite engine's Os layer
// (Core/Db/Engine/Os.jet). Linux x86-64 numbering. Every Int leaf answers the
// call's result or the negated OS code; the Core side maps codes to SQLite
// result codes as os_unix.c does, so these leaves own no policy.
//
// Locks are fcntl(2) record locks whose command the caller picks: the engine
// takes open-file-description locks (F_OFD_SETLK 37, F_OFD_GETLK 36), which
// conflict with the POSIX locks C SQLite takes in other processes and, unlike
// those, are neither shared by nor dropped through other descriptors of this
// process, so the engine needs no unixInodeInfo registry.

DB_VFS_EINTR: I64{-4}
DB_VFS_EINVAL: I64{-22}
DB_VFS_O_CREAT: I64{64}
DB_VFS_O_EXCL: I64{128}
DB_VFS_O_CLOEXEC: I64{524288}
// SQLITE_DEFAULT_FILE_PERMISSIONS and SQLITE_MINIMUM_FILE_DESCRIPTOR.
DB_VFS_DEFAULT_MODE: I64{420}
DB_VFS_MINIMUM_FD: I64{3}

// The byte leaves move packed bytes: a host whose U8 lists are not packed
// (RT_HOST_U8_STRIDE) gets EINVAL.
db_vfs_packed: fn() -> Bool { RT_HOST_U8_STRIDE == I64{1} }

// A descriptor outside 0..=i32::MAX is EBADF before any call.
db_vfs_fd_valid: fn(fd: I64) -> Bool { fd >= I64{0} && fd <= I64{2147483647} }

// robust_open: open(2) with O_CLOEXEC added, retried after EINTR; `mode` 0
// creates with SQLITE_DEFAULT_FILE_PERMISSIONS (0644). A descriptor below 3
// is never handed out: it is closed (and an exclusive create unlinked), a
// /dev/null descriptor is left holding that slot, and the open is retried.
// With a nonzero `mode`, a new empty file whose permission bits differ (the
// umask cut them) is fchmod(2)ed to `mode`. A path holding NUL is EINVAL.
#Export(c) jet_db_vfs_open: fn(path: I64, flags: I64, mode: I64) -> I64 {
    native_flags: jet_int_owned_to_i64(flags)
    native_mode: jet_int_owned_to_i64(mode)
    if (jet_scheduler_native_propagate() != I64{0}) -> return I64{0}
    if walk_has_nul(rt_text_data(path), rt_text_len(path)) -> return jet_int_owned_from_i64(DB_VFS_EINVAL)
    name: fd_c_path(path)
    create_mode: if (native_mode == I64{0}) -> DB_VFS_DEFAULT_MODE else -> native_mode
    exclusive_create: DB_VFS_O_EXCL.bit_or(DB_VFS_O_CREAT)
    fd := DB_VFS_EINTR
    loop {
        fd = host_call(I64{2}, name, native_flags.bit_or(DB_VFS_O_CLOEXEC), create_mode)
        if (fd == DB_VFS_EINTR) -> next
        if (fd < I64{0} || fd >= DB_VFS_MINIMUM_FD) -> break
        if (native_flags.bit_and(exclusive_create) == exclusive_create) -> _ := host_call(I64{87}, name, I64{0}, I64{0})
        _ := host_call(I64{3}, fd, I64{0}, I64{0})
        fd = db_vfs_open_dev_null(native_mode)
        if (fd < I64{0}) -> break
    }
    fd_c_path_drop(name, path)
    if (fd >= I64{0} && native_mode != I64{0}) {
        facts: jet_rt_alloc(I64{144}, I64{8})
        thread_zero(facts, I64{144})
        if (host_call(I64{5}, fd, facts, I64{0}) == I64{0} && rt_text_word(wrapping(facts + I64{48})) == I64{0} && rt_text_word(wrapping(facts + I64{24})).bit_and(I64{511}) != native_mode) {
            _ := host_call(I64{91}, fd, native_mode, I64{0})
        }
        jet_rt_free(facts, I64{144}, I64{8})
    }
    jet_int_owned_from_i64(fd)
}

// robust_open's placeholder: open("/dev/null", O_RDONLY) into the low slot
// it leaves taken. Its descriptor, or the negated code.
db_vfs_open_dev_null: fn(mode: I64) -> I64 {
    name: jet_rt_alloc(I64{16}, I64{8})
    thread_zero(name, I64{16})
    // "/dev/nul" then "l\0", little-endian words.
    rt_text_store(name, I64{7815273878500238383})
    rt_text_store(wrapping(name + I64{8}), I64{108})
    fd: host_call(I64{2}, name, I64{0}, mode)
    jet_rt_free(name, I64{16}, I64{8})
    fd
}

// robust_close: close(2) once (Linux releases the descriptor even on EINTR).
#Export(c) jet_db_vfs_close: fn(fd: I64) -> I64 {
    native_fd: jet_int_owned_to_i64(fd)
    if (jet_scheduler_native_propagate() != I64{0}) -> return I64{0}
    if !db_vfs_fd_valid(native_fd) -> return jet_int_owned_from_i64(I64{-9})
    jet_int_owned_from_i64(host_call(I64{3}, native_fd, I64{0}, I64{0}))
}

// seekAndRead: pread64(2) of `count` bytes at `offset` into the borrowed
// List<U8> at `header` from element `at`, continuing after a short read and
// retrying EINTR until end of file. The bytes read, or the negated code.
#Export(c) jet_db_vfs_read: fn(fd: I64, offset: I64, header: I64, at: I64, count: I64) -> I64 {
    native_fd: jet_int_owned_to_i64(fd)
    position := jet_int_owned_to_i64(offset)
    start: jet_int_owned_to_i64(at)
    wanted: jet_int_owned_to_i64(count)
    if (jet_scheduler_native_propagate() != I64{0}) -> return I64{0}
    if !db_vfs_fd_valid(native_fd) -> return jet_int_owned_from_i64(I64{-9})
    length: rt_text_word(wrapping(header + DATA_SEQUENCE_LENGTH))
    if (!db_vfs_packed() || position < I64{0} || start < I64{0} || wanted < I64{0} || start > length || wanted > length - start) -> return jet_int_owned_from_i64(DB_VFS_EINVAL)
    buffer: wrapping(rt_text_word(wrapping(header + DATA_SEQUENCE_DATA)) + start * RT_HOST_U8_STRIDE)
    total := I64{0}
    loop total < wanted {
        got: host_call4(I64{17}, native_fd, wrapping(buffer + total), wanted - total, position)
        if (got == DB_VFS_EINTR) -> next
        if (got < I64{0}) -> return jet_int_owned_from_i64(got)
        if (got == I64{0}) -> break
        total += got
        position += got
    }
    jet_int_owned_from_i64(total)
}

// seekAndWriteFd: pwrite64(2) of bytes[at..][..count] at `offset`,
// retrying EINTR and continuing after a short write (unixWrite). The bytes
// written, or the negated code.
#Export(c) jet_db_vfs_write: fn(fd: I64, offset: I64, data: I64, length: I64, at: I64, count: I64) -> I64 {
    native_fd: jet_int_owned_to_i64(fd)
    position := jet_int_owned_to_i64(offset)
    start: jet_int_owned_to_i64(at)
    wanted: jet_int_owned_to_i64(count)
    if (jet_scheduler_native_propagate() != I64{0}) -> return I64{0}
    if !db_vfs_fd_valid(native_fd) -> return jet_int_owned_from_i64(I64{-9})
    size: if (length < I64{0} || data == I64{0}) -> I64{0} else -> length
    if (!db_vfs_packed() || position < I64{0} || start < I64{0} || wanted < I64{0} || start > size || wanted > size - start) -> return jet_int_owned_from_i64(DB_VFS_EINVAL)
    source: wrapping(data + start * RT_HOST_U8_STRIDE)
    total := I64{0}
    loop total < wanted {
        put: host_call4(I64{18}, native_fd, wrapping(source + total), wanted - total, position)
        if (put == DB_VFS_EINTR) -> next
        if (put < I64{0}) -> return jet_int_owned_from_i64(put)
        if (put == I64{0}) -> break
        total += put
        position += put
    }
    jet_int_owned_from_i64(total)
}

// full_fsync: fsync(2) once (the vendored build has no HAVE_FDATASYNC, so
// fdatasync is fsync).
#Export(c) jet_db_vfs_sync: fn(fd: I64) -> I64 {
    native_fd: jet_int_owned_to_i64(fd)
    if (jet_scheduler_native_propagate() != I64{0}) -> return I64{0}
    if !db_vfs_fd_valid(native_fd) -> return jet_int_owned_from_i64(I64{-9})
    jet_int_owned_from_i64(host_call(I64{74}, native_fd, I64{0}, I64{0}))
}

// robust_ftruncate: ftruncate(2), retried after EINTR.
#Export(c) jet_db_vfs_truncate: fn(fd: I64, size: I64) -> I64 {
    native_fd: jet_int_owned_to_i64(fd)
    native_size: jet_int_owned_to_i64(size)
    if (jet_scheduler_native_propagate() != I64{0}) -> return I64{0}
    if !db_vfs_fd_valid(native_fd) -> return jet_int_owned_from_i64(I64{-9})
    if (native_size < I64{0}) -> return jet_int_owned_from_i64(DB_VFS_EINVAL)
    status := DB_VFS_EINTR
    loop status == DB_VFS_EINTR -> status = host_call(I64{77}, native_fd, native_size, I64{0})
    jet_int_owned_from_i64(status)
}

// unixFileSize: fstat(2)'s st_size.
#Export(c) jet_db_vfs_size: fn(fd: I64) -> I64 {
    native_fd: jet_int_owned_to_i64(fd)
    if (jet_scheduler_native_propagate() != I64{0}) -> return I64{0}
    if !db_vfs_fd_valid(native_fd) -> return jet_int_owned_from_i64(I64{-9})
    facts: jet_rt_alloc(I64{144}, I64{8})
    thread_zero(facts, I64{144})
    status: host_call(I64{5}, native_fd, facts, I64{0})
    size: if (status < I64{0}) -> status else -> rt_text_word(wrapping(facts + I64{48}))
    jet_rt_free(facts, I64{144}, I64{8})
    jet_int_owned_from_i64(size)
}

// One word of the struct stat that stat(2) (`call` 4) or lstat(2) (6) fills
// for the path: the word at `offset` masked by `mask`, or the negated code.
// (struct stat: st_ino 8, st_mode 24 (u32), st_uid 28, st_gid 32, st_size 48.)
db_vfs_path_fact: fn(path: I64, call: I64, offset: I64, mask: I64) -> I64 {
    if walk_has_nul(rt_text_data(path), rt_text_len(path)) -> return DB_VFS_EINVAL
    name: fd_c_path(path)
    facts: jet_rt_alloc(I64{144}, I64{8})
    thread_zero(facts, I64{144})
    status: host_call(call, name, facts, I64{0})
    fd_c_path_drop(name, path)
    fact: if (status < I64{0}) -> status else -> rt_text_word(wrapping(facts + offset)).bit_and(mask)
    jet_rt_free(facts, I64{144}, I64{8})
    fact
}

// getFileMode: stat(2)'s permission bits (st_mode & 0777) of the path, or
// the negated code.
#Export(c) jet_db_vfs_mode: fn(path: I64) -> I64 {
    jet_int_owned_from_i64(db_vfs_path_fact(path, I64{4}, I64{24}, I64{511}))
}

// appendOnePathElement: lstat(2)'s whole st_mode of the path (S_IFLNK
// 0120000 under S_IFMT 0170000 marks a link), or the negated code.
#Export(c) jet_db_vfs_lstat_mode: fn(path: I64) -> I64 {
    jet_int_owned_from_i64(db_vfs_path_fact(path, I64{6}, I64{24}, I64{4294967295}))
}

// fileHasMoved: stat(2)'s st_ino of the path, or the negated code.
#Export(c) jet_db_vfs_inode: fn(path: I64) -> I64 {
    jet_int_owned_from_i64(db_vfs_path_fact(path, I64{4}, I64{8}, I64{-1}))
}

// robustFchown: when the process runs as root (geteuid(2) is 0), fchown(2)
// the open file to the owner and group stat(2) reports for `path` (a journal
// or WAL file takes its database's owner). 0 when not root, else fchown's
// result or the negated code.
#Export(c) jet_db_vfs_chown_like: fn(fd: I64, path: I64) -> I64 {
    native_fd: jet_int_owned_to_i64(fd)
    if (jet_scheduler_native_propagate() != I64{0}) -> return I64{0}
    if !db_vfs_fd_valid(native_fd) -> return jet_int_owned_from_i64(I64{-9})
    if (host_call(I64{107}, I64{0}, I64{0}, I64{0}) != I64{0}) -> return jet_int_owned_from_i64(I64{0})
    owner: db_vfs_path_fact(path, I64{4}, I64{28}, I64{-1})
    if (owner < I64{0}) -> return jet_int_owned_from_i64(owner)
    uid: owner.bit_and(I64{4294967295})
    gid: (owner /% I64{4294967296}).bit_and(I64{4294967295})
    jet_int_owned_from_i64(host_call(I64{93}, native_fd, uid, gid))
}

// findInodeInfo: fstat(2)'s st_ino of the open file, or the negated code.
#Export(c) jet_db_vfs_fd_inode: fn(fd: I64) -> I64 {
    native_fd: jet_int_owned_to_i64(fd)
    if (jet_scheduler_native_propagate() != I64{0}) -> return I64{0}
    if !db_vfs_fd_valid(native_fd) -> return jet_int_owned_from_i64(I64{-9})
    facts: jet_rt_alloc(I64{144}, I64{8})
    thread_zero(facts, I64{144})
    status: host_call(I64{5}, native_fd, facts, I64{0})
    inode: if (status < I64{0}) -> status else -> rt_text_word(wrapping(facts + I64{8}))
    jet_rt_free(facts, I64{144}, I64{8})
    jet_int_owned_from_i64(inode)
}

// One fcntl(2) record-lock call over bytes [start, start+len) from the
// file's start (struct flock: l_type0 l_whence2 l_start8 l_len16 l_pid24).
// A set command answers 0; a get command answers the conflicting lock's
// l_type (F_UNLCK 2 when none). Either answers the negated code on failure.
#Export(c) jet_db_vfs_lock: fn(fd: I64, command: I64, kind: I64, start: I64, len: I64) -> I64 {
    native_fd: jet_int_owned_to_i64(fd)
    native_command: jet_int_owned_to_i64(command)
    native_kind: jet_int_owned_to_i64(kind)
    native_start: jet_int_owned_to_i64(start)
    native_len: jet_int_owned_to_i64(len)
    if (jet_scheduler_native_propagate() != I64{0}) -> return I64{0}
    if !db_vfs_fd_valid(native_fd) -> return jet_int_owned_from_i64(I64{-9})
    if (native_kind < I64{0} || native_kind > I64{2}) -> return jet_int_owned_from_i64(DB_VFS_EINVAL)
    lock: jet_rt_alloc(I64{32}, I64{8})
    thread_zero(lock, I64{32})
    rt_text_store(lock, native_kind)
    rt_text_store(wrapping(lock + I64{8}), native_start)
    rt_text_store(wrapping(lock + I64{16}), native_len)
    status: host_call(I64{72}, native_fd, native_command, lock)
    found: rt_text_word(lock).bit_and(I64{65535})
    jet_rt_free(lock, I64{32}, I64{8})
    if (status < I64{0}) -> return jet_int_owned_from_i64(status)
    if (native_command == I64{36} || native_command == I64{5}) -> return jet_int_owned_from_i64(found)
    jet_int_owned_from_i64(I64{0})
}

// unixDelete's unlink(2).
#Export(c) jet_db_vfs_unlink: fn(path: I64) -> I64 {
    if walk_has_nul(rt_text_data(path), rt_text_len(path)) -> return jet_int_owned_from_i64(DB_VFS_EINVAL)
    name: fd_c_path(path)
    status: host_call(I64{87}, name, I64{0}, I64{0})
    fd_c_path_drop(name, path)
    jet_int_owned_from_i64(status)
}

// unixAccess(SQLITE_ACCESS_READWRITE): access(2) with `mode`.
#Export(c) jet_db_vfs_access: fn(path: I64, mode: I64) -> I64 {
    native_mode: jet_int_owned_to_i64(mode)
    if (jet_scheduler_native_propagate() != I64{0}) -> return I64{0}
    if walk_has_nul(rt_text_data(path), rt_text_len(path)) -> return jet_int_owned_from_i64(DB_VFS_EINVAL)
    name: fd_c_path(path)
    status: host_call(I64{21}, name, native_mode, I64{0})
    fd_c_path_drop(name, path)
    jet_int_owned_from_i64(status)
}

// unixAccess(SQLITE_ACCESS_EXISTS): stat(2) succeeds and the path is not
// an empty regular file. With `directory`, true only for a directory
// (unixTempFileDir's S_ISDIR test).
#Export(c) jet_db_vfs_exists: fn(path: I64, directory: Bool) -> Bool {
    if walk_has_nul(rt_text_data(path), rt_text_len(path)) -> return false
    name: fd_c_path(path)
    facts: jet_rt_alloc(I64{144}, I64{8})
    thread_zero(facts, I64{144})
    status: host_call(I64{4}, name, facts, I64{0})
    fd_c_path_drop(name, path)
    kind: rt_text_word(wrapping(facts + I64{24})).bit_and(I64{61440})
    size: rt_text_word(wrapping(facts + I64{48}))
    jet_rt_free(facts, I64{144}, I64{8})
    if (status < I64{0}) -> return false
    if directory -> return (kind == I64{16384})
    (kind != I64{32768} || size > I64{0})
}

// unixFullPathname's symlink step: readlink(2)'s target, or empty text
// when the path is not a symbolic link or cannot be read.
#Export(c) jet_db_vfs_readlink: fn(path: I64) -> I64 {
    buffer: jet_rt_alloc(I64{4097}, I64{1})
    got := DB_VFS_EINVAL
    if !walk_has_nul(rt_text_data(path), rt_text_len(path)) {
        name: fd_c_path(path)
        got = host_call(I64{89}, name, buffer, I64{4097})
        fd_c_path_drop(name, path)
    }
    length: if (got < I64{0} || got > I64{4096}) -> I64{0} else -> got
    text: rt_text_lossy(buffer, length)
    jet_rt_free(buffer, I64{4097}, I64{1})
    text
}

// unixFullPathname's getcwd(3) (the getcwd(2) system call), or empty text
// when it fails.
#Export(c) jet_db_vfs_cwd: fn() -> I64 {
    buffer: jet_rt_alloc(I64{4097}, I64{1})
    got: host_call(I64{79}, buffer, I64{4097}, I64{0})
    length: if (got <= I64{0}) -> I64{0} else -> got - I64{1}
    text: rt_text_lossy(buffer, length)
    jet_rt_free(buffer, I64{4097}, I64{1})
    text
}

// unixSleep: nanosleep(2) for `micros` microseconds (HAVE_USLEEP); the
// microseconds asked for.
#Export(c) jet_db_vfs_sleep: fn(micros: I64) -> I64 {
    wanted: jet_int_owned_to_i64(micros)
    if (jet_scheduler_native_propagate() != I64{0}) -> return I64{0}
    span: if (wanted < I64{0}) -> I64{0} else -> wanted
    request: jet_rt_alloc(I64{16}, I64{8})
    rt_text_store(request, span /% I64{1000000})
    rt_text_store(wrapping(request + I64{8}), (span %% I64{1000000}) * I64{1000})
    _ := host_call(I64{35}, request, I64{0}, I64{0})
    jet_rt_free(request, I64{16}, I64{8})
    jet_int_owned_from_i64(span)
}

// unixRandomness: fill the borrowed List<U8> at `header` from getrandom(2),
// retrying EINTR. The bytes filled, or the negated code.
#Export(c) jet_db_vfs_random: fn(header: I64) -> I64 {
    if !db_vfs_packed() -> return jet_int_owned_from_i64(DB_VFS_EINVAL)
    length: rt_text_word(wrapping(header + DATA_SEQUENCE_LENGTH))
    buffer: rt_text_word(wrapping(header + DATA_SEQUENCE_DATA))
    total := I64{0}
    loop total < length {
        got: host_call(I64{318}, wrapping(buffer + total), length - total, I64{0})
        if (got == DB_VFS_EINTR) -> next
        if (got < I64{0}) -> return jet_int_owned_from_i64(got)
        total += got
    }
    jet_int_owned_from_i64(total)
}

// unixCurrentTimeInt64's clock: CLOCK_REALTIME in milliseconds since the
// Unix epoch.
#Export(c) jet_db_vfs_now_ms: fn() -> I64 {
    clock: jet_rt_alloc(I64{16}, I64{8})
    thread_zero(clock, I64{16})
    _ := host_call(I64{228}, I64{0}, clock, I64{0})
    ms: rt_text_word(clock) * I64{1000} + rt_text_word(wrapping(clock + I64{8})) /% I64{1000000}
    jet_rt_free(clock, I64{16}, I64{8})
    jet_int_owned_from_i64(ms)
}
