// sinh, cosh, tanh, asinh, acosh and atanh, ported from musl 1.2.5
// src/math (sinh.c, cosh.c, tanh.c, __expo2.c, asinh.c, acosh.c, atanh.c;
// FreeBSD msun). See Libm.jet for the porting conventions; FORCE_EVAL
// statements only raise floating-point flags and are dropped.

// ln 2 as asinh.c and acosh.c write it.
LIBM_LN2: Float{0.6931471805599453}

// __expo2.c: exp(x)/2 for x >= log(DBL_MAX), slightly better than
// 0.5*exp(x/2)*exp(x/2). k = 2043 is odd and scale = 2^(k/2) squared
// overflows; kln2 is k*ln2 with minimal relative error.
libm_expo2: fn(x: Float, sign: Float) -> Float {
    scale: rt_f64_from_bits((I64{0x3ff} + I64{1021}) << I64{52})
    libm_exp(x - Float{1416.0996898839683}) * (sign * scale) * scale
}

// sinh.c
libm_sinh: fn(x: Float) -> Float {
    bits: rt_f64_bits(x)
    h: if (bits < I64{0}) -> Float{-0.5} else -> Float{0.5}
    // |x|
    magnitude: bits.bit_and(LIBM_ABS)
    absx: rt_f64_from_bits(magnitude)
    w: magnitude >> I64{32}
    // |x| < log(DBL_MAX)
    if (w < I64{0x40862e42}) {
        t: libm_expm1(absx)
        if (w < I64{0x3ff00000}) {
            // this branch avoids spurious underflow
            if (w < I64{0x3ff00000} - (I64{26} << I64{20})) -> return x
            return h * (Float{2.0} * t - t * t / (t + Float{1.0}))
        }
        return h * (t + t / (t + Float{1.0}))
    }
    // |x| > log(DBL_MAX) or nan
    libm_expo2(absx, Float{2.0} * h)
}

// cosh.c
libm_cosh: fn(x: Float) -> Float {
    // |x|
    magnitude: rt_f64_bits(x).bit_and(LIBM_ABS)
    absx: rt_f64_from_bits(magnitude)
    w: magnitude >> I64{32}
    // |x| < log(2)
    if (w < I64{0x3fe62e42}) {
        if (w < I64{0x3ff00000} - (I64{26} << I64{20})) -> return Float{1.0}
        t: libm_expm1(absx)
        return Float{1.0} + t * t / (Float{2.0} * (Float{1.0} + t))
    }
    // |x| < log(DBL_MAX)
    if (w < I64{0x40862e42}) {
        t: libm_exp(absx)
        return Float{0.5} * (t + Float{1.0} / t)
    }
    // |x| > log(DBL_MAX) or nan
    libm_expo2(absx, Float{1.0})
}

// tanh.c
libm_tanh: fn(x: Float) -> Float {
    bits: rt_f64_bits(x)
    // x = |x|
    magnitude: bits.bit_and(LIBM_ABS)
    absx: rt_f64_from_bits(magnitude)
    w: magnitude >> I64{32}
    t: if {
        // |x| > 20 or nan; this branch avoids raising overflow
        w > (I64{0x40340000}) -> Float{1.0} - Float{0.0} / absx
        // |x| > log(3)/2 ~= 0.5493
        w > (I64{0x3fe193ea}) -> Float{1.0} - Float{2.0} / (libm_expm1(Float{2.0} * absx) + Float{2.0})
        // |x| > log(5/3)/2 ~= 0.2554
        w > (I64{0x3fd058ae}) -> libm_tanh_ratio(libm_expm1(Float{2.0} * absx))
        // |x| >= 0x1p-1022, up to 2ulp error in [0.1,0.2554]
        w >= (I64{0x00100000}) -> libm_tanh_negated_ratio(libm_expm1(Float{-2.0} * absx))
        // |x| is subnormal
        else -> absx
    }
    return if (bits < I64{0}) -> -t else -> t
}

// tanh.c t/(t+2)
libm_tanh_ratio: fn(t: Float) -> Float { t / (t + Float{2.0}) }

// tanh.c -t/(t+2)
libm_tanh_negated_ratio: fn(t: Float) -> Float { -t / (t + Float{2.0}) }

// asinh.c: sign(x)*log(|x|+sqrt(x*x+1)) ~= x - x^3/6 + o(x^5)
libm_asinh: fn(x: Float) -> Float {
    bits: rt_f64_bits(x)
    e: libm_exponent(bits)
    // |x|
    a: rt_f64_from_bits(bits.bit_and(LIBM_ABS))
    y: if {
        // |x| >= 0x1p26 or inf or nan
        e >= (I64{0x3ff} + I64{26}) -> libm_log(a) + LIBM_LN2
        // |x| >= 2
        e >= (I64{0x3ff} + I64{1}) -> libm_log(Float{2.0} * a + Float{1.0} / (libm_sqrt(a * a + Float{1.0}) + a))
        // |x| >= 0x1p-26, up to 1.6ulp error in [0.125,0.5]
        e >= (I64{0x3ff} - I64{26}) -> libm_log1p(a + a * a / (libm_sqrt(a * a + Float{1.0}) + Float{1.0}))
        // |x| < 0x1p-26
        else -> a
    }
    return if (bits < I64{0}) -> -y else -> y
}

// acosh.c: log(x + sqrt(x*x-1)); x < 1 is a domain error the called
// functions handle. A negative x of magnitude 2 or more skips the |x| < 2^26
// branch: musl takes it, and there x + sqrt(x*x-1) cancels to a tiny negative
// value that turns the log's argument positive, so acosh(-0x1.34e729fd08086p+21)
// is 8.23 instead of NaN. Its log(x) below is NaN.
libm_acosh: fn(x: Float) -> Float {
    e: libm_exponent(rt_f64_bits(x))
    // |x| < 2, up to 2ulp error in [1,1.125]
    if (e < I64{0x3ff} + I64{1}) -> return libm_log1p(x - Float{1.0} + libm_sqrt((x - Float{1.0}) * (x - Float{1.0}) + Float{2.0} * (x - Float{1.0})))
    // 2 <= x < 0x1p26
    if (e < I64{0x3ff} + I64{26} && x > Float{0.0}) -> return libm_log(Float{2.0} * x - Float{1.0} / (x + libm_sqrt(x * x - Float{1.0})))
    // |x| >= 0x1p26 or nan
    libm_log(x) + LIBM_LN2
}

// atanh.c: log((1+x)/(1-x))/2 = log1p(2x/(1-x))/2 ~= x + x^3/3 + o(x^5)
libm_atanh: fn(x: Float) -> Float {
    bits: rt_f64_bits(x)
    e: libm_exponent(bits)
    // |x|
    a: rt_f64_from_bits(bits.bit_and(LIBM_ABS))
    y: if {
        // underflow
        e < (I64{0x3ff} - I64{32}) -> a
        // |x| < 0.5, up to 1.7ulp error
        e < (I64{0x3ff} - I64{1}) -> Float{0.5} * libm_log1p(Float{2.0} * a + Float{2.0} * a * a / (Float{1.0} - a))
        // avoid overflow
        else -> Float{0.5} * libm_log1p(Float{2.0} * (a / (Float{1.0} - a)))
    }
    return if (bits < I64{0}) -> -y else -> y
}
