// Error16 {tag,payload}. Display, JetShow and JetDebug share these exact
// user-facing templates (not Rust enum Debug). Text payloads own E4 handles.
HTTP_ERROR_BYTES :: I64{16}
HTTP_ERROR_TAG :: I64{0}
HTTP_ERROR_PAYLOAD :: I64{8}
#Export(c) fn jet_rt_handle_clone_jet_http_operation(value: I64) -> I64 { encoding_enum_clone(value) }
#Export(c) fn jet_rt_handle_drop_jet_http_operation(value: I64) { encoding_enum_drop(value) }
#Export(c) fn jet_rt_handle_eq_jet_http_operation(left: I64, right: I64) -> Bool { encoding_enum_eq(left, right) }
fn http_error_tag(value: I64) -> I64 {
    ordinal :: encoding_word(wrapping(value + HTTP_ERROR_TAG))
    if (ordinal < I64{0} || ordinal > I64{20}) -> rt_record_variant_panic()
    ordinal
}
#Export(c) fn jet_rt_handle_clone_jet_http_error(value: I64) -> I64 {
    ordinal :: http_error_tag(value)
    payload :: encoding_word(wrapping(value + HTTP_ERROR_PAYLOAD))
    result :: jet_rt_alloc(HTTP_ERROR_BYTES, I64{8})
    encoding_store(wrapping(result + HTTP_ERROR_TAG), ordinal)
    encoding_store(wrapping(result + HTTP_ERROR_PAYLOAD), if (ordinal >= I64{9} && ordinal <= I64{19}) -> jet_rt_string_clone(payload) else -> payload)
    result
}
#Export(c) fn jet_rt_handle_drop_jet_http_error(value: I64) {
    if (value == I64{0}) -> return
    ordinal :: http_error_tag(value)
    if (ordinal >= I64{9} && ordinal <= I64{19}) -> jet_rt_string_drop(encoding_word(wrapping(value + HTTP_ERROR_PAYLOAD)))
    jet_rt_free(value, HTTP_ERROR_BYTES, I64{8})
}
#Export(c) fn jet_rt_handle_eq_jet_http_error(left: I64, right: I64) -> Bool {
    ordinal :: http_error_tag(left)
    if (ordinal != http_error_tag(right)) -> return false
    if (ordinal < I64{8}) -> return true
    a :: encoding_word(wrapping(left + HTTP_ERROR_PAYLOAD))
    b :: encoding_word(wrapping(right + HTTP_ERROR_PAYLOAD))
    if (ordinal >= I64{9} && ordinal <= I64{19}) -> jet_rt_string_eq(a, b) else -> a == b
}
fn http_error_prefix(target: I64, ordinal: I64) {
    if {
        (ordinal == I64{0}) -> {
            jet_rt_string_builder_push(target, rt_static_text("invalid HTTP method"))
        }
        (ordinal == I64{1}) -> {
            rt_text_push_word(target, I64{2334106421097295465}, I64{8})
            rt_text_push_word(target, I64{5499551692247815240}, I64{8})
        }
        (ordinal == I64{2}) -> {
            jet_rt_string_builder_push(target, rt_static_text("invalid HTTP header"))
        }
        (ordinal == I64{3}) -> {
            jet_rt_string_builder_push(target, rt_static_text("invalid HTTP status"))
        }
        (ordinal == I64{4}) -> {
            jet_rt_string_builder_push(target, rt_static_text("HTTP body was already consumed"))
        }
        (ordinal == I64{5}) -> {
            jet_rt_string_builder_push(target, rt_static_text("invalid HTTP framing"))
        }
        (ordinal == I64{6}) -> {
            jet_rt_string_builder_push(target, rt_static_text("unsupported HTTP body encoding"))
        }
        (ordinal == I64{7}) -> {
            jet_rt_string_builder_push(target, rt_static_text("HTTP operation cancelled"))
        }
        (ordinal == I64{8}) -> {
            jet_rt_string_builder_push(target, rt_static_text("HTTP body exceeds "))
        }
        (ordinal == I64{9}) -> {
            jet_rt_string_builder_push(target, rt_static_text("HTTP name resolution failed for "))
        }
        (ordinal == I64{10}) -> {
            jet_rt_string_builder_push(target, rt_static_text("HTTP connection failed for "))
        }
        (ordinal == I64{11}) -> {
            jet_rt_string_builder_push(target, rt_static_text("HTTP TLS failed during "))
        }
        (ordinal == I64{12}) -> {
            jet_rt_string_builder_push(target, rt_static_text("HTTP timeout during "))
        }
        (ordinal == I64{13}) -> {
            jet_rt_string_builder_push(target, rt_static_text("HTTP proxy failed during "))
        }
        (ordinal == I64{14}) -> {
            jet_rt_string_builder_push(target, rt_static_text("HTTP redirect failed: "))
        }
        (ordinal == I64{15}) -> {
            jet_rt_string_builder_push(target, rt_static_text("unsupported HTTP protocol "))
        }
        (ordinal == I64{16}) -> {
            jet_rt_string_builder_push(target, rt_static_text("HTTP I/O failed during "))
        }
        (ordinal == I64{17}) -> {}
        (ordinal == I64{18}) -> {
            jet_rt_string_builder_push(target, rt_static_text("HTTP resource unavailable: "))
        }
        (ordinal == I64{19}) -> {
            jet_rt_string_builder_push(target, rt_static_text("internal HTTP failure; incident "))
        }
        else -> rt_text_push_word(target, I64{138786657352}, I64{5}) // HTTP (tag20)
    }
}
#Export(c) fn jet_rt_handle_show_jet_http_error(value: I64) -> I64 {
    ordinal :: http_error_tag(value)
    payload :: encoding_word(wrapping(value + HTTP_ERROR_PAYLOAD))
    if (ordinal == I64{20} && (payload < I64{0} || payload > I64{2})) -> rt_record_variant_panic()
    target :: jet_rt_string_builder_new()
    http_error_prefix(target, ordinal)
    if (ordinal == I64{8}) {
        rt_text_push_number(target, payload)
        rt_text_push_word(target, I64{7596482291585081901}, I64{8})
        rt_text_push_word(target, I64{7629165}, I64{3}) // -byte limit
    } else if (ordinal >= I64{9} && ordinal <= I64{19}) {
        jet_rt_string_builder_push(target, payload)
    } else if (ordinal == I64{20}) {
        if {
            (payload == I64{0}) -> {
                rt_text_push_word(target, I64{7142837026506239075}, I64{8})
                rt_text_push_word(target, I64{127970252320367}, I64{6})
            }
            (payload == I64{1}) -> {
                rt_text_push_word(target, I64{7070777195076150643}, I64{8})
                rt_text_push_word(target, I64{6581865}, I64{3})
            }
            else -> {
                rt_text_push_word(target, I64{7596482291618178419}, I64{8})
                rt_text_push_word(target, I64{125779969406067}, I64{6})
            }
        }
        jet_rt_string_builder_push(target, rt_static_text(" is unavailable on this build target"))
    }
    jet_rt_string_builder_finish(target)
}
#Export(c) fn jet_rt_handle_display_jet_http_error(value: I64) -> I64 { jet_rt_handle_show_jet_http_error(value) }
#Export(c) fn jet_rt_handle_debug_jet_http_error(value: I64) -> I64 { jet_rt_handle_show_jet_http_error(value) }
