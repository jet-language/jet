// `jet test --coverage` (JetCli TestCoverage.jet). A coverage image's probed
// functions call jet_rt_coverage_function with their line as they start
// (JetIR BuildTests.jet ir_coverage_probe). The first entry of each line in
// this process appends `f<TAB><line><LF>` to the file JET_COV_OUT names, so
// every test process of the run appends to the one file the CLI reads. A
// line past the bitmap appends on every entry; the reader keeps a set.

// O_WRONLY|O_CREAT|O_APPEND|O_CLOEXEC.
COVERAGE_OPEN: I64{525377}
// One bit per source line below this.
COVERAGE_LINES: I64{1048576}
COVERAGE_BITMAP_BYTES: I64{131072}

coverage_root := I64{0}
// runtime-init: 4 when coverage_root
#Export(c) jet_rt_coverage_init: fn() {
    if (coverage_root != I64{0}) -> return
    root: jet_rt_alloc(COVERAGE_BITMAP_BYTES, I64{8})
    thread_zero(root, COVERAGE_BITMAP_BYTES)
    #Unsafe("runtime-init runs before any other thread exists") {
        coverage_root = root
    }
}

#Export(c) jet_rt_coverage_function: fn(line: I64) {
    if (coverage_root != I64{0} && line >= I64{0} && line < COVERAGE_LINES) {
        word: wrapping(coverage_root + (line >> I64{6}) * I64{8})
        bit: I64{1} << line.bit_and(I64{63})
        loop {
            seen: sync_load(word)
            if (seen.bit_and(bit) != I64{0}) -> return
            if (sync_cas(word, seen, seen.bit_or(bit)) == seen) -> break
        }
    }
    coverage_append(line)
}

coverage_append: fn(line: I64) {
    path: rt_env_get(env_name_jet_cov_out())
    if (path == I64{0}) -> return
    record: jet_rt_string_builder_new()
    jet_rt_string_builder_push(record, rt_static_text("f"))
    rt_text_push_word(record, I64{9}, I64{1})
    rt_text_push_number(record, line)
    rt_text_push_word(record, I64{10}, I64{1})
    name: fd_c_path(path)
    fd: host_call(I64{2}, name, COVERAGE_OPEN, I64{384})
    if (fd >= I64{0}) {
        // One write of a short record: O_APPEND keeps each process's records whole.
        _ := receipt_section_write_all(fd, rt_text_data(record), rt_text_len(record))
        _ := host_call(I64{3}, fd, I64{0}, I64{0})
    }
    fd_c_path_drop(name, path)
    jet_rt_string_drop(record)
    jet_rt_string_drop(path)
}
