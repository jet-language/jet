// The UI host provider seam (core.ui.host): primitives only. Core owns every
// rule, queue, registry and UIHostError; a provider answers seven questions:
// is a capability present, the clipboard's text (get and set), the next raw
// event of a queue, a dialog's request and result, whether it claimed a key
// for the shortcut queue, whether it handed a file's bytes to the person
// to save (app.save_file), and a device request of the app's (app.ask).
//
// The leaves below are C functions. This native runtime defines them headless:
// no capability is present and every service declines. A web build's host
// (JetWeb Host.jet web_host_functions) defines them in place of these at every
// call and forwards each to the page's browser provider; the optimizer never
// inlines one (JetIR IR.jet IR_HOST_PROVIDER).
//
// A text or byte answer is two calls: the leaf stages it and returns its
// byte length (negative for none), then `jet_ui_provider_take` copies the
// staged bytes into a buffer of that length and clears the stage. A leaf
// whose provider answers later returns -2 instead: `jet_ui_provider_settle`
// waits for that answer and stages it, where the program's entry can wait
// (Sync.jet jet_rt_host_can_wait); elsewhere there is none.

// The headless provider: 0 is absent, -1 declines, and nothing is staged.
#Export(c) jet_ui_provider_capability: fn(capability: I64) -> I64 { I64{0} }

#Export(c) jet_ui_provider_clipboard_get: fn() -> I64 { I64{-1} }

#Export(c) jet_ui_provider_clipboard_set: fn(bytes: I64, length: I64) -> I64 { I64{-1} }

#Export(c) jet_ui_provider_event_pop: fn(queue: I64) -> I64 { I64{-1} }

#Export(c) jet_ui_provider_dialog_request: fn(kind: I64, bytes: I64, length: I64) -> I64 { I64{-1} }

#Export(c) jet_ui_provider_dialog_result: fn(token: I64) -> I64 { I64{-1} }

#Export(c) jet_ui_provider_key_claim: fn(bytes: I64, length: I64) -> I64 { I64{-1} }

// The request record of kind `kind`, as its pointer and length: 0 asks for
// the permission it names (app.ask), 1 for where the device is
// (app.location), 2 for a photo (app.take_photo), and 3 for a part of a file
// the provider holds for the app (PickedFile), whose bytes are the answer.
#Export(c) jet_ui_provider_device: fn(kind: I64, bytes: I64, length: I64) -> I64 { I64{-1} }

#Export(c) jet_ui_provider_settle: fn() -> I64 { I64{-1} }

// The file's name, media type and bytes, each as its pointer and length.
#Export(c) jet_ui_provider_save_file: fn(name: I64, name_length: I64, media: I64, media_length: I64, bytes: I64, length: I64) -> I64 {
    I64{-1}
}

#Export(c) jet_ui_provider_take: fn(buffer: I64) {}

// The staged text of the leaf's answer as an owned string, into `some`; 0
// when the leaf staged none.
ui_host_take_into: fn(answer: I64, some: I64) -> I64 {
    length: ui_host_answer_length(answer)
    if (length < I64{0}) { return I64{0} }
    buffer: jet_rt_alloc(if (length == I64{0}) -> I64{1} else -> length, I64{1})
    jet_ui_provider_take(buffer)
    text: rt_text_lossy(buffer, length)
    jet_rt_free(buffer, if (length == I64{0}) -> I64{1} else -> length, I64{1})
    if (jet_rt_session_propagate() != I64{0}) { return I64{0} }
    trap_store(some, text)
    I64{1}
}

// The staged bytes of the leaf's answer as a fresh [U8] in
// data_out/length_out, presence 1; 0 when the leaf staged none.
ui_host_take_bytes: fn(answer: I64, data_out: I64, length_out: I64) -> I64 {
    rt_text_store(data_out, I64{0})
    rt_text_store(length_out, I64{0})
    length: ui_host_answer_length(answer)
    if (length < I64{0}) { return I64{0} }
    buffer: jet_rt_alloc(if (length == I64{0}) -> I64{1} else -> length, I64{1})
    jet_ui_provider_take(buffer)
    rt_text_store(length_out, packed_bytes_out(buffer, length, data_out))
    jet_rt_free(buffer, if (length == I64{0}) -> I64{1} else -> length, I64{1})
    I64{1}
}

// The length of the leaf's staged answer, negative for none. A provider
// that answers later (-2) has its answer staged once it came: the entry
// waits for it where it can, and has none where it can't.
ui_host_answer_length: fn(answer: I64) -> I64 {
    if (answer != I64{-2}) { return answer }
    if (jet_rt_host_can_wait() == I64{0}) { return I64{-1} }
    jet_ui_provider_settle()
}

// Core routes (core.ui.host.__*): the leaves' answers as Jet values.
#Export(c) jet_ui_host_capability: fn(capability: I64) -> Bool {
    jet_ui_provider_capability(jet_int_owned_to_i64(capability)) == I64{1}
}

#Export(c) jet_ui_host_clipboard_get: fn(some: I64) -> I64 {
    ui_host_take_into(jet_ui_provider_clipboard_get(), some)
}

#Export(c) jet_ui_host_clipboard_set: fn(text: I64) -> Bool {
    jet_ui_provider_clipboard_set(rt_text_data(text), rt_text_len(text)) == I64{0}
}

#Export(c) jet_ui_host_event_pop: fn(queue: I64, some: I64) -> I64 {
    ui_host_take_into(jet_ui_provider_event_pop(jet_int_owned_to_i64(queue)), some)
}

#Export(c) jet_ui_host_key_claim: fn(claim: I64) -> Bool {
    jet_ui_provider_key_claim(rt_text_data(claim), rt_text_len(claim)) == I64{0}
}

#Export(c) jet_ui_host_save_file: fn(name: I64, media: I64, bytes: I64, length: I64) -> Bool {
    jet_ui_provider_save_file(rt_text_data(name), rt_text_len(name), rt_text_data(media), rt_text_len(media), bytes, length) == I64{0}
}

#Export(c) jet_ui_host_dialog_request: fn(kind: I64, request: I64) -> I64 {
    jet_int_owned_from_i64(jet_ui_provider_dialog_request(jet_int_owned_to_i64(kind), rt_text_data(request), rt_text_len(request)))
}

#Export(c) jet_ui_host_dialog_result: fn(token: I64, some: I64) -> I64 {
    ui_host_take_into(jet_ui_provider_dialog_result(jet_int_owned_to_i64(token)), some)
}

#Export(c) jet_ui_host_device: fn(kind: I64, request: I64, some: I64) -> I64 {
    ui_host_take_into(jet_ui_provider_device(jet_int_owned_to_i64(kind), rt_text_data(request), rt_text_len(request)), some)
}

#Export(c) jet_ui_host_device_bytes: fn(kind: I64, request: I64, data_out: I64, length_out: I64) -> I64 {
    ui_host_take_bytes(jet_ui_provider_device(jet_int_owned_to_i64(kind), rt_text_data(request), rt_text_len(request)), data_out, length_out)
}
