// ReactiveEventWatch.rs:808-837; CAbiRoutes.rs:9545-9558.
// Codec construction does NOT call JetAsyncPolicy.validate; negative capacity
// remains representable here exactly as in the seed record constructor.
#Export(c) fn jet_rt_record_new_JetAsyncPolicy(capacity: I64, overflow: I64) -> I64 {
    raw :: jet_int_owned_to_i64(capacity)
    if (overflow < I64{0} || overflow > I64{2}) -> trap_native_index_range_stop()
    value :: jet_rt_alloc(ASYNC_POLICY_BYTES, I64{8})
    data_tree_store(value + ASYNC_POLICY_CAPACITY, raw)
    data_tree_store(value + ASYNC_POLICY_OVERFLOW, overflow)
    value
}
#Export(c) fn jet_rt_record_get_JetAsyncPolicy_capacity(value: I64) -> I64 { jet_int_owned_from_i64(data_tree_word(value + ASYNC_POLICY_CAPACITY)) }
#Export(c) fn jet_rt_record_get_JetAsyncPolicy_overflow(value: I64) -> I64 { data_tree_word(value + ASYNC_POLICY_OVERFLOW) }
#Export(c) fn jet_rt_handle_clone_JetAsyncPolicy(value: I64) -> I64 {
    result :: jet_rt_alloc(ASYNC_POLICY_BYTES, I64{8})
    coll_copy(value, result, ASYNC_POLICY_BYTES)
    result
}
#Export(c) fn jet_rt_handle_drop_JetAsyncPolicy(value: I64) {
    if (value != I64{0}) -> jet_rt_free(value, ASYNC_POLICY_BYTES, I64{8})
}
#Export(c) fn jet_rt_handle_clone_JetEventOverflow(value: I64) -> I64 {
    result :: jet_rt_alloc(EVENT_OVERFLOW_BYTES, I64{8})
    data_tree_store(result + EVENT_OVERFLOW_TAG, data_tree_word(value + EVENT_OVERFLOW_TAG))
    result
}
#Export(c) fn jet_rt_handle_drop_JetEventOverflow(value: I64) {
    if (value != I64{0}) -> jet_rt_free(value, EVENT_OVERFLOW_BYTES, I64{8})
}
#Export(c) fn jet_rt_handle_eq_JetEventOverflow(left: I64, right: I64) -> Bool { data_tree_word(left + EVENT_OVERFLOW_TAG) == data_tree_word(right + EVENT_OVERFLOW_TAG) }
