// Codec construction does NOT call JetAsyncPolicy.validate; negative capacity
// remains representable here exactly as in the seed record constructor.
#Export(c) jet_rt_record_new_jet_async_policy: fn(capacity: I64, overflow: I64) -> I64 {
    raw: jet_int_owned_to_i64(capacity)
    if (jet_scheduler_native_propagate() != I64{0}) -> return I64{0}
    if (overflow < I64{0} || overflow > I64{2}) {
        trap_native_index_range_stop()
        if (jet_scheduler_native_propagate() != I64{0}) -> return I64{0}
    }
    value: jet_rt_alloc(ASYNC_POLICY_BYTES, I64{8})
    dyn_store(wrapping(value + ASYNC_POLICY_CAPACITY), raw)
    dyn_store(wrapping(value + ASYNC_POLICY_OVERFLOW), overflow)
    value
}
#Export(c) jet_rt_record_get_jet_async_policy_capacity: fn(value: I64) -> I64 { jet_int_owned_from_i64(dyn_word(wrapping(value + ASYNC_POLICY_CAPACITY))) }
#Export(c) jet_rt_record_get_jet_async_policy_overflow: fn(value: I64) -> I64 { dyn_word(wrapping(value + ASYNC_POLICY_OVERFLOW)) }
#Export(c) jet_rt_handle_clone_jet_async_policy: fn(value: I64) -> I64 {
    result: jet_rt_alloc(ASYNC_POLICY_BYTES, I64{8})
    coll_copy(value, result, ASYNC_POLICY_BYTES)
    result
}
#Export(c) jet_rt_handle_drop_jet_async_policy: fn(value: I64) {
    if (value != I64{0}) -> jet_rt_free(value, ASYNC_POLICY_BYTES, I64{8})
}
#Export(c) jet_rt_handle_clone_jet_event_overflow: fn(value: I64) -> I64 { encoding_enum_clone(value) }
#Export(c) jet_rt_handle_drop_jet_event_overflow: fn(value: I64) { encoding_enum_drop(value) }
#Export(c) jet_rt_handle_eq_jet_event_overflow: fn(left: I64, right: I64) -> Bool { encoding_enum_eq(left, right) }
