// Synchronous typed events: event policies, traces, subscriptions, scopes and
// events. A
// dispatch runs its handlers on the emitting thread, but a carrier is not
// confined to one: a declared point (`gate: event.decision_point<...>()`)
// is one process cell every task reads, so tasks on different carriers
// emit, run, listen and drop through the same core at once. The carrier
// counts (core, hook box, listener) are atomic, and the core's listener
// list is read and edited only under the core's lock, which no section
// holds across a handler call or a closure release. A Subscription is also
// the state of an AsyncEvent listener (AsyncEvents.jet), whose dispatch
// runs on a scheduler thread: its count and active flag are atomic.
//
// EventCore80: strong0 weak8 next_id16 listeners{len24 cap32 data40} policy48
//   id56 source64 lock72
//   An Event handle is its core; a subscription's cleanup holds a weak
//   count, and the strong handles together hold one more, so the last weak
//   release frees the core. source is the observations' static source text
//   ("Event", "DecisionHook"), 0 for a Hook, which records none; id is the
//   identity they name it by (ObserveLive.jet observe_event_id). lock guards
//   next_id and the listener list.
// Listener64: refs0 id8 priority16 once24 sub32 env40 invoke48 release56
//   One count for the core's list, one per dispatch snapshot holding it, so
//   a handler that unsubscribes itself or another listener mid-dispatch
//   keeps the running closure alive.
//   invoke(env, payload_slot, scratch) is the lowering's typed adapter; the
//   payload slot is lent for the call. release(env) frees the closure once.
// Subscription40: refs0 active8 core16 (weak, 0 none) id24 note32
//   note is the observation note of a registration made while the run
//   publishes live snapshots (event_note_new), else 0.
// EventNote64: source0 event8 owner16 subscription24 priority32 counts40
//   capacity48 overflow56: the fields every record naming the subscription
//   carries. A sync carrier's counts, capacity and overflow are 0, 0 and
//   "None"; an AsyncEvent's -1, its capacity and its overflow.
// EventScope72: refs0 canceled8 subs{len16 cap24 data32}
//   hard{len40 cap48 data56}: the AsyncEvent cores whose hard cancel the
//   scope's cancel runs, one count each. id64 is the owner identity its
//   subscriptions' observations name.
// EventTrace24: delivered0 queued8 dropped16

event_word: fn(address: I64) -> I64 { trap_word(address) }

event_store: fn(address: I64, value: I64) { trap_store(address, value) }

// The lock of the sync core `core` (EventCore lock72).
event_core_lock: fn(core: I64) { sync_mutex_lock(wrapping(core + I64{72})) }

event_core_unlock: fn(core: I64) { sync_mutex_unlock(wrapping(core + I64{72})) }

// Word vectors embedded at `base`: len0 cap8 data16.
event_words_push: fn(base: I64, word: I64) {
    length: event_word(base)
    capacity: event_word(wrapping(base + I64{8}))
    if length == capacity {
        grown: if (capacity == I64{0}) -> I64{4} else -> capacity * I64{2}
        next: jet_rt_alloc(grown * I64{8}, I64{8})
        data: event_word(wrapping(base + I64{16}))
        if (length != I64{0}) { coll_copy(data, next, length * I64{8}) }
        if (capacity != I64{0}) { jet_rt_free(data, capacity * I64{8}, I64{8}) }
        event_store(wrapping(base + I64{8}), grown)
        event_store(wrapping(base + I64{16}), next)
    }
    event_store(wrapping(event_word(wrapping(base + I64{16})) + length * I64{8}), word)
    event_store(base, length + I64{1})
}

event_words_get: fn(base: I64, index: I64) -> I64 {
    event_word(wrapping(event_word(wrapping(base + I64{16})) + index * I64{8}))
}

// Order-preserving removal: registration order is dispatch order.
event_words_remove: fn(base: I64, index: I64) {
    length: event_word(base)
    data: event_word(wrapping(base + I64{16}))
    last: length - I64{1}
    ^at: index
    loop at < last {
        event_store(wrapping(data + at * I64{8}), event_word(wrapping(data + (at + I64{1}) * I64{8})))
        at += I64{1}
    }
    event_store(base, length - I64{1})
}

// Detaches the vector's buffer (its words now belong to the caller).
event_words_take: fn(base: I64) {
    event_store(base, I64{0})
    event_store(wrapping(base + I64{8}), I64{0})
    event_store(wrapping(base + I64{16}), I64{0})
}

event_words_free: fn(data: I64, capacity: I64) {
    if (capacity != I64{0}) { jet_rt_free(data, capacity * I64{8}, I64{8}) }
}

event_release_closure: fn(env: I64, release: I64) {
    if (release == I64{0}) {
        return
    }
    jet_rt_session_shield_enter()
    coll_call1_unit(release, env)
    jet_rt_session_shield_leave()
}

// ---- Subscription ----------------------------------------------------------

event_sub_new: fn() -> I64 {
    sub: jet_rt_alloc(I64{40}, I64{8})
    event_store(sub, I64{1})
    event_store(wrapping(sub + I64{8}), I64{1})
    event_store(wrapping(sub + I64{16}), I64{0})
    event_store(wrapping(sub + I64{24}), I64{0})
    event_store(wrapping(sub + I64{32}), I64{0})
    sub
}

event_sub_retain: fn(sub: I64) -> I64 {
    ^_: sync_add(sub, I64{1})
    sub
}

event_sub_release: fn(sub: I64) {
    if (sync_add(sub, I64{-1}) != I64{1}) {
        return
    }
    core: event_word(wrapping(sub + I64{16}))
    note: event_word(wrapping(sub + I64{32}))
    jet_rt_free(sub, I64{40}, I64{8})
    if (note != I64{0}) { jet_rt_free(note, I64{64}, I64{8}) }
    if (core != I64{0}) { event_core_weak_release(core) }
}

event_sub_active: fn(sub: I64) -> Bool { sync_load(wrapping(sub + I64{8})) != I64{0} }

// JetSubscription.unsubscribe :578-590: the first call deactivates and runs
// the cleanup, which observes the removal of a registered subscription and
// removes the listener while its event is still alive (Weak.upgrade); a
// later call is a no-op. The flag clears once: an AsyncEvent dispatch on
// another thread may reserve a once subscription meanwhile
// (AsyncEvents.jet async_snapshot), and only one of the two observes it.
event_sub_unsubscribe: fn(sub: I64) {
    if (sync_cas(wrapping(sub + I64{8}), I64{1}, I64{0}) != I64{1}) {
        return
    }
    event_note_observe(event_word(wrapping(sub + I64{32})), I64{0}, rt_static_text("Removed"), rt_static_text("None"))
    core: event_word(wrapping(sub + I64{16}))
    if (core == I64{0}) {
        return
    }
    id: event_word(wrapping(sub + I64{24}))
    event_core_lock(core)
    // The last Event handle took the list once the strong count reached 0.
    ^found: I64{0}
    if (sync_load(core) != I64{0}) {
        base: wrapping(core + I64{24})
        ^at: I64{0}
        loop at < event_word(base) {
            listener: event_words_get(base, at)
            if event_word(wrapping(listener + I64{8})) == id {
                event_words_remove(base, at)
                found = listener
                break
            }
            at += I64{1}
        }
    }
    event_core_unlock(core)
    if (found != I64{0}) { event_listener_release(found) }
}

// Gives the registered `sub` its observation note (EventNote64) while the
// run publishes live snapshots: a fresh subscription identity under the
// owner identity of `scope`. Returns the note, else 0.
event_note_new: fn(sub: I64, source: I64, event: I64, scope: I64, priority: I64, counts: I64, capacity: I64, overflow: I64) -> I64 {
    if !observe_live() -> return I64{0}
    note: jet_rt_alloc(I64{64}, I64{8})
    event_store(note, source)
    event_store(wrapping(note + I64{8}), event)
    event_store(wrapping(note + I64{16}), event_word(wrapping(scope + I64{64})))
    event_store(wrapping(note + I64{24}), observe_event_id())
    event_store(wrapping(note + I64{32}), priority)
    event_store(wrapping(note + I64{40}), counts)
    event_store(wrapping(note + I64{48}), capacity)
    event_store(wrapping(note + I64{56}), overflow)
    event_store(wrapping(sub + I64{32}), note)
    note
}

// The `lifecycle` record of the subscription whose note is `note` (none
// for 0), in `dispatch` (0 outside one), with `failure` and no terminal.
event_note_observe: fn(note: I64, dispatch: I64, lifecycle: I64, failure: I64) {
    if (note == I64{0}) {
        return
    }
    counts: event_word(wrapping(note + I64{40}))
    observe_event(event_word(note), event_word(wrapping(note + I64{8})), event_word(wrapping(note + I64{16})), event_word(wrapping(note + I64{24})), dispatch, lifecycle, counts, counts, counts, event_word(wrapping(note + I64{48})), event_word(wrapping(note + I64{56})), event_word(wrapping(note + I64{32})), failure, rt_static_text("None"))
}

// The note of the subscription of the listener row `listener`.
event_listener_note: fn(listener: I64) -> I64 {
    event_word(wrapping(event_word(wrapping(listener + I64{32})) + I64{32}))
}

// A dispatch's own `lifecycle` record on the sync carrier `core` (none for
// a Hook's): no owner, subscription or priority.
event_core_observe: fn(core: I64, dispatch: I64, lifecycle: I64, failure: I64, terminal: I64) {
    source: event_word(wrapping(core + I64{64}))
    if (source == I64{0}) {
        return
    }
    observe_event(source, event_word(wrapping(core + I64{56})), I64{0}, I64{0}, dispatch, lifecycle, I64{0}, I64{0}, I64{0}, I64{0}, rt_static_text("None"), I64{0}, failure, terminal)
}

// A fresh dispatch identity on the sync carrier `core`, 0 for a Hook's or
// while the run publishes no live snapshot.
event_core_dispatch: fn(core: I64) -> I64 {
    if (event_word(wrapping(core + I64{64})) == I64{0}) -> I64{0} else -> observe_event_id()
}

#Export(c) jet_subscription_unsubscribe: fn(sub: I64) { event_sub_unsubscribe(sub) }

#Export(c) jet_subscription_active: fn(sub: I64) -> Bool { event_sub_active(sub) }

#Export(c) jet_rt_handle_clone_jet_subscription: fn(sub: I64) -> I64 { event_sub_retain(sub) }

#Export(c) jet_rt_handle_drop_jet_subscription: fn(sub: I64) {
    if (sub != I64{0}) { event_sub_release(sub) }
}

// ---- Listener --------------------------------------------------------------

event_listener_retain: fn(listener: I64) { ^_: sync_add(listener, I64{1}) }

event_listener_release: fn(listener: I64) {
    if (sync_add(listener, I64{-1}) != I64{1}) {
        return
    }
    sub: event_word(wrapping(listener + I64{32}))
    env: event_word(wrapping(listener + I64{40}))
    release: event_word(wrapping(listener + I64{56}))
    jet_rt_free(listener, I64{64}, I64{8})
    event_release_closure(env, release)
    event_sub_release(sub)
}

// ---- EventScope ------------------------------------------------------------

#Export(c) jet_event_scope_new: fn() -> I64 {
    scope: jet_rt_alloc(I64{72}, I64{8})
    coll_zero(scope, I64{72})
    event_store(scope, I64{1})
    event_store(wrapping(scope + I64{64}), observe_event_id())
    scope
}

// JetEventScope.track :625-634 and active_count :648-652 drop the
// subscriptions no longer active before they count or append.
event_scope_prune: fn(scope: I64) {
    base: wrapping(scope + I64{16})
    length: event_word(base)
    data: event_word(wrapping(base + I64{16}))
    ^kept: I64{0}
    ^at: I64{0}
    loop at < length {
        sub: event_word(wrapping(data + at * I64{8}))
        if event_sub_active(sub) {
            event_store(wrapping(data + kept * I64{8}), sub)
            kept += I64{1}
        } else { event_sub_release(sub) }
        at += I64{1}
    }
    event_store(base, kept)
}

// A canceled scope deactivates every new subscription at once.
event_scope_track: fn(scope: I64, sub: I64) {
    if (event_word(wrapping(scope + I64{8})) != I64{0}) {
        event_sub_unsubscribe(sub)
        return
    }
    event_scope_prune(scope)
    event_words_push(wrapping(scope + I64{16}), event_sub_retain(sub))
}

// JetEventScope.track_hard_cancel :616-624: a canceled scope tracks
// nothing; an event is tracked once.
event_scope_track_hard_cancel: fn(scope: I64, core: I64) {
    if (event_word(wrapping(scope + I64{8})) != I64{0}) {
        return
    }
    base: wrapping(scope + I64{40})
    ^at: I64{0}
    loop at < event_word(base) {
        if (event_words_get(base, at) == core) {
            return
        }
        at += I64{1}
    }
    async_core_retain(core)
    event_words_push(base, core)
}

// Releases the tracked async cores of `scope`, hard-canceling each first
// when `cancel`.
event_scope_release_hard: fn(scope: I64, cancel: Bool) {
    base: wrapping(scope + I64{40})
    length: event_word(base)
    capacity: event_word(wrapping(base + I64{8}))
    data: event_word(wrapping(base + I64{16}))
    event_words_take(base)
    ^at: I64{0}
    loop at < length {
        core: event_word(wrapping(data + at * I64{8}))
        if cancel -> async_hard_cancel(core)
        async_core_release(core)
        at += I64{1}
    }
    event_words_free(data, capacity)
}

// JetEventScope.cancel :635-647: once; every tracked subscription is
// unsubscribed in registration order, then every tracked async event is
// hard-canceled, and the scope keeps none.
#Export(c) jet_event_scope_cancel: fn(scope: I64) {
    if (event_word(wrapping(scope + I64{8})) != I64{0}) {
        return
    }
    event_store(wrapping(scope + I64{8}), I64{1})
    base: wrapping(scope + I64{16})
    length: event_word(base)
    capacity: event_word(wrapping(base + I64{8}))
    data: event_word(wrapping(base + I64{16}))
    event_words_take(base)
    ^at: I64{0}
    loop at < length {
        sub: event_word(wrapping(data + at * I64{8}))
        event_sub_unsubscribe(sub)
        event_sub_release(sub)
        at += I64{1}
    }
    event_words_free(data, capacity)
    event_scope_release_hard(scope, true)
}

#Export(c) jet_event_scope_active_count: fn(scope: I64) -> I64 {
    event_scope_prune(scope)
    jet_int_owned_from_i64(event_word(wrapping(scope + I64{16})))
}

#Export(c) jet_rt_handle_clone_jet_event_scope: fn(scope: I64) -> I64 {
    event_store(scope, event_word(scope) + I64{1})
    scope
}

// Drop for JetEventScope :655-661: the last handle cancels, releasing every
// subscription the scope still tracks.
#Export(c) jet_rt_handle_drop_jet_event_scope: fn(scope: I64) {
    if (scope == I64{0}) {
        return
    }
    if (event_word(scope) == I64{1}) { jet_event_scope_cancel(scope) }
    refs: event_word(scope) - I64{1}
    if (refs != I64{0}) {
        event_store(scope, refs)
        return
    }
    base: wrapping(scope + I64{16})
    length: event_word(base)
    capacity: event_word(wrapping(base + I64{8}))
    data: event_word(wrapping(base + I64{16}))
    event_scope_release_hard(scope, false)
    jet_rt_free(scope, I64{72}, I64{8})
    ^at: I64{0}
    loop at < length {
        event_sub_release(event_word(wrapping(data + at * I64{8})))
        at += I64{1}
    }
    event_words_free(data, capacity)
}

// ---- EventPolicy / EventTrace ----------------------------------------------

// JetEventPolicy.sync :522-528: the sole AllowDepthFirst ordinal (0); its
// box is EncodingABI's enum owner (EventEnumHandles.jet clone/drop).
#Export(c) jet_event_policy_sync: fn() -> I64 {
    policy: jet_rt_alloc(ENCODING_ENUM_BYTES, I64{8})
    encoding_store(wrapping(policy + ENCODING_ENUM_TAG), I64{0})
    policy
}

// EventTrace32: delivered0 queued8 dropped16 summary24. The summary is an
// owned String an AsyncEvent DispatchReport's trace carries (its entry's
// steps joined by " -> "); 0 is an Event dispatch's computed summary.
event_trace_new: fn(delivered: I64, queued: I64, dropped: I64) -> I64 {
    event_trace_with_summary(delivered, queued, dropped, I64{0})
}

event_trace_with_summary: fn(delivered: I64, queued: I64, dropped: I64, summary: I64) -> I64 {
    trace: jet_rt_alloc(I64{32}, I64{8})
    event_store(trace, delivered)
    event_store(wrapping(trace + I64{8}), queued)
    event_store(wrapping(trace + I64{16}), dropped)
    event_store(wrapping(trace + I64{24}), summary)
    trace
}

#Export(c) jet_event_trace_delivered: fn(trace: I64) -> I64 {
    jet_int_owned_from_i64(event_word(trace))
}

#Export(c) jet_event_trace_queued: fn(trace: I64) -> I64 {
    jet_int_owned_from_i64(event_word(wrapping(trace + I64{8})))
}

#Export(c) jet_event_trace_dropped: fn(trace: I64) -> I64 {
    jet_int_owned_from_i64(event_word(wrapping(trace + I64{16})))
}

// A carried summary, else `event delivered={d} queued={q} dropped={r}`
// (dispatch :800-805).
#Export(c) jet_event_trace_summary: fn(trace: I64) -> I64 {
    summary: event_word(wrapping(trace + I64{24}))
    if (summary != I64{0}) { return jet_rt_string_clone(summary) }
    text: jet_rt_string_builder_new()
    jet_rt_string_builder_push(text, rt_static_text("event delivered="))
    rt_text_push_number(text, event_word(trace))
    jet_rt_string_builder_push(text, rt_static_text(" queued="))
    rt_text_push_number(text, event_word(wrapping(trace + I64{8})))
    jet_rt_string_builder_push(text, rt_static_text(" dropped="))
    rt_text_push_number(text, event_word(wrapping(trace + I64{16})))
    jet_rt_string_builder_finish(text)
}

#Export(c) jet_rt_handle_clone_jet_event_trace: fn(trace: I64) -> I64 {
    summary: event_word(wrapping(trace + I64{24}))
    event_trace_with_summary(event_word(trace), event_word(wrapping(trace + I64{8})), event_word(wrapping(trace + I64{16})), if (summary != I64{0}) -> jet_rt_string_clone(summary) else -> I64{0})
}

#Export(c) jet_rt_handle_drop_jet_event_trace: fn(trace: I64) {
    if (trace == I64{0}) {
        return
    }
    jet_rt_string_drop(event_word(wrapping(trace + I64{24})))
    jet_rt_free(trace, I64{32}, I64{8})
}

// ---- Event -----------------------------------------------------------------

// JetEvent.with_policy :692-698 borrows the policy ordinal; the caller keeps
// and releases its policy value.
#Export(c) jet_event_with_policy: fn(policy: I64) -> I64 {
    event_core_new(encoding_word(wrapping(policy + ENCODING_ENUM_TAG)), rt_static_text("Event"))
}

// A fresh EventCore with one strong count and policy ordinal `ordinal` (0 is
// EventPolicy.Sync, JetEvent.new), whose observations name `source` (0 for
// none, a Hook's).
event_core_new: fn(ordinal: I64, source: I64) -> I64 {
    core: jet_rt_alloc(I64{80}, I64{8})
    coll_zero(core, I64{80})
    event_store(core, I64{1})
    event_store(wrapping(core + I64{8}), I64{1})
    event_store(wrapping(core + I64{48}), ordinal)
    if (source != I64{0}) {
        event_store(wrapping(core + I64{56}), observe_event_id())
        event_store(wrapping(core + I64{64}), source)
    }
    core
}

#Export(c) jet_rt_handle_clone_jet_event: fn(core: I64) -> I64 {
    ^_: sync_add(core, I64{1})
    core
}

event_core_free: fn(core: I64) {
    event_words_free(event_word(wrapping(core + I64{40})), event_word(wrapping(core + I64{32})))
    jet_rt_free(core, I64{80}, I64{8})
}

event_core_weak_release: fn(core: I64) {
    if (sync_add(wrapping(core + I64{8}), I64{-1}) == I64{1}) { event_core_free(core) }
}

// The last Event handle drops its listeners (handlers and their counts on
// each subscription), then the weak count the strong handles held.
// Subscriptions outlive it: their cleanup finds no event.
#Export(c) jet_rt_handle_drop_jet_event: fn(core: I64) {
    if (core == I64{0}) {
        return
    }
    if (sync_add(core, I64{-1}) != I64{1}) {
        return
    }
    base: wrapping(core + I64{24})
    event_core_lock(core)
    length: event_word(base)
    capacity: event_word(wrapping(base + I64{8}))
    data: event_word(wrapping(base + I64{16}))
    event_words_take(base)
    event_core_unlock(core)
    ^at: I64{0}
    loop at < length {
        event_listener_release(event_word(wrapping(data + at * I64{8})))
        at += I64{1}
    }
    event_words_free(data, capacity)
    event_core_weak_release(core)
}

// JetEvent.add :717-754 (on / once / on_priority). The subscription is
// tracked by `scope` first; a canceled scope returns it inactive and the
// handler is released unregistered, unobserved. A registered one is
// observed Subscribed.
#Export(c) jet_event_listen: fn(core: I64, scope: I64, priority: I64, once: I64, env: I64, invoke: I64, release: I64) -> I64 {
    sub: event_sub_new()
    event_scope_track(scope, sub)
    if !event_sub_active(sub) {
        event_release_closure(env, release)
        return sub
    }
    listener: jet_rt_alloc(I64{64}, I64{8})
    event_store(listener, I64{1})
    event_store(wrapping(listener + I64{16}), priority)
    event_store(wrapping(listener + I64{24}), if (once != I64{0}) -> I64{1} else -> I64{0})
    event_store(wrapping(listener + I64{32}), event_sub_retain(sub))
    event_store(wrapping(listener + I64{40}), env)
    event_store(wrapping(listener + I64{48}), invoke)
    event_store(wrapping(listener + I64{56}), release)
    ^_: sync_add(wrapping(core + I64{8}), I64{1})
    event_core_lock(core)
    id: event_word(wrapping(core + I64{16}))
    event_store(wrapping(core + I64{16}), id + I64{1})
    event_store(wrapping(listener + I64{8}), id)
    event_store(wrapping(sub + I64{24}), id)
    event_store(wrapping(sub + I64{16}), core)
    event_words_push(wrapping(core + I64{24}), listener)
    event_core_unlock(core)
    source: event_word(wrapping(core + I64{64}))
    if (source != I64{0}) {
        note: event_note_new(sub, source, event_word(wrapping(core + I64{56})), scope, priority, I64{0}, I64{0}, rt_static_text("None"))
        event_note_observe(note, I64{0}, rt_static_text("Subscribed"), rt_static_text("None"))
    }
    sub
}

// Whether the snapshot row before `position` has a strictly lower priority.
event_ranks_below: fn(rows: I64, position: I64, priority: I64) -> Bool {
    if (position == I64{0}) { return false }
    event_word(wrapping(event_word(wrapping(rows + (position - I64{1}) * I64{8})) + I64{16})) < priority
}

// Dispatch snapshots: count0 capacity8 rows16, the rows ordered by priority
// (highest first) then registration, each holding a listener count.
// Stable insertion of `listener` after the `count` rows at `rows`: the list
// is already in registration order.
event_snapshot_insert: fn(rows: I64, count: I64, listener: I64) {
    priority: event_word(wrapping(listener + I64{16}))
    ^position: count
    loop event_ranks_below(rows, position, priority) {
        event_store(wrapping(rows + position * I64{8}), event_word(wrapping(rows + (position - I64{1}) * I64{8})))
        position -= I64{1}
    }
    event_store(wrapping(rows + position * I64{8}), listener)
}

// The active listeners of the listener list of `core` (an EventCore or a
// hook's), snapshot for one dispatch under the core's lock. An empty list
// takes no lock: a point nothing listens to dispatches with two counts and
// no lock, and a listener a racing registration adds is one this dispatch
// would equally miss had it run a moment earlier.
event_snapshot: fn(core: I64) -> I64 {
    base: wrapping(core + I64{24})
    if (sync_load(base) == I64{0}) {
        empty: jet_rt_alloc(I64{16}, I64{8})
        event_store(empty, I64{0})
        event_store(wrapping(empty + I64{8}), I64{0})
        return empty
    }
    event_core_lock(core)
    length: event_word(base)
    snapshot: jet_rt_alloc((length + I64{2}) * I64{8}, I64{8})
    event_store(wrapping(snapshot + I64{8}), length)
    ^count: I64{0}
    ^at: I64{0}
    loop at < length {
        listener: event_words_get(base, at)
        if event_sub_active(event_word(wrapping(listener + I64{32}))) {
            event_listener_retain(listener)
            event_snapshot_insert(wrapping(snapshot + I64{16}), count, listener)
            count += I64{1}
        }
        at += I64{1}
    }
    event_core_unlock(core)
    event_store(snapshot, count)
    snapshot
}

event_snapshot_count: fn(snapshot: I64) -> I64 { event_word(snapshot) }

event_snapshot_get: fn(snapshot: I64, index: I64) -> I64 {
    event_word(wrapping(wrapping(snapshot + I64{16}) + index * I64{8}))
}

// Frees the snapshot buffer; its rows' counts are released by the caller.
event_snapshot_free: fn(snapshot: I64) {
    jet_rt_free(snapshot, (event_word(wrapping(snapshot + I64{8})) + I64{2}) * I64{8}, I64{8})
}

// Whether a snapshot listener still gets its turn: one deactivated before
// its turn is skipped; a once listener is consumed before its handler runs.
event_listener_take_turn: fn(listener: I64) -> Bool {
    sub: event_word(wrapping(listener + I64{32}))
    if !event_sub_active(sub) -> return false
    if (event_word(wrapping(listener + I64{24})) != I64{0}) { event_sub_unsubscribe(sub) }
    true
}

// Runs the listener's handler with `payload` lent; its result goes to `out`.
event_listener_call: fn(listener: I64, payload: I64, out: I64) {
    ^_: coll_call3(event_word(wrapping(listener + I64{48})), event_word(wrapping(listener + I64{40})), payload, out)
}

// JetEvent.dispatch :758-806 under the sole AllowDepthFirst policy: nested
// emits dispatch immediately. Every active listener's handler runs in
// snapshot order (event_listener_take_turn).
// A stop delivered by a handler ends the dispatch and returns no trace.
// The dispatch holds its own strong count: a handler that drops the last
// Event handle leaves the core alive until the dispatch releases it.
// Observed: DispatchStarted, each handler's HandlerStarted and
// HandlerDelivered, then the Delivered Terminal.
#Export(c) jet_event_emit: fn(core: I64, payload: I64) -> I64 {
    ^_: sync_add(core, I64{1})
    dispatch: event_core_dispatch(core)
    event_core_observe(core, dispatch, rt_static_text("DispatchStarted"), rt_static_text("None"), rt_static_text("None"))
    snapshot: event_snapshot(core)
    count: event_snapshot_count(snapshot)
    scratch: jet_rt_alloc(I64{16}, I64{8})
    coll_zero(scratch, I64{16})
    ^delivered: I64{0}
    ^stopped: false
    ^at: I64{0}
    loop at < count {
        listener: event_snapshot_get(snapshot, at)
        if !stopped && event_listener_take_turn(listener) {
            note: event_listener_note(listener)
            event_note_observe(note, dispatch, rt_static_text("HandlerStarted"), rt_static_text("None"))
            event_listener_call(listener, payload, scratch)
            if (jet_rt_session_propagate() != I64{0}) { stopped = true } else {
                delivered += I64{1}
                event_note_observe(note, dispatch, rt_static_text("HandlerDelivered"), rt_static_text("None"))
            }
        }
        event_listener_release(listener)
        at += I64{1}
    }
    jet_rt_free(scratch, I64{16}, I64{8})
    event_snapshot_free(snapshot)
    event_prune_listeners(core)
    if !stopped {
        event_core_observe(core, dispatch, rt_static_text("Terminal"), rt_static_text("None"), rt_static_text("Delivered"))
    }
    jet_rt_handle_drop_jet_event(core)
    if stopped -> return I64{0}
    event_trace_new(delivered, I64{0}, I64{0})
}

// Keeps only listeners whose subscription is still active (dispatch :795).
// One pass decides each row once, so an unsubscribe on another thread
// between two reads of its flag cannot split it from its row.
event_prune_listeners: fn(core: I64) {
    base: wrapping(core + I64{24})
    // An empty list has no row to drop; only a dispatch's listeners make one.
    if (sync_load(base) == I64{0}) {
        return
    }
    event_core_lock(core)
    // The last Event handle took the list once the strong count reached 0.
    length: if (sync_load(core) == I64{0}) -> I64{0} else -> event_word(base)
    data: event_word(wrapping(base + I64{16}))
    ^dropped: I64{0}
    ^removed: I64{0}
    ^kept: I64{0}
    ^at: I64{0}
    loop at < length {
        listener: event_word(wrapping(data + at * I64{8}))
        if event_sub_active(event_word(wrapping(listener + I64{32}))) {
            event_store(wrapping(data + kept * I64{8}), listener)
            kept += I64{1}
        } else {
            if (dropped == I64{0}) { dropped = jet_rt_alloc(length * I64{8}, I64{8}) }
            event_store(wrapping(dropped + removed * I64{8}), listener)
            removed += I64{1}
        }
        at += I64{1}
    }
    if (removed != I64{0}) { event_store(base, kept) }
    event_core_unlock(core)
    if (removed == I64{0}) {
        return
    }
    // Released outside the lock: a release runs the closure's drop.
    at = I64{0}
    loop at < removed {
        event_listener_release(event_word(wrapping(dropped + at * I64{8})))
        at += I64{1}
    }
    jet_rt_free(dropped, length * I64{8}, I64{8})
}

event_active_listeners: fn(core: I64) -> I64 {
    base: wrapping(core + I64{24})
    ^count: I64{0}
    ^at: I64{0}
    loop at < event_word(base) {
        if event_sub_active(event_word(wrapping(event_words_get(base, at) + I64{32}))) {
            count += I64{1}
        }
        at += I64{1}
    }
    count
}

// The active listeners of the sync core `core`, read under its lock.
event_core_active_listeners: fn(core: I64) -> I64 {
    event_core_lock(core)
    count: event_active_listeners(core)
    event_core_unlock(core)
    count
}

#Export(c) jet_event_listener_count: fn(core: I64) -> I64 {
    jet_int_owned_from_i64(event_core_active_listeners(core))
}

// JetEvent.trace :814-816.
#Export(c) jet_event_trace: fn(core: I64) -> I64 {
    text: jet_rt_string_builder_new()
    jet_rt_string_builder_push(text, rt_static_text("listeners="))
    rt_text_push_number(text, event_core_active_listeners(core))
    jet_rt_string_builder_push(text, rt_static_text(" queued=0 dropped=0"))
    jet_rt_string_builder_finish(text)
}
