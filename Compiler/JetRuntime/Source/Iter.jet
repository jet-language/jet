// Native iterator owners. Each node owns its source, descriptor and closure;
// pulling uses reusable slots, not one allocation per element. Eager operations
// collect only where the reference kernels do (repeat/cycle/try/dedup_by).
// Node words: kind,meta,source,other,count,index,env,invoke,release,callback-meta,
// scratch,second-scratch,saved,saved-meta,list,extra,flags,initialized,done,context.

fn iter_meta(iter: I64) -> I64 { trap_word(iter + I64{8}) }

fn iter_new(kind: I64, meta: I64) -> I64 {
    node :: jet_rt_alloc(I64{160}, I64{8})
    coll_zero(node, I64{160})
    trap_store(node, kind)
    trap_store(node + I64{8}, coll_meta_copy(meta))
    node
}

// The channel layer supplies its descriptor before the first blocking pull.
// This node owns the receiver, not another iterator or a per-item holder.
fn iter_channel_new(receiver: I64, meta: I64) -> I64 {
    node :: iter_new(I64{28}, meta)
    trap_store(node + I64{16}, receiver)
    node
}

fn iter_wrap(kind: I64, source: I64, meta: I64) -> I64 {
    node :: iter_new(kind, meta)
    trap_store(node + I64{16}, source)
    trap_store(node + I64{80}, coll_slot_new(iter_meta(source)))
    node
}

fn iter_callback(kind: I64, source: I64, env: I64, invoke: I64, release: I64, callback_meta: I64, output_meta: I64) -> I64 {
    node :: iter_wrap(kind, source, output_meta)
    trap_store(node + I64{48}, env)
    trap_store(node + I64{56}, invoke)
    trap_store(node + I64{64}, release)
    trap_store(node + I64{72}, coll_meta_copy(callback_meta))
    trap_store(node + I64{88}, coll_slot_new(callback_meta))
    trap_store(node + I64{136}, coll_size(callback_meta))
    node
}

fn iter_unary(node: I64, input: I64, output: I64) -> Bool {
    _ := coll_call3(trap_word(node + I64{56}), trap_word(node + I64{48}), input, output)
    jet_rt_session_propagate() == I64{0}
}

fn iter_binary(node: I64, a: I64, b: I64, output: I64) -> I64 {
    coll_call4(trap_word(node + I64{56}), trap_word(node + I64{48}), a, b, output)
}

fn iter_equal(meta: I64, a: I64, b: I64) -> Bool {
    coll_call2(trap_word(meta + I64{32}), a, b) != I64{0}
}

fn iter_order(meta: I64, a: I64, b: I64) -> I64 { coll_call2(trap_word(meta + I64{40}), a, b) }

fn iter_drain(source: I64, header: I64) {
    coll_zero(header, I64{24})
    meta :: iter_meta(source)
    slot :: coll_slot_new(meta)
    loop iter_pull(source, slot) -> coll_list_push(header, slot, meta)
    jet_rt_free(slot, coll_size(meta), I64{8})
    if (jet_rt_session_propagate() != I64{0}) { coll_list_drop(header, meta, I64{0}) }
}

fn iter_saved_clear(node: I64) {
    saved :: trap_word(node + I64{96})
    if (saved != I64{0}) { coll_slot_free(saved, trap_word(node + I64{104})) }
    trap_store(node + I64{96}, I64{0})
}

fn iter_save(node: I64, slot: I64, meta: I64) {
    iter_saved_clear(node)
    held :: coll_slot_new(meta)
    coll_slot_clone(slot, held, meta)
    trap_store(node + I64{96}, held)
    if (trap_word(node + I64{104}) == I64{0}) { trap_store(node + I64{104}, coll_meta_copy(meta)) }
}

fn iter_pull_kernel(node: I64, output: I64) -> Bool {
    if (trap_word(node + I64{144}) != I64{0}) { return false }
    kind :: trap_word(node)
    meta :: iter_meta(node)
    source :: trap_word(node + I64{16})
    scratch :: trap_word(node + I64{80})
    second :: trap_word(node + I64{88})
    index :: trap_word(node + I64{40})
    count :: trap_word(node + I64{32})
    if (kind == I64{28}) { return iter_source_pull(node, output) }
    if (kind == I64{0}) {
        header :: trap_word(node + I64{112})
        if (index >= trap_word(header)) { return false }
        coll_copy(trap_word(header + I64{16}) + index * trap_word(meta), output, coll_payload(meta))
        trap_store(node + I64{40}, index + I64{1})
        return true
    }
    if (kind == I64{1}) { return false }
    if (kind == I64{2}) {
        if (index >= count) { return false }
        trap_store(output, jet_int_owned_from_i64(index))
        trap_store(node + I64{40}, index + I64{1})
        return true
    }
    if (kind == I64{25}) {
        value :: text_iter_pull(source)
        if (value == I64{0}) { return false }
        coll_copy(value, output, coll_payload(meta))
        jet_rt_free(value, coll_size(meta), I64{8})
        return true
    }
    if (kind == I64{28}) -> return channel_iter_pull(source, output)
    if (kind == I64{3}) {
        if (count <= I64{0}) { return false }
        trap_store(node + I64{32}, count - I64{1})
        return iter_pull(source, output)
    }
    if (kind == I64{4} || kind == I64{5}) {
        remaining := count
        if (kind == I64{5}) { remaining = if (index == I64{0}) -> I64{0} else -> count - I64{1} }
        loop remaining > (I64{0}) {
            if !iter_pull(source, scratch) -> return false
            coll_slot_drop(scratch, iter_meta(source))
            remaining -= I64{1}
        }
        trap_store(node + I64{40}, I64{1})
        if (kind == I64{4}) { trap_store(node + I64{32}, I64{0}) }
        return iter_pull(source, output)
    }
    if (kind == I64{6}) {
        if !iter_pull(source, scratch) -> return false
        ready :: iter_unary(node, scratch, output)
        coll_slot_drop(scratch, iter_meta(source))
        return ready
    }
    if (kind == I64{7} || kind == I64{8} || kind == I64{9}) {
        loop iter_pull(source, scratch) {
            if (kind == I64{9} && index != I64{0}) {
                coll_copy(scratch, output, coll_payload(meta))
                return true
            }
            if !iter_unary(node, scratch, second) {
                coll_slot_drop(scratch, iter_meta(source))
                return false
            }
            keep :: trap_byte(second) != I64{0}
            coll_slot_drop(second, trap_word(node + I64{72}))
            if ((kind != I64{9} && keep) || (kind == I64{9} && !keep)) {
                trap_store(node + I64{40}, I64{1})
                coll_copy(scratch, output, coll_payload(meta))
                return true
            }
            coll_slot_drop(scratch, iter_meta(source))
            if (kind == I64{8}) {
                trap_store(node + I64{144}, I64{1})
                return false
            }
        }
        return false
    }
    if (kind == I64{10}) {
        loop iter_pull(source, scratch) {
            previous :: trap_word(node + I64{96})
            if (previous == I64{0} || !iter_equal(meta, previous, scratch)) {
                iter_save(node, scratch, meta)
                coll_copy(scratch, output, coll_payload(meta))
                return true
            }
            coll_slot_drop(scratch, iter_meta(source))
        }
        return false
    }
    if (kind == I64{11}) {
        if (index == I64{0}) {
            trap_store(node + I64{40}, I64{1})
            return iter_pull(source, output)
        }
        if (trap_word(node + I64{128}) != I64{0}) {
            trap_store(node + I64{128}, I64{0})
            coll_copy(scratch, output, coll_payload(meta))
            return true
        }
        if !iter_pull(source, scratch) -> return false
        trap_store(node + I64{128}, I64{1})
        coll_slot_clone(trap_word(node + I64{96}), output, meta)
        return true
    }
    if (kind == I64{12} || kind == I64{13}) { return iter_pull_nested(node, output) }
    if (kind == I64{14}) {
        loop {
            inner :: trap_word(node + I64{24})
            if (inner != I64{0}) {
                if iter_pull(inner, output) -> return true
                jet_rt_native_iter_drop(inner)
                trap_store(node + I64{24}, I64{0})
            }
            if !iter_pull(source, scratch) -> return false
            nested_meta :: iter_meta(source)
            inner_meta :: trap_word(nested_meta + I64{56})
            nested :: jet_rt_native_iter_from_list(scratch, inner_meta, I64{1})
            trap_store(nested + I64{128}, I64{1})
            trap_store(node + I64{24}, nested)
        }
    }
    if (kind == I64{15}) {
        child :: trap_word(meta + I64{56})
        slot :: coll_slot_new(child)
        if !iter_pull(source, slot) {
            jet_rt_free(slot, coll_size(child), I64{8})
            return false
        }
        trap_store(output, slot)
        return true
    }
    if (kind == I64{16}) {
        if !iter_pull(source, scratch) -> return false
        old :: trap_word(node + I64{96})
        _ := iter_binary(node, old, scratch, second)
        coll_slot_drop(scratch, iter_meta(source))
        if (jet_rt_session_propagate() != I64{0}) { return false }
        coll_slot_drop(old, meta)
        coll_copy(second, old, coll_payload(meta))
        coll_slot_clone(old, output, meta)
        return true
    }
    if (kind == I64{17} || kind == I64{18} || kind == I64{19}) {
        return iter_pull_zip(node, output)
    }
    if (kind == I64{20}) {
        if !iter_pull(source, scratch) -> return false
        word :: trap_word(node + I64{120})
        trap_store(word, jet_int_owned_from_i64(index))
        _ := iter_binary(node, word, scratch, output)
        int_discard(trap_word(word))
        coll_slot_drop(scratch, iter_meta(source))
        trap_store(node + I64{40}, index + I64{1})
        return jet_rt_session_propagate() == I64{0}
    }
    if (kind == I64{21}) {
        header :: trap_word(node + I64{112})
        length :: trap_word(header)
        if (index >= count || length == I64{0}) { return false }
        coll_slot_clone(trap_word(header + I64{16}) + (index % length) * trap_word(meta), output, meta)
        trap_store(node + I64{40}, index + I64{1})
        return true
    }
    if (kind == I64{26}) { return iter_pull_filter_map(node, output) }
    if (kind == I64{27}) {
        if !iter_pull(source, output) {
            jet_rt_progress_state_finish(trap_word(node + I64{152}))
            return false
        }
        jet_rt_progress_state_advance(trap_word(node + I64{152}))
        if (jet_rt_session_propagate() != I64{0}) {
            coll_slot_drop(output, meta)
            return false
        }
        return true
    }
    trap_defect_prepare()
    trap_msg_unreachable()
    trap_defect_exit(I64{101})
    return false
}

fn iter_pull(node: I64, output: I64) -> Bool {
    if !iter_pull_kernel(node, output) -> return false
    // Internal map/list nodes implement one public flat-map/flatten adapter;
    // they are not additional inspected handles in the reference runtime.
    if ((trap_word(node) == I64{0} || trap_word(node) == I64{6}) && trap_word(node + I64{128}) != I64{0}) {
        return true
    }
    if (jet_rt_iter_charge() != I64{0}) {
        coll_slot_drop(output, iter_meta(node))
        return false
    }
    true
}

fn iter_pull_nested(node: I64, output: I64) -> Bool {
    source :: trap_word(node + I64{16})
    scratch :: trap_word(node + I64{80})
    element :: iter_meta(source)
    count :: trap_word(node + I64{32})
    header :: trap_word(node + I64{112})
    windows :: trap_word(node) == I64{13}
    if !windows -> coll_zero(header, I64{24})
    loop trap_word(header) < count {
        if !iter_pull(source, scratch) -> break
        coll_list_push(header, scratch, element)
    }
    if (jet_rt_session_propagate() != I64{0}) {
        coll_list_drop(header, element, I64{0})
        return false
    }
    length :: trap_word(header)
    if (length == I64{0} || (windows && length != count)) { return false }
    if !windows {
        coll_copy(header, output, I64{24})
        coll_zero(header, I64{24})
        return true
    }
    coll_zero(output, I64{24})
    at := I64{0}
    data :: trap_word(header + I64{16})
    stride :: trap_word(element)
    loop at < length {
        coll_slot_clone(data + at * stride, scratch, element)
        coll_list_push(output, scratch, element)
        at += I64{1}
    }
    coll_slot_drop(data, element)
    at = I64{1}
    loop at < length {
        coll_copy(data + at * stride, data + (at - I64{1}) * stride, coll_payload(element))
        at += I64{1}
    }
    trap_store(header, length - I64{1})
    true
}

// `by_value` 1 hands the Iter the header at `source` (left zeroed): its
// elements move into the Iter when the header owns its buffer alone. A buffer
// another owner shares (copy-on-write: a List clone, or an element
// List of one) or a frozen one (cap 0 over read-only data) keeps its elements
// for those owners; the Iter pulls clones and the header gives up its
// reference, as by_value 0 leaves the source untouched.
#Export(c) fn jet_rt_native_iter_from_list(source: I64, meta: I64, by_value: I64) -> I64 {
    node :: iter_new(I64{0}, meta)
    header :: coll_list_new()
    trap_store(node + I64{112}, header)
    if (by_value != I64{0} && iter_list_sole(source)) {
        coll_copy(source, header, I64{24})
        coll_zero(source, I64{24})
        return node
    }
    scratch :: coll_slot_new(meta)
    at := I64{0}
    loop at < trap_word(source) {
        coll_slot_clone(trap_word(source + I64{16}) + at * trap_word(meta), scratch, meta)
        coll_list_push(header, scratch, meta)
        at += I64{1}
    }
    jet_rt_free(scratch, coll_size(meta), I64{8})
    if (by_value != I64{0}) { iter_list_release(source, meta) }
    node
}

// Whether the List header at `source` may give its elements away: its owned
// buffer has no other owner, or it holds nothing (an empty frozen header).
fn iter_list_sole(source: I64) -> Bool {
    if (trap_word(source + I64{8}) == I64{0}) -> return trap_word(source) == I64{0}
    jet_rt_block_unique(trap_word(source + I64{16}))
}

// The header at `source` gives up its reference to the buffer it shares: the
// last owner drops the elements and frees it; a frozen buffer is never released.
fn iter_list_release(source: I64, meta: I64) {
    if (trap_word(source + I64{8}) != I64{0} && jet_rt_block_release(trap_word(source + I64{16}))) {
        coll_list_drop(source, meta, I64{0})
    }
    coll_zero(source, I64{24})
}

#Export(c) fn jet_rt_native_iter_drop(node: I64) {
    if (node == I64{0}) {
        return
    }
    kind :: trap_word(node)
    meta :: iter_meta(node)
    source :: trap_word(node + I64{16})
    context :: trap_word(node + I64{152})
    if (kind == I64{18}) {
        coll_slot_free(trap_word(context), iter_meta(source))
        coll_slot_free(trap_word(context + I64{8}), iter_meta(trap_word(node + I64{24})))
        jet_rt_free(context, I64{16}, I64{8})
    }
    if (kind == I64{19}) {
        jet_rt_string_drop(trap_word(context))
        jet_rt_string_drop(trap_word(context + I64{8}))
        jet_rt_string_drop(trap_word(context + I64{24}))
        jet_rt_string_drop(trap_word(context + I64{32}))
        jet_rt_free(context, I64{56}, I64{8})
    }
    if (kind == I64{27}) { jet_rt_progress_state_drop(context) }
    if (kind == I64{20}) { jet_rt_free(trap_word(node + I64{120}), I64{8}, I64{8}) }
    if (kind == I64{26} && trap_word(node + I64{120}) != I64{0}) {
        jet_rt_free(trap_word(node + I64{120}), coll_size(trap_word(trap_word(node + I64{72}) + I64{64})), I64{8})
    }
    if (kind == I64{28}) { jet_rt_native_receiver_drop(source) } else if (kind == I64{25}) { text_iter_drop(source) } else if (source != I64{0}) {
        scratch :: trap_word(node + I64{80})
        if (scratch != I64{0}) {
            if (kind == I64{11} && trap_word(node + I64{128}) != I64{0}) {
                coll_slot_drop(scratch, iter_meta(source))
            }
            jet_rt_free(scratch, coll_size(iter_meta(source)), I64{8})
        }
        jet_rt_native_iter_drop(source)
    }
    other :: trap_word(node + I64{24})
    if (other != I64{0}) { jet_rt_native_iter_drop(other) }
    second :: trap_word(node + I64{88})
    callback_meta :: trap_word(node + I64{72})
    if (second != I64{0}) { jet_rt_free(second, trap_word(node + I64{136}), I64{8}) }
    iter_saved_clear(node)
    coll_meta_drop(trap_word(node + I64{104}))
    header :: trap_word(node + I64{112})
    if (header != I64{0}) {
        element :: if (kind == I64{12} || kind == I64{13}) -> trap_word(meta + I64{56}) else -> meta
        coll_list_drop(header, element, if (kind == I64{0}) -> trap_word(node + I64{40}) else -> I64{0})
        jet_rt_free(header, I64{24}, I64{8})
    }
    release :: trap_word(node + I64{64})
    if (release != I64{0}) {
        jet_rt_session_shield_enter()
        coll_call1_unit(release, trap_word(node + I64{48}))
        jet_rt_session_shield_leave()
    }
    coll_meta_drop(callback_meta)
    coll_meta_drop(meta)
    jet_rt_free(node, I64{160}, I64{8})
}

#Export(c) fn jet_rt_native_iter_to_list(iter: I64, target: I64) {
    iter_drain(iter, target)
    jet_rt_native_iter_drop(iter)
}

#Export(c) fn jet_rt_native_iter_next(iter: I64) -> I64 {
    meta :: iter_meta(iter)
    slot :: coll_slot_new(meta)
    if iter_pull(iter, slot) -> return slot
    jet_rt_free(slot, coll_size(meta), I64{8})
    I64{0}
}

#Export(c) fn jet_rt_native_iter_first(iter: I64) -> I64 {
    slot :: jet_rt_native_iter_next(iter)
    jet_rt_native_iter_drop(iter)
    slot
}

#Export(c) fn jet_rt_native_iter_len(iter: I64) -> I64 {
    meta :: iter_meta(iter)
    slot :: coll_slot_new(meta)
    count := I64{0}
    loop iter_pull(iter, slot) {
        coll_slot_drop(slot, meta)
        count += I64{1}
    }
    jet_rt_free(slot, coll_size(meta), I64{8})
    jet_rt_native_iter_drop(iter)
    count
}

#Export(c) fn jet_rt_native_iter_is_empty(iter: I64) -> I64 {
    // The reference consumes the iterator, but probes just its first item.
    meta :: iter_meta(iter)
    slot :: coll_slot_new(meta)
    present :: iter_pull(iter, slot)
    if present -> coll_slot_drop(slot, meta)
    jet_rt_free(slot, coll_size(meta), I64{8})
    jet_rt_native_iter_drop(iter)
    if present -> I64{0} else -> I64{1}
}

#Export(c) fn jet_rt_native_iter_empty(meta: I64) -> I64 { iter_new(I64{1}, meta) }

#Export(c) fn jet_rt_native_iter_indexes(count: I64, meta: I64) -> I64 {
    node :: iter_new(I64{2}, meta)
    trap_store(node + I64{32}, count)
    node
}

// Owning constructors discard their adopted source on a returned Root stop.
// Its release callbacks execute in the actual stopped cleanup, not the
// constructor's normal body or a constructor-static Task context.
fn iter_discard_stopped_source(source: I64) {
    saved :: jet_rt_session_cleanup_enter(jet_rt_session_status())
    jet_rt_native_iter_drop(source)
    jet_rt_session_cleanup_leave(saved)
}

#Export(c) fn jet_rt_native_iter_take(source: I64, count: I64) -> I64 {
    if (count < I64{0}) {
        iter_argument_stop(I64{0})
        iter_discard_stopped_source(source)
        return I64{0}
    }
    node :: iter_wrap(I64{3}, source, iter_meta(source))
    trap_store(node + I64{32}, count)
    node
}

#Export(c) fn jet_rt_native_iter_skip(source: I64, count: I64) -> I64 {
    if (count < I64{0}) {
        iter_argument_stop(I64{0})
        iter_discard_stopped_source(source)
        return I64{0}
    }
    node :: iter_wrap(I64{4}, source, iter_meta(source))
    trap_store(node + I64{32}, count)
    node
}

#Export(c) fn jet_rt_native_iter_step_by(source: I64, count: I64) -> I64 {
    if (count <= I64{0}) {
        iter_argument_stop(I64{1})
        iter_discard_stopped_source(source)
        return I64{0}
    }
    node :: iter_wrap(I64{5}, source, iter_meta(source))
    trap_store(node + I64{32}, count)
    node
}

#Export(c) fn jet_rt_native_iter_map(source: I64, env: I64, invoke: I64, release: I64, meta: I64) -> I64 {
    iter_callback(I64{6}, source, env, invoke, release, meta, meta)
}

#Export(c) fn jet_rt_native_iter_map_mut(source: I64, env: I64, invoke: I64, release: I64, meta: I64) -> I64 {
    iter_callback(I64{6}, source, env, invoke, release, meta, meta)
}

#Export(c) fn jet_rt_native_iter_filter(source: I64, env: I64, invoke: I64, release: I64, meta: I64) -> I64 {
    iter_callback(I64{7}, source, env, invoke, release, meta, iter_meta(source))
}

#Export(c) fn jet_rt_native_iter_take_while(source: I64, env: I64, invoke: I64, release: I64, meta: I64) -> I64 {
    iter_callback(I64{8}, source, env, invoke, release, meta, iter_meta(source))
}

#Export(c) fn jet_rt_native_iter_skip_while(source: I64, env: I64, invoke: I64, release: I64, meta: I64) -> I64 {
    iter_callback(I64{9}, source, env, invoke, release, meta, iter_meta(source))
}

#Export(c) fn jet_rt_native_iter_dedup(source: I64, meta: I64) -> I64 {
    iter_wrap(I64{10}, source, meta)
}

#Export(c) fn jet_rt_native_iter_intersperse(source: I64, separator: I64, meta: I64, by_value: I64) -> I64 {
    node :: iter_wrap(I64{11}, source, meta)
    saved :: coll_slot_new(meta)
    if (by_value != I64{0}) { coll_copy(separator, saved, coll_payload(meta)) } else {
        coll_slot_clone(separator, saved, meta)
    }
    trap_store(node + I64{96}, saved)
    trap_store(node + I64{104}, coll_meta_copy(meta))
    node
}

fn iter_nested(kind: I64, source: I64, count: I64, meta: I64) -> I64 {
    if (count <= I64{0}) {
        iter_argument_stop(if (kind == I64{12}) -> I64{2} else -> I64{3})
        iter_discard_stopped_source(source)
        return I64{0}
    }
    node :: iter_wrap(kind, source, meta)
    trap_store(node + I64{32}, count)
    trap_store(node + I64{112}, coll_list_new())
    node
}

#Export(c) fn jet_rt_native_iter_chunks(source: I64, count: I64, meta: I64) -> I64 {
    iter_nested(I64{12}, source, count, meta)
}

#Export(c) fn jet_rt_native_iter_windows(source: I64, count: I64, meta: I64) -> I64 {
