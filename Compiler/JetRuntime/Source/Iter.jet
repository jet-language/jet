    trap_store(node + I64{96}, saved)
    trap_store(node + I64{104}, coll_meta_copy(seed_meta))
    node
}

fn iter_collect_node(source: I64) -> I64 {
    meta :: iter_meta(source)
    node :: iter_new(I64{0}, meta)
    header :: coll_list_new()
    iter_drain(source, header)
    trap_store(node + I64{112}, header)
    jet_rt_native_iter_drop(source)
    if (jet_rt_session_propagate() != I64{0}) {
        jet_rt_native_iter_drop(node)
        return I64{0}
    }
    node
}

fn iter_repeat(source: I64, count: I64, loops: Bool) -> I64 {
    node :: iter_collect_node(source)
    if (node == I64{0}) { return I64{0} }
    length :: trap_word(trap_word(node + I64{112}))
    times :: if (count < I64{0}) -> I64{0} else -> count
    trap_store(node, I64{21})
    trap_store(node + I64{32}, if (length == I64{0}) -> I64{0} else if loops -> length * times else -> times)
    trap_store(node + I64{128}, if loops -> I64{1} else -> I64{0})
    node
}

#Export(c) fn jet_rt_native_iter_repeat(source: I64, count: I64) -> I64 {
    iter_repeat(source, count, true)
}

#Export(c) fn jet_rt_native_iter_cycle(source: I64, count: I64) -> I64 {
    iter_repeat(source, count, false)
}

#Export(c) fn jet_rt_native_iter_drop_last(source: I64, count: I64) -> I64 {
    node :: iter_collect_node(source)
    if (node == I64{0}) { return I64{0} }
    header :: trap_word(node + I64{112})
    length :: trap_word(header)
    removed :: if (count < I64{0}) -> I64{0} else if count > length -> length else -> count
    kept :: length - removed
    meta :: iter_meta(node)
    at := kept
    loop at < length {
        coll_slot_drop(trap_word(header + I64{16}) + at * trap_word(meta), meta)
        at += I64{1}
    }
    trap_store(header, kept)
    node
}

#Export(c) fn jet_rt_native_iter_shuffle(source: I64) -> I64 {
    node :: iter_collect_node(source)
    if (node == I64{0}) { return I64{0} }
    header :: trap_word(node + I64{112})
    meta :: iter_meta(node)
    scratch :: coll_slot_new(meta)
    stride :: trap_word(meta)
    data :: trap_word(header + I64{16})
    state := U64{3237998146}
    at := trap_word(header) - I64{1}
    loop at > (I64{0}) {
        state = wrapping(state * U64{6364136223846793005} + U64{1})
        other :: I64{(state >> U64{33}) % U64{at + I64{1}}}
        coll_copy(data + at * stride, scratch, coll_payload(meta))
        coll_copy(data + other * stride, data + at * stride, coll_payload(meta))
        coll_copy(scratch, data + other * stride, coll_payload(meta))
        at -= I64{1}
    }
    jet_rt_free(scratch, coll_size(meta), I64{8})
    node
}

#Export(c) fn jet_rt_native_iter_split_at(source: I64, count: I64, target: I64, left: I64, right: I64) {
    meta :: iter_meta(source)
    slot :: coll_slot_new(meta)
    coll_zero(target + left, I64{24})
    coll_zero(target + right, I64{24})
    at := I64{0}
    loop iter_pull(source, slot) {
        coll_list_push(if at < count -> target + left else -> target + right, slot, meta)
        at += I64{1}
    }
    if (jet_rt_session_propagate() != I64{0}) {
        coll_list_drop(target + left, meta, I64{0})
        coll_list_drop(target + right, meta, I64{0})
    }
    jet_rt_free(slot, coll_size(meta), I64{8})
    jet_rt_native_iter_drop(source)
}

#Export(c) fn jet_rt_native_iter_join(source: I64, separator: I64, meta: I64) -> I64 {
    builder :: jet_rt_string_builder_new()
    slot :: coll_slot_new(iter_meta(source))
    at := I64{0}
    loop iter_pull(source, slot) {
        if (at != I64{0}) { jet_rt_string_builder_push(builder, separator) }
        text :: coll_call1(trap_word(meta + I64{24}), slot)
        if (jet_rt_session_propagate() != I64{0}) {
            coll_slot_drop(slot, iter_meta(source))
            break
        }
        jet_rt_string_builder_push(builder, text)
        jet_rt_string_drop(text)
        coll_slot_drop(slot, iter_meta(source))
        at += I64{1}
    }
    jet_rt_free(slot, coll_size(iter_meta(source)), I64{8})
    jet_rt_native_iter_drop(source)
    result :: jet_rt_string_builder_finish(builder)
    if (jet_rt_session_propagate() != I64{0}) {
        jet_rt_string_drop(result)
        return I64{0}
    }
    result
}

#Export(c) fn jet_rt_native_iter_compare(source: I64, other: I64, meta: I64, by_value: I64) -> I64 {
    // The reference snapshots the second list before comparing lazily.
    b :: jet_rt_native_iter_from_list(other, meta, by_value)
    a_slot :: coll_slot_new(iter_meta(source))
    b_slot :: coll_slot_new(meta)
    order := I64{0}
    loop {
        a_present :: iter_pull(source, a_slot)
        b_present :: iter_pull(b, b_slot)
        if (a_present && b_present) {
            order = iter_order(meta, a_slot, b_slot)
            coll_slot_drop(a_slot, iter_meta(source))
            coll_slot_drop(b_slot, meta)
            if (order != I64{0}) { break }
        } else {
            if a_present {
                coll_slot_drop(a_slot, iter_meta(source))
                order = I64{1}
            }
            if b_present {
                coll_slot_drop(b_slot, meta)
                order = I64{-1}
            }
            break
        }
    }
    jet_rt_free(a_slot, coll_size(iter_meta(source)), I64{8})
    jet_rt_free(b_slot, coll_size(meta), I64{8})
    jet_rt_native_iter_drop(source)
    jet_rt_native_iter_drop(b)
    if (order < I64{0}) -> I64{-1} else if (order > I64{0}) -> I64{1} else -> I64{0}
}

#Export(c) fn jet_rt_native_iter_last_index_of(source: I64, needle: I64, meta: I64, by_value: I64) -> I64 {
    node :: iter_collect_node(source)
    if (node == I64{0}) {
        if (by_value != I64{0}) { coll_slot_drop(needle, meta) }
        return I64{0}
    }
    slot :: coll_slot_new(meta)
    if (by_value != I64{0}) { coll_copy(needle, slot, coll_payload(meta)) } else {
        coll_slot_clone(needle, slot, meta)
    }
    header :: trap_word(node + I64{112})
    at := trap_word(header)
    found := I64{-1}
    loop at > (I64{0}) {
        at -= I64{1}
        if iter_equal(meta, trap_word(header + I64{16}) + at * trap_word(meta), slot) {
            found = at
            break
        }
    }
    coll_slot_free(slot, meta)
    jet_rt_native_iter_drop(node)
    if (found < I64{0}) { return I64{0} }
    result :: jet_rt_alloc(I64{8}, I64{8})
    trap_store(result, jet_int_owned_from_i64(found))
    result
}

#Export(c) fn jet_rt_native_iter_is_sorted(source: I64, meta: I64) -> I64 {
    node :: iter_collect_node(source)
    if (node == I64{0}) { return I64{0} }
    header :: trap_word(node + I64{112})
    data :: trap_word(header + I64{16})
    stride :: trap_word(meta)
    at := I64{1}
    sorted := I64{1}
    loop at < trap_word(header) {
        if (iter_order(meta, data + (at - I64{1}) * stride, data + at * stride) > I64{0}) {
            sorted = I64{0}
            break
        }
        at += I64{1}
    }
    jet_rt_native_iter_drop(node)
    sorted
}

fn iter_eager_callback(source: I64, env: I64, invoke: I64, release: I64, meta: I64) -> I64 {
    // Dedup_by and sorted_by invoke keys only after fully consuming the input.
    node :: iter_collect_node(source)
    if (node == I64{0}) {
        if (release != I64{0}) {
            jet_rt_session_shield_enter()
            coll_call1_unit(release, env)
            jet_rt_session_shield_leave()
        }
        return I64{0}
    }
    trap_store(node + I64{48}, env)
    trap_store(node + I64{56}, invoke)
    trap_store(node + I64{64}, release)
    trap_store(node + I64{72}, coll_meta_copy(meta))
    trap_store(node + I64{88}, coll_slot_new(meta))
    trap_store(node + I64{136}, coll_size(meta))
    node
}

#Export(c) fn jet_rt_native_iter_dedup_by(source: I64, env: I64, invoke: I64, release: I64, meta: I64) -> I64 {
    node :: iter_eager_callback(source, env, invoke, release, meta)
    if (node == I64{0}) { return I64{0} }
    header :: trap_word(node + I64{112})
    data :: trap_word(header + I64{16})
    element :: iter_meta(node)
    stride :: trap_word(element)
    key :: trap_word(node + I64{88})
    previous :: coll_slot_new(meta)
    at := I64{0}
    used := I64{0}
    have_previous := false
    loop at < trap_word(header) && jet_rt_session_propagate() == (I64{0}) {
        slot :: data + at * stride
        if !iter_unary(node, slot, key) -> break
        same :: have_previous && iter_equal(meta, previous, key)
        if !same {
            if have_previous -> coll_slot_drop(previous, meta)
            coll_copy(key, previous, coll_payload(meta))
            have_previous = true
            coll_copy(slot, data + used * stride, coll_payload(element))
            used += I64{1}
        } else {
            coll_slot_drop(key, meta)
            coll_slot_drop(slot, element)
        }
        at += I64{1}
    }
    // A stopped callback has not initialized key; only remaining input drops.
    loop at < trap_word(header) {
        coll_slot_drop(data + at * stride, element)
        at += I64{1}
    }
    if have_previous -> coll_slot_drop(previous, meta)
    jet_rt_free(previous, coll_size(meta), I64{8})
    trap_store(header, used)
    if (jet_rt_session_propagate() != I64{0}) {
        jet_rt_native_iter_drop(node)
        return I64{0}
    }
    iter_release_callback(node)
    node
}

#Export(c) fn jet_rt_native_iter_is_sorted_by(source: I64, env: I64, invoke: I64, release: I64, meta: I64) -> I64 {
    node :: iter_eager_callback(source, env, invoke, release, meta)
    if (node == I64{0}) { return I64{0} }
    header :: trap_word(node + I64{112})
    data :: trap_word(header + I64{16})
    stride :: trap_word(iter_meta(node))
    a :: trap_word(node + I64{88})
    b :: coll_slot_new(meta)
    at := I64{1}
    result := I64{1}
    loop at < trap_word(header) && jet_rt_session_propagate() == (I64{0}) {
        if !iter_unary(node, data + (at - I64{1}) * stride, a) {
            result = I64{0}
            break
        }
        if !iter_unary(node, data + at * stride, b) {
            coll_slot_drop(a, meta)
            result = I64{0}
            break
        }
        order :: iter_order(meta, a, b)
        coll_slot_drop(a, meta)
        coll_slot_drop(b, meta)
        if (order > I64{0}) {
            result = I64{0}
            break
        }
        at += I64{1}
    }
    jet_rt_free(b, coll_size(meta), I64{8})
    jet_rt_native_iter_drop(node)
    result
}

fn iter_release_callback(node: I64) {
    release :: trap_word(node + I64{64})
    if (release != I64{0}) {
        jet_rt_session_shield_enter()
        coll_call1_unit(release, trap_word(node + I64{48}))
        jet_rt_session_shield_leave()
        trap_store(node + I64{64}, I64{0})
    }
}

#Export(c) fn jet_rt_native_iter_flat_map(source: I64, env: I64, invoke: I64, release: I64, meta: I64) -> I64 {
    mapped :: jet_rt_native_iter_map(source, env, invoke, release, meta)
    trap_store(mapped + I64{128}, I64{1})
    jet_rt_native_iter_flatten(mapped, trap_word(meta + I64{56}))
}

#Export(c) fn jet_rt_native_iter_filter_map(source: I64, env: I64, invoke: I64, release: I64, meta: I64) -> I64 {
    node :: iter_callback(I64{26}, source, env, invoke, release, meta, trap_word(meta + I64{56}))
    if ((trap_word(meta + I64{48}).bit_and(I64{4294967295})) != I64{7}) {
        trap_store(node + I64{120}, coll_slot_new(trap_word(meta + I64{64})))
    }
    node
}

// Unbox one initialized failure carrier into target (an Ok/present payload)
// or error (an Err payload). Returns 1=success, 0=failure.
fn iter_unbox(carrier_slot: I64, carrier: I64, target: I64, error: I64) -> Bool {
    raw :: trap_word(carrier_slot)
    optional :: (trap_word(carrier + I64{48}).bit_and(I64{4294967295})) == I64{7}
    ok :: trap_word(carrier + I64{56})
    if optional {
        if (raw == I64{0}) { return false }
        iter_box_take(raw, I64{0}, coll_size(ok), target, ok)
        return true
    }
    err :: trap_word(carrier + I64{64})
    success :: trap_word(raw) != I64{0}
    iter_box_take(raw, I64{8}, coll_result_size(ok, err), if success -> target else -> error, if success -> ok else -> err)
    success
}

// Takes the payload of `meta` at `raw + offset` out of the carrier box `raw`
// of `size` bytes into `target`, consuming the carrier's reference (Refcount.jet).
// A box the carrier owns alone gives its payload up and is freed without
// dropping it. A box other owners share (a clone of a List element) or a
// frozen one keeps its payload for them: target gets a clone, and the box
// loses this owner; the last owner drops the payload and frees it.
fn iter_box_take(raw: I64, offset: I64, size: I64, target: I64, meta: I64) {
    if jet_rt_block_unique(raw) {
        coll_copy(raw + offset, target, coll_payload(meta))
        jet_rt_free(raw, size, I64{8})
        return
    }
    coll_slot_clone(raw + offset, target, meta)
    if jet_rt_block_release(raw) {
        coll_slot_drop(raw + offset, meta)
        jet_rt_free(raw, size, I64{8})
    }
}

fn iter_pull_filter_map(node: I64, output: I64) -> Bool {
    source :: trap_word(node + I64{16})
    input :: trap_word(node + I64{80})
    result :: trap_word(node + I64{88})
    carrier :: trap_word(node + I64{72})
    optional :: (trap_word(carrier + I64{48}).bit_and(I64{4294967295})) == I64{7}
    error_meta :: trap_word(carrier + I64{64})
    error :: trap_word(node + I64{120})
    loop iter_pull(source, input) {
        ready :: iter_unary(node, input, result)
        coll_slot_drop(input, iter_meta(source))
        if !ready -> break
        if iter_unbox(result, carrier, output, error) -> return true
        if !optional -> coll_slot_drop(error, error_meta)
    }
    false
}

fn iter_zip(kind: I64, a: I64, b: I64, env: I64, invoke: I64, release: I64, meta: I64) -> I64 {
    node :: iter_callback(kind, a, env, invoke, release, meta, meta)
    trap_store(node + I64{24}, b)
    // Binary adapters write the result directly; second scratch holds B.
    jet_rt_free(trap_word(node + I64{88}), coll_size(meta), I64{8})
    trap_store(node + I64{88}, coll_slot_new(iter_meta(b)))
    trap_store(node + I64{136}, coll_size(iter_meta(b)))
    node
}

fn iter_pull_zip(node: I64, output: I64) -> Bool {
    kind :: trap_word(node)
    a :: trap_word(node + I64{16})
    b :: trap_word(node + I64{24})
    x :: trap_word(node + I64{80})
    y :: trap_word(node + I64{88})
    a_present :: iter_pull(a, x)
    if (jet_rt_session_propagate() != I64{0}) {
        if a_present -> coll_slot_drop(x, iter_meta(a))
        return false
    }
    if (!a_present && kind == I64{17}) { return false }
    b_present :: iter_pull(b, y)
    if (jet_rt_session_propagate() != I64{0}) {
        if a_present -> coll_slot_drop(x, iter_meta(a))
        if b_present -> coll_slot_drop(y, iter_meta(b))
        return false
    }
    if (kind == I64{19} && a_present != b_present) {
        iter_zip_stop(trap_word(node + I64{152}))
        saved :: jet_rt_session_cleanup_enter(jet_rt_session_status())
        if a_present -> coll_slot_drop(x, iter_meta(a))
        if b_present -> coll_slot_drop(y, iter_meta(b))
        jet_rt_session_cleanup_leave(saved)
        return false
    }
    if (!a_present && !b_present) { return false }
    if (kind == I64{17} && !b_present) {
        coll_slot_drop(x, iter_meta(a))
        return false
    }
    if (kind == I64{18}) {
        context :: trap_word(node + I64{152})
        if !a_present -> coll_slot_clone(trap_word(context), x, iter_meta(a))
        if !b_present -> coll_slot_clone(trap_word(context + I64{8}), y, iter_meta(b))
    }
    moved :: iter_binary(node, x, y, output)
    if ((moved.bit_and(I64{1})) == I64{0}) { coll_slot_drop(x, iter_meta(a)) }
    if ((moved.bit_and(I64{2})) == I64{0}) { coll_slot_drop(y, iter_meta(b)) }
    jet_rt_session_propagate() == I64{0}
}

#Export(c) fn jet_rt_native_iter_zip(a: I64, b: I64, env: I64, invoke: I64, release: I64, meta: I64) -> I64 {
    iter_zip(I64{17}, a, b, env, invoke, release, meta)
}

#Export(c) fn jet_rt_native_iter_zip_pad(a: I64, b: I64, fill_a: I64, fill_b: I64, env: I64, invoke: I64, release: I64, meta: I64, a_meta: I64, b_meta: I64, a_by_value: I64, b_by_value: I64) -> I64 {
    node :: iter_zip(I64{18}, a, b, env, invoke, release, meta)
    context :: jet_rt_alloc(I64{16}, I64{8})
    x :: coll_slot_new(a_meta)
    y :: coll_slot_new(b_meta)
    if (a_by_value != I64{0}) { coll_copy(fill_a, x, coll_payload(a_meta)) } else {
        coll_slot_clone(fill_a, x, a_meta)
    }
    if (b_by_value != I64{0}) { coll_copy(fill_b, y, coll_payload(b_meta)) } else {
        coll_slot_clone(fill_b, y, b_meta)
    }
    trap_store(context, x)
    trap_store(context + I64{8}, y)
    trap_store(node + I64{152}, context)
    node
}

#Export(c) fn jet_rt_native_iter_zip_strict(a: I64, b: I64, env: I64, invoke: I64, release: I64, meta: I64, policy: I64, file: I64, line: I64, function: I64, source_line: I64, col: I64, caret: I64) -> I64 {
    node :: iter_zip(I64{19}, a, b, env, invoke, release, meta)
    context :: jet_rt_alloc(I64{56}, I64{8})
    trap_store(context, jet_rt_string_clone(policy))
    trap_store(context + I64{8}, jet_rt_string_clone(file))
    trap_store(context + I64{16}, line)
    trap_store(context + I64{24}, jet_rt_string_clone(function))
    trap_store(context + I64{32}, jet_rt_string_clone(source_line))
    trap_store(context + I64{40}, col)
    trap_store(context + I64{48}, caret)
    trap_store(node + I64{152}, context)
    node
}

fn iter_try_callback(source: I64, env: I64, invoke: I64, release: I64, carrier: I64, filter: Bool) -> I64 {
    node :: iter_callback(I64{6}, source, env, invoke, release, carrier, carrier)
    input_meta :: iter_meta(source)
    output_meta :: if filter -> input_meta else -> trap_word(carrier + I64{56})
    optional :: (trap_word(carrier + I64{48}).bit_and(I64{4294967295})) == I64{7}
    error_meta :: trap_word(carrier + I64{64})
    input :: trap_word(node + I64{80})
    raw_result :: trap_word(node + I64{88})
    value :: coll_slot_new(trap_word(carrier + I64{56}))
    error :: if optional -> I64{0} else -> coll_slot_new(error_meta)
    header :: coll_list_new()
    success := true
    stopped := false
    loop iter_pull(source, input) {
        if !iter_unary(node, input, raw_result) {
            coll_slot_drop(input, input_meta)
            stopped = true
            break
        }
        if !iter_unbox(raw_result, carrier, value, error) {
            coll_slot_drop(input, input_meta)
            success = false
            break
        }
        if filter {
            if (trap_byte(value) != I64{0}) { coll_list_push(header, input, input_meta) } else {
                coll_slot_drop(input, input_meta)
            }
            coll_slot_drop(value, trap_word(carrier + I64{56}))
        } else {
            coll_slot_drop(input, input_meta)
            coll_list_push(header, value, output_meta)
        }
    }
    stopped = stopped || jet_rt_session_propagate() != I64{0}
    jet_rt_free(value, coll_size(trap_word(carrier + I64{56})), I64{8})
    result := I64{0}
    if (success && !stopped) {
        result_iter :: jet_rt_native_iter_from_list(header, output_meta, I64{1})
        if optional {
