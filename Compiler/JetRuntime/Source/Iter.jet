#Export(c) fn jet_rt_native_iter_scan(source: I64, seed: I64, seed_meta: I64, seed_by_value: I64, env: I64, invoke: I64, release: I64, meta: I64) -> I64 {
    node :: iter_callback(I64{16}, source, env, invoke, release, meta, meta)
    saved :: coll_slot_new(seed_meta)
    if (seed_by_value != I64{0}) { coll_copy(seed, saved, coll_payload(seed_meta)) } else {
        coll_slot_clone(seed, saved, seed_meta)
