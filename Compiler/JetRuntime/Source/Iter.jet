    trap_store(node + I64{16}, source)
    node
}

#Export(c) fn jet_rt_native_iter_enumerate(source: I64, env: I64, invoke: I64, release: I64, meta: I64) -> I64 {
    node :: iter_callback(I64{20}, source, env, invoke, release, meta, meta)
