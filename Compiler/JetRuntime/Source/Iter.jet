    } else {
        coll_list_drop(header, output_meta, I64{0})
        if (!optional && !stopped) {
            result = jet_rt_alloc(coll_result_size(trap_word(carrier + I64{56}), error_meta), I64{8})
            trap_store(result, I64{0})
            coll_copy(error, result + I64{8}, coll_payload(error_meta))
