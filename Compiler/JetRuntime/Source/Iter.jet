#Export(c) fn jet_rt_native_iter_try_collect(source: I64, list_meta: I64, error_meta: I64) -> I64 {
    carrier :: iter_meta(source)
    element :: trap_word(list_meta + I64{56})
    slot :: coll_slot_new(carrier)
    value :: coll_slot_new(element)
    optional :: error_meta == I64{0}
    error :: if optional -> I64{0} else -> coll_slot_new(error_meta)
    header :: coll_list_new()
    success := true
    loop iter_pull(source, slot) {
        if !iter_unbox(slot, carrier, value, error) {
            success = false
            break
        }
        coll_list_push(header, value, element)
    }
    result := I64{0}
    stopped :: jet_rt_session_propagate() != I64{0}
    if !stopped {
        if optional {
            if success {
                result = coll_slot_new(list_meta)
                coll_copy(header, result, I64{24})
            }
        } else {
            result = jet_rt_alloc(coll_result_size(list_meta, error_meta), I64{8})
            trap_store(result, if success -> I64{1} else -> I64{0})
            coll_copy(if success -> header else -> error, result + I64{8}, coll_payload(if success -> list_meta else -> error_meta))
        }
    }
    if (!optional && !success && stopped) { coll_slot_drop(error, error_meta) }
    if (!success || stopped) { coll_list_drop(header, element, I64{0}) }
    jet_rt_free(header, I64{24}, I64{8})
    jet_rt_free(value, coll_size(element), I64{8})
    jet_rt_free(slot, coll_size(carrier), I64{8})
    if !optional -> jet_rt_free(error, coll_size(error_meta), I64{8})
    jet_rt_native_iter_drop(source)
    result
}

#Export(c) fn jet_rt_native_iter_chunk_while(source: I64, env: I64, invoke: I64, release: I64, meta: I64, list_meta: I64) -> I64 {
    node :: iter_eager_callback(source, env, invoke, release, meta)
    if (node == I64{0}) { return I64{0} }
    source_header :: trap_word(node + I64{112})
    element :: iter_meta(node)
    data :: trap_word(source_header + I64{16})
    stride :: trap_word(element)
    chunks :: coll_list_new()
    chunk :: coll_list_new()
    at := I64{0}
    loop at < trap_word(source_header) && jet_rt_session_propagate() == (I64{0}) {
        if (at != I64{0}) {
            _ := iter_binary(node, data + (at - I64{1}) * stride, data + at * stride, trap_word(node + I64{88}))
            if (jet_rt_session_propagate() != I64{0}) { break }
            keep :: trap_byte(trap_word(node + I64{88})) != I64{0}
            coll_slot_drop(trap_word(node + I64{88}), meta)
            if !keep {
                coll_list_push(chunks, chunk, list_meta)
                coll_zero(chunk, I64{24})
            }
        }
        coll_list_push(chunk, data + at * stride, element)
        at += I64{1}
    }
    stopped :: jet_rt_session_propagate() != I64{0}
    if {
        (!stopped && trap_word(chunk) != I64{0}) -> coll_list_push(chunks, chunk, list_meta)
        else -> coll_list_drop(chunk, element, I64{0})
    }
    // Only the unprocessed tail remains owned by the source list.
    trap_store(node + I64{40}, at)
