    if stopped -> coll_list_drop(chunks, list_meta, I64{0}) else {
        result = jet_rt_native_iter_from_list(chunks, list_meta, I64{1})
    }
    jet_rt_free(chunks, I64{24}, I64{8})
    jet_rt_free(chunk, I64{24}, I64{8})
    jet_rt_native_iter_drop(node)
    result
}

// Cursor is [iterator, current payload, stride, initialized, exhausted]. Init
// pulls once. A moved binding clears initialized, but advance still skips
// stride-1 elements and pulls the next item, exactly like LoopCursor.rs.
#Export(c) fn jet_rt_native_iter_cursor_init(source: I64, step: I64, has_step: I64) -> I64 {
    stride :: if (has_step == I64{0}) -> I64{1} else -> step
    if (stride <= I64{0}) {
        iter_argument_stop(I64{4})
        iter_discard_stopped_source(source)
        return I64{0}
    }
    cursor :: jet_rt_alloc(I64{40}, I64{8})
    slot :: coll_slot_new(iter_meta(source))
    trap_store(cursor, source)
    trap_store(cursor + I64{8}, slot)
    trap_store(cursor + I64{16}, stride)
    present :: iter_pull(source, slot)
    trap_store(cursor + I64{24}, if present -> I64{1} else -> I64{0})
    trap_store(cursor + I64{32}, if present -> I64{0} else -> I64{1})
    if (jet_rt_session_propagate() != I64{0}) {
        jet_rt_native_iter_cursor_drop(cursor)
        return I64{0}
    }
    cursor
}

#Export(c) fn jet_rt_native_iter_cursor_test(cursor: I64) -> I64 { trap_word(cursor + I64{24}) }

#Export(c) fn jet_rt_native_iter_cursor_value(cursor: I64, target: I64, by_value: I64) {
    if (trap_word(cursor + I64{24}) == I64{0}) {
        iter_argument_stop(I64{5})
        return
