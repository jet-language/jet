    source :: trap_word(cursor)
    coll_copy(trap_word(cursor + I64{8}), target, coll_payload(iter_meta(source)))
    if (by_value != I64{0}) { trap_store(cursor + I64{24}, I64{0}) }
}

#Export(c) fn jet_rt_native_iter_cursor_advance(cursor: I64) {
    if (trap_word(cursor + I64{32}) != I64{0}) {
        return
    }
    source :: trap_word(cursor)
    slot :: trap_word(cursor + I64{8})
    meta :: iter_meta(source)
    if (trap_word(cursor + I64{24}) != I64{0}) { coll_slot_drop(slot, meta) }
    trap_store(cursor + I64{24}, I64{0})
    skip := trap_word(cursor + I64{16}) - I64{1}
    loop skip > (I64{0}) {
        if !iter_pull(source, slot) {
            trap_store(cursor + I64{32}, I64{1})
            return
        }
        coll_slot_drop(slot, meta)
        skip -= I64{1}
    }
    present :: iter_pull(source, slot)
    trap_store(cursor + I64{24}, if present -> I64{1} else -> I64{0})
    trap_store(cursor + I64{32}, if present -> I64{0} else -> I64{1})
}

#Export(c) fn jet_rt_native_iter_cursor_drop(cursor: I64) {
    if (cursor == I64{0}) {
        return
    }
    source :: trap_word(cursor)
    meta :: iter_meta(source)
    slot :: trap_word(cursor + I64{8})
    if (trap_word(cursor + I64{24}) != I64{0}) { coll_slot_drop(slot, meta) }
    jet_rt_free(slot, coll_size(meta), I64{8})
    jet_rt_native_iter_drop(source)
    jet_rt_free(cursor, I64{40}, I64{8})
}

fn iter_argument_stop(kind: I64) {
    trap_header(I64{0})
    if {
        (kind == I64{0}) -> trap_msg_sequence_count()
        (kind == I64{1}) -> trap_msg_sequence_step()
        (kind == I64{2}) -> trap_msg_sequence_chunks()
        (kind == I64{3}) -> trap_msg_sequence_windows()
        (kind == I64{4}) -> trap_msg_cursor_step()
        else -> trap_msg_cursor_exhausted()
    }
    if (kind < I64{4}) { trap_msg_collections_end() } else { trap_msg_prelude_end() }
    trap_footer(I64{0})
}

fn iter_zip_stop(context: I64) {
    trap_root_prepare()
    trap_msg_header_zip()
    trap_write_handle(trap_word(context))
    trap_msg_zip_end()
    file :: trap_word(context + I64{8})
    function :: trap_word(context + I64{24})
    source :: trap_word(context + I64{32})
    trap_context(trap_word(file), trap_word(file + I64{8}), trap_word(context + I64{16}).bit_and(I64{4294967295}), trap_word(function), trap_word(function + I64{8}), trap_word(source), trap_word(source + I64{8}), trap_word(context + I64{40}).bit_and(I64{4294967295}), trap_word(context + I64{48}).bit_and(I64{4294967295}))
    trap_footer_e0128()
    jet_rt_process_exit_finish()
}

// Only sources whose Rust size_hint bounds agree supply a progress total.
// Custom chunks/windows/dedup/zip/split iterators intentionally have no hint.
fn iter_exact_length(node: I64) -> I64 {
    kind :: trap_word(node)
    index :: trap_word(node + I64{40})
    count :: trap_word(node + I64{32})
    if (kind == I64{3} && count == I64{0}) { return I64{0} }
    if (kind == I64{0}) { return trap_word(trap_word(node + I64{112})) - index }
    if (kind == I64{1}) { return I64{0} }
    if (kind == I64{2}) { return if count > index -> count - index else -> I64{0} }
    if (kind == I64{21}) {
        return if (trap_word(node + I64{128}) == I64{0} || count == I64{0}) -> count - index else -> I64{-1}
    }
    if (kind != I64{3} && kind != I64{4} && kind != I64{5} && kind != I64{6} && kind != I64{15} && kind != I64{16} && kind != I64{20} && kind != I64{27}) {
        return I64{-1}
    }
    length :: iter_exact_length(trap_word(node + I64{16}))
    if (length < I64{0}) { return I64{-1} }
    if (kind == I64{3}) { return if count < length -> count else -> length }
    if (kind == I64{4}) { return if length > count -> length - count else -> I64{0} }
    if (kind == I64{5}) {
        if (index != I64{0}) { return length /% count }
        return if (length == I64{0}) -> I64{0} else -> (length - I64{1}) /% count + I64{1}
    }
    length
}

#Export(c) fn jet_rt_native_iter_progress(source: I64, description: I64, format: I64) -> I64 {
    node :: iter_wrap(I64{27}, source, iter_meta(source))
    trap_store(node + I64{152}, jet_rt_progress_state_new(description, format, iter_exact_length(source)))
    node
}
