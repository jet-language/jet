// Native iterator owners. Each node owns its source, descriptor and closure;
// pulling uses reusable slots, not one allocation per element. Eager operations
// collect only where the reference kernels do (repeat/cycle/try/dedup_by).
// Node words: kind,meta,source,other,count,index,env,invoke,release,callback-meta,
// scratch,second-scratch,saved,saved-meta,list,extra,flags,initialized,done,context.
// Hooked kinds (27 progress, 28 channel, 30 generator) keep their state in
// env@48 and the addresses of their kernels in invoke@56 (pull(node, output)
// -> 1 when it wrote output) and release@64 (release(state)). Only an image
// that builds such a node links its kernels; iter_pull_kernel and
// jet_rt_native_iter_drop name none of them.

// The high kind-word bit of an Option descriptor (kind 7) whose value is an
// inline word, not a box (JetIR IR_LAZY_INLINE_OPTION): an Int?'s Int or a
// scalar's zero-extended word, INT_OPTION_NONE when absent.
ITER_INLINE_OPTION: I64{4294967296}

iter_meta: fn(iter: I64) -> I64 { trap_word(wrapping(iter + I64{8})) }

iter_new: fn(kind: I64, meta: I64) -> I64 {
    node: jet_rt_alloc_8(I64{160})
    coll_zero(node, I64{160})
    trap_store(node, kind)
    trap_store(wrapping(node + I64{8}), coll_meta_copy(meta))
    node
}

// The channel layer supplies its descriptor before the first blocking pull.
// This node owns the receiver, not another iterator or a per-item holder.
iter_channel_new: fn(receiver: I64, meta: I64) -> I64 {
    node: iter_new(I64{28}, meta)
    iter_hook(node, receiver, rt_iter_channel_pull_address(), rt_iter_channel_release_address())
    node
}

iter_hooked: fn(kind: I64) -> Bool { kind == I64{27} || kind == I64{28} || kind == I64{30} }

iter_hook: fn(node: I64, state: I64, pull: I64, release: I64) {
    trap_store(wrapping(node + I64{48}), state)
    trap_store(wrapping(node + I64{56}), pull)
    trap_store(wrapping(node + I64{64}), release)
}

#Export(c) jet_rt_native_iter_channel_pull: fn(node: I64, output: I64) -> I64 {
    if channel_iter_pull(trap_word(wrapping(node + I64{48})), output) -> I64{1} else -> I64{0}
}

#Export(c) jet_rt_native_iter_channel_release: fn(receiver: I64) -> I64 {
    jet_rt_native_receiver_drop(receiver)
    I64{0}
}

// RuntimeLower resolves these checked addresses through its sole intrinsic table.
rt_iter_channel_pull_address: fn() -> I64 {
    loop { jet_rt_unreachable(I64{0}, I64{0}) }
}
rt_iter_channel_release_address: fn() -> I64 {
    loop { jet_rt_unreachable(I64{0}, I64{0}) }
}
rt_iter_progress_pull_address: fn() -> I64 {
    loop { jet_rt_unreachable(I64{0}, I64{0}) }
}
rt_iter_progress_release_address: fn() -> I64 {
    loop { jet_rt_unreachable(I64{0}, I64{0}) }
}

iter_wrap: fn(kind: I64, source: I64, meta: I64) -> I64 {
    node: iter_new(kind, meta)
    trap_store(wrapping(node + I64{16}), source)
    trap_store(wrapping(node + I64{80}), coll_slot_new(iter_meta(source)))
    node
}

iter_callback: fn(kind: I64, source: I64, env: I64, invoke: I64, release: I64, callback_meta: I64, output_meta: I64) -> I64 {
    node: iter_wrap(kind, source, output_meta)
    trap_store(wrapping(node + I64{48}), env)
    trap_store(wrapping(node + I64{56}), invoke)
    trap_store(wrapping(node + I64{64}), release)
    trap_store(wrapping(node + I64{72}), coll_meta_copy(callback_meta))
    trap_store(wrapping(node + I64{88}), coll_slot_new(callback_meta))
    trap_store(wrapping(node + I64{136}), coll_size(callback_meta))
    node
}

iter_unary: fn(node: I64, input: I64, output: I64) -> Bool {
    _ := coll_call3(trap_word(wrapping(node + I64{56})), trap_word(wrapping(node + I64{48})), input, output)
    jet_rt_session_propagate() == I64{0}
}

iter_binary: fn(node: I64, a: I64, b: I64, output: I64) -> I64 {
    coll_call4(trap_word(wrapping(node + I64{56})), trap_word(wrapping(node + I64{48})), a, b, output)
}

iter_equal: fn(meta: I64, a: I64, b: I64) -> Bool {
    coll_call2(trap_word(wrapping(meta + I64{32})), a, b) != I64{0}
}

iter_order: fn(meta: I64, a: I64, b: I64) -> I64 { coll_call2(trap_word(wrapping(meta + I64{40})), a, b) }

iter_drain: fn(source: I64, header: I64) {
    coll_zero(header, I64{24})
    meta: iter_meta(source)
    slot: coll_slot_new(meta)
    loop iter_pull(source, slot) -> coll_list_push(header, slot, meta)
    jet_rt_free_8(slot, coll_size(meta))
    if (jet_rt_session_propagate() != I64{0}) { coll_list_drop(header, meta, I64{0}) }
}

iter_saved_clear: fn(node: I64) {
    saved: trap_word(wrapping(node + I64{96}))
    if (saved != I64{0}) { coll_slot_free(saved, trap_word(wrapping(node + I64{104}))) }
    trap_store(wrapping(node + I64{96}), I64{0})
}

iter_save: fn(node: I64, slot: I64, meta: I64) {
    iter_saved_clear(node)
    held: coll_slot_new(meta)
    coll_slot_clone(slot, held, meta)
    trap_store(wrapping(node + I64{96}), held)
    if (trap_word(wrapping(node + I64{104})) == I64{0}) { trap_store(wrapping(node + I64{104}), coll_meta_copy(meta)) }
}

iter_pull_kernel: fn(node: I64, output: I64) -> Bool {
    if (trap_word(wrapping(node + I64{144})) != I64{0}) { return false }
    kind: trap_word(node)
    // Sources, hooked kinds and list cursors read nothing else of the node
    // here, so they dispatch before the other node words are loaded.
    if (kind == I64{29}) { return iter_source_pull(node, output) }
    if iter_hooked(kind) { return coll_call2(trap_word(wrapping(node + I64{56})), node, output) != I64{0} }
    if (kind == I64{0}) {
        header: trap_word(wrapping(node + I64{112}))
        index: trap_word(wrapping(node + I64{40}))
        if (index >= trap_word(header)) { return false }
        meta: iter_meta(node)
        coll_copy(wrapping(trap_word(wrapping(header + I64{16})) + index * trap_word(meta)), output, coll_payload(meta))
        trap_store(wrapping(node + I64{40}), index + I64{1})
        return true
    }
    meta: iter_meta(node)
    source: trap_word(wrapping(node + I64{16}))
    scratch: trap_word(wrapping(node + I64{80}))
    second: trap_word(wrapping(node + I64{88}))
    index: trap_word(wrapping(node + I64{40}))
    count: trap_word(wrapping(node + I64{32}))
    if (kind == I64{1}) { return false }
    if (kind == I64{2}) {
        if (index >= count) { return false }
        trap_store(output, jet_int_owned_from_i64(index))
        trap_store(wrapping(node + I64{40}), index + I64{1})
        return true
    }
    if (kind == I64{25}) { return text_iter_pull(source, output) }
    if (kind == I64{3}) {
        if (count <= I64{0}) { return false }
        trap_store(wrapping(node + I64{32}), count - I64{1})
        return iter_pull(source, output)
    }
    if (kind == I64{4} || kind == I64{5}) {
        remaining := count
        if (kind == I64{5}) { remaining = if (index == I64{0}) -> I64{0} else -> count - I64{1} }
        loop remaining > (I64{0}) {
            if !iter_pull(source, scratch) -> return false
            coll_slot_drop(scratch, iter_meta(source))
            remaining -= I64{1}
        }
        trap_store(wrapping(node + I64{40}), I64{1})
        if (kind == I64{4}) { trap_store(wrapping(node + I64{32}), I64{0}) }
        return iter_pull(source, output)
    }
    if (kind == I64{6}) {
        if !iter_pull(source, scratch) -> return false
        ready: iter_unary(node, scratch, output)
        coll_slot_drop(scratch, iter_meta(source))
        return ready
    }
    if (kind == I64{7} || kind == I64{8} || kind == I64{9}) {
        loop iter_pull(source, scratch) {
            if (kind == I64{9} && index != I64{0}) {
                coll_copy(scratch, output, coll_payload(meta))
                return true
            }
            if !iter_unary(node, scratch, second) {
                coll_slot_drop(scratch, iter_meta(source))
                return false
            }
            keep: trap_byte(second) != I64{0}
            coll_slot_drop(second, trap_word(wrapping(node + I64{72})))
            if ((kind != I64{9} && keep) || (kind == I64{9} && !keep)) {
                trap_store(wrapping(node + I64{40}), I64{1})
                coll_copy(scratch, output, coll_payload(meta))
                return true
            }
            coll_slot_drop(scratch, iter_meta(source))
            if (kind == I64{8}) {
                trap_store(wrapping(node + I64{144}), I64{1})
                return false
            }
        }
        return false
    }
    if (kind == I64{10}) {
        loop iter_pull(source, scratch) {
            previous: trap_word(wrapping(node + I64{96}))
            if (previous == I64{0} || !iter_equal(meta, previous, scratch)) {
                iter_save(node, scratch, meta)
                coll_copy(scratch, output, coll_payload(meta))
                return true
            }
            coll_slot_drop(scratch, iter_meta(source))
        }
        return false
    }
    if (kind == I64{11}) {
        if (index == I64{0}) {
            trap_store(wrapping(node + I64{40}), I64{1})
            return iter_pull(source, output)
        }
        if (trap_word(wrapping(node + I64{128})) != I64{0}) {
            trap_store(wrapping(node + I64{128}), I64{0})
            coll_copy(scratch, output, coll_payload(meta))
            return true
        }
        if !iter_pull(source, scratch) -> return false
        trap_store(wrapping(node + I64{128}), I64{1})
        coll_slot_clone(trap_word(wrapping(node + I64{96})), output, meta)
        return true
    }
    if (kind == I64{12} || kind == I64{13}) { return iter_pull_nested(node, output) }
    if (kind == I64{14}) {
        loop {
            inner: trap_word(wrapping(node + I64{24}))
            if (inner != I64{0}) {
                if iter_pull(inner, output) -> return true
                jet_rt_native_iter_drop(inner)
                trap_store(wrapping(node + I64{24}), I64{0})
            }
            if !iter_pull(source, scratch) -> return false
            nested_meta: iter_meta(source)
            inner_meta: trap_word(wrapping(nested_meta + I64{56}))
            nested: jet_rt_native_iter_from_list(scratch, inner_meta, I64{1})
            trap_store(wrapping(nested + I64{128}), I64{1})
            trap_store(wrapping(node + I64{24}), nested)
        }
    }
    if (kind == I64{15}) {
        child: trap_word(wrapping(meta + I64{56}))
        slot: coll_slot_new(child)
        if !iter_pull(source, slot) {
            jet_rt_free(slot, coll_size(child), I64{8})
            return false
        }
        trap_store(output, slot)
        return true
    }
    if (kind == I64{16}) {
        if !iter_pull(source, scratch) -> return false
        old: trap_word(wrapping(node + I64{96}))
        _ := iter_binary(node, old, scratch, second)
        coll_slot_drop(scratch, iter_meta(source))
        if (jet_rt_session_propagate() != I64{0}) { return false }
        coll_slot_drop(old, meta)
        coll_copy(second, old, coll_payload(meta))
        coll_slot_clone(old, output, meta)
        return true
    }
    if (kind == I64{17} || kind == I64{18} || kind == I64{19}) {
        return iter_pull_zip(node, output)
    }
    if (kind == I64{20}) {
        if !iter_pull(source, scratch) -> return false
        word: trap_word(wrapping(node + I64{120}))
        trap_store(word, jet_int_owned_from_i64(index))
        _ := iter_binary(node, word, scratch, output)
        int_discard(trap_word(word))
        coll_slot_drop(scratch, iter_meta(source))
        trap_store(wrapping(node + I64{40}), index + I64{1})
        return jet_rt_session_propagate() == I64{0}
    }
    if (kind == I64{21}) {
        header: trap_word(wrapping(node + I64{112}))
        length: trap_word(header)
        if (index >= count || length == I64{0}) { return false }
        coll_slot_clone(trap_word(wrapping(header + I64{16})) + (index % length) * trap_word(meta), output, meta)
        trap_store(wrapping(node + I64{40}), index + I64{1})
        return true
    }
    if (kind == I64{26}) { return iter_pull_filter_map(node, output) }
    reason: trap_msg_unreachable_text()
    trap_stop(I64{1}, rt_text_data(reason), rt_text_len(reason), I64{0}, I64{0})
    trap_defect_prepare()
    trap_msg_unreachable()
    trap_defect_exit(EXIT_ICE)
    return false
}

iter_pull: fn(node: I64, output: I64) -> Bool {
    // A text split (kind 25) never sets the done word at +144, so its whole
    // kernel is text_iter_pull; the general kernel is skipped for it.
    pulled: if (trap_word(node) == I64{25}) -> text_iter_pull(trap_word(wrapping(node + I64{16})), output) else -> iter_pull_kernel(node, output)
    if !pulled -> return false
    // Internal map/list nodes implement one public flat-map/flatten adapter;
    // they are not additional inspected handles in the reference runtime.
    if ((trap_word(node) == I64{0} || trap_word(node) == I64{6}) && trap_word(wrapping(node + I64{128})) != I64{0}) {
        return true
    }
    // Fuel is charged only inside a compile-time request; outside one a pull
    // reads the active word and makes no call.
    if (sync_load(wrapping(comptime_root + I64{8})) != I64{0} && jet_rt_iter_charge() != I64{0}) {
        coll_slot_drop(output, iter_meta(node))
        return false
    }
    true
}

iter_pull_nested: fn(node: I64, output: I64) -> Bool {
    source: trap_word(wrapping(node + I64{16}))
    scratch: trap_word(wrapping(node + I64{80}))
    element: iter_meta(source)
    count: trap_word(wrapping(node + I64{32}))
    header: trap_word(wrapping(node + I64{112}))
    windows: trap_word(node) == I64{13}
    if !windows -> coll_zero(header, I64{24})
    loop trap_word(header) < count {
        if !iter_pull(source, scratch) -> break
        coll_list_push(header, scratch, element)
    }
    if (jet_rt_session_propagate() != I64{0}) {
        coll_list_drop(header, element, I64{0})
        return false
    }
    length: trap_word(header)
    if (length == I64{0} || (windows && length != count)) { return false }
    if !windows {
        coll_copy(header, output, I64{24})
        coll_zero(header, I64{24})
        return true
    }
    coll_zero(output, I64{24})
    at := I64{0}
    data: trap_word(wrapping(header + I64{16}))
    stride: trap_word(element)
    loop at < length {
        coll_slot_clone(data + at * stride, scratch, element)
        coll_list_push(output, scratch, element)
        at += I64{1}
    }
    coll_slot_drop(data, element)
    at = I64{1}
    loop at < length {
        coll_copy(wrapping(data + at * stride), wrapping(data + (at - I64{1}) * stride), coll_payload(element))
        at += I64{1}
    }
    trap_store(header, length - I64{1})
    true
}

// `by_value` 1 hands the Iter the header at `source` (left zeroed): its
// elements move into the Iter when the header owns its buffer alone. A buffer
// another owner shares (copy-on-write: a List clone, or an element
// List of one) or a frozen one (cap 0 over read-only data) keeps its elements
// for those owners; the Iter pulls clones and the header gives up its
// reference, as by_value 0 leaves the source untouched.
#Export(c) jet_rt_native_iter_from_list: fn(source: I64, meta: I64, by_value: I64) -> I64 {
    node: iter_new(I64{0}, meta)
    header: coll_list_new()
    trap_store(wrapping(node + I64{112}), header)
    if (by_value != I64{0} && iter_list_sole(source)) {
        coll_copy(source, header, I64{24})
        coll_zero(source, I64{24})
        return node
    }
    scratch: coll_slot_new(meta)
    at := I64{0}
    loop at < trap_word(source) {
        coll_slot_clone(trap_word(wrapping(source + I64{16})) + at * trap_word(meta), scratch, meta)
        coll_list_push(header, scratch, meta)
        at += I64{1}
    }
    jet_rt_free(scratch, coll_size(meta), I64{8})
    if (by_value != I64{0}) { iter_list_release(source, meta) }
    node
}

// Whether the List header at `source` may give its elements away: its owned
// buffer has no other owner, or it holds nothing (an empty frozen header).
iter_list_sole: fn(source: I64) -> Bool {
    if (trap_word(wrapping(source + I64{8})) == I64{0}) -> return trap_word(source) == I64{0}
    jet_rt_block_unique(trap_word(wrapping(source + I64{16})))
}

// The header at `source` gives up its reference to the buffer it shares: the
// last owner drops the elements and frees it; a frozen buffer is never released.
iter_list_release: fn(source: I64, meta: I64) {
    if (trap_word(wrapping(source + I64{8})) != I64{0} && jet_rt_block_release(trap_word(wrapping(source + I64{16})))) {
        coll_list_drop(source, meta, I64{0})
    }
    coll_zero(source, I64{24})
}

#Export(c) jet_rt_native_iter_drop: fn(node: I64) {
    if (node == I64{0}) {
        return
    }
    kind: trap_word(node)
    meta: iter_meta(node)
    source: trap_word(wrapping(node + I64{16}))
    context: trap_word(wrapping(node + I64{152}))
    if (kind == I64{18}) {
        coll_slot_free(trap_word(context), iter_meta(source))
        coll_slot_free(trap_word(wrapping(context + I64{8})), iter_meta(trap_word(wrapping(node + I64{24}))))
        jet_rt_free(context, I64{16}, I64{8})
    }
    if (kind == I64{19}) {
        jet_rt_string_drop(trap_word(context))
        jet_rt_string_drop(trap_word(wrapping(context + I64{8})))
        jet_rt_string_drop(trap_word(wrapping(context + I64{24})))
        jet_rt_string_drop(trap_word(wrapping(context + I64{32})))
        jet_rt_free(context, I64{56}, I64{8})
    }
    // A hooked kind's state is released here, where its kernel ran before,
    // under Shield (a generator's producer is cancelled and joined).
    if iter_hooked(kind) -> iter_release_callback(node)
    if (kind == I64{20}) { jet_rt_free(trap_word(wrapping(node + I64{120})), I64{8}, I64{8}) }
    if (kind == I64{26} && trap_word(wrapping(node + I64{120})) != I64{0}) {
        jet_rt_free(trap_word(wrapping(node + I64{120})), coll_size(trap_word(wrapping(trap_word(wrapping(node + I64{72})) + I64{64}))), I64{8})
    }
    if (kind == I64{25}) { text_iter_drop(source) } else if (source != I64{0}) {
        scratch: trap_word(wrapping(node + I64{80}))
        if (scratch != I64{0}) {
            if (kind == I64{11} && trap_word(wrapping(node + I64{128})) != I64{0}) {
                coll_slot_drop(scratch, iter_meta(source))
            }
            jet_rt_free(scratch, coll_size(iter_meta(source)), I64{8})
        }
        jet_rt_native_iter_drop(source)
    }
    other: trap_word(wrapping(node + I64{24}))
    if (other != I64{0}) { jet_rt_native_iter_drop(other) }
    second: trap_word(wrapping(node + I64{88}))
    callback_meta: trap_word(wrapping(node + I64{72}))
    if (second != I64{0}) { jet_rt_free(second, trap_word(wrapping(node + I64{136})), I64{8}) }
    iter_saved_clear(node)
    coll_meta_drop(trap_word(wrapping(node + I64{104})))
    header: trap_word(wrapping(node + I64{112}))
    if (header != I64{0}) {
        element: if (kind == I64{12} || kind == I64{13}) -> trap_word(wrapping(meta + I64{56})) else -> meta
        coll_list_drop(header, element, if (kind == I64{0}) -> trap_word(wrapping(node + I64{40})) else -> I64{0})
        jet_rt_free(header, I64{24}, I64{8})
    }
    release: trap_word(wrapping(node + I64{64}))
    if (release != I64{0}) {
        jet_rt_session_shield_enter()
        coll_call1_unit(release, trap_word(wrapping(node + I64{48})))
        jet_rt_session_shield_leave()
    }
    coll_meta_drop(callback_meta)
    coll_meta_drop(meta)
    jet_rt_free_8(node, I64{160})
}

#Export(c) jet_rt_native_iter_to_list: fn(iter: I64, target: I64) {
    iter_drain(iter, target)
    jet_rt_native_iter_drop(iter)
}

#Export(c) jet_rt_native_iter_next: fn(iter: I64) -> I64 {
    meta: iter_meta(iter)
    slot: coll_slot_new(meta)
    if iter_pull(iter, slot) -> return slot
    jet_rt_free(slot, coll_size(meta), I64{8})
    I64{0}
}

#Export(c) jet_rt_native_iter_first: fn(iter: I64) -> I64 {
    slot: jet_rt_native_iter_next(iter)
    jet_rt_native_iter_drop(iter)
    slot
}

#Export(c) jet_rt_native_iter_len: fn(iter: I64) -> I64 {
    meta: iter_meta(iter)
    slot: coll_slot_new(meta)
    count := I64{0}
    loop iter_pull(iter, slot) {
        coll_slot_drop(slot, meta)
        count += I64{1}
    }
    jet_rt_free(slot, coll_size(meta), I64{8})
    jet_rt_native_iter_drop(iter)
    count
}

#Export(c) jet_rt_native_iter_is_empty: fn(iter: I64) -> I64 {
    // The reference consumes the iterator, but probes just its first item.
    meta: iter_meta(iter)
    slot: coll_slot_new(meta)
    present: iter_pull(iter, slot)
    if present -> coll_slot_drop(slot, meta)
    jet_rt_free(slot, coll_size(meta), I64{8})
    jet_rt_native_iter_drop(iter)
    if present -> I64{0} else -> I64{1}
}

#Export(c) jet_rt_native_iter_empty: fn(meta: I64) -> I64 { iter_new(I64{1}, meta) }

#Export(c) jet_rt_native_iter_indexes: fn(count: I64, meta: I64) -> I64 {
    node: iter_new(I64{2}, meta)
    trap_store(wrapping(node + I64{32}), count)
    node
}

// Owning constructors discard their adopted source on a returned Root stop.
// Its release callbacks execute in the actual stopped cleanup, not the
// constructor's normal body or a constructor-static Task context.
iter_discard_stopped_source: fn(source: I64) {
    saved: jet_rt_session_cleanup_enter(jet_rt_session_status())
    jet_rt_native_iter_drop(source)
    jet_rt_session_cleanup_leave(saved)
}

#Export(c) jet_rt_native_iter_take: fn(source: I64, count: I64) -> I64 {
    if (count < I64{0}) {
        iter_argument_stop(I64{0})
        iter_discard_stopped_source(source)
        return I64{0}
    }
    node: iter_wrap(I64{3}, source, iter_meta(source))
    trap_store(wrapping(node + I64{32}), count)
    node
}

#Export(c) jet_rt_native_iter_skip: fn(source: I64, count: I64) -> I64 {
    if (count < I64{0}) {
        iter_argument_stop(I64{0})
        iter_discard_stopped_source(source)
        return I64{0}
    }
    node: iter_wrap(I64{4}, source, iter_meta(source))
    trap_store(wrapping(node + I64{32}), count)
    node
}

#Export(c) jet_rt_native_iter_step_by: fn(source: I64, count: I64) -> I64 {
    if (count <= I64{0}) {
        iter_argument_stop(I64{1})
        iter_discard_stopped_source(source)
        return I64{0}
    }
    node: iter_wrap(I64{5}, source, iter_meta(source))
    trap_store(wrapping(node + I64{32}), count)
    node
}

#Export(c) jet_rt_native_iter_map: fn(source: I64, env: I64, invoke: I64, release: I64, meta: I64) -> I64 {
    iter_callback(I64{6}, source, env, invoke, release, meta, meta)
}

#Export(c) jet_rt_native_iter_map_mut: fn(source: I64, env: I64, invoke: I64, release: I64, meta: I64) -> I64 {
    iter_callback(I64{6}, source, env, invoke, release, meta, meta)
}

#Export(c) jet_rt_native_iter_filter: fn(source: I64, env: I64, invoke: I64, release: I64, meta: I64) -> I64 {
    iter_callback(I64{7}, source, env, invoke, release, meta, iter_meta(source))
}

#Export(c) jet_rt_native_iter_take_while: fn(source: I64, env: I64, invoke: I64, release: I64, meta: I64) -> I64 {
    iter_callback(I64{8}, source, env, invoke, release, meta, iter_meta(source))
}

#Export(c) jet_rt_native_iter_skip_while: fn(source: I64, env: I64, invoke: I64, release: I64, meta: I64) -> I64 {
    iter_callback(I64{9}, source, env, invoke, release, meta, iter_meta(source))
}

#Export(c) jet_rt_native_iter_dedup: fn(source: I64, meta: I64) -> I64 {
    iter_wrap(I64{10}, source, meta)
}

#Export(c) jet_rt_native_iter_intersperse: fn(source: I64, separator: I64, meta: I64, by_value: I64) -> I64 {
    node: iter_wrap(I64{11}, source, meta)
    saved: coll_slot_new(meta)
    if (by_value != I64{0}) { coll_copy(separator, saved, coll_payload(meta)) } else {
        coll_slot_clone(separator, saved, meta)
    }
    trap_store(wrapping(node + I64{96}), saved)
    trap_store(wrapping(node + I64{104}), coll_meta_copy(meta))
    node
}

iter_nested: fn(kind: I64, source: I64, count: I64, meta: I64) -> I64 {
    if (count <= I64{0}) {
        iter_argument_stop(if (kind == I64{12}) -> I64{2} else -> I64{3})
        iter_discard_stopped_source(source)
        return I64{0}
    }
    node: iter_wrap(kind, source, meta)
    trap_store(wrapping(node + I64{32}), count)
    trap_store(wrapping(node + I64{112}), coll_list_new())
    node
}

#Export(c) jet_rt_native_iter_chunks: fn(source: I64, count: I64, meta: I64) -> I64 {
    iter_nested(I64{12}, source, count, meta)
}

#Export(c) jet_rt_native_iter_windows: fn(source: I64, count: I64, meta: I64) -> I64 {
    iter_nested(I64{13}, source, count, meta)
}

#Export(c) jet_rt_native_iter_flatten: fn(source: I64, meta: I64) -> I64 {
    iter_wrap(I64{14}, source, meta)
}

#Export(c) jet_rt_native_iter_some: fn(source: I64, meta: I64) -> I64 {
    node: iter_new(I64{15}, meta)
    trap_store(wrapping(node + I64{16}), source)
    node
}

#Export(c) jet_rt_native_iter_enumerate: fn(source: I64, env: I64, invoke: I64, release: I64, meta: I64) -> I64 {
    node: iter_callback(I64{20}, source, env, invoke, release, meta, meta)
    trap_store(wrapping(node + I64{120}), jet_rt_alloc(I64{8}, I64{8}))
    node
}

#Export(c) jet_rt_native_iter_scan: fn(source: I64, seed: I64, seed_meta: I64, seed_by_value: I64, env: I64, invoke: I64, release: I64, meta: I64) -> I64 {
    node: iter_callback(I64{16}, source, env, invoke, release, meta, meta)
    saved: coll_slot_new(seed_meta)
    if (seed_by_value != I64{0}) { coll_copy(seed, saved, coll_payload(seed_meta)) } else {
        coll_slot_clone(seed, saved, seed_meta)
    }
    trap_store(wrapping(node + I64{96}), saved)
    trap_store(wrapping(node + I64{104}), coll_meta_copy(seed_meta))
    node
}

iter_collect_node: fn(source: I64) -> I64 {
    meta: iter_meta(source)
    node: iter_new(I64{0}, meta)
    header: coll_list_new()
    iter_drain(source, header)
    trap_store(wrapping(node + I64{112}), header)
    jet_rt_native_iter_drop(source)
    if (jet_rt_session_propagate() != I64{0}) {
        jet_rt_native_iter_drop(node)
        return I64{0}
    }
    node
}

iter_repeat: fn(source: I64, count: I64, loops: Bool) -> I64 {
    node: iter_collect_node(source)
    if (node == I64{0}) { return I64{0} }
    length: trap_word(trap_word(wrapping(node + I64{112})))
    times: if (count < I64{0}) -> I64{0} else -> count
    trap_store(node, I64{21})
    trap_store(wrapping(node + I64{32}), if (length == I64{0}) -> I64{0} else if loops -> length * times else -> times)
    trap_store(wrapping(node + I64{128}), if loops -> I64{1} else -> I64{0})
    node
}

#Export(c) jet_rt_native_iter_repeat: fn(source: I64, count: I64) -> I64 {
    iter_repeat(source, count, true)
}

#Export(c) jet_rt_native_iter_cycle: fn(source: I64, count: I64) -> I64 {
    iter_repeat(source, count, false)
}

#Export(c) jet_rt_native_iter_drop_last: fn(source: I64, count: I64) -> I64 {
    node: iter_collect_node(source)
    if (node == I64{0}) { return I64{0} }
    header: trap_word(wrapping(node + I64{112}))
    length: trap_word(header)
    removed: if (count < I64{0}) -> I64{0} else if count > length -> length else -> count
    kept: length - removed
    meta: iter_meta(node)
    at := kept
    loop at < length {
        coll_slot_drop(trap_word(wrapping(header + I64{16})) + at * trap_word(meta), meta)
        at += I64{1}
    }
    trap_store(header, kept)
    node
}

#Export(c) jet_rt_native_iter_shuffle: fn(source: I64) -> I64 {
    node: iter_collect_node(source)
    if (node == I64{0}) { return I64{0} }
    header: trap_word(wrapping(node + I64{112}))
    meta: iter_meta(node)
    scratch: coll_slot_new(meta)
    stride: trap_word(meta)
    data: trap_word(wrapping(header + I64{16}))
    state := U64{3237998146}
    at := trap_word(header) - I64{1}
    loop at > (I64{0}) {
        // `wrapping` governs its one operator: the LCG's multiply and add
        // each wrap (Rust wrapping_mul(..).wrapping_add(1)).
        state = wrapping(wrapping(state * U64{6364136223846793005}) + U64{1})
        other: wrapping(I64{(state >> U64{33}) % wrapping(U64{at + I64{1}})})
        coll_copy(wrapping(data + at * stride), scratch, coll_payload(meta))
        coll_copy(wrapping(data + other * stride), wrapping(data + at * stride), coll_payload(meta))
        coll_copy(scratch, wrapping(data + other * stride), coll_payload(meta))
        at -= I64{1}
    }
    jet_rt_free(scratch, coll_size(meta), I64{8})
    node
}

#Export(c) jet_rt_native_iter_split_at: fn(source: I64, count: I64, target: I64, left: I64, right: I64) {
    meta: iter_meta(source)
    slot: coll_slot_new(meta)
    coll_zero(wrapping(target + left), I64{24})
    coll_zero(wrapping(target + right), I64{24})
    at := I64{0}
    loop iter_pull(source, slot) {
        coll_list_push(if at < count -> target + left else -> target + right, slot, meta)
        at += I64{1}
    }
    if (jet_rt_session_propagate() != I64{0}) {
        coll_list_drop(wrapping(target + left), meta, I64{0})
        coll_list_drop(wrapping(target + right), meta, I64{0})
    }
    jet_rt_free(slot, coll_size(meta), I64{8})
    jet_rt_native_iter_drop(source)
}

#Export(c) jet_rt_native_iter_join: fn(source: I64, separator: I64, meta: I64) -> I64 {
    builder: jet_rt_string_builder_new()
    slot: coll_slot_new(iter_meta(source))
    at := I64{0}
    loop iter_pull(source, slot) {
        if (at != I64{0}) { jet_rt_string_builder_push(builder, separator) }
        text: coll_call1(trap_word(wrapping(meta + I64{24})), slot)
        if (jet_rt_session_propagate() != I64{0}) {
            coll_slot_drop(slot, iter_meta(source))
            break
        }
        jet_rt_string_builder_push(builder, text)
        jet_rt_string_drop(text)
        coll_slot_drop(slot, iter_meta(source))
        at += I64{1}
    }
    jet_rt_free(slot, coll_size(iter_meta(source)), I64{8})
    jet_rt_native_iter_drop(source)
    result: jet_rt_string_builder_finish(builder)
    if (jet_rt_session_propagate() != I64{0}) {
        jet_rt_string_drop(result)
        return I64{0}
    }
    result
}

#Export(c) jet_rt_native_iter_compare: fn(source: I64, other: I64, meta: I64, by_value: I64) -> I64 {
    // The reference snapshots the second list before comparing lazily.
    b: jet_rt_native_iter_from_list(other, meta, by_value)
    a_slot: coll_slot_new(iter_meta(source))
    b_slot: coll_slot_new(meta)
    order := I64{0}
    loop {
        a_present: iter_pull(source, a_slot)
        b_present: iter_pull(b, b_slot)
        if (a_present && b_present) {
            order = iter_order(meta, a_slot, b_slot)
            coll_slot_drop(a_slot, iter_meta(source))
            coll_slot_drop(b_slot, meta)
            if (order != I64{0}) { break }
        } else {
            if a_present {
                coll_slot_drop(a_slot, iter_meta(source))
                order = I64{1}
            }
            if b_present {
                coll_slot_drop(b_slot, meta)
                order = I64{-1}
            }
            break
        }
    }
    jet_rt_free(a_slot, coll_size(iter_meta(source)), I64{8})
    jet_rt_free(b_slot, coll_size(meta), I64{8})
    jet_rt_native_iter_drop(source)
    jet_rt_native_iter_drop(b)
    if (order < I64{0}) -> I64{-1} else if (order > I64{0}) -> I64{1} else -> I64{0}
}

#Export(c) jet_rt_native_iter_last_index_of: fn(source: I64, needle: I64, meta: I64, by_value: I64) -> I64 {
    node: iter_collect_node(source)
    if (node == I64{0}) {
        if (by_value != I64{0}) { coll_slot_drop(needle, meta) }
        return I64{0}
    }
    slot: coll_slot_new(meta)
    if (by_value != I64{0}) { coll_copy(needle, slot, coll_payload(meta)) } else {
        coll_slot_clone(needle, slot, meta)
    }
    header: trap_word(wrapping(node + I64{112}))
    at := trap_word(header)
    found := I64{-1}
    loop at > (I64{0}) {
        at -= I64{1}
        if iter_equal(meta, trap_word(wrapping(header + I64{16})) + at * trap_word(meta), slot) {
            found = at
            break
        }
    }
    coll_slot_free(slot, meta)
    jet_rt_native_iter_drop(node)
    if (found < I64{0}) { return I64{0} }
    result: jet_rt_alloc(I64{8}, I64{8})
    trap_store(result, jet_int_owned_from_i64(found))
    result
}

#Export(c) jet_rt_native_iter_is_sorted: fn(source: I64, meta: I64) -> I64 {
    node: iter_collect_node(source)
    if (node == I64{0}) { return I64{0} }
    header: trap_word(wrapping(node + I64{112}))
    data: trap_word(wrapping(header + I64{16}))
    stride: trap_word(meta)
    at := I64{1}
    sorted := I64{1}
    loop at < trap_word(header) {
        if (iter_order(meta, data + (at - I64{1}) * stride, data + at * stride) > I64{0}) {
            sorted = I64{0}
            break
        }
        at += I64{1}
    }
    jet_rt_native_iter_drop(node)
    sorted
}

iter_eager_callback: fn(source: I64, env: I64, invoke: I64, release: I64, meta: I64) -> I64 {
    // Dedup_by and sorted_by invoke keys only after fully consuming the input.
    node: iter_collect_node(source)
    if (node == I64{0}) {
        if (release != I64{0}) {
            jet_rt_session_shield_enter()
            coll_call1_unit(release, env)
            jet_rt_session_shield_leave()
        }
        return I64{0}
    }
    trap_store(wrapping(node + I64{48}), env)
    trap_store(wrapping(node + I64{56}), invoke)
    trap_store(wrapping(node + I64{64}), release)
    trap_store(wrapping(node + I64{72}), coll_meta_copy(meta))
    trap_store(wrapping(node + I64{88}), coll_slot_new(meta))
    trap_store(wrapping(node + I64{136}), coll_size(meta))
    node
}

#Export(c) jet_rt_native_iter_dedup_by: fn(source: I64, env: I64, invoke: I64, release: I64, meta: I64) -> I64 {
    node: iter_eager_callback(source, env, invoke, release, meta)
    if (node == I64{0}) { return I64{0} }
    header: trap_word(wrapping(node + I64{112}))
    data: trap_word(wrapping(header + I64{16}))
    element: iter_meta(node)
    stride: trap_word(element)
    key: trap_word(wrapping(node + I64{88}))
    previous: coll_slot_new(meta)
    at := I64{0}
    used := I64{0}
    have_previous := false
    loop at < trap_word(header) && jet_rt_session_propagate() == (I64{0}) {
        slot: wrapping(data + at * stride)
        if !iter_unary(node, slot, key) -> break
        same: have_previous && iter_equal(meta, previous, key)
        if !same {
            if have_previous -> coll_slot_drop(previous, meta)
            coll_copy(key, previous, coll_payload(meta))
            have_previous = true
            coll_copy(slot, wrapping(data + used * stride), coll_payload(element))
            used += I64{1}
        } else {
            coll_slot_drop(key, meta)
            coll_slot_drop(slot, element)
        }
        at += I64{1}
    }
    // A stopped callback has not initialized key; only remaining input drops.
    loop at < trap_word(header) {
        coll_slot_drop(data + at * stride, element)
        at += I64{1}
    }
    if have_previous -> coll_slot_drop(previous, meta)
    jet_rt_free(previous, coll_size(meta), I64{8})
    trap_store(header, used)
    if (jet_rt_session_propagate() != I64{0}) {
        jet_rt_native_iter_drop(node)
        return I64{0}
    }
    iter_release_callback(node)
    node
}

#Export(c) jet_rt_native_iter_is_sorted_by: fn(source: I64, env: I64, invoke: I64, release: I64, meta: I64) -> I64 {
    node: iter_eager_callback(source, env, invoke, release, meta)
    if (node == I64{0}) { return I64{0} }
    header: trap_word(wrapping(node + I64{112}))
    data: trap_word(wrapping(header + I64{16}))
    stride: trap_word(iter_meta(node))
    a: trap_word(wrapping(node + I64{88}))
    b: coll_slot_new(meta)
    at := I64{1}
    result := I64{1}
    loop at < trap_word(header) && jet_rt_session_propagate() == (I64{0}) {
        if !iter_unary(node, data + (at - I64{1}) * stride, a) {
            result = I64{0}
            break
        }
        if !iter_unary(node, data + at * stride, b) {
            coll_slot_drop(a, meta)
            result = I64{0}
            break
        }
        order: iter_order(meta, a, b)
        coll_slot_drop(a, meta)
        coll_slot_drop(b, meta)
        if (order > I64{0}) {
            result = I64{0}
            break
        }
        at += I64{1}
    }
    jet_rt_free(b, coll_size(meta), I64{8})
    jet_rt_native_iter_drop(node)
    result
}

iter_release_callback: fn(node: I64) {
    release: trap_word(wrapping(node + I64{64}))
    if (release != I64{0}) {
        jet_rt_session_shield_enter()
        coll_call1_unit(release, trap_word(wrapping(node + I64{48})))
        jet_rt_session_shield_leave()
        trap_store(wrapping(node + I64{64}), I64{0})
    }
}

#Export(c) jet_rt_native_iter_flat_map: fn(source: I64, env: I64, invoke: I64, release: I64, meta: I64) -> I64 {
    mapped: jet_rt_native_iter_map(source, env, invoke, release, meta)
    trap_store(wrapping(mapped + I64{128}), I64{1})
    jet_rt_native_iter_flatten(mapped, trap_word(wrapping(meta + I64{56})))
}

#Export(c) jet_rt_native_iter_filter_map: fn(source: I64, env: I64, invoke: I64, release: I64, meta: I64) -> I64 {
    node: iter_callback(I64{26}, source, env, invoke, release, meta, trap_word(wrapping(meta + I64{56})))
    if ((trap_word(wrapping(meta + I64{48})).bit_and(I64{4294967295})) != I64{7}) {
        trap_store(wrapping(node + I64{120}), coll_slot_new(trap_word(wrapping(meta + I64{64}))))
    }
    node
}

// Unbox one initialized failure carrier into target (an Ok/present payload)
// or error (an Err payload). Returns 1=success, 0=failure. An Option whose
// kind word carries ITER_INLINE_OPTION is one inline word (JetIR
// ir_lazy_meta): the word is the payload's, INT_OPTION_NONE its None.
iter_unbox: fn(carrier_slot: I64, carrier: I64, target: I64, error: I64) -> Bool {
    raw: trap_word(carrier_slot)
    kind: trap_word(wrapping(carrier + I64{48}))
    optional: kind.bit_and(I64{4294967295}) == I64{7}
    ok: trap_word(wrapping(carrier + I64{56}))
    if optional {
        if (kind.bit_and(ITER_INLINE_OPTION) != I64{0}) {
            if (raw == INT_OPTION_NONE) { return false }
            trap_store(target, raw)
            return true
        }
        if (raw == I64{0}) { return false }
        iter_box_take(raw, I64{0}, coll_size(ok), target, ok)
        return true
    }
    err: trap_word(wrapping(carrier + I64{64}))
    success: trap_word(raw) != I64{0}
    iter_box_take(raw, I64{8}, coll_result_size(ok, err), if success -> target else -> error, if success -> ok else -> err)
    success
}

// Takes the payload of `meta` at `raw + offset` out of the carrier box `raw`
// of `size` bytes into `target`, consuming the carrier's reference (Refcount.jet).
// A box the carrier owns alone gives its payload up and is freed without
// dropping it. A box other owners share (a clone of a List element) or a
// frozen one keeps its payload for them: target gets a clone, and the box
// loses this owner; the last owner drops the payload and frees it.
iter_box_take: fn(raw: I64, offset: I64, size: I64, target: I64, meta: I64) {
    if jet_rt_block_unique(raw) {
        coll_copy(wrapping(raw + offset), target, coll_payload(meta))
        jet_rt_free(raw, size, I64{8})
        return
    }
    coll_slot_clone(raw + offset, target, meta)
    if jet_rt_block_release(raw) {
        coll_slot_drop(raw + offset, meta)
        jet_rt_free(raw, size, I64{8})
    }
}

iter_pull_filter_map: fn(node: I64, output: I64) -> Bool {
    source: trap_word(wrapping(node + I64{16}))
    input: trap_word(wrapping(node + I64{80}))
    result: trap_word(wrapping(node + I64{88}))
    carrier: trap_word(wrapping(node + I64{72}))
    optional: (trap_word(wrapping(carrier + I64{48})).bit_and(I64{4294967295})) == I64{7}
    error_meta: trap_word(wrapping(carrier + I64{64}))
    error: trap_word(wrapping(node + I64{120}))
    loop iter_pull(source, input) {
        ready: iter_unary(node, input, result)
        coll_slot_drop(input, iter_meta(source))
        if !ready -> break
        if iter_unbox(result, carrier, output, error) -> return true
        if !optional -> coll_slot_drop(error, error_meta)
    }
    false
}

iter_zip: fn(kind: I64, a: I64, b: I64, env: I64, invoke: I64, release: I64, meta: I64) -> I64 {
    node: iter_callback(kind, a, env, invoke, release, meta, meta)
    trap_store(wrapping(node + I64{24}), b)
    // Binary adapters write the result directly; second scratch holds B.
    jet_rt_free(trap_word(wrapping(node + I64{88})), coll_size(meta), I64{8})
    trap_store(wrapping(node + I64{88}), coll_slot_new(iter_meta(b)))
    trap_store(wrapping(node + I64{136}), coll_size(iter_meta(b)))
    node
}

iter_pull_zip: fn(node: I64, output: I64) -> Bool {
    kind: trap_word(node)
    a: trap_word(wrapping(node + I64{16}))
    b: trap_word(wrapping(node + I64{24}))
    x: trap_word(wrapping(node + I64{80}))
    y: trap_word(wrapping(node + I64{88}))
    a_present: iter_pull(a, x)
    if (jet_rt_session_propagate() != I64{0}) {
        if a_present -> coll_slot_drop(x, iter_meta(a))
        return false
    }
    if (!a_present && kind == I64{17}) { return false }
    b_present: iter_pull(b, y)
    if (jet_rt_session_propagate() != I64{0}) {
        if a_present -> coll_slot_drop(x, iter_meta(a))
        if b_present -> coll_slot_drop(y, iter_meta(b))
        return false
    }
    if (kind == I64{19} && a_present != b_present) {
        iter_zip_stop(trap_word(wrapping(node + I64{152})))
        saved: jet_rt_session_cleanup_enter(jet_rt_session_status())
        if a_present -> coll_slot_drop(x, iter_meta(a))
        if b_present -> coll_slot_drop(y, iter_meta(b))
        jet_rt_session_cleanup_leave(saved)
        return false
    }
    if (!a_present && !b_present) { return false }
    if (kind == I64{17} && !b_present) {
        coll_slot_drop(x, iter_meta(a))
        return false
    }
    if (kind == I64{18}) {
        context: trap_word(wrapping(node + I64{152}))
        if !a_present -> coll_slot_clone(trap_word(context), x, iter_meta(a))
        if !b_present -> coll_slot_clone(trap_word(wrapping(context + I64{8})), y, iter_meta(b))
    }
    moved: iter_binary(node, x, y, output)
    if ((moved.bit_and(I64{1})) == I64{0}) { coll_slot_drop(x, iter_meta(a)) }
    if ((moved.bit_and(I64{2})) == I64{0}) { coll_slot_drop(y, iter_meta(b)) }
    jet_rt_session_propagate() == I64{0}
}

#Export(c) jet_rt_native_iter_zip: fn(a: I64, b: I64, env: I64, invoke: I64, release: I64, meta: I64) -> I64 {
    iter_zip(I64{17}, a, b, env, invoke, release, meta)
}

#Export(c) jet_rt_native_iter_zip_pad: fn(a: I64, b: I64, fill_a: I64, fill_b: I64, env: I64, invoke: I64, release: I64, meta: I64, a_meta: I64, b_meta: I64, a_by_value: I64, b_by_value: I64) -> I64 {
    node: iter_zip(I64{18}, a, b, env, invoke, release, meta)
    context: jet_rt_alloc(I64{16}, I64{8})
    x: coll_slot_new(a_meta)
    y: coll_slot_new(b_meta)
    if (a_by_value != I64{0}) { coll_copy(fill_a, x, coll_payload(a_meta)) } else {
        coll_slot_clone(fill_a, x, a_meta)
    }
    if (b_by_value != I64{0}) { coll_copy(fill_b, y, coll_payload(b_meta)) } else {
        coll_slot_clone(fill_b, y, b_meta)
    }
    trap_store(context, x)
    trap_store(wrapping(context + I64{8}), y)
    trap_store(wrapping(node + I64{152}), context)
    node
}

#Export(c) jet_rt_native_iter_zip_strict: fn(a: I64, b: I64, env: I64, invoke: I64, release: I64, meta: I64, policy: I64, file: I64, line: I64, function: I64, source_line: I64, col: I64, caret: I64) -> I64 {
    node: iter_zip(I64{19}, a, b, env, invoke, release, meta)
    context: jet_rt_alloc(I64{56}, I64{8})
    trap_store(context, jet_rt_string_clone(policy))
    trap_store(wrapping(context + I64{8}), jet_rt_string_clone(file))
    trap_store(wrapping(context + I64{16}), line)
    trap_store(wrapping(context + I64{24}), jet_rt_string_clone(function))
    trap_store(wrapping(context + I64{32}), jet_rt_string_clone(source_line))
    trap_store(wrapping(context + I64{40}), col)
    trap_store(wrapping(context + I64{48}), caret)
    trap_store(wrapping(node + I64{152}), context)
    node
}

iter_try_callback: fn(source: I64, env: I64, invoke: I64, release: I64, carrier: I64, filter: Bool) -> I64 {
    node: iter_callback(I64{6}, source, env, invoke, release, carrier, carrier)
    input_meta: iter_meta(source)
    output_meta: if filter -> input_meta else -> trap_word(wrapping(carrier + I64{56}))
    optional: (trap_word(wrapping(carrier + I64{48})).bit_and(I64{4294967295})) == I64{7}
    error_meta: trap_word(wrapping(carrier + I64{64}))
    input: trap_word(wrapping(node + I64{80}))
    raw_result: trap_word(wrapping(node + I64{88}))
    value: coll_slot_new(trap_word(wrapping(carrier + I64{56})))
    error: if optional -> I64{0} else -> coll_slot_new(error_meta)
    header: coll_list_new()
    success := true
    stopped := false
    loop iter_pull(source, input) {
        if !iter_unary(node, input, raw_result) {
            coll_slot_drop(input, input_meta)
            stopped = true
            break
        }
        if !iter_unbox(raw_result, carrier, value, error) {
            coll_slot_drop(input, input_meta)
            success = false
            break
        }
        if filter {
            if (trap_byte(value) != I64{0}) { coll_list_push(header, input, input_meta) } else {
                coll_slot_drop(input, input_meta)
            }
            coll_slot_drop(value, trap_word(wrapping(carrier + I64{56})))
        } else {
            coll_slot_drop(input, input_meta)
            coll_list_push(header, value, output_meta)
        }
    }
    stopped = stopped || jet_rt_session_propagate() != I64{0}
    jet_rt_free(value, coll_size(trap_word(wrapping(carrier + I64{56}))), I64{8})
    result := I64{0}
    if (success && !stopped) {
        result_iter: jet_rt_native_iter_from_list(header, output_meta, I64{1})
        if optional {
            result = jet_rt_alloc(I64{8}, I64{8})
            trap_store(result, result_iter)
        } else {
            result = jet_rt_alloc(coll_result_size(trap_word(wrapping(carrier + I64{56})), error_meta), I64{8})
            trap_store(result, I64{1})
            trap_store(wrapping(result + I64{8}), result_iter)
        }
    } else {
        coll_list_drop(header, output_meta, I64{0})
        if (!optional && !stopped) {
            result = jet_rt_alloc(coll_result_size(trap_word(wrapping(carrier + I64{56})), error_meta), I64{8})
            trap_store(result, I64{0})
            coll_copy(error, wrapping(result + I64{8}), coll_payload(error_meta))
        }
        if (!optional && !success && stopped) { coll_slot_drop(error, error_meta) }
    }
    jet_rt_free(header, I64{24}, I64{8})
    if !optional -> jet_rt_free(error, coll_size(error_meta), I64{8})
    jet_rt_native_iter_drop(node)
    result
}

#Export(c) jet_rt_native_iter_try_map: fn(source: I64, env: I64, invoke: I64, release: I64, meta: I64) -> I64 {
    iter_try_callback(source, env, invoke, release, meta, false)
}

#Export(c) jet_rt_native_iter_try_filter: fn(source: I64, env: I64, invoke: I64, release: I64, meta: I64) -> I64 {
    iter_try_callback(source, env, invoke, release, meta, true)
}

#Export(c) jet_rt_native_iter_try_collect: fn(source: I64, list_meta: I64, error_meta: I64) -> I64 {
    carrier: iter_meta(source)
    element: trap_word(wrapping(list_meta + I64{56}))
    slot: coll_slot_new(carrier)
    value: coll_slot_new(element)
    optional: error_meta == I64{0}
    error: if optional -> I64{0} else -> coll_slot_new(error_meta)
    header: coll_list_new()
    success := true
    loop iter_pull(source, slot) {
        if !iter_unbox(slot, carrier, value, error) {
            success = false
            break
        }
        coll_list_push(header, value, element)
    }
    result := I64{0}
    stopped: jet_rt_session_propagate() != I64{0}
    if !stopped {
        if optional {
            if success {
                result = coll_slot_new(list_meta)
                coll_copy(header, result, I64{24})
            }
        } else {
            result = jet_rt_alloc(coll_result_size(list_meta, error_meta), I64{8})
            trap_store(result, if success -> I64{1} else -> I64{0})
            coll_copy(if success -> header else -> error, wrapping(result + I64{8}), coll_payload(if success -> list_meta else -> error_meta))
        }
    }
    if (!optional && !success && stopped) { coll_slot_drop(error, error_meta) }
    if (!success || stopped) { coll_list_drop(header, element, I64{0}) }
    jet_rt_free(header, I64{24}, I64{8})
    jet_rt_free(value, coll_size(element), I64{8})
    jet_rt_free(slot, coll_size(carrier), I64{8})
    if !optional -> jet_rt_free(error, coll_size(error_meta), I64{8})
    jet_rt_native_iter_drop(source)
    result
}

#Export(c) jet_rt_native_iter_chunk_while: fn(source: I64, env: I64, invoke: I64, release: I64, meta: I64, list_meta: I64) -> I64 {
    node: iter_eager_callback(source, env, invoke, release, meta)
    if (node == I64{0}) { return I64{0} }
    source_header: trap_word(wrapping(node + I64{112}))
    element: iter_meta(node)
    data: trap_word(wrapping(source_header + I64{16}))
    stride: trap_word(element)
    chunks: coll_list_new()
    chunk: coll_list_new()
    at := I64{0}
    loop at < trap_word(source_header) && jet_rt_session_propagate() == (I64{0}) {
        if (at != I64{0}) {
            _ := iter_binary(node, data + (at - I64{1}) * stride, data + at * stride, trap_word(wrapping(node + I64{88})))
            if (jet_rt_session_propagate() != I64{0}) { break }
            keep: trap_byte(trap_word(wrapping(node + I64{88}))) != I64{0}
            coll_slot_drop(trap_word(wrapping(node + I64{88})), meta)
            if !keep {
                coll_list_push(chunks, chunk, list_meta)
                coll_zero(chunk, I64{24})
            }
        }
        coll_list_push(chunk, wrapping(data + at * stride), element)
        at += I64{1}
    }
    stopped: jet_rt_session_propagate() != I64{0}
    if {
        (!stopped && trap_word(chunk) != I64{0}) -> coll_list_push(chunks, chunk, list_meta)
        else -> coll_list_drop(chunk, element, I64{0})
    }
    // Only the unprocessed tail remains owned by the source list.
    trap_store(wrapping(node + I64{40}), at)
    result := I64{0}
    if stopped -> coll_list_drop(chunks, list_meta, I64{0}) else {
        result = jet_rt_native_iter_from_list(chunks, list_meta, I64{1})
    }
    jet_rt_free(chunks, I64{24}, I64{8})
    jet_rt_free(chunk, I64{24}, I64{8})
    jet_rt_native_iter_drop(node)
    result
}

// Cursor is [iterator, current payload, stride, initialized, exhausted]. Init
// pulls once. A moved binding clears initialized, but advance still skips
// stride-1 elements and pulls the next item.
#Export(c) jet_rt_native_iter_cursor_init: fn(source: I64, step: I64, has_step: I64) -> I64 {
    stride: if (has_step == I64{0}) -> I64{1} else -> step
    if (stride <= I64{0}) {
        iter_argument_stop(I64{4})
        iter_discard_stopped_source(source)
        return I64{0}
    }
    cursor: jet_rt_alloc(I64{40}, I64{8})
    slot: coll_slot_new(iter_meta(source))
    trap_store(cursor, source)
    trap_store(wrapping(cursor + I64{8}), slot)
    trap_store(wrapping(cursor + I64{16}), stride)
    present: iter_pull(source, slot)
    trap_store(wrapping(cursor + I64{24}), if present -> I64{1} else -> I64{0})
    trap_store(wrapping(cursor + I64{32}), if present -> I64{0} else -> I64{1})
    if (jet_rt_session_propagate() != I64{0}) {
        jet_rt_native_iter_cursor_drop(cursor)
        return I64{0}
    }
    cursor
}

#Export(c) jet_rt_native_iter_cursor_test: fn(cursor: I64) -> I64 { trap_word(wrapping(cursor + I64{24})) }

#Export(c) jet_rt_native_iter_cursor_value: fn(cursor: I64, target: I64, by_value: I64) {
    if (trap_word(wrapping(cursor + I64{24})) == I64{0}) {
        iter_argument_stop(I64{5})
        return
    }
    source: trap_word(cursor)
    coll_copy(trap_word(wrapping(cursor + I64{8})), target, coll_payload(iter_meta(source)))
    if (by_value != I64{0}) { trap_store(wrapping(cursor + I64{24}), I64{0}) }
}

#Export(c) jet_rt_native_iter_cursor_advance: fn(cursor: I64) {
    if (trap_word(wrapping(cursor + I64{32})) != I64{0}) {
        return
    }
    source: trap_word(cursor)
    slot: trap_word(wrapping(cursor + I64{8}))
    meta: iter_meta(source)
    if (trap_word(wrapping(cursor + I64{24})) != I64{0}) { coll_slot_drop(slot, meta) }
    trap_store(wrapping(cursor + I64{24}), I64{0})
    skip := trap_word(wrapping(cursor + I64{16})) - I64{1}
    loop skip > (I64{0}) {
        if !iter_pull(source, slot) {
            trap_store(wrapping(cursor + I64{32}), I64{1})
            return
        }
        coll_slot_drop(slot, meta)
        skip -= I64{1}
    }
    present: iter_pull(source, slot)
    trap_store(wrapping(cursor + I64{24}), if present -> I64{1} else -> I64{0})
    trap_store(wrapping(cursor + I64{32}), if present -> I64{0} else -> I64{1})
}

#Export(c) jet_rt_native_iter_cursor_drop: fn(cursor: I64) {
    if (cursor == I64{0}) {
        return
    }
    source: trap_word(cursor)
    meta: iter_meta(source)
    slot: trap_word(wrapping(cursor + I64{8}))
    if (trap_word(wrapping(cursor + I64{24})) != I64{0}) { coll_slot_drop(slot, meta) }
    jet_rt_free(slot, coll_size(meta), I64{8})
    jet_rt_native_iter_drop(source)
    jet_rt_free(cursor, I64{40}, I64{8})
}

iter_argument_stop: fn(kind: I64) {
    reason: if {
        (kind == I64{0}) -> trap_msg_sequence_count_text()
        (kind == I64{1}) -> trap_msg_sequence_step_text()
        (kind == I64{2}) -> trap_msg_sequence_chunks_text()
        (kind == I64{3}) -> trap_msg_sequence_windows_text()
        (kind == I64{4}) -> trap_msg_cursor_step_text()
        else -> trap_msg_cursor_exhausted_text()
    }
    trap_stop(I64{1}, rt_text_data(reason), rt_text_len(reason), I64{0}, I64{0})
    trap_header(I64{0})
    trap_write_static(reason)
    if (kind < I64{4}) { trap_msg_collections_end() } else { trap_msg_prelude_end() }
    trap_footer(I64{0})
}

iter_zip_stop: fn(context: I64) {
    // The report's message, less its stop code, for served code.
    reason: jet_rt_string_builder_new()
    jet_rt_string_builder_push(reason, rt_static_text("Zip inputs have different lengths under `"))
    jet_rt_string_builder_push(reason, trap_word(context))
    rt_text_push_word(reason, I64{96}, I64{1})
    trap_stop(I64{1}, rt_text_data(reason), rt_text_len(reason), I64{0}, I64{0})
    jet_rt_string_drop(reason)
    trap_root_prepare()
    trap_msg_header_zip()
    trap_write_handle(trap_word(context))
    trap_msg_zip_end()
    file: trap_word(wrapping(context + I64{8}))
    function: trap_word(wrapping(context + I64{24}))
    source: trap_word(wrapping(context + I64{32}))
    trap_context(trap_word(file), trap_word(wrapping(file + I64{8})), trap_word(wrapping(context + I64{16})).bit_and(I64{4294967295}), trap_word(function), trap_word(wrapping(function + I64{8})), trap_word(source), trap_word(wrapping(source + I64{8})), trap_word(wrapping(context + I64{40})).bit_and(I64{4294967295}), trap_word(wrapping(context + I64{48})).bit_and(I64{4294967295}))
    trap_footer_e0128()
    trap_exit(EXIT_RUNTIME_PANIC)
}

// Only sources whose Rust size_hint bounds agree supply a progress total.
// Custom chunks/windows/dedup/zip/split iterators intentionally have no hint.
iter_exact_length: fn(node: I64) -> I64 {
    kind: trap_word(node)
    index: trap_word(wrapping(node + I64{40}))
    count: trap_word(wrapping(node + I64{32}))
    if (kind == I64{3} && count == I64{0}) { return I64{0} }
    if (kind == I64{0}) { return trap_word(trap_word(wrapping(node + I64{112}))) - index }
    if (kind == I64{1}) { return I64{0} }
    if (kind == I64{2}) { return if count > index -> count - index else -> I64{0} }
    if (kind == I64{21}) {
        return if (trap_word(wrapping(node + I64{128})) == I64{0} || count == I64{0}) -> count - index else -> I64{-1}
    }
    if (kind != I64{3} && kind != I64{4} && kind != I64{5} && kind != I64{6} && kind != I64{15} && kind != I64{16} && kind != I64{20} && kind != I64{27}) {
        return I64{-1}
    }
    length: iter_exact_length(trap_word(wrapping(node + I64{16})))
    if (length < I64{0}) { return I64{-1} }
    if (kind == I64{3}) { return if count < length -> count else -> length }
    if (kind == I64{4}) { return if length > count -> length - count else -> I64{0} }
    if (kind == I64{5}) {
        if (index != I64{0}) { return length /% count }
        return if (length == I64{0}) -> I64{0} else -> (length - I64{1}) /% count + I64{1}
    }
    length
}

#Export(c) jet_rt_native_iter_progress: fn(source: I64, description: I64, format: I64) -> I64 {
    node: iter_wrap(I64{27}, source, iter_meta(source))
    iter_hook(node, jet_rt_progress_state_new(description, format, iter_exact_length(source)), rt_iter_progress_pull_address(), rt_iter_progress_release_address())
    node
}

#Export(c) jet_rt_native_iter_progress_pull: fn(node: I64, output: I64) -> I64 {
    state: trap_word(wrapping(node + I64{48}))
    if !iter_pull(trap_word(wrapping(node + I64{16})), output) {
        jet_rt_progress_state_finish(state)
        return I64{0}
    }
    jet_rt_progress_state_advance(state)
    if (jet_rt_session_propagate() != I64{0}) {
        coll_slot_drop(output, iter_meta(node))
        return I64{0}
    }
    I64{1}
}

#Export(c) jet_rt_native_iter_progress_release: fn(state: I64) -> I64 {
    jet_rt_progress_state_drop(state)
    I64{0}
}
