#Export(c) fn jet_rt_native_iter_flatten(source: I64, meta: I64) -> I64 {
    iter_wrap(I64{14}, source, meta)
}

#Export(c) fn jet_rt_native_iter_some(source: I64, meta: I64) -> I64 {
