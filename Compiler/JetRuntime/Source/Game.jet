// core.game headless runtime (Rust Game.rs headless substrate; Foundation
// Game.rs frame budget and transcript hash; GameAssetPipeline.rs path
// resolution). Every handle is an I64 address; text slots own E4 strings.
//
// GameState128 (shared by a scene's assets and input; Rust Rc<GameState>):
// refs0 assetKinds@8 assetPaths@32 bindingActions@56 bindingKeys@80
// components@104, each a native [len, cap, data] header of owned strings.
// JetGameAssets and JetGameInputMap handles are the state address itself.
// JetGameScene56: assets0 input8 (the IR reads these two as fields) refs16
// name24 callbacks@32 ([len, cap, data] of env/invoke/release triples).
// JetGameFrame24: index0 (exact Int) input8 (snapshot) refs16.
// JetGameInputSnapshot32: refs0 pressed@8 (owned strings).
// JetGameBackend24: remaining0 (-1 live) nextIndex8 inFlight16; a value, so
// clone copies it and present edits the caller's own copy.
// JetGameReplay16 / JetGameImage16 / JetGameSound16: refs0 path8.

GAME_DEFAULT_HEADLESS_FRAMES :: I64{3}
GAME_ASSET_MAX_PATH_BYTES :: I64{4096}
GAME_TRANSCRIPT_OFFSET :: I64{-3750763034362895579}
GAME_TRANSCRIPT_PRIME :: I64{1099511628211}
GAME_OPTION_INT_NONE :: I64{4611686018427387904}

fn game_word(address: I64) -> I64 { trap_word(address) }
fn game_store(address: I64, value: I64) { trap_store(address, value) }

fn game_list_push(header: I64, value: I64) {
    length :: game_word(header)
    capacity :: game_word(wrapping(header + I64{8}))
    data := game_word(wrapping(header + I64{16}))
    if (length == capacity) {
        grown :: if (capacity == I64{0}) -> I64{4} else -> capacity * I64{2}
        buffer :: jet_rt_alloc(grown * I64{8}, I64{8})
        if (length != I64{0}) { coll_copy(data, buffer, length * I64{8}) }
        if (capacity != I64{0}) { jet_rt_free(data, capacity * I64{8}, I64{8}) }
        game_store(wrapping(header + I64{8}), grown)
        game_store(wrapping(header + I64{16}), buffer)
        data = buffer
    }
    game_store(wrapping(data + length * I64{8}), value)
    game_store(header, length + I64{1})
}

fn game_list_text(header: I64, at: I64) -> I64 { game_word(wrapping(game_word(wrapping(header + I64{16})) + at * I64{8})) }

fn game_list_has_text(header: I64, value: I64) -> Bool {
    at := I64{0}
    loop at < game_word(header) {
        if jet_rt_string_eq(game_list_text(header, at), value) -> return true
        at += I64{1}
    }
    false
}

fn game_text(literal: I64) -> I64 { jet_rt_string_clone(literal) }

// ---- GameState --------------------------------------------------------------

fn game_state_new() -> I64 {
    state :: jet_rt_alloc(I64{128}, I64{8})
    coll_zero(state, I64{128})
    game_store(state, I64{1})
    state
}

fn game_state_retain(state: I64) -> I64 {
    _ := sync_add(state, I64{1})
    state
}

fn game_state_release(state: I64) {
    if (state == I64{0}) -> return
    if (sync_add(state, I64{-1}) != I64{1}) -> return
    coll_text_list_drop(wrapping(state + I64{8}), true)
    coll_text_list_drop(wrapping(state + I64{32}), true)
    coll_text_list_drop(wrapping(state + I64{56}), true)
    coll_text_list_drop(wrapping(state + I64{80}), true)
    coll_text_list_drop(wrapping(state + I64{104}), true)
    jet_rt_free(state, I64{128}, I64{8})
}

#Export(c) fn jet_rt_handle_clone_jet_game_assets(assets: I64) -> I64 { game_state_retain(assets) }
#Export(c) fn jet_rt_handle_drop_jet_game_assets(assets: I64) { game_state_release(assets) }
#Export(c) fn jet_rt_handle_show_jet_game_assets(_assets: I64) -> I64 { game_text(rt_static_text("GameAssets")) }
#Export(c) fn jet_rt_handle_display_jet_game_assets(assets: I64) -> I64 { jet_rt_handle_show_jet_game_assets(assets) }
#Export(c) fn jet_rt_handle_clone_jet_game_input_map(input: I64) -> I64 { game_state_retain(input) }
#Export(c) fn jet_rt_handle_drop_jet_game_input_map(input: I64) { game_state_release(input) }
#Export(c) fn jet_rt_handle_show_jet_game_input_map(_input: I64) -> I64 { game_text(rt_static_text("GameInputMap")) }
#Export(c) fn jet_rt_handle_display_jet_game_input_map(input: I64) -> I64 { jet_rt_handle_show_jet_game_input_map(input) }

// ---- GameScene ----------------------------------------------------------------

#Export(c) fn jet_game_scene_new(name: I64) -> I64 {
    state :: game_state_new()
    scene :: jet_rt_alloc(I64{56}, I64{8})
    coll_zero(scene, I64{56})
    game_store(scene, state)
    game_store(wrapping(scene + I64{8}), game_state_retain(state))
    game_store(wrapping(scene + I64{16}), I64{1})
    game_store(wrapping(scene + I64{24}), jet_rt_string_clone(name))
    scene
}

#Export(c) fn jet_rt_handle_clone_jet_game_scene(scene: I64) -> I64 {
    _ := sync_add(wrapping(scene + I64{16}), I64{1})
    scene
}

#Export(c) fn jet_rt_handle_drop_jet_game_scene(scene: I64) {
    if (scene == I64{0}) -> return
    if (sync_add(wrapping(scene + I64{16}), I64{-1}) != I64{1}) -> return
    callbacks :: wrapping(scene + I64{32})
    data :: game_word(wrapping(callbacks + I64{16}))
    at := I64{0}
    loop at < game_word(callbacks) {
        event_release_closure(game_word(wrapping(data + at * I64{8})), game_word(wrapping(data + (at + I64{2}) * I64{8})))
        at += I64{3}
    }
    coll_text_list_drop(callbacks, false)
    jet_rt_string_drop(game_word(wrapping(scene + I64{24})))
    game_state_release(game_word(scene))
    game_state_release(game_word(wrapping(scene + I64{8})))
    jet_rt_free(scene, I64{56}, I64{8})
}

#Export(c) fn jet_rt_handle_show_jet_game_scene(scene: I64) -> I64 {
    target :: jet_rt_string_builder_new()
    jet_rt_string_builder_push(target, rt_static_text("GameScene("))
    jet_rt_string_builder_push(target, game_word(wrapping(scene + I64{24})))
    jet_rt_string_builder_push(target, rt_static_text(")"))
    jet_rt_string_builder_finish(target)
}
#Export(c) fn jet_rt_handle_display_jet_game_scene(scene: I64) -> I64 { jet_rt_handle_show_jet_game_scene(scene) }

// The scene takes the moved closure box; it is released once with the scene.
#Export(c) fn jet_game_scene_on_frame(scene: I64, env: I64, invoke: I64, release: I64) {
    callbacks :: wrapping(scene + I64{32})
    game_list_push(callbacks, env)
    game_list_push(callbacks, invoke)
    game_list_push(callbacks, release)
}

#Export(c) fn jet_game_scene_component(scene: I64, name: I64) {
    components :: wrapping(game_word(scene) + I64{104})
    if !game_list_has_text(components, name) -> game_list_push(components, jet_rt_string_clone(name))
}

// One synthetic entity row of default component data when every named
// component is registered (Rust jet_game_scene_query: no names is one empty
// row), else no rows.
#Export(c) fn jet_game_scene_query(scene: I64, names: I64, out_data: I64) -> I64 {
    components :: wrapping(game_word(scene) + I64{104})
    row :: jet_rt_string_builder_new()
    data :: rt_text_data(names)
    length :: rt_text_len(names)
    wanted := I64{0}
    start := I64{0}
    at := I64{0}
    loop at <= length {
        if (at == length || rt_text_byte(wrapping(data + at)) == I64{44}) {
            if (at > start) {
                name :: rt_text_copy(wrapping(data + start), at - start)
                registered :: game_list_has_text(components, name)
                if registered {
                    if (wanted != I64{0}) { rt_text_push_scalar(row, I64{44}) }
                    jet_rt_string_builder_push(row, name)
                    if jet_rt_string_eq(name, rt_static_text("Position")) {
                        jet_rt_string_builder_push(row, rt_static_text("{{x:0}}"))
                    } else if jet_rt_string_eq(name, rt_static_text("Velocity")) {
                        jet_rt_string_builder_push(row, rt_static_text("{{dx:0}}"))
                    } else {
                        jet_rt_string_builder_push(row, rt_static_text("{{}}"))
                    }
                    wanted += I64{1}
                }
                jet_rt_string_drop(name)
                if !registered {
                    jet_rt_string_drop(row)
                    game_store(out_data, I64{0})
                    return I64{0}
                }
            }
            start = at + I64{1}
        }
        at += I64{1}
    }
    buffer :: coll_i64_output(I64{1}, out_data)
    game_store(buffer, jet_rt_string_builder_finish(row))
    I64{1}
}

// ---- GameAssets -----------------------------------------------------------------

fn game_asset_space(byte: I64) -> Bool { byte == I64{32} || (byte >= I64{9} && byte <= I64{13}) }

fn game_asset_error(target: I64, prefix: I64, path: I64, err: I64) -> I64 {
    jet_rt_string_builder_push(target, prefix)
    jet_rt_string_builder_push(target, path)
    rt_text_push_scalar(target, I64{96})
    game_store(err, jet_rt_string_builder_finish(target))
    I64{0}
}

fn game_asset_fixed_error(message: I64, err: I64) -> I64 {
    game_store(err, game_text(message))
    I64{0}
}

// The logical path of `path` under the built-in game root `.`
// (GameAssetPipeline.rs jet_game_asset_normalize_path then
// jet_game_asset_relative_path): 1 with the owned path in `out`, else 0 with
// the owned error message in `err`.
fn game_asset_resolve(path: I64, out: I64, err: I64) -> I64 {
    data :: rt_text_data(path)
    length :: rt_text_len(path)
    first := I64{0}
    last := length
    loop first < last && game_asset_space(rt_text_byte(wrapping(data + first))) -> first += I64{1}
    loop last > first && game_asset_space(rt_text_byte(wrapping(wrapping(data + last) - I64{1}))) -> last -= I64{1}
    if (first == last) -> return game_asset_error(jet_rt_string_builder_new(), rt_static_text("invalid game asset path `"), path, err)
    if (last - first > GAME_ASSET_MAX_PATH_BYTES) -> return game_asset_fixed_error(rt_static_text("game asset path exceeds the Prelude identity limit"), err)
    at := first
    loop at < last {
        byte :: rt_text_byte(wrapping(data + at))
        c1 :: byte == I64{194} && at + I64{1} < last && rt_text_byte(wrapping(wrapping(data + at) + I64{1})) >= I64{128} && rt_text_byte(wrapping(wrapping(data + at) + I64{1})) <= I64{159}
        if (byte < I64{32} || byte == I64{127} || c1) -> return game_asset_fixed_error(rt_static_text("game asset path contains a control character"), err)
        at += I64{1}
    }
    // Component bounds as (start, end) pairs over the trimmed bytes, where a
    // backslash separates like a slash.
    absolute :: rt_text_byte(wrapping(data + first)) == I64{47} || rt_text_byte(wrapping(data + first)) == I64{92} || (last - first >= I64{3} && rt_text_byte(wrapping(wrapping(data + first) + I64{1})) == I64{58} && (rt_text_byte(wrapping(wrapping(data + first) + I64{2})) == I64{47} || rt_text_byte(wrapping(wrapping(data + first) + I64{2})) == I64{92}))
    bounds :: jet_rt_alloc(I64{24}, I64{8})
    coll_zero(bounds, I64{24})
    start := first
    at = first
    loop at <= last {
        if (at == last || rt_text_byte(wrapping(data + at)) == I64{47} || rt_text_byte(wrapping(data + at)) == I64{92}) {
            size :: at - start
            dot :: size == I64{1} && rt_text_byte(wrapping(data + start)) == I64{46}
            parent :: size == I64{2} && rt_text_byte(wrapping(data + start)) == I64{46} && rt_text_byte(wrapping(wrapping(data + start) + I64{1})) == I64{46}
            drive :: absolute && start == first && size == I64{2} && rt_text_byte(wrapping(wrapping(data + start) + I64{1})) == I64{58}
            if parent {
                if (game_word(bounds) == I64{0}) {
                    coll_text_list_drop(bounds, false)
                    jet_rt_free(bounds, I64{24}, I64{8})
                    return game_asset_error(jet_rt_string_builder_new(), rt_static_text("game asset path escapes its declared root: `"), path, err)
                }
                game_store(bounds, game_word(bounds) - I64{2})
            } else if (size != I64{0} && !dot && !drive) {
                game_list_push(bounds, start)
                game_list_push(bounds, at)
            }
            start = at + I64{1}
        }
        at += I64{1}
    }
    count :: game_word(bounds)
    if (absolute || count == I64{0}) {
        coll_text_list_drop(bounds, false)
        jet_rt_free(bounds, I64{24}, I64{8})
        return game_asset_error(jet_rt_string_builder_new(), rt_static_text("game asset path is not under a declared root: `"), path, err)
    }
    logical :: jet_rt_string_builder_new()
    pairs :: game_word(wrapping(bounds + I64{16}))
    at = I64{0}
    loop at < count {
        if (at != I64{0}) { rt_text_push_scalar(logical, I64{47}) }
        piece :: game_word(wrapping(pairs + at * I64{8}))
        rt_text_append(logical, data + piece, game_word(wrapping(pairs + (at + I64{1}) * I64{8})) - piece)
        at += I64{2}
    }
    coll_text_list_drop(bounds, false)
    jet_rt_free(bounds, I64{24}, I64{8})
    game_store(out, jet_rt_string_builder_finish(logical))
    I64{1}
}

fn game_asset_load(assets: I64, kind: I64, path: I64, ok: I64, err: I64) -> I64 {
    scratch :: jet_rt_alloc(I64{8}, I64{8})
    if (game_asset_resolve(path, scratch, err) == I64{0}) {
        jet_rt_free(scratch, I64{8}, I64{8})
        return I64{0}
    }
    logical :: game_word(scratch)
    jet_rt_free(scratch, I64{8}, I64{8})
    game_list_push(wrapping(assets + I64{8}), game_text(kind))
    game_list_push(wrapping(assets + I64{32}), jet_rt_string_clone(logical))
    asset :: jet_rt_alloc(I64{16}, I64{8})
    game_store(asset, I64{1})
    game_store(wrapping(asset + I64{8}), logical)
    game_store(ok, asset)
    I64{1}
}

#Export(c) fn jet_game_assets_image(assets: I64, path: I64, ok: I64, err: I64) -> I64 { game_asset_load(assets, rt_static_text("image"), path, ok, err) }
#Export(c) fn jet_game_assets_sound(assets: I64, path: I64, ok: I64, err: I64) -> I64 { game_asset_load(assets, rt_static_text("sound"), path, ok, err) }

// ---- Path-carrying handles: GameImage, GameSound, GameReplay -------------------

fn game_path_clone(value: I64) -> I64 {
    _ := sync_add(value, I64{1})
    value
}

fn game_path_drop(value: I64) {
    if (value == I64{0}) -> return
    if (sync_add(value, I64{-1}) != I64{1}) -> return
    jet_rt_string_drop(game_word(wrapping(value + I64{8})))
    jet_rt_free(value, I64{16}, I64{8})
}

fn game_path_show(prefix: I64, value: I64) -> I64 {
    target :: jet_rt_string_builder_new()
    jet_rt_string_builder_push(target, prefix)
    jet_rt_string_builder_push(target, game_word(wrapping(value + I64{8})))
    rt_text_push_scalar(target, I64{41})
    jet_rt_string_builder_finish(target)
}

#Export(c) fn jet_rt_handle_clone_jet_game_image(image: I64) -> I64 { game_path_clone(image) }
#Export(c) fn jet_rt_handle_drop_jet_game_image(image: I64) { game_path_drop(image) }
#Export(c) fn jet_rt_handle_show_jet_game_image(image: I64) -> I64 { game_path_show(rt_static_text("GameImage("), image) }
#Export(c) fn jet_rt_handle_display_jet_game_image(image: I64) -> I64 { jet_rt_handle_show_jet_game_image(image) }
#Export(c) fn jet_rt_handle_debug_jet_game_image(image: I64) -> I64 { jet_rt_handle_show_jet_game_image(image) }
#Export(c) fn jet_rt_handle_clone_jet_game_sound(sound: I64) -> I64 { game_path_clone(sound) }
#Export(c) fn jet_rt_handle_drop_jet_game_sound(sound: I64) { game_path_drop(sound) }
#Export(c) fn jet_rt_handle_show_jet_game_sound(sound: I64) -> I64 { game_path_show(rt_static_text("GameSound("), sound) }
#Export(c) fn jet_rt_handle_display_jet_game_sound(sound: I64) -> I64 { jet_rt_handle_show_jet_game_sound(sound) }
#Export(c) fn jet_rt_handle_debug_jet_game_sound(sound: I64) -> I64 { jet_rt_handle_show_jet_game_sound(sound) }

// The replay keeps its checked `.jetreplay` path; the headless run presses
// every bound action on frame 1 of a replayed run (the corelib replay
// transcript oracle, tests/corelib_parts/runtime.rs:935).
#Export(c) fn jet_game_replay_record(path: I64) -> I64 {
    replay :: jet_rt_alloc(I64{16}, I64{8})
    game_store(replay, I64{1})
    game_store(wrapping(replay + I64{8}), jet_rt_string_clone(path))
    replay
}

#Export(c) fn jet_rt_handle_clone_jet_game_replay(replay: I64) -> I64 { game_path_clone(replay) }
#Export(c) fn jet_rt_handle_drop_jet_game_replay(replay: I64) { game_path_drop(replay) }
#Export(c) fn jet_rt_handle_show_jet_game_replay(replay: I64) -> I64 { game_path_show(rt_static_text("GameReplay("), replay) }
#Export(c) fn jet_rt_handle_display_jet_game_replay(replay: I64) -> I64 { jet_rt_handle_show_jet_game_replay(replay) }

// ---- Input ------------------------------------------------------------------------

#Export(c) fn jet_game_input_bind(input: I64, action: I64, key: I64) {
    count :: game_word(wrapping(input + I64{56}))
    at := I64{0}
    loop at < count {
        if jet_rt_string_eq(game_list_text(wrapping(input + I64{56}), at), action) && jet_rt_string_eq(game_list_text(wrapping(input + I64{80}), at), key) -> return
        at += I64{1}
    }
    game_list_push(wrapping(input + I64{56}), jet_rt_string_clone(action))
    game_list_push(wrapping(input + I64{80}), jet_rt_string_clone(key))
}

#Export(c) fn jet_game_input_pressed(snapshot: I64, action: I64) -> Bool { game_list_has_text(wrapping(snapshot + I64{8}), action) }

#Export(c) fn jet_rt_handle_clone_jet_game_input_snapshot(snapshot: I64) -> I64 {
    _ := sync_add(snapshot, I64{1})
    snapshot
}

#Export(c) fn jet_rt_handle_drop_jet_game_input_snapshot(snapshot: I64) {
    if (snapshot == I64{0}) -> return
    if (sync_add(snapshot, I64{-1}) != I64{1}) -> return
    coll_text_list_drop(wrapping(snapshot + I64{8}), true)
    jet_rt_free(snapshot, I64{32}, I64{8})
}

fn game_join(target: I64, header: I64, separator: I64) {
    at := I64{0}
    loop at < game_word(header) {
        if (at != I64{0}) { rt_text_push_scalar(target, separator) }
        jet_rt_string_builder_push(target, game_list_text(header, at))
        at += I64{1}
    }
}

#Export(c) fn jet_rt_handle_show_jet_game_input_snapshot(snapshot: I64) -> I64 {
    target :: jet_rt_string_builder_new()
    jet_rt_string_builder_push(target, rt_static_text("GameInputSnapshot("))
    game_join(target, wrapping(snapshot + I64{8}), I64{44})
    rt_text_push_scalar(target, I64{41})
    jet_rt_string_builder_finish(target)
}
#Export(c) fn jet_rt_handle_display_jet_game_input_snapshot(snapshot: I64) -> I64 { jet_rt_handle_show_jet_game_input_snapshot(snapshot) }

// ---- GameFrame --------------------------------------------------------------------

#Export(c) fn jet_rt_handle_clone_jet_game_frame(frame: I64) -> I64 {
    _ := sync_add(wrapping(frame + I64{16}), I64{1})
    frame
}

#Export(c) fn jet_rt_handle_drop_jet_game_frame(frame: I64) {
    if (frame == I64{0}) -> return
    if (sync_add(wrapping(frame + I64{16}), I64{-1}) != I64{1}) -> return
    jet_rt_handle_drop_jet_game_input_snapshot(game_word(wrapping(frame + I64{8})))
    jet_rt_free(frame, I64{24}, I64{8})
}

#Export(c) fn jet_rt_handle_show_jet_game_frame(frame: I64) -> I64 {
    target :: jet_rt_string_builder_new()
    jet_rt_string_builder_push(target, rt_static_text("GameFrame("))
    rt_text_push_number(target, jet_int_owned_to_i64(game_word(frame)))
    rt_text_push_scalar(target, I64{41})
    jet_rt_string_builder_finish(target)
}
#Export(c) fn jet_rt_handle_display_jet_game_frame(frame: I64) -> I64 { jet_rt_handle_show_jet_game_frame(frame) }

// ---- GameBackend (Foundation JetGameFrameBudget) ---------------------------------

fn game_backend_new(remaining: I64) -> I64 {
    backend :: jet_rt_alloc(I64{24}, I64{8})
    game_store(backend, remaining)
    game_store(wrapping(backend + I64{8}), I64{0})
    game_store(wrapping(backend + I64{16}), I64{0})
    backend
}

#Export(c) fn jet_game_backend_headless() -> I64 { game_backend_new(GAME_DEFAULT_HEADLESS_FRAMES) }

#Export(c) fn jet_rt_handle_clone_jet_game_backend(backend: I64) -> I64 {
    duplicate :: jet_rt_alloc(I64{24}, I64{8})
    coll_copy(backend, duplicate, I64{24})
    duplicate
}

#Export(c) fn jet_rt_handle_drop_jet_game_backend(backend: I64) {
    if (backend == I64{0}) -> return
    jet_rt_free(backend, I64{24}, I64{8})
}

#Export(c) fn jet_rt_handle_show_jet_game_backend(_backend: I64) -> I64 { game_text(rt_static_text("GameBackend(renderer: headless, audio: none, editor: none)")) }
#Export(c) fn jet_rt_handle_display_jet_game_backend(backend: I64) -> I64 { jet_rt_handle_show_jet_game_backend(backend) }

#Export(c) fn jet_game_backend_should_continue(backend: I64) -> Bool {
    remaining :: game_word(backend)
    game_word(wrapping(backend + I64{16})) == I64{0} && (remaining < I64{0} || remaining > I64{0})
}

// The next issued frame index, or -1 when the budget is spent.
fn game_backend_next(backend: I64) -> I64 {
    if !jet_game_backend_should_continue(backend) -> return I64{-1}
    game_store(wrapping(backend + I64{16}), I64{1})
    index :: game_word(wrapping(backend + I64{8}))
    game_store(wrapping(backend + I64{8}), index + I64{1})
    index
}

#Export(c) fn jet_game_backend_present(backend: I64) {
    game_store(wrapping(backend + I64{16}), I64{0})
    remaining :: game_word(backend)
    if (remaining > I64{0}) { game_store(backend, remaining - I64{1}) }
}

// ---- run --------------------------------------------------------------------------

fn game_hash_byte(state: I64, byte: I64) -> I64 { wrapping(state.bit_xor(byte) * GAME_TRANSCRIPT_PRIME) }

fn game_hash_u64(state: I64, value: I64) -> I64 {
    hash := state
    at := I64{0}
    width :: I64{8}
    loop at < width {
        hash = game_hash_byte(hash, (value >> (at * I64{8})).bit_and(I64{255}))
        at += I64{1}
    }
    hash
}

fn game_hash_text(state: I64, text: I64) -> I64 {
    hash := state
    data :: rt_text_data(text)
    at := I64{0}
    loop at < rt_text_len(text) {
        hash = game_hash_byte(hash, rt_text_byte(wrapping(data + at)))
        at += I64{1}
    }
    hash
}

fn game_hash_literal(state: I64, text: I64) -> I64 { game_hash_byte(game_hash_text(state, text), I64{0}) }

fn game_hash_frame(state: I64, index: I64, pressed: I64) -> I64 {
    hash := game_hash_literal(state, rt_static_text("frame"))
    hash = game_hash_u64(hash, index)
    count :: game_word(pressed)
    hash = game_hash_u64(hash, count)
    at := I64{0}
    loop at < count {
        action :: game_list_text(pressed, at)
        hash = game_hash_u64(hash, rt_text_len(action))
        hash = game_hash_text(hash, action)
        at += I64{1}
    }
    hash
}

fn game_push_hex(target: I64, value: I64) {
    shift := I64{60}
    floor :: I64{0}
    loop shift >= floor {
        nibble :: (value >> shift).bit_and(I64{15})
        digit :: if (nibble < I64{10}) -> I64{48} + nibble else -> I64{87} + nibble
        rt_text_push_scalar(target, digit)
        shift -= I64{4}
    }
}

fn game_line(target: I64, label: I64) {
    if (rt_text_len(target) != I64{0}) { rt_text_push_scalar(target, I64{10}) }
    jet_rt_string_builder_push(target, label)
}

// `label` then the list joined by `separator`, or `none` when it is empty.
fn game_list_line(target: I64, label: I64, header: I64, separator: I64) {
    game_line(target, label)
    if (game_word(header) == I64{0}) {
        jet_rt_string_builder_push(target, rt_static_text("none"))
    } else {
        game_join(target, header, separator)
    }
}

// `label` then `left<joiner>right` pairs joined by commas, or `none`.
fn game_pairs_line(target: I64, label: I64, left: I64, right: I64, joiner: I64) {
    game_line(target, label)
    count :: game_word(left)
    if (count == I64{0}) {
        jet_rt_string_builder_push(target, rt_static_text("none"))
        return
    }
    at := I64{0}
    loop at < count {
        if (at != I64{0}) { rt_text_push_scalar(target, I64{44}) }
        jet_rt_string_builder_push(target, game_list_text(left, at))
        rt_text_push_scalar(target, joiner)
        jet_rt_string_builder_push(target, game_list_text(right, at))
        at += I64{1}
    }
}

// Runs the checked frame budget (Rust jet_game_run): the transcript header,
// then per issued frame its replayed input, every callback in registration
// order with the frame lent, and the frame line; the transcript hash closes a
// run with an explicit `frames` budget. `replay` and `backend` are Option
// boxes (null when absent), `frames` an Option<Int> word.
#Export(c) fn jet_game_run(scene: I64, replay: I64, backend: I64, frames: I64) -> I64 {
    requested :: frames != GAME_OPTION_INT_NONE
    count :: if requested -> jet_int_owned_to_i64(frames) else -> I64{0}
    if (requested && count <= I64{0}) {
        message :: rt_static_text("`game.run` frame budget must be positive")
        jet_rt_panic_message(rt_text_data(message), rt_text_len(message))
        return I64{0}
    }
    plan :: if (backend == I64{0}) -> jet_game_backend_headless() else -> jet_rt_handle_clone_jet_game_backend(game_word(backend))
    if requested {
        game_store(plan, count)
        game_store(wrapping(plan + I64{8}), I64{0})
        game_store(wrapping(plan + I64{16}), I64{0})
    }
    state :: game_word(scene)
    out :: jet_rt_string_builder_new()
    game_line(out, rt_static_text("scene:"))
    jet_rt_string_builder_push(out, game_word(wrapping(scene + I64{24})))
    game_line(out, rt_static_text("backend:headless/none/none"))
    game_line(out, rt_static_text("replay:"))
    if (replay == I64{0}) {
        jet_rt_string_builder_push(out, rt_static_text("<none>"))
    } else {
        jet_rt_string_builder_push(out, game_word(wrapping(game_word(replay) + I64{8})))
    }
    game_pairs_line(out, rt_static_text("assets:"), wrapping(state + I64{8}), wrapping(state + I64{32}), I64{58})
    game_pairs_line(out, rt_static_text("input:"), wrapping(state + I64{56}), wrapping(state + I64{80}), I64{61})
    game_list_line(out, rt_static_text("components:"), wrapping(state + I64{104}), I64{44})
    hash := game_hash_literal(GAME_TRANSCRIPT_OFFSET, rt_static_text("jet.game.transcript.v1"))
    callbacks :: wrapping(scene + I64{32})
    slot :: jet_rt_alloc(I64{8}, I64{8})
    scratch :: jet_rt_alloc(I64{16}, I64{8})
    loop {
        index :: game_backend_next(plan)
        if (index < I64{0}) { break }
        snapshot :: jet_rt_alloc(I64{32}, I64{8})
        coll_zero(snapshot, I64{32})
        game_store(snapshot, I64{1})
        if (replay != I64{0} && index == I64{1}) {
            bound := I64{0}
            loop bound < game_word(wrapping(state + I64{56})) {
                game_list_push(wrapping(snapshot + I64{8}), jet_rt_string_clone(game_list_text(wrapping(state + I64{56}), bound)))
                bound += I64{1}
            }
        }
        hash = game_hash_frame(hash, index, wrapping(snapshot + I64{8}))
        frame :: jet_rt_alloc(I64{24}, I64{8})
        game_store(frame, jet_int_owned_from_i64(index))
        game_store(wrapping(frame + I64{8}), snapshot)
        game_store(wrapping(frame + I64{16}), I64{1})
        game_store(slot, frame)
        stopped := false
        // The callbacks run one after another in registration order. That is
        // the reference order: a callback's checked frame schedule orders the
        // work inside it, and no schedule reorders one callback against another.
        data :: game_word(wrapping(callbacks + I64{16}))
        at := I64{0}
        loop at < game_word(callbacks) {
            coll_zero(scratch, I64{16})
            _ := coll_call3(game_word(wrapping(data + (at + I64{1}) * I64{8})), game_word(wrapping(data + at * I64{8})), slot, scratch)
            if (jet_rt_session_propagate() != I64{0}) {
                stopped = true
                break
            }
            at += I64{3}
        }
        game_line(out, rt_static_text("frame:"))
        rt_text_push_number(out, index)
        jet_rt_string_builder_push(out, rt_static_text(" input:"))
        if (game_word(wrapping(snapshot + I64{8})) == I64{0}) {
            jet_rt_string_builder_push(out, rt_static_text("none"))
        } else {
            game_join(out, wrapping(snapshot + I64{8}), I64{43})
        }
        jet_rt_handle_drop_jet_game_frame(frame)
        if stopped { break }
        jet_game_backend_present(plan)
    }
    jet_rt_free(scratch, I64{16}, I64{8})
    jet_rt_free(slot, I64{8}, I64{8})
    jet_rt_handle_drop_jet_game_backend(plan)
    if requested {
        game_line(out, rt_static_text("transcript_hash:"))
        game_push_hex(out, hash)
    }
    jet_rt_string_builder_finish(out)
}
