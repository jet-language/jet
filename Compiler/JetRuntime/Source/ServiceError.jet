}

#Export(c) jet_rt_record_get_jet_service_error_full: fn(value: I64) -> I64 {
    service_error_get(value, SERVICE_ERROR_FULL)
}

#Export(c) jet_rt_record_get_jet_service_error_ambiguous: fn(value: I64) -> I64 {
    service_error_get(value, SERVICE_ERROR_AMBIGUOUS)
}

#Export(c) jet_rt_record_get_jet_service_error_unknown: fn(value: I64) -> I64 {
