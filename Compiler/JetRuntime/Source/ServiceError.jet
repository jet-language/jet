// Private native tag/Text owner. Ctors borrow Text, getters clone after variant
// check.
service_error_new: fn(ordinal: I64, payload: I64) -> I64 {
    result: jet_rt_alloc(SERVICE_ERROR_BYTES, I64{8})
    encoding_store(wrapping(result + SERVICE_ERROR_TAG), ordinal)
    encoding_store(wrapping(result + SERVICE_ERROR_PAYLOAD), jet_rt_string_clone(payload))
    result
}
service_error_get: fn(value: I64, ordinal: I64) -> I64 {
    if encoding_word(wrapping(value + SERVICE_ERROR_TAG)) != ordinal -> rt_record_variant_panic()
    jet_rt_string_clone(encoding_word(wrapping(value + SERVICE_ERROR_PAYLOAD)))
}
#Export(c) jet_rt_handle_clone_jet_service_error: fn(value: I64) -> I64 {
    service_error_new(encoding_word(wrapping(value + SERVICE_ERROR_TAG)), encoding_word(wrapping(value + SERVICE_ERROR_PAYLOAD)))
}
#Export(c) jet_rt_handle_drop_jet_service_error: fn(value: I64) {
    if (value == I64{0}) -> return
    jet_rt_string_drop(encoding_word(wrapping(value + SERVICE_ERROR_PAYLOAD)))
    jet_rt_free(value, SERVICE_ERROR_BYTES, I64{8})
}
#Export(c) jet_rt_handle_eq_jet_service_error: fn(a: I64, b: I64) -> Bool {
    encoding_word(wrapping(a + SERVICE_ERROR_TAG)) == encoding_word(wrapping(b + SERVICE_ERROR_TAG))
        && jet_rt_string_eq(encoding_word(wrapping(a + SERVICE_ERROR_PAYLOAD)), encoding_word(wrapping(b + SERVICE_ERROR_PAYLOAD)))
}
// ALL ten variants return m.clone(), no label/quoting.
#Export(c) jet_rt_handle_show_jet_service_error: fn(value: I64) -> I64 { jet_rt_string_clone(encoding_word(wrapping(value + SERVICE_ERROR_PAYLOAD))) }
#Export(c) jet_rt_record_tag_jet_service_error: fn(value: I64) -> I64 { encoding_word(wrapping(value + SERVICE_ERROR_TAG)) }
#Export(c) jet_rt_record_new_jet_service_error_full: fn(payload: I64) -> I64 { service_error_new(I64{0}, payload) }
#Export(c) jet_rt_record_new_jet_service_error_ambiguous: fn(payload: I64) -> I64 { service_error_new(I64{1}, payload) }
#Export(c) jet_rt_record_new_jet_service_error_unknown: fn(payload: I64) -> I64 { service_error_new(I64{2}, payload) }
#Export(c) jet_rt_record_new_jet_service_error_not_started: fn(payload: I64) -> I64 { service_error_new(I64{3}, payload) }
#Export(c) jet_rt_record_new_jet_service_error_policy: fn(payload: I64) -> I64 { service_error_new(I64{4}, payload) }
#Export(c) jet_rt_record_new_jet_service_error_unavailable: fn(payload: I64) -> I64 { service_error_new(I64{5}, payload) }
#Export(c) jet_rt_record_new_jet_service_error_partitioned: fn(payload: I64) -> I64 { service_error_new(I64{6}, payload) }
#Export(c) jet_rt_record_new_jet_service_error_revoked: fn(payload: I64) -> I64 { service_error_new(I64{7}, payload) }
#Export(c) jet_rt_record_new_jet_service_error_stale: fn(payload: I64) -> I64 { service_error_new(I64{8}, payload) }
#Export(c) jet_rt_record_new_jet_service_error_expired: fn(payload: I64) -> I64 { service_error_new(I64{9}, payload) }
#Export(c) jet_rt_record_get_jet_service_error_full: fn(value: I64) -> I64 { service_error_get(value, I64{0}) }
#Export(c) jet_rt_record_get_jet_service_error_ambiguous: fn(value: I64) -> I64 { service_error_get(value, I64{1}) }
#Export(c) jet_rt_record_get_jet_service_error_unknown: fn(value: I64) -> I64 { service_error_get(value, I64{2}) }
#Export(c) jet_rt_record_get_jet_service_error_not_started: fn(value: I64) -> I64 { service_error_get(value, I64{3}) }
#Export(c) jet_rt_record_get_jet_service_error_policy: fn(value: I64) -> I64 { service_error_get(value, I64{4}) }
#Export(c) jet_rt_record_get_jet_service_error_unavailable: fn(value: I64) -> I64 { service_error_get(value, I64{5}) }
#Export(c) jet_rt_record_get_jet_service_error_partitioned: fn(value: I64) -> I64 { service_error_get(value, I64{6}) }
#Export(c) jet_rt_record_get_jet_service_error_revoked: fn(value: I64) -> I64 { service_error_get(value, I64{7}) }
#Export(c) jet_rt_record_get_jet_service_error_stale: fn(value: I64) -> I64 { service_error_get(value, I64{8}) }
#Export(c) jet_rt_record_get_jet_service_error_expired: fn(value: I64) -> I64 { service_error_get(value, I64{9}) }
