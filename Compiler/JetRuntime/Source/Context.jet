// Task-owned context carrier (#5025). TCB@48 points at the
// current Context record, so every context read is one load of that pointer.
// A thread's root record is appended to its TCB at CONTEXT_TCB_ROOT: code
// entered from C on a fresh thread starts from the root context. A task's
// record is appended to its Task state at TASK_CONTEXT (Task.jet); spawn
// copies the spawning record into it (a task sees the context as
// of spawn) and task_run points TCB@48 at it for the body, restoring the
// worker's pointer afterwards. #Context writes fields of the current record in
// place and restores them from a caller save area on exit, so a swap never
// allocates. Codegen may later pass the record pointer as a hidden argument
// without changing meaning. `context.<field>` reads (IR BuildTransact.jet
// ir_context_read) call jet_ctx_deadline_present and jet_ctx_deadline_ms
// (Deadline.jet), jet_ctx_thread (Thread.jet) and jet_ctx_scratch: the
// thread index is the running thread's, kept in its TCB at
// THREAD_TCB_INDEX, not in the record.
// Record, append-only (`logger` is core.log's key on the value chain):
// deadline present@0, deadline ms@8 (Deadline.jet), effect scope@16 (the
// innermost effect-scope frame node, 0 for none: Authority.jet),
// allocator@24 (the carrier of the innermost `#Context(allocator:)` block,
// 0 for the program heap: Alloc.jet's user allocators), values@32,
// scratch@40 (the `mem.Arena` handle of `context.scratch`, the task's
// scratch arena, 0 until its first use: context_scratch_arena; its
// reservation, at the handle's ARENA_BLOCKS, serves the
// `#Context(allocator: context.scratch)` blocks: Alloc.jet's arena blocks).
// The allocator slot owns one reference to its carrier, and a TCB's cache
// rows are blocked while its record names one (Alloc.jet alloc_cache_sync).
//
// values@32 is the head of the `#ContextKey` value chain, innermost first.
// A node is the counted box IR BuildTransact.jet ir_context_push_value
// builds: owners@0, release helper@16 (drops the value, frees the node),
// key word@24, next@32, value@40. The head slot owns one reference to its
// node and each node one to its next, so a spawned task's record shares its
// parent's chain by one retain (context_inherit) and a parent's pop never
// frees a node a task still sees. `context.get` (ir_context_get) copies the
// value of the first node with its key (jet_ctx_value_find).
CONTEXT_TCB_SLOT: I64{48}

CONTEXT_TCB_ROOT: I64{456}

CONTEXT_RECORD_BYTES: I64{48}

CONTEXT_DEADLINE_PRESENT: I64{0}

CONTEXT_DEADLINE_MS: I64{8}

CONTEXT_EFFECT_SCOPE: I64{16}

CONTEXT_ALLOCATOR: I64{24}

CONTEXT_VALUES: I64{32}

CONTEXT_SCRATCH: I64{40}

CONTEXT_NODE_RELEASE: I64{16}

CONTEXT_NODE_KEY: I64{24}

CONTEXT_NODE_NEXT: I64{32}

context_current: fn() -> I64 { sync_load(wrapping(thread_base() + CONTEXT_TCB_SLOT)) }

// TCB bytes including the appended root record, Alloc's kept large-mapping
// rows and window run stacks, and the stack segment words (Thread.jet;
// Alloc.jet ALLOC_LARGE_ROWS, ALLOC_WINDOW_ROWS; StackSegment.jet).
context_tcb_bytes: fn() -> I64 { STACK_TCB_END }

// A zeroed root record is the empty root context.
context_tcb_install_root: fn(tcb: I64) {
    sync_store(wrapping(tcb + CONTEXT_TCB_SLOT), tcb + CONTEXT_TCB_ROOT)
}

// Drops the scratch arena of a TCB's root record: a thread's detach and a
// fiber's teardown (Thread.jet, Fiber.jet).
context_tcb_release: fn(tcb: I64) { context_scratch_drop(wrapping(tcb + CONTEXT_TCB_ROOT)) }

// The scratch arena of `record`, the `mem.Arena` handle at its scratch
// word, made at the first use.
context_scratch_arena: fn(record: I64) -> I64 {
    slot: wrapping(record + CONTEXT_SCRATCH)
    kept: sync_load(slot)
    if (kept != I64{0}) { return kept }
    arena: jet_arena_new()
    sync_store(slot, arena)
    arena
}

// Drops the scratch arena of `record` (none: nothing), with every value
// stored in it and its reservation. No block over it is open.
context_scratch_drop: fn(record: I64) {
    slot: wrapping(record + CONTEXT_SCRATCH)
    arena: sync_load(slot)
    if (arena == I64{0}) {
        return
    }
    sync_store(slot, I64{0})
    jet_rt_handle_drop_jet_arena(arena)
}

// `context.scratch` (IR BuildTransact.jet ir_context_read): the address of
// the current record's scratch word, holding the task's scratch arena. The
// read is a view of that arena, which the task owns.
#Export(c) jet_ctx_scratch: fn() -> I64 {
    current: context_current()
    ^_: context_scratch_arena(current)
    wrapping(current + CONTEXT_SCRATCH)
}

// The blocks of `context.allocator`, core.mem's allocator that is always
// the current one (Core/Mem/Mem.jet `__ContextAllocator`, whose calls JetIR
// BuildRoutes.jet ir_core_context_block builds): jet_ctx_allocator_take
// answers the address of `size` bytes at a multiple of `align`, a power of
// two, or 0 when the current allocator refuses or the request is invalid.
// A user allocator's `#Context(allocator:)` block hands the request to that
// allocator as it is (context_user_take). Any other current allocator (an
// arena's block, else the program heap) serves one value of align 8
// (jet_rt_alloc_value_try) with room to round the address up to `align` and
// two header words below it: the value's size at address - 16 and its
// address at address - 8. jet_ctx_allocator_give hands a block of `size`
// bytes back to the allocator that served it, and jet_ctx_allocator_room
// answers the bytes from the address to the value's end, the most a block
// there can grow to; a user allocator's block cannot grow or shrink, since
// only that allocator knows its extent.
CONTEXT_BLOCK_HEADER: I64{16}

#Export(c) jet_ctx_allocator_take: fn(size: I64, align: I64) -> I64 {
    if (size < I64{0} || align <= I64{0} || align & wrapping(align - I64{1}) != I64{0}) {
        return I64{0}
    }
    carrier: context_user_carrier()
    if (carrier != I64{0}) { return context_user_take(carrier, size, align) }
    alignment: if (align < I64{8}) -> I64{8} else -> align
    slack: wrapping(CONTEXT_BLOCK_HEADER + wrapping(alignment - I64{8}))
    if (size > wrapping(I64{9223372036854775807} - slack)) { return I64{0} }
    total: wrapping(size + slack)
    value: jet_rt_alloc_value_try(total, I64{8})
    if (value == I64{0}) { return I64{0} }
    address: wrapping(wrapping(value + CONTEXT_BLOCK_HEADER) + wrapping(alignment - I64{1})) & wrapping(I64{0} - alignment)
    sync_store(wrapping(address - I64{16}), total)
    sync_store(wrapping(address - I64{8}), value)
    address
}

#Export(c) jet_ctx_allocator_give: fn(address: I64, size: I64) {
    if (address == I64{0}) {
        return
    }
    carrier: context_user_owner(address)
    if (carrier != I64{0}) {
        _: alloc_user_call(carrier, ALLOC_USER_GIVE, size, address)
        return
    }
    jet_rt_free(sync_load(wrapping(address - I64{8})), sync_load(wrapping(address - I64{16})), I64{8})
}

#Export(c) jet_ctx_allocator_room: fn(address: I64) -> I64 {
    if (address == I64{0} || context_user_owner(address) != I64{0}) { return I64{0} }
    wrapping(wrapping(sync_load(wrapping(address - I64{8})) + sync_load(wrapping(address - I64{16}))) - address)
}

// The current record's carrier when a user allocator's handler serves it,
// else 0 (an arena's carrier has no handler; Alloc.jet alloc_user_carrier_new).
context_user_carrier: fn() -> I64 {
    if (alloc_class_limit == I64{0}) { return I64{0} }
    slot: alloc_user_slot()
    if (slot == I64{0}) { return I64{0} }
    carrier: sync_load(slot)
    if (carrier == I64{0} || sync_load(wrapping(carrier + I64{8})) == I64{0}) -> I64{0} else -> carrier
}

// `size` bytes at `align` from `carrier`'s allocator, the very request its
// `allocate` sees, or 0 when it refuses or a stop is pending. As
// alloc_user_take, a block that is not inside one registered region goes
// back and counts as a refusal, and the region's record then names
// `carrier`, so context_user_owner finds the allocator again at the give.
context_user_take: fn(carrier: I64, size: I64, align: I64) -> I64 {
    if (scheduler_stop_pending() != I64{0}) { return I64{0} }
    block: alloc_user_call(carrier, ALLOC_USER_TAKE, size, align)
    if (block == I64{0}) { return I64{0} }
    last: wrapping(block + (if (size == I64{0}) -> I64{0} else -> wrapping(size - I64{1})))
    record: if (block & wrapping(align - I64{1}) != I64{0}) -> I64{0} else -> alloc_page_region(block)
    if (record == I64{0} || alloc_page_region(last) != record) {
        _: alloc_user_call(carrier, ALLOC_USER_GIVE, size, block)
        return I64{0}
    }
    alloc_user_bind(record, carrier)
    block
}

// The user allocator's carrier that served the block at `address`, else 0:
// the block came from an arena or the program heap.
context_user_owner: fn(address: I64) -> I64 {
    carrier: alloc_user_owner(address)
    if (carrier == I64{0} || sync_load(wrapping(carrier + I64{8})) == I64{0}) -> I64{0} else -> carrier
}

// Copies the current record into `record`, which then shares its value
// chain (one more owner of the head node). A task starts on the program
// heap: a `#Context(allocator:)` carrier serves only the block's own thread
// of control, and its `context.scratch` is its own.
context_inherit: fn(record: I64) {
    current: context_current()
    ^at: I64{0}
    loop at < CONTEXT_RECORD_BYTES {
        sync_store(wrapping(record + at), sync_load(wrapping(current + at)))
        at += I64{8}
    }
    sync_store(wrapping(record + CONTEXT_ALLOCATOR), I64{0})
    sync_store(wrapping(record + CONTEXT_SCRATCH), I64{0})
    head: sync_load(wrapping(record + CONTEXT_VALUES))
    if head != (I64{0}) -> jet_rt_native_closure_retain(head)
}

// Ends a task's record (Task.jet task_drop): its reference to its chain and
// its scratch arena.
context_release: fn(record: I64) {
    context_values_release(sync_load(wrapping(record + CONTEXT_VALUES)))
    context_scratch_drop(record)
}

// Fixed context key words (IR BuildTransact.jet ir_context_key_word):
// 1 = on_stop, 2 = dir (resolved absolute String), 3 = env (24-byte Map header
// of {key: String, val: String} pairs; 1-byte "\0" value = unset tombstone).
// Bit 62 marks a task-local imperative node (sys.set/unset/set_current_dir),
// which jet_ctx_value_pop skips so exiting a `#Context` block always pops its
// own block nodes.
CONTEXT_DIR_KEY: I64{2}

CONTEXT_ENV_KEY: I64{3}

// Unified breadcrumb frame stack node on CONTEXT_VALUES (88 bytes, release == 0):
//   0: owners, 8: reserved, 16: release(0), 24: key(CONTEXT_FRAME_KEY | IMPERATIVE),
//  32: next, 40: text(owned E4), 48: file(owned E4 or 0), 56: line,
//  64: id, 72: start_ns, 80: kind (0=#Frame block, 1=log.span, 2=perf.zone).
CONTEXT_FRAME_KEY: I64{4}

CONTEXT_FRAME_BYTES: I64{88}

CONTEXT_FRAME_TEXT: I64{40}

CONTEXT_FRAME_FILE: I64{48}

CONTEXT_FRAME_LINE: I64{56}

CONTEXT_FRAME_ID: I64{64}

CONTEXT_FRAME_START: I64{72}

CONTEXT_FRAME_KIND: I64{80}

CONTEXT_FRAME_KIND_BLOCK: I64{0}

CONTEXT_FRAME_KIND_LOG_SPAN: I64{1}

CONTEXT_FRAME_KIND_PERF_ZONE: I64{2}

CONTEXT_KEY_MASK: I64{4611686018427387903}

CONTEXT_IMPERATIVE_FLAG: I64{4611686018427387904}

CONTEXT_ENV_UNSET: I64{-1}

// Drops a runtime-allocated imperative context node (release helper == 0).
context_imperative_node_free: fn(node: I64) {
    key: sync_load(wrapping(node + CONTEXT_NODE_KEY)) & CONTEXT_KEY_MASK
    if (key == CONTEXT_DIR_KEY) {
        dir: sync_load(wrapping(node + I64{40}))
        if (dir != I64{0}) { jet_rt_string_drop(dir) }
        jet_rt_free(node, I64{48}, I64{8})
        return
    }
    if (key == CONTEXT_FRAME_KEY) {
        text: sync_load(wrapping(node + CONTEXT_FRAME_TEXT))
        if (text != I64{0}) { jet_rt_string_drop(text) }
        file: sync_load(wrapping(node + CONTEXT_FRAME_FILE))
        if (file != I64{0}) { jet_rt_string_drop(file) }
        jet_rt_free(node, CONTEXT_FRAME_BYTES, I64{8})
        return
    }
    if (key == CONTEXT_ENV_KEY) {
        len: sync_load(wrapping(node + I64{40}))
        cap: sync_load(wrapping(node + I64{48}))
        data: sync_load(wrapping(node + I64{56}))
        ^at: I64{0}
        loop at < len {
            row: wrapping(data + at * I64{16})
            jet_rt_string_drop(sync_load(row))
            jet_rt_string_drop(sync_load(wrapping(row + I64{8})))
            at += I64{1}
        }
        if (cap > I64{0} && data != I64{0}) {
            jet_rt_free(data, wrapping(cap * I64{16}), I64{8})
        }
        jet_rt_free(node, I64{64}, I64{8})
    }
}

// Clones an imperative node (with refcount 1 and next == 0) for copy-on-write
// when a spawned task shares the parent's chain via context_inherit.
context_imperative_node_clone: fn(node: I64) -> I64 {
    raw_key: sync_load(wrapping(node + CONTEXT_NODE_KEY))
    key: raw_key & CONTEXT_KEY_MASK
    if (key == CONTEXT_DIR_KEY) {
        fresh: jet_rt_alloc(I64{48}, I64{8})
        sync_store(fresh, I64{1})
        sync_store(wrapping(fresh + I64{8}), I64{0})
        sync_store(wrapping(fresh + CONTEXT_NODE_RELEASE), I64{0})
        sync_store(wrapping(fresh + CONTEXT_NODE_KEY), raw_key)
        sync_store(wrapping(fresh + CONTEXT_NODE_NEXT), I64{0})
        dir: sync_load(wrapping(node + I64{40}))
        sync_store(wrapping(fresh + I64{40}), if (dir == I64{0}) -> I64{0} else -> jet_rt_string_clone(dir))
        return fresh
    }
    if (key == CONTEXT_FRAME_KEY) {
        fresh: jet_rt_alloc(CONTEXT_FRAME_BYTES, I64{8})
        sync_store(fresh, I64{1})
        sync_store(wrapping(fresh + I64{8}), I64{0})
        sync_store(wrapping(fresh + CONTEXT_NODE_RELEASE), I64{0})
        sync_store(wrapping(fresh + CONTEXT_NODE_KEY), raw_key)
        sync_store(wrapping(fresh + CONTEXT_NODE_NEXT), I64{0})
        text: sync_load(wrapping(node + CONTEXT_FRAME_TEXT))
        file: sync_load(wrapping(node + CONTEXT_FRAME_FILE))
        sync_store(wrapping(fresh + CONTEXT_FRAME_TEXT), if (text == I64{0}) -> I64{0} else -> jet_rt_string_clone(text))
        sync_store(wrapping(fresh + CONTEXT_FRAME_FILE), if (file == I64{0}) -> I64{0} else -> jet_rt_string_clone(file))
        sync_store(wrapping(fresh + CONTEXT_FRAME_LINE), sync_load(wrapping(node + CONTEXT_FRAME_LINE)))
        sync_store(wrapping(fresh + CONTEXT_FRAME_ID), sync_load(wrapping(node + CONTEXT_FRAME_ID)))
        sync_store(wrapping(fresh + CONTEXT_FRAME_START), sync_load(wrapping(node + CONTEXT_FRAME_START)))
        sync_store(wrapping(fresh + CONTEXT_FRAME_KIND), sync_load(wrapping(node + CONTEXT_FRAME_KIND)))
        return fresh
    }
    len: sync_load(wrapping(node + I64{40}))
    cap: if (len < I64{4}) -> I64{4} else -> len
    data: jet_rt_alloc(wrapping(cap * I64{16}), I64{8})
    src: sync_load(wrapping(node + I64{56}))
    ^at: I64{0}
    loop at < len {
        srow: wrapping(src + at * I64{16})
        drow: wrapping(data + at * I64{16})
        sync_store(drow, jet_rt_string_clone(sync_load(srow)))
        sync_store(wrapping(drow + I64{8}), jet_rt_string_clone(sync_load(wrapping(srow + I64{8}))))
        at += I64{1}
    }
    fresh: jet_rt_alloc(I64{64}, I64{8})
    sync_store(fresh, I64{1})
    sync_store(wrapping(fresh + I64{8}), I64{0})
    sync_store(wrapping(fresh + CONTEXT_NODE_RELEASE), I64{0})
    sync_store(wrapping(fresh + CONTEXT_NODE_KEY), raw_key)
    sync_store(wrapping(fresh + CONTEXT_NODE_NEXT), I64{0})
    sync_store(wrapping(fresh + I64{40}), len)
    sync_store(wrapping(fresh + I64{48}), cap)
    sync_store(wrapping(fresh + I64{56}), data)
    fresh
}

// Drops one reference to `node` (0: none); a last owner's release helper
// drops its value and frees it, and its reference to the next node goes
// the same way.
context_values_release: fn(node: I64) {
    ^at: node
    loop at != (I64{0}) {
        if !jet_rt_native_closure_unref(at) {
            return
        }
        next: sync_load(wrapping(at + CONTEXT_NODE_NEXT))
        release: sync_load(wrapping(at + CONTEXT_NODE_RELEASE))
        if (release == I64{0}) {
            context_imperative_node_free(at)
        } else {
            before: jet_scheduler_native_status()
            coll_call1_unit(release, at)
            scheduler_hook_checks_arm(before)
        }
        at = next
    }
}

// OS getcwd(2) as an owned String, or 0 on failure. Used only as the base when
// no `#Context(dir:)` is active on the current task.
context_os_getcwd: fn() -> I64 {
    ^capacity: I64{512}
    loop {
        bytes: jet_rt_alloc(capacity, I64{8})
        result: host_call(I64{79}, bytes, capacity, I64{0})
        if (result > I64{0}) {
            if (rt_text_byte(bytes) == I64{47}) {
                text: rt_text_lossy(bytes, result - I64{1})
                jet_rt_free(bytes, capacity, I64{8})
                return text
            }
            jet_rt_free(bytes, capacity, I64{8})
            return I64{0}
        }
        jet_rt_free(bytes, capacity, I64{8})
        if (result != I64{-34}) { return I64{0} }
        capacity *= I64{2}
    }
}

// Lexically normalize an absolute POSIX path (`bytes[0..<length]`, starting
// with '/'): collapses duplicate '/', '/./', and '/../', stripping a trailing
// '/' except for "/". Returns an owned String.
context_dir_normalize: fn(bytes: I64, length: I64) -> I64 {
    // Store (start, len) of each kept path segment in a scratch array.
    ^seg_cap: I64{16}
    ^segs: jet_rt_alloc(wrapping(seg_cap * I64{16}), I64{8})
    ^seg_len: I64{0}
    ^at: I64{0}
    loop at < length {
        loop at < length && rt_text_byte(wrapping(bytes + at)) == (I64{47}) -> at += I64{1}
        start: at
        loop at < length && rt_text_byte(wrapping(bytes + at)) != (I64{47}) -> at += I64{1}
        part_len: at - start
        if (part_len == I64{0}) { next }
        if (part_len == I64{1} && rt_text_byte(wrapping(bytes + start)) == I64{46}) { next }
        if (part_len == I64{2} && rt_text_byte(wrapping(bytes + start)) == I64{46} && rt_text_byte(wrapping(wrapping(bytes + start) + I64{1})) == I64{46}) {
            if (seg_len > I64{0}) { seg_len -= I64{1} }
            next
        }
        if (seg_len == seg_cap) {
            grown: seg_cap * I64{2}
            next_segs: jet_rt_alloc(wrapping(grown * I64{16}), I64{8})
            coll_copy(segs, next_segs, wrapping(seg_cap * I64{16}))
            jet_rt_free(segs, wrapping(seg_cap * I64{16}), I64{8})
            segs = next_segs
            seg_cap = grown
        }
        row: wrapping(segs + seg_len * I64{16})
        rt_text_store(row, start)
        rt_text_store(wrapping(row + I64{8}), part_len)
        seg_len += I64{1}
    }
    builder: jet_rt_string_builder_new()
    if (seg_len == I64{0}) {
        jet_rt_string_builder_push(builder, rt_static_text("/"))
    } else {
        ^i: I64{0}
        loop i < seg_len {
            row: wrapping(segs + i * I64{16})
            jet_rt_string_builder_push(builder, rt_static_text("/"))
            rt_text_append(builder, wrapping(bytes + rt_text_word(row)), rt_text_word(wrapping(row + I64{8})))
            i += I64{1}
        }
    }
    jet_rt_free(segs, wrapping(seg_cap * I64{16}), I64{8})
    jet_rt_string_builder_finish(builder)
}

// Resolve `raw` (borrowed String) against the current task's working directory
// (or OS getcwd) into a normalized absolute owned String.
context_dir_resolve_owned: fn(raw: I64) -> I64 {
    len: rt_text_len(raw)
    data: rt_text_data(raw)
    if (len > I64{0} && rt_text_byte(data) == I64{47}) {
        return context_dir_normalize(data, len)
    }
    cur: context_dir_current()
    base: if (cur != I64{0}) -> jet_rt_string_clone(cur) else -> context_os_getcwd()
    if (base == I64{0}) { return jet_rt_string_clone(raw) }
    if (len == I64{0}) { return base }
    builder: jet_rt_string_builder_new()
    jet_rt_string_builder_push(builder, base)
    jet_rt_string_builder_push(builder, rt_static_text("/"))
    jet_rt_string_builder_push(builder, raw)
    joined: jet_rt_string_builder_finish(builder)
    jet_rt_string_drop(base)
    normalized: context_dir_normalize(rt_text_data(joined), rt_text_len(joined))
    jet_rt_string_drop(joined)
    normalized
}

// The innermost task-context working directory String (borrowed), or 0 when
// no `#Context(dir:)` or task-local chdir is active on this task.
context_dir_current: fn() -> I64 {
    base: thread_base()
    if (base == I64{0} || base == thread_detached_base()) { return I64{0} }
    record: sync_load(wrapping(base + CONTEXT_TCB_SLOT))
    if (record == I64{0}) { return I64{0} }
    ^at: sync_load(wrapping(record + CONTEXT_VALUES))
    loop at != (I64{0}) {
        if ((sync_load(wrapping(at + CONTEXT_NODE_KEY)) & CONTEXT_KEY_MASK) == CONTEXT_DIR_KEY) {
            return sync_load(wrapping(at + I64{40}))
        }
        at = sync_load(wrapping(at + CONTEXT_NODE_NEXT))
    }
    I64{0}
}

// Install `resolved` (owned String, ownership transferred) as this task's
// imperative working directory without calling OS chdir(2).
context_dir_set_imperative: fn(resolved: I64) {
    head_slot: wrapping(context_current() + CONTEXT_VALUES)
    head: sync_load(head_slot)
    if (head != I64{0} && sync_load(wrapping(head + CONTEXT_NODE_KEY)) == (CONTEXT_DIR_KEY | CONTEXT_IMPERATIVE_FLAG) && sync_load(head) == I64{1}) {
        old: sync_load(wrapping(head + I64{40}))
        sync_store(wrapping(head + I64{40}), resolved)
        if (old != I64{0}) { jet_rt_string_drop(old) }
        return
    }
    node: jet_rt_alloc(I64{48}, I64{8})
    sync_store(node, I64{1})
    sync_store(wrapping(node + I64{8}), I64{0})
    sync_store(wrapping(node + CONTEXT_NODE_RELEASE), I64{0})
    sync_store(wrapping(node + CONTEXT_NODE_KEY), CONTEXT_DIR_KEY | CONTEXT_IMPERATIVE_FLAG)
    sync_store(wrapping(node + CONTEXT_NODE_NEXT), head)
    sync_store(wrapping(node + I64{40}), resolved)
    sync_store(head_slot, node)
}

// Whether `val` (String) is the 1-byte "\0" unset tombstone.
context_env_is_tombstone: fn(val: I64) -> Bool {
    rt_text_len(val) == I64{1} && rt_text_byte(rt_text_data(val)) == I64{0}
}

// Fresh 1-byte "\0" String marking an unset environment variable.
context_env_tombstone: fn() -> I64 {
    buf: jet_rt_alloc(I64{1}, I64{1})
    rt_text_put(buf, I64{0})
    text: rt_text_copy(buf, I64{1})
    jet_rt_free(buf, I64{1}, I64{1})
    text
}

// Validate every entry of a `#Context(env: ...)` node before linking it.
context_env_validate_node: fn(node: I64) {
    len: sync_load(wrapping(node + I64{40}))
    data: sync_load(wrapping(node + I64{56}))
    ^at: I64{0}
    loop at < len {
        row: wrapping(data + at * I64{16})
        k: sync_load(row)
        v: sync_load(wrapping(row + I64{8}))
        if !logical_environment_valid_name(k) {
            walk_panic(rt_static_text("core.sys.set: invalid environment variable name"))
            return
        }
        if walk_has_nul(rt_text_data(v), rt_text_len(v)) {
            walk_panic(rt_static_text("core.sys.set: invalid environment variable value"))
            return
        }
        at += I64{1}
    }
}

// Look up `(bytes, length)` across this task's `CONTEXT_ENV_KEY` chain
// innermost-first: returns a borrowed value String (>0), CONTEXT_ENV_UNSET (-1)
// if explicitly unset, or 0 to fall through to the base environment.
context_env_lookup: fn(bytes: I64, length: I64) -> I64 {
    base: thread_base()
    if (base == I64{0} || base == thread_detached_base()) { return I64{0} }
    record: sync_load(wrapping(base + CONTEXT_TCB_SLOT))
    if (record == I64{0}) { return I64{0} }
    ^at: sync_load(wrapping(record + CONTEXT_VALUES))
    loop at != (I64{0}) {
        if ((sync_load(wrapping(at + CONTEXT_NODE_KEY)) & CONTEXT_KEY_MASK) == CONTEXT_ENV_KEY) {
            len: sync_load(wrapping(at + I64{40}))
            data: sync_load(wrapping(at + I64{56}))
            ^i: len - I64{1}
            loop i >= (I64{0}) {
                row: wrapping(data + i * I64{16})
                k: sync_load(row)
                if (rt_text_len(k) == length && rt_text_equal_bytes(rt_text_data(k), bytes, length)) {
                    v: sync_load(wrapping(row + I64{8}))
                    if context_env_is_tombstone(v) { return CONTEXT_ENV_UNSET }
                    return v
                }
                i -= I64{1}
            }
        }
        at = sync_load(wrapping(at + CONTEXT_NODE_NEXT))
    }
    I64{0}
}

// Update or insert `(key, value)` (value == 0 -> unset tombstone) in this
// task's imperative `CONTEXT_ENV_KEY` overlay (mutating in place when the head
// is an unshared imperative env node, else pushing a fresh imperative node).
context_env_set_imperative: fn(key: I64, value: I64) {
    head_slot: wrapping(context_current() + CONTEXT_VALUES)
    head: sync_load(head_slot)
    stored_val: if (value == I64{0}) -> context_env_tombstone() else -> jet_rt_string_clone(value)
    if (head != I64{0} && sync_load(wrapping(head + CONTEXT_NODE_KEY)) == (CONTEXT_ENV_KEY | CONTEXT_IMPERATIVE_FLAG) && sync_load(head) == I64{1}) {
        len: sync_load(wrapping(head + I64{40}))
        cap: sync_load(wrapping(head + I64{48}))
        ^data: sync_load(wrapping(head + I64{56}))
        ^i: I64{0}
        loop i < len {
            row: wrapping(data + i * I64{16})
            if jet_rt_string_eq(sync_load(row), key) {
                old_val: sync_load(wrapping(row + I64{8}))
                sync_store(wrapping(row + I64{8}), stored_val)
                jet_rt_string_drop(old_val)
                return
            }
            i += I64{1}
        }
        if (len == cap) {
            grown: if (cap == I64{0}) -> I64{4} else -> cap * I64{2}
            next_data: jet_rt_alloc(wrapping(grown * I64{16}), I64{8})
            if (len > I64{0}) { coll_copy(data, next_data, wrapping(len * I64{16})) }
            if (cap > I64{0} && data != I64{0}) { jet_rt_free(data, wrapping(cap * I64{16}), I64{8}) }
            data = next_data
            sync_store(wrapping(head + I64{48}), grown)
            sync_store(wrapping(head + I64{56}), data)
        }
        row: wrapping(data + len * I64{16})
        sync_store(row, jet_rt_string_clone(key))
        sync_store(wrapping(row + I64{8}), stored_val)
        sync_store(wrapping(head + I64{40}), len + I64{1})
        return
    }
    data: jet_rt_alloc(I64{64}, I64{8})
    sync_store(data, jet_rt_string_clone(key))
    sync_store(wrapping(data + I64{8}), stored_val)
    node: jet_rt_alloc(I64{64}, I64{8})
    sync_store(node, I64{1})
    sync_store(wrapping(node + I64{8}), I64{0})
    sync_store(wrapping(node + CONTEXT_NODE_RELEASE), I64{0})
    sync_store(wrapping(node + CONTEXT_NODE_KEY), CONTEXT_ENV_KEY | CONTEXT_IMPERATIVE_FLAG)
    sync_store(wrapping(node + CONTEXT_NODE_NEXT), head)
    sync_store(wrapping(node + I64{40}), I64{1})
    sync_store(wrapping(node + I64{48}), I64{4})
    sync_store(wrapping(node + I64{56}), data)
    sync_store(head_slot, node)
}

// Collect all `CONTEXT_ENV_KEY` nodes of this task in outermost-to-innermost
// order into a newly allocated buffer (caller frees `count * 8` bytes).
// Writes count to `out_count` and returns buffer pointer (0 when count == 0).
context_env_nodes_outer_to_inner: fn(out_count: I64) -> I64 {
    rt_text_store(out_count, I64{0})
    base: thread_base()
    if (base == I64{0} || base == thread_detached_base()) { return I64{0} }
    record: sync_load(wrapping(base + CONTEXT_TCB_SLOT))
    if (record == I64{0}) { return I64{0} }
    ^count: I64{0}
    ^at: sync_load(wrapping(record + CONTEXT_VALUES))
    loop at != (I64{0}) {
        if ((sync_load(wrapping(at + CONTEXT_NODE_KEY)) & CONTEXT_KEY_MASK) == CONTEXT_ENV_KEY) {
            count += I64{1}
        }
        at = sync_load(wrapping(at + CONTEXT_NODE_NEXT))
    }
    if (count == I64{0}) { return I64{0} }
    buf: jet_rt_alloc(wrapping(count * I64{8}), I64{8})
    ^pos: count - I64{1}
    at = sync_load(wrapping(record + CONTEXT_VALUES))
    loop at != (I64{0}) {
        if ((sync_load(wrapping(at + CONTEXT_NODE_KEY)) & CONTEXT_KEY_MASK) == CONTEXT_ENV_KEY) {
            rt_text_store(wrapping(buf + pos * I64{8}), at)
            pos -= I64{1}
        }
        at = sync_load(wrapping(at + CONTEXT_NODE_NEXT))
    }
    rt_text_store(out_count, count)
    buf
}

// The current task's Context record, or 0 on a detached or uninitialized
// thread (such as standalone C runtime tests without a TCB).
context_current_safe: fn() -> I64 {
    base: thread_base()
    if (base == I64{0} || base == thread_detached_base()) { return I64{0} }
    sync_load(wrapping(base + CONTEXT_TCB_SLOT))
}

// Push one unified breadcrumb frame node onto the current task's CONTEXT_VALUES
// chain. Returns the frame's matching id (its initial node address when `id == 0`),
// or 0 if no task context record is installed.
context_frame_push: fn(text: I64, file: I64, line: I64, id: I64, start_ns: I64, kind: I64) -> I64 {
    record: context_current_safe()
    if (record == I64{0}) { return I64{0} }
    head_slot: wrapping(record + CONTEXT_VALUES)
    head: sync_load(head_slot)
    node: jet_rt_alloc(CONTEXT_FRAME_BYTES, I64{8})
    assigned_id: if (id == I64{0}) -> node else -> id
    sync_store(node, I64{1})
    sync_store(wrapping(node + I64{8}), I64{0})
    sync_store(wrapping(node + CONTEXT_NODE_RELEASE), I64{0})
    sync_store(wrapping(node + CONTEXT_NODE_KEY), CONTEXT_FRAME_KEY | CONTEXT_IMPERATIVE_FLAG)
    sync_store(wrapping(node + CONTEXT_NODE_NEXT), head)
    sync_store(wrapping(node + CONTEXT_FRAME_TEXT), if (text == I64{0}) -> I64{0} else -> jet_rt_string_clone(text))
    sync_store(wrapping(node + CONTEXT_FRAME_FILE), if (file == I64{0}) -> I64{0} else -> jet_rt_string_clone(file))
    sync_store(wrapping(node + CONTEXT_FRAME_LINE), line)
    sync_store(wrapping(node + CONTEXT_FRAME_ID), assigned_id)
    sync_store(wrapping(node + CONTEXT_FRAME_START), start_ns)
    sync_store(wrapping(node + CONTEXT_FRAME_KIND), kind)
    sync_store(head_slot, node)
    assigned_id
}

// Collect active CONTEXT_FRAME_KEY text strings from `start_node` down to the
// chain tail in outermost-to-innermost order. Caller frees `count * 8` bytes.
context_frame_texts_outer_to_inner: fn(start_node: I64, out_count: I64) -> I64 {
    rt_text_store(out_count, I64{0})
    ^count: I64{0}
    ^at: start_node
    loop at != (I64{0}) {
        if ((sync_load(wrapping(at + CONTEXT_NODE_KEY)) & CONTEXT_KEY_MASK) == CONTEXT_FRAME_KEY && sync_load(wrapping(at + CONTEXT_FRAME_KIND)) >= I64{0}) {
            count += I64{1}
        }
        at = sync_load(wrapping(at + CONTEXT_NODE_NEXT))
    }
    if (count == I64{0}) { return I64{0} }
    buf: jet_rt_alloc(wrapping(count * I64{8}), I64{8})
    ^pos: count - I64{1}
    at = start_node
    loop at != (I64{0}) {
        if ((sync_load(wrapping(at + CONTEXT_NODE_KEY)) & CONTEXT_KEY_MASK) == CONTEXT_FRAME_KEY && sync_load(wrapping(at + CONTEXT_FRAME_KIND)) >= I64{0}) {
            rt_text_store(wrapping(buf + pos * I64{8}), sync_load(wrapping(at + CONTEXT_FRAME_TEXT)))
            pos -= I64{1}
        }
        at = sync_load(wrapping(at + CONTEXT_NODE_NEXT))
    }
    rt_text_store(out_count, count)
    buf
}

// Build an owned canonical breadcrumb path `outer > inner` from `start_node`
// down the chain, or 0 when no active frames exist.
context_frame_build_path_from: fn(start_node: I64) -> I64 {
    count_slot: jet_rt_alloc(I64{8}, I64{8})
    texts: context_frame_texts_outer_to_inner(start_node, count_slot)
    count: rt_text_word(count_slot)
    jet_rt_free(count_slot, I64{8}, I64{8})
    if (count == I64{0}) { return I64{0} }
    builder: jet_rt_string_builder_new()
    ^i: I64{0}
    loop i < count {
        if (i != I64{0}) { jet_rt_string_builder_push(builder, rt_static_text(" > ")) }
        text: rt_text_word(wrapping(texts + i * I64{8}))
        if (text != I64{0}) { jet_rt_string_builder_push(builder, text) }
        i += I64{1}
    }
    jet_rt_free(texts, wrapping(count * I64{8}), I64{8})
    jet_rt_string_builder_finish(builder)
}

// Unlink the innermost active CONTEXT_FRAME_KEY node matching `match_kind`
// (and `match_id`, or any id when `match_id == 0`). Uses O(1) head pop when
// at the chain head, in-place unlink when the prefix is unshared, or pure
// copy-on-write cloning when a spawned task shares an imperative prefix.
context_frame_pop_match: fn(match_kind: I64, match_id: I64, out_text: I64, out_start: I64, out_path: I64) -> Bool {
    record: context_current_safe()
    if (record == I64{0}) { return false }
    head_slot: wrapping(record + CONTEXT_VALUES)
    head: sync_load(head_slot)
    if (head == I64{0}) { return false }
    ^prev: I64{0}
    ^cur: head
    ^all_unshared: true
    ^all_imperative: true
    loop cur != (I64{0}) {
        if ((sync_load(wrapping(cur + CONTEXT_NODE_KEY)) & CONTEXT_KEY_MASK) == CONTEXT_FRAME_KEY && sync_load(wrapping(cur + CONTEXT_FRAME_KIND)) == match_kind && (match_id == I64{0} || sync_load(wrapping(cur + CONTEXT_FRAME_ID)) == match_id)) {
            break
        }
        if (sync_load(cur) != I64{1}) { all_unshared = false }
        if (sync_load(wrapping(cur + CONTEXT_NODE_RELEASE)) != I64{0}) { all_imperative = false }
        prev = cur
        cur = sync_load(wrapping(cur + CONTEXT_NODE_NEXT))
    }
    if (cur == I64{0}) { return false }
    if (out_text != I64{0}) {
        text: sync_load(wrapping(cur + CONTEXT_FRAME_TEXT))
        rt_text_store(out_text, if (text == I64{0}) -> I64{0} else -> jet_rt_string_clone(text))
    }
    if (out_start != I64{0}) {
        rt_text_store(out_start, sync_load(wrapping(cur + CONTEXT_FRAME_START)))
    }
    if (out_path != I64{0}) {
        rt_text_store(out_path, context_frame_build_path_from(cur))
    }
    after: sync_load(wrapping(cur + CONTEXT_NODE_NEXT))
    if (prev == I64{0}) {
        if after != (I64{0}) -> jet_rt_native_closure_retain(after)
        sync_store(head_slot, after)
        context_values_release(cur)
        return true
    }
    if all_unshared {
        if after != (I64{0}) -> jet_rt_native_closure_retain(after)
        sync_store(wrapping(prev + CONTEXT_NODE_NEXT), after)
        context_values_release(cur)
        return true
    }
    if all_imperative {
        ^new_head: I64{0}
        ^new_tail: I64{0}
        ^walk: head
        loop walk != cur {
            cloned: context_imperative_node_clone(walk)
            if (new_head == I64{0}) { new_head = cloned } else {
                sync_store(wrapping(new_tail + CONTEXT_NODE_NEXT), cloned)
            }
            new_tail = cloned
            walk = sync_load(wrapping(walk + CONTEXT_NODE_NEXT))
        }
        if after != (I64{0}) -> jet_rt_native_closure_retain(after)
        sync_store(wrapping(new_tail + CONTEXT_NODE_NEXT), after)
        sync_store(head_slot, new_head)
        context_values_release(head)
        return true
    }
    sync_store(wrapping(cur + CONTEXT_FRAME_KIND), I64{-1})
    true
}

// `#Frame(text) { ... }` entry: push a task-inherited breadcrumb frame.
#Export(c) jet_ctx_push_frame: fn(text: I64, file: I64, line: I64) -> I64 {
    start_ns: if (perf_spans_fd >= I64{0} || perf_zones_on != I64{0}) -> perf_zone_now() else -> I64{0}
    id: context_frame_push(text, file, line, I64{0}, start_ns, CONTEXT_FRAME_KIND_BLOCK)
    observe_task_count(OBSERVE_TASK_SPANS, I64{1})
    id
}

// `#Frame(text) { ... }` exit: record its perf zone row when profiling and pop
// the frame from the current task's context chain.
#Export(c) jet_ctx_pop_frame: fn(id: I64) {
    profiling: perf_spans_fd >= I64{0} || perf_zones_on != I64{0}
    if !profiling {
        if context_frame_pop_match(CONTEXT_FRAME_KIND_BLOCK, id, I64{0}, I64{0}, I64{0}) {
            observe_task_count(OBSERVE_TASK_SPANS, I64{-1})
        }
        return
    }
    out: jet_rt_alloc(I64{16}, I64{8})
    rt_text_store(out, I64{0})
    rt_text_store(wrapping(out + I64{8}), I64{0})
    popped: context_frame_pop_match(CONTEXT_FRAME_KIND_BLOCK, id, I64{0}, out, wrapping(out + I64{8}))
    if popped {
        start_ns: rt_text_word(out)
        path: rt_text_word(wrapping(out + I64{8}))
        if (start_ns != I64{0} && path != I64{0}) {
            perf_zone_row(PERF_ZONE_ZONE, start_ns, perf_zone_now(), path)
        }
        if (path != I64{0}) { jet_rt_string_drop(path) }
        observe_task_count(OBSERVE_TASK_SPANS, I64{-1})
    }
    jet_rt_free(out, I64{16}, I64{8})
}

// Snapshot active CONTEXT_FRAME_KEY breadcrumbs innermost-first into a freshly
// created Err96's ERR_CONTEXT list.
context_frame_snapshot_to_err: fn(err_ptr: I64) {
    record: context_current_safe()
    if (record == I64{0}) { return }
    ^at: sync_load(wrapping(record + CONTEXT_VALUES))
    loop at != (I64{0}) {
        if ((sync_load(wrapping(at + CONTEXT_NODE_KEY)) & CONTEXT_KEY_MASK) == CONTEXT_FRAME_KEY && sync_load(wrapping(at + CONTEXT_FRAME_KIND)) >= I64{0}) {
            row: err_rows_append(wrapping(err_ptr + ERR_CONTEXT), ERR_CONTEXT_BYTES)
            text: sync_load(wrapping(at + CONTEXT_FRAME_TEXT))
            file: sync_load(wrapping(at + CONTEXT_FRAME_FILE))
            line: sync_load(wrapping(at + CONTEXT_FRAME_LINE))
            rt_text_store(row, if (text == I64{0}) -> jet_rt_string_clone(rt_static_text("")) else -> jet_rt_string_clone(text))
            rt_text_store(wrapping(row + I64{8}), if (file == I64{0}) -> jet_rt_string_clone(rt_static_text("")) else -> jet_rt_string_clone(file))
            rt_text_store(wrapping(row + I64{16}), line & I64{4294967295})
        }
        at = sync_load(wrapping(at + CONTEXT_NODE_NEXT))
    }
}

// Append `,"spans":["outer","inner"]` to a JSON log record when any frame is
// active on the current task.
context_frame_push_json: fn(target: I64) {
    record: context_current_safe()
    if (record == I64{0}) { return }
    head: sync_load(wrapping(record + CONTEXT_VALUES))
    if (head == I64{0}) { return }
    count_slot: jet_rt_alloc(I64{8}, I64{8})
    texts: context_frame_texts_outer_to_inner(head, count_slot)
    count: rt_text_word(count_slot)
    jet_rt_free(count_slot, I64{8}, I64{8})
    if (count == I64{0}) { return }
    jet_rt_string_builder_push(target, rt_static_text(",\"spans\":["))
    ^i: I64{0}
    loop i < count {
        if (i != I64{0}) { jet_rt_string_builder_push(target, rt_static_text(",")) }
        jet_rt_string_builder_push(target, rt_static_text("\""))
        text: rt_text_word(wrapping(texts + i * I64{8}))
        if (text != I64{0}) { log_json_escape_push(target, text) }
        jet_rt_string_builder_push(target, rt_static_text("\""))
        i += I64{1}
    }
    jet_rt_string_builder_push(target, rt_static_text("]"))
    jet_rt_free(texts, wrapping(count * I64{8}), I64{8})
}

// Append ` frames=[outer > inner]` to a text log line when any frame is active
// on the current task (canonical rendering shared with `jet perf` and `jet debug`).
context_frame_push_text: fn(target: I64) {
    record: context_current_safe()
    if (record == I64{0}) { return }
    head: sync_load(wrapping(record + CONTEXT_VALUES))
    if (head == I64{0}) { return }
    count_slot: jet_rt_alloc(I64{8}, I64{8})
    texts: context_frame_texts_outer_to_inner(head, count_slot)
    count: rt_text_word(count_slot)
    jet_rt_free(count_slot, I64{8}, I64{8})
    if (count == I64{0}) { return }
    jet_rt_string_builder_push(target, rt_static_text(" frames=["))
    ^i: I64{0}
    loop i < count {
        if (i != I64{0}) { jet_rt_string_builder_push(target, rt_static_text(" > ")) }
        text: rt_text_word(wrapping(texts + i * I64{8}))
        if (text != I64{0}) { jet_rt_string_builder_push(target, text) }
        i += I64{1}
    }
    jet_rt_string_builder_push(target, rt_static_text("]"))
    jet_rt_free(texts, wrapping(count * I64{8}), I64{8})
}


// `#Context(key: value)` entry: `node`, a new node with one owner, goes in
// front of the current record's chain, taking over the head's reference.
// For CONTEXT_DIR_KEY, resolves relative paths against the enclosing context
// dir before linking; for CONTEXT_ENV_KEY, validates every key and value.
#Export(c) jet_ctx_value_push: fn(node: I64) {
    key: sync_load(wrapping(node + CONTEXT_NODE_KEY))
    if (key == CONTEXT_DIR_KEY) {
        raw: sync_load(wrapping(node + I64{40}))
        resolved: context_dir_resolve_owned(raw)
        sync_store(wrapping(node + I64{40}), resolved)
        jet_rt_string_drop(raw)
    } else if (key == CONTEXT_ENV_KEY) {
        context_env_validate_node(node)
    }
    head: wrapping(context_current() + CONTEXT_VALUES)
    sync_store(wrapping(node + CONTEXT_NODE_NEXT), sync_load(head))
    sync_store(head, node)
}

// Unlinks the innermost non-imperative node from the current record's chain,
// copy-on-writing any shared imperative prefix sitting above it so spawned
// tasks keep their inherited chain untouched.
context_pop_one_block: fn(head_slot: I64) {
    head: sync_load(head_slot)
    if (head == I64{0}) { return }
    if ((sync_load(wrapping(head + CONTEXT_NODE_KEY)) & CONTEXT_IMPERATIVE_FLAG) == I64{0}) {
        next: sync_load(wrapping(head + CONTEXT_NODE_NEXT))
        if next != (I64{0}) -> jet_rt_native_closure_retain(next)
        sync_store(head_slot, next)
        context_values_release(head)
        return
    }
    // Count imperative nodes above the first block node.
    ^imp_count: I64{0}
    ^target: head
    loop target != (I64{0}) && (sync_load(wrapping(target + CONTEXT_NODE_KEY)) & CONTEXT_IMPERATIVE_FLAG) != (I64{0}) {
        imp_count += I64{1}
        target = sync_load(wrapping(target + CONTEXT_NODE_NEXT))
    }
    if (target == I64{0}) { return }
    target_key: sync_load(wrapping(target + CONTEXT_NODE_KEY)) & CONTEXT_KEY_MASK
    after: sync_load(wrapping(target + CONTEXT_NODE_NEXT))
    // Clone only imperative nodes of other keys; imperative mutations of
    // `target_key` made inside this `#Context` block unwind with the block.
    ^new_head: I64{0}
    ^new_tail: I64{0}
    ^cur: head
    ^i: I64{0}
    loop i < imp_count {
        if ((sync_load(wrapping(cur + CONTEXT_NODE_KEY)) & CONTEXT_KEY_MASK) != target_key) {
            cloned: context_imperative_node_clone(cur)
            if (new_head == I64{0}) { new_head = cloned } else {
                sync_store(wrapping(new_tail + CONTEXT_NODE_NEXT), cloned)
            }
            new_tail = cloned
        }
        cur = sync_load(wrapping(cur + CONTEXT_NODE_NEXT))
        i += I64{1}
    }
    if after != (I64{0}) -> jet_rt_native_closure_retain(after)
    if (new_head == I64{0}) {
        sync_store(head_slot, after)
    } else {
        sync_store(wrapping(new_tail + CONTEXT_NODE_NEXT), after)
        sync_store(head_slot, new_head)
    }
    context_values_release(head)
}

// `#Context(key: value)` exit: the `count` innermost block nodes leave the
// current record's chain, which keeps the next one.
#Export(c) jet_ctx_value_pop: fn(count: I64) {
    head: wrapping(context_current() + CONTEXT_VALUES)
    ^left: count
    loop left > (I64{0}) {
        context_pop_one_block(head)
        left -= I64{1}
    }
}

// The innermost node of the current record's chain holding key word `key`,
// else 0.
#Export(c) jet_ctx_value_find: fn(key: I64) -> I64 {
    ^at: sync_load(wrapping(context_current() + CONTEXT_VALUES))
    loop at != (I64{0}) {
        if ((sync_load(wrapping(at + CONTEXT_NODE_KEY)) & CONTEXT_KEY_MASK) == key) -> return at
        at = sync_load(wrapping(at + CONTEXT_NODE_NEXT))
    }
    I64{0}
}

// `#Context(allocator: a)` entry: `handler`, the block's allocator call (a
// function value whose owner moves here; Alloc.jet ALLOC_USER_TAKE), becomes
// the current record's allocator in a new carrier for the block whose code
// runs below the stack address `mark` (JetIR Build.jet ir_stack_mark). The
// enclosing carrier (0: the program heap) goes to word 0 of `save`, two
// stack words of the block's frame, and the new one to word 8; the new
// carrier holds one more reference to the enclosing one as its outer: the
// allocator its handler's own allocations use, and the one a value leaving
// the block moves to. The thread's cache rows are blocked from here
// (alloc_cache_sync). Handler 0 keeps the current allocator: the block over
// a `mem.Allocator` value that is `context.allocator` itself, or a builtin
// allocator with no carrier (JetIR BuildTransact.jet ir_context_block), and
// word 8 is then 0.
#Export(c) jet_ctx_push_allocator: fn(handler: I64, save: I64, mark: I64) {
    slot: wrapping(context_current() + CONTEXT_ALLOCATOR)
    outer: sync_load(slot)
    sync_store(save, outer)
    if (handler == I64{0}) {
        sync_store(wrapping(save + I64{8}), I64{0})
        return
    }
    carrier: alloc_user_carrier_new(handler, outer, mark)
    sync_store(wrapping(save + I64{8}), carrier)
    sync_store(slot, carrier)
    alloc_cache_sync(thread_base())
}

// `#Context(allocator: a)` exit: the enclosing carrier saved at entry comes
// back, an arena block's arena goes back to its entry mark (Alloc.jet
// alloc_arena_rewind), and the block's carrier loses the record's
// reference, whatever a move a stop interrupted left in the record
// (Alloc.jet jet_rt_move_enter). The regions it served from still name it
// (Alloc.jet's page map), so it ends once the last of them is released or
// serves another carrier. A block that kept the current allocator has no
// carrier.
#Export(c) jet_ctx_pop_allocator: fn(save: I64) {
    slot: wrapping(context_current() + CONTEXT_ALLOCATOR)
    sync_store(slot, sync_load(save))
    alloc_cache_sync(thread_base())
    carrier: sync_load(wrapping(save + I64{8}))
    if (carrier == I64{0}) {
        return
    }
    alloc_arena_rewind(carrier)
    alloc_user_drop(carrier)
}

// `#Context(allocator: a)` entry over a `mem.Arena` handle `arena`, or
// over `context.scratch` when `arena` is 0, as jet_ctx_push_allocator's:
// the new carrier is an arena block's (Alloc.jet alloc_arena_carrier_new)
// over the arena's reservation, at the handle's word ARENA_BLOCKS (the
// task's scratch arena's for `context.scratch`), mapped at its first
// block. `held` 1 hands the block the arena, a value it made itself, to
// drop at its end.
#Export(c) jet_ctx_push_arena: fn(arena: I64, held: I64, save: I64, mark: I64) {
    current: context_current()
    served: if (arena == I64{0}) -> context_scratch_arena(current) else -> arena
    reservation: wrapping(served + ARENA_BLOCKS)
    slot: wrapping(current + CONTEXT_ALLOCATOR)
    outer: sync_load(slot)
    handle: if (held != I64{0}) -> arena else -> I64{0}
    carrier: alloc_arena_carrier_new(alloc_arena_record(reservation), handle, outer, mark)
    sync_store(save, outer)
    sync_store(wrapping(save + I64{8}), carrier)
    sync_store(slot, carrier)
    alloc_cache_sync(thread_base())
}

// The stop handler's key word (IR BuildTransact.jet ir_context_key_word of
// CONTEXT_ON_STOP_KEY): `#Context(on_stop: f)` pushes `f`, a function value,
// under it.
CONTEXT_ON_STOP_KEY: I64{1}

// The stop rail's handler half (jet_rt_context_on_stop), installed by the
// first `#Context(on_stop:)` push (jet_ctx_on_stop_arm, which IR
// BuildTransact.jet ir_context_push_value calls before it pushes a stop
// handler). The stop door (Trap.jet trap_stop) calls through it, so a
// program that never sets a stop handler links none of the handler's run:
// its stops build no `Stop` and drop no message.
^context_on_stop_rail_code: I64{0}

rt_context_on_stop_address: fn() -> I64 {
    loop { jet_rt_unreachable(I64{0}, I64{0}) }
}

#Export(c) jet_ctx_on_stop_arm: fn() {
    if (context_on_stop_rail_code != I64{0}) {
        return
    }
    #Unsafe("an idempotent install: every writer stores the same code address") {
        context_on_stop_rail_code = rt_context_on_stop_address()
    }
}

// The rail's entry: trap_stop's five words, answered with 0.
#Export(c) jet_rt_context_on_stop: fn(kind: I64, a: I64, b: I64, c: I64, d: I64) -> I64 {
    context_on_stop_run(kind, a, b, c, d)
    I64{0}
}

// The stop door's call of the context's stop handler (Trap.jet trap_stop,
// for every stop outside served comptime code, through
// context_on_stop_rail_code): when a `#Context(on_stop:)`
// block of this task, or of a task it was spawned from, set one, it runs
// once with a fresh core.debug `Stop` it borrows, laid out as message@0 and
// kind@8, the StopKind's declaration index (Panic 0, Assert 1, Contract 2,
// Bounds 3, Shift 4, Todo 5). While it runs the chain's head is the node
// after its own, so it is not the current handler and a stop inside it
// reaches the enclosing one, never itself; the head comes back when it
// returns. A thread without a TCB or a record runs none.
context_on_stop_run: fn(kind: I64, a: I64, b: I64, c: I64, d: I64) {
    base: thread_base()
    if (base == I64{0} || base == thread_detached_base()) {
        return
    }
    record: sync_load(wrapping(base + CONTEXT_TCB_SLOT))
    if (record == I64{0}) {
        return
    }
    node: jet_ctx_value_find(CONTEXT_ON_STOP_KEY)
    if (node == I64{0}) {
        return
    }
    head: wrapping(record + CONTEXT_VALUES)
    saved: sync_load(head)
    sync_store(head, sync_load(wrapping(node + CONTEXT_NODE_NEXT)))
    handler: sync_load(wrapping(node + I64{40}))
    stop: jet_rt_alloc(I64{16}, I64{8})
    message: context_on_stop_message(kind, a, b, c, d)
    sync_store(stop, message)
    sync_store(wrapping(stop + I64{8}), context_on_stop_kind(kind, a))
    coll_call2_unit(sync_load(wrapping(handler + I64{8})), handler, stop)
    sync_store(head, saved)
    jet_rt_string_drop(message)
    jet_rt_free(stop, I64{16}, I64{8})
}

// The StopKind index of trap_stop kind `kind`; a require stop's (4) own kind
// `a` is 0 assert, 1 assert_eq, 2 panic or 3 a contract clause.
context_on_stop_kind: fn(kind: I64, a: I64) -> I64 {
    if (kind == I64{2}) { return I64{4} }
    if (kind == I64{3}) { return I64{3} }
    if (kind == I64{5}) { return I64{5} }
    if (kind != I64{4} || a == I64{2}) { return I64{0} }
    if (a == I64{3}) { return I64{2} }
    I64{1}
}

// The message the stop reports, as an owned String built from trap_stop's
// words (Trap.jet): 1 a message's bytes and length; 2 a shift's count, count
// signedness, width and direction; 3 a list's length and the index; 4 a
// require stop's kind, message and an assert_eq's two sides; 5 a `#Todo`'s
// file, line and expected type.
context_on_stop_message: fn(kind: I64, a: I64, b: I64, c: I64, d: I64) -> I64 {
    if (kind == I64{2}) { return trap_shift_reason(d, a, b, c) }
    if (kind == I64{3}) { return trap_list_bounds_reason(a, b) }
    if (kind == I64{4}) {
        if (a != I64{1}) {
            if (b == I64{0}) { return rt_text_copy(I64{0}, I64{0}) }
            return jet_rt_string_clone(b)
        }
        message: jet_rt_string_builder_new()
        trap_build_msg_expected(message)
        jet_rt_string_builder_push(message, d)
        trap_build_msg_got(message)
        jet_rt_string_builder_push(message, c)
        return message
    }
    if (kind == I64{5}) {
        message: jet_rt_string_builder_new()
        trap_build_msg_todo(message)
        jet_rt_string_builder_push(message, a)
        rt_text_push_word(message, I64{58}, I64{1})
        rt_text_push_number(message, trap_line(b))
        trap_build_msg_todo_expected(message)
        jet_rt_string_builder_push(message, c)
        return message
    }
    rt_text_copy(a, b)
}

// Points TCB@48 at record and returns the pointer it replaced. The cache
// rows follow the record's allocator (Alloc.jet alloc_cache_sync): a task
// run inline inside a `#Context(allocator:)` block takes the heap.
context_enter: fn(record: I64) -> I64 {
    base: thread_base()
    slot: wrapping(base + CONTEXT_TCB_SLOT)
    previous: sync_load(slot)
    sync_store(slot, record)
    alloc_cache_sync(base)
    previous
}

context_leave: fn(previous: I64) {
    base: thread_base()
    sync_store(wrapping(base + CONTEXT_TCB_SLOT), previous)
    alloc_cache_sync(base)
}
