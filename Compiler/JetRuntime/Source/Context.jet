// Task-owned context carrier (#5025, D-JAI-CONTEXT1). TCB@48 points at the
// current Context record, so every context read is one load of that pointer.
// A thread's root record is appended to its TCB at CONTEXT_TCB_ROOT: code
// entered from C on a fresh thread starts from the root context. A task's
// record is appended to its Task state at TASK_CONTEXT (Task.jet); spawn
// copies the spawning record into it (D-NETTASK1: a task sees the context as
// of spawn) and task_run points TCB@48 at it for the body, restoring the
// worker's pointer afterwards. #Context writes fields of the current record in
// place and restores them from a caller save area on exit, so a swap never
// allocates. Codegen may later pass the record pointer as a hidden argument
// without changing meaning.
// Record, append-only (allocator, logger and scratch take the next words):
// deadline present@0, deadline ms@8 (Deadline.jet).
CONTEXT_TCB_SLOT :: I64{48}
CONTEXT_TCB_ROOT :: I64{448}
CONTEXT_RECORD_BYTES :: I64{16}
CONTEXT_DEADLINE_PRESENT :: I64{0}
CONTEXT_DEADLINE_MS :: I64{8}

fn context_current() -> I64 { sync_load(wrapping(thread_base() + CONTEXT_TCB_SLOT)) }

// TCB bytes including the appended root record (Thread.jet).
fn context_tcb_bytes() -> I64 { CONTEXT_TCB_ROOT + CONTEXT_RECORD_BYTES }

// A zeroed root record is the empty root context.
fn context_tcb_install_root(tcb: I64) { sync_store(wrapping(tcb + CONTEXT_TCB_SLOT), tcb + CONTEXT_TCB_ROOT) }

fn context_inherit(record: I64) {
    current :: context_current()
    at := I64{0}
    loop at < CONTEXT_RECORD_BYTES {
        sync_store(wrapping(record + at), sync_load(wrapping(current + at)))
        at += I64{8}
    }
}

// Points TCB@48 at record and returns the pointer it replaced.
fn context_enter(record: I64) -> I64 {
    slot :: wrapping(thread_base() + CONTEXT_TCB_SLOT)
    previous :: sync_load(slot)
    sync_store(slot, record)
    previous
}

fn context_leave(previous: I64) { sync_store(wrapping(thread_base() + CONTEXT_TCB_SLOT), previous) }
