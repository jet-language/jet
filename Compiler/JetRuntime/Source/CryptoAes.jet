// AES-NI and PCLMULQDQ leaves behind core.crypto.__aes_blocks and
// core.crypto.__ghash_blocks. Core/Crypto/Cipher.jet and Aead.jet run the
// same block operations portably (FIPS 197, NIST SP 800-38A/38D, IEEE
// 1619-2007); these leaves are only their faster form on a host whose cpuid
// reports AES-NI, PCLMULQDQ and SSSE3, so every tier keeps one meaning. A
// false return touches nothing and sends Core to its own rounds.

// The leaves' constants, else 0: the byte-reversal shuffle mask (16 bytes),
// then four zero blocks (64 bytes). Set up only on a host whose cpuid
// reports the instructions; the table lives for the process.
aes_ni_table := I64{0}
// runtime-init: 4 when aes_ni_table
#Export(c) jet_rt_aes_ni_init: fn() {
    if (aes_ni_table != I64{0} || !aes_ni_present()) -> return
    table: jet_rt_alloc(I64{80}, I64{8})
    rt_text_store(table, I64{0x08090a0b0c0d0e0f})
    rt_text_store(wrapping(table + I64{8}), I64{0x0001020304050607})
    at := I64{16}
    loop at < (I64{80}) {
        rt_text_store(wrapping(table + at), I64{0})
        at += I64{8}
    }
    #Unsafe("runtime-init runs before any other thread exists") {
        aes_ni_table = table
    }
}

// CPUID.1:ECX bits 25 (AES-NI), 1 (PCLMULQDQ) and 9 (SSSE3, for pshufb).
aes_ni_present: fn() -> Bool {
    #Unsafe("cpuid only reports processor identification") {
        if (os_cpuid_ecx_i64(I64{1}, I64{0}).bit_and(I64{33554946}) == I64{33554946}) -> return true
    }
    false
}

// The core.crypto.__aes_blocks operations, as Cipher.jet numbers them.
RT_AES_ECB_ENC: I64{0}
RT_AES_ECB_DEC: I64{1}
RT_AES_CBC_ENC: I64{2}
RT_AES_CBC_DEC: I64{3}
RT_AES_CTR: I64{4}
RT_AES_CTR32: I64{5}
RT_AES_CFB_ENC: I64{6}
RT_AES_CFB_DEC: I64{7}
RT_AES_OFB: I64{8}
RT_AES_XTS_ENC: I64{9}
RT_AES_XTS_DEC: I64{10}

// dst[0..bytes) = a ^ b, bytes a multiple of 8.
rt_aes_xor: fn(dst: I64, a: I64, b: I64, bytes: I64) {
    at := I64{0}
    loop at < bytes {
        rt_text_store(wrapping(dst + at), rt_text_word(wrapping(a + at)).bit_xor(rt_text_word(wrapping(b + at))))
        at += I64{8}
    }
}

// Four blocks at src through the cipher (or its equivalent inverse, FIPS 197
// section 5.3.5, under the decryption keys), each then xored with the
// block at mask, into out. Every load precedes every store, so out may be
// src or mask.
rt_aes_four: fn(keys: I64, rounds: I64, decrypt: Bool, src: I64, mask: I64, out: I64) {
    #Unsafe("the caller holds (rounds + 1) round keys at keys and four blocks at src, mask and out") {
        if decrypt {
            if (rounds == I64{10}) {
                os_aes_decrypt4_10_i64(keys, src, mask, out)
            } else if (rounds == I64{12}) {
                os_aes_decrypt4_12_i64(keys, src, mask, out)
            } else {
                os_aes_decrypt4_14_i64(keys, src, mask, out)
            }
        } else if (rounds == I64{10}) {
            os_aes_encrypt4_10_i64(keys, src, mask, out)
        } else if (rounds == I64{12}) {
            os_aes_encrypt4_12_i64(keys, src, mask, out)
        } else {
            os_aes_encrypt4_14_i64(keys, src, mask, out)
        }
    }
}

// rt_aes_four over n (1..4) blocks; fewer than four go through the 192
// scratch bytes at `scratch` (input, mask, output).
rt_aes_group: fn(keys: I64, rounds: I64, decrypt: Bool, src: I64, mask: I64, out: I64, n: I64, scratch: I64) {
    if (n == I64{4}) {
        rt_aes_four(keys, rounds, decrypt, src, mask, out)
        return
    }
    bytes: n * I64{16}
    rt_text_bytes_copy(scratch, src, bytes)
    rt_text_bytes_copy(wrapping(scratch + I64{64}), mask, bytes)
    rt_aes_four(keys, rounds, decrypt, scratch, wrapping(scratch + I64{64}), wrapping(scratch + I64{128}))
    rt_text_bytes_copy(out, wrapping(scratch + I64{128}), bytes)
}

// One block: x = E(src ^ pre), chain = x, out = x ^ post. Loads precede
// stores, so chain may be src or pre.
rt_aes_one: fn(keys: I64, rounds: I64, src: I64, pre: I64, post: I64, out: I64, chain: I64) {
    #Unsafe("the caller holds (rounds + 1) round keys at keys and one block at src, pre, post, out and chain") {
        if (rounds == I64{10}) {
            os_aes_encrypt1_10_i64(keys, src, pre, post, out, chain)
        } else if (rounds == I64{12}) {
            os_aes_encrypt1_12_i64(keys, src, pre, post, out, chain)
        } else {
            os_aes_encrypt1_14_i64(keys, src, pre, post, out, chain)
        }
    }
}

// Add one to the big-endian integer of the last `width` bytes of the
// counter block at ctr. The counter is public.
rt_aes_increment: fn(ctr: I64, width: I64) {
    i := I64{15}
    loop i >= (I64{16} - width) {
        byte: (rt_text_byte(wrapping(ctr + i)) + I64{1}).bit_and(I64{255})
        rt_text_put(wrapping(ctr + i), byte)
        if (byte != I64{0}) -> return
        i -= I64{1}
    }
}

// The XTS tweak times x in GF(2^128), little-endian (IEEE 1619-2007
// section 5.2), without a branch on its secret top bit.
rt_aes_xts_double: fn(t: I64) {
    lo: rt_text_word(t)
    hi: rt_text_word(wrapping(t + I64{8}))
    rt_text_store(t, (lo << I64{1}).bit_xor(I64{0x87}.bit_and(hi >> I64{63})))
    rt_text_store(wrapping(t + I64{8}), (hi << I64{1}).bit_or(rt_crypto_shr64(lo, I64{63})))
}

// core.crypto.__aes_blocks: the `count` whole blocks of the borrowed bytes
// (src, length) from `offset` under `op`, appended to the List<U8> at
// `out_header` (len, capacity, data) within its capacity, with the 16-byte
// chaining List<U8> at `iv_header` updated as Cipher.blocks does. `keys`
// holds the rounds + 1 round keys (the decryption schedule for ECB_DEC,
// CBC_DEC and XTS_DEC). False, touching nothing, on a host without AES-NI
// or for arguments outside those bounds.
#Export(c) jet_crypto_aes_blocks: fn(keys: I64, keys_len: I64, rounds: I64, op: I64, iv_header: I64, src: I64, length: I64, offset: I64, count: I64, out_header: I64) -> Bool {
    table: aes_ni_table
    if (table == I64{0} || RT_HOST_U8_STRIDE != I64{1}) -> return false
    r: jet_int_owned_to_i64(rounds)
    kind: jet_int_owned_to_i64(op)
    start: jet_int_owned_to_i64(offset)
    blocks: jet_int_owned_to_i64(count)
    if ((r != I64{10} && r != I64{12} && r != I64{14}) || keys_len != (r + I64{1}) * I64{16} || kind < RT_AES_ECB_ENC || kind > RT_AES_XTS_DEC) -> return false
    if (rt_text_word(iv_header) != I64{16} || start < I64{0} || blocks < I64{0} || start > length || blocks > (length - start) / I64{16}) -> return false
    used: rt_text_word(out_header)
    if (blocks > (rt_text_word(wrapping(out_header + I64{8})) - used) / I64{16}) -> return false
    iv: rt_text_word(wrapping(iv_header + I64{16}))
    data: wrapping(src + start)
    out: wrapping(rt_text_word(wrapping(out_header + I64{16})) + used)
    zero: wrapping(table + I64{16})
    // 0..192 rt_aes_group's scratch, 192..256 the masks (counters, tweaks or
    // previous blocks), 256..320 the tweaked inputs.
    scratch: jet_rt_alloc(I64{320}, I64{8})
    masks: wrapping(scratch + I64{192})
    tweaked: wrapping(scratch + I64{256})
    done := I64{0}
    loop done < blocks {
        n: if (blocks - done < I64{4}) -> blocks - done else -> I64{4}
        at: wrapping(data + done * I64{16})
        to: wrapping(out + done * I64{16})
        bytes: n * I64{16}
        if (kind == RT_AES_ECB_ENC || kind == RT_AES_ECB_DEC) {
            rt_aes_group(keys, r, kind == RT_AES_ECB_DEC, at, zero, to, n, scratch)
        } else if (kind == RT_AES_CBC_DEC || kind == RT_AES_CFB_DEC) {
            // CBC: P_i = D(C_i) ^ C_{i-1}; CFB: P_i = E(C_{i-1}) ^ C_i; C_{-1}
            // is the iv (SP 800-38A sections 6.2 and 6.3).
            rt_text_bytes_copy(masks, iv, I64{16})
            rt_text_bytes_copy(wrapping(masks + I64{16}), at, bytes - I64{16})
            rt_text_bytes_copy(iv, wrapping(at + (bytes - I64{16})), I64{16})
            if (kind == RT_AES_CBC_DEC) {
                rt_aes_group(keys, r, true, at, masks, to, n, scratch)
            } else {
                rt_aes_group(keys, r, false, masks, at, to, n, scratch)
            }
        } else if (kind == RT_AES_CTR || kind == RT_AES_CTR32) {
            width: if (kind == RT_AES_CTR) -> I64{16} else -> I64{4}
            b := I64{0}
            loop b < n {
                rt_text_bytes_copy(wrapping(masks + b * I64{16}), iv, I64{16})
                rt_aes_increment(iv, width)
                b += I64{1}
            }
            rt_aes_group(keys, r, false, masks, at, to, n, scratch)
        } else if (kind == RT_AES_XTS_ENC || kind == RT_AES_XTS_DEC) {
            // C_i = E(P_i ^ T_i) ^ T_i, T_{i+1} = T_i * x (IEEE 1619-2007
            // section 5.3.1).
            b := I64{0}
            loop b < n {
                rt_text_bytes_copy(wrapping(masks + b * I64{16}), iv, I64{16})
                rt_aes_xts_double(iv)
                b += I64{1}
            }
            rt_aes_xor(tweaked, at, masks, bytes)
            rt_aes_group(keys, r, kind == RT_AES_XTS_DEC, tweaked, masks, to, n, scratch)
        } else {
            // CBC_ENC, CFB_ENC and OFB chain every block on the last.
            b := I64{0}
            loop b < n {
                block: wrapping(at + b * I64{16})
                into: wrapping(to + b * I64{16})
                if (kind == RT_AES_CBC_ENC) {
                    rt_aes_one(keys, r, block, iv, zero, into, iv)
                } else if (kind == RT_AES_OFB) {
                    rt_aes_one(keys, r, iv, zero, block, into, iv)
                } else {
                    rt_aes_one(keys, r, iv, zero, block, into, masks)
                    rt_text_bytes_copy(iv, into, I64{16})
                }
                b += I64{1}
            }
        }
        done += n
    }
    at := I64{0}
    loop at < (I64{320}) {
        rt_text_store(wrapping(scratch + at), I64{0})
        at += I64{8}
    }
    jet_rt_free(scratch, I64{320}, I64{8})
    rt_text_store(out_header, used + blocks * I64{16})
    true
}

// core.crypto.__ghash_blocks: the `count` 16-byte blocks of the borrowed
// bytes (data, length) from `offset` folded into the 16-byte List<U8> at
// `y_header` under the hash subkey (h, h_len): Y = (Y ^ X_i) * H in
// GF(2^128) (NIST SP 800-38D section 6.4). Four blocks at a time use
// Y' = (Y ^ X_1) H^4 ^ X_2 H^3 ^ X_3 H^2 ^ X_4 H with one reduction. False,
// touching nothing, on a host without PCLMULQDQ or for arguments outside
// those bounds.
#Export(c) jet_crypto_ghash_blocks: fn(h: I64, h_len: I64, y_header: I64, data: I64, length: I64, offset: I64, count: I64) -> Bool {
    table: aes_ni_table
    if (table == I64{0} || RT_HOST_U8_STRIDE != I64{1}) -> return false
    start: jet_int_owned_to_i64(offset)
    blocks: jet_int_owned_to_i64(count)
    if (h_len != I64{16} || rt_text_word(y_header) != I64{16} || start < I64{0} || blocks < I64{0} || start > length || blocks > (length - start) / I64{16}) -> return false
    y: rt_text_word(wrapping(y_header + I64{16}))
    zero: wrapping(table + I64{16})
    at := wrapping(data + start)
    left := blocks
    #Unsafe("y and h hold one block, the range check keeps every block inside the length borrowed bytes, and the powers table holds four") {
        if (left >= I64{4}) {
            // H, H^2, H^3, H^4: each power is (H^k ^ 0) * H.
            powers: jet_rt_alloc(I64{64}, I64{8})
            rt_text_bytes_copy(powers, h, I64{16})
            k := I64{1}
            loop k < (I64{4}) {
                power: wrapping(powers + k * I64{16})
                rt_text_bytes_copy(power, wrapping(power - I64{16}), I64{16})
                os_ghash1_i64(power, zero, h, table)
                k += I64{1}
            }
            loop left >= (I64{4}) {
                os_ghash4_i64(y, at, powers, table)
                at = wrapping(at + I64{64})
                left -= I64{4}
            }
            k = I64{0}
            loop k < (I64{64}) {
                rt_text_store(wrapping(powers + k), I64{0})
                k += I64{8}
            }
            jet_rt_free(powers, I64{64}, I64{8})
        }
        loop left > (I64{0}) {
            os_ghash1_i64(y, at, h, table)
            at = wrapping(at + I64{16})
            left -= I64{1}
        }
    }
    true
}
