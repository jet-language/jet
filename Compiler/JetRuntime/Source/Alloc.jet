// Independent Linux x86-64 heap for boxes/storage emitted by native lowering.
// No Core allocation API, libc allocator, sentry, or exact-Int operation
// participates. The ABI is three machine words, matching the lowering's calls.
//
// State layout: word 0 of the state page is the detached-thread GS target
// (Thread.jet thread_detached_base): it always reads zero, so thread_base()
// yields 0 on a thread that has no TCB and the allocator takes its locked
// path there. Word 208 holds the table of the 32 arenas (216 bytes each:
// [lock 0][8 available-slab heads 8..64][8 retained-empty-slab counts
// 72..128][8 live totals 136..192][scratch row 200..208 for uncached takes]);
// the large-block cache owns lock 216, cached bytes 224 and 59 class heads
// from 256; the slab regions own lock 736, cursor 744, end 752 and the
// free-slab stack 760 (alloc_slab_map).
// The state page also reserves word 4080 for the execution-end flush lock
// and word 4088 for ignored raw stdio outputs (the I64/Bool outputs alias).
// Each 64 KiB slab belongs to one arena and one power-of-two class
// (32..4096). Slab layout: [next][prev][free][live][head-cell][arena][carve]
// followed by padding to max(64, class-size), then the blocks. A block that
// was never handed out is not on the free list: `carve` is the next such
// block (zero once none is left), so a page is first touched when one of its
// blocks is first taken. Returned blocks go on the intrusive free list.
// A live block stores [slab][block-start] immediately before its aligned payload.
// Large/over-aligned mappings instead store [mapping-base][mapping-length].
// A block allocated with align >= 8 also carries one reference-count word
// before those two (payload-24, #5041 P2), set to 1 here: every List/Map/
// Set/Queue buffer and every Option/Result/enum box is such a block, so any
// owner can share it (Refcount.jet jet_rt_block_retain/release/unique) no
// matter which runtime route or lowering site allocated it. Byte buffers
// (align < 8, text data) keep the two-word header and have no count.
// Only slabs with a block to give (free or still to carve) are linked. An
// attached thread allocates and frees small blocks through its own cache
// first (TCB @320, Thread.jet):
// eight [head][count] rows, one per class, of blocks threaded through their
// first two words as [next][slab]. The cache needs no atomic: only its owner
// touches it. It refills with up to 32 blocks of one slab under the arena
// lock of the stack band's arena (alloc_arena), and when it holds 64 blocks a
// free first returns 32 of them, each to its own slab under that slab's
// arena lock. A cached block counts as live in its slab, so a slab is unmapped
// only when no payload and no cache holds any of its blocks; the arena row's
// live total per class counts every block out of a slab the same way, and
// alloc_live_blocks subtracts the cached ones for the leak-witness fixtures.
// Thread exit (jet_rt_thread_detach) returns the whole cache. A thread without
// a TCB (before attach, foreign) allocates from the arena its stack band
// selects (alloc_arena) and a block returns to its slab's arena;
// each arena's slab metadata is protected by that arena's futex lock
// (alloc_lock: a short spin, then a kernel sleep), so threads on different
// stacks rarely contend and a waiter never burns a core. Payloads belong exclusively to
// their callers. At most ALLOC_RETAINED_EMPTY_SLABS empty slabs per class and
// arena stay linked to avoid relinking on every temporary; additional empty
// slabs go on the process's free-slab stack, still mapped, for the next new
// slab of any class (alloc_slab_map: slabs are carved from slab regions and
// their pages never fault twice). Large mappings are rounded to a size class (at most 25% over
// the page-rounded need) and a freed one is kept on its class list while the
// cache holds at most 64 MiB in all (resident pages a compiler keeps, so the
// bound stays small), for the next allocation of that class instead of
// munmap + mmap; reused large blocks are not zeroed, as small blocks never
// are. The state page, the arena table, the retained empty slabs and the
// cached large mappings are bounded allocator-owned process-lifetime
// metadata/cache, not live payload allocations.
// The program allocator policy (jet_rt_program_allocator_*) shares this heap: independent
// lock136, mode144 (0 system/1 counting), cap152, allocations160, requested168,
// live176, high-water184. Counters saturate; successful reservations count even
// when a later mmap fails, but that failure cancels live bytes before returning.
// Counted allocations alone own a raw-heap tracker node [ptr,requested,next].
// Head192 and count200 share the policy lock; system-mode block layout and
// allocation cost are unchanged. Free skips lookup while tracked count is zero.
//
// Checked mode (alloc_class_limit, the "Checked mode" section below) is
// chosen once here, from the process environment, before the first allocation.
//
// The runtime object puts jet_rt_alloc_init in .init_array, so initialization
// precedes all user code in both programs and entryless libraries. There is no
// lazy initialization or separate jet_rt_main initialization mechanism.
alloc_root := I64{0}

// The largest payload a size class serves on the ordinary path. Checked mode
// (JET_CHECKED_ALLOC=1 at start, see alloc_check_take) sets it to 0, so every
// allocation and free takes the direct-mapping branch, which then hands it to
// the checked heap: off, checked mode adds no branch to the class path, only
// this word's load. Written only by jet_rt_alloc_init, before any allocation.
ALLOC_CLASS_LIMIT :: I64{4096}
alloc_class_limit := I64{4096}

// Layout::from_size_align(size.max(1), align): alignment must be a nonzero
// power of two, and rounding the size to alignment must fit isize::MAX.
fn alloc_layout_valid(size: I64, align: I64) -> Bool Never! {
    if (size < I64{0} || align <= I64{0}) { return false }
    if ((align.bit_and(wrapping(align - I64{1}))) != I64{0}) { return false }
    effective :: if (size == I64{0}) -> I64{1} else -> size
    effective <= wrapping(I64{9223372036854775807} - wrapping(align - I64{1}))
}

// Returns the block class, or zero for a direct mapping (every payload above
// `limit`: ALLOC_CLASS_LIMIT, or alloc_class_limit). The conservative
// alignment slack includes every metadata word, so payload alignment never
// consumes a byte belonging to a neighbouring block. The power-of-two class
// is chosen by at most four comparisons: this runs on every allocation and
// every free. Small blocks start 32-aligned (slab offsets are multiples of
// the class), so an align-8 payload at block+24 needs no slack.
fn alloc_class(size: I64, align: I64, limit: I64) -> I64 Never! {
    effective :: if (size == I64{0}) -> I64{1} else -> size
    if (effective > limit || align > I64{4096}) { return I64{0} }
    slack :: if (align == I64{8}) -> I64{0} else -> wrapping(align - I64{1})
    needed :: wrapping(effective + alloc_header(align) + slack)
    if (needed <= I64{256}) {
        if (needed <= I64{64}) { return if (needed <= I64{32}) -> I64{32} else -> I64{64} }
        return if (needed <= I64{128}) -> I64{128} else -> I64{256}
    }
    if (needed <= I64{1024}) { return if (needed <= I64{512}) -> I64{512} else -> I64{1024} }
    if (needed <= I64{2048}) { return I64{2048} }
    if (needed <= I64{4096}) -> I64{4096} else -> I64{0}
}

// Metadata bytes before a payload: [count][slab][block-start] for align >= 8,
// [slab][block-start] below that.
fn alloc_header(align: I64) -> I64 Never! {
    if (align >= I64{8}) -> I64{24} else -> I64{16}
}

// A fresh block's first owner: the count word of an align >= 8 payload.
fn alloc_count_init(pointer: I64, align: I64) {
    if (align < I64{8} || pointer == I64{0}) -> return
    #Unsafe("pointer is a fresh payload whose align >= 8 block reserved the word 24 bytes before it") {
        os_store_i64(wrapping(pointer - I64{24}), I64{1})
    }
}

// The class's available-slab head word in an arena: classes 32..4096 are
// words 8..64 of the arena row; their retained-empty cells follow 64 bytes on.
fn alloc_head(root: I64, slot: I64) -> I64 Never! {
    if (slot <= I64{256}) {
        if (slot <= I64{64}) { return wrapping(root + (if (slot == I64{32}) -> I64{8} else -> I64{16})) }
        return wrapping(root + (if (slot == I64{128}) -> I64{24} else -> I64{32}))
    }
    if (slot <= I64{1024}) { return wrapping(root + (if (slot == I64{512}) -> I64{40} else -> I64{48})) }
    wrapping(root + (if (slot == I64{2048}) -> I64{56} else -> I64{64}))
}

fn alloc_align(address: I64, align: I64) -> I64 Never! {
    mask :: wrapping(align - I64{1})
    wrapping(address + mask).bit_and(mask.bit_not())
}

fn alloc_map_try(bytes: I64) -> I64 {
    #Unsafe("anonymous private mmap owns fresh writable bytes and cannot alias a live heap block; a failed syscall produces no allocation") {
        address :: os_syscall_i64(I64{9}, I64{0}, bytes, I64{3}, I64{34}, I64{-1}, I64{0})
        if (address < I64{0}) { return I64{0} }
        return address
    }
}

fn alloc_map(bytes: I64, failed_size: I64) -> I64 {
    address :: alloc_map_try(bytes)
    if (address == I64{0}) { alloc_out_of_memory(failed_size) }
    address
}

fn alloc_unmap(address: I64, bytes: I64) {
    #Unsafe("the caller has removed this mapping from all heap lists and no payload remains live") {
        _ := os_syscall_i64(I64{11}, address, bytes, I64{0}, I64{0}, I64{0}, I64{0})
    }
}

// runtime-init: 0
#Export(c) fn jet_rt_alloc_init() {
    if (alloc_root != I64{0}) {
        return
    }
    // mmap is zero-filled: the locks, every free-list head, every live total
    // and the large cache start at zero.
    alloc_root = alloc_map(I64{4096}, I64{4096})
    // The 32 arenas: 32 * 216 bytes in one zero-filled mapping.
    table :: alloc_map(I64{8192}, I64{8192})
    #Unsafe("the fresh state page is private to initialization, which precedes every allocation") {
        os_store_i64(wrapping(alloc_root + I64{208}), table)
    }
    if alloc_check_requested() { alloc_check_start() }
    // The initializing thread has no TCB yet; point its GS at the zero word
    // so thread_base() reads 0 instead of faulting on the kernel's GS base 0.
    thread_set_base(thread_detached_base())
}

// The arena roots: rows of the table.
fn alloc_arena_root(index: I64) -> I64 {
    #Unsafe("initialization wrote the arena table word once, before any allocation") {
        return wrapping(os_load_i64(wrapping(alloc_root + I64{208})) + wrapping(index * I64{216}))
    }
}

// The calling thread's arena. Thread stacks are disjoint mappings of at least
// 192 MiB (Thread.jet thread_stack_bytes), so threads running at the same time
// sit in different 128 MiB stack bands; the band's hash picks one of the 32
// arenas. Any arena is correct for any thread: the choice only spreads lock
// traffic, and a block always returns to the arena of its slab.
fn alloc_arena() -> I64 {
    band := I64{0}
    #Unsafe("reads the stack pointer register only; nothing is dereferenced") {
        band = os_stack_address_i64() >> I64{27}
    }
    alloc_arena_root((wrapping(band * I64{-7046029254386353131}) >> I64{59}).bit_and(I64{31}))
}

// Live payloads of class `width`: every block handed out of a slab across
// all arenas minus the blocks parked in attached threads' caches. Isolated
// fixtures use it as their leak witness; the caller is quiescent (no thread
// is allocating, freeing or exiting while it reads).
fn alloc_live_blocks(width: I64) -> I64 {
    total := I64{0}
    index := I64{0}
    loop index < (I64{32}) {
        #Unsafe("the live totals are process-lifetime arena words; the quiescent caller needs no lock to read them") {
            total = wrapping(total + os_load_i64(wrapping(alloc_head(alloc_arena_root(index), width) + I64{128})))
        }
        index = wrapping(index + I64{1})
    }
    if (thread_tls_registry == I64{0}) { return total }
    count_offset :: wrapping(I64{312} + wrapping(alloc_head(I64{0}, width) * I64{2}))
    sync_mutex_lock(thread_tls_registry)
    live :: thread_tls_registry + I64{64}
    count :: sync_load(live)
    data :: sync_load(live + I64{16})
    at := I64{0}
    loop at < count {
        total = wrapping(total - sync_load(sync_load(data + (at + I64{1}) * I64{8}) + count_offset))
        at += I64{2}
    }
    sync_mutex_unlock(thread_tls_registry)
    total
}

// Every allocator lock is one futex word: 0 free, 1 held, 2 held with
// sleepers. An acquirer spins briefly (test before each CAS, so waiters read
// a shared cache line), then sleeps in FUTEX_WAIT_PRIVATE instead of burning
// its core: when compiler threads outnumber the CPUs, a preempted holder no
// longer stalls every spinner for a whole time slice. No TCB, allocation or
// Sync state is involved, so the lock works before any thread is attached.
fn alloc_lock(root: I64) {
    #Unsafe("root is an aligned lock word in the process-lifetime state mapping; CAS/xchg acquire all metadata it protects and the futex wait only reads that word") {
        if (os_cas_i64(root, I64{0}, I64{1}) == I64{0}) -> return
        spins := I64{0}
        loop spins < (I64{128}) {
            os_spin_pause()
            if (os_load_i64(root) == I64{0} && os_cas_i64(root, I64{0}, I64{1}) == I64{0}) -> return
            spins = wrapping(spins + I64{1})
        }
        loop os_swap_i64(root, I64{2}) != (I64{0}) {
            _ := os_syscall_i64(I64{202}, root, I64{128}, I64{2}, I64{0}, I64{0}, I64{0})
        }
    }
}

fn alloc_unlock(root: I64) {
    #Unsafe("the calling thread holds this lock; xchg publishes its completed metadata updates and reports sleepers, and the futex wake only names the word") {
        if (os_swap_i64(root, I64{0}) == I64{2}) {
            _ := os_syscall_i64(I64{202}, root, I64{129}, I64{1}, I64{0}, I64{0}, I64{0})
        }
    }
}

// Remove a slab from its class's available list. Caller holds the heap lock.
fn alloc_unlink(slab: I64) {
    #Unsafe("slab and its linked neighbours are live heap-owned headers protected by the held heap lock") {
        next_slab :: os_load_i64(slab)
        previous :: os_load_i64(wrapping(slab + I64{8}))
        if {
            previous == (I64{0}) -> {
                head :: os_load_i64(wrapping(slab + I64{32}))
                os_store_i64(head, next_slab)
            }
            else -> os_store_i64(previous, next_slab)
        }
        if (next_slab != I64{0}) { os_store_i64(wrapping(next_slab + I64{8}), previous) }
        os_store_i64(slab, I64{0})
        os_store_i64(wrapping(slab + I64{8}), I64{0})
    }
}

// Prepend a slab whose free list was empty. Caller holds the heap lock.
fn alloc_link(slab: I64, head: I64) {
    #Unsafe("head and slab are live heap-owned metadata protected by the held heap lock") {
        first :: os_load_i64(head)
        os_store_i64(slab, first)
        os_store_i64(wrapping(slab + I64{8}), I64{0})
        if (first != I64{0}) { os_store_i64(wrapping(first + I64{8}), slab) }
        os_store_i64(head, slab)
    }
}

// Slabs come from slab regions, not one mapping each: a region is
// ALLOC_REGION of 4 KiB pages, mapped once and carved 64 KiB at a time, so a
// program touches only the pages its blocks use and a growing heap makes one
// mmap per 512 slabs. A slab that is no longer needed (more empty slabs than
// ALLOC_RETAINED_EMPTY_SLABS) goes on the process's free-slab stack and serves
// the next new slab of any class and arena. Its pages are never returned, so
// they never fault again.
// State page words: lock 736, region cursor 744, region end 752, free-slab
// stack 760 (a stacked slab's first word links the next).
ALLOC_SLAB_BYTES :: I64{65536}
ALLOC_REGION :: I64{33554432}

// A slab's 64 KiB: a stacked slab, else the next of the current region,
// mapping a new region when it is used up. Zero when no region can be
// mapped. A stacked slab's bytes are stale: alloc_new_slab rewrites its header.
fn alloc_slab_map() -> I64 {
    lock :: wrapping(alloc_root + I64{736})
    slab := I64{0}
    alloc_lock(lock)
    #Unsafe("the slab-region lock owns the cursor, end and free-slab stack words and every stacked slab's link word") {
        stack :: wrapping(alloc_root + I64{760})
        slab = os_load_i64(stack)
        if (slab != I64{0}) {
            os_store_i64(stack, os_load_i64(slab))
        } else {
            cursor :: wrapping(alloc_root + I64{744})
            end :: wrapping(alloc_root + I64{752})
            if (os_load_i64(cursor) == os_load_i64(end)) {
                region :: alloc_region_map()
                if (region != I64{0}) {
                    os_store_i64(cursor, region)
                    os_store_i64(end, wrapping(region + ALLOC_REGION))
                }
            }
            at :: os_load_i64(cursor)
            if (at != os_load_i64(end)) {
                slab = at
                os_store_i64(cursor, wrapping(at + ALLOC_SLAB_BYTES))
            }
        }
    }
    alloc_unlock(lock)
    slab
}

// Puts a slab no class holds on the free-slab stack, mapped.
fn alloc_slab_retire(slab: I64) {
    lock :: wrapping(alloc_root + I64{736})
    alloc_lock(lock)
    #Unsafe("the slab-region lock owns the free-slab stack; the slab is unlinked from every class list and holds no live or cached block") {
        stack :: wrapping(alloc_root + I64{760})
        os_store_i64(slab, os_load_i64(stack))
        os_store_i64(stack, slab)
    }
    alloc_unlock(lock)
}

// A new slab region, or zero. It keeps 4 KiB pages (MADV_NOHUGEPAGE): where
// the system makes huge pages unasked, a first touch would zero 2 MiB, and an
// advised huge region compacts memory synchronously on fault, which stalls
// every thread allocating under a loaded host. A refused advice only costs
// page size.
fn alloc_region_map() -> I64 {
    region :: alloc_map_try(ALLOC_REGION)
    if (region == I64{0}) { return I64{0} }
    #Unsafe("madvise only changes the page size of the fresh private region") {
        _ := os_syscall_i64(I64{28}, region, ALLOC_REGION, I64{15}, I64{0}, I64{0}, I64{0})
    }
    region
}

// A slab for class `slot` of arena `root`, linked on the class list `head`.
// Its header: [next 0][prev 8][free 16][live 24][head 32][arena 40][carve 48].
fn alloc_new_slab(root: I64, head: I64, slot: I64) -> I64 {
    slab :: alloc_slab_map()
    if (slab == I64{0}) { return I64{0} }
    first :: wrapping(slab + (if (slot > I64{64}) -> slot else -> I64{64}))
    #Unsafe("the slab is this arena's alone: fresh from its region or off the free-slab stack; the held arena lock excludes all list readers") {
        os_store_i64(slab, I64{0})
        os_store_i64(wrapping(slab + I64{8}), I64{0})
        os_store_i64(wrapping(slab + I64{16}), I64{0})
        os_store_i64(wrapping(slab + I64{24}), I64{0})
        os_store_i64(wrapping(slab + I64{32}), head)
        os_store_i64(wrapping(slab + I64{40}), root)
        os_store_i64(wrapping(slab + I64{48}), if (wrapping(first + slot) <= wrapping(slab + ALLOC_SLAB_BYTES)) -> first else -> I64{0})
    }
    alloc_link(slab, head)
    slab
}

// Empty slabs a class keeps linked per arena, so a burst of temporaries
// (a thread's cache drains 32 blocks at a time) does not give up a slab it
// takes again moments later: at most 8 x 64 KiB per class and arena. Any
// further empty slab goes on the free-slab stack (alloc_slab_retire).
ALLOC_RETAINED_EMPTY_SLABS :: I64{8}

// Take up to `limit` free blocks of the class's head slab under the held
// arena lock and thread them, as [next][slab], onto the cache row `row`
// ([head][count]); returns how many were taken: zero only when no slab can
// be mapped. The blocks count as live in the slab; the arena's live total
// grows with them; a retained-empty slab leaves the class's retained count
// (a fresh slab was never counted); an emptied slab is unlinked.
fn alloc_slab_take(root: I64, head: I64, slot: I64, row: I64, limit: I64) -> I64 {
    #Unsafe("the held arena lock protects the class list, the slab's free links, carve word and live count, the retained count and the arena live total; row is the caller's exclusive cache row; the blocks leave the slab before any caller sees them") {
        slab := os_load_i64(head)
        fresh := false
        if (slab == I64{0}) {
            slab = alloc_new_slab(root, head, slot)
            fresh = true
        }
        if (slab == I64{0}) { return I64{0} }
        free := os_load_i64(wrapping(slab + I64{16}))
        carve := os_load_i64(wrapping(slab + I64{48}))
        end :: wrapping(slab + I64{65536})
        list := os_load_i64(row)
        taken := I64{0}
        loop taken < limit {
            block := free
            if (block != I64{0}) {
                free = os_load_i64(block)
            } else {
                if (carve == I64{0}) -> break
                block = carve
                carve = wrapping(carve + slot)
                if (wrapping(carve + slot) > end) -> carve = I64{0}
            }
            os_store_i64(block, list)
            os_store_i64(wrapping(block + I64{8}), slab)
            list = block
            taken = wrapping(taken + I64{1})
        }
        os_store_i64(row, list)
        os_store_i64(wrapping(row + I64{8}), wrapping(os_load_i64(wrapping(row + I64{8})) + taken))
        os_store_i64(wrapping(slab + I64{16}), free)
        os_store_i64(wrapping(slab + I64{48}), carve)
        live :: os_load_i64(wrapping(slab + I64{24}))
        if (live == I64{0} && !fresh) {
            retained :: wrapping(head + I64{64})
            os_store_i64(retained, wrapping(os_load_i64(retained) - I64{1}))
        }
        os_store_i64(wrapping(slab + I64{24}), wrapping(live + taken))
        total :: wrapping(head + I64{128})
        os_store_i64(total, wrapping(os_load_i64(total) + taken))
        if (free == I64{0} && carve == I64{0}) { alloc_unlink(slab) }
        return taken
    }
}

// Return one block to its slab. Caller holds the slab's arena lock. The slab
// is linked again when it had no block left to give (an empty free list and
// nothing left to carve); a slab whose last block
// returns stays linked as one of the class's retained empty slabs
// (ALLOC_RETAINED_EMPTY_SLABS) or goes on the free-slab stack.
fn alloc_slab_return(slab: I64, block: I64) {
    #Unsafe("the held arena lock protects the slab's free links, carve word, live count, class list, retained count and live total; the block is no longer any payload or cache entry") {
        free :: os_load_i64(wrapping(slab + I64{16}))
        live :: wrapping(os_load_i64(wrapping(slab + I64{24})) - I64{1})
        os_store_i64(block, free)
        os_store_i64(wrapping(slab + I64{16}), block)
        os_store_i64(wrapping(slab + I64{24}), live)
        head :: os_load_i64(wrapping(slab + I64{32}))
        total :: wrapping(head + I64{128})
        os_store_i64(total, wrapping(os_load_i64(total) - I64{1}))
        if (free == I64{0} && os_load_i64(wrapping(slab + I64{48})) == I64{0}) { alloc_link(slab, head) }
        if (live == I64{0}) {
            retained :: wrapping(head + I64{64})
            count :: os_load_i64(retained)
            if (count < ALLOC_RETAINED_EMPTY_SLABS) { os_store_i64(retained, wrapping(count + I64{1})) } else {
                alloc_unlink(slab)
                alloc_slab_retire(slab)
            }
        }
    }
}

// The locked allocation of a thread without a cache: one block, straight
// from the arena's head slab.
fn alloc_small(root: I64, size: I64, align: I64, slot: I64) -> I64 {
    head :: alloc_head(root, slot)
    // The arena's scratch row (root + 200) is exclusive under its lock.
    scratch :: wrapping(root + I64{200})
    block := I64{0}
    alloc_lock(root)
    #Unsafe("the held arena lock makes the arena's scratch row exclusive; it is emptied again before the lock is released") {
        _ := alloc_slab_take(root, head, slot, scratch, I64{1})
        block = os_load_i64(scratch)
        os_store_i64(scratch, I64{0})
        os_store_i64(wrapping(scratch + I64{8}), I64{0})
    }
    alloc_unlock(root)
    if (block == I64{0}) { return I64{0} }
    pointer :: alloc_align(wrapping(block + alloc_header(align)), align)
    #Unsafe("block is this caller's exclusive block; its two cached words are read before the payload header overwrites them") {
        slab :: os_load_i64(wrapping(block + I64{8}))
        os_store_i64(wrapping(pointer - I64{16}), slab)
        os_store_i64(wrapping(pointer - I64{8}), block)
    }
    pointer
}

// The calling thread's cache row [head][count] for a class, or zero when the
// thread has no TCB (TCB @320 + 16 per class, Thread.jet).
fn alloc_cache_row(slot: I64) -> I64 {
    base :: thread_base()
    if (base == I64{0}) -> I64{0} else -> wrapping(base + wrapping(I64{304} + wrapping(alloc_head(I64{0}, slot) * I64{2})))
}

// Refill this thread's cache row with up to 32 blocks of one slab of the
// stack band's arena. False only when no slab can be mapped.
fn alloc_cache_refill(row: I64, slot: I64) -> Bool {
    root :: alloc_arena()
    alloc_lock(root)
    taken :: alloc_slab_take(root, alloc_head(root, slot), slot, row, I64{32})
    alloc_unlock(root)
    taken != I64{0}
}

// Hand out the cached head block of a row as a payload of `align`, writing
// the same [slab][block-start] header an uncached allocation writes.
fn alloc_cache_pop(row: I64, block: I64, align: I64) -> I64 {
    pointer :: alloc_align(wrapping(block + alloc_header(align)), align)
    #Unsafe("row is this thread's private cache row and block its cached head; both cached words are read before the payload header overwrites them") {
        os_store_i64(row, os_load_i64(block))
        os_store_i64(wrapping(row + I64{8}), wrapping(os_load_i64(wrapping(row + I64{8})) - I64{1}))
        slab :: os_load_i64(wrapping(block + I64{8}))
        os_store_i64(wrapping(pointer - I64{16}), slab)
        os_store_i64(wrapping(pointer - I64{8}), block)
    }
    pointer
}

// Return the first `count` cached blocks of a row to their slabs, each under
// its own slab's arena lock; consecutive blocks of one arena share a hold.
fn alloc_cache_drain(row: I64, count: I64) {
    held := I64{0}
    remaining := count
    #Unsafe("row is this thread's private cache row; each cached block's slab is live while the block is cached, so its arena word is readable, and the block returns under that arena's lock") {
        block := os_load_i64(row)
        loop remaining > (I64{0}) && block != (I64{0}) {
            next_block :: os_load_i64(block)
            slab :: os_load_i64(wrapping(block + I64{8}))
            root :: os_load_i64(wrapping(slab + I64{40}))
            if (root != held) {
                if (held != I64{0}) { alloc_unlock(held) }
                alloc_lock(root)
                held = root
            }
            alloc_slab_return(slab, block)
            block = next_block
            remaining = wrapping(remaining - I64{1})
        }
        os_store_i64(row, block)
        os_store_i64(wrapping(row + I64{8}), wrapping(os_load_i64(wrapping(row + I64{8})) - wrapping(count - remaining)))
    }
    if (held != I64{0}) { alloc_unlock(held) }
}

// Return every cached block of the calling thread: thread exit, and the
// fixtures that inspect slab metadata. A thread without a TCB holds none.
fn alloc_cache_flush() {
    base :: thread_base()
    if (base == I64{0}) {
        return
    }
    row := wrapping(base + I64{320})
    index := I64{0}
    loop index < (I64{8}) {
        #Unsafe("row is one of this thread's eight private cache rows") {
            alloc_cache_drain(row, os_load_i64(wrapping(row + I64{8})))
        }
        row = wrapping(row + I64{16})
        index = wrapping(index + I64{1})
    }
}

// Large size classes in pages: 2, 3, then four steps per doubling from 4
// (4, 5, 6, 7, 8, 10, 12, 14, 16, 20, ...) up to class 58, 65536 pages
// (256 MiB). A class is at most 25% above any need it serves.
fn alloc_large_class_pages(class: I64) -> I64 Never! {
    if (class < I64{2}) { return wrapping(class + I64{2}) }
    step :: wrapping(class - I64{2})
    pages := wrapping(I64{4} + step.bit_and(I64{3}))
    group := step /% I64{4}
    loop group > (I64{0}) {
        pages = wrapping(pages * I64{2})
        group = wrapping(group - I64{1})
    }
    pages
}

// The smallest large class holding `bytes` (page-rounded, above one page),
// or -1 above the largest class.
fn alloc_large_class(bytes: I64) -> I64 Never! {
    pages :: bytes /% I64{4096}
    if (pages > I64{65536}) { return I64{-1} }
    class := I64{0}
    loop alloc_large_class_pages(class) < pages -> class = wrapping(class + I64{1})
    class
}

// A cached mapping of `class`, unlinked from its list, or zero.
fn alloc_large_cached(class: I64) -> I64 {
    lock :: wrapping(alloc_root + I64{216})
    head :: wrapping(alloc_root + wrapping(I64{256} + wrapping(class * I64{8})))
    alloc_lock(lock)
    mapping := I64{0}
    #Unsafe("the large-cache lock owns every class list, its link words and the cached byte count") {
        mapping = os_load_i64(head)
        if (mapping != I64{0}) {
            os_store_i64(head, os_load_i64(mapping))
            total :: wrapping(alloc_root + I64{224})
            os_store_i64(total, wrapping(os_load_i64(total) - wrapping(alloc_large_class_pages(class) * I64{4096})))
        }
    }
    alloc_unlock(lock)
    mapping
}

// Returns a freed large mapping to its class list while the cache holds at
// most 64 MiB, else unmaps it. Mappings above the largest class are unmapped.
fn alloc_large_free(mapping: I64, bytes: I64) {
    class :: alloc_large_class(bytes)
    if (class >= I64{0} && wrapping(alloc_large_class_pages(class) * I64{4096}) == bytes) {
        lock :: wrapping(alloc_root + I64{216})
        alloc_lock(lock)
        cached := false
        #Unsafe("the large-cache lock owns every class list and the cached byte count; the mapping's first word is no live payload once it is freed") {
            total :: wrapping(alloc_root + I64{224})
            held :: os_load_i64(total)
            if (held <= wrapping(I64{67108864} - bytes)) {
                head :: wrapping(alloc_root + wrapping(I64{256} + wrapping(class * I64{8})))
                os_store_i64(mapping, os_load_i64(head))
                os_store_i64(head, mapping)
                os_store_i64(total, wrapping(held + bytes))
                cached = true
            }
        }
        alloc_unlock(lock)
        if cached -> return
    }
    alloc_unmap(mapping, bytes)
}

fn alloc_large(size: I64, align: I64) -> I64 {
    effective :: if (size == I64{0}) -> I64{1} else -> size
    // Extra header/alignment/page padding is internal overhead, not a caller
    // layout error. Refuse an unrepresentable mapping as allocation failure.
    overhead :: wrapping(align - I64{1})
    limit :: wrapping(I64{9223372036854775807} - I64{4119})
    if overhead > limit || effective > wrapping(limit - overhead) -> return I64{0}
    needed :: alloc_align(wrapping(effective + alloc_header(align) + overhead), I64{4096})
    class :: alloc_large_class(needed)
    bytes :: if (class < I64{0}) -> needed else -> wrapping(alloc_large_class_pages(class) * I64{4096})
    mapping := if (class < I64{0}) -> I64{0} else -> alloc_large_cached(class)
    if (mapping == I64{0}) { mapping = alloc_map_try(bytes) }
    if (mapping == I64{0}) { return I64{0} }
    pointer :: alloc_align(wrapping(mapping + alloc_header(align)), align)
    #Unsafe("pointer's two header words and the aligned payload are wholly within this page-rounded class mapping") {
        os_store_i64(wrapping(pointer - I64{16}), mapping)
        os_store_i64(wrapping(pointer - I64{8}), bytes)
    }
    pointer
}

// Session reserve is nullable on bad layout/OOM; every successful allocation
// still uses the same heap and exact-layout free as ordinary native storage.
// Checked mode (alloc_class_limit 0) sends every request to alloc_check_take.
fn alloc_try_validated(size: I64, align: I64) -> I64 {
    slot :: alloc_class(size, align, alloc_class_limit)
    if (slot == I64{0}) {
        if (alloc_class_limit == I64{0}) { return alloc_check_take(size, align) }
        pointer :: alloc_large(size, align)
        alloc_count_init(pointer, align)
        return pointer
    }
    row :: alloc_cache_row(slot)
    pointer := I64{0}
    if (row == I64{0}) { pointer = alloc_small(alloc_arena(), size, align, slot) } else {
        block := I64{0}
        #Unsafe("row is this thread's private cache row") {
            block = os_load_i64(row)
            if (block == I64{0} && alloc_cache_refill(row, slot)) { block = os_load_i64(row) }
        }
        if (block != I64{0}) { pointer = alloc_cache_pop(row, block, align) }
    }
    alloc_count_init(pointer, align)
    pointer
}

// The independent policy lock is never held over heap allocation/deallocation.
// A failed reservation has made no changes, matching reserve's None rail.
// Machine words carry usize bits, including caps/counters above isize::MAX.
fn alloc_unsigned_less(left: I64, right: I64) -> Bool Never! {
    sign :: I64{-9223372036854775808}
    (left.bit_xor(sign)) < (right.bit_xor(sign))
}

fn alloc_counter_add(cell: I64, value: I64) {
    #Unsafe("the caller holds the policy lock and cell is a counter in alloc_root") {
        old :: os_load_i64(cell)
        next_value :: wrapping(old + value)
        os_store_i64(cell, if alloc_unsigned_less(next_value, old) -> I64{-1} else -> next_value)
    }
}

fn alloc_reserve(requested: I64) -> I64 {
    #Unsafe("the aligned mode word is read atomically on x86; system allocation needs no policy lock") {
        if (os_load_i64(wrapping(alloc_root + I64{144})) == I64{0}) { return I64{0} }
    }
    lock :: wrapping(alloc_root + I64{136})
    alloc_lock(lock)
    tracked := I64{0}
    #Unsafe("the policy lock exclusively owns the mode, cap and accounting words") {
        if (os_load_i64(wrapping(alloc_root + I64{144})) != I64{0}) {
            live :: os_load_i64(wrapping(alloc_root + I64{176}))
            cap :: os_load_i64(wrapping(alloc_root + I64{152}))
            next_live :: wrapping(live + requested)
            if alloc_unsigned_less(next_live, live) -> tracked = I64{-1} else {
                if (cap != I64{0} && alloc_unsigned_less(cap, next_live)) { tracked = I64{-1} } else {
                    os_store_i64(wrapping(alloc_root + I64{176}), next_live)
                    alloc_counter_add(wrapping(alloc_root + I64{160}), I64{1})
                    alloc_counter_add(wrapping(alloc_root + I64{168}), requested)
                    high :: os_load_i64(wrapping(alloc_root + I64{184}))
                    if alloc_unsigned_less(high, next_live) {
                        os_store_i64(wrapping(alloc_root + I64{184}), next_live)
                    }
                    tracked = I64{1}
                }
            }
        }
    }
    alloc_unlock(lock)
    tracked
}

fn alloc_release(requested: I64) {
    if (requested == I64{0}) {
        return
    }
    lock :: wrapping(alloc_root + I64{136})
    alloc_lock(lock)
    #Unsafe("the policy lock exclusively owns live bytes; restoration does not erase outstanding tracked blocks") {
        cell :: wrapping(alloc_root + I64{176})
        live :: os_load_i64(cell)
        os_store_i64(cell, if alloc_unsigned_less(live, requested) -> I64{0} else -> wrapping(live - requested))
    }
    alloc_unlock(lock)
}

// Explicit host policy edge: the caller serializes runs around this call.
// Save fact5 (mode) and fact4 (cap) before configuring, and
// restore them with the distinct restore edge below, retaining run counters.
#Export(c) fn jet_rt_program_allocator_configure(mode: I64, cap: I64) {
    lock :: wrapping(alloc_root + I64{136})
    alloc_lock(lock)
    #Unsafe("the held policy lock serializes all native allocator configuration and reservations") {
        os_store_i64(wrapping(alloc_root + I64{144}), if (mode == I64{1}) -> I64{1} else -> I64{0})
        os_store_i64(wrapping(alloc_root + I64{152}), cap)
        if (os_load_i64(wrapping(alloc_root + I64{176})) == I64{0}) {
            os_store_i64(wrapping(alloc_root + I64{160}), I64{0})
            os_store_i64(wrapping(alloc_root + I64{168}), I64{0})
            os_store_i64(wrapping(alloc_root + I64{184}), I64{0})
        }
    }
    alloc_unlock(lock)
}

// Restoration changes policy, never historical
// counters, even after the final counted allocation has been freed.
#Export(c) fn jet_rt_program_allocator_restore(mode: I64, cap: I64) {
    lock :: wrapping(alloc_root + I64{136})
    alloc_lock(lock)
    #Unsafe("the policy lock serializes restoration with native reserve and free; tracked blocks remain in the side table") {
        os_store_i64(wrapping(alloc_root + I64{144}), if (mode == I64{1}) -> I64{1} else -> I64{0})
        os_store_i64(wrapping(alloc_root + I64{152}), cap)
    }
    alloc_unlock(lock)
}

// Facts0..5: allocations, requested, live, high-water, cap, current mode.
#Export(c) fn jet_rt_program_allocator_fact(index: I64) -> I64 {
    if (index < I64{0} || index > I64{5}) { return I64{0} }
    offset :: if (index < I64{4}) -> wrapping(I64{160} + index * I64{8}) else if (index == I64{4}) -> I64{152} else -> I64{144}
    lock :: wrapping(alloc_root + I64{136})
    alloc_lock(lock)
    value := I64{0}
    #Unsafe("the policy lock protects this bounded fact word in alloc_root") {
        value = os_load_i64(wrapping(alloc_root + offset))
    }
    alloc_unlock(lock)
    value
}

// Tracker allocation bypasses the selected policy,
// cannot recurse, and exists only for counted payloads. Allocation failures
// release the reservation and free the payload before returning zero.
fn alloc_track(pointer: I64, requested: I64) -> Bool {
    node :: alloc_try_validated(I64{24}, I64{8})
    if (node == I64{0}) { return false }
    lock :: wrapping(alloc_root + I64{136})
    alloc_lock(lock)
    #Unsafe("the private raw-heap node is fully initialized before linking under the policy/tracker lock") {
        os_store_i64(node, pointer)
        os_store_i64(wrapping(node + I64{8}), requested)
        os_store_i64(wrapping(node + I64{16}), os_load_i64(wrapping(alloc_root + I64{192})))
        os_store_i64(wrapping(alloc_root + I64{192}), node)
        count :: os_load_i64(wrapping(alloc_root + I64{200}))
        os_store_i64(wrapping(alloc_root + I64{200}), wrapping(count + I64{1}))
    }
    alloc_unlock(lock)
    true
}

fn alloc_untrack(pointer: I64) -> I64 {
    #Unsafe("the process-lifetime tracker count is an aligned x86 word; a zero count avoids any lookup or lock") {
        if (os_load_i64(wrapping(alloc_root + I64{200})) == I64{0}) { return I64{0} }
    }
    lock :: wrapping(alloc_root + I64{136})
    alloc_lock(lock)
    node := I64{0}
    requested := I64{0}
    #Unsafe("the policy/tracker lock exclusively owns all side-table links and count") {
        link := wrapping(alloc_root + I64{192})
        current := os_load_i64(link)
        loop current != (I64{0}) {
            if (os_load_i64(current) == pointer) {
                node = current
                requested = os_load_i64(wrapping(current + I64{8}))
                os_store_i64(link, os_load_i64(wrapping(current + I64{16})))
                count :: os_load_i64(wrapping(alloc_root + I64{200}))
                os_store_i64(wrapping(alloc_root + I64{200}), wrapping(count - I64{1}))
                break
            }
            link = wrapping(current + I64{16})
            current = os_load_i64(link)
        }
    }
    alloc_unlock(lock)
    if (node != I64{0}) { alloc_free_validated(node, I64{24}, I64{8}) }
    requested
}

fn alloc_try_reserved(size: I64, align: I64) -> I64 {
    requested :: if (size == I64{0}) -> I64{1} else -> size
    tracked :: alloc_reserve(requested)
    if (tracked < I64{0}) { return I64{0} }
    pointer :: alloc_try_validated(size, align)
    if (pointer == I64{0}) {
        if (tracked != I64{0}) { alloc_release(requested) }
        return I64{0}
    }
    if (tracked != I64{0} && !alloc_track(pointer, requested)) {
        alloc_free_validated(pointer, size, align)
        alloc_release(requested)
        return I64{0}
    }
    pointer
}

fn alloc_try(size: I64, align: I64) -> I64 {
    if !alloc_layout_valid(size, align) -> return I64{0}
    if jet_fault_should_fail_allocation() -> return I64{0}
    alloc_try_reserved(size, align)
}

#Export(c) fn jet_rt_alloc_try(size: I64, align: I64) -> I64 { alloc_try(size, align) }

// The allocation fast path (#5476): jet_rt_alloc and jet_rt_free serve a
// small request of a plainly valid layout (size below alloc_class_limit,
// align 1, 2, 4 or 8) on the calling thread's cache row, calling nothing
// but an empty row's refill (the runtime is not inlined, and a call costs
// more than the work): the block, header and count word alloc_try_validated
// writes, and the push alloc_free_validated makes. The class row (0..7,
// class 32 << row) is alloc_class's comparisons spelled out. The checks
// that stay on it:
// - the layout: a size and power-of-two align in the range, so the full
//   path's alloc_layout_valid accepts it and its trap is never skipped;
// - checked mode: alloc_class_limit 0 admits no size, so every request takes
//   the full path, which hands it to the checked heap;
// - a TCB: a thread without one (GS names a zero word) has no row;
// - the counting policy: the mode word is 0 on allocation, and no counted
//   payload is tracked on free (so alloc_untrack has nothing to find), so
//   the ProgramAllocator facts stay exact;
// - an ending process frees nothing (#5478, Main.jet).
// Anything else (a direct mapping, over-alignment, an empty row whose refill
// finds no slab, a row holding 64 blocks) takes the full path, unchanged.
#Export(c) fn jet_rt_alloc(size: I64, align: I64) -> I64 {
    if (size >= I64{0} && size < alloc_class_limit && align > I64{0} && align <= I64{8} && align.bit_and(wrapping(align - I64{1})) == I64{0}) {
        header :: if (align == I64{8}) -> I64{24} else -> I64{16}
        needed :: wrapping((if (size == I64{0}) -> I64{1} else -> size) + header + (if (align == I64{8}) -> I64{0} else -> wrapping(align - I64{1})))
        index := I64{-1}
        if (needed <= I64{256}) {
            if (needed <= I64{64}) { index = if (needed <= I64{32}) -> I64{0} else -> I64{1} } else { index = if (needed <= I64{128}) -> I64{2} else -> I64{3} }
        } else if (needed <= I64{1024}) { index = if (needed <= I64{512}) -> I64{4} else -> I64{5} } else if (needed <= I64{2048}) { index = I64{6} } else if (needed <= I64{4096}) { index = I64{7} }
        if (index >= I64{0}) {
            #Unsafe("GS:0 is the attached thread's TCB or, unattached, the readable zero word (thread_base); the aligned mode word is read atomically on x86, as alloc_reserve reads it; row is this thread's private cache row (TCB @320 + 16 per class, alloc_cache_row) and block its cached head, whose two cached words are read before the payload header overwrites them; an align <= 8 payload at block + header is aligned because blocks start 32-aligned") {
                base :: os_tls_base_i64()
                if (base != I64{0} && os_load_i64(wrapping(alloc_root + I64{144})) == I64{0}) {
                    row :: wrapping(base + wrapping(I64{320} + wrapping(index * I64{16})))
                    block := os_load_i64(row)
                    if (block == I64{0} && alloc_cache_refill(row, I64{32} << index)) { block = os_load_i64(row) }
                    if (block != I64{0}) {
                        pointer :: wrapping(block + header)
                        os_store_i64(row, os_load_i64(block))
                        os_store_i64(wrapping(row + I64{8}), wrapping(os_load_i64(wrapping(row + I64{8})) - I64{1}))
                        os_store_i64(wrapping(pointer - I64{16}), os_load_i64(wrapping(block + I64{8})))
                        os_store_i64(wrapping(pointer - I64{8}), block)
                        if (align == I64{8}) { os_store_i64(block, I64{1}) }
                        return pointer
                    }
                }
            }
        }
    }
    if !alloc_layout_valid(size, align) {
        rt_trap_invalid_box_layout()
        return I64{0}
    }
    // Allocation failure is terminal SIGABRT.
    pointer :: alloc_try_reserved(size, align)
    if (pointer == I64{0}) { alloc_out_of_memory(if (size == I64{0}) -> I64{1} else -> size) }
    pointer
}

#Export(c) fn jet_rt_free(pointer: I64, size: I64, align: I64) {
    // Match the original C ABI's null no-op before validating its layout.
    if (pointer == I64{0}) {
        return
    }
    if (size >= I64{0} && size < alloc_class_limit && align > I64{0} && align <= I64{8} && align.bit_and(wrapping(align - I64{1})) == I64{0}) {
        // An ending process leaves its heap to the kernel (#5478, Main.jet).
        if (main_process_ending != I64{0}) -> return
        needed :: wrapping((if (size == I64{0}) -> I64{1} else -> size) + (if (align == I64{8}) -> I64{24} else -> wrapping(I64{15} + align)))
        index := I64{-1}
        if (needed <= I64{256}) {
            if (needed <= I64{64}) { index = if (needed <= I64{32}) -> I64{0} else -> I64{1} } else { index = if (needed <= I64{128}) -> I64{2} else -> I64{3} }
        } else if (needed <= I64{1024}) { index = if (needed <= I64{512}) -> I64{4} else -> I64{5} } else if (needed <= I64{2048}) { index = I64{6} } else if (needed <= I64{4096}) { index = I64{7} }
        if (index >= I64{0}) {
            #Unsafe("GS:0 is the attached thread's TCB or, unattached, the readable zero word (thread_base); the tracked count is an aligned word read atomically, as alloc_untrack reads it; row is this thread's private cache row; the lowering frees exactly once with the allocation's original layout, so the payload header is read before the block's cached words overwrite it") {
                base :: os_tls_base_i64()
                if (base != I64{0} && os_load_i64(wrapping(alloc_root + I64{200})) == I64{0}) {
                    row :: wrapping(base + wrapping(I64{320} + wrapping(index * I64{16})))
                    count :: os_load_i64(wrapping(row + I64{8}))
                    if (count < I64{64}) {
                        block :: os_load_i64(wrapping(pointer - I64{8}))
                        slab :: os_load_i64(wrapping(pointer - I64{16}))
                        os_store_i64(block, os_load_i64(row))
                        os_store_i64(wrapping(block + I64{8}), slab)
                        os_store_i64(row, block)
                        os_store_i64(wrapping(row + I64{8}), wrapping(count + I64{1}))
                        return
                    }
                }
            }
        }
    }
    if !alloc_layout_valid(size, align) {
        rt_trap_invalid_box_layout()
        return
    }
    // An ending process leaves its heap to the kernel (#5478, Main.jet).
    if (main_process_ending != I64{0}) -> return
    alloc_release(alloc_untrack(pointer))
    alloc_free_validated(pointer, size, align)
}

// The align-8 entries (#5925): jet_rt_alloc_8(size) is jet_rt_alloc(size, 8)
// and jet_rt_free_8(pointer, size) is jet_rt_free(pointer, size, 8). A code
// generator calls them for a constant align 8 (JetIR X64Select
// ir_x64_alloc_entry), the align every box, record and word buffer has.
// With the align known, the fast path needs no layout validation but the
// size's range and no header choice, and the entry has a small frame. The
// class row is alloc_class's comparisons for align 8 (size + 24 bytes, so
// row k of class 32 << k serves the sizes above (16 << k) - 24 and at most
// (32 << k) - 24, row 0 from 0), as the TCB offset of the row
// (alloc_cache_row). Everything else takes the general entry.
#Export(c) fn jet_rt_alloc_8(size: I64) -> I64 {
    if (size >= I64{0}) {
        if (size < alloc_class_limit) {
            offset := I64{0}
            if (size <= I64{232}) {
                if (size <= I64{40}) { offset = if (size <= I64{8}) -> I64{320} else -> I64{336} } else { offset = if (size <= I64{104}) -> I64{352} else -> I64{368} }
            } else if (size <= I64{1000}) { offset = if (size <= I64{488}) -> I64{384} else -> I64{400} } else if (size <= I64{2024}) { offset = I64{416} } else if (size <= I64{4072}) { offset = I64{432} }
            if (offset != I64{0}) {
                #Unsafe("GS:0 is the attached thread's TCB or, unattached, the readable zero word (thread_base); the aligned mode word is read atomically on x86, as alloc_reserve reads it; row is this thread's private cache row of the size's class and block its cached head, whose next word is read before the count overwrites it; the block's second word is its slab word, the payload header's; the payload at block + 24 is 8-aligned because blocks start 32-aligned") {
                    base :: os_tls_base_i64()
                    if (base != I64{0}) {
                        if (os_load_i64(wrapping(alloc_root + I64{144})) == I64{0}) {
                            row :: wrapping(base + offset)
                            block :: os_load_i64(row)
                            if (block != I64{0}) {
                                os_store_i64(row, os_load_i64(block))
                                os_store_i64(wrapping(row + I64{8}), wrapping(os_load_i64(wrapping(row + I64{8})) - I64{1}))
                                os_store_i64(wrapping(block + I64{16}), block)
                                os_store_i64(block, I64{1})
                                return wrapping(block + I64{24})
                            }
                        }
                    }
                }
            }
        }
    }
    jet_rt_alloc(size, I64{8})
}

#Export(c) fn jet_rt_free_8(pointer: I64, size: I64) {
    if (pointer != I64{0}) {
        if (size >= I64{0}) {
            if (size < alloc_class_limit) {
                // An ending process leaves its heap to the kernel (#5478, Main.jet).
                if (main_process_ending != I64{0}) -> return
                offset := I64{0}
                if (size <= I64{232}) {
                    if (size <= I64{40}) { offset = if (size <= I64{8}) -> I64{320} else -> I64{336} } else { offset = if (size <= I64{104}) -> I64{352} else -> I64{368} }
                } else if (size <= I64{1000}) { offset = if (size <= I64{488}) -> I64{384} else -> I64{400} } else if (size <= I64{2024}) { offset = I64{416} } else if (size <= I64{4072}) { offset = I64{432} }
                if (offset != I64{0}) {
                    #Unsafe("GS:0 is the attached thread's TCB or, unattached, the readable zero word (thread_base); the tracked count is an aligned word read atomically, as alloc_untrack reads it; row is this thread's private cache row of the size's class; the lowering frees exactly once with the allocation's original layout, so the payload header is read before the block's next word overwrites it; the block's second word stays its slab word") {
                        base :: os_tls_base_i64()
                        if (base != I64{0}) {
                            if (os_load_i64(wrapping(alloc_root + I64{200})) == I64{0}) {
                                row :: wrapping(base + offset)
                                count :: os_load_i64(wrapping(row + I64{8}))
                                if (count < I64{64}) {
                                    block :: os_load_i64(wrapping(pointer - I64{8}))
                                    os_store_i64(block, os_load_i64(row))
                                    os_store_i64(row, block)
                                    os_store_i64(wrapping(row + I64{8}), wrapping(count + I64{1}))
                                    return
                                }
                            }
                        }
                    }
                }
            }
        }
    }
    jet_rt_free(pointer, size, I64{8})
}

// Checked mode (alloc_class_limit 0) sends every free to alloc_check_give.
fn alloc_free_validated(pointer: I64, size: I64, align: I64) {
    slot :: alloc_class(size, align, alloc_class_limit)
    if (slot == I64{0}) {
        if (alloc_class_limit == I64{0}) {
            alloc_check_give(pointer, size, align)
            return
        }
        alloc_large_give(pointer)
        return
    }
    row :: alloc_cache_row(slot)
    if (row != I64{0}) {
        // A row holding 64 blocks first returns its 32 most recently pushed
        // ones to their slabs, then takes this block.
        #Unsafe("row is this thread's private cache row; the lowering frees exactly once with the allocation's original layout, so the payload header is read before the block's cached words overwrite it") {
            if (os_load_i64(wrapping(row + I64{8})) >= I64{64}) { alloc_cache_drain(row, I64{32}) }
            slab :: os_load_i64(wrapping(pointer - I64{16}))
            block :: os_load_i64(wrapping(pointer - I64{8}))
            os_store_i64(block, os_load_i64(row))
            os_store_i64(wrapping(block + I64{8}), slab)
            os_store_i64(row, block)
            os_store_i64(wrapping(row + I64{8}), wrapping(os_load_i64(wrapping(row + I64{8})) + I64{1}))
        }
        return
    }
    alloc_arena_give(pointer)
}

// Return a direct allocation's mapping.
fn alloc_large_give(pointer: I64) {
    #Unsafe("the lowering returns this still-live direct allocation with exactly its original size and alignment") {
        mapping :: os_load_i64(wrapping(pointer - I64{16}))
        bytes :: os_load_i64(wrapping(pointer - I64{8}))
        alloc_large_free(mapping, bytes)
    }
}

// Return a class payload straight to its slab under its arena's lock (a
// thread without a cache row, and a checked block's own heap block).
fn alloc_arena_give(pointer: I64) {
    slab := I64{0}
    root := I64{0}
    #Unsafe("the caller's live payload header names its slab, whose arena word is fixed when the slab is created") {
        slab = os_load_i64(wrapping(pointer - I64{16}))
        root = os_load_i64(wrapping(slab + I64{40}))
    }
    alloc_lock(root)
    #Unsafe("the lowering frees exactly once with the allocation's original layout; its slab remains live until this last payload is returned under its arena's lock") {
        alloc_slab_return(slab, os_load_i64(wrapping(pointer - I64{8})))
    }
    alloc_unlock(root)
}

// Checked mode (#5095): JET_CHECKED_ALLOC=1 in the environment at process
// start turns a bad free from silent heap corruption into a trap that names
// its call site. It is a debugging aid with no flag or syntax; off, the
// class path is unchanged but for reading the class limit from the global
// alloc_class_limit: checked mode sets it to 0, so every allocation and free
// reaches the direct-mapping branch, which alone tests for checked mode.
// A checked payload p of (size, align) lives inside one ordinary heap block
// q of (prefix + size + 8, max(align, 8)), p = q + prefix, where the prefix
// is 200 bytes rounded up to align:
//   p-8     canary: ALLOC_CHECK_LIVE ^ p while live, ALLOC_CHECK_FREED ^ p freed
//   p-16    q
//   p-24    the reference count (Refcount.jet reads payload-24), 1 for align >= 8
//   p-32    size, p-40 align
//   p-120.. ten return addresses of the allocating chain (ascending to p-48)
//   p-200.. ten return addresses of the freeing chain (ascending to p-128)
//   p+size  an unaligned tail canary ALLOC_CHECK_TAIL ^ p
// Each chain starts inside the allocator: the backend may inline its
// helpers, so a fixed skip count could drop the caller's own frame.
// A free checks the canary (a second free, or a pointer this heap never
// handed out or whose header was overwritten), the layout (the allocation's
// size and alignment) and the tail canary (a write past the end); it then
// poisons the payload with 0xDF bytes and parks the block in a FIFO
// quarantine of ALLOC_CHECK_SLOTS blocks and at most ALLOC_CHECK_BUDGET
// payload bytes, so a stale pointer cannot reach a reused block. A block
// leaving the quarantine, and every parked block when main returns
// (alloc_check_sweep), must still carry its freed canary, its poison and its
// tail: otherwise something wrote after the free. A trap prints the block,
// the current call chain and the recorded chains (return addresses walked
// up the rbp frame chain, symbolized from /proc/self/exe's .symtab, relocated
// by the AT_PHDR load bias for a PIE; runtime-internal functions have no
// symbol and print as ??), then aborts.
// State page words: quarantine lock 16, ring 24, pushes 32, parked count 40,
// parked bytes 48, frame-pointer stub 56 (alloc_check_start).
ALLOC_CHECK_LIVE :: I64{2397417249457849674}
ALLOC_CHECK_FREED :: I64{2397398596314219850}
ALLOC_CHECK_TAIL :: I64{2399373246418142538}
ALLOC_CHECK_POISON :: I64{-2314885530818453537}
ALLOC_CHECK_SLOTS :: I64{4096}
ALLOC_CHECK_BUDGET :: I64{67108864}

// Whether the environment holds exactly JET_CHECKED_ALLOC=1. Initialization
// runs before any allocation and before the startup environment exists, so
// this reads /proc/self/environ through the state page's unused tail (path
// and pattern words at 1024 and 1048, a 2016-byte buffer at 2048), cleared
// again afterwards. Without /proc the mode stays off.
fn alloc_check_requested() -> Bool {
    path :: wrapping(alloc_root + I64{1024})
    pattern :: wrapping(alloc_root + I64{1048})
    buffer :: wrapping(alloc_root + I64{2048})
    found := false
    #Unsafe("initialization owns the fresh state page; the path, pattern and read buffer lie in its unused tail below word 4064 and read writes only the buffer") {
        // "/proc/self/environ\0" and "JET_CHECKED_ALLOC=1\0", little-endian.
        os_store_i64(path, I64{7310238724270485551})
        os_store_i64(wrapping(path + I64{8}), I64{8244250809394488940})
        os_store_i64(wrapping(path + I64{16}), I64{28271})
        os_store_i64(pattern, I64{4847360028133573962})
        os_store_i64(wrapping(pattern + I64{8}), I64{5714025870881211723})
        os_store_i64(wrapping(pattern + I64{16}), I64{3226947})
        fd :: os_syscall_i64(I64{257}, I64{-100}, path, I64{524288}, I64{0}, I64{0}, I64{0})
        if (fd >= I64{0}) {
            // matched: bytes of the pattern matched since an entry start, or
            // -1 while skipping to the next entry's NUL.
            matched := I64{0}
            loop {
                count :: os_syscall_i64(I64{0}, fd, buffer, I64{2016}, I64{0}, I64{0}, I64{0})
                if (count == I64{-4}) { next }
                if (count <= I64{0}) { break }
                at := I64{0}
                loop at < count {
                    byte :: os_load_u8(wrapping(buffer + at))
                    if (matched >= I64{0} && byte == os_load_u8(wrapping(pattern + matched))) {
                        matched = wrapping(matched + I64{1})
                        if (matched == I64{20}) {
                            found = true
                            break
                        }
                    } else {
                        matched = if (byte == I64{0}) -> I64{0} else -> I64{-1}
                    }
                    at = wrapping(at + I64{1})
                }
                if found { break }
            }
            _ := os_syscall_i64(I64{3}, fd, I64{0}, I64{0}, I64{0}, I64{0}, I64{0})
        }
        at := I64{1024}
        loop at < (I64{4064}) {
            os_store_i64(wrapping(alloc_root + at), I64{0})
            at = wrapping(at + I64{8})
        }
    }
    found
}

// The frame walk needs rbp, which no admitted asm leaf reads (and a new leaf
// would not assemble with a seed that predates it), so checked mode maps a
// four-byte read-only executable stub `mov rax, rbp; ret` called through
// os_call_address_i64: rbp is unchanged across the call, so it returns the
// calling function's frame pointer.
fn alloc_check_start() {
    ring :: alloc_map(wrapping(ALLOC_CHECK_SLOTS * I64{8}), wrapping(ALLOC_CHECK_SLOTS * I64{8}))
    stub :: alloc_map(I64{4096}, I64{4096})
    #Unsafe("the fresh state page and stub page are private to initialization, which precedes every allocation; the stub page becomes read+execute before any call") {
        os_store_i64(stub, I64{3286796616})
        if (os_syscall_i64(I64{10}, stub, I64{4096}, I64{5}, I64{0}, I64{0}, I64{0}) == I64{0}) {
            os_store_i64(wrapping(alloc_root + I64{56}), stub)
        }
        os_store_i64(wrapping(alloc_root + I64{24}), ring)
    }
    alloc_class_limit = I64{0}
}

fn alloc_check_prefix(align: I64) -> I64 Never! {
    if (align <= I64{8}) -> I64{200} else -> alloc_align(I64{200}, align)
}

// Store `count` return addresses of the calling chain at out, out+8, ...;
// 0 past the chain's end. The walk stops at a null or misaligned link or one
// that does not ascend within 16 MiB, so it never leaves the current stack.
fn alloc_check_frames(out: I64, count: I64) {
    frame := I64{0}
    #Unsafe("the checked-mode stub only copies rbp to rax and returns; a missing stub leaves no chain") {
        stub :: os_load_i64(wrapping(alloc_root + I64{56}))
        if (stub != I64{0}) { frame = os_call_address_i64(stub, I64{0}) }
    }
    index := I64{0}
    loop index < count {
        address := I64{0}
        if (frame != I64{0} && frame.bit_and(I64{7}) == I64{0}) {
            #Unsafe("frame is an active caller's [saved rbp][return address] pair on this thread's stack: every followed link ascends by less than 16 MiB") {
                address = os_load_i64(wrapping(frame + I64{8}))
                above :: os_load_i64(frame)
                frame = if (above > frame && wrapping(above - frame) < I64{16777216}) -> above else -> I64{0}
            }
        }
        #Unsafe("out lends count writable words: a checked block's chain words or a trap's scratch page") {
            os_store_i64(wrapping(out + wrapping(index * I64{8})), address)
        }
        index = wrapping(index + I64{1})
    }
}

fn alloc_check_take(size: I64, align: I64) -> I64 {
    prefix :: alloc_check_prefix(align)
    inner_align :: if (align < I64{8}) -> I64{8} else -> align
    if (size > wrapping(wrapping(I64{9223372036854775807} - prefix) - wrapping(inner_align + I64{8}))) { return I64{0} }
    block :: alloc_check_block_take(wrapping(wrapping(prefix + size) + I64{8}), inner_align)
    if (block == I64{0}) { return I64{0} }
    pointer :: wrapping(block + prefix)
    #Unsafe("block is this caller's fresh heap block of prefix + size + 8 bytes; every word written lies in block .. pointer + size + 8") {
        os_store_i64(wrapping(pointer - I64{8}), pointer.bit_xor(ALLOC_CHECK_LIVE))
        os_store_i64(wrapping(pointer - I64{16}), block)
        os_store_i64(wrapping(pointer - I64{24}), if (align >= I64{8}) -> I64{1} else -> I64{0})
        os_store_i64(wrapping(pointer - I64{32}), size)
        os_store_i64(wrapping(pointer - I64{40}), align)
        at := I64{128}
        loop at <= (I64{200}) {
            os_store_i64(wrapping(pointer - at), I64{0})
            at = wrapping(at + I64{8})
        }
        os_store_i64(wrapping(pointer + size), pointer.bit_xor(ALLOC_CHECK_TAIL))
    }
    alloc_check_frames(wrapping(pointer - I64{120}), I64{10})
    pointer
}

fn alloc_check_give(pointer: I64, size: I64, align: I64) {
    if (pointer < I64{4096} || pointer.bit_and(I64{7}) != I64{0}) { alloc_check_fail(I64{2}, pointer, size, align, I64{0}) }
    lock :: wrapping(alloc_root + I64{16})
    canary := I64{0}
    alloc_lock(lock)
    #Unsafe("a checked payload's canary word precedes it; the quarantine lock orders racing frees of one block") {
        canary = os_load_i64(wrapping(pointer - I64{8}))
        if (canary == pointer.bit_xor(ALLOC_CHECK_LIVE)) {
            os_store_i64(wrapping(pointer - I64{8}), pointer.bit_xor(ALLOC_CHECK_FREED))
        }
    }
    alloc_unlock(lock)
    if (canary == pointer.bit_xor(ALLOC_CHECK_FREED)) { alloc_check_fail(I64{1}, pointer, size, align, I64{0}) }
    if (canary != pointer.bit_xor(ALLOC_CHECK_LIVE)) { alloc_check_fail(I64{2}, pointer, size, align, I64{0}) }
    #Unsafe("the live canary proves pointer is a checked payload whose header and tail this free now owns") {
        if (os_load_i64(wrapping(pointer - I64{32})) != size || os_load_i64(wrapping(pointer - I64{40})) != align) {
            alloc_check_fail(I64{3}, pointer, size, align, I64{0})
        }
        if (os_load_i64(wrapping(pointer + size)) != pointer.bit_xor(ALLOC_CHECK_TAIL)) {
            alloc_check_fail(I64{4}, pointer, size, align, size)
        }
    }
    alloc_check_frames(wrapping(pointer - I64{200}), I64{10})
    alloc_check_fill(pointer, size)
    alloc_lock(lock)
    #Unsafe("the quarantine lock owns the ring and its counters; every parked block is freed and owned by the quarantine") {
        ring :: os_load_i64(wrapping(alloc_root + I64{24}))
        pushes :: os_load_i64(wrapping(alloc_root + I64{32}))
        parked := os_load_i64(wrapping(alloc_root + I64{40}))
        bytes := os_load_i64(wrapping(alloc_root + I64{48}))
        loop parked > (I64{0}) && (parked == ALLOC_CHECK_SLOTS || wrapping(bytes + size) > ALLOC_CHECK_BUDGET) {
            oldest :: os_load_i64(wrapping(ring + wrapping(wrapping(pushes - parked).bit_and(wrapping(ALLOC_CHECK_SLOTS - I64{1})) * I64{8})))
            alloc_check_inspect(lock, oldest)
            bytes = wrapping(bytes - os_load_i64(wrapping(oldest - I64{32})))
            parked = wrapping(parked - I64{1})
            alloc_check_retire(oldest)
        }
        os_store_i64(wrapping(ring + wrapping(pushes.bit_and(wrapping(ALLOC_CHECK_SLOTS - I64{1})) * I64{8})), pointer)
        os_store_i64(wrapping(alloc_root + I64{32}), wrapping(pushes + I64{1}))
        os_store_i64(wrapping(alloc_root + I64{40}), wrapping(parked + I64{1}))
        os_store_i64(wrapping(alloc_root + I64{48}), wrapping(bytes + size))
    }
    alloc_unlock(lock)
}

fn alloc_check_fill(pointer: I64, size: I64) {
    at := I64{0}
    #Unsafe("the freeing caller owns size payload bytes at pointer") {
        loop wrapping(at + I64{8}) <= size {
            os_store_i64(wrapping(pointer + at), ALLOC_CHECK_POISON)
            at = wrapping(at + I64{8})
        }
        loop at < size {
            os_store_u8(wrapping(pointer + at), I64{223})
            at = wrapping(at + I64{1})
        }
    }
}

// A parked block must be exactly as its free left it; any change is a write
// after free. Returns the first changed byte's offset (-8: the canary), or -1.
fn alloc_check_damage(pointer: I64) -> I64 {
    #Unsafe("pointer is a parked checked payload owned by the quarantine; its header, payload and tail stay mapped until retired") {
        if (os_load_i64(wrapping(pointer - I64{8})) != pointer.bit_xor(ALLOC_CHECK_FREED)) { return I64{-8} }
        size :: os_load_i64(wrapping(pointer - I64{32}))
        at := I64{0}
        loop wrapping(at + I64{8}) <= size && os_load_i64(wrapping(pointer + at)) == ALLOC_CHECK_POISON {
            at = wrapping(at + I64{8})
        }
        loop at < size {
            if (os_load_u8(wrapping(pointer + at)) != I64{223}) { return at }
            at = wrapping(at + I64{1})
        }
        if (os_load_i64(wrapping(pointer + size)) != pointer.bit_xor(ALLOC_CHECK_TAIL)) { return size }
    }
    I64{-1}
}

// Trap on a damaged parked block; the caller holds the quarantine lock,
// released first so the report may flush stdout (which may allocate and free).
fn alloc_check_inspect(lock: I64, pointer: I64) {
    damage :: alloc_check_damage(pointer)
    if (damage == I64{-1}) -> return
    alloc_unlock(lock)
    if (damage == I64{-8}) { alloc_check_fail(I64{6}, pointer, I64{0}, I64{0}, damage) }
    #Unsafe("the freed canary proved the checked header") {
        alloc_check_fail(I64{5}, pointer, os_load_i64(wrapping(pointer - I64{32})), os_load_i64(wrapping(pointer - I64{40})), damage)
    }
}

fn alloc_check_retire(pointer: I64) {
    block := I64{0}
    size := I64{0}
    align := I64{0}
    #Unsafe("pointer is an inspected parked checked payload; its header still names the enclosing block and layout") {
        block = os_load_i64(wrapping(pointer - I64{16}))
        size = os_load_i64(wrapping(pointer - I64{32}))
        align = os_load_i64(wrapping(pointer - I64{40}))
    }
    bytes :: wrapping(wrapping(alloc_check_prefix(align) + size) + I64{8})
    if (alloc_class(bytes, if (align < I64{8}) -> I64{8} else -> align, ALLOC_CLASS_LIMIT) == I64{0}) { alloc_large_give(block) } else { alloc_arena_give(block) }
}

// A checked payload's own heap block: an ordinary class block straight from
// an arena (no cache row), or a direct mapping.
fn alloc_check_block_take(bytes: I64, align: I64) -> I64 {
    slot :: alloc_class(bytes, align, ALLOC_CLASS_LIMIT)
    if (slot == I64{0}) -> alloc_large(bytes, align) else -> alloc_small(alloc_arena(), bytes, align, slot)
}

// Main's normal return (Main.jet jet_rt_main) inspects every block still
// parked, so a write after one of the last frees is not missed.
fn alloc_check_sweep() {
    if (alloc_class_limit != I64{0}) -> return
    lock :: wrapping(alloc_root + I64{16})
    alloc_lock(lock)
    #Unsafe("the quarantine lock owns the ring and its counters") {
        ring :: os_load_i64(wrapping(alloc_root + I64{24}))
        pushes :: os_load_i64(wrapping(alloc_root + I64{32}))
        parked :: os_load_i64(wrapping(alloc_root + I64{40}))
        index := I64{0}
        loop index < parked {
            alloc_check_inspect(lock, os_load_i64(wrapping(ring + wrapping(wrapping(wrapping(pushes - parked) + index).bit_and(wrapping(ALLOC_CHECK_SLOTS - I64{1})) * I64{8}))))
            index = wrapping(index + I64{1})
        }
    }
    alloc_unlock(lock)
}

fn alloc_check_write(data: I64, length: I64) {
    at := I64{0}
    #Unsafe("data lends length readable bytes; write retains no pointer") {
        loop at < length {
            written :: os_syscall_i64(I64{1}, I64{2}, wrapping(data + at), wrapping(length - at), I64{0}, I64{0}, I64{0})
            if (written == I64{-4}) { next }
            if (written <= I64{0}) { return }
            at = wrapping(at + written)
        }
    }
}

fn alloc_check_say(text: I64) {
    alloc_check_write(rt_text_data(text), rt_text_len(text))
}

fn alloc_check_hex(value: I64) {
    alloc_write_word(I64{30768}, I64{2})
    shift := I64{60}
    loop shift > (I64{0}) && (value >> shift).bit_and(I64{15}) == (I64{0}) {
        shift = wrapping(shift - I64{4})
    }
    loop shift >= (I64{0}) {
        digit :: (value >> shift).bit_and(I64{15})
        alloc_write_word(if (digit < I64{10}) -> wrapping(I64{48} + digit) else -> wrapping(I64{87} + digit), I64{1})
        shift = wrapping(shift - I64{4})
    }
}

// A read-only private mapping of this executable's ELF file for symbol
// names, or 0: the loader's view of an image run from memory
// (HOST_AT_IMAGE), else /proc/self/exe mapped here.
fn alloc_check_image() -> I64 {
    loaded :: host_getauxval(HOST_AT_IMAGE)
    if (loaded != I64{0}) { return loaded }
    path :: alloc_map_try(I64{4096})
    if (path == I64{0}) { return I64{0} }
    image := I64{0}
    #Unsafe("path is a fresh private page; the image is mapped read-only and only read") {
        // "/proc/self/exe\0", little-endian.
        os_store_i64(path, I64{7310238724270485551})
        os_store_i64(wrapping(path + I64{8}), I64{111567768086124})
        fd :: os_syscall_i64(I64{257}, I64{-100}, path, I64{524288}, I64{0}, I64{0}, I64{0})
        if (fd >= I64{0}) {
            length :: os_syscall_i64(I64{8}, fd, I64{0}, I64{2}, I64{0}, I64{0}, I64{0})
            if (length > I64{64}) {
                mapped :: os_syscall_i64(I64{9}, I64{0}, length, I64{1}, I64{2}, fd, I64{0})
                if (mapped > I64{0}) { image = mapped }
            }
            _ := os_syscall_i64(I64{3}, fd, I64{0}, I64{0}, I64{0}, I64{0}, I64{0})
        }
    }
    alloc_unmap(path, I64{4096})
    image
}

// The load bias of a position-independent executable (ET_DYN): the
// start stack's AT_PHDR minus the program headers' link-time address.
// A fixed-address executable (every Jet program) has bias 0.
fn alloc_check_bias(image: I64) -> I64 {
    if (image == I64{0}) { return I64{0} }
    phdr_address := I64{0}
    #Unsafe("image is a read-only private mapping of this executable's ELF64 file; its program header table lies inside it") {
        if (os_load_i64(wrapping(image + I64{16})).bit_and(I64{65535}) != I64{3}) { return I64{0} }
        table :: os_load_i64(wrapping(image + I64{32}))
        entry :: os_load_i64(wrapping(image + I64{54})).bit_and(I64{65535})
        count :: os_load_i64(wrapping(image + I64{56})).bit_and(I64{65535})
        index := I64{0}
        loop index < count {
            header :: wrapping(image + wrapping(table + wrapping(index * entry)))
            kind :: os_load_i64(header).bit_and(I64{4294967295})
            if (kind == I64{6}) {
                phdr_address = os_load_i64(wrapping(header + I64{16}))
                break
            }
            if (kind == I64{1} && os_load_i64(wrapping(header + I64{8})) == I64{0}) {
                phdr_address = wrapping(os_load_i64(wrapping(header + I64{16})) + table)
            }
            index = wrapping(index + I64{1})
        }
    }
    // AT_PHDR
    wrapping(host_getauxval(I64{3}) - phdr_address)
}

// Print the .symtab symbol whose range holds address (less the load bias), as
// name+0xoffset, or ?? when the image has none (a stripped binary or a
// runtime-internal function).
fn alloc_check_symbol(image: I64, bias: I64, address: I64) {
    target :: wrapping(address - bias)
    if (image != I64{0}) {
        #Unsafe("image is a read-only private mapping of this executable's ELF64 file; every offset read comes from its own section and symbol tables") {
            sections :: wrapping(image + os_load_i64(wrapping(image + I64{40})))
            entry :: os_load_i64(wrapping(image + I64{58})).bit_and(I64{65535})
            count :: os_load_i64(wrapping(image + I64{60})).bit_and(I64{65535})
            index := I64{0}
            loop index < count {
                section :: wrapping(sections + wrapping(index * entry))
                if (os_load_i64(wrapping(section + I64{4})).bit_and(I64{4294967295}) == I64{2}) {
                    link :: os_load_i64(wrapping(section + I64{40})).bit_and(I64{4294967295})
                    names :: wrapping(image + os_load_i64(wrapping(wrapping(sections + wrapping(link * entry)) + I64{24})))
                    symbols :: wrapping(image + os_load_i64(wrapping(section + I64{24})))
                    total :: os_load_i64(wrapping(section + I64{32})) /% I64{24}
                    at := I64{0}
                    loop at < total {
                        symbol :: wrapping(symbols + wrapping(at * I64{24}))
                        start :: os_load_i64(wrapping(symbol + I64{8}))
                        extent :: os_load_i64(wrapping(symbol + I64{16}))
                        if (extent > I64{0} && target >= start && target < wrapping(start + extent)) {
                            name :: wrapping(names + os_load_i64(symbol).bit_and(I64{4294967295}))
                            length := I64{0}
                            loop os_load_u8(wrapping(name + length)) != (I64{0}) {
                                length = wrapping(length + I64{1})
                            }
                            alloc_check_write(name, length)
                            alloc_write_word(I64{43}, I64{1})
                            alloc_check_hex(wrapping(target - start))
                            return
                        }
                        at = wrapping(at + I64{1})
                    }
                }
                index = wrapping(index + I64{1})
            }
        }
    }
    alloc_write_word(I64{16191}, I64{2})
}

// One line per nonzero return address of a recorded chain of `count` words.
fn alloc_check_chain(image: I64, bias: I64, words: I64, count: I64) {
    index := I64{0}
    loop index < count {
        address := I64{0}
        #Unsafe("words lends count readable chain words") {
            address = os_load_i64(wrapping(words + wrapping(index * I64{8})))
        }
        if (address == I64{0}) { return }
        alloc_write_word(I64{538976288}, I64{4})
        alloc_check_hex(address)
        alloc_write_word(I64{32}, I64{1})
        alloc_check_symbol(image, bias, address)
        alloc_write_word(I64{10}, I64{1})
        index = wrapping(index + I64{1})
    }
}

fn alloc_check_layout(size: I64, align: I64) {
    alloc_check_say(rt_static_text(" ("))
    alloc_write_size(size)
    alloc_check_say(rt_static_text(" bytes, align "))
    alloc_write_size(align)
    alloc_check_say(rt_static_text(")"))
}

// Report a checked-heap violation and abort. kind: 1 double free, 2 free of
// a pointer this heap never handed out (or whose header was overwritten),
// 3 free with another layout, 4 write past the end, 5 write after free into
// the payload or tail (at byte `offset`), 6 write after free over the header.
fn alloc_check_fail(kind: I64, pointer: I64, size: I64, align: I64, offset: I64) {
    jet_rt_stdout_flush()
    image :: alloc_check_image()
    bias :: alloc_check_bias(image)
    alloc_check_say(rt_static_text("jet checked allocator (JET_CHECKED_ALLOC=1): "))
    if (kind == I64{1}) {
        alloc_check_say(rt_static_text("double free of "))
        alloc_check_hex(pointer)
        alloc_check_layout(size, align)
    } else if (kind == I64{2}) {
        alloc_check_say(rt_static_text("free of "))
        alloc_check_hex(pointer)
        alloc_check_layout(size, align)
        alloc_check_say(rt_static_text(", which this heap never handed out or whose header was overwritten"))
    } else if (kind == I64{3}) {
        alloc_check_say(rt_static_text("free of "))
        alloc_check_hex(pointer)
        alloc_check_layout(size, align)
        alloc_check_say(rt_static_text(", allocated as"))
        #Unsafe("the live canary proved the checked header") {
            alloc_check_layout(os_load_i64(wrapping(pointer - I64{32})), os_load_i64(wrapping(pointer - I64{40})))
        }
    } else if (kind == I64{4}) {
        alloc_check_say(rt_static_text("write past the end of "))
        alloc_check_hex(pointer)
        alloc_check_layout(size, align)
        alloc_check_say(rt_static_text(", found at its free"))
    } else if (kind == I64{5}) {
        alloc_check_say(rt_static_text("write after free into "))
        alloc_check_hex(pointer)
        alloc_check_layout(size, align)
        alloc_check_say(rt_static_text(" at byte offset "))
        alloc_write_size(offset)
    } else {
        alloc_check_say(rt_static_text("write after free over the header of "))
        alloc_check_hex(pointer)
    }
    alloc_check_say(rt_static_text("\n  at:\n"))
    scratch :: alloc_map_try(I64{4096})
    if (scratch != I64{0}) {
        alloc_check_frames(scratch, I64{24})
        alloc_check_chain(image, bias, scratch, I64{24})
    }
    if (kind != I64{2} && kind != I64{6}) {
        if (kind == I64{1}) {
            alloc_check_say(rt_static_text("  first freed at:\n"))
            alloc_check_chain(image, bias, wrapping(pointer - I64{200}), I64{10})
        } else if (kind == I64{5}) {
            alloc_check_say(rt_static_text("  freed at:\n"))
            alloc_check_chain(image, bias, wrapping(pointer - I64{200}), I64{10})
        }
        alloc_check_say(rt_static_text("  allocated at:\n"))
        alloc_check_chain(image, bias, wrapping(pointer - I64{120}), I64{10})
    }
    alloc_abort()
}

// Write a little-endian packed literal without a String/list carrier or a
// mapping. The checked count bounds the stack word borrowed by the OS leaf.
fn alloc_write_word(word: I64, count: I64) {
    if (count < I64{0} || count > I64{8}) {
        return
    }
    remaining := count
    bytes := word
    #Unsafe("remaining is in 1..=8, so write borrows only the initialized stack word; a short write advances within it") {
        loop remaining > (I64{0}) {
            written :: os_write_word_i64(I64{2}, bytes, remaining)
            if (written == I64{-4}) { next }
            if (written <= I64{0}) {
                return
            }
            remaining = wrapping(remaining - written)
            if (remaining > I64{0}) { bytes = bytes >> wrapping(written * I64{8}) }
        }
    }
}

// Emit decimal digits most-significant first without allocating a buffer.
fn alloc_write_size(size: I64) {
    scale := I64{1}
    loop scale <= size /% (I64{10}) -> scale = wrapping(scale * I64{10})
    remaining := size
    loop scale > (I64{0}) {
        digit :: remaining /% scale
        alloc_write_word(wrapping(I64{48} + digit), I64{1})
        remaining = wrapping(remaining - wrapping(digit * scale))
        scale = scale /% I64{10}
    }
}

fn alloc_out_of_memory(size: I64) {
    // std::alloc::handle_alloc_error: \"memory allocation of N bytes failed\\n\"
    // followed by SIGABRT, not a Jet program-stop exit status.
    alloc_write_word(I64{6998727353336423789}, I64{8})
    alloc_write_word(I64{8028075772393516140}, I64{8})
    alloc_write_word(I64{139157512302}, I64{5})
    alloc_write_size(size)
    alloc_write_word(I64{7359008670706393632}, I64{8})
    alloc_write_word(I64{11426314611041}, I64{6})
    alloc_abort()
}

// One process-abort mechanism for allocation failure and panic in cleanup.
// The live Secrets are scrubbed first: a core dump must not hold them.
fn alloc_abort() {
    secret_scrub()
    #Unsafe("the stack-word syscalls unblock SIGABRT and, if necessary, restore its default disposition before raising it again; no heap pointer is needed") {
        pid :: os_syscall_i64(I64{39}, I64{0}, I64{0}, I64{0}, I64{0}, I64{0}, I64{0})
        _ := os_syscall_stack4_i64(I64{14}, I64{1}, I64{32}, I64{0}, I64{0}, I64{0}, I64{8})
        _ := os_syscall_i64(I64{62}, pid, I64{6}, I64{0}, I64{0}, I64{0}, I64{0})
        _ := os_syscall_stack4_i64(I64{13}, I64{6}, I64{0}, I64{0}, I64{0}, I64{0}, I64{8})
        _ := os_syscall_i64(I64{62}, pid, I64{6}, I64{0}, I64{0}, I64{0}, I64{0})
        _ := os_syscall_i64(I64{231}, I64{127}, I64{0}, I64{0}, I64{0}, I64{0}, I64{0})
    }
    loop {

    }
}
