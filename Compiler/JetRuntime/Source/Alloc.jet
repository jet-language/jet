// Independent Linux x86-64 heap for boxes/storage emitted by native lowering.
// No Core allocation API, libc, Rust allocator, sentry, or exact-Int operation
// participates. The ABI is three machine words, matching the lowering's calls.
//
// State layout: word 0 of the state page is the detached-thread GS target
// (Thread.jet thread_detached_base): it always reads zero, so thread_base()
// yields 0 on a thread that has no TCB and the allocator takes its locked
// path there. Word 208 holds the table of the 32 arenas (216 bytes each:
// [lock 0][8 available-slab heads 8..64][8 retained-empty-slab addresses
// 72..128][8 live totals 136..192][scratch row 200..208 for uncached takes]);
// the large-block cache owns lock 216, cached bytes 224 and 59 class heads
// from 256.
// The state page also reserves word 4080 for the execution-end flush lock
// and word 4088 for ignored raw stdio outputs (the I64/Bool outputs alias).
// Each 64 KiB slab belongs to one arena and one power-of-two class
// (32..4096). Slab layout: [next][prev][free][live][head-cell][arena]
// followed by padding to max(64, class-size), then intrusive free blocks.
// A live block stores [slab][block-start] immediately before its aligned payload.
// Large/over-aligned mappings instead store [mapping-base][mapping-length].
// A block allocated with align >= 8 also carries one reference-count word
// before those two (payload-24, #5041 P2), set to 1 here: every List/Map/
// Set/Queue buffer and every Option/Result/enum box is such a block, so any
// owner can share it (Refcount.jet jet_rt_block_retain/release/unique) no
// matter which runtime route or lowering site allocated it. Byte buffers
// (align < 8, text data) keep the two-word header and have no count.
// Only slabs with free blocks are linked. An attached thread allocates and
// frees small blocks through its own cache first (TCB @320, Thread.jet):
// eight [head][count] rows, one per class, of blocks threaded through their
// first two words as [next][slab]. The cache needs no atomic: only its owner
// touches it. It refills with up to 32 blocks of one slab under the arena
// lock of the stack band's arena (alloc_arena), and when it holds 64 blocks a
// free first returns 32 of them, each to its own slab under that slab's
// arena lock. A cached block counts as live in its slab, so a slab is unmapped
// only when no payload and no cache holds any of its blocks; the arena row's
// live total per class counts every block out of a slab the same way, and
// alloc_live_blocks subtracts the cached ones for the leak-witness fixtures.
// Thread exit (jet_rt_thread_detach) returns the whole cache. A thread without
// a TCB (before attach, foreign) allocates from the arena its stack band
// selects (alloc_arena) and a block returns to its slab's arena;
// each arena's slab metadata is protected by that arena's futex lock
// (alloc_lock: a short spin, then a kernel sleep), so threads on different
// stacks rarely contend and a waiter never burns a core. Payloads belong exclusively to
// their callers. At most one empty slab per class and arena is retained to
// avoid mmap/munmap on every temporary; additional empty slabs are unmapped
// immediately. Large mappings are rounded to a size class (at most 25% over
// the page-rounded need) and a freed one is kept on its class list while the
// cache holds at most 64 MiB in all (resident pages a compiler keeps, so the
// bound stays small), for the next allocation of that class instead of
// munmap + mmap; reused large blocks are not zeroed, as small blocks never
// are. The state page, the arena table, the retained empty slabs and the
// cached large mappings are bounded allocator-owned process-lifetime
// metadata/cache, not live payload allocations.
// ProgramAllocator.rs169-202/242-256/416-445 policy shares this heap: independent
// lock136, mode144 (0 system/1 counting), cap152, allocations160, requested168,
// live176, high-water184. Counters saturate; successful reservations count even
// when a later mmap fails, but that failure cancels live bytes before returning.
// Counted allocations alone own a raw-heap tracker node [ptr,requested,next].
// Head192 and count200 share the policy lock; system-mode block layout and
// allocation cost are unchanged. Free skips lookup while tracked count is zero.
//
// The runtime object puts jet_rt_alloc_init in .init_array, so initialization
// precedes all user code in both programs and entryless libraries. There is no
// lazy initialization or separate jet_rt_main initialization mechanism.
alloc_root := I64{0}

// Layout::from_size_align(size.max(1), align): alignment must be a nonzero
// power of two, and rounding the size to alignment must fit isize::MAX.
fn alloc_layout_valid(size: I64, align: I64) -> Bool Never! {
    if (size < I64{0} || align <= I64{0}) { return false }
    if ((align.bit_and(wrapping(align - I64{1}))) != I64{0}) { return false }
    effective :: if (size == I64{0}) -> I64{1} else -> size
    effective <= wrapping(I64{9223372036854775807} - wrapping(align - I64{1}))
}

// Returns the block class, or zero for a direct mapping. The conservative
// alignment slack includes every metadata word, so payload alignment never
// consumes a byte belonging to a neighbouring block. The power-of-two class
// is chosen by at most four comparisons: this runs on every allocation and
// every free. Small blocks start 32-aligned (slab offsets are multiples of
// the class), so an align-8 payload at block+24 needs no slack.
fn alloc_class(size: I64, align: I64) -> I64 Never! {
    effective :: if (size == I64{0}) -> I64{1} else -> size
    if (effective > I64{4096} || align > I64{4096}) { return I64{0} }
    slack :: if (align == I64{8}) -> I64{0} else -> wrapping(align - I64{1})
    needed :: wrapping(effective + alloc_header(align) + slack)
    if (needed <= I64{256}) {
        if (needed <= I64{64}) { return if (needed <= I64{32}) -> I64{32} else -> I64{64} }
        return if (needed <= I64{128}) -> I64{128} else -> I64{256}
    }
    if (needed <= I64{1024}) { return if (needed <= I64{512}) -> I64{512} else -> I64{1024} }
    if (needed <= I64{2048}) { return I64{2048} }
    if (needed <= I64{4096}) -> I64{4096} else -> I64{0}
}

// Metadata bytes before a payload: [count][slab][block-start] for align >= 8,
// [slab][block-start] below that.
fn alloc_header(align: I64) -> I64 Never! {
    if (align >= I64{8}) -> I64{24} else -> I64{16}
}

// A fresh block's first owner: the count word of an align >= 8 payload.
fn alloc_count_init(pointer: I64, align: I64) {
    if (align < I64{8} || pointer == I64{0}) -> return
    #Unsafe("pointer is a fresh payload whose align >= 8 block reserved the word 24 bytes before it") {
        os_store_i64(wrapping(pointer - I64{24}), I64{1})
    }
}

// The class's available-slab head word in an arena: classes 32..4096 are
// words 8..64 of the arena row; their retained-empty cells follow 64 bytes on.
fn alloc_head(root: I64, slot: I64) -> I64 Never! {
    if (slot <= I64{256}) {
        if (slot <= I64{64}) { return wrapping(root + (if (slot == I64{32}) -> I64{8} else -> I64{16})) }
        return wrapping(root + (if (slot == I64{128}) -> I64{24} else -> I64{32}))
    }
    if (slot <= I64{1024}) { return wrapping(root + (if (slot == I64{512}) -> I64{40} else -> I64{48})) }
    wrapping(root + (if (slot == I64{2048}) -> I64{56} else -> I64{64}))
}

fn alloc_align(address: I64, align: I64) -> I64 Never! {
    mask :: wrapping(align - I64{1})
    wrapping(address + mask).bit_and(mask.bit_not())
}

fn alloc_map_try(bytes: I64) -> I64 {
    #Unsafe("anonymous private mmap owns fresh writable bytes and cannot alias a live heap block; a failed syscall produces no allocation") {
        address :: os_syscall_i64(I64{9}, I64{0}, bytes, I64{3}, I64{34}, I64{-1}, I64{0})
        if (address < I64{0}) { return I64{0} }
        return address
    }
}

fn alloc_map(bytes: I64, failed_size: I64) -> I64 {
    address :: alloc_map_try(bytes)
    if (address == I64{0}) { alloc_out_of_memory(failed_size) }
    address
}

fn alloc_unmap(address: I64, bytes: I64) {
    #Unsafe("the caller has removed this mapping from all heap lists and no payload remains live") {
        _ := os_syscall_i64(I64{11}, address, bytes, I64{0}, I64{0}, I64{0}, I64{0})
    }
}

// runtime-init: 0
#Export(c) fn jet_rt_alloc_init() {
    if (alloc_root != I64{0}) {
        return
    }
    // mmap is zero-filled: the locks, every free-list head, every live total
    // and the large cache start at zero.
    alloc_root = alloc_map(I64{4096}, I64{4096})
    // The 32 arenas: 32 * 200 bytes in one zero-filled mapping.
    table :: alloc_map(I64{8192}, I64{8192})
    #Unsafe("the fresh state page is private to initialization, which precedes every allocation") {
        os_store_i64(wrapping(alloc_root + I64{208}), table)
    }
    // The initializing thread has no TCB yet; point its GS at the zero word
    // so thread_base() reads 0 instead of faulting on the kernel's GS base 0.
    thread_set_base(thread_detached_base())
}

// The arena roots: rows of the table.
fn alloc_arena_root(index: I64) -> I64 {
    #Unsafe("initialization wrote the arena table word once, before any allocation") {
        return wrapping(os_load_i64(wrapping(alloc_root + I64{208})) + wrapping(index * I64{216}))
    }
}

// The calling thread's arena. Thread stacks are disjoint mappings of at least
// 192 MiB (Thread.jet thread_stack_bytes), so threads running at the same time
// sit in different 128 MiB stack bands; the band's hash picks one of the 32
// arenas. Any arena is correct for any thread: the choice only spreads lock
// traffic, and a block always returns to the arena of its slab.
fn alloc_arena() -> I64 {
    band := I64{0}
    #Unsafe("reads the stack pointer register only; nothing is dereferenced") {
        band = os_stack_address_i64() >> I64{27}
    }
    alloc_arena_root((wrapping(band * I64{-7046029254386353131}) >> I64{59}).bit_and(I64{31}))
}

// Live payloads of class `width`: every block handed out of a slab across
// all arenas minus the blocks parked in attached threads' caches. Isolated
// fixtures use it as their leak witness; the caller is quiescent (no thread
// is allocating, freeing or exiting while it reads).
fn alloc_live_blocks(width: I64) -> I64 {
    total := I64{0}
    index := I64{0}
    loop index < (I64{32}) {
        #Unsafe("the live totals are process-lifetime arena words; the quiescent caller needs no lock to read them") {
            total = wrapping(total + os_load_i64(wrapping(alloc_head(alloc_arena_root(index), width) + I64{128})))
        }
        index = wrapping(index + I64{1})
    }
    if (thread_tls_registry == I64{0}) { return total }
    count_offset :: wrapping(I64{312} + wrapping(alloc_head(I64{0}, width) * I64{2}))
    sync_mutex_lock(thread_tls_registry)
    live :: thread_tls_registry + I64{64}
    count :: sync_load(live)
    data :: sync_load(live + I64{16})
    at := I64{0}
    loop at < count {
        total = wrapping(total - sync_load(sync_load(data + (at + I64{1}) * I64{8}) + count_offset))
        at += I64{2}
    }
    sync_mutex_unlock(thread_tls_registry)
    total
}

// Every allocator lock is one futex word: 0 free, 1 held, 2 held with
// sleepers. An acquirer spins briefly (test before each CAS, so waiters read
// a shared cache line), then sleeps in FUTEX_WAIT_PRIVATE instead of burning
// its core: when compiler threads outnumber the CPUs, a preempted holder no
// longer stalls every spinner for a whole time slice. No TCB, allocation or
// Sync state is involved, so the lock works before any thread is attached.
fn alloc_lock(root: I64) {
    #Unsafe("root is an aligned lock word in the process-lifetime state mapping; CAS/xchg acquire all metadata it protects and the futex wait only reads that word") {
        if (os_cas_i64(root, I64{0}, I64{1}) == I64{0}) -> return
        spins := I64{0}
        loop spins < (I64{128}) {
            os_spin_pause()
            if (os_load_i64(root) == I64{0} && os_cas_i64(root, I64{0}, I64{1}) == I64{0}) -> return
            spins = wrapping(spins + I64{1})
        }
        loop os_swap_i64(root, I64{2}) != (I64{0}) {
            _ := os_syscall_i64(I64{202}, root, I64{128}, I64{2}, I64{0}, I64{0}, I64{0})
        }
    }
}

fn alloc_unlock(root: I64) {
    #Unsafe("the calling thread holds this lock; xchg publishes its completed metadata updates and reports sleepers, and the futex wake only names the word") {
        if (os_swap_i64(root, I64{0}) == I64{2}) {
            _ := os_syscall_i64(I64{202}, root, I64{129}, I64{1}, I64{0}, I64{0}, I64{0})
        }
    }
}

// Remove a slab from its class's available list. Caller holds the heap lock.
fn alloc_unlink(slab: I64) {
    #Unsafe("slab and its linked neighbours are live heap-owned headers protected by the held heap lock") {
        next_slab :: os_load_i64(slab)
        previous :: os_load_i64(wrapping(slab + I64{8}))
        if {
            previous == (I64{0}) -> {
                head :: os_load_i64(wrapping(slab + I64{32}))
                os_store_i64(head, next_slab)
            }
            else -> os_store_i64(previous, next_slab)
        }
        if (next_slab != I64{0}) { os_store_i64(wrapping(next_slab + I64{8}), previous) }
        os_store_i64(slab, I64{0})
        os_store_i64(wrapping(slab + I64{8}), I64{0})
    }
}

// Prepend a slab whose free list was empty. Caller holds the heap lock.
fn alloc_link(slab: I64, head: I64) {
    #Unsafe("head and slab are live heap-owned metadata protected by the held heap lock") {
        first :: os_load_i64(head)
        os_store_i64(slab, first)
        os_store_i64(wrapping(slab + I64{8}), I64{0})
        if (first != I64{0}) { os_store_i64(wrapping(first + I64{8}), slab) }
        os_store_i64(head, slab)
    }
}

fn alloc_new_slab(root: I64, head: I64, slot: I64) -> I64 {
    slab :: alloc_map_try(I64{65536})
    if (slab == I64{0}) { return I64{0} }
    first :: wrapping(slab + (if (slot > I64{64}) -> slot else -> I64{64}))
    end :: wrapping(slab + I64{65536})
    block := first
    free := I64{0}
    #Unsafe("the fresh 64KiB mapping holds every aligned free-block link; the heap lock excludes all list readers") {
        loop wrapping(block + slot) <= end {
            os_store_i64(block, free)
            free = block
            block = wrapping(block + slot)
        }
        os_store_i64(wrapping(slab + I64{16}), free)
        os_store_i64(wrapping(slab + I64{32}), head)
        os_store_i64(wrapping(slab + I64{40}), root)
    }
    alloc_link(slab, head)
    slab
}

// Take up to `limit` free blocks of the class's head slab under the held
// arena lock and thread them, as [next][slab], onto the cache row `row`
// ([head][count]); returns how many were taken: zero only when no slab can
// be mapped. The blocks count as live in the slab; the arena's live total
// grows with them; a retained-empty slab leaves its cell; an emptied slab is
// unlinked.
fn alloc_slab_take(root: I64, head: I64, slot: I64, row: I64, limit: I64) -> I64 {
    #Unsafe("the held arena lock protects the class list, the slab's free links and live count and the arena live total; row is the caller's exclusive cache row; the blocks leave the free list before any caller sees them") {
        slab := os_load_i64(head)
        if (slab == I64{0}) { slab = alloc_new_slab(root, head, slot) }
        if (slab == I64{0}) { return I64{0} }
        free := os_load_i64(wrapping(slab + I64{16}))
        list := os_load_i64(row)
        taken := I64{0}
        loop free != (I64{0}) && taken < limit {
            block :: free
            free = os_load_i64(block)
            os_store_i64(block, list)
            os_store_i64(wrapping(block + I64{8}), slab)
            list = block
            taken = wrapping(taken + I64{1})
        }
        os_store_i64(row, list)
        os_store_i64(wrapping(row + I64{8}), wrapping(os_load_i64(wrapping(row + I64{8})) + taken))
        os_store_i64(wrapping(slab + I64{16}), free)
        live :: os_load_i64(wrapping(slab + I64{24}))
        if (live == I64{0}) { os_store_i64(wrapping(head + I64{64}), I64{0}) }
        os_store_i64(wrapping(slab + I64{24}), wrapping(live + taken))
        total :: wrapping(head + I64{128})
        os_store_i64(total, wrapping(os_load_i64(total) + taken))
        if (free == I64{0}) { alloc_unlink(slab) }
        return taken
    }
}

// Return one block to its slab. Caller holds the slab's arena lock. The slab
// is linked again when its free list was empty; a slab whose last block
// returns is retained as the class's one empty slab or unmapped.
fn alloc_slab_return(slab: I64, block: I64) {
    #Unsafe("the held arena lock protects the slab's free links, live count, class list and live total; the block is no longer any payload or cache entry") {
        free :: os_load_i64(wrapping(slab + I64{16}))
        live :: wrapping(os_load_i64(wrapping(slab + I64{24})) - I64{1})
        os_store_i64(block, free)
        os_store_i64(wrapping(slab + I64{16}), block)
        os_store_i64(wrapping(slab + I64{24}), live)
        head :: os_load_i64(wrapping(slab + I64{32}))
        total :: wrapping(head + I64{128})
        os_store_i64(total, wrapping(os_load_i64(total) - I64{1}))
        if (free == I64{0}) { alloc_link(slab, head) }
        if (live == I64{0}) {
            empty_cell :: wrapping(head + I64{64})
            if (os_load_i64(empty_cell) == I64{0}) { os_store_i64(empty_cell, slab) } else {
                alloc_unlink(slab)
                alloc_unmap(slab, I64{65536})
            }
        }
    }
}

// The locked allocation of a thread without a cache: one block, straight
// from the arena's head slab.
fn alloc_small(root: I64, size: I64, align: I64, slot: I64) -> I64 {
    head :: alloc_head(root, slot)
    // The arena's scratch row (root + 200) is exclusive under its lock.
    scratch :: wrapping(root + I64{200})
    block := I64{0}
    alloc_lock(root)
    #Unsafe("the held arena lock makes the arena's scratch row exclusive; it is emptied again before the lock is released") {
        _ := alloc_slab_take(root, head, slot, scratch, I64{1})
        block = os_load_i64(scratch)
        os_store_i64(scratch, I64{0})
        os_store_i64(wrapping(scratch + I64{8}), I64{0})
    }
    alloc_unlock(root)
    if (block == I64{0}) { return I64{0} }
    pointer :: alloc_align(wrapping(block + alloc_header(align)), align)
    #Unsafe("block is this caller's exclusive block; its two cached words are read before the payload header overwrites them") {
        slab :: os_load_i64(wrapping(block + I64{8}))
        os_store_i64(wrapping(pointer - I64{16}), slab)
        os_store_i64(wrapping(pointer - I64{8}), block)
    }
    pointer
}

// The calling thread's cache row [head][count] for a class, or zero when the
// thread has no TCB (TCB @320 + 16 per class, Thread.jet).
fn alloc_cache_row(slot: I64) -> I64 {
    base :: thread_base()
    if (base == I64{0}) -> I64{0} else -> wrapping(base + wrapping(I64{304} + wrapping(alloc_head(I64{0}, slot) * I64{2})))
}

// Refill this thread's cache row with up to 32 blocks of one slab of the
// stack band's arena. False only when no slab can be mapped.
fn alloc_cache_refill(row: I64, slot: I64) -> Bool {
    root :: alloc_arena()
    alloc_lock(root)
    taken :: alloc_slab_take(root, alloc_head(root, slot), slot, row, I64{32})
    alloc_unlock(root)
    taken != I64{0}
}

// Hand out the cached head block of a row as a payload of `align`, writing
// the same [slab][block-start] header an uncached allocation writes.
fn alloc_cache_pop(row: I64, block: I64, align: I64) -> I64 {
    pointer :: alloc_align(wrapping(block + alloc_header(align)), align)
    #Unsafe("row is this thread's private cache row and block its cached head; both cached words are read before the payload header overwrites them") {
        os_store_i64(row, os_load_i64(block))
        os_store_i64(wrapping(row + I64{8}), wrapping(os_load_i64(wrapping(row + I64{8})) - I64{1}))
        slab :: os_load_i64(wrapping(block + I64{8}))
        os_store_i64(wrapping(pointer - I64{16}), slab)
        os_store_i64(wrapping(pointer - I64{8}), block)
    }
    pointer
}

// Return the first `count` cached blocks of a row to their slabs, each under
// its own slab's arena lock; consecutive blocks of one arena share a hold.
fn alloc_cache_drain(row: I64, count: I64) {
    held := I64{0}
    remaining := count
    #Unsafe("row is this thread's private cache row; each cached block's slab is live while the block is cached, so its arena word is readable, and the block returns under that arena's lock") {
        block := os_load_i64(row)
        loop remaining > (I64{0}) && block != (I64{0}) {
            next_block :: os_load_i64(block)
            slab :: os_load_i64(wrapping(block + I64{8}))
            root :: os_load_i64(wrapping(slab + I64{40}))
            if (root != held) {
                if (held != I64{0}) { alloc_unlock(held) }
                alloc_lock(root)
                held = root
            }
            alloc_slab_return(slab, block)
            block = next_block
            remaining = wrapping(remaining - I64{1})
        }
        os_store_i64(row, block)
        os_store_i64(wrapping(row + I64{8}), wrapping(os_load_i64(wrapping(row + I64{8})) - wrapping(count - remaining)))
    }
    if (held != I64{0}) { alloc_unlock(held) }
}

// Return every cached block of the calling thread: thread exit, and the
// fixtures that inspect slab metadata. A thread without a TCB holds none.
fn alloc_cache_flush() {
    base :: thread_base()
    if (base == I64{0}) {
        return
    }
    row := wrapping(base + I64{320})
    index := I64{0}
    loop index < (I64{8}) {
        #Unsafe("row is one of this thread's eight private cache rows") {
            alloc_cache_drain(row, os_load_i64(wrapping(row + I64{8})))
        }
        row = wrapping(row + I64{16})
        index = wrapping(index + I64{1})
    }
}

// Large size classes in pages: 2, 3, then four steps per doubling from 4
// (4, 5, 6, 7, 8, 10, 12, 14, 16, 20, ...) up to class 58, 65536 pages
// (256 MiB). A class is at most 25% above any need it serves.
fn alloc_large_class_pages(class: I64) -> I64 Never! {
    if (class < I64{2}) { return wrapping(class + I64{2}) }
    step :: wrapping(class - I64{2})
    pages := wrapping(I64{4} + step.bit_and(I64{3}))
    group := step /% I64{4}
    loop group > (I64{0}) {
        pages = wrapping(pages * I64{2})
        group = wrapping(group - I64{1})
    }
    pages
}

// The smallest large class holding `bytes` (page-rounded, above one page),
// or -1 above the largest class.
fn alloc_large_class(bytes: I64) -> I64 Never! {
    pages :: bytes /% I64{4096}
    if (pages > I64{65536}) { return I64{-1} }
    class := I64{0}
    loop alloc_large_class_pages(class) < pages -> class = wrapping(class + I64{1})
    class
}

// A cached mapping of `class`, unlinked from its list, or zero.
fn alloc_large_cached(class: I64) -> I64 {
    lock :: wrapping(alloc_root + I64{216})
    head :: wrapping(alloc_root + wrapping(I64{256} + wrapping(class * I64{8})))
    alloc_lock(lock)
    mapping := I64{0}
    #Unsafe("the large-cache lock owns every class list, its link words and the cached byte count") {
        mapping = os_load_i64(head)
        if (mapping != I64{0}) {
            os_store_i64(head, os_load_i64(mapping))
            total :: wrapping(alloc_root + I64{224})
            os_store_i64(total, wrapping(os_load_i64(total) - wrapping(alloc_large_class_pages(class) * I64{4096})))
        }
    }
    alloc_unlock(lock)
    mapping
}

// Returns a freed large mapping to its class list while the cache holds at
// most 64 MiB, else unmaps it. Mappings above the largest class are unmapped.
fn alloc_large_free(mapping: I64, bytes: I64) {
    class :: alloc_large_class(bytes)
    if (class >= I64{0} && wrapping(alloc_large_class_pages(class) * I64{4096}) == bytes) {
        lock :: wrapping(alloc_root + I64{216})
        alloc_lock(lock)
        cached := false
        #Unsafe("the large-cache lock owns every class list and the cached byte count; the mapping's first word is no live payload once it is freed") {
            total :: wrapping(alloc_root + I64{224})
            held :: os_load_i64(total)
            if (held <= wrapping(I64{67108864} - bytes)) {
                head :: wrapping(alloc_root + wrapping(I64{256} + wrapping(class * I64{8})))
                os_store_i64(mapping, os_load_i64(head))
                os_store_i64(head, mapping)
                os_store_i64(total, wrapping(held + bytes))
                cached = true
            }
        }
        alloc_unlock(lock)
        if cached -> return
    }
    alloc_unmap(mapping, bytes)
}

fn alloc_large(size: I64, align: I64) -> I64 {
    effective :: if (size == I64{0}) -> I64{1} else -> size
    // Extra header/alignment/page padding is internal overhead, not a caller
    // layout error. Refuse an unrepresentable mapping as allocation failure.
    overhead :: wrapping(align - I64{1})
    limit :: wrapping(I64{9223372036854775807} - I64{4119})
    if overhead > limit || effective > wrapping(limit - overhead) -> return I64{0}
    needed :: alloc_align(wrapping(effective + alloc_header(align) + overhead), I64{4096})
    class :: alloc_large_class(needed)
    bytes :: if (class < I64{0}) -> needed else -> wrapping(alloc_large_class_pages(class) * I64{4096})
    mapping := if (class < I64{0}) -> I64{0} else -> alloc_large_cached(class)
    if (mapping == I64{0}) { mapping = alloc_map_try(bytes) }
    if (mapping == I64{0}) { return I64{0} }
    pointer :: alloc_align(wrapping(mapping + alloc_header(align)), align)
    #Unsafe("pointer's two header words and the aligned payload are wholly within this page-rounded class mapping") {
        os_store_i64(wrapping(pointer - I64{16}), mapping)
        os_store_i64(wrapping(pointer - I64{8}), bytes)
    }
    pointer
}

// Session reserve is nullable on bad layout/OOM; every successful allocation
// still uses the same heap and exact-layout free as ordinary native storage.
fn alloc_try_validated(size: I64, align: I64) -> I64 {
    slot :: alloc_class(size, align)
    if (slot == I64{0}) {
        pointer :: alloc_large(size, align)
        alloc_count_init(pointer, align)
        return pointer
    }
    row :: alloc_cache_row(slot)
    pointer := I64{0}
    if (row == I64{0}) { pointer = alloc_small(alloc_arena(), size, align, slot) } else {
        block := I64{0}
        #Unsafe("row is this thread's private cache row") {
            block = os_load_i64(row)
            if (block == I64{0} && alloc_cache_refill(row, slot)) { block = os_load_i64(row) }
        }
        if (block != I64{0}) { pointer = alloc_cache_pop(row, block, align) }
    }
    alloc_count_init(pointer, align)
    pointer
}

// The independent policy lock is never held over heap allocation/deallocation.
// A failed reservation has made no changes, matching reserve's None rail.
// Machine words carry usize bits, including caps/counters above isize::MAX.
fn alloc_unsigned_less(left: I64, right: I64) -> Bool Never! {
    sign :: I64{-9223372036854775808}
    (left.bit_xor(sign)) < (right.bit_xor(sign))
}

fn alloc_counter_add(cell: I64, value: I64) {
    #Unsafe("the caller holds the policy lock and cell is a counter in alloc_root") {
        old :: os_load_i64(cell)
        next_value :: wrapping(old + value)
        os_store_i64(cell, if alloc_unsigned_less(next_value, old) -> I64{-1} else -> next_value)
    }
}

fn alloc_reserve(requested: I64) -> I64 {
    #Unsafe("the aligned mode word is read atomically on x86; system allocation needs no policy lock") {
        if (os_load_i64(wrapping(alloc_root + I64{144})) == I64{0}) { return I64{0} }
    }
    lock :: wrapping(alloc_root + I64{136})
    alloc_lock(lock)
    tracked := I64{0}
    #Unsafe("the policy lock exclusively owns the mode, cap and accounting words") {
        if (os_load_i64(wrapping(alloc_root + I64{144})) != I64{0}) {
            live :: os_load_i64(wrapping(alloc_root + I64{176}))
            cap :: os_load_i64(wrapping(alloc_root + I64{152}))
            next_live :: wrapping(live + requested)
            if alloc_unsigned_less(next_live, live) -> tracked = I64{-1} else {
                if (cap != I64{0} && alloc_unsigned_less(cap, next_live)) { tracked = I64{-1} } else {
                    os_store_i64(wrapping(alloc_root + I64{176}), next_live)
                    alloc_counter_add(wrapping(alloc_root + I64{160}), I64{1})
                    alloc_counter_add(wrapping(alloc_root + I64{168}), requested)
                    high :: os_load_i64(wrapping(alloc_root + I64{184}))
                    if alloc_unsigned_less(high, next_live) {
                        os_store_i64(wrapping(alloc_root + I64{184}), next_live)
                    }
                    tracked = I64{1}
                }
            }
        }
    }
    alloc_unlock(lock)
    tracked
}

fn alloc_release(requested: I64) {
    if (requested == I64{0}) {
        return
    }
    lock :: wrapping(alloc_root + I64{136})
    alloc_lock(lock)
    #Unsafe("the policy lock exclusively owns live bytes; restoration does not erase outstanding tracked blocks") {
        cell :: wrapping(alloc_root + I64{176})
        live :: os_load_i64(cell)
        os_store_i64(cell, if alloc_unsigned_less(live, requested) -> I64{0} else -> wrapping(live - requested))
    }
    alloc_unlock(lock)
}

// Explicit host policy edge: serialize runs outside this call, as the Rust
// config guard does. Save fact5 (mode) and fact4 (cap) before configuring, and
// restore them with the distinct restore edge below, retaining run counters.
#Export(c) fn jet_rt_program_allocator_configure(mode: I64, cap: I64) {
    lock :: wrapping(alloc_root + I64{136})
    alloc_lock(lock)
    #Unsafe("the held policy lock serializes all native allocator configuration and reservations") {
        os_store_i64(wrapping(alloc_root + I64{144}), if (mode == I64{1}) -> I64{1} else -> I64{0})
        os_store_i64(wrapping(alloc_root + I64{152}), cap)
        if (os_load_i64(wrapping(alloc_root + I64{176})) == I64{0}) {
            os_store_i64(wrapping(alloc_root + I64{160}), I64{0})
            os_store_i64(wrapping(alloc_root + I64{168}), I64{0})
            os_store_i64(wrapping(alloc_root + I64{184}), I64{0})
        }
    }
    alloc_unlock(lock)
}

// ProgramAllocator.rs126-130: restoration changes policy, never historical
// counters, even after the final counted allocation has been freed.
#Export(c) fn jet_rt_program_allocator_restore(mode: I64, cap: I64) {
    lock :: wrapping(alloc_root + I64{136})
    alloc_lock(lock)
    #Unsafe("the policy lock serializes restoration with native reserve and free; tracked blocks remain in the side table") {
        os_store_i64(wrapping(alloc_root + I64{144}), if (mode == I64{1}) -> I64{1} else -> I64{0})
        os_store_i64(wrapping(alloc_root + I64{152}), cap)
    }
    alloc_unlock(lock)
}

// Facts0..5: allocations, requested, live, high-water, cap, current mode.
#Export(c) fn jet_rt_program_allocator_fact(index: I64) -> I64 {
    if (index < I64{0} || index > I64{5}) { return I64{0} }
    offset :: if (index < I64{4}) -> wrapping(I64{160} + index * I64{8}) else if (index == I64{4}) -> I64{152} else -> I64{144}
    lock :: wrapping(alloc_root + I64{136})
    alloc_lock(lock)
    value := I64{0}
    #Unsafe("the policy lock protects this bounded fact word in alloc_root") {
        value = os_load_i64(wrapping(alloc_root + offset))
    }
    alloc_unlock(lock)
    value
}

// ProgramAllocator.rs333-394: tracker allocation bypasses selected policy,
// cannot recurse, and exists only for counted payloads. Allocation failures
// release the reservation and free the payload before returning zero.
fn alloc_track(pointer: I64, requested: I64) -> Bool {
    node :: alloc_try_validated(I64{24}, I64{8})
    if (node == I64{0}) { return false }
    lock :: wrapping(alloc_root + I64{136})
    alloc_lock(lock)
    #Unsafe("the private raw-heap node is fully initialized before linking under the policy/tracker lock") {
        os_store_i64(node, pointer)
        os_store_i64(wrapping(node + I64{8}), requested)
        os_store_i64(wrapping(node + I64{16}), os_load_i64(wrapping(alloc_root + I64{192})))
        os_store_i64(wrapping(alloc_root + I64{192}), node)
        count :: os_load_i64(wrapping(alloc_root + I64{200}))
        os_store_i64(wrapping(alloc_root + I64{200}), wrapping(count + I64{1}))
    }
    alloc_unlock(lock)
    true
}

fn alloc_untrack(pointer: I64) -> I64 {
    #Unsafe("the process-lifetime tracker count is an aligned x86 word; a zero count avoids any lookup or lock") {
        if (os_load_i64(wrapping(alloc_root + I64{200})) == I64{0}) { return I64{0} }
    }
    lock :: wrapping(alloc_root + I64{136})
    alloc_lock(lock)
    node := I64{0}
    requested := I64{0}
    #Unsafe("the policy/tracker lock exclusively owns all side-table links and count") {
        link := wrapping(alloc_root + I64{192})
        current := os_load_i64(link)
        loop current != (I64{0}) {
            if (os_load_i64(current) == pointer) {
                node = current
                requested = os_load_i64(wrapping(current + I64{8}))
                os_store_i64(link, os_load_i64(wrapping(current + I64{16})))
                count :: os_load_i64(wrapping(alloc_root + I64{200}))
                os_store_i64(wrapping(alloc_root + I64{200}), wrapping(count - I64{1}))
                break
            }
            link = wrapping(current + I64{16})
            current = os_load_i64(link)
        }
    }
    alloc_unlock(lock)
    if (node != I64{0}) { alloc_free_validated(node, I64{24}, I64{8}) }
    requested
}

fn alloc_try_reserved(size: I64, align: I64) -> I64 {
    requested :: if (size == I64{0}) -> I64{1} else -> size
    tracked :: alloc_reserve(requested)
    if (tracked < I64{0}) { return I64{0} }
    pointer :: alloc_try_validated(size, align)
    if (pointer == I64{0}) {
        if (tracked != I64{0}) { alloc_release(requested) }
        return I64{0}
    }
    if (tracked != I64{0} && !alloc_track(pointer, requested)) {
        alloc_free_validated(pointer, size, align)
        alloc_release(requested)
        return I64{0}
    }
    pointer
}

fn alloc_try(size: I64, align: I64) -> I64 {
    if !alloc_layout_valid(size, align) -> return I64{0}
    if jet_fault_should_fail_allocation() -> return I64{0}
    alloc_try_reserved(size, align)
}

#Export(c) fn jet_rt_alloc_try(size: I64, align: I64) -> I64 { alloc_try(size, align) }

#Export(c) fn jet_rt_alloc(size: I64, align: I64) -> I64 {
    if !alloc_layout_valid(size, align) {
        rt_trap_invalid_box_layout()
        return I64{0}
    }
    alloc_required_valid(size, align)
}

#Export(c) fn jet_rt_free(pointer: I64, size: I64, align: I64) {
    // Match the original C ABI's null no-op before validating its layout.
    if (pointer == I64{0}) {
        return
    }
    if !alloc_layout_valid(size, align) {
        rt_trap_invalid_box_layout()
        return
    }
    alloc_release(alloc_untrack(pointer))
    alloc_free_validated(pointer, size, align)
}

// Private callers prove the layout from literal sizes and exact live-owner
// layouts. This is the same heap/policy/tracker; only redundant Layout
// validation is absent. Allocation failure remains terminal SIGABRT.
fn alloc_required_valid(size: I64, align: I64) -> I64 {
    pointer :: alloc_try_reserved(size, align)
    if (pointer == I64{0}) { alloc_out_of_memory(if (size == I64{0}) -> I64{1} else -> size) }
    pointer
}
fn alloc_release_valid(pointer: I64, size: I64, align: I64) {
    if (pointer == I64{0}) -> return
    alloc_release(alloc_untrack(pointer))
    alloc_free_validated(pointer, size, align)
}

fn alloc_free_validated(pointer: I64, size: I64, align: I64) {
    slot :: alloc_class(size, align)
    if (slot == I64{0}) {
        #Unsafe("the lowering returns this still-live direct allocation with exactly its original size and alignment") {
            mapping :: os_load_i64(wrapping(pointer - I64{16}))
            bytes :: os_load_i64(wrapping(pointer - I64{8}))
            alloc_large_free(mapping, bytes)
        }
        return
    }
    row :: alloc_cache_row(slot)
    if (row != I64{0}) {
        // A row holding 64 blocks first returns its 32 most recently pushed
        // ones to their slabs, then takes this block.
        #Unsafe("row is this thread's private cache row; the lowering frees exactly once with the allocation's original layout, so the payload header is read before the block's cached words overwrite it") {
            if (os_load_i64(wrapping(row + I64{8})) >= I64{64}) { alloc_cache_drain(row, I64{32}) }
            slab :: os_load_i64(wrapping(pointer - I64{16}))
            block :: os_load_i64(wrapping(pointer - I64{8}))
            os_store_i64(block, os_load_i64(row))
            os_store_i64(wrapping(block + I64{8}), slab)
            os_store_i64(row, block)
            os_store_i64(wrapping(row + I64{8}), wrapping(os_load_i64(wrapping(row + I64{8})) + I64{1}))
        }
        return
    }
    slab := I64{0}
    root := I64{0}
    #Unsafe("the caller's live payload header names its slab, whose arena word is fixed when the slab is created") {
        slab = os_load_i64(wrapping(pointer - I64{16}))
        root = os_load_i64(wrapping(slab + I64{40}))
    }
    alloc_lock(root)
    #Unsafe("the lowering frees exactly once with the allocation's original layout; its slab remains live until this last payload is returned under its arena's lock") {
        alloc_slab_return(slab, os_load_i64(wrapping(pointer - I64{8})))
    }
    alloc_unlock(root)
}

// Write a little-endian packed literal without a String/list carrier or a
// mapping. The checked count bounds the stack word borrowed by the OS leaf.
fn alloc_write_word(word: I64, count: I64) {
    if (count < I64{0} || count > I64{8}) {
        return
    }
    remaining := count
    bytes := word
    #Unsafe("remaining is in 1..=8, so write borrows only the initialized stack word; a short write advances within it") {
        loop remaining > (I64{0}) {
            written :: os_write_word_i64(I64{2}, bytes, remaining)
            if (written == I64{-4}) { next }
            if (written <= I64{0}) {
                return
            }
            remaining = wrapping(remaining - written)
            if (remaining > I64{0}) { bytes = bytes >> wrapping(written * I64{8}) }
        }
    }
}

// Emit decimal digits most-significant first without allocating a buffer.
fn alloc_write_size(size: I64) {
    scale := I64{1}
    loop scale <= size /% (I64{10}) -> scale = wrapping(scale * I64{10})
    remaining := size
    loop scale > (I64{0}) {
        digit :: remaining /% scale
        alloc_write_word(wrapping(I64{48} + digit), I64{1})
        remaining = wrapping(remaining - wrapping(digit * scale))
        scale = scale /% I64{10}
    }
}

fn alloc_out_of_memory(size: I64) {
    // std::alloc::handle_alloc_error: \"memory allocation of N bytes failed\\n\"
    // followed by SIGABRT, not a Jet program-stop exit status.
    alloc_write_word(I64{6998727353336423789}, I64{8})
    alloc_write_word(I64{8028075772393516140}, I64{8})
    alloc_write_word(I64{139157512302}, I64{5})
    alloc_write_size(size)
    alloc_write_word(I64{7359008670706393632}, I64{8})
    alloc_write_word(I64{11426314611041}, I64{6})
    alloc_abort()
}

// One process-abort mechanism for allocation failure and panic in cleanup.
fn alloc_abort() {
    #Unsafe("the stack-word syscalls unblock SIGABRT and, if necessary, restore its default disposition before raising it again; no heap pointer is needed") {
        pid :: os_syscall_i64(I64{39}, I64{0}, I64{0}, I64{0}, I64{0}, I64{0}, I64{0})
        _ := os_syscall_stack4_i64(I64{14}, I64{1}, I64{32}, I64{0}, I64{0}, I64{0}, I64{8})
        _ := os_syscall_i64(I64{62}, pid, I64{6}, I64{0}, I64{0}, I64{0}, I64{0})
        _ := os_syscall_stack4_i64(I64{13}, I64{6}, I64{0}, I64{0}, I64{0}, I64{0}, I64{8})
        _ := os_syscall_i64(I64{62}, pid, I64{6}, I64{0}, I64{0}, I64{0}, I64{0})
        _ := os_syscall_i64(I64{231}, I64{127}, I64{0}, I64{0}, I64{0}, I64{0}, I64{0})
    }
    loop {

    }
}
