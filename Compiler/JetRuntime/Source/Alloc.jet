// Independent Linux x86-64 heap for boxes/storage emitted by native lowering.
// No Core allocation API, libc allocator, sentry, or exact-Int operation
// participates. The ABI is three machine words, matching the lowering's calls.
//
// State layout: word 0 of the state page is the detached-thread GS target
// (Thread.jet thread_detached_base): it always reads zero, so thread_base()
// yields 0 on a thread that has no TCB and the allocator takes its locked
// path there. Word 208 holds the table of the 32 arenas (216 bytes each:
// [lock 0][8 available-slab heads 8..64][8 retained-empty-slab counts
// 72..128][8 live totals 136..192][scratch row 200..208 for uncached takes]);
// the large-block cache owns lock 216, cached bytes 224 (atomic) and 59 class heads
// from 256; the slab regions own lock 736, cursor 744, end 752, the
// free-slab stack 760 and the next region size 768 (alloc_slab_map); words
// 232 and 240 are the page map's root and lock (ALLOC_PAGE_MAP); words 776
// to 896 are the region window's base, cursor and class stacks
// (ALLOC_WINDOW).
// The state page also reserves word 4080 for the execution-end flush lock
// and word 4088 for ignored raw stdio outputs (the I64/Bool outputs alias).
// Word 1024 stays zero: a thread without a TCB reads it as its stack limit
// (StackSegment.jet STACK_TCB_LIMIT), so its stack never grows.
// Each 64 KiB slab belongs to one arena and one power-of-two class
// (32..4096). Slab layout: [next][prev][free][live][head-cell][arena][carve]
// followed by padding to max(64, class-size), then the blocks. A block that
// was never handed out is not on the free list: `carve` is the next such
// block (zero once none is left), so a page is first touched when one of its
// blocks is first taken. Returned blocks go on the intrusive free list.
// A live block stores [slab][block-start] immediately before its aligned payload.
// Large/over-aligned mappings instead store [mapping-base][mapping-length].
// A block allocated with align >= 8 also carries one reference-count word
// before those two (payload-24, #5041 P2), set to 1 here: every List/Map/
// Set/Queue buffer and every Option/Result/enum box is such a block, so any
// owner can share it (Refcount.jet jet_rt_block_retain/release/unique) no
// matter which runtime route or lowering site allocated it. Byte buffers
// (align < 8, text data) keep the two-word header and have no count.
// Only slabs with a block to give (free or still to carve) are linked. An
// attached thread allocates and frees small blocks through its own cache
// first (TCB @320, Thread.jet):
// eight [head][count] rows, one per class, of blocks threaded through their
// first two words as [next][slab]. The cache needs no atomic: only its owner
// touches it. It refills with up to 32 blocks of one slab under the arena
// lock of the stack band's arena (alloc_arena), and when it holds 64 blocks a
// free first returns 32 of them, each to its own slab under that slab's
// arena lock. A cached block counts as live in its slab, so a slab is unmapped
// only when no payload and no cache holds any of its blocks; the arena row's
// live total per class counts every block out of a slab the same way, and
// alloc_live_blocks subtracts the cached ones for the leak-witness fixtures.
// Thread exit (jet_rt_thread_detach) returns the whole cache. A thread without
// a TCB (before attach, foreign) allocates from the arena its stack band
// selects (alloc_arena) and a block returns to its slab's arena;
// each arena's slab metadata is protected by that arena's futex lock
// (alloc_lock: a short spin, then a kernel sleep), so threads on different
// stacks rarely contend and a waiter never burns a core. Payloads belong exclusively to
// their callers. At most ALLOC_RETAINED_EMPTY_SLABS empty slabs per class and
// arena stay linked to avoid relinking on every temporary; additional empty
// slabs go on the process's free-slab stack, still mapped, for the next new
// slab of any class (alloc_slab_map: slabs are carved from slab regions and
// their pages never fault twice). Large mappings are rounded to a size class (at most 25% over
// the page-rounded need) and a freed one is kept, in a row of the freeing
// thread's TCB (ALLOC_LARGE_ROWS) or on its class list, while the cache holds
// at most ALLOC_LARGE_CACHE_BYTES in all (resident pages a compiler keeps, so
// the bound stays small), for the next allocation of that class instead of
// munmap + mmap; reused large blocks are not zeroed, as small blocks never
// are. The state page, the arena table, the retained empty slabs and the
// cached large mappings are bounded allocator-owned process-lifetime
// metadata/cache, not live payload allocations.
// The program allocator policy (jet_rt_program_allocator_*) shares this heap: independent
// lock136, mode144 (0 system/1 counting), cap152, allocations160, requested168,
// live176, high-water184. Counters saturate; successful reservations count even
// when a later mmap fails, but that failure cancels live bytes before returning.
// Counted allocations alone own a raw-heap tracker node [ptr,requested,next].
// Head192 and count200 share the policy lock; system-mode block layout and
// allocation cost are unchanged. Free skips lookup while tracked count is zero.
// The runtime object exports alloc_root as jet_rt_alloc_root (JetBackend
// RuntimeObject.jet X64_ALLOC_ROOT_SYMBOL): `jet debug` reads mode144,
// allocations160 and high-water184 through it as the program exits and names
// a counting policy's totals in its end report (JetDebug Native.jet
// NATIVE_ALLOC_MODE), so the layout above is read from outside the program.
//
// Checked mode (alloc_class_limit, the "Checked mode" section below) is on
// exactly in a program built with `--checked-alloc`: its hook
// jet_rt_alloc_check_init, which only such a build keeps, turns it on before
// the first allocation. Nothing reads the environment for it.
//
// The runtime object puts jet_rt_alloc_init in .init_array, so initialization
// precedes all user code in both programs and entryless libraries. There is no
// lazy initialization or separate jet_rt_main initialization mechanism.
alloc_root := I64{0}

// The largest payload a size class serves on the ordinary path. Checked mode
// sets it to 0, so every allocation and free takes the direct-mapping branch,
// which then hands it to the checked heap: off, checked mode adds no branch
// to the class path, only this word's load. Written by alloc_check_start,
// from jet_rt_alloc_check_init after it installed the checked heap's code
// words, before any allocation, and by a debugger around an evaluation in
// a stopped program, which writes this word and the code words itself (the
// runtime object exports them by name, JetBackend X64_DEBUG_EVAL_STORAGE) and
// puts them back after: a 0 limit means a heap is installed in the code
// words.
ALLOC_CLASS_LIMIT: I64{4096}

alloc_class_limit := I64{4096}

// The checked heap is linked only into a program built with
// `--checked-alloc`: its entry calls jet_rt_alloc_check_link, which keeps
// alloc_check_linked and so the jet_rt_alloc_check_init hook. The hook
// installs these code words (jet_rt_alloc_check_take, _give, _sweep) before
// any allocation; 0 in a program built without the checker. The prelinked
// runtime image leaves jet_rt_alloc_check_link out (JetBackend
// Image/RuntimePack.jet), so it holds no checked heap and a checked program
// links the pack in full.
alloc_check_take_code := I64{0}

alloc_check_give_code := I64{0}

alloc_check_sweep_code := I64{0}

// 1 once jet_rt_alloc_check_init has installed the checked heap.
alloc_check_linked := I64{0}

// A C witness's take and give observers (jet_rt_alloc_check_observe), 0 for
// none.
alloc_check_take_observer := I64{0}

alloc_check_give_observer := I64{0}

// The checked heap's live list under the alloc lens (alloc_check_track_start):
// 2 once the observation start arms it, 1 once the entry starts it
// (alloc_check_track_entry), its first block, and the heap snapshots taken
// so far (alloc_check_track_hold). The quarantine lock guards all but the
// switch, which each take loads once.
alloc_check_tracking := I64{0}

alloc_check_live_head := I64{0}

alloc_check_snapshots := I64{0}

// The TCB of the thread whose blocks the live list leaves out, the
// observation writer's (alloc_check_track_skip_thread), -1 for none: its
// publications and the heap snapshots it takes for `jet perf attach` are
// the observation's own blocks, not the program's.
alloc_check_track_skipped := I64{-1}

// Layout.from_size_align(size.max(1), align): alignment must be a nonzero
// power of two, and rounding the size to alignment must fit isize.MAX.
alloc_layout_valid: fn(size: I64, align: I64) -> Bool Never! {
    if (size < I64{0} || align <= I64{0}) { return false }
    if ((align & wrapping(align - I64{1})) != I64{0}) { return false }
    effective: if (size == I64{0}) -> I64{1} else -> size
    effective <= wrapping(I64{9223372036854775807} - wrapping(align - I64{1}))
}

// Returns the block class, or zero for a direct mapping (every payload above
// `limit`: ALLOC_CLASS_LIMIT, or alloc_class_limit). The conservative
// alignment slack includes every metadata word, so payload alignment never
// consumes a byte belonging to a neighboring block. The power-of-two class
// is chosen by at most four comparisons: this runs on every allocation and
// every free. Small blocks start 32-aligned (slab offsets are multiples of
// the class), so an align-8 payload at block+24 needs no slack.
alloc_class: fn(size: I64, align: I64, limit: I64) -> I64 Never! {
    effective: if (size == I64{0}) -> I64{1} else -> size
    if (effective > limit || align > I64{4096}) { return I64{0} }
    slack: if (align == I64{8}) -> I64{0} else -> wrapping(align - I64{1})
    needed: wrapping(effective + alloc_header(align) + slack)
    if (needed <= I64{256}) {
        if (needed <= I64{64}) { return if (needed <= I64{32}) -> I64{32} else -> I64{64} }
        return if (needed <= I64{128}) -> I64{128} else -> I64{256}
    }
    if (needed <= I64{1024}) { return if (needed <= I64{512}) -> I64{512} else -> I64{1024} }
    if (needed <= I64{2048}) { return I64{2048} }
    if (needed <= I64{4096}) -> I64{4096} else -> I64{0}
}

// The thread cache row of a block of `needed` bytes (1 through 7680): row k
// (TCB @320 + 16 k, alloc_cache_row) holds class 32 << k, k the bit length
// of (needed - 1) >> 5, and 8 is a block above every class. The fast paths
// below take it from two packed nibble rows instead of a ladder of
// comparisons, which a mix of sizes mispredicts: the high nibble h of that
// value reads 0 for 0, 4 + bits(h) up to 7 and 8 above, more than any low
// nibble's bits(l) <= 4, so the row is the high entry unless it is 0, and
// then the low entry. It is alloc_class's choice, as a row.
ALLOC_ROW_LOW: I64{0x4444444433332210}

ALLOC_ROW_HIGH: I64{0x888888877776650}

alloc_row: fn(needed: I64) -> I64 Never! {
    k: wrapping(needed - I64{1}) >> I64{5}
    high: (ALLOC_ROW_HIGH >> (((k >> I64{4}) & I64{15}) << I64{2})) & I64{15}
    low: (ALLOC_ROW_LOW >> ((k & I64{15}) << I64{2})) & I64{15}
    high | low & wrapping(high - I64{1}) >> I64{63}
}

// Metadata bytes before a payload: [count][slab][block-start] for align >= 8,
// [slab][block-start] below that.
alloc_header: fn(align: I64) -> I64 Never! { if (align >= I64{8}) -> I64{24} else -> I64{16} }

// A fresh block's first owner: the count word of an align >= 8 payload.
priv alloc_count_init: fn(pointer: I64, align: I64) {
    if (align < I64{8} || pointer == I64{0}) {
        return
    }
    #Unsafe("pointer is a fresh payload whose align >= 8 block reserved the word 24 bytes before it") {
        os_store_i64(wrapping(pointer - I64{24}), I64{1})
    }
}

// A block whose count word carries the zero-at-free mark (Refcount.jet
// RC_ZERO_MARK) is wiped before the allocator may hand its bytes out again.
alloc_zero_marked: fn(pointer: I64, size: I64) {
    #Unsafe("pointer is an align >= 8 payload being freed with its allocated size; its block reserved the count word 24 bytes before it") {
        if (os_load_i64(wrapping(pointer - I64{24})) & RC_ZERO_MARK == I64{0}) {
            return
        }
    }
    rt_wipe_bytes(pointer, size)
}

// The class's available-slab head word in an arena: classes 32..4096 are
// words 8..64 of the arena row; their retained-empty cells follow 64 bytes on.
alloc_head: fn(root: I64, slot: I64) -> I64 Never! {
    if (slot <= I64{256}) {
        if (slot <= I64{64}) {
            return wrapping(root + (if (slot == I64{32}) -> I64{8} else -> I64{16}))
        }
        return wrapping(root + (if (slot == I64{128}) -> I64{24} else -> I64{32}))
    }
    if (slot <= I64{1024}) {
        return wrapping(root + (if (slot == I64{512}) -> I64{40} else -> I64{48}))
    }
    wrapping(root + (if (slot == I64{2048}) -> I64{56} else -> I64{64}))
}

alloc_align: fn(address: I64, align: I64) -> I64 Never! {
    mask: wrapping(align - I64{1})
    wrapping(address + mask) &~ mask
}

// `bytes` of fresh private read-write pages at `hint` (0: anywhere) with mmap
// `flags`, MAP_PRIVATE|MAP_ANONYMOUS among them: the address, or mmap's
// negative errno. The memory sentry is not told (os_map_untracked_i64).
alloc_map_anonymous: fn(hint: I64, bytes: I64, flags: I64) -> I64 {
    #Unsafe("anonymous private mmap owns fresh writable bytes and cannot alias a live heap block; a failed syscall produces no allocation") {
        return os_map_untracked_i64(hint, bytes, I64{3}, flags, I64{-1}, I64{0})
    }
}

// `bytes` of fresh private read-write pages, or 0. The sentry is not told:
// the heap's blocks are registered one by one as they are handed out, and
// the allocator's own state is read by the runtime alone.
alloc_map_try: fn(bytes: I64) -> I64 {
    address: alloc_map_anonymous(I64{0}, bytes, I64{34})
    if (address < I64{0}) -> I64{0} else -> address
}

alloc_map: fn(bytes: I64, failed_size: I64) -> I64 {
    address: alloc_map_try(bytes)
    if (address == I64{0}) { alloc_out_of_memory(failed_size) }
    address
}

alloc_unmap: fn(address: I64, bytes: I64) {
    #Unsafe("the caller owns this mapping and uses no pointer into it again") {
        _ := os_unmap_untracked_i64(address, bytes)
    }
}

// A fresh read/write shared mapping of `bytes` of the open `descriptor`, or
// the kernel's negative errno; the caller unmaps a mapping exactly once with
// alloc_unmap and this size. Untracked: only the runtime's shared-memory
// calls read and write it, each within the descriptor's size.
alloc_map_shared: fn(bytes: I64, descriptor: I64) -> I64 {
    #Unsafe("a fresh shared mapping of the descriptor aliases no heap block; a failed syscall maps nothing") {
        return os_map_untracked_i64(I64{0}, bytes, I64{3}, I64{1}, descriptor, I64{0})
    }
}

// The open `descriptor`'s first `bytes`, mapped read/write and shared over
// the caller's own reservation at `address` (MAP_SHARED|MAP_FIXED), which
// it replaces; `address`, or the kernel's negative errno, after which the
// reservation may be gone. Untracked: only the runtime's live-file code
// (PerfSamples.jet perf_live_open) reads and writes it, within the
// descriptor's size.
alloc_map_shared_at: fn(address: I64, bytes: I64, descriptor: I64) -> I64 {
    #Unsafe("the caller owns the reservation the fixed mapping replaces, and a shared mapping of the descriptor aliases no heap block") {
        return os_map_untracked_i64(address, bytes, I64{3}, I64{17}, descriptor, I64{0})
    }
}

// Makes `bytes` at the page-aligned `address` of a mapping the caller owns
// inaccessible, as a stack guard.
alloc_guard: fn(address: I64, bytes: I64) {
    #Unsafe("the caller owns these whole pages of its own mapping and keeps no live value in them") {
        _ := os_syscall_i64(I64{10}, address, bytes, I64{0}, I64{0}, I64{0}, I64{0})
    }
}

// The page map: every region core.mem.Region.reserve maps
// is registered by address, so growth and drop find the allocator that
// served a block from the block's address alone, with no header word; a miss
// is the program heap. A region is mapped at 64 KiB alignment in whole
// 64 KiB units (ALLOC_PAGE_UNIT), so no heap mapping shares a unit with it.
// State word 232 (ALLOC_PAGE_MAP) names the root table, 0 until the first
// region: one word per 4 GiB span of the 47-bit user address space, each 0
// or a span table of one word per unit, 0 or the region's record [base 0]
// [mapped bytes 8][carrier 16]. The tables are fresh mappings the kernel
// commits on first touch and live as long as the process; lock 240
// (ALLOC_PAGE_LOCK) serializes their writes, and a lookup reads their
// aligned words without it. Word 232 shares the cache line of the tracked
// count 200 that every free already reads. The record's carrier is the
// `#Context(allocator:)` carrier that last served a block from the region
// (alloc_user_take), 0 before any did.
ALLOC_PAGE_MAP: I64{232}

ALLOC_PAGE_LOCK: I64{240}

ALLOC_PAGE_UNIT: I64{65536}

ALLOC_PAGE_ROOT_BYTES: I64{262144}

ALLOC_PAGE_SPAN_BYTES: I64{524288}

ALLOC_PAGE_LIMIT: I64{140737488355328}

// `bytes` rounded up to whole page-map units.
alloc_page_bytes: fn(bytes: I64) -> I64 Never! {
    wrapping(bytes + wrapping(ALLOC_PAGE_UNIT - I64{1})) &~ wrapping(ALLOC_PAGE_UNIT - I64{1})
}

// The record of the registered region holding `address`, or 0: the heap.
priv alloc_page_region: fn(address: I64) -> I64 {
    if (address <= I64{0} || address >= ALLOC_PAGE_LIMIT) { return I64{0} }
    #Unsafe("the root and span tables are process-lifetime mappings, zero where nothing is registered, whose aligned words are read atomically on x86") {
        root: os_load_i64(wrapping(alloc_root + ALLOC_PAGE_MAP))
        if (root == I64{0}) { return I64{0} }
        span: os_load_i64(wrapping(root + wrapping((address >> I64{32}) * I64{8})))
        if (span == I64{0}) { return I64{0} }
        return os_load_i64(wrapping(span + wrapping(((address >> I64{16}) & I64{65535}) * I64{8})))
    }
}

// Points every unit of [base, base + bytes) at `record` (0 clears them).
// A window run's units are written with no lock: the window's span tables
// exist from its start (alloc_window), and only the run's owner writes its
// units. Any other range takes the page lock. False, with no unit written,
// when a table cannot be mapped.
alloc_page_set: fn(base: I64, bytes: I64, record: I64) -> Bool {
    if alloc_window_holds(base) {
        alloc_page_write(base, bytes, record)
        return true
    }
    lock: wrapping(alloc_root + ALLOC_PAGE_LOCK)
    alloc_lock(lock)
    ok: alloc_page_spans(base, bytes)
    if ok -> alloc_page_write(base, bytes, record)
    alloc_unlock(lock)
    ok
}

// Maps the root table, and each span table that [base, base + bytes)
// touches, that is not mapped yet; false when one cannot be mapped. The
// caller holds the page lock.
priv alloc_page_spans: fn(base: I64, bytes: I64) -> Bool {
    #Unsafe("the caller holds the page lock, which serializes every table write; a fresh table is zero-filled before the aligned store that publishes it") {
        root := os_load_i64(wrapping(alloc_root + ALLOC_PAGE_MAP))
        if (root == I64{0}) {
            root = alloc_map_try(ALLOC_PAGE_ROOT_BYTES)
            if (root == I64{0}) { return false }
            os_store_i64(wrapping(alloc_root + ALLOC_PAGE_MAP), root)
        }
        end: wrapping(base + bytes)
        at := base
        loop at < end {
            cell: wrapping(root + wrapping((at >> I64{32}) * I64{8}))
            if (os_load_i64(cell) == I64{0}) {
                span: alloc_map_try(ALLOC_PAGE_SPAN_BYTES)
                if (span == I64{0}) { return false }
                os_store_i64(cell, span)
            }
            at = wrapping((at >> I64{32}) + I64{1}) << I64{32}
        }
    }
    true
}

// Points every unit of [base, base + bytes) at `record`. The range's span
// tables exist, and its owner alone writes its units.
priv alloc_page_write: fn(base: I64, bytes: I64, record: I64) {
    #Unsafe("the root and span tables of the range are mapped for the process's lifetime, and each unit's aligned word is written only by the range's owner") {
        root: os_load_i64(wrapping(alloc_root + ALLOC_PAGE_MAP))
        end: wrapping(base + bytes)
        at := base
        loop at < end {
            span: os_load_i64(wrapping(root + wrapping((at >> I64{32}) * I64{8})))
            os_store_i64(wrapping(span + wrapping(((at >> I64{16}) & I64{65535}) * I64{8})), record)
            at = wrapping(at + ALLOC_PAGE_UNIT)
        }
    }
}

// The region window: every region of at most 2^(ALLOC_WINDOW_CLASSES - 1)
// page-map units (core.mem.Region.reserve, an arena's reservation) takes its
// units from one reservation of ALLOC_WINDOW_UNITS units at a unit boundary,
// so a region maps no alignment slack and unmaps none. The window is mapped
// without access and NORESERVE: it costs address space only. A run of 2^c
// units serves any region of up to that many units. A fresh run is mapped
// writable when a region first takes it (one mmap over the run); when a
// region ends, its pages are dropped (one madvise, which takes the kernel's
// mapping lock only to read) and its run goes on class c's stack, writable
// and zero, for the next region of class c to take with no system call. A
// region's use after its end is the language's fault (core.mem's mapping
// account), not the hardware's.
// State word 776 (ALLOC_WINDOW) names the window's base, 0 until the first
// region. Word 784 (ALLOC_WINDOW_NEXT) counts the units handed out past the
// window's first ALLOC_WINDOW_LINK_UNITS, which are writable from the start:
// one link word per unit, then from ALLOC_WINDOW_RECORDS one region record
// slot per unit, where the region whose run starts at that unit keeps its
// record (alloc_reservation_record), so a window region takes no heap block.
// Class c's stack is word 800 + 8c:
// [tag << 20 | the top run's first unit], where unit 0 (a link unit) means
// empty, and each run's link word names the run below it. Every push and pop
// moves the tag, so a compare-exchange never installs a link that a racing
// pop and push made stale; no lock is taken. The page map's span tables over
// the whole window are mapped before its base is published, so a run
// registers its units with no lock either (alloc_page_set). A larger region,
// and any region once the window is refused or spent, maps on its own
// (alloc_reservation_direct).
// Each attached TCB also keeps a stack per class at ALLOC_WINDOW_ROWS
// (Thread.jet): [count << 20 | the top run's first unit], linked through the
// same link words. A region ends onto its thread's own stack, and the next
// region of that class on that thread takes it back, with plain loads and
// stores: only the thread running on a TCB touches its rows and the links of
// the runs on them. A thread keeps at most ALLOC_WINDOW_ROW_LIMIT runs a
// class; the next goes on the shared stack, as every run does from a thread
// without a TCB. A fiber takes its carrier's rows while it runs
// (alloc_cache_lend, alloc_cache_reclaim), and thread exit puts its runs on
// the shared stacks (alloc_window_rows_flush).
ALLOC_WINDOW: I64{776}

ALLOC_WINDOW_NEXT: I64{784}

ALLOC_WINDOW_STACKS: I64{800}

ALLOC_WINDOW_CLASSES: I64{13}

ALLOC_WINDOW_UNITS: I64{262144}

ALLOC_WINDOW_BYTES: I64{17179869184}

ALLOC_WINDOW_LINK_UNITS: I64{128}

ALLOC_WINDOW_RECORDS: I64{2097152}

ALLOC_REGION_RECORD_BYTES: I64{24}

ALLOC_WINDOW_INDEX: I64{1048575}

ALLOC_WINDOW_TAG: I64{1048576}

ALLOC_WINDOW_ROWS: I64{632}

ALLOC_WINDOW_ROW_LIMIT: I64{8}

// The window's base, mapped on the first call; 0 when the system refuses.
// The sentry is not told: a Region registers its pages at reserve, an arena
// each block it hands out.
alloc_window: fn() -> I64 {
    word: wrapping(alloc_root + ALLOC_WINDOW)
    kept: sync_load(word)
    if (kept != I64{0}) { return kept }
    bytes: wrapping(ALLOC_WINDOW_BYTES + ALLOC_PAGE_UNIT)
    #Unsafe("a fresh inaccessible NORESERVE mapping aliases nothing; its link and record units are remapped writable inside it and its span tables mapped before its base is published, and a caller that loses the publication unmaps only its own mapping") {
        mapping: os_map_untracked_i64(I64{0}, bytes, I64{0}, I64{16418}, I64{-1}, I64{0})
        if (mapping < I64{0}) { return I64{0} }
        base: alloc_align(mapping, ALLOC_PAGE_UNIT)
        links: os_map_untracked_i64(base, wrapping(ALLOC_WINDOW_LINK_UNITS * ALLOC_PAGE_UNIT), I64{3}, I64{16434}, I64{-1}, I64{0})
        lock: wrapping(alloc_root + ALLOC_PAGE_LOCK)
        alloc_lock(lock)
        spans: links == base && alloc_page_spans(base, ALLOC_WINDOW_BYTES)
        alloc_unlock(lock)
        won: if spans -> sync_cas(word, I64{0}, base) else -> I64{-1}
        if (won == I64{0}) { return base }
        _ := os_unmap_untracked_i64(mapping, bytes)
        return if (won == I64{-1}) -> I64{0} else -> won
    }
}

// Whether `address` lies in the region window.
alloc_window_holds: fn(address: I64) -> Bool {
    window: sync_load(wrapping(alloc_root + ALLOC_WINDOW))
    window != I64{0} && address >= window && address < wrapping(window + ALLOC_WINDOW_BYTES)
}

// The window class of a region of `bytes` (whole units): the least c with
// 2^c units >= bytes.
alloc_window_class: fn(bytes: I64) -> I64 Never! {
    class := I64{0}
    loop bytes > (ALLOC_PAGE_UNIT << class) -> class = wrapping(class + I64{1})
    class
}

// The stack word of window class `class`.
alloc_window_stack: fn(class: I64) -> I64 Never! {
    wrapping(alloc_root + wrapping(ALLOC_WINDOW_STACKS + wrapping(class * I64{8})))
}

// `bytes` (whole units) of the window, writable and zero, or 0: the region
// is larger than the largest class, the window is refused or spent, or the
// system refuses a fresh run's pages.
priv alloc_window_take: fn(bytes: I64) -> I64 {
    class: alloc_window_class(bytes)
    if (class >= ALLOC_WINDOW_CLASSES) { return I64{0} }
    window: alloc_window()
    if (window == I64{0}) { return I64{0} }
    row: alloc_window_row(class)
    if (row != I64{0}) {
        #Unsafe("row is the running TCB's own run stack of this class, and the link word of a run on it is this thread's alone") {
            kept: os_load_i64(row)
            own: kept & ALLOC_WINDOW_INDEX
            if (own != I64{0}) {
                os_store_i64(row, wrapping(wrapping(wrapping(kept - own) - ALLOC_WINDOW_TAG) + os_load_i64(wrapping(window + wrapping(own * I64{8})))))
                return wrapping(window + wrapping(own * ALLOC_PAGE_UNIT))
            }
        }
    }
    stack: alloc_window_stack(class)
    unit := I64{0}
    top := sync_load(stack)
    loop top & ALLOC_WINDOW_INDEX != (I64{0}) {
        candidate: top & ALLOC_WINDOW_INDEX
        below: sync_load(wrapping(window + wrapping(candidate * I64{8})))
        seen: sync_cas(stack, top, wrapping(wrapping(wrapping(top - candidate) + ALLOC_WINDOW_TAG) + below))
        if (seen == top) {
            unit = candidate
            break
        }
        top = seen
    }
    if (unit != I64{0}) { return wrapping(window + wrapping(unit * ALLOC_PAGE_UNIT)) }
    size: I64{1} << class
    next: wrapping(alloc_root + ALLOC_WINDOW_NEXT)
    at := sync_load(next)
    loop unit == (I64{0}) {
        if (at > wrapping(wrapping(ALLOC_WINDOW_UNITS - ALLOC_WINDOW_LINK_UNITS) - size)) {
            return I64{0}
        }
        claimed: sync_cas(next, at, wrapping(at + size))
        if {
            claimed == at -> unit = wrapping(ALLOC_WINDOW_LINK_UNITS + at)
            else -> at = claimed
        }
    }
    address: wrapping(window + wrapping(unit * ALLOC_PAGE_UNIT))
    // A run the system will not map stays inaccessible and out of the stacks.
    #Unsafe("the fresh run is this caller's alone, inside the window and inaccessible; the fixed mapping replaces only its own units") {
        if (os_map_untracked_i64(address, wrapping(size * ALLOC_PAGE_UNIT), I64{3}, I64{50}, I64{-1}, I64{0}) == address) {
            return address
        }
    }
    I64{0}
}

// Puts the run at window unit `unit` on class `class`'s stack.
alloc_window_push: fn(window: I64, unit: I64, class: I64) {
    stack: alloc_window_stack(class)
    link: wrapping(window + wrapping(unit * I64{8}))
    top := sync_load(stack)
    loop {
        sync_store(link, top & ALLOC_WINDOW_INDEX)
        seen: sync_cas(stack, top, wrapping(wrapping(wrapping(top - (top & ALLOC_WINDOW_INDEX)) + ALLOC_WINDOW_TAG) + unit))
        if (seen == top) {
            return
        }
        top = seen
    }
}

// The calling thread's own run stack word of window class `class`, or 0
// without a TCB.
alloc_window_row: fn(class: I64) -> I64 {
    base: thread_base()
    if (base == I64{0}) { return I64{0} }
    wrapping(base + wrapping(ALLOC_WINDOW_ROWS + wrapping(class * I64{8})))
}

// Keeps the run at window unit `unit` on the calling thread's own stack of
// class `class`; false when the thread has no TCB or already keeps
// ALLOC_WINDOW_ROW_LIMIT runs of that class.
priv alloc_window_keep: fn(window: I64, unit: I64, class: I64) -> Bool {
    row: alloc_window_row(class)
    if (row == I64{0}) { return false }
    #Unsafe("row is the running TCB's own run stack of this class, and the ended run's link word is no other thread's") {
        kept: os_load_i64(row)
        if (kept >= wrapping(ALLOC_WINDOW_ROW_LIMIT * ALLOC_WINDOW_TAG)) { return false }
        os_store_i64(wrapping(window + wrapping(unit * I64{8})), kept & ALLOC_WINDOW_INDEX)
        os_store_i64(row, wrapping(wrapping(wrapping(kept - (kept & ALLOC_WINDOW_INDEX)) + ALLOC_WINDOW_TAG) + unit))
    }
    true
}

// Puts every run of the run stack word `kept` of class `class` on the
// shared stack.
alloc_window_shelve: fn(kept: I64, class: I64) {
    window: sync_load(wrapping(alloc_root + ALLOC_WINDOW))
    unit := kept & ALLOC_WINDOW_INDEX
    loop unit != (I64{0}) {
        below: sync_load(wrapping(window + wrapping(unit * I64{8})))
        alloc_window_push(window, unit, class)
        unit = below
    }
}

// Moves the run stacks of TCB `from` to TCB `to`, emptying `from`; a class
// `to` already keeps runs of goes on the shared stack instead.
alloc_window_rows_move: fn(from: I64, to: I64) {
    class := I64{0}
    loop class < ALLOC_WINDOW_CLASSES {
        at: wrapping(ALLOC_WINDOW_ROWS + wrapping(class * I64{8}))
        kept: sync_load(wrapping(from + at))
        if (kept != I64{0}) {
            if {
                sync_load(wrapping(to + at)) == (I64{0}) -> sync_store(wrapping(to + at), kept)
                else -> alloc_window_shelve(kept, class)
            }
            sync_store(wrapping(from + at), I64{0})
        }
        class += I64{1}
    }
}

// Puts every run the calling thread keeps on the shared stacks: thread
// exit, before its TCB goes away. A thread without a TCB keeps none.
alloc_window_rows_flush: fn() {
    class := I64{0}
    loop class < ALLOC_WINDOW_CLASSES {
        row: alloc_window_row(class)
        if (row == I64{0}) {
            return
        }
        kept: sync_load(row)
        if (kept != I64{0}) {
            alloc_window_shelve(kept, class)
            sync_store(row, I64{0})
        }
        class += I64{1}
    }
}

// `bytes` (whole units) mapped on their own at a unit boundary: the slack
// mapped for the alignment is unmapped again, `head` bytes before the base
// and the rest after its units. 0 when the system refuses. Untracked, as the
// window is.
alloc_reservation_direct: fn(bytes: I64) -> I64 {
    mapping: alloc_map_try(wrapping(bytes + ALLOC_PAGE_UNIT))
    if (mapping == I64{0}) { return I64{0} }
    base: alloc_align(mapping, ALLOC_PAGE_UNIT)
    head: wrapping(base - mapping)
    if (head != I64{0}) { alloc_unmap(mapping, head) }
    alloc_unmap(wrapping(base + bytes), wrapping(ALLOC_PAGE_UNIT - head))
    base
}

// Ends the `bytes` (whole units) of a region at `base`: a window run's pages
// are dropped and the run goes on its thread's own stack of its class, or
// the shared one; a region mapped on its own is unmapped. A run whose pages
// the system would not drop stays out of the stacks.
alloc_reservation_unmap: fn(base: I64, bytes: I64) {
    if !alloc_window_holds(base) {
        alloc_unmap(base, bytes)
        return
    }
    window: sync_load(wrapping(alloc_root + ALLOC_WINDOW))
    #Unsafe("the region has ended, so nothing reads or writes its pages; MADV_DONTNEED drops only its own units inside the window, which read as zero again") {
        if (os_syscall_i64(I64{28}, base, bytes, I64{4}, I64{0}, I64{0}, I64{0}) != I64{0}) {
            return
        }
    }
    unit: wrapping(base - window) >> I64{16}
    class: alloc_window_class(bytes)
    if !alloc_window_keep(window, unit, class) -> alloc_window_push(window, unit, class)
}

// The `core.mem.__region_reserve` route behind core.mem.Region.reserve:
// `bytes` of fresh private pages, which the kernel commits on first touch,
// registered in the page map, or 0 when the size is not positive or the
// system refuses. The heap never sees these pages.
#Export(c) jet_rt_mem_region_reserve: fn(bytes: I64) -> I64 {
    record: alloc_reservation_map(bytes, ALLOC_REGION_RECORD_BYTES)
    if (record == I64{0}) -> I64{0} else -> sync_load(record)
}

// Maps `bytes` of fresh private pages at a page-map unit (from the region
// window, else on their own) and registers them under a new record of
// `record_bytes` ([base 0][units 8], then zero words: a region record's
// carrier at 16, an arena record's words); answers the record, or 0 when the
// size is not positive or the system refuses.
alloc_reservation_map: fn(bytes: I64, record_bytes: I64) -> I64 {
    if (bytes <= I64{0} || bytes > wrapping(ALLOC_PAGE_LIMIT - ALLOC_PAGE_UNIT)) { return I64{0} }
    units: alloc_page_bytes(bytes)
    base := alloc_window_take(units)
    if (base == I64{0}) { base = alloc_reservation_direct(units) }
    if (base == I64{0}) { return I64{0} }
    record: alloc_reservation_record(base, record_bytes)
    if (record != I64{0}) {
        sync_store(record, base)
        sync_store(wrapping(record + I64{8}), units)
        at := I64{16}
        loop at < record_bytes {
            sync_store(wrapping(record + at), I64{0})
            at += I64{8}
        }
        if alloc_page_set(base, units, record) -> return record
        alloc_reservation_record_free(record, record_bytes)
    }
    alloc_reservation_unmap(base, units)
    I64{0}
}

// A record of `record_bytes` for the reservation at `base`: a region whose
// run is in the window keeps it in the run's record slot, which no other
// live region shares; any other reservation takes a heap block. 0 when the
// heap refuses.
alloc_reservation_record: fn(base: I64, record_bytes: I64) -> I64 {
    if (record_bytes != ALLOC_REGION_RECORD_BYTES || !alloc_window_holds(base)) {
        return alloc_try_validated(record_bytes, I64{8})
    }
    window: sync_load(wrapping(alloc_root + ALLOC_WINDOW))
    wrapping(wrapping(window + ALLOC_WINDOW_RECORDS) + wrapping((wrapping(base - window) >> I64{16}) * ALLOC_REGION_RECORD_BYTES))
}

// Gives back `record` of `record_bytes` (alloc_reservation_record): a heap
// block is freed; a window record slot needs nothing, as the next region of
// its run overwrites every word.
alloc_reservation_record_free: fn(record: I64, record_bytes: I64) {
    window: sync_load(wrapping(alloc_root + ALLOC_WINDOW))
    if (window != I64{0} && record >= wrapping(window + ALLOC_WINDOW_RECORDS) && record < wrapping(window + wrapping(ALLOC_WINDOW_LINK_UNITS * ALLOC_PAGE_UNIT))) {
        return
    }
    alloc_free_validated(record, record_bytes, I64{8})
}

// The `core.mem.__region_release` route behind Region's close: removes the
// region from the page map, drops its record's carrier and unmaps the pages
// that jet_rt_mem_region_reserve returned.
#Export(c) jet_rt_mem_region_release: fn(address: I64, bytes: I64) {
    if (address == I64{0} || bytes <= I64{0}) {
        return
    }
    record: alloc_page_region(address)
    units: if (record != I64{0}) -> sync_load(wrapping(record + I64{8})) else -> alloc_page_bytes(bytes)
    if (record != I64{0}) {
        _ := alloc_page_set(address, units, I64{0})
        alloc_user_drop(sync_load(wrapping(record + I64{16})))
        alloc_reservation_record_free(record, ALLOC_REGION_RECORD_BYTES)
    }
    alloc_reservation_unmap(address, units)
}

// runtime-init: 0
#Export(c) jet_rt_alloc_init: fn() {
    if (alloc_root != I64{0}) {
        return
    }
    // mmap is zero-filled: the locks, every free-list head, every live total
    // and the large cache start at zero. One mapping holds the state page and,
    // in the two pages after it, the 32 arenas (32 * 216 bytes).
    #Unsafe("runtime-init runs before any other thread exists") {
        alloc_root = alloc_map(I64{12288}, I64{12288})
    }
    #Unsafe("the fresh state page is private to initialization, which precedes every allocation") {
        os_store_i64(wrapping(alloc_root + I64{208}), wrapping(alloc_root + I64{4096}))
    }
    // The initializing thread has no TCB yet; point its GS at the zero word
    // so thread_base() reads 0 instead of faulting on the kernel's GS base 0.
    thread_set_base(thread_detached_base())
}

// Installs the checked heap in a program built with `--checked-alloc` and
// turns checked mode on. It shares jet_rt_alloc_init's priority, so it runs
// before any hook or code that allocates, in either order with it: it
// initializes the state page first (jet_rt_alloc_init is idempotent), which
// alloc_check_start uses. A system linker keeps every hook, so a C host that
// links the runtime object itself runs checked.
// runtime-init: 0 when alloc_check_linked
#Export(c) jet_rt_alloc_check_init: fn() {
    #Unsafe("runtime-init runs before any other thread exists") {
        alloc_check_take_code = rt_alloc_check_take_address()
        alloc_check_give_code = rt_alloc_check_give_address()
        alloc_check_sweep_code = rt_alloc_check_sweep_address()
        alloc_check_linked = I64{1}
    }
    jet_rt_alloc_init()
    alloc_check_start()
}

// A checked build's entry calls this first (JetIR ir_checked_alloc_link):
// the call is the link's reason to keep the checked heap. 1 once installed.
#Export(c) jet_rt_alloc_check_link: fn() -> I64 { alloc_check_linked }

// Native-approved RuntimeLibrary FunctionAddress intrinsics (arity 2, 3, 1).
rt_alloc_check_take_address: fn() -> I64 {
    loop { jet_rt_unreachable(I64{0}, I64{0}) }
}

rt_alloc_check_give_address: fn() -> I64 {
    loop { jet_rt_unreachable(I64{0}, I64{0}) }
}

rt_alloc_check_sweep_address: fn() -> I64 {
    loop { jet_rt_unreachable(I64{0}, I64{0}) }
}

// The arena roots: rows of the table.
alloc_arena_root: fn(index: I64) -> I64 {
    #Unsafe("initialization wrote the arena table word once, before any allocation") {
        return wrapping(os_load_i64(wrapping(alloc_root + I64{208})) + wrapping(index * I64{216}))
    }
}

// The calling thread's arena. Thread and fiber stacks are disjoint mappings
// of at least 8 MiB (Thread.jet thread_stack_bytes, THREAD_STACK_DEFAULT; a
// stack cut under a finite RLIMIT_AS may be smaller), so tasks running at the
// same time sit in different 8 MiB stack bands; the band's hash picks one of
// the 32 arenas. A deeper stack spans several bands, and its thread moves
// between their arenas as it recurses. Any arena is correct for any thread:
// the choice only spreads lock traffic, and a block always returns to the
// arena of its slab.
alloc_arena: fn() -> I64 {
    band := I64{0}
    #Unsafe("reads the stack pointer register only; nothing is dereferenced") {
        band = os_stack_address_i64() >> I64{23}
    }
    alloc_arena_root((wrapping(band * I64{-7046029254386353131}) >> I64{59}) & I64{31})
}

// Live payloads of class `width`: every block handed out of a slab across
// all arenas minus the blocks parked in attached threads' caches. Isolated
// fixtures use it as their leak witness; the caller is quiescent (no thread
// is allocating, freeing or exiting while it reads).
priv alloc_live_blocks: fn(width: I64) -> I64 {
    total := I64{0}
    index := I64{0}
    loop index < (I64{32}) {
        #Unsafe("the live totals are process-lifetime arena words; the quiescent caller needs no lock to read them") {
            total = wrapping(total + os_load_i64(wrapping(alloc_head(alloc_arena_root(index), width) + I64{128})))
        }
        index = wrapping(index + I64{1})
    }
    if (thread_tls_registry == I64{0}) { return total }
    count_offset: wrapping(I64{312} + wrapping(alloc_head(I64{0}, width) * I64{2}))
    sync_mutex_lock(thread_tls_registry)
    live: wrapping(thread_tls_registry + I64{64})
    count: sync_load(live)
    data: sync_load(wrapping(live + I64{16}))
    at := I64{0}
    loop at < count {
        // A blocked TCB (alloc_cache_sync) caches nothing.
        cached: sync_load(wrapping(sync_load(wrapping(data + (at + I64{1}) * I64{8})) + count_offset))
        if (cached != ALLOC_CACHE_BLOCKED) { total = wrapping(total - cached) }
        at += I64{2}
    }
    sync_mutex_unlock(thread_tls_registry)
    total
}

// Every allocator lock is one futex word: 0 free, 1 held, 2 held with
// sleepers. An acquirer spins briefly (test before each CAS, so waiters read
// a shared cache line), then sleeps in FUTEX_WAIT_PRIVATE instead of burning
// its core: when compiler threads outnumber the CPUs, a preempted holder no
// longer stalls every spinner for a whole time slice. No TCB, allocation or
// Sync state is involved, so the lock works before any thread is attached.
priv alloc_lock: fn(root: I64) {
    #Unsafe("root is an aligned lock word in the process-lifetime state mapping; CAS/xchg acquire all metadata it protects and the futex wait only reads that word") {
        if (os_cas_i64(root, I64{0}, I64{1}) == I64{0}) {
            return
        }
        spins := I64{0}
        loop spins < (I64{128}) {
            os_spin_pause()
            if (os_load_i64(root) == I64{0} && os_cas_i64(root, I64{0}, I64{1}) == I64{0}) {
                return
            }
            spins = wrapping(spins + I64{1})
        }
        loop os_swap_i64(root, I64{2}) != (I64{0}) {
            _ := host_syscall(I64{202}, root, I64{128}, I64{2}, I64{0}, I64{0}, I64{0})
        }
    }
}

alloc_unlock: fn(root: I64) {
    #Unsafe("the calling thread holds this lock; xchg publishes its completed metadata updates and reports sleepers, and the futex wake only names the word") {
        if (os_swap_i64(root, I64{0}) == I64{2}) {
            _ := host_syscall(I64{202}, root, I64{129}, I64{1}, I64{0}, I64{0}, I64{0})
        }
    }
}

// A fork's hold on the heap (RouteSys.jet jet_sys_fork_raw): every
// allocator lock, taken in the order the allocator nests them (the
// quarantine before the large cache and an arena, an arena before the slab
// regions; the policy lock nests nothing), so the child's copy of the heap
// is consistent and none of its locks belongs to a thread the child lacks.
alloc_fork_hold: fn() {
    alloc_lock(wrapping(alloc_root + I64{136}))
    alloc_lock(wrapping(alloc_root + I64{16}))
    alloc_lock(wrapping(alloc_root + I64{216}))
    index := I64{0}
    loop index < (I64{32}) {
        alloc_lock(alloc_arena_root(index))
        index = wrapping(index + I64{1})
    }
    alloc_lock(wrapping(alloc_root + I64{736}))
}

// Both sides of the fork release what alloc_fork_hold took: in the child,
// whose only thread is the forking one, that leaves every lock in its
// initial state (a waiter's wake finds no thread there).
alloc_fork_release: fn() {
    alloc_unlock(wrapping(alloc_root + I64{736}))
    index := I64{32}
    loop index > (I64{0}) {
        index = wrapping(index - I64{1})
        alloc_unlock(alloc_arena_root(index))
    }
    alloc_unlock(wrapping(alloc_root + I64{216}))
    alloc_unlock(wrapping(alloc_root + I64{16}))
    alloc_unlock(wrapping(alloc_root + I64{136}))
}

// Remove a slab from its class's available list. Caller holds the heap lock.
priv alloc_unlink: fn(slab: I64) {
    #Unsafe("slab and its linked neighbors are live heap-owned headers protected by the held heap lock") {
        next_slab: os_load_i64(slab)
        previous: os_load_i64(wrapping(slab + I64{8}))
        if {
            previous == (I64{0}) -> {
                head: os_load_i64(wrapping(slab + I64{32}))
                os_store_i64(head, next_slab)
            }
            else -> os_store_i64(previous, next_slab)
        }
        if (next_slab != I64{0}) { os_store_i64(wrapping(next_slab + I64{8}), previous) }
        os_store_i64(slab, I64{0})
        os_store_i64(wrapping(slab + I64{8}), I64{0})
    }
}

// Prepend a slab whose free list was empty. Caller holds the heap lock.
priv alloc_link: fn(slab: I64, head: I64) {
    #Unsafe("head and slab are live heap-owned metadata protected by the held heap lock") {
        first: os_load_i64(head)
        os_store_i64(slab, first)
        os_store_i64(wrapping(slab + I64{8}), I64{0})
        if (first != I64{0}) { os_store_i64(wrapping(first + I64{8}), slab) }
        os_store_i64(head, slab)
    }
}

// Slabs come from slab regions, not one mapping each: a region is mapped
// once and carved 64 KiB at a time, so a program touches only the pages its
// blocks use. The first region is ALLOC_REGION_FIRST and each next one twice
// the last, up to ALLOC_REGION, so a growing heap makes one mmap per 512 slabs
// while a small program reserves only 1 MiB of address space: a child under a
// tight address-space limit (Process memory_limit is RLIMIT_AS) starts and
// grows toward it. A region that cannot be mapped is retried at half the
// size, down to one slab. A slab that is no longer needed (more empty slabs than
// ALLOC_RETAINED_EMPTY_SLABS) goes on the process's free-slab stack and serves
// the next new slab of any class and arena. Its pages are never returned, so
// they never fault again.
// State page words: lock 736, region cursor 744, region end 752, free-slab
// stack 760 (a stacked slab's first word links the next), next region size
// 768 (zero before the first region).
ALLOC_SLAB_BYTES: I64{65536}

ALLOC_REGION_FIRST: I64{1048576}

ALLOC_REGION: I64{33554432}

// A slab's 64 KiB: a stacked slab, else the next of the current region,
// mapping a new region when it is used up. Zero when no region can be
// mapped. A stacked slab's bytes are stale: alloc_new_slab rewrites its header.
alloc_slab_map: fn() -> I64 {
    lock: wrapping(alloc_root + I64{736})
    slab := I64{0}
    alloc_lock(lock)
    #Unsafe("the slab-region lock owns the cursor, end and free-slab stack words and every stacked slab's link word") {
        stack: wrapping(alloc_root + I64{760})
        slab = os_load_i64(stack)
        if (slab != I64{0}) { os_store_i64(stack, os_load_i64(slab)) } else {
            cursor: wrapping(alloc_root + I64{744})
            end: wrapping(alloc_root + I64{752})
            if (os_load_i64(cursor) == os_load_i64(end)) {
                next: wrapping(alloc_root + I64{768})
                size := os_load_i64(next)
                if (size == I64{0}) { size = ALLOC_REGION_FIRST }
                region := I64{0}
                loop region == (I64{0}) && size >= ALLOC_SLAB_BYTES {
                    region = alloc_region_map(size)
                    if (region == I64{0}) { size = size >> I64{1} }
                }
                if (region != I64{0}) {
                    os_store_i64(cursor, region)
                    os_store_i64(end, wrapping(region + size))
                    os_store_i64(next, if (size < ALLOC_REGION) -> size << I64{1} else -> size)
                }
            }
            at: os_load_i64(cursor)
            if (at != os_load_i64(end)) {
                slab = at
                os_store_i64(cursor, wrapping(at + ALLOC_SLAB_BYTES))
            }
        }
    }
    alloc_unlock(lock)
    slab
}

// Puts a slab no class holds on the free-slab stack, mapped.
priv alloc_slab_retire: fn(slab: I64) {
    lock: wrapping(alloc_root + I64{736})
    alloc_lock(lock)
    #Unsafe("the slab-region lock owns the free-slab stack; the slab is unlinked from every class list and holds no live or cached block") {
        stack: wrapping(alloc_root + I64{760})
        os_store_i64(slab, os_load_i64(stack))
        os_store_i64(stack, slab)
    }
    alloc_unlock(lock)
}

// A new slab region of `bytes`, or zero. It keeps 4 KiB pages
// (MADV_NOHUGEPAGE): where the system makes huge pages unasked, a first touch
// would zero 2 MiB, and an advised huge region compacts memory synchronously
// on fault, which stalls every thread allocating under a loaded host. A
// refused advice only costs page size.
alloc_region_map: fn(bytes: I64) -> I64 {
    region: alloc_map_try(bytes)
    if (region == I64{0}) { return I64{0} }
    #Unsafe("madvise only changes the page size of the fresh private region") {
        _ := os_syscall_i64(I64{28}, region, bytes, I64{15}, I64{0}, I64{0}, I64{0})
    }
    region
}

// A slab for class `slot` of arena `root`, linked on the class list `head`.
// Its header: [next 0][prev 8][free 16][live 24][head 32][arena 40][carve 48].
alloc_new_slab: fn(root: I64, head: I64, slot: I64) -> I64 {
    slab: alloc_slab_map()
    if (slab == I64{0}) { return I64{0} }
    first: wrapping(slab + (if (slot > I64{64}) -> slot else -> I64{64}))
    #Unsafe("the slab is this arena's alone: fresh from its region or off the free-slab stack; the held arena lock excludes all list readers") {
        os_store_i64(slab, I64{0})
        os_store_i64(wrapping(slab + I64{8}), I64{0})
        os_store_i64(wrapping(slab + I64{16}), I64{0})
        os_store_i64(wrapping(slab + I64{24}), I64{0})
        os_store_i64(wrapping(slab + I64{32}), head)
        os_store_i64(wrapping(slab + I64{40}), root)
        os_store_i64(wrapping(slab + I64{48}), if (wrapping(first + slot) <= wrapping(slab + ALLOC_SLAB_BYTES)) -> first else -> I64{0})
    }
    alloc_link(slab, head)
    slab
}

// Empty slabs a class keeps linked per arena, so a burst of temporaries
// (a thread's cache drains 32 blocks at a time) does not give up a slab it
// takes again moments later: at most 8 x 64 KiB per class and arena. Any
// further empty slab goes on the free-slab stack (alloc_slab_retire).
ALLOC_RETAINED_EMPTY_SLABS: I64{8}

// Take up to `limit` free blocks of the class's head slab under the held
// arena lock and thread them, as [next][slab], onto the cache row `row`
// ([head][count]); returns how many were taken: zero only when no slab can
// be mapped. The blocks count as live in the slab; the arena's live total
// grows with them; a retained-empty slab leaves the class's retained count
// (a fresh slab was never counted); an emptied slab is unlinked.
priv alloc_slab_take: fn(root: I64, head: I64, slot: I64, row: I64, limit: I64) -> I64 {
    #Unsafe("the held arena lock protects the class list, the slab's free links, carve word and live count, the retained count and the arena live total; row is the caller's exclusive cache row; the blocks leave the slab before any caller sees them") {
        slab := os_load_i64(head)
        fresh := false
        if (slab == I64{0}) {
            slab = alloc_new_slab(root, head, slot)
            fresh = true
        }
        if (slab == I64{0}) { return I64{0} }
        free := os_load_i64(wrapping(slab + I64{16}))
        carve := os_load_i64(wrapping(slab + I64{48}))
        end: wrapping(slab + I64{65536})
        list := os_load_i64(row)
        taken := I64{0}
        loop taken < limit {
            block := free
            if (block != I64{0}) { free = os_load_i64(block) } else {
                if (carve == I64{0}) { break }
                block = carve
                carve = wrapping(carve + slot)
                if (wrapping(carve + slot) > end) { carve = I64{0} }
            }
            os_store_i64(block, list)
            os_store_i64(wrapping(block + I64{8}), slab)
            list = block
            taken = wrapping(taken + I64{1})
        }
        os_store_i64(row, list)
        os_store_i64(wrapping(row + I64{8}), wrapping(os_load_i64(wrapping(row + I64{8})) + taken))
        os_store_i64(wrapping(slab + I64{16}), free)
        os_store_i64(wrapping(slab + I64{48}), carve)
        live: os_load_i64(wrapping(slab + I64{24}))
        if (live == I64{0} && !fresh) {
            retained: wrapping(head + I64{64})
            os_store_i64(retained, wrapping(os_load_i64(retained) - I64{1}))
        }
        os_store_i64(wrapping(slab + I64{24}), wrapping(live + taken))
        total: wrapping(head + I64{128})
        os_store_i64(total, wrapping(os_load_i64(total) + taken))
        if (free == I64{0} && carve == I64{0}) { alloc_unlink(slab) }
        return taken
    }
}

// Return one block to its slab. Caller holds the slab's arena lock. The slab
// is linked again when it had no block left to give (an empty free list and
// nothing left to carve); a slab whose last block
// returns stays linked as one of the class's retained empty slabs
// (ALLOC_RETAINED_EMPTY_SLABS) or goes on the free-slab stack.
priv alloc_slab_return: fn(slab: I64, block: I64) {
    #Unsafe("the held arena lock protects the slab's free links, carve word, live count, class list, retained count and live total; the block is no longer any payload or cache entry") {
        free: os_load_i64(wrapping(slab + I64{16}))
        live: wrapping(os_load_i64(wrapping(slab + I64{24})) - I64{1})
        os_store_i64(block, free)
        os_store_i64(wrapping(slab + I64{16}), block)
        os_store_i64(wrapping(slab + I64{24}), live)
        head: os_load_i64(wrapping(slab + I64{32}))
        total: wrapping(head + I64{128})
        os_store_i64(total, wrapping(os_load_i64(total) - I64{1}))
        if (free == I64{0} && os_load_i64(wrapping(slab + I64{48})) == I64{0}) {
            alloc_link(slab, head)
        }
        if (live == I64{0}) {
            retained: wrapping(head + I64{64})
            count: os_load_i64(retained)
            if (count < ALLOC_RETAINED_EMPTY_SLABS) {
                os_store_i64(retained, wrapping(count + I64{1}))
            } else {
                alloc_unlink(slab)
                alloc_slab_retire(slab)
            }
        }
    }
}

// The locked allocation of a thread without a cache: one block, straight
// from the arena's head slab.
priv alloc_small: fn(root: I64, size: I64, align: I64, slot: I64) -> I64 {
    head: alloc_head(root, slot)
    // The arena's scratch row (root + 200) is exclusive under its lock.
    scratch: wrapping(root + I64{200})
    block := I64{0}
    alloc_lock(root)
    #Unsafe("the held arena lock makes the arena's scratch row exclusive; it is emptied again before the lock is released") {
        _ := alloc_slab_take(root, head, slot, scratch, I64{1})
        block = os_load_i64(scratch)
        os_store_i64(scratch, I64{0})
        os_store_i64(wrapping(scratch + I64{8}), I64{0})
    }
    alloc_unlock(root)
    if (block == I64{0}) { return I64{0} }
    pointer: alloc_align(wrapping(block + alloc_header(align)), align)
    #Unsafe("block is this caller's exclusive block; its two cached words are read before the payload header overwrites them") {
        slab: os_load_i64(wrapping(block + I64{8}))
        os_store_i64(wrapping(pointer - I64{16}), slab)
        os_store_i64(wrapping(pointer - I64{8}), block)
    }
    pointer
}

// The calling thread's cache row [head][count] for a class, or zero when the
// thread has no TCB (TCB @320 + 16 per class, Thread.jet) or its rows are
// blocked (alloc_cache_sync).
alloc_cache_row: fn(slot: I64) -> I64 {
    base: thread_base()
    if (base == I64{0}) { return I64{0} }
    row: wrapping(base + wrapping(I64{304} + wrapping(alloc_head(I64{0}, slot) * I64{2})))
    #Unsafe("row is this thread's private cache row") {
        if (os_load_i64(wrapping(row + I64{8})) == ALLOC_CACHE_BLOCKED) { return I64{0} }
    }
    row
}

// 1 once a thread refilled its cache. Its storage is a guard of the thread
// start (Thread.jet jet_rt_thread_init): a program that links the cached
// front doors (jet_rt_alloc, jet_rt_alloc_8) attaches its main thread, so
// its allocations take the cache as before; one that never allocates
// attaches none, and every allocation of an unattached thread takes the
// uncached path anyway (alloc_cache_row).
alloc_cache_linked := I64{0}

// Refill this thread's cache row with up to 32 blocks of one slab of the
// stack band's arena. False when no slab can be mapped or the row is blocked
// (alloc_cache_sync).
alloc_cache_refill: fn(row: I64, slot: I64) -> Bool {
    #Unsafe("row is this thread's private cache row; the flag is idempotent: every writer stores the same 1") {
        if (os_load_i64(wrapping(row + I64{8})) == ALLOC_CACHE_BLOCKED) { return false }
        alloc_cache_linked = I64{1}
    }
    root: alloc_arena()
    alloc_lock(root)
    taken: alloc_slab_take(root, alloc_head(root, slot), slot, row, I64{32})
    alloc_unlock(root)
    taken != I64{0}
}

// Hand out the cached head block of a row as a payload of `align`, writing
// the same [slab][block-start] header an uncached allocation writes.
priv alloc_cache_pop: fn(row: I64, block: I64, align: I64) -> I64 {
    pointer: alloc_align(wrapping(block + alloc_header(align)), align)
    #Unsafe("row is this thread's private cache row and block its cached head; both cached words are read before the payload header overwrites them") {
        os_store_i64(row, os_load_i64(block))
        os_store_i64(wrapping(row + I64{8}), wrapping(os_load_i64(wrapping(row + I64{8})) - I64{1}))
        slab: os_load_i64(wrapping(block + I64{8}))
        os_store_i64(wrapping(pointer - I64{16}), slab)
        os_store_i64(wrapping(pointer - I64{8}), block)
    }
    pointer
}

// Return the first `count` cached blocks of a row to their slabs, each under
// its own slab's arena lock; consecutive blocks of one arena share a hold.
priv alloc_cache_drain: fn(row: I64, count: I64) {
    held := I64{0}
    remaining := count
    #Unsafe("row is this thread's private cache row; each cached block's slab is live while the block is cached, so its arena word is readable, and the block returns under that arena's lock") {
        block := os_load_i64(row)
        loop remaining > (I64{0}) && block != (I64{0}) {
            next_block: os_load_i64(block)
            slab: os_load_i64(wrapping(block + I64{8}))
            root: os_load_i64(wrapping(slab + I64{40}))
            if (root != held) {
                if (held != I64{0}) { alloc_unlock(held) }
                alloc_lock(root)
                held = root
            }
            alloc_slab_return(slab, block)
            block = next_block
            remaining = wrapping(remaining - I64{1})
        }
        os_store_i64(row, block)
        os_store_i64(wrapping(row + I64{8}), wrapping(os_load_i64(wrapping(row + I64{8})) - wrapping(count - remaining)))
    }
    if (held != I64{0}) { alloc_unlock(held) }
}

// Return every cached block of the calling thread: thread exit, and the
// fixtures that inspect slab metadata. A thread without a TCB holds none.
alloc_cache_flush: fn() {
    base: thread_base()
    if (base == I64{0}) {
        return
    }
    row := wrapping(base + I64{320})
    index := I64{0}
    loop index < (I64{8}) {
        #Unsafe("row is one of this thread's eight private cache rows") {
            alloc_cache_drain(row, os_load_i64(wrapping(row + I64{8})))
        }
        row = wrapping(row + I64{16})
        index = wrapping(index + I64{1})
    }
}

// A blocked row's count: its head is 0, so the fast allocation finds no
// block, and the count is past 64, so the fast free finds it full.
ALLOC_CACHE_BLOCKED: I64{4611686018427387904}

// Whether the TCB `tcb`'s rows are blocked (its first row stands for all).
priv alloc_cache_blocked: fn(tcb: I64) -> Bool {
    #Unsafe("tcb is a live TCB whose eight cache rows start at @320") {
        return os_load_i64(wrapping(tcb + I64{328})) == ALLOC_CACHE_BLOCKED
    }
}

// Sets every cache row of `tcb` to `head` and `count`.
priv alloc_cache_set: fn(tcb: I64, head: I64, count: I64) {
    row := wrapping(tcb + I64{320})
    loop row < wrapping(tcb + I64{448}) {
        #Unsafe("row is one of the TCB's eight cache rows, which only the thread running on it touches") {
            os_store_i64(row, head)
            os_store_i64(wrapping(row + I64{8}), count)
        }
        row = wrapping(row + I64{16})
    }
}

// Keeps the rows of `tcb`, the running thread's or fiber's, blocked exactly
// while its context record names a `#Context(allocator:)` carrier (the user
// allocators below): blocking returns every cached block to its slab first,
// and unblocking leaves the rows empty. Called where the record or its
// allocator changes (Context.jet) and where a fiber switches in.
priv alloc_cache_sync: fn(tcb: I64) {
    if (tcb == I64{0} || tcb == thread_detached_base()) {
        return
    }
    record: sync_load(wrapping(tcb + CONTEXT_TCB_SLOT))
    wanted: record != I64{0} && sync_load(wrapping(record + CONTEXT_ALLOCATOR)) != I64{0}
    if (wanted == alloc_cache_blocked(tcb)) {
        return
    }
    if wanted {
        row := wrapping(tcb + I64{320})
        loop row < wrapping(tcb + I64{448}) {
            #Unsafe("row is one of the running TCB's eight private cache rows") {
                alloc_cache_drain(row, os_load_i64(wrapping(row + I64{8})))
            }
            row = wrapping(row + I64{16})
        }
        alloc_cache_set(tcb, I64{0}, ALLOC_CACHE_BLOCKED)
        return
    }
    alloc_cache_set(tcb, I64{0}, I64{0})
}

// A fiber switching in on the thread whose TCB is `tcb` (Fiber.jet
// fiber_run) takes the thread's cached blocks, as only the running TCB
// touches them, unless the thread's rows are blocked: those stay, and the
// fiber starts empty. Then the fiber's rows follow its own record. The
// thread's kept large mappings and window runs go to the fiber either way
// (they are no payload a user allocator could own).
alloc_cache_lend: fn(tcb: I64, fiber_tcb: I64) {
    alloc_large_rows_move(tcb, fiber_tcb)
    alloc_window_rows_move(tcb, fiber_tcb)
    if alloc_cache_blocked(tcb) -> alloc_cache_set(fiber_tcb, I64{0}, I64{0}) else {
        alloc_cache_move(tcb, fiber_tcb)
    }
    alloc_cache_sync(fiber_tcb)
}

// The fiber on `fiber_tcb` switched out to the thread on `tcb`: its cached
// blocks go back to the thread, or to their slabs when the thread's rows
// are blocked. A blocked fiber holds none, and the thread's rows are then as
// alloc_cache_lend left them. Its kept large mappings and window runs always
// go back, so a fiber that is not running holds none.
priv alloc_cache_reclaim: fn(fiber_tcb: I64, tcb: I64) {
    alloc_large_rows_move(fiber_tcb, tcb)
    alloc_window_rows_move(fiber_tcb, tcb)
    if alloc_cache_blocked(fiber_tcb) {
        return
    }
    if !alloc_cache_blocked(tcb) {
        alloc_cache_move(fiber_tcb, tcb)
        return
    }
    row := wrapping(fiber_tcb + I64{320})
    loop row < wrapping(fiber_tcb + I64{448}) {
        #Unsafe("row is one of the switched-out fiber's eight cache rows, which no thread runs on now") {
            alloc_cache_drain(row, os_load_i64(wrapping(row + I64{8})))
        }
        row = wrapping(row + I64{16})
    }
}

// Moves the cache rows from one TCB to another, emptying the source: a
// cached block is reachable from exactly one TCB.
alloc_cache_move: fn(from: I64, to: I64) {
    at := I64{320}
    loop at < (I64{448}) {
        sync_store(wrapping(to + at), sync_load(wrapping(from + at)))
        sync_store(wrapping(from + at), I64{0})
        at += I64{8}
    }
}

// Large size classes in pages: 2, 3, then four steps per doubling from 4
// (4, 5, 6, 7, 8, 10, 12, 14, 16, 20, ...) up to class 58, 65536 pages
// (256 MiB). A class is at most 25% above any need it serves.
alloc_large_class_pages: fn(class: I64) -> I64 Never! {
    if (class < I64{2}) { return wrapping(class + I64{2}) }
    step: wrapping(class - I64{2})
    pages := wrapping(I64{4} + (step & I64{3}))
    group := step /% I64{4}
    loop group > (I64{0}) {
        pages = wrapping(pages * I64{2})
        group = wrapping(group - I64{1})
    }
    pages
}

// The smallest large class holding `bytes` (page-rounded, above one page),
// or -1 above the largest class.
alloc_large_class: fn(bytes: I64) -> I64 Never! {
    pages: bytes /% I64{4096}
    if (pages > I64{65536}) { return I64{-1} }
    class := I64{0}
    loop alloc_large_class_pages(class) < pages -> class = wrapping(class + I64{1})
    class
}

// The bound on cached large mappings, shared and kept together (16 MiB):
// every cached byte is a resident page no payload holds, so it stays small.
ALLOC_LARGE_CACHE_BYTES: I64{16777216}

// Each attached TCB keeps up to ALLOC_LARGE_ROW_COUNT freed class-sized
// mappings of at most ALLOC_LARGE_ROW_LIMIT bytes in [mapping][bytes] rows
// at ALLOC_LARGE_ROWS (Thread.jet), an empty row's bytes zero. A thread
// takes and keeps them without the large-cache lock, so threads that free
// and reallocate lists of like sizes no longer queue on that one lock (or
// on munmap + mmap). A kept mapping counts in the cached bytes
// (alloc_root + 224) as a shared one does, so ALLOC_LARGE_CACHE_BYTES bounds
// both; that word is atomic because rows change it outside the lock. A
// mapping is reachable from exactly one TCB or one class list: a fiber takes
// its carrier's rows while it runs (alloc_cache_lend, alloc_cache_reclaim),
// and thread exit shelves them (alloc_large_rows_flush).
ALLOC_LARGE_ROWS: I64{504}

ALLOC_LARGE_ROW_COUNT: I64{8}

ALLOC_LARGE_ROW_LIMIT: I64{1048576}

// The calling thread's first kept-mapping row, or zero without a TCB.
alloc_large_rows: fn() -> I64 {
    base: thread_base()
    if (base == I64{0}) { return I64{0} }
    wrapping(base + ALLOC_LARGE_ROWS)
}

// Counts `bytes` more cached bytes; false, counting nothing, when that
// would pass ALLOC_LARGE_CACHE_BYTES.
alloc_large_count: fn(bytes: I64) -> Bool {
    total: wrapping(alloc_root + I64{224})
    held: sync_add(total, bytes)
    if (wrapping(held + bytes) <= ALLOC_LARGE_CACHE_BYTES) { return true }
    _ := sync_add(total, wrapping(I64{0} - bytes))
    false
}

// A mapping of exactly `bytes` the calling thread kept, out of its row and
// the cached count, or zero.
alloc_large_take: fn(bytes: I64) -> I64 {
    if (bytes > ALLOC_LARGE_ROW_LIMIT) { return I64{0} }
    rows: alloc_large_rows()
    if (rows == I64{0}) { return I64{0} }
    row := rows
    loop row < wrapping(rows + wrapping(ALLOC_LARGE_ROW_COUNT * I64{16})) {
        #Unsafe("row is one of the running TCB's kept-mapping rows, which only the thread running on it touches") {
            if (os_load_i64(wrapping(row + I64{8})) == bytes) {
                mapping: os_load_i64(row)
                os_store_i64(row, I64{0})
                os_store_i64(wrapping(row + I64{8}), I64{0})
                _ := sync_add(wrapping(alloc_root + I64{224}), wrapping(I64{0} - bytes))
                return mapping
            }
        }
        row = wrapping(row + I64{16})
    }
    I64{0}
}

// Keeps counted mapping `mapping` of `bytes` in a free row of the calling
// thread; false when it has none or the mapping is past the row limit.
alloc_large_keep: fn(mapping: I64, bytes: I64) -> Bool {
    if (bytes > ALLOC_LARGE_ROW_LIMIT) { return false }
    rows: alloc_large_rows()
    if (rows == I64{0}) { return false }
    row := rows
    loop row < wrapping(rows + wrapping(ALLOC_LARGE_ROW_COUNT * I64{16})) {
        #Unsafe("row is one of the running TCB's kept-mapping rows, which only the thread running on it touches") {
            if (os_load_i64(wrapping(row + I64{8})) == I64{0}) {
                os_store_i64(row, mapping)
                os_store_i64(wrapping(row + I64{8}), bytes)
                return true
            }
        }
        row = wrapping(row + I64{16})
    }
    false
}

// Links counted mapping `mapping` onto the list of its `class`.
priv alloc_large_shelve: fn(mapping: I64, class: I64) {
    lock: wrapping(alloc_root + I64{216})
    head: wrapping(alloc_root + wrapping(I64{256} + wrapping(class * I64{8})))
    alloc_lock(lock)
    #Unsafe("the large-cache lock owns every class list; the mapping's first word is no live payload once it is freed") {
        os_store_i64(mapping, os_load_i64(head))
        os_store_i64(head, mapping)
    }
    alloc_unlock(lock)
}

// Moves the kept-mapping rows of TCB `from` to TCB `to`, emptying `from`.
alloc_large_rows_move: fn(from: I64, to: I64) {
    at := ALLOC_LARGE_ROWS
    loop at < wrapping(ALLOC_LARGE_ROWS + wrapping(ALLOC_LARGE_ROW_COUNT * I64{16})) {
        bytes: sync_load(wrapping(from + wrapping(at + I64{8})))
        if (bytes != I64{0}) {
            alloc_large_row_put(wrapping(to + at), sync_load(wrapping(from + at)), bytes)
            sync_store(wrapping(from + at), I64{0})
            sync_store(wrapping(from + wrapping(at + I64{8})), I64{0})
        }
        at = wrapping(at + I64{16})
    }
}

// Puts counted mapping `mapping` of `bytes` in kept-mapping `row`; a row
// still holding one is no target, so the mapping is shelved instead.
alloc_large_row_put: fn(row: I64, mapping: I64, bytes: I64) {
    if (sync_load(wrapping(row + I64{8})) != I64{0}) {
        alloc_large_shelve(mapping, alloc_large_class(bytes))
        return
    }
    sync_store(row, mapping)
    sync_store(wrapping(row + I64{8}), bytes)
}

// Shelves every mapping the calling thread kept (still counted): thread
// exit, before its TCB goes away. A thread without a TCB keeps none.
alloc_large_rows_flush: fn() {
    rows: alloc_large_rows()
    if (rows == I64{0}) {
        return
    }
    row := rows
    loop row < wrapping(rows + wrapping(ALLOC_LARGE_ROW_COUNT * I64{16})) {
        bytes: sync_load(wrapping(row + I64{8}))
        if (bytes != I64{0}) {
            alloc_large_shelve(sync_load(row), alloc_large_class(bytes))
            sync_store(row, I64{0})
            sync_store(wrapping(row + I64{8}), I64{0})
        }
        row = wrapping(row + I64{16})
    }
}

// A cached mapping of `class`: one the calling thread kept, else one
// unlinked from its class list, out of the cached count; or zero.
priv alloc_large_cached: fn(class: I64) -> I64 {
    bytes: wrapping(alloc_large_class_pages(class) * I64{4096})
    kept: alloc_large_take(bytes)
    if (kept != I64{0}) { return kept }
    lock: wrapping(alloc_root + I64{216})
    head: wrapping(alloc_root + wrapping(I64{256} + wrapping(class * I64{8})))
    alloc_lock(lock)
    mapping := I64{0}
    #Unsafe("the large-cache lock owns every class list and its link words") {
        mapping = os_load_i64(head)
        if (mapping != I64{0}) { os_store_i64(head, os_load_i64(mapping)) }
    }
    alloc_unlock(lock)
    if (mapping != I64{0}) {
        _ := sync_add(wrapping(alloc_root + I64{224}), wrapping(I64{0} - bytes))
    }
    mapping
}

// Keeps a freed class-sized large mapping (a row of the calling thread, else
// its class list) while the cache holds at most ALLOC_LARGE_CACHE_BYTES,
// else unmaps it. Mappings above the largest class are unmapped.
alloc_large_free: fn(mapping: I64, bytes: I64) {
    class: alloc_large_class(bytes)
    if (class >= I64{0} && wrapping(alloc_large_class_pages(class) * I64{4096}) == bytes && alloc_large_count(bytes)) {
        if alloc_large_keep(mapping, bytes) {
            return
        }
        alloc_large_shelve(mapping, class)
        return
    }
    alloc_unmap(mapping, bytes)
}

priv alloc_large: fn(size: I64, align: I64) -> I64 {
    effective: if (size == I64{0}) -> I64{1} else -> size
    // Extra header/alignment/page padding is internal overhead, not a caller
    // layout error. Refuse an unrepresentable mapping as allocation failure.
    overhead: wrapping(align - I64{1})
    limit: wrapping(I64{9223372036854775807} - I64{4119})
    if overhead > limit || effective > wrapping(limit - overhead) -> return I64{0}
    needed: alloc_align(wrapping(effective + alloc_header(align) + overhead), I64{4096})
    class: alloc_large_class(needed)
    bytes: if (class < I64{0}) -> needed else -> wrapping(alloc_large_class_pages(class) * I64{4096})
    mapping := if (class < I64{0}) -> I64{0} else -> alloc_large_cached(class)
    if (mapping == I64{0}) { mapping = alloc_map_try(bytes) }
    if (mapping == I64{0}) { return I64{0} }
    pointer: alloc_align(wrapping(mapping + alloc_header(align)), align)
    #Unsafe("pointer's two header words and the aligned payload are wholly within this page-rounded class mapping") {
        os_store_i64(wrapping(pointer - I64{16}), mapping)
        os_store_i64(wrapping(pointer - I64{8}), bytes)
    }
    pointer
}

// A direct-mapped align-1 payload of `size` bytes regrown to hold `grown`
// (rt_text_reserve_extra, #6080): mremap(MREMAP_MAYMOVE) extends or moves
// its pages, so the old and the new buffer never both hold memory, as
// allocate + copy + free would (and the freed mapping would then sit in the
// large cache). The result is the payload's new address, its bytes kept and
// the old address consumed, freed later as (result, grown, 1). Zero leaves
// the payload untouched for the caller's allocate + copy + free: a
// class-sized payload, checked mode, the counting policy or a tracked
// payload (their accounting sees allocations and frees only), or a refused
// syscall.
priv alloc_grow_large: fn(pointer: I64, size: I64, grown: I64) -> I64 {
    if (alloc_class_limit == I64{0} || grown <= size || alloc_class(size, I64{1}, alloc_class_limit) != I64{0}) {
        return I64{0}
    }
    // A served block (the page map) grows from its allocator, never by mremap.
    if (alloc_page_region(pointer) != I64{0}) { return I64{0} }
    #Unsafe("pointer is a live direct allocation of exactly `size` bytes at align 1 whose two header words name its mapping and the mapping's bytes; the mode and tracked-count words are aligned words read atomically on x86, as alloc_reserve and alloc_untrack read them; a refused mremap leaves the mapping as it was") {
        if (os_load_i64(wrapping(alloc_root + I64{144})) != I64{0} || os_load_i64(wrapping(alloc_root + I64{200})) != I64{0}) {
            return I64{0}
        }
        mapping: os_load_i64(wrapping(pointer - I64{16}))
        bytes: os_load_i64(wrapping(pointer - I64{8}))
        offset: wrapping(pointer - mapping)
        if (grown > wrapping(wrapping(I64{9223372036854775807} - I64{4095}) - offset)) {
            return I64{0}
        }
        needed: alloc_align(wrapping(grown + offset), I64{4096})
        if (needed <= bytes) { return pointer }
        class: alloc_large_class(needed)
        target: if (class < I64{0}) -> needed else -> wrapping(alloc_large_class_pages(class) * I64{4096})
        moved: os_remap_untracked_i64(mapping, bytes, target, I64{1})
        if (moved < I64{0}) { return I64{0} }
        result: wrapping(moved + offset)
        os_store_i64(wrapping(result - I64{16}), moved)
        os_store_i64(wrapping(result - I64{8}), target)
        return result
    }
}

// Session reserve is nullable on bad layout/OOM; every successful allocation
// still uses the same heap and exact-layout free as ordinary native storage.
// Checked mode (alloc_class_limit 0) sends every request to alloc_check_take.
priv alloc_try_validated: fn(size: I64, align: I64) -> I64 {
    slot: alloc_class(size, align, alloc_class_limit)
    if (slot == I64{0}) {
        // A 0 limit is set only once a heap is installed in the code words
        // (alloc_check_start, or a debugger around an evaluation).
        if (alloc_class_limit == I64{0}) { return coll_call2(alloc_check_take_code, size, align) }
        pointer: alloc_large(size, align)
        alloc_count_init(pointer, align)
        return pointer
    }
    row: alloc_cache_row(slot)
    pointer := I64{0}
    if (row == I64{0}) { pointer = alloc_small(alloc_arena(), size, align, slot) } else {
        block := I64{0}
        #Unsafe("row is this thread's private cache row") {
            block = os_load_i64(row)
            if (block == I64{0} && alloc_cache_refill(row, slot)) { block = os_load_i64(row) }
        }
        if (block != I64{0}) { pointer = alloc_cache_pop(row, block, align) }
    }
    alloc_count_init(pointer, align)
    pointer
}

// The independent policy lock is never held over heap allocation/deallocation.
// A failed reservation has made no changes, matching reserve's None rail.
// Machine words carry usize bits, including caps/counters above isize.MAX.
alloc_unsigned_less: fn(left: I64, right: I64) -> Bool Never! {
    sign: I64{-9223372036854775808}
    (left ~ sign) < (right ~ sign)
}

priv alloc_counter_add: fn(cell: I64, value: I64) {
    #Unsafe("the caller holds the policy lock and cell is a counter in alloc_root") {
        old: os_load_i64(cell)
        next_value: wrapping(old + value)
        os_store_i64(cell, if alloc_unsigned_less(next_value, old) -> I64{-1} else -> next_value)
    }
}

alloc_reserve: fn(requested: I64) -> I64 {
    #Unsafe("the aligned mode word is read atomically on x86; system allocation needs no policy lock") {
        if (os_load_i64(wrapping(alloc_root + I64{144})) == I64{0}) { return I64{0} }
    }
    lock: wrapping(alloc_root + I64{136})
    alloc_lock(lock)
    tracked := I64{0}
    #Unsafe("the policy lock exclusively owns the mode, cap and accounting words") {
        if (os_load_i64(wrapping(alloc_root + I64{144})) != I64{0}) {
            live: os_load_i64(wrapping(alloc_root + I64{176}))
            cap: os_load_i64(wrapping(alloc_root + I64{152}))
            next_live: wrapping(live + requested)
            if alloc_unsigned_less(next_live, live) -> tracked = I64{-1} else {
                if (cap != I64{0} && alloc_unsigned_less(cap, next_live)) { tracked = I64{-1} } else {
                    os_store_i64(wrapping(alloc_root + I64{176}), next_live)
                    alloc_counter_add(wrapping(alloc_root + I64{160}), I64{1})
                    alloc_counter_add(wrapping(alloc_root + I64{168}), requested)
                    high: os_load_i64(wrapping(alloc_root + I64{184}))
                    if alloc_unsigned_less(high, next_live) {
                        os_store_i64(wrapping(alloc_root + I64{184}), next_live)
                    }
                    tracked = I64{1}
                }
            }
        }
    }
    alloc_unlock(lock)
    tracked
}

alloc_release: fn(requested: I64) {
    if (requested == I64{0}) {
        return
    }
    lock: wrapping(alloc_root + I64{136})
    alloc_lock(lock)
    #Unsafe("the policy lock exclusively owns live bytes; restoration does not erase outstanding tracked blocks") {
        cell: wrapping(alloc_root + I64{176})
        live: os_load_i64(cell)
        os_store_i64(cell, if alloc_unsigned_less(live, requested) -> I64{0} else -> wrapping(live - requested))
    }
    alloc_unlock(lock)
}

// Explicit host policy edge: the caller serializes runs around this call.
// Save fact5 (mode) and fact4 (cap) before configuring, and
// restore them with the distinct restore edge below, retaining run counters.
#Export(c) jet_rt_program_allocator_configure: fn(mode: I64, cap: I64) {
    lock: wrapping(alloc_root + I64{136})
    alloc_lock(lock)
    #Unsafe("the held policy lock serializes all native allocator configuration and reservations") {
        os_store_i64(wrapping(alloc_root + I64{144}), if (mode == I64{1}) -> I64{1} else -> I64{0})
        os_store_i64(wrapping(alloc_root + I64{152}), cap)
        if (os_load_i64(wrapping(alloc_root + I64{176})) == I64{0}) {
            os_store_i64(wrapping(alloc_root + I64{160}), I64{0})
            os_store_i64(wrapping(alloc_root + I64{168}), I64{0})
            os_store_i64(wrapping(alloc_root + I64{184}), I64{0})
        }
    }
    alloc_unlock(lock)
}

// Restoration changes policy, never historical
// counters, even after the final counted allocation has been freed.
#Export(c) jet_rt_program_allocator_restore: fn(mode: I64, cap: I64) {
    lock: wrapping(alloc_root + I64{136})
    alloc_lock(lock)
    #Unsafe("the policy lock serializes restoration with native reserve and free; tracked blocks remain in the side table") {
        os_store_i64(wrapping(alloc_root + I64{144}), if (mode == I64{1}) -> I64{1} else -> I64{0})
        os_store_i64(wrapping(alloc_root + I64{152}), cap)
    }
    alloc_unlock(lock)
}

// Facts0..5: allocations, requested, live, high-water, cap, current mode.
#Export(c) priv jet_rt_program_allocator_fact: fn(index: I64) -> I64 {
    if (index < I64{0} || index > I64{5}) { return I64{0} }
    offset: if (index < I64{4}) -> wrapping(I64{160} + index * I64{8}) else if (index == I64{4}) -> I64{152} else -> I64{144}
    lock: wrapping(alloc_root + I64{136})
    alloc_lock(lock)
    value := I64{0}
    #Unsafe("the policy lock protects this bounded fact word in alloc_root") {
        value = os_load_i64(wrapping(alloc_root + offset))
    }
    alloc_unlock(lock)
    value
}

// Tracker allocation bypasses the selected policy,
// cannot recurse, and exists only for counted payloads. Allocation failures
// release the reservation and free the payload before returning zero.
alloc_track: fn(pointer: I64, requested: I64) -> Bool {
    node: alloc_try_validated(I64{24}, I64{8})
    if (node == I64{0}) { return false }
    lock: wrapping(alloc_root + I64{136})
    alloc_lock(lock)
    #Unsafe("the private raw-heap node is fully initialized before linking under the policy/tracker lock") {
        os_store_i64(node, pointer)
        os_store_i64(wrapping(node + I64{8}), requested)
        os_store_i64(wrapping(node + I64{16}), os_load_i64(wrapping(alloc_root + I64{192})))
        os_store_i64(wrapping(alloc_root + I64{192}), node)
        count: os_load_i64(wrapping(alloc_root + I64{200}))
        os_store_i64(wrapping(alloc_root + I64{200}), wrapping(count + I64{1}))
    }
    alloc_unlock(lock)
    true
}

alloc_untrack: fn(pointer: I64) -> I64 {
    #Unsafe("the process-lifetime tracker count is an aligned x86 word; a zero count avoids any lookup or lock") {
        if (os_load_i64(wrapping(alloc_root + I64{200})) == I64{0}) { return I64{0} }
    }
    lock: wrapping(alloc_root + I64{136})
    alloc_lock(lock)
    node := I64{0}
    requested := I64{0}
    #Unsafe("the policy/tracker lock exclusively owns all side-table links and count") {
        link := wrapping(alloc_root + I64{192})
        current := os_load_i64(link)
        loop current != (I64{0}) {
            if (os_load_i64(current) == pointer) {
                node = current
                requested = os_load_i64(wrapping(current + I64{8}))
                os_store_i64(link, os_load_i64(wrapping(current + I64{16})))
                count: os_load_i64(wrapping(alloc_root + I64{200}))
                os_store_i64(wrapping(alloc_root + I64{200}), wrapping(count - I64{1}))
                break
            }
            link = wrapping(current + I64{16})
            current = os_load_i64(link)
        }
    }
    alloc_unlock(lock)
    if (node != I64{0}) { alloc_free_validated(node, I64{24}, I64{8}) }
    requested
}

alloc_try_reserved: fn(size: I64, align: I64) -> I64 {
    requested: if (size == I64{0}) -> I64{1} else -> size
    tracked: alloc_reserve(requested)
    if (tracked < I64{0}) { return I64{0} }
    pointer: alloc_try_validated(size, align)
    if (pointer == I64{0}) {
        if (tracked != I64{0}) { alloc_release(requested) }
        return I64{0}
    }
    if (tracked != I64{0} && !alloc_track(pointer, requested)) {
        alloc_free_validated(pointer, size, align)
        alloc_release(requested)
        return I64{0}
    }
    pointer
}

alloc_try: fn(size: I64, align: I64) -> I64 {
    if !alloc_layout_valid(size, align) -> return I64{0}
    if jet_fault_should_fail_allocation() -> return I64{0}
    alloc_try_reserved(size, align)
}

// User allocators: a `#Context(allocator: a)` block (Context.jet
// jet_ctx_push_allocator) serves the values of align <= 8 its code makes,
// in the functions it calls, from `a` until the block ends, outside checked
// mode; a task it spawns starts on the program heap (context_inherit). Only
// the value entries divert: the ones a code generator calls for a program's
// own boxes and list buffers (jet_rt_alloc_value, jet_rt_alloc_value_8,
// jet_rt_alloc_value_try, jet_rt_alloc_value_grow and
// jet_rt_alloc_value_grow_try: JetIR names them), a list's growth
// (alloc_grow_try), and the text a program builds (Text.jet
// jet_rt_string_builder_value, jet_rt_string_concat_value,
// jet_rt_string_append_value and jet_rt_string_serve) and its growth
// (alloc_grow_bytes). The runtime's own allocations always come from the
// heap. The record's allocator slot names a carrier, a runtime block [refs
// 0][handler 8][outer 16][mark 24][arena 32][entry 40][held 48]: refs
// counts the records naming it, the region records naming it (the page map
// above) and the carriers whose outer it is; handler is a function value
// fn(op: Int, x: Int, y: Int) -> Int that calls `a` (op ALLOC_USER_TAKE:
// allocate x bytes at align y, the address or 0; op ALLOC_USER_GIVE:
// release the x bytes at address y), 0 for an arena block (below); outer
// is the carrier that was current when the block began (0: the program
// heap), whose allocator the handler's own allocations use; mark is the
// stack pointer of the block's code (JetIR Build.jet ir_stack_mark): the
// frames of the functions it calls lie below it, its own frame and the
// older ones above. arena, entry and held are an arena block's.
//
// A served block is [count 0][0 at 8][block at 16] then the payload at
// block + 24, as an align-8 heap block lays out its count word and
// block-start, and lies in one registered region, whose record then names
// the carrier; a block outside every region goes back and counts as a
// refusal. Nothing in it tells it from a heap block: drop (jet_rt_free and
// the entries that fall back to it) and growth (alloc_grow_try,
// alloc_grow_large) look its address up in the page map, a miss being the
// heap, and pushes, reads and walks do not change.
//
// A value that leaves the block moves first: a store into older data, a
// return or break out of the block, a send, a task hand-off, a closure's
// capture, a module store and a memo entry put each part a younger carrier
// served into the destination's own allocator (jet_rt_move_enter; JetIR
// BuildMove.jet), and an older container grows from its owner's allocator
// (alloc_grow_carrier). So no data ever holds a part of a block that ends
// before it, and a block's end leaves no reference into its allocator.
//
// The allocation fast paths take no extra load: while the running record
// names a carrier, the TCB's cache rows are blocked (alloc_cache_sync), so
// the fast allocation finds no block and the fast free a full row, and both
// take the full path, where a value entry asks the record. Runtime metadata
// (carriers, region records, tracker nodes) always comes from the heap.
//
// Arena blocks: a block over a `mem.Arena`, or over `context.scratch`, the
// task's own arena (Context.jet jet_ctx_push_arena), serves the same values
// from the arena's block reservation: ALLOC_ARENA_BYTES of fresh pages in
// one run, which the system commits on first touch, registered in the page
// map under an arena record [base 0][units 8][ALLOC_ARENA_OWNER at 16]
// [cursor 24][top 32]. Its carrier has handler 0, the record at arena, the
// cursor at the block's start at entry and, for an arena the block made
// itself, that arena's handle at held, dropped with the carrier. A value
// is taken at the cursor (alloc_arena_take), and the block's end puts the
// cursor back at entry (alloc_arena_rewind), so nested blocks are nested
// marks and a drop gives nothing back (alloc_user_give). top is the
// innermost open block over the arena; the block owning an address in the
// reservation is the innermost open one whose entry lies at or below it
// (alloc_user_owner). Only the top block takes at the cursor: a value
// moving into an enclosing block while an inner one is open, a container
// of it growing then, and a value made once the reservation is full come
// from the program heap, which outlives them all.
ALLOC_USER_TAKE: I64{0}

ALLOC_USER_GIVE: I64{1}

ALLOC_USER_HEADER: I64{24}

ALLOC_USER_CARRIER_BYTES: I64{56}

ALLOC_ARENA_BYTES: I64{268435456}

ALLOC_ARENA_RECORD_BYTES: I64{40}

ALLOC_ARENA_OWNER: I64{-1}

// A new carrier for `handler` (whose owner moves in) over `outer`, which it
// holds one reference to, for the block whose code runs below the stack
// address `mark`, named by one record: the caller's.
alloc_user_carrier_new: fn(handler: I64, outer: I64, mark: I64) -> I64 {
    carrier: alloc_try_validated(ALLOC_USER_CARRIER_BYTES, I64{8})
    if (carrier == I64{0}) { alloc_out_of_memory(ALLOC_USER_CARRIER_BYTES) }
    sync_store(carrier, I64{1})
    sync_store(wrapping(carrier + I64{8}), handler)
    sync_store(wrapping(carrier + I64{16}), outer)
    sync_store(wrapping(carrier + I64{24}), mark)
    sync_store(wrapping(carrier + I64{32}), I64{0})
    sync_store(wrapping(carrier + I64{40}), I64{0})
    sync_store(wrapping(carrier + I64{48}), I64{0})
    if (outer != I64{0}) { jet_rt_native_closure_retain(outer) }
    carrier
}

// A record or a region record no longer names `carrier` (0: none). The
// last reference drops its handler or held arena, frees it and drops its
// reference to its outer the same way.
alloc_user_drop: fn(carrier: I64) {
    at := carrier
    loop at != (I64{0}) {
        if !jet_rt_native_closure_unref(at) {
            return
        }
        handler: sync_load(wrapping(at + I64{8}))
        outer: sync_load(wrapping(at + I64{16}))
        held: sync_load(wrapping(at + I64{48}))
        if (handler != I64{0} && jet_rt_native_closure_unref(handler)) {
            helper: sync_load(wrapping(handler + I64{16}))
            if (helper != I64{0}) {
                before: jet_scheduler_native_status()
                coll_call1_unit(helper, handler)
                scheduler_hook_checks_arm(before)
            }
        }
        if (held != I64{0}) { jet_rt_handle_drop_jet_arena(held) }
        alloc_free_validated(at, ALLOC_USER_CARRIER_BYTES, I64{8})
        at = outer
    }
}

// The record of the arena reservation kept at `slot` (a `mem.Arena`'s
// word ARENA_BLOCKS, 0 until its first block; `context.scratch` is the
// task's own `mem.Arena`), mapped on first use; 0 when the system refuses,
// and the blocks then take the program heap.
alloc_arena_record: fn(slot: I64) -> I64 {
    kept: sync_load(slot)
    if (kept != I64{0}) { return kept }
    record: alloc_reservation_map(ALLOC_ARENA_BYTES, ALLOC_ARENA_RECORD_BYTES)
    if (record == I64{0}) { return I64{0} }
    sync_store(wrapping(record + I64{16}), ALLOC_ARENA_OWNER)
    sync_store(wrapping(record + I64{24}), sync_load(record))
    sync_store(slot, record)
    record
}

// Ends the arena reservation kept at `slot` (0: none) at its arena's drop
// (a task's scratch arena drops at the task's end or its thread's
// detach). No block over it is open.
alloc_arena_release: fn(slot: I64) {
    record: sync_load(slot)
    if (record == I64{0}) {
        return
    }
    sync_store(slot, I64{0})
    base: sync_load(record)
    units: sync_load(wrapping(record + I64{8}))
    _ := alloc_page_set(base, units, I64{0})
    alloc_free_validated(record, ALLOC_ARENA_RECORD_BYTES, I64{8})
    alloc_reservation_unmap(base, units)
}

// A new arena block's carrier over `outer` for the reservation of `record`
// (0: refused), dropping the arena handle `held` (0: none) at its end. It
// becomes the record's top, entered at the record's cursor.
alloc_arena_carrier_new: fn(record: I64, held: I64, outer: I64, mark: I64) -> I64 {
    carrier: alloc_user_carrier_new(I64{0}, outer, mark)
    sync_store(wrapping(carrier + I64{32}), record)
    sync_store(wrapping(carrier + I64{48}), held)
    if (record != I64{0}) {
        sync_store(wrapping(carrier + I64{40}), sync_load(wrapping(record + I64{24})))
        sync_store(wrapping(record + I64{32}), carrier)
    }
    carrier
}

// The arena block of `carrier` ends (a user block's carrier names no
// arena): its record's cursor goes back to the block's entry, and its top
// to the enclosing open block over the same arena (0: none).
alloc_arena_rewind: fn(carrier: I64) {
    record: sync_load(wrapping(carrier + I64{32}))
    if (record == I64{0}) {
        return
    }
    sync_store(wrapping(record + I64{24}), sync_load(wrapping(carrier + I64{40})))
    at := sync_load(wrapping(carrier + I64{16}))
    loop at != (I64{0}) {
        if (sync_load(wrapping(at + I64{32})) == record) { break }
        at = sync_load(wrapping(at + I64{16}))
    }
    sync_store(wrapping(record + I64{32}), at)
}

// A served block of `size` payload bytes from the arena block of `carrier`,
// laid out as alloc_user_take's: at the record's cursor while the block is
// its arena's top and the reservation has room, else from the program heap
// at `align`.
alloc_arena_take: fn(carrier: I64, size: I64, align: I64) -> I64 {
    record: sync_load(wrapping(carrier + I64{32}))
    requested: if (size == I64{0}) -> I64{1} else -> size
    if (record == I64{0} || sync_load(wrapping(record + I64{32})) != carrier || requested > wrapping(I64{9223372036854775807} - ALLOC_USER_HEADER - I64{7})) {
        return alloc_try_reserved(size, align)
    }
    cursor: sync_load(wrapping(record + I64{24}))
    bytes: wrapping(requested + ALLOC_USER_HEADER + I64{7}) & I64{-8}
    if (bytes > wrapping(wrapping(sync_load(record) + sync_load(wrapping(record + I64{8}))) - cursor)) {
        return alloc_try_reserved(size, align)
    }
    sync_store(wrapping(record + I64{24}), wrapping(cursor + bytes))
    sync_store(cursor, I64{1})
    sync_store(wrapping(cursor + I64{8}), I64{0})
    sync_store(wrapping(cursor + I64{16}), cursor)
    wrapping(cursor + ALLOC_USER_HEADER)
}

// The running record's allocator slot, else 0: the thread has no TCB or
// record.
alloc_user_slot: fn() -> I64 {
    base: thread_base()
    if (base == I64{0} || base == thread_detached_base()) { return I64{0} }
    record: sync_load(wrapping(base + CONTEXT_TCB_SLOT))
    if (record == I64{0}) -> I64{0} else -> wrapping(record + CONTEXT_ALLOCATOR)
}

// The current record's carrier when it serves a request of `align`, else 0:
// the align is above 8, checked mode is on, or the thread has no TCB or
// record. Only the full allocation paths ask.
alloc_user_current: fn(align: I64) -> I64 {
    if (align > I64{8} || alloc_class_limit == I64{0}) { return I64{0} }
    slot: alloc_user_slot()
    if (slot == I64{0}) -> I64{0} else -> sync_load(slot)
}

// The carrier that served the block holding `address`, else 0: the page
// map has no region there (the heap), or no carrier served from it. In an
// arena's reservation it is the innermost open block over that arena whose
// entry lies at or below `address`.
alloc_user_owner: fn(address: I64) -> I64 {
    record: alloc_page_region(address)
    if (record == I64{0}) { return I64{0} }
    owner: sync_load(wrapping(record + I64{16}))
    if (owner != ALLOC_ARENA_OWNER) { return owner }
    at := sync_load(wrapping(record + I64{32}))
    loop at != (I64{0}) {
        if (sync_load(wrapping(at + I64{32})) == record && address >= sync_load(wrapping(at + I64{40}))) {
            return at
        }
        at = sync_load(wrapping(at + I64{16}))
    }
    I64{0}
}

// The carrier owning the data at `address`, whose allocator a value stored
// there comes from: a served block's carrier (the page map); for an address
// on this thread's stack, the innermost carrier whose mark lies above it,
// whose block's code called the frame holding it; else 0, the program heap,
// which an older frame's data lives as long as.
alloc_owner: fn(address: I64) -> I64 {
    served: alloc_user_owner(address)
    if (served != I64{0}) { return served }
    slot: alloc_user_slot()
    if (slot == I64{0}) { return I64{0} }
    at := sync_load(slot)
    if (at == I64{0}) { return I64{0} }
    top := I64{0}
    #Unsafe("reads the stack pointer register only; nothing is dereferenced") {
        top = os_stack_address_i64()
    }
    if (address < top) { return I64{0} }
    loop at != (I64{0}) {
        if (address < sync_load(wrapping(at + I64{24}))) { return at }
        at = sync_load(wrapping(at + I64{16}))
    }
    I64{0}
}

// Whether a part `owner` served (0: the heap) moves to live in `target`'s
// allocator (0: the heap): its block ends before target's, being one opened
// inside it. The heap outlives every block.
alloc_younger: fn(owner: I64, target: I64) -> Bool {
    if (owner == I64{0} || owner == target) { return false }
    if (target == I64{0}) { return true }
    at := sync_load(wrapping(owner + I64{16}))
    loop at != (I64{0}) {
        if (at == target) { return true }
        at = sync_load(wrapping(at + I64{16}))
    }
    false
}

// A move into `target`'s allocator (0: the heap; JetIR BuildMove.jet): while
// it runs the record names `target`, so the copies it makes come from
// there. Answers the carrier it replaced, for jet_rt_move_leave, or -1 when
// no carrier serves this thread or `target` is the current one, so no part
// is younger than the destination and nothing moves. A stop between them
// leaves the record on `target` until the block's jet_ctx_pop_allocator
// restores the enclosing carrier; the one replaced keeps the record's
// reference, so the blocks it served still go back to it.
#Export(c) jet_rt_move_enter: fn(target: I64) -> I64 {
    if (alloc_class_limit == I64{0}) { return I64{-1} }
    slot: alloc_user_slot()
    if (slot == I64{0}) { return I64{-1} }
    current: sync_load(slot)
    if (current == I64{0} || current == target) { return I64{-1} }
    sync_store(slot, target)
    alloc_cache_sync(thread_base())
    current
}

// jet_rt_move_enter into the allocator owning the destination `address`
// (alloc_owner).
#Export(c) jet_rt_move_enter_at: fn(address: I64) -> I64 {
    if (alloc_class_limit == I64{0}) { return I64{-1} }
    slot: alloc_user_slot()
    if (slot == I64{0} || sync_load(slot) == I64{0}) { return I64{-1} }
    jet_rt_move_enter(alloc_owner(address))
}

// Ends the move jet_rt_move_enter answered `saved` for (-1: none began).
#Export(c) jet_rt_move_leave: fn(saved: I64) {
    if (saved < I64{0}) {
        return
    }
    slot: alloc_user_slot()
    if (slot == I64{0}) {
        return
    }
    sync_store(slot, saved)
    alloc_cache_sync(thread_base())
}

// Whether the part at `address` (a box or buffer) moves in the running
// move: a carrier younger than its target, the record's carrier now,
// served it.
#Export(c) jet_rt_move_needed: fn(address: I64) -> Bool {
    slot: alloc_user_slot()
    if (slot == I64{0}) { return false }
    alloc_younger(alloc_user_owner(address), sync_load(slot))
}

// Calls `carrier`'s handler with (op, x, y) and answers its word, or 0 when
// a stop is pending after it: the stop leaves the handler early, so its word
// is no answer. While it runs, the current record's allocator is the
// carrier's outer, so the handler's own allocations never come back to it.
alloc_user_call: fn(carrier: I64, op: I64, x: I64, y: I64) -> I64 {
    slot: alloc_user_slot()
    saved: if (slot == I64{0}) -> I64{0} else -> sync_load(slot)
    if (slot != I64{0}) { sync_store(slot, sync_load(wrapping(carrier + I64{16}))) }
    handler: sync_load(wrapping(carrier + I64{8}))
    first: jet_int_owned_from_i64(op)
    second: jet_int_owned_from_i64(x)
    third: jet_int_owned_from_i64(y)
    before: jet_scheduler_native_status()
    answer: coll_call4(sync_load(wrapping(handler + I64{8})), handler, first, second, third)
    jet_rt_int_drop(first)
    jet_rt_int_drop(second)
    jet_rt_int_drop(third)
    if (slot != I64{0}) { sync_store(slot, saved) }
    scheduler_hook_checks_arm(before)
    if (scheduler_stop_pending() != I64{0}) { return I64{0} }
    word: jet_int_owned_to_i64(answer)
    jet_rt_int_drop(answer)
    word
}

// A served block of `size` payload bytes from `carrier`, or 0 when its
// allocator refuses. A block that is not 8-aligned or not inside one
// registered region goes back to it and counts as a refusal. The region's
// record then names `carrier`. An arena block's carrier takes from its
// arena (alloc_arena_take).
//
// A stop in the allocator's own code (a panic in `allocate`) leaves the
// handler early with no block: the stop stays pending, the task takes it at
// its next stop check, and the value comes from the program heap at `align`,
// as the free that finds no region there expects. So does every value made
// while a stop is already pending, when the handler would not run whole.
alloc_user_take: fn(carrier: I64, size: I64, align: I64) -> I64 {
    if (sync_load(wrapping(carrier + I64{8})) == I64{0}) {
        return alloc_arena_take(carrier, size, align)
    }
    requested: if (size == I64{0}) -> I64{1} else -> size
    if (requested > wrapping(I64{9223372036854775807} - ALLOC_USER_HEADER)) { return I64{0} }
    if (scheduler_stop_pending() != I64{0}) { return alloc_try_reserved(size, align) }
    bytes: wrapping(requested + ALLOC_USER_HEADER)
    block: alloc_user_call(carrier, ALLOC_USER_TAKE, bytes, I64{8})
    if (scheduler_stop_pending() != I64{0}) { return alloc_try_reserved(size, align) }
    if (block == I64{0}) { return I64{0} }
    record: if (block & I64{7} != I64{0}) -> I64{0} else -> alloc_page_region(block)
    if (record == I64{0} || alloc_page_region(wrapping(block + wrapping(bytes - I64{1}))) != record) {
        _: alloc_user_call(carrier, ALLOC_USER_GIVE, bytes, block)
        return I64{0}
    }
    alloc_user_bind(record, carrier)
    sync_store(block, I64{1})
    sync_store(wrapping(block + I64{8}), I64{0})
    sync_store(wrapping(block + I64{16}), block)
    wrapping(block + ALLOC_USER_HEADER)
}

// Makes the region of `record` name `carrier` as the allocator its blocks
// go back to, holding a reference to it in place of the one it named.
alloc_user_bind: fn(record: I64, carrier: I64) {
    bound: sync_load(wrapping(record + I64{16}))
    if (bound == carrier) {
        return
    }
    jet_rt_native_closure_retain(carrier)
    sync_store(wrapping(record + I64{16}), carrier)
    alloc_user_drop(bound)
}

// alloc_user_take for an allocation that cannot fail: a refusal is out of
// memory.
alloc_user_need: fn(carrier: I64, size: I64, align: I64) -> I64 {
    pointer: alloc_user_take(carrier, size, align)
    if (pointer == I64{0}) { alloc_out_of_memory(if (size == I64{0}) -> I64{1} else -> size) }
    pointer
}

// Returns the served block at `pointer` of `size` payload bytes, in the
// region of `record`, to the allocator whose carrier the record names. A
// region no carrier served from holds no payload to give back, and an
// arena's takes its blocks back only as its blocks end.
alloc_user_give: fn(pointer: I64, size: I64, record: I64) {
    carrier: sync_load(wrapping(record + I64{16}))
    if (carrier == I64{0} || carrier == ALLOC_ARENA_OWNER) {
        return
    }
    block: sync_load(wrapping(pointer - I64{8}))
    requested: if (size == I64{0}) -> I64{1} else -> size
    _: alloc_user_call(carrier, ALLOC_USER_GIVE, wrapping(requested + ALLOC_USER_HEADER), block)
}

// The buffer replacing the one at `old` (0: none yet) of the container
// whose header is at `place`, of `size` bytes at `align`, or 0 when
// refused: a growth (alloc_grow_carrier names its allocator).
alloc_grow_try: fn(old: I64, place: I64, size: I64, align: I64) -> I64 {
    carrier: alloc_grow_carrier(old, place, align)
    if (carrier == I64{0}) { return alloc_try(size, align) }
    if !alloc_layout_valid(size, align) -> return I64{0}
    if jet_fault_should_fail_allocation() -> return I64{0}
    alloc_user_take(carrier, size, align)
}

// The carrier serving the buffer that replaces `old` (0: none yet) of the
// container whose header is at `place`, else 0: the heap. An older
// container grows from its owner's allocator: a buffer a carrier served
// grows from that carrier's; a first buffer, or one replacing a heap
// buffer, comes from the header's owner (alloc_owner). Place 0 names a
// header the growing code's own block made (JetIR BuildRoutes.jet
// ir_list_grow_place), which the current carrier serves.
alloc_grow_carrier: fn(old: I64, place: I64, align: I64) -> I64 {
    if (align > I64{8} || alloc_class_limit == I64{0}) { return I64{0} }
    served: if (old == I64{0}) -> I64{0} else -> alloc_user_owner(old)
    if (served != I64{0}) { return served }
    if (place == I64{0}) -> alloc_user_current(align) else -> alloc_owner(place)
}

// jet_rt_alloc for the buffer replacing the one at `old` of the container
// at `place` (alloc_grow_try).
alloc_grow: fn(old: I64, place: I64, size: I64, align: I64) -> I64 {
    carrier: alloc_grow_carrier(old, place, align)
    if (carrier == I64{0}) -> jet_rt_alloc(size, align) else -> alloc_user_need(carrier, size, align)
}

// alloc_bytes for the text buffer replacing the one at `old`: one a carrier
// served grows from that carrier's allocator; text is otherwise the
// heap's.
alloc_grow_bytes: fn(old: I64, size: I64) -> I64 {
    carrier: if (old == I64{0} || alloc_class_limit == I64{0}) -> I64{0} else -> alloc_user_owner(old)
    if (carrier == I64{0}) -> alloc_bytes(size) else -> alloc_user_need(carrier, size, I64{1})
}

// A program list's growth (JetIR BuildRoutes.jet): the buffer of `size`
// bytes replacing `old` (0: none) of the header at `place` (0: one the
// growing code's own block made), from the allocator alloc_grow_carrier
// names; a refusal is out of memory.
#Export(c) jet_rt_alloc_value_grow: fn(size: I64, old: I64, place: I64) -> I64 {
    alloc_grow(old, place, size, I64{8})
}

// jet_rt_alloc_value_grow answering 0 for a refusal.
#Export(c) jet_rt_alloc_value_grow_try: fn(size: I64, old: I64, place: I64) -> I64 {
    alloc_grow_try(old, place, size, I64{8})
}

// The allocation fast path (#5476): jet_rt_alloc, jet_rt_alloc_try and
// jet_rt_free serve a small request of a plainly valid layout (size below
// alloc_class_limit, align 1, 2, 4 or 8) on the calling thread's cache row,
// calling nothing, so it needs no saved registers: an empty row takes the
// full path, whose alloc_try_validated refills it. It writes the block,
// header and count word alloc_try_validated writes (an align-8 block's
// slab word already sits where its payload header wants it), and makes the
// push alloc_free_validated makes. The class row is alloc_row's. The checks
// that stay on it:
// - the layout: a size and power-of-two align in the range, so the full
//   path's alloc_layout_valid accepts it and its trap is never skipped;
// - checked mode: alloc_class_limit 0 admits no size, so every request takes
//   the full path, which hands it to the checked heap;
// - a TCB: a thread without one (GS names a zero word) has no row;
// - the counting policy: the mode word is 0 on allocation, and no counted
//   payload is tracked on free (so alloc_untrack has nothing to find), so
//   the ProgramAllocator facts stay exact;
// - user allocators: a TCB whose record names a `#Context(allocator:)`
//   carrier has its rows blocked (alloc_cache_sync), so its allocations and
//   frees take the full path, where only the value entries
//   (jet_rt_alloc_value) ask the record; a free first looks its address up
//   in the page map (alloc_page_region: one load of a word on the tracked
//   count's line while no region exists), and a block a region holds takes
//   the full path;
// - an ending process frees nothing (#5478, Main.jet).
// Anything else (a direct mapping, over-alignment, an empty row, a row
// holding 64 blocks) takes the full path, unchanged.
#Export(c) priv jet_rt_alloc: fn(size: I64, align: I64) -> I64 {
    if (size >= I64{0} && size < alloc_class_limit && align > I64{0} && align <= I64{8} && align & wrapping(align - I64{1}) == I64{0}) {
        header: if (align == I64{8}) -> I64{24} else -> I64{16}
        index: alloc_row(wrapping(wrapping((if (size == I64{0}) -> I64{1} else -> size) + header) + (if (align == I64{8}) -> I64{0} else -> wrapping(align - I64{1}))))
        if (index < I64{8}) {
            #Unsafe("GS:0 is the attached thread's TCB or, unattached, the readable zero word (thread_base); the aligned mode word is read atomically on x86, as alloc_reserve reads it; row is this thread's private cache row (TCB @320 + 16 per class, alloc_cache_row) and block its cached head, whose two cached words are read before the payload header overwrites them; an align <= 8 payload at block + header is aligned because blocks start 32-aligned") {
                base: os_tls_base_i64()
                if (base != I64{0} && os_load_i64(wrapping(alloc_root + I64{144})) == I64{0}) {
                    row: wrapping(base + wrapping(I64{320} + (index << I64{4})))
                    block: os_load_i64(row)
                    if (block != I64{0}) {
                        os_store_i64(row, os_load_i64(block))
                        os_store_i64(wrapping(row + I64{8}), wrapping(os_load_i64(wrapping(row + I64{8})) - I64{1}))
                        if (align == I64{8}) {
                            os_store_i64(wrapping(block + I64{16}), block)
                            os_store_i64(block, I64{1})
                        } else {
                            os_store_i64(block, os_load_i64(wrapping(block + I64{8})))
                            os_store_i64(wrapping(block + I64{8}), block)
                        }
                        return wrapping(block + header)
                    }
                }
            }
        }
    }
    alloc_need(size, align)
}

// jet_rt_alloc beyond its fast path, a call of its own so the fast path
// stays a leaf.
alloc_need: fn(size: I64, align: I64) -> I64 {
    if !alloc_layout_valid(size, align) {
        rt_trap_invalid_box_layout()
        return I64{0}
    }
    // Allocation failure is terminal SIGABRT.
    pointer: alloc_try_reserved(size, align)
    if (pointer == I64{0}) { alloc_out_of_memory(if (size == I64{0}) -> I64{1} else -> size) }
    pointer
}

// The fallible entry (core.mem.alloc_raw, a list growth that may be
// refused) takes jet_rt_alloc's fast path while no allocation fault is armed
// (fault_check_code 0: an armed schedule sees every request); whatever the
// path does not serve takes alloc_try, which answers 0 where jet_rt_alloc
// aborts.
#Export(c) priv jet_rt_alloc_try: fn(size: I64, align: I64) -> I64 {
    if (fault_check_code == I64{0} && size >= I64{0} && size < alloc_class_limit && align > I64{0} && align <= I64{8} && align & wrapping(align - I64{1}) == I64{0}) {
        header: if (align == I64{8}) -> I64{24} else -> I64{16}
        index: alloc_row(wrapping(wrapping((if (size == I64{0}) -> I64{1} else -> size) + header) + (if (align == I64{8}) -> I64{0} else -> wrapping(align - I64{1}))))
        if (index < I64{8}) {
            #Unsafe("as in jet_rt_alloc: GS:0 is the attached thread's TCB or the readable zero word; the aligned mode word is read atomically on x86; row is this thread's private cache row and block its cached head, whose two cached words are read before the payload header overwrites them; an align <= 8 payload at block + header is aligned because blocks start 32-aligned") {
                base: os_tls_base_i64()
                if (base != I64{0} && os_load_i64(wrapping(alloc_root + I64{144})) == I64{0}) {
                    row: wrapping(base + wrapping(I64{320} + (index << I64{4})))
                    block: os_load_i64(row)
                    if (block != I64{0}) {
                        os_store_i64(row, os_load_i64(block))
                        os_store_i64(wrapping(row + I64{8}), wrapping(os_load_i64(wrapping(row + I64{8})) - I64{1}))
                        if (align == I64{8}) {
                            os_store_i64(wrapping(block + I64{16}), block)
                            os_store_i64(block, I64{1})
                        } else {
                            os_store_i64(block, os_load_i64(wrapping(block + I64{8})))
                            os_store_i64(wrapping(block + I64{8}), block)
                        }
                        return wrapping(block + header)
                    }
                }
            }
        }
    }
    alloc_try(size, align)
}

#Export(c) priv jet_rt_free: fn(pointer: I64, size: I64, align: I64) {
    // Match the original C ABI's null no-op before validating its layout.
    if (pointer == I64{0}) {
        return
    }
    if (size >= I64{0} && size < alloc_class_limit && align > I64{0} && align <= I64{8} && align & wrapping(align - I64{1}) == I64{0} && alloc_unmarked(pointer, align)) {
        // An ending process leaves its heap to the kernel (#5478, Main.jet).
        if (main_process_ending != I64{0}) {
            return
        }
        index: alloc_row(wrapping((if (size == I64{0}) -> I64{1} else -> size) + (if (align == I64{8}) -> I64{24} else -> wrapping(I64{15} + align))))
        if (index < I64{8}) {
            #Unsafe("GS:0 is the attached thread's TCB or, unattached, the readable zero word (thread_base); the tracked count and the page-map root are aligned words read atomically, as alloc_untrack and alloc_page_region read them; row is this thread's private cache row; the lowering frees exactly once with the allocation's original layout, so the payload header is read before the block's cached words overwrite it") {
                base: os_tls_base_i64()
                if (base != I64{0} && os_load_i64(wrapping(alloc_root + I64{200})) == I64{0} && (os_load_i64(wrapping(alloc_root + ALLOC_PAGE_MAP)) == I64{0} || alloc_page_region(pointer) == I64{0})) {
                    row: wrapping(base + wrapping(I64{320} + (index << I64{4})))
                    count: os_load_i64(wrapping(row + I64{8}))
                    if (count < I64{64}) {
                        block: os_load_i64(wrapping(pointer - I64{8}))
                        slab: os_load_i64(wrapping(pointer - I64{16}))
                        os_store_i64(block, os_load_i64(row))
                        os_store_i64(wrapping(block + I64{8}), slab)
                        os_store_i64(row, block)
                        os_store_i64(wrapping(row + I64{8}), wrapping(count + I64{1}))
                        return
                    }
                }
            }
        }
    }
    alloc_give(pointer, size, align)
}

// False for an align-8 payload whose count word carries the zero-at-free
// mark, which only alloc_give's wipe may free (alloc_zero_marked).
priv alloc_unmarked: fn(pointer: I64, align: I64) -> Bool {
    if (align < I64{8}) { return true }
    #Unsafe("pointer is an align-8 payload being freed; its block reserved the count word 24 bytes before it") {
        return os_load_i64(wrapping(pointer - I64{24})) & RC_ZERO_MARK == I64{0}
    }
}

// jet_rt_free beyond its fast path, a call of its own so the fast path
// stays a leaf.
alloc_give: fn(pointer: I64, size: I64, align: I64) {
    if (align >= I64{8}) { alloc_zero_marked(pointer, size) }
    if !alloc_layout_valid(size, align) {
        rt_trap_invalid_box_layout()
        return
    }
    // An ending process leaves its heap to the kernel (#5478, Main.jet).
    if (main_process_ending != I64{0}) {
        return
    }
    region: alloc_page_region(pointer)
    if (region != I64{0}) {
        alloc_user_give(pointer, size, region)
        return
    }
    alloc_release(alloc_untrack(pointer))
    alloc_free_validated(pointer, size, align)
}

// The align-8 entries (#5925): jet_rt_alloc_8(size) is jet_rt_alloc(size, 8)
// and jet_rt_free_8(pointer, size) is jet_rt_free(pointer, size, 8). A code
// generator calls them for a constant align 8 (JetIR X64Select
// ir_x64_alloc_entry), the align every box, record and word buffer has.
// With the align known, the fast path needs no layout validation but the
// size's range and no header choice, and the entry has a small frame. The
// class row is alloc_row's for size + 24 bytes. Everything else takes the
// general entry.
#Export(c) priv jet_rt_alloc_8: fn(size: I64) -> I64 {
    if (size >= I64{0}) {
        if (size < alloc_class_limit) {
            index: alloc_row(wrapping(size + I64{24}))
            if (index < I64{8}) {
                offset: wrapping(I64{320} + (index << I64{4}))
                #Unsafe("GS:0 is the attached thread's TCB or, unattached, the readable zero word (thread_base); the aligned mode word is read atomically on x86, as alloc_reserve reads it; row is this thread's private cache row of the size's class and block its cached head, whose next word is read before the count overwrites it; the block's second word is its slab word, the payload header's; the payload at block + 24 is 8-aligned because blocks start 32-aligned") {
                    base: os_tls_base_i64()
                    if (base != I64{0}) {
                        if (os_load_i64(wrapping(alloc_root + I64{144})) == I64{0}) {
                            row: wrapping(base + offset)
                            block: os_load_i64(row)
                            if (block != I64{0}) {
                                os_store_i64(row, os_load_i64(block))
                                os_store_i64(wrapping(row + I64{8}), wrapping(os_load_i64(wrapping(row + I64{8})) - I64{1}))
                                os_store_i64(wrapping(block + I64{16}), block)
                                os_store_i64(block, I64{1})
                                return wrapping(block + I64{24})
                            }
                        }
                    }
                }
            }
        }
    }
    jet_rt_alloc(size, I64{8})
}

#Export(c) priv jet_rt_free_8: fn(pointer: I64, size: I64) {
    if (pointer != I64{0}) {
        if (size >= I64{0}) {
            if (size < alloc_class_limit) {
                // An ending process leaves its heap to the kernel (#5478, Main.jet).
                if (main_process_ending != I64{0}) {
                    return
                }
                index: alloc_row(wrapping(size + I64{24}))
                if (index < I64{8}) {
                    offset: wrapping(I64{320} + (index << I64{4}))
                    #Unsafe("GS:0 is the attached thread's TCB or, unattached, the readable zero word (thread_base); the tracked count and the page-map root are aligned words read atomically, as alloc_untrack and alloc_page_region read them; row is this thread's private cache row of the size's class; the lowering frees exactly once with the allocation's original layout, so the payload header is read before the block's next word overwrites it; the block's second word stays its slab word; a count word with the zero-at-free mark takes the general entry, which wipes the payload") {
                        base: os_tls_base_i64()
                        if (base != I64{0} && os_load_i64(wrapping(pointer - I64{24})) & RC_ZERO_MARK == I64{0}) {
                            if (os_load_i64(wrapping(alloc_root + I64{200})) == I64{0} && (os_load_i64(wrapping(alloc_root + ALLOC_PAGE_MAP)) == I64{0} || alloc_page_region(pointer) == I64{0})) {
                                row: wrapping(base + offset)
                                count: os_load_i64(wrapping(row + I64{8}))
                                if (count < I64{64}) {
                                    block: os_load_i64(wrapping(pointer - I64{8}))
                                    os_store_i64(block, os_load_i64(row))
                                    os_store_i64(row, block)
                                    os_store_i64(wrapping(row + I64{8}), wrapping(count + I64{1}))
                                    return
                                }
                            }
                        }
                    }
                }
            }
        }
    }
    jet_rt_free(pointer, size, I64{8})
}

// The value entries: jet_rt_alloc_value, jet_rt_alloc_value_8 and
// jet_rt_alloc_value_try are jet_rt_alloc, jet_rt_alloc_8 and
// jet_rt_alloc_try for a program's own values (JetIR BuildMove.jet names
// the kinds), which a `#Context(allocator:)` block's carrier serves
// (the user allocators above). Their fast paths are jet_rt_alloc's and
// jet_rt_alloc_8's, spelled out again so the program's allocations call
// nothing more: a current carrier blocks the rows, so only the full path
// asks the record for it.
#Export(c) priv jet_rt_alloc_value: fn(size: I64, align: I64) -> I64 {
    if (size >= I64{0} && size < alloc_class_limit && align > I64{0} && align <= I64{8} && align & wrapping(align - I64{1}) == I64{0}) {
        header: if (align == I64{8}) -> I64{24} else -> I64{16}
        index: alloc_row(wrapping(wrapping((if (size == I64{0}) -> I64{1} else -> size) + header) + (if (align == I64{8}) -> I64{0} else -> wrapping(align - I64{1}))))
        if (index < I64{8}) {
            #Unsafe("GS:0 is the attached thread's TCB or, unattached, the readable zero word (thread_base); the aligned mode word is read atomically on x86, as alloc_reserve reads it; row is this thread's private cache row (TCB @320 + 16 per class, alloc_cache_row) and block its cached head, whose two cached words are read before the payload header overwrites them; an align <= 8 payload at block + header is aligned because blocks start 32-aligned") {
                base: os_tls_base_i64()
                if (base != I64{0} && os_load_i64(wrapping(alloc_root + I64{144})) == I64{0}) {
                    row: wrapping(base + wrapping(I64{320} + (index << I64{4})))
                    block: os_load_i64(row)
                    if (block != I64{0}) {
                        os_store_i64(row, os_load_i64(block))
                        os_store_i64(wrapping(row + I64{8}), wrapping(os_load_i64(wrapping(row + I64{8})) - I64{1}))
                        if (align == I64{8}) {
                            os_store_i64(wrapping(block + I64{16}), block)
                            os_store_i64(block, I64{1})
                        } else {
                            os_store_i64(block, os_load_i64(wrapping(block + I64{8})))
                            os_store_i64(wrapping(block + I64{8}), block)
                        }
                        return wrapping(block + header)
                    }
                }
            }
        }
    }
    alloc_value_need(size, align)
}

// jet_rt_alloc_value beyond its fast path, a call of its own so the fast
// path stays a leaf.
alloc_value_need: fn(size: I64, align: I64) -> I64 {
    if !alloc_layout_valid(size, align) {
        rt_trap_invalid_box_layout()
        return I64{0}
    }
    carrier: alloc_user_current(align)
    if (carrier != I64{0}) { return alloc_user_need(carrier, size, align) }
    // Allocation failure is terminal SIGABRT.
    pointer: alloc_try_reserved(size, align)
    if (pointer == I64{0}) { alloc_out_of_memory(if (size == I64{0}) -> I64{1} else -> size) }
    pointer
}

#Export(c) priv jet_rt_alloc_value_8: fn(size: I64) -> I64 {
    if (size >= I64{0}) {
        if (size < alloc_class_limit) {
            index: alloc_row(wrapping(size + I64{24}))
            if (index < I64{8}) {
                offset: wrapping(I64{320} + (index << I64{4}))
                #Unsafe("GS:0 is the attached thread's TCB or, unattached, the readable zero word (thread_base); the aligned mode word is read atomically on x86, as alloc_reserve reads it; row is this thread's private cache row of the size's class and block its cached head, whose next word is read before the count overwrites it; the block's second word is its slab word, the payload header's; the payload at block + 24 is 8-aligned because blocks start 32-aligned") {
                    base: os_tls_base_i64()
                    if (base != I64{0}) {
                        if (os_load_i64(wrapping(alloc_root + I64{144})) == I64{0}) {
                            row: wrapping(base + offset)
                            block: os_load_i64(row)
                            if (block != I64{0}) {
                                os_store_i64(row, os_load_i64(block))
                                os_store_i64(wrapping(row + I64{8}), wrapping(os_load_i64(wrapping(row + I64{8})) - I64{1}))
                                os_store_i64(wrapping(block + I64{16}), block)
                                os_store_i64(block, I64{1})
                                return wrapping(block + I64{24})
                            }
                        }
                    }
                }
            }
        }
    }
    jet_rt_alloc_value(size, I64{8})
}

#Export(c) jet_rt_alloc_value_try: fn(size: I64, align: I64) -> I64 {
    carrier: alloc_user_current(align)
    if (carrier == I64{0}) { return alloc_try(size, align) }
    if !alloc_layout_valid(size, align) -> return I64{0}
    if jet_fault_should_fail_allocation() -> return I64{0}
    alloc_user_take(carrier, size, align)
}

// The align-1 entries for text and byte buffers: alloc_bytes(size) is
// jet_rt_alloc(size, 1) and free_bytes(pointer, size) is
// jet_rt_free(pointer, size, 1), with the align known as the align-8 entries
// know theirs. The payload sits 16 bytes into its block (the slab word, then
// the block's address), and the class row is alloc_row's for size + 16
// bytes. The fast paths write and read exactly the words jet_rt_alloc's and
// jet_rt_free's do for align 1; everything else (an empty row's refill
// included) takes the general entry.
priv alloc_bytes: fn(size: I64) -> I64 {
    if (size >= I64{0} && size < alloc_class_limit) {
        index: alloc_row(wrapping(size + I64{16}))
        if (index < I64{8}) {
            offset: wrapping(I64{320} + (index << I64{4}))
            #Unsafe("GS:0 is the attached thread's TCB or, unattached, the readable zero word (thread_base); the aligned mode word is read atomically on x86, as alloc_reserve reads it; row is this thread's private cache row of the size's class and block its cached head, whose two cached words are read before the payload header overwrites them; an align-1 payload at block + 16 needs no alignment") {
                base: os_tls_base_i64()
                if (base != I64{0} && os_load_i64(wrapping(alloc_root + I64{144})) == I64{0}) {
                    row: wrapping(base + offset)
                    block: os_load_i64(row)
                    if (block != I64{0}) {
                        os_store_i64(row, os_load_i64(block))
                        os_store_i64(wrapping(row + I64{8}), wrapping(os_load_i64(wrapping(row + I64{8})) - I64{1}))
                        os_store_i64(block, os_load_i64(wrapping(block + I64{8})))
                        os_store_i64(wrapping(block + I64{8}), block)
                        return wrapping(block + I64{16})
                    }
                }
            }
        }
    }
    jet_rt_alloc(size, I64{1})
}

priv free_bytes: fn(pointer: I64, size: I64) {
    if (pointer != I64{0} && size >= I64{0} && size < alloc_class_limit) {
        // An ending process leaves its heap to the kernel (#5478, Main.jet).
        if (main_process_ending != I64{0}) {
            return
        }
        index: alloc_row(wrapping(size + I64{16}))
        if (index < I64{8}) {
            offset: wrapping(I64{320} + (index << I64{4}))
            #Unsafe("GS:0 is the attached thread's TCB or, unattached, the readable zero word (thread_base); the tracked count and the page-map root are aligned words read atomically, as alloc_untrack and alloc_page_region read them; row is this thread's private cache row of the size's class; the caller frees exactly once with the allocation's original layout, so the payload header is read before the block's cached words overwrite it") {
                base: os_tls_base_i64()
                if (base != I64{0} && os_load_i64(wrapping(alloc_root + I64{200})) == I64{0} && (os_load_i64(wrapping(alloc_root + ALLOC_PAGE_MAP)) == I64{0} || alloc_page_region(pointer) == I64{0})) {
                    row: wrapping(base + offset)
                    count: os_load_i64(wrapping(row + I64{8}))
                    if (count < I64{64}) {
                        block: os_load_i64(wrapping(pointer - I64{8}))
                        slab: os_load_i64(wrapping(pointer - I64{16}))
                        os_store_i64(block, os_load_i64(row))
                        os_store_i64(wrapping(block + I64{8}), slab)
                        os_store_i64(row, block)
                        os_store_i64(wrapping(row + I64{8}), wrapping(count + I64{1}))
                        return
                    }
                }
            }
        }
    }
    jet_rt_free(pointer, size, I64{1})
}

// Checked mode (alloc_class_limit 0) sends every free to alloc_check_give.
priv alloc_free_validated: fn(pointer: I64, size: I64, align: I64) {
    slot: alloc_class(size, align, alloc_class_limit)
    if (slot == I64{0}) {
        // A 0 limit is set only once a heap is installed in the code words
        // (alloc_check_start, or a debugger around an evaluation).
        if (alloc_class_limit == I64{0}) {
            _ := coll_call3(alloc_check_give_code, pointer, size, align)
            return
        }
        alloc_large_give(pointer)
        return
    }
    row: alloc_cache_row(slot)
    if (row != I64{0}) {
        // A row holding 64 blocks first returns its 32 most recently pushed
        // ones to their slabs, then takes this block.
        #Unsafe("row is this thread's private cache row; the lowering frees exactly once with the allocation's original layout, so the payload header is read before the block's cached words overwrite it") {
            if (os_load_i64(wrapping(row + I64{8})) >= I64{64}) { alloc_cache_drain(row, I64{32}) }
            slab: os_load_i64(wrapping(pointer - I64{16}))
            block: os_load_i64(wrapping(pointer - I64{8}))
            os_store_i64(block, os_load_i64(row))
            os_store_i64(wrapping(block + I64{8}), slab)
            os_store_i64(row, block)
            os_store_i64(wrapping(row + I64{8}), wrapping(os_load_i64(wrapping(row + I64{8})) + I64{1}))
        }
        return
    }
    alloc_arena_give(pointer)
}

// Return a direct allocation's mapping.
priv alloc_large_give: fn(pointer: I64) {
    #Unsafe("the lowering returns this still-live direct allocation with exactly its original size and alignment") {
        mapping: os_load_i64(wrapping(pointer - I64{16}))
        bytes: os_load_i64(wrapping(pointer - I64{8}))
        alloc_large_free(mapping, bytes)
    }
}

// Return a class payload straight to its slab under its arena's lock (a
// thread without a cache row, and a checked block's own heap block).
priv alloc_arena_give: fn(pointer: I64) {
    slab := I64{0}
    root := I64{0}
    #Unsafe("the caller's live payload header names its slab, whose arena word is fixed when the slab is created") {
        slab = os_load_i64(wrapping(pointer - I64{16}))
        root = os_load_i64(wrapping(slab + I64{40}))
    }
    alloc_lock(root)
    #Unsafe("the lowering frees exactly once with the allocation's original layout; its slab remains live until this last payload is returned under its arena's lock") {
        alloc_slab_return(slab, os_load_i64(wrapping(pointer - I64{8})))
    }
    alloc_unlock(root)
}

// Checked mode (#5095): a program built with `--checked-alloc` turns a bad
// free from silent heap corruption into a trap that names its call site.
// Off, the class path is unchanged but for reading the class limit from the
// global alloc_class_limit: checked mode sets it to 0, so every allocation
// and free reaches the direct-mapping branch, which alone tests for checked
// mode. The checked heap (jet_rt_alloc_check_take, _give, _sweep) is linked
// only into such a program (alloc_check_linked above).
// A checked payload p of (size, align) lives inside one ordinary heap block
// q of (prefix + size + 8, max(align, 8)), p = q + prefix, where the prefix
// is 200 bytes rounded up to align:
//   p-8     canary: ALLOC_CHECK_LIVE ^ p while live, ALLOC_CHECK_FREED ^ p freed
//   p-16    q
//   p-24    the reference count (Refcount.jet reads payload-24), 1 for align >= 8
//   p-32    size, p-40 align
//   p-120.. ten return addresses of the allocating chain (ascending to p-48)
//   p-200.. ten return addresses of the freeing chain (ascending to p-128);
//           while the block lives and the heap tracks (below), p-128 holds
//           the next tracked block, p-136 the previous one and p-144 1
//   p+size  an unaligned tail canary ALLOC_CHECK_TAIL ^ p
// Each chain starts inside the allocator: the backend may inline its
// helpers, so a fixed skip count could drop the caller's own frame.
// A free checks the canary (a second free, or a pointer this heap never
// handed out or whose header was overwritten), the layout (the allocation's
// size and alignment) and the tail canary (a write past the end); it then
// poisons the payload with 0xDF bytes and parks the block in a FIFO
// quarantine of ALLOC_CHECK_SLOTS blocks and at most ALLOC_CHECK_BUDGET
// payload bytes, so a stale pointer cannot reach a reused block. A block
// leaving the quarantine, and every parked block when main returns
// (alloc_check_sweep), must still carry its freed canary, its poison and its
// tail: otherwise something wrote after the free. A trap prints the block,
// the current call chain and the recorded chains (return addresses walked
// up the rbp frame chain, symbolized from /proc/self/exe's .symtab, relocated
// by the AT_PHDR load bias for a PIE; runtime-internal functions have no
// symbol and print as ??), then aborts.
// State page words: quarantine lock 16, ring 24, pushes 32, parked count 40,
// parked bytes 48, frame-pointer stub 56 (alloc_frames_start).
// Under `jet perf run --lens=alloc` the heap tracks (alloc_check_track_start):
// each take links its block at the head of a list of live blocks
// (alloc_check_live_head) and a free unlinks it, both under the quarantine
// lock, so a heap snapshot (PerfSamples.jet perf_samples_heap) can walk
// every block allocated since and still live; under that same lock the take
// counts its allocation and its bytes at its allocating chain
// (PerfSamples.jet perf_samples_alloc_site).
ALLOC_CHECK_LIVE: I64{2397417249457849674}

ALLOC_CHECK_FREED: I64{2397398596314219850}

ALLOC_CHECK_TAIL: I64{2399373246418142538}

ALLOC_CHECK_POISON: I64{-2314885530818453537}

ALLOC_CHECK_SLOTS: I64{4096}

ALLOC_CHECK_BUDGET: I64{67108864}

// Checked mode's start: the quarantine's ring, and the frame walk's stub
// (alloc_frames_start).
alloc_check_start: fn() {
    ring: alloc_map(wrapping(ALLOC_CHECK_SLOTS * I64{8}), wrapping(ALLOC_CHECK_SLOTS * I64{8}))
    alloc_frames_start()
    #Unsafe("the fresh state page is private to initialization, which precedes every allocation") {
        os_store_i64(wrapping(alloc_root + I64{24}), ring)
    }
    #Unsafe("checked-heap start runs during runtime-init, before any other thread exists") {
        alloc_class_limit = I64{0}
    }
}

// The frame walk needs rbp, which no admitted asm leaf reads (and a new leaf
// would not assemble with a seed that predates it), so this maps a
// four-byte read-only executable stub `mov rax, rbp; ret` called through
// os_call_address_i64: rbp is unchanged across the call, so it returns the
// calling function's frame pointer. Mapped once, by checked mode's start
// and by `jet perf run`'s (PerfSamples.jet perf_samples_start); until then
// every walk (alloc_check_frames) is empty.
alloc_frames_start: fn() {
    mapped := I64{0}
    #Unsafe("the state page's stub word, written only here") {
        mapped = os_load_i64(wrapping(alloc_root + I64{56}))
    }
    if (mapped != I64{0}) {
        return
    }
    stub: alloc_map(I64{4096}, I64{4096})
    #Unsafe("the fresh stub page is private until its address is stored; it becomes read+execute before any call") {
        os_store_i64(stub, I64{3286796616})
        if (os_syscall_i64(I64{10}, stub, I64{4096}, I64{5}, I64{0}, I64{0}, I64{0}) == I64{0}) {
            os_store_i64(wrapping(alloc_root + I64{56}), stub)
        }
    }
}

alloc_check_prefix: fn(align: I64) -> I64 Never! {
    if (align <= I64{8}) -> I64{200} else -> alloc_align(I64{200}, align)
}

// Store `count` return addresses of the calling chain at out, out+8, ...;
// 0 past the chain's end. The walk stops at a null or misaligned link or one
// that does not ascend within 16 MiB, and crosses a stack segment's bridge
// frame (StackSegment.jet stack_frame_caller), so it never leaves the
// thread's stacks.
priv alloc_check_frames: fn(out: I64, count: I64) {
    frame := I64{0}
    #Unsafe("the frame stub (alloc_frames_start) only copies rbp to rax and returns; a missing stub leaves no chain") {
        stub: os_load_i64(wrapping(alloc_root + I64{56}))
        if (stub != I64{0}) { frame = os_call_address_i64(stub, I64{0}) }
    }
    index := I64{0}
    loop index < count {
        address := I64{0}
        if (frame != I64{0} && frame & I64{7} == I64{0}) {
            #Unsafe("frame is an active caller's [saved rbp][return address] pair on this thread's stack: each followed link ascends by less than 16 MiB or crosses a stack segment's bridge frame") {
                address = os_load_i64(wrapping(frame + I64{8}))
                frame = stack_frame_caller(frame)
            }
        }
        #Unsafe("out lends count writable words: a checked block's chain words or a trap's scratch page") {
            os_store_i64(wrapping(out + wrapping(index * I64{8})), address)
        }
        index = wrapping(index + I64{1})
    }
}

// The calling chain alloc_check_frames walks, as a key: `seed` hashed with
// its first `count` return addresses, each as the link-time call site
// before it (the address less 1 and `bias`), up to the first site outside
// [low, high). With `into` not 0 it also stores those sites at into,
// into+8, ... It allocates nothing, so a hook on every host call keys its
// caller by it (PerfSamples.jet perf_syscall_row).
priv alloc_frames_key: fn(seed: I64, into: I64, count: I64, bias: I64, low: I64, high: I64) -> I64 {
    frame := I64{0}
    #Unsafe("the frame stub (alloc_frames_start) only copies rbp to rax and returns; a missing stub leaves no chain") {
        stub: os_load_i64(wrapping(alloc_root + I64{56}))
        if (stub != I64{0}) { frame = os_call_address_i64(stub, I64{0}) }
    }
    key := seed
    index := I64{0}
    loop index < count {
        if (frame == I64{0} || frame & I64{7} != I64{0}) { break }
        address := I64{0}
        #Unsafe("frame is an active caller's [saved rbp][return address] pair on this thread's stack: each followed link ascends by less than 16 MiB or crosses a stack segment's bridge frame") {
            address = os_load_i64(wrapping(frame + I64{8}))
            frame = stack_frame_caller(frame)
        }
        site: wrapping(wrapping(address - I64{1}) - bias)
        if (address == I64{0} || site < low || site >= high) { break }
        if (into != I64{0}) {
            #Unsafe("into lends count writable words: a host call row's site words") {
                os_store_i64(wrapping(into + wrapping(index * I64{8})), site)
            }
        }
        key = wrapping((key ~ site) * I64{1099511628211})
        index = wrapping(index + I64{1})
    }
    key
}

#Export(c) priv jet_rt_alloc_check_take: fn(size: I64, align: I64) -> I64 {
    prefix: alloc_check_prefix(align)
    inner_align: if (align < I64{8}) -> I64{8} else -> align
    if (size > wrapping(wrapping(I64{9223372036854775807} - prefix) - wrapping(inner_align + I64{8}))) {
        return I64{0}
    }
    block: alloc_check_block_take(wrapping(wrapping(prefix + size) + I64{8}), inner_align)
    if (block == I64{0}) { return I64{0} }
    pointer: wrapping(block + prefix)
    #Unsafe("block is this caller's fresh heap block of prefix + size + 8 bytes; every word written lies in block .. pointer + size + 8") {
        os_store_i64(wrapping(pointer - I64{8}), pointer ~ ALLOC_CHECK_LIVE)
        os_store_i64(wrapping(pointer - I64{16}), block)
        os_store_i64(wrapping(pointer - I64{24}), if (align >= I64{8}) -> I64{1} else -> I64{0})
        os_store_i64(wrapping(pointer - I64{32}), size)
        os_store_i64(wrapping(pointer - I64{40}), align)
        at := I64{128}
        loop at <= (I64{200}) {
            os_store_i64(wrapping(pointer - at), I64{0})
            at = wrapping(at + I64{8})
        }
        os_store_i64(wrapping(pointer + size), pointer ~ ALLOC_CHECK_TAIL)
    }
    alloc_check_frames(wrapping(pointer - I64{120}), I64{10})
    if (alloc_check_tracking == I64{1} && alloc_check_track_thread()) {
        // Under the alloc lens the take also counts its allocation at its
        // call sites, timed from here (PerfSamples.jet perf_samples_alloc_site).
        began: perf_samples_alloc_began()
        lock: wrapping(alloc_root + I64{16})
        alloc_lock(lock)
        alloc_check_track(pointer)
        perf_samples_alloc_site(alloc_check_live_chain(pointer), size, began)
        alloc_unlock(lock)
    }
    observer: alloc_check_take_observer
    if (observer != I64{0}) {
        before: jet_scheduler_native_status()
        _ := coll_call3(observer, pointer, size, align)
        scheduler_hook_checks_arm(before)
    }
    pointer
}

#Export(c) priv jet_rt_alloc_check_give: fn(pointer: I64, size: I64, align: I64) -> I64 {
    if (pointer < I64{4096} || pointer & I64{7} != I64{0}) {
        alloc_check_fail(I64{2}, pointer, size, align, I64{0})
    }
    lock: wrapping(alloc_root + I64{16})
    canary := I64{0}
    alloc_lock(lock)
    #Unsafe("a checked payload's canary word precedes it; the quarantine lock orders racing frees of one block and guards the live list") {
        canary = os_load_i64(wrapping(pointer - I64{8}))
        if (canary == pointer ~ ALLOC_CHECK_LIVE) {
            os_store_i64(wrapping(pointer - I64{8}), pointer ~ ALLOC_CHECK_FREED)
            alloc_check_untrack(pointer)
        }
    }
    alloc_unlock(lock)
    if (canary == pointer ~ ALLOC_CHECK_FREED) {
        alloc_check_fail(I64{1}, pointer, size, align, I64{0})
    }
    if (canary != pointer ~ ALLOC_CHECK_LIVE) {
        alloc_check_fail(I64{2}, pointer, size, align, I64{0})
    }
    #Unsafe("the live canary proves pointer is a checked payload whose header and tail this free now owns") {
        if (os_load_i64(wrapping(pointer - I64{32})) != size || os_load_i64(wrapping(pointer - I64{40})) != align) {
            alloc_check_fail(I64{3}, pointer, size, align, I64{0})
        }
        if (os_load_i64(wrapping(pointer + size)) != pointer ~ ALLOC_CHECK_TAIL) {
            alloc_check_fail(I64{4}, pointer, size, align, size)
        }
    }
    observer: alloc_check_give_observer
    if (observer != I64{0}) {
        before: jet_scheduler_native_status()
        _ := coll_call3(observer, pointer, size, align)
        scheduler_hook_checks_arm(before)
    }
    alloc_check_frames(wrapping(pointer - I64{200}), I64{10})
    alloc_check_fill(pointer, size)
    alloc_lock(lock)
    #Unsafe("the quarantine lock owns the ring and its counters; every parked block is freed and owned by the quarantine") {
        ring: os_load_i64(wrapping(alloc_root + I64{24}))
        pushes: os_load_i64(wrapping(alloc_root + I64{32}))
        parked := os_load_i64(wrapping(alloc_root + I64{40}))
        bytes := os_load_i64(wrapping(alloc_root + I64{48}))
        loop parked > (I64{0}) && (parked == ALLOC_CHECK_SLOTS || wrapping(bytes + size) > ALLOC_CHECK_BUDGET) {
            oldest: os_load_i64(wrapping(ring + wrapping((wrapping(pushes - parked) & wrapping(ALLOC_CHECK_SLOTS - I64{1})) * I64{8})))
            alloc_check_inspect(lock, oldest)
            bytes = wrapping(bytes - os_load_i64(wrapping(oldest - I64{32})))
            parked = wrapping(parked - I64{1})
            alloc_check_retire(oldest)
        }
        os_store_i64(wrapping(ring + wrapping((pushes & wrapping(ALLOC_CHECK_SLOTS - I64{1})) * I64{8})), pointer)
        os_store_i64(wrapping(alloc_root + I64{32}), wrapping(pushes + I64{1}))
        os_store_i64(wrapping(alloc_root + I64{40}), wrapping(parked + I64{1}))
        os_store_i64(wrapping(alloc_root + I64{48}), wrapping(bytes + size))
    }
    alloc_unlock(lock)
    I64{0}
}

// A C witness's allocation observer: `on_alloc` and `on_free` are C functions
// (pointer, size, align), or 0 for none. The checked heap calls `on_alloc`
// after every allocation and `on_free` on every free it accepts, before
// poisoning the payload, so the witness sees the runtime's own allocations
// and frees too: they reach jet_rt_alloc_check_take/_give whatever their call
// site, where a link-time --wrap of jet_rt_alloc or jet_rt_free sees only
// calls bound through the symbol, never the runtime object's internal ones.
// A C host that links the runtime object runs checked
// (jet_rt_alloc_check_init); outside checked mode nothing is installed and
// this returns 0, else 1. An observer runs on the allocating or freeing
// thread with no allocator lock held; it may allocate and free (it sees
// those too), so it must not recurse unboundedly.
#Export(c) jet_rt_alloc_check_observe: fn(on_alloc: I64, on_free: I64) -> I64 {
    if (alloc_class_limit != I64{0}) { return I64{0} }
    #Unsafe("aligned whole-word stores; each checked take or give loads its observer word once") {
        alloc_check_take_observer = on_alloc
        alloc_check_give_observer = on_free
    }
    I64{1}
}

// Under the alloc lens (PerfSamples.jet perf_samples_start): arm the live
// list, which the entry starts (alloc_check_track_entry). False outside
// checked mode, which has no prefix to link through.
alloc_check_track_start: fn() -> Bool {
    if (alloc_class_limit != I64{0}) { return false }
    #Unsafe("the observation start runs before the entry; a take links a block only once the entry starts the list") {
        alloc_check_tracking = I64{2}
    }
    true
}

// At the entry (Main.jet jet_rt_main): an armed live list links every
// checked block allocated from now on, so a heap snapshot holds the blocks
// the program allocated, not the runtime's and the observation's own, which
// were taken before it. A block a take left unlinked is no block of the
// list's (alloc_check_untrack).
alloc_check_track_entry: fn() {
    if (alloc_check_tracking != I64{2}) {
        return
    }
    #Unsafe("an aligned whole-word store; a take on the observation's writer thread that loads the switch before it links no block, which its free leaves alone") {
        alloc_check_tracking = I64{1}
    }
}

// Whether the live list links blocks: the entry has started it.
alloc_check_track_on: fn() -> Bool { alloc_check_tracking == I64{1} }

// The observation writer (ObserveLive.jet jet_rt_observe_writer), as it
// starts: the live list leaves out every block it takes from now on.
alloc_check_track_skip_thread: fn() {
    base: thread_base()
    #Unsafe("an aligned whole-word store; a take that loads the word before it is a take of another thread's") {
        alloc_check_track_skipped = base
    }
}

// Whether a tracking take on this thread links its block: none of the
// observation writer's does (alloc_check_track_skip_thread), nor any of a
// thread that has no TCB yet, nor any the observation takes for its own
// state on a program's thread (alloc_check_own_enter). Those are the
// runtime's own: the thread block a new thread or a host attach takes for
// itself (Thread.jet thread_new_tcb, 1064 B) and its registry row, before GS
// names it, and the observation's task and channel rows (Observe.jet).
priv alloc_check_track_thread: fn() -> Bool {
    base := I64{0}
    own := I64{0}
    #Unsafe("GS:0 is the attached thread's TCB or, unattached, the readable zero word (thread_base); only an attached TCB's own-takes word is read") {
        base = os_tls_base_i64()
        if (base != I64{0}) { own = os_load_i64(wrapping(base + ALLOC_TCB_OWN)) }
    }
    base != I64{0} && base != alloc_check_track_skipped && own == I64{0}
}

// The TCB word counting the observation's own takes this thread is inside
// (Thread.jet's layout): while it is above 0 a take links no block on the
// live list and the alloc lens counts none.
ALLOC_TCB_OWN: I64{768}

// The observation's state on a program's thread (Observe.jet's task and
// channel rows, a task's label and its wait's name) is the observation's own,
// not the program's: from here until alloc_check_own_leave this thread's
// takes stay off the live list a heap snapshot walks and out of the alloc
// lens's count. The two nest.
alloc_check_own_enter: fn() { alloc_check_own_add(I64{1}) }

alloc_check_own_leave: fn() { alloc_check_own_add(I64{-1}) }

priv alloc_check_own_add: fn(delta: I64) {
    #Unsafe("GS:0 is the attached thread's TCB, whose own-takes word only this thread writes; an unattached thread's takes link no block, so it keeps no count") {
        base: os_tls_base_i64()
        if (base != I64{0}) {
            os_store_i64(wrapping(base + ALLOC_TCB_OWN), wrapping(os_load_i64(wrapping(base + ALLOC_TCB_OWN)) + delta))
        }
    }
}

// Link the fresh payload `pointer` at the head of the live list. The caller
// holds the quarantine lock.
priv alloc_check_track: fn(pointer: I64) {
    #Unsafe("pointer is this take's fresh checked payload, whose freeing-chain words are unused while it lives; the held quarantine lock guards the list and its blocks' link words") {
        head: alloc_check_live_head
        os_store_i64(wrapping(pointer - I64{128}), head)
        os_store_i64(wrapping(pointer - I64{136}), I64{0})
        os_store_i64(wrapping(pointer - I64{144}), I64{1})
        if (head != I64{0}) { os_store_i64(wrapping(head - I64{136}), pointer) }
        alloc_check_live_head = pointer
    }
}

// Unlink `pointer`, whose canary was live, from the live list when a take
// linked it. The caller holds the quarantine lock.
priv alloc_check_untrack: fn(pointer: I64) {
    #Unsafe("the live canary proves pointer a checked payload; the held quarantine lock guards the list and its blocks' link words") {
        if (os_load_i64(wrapping(pointer - I64{144})) == I64{1}) {
            next: os_load_i64(wrapping(pointer - I64{128}))
            previous: os_load_i64(wrapping(pointer - I64{136}))
            if (previous == I64{0}) { alloc_check_live_head = next } else {
                os_store_i64(wrapping(previous - I64{128}), next)
            }
            if (next != I64{0}) { os_store_i64(wrapping(next - I64{136}), previous) }
            os_store_i64(wrapping(pointer - I64{144}), I64{0})
        }
    }
}

// A heap snapshot's hold on the live list: the quarantine lock, which every
// tracking take and every free take, so no block joins or leaves it until
// alloc_check_track_release. The snapshot's number, from 1.
alloc_check_track_hold: fn() -> I64 {
    alloc_check_track_lock()
    #Unsafe("the held quarantine lock guards the count") {
        alloc_check_snapshots = wrapping(alloc_check_snapshots + I64{1})
    }
    alloc_check_snapshots
}

// The quarantine lock alone, which every tracking take holds while it links
// its block and counts its allocation (PerfSamples.jet
// perf_samples_alloc_site), until alloc_check_track_release.
alloc_check_track_lock: fn() { alloc_lock(wrapping(alloc_root + I64{16})) }

alloc_check_track_release: fn() { alloc_unlock(wrapping(alloc_root + I64{16})) }

// The live block after `pointer` on the live list, its first for 0, and 0
// past its end. The caller holds the list (alloc_check_track_hold), or is a
// snapshot's forked child, whose one thread is the holder.
#Unsafe("pointer is 0 or a tracked live payload of the held live list")
alloc_check_live_next: fn(pointer: I64) -> I64 {
    if (pointer == I64{0}) { return alloc_check_live_head }
    os_load_i64(wrapping(pointer - I64{128}))
}

// A tracked live block's payload size.
#Unsafe("pointer is a tracked live payload of the held live list")
alloc_check_live_size: fn(pointer: I64) -> I64 { os_load_i64(wrapping(pointer - I64{32})) }

// The address of a tracked live block's ten allocating return addresses,
// innermost first (alloc_check_frames).
alloc_check_live_chain: fn(pointer: I64) -> I64 { wrapping(pointer - I64{120}) }

// Set the live list's head word to `head` and return the head it held. A
// heap snapshot that scans the program's data for words referring to live
// blocks (PerfSamples.jet perf_samples_heap_roots) clears it first, as the
// list's own head is no reference the program holds, then puts it back.
#Unsafe("the caller holds the live list (alloc_check_track_hold), or is a snapshot's forked child, whose one thread is the holder, and puts the head back before it lets the list go")
alloc_check_live_swap: fn(head: I64) -> I64 {
    held: alloc_check_live_head
    alloc_check_live_head = head
    held
}

// A frame of the calling thread's frame pointer chain that outlives this
// call: the caller's, or the one above it when this call is inlined (the
// stub of alloc_frames_start reads rbp). 0 without the stub.
priv alloc_check_caller_frame: fn() -> I64 {
    frame := I64{0}
    #Unsafe("the frame stub (alloc_frames_start) only copies rbp to rax and returns; a missing stub leaves no chain") {
        stub: os_load_i64(wrapping(alloc_root + I64{56}))
        if (stub != I64{0}) { frame = os_call_address_i64(stub, I64{0}) }
    }
    if (frame == I64{0} || frame & I64{7} != I64{0}) { return I64{0} }
    caller := I64{0}
    #Unsafe("frame is this call's live [saved rbp][return address] pair on this thread's stack") {
        caller = stack_frame_caller(frame)
    }
    caller
}

priv alloc_check_fill: fn(pointer: I64, size: I64) {
    at := I64{0}
    #Unsafe("the freeing caller owns size payload bytes at pointer") {
        loop wrapping(at + I64{8}) <= size {
            os_store_i64(wrapping(pointer + at), ALLOC_CHECK_POISON)
            at = wrapping(at + I64{8})
        }
        loop at < size {
            os_store_u8(wrapping(pointer + at), I64{223})
            at = wrapping(at + I64{1})
        }
    }
}

// A parked block must be exactly as its free left it; any change is a write
// after free. Returns the first changed byte's offset (-8: the canary), or -1.
priv alloc_check_damage: fn(pointer: I64) -> I64 {
    #Unsafe("pointer is a parked checked payload owned by the quarantine; its header, payload and tail stay mapped until retired") {
        if (os_load_i64(wrapping(pointer - I64{8})) != pointer ~ ALLOC_CHECK_FREED) {
            return I64{-8}
        }
        size: os_load_i64(wrapping(pointer - I64{32}))
        at := I64{0}
        loop wrapping(at + I64{8}) <= size && os_load_i64(wrapping(pointer + at)) == ALLOC_CHECK_POISON {
            at = wrapping(at + I64{8})
        }
        loop at < size {
            if (os_load_u8(wrapping(pointer + at)) != I64{223}) { return at }
            at = wrapping(at + I64{1})
        }
        if (os_load_i64(wrapping(pointer + size)) != pointer ~ ALLOC_CHECK_TAIL) { return size }
    }
    I64{-1}
}

// Trap on a damaged parked block; the caller holds the quarantine lock,
// released first so the report may flush stdout (which may allocate and free).
priv alloc_check_inspect: fn(lock: I64, pointer: I64) {
    damage: alloc_check_damage(pointer)
    if (damage == I64{-1}) {
        return
    }
    alloc_unlock(lock)
    if (damage == I64{-8}) { alloc_check_fail(I64{6}, pointer, I64{0}, I64{0}, damage) }
    #Unsafe("the freed canary proved the checked header") {
        alloc_check_fail(I64{5}, pointer, os_load_i64(wrapping(pointer - I64{32})), os_load_i64(wrapping(pointer - I64{40})), damage)
    }
}

priv alloc_check_retire: fn(pointer: I64) {
    block := I64{0}
    size := I64{0}
    align := I64{0}
    #Unsafe("pointer is an inspected parked checked payload; its header still names the enclosing block and layout") {
        block = os_load_i64(wrapping(pointer - I64{16}))
        size = os_load_i64(wrapping(pointer - I64{32}))
        align = os_load_i64(wrapping(pointer - I64{40}))
    }
    bytes: wrapping(wrapping(alloc_check_prefix(align) + size) + I64{8})
    if (alloc_class(bytes, if (align < I64{8}) -> I64{8} else -> align, ALLOC_CLASS_LIMIT) == I64{0}) {
        alloc_large_give(block)
    } else { alloc_arena_give(block) }
}

// A checked payload's own heap block: an ordinary class block straight from
// an arena (no cache row), or a direct mapping.
alloc_check_block_take: fn(bytes: I64, align: I64) -> I64 {
    slot: alloc_class(bytes, align, ALLOC_CLASS_LIMIT)
    if (slot == I64{0}) -> alloc_large(bytes, align) else -> alloc_small(alloc_arena(), bytes, align, slot)
}

// Main's normal return (Main.jet jet_rt_main) inspects every block still
// parked, so a write after one of the last frees is not missed.
alloc_check_sweep: fn() {
    code: alloc_check_sweep_code
    if (alloc_class_limit != I64{0} || code == I64{0}) {
        return
    }
    _ := coll_call1(code, I64{0})
}

#Export(c) jet_rt_alloc_check_sweep: fn(_unused: I64) -> I64 {
    lock: wrapping(alloc_root + I64{16})
    alloc_lock(lock)
    #Unsafe("the quarantine lock owns the ring and its counters") {
        ring: os_load_i64(wrapping(alloc_root + I64{24}))
        pushes: os_load_i64(wrapping(alloc_root + I64{32}))
        parked: os_load_i64(wrapping(alloc_root + I64{40}))
        index := I64{0}
        loop index < parked {
            alloc_check_inspect(lock, os_load_i64(wrapping(ring + wrapping((wrapping(wrapping(pushes - parked) + index) & wrapping(ALLOC_CHECK_SLOTS - I64{1})) * I64{8}))))
            index = wrapping(index + I64{1})
        }
    }
    alloc_unlock(lock)
    I64{0}
}

alloc_check_write: fn(data: I64, length: I64) {
    at := I64{0}
    #Unsafe("data lends length readable bytes; write retains no pointer") {
        loop at < length {
            written: host_syscall(I64{1}, I64{2}, wrapping(data + at), wrapping(length - at), I64{0}, I64{0}, I64{0})
            if (written == I64{-4}) { next }
            if (written <= I64{0}) {
                return
            }
            at = wrapping(at + written)
        }
    }
}

alloc_check_say: fn(text: I64) { alloc_check_write(rt_text_data(text), rt_text_len(text)) }

alloc_check_hex: fn(value: I64) {
    alloc_write_word(I64{30768}, I64{2})
    shift := I64{60}
    loop shift > (I64{0}) && (value >> shift) & (I64{15}) == (I64{0}) {
        shift = wrapping(shift - I64{4})
    }
    loop shift >= (I64{0}) {
        digit: (value >> shift) & I64{15}
        alloc_write_word(if (digit < I64{10}) -> wrapping(I64{48} + digit) else -> wrapping(I64{87} + digit), I64{1})
        shift = wrapping(shift - I64{4})
    }
}

// A read-only private mapping of this executable's ELF file for symbol
// names, or 0: the loader's view of an image run from memory
// (HOST_AT_IMAGE), else /proc/self/exe mapped here. It and the path page are
// untracked: only the heap check's report reads them.
alloc_check_image: fn() -> I64 {
    loaded: host_getauxval(HOST_AT_IMAGE)
    if (loaded != I64{0}) { return loaded }
    path: alloc_map_try(I64{4096})
    if (path == I64{0}) { return I64{0} }
    image := I64{0}
    #Unsafe("path is a fresh private page; the image is mapped read-only and only read") {
        // "/proc/self/exe\0", little-endian.
        os_store_i64(path, I64{7310238724270485551})
        os_store_i64(wrapping(path + I64{8}), I64{111567768086124})
        fd: host_syscall(I64{257}, I64{-100}, path, I64{524288}, I64{0}, I64{0}, I64{0})
        if (fd >= I64{0}) {
            length: host_syscall(I64{8}, fd, I64{0}, I64{2}, I64{0}, I64{0}, I64{0})
            if (length > I64{64}) {
                mapped: os_map_untracked_i64(I64{0}, length, I64{1}, I64{2}, fd, I64{0})
                if (mapped > I64{0}) { image = mapped }
            }
            _ := host_syscall(I64{3}, fd, I64{0}, I64{0}, I64{0}, I64{0}, I64{0})
        }
    }
    alloc_unmap(path, I64{4096})
    image
}

// The load bias of a position-independent executable (ET_DYN): the
// start stack's AT_PHDR minus the program headers' link-time address.
// A fixed-address executable (every Jet program) has bias 0.
priv alloc_check_bias: fn(image: I64) -> I64 {
    if (image == I64{0}) { return I64{0} }
    phdr_address := I64{0}
    #Unsafe("image is a read-only private mapping of this executable's ELF64 file; its program header table lies inside it") {
        if (os_load_i64(wrapping(image + I64{16})) & I64{65535} != I64{3}) { return I64{0} }
        table: os_load_i64(wrapping(image + I64{32}))
        entry: os_load_i64(wrapping(image + I64{54})) & I64{65535}
        count: os_load_i64(wrapping(image + I64{56})) & I64{65535}
        index := I64{0}
        loop index < count {
            header: wrapping(image + wrapping(table + wrapping(index * entry)))
            kind: os_load_i64(header) & I64{4294967295}
            if (kind == I64{6}) {
                phdr_address = os_load_i64(wrapping(header + I64{16}))
                break
            }
            if (kind == I64{1} && os_load_i64(wrapping(header + I64{8})) == I64{0}) {
                phdr_address = wrapping(os_load_i64(wrapping(header + I64{16})) + table)
            }
            index = wrapping(index + I64{1})
        }
    }
    // AT_PHDR
    wrapping(host_getauxval(I64{3}) - phdr_address)
}

// Print the .symtab symbol whose range holds address (less the load bias), as
// name+0xoffset, or ?? when the image has none (a stripped binary or a
// runtime-internal function).
priv alloc_check_symbol: fn(image: I64, bias: I64, address: I64) {
    target: wrapping(address - bias)
    if (image != I64{0}) {
        #Unsafe("image is a read-only private mapping of this executable's ELF64 file; every offset read comes from its own section and symbol tables") {
            sections: wrapping(image + os_load_i64(wrapping(image + I64{40})))
            entry: os_load_i64(wrapping(image + I64{58})) & I64{65535}
            count: os_load_i64(wrapping(image + I64{60})) & I64{65535}
            index := I64{0}
            loop index < count {
                section: wrapping(sections + wrapping(index * entry))
                if (os_load_i64(wrapping(section + I64{4})) & I64{4294967295} == I64{2}) {
                    link: os_load_i64(wrapping(section + I64{40})) & I64{4294967295}
                    names: wrapping(image + os_load_i64(wrapping(wrapping(sections + wrapping(link * entry)) + I64{24})))
                    symbols: wrapping(image + os_load_i64(wrapping(section + I64{24})))
                    total: os_load_i64(wrapping(section + I64{32})) /% I64{24}
                    at := I64{0}
                    loop at < total {
                        symbol: wrapping(symbols + wrapping(at * I64{24}))
                        start: os_load_i64(wrapping(symbol + I64{8}))
                        extent: os_load_i64(wrapping(symbol + I64{16}))
                        if (extent > I64{0} && target >= start && target < wrapping(start + extent)) {
                            name: wrapping(names + (os_load_i64(symbol) & I64{4294967295}))
                            length := I64{0}
                            loop os_load_u8(wrapping(name + length)) != (I64{0}) {
                                length = wrapping(length + I64{1})
                            }
                            alloc_check_write(name, length)
                            alloc_write_word(I64{43}, I64{1})
                            alloc_check_hex(wrapping(target - start))
                            return
                        }
                        at = wrapping(at + I64{1})
                    }
                }
                index = wrapping(index + I64{1})
            }
        }
    }
    alloc_write_word(I64{16191}, I64{2})
}

// One line per nonzero return address of a recorded chain of `count` words.
priv alloc_check_chain: fn(image: I64, bias: I64, words: I64, count: I64) {
    index := I64{0}
    loop index < count {
        address := I64{0}
        #Unsafe("words lends count readable chain words") {
            address = os_load_i64(wrapping(words + wrapping(index * I64{8})))
        }
        if (address == I64{0}) {
            return
        }
        alloc_write_word(I64{538976288}, I64{4})
        alloc_check_hex(address)
        alloc_write_word(I64{32}, I64{1})
        alloc_check_symbol(image, bias, address)
        alloc_write_word(I64{10}, I64{1})
        index = wrapping(index + I64{1})
    }
}

alloc_check_layout: fn(size: I64, align: I64) {
    alloc_check_say(rt_static_text(" ("))
    alloc_write_size(size)
    alloc_check_say(rt_static_text(" bytes, align "))
    alloc_write_size(align)
    alloc_check_say(rt_static_text(")"))
}

// Report a checked-heap violation and abort. kind: 1 double free, 2 free of
// a pointer this heap never handed out (or whose header was overwritten),
// 3 free with another layout, 4 write past the end, 5 write after free into
// the payload or tail (at byte `offset`), 6 write after free over the header.
priv alloc_check_fail: fn(kind: I64, pointer: I64, size: I64, align: I64, offset: I64) {
    jet_rt_stdout_flush()
    image: alloc_check_image()
    bias: alloc_check_bias(image)
    alloc_check_say(rt_static_text("jet checked allocator: "))
    if (kind == I64{1}) {
        alloc_check_say(rt_static_text("double free of "))
        alloc_check_hex(pointer)
        alloc_check_layout(size, align)
    } else if (kind == I64{2}) {
        alloc_check_say(rt_static_text("free of "))
        alloc_check_hex(pointer)
        alloc_check_layout(size, align)
        alloc_check_say(rt_static_text(", which this heap never handed out or whose header was overwritten"))
    } else if (kind == I64{3}) {
        alloc_check_say(rt_static_text("free of "))
        alloc_check_hex(pointer)
        alloc_check_layout(size, align)
        alloc_check_say(rt_static_text(", allocated as"))
        #Unsafe("the live canary proved the checked header") {
            alloc_check_layout(os_load_i64(wrapping(pointer - I64{32})), os_load_i64(wrapping(pointer - I64{40})))
        }
    } else if (kind == I64{4}) {
        alloc_check_say(rt_static_text("write past the end of "))
        alloc_check_hex(pointer)
        alloc_check_layout(size, align)
        alloc_check_say(rt_static_text(", found at its free"))
    } else if (kind == I64{5}) {
        alloc_check_say(rt_static_text("write after free into "))
        alloc_check_hex(pointer)
        alloc_check_layout(size, align)
        alloc_check_say(rt_static_text(" at byte offset "))
        alloc_write_size(offset)
    } else {
        alloc_check_say(rt_static_text("write after free over the header of "))
        alloc_check_hex(pointer)
    }
    alloc_check_say(rt_static_text("\n  at:\n"))
    // A dying path's scratch: untracked, no checked code reads it.
    scratch: alloc_map_try(I64{4096})
    if (scratch != I64{0}) {
        alloc_check_frames(scratch, I64{24})
        alloc_check_chain(image, bias, scratch, I64{24})
    }
    if (kind != I64{2} && kind != I64{6}) {
        if (kind == I64{1}) {
            alloc_check_say(rt_static_text("  first freed at:\n"))
            alloc_check_chain(image, bias, wrapping(pointer - I64{200}), I64{10})
        } else if (kind == I64{5}) {
            alloc_check_say(rt_static_text("  freed at:\n"))
            alloc_check_chain(image, bias, wrapping(pointer - I64{200}), I64{10})
        }
        alloc_check_say(rt_static_text("  allocated at:\n"))
        alloc_check_chain(image, bias, wrapping(pointer - I64{120}), I64{10})
    }
    alloc_abort()
}

// Write a little-endian packed literal without a String/list carrier or a
// mapping. The checked count bounds the stack word borrowed by the OS leaf.
// Raw, not through HostProcess.jet's gate: the allocator's GS failure
// reaches this, where a counted call's clock read through GS would fault.
alloc_write_word: fn(word: I64, count: I64) {
    if (count < I64{0} || count > I64{8}) {
        return
    }
    remaining := count
    bytes := word
    #Unsafe("remaining is in 1..=8, so write borrows only the initialized stack word; a short write advances within it") {
        loop remaining > (I64{0}) {
            written: os_write_word_i64(I64{2}, bytes, remaining)
            if (written == I64{-4}) { next }
            if (written <= I64{0}) {
                return
            }
            remaining = wrapping(remaining - written)
            // Byte by byte: a constant shift cannot stop, so this raw path
            // links no shift-stop report.
            dropped := I64{0}
            loop dropped < written {
                bytes = bytes >> I64{8}
                dropped = wrapping(dropped + I64{1})
            }
        }
    }
}

// Emit decimal digits most-significant first without allocating a buffer.
// Digits come from subtraction and constant divisors only: a variable divisor
// could stop, and its stop report would link the whole program-stop path
// into every allocating program.
alloc_write_size: fn(size: I64) {
    scale := I64{1}
    loop scale <= size /% (I64{10}) -> scale = wrapping(scale * I64{10})
    remaining := size
    loop scale > (I64{0}) {
        digit := I64{0}
        loop remaining >= scale {
            remaining = wrapping(remaining - scale)
            digit = wrapping(digit + I64{1})
        }
        alloc_write_word(wrapping(I64{48} + digit), I64{1})
        scale = scale /% I64{10}
    }
}

alloc_out_of_memory: fn(size: I64) {
    // std.alloc.handle_alloc_error: \"memory allocation of N bytes failed\\n\"
    // followed by SIGABRT, not a Jet program-stop exit status.
    alloc_write_word(I64{6998727353336423789}, I64{8})
    alloc_write_word(I64{8028075772393516140}, I64{8})
    alloc_write_word(I64{139157512302}, I64{5})
    alloc_write_size(size)
    alloc_write_word(I64{7359008670706393632}, I64{8})
    alloc_write_word(I64{11426314611041}, I64{6})
    alloc_abort()
}

// One process-abort mechanism for allocation failure and panic in cleanup.
// The live Secrets are scrubbed first: a core dump must not hold them.
alloc_abort: fn() {
    secret_scrub()
    // The signal is thread-directed (tgkill, as libc raise does): a
    // process-directed kill from a task thread may land on another thread,
    // and this thread would reach the exit fallback before the core dump ends it.
    // Raw, not through HostProcess.jet's gate: the process's last calls,
    // which may come from any thread in any state.
    #Unsafe("the stack-word syscalls unblock SIGABRT and, if necessary, restore its default disposition before raising it again; no heap pointer is needed") {
        pid: os_syscall_i64(I64{39}, I64{0}, I64{0}, I64{0}, I64{0}, I64{0}, I64{0})
        tid: os_syscall_i64(I64{186}, I64{0}, I64{0}, I64{0}, I64{0}, I64{0}, I64{0})
        _ := os_syscall_stack4_i64(I64{14}, I64{1}, I64{32}, I64{0}, I64{0}, I64{0}, I64{8})
        _ := os_syscall_i64(I64{234}, pid, tid, I64{6}, I64{0}, I64{0}, I64{0})
        _ := os_syscall_stack4_i64(I64{13}, I64{6}, I64{0}, I64{0}, I64{0}, I64{0}, I64{8})
        _ := os_syscall_i64(I64{234}, pid, tid, I64{6}, I64{0}, I64{0}, I64{0})
        _ := os_syscall_i64(I64{231}, I64{127}, I64{0}, I64{0}, I64{0}, I64{0}, I64{0})
    }
    loop {

    }
}
