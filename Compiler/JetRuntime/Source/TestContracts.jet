// The contract sites a native test run observed: `jet prove`'s contract
// evidence. In a test image every checked `#Pre`/`#Post` clause reports each
// hold and each failure with its static site text (IR BuildContracts.jet
// ir_contract). The first hold of a site, and every failure, append
// `JET_NATIVE_CONTRACT <held> <length>\n<site>\n` to the records file the
// harness opened (BuildTests.jet), so a child that later dies keeps what it
// saw. A failure stops its test or region, so failures are few; each is
// written so the parent can tie a serial test's stop to the clause that made
// it (NativeTests.jet). A later hold of the same site costs one table probe
// under the lock. Tasks a test spawns may check clauses on other threads.
// Root40: lock0, path8 (owned String), sites16 ([site data address, seen bits]
// pairs, open addressing), capacity24 (a power of two), count32.
test_contract_root := I64{0}

// The harness main opens the run's records file once, before any test runs.
#Export(c) fn jet_rt_test_contracts_open(path: I64) {
    if (test_contract_root != I64{0}) -> return
    root :: jet_rt_alloc(I64{40}, I64{8})
    thread_zero(root, I64{40})
    trap_store(wrapping(root + I64{8}), test_text_clone(path))
    capacity :: I64{64}
    sites :: jet_rt_alloc(capacity * I64{16}, I64{8})
    thread_zero(sites, capacity * I64{16})
    trap_store(wrapping(root + I64{16}), sites)
    trap_store(wrapping(root + I64{24}), capacity)
    #Unsafe("the harness main opens contracts before any test, so before any other thread observes one") {
        test_contract_root = root
    }
}

// One observation of the clause whose site text is `data`/`length`: `held`
// when its condition was true. A run with no records file records nothing.
#Export(c) fn jet_rt_test_contract(data: I64, length: I64, held: Bool) {
    root :: test_contract_root
    if (root == I64{0}) -> return
    sync_mutex_lock(root)
    if held {
        entry :: test_contract_entry(root, data)
        if (trap_word(wrapping(entry + I64{8})) != I64{0}) {
            sync_mutex_unlock(root)
            return
        }
        trap_store(wrapping(entry + I64{8}), I64{1})
    }
    test_contract_append(trap_word(wrapping(root + I64{8})), data, length, held)
    sync_mutex_unlock(root)
}

// The site's [key, seen] pair, inserted unseen when absent; the table doubles
// before it is half full. The caller holds the lock.
fn test_contract_entry(root: I64, key: I64) -> I64 {
    if ((trap_word(wrapping(root + I64{32})) + I64{1}) * I64{2} > trap_word(wrapping(root + I64{24}))) -> test_contract_grow(root)
    sites :: trap_word(wrapping(root + I64{16}))
    mask :: trap_word(wrapping(root + I64{24})) - I64{1}
    index := test_contract_hash(key).bit_and(mask)
    loop {
        entry :: wrapping(sites + index * I64{16})
        found :: trap_word(entry)
        if (found == key) -> return entry
        if (found == I64{0}) {
            trap_store(entry, key)
            trap_store(wrapping(entry + I64{8}), I64{0})
            trap_store(wrapping(root + I64{32}), trap_word(wrapping(root + I64{32})) + I64{1})
            return entry
        }
        index = (index + I64{1}).bit_and(mask)
    }
    I64{0}
}

fn test_contract_hash(key: I64) -> I64 {
    // Static data addresses are 8-aligned; fold the high bits into the low.
    mixed :: key.bit_xor(key >> I64{17})
    (mixed >> I64{3}).bit_and(I64{9223372036854775807})
}

fn test_contract_grow(root: I64) {
    old_sites :: trap_word(wrapping(root + I64{16}))
    old_capacity :: trap_word(wrapping(root + I64{24}))
    capacity :: old_capacity * I64{2}
    sites :: jet_rt_alloc(capacity * I64{16}, I64{8})
    thread_zero(sites, capacity * I64{16})
    mask :: capacity - I64{1}
    at := I64{0}
    loop at < old_capacity {
        old :: wrapping(old_sites + at * I64{16})
        key :: trap_word(old)
        if (key != I64{0}) {
            index := test_contract_hash(key).bit_and(mask)
            loop {
                if (trap_word(wrapping(sites + index * I64{16})) == I64{0}) -> break
                index = (index + I64{1}).bit_and(mask)
            }
            entry :: wrapping(sites + index * I64{16})
            trap_store(entry, key)
            trap_store(wrapping(entry + I64{8}), trap_word(wrapping(old + I64{8})))
        }
        at += I64{1}
    }
    jet_rt_free(old_sites, old_capacity * I64{16}, I64{8})
    trap_store(wrapping(root + I64{16}), sites)
    trap_store(wrapping(root + I64{24}), capacity)
}

// Appends the site's record; a write failure is a protocol failure (exit
// 103), as for the harness's own records (BuildTests.jet ir_test_append).
fn test_contract_append(path: I64, data: I64, length: I64, held: Bool) {
    head :: rt_static_text("JET_NATIVE_CONTRACT ")
    head_len :: trap_word(wrapping(head + I64{8}))
    // The head, the held digit, a space, at most 19 length digits, two '\n'.
    record :: test_text_new(head_len + I64{23} + length)
    out :: trap_word(record)
    test_copy_bytes(out, trap_word(head), head_len)
    used := head_len
    trap_put(wrapping(out + used), if held -> I64{49} else -> I64{48})
    trap_put(wrapping(out + used + I64{1}), I64{32})
    used += I64{2}
    used += test_decimal_bytes(wrapping(out + used), length)
    trap_put(wrapping(out + used), I64{10})
    used += I64{1}
    test_copy_bytes(wrapping(out + used), data, length)
    used += length
    trap_put(wrapping(out + used), I64{10})
    used += I64{1}
    trap_store(wrapping(record + I64{8}), used)
    error :: jet_rt_alloc(I64{8}, I64{8})
    trap_store(error, I64{0})
    if (jet_rt_test_append(path, record, error) == I64{0}) {
        message :: jet_rt_handle_show_io_error(trap_word(error))
        jet_rt_test_eprint(message)
        jet_std_process_exit_owned(I64{103})
    }
    jet_rt_free(error, I64{8}, I64{8})
    test_text_drop(record)
}
