// Jet threads and dynamic TLS. GS belongs exclusively to Jet; FS remains
// musl's TLS until libc exit. The interim pthread imports die when musl leaves
// the pack (U4 end); raw clone is implemented below but used only by fixtures.
// TCB (context_tcb_bytes(), align64), append-only runtime layout; owner per slot:
// @0 Thread self; @8 Thread tid; @16 Scheduler current control;
// @24 Scheduler shield; @32 Scheduler wait boundary; @40 Deadline boundary;
// @48 Context current record pointer; @56 Fiber running on this TCB (0 on a
// plain thread); @64 Scheduler native body active;
// @72 Sync park slot; @80 Task completion frames List*;
// @88 Thread live-registry row (thread_register_tcb); @96 Deadline owner deadlines;
// @104 World current lease; @112 World flags; @120 World park slot;
// @128 Sentry enabled; @136 Sentry file; @144 Sentry file length;
// @152 Sentry line; @160 Sentry reason; @168 Sentry reason length;
// @176 Sentry fence depth; @184 Sentry frames List*; @192 reserved;
// @200 Comptime request-scope flag; @208 Thread dynamic TLS List<I64>*
// (also owns T1 capture/scope services); @216/@224 Sync absolute futex
// timespec; @232/@240 Sync/HostIO clock_gettime timespec scratch;
// @248 Scheduler shared scratch word (worker-count out).
// Appended Comptime frame: @256 depth, @264 owner, @272 start, @280 end,
// all raw U64 bit carriers. Comptime scope saves Scheduler's four words at
// @288 previous control, @296 shield, @304 wait boundary, @312 body active.
// Appended Alloc thread cache: @320 + 16 per class 32..4096, each
// [cached head block][cached count] (Alloc.jet alloc_cache_row); @448 root Context record.
// Slot200 provenance: before this append, the 26b5c5911 source map reserves
// 192/200. Searching I64{192}/I64{200} across Thread, Scheduler, Task,
// TaskGroup, Deadline, World, TestCapture and Sync finds no TCB access:
// Task's matches concern its separate 200-byte child, not the TCB.
// RtL8a6 confirms no T1/Thread claim on either reserved slot. Attach before
// the first GS read, never lazily from TLS: GS of an unattached thread
// points at the allocator's zero word (thread_detached_base), so
// thread_base() reads 0 there instead of faulting, and only the allocator
// tests for that zero.
#Import(c) thread_pthread_create: fn(out: I64, attr: I64, start: I64, arg: I64) -> I64 = "pthread_create"
#Import(c) thread_pthread_join: fn(thread: I64, out: I64) -> I64 = "pthread_join"
#Import(c) thread_pthread_detach: fn(thread: I64) -> I64 = "pthread_detach"
#Import(c) thread_pthread_attr_init: fn(attr: I64) -> I64 = "pthread_attr_init"
#Import(c) thread_pthread_attr_setstacksize: fn(attr: I64, size: I64) -> I64 = "pthread_attr_setstacksize"
#Import(c) thread_pthread_attr_destroy: fn(attr: I64) -> I64 = "pthread_attr_destroy"

// Process lifetime root: mutex@0, atomic next-key counter@8, destructor native
// List header@16, scope native List header@40 (0 thread, 1 attempt),
// live-TCB native List<I64> header@64 containing [tid,tcb,...] word pairs
// (a fiber's pair is [tcb,tcb], Fiber.jet), the atomic count@88 of threads
// thread_spawn started that have not registered yet, and the fork gate@96.
// All headers use [len@0,cap@8,data@16]. Root is 104 bytes; closures transfer
// to the registry for key lifetime. No inherited GS pointer is dereferenced.
thread_tls_registry := I64{0}

// The TCB word holding its live-registry row (layout above).
THREAD_TCB_ROW: I64{88}

// The root word counting spawned threads not yet in the live registry.
THREAD_SPAWNING: I64{88}

// The root word of the fork gate (thread_fork_gate_hold).
THREAD_FORK_GATE: I64{96}

// The fork gate's count of a fork that holds it or waits for it: above any
// count of sharing threads, inside the 32 bits a futex observes.
THREAD_FORK_GATE_HELD: I64{1073741824}

// Zero `bytes` bytes at a word-aligned address. A byte list's capacity need
// not be a word multiple, so whole words go first and the tail goes bytewise:
// no store passes `bytes`.
thread_zero: fn(address: I64, bytes: I64) {
    at := I64{0}
    loop bytes - at >= (I64{8}) {
        sync_store(wrapping(address + at), I64{0})
        at += I64{8}
    }
    loop at < bytes {
        rt_text_put(wrapping(address + at), I64{0})
        at += I64{1}
    }
}

thread_base: fn() -> I64 {
    #Unsafe("every caller has attached before running Jet TLS code; an unattached thread's GS names the readable zero word, which the allocator alone treats as no TCB") {
        return os_tls_base_i64()
    }
}

// The GS target of a thread without a TCB: the allocator state page's zero
// word (Alloc.jet). jet_rt_alloc_init installs it for the initializing thread.
thread_detached_base: fn() -> I64 { alloc_root }

thread_set_base: fn(base: I64) {
    #Unsafe("GS is reserved for Jet and base is a live self-addressed TCB or the detached zero word") {
        status: os_syscall_i64(I64{158}, I64{4097}, base, I64{0}, I64{0}, I64{0}, I64{0})
        if (status != I64{0}) { trap_gs_failure() }
    }
}

thread_tid: fn() -> I64 {
    #Unsafe("gettid identifies this thread without reading its inherited GS") {
        return os_syscall_i64(I64{186}, I64{0}, I64{0}, I64{0}, I64{0}, I64{0}, I64{0})
    }
}

thread_new_tcb: fn(tid: I64) -> I64 {
    tcb: jet_rt_alloc(context_tcb_bytes(), I64{64})
    thread_zero(tcb, context_tcb_bytes())
    context_tcb_install_root(tcb)
    sync_store(tcb, tcb)
    sync_store(wrapping(tcb + I64{8}), tid)
    tcb
}

// Registry mutex is held. These are native List<I64> words, two per thread;
// the TCB's @88 holds its row's first word index, so unregistering is O(1).
thread_register_tcb: fn(tid: I64, tcb: I64) {
    live: wrapping(thread_tls_registry + I64{64})
    count: sync_load(live)
    thread_words_grow(live, count + I64{2})
    data: sync_load(wrapping(live + I64{16}))
    sync_store(wrapping(data + count * I64{8}), tid)
    sync_store(wrapping(data + (count + I64{1}) * I64{8}), tcb)
    sync_store(wrapping(tcb + THREAD_TCB_ROW), count)
    sync_store(live, count + I64{2})
}

// Bootstrap is exclusively for a newly spawned thread. Its inherited GS can
// point to a parent's already-freed TCB; never read that base or its memory.
#Export(c) jet_rt_thread_bootstrap: fn() {
    // Even an allocation failure must not let a trap read inherited GS.
    thread_set_base(thread_detached_base())
    tid: thread_tid()
    thread_sole_check(tid)
    tcb: thread_new_tcb(tid)
    sync_mutex_lock(thread_tls_registry)
    thread_register_tcb(tid, tcb)
    sync_mutex_unlock(thread_tls_registry)
    thread_set_base(tcb)
}

// A thread other than the process's main one is about to run Jet code: lock
// elision ends (Sync.jet sync_sole_end).
thread_sole_check: fn(tid: I64) {
    if (sync_sole == I64{0}) -> return
    pid := I64{0}
    #Unsafe("getpid retains no memory") {
        pid = os_syscall_i64(I64{39}, I64{0}, I64{0}, I64{0}, I64{0}, I64{0}, I64{0})
    }
    if (tid != pid) -> sync_sole_end()
}

// Host callers MUST pair explicit attach with detach before thread exit.
// Otherwise a recycled Linux tid could match a stale live-registry row.
#Export(c) jet_rt_thread_attach: fn() {
    // This path may also allocate; clear a foreign/inherited base first.
    thread_set_base(thread_detached_base())
    // Explicit host attach and repeated attach use only live registry records.
    // Linux gettid is the lookup key; a copied/stale GS base is irrelevant.
    tid: thread_tid()
    thread_sole_check(tid)
    sync_mutex_lock(thread_tls_registry)
    live: wrapping(thread_tls_registry + I64{64})
    count: sync_load(live)
    data: sync_load(wrapping(live + I64{16}))
    at := I64{0}
    loop at < count {
        if (sync_load(wrapping(data + at * I64{8})) == tid) {
            tcb: sync_load(wrapping(data + (at + I64{1}) * I64{8}))
            sync_mutex_unlock(thread_tls_registry)
            thread_set_base(tcb)
            return
        }
        at += I64{2}
    }
    tcb: thread_new_tcb(tid)
    thread_register_tcb(tid, tcb)
    sync_mutex_unlock(thread_tls_registry)
    thread_set_base(tcb)
}

// Moves the last row into the TCB's row.
thread_unregister_tcb: fn(tcb: I64) {
    sync_mutex_lock(thread_tls_registry)
    live: wrapping(thread_tls_registry + I64{64})
    data: sync_load(wrapping(live + I64{16}))
    at: sync_load(wrapping(tcb + THREAD_TCB_ROW))
    last: sync_load(live) - I64{2}
    if at < last {
        moved: sync_load(wrapping(data + (last + I64{1}) * I64{8}))
        sync_store(wrapping(data + at * I64{8}), sync_load(wrapping(data + last * I64{8})))
        sync_store(wrapping(data + (at + I64{1}) * I64{8}), moved)
        sync_store(wrapping(moved + THREAD_TCB_ROW), at)
    }
    sync_store(live, last)
    sync_mutex_unlock(thread_tls_registry)
}

// A hook only of a program that links Jet TLS (its registry) or the
// allocator's cached front doors (Alloc.jet alloc_cache_linked). A process
// root (Main.jet jet_rt_main) calls this too, so every rooted program keeps
// it, and so does the main of a program that owns its main and calls a
// route that reads its thread block without allocating (JetIR
// EntryOwned.jet IR_OWNED_ATTACH_ROUTES). Any other program that owns its
// main reads no thread block: its traps find the report domain by probe
// (Scheduler.jet scheduler_report_base), so its main thread stays on the
// detached zero word jet_rt_alloc_init installs. Repeating it is harmless:
// the attach finds the thread's live block.
// runtime-init: 2 when thread_tls_registry,alloc_cache_linked
#Export(c) jet_rt_thread_init: fn() {
    // Runtime-object .init_array priority follows allocator and host init.
    if (thread_tls_registry == I64{0}) {
        #Unsafe("runtime-init runs before any other thread exists") {
            thread_tls_registry = jet_rt_alloc(I64{104}, I64{8})
        }
        thread_zero(thread_tls_registry, I64{104})
    }
    jet_rt_thread_attach()
}

// Word-only native List growth: no Core List indexing or exact-Int carrier.
thread_words_grow: fn(header: I64, needed: I64) {
    capacity: sync_load(wrapping(header + I64{8}))
    if needed <= capacity {
        return
    }
    next := if (capacity == I64{0}) -> I64{8} else -> capacity
    loop next < needed -> next = next * I64{2}
    data: jet_rt_alloc(next * I64{8}, I64{8})
    thread_zero(data, next * I64{8})
    old: sync_load(wrapping(header + I64{16}))
    count: sync_load(header)
    at := I64{0}
    loop at < count {
        sync_store(wrapping(data + at * I64{8}), sync_load(wrapping(old + at * I64{8})))
        at += I64{1}
    }
    sync_store(wrapping(header + I64{16}), data)
    sync_store(wrapping(header + I64{8}), next)
    if (capacity != I64{0}) { jet_rt_free(old, capacity * I64{8}, I64{8}) }
}

// Called only with the registry mutex held, so both parallel tables publish
// together and a site's shared-key setup can reserve exactly one key.
thread_tls_key_new_locked: fn(destructor: I64, scope: I64) -> I64 {
    root: thread_tls_registry
    key: sync_add(wrapping(root + I64{8}), I64{1}) + I64{1}
    header: wrapping(root + I64{16})
    scopes: wrapping(root + I64{40})
    thread_words_grow(header, key)
    thread_words_grow(scopes, key)
    sync_store(wrapping(sync_load(wrapping(header + I64{16})) + (key - I64{1}) * I64{8}), destructor)
    sync_store(wrapping(sync_load(wrapping(scopes + I64{16})) + (key - I64{1}) * I64{8}), scope)
    sync_store(header, key)
    sync_store(scopes, key)
    key
}

#Export(c) jet_rt_tls_key_new: fn(destructor: I64) -> I64 {
    sync_mutex_lock(thread_tls_registry)
    key: thread_tls_key_new_locked(destructor, I64{0})
    sync_mutex_unlock(thread_tls_registry)
    key
}

#Export(c) jet_rt_tls_shared_destructor: fn(_header: I64, value: I64) -> I64 {
    jet_rt_native_shared_drop(value)
    I64{0}
}

// Same runtime-only checked FunctionAddress table as rt_thread_entry_address.
rt_tls_shared_destructor_address: fn() -> I64 {
    loop { jet_rt_unreachable(I64{0}, I64{0}) }
}

// A declaration's site always supplies its stable lifetime scope:
// 0 = thread exit only, 1 = attempt reset as well as thread exit.
#Export(c) jet_rt_tls_shared_key: fn(site: I64, scope: I64) -> I64 {
    existing: sync_load(site)
    if (existing != I64{0}) { return existing }
    sync_mutex_lock(thread_tls_registry)
    key := sync_load(site)
    if (key == I64{0}) {
        closure: jet_rt_alloc(I64{24}, I64{8})
        sync_store(closure, I64{1})
        sync_store(wrapping(closure + I64{8}), rt_tls_shared_destructor_address())
        sync_store(wrapping(closure + I64{16}), I64{0})
        key = thread_tls_key_new_locked(closure, scope)
        sync_store(site, key)
    }
    sync_mutex_unlock(thread_tls_registry)
    key
}

thread_tls_destroy: fn(table: I64, key: I64, attempt_only: Bool) -> Bool {
    value: sync_load(wrapping(sync_load(wrapping(table + I64{16})) + (key - I64{1}) * I64{8}))
    if (value == I64{0}) { return false }
    sync_mutex_lock(thread_tls_registry)
    closure: sync_load(wrapping(sync_load(wrapping(thread_tls_registry + I64{32})) + (key - I64{1}) * I64{8}))
    scope: sync_load(wrapping(sync_load(wrapping(thread_tls_registry + I64{56})) + (key - I64{1}) * I64{8}))
    sync_mutex_unlock(thread_tls_registry)
    if (attempt_only && scope != I64{1}) { return false }
    // Clear first: a destructor can reenter reset_attempt without double-drop.
    // Reload data on every key because a destructor may grow its TLS table.
    sync_store(wrapping(sync_load(wrapping(table + I64{16})) + (key - I64{1}) * I64{8}), I64{0})
    if (closure != I64{0}) {
        #Unsafe("the registry owns this live closure header whose code accepts header and one I64 value") {
            _ := os_call_address_two_i64(sync_load(wrapping(closure + I64{8})), closure, value)
        }
        return true
    }
    false
}

#Export(c) jet_rt_tls_reset_attempt: fn() {
    table: sync_load(wrapping(thread_base() + I64{208}))
    if (table == I64{0}) {
        return
    }
    key := sync_load(table)
    loop key > (I64{0}) {
        _ := thread_tls_destroy(table, key, true)
        key -= I64{1}
    }
}

#Export(c) jet_rt_tls_get: fn(key: I64) -> I64 {
    table: sync_load(wrapping(thread_base() + I64{208}))
    if (table == I64{0} || key <= I64{0}) { return I64{0} }
    if key > sync_load(table) -> return I64{0}
    sync_load(wrapping(sync_load(wrapping(table + I64{16})) + (key - I64{1}) * I64{8}))
}

#Export(c) jet_rt_tls_set: fn(key: I64, value: I64) {
    if (key <= I64{0} || key > sync_load(wrapping(thread_tls_registry + I64{8}))) {
        jet_rt_unreachable(I64{0}, I64{0})
    }
    tcb: thread_base()
    table := sync_load(wrapping(tcb + I64{208}))
    if (table == I64{0}) {
        table = jet_rt_alloc(I64{24}, I64{8})
        thread_zero(table, I64{24})
        sync_store(wrapping(tcb + I64{208}), table)
    }
    thread_words_grow(table, key)
    if key > sync_load(table) -> sync_store(table, key)
    sync_store(wrapping(sync_load(wrapping(table + I64{16})) + (key - I64{1}) * I64{8}), value)
}

#Export(c) jet_rt_thread_detach: fn() {
    tcb: thread_base()
    scheduler_thread_detach()
    thread_tls_teardown(tcb)
    sentry_thread_detach()
    // Every destructor above has run its last free: return the cache before
    // the TCB that holds it goes away, then release the TCB on the locked path.
    alloc_cache_flush()
    thread_unregister_tcb(tcb)
    thread_set_base(thread_detached_base())
    jet_rt_free(tcb, context_tcb_bytes(), I64{64})
}

// Runs the destructors of the TCB's TLS values and frees its table: a
// thread's detach and a fiber's teardown (Fiber.jet) on the TCB itself.
thread_tls_teardown: fn(tcb: I64) {
    table: sync_load(wrapping(tcb + I64{208}))
    if (table == I64{0}) -> return
    // Match musl pthread_key destructors: PTHREAD_DESTRUCTOR_ITERATIONS
    // is 4 (musl src/thread/pthread_key_create.c). Each pass sees
    // keys installed by the previous pass; values rearmed after the fourth
    // pass are left undestroyed, exactly as pthread termination permits.
    pass := I64{0}
    loop pass < (I64{4}) {
        invoked := false
        key := sync_load(table)
        loop key > (I64{0}) {
            if thread_tls_destroy(table, key, false) -> invoked = true
            key -= I64{1}
        }
        if !invoked -> break
        pass += I64{1}
    }
    jet_rt_free(sync_load(wrapping(table + I64{16})), sync_load(wrapping(table + I64{8})) * I64{8}, I64{8})
    jet_rt_free(table, I64{24}, I64{8})
    sync_store(wrapping(tcb + I64{208}), I64{0})
}

// RuntimeLower alone replaces this body with FunctionAddress of the checked
// #Export(c) jet_rt_thread_entry. It refuses a missing/non-word/non-C entry;
// this body must never reach execution or ordinary function-body lowering.
rt_thread_entry_address: fn() -> I64 {
    loop { jet_rt_unreachable(I64{0}, I64{0}) }
}

#Export(c) jet_rt_thread_entry: fn(start: I64) -> I64 {
    jet_rt_thread_bootstrap()
    thread_spawn_settled()
    // This thread's alternate signal stack, for the fault report (Fault.jet).
    fault_stack: fault_stack_start()
    entry: sync_load(start)
    argument: sync_load(wrapping(start + I64{8}))
    jet_rt_free(start, I64{16}, I64{8})
    result := I64{0}
    #Unsafe("the caller transferred a System V I64->I64 code address and one argument to this thread") {
        result = os_call_address_i64(entry, argument)
    }
    fault_stack_end(fault_stack)
    jet_rt_thread_detach()
    result
}

// The soft limit of rlimit `resource`; -1 when it has none (RLIM_INFINITY
// reads as -1), the call fails, or a comptime child asks (no host probe).
thread_rlimit_soft: fn(resource: I64) -> I64 {
    scratch: jet_rt_alloc(I64{16}, I64{8})
    thread_zero(scratch, I64{16})
    status := I64{-1}
    #Unsafe("getrlimit writes its two-word record into the owned 16-byte scratch and retains no pointer") {
        status = if comptime_serving() -> I64{-1} else -> os_syscall_i64(I64{97}, resource, scratch, I64{0}, I64{0}, I64{0}, I64{0})
    }
    soft: sync_load(scratch)
    jet_rt_free(scratch, I64{16}, I64{8})
    if (status != I64{0}) -> return I64{-1}
    soft
}

// Rust scheduler worker stack: CompilerStack::COMPILER_STACK_SIZE = 192 MiB.
// A larger soft RLIMIT_STACK (the native compiler stages run under prlimit,
// since O0 frames are larger than Rust's) also sizes every runtime thread, so
// work moved onto a scheduler worker gets the main thread's recursion budget.
// RLIM_INFINITY, failures and a comptime child (no host probe) keep 192 MiB; capped at 8 GiB.
// Under a finite RLIMIT_AS (a memory_limit, a capped check) no stack takes
// more than a THREAD_STACK_SPACE_SHARE-th of the address space (at least
// THREAD_STACK_FLOOR), so the carriers' and fibers' stacks leave the heap its
// room, which one RLIMIT_STACK-sized stack per thread and fiber would not.
thread_stack_bytes: fn() -> I64 {
    soft: thread_rlimit_soft(I64{3})
    bytes := if (soft <= I64{201326592}) -> I64{201326592} else if (soft > I64{8589934592}) -> I64{8589934592} else -> soft
    space: thread_rlimit_soft(I64{9})
    if (space > I64{0}) {
        share: (space / THREAD_STACK_SPACE_SHARE).bit_and(I64{-4096})
        if share < bytes -> bytes = if share > THREAD_STACK_FLOOR -> share else -> THREAD_STACK_FLOOR
    }
    bytes
}

// The smallest stack thread_spawn falls back to.
THREAD_STACK_FLOOR: I64{1048576}
// Under a finite RLIMIT_AS a stack takes at most a hundredth of it: 204 MiB
// of a 20 GiB cap, as much as an uncapped thread's 192 MiB.
THREAD_STACK_SPACE_SHARE: I64{100}

// musl pthread_attr_t is 56 bytes on x86-64; 64-byte storage is conservative.
// Returns pthread_t on success, negative pthread errno on failure. A stack
// musl cannot map (EAGAIN, as under a tight RLIMIT_AS: Process memory_limit)
// is retried at half the size, down to THREAD_STACK_FLOOR, so a thread still
// starts in a process that has address space left for a smaller stack.
thread_spawn: fn(entry: I64, argument: I64) -> I64 {
    sync_sole_end()
    storage: jet_rt_alloc(I64{72}, I64{8})
    thread_zero(storage, I64{72})
    attr: storage + I64{8}
    status := thread_pthread_attr_init(attr)
    if (status != I64{0}) {
        jet_rt_free(storage, I64{72}, I64{8})
        return -status
    }
    bytes := thread_stack_bytes()
    status = thread_pthread_attr_setstacksize(attr, bytes)
    start := I64{0}
    if (status == I64{0}) {
        start = jet_rt_alloc(I64{16}, I64{8})
        sync_store(start, entry)
        sync_store(wrapping(start + I64{8}), argument)
        // Counted before the clone, so a synccall (thread_setxid) waits
        // until the new thread is in the live registry.
        _ := sync_add(wrapping(thread_tls_registry + THREAD_SPAWNING), I64{1})
        thread_fork_gate_share(thread_tls_registry)
        loop {
            status = thread_pthread_create(storage, attr, rt_thread_entry_address(), start)
            if (status != I64{11} || bytes <= THREAD_STACK_FLOOR) -> break
            bytes = bytes >> I64{1}
            status = thread_pthread_attr_setstacksize(attr, bytes)
            if (status != I64{0}) -> break
        }
        thread_fork_gate_unshare(thread_tls_registry)
    }
    _ := thread_pthread_attr_destroy(attr)
    handle: sync_load(storage)
    jet_rt_free(storage, I64{72}, I64{8})
    if (status != I64{0}) {
        if (start != I64{0}) {
            jet_rt_free(start, I64{16}, I64{8})
            thread_spawn_settled()
        }
        return -status
    }
    handle
}

thread_join: fn(handle: I64, result: I64) -> I64 { thread_pthread_join(handle, result) }

thread_detach: fn(handle: I64) -> I64 { thread_pthread_detach(handle) }

// A thread thread_spawn counted is in the live registry, or never started.
thread_spawn_settled: fn() {
    spawning: wrapping(thread_tls_registry + THREAD_SPAWNING)
    if (sync_add(spawning, I64{-1}) == I64{1}) -> sync_futex_wake(spawning, I64{2147483647})
}

// The fork gate. A raw fork (RouteSys.jet jet_sys_fork_raw) copies every
// lock as it stands into a child that runs only the forking thread, so a
// runtime call into musl that takes a musl lock holds the gate shared, and
// a fork holds it exclusively: no such call is under way when the child is
// copied. Of the runtime's musl calls only pthread_create takes one (the
// thread-list lock, and the open-file list on the first create); join,
// detach and the attribute calls take none, and a join may wait as long as
// its thread runs, so they stay outside. The word counts sharing threads,
// plus THREAD_FORK_GATE_HELD while a fork holds the gate or waits for them
// to leave. A waiter blocks its OS thread, never parks a fiber: the
// scheduler's root may be held across a share (scheduler_start_worker).
thread_fork_gate_share: fn(root: I64) {
    gate: wrapping(root + THREAD_FORK_GATE)
    loop {
        state: sync_load(gate)
        if (state >= THREAD_FORK_GATE_HELD) {
            _ := sync_futex_wait(gate, state, I64{-1})
            next
        }
        if (sync_cas(gate, state, state + I64{1}) == state) -> return
    }
}

// The last sharing thread to leave wakes the fork waiting for it.
thread_fork_gate_unshare: fn(root: I64) {
    gate: wrapping(root + THREAD_FORK_GATE)
    if (sync_add(gate, I64{-1}) == THREAD_FORK_GATE_HELD + I64{1}) -> sync_futex_wake(gate, I64{2147483647})
}

// A fork's hold: one fork at a time, once every sharing thread has left.
thread_fork_gate_hold: fn(root: I64) {
    gate: wrapping(root + THREAD_FORK_GATE)
    loop {
        state: sync_load(gate)
        if (state >= THREAD_FORK_GATE_HELD) {
            _ := sync_futex_wait(gate, state, I64{-1})
            next
        }
        if (sync_cas(gate, state, state + THREAD_FORK_GATE_HELD) == state) -> break
    }
    loop {
        state: sync_load(gate)
        if (state == THREAD_FORK_GATE_HELD) -> return
        _ := sync_futex_wait(gate, state, I64{-1})
    }
}

// Ends a fork's hold. In the parent it wakes the threads waiting to share
// or fork; in the child, whose only thread is the forking one, the stored 0
// is the gate's initial state and the wake finds no waiter.
thread_fork_gate_release: fn(root: I64) {
    gate: wrapping(root + THREAD_FORK_GATE)
    sync_store(gate, I64{0})
    sync_futex_wake(gate, I64{2147483647})
}

// ---------------------------------------------------------------------------
// Synccall: one credential system call on every thread (musl __synccall with
// the __setxid and setgroups callbacks, src/thread/synccall.c,
// src/unistd/setxid.c, src/linux/setgroups.c). Linux keeps credentials per
// thread and POSIX per process, so the call runs on each thread through a
// signal. The threads are the live registry's (every thread that runs Jet
// code is attached there; a fiber's row names no thread), held with its
// mutex and with no spawned thread still unregistered, so no thread
// appears that the call misses. A thread that linked C code creates itself
// and that never attaches is outside the registry and keeps its old
// credentials. Unlike musl, which runs the call on the other threads before
// the caller (so a call the caller is refused, such as setgroups after
// setuid, kills the process), the caller runs it first and a refusal
// changes no thread.
//
// Record64, allocated by the first synccall and never freed: system call
// number0 and its arguments 8/16/24, target32 (the tid being captured; its
// handler clears it), phase40 (0 capture, 1 run, 2 skip, 3 release),
// done48 and left56 (captured threads past the call, and past the release).
thread_synccall_record := I64{0}

// musl's SIGSYNCCALL: one of the real-time signals musl keeps below the
// SIGRTMIN (35) it reports, so no program's handler is displaced.
THREAD_SYNCCALL_SIGNAL: I64{34}

// Checked FunctionAddress intrinsic in the canonical RuntimeLibrary table.
rt_thread_synccall_address: fn() -> I64 { loop { jet_rt_unreachable(I64{0}, I64{0}) } }

// The record's system call on this thread: 0, or -errno.
thread_synccall_run: fn(record: I64) -> I64 {
    #Unsafe("a credential system call takes word arguments; setgroups' list is the synccall caller's, live until every thread has run") {
        return os_syscall_i64(sync_load(record), sync_load(wrapping(record + I64{8})), sync_load(wrapping(record + I64{16})), sync_load(wrapping(record + I64{24})), I64{0}, I64{0}, I64{0})
    }
}

thread_synccall_post: fn(word: I64) {
    _ := sync_add(word, I64{1})
    sync_futex_wake(word, I64{1})
}

// Block this thread until `word` is `value`.
thread_synccall_until: fn(word: I64, value: I64) {
    loop {
        current: sync_load(word)
        if (current == value) -> return
        _ := sync_futex_wait(word, current, I64{-1})
    }
}

// The handler, on a captured thread. A THREAD_SYNCCALL_SIGNAL that no
// synccall aimed at this thread (another sender's) is ignored. A thread that
// fails the call after the caller succeeded would leave the process's
// threads with different credentials, so, as musl does, it kills the
// process (SIGKILL cannot be caught).
#Export(c) jet_rt_thread_synccall_signal: fn(_signal: I64) -> I64 {
    record: thread_synccall_record
    if (record == I64{0}) -> return I64{0}
    tid: thread_tid()
    target: wrapping(record + I64{32})
    if (sync_cas(target, tid, I64{0}) != tid) -> return I64{0}
    sync_futex_wake(target, I64{1})
    phase: wrapping(record + I64{40})
    loop sync_load(phase) == (I64{0}) -> _ := sync_futex_wait(phase, I64{0}, I64{-1})
    if (sync_load(phase) == I64{1} && thread_synccall_run(record) != I64{0}) {
        #Unsafe("kill(getpid(), SIGKILL) retains no memory") {
            process: os_syscall_i64(I64{39}, I64{0}, I64{0}, I64{0}, I64{0}, I64{0}, I64{0})
            _ := os_syscall_i64(I64{62}, process, I64{9}, I64{0}, I64{0}, I64{0}, I64{0})
        }
    }
    thread_synccall_post(wrapping(record + I64{48}))
    thread_synccall_until(phase, I64{3})
    thread_synccall_post(wrapping(record + I64{56}))
    I64{0}
}

// Captures every other registered thread in the handler: the count, or
// -EAGAIN when the handler cannot be installed or a thread cannot be
// signalled (the threads captured so far are counted in `captured`).
thread_synccall_capture: fn(record: I64, captured: I64) -> I64 {
    sync_store(captured, I64{0})
    caller: thread_tid()
    process := I64{0}
    #Unsafe("getpid retains no memory") {
        process = os_syscall_i64(I64{39}, I64{0}, I64{0}, I64{0}, I64{0}, I64{0}, I64{0})
    }
    installed := false
    target: wrapping(record + I64{32})
    live: wrapping(thread_tls_registry + I64{64})
    data: sync_load(wrapping(live + I64{16}))
    count: sync_load(live)
    at := I64{0}
    loop at < count {
        tid: sync_load(wrapping(data + at * I64{8}))
        tcb: sync_load(wrapping(data + (at + I64{1}) * I64{8}))
        at += I64{2}
        if (tid == tcb || tid == caller) -> next
        // Installed again by every synccall, so a C library's handler for
        // the same signal cannot take the capture.
        if !installed {
            if (process_signal_install(THREAD_SYNCCALL_SIGNAL, rt_thread_synccall_address()) < I64{0}) -> return I64{-11}
            installed = true
        }
        sync_store(target, tid)
        sent := I64{-11}
        loop sent == (I64{-11}) {
            #Unsafe("tgkill names a live registered thread of this process") {
                sent = os_syscall_i64(I64{234}, process, tid, THREAD_SYNCCALL_SIGNAL, I64{0}, I64{0}, I64{0})
            }
        }
        // ESRCH: a thread that ended without detaching has nothing to change.
        if (sent < I64{0}) {
            sync_store(target, I64{0})
            if (sent == I64{-3}) -> next
            return I64{-11}
        }
        thread_synccall_until(target, I64{0})
        sync_store(captured, sync_load(captured) + I64{1})
    }
    sync_load(captured)
}

// Releases the captured threads after the call ran (phase 1) or was skipped
// (phase 2), then waits until every one has left the handler.
thread_synccall_release: fn(record: I64, captured: I64, phase: I64) {
    sync_store(wrapping(record + I64{40}), phase)
    sync_futex_wake(wrapping(record + I64{40}), I64{2147483647})
    thread_synccall_until(wrapping(record + I64{48}), captured)
    sync_store(wrapping(record + I64{40}), I64{3})
    sync_futex_wake(wrapping(record + I64{40}), I64{2147483647})
    thread_synccall_until(wrapping(record + I64{56}), captured)
    sync_store(wrapping(record + I64{40}), I64{0})
    sync_store(wrapping(record + I64{48}), I64{0})
    sync_store(wrapping(record + I64{56}), I64{0})
}

// System call `number` with (a, b, c) on every thread, this one first: its
// result, 0 or -errno. When this thread's call fails, no thread has changed;
// -EAGAIN (musl's result when the synccall cannot run) when a thread cannot
// be captured, again with no thread changed.
thread_setxid: fn(number: I64, a: I64, b: I64, c: I64) -> I64 {
    root: thread_tls_registry
    if (root == I64{0}) {
        // No registry: no thread but this one runs Jet code.
        #Unsafe("a credential system call takes word arguments and retains no memory") {
            return os_syscall_i64(number, a, b, c, I64{0}, I64{0}, I64{0})
        }
    }
    captured: jet_rt_alloc(I64{8}, I64{8})
    status := I64{0}
    loop {
        thread_synccall_settle(root)
        sync_mutex_lock(root)
        if (thread_synccall_record == I64{0}) {
            fresh: jet_rt_alloc(I64{64}, I64{8})
            thread_zero(fresh, I64{64})
            #Unsafe("written under the registry mutex, before any handler can run") {
                thread_synccall_record = fresh
            }
        }
        record: thread_synccall_record
        sync_store(record, number)
        sync_store(wrapping(record + I64{8}), a)
        sync_store(wrapping(record + I64{16}), b)
        sync_store(wrapping(record + I64{24}), c)
        status = thread_synccall_capture(record, captured)
        // A thread spawned before the capture that has not registered yet
        // would keep the old credentials: release, let it register, retry.
        if (status >= I64{0} && sync_load(wrapping(root + THREAD_SPAWNING)) != I64{0}) {
            thread_synccall_release(record, sync_load(captured), I64{2})
            sync_mutex_unlock(root)
            next
        }
        if (status >= I64{0}) -> status = thread_synccall_run(record)
        thread_synccall_release(record, sync_load(captured), if (status == I64{0}) -> I64{1} else -> I64{2})
        sync_mutex_unlock(root)
        break
    }
    jet_rt_free(captured, I64{8}, I64{8})
    status
}

// Wait until every thread thread_spawn started has registered.
thread_synccall_settle: fn(root: I64) {
    spawning: wrapping(root + THREAD_SPAWNING)
    thread_synccall_until(spawning, I64{0})
}

// Raw clone control: mapping@0, size@8, CHILD_CLEARTID@16. Join owns the
// control and stack until the kernel clears the TID and wakes a SHARED futex
// (the kernel's clear_child_tid wake is not FUTEX_WAKE_PRIVATE).
// Only joined raw threads are exposed here. At libc exit, detached raw threads
// transfer the control to the scheduler reaper, which performs this same join
// and munmap; a child never unmaps the stack it is still executing on.
thread_clone_fixture: fn(entry: I64, argument: I64) -> I64 {
    sync_sole_end()
    bytes: I64{201330688}
    mapping := I64{0}
    #Unsafe("fresh raw clone stack mapping with a PROT_NONE first-page guard; child may call only Jet/syscall code, never musl/Rust with inherited FS") {
        mapping = os_syscall_i64(I64{9}, I64{0}, bytes, I64{3}, I64{34}, I64{-1}, I64{0})
        if (mapping < I64{0}) { return mapping }
        protect: os_syscall_i64(I64{10}, mapping, I64{4096}, I64{0}, I64{0}, I64{0}, I64{0})
        if (protect != I64{0}) {
            _ := os_syscall_i64(I64{11}, mapping, bytes, I64{0}, I64{0}, I64{0}, I64{0})
            return protect
        }
    }
    control: jet_rt_alloc(I64{24}, I64{8})
    sync_store(control, mapping)
    sync_store(wrapping(control + I64{8}), bytes)
    sync_store(wrapping(control + I64{16}), I64{0})
    stack: wrapping(wrapping(mapping + bytes) - I64{16})
    sync_store(stack, entry)
    sync_store(wrapping(stack + I64{8}), argument)
    tid := I64{0}
    #Unsafe("guarded stack is seeded with Jet-only entry/arg; TID word is live until join; flags share VM, FS, FILES, SIGHAND, THREAD, SYSVSEM and enable parent-set/child-clear TID") {
        tid = os_clone_i64(I64{3477248}, stack, control + I64{16}, control + I64{16})
    }
    if (tid < I64{0}) {
        alloc_unmap(mapping, bytes)
        jet_rt_free(control, I64{24}, I64{8})
        return tid
    }
    control
}

thread_clone_join: fn(control: I64) {
    loop {
        tid: sync_load(wrapping(control + I64{16}))
        if (tid == I64{0}) { break }
        #Unsafe("kernel CHILD_CLEARTID clears this live word and wakes a non-private futex; recheck handles exit-before-wait and EINTR") {
            _ := os_syscall_i64(I64{202}, control + I64{16}, I64{0}, tid, I64{0}, I64{0}, I64{0})
        }
    }
    alloc_unmap(sync_load(control), sync_load(wrapping(control + I64{8})))
    jet_rt_free(control, I64{24}, I64{8})
}
