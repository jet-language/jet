// The Rust original derive Clone/PartialEq.
#Export(c) fn jet_rt_record_new_log_span(id: I64, name: I64) -> I64 {
    raw :: jet_int_owned_to_i64(id)
    if (jet_scheduler_native_propagate() != I64{0}) -> return I64{0}
    value :: jet_rt_alloc(LOG_SPAN_BYTES, I64{8})
    data_tree_store(wrapping(value + LOG_SPAN_ID), raw)
    data_tree_store(wrapping(value + LOG_SPAN_NAME), jet_rt_string_clone(name))
    value
}
#Export(c) fn jet_rt_record_get_log_span_id(value: I64) -> I64 { jet_int_owned_from_i64(data_tree_word(wrapping(value + LOG_SPAN_ID))) }
#Export(c) fn jet_rt_record_get_log_span_name(value: I64) -> I64 { jet_rt_string_clone(data_tree_word(wrapping(value + LOG_SPAN_NAME))) }
#Export(c) fn jet_rt_handle_clone_log_span(value: I64) -> I64 {
    result :: jet_rt_alloc(LOG_SPAN_BYTES, I64{8})
    data_tree_store(wrapping(result + LOG_SPAN_ID), data_tree_word(wrapping(value + LOG_SPAN_ID)))
    data_tree_store(wrapping(result + LOG_SPAN_NAME), jet_rt_string_clone(data_tree_word(wrapping(value + LOG_SPAN_NAME))))
    result
}
#Export(c) fn jet_rt_handle_drop_log_span(value: I64) {
    if (value == I64{0}) -> return
    jet_rt_string_drop(data_tree_word(wrapping(value + LOG_SPAN_NAME)))
    jet_rt_free(value, LOG_SPAN_BYTES, I64{8})
}
#Export(c) fn jet_rt_handle_eq_log_span(left: I64, right: I64) -> Bool {
    if data_tree_word(wrapping(left + LOG_SPAN_ID)) != data_tree_word(wrapping(right + LOG_SPAN_ID)) -> return false
    jet_rt_string_eq(data_tree_word(wrapping(left + LOG_SPAN_NAME)), data_tree_word(wrapping(right + LOG_SPAN_NAME)))
}
