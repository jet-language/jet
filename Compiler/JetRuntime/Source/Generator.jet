// A generator (`f: fn() -> Stream<T>` with `yield`) is a
// native iterator (kind 30) whose producer is a scheduler child task. The
// consumer's pull resumes the producer and waits; the producer's `yield`
// hands one value over and waits for the next pull, a wait point. Dropping
// the iterator cancels the producer, which unwinds at its yield running its
// cleanup, and waits for it to finish.
//
// State words: env0 invoke8 release16 unit-meta24 child32 out40 turn48
// dropped56 park64 meta72 label80. The generated code hands over
// env (word 0 is left for this state, word 8 is its started flag), the
// producer invoke(env, unit-slot) and release(env), which drops what a
// never-started producer still holds and frees env. turn is 1 while the
// producer owes the consumer a value; park is the producer's wait slot, the
// consumer waits on the child task's completion park.
GENERATOR_BYTES: I64{88}

#Export(c) jet_rt_native_generator: fn(env: I64, invoke: I64, release: I64, meta: I64, label: I64) -> I64 {
    node: iter_new(I64{30}, meta)
    state: jet_rt_alloc(GENERATOR_BYTES, I64{8})
    coll_zero(state, GENERATOR_BYTES)
    unit: jet_rt_alloc(I64{72}, I64{8})
    coll_zero(unit, I64{72})
    sync_store(state, env)
    sync_store(wrapping(state + I64{8}), invoke)
    sync_store(wrapping(state + I64{16}), release)
    sync_store(wrapping(state + I64{24}), unit)
    sync_store(wrapping(state + I64{64}), sync_park_new())
    sync_store(wrapping(state + I64{72}), iter_meta(node))
    sync_store(wrapping(state + I64{80}), label)
    sync_store(env, state)
    iter_hook(node, state, rt_generator_pull_address(), rt_generator_release_address())
    node
}

// RuntimeLower resolves these checked addresses through its sole intrinsic table.
rt_generator_pull_address: fn() -> I64 {
    loop { jet_rt_unreachable(I64{0}, I64{0}) }
}
rt_generator_release_address: fn() -> I64 {
    loop { jet_rt_unreachable(I64{0}, I64{0}) }
}

// The consumer's pull (the node's pull hook, Iter.jet): resumes (first:
// starts) the producer and waits until it yields into `output` (1) or
// finishes (0); a finished producer marks the node done. A producer panic is
// raised again here.
#Export(c) jet_rt_native_generator_pull: fn(node: I64, output: I64) -> I64 {
    state: trap_word(wrapping(node + I64{48}))
    sync_store(wrapping(state + I64{40}), output)
    sync_store(wrapping(state + I64{48}), I64{1})
    child := sync_load(wrapping(state + I64{32}))
    if (child == I64{0}) {
        child = task_state_new(I64{0}, sync_load(wrapping(state + I64{80})), sync_load(state), sync_load(wrapping(state + I64{8})), sync_load(wrapping(state + I64{16})), sync_load(wrapping(state + I64{24})), I64{0}, I64{0})
        sync_store(wrapping(state + I64{32}), child)
        scheduler_submit(I64{0}, child, true)
    } else {
        sync_park_wake(sync_load(wrapping(state + I64{64})))
    }
    scheduler_blocking_wait_enter()
    loop sync_load(wrapping(state + I64{48})) != (I64{0}) && sync_load(wrapping(child + I64{24})) == (I64{0}) -> sync_park(sync_load(wrapping(child + I64{104})), I64{-1})
    scheduler_blocking_wait_leave()
    if (sync_load(wrapping(state + I64{48})) == I64{0}) -> return I64{1}
    trap_store(wrapping(node + I64{144}), I64{1})
    if (sync_load(wrapping(child + I64{32})) == I64{5}) -> generator_raise(child)
    I64{0}
}

generator_raise: fn(child: I64) {
    record: sync_load(wrapping(sync_load(wrapping(child + I64{8})) + I64{40}))
    message: task_panic_message(sync_load(wrapping(record + I64{40})))
    jet_rt_panic_message(sync_load(message), sync_load(wrapping(message + I64{8})))
    jet_rt_string_drop(message)
}

// The producer's `yield`: moves the value at `value` to the consumer and
// waits for the next pull. Once the consumer dropped the stream the value
// is dropped and the cancel is delivered here, unless a shield holds it.
#Export(c) jet_rt_native_generator_yield: fn(state: I64, value: I64) {
    if (sync_load(wrapping(state + I64{56})) != I64{0}) {
        coll_slot_drop(value, sync_load(wrapping(state + I64{72})))
        _ := scheduler_wait_point_cancel_check()
        return
    }
    coll_copy(value, sync_load(wrapping(state + I64{40})), coll_payload(sync_load(wrapping(state + I64{72}))))
    sync_store(wrapping(state + I64{48}), I64{0})
    sync_park_wake(sync_load(wrapping(sync_load(wrapping(state + I64{32})) + I64{104})))
    kind: scheduler_msg_yield()
    loop jet_scheduler_native_propagate() == (I64{0}) {
        if (scheduler_wait_point_cancel_check() != I64{0}) -> break
        if (sync_load(wrapping(state + I64{48})) != I64{0} || sync_load(wrapping(state + I64{56})) != I64{0}) -> break
        _ := scheduler_yield(kind, sync_load(wrapping(state + I64{64})), I64{-1})
    }
    jet_rt_string_drop(kind)
}

// Dropping the stream (the node's release hook, run by jet_rt_native_iter_drop
// under its shield): a producer never started only releases its env; a
// running one is cancelled and waited for, so its cleanup has run when the
// drop returns.
#Export(c) jet_rt_native_generator_release: fn(state: I64) -> I64 {
    child: sync_load(wrapping(state + I64{32}))
    if (child == I64{0}) {
        coll_call1_unit(sync_load(wrapping(state + I64{16})), sync_load(state))
    } else {
        if (sync_load(wrapping(child + I64{24})) == I64{0}) {
            sync_store(wrapping(state + I64{56}), I64{1})
            scheduler_control_cancel(sync_load(wrapping(child + I64{8})))
            sync_park_wake(sync_load(wrapping(state + I64{64})))
            task_drain(child)
        }
        task_drop(child)
    }
    sync_park_drop(sync_load(wrapping(state + I64{64})))
    coll_meta_drop(sync_load(wrapping(state + I64{24})))
    jet_rt_free(state, GENERATOR_BYTES, I64{8})
    I64{0}
}
