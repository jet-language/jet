    temp: jet_fs_temp_directory_raw()
    name: fd_c_path(temp)
    fd = compiler_mapped_tmpfile(name)
    fd_c_path_drop(name, temp)
    jet_rt_string_drop(temp)
    fd
}
// openat(AT_FDCWD, directory, O_RDWR|O_TMPFILE|O_CLOEXEC, 0o600).
compiler_mapped_tmpfile: fn(directory: I64) -> I64 {
    host_call4(I64{257}, I64{-100}, directory, I64{2}.bit_or(JETC_O_TMPFILE).bit_or(JETC_O_CLOEXEC), I64{384})
}
// Whether ioctl FICLONE made the empty `spare` share every block of `fd`'s
// file: a snapshot no later write or truncation of the file reaches. A file
// system that cannot clone, or a spare on another one, refuses.
compiler_mapped_clone: fn(spare: I64, fd: I64) -> Bool {
    #Unsafe("FICLONE shares the file's blocks with the empty unnamed spare this map owns") {
        return os_syscall_i64(I64{16}, spare, I64{1074041865}, fd, I64{0}, I64{0}, I64{0}) == I64{0}
    }
}
// Copies `length` bytes of `from` from its start into the empty `to`, then
// sets `to`'s length to exactly `length`, so a file that shrank meanwhile
// leaves zeros and never a short copy. `offset` is the word that carries the
// read position, so `from`'s own position never moves. 0, or the negative
// errno. It allocates nothing and takes no lock: the lease-break handler
// runs it.
compiler_mapped_copy: fn(from: I64, to: I64, length: I64, offset: I64) -> I64 {
    sync_store(offset, I64{0})
    done := I64{0}
    ranged := true
    loop done < length {
        chunk: if (length - done > I64{1073741824}) -> I64{1073741824} else -> length - done
        moved := I64{0}
        #Unsafe("copy_file_range and sendfile move bytes between two descriptors this map owns; the offset word is the caller's") {
