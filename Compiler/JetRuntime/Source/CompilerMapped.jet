}
// Takes `slot` from its map's drop: true when the lease is still held (the
// caller releases it), false when a break already settled it. A break in
// progress on another thread is waited for.
compiler_mapped_close_slot: fn(slot: I64) -> Bool {
    loop {
        state: sync_load(slot)
        if (state == I64{2} && sync_cas(slot, I64{2}, I64{4}) == I64{2}) -> return true
        if (state == I64{5} && sync_cas(slot, I64{5}, I64{4}) == I64{5}) -> return false
        if (state == I64{3}) -> _ := sync_futex_wait(slot, I64{3}, I64{-1})
    }
}
// Checked FunctionAddress intrinsic in the canonical RuntimeLibrary table.
rt_mapped_lease_break_address: fn() -> I64 { loop { jet_rt_unreachable(I64{0}, I64{0}) } }
// The lease-break signal (SA_SIGINFO): another process opens a held file for
// writing or truncates it, and the kernel holds that process back until the
// lease is released. The signal names the descriptor (siginfo si_fd at 24);
// the handler copies that map's bytes into its spare temp file and maps the
// copy over the same address, so every borrowed view keeps reading the bytes
// it read before, then releases the lease. It allocates nothing and takes no
// lock.
#Export(c) jet_rt_mapped_lease_break: fn(_signal: I64, info: I64, _context: I64) -> I64 {
    table: compiler_mapped_leases
    if (table == I64{0} || info == I64{0}) -> return I64{0}
