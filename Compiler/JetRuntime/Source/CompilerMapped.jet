        }
        if (status < I64{0}) -> jet_rt_free(slots, size, I64{8})
        #Unsafe("written under the map registry mutex, before any lease can name a slot") {
            if (status >= I64{0}) -> compiler_mapped_leases = slots
            compiler_mapped_lease_tried = I64{1}
        }
    }
    table: compiler_mapped_leases
    sync_mutex_unlock(root)
