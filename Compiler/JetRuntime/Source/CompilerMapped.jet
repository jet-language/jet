// One process registry of canonical path keys and live mapping counts, guarded
// by the runtime mutex. Map64: reserved0, FD72 owner8, owned original path16,
// owned canonical key24, read-only mapped pointer32, length40, kind48 (1 Clone,
// 2 Held, 3 Copy), lease slot56 (0 unless the map holds a lease). The
// registry lease is held until AFTER unmap/unlock/close. Empty maps hold the
// same descriptor and lease.
//
// Another process may write or shrink the file while a safe view borrows its
// bytes, so a map never shows the file's live pages. A file system that
// cannot be written at all (squashfs, erofs) is mapped directly and reports
// Held. Otherwise the map takes an unnamed temp file, in the file's own
// directory when it may, else in the temp directory: a clone of the file
// (FICLONE) into it is mapped where the file system can clone (Clone). Else
// a read lease holds the file (Held): the kernel makes a writer or a
// truncation wait for the lease-break signal, whose handler copies the bytes
// into the temp file and maps the copy over the same address before it lets
// the writer in, and the map then reports Copy. A file the lease cannot hold
// is copied into the temp file at map time (Copy).
compiler_mapped_root := I64{0}
// The kinds a map reports through `MappedFile.kind()`.
MAPPED_CLONE: I64{1}
MAPPED_HELD: I64{2}
MAPPED_COPY: I64{3}
// The largest file a lease holds, 4 GiB: a break copies it within the
// kernel's default 45 s lease-break-time at about 100 MB/s. A larger file is
// copied at map time.
MAPPED_LEASE_LIMIT: I64{4294967296}
// SIGRTMAX: the runtime's lease-break signal. Core lets no program take a
// real-time signal, so no handler of the program's is displaced.
MAPPED_LEASE_SIGNAL: I64{64}
MAPPED_LEASE_SLOTS: I64{64}
// The lease slots: MAPPED_LEASE_SLOTS records of 64 bytes, allocated with the
// lease-break handler's install and never freed, or 0 before it (and when the
// kernel refused the handler). Slot64: state0 (0 free, 1 claimed, 2 held, 3
// breaking, 4 closing, 5 settled), descriptor number8, spare temp file
// number16 (-1 once used or closed), pointer24, length32, copied40 (1 once
// the break mapped a copy), memfd name48 ("jet-map"), copy read offset56.
// Only atomic word operations touch a slot, since the handler may run on any
// thread at any instruction.
compiler_mapped_leases := I64{0}
// 1 once the first lease looked for the handler, whether or not it went in.
compiler_mapped_lease_tried := I64{0}
// runtime-init: 4 when compiler_mapped_root
#Export(c) jet_rt_compiler_mapped_init: fn() {
    if (compiler_mapped_root != I64{0}) -> return
    root: jet_rt_alloc(I64{16}, I64{8})
    thread_zero(root, I64{16})
    #Unsafe("runtime-init runs before any other thread exists") {
        compiler_mapped_root = root
    }
}
compiler_mapped_key: fn(path: I64) -> I64 {
    at := I64{0}
    loop at < rt_text_len(path) {
        if (rt_text_byte(wrapping(rt_text_data(path) + at)) == I64{0}) -> return jet_rt_string_clone(path)
        at += I64{1}
    }
    // Failed canonicalize falls back to the ORIGINAL spelling (not absolute or
    // lexical normalization), exactly PathBuf fallback does.
    name: fd_c_path(path)
    scratch: jet_rt_alloc(I64{48}, I64{8})
    bytes: jet_process_path_canonicalize_raw(name, scratch, wrapping(scratch + I64{8}), wrapping(scratch + I64{16}))
    fd_c_path_drop(name, path)
    result: if (bytes == I64{0}) -> jet_rt_string_clone(path) else -> rt_text_lossy(bytes, rt_text_word(scratch))
    if (bytes != I64{0}) -> jet_rt_free(bytes, rt_text_word(wrapping(scratch + I64{8})), I64{1})
    jet_rt_free(scratch, I64{48}, I64{8})
    result
}
// Registry Node24: next0, owned key8, live count16. Only the root lock reads it.
compiler_mapped_find: fn(key: I64) -> I64 {
    node := rt_text_word(wrapping(compiler_mapped_root + I64{8}))
    loop node != (I64{0}) {
        if jet_rt_string_eq(rt_text_word(wrapping(node + I64{8})), key) -> return node
        node = rt_text_word(node)
    }
    I64{0}
}
compiler_mapped_register: fn(key: I64) {
    root: compiler_mapped_root
    sync_mutex_lock(root)
    node := compiler_mapped_find(key)
    if (node == I64{0}) {
        node = jet_rt_alloc(I64{24}, I64{8})
        rt_text_store(node, rt_text_word(wrapping(root + I64{8})))
        rt_text_store(wrapping(node + I64{8}), jet_rt_string_clone(key))
        rt_text_store(wrapping(node + I64{16}), I64{0})
        rt_text_store(wrapping(root + I64{8}), node)
    }
    rt_text_store(wrapping(node + I64{16}), rt_text_word(wrapping(node + I64{16})) + I64{1})
    sync_mutex_unlock(root)
}
compiler_mapped_unregister: fn(key: I64) {
    root: compiler_mapped_root
    sync_mutex_lock(root)
    link := root + I64{8}
    loop rt_text_word(link) != (I64{0}) {
        node: rt_text_word(link)
        if jet_rt_string_eq(rt_text_word(wrapping(node + I64{8})), key) {
            count: rt_text_word(wrapping(node + I64{16}))
            if (count > I64{1}) { rt_text_store(wrapping(node + I64{16}), count - I64{1}) } else {
                rt_text_store(link, rt_text_word(node))
                jet_rt_string_drop(rt_text_word(wrapping(node + I64{8})))
                jet_rt_free(node, I64{24}, I64{8})
            }
            break
        }
        link = node
    }
    sync_mutex_unlock(root)
}
#Export(c) jet_std_files_writer_refusal: fn(path: I64, some: I64) -> I64 {
    key: compiler_mapped_key(path)
    root: compiler_mapped_root
    sync_mutex_lock(root)
    live: compiler_mapped_find(key) != I64{0}
    sync_mutex_unlock(root)
    jet_rt_string_drop(key)
    if !live -> return I64{0}
    _ := host_io_other_take(HOST_IO_OP_WRITE, jet_rt_string_clone(path), jet_rt_string_clone(rt_static_text("file is mapped read-only")), some)
    I64{1}
}
#Export(c) jet_std_files_map: fn(path: I64, output: I64, error: I64) -> I64 {
    if !compiler_fs_path(path, HOST_IO_OP_READ, error) -> return I64{0}
    scratch: jet_rt_alloc(I64{160}, I64{8})
    errno: wrapping(scratch + I64{128})
    file: jet_fd_open_raw(path, I64{1}, I64{0}, errno)
    if (file == I64{0}) {
        code: rt_text_word(wrapping(errno + I64{8}))
        jet_rt_free(scratch, I64{160}, I64{8})
        return compiler_fs_errno(HOST_IO_OP_READ, path, code, error)
    }
    jet_fd_stat_raw(file, scratch, errno)
    failure := if (rt_text_word(errno) == I64{0}) -> I64{0} else -> -rt_text_word(wrapping(errno + I64{8}))
    length: rt_text_word(wrapping(scratch + I64{56}))
    if (failure == I64{0} && length < I64{0}) {
        jet_fd_drop_raw(file)
        jet_rt_free(scratch, I64{160}, I64{8})
        return compiler_fs_error(HOST_IO_KIND_INVALID_INPUT, HOST_IO_OP_READ, path, I64{0}, jet_rt_string_clone(rt_static_text("mapped file is too large for a byte view")), error)
    }
    locked := false
    if (failure == I64{0}) {
        jet_fd_lock_raw(file, I64{5}, errno)
        failure = if (rt_text_word(errno) == I64{0}) -> I64{0} else -> -rt_text_word(wrapping(errno + I64{8}))
        locked = failure == I64{0}
    }
    pointer := I64{1}
    key := I64{0}
    kind := MAPPED_COPY
    slot := I64{0}
    if (failure == I64{0}) {
        key = compiler_mapped_key(path)
        if (length != I64{0}) {
            number: jet_fd_number_raw(file)
            if compiler_mapped_unwritable(number, scratch) {
                kind = MAPPED_HELD
                pointer = compiler_mapped_mmap(number, length)
            } else {
                spare: compiler_mapped_spare(path)
                if (spare < I64{0}) {
                    failure = spare
                } else if compiler_mapped_clone(spare, number) {
                    kind = MAPPED_CLONE
                    pointer = compiler_mapped_mmap(spare, length)
                } else {
                    slot = compiler_mapped_hold(number, spare, length)
                    if (slot != I64{0}) {
                        kind = MAPPED_HELD
                        pointer = sync_load(wrapping(slot + I64{24}))
                    } else {
                        copied: compiler_mapped_copy(number, spare, length, wrapping(scratch + I64{152}))
                        pointer = if (copied < I64{0}) -> copied else -> compiler_mapped_mmap(spare, length)
                    }
                }
                // The mapping keeps a clone or copy alive; a held map keeps
                // its spare for the break.
                if (spare >= I64{0} && slot == I64{0}) -> compiler_mapped_close(spare)
            }
            if (failure == I64{0} && pointer < I64{0} && pointer >= I64{-4095}) -> failure = pointer
        }
    }
    if (failure < I64{0}) {
        if locked -> jet_fd_lock_raw(file, I64{8}, errno)
        jet_fd_drop_raw(file)
        if (key != I64{0}) -> jet_rt_string_drop(key)
        jet_rt_free(scratch, I64{160}, I64{8})
        return compiler_fs_errno(HOST_IO_OP_READ, path, -failure, error)
    }
    compiler_mapped_register(key)
    map: jet_rt_alloc(I64{64}, I64{8})
    rt_text_store(map, I64{0})
    rt_text_store(wrapping(map + I64{8}), file)
    rt_text_store(wrapping(map + I64{16}), jet_rt_string_clone(path))
    rt_text_store(wrapping(map + I64{24}), key)
    rt_text_store(wrapping(map + I64{32}), pointer)
    rt_text_store(wrapping(map + I64{40}), length)
    rt_text_store(wrapping(map + I64{48}), kind)
    rt_text_store(wrapping(map + I64{56}), slot)
    jet_rt_free(scratch, I64{160}, I64{8})
    rt_text_store(output, map)
    I64{1}
}
#Export(c) jet_rt_handle_drop_jet_mapped_file: fn(map: I64) {
    if (map == I64{0}) -> return
    // MappedFile is affine; borrowed byte views keep its checked owner alive.
    file: rt_text_word(wrapping(map + I64{8}))
    length: rt_text_word(wrapping(map + I64{40}))
    slot: rt_text_word(wrapping(map + I64{56}))
    held: slot != I64{0} && compiler_mapped_close_slot(slot)
    if (length != I64{0}) -> _ := host_call(I64{11}, rt_text_word(wrapping(map + I64{32})), length, I64{0})
    if held -> compiler_mapped_unlease(jet_fd_number_raw(file))
    if (slot != I64{0}) {
        spare: sync_load(wrapping(slot + I64{16}))
        if (spare >= I64{0}) -> compiler_mapped_close(spare)
        sync_store(slot, I64{0})
    }
    scratch: jet_rt_alloc(I64{32}, I64{8})
    jet_fd_lock_raw(file, I64{8}, scratch)
    jet_rt_free(scratch, I64{32}, I64{8})
    jet_fd_drop_raw(file)
    compiler_mapped_unregister(rt_text_word(wrapping(map + I64{24})))
    jet_rt_string_drop(rt_text_word(wrapping(map + I64{16})))
    jet_rt_string_drop(rt_text_word(wrapping(map + I64{24})))
    jet_rt_free(map, I64{64}, I64{8})
}
// `kind()`'s native code: 1 Clone, 2 Held or 3 Copy. A held map whose lease
// broke now maps its copy, so it reports Copy; an empty map has no bytes to
// hold and reports Copy.
#Export(c) jet_std_fs_map_kind: fn(map: I64) -> I64 {
    slot: rt_text_word(wrapping(map + I64{56}))
    if (slot != I64{0} && sync_load(wrapping(slot + I64{40})) == I64{1}) -> return MAPPED_COPY
    rt_text_word(wrapping(map + I64{48}))
}
// mmap of `length` read-only private bytes of descriptor `fd` from its start:
// the address, or the negative errno.
compiler_mapped_mmap: fn(fd: I64, length: I64) -> I64 {
    #Unsafe("the descriptor is this map's own; mmap creates exactly length read-only private bytes; the map owner alone unmaps them") {
        return os_syscall_i64(I64{9}, I64{0}, length, I64{1}, I64{2}, fd, I64{0})
    }
}
compiler_mapped_close: fn(fd: I64) {
    #Unsafe("closes a temp-file descriptor this map alone owns") {
        _ := os_syscall_i64(I64{3}, fd, I64{0}, I64{0}, I64{0}, I64{0}, I64{0})
    }
}
// Releases the read lease on descriptor `fd` (fcntl F_SETLEASE F_UNLCK), so a
// writer the kernel holds back goes on.
compiler_mapped_unlease: fn(fd: I64) {
    #Unsafe("fcntl releases the lease on the map's own descriptor") {
        _ := os_syscall_i64(I64{72}, fd, I64{1024}, I64{2}, I64{0}, I64{0}, I64{0})
    }
}
// Whether `fd`'s file system cannot be written at all: squashfs
// (0x73717368) or erofs (0xE0F5E1E2), by fstatfs's f_type. A read-only
// mount of another file system does not count: a bind mount or a network
// server can still write the file.
compiler_mapped_unwritable: fn(fd: I64, scratch: I64) -> Bool {
    status := I64{0}
    #Unsafe("fstatfs writes one 120-byte statfs into the map's 160-byte scratch") {
        status = os_syscall_i64(I64{138}, fd, scratch, I64{0}, I64{0}, I64{0}, I64{0})
    }
    if (status < I64{0}) -> return false
    magic: rt_text_word(scratch).bit_and(I64{4294967295})
    magic == I64{1936814952} || magic == I64{3774210530}
}
// An unnamed temp file for `path`'s clone or copy, opened read-write: in the
// file's own directory, where a clone shares its file system, else in the
// temp directory. Its descriptor, or the negative errno of the last refusal.
compiler_mapped_spare: fn(path: I64) -> I64 {
    data: rt_text_data(path)
    length: rt_text_len(path)
    cut := I64{-1}
    at := I64{0}
    loop at < length {
        if (rt_text_byte(wrapping(data + at)) == I64{47}) -> cut = at
        at += I64{1}
    }
