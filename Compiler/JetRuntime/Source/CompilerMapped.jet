// One process registry of canonical path keys and live mapping counts, guarded
// by the runtime mutex. Map56: reserved0, FD72 owner8, owned original path16,
// owned canonical key24, read-only mapped pointer32, length40, reserved48. The
// registry lease is held until AFTER unmap/unlock/close. Empty maps hold the
// same descriptor and lease.
compiler_mapped_root := I64{0}
// runtime-init: 4 when compiler_mapped_root
#Export(c) jet_rt_compiler_mapped_init: fn() {
    if (compiler_mapped_root != I64{0}) -> return
    root: jet_rt_alloc(I64{16}, I64{8})
    thread_zero(root, I64{16})
    #Unsafe("runtime-init runs before any other thread exists") {
        compiler_mapped_root = root
    }
}
compiler_mapped_key: fn(path: I64) -> I64 {
    at := I64{0}
    loop at < rt_text_len(path) {
        if (rt_text_byte(wrapping(rt_text_data(path) + at)) == I64{0}) -> return jet_rt_string_clone(path)
        at += I64{1}
    }
    // Failed canonicalize falls back to the ORIGINAL spelling (not absolute or
    // lexical normalization), exactly PathBuf fallback does.
    name: fd_c_path(path)
    scratch: jet_rt_alloc(I64{48}, I64{8})
    bytes: jet_process_path_canonicalize_raw(name, scratch, wrapping(scratch + I64{8}), wrapping(scratch + I64{16}))
    fd_c_path_drop(name, path)
    result: if (bytes == I64{0}) -> jet_rt_string_clone(path) else -> rt_text_lossy(bytes, rt_text_word(scratch))
    if (bytes != I64{0}) -> jet_rt_free(bytes, rt_text_word(wrapping(scratch + I64{8})), I64{1})
    jet_rt_free(scratch, I64{48}, I64{8})
    result
}
// Registry Node24: next0, owned key8, live count16. Only the root lock reads it.
compiler_mapped_find: fn(key: I64) -> I64 {
    node := rt_text_word(wrapping(compiler_mapped_root + I64{8}))
    loop node != (I64{0}) {
        if jet_rt_string_eq(rt_text_word(wrapping(node + I64{8})), key) -> return node
        node = rt_text_word(node)
    }
    I64{0}
}
compiler_mapped_register: fn(key: I64) {
    root: compiler_mapped_root
    sync_mutex_lock(root)
    node := compiler_mapped_find(key)
    if (node == I64{0}) {
        node = jet_rt_alloc(I64{24}, I64{8})
        rt_text_store(node, rt_text_word(wrapping(root + I64{8})))
        rt_text_store(wrapping(node + I64{8}), jet_rt_string_clone(key))
        rt_text_store(wrapping(node + I64{16}), I64{0})
        rt_text_store(wrapping(root + I64{8}), node)
    }
    rt_text_store(wrapping(node + I64{16}), rt_text_word(wrapping(node + I64{16})) + I64{1})
    sync_mutex_unlock(root)
}
compiler_mapped_unregister: fn(key: I64) {
    root: compiler_mapped_root
    sync_mutex_lock(root)
    link := root + I64{8}
    loop rt_text_word(link) != (I64{0}) {
        node: rt_text_word(link)
        if jet_rt_string_eq(rt_text_word(wrapping(node + I64{8})), key) {
            count: rt_text_word(wrapping(node + I64{16}))
            if (count > I64{1}) { rt_text_store(wrapping(node + I64{16}), count - I64{1}) } else {
                rt_text_store(link, rt_text_word(node))
                jet_rt_string_drop(rt_text_word(wrapping(node + I64{8})))
                jet_rt_free(node, I64{24}, I64{8})
            }
            break
        }
        link = node
    }
    sync_mutex_unlock(root)
}
#Export(c) jet_std_files_writer_refusal: fn(path: I64, some: I64) -> I64 {
    key: compiler_mapped_key(path)
    root: compiler_mapped_root
    sync_mutex_lock(root)
    live: compiler_mapped_find(key) != I64{0}
    sync_mutex_unlock(root)
    jet_rt_string_drop(key)
    if !live -> return I64{0}
    _ := host_io_other_take(HOST_IO_OP_WRITE, jet_rt_string_clone(path), jet_rt_string_clone(rt_static_text("file is mapped read-only")), some)
    I64{1}
}
#Export(c) jet_std_files_map: fn(path: I64, output: I64, error: I64) -> I64 {
    if !compiler_fs_path(path, HOST_IO_OP_READ, error) -> return I64{0}
    scratch: jet_rt_alloc(I64{160}, I64{8})
    errno: wrapping(scratch + I64{128})
    file: jet_fd_open_raw(path, I64{1}, I64{0}, errno)
    if (file == I64{0}) {
        code: rt_text_word(wrapping(errno + I64{8}))
        jet_rt_free(scratch, I64{160}, I64{8})
        return compiler_fs_errno(HOST_IO_OP_READ, path, code, error)
    }
    jet_fd_stat_raw(file, scratch, errno)
    failure := if (rt_text_word(errno) == I64{0}) -> I64{0} else -> -rt_text_word(wrapping(errno + I64{8}))
    length: rt_text_word(wrapping(scratch + I64{56}))
    if (failure == I64{0} && length < I64{0}) {
        jet_fd_drop_raw(file)
        jet_rt_free(scratch, I64{160}, I64{8})
        return compiler_fs_error(HOST_IO_KIND_INVALID_INPUT, HOST_IO_OP_READ, path, I64{0}, jet_rt_string_clone(rt_static_text("mapped file is too large for a byte view")), error)
    }
    locked := false
    if (failure == I64{0}) {
        jet_fd_lock_raw(file, I64{5}, errno)
        failure = if (rt_text_word(errno) == I64{0}) -> I64{0} else -> -rt_text_word(wrapping(errno + I64{8}))
        locked = failure == I64{0}
    }
    pointer := I64{1}
    key := I64{0}
    if (failure == I64{0}) {
        key = compiler_mapped_key(path)
        if (length != I64{0}) {
            #Unsafe("the owned readable file lends its descriptor; mmap creates exactly length read-only private bytes; the map owner alone unmaps them") {
                pointer = os_syscall_i64(I64{9}, I64{0}, length, I64{1}, I64{2}, jet_fd_number_raw(file), I64{0})
            }
            if (pointer < I64{0} && pointer >= I64{-4095}) -> failure = pointer
        }
    }
    if (failure < I64{0}) {
        if locked -> jet_fd_lock_raw(file, I64{8}, errno)
        jet_fd_drop_raw(file)
        if (key != I64{0}) -> jet_rt_string_drop(key)
        jet_rt_free(scratch, I64{160}, I64{8})
        return compiler_fs_errno(HOST_IO_OP_READ, path, -failure, error)
    }
    compiler_mapped_register(key)
    map: jet_rt_alloc(I64{56}, I64{8})
    rt_text_store(map, I64{0})
    rt_text_store(wrapping(map + I64{8}), file)
    rt_text_store(wrapping(map + I64{16}), jet_rt_string_clone(path))
    rt_text_store(wrapping(map + I64{24}), key)
    rt_text_store(wrapping(map + I64{32}), pointer)
    rt_text_store(wrapping(map + I64{40}), length)
    rt_text_store(wrapping(map + I64{48}), I64{0})
    jet_rt_free(scratch, I64{160}, I64{8})
    rt_text_store(output, map)
    I64{1}
}
#Export(c) jet_rt_handle_drop_jet_mapped_file: fn(map: I64) {
    if (map == I64{0}) -> return
    // MappedFile is affine; borrowed byte views keep its checked owner alive.
    file: rt_text_word(wrapping(map + I64{8}))
    length: rt_text_word(wrapping(map + I64{40}))
    if (length != I64{0}) -> _ := host_call(I64{11}, rt_text_word(wrapping(map + I64{32})), length, I64{0})
    scratch: jet_rt_alloc(I64{32}, I64{8})
    jet_fd_lock_raw(file, I64{8}, scratch)
    jet_rt_free(scratch, I64{32}, I64{8})
    jet_fd_drop_raw(file)
    compiler_mapped_unregister(rt_text_word(wrapping(map + I64{24})))
    jet_rt_string_drop(rt_text_word(wrapping(map + I64{16})))
    jet_rt_string_drop(rt_text_word(wrapping(map + I64{24})))
    jet_rt_free(map, I64{56}, I64{8})
}
#Export(c) jet_std_fs_map_len: fn(map: I64) -> I64 { jet_int_owned_from_i64(rt_text_word(wrapping(map + I64{40}))) }
#Export(c) jet_std_fs_map_is_empty: fn(map: I64) -> Bool { rt_text_word(wrapping(map + I64{40})) == I64{0} }
// posix_madvise over the whole mapping: madvise(pointer, length, advice).
// Core passes MADV_NORMAL 0, RANDOM 1, SEQUENTIAL 2, WILLNEED 3, DONTNEED 4
// or COLD 20. The bytes are read-only and private to a file, so DONTNEED
// only drops pages a later read faults back in from the file. Advice changes
// no data: an empty map, and COLD on a kernel before 5.4 (EINVAL), succeed.
#Export(c) jet_std_fs_map_advise: fn(map: I64, advice: I64, error: I64) -> I64 {
    length: rt_text_word(wrapping(map + I64{40}))
    if (length == I64{0}) -> return I64{1}
    result: host_call(I64{28}, rt_text_word(wrapping(map + I64{32})), length, advice)
    if (result == I64{-22} && advice == I64{20}) -> return I64{1}
    if (result < I64{0}) -> return compiler_fs_errno(HOST_IO_OP_READ, rt_text_word(wrapping(map + I64{16})), -result, error)
    I64{1}
}
// Byte windows lend the read-only mapped bytes the Map56 owner holds: the
// route writes (data, length) and IR builds the View<U8> header over them,
// which owns nothing. Bounds are the exact Int carriers; a boxed Int lies
// outside any mapping.
compiler_mapped_bound: fn(value: I64) -> I64 {
    if (int_inline(value) && value >= I64{0}) -> return value
    I64{-1}
}
compiler_mapped_text: fn(text: I64, value: I64) -> I64 {
    shown: jet_rt_int_to_string(value)
    joined: jet_rt_string_append(text, shown)
    jet_rt_string_drop(shown)
    joined
}
compiler_mapped_window_error: fn(map: I64, first: I64, separator: I64, second: I64, error: I64) -> I64 {
    cause := jet_rt_string_clone(rt_static_text("mapped window "))
    cause = compiler_mapped_text(cause, first)
    cause = jet_rt_string_append(cause, separator)
    cause = compiler_mapped_text(cause, second)
    cause = jet_rt_string_append(cause, rt_static_text(" is outside file length "))
    length: jet_int_owned_from_i64(rt_text_word(wrapping(map + I64{40})))
    cause = compiler_mapped_text(cause, length)
    compiler_fs_error(HOST_IO_KIND_OTHER, HOST_IO_OP_READ, rt_text_word(wrapping(map + I64{16})), I64{0}, cause, error)
}
compiler_mapped_lend: fn(map: I64, start: I64, end: I64, output: I64, length: I64) -> I64 {
    rt_text_store(output, wrapping(rt_text_word(wrapping(map + I64{32})) + start))
    rt_text_store(length, end - start)
    I64{1}
}
// `window(start, end)`: the half-open byte range start..<end.
#Export(c) jet_std_fs_map_window_view: fn(map: I64, start: I64, end: I64, output: I64, length: I64, error: I64) -> I64 {
    first: compiler_mapped_bound(start)
    last: compiler_mapped_bound(end)
    if (first < I64{0} || last < first || last > rt_text_word(wrapping(map + I64{40}))) -> return compiler_mapped_window_error(map, start, rt_static_text(".."), end, error)
    compiler_mapped_lend(map, first, last, output, length)
}
// `window_len(offset, length)`: `count` bytes from `offset`.
#Export(c) jet_std_fs_map_window_len_view: fn(map: I64, offset: I64, count: I64, output: I64, length: I64, error: I64) -> I64 {
    first: compiler_mapped_bound(offset)
    size: compiler_mapped_bound(count)
    total: rt_text_word(wrapping(map + I64{40}))
    if (first < I64{0} || size < I64{0} || first > total || size > total - first) -> return compiler_mapped_window_error(map, offset, rt_static_text(" length "), count, error)
    compiler_mapped_lend(map, first, first + size, output, length)
}
// The index of the first LF at or after `at`, or `total`.
compiler_mapped_newline: fn(base: I64, at: I64, total: I64) -> I64 {
    cursor := at
    loop cursor < total && rt_text_byte(wrapping(base + cursor)) != (I64{10}) {
        cursor += I64{1}
    }
    cursor
}
// `lines()`: one 24-byte View<U8> header (length, 0, data) per line, the LF
// and a CR before it excluded; a final unterminated line counts, an empty
// trailing one does not. The List buffer is exactly count*24 bytes.
#Export(c) jet_std_fs_map_lines_view: fn(map: I64, output: I64) -> I64 {
    base: rt_text_word(wrapping(map + I64{32}))
    total: rt_text_word(wrapping(map + I64{40}))
    count := I64{0}
    at := I64{0}
    loop at < total {
        count += I64{1}
        at = compiler_mapped_newline(base, at, total) + I64{1}
    }
    data: if (count == I64{0}) -> I64{0} else -> jet_rt_alloc(count * I64{24}, I64{8})
    slot := data
    at = I64{0}
    loop at < total {
        newline: compiler_mapped_newline(base, at, total)
        end: if (newline > at && rt_text_byte(wrapping(base + newline - I64{1})) == I64{13}) -> newline - I64{1} else -> newline
        rt_text_store(slot, end - at)
        rt_text_store(wrapping(slot + I64{8}), I64{0})
        rt_text_store(wrapping(slot + I64{16}), wrapping(base + at))
        slot = wrapping(slot + I64{24})
        at = newline + I64{1}
    }
    rt_text_store(output, data)
    count
}
#Export(c) jet_rt_record_get_jet_mapped_file_path: fn(map: I64) -> I64 { jet_rt_string_clone(rt_text_word(wrapping(map + I64{16}))) }
// The Map56 fields Core's MappedFile reads in place: the path it was opened
// with, and its bytes as a (length, 0, data) header over the read-only
// mapping. Both lend storage the map owns; a caller copies them out.
#Export(c) jet_rt_handle_field_jet_mapped_file_stored_path: fn(map: I64, out: I64) { coll_copy(rt_text_word(wrapping(map + I64{16})), out, I64{24}) }
#Export(c) jet_rt_handle_field_jet_mapped_file_bytes: fn(map: I64, out: I64) {
    rt_text_store(out, rt_text_word(wrapping(map + I64{40})))
    rt_text_store(wrapping(out + I64{8}), I64{0})
    rt_text_store(wrapping(out + I64{16}), rt_text_word(wrapping(map + I64{32})))
}
