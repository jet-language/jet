        sized = os_syscall_i64(I64{77}, to, length, I64{0}, I64{0}, I64{0}, I64{0})
    }
    sized
}
// Holds `fd`'s file with a read lease and maps it. The lease slot, with the
// mapping at its pointer word, or 0 when the file takes no lease: larger than
// MAPPED_LEASE_LIMIT, open for writing anywhere, not the caller's own, on a
// file system without leases, or every slot is in use.
compiler_mapped_hold: fn(fd: I64, spare: I64, length: I64) -> I64 {
    if (length > MAPPED_LEASE_LIMIT) -> return I64{0}
    table: compiler_mapped_lease_table()
    if (table == I64{0}) -> return I64{0}
    slot := I64{0}
    index := I64{0}
    loop index < MAPPED_LEASE_SLOTS && (slot == I64{0}) {
        candidate: wrapping(table + index * I64{64})
        if (sync_cas(candidate, I64{0}, I64{1}) == I64{0}) -> slot = candidate
        index += I64{1}
