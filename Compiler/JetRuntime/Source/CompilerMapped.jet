// The break's copy for one held slot, into its spare, else into a memfd (an
// unnamed file in memory) when the spare's file system is full; then the
// lease is released. The file's bytes are still the ones the views read:
// the writer waits for the release.
compiler_mapped_settle: fn(slot: I64) {
