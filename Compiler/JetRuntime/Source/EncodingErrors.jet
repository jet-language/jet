// Field order and derive(Clone,PartialEq,Eq). Descriptor ABI: exact-Int inputs
// borrow, Text clones, optional Int lends a word; Error ctor consumes cause,
// getters clone it. The Rust originals own all three renders.
encoding_word: fn(address: I64) -> I64 {
    #Unsafe("borrows an initialized aligned word in a live encoding carrier or option input") { return os_load_i64(address) }
}
encoding_store: fn(address: I64, value: I64) {
    #Unsafe("owns a writable aligned word in a fresh encoding carrier or caller output") { os_store_i64(address, value) }
}
// A fresh one-word enum carrier holding variant `kind`: the runtime
// constructor of a fieldless enum's unit variant.
encoding_enum_new: fn(kind: I64) -> I64 {
    result: jet_rt_alloc(ENCODING_ENUM_BYTES, I64{8})
    encoding_store(wrapping(result + ENCODING_ENUM_TAG), kind)
    result
}
encoding_enum_clone: fn(value: I64) -> I64 {
    result: jet_rt_alloc(ENCODING_ENUM_BYTES, I64{8})
    encoding_store(wrapping(result + ENCODING_ENUM_TAG), encoding_word(wrapping(value + ENCODING_ENUM_TAG)))
    result
}
encoding_enum_drop: fn(value: I64) {
    if (value != I64{0}) -> jet_rt_free(value, ENCODING_ENUM_BYTES, I64{8})
}
encoding_enum_eq: fn(left: I64, right: I64) -> Bool {
    encoding_word(wrapping(left + ENCODING_ENUM_TAG)) == encoding_word(wrapping(right + ENCODING_ENUM_TAG))
}
#Export(c) jet_rt_handle_clone_encoding_format: fn(value: I64) -> I64 { encoding_enum_clone(value) }
#Export(c) jet_rt_handle_drop_encoding_format: fn(value: I64) { encoding_enum_drop(value) }
#Export(c) jet_rt_handle_eq_encoding_format: fn(left: I64, right: I64) -> Bool { encoding_enum_eq(left, right) }
#Export(c) jet_rt_handle_clone_encoding_error_kind: fn(value: I64) -> I64 { encoding_enum_clone(value) }
#Export(c) jet_rt_handle_drop_encoding_error_kind: fn(value: I64) { encoding_enum_drop(value) }
#Export(c) jet_rt_handle_eq_encoding_error_kind: fn(left: I64, right: I64) -> Bool { encoding_enum_eq(left, right) }
encoding_optional_input: fn(pointer: I64) -> I64 {
    if (pointer == I64{0}) -> I64{0} else -> jet_int_owned_to_i64(encoding_word(pointer))
}
encoding_optional_get: fn(value: I64, present: I64, field: I64, some: I64) -> I64 {
    if (encoding_word(wrapping(value + present)) == I64{0}) -> return I64{0}
    encoding_store(some, jet_int_owned_from_i64(encoding_word(wrapping(value + field))))
    I64{1}
}
encoding_optional_eq: fn(left: I64, right: I64, present: I64, field: I64) -> Bool {
    a: encoding_word(wrapping(left + present))
    a == encoding_word(wrapping(right + present)) && (a == I64{0} || encoding_word(wrapping(left + field)) == encoding_word(wrapping(right + field)))
}
#Export(c) jet_rt_record_new_encoding_cause: fn(kind: I64, os_code: I64, message: I64) -> I64 {
    // Validate exact Int before allocation or ownership changes (CAbi native()).
    code: encoding_optional_input(os_code)
    if (jet_scheduler_native_propagate() != I64{0}) -> return I64{0}
    result: jet_rt_alloc(ENCODING_CAUSE_BYTES, I64{8})
    encoding_store(wrapping(result + ENCODING_CAUSE_KIND), jet_rt_string_clone(kind))
    encoding_store(wrapping(result + ENCODING_CAUSE_OS_PRESENT), if (os_code == I64{0}) -> I64{0} else -> I64{1})
    encoding_store(wrapping(result + ENCODING_CAUSE_OS_CODE), code)
    encoding_store(wrapping(result + ENCODING_CAUSE_MESSAGE), jet_rt_string_clone(message))
    result
}
#Export(c) jet_rt_handle_clone_encoding_cause: fn(value: I64) -> I64 {
    result: jet_rt_alloc(ENCODING_CAUSE_BYTES, I64{8})
    encoding_store(wrapping(result + ENCODING_CAUSE_KIND), jet_rt_string_clone(encoding_word(wrapping(value + ENCODING_CAUSE_KIND))))
    encoding_store(wrapping(result + ENCODING_CAUSE_OS_PRESENT), encoding_word(wrapping(value + ENCODING_CAUSE_OS_PRESENT)))
    encoding_store(wrapping(result + ENCODING_CAUSE_OS_CODE), encoding_word(wrapping(value + ENCODING_CAUSE_OS_CODE)))
    encoding_store(wrapping(result + ENCODING_CAUSE_MESSAGE), jet_rt_string_clone(encoding_word(wrapping(value + ENCODING_CAUSE_MESSAGE))))
    result
}
#Export(c) jet_rt_handle_drop_encoding_cause: fn(value: I64) {
    if (value == I64{0}) -> return
    jet_rt_string_drop(encoding_word(wrapping(value + ENCODING_CAUSE_KIND)))
    jet_rt_string_drop(encoding_word(wrapping(value + ENCODING_CAUSE_MESSAGE)))
    jet_rt_free(value, ENCODING_CAUSE_BYTES, I64{8})
}
#Export(c) jet_rt_handle_eq_encoding_cause: fn(left: I64, right: I64) -> Bool {
    jet_rt_string_eq(encoding_word(wrapping(left + ENCODING_CAUSE_KIND)), encoding_word(wrapping(right + ENCODING_CAUSE_KIND))) &&
        encoding_optional_eq(left, right, ENCODING_CAUSE_OS_PRESENT, ENCODING_CAUSE_OS_CODE) &&
        jet_rt_string_eq(encoding_word(wrapping(left + ENCODING_CAUSE_MESSAGE)), encoding_word(wrapping(right + ENCODING_CAUSE_MESSAGE)))
}
#Export(c) jet_rt_record_get_encoding_cause_kind: fn(value: I64) -> I64 { jet_rt_string_clone(encoding_word(wrapping(value + ENCODING_CAUSE_KIND))) }
#Export(c) jet_rt_record_get_encoding_cause_message: fn(value: I64) -> I64 { jet_rt_string_clone(encoding_word(wrapping(value + ENCODING_CAUSE_MESSAGE))) }
#Export(c) jet_rt_record_get_encoding_cause_os_code: fn(value: I64, some: I64) -> I64 {
    encoding_optional_get(value, ENCODING_CAUSE_OS_PRESENT, ENCODING_CAUSE_OS_CODE, some)
}
#Export(c) jet_rt_record_new_encoding_error: fn(format: I64, kind: I64, offset: I64, line: I64, column: I64, path: I64, reason: I64, cause: I64) -> I64 {
    // CAbiRoutes9466 range_stop, followed by native() in source field order.
    if (format < I64{0} || format > I64{6} || kind < I64{0} || kind > I64{5}) {
        trap_native_index_range_stop()
        if (jet_scheduler_native_propagate() != I64{0}) {
            // The optional cause is adopted; seed unwinding drops it even
            // when validation stops before storing it in the result.
            jet_rt_handle_drop_encoding_cause(cause)
            return I64{0}
        }
    }
    raw_offset: jet_int_owned_to_i64(offset)
    if (jet_scheduler_native_propagate() != I64{0}) {
        jet_rt_handle_drop_encoding_cause(cause)
        return I64{0}
    }
    raw_line: encoding_optional_input(line)
    if (jet_scheduler_native_propagate() != I64{0}) {
        jet_rt_handle_drop_encoding_cause(cause)
        return I64{0}
    }
    raw_column: encoding_optional_input(column)
    if (jet_scheduler_native_propagate() != I64{0}) {
        jet_rt_handle_drop_encoding_cause(cause)
        return I64{0}
    }
    result: jet_rt_alloc(ENCODING_ERROR_BYTES, I64{8})
    encoding_store(wrapping(result + ENCODING_ERROR_FORMAT), format)
    encoding_store(wrapping(result + ENCODING_ERROR_KIND), kind)
    encoding_store(wrapping(result + ENCODING_ERROR_OFFSET), raw_offset)
    encoding_store(wrapping(result + ENCODING_ERROR_LINE_PRESENT), if (line == I64{0}) -> I64{0} else -> I64{1})
    encoding_store(wrapping(result + ENCODING_ERROR_LINE), raw_line)
    encoding_store(wrapping(result + ENCODING_ERROR_COLUMN_PRESENT), if (column == I64{0}) -> I64{0} else -> I64{1})
    encoding_store(wrapping(result + ENCODING_ERROR_COLUMN), raw_column)
    encoding_store(wrapping(result + ENCODING_ERROR_PATH), jet_rt_string_clone(path))
    encoding_store(wrapping(result + ENCODING_ERROR_REASON), jet_rt_string_clone(reason))
    encoding_store(wrapping(result + ENCODING_ERROR_CAUSE), cause) // takes the optional owned handle, never clones m7
    result
}
#Export(c) jet_rt_handle_clone_encoding_error: fn(value: I64) -> I64 {
    result: jet_rt_alloc(ENCODING_ERROR_BYTES, I64{8})
    at := I64{0}
    loop at < ENCODING_ERROR_PATH {
        encoding_store(wrapping(result + at), encoding_word(wrapping(value + at)))
        at += I64{8}
    }
    encoding_store(wrapping(result + ENCODING_ERROR_PATH), jet_rt_string_clone(encoding_word(wrapping(value + ENCODING_ERROR_PATH))))
    encoding_store(wrapping(result + ENCODING_ERROR_REASON), jet_rt_string_clone(encoding_word(wrapping(value + ENCODING_ERROR_REASON))))
    cause: encoding_word(wrapping(value + ENCODING_ERROR_CAUSE))
    encoding_store(wrapping(result + ENCODING_ERROR_CAUSE), if (cause == I64{0}) -> I64{0} else -> jet_rt_handle_clone_encoding_cause(cause))
    result
}
#Export(c) jet_rt_handle_drop_encoding_error: fn(value: I64) {
    if (value == I64{0}) -> return
    jet_rt_string_drop(encoding_word(wrapping(value + ENCODING_ERROR_PATH)))
    jet_rt_string_drop(encoding_word(wrapping(value + ENCODING_ERROR_REASON)))
    jet_rt_handle_drop_encoding_cause(encoding_word(wrapping(value + ENCODING_ERROR_CAUSE)))
    jet_rt_free(value, ENCODING_ERROR_BYTES, I64{8})
}
#Export(c) jet_rt_handle_eq_encoding_error: fn(left: I64, right: I64) -> Bool {
    if (encoding_word(wrapping(left + ENCODING_ERROR_FORMAT)) != encoding_word(wrapping(right + ENCODING_ERROR_FORMAT))) -> return false
    if (encoding_word(wrapping(left + ENCODING_ERROR_KIND)) != encoding_word(wrapping(right + ENCODING_ERROR_KIND))) -> return false
    if (encoding_word(wrapping(left + ENCODING_ERROR_OFFSET)) != encoding_word(wrapping(right + ENCODING_ERROR_OFFSET))) -> return false
    if !encoding_optional_eq(left, right, ENCODING_ERROR_LINE_PRESENT, ENCODING_ERROR_LINE) -> return false
    if !encoding_optional_eq(left, right, ENCODING_ERROR_COLUMN_PRESENT, ENCODING_ERROR_COLUMN) -> return false
    if !jet_rt_string_eq(encoding_word(wrapping(left + ENCODING_ERROR_PATH)), encoding_word(wrapping(right + ENCODING_ERROR_PATH))) -> return false
    if !jet_rt_string_eq(encoding_word(wrapping(left + ENCODING_ERROR_REASON)), encoding_word(wrapping(right + ENCODING_ERROR_REASON))) -> return false
    a: encoding_word(wrapping(left + ENCODING_ERROR_CAUSE))
    b: encoding_word(wrapping(right + ENCODING_ERROR_CAUSE))
    if (a == I64{0} || b == I64{0}) -> return a == b
    jet_rt_handle_eq_encoding_cause(a, b)
}
#Export(c) jet_rt_record_get_encoding_error_format: fn(value: I64) -> I64 { encoding_word(wrapping(value + ENCODING_ERROR_FORMAT)) }
#Export(c) jet_rt_record_get_encoding_error_kind: fn(value: I64) -> I64 { encoding_word(wrapping(value + ENCODING_ERROR_KIND)) }
#Export(c) jet_rt_record_get_encoding_error_byte_offset: fn(value: I64) -> I64 { jet_int_owned_from_i64(encoding_word(wrapping(value + ENCODING_ERROR_OFFSET))) }
#Export(c) jet_rt_record_get_encoding_error_line: fn(value: I64, some: I64) -> I64 { encoding_optional_get(value, ENCODING_ERROR_LINE_PRESENT, ENCODING_ERROR_LINE, some) }
#Export(c) jet_rt_record_get_encoding_error_column: fn(value: I64, some: I64) -> I64 { encoding_optional_get(value, ENCODING_ERROR_COLUMN_PRESENT, ENCODING_ERROR_COLUMN, some) }
#Export(c) jet_rt_record_get_encoding_error_path: fn(value: I64) -> I64 { jet_rt_string_clone(encoding_word(wrapping(value + ENCODING_ERROR_PATH))) }
#Export(c) jet_rt_record_get_encoding_error_reason: fn(value: I64) -> I64 { jet_rt_string_clone(encoding_word(wrapping(value + ENCODING_ERROR_REASON))) }
#Export(c) jet_rt_record_get_encoding_error_cause: fn(value: I64, some: I64) -> I64 {
    cause: encoding_word(wrapping(value + ENCODING_ERROR_CAUSE))
    if (cause == I64{0}) -> return I64{0}
    encoding_store(some, jet_rt_handle_clone_encoding_cause(cause))
    I64{1}
}
encoding_format_label: fn(target: I64, ordinal: I64) {
    if {
        (ordinal == I64{0}) -> rt_text_push_word(target, I64{1313821514}, I64{4}) // JSON
        (ordinal == I64{1}) -> rt_text_push_word(target, I64{327731336010}, I64{5}) // JSONL
        (ordinal == I64{2}) -> rt_text_push_word(target, I64{5657411}, I64{3}) // CSV
        (ordinal == I64{3}) -> rt_text_push_word(target, I64{1280134996}, I64{4}) // TOML
        (ordinal == I64{4}) -> rt_text_push_word(target, I64{1280131417}, I64{4}) // YAML
        (ordinal == I64{5}) -> rt_text_push_word(target, I64{5000536}, I64{3}) // XML
        else -> rt_text_push_word(target, I64{1380926019}, I64{4}) // CBOR; ctor checked tag
    }
}
encoding_kind_label: fn(target: I64, ordinal: I64) {
    if {
        (ordinal == I64{0}) -> rt_text_push_word(target, I64{132359960557907}, I64{6}) // Syntax
        (ordinal == I64{1}) -> {
            rt_text_push_word(target, I64{7310575174812004948}, I64{8}) // Truncate
            rt_text_push_word(target, I64{100}, I64{1})
        }
        (ordinal == I64{2}) -> {
            rt_text_push_word(target, I64{8245933071047814741}, I64{8}) // Unsuppor
            rt_text_push_word(target, I64{6579572}, I64{3})
        }
        (ordinal == I64{3}) -> rt_text_push_word(target, I64{499984984396}, I64{5}) // Limit
        (ordinal == I64{4}) -> rt_text_push_word(target, I64{20297}, I64{2}) // IO
        else -> rt_text_push_word(target, I64{435744240723}, I64{5}) // State; ctor checked tag
    }
}
// One ladder for encoding-family diagnostics. The caller streams format/kind
// labels into target first, avoiding temporary text owners for static labels.
// Optional fields are independent; cause is omitted.
encoding_error_render_tail: fn(target: I64, offset: I64, line_present: I64, line: I64, column_present: I64, column: I64, path: I64, reason: I64) -> I64 {
    rt_text_push_word(target, I64{7310601557487411488}, I64{8}) // " at byte"
    rt_text_push_word(target, I64{32}, I64{1})
    rt_text_push_number(target, offset)
    if (line_present != I64{0}) {
        rt_text_push_word(target, I64{9118724144242732}, I64{7}) // ", line "
        rt_text_push_number(target, line)
    }
    if (column_present != I64{0}) {
        rt_text_push_word(target, I64{7957145225219219500}, I64{8}) // ", column"
        rt_text_push_word(target, I64{32}, I64{1})
        rt_text_push_number(target, column)
    }
    if (rt_text_len(path) != I64{0}) {
        rt_text_push_word(target, I64{9122048314974252}, I64{7}) // ", path "
        jet_rt_string_builder_push(target, path)
    }
    rt_text_push_word(target, I64{8250}, I64{2}) // ": "
    jet_rt_string_builder_push(target, reason)
    jet_rt_string_builder_finish(target)
}
#Export(c) jet_rt_handle_show_encoding_error: fn(value: I64) -> I64 {
    // No cause text, independent line/column, omit empty path.
    target: jet_rt_string_builder_new()
    encoding_format_label(target, encoding_word(wrapping(value + ENCODING_ERROR_FORMAT)))
    rt_text_push_word(target, I64{32}, I64{1})
    encoding_kind_label(target, encoding_word(wrapping(value + ENCODING_ERROR_KIND)))
    encoding_error_render_tail(target, encoding_word(wrapping(value + ENCODING_ERROR_OFFSET)),
        encoding_word(wrapping(value + ENCODING_ERROR_LINE_PRESENT)), encoding_word(wrapping(value + ENCODING_ERROR_LINE)),
        encoding_word(wrapping(value + ENCODING_ERROR_COLUMN_PRESENT)), encoding_word(wrapping(value + ENCODING_ERROR_COLUMN)),
        encoding_word(wrapping(value + ENCODING_ERROR_PATH)), encoding_word(wrapping(value + ENCODING_ERROR_REASON)))
}
#Export(c) jet_rt_handle_display_encoding_error: fn(value: I64) -> I64 { jet_rt_handle_show_encoding_error(value) }
#Export(c) jet_rt_handle_debug_encoding_error: fn(value: I64) -> I64 { jet_rt_handle_show_encoding_error(value) }
