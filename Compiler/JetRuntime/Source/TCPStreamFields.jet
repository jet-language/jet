// CAbiRoutes.rs:12910-12924 lends *const Bool fields, not Bool snapshots.
// Canonical Host409730d54/HostNetCarriers Stream56 retains its FD72 state;
// FD72.closed16 is the only close source of truth. The returned addresses
// borrow initialized low-byte Bool slots for the lifetime of the parent.
#Export(c) fn jet_rt_handle_field_jet_tcp_stream_closed(value: I64) -> I64 { rt_text_word(value) + I64{16} }
#Export(c) fn jet_rt_handle_field_jet_tcp_stream_read_shutdown(value: I64) -> I64 { value + I64{16} }
#Export(c) fn jet_rt_handle_field_jet_tcp_stream_write_shutdown(value: I64) -> I64 { value + I64{24} }
