// Canonical native Dyn provider; DataABI.jet is the only offset/tag table.
// foundation/Dyn.rs:136-148 owns tags and structural PartialEq;
// JetStd/JSONDyn.rs:24-91 owns ordered JSON render semantics.
// Exact Int words retain shared owners. Text constructors clone, sequence
// constructors adopt, sequence getters lend; Dyn is the sole public carrier.
fn data_tree_word(address: I64) -> I64 {
    #Unsafe("address borrows an initialized word in a live native Dyn or List") { return os_load_i64(address) }
}
fn data_tree_store(address: I64, value: I64) {
    #Unsafe("address owns a writable word in a native Dyn or List") { os_store_i64(address, value) }
}
fn data_tree_new(kind: I64, payload: I64) -> I64 {
    tree :: jet_rt_alloc(DATA_TREE_BYTES, I64{8})
    data_tree_store(tree + DATA_TREE_TAG, kind)
    data_tree_store(tree + DATA_TREE_PAYLOAD, payload)
    tree
}
fn data_tree_payload(tree: I64, kind: I64) -> I64 {
    if data_tree_word(tree + DATA_TREE_TAG) != kind {
        rt_record_variant_panic()
        if (jet_scheduler_native_propagate() != I64{0}) -> return I64{0}
    }
    data_tree_word(tree + DATA_TREE_PAYLOAD)
}
fn data_sequence_push(sequence: I64, key: I64, child: I64, entries: Bool) {
    stride :: if entries -> DATA_TREE_ENTRY_BYTES else -> DATA_TREE_ELEMENT_BYTES
    slot :: data_sequence_reserve(sequence, stride)
    if entries {
        data_tree_store(slot + DATA_TREE_ENTRY_KEY, jet_rt_string_clone(key))
        data_tree_store(slot + DATA_TREE_ENTRY_VALUE, child)
    } else { data_tree_store(slot, child) }
    data_tree_store(sequence + DATA_SEQUENCE_LENGTH, data_tree_word(sequence + DATA_SEQUENCE_LENGTH) + I64{1})
}
fn data_sequence_clone(sequence: I64, kind: I64) -> I64 {
    stride :: if kind == DATA_TREE_OBJECT -> DATA_TREE_ENTRY_BYTES else if kind == DATA_TREE_BYTE_LIST -> RT_HOST_U8_STRIDE else -> DATA_TREE_ELEMENT_BYTES
    length :: data_tree_word(sequence + DATA_SEQUENCE_LENGTH)
    result :: data_sequence_new(length, stride)
    source :: data_tree_word(sequence + DATA_SEQUENCE_DATA)
    target :: data_tree_word(result + DATA_SEQUENCE_DATA)
    at := I64{0}
    loop at < length {
        if kind == DATA_TREE_BYTE_LIST { host_u8_put(target, at, host_u8_get(source, at)) } else if kind == DATA_TREE_OBJECT {
            data_tree_store(target + at * stride + DATA_TREE_ENTRY_KEY, jet_rt_string_clone(data_tree_word(source + at * stride + DATA_TREE_ENTRY_KEY)))
            data_tree_store(target + at * stride + DATA_TREE_ENTRY_VALUE, jet_rt_handle_clone_dyn(data_tree_word(source + at * stride + DATA_TREE_ENTRY_VALUE)))
        } else { data_tree_store(target + at * stride, jet_rt_handle_clone_dyn(data_tree_word(source + at * stride))) }
        at += I64{1}
    }
    data_tree_store(result + DATA_SEQUENCE_LENGTH, length)
    result
}
fn data_sequence_drop(sequence: I64, kind: I64) {
    stride :: if kind == DATA_TREE_OBJECT -> DATA_TREE_ENTRY_BYTES else if kind == DATA_TREE_BYTE_LIST -> RT_HOST_U8_STRIDE else -> DATA_TREE_ELEMENT_BYTES
    length :: data_tree_word(sequence + DATA_SEQUENCE_LENGTH)
    capacity :: data_tree_word(sequence + DATA_SEQUENCE_CAPACITY)
    data :: data_tree_word(sequence + DATA_SEQUENCE_DATA)
    at := I64{0}
    loop kind != DATA_TREE_BYTE_LIST && at < length {
        if kind == DATA_TREE_OBJECT {
            jet_rt_string_drop(data_tree_word(data + at * stride + DATA_TREE_ENTRY_KEY))
            jet_rt_handle_drop_dyn(data_tree_word(data + at * stride + DATA_TREE_ENTRY_VALUE))
        } else { jet_rt_handle_drop_dyn(data_tree_word(data + at * stride)) }
        at += I64{1}
    }
    if (capacity != I64{0}) -> jet_rt_free(data, capacity * stride, I64{8})
    jet_rt_free(sequence, DATA_SEQUENCE_BYTES, I64{8})
}
#Export(c) fn jet_rt_handle_clone_dyn(tree: I64) -> I64 {
    kind :: data_tree_word(tree + DATA_TREE_TAG)
    payload := data_tree_word(tree + DATA_TREE_PAYLOAD)
    if kind == DATA_TREE_INT { payload = jet_rt_int_clone(payload) } else if kind == DATA_TREE_NUMBER || kind == DATA_TREE_TEXT { payload = jet_rt_string_clone(payload) } else if kind == DATA_TREE_DATETIME { payload = data_dyn_datetime_clone(payload) } else if kind == DATA_TREE_BYTE_LIST || kind >= DATA_TREE_ARRAY { payload = data_sequence_clone(payload, kind) }
    data_tree_new(kind, payload)
}
#Export(c) fn jet_rt_handle_drop_dyn(tree: I64) {
    if (tree == I64{0}) -> return
    kind :: data_tree_word(tree + DATA_TREE_TAG)
    payload :: data_tree_word(tree + DATA_TREE_PAYLOAD)
    if kind == DATA_TREE_INT { jet_rt_int_drop(payload) } else if kind == DATA_TREE_NUMBER || kind == DATA_TREE_TEXT { jet_rt_string_drop(payload) } else if kind == DATA_TREE_DATETIME { jet_rt_free(payload, DYN_DATETIME_BYTES, I64{8}) } else if kind == DATA_TREE_BYTE_LIST || kind >= DATA_TREE_ARRAY { data_sequence_drop(payload, kind) }
    jet_rt_free(tree, DATA_TREE_BYTES, I64{8})
}
#Export(c) fn jet_rt_handle_eq_dyn(left: I64, right: I64) -> Bool {
    kind :: data_tree_word(left + DATA_TREE_TAG)
    if kind != data_tree_word(right + DATA_TREE_TAG) -> return false
    a :: data_tree_word(left + DATA_TREE_PAYLOAD)
    b :: data_tree_word(right + DATA_TREE_PAYLOAD)
    if kind == DATA_TREE_NULL -> return true
    if kind == DATA_TREE_INT -> return jet_int_compare(a, b) == I64{0}
    // Do not shortcut pointer identity: derived f64 equality rejects NaN even
    // in a tree compared with itself, and treats -0 and +0 as equal.
    if kind == DATA_TREE_FLOAT -> return rt_f64_from_bits(a) == rt_f64_from_bits(b)
    if kind == DATA_TREE_BOOL -> return a == b
    if kind <= DATA_TREE_TEXT -> return jet_rt_string_eq(a, b)
    if kind == DATA_TREE_DATETIME -> return time_glue_equal(a, b, DYN_DATETIME_BYTES)
    length :: data_tree_word(a + DATA_SEQUENCE_LENGTH)
    if length != data_tree_word(b + DATA_SEQUENCE_LENGTH) -> return false
    ap :: data_tree_word(a + DATA_SEQUENCE_DATA)
    bp :: data_tree_word(b + DATA_SEQUENCE_DATA)
    stride :: if kind == DATA_TREE_OBJECT -> DATA_TREE_ENTRY_BYTES else -> DATA_TREE_ELEMENT_BYTES
    at := I64{0}
    loop at < length {
        if kind == DATA_TREE_BYTE_LIST {
            if host_u8_get(ap, at) != host_u8_get(bp, at) -> return false
        } else if kind == DATA_TREE_OBJECT {
            if !jet_rt_string_eq(data_tree_word(ap + at * stride + DATA_TREE_ENTRY_KEY), data_tree_word(bp + at * stride + DATA_TREE_ENTRY_KEY)) -> return false
            if !jet_rt_handle_eq_dyn(data_tree_word(ap + at * stride + DATA_TREE_ENTRY_VALUE), data_tree_word(bp + at * stride + DATA_TREE_ENTRY_VALUE)) -> return false
        } else if !jet_rt_handle_eq_dyn(data_tree_word(ap + at * stride), data_tree_word(bp + at * stride)) -> return false
        at += I64{1}
    }
    true
}
// Stream into one builder; avoid allocating one String for every delimiter.
fn data_tree_quote(target: I64, text: I64) {
    rt_text_push_word(target, I64{34}, I64{1})
    data :: rt_text_data(text)
    length :: rt_text_len(text)
    at := I64{0}
    loop at < length {
        byte :: rt_text_byte(data + at)
        if (byte == I64{34} || byte == I64{92}) {
            rt_text_push_word(target, I64{92}, I64{1})
            rt_text_push_word(target, byte, I64{1})
        } else if (byte == I64{8}) { rt_text_push_word(target, I64{25180}, I64{2}) } else if (byte == I64{9}) { rt_text_push_word(target, I64{29788}, I64{2}) } else if (byte == I64{10}) { rt_text_push_word(target, I64{28252}, I64{2}) } else if (byte == I64{12}) { rt_text_push_word(target, I64{26204}, I64{2}) } else if (byte == I64{13}) { rt_text_push_word(target, I64{29276}, I64{2}) } else if (byte < I64{32}) {
            rt_text_push_word(target, I64{808482140}, I64{4})
            high :: byte >> I64{4}
            low :: byte.bit_and(I64{15})
            rt_text_push_word(target, if (high < I64{10}) -> high + I64{48} else -> high + I64{87}, I64{1})
            rt_text_push_word(target, if (low < I64{10}) -> low + I64{48} else -> low + I64{87}, I64{1})
        } else { rt_text_append_raw_word(target, byte, I64{1}) }
        at += I64{1}
    }
    rt_text_push_word(target, I64{34}, I64{1})
}
fn data_tree_render(target: I64, tree: I64) {
    kind :: data_tree_word(tree + DATA_TREE_TAG)
    value :: data_tree_word(tree + DATA_TREE_PAYLOAD)
    if kind == DATA_TREE_NULL {
        rt_text_push_word(target, I64{1819047278}, I64{4})
        return
    }
    if kind == DATA_TREE_BOOL {
        if (value == I64{0}) { rt_text_push_word(target, I64{435728179558}, I64{5}) } else { rt_text_push_word(target, I64{1702195828}, I64{4}) }
        return
    }
    if kind == DATA_TREE_INT || kind == DATA_TREE_FLOAT {
        if (kind == DATA_TREE_FLOAT && ((value.bit_and(I64{9223372036854775807})) >> I64{52}) == I64{2047}) -> panic("JSON cannot encode a non-finite Float")
        text :: if kind == DATA_TREE_INT -> jet_rt_int_to_string(value) else -> jet_rt_float_debug(rt_f64_from_bits(value))
        jet_rt_string_builder_push(target, text)
        jet_rt_string_drop(text)
        return
    }
    if kind == DATA_TREE_NUMBER {
        jet_rt_string_builder_push(target, value)
        return
    }
    if kind == DATA_TREE_TEXT {
        data_tree_quote(target, value)
        return
    }
    if kind == DATA_TREE_BYTE_LIST {
        text :: data_dyn_bytes_text(value)
        data_tree_quote(target, text)
        jet_rt_string_drop(text)
        return
    }
    if kind == DATA_TREE_DATETIME {
        text :: data_dyn_datetime_text(value)
        data_tree_quote(target, text)
        jet_rt_string_drop(text)
        return
    }
    object :: kind == DATA_TREE_OBJECT
    rt_text_push_word(target, if object -> I64{123} else -> I64{91}, I64{1})
    length :: data_tree_word(value + DATA_SEQUENCE_LENGTH)
    data :: data_tree_word(value + DATA_SEQUENCE_DATA)
    at := I64{0}
    loop at < length {
        if (at != I64{0}) -> rt_text_push_word(target, I64{44}, I64{1})
        if object {
            data_tree_quote(target, data_tree_word(data + at * DATA_TREE_ENTRY_BYTES + DATA_TREE_ENTRY_KEY))
            rt_text_push_word(target, I64{58}, I64{1})
            data_tree_render(target, data_tree_word(data + at * DATA_TREE_ENTRY_BYTES + DATA_TREE_ENTRY_VALUE))
        } else { data_tree_render(target, data_tree_word(data + at * DATA_TREE_ELEMENT_BYTES)) }
        at += I64{1}
    }
    rt_text_push_word(target, if object -> I64{125} else -> I64{93}, I64{1})
}
#Export(c) fn jet_rt_handle_show_dyn(tree: I64) -> I64 {
    kind :: data_tree_word(tree + DATA_TREE_TAG)
    value :: data_tree_word(tree + DATA_TREE_PAYLOAD)
    if kind == DATA_TREE_TEXT || kind == DATA_TREE_NUMBER -> return jet_rt_string_clone(value)
    if kind == DATA_TREE_INT -> return jet_rt_int_to_string(value)
    if kind == DATA_TREE_FLOAT -> return jet_rt_float_debug(rt_f64_from_bits(value))
    if kind == DATA_TREE_BOOL -> return jet_rt_string_clone(if (value == I64{0}) -> rt_static_text("false") else -> rt_static_text("true"))
    if kind == DATA_TREE_BYTE_LIST -> return data_dyn_bytes_text(value)
    if kind == DATA_TREE_DATETIME -> return data_dyn_datetime_text(value)
    jet_rt_handle_debug_dyn(tree)
}
#Export(c) fn jet_rt_handle_display_dyn(tree: I64) -> I64 { jet_rt_handle_show_dyn(tree) }
#Export(c) fn jet_rt_handle_debug_dyn(tree: I64) -> I64 {
    target :: jet_rt_string_builder_new()
    data_tree_render(target, tree)
    jet_rt_string_builder_finish(target)
}
// JetStd/Dyn.rs:228-243 JetDynAccess::field: the first entry with this key is
// cloned out; a missing key or non-object tree is ONE FieldError at path
// `name`. The C adapter lends tree and name; err receives an owned List
// payload of one owned FieldError (CAbiRoutes list_out, length via err_len).
#Export(c) fn jet_dyn_field(tree: I64, name: I64, ok: I64, err: I64, err_len: I64) -> I64 {
    object :: data_tree_word(tree + DATA_TREE_TAG) == DATA_TREE_OBJECT
    if object {
        sequence :: data_tree_word(tree + DATA_TREE_PAYLOAD)
        length :: data_tree_word(sequence + DATA_SEQUENCE_LENGTH)
        data :: data_tree_word(sequence + DATA_SEQUENCE_DATA)
        at := I64{0}
        loop at < length {
            entry :: data + at * DATA_TREE_ENTRY_BYTES
            if jet_rt_string_eq(data_tree_word(entry + DATA_TREE_ENTRY_KEY), name) {
                data_tree_store(ok, jet_rt_handle_clone_dyn(data_tree_word(entry + DATA_TREE_ENTRY_VALUE)))
                return I64{1}
            }
            at += I64{1}
        }
    }
    target :: jet_rt_string_builder_new()
    if object {
        jet_rt_string_builder_push(target, rt_static_text("field `"))
        jet_rt_string_builder_push(target, name)
        jet_rt_string_builder_push(target, rt_static_text("` not found"))
    } else {
        jet_rt_string_builder_push(target, rt_static_text("expected object, got "))
        data_tree_render(target, tree)
    }
    error :: jet_rt_alloc(TEXT_FIELD_BYTES, I64{8})
    text_glue_store(error + TEXT_FIELD_PATH, jet_rt_string_clone(name))
    text_glue_store(error + TEXT_FIELD_REASON, jet_rt_string_builder_finish(target))
    slot :: jet_rt_alloc(I64{8}, I64{8})
    data_tree_store(slot, error)
    data_tree_store(err, slot)
    data_tree_store(err_len, I64{1})
    I64{0}
}
// JetStd/Dyn.rs:344-355 JetDynAccess::to_text: scalar leaves project exactly
// as Show does (jet_rt_handle_show_dyn); Null, Array and Object are None.
#Export(c) fn jet_dyn_to_text(tree: I64, some: I64) -> I64 {
    kind :: data_tree_word(tree + DATA_TREE_TAG)
    if kind == DATA_TREE_NULL || kind >= DATA_TREE_ARRAY -> return I64{0}
    data_tree_store(some, jet_rt_handle_show_dyn(tree))
    I64{1}
}
// JetStd/Dyn.rs render_dyn_json(tree, false, 0) after `prefix`; owned.
fn data_tree_got(prefix: I64, tree: I64) -> I64 {
    target :: jet_rt_string_builder_new()
    jet_rt_string_builder_push(target, prefix)
    data_tree_render(target, tree)
    jet_rt_string_builder_finish(target)
}
// One FieldError at `path` (consumed) with `reason` (consumed) in the
// CAbiRoutes list_out shape jet_dyn_field writes.
fn data_tree_field_error(path: I64, reason: I64, err: I64, err_len: I64) -> I64 {
    error :: jet_rt_alloc(TEXT_FIELD_BYTES, I64{8})
    text_glue_store(error + TEXT_FIELD_PATH, path)
    text_glue_store(error + TEXT_FIELD_REASON, reason)
    slot :: jet_rt_alloc(I64{8}, I64{8})
    data_tree_store(slot, error)
    data_tree_store(err, slot)
    data_tree_store(err_len, I64{1})
    I64{0}
}
// JetStd/Dyn.rs JetDynAccess::at: Array item `index`, counted from the end
// when negative; every failure is one FieldError at path `[index]`.
#Export(c) fn jet_dyn_at(tree: I64, index: I64, ok: I64, err: I64, err_len: I64) -> I64 {
    position :: jet_int_owned_to_i64(index)
    if (jet_scheduler_native_propagate() != I64{0}) -> return I64{0}
    path_text :: jet_rt_string_builder_new()
    rt_text_push_word(path_text, I64{91}, I64{1})
    data_tree_push_count(path_text, position)
    rt_text_push_word(path_text, I64{93}, I64{1})
    path :: jet_rt_string_builder_finish(path_text)
    if data_tree_word(tree + DATA_TREE_TAG) != DATA_TREE_ARRAY -> return data_tree_field_error(path, data_tree_got("expected array, got ", tree), err, err_len)
    length :: data_tree_word(data_tree_word(tree + DATA_TREE_PAYLOAD) + DATA_SEQUENCE_LENGTH)
    found :: data_tree_array_item(tree, if (position < I64{0}) -> length + position else -> position)
    if (found == I64{0}) {
        reason :: jet_rt_string_builder_new()
        jet_rt_string_builder_push(reason, rt_static_text("index "))
        data_tree_push_count(reason, position)
        jet_rt_string_builder_push(reason, rt_static_text(" out of bounds (len "))
        data_tree_push_count(reason, length)
        rt_text_push_word(reason, I64{41}, I64{1})
        return data_tree_field_error(path, jet_rt_string_builder_finish(reason), err, err_len)
    }
    jet_rt_string_drop(path)
    data_tree_store(ok, jet_rt_handle_clone_dyn(found))
    I64{1}
}
fn data_tree_scalar_error(prefix: I64, tree: I64, err: I64, err_len: I64) -> I64 {
    data_tree_field_error(jet_rt_string_clone(rt_static_text("")), data_tree_got(prefix, tree), err, err_len)
}
// JetStd/Dyn.rs JetDynAccess::int: an Int, or a Number lexeme that is an
// exact integer (json_exact_integer_text then the exact parse).
#Export(c) fn jet_dyn_int(tree: I64, ok: I64, err: I64, err_len: I64) -> I64 {
    kind :: data_tree_word(tree + DATA_TREE_TAG)
    payload :: data_tree_word(tree + DATA_TREE_PAYLOAD)
    if kind == DATA_TREE_INT {
        data_tree_store(ok, jet_rt_int_clone(payload))
        return I64{1}
    }
    if kind == DATA_TREE_NUMBER {
        if (codec_integer_text(payload, ok) == I64{0}) {
            jet_rt_string_drop(data_tree_word(ok))
            return data_tree_scalar_error(rt_static_text("expected int, got "), tree, err, err_len)
        }
        text :: data_tree_word(ok)
        parsed :: jet_int_parse(text, ok, err)
        jet_rt_string_drop(text)
        if (parsed != I64{0}) -> return I64{1}
        jet_rt_string_drop(data_tree_word(err))
    }
    data_tree_scalar_error(rt_static_text("expected int, got "), tree, err, err_len)
}
// JetStd/Dyn.rs JetDynAccess::text: only a Text leaf.
#Export(c) fn jet_dyn_text(tree: I64, ok: I64, err: I64, err_len: I64) -> I64 {
    if data_tree_word(tree + DATA_TREE_TAG) != DATA_TREE_TEXT -> return data_tree_scalar_error(rt_static_text("expected text, got "), tree, err, err_len)
    data_tree_store(ok, jet_rt_string_clone(data_tree_word(tree + DATA_TREE_PAYLOAD)))
    I64{1}
}
// JetStd/Dyn.rs JetDynAccess::bool: only a Bool leaf.
#Export(c) fn jet_dyn_bool(tree: I64, ok: I64, err: I64, err_len: I64) -> I64 {
    if data_tree_word(tree + DATA_TREE_TAG) != DATA_TREE_BOOL -> return data_tree_scalar_error(rt_static_text("expected bool, got "), tree, err, err_len)
    rt_text_put(ok, if (data_tree_word(tree + DATA_TREE_PAYLOAD) != I64{0}) -> I64{1} else -> I64{0})
    I64{1}
}
// JetStd/Dyn.rs JetDynAccess::float: a Float, a finite Int, or a finite
// trimmed Number lexeme.
#Export(c) fn jet_dyn_float(tree: I64, ok: I64, err: I64, err_len: I64) -> I64 {
    kind :: data_tree_word(tree + DATA_TREE_TAG)
    payload :: data_tree_word(tree + DATA_TREE_PAYLOAD)
    if kind == DATA_TREE_FLOAT {
        data_tree_store(ok, payload)
        return I64{1}
    }
    if kind == DATA_TREE_INT {
        bits :: rt_f64_bits(jet_int_owned_to_f64(payload))
        if !codec_finite(bits) -> return data_tree_field_error(jet_rt_string_clone(rt_static_text("")), jet_rt_string_clone(rt_static_text("expected float, got out-of-range Int")), err, err_len)
        data_tree_store(ok, bits)
        return I64{1}
    }
    if kind == DATA_TREE_NUMBER {
        if (jet_float_parse(payload, ok, err) != I64{0}) {
            if codec_finite(data_tree_word(ok)) -> return I64{1}
        } else {
            jet_rt_string_drop(data_tree_word(err))
        }
    }
    data_tree_scalar_error(rt_static_text("expected float, got "), tree, err, err_len)
}
// JetStd/Dyn.rs JetDynAccess::equal_unordered: structural equality where an
// Object's entries match in any order (each right entry used once) and NaN
// equals nothing.
#Export(c) fn jet_dyn_equal_unordered(left: I64, right: I64) -> Bool {
    kind :: data_tree_word(left + DATA_TREE_TAG)
    if kind != data_tree_word(right + DATA_TREE_TAG) -> return false
    if kind != DATA_TREE_ARRAY && kind != DATA_TREE_OBJECT -> return jet_rt_handle_eq_dyn(left, right)
    a :: data_tree_word(left + DATA_TREE_PAYLOAD)
    b :: data_tree_word(right + DATA_TREE_PAYLOAD)
    length :: data_tree_word(a + DATA_SEQUENCE_LENGTH)
    if length != data_tree_word(b + DATA_SEQUENCE_LENGTH) -> return false
    ap :: data_tree_word(a + DATA_SEQUENCE_DATA)
    bp :: data_tree_word(b + DATA_SEQUENCE_DATA)
    if kind == DATA_TREE_ARRAY {
        at := I64{0}
        loop at < length {
            if !jet_dyn_equal_unordered(data_tree_word(ap + at * DATA_TREE_ELEMENT_BYTES), data_tree_word(bp + at * DATA_TREE_ELEMENT_BYTES)) -> return false
            at += I64{1}
        }
        return true
    }
    used :: if (length == I64{0}) -> I64{0} else -> jet_rt_alloc(length * I64{8}, I64{8})
    if (length != I64{0}) -> coll_zero(used, length * I64{8})
    same := true
    at := I64{0}
    loop same && at < length {
        entry :: ap + at * DATA_TREE_ENTRY_BYTES
        matched := false
        other := I64{0}
        loop !matched && other < length {
            candidate :: bp + other * DATA_TREE_ENTRY_BYTES
            if (data_tree_word(used + other * I64{8}) == I64{0} && jet_rt_string_eq(data_tree_word(entry + DATA_TREE_ENTRY_KEY), data_tree_word(candidate + DATA_TREE_ENTRY_KEY)) && jet_dyn_equal_unordered(data_tree_word(entry + DATA_TREE_ENTRY_VALUE), data_tree_word(candidate + DATA_TREE_ENTRY_VALUE))) {
                data_tree_store(used + other * I64{8}, I64{1})
                matched = true
            }
            other += I64{1}
        }
        same = matched
        at += I64{1}
    }
    if (length != I64{0}) -> jet_rt_free(used, length * I64{8}, I64{8})
    same
}
// DynKind.rs dyn_kind: the diagnostic name of a runtime tree's kind.
fn data_tree_kind_name(kind: I64) -> I64 {
    if kind == DATA_TREE_NULL -> return rt_static_text("null")
    if kind == DATA_TREE_BOOL -> return rt_static_text("Bool")
    if kind == DATA_TREE_INT -> return rt_static_text("Int")
    if kind == DATA_TREE_FLOAT -> return rt_static_text("Float")
    if kind == DATA_TREE_NUMBER -> return rt_static_text("number")
    if kind == DATA_TREE_TEXT -> return rt_static_text("Text")
    if kind == DATA_TREE_BYTE_LIST -> return rt_static_text("Bytes")
    if kind == DATA_TREE_DATETIME -> return rt_static_text("DateTime")
    if kind == DATA_TREE_ARRAY -> return rt_static_text("a list")
    rt_static_text("an object")
}
// foundation/Dyn.rs get_opt: the borrowed value of the first Object entry
// named `key`; 0 for a miss or a tree that is not an Object.
fn data_tree_object_find(tree: I64, key: I64) -> I64 {
    if data_tree_word(tree + DATA_TREE_TAG) != DATA_TREE_OBJECT -> return I64{0}
    sequence :: data_tree_word(tree + DATA_TREE_PAYLOAD)
    length :: data_tree_word(sequence + DATA_SEQUENCE_LENGTH)
    data :: data_tree_word(sequence + DATA_SEQUENCE_DATA)
    at := I64{0}
    loop at < length {
        entry :: data + at * DATA_TREE_ENTRY_BYTES
        if jet_rt_string_eq(data_tree_word(entry + DATA_TREE_ENTRY_KEY), key) -> return data_tree_word(entry + DATA_TREE_ENTRY_VALUE)
        at += I64{1}
    }
    I64{0}
}
// The borrowed Array item at `position`; 0 when out of range or not an Array.
fn data_tree_array_item(tree: I64, position: I64) -> I64 {
    if data_tree_word(tree + DATA_TREE_TAG) != DATA_TREE_ARRAY -> return I64{0}
    sequence :: data_tree_word(tree + DATA_TREE_PAYLOAD)
    if (position < I64{0} || position >= data_tree_word(sequence + DATA_SEQUENCE_LENGTH)) -> return I64{0}
    data_tree_word(data_tree_word(sequence + DATA_SEQUENCE_DATA) + position * DATA_TREE_ELEMENT_BYTES)
}
// Outcome.rs jet_dyn_stop_message: a builder holding "{site}: ".
fn data_tree_stop_begin(site: I64) -> I64 {
    target :: jet_rt_string_builder_new()
    jet_rt_string_builder_push(target, site)
    jet_rt_string_builder_push(target, rt_static_text(": "))
    target
}
// Pushes the decimal text of a native i64.
fn data_tree_push_count(target: I64, count: I64) {
    exact :: jet_int_owned_from_i64(count)
    text :: jet_rt_int_to_string(exact)
    jet_rt_string_builder_push(target, text)
    jet_rt_string_drop(text)
    jet_rt_int_drop(exact)
}
// DynRuntime.rs jet_dyn_get_key: Some(clone) of the first entry named `key`.
#Export(c) fn jet_dyn_get_key(tree: I64, key: I64, some: I64) -> I64 {
    found :: data_tree_object_find(tree, key)
    if (found == I64{0}) -> return I64{0}
    data_tree_store(some, jet_rt_handle_clone_dyn(found))
    I64{1}
}
// DynRuntime.rs jet_dyn_get_at: Some(clone) of the Array item at `index`.
#Export(c) fn jet_dyn_get_at(tree: I64, index: I64, some: I64) -> I64 {
    position :: jet_int_owned_to_i64(index)
    if (jet_scheduler_native_propagate() != I64{0}) -> return I64{0}
    found :: data_tree_array_item(tree, position)
    if (found == I64{0}) -> return I64{0}
    data_tree_store(some, jet_rt_handle_clone_dyn(found))
    I64{1}
}
// DynRuntime.rs jet_dyn_has: an Object has an entry named `key`.
#Export(c) fn jet_dyn_has(tree: I64, key: I64) -> Bool { data_tree_object_find(tree, key) != I64{0} }
// DynRuntime.rs jet_dyn_keys: an Object's keys in entry order; empty for
// every other kind. Returns the count and an owned word column of texts.
#Export(c) fn jet_dyn_keys(tree: I64, output: I64) -> I64 {
    if data_tree_word(tree + DATA_TREE_TAG) != DATA_TREE_OBJECT {
        data_tree_store(output, I64{0})
        return I64{0}
    }
    sequence :: data_tree_word(tree + DATA_TREE_PAYLOAD)
    length :: data_tree_word(sequence + DATA_SEQUENCE_LENGTH)
    data :: data_tree_word(sequence + DATA_SEQUENCE_DATA)
    words :: if (length == I64{0}) -> I64{0} else -> jet_rt_alloc(length * I64{8}, I64{8})
    at := I64{0}
    loop at < length {
        data_tree_store(words + at * I64{8}, jet_rt_string_clone(data_tree_word(data + at * DATA_TREE_ENTRY_BYTES + DATA_TREE_ENTRY_KEY)))
        at += I64{1}
    }
    data_tree_store(output, words)
    length
}
// DynRuntime.rs jet_dyn_index_key: Ok(clone) of the first entry named `key`,
// else the "{site}: ..." stop text. ok and err share the caller's slot.
#Export(c) fn jet_dyn_index_key(tree: I64, key: I64, site: I64, ok: I64, err: I64) -> I64 {
    found :: data_tree_object_find(tree, key)
    if (found != I64{0}) {
        data_tree_store(ok, jet_rt_handle_clone_dyn(found))
        return I64{1}
    }
    kind :: data_tree_word(tree + DATA_TREE_TAG)
    target :: data_tree_stop_begin(site)
    if kind == DATA_TREE_OBJECT {
        jet_rt_string_builder_push(target, rt_static_text("no key "))
        rt_text_push_rust_debug_str(target, key)
    } else {
        jet_rt_string_builder_push(target, rt_static_text("expected an object, found "))
        jet_rt_string_builder_push(target, data_tree_kind_name(kind))
    }
    data_tree_store(err, jet_rt_string_builder_finish(target))
    I64{0}
}
// DynRuntime.rs jet_dyn_index_at: Ok(clone) of the Array item at `index`,
// else the "{site}: ..." stop text. ok and err share the caller's slot.
#Export(c) fn jet_dyn_index_at(tree: I64, index: I64, site: I64, ok: I64, err: I64) -> I64 {
    position :: jet_int_owned_to_i64(index)
    if (jet_scheduler_native_propagate() != I64{0}) -> return I64{0}
    found :: data_tree_array_item(tree, position)
    if (found != I64{0}) {
        data_tree_store(ok, jet_rt_handle_clone_dyn(found))
        return I64{1}
    }
    kind :: data_tree_word(tree + DATA_TREE_TAG)
    target :: data_tree_stop_begin(site)
    if kind == DATA_TREE_ARRAY {
        jet_rt_string_builder_push(target, rt_static_text("index "))
        data_tree_push_count(target, position)
        jet_rt_string_builder_push(target, rt_static_text(" is out of range (length "))
        data_tree_push_count(target, data_tree_word(data_tree_word(tree + DATA_TREE_PAYLOAD) + DATA_SEQUENCE_LENGTH))
        jet_rt_string_builder_push(target, rt_static_text(")"))
    } else {
        jet_rt_string_builder_push(target, rt_static_text("expected an array, found "))
        jet_rt_string_builder_push(target, data_tree_kind_name(kind))
    }
    data_tree_store(err, jet_rt_string_builder_finish(target))
    I64{0}
}
// Outcome.rs jet_dyn_stop_message: "{site}: {detail}". Native Dyn lowering
// (Lower/Dyn.jet) lends the borrowed site text and a static detail span.
#Export(c) fn jet_rt_dyn_stop_message(site: I64, detail: I64, length: I64) -> I64 {
    target :: jet_rt_string_builder_new()
    jet_rt_string_builder_push(target, site)
    jet_rt_string_builder_push(target, rt_static_text(": "))
    rt_text_append(target, detail, length)
    jet_rt_string_builder_finish(target)
}
#Export(c) fn jet_rt_record_tag_dyn(tree: I64) -> I64 { data_tree_word(tree + DATA_TREE_TAG) }
#Export(c) fn jet_rt_record_new_dyn_null() -> I64 { data_tree_new(DATA_TREE_NULL, I64{0}) }
#Export(c) fn jet_rt_record_new_dyn_bool(value: Bool) -> I64 { data_tree_new(DATA_TREE_BOOL, if value -> I64{1} else -> I64{0}) }
#Export(c) fn jet_rt_record_new_dyn_int(value: I64) -> I64 { data_tree_new(DATA_TREE_INT, jet_rt_int_clone(value)) }
#Export(c) fn jet_rt_record_new_dyn_float(value: Float) -> I64 { data_tree_new(DATA_TREE_FLOAT, rt_f64_bits(value)) }
#Export(c) fn jet_rt_record_new_dyn_number(value: I64) -> I64 { data_tree_new(DATA_TREE_NUMBER, jet_rt_string_clone(value)) }
#Export(c) fn jet_rt_record_new_dyn_text(value: I64) -> I64 { data_tree_new(DATA_TREE_TEXT, jet_rt_string_clone(value)) }
#Export(c) fn jet_rt_record_new_dyn_bytes(value: I64) -> I64 { data_tree_new(DATA_TREE_BYTE_LIST, value) }
#Export(c) fn jet_rt_record_new_dyn_date_time(value: I64) -> I64 { data_tree_new(DATA_TREE_DATETIME, data_dyn_datetime_clone(value)) }
#Export(c) fn jet_rt_record_new_dyn_array(value: I64) -> I64 { data_tree_new(DATA_TREE_ARRAY, value) }
#Export(c) fn jet_rt_record_new_dyn_object(value: I64) -> I64 { data_tree_new(DATA_TREE_OBJECT, value) }
#Export(c) fn jet_rt_record_get_dyn_bool(tree: I64) -> Bool { data_tree_payload(tree, DATA_TREE_BOOL) != I64{0} }
#Export(c) fn jet_rt_record_get_dyn_int(tree: I64) -> I64 {
    payload :: data_tree_payload(tree, DATA_TREE_INT)
    if (jet_scheduler_native_propagate() != I64{0}) -> return I64{0}
    jet_rt_int_clone(payload)
}
#Export(c) fn jet_rt_record_get_dyn_float(tree: I64) -> Float {
    payload :: data_tree_payload(tree, DATA_TREE_FLOAT)
    if (jet_scheduler_native_propagate() != I64{0}) -> return Float{0.0}
    rt_f64_from_bits(payload)
}
#Export(c) fn jet_rt_record_get_dyn_number(tree: I64) -> I64 {
    payload :: data_tree_payload(tree, DATA_TREE_NUMBER)
    if (jet_scheduler_native_propagate() != I64{0}) -> return I64{0}
    jet_rt_string_clone(payload)
}
#Export(c) fn jet_rt_record_get_dyn_text(tree: I64) -> I64 {
    payload :: data_tree_payload(tree, DATA_TREE_TEXT)
    if (jet_scheduler_native_propagate() != I64{0}) -> return I64{0}
    jet_rt_string_clone(payload)
}
#Export(c) fn jet_rt_record_get_dyn_bytes(tree: I64) -> I64 { data_tree_payload(tree, DATA_TREE_BYTE_LIST) }
#Export(c) fn jet_rt_record_get_dyn_date_time(tree: I64) -> I64 {
    payload :: data_tree_payload(tree, DATA_TREE_DATETIME)
    if (jet_scheduler_native_propagate() != I64{0}) -> return I64{0}
    data_dyn_datetime_clone(payload)
}
#Export(c) fn jet_rt_record_get_dyn_array(tree: I64) -> I64 { data_tree_payload(tree, DATA_TREE_ARRAY) }
#Export(c) fn jet_rt_record_get_dyn_object(tree: I64) -> I64 { data_tree_payload(tree, DATA_TREE_OBJECT) }
#Export(c) fn jet_rt_record_seq_list_rec_dyn_new(capacity: I64) -> I64 { data_sequence_new(capacity, DATA_TREE_ELEMENT_BYTES) }
#Export(c) fn jet_rt_record_seq_list_rec_dyn_len(sequence: I64) -> I64 { data_tree_word(sequence + DATA_SEQUENCE_LENGTH) }
#Export(c) fn jet_rt_record_seq_list_rec_dyn_get(sequence: I64, index: I64) -> I64 { data_tree_word(data_sequence_slot(sequence, index, DATA_TREE_ELEMENT_BYTES)) }
#Export(c) fn jet_rt_record_seq_list_rec_dyn_push(sequence: I64, tree: I64) { data_sequence_push(sequence, I64{0}, tree, false) }
#Export(c) fn jet_rt_record_seq_entries_rec_dyn_new(capacity: I64) -> I64 { data_sequence_new(capacity, DATA_TREE_ENTRY_BYTES) }
#Export(c) fn jet_rt_record_seq_entries_rec_dyn_len(sequence: I64) -> I64 { data_tree_word(sequence + DATA_SEQUENCE_LENGTH) }
#Export(c) fn jet_rt_record_seq_entries_rec_dyn_get(sequence: I64, index: I64, key: I64) -> I64 {
    slot :: data_sequence_slot(sequence, index, DATA_TREE_ENTRY_BYTES)
    data_tree_store(key, jet_rt_string_clone(data_tree_word(slot + DATA_TREE_ENTRY_KEY)))
    data_tree_word(slot + DATA_TREE_ENTRY_VALUE)
}
#Export(c) fn jet_rt_record_seq_entries_rec_dyn_push(sequence: I64, key: I64, tree: I64) { data_sequence_push(sequence, key, tree, true) }

// foundation/Dyn.rs:120-133: RFC4648 standard alphabet with padding.
fn data_dyn_bytes_text(sequence: I64) -> I64 {
    length :: data_tree_word(sequence + DATA_SEQUENCE_LENGTH)
    data :: data_tree_word(sequence + DATA_SEQUENCE_DATA)
    alphabet :: rt_static_text("ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/")
    target :: jet_rt_string_builder_new()
    at := I64{0}
    loop at < length {
        a :: host_u8_get(data, at)
        b :: if (at + I64{1} < length) -> host_u8_get(data, at + I64{1}) else -> I64{0}
        c :: if (at + I64{2} < length) -> host_u8_get(data, at + I64{2}) else -> I64{0}
        rt_text_push_scalar(target, rt_text_byte(rt_text_data(alphabet) + (a >> I64{2})))
        rt_text_push_scalar(target, rt_text_byte(rt_text_data(alphabet) + ((a.bit_and(I64{3})) << I64{4}) + (b >> I64{4})))
        rt_text_push_scalar(target, if (at + I64{1} < length) -> rt_text_byte(rt_text_data(alphabet) + ((b.bit_and(I64{15})) << I64{2}) + (c >> I64{6})) else -> I64{61})
        rt_text_push_scalar(target, if (at + I64{2} < length) -> rt_text_byte(rt_text_data(alphabet) + (c.bit_and(I64{63}))) else -> I64{61})
        at += I64{3}
    }
    jet_rt_string_builder_finish(target)
}
fn data_dyn_datetime_clone(value: I64) -> I64 {
    time_glue_clone(value, DYN_DATETIME_BYTES)
}
// foundation/Dyn.rs:32-56. Split seconds into days/remainder before adding
// the frozen i32 offset, retaining Rust's i128 sum at both i64 extremes.
fn data_dyn_datetime_text(value: I64) -> I64 {
    seconds :: data_tree_word(value + DYN_DATETIME_SECS)
    offset :: data_tree_word(value + DYN_DATETIME_OFFSET)
    remainder :: seconds %% I64{86400}
    local_remainder :: (if (remainder < I64{0}) -> remainder + I64{86400} else -> remainder) + offset
    days :: seconds /% I64{86400} + local_remainder /% I64{86400}
    clock_remainder :: local_remainder %% I64{86400}
    clock :: if (clock_remainder < I64{0}) -> clock_remainder + I64{86400} else -> clock_remainder
    z :: days + I64{719468}
    era :: z /% I64{146097}
    doe :: z - era * I64{146097}
    yoe :: (doe - doe /% I64{1460} + doe /% I64{36524} - doe /% I64{146096}) /% I64{365}
    doy :: doe - (I64{365} * yoe + yoe /% I64{4} - yoe /% I64{100})
    mp :: (I64{5} * doy + I64{2}) /% I64{153}
    day :: doy - (I64{153} * mp + I64{2}) /% I64{5} + I64{1}
    month :: mp + (if (mp < I64{10}) -> I64{3} else -> I64{-9})
    year :: yoe + era * I64{400} + (if (month <= I64{2}) -> I64{1} else -> I64{0})
    target :: jet_rt_string_builder_new()
    time_glue_pad(target, year, I64{4})
    rt_text_push_scalar(target, I64{45})
    time_glue_pad(target, month, I64{2})
    rt_text_push_scalar(target, I64{45})
    time_glue_pad(target, day, I64{2})
    rt_text_push_scalar(target, I64{84})
    time_glue_pad(target, clock /% I64{3600}, I64{2})
    rt_text_push_scalar(target, I64{58})
    time_glue_pad(target, clock /% I64{60} %% I64{60}, I64{2})
    rt_text_push_scalar(target, I64{58})
    time_glue_pad(target, if (data_tree_word(value + DYN_DATETIME_LEAP) != I64{0}) -> I64{60} else -> clock %% I64{60}, I64{2})
    nanos :: data_tree_word(value + DYN_DATETIME_NANOS)
    if (nanos != I64{0}) {
        rt_text_push_scalar(target, I64{46})
        digits := I64{9}
        fraction := nanos
        loop fraction %% (I64{10}) == (I64{0}) {
            fraction /= I64{10}
            digits -= I64{1}
        }
        time_glue_pad(target, fraction, digits)
    }
    if (offset == I64{0}) { rt_text_push_scalar(target, I64{90}) } else {
        rt_text_push_scalar(target, if (offset < I64{0}) -> I64{45} else -> I64{43})
        magnitude :: if (offset < I64{0}) -> -offset else -> offset
        time_glue_pad(target, magnitude /% I64{3600}, I64{2})
        rt_text_push_scalar(target, I64{58})
        time_glue_pad(target, magnitude /% I64{60} %% I64{60}, I64{2})
    }
    jet_rt_string_builder_finish(target)
}
