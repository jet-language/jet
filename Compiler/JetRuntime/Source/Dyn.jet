}
// jet_dyn_index_key: Ok(clone) of the first entry named `key`, else the
// "{site}..." stop text. ok and err share the caller's slot.
#Export(c) jet_dyn_index_key: fn(tree: I64, key: I64, site: I64, ok: I64, err: I64) -> I64 {
    found: dyn_object_find(tree, key)
    if (found != I64{0}) {
        dyn_store(ok, jet_rt_handle_clone_dyn(found))
        return I64{1}
    }
    kind: dyn_word(wrapping(tree + DYN_TAG))
    target: dyn_stop_begin(site)
