        if (quotient && y == Float{0.0}) -> return dyn_operator_stop(site, rt_static_text("division by zero"), err)
        value: if {
            sum -> x + y
            difference -> x - y
            product -> x * y
            else -> x / y
        }
        dyn_store(ok, dyn_new(DYN_FLOAT, rt_f64_bits(value)))
