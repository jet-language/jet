// -1, 0 or 1; 2 for an unordered pair (a NaN); 3 when the kinds don't order.
dyn_order: fn(left: I64, right: I64) -> I64 {
    left_kind: dyn_word(wrapping(left + DYN_TAG))
    right_kind: dyn_word(wrapping(right + DYN_TAG))
    a: dyn_word(wrapping(left + DYN_PAYLOAD))
    b: dyn_word(wrapping(right + DYN_PAYLOAD))
    if left_kind == DYN_TEXT && right_kind == DYN_TEXT -> return jet_rt_string_compare(a, b)
    if left_kind == DYN_BYTE_LIST && right_kind == DYN_BYTE_LIST -> return dyn_bytes_order(a, b)
    if left_kind == DYN_DATETIME && right_kind == DYN_DATETIME -> return dyn_datetime_order(a, b)
    if left_kind == DYN_INT && right_kind == DYN_INT -> return jet_int_compare(a, b)
    if left_kind == DYN_INT && right_kind == DYN_FLOAT -> return dyn_int_float_order(a, rt_f64_from_bits(b))
