        sum -> rt_static_text("cannot add ")
        difference -> rt_static_text("cannot subtract ")
        product -> rt_static_text("cannot multiply ")
        quotient -> rt_static_text("cannot divide ")
        else -> rt_static_text("cannot combine ")
