// jet_dyn_compare: `==` and `!=` are structural equality; `< <= > >=` order two
// Texts or two Bytes bytewise, two DateTimes by instant, and Int and Float
// leaves by exact value, where a NaN orders with nothing (every test is false).
// Any other pair stops with "{site}: cannot compare {left kind} with {right
// kind}". ok and err share the caller's slot.
#Export(c) jet_dyn_compare: fn(left: I64, right: I64, op: I64, site: I64, ok: I64, err: I64) -> I64 {
    if jet_rt_string_eq(op, rt_static_text("==")) || jet_rt_string_eq(op, rt_static_text("!=")) {
        equal: jet_rt_handle_eq_dyn(left, right) == jet_rt_string_eq(op, rt_static_text("=="))
        rt_text_put(ok, if equal -> I64{1} else -> I64{0})
        return I64{1}
    }
    order: dyn_order(left, right)
    if (order == I64{3}) -> return dyn_kinds_stop(site, rt_static_text("cannot compare "), left, rt_static_text(" with "), right, err)
    holds: if {
        jet_rt_string_eq(op, rt_static_text("<")) -> order == I64{-1}
        jet_rt_string_eq(op, rt_static_text("<=")) -> order == I64{-1} || order == I64{0}
        jet_rt_string_eq(op, rt_static_text(">")) -> order == I64{1}
        jet_rt_string_eq(op, rt_static_text(">=")) -> order == I64{1} || order == I64{0}
        else -> { return dyn_unknown_operator(site, rt_static_text("unknown Dyn comparison "), op, err) }
    }
    rt_text_put(ok, if holds -> I64{1} else -> I64{0})
    I64{1}
}
// jet_dyn_remove: an Object's first entry named `key` leaves the tree in place;
// Some(that value), else None for a miss or a non-Object.
#Export(c) jet_dyn_remove: fn(tree: I64, key: I64, some: I64) -> I64 {
    if (dyn_word(wrapping(tree + DYN_TAG)) != DYN_OBJECT) -> return I64{0}
    sequence: dyn_word(wrapping(tree + DYN_PAYLOAD))
    length: dyn_word(wrapping(sequence + DATA_SEQUENCE_LENGTH))
    data: dyn_word(wrapping(sequence + DATA_SEQUENCE_DATA))
    at := I64{0}
    loop at < length {
        entry: wrapping(data + at * DYN_ENTRY_BYTES)
        if (jet_rt_string_eq(dyn_word(wrapping(entry + DYN_ENTRY_KEY)), key)) {
            dyn_store(some, dyn_word(wrapping(entry + DYN_ENTRY_VALUE)))
            jet_rt_string_drop(dyn_word(wrapping(entry + DYN_ENTRY_KEY)))
            later := at + I64{1}
            loop later < length {
                from: wrapping(data + later * DYN_ENTRY_BYTES)
                dyn_store(wrapping(wrapping(from - DYN_ENTRY_BYTES) + DYN_ENTRY_KEY), dyn_word(wrapping(from + DYN_ENTRY_KEY)))
                dyn_store(wrapping(wrapping(from - DYN_ENTRY_BYTES) + DYN_ENTRY_VALUE), dyn_word(wrapping(from + DYN_ENTRY_VALUE)))
                later += I64{1}
            }
            dyn_store(wrapping(sequence + DATA_SEQUENCE_LENGTH), length - I64{1})
            return I64{1}
        }
        at += I64{1}
    }
    I64{0}
}
// A refused set_path step: the owned `value` is dropped and err takes the
// "{site}: ..." stop text; the builder already holds the step detail.
dyn_set_refused: fn(target: I64, value: I64, err: I64) -> I64 {
    jet_rt_handle_drop_dyn(value)
    dyn_store(err, jet_rt_string_builder_finish(target))
    I64{0}
}
// jet_dyn_set_path over `steps`, a runtime Array of Text (key) and Int (index)
// trees. A key missing at the last step is appended; the reached node takes the
// owned `value` (their contents swap, and the value's shell drops the replaced
// contents). Every refusal names its step as Rust does.
#Export(c) jet_dyn_set_path: fn(tree: I64, steps: I64, value: I64, site: I64, err: I64) -> I64 {
    sequence: dyn_word(wrapping(steps + DYN_PAYLOAD))
    count: dyn_word(wrapping(sequence + DATA_SEQUENCE_LENGTH))
    data: dyn_word(wrapping(sequence + DATA_SEQUENCE_DATA))
    node := tree
    at := I64{0}
    loop at < count {
        step: dyn_word(wrapping(data + at * DYN_ELEMENT_BYTES))
        kind: dyn_word(wrapping(node + DYN_TAG))
        if (dyn_word(wrapping(step + DYN_TAG)) == DYN_TEXT) {
            key: dyn_word(wrapping(step + DYN_PAYLOAD))
            if (kind != DYN_OBJECT) {
                target: dyn_stop_begin(site)
                jet_rt_string_builder_push(target, rt_static_text("expected an object, found "))
                jet_rt_string_builder_push(target, dyn_kind_name(kind))
                return dyn_set_refused(target, value, err)
            }
            found: dyn_object_find(node, key)
            if (found == I64{0}) {
                if (at + I64{1} == count) {
                    data_sequence_push(dyn_word(wrapping(node + DYN_PAYLOAD)), key, value, true)
                    return I64{1}
                }
                target: dyn_stop_begin(site)
                jet_rt_string_builder_push(target, rt_static_text("no key "))
                rt_text_push_rust_debug_str(target, key)
                return dyn_set_refused(target, value, err)
            }
            node = found
        } else {
            position: jet_int_owned_to_i64(dyn_word(wrapping(step + DYN_PAYLOAD)))
            if (jet_scheduler_native_propagate() != I64{0}) {
                jet_rt_handle_drop_dyn(value)
                return I64{0}
            }
            if (kind != DYN_ARRAY) {
                target: dyn_stop_begin(site)
                jet_rt_string_builder_push(target, rt_static_text("expected an array, found "))
                jet_rt_string_builder_push(target, dyn_kind_name(kind))
                return dyn_set_refused(target, value, err)
            }
            found: dyn_array_item(node, position)
            if (found == I64{0}) {
                target: dyn_stop_begin(site)
                jet_rt_string_builder_push(target, rt_static_text("index "))
                dyn_push_count(target, position)
                jet_rt_string_builder_push(target, rt_static_text(" is out of range (length "))
                dyn_push_count(target, dyn_word(wrapping(dyn_word(wrapping(node + DYN_PAYLOAD)) + DATA_SEQUENCE_LENGTH)))
                jet_rt_string_builder_push(target, rt_static_text(")"))
                return dyn_set_refused(target, value, err)
            }
            node = found
        }
        at += I64{1}
    }
    replaced_kind: dyn_word(wrapping(node + DYN_TAG))
    replaced_payload: dyn_word(wrapping(node + DYN_PAYLOAD))
    dyn_store(wrapping(node + DYN_TAG), dyn_word(wrapping(value + DYN_TAG)))
    dyn_store(wrapping(node + DYN_PAYLOAD), dyn_word(wrapping(value + DYN_PAYLOAD)))
    dyn_store(wrapping(value + DYN_TAG), replaced_kind)
    dyn_store(wrapping(value + DYN_PAYLOAD), replaced_payload)
    jet_rt_handle_drop_dyn(value)
    I64{1}
}
// jet_dyn_stop_message: "{site}: {detail}". Native Dyn lowering (Lower/Dyn.jet)
// lends the borrowed site text and a static detail span.
#Export(c) jet_rt_dyn_stop_message: fn(site: I64, detail: I64, length: I64) -> I64 {
    target: jet_rt_string_builder_new()
    jet_rt_string_builder_push(target, site)
    jet_rt_string_builder_push(target, rt_static_text(": "))
    rt_text_append(target, detail, length)
    jet_rt_string_builder_finish(target)
}
#Export(c) jet_rt_record_tag_dyn: fn(tree: I64) -> I64 { dyn_word(wrapping(tree + DYN_TAG)) }
#Export(c) jet_rt_record_new_dyn_null: fn() -> I64 { dyn_new(DYN_NULL, I64{0}) }
#Export(c) jet_rt_record_new_dyn_bool: fn(value: Bool) -> I64 { dyn_new(DYN_BOOL, if value -> I64{1} else -> I64{0}) }
#Export(c) jet_rt_record_new_dyn_int: fn(value: I64) -> I64 { dyn_new(DYN_INT, jet_rt_int_clone(value)) }
#Export(c) jet_rt_record_new_dyn_float: fn(value: Float) -> I64 { dyn_new(DYN_FLOAT, rt_f64_bits(value)) }
#Export(c) jet_rt_record_new_dyn_number: fn(value: I64) -> I64 { dyn_new(DYN_NUMBER, jet_rt_string_clone(value)) }
#Export(c) jet_rt_record_new_dyn_text: fn(value: I64) -> I64 { dyn_new(DYN_TEXT, jet_rt_string_clone(value)) }
#Export(c) jet_rt_record_new_dyn_bytes: fn(value: I64) -> I64 { dyn_new(DYN_BYTE_LIST, value) }
#Export(c) jet_rt_record_new_dyn_date_time: fn(value: I64) -> I64 { dyn_new(DYN_DATETIME, data_dyn_datetime_clone(value)) }
#Export(c) jet_rt_record_new_dyn_array: fn(value: I64) -> I64 { dyn_new(DYN_ARRAY, value) }
#Export(c) jet_rt_record_new_dyn_object: fn(value: I64) -> I64 { dyn_new(DYN_OBJECT, value) }
#Export(c) jet_rt_record_get_dyn_bool: fn(tree: I64) -> Bool { dyn_payload(tree, DYN_BOOL) != I64{0} }
#Export(c) jet_rt_record_get_dyn_int: fn(tree: I64) -> I64 {
    payload: dyn_payload(tree, DYN_INT)
    if (jet_scheduler_native_propagate() != I64{0}) -> return I64{0}
    jet_rt_int_clone(payload)
}
#Export(c) jet_rt_record_get_dyn_float: fn(tree: I64) -> Float {
    payload: dyn_payload(tree, DYN_FLOAT)
    if (jet_scheduler_native_propagate() != I64{0}) -> return Float{0.0}
    rt_f64_from_bits(payload)
}
#Export(c) jet_rt_record_get_dyn_number: fn(tree: I64) -> I64 {
    payload: dyn_payload(tree, DYN_NUMBER)
    if (jet_scheduler_native_propagate() != I64{0}) -> return I64{0}
    jet_rt_string_clone(payload)
}
#Export(c) jet_rt_record_get_dyn_text: fn(tree: I64) -> I64 {
    payload: dyn_payload(tree, DYN_TEXT)
    if (jet_scheduler_native_propagate() != I64{0}) -> return I64{0}
    jet_rt_string_clone(payload)
}
#Export(c) jet_rt_record_get_dyn_bytes: fn(tree: I64) -> I64 { dyn_payload(tree, DYN_BYTE_LIST) }
#Export(c) jet_rt_record_get_dyn_date_time: fn(tree: I64) -> I64 {
    payload: dyn_payload(tree, DYN_DATETIME)
    if (jet_scheduler_native_propagate() != I64{0}) -> return I64{0}
    data_dyn_datetime_clone(payload)
}
#Export(c) jet_rt_record_get_dyn_array: fn(tree: I64) -> I64 { dyn_payload(tree, DYN_ARRAY) }
#Export(c) jet_rt_record_get_dyn_object: fn(tree: I64) -> I64 { dyn_payload(tree, DYN_OBJECT) }
#Export(c) jet_rt_record_seq_list_rec_dyn_new: fn(capacity: I64) -> I64 { data_sequence_new(capacity, DYN_ELEMENT_BYTES) }
#Export(c) jet_rt_record_seq_list_rec_dyn_len: fn(sequence: I64) -> I64 { dyn_word(wrapping(sequence + DATA_SEQUENCE_LENGTH)) }
#Export(c) jet_rt_record_seq_list_rec_dyn_get: fn(sequence: I64, index: I64) -> I64 { dyn_word(data_sequence_slot(sequence, index, DYN_ELEMENT_BYTES)) }
#Export(c) jet_rt_record_seq_list_rec_dyn_push: fn(sequence: I64, tree: I64) { data_sequence_push(sequence, I64{0}, tree, false) }
#Export(c) jet_rt_record_seq_entries_rec_dyn_new: fn(capacity: I64) -> I64 { data_sequence_new(capacity, DYN_ENTRY_BYTES) }
#Export(c) jet_rt_record_seq_entries_rec_dyn_len: fn(sequence: I64) -> I64 { dyn_word(wrapping(sequence + DATA_SEQUENCE_LENGTH)) }
#Export(c) jet_rt_record_seq_entries_rec_dyn_get: fn(sequence: I64, index: I64, key: I64) -> I64 {
    slot: data_sequence_slot(sequence, index, DYN_ENTRY_BYTES)
    dyn_store(key, jet_rt_string_clone(dyn_word(wrapping(slot + DYN_ENTRY_KEY))))
    dyn_word(wrapping(slot + DYN_ENTRY_VALUE))
}
#Export(c) jet_rt_record_seq_entries_rec_dyn_push: fn(sequence: I64, key: I64, tree: I64) { data_sequence_push(sequence, key, tree, true) }

// RFC4648 standard alphabet with padding.
data_dyn_bytes_text: fn(sequence: I64) -> I64 {
    length: dyn_word(wrapping(sequence + DATA_SEQUENCE_LENGTH))
    data: dyn_word(wrapping(sequence + DATA_SEQUENCE_DATA))
    alphabet: rt_static_text("ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/")
    target: jet_rt_string_builder_new()
    at := I64{0}
    loop at < length {
        a: host_u8_get(data, at)
        b: if (at + I64{1} < length) -> host_u8_get(data, at + I64{1}) else -> I64{0}
        c: if (at + I64{2} < length) -> host_u8_get(data, at + I64{2}) else -> I64{0}
        rt_text_push_scalar(target, rt_text_byte(wrapping(rt_text_data(alphabet) + (a >> I64{2}))))
        rt_text_push_scalar(target, rt_text_byte(wrapping(wrapping(rt_text_data(alphabet) + ((a.bit_and(I64{3})) << I64{4})) + (b >> I64{4}))))
        rt_text_push_scalar(target, if (at + I64{1} < length) -> rt_text_byte(wrapping(wrapping(rt_text_data(alphabet) + ((b.bit_and(I64{15})) << I64{2})) + (c >> I64{6}))) else -> I64{61})
        rt_text_push_scalar(target, if (at + I64{2} < length) -> rt_text_byte(wrapping(rt_text_data(alphabet) + (c.bit_and(I64{63})))) else -> I64{61})
        at += I64{3}
    }
    jet_rt_string_builder_finish(target)
}
data_dyn_datetime_clone: fn(value: I64) -> I64 {
    time_glue_clone(value, DYN_DATETIME_BYTES)
}
// Split seconds into days/remainder before adding the frozen i32 offset,
// retaining Rust's i128 sum at both i64 extremes.
data_dyn_datetime_text: fn(value: I64) -> I64 {
    seconds: dyn_word(wrapping(value + DYN_DATETIME_SECS))
    offset: dyn_word(wrapping(value + DYN_DATETIME_OFFSET))
    remainder: seconds %% I64{86400}
    local_remainder: (if (remainder < I64{0}) -> remainder + I64{86400} else -> remainder) + offset
    days: seconds /% I64{86400} + local_remainder /% I64{86400}
    clock_remainder: local_remainder %% I64{86400}
    clock: if (clock_remainder < I64{0}) -> clock_remainder + I64{86400} else -> clock_remainder
    z: days + I64{719468}
    era: z /% I64{146097}
    doe: z - era * I64{146097}
    yoe: (doe - doe /% I64{1460} + doe /% I64{36524} - doe /% I64{146096}) /% I64{365}
    doy: doe - (I64{365} * yoe + yoe /% I64{4} - yoe /% I64{100})
    mp: (I64{5} * doy + I64{2}) /% I64{153}
    day: doy - (I64{153} * mp + I64{2}) /% I64{5} + I64{1}
    month: mp + (if (mp < I64{10}) -> I64{3} else -> I64{-9})
    year: yoe + era * I64{400} + (if (month <= I64{2}) -> I64{1} else -> I64{0})
    target: jet_rt_string_builder_new()
    time_glue_pad(target, year, I64{4})
    rt_text_push_scalar(target, I64{45})
    time_glue_pad(target, month, I64{2})
    rt_text_push_scalar(target, I64{45})
    time_glue_pad(target, day, I64{2})
    rt_text_push_scalar(target, I64{84})
    time_glue_pad(target, clock /% I64{3600}, I64{2})
    rt_text_push_scalar(target, I64{58})
    time_glue_pad(target, clock /% I64{60} %% I64{60}, I64{2})
    rt_text_push_scalar(target, I64{58})
    time_glue_pad(target, if (dyn_word(wrapping(value + DYN_DATETIME_LEAP)) != I64{0}) -> I64{60} else -> clock %% I64{60}, I64{2})
    nanos: dyn_word(wrapping(value + DYN_DATETIME_NANOS))
    if (nanos != I64{0}) {
        rt_text_push_scalar(target, I64{46})
        digits := I64{9}
        fraction := nanos
        loop fraction %% (I64{10}) == (I64{0}) {
            fraction /= I64{10}
            digits -= I64{1}
        }
        time_glue_pad(target, fraction, digits)
    }
    if (offset == I64{0}) { rt_text_push_scalar(target, I64{90}) } else {
        rt_text_push_scalar(target, if (offset < I64{0}) -> I64{45} else -> I64{43})
        magnitude: if (offset < I64{0}) -> -offset else -> offset
        time_glue_pad(target, magnitude /% I64{3600}, I64{2})
        rt_text_push_scalar(target, I64{58})
        time_glue_pad(target, magnitude /% I64{60} %% I64{60}, I64{2})
    }
    jet_rt_string_builder_finish(target)
}
