// Canonical native Dyn provider; DataABI.jet is the only offset/tag table. The
// Rust original owns tags and structural PartialEq; the Rust original owns
// ordered JSON render semantics. Exact Int words retain shared owners. Text
// constructors clone, sequence constructors adopt, sequence getters lend; Dyn
// is the sole public carrier.
dyn_word: fn(address: I64) -> I64 {
    #Unsafe("address borrows an initialized word in a live native Dyn or List") { return os_load_i64(address) }
}
dyn_store: fn(address: I64, value: I64) {
    #Unsafe("address owns a writable word in a native Dyn or List") { os_store_i64(address, value) }
}
dyn_new: fn(kind: I64, payload: I64) -> I64 {
    tree: jet_rt_alloc(DYN_BYTES, I64{8})
    dyn_store(wrapping(tree + DYN_TAG), kind)
    dyn_store(wrapping(tree + DYN_PAYLOAD), payload)
    tree
}
dyn_payload: fn(tree: I64, kind: I64) -> I64 {
    if dyn_word(wrapping(tree + DYN_TAG)) != kind {
        rt_record_variant_panic()
        if (jet_scheduler_native_propagate() != I64{0}) -> return I64{0}
    }
    dyn_word(wrapping(tree + DYN_PAYLOAD))
}
data_sequence_push: fn(sequence: I64, key: I64, child: I64, entries: Bool) {
    stride: if entries -> DYN_ENTRY_BYTES else -> DYN_ELEMENT_BYTES
    slot: data_sequence_reserve(sequence, stride)
    if entries {
        dyn_store(wrapping(slot + DYN_ENTRY_KEY), jet_rt_string_clone(key))
        dyn_store(wrapping(slot + DYN_ENTRY_VALUE), child)
    } else { dyn_store(slot, child) }
    dyn_store(wrapping(sequence + DATA_SEQUENCE_LENGTH), dyn_word(wrapping(sequence + DATA_SEQUENCE_LENGTH)) + I64{1})
}
data_sequence_clone: fn(sequence: I64, kind: I64) -> I64 {
    stride: if kind == DYN_OBJECT -> DYN_ENTRY_BYTES else if kind == DYN_BYTE_LIST -> RT_HOST_U8_STRIDE else -> DYN_ELEMENT_BYTES
    length: dyn_word(wrapping(sequence + DATA_SEQUENCE_LENGTH))
    result: data_sequence_new(length, stride)
    source: dyn_word(wrapping(sequence + DATA_SEQUENCE_DATA))
    target: dyn_word(wrapping(result + DATA_SEQUENCE_DATA))
    at := I64{0}
    loop at < length {
        if kind == DYN_BYTE_LIST { host_u8_put(target, at, host_u8_get(source, at)) } else if kind == DYN_OBJECT {
            dyn_store(wrapping(wrapping(target + at * stride) + DYN_ENTRY_KEY), jet_rt_string_clone(dyn_word(wrapping(wrapping(source + at * stride) + DYN_ENTRY_KEY))))
            dyn_store(wrapping(wrapping(target + at * stride) + DYN_ENTRY_VALUE), jet_rt_handle_clone_dyn(dyn_word(wrapping(wrapping(source + at * stride) + DYN_ENTRY_VALUE))))
        } else { dyn_store(wrapping(target + at * stride), jet_rt_handle_clone_dyn(dyn_word(wrapping(source + at * stride)))) }
        at += I64{1}
    }
    dyn_store(wrapping(result + DATA_SEQUENCE_LENGTH), length)
    result
}
data_sequence_drop: fn(sequence: I64, kind: I64) {
    stride: if kind == DYN_OBJECT -> DYN_ENTRY_BYTES else if kind == DYN_BYTE_LIST -> RT_HOST_U8_STRIDE else -> DYN_ELEMENT_BYTES
    length: dyn_word(wrapping(sequence + DATA_SEQUENCE_LENGTH))
    capacity: dyn_word(wrapping(sequence + DATA_SEQUENCE_CAPACITY))
    data: dyn_word(wrapping(sequence + DATA_SEQUENCE_DATA))
    at := I64{0}
    loop kind != DYN_BYTE_LIST && at < length {
        if kind == DYN_OBJECT {
            jet_rt_string_drop(dyn_word(wrapping(wrapping(data + at * stride) + DYN_ENTRY_KEY)))
            jet_rt_handle_drop_dyn(dyn_word(wrapping(wrapping(data + at * stride) + DYN_ENTRY_VALUE)))
        } else { jet_rt_handle_drop_dyn(dyn_word(wrapping(data + at * stride))) }
        at += I64{1}
    }
    if (capacity != I64{0}) -> jet_rt_free(data, capacity * stride, I64{8})
    jet_rt_free(sequence, DATA_SEQUENCE_BYTES, I64{8})
}
#Export(c) jet_rt_handle_clone_dyn: fn(tree: I64) -> I64 {
    kind: dyn_word(wrapping(tree + DYN_TAG))
    payload := dyn_word(wrapping(tree + DYN_PAYLOAD))
    if kind == DYN_INT { payload = jet_rt_int_clone(payload) } else if kind == DYN_NUMBER || kind == DYN_TEXT { payload = jet_rt_string_clone(payload) } else if kind == DYN_DATETIME { payload = data_dyn_datetime_clone(payload) } else if kind == DYN_BYTE_LIST || kind >= DYN_ARRAY { payload = data_sequence_clone(payload, kind) }
    dyn_new(kind, payload)
}
#Export(c) jet_rt_handle_drop_dyn: fn(tree: I64) {
    if (tree == I64{0}) -> return
    kind: dyn_word(wrapping(tree + DYN_TAG))
    payload: dyn_word(wrapping(tree + DYN_PAYLOAD))
    if kind == DYN_INT { jet_rt_int_drop(payload) } else if kind == DYN_NUMBER || kind == DYN_TEXT { jet_rt_string_drop(payload) } else if kind == DYN_DATETIME { jet_rt_free(payload, DYN_DATETIME_BYTES, I64{8}) } else if kind == DYN_BYTE_LIST || kind >= DYN_ARRAY { data_sequence_drop(payload, kind) }
    jet_rt_free(tree, DYN_BYTES, I64{8})
}
#Export(c) jet_rt_handle_eq_dyn: fn(left: I64, right: I64) -> Bool {
    kind: dyn_word(wrapping(left + DYN_TAG))
    if kind != dyn_word(wrapping(right + DYN_TAG)) -> return false
    a: dyn_word(wrapping(left + DYN_PAYLOAD))
    b: dyn_word(wrapping(right + DYN_PAYLOAD))
    if kind == DYN_NULL -> return true
    if kind == DYN_INT -> return jet_int_compare(a, b) == I64{0}
    // Do not shortcut pointer identity: derived f64 equality rejects NaN even
    // in a tree compared with itself, and treats -0 and +0 as equal.
    if kind == DYN_FLOAT -> return rt_f64_from_bits(a) == rt_f64_from_bits(b)
    if kind == DYN_BOOL -> return a == b
    if kind <= DYN_TEXT -> return jet_rt_string_eq(a, b)
    if kind == DYN_DATETIME -> return time_glue_equal(a, b, DYN_DATETIME_BYTES)
    length: dyn_word(wrapping(a + DATA_SEQUENCE_LENGTH))
    if length != dyn_word(wrapping(b + DATA_SEQUENCE_LENGTH)) -> return false
    ap: dyn_word(wrapping(a + DATA_SEQUENCE_DATA))
    bp: dyn_word(wrapping(b + DATA_SEQUENCE_DATA))
    stride: if kind == DYN_OBJECT -> DYN_ENTRY_BYTES else -> DYN_ELEMENT_BYTES
    at := I64{0}
    loop at < length {
        if kind == DYN_BYTE_LIST {
            if host_u8_get(ap, at) != host_u8_get(bp, at) -> return false
        } else if kind == DYN_OBJECT {
            if !jet_rt_string_eq(dyn_word(wrapping(wrapping(ap + at * stride) + DYN_ENTRY_KEY)), dyn_word(wrapping(wrapping(bp + at * stride) + DYN_ENTRY_KEY))) -> return false
            if !jet_rt_handle_eq_dyn(dyn_word(wrapping(wrapping(ap + at * stride) + DYN_ENTRY_VALUE)), dyn_word(wrapping(wrapping(bp + at * stride) + DYN_ENTRY_VALUE))) -> return false
        } else if !jet_rt_handle_eq_dyn(dyn_word(wrapping(ap + at * stride)), dyn_word(wrapping(bp + at * stride))) -> return false
        at += I64{1}
    }
    true
}
// Stream into one builder; avoid allocating one String for every delimiter.
dyn_quote: fn(target: I64, text: I64) {
    rt_text_push_word(target, I64{34}, I64{1})
    data: rt_text_data(text)
    length: rt_text_len(text)
    at := I64{0}
    loop at < length {
        byte: rt_text_byte(wrapping(data + at))
        if (byte == I64{34} || byte == I64{92}) {
            rt_text_push_word(target, I64{92}, I64{1})
            rt_text_push_word(target, byte, I64{1})
        } else if (byte == I64{8}) { rt_text_push_word(target, I64{25180}, I64{2}) } else if (byte == I64{9}) { rt_text_push_word(target, I64{29788}, I64{2}) } else if (byte == I64{10}) { rt_text_push_word(target, I64{28252}, I64{2}) } else if (byte == I64{12}) { rt_text_push_word(target, I64{26204}, I64{2}) } else if (byte == I64{13}) { rt_text_push_word(target, I64{29276}, I64{2}) } else if (byte < I64{32}) {
            rt_text_push_word(target, I64{808482140}, I64{4})
            high: byte >> I64{4}
            low: byte.bit_and(I64{15})
            rt_text_push_word(target, if (high < I64{10}) -> high + I64{48} else -> high + I64{87}, I64{1})
            rt_text_push_word(target, if (low < I64{10}) -> low + I64{48} else -> low + I64{87}, I64{1})
        } else { rt_text_append_raw_word(target, byte, I64{1}) }
        at += I64{1}
    }
    rt_text_push_word(target, I64{34}, I64{1})
}
dyn_render: fn(target: I64, tree: I64) {
    kind: dyn_word(wrapping(tree + DYN_TAG))
    value: dyn_word(wrapping(tree + DYN_PAYLOAD))
    if kind == DYN_NULL {
        rt_text_push_word(target, I64{1819047278}, I64{4})
        return
    }
    if kind == DYN_BOOL {
        if (value == I64{0}) { rt_text_push_word(target, I64{435728179558}, I64{5}) } else { rt_text_push_word(target, I64{1702195828}, I64{4}) }
        return
    }
    if kind == DYN_INT || kind == DYN_FLOAT {
        if (kind == DYN_FLOAT && ((value.bit_and(I64{9223372036854775807})) >> I64{52}) == I64{2047}) -> panic("JSON cannot encode a non-finite Float")
        text: if kind == DYN_INT -> jet_rt_int_to_string(value) else -> jet_rt_float_debug(rt_f64_from_bits(value))
        jet_rt_string_builder_push(target, text)
        jet_rt_string_drop(text)
        return
    }
    if kind == DYN_NUMBER {
        jet_rt_string_builder_push(target, value)
        return
    }
    if kind == DYN_TEXT {
        dyn_quote(target, value)
        return
    }
    if kind == DYN_BYTE_LIST {
        text: data_dyn_bytes_text(value)
        dyn_quote(target, text)
        jet_rt_string_drop(text)
        return
    }
    if kind == DYN_DATETIME {
        text: data_dyn_datetime_text(value)
        dyn_quote(target, text)
        jet_rt_string_drop(text)
        return
    }
    object: kind == DYN_OBJECT
    rt_text_push_word(target, if object -> I64{123} else -> I64{91}, I64{1})
    length: dyn_word(wrapping(value + DATA_SEQUENCE_LENGTH))
    data: dyn_word(wrapping(value + DATA_SEQUENCE_DATA))
    at := I64{0}
    loop at < length {
        if (at != I64{0}) -> rt_text_push_word(target, I64{44}, I64{1})
        if object {
            dyn_quote(target, dyn_word(wrapping(wrapping(data + at * DYN_ENTRY_BYTES) + DYN_ENTRY_KEY)))
            rt_text_push_word(target, I64{58}, I64{1})
            dyn_render(target, dyn_word(wrapping(wrapping(data + at * DYN_ENTRY_BYTES) + DYN_ENTRY_VALUE)))
        } else { dyn_render(target, dyn_word(wrapping(data + at * DYN_ELEMENT_BYTES))) }
        at += I64{1}
    }
    rt_text_push_word(target, if object -> I64{125} else -> I64{93}, I64{1})
}
#Export(c) jet_rt_handle_show_dyn: fn(tree: I64) -> I64 {
    kind: dyn_word(wrapping(tree + DYN_TAG))
    value: dyn_word(wrapping(tree + DYN_PAYLOAD))
    if kind == DYN_TEXT || kind == DYN_NUMBER -> return jet_rt_string_clone(value)
    if kind == DYN_INT -> return jet_rt_int_to_string(value)
    if kind == DYN_FLOAT -> return jet_rt_float_debug(rt_f64_from_bits(value))
    if kind == DYN_BOOL -> return jet_rt_string_clone(if (value == I64{0}) -> rt_static_text("false") else -> rt_static_text("true"))
    if kind == DYN_BYTE_LIST -> return data_dyn_bytes_text(value)
    if kind == DYN_DATETIME -> return data_dyn_datetime_text(value)
    jet_rt_handle_debug_dyn(tree)
}
#Export(c) jet_rt_handle_display_dyn: fn(tree: I64) -> I64 { jet_rt_handle_show_dyn(tree) }
#Export(c) jet_rt_handle_debug_dyn: fn(tree: I64) -> I64 {
    target: jet_rt_string_builder_new()
    dyn_render(target, tree)
    jet_rt_string_builder_finish(target)
}
// JetDynAccess::field: the first entry with this key is cloned out; a missing
// key or non-object tree is ONE FieldError at path `name`. The C adapter lends
// tree and name; err receives an owned List payload of one owned FieldError
// (CAbiRoutes list_out, length via err_len).
#Export(c) jet_dyn_field: fn(tree: I64, name: I64, ok: I64, err: I64, err_len: I64) -> I64 {
    object: dyn_word(wrapping(tree + DYN_TAG)) == DYN_OBJECT
    if object {
        sequence: dyn_word(wrapping(tree + DYN_PAYLOAD))
        length: dyn_word(wrapping(sequence + DATA_SEQUENCE_LENGTH))
        data: dyn_word(wrapping(sequence + DATA_SEQUENCE_DATA))
        at := I64{0}
        loop at < length {
            entry: wrapping(data + at * DYN_ENTRY_BYTES)
            if jet_rt_string_eq(dyn_word(wrapping(entry + DYN_ENTRY_KEY)), name) {
                dyn_store(ok, jet_rt_handle_clone_dyn(dyn_word(wrapping(entry + DYN_ENTRY_VALUE))))
                return I64{1}
            }
            at += I64{1}
        }
    }
    target: jet_rt_string_builder_new()
    if object {
        jet_rt_string_builder_push(target, rt_static_text("field `"))
        jet_rt_string_builder_push(target, name)
        jet_rt_string_builder_push(target, rt_static_text("` not found"))
    } else {
        jet_rt_string_builder_push(target, rt_static_text("expected object, got "))
        dyn_render(target, tree)
    }
    error: jet_rt_alloc(TEXT_FIELD_BYTES, I64{8})
    text_glue_store(wrapping(error + TEXT_FIELD_PATH), jet_rt_string_clone(name))
    text_glue_store(wrapping(error + TEXT_FIELD_REASON), jet_rt_string_builder_finish(target))
    slot: jet_rt_alloc(I64{8}, I64{8})
    dyn_store(slot, error)
    dyn_store(err, slot)
    dyn_store(err_len, I64{1})
    I64{0}
}
// JetDynAccess::to_text: scalar leaves project exactly as Show does
// (jet_rt_handle_show_dyn); Null, Array and Object are None.
#Export(c) jet_dyn_to_text: fn(tree: I64, some: I64) -> I64 {
    kind: dyn_word(wrapping(tree + DYN_TAG))
    if kind == DYN_NULL || kind >= DYN_ARRAY -> return I64{0}
    dyn_store(some, jet_rt_handle_show_dyn(tree))
    I64{1}
}
// render_dyn_json(tree, false, 0) after `prefix`; owned.
dyn_got: fn(prefix: I64, tree: I64) -> I64 {
    target: jet_rt_string_builder_new()
    jet_rt_string_builder_push(target, prefix)
    dyn_render(target, tree)
    jet_rt_string_builder_finish(target)
}
// One FieldError at `path` (consumed) with `reason` (consumed) in the
// CAbiRoutes list_out shape jet_dyn_field writes.
dyn_field_error: fn(path: I64, reason: I64, err: I64, err_len: I64) -> I64 {
    error: jet_rt_alloc(TEXT_FIELD_BYTES, I64{8})
    text_glue_store(wrapping(error + TEXT_FIELD_PATH), path)
    text_glue_store(wrapping(error + TEXT_FIELD_REASON), reason)
    slot: jet_rt_alloc(I64{8}, I64{8})
    dyn_store(slot, error)
    dyn_store(err, slot)
    dyn_store(err_len, I64{1})
    I64{0}
}
// JetDynAccess::at: Array item `index`, counted from the end when negative;
// every failure is one FieldError at path `[index]`.
#Export(c) jet_dyn_at: fn(tree: I64, index: I64, ok: I64, err: I64, err_len: I64) -> I64 {
    position: jet_int_owned_to_i64(index)
    if (jet_scheduler_native_propagate() != I64{0}) -> return I64{0}
    path_text: jet_rt_string_builder_new()
    rt_text_push_word(path_text, I64{91}, I64{1})
    dyn_push_count(path_text, position)
    rt_text_push_word(path_text, I64{93}, I64{1})
    path: jet_rt_string_builder_finish(path_text)
    if dyn_word(wrapping(tree + DYN_TAG)) != DYN_ARRAY -> return dyn_field_error(path, dyn_got(rt_static_text("expected array, got "), tree), err, err_len)
    length: dyn_word(wrapping(dyn_word(wrapping(tree + DYN_PAYLOAD)) + DATA_SEQUENCE_LENGTH))
    found: dyn_array_item(tree, if (position < I64{0}) -> length + position else -> position)
    if (found == I64{0}) {
        reason: jet_rt_string_builder_new()
        jet_rt_string_builder_push(reason, rt_static_text("index "))
        dyn_push_count(reason, position)
        jet_rt_string_builder_push(reason, rt_static_text(" out of bounds (len "))
        dyn_push_count(reason, length)
        rt_text_push_word(reason, I64{41}, I64{1})
        return dyn_field_error(path, jet_rt_string_builder_finish(reason), err, err_len)
    }
    jet_rt_string_drop(path)
    dyn_store(ok, jet_rt_handle_clone_dyn(found))
    I64{1}
}
dyn_scalar_error: fn(prefix: I64, tree: I64, err: I64, err_len: I64) -> I64 {
    dyn_field_error(jet_rt_string_clone(rt_static_text("")), dyn_got(prefix, tree), err, err_len)
}
// JetDynAccess::int: an Int, or a Number lexeme that is an exact integer
// (json_exact_integer_text then the exact parse).
#Export(c) jet_dyn_int: fn(tree: I64, ok: I64, err: I64, err_len: I64) -> I64 {
    kind: dyn_word(wrapping(tree + DYN_TAG))
    payload: dyn_word(wrapping(tree + DYN_PAYLOAD))
    if kind == DYN_INT {
        dyn_store(ok, jet_rt_int_clone(payload))
        return I64{1}
    }
    if kind == DYN_NUMBER {
        if (codec_integer_text(payload, ok) == I64{0}) {
            jet_rt_string_drop(dyn_word(ok))
            return dyn_scalar_error(rt_static_text("expected int, got "), tree, err, err_len)
        }
        text: dyn_word(ok)
        parsed: jet_int_parse(text, ok, err)
        jet_rt_string_drop(text)
        if (parsed != I64{0}) -> return I64{1}
        jet_rt_string_drop(dyn_word(err))
    }
    dyn_scalar_error(rt_static_text("expected int, got "), tree, err, err_len)
}
// JetDynAccess::text: only a Text leaf.
#Export(c) jet_dyn_text: fn(tree: I64, ok: I64, err: I64, err_len: I64) -> I64 {
    if dyn_word(wrapping(tree + DYN_TAG)) != DYN_TEXT -> return dyn_scalar_error(rt_static_text("expected text, got "), tree, err, err_len)
    dyn_store(ok, jet_rt_string_clone(dyn_word(wrapping(tree + DYN_PAYLOAD))))
    I64{1}
}
// JetDynAccess::bool: only a Bool leaf.
#Export(c) jet_dyn_bool: fn(tree: I64, ok: I64, err: I64, err_len: I64) -> I64 {
    if dyn_word(wrapping(tree + DYN_TAG)) != DYN_BOOL -> return dyn_scalar_error(rt_static_text("expected bool, got "), tree, err, err_len)
    rt_text_put(ok, if (dyn_word(wrapping(tree + DYN_PAYLOAD)) != I64{0}) -> I64{1} else -> I64{0})
    I64{1}
}
// JetDynAccess::float: a Float, a finite Int, or a finite trimmed Number
// lexeme.
#Export(c) jet_dyn_float: fn(tree: I64, ok: I64, err: I64, err_len: I64) -> I64 {
    kind: dyn_word(wrapping(tree + DYN_TAG))
    payload: dyn_word(wrapping(tree + DYN_PAYLOAD))
    if kind == DYN_FLOAT {
        dyn_store(ok, payload)
        return I64{1}
    }
    if kind == DYN_INT {
        bits: rt_f64_bits(jet_int_owned_to_f64(payload))
        if !codec_finite(bits) -> return dyn_field_error(jet_rt_string_clone(rt_static_text("")), jet_rt_string_clone(rt_static_text("expected float, got out-of-range Int")), err, err_len)
        dyn_store(ok, bits)
        return I64{1}
    }
    if kind == DYN_NUMBER {
        if (jet_float_parse(payload, ok, err) != I64{0}) {
            if codec_finite(dyn_word(ok)) -> return I64{1}
        } else {
            jet_rt_string_drop(dyn_word(err))
        }
    }
    dyn_scalar_error(rt_static_text("expected float, got "), tree, err, err_len)
}
// A validated Number lexeme as sign, significant digits and decimal scale: its
// value is the digits from `first` to `last` (skipping a point; leading and
// trailing zeros dropped) times ten to the explicit exponent plus `adjust`.
// The exponent span, with its sign, is empty when the lexeme has none.
DynNumberParts: struct { negative: Bool, first: I64, last: I64, digits: I64, adjust: I64, exponent_at: I64, exponent_len: I64 }
dyn_number_parts: fn(data: I64, len: I64) -> DynNumberParts {
    parts := DynNumberParts{negative: false, first: I64{0}, last: I64{0}, digits: I64{0}, adjust: I64{0}, exponent_at: len, exponent_len: I64{0}}
    at := I64{0}
    if (len > I64{0} && rt_text_byte(data) == I64{45}) {
        parts.negative = true
        at = I64{1}
    }
    point := false
    leading := true
    trailing := I64{0}
    loop at < len {
        byte: rt_text_byte(wrapping(data + at))
        if (byte == I64{101} || byte == I64{69}) {
            parts.exponent_at = at + I64{1}
            parts.exponent_len = len - at - I64{1}
            break
        }
        if (byte == I64{46}) {
            point = true
        } else {
            if point { parts.adjust -= I64{1} }
            if (byte != I64{48}) {
                if leading { parts.first = at }
                leading = false
                parts.last = at + I64{1}
                trailing = I64{0}
            } else if !leading { trailing += I64{1} }
            if !leading { parts.digits += I64{1} }
        }
        at += I64{1}
    }
    parts.digits -= trailing
    parts.adjust += trailing
    parts
}
// Two Number lexemes are equal when they spell the same decimal value: the
// same sign and significant digits at the same scale, or both zero. Exact at
// any length (the scale is an Int), and never through binary64.
dyn_number_equal: fn(left: I64, right: I64) -> Bool {
    a_data: rt_text_data(left)
    b_data: rt_text_data(right)
    a: dyn_number_parts(a_data, rt_text_len(left))
    b: dyn_number_parts(b_data, rt_text_len(right))
    if (a.digits == I64{0} || b.digits == I64{0}) -> return a.digits == b.digits
    if (a.negative != b.negative || a.digits != b.digits) -> return false
    left_at := a.first
    right_at := b.first
    loop left_at < a.last {
        left_byte: rt_text_byte(wrapping(a_data + left_at))
        right_byte: rt_text_byte(wrapping(b_data + right_at))
        if (left_byte == I64{46}) {
            left_at += I64{1}
        } else if (right_byte == I64{46}) {
            right_at += I64{1}
        } else {
            if (left_byte != right_byte) -> return false
            left_at += I64{1}
            right_at += I64{1}
        }
    }
    // The lexeme was validated, so its exponent span is an optional sign and
    // decimal digits.
    left_exponent: jet_rt_int_from_static(wrapping(a_data + a.exponent_at), a.exponent_len)
    right_exponent: jet_rt_int_from_static(wrapping(b_data + b.exponent_at), b.exponent_len)
    left_scale: jet_int_add(left_exponent, a.adjust)
    right_scale: jet_int_add(right_exponent, b.adjust)
    same: jet_int_compare(left_scale, right_scale) == I64{0}
    jet_rt_int_drop(left_exponent)
    jet_rt_int_drop(right_exponent)
    jet_rt_int_drop(left_scale)
    jet_rt_int_drop(right_scale)
    same
}
// JetDynAccess::equal_unordered: structural equality where an Object's entries
// match in any order (each right entry used once), NaN equals nothing, and two
// Number lexemes compare by decimal value.
#Export(c) jet_dyn_equal_unordered: fn(left: I64, right: I64) -> Bool {
    kind: dyn_word(wrapping(left + DYN_TAG))
    if kind != dyn_word(wrapping(right + DYN_TAG)) -> return false
    if kind == DYN_NUMBER -> return dyn_number_equal(dyn_word(wrapping(left + DYN_PAYLOAD)), dyn_word(wrapping(right + DYN_PAYLOAD)))
    if kind != DYN_ARRAY && kind != DYN_OBJECT -> return jet_rt_handle_eq_dyn(left, right)
    a: dyn_word(wrapping(left + DYN_PAYLOAD))
    b: dyn_word(wrapping(right + DYN_PAYLOAD))
    length: dyn_word(wrapping(a + DATA_SEQUENCE_LENGTH))
    if length != dyn_word(wrapping(b + DATA_SEQUENCE_LENGTH)) -> return false
    ap: dyn_word(wrapping(a + DATA_SEQUENCE_DATA))
    bp: dyn_word(wrapping(b + DATA_SEQUENCE_DATA))
    if kind == DYN_ARRAY {
        at := I64{0}
        loop at < length {
            if !jet_dyn_equal_unordered(dyn_word(wrapping(ap + at * DYN_ELEMENT_BYTES)), dyn_word(wrapping(bp + at * DYN_ELEMENT_BYTES))) -> return false
            at += I64{1}
        }
        return true
    }
    used: if (length == I64{0}) -> I64{0} else -> jet_rt_alloc(length * I64{8}, I64{8})
    if (length != I64{0}) -> coll_zero(used, length * I64{8})
    same := true
    at := I64{0}
    loop same && at < length {
        entry: wrapping(ap + at * DYN_ENTRY_BYTES)
        matched := false
        other := I64{0}
        loop !matched && other < length {
            candidate: wrapping(bp + other * DYN_ENTRY_BYTES)
            if (dyn_word(wrapping(used + other * I64{8})) == I64{0} && jet_rt_string_eq(dyn_word(wrapping(entry + DYN_ENTRY_KEY)), dyn_word(wrapping(candidate + DYN_ENTRY_KEY))) && jet_dyn_equal_unordered(dyn_word(wrapping(entry + DYN_ENTRY_VALUE)), dyn_word(wrapping(candidate + DYN_ENTRY_VALUE)))) {
                dyn_store(wrapping(used + other * I64{8}), I64{1})
                matched = true
            }
            other += I64{1}
        }
        same = matched
        at += I64{1}
    }
    if (length != I64{0}) -> jet_rt_free(used, length * I64{8}, I64{8})
    same
}
// Generated by Tools/agent/RuntimeGenerators.jet from core.encoding.__dyn_kind; do not edit.
// dyn_kind: the diagnostic name of a runtime tree's kind.
dyn_kind_name: fn(kind: I64) -> I64 {
    if kind == DYN_NULL -> return rt_static_text("Null")
    if kind == DYN_BOOL -> return rt_static_text("Bool")
    if kind == DYN_INT -> return rt_static_text("Int")
    if kind == DYN_FLOAT -> return rt_static_text("Float")
    if kind == DYN_NUMBER -> return rt_static_text("number")
    if kind == DYN_TEXT -> return rt_static_text("Text")
    if kind == DYN_BYTE_LIST -> return rt_static_text("Bytes")
    if kind == DYN_DATETIME -> return rt_static_text("DateTime")
    if kind == DYN_ARRAY -> return rt_static_text("a list")
    rt_static_text("an object")
}
// End of the generated dyn_kind rows.
// get_opt: the borrowed value of the first Object entry named `key`; 0 for a
// miss or a tree that is not an Object.
dyn_object_find: fn(tree: I64, key: I64) -> I64 {
    if dyn_word(wrapping(tree + DYN_TAG)) != DYN_OBJECT -> return I64{0}
    sequence: dyn_word(wrapping(tree + DYN_PAYLOAD))
    length: dyn_word(wrapping(sequence + DATA_SEQUENCE_LENGTH))
    data: dyn_word(wrapping(sequence + DATA_SEQUENCE_DATA))
    at := I64{0}
    loop at < length {
        entry: wrapping(data + at * DYN_ENTRY_BYTES)
        if jet_rt_string_eq(dyn_word(wrapping(entry + DYN_ENTRY_KEY)), key) -> return dyn_word(wrapping(entry + DYN_ENTRY_VALUE))
        at += I64{1}
    }
    I64{0}
}
// The borrowed Array item at `position`; 0 when out of range or not an Array.
dyn_array_item: fn(tree: I64, position: I64) -> I64 {
    if dyn_word(wrapping(tree + DYN_TAG)) != DYN_ARRAY -> return I64{0}
    sequence: dyn_word(wrapping(tree + DYN_PAYLOAD))
    if (position < I64{0} || position >= dyn_word(wrapping(sequence + DATA_SEQUENCE_LENGTH))) -> return I64{0}
    dyn_word(wrapping(dyn_word(wrapping(sequence + DATA_SEQUENCE_DATA)) + position * DYN_ELEMENT_BYTES))
}
// jet_dyn_stop_message: a builder holding "{site}: ".
dyn_stop_begin: fn(site: I64) -> I64 {
    target: jet_rt_string_builder_new()
    jet_rt_string_builder_push(target, site)
    jet_rt_string_builder_push(target, rt_static_text(": "))
    target
}
// Pushes the decimal text of a native i64.
dyn_push_count: fn(target: I64, count: I64) {
    exact: jet_int_owned_from_i64(count)
    text: jet_rt_int_to_string(exact)
    jet_rt_string_builder_push(target, text)
    jet_rt_string_drop(text)
    jet_rt_int_drop(exact)
}
// jet_dyn_get_key: Some(clone) of the first entry named `key`.
#Export(c) jet_dyn_get_key: fn(tree: I64, key: I64, some: I64) -> I64 {
    found: dyn_object_find(tree, key)
    if (found == I64{0}) -> return I64{0}
    dyn_store(some, jet_rt_handle_clone_dyn(found))
    I64{1}
}
// jet_dyn_get_at: Some(clone) of the Array item at `index`.
#Export(c) jet_dyn_get_at: fn(tree: I64, index: I64, some: I64) -> I64 {
    position: jet_int_owned_to_i64(index)
    if (jet_scheduler_native_propagate() != I64{0}) -> return I64{0}
    found: dyn_array_item(tree, position)
    if (found == I64{0}) -> return I64{0}
    dyn_store(some, jet_rt_handle_clone_dyn(found))
    I64{1}
}
// jet_dyn_has: an Object has an entry named `key`.
#Export(c) jet_dyn_has: fn(tree: I64, key: I64) -> Bool { dyn_object_find(tree, key) != I64{0} }
// jet_dyn_keys: an Object's keys in entry order; empty for every other kind.
// Returns the count and an owned word column of texts.
#Export(c) jet_dyn_keys: fn(tree: I64, output: I64) -> I64 {
    if dyn_word(wrapping(tree + DYN_TAG)) != DYN_OBJECT {
        dyn_store(output, I64{0})
        return I64{0}
    }
    sequence: dyn_word(wrapping(tree + DYN_PAYLOAD))
    length: dyn_word(wrapping(sequence + DATA_SEQUENCE_LENGTH))
    data: dyn_word(wrapping(sequence + DATA_SEQUENCE_DATA))
    words: if (length == I64{0}) -> I64{0} else -> jet_rt_alloc(length * I64{8}, I64{8})
    at := I64{0}
    loop at < length {
        dyn_store(wrapping(words + at * I64{8}), jet_rt_string_clone(dyn_word(wrapping(wrapping(data + at * DYN_ENTRY_BYTES) + DYN_ENTRY_KEY))))
        at += I64{1}
