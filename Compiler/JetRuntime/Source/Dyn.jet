// Stores the "{site}: {detail}" stop text into err.
dyn_operator_stop: fn(site: I64, detail: I64, err: I64) -> I64 {
    target: dyn_stop_begin(site)
    jet_rt_string_builder_push(target, detail)
    dyn_store(err, jet_rt_string_builder_finish(target))
    I64{0}
}
// Stores the "{site}: {verb} {left kind}{joint}{right kind}" stop text into err.
dyn_kinds_stop: fn(site: I64, verb: I64, left: I64, joint: I64, right: I64, err: I64) -> I64 {
    target: dyn_stop_begin(site)
    jet_rt_string_builder_push(target, verb)
    jet_rt_string_builder_push(target, dyn_kind_name(dyn_word(wrapping(left + DYN_TAG))))
    jet_rt_string_builder_push(target, joint)
    jet_rt_string_builder_push(target, dyn_kind_name(dyn_word(wrapping(right + DYN_TAG))))
    dyn_store(err, jet_rt_string_builder_finish(target))
    I64{0}
}
// Stores the "{site}: {detail}{op}" stop text into err.
dyn_unknown_operator: fn(site: I64, detail: I64, op: I64, err: I64) -> I64 {
    target: dyn_stop_begin(site)
    jet_rt_string_builder_push(target, detail)
    jet_rt_string_builder_push(target, op)
    dyn_store(err, jet_rt_string_builder_finish(target))
    I64{0}
}
dyn_numeric: fn(kind: I64) -> Bool { kind == DYN_INT || kind == DYN_FLOAT }
dyn_f64: fn(kind: I64, payload: I64) -> Float {
    if kind == DYN_INT -> return jet_int_owned_to_f64(payload)
    rt_f64_from_bits(payload)
}
// jet_dyn_binary: `+ - *` of two Int leaves is their exact Int and `/` the
// correctly rounded Float of their ratio; an Int with a Float, or two Floats,
// give the Float result. Any other pair stops with "{site}: cannot {verb} {left
// kind} by {right kind}". ok and err share the caller's slot.
#Export(c) jet_dyn_binary: fn(left: I64, right: I64, op: I64, site: I64, ok: I64, err: I64) -> I64 {
    left_kind: dyn_word(wrapping(left + DYN_TAG))
    right_kind: dyn_word(wrapping(right + DYN_TAG))
    a: dyn_word(wrapping(left + DYN_PAYLOAD))
    b: dyn_word(wrapping(right + DYN_PAYLOAD))
    sum: jet_rt_string_eq(op, rt_static_text("+"))
    difference: jet_rt_string_eq(op, rt_static_text("-"))
    product: jet_rt_string_eq(op, rt_static_text("*"))
    quotient: jet_rt_string_eq(op, rt_static_text("/"))
    if left_kind == DYN_INT && right_kind == DYN_INT {
        if quotient {
            if (b == I64{0}) -> return dyn_operator_stop(site, rt_static_text("division by zero"), err)
            dyn_store(ok, dyn_new(DYN_FLOAT, rt_f64_bits(int_ratio_to_f64(a, b))))
            return I64{1}
        }
        if !sum && !difference && !product -> return dyn_unknown_operator(site, rt_static_text("unknown Dyn operator "), op, err)
        value: if {
            sum -> jet_int_add(a, b)
            difference -> jet_int_sub(a, b)
            else -> jet_int_mul(a, b)
