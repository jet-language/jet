        jet_rt_string_builder_push(target, rt_static_text("expected an object, found "))
        jet_rt_string_builder_push(target, dyn_kind_name(kind))
    }
    dyn_store(err, jet_rt_string_builder_finish(target))
    I64{0}
}
// jet_dyn_index_at: Ok(clone) of the Array item at `index`, else the
// "{site}..." stop text. ok and err share the caller's slot.
#Export(c) jet_dyn_index_at: fn(tree: I64, index: I64, site: I64, ok: I64, err: I64) -> I64 {
    position: jet_int_owned_to_i64(index)
    if (jet_scheduler_native_propagate() != I64{0}) -> return I64{0}
    found: dyn_array_item(tree, position)
    if (found != I64{0}) {
        dyn_store(ok, jet_rt_handle_clone_dyn(found))
        return I64{1}
    }
    kind: dyn_word(wrapping(tree + DYN_TAG))
    target: dyn_stop_begin(site)
    if kind == DYN_ARRAY {
        jet_rt_string_builder_push(target, rt_static_text("index "))
        dyn_push_count(target, position)
        jet_rt_string_builder_push(target, rt_static_text(" is out of range (length "))
        dyn_push_count(target, dyn_word(wrapping(dyn_word(wrapping(tree + DYN_PAYLOAD)) + DATA_SEQUENCE_LENGTH)))
        jet_rt_string_builder_push(target, rt_static_text(")"))
    } else {
