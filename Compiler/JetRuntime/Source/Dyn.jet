        dyn_store(ok, dyn_new(DYN_INT, value))
        return I64{1}
    }
    if dyn_numeric(left_kind) && dyn_numeric(right_kind) {
        x: dyn_f64(left_kind, a)
        y: dyn_f64(right_kind, b)
