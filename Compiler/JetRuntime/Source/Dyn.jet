// The exact order of an Int and a finite or infinite Float (Rust
// dyn_integer_float_compare): -1, 0 or 1, or 2 when the Float is NaN. The
// Int's nearest Float decides unless it equals the Float; an equal Float is
// either exact or a whole number, compared as an Int.
dyn_int_float_order: fn(integer: I64, float: Float) -> I64 {
    if float != float -> return I64{2}
    infinity: Float{1.0} / Float{0.0}
    if float == infinity -> return I64{-1}
    if float == -infinity -> return I64{1}
    near: jet_int_owned_to_f64(integer)
    if near < float -> return I64{-1}
    if near > float -> return I64{1}
    if (near < Float{9007199254740992.0} && near > Float{-9007199254740992.0}) -> return I64{0}
    bits: rt_f64_bits(float)
    mantissa: bits.bit_and(I64{4503599627370495}).bit_or(I64{4503599627370496})
    exponent: (bits >> I64{52}).bit_and(I64{2047})
    magnitude: jet_int_shl(mantissa, exponent - I64{1075}, I64{0}, I64{0}, I64{0})
    whole: if (float < Float{0.0}) -> jet_int_sub(I64{0}, magnitude) else -> jet_rt_int_clone(magnitude)
    order: jet_int_compare(integer, whole)
    jet_rt_int_drop(magnitude)
    jet_rt_int_drop(whole)
    order
}
dyn_word_order: fn(left: I64, right: I64) -> I64 {
    if {
        left < right -> I64{-1}
        left > right -> I64{1}
        else -> I64{0}
    }
}
// Two Bytes leaves bytewise, a prefix first.
dyn_bytes_order: fn(left: I64, right: I64) -> I64 {
    left_length: dyn_word(wrapping(left + DATA_SEQUENCE_LENGTH))
    right_length: dyn_word(wrapping(right + DATA_SEQUENCE_LENGTH))
    left_data: dyn_word(wrapping(left + DATA_SEQUENCE_DATA))
    right_data: dyn_word(wrapping(right + DATA_SEQUENCE_DATA))
    at := I64{0}
    loop at < left_length && at < right_length {
        order: dyn_word_order(host_u8_get(left_data, at), host_u8_get(right_data, at))
        if (order != I64{0}) -> return order
        at += I64{1}
    }
    dyn_word_order(left_length, right_length)
}
// Two DateTime leaves by instant: POSIX seconds, then the leap label, then
// nanoseconds (DynDateTime::instant_key); the frozen offset does not count.
dyn_datetime_order: fn(left: I64, right: I64) -> I64 {
    seconds: dyn_word_order(dyn_word(wrapping(left + DYN_DATETIME_SECS)), dyn_word(wrapping(right + DYN_DATETIME_SECS)))
    if (seconds != I64{0}) -> return seconds
    leap: dyn_word_order(dyn_word(wrapping(left + DYN_DATETIME_LEAP)), dyn_word(wrapping(right + DYN_DATETIME_LEAP)))
    if (leap != I64{0}) -> return leap
    dyn_word_order(dyn_word(wrapping(left + DYN_DATETIME_NANOS)), dyn_word(wrapping(right + DYN_DATETIME_NANOS)))
