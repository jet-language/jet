// Private provider errors preserve SecretsCrypto.rs:347-391's 13 variants.
// This is NOT Core's public VaultError (D-VAULT-ERRORS1). Text payloads contain
// provider-selected redacted descriptions, never repository paths or key bytes.
// Searches of all refs for vault_record_hash found no reusable Jet codec;
// 5933a61b2/d587c4035 contain only the public facade and vault_02 state/Linux.
VAULT_ERROR_BYTES :: prep { I64{24} }
VAULT_ERROR_TAG :: prep { I64{0} }
VAULT_ERROR_FIRST :: prep { I64{8} }
VAULT_ERROR_SECOND :: prep { I64{16} }
fn vault_error_tag(error: I64) -> I64 {
    kind :: rt_text_word(error + VAULT_ERROR_TAG)
    if (kind < I64{0} || kind > I64{12}) -> panic("record variant index out of range")
    kind
}
// Unit variants ignore both payloads; Crypto takes display/debug descriptions,
// IO takes operation/redacted-path, Internal takes its incident identifier.
fn vault_error_new(kind: I64, first: I64, second: I64) -> I64 {
    if (kind < I64{0} || kind > I64{12}) -> panic("record variant index out of range")
    result :: jet_rt_alloc(VAULT_ERROR_BYTES, I64{8})
    rt_text_store(result + VAULT_ERROR_TAG, kind)
    rt_text_store(result + VAULT_ERROR_FIRST, if (kind >= I64{10}) -> jet_rt_string_clone(first) else -> I64{0})
    rt_text_store(result + VAULT_ERROR_SECOND, if (kind == I64{10} || kind == I64{11}) -> jet_rt_string_clone(second) else -> I64{0})
    result
}
fn vault_error_clone(error: I64) -> I64 {
    vault_error_new(vault_error_tag(error), rt_text_word(error + VAULT_ERROR_FIRST), rt_text_word(error + VAULT_ERROR_SECOND))
}
fn vault_error_drop(error: I64) {
    if (error == I64{0}) -> return
    kind :: vault_error_tag(error)
    if (kind >= I64{10}) -> jet_rt_string_drop(rt_text_word(error + VAULT_ERROR_FIRST))
    if (kind == I64{10} || kind == I64{11}) -> jet_rt_string_drop(rt_text_word(error + VAULT_ERROR_SECOND))
    jet_rt_free(error, VAULT_ERROR_BYTES, I64{8})
}
fn vault_error_equal(left: I64, right: I64) -> Bool {
    kind :: vault_error_tag(left)
    if kind != vault_error_tag(right) -> return false
    if (kind >= I64{10} && !jet_rt_string_eq(rt_text_word(left + VAULT_ERROR_FIRST), rt_text_word(right + VAULT_ERROR_FIRST))) -> return false
    if (kind == I64{10} || kind == I64{11}) -> return jet_rt_string_eq(rt_text_word(left + VAULT_ERROR_SECOND), rt_text_word(right + VAULT_ERROR_SECOND))
    true
}
fn vault_error_name(target: I64, kind: I64) {
    if {
        (kind == I64{0}) -> {
            rt_text_push_word(target, I64{5648755746841980489}, I64{8})
            rt_text_push_word(target, I64{6647137}, I64{3})
        }
        (kind == I64{1}) -> rt_text_push_word(target, I64{7236850772014821198}, I64{8})
        (kind == I64{2}) -> {
            rt_text_push_word(target, I64{8104601807641080407}, I64{8})
            rt_text_push_word(target, I64{101}, I64{1})
        }
        (kind == I64{3}) -> rt_text_push_word(target, I64{28259009777001810}, I64{7})
        (kind == I64{4}) -> rt_text_push_word(target, I64{110386756153164}, I64{6})
        (kind == I64{5}) -> {
            rt_text_push_word(target, I64{8388361603773658433}, I64{8})
            rt_text_push_word(target, I64{28259001169167481}, I64{7})
        }
        (kind == I64{6}) -> rt_text_push_word(target, I64{8386662845389893443}, I64{8})
        (kind == I64{7}) -> {
            rt_text_push_word(target, I64{8245933071047814741}, I64{8})
            rt_text_push_word(target, I64{7599383958000002420}, I64{8})
            rt_text_push_word(target, I64{7497060}, I64{3})
        }
        (kind == I64{8}) -> {
            rt_text_push_word(target, I64{5000237400500629065}, I64{8})
            rt_text_push_word(target, I64{29113321536840558}, I64{7})
        }
        (kind == I64{9}) -> {
            rt_text_push_word(target, I64{7596562542729786692}, I64{8})
            rt_text_push_word(target, I64{8606218820619958644}, I64{8})
            rt_text_push_word(target, I64{110}, I64{1})
        }
        (kind == I64{10}) -> rt_text_push_word(target, I64{122545893896771}, I64{6})
        (kind == I64{11}) -> rt_text_push_word(target, I64{20297}, I64{2})
        else -> rt_text_push_word(target, I64{7809644666444607049}, I64{8})
    }
}
