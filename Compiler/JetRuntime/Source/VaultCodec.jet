fn vault_decode_groups(cursor: I64, count: I64) -> I64 {
    groups :: data_sequence_new(count, VAULT_GROUP_BYTES)
    data :: rt_text_word(groups + DATA_SEQUENCE_DATA)
    previous := I64{0}
    previous_tag := I64{0}
    at := I64{0}
    loop at < count {
        key_tag :: vault_take_uint(cursor, I64{1})
        name :: vault_take_text(cursor, I64{2}, I64{128})
