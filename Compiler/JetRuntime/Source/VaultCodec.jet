        current :: vault_take_uint(cursor, I64{8})
        latest :: vault_take_uint(cursor, I64{8})
        if (rt_text_word(cursor + I64{24}) != I64{-1} ||
            latest == I64{0} || (current != I64{0} && current != latest)) {
            jet_rt_string_drop(name)
            rt_text_store(cursor + I64{24}, I64{8})
