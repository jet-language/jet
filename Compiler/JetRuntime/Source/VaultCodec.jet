            rt_text_put(buffer + at, I64{0})
            at += I64{1}
        }
        return at
    }
    rt_text_put(buffer + at, I64{1})
    at += I64{1}
    rt_text_bytes_copy(buffer + at, origin + VAULT_ORIGIN_UUID, I64{16})
    at += I64{16}
    name :: rt_text_word(origin + VAULT_ORIGIN_NAME)
    length :: rt_text_len(name)
    vault_put_u16(buffer + at, length)
    at += I64{2}
    rt_text_bytes_copy(buffer + at, rt_text_data(name), length)
    at += length
    vault_put_u64(buffer + at, rt_text_word(origin + VAULT_ORIGIN_GENERATION))
    at += I64{8}
    rt_text_bytes_copy(buffer + at, origin + VAULT_ORIGIN_OPAQUE, I64{16})
    at += I64{16}
    rt_text_bytes_copy(buffer + at, origin + VAULT_ORIGIN_HASH, I64{32})
