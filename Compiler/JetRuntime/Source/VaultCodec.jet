            rt_text_push_word(target, I64{120338262684769}, I64{6})
        }
        (kind == I64{8}) -> {
            rt_text_push_word(target, I64{8391086215129293174}, I64{8})
            rt_text_push_word(target, I64{2338319731383431791}, I64{8})
            rt_text_push_word(target, I64{2334106421097295465}, I64{8})
            rt_text_push_word(target, I64{7453010313431182949}, I64{8})
        }
        (kind == I64{9}) -> {
            rt_text_push_word(target, I64{8248096926960279926}, I64{8})
