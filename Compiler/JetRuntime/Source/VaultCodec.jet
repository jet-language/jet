    at := I64{0}
    loop at < record_count {
        end :: vault_group_end(records, record_count, at)
        active_count := I64{0}
        current := I64{0}
        index := at
        loop index < end {
            record :: rt_text_word(records + index * DATA_TREE_ELEMENT_BYTES)
            generation :: rt_text_word(record + VAULT_RECORD_GENERATION)
            if (generation != index - at + I64{1}) -> return I64{8}
            if (rt_text_word(record + VAULT_RECORD_STATUS) == I64{1}) {
                active_count += I64{1}
                current = generation
            }
            index += I64{1}
        }
        if (active_count > I64{1} || (current != I64{0} && current != end - at)) -> return I64{8}
        names += I64{1}
        at = end
    }
    if names > VAULT_MAX_NAMES -> return I64{8}
    length := I64{44}
    previous := I64{0}
    at = I64{0}
    loop at < string_count {
        pair :: rt_text_word(strings + at * DATA_TREE_ELEMENT_BYTES)
        name :: rt_text_word(pair)
        value :: rt_text_word(pair + I64{8})
        if !vault_validate_text(name, false) -> return I64{0}
        if (previous != I64{0} && jet_rt_string_compare(previous, name) >= I64{0}) -> return I64{8}
        previous = name
        value_length :: rt_text_len(value)
        if (value_length > I64{1048576}) -> return I64{8}
        length += I64{6} + rt_text_len(name) + value_length
        at += I64{1}
    }
    at = I64{0}
    loop at < record_count {
        record :: rt_text_word(records + at * DATA_TREE_ELEMENT_BYTES)
        key_type :: rt_text_word(record + VAULT_RECORD_TYPE)
        if (key_type != I64{1} && key_type != I64{2}) -> return I64{8}
        name :: rt_text_word(record + VAULT_RECORD_NAME)
        if !vault_validate_text(name, false) -> return I64{0}
        length += I64{19} + rt_text_len(name)
        at = vault_group_end(records, record_count, at)
    }
    id_root := I64{0}
    at = I64{0}
    loop at < record_count {
        record :: rt_text_word(records + at * DATA_TREE_ELEMENT_BYTES)
        bytes :: vault_secret_bytes(rt_text_word(record + VAULT_RECORD_SECRET))
        if (rt_text_word(record + VAULT_RECORD_GENERATION) == I64{0} ||
            rt_text_word(bytes + DATA_SEQUENCE_LENGTH) != I64{32} ||
            vault_bytes_zero(record + VAULT_RECORD_OPAQUE, I64{16})) -> return I64{8}
