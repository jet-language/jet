fn vault_group_end(records: I64, count: I64, start: I64) -> I64 {
    first :: rt_text_word(records + start * DATA_TREE_ELEMENT_BYTES)
    key_type :: rt_text_word(first + VAULT_RECORD_TYPE)
    name :: rt_text_word(first + VAULT_RECORD_NAME)
    end := start + I64{1}
    loop end < count {
        row :: rt_text_word(records + end * DATA_TREE_ELEMENT_BYTES)
        if rt_text_word(row + VAULT_RECORD_TYPE) != key_type -> break
        if !jet_rt_string_eq(rt_text_word(row + VAULT_RECORD_NAME), name) -> break
        end += I64{1}
    }
    end
