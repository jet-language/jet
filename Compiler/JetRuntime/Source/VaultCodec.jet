    rt_text_store(output, jet_rt_string_builder_finish(result))
    I64{-1}
}
fn vault_encode_v2(store: I64, output: I64) -> I64 {
    pairs :: rt_text_word(store + VAULT_STORE_STRINGS)
    rows :: rt_text_word(store + VAULT_STORE_RECORDS)
    string_count :: rt_text_word(pairs + DATA_SEQUENCE_LENGTH)
    record_count :: rt_text_word(rows + DATA_SEQUENCE_LENGTH)
    if (rt_text_word(store + VAULT_STORE_REVISION) == I64{0} ||
        vault_bytes_zero(store + VAULT_STORE_UUID, I64{16}) ||
        string_count > VAULT_MAX_STRINGS || record_count > VAULT_MAX_VERSIONS) -> return I64{8}
    strings_bytes :: string_count * DATA_TREE_ELEMENT_BYTES * I64{2}
    records_bytes :: record_count * DATA_TREE_ELEMENT_BYTES * I64{2}
    strings_mem :: if (strings_bytes == I64{0}) -> I64{8} else -> jet_rt_alloc(strings_bytes, I64{8})
    records_mem :: if (records_bytes == I64{0}) -> I64{8} else -> jet_rt_alloc(records_bytes, I64{8})
    strings :: vault_sorted_indices(rt_text_word(pairs + DATA_SEQUENCE_DATA), string_count, false, strings_mem, strings_mem + strings_bytes / I64{2})
    records :: vault_sorted_indices(rt_text_word(rows + DATA_SEQUENCE_DATA), record_count, true, records_mem, records_mem + records_bytes / I64{2})
    nodes :: vault_id_nodes_new(record_count)
    scratch :: jet_rt_alloc(I64{8256}, I64{8})
    error :: vault_encode_v2_inner(store, strings, string_count, records, record_count, nodes, scratch, output)
    thread_zero(scratch, I64{8256})
    jet_rt_free(scratch, I64{8256}, I64{8})
    vault_id_nodes_drop(nodes, record_count)
    if (records_bytes != I64{0}) -> jet_rt_free(records_mem, records_bytes, I64{8})
    if (strings_bytes != I64{0}) -> jet_rt_free(strings_mem, strings_bytes, I64{8})
    error
}

VAULT_GROUP_BYTES :: I64{32}
// Cursor32 = borrowed bytes0/length8/position16/private error24.
// All wire counts are nonnegative; remaining-length checks precede additions.
fn vault_take_bytes(cursor: I64, count: I64) -> I64 {
    if (rt_text_word(cursor + I64{24}) != I64{-1}) -> return I64{0}
    at :: rt_text_word(cursor + I64{16})
    if (count < I64{0} || count > rt_text_word(cursor + I64{8}) - at) {
        rt_text_store(cursor + I64{24}, I64{8})
        return I64{0}
    }
    rt_text_store(cursor + I64{16}, at + count)
    rt_text_word(cursor) + at
}
fn vault_take_uint(cursor: I64, width: I64) -> I64 {
    bytes :: vault_take_bytes(cursor, width)
    if (bytes == I64{0}) -> return I64{0}
    at := I64{0}
    value := I64{0}
    loop at < width {
        value = value.bit_or((rt_text_byte(bytes + at) << (at * I64{8})))
        at += I64{1}
    }
    value
