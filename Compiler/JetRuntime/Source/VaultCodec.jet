// Validation follows864-1018's order, including the name/group error ordering.
// No output owner is allocated until validation succeeds; caller scratch/index
// owners are always released by the outer function, including on every error.
fn vault_encode_v2_inner(store: I64, strings: I64, string_count: I64, records: I64, record_count: I64, nodes: I64, scratch: I64, output: I64) -> I64 {
