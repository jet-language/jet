fn vault_error_debug(error: I64) -> I64 {
    kind :: vault_error_tag(error)
    target :: jet_rt_string_builder_new()
    vault_error_name(target, kind)
    if (kind == I64{10}) {
        rt_text_push_word(target, I64{40}, I64{1})
        jet_rt_string_builder_push(target, rt_text_word(error + VAULT_ERROR_SECOND))
        rt_text_push_word(target, I64{41}, I64{1})
    } else if (kind == I64{11}) {
        rt_text_push_word(target, I64{7021786302599166752}, I64{8})
        rt_text_push_word(target, I64{35435332987252}, I64{6})
        rt_text_push_rust_debug_str(target, rt_text_word(error + VAULT_ERROR_FIRST))
        rt_text_push_word(target, I64{8386654014920597548}, I64{8})
        rt_text_push_word(target, I64{4208741813623678053}, I64{8})
        rt_text_push_word(target, I64{32}, I64{1})
        rt_text_push_rust_debug_str(target, rt_text_word(error + VAULT_ERROR_SECOND))
        rt_text_push_word(target, I64{32032}, I64{2})
    } else if (kind == I64{12}) {
        rt_text_push_word(target, I64{7235423602208701216}, I64{8})
        rt_text_push_word(target, I64{2322278961598721637}, I64{8})
        rt_text_push_rust_debug_str(target, rt_text_word(error + VAULT_ERROR_FIRST))
        rt_text_push_word(target, I64{32032}, I64{2})
    }
    jet_rt_string_builder_finish(target)
}
// The JVLT2 payload domain is synthesized in borrowed scratch, not copied
// together with the payload. Caller owns 592-byte scratch (aligned8).
fn vault_payload_hash(payload: I64, length: I64, digest: I64, scratch: I64) {
    domain :: scratch + I64{576}
    rt_text_store(domain, I64{7021147219605345866})
    rt_text_store(domain + I64{8}, I64{431131421817})
    rt_sha256_parts(domain, I64{13}, payload, length, digest, scratch)
    rt_text_store(domain, I64{0})
    rt_text_store(domain + I64{8}, I64{0})
}

// Historical pair codec: SecretsCrypto.rs:88-131. Wire buffers use the E4
// raw-byte header privately (not exposed as UTF-8 Text). Pairs own a native
// List<(Text,Text)> with the canonical 16-byte pair stride.
VAULT_PAIR_BYTES :: prep { I64{16} }
fn vault_utf8_valid(data: I64, length: I64) -> Bool {
    at := I64{0}
    loop at < length {
        width :: rt_text_valid_width(data + at, length - at)
        if (width <= I64{0}) -> return false
        at += width
    }
    true
}
fn vault_u32(data: I64) -> I64 {
    rt_text_byte(data) | (rt_text_byte(data + I64{1}) << I64{8}) |
        (rt_text_byte(data + I64{2}) << I64{16}) | (rt_text_byte(data + I64{3}) << I64{24})
}
fn vault_put_u32(target: I64, value: I64) {
    rt_text_put(target, value & I64{255})
    rt_text_put(target + I64{1}, (value >> I64{8}) & I64{255})
    rt_text_put(target + I64{2}, (value >> I64{16}) & I64{255})
    rt_text_put(target + I64{3}, (value >> I64{24}) & I64{255})
}
fn vault_encode_pairs(pairs: I64) -> I64 {
    count :: rt_text_word(pairs + DATA_SEQUENCE_LENGTH)
    data :: rt_text_word(pairs + DATA_SEQUENCE_DATA)
    length := I64{4}
    at := I64{0}
    loop at < count {
        pair :: data + at * VAULT_PAIR_BYTES
        key :: rt_text_word(pair)
        value :: rt_text_word(pair + I64{8})
        key_len :: rt_text_len(key)
        value_len :: rt_text_len(value)
        if (key_len > I64{9223372036854775799} - length || value_len > I64{9223372036854775799} - length - key_len) -> rt_text_capacity_stop()
        length += I64{8} + key_len + value_len
        at += I64{1}
    }
    result :: rt_text_builder_with_capacity(length)
    output :: rt_text_data(result)
    vault_put_u32(output, count)
    cursor := I64{4}
    at = I64{0}
    loop at < count {
        pair :: data + at * VAULT_PAIR_BYTES
        key :: rt_text_word(pair)
        value :: rt_text_word(pair + I64{8})
        key_len :: rt_text_len(key)
        value_len :: rt_text_len(value)
        vault_put_u32(output + cursor, key_len)
        cursor += I64{4}
        rt_text_bytes_copy(output + cursor, rt_text_data(key), key_len)
        cursor += key_len
        vault_put_u32(output + cursor, value_len)
        cursor += I64{4}
        rt_text_bytes_copy(output + cursor, rt_text_data(value), value_len)
        cursor += value_len
        at += I64{1}
    }
    rt_text_store(result + I64{8}, length)
    jet_rt_string_builder_finish(result)
}
fn vault_text_zero(value: I64) {
    data :: rt_text_data(value)
    capacity :: rt_text_word(value + I64{16})
    at := I64{0}
    loop at < capacity {
        rt_text_put(data + at, I64{0})
        at += I64{1}
    }
}
fn vault_pairs_drop(pairs: I64) {
    if (pairs == I64{0}) -> return
    count :: rt_text_word(pairs + DATA_SEQUENCE_LENGTH)
    data :: rt_text_word(pairs + DATA_SEQUENCE_DATA)
    at := I64{0}
    loop at < count {
        pair :: data + at * VAULT_PAIR_BYTES
        key :: rt_text_word(pair)
        value :: rt_text_word(pair + I64{8})
        vault_text_zero(value)
        jet_rt_string_drop(key)
        jet_rt_string_drop(value)
        at += I64{1}
    }
    capacity :: rt_text_word(pairs + DATA_SEQUENCE_CAPACITY)
    if (capacity != I64{0}) -> jet_rt_free(data, capacity * VAULT_PAIR_BYTES, I64{8})
    jet_rt_free(pairs, DATA_SEQUENCE_BYTES, I64{8})
}
// Complete structural/UTF-8 preflight precedes any owner allocation. Rejecting
// an impossible count is equivalent to the reference's subsequent truncation,
// but avoids reserving an attacker-selected multi-gigabyte pair array.
fn vault_decode_pairs(bytes: I64, length: I64) -> I64 {
    if (length < I64{4}) -> return I64{0}
    count :: vault_u32(bytes)
    if (count > (length - I64{4}) / I64{8}) -> return I64{0}
    at := I64{4}
    index := I64{0}
    loop index < count {
        field := I64{0}
        loop {
            if (field == I64{2}) -> break
            if (length - at < I64{4}) -> return I64{0}
            size :: vault_u32(bytes + at)
            at += I64{4}
            if size > length - at -> return I64{0}
            if !vault_utf8_valid(bytes + at, size) -> return I64{0}
            at += size
            field += I64{1}
        }
        index += I64{1}
    }
    if at != length -> return I64{0}
    result :: data_sequence_new(count, VAULT_PAIR_BYTES)
    data :: rt_text_word(result + DATA_SEQUENCE_DATA)
    at = I64{4}
    index = I64{0}
    loop index < count {
        pair :: data + index * VAULT_PAIR_BYTES
        size :: vault_u32(bytes + at)
        at += I64{4}
        rt_text_store(pair, rt_text_copy(bytes + at, size))
        at += size
        value_size :: vault_u32(bytes + at)
        at += I64{4}
        rt_text_store(pair + I64{8}, rt_text_copy(bytes + at, value_size))
        at += value_size
        index += I64{1}
    }
    rt_text_store(result + DATA_SEQUENCE_LENGTH, count)
    result
}
