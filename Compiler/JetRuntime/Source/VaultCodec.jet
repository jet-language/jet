    rt_text_put(buffer + at + I64{2}, rt_text_word(record + VAULT_RECORD_PROVENANCE))
    rt_text_put(buffer + at + I64{3}, I64{0})
    at += I64{4}
    name :: rt_text_word(record + VAULT_RECORD_NAME)
    length :: rt_text_len(name)
    vault_put_u16(buffer + at, length)
    at += I64{2}
    rt_text_bytes_copy(buffer + at, rt_text_data(name), length)
    at += length
    vault_put_u64(buffer + at, rt_text_word(record + VAULT_RECORD_GENERATION))
    at += I64{8}
    rt_text_bytes_copy(buffer + at, record + VAULT_RECORD_OPAQUE, I64{16})
    at += I64{16}
    vault_put_u64(buffer + at, rt_text_word(record + VAULT_RECORD_CREATED))
    at += I64{8}
    vault_put_u64(buffer + at, rt_text_word(record + VAULT_RECORD_STATUS_MS))
    at += I64{8}
    rt_text_bytes_copy(buffer + at, record + VAULT_RECORD_REASON_HASH, I64{32})
    at += I64{32}
    rt_text_bytes_copy(buffer + at, record + VAULT_RECORD_PUBLIC_HASH, I64{32})
    at += I64{32}
