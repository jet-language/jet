            jet_rt_string_drop(name)
            rt_text_store(cursor + I64{24}, I64{0})
            break
        }
        if (previous != I64{0} && jet_rt_string_compare(previous, name) >= I64{0}) {
            jet_rt_string_drop(name)
            rt_text_store(cursor + I64{24}, I64{8})
            break
