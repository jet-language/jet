fn vault_take_text(cursor: I64, width: I64, maximum: I64) -> I64 {
    length :: vault_take_uint(cursor, width)
    if (rt_text_word(cursor + I64{24}) != I64{-1}) -> return I64{0}
    if (length > maximum || (width == I64{2} && length == I64{0})) {
        rt_text_store(cursor + I64{24}, I64{8})
        return I64{0}
    }
    data :: vault_take_bytes(cursor, length)
    if (data == I64{0}) -> return I64{0}
    if !vault_utf8_valid(data, length) {
        rt_text_store(cursor + I64{24}, I64{8})
        return I64{0}
    }
