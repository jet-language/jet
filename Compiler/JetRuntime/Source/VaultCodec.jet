        return I64{0}
    }
    origin :: jet_rt_alloc(VAULT_ORIGIN_BYTES, I64{8})
    rt_text_bytes_copy(origin + VAULT_ORIGIN_UUID, uuid, I64{16})
    rt_text_store(origin + VAULT_ORIGIN_NAME, name)
    rt_text_store(origin + VAULT_ORIGIN_GENERATION, generation)
    rt_text_bytes_copy(origin + VAULT_ORIGIN_OPAQUE, opaque, I64{16})
    rt_text_bytes_copy(origin + VAULT_ORIGIN_HASH, hash, I64{32})
    origin
}

fn vault_decode_record(cursor: I64, previous: I64) -> I64 {
    key_type :: vault_take_uint(cursor, I64{1})
    status :: vault_take_uint(cursor, I64{1})
    if (status < I64{1} || status > I64{3}) {
        rt_text_store(cursor + I64{24}, I64{8})
        return I64{0}
    }
    provenance :: vault_take_uint(cursor, I64{1})
    if (provenance < I64{1} || provenance > I64{2}) {
        rt_text_store(cursor + I64{24}, I64{8})
        return I64{0}
    }
    if (vault_take_uint(cursor, I64{1}) != I64{0}) {
        rt_text_store(cursor + I64{24}, I64{8})
        return I64{0}
    }
    name :: vault_take_text(cursor, I64{2}, I64{128})
    if (name == I64{0}) -> return I64{0}
    if !vault_validate_text(name, false) {
        jet_rt_string_drop(name)
        rt_text_store(cursor + I64{24}, I64{0})
        return I64{0}
    }
    generation :: vault_take_uint(cursor, I64{8})
    ordered := true
    if (previous != I64{0}) {
        prior_tag :: rt_text_word(previous + VAULT_RECORD_TYPE)
        compare :: jet_rt_string_compare(rt_text_word(previous + VAULT_RECORD_NAME), name)
        ordered = prior_tag < key_type || (prior_tag == key_type &&
            (compare < I64{0} || (compare == I64{0} &&
             vault_unsigned_less(rt_text_word(previous + VAULT_RECORD_GENERATION), generation))))
    }
    if (rt_text_word(cursor + I64{24}) != I64{-1} || generation == I64{0} || !ordered) {
        jet_rt_string_drop(name)
        rt_text_store(cursor + I64{24}, I64{8})
        return I64{0}
    }
    opaque :: vault_take_bytes(cursor, I64{16})
    created :: vault_take_uint(cursor, I64{8})
    changed :: vault_take_uint(cursor, I64{8})
    reason :: vault_take_bytes(cursor, I64{32})
    public :: vault_take_bytes(cursor, I64{32})
    origin :: vault_decode_origin(cursor, provenance)
    key_length :: vault_take_uint(cursor, I64{2})
    if (rt_text_word(cursor + I64{24}) != I64{-1} || key_length != I64{32}) {
        jet_rt_string_drop(name)
        vault_origin_drop(origin)
        if (rt_text_word(cursor + I64{24}) == I64{-1}) -> rt_text_store(cursor + I64{24}, I64{8})
        return I64{0}
    }
    key :: vault_take_bytes(cursor, I64{32})
    if (key == I64{0}) {
        jet_rt_string_drop(name)
        vault_origin_drop(origin)
        return I64{0}
    }
    bytes :: data_sequence_new(I64{32}, RT_HOST_U8_STRIDE)
    rt_text_bytes_copy(rt_text_word(bytes + DATA_SEQUENCE_DATA), key, I64{32})
    rt_text_store(bytes + DATA_SEQUENCE_LENGTH, I64{32})
    secret :: vault_secret_adopt(bytes)
    jet_rt_free(bytes, DATA_SEQUENCE_BYTES, I64{8})
    record :: vault_record_allocate_owned(name, key_type, generation, status, provenance, secret)
    rt_text_bytes_copy(record + VAULT_RECORD_OPAQUE, opaque, I64{16})
    rt_text_store(record + VAULT_RECORD_CREATED, created)
    rt_text_store(record + VAULT_RECORD_STATUS_MS, changed)
    rt_text_bytes_copy(record + VAULT_RECORD_REASON_HASH, reason, I64{32})
    rt_text_bytes_copy(record + VAULT_RECORD_PUBLIC_HASH, public, I64{32})
    rt_text_store(record + VAULT_RECORD_ORIGIN, origin)
    record
}
fn vault_decode_records(cursor: I64, count: I64, nodes: I64, scratch: I64) -> I64 {
    records :: data_sequence_new(count, DATA_TREE_ELEMENT_BYTES)
    data :: rt_text_word(records + DATA_SEQUENCE_DATA)
    previous := I64{0}
    root := I64{0}
    at := I64{0}
    loop at < count {
        record :: vault_decode_record(cursor, previous)
        if (record == I64{0}) -> break
        key_tag :: rt_text_word(record + VAULT_RECORD_TYPE)
        error := I64{8}
        if ((key_tag == I64{1} || key_tag == I64{2}) && !vault_bytes_zero(record + VAULT_RECORD_OPAQUE, I64{16})) {
            node :: vault_id_node(nodes, at, record)
            root = vault_id_insert(root, node)
            if (root != I64{-1}) -> error = vault_record_validate(record, true, scratch)
        }
        if (error != I64{-1}) {
            vault_record_drop(record)
            rt_text_store(cursor + I64{24}, error)
            break
        }
        rt_text_store(data + at * DATA_TREE_ELEMENT_BYTES, record)
        previous = record
        at += I64{1}
        rt_text_store(records + DATA_SEQUENCE_LENGTH, at)
    }
    if (rt_text_word(cursor + I64{24}) != I64{-1}) {
        vault_records_drop(records)
        return I64{0}
    }
    records
}
// The wire's groups and records are already strictly ordered. A single merge
// proves the seed1193-1221 coverage/continuity/current checks without its scans.
fn vault_groups_cover_records(groups: I64, records: I64) -> Bool {
    count :: rt_text_word(records + DATA_SEQUENCE_LENGTH)
    data :: rt_text_word(records + DATA_SEQUENCE_DATA)
    group_count :: rt_text_word(groups + DATA_SEQUENCE_LENGTH)
    group_data :: rt_text_word(groups + DATA_SEQUENCE_DATA)
    group_index := I64{0}
    at := I64{0}
    loop group_index < group_count {
        if at == count -> return false
        group :: group_data + group_index * VAULT_GROUP_BYTES
        row :: rt_text_word(data + at * DATA_TREE_ELEMENT_BYTES)
        if rt_text_word(group) != rt_text_word(row + VAULT_RECORD_TYPE) -> return false
        if !jet_rt_string_eq(rt_text_word(group + I64{8}), rt_text_word(row + VAULT_RECORD_NAME)) -> return false
        end :: vault_group_end(data, count, at)
        current :: rt_text_word(group + I64{16})
        latest :: rt_text_word(group + I64{24})
        if latest != end - at -> return false
        active_count := I64{0}
        active_generation := I64{0}
        index := at
        loop index < end {
            record :: rt_text_word(data + index * DATA_TREE_ELEMENT_BYTES)
            generation :: rt_text_word(record + VAULT_RECORD_GENERATION)
            if (generation != index - at + I64{1}) -> return false
            if (rt_text_word(record + VAULT_RECORD_STATUS) == I64{1}) {
                active_count += I64{1}
                active_generation = generation
            }
            index += I64{1}
        }
        expected_active :: if (current == I64{0}) -> I64{0} else -> I64{1}
        if active_count != expected_active || active_generation != current -> return false
        at = end
        group_index += I64{1}
    }
    at == count
}
fn vault_decode_v2(bytes: I64, length: I64, output: I64) -> I64 {
    if (length < I64{76} || length > VAULT_MAX_BYTES) -> return I64{8}
    payload_length :: length - I64{32}
    scratch :: jet_rt_alloc(I64{8288}, I64{8})
    vault_payload_hash(bytes, payload_length, scratch + I64{8192}, scratch)
    valid_hash :: rt_text_equal_bytes(scratch + I64{8192}, bytes + payload_length, I64{32})
    if (!valid_hash || vault_u32(bytes) != I64{1414288970} ||
        rt_text_byte(bytes + I64{4}) != I64{2} ||
        rt_text_byte(bytes + I64{5}) != I64{0} ||
        rt_text_byte(bytes + I64{6}) != I64{0} ||
        rt_text_byte(bytes + I64{7}) != I64{0} ||
        vault_bytes_zero(bytes + I64{8}, I64{16})) {
        thread_zero(scratch, I64{8288})
        jet_rt_free(scratch, I64{8288}, I64{8})
        return I64{8}
    }
    cursor :: scratch + I64{8256}
    rt_text_store(cursor, bytes)
    rt_text_store(cursor + I64{8}, payload_length)
    rt_text_store(cursor + I64{16}, I64{24})
    rt_text_store(cursor + I64{24}, I64{-1})
    revision :: vault_take_uint(cursor, I64{8})
    string_count :: vault_take_uint(cursor, I64{4})
    name_count :: vault_take_uint(cursor, I64{4})
    record_count :: vault_take_uint(cursor, I64{4})
    if (revision == I64{0} || string_count > VAULT_MAX_STRINGS ||
        name_count > VAULT_MAX_NAMES || record_count > VAULT_MAX_VERSIONS) {
        thread_zero(scratch, I64{8288})
        jet_rt_free(scratch, I64{8288}, I64{8})
        return I64{8}
    }
    // Each phase releases its own partial owners on error. Subsequent phases
    // are entered only on success, so malformed prefixes allocate no later Vec.
    pairs :: vault_decode_strings(cursor, string_count)
    groups :: if (pairs == I64{0}) -> I64{0} else -> vault_decode_groups(cursor, name_count)
    nodes :: if (groups == I64{0}) -> I64{8} else -> vault_id_nodes_new(record_count)
    records :: if (groups == I64{0}) -> I64{0} else -> vault_decode_records(cursor, record_count, nodes, scratch)
    error := rt_text_word(cursor + I64{24})
    if (error == I64{-1}) {
        if rt_text_word(cursor + I64{16}) != payload_length || !vault_groups_cover_records(groups, records) -> error = I64{8}
    }
    if (groups != I64{0}) -> vault_id_nodes_drop(nodes, record_count)
    vault_groups_drop(groups)
    if (error == I64{-1}) {
        store :: jet_rt_alloc(VAULT_STORE_BYTES, I64{8})
        rt_text_bytes_copy(store + VAULT_STORE_UUID, bytes + I64{8}, I64{16})
        rt_text_store(store + VAULT_STORE_REVISION, revision)
        rt_text_store(store + VAULT_STORE_STRINGS, pairs)
        rt_text_store(store + VAULT_STORE_RECORDS, records)
        rt_text_store(output, store)
    } else {
        if (pairs != I64{0}) -> vault_pairs_drop(pairs)
        vault_records_drop(records)
    }
    thread_zero(scratch, I64{8288})
    jet_rt_free(scratch, I64{8288}, I64{8})
    error
}
