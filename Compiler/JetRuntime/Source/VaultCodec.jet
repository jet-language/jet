        error :: vault_record_validate(record, false, scratch)
        if (error != I64{-1}) -> return error
        origin :: rt_text_word(record + VAULT_RECORD_ORIGIN)
        origin_length :: if (origin == I64{0}) -> I64{0} else -> rt_text_len(rt_text_word(origin + VAULT_ORIGIN_NAME))
        length += I64{219} + rt_text_len(rt_text_word(record + VAULT_RECORD_NAME)) + origin_length
        at += I64{1}
    }
    if (length > VAULT_MAX_BYTES - I64{32}) -> return I64{8}
    result :: rt_text_builder_with_capacity(length + I64{32})
    buffer :: rt_text_data(result)
    vault_put_u32(buffer, I64{1414288970}) // "JVLT"
    rt_text_put(buffer + I64{4}, I64{2})
    rt_text_put(buffer + I64{5}, I64{0})
    vault_put_u16(buffer + I64{6}, I64{0})
    rt_text_bytes_copy(buffer + I64{8}, store + VAULT_STORE_UUID, I64{16})
    vault_put_u64(buffer + I64{24}, rt_text_word(store + VAULT_STORE_REVISION))
    vault_put_u32(buffer + I64{32}, string_count)
    vault_put_u32(buffer + I64{36}, names)
    vault_put_u32(buffer + I64{40}, record_count)
    cursor := I64{44}
    at = I64{0}
    loop at < string_count {
        pair :: rt_text_word(strings + at * DATA_TREE_ELEMENT_BYTES)
        name :: rt_text_word(pair)
        value :: rt_text_word(pair + I64{8})
        name_length :: rt_text_len(name)
        value_length :: rt_text_len(value)
        vault_put_u16(buffer + cursor, name_length)
        cursor += I64{2}
        rt_text_bytes_copy(buffer + cursor, rt_text_data(name), name_length)
        cursor += name_length
        vault_put_u32(buffer + cursor, value_length)
        cursor += I64{4}
        rt_text_bytes_copy(buffer + cursor, rt_text_data(value), value_length)
        cursor += value_length
        at += I64{1}
    }
    at = I64{0}
    loop at < record_count {
        end :: vault_group_end(records, record_count, at)
        first :: rt_text_word(records + at * DATA_TREE_ELEMENT_BYTES)
        name :: rt_text_word(first + VAULT_RECORD_NAME)
        name_length :: rt_text_len(name)
        current := I64{0}
        index := at
        loop index < end {
            row :: rt_text_word(records + index * DATA_TREE_ELEMENT_BYTES)
            if (rt_text_word(row + VAULT_RECORD_STATUS) == I64{1}) -> current = rt_text_word(row + VAULT_RECORD_GENERATION)
            index += I64{1}
        }
        rt_text_put(buffer + cursor, rt_text_word(first + VAULT_RECORD_TYPE))
        cursor += I64{1}
        vault_put_u16(buffer + cursor, name_length)
        cursor += I64{2}
        rt_text_bytes_copy(buffer + cursor, rt_text_data(name), name_length)
        cursor += name_length
        vault_put_u64(buffer + cursor, current)
        cursor += I64{8}
        vault_put_u64(buffer + cursor, end - at)
        cursor += I64{8}
        at = end
    }
    at = I64{0}
    loop at < record_count {
        cursor = vault_write_record(buffer, cursor, rt_text_word(records + at * DATA_TREE_ELEMENT_BYTES))
        at += I64{1}
    }
    vault_payload_hash(buffer, length, buffer + length, scratch)
