    at := I64{0}
    count :: rt_text_word(groups + DATA_SEQUENCE_LENGTH)
    data :: rt_text_word(groups + DATA_SEQUENCE_DATA)
    loop at < count {
        jet_rt_string_drop(rt_text_word(data + at * VAULT_GROUP_BYTES + I64{8}))
        at += I64{1}
    }
