    rt_text_store(node + I64{8}, I64{0})
    rt_text_store(node + I64{16}, I64{1})
    rt_text_store(node + I64{24}, record)
    node
}
fn vault_id_nodes_drop(nodes: I64, count: I64) {
    if (count != I64{0}) -> jet_rt_free(nodes, count * VAULT_ID_NODE_BYTES, I64{8})
}
fn vault_id_compare(left: I64, right: I64) -> I64 {
    at := I64{0}
    loop {
        if (at == I64{16}) -> break
        a :: rt_text_byte(left + VAULT_RECORD_OPAQUE + at)
        b :: rt_text_byte(right + VAULT_RECORD_OPAQUE + at)
        if a < b -> return I64{-1}
        if a > b -> return I64{1}
        at += I64{1}
    }
    I64{0}
}
fn vault_id_height(node: I64) -> I64 {
    if (node == I64{0}) -> I64{0} else -> rt_text_word(node + I64{16})
}
fn vault_id_height_update(node: I64) {
    left :: vault_id_height(rt_text_word(node))
    right :: vault_id_height(rt_text_word(node + I64{8}))
    rt_text_store(node + I64{16}, I64{1} + (if left > right -> left else -> right))
}
fn vault_id_rotate_right(node: I64) -> I64 {
    pivot :: rt_text_word(node)
    rt_text_store(node, rt_text_word(pivot + I64{8}))
    rt_text_store(pivot + I64{8}, node)
    vault_id_height_update(node)
    vault_id_height_update(pivot)
    pivot
}
fn vault_id_rotate_left(node: I64) -> I64 {
    pivot :: rt_text_word(node + I64{8})
    rt_text_store(node + I64{8}, rt_text_word(pivot))
    rt_text_store(pivot, node)
    vault_id_height_update(node)
    vault_id_height_update(pivot)
    pivot
}
// -1 means duplicate. The caller reports it at the exact HashSet-insert point.
fn vault_id_insert(root: I64, node: I64) -> I64 {
    if (root == I64{0}) -> return node
    compare :: vault_id_compare(rt_text_word(node + I64{24}), rt_text_word(root + I64{24}))
    if (compare == I64{0}) -> return I64{-1}
    side :: if (compare < I64{0}) -> I64{0} else -> I64{8}
    child :: vault_id_insert(rt_text_word(root + side), node)
    if (child == I64{-1}) -> return I64{-1}
    rt_text_store(root + side, child)
    vault_id_height_update(root)
    balance :: vault_id_height(rt_text_word(root)) - vault_id_height(rt_text_word(root + I64{8}))
    if (balance > I64{1}) {
        left :: rt_text_word(root)
        if (vault_id_compare(rt_text_word(node + I64{24}), rt_text_word(left + I64{24})) > I64{0}) -> rt_text_store(root, vault_id_rotate_left(left))
        return vault_id_rotate_right(root)
    }
    if (balance < I64{-1}) {
        right :: rt_text_word(root + I64{8})
        if (vault_id_compare(rt_text_word(node + I64{24}), rt_text_word(right + I64{24})) < I64{0}) -> rt_text_store(root + I64{8}, vault_id_rotate_right(right))
        return vault_id_rotate_left(root)
    }
