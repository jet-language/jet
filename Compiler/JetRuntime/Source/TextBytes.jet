// Native byte/text crossings for core.builtin.bytes/string_from_bytes(_lossy),
// core.encoding.__utf8_validate and jet.runtime.encoding's string_byte and
// bytes_into_text. Over the current C carriers: a [U8] argument is its
// borrowed (slot data, length) pair at RT_HOST_U8_STRIDE; a [U8] result is a
// fresh slot buffer written
// to the out word, with the length returned (CAbiRoutes list_out).

// Append count native [U8] elements starting at start. Reserve once,
// then initialize every byte before publishing the new length.
text_bytes_push: fn(target: I64, data: I64, start: I64, count: I64) {
    if (count <= I64{0}) -> return
    used: rt_text_len(target)
    buffer: rt_text_reserve_extra(target, rt_text_data(target), used, count)
    if (buffer == I64{0}) -> return
    if (RT_HOST_U8_STRIDE == I64{1}) {
        rt_text_bytes_copy(wrapping(buffer + used), wrapping(data + start), count)
    } else {
        at := I64{0}
        loop at < count {
            rt_text_put(wrapping(wrapping(buffer + used) + at), host_u8_get(data, start + at))
            at += I64{1}
        }
    }
    rt_text_store(wrapping(target + I64{8}), used + count)
}

// The end of the valid UTF-8 run of a native [U8] from `start`: the
// index of the first invalid sequence, or length when the rest is valid.
text_bytes_valid_end: fn(data: I64, start: I64, length: I64) -> I64 {
    at := start
    loop at < length {
        // Packed ASCII words (no byte with the high bit) are valid as a whole,
        // and so is an ASCII byte of the tail: rt_text_valid_width's width 1
        // for a lead below 128, without the call. A tail under 8 bytes whose
        // word stays inside one page is one load masked to the tail: the
        // page holds the tail's bytes, so it is mapped, and the mask drops
        // the bytes past them; an all-ASCII tail ends the run at length.
        rest: wrapping(length - at)
        if (RT_HOST_U8_STRIDE == I64{1}) {
            if (rest >= I64{8}) {
                if (rt_text_word(wrapping(data + at)).bit_and(I64{-9187201950435737472}) == I64{0}) {
                    at = wrapping(at + I64{8})
                    next
                }
            } else if (wrapping(data + at).bit_and(I64{4095}) <= I64{4088}) {
                // rest is 1..7 here, so its low bits are rest.
                tail: rt_text_word(wrapping(data + at)).bit_and(wrapping((I64{1} << (rest.bit_and(I64{7}) * I64{8})) - I64{1}))
                if (tail.bit_and(I64{-9187201950435737472}) == I64{0}) -> return length
            }
        }
        if (host_u8_get(data, at) < I64{128}) {
            at = wrapping(at + I64{1})
            next
        }
        width: rt_text_valid_width(wrapping(data + at * RT_HOST_U8_STRIDE), length - at, RT_HOST_U8_STRIDE)
        if (width < I64{0}) -> return at
        at += width
    }
    length
}

// Rust Utf8Error Display of the first invalid sequence, or 0 when the native
// [U8] is valid UTF-8. error_len None (a truncated final sequence) is the
// "incomplete" form; otherwise the invalid subpart length is reported.
text_bytes_utf8_error: fn(data: I64, length: I64) -> I64 {
    at: text_bytes_valid_end(data, I64{0}, length)
    if (at == length) -> return I64{0}
    width: rt_text_valid_width(wrapping(data + at * RT_HOST_U8_STRIDE), length - at, RT_HOST_U8_STRIDE)
    message: jet_rt_string_builder_new()
    lead: host_u8_get(data, at)
    expected: if (lead >= I64{194} && lead <= I64{223}) -> I64{2} else if (lead >= I64{224} && lead <= I64{239}) -> I64{3} else if (lead >= I64{240} && lead <= I64{244}) -> I64{4} else -> I64{1}
    if (expected > I64{1} && at - width == length) {
        jet_rt_string_builder_push(message, rt_static_text("incomplete utf-8 byte sequence from index "))
        rt_text_push_number(message, at)
    } else {
        jet_rt_string_builder_push(message, rt_static_text("invalid utf-8 sequence of "))
        rt_text_push_number(message, -width)
        jet_rt_string_builder_push(message, rt_static_text(" bytes from index "))
        rt_text_push_number(message, at)
    }
    message
}

// Exact copy of length native [U8] elements into a fresh owned text:
// packed elements are the text's bytes, copied whole (rt_text_copy).
text_bytes_owned: fn(data: I64, length: I64) -> I64 {
    if (RT_HOST_U8_STRIDE == I64{1}) -> return rt_text_copy(data, length)
    result: rt_text_builder_with_capacity(length)
    text_bytes_push(result, data, I64{0}, length)
    result
}

// jet_string_validate_utf8: Ok() or the Utf8Error text.
#Export(c) jet_string_validate_utf8: fn(data: I64, length: I64, err: I64) -> I64 {
    message: text_bytes_utf8_error(data, length)
    if (message == I64{0}) -> return I64{1}
    rt_text_store(err, message)
    I64{0}
}

// jet_string_from_bytes: the validated copy, or UTF8Error carrying the same
// message (the record owns its own message copy).
#Export(c) jet_string_from_bytes: fn(data: I64, length: I64, ok: I64, err: I64) -> I64 {
    message: text_bytes_utf8_error(data, length)
    if (message != I64{0}) {
        rt_text_store(err, jet_rt_record_new_utf8_error(message))
        jet_rt_string_drop(message)
        return I64{0}
    }
    rt_text_store(ok, text_bytes_owned(data, length))
    I64{1}
}

// String::from_utf8_lossy: one U+FFFD per maximal invalid subpart; a
// truncated final sequence is replaced once. Each valid run is checked a
// word at a time (text_bytes_valid_end) and copied in one push.
#Export(c) jet_string_from_bytes_lossy: fn(data: I64, length: I64) -> I64 {
    result: rt_text_builder_with_capacity(length)
    at := I64{0}
    loop at < length {
        end: text_bytes_valid_end(data, at, length)
        text_bytes_push(result, data, at, end - at)
        if (end < length) {
            rt_text_push_scalar(result, I64{65533})
            at = end - rt_text_valid_width(wrapping(data + end * RT_HOST_U8_STRIDE), length - end, RT_HOST_U8_STRIDE)
        } else {
            at = end
        }
    }
    result
}

// jet_raw_bytes_into_text: Jet validated these bytes first; the borrowed list
// is copied, never adopted.
#Export(c) jet_raw_bytes_into_text: fn(data: I64, length: I64) -> I64 { text_bytes_owned(data, length) }

// jet_string_bytes: the UTF-8 bytes as a fresh [U8], one block move into
// the packed buffer (not a store per byte).
#Export(c) jet_string_bytes: fn(value: I64, output: I64) -> I64 {
    length: rt_text_len(value)
    if (length == I64{0}) {
        rt_text_store(output, I64{0})
        return I64{0}
    }
    if (length > I64{9223372036854775807} /% RT_HOST_U8_STRIDE) {
        rt_text_capacity_stop()
        return I64{0}
    }
    bytes: jet_rt_alloc_8(length * RT_HOST_U8_STRIDE)
    data: rt_text_data(value)
    if (RT_HOST_U8_STRIDE == I64{1}) {
        jet_rt_mem_move(bytes, data, length)
    } else {
        at := I64{0}
        loop at < length {
            host_u8_put(bytes, at, rt_text_byte(wrapping(data + at)))
            at += I64{1}
        }
    }
    rt_text_store(output, bytes)
    length
}

// jet_raw_string_byte: CAbiRoutes fixed::<u64> decodes the exact Int index,
// then the compiler-checked byte is read without a bound.
#Export(c) jet_raw_string_byte: fn(value: I64, index: I64) -> I64 {
    at: jet_int_owned_to_i64(index)
    if (jet_scheduler_native_propagate() != I64{0}) -> return I64{0}
    if (at < I64{0}) {
        trap_native_index_range_stop()
        return I64{0}
    }
    rt_text_byte(wrapping(rt_text_data(value) + at))
}
