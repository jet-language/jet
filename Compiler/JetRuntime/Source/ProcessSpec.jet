// Spec184 is a native private value carrier, not Rust or HostSpawn Spec256.
// CAbiRoutes builders BORROW parent/inputs and return an independent clone.
// DataABI owns offsets; TextDebug and UiCarriersBasic own nested codecs.
process_raw_box: fn(value: I64) -> I64 {
    result: jet_rt_alloc(ENCODING_ENUM_BYTES, I64{8})
    encoding_store(result, value)
    result
}
process_optional_raw_clone: fn(value: I64) -> I64 {
    if (value == I64{0}) -> I64{0} else -> encoding_enum_clone(value)
}
process_optional_text_clone: fn(value: I64) -> I64 {
    if (value == I64{0}) -> I64{0} else -> jet_rt_string_clone(value)
}
process_optional_text_eq: fn(a: I64, b: I64) -> Bool {
    if (a == I64{0} || b == I64{0}) -> return a == b
    jet_rt_string_eq(a, b)
}
process_optional_raw_eq: fn(a: I64, b: I64) -> Bool {
    if (a == I64{0} || b == I64{0}) -> return a == b
    encoding_enum_eq(a, b)
}
process_text_list_clone: fn(value: I64, pairs: Bool) -> I64 {
    if !pairs {
        result: jet_rt_alloc(DATA_SEQUENCE_BYTES, I64{8})
        data_text_list_copy_into(value, result)
        return result
    }
    length: encoding_word(wrapping(value + DATA_SEQUENCE_LENGTH))
    stride: DATA_TREE_ENTRY_BYTES
    result: data_sequence_new(length, stride)
    source: encoding_word(wrapping(value + DATA_SEQUENCE_DATA))
    target: encoding_word(wrapping(result + DATA_SEQUENCE_DATA))
    at := I64{0}
    loop at < length * stride {
        encoding_store(wrapping(target + at), jet_rt_string_clone(encoding_word(wrapping(source + at))))
        at += DATA_TREE_ELEMENT_BYTES
    }
    encoding_store(wrapping(result + DATA_SEQUENCE_LENGTH), length)
    result
}
process_text_list_drop: fn(value: I64, pairs: Bool) {
    if !pairs {
        coll_text_list_drop(value, true)
    } else {
        length: encoding_word(wrapping(value + DATA_SEQUENCE_LENGTH))
        data: encoding_word(wrapping(value + DATA_SEQUENCE_DATA))
        at := I64{0}
        loop at < length * DATA_TREE_ENTRY_BYTES {
            jet_rt_string_drop(encoding_word(wrapping(data + at)))
            at += DATA_TREE_ELEMENT_BYTES
        }
        capacity: encoding_word(wrapping(value + DATA_SEQUENCE_CAPACITY))
        if (capacity != I64{0}) -> jet_rt_free(data, capacity * DATA_TREE_ENTRY_BYTES, I64{8})
    }
    jet_rt_free(value, DATA_SEQUENCE_BYTES, I64{8})
}
process_text_list_eq: fn(a: I64, b: I64, pairs: Bool) -> Bool {
    length: encoding_word(wrapping(a + DATA_SEQUENCE_LENGTH))
    if length != encoding_word(wrapping(b + DATA_SEQUENCE_LENGTH)) -> return false
    stride: if pairs -> DATA_TREE_ENTRY_BYTES else -> DATA_TREE_ELEMENT_BYTES
    left: encoding_word(wrapping(a + DATA_SEQUENCE_DATA))
    right: encoding_word(wrapping(b + DATA_SEQUENCE_DATA))
    at := I64{0}
    loop at < length * stride {
        if !jet_rt_string_eq(encoding_word(wrapping(left + at)), encoding_word(wrapping(right + at))) -> return false
        at += DATA_TREE_ELEMENT_BYTES
    }
    true
}
process_text_list_push: fn(list: I64, text: I64) {
    slot: data_sequence_reserve(list, DATA_TREE_ELEMENT_BYTES)
    encoding_store(slot, jet_rt_string_clone(text))
    encoding_store(wrapping(list + DATA_SEQUENCE_LENGTH), encoding_word(wrapping(list + DATA_SEQUENCE_LENGTH)) + I64{1})
}
// An owned List24 of plain words (`.cpu_affinity`'s CPUs), or 0 when unset.
process_word_list_clone: fn(value: I64) -> I64 {
    if (value == I64{0}) -> return I64{0}
    length: encoding_word(wrapping(value + DATA_SEQUENCE_LENGTH))
    result: data_sequence_new(length, DATA_TREE_ELEMENT_BYTES)
    coll_copy(encoding_word(wrapping(value + DATA_SEQUENCE_DATA)), encoding_word(wrapping(result + DATA_SEQUENCE_DATA)), length * DATA_TREE_ELEMENT_BYTES)
    encoding_store(wrapping(result + DATA_SEQUENCE_LENGTH), length)
    result
}
process_word_list_drop: fn(value: I64) {
    if (value == I64{0}) -> return
    capacity: encoding_word(wrapping(value + DATA_SEQUENCE_CAPACITY))
    if (capacity != I64{0}) -> jet_rt_free(encoding_word(wrapping(value + DATA_SEQUENCE_DATA)), capacity * DATA_TREE_ELEMENT_BYTES, I64{8})
    jet_rt_free(value, DATA_SEQUENCE_BYTES, I64{8})
}
process_word_list_eq: fn(a: I64, b: I64) -> Bool {
    if (a == I64{0} || b == I64{0}) -> return a == b
    length: encoding_word(wrapping(a + DATA_SEQUENCE_LENGTH))
    if length != encoding_word(wrapping(b + DATA_SEQUENCE_LENGTH)) -> return false
    left: encoding_word(wrapping(a + DATA_SEQUENCE_DATA))
    right: encoding_word(wrapping(b + DATA_SEQUENCE_DATA))
    at := I64{0}
    loop at < length * DATA_TREE_ELEMENT_BYTES {
        if encoding_word(wrapping(left + at)) != encoding_word(wrapping(right + at)) -> return false
        at += DATA_TREE_ELEMENT_BYTES
    }
    true
}
#Export(c) jet_rt_handle_clone_process_spec: fn(value: I64) -> I64 {
    process_spec_clone(value, true)
}
// A launched execution keeps its spec for the receipt and limits, not for its
// passed directories: the child already holds those, so the parent's copies
// close when the spec that passed them ends, not when the collector lets go.
process_spec_clone: fn(value: I64, directories: Bool) -> I64 {
    result: jet_rt_alloc(PROCESS_SPEC_BYTES, I64{8})
    coll_copy(value, result, PROCESS_SPEC_BYTES)
    // Field helpers lend Bool bytes, so ignore padding and normalize clone words.
    encoding_store(wrapping(result + PROCESS_SPEC_ENV_CLEAR), if ((encoding_word(wrapping(value + PROCESS_SPEC_ENV_CLEAR)).bit_and(I64{255})) == I64{0}) -> I64{0} else -> I64{1})
    encoding_store(wrapping(result + PROCESS_SPEC_DETACHED), if ((encoding_word(wrapping(value + PROCESS_SPEC_DETACHED)).bit_and(I64{255})) == I64{0}) -> I64{0} else -> I64{1})
    encoding_store(wrapping(result + PROCESS_SPEC_CMD), process_text_list_clone(encoding_word(wrapping(value + PROCESS_SPEC_CMD)), false))
    encoding_store(wrapping(result + PROCESS_SPEC_CWD), process_optional_text_clone(encoding_word(wrapping(value + PROCESS_SPEC_CWD))))
    encoding_store(wrapping(result + PROCESS_SPEC_ENV_SET), process_text_list_clone(encoding_word(wrapping(value + PROCESS_SPEC_ENV_SET)), true))
    encoding_store(wrapping(result + PROCESS_SPEC_ENV_REMOVE), process_text_list_clone(encoding_word(wrapping(value + PROCESS_SPEC_ENV_REMOVE)), false))
    encoding_store(wrapping(result + PROCESS_SPEC_STDIN), process_optional_raw_clone(encoding_word(wrapping(value + PROCESS_SPEC_STDIN))))
    field := PROCESS_SPEC_TIMEOUT
    loop field <= PROCESS_SPEC_OPEN_FILE_LIMIT {
        encoding_store(wrapping(result + field), process_optional_raw_clone(encoding_word(wrapping(value + field))))
        field += DATA_TREE_ELEMENT_BYTES
    }
    terminal: encoding_word(wrapping(value + PROCESS_SPEC_TERMINAL))
    encoding_store(wrapping(result + PROCESS_SPEC_TERMINAL), if (terminal == I64{0}) -> I64{0} else -> jet_rt_handle_clone_terminal_policy(terminal))
    encoding_store(wrapping(result + PROCESS_SPEC_POLICY_WIRE), process_optional_text_clone(encoding_word(wrapping(value + PROCESS_SPEC_POLICY_WIRE))))
    encoding_store(wrapping(result + PROCESS_SPEC_DIRECTORIES), if directories -> spawn_dirs_clone(encoding_word(wrapping(value + PROCESS_SPEC_DIRECTORIES))) else -> I64{0})
    encoding_store(wrapping(result + PROCESS_SPEC_CPU_AFFINITY), process_word_list_clone(encoding_word(wrapping(value + PROCESS_SPEC_CPU_AFFINITY))))
    result
}
#Export(c) jet_rt_handle_drop_process_spec: fn(value: I64) {
    if (value == I64{0}) -> return
    process_text_list_drop(encoding_word(wrapping(value + PROCESS_SPEC_CMD)), false)
    jet_rt_string_drop(encoding_word(wrapping(value + PROCESS_SPEC_CWD)))
    process_text_list_drop(encoding_word(wrapping(value + PROCESS_SPEC_ENV_SET)), true)
    process_text_list_drop(encoding_word(wrapping(value + PROCESS_SPEC_ENV_REMOVE)), false)
    encoding_enum_drop(encoding_word(wrapping(value + PROCESS_SPEC_STDIN)))
    field := PROCESS_SPEC_TIMEOUT
    loop field <= PROCESS_SPEC_OPEN_FILE_LIMIT {
        encoding_enum_drop(encoding_word(wrapping(value + field)))
        field += DATA_TREE_ELEMENT_BYTES
    }
    jet_rt_handle_drop_terminal_policy(encoding_word(wrapping(value + PROCESS_SPEC_TERMINAL)))
    jet_rt_string_drop(encoding_word(wrapping(value + PROCESS_SPEC_POLICY_WIRE)))
    process_word_list_drop(encoding_word(wrapping(value + PROCESS_SPEC_CPU_AFFINITY)))
    directories: encoding_word(wrapping(value + PROCESS_SPEC_DIRECTORIES))
    if directories != (I64{0}) {
        index := I64{0}
        loop index < encoding_word(directories) {
            jet_fd_drop_raw(encoding_word(wrapping(encoding_word(wrapping(directories + I64{16})) + index * I64{24})))
            index += I64{1}
        }
        spawn_list_free(directories, I64{24})
    }
    jet_rt_free(value, PROCESS_SPEC_BYTES, I64{8})
}
#Export(c) jet_rt_handle_eq_process_spec: fn(a: I64, b: I64) -> Bool {
    if !process_text_list_eq(encoding_word(wrapping(a + PROCESS_SPEC_CMD)), encoding_word(wrapping(b + PROCESS_SPEC_CMD)), false) -> return false
    if !process_optional_text_eq(encoding_word(wrapping(a + PROCESS_SPEC_CWD)), encoding_word(wrapping(b + PROCESS_SPEC_CWD))) -> return false
    if (encoding_word(wrapping(a + PROCESS_SPEC_ENV_CLEAR)).bit_and(I64{255})) != (encoding_word(wrapping(b + PROCESS_SPEC_ENV_CLEAR)).bit_and(I64{255})) -> return false
    if !process_text_list_eq(encoding_word(wrapping(a + PROCESS_SPEC_ENV_SET)), encoding_word(wrapping(b + PROCESS_SPEC_ENV_SET)), true) -> return false
    if !process_text_list_eq(encoding_word(wrapping(a + PROCESS_SPEC_ENV_REMOVE)), encoding_word(wrapping(b + PROCESS_SPEC_ENV_REMOVE)), false) -> return false
    if !process_optional_raw_eq(encoding_word(wrapping(a + PROCESS_SPEC_STDIN)), encoding_word(wrapping(b + PROCESS_SPEC_STDIN))) -> return false
    if encoding_word(wrapping(a + PROCESS_SPEC_STDOUT)) != encoding_word(wrapping(b + PROCESS_SPEC_STDOUT)) -> return false
    if encoding_word(wrapping(a + PROCESS_SPEC_STDERR)) != encoding_word(wrapping(b + PROCESS_SPEC_STDERR)) -> return false
    field := PROCESS_SPEC_TIMEOUT
    loop field <= PROCESS_SPEC_OPEN_FILE_LIMIT {
        if !process_optional_raw_eq(encoding_word(wrapping(a + field)), encoding_word(wrapping(b + field))) -> return false
        field += DATA_TREE_ELEMENT_BYTES
    }
    if (encoding_word(wrapping(a + PROCESS_SPEC_DETACHED)).bit_and(I64{255})) != (encoding_word(wrapping(b + PROCESS_SPEC_DETACHED)).bit_and(I64{255})) -> return false
    if encoding_word(wrapping(a + PROCESS_SPEC_PARENT_DEATH)) != encoding_word(wrapping(b + PROCESS_SPEC_PARENT_DEATH)) -> return false
    if !process_word_list_eq(encoding_word(wrapping(a + PROCESS_SPEC_CPU_AFFINITY)), encoding_word(wrapping(b + PROCESS_SPEC_CPU_AFFINITY))) -> return false
    if encoding_word(wrapping(a + PROCESS_SPEC_IO_PRIORITY)) != encoding_word(wrapping(b + PROCESS_SPEC_IO_PRIORITY)) -> return false
    if encoding_word(wrapping(a + PROCESS_SPEC_IO_PRIORITY_LEVEL)) != encoding_word(wrapping(b + PROCESS_SPEC_IO_PRIORITY_LEVEL)) -> return false
    if encoding_word(wrapping(a + PROCESS_SPEC_MEMORY_SCOPE)) != encoding_word(wrapping(b + PROCESS_SPEC_MEMORY_SCOPE)) -> return false
    if encoding_word(wrapping(a + PROCESS_SPEC_MEMORY_SCOPE_BYTES)) != encoding_word(wrapping(b + PROCESS_SPEC_MEMORY_SCOPE_BYTES)) -> return false
    left: encoding_word(wrapping(a + PROCESS_SPEC_TERMINAL))
    right: encoding_word(wrapping(b + PROCESS_SPEC_TERMINAL))
    if (left == I64{0} || right == I64{0}) {
        if left != right -> return false
    } else if !jet_rt_handle_eq_terminal_policy(left, right) -> return false
    if !process_optional_text_eq(encoding_word(wrapping(a + PROCESS_SPEC_POLICY_WIRE)), encoding_word(wrapping(b + PROCESS_SPEC_POLICY_WIRE))) -> return false
    left_directories: encoding_word(wrapping(a + PROCESS_SPEC_DIRECTORIES))
    right_directories: encoding_word(wrapping(b + PROCESS_SPEC_DIRECTORIES))
    left_count: if left_directories == (I64{0}) -> { I64{0} } else -> { encoding_word(left_directories) }
    right_count: if right_directories == (I64{0}) -> { I64{0} } else -> { encoding_word(right_directories) }
    if left_count != right_count -> return false
    if left_count == (I64{0}) -> return true
    left_data: encoding_word(wrapping(left_directories + I64{16}))
    right_data: encoding_word(wrapping(right_directories + I64{16}))
    offset := I64{0}
    loop offset < left_count * (I64{24}) {
        if encoding_word(wrapping(left_data + offset)) != encoding_word(wrapping(right_data + offset)) -> return false
        offset += I64{8}
    }
    true
}
#Export(c) jet_rt_handle_field_process_spec_env_clear: fn(value: I64) -> I64 { value + PROCESS_SPEC_ENV_CLEAR }
#Export(c) jet_rt_handle_field_process_spec_detached: fn(value: I64) -> I64 { value + PROCESS_SPEC_DETACHED }
#Export(c) jet_rt_handle_show_process_spec: fn(value: I64) -> I64 {
    result: jet_rt_string_builder_new()
    rt_text_push_word(result, I64{6013276806766883408}, I64{8}) // ProcessS
    rt_text_push_word(result, I64{391519626608}, I64{5}) // pec([
    cmd: encoding_word(wrapping(value + PROCESS_SPEC_CMD))
    data: encoding_word(wrapping(cmd + DATA_SEQUENCE_DATA))
    length: encoding_word(wrapping(cmd + DATA_SEQUENCE_LENGTH))
    at := I64{0}
    loop at < length {
        if (at != I64{0}) -> rt_text_push_word(result, I64{8236}, I64{2})
        rt_text_push_rust_debug_str(result, encoding_word(wrapping(data + at * DATA_TREE_ELEMENT_BYTES)))
        at += I64{1}
    }
    rt_text_push_word(result, I64{10589}, I64{2}) // ])
    jet_rt_string_builder_finish(result)
}
// Real pure-data producer, consumes an already-owned native List<Text> holder.
jet_std_process_cmd_owned: fn(cmd: I64) -> I64 {
    result: jet_rt_alloc(PROCESS_SPEC_BYTES, I64{8})
    coll_zero(result, PROCESS_SPEC_BYTES)
    encoding_store(wrapping(result + PROCESS_SPEC_CMD), cmd)
    encoding_store(wrapping(result + PROCESS_SPEC_ENV_SET), data_sequence_new(I64{0}, DATA_TREE_ENTRY_BYTES))
    encoding_store(wrapping(result + PROCESS_SPEC_ENV_REMOVE), data_sequence_new(I64{0}, DATA_TREE_ELEMENT_BYTES))
    encoding_store(wrapping(result + PROCESS_SPEC_STDOUT), PROCESS_STREAM_CAPTURE)
    encoding_store(wrapping(result + PROCESS_SPEC_STDERR), PROCESS_STREAM_CAPTURE)
    encoding_store(wrapping(result + PROCESS_SPEC_OUTPUT_LIMIT), process_raw_box(PROCESS_SPEC_DEFAULT_OUTPUT_LIMIT))
    result
}
#Export(c) jet_std_process_cmd: fn(data: I64, length: I64) -> I64 {
    // list_in treats null data or nonpositive length as empty.
    count: if (length <= I64{0} || data == I64{0}) -> I64{0} else -> length
    cmd: data_sequence_new(count, DATA_TREE_ELEMENT_BYTES)
    at := I64{0}
    loop at < count {
        process_text_list_push(cmd, encoding_word(wrapping(data + at * DATA_TREE_ELEMENT_BYTES)))
        at += I64{1}
    }
    jet_std_process_cmd_owned(cmd)
}
// Each builder consumes the spec it is given (the route's receiver is moved,
// RouteHandle `process.spec.*`) and returns it changed in place, so the rows
// it owns, held directories included, have exactly one owner.
#Export(c) jet_process_spec_arg: fn(value: I64, extra: I64) -> I64 {
    result: value
    process_text_list_push(encoding_word(wrapping(result + PROCESS_SPEC_CMD)), extra)
    result
}
#Export(c) jet_process_spec_args_extend: fn(value: I64, data: I64, length: I64) -> I64 {
    result: value
    if (data == I64{0}) -> return result
    cmd: encoding_word(wrapping(result + PROCESS_SPEC_CMD))
    at := I64{0}
    loop at < length {
        process_text_list_push(cmd, encoding_word(wrapping(data + at * DATA_TREE_ELEMENT_BYTES)))
        at += I64{1}
    }
    result
}
#Export(c) jet_process_spec_cwd: fn(value: I64, cwd: I64) -> I64 {
    result: value
    jet_rt_string_drop(encoding_word(wrapping(result + PROCESS_SPEC_CWD)))
    encoding_store(wrapping(result + PROCESS_SPEC_CWD), jet_rt_string_clone(cwd))
    result
}
// The last env/env_remove for a name wins: each forgets the other's earlier rows for it.
// `stride` is 16 for [name, value] set rows and 8 for removal names; dropped rows free their texts.
process_spec_env_forget: fn(list: I64, stride: I64, name: I64) {
    length: encoding_word(wrapping(list + DATA_SEQUENCE_LENGTH))
    data: encoding_word(wrapping(list + DATA_SEQUENCE_DATA))
    kept := I64{0}
    at := I64{0}
    loop at < length {
        row: wrapping(data + at * stride)
        if jet_rt_string_eq(encoding_word(row), name) {
            jet_rt_string_drop(encoding_word(row))
            if (stride == I64{16}) -> jet_rt_string_drop(encoding_word(wrapping(row + I64{8})))
        } else {
            if (kept != at) {
                encoding_store(wrapping(data + kept * stride), encoding_word(row))
                if (stride == I64{16}) -> encoding_store(wrapping(wrapping(data + kept * stride) + I64{8}), encoding_word(wrapping(row + I64{8})))
            }
            kept += I64{1}
        }
        at += I64{1}
    }
    encoding_store(wrapping(list + DATA_SEQUENCE_LENGTH), kept)
}
#Export(c) jet_process_spec_env: fn(value: I64, name: I64, text: I64) -> I64 {
    result: value
    process_spec_env_forget(encoding_word(wrapping(result + PROCESS_SPEC_ENV_REMOVE)), DATA_TREE_ELEMENT_BYTES, name)
    process_spec_env_forget(encoding_word(wrapping(result + PROCESS_SPEC_ENV_SET)), DATA_TREE_ENTRY_BYTES, name)
    list: encoding_word(wrapping(result + PROCESS_SPEC_ENV_SET))
    slot: data_sequence_reserve(list, DATA_TREE_ENTRY_BYTES)
    encoding_store(wrapping(slot + DATA_TREE_ENTRY_KEY), jet_rt_string_clone(name))
    encoding_store(wrapping(slot + DATA_TREE_ENTRY_VALUE), jet_rt_string_clone(text))
    encoding_store(wrapping(list + DATA_SEQUENCE_LENGTH), encoding_word(wrapping(list + DATA_SEQUENCE_LENGTH)) + I64{1})
    result
}
#Export(c) jet_process_spec_env_remove: fn(value: I64, name: I64) -> I64 {
    result: value
    process_spec_env_forget(encoding_word(wrapping(result + PROCESS_SPEC_ENV_SET)), DATA_TREE_ENTRY_BYTES, name)
    process_spec_env_forget(encoding_word(wrapping(result + PROCESS_SPEC_ENV_REMOVE)), DATA_TREE_ELEMENT_BYTES, name)
    process_text_list_push(encoding_word(wrapping(result + PROCESS_SPEC_ENV_REMOVE)), name)
    result
}
#Export(c) jet_process_spec_env_clear: fn(value: I64) -> I64 {
    result: value
    encoding_store(wrapping(result + PROCESS_SPEC_ENV_CLEAR), I64{1})
    result
}
#Export(c) jet_process_spec_detached: fn(value: I64) -> I64 {
    result: value
    encoding_store(wrapping(result + PROCESS_SPEC_DETACHED), I64{1})
    result
}
// core.process.__spec_parent_death (process.run_all): the child gets SIGKILL
// when this process dies (PR_SET_PDEATHSIG); a detached spec ignores it.
#Export(c) jet_process_spec_parent_death: fn(value: I64) -> I64 {
    result: value
    encoding_store(wrapping(result + PROCESS_SPEC_PARENT_DEATH), I64{1})
    result
}
process_spec_raw_replace: fn(value: I64, field: I64, raw: I64) -> I64 {
    result: value
    encoding_enum_drop(encoding_word(wrapping(result + field)))
    encoding_store(wrapping(result + field), process_raw_box(raw))
    result
}
jet_process_limit_i64: fn(value: I64) -> I64 {
    if int_negative(value) -> return I64{0}
    if !int_fits(value, U64{9223372036854775807}) -> return I64{9223372036854775807}
    int_word(value)
}
#Export(c) jet_process_spec_output_limit: fn(value: I64, limit: I64) -> I64 { process_spec_raw_replace(value, PROCESS_SPEC_OUTPUT_LIMIT, jet_process_limit_i64(limit)) }
#Export(c) jet_process_spec_memory_limit: fn(value: I64, limit: I64) -> I64 { process_spec_raw_replace(value, PROCESS_SPEC_MEMORY_LIMIT, jet_process_limit_i64(limit)) }
#Export(c) jet_process_spec_open_file_limit: fn(value: I64, limit: I64) -> I64 { process_spec_raw_replace(value, PROCESS_SPEC_OPEN_FILE_LIMIT, jet_process_limit_i64(limit)) }
// An exact Int as a word: inline values as they are, larger ones saturated,
// so the launch check still sees their sign and that they are out of range.
process_int_saturated: fn(value: I64) -> I64 {
    if int_inline(value) -> return value
    if int_negative(value) -> I64{-9223372036854775807} else -> I64{9223372036854775807}
}
// `.cpu_affinity(cpus)`: the CPUs the child may run on, set with
// sched_setaffinity in the child before exec. The list is kept as given;
// launch refuses an empty one or a CPU outside the PROCESS_CPU_SET_CPUS set
// (process_execution_affinity_mask).
#Export(c) jet_process_spec_cpu_affinity: fn(value: I64, data: I64, length: I64) -> I64 {
    result: value
    process_word_list_drop(encoding_word(wrapping(result + PROCESS_SPEC_CPU_AFFINITY)))
    count: if (length <= I64{0} || data == I64{0}) -> I64{0} else -> length
    cpus: data_sequence_new(count, DATA_TREE_ELEMENT_BYTES)
    target: encoding_word(wrapping(cpus + DATA_SEQUENCE_DATA))
    at := I64{0}
    loop at < count {
        encoding_store(wrapping(target + at * DATA_TREE_ELEMENT_BYTES), process_int_saturated(encoding_word(wrapping(data + at * DATA_TREE_ELEMENT_BYTES))))
        at += I64{1}
    }
    encoding_store(wrapping(cpus + DATA_SEQUENCE_LENGTH), count)
    encoding_store(wrapping(result + PROCESS_SPEC_CPU_AFFINITY), cpus)
    result
}
// `.io_priority(level)`: the best-effort I/O class at `level`, set with
// ioprio_set in the child before exec. Both words are plain, so clone copies
// them; launch refuses a level outside 0..PROCESS_IO_PRIORITY_LEVELS-1
// (process_execution_io_priority_refusal).
#Export(c) jet_process_spec_io_priority: fn(value: I64, level: I64) -> I64 {
    result: value
    encoding_store(wrapping(result + PROCESS_SPEC_IO_PRIORITY), PROCESS_IO_PRIORITY_BEST_EFFORT)
    encoding_store(wrapping(result + PROCESS_SPEC_IO_PRIORITY_LEVEL), process_int_saturated(level))
    result
}
// `.io_idle()`: the idle I/O class, which gets the disk only when no other
// process wants it. It replaces any `.io_priority(level)`, and that replaces it.
#Export(c) jet_process_spec_io_idle: fn(value: I64) -> I64 {
    result: value
    encoding_store(wrapping(result + PROCESS_SPEC_IO_PRIORITY), PROCESS_IO_PRIORITY_IDLE)
    encoding_store(wrapping(result + PROCESS_SPEC_IO_PRIORITY_LEVEL), I64{0})
    result
}
// `.memory_scope(bytes)`: the child and its descendants run in a cgroup v2
// scope capped at `bytes` (ProcessScope.jet). Both words are plain, so clone
// copies them; launch refuses a cap below 1.
#Export(c) jet_process_spec_memory_scope: fn(value: I64, bytes: I64) -> I64 {
    result: value
    encoding_store(wrapping(result + PROCESS_SPEC_MEMORY_SCOPE), I64{1})
    encoding_store(wrapping(result + PROCESS_SPEC_MEMORY_SCOPE_BYTES), process_int_saturated(bytes))
    result
}
process_spec_mode: fn(value: I64, mode: I64, field: I64) -> I64 {
    // Frozen CAbiRoutes range_stop, not exact Int native() conversion.
    if (mode < PROCESS_STREAM_STREAM || mode > PROCESS_STREAM_STDOUT) {
        trap_native_index_range_stop()
        if (jet_scheduler_native_propagate() != I64{0}) {
            jet_rt_handle_drop_process_spec(value)
            return I64{0}
        }
    }
    if (field == PROCESS_SPEC_STDIN) -> return process_spec_raw_replace(value, field, mode)
    result: value
    encoding_store(wrapping(result + field), mode)
    result
}
#Export(c) jet_process_spec_stdin: fn(value: I64, mode: I64) -> I64 { process_spec_mode(value, mode, PROCESS_SPEC_STDIN) }
#Export(c) jet_process_spec_stdout: fn(value: I64, mode: I64) -> I64 { process_spec_mode(value, mode, PROCESS_SPEC_STDOUT) }
#Export(c) jet_process_spec_stderr: fn(value: I64, mode: I64) -> I64 { process_spec_mode(value, mode, PROCESS_SPEC_STDERR) }
#Export(c) jet_process_spec_terminal: fn(value: I64) -> I64 {
    result: value
    jet_rt_handle_drop_terminal_policy(encoding_word(wrapping(result + PROCESS_SPEC_TERMINAL)))
    encoding_store(wrapping(result + PROCESS_SPEC_TERMINAL), ui_carrier_terminal_policy_new(I64{80}, I64{24}, I64{1}))
    result
}
#Export(c) jet_process_spec_terminal_with_policy: fn(value: I64, policy: I64) -> I64 {
    result: value
    jet_rt_handle_drop_terminal_policy(encoding_word(wrapping(result + PROCESS_SPEC_TERMINAL)))
    encoding_store(wrapping(result + PROCESS_SPEC_TERMINAL), jet_rt_handle_clone_terminal_policy(policy))
    result
}
// A Duration crosses its Word route as the borrowed exact-Int carrier of its
// ns (Routes.jet lower_route_word_getter, CAbiRoutes `Duration { ns:
// native(word) }`); a Duration always fits i64.
process_duration_millis: fn(nanos: I64) -> I64 {
    // The Rust original truncates towards zero before max(0).
    millis: host_native_int(nanos) /% I64{1000000}
    if (millis < I64{0}) -> I64{0} else -> millis
}
#Export(c) jet_process_spec_timeout: fn(value: I64, timeout: I64) -> I64 {
    process_spec_raw_replace(value, PROCESS_SPEC_TIMEOUT, process_duration_millis(timeout))
}
#Export(c) jet_process_spec_cpu_time_limit: fn(value: I64, timeout: I64) -> I64 {
    process_spec_raw_replace(value, PROCESS_SPEC_CPU_TIME_LIMIT, process_duration_millis(timeout))
}
