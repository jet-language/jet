            rt_text_store(bytes + DATA_SEQUENCE_LENGTH, length + count)
        } else if (count == I64{0}) {
            rt_text_store(out, bytes)
            return I64{0}
        } else if (count != I64{-4}) {
            thread_zero(rt_text_word(bytes + DATA_SEQUENCE_DATA), rt_text_word(bytes + DATA_SEQUENCE_CAPACITY))
            rt_text_put(scratch, I64{0})
            data_sequence_drop(bytes, DATA_TREE_BYTE_LIST)
            return vault_error_new(I64{4}, I64{0}, I64{0})
