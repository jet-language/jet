// Seed2058-2083 var_os(HOME) parity. The shared HostStartup raw accessor lends
// process-lifetime bytes only while this final NUL path is constructed.
fn vault_trust_home_path(home: I64) -> I64 {
    length :: host_startup_byte_length(home)
    separator :: length != I64{0} && rt_text_byte(home + length - I64{1}) != I64{47}
    if (length > I64{9223372036854775795}) -> return I64{0}
    suffix :: length + (if separator -> I64{1} else -> I64{0})
    path :: jet_rt_alloc(suffix + I64{11}, I64{1})
    rt_text_bytes_copy(path, home, length)
    if separator -> rt_text_put(path + length, I64{47})
    rt_text_store(path + suffix, I64{8462954396947671598})
    rt_text_put(path + suffix + I64{8}, I64{115})
    rt_text_put(path + suffix + I64{9}, I64{116})
    rt_text_put(path + suffix + I64{10}, I64{0})
    path
}
fn vault_trust_lines(bytes: I64, length: I64, repo: I64, scratch: I64) -> Bool {
    if !vault_utf8_valid(bytes, length) -> return false
    rt_text_store(scratch, I64{8319620158379356775})
    rt_text_store(scratch + I64{8}, I64{8389209267340210789})
    rt_text_store(scratch + I64{16}, I64{16437099308939054})
    vault_hex_put(scratch + I64{23}, repo, I64{16})
    start := I64{0}
    loop start < length {
        end := start
        loop end < length {
            if (rt_text_byte(bytes + end) == I64{10}) -> break
            end += I64{1}
        }
        begin :: vault_crypto_trim_start(bytes + start, end - start)
        finish :: vault_crypto_trim_end(bytes + start, begin, end - start)
        if (finish - begin == I64{55}) {
            line :: bytes + start + begin
            rt_text_store(scratch, I64{8319620158379356775})
            rt_text_store(scratch + I64{8}, I64{8389209267340210789})
            if rt_text_equal_bytes(line, scratch, I64{55}) -> return true
            rt_text_store(scratch, I64{7309969416918233703})
            rt_text_store(scratch + I64{8}, I64{8389209267340210032})
            if rt_text_equal_bytes(line, scratch, I64{55}) -> return true
        }
        start = end + I64{1}
    }
    false
}
