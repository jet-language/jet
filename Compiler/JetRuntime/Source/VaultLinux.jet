// SecretsCrypto.rs:2260-2277. Borrowed fds; exclusive stat scratch288.
fn vault_linux_same_inode(left: I64, right: I64, scratch: I64) -> Bool {
    if (vault_linux_stat(left, scratch) != I64{0}) -> return false
    if (vault_linux_stat(right, scratch + VAULT_STAT_BYTES) != I64{0}) -> return false
