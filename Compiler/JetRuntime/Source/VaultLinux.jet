    loop at < (I64{832}) {
        rt_text_store(scratch + at, I64{-1})
        at += I64{8}
    }
    error :: vault_write_inner(root, store, hash, provider, kind, revision, scratch)
    at = I64{800}
    loop at < (I64{832}) {
        vault_linux_close(rt_text_word(scratch + at))
        at += I64{8}
    }
    at = I64{832}
    loop at < (I64{872}) {
        vault_store_drop(rt_text_word(scratch + at))
        at += I64{8}
    }
    plaintext :: rt_text_word(scratch + I64{872})
    if (plaintext != I64{0}) {
        vault_text_zero(plaintext)
        jet_rt_string_drop(plaintext)
    }
    ciphertext :: rt_text_word(scratch + I64{880})
    if (ciphertext != I64{0}) {
        thread_zero(rt_text_word(ciphertext + DATA_SEQUENCE_DATA), rt_text_word(ciphertext + DATA_SEQUENCE_CAPACITY))
