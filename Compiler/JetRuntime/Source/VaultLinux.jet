        if (rt_text_byte(data + at) == I64{47}) {
            at += I64{1}
        } else {
            if (rt_text_byte(data + at) != I64{46}) -> return false
            at += I64{1}
            if (at < length && rt_text_byte(data + at) != I64{47}) -> return false
        }
    }
    true
}
