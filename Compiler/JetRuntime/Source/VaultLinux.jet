// Success adopts the VERIFIED installed fd; failure leaves installed_out alone.
fn vault_linux_install_exact(dirfd: I64, next: I64, final_name: I64, temp: I64, absent: Bool, scratch: I64, installed_out: I64) -> I64 {
    visible :: vault_linux_openat(dirfd, next, I64{0}, I64{0}, scratch)
