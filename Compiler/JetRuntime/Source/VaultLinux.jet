// Seed BufReader::read_line: grow only when the line fills the current buffer,
// stop at its FIRST LF (ignore any read-ahead), and retry only read's EINTR.
fn vault_tty_answer(file: I64) -> Bool {
    bytes :: data_sequence_new(I64{8192}, RT_HOST_U8_STRIDE)
    complete := false
    valid := true
    loop {
        if complete -> break
        length :: rt_text_word(bytes + DATA_SEQUENCE_LENGTH)
        if (length == rt_text_word(bytes + DATA_SEQUENCE_CAPACITY)) -> _ := data_sequence_reserve(bytes, RT_HOST_U8_STRIDE)
        data :: rt_text_word(bytes + DATA_SEQUENCE_DATA)
        capacity :: rt_text_word(bytes + DATA_SEQUENCE_CAPACITY)
        read :: trap_syscall(I64{0}, file, data + length, capacity - length, I64{0}, I64{0}, I64{0})
        if (read == I64{-4}) -> next
        if (read < I64{0}) {
            valid = false
            break
        }
        if (read == I64{0}) -> break
        end := length
        loop end < length + read {
            if (rt_text_byte(data + end) == I64{10}) {
                end += I64{1}
                complete = true
                break
            }
            end += I64{1}
        }
        rt_text_store(bytes + DATA_SEQUENCE_LENGTH, end)
    }
    data :: rt_text_word(bytes + DATA_SEQUENCE_DATA)
    length :: rt_text_word(bytes + DATA_SEQUENCE_LENGTH)
    accepted := false
    if valid && vault_utf8_valid(data, length) {
        begin :: vault_crypto_trim_start(data, length)
        end :: vault_crypto_trim_end(data, begin, length)
        if (end - begin == I64{9}) {
            accepted = vault_lock_key(data + begin, I64{9}, I64{8820707168001226081}, I64{101}, I64{9})
        }
    }
    thread_zero(data, rt_text_word(bytes + DATA_SEQUENCE_CAPACITY))
    data_sequence_drop(bytes, DATA_TREE_BYTE_LIST)
    accepted
}
