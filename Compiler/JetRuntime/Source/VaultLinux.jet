        suffix_length = I64{16}
        rt_text_store(scratch, I64{3347146927126046067})
        rt_text_store(scratch + I64{8}, I64{8751735924676977769})
    } else {
        suffix_length = I64{26}
        rt_text_store(scratch, I64{8747515702797494830})
        rt_text_store(scratch + I64{8}, I64{8387235652276793203})
        rt_text_store(scratch + I64{16}, I64{7598819853036236403})
        rt_text_store(scratch + I64{24}, I64{31092})
    }
    separator :: base_length != I64{0} && (dot || rt_text_byte(base_data + base_length - I64{1}) != I64{47})
    if (base_length > I64{9223372036854775807} - suffix_length - I64{2}) {
        jet_rt_string_drop(owned_base)
        jet_rt_free(scratch, I64{64}, I64{8})
        return I64{0}
    }
    length :: base_length + (if separator -> I64{1} else -> I64{0}) + suffix_length
    result :: jet_rt_alloc(I64{24}, I64{8})
    data :: jet_rt_alloc(length + I64{1}, I64{1})
    if dot { rt_text_put(data, I64{46}) } else { rt_text_bytes_copy(data, base_data, base_length) }
    cursor := base_length
    if separator {
        rt_text_put(data + cursor, I64{47})
        cursor += I64{1}
    }
    rt_text_bytes_copy(data + cursor, scratch, suffix_length)
    rt_text_put(data + length, I64{0})
    rt_text_store(result, data)
    rt_text_store(result + I64{8}, length)
    rt_text_store(result + I64{16}, length + I64{1})
    jet_rt_string_drop(owned_base)
    jet_rt_free(scratch, I64{64}, I64{8})
    result
}
// Identity reads intentionally follow symlinks, unlike vault-directory reads.
// InvalidData is mapped by the subsequent crypto UTF-8 preflight to Locked.
fn vault_identity_read_at_root(root: I64, out: I64) -> I64 {
    path :: vault_identity_path(root)
    if (path == I64{0}) -> return vault_error_new(I64{4}, I64{0}, I64{0})
    file :: vault_linux_plain_open(rt_text_data(path))
    jet_rt_string_drop(path)
    if (file < I64{0}) -> return vault_error_new(I64{4}, I64{0}, I64{0})
    scratch :: jet_rt_alloc(I64{8}, I64{8})
    error :: vault_linux_read_to_end(file, out, scratch)
    vault_linux_close(file)
    jet_rt_free(scratch, I64{8}, I64{8})
    error
}

// Every seed std File::open/fs::read* site uses cvt_r; raw openat2/pidfd sites
// do NOT. This single plain reader follows symlinks and retries only EINTR.
fn vault_linux_plain_open(path: I64) -> I64 {
    file := I64{-4}
    loop file == (I64{-4}) {
        file = trap_syscall(I64{257}, I64{-100}, path, VAULT_O_CLOEXEC, I64{0}, I64{0}, I64{0})
    }
    file
}
// Reuse Display.jet's unsigned split and final integer-digit writer directly,
// avoiding a temporary Text owner/copy for decimal path and lock fields.
fn vault_decimal_put(out: I64, value: I64) -> I64 {
    half :: (value >> I64{1}) & I64{9223372036854775807}
    quotient :: half /% I64{5}
    remainder :: (half % I64{5}) * I64{2} + (value & I64{1})
    if (quotient == I64{0}) {
        rt_text_put(out, I64{48} + remainder)
        return I64{1}
    }
    digits :: display_integer_length(quotient)
    display_integer_digits(out, digits, quotient, digits)
    rt_text_put(out + digits, I64{48} + remainder)
    digits + I64{1}
}
// Scheduler.jet:454-472's checked unsigned accumulation, without zero->one
// thread-count policy. Uint::from_str accepts '+' but neither '-' nor spaces.
fn vault_parse_uint(bytes: I64, length: I64, narrow: Bool, out: I64) -> Bool {
    if (length == I64{0}) -> return false
    start :: if (rt_text_byte(bytes) == I64{43}) -> I64{1} else -> I64{0}
    if (start == length) -> return false
    limit :: if narrow -> I64{429496729} else -> I64{1844674407370955161}
    value := I64{0}
    at := start
    loop at < length {
        byte :: rt_text_byte(bytes + at)
        if (byte < I64{48} || byte > I64{57}) -> return false
        digit :: byte - I64{48}
        if (value < I64{0} || value > limit || (value == limit && digit > I64{5})) -> return false
        value = wrapping(value * I64{10} + digit)
        at += I64{1}
    }
    rt_text_store(out, value)
    true
}
// SecretsCrypto.rs:2345-2348: LAST ')' then the TWENTIETH whitespace token.
// Successful zero and all 64-bit values remain distinct from parse failure.
fn vault_process_start_parse(bytes: I64, length: I64, out: I64) -> Bool {
    if (length == I64{0} || !vault_utf8_valid(bytes, length)) -> return false
    close := length
    loop {
        if (close == I64{0}) -> return false
        close -= I64{1}
        if (rt_text_byte(bytes + close) == I64{41}) -> break
    }
    at := close + I64{1}
    token := I64{0}
    loop {
        at += vault_crypto_trim_start(bytes + at, length - at)
        if (at == length) -> return false
        end := at
        loop end < length {
            if unicode_is_white_space(rt_text_decode(bytes + end)) -> break
            end += rt_text_width(bytes + end)
        }
        if (token == I64{19}) -> return vault_parse_uint(bytes + at, end - at, false, out)
        token += I64{1}
        at = end
    }
}
fn vault_process_start(pid: I64, out: I64) -> Bool {
    scratch :: jet_rt_alloc(I64{48}, I64{8})
    rt_text_store(scratch, I64{52104118038575}) // "/proc/"
    digits :: vault_decimal_put(scratch + I64{6}, pid)
    rt_text_store(scratch + I64{6} + digits, I64{499851227951}) // "/stat\0"
    file :: vault_linux_plain_open(scratch)
    if (file < I64{0}) {
        jet_rt_free(scratch, I64{48}, I64{8})
        return false
    }
    error :: vault_linux_read_to_end(file, scratch + I64{32}, scratch + I64{40})
    vault_linux_close(file)
    if (error != I64{0}) {
        vault_error_drop(error)
        jet_rt_free(scratch, I64{48}, I64{8})
        return false
    }
    bytes :: rt_text_word(scratch + I64{32})
    parsed :: vault_process_start_parse(rt_text_word(bytes + DATA_SEQUENCE_DATA), rt_text_word(bytes + DATA_SEQUENCE_LENGTH), out)
    data_sequence_drop(bytes, DATA_TREE_BYTE_LIST)
    jet_rt_free(scratch, I64{48}, I64{8})
    parsed
}

// SecretsCrypto.rs:2351-2413. All spans borrow the validated UTF-8 lock text.
// No case normalization: only the nonce accepts uppercase ASCII hex.
fn vault_valid_hex(bytes: I64, length: I64, count: I64) -> Bool {
    if (length != count) -> return false
    nonzero := false
    at := I64{0}
    loop at < length {
        byte :: rt_text_byte(bytes + at)
        if !((byte >= I64{48} && byte <= I64{57}) || (byte >= I64{65} && byte <= I64{70}) || (byte >= I64{97} && byte <= I64{102})) -> return false
        if (byte != I64{48}) -> nonzero = true
        at += I64{1}
    }
    nonzero
}
fn vault_lock_key(bytes: I64, length: I64, first: I64, second: I64, count: I64) -> Bool {
    if (length != count) -> return false
    at := I64{0}
    loop at < count {
        word :: if (at < I64{8}) -> first else -> second
        if (rt_text_byte(bytes + at) != ((word >> ((at % I64{8}) * I64{8})) & I64{255})) -> return false
        at += I64{1}
    }
    true
}
fn vault_lock_hex_equal(text: I64, length: I64, raw: I64, count: I64) -> Bool {
    if (length != count * I64{2}) -> return false
    at := I64{0}
    loop at < length {
        byte :: rt_text_byte(raw + at /% I64{2})
        nibble :: if (at % I64{2} == I64{0}) -> byte >> I64{4} else -> byte & I64{15}
        expected :: if (nibble < I64{10}) -> nibble + I64{48} else -> nibble + I64{87}
        if (rt_text_byte(text + at) != expected) -> return false
        at += I64{1}
    }
    true
}
// out exclusively borrows 32 bytes (pid/start/nonce span); scratch borrows8.
// Failure leaves out untouched, including invalid UTF-8/missing/invalid fields.
// Each occurrence replaces the previous value, EVEN when numeric parsing fails.
fn vault_lock_fields(bytes: I64, length: I64, expected_repo: I64, expected_revision: I64, expected_hash: I64, out: I64, scratch: I64) -> Bool {
    if !vault_utf8_valid(bytes, length) -> return false
    repo := I64{0}
    repo_length := I64{0}
    hash := I64{0}
    hash_length := I64{0}
    nonce := I64{0}
    nonce_length := I64{0}
    pid := I64{0}
    start := I64{0}
    revision := I64{0}
    pid_valid := false
    start_valid := false
    revision_valid := false
    at := I64{0}
    loop at < length {
        at += vault_crypto_trim_start(bytes + at, length - at)
        if (at == length) -> break
        end := at
        equals := length
        loop end < length {
            if unicode_is_white_space(rt_text_decode(bytes + end)) -> break
            if (equals == length && rt_text_byte(bytes + end) == I64{61}) -> equals = end
            end += rt_text_width(bytes + end)
        }
        if (equals != length) {
            key :: bytes + at
            key_length :: equals - at
            value :: bytes + equals + I64{1}
            value_length :: end - equals - I64{1}
            if vault_lock_key(key, key_length, I64{1869636978}, I64{0}, I64{4}) {
                repo = value
                repo_length = value_length
            } else if vault_lock_key(key, key_length, I64{7957695010998478194}, I64{0}, I64{8}) {
                revision_valid = vault_parse_uint(value, value_length, false, scratch)
                if revision_valid -> revision = rt_text_word(scratch)
            } else if vault_lock_key(key, key_length, I64{6580592}, I64{0}, I64{3}) {
                pid_valid = vault_parse_uint(value, value_length, true, scratch)
                if pid_valid -> pid = rt_text_word(scratch)
            } else if vault_lock_key(key, key_length, I64{3275088233325621872}, I64{500135195763}, I64{13}) {
                start_valid = vault_parse_uint(value, value_length, false, scratch)
                if start_valid -> start = rt_text_word(scratch)
            } else if vault_lock_key(key, key_length, I64{435459878766}, I64{0}, I64{5}) {
                nonce = value
                nonce_length = value_length
            } else if vault_lock_key(key, key_length, I64{1752392040}, I64{0}, I64{4}) {
                hash = value
                hash_length = value_length
            }
        }
        at = end
    }
    if (!pid_valid || !start_valid || !revision_valid || revision != expected_revision) -> return false
    if !vault_lock_hex_equal(repo, repo_length, expected_repo, I64{16}) -> return false
    if !vault_lock_hex_equal(hash, hash_length, expected_hash, I64{32}) -> return false
    if !vault_valid_hex(nonce, nonce_length, I64{32}) -> return false
    rt_text_store(out, pid)
    rt_text_store(out + I64{8}, start)
    rt_text_store(out + I64{16}, nonce)
    rt_text_store(out + I64{24}, nonce_length)
    true
}
