// live. Binary result adopts a packed DataSequence, not a Rust Vec carrier.
// scratch borrows one exclusive byte for EOF probing; a full buffer does not
// allocate or copy merely to discover EOF.
fn vault_linux_read_file(file: I64, out: I64, scratch: I64) -> I64 {
