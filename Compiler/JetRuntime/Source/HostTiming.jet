// Host admission for fixed timing (core.sys.timing_host): whether this
// processor's vendor states that the instructions the fixed-timing validator
// admits (JetIR Timing.jet) run in data-independent time here.
//
// Intel, "Data Operand Independent Timing Instruction Set Architecture (ISA)
// Guidance" (2022): on a processor that enumerates DOITM (IA32_ARCH_CAPABILITIES
// bit 12) the listed instructions are data operand independent only while the
// operating system sets IA32_UARCH_MISC_CTL.DOITM, which a program cannot
// read; a processor that does not enumerate IA32_UARCH_MISC_CTL runs them as
// if DOITM were set. A processor without IA32_ARCH_CAPABILITIES
// (CPUID.(EAX=7,ECX=0):EDX bit 29 clear) enumerates neither, so it is
// confirmed; one with it is unconfirmed. AMD and every other vendor publish
// no such statement, so they are unconfirmed, and so is WebAssembly, where
// CPUID reads 0 (JetWeb Leaf.jet).
//
// The answer is fixed for the process, so the first probe is kept; a racing
// probe stores the same word.
TIMING_HOST_CONFIRMED: I64{1}
TIMING_HOST_INTEL_DOITM: I64{2}
TIMING_HOST_NO_STATEMENT: I64{3}

timing_host_word := I64{0}

timing_host: fn() -> I64 {
    if (timing_host_word == I64{0}) {
        #Unsafe("the probe answer is fixed for the process; a racing probe stores the same word") {
            timing_host_word = timing_host_probe()
        }
    }
    timing_host_word
}

// "GenuineIntel" is CPUID.0's EBX, EDX, ECX: "Genu", "ineI", "ntel".
timing_host_probe: fn() -> I64 {
    #Unsafe("cpuid only reports processor identification") {
        top: os_cpuid_eax_i64(I64{0}, I64{0})
        intel: os_cpuid_ebx_i64(I64{0}, I64{0}) == I64{1970169159} && os_cpuid_edx_i64(I64{0}, I64{0}) == I64{1231384169} && os_cpuid_ecx_i64(I64{0}, I64{0}) == I64{1818588270}
        if (!intel) -> return TIMING_HOST_NO_STATEMENT
        if (top >= I64{7} && os_cpuid_edx_i64(I64{7}, I64{0}).bit_and(I64{536870912}) != I64{0}) -> return TIMING_HOST_INTEL_DOITM
    }
    TIMING_HOST_CONFIRMED
}

// core.sys.__timing_host: 1 on a confirmed host, 0 otherwise.
#Export(c) jet_sys_timing_host: fn() -> I64 {
    confirmed: if (timing_host() == TIMING_HOST_CONFIRMED) -> I64{1} else -> I64{0}
    jet_int_owned_from_i64(confirmed)
}

// The entry of a program whose package sets `policy.harden` and that holds
// `timing: .Fixed` values (JetIR Build.jet ir_timing_admitted) calls this
// first: on an unconfirmed host the program ends with an error naming why,
// before any of its code runs.
#Export(c) jet_rt_timing_admit: fn() {
    host: timing_host()
    if (host == TIMING_HOST_CONFIRMED) -> return
    reason: if (host == TIMING_HOST_INTEL_DOITM) -> rt_static_text("this Intel processor enumerates IA32_ARCH_CAPABILITIES, so its fixed timing holds only while the operating system sets DOITM, which a program cannot read") else -> rt_static_text("this processor's vendor publishes no data operand independent timing statement")
    message: jet_rt_string_builder_new()
    jet_rt_string_builder_push(message, rt_static_text("policy.harden: this program holds `timing: .Fixed` values and refuses to start on a host that is not confirmed to run them in fixed time: "))
    jet_rt_string_builder_push(message, reason)
    jet_rt_entry_error_exit(jet_rt_string_builder_finish(message))
}
