#Export(c) jet_rt_handle_drop_jet_dispatch_state: fn(value: I64) { encoding_enum_drop(value) }
#Export(c) jet_rt_handle_eq_jet_dispatch_state: fn(left: I64, right: I64) -> Bool { encoding_enum_eq(left, right) }
