#Export(c) jet_rt_handle_clone_jet_hook_policy: fn(value: I64) -> I64 { encoding_enum_clone(value) }
#Export(c) jet_rt_handle_drop_jet_hook_policy: fn(value: I64) { encoding_enum_drop(value) }
#Export(c) jet_rt_handle_clone_jet_event_policy: fn(value: I64) -> I64 { encoding_enum_clone(value) }
