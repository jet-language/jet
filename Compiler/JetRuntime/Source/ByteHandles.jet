// CAbiRoutes.rs:945-955,2747-2757,5631-5645,6051-6065.
// Byte lists use the composed U8 stride; a cursor is an unsigned raw word.
#Export(c) fn jet_rt_handle_clone_jet_byte_buffer(buffer: I64) -> I64 {
    result :: jet_rt_alloc(BYTE_BUFFER_BYTES, I64{8})
    data_tree_store(result + BYTE_BUFFER_SEQUENCE, data_sequence_clone(data_tree_word(buffer + BYTE_BUFFER_SEQUENCE), DATA_TREE_BYTE_LIST))
    data_tree_store(result + BYTE_BUFFER_POSITION, data_tree_word(buffer + BYTE_BUFFER_POSITION))
    result
}
#Export(c) fn jet_rt_handle_drop_jet_byte_buffer(buffer: I64) {
    if (buffer == I64{0}) -> return
    data_sequence_drop(data_tree_word(buffer + BYTE_BUFFER_SEQUENCE), DATA_TREE_BYTE_LIST)
    jet_rt_free(buffer, BYTE_BUFFER_BYTES, I64{8})
}
fn byte_buffer_render(buffer: I64) -> I64 {
    sequence :: data_tree_word(buffer + BYTE_BUFFER_SEQUENCE)
    length :: data_tree_word(sequence + DATA_SEQUENCE_LENGTH)
    data :: data_tree_word(sequence + DATA_SEQUENCE_DATA)
    result :: jet_rt_string_builder_new()
    rt_text_push_word(result, I64{91}, I64{1})
    at := I64{0}
    loop at < length {
        if (at != I64{0}) -> rt_text_push_word(result, I64{8236}, I64{2})
        byte :: host_u8_get(data, at)
        // Decimal U8 fits in one word: no temporary Text/Int or heap scratch.
        if (byte < I64{10}) {
            rt_text_push_word(result, I64{48} + byte, I64{1})
        } else if (byte < I64{100}) {
            rt_text_push_word(result, (I64{48} + byte / I64{10}).bit_or(((I64{48} + byte % I64{10}) << I64{8})), I64{2})
        } else {
            rt_text_push_word(result, (I64{48} + byte / I64{100}).bit_or(((I64{48} + byte / I64{10} % I64{10}) << I64{8})).bit_or(((I64{48} + byte % I64{10}) << I64{16})), I64{3})
        }
        at += I64{1}
    }
    rt_text_push_word(result, I64{93}, I64{1})
    jet_rt_string_builder_finish(result)
}
#Export(c) fn jet_rt_handle_show_jet_byte_buffer(buffer: I64) -> I64 { byte_buffer_render(buffer) }
#Export(c) fn jet_rt_handle_display_jet_byte_buffer(buffer: I64) -> I64 { byte_buffer_render(buffer) }
#Export(c) fn jet_rt_handle_debug_jet_byte_buffer(buffer: I64) -> I64 { byte_buffer_render(buffer) }
#Export(c) fn jet_rt_handle_clone_jet_path(path: I64) -> I64 {
    result :: jet_rt_alloc(PATH_HANDLE_BYTES, I64{8})
    data_tree_store(result + PATH_HANDLE_SEQUENCE, data_sequence_clone(data_tree_word(path + PATH_HANDLE_SEQUENCE), DATA_TREE_BYTE_LIST))
    result
}
#Export(c) fn jet_rt_handle_drop_jet_path(path: I64) {
    if (path == I64{0}) -> return
    data_sequence_drop(data_tree_word(path + PATH_HANDLE_SEQUENCE), DATA_TREE_BYTE_LIST)
    jet_rt_free(path, PATH_HANDLE_BYTES, I64{8})
}
fn path_handle_render(path: I64) -> I64 {
    sequence :: data_tree_word(path + PATH_HANDLE_SEQUENCE)
    length :: data_tree_word(sequence + DATA_SEQUENCE_LENGTH)
    data :: data_tree_word(sequence + DATA_SEQUENCE_DATA)
    // Canonical packed lists need no staging allocation or copy. The legacy
    // word-stride composition packs once before the shared UTF8-lossy decoder.
    if (RT_HOST_U8_STRIDE == I64{1}) -> return rt_text_lossy(data, length)
    packed :: if (length == I64{0}) -> I64{1} else -> jet_rt_alloc(length, I64{1})
    at := I64{0}
    loop at < length {
        rt_text_put(packed + at, host_u8_get(data, at))
        at += I64{1}
    }
    result :: rt_text_lossy(packed, length)
    if (length != I64{0}) -> jet_rt_free(packed, length, I64{1})
    result
}
#Export(c) fn jet_rt_handle_show_jet_path(path: I64) -> I64 { path_handle_render(path) }
#Export(c) fn jet_rt_handle_display_jet_path(path: I64) -> I64 { path_handle_render(path) }
#Export(c) fn jet_rt_handle_debug_jet_path(path: I64) -> I64 { path_handle_render(path) }
