// Sole Memory unit variant, derive(Clone). Cookie storage belongs to Client
// policy state, not this configuration enum.
#Export(c) jet_rt_handle_clone_jet_http_cookie_jar: fn(value: I64) -> I64 { encoding_enum_clone(value) }
#Export(c) jet_rt_handle_drop_jet_http_cookie_jar: fn(value: I64) { encoding_enum_drop(value) }
