// `#Memo` result stores (JetIR BuildMemo.jet). A memoized function's store
// is its zeroed 48-byte static cell: [mutex, count, capacity, entries, hits,
// misses]. The entries array holds entry pointers, most recently used first;
// an entry is a block the builder lays out and owns the contents of (the
// arguments, then the result). These calls only order and count the
// pointers; the builder compares keys, clones results and drops what an
// eviction hands back. Every call but lock/unlock and stats (which takes the
// lock itself) runs with the cell's mutex held.
memo_word: fn(address: I64) -> I64 {
    #Unsafe("address borrows an aligned word of a live memo cell or its entry array") { return os_load_i64(address) }
}
memo_put: fn(address: I64, value: I64) {
    #Unsafe("address is an aligned word of a memo cell or entry array the caller's lock owns") { os_store_i64(address, value) }
}

#Export(c) jet_rt_memo_lock: fn(cell: I64) { sync_mutex_lock(cell) }

#Export(c) jet_rt_memo_unlock: fn(cell: I64) { sync_mutex_unlock(cell) }

#Export(c) jet_rt_memo_len: fn(cell: I64) -> I64 { memo_word(wrapping(cell + I64{8})) }

#Export(c) jet_rt_memo_entry: fn(cell: I64, index: I64) -> I64 { memo_word(wrapping(memo_word(wrapping(cell + I64{24})) + index * I64{8})) }

// Entry `index` was hit: it is counted and moves to the front.
#Export(c) jet_rt_memo_hit: fn(cell: I64, index: I64) {
    memo_put(wrapping(cell + I64{32}), memo_word(wrapping(cell + I64{32})) + I64{1})
    if (index <= I64{0}) -> return
    entries: memo_word(wrapping(cell + I64{24}))
    entry: memo_word(wrapping(entries + index * I64{8}))
    jet_rt_mem_move(wrapping(entries + I64{8}), entries, index * I64{8})
    memo_put(entries, entry)
}

// No entry matched: the lookup is counted as a miss.
#Export(c) jet_rt_memo_miss: fn(cell: I64) { memo_put(wrapping(cell + I64{40}), memo_word(wrapping(cell + I64{40})) + I64{1}) }

// `name.cache()`: the store's `MemoStats` record (MemoStats.jet), read under
// its lock: hits, misses, the entries held, and `bound`, the written bound
// (a borrowed String the record keeps a copy of).
#Export(c) jet_rt_memo_stats: fn(cell: I64, bound: I64) -> I64 {
    sync_mutex_lock(cell)
    hits: memo_word(wrapping(cell + I64{32}))
    misses: memo_word(wrapping(cell + I64{40}))
    size: memo_word(wrapping(cell + I64{8}))
    sync_mutex_unlock(cell)
    value: jet_rt_alloc(MEMO_STATS_BYTES, I64{8})
    dyn_store(wrapping(value + MEMO_STATS_HITS), hits)
    dyn_store(wrapping(value + MEMO_STATS_MISSES), misses)
    dyn_store(wrapping(value + MEMO_STATS_SIZE), size)
    dyn_store(wrapping(value + MEMO_STATS_BOUND), jet_rt_string_clone(bound))
    value
}

// Files `entry` first. Returns the entry the bound evicts (the least recently
// used, or `entry` itself under a bound of 0) for the caller to drop, else 0.
// `bound` < 0 is unbounded.
#Export(c) jet_rt_memo_file: fn(cell: I64, entry: I64, bound: I64) -> I64 {
    if (bound == I64{0}) -> return entry
    count: memo_word(wrapping(cell + I64{8}))
    capacity: memo_word(wrapping(cell + I64{16}))
    entries := memo_word(wrapping(cell + I64{24}))
    if (count == capacity) {
        grown: if (capacity == I64{0}) -> I64{8} else -> capacity * I64{2}
        fresh: jet_rt_alloc(grown * I64{8}, I64{8})
        if (count > I64{0}) {
            jet_rt_mem_move(fresh, entries, count * I64{8})
            jet_rt_free(entries, capacity * I64{8}, I64{8})
        }
        memo_put(wrapping(cell + I64{16}), grown)
        memo_put(wrapping(cell + I64{24}), fresh)
        entries = fresh
    }
    jet_rt_mem_move(wrapping(entries + I64{8}), entries, count * I64{8})
    memo_put(entries, entry)
    if (bound > I64{0} && count + I64{1} > bound) {
        memo_put(wrapping(cell + I64{8}), count)
        return memo_word(wrapping(entries + count * I64{8}))
    }
    memo_put(wrapping(cell + I64{8}), count + I64{1})
    I64{0}
}
