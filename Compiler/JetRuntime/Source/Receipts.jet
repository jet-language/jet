// DbPool.rs:1-70 / Services.rs:1198-1232. ReceiptABI is native-private.
// CAbiRoutes:10198-10277 / 10351-10412: every numeric field is Rust i64;
// native() borrows exact Int, Text constructors clone, getters own fresh results.
// Existing aligned-word/enum/Text helpers are shared, never a Rust carrier alias.
fn receipt_bool(word: I64) -> Bool { (word.bit_and(I64{255})) != I64{0} }
fn receipt_bool_word(word: I64) -> I64 { if receipt_bool(word) -> I64{1} else -> I64{0} }
fn receipt_push_bool(target: I64, word: I64) {
    if receipt_bool(word) -> rt_text_push_word(target, I64{1702195828}, I64{4})
    else -> rt_text_push_word(target, I64{435728179558}, I64{5})
}
fn receipt_append_text(target: I64, text: I64) {
    rt_text_append(target, rt_text_data(text), rt_text_len(text))
}
#Export(c) fn jet_rt_handle_clone_jet_db_pool_lifecycle(value: I64) -> I64 { encoding_enum_clone(value) }
#Export(c) fn jet_rt_handle_drop_jet_db_pool_lifecycle(value: I64) { encoding_enum_drop(value) }
#Export(c) fn jet_rt_handle_eq_jet_db_pool_lifecycle(left: I64, right: I64) -> Bool { encoding_enum_eq(left, right) }
#Export(c) fn jet_rt_record_new_jet_db_pool_receipt(lifecycle: I64, max: I64, available: I64, leased: I64, opening: I64, ready: U8, acquires: I64, releases: I64, timeouts: I64, open_failures: I64, unhealthy: I64, replacements: I64, replacement_failures: I64) -> I64 {
    if (lifecycle < I64{0} || lifecycle > I64{2}) -> trap_native_index_range_stop()
    result :: jet_rt_alloc(DB_RECEIPT_BYTES, I64{8})
    encoding_store(result + DB_RECEIPT_LIFECYCLE, lifecycle)
    encoding_store(result + DB_RECEIPT_MAX, jet_int_owned_to_i64(max))
    encoding_store(result + DB_RECEIPT_AVAILABLE, jet_int_owned_to_i64(available))
    encoding_store(result + DB_RECEIPT_LEASED, jet_int_owned_to_i64(leased))
    encoding_store(result + DB_RECEIPT_OPENING, jet_int_owned_to_i64(opening))
    encoding_store(result + DB_RECEIPT_READY, if (ready != U8{0}) -> I64{1} else -> I64{0})
    encoding_store(result + DB_RECEIPT_ACQUIRES, jet_int_owned_to_i64(acquires))
    encoding_store(result + DB_RECEIPT_RELEASES, jet_int_owned_to_i64(releases))
    encoding_store(result + DB_RECEIPT_TIMEOUTS, jet_int_owned_to_i64(timeouts))
    encoding_store(result + DB_RECEIPT_OPEN_FAILURES, jet_int_owned_to_i64(open_failures))
    encoding_store(result + DB_RECEIPT_UNHEALTHY, jet_int_owned_to_i64(unhealthy))
    encoding_store(result + DB_RECEIPT_REPLACEMENTS, jet_int_owned_to_i64(replacements))
    encoding_store(result + DB_RECEIPT_REPLACEMENT_FAILURES, jet_int_owned_to_i64(replacement_failures))
    result
}
#Export(c) fn jet_rt_handle_clone_jet_db_pool_receipt(value: I64) -> I64 {
    result :: jet_rt_alloc(DB_RECEIPT_BYTES, I64{8})
    offset := I64{0}
    loop offset < DB_RECEIPT_BYTES {
        word :: encoding_word(value + offset)
        encoding_store(result + offset, if offset == DB_RECEIPT_READY -> receipt_bool_word(word) else -> word)
        offset += I64{8}
    }
    result
}
#Export(c) fn jet_rt_handle_drop_jet_db_pool_receipt(value: I64) {
    if (value != I64{0}) -> jet_rt_free(value, DB_RECEIPT_BYTES, I64{8})
}
#Export(c) fn jet_rt_handle_eq_jet_db_pool_receipt(left: I64, right: I64) -> Bool {
    offset := I64{0}
    loop offset < DB_RECEIPT_BYTES {
        a :: encoding_word(left + offset)
        b :: encoding_word(right + offset)
        if offset == DB_RECEIPT_READY {
            if receipt_bool(a) != receipt_bool(b) -> return false
        } else {
            if a != b -> return false
        }
        offset += I64{8}
    }
    true
}
#Export(c) fn jet_rt_record_get_jet_db_pool_receipt_lifecycle(value: I64) -> I64 { encoding_word(value + DB_RECEIPT_LIFECYCLE) }
#Export(c) fn jet_rt_record_get_jet_db_pool_receipt_max(value: I64) -> I64 { jet_int_owned_from_i64(encoding_word(value + DB_RECEIPT_MAX)) }
#Export(c) fn jet_rt_record_get_jet_db_pool_receipt_available(value: I64) -> I64 { jet_int_owned_from_i64(encoding_word(value + DB_RECEIPT_AVAILABLE)) }
