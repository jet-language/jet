// CommonTypes.rs:162-165; Top/Process.rs:3325-3343:
// Rc<RefCell<Option<BufReader<ProcessReader>>>>, NOT a reference to Child.
// Pipe40 is canonical native storage: non-atomic Rc refs0, RefCell borrow8,
// owned FD72 pointer16 (0 = None), source24 stream32. FD72 owns the one
// shared refill buffer and cursor (HostFiles.jet:1-3). A child's own cell
// (ProcessReader::Shared) has no FD72: source is its ExecutionChild160 and
// stream 1/2 names the capture it reads; stream 0 is the taken reader. No
// Rust Rc/RefCell/Box offset is projected.
PIPE_BYTES :: I64{40}
PIPE_REFS :: I64{0}
PIPE_BORROW :: I64{8}
PIPE_FD :: I64{16}
PIPE_SOURCE :: I64{24}
PIPE_STREAM :: I64{32}

fn pipe_borrow_stop() {
    // Seed rustc 1.97.1 (8bab26f4f); library/core/src/cell.rs:902,912-917:
    // panic_already_borrowed(BorrowMutError) => "RefCell already borrowed".
    // Emit the actual payload without allocating on the failing borrow path.
    jet_rt_stdout_flush()
    trap_header(I64{0})
    trap_write_word(I64{2336361488876725586}, I64{8})
    trap_write_word(I64{2340011850872286305}, I64{8})
    trap_write_word(I64{7234319696985747298}, I64{8})
    trap_msg_prelude_end()
    trap_footer(I64{0})
}
fn pipe_borrow_mut(pipe: I64) -> I64 {
    if (fd_word(pipe, PIPE_BORROW) != I64{0}) { pipe_borrow_stop() }
    fd_put(pipe, PIPE_BORROW, I64{-1})
    fd_word(pipe, PIPE_FD)
}
fn pipe_unborrow(pipe: I64) { fd_put(pipe, PIPE_BORROW, I64{0}) }

// TAKES an independently owned reader FD72, obtained from
// jet_process_take_stream_raw. Taking 0 constructs the shared None cell.
#Export(c) fn jet_process_pipe_take_raw(fd: I64) -> I64 {
    pipe :: jet_rt_alloc(PIPE_BYTES, I64{8})
    fd_put(pipe, PIPE_REFS, I64{1})
    fd_put(pipe, PIPE_BORROW, I64{0})
    fd_put(pipe, PIPE_FD, fd)
    fd_put(pipe, PIPE_SOURCE, I64{0})
    fd_put(pipe, PIPE_STREAM, I64{0})
    pipe
}
// The cell `child` owns for its stream `stream`, holding no reference to it:
// while a clone of the cell lives elsewhere, that clone keeps the child.
fn pipe_shared(child: I64, stream: I64) -> I64 {
    pipe :: jet_process_pipe_take_raw(I64{0})
    fd_put(pipe, PIPE_SOURCE, child)
    fd_put(pipe, PIPE_STREAM, stream)
    pipe
}
// Rust's Option::take on the child's reader: every clone now reads EOF.
fn pipe_detach(pipe: I64) {
    if (pipe != I64{0}) -> fd_put(pipe, PIPE_STREAM, I64{0})
}
fn pipe_clone(pipe: I64) -> I64 {
    // Rc is !Send; do not turn the counter into Arc or allocate an outer box.
    refs :: wrapping(fd_word(pipe, PIPE_REFS) + I64{1})
    fd_put(pipe, PIPE_REFS, refs)
    source :: fd_word(pipe, PIPE_SOURCE)
    if (refs == I64{2} && source != I64{0}) -> _ := jet_rt_handle_clone_process_child(source)
    pipe
}
fn pipe_drop(pipe: I64) {
    if (pipe == I64{0}) {
        return
    }
    refs :: wrapping(fd_word(pipe, PIPE_REFS) - I64{1})
    fd_put(pipe, PIPE_REFS, refs)
    source :: fd_word(pipe, PIPE_SOURCE)
    if (refs == I64{1} && source != I64{0}) {
        // The last outside clone lets go of the child that owns this cell.
        jet_rt_handle_drop_process_child(source)
        return
    }
    if (refs != I64{0}) {
        return
    }
    jet_fd_drop_raw(fd_word(pipe, PIPE_FD))
    jet_rt_free(pipe, PIPE_BYTES, I64{8})
}
#Export(c) fn jet_rt_handle_clone_process_stdout_stream(pipe: I64) -> I64 { pipe_clone(pipe) }
#Export(c) fn jet_rt_handle_drop_process_stdout_stream(pipe: I64) { pipe_drop(pipe) }
#Export(c) fn jet_rt_handle_clone_process_stderr_stream(pipe: I64) -> I64 { pipe_clone(pipe) }
#Export(c) fn jet_rt_handle_drop_process_stderr_stream(pipe: I64) { pipe_drop(pipe) }

// Option::take drops the reader and is visible through every clone.
#Export(c) fn jet_process_pipe_close_raw(pipe: I64) {
    fd :: pipe_borrow_mut(pipe)
    fd_put(pipe, PIPE_FD, I64{0})
    fd_put(pipe, PIPE_STREAM, I64{0})
    jet_fd_drop_raw(fd)
    pipe_unborrow(pipe)
}
fn pipe_output_name() -> I64 {
    text :: jet_rt_string_builder_new()
    rt_text_push_word(text, I64{2338339510832558704}, I64{8})
    rt_text_push_word(text, I64{128047746676079}, I64{6})
    text
}

// The checked Core private primitives __stdout_line_bytes/__stderr_line_bytes
// share this C result ABI: 1 => owned compact U8 data+len, 0 => owned IOError.
// Empty success means EOF/None; UTF8, error policy and CRLF belong to Core's
// __stdout_next_line/__stderr_next_line, never to this buffered byte leaf.
#Export(c) fn jet_process_stream_line_bytes_raw(pipe: I64, data_out: I64, len_out: I64, error_out: I64) -> I64 {
    fd :: pipe_borrow_mut(pipe)
    fd_put(data_out, I64{0}, I64{0})
    fd_put(len_out, I64{0}, I64{0})
    fd_put(error_out, I64{0}, I64{0})
    stream :: fd_word(pipe, PIPE_STREAM)
    if (stream != I64{0}) {
        process_execution_stream_bytes(fd_word(pipe, PIPE_SOURCE), stream, I64{9223372036854775807}, true, data_out, len_out)
        pipe_unborrow(pipe)
        return I64{1}
    }
    if (fd == I64{0}) {
        pipe_unborrow(pipe)
        return I64{1}
    }
    fd_lock(fd)
    line := I64{0}
    failure := I64{0}
    done := false
    loop !done {
        if (fd_word(fd, I64{16}) != I64{0}) {
            failure = I64{-9}
            break
        }
        if (fd_word(fd, I64{40}) < I64{0}) {
            // TAKE hands this state to a BufReader. Convert only after its
            // private pending output reaches the kernel; failures retain the
            // writer mode/suffix for the next attempt.
            // TAKE has no error ABI; first read is its fallible conversion edge.
            failure = fd_flush_locked(fd)
            if (failure != I64{0}) { break }
            fd_put(fd, I64{48}, I64{0})
            fd_put(fd, I64{56}, I64{0})
        }
        buffer :: fd_buffer(fd)
        fd_put(fd, I64{40}, I64{8192})
        pos := fd_word(fd, I64{56})
        filled := fd_word(fd, I64{48})
        if (pos == filled) {
            count :: host_call(I64{0}, fd_word(fd, I64{8}), buffer, I64{8192})
            // BufRead::read_until retries Interrupted; there is no policy retry.
            if (count == I64{-4}) { next }
            if (count < I64{0}) {
                failure = count
                break
            }
            if (count == I64{0}) { break }
            filled = count
            pos = I64{0}
            fd_put(fd, I64{48}, filled)
            fd_put(fd, I64{56}, I64{0})
        }
        end := pos
        loop end < filled {
            byte := I64{0}
            #Unsafe("the FD72 lock protects this initialized refill-buffer byte") {
                byte = os_load_u8(wrapping(buffer + end))
            }
            end = wrapping(end + I64{1})
            if (byte == I64{10}) {
                done = true
                break
            }
        }
        if (line == I64{0}) { line = jet_rt_string_builder_new() }
        // Private Text24 builder storage is only a byte buffer here: append
        // copies bytes without decoding, so malformed UTF8 survives to Core.
        rt_text_append(line, wrapping(buffer + pos), wrapping(end - pos))
        fd_put(fd, I64{56}, end)
    }
    fd_unlock(fd)
    pipe_unborrow(pipe)
    if (failure != I64{0}) {
        jet_rt_string_drop(line)
        cause :: if (failure == HOST_WRITE_ZERO) -> host_write_zero_text() else -> host_errno_cause(wrapping(I64{0} - failure))
        return host_io_other_take(HOST_IO_OP_READ, pipe_output_name(), cause, error_out)
    }
    if (line != I64{0}) {
        length :: rt_text_len(line)
        capacity :: rt_text_word(wrapping(line + I64{16}))
        bytes := rt_text_data(line)
        // G1 compact U8 ownership frees length bytes, not builder capacity.
        if (capacity != length) {
            bytes = jet_rt_alloc(length, I64{1})
            rt_text_bytes_copy(bytes, rt_text_data(line), length)
            jet_rt_string_drop(line)
        } else {
            // Transfer the data of this fresh builder, freeing only its header.
            bytes = rt_text_take_unique_buffer(line)
        }
        fd_put(data_out, I64{0}, bytes)
        fd_put(len_out, I64{0}, length)
    }
    I64{1}
}

// ProcessStdoutStream.read(max) / ProcessStderrStream.read(max): Read::read
// on the child's pipe through the same FD72 refill buffer `lines` uses, so
// the two interleave: bytes a line read buffered ahead are returned first.
// A child's own cell reads its capture the same way, through one consumed
// offset. Up to `maximum` bytes (capped at 16 MiB); empty at EOF or after the
// stream was taken. 1 => owned compact U8 data+len, 0 => owned IOError.
fn pipe_read(pipe: I64, maximum: I64, output: I64, len: I64, error: I64) -> I64 {
    fd_put(output, I64{0}, I64{0})
    fd_put(len, I64{0}, I64{0})
    limit := I64{16777216}
    if (jet_int_compare(maximum, limit) < I64{0}) {
        if (jet_int_compare(maximum, I64{0}) <= I64{0}) {
            count :: if int_fits(maximum, U64{9223372036854775808}) -> jet_int_owned_to_i64(maximum) else -> I64{-9223372036854775808}
            cause :: jet_rt_string_builder_new()
            jet_rt_string_builder_push(cause, rt_static_text("read needs a positive byte count, got "))
            rt_text_push_number(cause, count)
            return compiler_fs_error(HOST_IO_KIND_INVALID_INPUT, HOST_IO_OP_READ, pipe_output_name(), I64{0}, jet_rt_string_builder_finish(cause), error)
        }
        limit = jet_int_owned_to_i64(maximum)
    }
    fd :: pipe_borrow_mut(pipe)
    stream :: fd_word(pipe, PIPE_STREAM)
    if (stream != I64{0}) {
        process_execution_stream_bytes(fd_word(pipe, PIPE_SOURCE), stream, limit, false, output, len)
        pipe_unborrow(pipe)
        return I64{1}
    }
    if (fd == I64{0}) {
        pipe_unborrow(pipe)
        return I64{1}
    }
    bytes :: jet_rt_alloc(limit, I64{8})
    count := I64{0}
    failure := I64{0}
    fd_lock(fd)
    if (fd_word(fd, I64{16}) != I64{0}) {
        failure = I64{-9}
    } else if (fd_word(fd, I64{40}) < I64{0}) {
        failure = fd_flush_locked(fd)
        if (failure == I64{0}) {
            fd_put(fd, I64{48}, I64{0})
            fd_put(fd, I64{56}, I64{0})
            fd_put(fd, I64{40}, I64{8192})
        }
    }
    if (failure == I64{0}) {
        pos :: if (fd_word(fd, I64{40}) > I64{0}) -> fd_word(fd, I64{56}) else -> I64{0}
        filled :: if (fd_word(fd, I64{40}) > I64{0}) -> fd_word(fd, I64{48}) else -> I64{0}
        if (pos < filled) {
            count = if (filled - pos < limit) -> filled - pos else -> limit
            rt_text_bytes_copy(bytes, wrapping(fd_buffer(fd) + pos), count)
            fd_put(fd, I64{56}, wrapping(pos + count))
        } else {
            loop {
                got :: host_call(I64{0}, fd_word(fd, I64{8}), bytes, limit)
                if (got == I64{-4}) { next }
                if (got < I64{0}) { failure = got } else { count = got }
                break
            }
        }
    }
    fd_unlock(fd)
    pipe_unborrow(pipe)
    if (failure != I64{0}) {
        jet_rt_free(bytes, limit, I64{8})
        cause :: if (failure == HOST_WRITE_ZERO) -> host_write_zero_text() else -> host_errno_cause(wrapping(I64{0} - failure))
        return host_io_other_take(HOST_IO_OP_READ, pipe_output_name(), cause, error)
    }
    compiler_fs_bytes_take(bytes, limit, count, output, len)
    I64{1}
}
#Export(c) fn jet_process_stdout_read(pipe: I64, maximum: I64, output: I64, len: I64, error: I64) -> I64 { pipe_read(pipe, maximum, output, len, error) }
#Export(c) fn jet_process_stderr_read(pipe: I64, maximum: I64, output: I64, len: I64, error: I64) -> I64 { pipe_read(pipe, maximum, output, len, error) }
