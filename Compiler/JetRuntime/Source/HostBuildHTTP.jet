// The checked-build DNS answer, ported from the deleted Rust bridge HTTP.rs (lines 5536-5712). The caller checks the
// answer it gets; no lookup policy lives here. The pinned GET over those
// answers is Jet source (core.http.client.jet_http_build_get).
// Results are native [[U8]]: an outer buffer of 24-byte [len,cap,data] headers,
// inner data at RT_HOST_U8_STRIDE, exact capacity, null when empty.

// Bytes24 is a native List<U8> header [len0, cap8, data16] being grown.
fn bh_bytes_reserve(bytes: I64, extra: I64) {
    length :: rt_text_word(bytes)
    capacity :: rt_text_word(bytes + I64{8})
    if (length + extra <= capacity) -> return
    grown := if (capacity < I64{16}) -> I64{16} else -> capacity * I64{2}
    if (grown < length + extra) -> grown = length + extra
    data :: jet_rt_alloc(grown * RT_HOST_U8_STRIDE, I64{8})
    old :: rt_text_word(bytes + I64{16})
    if (length != I64{0}) -> rt_text_bytes_copy(data, old, length * RT_HOST_U8_STRIDE)
    if (capacity != I64{0}) -> jet_rt_free(old, capacity * RT_HOST_U8_STRIDE, I64{8})
    rt_text_store(bytes + I64{8}, grown)
    rt_text_store(bytes + I64{16}, data)
}

// Appends count raw bytes.
fn bh_bytes_append(bytes: I64, source: I64, count: I64) {
    if (count <= I64{0}) -> return
    bh_bytes_reserve(bytes, count)
    length :: rt_text_word(bytes)
    data :: rt_text_word(bytes + I64{16})
    at := I64{0}
    loop at < count {
        host_u8_put(data, length + at, rt_text_byte(source + at))
        at += I64{1}
    }
    rt_text_store(bytes, length + count)
}

fn bh_bytes_drop(bytes: I64) {
    capacity :: rt_text_word(bytes + I64{8})
    if (capacity != I64{0}) -> jet_rt_free(rt_text_word(bytes + I64{16}), capacity * RT_HOST_U8_STRIDE, I64{8})
    thread_zero(bytes, I64{24})
}

// The owned native List<U8>: capacity exactly length, null data when empty.
fn bh_bytes_seal(bytes: I64) {
    length :: rt_text_word(bytes)
    capacity :: rt_text_word(bytes + I64{8})
    if (length == capacity) -> return
    if (length == I64{0}) {
        bh_bytes_drop(bytes)
        return
    }
    old :: rt_text_word(bytes + I64{16})
    data :: jet_rt_alloc(length * RT_HOST_U8_STRIDE, I64{8})
    rt_text_bytes_copy(data, old, length * RT_HOST_U8_STRIDE)
    jet_rt_free(old, capacity * RT_HOST_U8_STRIDE, I64{8})
    rt_text_store(bytes + I64{8}, length)
    rt_text_store(bytes + I64{16}, data)
}

// Rows24 is a growable [len, cap, data] buffer of Bytes24 headers.
fn bh_rows_push(rows: I64, bytes: I64) {
    length :: rt_text_word(rows)
    capacity :: rt_text_word(rows + I64{8})
    if (length == capacity) {
        grown :: if (capacity == I64{0}) -> I64{8} else -> capacity * I64{2}
        data :: jet_rt_alloc(grown * I64{24}, I64{8})
        old :: rt_text_word(rows + I64{16})
        if (length != I64{0}) -> rt_text_bytes_copy(data, old, length * I64{24})
        if (capacity != I64{0}) -> jet_rt_free(old, capacity * I64{24}, I64{8})
        rt_text_store(rows + I64{8}, grown)
        rt_text_store(rows + I64{16}, data)
    }
    bh_bytes_seal(bytes)
    coll_copy(bytes, rt_text_word(rows + I64{16}) + length * I64{24}, I64{24})
    thread_zero(bytes, I64{24})
    rt_text_store(rows, length + I64{1})
}

// Publishes the outer list through the route's ok/ok_len out slots.
fn bh_rows_publish(rows: I64, ok: I64, ok_len: I64) -> I64 {
    length :: rt_text_word(rows)
    capacity :: rt_text_word(rows + I64{8})
    data := rt_text_word(rows + I64{16})
    if (length == I64{0}) {
        if (capacity != I64{0}) -> jet_rt_free(data, capacity * I64{24}, I64{8})
        data = I64{0}
    } else if (length != capacity) {
        exact :: jet_rt_alloc(length * I64{24}, I64{8})
        rt_text_bytes_copy(exact, data, length * I64{24})
        jet_rt_free(data, capacity * I64{24}, I64{8})
        data = exact
    }
    thread_zero(rows, I64{24})
    rt_text_store(ok, data)
    rt_text_store(ok_len, length)
    I64{1}
}

fn bh_text_error(error: I64, text: I64) -> I64 {
    rt_text_store(error, text)
    I64{0}
}

fn bh_static_error(error: I64, literal: I64) -> I64 { bh_text_error(error, jet_rt_string_clone(literal)) }

// u16/u64/usize::try_from(i64) failures share TryFromIntError's Display.
fn bh_range_error(error: I64) -> I64 { bh_static_error(error, rt_static_text("out of range integral type conversion attempted")) }

// Rust `(host, port).to_socket_addrs()` after one [..] pair is removed.
// Answers stay in resolver order as 4 or 16 network-order octets.
#Export(c) fn jet_http_build_resolve(host: I64, port: I64, ok: I64, ok_len: I64, error: I64) -> I64 {
    native_port :: host_native_int(port)
    if (jet_scheduler_native_propagate() != I64{0}) -> return I64{0}
    if (native_port < I64{0} || native_port > I64{65535}) -> return bh_range_error(error)
    length :: rt_text_len(host)
    data :: rt_text_data(host)
    bracketed :: length >= I64{2} && rt_text_byte(data) == I64{91} && rt_text_byte(data + length - I64{1}) == I64{93}
    name :: if bracketed -> rt_text_copy(data + I64{1}, length - I64{2}) else -> host
    scratch :: jet_rt_alloc(I64{24}, I64{8})
    thread_zero(scratch, I64{24})
    resolved :: net_resolve_rows(name, native_port, scratch, scratch + I64{8}, scratch + I64{16})
    if bracketed -> jet_rt_string_drop(name)
    rows :: rt_text_word(scratch)
    count :: rt_text_word(scratch + I64{8})
    failure :: rt_text_word(scratch + I64{16})
    jet_rt_free(scratch, I64{24}, I64{8})
    if (resolved == I64{0}) {
        if (failure == I64{0}) -> return I64{0}
        message :: jet_rt_record_get_jet_resolve_error_message(failure)
        jet_rt_handle_drop_jet_resolve_error(failure)
        return bh_text_error(error, message)
    }
    output :: jet_rt_alloc(I64{48}, I64{8})
    thread_zero(output, I64{48})
    bytes :: output + I64{24}
    at := I64{0}
    loop at < count {
        row :: rows + at * I64{56}
        bh_bytes_append(bytes, row + I64{8}, if (rt_text_word(row) == I64{4}) -> I64{4} else -> I64{16})
        bh_rows_push(output, bytes)
        at += I64{1}
    }
    if (rows != I64{0}) -> jet_rt_free(rows, count * I64{56}, I64{8})
    result :: bh_rows_publish(output, ok, ok_len)
    jet_rt_free(output, I64{48}, I64{8})
    result
}
