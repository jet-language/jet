// Private native TimeGlueABI carriers; source Core Instant is generator-owned.
// Reads borrow an initialized aligned word of a native time carrier; writes
// own a word of a fresh one. RawWords.jet performs the access.
time_glue_word: fn(address: I64) -> I64 { rt_text_word(address) }

time_glue_store: fn(address: I64, value: I64) { rt_text_store(address, value) }

time_glue_clone: fn(value: I64, bytes: I64) -> I64 {
    result: jet_rt_alloc(bytes, I64{8})
    coll_copy(value, result, bytes)
    result
}

time_glue_drop: fn(value: I64, bytes: I64) {
    if (value != I64{0}) { jet_rt_free(value, bytes, I64{8}) }
}

time_glue_equal: fn(left: I64, right: I64, bytes: I64) -> Bool {
    ^at: I64{0}
    loop at < bytes {
        if time_glue_word(wrapping(left + at)) != time_glue_word(wrapping(right + at)) {
            return false
        }
        at += I64{8}
    }
    true
}

time_glue_int: fn(value: I64, field: I64) -> I64 {
    jet_int_owned_from_i64(time_glue_word(wrapping(value + field)))
}

time_glue_pad: fn(target: I64, value: I64, width: I64) {
    // Use the existing decimal digit counter and emitter. Zero-padding
    // includes a sign in the minimum width and inserts zeros AFTER that sign.
    length: display_integer_length(value) + (if (value < I64{0}) -> I64{1} else -> I64{0})
    ^zeros: width - length
    if (zeros <= I64{0}) {
        rt_text_push_number(target, value)
        return
    }
    ^number: value
    if (value < I64{0}) {
        rt_text_push_word(target, I64{45}, I64{1})
        // A negative number needing padding here has <19 magnitude digits;
        // i64.MIN always takes the non-padding branch above.
        number = -value
    }
    loop zeros > (I64{0}) {
        rt_text_push_word(target, I64{48}, I64{1})
        zeros -= I64{1}
    }
    rt_text_push_number(target, number)
}

#Export(c) jet_rt_record_new_duration: fn(ns: I64) -> I64 {
    raw: jet_int_owned_to_i64(ns)
    if (jet_scheduler_native_propagate() != I64{0}) { return I64{0} }
    result: jet_rt_alloc(TIME_DURATION_BYTES, I64{8})
    time_glue_store(wrapping(result + TIME_DURATION_NS), raw)
    result
}

#Export(c) jet_rt_handle_clone_duration: fn(value: I64) -> I64 {
    time_glue_clone(value, TIME_DURATION_BYTES)
}

#Export(c) jet_rt_handle_drop_duration: fn(value: I64) {
    time_glue_drop(value, TIME_DURATION_BYTES)
}

#Export(c) jet_rt_handle_eq_duration: fn(left: I64, right: I64) -> Bool {
    time_glue_equal(left, right, TIME_DURATION_BYTES)
}

#Export(c) jet_rt_record_get_duration_ns: fn(value: I64) -> I64 {
    time_glue_int(value, TIME_DURATION_NS)
}

#Export(c) jet_rt_handle_show_duration: fn(value: I64) -> I64 {
    // Duration195-197: signed ns followed by the literal "ns".
    target: jet_rt_string_builder_new()
    rt_text_push_number(target, time_glue_word(wrapping(value + TIME_DURATION_NS)))
    rt_text_push_word(target, I64{29550}, I64{2})
    jet_rt_string_builder_finish(target)
}

#Export(c) jet_rt_handle_display_duration: fn(value: I64) -> I64 {
    jet_rt_handle_show_duration(value)
}

#Export(c) jet_rt_handle_debug_duration: fn(value: I64) -> I64 {
    jet_rt_handle_show_duration(value)
}
