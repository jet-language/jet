// Per-thread test state uses the scheduler's ONE dynamic TLS mechanism.
// State144: print0, printFrames8, expect32, completed56, unmet80, timeouts88,
// wholeSkip112, failureMessage120/failureDetail128, assertionStop136. Lists
// are native word headers; capture frames are [kind=1, previous owned E4 builder].
// Begin/take nesting preserves the outer builder without copying its bytes.
// Thread detach invokes the registered destructor, including on cancellation.

// Created by the first state a thread needs (test_state_ensure), which also
// installs the capture as the host print's hook (Host.jet
// host_print_capture_code): a program that never runs a test links no
// capture.
test_stack_key := I64{0}

// RuntimeLower resolves these checked function-address entries, never the bodies.
rt_test_capture_abort_address: fn() -> I64 {
    loop { jet_rt_unreachable(I64{0}, I64{0}) }
}
rt_test_capture_print_address: fn() -> I64 {
    loop { jet_rt_unreachable(I64{0}, I64{0}) }
}

#Export(c) jet_rt_test_capture_init: fn() {
    if (test_stack_key != I64{0}) -> return
    sync_mutex_lock(thread_tls_registry)
    if (test_stack_key == I64{0}) {
        closure: jet_rt_alloc(I64{24}, I64{8})
        trap_store(closure, I64{1})
        trap_store(wrapping(closure + I64{8}), rt_test_capture_abort_address())
        trap_store(wrapping(closure + I64{16}), I64{0})
        host_print_capture_install(rt_test_capture_print_address())
        #Unsafe("written under the TLS registry mutex") {
            test_scope_stop_code = rt_test_scope_record_stop_address()
            test_stack_key = thread_tls_key_new_locked(closure, I64{0})
        }
    }
    sync_mutex_unlock(thread_tls_registry)
}

test_capture_state: fn() -> I64 {
    if (test_stack_key == I64{0}) { return I64{0} }
    jet_rt_tls_get(test_stack_key)
}

test_state_ensure: fn() -> I64 {
    jet_rt_test_capture_init()
    state := test_capture_state()
    if (state == I64{0}) {
        state = jet_rt_alloc(I64{144}, I64{8})
        thread_zero(state, I64{144})
        jet_rt_tls_set(test_stack_key, state)
    }
    state
}

#Export(c) jet_rt_test_capture_begin: fn() {
    state: test_state_ensure()
    stack: wrapping(state + I64{8})
    count: trap_word(stack)
    thread_words_grow(stack, count + I64{2})
    data: trap_word(wrapping(stack + I64{16}))
    trap_store(wrapping(data + count * I64{8}), I64{1})
    trap_store(wrapping(data + (count + I64{1}) * I64{8}), trap_word(state))
    trap_store(stack, count + I64{2})
    trap_store(state, test_text_new(I64{0}))
}

test_capture_state_drop: fn(state: I64) {
    stack: wrapping(state + I64{8})
    capacity: trap_word(wrapping(stack + I64{8}))
    if (capacity != I64{0}) {
        jet_rt_free(trap_word(wrapping(stack + I64{16})), capacity * I64{8}, I64{8})
    }
    test_scope_state_drop(state)
    jet_rt_free(state, I64{144}, I64{8})
}

// assertionStop136 tells the test harness whether the stop a test's root took
// is a failed `assert`/`assert_eq`, a caught test failure, or an uncaught
// runtime stop (panic, bounds, contract, sentry). Trap.jet trap_require_stop
// marks an assertion 1 as it renders. Every stop record then settles the mark
// (Scheduler.jet scheduler_stop_new): a rendered report under a pending mark
// makes it 2, any other stop clears it. So only the assertion's own record
// leaves 2. A thread with no test state has nothing to mark.
test_stop_assertion_mark: fn() {
    state: test_capture_state()
    if (state != I64{0}) -> trap_store(wrapping(state + I64{136}), I64{1})
}

test_stop_assertion_settle: fn(rendered: Bool) {
    state: test_capture_state()
    if (state == I64{0}) -> return
    cell: wrapping(state + I64{136})
    trap_store(cell, if (rendered && trap_word(cell) == I64{1}) -> I64{2} else -> I64{0})
}

// True when the last stop record was an assertion's report; clears the mark.
test_stop_assertion_take: fn() -> Bool {
    state: test_capture_state()
    if (state == I64{0}) -> return false
    cell: wrapping(state + I64{136})
    marked: trap_word(cell) == I64{2}
    trap_store(cell, I64{0})
    marked
}

#Export(c) jet_rt_test_capture_take: fn() -> I64 {
    state: test_capture_state()
    if (state == I64{0}) {
        jet_rt_unreachable(I64{0}, I64{0})
        return I64{0}
    }
    stack: wrapping(state + I64{8})
    count: trap_word(stack)
    data: trap_word(wrapping(stack + I64{16}))
    if (count < I64{2} || trap_word(wrapping(data + (count - I64{2}) * I64{8})) != I64{1}) {
        jet_rt_unreachable(I64{0}, I64{0})
        return I64{0}
    }
    result: trap_word(state)
    previous: trap_word(wrapping(data + (count - I64{1}) * I64{8}))
    trap_store(state, previous)
    trap_store(stack, count - I64{2})
    result
}

// The registry clears the TLS cell BEFORE calling this destructor, so it uses
// its supplied state rather than looking up a cell that is already empty.
#Export(c) jet_rt_test_capture_abort: fn(_closure: I64, state: I64) -> I64 {
    stack: wrapping(state + I64{8})
    count := trap_word(stack)
    data: trap_word(wrapping(stack + I64{16}))
    current := trap_word(state)
    loop count > (I64{0}) {
        if (count < I64{2} || trap_word(wrapping(data + (count - I64{2}) * I64{8})) != I64{1}) {
            jet_rt_unreachable(I64{0}, I64{0})
            return I64{0}
        }
        test_text_drop(current)
        current = trap_word(wrapping(data + (count - I64{1}) * I64{8}))
        count -= I64{2}
    }
    test_capture_state_drop(state)
    I64{0}
}

// Borrow text. Return false when this thread has no active test capture; the
// host print path then writes normally. Raw stdout.write never calls this hook.
#Export(c) jet_rt_test_capture_print: fn(text: I64) -> Bool {
    state: test_capture_state()
    if (state == I64{0}) { return false }
    if (trap_word(state) == I64{0}) { return false }
    builder: trap_word(state)
    old_data: trap_word(builder)
    old_len: trap_word(wrapping(builder + I64{8}))
    old_cap: trap_word(wrapping(builder + I64{16}))
    source := trap_word(text)
    length: trap_word(wrapping(text + I64{8}))
    needed: old_len + length + I64{1}
    destination := old_data
    if (needed > old_cap) {
        capacity := if (old_cap == I64{0}) -> I64{8} else -> old_cap * I64{2}
        if (capacity < needed) { capacity = needed }
        destination = jet_rt_alloc(capacity, I64{1})
        test_copy_bytes(destination, old_data, old_len)
        // A borrowed view may alias the builder. Rebase it before freeing the
        // old buffer; the append itself starts after all existing bytes.
        if (source >= old_data && source - old_data <= old_len && length <= old_len - (source - old_data)) {
            source = destination + (source - old_data)
        }
        trap_store(builder, destination)
        trap_store(wrapping(builder + I64{16}), capacity)
        if (old_cap != I64{0}) { jet_rt_free(old_data, old_cap, I64{1}) }
    }
    test_copy_bytes(wrapping(destination + old_len), source, length)
    trap_put(wrapping(wrapping(destination + old_len) + length), I64{10})
    trap_store(wrapping(builder + I64{8}), needed)
    true
}

// jet_rt_test_capture_print as the host print's hook calls it: 1 when the
// capture took the line.
#Export(c) jet_rt_test_capture_print_hook: fn(text: I64) -> I64 {
    if jet_rt_test_capture_print(text) -> I64{1} else -> I64{0}
}

// Native test Print syntax must always execute inside its unit's capture.
// The ordinary Rust tier retains the TEST_PRELUDE TLS print implementation.
// Outside a unit (the package `test: fn` setup) there is no capture frame: print to stdout.
#Export(c) jet_rt_test_print: fn(text: I64, flush: Bool) {
    if !jet_rt_test_capture_print(text) {
        _: host_stdio_text_failure(text, true, false, flush)
    }
}
