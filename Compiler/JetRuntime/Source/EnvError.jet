// Open.rs:72-77 unit enum; CommonTypes.rs:6631-6645,6678-6681 custom renders.
#Export(c) fn jet_rt_handle_clone_env_error(value: I64) -> I64 { encoding_enum_clone(value) }
#Export(c) fn jet_rt_handle_drop_env_error(value: I64) { encoding_enum_drop(value) }
#Export(c) fn jet_rt_handle_eq_env_error(left: I64, right: I64) -> Bool { encoding_enum_eq(left, right) }
#Export(c) fn jet_rt_handle_show_env_error(value: I64) -> I64 {
    kind :: encoding_word(wrapping(value + ENCODING_ENUM_TAG))
    result :: jet_rt_string_builder_new()
    if (kind == I64{0} || kind == I64{1}) {
        jet_rt_string_builder_push(result, rt_static_text("invalid environment vari"))
        if (kind == I64{0}) {
            rt_text_push_word(result, I64{7881701908294689377}, I64{8})
            rt_text_push_word(result, I64{101}, I64{1})
        } else {
            rt_text_push_word(result, I64{7809653110349783649}, I64{8})
            rt_text_push_word(result, I64{25973}, I64{2})
        }
    } else {
        jet_rt_string_builder_push(result, rt_static_text("environment contains a name or value that is not valid Unicode"))
    }
    result
}
#Export(c) fn jet_rt_handle_debug_env_error(value: I64) -> I64 { jet_rt_handle_show_env_error(value) }
#Export(c) fn jet_rt_handle_display_env_error(value: I64) -> I64 { jet_rt_handle_show_env_error(value) }
