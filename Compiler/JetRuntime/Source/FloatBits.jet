// Reference semantics of the runtime-object driver's two audited bitcasts.
// This file is ordinary checked Jet, not a language intrinsic or an asm gate.
// ONLY the runtime-object driver substitutes validated function IDs with a
// bit-preserving LIR Bitcast and excludes these reference bodies from reach.
// Other compilation paths execute Core's conversion, so the reference has
// no zero/default result, payload canonicalization or numeric approximation.
use core.math as float_bits_math

fn rt_f64_bits(value: Float) -> I64 Never! {
    bits := float_bits_math.to_bits(value)
    // Core returns the complete IEEE word as signed exact Int.
    // MathLibPure.rs:795-797 uses `value.to_bits() as i64`; CAbiRoutes.rs
    // wraps that result with jet_int_from_i64, including -0.0 -> i64::MIN.
    I64.from_int(bits) ?? panic("a complete IEEE word must fit signed I64")
}

fn rt_f64_from_bits(bits: I64) -> Float Never! { float_bits_math.from_bits(Int{bits}) }
