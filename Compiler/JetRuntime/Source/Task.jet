// Native Task state, one ref per handle/group plus a worker ref:
// refs0 control8 mutex16 done24 stopKind32 ownedMeta40 resultSlot48 initialized56
// env64 invoke72 release80 queueNext88 stack96 completionPark104
// completionLo112/Hi120 identity128 group136 permit144 taken152 inlineSlot160..183
// typedDeadline184 ownedWorld192, then the task's Context record (Context.jet)
// at TASK_CONTEXT. Result initializes only after Propagate == 0. stack is the
// stack size of the fiber the task runs on (Fiber.jet fiber_stack_class; 0,
// the default size): its group's, else the starting task's.
TASK_CONTEXT: I64{200}
task_state_bytes: fn() -> I64 { TASK_CONTEXT + CONTEXT_RECORD_BYTES }
// JetTaskFailure: ordinals 0/1/2.
task_failure_new: fn(kind: I64, owned_reason: I64) -> I64 {
    failure: jet_rt_alloc(TASK_FAILURE_BYTES, I64{8})
    sync_store(wrapping(failure + TASK_FAILURE_TAG), kind)
    sync_store(wrapping(failure + TASK_FAILURE_REASON), owned_reason)
    failure
}
#Export(c) jet_rt_record_tag_jet_task_failure: fn(failure: I64) -> I64 { sync_load(wrapping(failure + TASK_FAILURE_TAG)) }
#Export(c) jet_rt_record_get_jet_task_failure_panicked: fn(failure: I64) -> I64 {
    if sync_load(wrapping(failure + TASK_FAILURE_TAG)) != TASK_FAILURE_PANICKED {
        rt_record_variant_panic()
        if (jet_scheduler_native_propagate() != I64{0}) -> return I64{0}
    }
    jet_rt_string_clone(sync_load(wrapping(failure + TASK_FAILURE_REASON)))
}
#Export(c) jet_rt_record_new_jet_task_failure_cancelled: fn() -> I64 { task_failure_new(TASK_FAILURE_CANCELLED, I64{0}) }
#Export(c) jet_rt_record_new_jet_task_failure_deadline_blown: fn() -> I64 { task_failure_new(TASK_FAILURE_DEADLINE, I64{0}) }
#Export(c) jet_rt_record_new_jet_task_failure_panicked: fn(reason: I64) -> I64 { task_failure_new(TASK_FAILURE_PANICKED, jet_rt_string_clone(reason)) }
#Export(c) jet_rt_handle_clone_jet_task_failure: fn(failure: I64) -> I64 {
    kind: sync_load(wrapping(failure + TASK_FAILURE_TAG))
    reason: if kind == TASK_FAILURE_PANICKED -> jet_rt_string_clone(sync_load(wrapping(failure + TASK_FAILURE_REASON))) else -> I64{0}
    task_failure_new(kind, reason)
}
#Export(c) jet_rt_handle_drop_jet_task_failure: fn(failure: I64) {
    if (failure == I64{0}) -> return
    if sync_load(wrapping(failure + TASK_FAILURE_TAG)) == TASK_FAILURE_PANICKED -> jet_rt_string_drop(sync_load(wrapping(failure + TASK_FAILURE_REASON)))
    jet_rt_free(failure, TASK_FAILURE_BYTES, I64{8})
}
#Export(c) jet_rt_handle_eq_jet_task_failure: fn(left: I64, right: I64) -> Bool {
    kind: sync_load(wrapping(left + TASK_FAILURE_TAG))
    if kind != sync_load(wrapping(right + TASK_FAILURE_TAG)) -> return false
    if kind != TASK_FAILURE_PANICKED -> return true
    jet_rt_string_eq(sync_load(wrapping(left + TASK_FAILURE_REASON)), sync_load(wrapping(right + TASK_FAILURE_REASON)))
}
// Panicked is raw in show/display but Rust str Debug quoted in debug. Extend
// the existing carrier in place. Normalize service outcome ordinals to
// TaskFailure's terminal variants.
task_terminal_render: fn(result: I64, kind: I64, reason: I64, debug: Bool) {
    if kind == TASK_FAILURE_CANCELLED {
        rt_text_push_word(result, I64{7308335478031147331}, I64{8})
        rt_text_push_word(result, I64{100}, I64{1})
    } else if kind == TASK_FAILURE_DEADLINE {
        rt_text_push_word(result, I64{7308895159530382660}, I64{8})
        rt_text_push_word(result, I64{474450193474}, I64{5})
    } else {
        rt_text_push_word(result, I64{7234306451155345744}, I64{8})
        rt_text_push_word(result, I64{40}, I64{1})
        if debug { rt_text_push_rust_debug_str(result, reason) } else { jet_rt_string_builder_push(result, reason) }
        rt_text_push_word(result, I64{41}, I64{1})
    }
}
task_failure_render: fn(failure: I64, debug: Bool) -> I64 {
    kind: sync_load(wrapping(failure + TASK_FAILURE_TAG))
    reason: if kind == TASK_FAILURE_PANICKED -> sync_load(wrapping(failure + TASK_FAILURE_REASON)) else -> I64{0}
    result: jet_rt_string_builder_new()
    task_terminal_render(result, kind, reason, debug)
    result
}
#Export(c) jet_rt_handle_show_jet_task_failure: fn(failure: I64) -> I64 { task_failure_render(failure, false) }
#Export(c) jet_rt_handle_display_jet_task_failure: fn(failure: I64) -> I64 { task_failure_render(failure, false) }
#Export(c) jet_rt_handle_debug_jet_task_failure: fn(failure: I64) -> I64 { task_failure_render(failure, true) }

// Service TaskOutcome is a distinct registry-owned carrier, not TaskFailure.
// The Rust originals fix these four ordinals.
task_outcome_new: fn(kind: I64, owned_reason: I64) -> I64 {
    outcome: jet_rt_alloc(TASK_OUTCOME_BYTES, I64{8})
    sync_store(wrapping(outcome + TASK_OUTCOME_TAG), kind)
    sync_store(wrapping(outcome + TASK_OUTCOME_REASON), owned_reason)
    outcome
}
#Export(c) jet_rt_record_tag_jet_task_outcome: fn(outcome: I64) -> I64 { sync_load(wrapping(outcome + TASK_OUTCOME_TAG)) }
#Export(c) jet_rt_record_get_jet_task_outcome_panicked: fn(outcome: I64) -> I64 {
    if sync_load(wrapping(outcome + TASK_OUTCOME_TAG)) != TASK_OUTCOME_PANICKED {
        rt_record_variant_panic()
        return I64{0}
    }
    jet_rt_string_clone(sync_load(wrapping(outcome + TASK_OUTCOME_REASON)))
}
#Export(c) jet_rt_record_new_jet_task_outcome_finished: fn() -> I64 { task_outcome_new(TASK_OUTCOME_FINISHED, I64{0}) }
#Export(c) jet_rt_record_new_jet_task_outcome_panicked: fn(reason: I64) -> I64 { task_outcome_new(TASK_OUTCOME_PANICKED, jet_rt_string_clone(reason)) }
#Export(c) jet_rt_record_new_jet_task_outcome_cancelled: fn() -> I64 { task_outcome_new(TASK_OUTCOME_CANCELLED, I64{0}) }
#Export(c) jet_rt_record_new_jet_task_outcome_deadline_blown: fn() -> I64 { task_outcome_new(TASK_OUTCOME_DEADLINE, I64{0}) }
#Export(c) jet_rt_handle_clone_jet_task_outcome: fn(outcome: I64) -> I64 {
    kind: sync_load(wrapping(outcome + TASK_OUTCOME_TAG))
    reason: if kind == TASK_OUTCOME_PANICKED -> jet_rt_string_clone(sync_load(wrapping(outcome + TASK_OUTCOME_REASON))) else -> I64{0}
    task_outcome_new(kind, reason)
}
#Export(c) jet_rt_handle_drop_jet_task_outcome: fn(outcome: I64) {
    if (outcome == I64{0}) -> return
    if sync_load(wrapping(outcome + TASK_OUTCOME_TAG)) == TASK_OUTCOME_PANICKED -> jet_rt_string_drop(sync_load(wrapping(outcome + TASK_OUTCOME_REASON)))
    jet_rt_free(outcome, TASK_OUTCOME_BYTES, I64{8})
}
#Export(c) jet_rt_handle_eq_jet_task_outcome: fn(left: I64, right: I64) -> Bool {
    kind: sync_load(wrapping(left + TASK_OUTCOME_TAG))
    if kind != sync_load(wrapping(right + TASK_OUTCOME_TAG)) -> return false
    if kind != TASK_OUTCOME_PANICKED -> return true
    jet_rt_string_eq(sync_load(wrapping(left + TASK_OUTCOME_REASON)), sync_load(wrapping(right + TASK_OUTCOME_REASON)))
}
// Byte contract: Core/Service/Service.jet:91-125 at 497daa7a0 (read-only).
task_outcome_render: fn(outcome: I64, debug: Bool) -> I64 {
    kind: sync_load(wrapping(outcome + TASK_OUTCOME_TAG))
    result: jet_rt_string_builder_new()
    if kind == TASK_OUTCOME_FINISHED {
        rt_text_push_word(result, I64{7234303221339941190}, I64{8})
    } else {
        terminal: if kind == TASK_OUTCOME_CANCELLED -> TASK_FAILURE_CANCELLED else if kind == TASK_OUTCOME_DEADLINE -> TASK_FAILURE_DEADLINE else -> TASK_FAILURE_PANICKED
        reason: if kind == TASK_OUTCOME_PANICKED -> sync_load(wrapping(outcome + TASK_OUTCOME_REASON)) else -> I64{0}
        task_terminal_render(result, terminal, reason, debug)
    }
    result
}
#Export(c) jet_rt_handle_show_jet_task_outcome: fn(outcome: I64) -> I64 { task_outcome_render(outcome, false) }
#Export(c) jet_rt_handle_display_jet_task_outcome: fn(outcome: I64) -> I64 { task_outcome_render(outcome, false) }
#Export(c) jet_rt_handle_debug_jet_task_outcome: fn(outcome: I64) -> I64 { task_outcome_render(outcome, true) }

task_retain: fn(child: I64) { _ := sync_add(child, I64{1}) }
task_drop: fn(child: I64) {
    if (child == I64{0}) -> return
    if (sync_add(child, I64{-1}) != I64{1}) -> return
    meta: sync_load(wrapping(child + I64{40}))
    slot: sync_load(wrapping(child + I64{48}))
    if (sync_load(wrapping(child + I64{56})) != I64{0}) -> coll_slot_drop(slot, meta)
    if (slot != child + I64{160}) -> jet_rt_free(slot, coll_size(meta), I64{8})
    coll_meta_drop(meta)
    scheduler_control_drop(sync_load(wrapping(child + I64{8})))
    sync_park_drop(sync_load(wrapping(child + I64{104})))
    jet_rt_string_drop(sync_load(wrapping(child + I64{128})))
    jet_rt_world_drop(sync_load(wrapping(child + I64{192})))
    jet_rt_free(child, task_state_bytes(), I64{8})
}

task_spawn_state: fn(site: I64, label: I64, env: I64, invoke: I64, release: I64, meta: I64, group: I64, permit: I64) -> I64 {
    child: task_state_new(site, label, env, invoke, release, meta, group, permit)
    scheduler_submit(child)
    child
}

// A typed operation's task (an AsyncEvent dispatch) turns the deadline it
// inherits into its own result value, so its join never replaces that value
// with the caller's deadline stop (typedDeadline@184).
task_spawn_typed_deadline: fn(label: I64, env: I64, invoke: I64, release: I64, meta: I64) -> I64 {
    child: task_state_new(I64{0}, label, env, invoke, release, meta, I64{0}, I64{0})
    sync_store(wrapping(child + I64{184}), I64{1})
    scheduler_submit(child)
    child
}

// A task's state, registered but not yet submitted: a generator
// (Generator.jet) records its producer before the producer can run.
task_state_new: fn(site: I64, label: I64, env: I64, invoke: I64, release: I64, meta: I64, group: I64, permit: I64) -> I64 {
    if (site < I64{0}) -> jet_rt_unreachable(I64{0}, I64{0})
    child: jet_rt_alloc(task_state_bytes(), I64{8})
    thread_zero(child, task_state_bytes())
    sync_store(child, I64{2})
    control: scheduler_control_new()
    sync_store(wrapping(control + I64{104}), SCHEDULER_SCOPE_TASK)
    sync_store(wrapping(child + I64{8}), control)
    copied: coll_meta_copy(meta)
    sync_store(wrapping(child + I64{40}), copied)
    slot: if (coll_size(copied) <= I64{24}) -> child + I64{160} else -> coll_slot_new(copied)
    sync_store(wrapping(child + I64{48}), slot)
    sync_store(wrapping(child + I64{64}), env)
    sync_store(wrapping(child + I64{72}), invoke)
    sync_store(wrapping(child + I64{80}), release)
    context_inherit(wrapping(child + TASK_CONTEXT))
    sync_store(wrapping(child + I64{104}), sync_park_new())
    sync_store(wrapping(child + I64{96}), if (group != I64{0}) -> sync_load(wrapping(group + I64{72})) else -> fiber_stack_current())
    sync_store(wrapping(child + I64{136}), group)
    sync_store(wrapping(child + I64{144}), permit)
    id: jet_rt_observe_task_register(control, site, label)
    sync_store(wrapping(control + I64{56}), id)
    sync_store(wrapping(child + I64{128}), jet_rt_observe_task_identity(id))
    if (group != I64{0}) -> task_group_register(group, child)
    world: world_current()
    if (world != I64{0}) {
        sync_store(wrapping(child + I64{192}), jet_rt_world_clone(world))
        world_task_spawned(world)
    }
    child
}

#Export(c) jet_rt_native_task_spawn: fn(site: I64, label: I64, env: I64, invoke: I64, release: I64, meta: I64) -> I64 {
    task_spawn_state(site, label, env, invoke, release, meta, I64{0}, I64{0})
}
#Export(c) jet_rt_native_group_spawn: fn(group: I64, site: I64, label: I64, env: I64, invoke: I64, release: I64, meta: I64) -> I64 {
    state: sync_load(group)
    permit: task_group_admit(state)
    if (jet_scheduler_native_propagate() != I64{0}) {
        saved: jet_rt_session_cleanup_enter(jet_scheduler_native_status())
        jet_scheduler_shield_enter()
        if (permit != I64{0}) -> task_group_release(state)
        coll_call1_unit(release, env)
        jet_scheduler_shield_leave()
        jet_rt_session_cleanup_leave(saved)
        return I64{0}
    }
    task_spawn_state(site, label, env, invoke, release, meta, state, permit)
}
#Export(c) jet_rt_native_task_cancel: fn(child: I64) { scheduler_control_cancel(sync_load(wrapping(child + I64{8}))) }
#Export(c) jet_rt_native_task_pause: fn(child: I64) { scheduler_control_pause(sync_load(wrapping(child + I64{8})), I64{0}) }
#Export(c) jet_rt_native_task_pause_with_mode: fn(child: I64, mode: I64) { scheduler_control_pause(sync_load(wrapping(child + I64{8})), mode) }
#Export(c) jet_rt_native_task_resume: fn(child: I64) { scheduler_control_resume(sync_load(wrapping(child + I64{8}))) }
#Export(c) jet_rt_native_task_detach: fn(child: I64) { task_drop(child) }
#Export(c) jet_rt_native_task_drop: fn(child: I64) { task_drop(child) }

task_run: fn(child: I64) {
    control: sync_load(wrapping(child + I64{8}))
    base: thread_base()
    saved_control: sync_load(wrapping(base + I64{16}))
    saved_shield: sync_load(wrapping(base + I64{24}))
    saved_wait: sync_load(wrapping(base + I64{32}))
    saved_body: sync_load(wrapping(base + I64{64}))
    saved_context: context_enter(child + TASK_CONTEXT)
    saved_world: sync_load(wrapping(base + I64{104}))
    saved_world_flags: sync_load(wrapping(base + I64{112}))
    saved_world_slot: sync_load(wrapping(base + I64{120}))
    world: sync_load(wrapping(child + I64{192}))
    saved_provider: rt_time_monotonic_provider_get()
    if (world != I64{0}) {
        sync_store(wrapping(base + I64{104}), world)
        _ := rt_time_monotonic_provider_set(rt_world_monotonic_provider_address())
        sync_store(wrapping(base + I64{112}), I64{1})
        sync_store(wrapping(base + I64{120}), I64{0})
    }
    sync_store(wrapping(base + I64{16}), control)
    sync_store(wrapping(base + I64{24}), I64{0})
    sync_store(wrapping(base + I64{32}), saved_wait + I64{1})
    sync_store(wrapping(base + I64{64}), I64{0})
    jet_rt_observe_task_enter(sync_load(wrapping(control + I64{56})))
    _ := scheduler_wait_while_paused()
    aborted: sync_load(wrapping(control + I64{8})) != I64{0} && sync_load(wrapping(control + I64{16})) != I64{0}
    if aborted -> scheduler_deliver_cancel()
    frame: scheduler_task_completion_begin()
    body: scheduler_body_enter()
    if (!aborted && jet_scheduler_native_propagate() == I64{0}) {
        _ := coll_call2(sync_load(wrapping(child + I64{72})), sync_load(wrapping(child + I64{64})), sync_load(wrapping(child + I64{48})))
        if (jet_scheduler_native_propagate() == I64{0}) -> sync_store(wrapping(child + I64{56}), I64{1})
    }
    finished: jet_scheduler_native_status()
    // Mint cleanup provenance while the actual Task frame is still active.
    cleanup: jet_rt_session_cleanup_enter(finished)
    scheduler_body_leave(body)
    jet_scheduler_shield_enter()
    release_cleanup: jet_rt_session_cleanup_enter(jet_scheduler_native_status())
    coll_call1_unit(sync_load(wrapping(child + I64{80})), sync_load(wrapping(child + I64{64})))
    scheduler_shield_leave_finished()
    jet_rt_session_cleanup_leave(release_cleanup)
    scheduler_task_completion_end(frame)
    if (sync_load(wrapping(child + I64{144})) != I64{0}) -> task_group_release(sync_load(wrapping(child + I64{136})))
    // A cancellation the release shield's exit delivers once the body has
    // finished comes too late to stop it: the task keeps the body's outcome.
    late_cancel: finished == I64{0} && jet_scheduler_native_status() == I64{1}
    status: if late_cancel -> I64{0} else -> jet_scheduler_native_status()
    sync_store(wrapping(child + I64{32}), status)
    if (status != I64{0} && sync_load(wrapping(child + I64{56})) != I64{0}) {
        jet_scheduler_shield_enter()
        result_cleanup: jet_rt_session_cleanup_enter(jet_scheduler_native_status())
        coll_slot_drop(sync_load(wrapping(child + I64{48})), sync_load(wrapping(child + I64{40})))
        sync_store(wrapping(child + I64{56}), I64{0})
        scheduler_shield_leave_finished()
        jet_rt_session_cleanup_leave(result_cleanup)
        sync_store(wrapping(child + I64{32}), jet_scheduler_native_status())
    }
    jet_rt_session_cleanup_leave(cleanup)
    jet_rt_observe_task_finish(sync_load(wrapping(control + I64{56})))
    if (world != I64{0}) {
        world_task_finished(world)
        _ := rt_time_monotonic_provider_set(saved_provider)
        sync_store(wrapping(base + I64{104}), saved_world)
        sync_store(wrapping(base + I64{112}), saved_world_flags)
        sync_store(wrapping(base + I64{120}), saved_world_slot)
    }
    context_leave(saved_context)
    sync_store(wrapping(base + I64{16}), saved_control)
    sync_store(wrapping(base + I64{24}), saved_shield)
    sync_store(wrapping(base + I64{32}), saved_wait)
    sync_store(wrapping(base + I64{64}), saved_body)
    scheduler_completion_order(wrapping(child + I64{112}))
    sync_store(wrapping(child + I64{24}), I64{1})
    sync_park_wake(sync_load(wrapping(child + I64{104})))
    sync_wake(child + I64{24}, I64{2147483647})
    task_drop(child)
}

task_drain: fn(child: I64) {
    loop sync_load(wrapping(child + I64{24})) == (I64{0}) -> _ := sync_wait(child + I64{24}, I64{0}, I64{-1})
}

// A typed child whose own deadline is no later than the joiner's ends by
// itself with its typed result, so that join parks without observing the
// joiner's deadline: the two expire together, and the result wins.
task_join_bounded: fn(child: I64) -> Bool {
    if (sync_load(wrapping(child + I64{184})) == I64{0}) || !jet_ctx_deadline_present() -> return false
    context: wrapping(child + TASK_CONTEXT)
    sync_load(wrapping(context + CONTEXT_DEADLINE_PRESENT)) != I64{0} && sync_load(wrapping(context + CONTEXT_DEADLINE_MS)) <= jet_ctx_deadline_ms()
}

// Core Task is move-only (Sema/Ownership/Copy.jet:132-143); Rust's has no Clone
// and join(self):717 consumes the sole handle. Lexical group cleanup is a
// separate retained drain, using done@24 wake-all.
task_join_wait: fn(child: I64) -> I64 {
    kind: scheduler_msg_join()
    typed: sync_load(wrapping(child + I64{184})) != I64{0}
    bounded: task_join_bounded(child)
    if !typed -> _ := scheduler_deadline_check(kind)
    loop jet_scheduler_native_propagate() == (I64{0}) {
        if (scheduler_wait_point_cancel_check() != I64{0}) -> break
        if (sync_load(wrapping(child + I64{24})) != I64{0}) -> break
        _ := scheduler_yield_policy(kind, sync_load(wrapping(child + I64{104})), I64{-1}, !bounded)
    }
    if !typed -> _ := scheduler_deadline_check(kind)
    jet_rt_string_drop(kind)
    jet_scheduler_native_propagate()
}

task_panic_reason: fn(child: I64) -> I64 {
    control: sync_load(wrapping(child + I64{8}))
    record: sync_load(wrapping(control + I64{40}))
    message: sync_load(wrapping(record + I64{40}))
    separator: scheduler_msg_separator()
    head: scheduler_text_concat(sync_load(wrapping(child + I64{128})), separator)
    reason: task_panic_message(message)
    result: scheduler_text_concat(head, reason)
    jet_rt_string_drop(reason)
    jet_rt_string_drop(separator)
    jet_rt_string_drop(head)
    result
}

// A literal mirror of the Rust original, including its transported-header
// fallback and the compiler-shaped location suffix. Never strips arbitrary
// parenthesized text: the suffix must end ')' and contain a location colon.
task_panic_prefix: fn(data: I64, length: I64, at: I64) -> Bool {
    at + I64{7} <= length && trap_byte(wrapping(data + at)) == I64{112} && trap_byte(wrapping(wrapping(data + at) + I64{1})) == I64{97} && trap_byte(wrapping(wrapping(data + at) + I64{2})) == I64{110} && trap_byte(wrapping(wrapping(data + at) + I64{3})) == I64{105} && trap_byte(wrapping(wrapping(data + at) + I64{4})) == I64{99} && trap_byte(wrapping(wrapping(data + at) + I64{5})) == I64{58} && trap_byte(wrapping(wrapping(data + at) + I64{6})) == I64{32}
}

task_panic_message: fn(message: I64) -> I64 {
    data: sync_load(message)
    length: sync_load(wrapping(message + I64{8}))
    line_end := I64{0}
    loop line_end < length && trap_byte(wrapping(data + line_end)) != (I64{10}) -> line_end += I64{1}
    if (line_end < length && line_end > I64{0} && trap_byte(wrapping(wrapping(data + line_end) - I64{1})) == I64{13}) -> line_end -= I64{1}
    delimiter := I64{-1}
    at := I64{0}
    loop at + (I64{3}) <= line_end {
        if (trap_byte(wrapping(data + at)) == I64{93} && trap_byte(wrapping(wrapping(data + at) + I64{1})) == I64{58} && trap_byte(wrapping(wrapping(data + at) + I64{2})) == I64{32}) {
            delimiter = at
            break
        }
        at += I64{1}
    }
    candidate: if (delimiter >= I64{0}) -> delimiter + I64{3} else -> I64{0}
    candidate_end: if (delimiter >= I64{0}) -> line_end else -> length
    start := I64{0}
    end := line_end
    if task_panic_prefix(data, candidate_end, candidate) {
        start = candidate + I64{7}
        end = candidate_end
    }
    location := I64{-1}
    at = start
    loop at + (I64{5}) <= end {
        if (trap_byte(wrapping(data + at)) == I64{32} && trap_byte(wrapping(wrapping(data + at) + I64{1})) == I64{40} && trap_byte(wrapping(wrapping(data + at) + I64{2})) == I64{97} && trap_byte(wrapping(wrapping(data + at) + I64{3})) == I64{116} && trap_byte(wrapping(wrapping(data + at) + I64{4})) == I64{32}) -> location = at
        at += I64{1}
    }
    if (location >= I64{0} && end > start && trap_byte(wrapping(wrapping(data + end) - I64{1})) == I64{41}) {
        colon := false
        at = location + I64{5}
        loop at < end - (I64{1}) {
            if (trap_byte(wrapping(data + at)) == I64{58}) -> colon = true
            at += I64{1}
        }
        if colon -> end = location
    }
    result: scheduler_text_new(end - start)
    coll_copy(wrapping(data + start), sync_load(result), end - start)
    result
}

task_should_flatten: fn(child: I64, flatten: Bool) -> Bool {
    flatten && (sync_load(wrapping(sync_load(wrapping(child + I64{40})) + I64{48})).bit_and(I64{255})) == I64{8}
}

// Converts one owned ready Task into the route result. Success moves only
// initialized payload bytes. A parent stop never manufactures an out value.
task_take_outcome: fn(child: I64, flatten: Bool, out: I64) -> I64 {
    sync_mutex_lock(wrapping(child + I64{16}))
    if (sync_load(wrapping(child + I64{152})) != I64{0}) -> jet_rt_unreachable(I64{0}, I64{0})
    sync_store(wrapping(child + I64{152}), I64{1})
    status: sync_load(wrapping(child + I64{32}))
    success := I64{0}
    if (status == I64{0}) {
        slot: sync_load(wrapping(child + I64{48}))
        meta: sync_load(wrapping(child + I64{40}))
        if !task_should_flatten(child, flatten) {
            coll_copy(slot, out, coll_payload(meta))
            sync_store(wrapping(child + I64{56}), I64{0})
            success = I64{1}
        } else {
            raw: sync_load(slot)
            ok_meta: sync_load(wrapping(meta + I64{56}))
            error_meta: sync_load(wrapping(meta + I64{64}))
            if (sync_load(raw) != I64{0}) {
                coll_copy(wrapping(raw + I64{8}), out, coll_payload(ok_meta))
                success = I64{1}
            } else {
                reason: coll_call1(sync_load(wrapping(error_meta + I64{24})), raw + I64{8})
                coll_slot_drop(raw + I64{8}, error_meta)
                sync_store(out, task_failure_new(I64{2}, reason))
            }
            jet_rt_free(raw, coll_result_size(ok_meta, error_meta), I64{8})
            sync_store(wrapping(child + I64{56}), I64{0})
        }
    } else if (status == I64{2}) {
        sync_store(out, task_failure_new(I64{1}, I64{0}))
    } else if (status == I64{5}) {
        sync_store(out, task_failure_new(I64{2}, task_panic_reason(child)))
    } else {
        sync_store(out, task_failure_new(I64{0}, I64{0}))
    }
    sync_mutex_unlock(wrapping(child + I64{16}))
    task_drop(child)
    success
}

#Export(c) jet_rt_native_task_join: fn(child: I64, flatten: I64, out: I64) -> I64 {
    if (task_join_wait(child) != I64{0}) {
        scheduler_control_cancel(sync_load(wrapping(child + I64{8})))
        task_drain(child)
        task_drop(child)
        return I64{0}
    }
    task_take_outcome(child, (flatten.bit_and(I64{255})) != I64{0}, out)
}
#Export(c) jet_task_join_result: fn(child: I64, out: I64) -> I64 { jet_rt_native_task_join(child, I64{1}, out) }

// Completion frames are nested native List headers at TCB@80. Each callback
// is a closure header [refs,code,release]. Batch-reverse order matches Rust;
// callbacks registered by callbacks drain in the next batch of this frame.
scheduler_task_completion_begin: fn() -> I64 {
    stack := sync_load(wrapping(thread_base() + I64{80}))
    if (stack == I64{0}) {
        stack = jet_rt_alloc(I64{24}, I64{8})
        thread_zero(stack, I64{24})
        sync_store(wrapping(thread_base() + I64{80}), stack)
    }
    frame: jet_rt_alloc(I64{24}, I64{8})
    thread_zero(frame, I64{24})
    scheduler_words_push(stack, frame)
    frame
}
// The last owner runs the box's release helper at 16 when it has one: a
// box with nothing to release (a lambda with no captures) holds 0 there,
// as JetIR ir_closure_unref reads it.
scheduler_closure_drop: fn(closure: I64) {
    count: sync_load(closure) - I64{1}
    sync_store(closure, count)
    release: sync_load(wrapping(closure + I64{16}))
    if (count == I64{0} && release != I64{0}) -> coll_call1_unit(release, closure)
}

scheduler_cleanup_closure_drop: fn(closure: I64) {
    saved: jet_rt_session_cleanup_enter(jet_scheduler_native_status())
    jet_scheduler_shield_enter()
    scheduler_closure_drop(closure)
    jet_scheduler_shield_leave()
    jet_rt_session_cleanup_leave(saved)
}
scheduler_cleanup_closure_run: fn(closure: I64) {
    saved: jet_rt_session_cleanup_enter(jet_scheduler_native_status())
    coll_call1_unit(sync_load(wrapping(closure + I64{8})), closure)
    jet_rt_session_cleanup_leave(saved)
    // A first stop from a normal callback now owns its capture-drop scope.
    scheduler_cleanup_closure_drop(closure)
}
scheduler_task_completion_end: fn(frame: I64) {
    stack: sync_load(wrapping(thread_base() + I64{80}))
    index: sync_load(stack) - I64{1}
    if sync_load(wrapping(sync_load(wrapping(stack + I64{16})) + index * I64{8})) != frame -> jet_rt_unreachable(I64{0}, I64{0})
    loop sync_load(frame) != (I64{0}) {
        count := sync_load(frame)
        capacity: sync_load(wrapping(frame + I64{8}))
        data: sync_load(wrapping(frame + I64{16}))
        thread_zero(frame, I64{24})
        loop count > (I64{0}) {
            count -= I64{1}
            closure: sync_load(wrapping(data + count * I64{8}))
            scheduler_cleanup_closure_run(closure)
        }
        jet_rt_free(data, capacity * I64{8}, I64{8})
    }
    sync_store(stack, index)
    scheduler_words_drop(frame)
}

// The process's one exit-handler queue: a lock word at +0, then the queued
// closures' words header (count, capacity, data) at +8. A handler belongs
// to the process, not to its registering thread, so it survives that
// thread's exit. The lock covers append and claim only: the drain takes
// each FIFO batch under it and runs the batch outside it, so a handler that
// registers another does not deadlock, and a pre-stop late registration is
// owed in a subsequent batch. The first registration creates the queue and
// installs the drain as the process exit's handler step (Main.jet
// main_exit_handlers_code), so a program that registers no exit handler
// links no drain.
task_exit_root := I64{0}
#Export(c) jet_rt_task_exit_init: fn() {
    if (task_exit_root != I64{0}) -> return
    sync_mutex_lock(thread_tls_registry)
    if (task_exit_root == I64{0}) {
        root: jet_rt_alloc(I64{32}, I64{8})
        thread_zero(root, I64{32})
        main_exit_handlers_install(rt_task_exit_run_address())
        #Unsafe("written once, zeroed first, under the TLS registry mutex") {
            task_exit_root = root
        }
    }
    sync_mutex_unlock(thread_tls_registry)
}
// RuntimeLower resolves this checked address through its sole intrinsic table.
rt_task_exit_run_address: fn() -> I64 {
    loop { jet_rt_unreachable(I64{0}, I64{0}) }
}
#Export(c) jet_rt_native_atexit: fn(closure: I64) {
    if (scheduler_control_status(scheduler_control_current()) != I64{0}) {
        scheduler_cleanup_closure_drop(closure)
        return
    }
    jet_rt_task_exit_init()
    root: task_exit_root
    sync_mutex_lock(root)
    scheduler_words_push(wrapping(root + I64{8}), closure)
    sync_mutex_unlock(root)
}
#Export(c) jet_rt_task_exit_handlers: fn() {
    root: task_exit_root
    if (root == I64{0}) -> return
    loop {
        sync_mutex_lock(root)
        count: sync_load(wrapping(root + I64{8}))
        capacity: sync_load(wrapping(root + I64{16}))
        data: sync_load(wrapping(root + I64{24}))
        thread_zero(wrapping(root + I64{8}), I64{24})
        sync_mutex_unlock(root)
        if (count == I64{0}) -> return
        at := I64{0}
        loop at < count {
            scheduler_cleanup_closure_run(sync_load(wrapping(data + at * I64{8})))
            at += I64{1}
        }
        jet_rt_free(data, capacity * I64{8}, I64{8})
    }
}
// jet_rt_task_exit_handlers as main_exit_handlers_code calls it.
#Export(c) jet_rt_task_exit_run: fn(_unused: I64) -> I64 {
    jet_rt_task_exit_handlers()
    I64{0}
}
