// The exponential and logarithm functions, ported from musl 1.2.5 src/math
// (exp, exp2, log and log2 from ARM optimized-routines; expm1, log10 and
// log1p from FreeBSD msun); see Libm.jet for the porting conventions. The
// tables are musl's *_data.c tables as binary64 bit words. x86_64 musl is
// built without __FP_FAST_FMA, so the ports take musl's non-fma branches.

// __math_oflow(0) and __math_uflow(0) return +inf and +0 in place.
//
// top12 of 0x1p-54, 512.0 and 1024.0
LIBM_EXP_TOP_TINY: I64{969}
LIBM_EXP_TOP_HUGE: I64{1032}
LIBM_EXP_TOP_OVER: I64{1033}
// asuint64(-INFINITY)
LIBM_NEG_INF_BITS: I64{-4503599627370496}
LIBM_P1009: Float{5.486124068793689e+303}
// exp_data.c: N/ln2 and -ln2/N in two parts; the polynomials are inline.
LIBM_EXP_INVLN2N: Float{184.6649652337873}
LIBM_EXP_NEGLN2HIN: Float{-0.005415212348111709}
LIBM_EXP_NEGLN2LON: Float{-1.2864023111638346e-14}
// exp2_shift, 0x1.8p52/N
LIBM_EXP2_SHIFT: Float{52776558133248.0}

// exp.c specialcase(): scale*(1+tmp) where scale's exponent may have
// overflowed (k > 0) or the result is subnormal (k < 0).
libm_exp_special: fn(tmp: Float, sbits: I64, ki: I64) -> Float {
    if (ki.bit_and(I64{2147483648}) == I64{0}) {
        // k > 0, the exponent of scale might have overflowed by <= 460.
        scale: rt_f64_from_bits(wrapping(sbits - (I64{1009} << I64{52})))
        return LIBM_P1009 * (scale + scale * tmp)
    }
    libm_exp_subnormal(tmp, sbits)
}

// exp.c and exp2.c specialcase() for k < 0.
libm_exp_subnormal: fn(tmp: Float, sbits: I64) -> Float {
    scale: rt_f64_from_bits(wrapping(sbits + (I64{1022} << I64{52})))
    y := scale + scale * tmp
    if (y < Float{1.0}) {
        // Round y to the right precision before scaling it into the subnormal
        // range to avoid double rounding.
        lo := scale - y + scale * tmp
        hi: Float{1.0} + y
        lo = Float{1.0} - hi + y + lo
        y = (hi + lo) - Float{1.0}
        // Avoid -0.0 with downward rounding.
        if (y == Float{0.0}) -> y = Float{0.0}
    }
    LIBM_DBL_MIN * y
}

// exp.c
libm_exp: fn(x: Float) -> Float {
    bits: rt_f64_bits(x)
    abstop := libm_exponent(bits)
    if (abstop < LIBM_EXP_TOP_TINY || abstop >= LIBM_EXP_TOP_HUGE) {
        // Avoid spurious underflow for tiny x.
        if (abstop < LIBM_EXP_TOP_TINY) -> return Float{1.0} + x
        if (abstop >= LIBM_EXP_TOP_OVER) {
            if (bits == LIBM_NEG_INF_BITS) -> return Float{0.0}
            if (abstop >= I64{2047}) -> return Float{1.0} + x
            if (bits < I64{0}) -> return Float{0.0}
            return rt_f64_from_bits(LIBM_EXP_INF)
        }
        // Large x is special cased below.
        abstop = I64{0}
    }
    // exp(x) = 2^(k/N) * exp(r), with exp(r) in [2^(-1/2N),2^(1/2N)].
    // x = ln2/N*k + r, with int k and r in [-ln2/2N, ln2/2N].
    z: LIBM_EXP_INVLN2N * x
    // z - kd is in [-1, 1] in non-nearest rounding modes.
    shifted: z + LIBM_TOINT_HALF
    ki: rt_f64_bits(shifted)
    kd: shifted - LIBM_TOINT_HALF
    r: x + kd * LIBM_EXP_NEGLN2HIN + kd * LIBM_EXP_NEGLN2LON
    // 2^(k/N) ~= scale * (1 + tail), from table row k mod N. This is only a
    // valid scale when -1023*N < k < 1024*N.
    row: Int.from_i64(ki.bit_and(I64{127}) * I64{2})
    tail: rt_f64_from_bits(LIBM_EXP_TABLE[row])
    sbits: wrapping(LIBM_EXP_TABLE[row + 1] + libm_shl(ki, I64{45}))
    // exp(x) = 2^(k/N) * exp(r) ~= scale + scale * (tail + exp(r) - 1).
    r2: r * r
    tmp: tail + r + r2 * (Float{0.49999999999996786} + r * Float{0.16666666666665886}) + r2 * r2 * (Float{0.0416666808410674} + r * Float{0.008333335853059549})
    if (abstop == I64{0}) -> return libm_exp_special(tmp, sbits, ki)
    scale: rt_f64_from_bits(sbits)
    scale + scale * tmp
}

// exp2.c specialcase()
libm_exp2_special: fn(tmp: Float, sbits: I64, ki: I64) -> Float {
    if (ki.bit_and(I64{2147483648}) == I64{0}) {
        // k > 0, the exponent of scale might have overflowed by 1.
        scale: rt_f64_from_bits(wrapping(sbits - (I64{1} << I64{52})))
        return Float{2.0} * (scale + scale * tmp)
    }
    libm_exp_subnormal(tmp, sbits)
}

// exp2.c
libm_exp2: fn(x: Float) -> Float {
    bits: rt_f64_bits(x)
    abstop := libm_exponent(bits)
    if (abstop < LIBM_EXP_TOP_TINY || abstop >= LIBM_EXP_TOP_HUGE) {
        // Avoid spurious underflow for tiny x.
        if (abstop < LIBM_EXP_TOP_TINY) -> return Float{1.0} + x
        if (abstop >= LIBM_EXP_TOP_OVER) {
            if (bits == LIBM_NEG_INF_BITS) -> return Float{0.0}
            if (abstop >= I64{2047}) -> return Float{1.0} + x
            if (bits >= I64{0}) -> return rt_f64_from_bits(LIBM_EXP_INF)
            // asuint64(x) >= asuint64(-1075.0)
            if (!libm_ult(bits, I64{-4570929321408987136})) -> return Float{0.0}
        }
        // 2 * asuint64(x) > 2 * asuint64(928.0): large x is special cased below.
        if (libm_ult(libm_shl(I64{4651373990143590400}, I64{1}), libm_shl(bits, I64{1}))) -> abstop = I64{0}
    }
    // exp2(x) = 2^(k/N) * 2^r, with 2^r in [2^(-1/2N),2^(1/2N)].
    // x = k/N + r, with int k and r in [-1/2N, 1/2N].
    shifted: x + LIBM_EXP2_SHIFT
    ki: rt_f64_bits(shifted)
    // k/N for int k.
    kd: shifted - LIBM_EXP2_SHIFT
    r: x - kd
    // 2^(k/N) ~= scale * (1 + tail), from table row k mod N.
    row: Int.from_i64(ki.bit_and(I64{127}) * I64{2})
    tail: rt_f64_from_bits(LIBM_EXP_TABLE[row])
    sbits: wrapping(LIBM_EXP_TABLE[row + 1] + libm_shl(ki, I64{45}))
    // exp2(x) = 2^(k/N) * 2^r ~= scale + scale * (tail + 2^r - 1).
    r2: r * r
    tmp: tail + r * Float{0.6931471805599453} + r2 * (Float{0.24022650695909065} + r * Float{0.0555041086686087}) + r2 * r2 * (Float{0.009618131975721055} + r * Float{0.0013332074570119598})
    if (abstop == I64{0}) -> return libm_exp2_special(tmp, sbits, ki)
    scale: rt_f64_from_bits(sbits)
    scale + scale * tmp
}

LIBM_LN2_HI: Float{0.6931471803691238}
LIBM_LN2_LO: Float{1.9082149292705877e-10}

// expm1.c
libm_expm1: fn(x0: Float) -> Float {
    bits: rt_f64_bits(x0)
    hx: (bits >> I64{32}).bit_and(I64{2147483647})
    negative: bits < I64{0}
    x := x0
    // filter out huge and non-finite argument
    if (hx >= I64{0x4043687A}) {
        // if |x|>=56*ln2
        if (x != x) -> return x
        if negative -> return Float{-1.0}
        if (x > Float{709.782712893384}) -> return x * LIBM_P1023
    }
    k := I64{0}
    c := Float{0.0}
    // argument reduction
    if (hx > I64{0x3fd62e42}) {
        // if  |x| > 0.5 ln2
        hi := Float{0.0}
        lo := Float{0.0}
        if (hx < I64{0x3FF0A2B2}) {
            // and |x| < 1.5 ln2
            if negative {
                hi = x + LIBM_LN2_HI
                lo = -LIBM_LN2_LO
                k = I64{-1}
            } else {
                hi = x - LIBM_LN2_HI
                lo = LIBM_LN2_LO
                k = I64{1}
            }
        } else {
            half: if negative -> Float{-0.5} else -> Float{0.5}
            k = libm_whole(libm_trunc(Float{1.4426950408889634} * x + half))
            t: libm_small_float(k)
            // t*ln2_hi is exact here
            hi = x - t * LIBM_LN2_HI
            lo = t * LIBM_LN2_LO
        }
        x = hi - lo
        c = (hi - x) - lo
    } else if (hx < I64{0x3c900000}) {
        // |x| < 2**-54, return x
        return x
    }
    // x is now in primary range
    hfx: Float{0.5} * x
    hxs: x * hfx
    r1: Float{1.0} + hxs * (Float{-0.03333333333333313} + hxs * (Float{0.0015873015872548146} + hxs * (Float{-0.0000793650757867488} + hxs * (Float{0.000004008217827329362} + hxs * Float{-2.0109921818362437e-7}))))
    t: Float{3.0} - r1 * hfx
    e := hxs * ((r1 - t) / (Float{6.0} - x * t))
    // c is 0
    if (k == I64{0}) -> return x - (x * e - hxs)
    e = x * (e - c) - c
    e = e - hxs
    // exp(x) ~ 2^k (x_reduced - e + 1)
    if (k == I64{-1}) -> return Float{0.5} * (x - e) - Float{0.5}
    if (k == I64{1}) {
        if (x < Float{-0.25}) -> return Float{-2.0} * (e - (x + Float{0.5}))
        return Float{1.0} + Float{2.0} * (x - e)
    }
    // 2^k
    twopk: rt_f64_from_bits((I64{0x3ff} + k) << I64{52})
    if (k < I64{0} || k > I64{56}) {
        // suffice to return exp(x)-1
        y := x - e + Float{1.0}
        y = if (k == I64{1024}) -> y * Float{2.0} * LIBM_P1023 else -> y * twopk
        return y - Float{1.0}
    }
    // 2^-k
    inverse: rt_f64_from_bits((I64{0x3ff} - k) << I64{52})
    if (k < I64{20}) -> return (x - e + (Float{1.0} - inverse)) * twopk
    (x - (e + inverse) + Float{1.0}) * twopk
}

// __math_invalid(x); __math_divzero(1) is -inf.
libm_invalid: fn(x: Float) -> Float { (x - x) / (x - x) }

// log.c and log2.c OFF: z is in [OFF, 2*OFF).
LIBM_LOG_OFF: I64{4604367669032910848}
// asuint64(1.0)
LIBM_ONE_BITS: I64{4607182418800017408}
// 0xfffULL << 52 and -1ULL << 32
LIBM_TOP12_MASK: I64{-4503599627370496}
LIBM_HIGH_WORD: I64{-4294967296}
LIBM_P27: Float{134217728.0}

// log.c and log2.c: x < 0x1p-1022, inf or nan when `special`; returns the
// result, or (as `ix`) the bits of a subnormal x scaled to normal.
LibmLogSpecial: struct { done: Bool, value: Float, ix: I64 }

libm_log_special: fn(x: Float, ix: I64) -> LibmLogSpecial {
    top: libm_shr(ix, I64{48})
    if (libm_shl(ix, I64{1}) == I64{0}) -> return LibmLogSpecial{done: true, value: rt_f64_from_bits(LIBM_NEG_INF_BITS), ix: ix}
    // log(inf) == inf.
    if (ix == LIBM_EXP_INF) -> return LibmLogSpecial{done: true, value: x, ix: ix}
    if (top.bit_and(I64{0x8000}) != I64{0} || top.bit_and(I64{0x7ff0}) == I64{0x7ff0}) -> return LibmLogSpecial{done: true, value: libm_invalid(x), ix: ix}
    // x is subnormal, normalize it.
    LibmLogSpecial{done: false, value: x, ix: wrapping(rt_f64_bits(x * LIBM_TOINT) - (I64{52} << I64{52}))}
}

// log.c
libm_log: fn(x: Float) -> Float {
    ix := rt_f64_bits(x)
    top: libm_shr(ix, I64{48})
    // Handle close to 1.0 inputs separately: 1.0 - 0x1p-4 <= x < 1.0 + 0x1.09p-4.
    if (libm_ult(wrapping(ix - I64{4606619468846596096}), I64{4607473789381378048} - I64{4606619468846596096})) {
        // Fix sign of zero with downward rounding when x==1.
        if (ix == LIBM_ONE_BITS) -> return Float{0.0}
        r: x - Float{1.0}
        r2: r * r
        r3: r * r2
        y := r3 * (Float{0.3333333333333352} + r * Float{-0.24999999999998432} + r2 * Float{0.19999999999320328} + r3 * (Float{-0.16666666669929706} + r * Float{0.14285715076560868} + r2 * Float{-0.12499997863982555} + r3 * (Float{0.11110712032936046} + r * Float{-0.10000486757818193} + r2 * Float{0.09181994006195467} + r3 * Float{-0.08328363062289341})))
        // Worst-case error is around 0.507 ULP.
        w := r * LIBM_P27
        rhi: r + w - w
        rlo: r - rhi
        // B[0] == -0.5.
        w = rhi * rhi * Float{-0.5}
        hi: r + w
        lo := r - hi + w
        lo = lo + Float{-0.5} * rlo * (rhi + r)
        y = y + lo
        y = y + hi
        return y
    }
    if (top < I64{0x0010} || top >= I64{0x7ff0}) {
        special: libm_log_special(x, ix)
        if special.done -> return special.value
        ix = special.ix
    }
    // x = 2^k z; where z is in range [OFF,2*OFF) and exact.
    // The range is split into N subintervals.
    // The ith subinterval contains z and c is near its center.
    tmp: wrapping(ix - LIBM_LOG_OFF)
    i: Int.from_i64(libm_shr(tmp, I64{45}).bit_and(I64{127}) * I64{2})
    // arithmetic shift
    k: tmp >> I64{52}
    iz: wrapping(ix - tmp.bit_and(LIBM_TOP12_MASK))
    invc: rt_f64_from_bits(LIBM_LOG_TABLE[i])
    logc: rt_f64_from_bits(LIBM_LOG_TABLE[i + 1])
    z: rt_f64_from_bits(iz)
    // log(x) = log1p(z/c-1) + log(c) + k*Ln2.
    // r ~= z/c - 1, |r| < 1/(2*N); rounding error: 0x1p-55/N + 0x1p-66.
    r: (z - rt_f64_from_bits(LIBM_LOG_TABLE2[i]) - rt_f64_from_bits(LIBM_LOG_TABLE2[i + 1])) * invc
    kd: libm_small_float(k)
    // hi + lo = r + log(c) + k*Ln2.
    w: kd * Float{0.6931471805598903} + logc
    hi: w + r
    lo: w - hi + r + kd * Float{5.497923018708371e-14}
    // log(x) = lo + (log1p(r) - r) + hi.
    r2: r * r
    lo + r2 * Float{-0.5000000000000001} + r * r2 * (Float{0.33333333331825593} + r * Float{-0.2499999999622955} + r2 * (Float{0.20000304511814496} + r * Float{-0.16667054827627667})) + hi
}

LIBM_INVLN2_HI: Float{1.4426950407214463}
LIBM_INVLN2_LO: Float{1.6751713164886512e-10}

// log2.c
libm_log2: fn(x: Float) -> Float {
    ix := rt_f64_bits(x)
    top: libm_shr(ix, I64{48})
    // Handle close to 1.0 inputs separately: 1.0 - 0x1.5b51p-5 <= x < 1.0 + 0x1.6ab2p-5.
    if (libm_ult(wrapping(ix - I64{4606800540372828160}), I64{4607381812656734208} - I64{4606800540372828160})) {
        // Fix sign of zero with downward rounding when x==1.
        if (ix == LIBM_ONE_BITS) -> return Float{0.0}
        r: x - Float{1.0}
        rhi: rt_f64_from_bits(rt_f64_bits(r).bit_and(LIBM_HIGH_WORD))
        rlo: r - rhi
        hi: rhi * LIBM_INVLN2_HI
        lo := rlo * LIBM_INVLN2_HI + r * LIBM_INVLN2_LO
        r2: r * r
        r4: r2 * r2
        // Worst-case error is less than 0.54 ULP (0.55 ULP without fma).
        p: r2 * (Float{-0.7213475204444817} + r * Float{0.48089834696298744})
        y := hi + p
        lo = lo + (hi - y + p)
        lo = lo + r4 * (Float{-0.360673760222145} + r * Float{0.2885390081805197} + r2 * (Float{-0.24044917405728863} + r * Float{0.2060992861022954}) + r4 * (Float{-0.18033596705327856} + r * Float{0.1603032746063156} + r2 * (Float{-0.14483316576701266} + r * Float{0.13046826811283835})))
        y = y + lo
        return y
    }
    if (top < I64{0x0010} || top >= I64{0x7ff0}) {
        special: libm_log_special(x, ix)
        if special.done -> return special.value
        ix = special.ix
    }
    // x = 2^k z; where z is in range [OFF,2*OFF) and exact.
    tmp: wrapping(ix - LIBM_LOG_OFF)
    i: Int.from_i64(libm_shr(tmp, I64{46}).bit_and(I64{63}) * I64{2})
    // arithmetic shift
    k: tmp >> I64{52}
    iz: wrapping(ix - tmp.bit_and(LIBM_TOP12_MASK))
    invc: rt_f64_from_bits(LIBM_LOG2_TABLE[i])
    logc: rt_f64_from_bits(LIBM_LOG2_TABLE[i + 1])
    z: rt_f64_from_bits(iz)
    kd: libm_small_float(k)
    // log2(x) = log2(z/c) + log2(c) + k.
    // r ~= z/c - 1, |r| < 1/(2*N); rounding error: 0x1p-55/N + 0x1p-65.
    r: (z - rt_f64_from_bits(LIBM_LOG2_TABLE2[i]) - rt_f64_from_bits(LIBM_LOG2_TABLE2[i + 1])) * invc
    rhi: rt_f64_from_bits(rt_f64_bits(r).bit_and(LIBM_HIGH_WORD))
    rlo: r - rhi
    t1: rhi * LIBM_INVLN2_HI
    t2: rlo * LIBM_INVLN2_HI + r * LIBM_INVLN2_LO
    // hi + lo = r/ln2 + log2(c) + k.
    t3: kd + logc
    hi: t3 + t1
    lo: t3 - hi + t1 + t2
    // log2(r+1) = r/ln2 + r^2*poly(r).
    r2: r * r
    r4: r2 * r2
    p: Float{-0.7213475204444882} + r * Float{0.4808983469629985} + r2 * (Float{-0.36067375954075914} + r * Float{0.2885390073180969}) + r4 * (Float{-0.2404693555628422} + r * Float{0.2061202382173603})
    lo + r2 * p + hi
}

// log10.c and log1p.c: log(1+f) - f + f*f/2 for f in [sqrt(2)/2-1, sqrt(2)-1],
// as R = t2 + t1 with s = f/(2+f).
libm_log_ratio: fn(s: Float) -> Float {
    z: s * s
    w: z * z
    t1: w * (Float{0.3999999999940942} + w * (Float{0.22222198432149784} + w * Float{0.15313837699209373}))
    t2: z * (Float{0.6666666666666735} + w * (Float{0.2857142874366239} + w * (Float{0.1818357216161805} + w * Float{0.14798198605116586})))
    t2 + t1
}

// log10.c
libm_log10: fn(x0: Float) -> Float {
    bits := rt_f64_bits(x0)
    x := x0
    hx := libm_shr(bits, I64{32})
    k := I64{0}
    if (hx < I64{0x00100000} || hx >= I64{0x80000000}) {
        // log(+-0)=-inf
        if (libm_shl(bits, I64{1}) == I64{0}) -> return Float{-1.0} / (x * x)
        // log(-#) = NaN
        if (hx >= I64{0x80000000}) -> return (x - x) / Float{0.0}
        // subnormal number, scale x up
        k -= I64{54}
        x = x * Float{18014398509481984.0}
        bits = rt_f64_bits(x)
        hx = libm_shr(bits, I64{32})
    } else if (hx >= I64{0x7ff00000}) {
        return x
    } else if (hx == I64{0x3ff00000} && libm_shl(bits, I64{32}) == I64{0}) {
        return Float{0.0}
    }
    // reduce x into [sqrt(2)/2, sqrt(2)]
    hx += I64{0x3ff00000} - I64{0x3fe6a09e}
    k += (hx >> I64{20}) - I64{0x3ff}
    hx = hx.bit_and(I64{0x000fffff}) + I64{0x3fe6a09e}
    x = rt_f64_from_bits((hx << I64{32}).bit_or(bits.bit_and(I64{4294967295})))
    f: x - Float{1.0}
    hfsq: Float{0.5} * f * f
    s: f / (Float{2.0} + f)
    ratio: libm_log_ratio(s)
    // hi+lo = f - hfsq + s*(hfsq+R) ~ log(1+f)
    hi: rt_f64_from_bits(rt_f64_bits(f - hfsq).bit_and(LIBM_HIGH_WORD))
    lo: f - hi - hfsq + s * (hfsq + ratio)
    // val_hi+val_lo ~ log10(1+f) + k*log10(2)
    val_hi: hi * Float{0.4342944818781689}
    dk: libm_small_float(k)
    y: dk * Float{0.30102999566361177}
    val_lo := dk * Float{3.694239077158931e-13} + (lo + hi) * Float{2.5082946711645275e-11} + lo * Float{0.4342944818781689}
    // Extra precision in for adding y.
    w: y + val_hi
    val_lo = val_lo + ((y - w) + val_hi)
    val_lo + w
}

// log1p.c
libm_log1p: fn(x: Float) -> Float {
    bits: rt_f64_bits(x)
    hx: libm_shr(bits, I64{32})
    k := I64{1}
    c := Float{0.0}
    f := Float{0.0}
    if (hx < I64{0x3fda827a} || hx >= I64{0x80000000}) {
        // 1+x < sqrt(2)+
        if (hx >= I64{0xbff00000}) {
            // x <= -1.0; log1p(-1) = -inf, log1p(x<-1) = NaN
            if (x == Float{-1.0}) -> return x / Float{0.0}
            return (x - x) / Float{0.0}
        }
        // |x| < 2**-53
        if (hx.bit_and(I64{2147483647}) < I64{0x3ca00000}) -> return x
        if (hx <= I64{0xbfd2bec4}) {
            // sqrt(2)/2- <= 1+x < sqrt(2)+
            k = I64{0}
            f = x
        }
    } else if (hx >= I64{0x7ff00000}) {
        return x
    }
    if (k != I64{0}) {
        u: Float{1.0} + x
        ubits: rt_f64_bits(u)
        hu: libm_shr(ubits, I64{32}) + (I64{0x3ff00000} - I64{0x3fe6a09e})
        k = (hu >> I64{20}) - I64{0x3ff}
        // correction term ~ log(1+x)-log(u), avoid underflow in c/u
        if (k < I64{54}) {
            c = if (k >= I64{2}) -> Float{1.0} - (u - x) else -> x - (u - Float{1.0})
            c = c / u
        }
        // reduce u into [sqrt(2)/2, sqrt(2)]
        reduced: hu.bit_and(I64{0x000fffff}) + I64{0x3fe6a09e}
        f = rt_f64_from_bits((reduced << I64{32}).bit_or(ubits.bit_and(I64{4294967295}))) - Float{1.0}
    }
    hfsq: Float{0.5} * f * f
    s: f / (Float{2.0} + f)
    ratio: libm_log_ratio(s)
    dk: libm_small_float(k)
    s * (hfsq + ratio) + (dk * LIBM_LN2_LO + c) - hfsq + f + dk * LIBM_LN2_HI
}

