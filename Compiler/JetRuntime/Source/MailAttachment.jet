#Export(c) fn jet_rt_record_new_Attachment(filename: I64, mime: I64, bytes: I64) -> I64 {
    result :: jet_rt_alloc(I64{40}, I64{8})
    rt_text_store(result, jet_rt_string_clone(filename))
    rt_text_store(result + I64{8}, jet_rt_string_clone(mime))
    coll_copy(bytes, result + I64{16}, DATA_SEQUENCE_BYTES)
    jet_rt_free(bytes, DATA_SEQUENCE_BYTES, I64{8})
    result
}
