        delta := host_native_int(offset)
        origin :: host_i32(whence)
        if (origin == I64{1} && fd_word(state, I64{40}) > I64{0}) -> delta = wrapping(delta - fd_word(state, I64{48}) + fd_word(state, I64{56}))
        result = host_call(I64{8}, fd_word(state, I64{8}), delta, origin)
        if (result >= I64{0}) { fd_put(state, I64{48}, I64{0}); fd_put(state, I64{56}, I64{0}) }
    }
    fd_unlock(state)
    fd_zero(result, zero)
    if (result == HOST_WRITE_ZERO) { fd_put(errno, I64{0}, I64{0}); return I64{-1} }
    result = fd_error(result, errno)
    if (result < I64{0}) -> result else -> jet_int_owned_from_i64(result)
