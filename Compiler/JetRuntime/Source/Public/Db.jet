// `jet.runtime.db` (#6615): the host steps of the Jet SQLite engine's unix
// VFS (Core/Db/Engine/Os.jet), in Jet types with the DB effect. Each member
// is a runtime binding (Guest.jet sema_guest_runtime_binding) of the runtime
// export that is its one body (HostDbVfs.jet), one system call each. Each is
// `priv`: only core.db calls them. An Int answer is the call's result or the
// negated OS code, which Os.jet maps to the SQLite result code.
db: module {
    // open(2) of `path` with `flags` and, for a create, `mode` (0 is 0644);
    // the descriptor.
    #Import(c) priv vfs_open: fn(path: String, flags: Int, mode: Int) -[DB]> Int = "jet_db_vfs_open"

    // close(2) of `fd`.
    #Import(c) priv vfs_close: fn(fd: Int) -[DB]> Int = "jet_db_vfs_close"

    // pread of `count` bytes at file offset `offset` into `buffer` from index
    // `at`, and pwrite of `count` bytes of `data` from index `at`; the bytes
    // moved.
    #Import(c) priv vfs_read: fn(fd: Int, offset: Int, buffer: &[U8], at: Int, count: Int) -[DB]> Int = "jet_db_vfs_read"
    #Import(c) priv vfs_write: fn(fd: Int, offset: Int, data: [U8], at: Int, count: Int) -[DB]> Int = "jet_db_vfs_write"

    // fsync(2), ftruncate(2) to `size` and fstat(2)'s size of `fd`.
    #Import(c) priv vfs_sync: fn(fd: Int) -[DB]> Int = "jet_db_vfs_sync"
    #Import(c) priv vfs_truncate: fn(fd: Int, size: Int) -[DB]> Int = "jet_db_vfs_truncate"
    #Import(c) priv vfs_size: fn(fd: Int) -[DB]> Int = "jet_db_vfs_size"

    // stat(2)'s permission bits, lstat(2)'s type and permission bits, and
    // stat(2)'s inode of `path`.
    #Import(c) priv vfs_mode: fn(path: String) -[DB]> Int = "jet_db_vfs_mode"
    #Import(c) priv vfs_lstat_mode: fn(path: String) -[DB]> Int = "jet_db_vfs_lstat_mode"
    #Import(c) priv vfs_inode: fn(path: String) -[DB]> Int = "jet_db_vfs_inode"

    // A root process gives `fd` the owner of `path` (robustFchown).
    #Import(c) priv vfs_chown_like: fn(fd: Int, path: String) -[DB]> Int = "jet_db_vfs_chown_like"

    // fstat(2)'s inode of the open file `fd`.
    #Import(c) priv vfs_fd_inode: fn(fd: Int) -[DB]> Int = "jet_db_vfs_fd_inode"

    // fcntl(2) record lock `command` of `kind` over `len` bytes from `start`.
    // A set command answers 0, a get command the conflicting lock's type.
    #Import(c) priv vfs_lock: fn(fd: Int, command: Int, kind: Int, start: Int, len: Int) -[DB]> Int = "jet_db_vfs_lock"

    // unlink(2) and access(2) with `mode` of `path`.
    #Import(c) priv vfs_unlink: fn(path: String) -[DB]> Int = "jet_db_vfs_unlink"
    #Import(c) priv vfs_access: fn(path: String, mode: Int) -[DB]> Int = "jet_db_vfs_access"

    // Whether stat(2) of `path` succeeds and it is not an empty regular file;
    // with `directory`, whether it is a directory.
    #Import(c) priv vfs_exists: fn(path: String, directory: Bool) -[DB]> Bool = "jet_db_vfs_exists"

    // The target of the link `path`, and the working directory; each is ""
    // when the call fails.
    #Import(c) priv vfs_readlink: fn(path: String) -[DB]> String = "jet_db_vfs_readlink"
    #Import(c) priv vfs_cwd: fn() -[DB]> String = "jet_db_vfs_cwd"

    // Sleeps `micros` microseconds; the microseconds asked for.
    #Import(c) priv vfs_sleep: fn(micros: Int) -[DB]> Int = "jet_db_vfs_sleep"

    // Fills `buffer` from getrandom(2); the bytes filled.
    #Import(c) priv vfs_random: fn(buffer: &[U8]) -[DB]> Int = "jet_db_vfs_random"

    // The wall clock in milliseconds since the Unix epoch.
    #Import(c) priv vfs_now_ms: fn() -[DB]> Int = "jet_db_vfs_now_ms"

    // Publishes a job-queue observation to the Devtools event sink.
    #Import(c) priv job_publish_parts: fn(timestamp_ms: Int, source: String, kind: String, entity: String, fields: String) -[DB]> = "jet_job_queue_publish_parts"

    // Sleeps `millis` of wall time between job-queue polls.
    #Import(c) priv job_sleep_ms: fn(millis: Int) -[DB]> = "jet_job_queue_sleep_ms"
}
