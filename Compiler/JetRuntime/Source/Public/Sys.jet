// `jet.runtime.sys` (#6615): the runtime's host facts, environment writes,
// descriptors, shared memory and POSIX process calls, in Jet types with their
// declared effect rows. Each member is a runtime binding (Guest.jet
// sema_guest_runtime_binding) of the runtime export that is its one body
// (CompilerHost.jet, EnvRoutes.jet, HostDescriptors.jet, HostProcess.jet,
// HostStdio.jet, HostTiming.jet, RouteSys.jet). Each but image_part and
// image_part_size is `priv`: only core.sys, core.data and core.files call
// them. A tuple result's items cross in the checked tuple's written order,
// which is the export's slot order. A
// POSIX call answers whether the host has it (`available`), the call's
// result and its errno (0 when it worked). A descriptor or shared-memory
// `token` is the runtime's token for the object, never its number.
sys: module {
    // Sets the environment variable `name` to `value`, and removes `name`
    // (whether it was set). IR lowers both onto the program's logical
    // environment (RuntimeRoutes.jet IR_ENVIRONMENT_ROUTES), as every
    // environment call.
    #Import(c) priv env_set: fn(name: String, value: String) -[Env]> EnvError! = "jet_std_env_try_set"
    #Import(c) priv env_remove: fn(name: String) -[Env]> Bool EnvError! = "jet_std_env_unset"

    // The host's OS family.
    #Import(c) priv family: fn() -[Env]> String = "jet_std_os_family"

    // This process's id.
    #Import(c) priv pid: fn() -[Env]> Int = "jet_std_os_pid"

    // Flushes every file system's buffers to storage.
    #Import(c) priv sync: fn() -[Env]> = "jet_std_os_sync"

    // Closes the descriptor numbered `fd`.
    #Import(c) priv close_fd: fn(fd: Int) -[Env]> = "jet_std_os_close_fd"

    // Closes the descriptor `token` holds and releases the token.
    #Import(c) priv fd_close: fn(token: Int) -[Env]> = "jet_sys_fd_close_raw"

    // At most `limit` bytes from byte `offset` of the file `token` holds.
    #Import(c) priv fd_read_at: fn(token: Int, offset: Int, limit: Int) -[Env]> [U8] IOError! = "jet_sys_fd_read_at_raw"

    // The size in bytes of the file `token` holds.
    #Import(c) priv fd_size: fn(token: Int) -[Env]> Int IOError! = "jet_sys_fd_size_raw"

    // A new token for a duplicate of the descriptor `token` holds.
    #Import(c) priv fd_duplicate: fn(token: Int) -[Env]> Int IOError! = "jet_sys_fd_duplicate_raw"

    // A new pipe's two tokens, packed as bytes.
    #Import(c) priv fd_pipe: fn() -[Env]> [U8] IOError! = "jet_sys_fd_pipe_raw"

    // At most `limit` bytes read from `token`, waiting at most `timeout`
    // nanoseconds.
    #Import(c) priv fd_read: fn(token: Int, limit: Int, timeout: Int) -[Env]> [U8] IOError! = "jet_sys_fd_read_raw"

    // Writes `data` to `token`, waiting at most `timeout` nanoseconds; the
    // bytes written.
    #Import(c) priv fd_write: fn(token: Int, data: [U8], timeout: Int) -[Env]> Int IOError! = "jet_sys_fd_write_raw"

    // A new shared-memory object of `size` bytes; its token.
    #Import(c) priv shared_create: fn(size: Int) -[Env]> Int IOError! = "jet_sys_shared_create_raw"

    // Writes `data` at byte `offset` of the shared memory `token`.
    #Import(c) priv shared_write: fn(token: Int, offset: Int, data: [U8]) -[Env]> IOError! = "jet_sys_shared_write_raw"

    // Writes the `columns` by `rows` pixels of `data` (`stride` bytes a row)
    // at `left`, `top` of the pixel buffer at byte `offset` of the shared
    // memory `token`, in the byte order `order`.
    #Import(c) priv shared_write_pixels: fn(token: Int, offset: Int, data: [U8], stride: Int, left: Int, top: Int, columns: Int, rows: Int, order: Int) -[Env]> IOError! = "jet_sys_shared_write_pixels_raw"

    // `count` bytes from byte `offset` of the shared memory `token`.
    #Import(c) priv shared_read: fn(token: Int, offset: Int, count: Int) -[Env]> [U8] IOError! = "jet_sys_shared_read_raw"

    // Sets `count` bytes from byte `offset` of the shared memory `token` to
    // `value`.
    #Import(c) priv shared_fill: fn(token: Int, offset: Int, count: Int, value: Int) -[Env]> IOError! = "jet_sys_shared_fill_raw"

    // The 8-byte word at byte `offset` of the shared memory `token`, read
    // atomically (SeqCst).
    #Import(c) priv shared_load: fn(token: Int, offset: Int) -[Env]> Int IOError! = "jet_sys_shared_load_raw"

    // Stores `value` atomically (SeqCst) in the 8-byte word at byte `offset`.
    #Import(c) priv shared_store: fn(token: Int, offset: Int, value: Int) -[Env]> IOError! = "jet_sys_shared_store_raw"

    // 1 when the word at byte `offset` held `expected` and now holds
    // `replacement`, else 0 (SeqCst).
    #Import(c) priv shared_compare_exchange: fn(token: Int, offset: Int, expected: Int, replacement: Int) -[Env]> Int IOError! = "jet_sys_shared_compare_exchange_raw"

    // The working directory, or an Err with the reason it can't be read.
    #Import(c) priv current_dir: fn() -[Env]> String Err! = "jet_sys_current_dir_raw"

    // The working directory a service resolves its store path against, or
    // an Err with the reason (core.service).
    #Import(c) priv service_current_dir: fn() -[Env]> String Err! = "jet_sys_current_dir_raw"

    // `count` bytes of operating-system entropy for a service authority
    // token, None when the host can't supply them (core.service).
    #Import(c) priv service_entropy: fn(count: Int) -[Rand]> [U8]? = "jet_random_os_entropy"

    // Makes `path` the working directory, or an Err with the reason.
    #Import(c) priv set_current_dir: fn(path: String) -[Env]> Err! = "jet_sys_set_current_dir_raw"

    // The host OS's name and its CPU architecture.
    #Import(c) priv name: fn() -[Env]> String = "jet_std_os_name"
    #Import(c) priv arch: fn() -[Env]> String = "jet_std_os_arch"

    // The host's processor count, None when it can't be read.
    #Import(c) priv cpu_count: fn() -[Env]> Int? = "jet_sys_cpu_count_raw"

    // 1 when the host's vendor confirms fixed-timing execution.
    #Import(c) priv timing_host: fn() -[Env]> Int = "jet_sys_timing_host"

    // The running program's path, None when it can't be read.
    #Import(c) priv executable: fn() -[Env]> String? = "jet_sys_executable_raw"

    // At most `limit` bytes of the part `name` the build added to this
    // executable, from its byte `offset`, and the part's byte length; None
    // when it has no such part. The part is mapped with the program, so
    // neither reads a file, and image_part lends the mapped bytes in place:
    // its List is frozen, never copied or freed, and a writer copies it
    // first. Not `priv`: the CLI's Core record check (CoreRecordCheck.jet)
    // reads them.
    #Import(c) image_part: fn(name: String, offset: Int, limit: Int) -[Env]> [U8]? = "jet_sys_image_part_raw"
    #Import(c) image_part_size: fn(name: String) -[Env]> Int? = "jet_sys_image_part_size_raw"

    // The host's f32 SIMD dispatch width, a fact of the CPU the program runs
    // on, read without a system call. It is run-time only
    // (RUNTIME_ONLY_READS), so no build computes it for the machine that
    // compiled it.
    #Import(c) priv simd_lanes: fn() -> Int = "jet_compute_simd_lanes"

    // core.perf's fidelity word: 0 unset, else the f64 bits plus one.
    #Import(c) priv perf_bits: fn() -[Env]> Int = "jet_perf_read_bits"
    #Import(c) priv set_perf_bits: fn(bits: Int) -[Env]> = "jet_perf_write_bits"

    // The bytes of the host environment variable `name`, None when unset.
    #Import(c) priv host_env: fn(name: String) -[Env]> [U8]? = "jet_sys_host_env_raw"

    // This process's parent id, user and group ids and process group; None
    // where the host has no such id.
    #Import(c) priv getppid: fn() -[Env]> Int? = "jet_sys_getppid_raw"
    #Import(c) priv getuid: fn() -[Env]> Int? = "jet_sys_getuid_raw"
    #Import(c) priv geteuid: fn() -[Env]> Int? = "jet_sys_geteuid_raw"
    #Import(c) priv getgid: fn() -[Env]> Int? = "jet_sys_getgid_raw"
    #Import(c) priv getegid: fn() -[Env]> Int? = "jet_sys_getegid_raw"
    #Import(c) priv getpgrp: fn() -[Env]> Int? = "jet_sys_getpgrp_raw"

    // How many supplementary groups this process has, and up to `capacity`
    // of them after their count (a negative count is a failure).
    #Import(c) priv groups_count: fn() -[Env]> Int? = "jet_sys_groups_count_raw"
    #Import(c) priv groups_fill: fn(capacity: Int) -[Env]> [Int] = "jet_sys_groups_fill_raw"

    // The 1, 5 and 15 minute load averages, `count` of them read.
    #Import(c) priv loadavg: fn() -[Env]> (available: Bool, count: Int, first: Float, second: Float, third: Float) = "jet_sys_loadavg_raw"

    // This process's and its waited children's CPU times and the elapsed
    // time, in `ticks` a second.
    #Import(c) priv times: fn() -[Env]> (available: Bool, child_system: Int, child_user: Int, elapsed: Int, system: Int, ticks: Int, user: Int) = "jet_sys_times_raw"

    // The soft and hard limits of the RLIMIT_* `resource` (-1 unlimited), and
    // setting them (-1 unlimited).
    #Import(c) priv rlimit: fn(resource: Int) -[Env]> (available: Bool, errno: Int, hard: Int, soft: Int) = "jet_sys_rlimit_raw"
    #Import(c) priv set_rlimit: fn(resource: Int, soft: Int, hard: Int) -[Env]> (available: Bool, errno: Int, value: Int) = "jet_sys_set_rlimit_raw"

    // The user and system CPU microseconds and peak resident bytes of `who`
    // (0 this process, -1 its waited children).
    #Import(c) priv rusage: fn(who: Int) -[Env]> (available: Bool, errno: Int, peak: Int, system: Int, user: Int) = "jet_sys_rusage_raw"

    // The process group and the session of the process `pid`.
    #Import(c) priv getpgid: fn(pid: Int) -[Env]> (available: Bool, errno: Int, value: Int) = "jet_sys_getpgid_raw"
    #Import(c) priv getsid: fn(pid: Int) -[Env]> (available: Bool, errno: Int, value: Int) = "jet_sys_getsid_raw"

    // Sets the file-creation mask to `mask`; the previous mask.
    #Import(c) priv umask: fn(mask: Int) -[Env]> Int? = "jet_sys_umask_raw"

    // The scheduling priority of `who`, and setting it to `priority`.
    #Import(c) priv getpriority: fn(who: Int) -[Env]> (available: Bool, errno: Int, value: Int) = "jet_sys_getpriority_raw"
    #Import(c) priv setpriority: fn(who: Int, priority: Int) -[Env]> (available: Bool, errno: Int, value: Int) = "jet_sys_setpriority_raw"

    // Sets the access and modification times of `path`, in seconds.
    #Import(c) priv utime: fn(path: String, atime: Int, mtime: Int) -[Env]> (available: Bool, errno: Int, value: Int) = "jet_sys_utime_raw"

    // The text of the errno `errno`.
    #Import(c) priv errno_text: fn(errno: Int) -[Env]> String = "jet_sys_errno_text_raw"

    // Forks this process (`value` is the child's id, 0 in the child), and
    // starts a new session.
    #Import(c) priv fork: fn() -[Exec]> (available: Bool, errno: Int, value: Int) = "jet_sys_fork_raw"
    #Import(c) priv setsid: fn() -[Exec]> (available: Bool, errno: Int, value: Int) = "jet_sys_setsid_raw"

    // Sets the user id, the group id, the process group of `pid`, and this
    // process's process group.
    #Import(c) priv setuid: fn(uid: Int) -[Env]> (available: Bool, errno: Int, value: Int) = "jet_sys_setuid_raw"
    #Import(c) priv setgid: fn(gid: Int) -[Env]> (available: Bool, errno: Int, value: Int) = "jet_sys_setgid_raw"
    #Import(c) priv setpgid: fn(pid: Int, pgid: Int) -[Env]> (available: Bool, errno: Int, value: Int) = "jet_sys_setpgid_raw"
    #Import(c) priv setpgrp: fn() -[Env]> (available: Bool, errno: Int, value: Int) = "jet_sys_setpgrp_raw"

    // Sets the supplementary groups to those of `user`, plus `group`.
    #Import(c) priv initgroups: fn(user: String, group: Int) -[Env]> (available: Bool, errno: Int, value: Int) = "jet_sys_initgroups_raw"

    // Sends `signal` to `pid`, and resets `signal` to its default action.
    #Import(c) priv kill: fn(pid: Int, signal: Int) -[Env]> (available: Bool, errno: Int, value: Int) = "jet_sys_kill_raw"
    #Import(c) priv reset_signal: fn(signal: Int) -[Env]> (available: Bool, errno: Int, value: Int) = "jet_sys_reset_signal_raw"

    // Waits for any child, or for `pid` with `options`: the child's id and
    // its wait status.
    #Import(c) priv wait: fn() -[Env]> (available: Bool, errno: Int, status: Int, value: Int) = "jet_sys_wait_raw"
    #Import(c) priv waitpid: fn(pid: Int, options: Int) -[Env]> (available: Bool, errno: Int, status: Int, value: Int) = "jet_sys_waitpid_raw"

    // A new pipe's read and write descriptors.
    #Import(c) priv pipe: fn() -[Env]> (available: Bool, errno: Int, read_fd: Int, value: Int, write_fd: Int) = "jet_sys_pipe_raw"

    // Makes the FIFO `path` with `mode`, and the node `path` with `mode` and
    // device `dev`.
    #Import(c) priv mkfifo: fn(path: String, mode: Int) -[Env]> (available: Bool, errno: Int, value: Int) = "jet_sys_mkfifo_raw"
    #Import(c) priv mknod: fn(path: String, mode: Int, dev: Int) -[Env]> (available: Bool, errno: Int, value: Int) = "jet_sys_mknod_raw"

    // Locks this process's memory in RAM (mlockall `flags`).
    #Import(c) priv mlockall: fn(flags: Int) -[Env]> (available: Bool, errno: Int, value: Int) = "jet_sys_mlockall_raw"

    // The scheduling policy and priority of `pid`, setting them, and its
    // round-robin interval in nanoseconds.
    #Import(c) priv sched_get: fn(pid: Int) -[Env]> (available: Bool, errno: Int, policy: Int, priority: Int) = "jet_sys_sched_get_raw"
    #Import(c) priv sched_set: fn(pid: Int, policy: Int, priority: Int) -[Env]> (available: Bool, errno: Int, value: Int) = "jet_sys_sched_set_raw"
    #Import(c) priv sched_rr_interval: fn(pid: Int) -[Env]> (available: Bool, errno: Int, value: Int) = "jet_sys_sched_rr_interval_raw"

    // The CPU-time clock of `pid` in nanoseconds, and setting the wall clock
    // to `ns` nanoseconds after the epoch.
    #Import(c) priv cpu_clock: fn(pid: Int) -[Env]> (available: Bool, errno: Int, value: Int) = "jet_sys_cpu_clock_raw"
    #Import(c) priv clock_set: fn(ns: Int) -[Env]> (available: Bool, errno: Int, value: Int) = "jet_sys_clock_set_raw"

    // The real, effective and saved user ids (`group` 0) or group ids
    // (`group` 1), and setting them (-1 keeps one).
    #Import(c) priv resid: fn(group: Int) -[Env]> (available: Bool, effective: Int, errno: Int, real: Int, saved: Int) = "jet_sys_resid_raw"
    #Import(c) priv set_resid: fn(group: Int, real: Int, effective: Int, saved: Int) -[Env]> (available: Bool, errno: Int, value: Int) = "jet_sys_set_resid_raw"
}
