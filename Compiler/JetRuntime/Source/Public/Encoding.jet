// `jet.runtime.encoding` (#6615): the runtime's public codec scope functions
// the encoding modules are built on, in Jet types, and the `priv` text and
// JSON-coercion audit calls only Core makes. Each member is a runtime binding
// (Guest.jet sema_guest_runtime_binding) of the runtime export that is its one
// body. A member with no row is pure.
encoding: module {
    // Enters the thread's text-cells scope, answering the previous one,
    // which leaving restores.
    #Import(c) text_cells_enter: fn() -> Bool = "jet_rt_codec_text_cells_enter"
    #Import(c) text_cells_leave: fn(previous: Bool) = "jet_rt_codec_text_cells_leave"

    // Enters the thread's ETF strings `mode`, answering the previous one,
    // which leaving restores.
    #Import(c) etf_strings_enter: fn(mode: Int) -> Int = "jet_rt_codec_etf_strings_enter"
    #Import(c) etf_strings_leave: fn(previous: Int) = "jet_rt_codec_etf_strings_leave"

    // The byte at `index` of `text`, read without a bound, and `bytes` as
    // text, copied without UTF-8 validation. `priv`: Core's audited
    // `core.encoding.__string_byte` and `__bytes_into_text` call them after
    // checking the bound or the encoding.
    #Import(c) priv string_byte: fn(text: String, index: U64) -> U8 = "jet_raw_string_byte"
    #Import(c) priv bytes_into_text: fn(bytes: [U8]) -> String = "jet_raw_bytes_into_text"

    // Ok when `bytes` is strict UTF-8, else the Utf8Error text. `priv`: the
    // codecs validate before they take bytes as text.
    #Import(c) priv utf8_validate: fn(bytes: [U8]) Err! = "jet_string_validate_utf8"

    // The codec streams' file I/O: the next byte (None at EOF), up to
    // `limit` bytes into `buffer` (its new length; 0 at EOF), and a write or
    // flush. Each fails with the codec's cause. `priv`: only the streaming
    // codecs call them, on the reader or writer they own.
    #Import(c) priv read_byte: fn(reader: &FileReader) -[IO]> U8? EncodingCause! = "jet_raw_encoding_read_byte"
    #Import(c) priv read_into: fn(reader: &FileReader, buffer: &[U8], limit: Int) -[IO]> Int EncodingCause! = "jet_raw_encoding_read_into"
    #Import(c) priv write_bytes: fn(writer: &FileWriter, bytes: View<U8>) -[IO]> EncodingCause! = "jet_raw_encoding_write_bytes"
    #Import(c) priv write_text: fn(writer: &FileWriter, text: String) -[IO]> EncodingCause! = "jet_raw_encoding_write_text"
    #Import(c) priv flush: fn(writer: &FileWriter) -[IO]> EncodingCause! = "jet_raw_encoding_flush"

    // The untyped JSON decoder's coercion audit: the wall clock in ms since
    // the epoch, and one line on stderr. `priv`: only core.encoding.json calls
    // them, inside its audited `#Unsafe` regions, which keep this hidden
    // clock read and stderr write out of `decode`'s effect row.
    #Import(c) priv coerce_now: fn() -> Int = "jet_raw_json_coerce_now"
    #Import(c) priv coerce_emit: fn(line: String) = "jet_raw_json_coerce_emit"
}
