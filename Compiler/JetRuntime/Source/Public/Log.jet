// `jet.runtime.log` (#6615): the runtime's public logging cells and sinks,
// in Jet types with their declared effect rows. Each member is a runtime
// binding (Guest.jet sema_guest_runtime_binding) of the runtime export that is
// its one body; the cells are the calling thread's (RouteALog.jet). A tuple
// result's items cross in the checked tuple's label-sorted order, which is the
// export's slot order. A LogSpan or LogField crosses as a runtime record made
// for the call. A member with no row is pure.
log: module {
    // The thread's level cell.
    #Import(c) level_load: fn() -[Log]> Int = "jet_log_level_load"
    #Import(c) level_store: fn(level: Int) -[Log]> = "jet_log_level_store"

    // The thread's disabled cell.
    #Import(c) disabled_load: fn() -[Log]> Bool = "jet_log_disabled_load"
    #Import(c) disabled_store: fn(disabled: Bool) -[Log]> = "jet_log_disabled_store"

    // The thread's format cell (a byte).
    #Import(c) format_store: fn(format: Int) -[Log]> = "jet_log_format_store"

    // The thread's file sink path; "" is none.
    #Import(c) sink_store: fn(path: String) -[Log]> = "jet_log_sink_store"

    // The thread's sampling cells: every how many records, and the count.
    #Import(c) sample_store: fn(every: Int) -[Log]> = "jet_log_sample_store"
    #Import(c) sample_count_store: fn(count: Int) -[Log]> = "jet_log_sample_count_store"

    // The configured filter `which` names: 0 the package's, 1 JET_LOG's, 2
    // the flag's; "" when unset.
    #Import(c) config_load: fn(which: Int) -[Log]> String = "jet_log_config_load"

    // The thread's filter cell; "" is none.
    #Import(c) filter_load: fn() -[Log]> String = "jet_log_filter_load"
    #Import(c) filter_store: fn(filter: String) -[Log]> = "jet_log_filter_store"

    // The thread's trace id cell, a copy of `id`.
    #Import(c) trace_store: fn(id: String) -[Log]> = "jet_ring_log_set_trace_id"

    // Flushes stderr and the file sink.
    #Import(c) flush: fn() -[Log]> = "jet_ring_log_flush"

    // Flushes stdout and exits the process with `code`.
    #Import(c) process_exit: fn(code: Int) -[Log]> = "jet_log_process_exit"

    // The thread's next span id and its copy of `name`.
    #Import(c) span_allocate: fn(name: String) -[Log]> (id: Int, name: String) = "jet_log_span_allocate_raw"

    // Pushes a copy of `span` on the thread's active span stack, and pops the
    // innermost entry with the id of `span`. `priv`: only Core calls them
    // (`log.enter`, `log.close`).
    #Import(c) priv span_enter: fn(span: LogSpan) -[Log]> = "jet_ring_log_enter"
    #Import(c) priv span_close: fn(span: LogSpan) -[Log]> = "jet_ring_log_close"

    // Emits the record `message` at the level named `level` with `fields`
    // to the thread's sinks, unless logging is off or sampled out. `priv`:
    // only Core calls it, after its level and filter checks.
    #Import(c) priv record_emit: fn(level: String, message: String, fields: [LogField]) -[Log]> = "jet_log_record_emit_raw"

    // Publishes the metric `name` at `value` to the installed event sinks.
    #Import(c) metric_publish: fn(name: String, value: Int) = "jet_log_publish_metric"
}
