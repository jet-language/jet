// `jet.runtime.testing` (#6615): the running test's report cell and text
// window that core.testing is built on, its evidence file reads and
// temporary directories, a deterministic World's own store cells, and the
// World handle's clock, timers and history, in Jet types. Each
// member is a runtime binding (Guest.jet sema_guest_runtime_binding) of the
// runtime export that is its one body (RouteTesting.jet, World.jet). Each is
// `priv`: only Core calls them.
testing: module {
    // Records the running test's failure `message` with its `detail`.
    #Import(c) priv record_failure: fn(message: String, detail: String) = "jet_testing_record_failure"

    // Clears the running test's recorded failure.
    #Import(c) priv clear_failure: fn() = "jet_testing_clear_failure"

    // Marks the running test skipped; `line` joins its output.
    #Import(c) priv skip: fn(line: String) = "jet_testing_skip"

    // The bytes `start..<end` of `text`.
    #Import(c) priv text_window: fn(text: String, start: U64, end: U64) -> String = "jet_testing_text_window_raw"

    // A new Prelude `Test` holding the harness's current iteration and result.
    #Import(c) priv suite_snapshot: fn() -> Test = "jet_test_suite_new"

    // The active World's bytes for the Core store named `store`, empty until
    // first replaced; None outside a World.
    #Import(c) priv world_store_load: fn(store: String) -> [U8]? = "jet_rt_world_store_load"

    // Whether the active World's `store` still held `expected` and now holds
    // `replacement`; None outside a World.
    #Import(c) priv world_store_replace: fn(store: String, expected: [U8], replacement: [U8]) -> Bool? = "jet_rt_world_store_replace"

    // The DeterministicWorld runner and its methods' leaves
    // (Core/Testing/Testing.jet): a run of `body` once in a fresh World that
    // ends when the World's tasks are idle, the world's wall clock in Unix
    // milliseconds, a move of its clock by `duration_ns` that fires the timers
    // due on the way and answers the new wall clock, a wait until its tasks
    // are idle, and its event history.
    #Import(c) priv world: fn(body: fn(DeterministicWorld)) = "jet_testing_world_run"

    #Import(c) priv world_now: fn(world: DeterministicWorld) -> Int = "jet_world_now"

    #Import(c) priv world_advance: fn(world: DeterministicWorld, duration_ns: Int) -> Int = "jet_world_advance"

    #Import(c) priv world_wait_idle: fn(world: DeterministicWorld) = "jet_world_wait_idle"

    #Import(c) priv world_history: fn(world: DeterministicWorld) -> String = "jet_world_history"

    // The test harness's evidence file reads and temporary directories
    // (RouteTesting.jet), each answered as its jet_builtins record.
    #Import(c) priv evidence_read: fn(path: String) -> EvidenceRead = "jet_testing_evidence_read_raw"

    #Import(c) priv temp_facts: fn() -> TempFacts = "jet_testing_temp_facts_raw"

    #Import(c) priv temp_join: fn(name: String) -> TempPath = "jet_testing_temp_join_raw"

    #Import(c) priv temp_remove: fn(path: [U8]) -> TempRemove = "jet_testing_temp_remove_raw"

    #Import(c) priv temp_create: fn(path: [U8]) -> TempCreate = "jet_testing_temp_create_raw"
}
