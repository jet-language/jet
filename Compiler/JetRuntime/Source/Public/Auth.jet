// `jet.runtime.auth` (#6615): the byte cell of core.auth's session store, in
// Jet types with the DB effect. Each member is a runtime binding (Guest.jet
// sema_guest_runtime_binding) of the runtime export that is its one body
// (RouteACore.jet). Each is `priv`: only core.auth calls them; every session
// rule is core.auth's Jet source.
auth: module {
    // The cell's current bytes.
    #Import(c) priv store_load: fn() -[DB]> [U8] = "jet_auth_store_load"

    // Whether the cell still held `expected` and now holds `replacement`.
    #Import(c) priv store_replace: fn(expected: [U8], replacement: [U8]) -[DB]> Bool = "jet_auth_store_replace"
}
