// `jet.runtime.tui` (#6615): the environment read core.tui's capability
// detection runs, in Jet types. The member is a runtime binding (Guest.jet
// sema_guest_runtime_binding) of the runtime export that is its one body
// (RouteACore.jet). It is `priv`: only core.tui calls it.
tui: module {
    // The encoded OS bytes of the environment variable `name`, None when it
    // is unset; no UTF-8 is assumed.
    #Import(c) priv cap_env_bytes: fn(name: String) -> [U8]? = "jet_tui_cap_env_bytes"
}
