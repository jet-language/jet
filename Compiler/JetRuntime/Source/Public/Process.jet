// `jet.runtime.process` (#6615): the runtime's public signal subscription
// functions, in Jet types with their declared effect rows. Each member is a
// runtime binding (Guest.jet sema_guest_runtime_binding) of the runtime
// export that is its one body (ProcessSignal.jet). A tuple result's items
// cross in the checked tuple's label-sorted order, which is the export's slot
// order.
process: module {
    // A subscription holding no signal yet, with its own channel; its id. An
    // on_signal subscription (`cancels_root`) cancels the root task.
    #Import(c) signal_open: fn(cancels_root: Bool) -[Exec]> Int = "jet_process_signal_open_raw"

    // Closes the subscription `id`: each signal it was the last holder of
    // gets its saved action back, and its receivers end.
    #Import(c) signal_close: fn(id: Int) -[Exec]> = "jet_process_signal_close_raw"

    // Sets the signal `number` to be ignored, or to its default action, when
    // no subscription holds it, as a sample: `disposition` is 0 when set and
    // -1 when not, with its `errno` (EBUSY while a subscription holds the
    // signal, EINVAL for one no handler can catch).
    #Import(c) signal_disposition: fn(number: Int, ignore: Bool) -[Exec]> (available: Bool, disposition: Int, errno: Int) = "jet_process_signal_disposition_raw"
}
