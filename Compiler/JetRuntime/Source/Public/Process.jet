// `jet.runtime.process` (#6615): the runtime's public signal subscription
// functions, the program's argv and its exit, and core.process's spec,
// status and child-stream leaves, in Jet types with their declared effect
// rows. Each member is a runtime binding (Guest.jet
// sema_guest_runtime_binding) of the runtime export that is its one body
// (ProcessSignal.jet, HostStartup.jet, HostProcess.jet, ProcessPipeline.jet,
// ProcessSpec.jet, CompilerHost.jet, HostPipe.jet).
// A tuple result's items cross in the checked tuple's written order,
// which is the export's slot order.
process: module {
    // A subscription holding no signal yet, with its own channel; its id. An
    // on_signal subscription (`cancels_root`) cancels the root task.
    #Import(c) signal_open: fn(cancels_root: Bool) -[Exec]> Int = "jet_process_signal_open_raw"

    // Closes the subscription `id`: each signal it was the last holder of
    // gets its saved action back, and its receivers end.
    #Import(c) signal_close: fn(id: Int) -[Exec]> = "jet_process_signal_close_raw"

    // Sets the signal `number` to be ignored, or to its default action, when
    // no subscription holds it, as a sample: `disposition` is 0 when set and
    // -1 when not, with its `errno` (EBUSY while a subscription holds the
    // signal, EINVAL for one no handler can catch).
    #Import(c) signal_disposition: fn(number: Int, ignore: Bool) -[Exec]> {available: Bool, disposition: Int, errno: Int} = "jet_process_signal_disposition_raw"

    // Subscription `id` also holds signal `number`, sent to its receivers as
    // the ProcessSignal `signal`, as a sample: `value` is -1 when it does not
    // hold it, with its `errno` (EINVAL for an unknown subscription or a
    // signal no handler can catch). `priv`: only core.process subscribes.
    #Import(c) priv signal_add: fn(id: Int, number: Int, signal: ProcessSignal) -[Exec]> {available: Bool, value: Int, errno: Int} = "jet_process_signal_add_raw"

    // One more receiver of subscription `id`'s channel; of an already closed,
    // empty channel when `id` is closed. `priv`: only core.process subscribes.
    #Import(c) priv signal_receiver: fn(id: Int) -[Exec]> Receiver<ProcessSignal> = "jet_process_signal_receiver_raw"

    // The program's words, argv[0] first; a non-UTF-8 word panics. `priv`:
    // only Core reads it (`process.args()` drops the program name), and a
    // user call is E0605.
    #Import(c) priv argv: fn() -[Exec.Args]> [String] = "jet_std_io_args"

    // Ends the process with exactly `code`, after the exit handlers. `priv`:
    // only Core calls it (`process.exit` maps a program's 101 to 1 first, and
    // `process.exit_unmapped` is the audited unmapped exit).
    #Import(c) priv exit: fn(code: Int) -[Exec.Exit]> = "jet_std_process_exit"

    // Runs `steps` as one pipeline, each step's stdout feeding the next
    // step's stdin, and answers its receipt. `priv`: only Core calls it
    // (`process.pipeline`).
    #Import(c) priv pipeline: fn(steps: [ProcessSpec]) -[Exec]> ProcessReceipt IOError! = "jet_std_process_pipeline"

    // The exit status text of the finished child `pid`, None when this
    // process holds none for it. `priv`: only Core calls these.
    #Import(c) priv exit_status: fn(pid: Int) -[Exec]> String? = "jet_process_exit_status_raw"

    // Takes `spec` and answers it marked so its child gets SIGKILL when this
    // process dies (Linux PR_SET_PDEATHSIG; ProcessSpec.jet).
    #Import(c) priv spec_parent_death: fn(spec: ^^ProcessSpec) -[Exec]> ProcessSpec = "jet_process_spec_parent_death"

    // Takes `spec` and answers it passing its child a duplicate of the
    // descriptor `fd` at `child_fd`, as its working directory when `as_cwd`
    // (ProcessRoutes.jet): `assigned_fd` is the parent's duplicate, or -1
    // with the failed duplication's `errno`, or with `errno` 0 for a slot
    // out of range or one the spec already passes. `available` is false
    // on a host that can't duplicate.
    #Import(c) priv keep_open_raw: fn(spec: ^^ProcessSpec, fd: Int, child_fd: Int, as_cwd: Bool) -[FS.Read]> {spec: ProcessSpec, available: Bool, assigned_fd: Int, errno: Int} = "jet_process_spec_keep_open_raw"

    // A new spec of every field of a plan (ProcessRoutes.jet): `cmd` with
    // each optional field present when its `has_` flag is set. The
    // environment columns `names` and `values` pair up, so they have equal
    // length.
    #Import(c) priv spec_fields: fn(cmd: [String], has_cwd: Bool, cwd: String, env_clear: Bool, names: [String], values: [String], removals: [String], has_stdin: Bool, stdin: ProcessStreamMode, stdout: ProcessStreamMode, stderr: ProcessStreamMode, has_timeout: Bool, timeout: Int, has_output: Bool, output: Int, has_cpu: Bool, cpu: Int, has_memory: Bool, memory: Int, has_files: Bool, files: Int, detached: Bool, has_terminal: Bool, terminal: TerminalPolicy, has_policy: Bool, policy: String) -[Exec]> ProcessSpec = "jet_process_spec_fields_raw"

    // The spec builders (ProcessSpec.jet): each takes `spec` and answers it
    // with one setting changed. `spec_args_extend` and `spec_cpu_affinity`
    // append to the argv and the CPU set; `spec_env_clear` starts the child
    // from an empty environment; `spec_under` bounds the child by
    // `authority`; `spec_stdin`, `spec_stdout` and `spec_stderr` route a
    // stream; `spec_timeout` and `spec_cpu_time_limit` take a Duration's ns
    // and keep its whole milliseconds, a negative one as 0.
    #Import(c) priv spec_cwd: fn(spec: ^^ProcessSpec, path: String) -> ProcessSpec = "jet_process_spec_cwd"

    #Import(c) priv spec_arg: fn(spec: ^^ProcessSpec, extra: String) -> ProcessSpec = "jet_process_spec_arg"

    #Import(c) priv spec_args_extend: fn(spec: ^^ProcessSpec, extra: [String]) -> ProcessSpec = "jet_process_spec_args_extend"

    #Import(c) priv spec_env: fn(spec: ^^ProcessSpec, name: String, value: String) -> ProcessSpec = "jet_process_spec_env"

    #Import(c) priv spec_env_remove: fn(spec: ^^ProcessSpec, name: String) -> ProcessSpec = "jet_process_spec_env_remove"

    #Import(c) priv spec_env_clear: fn(spec: ^^ProcessSpec) -> ProcessSpec = "jet_process_spec_env_clear"

    #Import(c) priv spec_output_limit: fn(spec: ^^ProcessSpec, limit: Int) -> ProcessSpec = "jet_process_spec_output_limit"

    #Import(c) priv spec_memory_limit: fn(spec: ^^ProcessSpec, limit: Int) -> ProcessSpec = "jet_process_spec_memory_limit"

    #Import(c) priv spec_memory_scope: fn(spec: ^^ProcessSpec, bytes: Int) -> ProcessSpec = "jet_process_spec_memory_scope"

    #Import(c) priv spec_open_file_limit: fn(spec: ^^ProcessSpec, limit: Int) -> ProcessSpec = "jet_process_spec_open_file_limit"

    #Import(c) priv spec_cpu_affinity: fn(spec: ^^ProcessSpec, cpus: [Int]) -> ProcessSpec = "jet_process_spec_cpu_affinity"

    #Import(c) priv spec_io_priority: fn(spec: ^^ProcessSpec, level: Int) -> ProcessSpec = "jet_process_spec_io_priority"

    #Import(c) priv spec_io_idle: fn(spec: ^^ProcessSpec) -> ProcessSpec = "jet_process_spec_io_idle"

    #Import(c) priv spec_detached: fn(spec: ^^ProcessSpec) -> ProcessSpec = "jet_process_spec_detached"

    #Import(c) priv spec_terminal: fn(spec: ^^ProcessSpec) -> ProcessSpec = "jet_process_spec_terminal"

    #Import(c) priv spec_terminal_with_policy: fn(spec: ^^ProcessSpec, policy: TerminalPolicy) -> ProcessSpec = "jet_process_spec_terminal_with_policy"

    #Import(c) priv spec_under: fn(spec: ^^ProcessSpec, authority: Authority) -> ProcessSpec = "jet_std_process_spec_under"

    #Import(c) priv spec_stdin: fn(spec: ^^ProcessSpec, mode: ProcessStreamMode) -> ProcessSpec = "jet_process_spec_stdin"

    #Import(c) priv spec_stdout: fn(spec: ^^ProcessSpec, mode: ProcessStreamMode) -> ProcessSpec = "jet_process_spec_stdout"

    #Import(c) priv spec_stderr: fn(spec: ^^ProcessSpec, mode: ProcessStreamMode) -> ProcessSpec = "jet_process_spec_stderr"

    #Import(c) priv spec_timeout: fn(spec: ^^ProcessSpec, nanos: Int) -> ProcessSpec = "jet_process_spec_timeout"

    #Import(c) priv spec_cpu_time_limit: fn(spec: ^^ProcessSpec, nanos: Int) -> ProcessSpec = "jet_process_spec_cpu_time_limit"

    // The launch steps of a spec (ProcessExecutionRoutes.jet). `spec_plan`
    // resolves the spec without starting it; `spec_run` runs it to its
    // receipt, and `spec_run_checked` also fails on a nonzero exit;
    // `spec_spawn` starts it and answers the running child.
    #Import(c) priv spec_plan: fn(spec: ProcessSpec) -> ProcessPlan IOError! = "jet_process_spec_plan"

    #Import(c) priv spec_run: fn(spec: ProcessSpec) -[Exec]> ProcessReceipt IOError! = "jet_process_spec_run"

    #Import(c) priv spec_run_checked: fn(spec: ProcessSpec) -[Exec]> ProcessReceipt IOError! = "jet_process_spec_run_checked"

    #Import(c) priv spec_spawn: fn(spec: ProcessSpec) -[Exec]> ProcessChild IOError! = "jet_process_spec_spawn"

    // A spawned child's steps (ProcessExecutionRoutes.jet,
    // ProcessExecutionCollect.jet): its process id; waiting for its receipt;
    // whether it has exited, without waiting; and the SIGKILL, SIGTERM and
    // SIGINT its process group gets (a finished child takes them as done).
    #Import(c) priv child_id: fn(child: ProcessChild) -> Int = "jet_process_child_id"

    #Import(c) priv child_wait: fn(child: ProcessChild) -[Exec]> ProcessReceipt IOError! = "jet_process_child_wait"

    #Import(c) priv child_exited: fn(child: ProcessChild) -[Exec]> Bool IOError! = "jet_process_child_exited"

    #Import(c) priv child_kill: fn(child: ProcessChild) -[Exec]> IOError! = "jet_process_child_kill"

    #Import(c) priv child_terminate: fn(child: ProcessChild) -[Exec]> IOError! = "jet_process_child_terminate"

    #Import(c) priv child_interrupt: fn(child: ProcessChild) -[Exec]> IOError! = "jet_process_child_interrupt"

    // One line of a child's output or error output as its raw bytes, the
    // newline kept; empty at the end of input (HostPipe.jet). Core's line
    // readers decode it.
    #Import(c) priv stdout_line_bytes: fn(stream: ProcessStdoutStream) -[Exec, Time.Wait]> [U8] IOError! = "jet_process_stream_line_bytes_raw"

    #Import(c) priv stderr_line_bytes: fn(stream: ProcessStderrStream) -[Exec, Time.Wait]> [U8] IOError! = "jet_process_stream_line_bytes_raw"
}
