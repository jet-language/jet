// `jet.runtime.process` (#6615): the runtime's public signal subscription
// functions, the program's argv and its exit, in Jet types with their declared
// effect rows. Each member is a runtime binding (Guest.jet
// sema_guest_runtime_binding) of the runtime export that is its one body
// (ProcessSignal.jet, HostStartup.jet, HostProcess.jet, ProcessPipeline.jet).
// A tuple result's items cross in the checked tuple's written order,
// which is the export's slot order.
process: module {
    // A subscription holding no signal yet, with its own channel; its id. An
    // on_signal subscription (`cancels_root`) cancels the root task.
    #Import(c) signal_open: fn(cancels_root: Bool) -[Exec]> Int = "jet_process_signal_open_raw"

    // Closes the subscription `id`: each signal it was the last holder of
    // gets its saved action back, and its receivers end.
    #Import(c) signal_close: fn(id: Int) -[Exec]> = "jet_process_signal_close_raw"

    // Sets the signal `number` to be ignored, or to its default action, when
    // no subscription holds it, as a sample: `disposition` is 0 when set and
    // -1 when not, with its `errno` (EBUSY while a subscription holds the
    // signal, EINVAL for one no handler can catch).
    #Import(c) signal_disposition: fn(number: Int, ignore: Bool) -[Exec]> (available: Bool, disposition: Int, errno: Int) = "jet_process_signal_disposition_raw"

    // The program's words, argv[0] first; a non-UTF-8 word panics. `priv`:
    // only Core reads it (`process.args()` drops the program name), and a
    // user call is E0605.
    #Import(c) priv argv: fn() -[Exec.Args]> [String] = "jet_std_io_args"

    // Ends the process with exactly `code`, after the exit handlers. `priv`:
    // only Core calls it (`process.exit` maps a program's 101 to 1 first, and
    // `process.exit_unmapped` is the audited unmapped exit).
    #Import(c) priv exit: fn(code: Int) -[Exec.Exit]> = "jet_std_process_exit"

    // Runs `steps` as one pipeline, each step's stdout feeding the next
    // step's stdin, and answers its receipt. `priv`: only Core calls it
    // (`process.pipeline`).
    #Import(c) priv pipeline: fn(steps: [ProcessSpec]) -[Exec]> ProcessReceipt IOError! = "jet_std_process_pipeline"
}
