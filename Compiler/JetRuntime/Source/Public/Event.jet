// `jet.runtime.event` (#6615): the provider constructors core.event composes,
// in Jet types. Each member is a runtime binding (Guest.jet
// sema_guest_runtime_binding) of the runtime export that is its one body
// (Events.jet). Each is `priv`: only core.event calls them.
event: module {
    // A new event scope.
    #Import(c) priv scope_new: fn() -> EventScope = "jet_event_scope_new"

    // The synchronous dispatch policy.
    #Import(c) priv policy_sync: fn() -> EventPolicy = "jet_event_policy_sync"
}
