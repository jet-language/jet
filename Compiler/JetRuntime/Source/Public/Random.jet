// `jet.runtime.random` (#6615): the ambient deterministic stream core.math.random
// draws from, in Jet types with its `Rand` effect row. Each member is a
// runtime binding (Guest.jet sema_guest_runtime_binding) of the runtime
// export that is its one body (RouteAMath.jet). Each is `priv`: only
// core.math.random calls them; Jet owns the xorshift transition.
random: module {
    // Installs `seed` as the stream state.
    #Import(c) priv seed: fn(seed: Int) -[Rand]> = "jet_std_random_seed"

    // The stream's current state word.
    #Import(c) priv rng_state: fn() -[Rand]> U64 = "jet_random_state_raw"

    // Replaces the state with `replacement` when it still holds `expected`.
    #Import(c) priv rng_try_update: fn(expected: U64, replacement: U64) -[Rand]> Bool = "jet_random_try_update_raw"
}
