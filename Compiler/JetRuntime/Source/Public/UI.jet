// `jet.runtime.ui` (#6615): the UI host provider's primitives (core.ui.host)
// and core.ui's native window and web page hooks, in Jet types. Each member
// is a runtime binding (Guest.jet sema_guest_runtime_binding) of the runtime
// export that is its one body (UiHostProvider.jet, UIBackends.jet). Each is
// `priv`: only core.ui.host and core.ui call them, but for `clipboard_set`,
// `save_file`, `device` and `device_bytes`, which the app module calls, and
// the core.ui.host function that reaches a capability's service carries its
// `UI.<capability>` requirement (`#Builtin.Needs("UI.<capability>")` on its
// Core declaration, E2937). Each reads or writes the provider's or the
// window's live state, so each is run-time only (RUNTIME_ONLY_READS): the
// compiler never computes one while building, where its answer would stand
// in for every run's clipboard, events, dialogs, saved files, device answers
// and scene.
ui: module {
    // Whether the provider has the capability with code `code`
    // (core.ui.host's provider capability codes).
    #Import(c) priv capability: fn(code: Int) -> Bool = "jet_ui_host_capability"

    // The clipboard's text, None when the provider has none; whether the
    // provider wrote `text`.
    #Import(c) priv clipboard_get: fn() -> String? = "jet_ui_host_clipboard_get"

    #Import(c) priv clipboard_set: fn(text: String) -> Bool = "jet_ui_host_clipboard_set"

    // The next raw event of queue `queue`, None when it is empty.
    #Import(c) priv event_pop: fn(queue: Int) -> String? = "jet_ui_host_event_pop"

    // Whether the provider claimed the key `claim` for the shortcut queue.
    #Import(c) priv key_claim: fn(claim: String) -> Bool = "jet_ui_host_key_claim"

    // A dialog's token for the request record `request` (negative when the
    // provider refuses it), and the dialog's result record.
    #Import(c) priv dialog_request: fn(kind: Int, request: String) -> Int = "jet_ui_host_dialog_request"

    #Import(c) priv dialog_result: fn(token: Int) -> String? = "jet_ui_host_dialog_result"

    // Whether the provider handed the file `name`, of media type `media`
    // and holding `bytes`, to the person to save: a page downloads it. Only
    // app.save_file calls it.
    #Import(c) priv save_file: fn(name: String, media: String, bytes: [U8]) -> Bool = "jet_ui_host_save_file"

    // The provider's answer to the app's device request `request` of kind
    // `kind` (JetWeb Host.jet deviceRequest names the kinds), None when it
    // has none. A page's browser answers later; the program waits for the
    // answer where its entry can wait.
    #Import(c) priv device: fn(kind: Int, request: String) -> String? = "jet_ui_host_device"

    // `device` for a request whose answer is bytes (3: a part of a file the
    // provider holds for the app).
    #Import(c) priv device_bytes: fn(kind: Int, request: String) -> [U8]? = "jet_ui_host_device_bytes"

    // Whether a web page attached, and keeps a copy of `scene` as its latest
    // scene (core.ui's web backend).
    #Import(c) priv web_attached: fn() -[Browser]> Bool = "jet_ui_web_attached"

    #Import(c) priv web_scene: fn(scene: String) -[Browser]> = "jet_ui_web_scene"

    // A native window's click on slot `id`, drop of one item of `kind` on a
    // text input, and typing in a text input: each runs the handler the slot
    // keeps, as a web page's does. An unknown id does nothing.
    #Import(c) priv click: fn(id: Int) = "jet_ui_click"

    #Import(c) priv drop: fn(id: Int, kind: Int, text: String) = "jet_ui_drop"

    #Import(c) priv change: fn(id: Int, text: String) = "jet_ui_change"
}
