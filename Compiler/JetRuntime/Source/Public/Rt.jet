// `jet.runtime.rt` (#6615): the start, observations and cancellation of a
// core.rt realtime callback stream, in Jet types, the coded and the
// arithmetic stop of a Core library, and core.game's frame loop. Each member
// is a runtime binding (Guest.jet sema_guest_runtime_binding) of the runtime
// export that is its one body (Realtime.jet, Trap.jet, RouteAMath.jet,
// Game.jet). Each is `priv`: only Core calls them.
rt: module {
    // Starts a stream that calls `callback` with each buffer of
    // `frames_per_buffer` frames at `rate_hz`; the stream holds the callback
    // until it ends.
    #Import(c) priv callback: fn(rate_hz: Int, frames_per_buffer: Int, callback: fn([Float]) -[]>) -> RealtimeStream = "jet_rt_callback_start"

    // The stream's completed-callback facts.
    #Import(c) priv receipt: fn(stream: RealtimeStream) -> RealtimeReceipt = "jet_rt_receipt"

    // Cancels the stream and joins its worker.
    #Import(c) priv cancel: fn(stream: ^RealtimeStream) = "jet_rt_cancel"

    // Whether the stream is canceled.
    #Import(c) priv is_canceled: fn(stream: RealtimeStream) -> Bool = "jet_rt_is_canceled"

    // When the stream's next callback is due.
    #Import(c) priv next_deadline: fn(stream: RealtimeStream) -> Instant = "jet_rt_next_deadline"

    // Stops the program with the registered row `code`: `message` renders
    // the row's `what`, and the runtime adds the row's Why/Fix and gives
    // the stop its exit status.
    #Import(c) priv coded_stop: fn(code: String, message: String) -> Never = "jet_rt_coded_stop"

    // Stops the program with the E3010 arithmetic stop and `message`, as an
    // exact or lane operation that has no answer does (core.math
    // __numeric_stop).
    #Import(c) priv numeric_stop: fn(message: String) -> Never = "jet_numeric_stop"

    // Runs `scene`'s frame loop and returns its transcript (core.game run):
    // `replay` feeds its recorded input, `backend` presents the frames
    // (headless when absent), and `frames`, when given, is the positive
    // frame budget whose transcript ends with the run's hash.
    #Import(c) priv game_run: fn(scene: GameScene, replay: GameReplay?, backend: GameBackend?, frames: Int?) -> String = "jet_game_run"
}
