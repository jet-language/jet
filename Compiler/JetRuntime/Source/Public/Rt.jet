// `jet.runtime.rt` (#6615): the observations and cancellation of a core.rt
// realtime callback stream, in Jet types. Each member is a runtime binding
// (Guest.jet sema_guest_runtime_binding) of the runtime export that is its one
// body (Realtime.jet). Each is `priv`: only core.rt calls them.
rt: module {
    // The stream's completed-callback facts.
    #Import(c) priv receipt: fn(stream: RealtimeStream) -> RealtimeReceipt = "jet_rt_receipt"

    // Cancels the stream and joins its worker.
    #Import(c) priv cancel: fn(stream: &RealtimeStream) = "jet_rt_cancel"

    // Whether the stream is cancelled.
    #Import(c) priv is_cancelled: fn(stream: RealtimeStream) -> Bool = "jet_rt_is_cancelled"
}
