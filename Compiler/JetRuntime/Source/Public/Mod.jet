// `jet.runtime.mod` (#6615): the loader-context steps core.mod's `load`
// sequences, in Jet types with their effect rows. Each member is a runtime
// binding (Guest.jet sema_guest_runtime_binding) of the runtime export that is
// its one body (RouteMod.jet). Each is `priv`: only core.mod calls them. A
// context is the Int key `read_context` returns; a refusal's message is
// `<Case>: <reason>`, except the header parser's.
mod: module {
    // Whether this target loads compiled modules, and the target's OS name:
    // facts of the runtime the program runs on, so each is run-time only
    // (RUNTIME_ONLY_READS) and no build computes the compiler's own answer.
    #Import(c) priv supported: fn() -> Bool = "jet_mod_supported_raw"
    #Import(c) priv os: fn() -> String = "jet_mod_os_raw"

    // Reads the library at `path` under the grant's read roots into a new
    // context.
    #Import(c) priv read_context: fn(path: String, roots: [String]) -[FS]> Int Err! = "jet_mod_read_context_raw"

    // Closes the context and removes its staged bytes.
    #Import(c) priv close_context: fn(id: Int) -[Exec]> = "jet_mod_close_context_raw"

    // Parses the context's header.
    #Import(c) priv parse_context: fn(id: Int) Err! = "jet_mod_parse_context_raw"

    // Checks the parsed identity, metadata and ABI.
    #Import(c) priv check_context: fn(id: Int) Err! = "jet_mod_check_context_raw"

    // The library name the header records.
    #Import(c) priv context_name: fn(id: Int) -> String = "jet_mod_context_name_raw"

    // Whether the payload matches the header's content digest.
    #Import(c) priv context_digest: fn(id: Int) -> Bool = "jet_mod_context_digest_raw"

    // Stages the payload to a file.
    #Import(c) priv stage_context: fn(id: Int) -[FS]> Err! = "jet_mod_stage_context_raw"

    // Maps the staged payload.
    #Import(c) priv open_context: fn(id: Int) -[Exec]> Err! = "jet_mod_open_context_raw"

    // The header's export `index`.
    #Import(c) priv export_info: fn(id: Int, index: Int) -> (name: String, symbol: String, text: Bool) = "jet_mod_export_info_raw"

    // How many exports the header names.
    #Import(c) priv exports_count: fn(id: Int) -> Int = "jet_mod_exports_count_raw"

    // Resolves the mapped payload's export `index`.
    #Import(c) priv resolve_export: fn(id: Int, index: Int) -[Exec]> Err! = "jet_mod_resolve_export_raw"

    // Resolves the mapped payload's symbol `symbol`.
    #Import(c) priv resolve_symbol: fn(id: Int, symbol: String) -[Exec]> Err! = "jet_mod_resolve_symbol_raw"

    // The loaded module; the context keeps no staged path.
    #Import(c) priv finish_context: fn(id: Int) -> Mod = "jet_mod_finish_context_raw"
}
