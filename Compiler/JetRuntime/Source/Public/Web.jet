// `jet.runtime.web` (#6615): app's live publish, in Jet types. The member
// is a runtime binding (Guest.jet sema_guest_runtime_binding) of the runtime
// export that is its one body (WsRoutes.jet). It is `priv`: only Core calls
// it; the live registry and its rules are app's Jet source (Core/App/App.jet).
web: module {
    // `event` becomes `topic`'s latest and goes to every joined connection.
    #Import(c) priv live_publish: fn(topic: String, event: String) = "jet_web_live_publish"
}
