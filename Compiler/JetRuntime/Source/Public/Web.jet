// `jet.runtime.web` (#6615): app's live publish and leave signal and the
// device store, in Jet types. Each member is a runtime binding (Guest.jet
// sema_guest_runtime_binding) of the runtime export that is its one body
// (WsRoutes.jet, World.jet). They are `priv`: only Core calls them; the live
// registry, the notice list and the write queue are app's Jet source
// (Core/App/App.jet).
web: module {
    // `event` becomes `topic`'s latest and goes to every joined connection.
    #Import(c) priv live_publish: fn(topic: String, event: String) = "jet_web_live_publish"

    // The topics whose last watching connection closed since the last call,
    // one per line ("" when none); each is given once.
    #Import(c) priv live_left: fn() -> String = "jet_web_live_left"

    // The device's bytes for the Core store named `store`, kept across
    // restarts under the entry package's name, empty until first replaced;
    // None when the program has no device store.
    #Import(c) priv device_load: fn(store: String) -> [U8]? = "jet_rt_device_load"

    // Whether the device's `store` still held `expected` and now holds
    // `replacement`, written through to the device; None when the program has
    // no device store.
    #Import(c) priv device_replace: fn(store: String, expected: [U8], replacement: [U8]) -> Bool? = "jet_rt_device_replace"
}
