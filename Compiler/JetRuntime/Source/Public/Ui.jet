// `jet.runtime.ui` (#6615): the UI host provider's primitives (core.ui.host),
// in Jet types. Each member is a runtime binding (Guest.jet
// sema_guest_runtime_binding) of the runtime export that is its one body
// (UiHostProvider.jet). Each is `priv`: only core.ui.host calls them, and the
// core.ui.host function that reaches a capability's service carries its
// `UI.<capability>` requirement (Compiler/Prelude/Core.jet
// `.with_ui_capabilities`, E2937).
ui: module {
    // Whether the provider has the capability with code `code`
    // (core.ui.host UICapability order).
    #Import(c) priv capability: fn(code: Int) -> Bool = "jet_ui_host_capability"

    // The clipboard's text, None when the provider has none; whether the
    // provider wrote `text`.
    #Import(c) priv clipboard_get: fn() -> String? = "jet_ui_host_clipboard_get"
    #Import(c) priv clipboard_set: fn(text: String) -> Bool = "jet_ui_host_clipboard_set"

    // The next raw event of queue `queue`, None when it is empty.
    #Import(c) priv event_pop: fn(queue: Int) -> String? = "jet_ui_host_event_pop"

    // Whether the provider claimed the key `claim` for the shortcut queue.
    #Import(c) priv key_claim: fn(claim: String) -> Bool = "jet_ui_host_key_claim"

    // A dialog's token for the request record `request` (negative when the
    // provider refuses it), and the dialog's result record.
    #Import(c) priv dialog_request: fn(kind: Int, request: String) -> Int = "jet_ui_host_dialog_request"
    #Import(c) priv dialog_result: fn(token: Int) -> String? = "jet_ui_host_dialog_result"
}
