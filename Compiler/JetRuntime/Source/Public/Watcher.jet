// `jet.runtime.watcher` (#6615): the watch handles core.watcher reaches, in Jet
// types with their effect rows. Each member is a runtime binding (Guest.jet
// sema_guest_runtime_binding) of the runtime export that is its one body
// (RouteWatcher.jet). Each is `priv`: only core.watcher calls them.
watcher: module {
    // A watch of the file or directory at `path`, of the process `pid`
    // (whose liveness it only probes), and of the TCP port `port` on `host`.
    #Import(c) priv files: fn(path: String) -[FS]> WatchHandle IOError! = "jet_watcher_files"
    #Import(c) priv process_pid: fn(pid: Int) -[Exec]> WatchHandle = "jet_watcher_process_pid"
    #Import(c) priv port: fn(host: String, port: Int) -[Net]> WatchHandle = "jet_watcher_port"

    // A new empty watch set.
    #Import(c) priv set: fn() -> WatchSet = "jet_watcher_set"

    // The events since the last poll, three texts each: kind, path, detail.
    // It reads what the watched target did since, so it carries IO, as
    // core.watcher's WatchHandle.poll does.
    #Import(c) priv poll: fn(handle: WatchHandle) -[IO]> [String] = "jet_watcher_poll"

    // Stops `handle`, and whether it still runs.
    #Import(c) priv cancel: fn(handle: WatchHandle) = "jet_watcher_cancel"
    #Import(c) priv is_active: fn(handle: WatchHandle) -> Bool = "jet_watcher_is_active"

    // The handle's target (0 file, 1 process, 2 port), its path or host, and
    // its pid or port.
    #Import(c) priv target: fn(handle: WatchHandle) -> Int = "jet_watcher_target"
    #Import(c) priv text: fn(handle: WatchHandle) -> String = "jet_watcher_text"
    #Import(c) priv number: fn(handle: WatchHandle) -> Int = "jet_watcher_number"

    // Adds `handle` to `set`, the set's handle count, and its handle at `index`.
    #Import(c) priv set_add: fn(set: WatchSet, handle: WatchHandle) = "jet_watcher_set_add"
    #Import(c) priv set_len: fn(set: WatchSet) -> Int = "jet_watcher_set_len"
    #Import(c) priv set_get: fn(set: WatchSet, index: Int) -> WatchHandle = "jet_watcher_set_get"
}
