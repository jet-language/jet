fn host_errno_cause_append(text: I64, errno: I64) {
    host_errno_append(text, errno)
    rt_text_push_word(text, I64{8246765057718822944}, I64{8})
    rt_text_push_word(text, I64{2126447}, I64{3})
    rt_text_push_number(text, errno)
    rt_text_push_word(text, I64{41}, I64{1})
}

fn host_errno_text(errno: I64) -> I64 {
    text :: jet_rt_string_builder_new()
    host_errno_append(text, errno)
    jet_rt_string_builder_finish(text)
}

fn host_errno_cause(errno: I64) -> I64 {
    text :: jet_rt_string_builder_new()
    host_errno_cause_append(text, errno)
    jet_rt_string_builder_finish(text)
}
