// Map uses Maps.jet's sorted inline entry List; not JetOrderedMap<String,String>.
ui_form_sequence_init: fn(value: I64) {
    ui_carrier_store(wrapping(value + DATA_SEQUENCE_LENGTH), I64{0})
    ui_carrier_store(wrapping(value + DATA_SEQUENCE_CAPACITY), I64{0})
    ui_carrier_store(wrapping(value + DATA_SEQUENCE_DATA), I64{8})
}
ui_form_sequence_copy: fn(value: I64, result: I64, stride: I64) {
    length: ui_carrier_word(wrapping(value + DATA_SEQUENCE_LENGTH))
    data: if (length == I64{0}) -> I64{8} else -> jet_rt_alloc(length * stride, I64{8})
    ui_carrier_store(wrapping(result + DATA_SEQUENCE_LENGTH), length)
    ui_carrier_store(wrapping(result + DATA_SEQUENCE_CAPACITY), length)
    ui_carrier_store(wrapping(result + DATA_SEQUENCE_DATA), data)
}
ui_form_sequence_buffer_drop: fn(value: I64, stride: I64) {
    capacity: ui_carrier_word(wrapping(value + DATA_SEQUENCE_CAPACITY))
    if (capacity != I64{0}) -> jet_rt_free(ui_carrier_word(wrapping(value + DATA_SEQUENCE_DATA)), capacity * stride, I64{8})
}
ui_form_messages_copy: fn(value: I64, result: I64) {
    ui_form_sequence_copy(value, result, DYN_ELEMENT_BYTES)
    length: ui_carrier_word(wrapping(value + DATA_SEQUENCE_LENGTH))
    source: ui_carrier_word(wrapping(value + DATA_SEQUENCE_DATA))
    target: ui_carrier_word(wrapping(result + DATA_SEQUENCE_DATA))
    at := I64{0}
    loop at < length {
        ui_carrier_store(wrapping(target + at * DYN_ELEMENT_BYTES), jet_rt_string_clone(ui_carrier_word(wrapping(source + at * DYN_ELEMENT_BYTES))))
        at += I64{1}
    }
}
ui_form_messages_drop: fn(value: I64) {
    length: ui_carrier_word(wrapping(value + DATA_SEQUENCE_LENGTH))
    data: ui_carrier_word(wrapping(value + DATA_SEQUENCE_DATA))
    at := I64{0}
    loop at < length {
        jet_rt_string_drop(ui_carrier_word(wrapping(data + at * DYN_ELEMENT_BYTES)))
        at += I64{1}
    }
    ui_form_sequence_buffer_drop(value, DYN_ELEMENT_BYTES)
}
ui_form_messages_eq: fn(a: I64, b: I64) -> Bool {
    length: ui_carrier_word(wrapping(a + DATA_SEQUENCE_LENGTH))
    if (length != ui_carrier_word(wrapping(b + DATA_SEQUENCE_LENGTH))) -> return false
    first: ui_carrier_word(wrapping(a + DATA_SEQUENCE_DATA))
    second: ui_carrier_word(wrapping(b + DATA_SEQUENCE_DATA))
    at := I64{0}
    loop at < length {
        if (!jet_rt_string_eq(ui_carrier_word(wrapping(first + at * DYN_ELEMENT_BYTES)), ui_carrier_word(wrapping(second + at * DYN_ELEMENT_BYTES)))) -> return false
        at += I64{1}
    }
    true
}
ui_form_messages_push: fn(value: I64, message: I64) {
    slot: data_sequence_reserve(value, DYN_ELEMENT_BYTES)
    ui_carrier_store(slot, message)
    ui_carrier_store(wrapping(value + DATA_SEQUENCE_LENGTH), ui_carrier_word(wrapping(value + DATA_SEQUENCE_LENGTH)) + I64{1})
}
ui_form_valid_name: fn(name: I64) -> Bool {
    length: rt_text_len(name)
    if (length == I64{0} || length > I64{256}) -> return false
    data: rt_text_data(name)
    at := I64{0}
    loop at < length {
        byte: rt_text_byte(wrapping(data + at))
        alphabetic: (byte >= I64{65} && byte <= I64{90}) || (byte >= I64{97} && byte <= I64{122})
        if (byte != I64{95} && !alphabetic && !(at != I64{0} && byte >= I64{48} && byte <= I64{57})) -> return false
        at += I64{1}
    }
    true
}
ui_form_bound_message: fn(message: I64) -> I64 {
    if (rt_text_len(message) <= I64{4096}) -> return message
    // Keep the entire scalar whose start is below 4096. The original buffer
    // capacity remains owned for drop; no unnecessary replacement allocation.
    data: rt_text_data(message)
    end := I64{0}
    limit: I64{4096}
    loop end < limit { end += rt_text_width(wrapping(data + end)) }
    rt_text_store(wrapping(message + I64{8}), end)
    message
}
#Export(c) jet_web_forms_action_error: fn() -> I64 {
    result: jet_rt_alloc(UI_FORM_ACTION_ERROR_BYTES, I64{8})
    ui_form_sequence_init(wrapping(result + UI_FORM_ACTION_ERROR_FIELDS))
    ui_form_sequence_init(wrapping(result + UI_FORM_ACTION_ERROR_FORM))
    result
}
// By-value consumed error; the returned I64 owns the SAME carrier.
#Export(c) jet_web_forms_action_form_error: fn(error: I64, message: I64) -> I64 {
    ui_form_messages_push(wrapping(error + UI_FORM_ACTION_ERROR_FORM), ui_form_bound_message(message))
    error
}
#Export(c) jet_web_forms_action_field_error: fn(error: I64, name: I64, message: I64) -> I64 {
    if (!ui_form_valid_name(name)) {
        jet_rt_string_drop(name)
        jet_rt_string_drop(message)
        ui_form_messages_push(wrapping(error + UI_FORM_ACTION_ERROR_FORM), jet_rt_string_clone(rt_static_text("action returned an invalid field error")))
        return error
    }
    fields: wrapping(error + UI_FORM_ACTION_ERROR_FIELDS)
    length: ui_carrier_word(wrapping(fields + DATA_SEQUENCE_LENGTH))
    data: ui_carrier_word(wrapping(fields + DATA_SEQUENCE_DATA))
    low := I64{0}
    high := length
    loop low < high {
        middle: low + (high - low) /% I64{2}
        order: jet_rt_string_compare(ui_carrier_word(wrapping(wrapping(data + middle * UI_FORM_ERROR_ENTRY_BYTES) + UI_FORM_ERROR_ENTRY_KEY)), name)
        if (order < I64{0}) { low = middle + I64{1} } else { high = middle }
    }
    if (low < length && jet_rt_string_eq(ui_carrier_word(wrapping(wrapping(data + low * UI_FORM_ERROR_ENTRY_BYTES) + UI_FORM_ERROR_ENTRY_KEY)), name)) {
        jet_rt_string_drop(name)
    } else {
        data_sequence_reserve(fields, UI_FORM_ERROR_ENTRY_BYTES)
        buffer: ui_carrier_word(wrapping(fields + DATA_SEQUENCE_DATA))
        at := length
        loop at > low {
            coll_copy(wrapping(buffer + (at - I64{1}) * UI_FORM_ERROR_ENTRY_BYTES), wrapping(buffer + at * UI_FORM_ERROR_ENTRY_BYTES), UI_FORM_ERROR_ENTRY_BYTES)
            at -= I64{1}
        }
        entry: buffer + low * UI_FORM_ERROR_ENTRY_BYTES
        ui_carrier_store(wrapping(entry + UI_FORM_ERROR_ENTRY_KEY), name)
        ui_form_sequence_init(wrapping(entry + UI_FORM_ERROR_ENTRY_MESSAGES))
        ui_carrier_store(wrapping(fields + DATA_SEQUENCE_LENGTH), length + I64{1})
    }
    entry: ui_carrier_word(wrapping(fields + DATA_SEQUENCE_DATA)) + low * UI_FORM_ERROR_ENTRY_BYTES
    ui_form_messages_push(wrapping(entry + UI_FORM_ERROR_ENTRY_MESSAGES), ui_form_bound_message(message))
    error
}
#Export(c) jet_rt_handle_clone_jet_web_form_action_error: fn(value: I64) -> I64 {
    result: jet_rt_alloc(UI_FORM_ACTION_ERROR_BYTES, I64{8})
    ui_form_sequence_copy(wrapping(value + UI_FORM_ACTION_ERROR_FIELDS), wrapping(result + UI_FORM_ACTION_ERROR_FIELDS), UI_FORM_ERROR_ENTRY_BYTES)
    length: ui_carrier_word(wrapping(wrapping(value + UI_FORM_ACTION_ERROR_FIELDS) + DATA_SEQUENCE_LENGTH))
    source: ui_carrier_word(wrapping(wrapping(value + UI_FORM_ACTION_ERROR_FIELDS) + DATA_SEQUENCE_DATA))
    target: ui_carrier_word(wrapping(wrapping(result + UI_FORM_ACTION_ERROR_FIELDS) + DATA_SEQUENCE_DATA))
    at := I64{0}
    loop at < length {
        first: wrapping(source + at * UI_FORM_ERROR_ENTRY_BYTES)
        second: wrapping(target + at * UI_FORM_ERROR_ENTRY_BYTES)
        ui_carrier_store(wrapping(second + UI_FORM_ERROR_ENTRY_KEY), jet_rt_string_clone(ui_carrier_word(wrapping(first + UI_FORM_ERROR_ENTRY_KEY))))
        ui_form_messages_copy(wrapping(first + UI_FORM_ERROR_ENTRY_MESSAGES), wrapping(second + UI_FORM_ERROR_ENTRY_MESSAGES))
        at += I64{1}
    }
    ui_form_messages_copy(wrapping(value + UI_FORM_ACTION_ERROR_FORM), wrapping(result + UI_FORM_ACTION_ERROR_FORM))
    result
}
#Export(c) jet_rt_handle_drop_jet_web_form_action_error: fn(value: I64) {
    if (value == I64{0}) -> return
    length: ui_carrier_word(wrapping(wrapping(value + UI_FORM_ACTION_ERROR_FIELDS) + DATA_SEQUENCE_LENGTH))
    data: ui_carrier_word(wrapping(wrapping(value + UI_FORM_ACTION_ERROR_FIELDS) + DATA_SEQUENCE_DATA))
    at := I64{0}
    loop at < length {
        entry: wrapping(data + at * UI_FORM_ERROR_ENTRY_BYTES)
        jet_rt_string_drop(ui_carrier_word(wrapping(entry + UI_FORM_ERROR_ENTRY_KEY)))
        ui_form_messages_drop(wrapping(entry + UI_FORM_ERROR_ENTRY_MESSAGES))
        at += I64{1}
    }
    ui_form_sequence_buffer_drop(wrapping(value + UI_FORM_ACTION_ERROR_FIELDS), UI_FORM_ERROR_ENTRY_BYTES)
    ui_form_messages_drop(wrapping(value + UI_FORM_ACTION_ERROR_FORM))
    jet_rt_free(value, UI_FORM_ACTION_ERROR_BYTES, I64{8})
}
#Export(c) jet_rt_handle_eq_jet_web_form_action_error: fn(a: I64, b: I64) -> Bool {
    length: ui_carrier_word(wrapping(wrapping(a + UI_FORM_ACTION_ERROR_FIELDS) + DATA_SEQUENCE_LENGTH))
    if (length != ui_carrier_word(wrapping(wrapping(b + UI_FORM_ACTION_ERROR_FIELDS) + DATA_SEQUENCE_LENGTH))) -> return false
    first: ui_carrier_word(wrapping(wrapping(a + UI_FORM_ACTION_ERROR_FIELDS) + DATA_SEQUENCE_DATA))
    second: ui_carrier_word(wrapping(wrapping(b + UI_FORM_ACTION_ERROR_FIELDS) + DATA_SEQUENCE_DATA))
    at := I64{0}
    loop at < length {
        left: wrapping(first + at * UI_FORM_ERROR_ENTRY_BYTES)
        right: wrapping(second + at * UI_FORM_ERROR_ENTRY_BYTES)
        if (!jet_rt_string_eq(ui_carrier_word(wrapping(left + UI_FORM_ERROR_ENTRY_KEY)), ui_carrier_word(wrapping(right + UI_FORM_ERROR_ENTRY_KEY))) || !ui_form_messages_eq(wrapping(left + UI_FORM_ERROR_ENTRY_MESSAGES), wrapping(right + UI_FORM_ERROR_ENTRY_MESSAGES))) -> return false
        at += I64{1}
    }
    ui_form_messages_eq(wrapping(a + UI_FORM_ACTION_ERROR_FORM), wrapping(b + UI_FORM_ACTION_ERROR_FORM))
}
