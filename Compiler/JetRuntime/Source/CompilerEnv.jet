// The frozen policy: flatten name,value in stored order, preserve OS encoded
// bytes, never sort or decode Unicode.
// Lower/Routes.jet:706-749 requires compact nested [U8]: every header is
// [len,cap,data], inner stride 1 and outer stride 24. Each result owns
// independent buffers (including when the logical table changes).
compiler_env_columns_storage: fn(pairs: I64, output: I64) -> I64 {
    length: pairs * I64{2}
    data: if (length == I64{0}) -> I64{0} else -> jet_rt_alloc(length * I64{24}, I64{8})
    rt_text_store(output, length)
    rt_text_store(wrapping(output + I64{8}), length)
    rt_text_store(wrapping(output + I64{16}), data)
    data
}

compiler_env_find_pair: fn(buf: I64, len: I64, key_data: I64, key_len: I64) -> I64 {
    ^at: I64{0}
    loop at < len {
        row: wrapping(buf + at * I64{32})
        if (rt_text_word(wrapping(row + I64{8})) == key_len && rt_text_equal_bytes(rt_text_word(row), key_data, key_len)) {
            return at
        }
        at += I64{1}
    }
    I64{-1}
}

#Export(c) jet_rt_logical_env_columns: fn(output: I64) {
    rt_test_reads_text(I64{65}, I64{0})
    count_slot: jet_rt_alloc(I64{8}, I64{8})
    nodes: context_env_nodes_outer_to_inner(count_slot)
    node_count: rt_text_word(count_slot)
    jet_rt_free(count_slot, I64{8}, I64{8})
    root: logical_environment_current()
    shared_acquire(root, false)
    ^pairs: I64{0}
    ^entry: rt_text_word(wrapping(root + I64{56}))
    loop entry != (I64{0}) {
        pairs += I64{1}
        entry = rt_text_word(entry)
    }
    if (node_count == I64{0}) {
        data: compiler_env_columns_storage(pairs, output)
        entry = rt_text_word(wrapping(root + I64{56}))
        ^at: I64{0}
        loop entry != (I64{0}) {
            host_startup_list(rt_text_word(wrapping(entry + I64{8})), rt_text_word(wrapping(entry + I64{16})), wrapping(data + at * I64{48}))
            host_startup_list(rt_text_word(wrapping(entry + I64{24})), rt_text_word(wrapping(entry + I64{32})), wrapping(wrapping(data + at * I64{48}) + I64{24}))
            entry = rt_text_word(entry)
            at += I64{1}
        }
        shared_release(root, false)
        return
    }
    ^cap: wrapping(pairs + I64{16})
    ^buf: jet_rt_alloc(wrapping(cap * I64{32}), I64{8})
    ^len: I64{0}
    entry = rt_text_word(wrapping(root + I64{56}))
    loop entry != (I64{0}) {
        row: wrapping(buf + len * I64{32})
        rt_text_store(row, rt_text_word(wrapping(entry + I64{8})))
        rt_text_store(wrapping(row + I64{8}), rt_text_word(wrapping(entry + I64{16})))
        rt_text_store(wrapping(row + I64{16}), rt_text_word(wrapping(entry + I64{24})))
        rt_text_store(wrapping(row + I64{24}), rt_text_word(wrapping(entry + I64{32})))
        len += I64{1}
        entry = rt_text_word(entry)
    }
    ^ni: I64{0}
    loop ni < node_count {
        node: rt_text_word(wrapping(nodes + ni * I64{8}))
        mlen: sync_load(wrapping(node + I64{40}))
        mdata: sync_load(wrapping(node + I64{56}))
        ^mi: I64{0}
        loop mi < mlen {
            mrow: wrapping(mdata + mi * I64{16})
            k: sync_load(mrow)
            v: sync_load(wrapping(mrow + I64{8}))
            kd: rt_text_data(k)
            kl: rt_text_len(k)
            pos: compiler_env_find_pair(buf, len, kd, kl)
            if context_env_is_tombstone(v) {
                if (pos >= I64{0}) {
                    ^shift: pos
                    loop wrapping(shift + I64{1}) < len {
                        dst: wrapping(buf + shift * I64{32})
                        src: wrapping(buf + wrapping(shift + I64{1}) * I64{32})
                        rt_text_store(dst, rt_text_word(src))
                        rt_text_store(wrapping(dst + I64{8}), rt_text_word(wrapping(src + I64{8})))
                        rt_text_store(wrapping(dst + I64{16}), rt_text_word(wrapping(src + I64{16})))
                        rt_text_store(wrapping(dst + I64{24}), rt_text_word(wrapping(src + I64{24})))
                        shift += I64{1}
                    }
                    len -= I64{1}
                }
            } else {
                vd: rt_text_data(v)
                vl: rt_text_len(v)
                if (pos >= I64{0}) {
                    dst: wrapping(buf + pos * I64{32})
                    rt_text_store(wrapping(dst + I64{16}), vd)
                    rt_text_store(wrapping(dst + I64{24}), vl)
                } else {
                    if (len == cap) {
                        grown: cap * I64{2}
                        next_buf: jet_rt_alloc(wrapping(grown * I64{32}), I64{8})
                        coll_copy(buf, next_buf, wrapping(len * I64{32}))
                        jet_rt_free(buf, wrapping(cap * I64{32}), I64{8})
                        buf = next_buf
                        cap = grown
                    }
                    dst: wrapping(buf + len * I64{32})
                    rt_text_store(dst, kd)
                    rt_text_store(wrapping(dst + I64{8}), kl)
                    rt_text_store(wrapping(dst + I64{16}), vd)
                    rt_text_store(wrapping(dst + I64{24}), vl)
                    len += I64{1}
                }
            }
            mi += I64{1}
        }
        ni += I64{1}
    }
    data: compiler_env_columns_storage(len, output)
    ^at: I64{0}
    loop at < len {
        row: wrapping(buf + at * I64{32})
        host_startup_list(rt_text_word(row), rt_text_word(wrapping(row + I64{8})), wrapping(data + at * I64{48}))
        host_startup_list(rt_text_word(wrapping(row + I64{16})), rt_text_word(wrapping(row + I64{24})), wrapping(wrapping(data + at * I64{48}) + I64{24}))
        at += I64{1}
    }
    shared_release(root, false)
    jet_rt_free(buf, wrapping(cap * I64{32}), I64{8})
    jet_rt_free(nodes, wrapping(node_count * I64{8}), I64{8})
}

#Export(c) jet_rt_startup_env_columns: fn(output: I64) {
    comptime_serve_refuse(COMPTIME_REFUSED_ENVIRONMENT)
    rt_test_reads_text(I64{65}, I64{0})
    host_environment_require()
    data: compiler_env_columns_storage(host_env_length, output)
    ^at: I64{0}
    loop at < host_env_length {
        row: wrapping(host_env_rows + at * I64{24})
        key: rt_text_word(row)
        value: wrapping(key + rt_text_word(wrapping(row + I64{16})))
        host_startup_list(key, rt_text_word(wrapping(row + I64{8})), wrapping(data + at * I64{48}))
        host_startup_list(value, host_startup_byte_length(value), wrapping(wrapping(data + at * I64{48}) + I64{24}))
        at += I64{1}
    }
}

// This pack's OS seed is Linux x86-64. Its byte-vector comparison compares
// unsigned encoded bytes, case-sensitively, including invalid UTF-8.
// Do NOT use String comparison/normalization or ASCII folding here. Windows
// instead uses WTF-8 -> UTF-16 + CompareStringOrdinal(ignore_case=1), with an
// ordinal UTF-16 fallback on failure/oversize; that is not this Unix OS seed.
#Export(c) jet_rt_env_key_compare: fn(left: I64, right: I64) -> I64 {
    env_key_order(rt_text_word(wrapping(left + I64{16})), rt_text_word(left), rt_text_word(wrapping(right + I64{16})), rt_text_word(right))
}

// The order of two names' packed bytes: -1, 0 or 1.
env_key_order: fn(left_data: I64, left_length: I64, right_data: I64, right_length: I64) -> I64 {
    ^at: I64{0}
    loop at < left_length && at < right_length {
        a: rt_text_byte(wrapping(left_data + at))
        b: rt_text_byte(wrapping(right_data + at))
        if (a < b) { return I64{-1} }
        if (a > b) { return I64{1} }
        at += I64{1}
    }
    if (left_length < right_length) -> I64{-1} else if (left_length > right_length) -> I64{1} else -> I64{0}
}
