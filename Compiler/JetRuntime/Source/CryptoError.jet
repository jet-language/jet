// Private renderer; public Core error projection is not changed. Borrowed
// record words: tag, operation Text*, parameter Text*, expected Text*, actual
// I64, detail Text*, minimum I64, maximum I64. Only public metadata is
// represented. PasswordPolicy reason is never read.
fn rt_crypto_error_fragment(out: I64, kind: I64) {
    if (kind == I64{0}) {
        rt_text_push_word(out, I64{8250}, I64{2})
        return
    }
    if (kind == I64{1}) {
        rt_text_push_word(out, I64{7305437230073736480}, I64{8})
        rt_text_push_word(out, I64{32}, I64{1})
        return
    }
    if (kind == I64{2}) {
        rt_text_push_word(out, I64{35684457324603}, I64{6})
        return
    }
    if (kind == I64{3}) {
        jet_rt_string_builder_push(out, rt_static_text(" is not canonical"))
        return
    }
    if (kind == I64{4}) {
        rt_text_push_word(out, I64{2336927755350992246}, I64{8})
        return
    }
    if (kind == I64{5}) {
        jet_rt_string_builder_push(out, rt_static_text(" is not supported"))
        return
    }
    if (kind == I64{6}) {
        rt_text_push_word(out, I64{7526756817459178593}, I64{8})
        rt_text_push_word(out, I64{8301}, I64{2})
        return
    }
    if (kind == I64{7}) {
        jet_rt_string_builder_push(out, rt_static_text("encrypted data could not be opened"))
        return
    }
    if (kind == I64{8}) {
        jet_rt_string_builder_push(out, rt_static_text("X25519 peer key does not contribute to a shared secret"))
        return
    }
    if (kind == I64{9}) {
        jet_rt_string_builder_push(out, rt_static_text("output length must be "))
        return
    }
    if (kind == I64{10}) {
        rt_text_push_word(out, I64{11822}, I64{2})
        return
    }
    if (kind == I64{11}) {
        jet_rt_string_builder_push(out, rt_static_text("password hash is outside Jet's accepted policy"))
        return
    }
    if (kind == I64{12}) {
        jet_rt_string_builder_push(out, rt_static_text("the operating system could not provide cryptographic randomness"))
        return
    }
    if (kind == I64{13}) {
        jet_rt_string_builder_push(out, rt_static_text(" is unavailable for this cryptographic operation"))
        return
    }
    if (kind == I64{14}) {
        jet_rt_string_builder_push(out, rt_static_text("Jet could not preserve a cryptographic invariant; incident "))
        return
    }
    jet_rt_unreachable(I64{0}, I64{0})
}
fn rt_crypto_error_append(out: I64, text: I64) {
    jet_rt_string_builder_push(out, text)
}
fn rt_crypto_error_display(error: I64) -> I64 {
    kind :: rt_text_word(error)
    out :: jet_rt_string_builder_new()
    if (kind <= I64{3} || kind == I64{6}) {
        rt_crypto_error_append(out, rt_text_word(error + I64{8}))
        rt_crypto_error_fragment(out, I64{0})
    }
    if {
        (kind == I64{0}) -> {
            rt_crypto_error_append(out, rt_text_word(error + I64{16}))
            rt_crypto_error_fragment(out, I64{1})
            rt_crypto_error_append(out, rt_text_word(error + I64{24}))
            rt_crypto_error_fragment(out, I64{2})
            rt_text_push_number(out, rt_text_word(error + I64{32}))
        }
        (kind == I64{1}) -> {
            rt_crypto_error_append(out, rt_text_word(error + I64{16}))
            rt_crypto_error_fragment(out, I64{3})
        }
        (kind == I64{2}) -> {
            rt_crypto_error_fragment(out, I64{4})
            rt_text_push_number(out, rt_text_word(error + I64{32}))
            rt_crypto_error_fragment(out, I64{5})
        }
        (kind == I64{3}) -> {
            rt_crypto_error_fragment(out, I64{6})
            rt_crypto_error_append(out, rt_text_word(error + I64{40}))
            rt_crypto_error_fragment(out, I64{5})
        }
        (kind == I64{4}) -> rt_crypto_error_fragment(out, I64{7})
        (kind == I64{5}) -> rt_crypto_error_fragment(out, I64{8})
        (kind == I64{6}) -> {
            rt_crypto_error_fragment(out, I64{9})
            rt_text_push_number(out, rt_text_word(error + I64{48}))
            rt_crypto_error_fragment(out, I64{10})
            rt_text_push_number(out, rt_text_word(error + I64{56}))
            rt_crypto_error_fragment(out, I64{2})
            rt_text_push_number(out, rt_text_word(error + I64{32}))
        }
        (kind == I64{7}) -> rt_crypto_error_fragment(out, I64{11})
        (kind == I64{8}) -> rt_crypto_error_fragment(out, I64{12})
        (kind == I64{9}) -> {
            rt_crypto_error_append(out, rt_text_word(error + I64{40}))
            rt_crypto_error_fragment(out, I64{13})
        }
        (kind == I64{10}) -> {
            rt_crypto_error_fragment(out, I64{14})
            rt_crypto_error_append(out, rt_text_word(error + I64{40}))
        }
        else -> jet_rt_unreachable(I64{0}, I64{0})
    }
    return out
}
