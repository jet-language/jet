// CryptoEntropy.rs:9-38. Private renderer; public Core error projection is not
// changed. Borrowed record words: tag, operation Text*, parameter Text*,
// expected Text*, actual I64, detail Text*, minimum I64, maximum I64.
// Only public metadata is represented. PasswordPolicy reason is never read.
fn rt_crypto_error_fragment(out: I64, kind: I64) {
    if (kind == I64{0}) {
        rt_text_push_word(out, I64{8250}, I64{2})
        return
    }
    if (kind == I64{1}) {
        rt_text_push_word(out, I64{7305437230073736480}, I64{8})
        rt_text_push_word(out, I64{32}, I64{1})
        return
    }
    if (kind == I64{2}) {
        rt_text_push_word(out, I64{35684457324603}, I64{6})
        return
    }
    if (kind == I64{3}) {
        rt_text_push_word(out, I64{2338616625293650208}, I64{8})
        rt_text_push_word(out, I64{7017568567410188643}, I64{8})
        rt_text_push_word(out, I64{108}, I64{1})
        return
    }
    if (kind == I64{4}) {
        rt_text_push_word(out, I64{2336927755350992246}, I64{8})
        return
    }
    if (kind == I64{5}) {
        rt_text_push_word(out, I64{2338616625293650208}, I64{8})
        rt_text_push_word(out, I64{7310593918082512243}, I64{8})
        rt_text_push_word(out, I64{100}, I64{1})
        return
    }
    if (kind == I64{6}) {
        rt_text_push_word(out, I64{7526756817459178593}, I64{8})
        rt_text_push_word(out, I64{8301}, I64{2})
        return
    }
    if (kind == I64{7}) {
        rt_text_push_word(out, I64{7310591762041630309}, I64{8})
        rt_text_push_word(out, I64{7142816161487659108}, I64{8})
        rt_text_push_word(out, I64{8390045716217361775}, I64{8})
        rt_text_push_word(out, I64{7954887939407045152}, I64{8})
        rt_text_push_word(out, I64{25701}, I64{2})
        return
    }
    if (kind == I64{8}) {
        rt_text_push_word(out, I64{8079520615011529304}, I64{8})
        rt_text_push_word(out, I64{2340012992175957349}, I64{8})
        rt_text_push_word(out, I64{8390045716468559716}, I64{8})
        rt_text_push_word(out, I64{7091324932666123040}, I64{8})
        rt_text_push_word(out, I64{6998716365484160117}, I64{8})
        rt_text_push_word(out, I64{2334102048819671840}, I64{8})
        rt_text_push_word(out, I64{127979059635571}, I64{6})
        return
    }
    if (kind == I64{9}) {
        rt_text_push_word(out, I64{7791355403097634159}, I64{8})
        rt_text_push_word(out, I64{8461454907900653157}, I64{8})
        rt_text_push_word(out, I64{35619810079859}, I64{6})
        return
    }
    if (kind == I64{10}) {
        rt_text_push_word(out, I64{11822}, I64{2})
        return
    }
    if (kind == I64{11}) {
        rt_text_push_word(out, I64{7237970109966541168}, I64{8})
        rt_text_push_word(out, I64{8316213819900782624}, I64{8})
        rt_text_push_word(out, I64{7306080440097795872}, I64{8})
        rt_text_push_word(out, I64{6998720434227464736}, I64{8})
        rt_text_push_word(out, I64{2334102057661064035}, I64{8})
        rt_text_push_word(out, I64{133467877437296}, I64{6})
        return
    }
    if (kind == I64{12}) {
        rt_text_push_word(out, I64{8243118315558758516}, I64{8})
        rt_text_push_word(out, I64{8751374129517130849}, I64{8})
        rt_text_push_word(out, I64{8462091215777920115}, I64{8})
        rt_text_push_word(out, I64{8079585753440478316}, I64{8})
        rt_text_push_word(out, I64{7142820490950111090}, I64{8})
        rt_text_push_word(out, I64{7021788497416583538}, I64{8})
        rt_text_push_word(out, I64{7953763900345378928}, I64{8})
        rt_text_push_word(out, I64{32496501803282276}, I64{7})
        return
    }
    if (kind == I64{13}) {
        rt_text_push_word(out, I64{8530220618551093536}, I64{8})
        rt_text_push_word(out, I64{2334391151658559841}, I64{8})
        rt_text_push_word(out, I64{8316293034886197094}, I64{8})
        rt_text_push_word(out, I64{7453303934744159008}, I64{8})
        rt_text_push_word(out, I64{8007509441839653234}, I64{8})
        rt_text_push_word(out, I64{7957695015158965616}, I64{8})
        return
    }
    if (kind == I64{14}) {
        rt_text_push_word(out, I64{7815275199908308298}, I64{8})
        rt_text_push_word(out, I64{8246126602173161572}, I64{8})
        rt_text_push_word(out, I64{6998705380333548389}, I64{8})
        rt_text_push_word(out, I64{7453303934744159008}, I64{8})
        rt_text_push_word(out, I64{7575163877612085618}, I64{8})
        rt_text_push_word(out, I64{8389750261356263022}, I64{8})
        rt_text_push_word(out, I64{7306080371276849211}, I64{8})
        rt_text_push_word(out, I64{2126958}, I64{3})
        return
    }
    jet_rt_unreachable(I64{0}, I64{0})
}
fn rt_crypto_error_append(out: I64, text: I64) {
    jet_rt_string_builder_push(out, text)
}
fn rt_crypto_error_display(error: I64) -> I64 {
    kind :: rt_text_word(error)
    out :: jet_rt_string_builder_new()
    if (kind <= I64{3} || kind == I64{6}) {
        rt_crypto_error_append(out, rt_text_word(error + I64{8}))
        rt_crypto_error_fragment(out, I64{0})
    }
    if {
        (kind == I64{0}) -> {
            rt_crypto_error_append(out, rt_text_word(error + I64{16}))
            rt_crypto_error_fragment(out, I64{1})
            rt_crypto_error_append(out, rt_text_word(error + I64{24}))
            rt_crypto_error_fragment(out, I64{2})
            rt_text_push_number(out, rt_text_word(error + I64{32}))
        }
        (kind == I64{1}) -> {
            rt_crypto_error_append(out, rt_text_word(error + I64{16}))
            rt_crypto_error_fragment(out, I64{3})
        }
        (kind == I64{2}) -> {
            rt_crypto_error_fragment(out, I64{4})
            rt_text_push_number(out, rt_text_word(error + I64{32}))
            rt_crypto_error_fragment(out, I64{5})
        }
        (kind == I64{3}) -> {
            rt_crypto_error_fragment(out, I64{6})
            rt_crypto_error_append(out, rt_text_word(error + I64{40}))
            rt_crypto_error_fragment(out, I64{5})
        }
        (kind == I64{4}) -> rt_crypto_error_fragment(out, I64{7})
        (kind == I64{5}) -> rt_crypto_error_fragment(out, I64{8})
        (kind == I64{6}) -> {
            rt_crypto_error_fragment(out, I64{9})
            rt_text_push_number(out, rt_text_word(error + I64{48}))
            rt_crypto_error_fragment(out, I64{10})
            rt_text_push_number(out, rt_text_word(error + I64{56}))
            rt_crypto_error_fragment(out, I64{2})
            rt_text_push_number(out, rt_text_word(error + I64{32}))
        }
        (kind == I64{7}) -> rt_crypto_error_fragment(out, I64{11})
        (kind == I64{8}) -> rt_crypto_error_fragment(out, I64{12})
        (kind == I64{9}) -> {
            rt_crypto_error_append(out, rt_text_word(error + I64{40}))
            rt_crypto_error_fragment(out, I64{13})
        }
        (kind == I64{10}) -> {
            rt_crypto_error_fragment(out, I64{14})
            rt_crypto_error_append(out, rt_text_word(error + I64{40}))
        }
        else -> jet_rt_unreachable(I64{0}, I64{0})
    }
    return out
}
