// WsError's carrier and tags live in CoreEnumABI.jet; WsMessage and WsConn80
// are runtime-private carriers owned here.
WS_MESSAGE_BYTES: I64{24}

WS_MESSAGE_TAG: I64{0}

WS_MESSAGE_PAYLOAD: I64{8}

WS_MESSAGE_REASON: I64{16}

// WsConn80: the Stream64 it owns, whether it is the client (which masks the
// frames it sends), closed, the per-operation I/O timeout, the read buffer
// (bytes start..length of capacity are received and not yet decoded), the
// write lock that keeps each frame whole, and whether it joined the live
// transport hub.
WS_CONN_BYTES: I64{80}

WS_CONN_STREAM: I64{0}

WS_CONN_CLIENT: I64{8}

WS_CONN_CLOSED: I64{16}

WS_CONN_TIMEOUT_MS: I64{24}

WS_CONN_BUFFER: I64{32}

WS_CONN_LENGTH: I64{40}

WS_CONN_CAPACITY: I64{48}

WS_CONN_START: I64{56}

WS_CONN_WRITE_LOCK: I64{64}

WS_CONN_HUB: I64{72}

#Export(c) jet_rt_handle_clone_jet_ws_error: fn(value: I64) -> I64 {
    kind: dyn_word(wrapping(value + WS_ERROR_TAG))
    result: jet_rt_alloc(WS_ERROR_BYTES, I64{8})
    dyn_store(wrapping(result + WS_ERROR_TAG), kind)
    dyn_store(wrapping(result + WS_ERROR_LIMIT), if (kind == WS_ERROR_MESSAGE_TOO_LARGE) -> dyn_word(wrapping(value + WS_ERROR_LIMIT)) else -> I64{0})
    dyn_store(wrapping(result + WS_ERROR_OPERATION), if (kind == WS_ERROR_IO) -> jet_rt_string_clone(dyn_word(wrapping(value + WS_ERROR_OPERATION))) else -> I64{0})
    result
}

#Export(c) jet_rt_handle_drop_jet_ws_error: fn(value: I64) {
    if (value == I64{0}) {
        return
    }
    if (dyn_word(wrapping(value + WS_ERROR_TAG)) == WS_ERROR_IO) {
        jet_rt_string_drop(dyn_word(wrapping(value + WS_ERROR_OPERATION)))
    }
    jet_rt_free(value, WS_ERROR_BYTES, I64{8})
}

#Export(c) jet_rt_handle_eq_jet_ws_error: fn(left: I64, right: I64) -> Bool {
    kind: dyn_word(wrapping(left + WS_ERROR_TAG))
    if kind != dyn_word(wrapping(right + WS_ERROR_TAG)) -> return false
    if (kind == WS_ERROR_MESSAGE_TOO_LARGE) {
        return dyn_word(wrapping(left + WS_ERROR_LIMIT)) == dyn_word(wrapping(right + WS_ERROR_LIMIT))
    }
    if (kind == WS_ERROR_IO) {
        return jet_rt_string_eq(dyn_word(wrapping(left + WS_ERROR_OPERATION)), dyn_word(wrapping(right + WS_ERROR_OPERATION)))
    }
    true
}

// Custom show/debug/display are identical, never a derived Debug. IO
// operation is raw text, MessageTooLarge is signed i64.
#Export(c) jet_rt_handle_show_jet_ws_error: fn(value: I64) -> I64 {
    kind: dyn_word(wrapping(value + WS_ERROR_TAG))
    result: jet_rt_string_builder_new()
    if (kind == WS_ERROR_UNSUPPORTED_TARGET) {
        jet_rt_string_builder_push(result, rt_static_text("this build target lacks websocket client connect"))
        return result
    }
    rt_text_push_word(result, I64{7308044150667109751}, I64{8})  // "websocke"
    if {
        (kind == WS_ERROR_INVALID_URL) -> {
            rt_text_push_word(result, I64{8316213699087245428}, I64{8})
            rt_text_push_word(result, I64{7235433442201987360}, I64{8})
        }
        (kind == WS_ERROR_INVALID_HANDSHAKE) -> {
            jet_rt_string_builder_push(result, rt_static_text("t handshake failed"))
        }
        (kind == WS_ERROR_PROTOCOL) -> {
            rt_text_push_word(result, I64{7165073554179891316}, I64{8})
            rt_text_push_word(result, I64{8245935278387129455}, I64{8})
        }
        (kind == WS_ERROR_MESSAGE_TOO_LARGE) -> {
            jet_rt_string_builder_push(result, rt_static_text("t message exceeds "))
            rt_text_push_number(result, dyn_word(wrapping(value + WS_ERROR_LIMIT)))
            rt_text_push_word(result, I64{126879583003168}, I64{6})
        }
        (kind == WS_ERROR_IO) -> {
            jet_rt_string_builder_push(result, rt_static_text("t I/O failed during "))
            jet_rt_string_builder_push(result, dyn_word(wrapping(value + WS_ERROR_OPERATION)))
        }
        (kind == WS_ERROR_TIMEOUT) -> {
            rt_text_push_word(result, I64{2334102027479818356}, I64{8})
            rt_text_push_word(result, I64{7632239}, I64{3})
        }
        (kind == WS_ERROR_CLOSED) -> {
            rt_text_push_word(result, I64{8028901226721124468}, I64{8})
            rt_text_push_word(result, I64{6579571}, I64{3})
        }
        else -> {
            rt_text_push_word(result, I64{7810758454475432052}, I64{8})
            rt_text_push_word(result, I64{25701}, I64{2})
        }
    }
    result
}

#Export(c) jet_rt_handle_debug_jet_ws_error: fn(value: I64) -> I64 {
    jet_rt_handle_show_jet_ws_error(value)
}

#Export(c) jet_rt_handle_display_jet_ws_error: fn(value: I64) -> I64 {
    jet_rt_handle_show_jet_ws_error(value)
}

#Export(c) jet_rt_handle_clone_jet_ws_message: fn(value: I64) -> I64 {
    kind: dyn_word(wrapping(value + WS_MESSAGE_TAG))
    ^payload: dyn_word(wrapping(value + WS_MESSAGE_PAYLOAD))
    ^reason: I64{0}
    if (kind == I64{0}) { payload = jet_rt_string_clone(payload) } else if (kind == I64{1}) {
        payload = data_sequence_clone(payload, DYN_BYTE_LIST)
    } else { reason = jet_rt_string_clone(dyn_word(wrapping(value + WS_MESSAGE_REASON))) }
    result: jet_rt_alloc(WS_MESSAGE_BYTES, I64{8})
    dyn_store(wrapping(result + WS_MESSAGE_TAG), kind)
    dyn_store(wrapping(result + WS_MESSAGE_PAYLOAD), payload)
    dyn_store(wrapping(result + WS_MESSAGE_REASON), reason)
    result
}

#Export(c) jet_rt_handle_drop_jet_ws_message: fn(value: I64) {
    if (value == I64{0}) {
        return
    }
    kind: dyn_word(wrapping(value + WS_MESSAGE_TAG))
    payload: dyn_word(wrapping(value + WS_MESSAGE_PAYLOAD))
    if (kind == I64{0}) { jet_rt_string_drop(payload) } else if (kind == I64{1}) {
        data_sequence_drop(payload, DYN_BYTE_LIST)
    } else { jet_rt_string_drop(dyn_word(wrapping(value + WS_MESSAGE_REASON))) }
    jet_rt_free(value, WS_MESSAGE_BYTES, I64{8})
}

#Export(c) jet_rt_handle_eq_jet_ws_message: fn(left: I64, right: I64) -> Bool {
    kind: dyn_word(wrapping(left + WS_MESSAGE_TAG))
    if kind != dyn_word(wrapping(right + WS_MESSAGE_TAG)) -> return false
    a: dyn_word(wrapping(left + WS_MESSAGE_PAYLOAD))
    b: dyn_word(wrapping(right + WS_MESSAGE_PAYLOAD))
    if (kind == I64{0}) { return jet_rt_string_eq(a, b) }
    if (kind == I64{2}) {
        if a != b -> return false
        return jet_rt_string_eq(dyn_word(wrapping(left + WS_MESSAGE_REASON)), dyn_word(wrapping(right + WS_MESSAGE_REASON)))
    }
    length: dyn_word(wrapping(a + DATA_SEQUENCE_LENGTH))
    if length != dyn_word(wrapping(b + DATA_SEQUENCE_LENGTH)) -> return false
    ad: dyn_word(wrapping(a + DATA_SEQUENCE_DATA))
    bd: dyn_word(wrapping(b + DATA_SEQUENCE_DATA))
    ^at: I64{0}
    loop at < length {
        if host_u8_get(ad, at) != host_u8_get(bd, at) -> return false
        at += I64{1}
    }
    true
}
