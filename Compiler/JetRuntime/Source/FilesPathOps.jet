// Files1Raw.rs: the OS leaves of Core's atomic write. Core owns the retry
// count, temporary naming, fault checkpoints, cleanup and ordering; these do
// one host step each with io_error_at's mapping. The temporary is a held
// descriptor (HostHeldDirectory.jet) that Core closes with __atomic_close.
#Export(c) fn jet_files_atomic_pid_raw() -> I64 { jet_std_os_pid() }

// cfg!(windows): this runtime is the Linux pack.
#Export(c) fn jet_files_path_windows_raw() -> Bool { false }

// OpenOptions::new().create_new(true).write(true).open(candidate): open
// O_WRONLY|O_CREAT|O_EXCL|O_CLOEXEC, mode 0666 before the umask, EINTR
// retried. Errors name `target`. A taken name is AlreadyExists, the one kind
// Core's write_atomic retries with the next temporary name.
#Export(c) fn jet_files_atomic_reserve_raw(target: I64, candidate: I64, ok: I64, error: I64) -> I64 {
    if !files_paths_valid(candidate, candidate, target, HOST_IO_OP_WRITE, error) -> return I64{0}
    name :: fd_c_path(candidate)
    fd := I64{-4}
    loop {
        fd = host_call(I64{2}, name, I64{524481}, I64{438})
        if (fd != I64{-4}) -> break
    }
    fd_c_path_drop(name, candidate)
    if (fd == I64{-17}) -> return compiler_fs_error(HOST_IO_KIND_ALREADY_EXISTS, HOST_IO_OP_WRITE, target, I64{17}, host_errno_cause(I64{17}), error)
    if (fd < I64{0}) -> return compiler_fs_errno(HOST_IO_OP_WRITE, target, -fd, error)
    rt_text_store(ok, jet_int_owned_from_i64(fs_held_hold(fd, jet_rt_string_clone(candidate))))
    I64{1}
}

// The target's permissions are read (following links) before the first
// write; a missing or unreadable target has none to copy. Then write_all
// (Write), set_permissions (fchmod, Write) and sync_all (fsync, Flush), all
// naming `candidate` and EINTR retried. A released handle is Closed.
#Export(c) fn jet_files_atomic_finish_raw(handle: I64, data: I64, length: I64, target: I64, candidate: I64, error: I64) -> I64 {
    key :: host_native_int(handle)
    if (jet_scheduler_native_propagate() != I64{0}) -> return I64{0}
    mode := I64{-1}
    if !fs_text_has_nul(target) {
        scratch :: jet_rt_alloc(I64{160}, I64{8})
        jet_fs_stat_raw(target, true, scratch, scratch + I64{128})
        if (files_out_errno(scratch + I64{128}) == I64{0}) -> mode = (rt_text_word(scratch + I64{16})).bit_and(I64{4095})
        jet_rt_free(scratch, I64{160}, I64{8})
    }
    state :: fs_held_state(key)
    if (state == I64{0}) -> return compiler_fs_error(HOST_IO_KIND_CLOSED, HOST_IO_OP_WRITE, candidate, I64{0}, jet_rt_string_clone(rt_static_text("the atomic temporary file is already closed")), error)
    fd :: fd_word(state, I64{8})
    temporary :: RT_HOST_U8_STRIDE != I64{1} && length != I64{0}
    packed :: if temporary -> jet_rt_alloc(length, I64{8}) else -> data
    if temporary -> net_copy_packed(data, length, packed)
    written :: host_write_all(fd, packed, length)
    if temporary -> jet_rt_free(packed, length, I64{8})
    result := I64{1}
    if (written == HOST_WRITE_ZERO) {
        result = host_io_other_take(HOST_IO_OP_WRITE, jet_rt_string_clone(candidate), host_write_zero_text(), error)
    } else if (written < I64{0}) {
        result = compiler_fs_errno(HOST_IO_OP_WRITE, candidate, -written, error)
    } else {
        failure := I64{0}
        if (mode >= I64{0}) {
            failure = I64{-4}
            loop failure == (I64{-4}) -> failure = host_call(I64{91}, fd, mode, I64{0})
        }
        if (failure < I64{0}) {
            result = compiler_fs_errno(HOST_IO_OP_WRITE, candidate, -failure, error)
        } else {
            synced := I64{-4}
            loop synced == (I64{-4}) -> synced = host_call(I64{74}, fd, I64{0}, I64{0})
            if (synced < I64{0}) -> result = compiler_fs_errno(HOST_IO_OP_FLUSH, candidate, -synced, error)
        }
    }
    jet_fd_drop_raw(state)
    result
}

// std::fs::remove_file(path): Write errors name `path`.
#Export(c) fn jet_files_atomic_remove_raw(path: I64, error: I64) -> I64 {
    if !compiler_fs_path(path, HOST_IO_OP_WRITE, error) -> return I64{0}
    name :: fd_c_path(path)
    result :: host_call(I64{87}, name, I64{0}, I64{0})
    fd_c_path_drop(name, path)
    if (result < I64{0}) -> return compiler_fs_errno(HOST_IO_OP_WRITE, path, -result, error)
    I64{1}
}

// std::fs::rename(candidate, target): Write errors name `target`.
