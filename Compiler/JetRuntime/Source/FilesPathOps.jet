// File::open(parent) then sync_all: open O_RDONLY|O_CLOEXEC and fsync, both
// EINTR retried; either failure is Flush naming `target`.
#Export(c) fn jet_files_atomic_sync_parent_raw(parent: I64, target: I64, error: I64) -> I64 {
    if !files_paths_valid(parent, parent, target, HOST_IO_OP_FLUSH, error) -> return I64{0}
    name :: fd_c_path(parent)
    fd := I64{-4}
    loop fd == (I64{-4}) -> fd = host_call(I64{2}, name, I64{524288}, I64{0})
    fd_c_path_drop(name, parent)
    if (fd < I64{0}) -> return compiler_fs_errno(HOST_IO_OP_FLUSH, target, -fd, error)
    result := I64{-4}
    loop result == (I64{-4}) -> result = host_call(I64{74}, fd, I64{0}, I64{0})
    _ := host_call(I64{3}, fd, I64{0}, I64{0})
    if (result < I64{0}) -> return compiler_fs_errno(HOST_IO_OP_FLUSH, target, -result, error)
    I64{1}
}
