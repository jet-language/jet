// COMPILER-NEEDED jet_std_json_parse: raw E4 -> canonical ordered native Dyn.
// Canonical oracle JetStd/JSONDyn.rs::parse_json_dyn delegates to
// EncodingJson.rs::parse_json_exact_numbers(text,true): all numbers Number.
// EncodingJson.rs:123-425 supplies grammar, consumption order and depth=64;
// EncodingErrors.rs supplies reason bytes. Adapter always emits JSON/Syntax,
// offset=0, Some(line), None column, empty path, None cause, even at limits.
// No Core policy-parser 16MiB/depth256/path/column semantics are substituted.
// E4 is valid UTF-8 as Rust &str was; walk scalars without a chars Vec copy.
// State words: borrowed data/length, byte cursor, consumed-LF line, owned error.
fn compiler_json_peek(state: I64) -> I64 {
    at :: rt_text_word(state + I64{16})
    if (at == rt_text_word(state + I64{8})) -> return I64{-1}
    rt_text_decode(rt_text_word(state) + at)
}
fn compiler_json_bump(state: I64) {
    at :: rt_text_word(state + I64{16})
    data :: rt_text_word(state)
    if (rt_text_byte(data + at) == I64{10}) -> rt_text_store(state + I64{24}, rt_text_word(state + I64{24}) + I64{1})
    rt_text_store(state + I64{16}, at + rt_text_width(data + at))
}
fn compiler_json_ws(state: I64) {
    loop {
        ch :: compiler_json_peek(state)
        if (ch != I64{32} && ch != I64{9} && ch != I64{13} && ch != I64{10}) -> return
        compiler_json_bump(state)
    }
}
fn compiler_json_error_owned(state: I64, reason: I64) -> I64 {
    error :: jet_rt_alloc(ENCODING_ERROR_BYTES, I64{8})
    encoding_store(error + ENCODING_ERROR_FORMAT, I64{0})
    encoding_store(error + ENCODING_ERROR_KIND, I64{0})
    encoding_store(error + ENCODING_ERROR_OFFSET, I64{0})
    encoding_store(error + ENCODING_ERROR_LINE_PRESENT, I64{1})
    encoding_store(error + ENCODING_ERROR_LINE, rt_text_word(state + I64{24}))
    encoding_store(error + ENCODING_ERROR_COLUMN_PRESENT, I64{0})
    encoding_store(error + ENCODING_ERROR_COLUMN, I64{0})
    encoding_store(error + ENCODING_ERROR_PATH, rt_text_copy(I64{1}, I64{0}))
    encoding_store(error + ENCODING_ERROR_REASON, reason)
    encoding_store(error + ENCODING_ERROR_CAUSE, I64{0})
    rt_text_store(state + I64{32}, error)
    I64{0}
}
fn compiler_json_error(state: I64, reason: I64) -> I64 {
    compiler_json_error_owned(state, jet_rt_string_clone(reason))
}
fn compiler_json_hex4(state: I64) -> I64 {
    value := I64{0}
    count := I64{0}
    loop count < (I64{4}) {
        ch :: compiler_json_peek(state)
        if (ch == I64{-1}) {
            _ := compiler_json_error(state, rt_static_text("truncated unicode escape"))
            return I64{-1}
        }
        digit :: if (ch >= I64{48} && ch <= I64{57}) -> ch - I64{48} else if (ch >= I64{65} && ch <= I64{70}) -> ch - I64{55} else if (ch >= I64{97} && ch <= I64{102}) -> ch - I64{87} else -> I64{-1}
        if (digit == I64{-1}) {
            _ := compiler_json_error(state, rt_static_text("invalid unicode escape"))
            return I64{-1}
        }
        value = value * I64{16} + digit
        compiler_json_bump(state)
        count += I64{1}
    }
    value
}
fn compiler_json_unicode(state: I64, target: I64) -> Bool {
    high :: compiler_json_hex4(state)
    if (high == I64{-1}) -> return false
    scalar := high
    if (high >= I64{55296} && high <= I64{56319}) {
        if (compiler_json_peek(state) != I64{92}) {
            _ := compiler_json_error(state, rt_static_text("unpaired surrogate in string"))
            return false
        }
        compiler_json_bump(state)
        if (compiler_json_peek(state) != I64{117}) {
            _ := compiler_json_error(state, rt_static_text("unpaired surrogate in string"))
            return false
        }
        compiler_json_bump(state)
        low :: compiler_json_hex4(state)
        if (low == I64{-1}) -> return false
        if (low < I64{56320} || low > I64{57343}) {
            _ := compiler_json_error(state, rt_static_text("unpaired surrogate in string"))
            return false
        }
        scalar = I64{65536} + ((high - I64{55296}) << I64{10}) + low - I64{56320}
    } else if (high >= I64{56320} && high <= I64{57343}) {
        _ := compiler_json_error(state, rt_static_text("unpaired surrogate in string"))
        return false
    }
    rt_text_push_scalar(target, scalar)
    true
}
fn compiler_json_string(state: I64) -> I64 {
    if (compiler_json_peek(state) != I64{34}) -> return compiler_json_error(state, rt_static_text("expected quoted text"))
    compiler_json_bump(state)
    target :: jet_rt_string_builder_new()
    loop {
        ch :: compiler_json_peek(state)
        if (ch == I64{-1}) {
            _ := compiler_json_error(state, rt_static_text("missing closing quote"))
            break
        }
        compiler_json_bump(state)
        if (ch == I64{34}) -> return jet_rt_string_builder_finish(target)
        if (ch == I64{92}) {
            escape :: compiler_json_peek(state)
            if (escape == I64{-1}) {
                _ := compiler_json_error(state, rt_static_text("unfinished escape"))
                break
            }
            compiler_json_bump(state)
            if (escape == I64{117}) {
                if !compiler_json_unicode(state, target) -> break
            } else {
                scalar :: if (escape == I64{34} || escape == I64{92} || escape == I64{47}) -> escape else if (escape == I64{98}) -> I64{8} else if (escape == I64{102}) -> I64{12} else if (escape == I64{110}) -> I64{10} else if (escape == I64{114}) -> I64{13} else if (escape == I64{116}) -> I64{9} else -> I64{-1}
                if (scalar == I64{-1}) {
                    _ := compiler_json_error(state, rt_static_text("invalid escape in string"))
                    break
                }
                rt_text_push_scalar(target, scalar)
            }
        } else if (ch < I64{32}) {
            _ := compiler_json_error(state, rt_static_text("control character in string"))
            break
        } else { rt_text_push_scalar(target, ch) }
    }
    jet_rt_string_drop(target)
    I64{0}
}
fn compiler_json_digit(state: I64) -> Bool {
    ch :: compiler_json_peek(state)
    ch >= I64{48} && ch <= I64{57}
}
fn compiler_json_number(state: I64) -> I64 {
    start :: rt_text_word(state + I64{16})
    if (compiler_json_peek(state) == I64{45}) -> compiler_json_bump(state)
    if (compiler_json_peek(state) == I64{48}) { compiler_json_bump(state) } else if (compiler_json_peek(state) >= I64{49} && compiler_json_peek(state) <= I64{57}) {
        loop compiler_json_digit(state) -> compiler_json_bump(state)
    } else { return compiler_json_error(state, rt_static_text("bad number")) }
    if (compiler_json_peek(state) == I64{46}) {
        compiler_json_bump(state)
        if !compiler_json_digit(state) -> return compiler_json_error(state, rt_static_text("bad number"))
        loop compiler_json_digit(state) -> compiler_json_bump(state)
    }
    exponent_start := I64{-1}
    exponent_negative := false
    if (compiler_json_peek(state) == I64{101} || compiler_json_peek(state) == I64{69}) {
        compiler_json_bump(state)
        exponent_negative = compiler_json_peek(state) == I64{45}
        if (compiler_json_peek(state) == I64{43} || compiler_json_peek(state) == I64{45}) -> compiler_json_bump(state)
        exponent_start = rt_text_word(state + I64{16})
        if !compiler_json_digit(state) -> return compiler_json_error(state, rt_static_text("bad number"))
        loop compiler_json_digit(state) -> compiler_json_bump(state)
    }
    end :: rt_text_word(state + I64{16})
    data :: rt_text_word(state)
    digits := I64{0}
    at := start
    loop at < end {
        byte :: rt_text_byte(data + at)
        if (byte >= I64{48} && byte <= I64{57}) -> digits += I64{1}
        at += I64{1}
    }
    // JSONNumber.rs:10-28 validates total digits first, then i64 exponent,
    // then abs(exponent)<=1e6. Finite-f64 restrictions do not apply to Number.
    if (digits > I64{1000000}) -> return compiler_json_error(state, rt_static_text("JSON number exceeds the 1000000-digit limit"))
    if (exponent_start != I64{-1}) {
        limit :: if exponent_negative -> I64{-9223372036854775808} else -> I64{-9223372036854775807}
        exponent := I64{0}
        at = exponent_start
        loop at < end {
            digit :: rt_text_byte(data + at) - I64{48}
            // The smallest exponent whose *10 stays >= limit: ceil(limit / 10), i.e. the
            // truncated quotient. `/%` floors, so divide the negated sign pair.
            if (exponent < -(limit /% I64{-10})) -> return compiler_json_error(state, rt_static_text("JSON number exponent is out of range"))
            exponent *= I64{10}
            if exponent < limit + digit -> return compiler_json_error(state, rt_static_text("JSON number exponent is out of range"))
            exponent -= digit
            at += I64{1}
        }
        if (exponent < I64{-1000000}) -> return compiler_json_error(state, rt_static_text("JSON number exponent exceeds the ±1000000 limit"))
    }
    data_tree_new(DATA_TREE_NUMBER, rt_text_copy(data + start, end - start))
}
fn compiler_json_word(state: I64, word: I64, kind: I64, payload: I64) -> I64 {
    at := I64{0}
    loop at < rt_text_len(word) {
        if compiler_json_peek(state) != rt_text_byte(rt_text_data(word) + at) -> return compiler_json_error(state, rt_static_text("expected a JSON word"))
        compiler_json_bump(state)
        at += I64{1}
    }
    data_tree_new(kind, payload)
}
fn compiler_json_container(state: I64, depth: I64, object: Bool) -> I64 {
    if (depth >= I64{64}) -> return compiler_json_error(state, rt_static_text("JSON value is nested too deeply"))
    compiler_json_bump(state)
    kind :: if object -> DATA_TREE_OBJECT else -> DATA_TREE_ARRAY
    stride :: if object -> DATA_TREE_ENTRY_BYTES else -> DATA_TREE_ELEMENT_BYTES
    close :: if object -> I64{125} else -> I64{93}
    separator :: if object -> rt_static_text("expected `,` or `}}`") else -> rt_static_text("expected `,` or `]`")
    sequence :: data_sequence_new(I64{0}, stride)
    loop {
        compiler_json_ws(state)
        if compiler_json_peek(state) == close {
            compiler_json_bump(state)
            return data_tree_new(kind, sequence)
        }
        key := I64{0}
        if object {
            key = compiler_json_string(state)
            if (key == I64{0}) -> break
            compiler_json_ws(state)
            if (compiler_json_peek(state) != I64{58}) {
                jet_rt_string_drop(key)
                _ := compiler_json_error(state, rt_static_text("expected `:` after object key"))
                break
            }
            compiler_json_bump(state)
            length :: data_tree_word(sequence + DATA_SEQUENCE_LENGTH)
            data :: data_tree_word(sequence + DATA_SEQUENCE_DATA)
            duplicate := false
            at := I64{0}
            loop at < length {
                if jet_rt_string_eq(key, data_tree_word(data + at * stride + DATA_TREE_ENTRY_KEY)) {
                    duplicate = true
                    break
                }
                at += I64{1}
            }
            if duplicate {
                reason :: jet_rt_string_builder_new()
                jet_rt_string_builder_push(reason, rt_static_text("duplicate object key `"))
                jet_rt_string_builder_push(reason, key)
                rt_text_push_scalar(reason, I64{96})
                jet_rt_string_drop(key)
                _ := compiler_json_error_owned(state, jet_rt_string_builder_finish(reason))
                break
            }
        }
        child :: compiler_json_value(state, depth + I64{1})
        if (child == I64{0}) {
            if object -> jet_rt_string_drop(key)
            break
        }
        slot :: data_sequence_reserve(sequence, stride)
        if object {
            data_tree_store(slot + DATA_TREE_ENTRY_KEY, key)
            data_tree_store(slot + DATA_TREE_ENTRY_VALUE, child)
        } else { data_tree_store(slot, child) }
        data_tree_store(sequence + DATA_SEQUENCE_LENGTH, data_tree_word(sequence + DATA_SEQUENCE_LENGTH) + I64{1})
        compiler_json_ws(state)
        ch :: compiler_json_peek(state)
        if (ch == I64{44}) {
            compiler_json_bump(state)
            compiler_json_ws(state)
            if compiler_json_peek(state) == close {
                _ := compiler_json_error(state, separator)
                break
            }
        } else if ch != close {
            _ := compiler_json_error(state, separator)
            break
        }
    }
    data_sequence_drop(sequence, kind)
    I64{0}
}
fn compiler_json_value(state: I64, depth: I64) -> I64 {
    compiler_json_ws(state)
    ch :: compiler_json_peek(state)
    if (ch == I64{110}) -> return compiler_json_word(state, rt_static_text("null"), DATA_TREE_NULL, I64{0})
    if (ch == I64{116}) -> return compiler_json_word(state, rt_static_text("true"), DATA_TREE_BOOL, I64{1})
    if (ch == I64{102}) -> return compiler_json_word(state, rt_static_text("false"), DATA_TREE_BOOL, I64{0})
    if (ch == I64{34}) {
        text :: compiler_json_string(state)
        if (text == I64{0}) -> return I64{0}
        return data_tree_new(DATA_TREE_TEXT, text)
    }
    if (ch == I64{91}) -> return compiler_json_container(state, depth, false)
    if (ch == I64{123}) -> return compiler_json_container(state, depth, true)
    if (ch == I64{45} || (ch >= I64{48} && ch <= I64{57})) -> return compiler_json_number(state)
    compiler_json_error(state, rt_static_text("expected a JSON value"))
}
#Export(c) fn jet_std_json_parse(a0: I64, ok: I64, err: I64) -> I64 {
    state :: jet_rt_alloc(I64{40}, I64{8})
    rt_text_store(state, rt_text_data(a0))
    rt_text_store(state + I64{8}, rt_text_len(a0))
    rt_text_store(state + I64{16}, I64{0})
    rt_text_store(state + I64{24}, I64{1})
    rt_text_store(state + I64{32}, I64{0})
    tree := compiler_json_value(state, I64{0})
    if (tree != I64{0}) {
        compiler_json_ws(state)
        if (rt_text_word(state + I64{16}) != rt_text_word(state + I64{8})) {
            jet_rt_handle_drop_dyn(tree)
            tree = compiler_json_error(state, rt_static_text("extra text after JSON value"))
        }
    }
    if (tree == I64{0}) {
        rt_text_store(err, rt_text_word(state + I64{32}))
        jet_rt_free(state, I64{40}, I64{8})
        return I64{0}
    }
    rt_text_store(ok, tree)
    jet_rt_free(state, I64{40}, I64{8})
    I64{1}
}
