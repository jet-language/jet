// L8a scheduler: an OS worker runs each task to completion. A wait returns a
// delivered stop word; no Jet frame unwinds. Linux synchronization is Sync.jet.
// Control128: refs0 paused8 cancelled16 pauseMode24 status32 stop40 pending48
// observe56 park64 mutex72 waiters80 callbacks88 inline96 scopeFlags104
// requestedRootCode112 capture120. StopCleanup's opaque token owns old flags.
// Stop56: kind0 jct8 owner16 start24 end32 owned E4 message40 form48 (0 raw,
// 1 rendered diagnostic); -1 denotes absent optional comptime metadata.

// #4890: role facts belong to the real current control, never Rust TLS.
SCHEDULER_SCOPE_ROOT: I64{1}
SCHEDULER_SCOPE_TASK: I64{2}
SCHEDULER_SCOPE_CLEANUP: I64{4}
SCHEDULER_SCOPE_INHERITED_STOP: I64{8}
SCHEDULER_SCOPE_TASK_CLEANUP_ORIGIN: I64{16}
SCHEDULER_SCOPE_MASK_KIND: I64{1792}

// Exact E4 carrier; rounded byte capacity allows generated literal word stores.
scheduler_text_new: fn(length: I64) -> I64 {
    capacity: (length + I64{7}).bit_and(I64{-8})
    text: rt_text_with_length(length, capacity)
    if (text == I64{0}) -> return I64{0}
    if (capacity != I64{0}) -> coll_zero(sync_load(text), capacity)
    text
}

scheduler_text_empty: fn() -> I64 { rt_text_copy(I64{1}, I64{0}) }

scheduler_text_concat: fn(left: I64, right: I64) -> I64 {
    a: sync_load(wrapping(left + I64{8}))
    b: sync_load(wrapping(right + I64{8}))
    if (b > I64{9223372036854775807} - a) {
        rt_text_capacity_stop()
        return I64{0}
    }
    result: scheduler_text_new(a + b)
    if (result == I64{0} && jet_rt_session_propagate() != I64{0}) -> return I64{0}
    coll_copy(sync_load(left), sync_load(result), a)
    coll_copy(sync_load(right), wrapping(sync_load(result) + a), b)
    result
}

scheduler_words_push: fn(header: I64, word: I64) {
    length: sync_load(header)
    thread_words_grow(header, length + I64{1})
    sync_store(wrapping(sync_load(wrapping(header + I64{16})) + length * I64{8}), word)
    sync_store(header, length + I64{1})
}

scheduler_words_drop: fn(header: I64) {
    capacity: sync_load(wrapping(header + I64{8}))
    if (capacity != I64{0}) -> jet_rt_free(sync_load(wrapping(header + I64{16})), capacity * I64{8}, I64{8})
    jet_rt_free(header, I64{24}, I64{8})
}

// Every control starts here, so the stop rail's root half (Trap.jet
// trap_root_rail_code) is installed before any control can hold a stop.
scheduler_control_new: fn() -> I64 {
    if (trap_root_rail_code == I64{0}) {
        #Unsafe("an idempotent install: every writer stores the same code address") {
            trap_root_rail_code = rt_trap_root_address()
        }
    }
    control: jet_rt_alloc(I64{128}, I64{8})
    thread_zero(control, I64{128})
    sync_store(control, I64{1})
    sync_store(wrapping(control + I64{64}), sync_park_new())
    control
}

// Trap.jet trap_root's target: the root's half of a trap, which the trap
// reaches only once it has found the control that holds its capture or owns
// its stop. PREPARE begins a root stop's captured report. WRITE and
// WRITE_WORD append `b` (an address or a word) of `c` bytes to the capture
// `a`. EXIT publishes the captured report with status `a` to the root; an
// exit with no captured report (jet_rt_process_exit called directly, as an
// `#Import(c)` caller does) has nothing to publish, so it returns 0 and the
// trap ends the process with `a` itself. DROP discards the capture of
// control `a`. The others return 1.
#Export(c) jet_rt_trap_root: fn(op: I64, a: I64, b: I64, c: I64) -> I64 {
    if (op == TRAP_ROOT_PREPARE) {
        _ := scheduler_panic_check()
        scheduler_root_capture_begin()
    } else if (op == TRAP_ROOT_EXIT) {
        text: scheduler_root_capture_take(scheduler_control_current())
        if (text == I64{0}) -> return I64{0}
        _ := scheduler_root_publish_owned(text, a)
    } else if (op == TRAP_ROOT_DROP) {
        jet_rt_string_drop(scheduler_root_capture_take(a))
    } else if (op == TRAP_ROOT_WRITE) {
        rt_text_append(a, b, c)
    } else {
        rt_text_append_raw_word(a, b, c)
    }
    I64{1}
}

// RuntimeLower resolves this checked function-address entry, never the body.
rt_trap_root_address: fn() -> I64 {
    loop { jet_rt_unreachable(I64{0}, I64{0}) }
}

scheduler_control_retain: fn(control: I64) {
    if (control != I64{0}) -> _ := sync_add(control, I64{1})
}

scheduler_stop_drop: fn(record: I64) {
    if (record == I64{0}) -> return
    jet_rt_string_drop(sync_load(wrapping(record + I64{40})))
    jet_rt_free(record, I64{56}, I64{8})
}

scheduler_stop_take_message: fn(record: I64) -> I64 {
    sync_swap(wrapping(record + I64{40}), I64{0})
}

scheduler_control_drop: fn(control: I64) {
    if (control == I64{0}) -> return
    if (sync_add(control, I64{-1}) != I64{1}) -> return
    scheduler_stop_drop(sync_load(wrapping(control + I64{40})))
    jet_rt_string_drop(scheduler_root_capture_take(control))
    sync_park_drop(sync_load(wrapping(control + I64{64})))
    // Scoped waiter/callback guards retain the control and unregister first.
    if (sync_load(wrapping(control + I64{80})) != I64{0} || sync_load(wrapping(control + I64{88})) != I64{0}) -> jet_rt_unreachable(I64{0}, I64{0})
    jet_rt_free(control, I64{128}, I64{8})
}

scheduler_control_current: fn() -> I64 { sync_load(wrapping(thread_base() + I64{16})) }

// Only diagnostic/startup paths use this syscall probe. The attached hot
// scheduler query above remains a single TCB load. A failed probe is a host
// defect: do not recurse into a reporter whose ownership cannot be established.
// An unattached thread's GS names the detached zero word; report it as 0.
scheduler_report_base: fn() -> I64 {
    base := I64{0}
    #Unsafe("the cold OS leaf borrows its initialized stack word; a successful nonzero base is this attached thread's live Jet TCB or the detached zero word") {
        base = os_tls_base_probe_i64()
    }
    if (base < I64{0}) -> trap_gs_failure()
    if (base == thread_detached_base()) -> I64{0} else -> base
}
scheduler_report_control_current: fn() -> I64 {
    base: scheduler_report_base()
    if (base == I64{0}) -> return I64{0}
    sync_load(wrapping(base + I64{16}))
}
scheduler_report_domain: fn() -> I64 {
    if (scheduler_report_base() == I64{0}) -> return I64{0}
    jet_rt_stop_domain()
}
scheduler_control_status: fn(control: I64) -> I64 {
    if (control == I64{0}) -> I64{0} else -> sync_load(wrapping(control + I64{32}))
}

// Caller owns 32B and keeps the borrowed controls alive for the entire scope.
// Deadlines remain inherited in @48/@56, including the inner test boundary.
scheduler_control_enter: fn(control: I64, save: I64) {
    base: thread_base()
    parent: sync_load(wrapping(base + I64{16}))
    sync_store(save, parent)
    sync_store(wrapping(save + I64{8}), sync_load(wrapping(base + I64{24})))
    sync_store(wrapping(save + I64{16}), sync_load(wrapping(base + I64{32})))
    sync_store(wrapping(save + I64{24}), sync_load(wrapping(base + I64{64})))
    sync_store(wrapping(base + I64{16}), control)
    if parent != control -> sync_store(wrapping(base + I64{24}), I64{0})
    sync_store(wrapping(base + I64{32}), sync_load(wrapping(base + I64{32})) + I64{1})
}

scheduler_control_leave: fn(save: I64) {
    base: thread_base()
    sync_store(wrapping(base + I64{16}), sync_load(save))
    sync_store(wrapping(base + I64{24}), sync_load(wrapping(save + I64{8})))
    sync_store(wrapping(base + I64{32}), sync_load(wrapping(save + I64{16})))
    sync_store(wrapping(base + I64{64}), sync_load(wrapping(save + I64{24})))
}

// A process/test/doc root is not a Task frame. Keep the parent's control,
// shield, wait depth and body provenance untouched in the caller's save slot.
#Export(c) jet_rt_root_begin: fn(save: I64) -> I64 {
    parent: scheduler_control_current()
    parent_flags: scheduler_scope_flags(parent)
    inherited: (parent_flags.bit_and(SCHEDULER_SCOPE_INHERITED_STOP)) != I64{0} ||
        ((parent_flags.bit_and(SCHEDULER_SCOPE_CLEANUP)) != I64{0} && scheduler_scope_delivered_kind(parent_flags) != I64{0})
    control: scheduler_control_new()
    sync_store(wrapping(control + I64{104}), SCHEDULER_SCOPE_ROOT.bit_or((if inherited -> SCHEDULER_SCOPE_INHERITED_STOP else -> I64{0})))
    // jet_scheduler_with_root_control: an entry with no current control runs
    // under the process root task control.
    if (parent == I64{0}) -> scheduler_process_root_install(control)
    scheduler_control_enter(control, save)
    sync_store(wrapping(thread_base() + I64{64}), I64{0})
    control
}
#Export(c) jet_rt_root_leave: fn(control: I64, save: I64) {
    scheduler_control_leave(save)
    scheduler_process_root_release(control)
    scheduler_control_drop(control)
}

// The process root task control. Process signals cancel it; a cancelled (or
// absent) root is replaced by a fresh root control at the next lookup, which
// the running entry does not adopt. The slot owns one reference and is guarded
// by the scheduler root mutex.
scheduler_process_root := I64{0}

scheduler_process_root_install: fn(control: I64) {
    scheduler_control_retain(control)
    sync_thread_lock(scheduler_root)
    previous: scheduler_process_root
    #Unsafe("written under the scheduler root mutex") {
        scheduler_process_root = control
    }
    sync_thread_unlock(scheduler_root)
    scheduler_control_drop(previous)
}

scheduler_process_root_release: fn(control: I64) {
    sync_thread_lock(scheduler_root)
    owned: scheduler_process_root == control
    if owned {
        #Unsafe("written under the scheduler root mutex") {
            scheduler_process_root = I64{0}
        }
    }
    sync_thread_unlock(scheduler_root)
    if owned -> scheduler_control_drop(control)
}

// Returns a retained reference the caller drops.
scheduler_root_task_control: fn() -> I64 {
    sync_thread_lock(scheduler_root)
    previous: scheduler_process_root
    replaced := I64{0}
    if (previous == I64{0} || sync_load(wrapping(previous + I64{16})) != I64{0}) {
        fresh: scheduler_control_new()
        sync_store(wrapping(fresh + I64{104}), SCHEDULER_SCOPE_ROOT)
        #Unsafe("written under the scheduler root mutex") {
            scheduler_process_root = fresh
        }
        replaced = previous
    }
    control: scheduler_process_root
    scheduler_control_retain(control)
    sync_thread_unlock(scheduler_root)
    scheduler_control_drop(replaced)
    control
}

scheduler_control_is_root: fn(control: I64) -> Bool { (scheduler_scope_flags(control).bit_and(SCHEDULER_SCOPE_ROOT)) != I64{0} }

// jet_task_deliver_cancel: only a task unwinds a delivered cancellation. A
// cancelled root has no catch frame: its wait points observe the flag and
// return their cooperative fallback without publishing a stop.
scheduler_root_cancel_observed: fn() -> Bool {
    control: scheduler_control_current()
    control != I64{0} && scheduler_control_is_root(control) && sync_load(wrapping(control + I64{16})) != I64{0} && !scheduler_shielded()
}

// Only scheduler_text_new's owned, eight-aligned 24B E4 header is tagged.
// Bit0 records an actual requested code independently of opaque scope flags.
scheduler_root_capture_pointer: fn(control: I64) -> I64 {
    if (control == I64{0}) -> I64{0} else -> sync_load(wrapping(control + I64{120})).bit_and(I64{-2})
}
scheduler_root_capture_begin: fn() {
    control: scheduler_control_current()
    if (scheduler_root_capture_pointer(control) != I64{0}) -> scheduler_abort_double_panic()
    text: scheduler_text_empty()
    sync_store(wrapping(control + I64{120}), text.bit_or((sync_load(wrapping(control + I64{120})).bit_and(I64{1}))))
}
scheduler_root_capture_take: fn(control: I64) -> I64 {
    word: sync_load(wrapping(control + I64{120}))
    sync_store(wrapping(control + I64{120}), word.bit_and(I64{1}))
    word.bit_and(I64{-2})
}
scheduler_root_code_known: fn(control: I64) -> Bool { (sync_load(wrapping(control + I64{120})).bit_and(I64{1})) != I64{0} }
scheduler_root_set_code: fn(control: I64, code: I64) {
    sync_store(wrapping(control + I64{112}), code)
    sync_store(wrapping(control + I64{120}), sync_load(wrapping(control + I64{120})).bit_or(I64{1}))
}

// Takes an already checked Panic record. This one named publication sink is
// shared by Task, Root, rendered Sentry and transported Parallel failures.
scheduler_panic_publish_record: fn(record: I64) -> Bool {
    control: scheduler_control_current()
    if ((scheduler_scope_flags(control).bit_and(SCHEDULER_SCOPE_ROOT)) != I64{0}) {
        if (sync_load(wrapping(record + I64{48})) == I64{0}) {
            old: scheduler_stop_take_message(record)
            rendered: trap_root_panic_report(old)
            jet_rt_string_drop(old)
            sync_store(wrapping(record + I64{40}), rendered)
            sync_store(wrapping(record + I64{48}), I64{1})
        }
        if !scheduler_root_code_known(control) -> scheduler_root_set_code(control, I64{70})
    }
    scheduler_native_publish(record)
}
scheduler_root_publish_owned: fn(text: I64, code: I64) -> Bool {
    if (jet_rt_stop_domain() != I64{1}) {
        jet_rt_string_drop(text)
        return false
    }
    if !scheduler_panic_check() {
        jet_rt_string_drop(text)
        return false
    }
    record: scheduler_stop_new(I64{5}, text)
    sync_store(wrapping(record + I64{48}), I64{1})
    scheduler_root_set_code(scheduler_control_current(), code)
    scheduler_panic_publish_record(record)
}
#Export(c) jet_rt_root_publish_rendered: fn(message: I64, length: I64, requested_code: I64) -> Bool {
    if (jet_rt_stop_domain() != I64{1} || !scheduler_panic_check()) -> return false
    text := I64{0}
    if (length != I64{0}) {
        text = scheduler_text_new(length)
        if (text == I64{0} && jet_rt_session_propagate() != I64{0}) -> return false
        coll_copy(message, sync_load(text), length)
    }
    record: scheduler_stop_new(I64{5}, text)
    sync_store(wrapping(record + I64{48}), I64{1})
    scheduler_root_set_code(scheduler_control_current(), requested_code)
    scheduler_panic_publish_record(record)
}
#Export(c) jet_rt_root_take_stop: fn(control: I64, code_out: I64) -> I64 {
    record: scheduler_control_take_stop(control)
    if (record == I64{0}) -> return I64{0}
    kind: sync_load(record)
    if (kind == I64{1} || kind < I64{1} || kind > I64{5}) -> jet_rt_unreachable(I64{0}, I64{0})
    code := I64{70}
    if {
        (kind == I64{3} || kind == I64{4}) -> {
            status: if (kind == I64{3}) -> I64{2} else -> I64{3}
            if (sync_load(wrapping(record + I64{8})) != status) -> jet_rt_unreachable(I64{0}, I64{0})
            _ := comptime_stop_frame_write(status, sync_load(wrapping(record + I64{16})),
                sync_load(wrapping(record + I64{24})), sync_load(wrapping(record + I64{32})))
            jet_rt_string_drop(scheduler_stop_take_message(record))
            code = I64{80} + status
        }
        (kind == I64{5}) -> {
            if (sync_load(wrapping(record + I64{48})) != I64{1} || !scheduler_root_code_known(control)) -> jet_rt_unreachable(I64{0}, I64{0})
            code = sync_load(wrapping(control + I64{112}))
        }
        // Deadline already owns the complete registered E3003 report.
        else -> {}
    }
    sync_store(wrapping(record + I64{48}), I64{1})
    sync_store(code_out, code)
    sync_store(wrapping(control + I64{120}), sync_load(wrapping(control + I64{120})).bit_and(I64{-2}))
    record
}

scheduler_control_take_stop: fn(control: I64) -> I64 {
    sync_mutex_lock(wrapping(control + I64{72}))
    record: sync_swap(wrapping(control + I64{40}), I64{0})
    sync_store(wrapping(control + I64{32}), I64{0})
    sync_mutex_unlock(wrapping(control + I64{72}))
    record
}
scheduler_control_discard_stop: fn(control: I64) { scheduler_stop_drop(scheduler_control_take_stop(control)) }

// Every stop record settles the test harness's assertion mark (TestCapture.jet
// test_stop_assertion_settle): only a rendered report (kind 5) keeps it.
scheduler_stop_new: fn(kind: I64, message: I64) -> I64 {
    test_stop_assertion_settle(kind == I64{5})
    record: jet_rt_alloc(I64{56}, I64{8})
    sync_store(record, kind)
    sync_store(wrapping(record + I64{8}), I64{-1})
    sync_store(wrapping(record + I64{16}), I64{-1})
    sync_store(wrapping(record + I64{24}), I64{-1})
    sync_store(wrapping(record + I64{32}), I64{-1})
    sync_store(wrapping(record + I64{40}), message)
    sync_store(wrapping(record + I64{48}), I64{0})
    record
}

// Takes the record, including on rejection. First stop wins, except Deadline
// supersedes Cancelled. Record precedes release status.
scheduler_control_publish: fn(control: I64, record: I64) -> Bool {
    kind: sync_load(record)
    // A root never unwinds a cancellation (scheduler_root_cancel_observed).
    if (control == I64{0} || kind < I64{1} || kind > I64{5} || (kind == I64{5} && jet_rt_stop_domain() == I64{0}) || (kind == I64{1} && scheduler_control_is_root(control))) {
        scheduler_stop_drop(record)
        return false
    }
    // jet_rt_main ends an entry stopped at the process root through this
    // hook, which only a stop published there needs.
    if (control == main_root_control && main_stopped_code == I64{0}) -> main_stopped_install(rt_main_stopped_address())
    sync_mutex_lock(wrapping(control + I64{72}))
    old: sync_load(wrapping(control + I64{32}))
    // A task panic replaces an undelivered cancellation/deadline/budget.
    // rt_task_panic_publish has already rejected a delivered double panic.
    accepted: old == I64{0} || (old == I64{1} && kind == I64{2}) ||
        (kind == I64{5} && old >= I64{1} && old <= I64{4})
    previous := I64{0}
    if accepted {
        previous = sync_load(wrapping(control + I64{40}))
        sync_store(wrapping(control + I64{40}), record)
        sync_store(wrapping(control + I64{32}), kind)
    }
    sync_mutex_unlock(wrapping(control + I64{72}))
    if accepted -> scheduler_stop_drop(previous) else -> scheduler_stop_drop(record)
    // jet_rt_main's root takes every stop it accepts and ends the process,
    // so the frames unwinding to it leave their heap to the kernel (#5478).
    if accepted && control == main_root_control -> main_process_end()
    accepted
}

scheduler_native_publish: fn(record: I64) -> Bool { scheduler_control_publish(scheduler_control_current(), record) }
scheduler_shielded: fn() -> Bool { sync_load(wrapping(thread_base() + I64{24})) > I64{0} }

scheduler_scope_flags: fn(control: I64) -> I64 {
    if (control == I64{0}) -> I64{0} else -> sync_load(wrapping(control + I64{104}))
}
scheduler_scope_delivered_kind: fn(flags: I64) -> I64 { (flags.bit_and(SCHEDULER_SCOPE_MASK_KIND)) >> I64{8} }

// Origin16 is dynamic: only an actual native Task frame can mint it.
// The saved scalar is owned; zero is a valid token and must also be restored.
#Export(c) jet_rt_session_cleanup_enter: fn(delivered_at_entry: I64) -> I64 {
    control: scheduler_control_current()
    if (control == I64{0}) -> return I64{0}
    saved: scheduler_scope_flags(control)
    flags := (saved.bit_and(I64{-1793})).bit_or(SCHEDULER_SCOPE_CLEANUP)
    if (sync_load(wrapping(thread_base() + I64{64})) != I64{0}) -> flags = flags.bit_or(SCHEDULER_SCOPE_TASK_CLEANUP_ORIGIN)
    if (delivered_at_entry >= I64{1} && delivered_at_entry <= I64{5} && scheduler_control_status(control) == delivered_at_entry) {
        flags = flags.bit_or(delivered_at_entry << I64{8})
    }
    sync_store(wrapping(control + I64{104}), flags)
    saved
}
#Export(c) jet_rt_session_cleanup_leave: fn(saved_flags: I64) {
    control: scheduler_control_current()
    if (control != I64{0}) -> sync_store(wrapping(control + I64{104}), saved_flags)
}
// Compiler cleanup frames (Codegen/Builder.jet jet_codegen_emit_cleanup_frame,
// lowered by Routes.jet lower_native_control_call) are one runtime cleanup
// scope plus Shield, the idiom of every runtime-owned close: a stop pending at
// entry stays in its control slot while Check/Propagate delivery of it is
// masked, a new panic over it is process-fatal (scheduler_panic_check), and
// cancellation/deadlines arriving meanwhile are held until leave delivers them.
// The returned word is the owned session token.
#Export(c) jet_rt_cleanup_enter: fn() -> I64 {
    saved: jet_rt_session_cleanup_enter(jet_scheduler_native_status())
    jet_scheduler_shield_enter()
    saved
}
#Export(c) jet_rt_cleanup_leave: fn(saved: I64) {
    jet_scheduler_shield_leave()
    jet_rt_session_cleanup_leave(saved)
}
#Export(c) jet_rt_stop_domain: fn() -> I64 {
    control: scheduler_control_current()
    if (control == I64{0}) -> return I64{0}
    flags: scheduler_scope_flags(control)
    body: sync_load(wrapping(thread_base() + I64{64})) != I64{0}
    if ((flags.bit_and(SCHEDULER_SCOPE_ROOT)) != I64{0} && !body) -> return I64{1}
    if body || ((flags.bit_and(SCHEDULER_SCOPE_TASK)) != I64{0} &&
        (flags.bit_and(SCHEDULER_SCOPE_CLEANUP)) != I64{0} &&
        (flags.bit_and(SCHEDULER_SCOPE_TASK_CLEANUP_ORIGIN)) != I64{0}) -> return I64{2}
    I64{0}
}

scheduler_cleanup_mask: fn(status: I64) -> I64 {
    flags: scheduler_scope_flags(scheduler_control_current())
    delivered: scheduler_scope_delivered_kind(flags)
    if ((flags.bit_and(SCHEDULER_SCOPE_CLEANUP)) != I64{0} && delivered >= I64{1} &&
        delivered <= I64{5} && status == delivered) -> I64{0} else -> status
}

// Shield defers cancellation/deadline/interrupt-class stops, never a panic
// or runtime fault: Rust unwinds those through the shield.
scheduler_delivered_status_unmasked: fn() -> I64 {
    status: scheduler_control_status(scheduler_control_current())
    if scheduler_shielded() && !(status >= I64{3} && status <= I64{5}) -> I64{0} else -> status
}
scheduler_delivered_status: fn() -> I64 {
    scheduler_cleanup_mask(scheduler_delivered_status_unmasked())
}

#Export(c) jet_scheduler_native_status: fn() -> I64 { scheduler_control_status(scheduler_control_current()) }
#Export(c) jet_scheduler_native_poll: fn() -> I64 {
    if scheduler_shielded() -> return scheduler_delivered_status()
    control: scheduler_control_current()
    if (control == I64{0}) -> return I64{0}
    if (sync_swap(wrapping(control + I64{48}), I64{0}) != I64{0}) {
        _ := scheduler_control_publish(control, scheduler_stop_new(I64{1}, scheduler_text_empty()))
    }
    // CheckLoops pauses at Check, but ordinary Task.cancel delivers only waits.
    if (sync_load(wrapping(control + I64{24})) == I64{1}) {
        _ := scheduler_wait_while_paused()
        if (!scheduler_shielded() && sync_load(wrapping(control + I64{16})) != I64{0}) -> scheduler_deliver_cancel()
    }
    scheduler_cleanup_mask(scheduler_control_status(control))
}
#Export(c) jet_scheduler_native_propagate: fn() -> I64 {
    scheduler_delivered_status()
}
#Export(c) jet_rt_session_status: fn() -> I64 { jet_scheduler_native_status() }
#Export(c) jet_rt_session_poll: fn() -> I64 { jet_scheduler_native_poll() }
#Export(c) jet_rt_session_propagate: fn() -> I64 { jet_scheduler_native_propagate() }

#Export(c) jet_scheduler_shield_enter: fn() {
    if (scheduler_control_current() != I64{0}) -> sync_store(wrapping(thread_base() + I64{24}), sync_load(wrapping(thread_base() + I64{24})) + I64{1})
}
#Export(c) jet_scheduler_shield_leave: fn() {
    if (scheduler_control_current() == I64{0}) -> return
    address: wrapping(thread_base() + I64{24})
    depth: sync_load(address)
    sync_store(address, if (depth > I64{0}) -> depth - I64{1} else -> I64{0})
    if (sync_load(address) != I64{0}) -> return
    if {
        (jet_ctx_deadline_present() && jet_deadline_remaining_ms() <= I64{0}) -> {
            kind: scheduler_msg_shield()
            scheduler_deliver_deadline(kind)
            jet_rt_string_drop(kind)
        }
        scheduler_task_cancelled() -> {
            scheduler_deliver_cancel()
        }
    }
}
// Leaves the runtime's own shield around a finished task body's cleanup.
// The body has no wait point left, so a cancel or blown deadline that
// arrived meanwhile has nothing to unwind and does not turn the completed
// value into a failure (cancellation lands only at wait
// points).
scheduler_shield_leave_finished: fn() {
    if (scheduler_control_current() == I64{0}) -> return
    address: wrapping(thread_base() + I64{24})
    depth: sync_load(address)
    sync_store(address, if (depth > I64{0}) -> depth - I64{1} else -> I64{0})
}
#Export(c) jet_rt_session_shield_enter: fn() { jet_scheduler_shield_enter() }
#Export(c) jet_rt_session_shield_leave: fn() { jet_scheduler_shield_leave() }

// jet_rt_task_panic_publish's code word: 0 until the first body enters.
task_panic_code := I64{0}

scheduler_body_enter: fn() -> I64 {
    if (task_panic_code == I64{0}) {
        #Unsafe("an idempotent install: every writer stores the same code address") {
            task_panic_code = rt_task_panic_publish_address()
        }
    }
    sync_swap(wrapping(thread_base() + I64{64}), I64{1})
}
scheduler_body_leave: fn(saved: I64) { sync_store(wrapping(thread_base() + I64{64}), saved) }
// Lower.jet lower_poll_call_enter/leave bracket a checked operation whose
// immediate terminator is a Propagate poll: inside a body (bit 1) the call
// arms bit 2 for its duration; leave restores the caller's word exactly.
#Export(c) jet_rt_poll_call_enter: fn() -> I64 {
    cell: wrapping(thread_base() + I64{64})
    saved: sync_load(cell)
    if (saved.bit_and(I64{1}) != I64{0}) -> sync_store(cell, saved.bit_or(I64{2}))
    saved
}
#Export(c) jet_rt_poll_call_leave: fn(saved: I64) { sync_store(wrapping(thread_base() + I64{64}), saved) }
scheduler_task_cancelled: fn() -> Bool {
    control: scheduler_control_current()
    control != I64{0} && sync_load(wrapping(control + I64{16})) != I64{0}
}
scheduler_deliver_cancel: fn() {
    if scheduler_root_cancel_observed() -> return
    _ := scheduler_native_publish(scheduler_stop_new(I64{1}, scheduler_text_empty()))
}

// Nodes32B: next0, slot/code8, env16, id24. Guards retain the control.
scheduler_cancel_waiter_register: fn(control: I64, slot: I64) -> I64 {
    if (control == I64{0}) -> return I64{0}
    node: jet_rt_alloc(I64{32}, I64{8})
    thread_zero(node, I64{32})
    sync_store(wrapping(node + I64{8}), slot)
    scheduler_control_retain(control)
    sync_mutex_lock(wrapping(control + I64{72}))
    sync_store(node, sync_load(wrapping(control + I64{80})))
    sync_store(wrapping(control + I64{80}), node)
    if (sync_load(wrapping(control + I64{16})) != I64{0}) -> sync_park_wake(slot)
    sync_mutex_unlock(wrapping(control + I64{72}))
    node
}

scheduler_node_unlink: fn(head: I64, node: I64) {
    link := head
    loop sync_load(link) != (I64{0}) {
        current: sync_load(link)
        if current == node {
            sync_store(link, sync_load(node))
            return
        }
        link = current
    }
}

scheduler_cancel_waiter_remove: fn(control: I64, node: I64) {
    if (node == I64{0}) -> return
    sync_mutex_lock(wrapping(control + I64{72}))
    scheduler_node_unlink(control + I64{80}, node)
    sync_mutex_unlock(wrapping(control + I64{72}))
    jet_rt_free(node, I64{32}, I64{8})
    scheduler_control_drop(control)
}

scheduler_control_cancel: fn(control: I64) {
    sync_store(wrapping(control + I64{16}), I64{1})
    jet_rt_observe_task_control(sync_load(wrapping(control + I64{56})), I64{-1}, I64{1})
    sync_park_wake(sync_load(wrapping(control + I64{64})))
    sync_mutex_lock(wrapping(control + I64{72}))
    waiter := sync_load(wrapping(control + I64{80}))
    loop waiter != (I64{0}) {
        sync_park_wake(sync_load(wrapping(waiter + I64{8})))
        waiter = sync_load(waiter)
    }
    // A task this one runs inline (scheduler_control_inline) is cancelled
    // with it, as its join would cancel it on waking.
    forwarded: sync_load(wrapping(control + I64{96}))
    scheduler_control_retain(forwarded)
    callbacks: sync_load(wrapping(control + I64{88}))
    sync_store(wrapping(control + I64{88}), I64{0})
    node := callbacks
    loop node != (I64{0}) {
        sync_store(wrapping(node + I64{32}), I64{1})
        node = sync_load(node)
    }
    sync_mutex_unlock(wrapping(control + I64{72}))
    node = callbacks
    loop node != (I64{0}) {
        next_node: sync_load(node)
        _ := coll_call1(sync_load(wrapping(node + I64{8})), sync_load(wrapping(node + I64{16})))
        // Wake and publication share the control lock so a destructor cannot
        // free the node between the status store and futex wake.
        sync_mutex_lock(wrapping(control + I64{72}))
        sync_store(wrapping(node + I64{32}), I64{2})
        sync_wake(node + I64{32}, I64{2147483647})
        sync_mutex_unlock(wrapping(control + I64{72}))
        node = next_node
    }
    if (forwarded != I64{0}) {
        scheduler_control_cancel(forwarded)
        scheduler_control_drop(forwarded)
    }
}

// Names the control of a task the running task's thread runs inline
// (Task.jet task_run_joined) at the running task's inline96, or clears it
// (0), under the control's lock: a cancel from then on cancels it too. A
// cancel already requested cancels it at once.
scheduler_control_inline: fn(control: I64, target: I64) {
    scheduler_control_retain(target)
    sync_mutex_lock(wrapping(control + I64{72}))
    previous: sync_load(wrapping(control + I64{96}))
    sync_store(wrapping(control + I64{96}), target)
    cancelled: sync_load(wrapping(control + I64{16})) != I64{0}
    sync_mutex_unlock(wrapping(control + I64{72}))
    scheduler_control_drop(previous)
    if (cancelled && target != I64{0}) -> scheduler_control_cancel(target)
}

// A cancel the task has consumed into its own result (an AsyncEvent entry's
// Cancelled report): no later wait point or shield exit delivers it again.
scheduler_control_cancel_consume: fn(control: I64) {
    sync_store(wrapping(control + I64{16}), I64{0})
}

#Export(c) jet_rt_scheduler_control_cancel: fn(control: I64) { scheduler_control_cancel(control) }
#Export(c) jet_rt_scheduler_control_retain: fn(control: I64) { scheduler_control_retain(control) }
#Export(c) jet_rt_scheduler_control_drop: fn(control: I64) { scheduler_control_drop(control) }

scheduler_control_interrupt: fn(control: I64) {
    sync_store(wrapping(control + I64{48}), I64{1})
    scheduler_control_cancel(control)
}
scheduler_control_pause: fn(control: I64, mode: I64) {
    sync_store(wrapping(control + I64{24}), if (mode == I64{1}) -> I64{1} else -> I64{0})
    sync_store(wrapping(control + I64{8}), I64{1})
    jet_rt_observe_task_control(sync_load(wrapping(control + I64{56})), I64{3}, I64{-1})
}
scheduler_control_resume: fn(control: I64) {
    sync_store(wrapping(control + I64{8}), I64{0})
    jet_rt_observe_task_control(sync_load(wrapping(control + I64{56})), I64{1}, I64{-1})
    sync_park_wake(sync_load(wrapping(control + I64{64})))
}

scheduler_wait_while_paused: fn() -> I64 {
    control: scheduler_control_current()
    if (control == I64{0}) -> return I64{0}
    loop sync_load(wrapping(control + (I64{8}))) != (I64{0}) && sync_load(wrapping(control + (I64{16}))) == (I64{0}) {
        timeout := I64{-1}
        if !scheduler_shielded() && jet_ctx_deadline_present() {
            remaining: jet_deadline_remaining_ms()
            if (remaining <= I64{0}) {
                kind: scheduler_msg_pause()
                scheduler_deliver_deadline(kind)
                jet_rt_string_drop(kind)
                return jet_scheduler_native_status()
            }
            timeout = deadline_ms_to_ns(remaining)
        }
        sync_park(sync_load(wrapping(control + I64{64})), timeout)
    }
    jet_scheduler_native_propagate()
}

scheduler_wait_point_cancel_check: fn() -> I64 {
    _ := scheduler_wait_while_paused()
    if scheduler_task_cancelled() && !scheduler_shielded() -> scheduler_deliver_cancel()
    jet_scheduler_native_propagate()
}

scheduler_observe_update: fn(state: I64, wait: I64) {
    jet_rt_observe_task_wait(state, wait, if jet_ctx_deadline_present() -> I64{1} else -> I64{0}, jet_deadline_remaining_ms())
}

// Including its per-site interrupt order.
scheduler_yield: fn(wait_kind: I64, slot: I64, timeout_ns: I64) -> I64 {
    scheduler_yield_policy(wait_kind, slot, timeout_ns, true)
}

// scheduler_yield whose park observes the ambient deadline only when
// `deadline` holds: a join of a typed task its own deadline already bounds
// waits for that task's result instead.
scheduler_yield_policy: fn(wait_kind: I64, slot: I64, timeout_ns: I64, deadline: Bool) -> I64 {
    // A cancelled root wait point returns its fallback without parking.
    if scheduler_root_cancel_observed() -> return I64{0}
    world: world_current()
    if (world != I64{0} && scheduler_control_current() != I64{0}) -> world_begin_wait(world, slot)
    control: scheduler_control_current()
    shielded: scheduler_shielded()
    if (control != I64{0}) -> scheduler_observe_update(I64{2}, wait_kind)
    if (control != I64{0}) {
        if !shielded && scheduler_task_cancelled() {
            scheduler_deliver_cancel()
            return jet_scheduler_native_status()
        }
        _ := scheduler_wait_while_paused()
        if !shielded && scheduler_task_cancelled() {
            scheduler_deliver_cancel()
            return jet_scheduler_native_status()
        }
        if (jet_scheduler_native_propagate() != I64{0}) -> return jet_scheduler_native_status()
    }
    waiter: if !shielded -> scheduler_cancel_waiter_register(control, slot) else -> I64{0}
    wait := timeout_ns
    virtual_wait: (sync_load(wrapping(thread_base() + I64{112})).bit_and(I64{2})) != I64{0}
    if virtual_wait {
        if (wait != I64{0}) -> wait = I64{-1}
    }
    if deadline && !virtual_wait && !shielded && jet_ctx_deadline_present() {
        remaining: jet_deadline_remaining_ms()
        if (remaining <= I64{0}) {
            scheduler_cancel_waiter_remove(control, waiter)
            scheduler_deliver_deadline(wait_kind)
            return jet_scheduler_native_status()
        }
        cap: deadline_ms_to_ns(remaining)
        if (wait < I64{0} || wait > cap) -> wait = cap
    }
    sync_store(wrapping(thread_base() + I64{72}), slot)
    sync_park(slot, wait)
    sync_store(wrapping(thread_base() + I64{72}), I64{0})
    scheduler_cancel_waiter_remove(control, waiter)
    if (deadline && !virtual_wait && !shielded && jet_ctx_deadline_present() && jet_deadline_remaining_ms() <= I64{0}) {
        scheduler_deliver_deadline(wait_kind)
        return jet_scheduler_native_status()
    }
    if !shielded && scheduler_task_cancelled() {
        scheduler_deliver_cancel()
        return jet_scheduler_native_status()
    }
    _ := scheduler_wait_while_paused()
    if (world != I64{0}) -> world_finish_park(world, slot)
    if (control != I64{0}) -> scheduler_observe_update(I64{1}, I64{0})
    jet_scheduler_native_propagate()
}

// Scheduler240: lock0 FIFOhead8/tail16 workSeq24 watch32 live40 parked48
// fibers56 pooled64 pool72 completionLo80/Hi88 nextTask96 timerRoot104
// poolSize112 idle120 carriers128 fiberTimers136 stop144 started152
// woken160 readyHead168 readyTail176 stackBytes184 gsMode192 fiberSpace200
// blocked208 monitorArmed216 monitor224 sizedPools232.
// lock is a thread lock (Sync.jet sync_thread_lock): a fiber's wake takes it.
// The FIFO holds submitted task states (linked through their reserved word
// @88); ready holds fibers to resume (Fiber.jet). live counts tasks taken and
// not finished, parked their parked fibers, fibers the fiber stacks mapped,
// pooled (pool, linked through Fiber next@48, and the sizedPools lists of
// larger stacks, Fiber.jet fiber_sized_pool) the idle ones and fiberSpace
// the bytes the fiber stacks may still map (Fiber.jet fiber_space_take).
// carriers is a word list (scheduler_words) of Carrier64 records {argument0
// handle8 save16 tcb24 tid32 runs40 seenRuns48 seenCpu56}, changed only under
// the lock; every carrier on it stays joinable so jet_rt_scheduler_shutdown
// can join it. The poolSize carriers start one
// at a time, on demand: a submit starts one only when no idle carrier is left
// to wake (idle - woken), so a process that submits a few tasks starts a few
// threads, not the whole pool. idle counts carriers waiting on workSeq;
// woken counts the wakes sent them that no carrier has taken yet; started
// counts the carriers started. watch is the deadline the one idle carrier
// watching the fiber timers sleeps to (0: none watches).
//
// A carrier blocked in the kernel (a foreign call, a raw read of a FIFO or
// pipe, any system call that waits) holds its OS thread: no fiber park frees
// it. The monitor thread (jet_rt_scheduler_monitor) hands its work to another
// carrier, as Go's sysmon retakes a P from a thread in a system call. While
// work waits with no idle carrier, every SCHEDULER_MONITOR_TICK_NS it counts
// the carriers still on the job it saw them on (runs, odd while a job runs)
// whose threads used under half a tick of CPU since and are blocked in the
// kernel outside the runtime now (scheduler_thread_blocked: asleep, and in no
// futex wait); blocked is that count,
// and up to poolSize + blocked carriers may run. A carrier that finds no work
// while more than poolSize + blocked run retires, unless it would leave the
// fiber timers unwatched. The call path is
// unchanged, so a short foreign call costs what it did. monitorArmed is 1
// while the monitor watches and 0 while it sleeps until a submit or a wake
// finds no idle carrier; monitor is its thread handle (0: not started, -1:
// starting, -2: its start was refused, and the pool goes on without it).
scheduler_root := I64{0}
SCHEDULER_ROOT_BYTES: I64{240}
SCHEDULER_CARRIER_BYTES: I64{64}
SCHEDULER_MONITOR_TICK_NS: I64{10000000}
SCHEDULER_STAT_BYTES: I64{512}

// runtime-init: 3 when scheduler_root
#Export(c) jet_rt_scheduler_init: fn() {
    if (scheduler_root != I64{0}) -> return
    #Unsafe("runtime-init runs before any other thread exists") {
        scheduler_root = jet_rt_alloc(SCHEDULER_ROOT_BYTES, I64{8})
    }
    thread_zero(scheduler_root, SCHEDULER_ROOT_BYTES)
}

// The initialized root without starting the pool. Only scheduler_submit (via
// scheduler_get) starts workers, so a program that never submits a job (hello,
// a plain sleep) never creates a pool thread; draining, timers and statistics
// observe the same FIFO, live count and counters either way.
scheduler_root_required: fn() -> I64 {
    root: scheduler_root
    if (root == I64{0}) -> jet_rt_unreachable(I64{0}, I64{0})
    root
}

rt_scheduler_worker_address: fn() -> I64 {
    loop { jet_rt_unreachable(I64{0}, I64{0}) }
}
rt_scheduler_timer_address: fn() -> I64 {
    loop { jet_rt_unreachable(I64{0}, I64{0}) }
}
rt_scheduler_monitor_address: fn() -> I64 {
    loop { jet_rt_unreachable(I64{0}, I64{0}) }
}

// usize::from_str accepts '+' and the full u64 range. Counts above i64::MAX
// are returned as their bit pattern, not treated as an invalid override.
scheduler_parse_threads: fn(text: I64, out: I64) -> Bool {
    if (text == I64{0}) -> return false
    length: sync_load(wrapping(text + I64{8}))
    if (length == I64{0}) -> return false
    data: sync_load(text)
    at := I64{0}
    if (trap_byte(data) == I64{43}) -> at = I64{1}
    if at == length -> return false
    number := I64{0}
    loop at < length {
        byte: trap_byte(wrapping(data + at))
        if (byte < I64{48} || byte > I64{57}) -> return false
        digit: byte - I64{48}
        // (u64::MAX / 10) fits signed; any larger accumulator overflows next.
        if (number < I64{0} || number > I64{1844674407370955161}) -> return false
        if (number == I64{1844674407370955161} && digit > I64{5}) -> return false
        number = wrapping(wrapping(number * I64{10}) + digit)
        at += I64{1}
    }
    sync_store(out, if (number == I64{0}) -> I64{1} else -> number)
    true
}

scheduler_worker_count: fn() -> I64 {
    key: scheduler_msg_threads()
    value: rt_env_get(key)
    jet_rt_string_drop(key)
    out: wrapping(thread_base() + I64{248})
    parsed: scheduler_parse_threads(value, out)
    jet_rt_string_drop(value)
    if parsed -> return sync_load(out)
    if comptime_serving() -> I64{4} else -> scheduler_available_parallelism(I64{4})
}

// The pool's environment override stays in worker_count. Pool (fallback 4),
// joined parallel walks (fallback 1) and cpu_count (None) all read std's one
// available_parallelism (HostParallelism.jet).
scheduler_available_parallelism: fn(fallback: I64) -> I64 {
    count: cpu_available_parallelism(I64{0}, I64{0})
    if (jet_rt_session_propagate() != I64{0}) -> return I64{0}
    if (count > I64{0}) -> return count
    fallback
}

// The root's lazily created carrier list (128). Callers hold the root lock.
scheduler_carrier_list: fn(root: I64) -> I64 {
    list := sync_load(wrapping(root + I64{128}))
    if (list == I64{0}) {
        list = jet_rt_alloc(I64{24}, I64{8})
        thread_zero(list, I64{24})
        sync_store(wrapping(root + I64{128}), list)
    }
    list
}

// Joins every carrier of a list taken out from under the root lock, then
// frees the records and the list. Returns the number of joined threads.
scheduler_carrier_list_join: fn(list: I64) -> I64 {
    if (list == I64{0}) -> return I64{0}
    length: sync_load(list)
    data: sync_load(wrapping(list + I64{16}))
    at := I64{0}
    loop at < length {
        record: sync_load(wrapping(data + at * I64{8}))
        _ := thread_join(sync_load(wrapping(record + I64{8})), I64{0})
        jet_rt_free(record, SCHEDULER_CARRIER_BYTES, I64{8})
        at += I64{1}
    }
    scheduler_words_drop(list)
    length
}

// The spawn and the handle's publication share one critical section, so a
// carrier (which locks the root before it reads its handle) and shutdown
// both see a complete record.
scheduler_start_worker: fn(root: I64) {
    record: jet_rt_alloc(SCHEDULER_CARRIER_BYTES, I64{8})
    thread_zero(record, SCHEDULER_CARRIER_BYTES)
    sync_store(record, root)
    sync_thread_lock(root)
    handle: thread_spawn(rt_scheduler_worker_address(), record)
    if (handle < I64{0}) {
        // The carrier scheduler_submit or the monitor counted for this start
        // never runs. With others running the pool settles at them: the queued
        // job waits for one, and no later submit retries the start. A refused
        // start past the pool size (one the monitor made for a blocked
        // carrier) leaves the pool size alone.
        started: wrapping(sync_load(wrapping(root + I64{152})) - I64{1})
        sync_store(wrapping(root + I64{152}), started)
        pool: sync_load(wrapping(root + I64{112}))
        if (started > I64{0} && (pool < I64{0} || started < pool)) -> _ := sync_swap(wrapping(root + I64{112}), started)
        sync_thread_unlock(root)
        jet_rt_free(record, SCHEDULER_CARRIER_BYTES, I64{8})
        if (started == I64{0}) -> scheduler_first_worker_refused(-handle)
        return
    }
    sync_store(wrapping(record + I64{8}), handle)
    scheduler_words_push(scheduler_carrier_list(root), record)
    sync_thread_unlock(root)
}

// Settles the pool size on first use; workers start on demand
// (scheduler_submit).
scheduler_get: fn() -> I64 {
    root: scheduler_root
    // .init_array owns the root; first use owns only pool initialization.
    if (root == I64{0}) -> jet_rt_unreachable(I64{0}, I64{0})
    if {
        (sync_cas(wrapping(root + I64{112}), I64{0}, I64{-1}) == I64{0}) -> {
            count: scheduler_worker_count()
            jet_rt_observe_pool(count, I64{0})
            _ := sync_swap(wrapping(root + I64{112}), count)
            sync_wake(root + I64{112}, I64{2147483647})
        }
        else -> {
            loop sync_load(wrapping(root + (I64{112}))) == (I64{-1}) -> _ := sync_wait(root + I64{112}, I64{-1}, I64{-1})
        }
    }
    root
}

// Queues a job (scheduler_run_job) for a carrier. The job wakes an idle
// carrier, else starts one more while there is room
// (scheduler_carrier_room), else arms the monitor. Unsigned pool sizes above
// i64::MAX are attempted just as Rust does, failing at thread_spawn.
scheduler_submit: fn(task: I64) {
    root: scheduler_get()
    sync_store(wrapping(task + I64{88}), I64{0})
    sync_thread_lock(root)
    tail: sync_load(wrapping(root + I64{16}))
    if (tail == I64{0}) -> sync_store(wrapping(root + I64{8}), task) else -> sync_store(wrapping(tail + I64{88}), task)
    sync_store(wrapping(root + I64{16}), task)
    jet_rt_observe_pool(I64{-1}, I64{1})
    start := false
    monitor := I64{0}
    woke: scheduler_wake_idle(root)
    if !woke {
        if scheduler_carrier_room(root) {
            sync_store(wrapping(root + I64{152}), wrapping(sync_load(wrapping(root + I64{152})) + I64{1}))
            start = true
        } else {
            monitor = scheduler_monitor_arm(root)
        }
    }
    sync_thread_unlock(root)
    if woke -> scheduler_kick_idle(root)
    if start -> scheduler_start_worker(root)
    if (monitor != I64{0}) -> scheduler_monitor_kick(root, monitor)
}

// Whether one more carrier may start: fewer than the pool size run, or, while
// the monitor counts blocked carriers, fewer than the pool size plus them.
// Carriers the monitor started past the pool give no room once their blocked
// ones wake. The root lock is held.
scheduler_carrier_room: fn(root: I64) -> Bool {
    started: sync_load(wrapping(root + I64{152}))
    pool: sync_load(wrapping(root + I64{112}))
    if (pool < I64{0}) -> return started != pool
    started < wrapping(pool + sync_load(wrapping(root + I64{208})))
}

// Whether more carriers run than the pool size plus the blocked ones, so an
// idle one retires; never while the fiber timers wait with no carrier
// watching them, since the retiring carrier would leave them unwatched
// (scheduler_carrier_idle). The root lock is held.
scheduler_carrier_excess: fn(root: I64) -> Bool {
    pool: sync_load(wrapping(root + I64{112}))
    if (pool <= I64{0}) -> return false
    timers: sync_load(wrapping(root + I64{136}))
    if (timers != I64{0} && sync_load(wrapping(root + I64{32})) == I64{0} && sync_load(wrapping(timers + I64{16})) >= I64{0}) -> return false
    sync_load(wrapping(root + I64{152})) > wrapping(pool + sync_load(wrapping(root + I64{208})))
}

// Arms the monitor for a submit or a wake that found neither an idle carrier
// nor room for one: 0 when it already watches or cannot start, 1 to wake it,
// 2 to start it (scheduler_monitor_kick, after the unlock). The root lock is
// held.
scheduler_monitor_arm: fn(root: I64) -> I64 {
    monitor: sync_load(wrapping(root + I64{224}))
    if (monitor < I64{0} || sync_load(wrapping(root + I64{216})) != I64{0}) -> return I64{0}
    sync_store(wrapping(root + I64{216}), I64{1})
    if (monitor != I64{0}) -> return I64{1}
    sync_store(wrapping(root + I64{224}), I64{-1})
    I64{2}
}

scheduler_monitor_kick: fn(root: I64, how: I64) {
    if (how == I64{1}) {
        sync_futex_wake(wrapping(root + I64{216}), I64{1})
        return
    }
    handle: thread_spawn(rt_scheduler_monitor_address(), root)
    sync_thread_lock(root)
    if (handle < I64{0}) {
        // Refused: the pool goes on as it would without the monitor.
        sync_store(wrapping(root + I64{224}), I64{-2})
        sync_store(wrapping(root + I64{216}), I64{0})
    } else {
        sync_store(wrapping(root + I64{224}), handle)
    }
    sync_thread_unlock(root)
}

// Whether the monitor has carriers to watch: work waits with no idle carrier
// unclaimed, or carriers past the pool size run. The root lock is held.
scheduler_monitor_needed: fn(root: I64) -> Bool {
    pool: sync_load(wrapping(root + I64{112}))
    if (pool <= I64{0}) -> return false
    if (sync_load(wrapping(root + I64{152})) > pool) -> return true
    queued: sync_load(wrapping(root + I64{8})) != I64{0} || sync_load(wrapping(root + I64{168})) != I64{0}
    queued && sync_load(wrapping(root + I64{120})) <= sync_load(wrapping(root + I64{160}))
}

// Another thread's CPU time in ns: its CLOCK_THREAD_CPUTIME_ID, the clock
// (~tid << 3) | 6 that pthread_getcpuclockid names, or -1 once it is gone.
// Not sync_clock_read, which stops on a failed read.
scheduler_thread_cpu_ns: fn(tid: I64) -> I64 {
    clock: (wrapping(I64{-1} - tid) << I64{3}).bit_or(I64{6})
    #Unsafe("clock_gettime writes two words of thread-owned TCB scratch; no pointer escapes") {
        scratch: wrapping(os_tls_base_i64() + I64{232})
        if (os_syscall_i64(I64{228}, clock, scratch, I64{0}, I64{0}, I64{0}, I64{0}) != I64{0}) -> return I64{-1}
        return wrapping(os_load_i64(scratch) * I64{1000000000} + os_load_i64(wrapping(scratch + I64{8})))
    }
}

// Reads /proc/self/task/<tid>/<name> (`name` a static text) into `buffer`,
// the monitor's SCHEDULER_STAT_BYTES of scratch: the bytes read, or a
// negative count when the file cannot be opened or read.
scheduler_task_file: fn(tid: I64, name: I64, buffer: I64) -> I64 {
    prefix: rt_static_text("/proc/self/task/")
    at := rt_text_len(prefix)
    rt_text_bytes_copy(buffer, rt_text_data(prefix), at)
    digits := I64{1}
    scale := I64{10}
    loop tid >= scale {
        digits += I64{1}
        scale = scale * I64{10}
    }
    value := tid
    place := digits
    loop place > (I64{0}) {
        place -= I64{1}
        rt_text_put(wrapping(buffer + at + place), I64{48} + value % I64{10})
        value = value /% I64{10}
    }
    at = wrapping(at + digits)
    rt_text_put(wrapping(buffer + at), I64{47})
    at = wrapping(at + I64{1})
    rt_text_bytes_copy(wrapping(buffer + at), rt_text_data(name), rt_text_len(name))
    rt_text_put(wrapping(buffer + at + rt_text_len(name)), I64{0})
    got := I64{-1}
    #Unsafe("openat, read and close name and fill only the monitor's own scratch; the descriptor is closed before return") {
        // openat(AT_FDCWD, path, O_RDONLY | O_CLOEXEC).
        descriptor: os_syscall_i64(I64{257}, I64{-100}, buffer, I64{524288}, I64{0}, I64{0}, I64{0})
        if (descriptor < I64{0}) -> return descriptor
        got = os_syscall_i64(I64{0}, descriptor, buffer, SCHEDULER_STAT_BYTES, I64{0}, I64{0}, I64{0})
        _ := os_syscall_i64(I64{3}, descriptor, I64{0}, I64{0}, I64{0}, I64{0}, I64{0})
    }
    got
}

// Whether thread `tid` of this process is blocked in the kernel outside the
// runtime: the state in its /proc/self/task/<tid>/stat is S (an
// interruptible sleep), and its wchan names a wait that is no futex wait. A
// preempted thread is R, so a busy carrier on a crowded CPU is not taken for
// a blocked one. Waits on the address-space lock (many carriers mapping or
// unmapping fiber stacks at once) are D, and the runtime's own waits (a
// contended lock whose holder is preempted, a job run on its carrier for
// want of a fiber stack) are futex waits: new carriers would free neither.
// So a foreign call waiting on a pthread lock or in a D-state disk read is
// not handed off. A wchan of "0" (the thread runs again, or the kernel hides
// it), or one that cannot be read, a gone or an unreadable thread is not
// blocked. `buffer` is the monitor's SCHEDULER_STAT_BYTES of scratch.
scheduler_thread_blocked: fn(tid: I64, buffer: I64) -> Bool {
    got: scheduler_task_file(tid, rt_static_text("stat"), buffer)
    // The state follows the name's last `)` and a space: the name may hold
    // any byte, the fields after it only numbers.
    paren := wrapping(got - I64{1})
    loop paren >= (I64{0}) && rt_text_byte(wrapping(buffer + paren)) != (I64{41}) -> paren -= I64{1}
    if (paren < I64{0} || wrapping(paren + I64{2}) >= got) -> return false
    if (rt_text_byte(wrapping(buffer + paren + I64{2})) != I64{83}) -> return false
    wchan: scheduler_task_file(tid, rt_static_text("wchan"), buffer)
    if (wchan <= I64{0} || (wchan == I64{1} && rt_text_byte(buffer) == I64{48})) -> return false
    // The futex waits are named __futex_wait, futex_wait_queue and the like:
    // "futex" anywhere in the name.
    futex: rt_static_text("futex")
    length: rt_text_len(futex)
    start := I64{0}
    loop wrapping(start + length) <= wchan {
        at := I64{0}
        loop at < length && rt_text_byte(wrapping(buffer + start + at)) == rt_text_byte(wrapping(rt_text_data(futex) + at)) -> at += I64{1}
        if (at == length) -> return false
        start += I64{1}
    }
    true
}

// Counts the blocked carriers: on the job they ran at the last look (runs
// odd and unchanged), their threads under half a tick of CPU since and
// blocked in the kernel now (scheduler_thread_blocked). Each record keeps this
// look's runs and CPU time for the next. The root lock is held.
scheduler_monitor_scan: fn(root: I64, buffer: I64) -> I64 {
    list: sync_load(wrapping(root + I64{128}))
    if (list == I64{0}) -> return I64{0}
    length: sync_load(list)
    data: sync_load(wrapping(list + I64{16}))
    blocked := I64{0}
    at := I64{0}
    loop at < length {
        record: sync_load(wrapping(data + at * I64{8}))
        runs: sync_load(wrapping(record + I64{40}))
        tid: sync_load(wrapping(record + I64{32}))
        cpu := I64{-1}
        if (runs.bit_and(I64{1}) == I64{1} && tid > I64{0}) {
            cpu = scheduler_thread_cpu_ns(tid)
            seen: sync_load(wrapping(record + I64{56}))
            if (cpu >= I64{0} && seen >= I64{0} && runs == sync_load(wrapping(record + I64{48})) && wrapping(cpu - seen) < SCHEDULER_MONITOR_TICK_NS / I64{2} && scheduler_thread_blocked(tid, buffer)) -> blocked += I64{1}
        }
        sync_store(wrapping(record + I64{48}), runs)
        sync_store(wrapping(record + I64{56}), cpu)
        at += I64{1}
    }
    blocked
}

// How many carriers the monitor starts into the room the blocked ones leave:
// one per queued job or ready fiber no idle carrier is left to take, counted
// as started. The root lock is held.
scheduler_monitor_starts: fn(root: I64) -> I64 {
    pool: sync_load(wrapping(root + I64{112}))
    started: sync_load(wrapping(root + I64{152}))
    room: wrapping(pool + sync_load(wrapping(root + I64{208})) - started)
    if (pool <= I64{0} || room <= I64{0}) -> return I64{0}
    spare: sync_load(wrapping(root + I64{120})) - sync_load(wrapping(root + I64{160}))
    limit: room + (if (spare > I64{0}) -> spare else -> I64{0})
    queued := I64{0}
    task := sync_load(wrapping(root + I64{8}))
    loop task != (I64{0}) && queued < limit {
        queued += I64{1}
        task = sync_load(wrapping(task + I64{88}))
    }
    fiber := sync_load(wrapping(root + I64{168}))
    loop fiber != (I64{0}) && queued < limit {
        queued += I64{1}
        fiber = sync_load(wrapping(fiber + I64{48}))
    }
    starts: queued - (if (spare > I64{0}) -> spare else -> I64{0})
    if (starts <= I64{0}) -> return I64{0}
    sync_store(wrapping(root + I64{152}), wrapping(started + starts))
    starts
}

// The monitor thread (Scheduler232). Asleep until armed; then each tick,
// while it has carriers to watch, it recounts the blocked ones, starts
// carriers into the room they leave and wakes idle carriers past it, which
// retire. It leaves on shutdown's stop.
#Export(c) jet_rt_scheduler_monitor: fn(root: I64) -> I64 {
    armed: wrapping(root + I64{216})
    buffer: jet_rt_alloc(SCHEDULER_STAT_BYTES, I64{8})
    loop {
        sync_thread_lock(root)
        if (sync_load(wrapping(root + I64{144})) != I64{0}) {
            sync_thread_unlock(root)
            jet_rt_free(buffer, SCHEDULER_STAT_BYTES, I64{8})
            return I64{0}
        }
        if !scheduler_monitor_needed(root) {
            sync_store(wrapping(root + I64{208}), I64{0})
            sync_store(armed, I64{0})
            sync_thread_unlock(root)
            _ := sync_futex_wait(armed, I64{0}, I64{-1})
            next
        }
        sync_store(armed, I64{1})
        sync_store(wrapping(root + I64{208}), scheduler_monitor_scan(root, buffer))
        starts: scheduler_monitor_starts(root)
        wakes := I64{0}
        if scheduler_carrier_excess(root) {
            excess: sync_load(wrapping(root + I64{152})) - sync_load(wrapping(root + I64{112})) - sync_load(wrapping(root + I64{208}))
            loop wakes < excess && scheduler_wake_idle(root) -> wakes += I64{1}
        }
        sync_thread_unlock(root)
        if (wakes > I64{0}) -> sync_futex_wake(wrapping(root + I64{24}), wakes)
        at := I64{0}
        loop at < starts {
            scheduler_start_worker(root)
            at += I64{1}
        }
        _ := sync_futex_wait(armed, I64{1}, sync_deadline(SCHEDULER_MONITOR_TICK_NS))
    }
}

// Claims one idle carrier no earlier wake has claimed and bumps workSeq, so
// it cannot sleep through the claim; false when none is left. The root lock
// is held; the caller sends the futex wake (scheduler_kick_idle) after it
// unlocks, so the woken carrier does not wake into the held lock.
scheduler_wake_idle: fn(root: I64) -> Bool {
    if (sync_load(wrapping(root + I64{120})) <= sync_load(wrapping(root + I64{160}))) -> return false
    sync_store(wrapping(root + I64{160}), sync_load(wrapping(root + I64{160})) + I64{1})
    _ := sync_add(wrapping(root + I64{24}), I64{1})
    true
}

scheduler_kick_idle: fn(root: I64) { sync_futex_wake(wrapping(root + I64{24}), I64{1}) }

// A fiber timer now first in the heap: unless the watcher already sleeps to
// an earlier deadline, the watch is given up and one idle carrier wakes to
// take it over at the new earliest deadline (any claimed wake does too: the
// carrier it wakes finds no watcher). The old watcher keeps sleeping to its
// own deadline and, back, clears the watch only while it is still its own.
scheduler_watch_kick: fn(root: I64, deadline_ns: I64) {
    sync_thread_lock(root)
    watch: sync_load(wrapping(root + I64{32}))
    woke := false
    if (sync_load(wrapping(root + I64{120})) > I64{0} && (watch == I64{0} || watch > deadline_ns)) {
        sync_store(wrapping(root + I64{32}), I64{0})
        woke = scheduler_wake_idle(root)
    }
    sync_thread_unlock(root)
    if woke -> scheduler_kick_idle(root)
}

// The FIFO's first task; the root lock is held.
scheduler_pop: fn(root: I64) -> I64 {
    task: sync_load(wrapping(root + I64{8}))
    if (task == I64{0}) -> return I64{0}
    next_task: sync_load(wrapping(task + I64{88}))
    sync_store(wrapping(root + I64{8}), next_task)
    if (next_task == I64{0}) -> sync_store(wrapping(root + I64{16}), I64{0})
    sync_store(wrapping(root + I64{40}), sync_load(wrapping(root + I64{40})) + I64{1})
    task
}

// An idle carrier's wait on workSeq; the root lock is held on entry and on
// return. With no carrier watching the fiber timers, it watches them: it
// sleeps only until the earliest deadline.
scheduler_carrier_idle: fn(root: I64) {
    sync_store(wrapping(root + I64{120}), sync_load(wrapping(root + I64{120})) + I64{1})
    deadline := I64{-1}
    timers: sync_load(wrapping(root + I64{136}))
    if (timers != I64{0} && sync_load(wrapping(root + I64{32})) == I64{0}) {
        earliest: sync_load(wrapping(timers + I64{16}))
        if (earliest >= I64{0}) {
            // A deadline is positive: watch 0 means none watches.
            deadline = if (earliest == I64{0}) -> I64{1} else -> earliest
            sync_store(wrapping(root + I64{32}), deadline)
        }
    }
    before: sync_load(wrapping(root + I64{24}))
    sync_thread_unlock(root)
    _ := sync_futex_wait(wrapping(root + I64{24}), before, deadline)
    sync_thread_lock(root)
    sync_store(wrapping(root + I64{120}), sync_load(wrapping(root + I64{120})) - I64{1})
    if (sync_load(wrapping(root + I64{160})) > I64{0}) -> sync_store(wrapping(root + I64{160}), sync_load(wrapping(root + I64{160})) - I64{1})
    if (deadline >= I64{0} && sync_load(wrapping(root + I64{32})) == deadline) -> sync_store(wrapping(root + I64{32}), I64{0})
}

// A carrier: the pool thread that runs task fibers (Fiber.jet fiber_run)
// and, idle, fires their timers. The record is its Carrier64; runs turns odd
// while it runs a job and even again after, for the monitor.
#Export(c) jet_rt_scheduler_worker: fn(record: I64) -> I64 {
    root: sync_load(record)
    sync_store(wrapping(record + I64{24}), thread_base())
    #Unsafe("gettid takes no arguments and retains nothing") {
        sync_store(wrapping(record + I64{32}), os_syscall_i64(I64{186}, I64{0}, I64{0}, I64{0}, I64{0}, I64{0}, I64{0}))
    }
    loop {
        fiber_timers_fire(root)
        sync_thread_lock(root)
        if (sync_load(wrapping(root + I64{144})) != I64{0}) {
            // jet_rt_scheduler_shutdown owns this record and joins this thread.
            sync_thread_unlock(root)
            return I64{0}
        }
        fiber := fiber_ready_pop(root)
        task := I64{0}
        if (fiber == I64{0}) -> task = scheduler_pop(root)
        if (fiber == I64{0} && task == I64{0}) {
            if scheduler_carrier_excess(root) {
                scheduler_carrier_retire(root, record)
                return I64{0}
            }
            scheduler_carrier_idle(root)
            sync_thread_unlock(root)
            next
        }
        // Leaving the watch to no one would sleep the timers through.
        timers: sync_load(wrapping(root + I64{136}))
        kick: timers != I64{0} && sync_load(wrapping(root + I64{32})) == I64{0} && sync_load(wrapping(timers + I64{16})) >= I64{0} && scheduler_wake_idle(root)
        sync_thread_unlock(root)
        if kick -> scheduler_kick_idle(root)
        runs: wrapping(record + I64{40})
        sync_store(runs, wrapping(sync_load(runs) + I64{1}))
        if (task != I64{0}) {
            jet_rt_observe_pool(I64{-1}, I64{-1})
            fiber = fiber_take(root, scheduler_job_stack(task))
            if (fiber == I64{0}) {
                // No stack could be mapped, or the fiber stacks' space is
                // spent: the job runs on the carrier, whose waits then block it.
                scheduler_run_job(task)
                sync_store(runs, wrapping(sync_load(runs) + I64{1}))
                sync_thread_lock(root)
                sync_store(wrapping(root + I64{40}), sync_load(wrapping(root + I64{40})) - I64{1})
                sync_thread_unlock(root)
                next
            }
            sync_store(wrapping(fiber + I64{56}), task)
        }
        _ := fiber_run(root, record, fiber)
        sync_store(runs, wrapping(sync_load(runs) + I64{1}))
    }
}

// An idle carrier past the pool size plus the blocked ones leaves: off the
// carrier list (shutdown joins only listed carriers), detached, its record
// freed. The root lock is held on entry and released.
scheduler_carrier_retire: fn(root: I64, record: I64) {
    list: sync_load(wrapping(root + I64{128}))
    length: sync_load(list)
    data: sync_load(wrapping(list + I64{16}))
    at := I64{0}
    loop at < length {
        if (sync_load(wrapping(data + at * I64{8})) == record) {
            last: wrapping(length - I64{1})
            sync_store(wrapping(data + at * I64{8}), sync_load(wrapping(data + last * I64{8})))
            sync_store(list, last)
            at = length
        } else {
            at += I64{1}
        }
    }
    sync_store(wrapping(root + I64{152}), wrapping(sync_load(wrapping(root + I64{152})) - I64{1}))
    handle: sync_load(wrapping(record + I64{8}))
    sync_thread_unlock(root)
    _ := thread_detach(handle)
    jet_rt_free(record, SCHEDULER_CARRIER_BYTES, I64{8})
}

// A queued job: a task state, or a parallel walk's worker (Parallel.jet),
// marked PARALLEL_JOB in the first word, where a task state keeps its
// positive reference count.
scheduler_run_job: fn(job: I64) {
    if (sync_load(job) == PARALLEL_JOB) -> parallel_job_run(job) else -> task_run(job)
}

// The stack size a job's fiber takes (Fiber.jet fiber_stack_class): a
// parallel worker's stack136, a task state's stack96.
scheduler_job_stack: fn(job: I64) -> I64 {
    if (sync_load(job) == PARALLEL_JOB) -> sync_load(wrapping(job + I64{136})) else -> sync_load(wrapping(job + I64{96}))
}

// Fiber counts for tests: parked@0, carriers started@8, fiber stacks@16.
scheduler_fiber_stats: fn(out: I64) {
    root: scheduler_root_required()
    sync_thread_lock(root)
    sync_store(out, sync_load(wrapping(root + I64{48})))
    sync_store(wrapping(out + I64{8}), sync_load(wrapping(root + I64{152})))
    sync_store(wrapping(out + I64{16}), sync_load(wrapping(root + I64{56})))
    sync_thread_unlock(root)
}

scheduler_completion_order: fn(out: I64) {
    root: scheduler_root
    sync_thread_lock(root)
    low: sync_load(wrapping(root + I64{80}))
    high: sync_load(wrapping(root + I64{88}))
    sync_store(out, low)
    sync_store(wrapping(out + I64{8}), high)
    next_low: wrapping(low + I64{1})
    next_high: if (next_low == I64{0}) -> wrapping(high + I64{1}) else -> high
    if (next_low == I64{0} && next_high == I64{0}) {
        sync_thread_unlock(root)
        scheduler_fatal(scheduler_msg_completion_exhausted())
        return
    }
    sync_store(wrapping(root + I64{80}), next_low)
    sync_store(wrapping(root + I64{88}), next_high)
    sync_thread_unlock(root)
}

#Export(c) jet_scheduler_drain: fn() {
    root: scheduler_root_required()
    at := I64{0}
    slot: sync_park_new()
    loop at < (I64{5000}) {
        if jet_rt_observe_has_parked_tasks() -> break
        sync_thread_lock(root)
        idle: sync_load(wrapping(root + I64{8})) == I64{0} && sync_load(wrapping(root + I64{40})) == I64{0}
        sync_thread_unlock(root)
        if idle && jet_rt_observe_io_quiescent() -> break
        sync_park(slot, I64{1000000})
        at += I64{1}
    }
    sync_park_drop(slot)
}

// Whether no task is queued or running (the root's counts at 8 and 40).
scheduler_idle: fn() -> Bool {
    root: scheduler_root_required()
    sync_thread_lock(root)
    idle: sync_load(wrapping(root + I64{8})) == I64{0} && sync_load(wrapping(root + I64{40})) == I64{0}
    sync_thread_unlock(root)
    idle
}

#Export(c) jet_scheduler_drain_after_exit: fn() {
    loop {
        if scheduler_idle() && jet_rt_observe_io_quiescent() -> return
        fiber_spin_yield()
    }
}

// The drain after a parked-task report (E3013), which ends the process: the
// tasks it cancelled unwind, but one it could not reach (a task past the
// registry's cap, Observe.jet OBSERVE_TASK_CAP) stays parked, so this returns
// once nothing is queued, ready or running and every live task is parked.
// The parked count lags a commit and leads a wake, so it only ever reads low.
scheduler_settle_after_report: fn() {
    root: scheduler_root_required()
    loop {
        sync_thread_lock(root)
        settled: sync_load(wrapping(root + I64{8})) == I64{0} && sync_load(wrapping(root + I64{168})) == I64{0} && sync_load(wrapping(root + I64{40})) == sync_load(wrapping(root + I64{48}))
        sync_thread_unlock(root)
        if settled && jet_rt_observe_io_quiescent() -> return
        fiber_spin_yield()
    }
}

// Timer root48B mutex0 sequence8 head16 ready24 stop32 thread40. Timer node40B
// next0 absoluteMonotonicNs8 borrowedPark16 active24 refs32. Queue and caller
// each own a ref; cancel synchronizes with wake before the caller frees Park.
// The timer thread needs the root only, never the worker pool.
scheduler_timer_root: fn() -> I64 {
    root: scheduler_root_required()
    value := sync_load(wrapping(root + I64{104}))
    if (value != I64{0}) -> return value
    candidate: jet_rt_alloc(I64{48}, I64{8})
    thread_zero(candidate, I64{48})
    previous: sync_cas(wrapping(root + I64{104}), I64{0}, candidate)
    if (previous != I64{0}) {
        jet_rt_free(candidate, I64{48}, I64{8})
        return previous
    }
    handle: thread_spawn(rt_scheduler_timer_address(), candidate)
    if (handle < I64{0}) -> scheduler_start_failed()
    // Joinable: jet_rt_scheduler_shutdown joins it.
    sync_store(wrapping(candidate + I64{40}), handle)
    candidate
}

scheduler_timer_node_drop: fn(node: I64) {
    if (sync_add(wrapping(node + I64{32}), I64{-1}) == I64{1}) -> jet_rt_free(node, I64{40}, I64{8})
}

scheduler_timer_schedule: fn(deadline_ns: I64, slot: I64) -> I64 {
    wheel: scheduler_timer_root()
    node: jet_rt_alloc(I64{40}, I64{8})
    sync_store(wrapping(node + I64{8}), deadline_ns)
    sync_store(wrapping(node + I64{16}), slot)
    sync_store(wrapping(node + I64{24}), I64{1})
    sync_store(wrapping(node + I64{32}), I64{2})
    sync_mutex_lock(wheel)
    sync_store(node, sync_load(wrapping(wheel + I64{16})))
    sync_store(wrapping(wheel + I64{16}), node)
    sync_cond_notify_one(wrapping(wheel + I64{8}))
    sync_mutex_unlock(wheel)
    node
}

scheduler_timer_cancel: fn(node: I64) {
    wheel: sync_load(wrapping(scheduler_root + I64{104}))
    sync_mutex_lock(wheel)
    if (sync_load(wrapping(node + I64{24})) != I64{0}) {
        scheduler_node_unlink(wheel + I64{16}, node)
        sync_store(wrapping(node + I64{24}), I64{0})
        scheduler_timer_node_drop(node)
    }
    sync_mutex_unlock(wheel)
    scheduler_timer_node_drop(node)
}

#Export(c) jet_rt_scheduler_timer: fn(wheel: I64) -> I64 {
    loop {
        sync_mutex_lock(wheel)
        if (sync_load(wrapping(wheel + I64{32})) != I64{0}) {
            sync_mutex_unlock(wheel)
            return I64{0}
        }
        now: sync_now_ns()
        // With no timer pending the thread sleeps until one is scheduled.
        earliest := I64{-1}
        link := wheel + I64{16}
        loop sync_load(link) != (I64{0}) {
            node: sync_load(link)
            deadline: sync_load(wrapping(node + I64{8}))
            if {
                deadline <= now -> {
                    sync_store(link, sync_load(node))
                    sync_store(wrapping(node + I64{24}), I64{0})
                    // Waking under wheel lock serializes cancellation + slot free.
                    sync_park_wake(sync_load(wrapping(node + I64{16})))
                    scheduler_timer_node_drop(node)
                }
                else -> {
                    if (earliest < I64{0} || deadline < earliest) -> earliest = deadline
                    link = node
                }
            }
        }
        _ := sync_cond_wait(wrapping(wheel + I64{8}), wheel, earliest)
        sync_mutex_unlock(wheel)
    }
}

// Stops and joins the timer thread of an idle wheel. Returns the joined
// thread count, or -1 (nothing stopped) while a timer is pending.
scheduler_timer_shutdown: fn(root: I64) -> I64 {
    wheel: sync_load(wrapping(root + I64{104}))
    if (wheel == I64{0}) -> return I64{0}
    sync_mutex_lock(wheel)
    if (sync_load(wrapping(wheel + I64{16})) != I64{0}) {
        sync_mutex_unlock(wheel)
        return I64{-1}
    }
    sync_store(wrapping(wheel + I64{32}), I64{1})
    sync_cond_notify_all(wrapping(wheel + I64{8}))
    sync_mutex_unlock(wheel)
    // scheduler_timer_root publishes the handle right after the spawn.
    loop sync_load(wrapping(wheel + (I64{40}))) == (I64{0}) {
        #Unsafe("sched_yield retains no memory and yields this OS thread") {
            _ := os_syscall_i64(I64{24}, I64{0}, I64{0}, I64{0}, I64{0}, I64{0}, I64{0})
        }
    }
    _ := thread_join(sync_load(wrapping(wheel + I64{40})), I64{0})
    sync_store(wrapping(root + I64{104}), I64{0})
    jet_rt_free(wheel, I64{48}, I64{8})
    I64{1}
}

// Quiesce for a userland exec (JetBackend Image/Loader.jet): stop and join
// every scheduler thread this process started (the carriers, the timer and
// monitor threads), so the caller is the process's only scheduler thread. 0
// when none was ever started; otherwise the joined thread count. -1, with
// nothing stopped, while a task is queued or running or a timer is pending.
// The caller guarantees no other thread submits work concurrently. The pool,
// the timer and the monitor restart lazily on the next use; pooled fibers
// stay for it.
#Export(c) jet_rt_scheduler_shutdown: fn() -> I64 {
    root: scheduler_root
    if (root == I64{0}) -> return I64{0}
    loop sync_load(wrapping(root + (I64{112}))) == (I64{-1}) -> _ := sync_wait(root + I64{112}, I64{-1}, I64{-1})
    sync_thread_lock(root)
    if (sync_load(wrapping(root + I64{8})) != I64{0} || sync_load(wrapping(root + I64{40})) != I64{0}) {
        sync_thread_unlock(root)
        return I64{-1}
    }
    timer: scheduler_timer_shutdown(root)
    if (timer < I64{0}) {
        sync_thread_unlock(root)
        return I64{-1}
    }
    sync_store(wrapping(root + I64{144}), I64{1})
    carriers: sync_swap(wrapping(root + I64{128}), I64{0})
    _ := sync_add(wrapping(root + I64{24}), I64{1})
    sync_futex_wake(wrapping(root + I64{24}), I64{2147483647})
    sync_store(wrapping(root + I64{216}), I64{2})
    sync_futex_wake(wrapping(root + I64{216}), I64{1})
    sync_thread_unlock(root)
    joined := timer + scheduler_carrier_list_join(carriers)
    // scheduler_monitor_kick publishes the handle right after the spawn.
    loop sync_load(wrapping(root + (I64{224}))) == (I64{-1}) {
        #Unsafe("sched_yield retains no memory and yields this OS thread") {
            _ := os_syscall_i64(I64{24}, I64{0}, I64{0}, I64{0}, I64{0}, I64{0}, I64{0})
        }
    }
    monitor: sync_load(wrapping(root + I64{224}))
    if (monitor > I64{0}) {
        _ := thread_join(monitor, I64{0})
        joined += I64{1}
    }
    sync_thread_lock(root)
    sync_store(wrapping(root + I64{32}), I64{0})
    sync_store(wrapping(root + I64{120}), I64{0})
    sync_store(wrapping(root + I64{144}), I64{0})
    sync_store(wrapping(root + I64{152}), I64{0})
    sync_store(wrapping(root + I64{160}), I64{0})
    sync_store(wrapping(root + I64{208}), I64{0})
    sync_store(wrapping(root + I64{216}), I64{0})
    sync_store(wrapping(root + I64{224}), I64{0})
    _ := sync_swap(wrapping(root + I64{112}), I64{0})
    sync_thread_unlock(root)
    jet_rt_observe_pool(I64{0}, I64{0})
    joined
}

scheduler_park_duration: fn(wait_kind: I64, duration_ns: I64) -> I64 {
    if (duration_ns <= I64{0}) -> return jet_scheduler_native_propagate()
    world: world_current()
    if (world != I64{0}) {
        if ((sync_load(wrapping(thread_base() + I64{112})).bit_and(I64{1})) == I64{0}) {
            scheduler_fatal(services_msg_world_sleep())
            return jet_scheduler_native_status()
        }
        virtual_slot: sync_park_new()
        world_park(world, duration_ns, virtual_slot)
        status := jet_scheduler_native_propagate()
        if (status == I64{0}) -> status = scheduler_yield(wait_kind, virtual_slot, I64{-1})
        sync_park_drop(virtual_slot)
        return status
    }
    // The park's own timeout ends the sleep; no timer thread is involved.
    slot: sync_park_new()
    status: scheduler_yield(wait_kind, slot, duration_ns)
    sync_park_drop(slot)
    status
}

#Export(c) jet_scheduler_sleep_ms: fn(millis: I64) {
    kind: scheduler_msg_sleep()
    _ := scheduler_park_duration(kind, deadline_ms_to_ns(millis))
    jet_rt_string_drop(kind)
}
#Export(c) jet_task_sleep_ms_defaulted: fn(millis: I64) {
    kind: scheduler_msg_sleep()
    if (scheduler_deadline_check(kind) == I64{0}) {
        _ := scheduler_park_duration(kind, deadline_ms_to_ns(millis))
        _ := scheduler_deadline_check(kind)
    }
    jet_rt_string_drop(kind)
}
#Export(c) jet_task_sleep_duration_ns_defaulted: fn(nanos: I64) {
    kind: scheduler_msg_sleep()
    if (scheduler_deadline_check(kind) == I64{0}) {
        _ := scheduler_park_duration(kind, nanos)
        _ := scheduler_deadline_check(kind)
    }
    jet_rt_string_drop(kind)
}
#Export(c) jet_task_yield: fn() {
    kind: scheduler_msg_yield()
    slot: sync_park_new()
    _ := scheduler_yield(kind, slot, I64{0})
    sync_park_drop(slot)
    jet_rt_string_drop(kind)
}

// Owner-thread deadline nodes24B: next0 deadline8 taskId16. Queue24B uses
// head0 nextId8 reserved16, lives at TCB@96. Earliest tie is registration order.
scheduler_owner_deadline_queue: fn() -> I64 {
    queue := sync_load(wrapping(thread_base() + I64{96}))
    if (queue == I64{0}) {
        queue = jet_rt_alloc(I64{24}, I64{8})
        thread_zero(queue, I64{24})
        sync_store(wrapping(queue + I64{8}), I64{1})
        sync_store(wrapping(thread_base() + I64{96}), queue)
    }
    queue
}
#Export(c) jet_scheduler_owner_deadline_register: fn(deadline_ns: I64) -> I64 {
    queue: scheduler_owner_deadline_queue()
    id: sync_load(wrapping(queue + I64{8}))
    sync_store(wrapping(queue + I64{8}), wrapping(id + I64{1}))
    node: jet_rt_alloc(I64{24}, I64{8})
    sync_store(node, I64{0})
    sync_store(wrapping(node + I64{8}), deadline_ns)
    sync_store(wrapping(node + I64{16}), id)
    link := queue
    loop sync_load(link) != (I64{0}) -> link = sync_load(link)
    sync_store(link, node)
    id
}
#Export(c) jet_scheduler_owner_deadline_cancel: fn(id: I64) {
    queue: scheduler_owner_deadline_queue()
    link := queue
    loop sync_load(link) != (I64{0}) {
        node: sync_load(link)
        if sync_load(wrapping(node + I64{16})) == id {
            sync_store(link, sync_load(node))
            jet_rt_free(node, I64{24}, I64{8})
            return
        }
        link = node
    }
}
#Export(c) jet_scheduler_owner_deadline_pop_due: fn(now_ns: I64) -> I64 {
    queue: scheduler_owner_deadline_queue()
    earliest := I64{0}
    link := queue
    loop sync_load(link) != (I64{0}) {
        node: sync_load(link)
        if sync_load(wrapping(node + I64{8})) <= now_ns && (earliest == I64{0} || sync_load(wrapping(node + I64{8})) < sync_load(wrapping(sync_load(earliest) + I64{8}))) -> earliest = link
        link = node
    }
    if (earliest == I64{0}) -> return I64{0}
    node: sync_load(earliest)
    id: sync_load(wrapping(node + I64{16}))
    sync_store(earliest, sync_load(node))
    jet_rt_free(node, I64{24}, I64{8})
    id
}

scheduler_fatal: fn(message: I64) {
    // The Rust original uses E3001 with an empty owner, not <core.prelude>.
    bytes: sync_load(message)
    length: sync_load(wrapping(message + I64{8}))
    trap_stop(I64{1}, bytes, length, I64{0}, I64{0})
    if !rt_task_panic_publish(bytes, length, I64{0}) -> trap_simple(I64{0}, I64{0}, I64{0}, I64{0}, bytes, length)
    jet_rt_string_drop(message)
}

// A runtime helper thread that could not start (thread_spawn EAGAIN:
// RLIMIT_AS, pids limit, memory) stops the process with E3001, also inside a
// task or root; a carrier never does (scheduler_start_worker). Native code
// has no stop edge out of a runtime-internal failure: an
// in-task stop would return into its caller, which would run on with the error
// code as a thread handle or a stopped helper's 0 result.
scheduler_start_failed: fn() {
    message: scheduler_msg_start_failed()
    trap_process_stop(I64{0}, sync_load(message), sync_load(wrapping(message + I64{8})))
}

// The pool's first carrier could not start (thread_spawn's -`errno`), so no
// task can run. The host refused a thread, which is no fault of the
// program: the report is no panic but one `error:` line naming the errno
// and the limits that refuse threads, RLIMIT_AS and RLIMIT_NPROC (-1 reads
// as unlimited), and the process exits 70. Served comptime code reports it
// to the compiler as a stop.
scheduler_first_worker_refused: fn(errno: I64) {
    head: rt_static_text("error: the host refused the first scheduler worker thread (errno ")
    trap_stop(I64{1}, rt_text_data(head), rt_text_len(head), I64{0}, I64{0})
    trap_defect_prepare()
    jet_rt_stdout_flush()
    trap_write_static(head)
    trap_number(errno)
    trap_write_static(rt_static_text("); address-space limit RLIMIT_AS "))
    scheduler_limit_write(thread_rlimit_soft(I64{9}))
    trap_write_static(rt_static_text(", process limit RLIMIT_NPROC "))
    scheduler_limit_write(thread_rlimit_soft(I64{6}))
    trap_write_static(rt_static_text("\n"))
    trap_defect_exit(I64{70})
}

// A soft rlimit as scheduler_first_worker_refused names it.
scheduler_limit_write: fn(soft: I64) {
    if (soft < I64{0}) -> trap_write_static(rt_static_text("unlimited")) else -> trap_number(soft)
}

scheduler_abort_double_panic: fn() {
    jet_rt_stdout_flush()
    // Bypass a root's report capture: this is the terminal abort diagnostic.
    alloc_write_word(I64{7955925828069384560}, I64{8})
    alloc_write_word(I64{8247343696930955552}, I64{8})
    alloc_write_word(I64{8458921675976893301}, I64{8})
    alloc_write_word(I64{7308325286140864882}, I64{8})
    alloc_write_word(I64{44836417121}, I64{5})
    alloc_abort()
}
scheduler_panic_check: fn() -> Bool {
    if (jet_rt_stop_domain() == I64{0}) -> return false
    flags: scheduler_scope_flags(scheduler_control_current())
    if ((flags.bit_and(SCHEDULER_SCOPE_INHERITED_STOP)) != I64{0} ||
        ((flags.bit_and(SCHEDULER_SCOPE_CLEANUP)) != I64{0} && scheduler_scope_delivered_kind(flags) != I64{0}) ||
        scheduler_delivered_status_unmasked() != I64{0}) -> scheduler_abort_double_panic()
    true
}
// `code` is the registered stop row the root report would carry (0 E3001, 1 E3010, 2 E3011, 3
// the host stop E2805; trap_header's numbering). jet_runtime_stop records the raw stop on
// every active expectation frame before it unwinds, so the native catch probe sees the same
// first stop as the Rust reference. The published record stays the raw message (form 0).
rt_task_panic_publish: fn(message: I64, length: I64, code: I64) -> Bool {
    test_scope_record_coded_stop(code, message, length)
    rt_task_panic_publish_recorded(message, length)
}
// The publication rail once the caller has recorded its own stop code
// (Trap.jet jet_rt_coded_stop). Stop domain 2 exists only inside a task,
// parallel or realtime body, whose first entry installs the rail
// (scheduler_body_enter): a program that runs none links no publication.
rt_task_panic_publish_recorded: fn(message: I64, length: I64) -> Bool {
    code: task_panic_code
    if (code == I64{0}) -> return false
    coll_call2(code, message, length) != I64{0}
}

// rt_task_panic_publish_recorded's rail as a code word's target: 1 when
// the stop is published to the task, 0 when the caller reports it.
#Export(c) jet_rt_task_panic_publish: fn(message: I64, length: I64) -> I64 {
    if (jet_rt_stop_domain() != I64{2}) -> return I64{0}
    if !scheduler_panic_check() -> return I64{0}
    text: scheduler_text_new(length)
    if (text == I64{0} && jet_rt_session_propagate() != I64{0}) -> return I64{1}
    coll_copy(message, sync_load(text), length)
    rt_task_panic_publish_owned(text, I64{0})
    I64{1}
}

// RuntimeLower resolves this checked function-address entry, never the body.
rt_task_panic_publish_address: fn() -> I64 {
    loop { jet_rt_unreachable(I64{0}, I64{0}) }
}

// Takes an owned, already checked report (or builder): the same publication
// rail as rt_task_panic_publish, without a second allocation/copy.
rt_task_panic_publish_owned: fn(message: I64, form: I64) {
    record: scheduler_stop_new(I64{5}, message)
    sync_store(wrapping(record + I64{48}), form)
    _ := scheduler_panic_publish_record(record)
}

scheduler_thread_detach: fn() {
    base: thread_base()
    frames: sync_load(wrapping(base + I64{80}))
    if (frames != I64{0}) {
        if (sync_load(frames) != I64{0}) -> jet_rt_unreachable(I64{0}, I64{0})
        scheduler_words_drop(frames)
        sync_store(wrapping(base + I64{80}), I64{0})
    }
    queue: sync_load(wrapping(base + I64{96}))
    if (queue != I64{0}) {
        node := sync_load(queue)
        loop node != (I64{0}) {
            next_node: sync_load(node)
            jet_rt_free(node, I64{24}, I64{8})
            node = next_node
        }
        jet_rt_free(queue, I64{24}, I64{8})
        sync_store(wrapping(base + I64{96}), I64{0})
    }
}

// Host/session and interim comptime entry points. Controls and records are
// opaque owned pointers; enter borrows a control and a caller-owned 32B slot.
#Export(c) jet_rt_control_new: fn() -> I64 { scheduler_control_new() }
#Export(c) jet_rt_control_enter: fn(control: I64, save: I64) { scheduler_control_enter(control, save) }
#Export(c) jet_rt_control_leave: fn(save: I64) { scheduler_control_leave(save) }
#Export(c) jet_rt_control_interrupt: fn(control: I64) { scheduler_control_interrupt(control) }
#Export(c) jet_rt_control_status: fn(control: I64) -> I64 { scheduler_control_status(control) }
#Export(c) jet_rt_control_take_stop: fn(control: I64) -> I64 { scheduler_control_take_stop(control) }
#Export(c) jet_rt_control_discard_stop: fn(control: I64) { scheduler_control_discard_stop(control) }
#Export(c) jet_rt_stop_kind: fn(record: I64) -> I64 { sync_load(record) }
#Export(c) jet_rt_stop_jct_status: fn(record: I64) -> I64 { sync_load(wrapping(record + I64{8})) }
#Export(c) jet_rt_stop_owner: fn(record: I64) -> I64 { sync_load(wrapping(record + I64{16})) }
#Export(c) jet_rt_stop_start: fn(record: I64) -> I64 { sync_load(wrapping(record + I64{24})) }
#Export(c) jet_rt_stop_end: fn(record: I64) -> I64 { sync_load(wrapping(record + I64{32})) }
#Export(c) jet_rt_stop_form: fn(record: I64) -> I64 { sync_load(wrapping(record + I64{48})) }
#Export(c) jet_rt_stop_take_message: fn(record: I64) -> I64 { scheduler_stop_take_message(record) }
#Export(c) jet_rt_stop_drop: fn(record: I64) { scheduler_stop_drop(record) }
#Export(c) jet_rt_control_publish_stop: fn(kind: I64, jct_status: I64, owner: I64, start: I64, end: I64, message: I64, length: I64, form: I64) -> Bool {
    if (kind == I64{5} && !scheduler_panic_check()) -> return false
    text: scheduler_text_new(length)
    if (text == I64{0} && jet_rt_session_propagate() != I64{0}) -> return false
    coll_copy(message, sync_load(text), length)
    record: scheduler_stop_new(kind, text)
    sync_store(wrapping(record + I64{8}), jct_status)
    sync_store(wrapping(record + I64{16}), owner)
    sync_store(wrapping(record + I64{24}), start)
    sync_store(wrapping(record + I64{32}), end)
    sync_store(wrapping(record + I64{48}), form)
    if (kind == I64{5}) -> scheduler_panic_publish_record(record) else -> scheduler_native_publish(record)
}

