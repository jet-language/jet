// L8a scheduler: an OS worker runs each task to completion. A wait returns a
// delivered stop word; no Jet frame unwinds. Linux synchronization is Sync.jet.
// Control232: refs0 paused8 canceled16 attention24 status32 stop40 pending48
// observe56 park64 mutex72 waiters80 callbacks88 inline96 scopeFlags104
// requestedRootCode112 capture120 openGroups128 joinedReason136
// joinedSite144 site152 waitKind160 waitTarget168 waitArmed176 waitCycle184
// (WaitCycle.jet's deadlock stops) replayId192 replayOrdinal200
// (RecordReplay.jet) leaky208 (Channel.jet's sender ledger no longer counts
// the task as a holder) deadlineWatch216 watchedDeadline224
// (scheduler_deadline_watch). StopCleanup's opaque token
// owns old flags. openGroups heads the task groups the task has open
// (TaskGroup.jet task_group_open), linked through each group and read under
// mutex72. joinedReason and joinedSite are the reason and site of the last
// failed task this control joined; site is the one its next task stop
// publishes (scheduler_site_store).
// Stop64: kind0 jct8 owner16 start24 end32 owned E4 message40 form48 (0 raw,
// 1 rendered diagnostic) site56 (a task stop's report context, or 0); -1
// denotes absent optional comptime metadata.

// #4890: role facts belong to the real current control, never Rust TLS.
SCHEDULER_SCOPE_ROOT: I64{1}

SCHEDULER_SCOPE_TASK: I64{2}

SCHEDULER_SCOPE_CLEANUP: I64{4}

SCHEDULER_SCOPE_INHERITED_STOP: I64{8}

SCHEDULER_SCOPE_TASK_CLEANUP_ORIGIN: I64{16}

SCHEDULER_SCOPE_MASK_KIND: I64{1792}

// Nonzero while any task's stop poll may have something to deliver that no
// call of its own published: a stop published to another task's control or
// by a memory hook (scheduler_hook_checks_arm), an interrupt, a cancel, a
// strong pause, a passed deadline or a turn request. A program's loops read it (as
// the runtime object's data symbol jet_rt_checks_armed, JetIR
// X64Select.jet ir_x64_stop_point; on the web, at
// the address the runtime partition's receipt names, JetWeb Select.jet
// web_stop_point) before a stop poll that checks no call, and enter the
// poll's routine only while it is set; that routine tests the task control
// and the turn word as every other poll does. A program that asks for none
// of these runs its loops unarmed.
scheduler_checks_armed := I64{0}

// Nonzero once a request other than a turn armed the polls (stops, cancels,
// pauses, passed deadlines: scheduler_checks_arm). Those stay pending on a task's
// own control, which no other task can see, so they keep the polls armed for
// good. Turn requests alone are the monitor's, which settles the word once
// no work waits (scheduler_checks_settle).
scheduler_checks_held := I64{0}

scheduler_checks_arm: fn() {
    #Unsafe("idempotent flags: every writer stores the same 1, the held one first") {
        scheduler_checks_held = I64{1}
        scheduler_checks_armed = I64{1}
    }
}

// The monitor asked a busy fiber for its turn (scheduler_monitor_scan): its
// loops must enter the poll's routine to give the carrier up.
scheduler_checks_arm_turns: fn() {
    #Unsafe("an idempotent flag: every writer stores the same 1") {
        scheduler_checks_armed = I64{1}
    }
}

// The monitor found no work waiting for a carrier: a turn it asked for
// earlier would give the carrier to nobody, so unless another request holds
// the polls armed, the loops run unarmed again. The locked add on `root`'s
// monitor word orders the cleared word before the held flag's read, so an
// arm racing the clear has either been seen here or stores its 1 after it.
scheduler_checks_settle: fn(root: I64) {
    if (scheduler_checks_held != I64{0} || scheduler_checks_armed == I64{0}) {
        return
    }
    #Unsafe("the monitor is the only thread that clears the flag; an arm it races restores it") {
        scheduler_checks_armed = I64{0}
    }
    _ := sync_add(wrapping(root + I64{216}), I64{0})
    if (scheduler_checks_held != I64{0}) { scheduler_checks_arm() }
}

// A control's attention word (+24): what its stop polls take beyond a
// published stop (scheduler_check_loops). A strong pause holds the task
// there; a cancel and a passed deadline are delivered there, so a busy loop
// stops at its next turn. Only a turn poll enters its routine on the deadline
// bit (JetIR IR.jet ir_stop_attention spells the bits each poll tests): the
// poll after a call leaves a deadline to the wait points.
SCHEDULER_ATTEND_PAUSE: I64{1}

SCHEDULER_ATTEND_CANCEL: I64{2}

SCHEDULER_ATTEND_DEADLINE: I64{4}

// A fiber's turn word, in its TCB: the monitor sets it once the fiber has run
// a whole tick on its carrier while other work waits (scheduler_monitor_scan).
// Every stop poll tests it with the task control (JetIR X64Select.jet
// ir_x64_stop_quiet), and the poll's routine then gives the carrier to that
// work (scheduler_turn_give), so busy tasks take turns at their checks.
SCHEDULER_TCB_TURN: I64{448}

// Gives up the carrier once the monitor asked for this fiber's turn: the
// fiber joins the back of the ready queue and continues when a carrier takes
// it again. The word is cleared first, so one request yields once.
scheduler_turn_give: fn() {
    base: thread_base()
    if (base == I64{0}) {
        return
    }
    turn: wrapping(base + SCHEDULER_TCB_TURN)
    if (sync_load(turn) == I64{0}) {
        return
    }
    sync_store(turn, I64{0})
    fiber: sync_load(wrapping(base + I64{56}))
    if (fiber != I64{0}) { fiber_yield(fiber) }
}

// Raises (on) or clears the attention bits of a control. Raising arms the
// loops' polls first, so a poll that sees the bits also enters its routine;
// bits already raised were armed by their first raise.
scheduler_attention_set: fn(control: I64, bits: I64, on: Bool) {
    address: wrapping(control + I64{24})
    if on {
        if (sync_load(address) & bits == bits) {
            return
        }
        scheduler_checks_arm()
    }
    loop {
        old: sync_load(address)
        new: if on -> old | bits else -> old & (bits ~ I64{-1})
        if (old == new) || (sync_cas(address, old, new) == old) {
            return
        }
    }
}

// The current task or root has a deadline in force (Deadline.jet): its
// control watches for it to pass.
scheduler_deadline_attend: fn() {
    control: scheduler_control_current()
    if (control != I64{0}) { scheduler_deadline_watch(control, jet_ctx_deadline_ms()) }
}

// A control's deadline watch (deadlineWatch216, for the wall-millisecond
// deadline at watchedDeadline224): a timer of the wheel
// (scheduler_timer_schedule) that raises the control's deadline bit once
// `deadline_ms` has passed. Until then the turn polls test that bit and read
// no clock. A deadline that has already passed raises the bit now, one that
// never passes needs no watch, and a pending watch for the same deadline
// stays. A world's clock moves only when the world advances it, which no
// timer sees, and a host that runs no thread alongside a computing one
// (Sync.jet jet_rt_host_parallel) runs no timer then either: there the bit
// is raised now and the turn polls read the clock.
scheduler_deadline_watch: fn(control: I64, deadline_ms: I64) {
    remaining: deadline_remaining_ns(deadline_ms)
    if (remaining == I64{0} || world_current() != I64{0} || jet_rt_host_parallel() == I64{0}) {
        scheduler_deadline_unwatch(control)
        scheduler_attention_set(control, SCHEDULER_ATTEND_DEADLINE, true)
        return
    }
    node: sync_load(wrapping(control + I64{216}))
    if (node != I64{0} && sync_load(wrapping(node + I64{24})) != I64{0} && sync_load(wrapping(control + I64{224})) == deadline_ms) {
        return
    }
    scheduler_deadline_unwatch(control)
    if (remaining == I64{9223372036854775807}) {
        return
    }
    sync_store(wrapping(control + I64{224}), deadline_ms)
    sync_store(wrapping(control + I64{216}), scheduler_timer_schedule(sync_deadline(remaining), I64{0}, control))
}

// Ends the control's deadline watch. The cancel takes the wheel's lock, under
// which a due timer raises its bit, so no watch raises the bit after this.
scheduler_deadline_unwatch: fn(control: I64) {
    node: sync_swap(wrapping(control + I64{216}), I64{0})
    if (node != I64{0}) { scheduler_timer_cancel(node) }
}

// The context's deadlines all ended (Deadline.jet jet_ctx_pop_deadline): the
// watch ends and the turn polls are quiet again.
scheduler_deadline_leave: fn() {
    control: scheduler_control_current()
    if (control == I64{0}) {
        return
    }
    scheduler_deadline_unwatch(control)
    scheduler_attention_set(control, SCHEDULER_ATTEND_DEADLINE, false)
}

// A wait that returns its typed timeout (`DeadlineBlown`) has delivered the
// deadline in force when that deadline is what ended it: the watch ends and
// the stop polls leave it to the wait points until a deadline is set or
// restored again (scheduler_deadline_attend). A wait counts on its own clock,
// which can end a slice (10 ms) ahead of the context's; a timeout from the
// wait's own shorter limit delivers nothing.
scheduler_deadline_reported: fn() {
    control: scheduler_control_current()
    if (control == I64{0}) || !jet_ctx_deadline_present() || (jet_deadline_remaining_ms() > I64{10}) {
        return
    }
    scheduler_deadline_unwatch(control)
    scheduler_attention_set(control, SCHEDULER_ATTEND_DEADLINE, false)
}

// Exact E4 carrier; rounded byte capacity allows generated literal word stores.
scheduler_text_new: fn(length: I64) -> I64 {
    capacity: (length + I64{7}) & I64{-8}
    text: rt_text_with_length(length, capacity)
    if (text == I64{0}) { return I64{0} }
    if (capacity != I64{0}) { coll_zero(sync_load(text), capacity) }
    text
}

scheduler_text_empty: fn() -> I64 { rt_text_copy(I64{1}, I64{0}) }

scheduler_text_concat: fn(left: I64, right: I64) -> I64 {
    a: sync_load(wrapping(left + I64{8}))
    b: sync_load(wrapping(right + I64{8}))
    if (b > I64{9223372036854775807} - a) {
        rt_seq_capacity_overflow_stop()
        return I64{0}
    }
    result: scheduler_text_new(a + b)
    if (result == I64{0} && jet_rt_session_propagate() != I64{0}) { return I64{0} }
    coll_copy(sync_load(left), sync_load(result), a)
    coll_copy(sync_load(right), wrapping(sync_load(result) + a), b)
    result
}

scheduler_words_push: fn(header: I64, word: I64) {
    length: sync_load(header)
    thread_words_grow(header, length + I64{1})
    sync_store(wrapping(sync_load(wrapping(header + I64{16})) + length * I64{8}), word)
    sync_store(header, length + I64{1})
}

scheduler_words_drop: fn(header: I64) {
    capacity: sync_load(wrapping(header + I64{8}))
    if (capacity != I64{0}) {
        jet_rt_free(sync_load(wrapping(header + I64{16})), capacity * I64{8}, I64{8})
    }
    jet_rt_free(header, I64{24}, I64{8})
}

// Every control starts here, so the stop rail's root half (Trap.jet
// trap_root_rail_code) is installed before any control can hold a stop.
scheduler_control_new: fn() -> I64 {
    if (trap_root_rail_code == I64{0}) {
        #Unsafe("an idempotent install: every writer stores the same code address") {
            trap_root_rail_code = rt_trap_root_address()
        }
    }
    control: jet_rt_alloc(SCHEDULER_CONTROL_BYTES, I64{8})
    thread_zero(control, SCHEDULER_CONTROL_BYTES)
    sync_store(control, I64{1})
    sync_store(wrapping(control + I64{64}), sync_park_new())
    control
}

// Trap.jet trap_root's target: the root's half of a trap, which the trap
// reaches only once it has found the control that holds its capture or owns
// its stop. PREPARE begins a root stop's captured report, except for a
// process-fatal stop, whose report goes straight to fd 2 and whose EXIT then
// finds no capture. WRITE and
// WRITE_WORD append `b` (an address or a word) of `c` bytes to the capture
// `a`. EXIT publishes the captured report with status `a` to the root; an
// exit with no captured report (jet_rt_process_exit called directly, as an
// `#Import(c)` caller does) has nothing to publish, so it returns 0 and the
// trap ends the process with `a` itself. DROP discards the capture of
// control `a`. SITE_BEGIN, SITE_END and JOINED_SITE are a task stop's site
// (Trap.jet trap_task_site_begin) with its message `a` of `b` bytes;
// SITE_BEGIN returns 1 only when it began a capture. The others return 1.
#Export(c) jet_rt_trap_root: fn(op: I64, a: I64, b: I64, c: I64) -> I64 {
    if (op == TRAP_ROOT_PREPARE) {
        if !scheduler_stop_fatal() -> scheduler_root_capture_begin()
    } else if (op == TRAP_ROOT_EXIT) {
        text: scheduler_root_capture_take(scheduler_control_current())
        if (text == I64{0}) { return I64{0} }
        _ := scheduler_root_publish_owned(text, a)
    } else if (op == TRAP_ROOT_DROP) { jet_rt_string_drop(scheduler_root_capture_take(a)) } else if (op == TRAP_ROOT_WRITE) {
        rt_text_append(a, b, c)
    } else if (op == TRAP_ROOT_WRITE_WORD) { rt_text_append_raw_word(a, b, c) } else if (op == TRAP_ROOT_SITE_BEGIN) {
        return trap_task_site_open()
    } else if (op == TRAP_ROOT_SITE_END) { trap_task_site_publish(a, b) } else {
        trap_joined_site_write(a, b)
    }
    I64{1}
}

// RuntimeLower resolves this checked function-address entry, never the body.
rt_trap_root_address: fn() -> I64 {
    loop { jet_rt_unreachable(I64{0}, I64{0}) }
}

scheduler_control_retain: fn(control: I64) {
    if (control != I64{0}) { _ := sync_add(control, I64{1}) }
}

scheduler_stop_drop: fn(record: I64) {
    if (record == I64{0}) {
        return
    }
    jet_rt_string_drop(sync_load(wrapping(record + I64{40})))
    jet_rt_string_drop(sync_load(wrapping(record + I64{56})))
    jet_rt_free(record, I64{64}, I64{8})
}

scheduler_stop_take_message: fn(record: I64) -> I64 {
    sync_swap(wrapping(record + I64{40}), I64{0})
}

scheduler_control_drop: fn(control: I64) {
    if (control == I64{0}) {
        return
    }
    if (sync_add(control, I64{-1}) != I64{1}) {
        return
    }
    scheduler_stop_drop(sync_load(wrapping(control + I64{40})))
    jet_rt_string_drop(scheduler_root_capture_take(control))
    sync_park_drop(sync_load(wrapping(control + I64{64})))
    scheduler_deadline_unwatch(control)
    // Scoped waiter/callback guards retain the control and unregister first;
    // an open group retains its opener until it closes.
    if (sync_load(wrapping(control + I64{80})) != I64{0} || sync_load(wrapping(control + I64{88})) != I64{0} || sync_load(wrapping(control + I64{128})) != I64{0}) {
        jet_rt_unreachable(I64{0}, I64{0})
    }
    jet_rt_string_drop(sync_load(wrapping(control + I64{136})))
    jet_rt_string_drop(sync_load(wrapping(control + I64{144})))
    jet_rt_string_drop(sync_load(wrapping(control + I64{152})))
    jet_rt_free(control, SCHEDULER_CONTROL_BYTES, I64{8})
}

// A task stop's site travels with its failure. The stop writes its report
// context and stores it here (Trap.jet trap_task_site_publish); its publication
// moves it onto the stop record (rt_task_panic_publish_owned); the join that
// takes the failure hands the site and the failure's reason to the joiner's
// control (Task.jet task_panic_site_hand). A stop whose message is that
// reason re-raises the failure: at the root it shows the site under its own
// context, in a task it publishes the site ahead of its own.
scheduler_site_store: fn(control: I64, site: I64) {
    jet_rt_string_drop(sync_swap(wrapping(control + I64{152}), site))
}

scheduler_joined_store: fn(control: I64, reason: I64, site: I64) {
    jet_rt_string_drop(sync_swap(wrapping(control + I64{136}), reason))
    jet_rt_string_drop(sync_swap(wrapping(control + I64{144}), site))
}

// The joined failure's site, taken, when `message` (of `length` bytes) is
// that failure's reason; 0 otherwise, and the joined pair stays.
scheduler_joined_site_take: fn(control: I64, message: I64, length: I64) -> I64 {
    if (control == I64{0}) { return I64{0} }
    reason: sync_load(wrapping(control + I64{136}))
    if (reason == I64{0} || rt_text_len(reason) != length) { return I64{0} }
    data: rt_text_data(reason)
    at := I64{0}
    loop at < length {
        if (trap_byte(wrapping(data + at)) != trap_byte(wrapping(message + at))) { return I64{0} }
        at += I64{1}
    }
    jet_rt_string_drop(sync_swap(wrapping(control + I64{136}), I64{0}))
    sync_swap(wrapping(control + I64{144}), I64{0})
}

scheduler_control_current: fn() -> I64 { sync_load(wrapping(thread_base() + I64{16})) }

// Only diagnostic/startup paths use this syscall probe. The attached hot
// scheduler query above remains a single TCB load. A failed probe is a host
// defect: do not recurse into a reporter whose ownership cannot be established.
// An unattached thread's GS names the detached zero word; report it as 0.
scheduler_report_base: fn() -> I64 {
    base := I64{0}
    #Unsafe("the cold OS leaf borrows its initialized stack word; a successful nonzero base is this attached thread's live Jet TCB or the detached zero word") {
        base = os_tls_base_probe_i64()
    }
    if (base < I64{0}) { trap_gs_failure() }
    if (base == thread_detached_base()) -> I64{0} else -> base
}

scheduler_report_control_current: fn() -> I64 {
    base: scheduler_report_base()
    if (base == I64{0}) { return I64{0} }
    sync_load(wrapping(base + I64{16}))
}

scheduler_report_domain: fn() -> I64 {
    if (scheduler_report_base() == I64{0}) { return I64{0} }
    jet_rt_stop_domain()
}

scheduler_control_status: fn(control: I64) -> I64 {
    if (control == I64{0}) -> I64{0} else -> sync_load(wrapping(control + I64{32}))
}

// Caller owns 32B and keeps the borrowed controls alive for the entire scope.
// Deadlines remain inherited in @48/@56, including the inner test boundary.
scheduler_control_enter: fn(control: I64, save: I64) {
    base: thread_base()
    parent: sync_load(wrapping(base + I64{16}))
    sync_store(save, parent)
    sync_store(wrapping(save + I64{8}), sync_load(wrapping(base + I64{24})))
    sync_store(wrapping(save + I64{16}), sync_load(wrapping(base + I64{32})))
    sync_store(wrapping(save + I64{24}), sync_load(wrapping(base + I64{64})))
    sync_store(wrapping(base + I64{16}), control)
    if parent != control -> sync_store(wrapping(base + I64{24}), I64{0})
    sync_store(wrapping(base + I64{32}), sync_load(wrapping(base + I64{32})) + I64{1})
}

scheduler_control_leave: fn(save: I64) {
    base: thread_base()
    sync_store(wrapping(base + I64{16}), sync_load(save))
    sync_store(wrapping(base + I64{24}), sync_load(wrapping(save + I64{8})))
    sync_store(wrapping(base + I64{32}), sync_load(wrapping(save + I64{16})))
    sync_store(wrapping(base + I64{64}), sync_load(wrapping(save + I64{24})))
}

// A process/test/doc root is not a Task frame. Keep the parent's control,
// shield, wait depth and body provenance untouched in the caller's save slot.
#Export(c) jet_rt_root_begin: fn(save: I64) -> I64 {
    parent: scheduler_control_current()
    parent_flags: scheduler_scope_flags(parent)
    inherited: (parent_flags & SCHEDULER_SCOPE_INHERITED_STOP) != I64{0} || ((parent_flags & SCHEDULER_SCOPE_CLEANUP) != I64{0} && scheduler_scope_delivered_kind(parent_flags) != I64{0})
    control: scheduler_control_new()
    sync_store(wrapping(control + I64{104}), SCHEDULER_SCOPE_ROOT | (if inherited -> SCHEDULER_SCOPE_INHERITED_STOP else -> I64{0}))
    // jet_scheduler_with_root_control: an entry with no current control runs
    // under the process root task control.
    if (parent == I64{0}) { scheduler_process_root_install(control) }
    scheduler_control_enter(control, save)
    sync_store(wrapping(thread_base() + I64{64}), I64{0})
    control
}

#Export(c) jet_rt_root_leave: fn(control: I64, save: I64) {
    scheduler_control_leave(save)
    scheduler_process_root_release(control)
    scheduler_control_drop(control)
}

// The process root task control. Process signals cancel it; a canceled (or
// absent) root is replaced by a fresh root control at the next lookup, which
// the running entry does not adopt. The slot owns one reference and is guarded
// by the scheduler root mutex.
scheduler_process_root := I64{0}

scheduler_process_root_install: fn(control: I64) {
    scheduler_control_retain(control)
    sync_thread_lock(scheduler_root)
    previous: scheduler_process_root
    #Unsafe("written under the scheduler root mutex") { scheduler_process_root = control }
    sync_thread_unlock(scheduler_root)
    scheduler_control_drop(previous)
}

scheduler_process_root_release: fn(control: I64) {
    sync_thread_lock(scheduler_root)
    owned: scheduler_process_root == control
    if owned {
        #Unsafe("written under the scheduler root mutex") { scheduler_process_root = I64{0} }
    }
    sync_thread_unlock(scheduler_root)
    if owned -> scheduler_control_drop(control)
}

// Returns a retained reference the caller drops.
scheduler_root_task_control: fn() -> I64 {
    sync_thread_lock(scheduler_root)
    previous: scheduler_process_root
    replaced := I64{0}
    if (previous == I64{0} || sync_load(wrapping(previous + I64{16})) != I64{0}) {
        fresh: scheduler_control_new()
        sync_store(wrapping(fresh + I64{104}), SCHEDULER_SCOPE_ROOT)
        #Unsafe("written under the scheduler root mutex") { scheduler_process_root = fresh }
        replaced = previous
    }
    control: scheduler_process_root
    scheduler_control_retain(control)
    sync_thread_unlock(scheduler_root)
    scheduler_control_drop(replaced)
    control
}

scheduler_control_is_root: fn(control: I64) -> Bool {
    (scheduler_scope_flags(control) & SCHEDULER_SCOPE_ROOT) != I64{0}
}

// jet_task_deliver_cancel: only a task unwinds a delivered cancellation. A
// canceled root has no catch frame: its wait points observe the flag and
// return their cooperative fallback without publishing a stop.
scheduler_root_cancel_observed: fn() -> Bool {
    control: scheduler_control_current()
    control != I64{0} && scheduler_control_is_root(control) && sync_load(wrapping(control + I64{16})) != I64{0} && !scheduler_shielded()
}

// Only scheduler_text_new's owned, eight-aligned 24B E4 header is tagged.
// Bit0 records an actual requested code independently of opaque scope flags.
scheduler_root_capture_pointer: fn(control: I64) -> I64 {
    if (control == I64{0}) -> I64{0} else -> sync_load(wrapping(control + I64{120})) & I64{-2}
}

scheduler_root_capture_begin: fn() {
    control: scheduler_control_current()
    if (scheduler_root_capture_pointer(control) != I64{0}) { scheduler_abort_double_panic() }
    text: scheduler_text_empty()
    sync_store(wrapping(control + I64{120}), text | (sync_load(wrapping(control + I64{120})) & I64{1}))
}

scheduler_root_capture_take: fn(control: I64) -> I64 {
    word: sync_load(wrapping(control + I64{120}))
    sync_store(wrapping(control + I64{120}), word & I64{1})
    word & I64{-2}
}

scheduler_root_code_known: fn(control: I64) -> Bool {
    (sync_load(wrapping(control + I64{120})) & I64{1}) != I64{0}
}

scheduler_root_set_code: fn(control: I64, code: I64) {
    sync_store(wrapping(control + I64{112}), code)
    sync_store(wrapping(control + I64{120}), sync_load(wrapping(control + I64{120})) | I64{1})
}

// Takes an already checked Panic record. This one named publication sink is
// shared by Task, Root, rendered Sentry and transported Parallel failures.
scheduler_panic_publish_record: fn(record: I64) -> Bool {
    control: scheduler_control_current()
    if ((scheduler_scope_flags(control) & SCHEDULER_SCOPE_ROOT) != I64{0}) {
        if (sync_load(wrapping(record + I64{48})) == I64{0}) {
            old: scheduler_stop_take_message(record)
            rendered: trap_root_panic_report(old)
            jet_rt_string_drop(old)
            sync_store(wrapping(record + I64{40}), rendered)
            sync_store(wrapping(record + I64{48}), I64{1})
        }
        if !scheduler_root_code_known(control) {
            scheduler_root_set_code(control, EXIT_RUNTIME_PANIC)
        }
    }
    scheduler_native_publish(record)
}

scheduler_root_publish_owned: fn(text: I64, code: I64) -> Bool {
    if (jet_rt_stop_domain() != I64{1}) {
        jet_rt_string_drop(text)
        return false
    }
    if scheduler_stop_fatal() {
        jet_rt_stdout_flush()
        if (text != I64{0}) { trap_write_handle(text) }
        jet_rt_string_drop(text)
        trap_exit(code)
        return false
    }
    record: scheduler_stop_new(I64{5}, text)
    sync_store(wrapping(record + I64{48}), I64{1})
    scheduler_root_set_code(scheduler_control_current(), code)
    scheduler_panic_publish_record(record)
}

#Export(c) jet_rt_root_publish_rendered: fn(message: I64, length: I64, requested_code: I64) -> Bool {
    if (jet_rt_stop_domain() != I64{1}) { return false }
    text := I64{0}
    if (length != I64{0}) {
        text = scheduler_text_new(length)
        if (text == I64{0} && jet_rt_session_propagate() != I64{0}) { return false }
        coll_copy(message, sync_load(text), length)
    }
    scheduler_root_publish_owned(text, requested_code)
}

#Export(c) jet_rt_root_take_stop: fn(control: I64, code_out: I64) -> I64 {
    record: scheduler_control_take_stop(control)
    if (record == I64{0}) { return I64{0} }
    kind: sync_load(record)
    if (kind == I64{1} || kind < I64{1} || kind > I64{5}) { jet_rt_unreachable(I64{0}, I64{0}) }
    code := EXIT_RUNTIME_PANIC
    if {
        (kind == I64{3} || kind == I64{4}) -> {
            status: if (kind == I64{3}) -> I64{2} else -> I64{3}
            if (sync_load(wrapping(record + I64{8})) != status) {
                jet_rt_unreachable(I64{0}, I64{0})
            }
            _ := comptime_stop_frame_write(
                status,
                sync_load(wrapping(record + I64{16})),
                sync_load(wrapping(record + I64{24})),
                sync_load(wrapping(record + I64{32})),
            )
            jet_rt_string_drop(scheduler_stop_take_message(record))
            code = I64{80} + status
        }
        (kind == I64{5}) -> {
            if (sync_load(wrapping(record + I64{48})) != I64{1} || !scheduler_root_code_known(control)) {
                jet_rt_unreachable(I64{0}, I64{0})
            }
            code = sync_load(wrapping(control + I64{112}))
        }
        // Deadline already owns the complete registered E3003 report.
        else -> {}
    }
    sync_store(wrapping(record + I64{48}), I64{1})
    sync_store(code_out, code)
    sync_store(wrapping(control + I64{120}), sync_load(wrapping(control + I64{120})) & I64{-2})
    record
}

scheduler_control_take_stop: fn(control: I64) -> I64 {
    sync_mutex_lock(wrapping(control + I64{72}))
    record: sync_swap(wrapping(control + I64{40}), I64{0})
    sync_store(wrapping(control + I64{32}), I64{0})
    sync_mutex_unlock(wrapping(control + I64{72}))
    record
}

scheduler_control_discard_stop: fn(control: I64) {
    scheduler_stop_drop(scheduler_control_take_stop(control))
}

// Every stop record settles the test harness's assertion mark (TestCapture.jet
// test_stop_assertion_settle): only a rendered report (kind 5) keeps it.
scheduler_stop_new: fn(kind: I64, message: I64) -> I64 {
    test_stop_assertion_settle(kind == I64{5})
    record: jet_rt_alloc(I64{64}, I64{8})
    sync_store(record, kind)
    sync_store(wrapping(record + I64{8}), I64{-1})
    sync_store(wrapping(record + I64{16}), I64{-1})
    sync_store(wrapping(record + I64{24}), I64{-1})
    sync_store(wrapping(record + I64{32}), I64{-1})
    sync_store(wrapping(record + I64{40}), message)
    sync_store(wrapping(record + I64{48}), I64{0})
    sync_store(wrapping(record + I64{56}), I64{0})
    record
}

// The status the process ends with once its root takes the stop `record`
// published to it (`control`), as jet_rt_root_take_stop gives it.
scheduler_root_stop_code: fn(control: I64, record: I64) -> I64 {
    kind: sync_load(record)
    if (kind == I64{3} || kind == I64{4}) {
        status: if (kind == I64{3}) -> I64{2} else -> I64{3}
        return I64{80} + status
    }
    if (kind == I64{5}) { return sync_load(wrapping(control + I64{112})) }
    EXIT_RUNTIME_PANIC
}

// Takes the record, including on rejection. First stop wins, except Deadline
// supersedes `Canceled`. Record precedes release status.
scheduler_control_publish: fn(control: I64, record: I64) -> Bool {
    kind: sync_load(record)
    // A root never unwinds a cancellation (scheduler_root_cancel_observed).
    if (control == I64{0} || kind < I64{1} || kind > I64{5} || (kind == I64{5} && jet_rt_stop_domain() == I64{0}) || (kind == I64{1} && scheduler_control_is_root(control))) {
        scheduler_stop_drop(record)
        return false
    }
    // jet_rt_main ends an entry stopped at the process root through this
    // hook, which only a stop published there needs.
    if (control == main_root_control && main_stopped_code == I64{0}) {
        main_stopped_install(rt_main_stopped_address())
    }
    // Read before the root can take the record (main_root_stop).
    ending: if (control == main_root_control) -> scheduler_root_stop_code(control, record) else -> I64{0}
    sync_mutex_lock(wrapping(control + I64{72}))
    old: sync_load(wrapping(control + I64{32}))
    // A task panic replaces an undelivered cancellation/deadline/budget.
    // rt_task_panic_publish has already rejected a delivered double panic.
    accepted: old == I64{0} || (old == I64{1} && kind == I64{2}) || (kind == I64{5} && old >= I64{1} && old <= I64{4})
    previous := I64{0}
    if accepted {
        previous = sync_load(wrapping(control + I64{40}))
        sync_store(wrapping(control + I64{40}), record)
        sync_store(wrapping(control + I64{32}), kind)
        if (control != scheduler_control_current()) { scheduler_checks_arm() }
    }
    sync_mutex_unlock(wrapping(control + I64{72}))
    if accepted -> scheduler_stop_drop(previous) else -> scheduler_stop_drop(record)
    // jet_rt_main's root takes every stop it accepts and ends the process,
    // so the frames unwinding to it leave their heap to the kernel (#5478),
    // and a debugger pauses before they unwind (main_root_stop).
    if (accepted && control == main_root_control) {
        main_process_end()
        main_root_stop(ending)
    }
    accepted
}

scheduler_native_publish: fn(record: I64) -> Bool {
    scheduler_control_publish(scheduler_control_current(), record)
}

scheduler_shielded: fn() -> Bool { sync_load(wrapping(thread_base() + I64{24})) > I64{0} }

scheduler_scope_flags: fn(control: I64) -> I64 {
    if (control == I64{0}) -> I64{0} else -> sync_load(wrapping(control + I64{104}))
}

scheduler_scope_delivered_kind: fn(flags: I64) -> I64 {
    (flags & SCHEDULER_SCOPE_MASK_KIND) >> I64{8}
}

// Origin16 is dynamic: only an actual native Task frame can mint it.
// The saved scalar is owned; zero is a valid token and must also be restored.
#Export(c) jet_rt_session_cleanup_enter: fn(delivered_at_entry: I64) -> I64 {
    control: scheduler_control_current()
    if (control == I64{0}) { return I64{0} }
    saved: scheduler_scope_flags(control)
    flags := (saved & I64{-1793}) | SCHEDULER_SCOPE_CLEANUP
    if (sync_load(wrapping(thread_base() + I64{64})) != I64{0}) {
        flags |= SCHEDULER_SCOPE_TASK_CLEANUP_ORIGIN
    }
    if (delivered_at_entry >= I64{1} && delivered_at_entry <= I64{5} && scheduler_control_status(control) == delivered_at_entry) {
        flags |= delivered_at_entry << I64{8}
    }
    sync_store(wrapping(control + I64{104}), flags)
    saved
}

#Export(c) jet_rt_session_cleanup_leave: fn(saved_flags: I64) {
    control: scheduler_control_current()
    if (control != I64{0}) { sync_store(wrapping(control + I64{104}), saved_flags) }
}

// Compiler cleanup frames (Codegen/Builder.jet jet_codegen_emit_cleanup_frame,
// lowered by Routes.jet lower_native_control_call) are one runtime cleanup
// scope plus Shield, the idiom of every runtime-owned close: a stop pending at
// entry stays in its control slot while Check/Propagate delivery of it is
// masked, a new panic over it is process-fatal (scheduler_panic_check), and
// cancellation/deadlines arriving meanwhile are held until leave delivers them.
// The returned word is the owned session token.
#Export(c) jet_rt_cleanup_enter: fn() -> I64 {
    saved: jet_rt_session_cleanup_enter(jet_scheduler_native_status())
    jet_scheduler_shield_enter()
    saved
}

#Export(c) jet_rt_cleanup_leave: fn(saved: I64) {
    jet_scheduler_shield_leave()
    jet_rt_session_cleanup_leave(saved)
}

#Export(c) jet_rt_stop_domain: fn() -> I64 {
    control: scheduler_control_current()
    if (control == I64{0}) { return I64{0} }
    flags: scheduler_scope_flags(control)
    body: sync_load(wrapping(thread_base() + I64{64})) != I64{0}
    if ((flags & SCHEDULER_SCOPE_ROOT) != I64{0} && !body) { return I64{1} }
    if body || ((flags & SCHEDULER_SCOPE_TASK) != I64{0} && (flags & SCHEDULER_SCOPE_CLEANUP) != I64{0} && (flags & SCHEDULER_SCOPE_TASK_CLEANUP_ORIGIN) != I64{0}) {
        return I64{2}
    }
    I64{0}
}

scheduler_cleanup_mask: fn(status: I64) -> I64 {
    flags: scheduler_scope_flags(scheduler_control_current())
    delivered: scheduler_scope_delivered_kind(flags)
    if ((flags & SCHEDULER_SCOPE_CLEANUP) != I64{0} && delivered >= I64{1} && delivered <= I64{5} && status == delivered) -> I64{0} else -> status
}

// Shield defers cancellation/deadline/interrupt-class stops, never a panic
// or runtime fault: Rust unwinds those through the shield.
scheduler_delivered_status_unmasked: fn() -> I64 {
    status: scheduler_control_status(scheduler_control_current())
    if scheduler_shielded() && !(status >= I64{3} && status <= I64{5}) -> I64{0} else -> status
}

scheduler_delivered_status: fn() -> I64 {
    scheduler_cleanup_mask(scheduler_delivered_status_unmasked())
}

#Export(c) jet_scheduler_native_status: fn() -> I64 {
    scheduler_control_status(scheduler_control_current())
}

#Export(c) jet_scheduler_native_poll: fn() -> I64 {
    if scheduler_shielded() -> return scheduler_delivered_status()
    control: scheduler_control_current()
    if (control == I64{0}) { return I64{0} }
    if (sync_swap(wrapping(control + I64{48}), I64{0}) != I64{0}) {
        _ := scheduler_control_publish(control, scheduler_stop_new(I64{1}, scheduler_text_empty()))
    }
    scheduler_check_loops(control)
    scheduler_check_loop_deadline(control)
    scheduler_cleanup_mask(scheduler_control_status(control))
}

#Export(c) jet_scheduler_native_propagate: fn() -> I64 {
    control: scheduler_control_current()
    if (control != I64{0}) { scheduler_check_loops(control) }
    scheduler_delivered_status()
}

#Export(c) jet_rt_session_status: fn() -> I64 { jet_scheduler_native_status() }

#Export(c) jet_rt_session_poll: fn() -> I64 { jet_scheduler_native_poll() }

// The stop poll's routine (JetIR X64Select.jet ir_x64_stop_poll), which
// runtime code calls at its own stop points too: a turn the monitor asked
// for is given there before the stop is propagated.
#Export(c) jet_rt_session_propagate: fn() -> I64 {
    scheduler_turn_give()
    control: scheduler_control_current()
    if (control != I64{0}) { scheduler_check_loops(control) }
    scheduler_delivered_status()
}

// Whether a stop is delivered to the running task, the word
// jet_rt_session_propagate answers, read without its turn or its attention:
// a buffer or memory route's check after a refused allocation or a memory
// hook, whose stop is already published. Neither the carrier nor a cancel
// or pause another task asked for is taken there; the program's next stop
// check takes them, so such a route publishes no stop of its own and no
// poll follows its call (JetIR BuildLibrary.jet ir_stop_exports).
scheduler_stop_pending: fn() -> I64 { scheduler_delivered_status() }

// After a memory hook ran program code (JetIR BuildLibrary.jet
// IR_STOP_DEFERRED), given the running task's stop status from before it
// (jet_scheduler_native_status): no poll follows the call that ran the
// hook, so a stop that code published waits for the task's next stop
// check, and a loop's check enters its routine only while the polls are
// armed. A stop the hook published arms them for good, as a stop published
// to another task does; one already pending before the hook ran is not its.
scheduler_hook_checks_arm: fn(before: I64) {
    status: scheduler_control_status(scheduler_control_current())
    if (status != I64{0} && status != before) { scheduler_checks_arm() }
}

// The turn poll's routine (JetIR IR.jet IR_STOP_TURN_KEY): at a loop's
// turn or a recursive body's entry a passed deadline is delivered too.
#Export(c) jet_rt_session_turn: fn() -> I64 {
    scheduler_turn_give()
    control: scheduler_control_current()
    if (control != I64{0}) {
        scheduler_check_loops(control)
        scheduler_check_loop_deadline(control)
    }
    scheduler_delivered_status()
}

#Export(c) jet_scheduler_shield_enter: fn() {
    if (scheduler_control_current() != I64{0}) {
        sync_store(wrapping(thread_base() + I64{24}), sync_load(wrapping(thread_base() + I64{24})) + I64{1})
    }
}

#Export(c) jet_scheduler_shield_leave: fn() {
    if (scheduler_control_current() == I64{0}) {
        return
    }
    address: wrapping(thread_base() + I64{24})
    depth: sync_load(address)
    sync_store(address, if (depth > I64{0}) -> depth - I64{1} else -> I64{0})
    if (sync_load(address) != I64{0}) {
        return
    }
    if {
        (jet_ctx_deadline_present() && jet_deadline_remaining_ms() <= I64{0}) -> {
            kind: scheduler_msg_shield()
            scheduler_deliver_deadline(kind)
            jet_rt_string_drop(kind)
        }
        scheduler_task_canceled() -> { scheduler_deliver_cancel() }
    }
}

// Leaves the runtime's own shield around a finished task body's cleanup.
// The body has no wait point or check left, so a cancel or blown deadline
// that arrived meanwhile has nothing to unwind and does not turn the
// completed value into a failure.
scheduler_shield_leave_finished: fn() {
    if (scheduler_control_current() == I64{0}) {
        return
    }
    address: wrapping(thread_base() + I64{24})
    depth: sync_load(address)
    sync_store(address, if (depth > I64{0}) -> depth - I64{1} else -> I64{0})
}

#Export(c) jet_rt_session_shield_enter: fn() { jet_scheduler_shield_enter() }

#Export(c) jet_rt_session_shield_leave: fn() { jet_scheduler_shield_leave() }

// jet_rt_task_panic_publish's code word: 0 until the first body enters.
task_panic_code := I64{0}

scheduler_body_enter: fn() -> I64 {
    if (task_panic_code == I64{0}) {
        #Unsafe("an idempotent install: every writer stores the same code address") {
            task_panic_code = rt_task_panic_publish_address()
        }
    }
    sync_swap(wrapping(thread_base() + I64{64}), I64{1})
}

scheduler_body_leave: fn(saved: I64) { sync_store(wrapping(thread_base() + I64{64}), saved) }

// Whether any task, parallel or realtime body has entered: stop domain 2
// exists only inside one (rt_task_panic_publish_recorded). A program that
// runs none may stop on a main thread with no TCB (Thread.jet
// jet_rt_thread_init), whose control a stop must not read.
scheduler_body_ever_entered: fn() -> Bool { task_panic_code != I64{0} }

// Lower.jet lower_poll_call_enter/leave bracket a checked operation whose
// immediate terminator is a Propagate poll: inside a body (bit 1) the call
// arms bit 2 for its duration; leave restores the caller's word exactly.
#Export(c) jet_rt_poll_call_enter: fn() -> I64 {
    cell: wrapping(thread_base() + I64{64})
    saved: sync_load(cell)
    if (saved & I64{1} != I64{0}) { sync_store(cell, saved | I64{2}) }
    saved
}

#Export(c) jet_rt_poll_call_leave: fn(saved: I64) {
    sync_store(wrapping(thread_base() + I64{64}), saved)
}

scheduler_task_canceled: fn() -> Bool {
    control: scheduler_control_current()
    control != I64{0} && sync_load(wrapping(control + I64{16})) != I64{0}
}

scheduler_deliver_cancel: fn() {
    if scheduler_root_cancel_observed() {
        return
    }
    _ := scheduler_native_publish(scheduler_stop_new(I64{1}, scheduler_text_empty()))
}

// Nodes32B: next0, slot/code8, env16, id24. Guards retain the control.
scheduler_cancel_waiter_register: fn(control: I64, slot: I64) -> I64 {
    if (control == I64{0}) { return I64{0} }
    node: jet_rt_alloc(I64{32}, I64{8})
    thread_zero(node, I64{32})
    sync_store(wrapping(node + I64{8}), slot)
    scheduler_control_retain(control)
    sync_mutex_lock(wrapping(control + I64{72}))
    sync_store(node, sync_load(wrapping(control + I64{80})))
    sync_store(wrapping(control + I64{80}), node)
    if (sync_load(wrapping(control + I64{16})) != I64{0}) { sync_park_wake(slot) }
    sync_mutex_unlock(wrapping(control + I64{72}))
    node
}

scheduler_node_unlink: fn(head: I64, node: I64) {
    link := head
    loop sync_load(link) != (I64{0}) {
        current: sync_load(link)
        if current == node {
            sync_store(link, sync_load(node))
            return
        }
        link = current
    }
}

scheduler_cancel_waiter_remove: fn(control: I64, node: I64) {
    if (node == I64{0}) {
        return
    }
    sync_mutex_lock(wrapping(control + I64{72}))
    scheduler_node_unlink(control + I64{80}, node)
    sync_mutex_unlock(wrapping(control + I64{72}))
    jet_rt_free(node, I64{32}, I64{8})
    scheduler_control_drop(control)
}

scheduler_control_cancel: fn(control: I64) {
    sync_store(wrapping(control + I64{16}), I64{1})
    scheduler_attention_set(control, SCHEDULER_ATTEND_CANCEL, true)
    jet_rt_observe_task_control(sync_load(wrapping(control + I64{56})), I64{-1}, I64{1})
    sync_park_wake(sync_load(wrapping(control + I64{64})))
    sync_mutex_lock(wrapping(control + I64{72}))
    waiter := sync_load(wrapping(control + I64{80}))
    loop waiter != (I64{0}) {
        sync_park_wake(sync_load(wrapping(waiter + I64{8})))
        waiter = sync_load(waiter)
    }
    // A task this one runs inline (scheduler_control_inline) is canceled
    // with it, as its join would cancel it on waking.
    forwarded: sync_load(wrapping(control + I64{96}))
    scheduler_control_retain(forwarded)
    callbacks: sync_load(wrapping(control + I64{88}))
    sync_store(wrapping(control + I64{88}), I64{0})
    node := callbacks
    loop node != (I64{0}) {
        sync_store(wrapping(node + I64{32}), I64{1})
        node = sync_load(node)
    }
    sync_mutex_unlock(wrapping(control + I64{72}))
    node = callbacks
    loop node != (I64{0}) {
        next_node: sync_load(node)
        _ := coll_call1(sync_load(wrapping(node + I64{8})), sync_load(wrapping(node + I64{16})))
        // Wake and publication share the control lock so a destructor cannot
        // free the node between the status store and futex wake.
        sync_mutex_lock(wrapping(control + I64{72}))
        sync_store(wrapping(node + I64{32}), I64{2})
        sync_wake(node + I64{32}, I64{2147483647})
        sync_mutex_unlock(wrapping(control + I64{72}))
        node = next_node
    }
    if (forwarded != I64{0}) {
        scheduler_control_cancel(forwarded)
        scheduler_control_drop(forwarded)
    }
    task_groups_cancel_open(control)
}

// Names the control of a task the running task's thread runs inline
// (Task.jet task_run_joined) at the running task's inline96, or clears it
// (0), under the control's lock: a cancel from then on cancels it too. A
// cancel already requested cancels it at once.
scheduler_control_inline: fn(control: I64, target: I64) {
    scheduler_control_retain(target)
    sync_mutex_lock(wrapping(control + I64{72}))
    previous: sync_load(wrapping(control + I64{96}))
    sync_store(wrapping(control + I64{96}), target)
    canceled: sync_load(wrapping(control + I64{16})) != I64{0}
    sync_mutex_unlock(wrapping(control + I64{72}))
    scheduler_control_drop(previous)
    if (canceled && target != I64{0}) { scheduler_control_cancel(target) }
}

// A cancel the task has consumed into its own result (an AsyncEvent entry's
// `Canceled` report): no later wait point or shield exit delivers it again.
scheduler_control_cancel_consume: fn(control: I64) {
    sync_store(wrapping(control + I64{16}), I64{0})
}

#Export(c) jet_rt_scheduler_control_cancel: fn(control: I64) { scheduler_control_cancel(control) }

#Export(c) jet_rt_scheduler_control_retain: fn(control: I64) { scheduler_control_retain(control) }

#Export(c) jet_rt_scheduler_control_drop: fn(control: I64) { scheduler_control_drop(control) }

scheduler_control_interrupt: fn(control: I64) {
    sync_store(wrapping(control + I64{48}), I64{1})
    scheduler_control_cancel(control)
}

scheduler_control_pause: fn(control: I64, mode: I64) {
    // The park is installed before the bit is raised, so a poll that sees
    // the bit finds it (scheduler_check_loops).
    if (mode == I64{1} && scheduler_pause_park_rail_code == I64{0}) {
        #Unsafe("an idempotent install: every writer stores the same code address") {
            scheduler_pause_park_rail_code = rt_scheduler_pause_park_address()
        }
    }
    scheduler_attention_set(control, SCHEDULER_ATTEND_PAUSE, mode == I64{1})
    sync_store(wrapping(control + I64{8}), I64{1})
    jet_rt_observe_task_control(sync_load(wrapping(control + I64{56})), I64{3}, I64{-1})
}

scheduler_control_resume: fn(control: I64) {
    sync_store(wrapping(control + I64{8}), I64{0})
    jet_rt_observe_task_control(sync_load(wrapping(control + I64{56})), I64{1}, I64{-1})
    sync_park_wake(sync_load(wrapping(control + I64{64})))
}

// Parks the current task while it is paused and not canceled. False when
// its deadline passed meanwhile, which delivered the deadline stop.
scheduler_park_while_paused: fn(control: I64) -> Bool {
    loop sync_load(wrapping(control + (I64{8}))) != (I64{0}) && sync_load(wrapping(control + (I64{16}))) == (I64{0}) {
        timeout := I64{-1}
        if !scheduler_shielded() && jet_ctx_deadline_present() {
            remaining: jet_deadline_remaining_ms()
            if (remaining <= I64{0}) {
                kind: scheduler_msg_pause()
                scheduler_deliver_deadline(kind)
                jet_rt_string_drop(kind)
                return false
            }
            timeout = deadline_ms_to_ns(remaining)
        }
        sync_park(sync_load(wrapping(control + I64{64})), timeout)
    }
    true
}

scheduler_wait_while_paused: fn() -> I64 {
    control: scheduler_control_current()
    if (control == I64{0}) { return I64{0} }
    if !scheduler_park_while_paused(control) -> return jet_scheduler_native_status()
    jet_scheduler_native_propagate()
}

// The strong pause's park (jet_rt_scheduler_pause_park), installed by the
// first `pause(mode: .CheckLoops)` (scheduler_control_pause). The stop polls
// call through it (scheduler_check_loops), so a program that never asks for a
// strong pause links no park at its polls, and so no deadline or clock read:
// a stop or a drop's poll never starts the host clock (HostTime.jet).
scheduler_pause_park_rail_code := I64{0}

rt_scheduler_pause_park_address: fn() -> I64 {
    loop { jet_rt_unreachable(I64{0}, I64{0}) }
}

// The rail's entry: 1 while scheduler_park_while_paused answers true.
#Export(c) jet_rt_scheduler_pause_park: fn(control: I64) -> I64 {
    if scheduler_park_while_paused(control) -> I64{1} else -> I64{0}
}

// A control's attention (scheduler_attention_set) is taken at every stop
// poll: the check each loop iteration starts with and the poll after a call
// (JetIR Build.jet ir_loop_check, ir_stop_check), outside a shield only. A
// strong pause (`pause(mode: .CheckLoops)`) parks the task while it stays
// paused. A cancel is delivered there, so a busy loop stops at its next turn
// and unwinds with its Drop cleanup; the bit is taken once (the cancel flag
// itself stays for the wait points), and a root, which unwinds no cancel,
// only drops it. The cancel flag is stored before the bit is raised, so a
// poll that clears a raised bit sees the flag.
scheduler_check_loops: fn(control: I64) {
    attention: sync_load(wrapping(control + I64{24}))
    if (attention == I64{0}) || scheduler_shielded() {
        return
    }
    if (attention & SCHEDULER_ATTEND_PAUSE != I64{0}) {
        // The bit is raised only after a strong pause installed the park.
        park: scheduler_pause_park_rail_code
        if (park != I64{0} && coll_call1(park, control) == I64{0}) {
            return
        }
    }
    if (sync_load(wrapping(control + I64{24})) & SCHEDULER_ATTEND_CANCEL != I64{0}) {
        scheduler_attention_set(control, SCHEDULER_ATTEND_CANCEL, false)
        if (sync_load(wrapping(control + I64{16})) != I64{0}) { scheduler_deliver_cancel() }
    }
}

// A control's deadline bit is up once its watch saw the deadline in force
// pass (scheduler_deadline_watch). Each turn poll of compiled code
// (jet_rt_session_turn, at a loop's turn or a recursive body's entry) and
// jet_scheduler_native_poll then read the clock while no stop is published,
// and deliver E3003 once it has passed. A watch that ended early (the wall
// clock moved back) clears the bit and watches again.
// The stop poll after a call (jet_rt_session_propagate) and the runtime's
// own stop checks (jet_scheduler_native_propagate) leave it to the wait
// points: a wait that returned its typed timeout keeps it, a typed join
// waits past its joiner's deadline, an async entry turns its passed
// deadline into its report, and a task body that has returned keeps its
// value.
scheduler_check_loop_deadline: fn(control: I64) {
    attention: sync_load(wrapping(control + I64{24}))
    if (attention & SCHEDULER_ATTEND_DEADLINE == I64{0}) || scheduler_shielded() || (scheduler_control_status(control) != I64{0}) {
        return
    }
    if !jet_ctx_deadline_present() {
        scheduler_attention_set(control, SCHEDULER_ATTEND_DEADLINE, false)
        return
    }
    deadline: jet_ctx_deadline_ms()
    if (deadline_remaining_ns(deadline) == I64{0}) {
        scheduler_deliver_deadline(rt_static_text("a loop"))
        return
    }
    scheduler_attention_set(control, SCHEDULER_ATTEND_DEADLINE, false)
    scheduler_deadline_watch(control, deadline)
}

scheduler_wait_point_cancel_check: fn() -> I64 {
    _ := scheduler_wait_while_paused()
    if scheduler_task_canceled() && !scheduler_shielded() -> scheduler_deliver_cancel()
    jet_scheduler_native_propagate()
}

scheduler_observe_update: fn(state: I64, wait: I64) {
    jet_rt_observe_task_wait(state, wait, if jet_ctx_deadline_present() -> I64{1} else -> I64{0}, jet_deadline_remaining_ms())
}

// True while the current thread's waits run on a World's virtual clock
// (World.jet), whose parks observe no ambient deadline.
scheduler_virtual_wait: fn() -> Bool {
    (sync_load(wrapping(thread_base() + I64{112})) & I64{2}) != I64{0}
}

// Including its per-site interrupt order.
scheduler_yield: fn(wait_kind: I64, slot: I64, timeout_ns: I64) -> I64 {
    scheduler_yield_policy(wait_kind, slot, timeout_ns, true, I64{0})
}

// scheduler_yield whose park observes the ambient deadline only when
// `deadline` holds: a join observes its joiner's deadline itself, so a
// finished child wins over a late wake (Task.jet task_join_wait). Under
// `jet perf run` a task's park that is not a yield records its wait
// (PerfSamples.jet perf_samples_wait), naming `object` (perf_samples_object;
// 0 for none).
scheduler_yield_policy: fn(wait_kind: I64, slot: I64, timeout_ns: I64, deadline: Bool, object: I64) -> I64 {
    // A canceled root wait point returns its fallback without parking.
    if scheduler_root_cancel_observed() -> return I64{0}
    world: world_current()
    if (world != I64{0} && scheduler_control_current() != I64{0}) { world_begin_wait(world, slot) }
    control: scheduler_control_current()
    shielded: scheduler_shielded()
    if (control != I64{0}) { scheduler_observe_update(I64{2}, wait_kind) }
    if (control != I64{0}) {
        if !shielded && scheduler_task_canceled() {
            scheduler_deliver_cancel()
            return jet_scheduler_native_status()
        }
        _ := scheduler_wait_while_paused()
        if !shielded && scheduler_task_canceled() {
            scheduler_deliver_cancel()
            return jet_scheduler_native_status()
        }
        if (jet_scheduler_native_propagate() != I64{0}) { return jet_scheduler_native_status() }
    }
    waiter: if !shielded -> scheduler_cancel_waiter_register(control, slot) else -> I64{0}
    wait := timeout_ns
    virtual_wait: scheduler_virtual_wait()
    if virtual_wait {
        if (wait != I64{0}) { wait = I64{-1} }
    }
    if deadline && !virtual_wait && !shielded && jet_ctx_deadline_present() {
        remaining: jet_deadline_remaining_ms()
        if (remaining <= I64{0}) {
            scheduler_cancel_waiter_remove(control, waiter)
            scheduler_deliver_deadline(wait_kind)
            return jet_scheduler_native_status()
        }
        cap: deadline_ms_to_ns(remaining)
        if (wait < I64{0} || wait > cap) { wait = cap }
    }
    sync_store(wrapping(thread_base() + I64{72}), slot)
    // An unbounded wait that noted what it waits on may close a wait cycle.
    armed: wait < I64{0} && !shielded && !virtual_wait && wait_cycle_arm(control, slot)
    recorded: control != I64{0} && timeout_ns != I64{0} && perf_samples_fd >= I64{0}
    began: if recorded -> time_host_monotonic_i64() else -> I64{0}
    sync_park(slot, wait)
    if recorded -> perf_samples_wait(slot, wait_kind, object, began)
    sync_store(wrapping(thread_base() + I64{72}), I64{0})
    scheduler_cancel_waiter_remove(control, waiter)
    if armed {
        wait_cycle_disarm(control)
        if wait_cycle_delivered(control) {
            wait_cycle_stop(control)
            return jet_scheduler_native_status()
        }
    }
    if (deadline && !virtual_wait && !shielded && jet_ctx_deadline_present() && jet_deadline_remaining_ms() <= I64{0}) {
        scheduler_deliver_deadline(wait_kind)
        return jet_scheduler_native_status()
    }
    if !shielded && scheduler_task_canceled() {
        scheduler_deliver_cancel()
        return jet_scheduler_native_status()
    }
    _ := scheduler_wait_while_paused()
    if (world != I64{0}) { world_finish_park(world, slot) }
    if (control != I64{0}) { scheduler_observe_update(I64{1}, I64{0}) }
    jet_scheduler_native_propagate()
}

// Scheduler288: lock0 FIFOhead8/tail16 idleHead24 watch32 live40 parked48
// fibers56 pooled64 pool72 completionLo80/Hi88 nextTask96 timerRoot104
// poolSize112 idle120 carriers128 fiberTimers136 stop144 started152
// woken160 readyHead168 readyTail176 stackBytes184 gsMode192 fiberSpace200
// blocked208 monitorArmed216 monitor224 sizedPools232 liveLock240
// liveTasks248 queued256 waitLock264 spare272 settled280.
// waitLock is the mutex under which tasks arm and disarm waits and deliver
// deadlocks (WaitCycle.jet).
// liveTasks heads the list of every task state not yet freed, under its own
// mutex liveLock (Task.jet task_live_link), not the thread lock.
// lock is a thread lock (Sync.jet sync_thread_lock): a fiber's wake takes it.
// The run queue holds submitted task states; queued counts them. It is the
// two hooks jet_rt_scheduler_queue_push and jet_rt_scheduler_queue_pop, whose
// definitions here are the FIFO (linked through the tasks' reserved word
// @88). A program a target profile gives a scheduler provider defines both,
// and its link binds the runtime's calls to them (scheduler_queue_push).
// ready holds fibers to resume (Fiber.jet). live counts tasks taken and
// not finished, parked their parked fibers, fibers the fiber stacks mapped,
// pooled (pool, linked through Fiber next@48, and the sizedPools lists of
// larger stacks, Fiber.jet fiber_sized_pool) the idle ones and fiberSpace
// the bytes the fiber stacks may still map (Fiber.jet fiber_space_take).
// settled counts the live jobs that have run to their end: a task that
// published its outcome (Task.jet task_run), so its join may have returned,
// or a parallel worker that counted itself off its walk. The job adds itself
// atomically, without the lock; the carrier takes it off settled and live
// together, under the lock, once it is back on its own stack, so settled
// never exceeds live under the lock.
// carriers is a word list (scheduler_words) of Carrier96 records {argument0
// handle8 save16 tcb24 tid32 runs40 seenRuns48 seenCpu56 fiber64 index72
// wake80 next88}, changed only under the lock; fiber64 is the fiber the
// carrier runs, 0 between fibers (Fiber.jet fiber_run), and index72 the
// carrier's `context.thread` (scheduler_carrier_free_index). Every carrier on
// it stays joinable so jet_rt_scheduler_shutdown can join it. The poolSize
// carriers start one at a time, on demand: a submit starts one only when no
// idle carrier is left to wake (idle - woken), so a process that submits a
// few tasks starts a few threads, not the whole pool. An idle carrier sleeps
// on its own futex word, wake80, 0 until a wake claims it and stores 1
// (scheduler_carrier_idle), so a wake reaches exactly the carrier it claimed:
// on one shared word the kernel would pick the sleeper. idleHead heads the
// list of unclaimed idle carriers, linked through next88; a wake claims the
// head, the last carrier to go idle, whose cache is warmest. idle counts the
// carriers in scheduler_carrier_idle; woken counts those claimed that have
// not woken yet, so idle - woken is the list's length. Work claims one
// carrier at a time (scheduler_wake_work): the kernel wakes a thread onto a
// CPU that looks idle, and the one it chose for an earlier wake looks idle
// until that thread runs, so a burst of wakes would queue carriers behind
// each other on one CPU while others idle. The claimed carrier, once it
// runs, claims the next while work still waits (jet_rt_scheduler_worker).
// A carrier spins a while before it sleeps (scheduler_idle_spin), so a
// claim that soon after reaches a carrier still on its CPU, and the claims
// pass from carrier to carrier with no kernel wake between them.
// started counts the carriers started. spare heads the records of retired
// carriers, linked through next88: a wake sent after the claim's unlock may
// reach a record whose carrier retired meanwhile, so a record is reused by
// the next start and freed only by the shutdown, which joins every thread
// that can wake one. A spare record keeps its retired carrier's handle@8
// until then: the next start joins that thread before it reuses the record,
// and the shutdown joins it before it frees the record, so no carrier
// outlives a quiesce. watch is the deadline the one idle carrier watching
// the fiber timers sleeps to (0: none watches).
//
// A carrier blocked in the kernel (a foreign call, a raw read of a FIFO or
// pipe, any system call that waits) holds its OS thread: no fiber park frees
// it. The monitor thread (jet_rt_scheduler_monitor) hands its work to another
// carrier, as Go's sysmon retakes a P from a thread in a system call. While
// work waits with no idle carrier, every SCHEDULER_MONITOR_TICK_NS it counts
// the carriers still on the job it saw them on (runs, odd while a job runs)
// whose threads used under half a tick of CPU since and are blocked in the
// kernel outside the runtime now (scheduler_thread_blocked: asleep, and in no
// futex wait); blocked is that count,
// and up to poolSize + blocked carriers may run. A carrier that finds no work
// while more than poolSize + blocked run retires, unless it would leave the
// fiber timers unwatched. The call path is
// unchanged, so a short foreign call costs what it did. The fiber a carrier
// is still running a tick later has its turn asked for (SCHEDULER_TCB_TURN),
// and gives the carrier to the waiting work at its next stop check, so a
// runnable task waits at most about two ticks for a busy one. monitorArmed is 1
// while the monitor watches and 0 while it sleeps until a submit or a wake
// finds no idle carrier; monitor is its thread handle (0: not started, -1:
// starting, -2: its start was refused, and the pool goes on without it).
scheduler_root := I64{0}

SCHEDULER_ROOT_BYTES: I64{288}

SCHEDULER_CONTROL_BYTES: I64{232}

SCHEDULER_CARRIER_BYTES: I64{96}

// The Carrier96 word holding the carrier's thread index.
SCHEDULER_CARRIER_INDEX: I64{72}

// The Carrier96 futex word an idle carrier sleeps on: 0 while it is
// unclaimed, 1 once a wake claimed it (scheduler_wake_idle).
SCHEDULER_CARRIER_WAKE: I64{80}

// The Carrier96 link of the idle list (idleHead24) and the spare records
// (spare272).
SCHEDULER_CARRIER_NEXT: I64{88}

SCHEDULER_MONITOR_TICK_NS: I64{10000000}

SCHEDULER_STAT_BYTES: I64{512}

// runtime-init: 3 when scheduler_root
#Export(c) jet_rt_scheduler_init: fn() {
    if (scheduler_root != I64{0}) {
        return
    }
    root: jet_rt_alloc(SCHEDULER_ROOT_BYTES, I64{8})
    #Unsafe("runtime-init runs before any other thread exists") { scheduler_root = root }
    thread_zero(scheduler_root, SCHEDULER_ROOT_BYTES)
}

// The initialized root without starting the pool. Only scheduler_submit (via
// scheduler_get) starts workers, so a program that never submits a job (hello,
// a plain sleep) never creates a pool thread; draining, timers and statistics
// observe the same run queue, live count and counters either way.
scheduler_root_required: fn() -> I64 {
    root: scheduler_root
    if (root == I64{0}) { jet_rt_unreachable(I64{0}, I64{0}) }
    root
}

rt_scheduler_worker_address: fn() -> I64 {
    loop { jet_rt_unreachable(I64{0}, I64{0}) }
}

rt_scheduler_timer_address: fn() -> I64 {
    loop { jet_rt_unreachable(I64{0}, I64{0}) }
}

rt_scheduler_monitor_address: fn() -> I64 {
    loop { jet_rt_unreachable(I64{0}, I64{0}) }
}

// usize.from_str accepts '+' and the full u64 range. Counts above i64.MAX
// are returned as their bit pattern, not treated as an invalid override.
scheduler_parse_threads: fn(text: I64, out: I64) -> Bool {
    if (text == I64{0}) { return false }
    length: sync_load(wrapping(text + I64{8}))
    if (length == I64{0}) { return false }
    data: sync_load(text)
    at := I64{0}
    if (trap_byte(data) == I64{43}) { at = I64{1} }
    if at == length -> return false
    number := I64{0}
    loop at < length {
        byte: trap_byte(wrapping(data + at))
        if (byte < I64{48} || byte > I64{57}) { return false }
        digit: byte - I64{48}
        // (u64.MAX / 10) fits signed; any larger accumulator overflows next.
        if (number < I64{0} || number > I64{1844674407370955161}) { return false }
        if (number == I64{1844674407370955161} && digit > I64{5}) { return false }
        number = wrapping(wrapping(number * I64{10}) + digit)
        at += I64{1}
    }
    sync_store(out, if (number == I64{0}) -> I64{1} else -> number)
    true
}

scheduler_worker_count: fn() -> I64 {
    key: scheduler_msg_threads()
    value: rt_env_get(key)
    jet_rt_string_drop(key)
    out: wrapping(thread_base() + I64{248})
    parsed: scheduler_parse_threads(value, out)
    jet_rt_string_drop(value)
    if parsed -> return sync_load(out)
    if comptime_serving() -> I64{4} else -> scheduler_available_parallelism(I64{4})
}

// The pool's environment override stays in worker_count. Pool (fallback 4),
// joined parallel walks (fallback 1) and cpu_count (None) all read std's one
// available_parallelism (HostParallelism.jet).
scheduler_available_parallelism: fn(fallback: I64) -> I64 {
    count: cpu_available_parallelism(I64{0}, I64{0})
    if (jet_rt_session_propagate() != I64{0}) { return I64{0} }
    if (count > I64{0}) { return count }
    fallback
}

// The root's lazily created carrier list (128). Callers hold the root lock.
scheduler_carrier_list: fn(root: I64) -> I64 {
    list := sync_load(wrapping(root + I64{128}))
    if (list == I64{0}) {
        list = jet_rt_alloc(I64{24}, I64{8})
        thread_zero(list, I64{24})
        sync_store(wrapping(root + I64{128}), list)
    }
    list
}

// Joins every carrier of a list taken out from under the root lock, each
// until it has left the process (thread_join_gone), then frees the records
// and the list: every carrier is joined before any record is freed, since a
// carrier's wake reaches another's record after its unlock
// (scheduler_kick_idle). Returns the number of joined threads.
scheduler_carrier_list_join: fn(list: I64) -> I64 {
    if (list == I64{0}) { return I64{0} }
    length: sync_load(list)
    data: sync_load(wrapping(list + I64{16}))
    at := I64{0}
    loop at < length {
        _ := thread_join_gone(sync_load(wrapping(sync_load(wrapping(data + at * I64{8})) + I64{8})))
        at += I64{1}
    }
    at = I64{0}
    loop at < length {
        jet_rt_free(sync_load(wrapping(data + at * I64{8})), SCHEDULER_CARRIER_BYTES, I64{8})
        at += I64{1}
    }
    scheduler_words_drop(list)
    length
}

// Keeps a record no carrier runs on for the next start (spare272); the root
// lock is held.
scheduler_carrier_spare: fn(root: I64, record: I64) {
    sync_store(wrapping(record + SCHEDULER_CARRIER_NEXT), sync_load(wrapping(root + I64{272})))
    sync_store(wrapping(root + I64{272}), record)
}

// The lowest thread index no listed carrier holds, from 1: the carriers
// number 1 up, densely, in the order they start, whatever other threads the
// runtime starts meanwhile, and a carrier that starts after one retired
// takes the index it left. Callers hold the root lock.
scheduler_carrier_free_index: fn(list: I64) -> I64 {
    length: sync_load(list)
    data: sync_load(wrapping(list + I64{16}))
    index := I64{1}
    at := I64{0}
    loop at < length {
        if (sync_load(wrapping(sync_load(wrapping(data + at * I64{8})) + SCHEDULER_CARRIER_INDEX)) == index) {
            index += I64{1}
            at = I64{0}
        } else { at += I64{1} }
    }
    index
}

// The spawn and the handle's publication share one critical section, so a
// carrier (which locks the root before it reads its handle) and shutdown
// both see a complete record, and two starts never take one index. The
// record is a retired carrier's when one is spare; that carrier's thread,
// which returned at its retirement, is joined first.
scheduler_start_worker: fn(root: I64) {
    sync_thread_lock(root)
    record := sync_load(wrapping(root + I64{272}))
    if (record != I64{0}) {
        sync_store(wrapping(root + I64{272}), sync_load(wrapping(record + SCHEDULER_CARRIER_NEXT)))
    }
    sync_thread_unlock(root)
    if (record == I64{0}) { record = jet_rt_alloc(SCHEDULER_CARRIER_BYTES, I64{8}) } else {
        retired: sync_load(wrapping(record + I64{8}))
        if (retired != I64{0}) { _ := thread_join(retired, I64{0}) }
    }
    thread_zero(record, SCHEDULER_CARRIER_BYTES)
    sync_store(record, root)
    sync_thread_lock(root)
    sync_store(wrapping(record + SCHEDULER_CARRIER_INDEX), scheduler_carrier_free_index(scheduler_carrier_list(root)))
    handle: thread_spawn(rt_scheduler_worker_address(), record)
    if (handle < I64{0}) {
        // The carrier scheduler_submit or the monitor counted for this start
        // never runs. With others running the pool settles at them: the queued
        // job waits for one, and no later submit retries the start. A refused
        // start past the pool size (one the monitor made for a blocked
        // carrier) leaves the pool size alone.
        started: wrapping(sync_load(wrapping(root + I64{152})) - I64{1})
        sync_store(wrapping(root + I64{152}), started)
        pool: sync_load(wrapping(root + I64{112}))
        if (started > I64{0} && (pool < I64{0} || started < pool)) {
            _ := sync_swap(wrapping(root + I64{112}), started)
        }
        scheduler_carrier_spare(root, record)
        sync_thread_unlock(root)
        if (started == I64{0}) { scheduler_first_worker_refused(-handle) }
        return
    }
    sync_store(wrapping(record + I64{8}), handle)
    scheduler_words_push(scheduler_carrier_list(root), record)
    sync_thread_unlock(root)
}

// Settles the pool size on first use; workers start on demand
// (scheduler_submit).
scheduler_get: fn() -> I64 {
    root: scheduler_root
    // .init_array owns the root; first use owns only pool initialization.
    if (root == I64{0}) { jet_rt_unreachable(I64{0}, I64{0}) }
    if {
        (sync_cas(wrapping(root + I64{112}), I64{0}, I64{-1}) == I64{0}) -> {
            count: scheduler_worker_count()
            jet_rt_observe_pool(count, I64{0})
            _ := sync_swap(wrapping(root + I64{112}), count)
            sync_wake(root + I64{112}, I64{2147483647})
        }
        else -> {
            loop sync_load(wrapping(root + (I64{112}))) == (I64{-1}) {
                _ := sync_wait(root + I64{112}, I64{-1}, I64{-1})
            }
        }
    }
    root
}

// Queues a job (scheduler_run_job) for a carrier (scheduler_work_taker).
// Unsigned pool sizes above i64.MAX are attempted just as Rust does, failing
// at thread_spawn.
scheduler_submit: fn(task: I64) {
    root: scheduler_get()
    sync_store(wrapping(task + I64{88}), I64{0})
    sync_thread_lock(root)
    jet_rt_scheduler_queue_push(task)
    sync_store(wrapping(root + I64{256}), wrapping(sync_load(wrapping(root + I64{256})) + I64{1}))
    jet_rt_observe_pool(I64{-1}, I64{1})
    taker: scheduler_work_taker(root)
    sync_thread_unlock(root)
    scheduler_take(root, taker)
}

// Who takes a queued job, with the root lock held: an idle carrier, claimed
// (its record, which scheduler_kick_idle wakes), unless a claimed one is on
// its way (0: it passes the work on, scheduler_wake_work); else one more
// carrier while there is room (scheduler_carrier_room, -2); else the
// monitor, which watches for blocked carriers (scheduler_monitor_arm: 1 or
// 2, and 0 when it already watches).
scheduler_work_taker: fn(root: I64) -> I64 {
    woke: scheduler_wake_work(root)
    if (woke > I64{0}) { return woke }
    if (woke < I64{0}) { return I64{0} }
    if !scheduler_carrier_room(root) -> return scheduler_monitor_arm(root)
    sync_store(wrapping(root + I64{152}), wrapping(sync_load(wrapping(root + I64{152})) + I64{1}))
    I64{-2}
}

// The half of scheduler_work_taker or Fiber.jet fiber_ready_taker that runs
// after the root unlock. A start settles the pool size first, as a submit's
// does (scheduler_get): a fiber's first carrier can start before any submit.
scheduler_take: fn(root: I64, taker: I64) {
    if {
        (taker == I64{-2}) -> scheduler_start_worker(scheduler_get())
        (taker == I64{1} || taker == I64{2}) -> scheduler_monitor_kick(root, taker)
        (taker != I64{0}) -> scheduler_kick_idle(taker)
    }
}

// Whether one more carrier may start: fewer than the pool size run, or, while
// the monitor counts blocked carriers, fewer than the pool size plus them.
// Carriers the monitor started past the pool give no room once their blocked
// ones wake. The root lock is held.
scheduler_carrier_room: fn(root: I64) -> Bool {
    started: sync_load(wrapping(root + I64{152}))
    pool: sync_load(wrapping(root + I64{112}))
    if (pool < I64{0}) { return started != pool }
    started < wrapping(pool + sync_load(wrapping(root + I64{208})))
}

// Whether more carriers run than the pool size plus the blocked ones, so an
// idle one retires; never while the fiber timers wait with no carrier
// watching them, since the retiring carrier would leave them unwatched
// (scheduler_carrier_idle). The root lock is held.
scheduler_carrier_excess: fn(root: I64) -> Bool {
    pool: sync_load(wrapping(root + I64{112}))
    if (pool <= I64{0}) { return false }
    timers: sync_load(wrapping(root + I64{136}))
    if (timers != I64{0} && sync_load(wrapping(root + I64{32})) == I64{0} && sync_load(wrapping(timers + I64{16})) >= I64{0}) {
        return false
    }
    sync_load(wrapping(root + I64{152})) > wrapping(pool + sync_load(wrapping(root + I64{208})))
}

// Whether a join on this thread would wait on a queued child no carrier is
// left to start: the joiner runs on a carrier's own stack (its TCB is the
// carrier's, not a fiber's, whose park would free the carrier), so its wait
// blocks that carrier; no idle carrier is left to wake; and no carrier may
// start (scheduler_carrier_room). A join on the process's main thread or on
// a fiber never starves: the carriers it leaves free start the child.
scheduler_join_starves: fn() -> Bool {
    root: scheduler_root_required()
    base: thread_base()
    sync_thread_lock(root)
    starves := false
    list: sync_load(wrapping(root + I64{128}))
    if (list != I64{0} && sync_load(wrapping(root + I64{120})) <= sync_load(wrapping(root + I64{160})) && !scheduler_carrier_room(root)) {
        length: sync_load(list)
        data: sync_load(wrapping(list + I64{16}))
        at := I64{0}
        loop at < length {
            if (sync_load(wrapping(sync_load(wrapping(data + at * I64{8})) + I64{24})) == base) {
                starves = true
                break
            }
            at += I64{1}
        }
    }
    sync_thread_unlock(root)
    starves
}

// Arms the monitor for a submit or a wake that found neither an idle carrier
// nor room for one: 0 when it already watches or cannot start, 1 to wake it,
// 2 to start it (scheduler_monitor_kick, after the unlock). The root lock is
// held.
scheduler_monitor_arm: fn(root: I64) -> I64 {
    monitor: sync_load(wrapping(root + I64{224}))
    if (monitor < I64{0} || sync_load(wrapping(root + I64{216})) != I64{0}) { return I64{0} }
    sync_store(wrapping(root + I64{216}), I64{1})
    if (monitor != I64{0}) { return I64{1} }
    sync_store(wrapping(root + I64{224}), I64{-1})
    I64{2}
}

scheduler_monitor_kick: fn(root: I64, how: I64) {
    if (how == I64{1}) {
        sync_futex_wake(wrapping(root + I64{216}), I64{1})
        return
    }
    handle: thread_spawn(rt_scheduler_monitor_address(), root)
    sync_thread_lock(root)
    if (handle < I64{0}) {
        // Refused: the pool goes on as it would without the monitor.
        sync_store(wrapping(root + I64{224}), I64{-2})
        sync_store(wrapping(root + I64{216}), I64{0})
    } else { sync_store(wrapping(root + I64{224}), handle) }
    sync_thread_unlock(root)
}

// Whether the monitor has carriers to watch: work waits with no idle carrier
// unclaimed, or carriers past the pool size run. The root lock is held.
scheduler_monitor_needed: fn(root: I64) -> Bool {
    pool: sync_load(wrapping(root + I64{112}))
    if (pool <= I64{0}) { return false }
    if (sync_load(wrapping(root + I64{152})) > pool) { return true }
    scheduler_work_waits(root)
}

// Whether a queued job or a ready fiber waits with no idle carrier
// unclaimed to take it. The root lock is held.
scheduler_work_waits: fn(root: I64) -> Bool {
    queued: sync_load(wrapping(root + I64{256})) != I64{0} || sync_load(wrapping(root + I64{168})) != I64{0}
    queued && sync_load(wrapping(root + I64{120})) <= sync_load(wrapping(root + I64{160}))
}

// Another thread's CPU time in ns: its CLOCK_THREAD_CPUTIME_ID, the clock
// (~tid << 3) | 6 that pthread_getcpuclockid names, or -1 once it is gone.
// Not sync_clock_read, which stops on a failed read.
scheduler_thread_cpu_ns: fn(tid: I64) -> I64 {
    clock: (wrapping(I64{-1} - tid) << I64{3}) | I64{6}
    scratch := I64{0}
    #Unsafe("clock_gettime writes two words of thread-owned TCB scratch; no pointer escapes") {
        scratch = wrapping(os_tls_base_i64() + I64{232})
        if (host_syscall(I64{228}, clock, scratch, I64{0}, I64{0}, I64{0}, I64{0}) != I64{0}) {
            return I64{-1}
        }
    }
    wrapping(rt_text_word(scratch) * I64{1000000000} + rt_text_word(wrapping(scratch + I64{8})))
}

// Reads /proc/self/task/<tid>/<name> (`name` a static text) into `buffer`,
// the monitor's SCHEDULER_STAT_BYTES of scratch: the bytes read, or a
// negative count when the file cannot be opened or read.
scheduler_task_file: fn(tid: I64, name: I64, buffer: I64) -> I64 {
    scheduler_task_path(tid, name, buffer)
    scheduler_read_path(buffer)
}

// Writes the NUL-ended path /proc/self/task/<tid>/<name> into `buffer`.
scheduler_task_path: fn(tid: I64, name: I64, buffer: I64) {
    prefix: rt_static_text("/proc/self/task/")
    at := rt_text_len(prefix)
    rt_text_bytes_copy(buffer, rt_text_data(prefix), at)
    at = wrapping(at + scheduler_put_number(wrapping(buffer + at), tid))
    rt_text_put(wrapping(buffer + at), I64{47})
    at = wrapping(at + I64{1})
    rt_text_bytes_copy(wrapping(buffer + at), rt_text_data(name), rt_text_len(name))
    rt_text_put(wrapping(buffer + at + rt_text_len(name)), I64{0})
}

// Writes `value`, at least 0, in decimal at `at`: the digits written.
scheduler_put_number: fn(at: I64, value: I64) -> I64 {
    digits := I64{1}
    scale := I64{10}
    loop value >= scale {
        digits += I64{1}
        scale *= I64{10}
    }
    rest := value
    place := digits
    loop place > (I64{0}) {
        place -= I64{1}
        rt_text_put(wrapping(at + place), I64{48} + rest % I64{10})
        rest = rest /% I64{10}
    }
    digits
}

// Reads the file whose NUL-ended path `buffer` holds into `buffer`, at most
// SCHEDULER_STAT_BYTES: the bytes read, or a negative count when the file
// cannot be opened or read.
scheduler_read_path: fn(buffer: I64) -> I64 {
    got := I64{-1}
    #Unsafe("openat, read and close the path and fill only the caller's own scratch; the descriptor is closed before return") {
        // openat(AT_FDCWD, path, O_RDONLY | O_CLOEXEC).
        descriptor: host_syscall(I64{257}, I64{-100}, buffer, I64{524288}, I64{0}, I64{0}, I64{0})
        if (descriptor < I64{0}) { return descriptor }
        got = host_syscall(I64{0}, descriptor, buffer, SCHEDULER_STAT_BYTES, I64{0}, I64{0}, I64{0})
        _ := host_syscall(I64{3}, descriptor, I64{0}, I64{0}, I64{0}, I64{0}, I64{0})
    }
    got
}

// Whether thread `tid` of this process is blocked in the kernel outside the
// runtime: the state in its /proc/self/task/<tid>/stat is S (an
// interruptible sleep), and its wchan names a wait that is no futex wait. A
// preempted thread is R, so a busy carrier on a crowded CPU is not taken for
// a blocked one. Waits on the address-space lock (many carriers mapping or
// unmapping fiber stacks at once) are D, and the runtime's own waits (a
// contended lock whose holder is preempted, a job run on its carrier for
// want of a fiber stack) are futex waits: new carriers would free neither.
// So a foreign call waiting on a pthread lock or in a D-state disk read is
// not handed off. A wchan of "0" (the thread runs again, or the kernel hides
// it), or one that cannot be read, a gone or an unreadable thread is not
// blocked. `buffer` is the monitor's SCHEDULER_STAT_BYTES of scratch.
scheduler_thread_blocked: fn(tid: I64, buffer: I64) -> Bool {
    got: scheduler_task_file(tid, rt_static_text("stat"), buffer)
    // The state follows the name's last `)` and a space: the name may hold
    // any byte, the fields after it only numbers.
    paren := wrapping(got - I64{1})
    loop paren >= (I64{0}) && rt_text_byte(wrapping(buffer + paren)) != (I64{41}) -> paren -= I64{1}
    if (paren < I64{0} || wrapping(paren + I64{2}) >= got) { return false }
    if (rt_text_byte(wrapping(buffer + paren + I64{2})) != I64{83}) { return false }
    wchan: scheduler_task_file(tid, rt_static_text("wchan"), buffer)
    if (wchan <= I64{0} || (wchan == I64{1} && rt_text_byte(buffer) == I64{48})) { return false }
    // The futex waits are named __futex_wait, futex_wait_queue and the like:
    // "futex" anywhere in the name.
    futex: rt_static_text("futex")
    length: rt_text_len(futex)
    start := I64{0}
    loop wrapping(start + length) <= wchan {
        at := I64{0}
        loop at < length && rt_text_byte(wrapping(buffer + start + at)) == rt_text_byte(wrapping(rt_text_data(futex) + at)) {
            at += I64{1}
        }
        if (at == length) { return false }
        start += I64{1}
    }
    true
}

// Counts the blocked carriers: on the job they ran at the last look (runs
// odd and unchanged), their threads under half a tick of CPU since and
// blocked in the kernel now (scheduler_thread_blocked). With `turns` (work
// waits for a carrier: scheduler_work_waits) every carrier still running
// the fiber it ran at the last look gets that fiber's turn asked for
// (SCHEDULER_TCB_TURN): a busy fiber gives its carrier up at its next check,
// and one blocked or waiting gives it up harmlessly when it next checks.
// Each record keeps this look's runs and CPU time for the next. The root
// lock is held, so a fiber the record names stays mapped: its carrier
// clears fiber64 before it takes the lock to unmap it (Fiber.jet fiber_run).
scheduler_monitor_scan: fn(root: I64, buffer: I64, turns: Bool) -> I64 {
    list: sync_load(wrapping(root + I64{128}))
    if (list == I64{0}) { return I64{0} }
    length: sync_load(list)
    data: sync_load(wrapping(list + I64{16}))
    blocked := I64{0}
    at := I64{0}
    loop at < length {
        record: sync_load(wrapping(data + at * I64{8}))
        runs: sync_load(wrapping(record + I64{40}))
        tid: sync_load(wrapping(record + I64{32}))
        cpu := I64{-1}
        if (runs & I64{1} == I64{1} && tid > I64{0}) {
            cpu = scheduler_thread_cpu_ns(tid)
            seen: sync_load(wrapping(record + I64{56}))
            same: runs == sync_load(wrapping(record + I64{48}))
            if (same && cpu >= I64{0} && seen >= I64{0} && wrapping(cpu - seen) < SCHEDULER_MONITOR_TICK_NS / I64{2} && scheduler_thread_blocked(tid, buffer)) {
                blocked += I64{1}
            }
            fiber: sync_load(wrapping(record + I64{64}))
            if (turns && same && fiber != I64{0}) {
                scheduler_checks_arm_turns()
                sync_store(wrapping(sync_load(wrapping(fiber + I64{24})) + SCHEDULER_TCB_TURN), I64{1})
            }
        }
        sync_store(wrapping(record + I64{48}), runs)
        sync_store(wrapping(record + I64{56}), cpu)
        at += I64{1}
    }
    blocked
}

// How many carriers the monitor starts into the room the blocked ones leave:
// one per queued job or ready fiber no idle carrier is left to take, counted
// as started. The root lock is held.
scheduler_monitor_starts: fn(root: I64) -> I64 {
    pool: sync_load(wrapping(root + I64{112}))
    started: sync_load(wrapping(root + I64{152}))
    room: wrapping(pool + sync_load(wrapping(root + I64{208})) - started)
    if (pool <= I64{0} || room <= I64{0}) { return I64{0} }
    spare: sync_load(wrapping(root + I64{120})) - sync_load(wrapping(root + I64{160}))
    limit: room + (if (spare > I64{0}) -> spare else -> I64{0})
    tasks: sync_load(wrapping(root + I64{256}))
    queued := if (tasks < limit) -> tasks else -> limit
    fiber := sync_load(wrapping(root + I64{168}))
    loop fiber != (I64{0}) && queued < limit {
        queued += I64{1}
        fiber = sync_load(wrapping(fiber + I64{48}))
    }
    starts: queued - (if (spare > I64{0}) -> spare else -> I64{0})
    if (starts <= I64{0}) { return I64{0} }
    sync_store(wrapping(root + I64{152}), wrapping(started + starts))
    starts
}

// The monitor thread (Scheduler232). Asleep until armed; then each tick,
// while it has carriers to watch, it recounts the blocked ones, asks busy
// fibers for their turns while work waits (and settles the loops' armed word
// once none does), starts carriers into the room the blocked ones leave and
// wakes idle carriers past it, which retire. It leaves on shutdown's stop.
#Export(c) jet_rt_scheduler_monitor: fn(root: I64) -> I64 {
    armed: wrapping(root + I64{216})
    buffer: jet_rt_alloc(SCHEDULER_STAT_BYTES, I64{8})
    loop {
        sync_thread_lock(root)
        if (sync_load(wrapping(root + I64{144})) != I64{0}) {
            sync_thread_unlock(root)
            jet_rt_free(buffer, SCHEDULER_STAT_BYTES, I64{8})
            return I64{0}
        }
        if !scheduler_monitor_needed(root) {
            sync_store(wrapping(root + I64{208}), I64{0})
            scheduler_checks_settle(root)
            sync_store(armed, I64{0})
            sync_thread_unlock(root)
            _ := sync_futex_wait(armed, I64{0}, I64{-1})
            next
        }
        sync_store(armed, I64{1})
        waits: scheduler_work_waits(root)
        sync_store(wrapping(root + I64{208}), scheduler_monitor_scan(root, buffer, waits))
        if !waits -> scheduler_checks_settle(root)
        starts: scheduler_monitor_starts(root)
        // The wakes go out under the lock: they are few, and the monitor
        // has no room to keep the records claimed.
        if scheduler_carrier_excess(root) {
            excess: sync_load(wrapping(root + I64{152})) - sync_load(wrapping(root + I64{112})) - sync_load(wrapping(root + I64{208}))
            wakes := I64{0}
            loop wakes < excess {
                woke: scheduler_wake_idle(root)
                if (woke == I64{0}) { break }
                scheduler_kick_idle(woke)
                wakes += I64{1}
            }
        }
        sync_thread_unlock(root)
        at := I64{0}
        loop at < starts {
            scheduler_start_worker(root)
            at += I64{1}
        }
        _ := sync_futex_wait(armed, I64{1}, sync_deadline(SCHEDULER_MONITOR_TICK_NS))
    }
}

// Claims the idle carrier at the idle list's head and stores 1 in its wake
// word, so it cannot sleep through the claim; 0 when no unclaimed one is
// left, else its record. The root lock is held; the futex wake
// (scheduler_kick_idle) goes after the unlock, so the woken carrier does not
// wake into the held lock.
scheduler_wake_idle: fn(root: I64) -> I64 {
    record: sync_load(wrapping(root + I64{24}))
    if (record == I64{0}) { return I64{0} }
    scheduler_idle_remove(root, record, I64{0})
    sync_store(wrapping(record + SCHEDULER_CARRIER_WAKE), I64{1})
    sync_store(wrapping(root + I64{160}), sync_load(wrapping(root + I64{160})) + I64{1})
    record
}

// scheduler_wake_idle for queued work: one claim for each queued job
// (queued256) not yet covered by a claimed carrier still on its way
// (woken160), so a burst of submits (a spawn of k tasks) claims up to k
// idle carriers at once, each woken by its submit, rather than one wake
// at a time down a chain. Past that it returns -1: a claimed carrier is
// on its way, and it claims the next itself once it runs
// (jet_rt_scheduler_worker), as it does for a woken fiber, whose ready
// FIFO the queued count leaves out. The root lock is held.
scheduler_wake_work: fn(root: I64) -> I64 {
    woken: sync_load(wrapping(root + I64{160}))
    if (woken != I64{0} && woken >= sync_load(wrapping(root + I64{256}))) { return I64{-1} }
    scheduler_wake_idle(root)
}

// Takes `record` off the idle list, `before` the record ahead of it (0 at
// the head); the root lock is held.
scheduler_idle_remove: fn(root: I64, record: I64, before: I64) {
    next_record: sync_load(wrapping(record + SCHEDULER_CARRIER_NEXT))
    if (before == I64{0}) { sync_store(wrapping(root + I64{24}), next_record) } else {
        sync_store(wrapping(before + SCHEDULER_CARRIER_NEXT), next_record)
    }
}

// Wakes the carrier of `record`, which scheduler_wake_idle claimed. The
// record outlives the wake: a retired carrier's is spare until the shutdown.
scheduler_kick_idle: fn(record: I64) {
    sync_futex_wake(wrapping(record + SCHEDULER_CARRIER_WAKE), I64{1})
}

// A fiber timer now first in the heap: unless the watcher already sleeps to
// an earlier deadline, the watch is given up and one idle carrier wakes to
// take it over at the new earliest deadline (any claimed wake does too: the
// carrier it wakes finds no watcher). The old watcher keeps sleeping to its
// own deadline and, back, clears the watch only while it is still its own.
scheduler_watch_kick: fn(root: I64, deadline_ns: I64) {
    sync_thread_lock(root)
    watch: sync_load(wrapping(root + I64{32}))
    woke := I64{0}
    if (sync_load(wrapping(root + I64{120})) > I64{0} && (watch == I64{0} || watch > deadline_ns)) {
        sync_store(wrapping(root + I64{32}), I64{0})
        woke = scheduler_wake_idle(root)
    }
    sync_thread_unlock(root)
    if (woke != I64{0}) { scheduler_kick_idle(woke) }
}

// The run queue's next task, 0 when it holds none; the root lock is held.
scheduler_pop: fn(root: I64) -> I64 {
    queued: sync_load(wrapping(root + I64{256}))
    if (queued == I64{0}) { return I64{0} }
    task: jet_rt_scheduler_queue_pop()
    if (task == I64{0}) { return I64{0} }
    sync_store(wrapping(root + I64{256}), wrapping(queued - I64{1}))
    sync_store(wrapping(root + I64{40}), sync_load(wrapping(root + I64{40})) + I64{1})
    task
}

// The run queue's hooks, which hold the submitted task states the root's
// queued word counts; the root lock is held for each call. These are the
// runtime's FIFO (FIFOhead8/tail16, linked through each task's word @88).
// They are weak definitions that the runtime's own calls reach through their
// symbols (JetFoundation RUNTIME_PROVIDER_HOOKS), so a program that defines
// them, as one whose target profile names a scheduler provider does, replaces
// both at link time, and every call goes straight to its definitions.
#Export(c) jet_rt_scheduler_queue_push: fn(task: I64) {
    root: scheduler_root_required()
    tail: sync_load(wrapping(root + I64{16}))
    if (tail == I64{0}) { sync_store(wrapping(root + I64{8}), task) } else {
        sync_store(wrapping(tail + I64{88}), task)
    }
    sync_store(wrapping(root + I64{16}), task)
}

#Export(c) jet_rt_scheduler_queue_pop: fn() -> I64 {
    root: scheduler_root_required()
    task: sync_load(wrapping(root + I64{8}))
    if (task == I64{0}) { return I64{0} }
    next_task: sync_load(wrapping(task + I64{88}))
    sync_store(wrapping(root + I64{8}), next_task)
    if (next_task == I64{0}) { sync_store(wrapping(root + I64{16}), I64{0}) }
    task
}

// An idle carrier's wait on its wake word (Carrier96 wake80); the root lock is
// held on entry and on return. The carrier clears the word and goes on the
// idle list's head under the lock that found no work, so a wake that claims
// it later has stored 1 before the futex wait reads the word, which then
// returns at once: no claim is lost between the unlock and the sleep. Back
// with the word still 0 (its deadline passed, or a spurious wake), it takes
// itself off the list. With no carrier watching the fiber timers, it
// watches them: it sleeps only until the earliest deadline. It spins first
// (scheduler_idle_spin), `busy_since` the time it last left an idle wait or
// started.
scheduler_carrier_idle: fn(root: I64, record: I64, busy_since: I64) {
    deadline: scheduler_idle_enter(root, record)
    sync_thread_unlock(root)
    word: wrapping(record + SCHEDULER_CARRIER_WAKE)
    if !scheduler_idle_spin(word, busy_since, deadline) {
        _ := sync_futex_wait(word, I64{0}, deadline)
    }
    sync_thread_lock(root)
    scheduler_idle_leave(root, record, deadline)
}

// The longest an idle carrier spins before it sleeps, in nanoseconds.
SCHEDULER_IDLE_SPIN_NS: I64{1000000}

// An idle carrier's spin before its futex wait, watching its wake word:
// whether it ended the wait, claimed (the word 1) or at its deadline (-1:
// none). A sleeping carrier starts claimed work late: the kernel brings its
// CPU out of the idle state it chose, which on a quiet x86 host can take
// 350 us from its deepest state (entered past 700 us idle) before the clock
// ramps up again, may place the woken thread on a CPU a sibling carrier
// holds, and a carrier claims the next one only once it runs
// (scheduler_wake_work), so one late wake delays every task queued behind
// its claim. A spinning carrier keeps its CPU and sees the claim's store at
// once. The spin lasts as long as the carrier was busy before it, at most
// SCHEDULER_IDLE_SPIN_NS: a program's next work tends to come about as
// often as its last took, and a program that stops costs no more spinning
// than its last busy stretch, then sleeps, so its idle carriers use no CPU.
// A claim made past the spin wakes the sleeper as before; the shutdown
// claims every idle carrier (jet_rt_scheduler_shutdown), so it ends a spin
// as it ends a sleep.
scheduler_idle_spin: fn(word: I64, busy_since: I64, deadline: I64) -> Bool {
    now := sync_now_ns()
    busy: now - busy_since
    stop := now + (if (busy < SCHEDULER_IDLE_SPIN_NS) -> busy else -> SCHEDULER_IDLE_SPIN_NS)
    if (deadline >= I64{0} && deadline < stop) { stop = deadline }
    loop now < stop {
        if (sync_load(word) != I64{0}) { return true }
        #Unsafe("x86 pause only hints that this thread is waiting in a spin loop") {
            os_spin_pause()
        }
        now = sync_now_ns()
    }
    sync_load(word) != I64{0} || (deadline >= I64{0} && now >= deadline)
}

// The carrier of `record` goes idle (scheduler_carrier_idle): counted
// (idle120), its wake word cleared and its record at the idle list's head,
// so the carrier that idled last is claimed first. The deadline it sleeps
// to, -1 for none. The root lock is held.
scheduler_idle_enter: fn(root: I64, record: I64) -> I64 {
    sync_store(wrapping(root + I64{120}), sync_load(wrapping(root + I64{120})) + I64{1})
    deadline := I64{-1}
    timers: sync_load(wrapping(root + I64{136}))
    if (timers != I64{0} && sync_load(wrapping(root + I64{32})) == I64{0}) {
        earliest: sync_load(wrapping(timers + I64{16}))
        if (earliest >= I64{0}) {
            // A deadline is positive: watch 0 means none watches.
            deadline = if (earliest == I64{0}) -> I64{1} else -> earliest
            sync_store(wrapping(root + I64{32}), deadline)
        }
    }
    sync_store(wrapping(record + SCHEDULER_CARRIER_WAKE), I64{0})
    sync_store(wrapping(record + SCHEDULER_CARRIER_NEXT), sync_load(wrapping(root + I64{24})))
    sync_store(wrapping(root + I64{24}), record)
    deadline
}

// The carrier of `record`, back from its wait, leaves the idle count: a
// claimed one (its word 1) ends the claim on its way (woken160), an
// unclaimed one takes itself off the list, and a watcher whose watch is
// still its own ends it. The root lock is held.
scheduler_idle_leave: fn(root: I64, record: I64, deadline: I64) {
    sync_store(wrapping(root + I64{120}), sync_load(wrapping(root + I64{120})) - I64{1})
    if (sync_load(wrapping(record + SCHEDULER_CARRIER_WAKE)) != I64{0}) {
        sync_store(wrapping(root + I64{160}), sync_load(wrapping(root + I64{160})) - I64{1})
    } else { scheduler_idle_unlink(root, record) }
    if (deadline >= I64{0} && sync_load(wrapping(root + I64{32})) == deadline) {
        sync_store(wrapping(root + I64{32}), I64{0})
    }
}

// Takes an unclaimed carrier's record off the idle list; the root lock is
// held.
scheduler_idle_unlink: fn(root: I64, record: I64) {
    before := I64{0}
    at := sync_load(wrapping(root + I64{24}))
    loop at != record {
        if (at == I64{0}) {
            return
        }
        before = at
        at = sync_load(wrapping(at + SCHEDULER_CARRIER_NEXT))
    }
    scheduler_idle_remove(root, record, before)
}

// A carrier: the pool thread that runs task fibers (Fiber.jet fiber_run)
// and, idle, fires their timers. The record is its Carrier96; runs turns odd
// while it runs a job and even again after, for the monitor. A carrier whose
// fiber just yielded starts a queued job before it takes a ready fiber, so a
// turn it gave reaches a job that has no fiber yet: with more busy fibers
// than carriers the ready queue never empties, and a job taken only once it
// had would never start.
#Export(c) jet_rt_scheduler_worker: fn(record: I64) -> I64 {
    root: sync_load(record)
    sync_store(wrapping(record + I64{24}), thread_base())
    // Set before this carrier runs any fiber, which reads it (Fiber.jet
    // fiber_run); the start wrote it under the root lock before the spawn.
    sync_store(wrapping(thread_base() + THREAD_TCB_INDEX), sync_load(wrapping(record + SCHEDULER_CARRIER_INDEX)))
    sync_store(wrapping(record + I64{32}), thread_tid())
    yielded := I64{0}
    busy_since := sync_now_ns()
    loop {
        fiber_timers_fire(root)
        sync_thread_lock(root)
        if (sync_load(wrapping(root + I64{144})) != I64{0}) {
            // jet_rt_scheduler_shutdown owns this record and joins this thread.
            sync_thread_unlock(root)
            return I64{0}
        }
        task := if (yielded != I64{0}) -> scheduler_pop(root) else -> I64{0}
        fiber := if (task == I64{0}) -> fiber_ready_pop(root) else -> I64{0}
        if (task == I64{0} && fiber == I64{0}) { task = scheduler_pop(root) }
        if (fiber == I64{0} && task == I64{0}) {
            if scheduler_carrier_excess(root) {
                scheduler_carrier_retire(root, record)
                return I64{0}
            }
            scheduler_carrier_idle(root, record, busy_since)
            sync_thread_unlock(root)
            busy_since = sync_now_ns()
            next
        }
        // Work still waiting takes the next carrier, as a submit's or a
        // fiber's wake would have had no claim been on its way
        // (scheduler_wake_work). Leaving the watch to no one would sleep the
        // timers through.
        timers: sync_load(wrapping(root + I64{136}))
        taker: if {
            (sync_load(wrapping(root + I64{256})) != I64{0}) -> scheduler_work_taker(root)
            (sync_load(wrapping(root + I64{168})) != I64{0}) -> fiber_ready_taker(root)
            (timers != I64{0} && sync_load(wrapping(root + I64{32})) == I64{0} && sync_load(wrapping(timers + I64{16})) >= I64{0}) -> scheduler_wake_idle(root)
            else -> I64{0}
        }
        sync_thread_unlock(root)
        scheduler_take(root, taker)
        runs: wrapping(record + I64{40})
        sync_store(runs, wrapping(sync_load(runs) + I64{1}))
        if (task != I64{0}) {
            jet_rt_observe_pool(I64{-1}, I64{-1})
            fiber = fiber_take(root, scheduler_job_stack(task))
            if (fiber == I64{0}) {
                // No stack could be mapped, or the fiber stacks' space is
                // spent: the job runs on the carrier, whose waits then block it.
                scheduler_run_job(task)
                sync_store(runs, wrapping(sync_load(runs) + I64{1}))
                sync_thread_lock(root)
                sync_store(wrapping(root + I64{40}), sync_load(wrapping(root + I64{40})) - I64{1})
                _ := sync_add(wrapping(root + I64{280}), I64{-1})
                sync_thread_unlock(root)
                next
            }
            sync_store(wrapping(fiber + I64{56}), task)
        }
        yielded = if fiber_run(root, record, fiber) == FIBER_YIELD -> fiber else -> I64{0}
        sync_store(runs, wrapping(sync_load(runs) + I64{1}))
    }
}

// An idle carrier past the pool size plus the blocked ones leaves: off the
// carrier list, its record spare with its handle (scheduler_carrier_spare),
// which the next start or the shutdown joins. The root lock is held on entry
// and released.
scheduler_carrier_retire: fn(root: I64, record: I64) {
    list: sync_load(wrapping(root + I64{128}))
    length: sync_load(list)
    data: sync_load(wrapping(list + I64{16}))
    at := I64{0}
    loop at < length {
        if (sync_load(wrapping(data + at * I64{8})) == record) {
            last: wrapping(length - I64{1})
            sync_store(wrapping(data + at * I64{8}), sync_load(wrapping(data + last * I64{8})))
            sync_store(list, last)
            at = length
        } else { at += I64{1} }
    }
    sync_store(wrapping(root + I64{152}), wrapping(sync_load(wrapping(root + I64{152})) - I64{1}))
    scheduler_carrier_spare(root, record)
    sync_thread_unlock(root)
}

// A queued job: a task state, or a parallel walk's worker (Parallel.jet),
// marked PARALLEL_JOB in the first word, where a task state keeps its
// positive reference count.
scheduler_run_job: fn(job: I64) {
    if (sync_load(job) == PARALLEL_JOB) { parallel_job_run(job) } else { task_run(job) }
}

// The running job has run to its end (settled280): called by the job itself,
// before anything a waiter on it can see, so a waiter that returns finds it
// settled. Its carrier takes it off settled and live together.
scheduler_job_settled: fn() { _ := sync_add(wrapping(scheduler_root + I64{280}), I64{1}) }

// The stack size a job's fiber takes (Fiber.jet fiber_stack_class): a
// parallel worker's stack136, a task state's stack96.
scheduler_job_stack: fn(job: I64) -> I64 {
    if (sync_load(job) == PARALLEL_JOB) -> sync_load(wrapping(job + I64{136})) else -> sync_load(wrapping(job + I64{96}))
}

// Fiber counts for tests: parked@0, carriers started@8, fiber stacks@16.
scheduler_fiber_stats: fn(out: I64) {
    root: scheduler_root_required()
    sync_thread_lock(root)
    sync_store(out, sync_load(wrapping(root + I64{48})))
    sync_store(wrapping(out + I64{8}), sync_load(wrapping(root + I64{152})))
    sync_store(wrapping(out + I64{16}), sync_load(wrapping(root + I64{56})))
    sync_thread_unlock(root)
}

scheduler_completion_order: fn(out: I64) {
    root: scheduler_root
    sync_thread_lock(root)
    low: sync_load(wrapping(root + I64{80}))
    high: sync_load(wrapping(root + I64{88}))
    sync_store(out, low)
    sync_store(wrapping(out + I64{8}), high)
    next_low: wrapping(low + I64{1})
    next_high: if (next_low == I64{0}) -> wrapping(high + I64{1}) else -> high
    if (next_low == I64{0} && next_high == I64{0}) {
        sync_thread_unlock(root)
        scheduler_fatal(scheduler_msg_completion_exhausted())
        return
    }
    sync_store(wrapping(root + I64{80}), next_low)
    sync_store(wrapping(root + I64{88}), next_high)
    sync_thread_unlock(root)
}

#Export(c) jet_scheduler_drain: fn() {
    root: scheduler_root_required()
    at := I64{0}
    slot: sync_park_new()
    loop at < (I64{5000}) {
        if jet_rt_observe_has_parked_tasks() -> break
        sync_thread_lock(root)
        idle: sync_load(wrapping(root + I64{256})) == I64{0} && sync_load(wrapping(root + I64{40})) == I64{0}
        sync_thread_unlock(root)
        if idle && jet_rt_observe_io_quiescent() -> break
        sync_park(slot, I64{1000000})
        at += I64{1}
    }
    sync_park_drop(slot)
}

// Whether no task is queued or running (the root's counts at 256 and 40).
scheduler_idle: fn() -> Bool {
    root: scheduler_root_required()
    sync_thread_lock(root)
    idle: sync_load(wrapping(root + I64{256})) == I64{0} && sync_load(wrapping(root + I64{40})) == I64{0}
    sync_thread_unlock(root)
    idle
}

#Export(c) jet_scheduler_drain_after_exit: fn() {
    loop {
        if scheduler_idle() && jet_rt_observe_io_quiescent() {
            return
        }
        fiber_spin_yield()
    }
}

// Timer root48B mutex0 sequence8 head16 until24 stop32 thread40. Timer node48B
// next0 absoluteMonotonicNs8 borrowedPark16 active24 refs32 control40. Queue
// and caller each own a ref; cancel synchronizes with wake before the caller
// frees Park. A node with a control is a deadline watch
// (scheduler_deadline_watch): when due it raises that control's deadline bit
// instead of waking a park. until24 is the time the timer thread sleeps to
// (-1: until a timer is scheduled; 0: it has not slept yet), so a timer due
// no earlier leaves it asleep. The timer thread needs the root only, never
// the worker pool.
scheduler_timer_root: fn() -> I64 {
    root: scheduler_root_required()
    value: sync_load(wrapping(root + I64{104}))
    if (value != I64{0}) { return value }
    candidate: jet_rt_alloc(I64{48}, I64{8})
    thread_zero(candidate, I64{48})
    previous: sync_cas(wrapping(root + I64{104}), I64{0}, candidate)
    if (previous != I64{0}) {
        jet_rt_free(candidate, I64{48}, I64{8})
        return previous
    }
    handle: thread_spawn(rt_scheduler_timer_address(), candidate)
    if (handle < I64{0}) { scheduler_start_failed() }
    // Joinable: jet_rt_scheduler_shutdown joins it.
    sync_store(wrapping(candidate + I64{40}), handle)
    candidate
}

scheduler_timer_node_drop: fn(node: I64) {
    if (sync_add(wrapping(node + I64{32}), I64{-1}) == I64{1}) {
        jet_rt_free(node, I64{48}, I64{8})
    }
}

// A timer due at the monotonic `deadline_ns` that wakes the park `slot`, or
// with a `control` raises that control's deadline bit.
scheduler_timer_schedule: fn(deadline_ns: I64, slot: I64, control: I64) -> I64 {
    wheel: scheduler_timer_root()
    node: jet_rt_alloc(I64{48}, I64{8})
    sync_store(wrapping(node + I64{8}), deadline_ns)
    sync_store(wrapping(node + I64{16}), slot)
    sync_store(wrapping(node + I64{24}), I64{1})
    sync_store(wrapping(node + I64{32}), I64{2})
    sync_store(wrapping(node + I64{40}), control)
    sync_mutex_lock(wheel)
    sync_store(node, sync_load(wrapping(wheel + I64{16})))
    sync_store(wrapping(wheel + I64{16}), node)
    until: sync_load(wrapping(wheel + I64{24}))
    if (until <= I64{0} || deadline_ns < until) { sync_cond_notify_one(wrapping(wheel + I64{8})) }
    sync_mutex_unlock(wheel)
    node
}

// A wheel the shutdown freed had no timer pending, so the caller's node has
// fired and only its ref is left.
scheduler_timer_cancel: fn(node: I64) {
    wheel: sync_load(wrapping(scheduler_root + I64{104}))
    if (wheel == I64{0}) {
        scheduler_timer_node_drop(node)
        return
    }
    sync_mutex_lock(wheel)
    if (sync_load(wrapping(node + I64{24})) != I64{0}) {
        scheduler_node_unlink(wheel + I64{16}, node)
        sync_store(wrapping(node + I64{24}), I64{0})
        scheduler_timer_node_drop(node)
    }
    sync_mutex_unlock(wheel)
    scheduler_timer_node_drop(node)
}

#Export(c) jet_rt_scheduler_timer: fn(wheel: I64) -> I64 {
    loop {
        sync_mutex_lock(wheel)
        if (sync_load(wrapping(wheel + I64{32})) != I64{0}) {
            sync_mutex_unlock(wheel)
            return I64{0}
        }
        now: sync_now_ns()
        // With no timer pending the thread sleeps until one is scheduled.
        earliest := I64{-1}
        link := wheel + I64{16}
        loop sync_load(link) != (I64{0}) {
            node: sync_load(link)
            deadline: sync_load(wrapping(node + I64{8}))
            if {
                deadline <= now -> {
                    sync_store(link, sync_load(node))
                    sync_store(wrapping(node + I64{24}), I64{0})
                    // Waking or raising under wheel lock serializes
                    // cancellation with the slot's or the control's free.
                    control: sync_load(wrapping(node + I64{40}))
                    if (control != I64{0}) {
                        scheduler_attention_set(control, SCHEDULER_ATTEND_DEADLINE, true)
                    } else { sync_park_wake(sync_load(wrapping(node + I64{16}))) }
                    scheduler_timer_node_drop(node)
                }
                else -> {
                    if (earliest < I64{0} || deadline < earliest) { earliest = deadline }
                    link = node
                }
            }
        }
        sync_store(wrapping(wheel + I64{24}), earliest)
        _ := sync_cond_wait(wrapping(wheel + I64{8}), wheel, earliest)
        sync_mutex_unlock(wheel)
    }
}

// Stops and joins the timer thread of an idle wheel, until it has left the
// process (thread_join_gone). Returns the joined thread count, or -1
// (nothing stopped) while a timer is pending.
scheduler_timer_shutdown: fn(root: I64) -> I64 {
    wheel: sync_load(wrapping(root + I64{104}))
    if (wheel == I64{0}) { return I64{0} }
    sync_mutex_lock(wheel)
    if (sync_load(wrapping(wheel + I64{16})) != I64{0}) {
        sync_mutex_unlock(wheel)
        return I64{-1}
    }
    sync_store(wrapping(wheel + I64{32}), I64{1})
    sync_cond_notify_all(wrapping(wheel + I64{8}))
    sync_mutex_unlock(wheel)
    // scheduler_timer_root publishes the handle right after the spawn.
    loop sync_load(wrapping(wheel + (I64{40}))) == (I64{0}) {
        #Unsafe("sched_yield retains no memory and yields this OS thread") {
            _ := host_syscall(I64{24}, I64{0}, I64{0}, I64{0}, I64{0}, I64{0}, I64{0})
        }
    }
    _ := thread_join_gone(sync_load(wrapping(wheel + I64{40})))
    sync_store(wrapping(root + I64{104}), I64{0})
    jet_rt_free(wheel, I64{48}, I64{8})
    I64{1}
}

// Quiesce for a userland exec (JetBackend Image/Loader.jet): stop and join
// every scheduler thread this process started (the carriers, retired ones
// included, the timer and monitor threads), so the caller is the process's
// only scheduler thread. Each join waits until its thread has left the
// process (thread_join_gone), so a thread count read next counts none of
// them. 0 when none was ever started; otherwise the joined thread count.
// -1, with nothing stopped, while a task is queued or still running its
// body, or a timer is pending. A job that has run to its end (settled280)
// is waited for, not refused: its join may return before its carrier, back
// on its own stack, counts it off live, and that last step needs only the
// lock this wait releases between its checks. So a quiesce right after a
// group joined its tasks succeeds, under any load.
// The caller guarantees no other thread submits work concurrently. The pool,
// the timer and the monitor restart lazily on the next use; pooled fibers
// stay for it.
#Export(c) jet_rt_scheduler_shutdown: fn() -> I64 {
    root: scheduler_root
    if (root == I64{0}) { return I64{0} }
    loop sync_load(wrapping(root + (I64{112}))) == (I64{-1}) {
        _ := sync_wait(root + I64{112}, I64{-1}, I64{-1})
    }
    sync_thread_lock(root)
    loop {
        live: sync_load(wrapping(root + I64{40}))
        if (sync_load(wrapping(root + I64{256})) != I64{0} || live != sync_load(wrapping(root + I64{280}))) {
            sync_thread_unlock(root)
            return I64{-1}
        }
        if (live == I64{0}) { break }
        sync_thread_unlock(root)
        fiber_spin_yield()
        sync_thread_lock(root)
    }
    timer: scheduler_timer_shutdown(root)
    if (timer < I64{0}) {
        sync_thread_unlock(root)
        return I64{-1}
    }
    sync_store(wrapping(root + I64{144}), I64{1})
    carriers: sync_swap(wrapping(root + I64{128}), I64{0})
    // Every idle carrier is claimed and woken; a carrier not idle sees stop
    // under the lock before it could go idle.
    loop {
        woke: scheduler_wake_idle(root)
        if (woke == I64{0}) { break }
        scheduler_kick_idle(woke)
    }
    sync_store(wrapping(root + I64{216}), I64{2})
    sync_futex_wake(wrapping(root + I64{216}), I64{1})
    sync_thread_unlock(root)
    joined := timer + scheduler_carrier_list_join(carriers)
    // scheduler_monitor_kick publishes the handle right after the spawn.
    loop sync_load(wrapping(root + (I64{224}))) == (I64{-1}) {
        #Unsafe("sched_yield retains no memory and yields this OS thread") {
            _ := host_syscall(I64{24}, I64{0}, I64{0}, I64{0}, I64{0}, I64{0}, I64{0})
        }
    }
    monitor: sync_load(wrapping(root + I64{224}))
    if (monitor > I64{0}) {
        _ := thread_join_gone(monitor)
        joined += I64{1}
    }
    sync_thread_lock(root)
    sync_store(wrapping(root + I64{32}), I64{0})
    sync_store(wrapping(root + I64{120}), I64{0})
    sync_store(wrapping(root + I64{144}), I64{0})
    sync_store(wrapping(root + I64{152}), I64{0})
    sync_store(wrapping(root + I64{160}), I64{0})
    sync_store(wrapping(root + I64{208}), I64{0})
    sync_store(wrapping(root + I64{216}), I64{0})
    sync_store(wrapping(root + I64{224}), I64{0})
    _ := sync_swap(wrapping(root + I64{112}), I64{0})
    // Every thread that could wake a spare record is joined.
    spare := sync_swap(wrapping(root + I64{272}), I64{0})
    sync_thread_unlock(root)
    loop spare != (I64{0}) {
        record: spare
        spare = sync_load(wrapping(record + SCHEDULER_CARRIER_NEXT))
        retired: sync_load(wrapping(record + I64{8}))
        if (retired != I64{0}) {
            _ := thread_join_gone(retired)
            joined += I64{1}
        }
        jet_rt_free(record, SCHEDULER_CARRIER_BYTES, I64{8})
    }
    jet_rt_observe_pool(I64{0}, I64{0})
    joined
}

scheduler_park_duration: fn(wait_kind: I64, duration_ns: I64) -> I64 {
    if (duration_ns <= I64{0}) { return jet_scheduler_native_propagate() }
    world: world_current()
    if (world != I64{0}) {
        if ((sync_load(wrapping(thread_base() + I64{112})) & I64{1}) == I64{0}) {
            scheduler_fatal(services_msg_world_sleep())
            return jet_scheduler_native_status()
        }
        virtual_slot: sync_park_new()
        world_park(world, duration_ns, virtual_slot)
        status := jet_scheduler_native_propagate()
        if (status == I64{0}) { status = scheduler_yield(wait_kind, virtual_slot, I64{-1}) }
        sync_park_drop(virtual_slot)
        return status
    }
    // The park's own timeout ends the sleep; no timer thread is involved.
    slot: sync_park_new()
    status: scheduler_yield(wait_kind, slot, duration_ns)
    sync_park_drop(slot)
    status
}

#Export(c) jet_scheduler_sleep_ms: fn(millis: I64) {
    kind: scheduler_msg_sleep()
    _ := scheduler_park_duration(kind, deadline_ms_to_ns(millis))
    jet_rt_string_drop(kind)
}

#Export(c) jet_task_sleep_ms_defaulted: fn(millis: I64) {
    kind: scheduler_msg_sleep()
    if (scheduler_deadline_check(kind) == I64{0}) {
        _ := scheduler_park_duration(kind, deadline_ms_to_ns(millis))
        _ := scheduler_deadline_check(kind)
    }
    jet_rt_string_drop(kind)
}

#Export(c) jet_task_sleep_duration_ns_defaulted: fn(nanos: I64) {
    kind: scheduler_msg_sleep()
    if (scheduler_deadline_check(kind) == I64{0}) {
        _ := scheduler_park_duration(kind, nanos)
        _ := scheduler_deadline_check(kind)
    }
    jet_rt_string_drop(kind)
}

#Export(c) jet_task_yield: fn() {
    kind: scheduler_msg_yield()
    slot: sync_park_new()
    _ := scheduler_yield(kind, slot, I64{0})
    sync_park_drop(slot)
    jet_rt_string_drop(kind)
}

// Owner-thread deadline nodes24B: next0 deadline8 taskId16. Queue24B uses
// head0 nextId8 reserved16, lives at TCB@96. Earliest tie is registration order.
scheduler_owner_deadline_queue: fn() -> I64 {
    queue := sync_load(wrapping(thread_base() + I64{96}))
    if (queue == I64{0}) {
        queue = jet_rt_alloc(I64{24}, I64{8})
        thread_zero(queue, I64{24})
        sync_store(wrapping(queue + I64{8}), I64{1})
        sync_store(wrapping(thread_base() + I64{96}), queue)
    }
    queue
}

#Export(c) jet_scheduler_owner_deadline_register: fn(deadline_ns: I64) -> I64 {
    queue: scheduler_owner_deadline_queue()
    id: sync_load(wrapping(queue + I64{8}))
    sync_store(wrapping(queue + I64{8}), wrapping(id + I64{1}))
    node: jet_rt_alloc(I64{24}, I64{8})
    sync_store(node, I64{0})
    sync_store(wrapping(node + I64{8}), deadline_ns)
    sync_store(wrapping(node + I64{16}), id)
    link := queue
    loop sync_load(link) != (I64{0}) -> link = sync_load(link)
    sync_store(link, node)
    id
}

#Export(c) jet_scheduler_owner_deadline_cancel: fn(id: I64) {
    queue: scheduler_owner_deadline_queue()
    link := queue
    loop sync_load(link) != (I64{0}) {
        node: sync_load(link)
        if sync_load(wrapping(node + I64{16})) == id {
            sync_store(link, sync_load(node))
            jet_rt_free(node, I64{24}, I64{8})
            return
        }
        link = node
    }
}

#Export(c) jet_scheduler_owner_deadline_pop_due: fn(now_ns: I64) -> I64 {
    queue: scheduler_owner_deadline_queue()
    earliest := I64{0}
    link := queue
    loop sync_load(link) != (I64{0}) {
        node: sync_load(link)
        if sync_load(wrapping(node + I64{8})) <= now_ns && (earliest == I64{0} || sync_load(wrapping(node + I64{8})) < sync_load(wrapping(sync_load(earliest) + I64{8}))) {
            earliest = link
        }
        link = node
    }
    if (earliest == I64{0}) { return I64{0} }
    node: sync_load(earliest)
    id: sync_load(wrapping(node + I64{16}))
    sync_store(earliest, sync_load(node))
    jet_rt_free(node, I64{24}, I64{8})
    id
}

scheduler_fatal: fn(message: I64) {
    // The Rust original uses E3001 with an empty owner, not <core.prelude>.
    bytes: sync_load(message)
    length: sync_load(wrapping(message + I64{8}))
    trap_stop(I64{1}, bytes, length, I64{0}, I64{0})
    if !rt_task_panic_publish(bytes, length, I64{0}) {
        trap_simple_report(I64{0}, I64{0}, I64{0}, I64{0}, bytes, length)
    }
    jet_rt_string_drop(message)
}

// A runtime helper thread that could not start (thread_spawn EAGAIN:
// RLIMIT_AS, pids limit, memory) stops the process with E3001, also inside a
// task or root; a carrier never does (scheduler_start_worker). Native code
// has no stop edge out of a runtime-internal failure: an
// in-task stop would return into its caller, which would run on with the error
// code as a thread handle or a stopped helper's 0 result.
scheduler_start_failed: fn() {
    message: scheduler_msg_start_failed()
    trap_process_stop(I64{0}, sync_load(message), sync_load(wrapping(message + I64{8})))
}

// The pool's first carrier could not start (thread_spawn's -`errno`), so no
// task can run. The host refused a thread, which is no fault of the
// program: the report is no panic but one `error:` line naming the errno
// and the limits that refuse threads, RLIMIT_AS and RLIMIT_NPROC (-1 reads
// as unlimited), and the process exits 70. Served comptime code reports it
// to the compiler as a stop.
scheduler_first_worker_refused: fn(errno: I64) {
    head: rt_static_text("error: the host refused the first scheduler worker thread (errno ")
    trap_stop(I64{1}, rt_text_data(head), rt_text_len(head), I64{0}, I64{0})
    trap_defect_prepare()
    jet_rt_stdout_flush()
    trap_write_static(head)
    trap_number(errno)
    trap_write_static(rt_static_text("); address-space limit RLIMIT_AS "))
    scheduler_limit_write(thread_rlimit_soft(I64{9}))
    trap_write_static(rt_static_text(", process limit RLIMIT_NPROC "))
    scheduler_limit_write(thread_rlimit_soft(I64{6}))
    trap_write_static(rt_static_text("\n"))
    trap_defect_exit(EXIT_RUNTIME_PANIC)
}

// A soft rlimit as scheduler_first_worker_refused names it.
scheduler_limit_write: fn(soft: I64) {
    if (soft < I64{0}) { trap_write_static(rt_static_text("unlimited")) } else { trap_number(soft) }
}

// The one stop that reaches a root capture already being written: a stop
// raised while its own report renders. No report can be trusted, so abort.
scheduler_abort_double_panic: fn() {
    jet_rt_stdout_flush()
    // Bypass a root's report capture: this is the terminal abort diagnostic.
    alloc_write_word(I64{7955925828069384560}, I64{8})
    alloc_write_word(I64{8247343696930955552}, I64{8})
    alloc_write_word(I64{8458921675976893301}, I64{8})
    alloc_write_word(I64{7308325286140864882}, I64{8})
    alloc_write_word(I64{44836417121}, I64{5})
    alloc_abort()
}

// A stop that arrives while another unwinds is process-fatal: a panic during
// cleanup with a stop pending, or in a body whose inherited stop unwinds
// (Docs/Spec/core-library-native-contract.md). It is never published: its
// report goes straight to fd 2 and the process exits 70, so no further
// cleanup runs.
scheduler_stop_fatal: fn() -> Bool {
    if (jet_rt_stop_domain() == I64{0}) { return false }
    flags: scheduler_scope_flags(scheduler_control_current())
    if ((flags & SCHEDULER_SCOPE_INHERITED_STOP) != I64{0} || ((flags & SCHEDULER_SCOPE_CLEANUP) != I64{0} && scheduler_scope_delivered_kind(flags) != I64{0}) || scheduler_delivered_status_unmasked() != I64{0}) {
        return true
    }
    false
}

// A process-fatal stop handed over as its message: `form` 1 is a rendered
// report, written as it is; 0 is a raw panic reason, rendered as the root
// renders one. Either way the process exits 70.
scheduler_fatal_stop: fn(message: I64, length: I64, form: I64) {
    if (form == I64{1}) {
        jet_rt_stdout_flush()
        trap_write(message, length)
        trap_exit(EXIT_RUNTIME_PANIC)
        return
    }
    trap_header(I64{0})
    trap_write(message, length)
    trap_msg_prelude_end()
    trap_footer(I64{0})
}

// `code` is the registered stop row the root report would carry (0 E3001, 1 E3010, 2 E3011;
// trap_header's numbering). jet_runtime_stop records the raw stop on
// every active expectation frame before it unwinds, so the native catch probe sees the same
// first stop as the Rust reference. The published record stays the raw message (form 0).
rt_task_panic_publish: fn(message: I64, length: I64, code: I64) -> Bool {
    test_scope_record_coded_stop(code, message, length)
    rt_task_panic_publish_recorded(message, length)
}

// The publication rail once the caller has recorded its own stop code
// (Trap.jet jet_rt_coded_stop). Stop domain 2 exists only inside a task,
// parallel or realtime body, whose first entry installs the rail
// (scheduler_body_enter): a program that runs none links no publication.
rt_task_panic_publish_recorded: fn(message: I64, length: I64) -> Bool {
    code: task_panic_code
    if (code == I64{0}) { return false }
    coll_call2(code, message, length) != I64{0}
}

// rt_task_panic_publish_recorded's rail as a code word's target: 1 when
// the stop is published to the task, 0 when the caller reports it.
#Export(c) jet_rt_task_panic_publish: fn(message: I64, length: I64) -> I64 {
    if (jet_rt_stop_domain() != I64{2}) { return I64{0} }
    if scheduler_stop_fatal() -> return I64{0}
    text: scheduler_text_new(length)
    if (text == I64{0} && jet_rt_session_propagate() != I64{0}) { return I64{1} }
    coll_copy(message, sync_load(text), length)
    rt_task_panic_publish_owned(text, I64{0})
    I64{1}
}

// RuntimeLower resolves this checked function-address entry, never the body.
rt_task_panic_publish_address: fn() -> I64 {
    loop { jet_rt_unreachable(I64{0}, I64{0}) }
}

// Takes an owned, already checked report (or builder): the same publication
// rail as rt_task_panic_publish, without a second allocation/copy.
rt_task_panic_publish_owned: fn(message: I64, form: I64) {
    record: scheduler_stop_new(I64{5}, message)
    control: scheduler_control_current()
    if (control != I64{0}) {
        sync_store(wrapping(record + I64{56}), sync_swap(wrapping(control + I64{152}), I64{0}))
    }
    sync_store(wrapping(record + I64{48}), form)
    _ := scheduler_panic_publish_record(record)
}

scheduler_thread_detach: fn() {
    base: thread_base()
    frames: sync_load(wrapping(base + I64{80}))
    if (frames != I64{0}) {
        if (sync_load(frames) != I64{0}) { jet_rt_unreachable(I64{0}, I64{0}) }
        scheduler_words_drop(frames)
        sync_store(wrapping(base + I64{80}), I64{0})
    }
    queue: sync_load(wrapping(base + I64{96}))
    if (queue != I64{0}) {
        node := sync_load(queue)
        loop node != (I64{0}) {
            next_node: sync_load(node)
            jet_rt_free(node, I64{24}, I64{8})
            node = next_node
        }
        jet_rt_free(queue, I64{24}, I64{8})
        sync_store(wrapping(base + I64{96}), I64{0})
    }
}

// Host/session and interim comptime entry points. Controls and records are
// opaque owned pointers; enter borrows a control and a caller-owned 32B slot.
#Export(c) jet_rt_control_new: fn() -> I64 { scheduler_control_new() }

#Export(c) jet_rt_control_enter: fn(control: I64, save: I64) {
    scheduler_control_enter(control, save)
}

#Export(c) jet_rt_control_leave: fn(save: I64) { scheduler_control_leave(save) }

#Export(c) jet_rt_control_interrupt: fn(control: I64) { scheduler_control_interrupt(control) }

#Export(c) jet_rt_control_status: fn(control: I64) -> I64 { scheduler_control_status(control) }

#Export(c) jet_rt_control_take_stop: fn(control: I64) -> I64 {
    scheduler_control_take_stop(control)
}

#Export(c) jet_rt_control_discard_stop: fn(control: I64) { scheduler_control_discard_stop(control) }

#Export(c) jet_rt_stop_kind: fn(record: I64) -> I64 { sync_load(record) }

#Export(c) jet_rt_stop_jct_status: fn(record: I64) -> I64 { sync_load(wrapping(record + I64{8})) }

#Export(c) jet_rt_stop_owner: fn(record: I64) -> I64 { sync_load(wrapping(record + I64{16})) }

#Export(c) jet_rt_stop_start: fn(record: I64) -> I64 { sync_load(wrapping(record + I64{24})) }

#Export(c) jet_rt_stop_end: fn(record: I64) -> I64 { sync_load(wrapping(record + I64{32})) }

#Export(c) jet_rt_stop_form: fn(record: I64) -> I64 { sync_load(wrapping(record + I64{48})) }

#Export(c) jet_rt_stop_take_message: fn(record: I64) -> I64 { scheduler_stop_take_message(record) }

#Export(c) jet_rt_stop_drop: fn(record: I64) { scheduler_stop_drop(record) }

// A stop's publication to the current control. A process-fatal panic is
// reported and ends the process here instead (scheduler_stop_fatal).
#Export(c) jet_rt_control_publish_stop: fn(kind: I64, jct_status: I64, owner: I64, start: I64, end: I64, message: I64, length: I64, form: I64) -> Bool {
    if (kind == I64{5}) {
        if (jet_rt_stop_domain() == I64{0}) { return false }
        if scheduler_stop_fatal() {
            scheduler_fatal_stop(message, length, form)
            return false
        }
    }
    text: scheduler_text_new(length)
    if (text == I64{0} && jet_rt_session_propagate() != I64{0}) { return false }
    coll_copy(message, sync_load(text), length)
    record: scheduler_stop_new(kind, text)
    sync_store(wrapping(record + I64{8}), jct_status)
    sync_store(wrapping(record + I64{16}), owner)
    sync_store(wrapping(record + I64{24}), start)
    sync_store(wrapping(record + I64{32}), end)
    sync_store(wrapping(record + I64{48}), form)
    if (kind == I64{5}) -> scheduler_panic_publish_record(record) else -> scheduler_native_publish(record)
}
