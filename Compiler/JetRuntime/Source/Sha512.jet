// FIPS 180-4 SHA-512. Reuses Core/Crypto/Crypto.jet:1145-1298 arithmetic.
// Internal borrowed byte input, disjoint output64, caller scratch704 aligned8.
// The 80-word schedule/state are wiped before return; no allocation or padding copy.
// Signed words carry bit patterns; logical shifts mask off sign extension.
fn rt_crypto_shr64(value: I64, shift: I64) -> I64 {
    (value >> shift).bit_and((I64{9223372036854775807} >> (shift - I64{1})))
}
fn rt_crypto_rotr64(value: I64, shift: I64) -> I64 {
    rt_crypto_shr64(value, shift).bit_or((value << (I64{64} - shift)))
}
fn rt_crypto_word64(high: I64, low: I64) -> I64 { (high << I64{32}).bit_or(low) }
