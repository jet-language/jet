// ONE private rendering policy, ported from PreludeDataFlow.rs:167-230,265-307.
// Trim = Rust Unicode White_Space; folding = ASCII only. No Core/Data policy reuse.
fn data_public_trim_start(data: I64, start: I64, end: I64) -> I64 {
    at := start
    loop at < end {
        if !unicode_is_white_space(rt_text_decode(data + at)) -> break
        at += rt_text_width(data + at)
    }
    at
}
fn data_public_trim_end(data: I64, start: I64, end: I64) -> I64 {
    last := end
    loop last > start {
        at := last - I64{1}
        loop {
            if (at <= start || (rt_text_byte(data + at).bit_and(I64{192})) != I64{128}) -> break
            at -= I64{1}
        }
        if !unicode_is_white_space(rt_text_decode(data + at)) -> break
        last = at
    }
    last
}
fn data_public_match(data: I64, length: I64, at: I64, first: I64, tail: I64, width: I64) -> Bool {
    if width > length - at -> return false
    i := I64{0}
    loop i < width {
        byte := rt_text_byte(data + at + i)
        if (byte >= I64{65} && byte <= I64{90}) -> byte += I64{32}
        word :: if (i < I64{8}) -> first else -> tail
        if byte != ((word >> ((i % I64{8}) * I64{8})).bit_and(I64{255})) -> return false
        i += I64{1}
    }
    true
}
fn data_public_sensitive_value(data: I64, length: I64) -> Bool {
    at :: data_public_trim_start(data, I64{0}, length)
    end :: data_public_trim_end(data, at, length)
    span :: data + at
    size :: end - at
    data_public_match(span, size, I64{0}, I64{9132979290989922}, I64{0}, I64{7})
        || data_public_match(span, size, I64{0}, I64{35611343020386}, I64{0}, I64{6})
        || data_public_match(span, size, I64{0}, I64{7450469104725339437}, I64{28265}, I64{10})
        || data_public_match(span, size, I64{0}, I64{7237970109966541168}, I64{61}, I64{9})
        || data_public_match(span, size, I64{0}, I64{17297952638985587}, I64{0}, I64{7})
        || data_public_match(span, size, I64{0}, I64{67544357236596}, I64{0}, I64{6})
        || data_public_match(span, size, I64{0}, I64{7598819853035991651}, I64{4025441}, I64{11})
        || data_public_match(span, size, I64{0}, I64{8820707168001226081}, I64{67544524878945}, I64{14})
}
fn data_public_sensitive_key(data: I64, length: I64) -> Bool {
    at := I64{0}
    loop at < length {
        if (data_public_match(data, length, at, I64{7237970109966541168}, I64{0}, I64{8})
            || data_public_match(data, length, at, I64{110464200827248}, I64{0}, I64{6})
            || data_public_match(data, length, at, I64{6584176}, I64{0}, I64{3})
            || data_public_match(data, length, at, I64{127979059635571}, I64{0}, I64{6})
            || data_public_match(data, length, at, I64{474147942260}, I64{0}, I64{5})
            || data_public_match(data, length, at, I64{7598819853035991651}, I64{27745}, I64{10})
            || data_public_match(data, length, at, I64{8820707168001226081}, I64{474315584609}, I64{13})
            || data_public_match(data, length, at, I64{1752462689}, I64{0}, I64{4})
            || data_public_match(data, length, at, I64{34169984018640993}, I64{0}, I64{7})
            || data_public_match(data, length, at, I64{133476500729953}, I64{0}, I64{6})
            || data_public_match(data, length, at, I64{7737029624305247073}, I64{31077}, I64{10})
            || data_public_match(data, length, at, I64{8371474221811065697}, I64{1852140399}, I64{12})
            || data_public_match(data, length, at, I64{8247626254411852147}, I64{101}, I64{9})
            || data_public_match(data, length, at, I64{111503448436579}, I64{0}, I64{6})
            || data_public_match(data, length, at, I64{31084746137363827}, I64{0}, I64{7})
            || data_public_match(data, length, at, I64{6874028368198201968}, I64{7955819}, I64{11})
            || data_public_match(data, length, at, I64{3271148666301805168}, I64{7955819}, I64{11})
            || data_public_match(data, length, at, I64{9132979290989922}, I64{0}, I64{6})) -> return true
        at += I64{1}
    }
    false
}
fn data_public_bounded(target: I64, data: I64, length: I64) {
    if (length <= I64{4096}) {
        rt_text_append(target, data, length)
        return
    }
    // The 14-byte ASCII suffix leaves 4082 bytes, ending at a UTF-8 boundary.
    end := I64{4082}
    loop {
        if ((rt_text_byte(data + end).bit_and(I64{192})) != I64{128}) -> break
        end -= I64{1}
    }
    rt_text_append(target, data, end)
    rt_text_push_word(target, I64{7959393759998651950}, I64{8})
    rt_text_push_word(target, I64{68600919777635}, I64{6})
}
fn data_public_redacted(target: I64) {
    rt_text_push_word(target, I64{7310577365076505148}, I64{8})
    rt_text_push_word(target, I64{15972}, I64{2})
}
fn data_public_authority_part(target: I64, value: I64) {
    data :: rt_text_data(value)
    length :: rt_text_len(value)
    if data_public_sensitive_value(data, length) -> data_public_redacted(target)
    else -> data_public_bounded(target, data, length)
}
fn data_public_digest(target: I64, data: I64, length: I64) {
    // Shared Sha256.jet; caller owns one scratch block, never a copied input.
    workspace :: jet_rt_alloc(I64{608}, I64{8})
    digest :: workspace + I64{576}
    jet_rt_native_sha256(data, length, digest, workspace)
    rt_text_push_word(target, I64{7526409316051214710}, I64{8})
    rt_text_push_word(target, I64{194182984289}, I64{5})
    at := I64{0}
    loop {
        if (at >= I64{32}) -> break
        byte :: rt_text_byte(digest + at)
        hi :: byte >> I64{4}
        lo :: byte.bit_and(I64{15})
        rt_text_push_scalar(target, if (hi < I64{10}) -> hi + I64{48} else -> hi + I64{87})
        rt_text_push_scalar(target, if (lo < I64{10}) -> lo + I64{48} else -> lo + I64{87})
        at += I64{1}
    }
    jet_rt_free(workspace, I64{608}, I64{8})
}
fn data_public_find(data: I64, start: I64, end: I64, byte: I64) -> I64 {
    at := start
    loop at < end {
        if rt_text_byte(data + at) == byte -> return at
        at += I64{1}
    }
    end
}
fn data_public_parameter(target: I64, data: I64, length: I64) {
    start :: data_public_trim_start(data, I64{0}, length)
    end :: data_public_trim_end(data, start, length)
    equal :: data_public_find(data, start, end, I64{61})
    key_start :: data_public_trim_start(data, start, equal)
    key_end :: data_public_trim_end(data, key_start, equal)
    if (equal == end || key_start == key_end) {
        data_public_digest(target, data + start, end - start)
    } else if (data_public_sensitive_key(data + key_start, key_end - key_start) || data_public_sensitive_value(data + equal + I64{1}, end - equal - I64{1})) {
        data_public_bounded(target, data + key_start, key_end - key_start)
        rt_text_push_scalar(target, I64{61})
        data_public_redacted(target)
    } else {
        data_public_bounded(target, data + start, end - start)
    }
}
fn data_public_locator(target: I64, value: I64) {
    data :: rt_text_data(value)
    end :: data_public_find(data, I64{0}, rt_text_len(value), I64{35})
    query :: data_public_find(data, I64{0}, end, I64{63})
    scheme := I64{0}
    loop {
        if (scheme + I64{2} >= query) -> break
        if (rt_text_byte(data + scheme) == I64{58} && rt_text_byte(data + scheme + I64{1}) == I64{47} && rt_text_byte(data + scheme + I64{2}) == I64{47}) -> break
        scheme += I64{1}
    }
    if (scheme + I64{2} < query) {
        authority :: scheme + I64{3}
        at :: data_public_find(data, authority, query, I64{64})
        rt_text_append(target, data, authority)
        if (at < query) -> rt_text_append(target, data + at + I64{1}, query - at - I64{1})
        else -> rt_text_append(target, data + authority, query - authority)
    } else {
        rt_text_append(target, data, query)
    }
    if (query == end) -> return
    rt_text_push_scalar(target, I64{63})
    start := query + I64{1}
    loop {
        next :: data_public_find(data, start, end, I64{38})
        data_public_parameter(target, data + start, next - start)
        if (next == end) -> break
        rt_text_push_scalar(target, I64{38})
        start = next + I64{1}
    }
}
