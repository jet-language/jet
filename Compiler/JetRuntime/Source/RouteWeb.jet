// core.web runtime stops.

// jet_runtime_stop("E2805", "", 0, message). E2805 has no active runtime row,
// so this stop is the host form: one `internal error:` line naming the code,
// with status 101. A task body receives the raw message instead.
#Export(c) jet_openapi_contract_stop_raw: fn(message: I64) {
    trap_stop(I64{1}, rt_text_data(message), rt_text_len(message), I64{0}, I64{0})
    if rt_task_panic_publish(rt_text_data(message), rt_text_len(message), I64{3}) -> return
    trap_root_prepare()
    jet_rt_stdout_flush()
    trap_msg_inactive_row_head()
    trap_write_word(TEST_SCOPE_E2805, I64{5})
    trap_msg_inactive_row_tail()
    trap_msg_newline()
    trap_exit(EXIT_ICE)
}
