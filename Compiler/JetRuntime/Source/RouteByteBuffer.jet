// The `Bytes` value routes over the ByteHandlesABI buffer: one native
// List<U8> sequence plus a read cursor, with EOF at position == len. Writers
// append fixed-width encodings; the string-like methods read the bytes as
// lossy UTF-8 (one U+FFFD per invalid subpart) and reuse the Text kernels.
// Int operands arrive as borrowed exact Int carriers; fixed-width writer
// operands are the exact Int of the checked fixed-width value.

fn byte_buffer_sequence(buffer: I64) -> I64 { data_tree_word(wrapping(buffer + BYTE_BUFFER_SEQUENCE)) }
fn byte_buffer_len(buffer: I64) -> I64 { data_tree_word(wrapping(byte_buffer_sequence(buffer) + DATA_SEQUENCE_LENGTH)) }
fn byte_buffer_data(buffer: I64) -> I64 { data_tree_word(wrapping(byte_buffer_sequence(buffer) + DATA_SEQUENCE_DATA)) }
fn byte_buffer_position(buffer: I64) -> I64 { data_tree_word(wrapping(buffer + BYTE_BUFFER_POSITION)) }
fn byte_buffer_set_position(buffer: I64, position: I64) { data_tree_store(wrapping(buffer + BYTE_BUFFER_POSITION), position) }

// A fresh buffer holding a copy of `length` bytes at `data`, cursor at 0.
fn byte_buffer_of(data: I64, length: I64, capacity: I64) -> I64 {
    sequence :: data_sequence_new(if capacity < length -> length else -> capacity, RT_HOST_U8_STRIDE)
    target :: data_tree_word(wrapping(sequence + DATA_SEQUENCE_DATA))
    at := I64{0}
    loop at < length {
        host_u8_put(target, at, host_u8_get(data, at))
        at += I64{1}
    }
    data_tree_store(wrapping(sequence + DATA_SEQUENCE_LENGTH), length)
    result :: jet_rt_alloc(BYTE_BUFFER_BYTES, I64{8})
    data_tree_store(wrapping(result + BYTE_BUFFER_SEQUENCE), sequence)
    data_tree_store(wrapping(result + BYTE_BUFFER_POSITION), I64{0})
    result
}

// A fresh buffer holding the UTF-8 bytes of `text`; the text is dropped.
fn byte_buffer_from_text(text: I64) -> I64 {
    result :: byte_buffer_of(rt_text_data(text), rt_text_len(text), I64{0})
    jet_rt_string_drop(text)
    result
}

// The lossy UTF-8 reading of the buffer's bytes as a fresh text.
fn byte_buffer_text(buffer: I64) -> I64 { jet_string_from_bytes_lossy(byte_buffer_data(buffer), byte_buffer_len(buffer)) }

// The write address of `extra` more bytes at the end, growing the sequence
// geometrically; the caller stores them and then byte_buffer_commit.
fn byte_buffer_reserve(buffer: I64, extra: I64) -> I64 {
    sequence :: byte_buffer_sequence(buffer)
    length :: data_tree_word(wrapping(sequence + DATA_SEQUENCE_LENGTH))
    capacity :: data_tree_word(wrapping(sequence + DATA_SEQUENCE_CAPACITY))
    old :: data_tree_word(wrapping(sequence + DATA_SEQUENCE_DATA))
    if extra <= capacity - length -> return old + length * RT_HOST_U8_STRIDE
    limit :: I64{9223372036854775807} /% RT_HOST_U8_STRIDE
    if extra > limit - length {
        rt_seq_capacity_overflow_stop()
        return I64{0}
    }
    needed :: length + extra
    grown := if (capacity < I64{8}) -> I64{8} else -> capacity
    loop grown < needed {
        grown = if (grown > limit /% I64{2}) -> limit else -> grown * I64{2}
    }
    data :: jet_rt_alloc(grown * RT_HOST_U8_STRIDE, I64{8})
    coll_copy(old, data, length * RT_HOST_U8_STRIDE)
    if (capacity != I64{0}) -> jet_rt_free(old, capacity * RT_HOST_U8_STRIDE, I64{8})
    data_tree_store(wrapping(sequence + DATA_SEQUENCE_CAPACITY), grown)
    data_tree_store(wrapping(sequence + DATA_SEQUENCE_DATA), data)
    data + length * RT_HOST_U8_STRIDE
}

fn byte_buffer_commit(buffer: I64, extra: I64) {
    sequence :: byte_buffer_sequence(buffer)
    data_tree_store(wrapping(sequence + DATA_SEQUENCE_LENGTH), data_tree_word(wrapping(sequence + DATA_SEQUENCE_LENGTH)) + extra)
}

// Appends the low `width` bytes of `bits`, least significant first when
// `little`, most significant first otherwise.
fn byte_buffer_put_word(buffer: I64, bits: I64, width: I64, little: Bool) {
    target :: byte_buffer_reserve(buffer, width)
    if (target == I64{0}) -> return
    at := I64{0}
    loop at < width {
        shift :: if little -> at * I64{8} else -> (width - I64{1} - at) * I64{8}
        host_u8_put(target, at, (bits >> shift).bit_and(I64{255}))
        at += I64{1}
    }
    byte_buffer_commit(buffer, width)
}

fn byte_buffer_put_bytes(buffer: I64, data: I64, length: I64) {
    if (length <= I64{0}) -> return
    target :: byte_buffer_reserve(buffer, length)
    if (target == I64{0}) -> return
    at := I64{0}
    loop at < length {
        host_u8_put(target, at, host_u8_get(data, at))
        at += I64{1}
    }
    byte_buffer_commit(buffer, length)
}

// The two's-complement bit pattern of an exact Int that holds a checked
// fixed-width value (a U64 above I64.MAX wraps to its unsigned bits).
fn byte_buffer_bits(carrier: I64) -> I64 { if int_inline(carrier) -> carrier else -> int_word(carrier) }

// An index or count operand: an exact Int beyond the inline range is past
// any buffer (or below zero).
fn byte_buffer_index(carrier: I64) -> I64 {
    if int_inline(carrier) -> return carrier
    if int_negative(carrier) -> I64{-1} else -> I64{9223372036854775807}
}

// The IEEE single-precision bits of `value`, which holds an F32 exactly.
fn byte_buffer_f32_bits(value: Float) -> I64 {
    bits :: rt_f64_bits(value)
    sign :: (bits >> I64{63}).bit_and(I64{1}) << I64{31}
    exponent :: (bits >> I64{52}).bit_and(I64{2047})
    mantissa :: bits.bit_and(I64{4503599627370495})
    if (exponent == I64{2047}) {
        payload :: mantissa >> I64{29}
        quiet :: if (mantissa != I64{0} && payload == I64{0}) -> I64{1} else -> payload
        return sign.bit_or(I64{2139095040}).bit_or(quiet)
    }
    if (exponent == I64{0}) -> return sign
    biased :: exponent - I64{896}
    if (biased >= I64{1}) -> return sign.bit_or(biased << I64{23}).bit_or(mantissa >> I64{29})
    shift :: I64{30} - biased
    if (shift > I64{53}) -> return sign
    sign.bit_or(mantissa.bit_or(I64{4503599627370496}) >> shift)
}

// An Option<U8> payload: the byte at `at` written to `some`, or absent.
fn byte_buffer_option_byte(buffer: I64, at: I64, some: I64) -> I64 {
    if (at < I64{0} || at >= byte_buffer_len(buffer)) -> return I64{0}
    data_tree_store(some, host_u8_get(byte_buffer_data(buffer), at))
    I64{1}
}

// A fresh List<U8> of `length` bytes at `data`: its buffer stored at
// `output` (0 when empty), the length returned.
fn byte_buffer_list(data: I64, length: I64, output: I64) -> I64 {
    if (length == I64{0}) {
        data_tree_store(output, I64{0})
        return I64{0}
    }
    bytes :: jet_rt_alloc(length * RT_HOST_U8_STRIDE, I64{8})
    at := I64{0}
    loop at < length {
        host_u8_put(bytes, at, host_u8_get(data, at))
        at += I64{1}
    }
    data_tree_store(output, bytes)
    length
}

// Consumes the `count` bytes after the cursor as a List<U8> written to
// (data_out, len_out); absent when fewer remain.
fn byte_buffer_take(buffer: I64, count: I64, data_out: I64, len_out: I64) -> I64 {
    position :: byte_buffer_position(buffer)
    if (count < I64{0} || count > byte_buffer_len(buffer) - position) -> return I64{0}
    data_tree_store(len_out, byte_buffer_list(wrapping(byte_buffer_data(buffer) + position * RT_HOST_U8_STRIDE), count, data_out))
    byte_buffer_set_position(buffer, position + count)
    I64{1}
}

// A fresh buffer of `text` transformed by a Text kernel result.
fn byte_buffer_mapped(buffer: I64, kind: I64) -> I64 {
    text :: byte_buffer_text(buffer)
    mapped :: if {
        (kind == I64{0}) -> rt_text_trim(text)
        (kind == I64{1}) -> jet_text_trim_start(text)
        (kind == I64{2}) -> jet_text_trim_end(text)
        (kind == I64{3}) -> jet_unicode_lower(text)
        (kind == I64{4}) -> jet_unicode_upper(text)
        else -> byte_buffer_title(text)
    }
    jet_rt_string_drop(text)
    byte_buffer_from_text(mapped)
}

// Title case as the buffer defines it: whitespace starts a word; a word's
// first scalar takes its uppercase mapping and the rest their lowercase ones.
fn byte_buffer_title(text: I64) -> I64 {
    data :: rt_text_data(text)
    length :: rt_text_len(text)
    result :: rt_text_builder_with_capacity(length)
    start := true
    at := I64{0}
    loop at < length {
        step :: rt_text_width(wrapping(data + at))
        cp :: rt_text_decode(wrapping(data + at))
        if unicode_is_white_space(cp) {
            rt_text_append(result, data + at, step)
            start = true
        } else {
            unicode_append_mapping(result, if start -> unicode_upper_mapping(cp) else -> unicode_lower_mapping(cp))
            start = false
        }
        at += step
    }
    jet_rt_string_builder_finish(result)
}

// One Text kernel predicate over the lossy reading.
fn byte_buffer_test(buffer: I64, needle: I64, kind: I64) -> Bool {
    text :: byte_buffer_text(buffer)
    found :: if {
        (kind == I64{0}) -> jet_string_contains(text, needle)
        (kind == I64{1}) -> jet_string_starts_with(text, needle)
        else -> jet_string_ends_with(text, needle)
    }
    jet_rt_string_drop(text)
    found
}

// The byte offset of `needle` in the lossy reading (first or last match).
fn byte_buffer_find(buffer: I64, needle: I64, some: I64, last: Bool) -> I64 {
    text :: byte_buffer_text(buffer)
    at :: rt_text_find(text, needle, I64{0}, last)
    jet_rt_string_drop(text)
    if (at < I64{0}) -> return I64{0}
    data_tree_store(some, jet_int_owned_from_i64(at))
    I64{1}
}

// A List<Text> of `count` words built by the caller: storage at `output`.
fn byte_buffer_text_words(count: I64, output: I64) -> I64 {
    if (count > I64{1152921504606846975}) {
        rt_text_capacity_stop()
        return I64{0}
    }
    words :: if (count == I64{0}) -> I64{0} else -> jet_rt_alloc(count * I64{8}, I64{8})
    data_tree_store(output, words)
    words
}

// Lexicographic byte order, then length: -1, 0 or 1.
fn byte_buffer_order(left: I64, right: I64) -> I64 {
    left_len :: byte_buffer_len(left)
    right_len :: byte_buffer_len(right)
    common :: if left_len < right_len -> left_len else -> right_len
    left_data :: byte_buffer_data(left)
    right_data :: byte_buffer_data(right)
    at := I64{0}
    loop at < common {
        a :: host_u8_get(left_data, at)
        z :: host_u8_get(right_data, at)
        if (a != z) -> return if a < z -> I64{-1} else -> I64{1}
        at += I64{1}
    }
    if left_len == right_len -> I64{0} else if left_len < right_len -> I64{-1} else -> I64{1}
}

// Replaces the bytes of `target` with a copy of `source`'s, cursor at 0.
fn byte_buffer_assign(target: I64, source: I64) {
    sequence :: byte_buffer_sequence(target)
    data_tree_store(wrapping(sequence + DATA_SEQUENCE_LENGTH), I64{0})
    byte_buffer_put_bytes(target, byte_buffer_data(source), byte_buffer_len(source))
    byte_buffer_set_position(target, I64{0})
}

#Export(c) fn jet_byte_buffer_new() -> I64 { byte_buffer_of(I64{0}, I64{0}, I64{0}) }

#Export(c) fn jet_byte_buffer_with_capacity(capacity: I64) -> I64 {
    wanted :: byte_buffer_index(capacity)
    byte_buffer_of(I64{0}, I64{0}, if (wanted < I64{0}) -> I64{0} else -> wanted)
}

#Export(c) fn jet_byte_buffer_from(data: I64, length: I64) -> I64 { byte_buffer_of(data, length, I64{0}) }

#Export(c) fn jet_byte_buffer_clone(buffer: I64) -> I64 { jet_rt_handle_clone_jet_byte_buffer(buffer) }

#Export(c) fn jet_byte_buffer_to_bytes(buffer: I64, output: I64) -> I64 { byte_buffer_list(byte_buffer_data(buffer), byte_buffer_len(buffer), output) }
#Export(c) fn jet_byte_buffer_buffer(buffer: I64, output: I64) -> I64 { jet_byte_buffer_to_bytes(buffer, output) }
#Export(c) fn jet_byte_buffer_get_buffer(buffer: I64, output: I64) -> I64 { jet_byte_buffer_to_bytes(buffer, output) }

#Export(c) fn jet_byte_buffer_capacity(buffer: I64) -> I64 { jet_int_owned_from_i64(data_tree_word(wrapping(byte_buffer_sequence(buffer) + DATA_SEQUENCE_CAPACITY))) }
#Export(c) fn jet_byte_buffer_len(buffer: I64) -> I64 { jet_int_owned_from_i64(byte_buffer_len(buffer)) }
#Export(c) fn jet_byte_buffer_position(buffer: I64) -> I64 { jet_int_owned_from_i64(byte_buffer_position(buffer)) }
#Export(c) fn jet_byte_buffer_is_empty(buffer: I64) -> Bool { byte_buffer_len(buffer) == I64{0} }
#Export(c) fn jet_byte_buffer_eof(buffer: I64) -> Bool { byte_buffer_position(buffer) >= byte_buffer_len(buffer) }

#Export(c) fn jet_byte_buffer_is_ascii(buffer: I64) -> Bool {
    data :: byte_buffer_data(buffer)
    length :: byte_buffer_len(buffer)
    at := I64{0}
    loop at < length {
        if (host_u8_get(data, at) >= I64{128}) -> return false
        at += I64{1}
    }
    true
}

#Export(c) fn jet_byte_buffer_clear(buffer: I64) {
    data_tree_store(wrapping(byte_buffer_sequence(buffer) + DATA_SEQUENCE_LENGTH), I64{0})
    byte_buffer_set_position(buffer, I64{0})
}
#Export(c) fn jet_byte_buffer_close(buffer: I64) { jet_byte_buffer_clear(buffer) }
#Export(c) fn jet_byte_buffer_shutdown(buffer: I64) { jet_byte_buffer_clear(buffer) }
#Export(c) fn jet_byte_buffer_flush(_buffer: I64) {}
#Export(c) fn jet_byte_buffer_rewind(buffer: I64) { byte_buffer_set_position(buffer, I64{0}) }

#Export(c) fn jet_byte_buffer_seek(buffer: I64, index: I64) {
    at :: byte_buffer_index(index)
    length :: byte_buffer_len(buffer)
    byte_buffer_set_position(buffer, if (at <= I64{0}) -> I64{0} else if at > length -> length else -> at)
}

#Export(c) fn jet_byte_buffer_get(buffer: I64, index: I64, some: I64) -> I64 { byte_buffer_option_byte(buffer, byte_buffer_index(index), some) }
#Export(c) fn jet_byte_buffer_first(buffer: I64, some: I64) -> I64 { byte_buffer_option_byte(buffer, I64{0}, some) }

#Export(c) fn jet_byte_buffer_read_byte(buffer: I64, some: I64) -> I64 {
    position :: byte_buffer_position(buffer)
    if (byte_buffer_option_byte(buffer, position, some) == I64{0}) -> return I64{0}
    byte_buffer_set_position(buffer, position + I64{1})
    I64{1}
}
#Export(c) fn jet_byte_buffer_next(buffer: I64, some: I64) -> I64 { jet_byte_buffer_read_byte(buffer, some) }

#Export(c) fn jet_byte_buffer_read(buffer: I64, data_out: I64, len_out: I64) -> I64 {
    remaining :: byte_buffer_len(buffer) - byte_buffer_position(buffer)
    if (remaining <= I64{0}) -> return I64{0}
    byte_buffer_take(buffer, remaining, data_out, len_out)
}

#Export(c) fn jet_byte_buffer_read_bytes(buffer: I64, count: I64, data_out: I64, len_out: I64) -> I64 { byte_buffer_take(buffer, byte_buffer_index(count), data_out, len_out) }

#Export(c) fn jet_byte_buffer_read_string(buffer: I64, count: I64, some: I64) -> I64 {
    wanted :: byte_buffer_index(count)
    position :: byte_buffer_position(buffer)
    if (wanted < I64{0} || wanted > byte_buffer_len(buffer) - position) -> return I64{0}
    data_tree_store(some, jet_string_from_bytes_lossy(wrapping(byte_buffer_data(buffer) + position * RT_HOST_U8_STRIDE), wanted))
    byte_buffer_set_position(buffer, position + wanted)
    I64{1}
}

#Export(c) fn jet_byte_buffer_to_string(buffer: I64) -> I64 { byte_buffer_text(buffer) }
#Export(c) fn jet_byte_buffer_string(buffer: I64) -> I64 { byte_buffer_text(buffer) }

#Export(c) fn jet_byte_buffer_trim(buffer: I64) -> I64 { byte_buffer_mapped(buffer, I64{0}) }
#Export(c) fn jet_byte_buffer_trim_start(buffer: I64) -> I64 { byte_buffer_mapped(buffer, I64{1}) }
#Export(c) fn jet_byte_buffer_trim_end(buffer: I64) -> I64 { byte_buffer_mapped(buffer, I64{2}) }
#Export(c) fn jet_byte_buffer_to_lower(buffer: I64) -> I64 { byte_buffer_mapped(buffer, I64{3}) }
#Export(c) fn jet_byte_buffer_to_upper(buffer: I64) -> I64 { byte_buffer_mapped(buffer, I64{4}) }
#Export(c) fn jet_byte_buffer_to_title(buffer: I64) -> I64 { byte_buffer_mapped(buffer, I64{5}) }
#Export(c) fn jet_byte_buffer_title(buffer: I64) -> I64 { byte_buffer_mapped(buffer, I64{5}) }

#Export(c) fn jet_byte_buffer_contains(buffer: I64, needle: I64) -> Bool { byte_buffer_test(buffer, needle, I64{0}) }
#Export(c) fn jet_byte_buffer_starts_with(buffer: I64, prefix: I64) -> Bool { byte_buffer_test(buffer, prefix, I64{1}) }
#Export(c) fn jet_byte_buffer_ends_with(buffer: I64, suffix: I64) -> Bool { byte_buffer_test(buffer, suffix, I64{2}) }
#Export(c) fn jet_byte_buffer_index_of(buffer: I64, needle: I64, some: I64) -> I64 { byte_buffer_find(buffer, needle, some, false) }
#Export(c) fn jet_byte_buffer_last_index_of(buffer: I64, needle: I64, some: I64) -> I64 { byte_buffer_find(buffer, needle, some, true) }

#Export(c) fn jet_byte_buffer_replace(buffer: I64, from: I64, to: I64) -> I64 {
    text :: byte_buffer_text(buffer)
    replaced :: jet_string_replace(text, from, to)
    jet_rt_string_drop(text)
    byte_buffer_from_text(replaced)
}

#Export(c) fn jet_byte_buffer_lines(buffer: I64, output: I64) -> I64 {
    text :: byte_buffer_text(buffer)
    count :: jet_string_lines(text, output)
    jet_rt_string_drop(text)
    count
}

// str::split; an empty separator yields "", each scalar, then "".
#Export(c) fn jet_byte_buffer_split(buffer: I64, separator: I64, output: I64) -> I64 {
    text :: byte_buffer_text(buffer)
    data :: rt_text_data(text)
    length :: rt_text_len(text)
    width :: rt_text_len(separator)
    count := I64{0}
    if (width == I64{0}) {
        count = jet_char_len(text) + I64{2}
        words :: byte_buffer_text_words(count, output)
        if (words == I64{0}) {
            jet_rt_string_drop(text)
            return I64{0}
        }
        data_tree_store(words, rt_text_copy(I64{1}, I64{0}))
        index := I64{1}
        at := I64{0}
        loop at < length {
            step :: rt_text_width(wrapping(data + at))
            data_tree_store(wrapping(words + index * I64{8}), rt_text_slice(text, at, at + step))
            index += I64{1}
            at += step
        }
        data_tree_store(wrapping(words + index * I64{8}), rt_text_copy(I64{1}, I64{0}))
        jet_rt_string_drop(text)
        return count
    }
    count = I64{1}
    at := I64{0}
    loop at <= length {
        found :: rt_text_find(text, separator, at, false)
        if (found < I64{0}) -> break
        count += I64{1}
        at = found + width
    }
    words :: byte_buffer_text_words(count, output)
    if (words == I64{0}) {
        jet_rt_string_drop(text)
        return I64{0}
    }
    index := I64{0}
    at = I64{0}
    loop index + (I64{1}) < count {
        found :: rt_text_find(text, separator, at, false)
        data_tree_store(wrapping(words + index * I64{8}), rt_text_slice(text, at, found))
        index += I64{1}
        at = found + width
    }
    data_tree_store(wrapping(words + index * I64{8}), rt_text_slice(text, at, length))
    jet_rt_string_drop(text)
    count
}

// The parts joined with the buffer's lossy reading between them.
#Export(c) fn jet_byte_buffer_join(buffer: I64, parts: I64, count: I64) -> I64 {
    separator :: byte_buffer_text(buffer)
    result :: jet_rt_string_builder_new()
    at := I64{0}
    loop at < count {
        if (at != I64{0}) -> rt_text_append(result, rt_text_data(separator), rt_text_len(separator))
        part :: data_tree_word(wrapping(parts + at * I64{8}))
        rt_text_append(result, rt_text_data(part), rt_text_len(part))
        at += I64{1}
    }
    jet_rt_string_drop(separator)
    byte_buffer_from_text(jet_rt_string_builder_finish(result))
}

// [before, separator, after] at the first occurrence of `separator`; the
// whole buffer and two empty ones when it does not occur.
#Export(c) fn jet_byte_buffer_partition(buffer: I64, separator: I64, data_out: I64, len_out: I64, err: I64) -> I64 {
    width :: byte_buffer_len(separator)
    if (width == I64{0}) {
        data_tree_store(err, rt_static_text("byte partition separator must not be empty"))
        return I64{0}
    }
    data :: byte_buffer_data(buffer)
    length :: byte_buffer_len(buffer)
    needle :: byte_buffer_data(separator)
    found := I64{-1}
    at := I64{0}
    loop found < (I64{0}) && at + width <= length {
        matched := true
        offset := I64{0}
        loop matched && offset < width {
            if (host_u8_get(data, at + offset) != host_u8_get(needle, offset)) -> matched = false
            offset += I64{1}
        }
        if matched -> found = at
        at += I64{1}
    }
    parts :: jet_rt_alloc(I64{24}, I64{8})
    if (found < I64{0}) {
        data_tree_store(parts, jet_rt_handle_clone_jet_byte_buffer(buffer))
        data_tree_store(wrapping(parts + I64{8}), jet_byte_buffer_new())
        data_tree_store(wrapping(parts + I64{16}), jet_byte_buffer_new())
    } else {
        data_tree_store(parts, byte_buffer_of(data, found, I64{0}))
        data_tree_store(wrapping(parts + I64{8}), jet_rt_handle_clone_jet_byte_buffer(separator))
        data_tree_store(wrapping(parts + I64{16}), byte_buffer_of(wrapping(data + (found + width) * RT_HOST_U8_STRIDE), length - found - width, I64{0}))
    }
    data_tree_store(data_out, parts)
    data_tree_store(len_out, I64{3})
    I64{1}
}

#Export(c) fn jet_byte_buffer_equal(buffer: I64, other: I64) -> Bool { byte_buffer_order(buffer, other) == I64{0} }
#Export(c) fn jet_byte_buffer_compare(buffer: I64, other: I64) -> I64 { jet_int_owned_from_i64(byte_buffer_order(buffer, other)) }

#Export(c) fn jet_byte_buffer_copy_to(buffer: I64, other: I64) { byte_buffer_assign(other, buffer) }
#Export(c) fn jet_byte_buffer_write_to(buffer: I64, other: I64) { byte_buffer_put_bytes(other, byte_buffer_data(buffer), byte_buffer_len(buffer)) }

// i64::from_str over the trimmed lossy reading, with Rust's error texts.
#Export(c) fn jet_byte_buffer_parse(buffer: I64, ok: I64, err: I64) -> I64 {
    shown :: byte_buffer_text(buffer)
    text :: rt_text_trim(shown)
    jet_rt_string_drop(shown)
    data :: rt_text_data(text)
    length :: rt_text_len(text)
    if (length == I64{0}) {
        jet_rt_string_drop(text)
        data_tree_store(err, rt_static_text("cannot parse integer from empty string"))
        return I64{0}
    }
    first :: rt_text_byte(data)
    negative :: first == I64{45}
    at := if (first == I64{43} || negative) -> I64{1} else -> I64{0}
    if (at == length) {
        jet_rt_string_drop(text)
        data_tree_store(err, rt_static_text("invalid digit found in string"))
        return I64{0}
    }
    // Accumulate toward the negative side so I64.MIN parses.
    value := I64{0}
    overflow := false
    loop at < length {
        digit :: rt_text_byte(wrapping(data + at)) - I64{48}
        if (digit < I64{0} || digit > I64{9}) {
            jet_rt_string_drop(text)
            data_tree_store(err, rt_static_text("invalid digit found in string"))
            return I64{0}
        }
        if !overflow {
            if (value < I64{-922337203685477580} || (value == I64{-922337203685477580} && digit > I64{8})) {
                overflow = true
            } else {
                value = value * I64{10} - digit
            }
        }
        at += I64{1}
    }
    jet_rt_string_drop(text)
    if (!negative && !overflow && value == I64{-9223372036854775807} - I64{1}) -> overflow = true
    if overflow {
        data_tree_store(err, if negative -> rt_static_text("number too small to fit in target type") else -> rt_static_text("number too large to fit in target type"))
        return I64{0}
    }
    data_tree_store(ok, jet_int_owned_from_i64(if negative -> value else -> I64{0} - value))
    I64{1}
}

#Export(c) fn jet_byte_buffer_write_bytes(buffer: I64, data: I64, length: I64) { byte_buffer_put_bytes(buffer, data, length) }
#Export(c) fn jet_byte_buffer_write(buffer: I64, data: I64, length: I64) { byte_buffer_put_bytes(buffer, data, length) }
#Export(c) fn jet_byte_buffer_write_u8(buffer: I64, value: I64) { byte_buffer_put_word(buffer, byte_buffer_bits(value), I64{1}, true) }
#Export(c) fn jet_byte_buffer_write_byte(buffer: I64, value: I64) { byte_buffer_put_word(buffer, byte_buffer_bits(value), I64{1}, true) }
#Export(c) fn jet_byte_buffer_write_i8(buffer: I64, value: I64) { byte_buffer_put_word(buffer, byte_buffer_bits(value), I64{1}, true) }
#Export(c) fn jet_byte_buffer_write_u16_le(buffer: I64, value: I64) { byte_buffer_put_word(buffer, byte_buffer_bits(value), I64{2}, true) }
#Export(c) fn jet_byte_buffer_write_u16_be(buffer: I64, value: I64) { byte_buffer_put_word(buffer, byte_buffer_bits(value), I64{2}, false) }
#Export(c) fn jet_byte_buffer_write_i16_le(buffer: I64, value: I64) { byte_buffer_put_word(buffer, byte_buffer_bits(value), I64{2}, true) }
#Export(c) fn jet_byte_buffer_write_i16_be(buffer: I64, value: I64) { byte_buffer_put_word(buffer, byte_buffer_bits(value), I64{2}, false) }
#Export(c) fn jet_byte_buffer_write_u32_le(buffer: I64, value: I64) { byte_buffer_put_word(buffer, byte_buffer_bits(value), I64{4}, true) }
#Export(c) fn jet_byte_buffer_write_u32_be(buffer: I64, value: I64) { byte_buffer_put_word(buffer, byte_buffer_bits(value), I64{4}, false) }
#Export(c) fn jet_byte_buffer_write_i32_le(buffer: I64, value: I64) { byte_buffer_put_word(buffer, byte_buffer_bits(value), I64{4}, true) }
#Export(c) fn jet_byte_buffer_write_i32_be(buffer: I64, value: I64) { byte_buffer_put_word(buffer, byte_buffer_bits(value), I64{4}, false) }
#Export(c) fn jet_byte_buffer_write_u64_le(buffer: I64, value: I64) { byte_buffer_put_word(buffer, byte_buffer_bits(value), I64{8}, true) }
#Export(c) fn jet_byte_buffer_write_u64_be(buffer: I64, value: I64) { byte_buffer_put_word(buffer, byte_buffer_bits(value), I64{8}, false) }
#Export(c) fn jet_byte_buffer_write_i64_le(buffer: I64, value: I64) { byte_buffer_put_word(buffer, byte_buffer_bits(value), I64{8}, true) }
#Export(c) fn jet_byte_buffer_write_i64_be(buffer: I64, value: I64) { byte_buffer_put_word(buffer, byte_buffer_bits(value), I64{8}, false) }
#Export(c) fn jet_byte_buffer_write_f32_le(buffer: I64, value: Float) { byte_buffer_put_word(buffer, byte_buffer_f32_bits(value), I64{4}, true) }
#Export(c) fn jet_byte_buffer_write_f32_be(buffer: I64, value: Float) { byte_buffer_put_word(buffer, byte_buffer_f32_bits(value), I64{4}, false) }
#Export(c) fn jet_byte_buffer_write_f64_le(buffer: I64, value: Float) { byte_buffer_put_word(buffer, rt_f64_bits(value), I64{8}, true) }
#Export(c) fn jet_byte_buffer_write_f64_be(buffer: I64, value: Float) { byte_buffer_put_word(buffer, rt_f64_bits(value), I64{8}, false) }
