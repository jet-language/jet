        if (net_word(scratch, I64{8}) != I64{0}) -> break
    }
    code :: net_word(scratch, I64{8})
    jet_rt_free(scratch, I64{32}, I64{8})
    if (jet_scheduler_native_propagate() != I64{0}) -> return I64{0}
    if (state == I64{0}) -> return net_route_errno(operation, I64{0}, code, error)
    net_put(output, I64{0}, jet_socket_stream_from_fd_raw(state))
    I64{1}
}
fn net_route_connect_start(address: I64, scratch: I64) -> I64 {
    state :: jet_socket_create_raw(net_word(address, I64{0}), I64{1}, I64{0}, scratch)
    if (state == I64{0}) -> return I64{0}
    result :: jet_socket_connect_raw(state, address, scratch)
    if (result < I64{0} && net_word(scratch, I64{8}) != I64{115}) {
        jet_fd_drop_raw(state)
        return I64{0}
    }
    state
}
fn net_route_connect_one(address: I64, output: I64, error: I64) -> I64 {
    operation :: rt_static_text("tcp connect")
    if (jet_deadline_remaining_ms() <= I64{0}) -> return net_route_timeout(operation, error)
    scratch :: jet_rt_alloc(I64{40}, I64{8})
    thread_zero(scratch, I64{40})
    state :: net_route_connect_start(address, scratch)
    if (state != I64{0} && net_word(scratch, I64{8}) == I64{115}) {
        _ := jet_socket_ready_raw(state, I64{4}, I64{-1}, scratch)
        if net_route_wait_stop(operation, error) {
            jet_fd_drop_raw(state)
            jet_rt_free(scratch, I64{40}, I64{8})
            return I64{0}
        }
        if (net_word(scratch, I64{8}) == I64{0}) {
            if (jet_socket_option_get_raw(state, I64{1}, I64{4}, scratch + I64{32}, scratch) >= I64{0}) -> net_put(scratch, I64{8}, net_word(scratch, I64{32}))
        }
    }
    code :: net_word(scratch, I64{8})
    jet_rt_free(scratch, I64{40}, I64{8})
    if (jet_scheduler_native_propagate() != I64{0}) {
        if (state != I64{0}) -> jet_fd_drop_raw(state)
        return I64{0}
    }
    if (state == I64{0} || code != I64{0}) {
        if (state != I64{0}) -> jet_fd_drop_raw(state)
        text :: net_route_socket_text(address)
        result :: net_route_errno(operation, text, code, error)
        jet_rt_string_drop(text)
        return result
    }
    net_put(output, I64{0}, jet_socket_stream_from_fd_raw(state))
    I64{1}
}
#Export(c) fn jet_net_tcp_connect_addr(address: I64, output: I64, error: I64) -> I64 {
    jet_rt_world_reject_uncontrolled(I64{1})
    if (jet_scheduler_native_propagate() != I64{0}) -> return I64{0}
    net_route_connect_one(address, output, error)
