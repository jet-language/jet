// Native providers for Core.net's private TCP leaves. Stream56/Listener8 own
// FD72, Socket56 is borrowed, and error results own the canonical NetError
// carrier. NetHTTP.rs is the semantic source; no Rust Box/std socket layout is
// read here. Nonblocking syscalls use HostSockets and the shared native poller.
#Import(c) fn net_route_inet_pton(family: I64, text: I64, output: I64) -> I64 = "inet_pton"

fn net_route_detail_take(operation: I64, address: I64, message: I64, code: I64) -> I64 {
    value :: jet_rt_alloc(NET_DETAIL_BYTES, I64{8})
    net_put(value, NET_DETAIL_OPERATION, jet_rt_string_clone(operation))
    net_put(value, NET_DETAIL_ADDRESS, net_optional_text_clone(address))
    net_put(value, NET_DETAIL_NAME, I64{0})
    net_put(value, NET_DETAIL_MESSAGE, message)
    net_put(value, NET_DETAIL_OS_PRESENT, if (code != I64{0}) -> I64{1} else -> I64{0})
    net_put(value, NET_DETAIL_OS_CODE, code)
    value
}
fn net_route_fail_take(kind: I64, operation: I64, address: I64, message: I64, code: I64, error: I64) -> I64 {
    net_put(error, I64{0}, net_error_new(kind, net_route_detail_take(operation, address, message, code)))
    I64{0}
}
fn net_route_message(operation: I64, suffix: I64) -> I64 {
    text :: jet_rt_string_builder_new()
    jet_rt_string_builder_push(text, operation)
    jet_rt_string_builder_push(text, suffix)
    jet_rt_string_builder_finish(text)
}
fn net_route_errno_kind(code: I64) -> I64 {
    if {
        (code == I64{22} || code == I64{84}) -> NET_ERROR_INVALID_INPUT
        (code == I64{1} || code == I64{13}) -> NET_ERROR_PERMISSION_DENIED
        (code == I64{98}) -> NET_ERROR_ADDRESS_IN_USE
        (code == I64{99}) -> NET_ERROR_ADDRESS_UNAVAILABLE
        (code == I64{111}) -> NET_ERROR_CONNECTION_REFUSED
        (code == I64{32} || code == I64{103} || code == I64{104}) -> NET_ERROR_CONNECTION_RESET
        (code == I64{107}) -> NET_ERROR_NOT_CONNECTED
        (code == I64{11} || code == I64{110}) -> NET_ERROR_TIMEOUT
        (code == I64{38} || code == I64{95}) -> NET_ERROR_UNSUPPORTED
        else -> NET_ERROR_OTHER
    }
}
fn net_route_errno(operation: I64, address: I64, code: I64, error: I64) -> I64 {
    text :: jet_rt_string_builder_new()
    jet_rt_string_builder_push(text, operation)
    jet_rt_string_builder_push(text, rt_static_text(" failed: "))
    host_errno_cause_append(text, code)
    net_route_fail_take(net_route_errno_kind(code), operation, address, jet_rt_string_builder_finish(text), code, error)
}
fn net_route_timeout(operation: I64, error: I64) -> I64 {
    text :: jet_rt_string_builder_new()
    jet_rt_string_builder_push(text, rt_static_text("deadline exceeded while waiting in "))
    jet_rt_string_builder_push(text, operation)
    net_route_fail_take(NET_ERROR_TIMEOUT, operation, I64{0}, jet_rt_string_builder_finish(text), I64{0}, error)
}
// Match the seed's network wait boundary; non-wait control defects retain
// their native propagation rail.
fn net_route_wait_stop(operation: I64, error: I64) -> Bool {
    if (jet_scheduler_native_propagate() == I64{0}) -> return false
    control :: scheduler_control_current()
    kind :: scheduler_control_status(control)
    if (kind != I64{1} && kind != I64{2} && kind != I64{5}) -> return true
    taken :: scheduler_control_take_stop(control)
    if (kind == I64{2}) {
        _ := net_route_timeout(operation, error)
    } else if (kind == I64{1}) {
        _ := net_route_fail_take(NET_ERROR_CANCELLED, operation, I64{0}, net_route_message(operation, rt_static_text(" cancelled")), I64{0}, error)
    } else {
        text :: jet_rt_string_builder_new()
        jet_rt_string_builder_push(text, operation)
        jet_rt_string_builder_push(text, rt_static_text(" scheduler wait failed: "))
        jet_rt_string_builder_push(text, net_word(taken, I64{40}))
        _ := net_route_fail_take(NET_ERROR_OTHER, operation, I64{0}, jet_rt_string_builder_finish(text), I64{0}, error)
    }
    scheduler_stop_drop(taken)
    true
}
fn net_route_socket_text(address: I64) -> I64 {
    text :: jet_rt_string_builder_new()
    ipv6 :: net_word(address, I64{0}) == I64{6}
    if ipv6 -> jet_rt_string_builder_push(text, rt_static_text("["))
    ip_show_into(text, address)
    if (ipv6 && net_word(address, I64{40}) != I64{0}) {
        jet_rt_string_builder_push(text, rt_static_text("%"))
        rt_text_push_number(text, net_word(address, I64{40}))
    }
    if ipv6 -> jet_rt_string_builder_push(text, rt_static_text("]"))
    jet_rt_string_builder_push(text, rt_static_text(":"))
    rt_text_push_number(text, net_word(address, I64{24}))
    jet_rt_string_builder_finish(text)
}
fn net_route_deadline_push(milliseconds: I64, save: I64) {
    now :: jet_std_time_now()
    configured :: if (now > I64{9223372036854775807} - milliseconds) -> I64{9223372036854775807} else -> now + milliseconds
    deadline :: if (jet_ctx_deadline_present() && jet_ctx_deadline_ms() < configured) -> jet_ctx_deadline_ms() else -> configured
    jet_ctx_push_deadline(deadline, save)
}
fn net_route_numeric(host: I64, port: I64, rows: I64, length: I64) -> Bool {
    size :: rt_text_len(host)
    scope_at := size
    scope := I64{0}
    at := I64{0}
    loop at < size {
        if (rt_text_byte(rt_text_data(host) + at) == I64{0}) -> return false
        if (rt_text_byte(rt_text_data(host) + at) == I64{37}) -> scope_at = at
        at += I64{1}
    }
    if (scope_at < size) {
        at = scope_at + I64{1}
        if (at == size) -> return false
        loop at < size {
            byte :: rt_text_byte(rt_text_data(host) + at)
            if (byte < I64{48} || byte > I64{57}) -> return false
            scope = scope * I64{10} + byte - I64{48}
            if (scope > I64{4294967295}) -> return false
            at += I64{1}
        }
    }
    name :: fd_c_path(host)
    if (scope_at < size) {
        #Unsafe("the owned terminated host copy truncates at its validated scope suffix") { os_store_u8(name + scope_at, I64{0}) }
    }
    address :: jet_rt_alloc(I64{56}, I64{8})
    thread_zero(address, I64{56})
    family := I64{0}
    if (scope_at == size && net_i32(net_route_inet_pton(I64{2}, name, address + I64{8})) == I64{1}) {
        family = I64{4}
    } else if (net_i32(net_route_inet_pton(I64{10}, name, address + I64{8})) == I64{1}) {
        family = I64{6}
    }
    fd_c_path_drop(name, host)
    if (family == I64{0}) {
        jet_rt_free(address, I64{56}, I64{8})
        return false
    }
    net_put(address, I64{0}, family)
    net_put(address, I64{24}, port)
    net_put(address, I64{40}, scope)
    net_put(rows, I64{0}, address)
    net_put(length, I64{0}, I64{1})
    true
}
fn net_route_resolve(host: I64, port: I64, operation: I64, wait_operation: I64, address: I64, rows: I64, length: I64, error: I64) -> I64 {
    if net_route_numeric(host, port, rows, length) -> return I64{1}
    scratch :: jet_rt_alloc(I64{8}, I64{8})
    net_put(scratch, I64{0}, I64{0})
    result :: jet_net_raw_resolve_ordered(host, port, rows, length, scratch)
    if (result == I64{0}) {
        if !net_route_wait_stop(wait_operation, error) {
            failure :: net_word(scratch, I64{0})
            if (failure != I64{0}) {
                kind :: host_native_int(net_word(failure, I64{0}))
                ordinal :: if {
                    (kind == I64{1}) -> NET_ERROR_INVALID_INPUT
                    (kind == I64{2}) -> NET_ERROR_PERMISSION_DENIED
                    (kind == I64{3}) -> NET_ERROR_ADDRESS_IN_USE
                    (kind == I64{4}) -> NET_ERROR_ADDRESS_UNAVAILABLE
                    (kind == I64{5}) -> NET_ERROR_CONNECTION_REFUSED
                    (kind == I64{6}) -> NET_ERROR_CONNECTION_RESET
                    (kind == I64{7}) -> NET_ERROR_NOT_CONNECTED
                    (kind == I64{8}) -> NET_ERROR_TIMEOUT
                    (kind == I64{9}) -> NET_ERROR_UNSUPPORTED
                    else -> NET_ERROR_OTHER
                }
                text :: jet_rt_string_builder_new()
                jet_rt_string_builder_push(text, operation)
                jet_rt_string_builder_push(text, rt_static_text(" failed: "))
                jet_rt_string_builder_push(text, net_word(failure, I64{24}))
                code :: if (net_word(failure, I64{8}) != I64{0}) -> host_native_int(net_word(failure, I64{16})) else -> I64{0}
                _ := net_route_fail_take(ordinal, operation, address, jet_rt_string_builder_finish(text), code, error)
                jet_rt_handle_drop_jet_resolve_error(failure)
            }
        }
    }
    jet_rt_free(scratch, I64{8}, I64{8})
    result
}
// ToSocketAddrs' string form splits a host and an unsigned decimal port;
// Brackets are stripped only for the numeric IPv6 SocketAddr fast path.
fn net_route_resolve_text(address: I64, operation: I64, rows: I64, length: I64, error: I64) -> I64 {
    size :: rt_text_len(address)
    split := size
    at := size
    loop at > (I64{0}) {
        at -= I64{1}
        if (rt_text_byte(rt_text_data(address) + at) == I64{58}) {
            split = at
            break
        }
    }
    port := I64{0}
    if (split == size) -> return net_route_fail_take(NET_ERROR_INVALID_INPUT, operation, address, net_route_message(operation, rt_static_text(" failed: invalid socket address")), I64{0}, error)
    valid := split + I64{1} < size
    at = split + I64{1}
    if (valid && rt_text_byte(rt_text_data(address) + at) == I64{43}) -> at += I64{1}
    if (at == size) -> valid = false
    loop valid && at < size {
        byte :: rt_text_byte(rt_text_data(address) + at)
        if (byte < I64{48} || byte > I64{57}) {
            valid = false
            break
        }
        port = port * I64{10} + byte - I64{48}
        if (port > I64{65535}) {
            valid = false
            break
        }
        at += I64{1}
    }
    if !valid -> return net_route_fail_take(NET_ERROR_INVALID_INPUT, operation, address, net_route_message(operation, rt_static_text(" failed: invalid port value")), I64{0}, error)
    if (split >= I64{2} && rt_text_byte(rt_text_data(address)) == I64{91} && rt_text_byte(rt_text_data(address) + split - I64{1}) == I64{93}
        && rt_text_byte(rt_text_data(address) + split + I64{1}) != I64{43}) {
        host :: rt_text_copy(rt_text_data(address) + I64{1}, split - I64{2})
        if net_route_numeric(host, port, rows, length) {
            if (net_word(net_word(rows, I64{0}), I64{0}) == I64{6}) {
                jet_rt_string_drop(host)
                return I64{1}
            }
            jet_rt_free(net_word(rows, I64{0}), I64{56}, I64{8})
            net_put(rows, I64{0}, I64{0})
            net_put(length, I64{0}, I64{0})
        }
        jet_rt_string_drop(host)
    }
    host :: rt_text_copy(rt_text_data(address), split)
    result :: net_route_resolve(host, port, operation, operation, address, rows, length, error)
    jet_rt_string_drop(host)
    result
}
fn net_route_listen_one(address: I64, scratch: I64) -> I64 {
    state :: jet_socket_create_raw(net_word(address, I64{0}), I64{1}, I64{0}, scratch)
    if (state == I64{0}) -> return I64{0}
    if (jet_socket_option_set_raw(state, I64{1}, I64{2}, I64{1}, scratch) < I64{0}
        || jet_socket_bind_raw(state, address, scratch) < I64{0}
        || jet_socket_listen_raw(state, I64{128}, scratch) < I64{0}) {
        jet_fd_drop_raw(state)
        return I64{0}
    }
    state
}
#Export(c) fn jet_net_tcp_listen_addr(address: I64, output: I64, error: I64) -> I64 {
    jet_rt_world_reject_uncontrolled(I64{1})
    if (jet_scheduler_native_propagate() != I64{0}) -> return I64{0}
    scratch :: jet_rt_alloc(I64{32}, I64{8})
    thread_zero(scratch, I64{32})
    state :: net_route_listen_one(address, scratch)
    code :: net_word(scratch, I64{8})
    jet_rt_free(scratch, I64{32}, I64{8})
    if (state == I64{0}) {
        if (jet_scheduler_native_propagate() != I64{0}) -> return I64{0}
        text :: net_route_socket_text(address)
        result :: net_route_errno(rt_static_text("tcp listen"), text, code, error)
        jet_rt_string_drop(text)
        return result
    }
    net_put(output, I64{0}, jet_socket_listener_from_fd_raw(state))
    I64{1}
}
#Export(c) fn jet_net_tcp_listen(address: I64, output: I64, error: I64) -> I64 {
    jet_rt_world_reject_uncontrolled(I64{1})
    if (jet_scheduler_native_propagate() != I64{0}) -> return I64{0}
    scratch :: jet_rt_alloc(I64{48}, I64{8})
    thread_zero(scratch, I64{48})
    operation :: rt_static_text("tcp listen")
    resolved :: net_route_resolve_text(address, operation, scratch, scratch + I64{8}, error)
    if (resolved == I64{0}) {
        jet_rt_free(scratch, I64{48}, I64{8})
        return I64{0}
    }
    rows :: net_word(scratch, I64{0})
    count :: net_word(scratch, I64{8})
    state := I64{0}
    at := I64{0}
    loop at < count {
        state = net_route_listen_one(rows + at * I64{56}, scratch + I64{16})
        if (state != I64{0} || jet_scheduler_native_propagate() != I64{0}) -> break
        at += I64{1}
    }
    if (rows != I64{0}) -> jet_rt_free(rows, count * I64{56}, I64{8})
    code :: net_word(scratch, I64{24})
    jet_rt_free(scratch, I64{48}, I64{8})
    if (jet_scheduler_native_propagate() != I64{0}) -> return I64{0}
    if (state == I64{0}) {
        if (count == I64{0}) -> return net_route_fail_take(NET_ERROR_INVALID_INPUT, operation, address, net_route_message(operation, rt_static_text(" failed: could not resolve to any addresses")), I64{0}, error)
        return net_route_errno(operation, address, code, error)
    }
    net_put(output, I64{0}, jet_socket_listener_from_fd_raw(state))
    I64{1}
}
#Export(c) fn jet_net_tcp_accept(listener: I64, output: I64, error: I64) -> I64 {
    jet_rt_world_reject_uncontrolled(I64{1})
    if (jet_scheduler_native_propagate() != I64{0}) -> return I64{0}
    scratch :: jet_rt_alloc(I64{32}, I64{8})
    thread_zero(scratch, I64{32})
    operation :: rt_static_text("tcp accept")
    state := I64{0}
    loop {
        state = jet_socket_accept_raw(jet_socket_listener_fd_raw(listener), I64{0}, scratch)
        if (state != I64{0}) -> break
        code :: net_word(scratch, I64{8})
        if (code != I64{11} && code != I64{4}) -> break
        _ := jet_socket_ready_raw(jet_socket_listener_fd_raw(listener), I64{1}, I64{-1}, scratch)
        if net_route_wait_stop(operation, error) {
