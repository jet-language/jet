fn net_route_stream_open(stream: I64, operation: I64, error: I64) -> Bool {
    if ((jet_socket_stream_flags_raw(stream).bit_and(I64{1})) == I64{0}) -> return true
    _ := net_route_fail_take(NET_ERROR_CLOSED, operation, I64{0}, net_route_message(operation, rt_static_text(" failed: socket is closed")), I64{0}, error)
    false
}
fn net_route_option_get(stream: I64, operation: I64, level: I64, option: I64, output: I64, flag: Bool, error: I64) -> I64 {
    if !net_route_stream_open(stream, operation, error) -> return I64{0}
    scratch :: jet_rt_alloc(I64{40}, I64{8})
    thread_zero(scratch, I64{40})
    result :: jet_socket_option_get_raw(jet_socket_stream_fd_raw(stream), level, option, scratch + I64{32}, scratch)
    code :: net_word(scratch, I64{8})
    value :: net_word(scratch, I64{32})
    jet_rt_free(scratch, I64{40}, I64{8})
    if (result < I64{0}) -> return net_route_errno(operation, I64{0}, code, error)
    if flag {
        #Unsafe("output lends the C ABI bool result byte, not an eight-byte word") { os_store_u8(output, if (value != I64{0}) -> I64{1} else -> I64{0}) }
    } else { net_put(output, I64{0}, value) }
    I64{1}
}
fn net_route_option_set(stream: I64, operation: I64, level: I64, option: I64, value: I64, error: I64) -> I64 {
    if !net_route_stream_open(stream, operation, error) -> return I64{0}
    scratch :: jet_rt_alloc(I64{32}, I64{8})
    thread_zero(scratch, I64{32})
    result :: jet_socket_option_set_raw(jet_socket_stream_fd_raw(stream), level, option, value, scratch)
    code :: net_word(scratch, I64{8})
    jet_rt_free(scratch, I64{32}, I64{8})
    if (result < I64{0}) -> net_route_errno(operation, I64{0}, code, error) else -> I64{1}
}
#Export(c) fn jet_net_nodelay(stream: I64, output: I64, error: I64) -> I64 { net_route_option_get(stream, rt_static_text("tcp nodelay"), I64{6}, I64{1}, output, true, error) }
#Export(c) fn jet_net_set_nodelay(stream: I64, enabled: Bool, error: I64) -> I64 { net_route_option_set(stream, rt_static_text("set tcp nodelay"), I64{6}, I64{1}, if enabled -> I64{1} else -> I64{0}, error) }
#Export(c) fn jet_net_ttl(stream: I64, output: I64, error: I64) -> I64 { net_route_option_get(stream, rt_static_text("tcp ttl"), I64{0}, I64{2}, output, false, error) }
#Export(c) fn jet_net_set_ttl(stream: I64, ttl: I64, error: I64) -> I64 {
    operation :: rt_static_text("set tcp ttl")
    if !net_route_stream_open(stream, operation, error) -> return I64{0}
    value :: ttl
    if (value < I64{0} || value > I64{4294967295}) -> return net_route_fail_take(NET_ERROR_INVALID_INPUT, operation, I64{0}, jet_rt_string_clone(rt_static_text("ttl must fit u32")), I64{0}, error)
    net_route_option_set(stream, operation, I64{0}, I64{2}, value, error)
}
fn net_route_set_timeout(stream: I64, milliseconds: I64, directions: I64, operation: I64, error: I64) -> I64 {
    if (milliseconds < I64{0}) -> return net_route_fail_take(NET_ERROR_INVALID_INPUT, operation, I64{0}, jet_rt_string_clone(rt_static_text("network timeout must be non-negative")), I64{0}, error)
    mutex :: wrapping(stream + I64{48})
    sync_mutex_lock(mutex)
    if (directions.bit_and(I64{1}) != I64{0}) -> net_put(stream, I64{32}, milliseconds)
    if (directions.bit_and(I64{2}) != I64{0}) -> net_put(stream, I64{40}, milliseconds)
    sync_mutex_unlock(mutex)
    I64{1}
}
#Export(c) fn jet_net_set_timeout(stream: I64, milliseconds: I64, error: I64) -> I64 { net_route_set_timeout(stream, milliseconds, I64{3}, rt_static_text("set tcp timeout"), error) }
#Export(c) fn jet_net_set_read_timeout(stream: I64, milliseconds: I64, error: I64) -> I64 { net_route_set_timeout(stream, milliseconds, I64{1}, rt_static_text("set tcp read timeout"), error) }
#Export(c) fn jet_net_set_write_timeout(stream: I64, milliseconds: I64, error: I64) -> I64 { net_route_set_timeout(stream, milliseconds, I64{2}, rt_static_text("set tcp write timeout"), error) }
fn net_route_socket_address(holder: I64, listener: Bool, peer: Bool, output: I64, error: I64) -> I64 {
    operation :: if listener -> rt_static_text("tcp listener local address") else if peer -> rt_static_text("tcp peer address") else -> rt_static_text("tcp local address")
    scratch :: jet_rt_alloc(I64{32}, I64{8})
    thread_zero(scratch, I64{32})
    address :: jet_rt_alloc(I64{56}, I64{8})
    state :: if listener -> jet_socket_listener_fd_raw(holder) else -> jet_socket_stream_fd_raw(holder)
    // Logical close keeps the descriptor alive. Rust's address getters still
    // query that descriptor, unlike read/write/option operations.
    fd_lock(state)
    facts :: jet_rt_alloc(I64{128}, I64{8})
    size :: facts + I64{32}
    net_store_uint(size, I64{4}, I64{32})
    result := host_call(if peer -> I64{52} else -> I64{51}, fd_word(state, I64{8}), facts, size)
    if (result >= I64{0} && !net_socket_decode(facts, net_load_uint(size, I64{4}), address)) -> result = I64{-22}
    jet_rt_free(facts, I64{128}, I64{8})
    fd_unlock(state)
    _ := fd_error(result, scratch)
    code :: net_word(scratch, I64{8})
    jet_rt_free(scratch, I64{32}, I64{8})
    if (result < I64{0}) {
        jet_rt_free(address, I64{56}, I64{8})
        return net_route_errno(operation, I64{0}, code, error)
    }
    net_put(output, I64{0}, address)
    I64{1}
}
#Export(c) fn jet_net_listener_local_socket_addr(listener: I64, output: I64, error: I64) -> I64 { net_route_socket_address(listener, true, false, output, error) }
#Export(c) fn jet_net_tcp_local_socket_addr(stream: I64, output: I64, error: I64) -> I64 { net_route_socket_address(stream, false, false, output, error) }
#Export(c) fn jet_net_tcp_peer_socket_addr(stream: I64, output: I64, error: I64) -> I64 { net_route_socket_address(stream, false, true, output, error) }

// The same 250ms family-interleaved race as NetHTTP, using owned nonblocking
// descriptors instead of one blocking OS thread per connection attempt.
fn net_route_happy_race(rows: I64, count: I64, output: I64, error: I64) -> I64 {
    order :: jet_rt_alloc(count * I64{8}, I64{8})
    states :: jet_rt_alloc(count * I64{8}, I64{8})
    thread_zero(states, count * I64{8})
    first :: net_word(rows, I64{0})
    v4 := I64{0}
    v6 := I64{0}
    at := I64{0}
    loop at < count {
        loop v4 < count && net_word(rows + v4 * I64{56}, I64{0}) != (I64{4}) { v4 += I64{1} }
        loop v6 < count && net_word(rows + v6 * I64{56}, I64{0}) != (I64{6}) { v6 += I64{1} }
        want_v6 :: if (at % I64{2} == I64{0}) -> first == I64{6} else -> first != I64{6}
        index := I64{0}
        if ((want_v6 && v6 < count) || v4 == count) {
            index = v6
            v6 += I64{1}
        } else {
            index = v4
            v4 += I64{1}
        }
        net_put(order, at * I64{8}, index)
        at += I64{1}
    }
    scratch :: jet_rt_alloc(I64{48}, I64{8})
    thread_zero(scratch, I64{48})
    park :: sync_park_new()
    operation :: rt_static_text("tcp connect")
    next := I64{0}
    live := I64{0}
    last_address := rows
    last_code := I64{0}
    launch := sync_now_ns()
    winner := I64{0}
    stopped := false
    loop {
        if (jet_deadline_remaining_ms() <= I64{0}) {
            _ := net_route_timeout(operation, error)
            stopped = true
            break
        }
        if (next < count && sync_now_ns() >= launch) {
            address :: rows + net_word(order, next * I64{8}) * I64{56}
            net_put(scratch, I64{0}, I64{0})
            state :: net_route_connect_start(address, scratch)
            code :: net_word(scratch, I64{8})
            if (state == I64{0}) {
                last_address = address
                last_code = code
                launch = sync_now_ns()
            } else if (code == I64{0}) {
                winner = state
                break
            } else {
                net_put(states, next * I64{8}, state)
                live += I64{1}
                now :: sync_now_ns()
                launch = if (now > I64{9223372036604775807}) -> I64{9223372036854775807} else -> now + I64{250000000}
            }
            next += I64{1}
        }
        at = I64{0}
        loop at < next {
            state :: net_word(states, at * I64{8})
            if (state != I64{0}) {
                // pollfd is int fd, short events, short revents. The race owns
                // every descriptor exclusively until it chooses a winner.
                net_store_uint(scratch + I64{40}, I64{4}, fd_word(state, I64{8}))
                net_store_uint(scratch + I64{44}, I64{2}, I64{4})
                net_store_uint(scratch + I64{46}, I64{2}, I64{0})
                polled :: host_call(I64{7}, scratch + I64{40}, I64{1}, I64{0})
                if (polled > I64{0} || (polled < I64{0} && polled != I64{-4})) {
                    net_put(scratch, I64{8}, I64{0})
                    if (polled < I64{0}) {
                        net_put(scratch, I64{8}, -polled)
                    } else if (jet_socket_option_get_raw(state, I64{1}, I64{4}, scratch + I64{32}, scratch) >= I64{0}) {
                        net_put(scratch, I64{8}, net_word(scratch, I64{32}))
                    }
                    code :: net_word(scratch, I64{8})
                    net_put(states, at * I64{8}, I64{0})
                    live -= I64{1}
                    if (code == I64{0}) {
                        winner = state
                        break
                    }
                    jet_fd_drop_raw(state)
                    last_address = rows + net_word(order, at * I64{8}) * I64{56}
                    last_code = code
                    launch = sync_now_ns()
                }
            }
            at += I64{1}
        }
        if (winner != I64{0} || jet_scheduler_native_propagate() != I64{0} || (next == count && live == I64{0})) -> break
        _ := scheduler_yield(rt_static_text("network wait"), park, I64{5000000})
        if net_route_wait_stop(operation, error) {
            stopped = true
            break
        }
    }
    at = I64{0}
    loop at < count {
        state :: net_word(states, at * I64{8})
        if (state != I64{0}) -> jet_fd_drop_raw(state)
        at += I64{1}
    }
    sync_park_drop(park)
    jet_rt_free(scratch, I64{48}, I64{8})
    jet_rt_free(states, count * I64{8}, I64{8})
    jet_rt_free(order, count * I64{8}, I64{8})
    if (winner != I64{0}) {
        net_put(output, I64{0}, jet_socket_stream_from_fd_raw(winner))
        return I64{1}
    }
    if (stopped || jet_scheduler_native_propagate() != I64{0}) -> return I64{0}
    address :: net_route_socket_text(last_address)
    result :: net_route_errno(operation, address, last_code, error)
    jet_rt_string_drop(address)
    result
}
#Export(c) fn jet_net_tcp_connect_happy(host: I64, port: I64, milliseconds: I64, output: I64, error: I64) -> I64 {
    jet_rt_world_reject_uncontrolled(I64{1})
    if (jet_scheduler_native_propagate() != I64{0}) -> return I64{0}
    operation :: rt_static_text("tcp connect")
    if (port < I64{0} || port > I64{65535}) {
        text :: jet_rt_string_builder_new()
        jet_rt_string_builder_push(text, rt_static_text("invalid port `"))
        rt_text_push_number(text, port)
        jet_rt_string_builder_push(text, rt_static_text("`: expected 0..65535"))
        return net_route_fail_take(NET_ERROR_INVALID_INPUT, operation, host, jet_rt_string_builder_finish(text), I64{0}, error)
    }
    if (milliseconds < I64{0}) -> return net_route_fail_take(NET_ERROR_INVALID_INPUT, operation, host, jet_rt_string_clone(rt_static_text("network timeout must be non-negative")), I64{0}, error)
    scratch :: jet_rt_alloc(I64{32}, I64{8})
    thread_zero(scratch, I64{32})
    net_route_deadline_push(milliseconds, scratch + I64{16})
    result := I64{0}
    if (jet_deadline_remaining_ms() <= I64{0}) {
        result = net_route_timeout(operation, error)
    } else if (net_route_resolve(host, port, rt_static_text("resolve socket address"), operation, host, scratch, scratch + I64{8}, error) != I64{0}) {
        rows :: net_word(scratch, I64{0})
        count :: net_word(scratch, I64{8})
        if (count == I64{0}) {
            text :: jet_rt_string_builder_new()
            jet_rt_string_builder_push(text, rt_static_text("tcp connect failed: no address for `"))
            jet_rt_string_builder_push(text, host)
            jet_rt_string_builder_push(text, rt_static_text("`"))
            result = net_route_fail_take(NET_ERROR_ADDRESS_UNAVAILABLE, operation, host, jet_rt_string_builder_finish(text), I64{0}, error)
        } else { result = net_route_happy_race(rows, count, output, error) }
        if (rows != I64{0}) -> jet_rt_free(rows, count * I64{56}, I64{8})
    }
    jet_ctx_pop_deadline(scratch + I64{16})
    jet_rt_free(scratch, I64{32}, I64{8})
    result
}
