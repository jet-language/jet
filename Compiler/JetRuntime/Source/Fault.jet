// Native fault reports. A fatal signal in a native program (SIGSEGV, SIGBUS,
// SIGILL, SIGFPE) runs jet_rt_fault_signal on the faulting thread's
// alternate signal stack, so the report runs even when the thread's own
// stack is exhausted:
// - A SIGSEGV within 1 MiB below the stack pointer is a stack overflow: the
//   E3012 stop names the innermost Jet function with its file, declaration
//   line and source line, and the process exits 70 like every registered stop.
// - Any other fatal signal prints the signal, the faulting address (SIGSEGV,
//   SIGBUS) and the Jet frames (function and file:line), then the signal's
//   default action ends the process: status 128 + signal, with a core dump
//   where enabled, exactly as without the report.
// How much of the stack follows a report's first line is the image's
// `backtrace` build option (fault_backtrace).
// The report is machine code the static linker writes into each image
// (rt_fault_print, from Assets/FaultReport/report.S): Jet frames come from
// the frame-pointer chain and the image's location table (.debug_jetline,
// which Image/Dwarf.jet dwarf_jet_line writes beside the DWARF from the same
// rows, so the report needs no DWARF reader). Under `jet
// run` the image is the loader's mapping (HOST_AT_IMAGE), else
// /proc/self/exe mapped read-only, so `jet run` and the built program print
// the same report. The report never allocates: every byte goes through one
// buffer on the alternate stack to fd 2. Source lines are read from the file
// the table names, under the compilation directory, else under the working
// directory.
// A release image (`debug_info: split`) keeps no location table: its report
// (Assets/FaultReport/addresses.S) gives the first line, the build id and the
// frames' addresses, and `jet crash` turns it into the text above from the
// side debug file.

// Checked FunctionAddress intrinsic in the canonical RuntimeLibrary table.
rt_fault_signal_address: fn() -> I64 { loop { jet_rt_unreachable(I64{0}, I64{0}) } }

// The fault report intrinsic (JetIR BuildLibrary.jet ir_fault_report_call):
// signal, siginfo_t and ucontext_t as the handler receives them, the
// backtrace mode, the image mapping (0: none) and its load bias. It writes
// the report to fd 2 and returns 70 after an E3012 stop, else 0.
rt_fault_print: fn(_signal: I64, _info: I64, _context: I64, _backtrace: I64, _image: I64, _bias: I64) -> I64 { loop { jet_rt_unreachable(I64{0}, I64{0}) } }

// The main thread's alternate stack (fault_stack_start); its word 24 is the
// claim of the one report a process prints.
fault_main_stack := I64{0}

// The `backtrace` build option of the running image (0 full, 1 brief, 2 off;
// JetIR IRBacktrace): what a report prints after its first line. Full lists
// the Jet frames; brief only the faulting frame (a stack overflow names its
// innermost Jet function either way); off no frame.
fault_backtrace := I64{0}

// The image's entry passes a `brief` or `off` backtrace before it runs
// anything else (JetIR ir_entry_function).
#Export(c) jet_rt_fault_backtrace: fn(mode: I64) {
    #Unsafe("the image's entry calls this before it starts any other thread") {
        fault_backtrace = mode
    }
}

// The handler for the four fatal signals, and the calling thread's
// alternate stack. jet_rt_main calls it once per entry; a loaded-image host
// running another entry on the same thread keeps the first stack.
fault_start: fn() {
    if (fault_main_stack == I64{0}) {
        #Unsafe("jet_rt_main calls this on the main thread before the entry runs") {
            fault_main_stack = fault_stack_start()
        }
    }
    handler: rt_fault_signal_address()
    fault_action(I64{11}, handler)
    fault_action(I64{7}, handler)
    fault_action(I64{4}, handler)
    fault_action(I64{8}, handler)
}

// sa_flags SA_SIGINFO | SA_RESTORER | SA_ONSTACK | SA_NODEFER | SA_RESETHAND.
// x86-64 refuses a handler without SA_RESTORER; the handler never returns,
// so its restorer is never used. SA_RESETHAND makes a fault inside the report
// take the default action; SA_NODEFER lets the report re-raise its signal.
fault_action: fn(signal: I64, handler: I64) {
    #Unsafe("rt_sigaction borrows the four-word action on the stack; handler is this runtime's C-ABI export with the (signal, info, context) signature") {
        _ := os_syscall_stack4_i64(I64{13}, signal, handler, I64{3422552068}, I64{0}, I64{0}, I64{8})
    }
}

// Map and register this thread's 256 KiB alternate signal stack; its lowest
// words hold the stack_t that sigaltstack copies. 0 when either call fails.
fault_stack_start: fn() -> I64 {
    stack: alloc_map_try(I64{262144})
    if (stack == I64{0}) -> return I64{0}
    status := I64{0}
    #Unsafe("stack is a fresh private mapping; sigaltstack copies its first three words (ss_sp, ss_flags, ss_size)") {
        os_store_i64(stack, stack)
        os_store_i64(wrapping(stack + I64{8}), I64{0})
        os_store_i64(wrapping(stack + I64{16}), I64{262144})
        os_store_i64(wrapping(stack + I64{24}), I64{0})
        status = os_syscall_i64(I64{131}, stack, I64{0}, I64{0}, I64{0}, I64{0}, I64{0})
    }
    if (status < I64{0}) {
        alloc_unmap(stack, I64{262144})
        return I64{0}
    }
    stack
}

// Unregister (SS_DISABLE) and unmap a thread's alternate stack before the
// thread ends; the thread is not on it.
fault_stack_end: fn(stack: I64) {
    if (stack == I64{0}) -> return
    #Unsafe("stack is this thread's registered alternate stack, unused outside a handler; sigaltstack copies its first three words") {
        os_store_i64(wrapping(stack + I64{8}), I64{2})
        _ := os_syscall_i64(I64{131}, stack, I64{0}, I64{0}, I64{0}, I64{0}, I64{0})
    }
    alloc_unmap(stack, I64{262144})
}

// ---------------------------------------------------------------------------
// The handler.

// signal, siginfo_t (si_addr at 16) and ucontext_t (mcontext gregs at 40:
// rbp 120, rsp 160, rip 168), as the kernel passes them to an SA_SIGINFO
// handler. It never returns; the I64 result is the address-target shape.
#Export(c) jet_rt_fault_signal: fn(signal: I64, info: I64, context: I64) -> I64 {
    // One report per process: a second faulting thread waits for the exit.
    if (fault_main_stack != I64{0} && sync_cas(wrapping(fault_main_stack + I64{24}), I64{0}, I64{1}) != I64{0}) {
        loop { _ := trap_syscall(I64{34}, I64{0}, I64{0}, I64{0}, I64{0}, I64{0}, I64{0}) }
    }
    // No Secret outlives the process in its memory or its core (#5478),
    // even if the report itself faults.
    secret_scrub()
    host_stdout_flush_fault()
    image: alloc_check_image()
    if (rt_fault_print(signal, info, context, fault_backtrace, image, alloc_check_bias(image)) == EXIT_RUNTIME_PANIC) -> trap_defect_exit(EXIT_RUNTIME_PANIC)
    fault_raise(signal)
    I64{0}
}

// The default action of signal for this thread, now: SIG_DFL, then tgkill.
// SA_NODEFER left the signal unblocked, so it is delivered as the syscall
// returns; exit_group(128 + signal) only if it is not.
fault_raise: fn(signal: I64) {
    #Unsafe("rt_sigaction borrows the four-word SIG_DFL action on the stack; tgkill signals this thread") {
        _ := os_syscall_stack4_i64(I64{13}, signal, I64{0}, I64{0}, I64{0}, I64{0}, I64{8})
        process: os_syscall_i64(I64{39}, I64{0}, I64{0}, I64{0}, I64{0}, I64{0}, I64{0})
        thread: os_syscall_i64(I64{186}, I64{0}, I64{0}, I64{0}, I64{0}, I64{0}, I64{0})
        _ := os_syscall_i64(I64{234}, process, thread, signal, I64{0}, I64{0}, I64{0})
    }
    trap_defect_exit(wrapping(I64{128} + signal))
}

// ---------------------------------------------------------------------------
// `context.trace` (JetIR BuildTransact.jet ir_context_read): the calling
// task's Jet frames, innermost first. They come from the same frame-pointer
// chain and location table (.debug_jetline) that the fault report reads
// (report.S `walk`, `find` and `line`), in a read-only mapping of this
// executable's ELF file: the loader's under `jet run` (HOST_AT_IMAGE),
// else /proc/self/exe. A release image keeps the table when its program
// reads the trace (JetBackend Image/StaticLink.jet link_trace_lines).
// The result is text, one `function\tfile\tline\n` line per frame, which
// core.debug's `__trace_records` turns into SourceLocation records. A frame
// the table doesn't hold adds no line: the runtime's own, or every frame of
// an image without a table. A function the table holds with no row for the
// address gets line 0. As in the report's walk, it stops after 4096 frames
// or at a link that doesn't ascend by less than 16 MiB.
#Export(c) jet_rt_context_trace: fn() -> I64 {
    text: rt_text_builder_with_capacity(I64{0})
    if (text == I64{0}) -> return I64{0}
    // The frame walk needs rbp, which no admitted asm leaf reads. As
    // alloc_check_start does, this maps the four-byte stub `mov rax, rbp;
    // ret`. os_call_address_i64 is an inline leaf, so the stub returns this
    // function's frame pointer, and that frame's return address is in the
    // reading function.
    stub: alloc_map_try(I64{4096})
    if (stub == I64{0}) -> return text
    frame := I64{0}
    #Unsafe("stub is a fresh private page that holds `mov rax, rbp; ret` and becomes read+execute before the call") {
        os_store_i64(stub, I64{3286796616})
        if (os_syscall_i64(I64{10}, stub, I64{4096}, I64{5}, I64{0}, I64{0}, I64{0}) == I64{0}) { frame = os_call_address_i64(stub, I64{0}) }
    }
    trace_unmap(stub, I64{4096})
    if (frame == I64{0}) -> return text
    loaded: host_getauxval(HOST_AT_IMAGE)
    image := loaded
    length := I64{0}
    if (image == I64{0}) {
        path: alloc_map_try(I64{4096})
        if (path == I64{0}) -> return text
        #Unsafe("path is a fresh private page; the executable is mapped read-only and only read") {
            // "/proc/self/exe\0", little-endian.
            os_store_i64(path, I64{7310238724270485551})
            os_store_i64(wrapping(path + I64{8}), I64{111567768086124})
            fd: os_syscall_i64(I64{257}, I64{-100}, path, I64{524288}, I64{0}, I64{0}, I64{0})
            if (fd >= I64{0}) {
                size: os_syscall_i64(I64{8}, fd, I64{0}, I64{2}, I64{0}, I64{0}, I64{0})
                if (size > I64{64}) {
                    mapped: os_syscall_i64(I64{9}, I64{0}, size, I64{1}, I64{2}, fd, I64{0})
                    if (mapped > I64{0}) {
                        image = mapped
                        length = size
                    }
                }
                _ := os_syscall_i64(I64{3}, fd, I64{0}, I64{0}, I64{0}, I64{0}, I64{0})
            }
        }
        trace_unmap(path, I64{4096})
    }
    if (image == I64{0}) -> return text
    trace_frames(text, image, alloc_check_bias(image), frame)
    if (length > I64{0}) -> trace_unmap(image, length)
    text
}

// Unmap a mapping the trace made: its stub page, its path page or its view
// of the executable.
trace_unmap: fn(address: I64, bytes: I64) {
    #Unsafe("the trace made this mapping and holds no pointer into it past this call") {
        _ := os_syscall_i64(I64{11}, address, bytes, I64{0}, I64{0}, I64{0}, I64{0})
    }
}

// One line per Jet frame of the chain from `start` onto `text`, read from
// the .debug_jetline section of `image` (its load bias `bias`).
trace_frames: fn(text: I64, image: I64, bias: I64, start: I64) {
    table := I64{0}
    table_end := I64{0}
    #Unsafe("image is a read-only mapping of this executable's ELF64 file; every offset read comes from its own header and section table") {
        offset: os_load_i64(wrapping(image + I64{40}))
        entry: trace_u16(wrapping(image + I64{58}))
        count: trace_u16(wrapping(image + I64{60}))
        names_index: trace_u16(wrapping(image + I64{62}))
        if (offset > I64{0} && names_index < count) {
            sections: wrapping(image + offset)
            names: wrapping(image + os_load_i64(wrapping(wrapping(sections + wrapping(names_index * entry)) + I64{24})))
            index := I64{0}
            loop index < count {
                section: wrapping(sections + wrapping(index * entry))
                name: wrapping(names + trace_u32(section))
                // ".debug_jetline\0", little-endian.
                if (os_load_i64(name) == I64{7664958844667520046} && os_load_i64(wrapping(name + I64{8})).bit_and(I64{72057594037927935}) == I64{111524889523301}) {
                    table = wrapping(image + os_load_i64(wrapping(section + I64{24})))
                    table_end = wrapping(table + os_load_i64(wrapping(section + I64{32})))
                    break
                }
                index = wrapping(index + I64{1})
            }
        }
    }
    if (table == I64{0}) -> return
    frame := start
    steps := I64{0}
    loop frame != (I64{0}) && frame.bit_and(I64{7}) == (I64{0}) && steps < (I64{4096}) {
        address := I64{0}
        above := I64{0}
        #Unsafe("frame is an active caller's [saved rbp][return address] pair on this thread's stack: every followed link ascends by less than 16 MiB") {
            address = os_load_i64(wrapping(frame + I64{8}))
            above = os_load_i64(frame)
        }
        // The call's own address, at link time.
        if (address != I64{0}) -> trace_frame(text, table, table_end, wrapping(wrapping(address - I64{1}) - bias))
        frame = if (above > frame && wrapping(above - frame) < I64{16777216}) -> above else -> I64{0}
        steps = wrapping(steps + I64{1})
    }
}

// The line of the Jet function whose code holds link-time address `pc`,
// from the table [table, table_end). Its layout is DebugPrune.jet's, and
// its lookup is report.S `find`. Nothing when no function holds pc.
trace_frame: fn(text: I64, table: I64, table_end: I64, pc: I64) {
    block := table
    loop wrapping(block + I64{20}) <= table_end {
        end: wrapping(wrapping(block + I64{4}) + trace_u32(block))
        if (end < wrapping(block + I64{20}) || end > table_end) -> return
        count: trace_u32(wrapping(block + I64{4}))
        strings: wrapping(block + trace_u32(wrapping(block + I64{8})))
        low := I64{0}
        #Unsafe("block + 12 is inside this block, which lies in the read-only table") {
            low = os_load_i64(wrapping(block + I64{12}))
        }
        cursor := wrapping(block + I64{20})
        left := count
        loop left > (I64{0}) && cursor < end {
            low = wrapping(low + trace_sleb(cursor))
            cursor = trace_leb_end(cursor)
            high: wrapping(low + trace_uleb(cursor))
            cursor = trace_leb_end(cursor)
            name: trace_uleb(cursor)
            cursor = trace_leb_end(cursor)
            file: trace_uleb(cursor)
            cursor = trace_leb_end(trace_leb_end(cursor))
            rows_length: trace_uleb(cursor)
            cursor = trace_leb_end(cursor)
            rows_end: wrapping(cursor + rows_length)
            if (rows_end > end) -> return
            if (pc >= low && pc < high) {
                trace_text_cstr(text, wrapping(strings + name), end)
                rt_text_push_scalar(text, I64{9})
                trace_text_cstr(text, wrapping(strings + file), end)
                rt_text_push_scalar(text, I64{9})
                rt_text_push_number(text, trace_line(cursor, rows_end, low, high, pc))
                rt_text_push_scalar(text, I64{10})
                return
            }
            cursor = rows_end
            low = high
            left = wrapping(left - I64{1})
        }
        block = end
    }
}

// The line of `pc` in the function [low, high) whose rows are [rows,
// rows_end): the row before the first row past it, or the last row's line
// through the function's end. 0 when no row holds it (report.S `line`).
trace_line: fn(rows: I64, rows_end: I64, low: I64, high: I64, pc: I64) -> I64 {
    at := rows
    address := low
    line := I64{1}
    previous := I64{-1}
    previous_line := I64{0}
    loop at < rows_end {
        address = wrapping(address + trace_uleb(at))
        at = trace_leb_end(at)
        line = wrapping(line + trace_sleb(at))
        at = trace_leb_end(at)
        if (previous >= I64{0} && pc >= previous && pc < address) -> return previous_line
        previous = address
        previous_line = line
    }
    if (previous >= I64{0} && pc >= previous && pc < high) -> return previous_line
    I64{0}
}

// The NUL-terminated string at `at` appended to `text`; it ends at `end`
// at the latest.
trace_text_cstr: fn(text: I64, at: I64, end: I64) {
    length := I64{0}
    loop wrapping(at + length) < end && trace_u8(wrapping(at + length)) != (I64{0}) {
        length = wrapping(length + I64{1})
    }
    rt_text_append(text, at, length)
}

trace_u8: fn(at: I64) -> I64 {
    byte := I64{0}
    #Unsafe("at lies in the executable's read-only mapping: its ELF header, section table or location table") {
        byte = os_load_u8(at)
    }
    byte
}

trace_u16: fn(at: I64) -> I64 { trace_u8(at).bit_or(trace_u8(wrapping(at + I64{1})) << I64{8}) }

trace_u32: fn(at: I64) -> I64 { trace_u16(at).bit_or(trace_u16(wrapping(at + I64{2})) << I64{16}) }

// The unsigned LEB128 at `at`.
trace_uleb: fn(at: I64) -> I64 {
    value := I64{0}
    shift := I64{0}
    cursor := at
    loop shift < (I64{70}) {
        byte: trace_u8(cursor)
        if (shift < I64{63}) -> value = value.bit_or(byte.bit_and(I64{127}) << shift)
        shift = wrapping(shift + I64{7})
        cursor = wrapping(cursor + I64{1})
        if (byte < I64{128}) -> return value
    }
    value
}

// The signed LEB128 at `at`.
trace_sleb: fn(at: I64) -> I64 {
    value := I64{0}
    shift := I64{0}
    cursor := at
    loop shift < (I64{70}) {
        byte: trace_u8(cursor)
        if (shift < I64{63}) -> value = value.bit_or(byte.bit_and(I64{127}) << shift)
        shift = wrapping(shift + I64{7})
        cursor = wrapping(cursor + I64{1})
        if (byte < I64{128}) {
            if (byte.bit_and(I64{64}) != I64{0} && shift < I64{63}) -> value = wrapping(value - (I64{1} << shift))
            return value
        }
    }
    value
}

// The address past the LEB128 at `at`.
trace_leb_end: fn(at: I64) -> I64 {
    cursor := at
    loop trace_u8(cursor) >= (I64{128}) -> cursor = wrapping(cursor + I64{1})
    wrapping(cursor + I64{1})
}
