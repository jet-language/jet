// ReactiveEventWatch.rs:1930-2261 WatchHandle/WatchSet and their shared (Rc)
// state. The devtools readiness publication has no native sink registry; a
// process without devtools sinks publishes to none.
// WatchState64: refs0 target8 (0 files, 1 process, 2 port) owned text16
// (root or host) number24 (pid or port) snapshot32 seenReady40 active48
// event56 (the handle's own Event<WatchEvent> core, JetEvent::new).
// Snapshot: a native header [length0 capacity8 data16] of Row32 (owned path
// text0, modified ms8, len16, isDir24), sorted by path bytes (the Rust
// BTreeMap order).
// WatchSet32: refs0 and a native handle List header @8 [length, capacity, data].
// A poll answers its events as owned texts, three per event: the WatchKind
// name, the path, the detail. Core composes the WatchEvent values.

fn watch_state_new(target: I64, text: I64, number: I64, snapshot: I64, ready: I64) -> I64 {
    state :: jet_rt_alloc(I64{64}, I64{8})
    thread_zero(state, I64{64})
    sync_store(state, I64{1})
    sync_store(state + I64{8}, target)
    sync_store(state + I64{16}, text)
    sync_store(state + I64{24}, number)
    sync_store(state + I64{32}, snapshot)
    sync_store(state + I64{40}, ready)
    sync_store(state + I64{48}, I64{1})
    sync_store(state + I64{56}, event_core_new(I64{0}))
    state
}

fn watch_snapshot_drop(snapshot: I64) {
    if (snapshot == I64{0}) -> return
    length :: trap_word(snapshot)
    data :: trap_word(snapshot + I64{16})
    at := I64{0}
    loop at < length {
        jet_rt_string_drop(trap_word(data + at * I64{32}))
        at += I64{1}
    }
    capacity :: trap_word(snapshot + I64{8})
    if (capacity != I64{0}) -> jet_rt_free(data, capacity * I64{32}, I64{8})
    jet_rt_free(snapshot, I64{24}, I64{8})
}

#Export(c) fn jet_rt_handle_clone_watch_handle(value: I64) -> I64 {
    _ := sync_add(value, I64{1})
    value
}
#Export(c) fn jet_rt_handle_drop_watch_handle(value: I64) {
    if (value == I64{0}) -> return
    if (sync_add(value, I64{-1}) != I64{1}) -> return
    jet_rt_string_drop(sync_load(value + I64{16}))
    watch_snapshot_drop(sync_load(value + I64{32}))
    jet_rt_handle_drop_jet_event(sync_load(value + I64{56}))
    jet_rt_free(value, I64{64}, I64{8})
}

#Export(c) fn jet_rt_handle_clone_watch_set(value: I64) -> I64 {
    _ := sync_add(value, I64{1})
    value
}
#Export(c) fn jet_rt_handle_drop_watch_set(value: I64) {
    if (value == I64{0}) -> return
    if (sync_add(value, I64{-1}) != I64{1}) -> return
    length :: sync_load(value + I64{8})
    data :: sync_load(value + I64{24})
    at := I64{0}
    loop at < length {
        jet_rt_handle_drop_watch_handle(trap_word(data + at * I64{8}))
        at += I64{1}
    }
    capacity :: sync_load(value + I64{16})
    if (capacity != I64{0}) -> jet_rt_free(data, capacity * I64{8}, I64{8})
    jet_rt_free(value, I64{32}, I64{8})
}

fn watch_snapshot_push(snapshot: I64, path: I64, modified: I64, length: I64, directory: I64) {
    count :: trap_word(snapshot)
    capacity :: trap_word(snapshot + I64{8})
    if (count == capacity) {
        grown :: if (capacity == I64{0}) -> I64{8} else -> capacity * I64{2}
        data :: jet_rt_alloc(grown * I64{32}, I64{8})
        if (capacity != I64{0}) {
            coll_copy(trap_word(snapshot + I64{16}), data, capacity * I64{32})
            jet_rt_free(trap_word(snapshot + I64{16}), capacity * I64{32}, I64{8})
        }
        trap_store(snapshot + I64{8}, grown)
        trap_store(snapshot + I64{16}, data)
    }
    row :: trap_word(snapshot + I64{16}) + count * I64{32}
    trap_store(row, path)
    trap_store(row + I64{8}, modified)
    trap_store(row + I64{16}, length)
    trap_store(row + I64{24}, directory)
    trap_store(snapshot, count + I64{1})
}

// Path::join for a directory entry name (NUL-terminated at `name`).
fn watch_join(parent: I64, name: I64) -> I64 {
    text :: jet_rt_string_builder_new()
    jet_rt_string_builder_push(text, parent)
    length :: rt_text_len(parent)
    if (length > I64{0} && rt_text_byte(rt_text_data(parent) + length - I64{1}) != I64{47}) -> rt_text_append(text, rt_text_data(rt_static_text("/")), I64{1})
    rt_text_append(text, name, host_startup_byte_length(name))
    text
}

// jet_watch_snapshot: a stack walk; symlink_metadata of every path, read_dir
// of every directory; any failure is io_error_at(Read, that path).
fn watch_snapshot(root: I64, snapshot: I64, error: I64) -> Bool {
    stack := jet_rt_alloc(I64{64}, I64{8})
    stack_capacity := I64{8}
    depth := I64{1}
    trap_store(stack, jet_rt_string_clone(root))
    facts :: jet_rt_alloc(I64{160}, I64{8})
    buffer :: jet_rt_alloc(FILES_DIRENT_BYTES, I64{8})
    failed := false
    loop depth > (I64{0}) && !failed {
        depth -= I64{1}
        path :: trap_word(stack + depth * I64{8})
        jet_fs_stat_raw(path, false, facts, facts + I64{128})
        code :: files_out_errno(facts + I64{128})
        if (code != I64{0}) {
            _ := compiler_fs_errno(HOST_IO_OP_READ, path, code, error)
            jet_rt_string_drop(path)
            failed = true
            break
        }
        mode :: trap_word(facts + I64{16}).bit_and(I64{61440})
        seconds :: trap_word(facts + I64{80})
        modified :: if (seconds < I64{0}) -> I64{0} else -> seconds * I64{1000} + trap_word(facts + I64{88}) /% I64{1000000}
        directory :: mode == I64{16384}
        watch_snapshot_push(snapshot, jet_rt_string_clone(path), modified, trap_word(facts + I64{56}), if directory -> I64{1} else -> I64{0})
        if directory {
            name :: fd_c_path(path)
            fd := I64{-4}
            loop fd == (I64{-4}) -> fd = host_call(I64{2}, name, FILES_O_DIRECTORY_CLOEXEC, I64{0})
            fd_c_path_drop(name, path)
            if (fd < I64{0}) {
                _ := compiler_fs_errno(HOST_IO_OP_READ, path, -fd, error)
                failed = true
            } else {
                loop {
                    count :: host_call(I64{217}, fd, buffer, FILES_DIRENT_BYTES)
                    if (count == I64{0}) -> break
                    if (count < I64{0}) {
                        _ := compiler_fs_errno(HOST_IO_OP_READ, path, -count, error)
                        failed = true
                        break
                    }
                    at := I64{0}
                    loop at < count {
                        record :: buffer + at
                        at += rt_text_byte(record + I64{16}).bit_or((rt_text_byte(record + I64{17}) << I64{8}))
                        entry :: record + I64{19}
                        if files_dot_entry(entry) -> next
                        if (depth == stack_capacity) {
                            grown :: jet_rt_alloc(stack_capacity * I64{16}, I64{8})
                            coll_copy(stack, grown, stack_capacity * I64{8})
                            jet_rt_free(stack, stack_capacity * I64{8}, I64{8})
                            stack = grown
                            stack_capacity = stack_capacity * I64{2}
                        }
                        trap_store(stack + depth * I64{8}, watch_join(path, entry))
                        depth += I64{1}
                    }
                }
                _ := host_call(I64{3}, fd, I64{0}, I64{0})
            }
        }
        jet_rt_string_drop(path)
    }
    loop depth > (I64{0}) {
        depth -= I64{1}
        jet_rt_string_drop(trap_word(stack + depth * I64{8}))
    }
    jet_rt_free(stack, stack_capacity * I64{8}, I64{8})
    jet_rt_free(buffer, FILES_DIRENT_BYTES, I64{8})
    jet_rt_free(facts, I64{160}, I64{8})
    if !failed -> watch_snapshot_sort(snapshot)
    !failed
}

fn watch_min(left: I64, right: I64) -> I64 { if (left < right) -> left else -> right }

// A stable bottom-up merge of the snapshot rows by path bytes through one
// scratch buffer; the header keeps whichever buffer holds the result.
fn watch_snapshot_sort(snapshot: I64) {
    length :: trap_word(snapshot)
    if (length < I64{2}) -> return
    original :: trap_word(snapshot + I64{16})
    source := original
    target := jet_rt_alloc(length * I64{32}, I64{8})
    width := I64{1}
    loop width < length {
        start := I64{0}
        loop start < length {
            middle :: watch_min(start + width, length)
            end :: watch_min(start + width * I64{2}, length)
            left := start
            right := middle
            at := start
            loop at < end {
                from_left :: right >= end || (left < middle && jet_rt_string_compare(trap_word(source + left * I64{32}), trap_word(source + right * I64{32})) <= I64{0})
                if from_left {
                    coll_copy(source + left * I64{32}, target + at * I64{32}, I64{32})
                    left += I64{1}
                } else {
                    coll_copy(source + right * I64{32}, target + at * I64{32}, I64{32})
                    right += I64{1}
                }
                at += I64{1}
            }
            start = end
        }
        swap :: source
        source = target
        target = swap
        width = width * I64{2}
    }
    if (source == original) {
        jet_rt_free(target, length * I64{32}, I64{8})
        return
    }
    jet_rt_free(original, trap_word(snapshot + I64{8}) * I64{32}, I64{8})
    trap_store(snapshot + I64{8}, length)
    trap_store(snapshot + I64{16}, source)
}

// WatchHandle::files: Err(IOError) when the initial snapshot fails.
#Export(c) fn jet_watcher_files(path: I64, output: I64, error: I64) -> I64 {
    snapshot :: jet_rt_alloc(I64{24}, I64{8})
    thread_zero(snapshot, I64{24})
    if !watch_snapshot(path, snapshot, error) {
        watch_snapshot_drop(snapshot)
        return I64{0}
    }
    rt_text_store(output, watch_state_new(I64{0}, jet_rt_string_clone(path), I64{0}, snapshot, I64{0}))
    I64{1}
}

// jet_process_alive: kill(pid, 0) succeeds or fails with EPERM; a pid that
// is not positive or not an i32 is not alive.
fn watch_process_alive(pid: I64) -> Bool {
    if (pid <= I64{0} || pid > I64{2147483647}) -> return false
    result :: host_call(I64{62}, pid, I64{0}, I64{0})
    result == I64{0} || result == I64{-1}
}

// WatchHandle::process_pid: seen_ready starts as the first liveness probe.
#Export(c) fn jet_watcher_process_pid(pid: I64) -> I64 {
    native :: jet_int_owned_to_i64(pid)
    if (jet_scheduler_native_propagate() != I64{0}) -> return I64{0}
    ready :: watch_process_alive(native)
    watch_state_new(I64{1}, jet_rt_string_builder_new(), native, I64{0}, if ready -> I64{1} else -> I64{0})
}

// WatchHandle::port: not ready until a later poll connects.
#Export(c) fn jet_watcher_port(host: I64, port: I64) -> I64 {
    native :: jet_int_owned_to_i64(port)
    if (jet_scheduler_native_propagate() != I64{0}) -> return I64{0}
    watch_state_new(I64{2}, jet_rt_string_clone(host), native, I64{0}, I64{0})
}

// WatchSet::new: an empty shared handle list.
#Export(c) fn jet_watcher_set() -> I64 {
    value :: jet_rt_alloc(I64{32}, I64{8})
    thread_zero(value, I64{32})
    sync_store(value, I64{1})
    value
}

// Append `word` to the native List header [length, capacity, data] at `list`.
fn watch_words_push(list: I64, word: I64) {
    count :: trap_word(list)
    capacity :: trap_word(list + I64{8})
    if (count == capacity) {
        grown :: if (capacity == I64{0}) -> I64{8} else -> capacity * I64{2}
        data :: jet_rt_alloc(grown * I64{8}, I64{8})
        if (capacity != I64{0}) {
            coll_copy(trap_word(list + I64{16}), data, capacity * I64{8})
            jet_rt_free(trap_word(list + I64{16}), capacity * I64{8}, I64{8})
        }
        trap_store(list + I64{8}, grown)
        trap_store(list + I64{16}, data)
    }
    trap_store(trap_word(list + I64{16}) + count * I64{8}, word)
    trap_store(list, count + I64{1})
}

// One event's three owned texts; `kind` is a static WatchKind name.
fn watch_event_push(events: I64, kind: I64, path: I64, detail: I64) {
    watch_words_push(events, jet_rt_string_clone(kind))
    watch_words_push(events, path)
    watch_words_push(events, detail)
}

// jet_watch_event: a file event names its row's path and "dir" or "file".
fn watch_file_event(events: I64, kind: I64, row: I64) {
    detail :: if (trap_word(row + I64{24}) != I64{0}) -> rt_static_text("dir") else -> rt_static_text("file")
    watch_event_push(events, kind, jet_rt_string_clone(trap_word(row)), jet_rt_string_clone(detail))
}

// The (modified, len, isDir) facts of two rows are equal.
fn watch_row_same(left: I64, right: I64) -> Bool {
    trap_word(left + I64{8}) == trap_word(right + I64{8}) && trap_word(left + I64{16}) == trap_word(right + I64{16}) && trap_word(left + I64{24}) == trap_word(right + I64{24})
}

// jet_watch_diff over two path-sorted snapshots: Created or Modified rows of
// `next` in path order, then the Removed rows of `previous` in path order.
fn watch_diff(previous: I64, next: I64, events: I64) {
    old_count :: trap_word(previous)
    old_rows :: trap_word(previous + I64{16})
    new_count :: trap_word(next)
    new_rows :: trap_word(next + I64{16})
    at := I64{0}
    other := I64{0}
    loop at < new_count {
        row :: new_rows + at * I64{32}
        order := I64{1}
        loop other < old_count {
            order = jet_rt_string_compare(trap_word(old_rows + other * I64{32}), trap_word(row))
            if (order >= I64{0}) -> break
            other += I64{1}
        }
        if (other < old_count && order == I64{0}) {
            if !watch_row_same(old_rows + other * I64{32}, row) -> watch_file_event(events, rt_static_text("Modified"), row)
        } else {
            watch_file_event(events, rt_static_text("Created"), row)
        }
        at += I64{1}
    }
    at = I64{0}
    other = I64{0}
    loop at < old_count {
        row :: old_rows + at * I64{32}
        order := I64{1}
        loop other < new_count {
            order = jet_rt_string_compare(trap_word(new_rows + other * I64{32}), trap_word(row))
            if (order >= I64{0}) -> break
            other += I64{1}
        }
        if (other >= new_count || order != I64{0}) -> watch_file_event(events, rt_static_text("Removed"), row)
        at += I64{1}
    }
}

// A files poll: the diff against a fresh snapshot, which replaces the old
// one; a failed snapshot is one Error event for the root with the IOError's
// Debug text, and the old snapshot stays.
fn watch_poll_files(state: I64, events: I64) {
    root :: sync_load(state + I64{16})
    next :: jet_rt_alloc(I64{24}, I64{8})
    thread_zero(next, I64{24})
    error :: jet_rt_alloc(I64{8}, I64{8})
    thread_zero(error, I64{8})
    if watch_snapshot(root, next, error) {
        previous :: sync_load(state + I64{32})
        watch_diff(previous, next, events)
        watch_snapshot_drop(previous)
        sync_store(state + I64{32}, next)
    } else {
        watch_snapshot_drop(next)
        failure :: trap_word(error)
        watch_event_push(events, rt_static_text("Error"), jet_rt_string_clone(root), jet_rt_handle_debug_io_error(failure))
        jet_rt_handle_drop_io_error(failure)
    }
    jet_rt_free(error, I64{8}, I64{8})
}

// A process poll reports a liveness edge; a process never seen alive
// reports that it is not running on every poll.
fn watch_poll_process(state: I64, events: I64) {
    alive :: watch_process_alive(sync_load(state + I64{24}))
    seen :: sync_load(state + I64{40}) != I64{0}
    if (seen && !alive) {
        sync_store(state + I64{40}, I64{0})
        watch_event_push(events, rt_static_text("Exited"), jet_rt_string_builder_new(), jet_rt_string_clone(rt_static_text("process exited")))
    } else if (!seen && alive) {
        sync_store(state + I64{40}, I64{1})
        watch_event_push(events, rt_static_text("Ready"), jet_rt_string_builder_new(), jet_rt_string_clone(rt_static_text("process is running")))
    } else if (!seen && !alive) {
        watch_event_push(events, rt_static_text("Exited"), jet_rt_string_builder_new(), jet_rt_string_clone(rt_static_text("process is not running")))
    }
}

// TcpStream::connect((host, port)).is_ok() for a port in 0..=65535; the
// connected stream or the failure is dropped at once.
fn watch_port_ready(host: I64, port: I64) -> Bool {
    if (port < I64{0} || port > I64{65535}) -> return false
    slots :: jet_rt_alloc(I64{16}, I64{8})
    thread_zero(slots, I64{16})
    connected :: jet_net_tcp_connect_happy(host, port, I64{9223372036854775807}, slots, slots + I64{8}) != I64{0}
    jet_rt_handle_drop_jet_tcp_stream(trap_word(slots))
    jet_rt_handle_drop_jet_net_error(trap_word(slots + I64{8}))
    jet_rt_free(slots, I64{16}, I64{8})
    connected
}

// A port poll reports becoming ready ("host:port"); losing readiness only
// clears seen_ready.
fn watch_poll_port(state: I64, events: I64) {
    host :: sync_load(state + I64{16})
    port :: sync_load(state + I64{24})
    ready :: watch_port_ready(host, port)
    seen :: sync_load(state + I64{40}) != I64{0}
    if (ready && !seen) {
        sync_store(state + I64{40}, I64{1})
        detail :: jet_rt_string_builder_new()
        jet_rt_string_builder_push(detail, host)
        jet_rt_string_builder_push(detail, rt_static_text(":"))
        rt_text_push_number(detail, port)
        watch_event_push(events, rt_static_text("Ready"), jet_rt_string_builder_new(), jet_rt_string_builder_finish(detail))
    } else if (!ready && seen) {
        sync_store(state + I64{40}, I64{0})
    }
}

// WatchHandle::poll: an inactive watch answers no events.
#Export(c) fn jet_watcher_poll(state: I64, out_data: I64) -> I64 {
    events :: jet_rt_alloc(I64{24}, I64{8})
    thread_zero(events, I64{24})
    if (jet_scheduler_native_propagate() == I64{0} && sync_load(state + I64{48}) != I64{0}) {
        target :: sync_load(state + I64{8})
        if (target == I64{0}) {
            watch_poll_files(state, events)
        } else if (target == I64{1}) {
            watch_poll_process(state, events)
        } else {
            watch_poll_port(state, events)
        }
    }
    length :: trap_word(events)
    data :: coll_i64_output(length, out_data)
    if (length != I64{0}) -> coll_copy(trap_word(events + I64{16}), data, length * I64{8})
    capacity :: trap_word(events + I64{8})
    if (capacity != I64{0}) -> jet_rt_free(trap_word(events + I64{16}), capacity * I64{8}, I64{8})
    jet_rt_free(events, I64{24}, I64{8})
    length
}

#Export(c) fn jet_watcher_cancel(state: I64) { sync_store(state + I64{48}, I64{0}) }
#Export(c) fn jet_watcher_is_active(state: I64) -> Bool { sync_load(state + I64{48}) != I64{0} }
#Export(c) fn jet_watcher_target(state: I64) -> I64 { jet_int_owned_from_i64(sync_load(state + I64{8})) }
#Export(c) fn jet_watcher_text(state: I64) -> I64 { jet_rt_string_clone(sync_load(state + I64{16})) }
#Export(c) fn jet_watcher_number(state: I64) -> I64 { jet_int_owned_from_i64(sync_load(state + I64{24})) }
#Export(c) fn jet_watcher_event(state: I64) -> I64 { jet_rt_handle_clone_jet_event(sync_load(state + I64{56})) }

// WatchSet::add keeps its own count of the handle.
#Export(c) fn jet_watcher_set_add(set: I64, handle: I64) {
    watch_words_push(set + I64{8}, jet_rt_handle_clone_watch_handle(handle))
}
#Export(c) fn jet_watcher_set_len(set: I64) -> I64 { jet_int_owned_from_i64(trap_word(set + I64{8})) }
#Export(c) fn jet_watcher_set_get(set: I64, index: I64) -> I64 {
    at :: jet_int_owned_to_i64(index)
    if (at < I64{0} || at >= trap_word(set + I64{8})) -> jet_rt_unreachable(rt_text_data(rt_static_text("watch set index out of range")), I64{28})
    jet_rt_handle_clone_watch_handle(trap_word(trap_word(set + I64{24}) + at * I64{8}))
}
