// Unix listener/stream routes over Listener8/Stream64 (HostNetCarriers.jet) and
// FD72. Accept, shutdown, ready and deadlines share the TCP handle policy;
// unlike TCP, the reference applies no OS socket timeouts and retries
// Interrupted as well as WouldBlock on read/write. An inherited listener
// descriptor and the SO_PEERCRED triple of a connected stream.

net_unix_path_refused: fn(status: I64, operation: I64, path: I64, error: I64) -> I64 {
    message: if (status == HOST_UNIX_PATH_NUL) -> rt_static_text(" failed: paths must not contain interior null bytes") else -> rt_static_text(" failed: path must be shorter than SUN_LEN")
    net_route_fail_take(NET_ERROR_INVALID_INPUT, operation, path, net_route_message(operation, message), I64{0}, error)
}

#Export(c) jet_net_unix_listen: fn(path: I64, output: I64, error: I64) -> I64 {
    jet_rt_world_reject_uncontrolled(I64{1})
    if (jet_scheduler_native_propagate() != I64{0}) -> return I64{0}
    operation: rt_static_text("unix listen")
    // std::fs::remove_file(path) first; its failure is ignored.
    if (net_unix_path_status(path) != HOST_UNIX_PATH_NUL) {
        name: fd_c_path(path)
        _ := host_call(I64{87}, name, I64{0}, I64{0})
        fd_c_path_drop(name, path)
    }
    scratch: jet_rt_alloc(I64{32}, I64{8})
    thread_zero(scratch, I64{32})
    state: jet_socket_create_raw(I64{1}, I64{1}, I64{0}, scratch)
    status := I64{-1}
    if (state != I64{0}) {
        status = jet_socket_unix_bind_raw(state, path, scratch)
        // std's Linux UnixListener::bind listens with backlog -1 (somaxconn).
        if (status >= I64{0}) -> status = jet_socket_listen_raw(state, I64{-1}, scratch)
    }
    code: net_word(scratch, I64{8})
    jet_rt_free(scratch, I64{32}, I64{8})
    if (status < I64{0}) {
        if (state != I64{0}) -> jet_fd_drop_raw(state)
        if (jet_scheduler_native_propagate() != I64{0}) -> return I64{0}
        if (status == HOST_UNIX_PATH_NUL || status == HOST_UNIX_PATH_TOO_LONG) -> return net_unix_path_refused(status, operation, path, error)
        return net_route_errno(operation, path, code, error)
    }
    net_put(output, I64{0}, jet_socket_listener_from_fd_raw(state))
    I64{1}
}

#Export(c) jet_net_unix_accept: fn(listener: I64, output: I64, error: I64) -> I64 { net_route_accept(listener, rt_static_text("unix accept"), output, error) }
#Export(c) jet_net_unix_accept_deadline: fn(listener: I64, deadline: I64, output: I64, error: I64) -> I64 { net_listener_accept_deadline(listener, deadline, rt_static_text("unix accept"), output, error) }

// Read once into at most min(limit, 16 MiB) bytes; text decodes as UTF-8 and
// keeps a cut character for the next read (net_carry_*, NetHandleRoutes.jet).
// limit is the caller's exact Int word.
net_unix_read_result: fn(stream: I64, word: I64, output: I64, length: I64, text: Bool, error: I64) -> I64 {
    operation: rt_static_text("unix read")
    limit: host_native_int(word)
    if (jet_scheduler_native_propagate() != I64{0}) -> return I64{0}
    if !net_tcp_direction_open(stream, true, operation, error) -> return I64{0}
    if (limit <= I64{0}) -> return net_route_fail_take(NET_ERROR_INVALID_INPUT, operation, I64{0}, jet_rt_string_clone(rt_static_text("unix read limit must be positive")), I64{0}, error)
    cap: if (limit < I64{16777216}) -> limit else -> I64{16777216}
    if (!text && net_carry_bytes(stream, cap, output, length)) -> return I64{1}
    scratch: jet_rt_alloc(I64{48}, I64{8})
    net_tcp_deadline(stream, true, wrapping(scratch + I64{32}))
    size: net_read_size(stream, cap, text)
    block: net_read_buffer_take(stream, size)
    bytes: wrapping(block + I64{8})
    filled := if text -> net_carry_take(stream, bytes) else -> I64{0}
    result := I64{-1}
    if (filled > I64{0}) -> result = net_read_text_publish(stream, bytes, filled, false, false, rt_static_text("unix read text"), output, error)
    loop result < (I64{0}) {
        want: if (filled < cap) -> cap - filled else -> size - filled
        count: jet_socket_read_raw(jet_socket_stream_fd_raw(stream), wrapping(bytes + filled * RT_HOST_U8_STRIDE), want, scratch)
        if (count >= I64{0}) {
            if text {
                filled += count
                result = net_read_text_publish(stream, bytes, filled, count == I64{0}, false, rt_static_text("unix read text"), output, error)
            } else {
                // Publish exactly len slots: the list destructor reads no capacity.
                net_read_publish_bytes(bytes, count, output, length)
                result = I64{1}
            }
        } else {
            code: net_word(scratch, I64{8})
            if (code != I64{11} && code != I64{4}) {
                _ := net_route_errno(operation, I64{0}, code, error)
                result = I64{0}
            } else if (net_tcp_wait(jet_socket_stream_fd_raw(stream), I64{1}, operation, scratch, error) == I64{0}) {
                result = I64{0}
            }
            // A read that fails after the start of a character keeps it.
            if (result == I64{0} && filled > I64{0}) -> net_carry_keep(stream, bytes, I64{0}, filled)
        }
    }
    net_read_buffer_give(stream, block)
    jet_ctx_pop_deadline(wrapping(scratch + I64{32}))
    jet_rt_free(scratch, I64{48}, I64{8})
    result
}
#Export(c) jet_net_unix_read: fn(stream: I64, output: I64, error: I64) -> I64 { net_unix_read_result(stream, I64{8192}, output, I64{0}, true, error) }
#Export(c) jet_net_unix_read_bytes: fn(stream: I64, limit: I64, output: I64, length: I64, error: I64) -> I64 { net_unix_read_result(stream, limit, output, length, false, error) }
#Export(c) jet_net_unix_read_bytes_deadline: fn(stream: I64, limit: I64, deadline: I64, output: I64, length: I64, error: I64) -> I64 {
    milliseconds: net_deadline_millis(deadline)
    if (jet_scheduler_native_propagate() != I64{0}) -> return I64{0}
    if !net_tcp_timeout_valid(milliseconds, rt_static_text("unix read"), error) -> return I64{0}
    save: jet_rt_alloc(I64{16}, I64{8})
    net_route_deadline_push(milliseconds, save)
    result: net_unix_read_result(stream, limit, output, length, false, error)
    jet_ctx_pop_deadline(save)
    jet_rt_free(save, I64{16}, I64{8})
    result
}
#Export(c) jet_net_unix_read_into_deadline: fn(stream: I64, header: I64, limit: I64, deadline: I64, output: I64, error: I64) -> I64 { net_read_into_deadline(stream, header, limit, deadline, false, output, error) }

// jet_net_unix_write_slice: one open check per slice, then write until a
// count is produced, waiting for writability on WouldBlock/Interrupted.
net_unix_write_slice: fn(stream: I64, data: I64, length: I64, scratch: I64, error: I64) -> I64 {
    operation: rt_static_text("unix write")
    if !net_tcp_direction_open(stream, false, operation, error) -> return I64{-1}
    loop {
        count: jet_socket_write_raw(jet_socket_stream_fd_raw(stream), data, length, scratch)
        if (count >= I64{0}) -> return count
        code: net_word(scratch, I64{8})
        if (code != I64{11} && code != I64{4}) {
            _ := net_route_errno(operation, I64{0}, code, error)
            return I64{-1}
        }
        if (net_tcp_wait(jet_socket_stream_fd_raw(stream), I64{4}, operation, scratch, error) == I64{0}) -> return I64{-1}
    }
}
net_unix_write_all: fn(stream: I64, data: I64, length: I64, error: I64) -> I64 {
    scratch: jet_rt_alloc(I64{48}, I64{8})
    net_tcp_deadline(stream, false, wrapping(scratch + I64{32}))
    result := I64{1}
    offset := I64{0}
    loop offset < length {
        count: net_unix_write_slice(stream, wrapping(data + offset * RT_HOST_U8_STRIDE), length - offset, scratch, error)
        if (count < I64{0}) {
            result = I64{0}
            break
        }
        if (count == I64{0}) {
            result = net_route_fail_take(NET_ERROR_CONNECTION_RESET, rt_static_text("unix write all"), I64{0}, jet_rt_string_clone(rt_static_text("unix write all failed: zero bytes written")), I64{0}, error)
            break
        }
        offset += count
    }
    jet_ctx_pop_deadline(wrapping(scratch + I64{32}))
    jet_rt_free(scratch, I64{48}, I64{8})
    result
}
#Export(c) jet_net_unix_write_all_bytes: fn(stream: I64, data: I64, length: I64, error: I64) -> I64 { net_unix_write_all(stream, data, length, error) }
#Export(c) jet_net_unix_write_all_bytes_deadline: fn(stream: I64, data: I64, length: I64, deadline: I64, error: I64) -> I64 {
    milliseconds: net_deadline_millis(deadline)
    if (jet_scheduler_native_propagate() != I64{0}) -> return I64{0}
    if !net_tcp_timeout_valid(milliseconds, rt_static_text("unix write all"), error) -> return I64{0}
    save: jet_rt_alloc(I64{16}, I64{8})
    net_route_deadline_push(milliseconds, save)
    result: net_unix_write_all(stream, data, length, error)
    jet_ctx_pop_deadline(save)
    jet_rt_free(save, I64{16}, I64{8})
    result
}
#Export(c) jet_net_unix_write: fn(stream: I64, text: I64, error: I64) -> I64 {
    length: rt_text_len(text)
    bytes: if (RT_HOST_U8_STRIDE == I64{1} || length == I64{0}) -> rt_text_data(text) else -> jet_rt_alloc(length * RT_HOST_U8_STRIDE, I64{8})
    if (RT_HOST_U8_STRIDE != I64{1} && length != I64{0}) {
        at := I64{0}
        loop at < length {
            host_u8_put(bytes, at, rt_text_byte(wrapping(rt_text_data(text) + at)))
            at += I64{1}
        }
    }
    result: net_unix_write_all(stream, bytes, length, error)
    if (RT_HOST_U8_STRIDE != I64{1} && length != I64{0}) -> jet_rt_free(bytes, length * RT_HOST_U8_STRIDE, I64{8})
    result
}

#Export(c) jet_net_unix_shutdown: fn(stream: I64, how: I64, error: I64) -> I64 { net_stream_shutdown(stream, how, rt_static_text("unix shutdown"), error) }
// The reference marks the stream closed before shutdown(Both), so a failed
// shutdown still leaves it closed; NotConnected is not a failure.
#Export(c) jet_net_unix_close: fn(stream: I64, error: I64) -> I64 {
    if (jet_socket_stream_flags_raw(stream).bit_and(I64{1}) != I64{0}) -> return I64{1}
    scratch: jet_rt_alloc(I64{32}, I64{8})
    result: jet_socket_shutdown_raw(jet_socket_stream_fd_raw(stream), I64{2}, scratch)
    code: net_word(scratch, I64{8})
    jet_rt_free(scratch, I64{32}, I64{8})
    jet_socket_stream_mark_closed_raw(stream)
    if (result < I64{0} && code != I64{107}) -> return net_route_errno(rt_static_text("unix close"), I64{0}, code, error)
    I64{1}
}
#Export(c) jet_net_unix_ready: fn(stream: I64, interest: I64, deadline: I64, output: I64, error: I64) -> I64 { net_stream_ready(stream, interest, deadline, rt_static_text("unix ready"), output, error) }
#Export(c) jet_net_unix_set_timeout: fn(stream: I64, timeout: I64, error: I64) -> I64 {
    net_route_set_timeout(stream, net_deadline_millis(timeout), I64{3}, rt_static_text("set unix timeout"), error)
}

// Descriptor passing (SCM_RIGHTS) for core.net.unix_send/unix_receive. One
// control message carries at most NET_UNIX_MAX_FDS descriptors (the kernel's
// SCM_MAX_FD). Scratch is msghdr0 (56B), iovec56 (16B), cmsghdr72 (16B) then
// the descriptor ints at 88; no pointer into it survives the syscall.
NET_UNIX_MAX_FDS: I64{253}
NET_UNIX_FD_SCRATCH: I64{1112}
// CMSG_SPACE of `count` descriptors: the 16B header and the ints rounded to 8.
net_unix_fd_space: fn(count: I64) -> I64 { I64{16} + (count * I64{4} + I64{7}).bit_and(I64{-8}) }

// sendmsg of `length` bytes from `data` with the `count` descriptors named
// by the core.sys tokens of `fds` (exact Int words) attached, retried on WouldBlock/Interrupted after a
// writable wait. Returns the bytes the kernel took, or -1 with `error` set.
net_unix_send_fds_once: fn(stream: I64, data: I64, length: I64, fds: I64, count: I64, scratch: I64, wait: I64, error: I64) -> I64 {
    operation: rt_static_text("unix send")
    if !net_tcp_direction_open(stream, false, operation, error) -> return I64{-1}
    thread_zero(scratch, NET_UNIX_FD_SCRATCH)
    net_put(scratch, I64{16}, wrapping(scratch + I64{56}))
    net_put(scratch, I64{24}, I64{1})
    net_put(scratch, I64{56}, data)
    net_put(scratch, I64{64}, length)
    if (count > I64{0}) {
        net_put(scratch, I64{32}, wrapping(scratch + I64{72}))
        net_put(scratch, I64{40}, net_unix_fd_space(count))
        net_put(scratch, I64{72}, I64{16} + count * I64{4})
        net_store_uint(wrapping(scratch + I64{80}), I64{4}, I64{1})
        net_store_uint(wrapping(scratch + I64{84}), I64{4}, I64{1})
        at := I64{0}
        loop at < count {
            word := I64{0}
            #Unsafe("fds lends count initialized exact Int words") {
                word = os_load_i64(wrapping(fds + at * I64{8}))
            }
            descriptor: host_descriptor_number(host_native_int(word))
            if (descriptor < I64{0}) {
                _ := net_route_fail_take(NET_ERROR_INVALID_INPUT, operation, I64{0}, jet_rt_string_clone(rt_static_text("unix send failed: a descriptor is closed")), I64{0}, error)
                return I64{-1}
            }
            net_store_uint(wrapping(scratch + I64{88} + at * I64{4}), I64{4}, descriptor)
            at += I64{1}
        }
    }
    loop {
        // MSG_NOSIGNAL: a closed peer is EPIPE, never a process-wide SIGPIPE.
        sent: net_socket_call(jet_socket_stream_fd_raw(stream), I64{46}, scratch, I64{16384}, I64{0}, I64{0}, I64{0})
        if (sent >= I64{0}) -> return sent
        if (sent != I64{-11} && sent != I64{-4}) {
            _ := net_route_errno(operation, I64{0}, -sent, error)
            return I64{-1}
        }
        if (net_tcp_wait(jet_socket_stream_fd_raw(stream), I64{4}, operation, wait, error) == I64{0}) -> return I64{-1}
    }
}

// All `length` bytes, the descriptors riding with the first byte the kernel
// accepts; a partial send continues with the rest. Descriptors stay owned by
// the caller (the kernel duplicates them).
#Export(c) jet_net_unix_send_fds_raw: fn(stream: I64, data: I64, length: I64, fds: I64, count: I64, error: I64) -> I64 {
    operation: rt_static_text("unix send")
    if (length <= I64{0}) -> return net_route_fail_take(NET_ERROR_INVALID_INPUT, operation, I64{0}, jet_rt_string_clone(rt_static_text("unix send needs at least one byte to carry its descriptors")), I64{0}, error)
    if (count > NET_UNIX_MAX_FDS) -> return net_route_fail_take(NET_ERROR_INVALID_INPUT, operation, I64{0}, jet_rt_string_clone(rt_static_text("unix send carries at most 253 descriptors")), I64{0}, error)
    packed: if (RT_HOST_U8_STRIDE == I64{1}) -> data else -> jet_rt_alloc(length, I64{8})
    if (RT_HOST_U8_STRIDE != I64{1}) -> net_copy_packed(data, length, packed)
    scratch: jet_rt_alloc(NET_UNIX_FD_SCRATCH, I64{8})
    wait: jet_rt_alloc(I64{48}, I64{8})
    net_tcp_deadline(stream, false, wrapping(wait + I64{32}))
    result := I64{1}
    offset := I64{0}
    pending := count
    loop offset < length {
        sent: net_unix_send_fds_once(stream, wrapping(packed + offset), length - offset, fds, pending, scratch, wait, error)
        if (sent < I64{0}) {
            result = I64{0}
            break
        }
        if (sent == I64{0}) {
            result = net_route_fail_take(NET_ERROR_CONNECTION_RESET, operation, I64{0}, jet_rt_string_clone(rt_static_text("unix send failed: zero bytes written")), I64{0}, error)
            break
        }
        pending = I64{0}
        offset += sent
    }
    jet_ctx_pop_deadline(wrapping(wait + I64{32}))
    jet_rt_free(wait, I64{48}, I64{8})
    jet_rt_free(scratch, NET_UNIX_FD_SCRATCH, I64{8})
    if (RT_HOST_U8_STRIDE != I64{1}) -> jet_rt_free(packed, length, I64{8})
    result
}

// One recvmsg of at most min(limit, 16 MiB) bytes with MSG_CMSG_CLOEXEC. The
// result list is the payload bytes, then the core.sys token of each received
// descriptor as eight little-endian bytes, then one byte counting them; the
// caller owns those tokens. An empty list is end of stream. A truncated
// control message (MSG_CTRUNC) closes every descriptor that did arrive and
// fails: a message never arrives without the descriptors it carried.
#Export(c) jet_net_unix_receive_fds_raw: fn(stream: I64, word: I64, output: I64, length: I64, error: I64) -> I64 {
    operation: rt_static_text("unix receive")
    limit: host_native_int(word)
    if (jet_scheduler_native_propagate() != I64{0}) -> return I64{0}
    if !net_tcp_direction_open(stream, true, operation, error) -> return I64{0}
    if (limit <= I64{0}) -> return net_route_fail_take(NET_ERROR_INVALID_INPUT, operation, I64{0}, jet_rt_string_clone(rt_static_text("unix receive limit must be positive")), I64{0}, error)
    cap: if (limit < I64{16777216}) -> limit else -> I64{16777216}
    // Room for the payload, every descriptor one control message can carry and the count byte.
    room: cap + NET_UNIX_MAX_FDS * I64{8} + I64{1}
    bytes := jet_rt_alloc_8(room)
    scratch: jet_rt_alloc(NET_UNIX_FD_SCRATCH, I64{8})
    wait: jet_rt_alloc(I64{48}, I64{8})
    net_tcp_deadline(stream, true, wrapping(wait + I64{32}))
    result := I64{0}
    loop {
        thread_zero(scratch, NET_UNIX_FD_SCRATCH)
        net_put(scratch, I64{16}, wrapping(scratch + I64{56}))
        net_put(scratch, I64{24}, I64{1})
        net_put(scratch, I64{32}, wrapping(scratch + I64{72}))
        net_put(scratch, I64{40}, net_unix_fd_space(NET_UNIX_MAX_FDS))
        net_put(scratch, I64{56}, bytes)
        net_put(scratch, I64{64}, cap)
        count: net_socket_call(jet_socket_stream_fd_raw(stream), I64{47}, scratch, I64{1073741824}, I64{0}, I64{0}, I64{0})
        if (count >= I64{0}) {
            // MSG_CTRUNC: the kernel dropped descriptors that did not fit.
            truncated: net_word(scratch, I64{48}).bit_and(I64{8}) != I64{0}
            total := count
            fds := I64{0}
            refused := false
            control: net_word(scratch, I64{40})
            at := I64{0}
            loop wrapping(at + I64{16}) <= control {
                header: wrapping(scratch + I64{72} + at)
                size: net_word(header, I64{0})
                if (size < I64{16}) -> break
                if (net_load_uint(wrapping(header + I64{8}), I64{4}) == I64{1} && net_load_uint(wrapping(header + I64{12}), I64{4}) == I64{1}) {
                    carried: (size - I64{16}) /% I64{4}
                    index := I64{0}
                    loop index < carried {
                        descriptor: net_load_uint(wrapping(header + I64{16} + index * I64{4}), I64{4})
                        filed: if (truncated || refused || fds >= NET_UNIX_MAX_FDS) -> I64{-1} else -> host_descriptor_insert(descriptor, I64{0}, I64{0})
                        if (filed < I64{0}) {
                            refused = true
                            _ := host_call(I64{3}, descriptor, I64{0}, I64{0})
                        } else {
                            net_store_uint(wrapping(bytes + total), I64{8}, filed)
                            total += I64{8}
                            fds += I64{1}
                        }
                        index += I64{1}
                    }
                }
                at = wrapping(at + (size + I64{7}).bit_and(I64{-8}))
            }
            if (truncated || refused) {
                // Retire the tokens already filed for this message too.
                index := I64{0}
                loop index < fds {
                    host_descriptor_release(net_load_uint(wrapping(bytes + count + index * I64{8}), I64{8}))
                    index += I64{1}
                }
                _ := net_route_fail_take(NET_ERROR_PROTOCOL, operation, I64{0}, jet_rt_string_clone(rt_static_text("unix receive failed: the message carried more descriptors than fit; every descriptor that arrived was closed")), I64{0}, error)
                break
            }
            if (count > I64{0} || fds > I64{0}) {
                net_store_uint(wrapping(bytes + total), I64{1}, fds)
                total += I64{1}
            }
            compiler_fs_bytes_take(bytes, room, total, output, length)
            bytes = I64{0}
            result = I64{1}
            break
        }
        if (count != I64{-11} && count != I64{-4}) {
            _ := net_route_errno(operation, I64{0}, -count, error)
            break
        }
        if (net_tcp_wait(jet_socket_stream_fd_raw(stream), I64{1}, operation, wait, error) == I64{0}) -> break
    }
    if (bytes != I64{0}) -> jet_rt_free_8(bytes, room)
    jet_ctx_pop_deadline(wrapping(wait + I64{32}))
    jet_rt_free(wait, I64{48}, I64{8})
    jet_rt_free(scratch, NET_UNIX_FD_SCRATCH, I64{8})
    result
}

// getsockopt(SOL_SOCKET, option) on a descriptor this route does not own yet.
net_unix_fd_option: fn(descriptor: I64, option: I64) -> I64 {
    scratch: jet_rt_alloc(I64{16}, I64{8})
    thread_zero(scratch, I64{16})
    net_store_uint(wrapping(scratch + I64{8}), I64{4}, I64{4})
    result := I64{0}
    #Unsafe("private scratch lends one native int and its 4B socklen; getsockopt retains neither pointer") {
        result = os_syscall_i64(I64{55}, descriptor, I64{1}, option, scratch, scratch + I64{8}, I64{0})
    }
    value: net_load_uint(scratch, I64{4})
    jet_rt_free(scratch, I64{16}, I64{8})
    if (result < I64{0}) -> I64{-1} else -> value
}
// UnixListener::from_raw_fd, validated: the descriptor must be a listening
// AF_UNIX SOCK_STREAM socket. It then becomes CLOEXEC and nonblocking (the
// accept loop waits on readiness) and the listener owns it.
#Export(c) jet_net_unix_listener_adopt: fn(word: I64, output: I64, error: I64) -> I64 {
    descriptor: host_native_int(word)
    jet_rt_world_reject_uncontrolled(I64{1})
    if (jet_scheduler_native_propagate() != I64{0}) -> return I64{0}
    operation: rt_static_text("unix listener adopt")
    valid: (descriptor >= I64{0} && descriptor <= I64{2147483647}
        && net_unix_fd_option(descriptor, I64{39}) == I64{1}
        && net_unix_fd_option(descriptor, I64{3}) == I64{1}
        && net_unix_fd_option(descriptor, I64{30}) == I64{1})
    if !valid {
        message: jet_rt_string_builder_new()
        jet_rt_string_builder_push(message, rt_static_text("descriptor "))
        rt_text_push_number(message, descriptor)
        jet_rt_string_builder_push(message, rt_static_text(" is not a listening Unix stream socket"))
        return net_route_fail_take(NET_ERROR_INVALID_INPUT, operation, I64{0}, jet_rt_string_builder_finish(message), I64{0}, error)
    }
    status := host_call(I64{72}, descriptor, I64{2}, I64{1})
    if (status >= I64{0}) {
        flags: host_call(I64{72}, descriptor, I64{3}, I64{0})
        status = if (flags < I64{0}) -> flags else -> host_call(I64{72}, descriptor, I64{4}, flags.bit_or(I64{2048}))
    }
    if (status < I64{0}) -> return net_route_errno(operation, I64{0}, -status, error)
    net_put(output, I64{0}, jet_socket_listener_from_fd_raw(jet_fd_adopt_unbuffered_raw(descriptor, I64{0})))
    I64{1}
}

// SO_PEERCRED is fixed at connect time: ucred {pid i32, uid u32, gid u32}.
// Each export reads one field (offset 0 pid, 4 uid, 8 gid).
net_unix_peer_field: fn(stream: I64, offset: I64, output: I64, error: I64) -> I64 {
    operation: rt_static_text("unix peer credentials")
    if !net_route_stream_open(stream, operation, error) -> return I64{0}
    scratch: jet_rt_alloc(I64{24}, I64{8})
    thread_zero(scratch, I64{24})
    net_store_uint(wrapping(scratch + I64{16}), I64{4}, I64{12})
    result: net_socket_call(jet_socket_stream_fd_raw(stream), I64{55}, I64{1}, I64{17}, scratch, scratch + I64{16}, I64{0})
    value: net_load_uint(wrapping(scratch + offset), I64{4})
    jet_rt_free(scratch, I64{24}, I64{8})
    if (result < I64{0}) -> return net_route_errno(operation, I64{0}, -result, error)
    net_put(output, I64{0}, value)
    I64{1}
}
#Export(c) jet_net_unix_peer_process: fn(stream: I64, output: I64, error: I64) -> I64 { net_unix_peer_field(stream, I64{0}, output, error) }
#Export(c) jet_net_unix_peer_user: fn(stream: I64, output: I64, error: I64) -> I64 { net_unix_peer_field(stream, I64{4}, output, error) }
#Export(c) jet_net_unix_peer_group: fn(stream: I64, output: I64, error: I64) -> I64 { net_unix_peer_field(stream, I64{8}, output, error) }

// Waits on the calling OS thread, with no poller-thread hop, until the stream
// is readable (or hung up or failed: the next receive says which) or
// `timeout` nanoseconds pass; a negative timeout waits without limit. ppoll
// takes the nanosecond timespec as is; EINTR is retried with the time left.
// The result is 1 when readable, 0 when the time ran out. A ui window loop
// waits here for its compositor, so a frame callback or an input event wakes
// it straight away.
#Export(c) jet_net_unix_wait_raw: fn(stream: I64, timeout: I64, output: I64, error: I64) -> I64 {
    operation: rt_static_text("unix wait")
    limit: host_native_int(timeout)
    if (jet_scheduler_native_propagate() != I64{0}) -> return I64{0}
    if !net_tcp_direction_open(stream, true, operation, error) -> return I64{0}
    // pollfd at 0, timespec at 8, clock sample at 24.
    scratch: jet_rt_alloc(I64{40}, I64{8})
    end := I64{-1}
    if (limit >= I64{0}) {
        sync_clock_read(I64{1}, wrapping(scratch + I64{24}))
        now: net_word(scratch, I64{24}) * I64{1000000000} + net_word(scratch, I64{32})
        end = if (limit > I64{9223372036854775807} - now) -> I64{9223372036854775807} else -> now + limit
    }
    state: jet_socket_stream_fd_raw(stream)
    result := I64{0}
    loop {
        left := I64{-1}
        if (end >= I64{0}) {
            sync_clock_read(I64{1}, wrapping(scratch + I64{24}))
            now: net_word(scratch, I64{24}) * I64{1000000000} + net_word(scratch, I64{32})
            left = if (end > now) -> end - now else -> I64{0}
            net_put(scratch, I64{8}, left /% I64{1000000000})
            net_put(scratch, I64{16}, left %% I64{1000000000})
        }
        fd_lock(state)
        ready := I64{-9}
        if (fd_word(state, I64{16}) == I64{0}) {
            // struct pollfd {fd, events: POLLIN} with revents cleared.
            net_put(scratch, I64{0}, fd_word(state, I64{8}).bit_and(I64{4294967295}).bit_or(I64{1} << I64{32}))
            #Unsafe("the FD72 lock keeps the descriptor live and unreused for the whole ppoll; scratch lends the pollfd and timespec") {
                ready = os_syscall_i64(I64{271}, scratch, I64{1}, if (left < I64{0}) -> I64{0} else -> wrapping(scratch + I64{8}), I64{0}, I64{8}, I64{0})
            }
        }
        fd_unlock(state)
        if (ready == I64{-4}) -> next
        if (ready < I64{0}) {
            result = net_route_errno(operation, I64{0}, -ready, error)
            break
        }
        rt_text_store(output, jet_int_owned_from_i64(if (ready > I64{0}) -> I64{1} else -> I64{0}))
        result = I64{1}
        break
    }
    jet_rt_free(scratch, I64{40}, I64{8})
    result
}
