// CAbiRoutes.rs:2677-2715,7509-7523,10966-10979; NetHTTP.rs:184-201.
// Ready16 owns normalized Bool words; enum8 owns raw declaration-order tags.
// Shared scalar enum ownership comes from EncodingErrors.jet e1306aee0.
fn net_ready_bool(word: I64) -> Bool { (word & I64{255}) != I64{0} }
#Export(c) fn jet_rt_record_new_JetNetReady(readable: U8, writable: U8) -> I64 {
    value :: jet_rt_alloc(I64{16}, I64{8})
    rt_text_store(value, if (readable != U8{0}) -> I64{1} else -> I64{0})
    rt_text_store(value + I64{8}, if (writable != U8{0}) -> I64{1} else -> I64{0})
    value
}
#Export(c) fn jet_rt_record_get_JetNetReady_readable(value: I64) -> Bool { net_ready_bool(rt_text_word(value)) }
#Export(c) fn jet_rt_record_get_JetNetReady_writable(value: I64) -> Bool { net_ready_bool(rt_text_word(value + I64{8})) }
#Export(c) fn jet_rt_handle_clone_JetNetReady(value: I64) -> I64 {
    result :: jet_rt_alloc(I64{16}, I64{8})
    rt_text_store(result, if jet_rt_record_get_JetNetReady_readable(value) -> I64{1} else -> I64{0})
    rt_text_store(result + I64{8}, if jet_rt_record_get_JetNetReady_writable(value) -> I64{1} else -> I64{0})
    result
}
#Export(c) fn jet_rt_handle_drop_JetNetReady(value: I64) {
    if (value != I64{0}) -> jet_rt_free(value, I64{16}, I64{8})
}
#Export(c) fn jet_rt_handle_eq_JetNetReady(left: I64, right: I64) -> Bool {
    jet_rt_record_get_JetNetReady_readable(left) == jet_rt_record_get_JetNetReady_readable(right) &&
        jet_rt_record_get_JetNetReady_writable(left) == jet_rt_record_get_JetNetReady_writable(right)
}
#Export(c) fn jet_rt_handle_clone_JetNetReadyInterest(value: I64) -> I64 { encoding_enum_clone(value) }
#Export(c) fn jet_rt_handle_drop_JetNetReadyInterest(value: I64) { encoding_enum_drop(value) }
#Export(c) fn jet_rt_handle_eq_JetNetReadyInterest(left: I64, right: I64) -> Bool { encoding_enum_eq(left, right) }
#Export(c) fn jet_rt_handle_clone_JetNetShutdown(value: I64) -> I64 { encoding_enum_clone(value) }
#Export(c) fn jet_rt_handle_drop_JetNetShutdown(value: I64) { encoding_enum_drop(value) }
#Export(c) fn jet_rt_handle_eq_JetNetShutdown(left: I64, right: I64) -> Bool { encoding_enum_eq(left, right) }
