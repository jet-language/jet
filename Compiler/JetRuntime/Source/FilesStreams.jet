// The Rust original open/writer leaves. JetFileReader and JetFileWriter share
// the one FD72 carrier (HostFiles.jet): its private 8192-byte writer buffer is
// BufWriter's, and its drop flushes (ignoring the result) then closes, as
// BufWriter<File>'s drop does. Held-directory and path opens both go through
// HostHeldDirectory.jet fs_open_at (jet_fs_open_at).

// "fault injected: FS.Write" checkpoint (IOError::other).
files_write_fault: fn(path: I64, operation: I64, error: I64) -> Bool {
    if !jet_fault_should_fail(rt_static_text("FS.Write")) -> return false
    _ := host_io_other_take(operation, jet_rt_string_clone(path), jet_rt_string_clone(rt_static_text("fault injected: FS.Write")), error)
    true
}

files_writer_path: fn(writer: I64) -> I64 { fd_word(writer, I64{24}) }

// A held-directory member must be a regular file. A raw entry name that is
// not UTF-8 is shown, in the reader's path and every error, as
// fs_name_display shows it.
#Export(c) jet_std_files_open_reader: fn(handle: I64, name: I64, links: I64, output: I64, error: I64) -> I64 {
    display: fs_name_display(name)
    shown: if (display == I64{0}) -> name else -> display
    result: files_open_reader_shown(handle, name, shown, links, output, error)
    if (display != I64{0}) -> jet_rt_string_drop(display)
    result
}

files_open_reader_shown: fn(handle: I64, name: I64, shown: I64, links: I64, output: I64, error: I64) -> I64 {
    if compiler_fs_fault(shown, error) -> return I64{0}
    fd: fs_open_at(handle, name, I64{0}, I64{0}, I64{-1}, links, error)
    if (fd < I64{0}) -> return I64{0}
    if (handle >= I64{0}) {
        facts: jet_rt_alloc(I64{128}, I64{8})
        result := I64{0}
        #Unsafe("the freshly opened owned descriptor and the 128-byte stat fact row are live for fstat") {
            result = os_stat_facts_i64(I64{5}, fd, facts)
        }
        mode: rt_text_word(wrapping(facts + I64{16}))
        jet_rt_free(facts, I64{128}, I64{8})
        if (result < I64{0}) {
            _ := host_call(I64{3}, fd, I64{0}, I64{0})
            return compiler_fs_errno(HOST_IO_OP_READ, shown, -result, error)
        }
        if ((mode.bit_and(I64{61440})) != I64{32768}) {
            _ := host_call(I64{3}, fd, I64{0}, I64{0})
            return compiler_fs_error(HOST_IO_KIND_INVALID_INPUT, HOST_IO_OP_READ, shown, I64{0}, jet_rt_string_clone(rt_static_text("not a regular file; use open_directory for a directory")), error)
        }
    }
    rt_text_store(output, fd_new(fd, shown, false))
    I64{1}
}

// Fault, then the mapped-path refusal for a path open, then access 2 (append)
// or 1 (truncate). A raw entry name shows as in jet_std_files_open_reader.
#Export(c) jet_std_files_open_writer: fn(handle: I64, name: I64, append: Bool, if_exists: I64, mode: I64, links: I64, output: I64, error: I64) -> I64 {
    display: fs_name_display(name)
    shown: if (display == I64{0}) -> name else -> display
    result := I64{0}
    if !files_write_fault(shown, HOST_IO_OP_WRITE, error) && !(handle < I64{0} && jet_std_files_writer_refusal(name, error) != I64{0}) {
        fd: fs_open_at(handle, name, if append -> I64{2} else -> I64{1}, if_exists, mode, links, error)
        if (fd >= I64{0}) {
            rt_text_store(output, fd_new(fd, shown, true))
            result = I64{1}
        }
    }
    if (display != I64{0}) -> jet_rt_string_drop(display)
    result
}

// The `_raw` opens (Core's Directory.open_raw and create_raw): the entry name
// arrives as its exact bytes, which need not be UTF-8, is a runtime text only
// for the call, and shows as fs_name_display shows it. A final link is
// refused (links 1), never followed.
#Export(c) jet_std_files_open_reader_raw: fn(handle: I64, data: I64, length: I64, output: I64, error: I64) -> I64 {
    name: jet_raw_bytes_into_text(data, length)
    result: jet_std_files_open_reader(handle, name, I64{1}, output, error)
    jet_rt_string_drop(name)
    result
}

#Export(c) jet_std_files_open_writer_raw: fn(handle: I64, data: I64, length: I64, if_exists: I64, mode: I64, output: I64, error: I64) -> I64 {
    name: jet_raw_bytes_into_text(data, length)
    result: jet_std_files_open_writer(handle, name, false, if_exists, mode, I64{1}, output, error)
    jet_rt_string_drop(name)
    result
}

#Export(c) jet_rt_handle_drop_jet_file_writer: fn(writer: I64) { jet_fd_drop_raw(writer) }
#Export(c) jet_std_file_writer_path: fn(writer: I64) -> I64 { jet_fd_path_raw(writer) }
// Out receives a read-only view (data, len, cap) with no owner word of its own:
// a caller copies the bytes to own the path, never clones or drops the view.
// A reader's FD72 holds its path at the writer's slot.
#Export(c) jet_rt_handle_field_jet_file_writer_path: fn(writer: I64, out: I64) { coll_copy(files_writer_path(writer), out, I64{24}) }
#Export(c) jet_rt_handle_field_jet_file_reader_path: fn(reader: I64, out: I64) { coll_copy(fd_word(reader, I64{24}), out, I64{24}) }

FILES_WRITE_WHOLE_ZERO: I64{-4097}
FILES_WRITE_BUFFERED_ZERO: I64{-4098}

// BufWriter::write_all over FD72: retry Interrupted, a zero-byte direct write
// is WriteZero "failed to write whole buffer", a zero-byte buffer flush is
// WriteZero "failed to write the buffered data". Returns 0, -errno or a
// FILES_WRITE_*_ZERO fact. `bytes` are packed (stride 1).
files_writer_write: fn(writer: I64, bytes: I64, length: I64) -> I64 {
    scratch: jet_rt_alloc(I64{40}, I64{8})
    at := I64{0}
    failure := I64{0}
    loop at < length {
        rt_text_put(wrapping(scratch + I64{32}), I64{0})
        count: jet_fd_write_raw(writer, wrapping(bytes + at), length - at, scratch, wrapping(scratch + I64{32}))
        if (count < I64{0}) {
            if (rt_text_byte(wrapping(scratch + I64{32})) != I64{0}) {
                failure = FILES_WRITE_BUFFERED_ZERO
                break
            }
            code: files_out_errno(scratch)
            if (code == I64{4}) -> next
            failure = -code
            break
        }
        if (count == I64{0}) {
            failure = FILES_WRITE_WHOLE_ZERO
            break
        }
        at += count
    }
    jet_rt_free(scratch, I64{40}, I64{8})
    failure
}

files_writer_failure: fn(operation: I64, path: I64, failure: I64, error: I64) -> I64 {
    if (failure == FILES_WRITE_WHOLE_ZERO) -> return host_io_other_take(operation, jet_rt_string_clone(path), host_write_zero_text(), error)
    if (failure == FILES_WRITE_BUFFERED_ZERO) -> return host_io_other_take(operation, jet_rt_string_clone(path), jet_rt_string_clone(rt_static_text("failed to write the buffered data")), error)
    compiler_fs_errno(operation, path, -failure, error)
}

// Native U8 lists use RT_HOST_U8_STRIDE; pack once when it is not 1.
files_writer_write_list: fn(writer: I64, data: I64, length: I64) -> I64 {
    temporary: RT_HOST_U8_STRIDE != I64{1} && length != I64{0}
    packed: if temporary -> jet_rt_alloc(length, I64{8}) else -> data
    if temporary -> net_copy_packed(data, length, packed)
    failure: files_writer_write(writer, packed, length)
    if temporary -> jet_rt_free(packed, length, I64{8})
    failure
}

#Export(c) jet_std_file_writer_write_all: fn(writer: I64, data: I64, length: I64, error: I64) -> I64 {
    path: files_writer_path(writer)
    if files_write_fault(path, HOST_IO_OP_WRITE, error) -> return I64{0}
    failure: files_writer_write_list(writer, data, length)
    if (failure != I64{0}) -> return files_writer_failure(HOST_IO_OP_WRITE, path, failure, error)
    I64{1}
}

// The line, then "\n", both buffered.
#Export(c) jet_std_file_writer_write_line: fn(writer: I64, line: I64, error: I64) -> I64 {
    path: files_writer_path(writer)
    if files_write_fault(path, HOST_IO_OP_WRITE, error) -> return I64{0}
    failure := files_writer_write(writer, rt_text_data(line), rt_text_len(line))
    if (failure == I64{0}) -> failure = files_writer_write(writer, rt_text_data(rt_static_text("\n")), I64{1})
    if (failure != I64{0}) -> return files_writer_failure(HOST_IO_OP_WRITE, path, failure, error)
    I64{1}
}

// BufWriter::flush: drain the buffer (EINTR retried inside FD72); errors
// are Flush. Returns 0, -errno or FILES_WRITE_BUFFERED_ZERO.
files_writer_flush: fn(writer: I64) -> I64 {
    scratch: jet_rt_alloc(I64{40}, I64{8})
    rt_text_put(wrapping(scratch + I64{32}), I64{0})
    jet_fd_flush_raw(writer, scratch, wrapping(scratch + I64{32}))
    zero: rt_text_byte(wrapping(scratch + I64{32})) != I64{0}
    code: files_out_errno(scratch)
    jet_rt_free(scratch, I64{40}, I64{8})
    if zero -> FILES_WRITE_BUFFERED_ZERO else -> I64{0} - code
}

#Export(c) jet_std_file_writer_flush: fn(writer: I64, error: I64) -> I64 {
    path: files_writer_path(writer)
    if files_write_fault(path, HOST_IO_OP_WRITE, error) -> return I64{0}
    failure: files_writer_flush(writer)
    if (failure != I64{0}) -> return files_writer_failure(HOST_IO_OP_FLUSH, path, failure, error)
    I64{1}
}

// Flush, then sync_all (fsync, EINTR retried); both Flush.
#Export(c) jet_std_file_writer_fsync: fn(writer: I64, error: I64) -> I64 {
    path: files_writer_path(writer)
    if files_write_fault(path, HOST_IO_OP_WRITE, error) -> return I64{0}
    failure: files_writer_flush(writer)
    if (failure != I64{0}) -> return files_writer_failure(HOST_IO_OP_FLUSH, path, failure, error)
    scratch: jet_rt_alloc(I64{32}, I64{8})
    code := I64{4}
    loop code == (I64{4}) {
        jet_fd_sync_raw(writer, false, scratch)
        code = files_out_errno(scratch)
    }
    jet_rt_free(scratch, I64{32}, I64{8})
    if (code != I64{0}) -> return compiler_fs_errno(HOST_IO_OP_FLUSH, path, code, error)
    I64{1}
}

// Fstat of the open file; buffered bytes are not counted. The reader and writer
// share the FD72 carrier and jet_fs_stat_file's row.
#Export(c) jet_std_file_writer_stat: fn(writer: I64, output: I64, length: I64, error: I64) -> I64 {
    jet_std_file_reader_stat(writer, output, length, error)
}

// The open file's descriptor number, a borrowed fact for
// ProcessSpec.keep_open; a closed file is EBADF. The Core caller keeps the
// file alive until the process leaf duplicates the descriptor.
#Export(c) jet_std_file_reader_fd_raw: fn(reader: I64, ok: I64, error: I64) -> I64 {
    number: jet_fd_number_raw(reader)
    if (number < I64{0}) -> return compiler_fs_errno(HOST_IO_OP_READ, fd_word(reader, I64{24}), I64{9}, error)
    rt_text_store(ok, jet_int_owned_from_i64(number))
    I64{1}
}

// A writer's buffered bytes are flushed first, so the child's writes land
// after everything this process wrote before handing the file over.
#Export(c) jet_std_file_writer_fd_raw: fn(writer: I64, ok: I64, error: I64) -> I64 {
    path: files_writer_path(writer)
    if (jet_fd_number_raw(writer) < I64{0}) -> return compiler_fs_errno(HOST_IO_OP_WRITE, path, I64{9}, error)
    failure: files_writer_flush(writer)
    if (failure != I64{0}) -> return files_writer_failure(HOST_IO_OP_FLUSH, path, failure, error)
    jet_std_file_reader_fd_raw(writer, ok, error)
}

// Rust `{:#o}` of an i64: the 64-bit two's complement octal digits.
files_push_octal: fn(target: I64, value: I64) {
    rt_text_push_word(target, I64{28464}, I64{2}) // "0o"
    top := I64{21}
    loop top > (I64{0}) {
        digit: if (top == I64{21}) -> (value >> I64{63}).bit_and(I64{1}) else -> (value >> (top * I64{3})).bit_and(I64{7})
        if (digit != I64{0}) -> break
        top -= I64{1}
    }
    loop top >= (I64{0}) {
        digit: if (top == I64{21}) -> (value >> I64{63}).bit_and(I64{1}) else -> (value >> (top * I64{3})).bit_and(I64{7})
        rt_text_push_word(target, digit + I64{48}, I64{1})
        top -= I64{1}
    }
}

// (unix): fault, 0..=0o7777 refusal, metadata (fstat), then set_permissions
// (fchmod, EINTR retried); failures are Write.
#Export(c) jet_std_file_writer_set_mode: fn(writer: I64, mode: I64, error: I64) -> I64 {
    path: files_writer_path(writer)
    if files_write_fault(path, HOST_IO_OP_WRITE, error) -> return I64{0}
    if (mode < I64{0} || mode > I64{4095}) {
        cause: jet_rt_string_builder_new()
        jet_rt_string_builder_push(cause, rt_static_text("mode "))
        files_push_octal(cause, mode)
        jet_rt_string_builder_push(cause, rt_static_text(" is outside 0o0..0o7777"))
        return compiler_fs_error(HOST_IO_KIND_INVALID_INPUT, HOST_IO_OP_WRITE, path, I64{0}, jet_rt_string_builder_finish(cause), error)
    }
    scratch: jet_rt_alloc(I64{160}, I64{8})
    jet_fd_stat_raw(writer, scratch, wrapping(scratch + I64{128}))
    code := files_out_errno(wrapping(scratch + I64{128}))
    if (code == I64{0}) {
        code = I64{4}
        loop code == (I64{4}) {
            jet_fd_chmod_raw(writer, mode, wrapping(scratch + I64{128}))
            code = files_out_errno(wrapping(scratch + I64{128}))
        }
    }
    jet_rt_free(scratch, I64{160}, I64{8})
    if (code != I64{0}) -> return compiler_fs_errno(HOST_IO_OP_WRITE, path, code, error)
    I64{1}
}

// posix_fallocate(fd, 0, size): fallocate mode 0 reserves the blocks of
// bytes 0..size and grows a shorter file to size (EINTR retried). A negative
// size is InvalidInput, 0 does nothing; a file system that cannot reserve
// (EOPNOTSUPP) or a host without fallocate (ENOSYS) is Unsupported. Failures
// are Write.
#Export(c) jet_std_file_writer_allocate: fn(writer: I64, size: I64, error: I64) -> I64 {
    path: files_writer_path(writer)
    if files_write_fault(path, HOST_IO_OP_WRITE, error) -> return I64{0}
    if (size < I64{0}) -> return compiler_fs_error(HOST_IO_KIND_INVALID_INPUT, HOST_IO_OP_WRITE, path, I64{0}, jet_rt_string_clone(rt_static_text("a file cannot reserve a negative size")), error)
    if (size == I64{0}) -> return I64{1}
    fd: jet_fd_number_raw(writer)
    if (fd < I64{0}) -> return compiler_fs_errno(HOST_IO_OP_WRITE, path, I64{9}, error)
    result := I64{-4}
    loop result == (I64{-4}) {
        result = host_call4(I64{285}, fd, I64{0}, I64{0}, size)
    }
    if (result == I64{-95} || result == I64{-38}) -> return compiler_fs_error(HOST_IO_KIND_UNSUPPORTED, HOST_IO_OP_WRITE, path, -result, jet_rt_string_clone(rt_static_text("this file system cannot reserve space")), error)
    if (result < I64{0}) -> return compiler_fs_errno(HOST_IO_OP_WRITE, path, -result, error)
    I64{1}
}

// posix_fadvise(fd, 0, 0, advice): fadvise64 over the whole file. Core passes
// POSIX_FADV_NORMAL 0, RANDOM 1, SEQUENTIAL 2, WILLNEED 3, DONTNEED 4 or
// NOREUSE 5. Advice changes no data, so a host without fadvise64 (ENOSYS)
// and a file that takes no advice (ESPIPE: a pipe) succeed; other failures
// are Read.
#Export(c) jet_std_file_reader_advise: fn(reader: I64, advice: I64, error: I64) -> I64 {
    path: fd_word(reader, I64{24})
    fd: jet_fd_number_raw(reader)
    if (fd < I64{0}) -> return compiler_fs_errno(HOST_IO_OP_READ, path, I64{9}, error)
    result: host_call4(I64{221}, fd, I64{0}, I64{0}, advice)
    if (result == I64{-38} || result == I64{-29}) -> return I64{1}
    if (result < I64{0}) -> return compiler_fs_errno(HOST_IO_OP_READ, path, -result, error)
    I64{1}
}
