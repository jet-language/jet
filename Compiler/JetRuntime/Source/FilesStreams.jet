// CoreLib/Top/FileStream.rs open/writer leaves. JetFileReader and
// JetFileWriter share the one FD72 carrier (HostFiles.jet): its private
// 8192-byte writer buffer is BufWriter's, and its drop flushes (ignoring the
// result) then closes, as BufWriter<File>'s drop does. Held-directory and path
// opens both go through HostHeldDirectory.jet fs_open_at (jet_fs_open_at).

// FileStream.rs "fault injected: FS.Write" checkpoint (IOError::other).
fn files_write_fault(path: I64, operation: I64, error: I64) -> Bool {
    if !jet_fault_should_fail(rt_static_text("FS.Write")) -> return false
    _ := host_io_other_take(operation, jet_rt_string_clone(path), jet_rt_string_clone(rt_static_text("fault injected: FS.Write")), error)
    true
}

fn files_writer_path(writer: I64) -> I64 { fd_word(writer, I64{24}) }

// FileStream.rs:22: a held-directory member must be a regular file.
#Export(c) fn jet_std_files_open_reader(handle: I64, name: I64, links: I64, output: I64, error: I64) -> I64 {
    if compiler_fs_fault(name, error) -> return I64{0}
    fd :: fs_open_at(handle, name, I64{0}, I64{0}, I64{-1}, links, error)
    if (fd < I64{0}) -> return I64{0}
    if (handle >= I64{0}) {
        facts :: jet_rt_alloc(I64{128}, I64{8})
        result := I64{0}
        #Unsafe("the freshly opened owned descriptor and the 128-byte stat fact row are live for fstat") {
            result = os_stat_facts_i64(I64{5}, fd, facts)
        }
        mode :: rt_text_word(facts + I64{16})
        jet_rt_free(facts, I64{128}, I64{8})
        if (result < I64{0}) {
            _ := host_call(I64{3}, fd, I64{0}, I64{0})
            return compiler_fs_errno(HOST_IO_OP_READ, name, -result, error)
        }
        if ((mode.bit_and(I64{61440})) != I64{32768}) {
            _ := host_call(I64{3}, fd, I64{0}, I64{0})
            return compiler_fs_error(HOST_IO_KIND_INVALID_INPUT, HOST_IO_OP_READ, name, I64{0}, jet_rt_string_clone(rt_static_text("not a regular file; use open_directory for a directory")), error)
        }
    }
    rt_text_store(output, fd_new(fd, name, false))
    I64{1}
}

// FileStream.rs:75: fault, then the mapped-path refusal for a path open,
// then access 2 (append) or 1 (truncate).
#Export(c) fn jet_std_files_open_writer(handle: I64, name: I64, append: Bool, if_exists: I64, mode: I64, links: I64, output: I64, error: I64) -> I64 {
    if files_write_fault(name, HOST_IO_OP_WRITE, error) -> return I64{0}
    if (handle < I64{0} && jet_std_files_writer_refusal(name, error) != I64{0}) -> return I64{0}
    fd :: fs_open_at(handle, name, if append -> I64{2} else -> I64{1}, if_exists, mode, links, error)
    if (fd < I64{0}) -> return I64{0}
    rt_text_store(output, fd_new(fd, name, true))
    I64{1}
}

#Export(c) fn jet_rt_handle_drop_jet_file_writer(writer: I64) { jet_fd_drop_raw(writer) }
#Export(c) fn jet_std_file_writer_path(writer: I64) -> I64 { jet_fd_path_raw(writer) }
// CAbiRoutes.rs handle field: out is a borrowed read/clone-only Text header.
#Export(c) fn jet_rt_handle_field_jet_file_writer_path(writer: I64, out: I64) { coll_copy(files_writer_path(writer), out, I64{24}) }

FILES_WRITE_WHOLE_ZERO :: prep { I64{-4097} }
FILES_WRITE_BUFFERED_ZERO :: prep { I64{-4098} }

// BufWriter::write_all over FD72: retry Interrupted, a zero-byte direct write
// is WriteZero "failed to write whole buffer", a zero-byte buffer flush is
// WriteZero "failed to write the buffered data". Returns 0, -errno or a
// FILES_WRITE_*_ZERO fact. `bytes` are packed (stride 1).
fn files_writer_write(writer: I64, bytes: I64, length: I64) -> I64 {
    scratch :: jet_rt_alloc(I64{40}, I64{8})
    at := I64{0}
    failure := I64{0}
    loop at < length {
        rt_text_put(scratch + I64{32}, I64{0})
        count :: jet_fd_write_raw(writer, bytes + at, length - at, scratch, scratch + I64{32})
        if (count < I64{0}) {
            if (rt_text_byte(scratch + I64{32}) != I64{0}) {
                failure = FILES_WRITE_BUFFERED_ZERO
                break
            }
            code :: files_out_errno(scratch)
            if (code == I64{4}) -> next
            failure = -code
            break
        }
        if (count == I64{0}) {
            failure = FILES_WRITE_WHOLE_ZERO
            break
        }
        at += count
    }
    jet_rt_free(scratch, I64{40}, I64{8})
    failure
}

fn files_writer_failure(operation: I64, path: I64, failure: I64, error: I64) -> I64 {
    if (failure == FILES_WRITE_WHOLE_ZERO) -> return host_io_other_take(operation, jet_rt_string_clone(path), host_write_zero_text(), error)
    if (failure == FILES_WRITE_BUFFERED_ZERO) -> return host_io_other_take(operation, jet_rt_string_clone(path), jet_rt_string_clone(rt_static_text("failed to write the buffered data")), error)
    compiler_fs_errno(operation, path, -failure, error)
}

// Native U8 lists use RT_HOST_U8_STRIDE; pack once when it is not 1.
fn files_writer_write_list(writer: I64, data: I64, length: I64) -> I64 {
    temporary :: RT_HOST_U8_STRIDE != I64{1} && length != I64{0}
    packed :: if temporary -> jet_rt_alloc(length, I64{8}) else -> data
    if temporary -> net_copy_packed(data, length, packed)
    failure :: files_writer_write(writer, packed, length)
    if temporary -> jet_rt_free(packed, length, I64{8})
    failure
}

// FileStream.rs:229.
#Export(c) fn jet_std_file_writer_write_all(writer: I64, data: I64, length: I64, error: I64) -> I64 {
    path :: files_writer_path(writer)
    if files_write_fault(path, HOST_IO_OP_WRITE, error) -> return I64{0}
    failure :: files_writer_write_list(writer, data, length)
    if (failure != I64{0}) -> return files_writer_failure(HOST_IO_OP_WRITE, path, failure, error)
    I64{1}
}

// FileStream.rs:132: the line, then "\n", both buffered.
#Export(c) fn jet_std_file_writer_write_line(writer: I64, line: I64, error: I64) -> I64 {
    path :: files_writer_path(writer)
    if files_write_fault(path, HOST_IO_OP_WRITE, error) -> return I64{0}
    failure := files_writer_write(writer, rt_text_data(line), rt_text_len(line))
    if (failure == I64{0}) -> failure = files_writer_write(writer, rt_text_data(rt_static_text("\n")), I64{1})
    if (failure != I64{0}) -> return files_writer_failure(HOST_IO_OP_WRITE, path, failure, error)
    I64{1}
}

// BufWriter::flush: drain the buffer (EINTR retried inside FD72); errors
// are Flush. Returns 0, -errno or FILES_WRITE_BUFFERED_ZERO.
fn files_writer_flush(writer: I64) -> I64 {
    scratch :: jet_rt_alloc(I64{40}, I64{8})
    rt_text_put(scratch + I64{32}, I64{0})
    jet_fd_flush_raw(writer, scratch, scratch + I64{32})
    zero :: rt_text_byte(scratch + I64{32}) != I64{0}
    code :: files_out_errno(scratch)
    jet_rt_free(scratch, I64{40}, I64{8})
    if zero -> FILES_WRITE_BUFFERED_ZERO else -> I64{0} - code
}

// FileStream.rs:151.
#Export(c) fn jet_std_file_writer_flush(writer: I64, error: I64) -> I64 {
    path :: files_writer_path(writer)
    if files_write_fault(path, HOST_IO_OP_WRITE, error) -> return I64{0}
    failure :: files_writer_flush(writer)
    if (failure != I64{0}) -> return files_writer_failure(HOST_IO_OP_FLUSH, path, failure, error)
    I64{1}
}

// FileStream.rs:250: flush, then sync_all (fsync, EINTR retried); both Flush.
#Export(c) fn jet_std_file_writer_fsync(writer: I64, error: I64) -> I64 {
    path :: files_writer_path(writer)
    if files_write_fault(path, HOST_IO_OP_WRITE, error) -> return I64{0}
    failure :: files_writer_flush(writer)
    if (failure != I64{0}) -> return files_writer_failure(HOST_IO_OP_FLUSH, path, failure, error)
    scratch :: jet_rt_alloc(I64{32}, I64{8})
    code := I64{4}
    loop code == (I64{4}) {
        jet_fd_sync_raw(writer, false, scratch)
        code = files_out_errno(scratch)
    }
    jet_rt_free(scratch, I64{32}, I64{8})
    if (code != I64{0}) -> return compiler_fs_errno(HOST_IO_OP_FLUSH, path, code, error)
    I64{1}
}

// FileStream.rs:273: fstat of the open file; buffered bytes are not counted.
// The reader and writer share the FD72 carrier and jet_fs_stat_file's row.
#Export(c) fn jet_std_file_writer_stat(writer: I64, output: I64, length: I64, error: I64) -> I64 {
    jet_std_file_reader_stat(writer, output, length, error)
}

// Rust `{:#o}` of an i64: the 64-bit two's complement octal digits.
fn files_push_octal(target: I64, value: I64) {
    rt_text_push_word(target, I64{28464}, I64{2}) // "0o"
    top := I64{21}
    loop top > (I64{0}) {
        digit :: if (top == I64{21}) -> (value >> I64{63}).bit_and(I64{1}) else -> (value >> (top * I64{3})).bit_and(I64{7})
        if (digit != I64{0}) -> break
        top -= I64{1}
    }
    loop top >= (I64{0}) {
        digit :: if (top == I64{21}) -> (value >> I64{63}).bit_and(I64{1}) else -> (value >> (top * I64{3})).bit_and(I64{7})
        rt_text_push_word(target, digit + I64{48}, I64{1})
        top -= I64{1}
    }
}

// FileStream.rs:279 (unix): fault, 0..=0o7777 refusal, metadata (fstat),
// then set_permissions (fchmod, EINTR retried); failures are Write.
#Export(c) fn jet_std_file_writer_set_mode(writer: I64, mode: I64, error: I64) -> I64 {
    path :: files_writer_path(writer)
    if files_write_fault(path, HOST_IO_OP_WRITE, error) -> return I64{0}
    if (mode < I64{0} || mode > I64{4095}) {
        cause :: jet_rt_string_builder_new()
        jet_rt_string_builder_push(cause, rt_static_text("mode "))
        files_push_octal(cause, mode)
        jet_rt_string_builder_push(cause, rt_static_text(" is outside 0o0..0o7777"))
        return compiler_fs_error(HOST_IO_KIND_INVALID_INPUT, HOST_IO_OP_WRITE, path, I64{0}, jet_rt_string_builder_finish(cause), error)
    }
    scratch :: jet_rt_alloc(I64{160}, I64{8})
    jet_fd_stat_raw(writer, scratch, scratch + I64{128})
    code := files_out_errno(scratch + I64{128})
    if (code == I64{0}) {
        code = I64{4}
        loop code == (I64{4}) {
            jet_fd_chmod_raw(writer, mode, scratch + I64{128})
            code = files_out_errno(scratch + I64{128})
        }
    }
    jet_rt_free(scratch, I64{160}, I64{8})
    if (code != I64{0}) -> return compiler_fs_errno(HOST_IO_OP_WRITE, path, code, error)
    I64{1}
}
