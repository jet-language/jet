use {
    canvas_javascript_test_files: core.files
    canvas_javascript_test_process: core.process
    jet_canvas.[canvas_js]
    jet_testkit.[kit_require_tool]
}

CANVAS_JAVASCRIPT_TEST_ASSETS: "Compiler/JetCanvas/Source/CanvasAssets/js"

// `node --check` on `path`, or on stdin when `path` is "-" and `input` is the
// script; a syntax error fails the claim with Node's diagnostic.
canvas_javascript_test_syntax: fn(node: String, label: String, path: String, input: String) -[Exec, IO, Time.Wait]> {
    child: canvas_javascript_test_process.cmd([String]{node, "--check", path})
        .stdin(.Stream).stdout(.Capture).stderr(.Capture)
        .spawn() ?? panic("{label}: node --check could not start")
    child.stdin.write_text(input) ?? panic("{label}: node --check input failed")
    child.stdin.close()
    receipt: child.wait() ?? panic("{label}: node --check failed to finish")
    if !receipt.success -> panic("{label}: node --check failed\n{receipt.errors}")
}

// The actual public canvas_js() bytes against an independent oracle, not one
// extracted from the Jet implementation: the retained asset set, each asset
// syntax-checked on its own by the real Node executable (no brace counter,
// source-count assertion or success fallback), and the byte-exact ordered IIFE
// assembly, which rejects changed asset bytes, wrong order, extra separators,
// trailing statements and wrapper drift; then the assembly itself must parse.
// Without Node on PATH the claim reports skip; a missing asset or a failed
// check is fatal.
#Test("canvas_javascript_assets_are_independently_syntax_checked_and_ordered") {
    node: kit_require_tool("node") ?? return
    order: [String]{
        "runtime-state.js",
        "session-workbench.js",
        "editing-history.js",
        "diagnostics-query.js",
        "drawing-palette.js",
        "project-navigation.js",
        "graph-rendering.js",
        "inspector-connections.js",
        "input-events.js",
        "transactions-catalog.js",
        "review.js",
        "bootstrap.js"
    }
    discovered := [String]{}
    entries: canvas_javascript_test_files.list_dir(CANVAS_JAVASCRIPT_TEST_ASSETS) ?? panic("Canvas JavaScript assets are missing: {err}")
    loop entry in entries {
        if entry.name.ends_with(".js") -> discovered.push(entry.name.copy())
    }
    discovered.sort()
    retained := order.copy()
    retained.sort()
    assert(discovered == retained, "retained Canvas asset set drifted: {discovered.join(", ")}")
    expected := "(function () {{\n"
    loop name in order {
        path: "{CANVAS_JAVASCRIPT_TEST_ASSETS}/{name}"
        canvas_javascript_test_syntax(node, name, path, "")
        source: canvas_javascript_test_files.read(path) ?? panic("{name}: {err}")
        expected = "{expected}{source}"
    }
    expected = "{expected}}})();\n"
    actual: canvas_js()
    assert(actual == expected, "canvas_js() is not the exact ordered IIFE assembly")
    canvas_javascript_test_syntax(node, "canvas-app.js", "-", actual)
}

// This leaf compiles JavaScript but does not execute the browser app. Actual
// canvas-workbench-e2e/session-surface-matrix/devserver-real-client-survival
// and canvas_cli_lifecycle remain browser/checked producer/runtime/serving-host
// integration gates. In particular the retained runtime-state request token
// policy is unchanged; syntax/order proof is not an authentication claim.
