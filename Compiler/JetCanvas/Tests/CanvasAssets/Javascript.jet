use core.process as canvas_javascript_test_process

// Rust tests/canvas.rs:6080–6157, retaining actual independent Node syntax
// checks and the byte-exact load-order oracle, not its incidental glue LOC
// assertion. Missing Node/assets or a failed harness is fatal, never skipped.
#Test("canvas_javascript_assets_are_independently_syntax_checked_and_ordered") {
    child :: canvas_javascript_test_process.cmd([String]{"node", "Compiler/JetCanvas/Tests/CanvasAssets/javascript-assets.mjs"})
        .stdin(.Stream).stdout(.Capture).stderr(.Capture)
        .spawn() ?? panic("Canvas JavaScript proof requires Node and its asset harness")
    child.stdin.write(canvas_js()) ?? panic("Canvas JavaScript proof input failed")
    child.stdin.close()
    receipt :: child.wait() ?? panic("Canvas JavaScript proof failed to finish")
    if !receipt.success -> panic("Canvas JavaScript syntax/order proof: {receipt.errors}")
}

// This leaf compiles JavaScript but does not execute the browser app. Actual
// canvas-workbench-e2e/session-surface-matrix/devserver-real-client-survival
// and canvas_cli_lifecycle remain browser/checked producer/runtime/serving-host
// integration gates. In particular the retained runtime-state request token
// policy is unchanged; syntax/order proof is not an authentication claim.
