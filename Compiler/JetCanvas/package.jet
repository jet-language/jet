name: "jet_canvas"
version: "0.0.1"
edition: "2026"
deps: {
    jet_foundation: ../JetFoundation,
    jet_parser: ../JetParser,
    jet_driver: ../JetDriver,
    jet_semindex: ../JetSemIndex,
    // jet_driver's Jetpack packages sit outside Compiler/, so the root names them too (E1223).
    jet_pkg_model: ../../Jetpack/PackageModel,
    jet_env_model: ../../Jetpack/EnvModel,
    jetpack_foundation: ../../Jetpack/Foundation,
}
