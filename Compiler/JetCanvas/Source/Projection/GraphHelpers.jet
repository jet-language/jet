// What the graph projection reads off the source and the semantic index:
// ids, source offsets, titles, value types, and effect badges.
use {
    jet_foundation.[BinOp, Binding, Expr, Func, LValue, Span, type_name]
    jet_parser.[jfmt_bin_op_spell, jfmt_stmt_span]
    jet_semindex.[SemCallable, SemIndex]
}

QUERY_SCHEMA_VERSION: 1

graph_id: fn(module_display: String, f: Func) -> String Never! {
    file: if module_display.cut_last("/") == .Val(parts) -> parts.after else -> module_display
    "fn:{file}.{f.name}@{f.name_span.start}-{f.name_span.end}"
}

// `span` widened over the closing parentheses its unbalanced opening ones
// still need.
span_through_closing_parens: fn(src: String, span: Span) -> Span Never! {
    if span.start < 0 || span.end > src.len() || span.start > span.end -> return Span{start: span.start, end: span.end}
    bytes: src.bytes()
    opens := 0
    closes := 0
    loop i in span.start..<span.end {
        if bytes[i] == 40 -> opens += 1
        if bytes[i] == 41 -> closes += 1
    }
    end := span.end
    loop closes < opens && end < bytes.len() && bytes[end] == 41 {
        end += 1
        closes += 1
    }
    Span{start: span.start, end: end}
}

is_space_byte: fn(byte: Int) -> Bool Never! {
    byte == 32 || byte == 9 || byte == 10 || byte == 13 || byte == 12
}

insert_offset: fn(src: String, f: Func) -> Int Never! {
    if f.body.len() > 0 {
        first_start: jfmt_stmt_span(f.body[0]).start
        line: line_start(src, first_start)
        if src.slice(line, first_start).contains("{{") -> return first_start
        return line
    }
    line_after(src, f.name_span.end)
}

line_start: fn(src: String, offset: Int) -> Int Never! {
    limit: if offset < src.len() -> offset else -> src.len()
    if src.slice(0, limit).last_index_of("\n") == .Val(i) -> return i + 1
    0
}

line_after: fn(src: String, offset: Int) -> Int Never! {
    from: if offset < src.len() -> offset else -> src.len()
    if src.slice(from, src.len()).index_of("\n") == .Val(i) -> return from + i + 1
    src.len()
}

assignment_title: fn(target: LValue, op: BinOp?) -> String Never! {
    op_text: if op == .Val(value) -> "{jfmt_bin_op_spell(value)}=" else -> "="
    if target == {
        .Local(name, _) -> "{name} {op_text}"
        .Index(_, _, _, _) -> "index {op_text}"
        .Field(_, field, _) -> ".{field} {op_text}"
    }
}

lvalue_type: fn(g: GraphBuilder, target: LValue) -> String Never! {
    if target == .Local(name, _) {
        if g.local_types.get(name) == .Val(ty) -> return ty
    }
    "unknown"
}

expr_title: fn(expr: Expr) -> String Never! {
    if expr == {
        .StructLit(_, _, _, _, _, _, _, _) -> "construct"
        .EnumLit(_, _, _, _, _, _, _) -> "variant"
        .Lambda(_, _) -> "lambda"
        .If(_, _, _, _, _, _, _) -> "if expression"
        .ListLit(_, _, _) -> "list"
        .MapLit(_, _, _) -> "map"
        .TupleLit(_, _, _, _) -> "tuple"
        .Index(_, _, _, _, _) -> "index"
        .Slice(_, _, _, _, _, _) -> "slice"
        .CallValue(_, _, _, _) -> "call value"
        .Deref(_, _, _) -> "unsafe expr"
        .RawOf(_, _, _) -> "unsafe expr"
        .PtrFromAddr(_, _, _, _, _, _) -> "unsafe expr"
        .OrFallback(_, _, _, _, _) -> "fallback"
        .PatternTest(_, _, _, _) -> "pattern test"
        .Try(_, _, _, _, _) -> "fallible"
        .Pipe(_, _, _, _) -> "pipe"
        .Str(_, _, _) | .StrMatchLit(_, _, _) | .BinMatchLit(_, _, _) | .Int(_, _, _, _, _) | .Float(_, _, _, _, _) | .Bool(_, _, _) | .Unit(_, _) | .Char(_, _, _) | .MemberSpread(_, _, _, _) | .Spread(_, _, _) | .Range(_, _, _, _, _) | .Ident(_, _, _) | .Call(_, _) | .Unary(_, _, _, _) | .Binary(_, _, _, _, _) | .CompareChain(_, _, _, _, _) | .UnitLit(_, _, _, _, _, _, _) | .Copy(_, _, _) | .Place(_, _, _, _) | .Field(_, _, _, _) | .OptField(_, _, _, _, _, _) | .MethodCall(_, _, _, _, _, _, _) | .OptMethodCall(_, _, _, _, _, _, _) | .TypedLit(_, _, _, _) | .Tainted(_, _, _, _) | .Present(_, _, _) | .Absent(_, _) | .Todo(_, _, _) | .NoElse(_, _) | .Ok(_, _, _) | .Err(_, _, _) | .ComptimeName(_, _, _, _) | .TypeValue(_, _, _) | .Paren(_, _, _) -> "expression"
    }
}

starts_uppercase: fn(s: String) -> Bool Never! {
    bytes: s.bytes()
    bytes.len() > 0 && bytes[0] >= 65 && bytes[0] <= 90
}

binding_type: fn(g: GraphBuilder, name: String, b: Binding) -> String Never! {
    if b.ty == .Val(ty) -> return type_name(ty)
    if g.local_types.get(name) == .Val(ty) -> return ty
    "unknown"
}

expr_type: fn(g: GraphBuilder, index: SemIndex, expr: Expr) -> String Never! {
    if expr == {
        .Int(_, _, _, _, _) -> "Int"
        .Float(_, _, is_f32, _, _) -> if is_f32 -> "F32" else -> "Float"
        .Bool(_, _, _) -> "Bool"
        .Str(_, _, _) -> "String"
        .Char(_, _, _) -> "Char"
        .Ident(name, _, _) -> ident_type(g, index, name)
        .Binary(op, left, _, _, _) -> if op_is_bool(op) -> "Bool" else -> expr_type(g, index, left)
        .Call(call, _) -> call_ret(index, call.name) ?? "unknown"
        .Try(inner, _, _, _, _) -> expr_type(g, index, inner).remove_suffix("?")
        .StrMatchLit(_, _, _) | .BinMatchLit(_, _, _) | .Unit(_, _) | .ListLit(_, _, _) | .MemberSpread(_, _, _, _) | .Spread(_, _, _) | .MapLit(_, _, _) | .Index(_, _, _, _, _) | .Slice(_, _, _, _, _, _) | .Range(_, _, _, _, _) | .Unary(_, _, _, _) | .CompareChain(_, _, _, _, _) | .UnitLit(_, _, _, _, _, _, _) | .Deref(_, _, _) | .RawOf(_, _, _) | .Copy(_, _, _) | .Place(_, _, _, _) | .Field(_, _, _, _) | .OptField(_, _, _, _, _, _) | .MethodCall(_, _, _, _, _, _, _) | .OptMethodCall(_, _, _, _, _, _, _) | .StructLit(_, _, _, _, _, _, _, _) | .TypedLit(_, _, _, _) | .EnumLit(_, _, _, _, _, _, _) | .Tainted(_, _, _, _) | .Present(_, _, _) | .Absent(_, _) | .Todo(_, _, _) | .NoElse(_, _) | .PatternTest(_, _, _, _) | .Ok(_, _, _) | .Err(_, _, _) | .OrFallback(_, _, _, _, _) | .If(_, _, _, _, _, _, _) | .TupleLit(_, _, _, _) | .Lambda(_, _) | .CallValue(_, _, _, _) | .PtrFromAddr(_, _, _, _, _, _) | .ComptimeName(_, _, _, _) | .TypeValue(_, _, _) | .Paren(_, _, _) | .Pipe(_, _, _, _) -> "unknown"
    }
}

// A local's recorded type, else the signature of the function `name` names.
ident_type: fn(g: GraphBuilder, index: SemIndex, name: String) -> String Never! {
    if g.local_types.get(name) == .Val(ty) -> return ty
    callable: callable_for_name(index, name) ?? return "unknown"
    param_text: loop param in callable.params -> type_name(param.ty)
    ret_text: if callable.return_type == .Val(ret) -> " {type_name(ret)}" else -> ""
    "fn({param_text.join(", ")}){ret_text}"
}

op_is_bool: fn(op: BinOp) -> Bool Never! {
    if op == {
        .Eq -> true
        .Ne -> true
        .Lt -> true
        .Le -> true
        .Gt -> true
        .Ge -> true
        .And -> true
        .Or -> true
        .Add | .Sub | .Mul | .Div | .FloorDiv | .Mod | .Rem | .Pow | .BitAnd | .BitOr | .BitXor | .Shl | .Shr | .Compare -> false
    }
}

call_ret: fn(index: SemIndex, name: String) -> String? Never! {
    callable: callable_for_name(index, name) ?? return None
    ret: callable.return_type ?? return None
    Val(type_name(ret))
}

callable_for_name: fn(index: SemIndex, name: String) -> SemCallable? Never! {
    loop definition in index.definitions {
        if definition.def.name != name -> next
        if definition.def.kind == .Function(callable) -> return Val(callable)
    }
    None
}

// What the checked facts say about the effects of the function `name` names:
// its declared row when it spells one, else the effects sema inferred for it.
// None when neither fact exists.
function_has_effects: fn(index: SemIndex, name: String) -> Bool? Never! {
    if callable_for_name(index, name) == .Val(callable) {
        if callable.effects == .Val(row) -> return Val(row.len() > 0)
    }
    suffix: ".{name}"
    loop fact in index.effects {
        if fact.function != name && !fact.function.ends_with(suffix) -> next
        return Val(fact.direct.len() > 0 || fact.inferred.len() > 0)
    }
    None
}

effect_badges: fn(index: SemIndex, name: String) -> [String] Never! {
    if function_has_effects(index, name) == {
        .Val(effects) -> if effects -> [String]{"effects"} else -> [String]{}
        .None -> [String]{"effects_unavailable"}
    }
}

call_has_effects: fn(index: SemIndex, name: String) -> Bool Never! {
    function_has_effects(index, name) ?? true
}

pure_leaf: fn(expr: Expr) -> Bool Never! {
    if expr == {
        .Str(_, _, _) -> true
        .Int(_, _, _, _, _) -> true
        .Float(_, _, _, _, _) -> true
        .Bool(_, _, _) -> true
        .Char(_, _, _) -> true
        .Ident(_, _, _) -> true
        .Field(_, _, _, _) -> true
        .OptField(_, _, _, _, _, _) -> true
        .Absent(_, _) -> true
        .Todo(_, _, _) -> true
        .Unary(_, inner, _, _) -> pure_leaf(inner)
        .Paren(inner, _, _) -> pure_leaf(inner)
        .Copy(inner, _, _) -> pure_leaf(inner)
        .Binary(_, left, right, _, _) -> pure_leaf(left) && pure_leaf(right)
        .CompareChain(operands, _, _, _, _) -> {
            loop operand in operands {
                if !pure_leaf(operand) -> return false
            }
            true
        }
        .MapLit(entries, _, _) -> {
            loop entry in entries {
                if !pure_leaf(entry.key) || !pure_leaf(entry.value) -> return false
            }
            true
        }
        .TupleLit(fields, _, _, _) -> {
            loop field in fields {
                if !pure_leaf(field.value) -> return false
            }
            true
        }
        .Ok(inner, _, _) -> pure_leaf(inner)
        .Err(inner, _, _) -> pure_leaf(inner)
        .Present(inner, _, _) -> pure_leaf(inner)
        .StrMatchLit(_, _, _) | .BinMatchLit(_, _, _) | .Unit(_, _) | .ListLit(_, _, _) | .MemberSpread(_, _, _, _) | .Spread(_, _, _) | .Index(_, _, _, _, _) | .Slice(_, _, _, _, _, _) | .Range(_, _, _, _, _) | .Call(_, _) | .UnitLit(_, _, _, _, _, _, _) | .Deref(_, _, _) | .RawOf(_, _, _) | .Place(_, _, _, _) | .MethodCall(_, _, _, _, _, _, _) | .OptMethodCall(_, _, _, _, _, _, _) | .StructLit(_, _, _, _, _, _, _, _) | .TypedLit(_, _, _, _) | .EnumLit(_, _, _, _, _, _, _) | .Tainted(_, _, _, _) | .NoElse(_, _) | .PatternTest(_, _, _, _) | .Try(_, _, _, _, _) | .OrFallback(_, _, _, _, _) | .If(_, _, _, _, _, _, _) | .Lambda(_, _) | .CallValue(_, _, _, _) | .PtrFromAddr(_, _, _, _, _, _) | .ComptimeName(_, _, _, _) | .TypeValue(_, _, _) | .Pipe(_, _, _, _) -> false
    }
}

wire_ident_refs: fn(g: &GraphBuilder, expr: Expr, input_pin: String) {
    if expr == .Ident(name, span, _) {
        if g.local_pins.get(name) == .Val(pin) -> add_wire_with_span(g, pin, input_pin, "data", Val(span))
    }
}

snippet: fn(src: String, span: Span) -> String Never! {
    if span.start < 0 || span.end > src.len() || span.start > span.end -> return ""
    src.slice(span.start, span.end).trim()
}

json_bool: fn(value: Bool) -> String Never! {
    if value -> "true" else -> "false"
}

query_error: fn(kind: String, message: String) -> String Never! {
    "{{\"protocol\":\"jet.canvas.query\",\"schema_version\":{QUERY_SCHEMA_VERSION},\"ok\":false,\"kind\":{json_str(kind)},\"message\":{json_str(message)}}}"
}
