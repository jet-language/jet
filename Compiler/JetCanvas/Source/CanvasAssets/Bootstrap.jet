use jet_foundation.[json_escape]

// crates/jet-canvas/src/html.rs:7–14: BOTH base insertions use Foundation's
// unquoted JSON payload escape, including the script-src position. This is
// deliberately not HTML escaping, URL normalization, or a script-end filter;
// changing that historical contract requires the asset/host owner's ruling.
fn canvas_bootstrap_for(base: String) -> String Never! {
    escaped :: json_escape(base)
    "<script>window.__JET_CANVAS_BASE__ = \"{escaped}\";</script>\n<script src=\"{escaped}/app.js?canvas_ui=blueprint23\"></script>"
}

// crates/jet-canvas/src/html.rs:16–21: query-mode route overrides precede the
// versioned app entry. These globals are transport routes, not client-derived
// semantic facts or a session copy. Session-secret injection belongs to the
// serving host, not these dependency-free public asset functions.
fn canvas_bootstrap_query() -> String Never! {
    "<script>window.__JET_CANVAS_BASE__ = \"\"; window.__JET_CANVAS_GRAPH__ = \"/?jet_panel_graph=1\"; window.__JET_CANVAS_TX__ = \"/canvas/transaction\"; window.__JET_CANVAS_QUERY__ = \"/canvas/query\"; window.__JET_CANVAS_SCM__ = \"/canvas/source-control\"; window.__JET_CANVAS_PROOF__ = \"/canvas/proof\"; window.__JET_CANVAS_COMMAND__ = \"/canvas/command\";</script>\n<script src=\"/?jet_panel_app=1&canvas_ui=blueprint23\"></script>"
}
