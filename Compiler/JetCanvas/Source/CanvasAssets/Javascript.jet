// canvas_js, exact retained IIFE assembly. One canonical independently lintable
// asset set, embedded relative to this source directory at build time and
// joined once there. No runtime cwd reads or asset concatenation.
CANVAS_JAVASCRIPT: #run {
    [String]{
        "(function () {{\n",
        embed_file("js/runtime-state.js"),
        embed_file("js/session-workbench.js"),
        embed_file("js/editing-history.js"),
        embed_file("js/diagnostics-query.js"),
        embed_file("js/drawing-palette.js"),
        embed_file("js/project-navigation.js"),
        embed_file("js/graph-rendering.js"),
        embed_file("js/inspector-connections.js"),
        embed_file("js/input-events.js"),
        embed_file("js/transactions-catalog.js"),
        embed_file("js/review.js"),
        embed_file("js/bootstrap.js"),
        "}})();\n"
    }.join("")
}

canvas_js: fn() -> String Never! {
    CANVAS_JAVASCRIPT
}
