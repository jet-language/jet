use {
    jet_devserver.[validate_project_path]
    project_files: core.files
    project_process: core.process
    project_sys: core.sys
}

#Test("project_path_validation_rejects_symlink_components") {
    if project_sys.is_windows() {
        return
    }
    root: project_files.join(project_sys.temp_dir(), "jet-canvas-project-path-{project_process.current_pid()}")
    outside: project_files.join(project_sys.temp_dir(), "jet-canvas-project-outside-{project_process.current_pid()}")
    project_files.remove_all(root).drop("a stale test root may be absent")
    project_files.remove_all(outside).drop("a stale test root may be absent")
    project_files.create_dir_all(root) ?? panic("create {root}")
    project_files.create_dir_all(outside) ?? panic("create {outside}")
    project_files.symlink(outside, project_files.join(root, "linked")) ?? panic("link {root}/linked")
    ^message: ""
    if validate_project_path(root, project_files.join(root, "linked/new.jet"), "linked/new.jet") == .Err(failure) {
        message = "{failure}"
    }
    project_files.remove_all(root).drop("test root cleanup")
    project_files.remove_all(outside).drop("test root cleanup")
    assert(message.contains("must not traverse symlinks"), "Canvas must not resolve project paths through symlinks, got `{message}`")
}
