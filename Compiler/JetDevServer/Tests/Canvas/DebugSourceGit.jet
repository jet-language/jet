// The devserver's Canvas debug sessions run on the one Canvas debug engine
// (JetCanvas CanvasDebugSession.jet) with `jet`'s own host: a native session
// pauses, resumes and stops with its paused stop kept for the devtools, and
// a native-recorded one replays a `jet run --record` recording.
use {
    debug_test_files: core.files
    debug_test_process: core.process
    jet_canvas.[CanvasHostState, canvas_host_new, source_revision]
    jet_cli.[jet_cli_canvas_debug_host]
    jet_devserver.[DebugSessions, PausedEvaluateHost, debug_sessions]
}

// A scratch directory holding `src` as `name`. It stays until the test
// removes it: a `temp_dir` would be removed when this helper returns.
debug_test_scratch: fn(name: String, src: String) -> String {
    scratch: debug_test_files.tmpdir("jet-canvas-debug-test") ?? panic("scratch: {err}")
    debug_test_files.write(debug_test_files.join(scratch, name), src) ?? panic("source: {err}")
    scratch
}

debug_test_state: fn(path: String, source_id: String) -> Shared<CanvasHostState> {
    canvas_host_new(path, source_id, "127.0.0.1") ?? panic("state: {err.message}")
}

debug_test_answer: fn(sessions: ^DebugSessions, host: ^PausedEvaluateHost, path: String, source_id: String, request: String) -> String {
    sessions.answer(host, jet_cli_canvas_debug_host(), debug_test_state(path, source_id), path, source_id, request) ?? panic("answer: {err.kind}: {err.message}")
}

debug_test_contains: fn(document: String, wanted: [String]) {
    loop field in wanted -> assert(document.contains(field), "missing {field}: {document}")
}

// A native session builds the program with `jet build -O0`, pauses it under
// Jet's native debugger at a breakpoint, keeps its paused stop for the
// devtools, resumes to the next hit, and stops.
#Test("a_native_session_builds_pauses_resumes_and_stops") {
    jet: debug_test_process.which("jet") ?? panic("the Jet dev shell puts `jet` on PATH")
    src: "double: fn(x: Int) -> Int {{\n    y: x * 2\n    y\n}}\n\nrun: fn() {{\n    count := 0\n    loop i in 0..<2 {{\n        count += double(i)\n    }}\n    print(\"count {{count}}\")\n}}\n"
    scratch: debug_test_scratch("prog.jet", src)
    path: debug_test_files.join(scratch, "prog.jet")
    revision: source_revision(src)
    sessions := debug_sessions(jet)
    host := PausedEvaluateHost{session: None, evaluator_result: None}
    first: debug_test_answer(sessions, host, path, "prog.jet", "{{\"schema_version\":1,\"revision\":\"{revision}\",\"source_id\":\"prog.jet\",\"breakpoints\":[2],\"commands\":[\"continue\"],\"watches\":[\"x\"]}}")
    debug_test_contains(first, [String]{"\"id\":\"canvas-debug-1\"", "\"state\":\"running\"", "\"tier\":\"native\"", "\"active_line\":2", "\"name\":\"x\",\"type\":\"Int\",\"value\":\"0\""})
    assert(sessions.adapters.has_key("canvas-debug-1"), "the paused stop has no adapter")
    second: debug_test_answer(sessions, host, path, "prog.jet", "{{\"schema_version\":1,\"revision\":\"{revision}\",\"source_id\":\"prog.jet\",\"session_id\":\"canvas-debug-1\",\"commands\":[\"continue\"],\"watches\":[\"x\"]}}")
    debug_test_contains(second, [String]{"\"active_line\":2", "\"name\":\"x\",\"type\":\"Int\",\"value\":\"1\""})
    stopped: debug_test_answer(sessions, host, path, "prog.jet", "{{\"schema_version\":1,\"revision\":\"{revision}\",\"source_id\":\"prog.jet\",\"session_id\":\"canvas-debug-1\",\"tier\":\"native\",\"stop\":true}}")
    debug_test_contains(stopped, [String]{"\"state\":\"stopped\"", "\"overlay\":null"})
    assert(sessions.debugs.sessions.len() == 0)
    assert(sessions.adapters.len() == 0)
    debug_test_files.remove_all(scratch) ?? panic("scratch cleanup: {err}")
}

// A native-recorded session replays the recording `jet run --record=canvas`
// made, as `jet debug --replay` does: it stops at the third pass of line 21
// and goes back to the second with reverse-continue.
#Test("a_recorded_session_replays_its_recording") {
    jet: debug_test_process.which("jet") ?? panic("the Jet dev shell puts `jet` on PATH")
    src: "Score: struct {{\n    count: Int,\n}}\n\ndouble: fn(x: Int) -> Int {{\n    y: x * 2\n    y\n}}\n\nbump: fn(rounds: Int, tally: Shared<Score>) -> Int {{\n    loop _ in 0..<rounds -> tally.count += 1\n    rounds\n}}\n\nrun: fn() {{\n    tally: Shared{{Score{{count: 0}}}}\n    helper: task bump(3, tally)\n    total := 0\n    loop k in 0..<3 {{\n        d: double(k)\n        total += d\n    }}\n    print(\"total {{total}} tally {{tally.count + (helper.join() ?? 0)}}\")\n}}\n"
    scratch: debug_test_scratch("main.jet", src)
    debug_test_files.write(debug_test_files.join(scratch, "package.jet"), "name: \"canvas_replay\"\nversion: \"0.1.0\"\nauthority: {{\n    allow: [IO, Time]\n}}\n") ?? panic("package: {err}")
    recorded: debug_test_process.cmd([String]{jet, "run", "--record=canvas", "main.jet"}).cwd(scratch).stdout(.Capture).stderr(.Capture).run() ?? panic("jet run --record: {err}")
    assert(recorded.success, "jet run --record=canvas main.jet failed: {recorded.output}{recorded.errors}")
    path: debug_test_files.join(scratch, "main.jet")
    revision: source_revision(src)
    sessions := debug_sessions(jet)
    host := PausedEvaluateHost{session: None, evaluator_result: None}
    replayed: debug_test_answer(sessions, host, path, "main.jet", "{{\"schema_version\":1,\"revision\":\"{revision}\",\"source_id\":\"main.jet\",\"recording\":\"canvas\",\"breakpoints\":[21],\"commands\":[\"continue\",\"continue\",\"continue\"]}}")
    debug_test_contains(replayed, [String]{"\"tier\":\"native-recorded\"", "\"active_line\":21", "\"name\":\"d\",\"type\":\"Int\",\"value\":\"4\""})
    back: debug_test_answer(sessions, host, path, "main.jet", "{{\"schema_version\":1,\"revision\":\"{revision}\",\"source_id\":\"main.jet\",\"session_id\":\"canvas-debug-1\",\"tier\":\"native-recorded\",\"commands\":[\"reverse-continue\"]}}")
    debug_test_contains(back, [String]{"\"tier\":\"native-recorded\"", "\"active_line\":21", "\"name\":\"d\",\"type\":\"Int\",\"value\":\"2\""})
    sessions.debugs.release_all()
    debug_test_files.remove_all(scratch) ?? panic("scratch cleanup: {err}")
}

// A tier that is not one of the native tiers is refused, and the session
// it names is kept.
#Test("only_the_native_tiers_are_served") {
    jet: debug_test_process.which("jet") ?? panic("the Jet dev shell puts `jet` on PATH")
    src: "run: fn() {{\n    print(\"ok\")\n}}\n"
    scratch: debug_test_scratch("prog.jet", src)
    path: debug_test_files.join(scratch, "prog.jet")
    sessions := debug_sessions(jet)
    host := PausedEvaluateHost{session: None, evaluator_result: None}
    request: "{{\"schema_version\":1,\"revision\":\"{source_revision(src)}\",\"source_id\":\"prog.jet\",\"tier\":\"interpreted\"}}"
    if sessions.answer(host, jet_cli_canvas_debug_host(), debug_test_state(path, "prog.jet"), path, "prog.jet", request) == {
        .Err(failure) -> {
            assert(failure.kind == "bad_request", "{failure.kind}: {failure.message}")
        }
        .Ok(document) -> panic("an unknown tier was served: {document}")
    }
    assert(sessions.debugs.sessions.len() == 0)
    debug_test_files.remove_all(scratch) ?? panic("scratch cleanup: {err}")
}
