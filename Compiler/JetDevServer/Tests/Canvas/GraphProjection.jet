use {
    jet_devserver.[call_close_after, constructor_type, event_call_span, event_constructor_kind, event_method_kind, event_module_aliases]
    jet_foundation.[Span]
    jet_parser.[parse_source]
}

#Test("event_aliases_are_deduplicated_and_constructor_receiver_is_required") {
    src: "use events: core.event\nuse events: core.event // duplicate\nuse tasks: core.tasks\nevents.new<Int>()\n"
    aliases: event_module_aliases(parse_source(src.bytes()).program.imports)
    assert_eq(aliases, [String]{"events"})
    start: src.find("new<Int>")
    span: Span{start: start, end: start + 3}
    assert_eq(event_constructor_kind(src, span, "new", aliases), .Val("event_stream_create"))
    assert_eq(constructor_type("new", "new<Int>()"), .Val("Event<Int>"))
    assert_eq(event_constructor_kind("new<Int>()", Span{start: 0, end: 3}, "new", aliases), None)
    assert_eq(constructor_type("new", "new()"), None)
}

#Test("call_spans_balance_nested_calls_and_ignore_quoted_parentheses") {
    src: "emit(other(1), \"a)\\\"b(\") trailing"
    open: src.find("(")
    end: src.find(" trailing")
    assert_eq(call_close_after(src, open), .Val(end))
    assert_eq(event_call_span(src, Span{start: 0, end: 4}), .Val(Span{start: 0, end: end}))
    assert_eq(call_close_after("call(\"unterminated", 4), None)
    assert_eq(event_call_span("call", Span{start: 0, end: 4}), None)
}

#Test("event_method_projection_preserves_receiver_type_semantics") {
    assert_eq(event_method_kind("Event<Int>", "on"), .Val("event_subscribe"))
    assert_eq(event_method_kind("AsyncEvent<Int>", "blocked_count"), .Val("event_pending_count"))
    assert_eq(event_method_kind("DecisionHook<Int>", "run"), .Val("decision_hook_run"))
    assert_eq(event_method_kind("EventTrace", "dropped"), .Val("event_trace_count"))
    assert_eq(event_method_kind("DispatchReport<Int>", "failures"), .Val("event_report_failures"))
    assert_eq(event_method_kind("Event<Int>", "emit_async"), None)
    assert_eq(event_method_kind("NotAnEvent", "on"), None)
}
