// Canvas debugging: the devserver answers each debug request with the one
// Canvas debug engine (JetCanvas CanvasDebugSession.jet), on the native,
// native-recorded and native-dump tiers, and keeps the paused stop of each
// paused session for the devtools' paused evaluation (PausedEvaluate.jet).
// Also the git helpers Canvas uses.
use {
    canvas_files: core.files
    canvas_process: core.process
    jet_canvas.[CanvasDebugError, CanvasDebugHost, CanvasDebugSessions, CanvasHostState, canvas_debug_error, canvas_debug_lines, canvas_debug_payload, canvas_debug_sessions]
    jet_foundation.[sha256_bytes, sha256_hex_bytes]
}

// Git and request bodies share the devserver response bound.
MAX_DEBUG_CHILD_OUTPUT_BYTES: 67108864

// The live Canvas debug sessions, and the paused-stop adapter of each one
// paused, by id. The devserver serves Canvas requests on one task, so the
// store is plain state mutated through `^self`.
DebugSessions: struct {
    debugs: CanvasDebugSessions,
    adapters: [String:PausedDebugSessionAdapter],

    // Answer `request`, a debug request about the entry `path` whose source
    // id is `source_id`, placed on the graph `state` holds, opening a
    // session with `debug_host`; then keep `host`'s paused stop current: the
    // stop a request moved or stopped ends, a run that pauses gives its
    // session the adapter of its new stop, and a session the request ended
    // ends its adapter, stale when the source changed under it.
    answer: fn(^self, host: ^PausedEvaluateHost, debug_host: CanvasDebugHost, state: Shared<CanvasHostState>, path: String, source_id: String, request: String) -> String CanvasDebugError! {
        requested: json_string_field(request, "session_id")
        answered: if canvas_debug_payload(self.debugs, debug_host, state, path, source_id, request) == {
            .Ok(found) -> found
            .Err(failure) -> {
                if requested == .Val(id) && !self.debugs.sessions.has_key(id) {
                    if {
                        failure.kind == "conflict" -> self.stale_paused_session(host, id)
                        else -> self.clear_paused_session(host, id)
                    }
                }
                return Err(failure)
            }
        }
        if requested == .Val(id) {
            if {
                !answered.running -> self.clear_paused_session(host, id)
                else -> self.resume_paused_session(host, id)
            }
        }
        if answered.running && answered.snapshot == .Val(snapshot) {
            session: self.debugs.sessions.get(answered.id) ?? return Ok(answered.document)
            build_id: if canvas_files.read_bytes(answered.image) == {
                .Ok(bytes) -> Val("sha256-{sha256_hex_bytes(sha256_bytes(bytes[0..<bytes.len()]))}")
                .Err(_) -> None
            }
            source: PausedDebugSource{source_id: session.source_id, revision: session.revision, build_id: build_id, world_id: None}
            identity: SessionIdentity.new(answered.id, session.source_id, session.revision, snapshot.pause_id(), snapshot.frame_id()) ?? return Err(canvas_debug_error("execution", err.message))
            scope_id: "scope-{answered.id}"
            authority: paused_debugger_authority(scope_id) ?? return Err(canvas_debug_error("execution", err.message))
            adapter: paused_debug_session_adapter(identity, source, scope_id, snapshot, authority) ?? return Err(canvas_debug_error("execution", err.message))
            self.adapters[answered.id] = adapter
        }
        Ok(answered.document)
    }

    paused_adapter: fn(self, identity: SessionIdentity) -> PausedDebugSessionAdapter CanvasDebugError! {
        session: self.debugs.sessions.get(identity.session_id) ?? return Err(canvas_debug_error("session", "debug session is no longer live; start a new session"))
        if session.source_id != identity.source_id || session.revision != identity.source_revision {
            return Err(canvas_debug_error("conflict", "paused request source identity is stale"))
        }
        adapter: self.adapters.get(identity.session_id) ?? return Err(canvas_debug_error("session", "debug session has no live paused facts"))
        if adapter.identity != identity || !adapter.is_paused() {
            return Err(canvas_debug_error("conflict", "paused request identity does not match the live debug stop"))
        }
        Ok(adapter)
    }

    // The program of session `id` ended.
    clear_paused_session: fn(^self, host: ^PausedEvaluateHost, id: String) {
        ^adapter: self.adapters.remove(id) ?? {
            debug_clear_host_session(host, id)
            return
        }
        adapter.exit(host)
    }

    // The program of session `id` runs on from its stop.
    resume_paused_session: fn(^self, host: ^PausedEvaluateHost, id: String) {
        ^adapter: self.adapters.remove(id) ?? {
            debug_clear_host_session(host, id)
            return
        }
        adapter.resume(host)
    }

    // Session `id` ended because its source changed.
    stale_paused_session: fn(^self, host: ^PausedEvaluateHost, id: String) {
        ^adapter: self.adapters.remove(id) ?? {
            debug_clear_host_session(host, id)
            return
        }
        adapter.stale(host)
    }

    cancel_paused_session: fn(^self, host: ^PausedEvaluateHost, id: String, reason: String) CanvasDebugError! {
        ^adapter: self.adapters.remove(id) ?? {
            debug_clear_host_session(host, id)
            return Ok()
        }
        adapter.cancel(host, reason) ?? return Err(canvas_debug_error("execution", err.message))
        Ok()
    }

    cancel_all_paused_sessions: fn(^self, host: ^PausedEvaluateHost, reason: String) CanvasDebugError! {
        ^ids: [String]{}
        loop entry in self.adapters -> ids.push(entry.key)
        loop id in ids -> self.cancel_paused_session(host, id, reason) ?? return Err(err)
        Ok()
    }
}

// No sessions yet, each to be built by `jet`, the running `jet` itself.
debug_sessions: fn(jet: String) -> DebugSessions Never! {
    DebugSessions{debugs: canvas_debug_sessions(jet), adapters: [String:PausedDebugSessionAdapter]{}}
}

debug_clear_host_session: fn(host: ^PausedEvaluateHost, id: String) Never! {
    if host.session == .Val(injected) {
        if injected.identity.session_id == id -> host.clear_session()
    }
}

// The whitespace-separated words of `text`.
debug_words: fn(text: String) -> [String] Never! {
    ^words: [String]{}
    ^current: ""
    loop ch in text.chars() {
        piece: "{ch}"
        if {
            piece == " " || piece == "\t" || piece == "\n" || piece == "\r" -> {
                if current != "" -> words.push(current)
                current = ""
            }
            else -> current = "{current}{piece}"
        }
    }
    if current != "" -> words.push(current)
    words
}

canonical_path: fn(path: String) -> String Never! {
    if canvas_files.canonicalize(path) == {
        .Ok(resolved) -> resolved
        .Err(_) -> path
    }
}

git_root: fn(path: String) -> String? Never! {
    directory: canvas_files.dirname(path)
    text: git_output(if directory == "" -> "." else -> directory, [String]{"rev-parse", "--show-toplevel"}) ?? return None
    root: text.trim()
    if root == "" -> return None
    Val(root)
}

git_relative_path: fn(root: String, path: String) -> String Never! {
    absolute: canonical_path(path)
    base: canonical_path(root)
    ^relative: absolute
    if absolute.starts_with("{base}/") && absolute.split_once("{base}/") == .Val(parts) {
        relative = parts.after
    }
    relative.replace("\\", "/")
}

git_output: fn(root: String, args: [String]) -> String? Never! {
    argv: [String]{"git", "-C", root, ...args}
    if canvas_process.cmd(argv).stdout(.Capture).stderr(.Capture).output_limit(MAX_DEBUG_CHILD_OUTPUT_BYTES).run() == {
        .Ok(receipt) -> if receipt.success -> Val(receipt.output) else -> None
        .Err(_) -> None
    }
}

untracked_diff: fn(rel: String, src: String) -> String Never! {
    ^pieces: [String]{"--- /dev/null\n+++ b/{rel}\n"}
    loop line in canvas_debug_lines(src) -> pieces.push("+{line}\n")
    pieces.join("")
}
