// Backend-neutral capture facts and disposable-byte retention plans. No
// filesystem, CLI parser, consent identity or runtime sink. #4403: Display's
// currently checked ^^self contract mislowers to owned self; retain the real
// implementations until the canonical read-receiver fix lands.
use jet_pkg_model.[DevCaptureSetting]

DEFAULT_CAPTURE_BUDGET_BYTES: U64{268435456}

SENSITIVE_CAPTURE_CONSENT_PHRASE: "capture sensitive"

NO_CAPTURE_FLAG: "--no-capture"

// CaptureMode and its constructors/string/display projection.
CaptureMode: enum {
    Development,
    Release,

    default: fn() -> CaptureMode Never! { CaptureMode.Development }

    development: fn() -> CaptureMode Never! { CaptureMode.Development }

    release: fn() -> CaptureMode Never! { CaptureMode.Release }

    is_release: fn(self) -> Bool Never! { self == CaptureMode.Release }

    as_str: fn(self) -> String Never! {
        if self == {
            .Development -> "dev"
            .Release -> "release"
        }
    }

    impl Display {
        display: fn(self) -> String { self.as_str() }
    }
}

// Only Clock is safe without sensitive consent.
CaptureSource: enum {
    Clock,
    Randomness,
    RawInput,
    Network,

    clock: fn() -> CaptureSource Never! { CaptureSource.Clock }

    randomness: fn() -> CaptureSource Never! { CaptureSource.Randomness }

    raw_input: fn() -> CaptureSource Never! { CaptureSource.RawInput }

    network: fn() -> CaptureSource Never! { CaptureSource.Network }

    reason_code: fn(self) -> String Never! {
        if self == {
            .Clock -> "Time"
            .Randomness -> "Rand"
            .RawInput -> "Input"
            .Network -> "Net"
        }
    }

    is_safe_clock: fn(self) -> Bool Never! { self == CaptureSource.Clock }

    requires_sensitive_consent: fn(self) -> Bool Never! { !self.is_safe_clock() }

    as_str: fn(self) -> String Never! { self.reason_code() }

    impl Display {
        display: fn(self) -> String { self.reason_code() }
    }
}

// Source-relative status reasons.
CaptureLocation: struct {
    source_id: String,
    line: U32,
    column: U32?,

    new: fn(source_id: ^^String, line: U32) -> CaptureLocation Never! {
        CaptureLocation{source_id: source_id.move(), line, column: None}
    }

    with_column: fn(^^self, column: U32) -> CaptureLocation Never! {
        updated := self.move()
        updated.column = Val(column)
        updated.move()
    }

    render: fn(self) -> String Never! {
        if self.column == {
            .Val(column) -> "{self.source_id}:{self.line}:{column}"
            .None -> "{self.source_id}:{self.line}"
        }
    }

    impl Display {
        display: fn(self) -> String { self.render() }
    }
}

CaptureSourceFact: struct {
    source: CaptureSource,
    location: CaptureLocation?,

    new: fn(source: CaptureSource, location: ^^CaptureLocation?) -> CaptureSourceFact Never! {
        CaptureSourceFact{source, location: location.move()}
    }

    at: fn(source: CaptureSource, source_id: ^^String, line: U32) -> CaptureSourceFact Never! {
        CaptureSourceFact.new(source, Val(CaptureLocation.new(source_id, line)))
    }

    reason_text: fn(self) -> String Never! {
        reason: self.source.reason_code()
        if self.location == {
            .Val(location) -> "{reason} at {location.render()}"
            .None -> reason
        }
    }
}

// CaptureKind; distinct from the trace-format capture policy.
CaptureKind: enum {
    SafeClock,
    Sensitive,

    as_str: fn(self) -> String Never! {
        if self == {
            .SafeClock -> "safe"
            .Sensitive -> "sensitive"
        }
    }

    is_sensitive: fn(self) -> Bool Never! { self == CaptureKind.Sensitive }

    impl Display {
        display: fn(self) -> String { self.as_str() }
    }
}

// The package's capture policy. Release eligibility belongs to C3.
PackageCapturePolicy: struct {
    capture: DevCaptureSetting,
    budget: CaptureBudget,

    default: fn() -> PackageCapturePolicy Never! {
        PackageCapturePolicy.new(DevCaptureSetting.Default, CaptureBudget.default())
    }

    new: fn(capture: DevCaptureSetting, budget: CaptureBudget) -> PackageCapturePolicy Never! {
        PackageCapturePolicy{capture, budget}
    }

    off: fn() -> PackageCapturePolicy Never! {
        PackageCapturePolicy.new(DevCaptureSetting.Off, CaptureBudget.default())
    }

    allows_development_capture: fn(self) -> Bool Never! {
        self.capture != DevCaptureSetting.Off
    }

    with_capture: fn(self, capture: DevCaptureSetting) -> PackageCapturePolicy Never! {
        PackageCapturePolicy.new(capture, self.budget)
    }

    with_budget: fn(self, budget: CaptureBudget) -> PackageCapturePolicy Never! {
        PackageCapturePolicy.new(self.capture, budget)
    }
}

// One invocation's typed CLI fact, never global.
NoCaptureOverrideFact: struct {
    active: Bool,

    default: fn() -> NoCaptureOverrideFact Never! { NoCaptureOverrideFact.none() }

    none: fn() -> NoCaptureOverrideFact Never! { NoCaptureOverrideFact{active: false} }

    explicit: fn() -> NoCaptureOverrideFact Never! { NoCaptureOverrideFact{active: true} }

    is_active: fn(self) -> Bool Never! { self.active }

    flag: fn(self) -> String Never! { NO_CAPTURE_FLAG }
}

// Bytes of evictable artifacts, not saved bytes/index size.
CaptureBudget: struct {
    max_bytes: U64,

    default: fn() -> CaptureBudget Never! { CaptureBudget{max_bytes: DEFAULT_CAPTURE_BUDGET_BYTES} }

    new_unchecked: fn(max_bytes: U64) -> CaptureBudget Never! { CaptureBudget{max_bytes} }

    new: fn(max_bytes: U64) -> CaptureBudget CaptureBudgetError! {
        budget: CaptureBudget{max_bytes}
        budget.validate() ?? return Err(err)
        Ok(budget)
    }

    validate: fn(self) CaptureBudgetError! {
        if self.max_bytes == (U64{0}) -> return Err(CaptureBudgetError.ZeroByteLimit)
    }

    // #4433: native compiler loses method type parameters; keep the public
    // seams intact. Free planner proof does not certify these methods.
    plan_eviction: fn<I: RecordIndexRetention>(self, records: [I], incoming: I) -> CaptureEvictionPlan CaptureBudgetError! {
        plan_eviction<I>(self, records, incoming)
    }

    plan_current: fn<I: RecordIndexRetention>(self, records: [I]) -> CaptureEvictionPlan CaptureBudgetError! {
        plan_current_eviction<I>(self, records)
    }
}

// CaptureBudgetError and exact Display strings; failed plans are atomic.
#Error
CaptureBudgetError: enum {
    ZeroByteLimit,
    ArithmeticOverflow,
    EmptyArtifactID,
    DuplicateArtifactID(id: String),
    IncomingArtifactTooLarge(bytes: U64, limit: U64),
    NoEvictableRecords(retained_bytes: U64, budget: CaptureBudget),

    as_str: fn(self) -> String Never! {
        if self == {
            .ZeroByteLimit -> "capture budget byte limit must be greater than zero"
            .ArithmeticOverflow -> "capture budget arithmetic overflowed"
            .EmptyArtifactID -> "record artifact id cannot be empty"
            .DuplicateArtifactID(id) -> "record artifact id `{id}` is duplicated"
            .IncomingArtifactTooLarge(bytes, limit) -> "incoming record is {bytes} bytes, over capture budget {limit}"
            .NoEvictableRecords(retained_bytes, budget) -> "capture budget cannot retain {retained_bytes} disposable bytes within {budget.max_bytes}"
        }
    }

    impl Display {
        display: fn(self) -> String { self.as_str() }
    }
}

// RecordIndexRetention. The canonical RecordIndex adapter owns disposable
// policy; saved rows MUST return false from evictable, even when overriding it.
// Generic callers dispatch statically; no trait-object boxing or copied rows.
// #4446: night12 rejects returning the scalar self.id as View<String> (E0113);
// View<String> materializes [String], not a borrowed scalar String. Retain the
// owned return until the canonical scalar-borrow representation is available.
RecordIndexRetention: trait {
    artifact_id: fn(self) -> String Never!,
    recorded_sequence: fn(self) -> U64 Never!,
    size_bytes: fn(self) -> U64 Never!,
    saved: fn(self) -> Bool Never!,
    evictable: fn(self) -> Bool Never! {
        !self.saved()
    }
}

// Facts only, never index mutation.
CaptureEviction: struct {
    artifact_id: String,
    recorded_sequence: U64,
    size_bytes: U64,
}

CaptureEvictionPlan: struct {
    budget: CaptureBudget,
    evicted: [CaptureEviction],
    retained_bytes: U64,

    fits: fn(self) -> Bool Never! { self.retained_bytes <= self.budget.max_bytes }
}

// The eviction planners. Candidate order stores indices rather than copying
// record payloads. Incoming is not a candidate.
plan_eviction: fn<I: RecordIndexRetention>(budget: CaptureBudget, records: [I], incoming: I) -> CaptureEvictionPlan CaptureBudgetError! {
    // Wrapping read incoming in Val currently materializes I. A borrowed scalar
    // option needs the same missing canonical representation (#4446); do not
    // consume the caller's incoming record or introduce a boxed stand-in.
    plan_eviction_inner<I>(budget, records, Val(incoming))
}

plan_current_eviction: fn<I: RecordIndexRetention>(budget: CaptureBudget, records: [I]) -> CaptureEvictionPlan CaptureBudgetError! {
    plan_eviction_inner<I>(budget, records, None)
}

plan_eviction_inner: fn<I: RecordIndexRetention>(budget: CaptureBudget, records: [I], incoming: I?) -> CaptureEvictionPlan CaptureBudgetError! {
    budget.validate() ?? return Err(err)
    seen := [String:Bool]{}
    retained_bytes := U64{0}
    loop record in records {
        id: record.artifact_id()
        if id.len() == 0 -> return Err(CaptureBudgetError.EmptyArtifactID)
        if seen.has_key(id) -> return Err(CaptureBudgetError.DuplicateArtifactID{id: id.move()})
        seen[id] = true
        if record.evictable() {
            retained_bytes = capture_checked_add(retained_bytes, record.size_bytes()) ?? return Err(CaptureBudgetError.ArithmeticOverflow)
        }
    }
    if incoming == .Val(record) {
        id: record.artifact_id()
        if id.len() == 0 -> return Err(CaptureBudgetError.EmptyArtifactID)
        if seen.has_key(id) -> return Err(CaptureBudgetError.DuplicateArtifactID{id: id.move()})
        seen[id] = true
        size_bytes: record.size_bytes()
        if record.evictable() {
            if size_bytes > budget.max_bytes {
                return Err(CaptureBudgetError.IncomingArtifactTooLarge{bytes: size_bytes, limit: budget.max_bytes})
            }
            retained_bytes = capture_checked_add(retained_bytes, size_bytes) ?? return Err(CaptureBudgetError.ArithmeticOverflow)
        }
    }
    order := [Int]{}
    loop index in 0..<records.len() {
        if records[index].evictable() -> order.push(index)
    }
    // Stable bottom-up mergesort of indices by (sequence, id), O(n log n).
    scratch := order.copy()
    width := 1
    in_scratch := false
    loop width < order.len() {
        // Swap the two buffers' roles, not their contents. Moving and then
        // reinitializing loop locals currently hits night12 E0121.
        if in_scratch -> capture_merge_indices<I>(records, scratch, order, width) else {
            capture_merge_indices<I>(records, order, scratch, width)
        }
        in_scratch = !in_scratch
        width *= 2
    }
    if in_scratch -> order = scratch.move()
    evicted := [CaptureEviction]{}
    loop index in order {
        if retained_bytes <= budget.max_bytes -> break
        size: records[index].size_bytes()
        if size > retained_bytes -> return Err(CaptureBudgetError.ArithmeticOverflow)
        retained_bytes -= size
        evicted.push(CaptureEviction{artifact_id: records[index].artifact_id(), recorded_sequence: records[index].recorded_sequence(), size_bytes: size})
    }
    if retained_bytes > budget.max_bytes {
        return Err(CaptureBudgetError.NoEvictableRecords{retained_bytes, budget})
    }
    Ok(CaptureEvictionPlan{budget, evicted: evicted.move(), retained_bytes})
}

// No wrapping intermediate.
capture_checked_add: fn(left: U64, right: U64) -> U64? Never! {
    if right > (U64{18446744073709551615}) - left -> return None
    Val(left + right)
}

// One pass of the same stable bottom-up index mergesort. Both caller-owned
// buffers stay allocated; the caller alternates read/write roles each pass.
capture_merge_indices: fn<I: RecordIndexRetention>(records: [I], order: [Int], scratch: ^[Int], width: Int) Never! {
    start := 0
    loop start < order.len() {
        middle: if start + width < order.len() -> start + width else -> order.len()
        end: if middle + width < order.len() -> middle + width else -> order.len()
        left := start
        right := middle
        out := start
        loop out < end {
            take_left := right >= end
            if left < middle && right < end {
                left_seq: records[order[left]].recorded_sequence()
                right_seq: records[order[right]].recorded_sequence()
                take_left = left_seq < right_seq || (left_seq == right_seq && records[order[left]].artifact_id() <= records[order[right]].artifact_id())
            }
            if left >= middle -> take_left = false
            if take_left {
                scratch[out] = order[left]
                left += 1
            } else {
                scratch[out] = order[right]
                right += 1
            }
            out += 1
        }
        start = end
    }
}
