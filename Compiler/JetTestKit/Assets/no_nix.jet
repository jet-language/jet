// The kit's namespace launcher, ported from tests/support/no_nix_namespace.rs
// and the host-port shell wrapper. Compiler/JetTestKit/Source/NoNix.jet builds
// it once per case and starts it under the host `unshare`.
//
// `isolate: no-nix` runs it twice:
//
//   no_nix --outer BOOTSTRAP UNSHARE FLAGS... NO_NIX INNER...
//
// runs the namespace and reports a setup that never reached the subject, and
//
//   no_nix BOOTSTRAP UNSHARE MOUNT UMOUNT SH LDD TRUE UNSHARE_IMAGE MOUNT_IMAGE
//          SH_IMAGE COUNT HOST_PATH (BINARY IMAGE)*COUNT FORMAT SUBJECT ARGS...
//
// inside the new user and mount namespaces stages the store roots the
// subject and the host tools need, hides /nix behind an empty tmpfs and runs
// the subject. The mounts are the host `mount` and `umount`, run as children.
//
// A `host-port:` row runs it once, inside a fresh user and network namespace:
//
//   no_nix --netns IP [SUBJECT ARGS...]
//
// raises the namespace's loopback with the host `ip` (exit 125 when it
// can't), then runs the subject; with no subject it is the kit's probe.
//
// Every subject argument arrives as argv, never as shell source. Core has no
// exec leaf, so the subject runs as this launcher's child with inherited
// stdio, and the launcher exits with its status (a signal death as 128+n, as
// sh reports it). The child is marked to die with the launcher
// (process.run_all), so a kit timeout that kills the launcher reaches the
// subject too.
use {
    files: core.files
    process: core.process
    term: core.term
}

NO_NIX_FAILED: "JET_TESTKIT_NO_NIX_SETUP_FAILED"

run: fn() {
    args: process.args()
    if args.len() > 1 && args[0] == "--outer" -> no_nix_outer(args[1], args.slice(2, args.len()))
    if args.len() > 1 && args[0] == "--netns" -> no_nix_netns(args[1], args.slice(2, args.len()))
    if args.len() < 14 -> no_nix_fail("the launcher takes BOOTSTRAP, 6 tools, 3 images, COUNT, HOST_PATH, the subjects and the step")
    no_nix_inner(args)
}

no_nix_say: fn(text: String) {
    errors := term.stderr()
    errors.write(text).drop("no-nix stderr")
}

// The subject's status as the kit would have seen it from sh: a subject's
// 101 (a Jet defect) passes through unchanged.
no_nix_exit: fn(code: Int) -> Never {
    #Unsafe("the no-nix launcher passes its subject's status 101 through unchanged; process.exit would report it as 1 (S36)") {
        process.exit_unmapped(code)
    }
}

// A setup failure: the reason, then the marker the kit reports as ERROR.
no_nix_fail: fn(reason: String) -> Never {
    no_nix_say("no-nix: {reason}\n{NO_NIX_FAILED}\n")
    process.exit(1)
}

// Run `spec` to completion as a child that dies with this process; a signal
// death reads as 128+n.
no_nix_wait: fn(spec: ProcessSpec, what: String) -> Int {
    results: process.run_all([ProcessSpec]{spec}, 1) ?? no_nix_fail("{what} could not start: {err}")
    if results[0] == {
        .Ok(receipt) -> if receipt.signal == .Val(number) -> 128 + number else -> receipt.code
        .Err(error) -> no_nix_fail("{what} could not start: {error}")
    }
}

// The namespace runner: unshare runs the inner launcher; a run that never
// wrote BOOTSTRAP/entered failed before the subject started.
no_nix_outer: fn(bootstrap: String, argv: [String]) -> Never {
    if argv.len() == 0 -> no_nix_fail("--outer takes BOOTSTRAP and the unshare command")
    status: no_nix_wait(process.cmd(argv).stdin(.Inherit).stdout(.Inherit).stderr(.Inherit), argv[0])
    if !files.exists(files.join(bootstrap, "entered")) -> no_nix_say("{NO_NIX_FAILED}\n")
    no_nix_exit(status)
}

// The network-namespace runner. A loopback that won't come up is 125, a
// subject that can't start 127, as the shell wrapper's `exit 125` and `exec`.
no_nix_netns: fn(ip: String, argv: [String]) -> Never {
    raise: process.cmd([ip, "link", "set", "lo", "up"]).stdout(.Inherit).stderr(.Inherit)
    raised: no_nix_netns_run(raise, ip, 125)
    if raised != 0 -> process.exit(125)
    if argv.len() == 0 -> process.exit(0)
    no_nix_exit(no_nix_netns_run(process.cmd(argv).stdin(.Inherit).stdout(.Inherit).stderr(.Inherit), argv[0], 127))
}

// `spec`'s status as a child that dies with this process (a signal death as
// 128+n); one that can't start stops the launcher with `refused`.
no_nix_netns_run: fn(spec: ProcessSpec, what: String, refused: Int) -> Int {
    results: process.run_all([ProcessSpec]{spec}, 1) ?? no_nix_netns_refuse("{what} could not start: {err}", refused)
    if results[0] == {
        .Ok(receipt) -> if receipt.signal == .Val(number) -> 128 + number else -> receipt.code
        .Err(error) -> no_nix_netns_refuse("{what} could not start: {error}", refused)
    }
}

no_nix_netns_refuse: fn(reason: String, code: Int) -> Never {
    no_nix_say("netns: {reason}\n")
    process.exit(code)
}

// A host tool run before the subject, on the host PATH; its output is the
// step's, as the shell launcher's was.
no_nix_tool: fn(argv: [String], host_path: String) {
    status: no_nix_wait(process.cmd(argv).env("PATH", host_path).stdout(.Inherit).stderr(.Inherit), argv[0])
    if status != 0 -> no_nix_fail("{argv.join(" ")} exited {status}")
}

// `readlink -f`, or "" for a path that does not resolve.
no_nix_real: fn(path: String) -> String {
    files.canonicalize(path) ?? ""
}

// The words `ldd` prints for `path`. Root discovery is best effort: `ldd`
// reports "not a dynamic executable" for scripts (ldd itself is one) and
// static binaries, and that report must not reach the subject's stderr.
no_nix_ldd: fn(ldd: String, path: String, host_path: String) -> [String] {
    words := [String]{}
    spec: process.cmd([ldd, path]).env("PATH", host_path).stdout(.Capture).stderr(.Capture)
    results: process.run_all([ProcessSpec]{spec}, 1) ?? return words
    if results[0] == {
        .Ok(receipt) -> {
            loop word in receipt.output.replace("\t", " ").replace("\n", " ").split(" ") {
                if word != "" -> words.push(word.copy())
            }
        }
        .Err(_) -> {}
    }
    words
}

// The /nix/store/NAME root of `path` and of what it resolves to.
no_nix_store_root: fn(path: String, roots: &[String]) {
    loop candidate in [path.copy(), no_nix_real(path)] {
        if !candidate.starts_with("/nix/store/") -> next
        rest: candidate.slice(11, candidate.len())
        name: if rest.index("/") == .Val(slash) -> rest.slice(0, slash) else -> rest.copy()
        root: "/nix/store/{name}"
        if !roots.contains(root) -> roots.push(root)
    }
}

no_nix_roots_of: fn(ldd: String, path: String, host_path: String, roots: &[String]) {
    if files.is_file(path) {
        loop word in no_nix_ldd(ldd, path, host_path) -> no_nix_store_root(word, roots)
    }
    no_nix_store_root(path, roots)
}

// The Nix loader that runs the staged Nix tools and any dynamic ELF subject.
// A static subject (the Jet-built `jet` and `jetpack` are static) names none,
// so the tools are searched after the subjects.
no_nix_loader: fn(ldd: String, candidates: [String], host_path: String) -> String {
    loop path in candidates {
        loop word in no_nix_ldd(ldd, path, host_path) {
            if word.contains("/ld-linux") && word.contains(".so") -> return word
        }
    }
    ""
}

no_nix_stage_path: fn(stage: String, path: String) -> String {
    if path.starts_with("/nix/store/") -> "{stage}/store/{path.slice(11, path.len())}" else -> path.copy()
}

// `ln -sf TARGET LINK`.
no_nix_link: fn(target: String, link: String) {
    if files.is_symlink(link) || files.exists(link) -> files.remove(link) ?? no_nix_fail("replace {link}: {err}")
    files.symlink(target, link) ?? no_nix_fail("link {link}: {err}")
}

no_nix_inner: fn(args: [String]) -> Never {
    bootstrap: args[0]
    unshare: args[1]
    mount: args[2]
    umount: args[3]
    shell: args[4]
    ldd: args[5]
    true_binary: args[6]
    images: args.slice(7, 10)
    count: Int.parse(args[10]) ?? no_nix_fail("COUNT is not an Int: {args[10]}")
    host_path: args[11]
    if count < 1 || args.len() < 14 + 2 * count -> no_nix_fail("COUNT {count} does not match the subjects")
    pairs: args.slice(12, 12 + 2 * count)
    rest: args.slice(12 + 2 * count, args.len())
    subject_format: rest[0]
    subject_real: no_nix_real(pairs[0])
    host_nix: files.join(bootstrap, "host")
    stage: files.join(bootstrap, "runtime")
    mount_real: no_nix_real(mount)
    umount_real: no_nix_real(umount)

    roots := [String]{}
    loop i in 0..<count -> no_nix_roots_of(ldd, pairs[2 * i], host_path, roots)
    loop path in ["/bin", "/bin/sh", "/run/current-system/sw"] -> no_nix_roots_of(ldd, path, host_path, roots)
    loop tool in [unshare, mount, umount, shell, ldd, true_binary] -> no_nix_roots_of(ldd, tool, host_path, roots)
    roots.sort()

    candidates := [String]{}
    loop i in 0..<count -> candidates.push(pairs[2 * i].copy())
    loop tool in [mount_real, umount_real, shell] -> candidates.push(tool.copy())
    loader: no_nix_loader(ldd, candidates, host_path)
    // The loader's directory is held before /nix is hidden and passed to the
    // subject at fd 9: the kit rewrote each staged Nix image's interpreter to
    // /proc/self/fd/9/LOADER, so the subject's own children still start.
    loader_real: if loader == "" -> "" else -> no_nix_real(loader)
    if loader != "" && loader_real == "" -> no_nix_fail("the loader {loader} does not resolve")
    held := [Directory]{}
    if loader_real != "" -> held.push(files.open_directory(files.dirname(loader_real)) ?? no_nix_fail("hold the loader directory: {err}"))
    subject_dynamic: no_nix_dynamic(ldd, subject_real, host_path)

    loop path in ["/nix", host_nix, files.join(stage, "store"), files.join(stage, "usr/bin")] {
        files.create_dir_all(path) ?? no_nix_fail("mkdir {path}: {err}")
    }
    no_nix_tool([mount_real, "--rbind", "/nix", host_nix], host_path)
    no_nix_tool([mount_real, "--make-rslave", host_nix], host_path)
    loop root in roots {
        name: files.basename(root)
        staged: files.join(files.join(stage, "store"), name)
        files.create_dir_all(staged) ?? no_nix_fail("mkdir {staged}: {err}")
        no_nix_tool([mount_real, "--rbind", files.join(files.join(host_nix, "store"), name), staged], host_path)
        no_nix_tool([mount_real, "--make-rslave", staged], host_path)
    }
    library_dirs := [String]{}
    loop root in roots {
        loop libdir in ["lib", "lib64"] {
            path: files.join(files.join(files.join(stage, "store"), files.basename(root)), libdir)
            if files.is_dir(path) -> library_dirs.push(path)
        }
    }
    library_path: library_dirs.join(":")
    loop i in 0..<count {
        if pairs[2 * i + 1] != "" -> no_nix_tool([mount_real, "--bind", pairs[2 * i + 1], pairs[2 * i]], host_path)
    }
    no_nix_trust_store(bootstrap, mount_real, host_path)
    usr_bin: files.join(stage, "usr/bin")
    no_nix_link(no_nix_stage_path(stage, no_nix_real(true_binary)), files.join(usr_bin, "true"))
    loop (i, name) in ["unshare", "mount", "sh"] {
        if images[i] != "" -> no_nix_link(images[i], files.join(usr_bin, name))
    }
    if images[0] != "" || images[1] != "" || images[2] != "" {
        no_nix_tool([mount_real, "--bind", usr_bin, "/usr/bin"], host_path)
        no_nix_tool([mount_real, "--bind", usr_bin, "/bin"], host_path)
    }
    staged_loader: no_nix_stage_path(stage, loader_real)
    no_nix_tool(no_nix_via(staged_loader, library_path, [no_nix_stage_path(stage, mount_real), "-t", "tmpfs", "-o", "mode=0755", "jet-no-nix", "/nix"]), host_path)
    no_nix_tool(no_nix_via(staged_loader, library_path, [no_nix_stage_path(stage, umount_real), "-l", host_nix]), host_path)
    if files.exists("/nix/store") || files.is_symlink("/nix/store") {
        no_nix_say("test child started with a visible /nix/store\n{NO_NIX_FAILED}\n")
        process.exit(125)
    }
    previous: process.env_get("LD_LIBRARY_PATH") ?? ""
    files.write(files.join(bootstrap, "entered"), "") ?? no_nix_fail("write the entered marker: {err}")
    // The step's own environment (PATH included) is the subject's; only the
    // staged library path is added, and it stays visible to nested children.
    subject: no_nix_stage_path(stage, subject_real)
    argv := [String]{}
    if subject_format == "elf" && subject_dynamic && loader_real != "" {
        argv = no_nix_via(staged_loader, library_path, [subject.copy()])
    } else {
        argv.push(subject.copy())
    }
    loop argument in rest.slice(2, rest.len()) -> argv.push(argument.copy())
    spec := process.cmd(argv).env("LD_LIBRARY_PATH", if previous == "" -> library_path else -> "{library_path}:{previous}")
        .stdin(.Inherit).stdout(.Inherit).stderr(.Inherit)
    if held.pop() == .Val(directory) -> spec = spec.keep_open(directory, at: 9)
    no_nix_exit(no_nix_wait(spec, subject))
}

// Whether `ldd` accepts `path` as a dynamic executable.
no_nix_dynamic: fn(ldd: String, path: String, host_path: String) -> Bool {
    spec: process.cmd([ldd, path]).env("PATH", host_path).stdout(.Capture).stderr(.Capture)
    results: process.run_all([ProcessSpec]{spec}, 1) ?? return false
    if results[0] == {
        .Ok(receipt) -> receipt.code == 0 && receipt.signal == None
        .Err(_) -> false
    }
}

// `argv` through the staged loader, or as it is on a host without one.
no_nix_via: fn(loader: String, library_path: String, argv: [String]) -> [String] {
    if loader == "" -> return argv.copy()
    result := [String]{loader.copy()}
    if library_path != "" {
        result.push("--library-path")
        result.push(library_path.copy())
    }
    loop argument in argv -> result.push(argument.copy())
    result
}

// A host without Nix keeps its system trust store under /etc/ssl/certs. On a
// Nix host those entries link into /nix/store, which the subject must not see,
// so the subject gets a directory of real copies of the files they name.
no_nix_trust_store: fn(bootstrap: String, mount_real: String, host_path: String) {
    trust_store: "/etc/ssl/certs"
    if !files.is_dir(trust_store) -> return
    entries: files.list_dir(trust_store) ?? return
    from_nix := false
    loop entry in entries {
        if !entry.name.starts_with(".") && no_nix_real(entry.path).starts_with("/nix/store/") -> from_nix = true
    }
    if !from_nix -> return
    trust_stage: files.join(bootstrap, "ssl-certs")
    files.create_dir_all(trust_stage) ?? no_nix_fail("mkdir {trust_stage}: {err}")
    loop entry in entries {
        if entry.name.starts_with(".") -> next
        resolved: no_nix_real(entry.path)
        if resolved == "" || !files.is_file(resolved) -> next
        bytes := files.read_bytes(resolved) ?? no_nix_fail("read {resolved}: {err}")
        if bytes.len() > 0 && bytes[bytes.len() - 1] != (U8{10}) -> bytes.push(U8{10})
        files.write_bytes(files.join(trust_stage, entry.name), bytes) ?? no_nix_fail("copy {resolved}: {err}")
    }
    no_nix_tool([mount_real, "--bind", trust_stage, trust_store], host_path)
}
