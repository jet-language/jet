// The testkit's shared nominal types, step sequencer, suite table and corpus pool
// (kit_execute_suites), which `jet test --profile` runs in process.
use {
    process: core.process
    files: core.files
    json: core.encoding.json
    sys: core.sys
    time: core.time
}

KitEnv: struct {
    root: String
    scratch: String
    jet: String
    jetpack: String
    timeout: Duration
    // A case's `limit: memory=`, Core memory_limit semantics; 0 is none.
    memory_limit: Int
    // Run-wide resident-memory (VmRSS) guard in bytes; 0 is none. A case's
    // `limit: resident=` tightens it and sets `resident_tree`.
    resident_limit: Int{0}
    // Count the child's live descendants too, not only the child.
    resident_tree: Bool{false}
    env_clear: Bool{false}
    // The tested jet's JET_VERSION (`a0.0.43`, `{jet-semver}`) and its whole
    // `jet --version` spelling after `jet ` (`a0.0.43-dev+29517f5447`); a
    // `normalize: version` row writes each as VERSION.
    version: String{""}
    version_display: String{""}
    version_error: String{""}
    // The entry's memory claim so far (kit_exec_run): its children's largest
    // resident peak plus the files a row held on a memory-backed scratch. None
    // keeps none.
    peak: Shared<KitPeak>?{None}
    // The rows' scratch is memory-backed (kit_exec_memory_backed): their files
    // count as memory they hold.
    scratch_memory: Bool{false}
    // The FFI cache children share across runs; "" keeps one per run under `scratch`.
    ffi_cache: String{""}
    // The unpacked C toolchain pack children compile C with
    // (JET_CC_PACK_ROOT); "" leaves each child to its jetpack.
    cc_pack: String{""}
    // A cap in nanoseconds on each wait for an answer (recv, poll, await, a
    // wait with a deadline, repeat while); 0 is none. A known-failing case sets it.
    answer_limit: Int{0}
}

// An entry's memory claim in bytes, which its rows' runs raise (KitEnv.peak).
KitPeak: struct {
    bytes: Int
}

KitEnvVar: struct {
    name: String
    value: String?
    conditions: [String]{[String]{}}
}

KitEntry: struct {
    path: String
    expected: String
    project: String
    suite: String
    mode: String
}

KitRun: struct {
    stdout: String
    stderr: String
    code: Int
    signal: Int?
    timed_out: Bool
    error: String
    elapsed_ns: Int{0}
    limit_hit: String{""}
    // The kit refused to start the child (see kit_exec_home_refusal); `error` says why.
    refused: Bool{false}
    // The child's exact output bytes when the kit read them; `stdout` and
    // `stderr` are their lossy UTF-8 decoding.
    stdout_bytes: [U8]?{None}
    stderr_bytes: [U8]?{None}
}
KitOptions: struct {
    suite: String
    jet: String
    jetpack: String
    tiers: [String]
    filter: String
    cases: String
    shard_index: Int
    shard_count: Int
    sharded: Bool
    timeout: Int
    scratch: String
    results: String
    list: Bool
    coverage: Bool
    opt_in: Bool{false}
    // Corpus entries run at once; 0 is half the scheduler's workers (kit_execute_jobs).
    jobs: Int{0}
    // Bytes the running entries may claim together; 0 is all the memory the kit may
    // still claim (kit_execute_budget).
    memory: Int{0}
    bless: KitBless
    error: String
    // The checkout-relative corpus directories of each suite.
    golden_corpora: [String]{[String]{}}
    ui_corpora: [String]{[String]{}}
    cases_corpora: [String]{[String]{}}
    // The accepted-failing ledger (kit_known_load): an absolute path, "" is none.
    ledger: String{""}
    // A selection (`filter`, `cases`) that matches no corpus entry is no rows
    // rather than an error: the run selects other tests beside the corpus.
    others_selected: Bool{false}
}

KitCtx: struct {
    options: KitOptions
    env: KitEnv
    root: String
    scratch: String
    bless: KitBless
    // The known-failing ledger (kit_known_load), read once per run.
    known: [String: String]
}

KitSelection: struct {
    ids: [String]
    error: String
}

KitVerdict: struct {
    status: String
    detail: String
    diff: String
}

KitBless: struct {
    ids: [String]
    all: Bool
    reason: String
    allow_shrink: [String]
    first_tier: Bool
}

KitAssertion: struct {
    stream: String
    path: String
    mode: String
    value: String
    json_mode: String{""}
    json_path: String{""}
    json_op: String{""}
    ratio: Float{0.0}
    extra: String{""}
    optional_file: Bool{false}
    file_first: Bool{false}
    transform: String{""}
    rhs_literal: Bool{false}
    rhs_transform: String{""}
    alternatives: [String]{[String]{}}
    conditions: [String]{[String]{}}
}

KitJSONNormalization: struct {
    stream: String
    path: String
    kind: String
}

KitJSONSpan: struct {
    start: Int
    end: Int
    normalizer: Int
}

KitJSONResult: struct {
    text: String
    error: String
}

KitWord: struct {
    text: String
    start: Int
    end: Int
}

KitPendingChild: struct {
    label: String
    child: ProcessChild
    started: Instant
    step: KitStep
    joined: Bool
    input_error: String
    signalled: Bool{false}
    // Stdout bytes recv steps consumed; wait and close report only what follows.
    taken: Int{0}
    // Bytes a recv read past its last whole unit, kept for the next recv.
    buffer: [U8]{[U8]{}}
    ended: Bool{false}
}

KitLinePredicate: struct {
    valid: Bool
    value: Bool
    next: Int
}

KitScalar: struct {
    value: Int
    next: Int
}

KitCapturedValue: enum {
    Text(String)
    Bytes([U8]?)
    Numbers([Int])
    Tree([KitTreeItem])
    Absent
}

KitSubjectResult: struct {
    value: KitCapturedValue{KitCapturedValue.Absent}
    verdict: KitVerdict
}

KitCapture: struct {
    name: String
    value: KitCapturedValue
    aggregate: Bool{false}
}

KitTreeItem: struct {
    path: String
    bytes: [U8]
}

KitFreePort: struct {
    name: String
    port: Int
}

KitCaptureScope: struct {
    start: Int
    names: [String]
    aggregates: [String]
}

KitLoopFrame: struct {
    start: Int
    end: Int
    kind: String
    name: String{""}
    values: [String]{[String]{}}
    position: Int{0}
    captures: [KitCapture]{[KitCapture]{}}
    bindings: [KitCapture]{[KitCapture]{}}
    started: Instant
    // A process repeat's process's CPU time when the loop began.
    cpu_ns: Int{0}
}

KitInventoryItem: struct {
    path: String
    kind: String
    size: Int
    modified_ms: Int
    digest: String
}

KitInventory: struct {
    label: String
    items: [KitInventoryItem]
}

KitJSONFilter: struct {
    key: String
    op: String
    expected: Dyn
    reference: String{""}
}

KitReplacement: struct {
    from: String
    to: String
    literal_from: Bool{false}
}

KitProcessInput: struct {
    argv: [String]
    cwd: String
    stdin: [U8]
    env: KitEnv
    overlay: [KitEnvVar]
}

// A step's terminal. A 0x0 size leaves the terminal's size unset. Events run
// in time order, each `at` nanoseconds after spawn; `clock` is when the
// latest send or close runs, which the next `after` delay counts from.
KitTerminal: struct {
    rows: Int
    cols: Int
    events: [KitTerminalEvent]{[KitTerminalEvent]{}}
    clock: Int{0}
}

// One scheduled terminal input: "send" types `text`, "close" types the
// terminal's end-of-file character and "resize" sets `rows` x `cols`.
KitTerminalEvent: struct {
    kind: String
    text: String{""}
    at: Int
    rows: Int{0}
    cols: Int{0}
}

KitStep: struct {
    argv: [String]
    stdin: String
    exit: String
    exit_explicit: Bool{false}
    assertions: [KitAssertion]
    cwd: String{""}
    unset: [String]{[String]{}}
    environment: [KitEnvVar]{[KitEnvVar]{}}
    label: String{""}
    action: String{""}
    literal_input: Bool{false}
    session_mode: String{""}
    duration: Int{0}
    instruction: String{""}
    limit_time: Int{0}
    limit_memory: Int{0}
    limit_resident: Int{0}
    // "no-nix" (the `isolate:` launcher), "netns" (a network namespace of its
    // own: a `host-port:` golden row's program, kit_netns_argv) or "".
    isolate: String{""}
    isolate_network: String{"disabled"}
    env_clear: Bool{false}
    refused_capability: String{""}
    terminal: KitTerminal?{None}
    stdout_target: String{""}
    stderr_target: String{""}
    json_normalize: [KitJSONNormalization]{[KitJSONNormalization]{}}
    replacements: [KitReplacement]{[KitReplacement]{}}
    conditions: [String]{[String]{}}
    aggregate_names: [String]{[String]{}}
}

KitPlan: struct {
    requires: [String]
    fixture: String
    environment: [String]
    normalize: [String]
    compile_only: Bool
    artifact: String
    refused: String
    steps: [KitStep]
    error: String
    opt_in: String{""}
    // `repo-cwd:` header reason: a golden program runs from the staged source
    // root, which keeps the repository layout, not from its project directory.
    repo_cwd: String{""}
    json_normalize: [KitJSONNormalization]{[KitJSONNormalization]{}}
    replacements: [KitReplacement]{[KitReplacement]{}}
    free_ports: [String]{[String]{}}
    // A fixed TCP port the case binds; 0 is none. A golden row's program
    // binds it in a network namespace of its own (kit_netns_argv).
    host_port: Int{0}
}

KitOutcome: struct {
    verdict: KitVerdict
    run: KitRun
    tier: String{"-"}
}

// One golden tier: `level` is the `optimize` value of jet_foundation's
// JET_BUILD_OPTIONS the tier builds at (JetCli's TestProfile.jet tests that
// the tiers name its values, in order).
KitTier: struct {
    name: String
    level: String
    flags: [String]
    direct: Bool
    // `jet test`'s level flags for an entry's `<stem>.test.out` on this tier.
    test_flags: [String]
}

KitGoldenStepCtx: struct {
    entry: KitEntry
    tier: KitTier
    source: String
    expected: String
    last_explicit: Bool
    // The sidecar spelled no steps, so the kit supplied `build` (and `built`).
    implicit: Bool{false}
}

KitStepCtx: struct {
    plan: KitPlan
    id: String
    env: KitEnv
    work: String
    scratch: String
    snapshots: String
    bless: KitBless
    golden: KitGoldenStepCtx?
}

KitCapturedStep: struct {
    label: String
    stdout: String
    stderr: String
    elapsed_ns: Int
    code: Int?{Val(0)}
    raw_stdout: String{""}
    raw_stderr: String{""}
}

KitStepState: struct {
    last: KitRun
    built: String
    built_once: Bool
    history: [KitCapturedStep]{[KitCapturedStep]{}}
    json_stdout: String?{None}
    json_stderr: String?{None}
    children: [KitPendingChild]{[KitPendingChild]{}}
    captures: [KitCapture]{[KitCapture]{}}
    bindings: [KitCapture]{[KitCapture]{}}
    inventories: [KitInventory]{[KitInventory]{}}
    replacements: [KitReplacement]{[KitReplacement]{}}
    free_ports: [KitFreePort]{[KitFreePort]{}}
    // A step that already compared the case's expected streams ends it.
    settled: Bool{false}
}

KitStepResult: struct {
    state: KitStepState
    verdict: KitVerdict
}

// Which suite's step invocation and expectations the shared sequencing loop uses.
KitStepHooks: enum {
    Golden
    Steps
}

kit_golden_step_hooks: fn() -> KitStepHooks { KitStepHooks.Golden }

kit_steps_hooks: fn() -> KitStepHooks { KitStepHooks.Steps }

kit_steps_hook_invoke: fn(hooks: KitStepHooks, step: KitStep, index: Int, context: KitStepCtx, state: KitStepState) -> KitStepResult {
    if hooks == {
        .Golden -> kit_golden_step_invoke(step, index, context, state)
        .Steps -> kit_steps_invoke(step, index, context, state)
    }
}

kit_steps_hook_check: fn(hooks: KitStepHooks, step: KitStep, index: Int, context: KitStepCtx, state: KitStepState) -> KitVerdict {
    if hooks == {
        .Golden -> kit_golden_step_check(step, index, context, state)
        .Steps -> kit_steps_check_state(step, index, context, state)
    }
}

// The host-wide lock file for a fixed TCP port. Ports are host-wide, so the
// name is fixed instead of living under a run's scratch, and every testkit run
// on the host takes the same flock.
kit_steps_host_port_path: fn(port: Int) -> String { "/tmp/jet-host-port-{port}.lock" }

// All suites share this sequencing loop. Hooks supply only suite-specific
// invocation and expectations, never an alternative parser or executor.
kit_steps_execute: fn(original_context: KitStepCtx, hooks: KitStepHooks) -> KitOutcome {
    context := original_context
    state := KitStepState{last: kit_exec_failed("no steps"), built: "", built_once: false}
    plan: context.plan
    if plan.error != "" -> return KitOutcome{verdict: kit_expect_verdict("REFUSED", plan.error), run: state.last}
    loop requirement in plan.requires {
        if kit_steps_build_target_text(requirement) -> return kit_steps_finish(state, kit_expect_verdict("REFUSED", "build-target"))
        if !requirement.starts_with("first-existing ") -> next
        words: kit_steps_words(requirement) ?? return kit_steps_finish(state, kit_expect_verdict("REFUSED", "invalid first-existing requirement"))
        found := false
        loop index in 3..<words.len() {
            if index % 2 == 0 -> next
            expanded: kit_steps_runtime_expand(words[index], context, state) ?? return kit_steps_finish(state, kit_expect_verdict("ERROR", "requirement token unavailable"))
            path: files.join(context.work, expanded)
            if files.exists(path) {
                state.captures.push(KitCapture{name: words[1], value: KitCapturedValue.Text(path)})
                found = true
                break
            }
        }
        if !found -> return kit_steps_finish(state, kit_expect_verdict("SKIP-HOST", requirement))
    }
    requirement: kit_steps_required(plan, context.env, context.work, context.scratch)
    if requirement == {
        .Val(value) -> return KitOutcome{verdict: value, run: state.last}
        .None -> {}
    }
    if kit_expect_named(plan.normalize, "version") && (context.env.version == "" || context.env.version_error != "") -> return KitOutcome{verdict: kit_expect_verdict("ERROR", "jet version: {context.env.version_error}"), run: state.last}
    if plan.compile_only && context.golden == None -> return KitOutcome{verdict: kit_expect_verdict("REFUSED", "run: none is golden-only"), run: state.last}
    if plan.refused != "" -> return KitOutcome{verdict: kit_expect_verdict("REFUSED", plan.refused), run: state.last}
    if plan.steps.len() == 0 -> return KitOutcome{verdict: kit_expect_verdict("REFUSED", "case has no steps"), run: state.last}
    blessing: kit_steps_bless_plan(plan, context.id, context.bless)
    if blessing == {
        .Val(value) -> return KitOutcome{verdict: value, run: state.last}
        .None -> {}
    }
    files.create_dir_all(files.join(context.scratch, "tmp")) ?? return kit_steps_finish(state, kit_expect_verdict("ERROR", "create case temp directory: {err}"))
    if plan.fixture != "" {
        fixture: files.join(context.snapshots, plan.fixture)
        // A missing fixture would stop the copy, and with it the pool task, without a verdict.
        if !files.is_dir(fixture) -> return kit_steps_finish(state, kit_expect_verdict("ERROR", "fixture directory is missing: {plan.fixture}"))
        kit_exec_copy_tree(fixture, context.work, true, true)
    }
    port_names: kit_steps_case_port_names(context)
    if port_names.len() > 0 {
        ports: kit_steps_free_ports(context, port_names.len()) ?? return kit_steps_finish(state, kit_expect_verdict("ERROR", "{err}"))
        loop index in 0..<port_names.len() -> state.free_ports.push(KitFreePort{name: port_names[index], port: ports[index]})
    }
    // A case that binds a fixed host port holds its lock until the case ends,
    // waiting at most one step timeout, so concurrent kit and feature-example
    // runs on this host take turns.
    port_lock: if plan.host_port == 0 -> None else -> Val(files.lock(kit_steps_host_port_path(plan.host_port), timeout: Val(context.env.timeout)) ?? return kit_steps_finish(state, kit_expect_verdict("ERROR", "host port {plan.host_port} lock: {err}")))
    loop index in 0..<context.plan.environment.len() {
        context.plan.environment[index] = kit_steps_runtime_expand(context.plan.environment[index], context, state) ?? return kit_steps_finish(state, kit_expect_verdict("ERROR", "case environment token unavailable"))
    }
    cursor := 0
    loops := [KitLoopFrame]{}
    loop cursor < plan.steps.len() {
        if loops.len() > 0 {
            slot: loops.len() - 1
            if loops[slot].kind == "repeat" && cursor == loops[slot].start + 1 {
                opening: plan.steps[loops[slot].start]
                activity: kit_steps_repeat_check(opening, context, state)
                if activity.status != "PASS" && activity.status != "FAIL" -> return kit_steps_finish(state, activity)
                if activity.status == "FAIL" {
                    state = kit_steps_loop_restore(loops[slot], state)
                    cursor = loops[slot].end + 1
                    loops = loops.slice(0, slot)
                    next
                }
                if kit_steps_repeat_exceeded(opening, loops[slot], context, state) == .Val(failed) -> return kit_steps_finish(state, failed)
            }
        }
        index: cursor
        original: plan.steps[index]
        cursor += 1
        if kit_steps_build_target_conditions(original.conditions) -> return kit_steps_finish(state, kit_expect_verdict("REFUSED", "build-target"))
        if !kit_steps_conditions(original.conditions, context, state) -> next
        if kit_steps_build_target_used(original, plan) -> return kit_steps_finish(state, kit_expect_verdict("REFUSED", "build-target"))
        if original.action == "when" {
            if !kit_steps_condition(original.argv[0], context, state) {
                depth := 1
                loop cursor < plan.steps.len() && depth > 0 {
                    if plan.steps[cursor].action == "when" -> depth += 1
                    if plan.steps[cursor].action == "end when" -> depth -= 1
                    cursor += 1
                }
            }
            next
        }
        if original.action == "end when" -> next
        // Selected nonZ loops/awaits refuse before loop state or PID expansion.
        // Attached assertions select their own conditions after the command.
        if ((original.action == "repeat" && kit_steps_process_nonzombie_mode(original.argv[4])) || (original.action == "await" && original.argv[0] == "process" && kit_steps_process_nonzombie_mode(original.argv[2]))) && sys.name() != "linux" -> return kit_steps_finish(state, kit_expect_verdict("REFUSED", "process-state"))
        if original.action == "for" || original.action == "repeat" -> state = kit_steps_loop_initialize(original, state)
        if original.action == "for" {
            values: kit_steps_loop_values(kit_steps_resolve_step(original, context, state) ?? return kit_steps_finish(state, kit_expect_verdict("ERROR", "loop token unavailable")), context, state) ?? return kit_steps_finish(state, kit_expect_verdict("ERROR", "{err}"))
            end: kit_steps_block_end(plan.steps, index)
            if values.len() == 0 {
                cursor = end + 1
                next
            }
            frame: KitLoopFrame{start: index, end: end, kind: original.argv[1], name: original.argv[original.argv.len() - 1], values: values, captures: state.captures, bindings: state.bindings, started: time.instant()}
            loops.push(frame.copy())
            state = kit_steps_loop_bind(frame, state)
            next
        }
        if original.action == "repeat" {
            activity: kit_steps_repeat_check(original, context, state)
            if activity.status != "PASS" && activity.status != "FAIL" -> return kit_steps_finish(state, activity)
            end: kit_steps_block_end(plan.steps, index)
            if activity.status == "FAIL" {
                cursor = end + 1
                next
            }
            loops.push(KitLoopFrame{start: index, end: end, kind: "repeat", captures: state.captures, bindings: state.bindings, started: time.instant(), cpu_ns: kit_steps_repeat_cpu(original, context, state)})
            next
        }
        if original.action == "end for" || original.action == "end repeat" {
            slot: loops.len() - 1
            frame := loops[slot]
            state = kit_steps_loop_restore(frame, state)
            if frame.kind == "repeat" {
                opening: plan.steps[frame.start]
                activity: kit_steps_repeat_check(opening, context, state)
                if activity.status != "PASS" && activity.status != "FAIL" -> return kit_steps_finish(state, activity)
                if activity.status == "PASS" {
                    if kit_steps_repeat_exceeded(opening, frame, context, state) == .Val(failed) -> return kit_steps_finish(state, failed)
                    remaining: kit_steps_repeat_wall(opening, context.env) - frame.started.elapsed().ns
                    interval: kit_steps_duration_ns(opening.argv[8]) ?? 0
                    time.sleep(time.duration_ns(if interval < remaining -> interval else -> remaining))
                    cursor = frame.start + 1
                    next
                }
            } else {
                frame.position += 1
                if frame.position < frame.values.len() {
                    state = kit_steps_loop_bind(frame, state)
                    cursor = frame.start + 1
                    loops[slot] = frame
                    next
                }
            }
            loops = loops.slice(0, slot)
            next
        }
        if original.action == "parallel" {
            end: kit_steps_block_end(plan.steps, index)
            invoked: kit_steps_parallel(plan.steps.slice(cursor, end), context, state)
            state = invoked.state
            if invoked.verdict.status != "PASS" -> return kit_steps_finish(state, invoked.verdict)
            cursor = end + 1
            next
        }
        step := kit_steps_resolve_step(original, context, state) ?? return kit_steps_finish(state, kit_expect_verdict("ERROR", "undefined capture or unavailable tool token"))
        if step.refused_capability != "" -> return kit_steps_finish(state, kit_expect_verdict("REFUSED", step.refused_capability))
        if step.argv.len() > 0 && step.argv[0] == "fail" {
            if step.argv.len() != 2 -> return kit_steps_finish(state, kit_expect_verdict("REFUSED", "fail needs one message"))
            return kit_steps_finish(state, kit_expect_verdict("FAIL", step.argv[1]))
        }
        invoked: if step.action == "poll" -> kit_steps_poll(step, index, context, state, hooks) else if kit_steps_setup_kind(step.action) || kit_expect_named(["assert", "apply-edits", "await", "session", "send", "recv", "signal", "close", "spawn", "wait", "capture", "write", "inventory"], step.action) ->
            kit_steps_action(step, context, state) else -> kit_steps_hook_invoke(hooks, step, index, context, state)
        state = invoked.state
        if invoked.verdict.status != "PASS" || state.settled -> return kit_steps_finish(state, invoked.verdict)
        if step.action == "capture" || step.action == "await" -> step.assertions = kit_steps_resolve_assertions(step.assertions, context, state) ?? return kit_steps_finish(state, kit_expect_verdict("ERROR", "undefined capture or unavailable tool token"))
        if kit_expect_named(["spawn", "session", "send", "signal"], step.action) -> next
        if kit_expect_named(["", "wait", "close", "poll"], step.action) {
            wired: kit_steps_wiring_finish(step, context, state)
            state = wired.state
            if wired.verdict.status != "PASS" -> return kit_steps_finish(state, wired.verdict)
        }
        if step.action == "capture" || step.action == "assert" {
            if step.assertions.len() > 0 || step.action == "assert" {
                verdict: kit_steps_hook_check(hooks, step, index, context, state)
                if verdict.status != "PASS" -> return kit_steps_finish(state, verdict)
            }
            next
        }
        step.replacements = kit_steps_replacements(step.replacements, context, state) ?? return kit_steps_finish(state, kit_expect_verdict("ERROR", "replacement token unavailable"))
        state.replacements = step.replacements
        state.json_stdout = None
        state.json_stderr = None
        if kit_expect_named(["", "wait", "close", "poll"], step.action) && (plan.json_normalize.len() > 0 || step.json_normalize.len() > 0) && kit_steps_failure(step, state.last) == None {
            rules := plan.json_normalize
            loop rule in step.json_normalize -> rules.push(rule)
            output: kit_steps_json_normalize(state.last.stdout, "stdout", rules)
            errors: kit_steps_json_normalize(state.last.stderr, "stderr", rules)
            if output.error != "" -> return kit_steps_finish(state, kit_expect_verdict("FAIL", output.error))
            if errors.error != "" -> return kit_steps_finish(state, kit_expect_verdict("FAIL", errors.error))
            state.json_stdout = Val(output.text)
            state.json_stderr = Val(errors.text)
        }
        if step.label != "" && kit_expect_named(["", "wait", "close", "poll"], step.action) {
            source_name: if context.golden == {
                .Val(golden) -> kit_golden_source_name(golden.entry)
                .None -> ""
            }
            state.history.push(KitCapturedStep{label: step.label,
                stdout: kit_steps_replace(kit_steps_normalize(state.json_stdout ?? state.last.stdout, context.env, context.work, context.scratch, plan.normalize, state.built, source_name), step.replacements, context, state, true, source_name),
                stderr: kit_steps_replace(kit_steps_normalize(state.json_stderr ?? state.last.stderr, context.env, context.work, context.scratch, plan.normalize, state.built, source_name), step.replacements, context, state, true, source_name),
                elapsed_ns: state.last.elapsed_ns,
                code: if state.last.signal == None -> Val(state.last.code) else -> None,
                raw_stdout: kit_steps_replace(state.last.stdout, step.replacements, context, state, false, source_name),
                raw_stderr: kit_steps_replace(state.last.stderr, step.replacements, context, state, false, source_name)})
        }
        verdict: kit_steps_hook_check(hooks, step, index, context, state)
        if verdict.status != "PASS" -> return kit_steps_finish(state, verdict)
        if plan.compile_only -> break
    }
    kit_steps_finish(state, kit_expect_verdict("PASS", ""))
}

KitCaseResult: struct {
    suite: String
    case: String
    tier: String
    status: String
    detail: String
    exit: Int
    diff: String{""}
    // The entry's wall time and the largest resident size any of its children reached.
    wall_ms: Int{0}
    peak_kib: Int{0}
}

KitSelected: struct {
    entry: KitEntry
    suite: String
}

KitUIDirective: struct {
    name: String
    argv: [String]
    parent: Bool
    exit: String
    streams: String
    capability: String
}

KitUICall: struct {
    argv: [String]
    parent: Bool
    exit: String
    streams: String
    stdin: String
    extension: String
    refused: String
    unlocked_toolchain: Bool{false}
    // `jetpack hangar verify` of a freshly ingested, then tampered object.
    hangar_tamper: Bool{false}
    // A plain `jet fetch` in the fixture's project before the invocation.
    fetch_first: Bool{false}
    // `@org_policy FILE`: the organization policy file (JET_ORG_UNSAFE_POLICY),
    // relative to the entry's directory; "" for none.
    org_policy: String{""}
    // `@check_core [FILE]`: `jet check Core` in a staged toolchain
    // (kit_ui_stage_core), with the entry's text on top of `Core/FILE` when
    // the directive names one ("" for none).
    check_core: Bool{false}
    core_top: String{""}
}

KitUIRegistryRow: struct {
    code: String
    // The report header's type path, `jet.` and the impl's type name.
    name: String
    active: Bool
}

KitUIAllowance: struct {
    code: String
    side: String
    card: String
}

kit_suites: fn() -> [String] { ["golden", "ui", "cases"] }

kit_suite_discover: fn(suite: String, context: KitCtx) -> [KitEntry] {
    if suite == {
        "golden" -> kit_golden_discover_suite(context)
        "ui" -> kit_ui_discover(context)
        else -> kit_cases_discover(context)
    }
}

kit_suite_run: fn(suite: String, entry: KitEntry, context: KitCtx) -> [KitOutcome] {
    if suite == {
        "golden" -> kit_golden_run_suite(entry, context)
        "ui" -> kit_ui_run(entry, context)
        else -> kit_cases_run(entry, context)
    }
}

// A run's exit code (kit_report_exit_code) and the report row of every case or selection
// problem that makes it nonzero, so a caller can name every failure at once, and every
// row's verdict, for a caller that writes one document of its own rows beside them.
KitExecution: struct {
    code: Int
    failures: [KitFailure]
    results: [KitCaseResult]{[KitCaseResult]{}}
}

// One blocking report row and the suite it belongs to; a selection, report or cleanup row
// belongs to the whole run (suite "" or "kit").
KitFailure: struct {
    suite: String
    row: String
}

kit_execution_refused: fn(row: String) -> KitExecution {
    print(row)
    KitExecution{code: 2, failures: [KitFailure{suite: "", row: row}]}
}

// The corpus in report order: by suite, then path. The pool runs entries in schedule
// order and rows stream as entries finish; reports and failure lists keep this order
// whatever the pool's size.
kit_execute_corpus_order: fn(corpus: &[KitSelected]) {
    corpus.sort_by(fn(item) { "{item.suite}\n{item.entry.path}" })
}

// Where a run stages its rows without --scratch: in memory, so no row writes
// the disk. That is /dev/shm, else the per-user runtime directory
// (XDG_RUNTIME_DIR), each under a directory of this user's; a host with
// neither stages on disk (kit_disk_root). Each row's files count against its
// memory claim and resident guard (kit_exec_run), so the scratch stays inside
// the run's memory budget. None when not even HOME is set.
kit_scratch_root: fn() -> String? {
    uid: sys.getuid()
    if files.is_dir("/dev/shm") -> return Val("/dev/shm/jet-testkit-{uid}")
    if sys.get("XDG_RUNTIME_DIR") == .Val(runtime) {
        if runtime.starts_with("/") && files.is_dir(runtime) -> return Val(files.join(runtime, "jet-testkit"))
    }
    kit_disk_root()
}

// The disk directory for what outlives a run (the history, and the FFI cache
// of a run staged on disk): <JET_SCRATCH_ROOT>/testkit, else Jet's user cache
// (<XDG_CACHE_HOME>/jet/testkit, else ~/.cache/jet/testkit). None when not
// even HOME is set.
kit_disk_root: fn() -> String? {
    if sys.get("JET_SCRATCH_ROOT") == .Val(root) -> return Val(files.join(root, "testkit"))
    if sys.get("XDG_CACHE_HOME") == .Val(cache) -> return Val(files.join(cache, "jet/testkit"))
    home: sys.get("HOME") ?? return None
    Val(files.join(home, ".cache/jet/testkit"))
}

kit_case_blocks: fn(status: String) -> Bool {
    kit_expect_named(["FAIL", "UNEXPECTED-PASS", "REFUSED", "ERROR", "TIMEOUT"], status)
}

// Runs `selected_suites` in one pool. `reports` None writes one report of every row to
// options.results; Val(paths) finishes each suite on its own, its rows and summary to
// paths[suite] ("" prints the summary only), as each gate test reports its suite.
kit_execute_suites: fn(options: KitOptions, root: String, selected_suites: [String], reports: [String: String]?) -> KitExecution {
    if selected_suites.len() == 0 || selected_suites.any(fn(suite) { !kit_expect_named(kit_suites(), suite) }) -> return kit_execution_refused("REFUSED\tselection\t\tsuite not installed: {options.suite}")
    timeout: Duration.seconds(options.timeout) ?? return kit_execution_refused("REFUSED\tselection\t\ttimeout: {err}")
    discovery_env: KitEnv{root: root, scratch: "", jet: options.jet, jetpack: options.jetpack, timeout: timeout, memory_limit: 0}
    discovery_ctx: KitCtx{options: options, env: discovery_env, root: root, scratch: "", bless: options.bless, known: [String: String]{}}
    corpus := [KitSelected]{}
    loop suite in selected_suites {
        loop entry in kit_suite_discover(suite, discovery_ctx) -> corpus.push(KitSelected{entry: entry, suite: suite})
    }
    kit_execute_corpus_order(corpus)
    selection: kit_exec_select_ids(corpus.map(fn(item) { item.entry.path }), options)
    if selection.error != "" -> return kit_execution_refused("REFUSED\tselection\t\t{selection.error}")
    entries: corpus.filter(fn(item) { kit_expect_named(selection.ids, item.entry.path) })
    if entries.len() == 0 && options.others_selected -> return KitExecution{code: 0, failures: []}
    if entries.len() == 0 -> return kit_execution_refused("ERROR\tselection\t\tno matching corpus entries")
    if options.list {
        loop item in entries -> print("{item.entry.suite}\t{item.entry.path}")
        return KitExecution{code: 0, failures: []}
    }
    if options.jet == "" -> return kit_execution_refused("ERROR\tselection\t\tJET must name the compiler under test")
    jet: files.canonicalize(options.jet) ?? return kit_execution_refused("ERROR\tselection\t\tcompiler: {err}")
    jetpack: if options.jetpack == "" -> "" else -> files.canonicalize(options.jetpack) ?? return kit_execution_refused("ERROR\tselection\t\tjetpack: {err}")
    base: if options.scratch != "" -> options.scratch else -> kit_scratch_root() ?? return kit_execution_refused("ERROR\tselection\t\tscratch: set HOME or pass --scratch")
    canonical: kit_execute_scratch_dir(base, root) ?? return kit_execution_refused("ERROR\tselection\t\tscratch: {err}")
    // What outlives a run: each suite's measurements, and the FFI cache when
    // the rows stage on disk.
    state_base: sys.get("JET_TEST_STATE_DIR") ?? files.join(kit_disk_root() ?? return kit_execution_refused("ERROR\tselection\t\tstate: set JET_TEST_STATE_DIR, JET_SCRATCH_ROOT or HOME"), "state")
    state: kit_execute_disk_dir(state_base, root) ?? return kit_execution_refused("ERROR\tselection\t\tstate: {err}")
    run_scratch: files.join(canonical, "testkit-{process.current_pid()}-{selected_suites.join("-")}")
    if files.exists(run_scratch) -> return kit_execution_refused("ERROR\tselection\t\tscratch already exists: {run_scratch}")
    files.create_dir_all(run_scratch) ?? return kit_execution_refused("ERROR\tselection\t\tscratch: {err}")
    // A run staged in memory keeps its FFI cache there too, for that run only:
    // a cold Rust helper realizes in about a second in memory, but takes over
    // a minute in a shared on-disk cache under host I/O load (#6648), and a
    // helper that fails its signature check is never cached, so warming the
    // disk cache ahead of the rows could not spare those rows.
    scratch_memory: kit_exec_memory_backed(canonical)
    ffi_cache: if scratch_memory -> "" else -> files.join(state, "ffi")
    env := KitEnv{root: root, scratch: run_scratch, jet: jet, jetpack: jetpack, timeout: timeout, memory_limit: 0, resident_limit: kit_resident_guard(), ffi_cache: ffi_cache, scratch_memory: scratch_memory}
    // Golden C rows build on every tier, each with a fresh Hangar: the run
    // takes the pack once, so no tier unpacks a copy of its own.
    if jetpack != "" && kit_expect_named(selected_suites, "golden") -> env.cc_pack = kit_cc_pack_root(jetpack, state)
    if entries.any(fn(item) { item.suite == "ui" && item.entry.mode != "coverage" }) -> kit_ui_stage(root, run_scratch, entries.any(fn(item) { item.suite == "ui" && item.entry.mode.ends_with("project") }), options.ui_corpora)
    version_run: kit_exec_invoke(env, [jet, "--version"], root, run_scratch, "")
    if version_run.code == 0 && kit_exec_process_failure(version_run) == None {
        env.version = kit_steps_version(version_run.stdout) ?? ""
        env.version_display = kit_steps_version_display(version_run.stdout) ?? ""
        if env.version == "" -> env.version_error = "unparseable jet --version banner"
    } else {
        env.version_error = "jet --version failed: {version_run.error} {version_run.stderr}"
    }
    available: kit_exec_available_memory()
    jobs: kit_execute_jobs(options.jobs, entries.len(), kit_execute_workers())
    history_dir: files.join(state, "history")
    history: kit_history_load(history_dir, selected_suites)
    schedule: kit_execute_schedule(entries, history, jobs, kit_execute_budget(options.memory, available), available)
    results := [KitCaseResult]{}
    ran_suites := [String]{}
    loop run in kit_execute_entries(entries, schedule, options, env, kit_known_load(options.ledger), root, run_scratch) {
        if run.ran && !kit_expect_named(ran_suites, run.suite) -> ran_suites.push(run.suite)
        loop result in run.results -> results.push(result)
    }
    kit_history_save(history_dir, ran_suites, history, results)
    if options.bless.ids.len() > 0 || options.bless.all -> print("bless: ids={options.bless.ids} all={options.bless.all} reason={options.bless.reason}")
    kit_exec_remove_tree(run_scratch) ?? {
        results.push(KitCaseResult{suite: "kit", case: "cleanup", tier: "-", status: "ERROR", detail: "{err}", exit: -1})
        kit_report_row(results[results.len() - 1])
        false
    }
    kit_execute_finish(jet, results, ran_suites, selected_suites, reports, options.results)
}

// The root of the C toolchain pack `jetpack` puts in the Hangar under
// `state` (unpacked on a run's first use, re-proved on later runs), or ""
// when it can't, which leaves each row's jet to its jetpack.
kit_cc_pack_root: fn(jetpack: String, state: String) -> String {
    receipt: process.cmd([jetpack, "env", "fetch-toolchain", "--json"]).env("JETPACK_ROOT", files.join(state, "jetpack")).run() ?? return ""
    if !receipt.success -> return ""
    tree: json.parse(receipt.output) ?? return ""
    if tree == .Object(fields) {
        loop field in fields {
            if field.key == "root" && field.value == .Text(text) -> return text.copy()
        }
    }
    ""
}

// The run's failures and exit code once every row is in: one report of every row to
// `results_path` (reports None), or each suite's rows and summary to reports[suite].
// The rows keep corpus order (kit_execute_corpus_order).
kit_execute_finish: fn(jet: String, results: [KitCaseResult], ran_suites: [String], suites: [String], reports: [String: String]?, results_path: String) -> KitExecution {
    failures := [KitFailure]{}
    loop result in results {
        if kit_case_blocks(result.status) -> failures.push(KitFailure{suite: result.suite, row: "{result.status}\t{result.case}\t{result.tier}\t{result.detail}"})
    }
    if reports == .Val(paths) {
        code := if failures.any(fn(failure) { !kit_expect_named(suites, failure.suite) }) -> 2 else -> 0
        loop suite in suites {
            path: paths.get(suite) ?? ""
            // Each lambda captures its own copy: a capture moves the name it reads.
            in_suite: suite.copy()
            ran_suite: suite.copy()
            failed_suite: suite.copy()
            suite_code: kit_report_finish(jet, results.filter(fn(result) { result.suite == in_suite }), path, ran_suites.filter(fn(name) { name == ran_suite }))
            if suite_code != 0 && !failures.any(fn(failure) { failure.suite == failed_suite }) -> failures.push(KitFailure{suite: suite, row: "ERROR\tresults\t\tthe {suite} report could not be written to {path}"})
            if suite_code > code -> code = suite_code
        }
        return KitExecution{code: code, failures: failures, results: results}
    }
    code: kit_report_finish(jet, results, results_path, ran_suites)
    if code != 0 && failures.len() == 0 -> failures.push(KitFailure{suite: "", row: "ERROR\tresults\t\tthe {suites.join(",")} report could not be written to {results_path}"})
    KitExecution{code: code, failures: failures, results: results}
}

// Creates the state directory `path` and returns it canonical, refusing
// RAM-backed /tmp and the checkout: what outlives a run stays on disk.
kit_execute_disk_dir: fn(path: String, root: String) -> String Err! {
    canonical: kit_execute_scratch_dir(path, root) ?? return Err(err)
    if canonical == "/tmp" || canonical.starts_with("/tmp/") -> return Err("{canonical} must be disk-backed and outside the checkout")
    Ok(canonical)
}

// Creates the scratch directory `path` and returns it canonical, refusing the
// checkout: rows never write it.
kit_execute_scratch_dir: fn(path: String, root: String) -> String Err! {
    files.create_dir_all(path) ?? return Err("{err}")
    canonical: files.canonicalize(path) ?? return Err("{err}")
    if canonical == root || canonical.starts_with("{root}/") -> return Err("{canonical} must be outside the checkout")
    Ok(canonical)
}

// The memory an entry with no measured peak may claim, in bytes.
kit_job_memory: fn() -> Int { 1073741824 }

// The run-wide resident-memory guard on each child, in bytes: 8 GiB.
kit_resident_guard: fn() -> Int { 8589934592 }

// The pool size. Each running entry holds two scheduler workers: the task that reports it
// (so a panic in the entry still reports it) waits on the entry's own. The default, half
// the workers, gives every running entry both. An explicit --jobs above the workers is
// lowered to them: more reporting tasks than workers could leave every worker waiting on
// an entry that has none. Never more tasks than entries and never fewer than one. Memory,
// not the task count, then bounds what runs at once: each entry's claim must fit the
// budget (kit_execute_budget, kit_execute_schedule).
kit_execute_jobs: fn(requested: Int, entries: Int, workers: Int) -> Int {
    jobs := if requested > 0 -> requested else -> workers >> 1
    if jobs > workers -> jobs = workers
    if jobs > entries -> jobs = entries
    if jobs < 1 -> jobs = 1
    jobs
}

// This program's scheduler workers: the runtime's JET_SCHEDULER_THREADS override when it
// is a positive count, else one per core.
kit_execute_workers: fn() -> Int {
    set: Int.parse(sys.get("JET_SCHEDULER_THREADS") ?? "") ?? 0
    if set > 0 -> set else -> sys.cpu_count()
}

// The memory the pool's running entries may claim together, in bytes: an explicit
// --memory, else all the memory this process may still claim (kit_exec_available_memory;
// 0 is unknown: no memory gate).
kit_execute_budget: fn(requested: Int, available: Int) -> Int {
    if requested > 0 -> requested else -> available
}

// How many runs a pool of child processes starts at once (Compiler/test.jet's
// package runs): a quarter of the `cpus`, held between `least` and `most`, then
// lowered to the claims of `claim` bytes each that fit in `budget`
// (kit_execute_budget; 0 is unknown: no memory gate) and to the `runs` there
// are. Never fewer than one: a budget below one claim runs them one at a time.
kit_claim_jobs: fn(budget: Int, claim: Int, cpus: Int, least: Int, most: Int, runs: Int) -> Int {
    jobs := cpus /% 4
    if jobs < least -> jobs = least
    if jobs > most -> jobs = most
    if budget > 0 && claim > 0 && budget /% claim < jobs -> jobs = budget /% claim
    if jobs > runs -> jobs = runs
    if jobs < 1 -> jobs = 1
    jobs
}

// How the pool runs the corpus: `order` lists corpus indexes longest-first, `weights`
// is each entry's memory claim and `guards` its resident guard, all in bytes. Entries
// start in order while their claims fit under `budget` (0 is unknown: no memory gate)
// and fewer than `jobs` run.
KitSchedule: struct {
    order: [Int]
    weights: [Int]
    guards: [Int]
    budget: Int
    jobs: Int
}

// An entry's last measured wall time and resident peak.
KitHistory: struct {
    wall_ms: Int
    peak_kib: Int
}

// Longest-first (LPT) by last measured wall time; an entry never measured goes first, in
// corpus order, since it may be the longest. Each entry needs half again its last peak,
// at least 64 MiB, or kit_job_memory() unmeasured. It claims that need, never more than
// the whole budget, so the heaviest still runs (alone). Its resident guard is the
// run-wide kit_resident_guard(), raised to the entry's need but never above the whole
// room. The guard only stops a runaway child: the claims, not the guard, keep the pool
// inside the room, so a lower guard would turn a heavy entry into a kill.
kit_execute_schedule: fn(entries: [KitSelected], history: [String: KitHistory], jobs: Int, budget: Int, available: Int) -> KitSchedule {
    schedule := KitSchedule{order: [Int]{}, weights: [Int]{}, guards: [Int]{}, budget: budget, jobs: jobs}
    keys := [Int]{}
    loop (index, item) in entries {
        last: history.get(kit_history_key(item.suite, item.entry.path)) ?? KitHistory{wall_ms: -1, peak_kib: -1}
        need := if last.peak_kib < 0 -> kit_job_memory() else -> last.peak_kib * 1536
        if need < 67108864 -> need = 67108864
        schedule.weights.push(if budget > 0 && need > budget -> budget else -> need)
        guard := if need > kit_resident_guard() -> need else -> kit_resident_guard()
        if available > 0 && guard > available -> guard = available
        schedule.guards.push(guard)
        schedule.order.push(index)
        // Unmeasured entries come first, in corpus order; then measured entries by
        // descending wall time, ties in corpus order.
        keys.push(if last.wall_ms < 0 -> index - entries.len() else -> (Int{1} << 40) - last.wall_ms * entries.len() + index)
    }
    schedule.order.sort_by(fn(index) { keys[index] })
    schedule
}

kit_history_key: fn(suite: String, path: String) -> String { "{suite}\t{path}" }

kit_history_file: fn(dir: String, suite: String) -> String { files.join(dir, "{suite}.tsv") }

// The last measurement of every entry of the selected suites, keyed by suite and path.
// Each suite's file has one `path<TAB>wall_ms<TAB>peak_kib` row per entry; a missing or
// malformed file or row only loses its scheduling hints.
kit_history_load: fn(dir: String, suites: [String]) -> [String: KitHistory] {
    history := [String: KitHistory]{}
    loop suite in suites {
        text: kit_exec_optional(kit_history_file(dir, suite)) ?? next
        loop line in text.split("\n") {
            fields: line.split("\t").to_list()
            if fields.len() != 3 -> next
            wall: Int.parse(fields[1]) ?? next
            peak: Int.parse(fields[2]) ?? next
            history[kit_history_key(suite, fields[0])] = KitHistory{wall_ms: wall, peak_kib: peak}
        }
    }
    history
}

// Folds this run's measurements into the history and rewrites each suite's file. The
// file is replaced by a rename, without fsync: a history lost in a crash only loses
// its scheduling hints, and a durable write cost every run a journal flush.
kit_history_save: fn(dir: String, suites: [String], history: [String: KitHistory], results: [KitCaseResult]) {
    merged := history
    loop result in results {
        if result.wall_ms > 0 -> merged[kit_history_key(result.suite, result.case)] = KitHistory{wall_ms: result.wall_ms, peak_kib: result.peak_kib}
    }
    files.create_dir_all(dir) ?? return
    loop suite in suites {
        prefix: "{suite}\t"
        rows := [String]{}
        loop (key, last) in merged {
            if key.starts_with(prefix) -> rows.push("{kit_steps_byte_slice(key, prefix.count_bytes(), key.count_bytes())}\t{last.wall_ms}\t{last.peak_kib}")
        }
        rows.sort_by(fn(row) { row })
        path: kit_history_file(dir, suite)
        staged: "{path}.{process.current_pid()}.new"
        files.write(staged, "{rows.join("\n")}\n").drop("a lost history only loses scheduling hints")
        files.rename(staged, path).drop("a lost history only loses scheduling hints")
    }
}

// One corpus entry's rows; `ran` once its private scratch exists, `done` once it reported.
KitEntryRun: struct {
    index: Int
    suite: String
    ran: Bool
    done: Bool
    results: [KitCaseResult]
}

// Whether the pool starts an entry claiming `weight` bytes beside `running` entries that
// claim `claimed` together: fewer than `jobs` run and the claims fit under the budget
// (0 is unknown: no memory gate). The first always starts.
kit_execute_admits: fn(schedule: KitSchedule, running: Int, claimed: Int, weight: Int) -> Bool {
    running < schedule.jobs && (running == 0 || schedule.budget == 0 || claimed + weight <= schedule.budget)
}

// Runs the corpus in schedule order: an entry starts once fewer than `jobs` run and its
// memory claim fits beside the running ones' (the first always starts). As each entry
// finishes, its verdict diffs and rows print at once. Returns one run per entry in corpus
// order for the report file; a serial (`--jobs 1`) run prints in schedule order.
kit_execute_entries: fn(entries: [KitSelected], schedule: KitSchedule, options: KitOptions, env: KitEnv, known: [String: String], root: String, run_scratch: String) -> [KitEntryRun] {
    runs := [KitEntryRun]{}
    loop (index, item) in entries -> runs.push(KitEntryRun{index: index, suite: item.suite, ran: false, done: false, results: [KitCaseResult]{}})
    { sender: done, receiver: finished }: channel<KitEntryRun>()
    task.group pool(limit: schedule.jobs) {
        started := 0
        running := 0
        claimed := 0
        loop started < schedule.order.len() || running > 0 {
            if started < schedule.order.len() {
                index: schedule.order[started]
                if kit_execute_admits(schedule, running, claimed, schedule.weights[index]) {
                    task kit_execute_report(index, entries[index], options, env, known, root, run_scratch, schedule.guards[index], done.copy())
                    started += 1
                    running += 1
                    claimed += schedule.weights[index]
                    next
                }
            }
            run := finished.receive() ?? break
            running -= 1
            claimed -= schedule.weights[run.index]
            // A child that stopped (a panic in its entry) leaves that entry unreported.
            if !run.done {
                entry: entries[run.index].entry
                run.results = [KitCaseResult{suite: entry.suite, case: entry.path, tier: "-", status: "ERROR", detail: "testkit task stopped before reporting this entry", exit: -1}]
                run.done = true
            }
            kit_golden_mark_tier_splits(run.results)
            loop result in run.results {
                if result.diff != "" -> print(result.diff)
                kit_report_row(result)
            }
            runs[run.index] = run
        }
    }
    runs
}

// Runs one entry in its own task, so a panic in it still reports the entry, as not done.
kit_execute_report: fn(index: Int, item: KitSelected, options: KitOptions, env: KitEnv, known: [String: String], root: String, run_scratch: String, guard: Int, done: Sender<KitEntryRun>) {
    entry_task: task kit_execute_entry(index, item.copy(), options.copy(), env.copy(), known.copy(), root.copy(), run_scratch.copy(), guard)
    run := entry_task.join() ?? KitEntryRun{index: index, suite: item.suite.copy(), ran: true, done: false, results: [KitCaseResult]{}}
    done.send(run)
}

// One entry in its private scratch `<run>/<index>`, removed afterwards unless tracing.
// Every row carries the entry's wall time and its memory claim: its children's largest
// resident peak plus the files a row held on a memory-backed scratch.
kit_execute_entry: fn(index: Int, item: KitSelected, options: KitOptions, env: KitEnv, known: [String: String], root: String, run_scratch: String, guard: Int) -> KitEntryRun {
    entry: item.entry
    started: time.instant()
    run := KitEntryRun{index: index, suite: item.suite, ran: false, done: true, results: [KitCaseResult]{}}
    scratch: files.join(run_scratch, "{index}")
    files.create_dir_all(scratch) ?? {
        run.results.push(KitCaseResult{suite: entry.suite, case: entry.path, tier: "-", status: "ERROR", detail: "case scratch: {err}", exit: -1})
        return run
    }
    run.ran = true
    context := KitCtx{options: options, env: env, root: root, scratch: scratch, bless: options.bless, known: known}
    context.env.resident_limit = guard
    claim: Shared{KitPeak{bytes: 0}}
    context.env.peak = Val(claim.copy())
    loop outcome in kit_suite_run(item.suite, entry, context) {
        run.results.push(KitCaseResult{suite: entry.suite, case: entry.path, tier: outcome.tier, status: outcome.verdict.status, detail: outcome.verdict.detail, exit: outcome.run.code, diff: outcome.verdict.diff})
    }
    kit_exec_stop_strays(scratch)
    kit_exec_remove_tree(scratch) ?? {
        run.results.push(KitCaseResult{suite: entry.suite, case: entry.path, tier: "-", status: "ERROR", detail: "remove case scratch: {err}", exit: -1})
        false
    }
    held: claim.guard_read()
    peak: held.value.bytes
    wall_ms: started.elapsed().ns /% 1000000
    loop at in 0..<run.results.len() {
        run.results[at].wall_ms = if wall_ms > 0 -> wall_ms else -> 1
        run.results[at].peak_kib = peak /% 1024
    }
    run
}
