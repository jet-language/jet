// Which file extension means which language (#6686): `.jet` is Jet source,
// and `jet run` and `jet build` compile the C and C++ extensions with the C
// toolchain Jet programs compile their own C with (JetCli ForeignLink.jet).
// This is the one table: JetCli's front end tells a file's language by it,
// and the golden corpus finds its flat entries by it. It lives in the kit,
// which needs only Core, so that both can read it.
KitSourceLanguage: struct {
    extension: String
    language: String
}

KIT_SOURCE_LANGUAGES: [KitSourceLanguage]{
    KitSourceLanguage{extension: "jet", language: "jet"},
    KitSourceLanguage{extension: "c", language: "c"},
    KitSourceLanguage{extension: "cc", language: "c++"},
    KitSourceLanguage{extension: "cpp", language: "c++"},
    KitSourceLanguage{extension: "cxx", language: "c++"},
}

// The language ("jet", "c" or "c++") of the extension `extension`, written
// without its dot; None for any other.
kit_source_language: fn(extension: String) -> String? {
    loop row in KIT_SOURCE_LANGUAGES {
        // copy: the table keeps its row.
        if row.extension == extension -> return Val(row.language.copy())
    }
    None
}
