use {
    files: core.files
    process: core.process
    sys: core.sys
}

// The launcher (Assets/no_nix.jet) runs the host mount tools and passes the
// loader's directory at fd 9; all process policy, environment, input, receipts
// and assertions still belong to Steps.
kit_no_nix_helper: fn(name: String) -> String? {
    loop directory in ["/run/current-system/sw/bin", "/usr/bin", "/bin"] {
        path: files.join(directory, name)
        if files.is_file(path) -> return Val(path)
    }
    None
}

kit_no_nix_required: fn() -> KitVerdict? {
    if sys.name() != "linux" -> return Val(kit_expect_verdict("SKIP-HOST", "isolate: no-nix requires Linux"))
    if kit_no_nix_helper("unshare") == None -> return Val(kit_expect_verdict("SKIP-HOST", "isolate: no-nix requires unshare"))
    None
}

kit_no_nix_matches: fn(bytes: [U8], offset: Int, marker: [U8]) -> Bool {
    if offset + marker.len() > bytes.len() -> return false
    loop i in 0..<marker.len() {
        if bytes[offset + i] != marker[i] -> return false
    }
    true
}

// Match the original harness's NUL-terminated Nix ld-linux interpreter slot
// and point it at the same loader in the directory the launcher passes at
// fd 9. Leave non-Nix and static ELF images alone; a patch never grows the image.
kit_no_nix_patch_bytes: fn(source: [U8]) -> [U8]? {
    if source.len() < 4 || !kit_no_nix_matches(source, 0, [U8]{127, 69, 76, 70}) -> return None
    marker: "/nix/store/".bytes()
    loader: "ld-linux".bytes()
    prefix: "/proc/self/fd/9/".bytes()
    offset := 0
    loop offset + marker.len() <= source.len() {
        if !kit_no_nix_matches(source, offset, marker) {
            offset += 1
            next
        }
        end := offset
        loop end < source.len() && source[end] != (U8{0}) -> end += 1
        found := false
        loop i in offset..<end {
            if i + loader.len() <= end && kit_no_nix_matches(source, i, loader) -> found = true
        }
        if found {
            name := offset
            loop i in offset..<end {
                if source[i] == (U8{47}) -> name = i + 1
            }
            replacement := prefix
            loop i in name..<end -> replacement.push(source[i])
            if replacement.len() >= end - offset -> return None
            result := source
            loop i in offset..<end -> result[i] = U8{0}
            loop i in 0..<replacement.len() -> result[offset + i] = replacement[i]
            return Val(result)
        }
        offset = end + 1
    }
    None
}

kit_no_nix_patch: fn(source: String, destination: String) -> String Err! {
    bytes: files.read_bytes(source) ?? return Err("no-nix read {source}: {err}")
    if kit_no_nix_patch_bytes(bytes) == {
        .None -> return Ok("")
        .Val(patched) -> {
            files.write_bytes(destination, patched) ?? return Err("no-nix patch {source}: {err}")
            info: files.stat(source) ?? return Err("no-nix stat {source}: {err}")
            files.chmod(destination, info.mode % 512) ?? return Err("no-nix chmod {destination}: {err}")
            return Ok(destination)
        }
    }
}

// Build the namespace launcher once per bootstrap directory, from a copy of
// its package so parallel cases never share one build output. The build runs
// with the kit's environment, not the step's (an `env-clear` step has no HOME).
kit_no_nix_launcher: fn(env: KitEnv, bootstrap: String) -> String Err! {
    directory: files.join(bootstrap, "launcher")
    output: files.join(directory, "bin")
    launcher: files.join(output, "no_nix")
    if files.is_file(launcher) -> return Ok(launcher)
    files.create_dir_all(directory) ?? return Err("no-nix launcher directory: {err}")
    source: files.join(env.root, "Compiler/JetTestKit/Assets")
    loop name in ["package.jet", "no_nix.jet"] {
        files.copy(files.join(source, name), files.join(directory, name)) ?? return Err("no-nix launcher copy of {name}: {err}")
    }
    build := env
    build.env_clear = false
    build.memory_limit = 0
    // A build is a minute of CPU or more on a cold cache: ten minutes of
    // CPU, and the wall-clock guard ten times that.
    build.cpu_limit = Val(600s)
    build.timeout = 6000s
    result: kit_exec_invoke(build, [env.jet, "build", files.join(directory, "no_nix.jet"), "--output-dir={output}"], directory, bootstrap, "")
    if kit_exec_process_failure(result) == .Val(failure) -> return Err("no-nix launcher build: {failure.status} {failure.detail}")
    if result.code != 0 || !files.is_file(launcher) {
        return Err("no-nix launcher build failed (exit {result.code}): {kit_exec_first_line(result.stderr)}")
    }
    Ok(launcher)
}

kit_no_nix_argv: fn(env: KitEnv, argv: [String], scratch: String, network: String) -> [String] Err! {
    helpers := [String]{}
    // `sh` is staged as the namespace's /bin/sh for the subject; the launcher never runs it.
    loop name in ["unshare", "mount", "umount", "sh", "ldd", "true"] {
        helper: kit_no_nix_helper(name) ?? return Err("no-nix required namespace helper not installed: {name}")
        helpers.push(helper)
    }
    bootstrap: files.join(scratch, "no-nix-bootstrap")
    files.create_dir_all(bootstrap) ?? return Err("no-nix bootstrap mkdir: {err}")
    marker: files.join(bootstrap, "entered")
    if files.exists(marker) -> files.remove(marker) ?? return Err("no-nix reset child marker: {err}")
    // This directory belongs to a single sequential kit case. Mounts are only
    // in the child namespace; bootstrap files are removed with case scratch.
    images := [String]{}
    loop i in [0, 1, 3] {
        image: kit_no_nix_patch(helpers[i], files.join(bootstrap, "helper-{i}")) ?? return Err(err)
        images.push(image)
    }
    subject: if files.is_file(argv[0]) -> argv[0] else -> kit_no_nix_helper(argv[0]) ?? return Err("no-nix step executable not found: {argv[0]}")
    subjects := [String]{subject}
    loop binary in [env.jet, env.jetpack] {
        if binary != "" && !kit_expect_named(subjects, binary) -> subjects.push(binary)
    }
    launcher := kit_no_nix_launcher(env, bootstrap) ?? return Err(err)
    result := [String]{launcher, "--outer", bootstrap, helpers[0], "--user", "--map-root-user", "--mount", "--propagation", "private"}
    if network == "disabled" -> result.push("--net")
    result.push(launcher.move())
    result.push(bootstrap.copy())
    loop helper in helpers -> result.push(helper)
    loop image in images -> result.push(image)
    result.push("{subjects.len()}")
    result.push(sys.get("PATH") ?? "/run/current-system/sw/bin:/usr/bin:/bin")
    loop (i, binary) in subjects {
        image: kit_no_nix_patch(binary, files.join(bootstrap, "subject-{i}")) ?? return Err(err)
        result.push(binary)
        result.push(image)
    }
    magic: files.read_at(subject, 0, 4) ?? return Err("no-nix subject header: {err}")
    result.push(if kit_no_nix_matches(magic, 0, [U8]{127, 69, 76, 70}) -> "elf" else -> "script")
    result.push(subject)
    loop i in 1..<argv.len() -> result.push(argv[i])
    Ok(result)
}

kit_no_nix_failure: fn(step: KitStep, run: KitRun) -> KitVerdict? {
    if step.isolate == "no-nix" && run.stderr.contains("JET_TESTKIT_NO_NIX_SETUP_FAILED") -> return Val(kit_expect_verdict("ERROR", "no-nix namespace setup: {run.stderr}"))
    None
}

// A `host-port:` golden row runs its program in a network namespace of its
// own, so the fixed port it binds is free whatever the host holds: a user
// namespace that maps the caller to root holds a fresh network namespace,
// whose loopback the launcher (`no_nix --netns`) raises with the host `ip`
// before it runs the program.
kit_netns_helpers: fn() -> [String] Err! {
    if sys.name() != "linux" -> return Err("a private network namespace requires Linux")
    helpers := [String]{}
    loop name in ["unshare", "ip"] {
        helper: kit_no_nix_helper(name) ?? return Err("a private network namespace requires `{name}`")
        helpers.push(helper)
    }
    Ok(helpers)
}

// unshare's argv for `argv` in a fresh network namespace; an empty `argv` is
// the probe that only raises the loopback. The launcher is built under
// SCRATCH/netns, shared by the row's probe and its steps.
kit_netns_argv: fn(env: KitEnv, argv: [String], scratch: String) -> [String] Err! {
    helpers: kit_netns_helpers() ?? return Err("{err}")
    bootstrap: files.join(scratch, "netns")
    files.create_dir_all(bootstrap) ?? return Err("netns bootstrap mkdir: {err}")
    launcher: kit_no_nix_launcher(env, bootstrap) ?? return Err(err)
    result := [String]{helpers[0], "--user", "--map-root-user", "--net", launcher, "--netns", helpers[1]}
    loop argument in argv -> result.push(argument.copy())
    Ok(result)
}

// SKIP-HOST with the reason when this host can't give a row its own network
// namespace: a helper is missing, or a probe can't raise a loopback in one.
// A launcher that doesn't build is the kit's ERROR, not the host's.
kit_netns_required: fn(env: KitEnv, scratch: String) -> KitVerdict? {
    _ := kit_netns_helpers() ?? return Val(kit_expect_verdict("SKIP-HOST", "host-port: {err}"))
    argv: kit_netns_argv(env, [String]{}, scratch) ?? return Val(kit_expect_verdict("ERROR", "host-port: {err}"))
    probe: process.cmd(argv).stdout(.Capture).stderr(.Capture).run() ?? return Val(kit_expect_verdict("SKIP-HOST", "host-port: private network namespace probe: {err}"))
    if probe.code != 0 -> return Val(kit_expect_verdict("SKIP-HOST", "host-port: this host refuses a private network namespace: {probe.errors.trim()}"))
    None
}
