use files: core.files

// A case is a public-CLI scenario, not a program entry. Descend through
// groups and fixture directories alike; only .case files are entries.
kit_cases_collect: fn(root: String, directory: String) -> [KitEntry] {
    entries := [KitEntry]{}
    if !files.exists(files.join(root, directory)) -> return entries
    children: files.list_dir(files.join(root, directory)) ?? panic("discover cases {directory}: {err}")
    loop child in children {
        if child.name.starts_with(".") -> next
        shown: files.join(directory, child.name)
        if child.is_dir {
            loop entry in kit_cases_collect(root, shown) -> entries.push(entry)
        } else if child.name.ends_with(".case") {
            entries.push(KitEntry{path: shown, expected: shown, project: directory, suite: "cases", mode: ""})
        }
    }
    entries
}

// Owner-retired Rust scenarios are outside the current case corpus, not host
// skips or CLI filters. The same committed list seals the registry manifest.
kit_cases_retired: fn(root: String) -> [String] {
    source: kit_exec_optional(files.join(root, "Tools/testkit/retired-with-rust.tsv")) ?? ""
    retired := [String]{}
    loop raw in source.split("\n") {
        line: raw.trim()
        if line == "" || line.starts_with("#") -> next
        fields: line.split("\t").to_list()
        assert(fields.len() == 2 && fields[1] != "", "retired case rows need an exact ID and reason")
        if fields[0].starts_with("tests/cases/") && fields[1].starts_with("Retired with Rust:") -> retired.push(fields[0])
    }
    retired
}

kit_cases_discover: fn(context: KitCtx) -> [KitEntry] {
    retired: kit_cases_retired(context.root)
    entries := [KitEntry]{}
    loop corpus in context.options.cases_corpora {
        loop entry in kit_cases_collect(context.root, corpus) {
            if !kit_expect_named(retired, entry.path) -> entries.push(entry)
        }
    }
    entries.sort_by(entry -> entry.path)
    entries
}

kit_cases_run: fn(entry: KitEntry, context: KitCtx) -> [KitOutcome] {
    source: files.read(files.join(context.root, entry.path)) ?? return [KitOutcome{verdict: kit_expect_verdict("ERROR", "read case: {err}"), run: kit_exec_failed("{err}")}]
    plan: kit_steps_parse_case(source)
    exact_id: context.options.cases != "" || context.options.filter == entry.path || kit_expect_named(context.options.bless.ids, entry.path)
    if plan.error == "" && plan.opt_in != "" && !context.options.opt_in && !exact_id -> return [KitOutcome{verdict: kit_expect_verdict("OPT-IN", plan.opt_in), run: kit_steps_action_run()}]
    if plan.error == "" && plan.repo_cwd != "" -> return [KitOutcome{verdict: kit_expect_verdict("REFUSED", "repo-cwd is golden-only; a case runs in its own work directory"), run: kit_exec_failed("repo-cwd is golden-only")}]
    work: files.join(context.scratch, "work")
    files.create_dir_all(work) ?? return [KitOutcome{verdict: kit_expect_verdict("ERROR", "case work: {err}"), run: kit_exec_failed("{err}")}]
    // Steps owns the single grammar, host requirements, fixture state staging,
    // token expansion, process policy, assertions and snapshot blessing.
    // CLI scenarios run once, independent of the golden tier selection.
    annotation: kit_cases_known_failure(entry, context.known, source)
    env := context.env
    if annotation != "" -> env.answer_limit = KIT_KNOWN_ANSWER_LIMIT
    steps: kit_steps_context(plan, entry.path, env, work, context.scratch,
        files.join(context.root, entry.project), context.bless)
    [kit_cases_known_verdict(kit_steps_execute(steps, kit_steps_hooks()), annotation)]
}

// How long a known-failing case waits for each answer (recv, poll, await, a
// wait with a deadline, repeat while): a product that still never answers
// fails at this deadline, not the case's own, and one that now answers still
// shows as an unexpected pass.
KIT_KNOWN_ANSWER_LIMIT: 10000000000

// An annotation changes the verdict, and caps the case's waits for an answer
// at KIT_KNOWN_ANSWER_LIMIT; it never changes the steps or their receipts.
// Header ownership wins over the central ledger for the same case. Besides FAIL,
// an annotation owns a crashed process (ICE exit 101 or a signal), keeping its
// ERROR detail. Other ERRORs and TIMEOUT are never owned.
kit_cases_known_failure: fn(entry: KitEntry, known: [String: String], source: String) -> String {
    prefix: "# KNOWN-FAILING "
    loop raw in source.split("\n") {
        line: raw.trim().copy()
        if line.starts_with(prefix) -> return kit_steps_byte_slice(line, prefix.count_bytes(), line.count_bytes()).trim()
    }
    kit_known_ledger(known, entry.path)
}

// The accepted-failing ledger at `path` (the profile's `baseline`; "" is
// none), read once per run: each row ID maps to "<card> <reason>". The first
// row for an ID wins.
kit_known_load: fn(path: String) -> [String: String] {
    known := [String: String]{}
    if path == "" -> return known
    ledger: kit_exec_optional(path) ?? return known
    loop raw in ledger.split("\n") {
        line: raw.trim()
        if line == "" || line.starts_with("#") -> next
        fields: line.split("\t").to_list()
        if fields.len() != 3 || (known.get(fields[0]) ?? "") != "" -> next
        known[fields[0]] = "{fields[1]} {fields[2]}"
    }
    known
}

// The ledger row owning one corpus entry: a row ID names the entry path itself,
// a file entry without `.jet`, or a project entry's directory.
kit_known_ledger: fn(known: [String: String], path: String) -> String {
    exact: known.get(path) ?? ""
    if exact != "" || !path.ends_with(".jet") -> return exact
    project: if path.ends_with("/run.jet") -> known.get(kit_steps_byte_slice(path, 0, path.count_bytes() - 8)) ?? "" else -> ""
    if project != "" -> return project
    known.get(kit_steps_byte_slice(path, 0, path.count_bytes() - 4)) ?? ""
}

kit_cases_known_verdict: fn(outcome: KitOutcome, annotation: String) -> KitOutcome {
    result := outcome
    if annotation == "" -> return result
    if kit_cases_owned_failure(result.verdict) {
        result.verdict.status = "KNOWN-FAILING"
        result.verdict.detail = "{annotation}: {result.verdict.detail}"
    } else if result.verdict.status == "PASS" {
        result.verdict.status = "UNEXPECTED-PASS"
        result.verdict.detail = "{annotation}: remove stale known-failing annotation"
    }
    result
}

// A failure the product owns, which a ledger row may annotate. Beyond FAIL,
// that is an ICE, a signal death, or a child that exited without reading its
// scripted input (the product left before the case could drive it), never a
// kit fault such as a spawn or wait error.
kit_cases_owned_failure: fn(verdict: KitVerdict) -> Bool {
    if verdict.status == "FAIL" -> return true
    verdict.status == "ERROR" && (verdict.detail.contains("internal compiler error (exit 101)") || verdict.detail.contains("child terminated by signal") || verdict.detail.contains("without reading it"))
}
