use {
    process: core.process
    files: core.files
    sys: core.sys
    time: core.time
}

// A step that runs longer than a minute declares its own `limit: time=`.
kit_exec_defaults: fn() -> KitOptions {
    KitOptions{suite: "golden", jet: sys.get("JET") ?? "", jetpack: "", tiers: ["o0", "o1", "o2"], filter: "", cases: "", shard_index: 1, shard_count: 1, sharded: false, timeout: 60, scratch: "", results: "", list: false, coverage: false, bless: KitBless{ids: [], all: false, reason: "", allow_shrink: [], first_tier: true}, error: ""}
}


// The corpus ids `options` selects of `all_ids`. A `cases` file names only
// corpus ids, unless others_selected lets it name the run's other tests too.
kit_exec_select_ids: fn(all_ids: [String], options: KitOptions) -> KitSelection {
    requested := [String]{}
    listed: options.cases != ""
    if listed {
        text: files.read(options.cases) ?? return KitSelection{ids: [], error: "read cases file: {err}"}
        loop raw in text.split("\n") {
            id: raw.trim().copy()
            if id == "" || id.starts_with("#") -> next
            if kit_expect_named(requested, id) -> return KitSelection{ids: [], error: "duplicate case ID: {id}"}
            if !kit_expect_named(all_ids, id) {
                if options.others_selected -> next
                return KitSelection{ids: [], error: "unknown case ID: {id}"}
            }
            requested.push(id)
        }
    }
    seen := [String]{}
    loop id in options.bless.ids {
        if kit_expect_named(seen, id) -> return KitSelection{ids: [], error: "duplicate bless ID: {id}"}
        if !kit_expect_named(all_ids, id) -> return KitSelection{ids: [], error: "unknown bless ID: {id}"}
        seen.push(id.copy())
    }
    selected := [String]{}
    loop (index, id) in all_ids {
        if listed && !kit_expect_named(requested, id) -> next
        if options.bless.ids.len() > 0 && !kit_expect_named(options.bless.ids, id) -> next
        if options.filter != "" && !id.contains(options.filter) -> next
        if index % options.shard_count != options.shard_index - 1 -> next
        selected.push(id.copy())
    }
    KitSelection{ids: selected, error: ""}
}

kit_exec_failed: fn(message: String) -> KitRun {
    KitRun{stdout: "", stderr: "", code: -1, signal: None, timed_out: false, error: message}
}

kit_exec_refused: fn(message: String) -> KitRun {
    KitRun{stdout: "", stderr: "", code: -1, signal: None, timed_out: false, error: message, refused: true}
}

// Each case's children get a home of their own under its scratch: HOME,
// JET_HOME and the XDG roots, so no case reads or writes the invoking user's
// ~/.jet, configuration or caches.
kit_exec_home: fn(scratch: String) -> String { files.join(scratch, "home") }

// The invoking user's home from the password database; HOME only when the
// database has no row for this user, and "" when neither is known.
kit_exec_user_home: fn() -> String {
    uid: "{sys.getuid()}"
    if files.read("/etc/passwd") == .Ok(text) {
        loop line in text.split("\n") {
            fields: line.split(":").to_list()
            if fields.len() >= 6 && fields[2] == uid -> return fields[5].copy()
        }
    }
    sys.get("HOME") ?? ""
}

// `value` resolved from `cwd`, through its symbolic links; a path that does
// not exist yet resolves through its parent.
kit_exec_resolved: fn(value: String?, cwd: String) -> String? {
    path: value ?? return None
    if path == "" -> return None
    absolute: if path.starts_with("/") -> path.copy() else -> files.join(cwd, path)
    if files.canonicalize(absolute) == .Ok(resolved) -> return Val(resolved)
    parent: files.canonicalize(files.dirname(absolute)) ?? return Val(absolute)
    Val(files.join(parent, files.basename(absolute)))
}

// A child whose HOME or JET_HOME is the invoking user's own would write that
// user's ~/.jet; the kit refuses to start it and names why.
kit_exec_home_refusal: fn(env: KitEnv, cwd: String, scratch: String, overlay: [KitEnvVar]) -> String? {
    user: kit_exec_resolved(Val(kit_exec_user_home()), "/") ?? return None
    if (kit_exec_resolved(kit_steps_env_value("HOME", env, scratch, overlay), cwd) ?? "") == user {
        return Val("refused: the child's HOME is the invoking user's home {user}")
    }
    user_jet: kit_exec_resolved(Val(files.join(user, ".jet")), "/") ?? return None
    if (kit_exec_resolved(kit_steps_env_value("JET_HOME", env, scratch, overlay), cwd) ?? "") == user_jet {
        return Val("refused: the child's JET_HOME is the invoking user's {user_jet}")
    }
    None
}

// The toolchain tree whose Core the `jet` under test reads:
// JET_TEST_TOOLCHAIN_ROOT when set, then JET_TOOLCHAIN_ROOT, else the nearest
// directory at or above the kit's own working directory, then at or above the
// run's root, that holds `Core/` and `Compiler/Prelude/` (the `jet` CLI's
// rule). A case's scratch root is never one. None: there is no tree, and the
// child finds its own Core. JET_TEST_TOOLCHAIN_ROOT separates the two trees
// when the jet under test is older than the one running the kit (a release
// gate's release side): the runner reads its own Core through
// JET_TOOLCHAIN_ROOT, and the rows read the older tree's.
kit_exec_toolchain_root: fn(root: String) -> String? {
    if sys.get("JET_TEST_TOOLCHAIN_ROOT") == .Val(set) && set != "" -> return Val(set)
    if sys.get("JET_TOOLCHAIN_ROOT") == .Val(set) && set != "" -> return Val(set)
    loop start in [files.cwd() ?? "", root] {
        if start == "" -> next
        current := files.canonicalize(start) ?? next
        loop {
            if files.is_dir(files.join(current, "Core")) && files.is_dir(files.join(current, "Compiler/Prelude")) -> return Val(current)
            if current == "/" -> break
            current = files.dirname(current)
        }
    }
    None
}

// The children's PATH leads with the directory of JET, the `jet` the run was
// handed, so a script's `#!/usr/bin/env jet` runs it rather than the host's
// `jet` (a seed launcher reads the home the kit replaced). The inherited PATH
// when JET is unset or names no `jet`.
kit_exec_path: fn() -> String? {
    inherited: sys.get("PATH")
    named: sys.get("JET") ?? return inherited
    jet: files.canonicalize(named) ?? return inherited
    if files.basename(jet) != "jet" -> return inherited
    directory: files.dirname(jet)
    if inherited == {
        .Val(path) -> Val("{directory}:{path}")
        .None -> Val(directory)
    }
}

kit_exec_base_value: fn(name: String, env: KitEnv, scratch: String) -> String? {
    if env.env_clear -> return None
    if {
        name == "JET_COMPILER_EXTENSION" -> None
        // Every build under test runs IR Lint after each optimizer pass.
        name == "NO_COLOR" || name == "JET_RECEIPT_BYPASS" || name == "JET_OPT_VERIFY" -> Val("1")
        name == "CLICOLOR" -> Val("0")
        name == "TERM" -> Val("dumb")
        name == "JET_REPL_HISTORY" -> Val("off")
        // Cases run outside the checkout: the compiler under test reads the kit's toolchain tree.
        name == "JET_TOOLCHAIN_ROOT" -> kit_exec_toolchain_root(env.root)
        name == "PATH" -> kit_exec_path()
        name == "JET_STORE_DIR" -> Val(files.join(env.scratch, "store"))
        name == "JET_FFI_CACHE_DIR" -> if env.ffi_cache != "" -> Val(env.ffi_cache) else -> Val(files.join(env.scratch, "ffi"))
        // A row's tools that stage files of their own keep them in its tree.
        name == "TMPDIR" || name == "TMP" || name == "TEMP" || name == "JET_TEST_SCRATCH_DIR" -> Val(files.join(scratch, "tmp"))
        name == "HOME" -> Val(kit_exec_home(scratch))
        name == "JET_HOME" -> Val(files.join(kit_exec_home(scratch), ".jet"))
        name == "XDG_CONFIG_HOME" -> Val(files.join(kit_exec_home(scratch), ".config"))
        name == "XDG_CACHE_HOME" -> Val(files.join(kit_exec_home(scratch), ".cache"))
        name == "XDG_DATA_HOME" -> Val(files.join(kit_exec_home(scratch), ".local/share"))
        name == "XDG_STATE_HOME" -> Val(files.join(kit_exec_home(scratch), ".local/state"))
        name == "JETPACK_ROOT" -> Val(files.join(scratch, "jetpack"))
        // The `jet` under test runs its engine verbs with the run's jetpack.
        name == "JETPACK_BIN" -> if env.jetpack != "" -> Val(env.jetpack) else -> sys.get(name)
        name == "JET_CC_PACK_ROOT" -> if env.cc_pack != "" -> Val(env.cc_pack) else -> sys.get(name)
        name == "JET_SCHEMA_CACHE_DIR" -> Val(files.join(scratch, "schema"))
        else -> sys.get(name)
    }
}

// Inherit the caller's environment, removing only the compiler-extension hook.
// Cache roots are run-wide; temporary, schema, jetpack and home roots are
// case-local. Callers check kit_exec_home_refusal before spawning. Output is
// streamed, not text-captured: a child may write any bytes, so the kit reads
// them as bytes and its receipt text is lossy instead of a failed wait.
kit_exec_spec: fn(env: KitEnv, argv: [String], cwd: String, scratch: String, overlay: [KitEnvVar]) -> ProcessSpec {
    spec := process.cmd(argv).cwd(cwd).stdout(.Stream).stderr(.Stream).stdin(.Stream).timeout(env.timeout)
    if env.env_clear -> spec = spec.env_clear()
    else {
        spec = spec.env_remove("JET_COMPILER_EXTENSION")
            .env("NO_COLOR", kit_exec_base_value("NO_COLOR", env, scratch) ?? "")
            .env("CLICOLOR", kit_exec_base_value("CLICOLOR", env, scratch) ?? "")
            .env("TERM", kit_exec_base_value("TERM", env, scratch) ?? "")
            .env("JET_RECEIPT_BYPASS", kit_exec_base_value("JET_RECEIPT_BYPASS", env, scratch) ?? "")
            .env("JET_OPT_VERIFY", kit_exec_base_value("JET_OPT_VERIFY", env, scratch) ?? "")
            .env("JET_REPL_HISTORY", kit_exec_base_value("JET_REPL_HISTORY", env, scratch) ?? "")
            .env("JET_STORE_DIR", kit_exec_base_value("JET_STORE_DIR", env, scratch) ?? "")
            .env("JET_FFI_CACHE_DIR", kit_exec_base_value("JET_FFI_CACHE_DIR", env, scratch) ?? "")
            .env("TMPDIR", kit_exec_base_value("TMPDIR", env, scratch) ?? "")
            .env("TMP", kit_exec_base_value("TMP", env, scratch) ?? "")
            .env("TEMP", kit_exec_base_value("TEMP", env, scratch) ?? "")
            .env("JET_TEST_SCRATCH_DIR", kit_exec_base_value("JET_TEST_SCRATCH_DIR", env, scratch) ?? "")
            .env("HOME", kit_exec_base_value("HOME", env, scratch) ?? "")
            .env("JET_HOME", kit_exec_base_value("JET_HOME", env, scratch) ?? "")
            .env("XDG_CONFIG_HOME", kit_exec_base_value("XDG_CONFIG_HOME", env, scratch) ?? "")
            .env("XDG_CACHE_HOME", kit_exec_base_value("XDG_CACHE_HOME", env, scratch) ?? "")
            .env("XDG_DATA_HOME", kit_exec_base_value("XDG_DATA_HOME", env, scratch) ?? "")
            .env("XDG_STATE_HOME", kit_exec_base_value("XDG_STATE_HOME", env, scratch) ?? "")
            .env("JETPACK_ROOT", kit_exec_base_value("JETPACK_ROOT", env, scratch) ?? "")
            .env("JETPACK_BIN", kit_exec_base_value("JETPACK_BIN", env, scratch) ?? "")
            .env("JET_CC_PACK_ROOT", kit_exec_base_value("JET_CC_PACK_ROOT", env, scratch) ?? "")
            .env("JET_SCHEMA_CACHE_DIR", kit_exec_base_value("JET_SCHEMA_CACHE_DIR", env, scratch) ?? "")
        // With no toolchain tree the variable is removed: an empty one names `/`.
        // The child gets the resolved tree as JET_TOOLCHAIN_ROOT alone, so a
        // kit it runs resolves it the same way.
        spec = spec.env_remove("JET_TEST_TOOLCHAIN_ROOT")
        if kit_exec_base_value("JET_TOOLCHAIN_ROOT", env, scratch) == {
            .Val(toolchain) -> spec = spec.env("JET_TOOLCHAIN_ROOT", toolchain)
            .None -> spec = spec.env_remove("JET_TOOLCHAIN_ROOT")
        }
        if kit_exec_base_value("PATH", env, scratch) == .Val(path) -> spec = spec.env("PATH", path)
    }
    if env.memory_limit > 0 -> spec = spec.memory_limit(env.memory_limit)
    loop variable in overlay {
        if variable.value == {
            .Val(value) -> spec = spec.env(variable.name, value)
            .None -> spec = spec.env_remove(variable.name)
        }
    }
    spec
}

// Refuses a child that would run in the invoking user's home and creates the
// case's temporary and home directories: the run that stops the spawn, or None.
kit_exec_prepare: fn(env: KitEnv, cwd: String, scratch: String, overlay: [KitEnvVar]) -> KitRun? {
    if kit_exec_home_refusal(env, cwd, scratch, overlay) == .Val(reason) -> return Val(kit_exec_refused(reason))
    files.create_dir_all(files.join(scratch, "tmp")) ?? return Val(kit_exec_failed("create child temp directory: {err}"))
    files.create_dir_all(kit_exec_home(scratch)) ?? return Val(kit_exec_failed("create child home directory: {err}"))
    None
}

kit_exec_receipt: fn(receipt: ProcessReceipt, elapsed_ns: Int, input_error: String) -> KitRun {
    limit_hit: if receipt.limit_hit == {
        .Val(limit) -> if limit == {
            .WallTime -> "time"
            .CpuTime -> "cpu"
            .Memory -> "memory"
            .OpenFiles -> "open-files"
            .Output -> "output"
        }
        .None -> ""
    }
    KitRun{stdout: receipt.output, stderr: receipt.errors, code: receipt.code,
        signal: receipt.signal, timed_out: receipt.timed_out, error: input_error,
        elapsed_ns: elapsed_ns, limit_hit: limit_hit}
}

// A child that exits before reading its input breaks the pipe; name its exit
// and first stderr line so the row shows why it stopped reading.
kit_exec_input_detail: fn(error: String, code: Int, errors: String) -> String {
    first := ""
    loop line in errors.lines() {
        if line.trim() == "" -> next
        first = line.trim().copy()
        break
    }
    if first.count_bytes() > 160 -> first = kit_steps_byte_slice(first, 0, 160)
    if first == "" -> return "{error}; child exited {code} without reading it"
    "{error}; child exited {code} without reading it: {first}"
}

kit_exec_invoke_with_env: fn(env: KitEnv, argv: [String], cwd: String, scratch: String, stdin: [U8], overlay: [KitEnvVar]) -> KitRun {
    kit_exec_run(env, argv, cwd, scratch, stdin, overlay, None)
}

// Runs the child on a terminal: its stdin and stdout share the terminal and
// stdout is the terminal transcript. `stdin` is typed at spawn and each event
// at its time from spawn. Input never closes the terminal, which would hang
// up the child; a close event types the end-of-file character instead.
kit_exec_invoke_terminal: fn(env: KitEnv, argv: [String], cwd: String, scratch: String, stdin: [U8], overlay: [KitEnvVar], terminal: KitTerminal) -> KitRun {
    kit_exec_run(env, argv, cwd, scratch, stdin, overlay, Val(terminal))
}

// Events by time; events at the same time keep their line order.
kit_exec_terminal_order: fn(events: [KitTerminalEvent]) -> [KitTerminalEvent] {
    ordered := [KitTerminalEvent]{}
    loop event in events {
        ordered.push(event.copy())
        position := ordered.len() - 1
        loop position > 0 && ordered[position - 1].at > ordered[position].at {
            earlier: ordered[position - 1]
            ordered[position - 1] = ordered[position]
            ordered[position] = earlier
            position -= 1
        }
    }
    ordered
}

kit_exec_run: fn(env: KitEnv, argv: [String], cwd: String, scratch: String, stdin: [U8], overlay: [KitEnvVar], terminal: KitTerminal?) -> KitRun {
    if kit_exec_prepare(env, cwd, scratch, overlay) == .Val(stopped) -> return stopped
    started: time.instant()
    spec := kit_exec_spec(env, argv, cwd, scratch, overlay)
    if terminal == .Val(shape) {
        spec = spec.terminal(TerminalPolicy{size: TerminalSize{cols: shape.cols, rows: shape.rows}, mode: .Cooked})
    }
    child := spec.spawn() ?? return kit_exec_failed("spawn: {err}")
    // A row's files on a memory-backed scratch are memory it holds: the guard
    // counts them beside the child's resident memory.
    files_in_memory: if env.scratch_memory -> scratch.copy() else -> ""
    watched := KitResident{pid: if env.resident_limit > 0 -> child.id() else -> 0, limit: env.resident_limit, tree: env.resident_tree, due: 0, killed: false, peak: 0, scratch: files_in_memory, scratch_due: 0, scratch_bytes: 0}
    // Empty input writes nothing: a child that exits before the kit reaches its
    // stdin closed the pipe, which is no error when there was nothing to send.
    input_error := ""
    if stdin.len() > 0 {
        child.stdin.write_all(stdin) ?? {
            input_error = "stdin: {err}"
            ()
        }
    }
    if terminal == {
        .Val(shape) -> {
            eof: String.from_bytes([U8{4}]) ?? panic("EOF character")
            loop event in kit_exec_terminal_order(shape.events) {
                kit_exec_wait(child, watched, started, event.at)
                if event.kind == "resize" {
                    session: child.terminal ?? {
                        if input_error == "" -> input_error = "terminal resize: no terminal session"
                        next
                    }
                    session.resize(TerminalSize{cols: event.cols, rows: event.rows}) ?? {
                        if input_error == "" -> input_error = "terminal resize: {err}"
                        ()
                    }
                } else if event.kind == "close" {
                    // Like closing a pipe, ending input after the child has
                    // exited is no error.
                    child.stdin.write_text(eof).drop("the child may have exited before its input ended")
                } else {
                    child.stdin.write_text(event.text) ?? {
                        if input_error == "" -> input_error = "terminal input: {err}"
                        ()
                    }
                }
            }
        }
        .None -> child.stdin.close()
    }
    kit_exec_wait(child, watched, started, -1)
    // Every output byte, read before the wait detaches the readers.
    output := [U8]{}
    errors := [U8]{}
    read_error := kit_exec_read_stdout(child.stdout, output)
    errors_read: kit_exec_read_stderr(child.stderr, errors)
    if read_error == "" -> read_error = errors_read
    receipt: child.wait() ?? return kit_exec_failed("wait: {err}")
    if read_error != "" -> return kit_exec_failed(read_error)
    // The entry's claim: the child's resident peak and, on a memory-backed
    // scratch, the files the row holds once it is done.
    if env.peak == .Val(cell) {
        held: watched.peak + if files_in_memory == "" -> 0 else -> kit_exec_tree_bytes(files_in_memory)
        permit := cell.guard_edit()
        if held > permit.value.bytes -> permit.value.bytes = held
    }
    errors_text: kit_exec_redact(kit_steps_utf8_lossy(errors), overlay)
    run := kit_exec_receipt(receipt, started.elapsed().ns, if input_error == "" -> "" else -> kit_exec_input_detail(input_error, receipt.code, errors_text))
    run.stdout = kit_exec_redact(kit_steps_utf8_lossy(output), overlay)
    run.stderr = errors_text
    run.stdout_bytes = Val(output)
    run.stderr_bytes = Val(errors)
    if watched.killed -> run.limit_hit = "memory"
    run
}

// The collector holds each output whole, so reading one to its end before the
// other cannot stall the child.
kit_exec_read_stdout: fn(stream: ProcessStdoutStream, bytes: &[U8]) -> String {
    loop {
        chunk: stream.read(1048576) ?? return "read stdout: {err}"
        if chunk.len() == 0 -> return ""
        bytes.extend(chunk)
    }
    ""
}

kit_exec_read_stderr: fn(stream: ProcessStderrStream, bytes: &[U8]) -> String {
    loop {
        chunk: stream.read(1048576) ?? return "read stderr: {err}"
        if chunk.len() == 0 -> return ""
        bytes.extend(chunk)
    }
    ""
}

// The receipt's redaction of captured output: each nonempty value of a
// secret-named variable the step sets reads `<redacted>`, longest value
// first. Streamed output bypasses the receipt, so the kit applies it to the
// text its predicates read; the exact bytes stay unredacted. A secret name
// holds one of the parts Core's process receipt treats as secret, ASCII
// case-insensitive.
kit_exec_redact: fn(text: String, overlay: [KitEnvVar]) -> String {
    secrets := [String]{}
    loop variable in overlay {
        value: variable.value ?? next
        name: variable.name.to_ascii_lower()
        secret := false
        loop marker in ([String]{"secret", "token", "password", "passwd", "credential", "key"}) {
            if name.contains(marker) -> secret = true
        }
        if !secret || value == "" -> next
        secrets.push(value.copy())
        position := secrets.len() - 1
        loop position > 0 && secrets[position - 1].count_bytes() < secrets[position].count_bytes() {
            longer: secrets[position]
            secrets[position] = secrets[position - 1]
            secrets[position - 1] = longer
            position -= 1
        }
    }
    redacted := text
    loop secret in secrets -> redacted = redacted.replace(secret, "<redacted>")
    redacted
}

// Waits on this task until the child exits or, when `until` is not negative,
// until `until` ns after spawn, polling the child and sampling its resident
// memory meanwhile. A watcher task of its own would need a second scheduler
// worker beside this waiting one: a pool whose workers all wait on watchers
// that never get a worker stops.
kit_exec_wait: fn(child: ProcessChild, watched: &KitResident, started: time.Instant, until: Int) {
    pause := 1
    loop {
        at: started.elapsed().ns
        if until >= 0 && at >= until -> return
        exited: child.exited() ?? return
        if exited -> return
        kit_exec_watch_resident(watched, at)
        time.sleep(if until >= 0 && until - at < pause * 1000000 -> time.duration_ns(until - at) else -> time.duration_ms(pause))
        if pause < 10 -> pause = if pause * 2 > 10 -> 10 else -> pause * 2
    }
}

// The resident-memory guard on one child: the child (`pid` 0 is unwatched),
// its limit in bytes, whether it counts the child's live descendants (`tree`),
// when it samples next in ns after spawn, whether it stopped the child, and
// the largest resident size it sampled, in bytes. `scratch` is the row's
// memory-backed scratch ("" when its files are on disk), sampled every
// second (`scratch_due`) into `scratch_bytes`.
KitResident: struct {
    pid: Int
    limit: Int
    tree: Bool
    due: Int
    killed: Bool
    peak: Int
    scratch: String
    scratch_due: Int
    scratch_bytes: Int
}

// The run-wide memory guard counts resident memory, not address space: a
// RLIMIT_AS limit fails thread-stack reservations long before the child uses
// that memory. Samples VmRSS every 100 ms (`at` is ns after spawn), and the
// row's files on a memory-backed scratch every second, and kills the child
// when the two together pass `limit` bytes, so a row that fills the memory
// scratch stops at its guard instead of exhausting the host. Under `tree` (a
// case's `limit: resident=`) it sums the child and its live descendants and
// kills them all. A case's `limit: memory=` keeps Core memory_limit.
kit_exec_watch_resident: fn(watched: &KitResident, at: Int) Never! {
    if watched.pid <= 0 || watched.killed || at < watched.due -> return
    watched.due = at + 100000000
    if watched.scratch != "" && at >= watched.scratch_due {
        watched.scratch_due = at + 1000000000
        watched.scratch_bytes = kit_exec_tree_bytes(watched.scratch)
    }
    pids := [Int]{}
    used: kit_exec_tree_resident(watched.pid, watched.tree, pids)
    if pids.len() == 0 -> return
    if used > watched.peak -> watched.peak = used
    if used + watched.scratch_bytes <= watched.limit -> return
    #Unsafe("the testkit stops its own step child at the resident-memory guard") {
        sys.kill(watched.pid, 9) ?? return
        loop descendant in pids {
            if descendant != watched.pid -> sys.kill(descendant, 9).drop("a descendant may exit before its signal")
        }
    }
    watched.killed = true
}

// The bytes of the files under `path`, never following a link; 0 when it is
// gone.
kit_exec_tree_bytes: fn(path: String) -> Int {
    entries: files.list_dir(path) ?? return 0
    total := 0
    loop entry in entries {
        info: files.stat(entry.path) ?? next
        if info.is_symlink -> next
        total += if info.is_dir -> kit_exec_tree_bytes(entry.path) else -> info.size
    }
    total
}

// Whether the canonical `path` lies on a memory-backed filesystem (tmpfs or
// ramfs): the type of the mount with the longest mount point holding it
// (/proc/self/mounts). False when the table can't be read.
kit_exec_memory_backed: fn(path: String) -> Bool {
    mounts: files.read("/proc/self/mounts") ?? return false
    best := -1
    memory := false
    loop line in mounts.split("\n") {
        fields: line.split(" ").to_list()
        if fields.len() < 3 -> next
        point: fields[1]
        holds: point == "/" || path == point || path.starts_with("{point}/")
        if !holds || point.count_bytes() <= best -> next
        best = point.count_bytes()
        memory = fields[2] == "tmpfs" || fields[2] == "ramfs"
    }
    memory
}

// The resident bytes of `pid`, plus under `tree` those of its live descendants
// (`/proc/<pid>/task/<tid>/children`); `pids` lists every process counted,
// none when `pid` itself is gone.
kit_exec_tree_resident: fn(pid: Int, tree: Bool, pids: &[Int]) -> Int Never! {
    used := 0
    queue := [Int]{pid}
    at := 0
    loop at < queue.len() {
        current: queue[at]
        at += 1
        status: files.read("/proc/{current}/status") ?? next
        used += kit_exec_resident_bytes(status)
        pids.push(current)
        if !tree -> next
        threads: files.list_dir("/proc/{current}/task") ?? next
        loop thread in threads {
            children: files.read(files.join(thread.path, "children")) ?? next
            loop word in children.split(" ") {
                child: Int.parse(word.trim().copy()) ?? next
                queue.push(child)
            }
        }
    }
    used
}

kit_exec_resident_bytes: fn(status: String) -> Int { kit_exec_kib_field(status, "VmRSS:") }

// The byte value of a `/proc` "<field> <n> kB" row, or 0 when the row is absent.
kit_exec_kib_field: fn(text: String, field: String) -> Int {
    loop line in text.split("\n") {
        if !line.starts_with(field) -> next
        loop value in line.slice(field.len(), line.len()).trim().split(" ") {
            if value.len() > 0 -> return (Int.parse(value.copy()) ?? 0) * 1024
        }
    }
    0
}

// Memory this process may still claim, in bytes; 0 when unknown. That is the host's
// MemAvailable less the kit's headroom (kit_exec_host_room), lowered to the room left under every
// memory.high and memory.max on the cgroup path this process runs in: a build-slot scope
// caps its suites far below the host, and a pool sized from the host alone overruns the cap
// and drives the machine into swap.
kit_exec_available_memory: fn() -> Int {
    meminfo: files.read("/proc/meminfo") ?? return 0
    available := kit_exec_host_room(kit_exec_kib_field(meminfo, "MemAvailable:"), kit_exec_kib_field(meminfo, "MemTotal:"))
    membership: files.read("/proc/self/cgroup") ?? return available
    prefix := ""
    loop part in kit_exec_cgroup_path(membership).split("/") {
        if part == "" -> next
        prefix = "{prefix}/{part}"
        dir: "/sys/fs/cgroup{prefix}"
        current: kit_exec_cgroup_value(files.read("{dir}/memory.current") ?? "")
        available = kit_exec_room(available, kit_exec_cgroup_value(files.read("{dir}/memory.high") ?? ""), current)
        available = kit_exec_room(available, kit_exec_cgroup_value(files.read("{dir}/memory.max") ?? ""), current)
    }
    available
}

// The unified-hierarchy path in a /proc/self/cgroup listing (its `0::` row), or "".
kit_exec_cgroup_path: fn(membership: String) -> String {
    loop line in membership.split("\n") {
        if line.starts_with("0::") -> return line.slice(3, line.len()).trim().copy()
    }
    ""
}

// A cgroup memory file's byte count; 0 for `max`, an empty read or anything unreadable.
kit_exec_cgroup_value: fn(text: String) -> Int { Int.parse(text.trim().copy()) ?? 0 }

// `available` lowered to the room under `limit` once `current` is in use. A 0 limit is no
// limit and a 0 `available` is unknown; a full cgroup leaves one byte, so the pool runs one.
kit_exec_room: fn(available: Int, limit: Int, current: Int) -> Int {
    if limit <= 0 -> return available
    room := limit - current
    if room < 1 -> room = 1
    if available <= 0 || room < available -> return room
    available
}

// The host's MemAvailable `available` less the headroom the kit leaves the rest of the
// machine: a tenth of MemTotal `total`, at least 1 GiB. 0 (unknown) stays 0; a host with
// no room past the headroom leaves one byte, so the pool runs one entry.
kit_exec_host_room: fn(available: Int, total: Int) -> Int {
    if available <= 0 -> return 0
    headroom := total /% 10
    if headroom < 1073741824 -> headroom = 1073741824
    if available - headroom < 1 -> return 1
    available - headroom
}

// A run with no environment overlay whose stdin is `stdin`'s text.
kit_exec_invoke: fn(env: KitEnv, argv: [String], cwd: String, scratch: String, stdin: String) -> KitRun {
    kit_exec_invoke_with_env(env, argv, cwd, scratch, stdin.bytes(), [KitEnvVar]{})
}

kit_exec_process_failure: fn(run: KitRun) -> KitVerdict? {
    if run.refused -> return Val(kit_expect_verdict("REFUSED", run.error))
    if run.error != "" -> return Val(kit_expect_verdict("ERROR", run.error))
    if run.timed_out -> return Val(kit_expect_verdict("TIMEOUT", "wall-clock limit"))
    if run.limit_hit == "memory" -> return Val(kit_expect_verdict("ERROR", "memory limit hit"))
    if run.signal != None -> return Val(kit_expect_verdict("ERROR", "child terminated by signal"))
    if run.code == 101 -> return Val(kit_expect_verdict("ERROR", "internal compiler error (exit 101)"))
    None
}

kit_exec_write: fn(path: String, contents: String) {
    files.create_dir_all(files.dirname(path)) ?? panic("mkdir {path}: {err}")
    files.write(path, contents) ?? panic("write {path}: {err}")
}

kit_exec_copy_file: fn(source: String, destination: String) {
    bytes: files.read_bytes(source) ?? panic("read {source}: {err}")
    files.create_dir_all(files.dirname(destination)) ?? panic("mkdir {destination}: {err}")
    files.write_bytes(destination, bytes) ?? panic("copy {source}: {err}")
    info: files.stat(source) ?? panic("stat {source}: {err}")
    files.chmod(destination, info.mode % 512) ?? panic("copy mode {source}: {err}")
}

// Case scratch may hold trees a tool made read-only on purpose (Hangar objects
// and seals). Removal restores owner access on directories, never following a
// link, then retries.
kit_exec_remove_tree: fn(path: String) -> Bool Err! {
    if files.remove_all(path) == .Ok(_) -> return Ok(true)
    kit_exec_make_writable(path)
    files.remove_all(path) ?? return Err("{err}")
    Ok(true)
}

// A case's descendants that moved to a process group of their own outlive the
// step that started them. Before its scratch goes, stop every process still
// running an executable from that scratch or working inside it.
kit_exec_stop_strays: fn(scratch: String) {
    if sys.name() != "linux" -> return
    root: files.canonicalize(scratch) ?? return
    inside: "{root}/"
    own: process.current_pid()
    entries: files.list_dir("/proc") ?? return
    loop entry in entries {
        pid: Int.parse(files.basename(entry.path)) ?? next
        if pid == own -> next
        executable: files.read_link("/proc/{pid}/exe") ?? ""
        directory: files.read_link("/proc/{pid}/cwd") ?? ""
        if !executable.starts_with(inside) && !directory.starts_with(inside) && directory != root -> next
        #Unsafe("the testkit stops a process its own case left running in the case scratch") {
            sys.kill(pid, 9).drop("a stray may exit before its signal")
        }
    }
}

kit_exec_make_writable: fn(path: String) {
    info: files.stat(path) ?? return
    if info.is_symlink || !info.is_dir -> return
    files.chmod(path, info.mode % 64 + 448) ?? return
    entries: files.list_dir(path) ?? return
    loop entry in entries -> kit_exec_make_writable(entry.path)
}


kit_exec_optional: fn(path: String) -> String? {
    if !files.exists(path) -> return None
    Val(files.read(path) ?? panic("read {path}: {err}"))
}

// Copy a fixture or source tree. `fixture_state` stages `state/` and
// `fixture-state/` as `.jet`. `authored_jet` copies `.jet` itself: a case
// fixture's `.jet` is authored test data (locks, binding caches), while golden
// and UI source trees may hold local compiler caches, so they copy only its
// `bindings/`, the checked-in generated binding caches the compiler reads
// there.
kit_exec_copy_tree: fn(source: String, destination: String, fixture_state: Bool, authored_jet: Bool) {
    files.create_dir_all(destination) ?? panic("mkdir {destination}: {err}")
    entries: files.list_dir(source) ?? panic("list {source}: {err}")
    loop entry in entries -> kit_exec_copy_entry(entry, destination, fixture_state, authored_jet)
}

// Copies one listed `entry` of a tree into `destination` (kit_exec_copy_tree).
kit_exec_copy_entry: fn(entry: files.DirEntry, destination: String, fixture_state: Bool, authored_jet: Bool) {
    if entry.name == ".git" -> return
    if entry.name == ".jet" && !authored_jet {
        bindings: files.join(entry.path, "bindings")
        if entry.is_dir && files.is_dir(bindings) -> kit_exec_copy_tree(bindings, files.join(files.join(destination, ".jet"), "bindings"), false, true)
        return
    }
    name: if fixture_state && (entry.name == "state" || entry.name == "fixture-state") -> ".jet" else -> entry.name
    target: files.join(destination, name)
    if entry.is_dir -> kit_exec_copy_tree(entry.path, target, fixture_state, authored_jet)
    else -> kit_exec_copy_file(entry.path, target)
}

kit_exec_requires: fn(requirement: String, env: KitEnv, work: String, scratch: String) -> KitVerdict? {
    if requirement.starts_with("first-existing ") -> return None
    if requirement.starts_with("path-exists:") {
        path: kit_steps_expand(requirement.slice(12, requirement.len()), env, work, scratch, "")
        if !files.exists(files.join(work, path)) -> return Val(kit_expect_verdict("SKIP-HOST", requirement))
        return None
    }
    if requirement.starts_with("env:") {
        assignment: requirement.slice(4, requirement.len())
        equals: assignment.index("=") ?? -1
        if equals <= 0 -> return Val(kit_expect_verdict("REFUSED", "invalid requires: {requirement}"))
        name: assignment.slice(0, equals)
        value: assignment.slice(equals + 1, assignment.len())
        if (sys.get(name) ?? "") != value -> return Val(kit_expect_verdict("SKIP-HOST", requirement))
    } else if requirement.starts_with("os:") {
        if !kit_steps_host_matches(sys.family(), requirement.slice(3, requirement.len())) -> return Val(kit_expect_verdict("SKIP-HOST", requirement))
    } else if requirement.starts_with("os-name:") {
        if !kit_steps_host_matches(kit_steps_host_name(), requirement.slice(8, requirement.len())) -> return Val(kit_expect_verdict("SKIP-HOST", requirement))
    } else if requirement.starts_with("arch:") {
        if !kit_steps_host_matches(kit_steps_host_arch(), requirement.slice(5, requirement.len())) -> return Val(kit_expect_verdict("SKIP-HOST", requirement))
    } else if requirement.starts_with("probe ") {
        matched: kit_steps_probe(requirement.slice(6, requirement.len()), env, work, scratch)
        if !matched -> return Val(kit_expect_verdict("SKIP-HOST", requirement))
    } else if requirement.starts_with("tools-any ") || requirement.starts_with("probes-any ") {
        probes: requirement.starts_with("probes-any ")
        body: requirement.slice(if probes -> 11 else -> 10, requirement.len())
        matched: kit_steps_capability_any(body, probes, env, work, scratch)
        if !matched -> return Val(kit_expect_verdict("FAIL", requirement))
    } else if requirement.starts_with("tool:") {
        if kit_steps_tool(requirement.slice(5, requirement.len())) == None -> return Val(kit_expect_verdict("SKIP-HOST", requirement))
    } else {
        return Val(kit_expect_verdict("REFUSED", "unknown host requirement: {requirement}"))
    }
    None
}
