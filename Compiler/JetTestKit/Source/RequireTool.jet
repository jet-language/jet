// A #Test claim that drives a host tool skips where the tool is absent, as a
// case's `requires: tool:` row reports SKIP-HOST. Jetpack's bootstrap unit
// lists this file for its own claims (Jetpack/Bootstrap/tests.list).
use {
    process: core.process
    testing: core.testing
}

// A host tool looked up on PATH: its path, or why a claim that needs it skips.
KitTool: enum {
    Found(path: String)
    Missing(reason: String)
}

// Host tool `name` on PATH, without touching the running claim.
kit_find_tool: fn(name: String) -[FS, Env]> KitTool {
    found: process.which(name) ?? return KitTool.Missing{reason: "host tool `{name}` is not on PATH"}
    KitTool.Found{path: found}
}

// The tool's path on PATH, or None once the running claim reports skip
// (testing.skip) with kit_find_tool's reason, so the test ends there:
// `node: kit_require_tool("node") ?? return`.
kit_require_tool: fn(name: String) -[FS, Env]> String? {
    if kit_find_tool(name) == {
        .Found(path) -> Val(path)
        .Missing(reason) -> {
            testing.skip(reason)
            None
        }
    }
}
