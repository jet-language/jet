// A #Test claim that drives a host tool skips where the tool is absent, as a
// case's `requires: tool:` row reports SKIP-HOST. Jetpack's bootstrap unit
// lists this file for its own claims (Jetpack/Bootstrap/tests.list).
use {
    process: core.process
    testing: core.testing
}

// The tool's path on PATH, or None once the running claim reports skip
// (testing.skip), so the test ends there: `node: kit_require_tool("node") ?? return`.
kit_require_tool: fn(name: String) -[FS, Env]> String? {
    found: process.which(name)
    if found == None -> testing.skip("host tool `{name}` is not on PATH")
    found
}
