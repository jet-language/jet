kit_steps_failure_paths: fn(text: String) -> String? {
    first: kit_steps_transform_one(text, "normalize_journey_paths") ?? return None
    lines := [String]{}
    loop line in kit_steps_rust_lines(first) {
        start := -1
        cursor := 0
        loop cursor < line.count_bytes() {
            offset: kit_steps_byte_index(kit_steps_byte_slice(line, cursor, line.count_bytes()), "jet_") ?? break
            found: cursor + offset
            if found == 0 || line.bytes()[found - 1] == (U8{47}) {
                start = found
                break
            }
            cursor = found + 4
        }
        if start >= 0 {
            suffix: kit_steps_byte_slice(line, start, line.count_bytes())
            end: kit_steps_byte_index(suffix, ".jet")
            if end == {
                .Val(offset) -> {
                    lines.push("{kit_steps_byte_slice(line, 0, start)}<source>{kit_steps_byte_slice(line, start + offset + 4, line.count_bytes())}")
                    next
                }
                .None -> {}
            }
        }
        lines.push(line)
    }
    Val("{lines.join("\n")}{if text.ends_with("\n") -> "\n" else -> ""}")
}

// Lines as `kit_steps_rust_lines` splits them: the CR of a CRLF is stripped.
kit_steps_contract_arrow: fn(text: String) -> String {
    lines := [String]{}
    loop line in kit_steps_rust_lines(text) {
        index: kit_steps_byte_index(line, "  --> ")
        if index == {
            .Val(start) -> {
                location: kit_steps_byte_slice(line, start + 6, line.count_bytes())
                colon := -1
                loop (offset, byte) in location.bytes() {
                    if byte == (U8{58}) -> colon = offset
                }
                number: if colon < 0 -> "?" else -> kit_steps_byte_slice(location, colon + 1, location.count_bytes())
                lines.push("{kit_steps_byte_slice(line, 0, start)}  --> <source>:{number}")
            }
            .None -> lines.push(line)
        }
    }
    "{lines.join("\n")}{if text.ends_with("\n") -> "\n" else -> ""}"
}

kit_steps_mask: fn(text: String) -> Int? {
    if !text.starts_with("0o") -> return Val(Int.parse(text) ?? return None)
    if text.len() == 2 -> return None
    value := 0
    loop byte in kit_steps_byte_slice(text, 2, text.count_bytes()).bytes() {
        digit: Int{byte} - 48
        if digit < 0 || digit > 7 || value > (9223372036854775807 - digit) /% 8 -> return None
        value = value * 8 + digit
    }
    Val(value)
}
