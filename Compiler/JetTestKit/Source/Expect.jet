use files: core.files

kit_expect_verdict: fn(status: String, detail: String) -> KitVerdict {
    KitVerdict{status: status, detail: detail, diff: ""}
}

// A bounded whole-file unified hunk: exact comparison never trims stream bytes.
kit_expect_unified: fn(path: String, expected: String, actual: String) -> String {
    out := "--- expected/{path}\n+++ actual\n@@ -1,{expected.split("\n").len()} +1,{actual.split("\n").len()} @@\n"
    count := 0
    loop line in expected.split("\n") {
        if count >= 37 -> break
        out = "{out}-{line}\n"
        count += 1
    }
    loop line in actual.split("\n") {
        if count >= 37 -> break
        out = "{out}+{line}\n"
        count += 1
    }
    out
}

// The words a report heading opens with (`Error: Jet.UnknownName: what`):
// each `Severity` case, and the `Stop` that opens a runtime stop.
KIT_EXPECT_OPENERS: #run kit_expect_openers()

kit_expect_openers: fn() -> [String] {
    openers := [String]{}
    loop severity in Severity.reflect().values -> openers.push("{severity}: ")
    openers.push("Stop: ")
    openers
}

// The diagnostic name a report heading prints after its opener, or None for
// a line that is no heading (`Error: couldn't read the file`): the name runs
// to the next `: ` and holds only letters, digits, `.`, `_` and `-`.
kit_expect_heading_name: fn(line: String) -[]> String? Never! {
    loop opener in KIT_EXPECT_OPENERS {
        if !line.starts_with(opener) -> next
        rest: line.slice(opener.len(), line.len())
        end: rest.index(": ") ?? return None
        name: rest.slice(0, end)
        named: name.bytes().all(fn(byte) { (byte >= (U8{65}) && byte <= (U8{90})) || (byte >= (U8{97}) && byte <= (U8{122})) || (byte >= (U8{48}) && byte <= (U8{57})) || byte == (U8{46}) || byte == (U8{95}) || byte == (U8{45}) })
        if name == "" || !named -> return None
        return Val(name)
    }
    None
}

// The error, warning and stop reports `text` holds, one per heading.
kit_expect_diagnostics: fn(text: String) -[]> Int Never! {
    count := 0
    loop line in text.split("\n") {
        if !line.starts_with("{Severity.Lint}: ") && kit_expect_heading_name(line) != None {
            count += 1
        }
    }
    count
}

kit_expect_named: fn(ids: [String], id: String) -> Bool {
    loop item in ids {
        if item == id -> return true
    }
    false
}

kit_expect_bless_error: fn(bless: KitBless, sharded: Bool) -> String {
    if (bless.all || bless.ids.len() > 0) && sharded -> return "blessing is refused with --shard"
    if bless.all && bless.reason.trim() == "" -> return "--bless-all requires --reason"
    ""
}

kit_expect_exact_with_count: fn(id: String, path: String, expected: String?, actual: String, bless: KitBless, count: fn(String) -[]> Int Never!) -> KitVerdict {
    present := false
    old := ""
    if expected == {
        .Val(value) -> {
            old = value
            present = true
        }
        .None -> {}
    }
    if present && old == actual -> return kit_expect_verdict("PASS", "")
    if bless.first_tier && (bless.all || kit_expect_named(bless.ids, id)) {
        if count(actual) < count(old) && !kit_expect_named(bless.allow_shrink, id) {
            return kit_expect_verdict("REFUSED", "diagnostic shrink requires --allow-shrink {id}")
        }
        files.create_dir_all(files.dirname(path)) ?? return kit_expect_verdict("ERROR", "mkdir snapshot: {err}")
        files.write_atomic(path, actual.bytes()) ?? return kit_expect_verdict("ERROR", "write snapshot: {err}")
        return kit_expect_verdict("PASS", "blessed {path}")
    }
    if !present -> return kit_expect_verdict("FAIL", "missing expected stream: {path}")
    KitVerdict{status: "FAIL", detail: "snapshot mismatch: {path}", diff: kit_expect_unified(path, old, actual)}
}

kit_expect_no_count: fn(text: String) -[]> Int Never! { 0 }

kit_expect_exact: fn(id: String, path: String, expected: String?, actual: String, bless: KitBless, diagnostic: Bool) -> KitVerdict {
    if diagnostic {
        return kit_expect_exact_with_count(id, path, expected, actual, bless, fn(text: String) -[]> { kit_expect_diagnostics(text) })
    }
    kit_expect_exact_with_count(id, path, expected, actual, bless, fn(text: String) -[]> { kit_expect_no_count(text) })
}

kit_expect_exact_bytes: fn(id: String, path: String, expected: [U8]?, actual: [U8], bless: KitBless) -> KitVerdict {
    if expected == {
        .Val(bytes) -> {
            if bytes == actual -> return kit_expect_verdict("PASS", "")
        }
        .None -> {}
    }
    if bless.first_tier && (bless.all || kit_expect_named(bless.ids, id)) {
        files.create_dir_all(files.dirname(path)) ?? return kit_expect_verdict("ERROR", "mkdir snapshot: {err}")
        files.write_atomic(path, actual) ?? return kit_expect_verdict("ERROR", "write snapshot: {err}")
        return kit_expect_verdict("PASS", "blessed {path}")
    }
    old: expected ?? return kit_expect_verdict("FAIL", "missing expected stream: {path}")
    old_text: String.from_bytes(old) ?? return kit_expect_verdict("FAIL", "byte snapshot mismatch: {path}")
    new_text: String.from_bytes(actual) ?? return kit_expect_verdict("FAIL", "byte snapshot mismatch: {path}")
    KitVerdict{status: "FAIL", detail: "snapshot mismatch: {path}", diff: kit_expect_unified(path, old_text, new_text)}
}

kit_expect_paths: fn(actual: String, work: String, root: String, scratch: String) -> String {
    actual.replace(work, "{{work}}").replace(scratch, "{{scratch}}").replace(root, "{{root}}")
}

kit_expect_argv0: fn(actual: String, binary: String, source: String) -> String {
    usage: "Usage: {binary}"
    start: actual.index(usage) ?? return actual.copy()
    "{actual.slice(0, start)}Usage: {source}{actual.slice(start + usage.len(), actual.len())}"
}
