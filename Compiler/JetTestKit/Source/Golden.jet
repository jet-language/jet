use files: core.files


// The golden tiers, one per optimize level, the testkit's one table of tier
// names and their flags: o0 runs the entry (`jet run`), o1 builds it with
// `--optimize=basic` and o2 with `--release`.
kit_golden_tiers: fn() -> [KitTier] {
    [KitTier{name: "o0", level: "none", flags: [], direct: true, test_flags: ["--optimize=none"]},
     KitTier{name: "o1", level: "basic", flags: ["--optimize=basic"], direct: false, test_flags: ["--optimize=basic"]},
     KitTier{name: "o2", level: "full", flags: ["--release"], direct: false, test_flags: ["--release"]}]
}

// The tier named `name`; the first tier for any other name.
kit_golden_tier: fn(name: String) -> KitTier {
    tiers: kit_golden_tiers()
    loop row in tiers {
        if row.name == name -> return row.copy()
    }
    tiers[0].copy()
}

// The name of the tier that builds at optimize level `level`.
kit_golden_tier_of_level: fn(level: String) -> String? {
    loop row in kit_golden_tiers() {
        if row.level == level -> return Val(row.name.copy())
    }
    None
}

kit_golden_exists: fn(path: String) -> Bool { files.exists(path) }

// Every entry under `directory`, its streams beside its source: a flat
// `<Name>.jet` is the entry `<Name>`, as is a flat C or C++ file
// (`<Name>.c`, `.cc`, `.cpp`, `.cxx`) that `jet run` compiles by its
// extension, and a project folder (one holding `run.jet`) is the entry named
// by the folder. A folder with `package.jet` or `workspace.jet` but no
// `run.jet` is a library or workspace, not an entry.
kit_golden_collect: fn(root: String, directory: String) -> [KitEntry] {
    entries := [KitEntry]{}
    if !kit_golden_exists(files.join(root, directory)) -> return entries
    children: files.list_dir(files.join(root, directory)) ?? panic("discover {directory}: {err}")
    loop child in children {
        if child.name.starts_with(".") -> next
        shown: files.join(directory, child.name)
        if child.is_dir {
            if kit_golden_exists(files.join(child.path, "package.jet")) || kit_golden_exists(files.join(child.path, "workspace.jet")) || kit_golden_exists(files.join(child.path, "run.jet")) {
                if kit_golden_exists(files.join(child.path, "run.jet")) -> entries.push(KitEntry{path: files.join(shown, "run.jet"), expected: shown, project: shown, suite: "golden", mode: ""})
                next
            }
            nested: kit_golden_collect(root, shown)
            loop entry in nested -> entries.push(entry)
        } else if child.name != "package.jet" && child.name != "workspace.jet" && kit_golden_entry_stem(child.name) == .Val(stem) {
            entries.push(KitEntry{path: shown, expected: kit_steps_byte_slice(shown, 0, shown.count_bytes() - child.name.count_bytes() + stem.count_bytes()), project: directory, suite: "golden", mode: ""})
        }
    }
    entries
}

// The file `name` without the extension of its entry source (Jet, C or C++:
// KIT_SOURCE_LANGUAGES), or None for a file of any other extension.
kit_golden_entry_stem: fn(name: String) -> String? {
    loop row in KIT_SOURCE_LANGUAGES {
        extension: ".{row.extension}"
        if name.ends_with(extension) && name.count_bytes() > extension.count_bytes() -> return Val(kit_steps_byte_slice(name, 0, name.count_bytes() - extension.count_bytes()))
    }
    None
}

// Every entry of the golden corpora (checkout-relative directories).
kit_golden_discover: fn(root: String, corpora: [String]) -> [KitEntry] {
    all := [KitEntry]{}
    loop corpus in corpora {
        loop entry in kit_golden_collect(root, corpus) -> all.push(entry)
    }
    all.sort_by(entry -> entry.path)
    all
}

// The native comparator's exit oracle; unknown reports fail. A
// diagnostic report is a front-end rejection, exit 1 whether a build or the
// direct tier's `jet run` printed it.
kit_golden_failure_exit: fn(expected: String, report: String) -> Int? {
    if report.starts_with("Stop [") || report.starts_with("Error [E3003]:") -> return Val(70)
    if report.starts_with("Error [jet.") -> return Val(1)
    if report.starts_with("Runtime fault [R0801]:") || report.starts_with("Runtime fault [R0802]:") {
        loop raw in report.split("\n") {
            line: raw.trim().copy()
            if line.starts_with("exit:") && kit_steps_byte_slice(line, 5, line.count_bytes()).trim() != "70" -> return None
        }
        return Val(70)
    }
    if report == "" -> return if expected.ends_with("tests/run/CoreIO/LogFatal") -> Val(1) else -> None
    exit_one: ["Examples/ErrorsAndEffects/Errors/PropagationJourney", "Examples/ErrorsAndEffects/Errors/ErrorContext", "Examples/ErrorsAndEffects/Errors/DefaultErrorConversion", "Examples/ErrorsAndEffects/Errors/DefaultErrEdge", "Examples/ErrorsAndEffects/Errors/FatalExit", "Examples/Data/DecodeErrorExit", "Examples/Crypto/CryptoErrorRun", "tests/run/FailureFoundation/PropagationJourneyDirect", "tests/run/FailureFoundation/PropagationJourneyOneHop", "tests/run/FailureFoundation/PropagationJourneyCore", "tests/run/FailureFoundation/PropagationJourneyDecode", "tests/run/FailureFoundation/OrErrJourney"]
    loop stem in exit_one {
        if expected.ends_with(stem) -> return Val(1)
    }
    None
}

// A tier whose observable output legitimately differs spells its own
// `<stem>.<tier>.out`/`.err.out`/`.stderr.out` set (o2 is `--release`, so a
// program that reads the build profile prints the release value there); a
// tier with no such file compares against the stem's shared set.
kit_golden_tier_expected: fn(expected: String, tier: String) -> String {
    tiered: "{expected}.{tier}"
    if kit_golden_exists("{tiered}.out") || kit_golden_exists("{tiered}.err.out") || kit_golden_exists("{tiered}.stderr.out") -> return tiered
    expected.copy()
}

// `front_end` marks the streams of a build the front end rejected; a
// rejected program exits 1, so its `.err.out` needs no runtime exit oracle.
kit_golden_stream_verdict: fn(id: String, stem: String, tier: String, result: KitRun, bless: KitBless, argv0: String, source_name: String, front_end: Bool) -> KitVerdict {
    failure: kit_exec_process_failure(result)
    if failure == {
        .Val(value) -> return value
        .None -> {}
    }
    expected: kit_golden_tier_expected(stem, tier)
    error: kit_exec_optional("{expected}.err.out")
    if error == .Val(report) {
        code: if front_end -> 1 else -> kit_golden_failure_exit(stem, report) ?? return kit_expect_verdict("FAIL", "failure report has no exact exit oracle")
        if result.code != code -> return kit_expect_verdict("FAIL", "exit {result.code}; expected {code}")
        stdout: kit_exec_optional("{expected}.out") ?? ""
        output: kit_expect_exact(id, "{expected}.out", Val(stdout), result.stdout, bless, false)
        if output.status != "PASS" -> return output
        return kit_expect_exact(id, "{expected}.err.out", error, result.stderr, bless, false)
    }
    if result.code != 0 -> return kit_expect_verdict("FAIL", "exit {result.code}; expected 0")
    stdout := result.stdout
    if argv0 != "" -> stdout = kit_expect_argv0(stdout, argv0, source_name)
    verdict: kit_expect_exact(id, "{expected}.out", kit_exec_optional("{expected}.out"), stdout, bless, false)
    if verdict.status != "PASS" -> return verdict
    stderr: kit_exec_optional("{expected}.stderr.out")
    if stderr != None -> return kit_expect_exact(id, "{expected}.stderr.out", stderr, result.stderr, bless, false)
    verdict
}

kit_golden_source_name: fn(entry: KitEntry) -> String {
    file: files.basename(entry.path)
    kit_golden_entry_stem(file) ?? file
}

kit_golden_tier_independent: fn(plan: KitPlan) -> Bool {
    if plan.steps.len() == 0 -> return false
    loop step in plan.steps {
        if step.argv[0] == "build" || step.argv[0] == "built" -> return false
    }
    true
}

kit_golden_build: fn(entry: KitEntry, tier: KitTier, plan: KitPlan, env: KitEnv, source: String, work: String, scratch: String, step: KitStep) -> KitOutcome {
    path: if step.cwd == "" -> entry.path else -> files.join(source, entry.path)
    args := [String]{env.jet, if tier.direct -> "check" else -> "build", path}
    if !tier.direct {
        loop flag in tier.flags -> args.push(flag.copy())
    }
    case_env: kit_steps_environment(plan, env, work, scratch, "")
    overlay: kit_steps_step_environment(step, env, work, scratch, "", case_env)
    cwd: if step.cwd == "" -> source else -> files.join(work, kit_steps_expand(step.cwd, env, work, scratch, ""))
    policy: kit_steps_policy(step, env) ?? return KitOutcome{verdict: kit_expect_verdict("ERROR", "time limit outside Duration range"), run: kit_exec_failed("time limit outside Duration range")}
    if step.isolate == "no-nix" {
        args = kit_no_nix_argv(policy, args, scratch, step.isolate_network) ?? return KitOutcome{verdict: kit_expect_verdict("ERROR", "{err}"), run: kit_exec_failed("{err}")}
    }
    result: kit_exec_invoke_with_env(policy, args, cwd, scratch, [U8]{}, overlay)
    failure: kit_steps_failure(step, result)
    if failure == {
        .Val(value) -> return KitOutcome{verdict: value, run: result}
        .None -> {}
    }
    if result.stderr.contains("Warning [jet.BranchArmTable]") -> return KitOutcome{verdict: kit_expect_verdict("FAIL", "feature example emitted L0507"), run: result}
    if result.code != 0 {
        unsupported: result.stderr.contains("Error [jet.InvalidCommandInput]")
        verdict: kit_expect_verdict(if unsupported -> "UNSUPPORTED" else -> "FAIL", "front end/build exit {result.code}: {result.stderr}")
        return KitOutcome{verdict: verdict, run: result}
    }
    KitOutcome{verdict: kit_expect_verdict("PASS", ""), run: result}
}


kit_golden_default_step: fn(word: String) -> KitStep {
    KitStep{argv: [word], stdin: "", exit: "0", assertions: []}
}

// The harness exits 1 when its summary, the last line, counts a failed or an
// unexpected-pass test, and 0 otherwise; output with no summary has no exit.
kit_golden_test_exit: fn(stdout: String) -> Int? {
    lines: stdout.trim().split("\n").to_list()
    summary: lines[lines.len() - 1].copy()
    if !summary.contains(" passed, ") -> return None
    code := 0
    loop part in summary.split(", ") {
        words: part.split(" ").to_list()
        if words.len() != 2 -> return None
        count: Int.parse(words[0].copy()) ?? return None
        if count > 0 && (words[1] == "failed" || words[1] == "unexpected-pass") -> code = 1
    }
    Val(code)
}

// An entry's `<stem>.test.out` is its `jet test` stdout, checked on each tier
// once the run passes; `<stem>.<tier>.test.out` replaces it for that tier
// alone. The tier's `test_flags` choose the level, a package or workspace
// entry tests as its directory, and the command runs from the staged project
// under the sidecar's environment. None when the entry has no `.test.out`.
kit_golden_test_outcome: fn(context: KitStepCtx, entry: KitEntry, tier: KitTier, source: String, expected: String) -> KitOutcome? {
    tiered: "{expected}.{tier.name}.test.out"
    path: if kit_golden_exists(tiered) -> tiered else -> "{expected}.test.out"
    golden: kit_exec_optional(path) ?? return None
    code: kit_golden_test_exit(golden) ?? return Val(KitOutcome{verdict: kit_expect_verdict("FAIL", "{files.basename(path)} ends in no test summary, so its exit is unknown"), run: kit_exec_failed("no test summary")})
    project: files.basename(entry.path) == "run.jet" && (kit_golden_exists(files.join(context.work, "package.jet")) || kit_golden_exists(files.join(context.work, "workspace.jet")))
    args := [String]{context.env.jet, "test"}
    loop flag in tier.test_flags -> args.push(flag.copy())
    args.push(if project -> context.work else -> files.join(source, entry.path))
    result: kit_exec_invoke_with_env(context.env, args, context.work, context.scratch, [U8]{}, kit_steps_environment(context.plan, context.env, context.work, context.scratch, ""))
    failure: kit_exec_process_failure(result)
    if failure == {
        .Val(value) -> return Val(KitOutcome{verdict: value, run: result})
        .None -> {}
    }
    if result.code != code -> return Val(KitOutcome{verdict: kit_expect_verdict("FAIL", "jet test exit {result.code}; expected {code}: {result.stderr}"), run: result})
    Val(KitOutcome{verdict: kit_expect_exact(context.id, path, Val(golden), result.stdout, context.bless, false), run: result})
}

// Stages `entry`'s project from `project` into `work`. A flat entry shares its
// directory with the flat entries beside it (kit_golden_collect files every
// flat `.jet`, C or C++ file there as one), and its row reads none of theirs
// unless its source names one: those siblings' files (`<stem>.*`) stay out,
// unless the entry, or a sibling it names, names the stem. Every other file
// and every support directory is staged, so the row writes only what it may
// read.
kit_golden_stage: fn(project: String, entry: KitEntry, work: String) {
    own: files.basename(entry.path)
    if own == "run.jet" {
        kit_exec_copy_tree(project, work, true, false)
        return
    }
    files.create_dir_all(work) ?? panic("mkdir {work}: {err}")
    listed: files.list_dir(project) ?? panic("list {project}: {err}")
    // Each sibling entry's stem, and at the same index its source file.
    siblings := [String]{}
    sources := [String]{}
    loop child in listed {
        if child.is_dir || child.name == own || child.name == "package.jet" || child.name == "workspace.jet" -> next
        stem: kit_golden_entry_stem(child.name) ?? next
        siblings.push(stem)
        sources.push(child.name.copy())
    }
    own_stem: kit_golden_entry_stem(own) ?? own.copy()
    named := [String]{own_stem.copy()}
    at := 0
    loop at < named.len() {
        source := own.copy()
        loop index in 0..<siblings.len() {
            if siblings[index] == named[at] -> source = sources[index].copy()
        }
        text: files.read(files.join(project, source)) ?? ""
        at += 1
        loop stem in siblings {
            if !named.contains(stem) && text.contains(stem) -> named.push(stem.copy())
        }
    }
    loop child in listed {
        if !child.is_dir && !child.name.starts_with("{own_stem}.") && kit_golden_unnamed_sibling(child.name, siblings, named) -> next
        kit_exec_copy_entry(child, work, true, false)
    }
}

// Whether the file `name` belongs to a sibling entry (`<stem>.*`) that the
// staged entry never names.
kit_golden_unnamed_sibling: fn(name: String, siblings: [String], named: [String]) -> Bool {
    loop stem in siblings {
        if !named.contains(stem) && name.starts_with("{stem}.") -> return true
    }
    false
}

kit_golden_run_entry: fn(entry: KitEntry, tier: KitTier, env: KitEnv, scratch: String, bless: KitBless) -> KitOutcome {
    expected: files.join(env.root, entry.expected)
    plan := kit_steps_parse(kit_exec_optional("{expected}.case") ?? "")
    last := kit_exec_failed("case has not run")
    if plan.error != "" -> return KitOutcome{verdict: kit_expect_verdict("REFUSED", plan.error), run: last}
    if plan.fixture != "" -> return KitOutcome{verdict: kit_expect_verdict("REFUSED", "golden fixture is the staged project; fixture: is case-only"), run: last}
    // A row that binds a fixed port runs its program in a network namespace
    // of its own, where the port is always free; a host that can't give it
    // one skips the row.
    if plan.host_port != 0 {
        if kit_netns_required(env, scratch) == .Val(skipped) -> return KitOutcome{verdict: skipped, run: last}
    }
    source: files.join(scratch, "source")
    work: files.join(source, entry.project)
    kit_golden_stage(files.join(env.root, entry.project), entry, work)
    implicit: plan.steps.len() == 0
    if implicit {
        if plan.compile_only || !tier.direct -> plan.steps.push(kit_golden_default_step("build"))
        if !plan.compile_only -> plan.steps.push(kit_golden_default_step("built"))
    }
    last_explicit := false
    loop assertion in plan.steps[plan.steps.len() - 1].assertions {
        if assertion.stream == "stdout" || assertion.stream == "stderr" -> last_explicit = true
    }
    context := kit_steps_context(plan, entry.path, env, work, scratch, files.dirname(expected), bless)
    context.golden = Val(KitGoldenStepCtx{entry: entry, tier: tier, source: source, expected: expected, last_explicit: last_explicit, implicit: implicit})
    outcome: kit_steps_execute(context, kit_golden_step_hooks())
    if outcome.verdict.status != "PASS" -> return outcome
    kit_golden_test_outcome(context, entry, tier, source, expected) ?? outcome
}

kit_golden_step_invoke: fn(step: KitStep, index: Int, context: KitStepCtx, previous: KitStepState) -> KitStepResult {
    golden: context.golden ?? panic("golden step context required")
    plan: context.plan
    state := previous
    if index == 0 {
        if plan.compile_only {
            loop row in plan.steps {
                if row.argv[0] != "build" -> return KitStepResult{state: state, verdict: kit_expect_verdict("REFUSED", "run: none cannot have runtime steps")}
            }
        }
        can_create: context.bless.first_tier && (context.bless.all || kit_expect_named(context.bless.ids, context.id))
        if !plan.compile_only && !golden.last_explicit && !can_create && !kit_golden_exists("{golden.expected}.out") && !kit_golden_exists("{golden.expected}.err.out") -> return KitStepResult{state: state, verdict: kit_expect_verdict("FAIL", "missing expected stream: {golden.expected}")}
    }
    command: step.argv[0]
    // The direct tier's build is `jet check`, and its `jet run` runs the same
    // front end: a run the kit implied needs no build first, since the run
    // itself reports a rejection.
    if command == "built" && !state.built_once && golden.implicit && golden.tier.direct {
        state.built = context.env.jet
        state.built_once = true
    }
    if command == "build" || (command == "built" && !state.built_once) {
        if command == "build" && step.argv.len() != 1 -> return KitStepResult{state: state, verdict: kit_expect_verdict("REFUSED", "build step takes no arguments")}
        compiled: kit_golden_build(golden.entry, golden.tier, plan, context.env, golden.source, context.work, context.scratch, step)
        state.last = compiled.run
        if compiled.verdict.status != "PASS" {
            // A default case whose expected streams (the stem's or this
            // tier's) spell `.err.out` compares a rejected build like a failing
            // run, and that comparison settles the case.
            expected_failure: compiled.verdict.status == "FAIL" && compiled.run.code != 0 && !plan.compile_only && !golden.last_explicit && kit_golden_exists("{kit_golden_tier_expected(golden.expected, golden.tier.name)}.err.out")
            if !expected_failure -> return KitStepResult{state: state, verdict: compiled.verdict}
            streams := compiled.run
            streams.stderr = streams.stderr.replace("{golden.source}/", "")
            state.settled = true
            return KitStepResult{state: state, verdict: kit_golden_stream_verdict(context.id, golden.expected, golden.tier.name, streams, context.bless, "", kit_golden_source_name(golden.entry), true)}
        }
        state.built = if golden.tier.direct -> context.env.jet else -> kit_steps_artifact(golden.entry.path, golden.source, plan.artifact)
        if !files.exists(state.built) -> return KitStepResult{state: state, verdict: kit_expect_verdict("ERROR", "CLI build artifact missing: {state.built}")}
        state.built_once = true
        if command == "build" -> return KitStepResult{state: state, verdict: kit_expect_verdict("PASS", "")}
    }
    actual := step
    // The direct tier runs the staged entry by its full path from the case's
    // work directory, the same cwd the compiled tier's artifact runs in.
    if command == "built" && golden.tier.direct {
        argv := [String]{context.env.jet, "run", files.join(golden.source, golden.entry.path)}
        if step.argv.len() > 1 {
            argv.push("--")
            loop arg in step.argv.slice(1, step.argv.len()) -> argv.push(arg)
        }
        actual.argv = argv
    }
    if plan.host_port != 0 && actual.isolate == "" -> actual.isolate = "netns"
    if index == plan.steps.len() - 1 && actual.stdin == "" && kit_golden_exists("{golden.expected}.stdin") -> actual.stdin = "{golden.expected}.stdin"
    // `repo-cwd:` runs the program from the staged source root. The stage keeps
    // the repository layout, so a repo-relative path the program reads (its own
    // directory, say) resolves as it does from the checkout, and the checkout
    // itself is never written. File assertions stay relative to the project.
    if command == "built" && plan.repo_cwd != "" {
        from_root := context
        from_root.work = golden.source
        return kit_steps_invoke(actual, index, from_root, state)
    }
    kit_steps_invoke(actual, index, context, state)
}

kit_golden_step_check: fn(step: KitStep, index: Int, context: KitStepCtx, state: KitStepState) -> KitVerdict {
    golden: context.golden ?? panic("golden step context required")
    if state.last.stderr.contains("Warning [jet.BranchArmTable]") -> return kit_expect_verdict("FAIL", "feature example emitted L0507")
    checked := step
    if step.argv[0] != "build" && index == context.plan.steps.len() - 1 && !golden.last_explicit {
        normalized: kit_expect_named(context.plan.normalize, "argv0")
        name: if normalized && step.argv[0] == "built" -> files.basename(state.built) else -> ""
        streams := state.last
        if state.json_stdout == .Val(text) -> streams.stdout = text
        if state.json_stderr == .Val(text) -> streams.stderr = text
        // A release image's own fault report gives its build id and the
        // frames' addresses; `jet crash` names them
        // from the debug info the build saved, so the report compares with
        // the one `.err.out` every tier shares.
        if streams.stderr.contains(" (names and lines: jet crash)\n") {
            named: kit_exec_invoke(context.env, [context.env.jet, "crash"], context.work, context.scratch, streams.stderr)
            if named.code != 0 -> return kit_expect_verdict("FAIL", "jet crash exit {named.code}: {named.stderr}")
            streams.stderr = named.stdout
        }
        // The direct tier runs the staged entry by its absolute path; a report
        // that echoes the path compares repo-relative, as the snapshot spells it.
        streams.stderr = streams.stderr.replace("{golden.source}/", "")
        verdict: kit_golden_stream_verdict(context.id, golden.expected, golden.tier.name, streams, context.bless, name, kit_golden_source_name(golden.entry), false)
        if verdict.status != "PASS" -> return verdict
        // Default stream comparison owns its expected failure exit. Explicit
        // non-default exits and file assertions remain enforceable.
        checked.exit = "{state.last.code}"
        if step.exit != "0" -> checked.exit = step.exit
    }
    kit_steps_check(checked, context, state, kit_golden_source_name(golden.entry))
}

kit_golden_mark_tier_splits: fn(results: &[KitCaseResult]) {
    loop i in 0..<results.len() {
        loop j in 0..<i {
            if results[i].case != results[j].case -> next
            a_pass: results[i].status == "PASS" || results[i].status == "UNEXPECTED-PASS"
            b_pass: results[j].status == "PASS" || results[j].status == "UNEXPECTED-PASS"
            a_fail: results[i].status == "FAIL" || results[i].status == "KNOWN-FAILING"
            b_fail: results[j].status == "FAIL" || results[j].status == "KNOWN-FAILING"
            if (a_pass && b_fail) || (a_fail && b_pass) {
                results[i].detail = "tier-split: {results[i].detail}"
                results[j].detail = "tier-split: {results[j].detail}"
            }
        }
    }
}

kit_golden_discover_suite: fn(context: KitCtx) -> [KitEntry] { kit_golden_discover(context.root, context.options.golden_corpora) }

kit_golden_run_suite: fn(entry: KitEntry, context: KitCtx) -> [KitOutcome] {
    source: kit_exec_optional(files.join(context.root, "{entry.expected}.case")) ?? ""
    plan: kit_steps_parse(source)
    annotation: kit_cases_known_failure(entry, context.known, source)
    independent: kit_golden_tier_independent(plan)
    results := [KitOutcome]{}
    loop (index, tier_name) in context.options.tiers {
        if independent && index > 0 -> next
        tier: kit_golden_tier(tier_name)
        scratch: files.join(context.scratch, "{index}")
        files.create_dir_all(scratch) ?? {
            results.push(KitOutcome{verdict: kit_expect_verdict("ERROR", "tier scratch: {err}"), run: kit_exec_failed("{err}"), tier: tier_name})
            next
        }
        bless := context.bless
        bless.first_tier = index == 0
        outcome := kit_golden_run_entry(entry, tier, context.env, scratch, bless)
        outcome.tier = if independent -> "-" else -> tier_name
        // A tier's jetpack seals what it stores in the scratch Hangar (the C
        // toolchain pack a native C link fetches) read-only.
        kit_exec_remove_tree(scratch) ?? {
            outcome.verdict = kit_expect_verdict("ERROR", "remove tier scratch: {err}")
            false
        }
        results.push(kit_cases_known_verdict(outcome, annotation))
    }
    results
}
