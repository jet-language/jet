#!/usr/bin/env -S jet -A
// Deliberately controlled CLI peer for driver self-tests, not a real compiler.
// `build FILE` copies one of the program doubles beside this script to
// FILE's `.jet/build/STEM`, chosen by the JET_TESTKIT_* switches. `-A`
// acknowledges every effect, so its stderr holds only what the double writes.
use {
    files: core.files
    process: core.process
    sys: core.sys
    term: core.term
}

switch: fn(name: String) -[Env]> String Never! { process.env_get(name) ?? "" }

arg: fn(args: [String], index: Int) -> String Never! { if index < args.len() -> args[index].copy() else -> "" }

say: fn(text: String) -[IO]> {
    errors := term.stderr()
    errors.write(text).drop("fixture stderr")
}

fail: fn(text: String, code: Int) -[Exec, IO]> Never {
    say(text)
    process.exit(code)
}

// The runtime's process exit, status unchanged: `process.exit` gives any
// program's 101 the user-error status 1 (S36), and only jet ends with 101.
#Import(c) ice_exit: fn(code: I64) = "jet_rt_process_exit"

run: fn() {
    args: process.args()
    if switch("JET_TESTKIT_ICE") == "1" {
        #Unsafe("the CLI double stands in for jet, whose internal compiler error alone ends with status 101 (I2)") {
            ice_exit(I64{101})
        }
    }
    if switch("JET_TESTKIT_WARNING") == "1" -> say("Warning [jet.BranchArmTable]: unjoined task at function boundary\n")
    here: files.dirname(sys.executable())
    if arg(args, 0) == {
        "emit" -> print("main: fn() {{}}")
        "check" -> process.exit(0)
        "build" -> {
            if switch("JET_TESTKIT_REJECT") == "1" -> fail("Error [jet.StrayCharacter]: rejected\n", 1)
            source: arg(args, 1)
            // A bare file name's directory is the working one, as dirname(1) gives it.
            parent: files.dirname(source)
            directory: if parent == "" -> "." else -> parent
            artifact: "{directory}/.jet/build/{files.stem(source)}"
            files.create_dir_all("{directory}/.jet/build") ?? fail("build directory: {err}\n", 1)
            program: if {
                switch("JET_TESTKIT_INPUT") == "echo" -> "echo"
                switch("JET_TESTKIT_STDERR") == "1" -> "notice"
                switch("JET_TESTKIT_WHERE") == "1" -> "where"
                args.contains("--release") -> "wrong"
                else -> "program"
            }
            files.copy("{here}/{program}.jet", artifact) ?? fail("artifact copy: {err}\n", 1)
            files.chmod(artifact, 493) ?? fail("artifact mode: {err}\n", 1)
        }
        "run" -> print("hello")
        "test" -> {
            if switch("JET_TESTKIT_TEST_FAIL") == "1" {
                print("at {arg(args, 1)}: FAIL\n0 passed, 1 failed, 0 skipped")
                process.exit(1)
            }
            print("at {arg(args, 1)}: pass\n1 passed, 0 failed, 0 skipped")
        }
        else -> fail("unknown fixture command\n", 2)
    }
}
