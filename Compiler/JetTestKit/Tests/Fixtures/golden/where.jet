#!/usr/bin/env -S jet -A
// Names the directory the golden program runs from: the staged source root
// keeps the repository layout, so the entry is found by its repository path.
// `-A` acknowledges the file read, so its stderr stays empty.
use {
    files: core.files
}

run: fn() {
    if files.is_file("Examples/topic/hello.jet") -> print("source root") else -> print("project")
}
