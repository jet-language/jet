use {
    files: core.files
    process: core.process
    time: core.time
}

kit_test_unblessed: fn() -> KitBless {
    KitBless{ids: [], all: false, reason: "", allow_shrink: [], first_tier: true}
}

// The self-tests' checkout layout: the corpora and ledger a test root holds,
// as Compiler/package.jet's profiles name them relative to the checkout.
kit_test_ledger: fn(root: String) -> String { files.join(root, "known-failing.tsv") }

kit_test_checkout_options: fn(root: String) -> KitOptions {
    options := kit_exec_defaults()
    options.golden_corpora = ["Examples", "tests/run"]
    options.ui_corpora = ["tests/ui", "tests/ui_lint"]
    options.cases_corpora = ["tests/cases"]
    options.ledger = kit_test_ledger(root)
    options
}

#Test("report statuses have distinct exit codes") {
    passed: KitCaseResult{suite: "golden", case: "a", tier: "o0", status: "PASS", detail: "", exit: 0}
    failed: KitCaseResult{suite: "golden", case: "b", tier: "o0", status: "FAIL", detail: "", exit: 1}
    refused: KitCaseResult{suite: "golden", case: "c", tier: "o0", status: "REFUSED", detail: "missing public CLI", exit: -1}
    assert_eq(kit_report_exit_code([passed]), 0)
    assert_eq(kit_report_exit_code([passed, failed]), 1)
    assert_eq(kit_report_exit_code([failed, refused]), 2)
    known: KitCaseResult{suite: "cases", case: "d", tier: "-", status: "KNOWN-FAILING", detail: "#4865", exit: 7}
    unexpected: KitCaseResult{suite: "golden", case: "d", tier: "o1", status: "UNEXPECTED-PASS", detail: "#4865", exit: 0}
    assert_eq(kit_report_exit_code([known]), 0)
    assert_eq(kit_report_exit_code([known, unexpected]), 1)
    assert_eq(kit_report_exit_code([known, refused]), 2)
    counts: kit_report_counts([known, unexpected], ["golden", "cases"])
    assert(counts.contains("\"KNOWN-FAILING\":1"))
    assert(counts.contains("\"UNEXPECTED-PASS\":1"))
    results := [KitCaseResult]{known, unexpected}
    kit_golden_mark_tier_splits(results)
    assert(results[0].detail.starts_with("tier-split:"))
    assert(results[1].detail.starts_with("tier-split:"))
}

#Test("bless-all reason and shard guards refuse unsafe writes") {
    all: KitBless{ids: [], all: true, reason: "", allow_shrink: [], first_tier: true}
    named: KitBless{ids: ["a"], all: false, reason: "", allow_shrink: [], first_tier: true}
    assert(kit_expect_bless_error(all, false) != "")
    assert(kit_expect_bless_error(named, true) != "")
    assert_eq(kit_expect_bless_error(named, false), "")
}

#Test("exact stream comparison preserves terminal newline and bounded diff") {
    mismatch: kit_expect_exact("case", "snapshot", Val("a\n"), "a", kit_test_unblessed(), false)
    assert_eq(mismatch.status, "FAIL")
    assert(mismatch.diff.starts_with("--- expected/snapshot\n+++ actual\n"))
    assert(kit_expect_unified("snapshot", "x\n".repeat(100), "y\n".repeat(100)).split("\n").len() <= 41)
}

#Test("diagnostic shrink counts only renderer headers") {
    assert_eq(kit_expect_diagnostics("Error [jet.StrayCharacter]: x\n Why: Error [jet.UnterminatedText]\nWarning [L0001]: y\nStop [E3003]: z\n"), 3)
}

kit_test_core_scratch: fn(label: String) -> String {
    path: files.join(kit_scratch_root() ?? panic("no scratch: set JET_SCRATCH_ROOT or HOME"), "testkit-core-{process.current_pid()}-{label}")
    files.create_dir_all(path) ?? panic("core scratch")
    path
}

#Test("named blessing writes only its selected snapshot and shrink is explicit") {
    root: kit_test_core_scratch("bless")
    first: files.join(root, "first.out")
    second: files.join(root, "second.out")
    kit_exec_write(first, "old first\n")
    kit_exec_write(second, "old second\n")
    bless: KitBless{ids: ["first"], all: false, reason: "", allow_shrink: [], first_tier: true}
    assert_eq(kit_expect_exact("first", first, Val("old first\n"), "new first\n", bless, false).status, "PASS")
    assert_eq(kit_expect_exact("second", second, Val("old second\n"), "new second\n", bless, false).status, "FAIL")
    assert_eq(files.read(first) ?? panic("first"), "new first\n")
    assert_eq(files.read(second) ?? panic("second"), "old second\n")
    older: "Error [jet.StrayCharacter]: first\nError [jet.UnterminatedText]: second\n"
    newer: "Error [jet.StrayCharacter]: first\n"
    kit_exec_write(first, older)
    assert_eq(kit_expect_exact_with_count("first", first, Val(older), newer, bless, (text: String) -[]> kit_expect_diagnostics(text)).status, "REFUSED")
    assert_eq(files.read(first) ?? panic("first"), older)
    allowed: KitBless{ids: ["first"], all: false, reason: "", allow_shrink: ["first"], first_tier: true}
    assert_eq(kit_expect_exact_with_count("first", first, Val(older), newer, allowed, (text: String) -[]> kit_expect_diagnostics(text)).status, "PASS")
    assert_eq(files.read(first) ?? panic("first"), newer)
    files.remove_all(root) ?? panic("remove bless scratch")
}

#Test("shards are disjoint and complete in sorted corpus order") {
    ids: ["a", "b", "c", "d", "e"]
    all := [String]{}
    loop shard in 1..3 {
        options := kit_exec_defaults()
        options.shard_index = shard
        options.shard_count = 3
        selection: kit_exec_select_ids(ids, options)
        assert_eq(selection.error, "")
        loop id in selection.ids {
            assert(!kit_expect_named(all, id))
            all.push(id)
        }
    }
    all.sort()
    assert_eq(all, ids)
}

#Test("unknown and duplicate exact case lists are refused, unless other tests may own the names") {
    root: kit_test_core_scratch("selection")
    path: files.join(root, "cases.txt")
    options := kit_exec_defaults()
    options.cases = path
    kit_exec_write(path, "a\na\n")
    assert(kit_exec_select_ids(["a", "b"], options).error.contains("duplicate"))
    kit_exec_write(path, "not-known\n")
    assert(kit_exec_select_ids(["a", "b"], options).error.contains("unknown"))
    // Beside other tests, a case list may name them: an unknown id is theirs.
    options.others_selected = true
    kit_exec_write(path, "not-known\nb\n")
    assert_eq(kit_exec_select_ids(["a", "b"], options).ids, ["b"])
    kit_exec_write(path, "not-known\n")
    assert_eq(kit_exec_select_ids(["a", "b"], options).ids.len(), 0)
    files.remove_all(root) ?? panic("remove selection scratch")
}

#Test("a filter narrows code-suite runs as it narrows corpus entries, and one matching nothing selects 0") {
    ids: ["Core/Tasks/Tasks.jet [none]", "Core/Db/Engine/Tokenize.jet [none]", "Core/Crypto/Bignum.jet [full]"]
    tests: [["spawn joins"], ["keywords"], ["Tasks are not here"]]
    assert_eq(kit_exec_select_runs(ids, tests, ""), ids)
    assert_eq(kit_exec_select_runs(ids, tests, "Core/Tasks"), ["Core/Tasks/Tasks.jet [none]"])
    // A test name selects its run, as a `<run>: <test>` row id holds it.
    assert_eq(kit_exec_select_runs(ids, tests, "keywords"), ["Core/Db/Engine/Tokenize.jet [none]"])
    assert_eq(kit_exec_select_runs(ids, tests, "[full]: Tasks"), ["Core/Crypto/Bignum.jet [full]"])
    assert_eq(kit_exec_select_runs(ids, tests, "Core/Nothing").len(), 0)
    assert_eq(kit_exec_nothing_selected("Core/Nothing"), "the filter `Core/Nothing` matches no test: 0 selected")
}

#Test("process failures distinguish ICE timeout signal and spawn errors") {
    ice: KitRun{stdout: "", stderr: "", code: 101, signal: None, timed_out: false, error: ""}
    timeout: KitRun{stdout: "", stderr: "", code: -1, signal: Val(9), timed_out: true, error: ""}
    signal: KitRun{stdout: "", stderr: "", code: -1, signal: Val(15), timed_out: false, error: ""}
    spawn: kit_exec_failed("executable unavailable")
    assert_eq((kit_exec_process_failure(ice) ?? panic("ICE")).status, "ERROR")
    assert_eq((kit_exec_process_failure(timeout) ?? panic("timeout")).status, "TIMEOUT")
    assert_eq((kit_exec_process_failure(signal) ?? panic("signal")).status, "ERROR")
    assert_eq((kit_exec_process_failure(spawn) ?? panic("spawn")).status, "ERROR")
}

#Test("the resident guard reads VmRSS and names a memory kill") {
    assert_eq(kit_exec_resident_bytes("Name:\tjet\nVmSize:\t 8388608 kB\nVmRSS:\t   20480 kB\nThreads:\t33\n"), 20971520)
    assert_eq(kit_exec_resident_bytes("Name:\tjet\nState:\tZ (zombie)\n"), 0)
    killed: KitRun{stdout: "", stderr: "", code: -1, signal: Val(9), timed_out: false, error: "", limit_hit: "memory"}
    assert_eq((kit_exec_process_failure(killed) ?? panic("memory")).detail, "memory limit hit")
}

#Test("the resident guard kills a step above its VmRSS limit") {
    root: cases_test_root("resident-guard")
    env: KitEnv{root: root, scratch: root, jet: "/bin/sh", jetpack: "", timeout: 30s, memory_limit: 0, resident_limit: 67108864}
    run: kit_exec_invoke(env, ["/bin/sh", "-c", "x=$(head -c 268435456 /dev/zero | tr '\\0' a); sleep 20"], root, root, "")
    assert_eq(run.limit_hit, "memory")
    assert(run.elapsed_ns < 15000000000)
    small: kit_exec_invoke(env, ["/bin/sh", "-c", "printf ok"], root, root, "")
    assert_eq(small.stdout, "ok")
    assert_eq(small.limit_hit, "")
    files.remove_all(root) ?? panic("remove resident scratch")
}

#Test("the resident guard counts a row's files on a memory-backed scratch") {
    root: cases_test_root("scratch-guard")
    env: KitEnv{root: root, scratch: root, jet: "/bin/sh", jetpack: "", timeout: 30s, memory_limit: 0, resident_limit: 67108864, scratch_memory: true}
    run: kit_exec_invoke(env, ["/bin/sh", "-c", "head -c 134217728 /dev/zero > fill; sleep 20"], root, root, "")
    assert_eq(run.limit_hit, "memory")
    assert(run.elapsed_ns < 15000000000)
    files.remove_all(root) ?? panic("remove scratch guard scratch")
}

#Test("concurrent children each keep their resident guard and wall-clock timeout") {
    root: cases_test_root("pool-guard")
    env: KitEnv{root: root, scratch: root, jet: "/bin/sh", jetpack: "", timeout: 3s, memory_limit: 0, resident_limit: 67108864}
    grow: ["/bin/sh", "-c", "x=$(head -c 268435456 /dev/zero | tr '\\0' a); sleep 20"]
    stall: ["/bin/sh", "-c", "sleep 20"]
    started: time.instant()
    // As the pool runs entries: every child at once, each through kit_exec_invoke.
    first_grow: task kit_exec_invoke(env, grow, root, files.join(root, "a"), "")
    second_grow: task kit_exec_invoke(env, grow, root, files.join(root, "b"), "")
    first_stall: task kit_exec_invoke(env, stall, root, files.join(root, "c"), "")
    second_stall: task kit_exec_invoke(env, stall, root, files.join(root, "d"), "")
    third_stall: task kit_exec_invoke(env, stall, root, files.join(root, "e"), "")
    fourth_stall: task kit_exec_invoke(env, stall, root, files.join(root, "f"), "")
    loop run in [first_grow.join() ?? panic("grow"), second_grow.join() ?? panic("grow")] {
        assert_eq(run.limit_hit, "memory")
        assert_eq((kit_exec_process_failure(run) ?? panic("memory")).detail, "memory limit hit")
    }
    loop run in [first_stall.join() ?? panic("stall"), second_stall.join() ?? panic("stall"), third_stall.join() ?? panic("stall"), fourth_stall.join() ?? panic("stall")] {
        assert(run.timed_out)
        assert_eq((kit_exec_process_failure(run) ?? panic("timeout")).status, "TIMEOUT")
    }
    // Four 3 s timeouts one after another take 12 s; at once, about 3 s.
    assert(started.elapsed().ns < 9000000000)
    files.remove_all(root) ?? panic("remove pool scratch")
}

#Test("a step whose stray job holds its output or terminal ends at the wall-clock limit as TIMEOUT") {
    root: cases_test_root("lingering-holder")
    env: KitEnv{root: root, scratch: root, jet: "/bin/sh", jetpack: "", timeout: 2s, memory_limit: 0}
    // Job control gives the sleep a process group of its own: the child's
    // group sweep misses it and it keeps the captured stdout (or the terminal) open.
    stray: ["/bin/sh", "-c", "set -m; sleep 60 2>/dev/null & exit 0"]
    started: time.instant()
    piped: kit_exec_invoke(env, stray, root, files.join(root, "piped"), "")
    terminal: kit_exec_invoke_terminal(env, stray, root, files.join(root, "terminal"), [U8]{}, [KitEnvVar]{}, KitTerminal{rows: 24, cols: 80})
    kit_exec_stop_strays(root)
    loop run in [piped, terminal] {
        assert(run.timed_out)
        assert_eq((kit_exec_process_failure(run) ?? panic("timeout")).status, "TIMEOUT")
    }
    // Two 2 s limits; a holder the limit missed would keep these waits for 60 s.
    assert(started.elapsed().ns < 20000000000)
    files.remove_all(root) ?? panic("remove lingering-holder scratch")
}

kit_test_pool_entry: fn(env: KitEnv, root: String, index: Int) -> KitRun {
    kit_exec_invoke(env, ["/bin/sh", "-c", "sleep 0.2"], root, files.join(root, "{index}"), "")
}

// As kit_execute_report: the pool task joins the entry's own task.
kit_test_pool_report: fn(env: KitEnv, root: String, index: Int, done: Sender<Int>) {
    entry: task kit_test_pool_entry(env.copy(), root.copy(), index)
    run: entry.join() ?? kit_exec_failed("the entry task stopped")
    done.send(run.code)
}

// Every running entry holds two scheduler workers, its reporting task and its own, and
// waits on its children itself (kit_exec_wait). A watcher task per child once left every
// worker of a pool this wide waiting on a watcher that never got one.
#Test("a pool as wide as the scheduler's workers finishes its guarded children") {
    root: cases_test_root("pool-width")
    env: KitEnv{root: root, scratch: root, jet: "/bin/sh", jetpack: "", timeout: 30s, memory_limit: 0, resident_limit: 67108864}
    workers: kit_execute_workers()
    jobs: kit_execute_jobs(4 * workers, 4 * workers, workers)
    assert_eq(jobs, workers)
    { sender: done, receiver: finished }: channel<Int>()
    seen := 0
    task.group pool(limit: jobs) {
        loop index in 0..<jobs -> task kit_test_pool_report(env.copy(), root.copy(), index, done.copy())
        loop seen < jobs {
            code: finished.receive() ?? break
            assert_eq(code, 0)
            seen += 1
        }
    }
    assert_eq(seen, jobs)
    files.remove_all(root) ?? panic("remove pool scratch")
}

#Test("argv0 replaces only the first usage prefix") {
    assert_eq(kit_expect_argv0("Usage: binary\nUsage: binary\n", "binary", "source"), "Usage: source\nUsage: binary\n")
}

#Test("a step's secret-named variable values read <redacted> in its output text, longest first") {
    root: cases_test_root("redact")
    env: KitEnv{root: root, scratch: root, jet: "/bin/sh", jetpack: "", timeout: 30s, memory_limit: 0}
    overlay: [KitEnvVar]{
        KitEnvVar{name: "JET_KEYS_DIR", value: Val("{root}/keys")},
        KitEnvVar{name: "API_Token", value: Val("{root}/keys/jet")},
        KitEnvVar{name: "PLAIN", value: Val("{root}")},
    }
    run: kit_exec_invoke_with_env(env, ["/bin/sh", "-c", "printf '%s|%s|%s' \"$JET_KEYS_DIR/a\" \"$API_Token.pub\" \"$PLAIN\"; printf '%s' \"$JET_KEYS_DIR\" >&2"], root, root, [U8]{}, overlay)
    assert_eq(run.stdout, "<redacted>/a|<redacted>.pub|{root}")
    assert_eq(run.stderr, "<redacted>")
    assert_eq(run.stdout_bytes ?? panic("bytes"), "{root}/keys/a|{root}/keys/jet.pub|{root}".bytes())
}

#Test("fixture tree preserves executable modes through recursive state staging") {
    root: kit_test_core_scratch("fixture-modes")
    fixture: files.join(root, "fixture")
    work: files.join(root, "work")
    executable: files.join(fixture, "bin/tool")
    state_executable: files.join(fixture, "state/hooks/tool")
    data: files.join(fixture, "data.txt")
    kit_exec_write(executable, "#!/bin/sh\nprintf 'fixture executable\\n'\n")
    kit_exec_write(state_executable, "#!/bin/sh\nprintf 'fixture executable\\n'\n")
    kit_exec_write(data, "fixture data\n")
    files.chmod(executable, 493) ?? panic("chmod fixture executable: {err}")
    files.chmod(state_executable, 448) ?? panic("chmod state executable: {err}")
    files.chmod(data, 416) ?? panic("chmod fixture data: {err}")
    kit_exec_copy_tree(fixture, work, true, false)
    copied: files.join(work, "bin/tool")
    copied_state: files.join(work, ".jet/hooks/tool")
    assert_eq((files.stat(copied) ?? panic("stat copied executable: {err}")).mode % 512, 493)
    assert_eq((files.stat(copied_state) ?? panic("stat copied state executable: {err}")).mode % 512, 448)
    assert_eq((files.stat(files.join(work, "data.txt")) ?? panic("stat copied data: {err}")).mode % 512, 416)
    assert_eq(files.read(files.join(work, "data.txt")) ?? panic("read copied data: {err}"), "fixture data\n")
    env: kit_test_golden_env(root)
    loop path in [copied, copied_state] {
        result: kit_exec_invoke(env, [path], work, root, "")
        assert_eq(result.error, "")
        assert_eq(result.code, 0)
        assert_eq(result.stdout, "fixture executable\n")
        assert_eq(result.stderr, "")
    }
    files.remove_all(root) ?? panic("remove fixture modes scratch")
}

#Test("case fixtures copy their authored .jet directory and source trees skip it") {
    root: kit_test_core_scratch("fixture-dot-jet")
    fixture: files.join(root, "fixture")
    kit_exec_write(files.join(fixture, "project/.jet/lock"), "version = 1\n")
    kit_exec_write(files.join(fixture, "project/main.jet"), "run: fn() {{}}\n")
    kit_exec_write(files.join(fixture, ".git/HEAD"), "ref: refs/heads/main\n")
    case_work: files.join(root, "case")
    kit_exec_copy_tree(fixture, case_work, true, true)
    assert_eq(files.read(files.join(case_work, "project/.jet/lock")) ?? panic("read copied fixture lock: {err}"), "version = 1\n")
    assert(!files.exists(files.join(case_work, ".git")), "a fixture's .git never reaches the work directory")
    source_work: files.join(root, "source")
    kit_exec_copy_tree(fixture, source_work, true, false)
    assert(files.exists(files.join(source_work, "project/main.jet")))
    assert(!files.exists(files.join(source_work, "project/.jet")), "golden and UI source trees skip .jet compiler caches")
    files.remove_all(root) ?? panic("remove fixture .jet scratch")
}

#Test("a source tree keeps the checked-in parts of its .jet: binding caches and frozen plugin interfaces") {
    root: kit_test_core_scratch("source-checked-in-state")
    fixture: files.join(root, "fixture")
    kit_exec_write(files.join(fixture, "host/run.jet"), "run: fn() {{}}\n")
    kit_exec_write(files.join(fixture, "host/.jet/cache/api/plugin__guest.api"), "api_version = 3\n")
    kit_exec_write(files.join(fixture, "host/.jet/bindings/c/c.jet"), "// binding\n")
    kit_exec_write(files.join(fixture, "host/.jet/lock"), "version = 1\n")
    kit_exec_write(files.join(fixture, "host/.jet/cache/build/out"), "local\n")
    source_work: files.join(root, "source")
    kit_exec_copy_tree(fixture, source_work, true, false)
    assert_eq(files.read(files.join(source_work, "host/.jet/cache/api/plugin__guest.api")) ?? panic("read copied interface: {err}"), "api_version = 3\n")
    assert_eq(files.read(files.join(source_work, "host/.jet/bindings/c/c.jet")) ?? panic("read copied binding: {err}"), "// binding\n")
    assert(!files.exists(files.join(source_work, "host/.jet/lock")), "a source tree's local .jet state is not copied")
    assert(!files.exists(files.join(source_work, "host/.jet/cache/build")), "only cache/api of .jet/cache is checked in")
    files.remove_all(root) ?? panic("remove checked-in state scratch")
}

#Test("a flat golden entry stages its own files, every support directory and only the siblings it names") {
    root: kit_test_core_scratch("golden-stage")
    project: files.join(root, "group")
    kit_exec_write(files.join(project, "main.jet"), "use helper\nrun: fn() {{}}\n")
    kit_exec_write(files.join(project, "main.stdin"), "in\n")
    kit_exec_write(files.join(project, "helper.jet"), "use deep\n")
    kit_exec_write(files.join(project, "deep.jet"), "deep: 1\n")
    kit_exec_write(files.join(project, "other.jet"), "run: fn() {{}}\n")
    kit_exec_write(files.join(project, "other.stdin"), "in\n")
    kit_exec_write(files.join(project, "data.txt"), "data\n")
    kit_exec_write(files.join(project, "support/other.jet"), "inner: 2\n")
    kit_exec_write(files.join(project, ".jet/cache"), "stale\n")
    work: files.join(root, "work")
    kit_golden_stage(project, KitEntry{path: "group/main.jet", expected: "expected/main", project: "group", suite: "golden", mode: ""}, work)
    loop kept in ["main.jet", "main.stdin", "helper.jet", "deep.jet", "data.txt", "support/other.jet"] {
        assert(files.exists(files.join(work, kept)), "{kept} is staged")
    }
    loop left in ["other.jet", "other.stdin", ".jet"] {
        assert(!files.exists(files.join(work, left)), "{left} stays out")
    }
    kit_exec_write(files.join(project, "run.jet"), "run: fn() {{}}\n")
    whole: files.join(root, "whole")
    kit_golden_stage(project, KitEntry{path: "group/run.jet", expected: "expected/group", project: "group", suite: "golden", mode: ""}, whole)
    assert(files.exists(files.join(whole, "other.stdin")), "a project entry stages its whole directory")
    files.remove_all(root) ?? panic("remove golden stage scratch")
}

#Test("a run stages rows in memory and keeps its state on disk") {
    root: kit_test_core_scratch("memory-root")
    assert(kit_exec_memory_backed("/dev/shm") == files.is_dir("/dev/shm"))
    assert(!kit_exec_memory_backed("/proc/self"))
    kit_exec_write(files.join(root, "a.txt"), "12345")
    kit_exec_write(files.join(root, "deep/b.txt"), "123")
    assert_eq(kit_exec_tree_bytes(root), 8)
    assert_eq(kit_exec_tree_bytes(files.join(root, "gone")), 0)
    checkout: files.join(root, "checkout")
    files.create_dir_all(checkout) ?? panic("mkdir checkout: {err}")
    assert_eq(kit_execute_scratch_dir(files.join(checkout, "scratch"), checkout) ?? "", "")
    on_tmp: "/tmp/jet-testkit-state-{process.current_pid()}"
    assert_eq(kit_execute_disk_dir(on_tmp, checkout) ?? "", "")
    files.remove_all(on_tmp) ?? panic("remove tmp state probe: {err}")
    files.remove_all(root) ?? panic("remove memory root scratch")
}

#Test("the step timeout is a minute unless set, and an out-of-range duration is refused before discovery") {
    assert_eq(kit_exec_defaults().timeout, 60)
    options := kit_exec_defaults()
    options.timeout = 9223372036854775807
    assert_eq(kit_execute_suites(options, "", ["golden"], None).code, 2)
}

#Test("the pool takes every core and all the room") {
    assert_eq(kit_execute_jobs(3, 100, 16), 3)
    assert_eq(kit_execute_jobs(8, 2, 16), 2)
    // Half the workers by default: each running entry holds two.
    assert_eq(kit_execute_jobs(0, 100, 16), 8)
    assert_eq(kit_execute_jobs(0, 100, 1), 1)
    // An explicit count above the workers is lowered to them.
    assert_eq(kit_execute_jobs(40, 100, 16), 16)
    assert_eq(kit_execute_jobs(0, 0, 16), 1)
    gib: 1073741824
    // The host keeps a tenth of its memory, at least 1 GiB, beside the pool.
    assert_eq(kit_exec_host_room(40 * gib, 60 * gib), 34 * gib)
    assert_eq(kit_exec_host_room(6 * gib, 8 * gib), 5 * gib)
    assert_eq(kit_exec_host_room(gib /% 2, 8 * gib), 1)
    assert_eq(kit_exec_host_room(0, 8 * gib), 0)
}

#Test("a pool of claimed runs fits the CPUs, the memory budget and the runs") {
    gib: 1073741824
    claim: 5 * gib
    // A quarter of the CPUs, held between 4 and 8, with no memory gate.
    assert_eq(kit_claim_jobs(0, claim, 64, 4, 8, 100), 8)
    assert_eq(kit_claim_jobs(0, claim, 8, 4, 8, 100), 4)
    assert_eq(kit_claim_jobs(0, claim, 24, 4, 8, 100), 6)
    // The budget holds whole claims only.
    assert_eq(kit_claim_jobs(22 * gib, claim, 64, 4, 8, 100), 4)
    assert_eq(kit_claim_jobs(10 * gib, claim, 64, 4, 8, 100), 2)
    // A budget below one claim still runs one at a time.
    assert_eq(kit_claim_jobs(3 * gib, claim, 64, 4, 8, 100), 1)
    // Never more than the runs there are, and never fewer than one.
    assert_eq(kit_claim_jobs(0, claim, 64, 4, 8, 2), 2)
    assert_eq(kit_claim_jobs(22 * gib, claim, 64, 4, 8, 3), 3)
    assert_eq(kit_claim_jobs(0, claim, 64, 4, 8, 0), 1)
}

#Test("the pool runs measured entries longest first and weighs each by its last peak") {
    slot: kit_job_memory()
    gib: 1073741824
    assert_eq(kit_execute_budget(0, 16 * gib), 16 * gib)
    assert_eq(kit_execute_budget(3 * gib, 16 * gib), 3 * gib)
    assert_eq(kit_execute_budget(0, 0), 0)
    entries: ["a", "b", "c", "d"].map(name -> KitSelected{entry: KitEntry{path: name, expected: name, project: "", suite: "cases", mode: ""}, suite: "cases"})
    history := [String: KitHistory]{}
    history[kit_history_key("cases", "b")] = KitHistory{wall_ms: 100, peak_kib: 10240}
    history[kit_history_key("cases", "c")] = KitHistory{wall_ms: 9000, peak_kib: 8 * 1048576}
    history[kit_history_key("cases", "d")] = KitHistory{wall_ms: 9000, peak_kib: 512 * 1024}
    schedule: kit_execute_schedule(entries, history, 4, 2 * gib, 16 * gib)
    // Unmeasured first, then longest first; a tie keeps corpus order.
    assert_eq(schedule.order, [0, 2, 3, 1])
    // Unmeasured claims the default; a small peak claims the floor; a heavy one the whole budget.
    assert_eq(schedule.weights, [slot, 64 * 1048576, 2 * gib, 768 * 1048576])
    // The guard is the run-wide guard, raised to a heavy entry's own need; the
    // jobs sharing the room never lower it.
    assert_eq(schedule.guards, [8 * gib, 8 * gib, 12 * gib, 8 * gib])
    // It never exceeds the whole room.
    assert_eq(kit_execute_schedule(entries, history, 4, 2 * gib, 4 * gib).guards, [4 * gib, 4 * gib, 4 * gib, 4 * gib])
    unknown: kit_execute_schedule(entries, history, 4, 0, 0)
    assert_eq(unknown.guards, [8 * gib, 8 * gib, 12 * gib, 8 * gib])
    root: cases_test_root("history")
    kit_history_save(root, ["cases"], history, [KitCaseResult{suite: "cases", case: "a", tier: "-", status: "PASS", detail: "", exit: 0, wall_ms: 7, peak_kib: 3}])
    loaded: kit_history_load(root, ["cases", "ui"])
    assert_eq((loaded.get(kit_history_key("cases", "a")) ?? KitHistory{wall_ms: 0, peak_kib: 0}).wall_ms, 7)
    assert_eq((loaded.get(kit_history_key("cases", "c")) ?? KitHistory{wall_ms: 0, peak_kib: 0}).peak_kib, 8 * 1048576)
    assert_eq(loaded.get(kit_history_key("ui", "a")) == None, true)
    files.remove_all(root) ?? panic("remove history scratch")
}

#Test("the pool admits an entry only while fewer than jobs run and its claim fits the budget") {
    gib: 1073741824
    schedule: KitSchedule{order: [0, 1, 2], weights: [gib, gib, gib], guards: [gib, gib, gib], budget: 2 * gib, jobs: 3}
    // The first entry always starts, even one that claims more than the whole budget.
    assert(kit_execute_admits(schedule, 0, 0, 4 * gib))
    assert(kit_execute_admits(schedule, 1, gib, gib))
    assert(!kit_execute_admits(schedule, 2, 2 * gib, gib), "a claim past the budget waits")
    narrow: KitSchedule{order: [0, 1, 2], weights: [gib, gib, gib], guards: [gib, gib, gib], budget: 0, jobs: 2}
    assert(kit_execute_admits(narrow, 1, 64 * gib, gib), "an unknown budget gates nothing")
    assert(!kit_execute_admits(narrow, 2, 0, gib), "the pool never runs more than jobs")
}

kit_test_selected: fn(suite: String, path: String) -> KitSelected {
    KitSelected{entry: KitEntry{path: path, expected: path, project: "", suite: suite, mode: ""}, suite: suite}
}

#Test("pool rows keep corpus order, suite then path, whatever the pool's size") {
    mixed := [kit_test_selected("ui", "b"), kit_test_selected("cases", "z"), kit_test_selected("golden", "a"), kit_test_selected("cases", "a")]
    kit_execute_corpus_order(mixed)
    assert_eq(mixed.map(item -> "{item.suite} {item.entry.path}"), ["cases a", "cases z", "golden a", "ui b"])
    root: cases_test_root("pool-order")
    names: ["a", "b", "c", "d", "e"]
    // Earlier entries sleep longer, so a wider pool finishes them out of order.
    loop (index, name) in names -> cases_test_source(root, name, "step: jet -c 'sleep 0.{names.len() - 1 - index}'\nstdout: empty\nstderr: empty\n")
    corpus: names.map(name -> KitSelected{entry: cases_test_entry(name), suite: "cases"})
    context: cases_test_context(root, files.join(root, "scratch"))
    loop jobs in [1, 2, 5] {
        run_scratch: files.join(root, "run-{jobs}")
        files.create_dir_all(run_scratch) ?? panic("pool run scratch: {err}")
        schedule: kit_execute_schedule(corpus, [String: KitHistory]{}, jobs, 0, 0)
        rows := [String]{}
        loop run in kit_execute_entries(corpus, schedule, context.options, context.env, context.known, root, run_scratch) {
            loop result in run.results -> rows.push("{result.case} {result.status}")
        }
        assert_eq(rows, corpus.map(item -> "{item.entry.path} PASS"))
    }
    files.remove_all(root) ?? panic("remove pool order scratch")
}

#Test("a run naming a suite that isn't installed is refused") {
    assert_eq(kit_execute_suites(kit_exec_defaults(), "", ["golden", "nope"], None).code, 2)
    assert_eq(kit_execute_suites(kit_exec_defaults(), "", [], None).code, 2)
}

#Test("each suite finishes its own report and rows, and a filtered run writes only its own") {
    root: cases_test_root("suite-reports")
    ui_report: files.join(root, "ui.json")
    cases_report: files.join(root, "cases.json")
    passed: KitCaseResult{suite: "cases", case: "tests/cases/a.case", tier: "-", status: "PASS", detail: "", exit: 0}
    failed: KitCaseResult{suite: "ui", case: "tests/ui/b.jet", tier: "-", status: "FAIL", detail: "snapshot", exit: 1}
    reports := [String: String]{}
    reports["ui"] = ui_report
    only_ui: kit_execute_finish("jet", [failed], ["ui"], ["ui"], Val(reports), "")
    assert_eq(only_ui.code, 1)
    assert(files.exists(ui_report))
    assert(!files.exists(cases_report), "a filtered run writes no other suite's report")
    reports["cases"] = cases_report
    both: kit_execute_finish("jet", [passed, failed], ["cases", "ui"], ["cases", "ui"], Val(reports), "")
    assert_eq(both.code, 1)
    ui_text: files.read(ui_report) ?? panic("read ui report: {err}")
    cases_text: files.read(cases_report) ?? panic("read cases report: {err}")
    assert(ui_text.contains("tests/ui/b.jet") && !ui_text.contains("tests/cases/a.case"))
    assert(cases_text.contains("tests/cases/a.case") && !cases_text.contains("tests/ui/b.jet"))
    files.remove_all(root) ?? panic("remove suite report scratch")
}

#Test("the pool's memory is the room under the cgroup caps, not the whole host") {
    assert_eq(kit_exec_cgroup_path("0::/user.slice/jetslot-A-1.scope\n"), "/user.slice/jetslot-A-1.scope")
    assert_eq(kit_exec_cgroup_path("1:name=x:/y\n"), "")
    assert_eq(kit_exec_cgroup_value("max\n"), 0)
    assert_eq(kit_exec_cgroup_value("17179869184\n"), 17179869184)
    assert_eq(kit_exec_room(40, 0, 5), 40)
    assert_eq(kit_exec_room(40, 16, 4), 12)
    assert_eq(kit_exec_room(10, 16, 4), 10)
    assert_eq(kit_exec_room(0, 16, 4), 12)
    assert_eq(kit_exec_room(40, 16, 20), 1)
}
