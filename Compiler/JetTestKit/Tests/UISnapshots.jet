use {
    files: core.files
    sys: core.sys
    process: core.process
}

kit_ui_test_scratch: fn(label: String) -> String {
    root: files.join(kit_scratch_root() ?? panic("no scratch: set JET_SCRATCH_ROOT or HOME"), "testkit-ui-{process.current_pid()}-{label}")
    files.create_dir_all(root) ?? panic("UI self-test scratch: {err}")
    root
}

kit_ui_test_context: fn(root: String, label: String) -> KitCtx {
    ^options: kit_test_checkout_options(root)
    options.tiers = ["o0", "o1"]
    limits: kit_test_run_limits()
    env: KitEnv{root: root, scratch: root, jet: files.join(sys.current_dir(), "Compiler/JetTestKit/Tests/Fixtures/UI/compiler.jet"), jetpack: "", timeout: limits.wall, cpu_limit: Val(limits.cpu), memory_limit: 0}
    KitCtx{env: env, root: root, scratch: files.join(root, label), bless: options.bless, known: kit_known_load(options.ledger), options: options}
}

kit_ui_test_run: fn(code: Int, stderr: String) -> KitRun {
    KitRun{stdout: "", stderr: stderr, code: code, signal: None, timed_out: false, error: ""}
}

#Test("UI plain success ignores lints; failures retain renderer and exact normalized paths") {
    call: kit_ui_invocation("run: fn() {{}}", "Tests/UI/example.jet", false)
    assert_eq(call.argv, ["check", "Tests/UI/example.jet"])
    assert_eq(kit_ui_actual(call, kit_ui_test_run(0, "Warning: Jet.SameEnumGuardTable: advisory\n")), "(no errors)\n")
    report: "Error: Jet.OperatorTypeMismatch: mismatch\n\n1 problem found\nRun `jet explain Jet.OperatorTypeMismatch` to learn more\n"
    assert_eq(kit_ui_actual(call, kit_ui_test_run(1, report)), "Error: Jet.OperatorTypeMismatch: mismatch\n")
    assert_eq(kit_ui_rendered_only("Error: Jet.OperatorTypeMismatch: mismatch\n\n1 problem found\nnot a hint\n"), "Error: Jet.OperatorTypeMismatch: mismatch\n\n1 problem found\nnot a hint\n")
    crlf: "\r\n"
    assert_eq(kit_ui_normalize("Tests/UI/project/workspace.jet", "/staged/Tests/UI/project/member.jet{crlf}Blocking waiting for file lock on package cache\n", "/staged"), "/tmp/member.jet\n")
    lint: kit_ui_invocation("", "Tests/UILint/one.jet", true)
    assert_eq(lint.argv, ["check", "--verbose", "Tests/UILint/one.jet"])
    assert_eq(kit_ui_actual(lint, kit_ui_test_run(0, "Warning: Jet.SameEnumGuardTable: lint\n\nOK: `one.jet` has no errors (1 warning)\nRun `jet explain Jet.SameEnumGuardTable` to learn more\n")), "Warning: Jet.SameEnumGuardTable: lint\n")
    all: kit_ui_invocation("// @all_diags\nrun: fn() {{}}", "Tests/UI/example.jet", false)
    assert_eq(kit_ui_actual(all, kit_ui_test_run(0, "Warning: Jet.DivergentStatePaths: split\n\nOK: `example.jet` has no errors (1 warning)\nRun `jet explain Jet.DivergentStatePaths` to learn more\n")), "Warning: Jet.DivergentStatePaths: split\n")
    assert_eq(kit_ui_actual(all, kit_ui_test_run(0, "")), "(no errors)\n")
}

#Test("UI comparison normalizes only primary location paths and retains every other mismatch") {
    root: kit_ui_test_scratch("primary-source")
    entry: KitEntry{path: "Tests/UI/example.jet", expected: "Tests/UI/example.stderr", project: "Tests/UI", suite: "ui", mode: "plain"}
    call: kit_ui_invocation("", entry.path, false)
    ctx: kit_ui_test_context(root, "case")
    short: "Error: Jet.OperatorTypeMismatch: mismatch\n  --> example.jet:2:4\n Why: example.jet must stay in the message\n  --> imported.jet:8:3\n"
    canonical: "Error: Jet.OperatorTypeMismatch: mismatch\n  --> Tests/UI/example.jet:2:4\n Why: example.jet must stay in the message\n  --> imported.jet:8:3\n"
    assert_eq(kit_ui_primary_source_headers(entry.path, short), canonical)
    kit_exec_write(files.join(root, entry.expected), canonical)
    assert_eq(kit_ui_snapshot(entry, call, kit_ui_test_run(1, short), short, ctx).status, "PASS")
    kit_exec_write(files.join(root, entry.expected), short)
    assert_eq(kit_ui_snapshot(entry, call, kit_ui_test_run(1, canonical), canonical, ctx).status, "PASS")
    loop changed in
        [short.replace("Jet.OperatorTypeMismatch", "Jet.ArgumentTypeMismatch"), short.replace("mismatch", "different"), short.replace(":2:4", ":2:5"), short.replace("Why: example.jet", "Why: Tests/UI/example.jet"), short.replace("imported.jet", "elsewhere.jet")] {
        assert_eq(kit_ui_snapshot(entry, call, kit_ui_test_run(1, changed), changed, ctx).status, "FAIL")
    }
    files.remove_all(root) ?? panic("remove primary-source scratch: {err}")
}

#Test("UI directive table preserves argv cwd streams and refuses internal or unknown facts") {
    loop row in kit_ui_directives() {
        argument: if row.name == "complexity_cli" -> "branches 8" else if row.name == "compiler_extension" -> "Tools/hook.wasm" else if row.name == "org_policy" -> "organization.policy" else if row.name == "signal_child" -> "KILL" else -> ""
        call: kit_ui_invocation("// @{row.name} {argument}\nprint(1)\n", "Tests/UI/a.jet", false)
        if row.capability != "" {
            assert_eq(call.refused, row.capability)
            next
        }
        // A build entry marker alone names no invocation to run it with.
        if row.name == "programmable_build" {
            assert_eq(call.refused, "missing CLI fixture API: programmable_build")
            next
        }
        assert_eq(call.refused, "")
        if row.argv.len() > 0 {
            assert_eq(call.parent, row.parent)
            assert_eq(call.streams, row.streams)
            assert_eq(call.exit, row.exit)
            assert_eq(call.argv[0], row.argv[0])
        }
        if row.name == "check_cli" -> assert_eq(call.argv[1], "a.jet")
        if row.name == "complexity_cli" -> assert_eq(call.argv[3], "--max=8")
        if row.name == "repl_deny" -> assert_eq(call.stdin, "print(1)\n:quit")
        if row.name == "compiler_extension" -> assert_eq(call.extension, "Tools/hook.wasm")
        // The policy file sets the environment only: the entry is still checked.
        if row.name == "org_policy" {
            assert_eq(call.org_policy, "organization.policy")
            assert_eq(call.argv, ["check", "Tests/UI/a.jet"])
        }
    }
    assert(kit_ui_invocation("// @unknown_fact\n", "a.jet", false).refused.contains("unknown_fact"))
    assert(kit_ui_invocation("// @complexity_cli branches\n", "a.jet", false).refused != "")
    granted: kit_ui_invocation("// @programmable_build\n// @build_grants Exec\n", "Tests/UI/b.jet", false)
    assert_eq(granted.refused, "")
    assert_eq(granted.argv, ["build", "Tests/UI/b.jet", "--allow=Exec"])
    assert_eq(granted.streams, "stderr")
    assert_eq(kit_ui_invocation("// @programmable_build\n// @build_locked\n", "Tests/UI/b/run.jet", false).argv, ["build", "Tests/UI/b/run.jet", "--locked"])
    fetched: kit_ui_invocation("// @fetched_build_locked\n", "Tests/UI/f/run.jet", false)
    assert(fetched.fetch_first)
    assert_eq(fetched.argv, ["build", "Tests/UI/f/run.jet", "--locked"])
    assert(!kit_ui_invocation("// @programmable_build\n// @build_locked\n", "Tests/UI/b/run.jet", false).fetch_first)
    assert_eq(kit_ui_invocation("// @target wasm32-wasip2\n", "Tests/UI/c.jet", false).argv, ["build", "Tests/UI/c.jet", "--target=wasm32-wasip2"])
    assert_eq(kit_ui_invocation("// @run_deny FS\n", "Tests/UI/e.jet", false).argv, ["run", "--deny=FS", "Tests/UI/e.jet"])
    assert_eq(kit_ui_invocation("// @run_json\n", "Tests/UI/e.jet", false).argv, ["run", "--json", "Tests/UI/e.jet"])
    assert_eq(kit_ui_invocation("// @deep_checks tree.run\n", "Tests/UI/e.jet", false).argv, ["run", "--deep-checks=tree.run", "Tests/UI/e.jet"])
    assert_eq(kit_ui_invocation("// @build_option --bounds=off\n", "Tests/UI/e.jet", false).argv, ["build", "Tests/UI/e.jet", "--bounds=off"])
    // The hangar row runs jetpack, with the tampered object's digest appended.
    hangar: kit_ui_invocation("// @jetpack_hangar_digest_mismatch\n", "Tests/UI/d.jet", false)
    assert(hangar.hangar_tamper)
    assert_eq(hangar.argv, ["hangar", "verify", "--no-color"])
    assert_eq(kit_ui_arg("// @check_cli\n// @check_cli ignored\n", "check_cli"), Val("ignored"))
}

#Test("UI signal_child signals the invocation's running child and snapshots jet's exit status") {
    // The signal rides on the row's invocation, `jet check` when none other.
    killed: kit_ui_invocation("// @signal_child KILL\n", "Tests/UI/s.jet", false)
    assert_eq(killed.refused, "")
    assert_eq(killed.signal_child, 9)
    assert_eq(killed.argv, ["check", "Tests/UI/s.jet"])
    assert_eq(kit_ui_invocation("// @run_cli\n// @signal_child SIGTERM\n", "Tests/UI/s.jet", false).argv, ["run", "Tests/UI/s.jet"])
    assert_eq(kit_ui_invocation("// @run_cli\n// @signal_child SIGTERM\n", "Tests/UI/s.jet", false).signal_child, 15)
    assert_eq(kit_ui_invocation("// @signal_child 0\n", "Tests/UI/s.jet", false).refused, "@signal_child names no signal: `0`")
    assert_eq(kit_ui_invocation("// @signal_child BOOM\n", "Tests/UI/s.jet", false).refused, "@signal_child names no signal: `BOOM`")
    assert_eq(kit_ui_invocation("run: fn() {{}}", "Tests/UI/s.jet", false).signal_child, 0)
    report: "Error: Jet.ComptimeEndedBySignal: ended\n\n1 problem found\nRun `jet explain Jet.ComptimeEndedBySignal` to learn more\n"
    assert_eq(kit_ui_actual(killed, kit_ui_test_run(137, report)), "Error: Jet.ComptimeEndedBySignal: ended\nExit status: 137\n")
    // A child runs once it is on a CPU and past its start; the name in
    // parentheses may hold spaces and parentheses.
    assert(kit_exec_stat_running("4242 (jet comptime) R 4241 4241 1 0 -1 4194560 100 0 0 0 7 3 0 0 20 0 1 0 5 1000 10\n"))
    assert(kit_exec_stat_running("4242 (a) (b) R 4241 4241 1 0 -1 4194560 100 0 0 0 12 0 0 0 20 0 1 0 5 1000 10\n"))
    assert(!kit_exec_stat_running("4242 (jet-comptime) S 4241 4241 1 0 -1 4194560 100 0 0 0 70 30 0 0 20 0 1 0 5 1000 10\n"))
    assert(!kit_exec_stat_running("4242 (jet-comptime) R 4241 4241 1 0 -1 4194560 100 0 0 0 1 2 0 0 20 0 1 0 5 1000 10\n"))
    assert(!kit_exec_stat_running("4242 (jet-comptime) R 4241\n"))
    assert(!kit_exec_stat_running(""))
}

#Test("a run's signal_child reaches the running child, and a run whose child never appears fails") {
    if sys.name() != "linux" {
        return
    }
    root: kit_ui_test_scratch("signal-child")
    env: KitEnv{root: root, scratch: root, jet: "/bin/sh", jetpack: "", timeout: 30s, memory_limit: 0}
    // The child spins until the signal; the parent outlives it and reports
    // the status the signal left it.
    spinning: kit_exec_run(env, ["/bin/sh", "-c", "sh -c 'while :; do :; done'; echo \"child: $?\" >&2"], root, root, [U8]{}, [KitEnvVar]{}, None, 9)
    assert_eq(spinning.error, "")
    assert_eq(spinning.stderr, "child: 137\n")
    assert_eq(spinning.code, 0)
    // A run that ends with no child is a failed run, never a snapshot.
    childless: kit_exec_run(env, ["/bin/sh", "-c", "exit 3"], root, root, [U8]{}, [KitEnvVar]{}, None, 9)
    assert(childless.error.contains("@signal_child"), childless.error)
    files.remove_all(root) ?? panic("remove signal_child scratch: {err}")
}

// A fixture's `// @name` lines are spelled as its rows are, so renaming a
// fixture's folder never leaves its directive behind.
#Test("UI fixtures name only directives the table has") {
    root: sys.current_dir()
    ^unported: [String]{}
    loop directory in ["Tests/UI", "Tests/UILint"] {
        loop entry in kit_ui_collect(root, directory, directory == "Tests/UILint") {
            source: files.read(files.join(root, entry.path)) ?? panic("read UI fixture {entry.path}: {err}")
            refused: kit_ui_invocation(source, entry.path, entry.mode.starts_with("lint")).refused
            if refused.starts_with("unported fixture directive") {
                unported.push("{entry.path}: {refused}")
            }
        }
    }
    assert(unported.len() == 0, unported.join("\n"))
}

#Test("UI check_core checks the staged Core with the project's files and the entry's text on top") {
    call: kit_ui_invocation("// @check_core Collections/Set.jet\nuse probe: core.files\n", "Tests/UI/layers/main.jet", false)
    assert(call.check_core)
    assert_eq(call.core_top, "Collections/Set.jet")
    assert_eq(call.argv, ["check", "Core"])
    assert_eq(call.exit, "nonzero")
    assert_eq(kit_ui_invocation("// @check_core\n", "Tests/UI/layers/main.jet", false).core_top, "")
    assert(!kit_ui_invocation("run: fn() {{}}\n", "Tests/UI/a.jet", false).check_core)
    root: kit_ui_test_scratch("check-core")
    kit_exec_write(files.join(root, "Core/package.jet"), "name: \"core\"\n")
    kit_exec_write(files.join(root, "Core/Collections/Set.jet"), "set: fn() {{}}\n")
    kit_exec_write(files.join(root, "Compiler/Prelude/Core.rows"), "rows\n")
    work: files.join(root, "Tests/UI/layers")
    kit_exec_write(files.join(work, "Core/package.jet"), "layers: {{}}\n")
    toolchain: kit_ui_stage_core(kit_ui_test_context(root, "case"), "use probe: core.files\n", work, "Collections/Set.jet", "") ?? panic("stage check_core: {err}")
    assert_eq(files.read(files.join(toolchain, "Core/package.jet")) ?? "", "layers: {{}}\n")
    assert_eq(files.read(files.join(toolchain, "Core/Collections/Set.jet")) ?? "", "use probe: core.files\nset: fn() {{}}\n")
    assert_eq(files.read(files.join(toolchain, "Compiler/Prelude/Core.rows")) ?? "", "rows\n")
    assert_eq(files.read(files.join(root, "Core/Collections/Set.jet")) ?? "", "set: fn() {{}}\n")
    files.remove_all(root) ?? panic("remove check_core scratch: {err}")
}

#Test("UI check_core puts the entry's text after its one anchor line and fails on a missing or doubled anchor") {
    call: kit_ui_invocation("// @check_core Builtins/Builtins.jet after \"Kind: enum {{\"\n    Probe\n", "Tests/UI/roles/main.jet", false)
    assert_eq(call.core_top, "Builtins/Builtins.jet")
    assert_eq(call.core_after, "\"Kind: enum {{\"")
    assert_eq(kit_ui_invocation("// @check_core Builtins/Builtins.jet\n", "Tests/UI/roles/main.jet", false).core_after, "")
    below: "// kinds\nKind: enum {{\n    First,\n}}\n"
    assert_eq(kit_ui_core_insert("    Probe,\n", below, "Builtins/Builtins.jet", "\"Kind: enum {{\"") ?? "", "// kinds\nKind: enum {{\n    Probe,\n    First,\n}}\n")
    assert_eq(kit_ui_core_insert("    Probe\n", "Kind: enum {{", "B.jet", "\"Kind: enum {{\"") ?? "", "Kind: enum {{\n    Probe\n")
    // An error comes back as its text, never as a prepended file.
    missing: kit_ui_core_insert("    Probe\n", below, "Builtins/Builtins.jet", "\"Mode: enum {{\"") ?? "{err}"
    assert_eq(missing, "@check_core Builtins/Builtins.jet after \"Mode: enum {{\": no line of Core/Builtins/Builtins.jet reads the anchor")
    doubled: kit_ui_core_insert("    Probe\n", "{below}{below}", "Builtins/Builtins.jet", "\"Kind: enum {{\"") ?? "{err}"
    assert_eq(doubled, "@check_core Builtins/Builtins.jet after \"Kind: enum {{\": Core/Builtins/Builtins.jet has the anchor line twice (lines 2 and 6)")
    unquoted: kit_ui_core_insert("    Probe\n", below, "Builtins/Builtins.jet", "Kind: enum {{") ?? "{err}"
    assert_eq(unquoted, "@check_core Builtins/Builtins.jet after Kind: enum {{: the anchor must be one line of Core/Builtins/Builtins.jet in double quotes")
    // Staging reports the error instead of writing the file.
    root: kit_ui_test_scratch("check-core-anchor")
    kit_exec_write(files.join(root, "Core/Builtins/Builtins.jet"), below)
    kit_exec_write(files.join(root, "Compiler/Prelude/Core.rows"), "rows\n")
    work: files.join(root, "Tests/UI/roles")
    ctx: kit_ui_test_context(root, "case")
    staged: kit_ui_stage_core(ctx, "    Probe\n", work, "Builtins/Builtins.jet", "\"Mode: enum {{\"") ?? "{err}"
    assert_eq(staged, missing)
    assert_eq(files.read(files.join(ctx.scratch, "check-core/Core/Builtins/Builtins.jet")) ?? "", below)
    files.remove_all(root) ?? panic("remove check_core anchor scratch: {err}")
}

#Test("UI discovery walks groups but stops at project entries and excludes fixed companions") {
    root: kit_ui_test_scratch("discover")
    loop path in
        ["Tests/UI/a.jet", "Tests/UI/a.fixed.jet", "Tests/UI/group/nested.jet", "Tests/UI/group/project/run.jet", "Tests/UI/group/project/helper.jet", "Tests/UI/main/main.jet", "Tests/UI/workspace/workspace.jet", "Tests/UI/workspace/member/run.jet", "Tests/UILint/group/lint.jet"] {
        kit_exec_write(files.join(root, path), "run: fn() {{}}\n")
    }
    kit_exec_write(files.join(root, "Tests/UI/group/support.jet"), "// @fixture_module\nhelper: fn() {{}}\n")
    kit_exec_write(files.join(root, "Tests/UI/route.jet"), "// @fixture_module\npage: fn() {{}}\n")
    entries: kit_ui_discover(kit_ui_test_context(root, "scratch"))
    assert_eq(entries.len(), 6)
    assert_eq(entries[0].path, "Tests/UI/a.jet")
    assert(entries.any(fn(entry) { entry.expected == "Tests/UI/group/project/stderr" }))
    assert(entries.any(fn(entry) { entry.expected == "Tests/UI/main/stderr" }))
    assert(entries.any(fn(entry) { entry.expected == "Tests/UI/workspace.stderr" }))
    assert(entries.any(fn(entry) { entry.expected == "Tests/UILint/group/lint.warn" }))
    assert(!entries.any(fn(entry) { entry.path.ends_with("helper.jet") || entry.path.ends_with(".fixed.jet") || entry.path.contains("member") }))
    assert(!entries.any(fn(entry) { entry.path.ends_with("support.jet") || entry.path.ends_with("route.jet") }))
    assert(entries.any(fn(entry) { entry.path == "Tests/UI/group/nested.jet" }))
    ^coverage: kit_ui_test_context(root, "coverage")
    coverage.options.coverage = true
    assert_eq(kit_ui_discover(coverage)[0].mode, "coverage")
    files.remove_all(root) ?? panic("remove UI scratch: {err}")
}

#Test("UI staging handles plain lint project state schema hook and fixed build/run") {
    root: kit_ui_test_scratch("driver")
    hook: files.join(root, "hook.wasm")
    kit_exec_write(hook, "fixture hook")
    loop path in
        ["Tests/UI/bad.jet", "Tests/UI/clean.jet", "Tests/UI/clean.fixed.jet", "Tests/UI/published.jet", "Tests/UI/extension.jet", "Tests/UI/project/run.jet", "Tests/UILint/lint.jet"] {
        kit_exec_write(files.join(root, path), "run: fn() {{}}\n")
    }
    kit_exec_write(files.join(root, "Tests/UI/extension.jet"), "// @compiler_extension hook.wasm\nrun: fn() {{}}\n")
    kit_exec_write(files.join(root, "Tests/UI/project/state/authored"), "state")
    kit_exec_write(files.join(root, "Tests/UI/published.published.snapshot"), "type = Record\nfield = old\n")
    loop path in ["Tests/UI/bad.stderr", "Tests/UI/project/stderr"] {
        kit_exec_write(files.join(root, path), "Error: Jet.OperatorTypeMismatch: mismatch\n")
    }
    loop path in ["Tests/UI/clean.stderr", "Tests/UI/published.stderr", "Tests/UI/extension.stderr"] {
        kit_exec_write(files.join(root, path), "(no errors)\n")
    }
    kit_exec_write(files.join(root, "Tests/UILint/lint.warn"), "Warning: Jet.SameEnumGuardTable: lint\n")
    kit_ui_stage(root, root, true, kit_test_checkout_options(root).ui_corpora)
    entries: kit_ui_discover(kit_ui_test_context(root, "discovery"))
    loop (index, entry) in entries {
        outcomes: kit_ui_run(entry, kit_ui_test_context(root, "case-{index}"))
        loop outcome in outcomes -> assert_eq(outcome.verdict.status, "PASS")
        if entry.path == "Tests/UI/clean.jet" {
            assert_eq(outcomes.len(), 3)
            assert_eq(outcomes[1].tier, "o0")
            assert_eq(outcomes[2].tier, "o1")
        }
    }
    files.remove_all(root) ?? panic("remove UI driver scratch: {err}")
}

#Test("UI known-failing ledger rows own real snapshot failures and reject stale passes") {
    root: kit_ui_test_scratch("known-failing")
    loop path in
        ["Tests/UI/owned.jet", "Tests/UI/stale.jet", "Tests/UI/unowned.jet", "Tests/UI/dir_owned/run.jet"] {
        kit_exec_write(files.join(root, path), "run: fn() {{}}\n")
    }
    loop path in ["Tests/UI/owned.stderr", "Tests/UI/unowned.stderr", "Tests/UI/dir_owned/stderr"] {
        kit_exec_write(files.join(root, path), "Error: Jet.UnknownName: other\n")
    }
    kit_exec_write(files.join(root, "Tests/UI/stale.stderr"), "Error: Jet.OperatorTypeMismatch: mismatch\n")
    kit_exec_write(kit_test_ledger(root), "# repo-relative ID\tcard\treason\nTests/UI/owned\t#4868\towned ui mismatch\nTests/UI/stale\t#4869\tstale ui row\nTests/UI/dir_owned\t#4870\towned ui project\n")
    kit_ui_stage(root, root, true, kit_test_checkout_options(root).ui_corpora)
    entries: kit_ui_discover(kit_ui_test_context(root, "discovery"))
    assert_eq(entries.len(), 4)
    loop (index, entry) in entries {
        outcome: kit_ui_run(entry, kit_ui_test_context(root, "case-{index}"))[0]
        if entry.path == "Tests/UI/owned.jet" {
            assert_eq(outcome.verdict.status, "KNOWN-FAILING")
            assert(outcome.verdict.detail.starts_with("#4868 owned ui mismatch: "))
        } else if entry.path == "Tests/UI/dir_owned/run.jet" {
            assert_eq(outcome.verdict.status, "KNOWN-FAILING")
        } else if entry.path == "Tests/UI/stale.jet" {
            assert_eq(outcome.verdict.status, "UNEXPECTED-PASS")
            assert_eq(outcome.verdict.detail, "#4869 stale ui row: remove stale known-failing annotation")
        } else {
            assert_eq(entry.path, "Tests/UI/unowned.jet")
            assert_eq(outcome.verdict.status, "FAIL")
        }
    }
    files.remove_all(root) ?? panic("remove UI known-failing scratch: {err}")
}

#Test("a UI fixed companion's rows belong to the companion's own ledger row, not the entry's") {
    root: kit_ui_test_scratch("fixed-ledger")
    loop stem in ["clean_crash", "clean_crash_entry"] {
        kit_exec_write(files.join(root, "Tests/UI/{stem}.jet"), "run: fn() {{}}\n")
        kit_exec_write(files.join(root, "Tests/UI/{stem}.fixed.jet"), "run: fn() {{}}\n")
        kit_exec_write(files.join(root, "Tests/UI/{stem}.stderr"), "(no errors)\n")
    }
    kit_exec_write(kit_test_ledger(root), "Tests/UI/clean_crash.fixed\towner\tcompanion crash\nTests/UI/clean_crash_entry\towner\tentry row only\n")
    kit_ui_stage(root, root, true, kit_test_checkout_options(root).ui_corpora)
    entries: kit_ui_discover(kit_ui_test_context(root, "discovery"))
    assert_eq(entries.len(), 2)
    loop (index, entry) in entries {
        outcomes: kit_ui_run(entry, kit_ui_test_context(root, "case-{index}"))
        statuses: outcomes.map(fn(outcome) { outcome.verdict.status.copy() })
        if entry.path == "Tests/UI/clean_crash.jet" {
            assert_eq(statuses, ["PASS", "KNOWN-FAILING", "KNOWN-FAILING"])
            assert(outcomes[1].verdict.detail.starts_with("owner companion crash: "))
        } else {
            assert_eq(entry.path, "Tests/UI/clean_crash_entry.jet")
            assert_eq(statuses, ["UNEXPECTED-PASS", "FAIL", "FAIL"])
        }
    }
    files.remove_all(root) ?? panic("remove UI fixed-ledger scratch: {err}")
}

#Test("a UI fixture's `@requires` lines gate it and its fixed companion as SKIP-HOST, even under a ledger row") {
    root: kit_ui_test_scratch("requires")
    missing: "tool:jet-ui-test-absent-tool"
    met: "env:JET_UI_TEST_UNSET_VARIABLE="
    assert_eq(kit_ui_requirements("// @requires {met}\nrun: fn() {{}}\n//\t@requires\t{missing}\n// @requires_not\n"), [met, missing])
    assert_eq(kit_ui_invocation("// @requires {missing}\n", "a.jet", false).refused, "")
    kit_exec_write(files.join(root, "Tests/UI/needs_tool.jet"), "run: fn() {{}}\n// @requires {missing}\n")
    kit_exec_write(files.join(root, "Tests/UI/needs_tool.stderr"), "Error: Jet.UnknownName: never compared\n")
    // The CLI double passes only `clean` entries; `needs_tool` would fail if it ran.
    kit_exec_write(files.join(root, "Tests/UI/clean_companion.jet"), "run: fn() {{}}\n")
    kit_exec_write(files.join(root, "Tests/UI/clean_companion.fixed.jet"), "// @requires {met}\n// @requires {missing}\nrun: fn() {{}}\n")
    kit_exec_write(files.join(root, "Tests/UI/clean_companion.stderr"), "(no errors)\n")
    kit_exec_write(files.join(root, "Tests/UI/clean_met.jet"), "run: fn() {{}}\n// @requires {met}\n")
    kit_exec_write(files.join(root, "Tests/UI/clean_met.stderr"), "(no errors)\n")
    kit_exec_write(kit_test_ledger(root), "Tests/UI/needs_tool\towner\tledger rows never claim a skipped fixture\n")
    kit_ui_stage(root, root, true, kit_test_checkout_options(root).ui_corpora)
    entries: kit_ui_discover(kit_ui_test_context(root, "discovery"))
    assert_eq(entries.map(fn(entry) { entry.path.copy() }), ["Tests/UI/clean_companion.jet", "Tests/UI/clean_met.jet", "Tests/UI/needs_tool.jet"])
    loop (index, entry) in entries {
        outcomes: kit_ui_run(entry, kit_ui_test_context(root, "case-{index}"))
        statuses: outcomes.map(fn(outcome) { outcome.verdict.status.copy() })
        if {
            entry.path == "Tests/UI/clean_companion.jet" -> {
                assert_eq(statuses, ["PASS", "SKIP-HOST"])
                assert_eq(outcomes[1].tier, "fixed-check")
                assert_eq(outcomes[1].verdict.detail, missing)
            }
            entry.path == "Tests/UI/clean_met.jet" -> assert_eq(statuses, ["PASS"])
            else -> {
                assert_eq(statuses, ["SKIP-HOST"])
                assert_eq(outcomes[0].verdict.detail, missing)
            }
        }
    }
    files.remove_all(root) ?? panic("remove UI requires scratch: {err}")
}

#Test("UI staging gives a loose entry its imported modules route trees and data but no other entry") {
    root: kit_ui_test_scratch("imports")
    main: "use helper: \"./modules/helper\"\nrun: fn() {{ print(helper.value()) }}\n"
    helper: "value: fn() -> Int {{ 7 }}\n// @fixture_module\n"
    kit_exec_write(files.join(root, "Tests/UI/clean_import.jet"), main)
    kit_exec_write(files.join(root, "Tests/UI/clean_import.stderr"), "(no errors)\n")
    kit_exec_write(files.join(root, "Tests/UI/Modules/helper.jet"), helper)
    kit_exec_write(files.join(root, "Tests/UI/routes/Index.jet"), "page: fn() {{}}\n// @fixture_module\n")
    kit_exec_write(files.join(root, "Tests/UI/embedded.dat"), "data\n")
    kit_exec_write(files.join(root, "Tests/UI/other.jet"), "run: fn() {{}}\n")
    kit_exec_write(files.join(root, "Tests/UI/other.stderr"), "(no errors)\n")
    kit_exec_write(files.join(root, "Tests/UI/group/inner.jet"), "run: fn() {{}}\n")
    kit_exec_write(files.join(root, "Tests/UI/project/run.jet"), "run: fn() {{}}\n")
    context: kit_ui_test_context(root, "case")
    kit_ui_stage(root, root, true, kit_test_checkout_options(root).ui_corpora)
    entries: kit_ui_discover(context)
    assert_eq(entries.len(), 4)
    assert_eq(entries[0].path, "Tests/UI/clean_import.jet")
    assert_eq(kit_ui_run(entries[0], context)[0].verdict.status, "PASS")
    source: files.join(context.scratch, "ui-source")
    assert_eq(files.read(files.join(source, "Tests/UI/clean_import.jet")) ?? panic("staged entry"), main)
    assert_eq(files.read(files.join(source, "Tests/UI/Modules/helper.jet")) ?? panic("staged module"), helper)
    assert(files.exists(files.join(source, "Tests/UI/routes/Index.jet")))
    assert(files.exists(files.join(source, "Tests/UI/embedded.dat")))
    loop path in
        ["Tests/UI/other.jet", "Tests/UI/other.stderr", "Tests/UI/clean_import.stderr", "Tests/UI/group", "Tests/UI/project"] {
        assert(!files.exists(files.join(source, path)), "a loose entry's stage holds no other entry: {path}")
    }
    files.remove_all(root) ?? panic("remove imported UI scratch: {err}")
}

#Test("UI public CLI directives stage the unlocked package and build the web target") {
    root: kit_ui_test_scratch("public-cli")
    fixture: "// @jetpack_e1250\nrun: fn() {{}}\n"
    kit_exec_write(files.join(root, "Tests/UI/unlocked.jet"), fixture)
    kit_exec_write(files.join(root, "Tests/UI/unlocked.stderr"), "Error: Jet.UnlockedToolchainChannel: unlocked toolchain\n")
    context: kit_ui_test_context(root, "case")
    entries: kit_ui_discover(context)
    assert_eq(entries.len(), 1)
    assert_eq(kit_ui_run(entries[0], context)[0].verdict.status, "PASS")
    private_source: files.join(context.scratch, "unlocked-toolchain")
    assert_eq(files.read(files.join(private_source, "main.jet")) ?? panic("staged E1250"), fixture)
    assert_eq(files.read(files.join(private_source, "package.jet")) ?? panic("staged manifest"), "name: \"e1250_fixture\"\nversion: \"1\"\njet: \"a0.9\"\n")
    unlocked: kit_ui_invocation(fixture, "Tests/UI/unlocked.jet", false)
    assert_eq(unlocked.argv, ["build", "main.jet", "--offline"])
    assert(unlocked.parent && unlocked.unlocked_toolchain)
    assert_eq(unlocked.exit, "nonzero")
    assert_eq(unlocked.streams, "both")
    web: kit_ui_invocation("// @web_target\n", "Tests/UI/web.jet", false)
    assert_eq(web.argv, ["build", "Tests/UI/web.jet", "--target=web"])
    assert(!web.parent && !web.unlocked_toolchain)
    assert_eq(web.streams, "rendered-both")
    // A lint fixture's `@a11y_cli` or `@cost_cli` keeps the rendered,
    // nonzero-exit stream.
    a11y: kit_ui_invocation("// @a11y_cli\n", "Tests/UILint/a11y.jet", true)
    assert_eq(a11y.argv, ["lint", "--a11y", "Tests/UILint/a11y.jet"])
    assert_eq(a11y.exit, "nonzero")
    assert_eq(a11y.streams, "rendered")
    cost: kit_ui_invocation("// @cost_cli\n", "Tests/UILint/cost.jet", true)
    assert_eq(cost.argv, ["lint", "--cost", "Tests/UILint/cost.jet"])
    assert_eq(cost.exit, "nonzero")
    assert_eq(cost.streams, "rendered")
    // A lint fixture's `@report_cli` lists its advice through `jet lint`,
    // which exits 0, so it keeps the lint stream and its acceptance.
    report: kit_ui_invocation("// @report_cli\n", "Tests/UILint/report.jet", true)
    assert_eq(report.argv, ["lint", "Tests/UILint/report.jet"])
    assert_eq(report.exit, "any")
    assert_eq(report.streams, "lint")
    assert_eq(kit_ui_rendered_only("Warning: Jet.HiddenContextAllocation: advice\n\n1 report found\nRun `jet explain Jet.HiddenContextAllocation` to learn more\n"), "Warning: Jet.HiddenContextAllocation: advice\n")
    files.remove_all(root) ?? panic("remove public CLI scratch: {err}")
}

#Test("UI lint acceptance and diagnostic shrink guard cannot be blessed away") {
    root: kit_ui_test_scratch("bless")
    entry: KitEntry{path: "Tests/UILint/lint.jet", expected: "Tests/UILint/lint.warn", project: "Tests/UILint", suite: "ui", mode: "lint"}
    call: kit_ui_invocation("", entry.path, true)
    ^ctx: kit_ui_test_context(root, "scratch")
    ctx.bless.ids = [entry.path]
    assert_eq(kit_ui_snapshot(entry, call, kit_ui_test_run(0, ""), "", ctx).status, "FAIL")
    assert_eq(kit_ui_snapshot(entry, call, kit_ui_test_run(1, "Warning: Jet.SameEnumGuardTable: lint\n"), "Warning: Jet.SameEnumGuardTable: lint\n", ctx).status, "FAIL")
    kit_exec_write(files.join(root, entry.expected), "Warning: Jet.SameEnumGuardTable: lint\nWarning: Jet.RepeatedListHead: another\n")
    assert_eq(kit_ui_snapshot(entry, call, kit_ui_test_run(0, "Warning: Jet.SameEnumGuardTable: lint\n"), "Warning: Jet.SameEnumGuardTable: lint\n", ctx).status, "REFUSED")
    ctx.bless.allow_shrink = [entry.path]
    assert_eq(kit_ui_snapshot(entry, call, kit_ui_test_run(0, "Warning: Jet.SameEnumGuardTable: lint\n"), "Warning: Jet.SameEnumGuardTable: lint\n", ctx).status, "PASS")
    assert_eq(files.read(files.join(root, entry.expected)) ?? "", "Warning: Jet.SameEnumGuardTable: lint\n")
    files.remove_all(root) ?? panic("remove UI bless scratch: {err}")
}

// A tidy lint fails `jet check` and renders as an error; a fixture whose check
// fails on lints alone (each heading names a `.Lint` row) still compiled, and
// one with a real error did not.
#Test("a UI lint fixture may fail its check on tidy lints alone") {
    root: kit_ui_test_scratch("tidy")
    entry: KitEntry{path: "Tests/UILint/lint.jet", expected: "Tests/UILint/lint.warn", project: "Tests/UILint", suite: "ui", mode: "lint"}
    call: kit_ui_invocation("", entry.path, true)
    ctx: kit_ui_test_context(root, "scratch")
    registry: "UnusedImport: struct {{\n    impl Diagnostic {{\n        code: \"L0103\",\n        severity: .Lint,\n    }}\n}}\n\nStrayCharacter: struct {{\n    impl Diagnostic {{\n        code: \"E0001\",\n    }}\n}}\n"
    kit_exec_write(files.join(root, "Compiler/Prelude/Diagnostics.jet"), registry)
    tidy: "Error: Jet.UnusedImport: unused\nMore: jet-lang.dev/e/Jet.UnusedImport\n"
    kit_exec_write(files.join(root, entry.expected), tidy)
    assert_eq(kit_ui_snapshot(entry, call, kit_ui_test_run(1, tidy), tidy, ctx).status, "PASS")
    broken: "{tidy}\nError: Jet.StrayCharacter: broken\nMore: jet-lang.dev/e/Jet.StrayCharacter\n"
    assert_eq(kit_ui_snapshot(entry, call, kit_ui_test_run(1, broken), broken, ctx).status, "FAIL")
    files.remove_all(root) ?? panic("remove UI tidy scratch: {err}")
}

#Test("UI coverage independently derives source codes report openers and allowances") {
    row: KitUIRegistryRow{code: "E0109", name: "Jet.OperatorTypeMismatch", active: true, lint: false}
    ^kept: [String]{}
    assert_eq(kit_ui_set_coverage([row], ["E0109"], [], "", kept).status, "FAIL")
    assert_eq(kit_ui_set_coverage([row], ["E0109"], [], "E0109\tleft-only\tTower #2093\n", kept).status, "PASS")
    assert_eq(kit_ui_set_coverage([row], ["E0109"], ["E0109"], "E0109\tleft-only\tTower #2093\n", kept).status, "FAIL")
    assert_eq(kit_ui_set_coverage([row], ["E0109"], ["E0109"], "", kept).status, "PASS")
    assert_eq(kit_ui_set_coverage([row], [], ["FFI01"], "FFI01\tright-only\tTower #6752\n", kept).status, "PASS")
    assert_eq(kit_ui_set_coverage([row], ["FFI01"], [], "FFI01\tleft-only\tTower #6752\n", kept).status, "FAIL")
    ^over: ""
    loop _ in 0..<153 -> over = "{over}E0109\tleft-only\tTower #2093\n"
    assert(kit_ui_set_coverage([row], ["E0109"], [], over, kept).detail.contains("ceiling 152"))
    stop: KitUIRegistryRow{code: "E3003", name: "Jet.DeadlineExceeded", active: true, lint: false}
    lint: KitUIRegistryRow{code: "L0302", name: "Jet.SameEnumGuardTable", active: true, lint: true}
    assert_eq(kit_ui_extract_reports("Error: Jet.OperatorTypeMismatch: root\n Warning: Jet.SameEnumGuardTable: indented\n Fix: E0001\nStop: Jet.DeadlineExceeded: runtime\nLint: Jet.SameEnumGuardTable: lint\nError: Jet.Unknown: unregistered\nError: FFI01: foreign\nError: E0002: unregistered\nError: couldn't read it: no\n", [row, stop, lint]), ["E0109", "E3003", "L0302", "E0002"])
    trail: KitUIRegistryRow{code: "E3002", name: "Jet.FailureTrail", active: true, lint: false}
    assert_eq(kit_ui_extract_reports("Error: boom\n Trail (2 calls passed it up, origin first):\n  1. f (a.jet:1)\nsee the Trail (above)\n  Trail (indented)\n", [row, trail]), ["E3002"])
    assert_eq(kit_ui_extract_source("\"E0109\" [L0302] \"FS\" \"E-WEB-ABI-TYPE\" \"JT0001\"", [row]), ["E0109", "L0302", "E-WEB-ABI-TYPE", "JT0001"])
    assert_eq(kit_ui_extract_source("\"Stop: Jet.DeadlineExceeded: late\" \"Jet.SameEnumGuardTable: x\" core.Jet.OperatorTypeMismatch: no Jet.Unknown: no\n", [row, stop, lint]), ["E3003", "L0302"])
    parsed: kit_ui_registry("// header\nA: struct {{\n    impl Diagnostic {{\n        code: \"E0109\",\n        severity: .Lint,\n        structured_fix: .CryptoMisuse,\n        no_fix: None,\n        what: fn(self) -> String {{ \"w\" }}\n    }}\n}}\n\nB: struct {{\n    path: String,\n\n    impl Diagnostic {{\n        code: \"E0001\",\n        stage: [.Jet, .Parse],\n    }}\n}}\n\nC: struct {{\n    impl Diagnostic {{\n        code: \"E0004\",\n        status: .Retired,\n    }}\n}}\n")
    assert_eq(parsed.len(), 3)
    assert_eq(parsed[0].code, "E0109")
    assert_eq(parsed[0].name, "Jet.A")
    assert(parsed[0].active && parsed[1].active)
    assert(parsed[0].lint && !parsed[1].lint)
    assert_eq(parsed[1].name, "Jet.B")
    assert(!parsed[2].active)
}

#Test("a blessed coverage run keeps every allowance it still needs and drops only stale ones") {
    row: KitUIRegistryRow{code: "E0109", name: "Jet.OperatorTypeMismatch", active: true, lint: false}
    other: KitUIRegistryRow{code: "E0001", name: "Jet.StrayCharacter", active: true, lint: false}
    allowlist: "# code\tside\tcard\nE0109\tleft-only\tTower #2093\nE0001\tleft-only\tTower #1\n"
    ^kept: [String]{}
    verdict: kit_ui_set_coverage([row, other], ["E0109", "E0001"], ["E0001"], allowlist, kept)
    assert_eq(verdict.status, "FAIL")
    assert(verdict.detail.contains("stale coverage allowance: E0001"))
    assert_eq(kept.join("\n"), "# code\tside\tcard\nE0109\tleft-only\tTower #2093\n")
    ^again: [String]{}
    assert_eq(kit_ui_set_coverage([row, other], ["E0109", "E0001"], ["E0001"], kept.join("\n"), again).status, "PASS")
    assert_eq(again.join("\n"), kept.join("\n"))
}
