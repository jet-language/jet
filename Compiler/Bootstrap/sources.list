# == Jetpack package model (shared block; PortLockSbom + PortFmtPkg) ==
# The jet-pkg-model ports the CLI's `jet fmt` package path needs (package
# parse/format/diagnostics) plus the Syntax constants the JetFoundation policy
# ports read, referenced from Jetpack/, never copied (I8). The list is the
# reference closure of those entry points, in Jetpack/Bootstrap/sources.list
# order. CoreImports is Jetpack's canonical alias provider; the assembler
# blanks exact duplicate Core imports from the Compiler files. The checked
# authority/workspace/manifest closure below supplies selected-project-root
# discovery and held filesystem publication. Other Jetpack consumers rejoin
# only with their own complete reference closure.
Jetpack/Foundation/Source/CoreImports.jet
Jetpack/Foundation/Source/Syntax.jet
Jetpack/Foundation/Source/BuildEffect.jet
Jetpack/Foundation/Source/GeneratedNames.jet
Jetpack/Foundation/Source/TreeHash.jet
