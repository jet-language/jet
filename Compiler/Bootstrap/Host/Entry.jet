// Private source-coupled bootstrap entry. This file is included only when the
// compiler aggregate is linked with its native host glue; it is not a user
// package surface and is intentionally outside the public source inventory.
//
// Keep the boundary typed: the request owns its selected target and Eval config.
// The native host installs callbacks once, then transfers the complete request.
// The host ABI is infallible: a failure escaping the driver becomes the
// result's internal problem instead of a Result the host cannot decode.
//
// `JET_KEEP_GOING=1` selects the compiler-internal all-phases diagnostic mode
// (jet_driver_compile_keep_going): every phase runs past earlier failures and
// each failure is a TSV row, written to `JET_KEEP_GOING_REPORT` when it is
// set. `JET_KEEP_GOING_SKIP` lists, comma-separated, the `<phase>:<name>@<n>`
// functions an earlier run crashed in, which this run traps instead. The
// Core imports use the unit's shared spellings (JetCli's), which the
// assembler keeps once.
use core.sys as cli_sys
use core.files as cli_files
use jet_driver.[
    JetDriverCompileRequest,
    JetDriverCompileResult,
    JetDriverKeepGoing,
    jet_driver_compile,
    jet_driver_compile_mir,
    jet_driver_compile_escaped_failure,
    jet_driver_compile_keep_going,
]
use jet_backend.[x64_runtime_library]

// The library-object feed: the same checked driver's in-process MIR becomes
// one relocatable runtime object. Neither an emitted Rust program nor a Rust
// MIR conversion enters this path; exports come from the checked NativeLibrary
// artifact or the explicit audited exports.list.
fn jet_bootstrap_library_object(request: ^JetDriverCompileRequest, prefix: String) -> JetDriverCompileResult Never! {
    result := jet_driver_compile_mir(^request) ?? return jet_driver_compile_escaped_failure("the native front end failed outside every compile stage")
    if !result.complete || result.internal_problem != None -> return result
    program :: result.mir ?? return jet_driver_compile_escaped_failure("the native front end finished without MIR")
    export_path :: cli_sys.get("JET_FRONT_LIBRARY_EXPORTS") ?? return jet_driver_compile_escaped_failure("runtime library feed requires the explicit audited exports.list path")
    export_text :: cli_files.read(export_path) ?? return jet_driver_compile_escaped_failure("cannot read runtime exports.list")
    symbols := [String]{}
    loop line in export_text.split("\n").to_list() {
        if line.trim() != "" -> &symbols.push(line.trim())
    }
    library :: x64_runtime_library(program, symbols)
    if library.object.errors.len() > 0 {
        cli_files.write("{prefix}.issues", library.object.errors.join("\n")) ?? return jet_driver_compile_escaped_failure("cannot write runtime library findings")
        return jet_driver_compile_escaped_failure("runtime library object failed; see {prefix}.issues")
    }
    cli_files.write_bytes("{prefix}.o", library.object.bytes) ?? return jet_driver_compile_escaped_failure("cannot write runtime library object")
    symbols_out :: loop entry_row in library.exports -> entry_row.symbol
    cli_files.write("{prefix}.exports", symbols_out.join("\n")) ?? return jet_driver_compile_escaped_failure("cannot write runtime library export receipt")
    result
}

fn jet_bootstrap_compile(request: ^JetDriverCompileRequest) -> JetDriverCompileResult Never! {
    if cli_sys.get("JET_FRONT_LIBRARY_OBJECT_OUTPUT") == .Val(prefix) -> return jet_bootstrap_library_object(^request, prefix)
    if cli_sys.get("JET_KEEP_GOING") != Val("1") {
        return jet_driver_compile(^request) ?? jet_driver_compile_escaped_failure("the compiler driver failed outside every compile stage")
    }
    skip := [String]{}
    loop entry in (cli_sys.get("JET_KEEP_GOING_SKIP") ?? "").split(",").to_list() {
        if entry.trim().len() > 0 -> &skip.push(entry.trim())
    }
    result := jet_driver_compile_keep_going(^request, JetDriverKeepGoing{skip: skip}) ?? jet_driver_compile_escaped_failure("the compiler driver failed outside every compile stage")
    report :: cli_sys.get("JET_KEEP_GOING_REPORT") ?? return result
    lines := [String]{"phase\titem\tcode\tmessage\tspan"}
    loop row in result.keep_going_rows -> &lines.push(row)
    &lines.push("")
    cli_files.write(report, lines.join("\n")) ?? return result
    result
}
