// Private source-coupled bootstrap entry. This file is included only when the
// compiler aggregate is linked with its native host glue; it is not a user
// package surface and is intentionally outside the public source inventory.
//
// Keep the boundary typed: the request owns its selected target and Eval config.
// The native host installs callbacks once, then transfers the complete request.
// The host ABI is infallible: a failure escaping the driver becomes the
// result's internal problem instead of a Result the host cannot decode.
//
// `JET_KEEP_GOING=1` selects the compiler-internal all-phases diagnostic mode
// (jet_driver_compile_keep_going): every phase runs past earlier failures and
// each failure is a TSV row, written to `JET_KEEP_GOING_REPORT` when it is
// set. `JET_KEEP_GOING_SKIP` lists, comma-separated, the `<phase>:<name>@<n>`
// functions an earlier run crashed in, which this run traps instead. The
// Core imports use the unit's shared spellings (JetCli's), which the
// assembler keeps once.
use core.sys as cli_sys
use core.files as cli_files
use jet_backend.[CoreSharedParentGetterResult, CoreSharedParentRuntime]
use jet_driver.[
    JetDriverCompileRequest,
    JetDriverCompileResult,
    JetDriverKeepGoing,
    jet_driver_compile,
    jet_driver_compile_mir,
    jet_driver_compile_escaped_failure,
    jet_driver_compile_keep_going,
    JetDriverCoreLibraryPreparation,
    jet_driver_prepare_core_library,
    JetDriverCoreSource,
    jet_driver_core_library_request,
    JetDriverCoreSourceParentHost,
    jet_driver_core_source_parent_new,
    jet_driver_core_source_parent_attach,
    jet_driver_core_source_parent_getter,
]
use jet_backend.[lir_lower_entry, lir_print_module, x64_relocatable_object, x64_link_executable, x64_runtime_library]

// Self-host inventories observe Jet's checked MIR without entering Rust emit.
fn jet_bootstrap_mir(request: ^JetDriverCompileRequest) -> JetDriverCompileResult Never! {
    result := jet_driver_compile_mir(^request) ?? return jet_driver_compile_escaped_failure("the native front end failed outside every compile stage")
    if cli_sys.get("JET_FRONT_MIR_OUTPUT") == .Val(path) {
        if !result.complete || result.internal_problem != None -> return result
        program :: result.mir ?? return jet_driver_compile_escaped_failure("the native front end finished without MIR")
        entry :: result.entry_function ?? return jet_driver_compile_escaped_failure("the native front end finished without an entry")
        stream := [String]{"{entry.value}"}
        mirw_mir_program(program, &stream)
        cli_files.write(path, stream.join("\n")) ?? return jet_driver_compile_escaped_failure("cannot write checked Jet MIR observation")
    }
    result
}

// Native-feed probes use the same checked driver and linker as the Jet host.
// Neither an emitted Rust program nor a Rust MIR conversion enters this path.
fn jet_bootstrap_native(request: ^JetDriverCompileRequest, prefix: String) -> JetDriverCompileResult Never! {
    result := jet_bootstrap_mir(^request) ?? return jet_driver_compile_escaped_failure("the native front end failed outside every compile stage")
    if !result.complete || result.internal_problem != None -> return result
    program :: result.mir ?? return jet_driver_compile_escaped_failure("the native front end finished without MIR")
    if cli_sys.get("JET_FRONT_LIBRARY_OBJECT_OUTPUT") != None {
        export_path :: cli_sys.get("JET_FRONT_LIBRARY_EXPORTS") ?? return jet_driver_compile_escaped_failure("runtime library feed requires the explicit audited exports.list path")
        export_text :: cli_files.read(export_path) ?? return jet_driver_compile_escaped_failure("cannot read runtime exports.list")
        symbols := [String]{}
        loop line in export_text.split("\n").to_list() {
            if line.trim() != "" -> &symbols.push(line.trim())
        }
        library :: x64_runtime_library(program, symbols)
        if library.object.errors.len() > 0 {
            cli_files.write("{prefix}.issues", library.object.errors.join("\n")) ?? return jet_driver_compile_escaped_failure("cannot write runtime library findings")
            return jet_driver_compile_escaped_failure("runtime library object failed; see {prefix}.issues")
        }
        cli_files.write_bytes("{prefix}.o", library.object.bytes) ?? return jet_driver_compile_escaped_failure("cannot write runtime library object")
        symbols_out :: loop entry_row in library.exports -> entry_row.symbol
        cli_files.write("{prefix}.exports", symbols_out.join("\n")) ?? return jet_driver_compile_escaped_failure("cannot write runtime library export receipt")
        return result
    }
    entry_id :: result.entry_function ?? return jet_driver_compile_escaped_failure("the native front end finished without an entry")
    lowered :: lir_lower_entry(program, entry_id)
    if lowered.issues.len() > 0 {
        lines :: loop issue in lowered.issues -> "{issue.function}\t{issue.message}"
        cli_files.write("{prefix}.issues", lines.join("\n")) ?? return jet_driver_compile_escaped_failure("cannot write native lowering findings")
        return result
    }
    entry :: lowered.entry ?? return jet_driver_compile_escaped_failure("native lowering lost its entry")
    cli_files.write("{prefix}.lir", lir_print_module(lowered.lir)) ?? return jet_driver_compile_escaped_failure("cannot write native LIR")
    object :: x64_relocatable_object(lowered.lir, entry)
    if object.errors.len() > 0 {
        cli_files.write("{prefix}.issues", object.errors.join("\n")) ?? return jet_driver_compile_escaped_failure("cannot write native object findings")
        return result
    }
    cli_files.write_bytes("{prefix}.o", object.bytes) ?? return jet_driver_compile_escaped_failure("cannot write native object")
    pack_path :: cli_sys.get("JET_RUNTIME_PACK") ?? return jet_driver_compile_escaped_failure("native feed requires JET_RUNTIME_PACK")
    pack :: cli_files.read_bytes(pack_path) ?? return jet_driver_compile_escaped_failure("cannot read native runtime pack")
    linked :: x64_link_executable([String]{"{prefix}.o", pack_path}, ^[[U8]]{object.bytes, pack})
    if linked.errors.len() > 0 {
        cli_files.write("{prefix}.pack-issues", linked.errors.join("\n")) ?? return jet_driver_compile_escaped_failure("cannot write native link findings")
        return result
    }
    cli_files.write_bytes("{prefix}.exe", linked.bytes) ?? return jet_driver_compile_escaped_failure("cannot write native executable")
    cli_files.set_mode("{prefix}.exe", 0o755) ?? return jet_driver_compile_escaped_failure("cannot make native executable runnable")
    result
}

fn jet_bootstrap_compile(request: ^JetDriverCompileRequest) -> JetDriverCompileResult Never! {
    if cli_sys.get("JET_FRONT_LIBRARY_OBJECT_OUTPUT") == .Val(prefix) -> return jet_bootstrap_native(^request, prefix)
    if cli_sys.get("JET_FRONT_NATIVE_OUTPUT") == .Val(prefix) -> return jet_bootstrap_native(^request, prefix)
    if cli_sys.get("JET_FRONT_MIR_OUTPUT") != None -> return jet_bootstrap_mir(^request)
    if cli_sys.get("JET_KEEP_GOING") != Val("1") {
        return jet_driver_compile(^request) ?? jet_driver_compile_escaped_failure("the compiler driver failed outside every compile stage")
    }
    skip := [String]{}
    loop entry in (cli_sys.get("JET_KEEP_GOING_SKIP") ?? "").split(",").to_list() {
        if entry.trim().len() > 0 -> &skip.push(entry.trim())
    }
    result := jet_driver_compile_keep_going(^request, JetDriverKeepGoing{skip: skip}) ?? jet_driver_compile_escaped_failure("the compiler driver failed outside every compile stage")
    report :: cli_sys.get("JET_KEEP_GOING_REPORT") ?? return result
    lines := [String]{"phase\titem\tcode\tmessage\tspan"}
    loop row in result.keep_going_rows -> &lines.push(row)
    &lines.push("")
    cli_files.write(report, lines.join("\n")) ?? return result
    result
}

// Checked private accessor, invoked by the outer static host using this
// factory's callable metadata. A factory may not reuse the base's schema walk.
fn jet_bootstrap_core_prepare(request: ^JetDriverCompileRequest) -> JetDriverCoreLibraryPreparation Never! {
    jet_driver_prepare_core_library(^request) ?? JetDriverCoreLibraryPreparation.CompileRefused{compilation: jet_driver_compile_escaped_failure("the canonical Core library producer failed outside every compile stage")}
}


fn jet_bootstrap_core_request(template: JetDriverCompileRequest, rows: [JetDriverCoreSource]) -> JetDriverCompileRequest Never! {
    jet_driver_core_library_request(template, rows)
}

fn jet_bootstrap_core_parent_new(rows: ^[JetDriverCoreSource], runtime: ^CoreSharedParentRuntime) -> JetDriverCoreSourceParentHost Never! {
    jet_driver_core_source_parent_new(^rows, ^runtime)
}

fn jet_bootstrap_core_attach(host: &JetDriverCoreSourceParentHost, preparation: JetDriverCoreLibraryPreparation) -> String Never! {
    jet_driver_core_source_parent_attach(&host, preparation)
}

fn jet_bootstrap_core_getter(host: &JetDriverCoreSourceParentHost, site_key: String) -> CoreSharedParentGetterResult Never! {
    jet_driver_core_source_parent_getter(&host, site_key)
}
