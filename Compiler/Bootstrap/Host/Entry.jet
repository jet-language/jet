// Private source-coupled bootstrap entry. This file is included only when the
// compiler aggregate is linked with its native host glue; it is not a user
// package surface and is intentionally outside the public source inventory.
//
// Keep the boundary typed: the request owns its selected target and Eval config.
// The native host installs callbacks once, then transfers the complete request.
// The host ABI is infallible: a failure escaping the driver becomes the
// result's internal problem instead of a Result the host cannot decode.
//
// Every feed delegates to jet_cli_compile_request, including the native and
// library-object environment seams. `JET_KEEP_GOING=1` selects its shared
// all-phases collector, `JET_KEEP_GOING_SKIP` traps previously crashing items,
// and `JET_KEEP_GOING_REPORT` receives the CLI's TSV failure census. A failed
// census is incomplete and cannot produce an artifact. The
// Core imports use the unit's shared spellings (JetCli's), which the
// assembler keeps once.
use core.sys as cli_sys
use core.files as cli_files
use jet_backend.[CoreSharedParentGetterResult, CoreSharedParentRuntime, CoreSharedRuntimeExportABI, core_shared_runtime_export_abis_decode]
use jet_cli.[
    jet_cli_compile_request,
    jet_cli_keep_going_enabled,
    jet_cli_keep_going_report,
    jet_cli_runtime_library,
    jet_cli_native_c_sources,
    jet_cli_native_executable,
    jet_cli_native_lowering_rows,
    jet_cli_runtime_key,
    JET_CLI_RUNTIME_PACK_FILE,
]
use jet_driver.[
    JetDriverCompileRequest,
    JetDriverCompileResult,
    jet_driver_compile_escaped_failure,
    JetDriverCoreLibraryPreparation,
    jet_driver_prepare_core_library,
    JetDriverCoreSource,
    jet_driver_core_library_request,
    JetDriverCoreSourceParentHost,
    jet_driver_core_source_parent_new,
    jet_driver_core_source_parent_attach,
    jet_driver_core_source_parent_getter,
]

// Self-host inventories observe Jet's checked MIR without entering Rust emit.
fn jet_bootstrap_mir(request: ^JetDriverCompileRequest) -> JetDriverCompileResult Never! {
    result := jet_cli_compile_request(^request, false) ?? return jet_driver_compile_escaped_failure("the native front end failed outside every compile stage")
    if cli_sys.get("JET_FRONT_MIR_OUTPUT") == .Val(path) {
        if !result.complete || result.internal_problem != None -> return result
        program :: result.mir ?? return jet_driver_compile_escaped_failure("the native front end finished without MIR")
        entry :: result.entry_function ?? return jet_driver_compile_escaped_failure("the native front end finished without an entry")
        stream := [String]{"{entry.value}"}
        mirw_mir_program(program, &stream)
        cli_files.write(path, stream.join("\n")) ?? return jet_driver_compile_escaped_failure("cannot write checked Jet MIR observation")
    }
    result
}

// The library-object feed shares the CLI's complete runtime producer: checked
// NativeLibrary exports, lifecycle, ABI receipt and optional Rust-free pack.
fn jet_bootstrap_library_object(request: ^JetDriverCompileRequest, prefix: String) -> JetDriverCompileResult Never! {
    result := jet_bootstrap_mir(^request) ?? return jet_driver_compile_escaped_failure("the native front end failed outside every compile stage")
    jet_cli_runtime_library(^result, prefix) ?? jet_driver_compile_escaped_failure("the runtime library producer failed outside every compile stage")
}

// The native feed is `jet build`'s own native route (Host.jet
// `jet_cli_native_executable`) at the dev profile (O0), so the factory's
// stage1 and the CLI's stage2 get identical link inputs, order and flags.
// JET_RUNTIME_PACK names `<jet-runtime>/<key>/jet_runtime.pack.o` inside a
// packaged runtime directory whose `native.key` is `<key>`; that directory
// is the one `jet build` finds beside `jet`. A program with a C closure links
// its sibling jet_runtime_jet.o plus the closure, exactly as `jet build` does.
// Without JET_RUNTIME_PACK the feed still writes `{prefix}.o` (lowering
// discovery), then refuses to link.
// Neither an emitted Rust program nor a Rust MIR conversion enters this path.
// Under JET_KEEP_GOING the feed runs whenever the front end produced MIR, even
// with census rows: each native lowering, object and link finding is one more
// row (jet_cli_native_executable `census`), appended to the result's rows and
// to JET_KEEP_GOING_REPORT, so a failed native step reports every defect.
fn jet_bootstrap_native(request: ^JetDriverCompileRequest, prefix: String) -> JetDriverCompileResult Never! {
    // Capture only the C declarations before the request moves into the compiler.
    sources :: jet_cli_native_c_sources(request.authorized_sources) ?? return jet_bootstrap_native_escaped([String]{}, "native feed cannot resolve C sources: {err.message}")
    runtime_dir := ""
    if cli_sys.get("JET_RUNTIME_PACK") == .Val(pack_path) {
        parts := pack_path.split("/").to_list()
        file :: &parts.pop() ?? ""
        key :: &parts.pop() ?? ""
        runtime_dir = parts.join("/")
        if file != JET_CLI_RUNTIME_PACK_FILE || runtime_dir == "" || jet_cli_runtime_key(runtime_dir) != .Val(key) -> return jet_bootstrap_native_escaped([String]{}, "JET_RUNTIME_PACK must name <jet-runtime>/<native.key>/{JET_CLI_RUNTIME_PACK_FILE} in a packaged runtime directory")
    }
    result := jet_bootstrap_mir(^request) ?? return jet_bootstrap_native_escaped([String]{}, "the native front end failed outside every compile stage")
    keep_going :: jet_cli_keep_going_enabled()
    if keep_going && result.mir == None -> return result
    if !keep_going && (!result.complete || result.internal_problem != None) -> return result
    if result.mir == None -> return jet_bootstrap_native_escaped(result.keep_going_rows, "the native front end finished without MIR")
    census := [String]{}
    native :: jet_cli_native_executable(result, sources, false, runtime_dir, "{prefix}.o", "{prefix}.exe", keep_going, &census)
    failure :: native ?? return jet_bootstrap_native_census(^result, census)
    if failure == {
        .Lowering(functions, messages) -> { cli_files.write("{prefix}.issues", jet_cli_native_lowering_rows(functions, messages, "\t").join("\n")) ?? return jet_bootstrap_native_escaped(result.keep_going_rows, "cannot write native lowering findings") }
        .Object(errors) -> { cli_files.write("{prefix}.issues", errors.join("\n")) ?? return jet_bootstrap_native_escaped(result.keep_going_rows, "cannot write native object findings") }
        .Link(errors) -> { cli_files.write("{prefix}.pack-issues", errors.join("\n")) ?? return jet_bootstrap_native_escaped(result.keep_going_rows, "cannot write native link findings") }
        .RustForeign(error) -> { return jet_bootstrap_native_escaped(result.keep_going_rows, "native feed foreign Rust: {error.what}") }
        .NoEntry -> { return jet_bootstrap_native_escaped(result.keep_going_rows, "the native front end finished without an entry") }
        .LostEntry -> { return jet_bootstrap_native_escaped(result.keep_going_rows, "native lowering lost its entry") }
        .Write(what) -> { return jet_bootstrap_native_escaped(result.keep_going_rows, "native feed: {what}") }
        .RuntimeKey(what) -> { return jet_bootstrap_native_escaped(result.keep_going_rows, if runtime_dir == "" -> "native feed requires JET_RUNTIME_PACK" else -> "native feed: {what}") }
        .Runtime(what) -> { return jet_bootstrap_native_escaped(result.keep_going_rows, "native feed: {what}") }
        .Foreign(message) -> { return jet_bootstrap_native_escaped(result.keep_going_rows, "native feed cannot realize C dependencies: {message}") }
    }
    jet_bootstrap_native_census(^result, census)
}

// A native-feed failure that escaped every compile stage. It is the
// result's internal problem (the host receipt and stderr report it) and,
// under JET_KEEP_GOING, one more census row after the front end's own, so
// collect-all never loses it.
fn jet_bootstrap_native_escaped(rows: [String], message: String) -> JetDriverCompileResult Never! {
    if !jet_cli_keep_going_enabled() -> return jet_driver_compile_escaped_failure(message)
    census := rows
    &census.push("native\t-\tESCAPED\t{message.replace("\t", " ").replace("\n", " ")}\t-")
    problem :: jet_cli_keep_going_report(census) ?? return jet_driver_compile_escaped_failure("{message}; the compiler failure census writer failed")
    if problem != "" -> return jet_driver_compile_escaped_failure("{message}; {problem}")
    jet_driver_compile_escaped_failure(message)
}

// The result with the native census rows after its own; a compile with any
// row is incomplete, and JET_KEEP_GOING_REPORT is rewritten with every row.
// With no row (always without JET_KEEP_GOING) the result is unchanged.
fn jet_bootstrap_native_census(result: ^JetDriverCompileResult, census: [String]) -> JetDriverCompileResult Never! {
    if census.len() == 0 -> return result
    kept := ^result
    loop row in census -> &kept.keep_going_rows.push(row)
    kept.complete = false
    problem :: jet_cli_keep_going_report(kept.keep_going_rows) ?? return jet_driver_compile_escaped_failure("the compiler failure census writer failed")
    if problem != "" -> return jet_driver_compile_escaped_failure(problem)
    kept
}

fn jet_bootstrap_compile(request: ^JetDriverCompileRequest) -> JetDriverCompileResult Never! {
    if cli_sys.get("JET_FRONT_LIBRARY_OBJECT_OUTPUT") == .Val(prefix) -> return jet_bootstrap_library_object(^request, prefix)
    if cli_sys.get("JET_FRONT_NATIVE_OUTPUT") == .Val(prefix) -> return jet_bootstrap_native(^request, prefix)
    if cli_sys.get("JET_FRONT_MIR_OUTPUT") != None -> return jet_bootstrap_mir(^request)
    jet_cli_compile_request(^request, true) ?? jet_driver_compile_escaped_failure("the compiler driver failed outside every compile stage")
}

// Checked private accessor, invoked by the outer static host using this
// factory's callable metadata. A factory may not reuse the base's schema walk.
fn jet_bootstrap_core_prepare(request: ^JetDriverCompileRequest) -> JetDriverCoreLibraryPreparation Never! {
    jet_driver_prepare_core_library(^request) ?? JetDriverCoreLibraryPreparation.CompileRefused{compilation: jet_driver_compile_escaped_failure("the canonical Core library producer failed outside every compile stage")}
}


fn jet_bootstrap_core_request(template: ^JetDriverCompileRequest, rows: [JetDriverCoreSource]) -> JetDriverCompileRequest Never! {
    jet_driver_core_library_request(^template, rows)
}

fn jet_bootstrap_core_parent_new(rows: ^[JetDriverCoreSource], runtime: ^CoreSharedParentRuntime) -> JetDriverCoreSourceParentHost Never! {
    jet_driver_core_source_parent_new(^rows, ^runtime)
}

fn jet_bootstrap_core_attach(host: &JetDriverCoreSourceParentHost, preparation: JetDriverCoreLibraryPreparation) -> String Never! {
    jet_driver_core_source_parent_attach(&host, preparation)
}

fn jet_bootstrap_core_getter(host: &JetDriverCoreSourceParentHost, site_key: String) -> CoreSharedParentGetterResult Never! {
    jet_driver_core_source_parent_getter(&host, site_key)
}

fn jet_bootstrap_core_runtime_abis(tree: Dyn) -> [String:CoreSharedRuntimeExportABI]? Never! {
    core_shared_runtime_export_abis_decode(tree)
}
