// Private source-coupled bootstrap entry. This file is included only when the
// compiler aggregate is linked with its native host glue; it is not a user
// package surface and is intentionally outside the public source inventory.
//
// Keep the boundary typed: the request owns its selected target and Eval config.
// The native host installs callbacks once, then transfers the complete request.

fn jet_bootstrap_compile(request: ^JetDriverCompileRequest) -> JetDriverCompileResult {
    return jet_driver_compile(request)
}

