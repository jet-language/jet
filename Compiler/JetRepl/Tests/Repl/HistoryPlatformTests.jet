use {
    Compiler.JetRepl.Source.Repl.HistoryHost.[ReplHistoryUnixFlags, repl_history_flags_for_target, repl_history_unix_open_flags]
    core.sys.target.[selected_os, selected_arch, selected_family]
}
// GATE #4483: the test follows selected target facts, never workstation constants.

flags: fn(os: String, arch: String) -> ReplHistoryUnixFlags {
    repl_history_flags_for_target(os, arch) ?? panic("missing ABI table for {os}/{arch}")
}

#Test("selected_unix_open_flags_match_current_target_table") {
    if selected_family() != "unix" -> return
    assert_eq(repl_history_unix_open_flags() ?? panic("selected Unix flags"), flags(selected_os(), selected_arch()))
}

// linux_and_android_open_flag_tables_cover_supported_arches is already registered
// in Tests/Repl/HistoryHost.jet13–41 with all original architectures and values.
// darwin_and_bsd_open_flag_tables_cover_supported_targets is already registered
// in Tests/Repl/HistoryHost.jet43–56 with all original targets and refusals. Do
// not register either canonical test a second time.
