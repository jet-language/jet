use core.sys as repl_history_test_sys
use core.files as repl_history_test_files
use core.process as repl_history_test_process
use core.time as repl_history_test_time
use core.files.runtime.kernel_path_components as repl_history_test_paths

// Independent codec/retention claims. None substitutes for the original real
// filesystem/REPL claims below or the canonical H1/H2 security tests.
#Test("history_hex_roundtrip_is_exact_utf8_and_rejects_invalid_records") {
    controls :: String.from_bytes([U8]{10, 13, 9, 0}) ?? panic("valid ASCII controls")
    carriage_return :: String.from_bytes([U8]{13}) ?? panic("valid ASCII carriage return")
    texts :: [String]{"", "answer :: 42", controls, "é界🙂", "first\nsecond"}
    loop text in texts {
        encoded :: repl_history_encode(text)
        assert_eq(repl_history_decode(encoded.bytes()) ?? panic("valid record rejected"), text)
    }
    assert_eq(repl_history_encode("A\né"), "410ac3a9")
    assert_eq(repl_history_decode("C3A9".bytes()) ?? panic("upper hex"), "é")
    invalid_records :: [String]{"0", "abc", "zz", "00 1", "0x41", "41{carriage_return}", "80", "c080", "eda080", "f4908080", "e282"}
    loop encoded in invalid_records -> assert(repl_history_decode(encoded.bytes()) == None)
    assert(repl_history_decode([U8]{255, 255}) == None)
}

#Test("history_tail_recovery_keeps_only_preceding_complete_records") {
    prefix :: repl_history_render([String]{"first", "", "界\nsecond"})
    recovered :: repl_history_load_bytes(prefix)
    assert_eq(recovered.entries, [String]{"first", "", "界\nsecond"})
    assert(!recovered.corrupt)
    // Stop at FIRST malformed record, even if a later record is valid.
    carriage_return :: String.from_bytes([U8]{13}) ?? panic("valid ASCII carriage return")
    invalid_tails :: [String]{"broken-tail", "0\n", "zz\n", "80\n", "c080\n", "eda080\n", "e282\n", "f4908080\n", "41{carriage_return}\n"}
    loop tail in invalid_tails {
        bytes := ~prefix
        loop byte in tail.bytes() -> &bytes.push(byte)
        loop byte in "6c61746572\n".bytes() -> &bytes.push(byte)
        loaded :: repl_history_load_bytes(bytes)
        assert(loaded.corrupt)
        assert_eq(loaded.entries, recovered.entries)
    }
    incomplete := ~prefix
    loop byte in "41".bytes() -> &incomplete.push(byte)
    unterminated :: repl_history_load_bytes(incomplete)
    assert(unterminated.corrupt)
    assert_eq(unterminated.entries, recovered.entries)
    empty :: repl_history_load_bytes([U8]{})
    assert(empty.entries.is_empty())
    assert(!empty.corrupt)
    empty_record :: repl_history_load_bytes([U8]{10})
    assert_eq(empty_record.entries, [String]{""})
    assert(!empty_record.corrupt)
}

#Test("history_limit_parser_preserves_bounded_usize_grammar") {
    max32 :: U64{4294967295}
    max64 :: U64.MAX
    assert_eq(repl_history_parse_limit("2000", max64) ?? -1, 2000)
    assert_eq(repl_history_parse_limit("+0002", max64) ?? -1, 2)
    assert_eq(repl_history_parse_limit("0", max64) ?? -1, 0)
    assert_eq(repl_history_parse_limit("4294967295", max32) ?? -1, 4294967295)
    assert_eq(repl_history_parse_limit("18446744073709551615", max64) ?? -1, 18446744073709551615)
    assert(repl_history_parse_limit("4294967296", max32) == None)
    invalid_limits :: [String]{"", "+", "-0", "-1", " 2", "2 ", "2\n", "1_000", "2.0", "２", "18446744073709551616", "999999999999999999999999999999999999999999"}
    loop raw in invalid_limits -> assert(repl_history_parse_limit(raw, max64) == None)
}

#Test("history_off_is_only_exact_ascii_insensitive_off") {
    disabled :: [String]{"off", "OFF", "Off", "oFf"}
    enabled :: [String]{"", "0", "false", " off", "off ", "off\n", "oﬀ", "öFF"}
    loop raw in disabled -> assert(repl_history_disabled(raw))
    loop raw in enabled -> assert(!repl_history_disabled(raw))
}

#Test("history_trim_preserves_newest_order_and_zero_clears_loaded_rows") {
    entries := [String]{"a", "b", "c", "d"}
    repl_history_trim(&entries, 2)
    assert_eq(entries, [String]{"c", "d"})
    repl_history_trim(&entries, 2)
    assert_eq(entries, [String]{"c", "d"})
    repl_history_trim(&entries, 10)
    assert_eq(entries, [String]{"c", "d"})
    repl_history_trim(&entries, 0)
    assert(entries.is_empty())
}

// Native path owner + var_os ingress are not available in this worktree's
// published Core graph yet. Preserve full precedence/authority assertions;
// never replace these with Core.files.Path's normalizing textual semantics.
fn history_state_root_preserves_os_precedence_and_relative_xdg_refusal() Never! {
    unix :: repl_history_test_paths.PathPlatform.Unix
    windows :: repl_history_test_paths.PathPlatform.Windows
    home :: repl_history_test_paths.from_text("/home/user", unix)
    xdg :: repl_history_test_paths.from_text("/state", unix)
    chosen :: repl_history_state_root_for("linux", Val(~xdg), None, Val(~home)) ?? panic("XDG root")
    assert_eq(chosen.encoded, xdg.encoded)
    relative :: repl_history_test_paths.from_text("relative", unix)
    assert(repl_history_state_root_for("linux", Val(~relative), None, Val(~home)) == None)
    empty :: repl_history_test_paths.from_text("", unix)
    fallback :: repl_history_state_root_for("linux", Val(~empty), None, Val(~home)) ?? panic("HOME root")
    assert_eq(fallback.encoded, "/home/user/.local/state".bytes())
    assert(repl_history_state_root_for("linux", None, None, Val(~relative)) == None)
    assert(repl_history_state_root_for("linux", None, None, None) == None)
    mac :: repl_history_state_root_for("macos", None, None, Val(~relative)) ?? panic("macOS HOME")
    assert_eq(mac.encoded, "relative/Library/Application Support".bytes())
    local :: repl_history_test_paths.from_text("C:\\Users\\user\\AppData\\Local", windows)
    win_home :: repl_history_test_paths.from_text("C:\\Users\\user", windows)
    win :: repl_history_state_root_for("windows", None, Val(~local), Val(~win_home)) ?? panic("LOCALAPPDATA")
    assert_eq(win.encoded, local.encoded)
    empty_local :: repl_history_test_paths.from_text("", windows)
    win_empty :: repl_history_state_root_for("windows", None, Val(~empty_local), Val(~win_home)) ?? panic("empty LOCALAPPDATA is present")
    assert(win_empty.encoded.is_empty())
    win_relative :: repl_history_test_paths.from_text("C:relative", windows)
    assert(repl_history_state_root_for("windows", Val(~win_relative), Val(~local), Val(~win_home)) == None)
    // OS spelling must survive without a lossy or failed UTF8 conversion.
    raw :: repl_history_test_paths.from_encoded([U8]{47, 255}, unix)
    exact :: repl_history_state_root_for("linux", Val(~raw), None, None) ?? panic("native bytes")
    assert_eq(exact.encoded, raw.encoded)
}

// These exercise the actual ReplHistory owner, never a reduced mock struct.
// Full activation depends on H1/H2 resource definitions / #4494 bindings.
fn history_session_record_search_clear_preserves_order_and_duplicates() -[FS, Time, Time.Wait]> Never! {
    history := ReplHistory.fallback(3)
    defer close(^history)
    assert(&history.record("old") == None)
    assert(&history.record("alpha") == None)
    assert(&history.record("β alpha") == None)
    assert(&history.record("alpha") == None)
    index := 0
    loop row in history.entries() {
        expected :: [String]{"alpha", "β alpha", "alpha"}
        assert_eq(row, expected[index])
        index += 1
    }
    assert_eq(index, 3)
    matches :: history.search("alpha")
    assert_eq(matches.len(), 3)
    assert_eq(matches[0][0], "alpha")
    assert_eq(matches[1][0], "β alpha")
    assert_eq(matches[2][0], "alpha")
    assert(history.search("ALPHA").is_empty())
    assert_eq(history.search("").len(), 3)
    &history.clear() ?? panic("session clear")
    assert(history.search("").is_empty())
    assert(&history.record("") == None)
    assert_eq(history.search("")[0][0], "")
}

fn history_zero_limit_record_is_noop_but_clear_still_clears() -[FS, Time, Time.Wait]> Never! {
    history := ReplHistory.fallback(0)
    defer close(^history)
    assert(&history.record("not retained") == None)
    assert(history.search("").is_empty())
    &history.clear() ?? panic("zero clear")
    assert(history.search("").is_empty())
}

fn history_default_session_retains_two_thousand_newest_submissions() -[FS, Time, Time.Wait]> Never! {
    history := ReplHistory.session_only()
    defer close(^history)
    loop index in 0..<2001 -> assert(&history.record("submission-{index}") == None)
    index := 1
    loop row in history.entries() {
        expected :: "submission-{index}"
        assert_eq(row, expected)
        index += 1
    }
    assert_eq(index, 2001)
    assert(history.search("submission-0").is_empty())
}

// Native-only ORIGINAL claims stay unregistered until #4494/H1/H2 + the real
// Jet REPL binary/runtime process provider land. ToolsLead agreed sole test
// mapping: HistoryHost.jet owns History.rs273 replacement/290 timeout and
// tests/repl171 symlink/203 parent-swap; this file owns the other five originals.
// No facade, mock store, path-lock, skipped assertion, or fake empty proof.

// Shared canonical helpers used by native HistoryHost tests as well.
pub fn repl_history_test_process_spec(state: String) -[Env, Exec]> ProcessSpec Never! {
    binary :: repl_history_test_sys.get("JET_REPL_BIN") ?? panic("JET_REPL_BIN must name the actual Jet REPL executable")
    repl_history_test_process.cmd([String]{binary, "repl"})
        .env("XDG_STATE_HOME", state)
        .env_remove("JET_REPL_HISTORY")
        .env("NO_COLOR", "1")
        .stdin(.Stream).stdout(.Capture).stderr(.Capture)
}

pub fn repl_history_test_spawn_process(state: String) -[Env, Exec, Time.Wait]> ProcessChild IOError! {
    repl_history_test_process_spec(state).spawn()
}

pub fn repl_history_test_run_process(state: String, input: String, limit: String?) -[Env, Exec, Time.Wait]> ProcessReceipt IOError! {
    spec := repl_history_test_process_spec(state)
    if limit == .Val(value) -> spec = spec.env("JET_REPL_HISTORY_LIMIT", value)
    child :: spec.spawn() ?? return Err(err)
    child.stdin.write(input) ?? return Err(err)
    // wait_with_output closes stdin before waiting in the Rust original.
    child.stdin.close() ?? return Err(err)
    child.wait() ?? return Err(err)
}

pub fn repl_history_test_wait_for_dir(state: String) -[FS, Time]> IOError! {
    deadline :: repl_history_test_time.instant() + 2s
    loop !repl_history_test_files.is_dir("{state}/jet") {
        assert(repl_history_test_time.instant() < deadline, "history directory was not opened")
        repl_history_test_time.sleep(10ms)
    }
    repl_history_test_time.sleep(50ms)
    Ok()
}

fn repl_history_test_root(tag: String) -[Env]> String Never! {
    "{repl_history_test_sys.temp_dir()}/jet_repl_history_{tag}_{repl_history_test_process.current_pid()}"
}

fn repl_history_test_remove_root(state: String) -[FS]> Never! {
    repl_history_test_files.remove_all(state).drop("original best-effort remove_dir_all")
}

// tests/repl.rs65–101, exact submissions and success/search/privacy/unlink law.
fn repl_history_persists_only_successes_searches_clears_and_is_private() -[Env, Exec, FS, Time.Wait]> Never! {
    state :: repl_history_test_root("persist")
    repl_history_test_remove_root(state)
    first :: repl_history_test_run_process(state, "answer :: 42\nmissing_name\n:quit\n", None) ?? panic("first session")
    assert(first.success, "first session")
    history :: "{state}/jet/repl-history"
    stored :: repl_history_test_files.read(history) ?? panic("history file")
    lines := 0
    loop byte in stored.bytes() {
        if byte == (U8{10}) -> lines += 1
    }
    assert_eq(lines, 1, "failed turn persisted")
    if repl_history_test_sys.family() == "unix" -> assert_eq((repl_history_test_files.stat(history) ?? panic("history metadata")).mode & 511, 384)
    second :: repl_history_test_run_process(state, ":history search answer\n:history search missing\n:history clear\n:quit\n", None) ?? panic("second session")
    assert(second.output.contains("answer :: 42"), "search output")
    assert(second.output.contains("No history matches."), "failed turn was searchable")
    assert(second.output.contains("History cleared."), "clear output")
    assert(!repl_history_test_files.exists(history), "clear must erase whole file")
    repl_history_test_remove_root(state)
}

// tests/repl.rs104–134, no literal fake stored history or fake warning.
fn repl_history_limit_and_corrupt_tail_recover_visibly() -[Env, Exec, FS, Time.Wait]> Never! {
    state :: repl_history_test_root("tail")
    repl_history_test_remove_root(state)
    first :: repl_history_test_run_process(state, "1 + 1\n2 + 2\n3 + 3\n:quit\n", Val("2")) ?? panic("first session")
    assert(first.success)
    history :: "{state}/jet/repl-history"
    repl_history_test_files.append_all(history, "broken-tail") ?? panic("append corrupt tail")
    second :: repl_history_test_run_process(state, ":history search +\n:quit\n", Val("2")) ?? panic("second session")
    assert(!second.output.contains("1 + 1"), "retention exceeded")
    assert(second.output.contains("2 + 2") && second.output.contains("3 + 3"), "retained entries missing")
    assert(second.errors.contains("corrupt history tail") && second.errors.contains("discarded"), "warning missing")
    assert(!(repl_history_test_files.read(history) ?? panic("repaired history")).contains("broken-tail"))
    repl_history_test_remove_root(state)
}

// tests/repl.rs137–167.
fn repl_history_off_is_session_only_and_visible_storage_failure_falls_back() -[Env, Exec, FS, Time.Wait]> Never! {
    state :: repl_history_test_root("off")
    repl_history_test_remove_root(state)
    child :: repl_history_test_process_spec(state).env("JET_REPL_HISTORY", "off").spawn() ?? panic("off session")
    child.stdin.write("8 + 9\n:history search 8\n:quit\n") ?? panic("off stdin")
    child.stdin.close() ?? panic("off stdin close")
    output :: child.wait() ?? panic("off wait")
    assert(output.output.contains("8 + 9"))
    assert(!repl_history_test_files.exists("{state}/jet/repl-history"))
    blocked :: "{state}/blocked"
    repl_history_test_files.create_dir_all(state) ?? panic("state directory")
    repl_history_test_files.write(blocked, "not a directory") ?? panic("blocked file")
    fallback :: repl_history_test_run_process(blocked, ":quit\n", None) ?? panic("fallback session")
    assert(fallback.errors.contains("session-only history"))
    repl_history_test_remove_root(state)
}

// tests/repl.rs242–295, actual parallel writes to TWO actual child processes,
// followed by clear while a third actual child retains a stale session snapshot.
fn repl_history_two_processes_merge_and_clear_cannot_resurrect() -[Env, Exec, FS, Time, Time.Wait]> Never! {
    state :: repl_history_test_root("tx")
    repl_history_test_remove_root(state)
    first :: repl_history_test_spawn_process(state) ?? panic("first child")
    second :: repl_history_test_spawn_process(state) ?? panic("second child")
    repl_history_test_wait_for_dir(state) ?? panic("history startup")
    first_stdin :: first.stdin
    second_stdin :: second.stdin
    writer_a :: task ^first_stdin {
        first_stdin.write("left_marker :: 1\n:quit\n") ?? panic("left writer")
    }
    writer_b :: task ^second_stdin {
        second_stdin.write("right_marker :: 2\n:quit\n") ?? panic("right writer")
    }
    ^writer_a.join() ?? panic("left writer join")
    ^writer_b.join() ?? panic("right writer join")
    assert((first.wait() ?? panic("first wait")).success)
    assert((second.wait() ?? panic("second wait")).success)
    merged :: repl_history_test_run_process(state, ":history search left_marker\n:history search right_marker\n:quit\n", None) ?? panic("merged session")
    assert(merged.output.contains("left_marker :: 1") && merged.output.contains("right_marker :: 2"), "lost update")
    stale :: repl_history_test_spawn_process(state) ?? panic("stale child")
    repl_history_test_wait_for_dir(state) ?? panic("stale startup")
    cleared :: repl_history_test_run_process(state, ":history clear\n:quit\n", None) ?? panic("clear session")
    assert(cleared.success)
    stale.stdin.write("fresh_marker :: 3\n:quit\n") ?? panic("fresh writer")
    assert((stale.wait() ?? panic("stale wait")).success)
    after :: repl_history_test_run_process(state, ":history search left_marker\n:history search right_marker\n:history search fresh_marker\n:quit\n", None) ?? panic("after session")
    assert(after.output.contains("fresh_marker :: 3"), "fresh write missing")
    assert(!after.output.contains("left_marker :: 1") && !after.output.contains("right_marker :: 2"), "clear resurrected history")
    repl_history_test_remove_root(state)
}

// tests/repl.rs299–341: same timed F3+query+submit sequence under a REAL PTY.
// No fixture/string assertion pretending the live raw editor ran.
fn repl_raw_f3_search_recalls_and_submits_persistent_history() -[Env, Exec, FS, Time.Wait]> Never! {
    state :: repl_history_test_root("f3")
    repl_history_test_remove_root(state)
    assert((repl_history_test_run_process(state, "3 + 3\n:quit\n", None) ?? panic("seed session")).success)
    binary :: repl_history_test_sys.get("JET_REPL_BIN") ?? panic("JET_REPL_BIN must name the actual Jet REPL executable")
    shell :: "\n{{\n  sleep 0.2\n  printf '\\033OR'\n  sleep 0.1\n  printf '3 +\\r'\n  sleep 0.1\n  printf '\\r'\n  sleep 0.2\n  printf ':quit\\r'\n}} | script -qec '\"$JET_REPL_BIN\" repl' /dev/null\n"
    output :: repl_history_test_process.cmd([String]{"sh", "-c", shell})
        .env("JET_REPL_BIN", binary).env("XDG_STATE_HOME", state)
        .env_remove("JET_REPL_HISTORY").env("NO_COLOR", "1")
        .stdout(.Capture).stderr(.Capture).run() ?? panic("run raw REPL under PTY")
    assert(output.success, "PTY status")
    assert(output.output.contains("history search>"), "F3 did not open search")
    assert(output.output.contains("6 : Int"), "recalled submission did not execute")
    repl_history_test_remove_root(state)
}
