// Rust: crates/jet-repl/src/lib.rs:4089
#Test("repl_temp_writer_rejects_unsupported_unix") {
    os :: repl_turn_test_target.selected_os()
    if repl_turn_test_target.selected_family() == .Unix && os != .Linux && os != .Android && os != .MacOS && os != .IOS {
        path := repl_turn_test_files.temp_dir()
        repl_turn_test_paths.push(&path, repl_turn_test_paths.from_text("jet-repl-unsupported-{repl_turn_test_process.id()}.jet", path.platform))
        result :: write_temp_file_at(path, "must not be written\n")
        error :: if result == { .Err(error) -> error, .Ok(_) -> panic("unsupported Unix target must fail closed") }
        assert_eq(error.kind(), .Unsupported) // GATE #4409: exact IO kind.
    }
}
// Rust: crates/jet-repl/src/lib.rs:4099
#Test("sigil_binding_is_classified_as_statement") {
    kind :: classify("t :: s", 1) ?? panic("classify")
    if kind == {
        .Stmts(stmts, suppress, check_src) -> {
            assert(!suppress)
            assert_eq(check_src, "t :: s;")
            assert_eq(stmts.len(), 1)
            assert(if stmts[0] == { .Val(_) -> true, _ -> false })
        }
        _ -> panic("expected statement input")
    }
}
// Rust: crates/jet-repl/src/lib.rs:4112
#Test("sigil_binding_from_string_session_name_marks_move") {
    kind :: classify("t :: s", 1) ?? panic("classify")
    stmts :: if kind == { .Stmts(stmts, _, _) -> stmts, _ -> panic("expected statement input") }
    names := Set<String>.new()
    _ :: &names.insert("s")
    scope := [String:CtValue]{}
    scope["s"] = CtValue.Str("hello")
    moved :: collect_moved_names(stmts, names, scope)
    assert(moved.contains("s"))
}
// Rust: crates/jet-repl/src/lib.rs:4126
#Test("bare_binding_is_preserved_as_an_exact_statement") {
    kind :: classify("s :: \"\"", 1) ?? panic("classify")
    if kind == {
        .Stmts(stmts, _, check_src) -> {
            assert_eq(check_src, "s :: \"\";")
            assert_eq(stmts.len(), 1)
            assert(if stmts[0] == { .Val(_) -> true, _ -> false })
        }
        _ -> panic("expected statement input")
    }
}
// Rust: crates/jet-repl/src/lib.rs:4136
#Test("notebook_item_classifier_uses_the_parser_item_plane") {
    assert(is_item_input("@answer :: 42"))
    assert(is_item_input("#Test(\"answer\") { assert(true) }"))
    assert(!is_item_input("answer :: 42"))
}
// Rust: crates/jet-repl/src/lib.rs:4143
#Test("raw_multiline_completeness_comes_from_repl_parser_shapes") {
    assert(raw_input_is_complete("40 + 2"))
    assert(raw_input_is_complete("answer :: = 42"))
    assert(!raw_input_is_complete("40 +"))
    assert(!raw_input_is_complete("answer ::"))
    assert(!raw_input_is_complete("fn total(xs: [Int]) -> Int {"))
    assert(!raw_input_is_complete("if true {\n    1"))
    assert(!raw_input_is_complete("/* unfinished"))
    assert(!raw_input_is_complete("\"\"\"\nunfinished"))
    assert(raw_input_is_complete("\"single-line text\ncan't continue"))
}
