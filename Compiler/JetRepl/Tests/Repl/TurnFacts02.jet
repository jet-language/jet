use jet_comptime.[ReplEffectRequest]
use jet_foundation.[authority_parse_right, authority_answer, ApplicationAuthority, AuthorityVerdict, Span]
use jetpack_foundation.[Holds]
use jet_driver.Package as repl_turn_test_package
use jet_driver.EffectBudget as repl_turn_test_budget
use jet_sema.Effects as repl_turn_test_effects
use core.files.host.retained_descriptor as repl_turn_test_files
use core.files.runtime.kernel_path_components as repl_turn_test_paths
use core.process.host.native_process as repl_turn_test_process
use core.sys.target as repl_turn_test_target
use std.os.unix.fs.[symlink] // GATE #4494: native symlink primitive.

// Rust: crates/jet-repl/src/lib.rs:3937
struct CountingPrompt { count: Int }
// Rust: crates/jet-repl/src/lib.rs:3940
impl CountingPrompt.EffectPrompt {
    fn choose(&self, _: ReplEffectRequest, _: Bool) -> PromptChoice {
        self.count = self.count + 1
        PromptChoice.Once
    }
}
// Rust: crates/jet-repl/src/lib.rs:3947
#Test("unavailable_handle_backend_denies_before_prompt_or_operation") {
    root := repl_turn_test_files.temp_dir()
    repl_turn_test_paths.push(&root, repl_turn_test_paths.from_text("jet_repl_unavailable_backend_{repl_turn_test_process.id()}", root.platform))
    repl_turn_test_files.create_dir_all(root) ?? panic("create root")
    target := ~root
    repl_turn_test_paths.push(&target, repl_turn_test_paths.from_text("must-not-exist.txt", root.platform))
    policy := ReplPolicy.new(ReplFlags.default(), root)
    policy.handles_available = false
    prompt := CountingPrompt{count: 0}
    request :: ReplEffectRequest{root: "FS", operation: "Write", resource: "must-not-exist.txt"}
    {
        authorization := &policy.authorizer(Val(&prompt))
        result :: &authorization.preflight(request, Span.new(0, 1))
        error :: if result == { .Err(error) -> error, .Ok(_) -> panic("unavailable confinement backend must fail closed") }
        assert_eq(error.code, "E1803")
        assert(error.why.contains("no runtime authority was offered"))
    }
    assert_eq(prompt.count, 0)
    assert(!repl_turn_test_files.exists(target))
    _ :: repl_turn_test_files.remove_dir_all(root)
}
// Rust: crates/jet-repl/src/lib.rs:3982
#Test("authority_answer_matches_compile_build_session_and_repl") {
    written :: "IO"
    external_spelling :: "io"
    expected :: authority_parse_right(written) ?? panic("known right")
    assert_eq(expected, "IO")
    compile :: repl_turn_test_effects.parse_effect_name(external_spelling) ?? panic("compile right")
    assert_eq(compile, expected)
    assert(repl_turn_test_effects.effect_covers(written, expected))
    authority := repl_turn_test_package.PackageAuthority.default()
    authority.holds = repl_turn_test_package.Blocks.AuthorityHolds{allow: Val([String]{external_spelling}), deny: None}
    manifest := repl_turn_test_package.PackageFacts.default()
    manifest.effects_enabled = true
    manifest.authority = ^authority
    entries :: [repl_turn_test_budget.PackageEffects]{repl_turn_test_budget.PackageEffects{
        name: "dependency", effects: Holds.from([String]{expected}), effect_sites: [:], panic_sites: [], boundary_span: None,
    }}
    assert(repl_turn_test_budget.enforce(entries, manifest).is_empty())
    assert_eq(repl_turn_test_budget.provenance_for(entries, "dependency"), [String]{expected})
    session :: authority_answer(ApplicationAuthority{allowed: [String]{external_spelling}, denied: []}, written)
    assert_eq(session, AuthorityVerdict.Allowed)
    flags :: ReplFlags.new([String]{external_spelling}, [])
    assert(flags.allow.contains(expected))
    policy := ReplPolicy.new(flags, native_path("."))
    request :: ReplEffectRequest{root: expected, operation: "Read", resource: "authority-substrate"}
    authorization := &policy.authorizer(None)
    &authorization.preflight(request, Span.new(0, 1)) ?? panic("repl preflight")
    &authorization.authorize(request, Span.new(0, 1)) ?? panic("repl authority")
}
// Rust: crates/jet-repl/src/lib.rs:4049
#Test("repl_temp_writer_rejects_existing_symlink") {
    if repl_turn_test_target.selected_family() == .Unix {
        root := repl_turn_test_files.temp_dir()
        repl_turn_test_paths.push(&root, repl_turn_test_paths.from_text("jet-repl-temp-symlink-{repl_turn_test_process.id()}", root.platform))
        _ :: repl_turn_test_files.remove_dir_all(root)
        repl_turn_test_files.create_dir_all(root) ?? panic("create root")
        target := ~root
        repl_turn_test_paths.push(&target, repl_turn_test_paths.from_text("outside.txt", root.platform))
        link := ~root
        repl_turn_test_paths.push(&link, repl_turn_test_paths.from_text("session.jet", root.platform))
        repl_turn_test_files.write(target, "must survive\n".bytes()) ?? panic("write target")
        symlink(target, link) ?? panic("symlink")
        assert(write_temp_file_at(link, "attacker\n").is_err())
        assert_eq(repl_turn_test_files.read_to_string(target) ?? panic("read target"), "must survive\n")
        _ :: repl_turn_test_files.remove_dir_all(root)
    }
}
