//RS             // comment — skip
//RS         } else if let Some(input) = line.strip_prefix("> ") {
//RS             inputs.push(input.to_string());
//RS         } else {
//RS             // expected output line (may be blank)
//RS             expected.push(line.to_string());
//RS         }
//RS     }
//RS     (inputs, expected)
