use jet.REPL.[ReplTurn, ReplTurnStatus]

fixture_turn: fn(id: USize, input: &String, had_effect: Bool, bound_name: String?) -> ReplTurn {
    ReplTurn {
        id: id,
        input: input.to_string(),
        summary: String.new(),
        status: ReplTurnStatus.Ok,
        folded: false,
        pinned: false,
        stale: false,
        had_effect: had_effect,
        bound_name: bound_name.map(name -> name.to_string()),
        pending_unfold: none
    }
}
// Original tests are registered in Repl02Tests.jet.
