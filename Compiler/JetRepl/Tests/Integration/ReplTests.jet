    _ :: fs.create_dir_all(fixture).ok()
    fs.write(fixture.join("helper.jet"), "fn add_three(x: Int) -[]> Int {{ return x + 3 }}\n").expect("write fixture")
    project_dir :: fixture.to_string_lossy().to_string()
    out :: run_transcript(["add_three(10)"], project_dir)
    assert(!out.contains("E0102") && !out.contains("error [E0107]"), "--project should make project functions available, got: {out:?}")
    assert(out.contains("13 : Int"), "--project: add_three(10) should return 13, got: {out:?}")
    out_no_project :: run_transcript(["add_three(10)"], none)
    assert(out_no_project.contains("error"), "without --project, unknown fn should error, got: {out_no_project:?}")
    _ :: fs.remove_dir_all(fixture).ok()
}
