use Compiler.JetRepl.Tests.Integration.Repl.[run_repl_process, spawn_repl_process, wait_for_history_dir, run_raw_multiline_pty, run_transcript_file, run_transcript_file_strict, run_transcript_file_strict_with_flags]
use jet.REPL.[run_transcript, run_transcript_with_flags]
use std.[fs, env, process, thread]
use std.io.[Write]
use std.process.[Command, Stdio]
use std.os.unix.fs.[symlink, PermissionsExt]
use std.time.[Duration, Instant, SystemTime, UNIX_EPOCH]
use core.sys.target.[selected_family, selected_os]
// GATE #4494: real subprocess/PTY/thread/retained-filesystem behavior.
// GATE #4483: cfg(unix)/cfg(linux) use selected target facts.

// Rust: tests/repl.rs:65
#Test("repl_history_persists_only_successes_searches_clears_and_is_private") {
    state :: env.temp_dir().join("jet_repl_history_{process.id()}")
    _ :: fs.remove_dir_all(state).ok()
    first :: run_repl_process(state, "answer :: 42\nmissing_name\n:quit\n".as_bytes(), none)
    assert(first.status.success(), "first session: {first.status:?}")
    history :: state.join("jet/repl-history")
    stored :: fs.read_to_string(history).expect("history file")
    assert_eq(stored.lines().count(), 1, "failed turn persisted: {stored:?}")
    if selected_family() == "unix" {
        assert_eq(fs.metadata(history).unwrap().permissions().mode() & 0o777, 0o600)
    }
    second :: run_repl_process(state, ":history search answer\n:history search missing\n:history clear\n:quit\n".as_bytes(), none)
    out :: String.from_utf8_lossy(second.stdout)
    assert(out.contains("answer :: 42"), "search output: {out:?}")
    assert(out.contains("No history matches."), "failed turn was searchable: {out:?}")
    assert(out.contains("History cleared."), "clear output: {out:?}")
    assert(!history.exists(), "clear must erase whole file")
    _ :: fs.remove_dir_all(state).ok()
}

// Rust: tests/repl.rs:104
#Test("repl_history_limit_and_corrupt_tail_recover_visibly") {
    state :: env.temp_dir().join("jet_repl_history_tail_{process.id()}")
    _ :: fs.remove_dir_all(state).ok()
    first :: run_repl_process(state, "1 + 1\n2 + 2\n3 + 3\n:quit\n".as_bytes(), "2")
    assert(first.status.success())
    history :: state.join("jet/repl-history")
    fs.OpenOptions.new().append(true).open(history).unwrap().write_all("broken-tail".as_bytes()).unwrap()
    second :: run_repl_process(state, ":history search +\n:quit\n".as_bytes(), "2")
    out :: String.from_utf8_lossy(second.stdout)
    err :: String.from_utf8_lossy(second.stderr)
    assert(!out.contains("1 + 1"), "retention exceeded: {out:?}")
    assert(out.contains("2 + 2") && out.contains("3 + 3"), "retained entries missing: {out:?}")
    assert(err.contains("corrupt history tail") && err.contains("discarded"), "warning missing: {err:?}")
    assert(!fs.read_to_string(history).unwrap().contains("broken-tail"))
    _ :: fs.remove_dir_all(state).ok()
}

// Rust: tests/repl.rs:137
#Test("repl_history_off_is_session_only_and_visible_storage_failure_falls_back") {
    state :: env.temp_dir().join("jet_repl_history_off_{process.id()}")
    _ :: fs.remove_dir_all(state).ok()
    child := Command.new(OSPath.from(env.binary_path("jet"))).arg("repl").env("XDG_STATE_HOME", state).env("JET_REPL_HISTORY", "off").env("NO_COLOR", "1").stdin(Stdio.piped()).stdout(Stdio.piped()).spawn().unwrap()
    child.stdin.as_mut().unwrap().write_all("8 + 9\n:history search 8\n:quit\n".as_bytes()).unwrap()
    output :: child.wait_with_output().unwrap()
    assert(String.from_utf8_lossy(output.stdout).contains("8 + 9"))
    assert(!state.join("jet/repl-history").exists())
    blocked :: state.join("blocked")
    fs.create_dir_all(state).unwrap()
    fs.write(blocked, "not a directory".as_bytes()).unwrap()
    fallback :: run_repl_process(blocked, ":quit\n".as_bytes(), none)
    assert(String.from_utf8_lossy(fallback.stderr).contains("session-only history"))
    _ :: fs.remove_dir_all(state).ok()
}

// Rust: tests/repl.rs:171
#Test("repl_history_rejects_symlinked_state_parent_without_chmod_or_escape") {
    if selected_family() != "unix" -> return
    root :: env.temp_dir().join("jet_repl_history_link_{process.id()}")
    outside :: env.temp_dir().join("jet_repl_history_outside_{process.id()}")
    _ :: fs.remove_dir_all(root).ok()
    _ :: fs.remove_dir_all(outside).ok()
    fs.create_dir_all(root).unwrap()
    fs.create_dir_all(outside).unwrap()
    fs.set_permissions(outside, fs.Permissions.from_mode(0o755)).unwrap()
    symlink(outside, root.join("linked")).unwrap()
    output :: run_repl_process(root.join("linked/state"), "5 + 5\n:quit\n".as_bytes(), none)
    stderr :: String.from_utf8_lossy(output.stderr)
    assert(stderr.contains("session-only history"), "fallback invisible: {stderr:?}")
    assert(!outside.join("state").exists(), "history escaped through state symlink")
    assert_eq(fs.metadata(outside).unwrap().permissions().mode() & 0o777, 0o755)
    _ :: fs.remove_dir_all(root).ok()
    _ :: fs.remove_dir_all(outside).ok()
}

// Rust: tests/repl.rs:203
#Test("repl_history_parent_swap_stays_on_held_directory") {
    if selected_family() != "unix" -> return
    state :: env.temp_dir().join("jet_repl_history_swap_{process.id()}")
    outside :: env.temp_dir().join("jet_repl_history_swap_out_{process.id()}")
    _ :: fs.remove_dir_all(state).ok()
    _ :: fs.remove_dir_all(outside).ok()
    fs.create_dir_all(outside).unwrap()
    child := spawn_repl_process(state)
    wait_for_history_dir(state)
    held :: state.join("held-jet")
    fs.rename(state.join("jet"), held).unwrap()
    symlink(outside, state.join("jet")).unwrap()
    child.stdin.as_mut().unwrap().write_all("4 + 4\n:quit\n".as_bytes()).unwrap()
    output :: child.wait_with_output().unwrap()
    assert(output.status.success())
    assert(!outside.join("repl-history").exists(), "swap redirected history write")
    assert_eq(fs.read_to_string(held.join("repl-history")).unwrap().lines().count(), 1)
    _ :: fs.remove_file(state.join("jet")).ok()
    _ :: fs.remove_dir_all(state).ok()
    _ :: fs.remove_dir_all(outside).ok()
}

// Rust: tests/repl.rs:242
#Test("repl_history_two_processes_merge_and_clear_cannot_resurrect") {
    state :: env.temp_dir().join("jet_repl_history_tx_{process.id()}")
    _ :: fs.remove_dir_all(state).ok()
    first := spawn_repl_process(state)
    second := spawn_repl_process(state)
    wait_for_history_dir(state)
    first_stdin := first.stdin.take().unwrap()
    second_stdin := second.stdin.take().unwrap()
    writer_a :: thread.spawn(move () -> first_stdin.write_all("left_marker :: 1\n:quit\n".as_bytes()))
    writer_b :: thread.spawn(move () -> second_stdin.write_all("right_marker :: 2\n:quit\n".as_bytes()))
    writer_a.join().unwrap().unwrap()
    writer_b.join().unwrap().unwrap()
    assert(first.wait().unwrap().success())
    assert(second.wait().unwrap().success())
    merged_output :: run_repl_process(state, ":history search left_marker\n:history search right_marker\n:quit\n".as_bytes(), none)
    merged :: String.from_utf8_lossy(merged_output.stdout)
    assert(merged.contains("left_marker :: 1") && merged.contains("right_marker :: 2"), "lost update: {merged:?}")
    stale := spawn_repl_process(state)
    wait_for_history_dir(state)
    cleared :: run_repl_process(state, ":history clear\n:quit\n".as_bytes(), none)
    assert(cleared.status.success())
    stale.stdin.as_mut().unwrap().write_all("fresh_marker :: 3\n:quit\n".as_bytes()).unwrap()
    assert(stale.wait().unwrap().success())
    after_output :: run_repl_process(state, ":history search left_marker\n:history search right_marker\n:history search fresh_marker\n:quit\n".as_bytes(), none)
    after :: String.from_utf8_lossy(after_output.stdout)
    assert(after.contains("fresh_marker :: 3"), "fresh write missing: {after:?}")
    assert(!after.contains("left_marker :: 1") && !after.contains("right_marker :: 2"), "clear resurrected history: {after:?}")
    _ :: fs.remove_dir_all(state).ok()
}

// Rust: tests/repl.rs:299
#Test("repl_raw_f3_search_recalls_and_submits_persistent_history") {
    if selected_family() != "unix" -> return
    state :: env.temp_dir().join("jet_repl_history_f3_{process.id()}")
    _ :: fs.remove_dir_all(state).ok()
    assert(run_repl_process(state, "3 + 3\n:quit\n".as_bytes(), none).status.success())
    shell :: "\n{{\n  sleep 0.2\n  printf '\\033OR'\n  sleep 0.1\n  printf '3 +\\r'\n  sleep 0.1\n  printf '\\r'\n  sleep 0.2\n  printf ':quit\\r'\n}} | script -qec '\"$JET_REPL_BIN\" repl' /dev/null\n"
    output :: Command.new("sh").args(["-c", shell]).env("JET_REPL_BIN", env.binary_path("jet")).env("XDG_STATE_HOME", state).env_remove("JET_REPL_HISTORY").env("NO_COLOR", "1").output().expect("run raw REPL under PTY")
    out :: String.from_utf8_lossy(output.stdout)
    assert(output.status.success(), "PTY status: {output.status:?}\n{out}")
    assert(out.contains("history search>"), "F3 did not open search: {out:?}")
    assert(out.contains("6 : Int"), "recalled submission did not execute: {out:?}")
    _ :: fs.remove_dir_all(state).ok()
}

// Rust: tests/repl.rs:361
#Test("repl_raw_enter_uses_parser_completeness_not_bracket_balance") {
    if selected_family() != "unix" -> return
    output :: run_raw_multiline_pty("printf '40 +\\r'; sleep 0.15; printf '2\\r'")
    out :: String.from_utf8_lossy(output.stdout)
    assert(output.status.success(), "PTY status: {output.status:?}\n{out}")
    assert(out.contains("· "), "continuation prompt missing: {out:?}")
    assert(out.contains("42 : Int"), "parser-complete input did not submit: {out:?}")
}

// Rust: tests/repl.rs:378
#Test("repl_raw_escape_enter_forces_newline_then_blank_submits") {
    if selected_family() != "unix" -> return
    output :: run_raw_multiline_pty("printf '40 + 2\\033\\r'; sleep 0.15; printf '\\r'")
    out :: String.from_utf8_lossy(output.stdout)
    assert(output.status.success(), "PTY status: {output.status:?}\n{out}")
    assert(out.contains("· "), "forced newline did not redraw continuation: {out:?}")
    assert(out.contains("42 : Int"), "blank continuation did not submit: {out:?}")
}

// Rust: tests/repl.rs:398
#Test("repl_raw_blank_continuation_force_submits_incomplete_input") {
    if selected_family() != "unix" -> return
    output :: run_raw_multiline_pty("printf '1 +\\r'; sleep 0.15; printf '\\r'")
    out :: String.from_utf8_lossy(output.stdout)
    assert(output.status.success(), "PTY status: {output.status:?}\n{out}")
    assert(out.contains("E0003"), "blank continuation kept waiting: {out:?}")
}

// Rust: tests/repl.rs:414
#Test("repl_raw_multiline_redraw_keeps_second_line_editable") {
    if selected_family() != "unix" -> return
    output :: run_raw_multiline_pty("printf '10 +\\r'; sleep 0.15; printf '3\\1772\\r'")
    out :: String.from_utf8_lossy(output.stdout)
    assert(output.status.success(), "PTY status: {output.status:?}\n{out}")
    assert(out.contains("· 2"), "continuation redraw lost edited line: {out:?}")
