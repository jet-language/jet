// Rust: tests/repl.rs:787
#Test("repl_help_shows_commands") {
    // One merged pipe preserves the observed stdout banner/stderr hint ordering.
    child := Command.new("sh").args(["-c", "exec \"$JET_REPL_BIN\" repl 2>&1"]).env("JET_REPL_BIN", env.binary_path("jet")).env("NO_COLOR", "1").stdin(Stdio.piped()).stdout(Stdio.piped()).spawn().expect("start jet repl")
    child.stdin.as_mut().expect("piped stdin").write_all(":help\n:quit\n".as_bytes()).expect("write transcript")
    output :: child.wait_with_output().expect("finish jet repl")
    assert(output.status.success(), "status: {output.status:?}")
    out :: String.from_utf8(^output.stdout).expect("utf-8 help")
    banner :: out.find("Jet 0.1.0 — Interactive REPL").expect("banner")
    cooked_hint :: out.find("Try: ?name docs · :pin/:fold/:rerun <id> · interactive keys require a TTY").expect("cooked discovery hint from stderr")
    assert(banner < cooked_hint, "banner must precede hint: {out:?}")
    assert(out.contains("REPL meta-commands"), "got: {out:?}")
    loop hint in ["?name", ":? <name>", "Interactive terminal only", "Tab", "F1", "^P", "^F", "^R", "^B"] {
        assert(out.contains(hint), "help missing {hint:?}: {out:?}")
    }
}

