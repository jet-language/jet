// Rust: tests/repl.rs:1104
#Test("repl_native_run_uses_stdin_snapshot_not_replaced_temp_path") {
    state :: env.temp_dir().join("jet_repl_native_run_{process.id()}")
    _ :: fs.remove_dir_all(state).ok()
    child := spawn_repl_process(state)
    wait_for_history_dir(state)
    hostile_path :: env.temp_dir().join("__jet_repl_run_{child.id()}_0.jet")
    fs.write(hostile_path, "fn run() {{ print(\"replaced\") }}\n").unwrap()
    stdin := child.stdin.take().unwrap()
    stdin.write_all("fn answer() -[]> Int {{ return 41 }}\nprint(\"authoritative\")\nprint(answer())\n:run\n:quit\n".as_bytes()).unwrap()
    drop(^stdin)
    output :: child.wait_with_output().expect("finish native REPL")
    _ :: fs.remove_file(hostile_path).ok()
    _ :: fs.remove_dir_all(state).ok()
    assert(output.status.success(), "native REPL: {output.status:?}")
    stdout :: String.from_utf8_lossy(output.stdout)
    assert(stdout.contains("authoritative"), "native :run must execute the stdin snapshot, got: {stdout:?}")
    assert(!stdout.contains("replaced"), "native :run must not consume a replaced temp pathname, got: {stdout:?}")
}
