// Rust: tests/repl.rs:1664
#Test("repl_interrupt_signal_paths_cover_apple_and_bsd_unix") {
    terminal :: fs.read_to_string(OSPath.from(env.manifest_dir()).join("crates/jet-repl/src/Term.rs")).unwrap()
    evaluation_path :: terminal.split("pub struct EvaluationInterruptGuard").nth(1).and_then(source -> source.split("/// One decoded input event.").next()).expect("evaluation interrupt implementation")
    assert(evaluation_path.contains("#[cfg(unix)]"), "raw evaluation interrupt must compile on POSIX Unix")
    assert(!evaluation_path.contains("target_os = \"linux\""), "raw evaluation interrupt must not exclude Apple or BSD")
    methods :: fs.read_to_string(OSPath.from(env.manifest_dir()).join("crates/jet-comptime/src/Comptime/Methods/repl_process.rs")).unwrap()
    forwarding_path :: methods.split("static REPL_CHILD_GROUP").nth(1).and_then(source -> source.split("// ---------------------------------------------------------------------------").next()).expect("runtime child interrupt forwarding implementation")
    assert(forwarding_path.contains("#[cfg(unix)]"), "runtime child forwarding must compile on POSIX Unix")
    assert(!forwarding_path.contains("target_os = \"linux\""), "runtime child forwarding must not exclude Apple or BSD")
}
// Rust: tests/repl.rs:1698
#Test("repl_tty_ctrl_c_reaches_child_group_and_restores_input") {
    if selected_os() != "linux" -> return
    root :: env.temp_dir().join("jet_repl_interrupt_{process.id()}")
    fs.create_dir_all(root).unwrap()
    shell :: "\n{{\n  sleep 0.2\n  printf 'use core.process as process\\r'\n  sleep 0.2\n  printf '#FX(authority: Exec) {{ process.run([\"sh\", \"-c\", \"trap '\\''printf done > child-exited.txt; exit 130'\\'' INT; printf $$ > child.pid; while :; do :; done\"]) ?? panic(\"run failed\") }}\\r'\n  sleep 0.8\n  printf '\\003'\n  sleep 0.5\n  printf '40 + 2\\r'\n  sleep 0.3\n  printf ':quit\\r'\n}} | timeout 8s script -qec '\"$JET_REPL_BIN\" repl --project \"$JET_REPL_ROOT\" --allow-exec' /dev/null\n"
    output :: Command.new("sh").args(["-c", shell]).env("JET_REPL_BIN", env.binary_path("jet")).env("JET_REPL_ROOT", root).output().unwrap()
    transcript :: String.from_utf8_lossy(output.stdout)
    assert(output.status.success(), "PTY interrupt session failed: {transcript}")
    assert(transcript.contains("42 : Int"), "REPL did not resume after Ctrl-C: {transcript}")
    assert_eq(fs.read_to_string(root.join("child-exited.txt")).unwrap(), "done")
    pid :: fs.read_to_string(root.join("child.pid")).unwrap()
    pid_trimmed := pid.trim() // #4303
    alive :: Command.new("kill").args(["-0", pid_trimmed]).stdout(Stdio.null()).stderr(Stdio.null()).status().unwrap().success()
    assert(!alive, "interrupted REPL child {pid} leaked")
    _ :: fs.remove_dir_all(root).ok()
}
// Rust: tests/repl.rs:1750
#Test("repl_tty_ctrl_c_cancels_compute_atomically_and_records_turn") {
    if selected_os() != "linux" -> return
    shell :: "\n{{\n  sleep 0.2\n  printf 'kept :: 42\\r'\n  sleep 0.15\n  printf 'partial :: 1\\033\\rloop {{ }}\\033\\r\\r'\n  sleep 0.3\n  printf '\\003'\n  sleep 0.15\n  printf 'kept\\rpartial\\r:turns\\r:quit\\r'\n}} | timeout 6s script -qec '\"$JET_REPL_BIN\" repl' /dev/null\n"
    started :: Instant.now()
    output :: Command.new("sh").args(["-c", shell]).env("JET_REPL_BIN", env.binary_path("jet")).env("JET_REPL_HISTORY", "off").env("NO_COLOR", "1").output().unwrap()
    transcript :: String.from_utf8_lossy(output.stdout)
    assert(output.status.success(), "PTY compute interrupt failed: {transcript}")
    assert(started.elapsed() < Duration.from_secs(3), "interrupt missed 100ms recovery path")
    assert(transcript.contains("Interrupted. External effects already performed were not rolled back."), "interrupt notice missing: {transcript}")
    assert(transcript.contains("42 : Int"), "prior binding lost: {transcript}")
    assert(transcript.contains("E0107") && transcript.contains("partial"), "partial binding committed: {transcript}")
    assert(transcript.contains("#2 interrupted"), "interrupted turn not addressable: {transcript}")
}
