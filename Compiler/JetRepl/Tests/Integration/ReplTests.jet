}

// Rust: tests/repl.rs:434
#Test("repl_raw_narrow_soft_wrap_keeps_cursor_delete_and_redraw_aligned") {
    if selected_family() != "unix" -> return
    shell :: "\n{{\n  sleep 0.2\n  printf '10 + 20 + 30 + 49'\n  sleep 0.15\n  printf '\\033[D\\033[3~\\r'\n  sleep 0.2\n  printf ':quit\\r'\n}} | timeout 8s script -qec 'stty cols 20; \"$JET_REPL_BIN\" repl' /dev/null\n"
    output :: Command.new("sh").args(["-c", shell]).env("JET_REPL_BIN", env.binary_path("jet")).env("JET_REPL_HISTORY", "off").env("NO_COLOR", "1").output().expect("run narrow raw REPL under PTY")
    out :: String.from_utf8_lossy(output.stdout)
    assert(output.status.success(), "PTY status: {output.status:?}\n{out}")
    assert(out.contains("\x1b[1A"), "soft-wrap redraw never moved to prior physical row: {out:?}")
    assert(out.contains("64 : Int"), "cursor/delete changed wrapped input incorrectly: {out:?}")
}

