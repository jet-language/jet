// Rust: tests/repl.rs:618
#Test("repl_stream_break_runs_deferred_close") {
    declarations :: "\nstruct Marker {{\n    name: String\n}}\n\nimpl Marker.Close {{\n    fn close(^self) {{\n        print(\"closed: {{self.name}}\")\n    }}\n}}\n\nfn values() -[]> Stream<Int> {{\n    marker := Marker{{name: \"stream\"}}\n    defer close(^marker)\n    print(\"before\")\n    yield 1\n    print(\"after\")\n    yield 2\n}}\n\nfn run() {{\n    loop value in values() {{\n        print(\"value: {{value}}\")\n        break\n    }}\n}}\n"
    out :: run_transcript([declarations, ":run"], none)
    assert(out.contains("before"), "got: {out:?}")
    assert(out.contains("value: 1"), "got: {out:?}")
    assert(out.contains("closed: stream"), "got: {out:?}")
    assert(!out.contains("after"), "producer resumed after break: {out:?}")
}
