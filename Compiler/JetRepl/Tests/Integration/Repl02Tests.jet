    if selected_family() != "unix" -> return
    output :: run_raw_multiline_pty("printf 'rate := 7\\r'; sleep 0.12; printf 'total :: rate * 2\\r'; sleep 0.12; printf '\\022'; sleep 0.12; printf '1\\r'; sleep 0.12; printf '\\1778\\r'; sleep 0.2; printf 'total\\r'")
    out := String.from_utf8_lossy(output.stdout) // #4303
    assert(output.status.success(), "PTY status: {output.status:?}\n{out}")
    assert(out.contains("select turn to edit"), "arbitrary-turn selector missing: {out:?}")
    assert(out.contains("rerun #2: total :: rate * 2"), "downstream turn not replayed: {out:?}")
    assert(out.contains("16 : Int"), "edited state did not reach downstream binding: {out:?}")
}
