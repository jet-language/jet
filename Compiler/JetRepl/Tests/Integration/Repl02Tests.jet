// Rust: tests/repl.rs:1801
#Test("repl_tty_compute_interrupt_returns_within_100ms") {
    if selected_os() != "linux" -> return
    child := Command.new("script").args(["-qec", "\"$JET_REPL_BIN\" repl", "/dev/null"]).env("JET_REPL_BIN", env.binary_path("jet")).env("JET_REPL_HISTORY", "off").env("NO_COLOR", "1").stdin(Stdio.piped()).stdout(Stdio.piped()).spawn().expect("spawn timed raw REPL")
    stdin := child.stdin.take().unwrap()
    stdout := child.stdout.take().unwrap()
    (tx, rx) :: mpsc.channel<[U8]>()
    reader :: thread.spawn(() -> {
        bytes := [U8].repeat(0, 4096)
        loop {
            count :: match stdout.read(&bytes) { Ok(count) -> count; Err(_) -> break }
            if count == 0 -> break
            if tx.send(bytes[..count].to_vec()).is_err() -> break
        }
    })
    transcript := String.new()
    startup_deadline :: Instant.now() + Duration.from_secs(2)
    loop !transcript.contains("1 user>") && Instant.now() < startup_deadline {
        if Ok(chunk) :: rx.recv_timeout(Duration.from_millis(50)) -> transcript.push_str(String.from_utf8_lossy(chunk))
    }
    stdin.write_all(b"loop {{ }}\r").unwrap()
    stdin.flush().unwrap()
    thread.sleep(Duration.from_millis(20))
    interrupted_at :: Instant.now()
    stdin.write_all(b"\x03").unwrap()
    stdin.flush().unwrap()
    latency := none as Duration?
    loop interrupted_at.elapsed() <= Duration.from_millis(100) {
        if Ok(chunk) :: rx.recv_timeout(Duration.from_millis(5)) {
            transcript.push_str(String.from_utf8_lossy(chunk))
            if transcript.contains("Interrupted. External effects already performed were not rolled back.") {
                latency = interrupted_at.elapsed()
                break
            }
        }
    }
    if latency.is_some() {
        _ :: stdin.write_all(b":quit\r")
        _ :: child.wait()
    } else {
        _ :: child.kill()
        _ :: child.wait()
    }
    drop(^rx)
    _ :: reader.join().ok()
    assert(latency.is_some(), "prompt missed 100ms interrupt bound: {transcript}")
}

// Rust: tests/repl.rs:1872
#Test("repl_tty_ctrl_c_warns_while_blocking_child_stops") {
    if selected_os() != "linux" -> return
    root :: env.temp_dir().join("jet_repl_interrupt_warning_{process.id()}")
    fs.create_dir_all(root).unwrap()
    shell :: "\n{{\n  sleep 0.2\n  printf 'use core.process as process\\r'\n  sleep 0.15\n  printf '#FX(authority: Exec) {{ process.run([\"sh\", \"-c\", \"trap '\\''sleep 0.4; exit 130'\\'' INT; while :; do :; done\"]) ?? panic(\"run failed\") }}\\r'\n  sleep 0.6\n  printf '\\003'\n  sleep 0.8\n  printf ':quit\\r'\n}} | timeout 6s script -qec '\"$JET_REPL_BIN\" repl --project \"$JET_REPL_ROOT\" --allow-exec' /dev/null\n"
    output :: Command.new("sh").args(["-c", shell]).env("JET_REPL_BIN", env.binary_path("jet")).env("JET_REPL_ROOT", root).env("JET_REPL_HISTORY", "off").env("NO_COLOR", "1").output().unwrap()
    transcript := String.from_utf8_lossy(output.stdout) // #4303
    assert(output.status.success(), "PTY blocking interrupt failed: {transcript}")
    assert(transcript.contains("waiting for active external I/O to stop"), "blocking warning missing: {transcript}")
    _ :: fs.remove_dir_all(root).ok()
}

// Rust: tests/repl.rs:1912
#Test("repl_tty_second_ctrl_c_during_turn_exits_session") {
    if selected_os() != "linux" -> return
    shell :: "\n{{\n  sleep 0.2\n  printf 'loop {{ }}\\r'\n  sleep 0.3\n  printf '\\003'\n  sleep 0.03\n  printf '\\003'\n  sleep 0.3\n  printf '40 + 2\\r'\n}} | timeout 4s script -qec '\"$JET_REPL_BIN\" repl' /dev/null\n"
    output :: Command.new("sh").args(["-c", shell]).env("JET_REPL_BIN", env.binary_path("jet")).env("JET_REPL_HISTORY", "off").env("NO_COLOR", "1").output().unwrap()
    transcript := String.from_utf8_lossy(output.stdout) // #4303
    assert(output.status.success(), "second Ctrl-C did not exit: {transcript}")
    assert(!transcript.contains("42 : Int"), "REPL accepted input after double interrupt: {transcript}")
}

// Rust: tests/repl.rs:1947
#Test("repl_raw_completion_menu_selects_shared_symbol") {
    if selected_os() != "linux" -> return
    shell :: "\n{{\n  sleep 0.2\n  printf 'alpha :: 1\\r'\n  sleep 0.1\n  printf 'alpine :: 2\\r'\n  sleep 0.1\n  printf 'al\\t\\033[B\\r\\r'\n  sleep 0.2\n  printf ':quit\\r'\n}} | timeout 5s script -qec '\"$JET_REPL_BIN\" repl' /dev/null\n"
    output :: Command.new("sh").args(["-c", shell]).env("JET_REPL_BIN", env.binary_path("jet")).env("JET_REPL_HISTORY", "off").env("NO_COLOR", "1").output().unwrap()
    transcript := String.from_utf8_lossy(output.stdout) // #4303
    assert(output.status.success(), "completion PTY failed: {transcript}")
    assert(transcript.contains("completion —"), "selection menu missing: {transcript}")
    assert(transcript.contains("> alpha") && transcript.contains("> alpine"), "selection did not move: {transcript}")
    assert(transcript.contains("2 : Int"), "selected symbol was not inserted: {transcript}")
    assert(!transcript.contains("\x1b[7m"), "NO_COLOR completion used color: {transcript:?}")
}

// Rust: tests/repl.rs:1993
#Test("repl_non_tty_denies_ungranted_files_before_execution") {
    root :: env.temp_dir().join("jet_repl_deny_{process.id()}")
    fs.create_dir_all(root).expect("create root")
    target :: root.join("must-not-exist.txt")
    input :: "#FX(authority: FS) {{ fs.write(\"must-not-exist.txt\", \"bad\") ?? panic(\"write failed\") }}"
    out :: run_transcript(["use core.files as fs", input], root.to_str())
    assert(out.contains("E1803") && out.contains("FS.Write"), "missing deterministic deny: {out}")
    assert(!target.exists(), "denied effect executed")
    _ :: fs.remove_dir_all(root).ok()
}

// Rust: tests/repl.rs:2008
#Test("repl_allow_and_deny_flags_work_in_transcript_mode") {
    root :: env.temp_dir().join("jet_repl_flags_{process.id()}")
    fs.create_dir_all(root).expect("create root")
    input :: "#FX(authority: FS) {{ fs.write(\"flag.txt\", \"allowed\") ?? panic(\"write failed\") }}"
    allowed :: run_transcript_with_flags(["use core.files as fs", input], root.to_str(), ["fs"], [])
    assert(!allowed.contains("E1803"), "--allow-fs rejected: {allowed}")
    assert_eq(fs.read_to_string(root.join("flag.txt")).unwrap(), "allowed")
    fs.remove_file(root.join("flag.txt")).unwrap()
    denied :: run_transcript_with_flags(["use core.files as fs", input], root.to_str(), ["fs"], ["fs"])
    assert(denied.contains("E1803"), "--deny-fs must override allow: {denied}")
    assert(!root.join("flag.txt").exists(), "explicitly denied effect executed")
    _ :: fs.remove_dir_all(root).ok()
}

// Rust: tests/repl.rs:2044
#Test("repl_cli_allow_and_deny_flags_control_non_tty_execution") {
    root :: env.temp_dir().join("jet_repl_cli_flags_{process.id()}")
    fs.create_dir_all(root).unwrap()
    input :: b"use core.files as fs\n#FX(authority: FS) {{ fs.write(\"cli.txt\", \"yes\") ?? panic(\"write failed\") }}\n:quit\n"
    run :: (extra: &[String]) -> {
        cmd := Command.new(env.binary_path("jet"))
        cmd.arg("repl").arg("--project").arg(root).args(extra).env("NO_COLOR", "1").stdin(Stdio.piped()).stdout(Stdio.piped()).stderr(Stdio.piped())
        child := cmd.spawn().unwrap()
        child.stdin.as_mut().unwrap().write_all(input).unwrap()
        child.wait_with_output().unwrap()
    }
    allowed :: run(["--allow-fs"])
    assert(allowed.status.success(), "allow status: {allowed.status:?}")
    assert_eq(fs.read_to_string(root.join("cli.txt")).unwrap(), "yes")
    fs.remove_file(root.join("cli.txt")).unwrap()
    denied :: run(["--allow-fs", "--deny-fs"])
    stderr := String.from_utf8_lossy(denied.stderr) // #4303
    assert(stderr.contains("E1803"), "missing deny diagnostic: {stderr}")
    assert(!root.join("cli.txt").exists(), "CLI-denied write executed")
    _ :: fs.remove_dir_all(root).ok()
}

// Rust: tests/repl.rs:2089
#Test("repl_effect_needs_lexical_grant_even_with_allow_flag") {
    root :: env.temp_dir().join("jet_repl_missing_grant_{process.id()}")
    fs.create_dir_all(root).unwrap()
    out :: run_transcript_with_flags(["use core.files as fs", "fs.write(\"no.txt\", \"bad\") ?? panic(\"write failed\")"], root.to_str(), ["fs"], [])
    assert(out.contains("E1803") && out.contains("no REPL runtime authority"), "missing lexical denial: {out}")
    assert(!root.join("no.txt").exists(), "operation without #FX executed")
    _ :: fs.remove_dir_all(root).ok()
}

// Rust: tests/repl.rs:2113
#Test("repl_allow_fs_still_rejects_paths_outside_project_root") {
    root :: env.temp_dir().join("jet_repl_confined_{process.id()}")
    outside :: env.temp_dir().join("jet_repl_escape_{process.id()}.txt")
    fs.create_dir_all(root).unwrap()
    _ :: fs.remove_file(outside).ok()
    escaped :: outside.to_string_lossy().replace('\\', "\\\\")
    input :: "#FX(authority: FS) {{ fs.write(\"{escaped}\", \"bad\") ?? panic(\"write failed\") }}"
    out :: run_transcript_with_flags(["use core.files as fs", input], root.to_str(), ["fs"], [])
    assert(out.contains("E1803") && out.contains("FS.Write") && out.contains(escaped), "absolute escape was not rejected before execution: {out}")
    assert(!outside.exists(), "confined REPL wrote outside project root")
    _ :: fs.remove_dir_all(root).ok()
}

// Rust: tests/repl.rs:2141
#Test("repl_allow_fs_rejects_symlink_components_before_open") {
    if selected_family() != "unix" -> return
    root :: env.temp_dir().join("jet_repl_symlink_root_{process.id()}")
    outside :: env.temp_dir().join("jet_repl_symlink_out_{process.id()}")
    fs.create_dir_all(root).unwrap()
    fs.create_dir_all(outside).unwrap()
    std.os.unix.fs.symlink(outside, root.join("escape")).unwrap()
    input :: "#FX(authority: FS) {{ fs.write(\"escape/must-not-exist.txt\", \"bad\") ?? panic(\"write failed\") }}"
    out :: run_transcript_with_flags(["use core.files as fs", input], root.to_str(), ["fs"], [])
    assert(out.contains("E1803"), "symlink traversal was not denied: {out}")
    assert(!outside.join("must-not-exist.txt").exists(), "symlink escape executed")
    _ :: fs.remove_file(root.join("escape")).ok()
    _ :: fs.remove_dir_all(root).ok()
    _ :: fs.remove_dir_all(outside).ok()
}

// Rust: tests/repl.rs:2170
#Test("repl_tty_prompts_and_reuses_exact_session_tuple") {
    root :: env.temp_dir().join("jet_repl_tty_auth_{process.id()}")
    fs.create_dir_all(root).unwrap()
    fs.write(root.join("value.txt"), "ok").unwrap()
    shell :: "\n{{\n  sleep 0.2\n  printf 'use core.files as fs\\r'\n  sleep 0.2\n  printf '#FX(authority: FS) {{ fs.read(\"value.txt\") ?? panic(\"read failed\") }}\\r'\n  sleep 0.2\n  printf 's'\n  sleep 0.2\n  printf '#FX(authority: FS) {{ fs.read(\"value.txt\") ?? panic(\"read failed\") }}\\r'\n  sleep 0.2\n  printf 'c'\n  sleep 0.2\n  printf ':quit\\r'\n}} | script -qec '\"$JET_REPL_BIN\" repl --project \"$JET_REPL_ROOT\"' /dev/null\n"
    output :: Command.new("sh").args(["-c", shell]).env("JET_REPL_BIN", env.binary_path("jet")).env("JET_REPL_ROOT", root).env("NO_COLOR", "1").output().expect("run REPL under PTY")
    out := String.from_utf8_lossy(output.stdout) // #4303
    assert(output.status.success(), "PTY status: {output.status:?}\n{out}")
    assert(out.contains("Core effect FS requests runtime authority"), "missing prompt: {out}")
    assert(out.contains("Using session FS.Read authority for `value.txt`"), "missing exact tuple reuse: {out}")
    assert(!out.contains("E1803"), "approved tuple denied: {out}")
    _ :: fs.remove_dir_all(root).ok()
}

