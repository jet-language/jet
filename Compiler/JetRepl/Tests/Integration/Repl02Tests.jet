// Rust: tests/repl.rs:2329
#Test("shared_semantic_symbol_has_complete_identity_and_docs") {
    symbol :: SemanticSymbols.lookup("List.filter").expect("shared List.filter symbol")
    assert_eq(symbol.module, "core.collections")
    assert_eq(symbol.owner, "List")
    assert_eq(symbol.member, "filter")
    assert(symbol.signature.contains("fn(T) -> Bool"))
    assert(!symbol.summary.is_empty())
    assert(!symbol.example.is_empty())
    assert_eq(symbol.provenance, "builtin")
}
// Rust: tests/repl.rs:2341
#Test("shared_semantic_symbols_catalog_numeric_conversions_and_parse") {
    parse :: SemanticSymbols.lookup("Int.parse").expect("Int.parse symbol")
    assert_eq(parse.signature, "Int.parse(text: String) -> Int ParseError!")
    narrow :: SemanticSymbols.lookup("F32.from_float").expect("F32.from_float symbol")
    assert_eq(narrow.module, "core.numeric")
    assert(narrow.signature.ends_with("-> F32 !String"))
    assert(SemanticSymbols.lookup("I64.from_f32").is_some())
    assert(SemanticSymbols.lookup("F64.from_u32").is_some())
}
