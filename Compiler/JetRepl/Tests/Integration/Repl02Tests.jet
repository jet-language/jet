#Test("repl_terminal_matrix_keyboard_and_text_fallbacks_are_reachable") {
    if selected_os() != "linux" -> return
    raw :: run_raw_multiline_pty("printf 'alpha := 1\\r'; sleep 0.12; printf '\\002'; sleep 0.12; printf '\\0201\\r'; sleep 0.12; printf '\\0061\\r'; sleep 0.12; printf '\\0221\\r\\r'; sleep 0.18; printf 'alp\\t\\r'; sleep 0.12; printf '\\033ORa\\r\\r'; sleep 0.15; printf ':quit\\r'")
    raw_out := String.from_utf8_lossy(raw.stdout) // #4303
    assert(raw.status.success(), "raw key matrix failed: {raw_out}")
    loop marker in ["bindings", "select turn to pin", "select turn to fold", "select turn to edit", "history search>"] {
        assert(raw_out.contains(marker), "raw key `{marker}` unreachable: {raw_out:?}")
    }
    assert(raw_out.contains("1 : Int"), "Tab completion did not resolve live binding: {raw_out:?}")
    state :: env.temp_dir().join("jet_repl_text_matrix_{process.id()}")
    _ :: fs.remove_dir_all(state).ok()
    cooked :: run_repl_process(state, b"alpha := 1\n?alpha\n:pin 1\n:fold 1\n:unfold 1\n:rerun 1\n\n:history search alpha\n:turns\n:quit\n", none)
    cooked_out := String.from_utf8_lossy(cooked.stdout) // #4303
    assert(cooked.status.success(), "text fallback matrix failed: {cooked_out}")
    loop marker in ["alpha: Int := 1", "turn pinned", "turn folded", "turn unfolded", "rerun #1", "#1 ok"] {
        assert(cooked_out.contains(marker), "text fallback `{marker}` unreachable: {cooked_out:?}")
    }
    _ :: fs.remove_dir_all(state).ok()
}

