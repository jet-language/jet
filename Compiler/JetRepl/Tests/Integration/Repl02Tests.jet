        "fmt.bytes(1500000)", "fmt.duration(93784000)", "fmt.ordinal(23)", "fmt.plural(1, \"item\", \"items\")",
        "fmt.plural(3, \"item\", \"items\")", "fmt.pad_left(\"7\", 3, \"0\")",
