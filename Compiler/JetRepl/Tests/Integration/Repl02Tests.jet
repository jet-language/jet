    out :: run_transcript(["use core.archive.zstd as zstd",
        "frame :: zstd.compress([72, 101, 108, 108, 111]) ?? panic(\"zstd compress\")", "frame.len() > 9",
        "frame[0] == (U8.from_int(40) ?? 0) && frame[1] == (U8.from_int(181) ?? 0) && frame[2] == (U8.from_int(47) ?? 0) && frame[3] == (U8.from_int(253) ?? 0)"], none)
    assert(!out.contains("E0956"), "zstd compressor hit comptime fallback: {out}")
    assert_eq(out.matches("true : Bool").count(), 2, "got: {out}")
}
// Rust: tests/repl.rs:3372
#Test("repl_zstd_decompress_is_resident_and_typed") {
    out :: run_transcript(["use core.archive.zstd as zstd",
        "zstd.decompress([40, 181, 47, 253, 0, 88, 41, 0, 0, 104, 101, 108, 108, 111]) ?? []",
        "zstd.decompress([40, 181, 47]) ?? [255]"], none)
    assert(!out.contains("E0956"), "resident decoder hit fallback: {out}")
    assert(out.contains("[104, 101, 108, 108, 111]"), "got: {out}")
    assert(out.contains("[255]"), "malformed frame was not a typed Err: {out}")
}
// Rust: tests/repl.rs:3393
#Test("repl_core_data_query_plans_and_typed_joins") {
    inputs :: ["use core.data as data", "rows :: [Int]{{3, 1, 2}}", "query :: data.query(rows)",
        "deferred :: query.filter((x) -> x > 10)", "deferred.plan()",
        "planned :: data.query(rows).filter((x) -> x > 1).sort_by((x) -> \"{{x}}\")", "planned.collect() ?? panic(\"collect\")",
        "data.inner_join([1, 2, 1], [1, 1], (x) -> \"{{x}}\", (x) -> \"{{x}}\")",
        "data.left_join([1, 2], [1], (x) -> \"{{x}}\", (x) -> \"{{x}}\")"]
    out :: run_transcript(inputs, none)
    assert(out.contains("[table, filter]"), "deferred query plan missing: {out}")
    assert(out.contains("[2, 3]"), "materialized filter/sort result missing: {out}")
    assert(out.lines().any(line -> line.matches("DataJoin(left: 1, right: 1)").count() == 4), "inner join multiplicity lost: {out}")
    assert(out.contains("DataJoin(left: 2, right: null)"), "left join unmatched row missing: {out}")
}
// Rust: tests/repl.rs:3426
#Test("repl_core_data_schema_empty_lists_and_row_law") {
    inputs :: ["use core.data as data", "struct Ticket {{ team: String minutes: Float }}",
        "empty_rows: [Ticket] := []", "data.schema(empty_rows)", "data.schema([1.0, 2.0])",
        "t :: Ticket{{team: \"Core\", minutes: 4.0}}", "data.schema([t])",
        "empty_tickets: [Ticket] := []", "data.schema(empty_tickets)", "struct Empty {{}}",
        "empty_units: [Empty] := []", "data.schema(empty_units)", "struct Box<T> {{ value: T }}",
        "boxed: [Box<Int>] := []", "data.schema(boxed)"]
    out :: run_transcript(inputs, none)
    assert(!out.contains("E0956"), "core.data schema should dispatch at comptime, got: {out}")
    assert(out.contains("DataColumn(name: team, type_name: String)") && out.contains("DataColumn(name: minutes, type_name: Float)"), "empty list of Ticket must keep static columns: {out}")
    assert(out.contains("DataColumn(name: value, type_name: Float)"), "scalar Float list must have one value column: {out}")
    assert(out.contains("[] : List"), "zero-field row must have zero columns: {out}")
    assert(out.contains("DataColumn(name: value, type_name: Int)"), "generic row fields must substitute concrete type arguments: {out}")
}
// Rust: tests/repl.rs:3469
#Test("repl_core_data_list_query_echo_hides_comptime_metadata") {
    inputs :: ["use core.data as data", "struct Ticket {{ team: String minutes: Float }}",
        "empty_rows: [Ticket] := []", "empty_rows", "data.query(empty_rows)", "data.schema(empty_rows)"]
    out :: run_transcript(inputs, none)
    assert(!out.contains("E0956"), "core.data list/query calls should dispatch at comptime, got: {out}")
    assert(out.contains("Query("), "expected a typed Query echo: {out}")
    assert(out.contains("[] : List"), "ordinary list echo missing: {out}")
    assert(!out.contains("elem_type:"), "comptime-only metadata must not leak into REPL echo: {out}")
}
// Rust: tests/repl.rs:3498
#Test("repl_core_data_json_ingest_and_select") {
    fixture :: env.temp_dir().join("jet_repl_data_json_{process.id()}")
    fs.create_dir_all(fixture).unwrap()
    fs.write(fixture.join("model.jet"), "#Codable\nstruct Ticket {{ team: String minutes: Float }}\n").unwrap()
    project_dir :: fixture.to_string_lossy().to_string()
    inputs :: ["use core.data as data",
        "raw :: \"[{{{{\\\"team\\\":\\\"Core\\\",\\\"minutes\\\":4.0}}}},{{{{\\\"team\\\":\\\"Tools\\\",\\\"minutes\\\":5.0}}}},{{{{\\\"team\\\":\\\"Core\\\",\\\"minutes\\\":8.0}}}}]\"",
        "rows :: data.json<Ticket>(raw) ?? panic(\"bad json\")", "data.schema(rows)",
        "selected :: data.query(rows).filter((t) -> t.minutes >= 5.0).collect() ?? panic(\"filter\")",
        "data.count(selected)", "data.status()[6]"]
    out :: run_transcript(inputs, project_dir)
    _ :: fs.remove_dir_all(fixture).ok()
    assert(!out.contains("E0956"), "core.data json should dispatch at comptime, got: {out}")
    assert(out.contains("DataColumn(name: team, type_name: String)") && out.contains("DataColumn(name: minutes, type_name: Float)"), "json list schema missing: {out}")
    assert(out.contains("2 : Int"), "selected count missing: {out}")
    assert(out.contains("DataStatus(step: core.data.json") && out.contains("path: native"), "json status row missing: {out}")
}
// Rust: tests/repl.rs:3542
#Test("repl_file_argument_loads_definitions_without_running_entry") {
    fixture :: env.temp_dir().join("jet_repl_preload_{process.id()}")
    fs.create_dir_all(fixture).unwrap()
    source :: fixture.join("defs.jet")
    fs.write(source, "fn triple(n: Int) -[]> Int {{ return n * 3 }}\nfn run() {{ print(\"entry ran\") }}\n").unwrap()
    out :: jet.REPL.run_transcript_with_preload(["triple(4)"], none, source.to_string_lossy())
    _ :: fs.remove_dir_all(fixture).ok()
    assert(out.contains("loaded 2 items"), "preload should report what it loaded, got: {out}")
    assert(out.contains("12 : Int"), "a definition from the file should be callable in turn 1, got: {out}")
    assert(!out.contains("entry ran"), "`fn run` must NOT be invoked by a command-line preload, got: {out}")
}
// Rust: tests/repl.rs:3574
#Test("repl_missing_file_argument_is_refused_before_the_banner") {
    missing :: env.temp_dir().join("jet_repl_absent_{process.id()}.jet")
    _ :: fs.remove_file(missing).ok()
    out :: Command.new(env.binary_path("jet")).arg("repl").arg(missing).env("NO_COLOR", "1").output().expect("run repl")
    stderr := String.from_utf8_lossy(out.stderr) // #4303
    stdout := String.from_utf8_lossy(out.stdout) // #4303
    assert_eq(out.status.code(), 1, "stderr: {stderr}")
    assert(stderr.contains("E2105"), "expected E2105, got: {stderr}")
    assert(!stdout.contains("Welcome"), "a refused preload must not print the banner, got: {stdout}")
}
// Rust: tests/repl.rs:3600
#Test("repl_project_flag_value_is_not_read_as_the_preload_file") {
    project :: env.temp_dir().join("jet_repl_proj_arg_{process.id()}")
    fs.create_dir_all(project).unwrap()
    fs.write(project.join("helper.jet"), "fn helper() -[]> Int {{ return 7 }}\n").unwrap()
    out :: Command.new(env.binary_path("jet")).arg("repl").arg("--project").arg(project).env("NO_COLOR", "1").output().expect("run repl")
    _ :: fs.remove_dir_all(project).ok()
    stderr := String.from_utf8_lossy(out.stderr) // #4303
    assert(!stderr.contains("E2105"), "`--project <dir>` must not be mistaken for a preload file: {stderr}")
}
