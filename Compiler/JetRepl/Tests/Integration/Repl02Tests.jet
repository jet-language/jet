// Rust: tests/repl.rs:2880
#Test("repl_terminal_matrix_raw_width_color_eof_and_ctrl_d") {
    if selected_os() != "linux" -> return
    loop cols in [20, 120] {
        loop (name, flag, no_color, force_color, expect_color) in [
            ("auto", "", false, false, true),
            ("always", "--color=always", true, false, true),
            ("never", "--color=never", false, true, false),
            ("empty-NO_COLOR", "", true, true, false),
            ("FORCE_COLOR", "", false, true, true)
        ] {
            shell :: "{{ sleep 0.2; printf '1 + 1\\r'; sleep 0.12; printf '\\004'; }} | timeout 8s script -qec 'stty cols {cols}; \"$JET_REPL_BIN\" repl {flag}' /dev/null"
            command := Command.new("sh")
            command.args(["-c", shell]).env("JET_REPL_BIN", env.binary_path("jet")).env("JET_REPL_HISTORY", "off").env_remove("NO_COLOR").env_remove("FORCE_COLOR")
            if no_color -> command.env("NO_COLOR", "")
            if force_color -> command.env("FORCE_COLOR", "1")
            output :: command.output().unwrap()
            out := String.from_utf8_lossy(output.stdout) // #4303
            assert(output.status.success(), "raw {name}/{cols}-column Ctrl-D row failed: {out}")
            assert(out.contains("Tab") && out.contains("F3") && !out.contains("interactive keys require a TTY"), "raw mode not reached for {name} at width {cols}: {out:?}")
            assert(out.contains("2 : Int"), "raw evaluation failed for {name} at width {cols}: {out:?}")
            assert_eq(out.contains("\u{1b}[1;96m"), expect_color, "wrong color policy for {name} at width {cols}: {out:?}")
        }
    }
    eof :: Command.new("sh").args(["-c", "timeout 8s script -qec '\"$JET_REPL_BIN\" repl < /dev/null' /dev/null"]).env("JET_REPL_BIN", env.binary_path("jet")).env("NO_COLOR", "1").env("JET_REPL_HISTORY", "off").output().unwrap()
    assert(eof.status.success(), "PTY EOF row hung or failed: {String.from_utf8_lossy(eof.stdout)}")
}
// Rust: tests/repl.rs:2949
#Test("repl_terminal_matrix_cooked_stdio_and_missing_stty_are_truthful") {
    if selected_os() != "linux" -> return
    cases :: [
        ("stdin-pipe/stdout-pty", "printf \"1 + 1\\n:quit\\n\" | \"$JET_REPL_BIN\" repl"),
        ("missing-stty", "PATH=/definitely-missing \"$JET_REPL_BIN\" repl")
    ]
    loop (name, inner) in cases {
        shell :: if name == "missing-stty" -> "{{ sleep 0.2; printf '1 + 1\\r:quit\\r'; }} | timeout 8s script -qec '{inner}' /dev/null" else -> "timeout 8s script -qec '{inner}' /dev/null"
        output :: Command.new("sh").args(["-c", shell]).env("JET_REPL_BIN", env.binary_path("jet")).env("NO_COLOR", "1").env("JET_REPL_HISTORY", "off").output().unwrap()
        out := String.from_utf8_lossy(output.stdout) // #4303
        assert(output.status.success(), "{name} row failed: {out}")
        assert(out.contains("interactive keys require a TTY"), "{name} falsely claimed raw mode: {out:?}")
        assert(!out.contains("Tab complete"), "{name} advertised unavailable keys: {out:?}")
        assert(out.contains("1 user> ") && out.contains("2 : Int"), "{name} cooked behavior missing: {out:?}")
    }
    root :: env.temp_dir().join("jet_repl_stdout_mode_{process.id()}")
    fs.create_dir_all(root).unwrap()
    captured :: root.join("stdout.txt")
    shell :: "{{ sleep 0.2; printf '3 + 4\\r:quit\\r'; }} | timeout 8s script -qec '\"$JET_REPL_BIN\" repl > \"{captured.display()}\"' /dev/null"
    output :: Command.new("sh").args(["-c", shell]).env("JET_REPL_BIN", env.binary_path("jet")).env("NO_COLOR", "1").env("JET_REPL_HISTORY", "off").output().unwrap()
    stderr_side := String.from_utf8_lossy(output.stdout) // #4303
    stdout_side :: fs.read_to_string(captured).unwrap()
    assert(output.status.success(), "stdin-pty/stdout-file row failed: {stderr_side}")
    assert(stderr_side.contains("interactive keys require a TTY"), "redirected stdout falsely entered raw mode: {stderr_side:?}")
    assert(stdout_side.contains("1 user> ") && stdout_side.contains("7 : Int"), "redirected cooked stdout missing: {stdout_side:?}")
    _ :: fs.remove_dir_all(root).ok()
}
