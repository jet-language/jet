// REPL source classification. Rust: jet-repl 1591-1634, 1709-1788, 1839-1999.
// This adapter feeds the canonical parser; it owns no interpreter. Every input
// the parser accepts is checked by the compiler on the shared path (`jet repl`,
// JetCli Repl.jet); nothing here refuses a feature by name.
use {
    jet_foundation.[Diagnostic, DiagnosticLabel, Item, ParseResult, Span, Stmt, TextEdit]
    jet_lexer.[lex]
    jet_parser.[parse_generated_source, parse_source]
}

enum ReplInput {
    Meta(command: String, argument: String?)
    // `check_source` is the user's statement text; `echo` marks the
    // expression form, whose value the session binds and shows.
    Stmts(body: [Stmt], suppress_echo: Bool, echo: Bool, check_source: String)
    Item(source: String)
    Import(source: String)
    Empty
}

enum ReplInputParse {
    Accepted(input: ReplInput)
    // Spans are anchored to the user's input text.
    Rejected(diagnostics: [Diagnostic])
}

// `reanchor_repl_diagnostic`: shift a span `offset` bytes back to the user's
// input; a span inside the generated wrapper clamps to 0.
fn repl_reanchor_span(span: Span, offset: Int) -> Span Never! {
    start :: if span.start - offset < 0 -> 0 else -> span.start - offset
    end :: if span.end - offset < 0 -> start else -> span.end - offset
    Span{start: start, end: if end < start -> start else -> end}
}

// Every span a report renders (primary, labels, edit), shifted to the input.
fn repl_reanchor(diagnostic: ^Diagnostic, offset: Int) -> Diagnostic Never! {
    updated := diagnostic
    if updated.span == .Val(span) -> updated.span = Val(repl_reanchor_span(span, offset))
    labels := [DiagnosticLabel]{}
    loop label in updated.labels -> &labels.push(DiagnosticLabel{span: repl_reanchor_span(label.span, offset), message: label.message})
    updated.labels = labels
    if updated.edit == .Val(edit) -> updated.edit = Val(TextEdit{span: repl_reanchor_span(edit.span, offset), new_text: edit.new_text})
    updated
}

fn repl_reanchor_all(diagnostics: [Diagnostic], offset: Int) -> [Diagnostic] Never! {
    shifted := [Diagnostic]{}
    loop diagnostic in diagnostics -> &shifted.push(repl_reanchor(diagnostic.copy(), offset))
    shifted
}

fn repl_rejected(diagnostics: [Diagnostic], offset: Int) -> ReplInputParse Never! {
    ReplInputParse.Rejected{diagnostics: repl_reanchor_all(diagnostics, offset)}
}

fn repl_skip_leading_comments(source: String) -> String Never! {
    text := source
    loop {
        text = text.trim_start()
        if !text.starts_with("//") && !text.starts_with("/*") -> return text
        bytes :: text.bytes()
        if text.starts_with("//") {
            newline := Int?{None}
            loop index in 0..<text.len() {
                if bytes[index] == (U8{10}) {
                    newline = Val(index)
                    break
                }
            }
            text = if newline == .Val(index) -> text.slice(index + 1..<text.len()) else -> ""
            next
        }
        index := 2
        depth := 1
        loop depth > 0 {
            if index >= text.len() -> return ""
            if index + 1 < text.len() && bytes[index] == 47 && bytes[index + 1] == 42 {
                depth += 1
                index += 2
            } else if index + 1 < text.len() && bytes[index] == 42 && bytes[index + 1] == 47 {
                depth -= 1
                index += 2
            } else { index += 1 }
        }
        text = text.slice(index..<text.len())
    }
}

fn repl_looks_like_item(source: String) -> Bool Never! {
    text := repl_skip_leading_comments(source)
    if text.starts_with("pub") -> text = text.slice(3..<text.len()).trim_start()
    if text.starts_with("pure") -> text = text.slice(4..<text.len()).trim_start()
    text.starts_with("fn ") || text.starts_with("fn(") || text.starts_with("struct ") || text.starts_with("enum ") || text.starts_with("trait ") || text.starts_with("impl ") || text.starts_with("const ") || text.starts_with("module ")
}

fn repl_looks_like_import(source: String) -> Bool Never! {
    text := source.trim_start()
    if text.starts_with("pub") -> text = text.slice(3..<text.len()).trim_start()
    text.starts_with("use ") || text == "use"
}

fn repl_starts_with_stmt_keyword(text: String) -> Bool Never! {
    text.contains("::") || text.contains(":=") || text.starts_with("return ") || text.starts_with("return") || text.starts_with("if ") || text.starts_with("loop ") || text.starts_with("break") || text.starts_with("continue") || text.starts_with("print(") || text.starts_with("eprint(")
}

fn repl_first_function_body(items: [Item]) -> [Stmt]? Never! {
    if items.len() == 0 -> return None
    if items[0] == .Func(function) -> return Val(function.body)
    None
}

fn repl_classify(source: String, step: Int) -> ReplInputParse {
    text :: source.trim()
    if text == "" -> return ReplInputParse.Accepted{input: ReplInput.Empty}
    if text.starts_with(":") {
        rest :: text.slice(1..<text.len())
        split := rest.len()
        bytes :: rest.bytes()
        loop index in 0..<bytes.len() {
            if bytes[index] == 32 {
                split = index
                break
            }
        }
        argument := String?{None}
        if split < rest.len() {
            tail :: rest.slice(split + 1..<rest.len()).trim()
            if tail != "" -> argument = Val(tail)
        }
        return ReplInputParse.Accepted{input: ReplInput.Meta{command: rest.slice(0..<split), argument: argument}}
    }
    if text.starts_with("?") {
        name :: text.slice(1..<text.len()).trim()
        return ReplInputParse.Accepted{input: ReplInput.Meta{command: "?", argument: if name == "" -> None else -> Val(name)}}
    }
    header :: "// repl:{step}\n"
    if repl_looks_like_import(text) {
        normalized :: text.trim_end()
        full :: "{header}{normalized}\n"
        parsed :: parse_source(full.bytes())
        if parsed.diagnostics.len() > 0 -> return repl_rejected(parsed.diagnostics, header.len())
        if parsed.program.items.len() == 0 && parsed.program.imports.len() > 0 {
            return ReplInputParse.Accepted{input: ReplInput.Import{source: "{normalized}\n"}}
        }
    }
    suppress :: text.ends_with(";") && !repl_looks_like_item(text) && !text.ends_with("}};")
    if repl_looks_like_item(text) {
        item_source :: "{text}\n"
        parsed :: parse_source("{header}{item_source}".bytes())
        if parsed.diagnostics.len() > 0 -> return repl_rejected(parsed.diagnostics, header.len())
        return ReplInputParse.Accepted{input: ReplInput.Item{source: item_source}}
    }
    user_lexed :: lex(text.bytes())
    if user_lexed.diagnostics.len() > 0 -> return repl_rejected(user_lexed.diagnostics, 0)
    plain_input :: text.trim_end()
    wrapper :: "{header}fn __repl__() {{\n"
    plain_source :: "{wrapper}{plain_input}\n}}\n"
    plain_attempt := ParseResult?{None}
    if repl_starts_with_stmt_keyword(text) || suppress {
        parsed :: parse_generated_source(plain_source.bytes())
        if parsed.diagnostics.len() == 0 && repl_first_function_body(parsed.program.items) == .Val(body) {
            if body.len() > 0 {
                return ReplInputParse.Accepted{input: ReplInput.Stmts{body: body, suppress_echo: suppress, echo: false, check_source: plain_input}}
            }
        }
        plain_attempt = Val(parsed)
    }
    echo_stmt :: "__repl_echo__ :: {text}"
    echo_source :: "{wrapper}{echo_stmt}\n}}\n"
    echo :: parse_generated_source(echo_source.bytes())
    if echo.diagnostics.len() == 0 && repl_first_function_body(echo.program.items) == .Val(body) {
        if body.len() > 0 {
            return ReplInputParse.Accepted{input: ReplInput.Stmts{body: body, suppress_echo: suppress, echo: true, check_source: plain_input}}
        }
    }
    plain :: plain_attempt ?? parse_generated_source(plain_source.bytes())
    if plain.diagnostics.len() > 0 -> return repl_rejected(plain.diagnostics, wrapper.len())
    if repl_first_function_body(plain.program.items) == .Val(body) {
        return ReplInputParse.Accepted{input: ReplInput.Stmts{body: body, suppress_echo: suppress, echo: false, check_source: plain_input}}
    }
    ReplInputParse.Accepted{input: ReplInput.Empty}
}
