// REPL source classification. This adapter feeds the canonical parser and
// runs nothing itself: the parse decides whether an input is imports,
// declarations or one turn's statements, and every input the parser accepts
// is checked by the compiler on the shared path (`jet repl`, JetCLI
// Repl.jet); nothing here refuses a feature by name.
use {
    jet_foundation.[ASTTables, Diagnostic, DiagnosticLabel, Item, ParseResult, Span, StmtNode, TextEdit, ast_stmt]
    jet_lexer.[lex, statement_starts]
    jet_parser.[parse_generated_source, parse_source]
}

ReplInput: enum {
    Meta(command: String, argument: String?),
    Stmts(tables: ASTTables, body: [StmtNode], suppress_echo: Bool, echo: Bool, check_source: String),
    Item(source: String),
    Import(source: String),
    Empty,
}

// `check_source` is the user's statement text; `echo` marks the
// expression form, whose value the session binds and shows.

ReplInputParse: enum {
    Accepted(input: ReplInput),
    Rejected(diagnostics: [Diagnostic]),
}

// Spans are anchored to the user's input text.

// `reanchor_repl_diagnostic`: shift a span `offset` bytes back to the user's
// input; a span inside the generated wrapper clamps to 0.
repl_reanchor_span: fn(span: Span, offset: Int) -> Span Never! {
    start: if span.start - offset < 0 -> 0 else -> span.start - offset
    end: if span.end - offset < 0 -> start else -> span.end - offset
    Span{start: start, end: if end < start -> start else -> end}
}

// Every span a report renders (primary, labels, edit), shifted to the input.
repl_reanchor: fn(diagnostic: ^^Diagnostic, offset: Int) -> Diagnostic Never! {
    updated := diagnostic
    if updated.span == .Val(span) -> updated.span = Val(repl_reanchor_span(span, offset))
    labels: loop label in updated.labels -> DiagnosticLabel{span: repl_reanchor_span(label.span, offset), message: label.message}
    updated.labels = labels
    if updated.edit == .Val(edit) {
        updated.edit = Val(TextEdit{span: repl_reanchor_span(edit.span, offset), new_text: edit.new_text})
    }
    updated
}

repl_reanchor_all: fn(diagnostics: [Diagnostic], offset: Int) -> [Diagnostic] Never! {
    shifted := [Diagnostic]{}
    loop diagnostic in diagnostics -> shifted.push(repl_reanchor(diagnostic.copy(), offset))
    shifted
}

repl_rejected: fn(diagnostics: [Diagnostic], offset: Int) -> ReplInputParse Never! {
    ReplInputParse.Rejected{diagnostics: repl_reanchor_all(diagnostics, offset)}
}

// Whether the last statement of `body` is a bare expression, whose value the
// turn shows (`a(); b` shows `b`). The Prelude's `print` and `eprint` return
// Unit and show nothing, so their turn builds once, without the echo.
repl_shows_value: fn(tables: ASTTables, body: [StmtNode]) -> Bool Never! {
    if body.len() == 0 -> return false
    if ast_stmt(tables, body[body.len() - 1]) == .Expr(expr) {
        if expr == .Call(call, _) -> return call.name != "print" && call.name != "eprint"
        return true
    }
    false
}

repl_first_function_body: fn(items: [Item]) -> [StmtNode]? Never! {
    if items.len() == 0 -> return None
    if items[0] == .Func(function) -> return Val(function.body)
    None
}

repl_classify: fn(source: String, step: Int) -> ReplInputParse {
    text: source.trim()
    if text == "" -> return ReplInputParse.Accepted{input: ReplInput.Empty}
    if text.starts_with(":") {
        rest: text.slice(1..<text.len())
        split := rest.len()
        bytes: rest.bytes()
        loop index in 0..<bytes.len() {
            if bytes[index] == 32 {
                split = index
                break
            }
        }
        argument := String?{None}
        if split < rest.len() {
            tail: rest.slice(split + 1..<rest.len()).trim()
            if tail != "" -> argument = Val(tail)
        }
        return ReplInputParse.Accepted{input: ReplInput.Meta{command: rest.slice(0..<split), argument: argument}}
    }
    if text.starts_with("?") {
        name: text.slice(1..<text.len()).trim()
        return ReplInputParse.Accepted{input: ReplInput.Meta{command: "?", argument: if name == "" -> None else -> Val(name)}}
    }
    header: "// repl:{step}\n"
    user_lexed: lex(text.bytes())
    if user_lexed.diagnostics.len() > 0 -> return repl_rejected(user_lexed.diagnostics, 0)
    plain_input: text.trim_end()
    // The parser says what the input is: imports, declarations, or the
    // statements of one turn.
    top: parse_source("{header}{plain_input}\n".bytes())
    if repl_declarations_only(top) {
        if top.program.items.len() == 0 -> return ReplInputParse.Accepted{input: ReplInput.Import{source: "{plain_input}\n"}}
        if top.program.imports.len() == 0 -> return ReplInputParse.Accepted{input: ReplInput.Item{source: "{plain_input}\n"}}
    }
    suppress: text.ends_with(";") && !text.ends_with("}};")
    wrapper: "{header}__repl__: fn() {{\n"
    plain: parse_generated_source("{wrapper}{plain_input}\n}}\n".bytes())
    plain_body: if plain.diagnostics.len() == 0 -> repl_first_function_body(plain.program.items) else -> None
    if plain_body == .Val(body) && !repl_shows_value(plain.program.tables, body) {
        if body.len() == 0 -> return ReplInputParse.Accepted{input: ReplInput.Empty}
        return ReplInputParse.Accepted{input: ReplInput.Stmts{tables: plain.program.tables, body: body, suppress_echo: suppress, echo: false, check_source: plain_input}}
    }
    // A bare last expression binds its value, which the turn shows; the
    // statements before it, up to the line break or `;` that ends them, stay
    // as written.
    bytes: plain_input.bytes()
    starts: statement_starts(lex(bytes).tokens)
    last: starts[starts.len() - 1]
    head: String.from_bytes(bytes.slice(0, last)) ?? ""
    tail: String.from_bytes(bytes.slice(last, bytes.len())) ?? ""
    echo: parse_generated_source("{wrapper}{head}__repl_echo__: {tail}\n}}\n".bytes())
    if echo.diagnostics.len() == 0 && repl_first_function_body(echo.program.items) == .Val(body) {
        if body.len() > 0 {
            return ReplInputParse.Accepted{input: ReplInput.Stmts{tables: echo.program.tables, body: body, suppress_echo: suppress, echo: true, check_source: plain_input}}
        }
    }
    if plain_body == .Val(body) {
        return ReplInputParse.Accepted{input: ReplInput.Stmts{tables: plain.program.tables, body: body, suppress_echo: suppress, echo: false, check_source: plain_input}}
    }
    // Input that reads as top-level declarations reports the declaration
    // parse; anything else reports the statement parse.
    if top.diagnostics.len() > 0 && top.program.script_body.len() == 0 -> return repl_rejected(top.diagnostics, header.len())
    if plain.diagnostics.len() > 0 -> return repl_rejected(plain.diagnostics, wrapper.len())
    ReplInputParse.Accepted{input: ReplInput.Empty}
}

// Whether the top-level parse holds only imports and declarations. A
// top-level `name: value` parses as a module binding (`Item.Const`); the REPL
// keeps it a statement, so a session binding echoes and replays like any
// other line.
repl_declarations_only: fn(parsed: ParseResult) -> Bool Never! {
    if parsed.diagnostics.len() > 0 || parsed.program.script_body.len() > 0 -> return false
    if parsed.program.items.len() == 0 && parsed.program.imports.len() == 0 -> return false
    loop item in parsed.program.items {
        if item == .Const(_) -> return false
    }
    true
}
