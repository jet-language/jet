// Host-owned seams for the transport-neutral project console.
// No listener, client, database copy, or fallback is created here.

// Rust: crates/jet-repl/src/ConsoleHost.rs:17
pub struct ConsoleHostAdapters {
    router: InProcessRouter?
    data_backend: ConsoleDataBackend?

    // Rust: crates/jet-repl/src/ConsoleHost.rs:23
    pub fn new() -> ConsoleHostAdapters {
        ConsoleHostAdapters{router: None, data_backend: None}
    }
    // Rust: crates/jet-repl/src/ConsoleHost.rs:30
    pub fn with_router(^self, router: InProcessRouter) -> ConsoleHostAdapters {
        adapters := ^self
        adapters.router = Val(^router)
        ^adapters
    }
    // Rust: crates/jet-repl/src/ConsoleHost.rs:38
    pub fn with_data_backend(^self, backend: ConsoleDataBackend) -> ConsoleHostAdapters {
        adapters := ^self
        adapters.data_backend = Val(^backend)
        ^adapters
    }
    // Rust: crates/jet-repl/src/ConsoleHost.rs:46
    pub fn set_router(&self, router: InProcessRouter) {
        self.router = Val(^router)
    }
    // Rust: crates/jet-repl/src/ConsoleHost.rs:50
    pub fn set_data_backend(&self, backend: ConsoleDataBackend) {
        self.data_backend = Val(^backend)
    }
    // Rust: crates/jet-repl/src/ConsoleHost.rs:54
    fn attach(^self, session: &ConsoleSession) {
        if self.router == .Val(router) -> &session.set_router(^router)
        if self.data_backend == .Val(backend) -> &session.set_data_backend(^backend)
    }
    // Rust: crates/jet-repl/src/ConsoleHost.rs:65
    pub fn default() -> ConsoleHostAdapters { ConsoleHostAdapters.new() }
}

// Rust: crates/jet-repl/src/ConsoleHost.rs:72
pub fn open_attached(options: ConsoleOptions, adapters: ConsoleHostAdapters) -> ConsoleSession ConsoleError! {
    session := ConsoleSession.open(^options) ?? return Err(err)
    ^adapters.attach(&session)
    ^session
}

// Rust: crates/jet-repl/src/ConsoleHost.rs:83
pub fn run_attached(options: ConsoleOptions, adapters: ConsoleHostAdapters) -> [ConsoleOutput] ConsoleError! {
    script :: ~options.script
    session := open_attached(^options, ^adapters) ?? return Err(err)
    if script == .Val(source) -> &session.run_script(source) ?? return Err(err)
    if !session.is_closed() && !session.is_cancelled() -> &session.close() ?? return Err(err)
    session.outputs().map(fn(output) -> ~output).collect()
}
