// Rust: crates/jet-repl/src/lib.rs:1805
fn repl_completeness_probe(prefix: String, input: String, suffix: String) -> Bool {
    cutoff :: prefix.bytes().len() + input.bytes().len()
    source :: "{prefix}{input}{suffix}"
    (tokens, lex_diags) :: if prefix.is_empty() -> Lexer.lex(source) else -> Lexer.lex_generated(source)
    if !lex_diags.is_empty() {
        return !lex_diags.any(fn(diag) -> diag.code == "E0002" && if diag.span == { .Val(span) -> span.end >= cutoff, .None -> false })
    }
    if Parser.parse_for_check_with_source(tokens, source) == {
        .Ok(_) -> true
        .Err(diags) -> !diags.any(fn(diag) -> if diag.span == { .Val(span) -> span.start >= cutoff, .None -> false })
    }
}
// Rust: crates/jet-repl/src/lib.rs:1795
pub fn raw_input_is_complete(text: String) -> Bool {
    trimmed := text.trim() // #4303
    if trimmed.is_empty() || trimmed.starts_with(":") || trimmed.starts_with("?") || reject_feature(trimmed) != None -> return true
    if looks_like_item(trimmed) || looks_like_import(trimmed) -> return repl_completeness_probe("", trimmed, "")
    if starts_with_stmt_keyword(trimmed) || trimmed.ends_with(";") -> repl_completeness_probe("fn __repl__() {\n", trimmed, "\n}\n")
    else -> repl_completeness_probe("fn __repl__() {\n__repl_echo__ :: ", trimmed, "\n}\n")
}

// Rust: crates/jet-repl/src/lib.rs:1840
pub fn classify(text: String, step: Int) -> InputKind [Diagnostic]! {
    trimmed := text.trim() // #4303
    if trimmed.is_empty() -> return InputKind.Empty
    if trimmed.strip_prefix(":") == .Val(rest) {
        pieces :: rest.splitn(2, " ")
        cmd :: pieces[0]
        arg := String?{None}
        if pieces.len() > 1 {
            value := pieces[1].trim() // #4303
            if !value.is_empty() -> arg = Val(value)
        }
        return InputKind.Meta(cmd, ^arg)
    }
    if trimmed.strip_prefix("?") == .Val(rest) {
        name := rest.trim() // #4303
        return InputKind.Meta("?", if name.is_empty() -> None else -> Val(name))
    }
    if reject_feature(trimmed) == .Val(feature) -> return InputKind.Reject(feature)
    if looks_like_import(trimmed) {
        normalized := trimmed.trim_end() // #4303
        full :: "// repl:{step}\n{normalized}\n"
        (toks, lex_diags) :: Lexer.lex(full)
        if !lex_diags.is_empty() -> return Err(lex_diags)
        prog :: Parser.parse_with_source(toks, full) ?? return Err(err)
        if prog.items.is_empty() && !prog.imports.is_empty() -> return InputKind.Import("{normalized}\n")
    }
    suppress :: trimmed.ends_with(";") && !looks_like_item(trimmed) && !trimmed.ends_with("};")
    if looks_like_item(trimmed) {
        src :: "{trimmed}\n"
        full :: "// repl:{step}\n{src}"
        (toks, lex_diags) :: Lexer.lex(full)
        if !lex_diags.is_empty() -> return Err(lex_diags)
        _ :: Parser.parse_with_source(toks, full) ?? return Err(err)
        return InputKind.Item(src)
    }
    (_, user_lex_diags) :: Lexer.lex(trimmed)
    if !user_lex_diags.is_empty() -> return Err(user_lex_diags)
    try_stmt_first :: starts_with_stmt_keyword(trimmed) || suppress
    plain_input := trimmed.trim_end() // #4303
    plain_src :: "// repl:{step}\nfn __repl__() {\n{plain_input}\n}\n"
    echo_stmt :: "__repl_echo__ :: {trimmed}"
    echo_src :: "// repl:{step}\nfn __repl__() {\n{echo_stmt}\n}\n"
    if try_stmt_first {
        (toks, lex_diags) :: Lexer.lex_generated(plain_src)
        if lex_diags.is_empty() {
            if Parser.parse_with_source(toks, plain_src) == .Ok(prog) {
                if !prog.items.is_empty() {
                    if prog.items[0] == .Func(f) {
                        if !f.body.is_empty() -> return InputKind.Stmts(^f.body, suppress, plain_input)
                    }
                }
            }
        }
    }
    (echo_toks, echo_diags) :: Lexer.lex_generated(echo_src)
    if echo_diags.is_empty() {
        if Parser.parse_with_source(echo_toks, echo_src) == .Ok(prog) {
            if !prog.items.is_empty() {
                if prog.items[0] == .Func(f) {
                    if !f.body.is_empty() -> return InputKind.Stmts(^f.body, suppress, echo_stmt)
                }
            }
        }
    }
    (toks, lex_diags) :: Lexer.lex_generated(plain_src)
    if !lex_diags.is_empty() -> return Err(lex_diags)
    prog :: Parser.parse_with_source(toks, plain_src) ?? return Err(err)
    if !prog.items.is_empty() {
        if prog.items[0] == .Func(f) -> return InputKind.Stmts(^f.body, suppress, plain_input)
    }
    InputKind.Empty
}

