//RS // ── one-shot command-line expression (#2068) ──────────────────────────────
//RS 
//RS /// What one command-line expression produced.
//RS pub struct EvalOnce {
//RS     /// The value the input evaluated to. `None` when the input only bound or
//RS     /// declared something and so has no value to show.
//RS     pub value: Option<CtValue>,
//RS     /// Anything the input printed, in program order.
//RS     pub stdout: String,
//RS     pub stderr: String,
//RS }
//RS 
//RS /// `jet eval "<expression>"` (#2068).
//RS ///
//RS /// One REPL turn against a fresh session: the same `classify` →
//RS /// `type_check_stmts` → `Comptime::run_repl_step` pipeline every interactive
//RS /// turn already uses. A command-line expression and a typed REPL line
//RS /// therefore cannot disagree — there is no second expression evaluator (I8),
//RS /// and the semantics stay in the shared comptime tree-walker while this only
//RS /// marshals (I9).
//RS ///
//RS /// No `EffectPrompt` is attached, so an effect that no `--allow-*` covers is
//RS /// refused with E1803 rather than blocking a non-interactive command on
//RS /// stdin — `jet eval` is the pure/deterministic verb (S60 / D-PURE1).
//RS pub fn eval_once(
//RS     src: &str,
//RS     base_dir: &Path,
//RS     flags: ReplFlags,
//RS ) -> Result<EvalOnce, Vec<Diagnostic>> {
//RS     jet_driver::boot_mir_eval();
//RS     let mut policy = ReplPolicy::new(flags, base_dir);
//RS     let session = Session::new();
//RS 
//RS     let (stmts, suppress, check_src) = match classify(src.trim(), 1)? {
//RS         InputKind::Stmts(stmts, suppress, check_src) => (stmts, suppress, check_src),
//RS         // The one registered E1802 renderer, same as an interactive turn.
//RS         InputKind::Reject(feature) => return Err(vec![e1802(&feature)]),
//RS         // A declaration or import on its own is checked and accepted; it
//RS         // simply has no value to show, exactly like a `run()` that returns
//RS         // nothing. A `:meta` command never reaches here — the CLI rejects it
//RS         // as a malformed argument before calling in.
//RS         InputKind::Meta(..) | InputKind::Item(_) | InputKind::Import(_) | InputKind::Empty => {
//RS             return Ok(EvalOnce {
//RS                 value: None,
//RS                 stdout: String::new(),
//RS                 stderr: String::new(),
//RS             });
//RS         }
//RS     };
//RS 
//RS     let (checked_stmts, core_imports) = type_check_stmts(&session, &stmts, 1, &check_src)?;
//RS     let executable = repl_executable_stmts(checked_stmts);
//RS 
//RS     let funcs: HashMap<String, &Func> = HashMap::new();
//RS     let structs: HashMap<String, &StructDef> = HashMap::new();
//RS     let mut sink = DevSink::new();
//RS     let mut scope: HashMap<String, CtValue> = HashMap::new();
//RS     let mut authorizer = policy.authorizer(None);
//RS     match crate::Comptime::run_repl_step(
//RS         &executable,
//RS         &funcs,
//RS         base_dir,
//RS         &mut sink,
//RS         &mut scope,
//RS         REPL_FUEL_BUDGET,
//RS         suppress,
//RS         &core_imports,
//RS         &structs,
//RS         &session.binding_types,
//RS         &mut authorizer,
//RS     ) {
//RS         Ok(value) => Ok(EvalOnce {
//RS             value,
//RS             stdout: sink.stdout,
//RS             stderr: sink.stderr,
//RS         }),
//RS         Err(diagnostic) => Err(vec![diagnostic]),
//RS     }
//RS }
