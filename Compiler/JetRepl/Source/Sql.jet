// D-DX-SQLSHELL1=A: SQL host uses the ordinary checked REPL session.
// No SQL parser, second evaluator, or SQL-specific values live here.
use jet_ast.[CtValue, Stmt]
use jet_foundation.[Diagnostic]
use jet_comptime.[DevSink, REPL_FUEL_BUDGET, run_repl_step]
use jet_driver.[boot_mir_eval]
use core.files.runtime.kernel_path_components.[OSPath]

// Rust: crates/jet-repl/src/Sql.rs:16
pub struct SqlEval { pub value: CtValue?, pub stdout: String, pub stderr: String }

// Rust: crates/jet-repl/src/Sql.rs:25
pub struct SqlSession {
    session: Session
    policy: ReplPolicy
    base_dir: OSPath

    // Rust: crates/jet-repl/src/Sql.rs:34
    pub fn new(base_dir: OSPath, flags: ReplFlags) -> SqlSession {
        SqlSession{session: Session.new(), policy: ReplPolicy.new(flags, base_dir), base_dir: base_dir}
    }
    // Rust: crates/jet-repl/src/Sql.rs:45
    pub fn execute(&self, input: String) -> SqlEval [Diagnostic]! {
        boot_mir_eval()
        normalized :: normalize_repl_input(input)
        trimmed := normalized.trim() // #4303
        if trimmed.is_empty() -> return SqlEval{value: None, stdout: "", stderr: ""}
        self.session.step = self.session.step + 1
        kind :: classify(trimmed, self.session.step) ?? return Err(err)
        if kind == {
            .Empty -> SqlEval{value: None, stdout: "", stderr: ""}
            .Reject(feature) -> Err([Diagnostic]{e1802(feature)})
            .Meta(command, _) -> Err([Diagnostic]{Diagnostic.error(
                "E1802",
                "SQL console does not accept REPL meta-command `:{command}`",
                "dot commands are handled by `jet db` before Jet source reaches the shared evaluator",
                "use `.help`, `.schema`, `.plan`, `.stats`, or `.quit` in the SQL console",
                None,
            )})
            .Item(_) -> Err([Diagnostic]{Diagnostic.error(
                "E1802",
                "SQL console accepts query expressions, not top-level declarations",
                "declarations would change the shared session's program surface rather than query a typed source",
                "use `define_item` only for the console's generated typed source, then submit SELECT-backed expressions",
                None,
            )})
            .Import(source) -> &self.execute_import(^source)
            .Stmts(stmts, suppress, check_src) -> &self.execute_statements(trimmed, ^stmts, suppress, ^check_src)
        }
    }
    // Rust: crates/jet-repl/src/Sql.rs:94
    pub fn define_item(&self, source: String) -> [Diagnostic]! {
        boot_mir_eval()
        bundle :: type_check_item(self.session, source) ?? return Err(err)
        &self.session.item_srcs.push(source)
        rebuild_funcs(&self.session)
        update_core_imports_from_ledger(bundle, &self.session.core_imports)
    }
    // Rust: crates/jet-repl/src/Sql.rs:105
    pub fn reset(&self) {
        &self.session.reset()
        &self.policy.session.clear()
    }
    // Rust: crates/jet-repl/src/Sql.rs:111
    pub fn session(self) -> &Session { &self.session } // GATE #4500: returned read loan.
    // Rust: crates/jet-repl/src/Sql.rs:116
    pub fn base_dir(self) -> OSPath { self.base_dir }

    // Rust: crates/jet-repl/src/Sql.rs:120
    fn execute_import(&self, source: String) -> SqlEval [Diagnostic]! {
        &self.session.import_srcs.push(^source)
        bundle :: type_check_item(self.session, "") ?? {
            _ :: &self.session.import_srcs.pop()
            return Err(err)
        }
        rebuild_funcs(&self.session)
        update_core_imports_from_ledger(bundle, &self.session.core_imports)
        SqlEval{value: None, stdout: "", stderr: ""}
    }
    // Rust: crates/jet-repl/src/Sql.rs:138
    fn execute_statements(&self, input: String, parsed: [Stmt], suppress: Bool, check_src: String) -> SqlEval [Diagnostic]! {
        (checked_stmts, checked_core_imports) :: type_check_stmts(self.session, parsed, self.session.step, check_src) ?? return Err(err)
        session_binding_names := Set<String>.new()
        loop name in self.session.scope.keys() -> _ :: &session_binding_names.insert(name)
        newly_moved :: collect_moved_names(parsed, session_binding_names, self.session.scope)
        executable :: repl_executable_stmts(~checked_stmts)
        core_imports := ~self.session.core_imports
        loop name in checked_core_imports.keys() -> core_imports[name] = checked_core_imports[name]
        // Ordinary read loans replace Rust maps of borrowed Func/StructDef.
        sink := DevSink.new()
        authorizer := &self.policy.authorizer(None)
        trial_scope := ~self.session.scope
        result :: run_repl_step(executable, self.session.func_defs, self.base_dir, &sink, &trial_scope,
            REPL_FUEL_BUDGET, suppress, core_imports, self.session.struct_defs,
            self.session.binding_types, &authorizer)
        if result == {
            .Ok(value) -> {
                loop name in newly_moved.values() -> _ :: &trial_scope.remove(name)
                self.session.scope = ^trial_scope
                loop name in newly_moved.values() -> _ :: &self.session.moved_names.insert(name)
                raw := input.trim_end_matches(";").trim() // #4303
                if !raw.is_empty() && !raw.starts_with("__repl_echo__") -> &self.session.stmt_srcs.push("{raw};")
                &self.session.record_stmts(checked_stmts)
                summary :: if value == {
                    .Val(live) -> if live != CtValue.Unit -> display_value(live) else -> ""
                    .None -> ""
                }
                &self.session.record_turn_ex(input, ReplTurnStatus.Ok, summary,
                    !sink.stdout.is_empty() || !sink.stderr.is_empty(), None)
                &self.session.remember_success(input)
                SqlEval{value: ^value, stdout: ^sink.stdout, stderr: ^sink.stderr}
            }
            .Err(diagnostic) -> {
                restored :: restore_move_diagnostic(^diagnostic, self.session.moved_names)
                Err([Diagnostic]{if restored.code == "E2202" -> e1801(REPL_FUEL_BUDGET) else -> ^restored})
            }
        }
    }
}
