// D-FE-REPL-DOCS1=B: shared semantic facts own docs and completion identity.
use jet_semindex.[SemanticSymbolIndex, SemanticSymbol, SemanticSymbolKind, SemanticProvenance, build_symbol_db]
use jet_driver.[Driver]
use core.files.host.retained_descriptor as repl_docs_files

// Rust: crates/jet-repl/src/Docs.rs:9
pub fn symbol_index(session: Session) -> SemanticSymbolIndex {
    index := SemanticSymbolIndex.language()
    src :: "{session.import_src()}{session.accumulated_src()}\n"
    trimmed := src.trim() // #4303
    if !trimmed.is_empty() {
        if write_unique_temp_file("docs", src) == .Ok(tmp_path) {
            path_str :: tmp_path.to_string_lossy()
            (_, bundle, facts) :: Driver.check_file_with_effect_facts(path_str, Val((tmp_path, src)), true)
            if bundle == .Val(checked) {
                db :: build_symbol_db(checked, facts)
                loop fact in db.symbols.symbols() {
                    symbol := ~fact
                    if symbol.provenance == .Source(_) -> symbol.provenance = SemanticProvenance.Session
                    &index.push(^symbol)
                }
            }
            _ :: repl_docs_files.remove_file(tmp_path) // GATE #4494: retained native file removal.
        }
    }
    loop name in session.scope.keys() {
        value :: session.scope[name]
        sigil :: if session.mutable_names.contains(name) -> ":=" else -> "::"
        &index.push(SemanticSymbol{
            identity: "session:binding:{name}", name: name, qualified_name: name,
            owner: None, module_path: "this session", kind: SemanticSymbolKind.Local,
            signature: "{name}: {type_name(value)} {sigil} {value.jet_show()}",
            summary: "", examples: [], provenance: SemanticProvenance.Session,
            span: None, lexical_scope: None,
        })
    }
    ^index
}

// Rust: crates/jet-repl/src/Docs.rs:67
pub fn completion_candidates(session: Session, prefix: String, owner: String?) -> [SemanticSymbol] {
    index :: symbol_index(session)
    candidates := [SemanticSymbol]{}
    loop symbol in index.complete_visible(prefix, owner) {
        excluded :: if symbol.kind == { .Keyword | .Parameter -> true, _ -> false }
        if owner != None || !excluded -> &candidates.push(~symbol)
    }
    ^candidates
}

// Rust: crates/jet-repl/src/Docs.rs:88
pub fn dotted_completion_candidates(session: Session, receiver: String, partial: String) -> [SemanticSymbol] {
    if session.scope.get(receiver) == .Val(value) -> return completion_candidates(session, partial, Val(type_name(value)))
    if session.core_imports.get(receiver) == .Val(module) -> return SemanticSymbolIndex.complete_core_module(module, partial)
    []
}

// Rust: crates/jet-repl/src/Docs.rs:102
fn render(symbol: SemanticSymbol) -> String {
    out := "{symbol.signature}\n"
    if !symbol.summary.is_empty() -> &out.push_str("{symbol.summary}\n")
    loop example in symbol.examples -> &out.push_str("Example: {example}\n")
    source :: if symbol.provenance == {
        .Source(module_path) -> module_path
        .Builtin(module) -> module
        .CommandRegistry -> "command registry"
        .Session -> "this session"
    }
    &out.push_str("Source: {source}\n")
    ^out
}

// Rust: crates/jet-repl/src/Docs.rs:123
pub fn lookup(session: Session, name: String) -> String? {
    if Syntax.lookup(name) == .Val(row) -> return Val("{Syntax.display(row)}\n{Syntax.plain_text(row)}")
    index :: symbol_index(session)
    if index.resolve_visible(name) == .Val(symbol) -> return Val(render(symbol))
    if name.split_once(".") == .Val((alias, member)) {
        if session.core_imports.get(alias) == .Val(module) {
            if SemanticSymbolIndex.lookup_core_module_member(module, member) == .Val(symbol) -> return Val(render(symbol))
        }
    }
    None
}
