//RS         let handle = std::thread::spawn(move || {
//RS             let before = jet_scheduler_metric_park_blocks();
//RS             let channel = JetSchedulerChannel::<i64>::bounded(1);
//RS             for _ in 0..n {
//RS                 let sender = channel.sender();
//RS                 let _ = jet_scheduler_spawn(move || {
//RS                     sender.send(1);
//RS                 });
//RS             }
//RS             let mut total = 0i64;
//RS             for _ in 0..n {
//RS                 total += channel
//RS                     .receive()
//RS                     .expect("channel closed before all sends drained");
//RS             }
//RS             jet_scheduler_drain();
//RS             let blocks = jet_scheduler_metric_park_blocks().saturating_sub(before);
//RS             let inner = channel.select_inner();
//RS             let st = inner.state.lock().unwrap();
//RS             (total, blocks, st.send_waiters.len(), st.recv_waiters.len())
//RS         });
//RS 
//RS         let start = Instant::now();
//RS         let budget = Duration::from_secs(120);
//RS         while !handle.is_finished() {
//RS             assert!(
//RS                 start.elapsed() < budget,
