// PORT-PENDING 0542 crates-jet-codegen-src-schedulerhost-module-group: crates/jet-codegen/src/SchedulerHost.rs:1-918
// Translate in place: replace the //RS lines below with the 1:1 Jet port (keep `// Rust: <file>:<line>` anchors).
//RS // Host bindings for the compiled copy of `Prelude/Scheduler.rs`.
//RS //
//RS // I9: there is one scheduler. `Prelude/Scheduler.rs` is the scheduler; AOT
//RS // embeds that source into the generated program and `jet_codegen::scheduler`
//RS // compiles the same source for the Cranelift JIT and the interpreter's ambient
//RS // host. Nothing in this file re-encodes scheduling policy, defaults, or error
//RS // meaning. It only supplies the sibling-prelude symbols that the emitted
//RS // program gets from its own flat module, plus the marshalling the JIT needs.
//RS 
//RS // ---------------------------------------------------------------------------
//RS // Panic boundary. AOT source: Prelude/Core.rs.
//RS // The scheduler asks "may I unwind out of this frame?" before it turns a
//RS // cancel or a deadline into a panic. In an emitted program the answer also
//RS // counts `#Interrupt` handler frames; the JIT host has no interrupt-handler
//RS // prelude, so a scheduler task frame is the whole answer here.
//RS // ---------------------------------------------------------------------------
//RS 
//RS thread_local! {
//RS     static JET_IN_SCHEDULER_TASK: std::cell::Cell<bool> = const { std::cell::Cell::new(false) };
//RS }
//RS 
//RS /// Enter a frame that a scheduler interrupt may unwind out of.
//RS pub fn jet_scheduler_task_panic_enter() {
//RS     JET_IN_SCHEDULER_TASK.with(|c| c.set(true));
//RS }
//RS 
//RS /// Leave that frame.
//RS pub fn jet_scheduler_task_panic_leave() {
//RS     JET_IN_SCHEDULER_TASK.with(|c| c.set(false));
//RS }
//RS 
//RS /// Whether the current JIT frame belongs to a scheduler task. The JIT uses
//RS /// this only to keep a task's runtime trap local until its join boundary has
//RS /// converted it into a `TaskFailure`; a sibling must not observe that trap at
//RS /// its next loop header.
//RS pub fn jet_scheduler_in_task() -> bool {
//RS     JET_IN_SCHEDULER_TASK.with(|c| c.get())
//RS }
//RS 
//RS pub fn jet_scheduler_panic_should_unwind() -> bool {
//RS     JET_IN_SCHEDULER_TASK.with(|c| c.get())
//RS }
//RS 
//RS fn jet_runtime_diagnostic(rendered: String) -> ! {
//RS     // The scheduler may be inside a native wait or a task boundary. Carry the
//RS     // Foundation-rendered report through that boundary; the owning adapter
//RS     // decides the final target edge after cleanup.
//RS     std::panic::panic_any(rendered);
//RS }
//RS 
