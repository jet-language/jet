// Host bindings for the one canonical scheduler; scheduling policy lives in Prelude.Scheduler.
use std.cell.Cell
use std.thread.ThreadLocal
use std.panic.[panic_any]
use jet_foundation.Outcome.jet_render_runtime_stop
use jet_codegen.Entry.scheduler.*
use jet_codegen.Entry.task_group as jet_std

// Rust: crates/jet-codegen/src/SchedulerHost.rs:18
// GATE #4494: task-frame state is real thread-local storage.
JET_IN_SCHEDULER_TASK :: ThreadLocal.new(fn() { Cell.new(false) })
// Rust: crates/jet-codegen/src/SchedulerHost.rs:23
pub fn jet_scheduler_task_panic_enter() -> Unit Never! {
    JET_IN_SCHEDULER_TASK.with(fn(c) { c.set(true) })
}
// Rust: crates/jet-codegen/src/SchedulerHost.rs:28
pub fn jet_scheduler_task_panic_leave() -> Unit Never! {
    JET_IN_SCHEDULER_TASK.with(fn(c) { c.set(false) })
}
// Rust: crates/jet-codegen/src/SchedulerHost.rs:36
pub fn jet_scheduler_in_task() -> Bool Never! {
    JET_IN_SCHEDULER_TASK.with(fn(c) { c.get() })
}
// Rust: crates/jet-codegen/src/SchedulerHost.rs:40
pub fn jet_scheduler_panic_should_unwind() -> Bool Never! {
    JET_IN_SCHEDULER_TASK.with(fn(c) { c.get() })
}
// Rust: crates/jet-codegen/src/SchedulerHost.rs:44
// GATE #4494: carry the actual rendered report through the native unwind boundary.
fn jet_runtime_diagnostic(rendered: String) -> Never Never! {
    panic_any(^rendered)
}
// Rust: crates/jet-codegen/src/SchedulerHost.rs:51
fn jet_scheduler_runtime_stop(msg: String) -> Never Never! {
    report :: jet_render_runtime_stop("E3001", "", 0, "", "", 1, 1, msg, "")
    if jet_scheduler_panic_should_unwind() -> panic_any(report.rendered)
    jet_runtime_diagnostic(report.rendered)
}
// Rust: crates/jet-codegen/src/SchedulerHost.rs:61
pub fn jet_scheduler_runtime_stop_with_report(report: String) -> Never Never! {
    jet_runtime_diagnostic(^report)
}
// Rust: crates/jet-codegen/src/SchedulerHost.rs:65
fn jet_runtime_caught_stop(message: String) -> Unit Never! {
    if message.starts_with("Stop [E") {
        std.io.eprint(message)
        if !message.ends_with('\n') -> std.io.eprintln("")
        return
    }
    report :: jet_render_runtime_stop("E3001", "", 0, "", "", 1, 1, message, "")
    std.io.eprint(report.rendered)
}
// Rust: crates/jet-codegen/src/SchedulerHost.rs:86
// GATE #4494: the ambient host has no Para worker, but retains the shared carrier path.
JET_PARA_DEFER_FAILURE :: ThreadLocal.new(fn() { Cell.new(false) })
// Rust: crates/jet-codegen/src/SchedulerHost.rs:90
#Error
enum JetParaRuntimeFailure {
    SchedulerFatal { msg: String }
}
// Rust: crates/jet-codegen/src/SchedulerHost.rs:101
fn jet_deadline_exceeded(wait_kind: String) -> Never Never! {
    rendered :: jet_std.jet_task_deadline(wait_kind).render()
    jet_std.jet_task_deadline_mark_pending()
    if jet_scheduler_panic_should_unwind() || jet_scheduler_wait_boundary_should_unwind() || jet_typed_deadline_boundary_should_unwind() {
        // GATE #4494: typed native unwind payload, not a flattened task panic.
        panic_any(JetDeadlineUnwind(rendered: ^rendered))
    }
    jet_runtime_diagnostic(^rendered)
}
// Rust: crates/jet-codegen/src/SchedulerHost.rs:121
pub fn jet_scheduler_select_int_channels_timed<T: Send>(channels: &[JetSchedulerChannel<T>], timers: [(U64, T)]) -> T Never! {
    recvs :: channels.iter().map(fn(c) { c.select_inner() }).collect()
    jet_scheduler_select_values(^recvs, timers.into_iter().map(fn(entry) {
        (ms, value) :: ^entry
        (ms, Val(^value))
    }).collect())
}
