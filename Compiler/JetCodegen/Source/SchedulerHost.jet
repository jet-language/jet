//RS // ---------------------------------------------------------------------------
//RS // `#Para` deferred failure. AOT source: Prelude/Core.rs.
//RS // Inside a `#Para` region a failure is carried to the collection point instead
//RS // of raised in the worker. The JIT host has no `#Para` runtime, so the flag is
//RS // never set here — but the one scheduler source keeps its real carrier path.
//RS // ---------------------------------------------------------------------------
//RS 
//RS thread_local! {
//RS     static JET_PARA_DEFER_FAILURE: std::cell::Cell<bool> = const { std::cell::Cell::new(false) };
//RS }
//RS 
//RS enum JetParaRuntimeFailure {
//RS     SchedulerFatal { msg: String },
//RS }
//RS 
//RS // ---------------------------------------------------------------------------
//RS // Task deadline. Clock, budget, and JetDeadlineGuard: one home in
//RS // Prelude/Deadline.rs (card #1747), included above by `lib.rs`'s `scheduler`
//RS // module and by the AOT emission list in `Codegen/mod.rs`, so the two cannot
//RS // drift. The E3003 text comes from the one renderer in Prelude/TaskGroup.rs.
//RS // ---------------------------------------------------------------------------
//RS 
//RS fn jet_deadline_exceeded(wait_kind: &str) -> ! {
//RS     let rendered = jet_std::jet_task_deadline(wait_kind).render();
//RS     jet_std::jet_task_deadline_mark_pending();
//RS     if jet_scheduler_panic_should_unwind()
//RS         || jet_scheduler_wait_boundary_should_unwind()
//RS         || jet_typed_deadline_boundary_should_unwind()
//RS     {
//RS         std::panic::panic_any(JetDeadlineUnwind { rendered });
//RS     }
//RS     jet_runtime_diagnostic(rendered);
//RS }
