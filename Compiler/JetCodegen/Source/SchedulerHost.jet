//RS     /// D-CONC-STREAM1=A drift guard, the behavioral half: one cancellation and
//RS     /// cleanup law means a stream producer and a plain task child are stopped by
//RS     /// the SAME code. Both park at a wait point; the stream is cancelled by
//RS     /// dropping its consumer (`JetStream::drop`) and the task by
//RS     /// `handle.cancel()` (`JetTaskControl::cancel`). Both must unwind at the
//RS     /// wait point, run cleanup on the way out, execute nothing after the wait,
//RS     /// and report `Cancelled` — never `Panicked`. A stream-local shutdown path
//RS     /// makes exactly one of these two columns disagree, which is the drift the
//RS     /// field audit found between the AOT and development builds.
//RS     #[test]
//RS     fn one_cancel_law_stops_a_stream_producer_and_a_task_child_alike() {
//RS         struct CleanupMark(Arc<AtomicBool>);
//RS 
//RS         impl Drop for CleanupMark {
//RS             fn drop(&mut self) {
//RS                 self.0.store(true, Ordering::Release);
//RS             }
//RS         }
//RS 
//RS         // Column one: a stream producer, cancelled by dropping the consumer.
//RS         let stream_cleaned = Arc::new(AtomicBool::new(false));
//RS         let stream_continued = Arc::new(AtomicBool::new(false));
//RS         let cleaned = Arc::clone(&stream_cleaned);
//RS         let continued = Arc::clone(&stream_continued);
//RS         let stream = jet_stream_task(move |sender| {
//RS             let _cleanup = CleanupMark(cleaned);
//RS             assert!(sender.send_stream(1));
//RS             continued.store(true, Ordering::Release);
//RS         });
//RS         let mut iterator = stream.into_iter();
//RS         assert_eq!(iterator.next(), Some(1));
//RS         drop(iterator);
//RS 
//RS         // Column two: a plain task child parked on a channel receive, cancelled
//RS         // through its own control.
//RS         let task_cleaned = Arc::new(AtomicBool::new(false));
//RS         let task_continued = Arc::new(AtomicBool::new(false));
//RS         let cleaned = Arc::clone(&task_cleaned);
//RS         let continued = Arc::clone(&task_continued);
//RS         let channel = JetSchedulerChannel::<i64>::new();
//RS         let parked = channel.clone();
//RS         let control = JetTaskControl::new();
//RS         let join = jet_scheduler_spawn_with_control(
//RS             move || {
//RS                 let _cleanup = CleanupMark(cleaned);
//RS                 let _ = parked.receive();
//RS                 continued.store(true, Ordering::Release);
//RS             },
//RS             control.clone(),
//RS         );
//RS         control.cancel();
//RS         match join.rx.recv_timeout(Duration::from_secs(5)) {
//RS             Ok(JetSchedulerResult::Cancelled) => {}
//RS             _ => unreachable!("a cancelled task child must report Cancelled"),
//RS         }
//RS 
//RS         assert_eq!(
//RS             (
//RS                 stream_cleaned.load(Ordering::Acquire),
//RS                 stream_continued.load(Ordering::Acquire),
//RS             ),
//RS             (
//RS                 task_cleaned.load(Ordering::Acquire),
//RS                 task_continued.load(Ordering::Acquire),
//RS             ),
//RS             "a stream producer and a task child must be freed by one law"
//RS         );
//RS         assert!(stream_cleaned.load(Ordering::Acquire));
//RS         assert!(!stream_continued.load(Ordering::Acquire));
//RS     }
