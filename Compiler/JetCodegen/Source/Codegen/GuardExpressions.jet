// Lower guard, notification, allocator, and terminal expressions from checked TIR.
use jet_foundation.[
    Effect,
    MIRAccess,
    MIRAllocatorKind,
    MIRFieldID,
    MIROperation,
    MIRPreludeABI,
    MIRPreludeFamily,
    MIRSemanticOp,
    MIRValueID,
    TAllocCtor,
    TCallArg,
    TExpr,
    TFieldRef,
    Type,
]

fn jet_codegen_shared_guard_field_path(builder: JetCodegenBuilder, program: JetCodegenProgram, guard_type: Type, path: [TFieldRef]) -> [MIRFieldID] Never! {
    owner_type := jet_codegen_field_owner_type(guard_type)
    fields := [MIRFieldID]{}
    loop reference in path {
        &fields.push(jet_codegen_host_field_id(builder, program, owner_type, reference.name))
        owner_type = jet_codegen_checked_host_field_type(builder, program, owner_type, reference.name)
    }
    fields
}

fn jet_codegen_lower_shared_guard_map(builder: &JetCodegenBuilder, program: JetCodegenProgram, expression: TExpr, guard: TExpr, path: [TFieldRef], editable: Bool) -> MIRValueID {
    lowered_path := jet_codegen_shared_guard_field_path(builder, program, guard.ty, path)
    guard_value := jet_codegen_lower_consuming_value(&builder, program, guard)
    member := if editable -> "map_edit" else -> "map_read"
    carrier := jet_codegen_failure_carrier_for_type(expression.ty)
    call := jet_codegen_intern_route(&builder, program, MIRPreludeFamily.StaticPrelude, "core.shared_guard", member, "jet_shared_guard_map", 3, [Bool]{true, false, false}, None, carrier, MIRPreludeABI.Control)
    jet_codegen_emit_value(&builder, program, expression.span, expression.ty, MIROperation.Semantic{operation: MIRSemanticOp.SharedGuardMap{call: call, guard: guard_value, path: lowered_path, editable: editable}})
}

fn jet_codegen_lower_shared_guard_split(builder: &JetCodegenBuilder, program: JetCodegenProgram, expression: TExpr, guard: TExpr, first: [TFieldRef], second: [TFieldRef], editable: Bool) -> MIRValueID {
    first_path := jet_codegen_shared_guard_field_path(builder, program, guard.ty, first)
    second_path := jet_codegen_shared_guard_field_path(builder, program, guard.ty, second)
    guard_value := jet_codegen_lower_consuming_value(&builder, program, guard)
    carrier := jet_codegen_failure_carrier_for_type(expression.ty)
    map_member := if editable -> "map_edit" else -> "map_read"
    split_member := if editable -> "split_edit" else -> "split_read"
    map_call := jet_codegen_intern_route(&builder, program, MIRPreludeFamily.StaticPrelude, "core.shared_guard", map_member, "jet_shared_guard_map", 3, [Bool]{true, false, false}, None, carrier, MIRPreludeABI.Control)
    call := jet_codegen_intern_route(&builder, program, MIRPreludeFamily.StaticPrelude, "core.shared_guard", split_member, "jet_shared_guard_split", 4, [Bool]{true, false, false, false}, None, carrier, MIRPreludeABI.Control)
    jet_codegen_emit_value(&builder, program, expression.span, expression.ty, MIROperation.Semantic{operation: MIRSemanticOp.SharedGuardSplit{call: call, map_call: map_call, guard: guard_value, first: first_path, second: second_path, editable: editable}})
}

fn jet_codegen_lower_condition_notify(builder: &JetCodegenBuilder, program: JetCodegenProgram, expression: TExpr, condition: TExpr, all: Bool) -> MIRValueID {
    condition_value := jet_codegen_lower_expr(&builder, program, condition)
    member := if all -> "notify_all" else -> "notify_one"
    symbol := if all -> "jet_std::JetCondition::notify_all" else -> "jet_std::JetCondition::notify_one"
    carrier := jet_codegen_failure_carrier_for_type(expression.ty)
    call := jet_codegen_intern_route(&builder, program, MIRPreludeFamily.HandleMethod, "core.shared_guard", member, symbol, 1, [Bool]{true}, None, carrier, MIRPreludeABI.Value)
    jet_codegen_emit_value(&builder, program, expression.span, expression.ty, MIROperation.Semantic{operation: MIRSemanticOp.ConditionNotify{call: call, condition: condition_value, all: all}})
}

fn jet_codegen_lower_alloc_new(builder: &JetCodegenBuilder, program: JetCodegenProgram, expression: TExpr, constructor: TAllocCtor, args: [TCallArg]) -> MIRValueID {
    member := ""
    symbol := ""
    arity := 0
    borrow_mask := [Bool]{}
    kind := MIRAllocatorKind.Arena
    inline_size := Int?{None}
    if constructor == {
        .Arena -> {
            member = "arena.new"
            kind = MIRAllocatorKind.Arena
            if {
                args.len() == 0 -> {
                    symbol = "jet_mem::JetArena::new"
                }
                else -> {
                    symbol = "jet_mem::JetArena::with_capacity"
                    arity = 1
                    borrow_mask = [Bool]{false}
                }
            }
        }
        .Bump -> {
            member = "bump.new"
            kind = MIRAllocatorKind.Bump
            if {
                args.len() == 0 -> {
                    symbol = "jet_mem::JetBump::new"
                }
                else -> {
                    symbol = "jet_mem::JetBump::with_capacity"
                    arity = 1
                    borrow_mask = [Bool]{false}
                }
            }
        }
        .Pool -> {
            member = "pool.new"
            symbol = "jet_mem::JetPool::with_slots"
            arity = 1
            borrow_mask = [Bool]{false}
            kind = MIRAllocatorKind.Pool
        }
        .Fixed(size) -> {
            member = "fixed.new"
            symbol = "jet_mem::JetFixed::new"
            arity = 1
            borrow_mask = [Bool]{false}
            kind = MIRAllocatorKind.Fixed
            inline_size = Val(size)
        }
        .FixedOver -> {
            member = "fixed.over"
            symbol = "jet_mem::JetFixed::over"
            arity = 1
            borrow_mask = [Bool]{true}
            kind = MIRAllocatorKind.Fixed
        }
    }
    if args.len() != arity -> panic("checked allocator argument count disagrees with its canonical Prelude route")
    carrier := jet_codegen_failure_carrier_for_type(expression.ty)
    lowered_args := jet_codegen_lower_static_prelude_args(&builder, program, args, false)
    if lowered_args.len() != borrow_mask.len() -> panic("checked allocator operands disagree with its canonical borrow mask")
    jet_codegen_apply_host_route_access(builder, program, &lowered_args, borrow_mask)
    call := jet_codegen_intern_route(&builder, program, MIRPreludeFamily.StaticPrelude, "core.mem", member, symbol, arity, borrow_mask, None, carrier, MIRPreludeABI.Value)
    jet_codegen_emit_value(&builder, program, expression.span, expression.ty, MIROperation.Semantic{operation: MIRSemanticOp.AllocNew{call: call, kind: kind, inline_size: inline_size, args: lowered_args}})
}

fn jet_codegen_lower_guard_expression(builder: &JetCodegenBuilder, program: JetCodegenProgram, expression: TExpr) -> MIRValueID {
    if expression.kind == {
        .SharedGuardValue(_) -> {
            // The guard lends its payload; reading it must not manufacture a
            // second owner with a raw pointer load. Use the same checked place
            // read as a borrowed field (copy/clone, never a move).
            place :: jet_codegen_lower_expression_place(&builder, program, expression, MIRAccess.Read) ?? panic("checked guard value lost its place")
            jet_codegen_emit_value(&builder, program, expression.span, expression.ty, MIROperation.ReadPlace{place: place})
        }
        .SharedGuardMap(guard, path, editable) -> jet_codegen_lower_shared_guard_map(&builder, program, expression, guard, path, editable)
        .SharedGuardSplit(guard, first, second, editable) -> jet_codegen_lower_shared_guard_split(&builder, program, expression, guard, first, second, editable)
        .ConditionNotify(condition, all) -> jet_codegen_lower_condition_notify(&builder, program, expression, condition, all)
        .AllocNew(constructor, args) -> jet_codegen_lower_alloc_new(&builder, program, expression, constructor, args)
        .Print(value) -> {
            lowered := jet_codegen_lower_expr(&builder, program, value)
            carrier := jet_codegen_failure_carrier_for_type(expression.ty)
            call := jet_codegen_intern_route(&builder, program, MIRPreludeFamily.StaticPrelude, "core.term", "print", "jet_term_write_stdout_line", 2, [Bool]{true, false}, Val(Effect.IO), carrier, MIRPreludeABI.Effect)
            jet_codegen_emit_value(&builder, program, expression.span, expression.ty, MIROperation.Semantic{operation: MIRSemanticOp.Print{call: call, value: lowered}})
        }
        else -> panic("checked expression is not one of the guard-expression lowering cases")
    }
}
