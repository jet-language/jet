    fn http_route_zero_handler_adapter(function: &MirFunction, handler: MirValueId, handler_param_names: &[String]) -> String {
        parameter_count :: self.value_type(function, handler).kind() == {
            .Fn(signature) -> signature.params.len()
            .SendFn(params: params, ..) -> params.len()
            other -> panic("MIR HTTP zero route handler has non-callable type {other.display_name()}")
        }
        if parameter_count != 0 || !handler_param_names.is_empty() { panic("MIR HTTP zero route handler has checked parameters") }
        handler_name :: "__jet_http_zero_route_handler_{handler.0}"
        is_fn :: self.value_type(function, handler).kind() == { .Fn(_) -> true, _ -> false }
        handler_call :: if !self.history_runtime_metadata_enabled() && is_fn { self.fn_value_call("{handler_name}.clone()", &[]) } else { "({handler_name})()" }
        "{{ let {handler_name} = {self.value_move(handler)}; std::sync::Arc::new(move || {{ {handler_call} }}) }}"
    }
    // Rust: crates/jet-codegen/src/Codegen/MIRRust.rs:21650
    fn http_router_register(function: &MirFunction, call: MirPreludeCallId, receiver: MirValueId, path: MirValueId, handler: MirValueId, method: MirHttpMethod, handler_param_names: &[String], contract_json: &String, location: MirPanicLoc) -> String {
        row :: self.prelude_row(call)
        adapted_handler :: if row.member == "mux_add_zero" { self.http_route_zero_handler_adapter(function, handler, handler_param_names) } else { self.http_route_handler_adapter(function, handler, handler_param_names, contract_json) }
        method :: "{method.as_str():?}"
        path :: self.value_slot_reference(path, false)
        args :: if row.member == "mux_add" || row.member == "mux_add_zero" { [self.value_borrow_mut(receiver), method.clone(), path.clone(), adapted_handler] } else {
            file :: "{self.source_file_path(location.file):?}"
            line :: "{location.line}u32"
            [self.value_borrow_mut(receiver), method, path, adapted_handler, file, line, "{contract_json:?}.to_string()"]
        }
        self.prelude_call_args_exact(call, &args)
    }
    // Rust: crates/jet-codegen/src/Codegen/MIRRust.rs:21693
    fn columnar_read(function: &MirFunction, accessor: MirPreludeCallId, base: MirValueId, column: MirFieldId, column_index: USize, index: MirValueId, location: MirPanicLoc?) -> String {
        route :: self.prelude_row(accessor)
        if route.family != .ColumnarAccess || route.module != "core.columnar" || route.symbol.name() != "jet_columns_gather_cell" || route.signature.arity != 3 || route.signature.max_arity != 3 || route.signature.borrow_mask != [true, false, false] { panic("MIR columnar accessor has non-canonical Prelude route") }
        location :: location.unwrap_or_else(fn() { panic("MIR columnar read is missing its instruction source location") })
        file :: "{self.source_file_path(location.file):?}"
        line :: "{location.line}u32"
        base :: self.borrowed_value_reference(function, base, MirAccess.Read)
        index :: self.index_operand(function, index, location)
        "({base}).cell({column_index}usize, {index}, {file}, {line}).jet_col_{self.field_name(column)}()"
    }
    // Rust: crates/jet-codegen/src/Codegen/MIRRust.rs:21726
    fn build_string(parts: &[MirStringPart]) -> String {
        if self.is_core_layer() {
            literal := String.new()
            for part in parts { part == { .Literal(value) -> literal.push_str(value), .Value(_) -> panic("MIR Core string interpolation requires an allocation layer") } }
            return "{literal:?}"
        }
        out := String.from("{ let mut __jet_string = String::new();")
        for part in parts {
            part == {
                .Literal(value) -> out.push_str(&" __jet_string.push_str({value:?});")
                // A shown interpolation hole borrows its value, never consumes it.
                .Value(value) -> out.push_str(&" __jet_string.push_str(&({self.value_borrow(value)}).jet_show());")
            }
        }
        out.push_str(" __jet_string }")
        out
    }
