        expression
    }
    // Rust: crates/jet-codegen/src/Codegen/MIRRust.rs:21770
    fn call(function: &MirFunction, callee: &MirCallee, args: &[MirCallArg], type_args: &[MirType]) -> String {
        invocation :: callee == {
            .User(id) -> {
                row :: self.function_row(id)
                if !row.capture_params.is_empty() { panic("MIR captured function called without a Closure operation") }
                borrow_mask :: self.parameter_borrow_mask(&row.params)
                self.call_symbol_for_function(function, self.function_name(id), args, if row.generic_params.is_empty() { &[] } else { type_args }, Some(&borrow_mask))
            }
            .Associated(function: target, owner: owner) -> self.associated_call(function, target, owner, args, type_args)
            .Method(function: target, owner: owner) -> self.method_call(function, target, owner, args, type_args)
            .TraitMethod(method: method, trait_ref: trait_ref, receiver: receiver) -> self.trait_method_call(function, method, trait_ref, receiver, args, type_args)
            .Core(id) -> self.core_direct_call(function, id, args, type_args)
            .Prelude(id) -> {
                row :: self.prelude_row(id)
                self.validate_prelude_arity(row, args)
                self.call_symbol_for_function(function, self.prelude_symbol(id), args, type_args, Some(&row.signature.borrow_mask))
            }
            .Foreign(id) -> self.foreign_call(function, id, args, type_args)
            .Indirect(value) -> {
                borrow_mask :: self.callable_borrow_mask(self.value_type(function, value))
                self.call_symbol_for_function(function, self.value_owned(value), args, type_args, Some(&borrow_mask))
            }
        }
        self.history_instantiated_call(callee, type_args, invocation)
    }
    // Rust: crates/jet-codegen/src/Codegen/MIRRust.rs:21836
