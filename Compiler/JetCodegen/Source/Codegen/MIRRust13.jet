    // Rust: crates/jet-codegen/src/Codegen/MIRRust.rs:22347
    fn emit_c_abi_records(out: &String) -> {
        for definition in self.program.types {
            c_layout :: definition.layout == { .Some(.C), .Some(.CAligned(..)) -> true, _ -> false }
            if !self.module_selected(definition.module) || !c_layout { continue }
            fields_opt :: definition.kind == { .Struct(fields: fields, ..) -> Some(fields), _ -> None }
            if fields_opt.is_none() { continue }
            fields :: fields_opt.unwrap()
            name :: self.c_abi_record_name(definition)
            definition.layout == {
                .Some(.C) -> out.push_str("#[repr(C)]\n")
                .Some(.CAligned(..)) -> {
                    fact :: definition.layout_alignment.unwrap_or_else(fn() { panic("C ABI record {definition.id:?} has no checked alignment fact") })
                    out.push_str(&"#[repr(C, align({fact.effective_alignment}))]\n")
                }
                _ -> panic("unreachable")
            }
            out.push_str(&"#[derive(Clone, Copy)]\nstruct {name} {{\n")
            for field in fields {
                field_ty :: self.c_abi_type(&field.ty, MirAccess.Read).unwrap_or_else(fn() { panic("C ABI record field {field.id:?} has no checked physical representation") })
                out.push_str(&"    {self.field_name(field.id)}: {field_ty},\n")
            }
            out.push_str("}\n\n")
        }
        self.emit_c_abi_enums(out)
    }
