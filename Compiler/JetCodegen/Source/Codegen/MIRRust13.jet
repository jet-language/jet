    // Rust: crates/jet-codegen/src/Codegen/MIRRust.rs:21853
    fn call_result_is_success(function: &MirFunction, callee: &MirCallee, result: MirValueId) -> Bool {
        result_type :: self.value_type(function, result)
        callee == {
            .User(id) -> Self.result_matches_return_carrier(result_type, &self.function_row(id).return_type)
            .Associated(function: id, ..), .Method(function: id, ..) -> {
                encode :: self.function_row(id).form == { .TraitMethod(serde: .Some(.Encode), ..) -> true, _ -> false }
                if encode { false } else { Self.result_matches_return_carrier(result_type, &self.function_row(id).return_type) }
            }
            .TraitMethod(method: method_id, trait_ref: trait_ref, ..) -> {
                definition :: self.program.traits.iter().find(fn(definition) { definition.id == trait_ref.id }).unwrap_or_else(fn() { panic("MIR trait {trait_ref.id:?} is missing") })
                method :: definition.methods.iter().find(fn(candidate) { candidate.id == method_id }).unwrap_or_else(fn() { panic("MIR trait method {method_id:?} is missing") })
                Self.result_matches_return_carrier(result_type, &method.return_type)
            }
            .Indirect(value) -> {
                return_type :: self.value_type(function, value).kind() == { .Fn(signature) -> signature.ret, .SendFn(ret: ret, ..) -> ret, _ -> None }
                if return_type.is_none() { return false }
                Self.result_matches_return_carrier(result_type, &return_type.unwrap())
            }
            .Core(_), .Prelude(_), .Foreign(_) -> false
        }
    }
    // Rust: crates/jet-codegen/src/Codegen/MIRRust.rs:21911
    fn result_matches_return_carrier(result_type: &MirType, return_type: &MirType) -> Bool {
        return_type.result_parts().is_some_and(fn((success, _)) { result_type.same_checked_type(success) }) || return_type.option_inner().is_some_and(fn(success) { result_type.same_checked_type(success) })
    }
    // Rust: crates/jet-codegen/src/Codegen/MIRRust.rs:21920
    fn associated_call(caller: &MirFunction, function: MirFunctionId, owner: &MirType, args: &[MirCallArg], type_args: &[MirType]) -> String {
        row :: self.function_row(function)
        symbol :: row.form == {
            .Method(owner: declared_owner, self_access: self_access) -> {
                if !declared_owner.same_checked_type(owner) { panic("MIR associated call {function:?} owner does not match its function declaration") }
                if self_access.is_some() { panic("MIR associated call {function:?} targets an instance method with no receiver") }
                if self.owner_independent_static(row) { self.function_name(row.id) } else { "<{self.rust_type(owner)}>::{self.rust_method_symbol(row)}" }
            }
            .TraitMethod(owner: trait_owner, trait_ref: trait_ref, self_access: self_access, ..) -> {
                if !trait_owner.same_checked_type(owner) { panic("MIR associated call {function:?} owner does not match its trait method declaration") }
                if self_access.is_some() { panic("MIR associated call {function:?} targets an instance trait method with no receiver") }
                "<{self.rust_type(owner)} as {self.trait_nominal_name(trait_ref)}>::{self.rust_method_symbol(row)}"
            }
            .TopLevel -> panic("MIR associated call {function:?} does not target a checked associated method")
        }
        borrow_mask :: self.parameter_borrow_mask(&row.params)
        self.call_symbol_for_function(caller, symbol, args, if row.generic_params.is_empty() { &[] } else { type_args }, Some(&borrow_mask))
    }
