// Private continuation of the canonical checked TIR -> MIR expression lowerer.
use jet_foundation.*
use jet_codegen.Codegen.TIR.*
use jet_codegen.Codegen.TIR.mir.*
use jet_codegen.Codegen.[core_source_type_leaf]
use jet_syntax.[TYPE_ERR, TYPE_BYTES, INTERNAL_UNIT_TYPE, core_call]

// Rust: crates/jet-codegen/src/Codegen/TIR/tir_to_mir_expr.rs:6380
fn lower_try_failure(ctx: &LowerCtx, error: MIRValueID, input_ty: @Type, convert: @TTryConvert, note: MIRValueID?, result: @Type, location: TryJourneySite?, carrier: @TFailureCarrier) -> MIRValueID LowerError! {
    converted :: if convert == {
        .NoConversion -> error
        .DefaultErr -> {
            route :: try_conversion_route(convert, input_ty, result, carrier)?
            target :: Type.Named(TYPE_ERR)
            emit_static_call(&ctx, @target, route, [error])?
        }
        .Typed{fn_name: conversion_fn, source, target} -> {
            function :: ctx.function_id_for(conversion_fn)?
            call_return_type :: ctx.function_registry.call_return_type_for(function, []).map_err(fn(message) { ctx.error(ctx.span(), message) })? ?? ~target
            converted :: ctx.emit("try-typed-error-conversion", Val(call_return_type), MIROperation.Call{callee: MIRCallee.User(function), args: [mir_value_arg_with_access(ctx, error, MIRAccess.Move)], type_args: []})?
            if target == .Named(name) && name == TYPE_ERR {
                // Source-owned errors report under the leaf spelling, not owner identity.
                source_value :: ctx.emit("try-conversion-source", Val(Type.String), MIROperation.Constant{value: MIRConstant.String(core_source_type_leaf(source.name()).to_string())})?
                target_value :: ctx.emit("try-conversion-target", Val(Type.String), MIROperation.Constant{value: MIRConstant.String(target.name())})?
                route :: apply_conversion_route()?
                target_error :: Type.Named(TYPE_ERR)
                emit_static_call(&ctx, @target_error, route, [converted, source_value, target_value])?
            } else -> converted
        }
        .WidenUnion{tag, ..} -> {
            union :: if carrier == { .Result{error: union, ..} -> union else -> return Err(ctx.error(ctx.span(), "checked union error widening has no Result failure carrier")) }
            lower_union_widening(&ctx, union, tag, [MIREnumArg{field: None, value: error, boxed: false}])?
        }
        .Never | .ProtocolExit -> return unsupported_expr(ctx, "TExprKind::Try (diverging failure conversion)")
    }
    site :: location ?? return converted
    if try_target_is_default_error(input_ty, convert) {
        if note == Val(value) {
            values := [converted]
            &values.extend(lower_try_context_values(&ctx, site.file, site.line, site.column, site.fn_name)?)
            &values.push(value)
            route :: failure_context_route(result, carrier)?
            target :: Type.Named(TYPE_ERR)
            return emit_static_call(&ctx, @target, route, ^values)
        }
    }
    lower_try_journey(&ctx, result, carrier, note, site)?
    converted
}

// Rust: crates/jet-codegen/src/Codegen/TIR/tir_to_mir_expr.rs:6494
fn lower_or_fallback_expr(ctx: &LowerCtx, expr: @TExpr, value: @TExpr, fallback: @TOrFallback) -> MIRValueID LowerError! {
    value_id :: ctx.lower_child(value)?
    carrier :: if value.ty == {
        .Option(_) -> "option"
        .Result{..} -> "result"
        else -> return unsupported_expr(ctx, "TExprKind::OrFallback (non-carrier operand type {value.ty:?}, operation {value.kind.discriminant():?})")
    }
    (success_is_never, failure_is_never) :: if value.ty == {
        .Result(ok, err) -> (ok.is_never(), err.is_never())
        .Option(_) -> (false, false)
        else -> panic("OrFallback carrier was checked above")
    }
    // Peel one carrier only: checked TIR already nests Result<Option<T>, E> peels.
    success_block :: ctx.new_block(ctx.span(), "or-fallback-success")?
    failure_block :: ctx.new_block(ctx.span(), "or-fallback-failure")?
    join :: ctx.new_block(ctx.span(), "or-fallback-join")?
    condition :: if carrier == "option" -> ctx.emit("or-fallback-option-condition", Val(Type.Bool), MIROperation.OptionIsSome{subject: value_id})?
        else -> ctx.emit("or-fallback-result-condition", Val(Type.Bool), MIROperation.ResultIsOk{subject: value_id})?
    ctx.terminate(MIRTerminator.Branch{condition: condition, then_target: success_block, else_target: failure_block})
    incoming := [MIRPhiIncoming]{}
    ctx.switch_to(success_block)
    success := None as MIRValueID?
    if success_is_never -> ctx.terminate(MIRTerminator.Unreachable{reason: "checked result success is uninhabited"})
    else {
        success_ty :: if carrier == "option" -> value.ty.unwrap_option().map(fn(ty) { ~ty }).ok_or_else(fn() { ctx.error(ctx.span(), "checked fallback option has no value type") })?
            else -> value.ty.unwrap_result().map(fn(types) { ~types.0 }).ok_or_else(fn() { ctx.error(ctx.span(), "checked fallback result has no success type") })?
        success_value :: if carrier == "option" -> ctx.emit("or-fallback-option-value", Val(~success_ty), MIROperation.OptionValue{subject: value_id})?
            else -> ctx.emit("or-fallback-result-value", Val(~success_ty), MIROperation.ResultValue{subject: value_id, ok: true})?
        success = Val(ctx.trait_box_value(success_value, @success_ty, @expr.ty)?)
    }
    source :: ctx.current_block()
    if !ctx.is_terminated() {
        ctx.terminate(MIRTerminator.Jump{target: join})
        if success == Val(value) -> &incoming.push(MIRPhiIncoming{block: source, value: value})
    }
    ctx.switch_to(failure_block)
    fallback_value :: lower_or_fallback_failure(&ctx, expr, value, value_id, fallback, failure_is_never)?
    if fallback_value == Val(value) {
        source :: ctx.current_block()
        if !ctx.is_terminated() {
            ctx.terminate(MIRTerminator.Jump{target: join})
            &incoming.push(MIRPhiIncoming{block: source, value: value})
        }
    }
    if incoming.is_empty() -> return unsupported_expr(ctx, "TExprKind::OrFallback (no reachable value)")
    ctx.switch_to(join)
    ctx.emit("or-fallback-phi", Val(~expr.ty), MIROperation.Phi{incoming: ^incoming})
}

// Rust: crates/jet-codegen/src/Codegen/TIR/tir_to_mir_expr.rs:6613
fn lower_or_fallback_failure(ctx: &LowerCtx, expr: @TExpr, value: @TExpr, value_id: MIRValueID, fallback: @TOrFallback, failure_is_never: Bool) -> MIRValueID? LowerError! {
    // err is bound only on failure; its owned-drop must not exit a success frame.
    ctx.push_lexical_frame()
    error_binding := None as (String, Type?, MIRPlaceID?, MIRValueID?)?
    if failure_is_never -> ctx.terminate(MIRTerminator.Unreachable{reason: "checked result failure is uninhabited"})
    else {
        if value.ty == .Result{err, ..} {
            local :: ambient_err_local()
            previous_type :: &ctx.local_types.remove(local.name)
            previous_place :: &ctx.local_places.remove(local.name)
            previous_value :: &ctx.local_values.remove(local.name)
            error :: ctx.emit("or-fallback-error-value", Val(~err), MIROperation.ResultValue{subject: value_id, ok: false})?
            place :: ctx.bind_local(@local, ~err, false, false, false)?
            _ :: ctx.emit("or-fallback-error-binding", None, MIROperation.WritePlace{place: place, value: error})?
            error_binding = Val((local.name, previous_type, previous_place, previous_value))
        }
    }
    fallback_value :: if failure_is_never -> None else -> lower_fallback_block(&ctx, expr, fallback)?
    ctx.pop_lexical_frame()?
    if error_binding == Val((name, previous_type, previous_place, previous_value)) {
        _ :: &ctx.local_types.remove(name)
        _ :: &ctx.local_places.remove(name)
        _ :: &ctx.local_values.remove(name)
        if previous_type == Val(ty) -> _ :: &ctx.local_types.add(name, ^ty)
        if previous_place == Val(place) -> _ :: &ctx.local_places.add(name, place)
        if previous_value == Val(value) -> _ :: &ctx.local_values.add(name, value)
    }
    fallback_value
}

// Rust: crates/jet-codegen/src/Codegen/TIR/tir_to_mir_expr.rs:6685
// A diverging fallback can project a borrowed payload place without copying it.
pub fn lower_or_fallback_window(ctx: &LowerCtx, expr: @TExpr, value: @TExpr, fallback: @TOrFallback) -> MIRPlaceID? LowerError! {
    diverges :: if fallback == { .Value(value) -> inline_block_diverges(value) else -> true }
    (payload_ty, kind) :: if value.ty == {
        .Option(inner) -> (~inner, MIRPayloadKind.Option)
        .Result(ok, err) if !ok.is_never() && !err.is_never() -> (~ok, MIRPayloadKind.Result{ok: true})
        else -> return None
    }
    if !diverges || payload_ty != expr.ty -> return None
    subject :: ctx.lower_read_window(value)? ?? return None
    condition :: if value.ty == .Option(_) -> ctx.emit("or-fallback-option-condition", Val(Type.Bool), MIROperation.OptionIsSome{subject: subject})?
        else -> ctx.emit("or-fallback-result-condition", Val(Type.Bool), MIROperation.ResultIsOk{subject: subject})?
    success_block :: ctx.new_block(ctx.span(), "or-fallback-success")?
    failure_block :: ctx.new_block(ctx.span(), "or-fallback-failure")?
    ctx.terminate(MIRTerminator.Branch{condition: condition, then_target: success_block, else_target: failure_block})
    ctx.switch_to(failure_block)
    if lower_or_fallback_failure(&ctx, expr, value, subject, fallback, false)?.is_some() -> return Err(ctx.error(ctx.span(), "diverging `??` fallback produced a value"))
    if !ctx.is_terminated() -> ctx.terminate(MIRTerminator.Unreachable{reason: "diverging or-fallback"})
    ctx.switch_to(success_block)
    window :: ctx.read_window_of(subject).ok_or_else(fn() { ctx.error(ctx.span(), "missing checked read window place") })?
    Val(ctx.project_payload_place(window, kind, @payload_ty)?)
}

// Rust: crates/jet-codegen/src/Codegen/TIR/tir_to_mir_expr.rs:6749
fn inline_block_diverges(value: @TExpr) -> Bool Never! {
    if value.kind == .InlineBlock(stmts) {
        last :: stmts.last() ?? return false
        return if last == { .Return{..} | .Break{..} | .BreakValue{..} | .Continue{..} -> true else -> false }
    }
    false
}

// Rust: crates/jet-codegen/src/Codegen/TIR/tir_to_mir_expr.rs:6765
fn lower_fallback_block(ctx: &LowerCtx, expr: @TExpr, fallback: @TOrFallback) -> MIRValueID? LowerError! {
    if fallback == {
        .Value(value) -> {
            if inline_block_diverges(value) {
                if value.kind == .InlineBlock(stmts) -> ctx.lower_nested_stmts(stmts)?
                return None
            }
            source_ty :: @value.ty
            lowered :: ctx.lower_child(value)?
            Val(ctx.trait_box_value(lowered, source_ty, @expr.ty)?)
        }
        .Return(value) -> { ctx.lower_return(value.as_ref())?; None }
        .Panic{message: msg, location: loc} -> {
            values :: [ctx.lower_child(msg)?]
            carrier :: TFailureCarrier.from_checked_type(@expr.ty)
            call :: ctx.intern_prelude_route(require_stop_route("panic", values.len(), @expr.ty, @carrier)?)?
            location :: MIRPanicLoc{file: ctx.source_file_id_for(loc.file), line: loc.line, column: loc.column}
            locals := [MIRPanicLocal]{}
            loop local in loc.locals {
                if ctx.local_id_for(@local.local).ok() == Val(id) -> &locals.push(MIRPanicLocal{name: ~local.display_name, local: id})
            }
            context :: MIRPanicContext{function: ~loc.function, source_line: ~loc.source_line, caret: loc.caret, locals: ^locals}
            _ :: ctx.emit("or-fallback-panic", Val(~expr.ty), MIROperation.Semantic{operation: MIRSemanticOp.RequireStop{call: call, kind: MIRRequireKind.Panic, condition: None, location: location, context: context, values: values, always_stops: true}})?
            ctx.terminate(MIRTerminator.Unreachable{reason: "or-fallback panic"})
            None
        }
        .Break -> {
            target :: ctx.loops.last().map(fn(loop_info) { loop_info.1 }).ok_or_else(fn() { ctx.error(ctx.span(), "fallback break outside loop") })?
            ctx.terminate(MIRTerminator.Jump{target: target})
            None
        }
        .Continue -> {
            target :: ctx.loops.last().map(fn(loop_info) { loop_info.2 }).ok_or_else(fn() { ctx.error(ctx.span(), "fallback continue outside loop") })?
            ctx.terminate(MIRTerminator.Jump{target: target})
            None
        }
        .BreakLabel(label) -> {
            target :: ctx.loops.iter().rev().find(fn(loop_info) { loop_info.0 == Val(label) }).map(fn(loop_info) { loop_info.1 }).ok_or_else(fn() { ctx.error(ctx.span(), "fallback break label not found") })?
            ctx.terminate(MIRTerminator.Jump{target: target})
            None
        }
        .ContinueLabel(label) -> {
            target :: ctx.loops.iter().rev().find(fn(loop_info) { loop_info.0 == Val(label) }).map(fn(loop_info) { loop_info.2 }).ok_or_else(fn() { ctx.error(ctx.span(), "fallback continue label not found") })?
            ctx.terminate(MIRTerminator.Jump{target: target})
            None
        }
    }
}

// Rust: crates/jet-codegen/src/Codegen/TIR/tir_to_mir_expr.rs:6877
fn lower_call_args(ctx: &LowerCtx, args: @[TCallArg]) -> [MIRCallArg] LowerError! {
    lowered := [MIRCallArg]{}
    loop (index, arg) in args {
        value := ctx.lower_call_arg(arg)?
        value.source_index = Val(index)
        &lowered.push(^value)
    }
    lowered
}

// Rust: crates/jet-codegen/src/Codegen/TIR/tir_to_mir_expr.rs:6891
fn lower_extern_arg(ctx: &LowerCtx, arg: @TExternArg) -> MIRCallArg LowerError! {
    lowered := ctx.lower_plain_arg(@arg.value)?
    resource_take :: if arg.value.kind == { .ResourceTake(_) -> true else -> false }
    lowered.access = if arg.mut_borrow -> MIRAccess.Write else if arg.clone || resource_take -> MIRAccess.Move else -> MIRAccess.Read
    lowered.owned_last_use = lowered.access == MIRAccess.Move
    lowered.implicit_clone = arg.clone
    lowered
}

// Rust: crates/jet-codegen/src/Codegen/TIR/tir_to_mir_expr.rs:6909
fn lower_enum_payload(ctx: &LowerCtx, enum_name: String, owner_ty: @Type, variant: String, payload: @TEnumPayload) -> [MIREnumArg] LowerError! {
    if payload == {
        .Unit -> []
        .Positional(args) -> {
            lowered := [MIREnumArg]{}
            loop (index, arg) in args {
                expected :: ctx.enum_payload_type_for(owner_ty, variant, index)?
                &lowered.push(MIREnumArg{field: None, value: lower_enum_arg(&ctx, arg, Val(@expected))?, boxed: arg.boxed})
            }
            lowered
        }
        .Named(fields) -> {
            lowered := [(USize, MIREnumArg)]{}
            loop field in fields {
                (id, order) :: ctx.enum_named_payload_field(enum_name, variant, field.name)?
                expected :: ctx.enum_payload_type_for(owner_ty, variant, order)?
                &lowered.push((order, MIREnumArg{field: Val(id), value: lower_enum_arg(&ctx, @field.value, Val(@expected))?, boxed: field.value.boxed}))
            }
            &lowered.sort_by_key(fn(value) { value.0 })
            loop pair in lowered.windows(2) {
                if pair[0].0 == pair[1].0 -> return Err(ctx.error(ctx.span(), "duplicate checked enum field in `{enum_name}::{variant}`"))
            }
            result := [MIREnumArg]{}
            loop (_, arg) in ^lowered -> &result.push(^arg)
            result
        }
    }
}

// Rust: crates/jet-codegen/src/Codegen/TIR/tir_to_mir_expr.rs:6959
fn lower_enum_arg(ctx: &LowerCtx, arg: @TEnumArg, expected: @Type?) -> MIRValueID LowerError! {
    value :: lower_cloned_value(&ctx, @arg.value, arg.clone)?
    if expected == Val(target) -> ctx.trait_box_value(value, @arg.value.ty, target) else -> value
}

// Rust: crates/jet-codegen/src/Codegen/TIR/tir_to_mir_expr.rs:6969
fn lower_conversion_int(ctx: &LowerCtx, value: I64) -> MIRValueID LowerError! {
    ctx.emit("conversion-parameter-int", Val(Type.IntN{signed: true, bits: 64}), MIROperation.Constant{value: MIRConstant.Int{value: value as Int, width: None, spelling: None}})
}

// Rust: crates/jet-codegen/src/Codegen/TIR/tir_to_mir_expr.rs:6986
fn lower_conversion_float(ctx: &LowerCtx, value: F64) -> MIRValueID LowerError! {
    ctx.emit("conversion-parameter-float", Val(Type.Float), MIROperation.Constant{value: MIRConstant.Float{value: value, f32: false, spelling: None}})
}

// Rust: crates/jet-codegen/src/Codegen/TIR/tir_to_mir_expr.rs:7001
fn lower_conversion_bool(ctx: &LowerCtx, value: Bool) -> MIRValueID LowerError! {
    ctx.emit("conversion-parameter-bool", Val(Type.Bool), MIROperation.Constant{value: MIRConstant.Bool(value)})
}

// Rust: crates/jet-codegen/src/Codegen/TIR/tir_to_mir_expr.rs:7012
fn lower_conversion_string(ctx: &LowerCtx, value: ^String) -> MIRValueID LowerError! {
    ctx.emit("conversion-parameter-string", Val(Type.String), MIROperation.Constant{value: MIRConstant.String(^value)})
}

// Rust: crates/jet-codegen/src/Codegen/TIR/tir_to_mir_expr.rs:7023
fn direct_prelude_route(module: String, member: String, symbol: String, arity: USize, borrow_mask: @[Bool], carrier: @TFailureCarrier) -> TPreludeRoute Never! {
    TPreludeRoute{family: MIRPreludeFamily.StaticPrelude, module: ~module, member: ~member, symbol: MIRSymbol.Prelude(~symbol), signature: MIRCallSignature{arity: arity, max_arity: arity, borrow_mask: ~borrow_mask}, effect: None, fallibility: ~carrier, abi: MIRPreludeABI.Value, authority: None, db_metadata: None}
}

// Rust: crates/jet-codegen/src/Codegen/TIR/tir_to_mir_expr.rs:7049
// task_group_result_tasks maps to Expressions.jet:5866 jet_codegen_task_group_result_tasks.
// Rust: crates/jet-codegen/src/Codegen/TIR/tir_to_mir_expr.rs:7050
// Its nested task_result maps to Expressions.jet:5856 jet_codegen_task_result_type.

// Rust: crates/jet-codegen/src/Codegen/TIR/tir_to_mir_expr.rs:7066
fn task_group_route(kind: MIRTaskGroupKind, tasks_ty: @Type, carrier: @TFailureCarrier) -> TPreludeRoute Never! {
    result :: jet_codegen_task_group_result_tasks(tasks_ty)
    (name, symbol) :: if (kind, result) == {
        (.All, false) -> ("all", "jet_std::jet_task_all")
        (.Race, false) -> ("race", "jet_std::jet_task_race")
        (.Any, false) -> ("any", "jet_std::jet_task_any")
        (.All, true) -> ("all_result", "jet_std::jet_task_all_result")
        (.Race, true) -> ("race_result", "jet_std::jet_task_race_result")
        (.Any, true) -> ("any_result", "jet_std::jet_task_any_result")
    }
    direct_prelude_route("core.tasks", name, symbol, 1, @[false], carrier)
}

// Rust: crates/jet-codegen/src/Codegen/TIR/tir_to_mir_expr.rs:7083
fn lower_select_builder(ctx: &LowerCtx, builder: @TExpr, receivers: &[MIRValueID], timers: &[MIRValueID]) -> Unit LowerError! {
    if builder.kind == {
        .SelectStart -> {}
        .SelectRecv{builder, channel} -> {
            &receivers.push(ctx.lower_child(channel)?)
            lower_select_builder(&ctx, builder, &receivers, &timers)?
        }
        .SelectAfter{builder, duration, value} -> {
            if value.is_some() -> return Err(ctx.error(ctx.span(), "readiness timer arm unexpectedly carries a value"))
            nanoseconds :: TExpr{ty: Type.Int, kind: TExprKind.HandleMethod{receiver: ~duration, operation: THandleOp.DurationNsValue, args: []}, span: ctx.span(), integer_bounds: None, cost: None}
            &timers.push(ctx.lower_child(@nanoseconds)?)
            lower_select_builder(&ctx, builder, &receivers, &timers)?
        }
        else -> return Err(ctx.error(ctx.span(), "select wait has a non-canonical readiness-table builder"))
    }
}

// Rust: crates/jet-codegen/src/Codegen/TIR/tir_to_mir_expr.rs:7126
fn select_payload_type(ty: @Type) -> Type Never! {
    if ty.without_user_tags() == {
        .Tuple(fields) if fields.len() == 2 -> if fields[1].ty.without_user_tags() == { .Option(inner) -> ~inner else -> ~fields[1].ty.without_user_tags() }
        else -> ~ty
    }
}

// Rust: crates/jet-codegen/src/Codegen/TIR/tir_to_mir_expr.rs:7136
fn lower_select_wait(ctx: &LowerCtx, expr: @TExpr, builder: @TExpr, nonblocking: Bool, carrier: @TFailureCarrier) -> MIRValueID LowerError! {
    receivers := [MIRValueID]{}
    timers := [MIRValueID]{}
    lower_select_builder(&ctx, builder, &receivers, &timers)?
    payload :: select_payload_type(@expr.ty)
    receiver_ty :: Type.Apply("Receiver", [payload])
    receiver_list :: ctx.emit("select-receivers", Val(Type.List(receiver_ty)), MIROperation.BuildList{values: ^receivers, trait_coercion: None})?
    timer_list :: ctx.emit("select-timers", Val(Type.List(Type.Int)), MIROperation.BuildList{values: ^timers, trait_coercion: None})?
    (member, symbol) :: if nonblocking -> ("select_try_wait_tagged", "jet_std::jet_select_try_wait_tagged") else -> ("select_wait_tagged", "jet_std::jet_select_wait_tagged")
    call :: ctx.intern_prelude_route(direct_prelude_route("core.tasks", member, symbol, 2, @[true, false], carrier))?
    ctx.emit("select-wait", Val(~expr.ty), MIROperation.Semantic{operation: MIRSemanticOp.Select{call: call, kind: MIRSelectKind.Wait, values: [receiver_list, timer_list]}})
}

// Rust: crates/jet-codegen/src/Codegen/TIR/tir_to_mir_expr.rs:7194
fn lower_prelude_conversion(ctx: &LowerCtx, value: MIRValueID, parameters: ^[MIRValueID], target: @Type, route: ^TPreludeRoute, carrier: @TFailureCarrier) -> MIRValueID LowerError! {
    call :: ctx.intern_prelude_route(^route)?
    line :: ctx.source_line() as USize
    location :: panic_location(ctx, line)
    fallibility :: ctx.lower_call_fallibility(carrier)?
    target_type :: ctx.mir_type(target)?
    ctx.emit("prelude-conversion", Val(~target), MIROperation.Convert{value: value, parameters: ^parameters, target: target_type, conversion: MIRConversion.Prelude{call: call, location: location, fallibility: fallibility}})
}

// Rust: crates/jet-codegen/src/Codegen/TIR/tir_to_mir_expr.rs:7223
fn lower_cloned_value(ctx: &LowerCtx, value: @TExpr, clone: Bool) -> MIRValueID LowerError! {
    value_id :: ctx.lower_child(value)?
    if clone -> ctx.emit("cloned-value", Val(~value.ty), MIROperation.Copy{value: value_id, fact: MIRCopyFact.Materialize}) else -> value_id
}

// Rust: crates/jet-codegen/src/Codegen/TIR/tir_to_mir_expr.rs:7242
fn lower_core_closure_call(ctx: &LowerCtx, expr: @TExpr, kind: @TCoreClosureKind) -> MIRValueID LowerError! {
    site :: ctx.site_id_for(ctx.span(), "core-closure")
    carrier :: TFailureCarrier.from_checked_type(@expr.ty)
    values := [MIRValueID]{}
    closure := None as MIRValueID?
    (mir_kind, grouped_spawn, label) :: if kind == {
        .Spawn{group, site: spawn_site, label, executable, ..} -> {
            if group == Val(group) -> &values.push(ctx.lower_child(group)?)
            site_value :: ctx.emit("core-closure.spawn-site", Val(Type.Int), MIROperation.Constant{value: MIRConstant.Int{value: spawn_site as I64 as Int, width: None, spelling: None}})?
            label_text :: label.map(fn(text) { ~text }) ?? ""
            label_value :: ctx.emit("core-closure.spawn-label", Val(Type.String), MIROperation.Constant{value: MIRConstant.String(~label_text)})?
            &values.extend([site_value, label_value])
            closure = Val(ctx.lower_spawn_lambda(executable)?)
            (MIRCoreClosureKind.Spawn, group.is_some(), label_text)
        }
        .Realtime{rate, frames, executable} -> {
            &values.push(ctx.lower_child(rate)?)
            &values.push(ctx.lower_child(frames)?)
            closure = Val(ctx.lower_lambda(executable)?)
            (MIRCoreClosureKind.Realtime, false, "")
        }
        .Serve{address: addr, executable, ..} -> {
            &values.push(ctx.lower_child(addr)?)
            closure = Val(ctx.lower_lambda_send(executable)?)
            (MIRCoreClosureKind.Serve, false, "")
        }
        .OnInterrupt{callback} -> {
            &values.push(ctx.lower_child(callback)?)
            (MIRCoreClosureKind.OnInterrupt, false, "")
        }
        .Guard{executable, ..} -> { closure = Val(ctx.lower_lambda(executable)?); (MIRCoreClosureKind.Guard, false, "") }
        .OnCommit{handle_name, executable, ..} -> {
            handle_ty :: ctx.local_types.get(handle_name).map(fn(ty) { ~ty }).ok_or_else(fn() { ctx.error(ctx.span(), "missing checked transaction handle `{handle_name}`") })?
            local :: tir_user_local(~handle_name, ctx.span())
            handle :: TExpr{ty: handle_ty, kind: TExprKind.Local(local), span: ctx.span(), integer_bounds: None, cost: None}
            &values.push(ctx.lower_child(@handle)?)
            closure = Val(ctx.lower_lambda(executable)?)
            (MIRCoreClosureKind.OnCommit, false, "")
        }
        .OnRollback{handle_name, executable, ..} -> {
            handle_ty :: ctx.local_types.get(handle_name).map(fn(ty) { ~ty }).ok_or_else(fn() { ctx.error(ctx.span(), "missing checked transaction handle `{handle_name}`") })?
            local :: tir_user_local(~handle_name, ctx.span())
            handle :: TExpr{ty: handle_ty, kind: TExprKind.Local(local), span: ctx.span(), integer_bounds: None, cost: None}
            &values.push(ctx.lower_child(@handle)?)
            closure = Val(ctx.lower_lambda(executable)?)
            (MIRCoreClosureKind.OnRollback, false, "")
        }
