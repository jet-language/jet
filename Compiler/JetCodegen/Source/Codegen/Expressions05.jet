        }
        .GCRead{root} -> {
            root_value :: lower_tlocal_value(&ctx, root)?
            carrier :: TFailureCarrier.from_checked_type(@expr.ty)
            route :: gc_read_route(@expr.ty, @carrier)?
            emit_host_route_call(&ctx, expr, route, [mir_value_arg(ctx, root_value)])
