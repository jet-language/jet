                    .Hole{ty, span, ..} -> {
                        ty :: ty.map(fn(ty) { ~ty }) ?? Type.String
                        &pattern.push(MIRTextPatternPart.Hole{kind: lower_text_hole_kind(ctx, @ty, span)?, ty: lower_pattern_type(ctx, @ty)?, span: span})
