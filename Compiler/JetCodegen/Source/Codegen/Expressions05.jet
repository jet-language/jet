            values := [MIRValueID]{}
            loop hole in holes -> &values.push(ctx.lower_plain_arg(hole)?.value)
            carrier :: TFailureCarrier.from_checked_type(@expr.ty)
            call :: ctx.intern_prelude_route(typed_text_interp_route(kind, @expr.ty, @carrier)?)?
            ctx.emit("host-typed-text-interp", Val(~expr.ty), MIROperation.Semantic{operation: MIRSemanticOp.TypedTextInterp{call: call, kind: kind, literals: ~literals, holes: ^values, trusted_html: ~trusted_html}})
