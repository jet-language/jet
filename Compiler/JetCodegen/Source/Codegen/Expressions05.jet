        .YieldSend{value} -> {
            value :: ctx.lower_child(value)?
            resume :: ctx.new_block(ctx.span(), "yield.resume")?
            cancel :: ctx.new_block(ctx.span(), "yield.cancel")?
            ctx.terminate(MIRTerminator.Yield{value: value, resume: resume, cancel: cancel})
            // Stopping the consumer cancels the producer and runs every active cleanup.
