            carrier :: TFailureCarrier.from_checked_type(@expr.ty)
            route :: expiring_route(false, @expr.ty, @carrier)?
            apply_route_access(ctx, @route, &args)?
            call :: ctx.intern_prelude_route(route)?
            type_args :: [ctx.mir_type(value_ty)?]
            ctx.emit("host-expiring-value-new", Val(~expr.ty), MIROperation.Semantic{operation: MIRSemanticOp.StaticPreludeCall{call: call, args: ^args, owner_type_args: [], type_args: type_args}})
