            context :: MIRPanicContext{function: ~loc.function, source_line: ~loc.source_line, caret: loc.caret, locals: ^locals}
            _ :: ctx.emit("core-sys-set-stop", Val(~expr.ty), MIROperation.Semantic{operation: MIRSemanticOp.RequireStop{call: call, kind: MIRRequireKind.Require, condition: Val(condition), location: location, context: context, values: [shown], always_stops: false}})?
