                    owner_ty = ctx.checked_field_type(@owner_ty, field)?
                }
                &field_paths.push(^fields)
            }
            carrier :: TFailureCarrier.from_checked_type(@expr.ty)
            map_call :: ctx.intern_prelude_route(cell_guard_map_route(editable, result_ty, @carrier)?)?
            split_call :: if field_paths.len() == 2 -> Val(ctx.intern_prelude_route(cell_guard_split_route(editable, result_ty, @carrier)?)?) else -> None
            ctx.emit("cell-guard-project", Val(~expr.ty), MIROperation.Semantic{operation: MIRSemanticOp.CellGuardProject{map_call: map_call, split_call: split_call, guard: guard, paths: ^field_paths, editable: editable, edit_paths_disjoint: edit_paths_disjoint}})
        }
        .TypedText{kind, argument: arg} -> {
            args :: [ctx.lower_plain_arg(arg)?]
            carrier :: TFailureCarrier.from_checked_type(@expr.ty)
            route :: typed_text_route(kind, @expr.ty, @carrier)?
