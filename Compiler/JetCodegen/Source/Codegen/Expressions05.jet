        .ReactiveEffect{executable, ..} -> { closure = Val(ctx.lower_lambda_send(executable)?); (MIRCoreClosureKind.ReactiveEffect, false, "") }
        .UIReactiveRender{executable, ..} -> { closure = Val(ctx.lower_lambda_send(executable)?); (MIRCoreClosureKind.UIMount, false, "") }
        .UIPreview{name, viewport, executable, playground, source_file, source_span, source_start_line, source_start_column, source_end_line, source_end_column, build_id, revision, ..} -> {
            &values.push(ctx.lower_child(name)?)
            if viewport == Val(viewport) -> &values.push(ctx.lower_child(viewport)?)
            closure = Val(ctx.lower_lambda_send(executable)?)
            (MIRCoreClosureKind.UIPreview{playground: playground, source_file: ~source_file, source_span: source_span, source_start_line: source_start_line, source_start_column: source_start_column, source_end_line: source_end_line, source_end_column: source_end_column, build_id: ~build_id, revision: ~revision}, false, "")
        }
        .UIButtonOnClick{label, shortcut, accessible_label, executable, ..} -> {
            &values.push(ctx.lower_child(label)?)
            &values.push(ctx.lower_child(shortcut)?)
            &values.push(ctx.lower_child(accessible_label)?)
            closure = Val(ctx.lower_lambda_send(executable)?)
            (MIRCoreClosureKind.UIAction, false, "")
        }
        .UITextInputOnDrop{state, ime, executable, ..} -> {
            &values.push(ctx.lower_child(state)?)
            &values.push(ctx.lower_child(ime)?)
            closure = Val(ctx.lower_lambda_send(executable)?)
            (MIRCoreClosureKind.UITextInputOnDrop, false, "")
        }
    }
    call :: ctx.intern_prelude_route(core_closure_route(~mir_kind, grouped_spawn, @expr.ty, @carrier)?)?
    ctx.emit("core-closure-call", Val(~expr.ty), MIROperation.Semantic{operation: MIRSemanticOp.CoreClosureCall{call: call, kind: ^mir_kind, values: ^values, closure: closure, site: site, label: label}})
}

// Rust: crates/jet-codegen/src/Codegen/TIR/tir_to_mir_expr.rs:7434
fn lower_tlocal_value(ctx: &LowerCtx, local: @TLocal) -> MIRValueID LowerError! {
    ty :: ctx.local_types.get(local.name).map(fn(ty) { ~ty }).or_else(fn() { ~local.persist_ty }).ok_or_else(fn() { ctx.error(ctx.span(), "checked MIR local `{local.name}` has no type") })?
    expression :: TExpr{ty: ty, kind: TExprKind.Local(~local), span: ctx.span(), integer_bounds: None, cost: None}
    ctx.lower_child(@expression)
}

// Rust: crates/jet-codegen/src/Codegen/TIR/tir_to_mir_expr.rs:7455
// mir_gc_edit_kind maps to Statements.jet:2844 jet_codegen_gc_edit_kind, all eight variants.

// Rust: crates/jet-codegen/src/Codegen/TIR/tir_to_mir_expr.rs:7468
fn gc_edit_site(ctx: @LowerCtx) -> MIRGCEditSiteID Never! {
    span :: ctx.span()
    MIRGCEditSiteID{value: stable_id("gc-edit-site", "{ctx.function.key}|{ctx.function.source_file}|{span.start}|{span.end}")}
}

// Rust: crates/jet-codegen/src/Codegen/TIR/tir_to_mir_expr.rs:7482
fn gc_edit_callback(ctx: @LowerCtx, edit: @TExpr, root_ty: ^Type) -> TLambda Never! {
    span :: ctx.span()
    param :: tir_generated_local("value", span)
    owner_key :: "{ctx.function.key}::gc-edit@{span.start}..{span.end}"
    parameter_symbol :: symbol_id(SymbolKind.Parameter, ctx.function.module_identity, owner_key, param.name)
    ret :: if edit.ty == .Named(name) && name == INTERNAL_UNIT_TYPE -> None else -> Val(~edit.ty)
    TLambda{executable: TLambdaBody.Expr(~edit), source_span: span, frame_schedule: None, frame_schedule_derivation: None,
        capture_facts: TCaptureFacts{escapes: false, needs_fn_mut: false, mutable: [], cloned: [], frozen: [], materialized: [], moved: []},
        host_param_conventions: None, failure_carrier: TFailureCarrier.from_checked_type(@edit.ty),
        effects: TEffectFacts{direct: [], solved: [], call_edges: [], maximal: false, direct_spans: []},
        source_params: [param.name], source_param_symbols: [parameter_symbol], jit_name: "gc_edit_{span.start}_{span.end}", param_types: [^root_ty], ret: ret,
        is_move: true, boxed: false, rc: false, arc: false, captures: [], capture_origins: [:], materialized_captures: [], frozen_captures: [], uses_stack_sentry: false}
}

// Rust: crates/jet-codegen/src/Codegen/TIR/tir_to_mir_expr.rs:7514
fn lower_pattern_probe(ctx: &LowerCtx, expr: @TExpr, matched: MIRValueID, probe: @TMatchProbe) -> MIRValueID LowerError! {
    if probe == TMatchProbe.IsSome -> return ctx.emit("pattern-matched", Val(Type.Bool), MIROperation.PatternMatched{matched: matched})
    types :: if expr.ty == { .Tuple(types) -> types else -> return Err(ctx.error(ctx.span(), "checked pattern captures have no tuple type")) }
    type_id :: ctx.mir_type(@expr.ty)?.identity.ok_or_else(fn() { ctx.error(ctx.span(), "checked pattern tuple has no MIR identity") })?
    fields := [MIRFieldValue]{}
    loop (index, field) in types {
        id :: ctx.field_id_for_type(@expr.ty, field.name)?
        value :: ctx.emit("pattern-capture", Val(~field.ty), MIROperation.PatternCapture{matched: matched, index: index})?
        &fields.push(MIRFieldValue{field: id, value: value})
    }
    ctx.emit("pattern-captures", Val(~expr.ty), MIROperation.Tuple{type_id: type_id, fields: ^fields})
}

// Rust: crates/jet-codegen/src/Codegen/TIR/tir_to_mir_expr.rs:7554
fn lower_host_call(ctx: &LowerCtx, expr: @TExpr, host: @THostCall) -> MIRValueID LowerError! {
    if host == {
        .CarrierFact{receiver: recv, field, notes} -> {
            report_ty :: if recv.ty.without_user_tags() == { .Result{err, ..} -> err else -> recv.ty.without_user_tags() }
            field_id :: ctx.field_id_for_type(report_ty, field)?
            receiver :: ctx.lower_child(recv)?
            carrier :: TFailureCarrier.from_checked_type(@recv.ty)
            call :: ctx.intern_prelude_route(carrier_fact_route(notes, @expr.ty, @carrier)?)?
            ctx.emit("host-carrier-fact", Val(~expr.ty), MIROperation.Semantic{operation: MIRSemanticOp.CarrierFact{call: call, receiver: receiver, field: field_id, notes: notes}})
        }
        .FixedListIndex{base, index, ..} -> {
            place :: ctx.lower_index_place(base, index, MIRIndexKind.FixedListProof, MIRAccess.Read)?
            ctx.emit("host-fixed-list-index", Val(~expr.ty), MIROperation.ReadPlace(place))
        }
        .OptionProbe{inner, kind: TOptionProbe.Field(field)} -> lower_optional_field(&ctx, expr, inner, field, false)
        .TupleIndex{base, index} -> {
            field :: ctx.field_id_for_type(@base.ty, index.to_string())?
            value :: ctx.lower_child(base)?
            ctx.emit("host-tuple-index", Val(~expr.ty), MIROperation.Field{base: value, field: field})
        }
        .FnName(name) -> {
            function :: ctx.function_id_for(name)?
            if ctx.plain_named_fn_value(name, function, @expr.ty, false)? == Val(adapted) -> return adapted
            facts :: MIRCaptureFacts{escapes: false, needs_fn_mut: false, mutable: [], cloned: [], frozen: [], materialized: [], moved: [], frame_schedule: None, frame_schedule_derivation: None}
            ctx.emit("host-function-value", Val(~expr.ty), MIROperation.Closure{function: function, captures: [], facts: facts})
        }
        .MemoStats{name} -> {
            name_value :: ctx.emit("memo-stats-name", Val(Type.String), MIROperation.Constant{value: MIRConstant.String(~name)})?
            bound_value :: ctx.emit("memo-stats-bound", Val(Type.Int), MIROperation.Constant{value: MIRConstant.Int{value: -1, width: None, spelling: None}})?
            carrier :: TFailureCarrier.from_checked_type(@expr.ty)
            route :: memo_stats_route(@expr.ty, @carrier)?
            args :: [mir_value_arg(ctx, name_value), mir_value_arg(ctx, bound_value)]
            emit_host_route_call(&ctx, expr, route, args)
        }
        .Helper{kind, args, ..} -> {
            lowered :: lower_host_args(&ctx, args)?
            carrier :: TFailureCarrier.from_checked_type(@expr.ty)
            route :: helper_route(kind, @expr.ty, @carrier)?
            emit_host_route_call(&ctx, expr, route, lowered)
        }
        .Method{receiver: recv, method, args} -> {
            carrier :: TFailureCarrier.from_checked_type(@expr.ty)
            route :: host_method_route(@recv.ty, method, args.len(), @expr.ty, @carrier)?
            lowered := [MIRCallArg]{}
            mutates_receiver :: (if recv.ty.without_user_tags() == { .Apply{name, ..} -> name == "Pool" else -> false }) && (method == "add" || method == "remove")
            receiver :: if mutates_receiver {
                place :: lower_receiver_place(&ctx, recv, MIRAccess.Write)?.ok_or_else(fn() { ctx.error(ctx.span(), "mutable host receiver has no checked place") })?
                value :: ctx.emit("host-call-place", Val(~recv.ty), MIROperation.ReadPlace(place))?
                argument := mir_value_arg_with_access(ctx, value, MIRAccess.Write)
                argument.place = Val(place)
                argument
            } else -> ctx.lower_plain_arg(recv)?
            &lowered.push(receiver)
            transaction :: method == "read_txn" || method == "edit_txn" || method == "capture_txn"
            if transaction {
                stm :: TLocal.stm()
                stm_value :: lower_tlocal_value(&ctx, @stm)?
                &lowered.push(mir_value_arg(ctx, stm_value))
            }
            loop arg in args -> &lowered.push(ctx.lower_plain_arg(arg)?)
            if lowered.len() != route.signature.arity -> return Err(ctx.error(ctx.span(), "checked host method `{method}` has {lowered.len()} operands, route requires {route.signature.arity}"))
            if transaction {
                lowered[1].access = MIRAccess.Write
                stm :: TLocal.stm()
