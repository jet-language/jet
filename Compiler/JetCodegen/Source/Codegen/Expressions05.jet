        .BinMatchScan{subject, parts, probe} -> {
            value :: ctx.lower_plain_arg(subject)?.value
            pattern := [MIRBinaryPatternPart]{}
            loop part in parts {
                if part == {
                    .Lit(bytes) -> &pattern.push(MIRBinaryPatternPart.Literal(~bytes))
                    .Hole{spec, span, ..} -> if spec == {
                        .Bits{width, endian} -> {
                            ty :: Type.IntN{signed: false, bits: width}
                            &pattern.push(MIRBinaryPatternPart.Bits{width: width, ty: lower_pattern_type(ctx, @ty)?, little: endian == BinEndian.Little, span: span})
                        }
                        .Rest -> {
                            ty :: Type.Named(TYPE_BYTES)
                            &pattern.push(MIRBinaryPatternPart.Rest{ty: lower_pattern_type(ctx, @ty)?, span: span})
                        }
                    }
                }
            }
            shape :: MIRPatternShape.Binary(^pattern, ctx.span())
            matched :: ctx.lower_pattern_match(value, @shape)?
            lower_pattern_probe(&ctx, expr, matched, probe)
        }
        .SwitchSubjectField{field} -> {
            subject :: ctx.switch_subject()?
            subject_ty :: ctx.value_source_type(subject)?
            id :: ctx.field_id_for_type(@subject_ty, field)?
            ctx.emit("switch-subject-field", Val(~expr.ty), MIROperation.Field{base: subject, field: id})
        }
