            value :: ctx.lower_lambda(lambda)?
            key :: "{ctx.function.key}::lambda@{lambda.source_span.start}..{lambda.source_span.end}"
            function :: ctx.nested_functions.iter().find(fn(candidate) { candidate.key == key }).map(fn(candidate) { candidate.id }).ok_or_else(fn() { ctx.error(ctx.span(), "missing lowered C callback lambda") })?
            if lambda.source_params.len() != lambda.param_types.len() -> return Err(ctx.error(lambda.source_span, "C callback lambda parameter names and types differ"))
            params := [MIRParam]{}
            loop (index, name) in lambda.source_params {
                ty :: @lambda.param_types[index]
                &params.push(MIRParam{index: index, name: ~name, span: lambda.source_span, ty: ctx.mir_type(ty)?, access: MIRAccess.Read, ownership: MIROwnership.from_access(MIRAccess.Read), public_label: ~name, variadic: false, default_present: false})
            }
            return_type := None as MIRType?
            if ret == Val(ty) -> return_type = Val(ctx.mir_type(ty)?)
            callback :: MIRCallbackAdapter{id: MIRCallbackID{value: stable_id("mir-callback", "{symbol}|{function.value}")}, symbol: ~symbol, function: function, params: ^params, return_type: return_type, abi: MIRForeignABI.C, managed: managed, plan_digest: ~plan_digest, callback_identity: ~callback_identity}
            existing :: ctx.callbacks.iter().find(fn(row) { row.id == callback.id })
            if existing == Val(row) {
                if "{row:?}" != "{callback:?}" -> return Err(ctx.error(ctx.span(), "conflicting C callback adapter"))
            } else -> &ctx.callbacks.push(~callback)
            carrier :: TFailureCarrier.from_checked_type(@expr.ty)
            route :: c_callback_route(@expr.ty, @carrier)?
            call :: ctx.intern_prelude_route(route)?
            ctx.emit("c-callback", Val(~expr.ty), MIROperation.Semantic{operation: MIRSemanticOp.CCallback{call: call, callback: callback.id, lambda: value}})
        }
    }
}
