            condition :: ctx.emit("core-sys-set-ok", Val(Type.Bool), MIROperation.ResultIsOk{subject: result})?
            failure :: ctx.new_block(ctx.span(), "core-sys-set.failure")?
            join :: ctx.new_block(ctx.span(), "core-sys-set.join")?
            ctx.terminate(MIRTerminator.Branch{condition: condition, then_target: join, else_target: failure})
            ctx.switch_to(failure)
            error :: ctx.emit("core-sys-set-error", Val(Type.Named("EnvError")), MIROperation.ResultValue{subject: result, ok: false})?
            error_ty :: Type.Named("EnvError")
            shown :: lower_direct_string_format(&ctx, error, @error_ty, @StrFormat.Display, @Type.String)?
            carrier :: TFailureCarrier.from_checked_type(@expr.ty)
            route :: require_stop_route("require", 1, @expr.ty, @carrier)?
            call :: ctx.intern_prelude_route(route)?
            location :: MIRPanicLoc{file: ctx.source_file_id_for(loc.file), line: loc.line, column: loc.column}
