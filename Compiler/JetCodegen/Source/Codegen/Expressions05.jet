            root_ty :: ctx.local_types.get(root.name).map(fn(ty) { ~ty }).or_else(fn() { ~root.persist_ty }).ok_or_else(fn() { ctx.error(ctx.span(), "checked MIR GC root `{root.name}` has no type") })?
            root_value :: lower_tlocal_value(&ctx, root)?
