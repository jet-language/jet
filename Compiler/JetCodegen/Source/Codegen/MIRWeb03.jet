            } else {
                rendered := [String]{select_code(kind).to_string()}
                rendered.extend(values(ids))
                prelude(call, ^rendered)?
            }
        }
        .PolicyFunction{policy, values: ids} -> "{value(policy)}({values(ids).join(\", \")})"
        .InterruptFunction{interrupt, values: ids} -> "{value(interrupt)}({values(ids).join(\", \")})"
        .CarrierFact{call, receiver, field, notes} -> js_carrier_fact_expression(program, call, receiver, field, notes)?
        .GcEdit{call, root, edges, edit, index, kind, site} -> js_gc_edit_expression(program, call, root, edges, edit, index, kind, site)?
        .TypedTextInterp{call, kind, literals, holes, trusted_html} -> js_typed_text_interp_expression(program, call, kind, literals, holes, trusted_html)?
        .HttpRouterRegister{call, receiver, path, handler, method, handler_param_names, contract_json, location} ->
            js_http_router_register_expression(program, function, call, receiver, path, handler, method, handler_param_names, contract_json, location)?
        .CCallback{call, callback, lambda} -> js_ccallback_unsupported(program, function, call, callback, lambda)?
    }
    Ok(expression)
}

// Rust: crates/jet-codegen/src/Codegen/MIRWeb.rs:4277
fn js_codec_prelude_expression(program: MirProgram, function: MirFunction, member: String, args: [MirCallArg], type_args: [MirType]) -> String MirWebError! {
    rendered :: js_call_values(program, function, args, false)?
    if member == "decode_typed" {
        if rendered.len() != 1 -> return Err(MirWebError.InvalidMir{message: "MIR typed codec Prelude call has {rendered.len()} arguments, expected one tree"})
        if type_args.len() != 1 -> return Err(MirWebError.InvalidMir{message: "MIR typed codec Prelude call has {type_args.len()} type arguments, expected one target"})
        descriptor :: js_codec_type_descriptor(program, type_args[0])?
        return Ok("jet_codec_decode_typed({rendered[0]}, {descriptor})")
    }
    if rendered.len() != 2 -> return Err(MirWebError.InvalidMir{message: "MIR codec Prelude call {member:?} has {rendered.len()} arguments, expected kind and value"})
    value :: rendered[1]
    if type_args.len() != 1 -> return Err(MirWebError.InvalidMir{message: "MIR codec Prelude call {member:?} has {type_args.len()} type arguments, expected one codec type"})
    ty :: type_args[0]
    if member == "encode" {
        descriptor :: js_codec_type_descriptor(program, ty)?
        return Ok("jet_codec_encode_typed({value}, {descriptor})")
    }
    codec :: ty.nominal_name().ok_or_else(fn() { MirWebError.InvalidMir{message: "MIR codec Prelude call {member:?} has a non-nominal codec type {ty.display_name()}"} })?
    if codec != "Date" && codec != "LocalDate" && codec != "LocalTime" && codec != "DateTime" && codec != "Duration" && codec != "Decimal" {
        return Err(MirWebError.InvalidMir{message: "MIR codec Prelude call {member:?} has unsupported codec type {codec:?}"})
    }
    if member != "decode" -> return Err(MirWebError.InvalidMir{message: "unsupported MIR codec Prelude member {member:?}"})
    decoded :: if codec == {
        "Date" | "LocalDate" -> {
            text :: js_codec_tree_text_expression(value)
            js_codec_result_expression("jet_time_date_parse({text})", "expected {codec}: ")
        }
        "LocalTime" -> {
            text :: js_codec_tree_text_expression(value)
            js_codec_result_expression("jet_time_parse_time({text})", "expected LocalTime: ")
        }
        "DateTime" -> {
            text :: js_codec_tree_text_expression(value)
            js_codec_result_expression("jet_time_parse_rfc3339({text})", "expected DateTime: ")
        }
        "Duration" -> {
            integer :: js_codec_tree_integer_expression(value)
            body :: "(() => {{ const __jet_duration = {integer}; if (__jet_duration < JET_I64_MIN || __jet_duration > JET_I64_MAX) throw new Error(\"expected Duration, found out-of-range Int\"); return jet_time_clamp_i64(__jet_duration); }})()"
            js_codec_result_expression(body, "")
        }
        "Decimal" -> js_codec_result_expression(js_codec_tree_decimal_expression(value), "expected Decimal: ")
        _ -> panic("unreachable codec")
    }
    Ok(decoded)
}

// Rust: crates/jet-codegen/src/Codegen/MIRWeb.rs:4389
fn js_datatree_handle_expression(route: MirPreludeCall, rendered: [String]) -> String MirWebError! {
    (symbol, arity, borrow_mask) :: if route.member == {
        "field" -> ("jet_datatree_field", 2, [Bool]{true, true})
        "at" -> ("jet_datatree_at", 2, [Bool]{true, false})
        "int" -> ("jet_datatree_int", 1, [Bool]{true})
        "text" -> ("jet_datatree_text", 1, [Bool]{true})
        "bool" -> ("jet_datatree_bool", 1, [Bool]{true})
        "float" -> ("jet_datatree_float", 1, [Bool]{true})
        "to_text" -> ("jet_datatree_to_text", 1, [Bool]{true})
        "equal_unordered" -> ("jet_datatree_equal_unordered", 2, [Bool]{true, true})
        other -> return Err(MirWebError.InvalidMir{message: "unsupported DataTree Prelude member {other:?}"})
    }
    if route.signature.arity != arity || route.signature.max_arity != arity || route.signature.borrow_mask != borrow_mask {
        return Err(MirWebError.InvalidMir{message: "MIR DataTree Prelude call {route.member:?} has an invalid signature"})
    }
    symbol_ok :: if route.symbol == { .Prelude(actual) -> actual == symbol _ -> false }
    if !symbol_ok -> return Err(MirWebError.InvalidMir{message: "MIR DataTree Prelude member {route.member:?} has symbol {route.symbol:?}, expected {symbol:?}"})
    if rendered.len() != arity -> return Err(MirWebError.InvalidMir{message: "MIR DataTree Prelude call {route.member:?} has {rendered.len()} arguments, expected {arity}"})
    Ok("{symbol}({rendered.join(\", \")})")
}

// Rust: crates/jet-codegen/src/Codegen/MIRWeb.rs:4443
fn js_codec_user_decode_function(program: MirProgram, target: MirType) -> MirFunctionId MirWebError! {
    candidate := None
    loop implementation in program.impls {
        if implementation.serde != Val(MirSerdeCodec.Decode) || !implementation.self_type.same_checked_type(target) -> continue
        loop id in implementation.methods {
            if program.functions.iter().find(fn(function) { function.id == id }).is_some_and(fn(function) { function.name == "decode" }) {
                candidate = Val(id)
                break
            }
        }
        if candidate.is_some() -> break
    }
    if candidate.is_none() && target.nominal_id() == .Val(type_id) {
        if program.types.iter().find(fn(definition) { definition.id == type_id }) == .Val(definition) {
            if definition.kind == {
                .Struct{methods, ..} | .Enum{methods, ..} -> {
                    loop id in methods {
                        if program.functions.iter().find(fn(function) { function.id == id }).is_some_and(fn(function) { function.name == "decode" }) {
                            candidate = Val(id)
                            break
                        }
                    }
                }
                _ -> {}
            }
        }
    }
    id :: candidate.ok_or_else(fn() { MirWebError.InvalidMir{message: "typed codec target `{target.display_name()}` has no checked Decode function"} })?
    function :: program.functions.iter().find(fn(function) { function.id == id }).ok_or_else(fn() { MirWebError.MissingUserFunction{function: id.0} })?
    if !function.target_applicability.web || !function_in_bucket(function, WebBucket.JS) -> return Err(MirWebError.MissingUserFunction{function: id.0})
    if function.generator.is_some() || web_function_is_async(program, id) -> return Err(MirWebError.InvalidMir{message: "typed codec Decode function {id.0} is async or generator"})
    Ok(id)
}

// Rust: crates/jet-codegen/src/Codegen/MIRWeb.rs:4506
fn js_codec_type_descriptor(program: MirProgram, ty: MirType) -> String MirWebError! {
    if ty.kind == {
        .Int -> Ok("{{ kind: \"int\" }}")
        .Float -> Ok("{{ kind: \"float\" }}")
        .Bool -> Ok("{{ kind: \"bool\" }}")
        .String -> Ok("{{ kind: \"string\" }}")
        .Char -> Ok("{{ kind: \"char\" }}")
        .Float32 -> Ok("{{ kind: \"float32\" }}")
        .IntN{signed, bits} -> Ok("{{ kind: \"intn\", signed: {signed}, bits: {bits}, name: {js_string(ty.display_name())}, byte: {!signed && bits == 8} }}")
        .InlineRange{base, lo, hi} -> Ok("{{ kind: \"range\", base: {js_codec_type_descriptor(program, base)?}, lo: BigInt({lo}), hi: BigInt({hi}) }}")
        .Option(inner) -> Ok("{{ kind: \"option\", inner: {js_codec_type_descriptor(program, inner)?} }}")
        .List(inner) -> Ok("{{ kind: \"list\", element: {js_codec_type_descriptor(program, inner)?} }}")
        .FixedList{elem, len} -> {
            length :: len.literal_value().ok_or_else(fn() { MirWebError.InvalidMir{message: "typed codec fixed-list target `{ty.display_name()}` has a non-literal length"} })?
            Ok("{{ kind: \"fixed_list\", element: {js_codec_type_descriptor(program, elem)?}, length: BigInt({length}) }}")
        }
        .Map{key, value} -> {
            if key.kind != .String -> return Err(MirWebError.InvalidMir{message: "comptime maps require String keys"})
            Ok("{{ kind: \"map\", key: {js_codec_type_descriptor(program, key)?}, value: {js_codec_type_descriptor(program, value)?} }}")
        }
        .Shared(inner) | .Tagged{inner, ..} -> js_codec_type_descriptor(program, inner)
        .Apply{name, ..} -> {
            if name.name == {
                "Data" | "DataTree" -> Ok("{{ kind: \"datatree\" }}")
                "Date" -> Ok("{{ kind: \"date\" }}")
                "LocalDate" -> Ok("{{ kind: \"local_date\" }}")
                "LocalTime" -> Ok("{{ kind: \"local_time\" }}")
                "DateTime" -> Ok("{{ kind: \"datetime\" }}")
                "Duration" -> Ok("{{ kind: \"duration\" }}")
                "Decimal" -> Ok("{{ kind: \"decimal\" }}")
                "I8" | "I16" | "I32" | "I64" | "I128" | "U8" | "U16" | "U32" | "U64" | "U128" -> {
                    signed :: name.name.starts_with('I')
                    bits := name.name[1..] // #4303
                    Ok("{{ kind: \"intn\", signed: {signed}, bits: {bits}, name: {js_string(name.name)}, byte: {!signed && name.name == \"U8\"} }}")
                }
                _ -> {
                    id :: js_codec_user_decode_function(program, ty)?
                    Ok("{{ kind: \"user\", name: {js_string(ty.display_name())}, decode: (tree) => jet_fn_{id.0}([], [tree]) }}")
                }
            }
        }
        _ -> Err(MirWebError.InvalidMir{message: "unsupported typed codec target `{ty.display_name()}` in Web adapter"})
    }
}

// Rust: crates/jet-codegen/src/Codegen/MIRWeb.rs:4602
fn js_codec_tree_text_expression(tree: String) -> String {
    "(() => {{ const __jet_tree = {tree}; switch (__jet_tree?.tag) {{ case \"Text\": case \"TypedText\": return String(__jet_tree.values?.[0]); case \"Int\": return BigInt(__jet_tree.values?.[0]).toString(); case \"Float\": return String(__jet_tree.values?.[0]); case \"Bool\": return __jet_tree.values?.[0] ? \"true\" : \"false\"; case \"Number\": throw new Error(\"expected Text, found number \" + String(__jet_tree.values?.[0])); default: throw new Error(\"expected Text, found \" + String(__jet_tree?.tag ?? \"value\")); }} }})()"
}
// Rust: crates/jet-codegen/src/Codegen/MIRWeb.rs:4615
fn js_codec_tree_integer_expression(tree: String) -> String {
    "(() => {{ const __jet_tree = {tree}; switch (__jet_tree?.tag) {{ case \"Int\": return BigInt(__jet_tree.values?.[0]); case \"Number\": case \"Text\": {{ const __jet_text = String(__jet_tree.values?.[0]).trim(); try {{ return BigInt(__jet_text); }} catch (_) {{ throw new Error(\"expected Int, found text \" + JSON.stringify(__jet_text)); }} }} case \"Float\": {{ const __jet_number = Number(__jet_tree.values?.[0]); if (!Number.isFinite(__jet_number) || !Number.isInteger(__jet_number) || __jet_number < Number(JET_I64_MIN) || __jet_number >= Number(JET_I64_MAX)) throw new Error(\"expected Int, found out-of-range Float\"); return BigInt(__jet_number); }} default: throw new Error(\"expected Int, found \" + String(__jet_tree?.tag ?? \"value\")); }} }})()"
}
// Rust: crates/jet-codegen/src/Codegen/MIRWeb.rs:4636
fn js_codec_tree_decimal_expression(tree: String) -> String {
    "(() => {{ const __jet_tree = {tree}; switch (__jet_tree?.tag) {{ case \"Number\": case \"Text\": return jet_decimal_from_str(String(__jet_tree.values?.[0])); case \"Int\": return jet_decimal_from_str(BigInt(__jet_tree.values?.[0]).toString()); case \"TypedText\": throw new Error(\"expected Decimal, found text \" + JSON.stringify(__jet_tree.values?.[0])); default: throw new Error(\"expected Decimal, found \" + String(__jet_tree?.tag ?? \"value\")); }} }})()"
}
// Rust: crates/jet-codegen/src/Codegen/MIRWeb.rs:4650
fn js_codec_result_expression(body: String, prefix: String) -> String {
    "(() => {{ const __jet_codec_result = jet_time_result(() => {body}); if (__jet_codec_result.tag === \"Ok\") return __jet_codec_result; return {{ tag: \"Err\", values: [[{{ path: \"\", reason: {js_string(prefix)} + String(__jet_codec_result.values?.[0] ?? \"\") }}]] }}; }})()"
}

// Rust: crates/jet-codegen/src/Codegen/MIRWeb.rs:4659
fn js_conversion_expression(program: MirProgram, value_id: MirValueId, parameters: [MirValueId], target: MirType, conversion: MirConversion) -> String MirWebError! {
    if target.identity == .Val(type_id) { ensure_type_instance(program, type_id)? }
    value :: "__jet_values.get({value_id.0})"
    if conversion == {
        .Transparent -> Ok(value)
        .NumericCast -> {
            if !parameters.is_empty() -> return Err(MirWebError.InvalidMir{message: "numeric cast has parameters"})
            Ok(if target.is_integer() -> "BigInt({value})" else if target.kind() == .Float32 -> "Math.fround(Number({value}))" else -> "Number({value})")
        }
        .SendFn -> {
            if !parameters.is_empty() -> return Err(MirWebError.InvalidMir{message: "SendFn MIR conversion has parameters"})
            Ok(value)
        }
        .Prelude{call, location, ..} -> {
            route :: program.prelude_calls.iter().find(fn(route) { route.id == call }).ok_or_else(fn() { MirWebError.MissingPreludeCall{call: call.0} })?
            if route.signature.max_arity != route.signature.arity -> return Err(MirWebError.InvalidMir{message: "MIR conversion Prelude call {call.0} does not have an exact arity"})
            args := [String].with_capacity(parameters.len() + 3)
            args.push(value)
            loop id in parameters { args.push("__jet_values.get({id.0})") }
            if route.signature.arity.checked_sub(args.len()) == {
                .Val(0) -> {}
                .Val(2) -> { args.push(js_source_file_path(program, location.file)?); args.push(location.line.to_string()) }
                .Val(additional) -> return Err(MirWebError.InvalidMir{message: "MIR conversion Prelude call {call.0} requires unsupported context arity {additional}"})
                .None -> return Err(MirWebError.InvalidMir{message: "MIR conversion Prelude call {call.0} has fewer arguments than its value/parameter prefix"})
            }
            js_prelude_call_expression(program, call, args)
        }
    }
}

// Rust: crates/jet-codegen/src/Codegen/MIRWeb.rs:4741
fn validate_owner_type_args(program: MirProgram, type_args: [MirPreludeTypeArg]) MirWebError! {
    loop type_arg in type_args {
        if type_arg == .Type(ty) {
            if ty.identity == .Val(type_id) { ensure_type_instance(program, type_id)? }
        }
    }
    Ok(())
}
// Rust: crates/jet-codegen/src/Codegen/MIRWeb.rs:4753
fn ensure_type_instance(program: MirProgram, id: MirTypeId) MirWebError! {
    loop ty in program.type_instances { if ty.identity == Val(id) -> return Ok(()) }
    Err(MirWebError.InvalidMir{message: "MIR type instance {id.0} is missing"})
}
// Rust: crates/jet-codegen/src/Codegen/MIRWeb.rs:4770
fn validate_type_args(program: MirProgram, types: [MirType]) MirWebError! {
    loop ty in types { if ty.identity == .Val(type_id) { ensure_type_instance(program, type_id)? } }
    Ok(())
}
// Rust: crates/jet-codegen/src/Codegen/MIRWeb.rs:4782
fn ensure_enum_variant(program: MirProgram, owner: MirTypeId, variant: String, payload_index: USize?) MirWebError! {
    ensure_type_instance(program, owner)?
    type_def :: program.types.iter().find(fn(type_def) { type_def.id == owner }).ok_or_else(fn() { MirWebError.InvalidMir{message: "MIR enum type definition {owner.0} is missing"} })?
    if type_def.kind == .Enum{variants, ..} {
        declared :: variants.iter().find(fn(candidate) { candidate.name == variant }).ok_or_else(fn() { MirWebError.InvalidMir{message: "MIR enum {owner.0} has no variant {variant}"} })?
        if payload_index == .Val(index) {
            arity :: if declared.payload == { .Unit -> 0 .Single(_) -> 1 .Named(fields) -> fields.len() }
            if index >= arity -> return Err(MirWebError.InvalidMir{message: "MIR enum {owner.0} variant {variant} has no payload index {index}"})
        }
        return Ok(())
    }
    Err(MirWebError.InvalidMir{message: "MIR enum operation owner {owner.0} is not an enum"})
}
// Rust: crates/jet-codegen/src/Codegen/MIRWeb.rs:4822
fn js_field_name(program: MirProgram, id: MirFieldId) -> String MirWebError! {
    row :: program.fields.iter().find(fn(row) { row.id == id }).ok_or_else(fn() { MirWebError.InvalidMir{message: "MIR field {id.0} is missing"} })?
    Ok(row.field.name.clone())
}

// Rust: crates/jet-codegen/src/Codegen/MIRWeb.rs:4836
fn js_shared_guard_map_expression(program: MirProgram, call: MirPreludeCallId, guard: String, path: [MirFieldId], editable: Bool) -> String MirWebError! {
    expression := ^guard
    loop field in path {
        field_name :: js_field_name(program, field)?
        expression = js_prelude_call_expression(program, call, [String]{^expression, js_string(field_name), editable.to_string()})?
    }
    Ok(^expression)
}
// Rust: crates/jet-codegen/src/Codegen/MIRWeb.rs:4859
fn js_shared_guard_split_expression(program: MirProgram, map_call: MirPreludeCallId, split_call: MirPreludeCallId, guard: String, first: [MirFieldId], second: [MirFieldId], editable: Bool, result_type: MirType?) -> String MirWebError! {
    if first.is_empty() || second.is_empty() -> return Err(MirWebError.InvalidMir{message: "MIR shared guard split has an empty checked field path"})
    common := 0 as USize
    loop (left, right) in first.iter().zip(second) { if left != right -> break; common += 1 }
    if common == first.len() || common == second.len() -> return Err(MirWebError.InvalidMir{message: "MIR shared guard split paths are identical or prefix-related"})
    mapped :: js_shared_guard_map_expression(program, map_call, ^guard, first[..common], editable)?
    first_name :: js_field_name(program, first[common])?
    second_name :: js_field_name(program, second[common])?
    split :: js_prelude_call_expression(program, split_call, [String]{mapped, js_string(first_name), js_string(second_name), editable.to_string()})?
    first_guard :: js_shared_guard_map_expression(program, map_call, "__jet_shared_split[0]", first[common + 1..], editable)?
    second_guard :: js_shared_guard_map_expression(program, map_call, "__jet_shared_split[1]", second[common + 1..], editable)?
    js_guard_pair_expression(program, result_type, split, first_guard, second_guard, "__jet_shared_split")
}
// Rust: crates/jet-codegen/src/Codegen/MIRWeb.rs:4921
fn js_guard_pair_expression(program: MirProgram, result_type: MirType?, split: String, first_guard: String, second_guard: String, split_binding: String) -> String MirWebError! {
    ty :: result_type.ok_or_else(fn() { MirWebError.InvalidMir{message: "MIR guard split has no result type"} })?
    type_id :: ty.identity.ok_or_else(fn() { MirWebError.InvalidMir{message: "MIR guard split result has no type identity"} })?
    ensure_type_instance(program, type_id)?
    type_def :: program.types.iter().find(fn(type_def) { type_def.id == type_id }).ok_or_else(fn() { MirWebError.InvalidMir{message: "MIR guard split result type {type_id.0} is missing"} })?
    if type_def.kind == .Struct{fields, ..} {
        if fields.len() != 2 -> return Err(MirWebError.InvalidMir{message: "MIR guard split result type {type_id.0} does not have two fields"})
        first_key :: js_string(js_field_name(program, fields[0].id)?)
        second_key :: js_string(js_field_name(program, fields[1].id)?)
        return Ok("(() => {{ const {split_binding} = {split}; return {{ {first_key}: {first_guard}, {second_key}: {second_guard} }}; }})()")
    }
    Err(MirWebError.InvalidMir{message: "MIR guard split result type {type_id.0} is not a two-field struct"})
}
// Rust: crates/jet-codegen/src/Codegen/MIRWeb.rs:4965
fn js_cell_guard_map_expression(program: MirProgram, call: MirPreludeCallId, guard: String, path: [MirFieldId], _editable: Bool) -> String MirWebError! {
    expression := ^guard
    loop field in path {
        field_name :: js_field_name(program, field)?
        expression = js_prelude_call_expression(program, call, [String]{^expression, js_string(field_name)})?
    }
    Ok(^expression)
}
// Rust: crates/jet-codegen/src/Codegen/MIRWeb.rs:4984
fn js_cell_guard_project_expression(program: MirProgram, map_call: MirPreludeCallId, split_call: MirPreludeCallId?, guard: String, paths: [[MirFieldId]], editable: Bool, edit_paths_disjoint: Bool, result_type: MirType?) -> String MirWebError! {
    if paths.len() < 1 || paths.len() > 2 || paths.iter().any(fn(path) { path.is_empty() }) -> return Err(MirWebError.InvalidMir{message: "MIR Cell guard projection has an invalid checked path shape"})
    is_split :: paths.len() == 2
    if split_call.is_some() != is_split -> return Err(MirWebError.InvalidMir{message: "MIR Cell guard projection path arity disagrees with its split row"})
    if edit_paths_disjoint && (!editable || !is_split) -> return Err(MirWebError.InvalidMir{message: "MIR Cell guard edit disjointness proof has an invalid shape"})
    if editable && is_split && !edit_paths_disjoint -> return Err(MirWebError.InvalidMir{message: "MIR editable Cell guard split is missing disjoint paths proof"})
    if !is_split -> return js_cell_guard_map_expression(program, map_call, ^guard, paths[0], editable)
    first :: paths[0]
    second :: paths[1]
    common := 0 as USize
    loop (left, right) in first.iter().zip(second) { if left != right -> break; common += 1 }
    if common == first.len() || common == second.len() -> return Err(MirWebError.InvalidMir{message: "MIR Cell guard split paths are identical or prefix-related"})
    mapped :: js_cell_guard_map_expression(program, map_call, ^guard, first[..common], editable)?
    first_name :: js_field_name(program, first[common])?
    second_name :: js_field_name(program, second[common])?
    call :: split_call.ok_or_else(fn() { MirWebError.InvalidMir{message: "MIR Cell guard split has no exact split row"} })?
    split :: js_prelude_call_expression(program, call, [String]{mapped, js_string(first_name), js_string(second_name)})?
    first_guard :: js_cell_guard_map_expression(program, map_call, "__jet_cell_split[0]", first[common + 1..], editable)?
    second_guard :: js_cell_guard_map_expression(program, map_call, "__jet_cell_split[1]", second[common + 1..], editable)?
    js_guard_pair_expression(program, result_type, split, first_guard, second_guard, "__jet_cell_split")
}

// Rust: crates/jet-codegen/src/Codegen/MIRWeb.rs:5075
fn js_source_file_path(program: MirProgram, id: MirSourceFileId) -> String MirWebError! {
    file :: program.source_files.iter().find(fn(file) { file.id == id }).ok_or_else(fn() { MirWebError.InvalidMir{message: "MIR source file {id.0} is missing"} })?
    Ok(js_string(file.path))
}
// Rust: crates/jet-codegen/src/Codegen/MIRWeb.rs:5086
fn js_function_stack_context(program: MirProgram, function: MirFunction) -> (String, U32, String) MirWebError! {
    file :: program.source_files.iter().find(fn(file) { file.id == function.source_file }).ok_or_else(fn() { MirWebError.InvalidMir{message: "MIR source file {function.source_file.0} is missing"} })?
    (line, _) :: span_line_col(file.source, function.span.start)
    source_line := file.source.lines().nth(line.saturating_sub(1)).unwrap_or_default().trim_end() // #4303
    Ok((js_string(file.path), line as U32, js_string(source_line)))
}
// Rust: crates/jet-codegen/src/Codegen/MIRWeb.rs:5108
fn js_text_hole_kind(kind: MirTextHoleKind) -> String {
    if kind == {
        .Text -> "{{ kind: \"text\" }}"
        .Int -> "{{ kind: \"int\" }}"
        .Float -> "{{ kind: \"float\" }}"
        .Bool -> "{{ kind: \"bool\" }}"
        .InlineRange{lo, hi} -> "{{ kind: \"inline_range\", lo: {lo}, hi: {hi} }}"
    }
}
// Rust: crates/jet-codegen/src/Codegen/MIRWeb.rs:5120
fn js_text_pattern_parts(program: MirProgram, parts: [MirTextPatternPart]) -> String MirWebError! {
    rendered := [String]{}
    loop part in parts {
        if part == {
            .Literal(value) -> rendered.push("{{ kind: \"literal\", value: {js_string(value)} }}")
            .Hole{kind, ty, ..} -> {
                ensure_type_instance(program, ty)?
                rendered.push("{{ kind: \"hole\", hole_kind: {js_text_hole_kind(kind)} }}")
            }
        }
    }
    Ok("[{rendered.join(\", \")}]")
}
// Rust: crates/jet-codegen/src/Codegen/MIRWeb.rs:5142
fn js_binary_pattern_parts(program: MirProgram, parts: [MirBinaryPatternPart]) -> String MirWebError! {
    rendered := [String]{}
    loop part in parts {
        if part == {
            .Literal(values) -> {
                bytes := [String]{}
                loop value in values { bytes.push(value.to_string()) }
                rendered.push("{{ kind: \"literal\", value: new Uint8Array([{bytes.join(\", \")}]) }}")
            }
            .Bits{width, ty, little, ..} -> {
                ensure_type_instance(program, ty)?
                rendered.push("{{ kind: \"bits\", width: {width}, little: {little} }}")
            }
            .Rest{ty, ..} -> { ensure_type_instance(program, ty)?; rendered.push("{{ kind: \"rest\" }}") }
        }
    }
    Ok("[{rendered.join(\", \")}]")
}

// Rust: crates/jet-codegen/src/Codegen/MIRWeb.rs:5170
fn web_trait_method_targets(program: MirProgram, method_id: MirTraitMethodId, trait_ref: MirTraitRef) -> ([(MirTypeId, MirFunctionId)], MirFunctionId?) MirWebError! {
    trait_def :: program.traits.iter().find(fn(definition) { definition.id == trait_ref.id }).ok_or_else(fn() { MirWebError.InvalidMir{message: "MIR trait {trait_ref.id.0} is missing"} })?
    method :: trait_def.methods.iter().find(fn(method) { method.id == method_id }).ok_or_else(fn() { MirWebError.InvalidMir{message: "MIR trait method {method_id.0} is missing"} })?
    targets := [(MirTypeId, MirFunctionId)]{}
    loop impl_row in program.impls {
        if impl_row.trait_ref == .Val(impl_trait) {
            if impl_trait.id != trait_ref.id -> continue
            type_id :: impl_row.self_type.identity.ok_or_else(fn() { MirWebError.InvalidMir{message: "MIR impl {impl_row.id.0} has no self type identity"} })?
            loop function_id in impl_row.methods {
                function :: program.functions.iter().find(fn(function) { function.id == function_id }).ok_or_else(fn() { MirWebError.InvalidMir{message: "MIR impl {impl_row.id.0} references a missing function"} })?
                if function.name == method.name && function.form == .TraitMethod{trait_ref: function_trait, ..} {
                    if function_trait.id != trait_ref.id -> continue
                    if targets.iter().any(fn(pair) { pair.0 == type_id }) {
                        return Err(MirWebError.InvalidMir{message: "MIR trait method {method_id.0} has ambiguous implementations for type {type_id.0}"})
                    }
                    targets.push((type_id, function_id))
                }
            }
        }
    }
    Ok((^targets, method.default))
}
