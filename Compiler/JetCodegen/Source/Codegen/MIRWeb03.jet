fn js_ccallback_unsupported(program: MirProgram, function: MirFunction, call: MirPreludeCallId, callback: MirCallbackId, lambda: MirValueId) -> String MirWebError! {
    adapter :: program.callbacks.iter().find(fn(adapter) { adapter.id == callback }).ok_or_else(fn() { MirWebError.InvalidMir{message: "MIR callback adapter {callback.0} is missing"} })?
    if adapter.symbol.is_empty() -> return Err(MirWebError.InvalidMir{message: "MIR callback adapter {callback.0} has no symbol"})
    if !program.functions.iter().any(fn(candidate) { candidate.id == adapter.function }) -> return Err(MirWebError.MissingUserFunction{function: adapter.function.0})
    _ :: mir_function_value_type(function, lambda)?
    _ :: js_prelude_call_expression(program, call, [String]{"__jet_values.get({lambda.0})"})?
    Err(MirWebError.InvalidMir{message: "MIR C callback adapter {callback.0} is not applicable to the Web target"})
}

// Rust: crates/jet-codegen/src/Codegen/MIRWeb.rs:3599
// Browser publication cannot provide a Component Model host boundary.
fn js_plugin_invoke_unsupported(program: MirProgram, call: MirPreludeCallId, export_name: String, signature: ComponentSignatureDescriptor) -> String MirWebError! {
    route :: program.prelude_calls.iter().find(fn(row) { row.id == call }).ok_or_else(fn() { MirWebError.MissingPreludeCall{call: call.0} })?
    if route.module != "core.plugin" || route.member != "invoke" {
        return Err(MirWebError.InvalidMir{message: "MIR plugin invocation {call.0} uses non-plugin route {route.module}.{route.member}"})
    }
    Err(MirWebError.InvalidMir{message: "E3306: selected web target does not provide the Component Model host boundary for reachable Core plugin import `core.plugin::{export_name}` (signature `{signature.wire()}`)"})
}

// Rust: crates/jet-codegen/src/Codegen/MIRWeb.rs:3625
fn js_semantic_expression(program: MirProgram, function: MirFunction, semantic: MirSemanticOp, result_type: MirType?) -> String MirWebError! {
    value :: fn(id: MirValueId) -> String { "__jet_values.get({id.0})" }
    values :: fn(ids: [MirValueId]) -> [String] {
        rendered := [String]{}
        loop id in ids { rendered.push(value(id)) }
        rendered
    }
    prelude :: fn(id: MirPreludeCallId, args: [String]) -> String MirWebError! { js_prelude_call_expression(program, id, args) }
    expression :: if semantic == {
        .DataEntriesToMap{call, local} -> {
            place :: function.locals.iter().find(fn(candidate) { candidate.id == local }).map(fn(candidate) { candidate.place })
                .ok_or_else(fn() { MirWebError.InvalidMir{message: "MIR data-entry local {local.0} is missing"} })?
            prelude(call, [String]{js_read_place_expression(program, function, place)?})?
        }
        .MathBuiltin{type_id, call, args} | .PreciseBuiltin{type_id, call, args} -> {
            ensure_type_instance(program, type_id)?
            prelude(call, values(args))?
        }
        .Print{call, value: id} -> {
            value_type :: mir_function_value_type(function, id)?
            rendered :: if value_type.kind() == .String -> value(id) else -> "jet_show({value(id)})"
            prelude(call, [String]{rendered})?
        }
        .AmbientInput{call, prompt} -> {
            args := [String]{}
            if prompt == .Val(id) { args.push(value(id)) }
            prelude(call, ^args)?
        }
        .RequireStop{call, kind, condition, location, context, values: ids, ..} -> {
            location_args :: [String]{js_source_file_path(program, location.file)?, location.line.to_string(), js_string(context.function),
                js_string(context.source_line), location.column.to_string(), context.caret.to_string()}
            locals :: js_panic_locals(program, function, context)?
            if kind == {
                .Require -> {
                    condition :: condition.ok_or_else(fn() { MirWebError.InvalidMir{message: "MIR require stop has no checked condition"} })?
                    message :: if ids.len() == {
                        0 -> js_string(jet_require_message(None))
                        1 -> value(ids[0])
                        _ -> return Err(MirWebError.InvalidMir{message: "MIR require stop expects one checked condition and an optional message"})
                    }
                    args := [String]{value(condition), message}
                    args.extend(location_args); args.push(locals)
                    prelude(call, ^args)?
                }
                .RequireEq -> {
                    condition :: condition.ok_or_else(fn() { MirWebError.InvalidMir{message: "MIR require_eq stop has no checked condition"} })?
                    if ids.len() != 2 -> return Err(MirWebError.InvalidMir{message: "MIR require_eq stop has {ids.len()} values, expected two"})
                    args := [String]{value(condition), value(ids[0]), value(ids[1])}
                    args.extend(location_args); args.push(locals)
                    prelude(call, ^args)?
                }
                .Panic -> {
                    if condition.is_some() -> return Err(MirWebError.InvalidMir{message: "MIR panic stop carries an unexpected condition"})
                    if ids.len() != 1 -> return Err(MirWebError.InvalidMir{message: "MIR panic stop has {ids.len()} values, expected one"})
                    args := ^location_args
                    args.push(value(ids[0])); args.push(locals)
                    prelude(call, ^args)?
                }
            }
        }
        .LayoutCompare{call, op, left, right} -> prelude(call, [String]{layout_compare_code(op).to_string(), value(left), value(right)})?
        .LayoutLiteral{inner} -> value(inner)
        .StructLiteral{type_id, fields, ..} -> {
            ensure_type_instance(program, type_id)?
            entries := [String]{}
            loop (field, id) in fields { entries.push("{js_string(js_field_name(program, field)?)}: {value(id)}") }
            "Object.defineProperty({{ {entries.join(\", \")} }}, \"__jet_type\", {{ value: {js_string(type_id.0.to_string())}, enumerable: false }})"
        }
        .ReflectOf{type_name, path, display, fields} -> {
            rendered := [String]{}
            loop field in fields {
                rendered.push("{{ name: {js_string(field.name)}, value: {{ type_name: {js_string(field.type_name)}, path: {js_string(field.path)}, display: jet_show({value(field.value)}), fields: [] }} }}")
            }
            "{{ type_name: {js_string(type_name)}, path: {js_string(path)}, display: {value(display)}, fields: [{rendered.join(\", \")}] }}"
        }
        .CellGuardProject{map_call, split_call, guard, paths, editable, edit_paths_disjoint} ->
            js_cell_guard_project_expression(program, map_call, split_call, value(guard), paths, editable, edit_paths_disjoint, result_type)?
        .SharedGuardMap{call, guard, path, editable} -> {
            if path.is_empty() -> return Err(MirWebError.InvalidMir{message: "MIR shared guard map has no checked field path"})
            js_shared_guard_map_expression(program, call, value(guard), path, editable)?
        }
        .SharedGuardSplit{call, map_call, guard, first, second, editable} ->
            js_shared_guard_split_expression(program, map_call, call, value(guard), first, second, editable, result_type)?
        .SharedGuardWait{call, guard, condition, predicate} -> prelude(call, [String]{value(guard), value(condition), value(predicate)})?
        .ConditionNotify{call, condition, all} -> prelude(call, [String]{value(condition), all.to_string()})?
        .AllocNew{call, args, ..} -> prelude(call, js_call_values(program, function, args, false)?)?
        .ColumnarRead{base, index, column, column_index, accessor} -> {
            _ :: js_field_name(program, column)?
            prelude(accessor, [String]{value(base), column_index.to_string(), value(index)})?
        }
        .StaticPreludeCall{call, args, owner_type_args, type_args} -> {
            validate_type_args(program, type_args)?
            validate_owner_type_args(program, owner_type_args)?
            route :: program.prelude_calls.iter().find(fn(route) { route.id == call }).ok_or_else(fn() { MirWebError.MissingPreludeCall{call: call.0} })?
            if route.module == "core.encoding.codec" && (route.member == "encode" || route.member == "decode" || route.member == "decode_typed") {
                js_codec_prelude_expression(program, function, route.member, args, type_args)?
            } else {
                rendered := js_call_values(program, function, args, false)?
                if route.module == "::jet_std::JetShared" && route.member == "new" {
                    if args.len() != 1 -> return Err(MirWebError.InvalidMir{message: "MIR Shared.new has {args.len()} arguments; expected one payload"})
                    if owner_type_args.len() != 1 -> return Err(MirWebError.InvalidMir{message: "MIR Shared.new has no checked payload type argument"})
                    if owner_type_args[0] == .Type(payload) {
                        rendered.push(js_string(js_copy_type_key(program, payload)))
                    } else -> return Err(MirWebError.InvalidMir{message: "MIR Shared.new has no checked payload type argument"})
                }
                prelude(call, ^rendered)?
            }
        }
        .HostCall{call, args} -> prelude(call, js_call_values(program, function, args, false)?)?
        .HardwareCall{..} -> return Err(web_hardware_leak("function {function.id.0} reached the Web adapter"))
        .DecodeUnder{call, segment, inner} -> prelude(call, [String]{value(segment), value(inner)})?
        .BuiltinMethod{call, receiver, receiver_place, args, ..} -> {
            recv :: if receiver_place == {
                .Val(place) -> {
                    cell :: js_place_cell_expression(program, function, place)?
                    "({cell}).value"
                }
                .None -> value(receiver)
            }
            rendered := [String]{recv}
            rendered.extend(values(args))
            prelude(call, ^rendered)?
        }
        .OptionLift2{call, function, left, right} -> prelude(call, [String]{value(left), value(right), value(function)})?
        .ClosureMethod{receiver, args, call} -> {
            route :: program.prelude_calls.iter().find(fn(route) { route.id == call }).ok_or_else(fn() { MirWebError.MissingPreludeCall{call: call.0} })?
            rendered := [String]{value(receiver)}
            loop (index, arg) in args.iter().enumerate() {
                rendered_arg :: js_call_arg_value(program, function, arg, false)?
                if route.member == "zip_pad" && (index == 1 || index == 2) {
                    ty :: mir_function_value_type(function, arg.value)?
                    schemas := [String:String]{}
                    key :: js_history_capture_schema(program, ty, [:], &schemas)
                    rendered.push("jet_copy_value_register({rendered_arg}, {js_string(key)}, __jet_copy_type_facts)")
                } else { rendered.push(rendered_arg) }
            }
            prelude(call, ^rendered)?
        }
        .HostBorrowCallback{callable, params} -> {
            validate_type_args(program, params)?
            "(...__jet_callback_args) => {value(callable)}(...__jet_callback_args)"
        }
        .TextPatternMatch{call, subject, parts} -> prelude(call, [String]{value(subject), js_text_pattern_parts(program, parts)?})?
        .BinaryPatternMatch{call, subject, parts} -> prelude(call, [String]{value(subject), js_binary_pattern_parts(program, parts)?})?
        .CursorTakePattern{receiver_place, parts, ..} -> {
            ty :: result_type.ok_or_else(fn() { MirWebError.InvalidMir{message: "MIR Cursor.take_pattern has no result type"} })?
            (ok, _) :: ty.result_parts().ok_or_else(fn() { MirWebError.InvalidMir{message: "MIR Cursor.take_pattern result is not a Result"} })?
            fields :: ok.tuple_fields().ok_or_else(fn() { MirWebError.InvalidMir{message: "MIR Cursor.take_pattern result is not a typed tuple"} })?
            cell :: js_place_cell_expression(program, function, receiver_place)?
            pattern :: js_text_pattern_parts(program, parts)?
            names := [String]{}
            loop (name, _) in fields { names.push(js_string(name)) }
            "jet_cursor_take_pattern(({cell}).value, {pattern}, [{names.join(\", \")}])"
        }
        .ReaderTakePattern{..} -> panic("Reader.take_pattern is not Web-applicable")
        .NumericMethod{call, receiver} -> prelude(call, [String]{value(receiver)})?
        .NumericBinaryMethod{call, receiver, argument} -> prelude(call, [String]{value(receiver), value(argument)})?
        .OverflowOption{call, left, right, location} -> {
            route :: program.prelude_calls.iter().find(fn(route) { route.id == call }).ok_or_else(fn() { MirWebError.MissingPreludeCall{call: call.0} })?
            rendered := [String]{value(left), value(right)}
            if (route.signature.arity, location) == {
                (2, .None) -> {}
                (4, .Val(location)) -> { rendered.push(js_source_file_path(program, location.file)?); rendered.push(location.line.to_string()) }
                (arity, location) -> {
                    presence :: if location.is_some() -> "a" else -> "no"
                    return Err(MirWebError.InvalidMir{message: "MIR OverflowOption Prelude call {call.0} has arity {arity} with {presence} location"})
                }
            }
            prelude(call, ^rendered)?
        }
        .HandleMethod{call, receiver, args, frame_schedule, frame_schedule_derivation} -> {
            route :: program.prelude_calls.iter().find(fn(row) { row.id == call }).ok_or_else(fn() { MirWebError.MissingPreludeCall{call: call.0} })?
            if route.family == .HandleMethod && route.module == "core.reflect" {
                if !args.is_empty() -> return Err(MirWebError.InvalidMir{message: "MIR reflection handle method has arguments"})
                recv :: value(receiver)
                return Ok(if route.member == {
                    "value.type_name" -> "({recv}).type_name"
                    "value.path" -> "({recv}).path"
                    "value.display" -> "({recv}).display"
                    "value.fields" -> "({recv}).fields"
                    "field.name" -> "({recv}).name"
                    "field.value" -> "({recv}).value"
                    member -> return Err(MirWebError.InvalidMir{message: "unknown MIR reflection handle method `{member}`"})
                })
            }
            if web_task_join_call(program, call) {
                if !args.is_empty() -> return Err(MirWebError.InvalidMir{message: "MIR task join route has {args.len()} arguments; expected none"})
                joined :: prelude(call, [String]{value(receiver)})?
                "await ({joined})"
            } else if web_channel_handle_call(program, call) {
                rendered := [String]{value(receiver)}
                rendered.extend(values(args))
                expression :: prelude(call, ^rendered)?
                if web_channel_async_call(program, call) -> "await ({expression})" else -> expression
            } else if route.family == .HandleMethod && route.module == "core.encoding.datatree" {
                rendered := [String]{value(receiver)}
                rendered.extend(values(args))
                js_datatree_handle_expression(route, rendered)?
            } else if route.family == .HandleMethod && route.module == "core.handle" && route.member == "duration.ns_value" {
                if !args.is_empty() -> return Err(MirWebError.InvalidMir{message: "MIR Duration nanosecond projection has arguments"})
                "jet_web_duration_ns({value(receiver)})"
            } else if route.family == .HandleMethod && route.module == "core.time"
                && route.member.split_once('.').is_some_and(fn(pair) { is_civil_time_method_name(Val(pair.0), pair.1) }) {
                (kind, method) :: route.member.split_once('.').ok_or_else(fn() { MirWebError.InvalidMir{message: "MIR civil-time route member `{route.member}` is malformed"} })?
                rendered_args :: values(args).join(", ")
                "jet_time_method({value(receiver)}, {js_string(kind)}, {js_string(method)}, [{rendered_args}])"
            } else {
                rendered := [String]{value(receiver)}
                rendered.extend(values(args))
                if route.db_metadata == .Val(metadata) { rendered.push(js_string(metadata.to_wire())) }
                if route.member == "game.scene_on_frame" {
                    rendered.push(frame_schedule.map(fn(schedule) { js_string(schedule.canonical_json()) }).unwrap_or_else(fn() { "null" }))
                    rendered.push(frame_schedule_derivation.map(fn(reference) { js_string(reference.id) }).unwrap_or_else(fn() { "null" }))
                }
                prelude(call, ^rendered)?
            }
        }
        .PluginInvoke{call, export_name, signature, ..} -> js_plugin_invoke_unsupported(program, call, export_name, signature)?
        .CoreClosureCall{call, kind, values: ids, closure, site, label} -> js_core_closure_call_expression(program, call, kind.clone(), ids, closure, site, label)?
        .TaskGroup{call, kind, tasks} -> {
            rendered := [String]{task_group_code(kind).to_string()}
            rendered.extend(values(tasks))
            prelude(call, ^rendered)?
        }
        .Select{call, kind, values: ids} -> {
