// Lower checked destructuring bindings without re-evaluating the initializer.
use jet_foundation.[
    MIRAccess,
    MIRConstant,
    MIRCopyFact,
    MIRIndexKind,
    MIROperation,
    MIRPanicContext,
    MIRPanicLoc,
    MIRPanicLocal,
    MIRPlaceID,
    Span,
    TDestructureBinding,
    TExpr,
    TLocal,
    Type,
    mir_source_file_id,
]

fn jet_codegen_lower_field_destructure(builder: &JetCodegenBuilder, program: JetCodegenProgram, temp: TLocal, init: TExpr, move_fields: Bool, binds: [TDestructureBinding], span: Span) {
    subject := if {
        move_fields -> {
            source_place := jet_codegen_lower_expression_place(&builder, program, init, MIRAccess.Move)
            if source_place == {
                .Val(place) -> jet_codegen_emit_value(&builder, program, span, init.ty, MIROperation.MovePlace{place: place})
                .None -> jet_codegen_lower_expr(&builder, program, init)
            }
        }
        else -> jet_codegen_lower_expr(&builder, program, init)
    }
    temporary := MIRPlaceID?{None}
    if move_fields {
        place := jet_codegen_bind_local(&builder, program, temp, init.ty, true, None, None, false)
        move_place := jet_codegen_place_access(&builder, program, place, MIRAccess.Move)
        _ := jet_codegen_emit(&builder, program, span, None, MIROperation.WritePlace{place: move_place, value: subject})
        temporary = Val(move_place)
    }
    loop binding in binds {
        field_type := jet_codegen_checked_host_field_type(builder, program, init.ty, binding.field)
        field_id := jet_codegen_host_field_id(builder, program, init.ty, binding.field)
        value := if temporary == {
            .Val(place) -> {
                field_place := jet_codegen_project_field_place(&builder, program, place, span, field_type, field_id)
                jet_codegen_emit_value(&builder, program, span, field_type, MIROperation.MovePlace{place: field_place})
            }
            .None -> {
                projected := jet_codegen_emit_value(&builder, program, span, field_type, MIROperation.Field{base: subject, field: field_id})
                jet_codegen_emit_value(&builder, program, span, field_type, MIROperation.Copy{value: projected, fact: MIRCopyFact.Materialize})
            }
        }
        destination := jet_codegen_bind_local(&builder, program, binding.local, field_type, binding.local.mutable, None, None, false)
        _ := jet_codegen_emit(&builder, program, span, None, MIROperation.WritePlace{place: destination, value: value})
    }
    // A move destructure that took every field out of its temp leaves nothing
    // to release: clear the temp's drop flag exactly as a whole move does, so
    // its scope-end cleanup never moves the emptied temp a second time.
    if temporary == .Val(place) {
        fields :: jet_codegen_destructure_field_names(builder, program, init.ty)
        if fields.len() == 0 -> return
        loop field in fields {
            taken := false
            loop binding in binds {
                if binding.field == field {
                    taken = true
                    break
                }
            }
            if !taken -> return
        }
        jet_codegen_set_drop_live(&builder, program, place, false)
    }
}

// Rust: crates/jet-codegen/src/Codegen/TIR/tir_to_mir_stmt.rs::release_emptied_destructure_temp
// (the ordered fields `field_name_for_type` walks). No fields means the owner
// is not a resolvable record, and the temp keeps its cleanup.
fn jet_codegen_destructure_field_names(builder: JetCodegenBuilder, program: JetCodegenProgram, owner_type: Type) -> [String] Never! {
    names := [String]{}
    owner := jet_codegen_field_owner_type(owner_type)
    if owner == {
        .Tuple(fields) -> loop field in fields -> &names.push(field.name)
        .Named(name) | .Apply(name, _) -> {
            identity := jet_codegen_find_nominal_identity(program.modules, builder.function.module_identity, name, builder.generic_type_names)
            if identity == None && jet_codegen_compiler_owned_record_fields(name) == .Val(fields) {
                loop field in fields -> &names.push(field.name)
                return names
            }
            nominal_identity :: identity ?? return names
            loop semantic_module in program.modules {
                if semantic_module.module_identity != nominal_identity.module_identity -> next
                loop nominal in semantic_module.nominals {
                    if nominal.symbol.name != nominal_identity.name -> next
                    loop field in nominal.fields -> &names.push(field.symbol.name)
                    return names
                }
            }
        }
        else -> {}
    }
    names
}

fn jet_codegen_lower_list_destructure(builder: &JetCodegenBuilder, program: JetCodegenProgram, init: TExpr, count: Int, elements: [TLocal], span: Span) {
    subject := jet_codegen_lower_expr(&builder, program, init)
    element_type := if init.ty == {
        .List(element) | .FixedList(element, _) -> element
        else -> init.ty
    }
    checked_location := jet_codegen_assignment_panic_location(&builder, program, span, false)
    location := MIRPanicLoc{file: mir_source_file_id(checked_location.file), line: checked_location.line, column: checked_location.column}
    context := MIRPanicContext{function: checked_location.function, source_line: checked_location.source_line, caret: checked_location.caret, locals: [MIRPanicLocal]{}}
    call := jet_codegen_index_route(&builder, program, MIRIndexKind.List, MIRAccess.Read, jet_codegen_failure_carrier_for_type(element_type))
    loop (index, local) in elements {
        if index >= count -> break
        index_value := jet_codegen_emit_value(&builder, program, span, Type.Int, MIROperation.Constant{value: MIRConstant.Int{value: index, width: None, spelling: None}})
        projected := jet_codegen_emit_value(&builder, program, span, element_type, MIROperation.Index{call: call, base: subject, index: index_value, kind: MIRIndexKind.List, access: MIRAccess.Read, location: location, context: context})
        destination := jet_codegen_bind_local(&builder, program, local, element_type, local.mutable, None, None, false)
        _ := jet_codegen_emit(&builder, program, span, None, MIROperation.WritePlace{place: destination, value: projected})
    }
}
