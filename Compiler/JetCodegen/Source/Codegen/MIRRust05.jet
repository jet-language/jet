                    if cached.is_some() { return cached.unwrap() }
                }
                depth :: visiting.len()
                outer_floor :: self.derive_capability_cycle_floor.replace(USize.MAX)
                next_bindings := bindings.clone()
                next_generic_params := generic_params.clone()
                next_generic_params.extend(def.generic_params.iter().map(fn(parameter) { parameter.name.clone() }))
                next_bindings.extend(def.generic_params.iter().zip(args).map(fn((parameter, argument)) { (parameter.name.clone(), argument.clone()) }))
                visiting.push(def.id)
                result :: def.kind == {
                    .Struct(fields: fields, ..) -> fields.iter().filter(fn(field) { !field.computed }).all(fn(field) { self.type_derive_capability(&field.ty, trait_name, visiting, &next_bindings, &next_generic_params) })
                    .Enum(variants: variants, ..) -> variants.iter().all(fn(variant) {
                        variant.payload == {
                            .Unit -> true
                            .Single(payload) -> self.type_derive_capability(payload, trait_name, visiting, &next_bindings, &next_generic_params)
                            .Named(fields) -> fields.iter().all(fn(field) { self.type_derive_capability(&field.ty, trait_name, visiting, &next_bindings, &next_generic_params) })
                        }
                    })
                    .Distinct(base: base, ..) -> self.type_derive_capability(base, trait_name, visiting, &next_bindings, &next_generic_params)
                    .Alias(target: target) -> self.type_derive_capability(target, trait_name, visiting, &next_bindings, &next_generic_params)
                    .UnitFamily(..) -> true
                }
                _ :: visiting.pop()
                floor :: self.derive_capability_cycle_floor.get()
                self.derive_capability_cycle_floor.set(outer_floor.min(floor))
                if cacheable && (!result || floor >= depth) { self.derive_capability_cache.borrow_mut().entry(trait_name.to_string()).or_default().insert(def.id, result) }
