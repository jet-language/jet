            }
        }
    }
    // Rust: crates/jet-codegen/src/Codegen/MIRRust.rs:8098
    fn selected_user_capability_impl(ty: &MirType, trait_name: &String) -> Bool {
        self.user_impls_by_trait.get(trait_name).is_some_and(fn(implementations) {
            implementations.iter().any(fn(implementation) {
                self.module_selected(implementation.module) && self.impl_selected_for_target(implementation) && (implementation.self_type.same_checked_type(ty) || implementation.self_type.nominal_name().zip(ty.nominal_name()).is_some_and(fn((left, right)) { left == right }))
            })
        })
    }
    // Rust: crates/jet-codegen/src/Codegen/MIRRust.rs:8121
    // Plain enum display is the source case name on every tier; user Display wins.
    fn emit_plain_enum_display_impl(def: &MirTypeDef, out: &String) -> {
        variants_opt :: def.kind == { .Enum(variants: variants, ..) -> Some(variants), _ -> None }
        if variants_opt.is_none() { return }
        variants :: variants_opt.unwrap()
        if !def.generic_params.is_empty() || variants.is_empty() || is_source_owned_core_web_query_enum(&def.key) || !variants.iter().all(fn(variant) { variant.payload == .Unit }) || self.selected_trait_impl_for_type(def, Generics.DISPLAY) { return }
        name :: self.type_name(def.id)
        out.push_str(&"impl JetDisplay for {name} {{\n    fn jet_display(&self) -> String {{\n        match self {{\n")
        for variant in variants {
            variant_name :: quote_rust_string(variant.name.strip_prefix(GENERATED_NAME_PREFIX).unwrap_or(&variant.name))
            out.push_str(&"            Self::{mangle_variant(&variant.name)} => {variant_name}.to_string(),\n")
        }
        out.push_str("        }\n    }\n}\n\n")
