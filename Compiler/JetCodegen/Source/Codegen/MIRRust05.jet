            .Shared(_), .Fn(_), .SendFn(..) -> trait_name == "Clone"
            .TraitObject(bounds) -> trait_name == "Clone" && bounds.len() == 1 && self.traits_by_name.get(&bounds[0].name).is_some_and(fn(symbol) { self.dyn_clone_traits.contains(symbol) })
            .List(inner), .Option(inner), .FixedList(elem: inner, ..), .InlineRange(base: inner, ..), .Quantity(base: inner, ..) -> self.type_derive_capability(inner, trait_name, visiting, bindings, generic_params)
            .Tagged(marker: marker, inner: inner) -> {
                if marker == .Internal(.CppCallbackAbi) { true } else { self.type_derive_capability(inner, trait_name, visiting, bindings, generic_params) }
            }
            .Map(key: key, value: value), .Result(ok: key, err: value) -> self.type_derive_capability(key, trait_name, visiting, bindings, generic_params) && self.type_derive_capability(value, trait_name, visiting, bindings, generic_params)
            .Tuple(fields) -> fields.iter().all(fn((_, field)) { self.type_derive_capability(field, trait_name, visiting, bindings, generic_params) })
            // Synthetic union carriers have no checked PartialEq derive.
            .Union(members) -> trait_name != "PartialEq" && members.iter().all(fn(member) { self.type_derive_capability(member, trait_name, visiting, bindings, generic_params) })
            .Apply(name: name, args: args) -> {
                if name.name == TYPE_PTR { return true }
                if name.name == "View" { return trait_name == "Clone" || args.first().is_some_and(fn(inner) { self.type_derive_capability(inner, trait_name, visiting, bindings, generic_params) }) }
                if name.name == "ViewMut" { return trait_name != "Clone" && args.first().is_some_and(fn(inner) { self.type_derive_capability(inner, trait_name, visiting, bindings, generic_params) }) }
                if self.selected_user_capability_impl(ty, trait_name) { return true }
                def_opt :: self.structural_type_def_for(ty)
                if def_opt.is_none() { return args.iter().all(fn(arg) { self.type_derive_capability(arg, trait_name, visiting, bindings, generic_params) }) }
                def :: def_opt.unwrap()
                if !self.structural_derives_allowed(def) { return false }
                is_alias :: def.kind == { .Alias(..) -> true, _ -> false }
                if trait_name == "PartialEq" && !is_alias && (!self.derives_trait(def, Generics.EQUATABLE) || self.selected_user_capability_impl(ty, Generics.EQUATABLE) || def.name.starts_with("__JetUnion_")) { return false }
                if trait_name == "Clone" && def.ownership == .Move { return false }
                position :: visiting.iter().position(fn(id) { id == def.id })
                if position.is_some() {
                    self.derive_capability_cycle_floor.set(self.derive_capability_cycle_floor.get().min(position.unwrap()))
                    return true
                }
                // Closed rows cache only final answers, not assumptions from outer cycles.
                cacheable :: args.is_empty() && def.generic_params.is_empty() && bindings.is_empty() && generic_params.is_empty()
                if cacheable {
