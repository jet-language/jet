    fn structural_derives_allowed(def: &MirTypeDef) -> Bool {
        def.kind == {
            .Struct(fields: fields, ..) -> fields.iter().filter(fn(field) { !field.computed }).all(fn(field) { !mir_type_has_inline_nominal_word(&field.ty) })
            .Enum(variants: variants, ..) -> variants.iter().all(fn(variant) {
                variant.payload == { .Unit -> true, .Single(ty) -> !mir_type_has_inline_nominal_word(ty), .Named(fields) -> fields.iter().all(fn(field) { !mir_type_has_inline_nominal_word(&field.ty) }) }
            })
            .Distinct(base: base, ..) -> !mir_type_has_inline_nominal_word(base)
            .Alias(target: target) -> !mir_type_has_inline_nominal_word(target)
            .UnitFamily(..) -> true
        }
    }
