    // Rust: crates/jet-codegen/src/Codegen/MIRRust.rs:7201
    // The previous slice owns validation and the opening implementation.
    fn emit_impl(implementation: &MirImplDef, emitted_methods: &Set[MirFunctionId], out: &String) -> {
        (_, _, _, carrier_trait, trait_definition, rust_operator, methods_start) :: self.emit_impl_head(implementation, out)
        if trait_definition.is_some() {
            for declared in trait_definition.unwrap().associated_types {
                if !implementation.associated_types.iter().any(fn(associated) { associated.name == declared.name }) && !(rust_operator.is_some() && declared.name == "Output") {
                    panic("MIR implementation {implementation.id:?} omits associated type {declared.name}")
                }
            }
        } else if !implementation.associated_types.is_empty() {
            panic("MIR inherent implementation {implementation.id:?} has associated types")
        }
        for associated in implementation.associated_types {
            out.push_str(&"    type {mangle(&associated.name)} = {self.rust_type(&associated.ty)};\n")
        }
        functions := [&MirFunction].with_capacity(implementation.methods.len())
        for function_id in implementation.methods {
            function :: self.function_row(function_id)
            if !self.module_selected(function.module_id) || !self.selected_for_target(function) {
                panic("MIR implementation {implementation.id:?} method {function.id:?} is not selected for the emitted artifact")
            }
            functions.push(function)
        }
        operator_return := None as MirType?
        for function in functions {
            (implementation.trait_ref, function.form) == {
                (.None, .Method(owner: declared_owner, ..)) -> {
                    if !declared_owner.same_checked_type(&implementation.self_type) { panic("MIR inherent implementation {implementation.id:?} method {function.id:?} owner mismatch") }
                    if !self.owner_independent_static(function) { self.emit_method(function, out) }
                }
                (.Some(trait_ref), .TraitMethod(owner: declared_owner, trait_ref: declared_trait, self_access: self_access, serde: serde)) -> {
                    if !declared_owner.same_checked_type(&implementation.self_type) || declared_trait.id != trait_ref.id || declared_trait.name != trait_ref.name {
                        panic("MIR trait implementation {implementation.id:?} method {function.id:?} declaration mismatch")
                    }
                    codec :: implementation.serde
                    if codec != serde { panic("MIR trait implementation {implementation.id:?} method {function.id:?} codec mismatch") }
                    if codec.is_some() {
                        expected_name :: if codec.unwrap() == .Encode { "encode" } else { "decode" }
                        if self.function_leaf_name(function) != expected_name || function.capture_params.len() != 0 { panic("MIR serde implementation {implementation.id:?} method {function.id:?} has invalid codec shape") }
                        codec.unwrap() == {
                            .Encode -> { if self_access != Some(MirAccess.Read) || !self.declared_params(function).is_empty() { panic("MIR Encode implementation {implementation.id:?} method {function.id:?} must be an instance method without arguments") } }
                            .Decode -> { if self_access.is_some() || self.declared_params(function).len() != 1 { panic("MIR Decode implementation {implementation.id:?} method {function.id:?} must be static with one argument") } }
                        }
                    }
                    if trait_definition.is_some() {
                        // Compiler-owned rows carry identity; sema checked Prelude signatures.
                        definition :: trait_definition.unwrap()
                        if codec.is_none() && !implementation.compiler_generated && !is_compiler_owned_trait(&definition.name) { self.validate_trait_method_signature(implementation, definition, function, self_access) }
                    } else if codec.is_none() { panic("MIR trait implementation {implementation.id:?} method {function.id:?} has no trait declaration") }
                    (name, return_override) :: codec == {
                        .Some(.Encode) -> (Some("jet_encode"), Some("{self.config.root_prefix}jet_std::DataTree"))
                        .Some(.Decode) -> (Some("jet_decode"), Some("Result<Self, Vec<{self.config.root_prefix}jet_std::FieldError>>"))
                        .None -> (None, None)
                    }
                    native :: codec == {
                        .Some(.Encode) -> self.emit_native_derived_encode(implementation, function, out)
                        .Some(.Decode) -> self.emit_native_derived_decode(implementation, function, out)
                        .None -> self.emit_native_derived_equal(implementation, function, out) || self.emit_native_derived_compare(implementation, function, out)
                    }
                    if !native { self.emit_callable_named(function, out, Some(&function.form), name, codec, return_override) }
                    if rust_operator.is_some() {
                        if operator_return.is_some() {
                            if !operator_return.unwrap().same_checked_type(&function.return_type) { panic("MIR operator implementation {implementation.id:?} methods disagree on Output") }
                        } else { operator_return = Some(function.return_type.clone()) }
                    }
                }
                _ -> panic("MIR implementation {implementation.id:?} method {function.id:?} has incompatible function form")
            }
            if !emitted_methods.insert(function.id) { panic("MIR implementation method {function.id:?} was emitted more than once") }
        }
        if implementation.trait_ref.is_some() {
            if trait_definition.is_some() {
                for method in trait_definition.unwrap().methods {
                    if implementation.serde.is_none() && (method.default.is_none() || implementation.delegation.is_some()) && !functions.iter().any(fn(function) { self.function_leaf_name(function) == method.name }) {
                        panic("MIR implementation {implementation.id:?} omits required trait method {method.name}")
                    }
                }
            }
            if rust_operator.is_some() {
                output :: operator_return.unwrap_or_else(fn() { panic("MIR operator implementation {implementation.id:?} has no materialized method") })
                associated :: implementation.associated_types.iter().find(fn(associated) { associated.name == "Output" })
                if associated.is_some() {
                    if !associated.unwrap().ty.same_checked_type(&output) { panic("MIR operator implementation {implementation.id:?} Output type disagrees with method return") }
                } else { out.push_str(&"    type Output = {self.rust_type(&output)};\n") }
            }
        }
        methods_end :: out.len()
        out.push_str("}\n\n")
        if carrier_trait.is_some() {
            signatures :: carrier_trait_signatures(&out[methods_start..methods_end])
            out.push_str(&"trait {carrier_trait.unwrap()} {{\n{signatures}}}\n\n")
        }
        self.pop_generic_scope()
        for function in functions { if self.owner_independent_static(function) { self.emit_function(function, out) } }
    }

    // Rust: crates/jet-codegen/src/Codegen/MIRRust.rs:7458
    fn arithmetic_trait_method(function: &MirFunction) -> Bool {
        function.form == { .TraitMethod(trait_ref: trait_ref, ..) -> ["Add", "Sub", "Mul", "Div"].contains(&trait_ref.name), _ -> false }
    }
    // Rust: crates/jet-codegen/src/Codegen/MIRRust.rs:7466
    fn function_leaf_name(function: &MirFunction) -> String {
        if function.form == {
            .TraitMethod(trait_ref: trait_ref, ..) -> ["Add", "Sub", "Mul", "Div", "Equatable", "Comparable"].contains(&trait_ref.name)
            _ -> false
        } {
            // Checked operator identity appends RHS after '<', before owner splitting.
            return function.name.split('<').next().unwrap().rsplit("::").next().unwrap().to_string()
        }
        function.name.rsplit("::").next().unwrap_or_else(fn() { panic("MIR function {function.id:?} has an empty name") }).to_string()
    }
    // Rust: crates/jet-codegen/src/Codegen/MIRRust.rs:7501
    // Inherent methods use __jet_<leaf>; compiler-owned traits keep registry names.
    fn rust_method_symbol(function: &MirFunction) -> String {
        leaf :: self.function_leaf_name(function)
        function.form == {
            .TraitMethod(serde: .Some(.Encode), ..) -> "jet_encode"
            .TraitMethod(serde: .Some(.Decode), ..) -> "jet_decode"
            .TraitMethod(trait_ref: trait_ref, ..) -> {
                if is_compiler_owned_trait(&trait_ref.name) { compiler_trait_method_symbol(&trait_ref.name, &leaf) } else { mangle(&leaf) }
            }
            .Method(..), .TopLevel -> mangle(&leaf)
        }
    }
    // Rust: crates/jet-codegen/src/Codegen/MIRRust.rs:7527
    // A bare generic owner is a namespace, not an inference obligation.
    fn owner_independent_static(function: &MirFunction) -> Bool {
        function.form == {
            .Method(owner: owner, self_access: .None) -> {
                owner.kind() == { .Apply(args: args, ..) -> args.is_empty() && !self.generic_params_for_type(owner).is_empty(), _ -> false }
            }
            _ -> false
        }
    }
    // Rust: crates/jet-codegen/src/Codegen/MIRRust.rs:7536
    fn normalize_trait_type(ty: &MirType, owner: &MirType) -> MirType {
        if ty.nominal_name() == Some("Self") { return owner.clone() }
        normalized := ty.clone()
        normalized.kind == {
            .Int, .Float, .Float32, .Bool, .String, .Char, .TraitObject(_), .IntN(..), .Measure(_) -> {}
            .List(inner), .Shared(inner), .Option(inner) -> { inner = self.normalize_trait_type(&inner, owner) }
            .Map(key: key, value: value) -> { key = self.normalize_trait_type(&key, owner); value = self.normalize_trait_type(&value, owner) }
            .Result(ok: ok, err: err) -> { ok = self.normalize_trait_type(&ok, owner); err = self.normalize_trait_type(&err, owner) }
            .Fn(signature) -> {
                for parameter in &signature.params { parameter = self.normalize_trait_type(&parameter, owner) }
                if signature.ret.is_some() { signature.ret = Some(self.normalize_trait_type(&signature.ret.unwrap(), owner)) }
            }
            .SendFn(params: params, ret: ret, ..) -> {
                for parameter in &params { parameter = self.normalize_trait_type(&parameter, owner) }
                if ret.is_some() { ret = Some(self.normalize_trait_type(&ret.unwrap(), owner)) }
            }
            .Apply(args: args, ..) -> { for argument in &args { argument = self.normalize_trait_type(&argument, owner) } }
            .Tuple(fields) -> { for (_, field) in &fields { field = self.normalize_trait_type(&field, owner) } }
            .FixedList(elem: elem, ..) -> { elem = self.normalize_trait_type(&elem, owner) }
            .InlineRange(base: base, ..) -> { base = self.normalize_trait_type(&base, owner) }
            .Tagged(inner: inner, ..) -> { inner = self.normalize_trait_type(&inner, owner) }
            .Union(members) -> { for member in &members { member = self.normalize_trait_type(&member, owner) } }
            .Quantity(base: base, ..) -> { base = self.normalize_trait_type(&base, owner) }
        }
        normalized.identity = None
        normalized
    }
    // Rust: crates/jet-codegen/src/Codegen/MIRRust.rs:7610
    fn validate_trait_method_signature(implementation: &MirImplDef, definition: &MirTraitDef, function: &MirFunction, self_access: MirAccess?) -> {
        name :: self.function_leaf_name(function)
        method :: definition.methods.iter().find(fn(method) { method.name == name }).unwrap_or_else(fn() { panic("MIR implementation {implementation.id:?} method {function.id:?} is not declared by trait {definition.name}") })
        receiver_differs :: method.self_access != self_access
        has_captures :: !function.capture_params.is_empty()
        arity_differs :: self.declared_params(function).len() != method.params.len()
        params_differ :: self.declared_params(function).iter().zip(&method.params).any(fn((actual, expected)) {
            actual.index != expected.index + USize.from(self_access.is_some()) || actual.name != expected.name || actual.access != expected.access || !self.normalize_trait_type(&actual.ty, &implementation.self_type).same_checked_type(&self.normalize_trait_type(&expected.ty, &implementation.self_type))
        })
        return_differs :: !self.normalize_trait_type(&function.return_type, &implementation.self_type).same_checked_type(&self.normalize_trait_type(&method.return_type, &implementation.self_type))
        failure_differs :: function.failure != method.failure
        if receiver_differs || has_captures || arity_differs || params_differ || return_differs || failure_differs {
            panic("MIR implementation {implementation.id:?} method {function.id:?} signature disagrees with trait {definition.name} (receiver={receiver_differs} captures={has_captures} arity={arity_differs} params={params_differ} return={return_differs} failure={failure_differs}): receiver {self_access:?}/{method.self_access:?}, captures {function.capture_params:?}, params {self.declared_params(function):?}/{method.params:?}, return {function.return_type:?}/{self.normalize_trait_type(&method.return_type, &implementation.self_type):?}, failure {function.failure:?}/{method.failure:?}")
        }
    }
    // Rust: crates/jet-codegen/src/Codegen/MIRRust.rs:7673
    fn validate_derived_trait(def: &MirTypeDef, trait_id: MirTraitId, trait_name: &String) -> {
        definition :: self.program.traits.iter().find(fn(definition) { definition.id == trait_id && definition.name == trait_name }).unwrap_or_else(fn() { panic("MIR derive trait ID {trait_id:?} has no row") })
        implementation :: self.program.impls.iter().find(fn(implementation) {
            implementation.trait_ref.is_some_and(fn(trait_ref) { trait_ref.id == trait_id && trait_ref.name == trait_name }) && self.type_identity(&implementation.self_type) == def.id && self.module_selected(implementation.module) && self.impl_selected_for_target(implementation)
        }).unwrap_or_else(fn() { panic("MIR type {def.id:?} derives {trait_name} without a selected implementation") })
        for method in definition.methods {
            if method.default.is_none() && !implementation.methods.iter().any(fn(function_id) { self.function_leaf_name(self.function_row(function_id)) == method.name }) { panic("MIR derived implementation {implementation.id:?} omits required method {method.name}") }
        }
    }
    // Rust: crates/jet-codegen/src/Codegen/MIRRust.rs:7711
    fn selected_trait_impl_for_type(def: &MirTypeDef, trait_name: &String) -> Bool {
        self.program.impls.iter().any(fn(implementation) {
            implementation.trait_ref.is_some_and(fn(trait_ref) { trait_ref.name == trait_name }) && self.module_selected(implementation.module) && self.impl_selected_for_target(implementation) && self.type_identity(&implementation.self_type) == def.id
        })
    }
    // Rust: crates/jet-codegen/src/Codegen/MIRRust.rs:7723
    fn structural_generics(def: &MirTypeDef, trait_name: &String) -> String {
        if def.generic_params.is_empty() { return "" }
        required_bound :: Generics.rust_trait_bound(trait_name).unwrap_or(trait_name)
        params :: def.generic_params.iter().map(fn(param) {
            bounds := param.bounds.iter().map(fn(bound) { Generics.rust_trait_bound(&bound.name).map(fn(text) { text.to_string() }).unwrap_or_else(fn() { self.trait_nominal_name(bound) }) }).collect[[String]]()
            if !bounds.iter().any(fn(bound) { bound == required_bound }) { bounds.push(required_bound.to_string()) }
            "{mangle(&param.name)}: {bounds.join(" + ")}"
        }).collect[[String]]().join(", ")
        "<{params}>"
    }
    // Rust: crates/jet-codegen/src/Codegen/MIRRust.rs:7754
    fn structural_field_value(def: &MirTypeDef, edge: &String, receiver: &String, field: &MirField, method: &String) -> String {
        value :: "({receiver}.{self.field_name(field.id)})"
        if def.boxed_edges.iter().any(fn(candidate) { candidate == edge }) { "{value}.as_ref().{method}()" } else { "{value}.{method}()" }
    }
