    // Representation capability: callable/shared handles clone without payload;
    // dynamic objects only clone through the checked clone-box supertrait.
    fn type_derive_capability(ty: &MirType, trait_name: &String, visiting: &[MirTypeId], bindings: &[String:MirType], generic_params: &Set[String]) -> Bool {
        ty.kind() == {
            .Apply(name: name, args: args) -> {
