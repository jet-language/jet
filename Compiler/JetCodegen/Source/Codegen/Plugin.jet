// Checked SandboxPlugin artifact projection; no source-AST ingress.
use jet_foundation.[MirAccess, MirArtifactId, MirArtifactKind, MirArtifactTarget, MirProgram, MirType, MirTypeId, MirTypeDef, MirTypeDefKind, MirTypeKind, MirField, mangle, mangle_generated, mangle_path]
use jet_codegen.[ComponentSignature, ComponentSignatureDescriptor, ComponentTypeDescriptor, ExportScalar, ExportFunction, selected_artifact, export_surface, component_descriptor, append_web_time_zones]

// Rust: crates/jet-codegen/src/Codegen/Plugin.rs:23
struct PluginArtifacts {
    wit: String,
    guest_rust: String,
    world_name: String,
    export_name: String,
    exported_fns: [String],
    exports: [ExportFunction],
}

// Rust: crates/jet-codegen/src/Codegen/Plugin.rs:46
const WORLD_NAME: String = "jetplugin"

// Rust: crates/jet-codegen/src/Codegen/Plugin.rs:52
fn to_kebab(name: String) -> String Never! { name.replace("_", "-") }

// Rust: crates/jet-codegen/src/Codegen/Plugin.rs:58
fn sanitize_package_name(name: String) -> String Never! {
    out := ""
    loop c in name.chars() {
        if c.is_ascii_alphanumeric() -> &out.push(c.to_ascii_lowercase())
        else if !out.is_empty() && !out.ends_with("-") -> &out.push('-')
    }
    out := out.trim_end_matches('-') // #4303
    if out.is_empty() || !out.chars().next().unwrap().is_ascii_alphabetic() -> "plugin-{if out.is_empty() -> "export" else -> out}" else -> out
}

// Rust: crates/jet-codegen/src/Codegen/Plugin.rs:82
fn rust_named_type_name(program: MirProgram, id: MirTypeId, fallback: String) -> String Never! {
    if program.types.find(fn(definition) { definition.id == id }) == { Val(definition) -> mangle_path(definition.key) None -> mangle_path(fallback) }
}

// Rust: crates/jet-codegen/src/Codegen/Plugin.rs:95
fn rust_type(program: MirProgram, ty: MirType) -> String Never! {
    if ty.kind() == {
        .Int -> "i64"
        .Float -> "f64"
        .Bool -> "bool"
        .String -> "String"
        .List(inner) -> "Vec<{rust_type(program, inner)}>"
        .Option(inner) -> "JetOutcome<{rust_type(program, inner)}, JetAbsent>"
        .Result(ok, err) -> "JetOutcome<{rust_type(program, ok)}, {rust_type(program, err)}>"
        .FixedList(elem, len) -> "[{rust_type(program, elem)}; {len.expression()}]"
        .InlineRange(base, _) | .Tagged(_, base) -> rust_type(program, base)
        .Apply(name, args) -> {
            head :: rust_named_type_name(program, name.id, name.name)
            if args.is_empty() -> head else -> {
                rows :: loop arg in args -> rust_type(program, arg)
                "{head}<{rows.join(", ")}>"
            }
        }
        else -> "()"
    }
}

// Rust: crates/jet-codegen/src/Codegen/Plugin.rs:132
enum PluginCoreSlot { I32, I64, F64 }
extend PluginCoreSlot {
    // Rust: crates/jet-codegen/src/Codegen/Plugin.rs:139
    fn rust_ty(self) -> String Never! { if self == { .I32 -> "i32" .I64 -> "i64" .F64 -> "f64" } }
}

// Rust: crates/jet-codegen/src/Codegen/Plugin.rs:148
fn merge_plugin_slot(left: PluginCoreSlot, right: PluginCoreSlot) -> PluginCoreSlot Never! {
    if (left, right) == { (.I32, .I32) -> .I32 (.F64, .F64) -> .F64 else -> .I64 }
}

// Rust: crates/jet-codegen/src/Codegen/Plugin.rs:162
fn merge_plugin_slots(left: [PluginCoreSlot], right: [PluginCoreSlot]) -> [PluginCoreSlot] Never! {
    slots := [PluginCoreSlot]{}
    loop index in 0..<left.len().max(right.len()) {
        if (left.get(index), right.get(index)) == {
            (Val(a), Val(b)) -> &slots.push(merge_plugin_slot(a, b))
            (Val(slot), None) | (None, Val(slot)) -> &slots.push(slot)
            (None, None) -> {}
        }
    }
    slots
}

// Rust: crates/jet-codegen/src/Codegen/Plugin.rs:176
fn plugin_flat_slots(ty: ComponentTypeDescriptor) -> [PluginCoreSlot] Never! {
    if ty == {
        .Int -> [PluginCoreSlot]{.I64}
        .Float -> [PluginCoreSlot]{.F64}
        .Bool -> [PluginCoreSlot]{.I32}
        .String | .List(_) -> [PluginCoreSlot]{.I32, .I32}
        .Option(inner) -> {
            slots := [PluginCoreSlot]{.I32}
            &slots.extend(plugin_flat_slots(inner))
            slots
        }
        .Result(ok, err) -> {
            slots := [PluginCoreSlot]{.I32}
            &slots.extend(merge_plugin_slots(plugin_flat_slots(ok), plugin_flat_slots(err)))
            slots
        }
        .Record(_, fields) -> {
            slots := [PluginCoreSlot]{}
            loop (_, _, field) in fields -> &slots.extend(plugin_flat_slots(field))
            slots
        }
    }
}

// Rust: crates/jet-codegen/src/Codegen/Plugin.rs:204
fn plugin_align_to(value: Int, align: Int) -> Int Never! {
    assert(align.is_power_of_two())
    (value + align - 1) & !(align - 1)
}

// Rust: crates/jet-codegen/src/Codegen/Plugin.rs:209
fn plugin_memory_layout(ty: ComponentTypeDescriptor) -> (Int, Int) Never! {
    if ty == {
        .Int | .Float -> (8, 8)
        .Bool -> (1, 1)
        .String | .List(_) -> (8, 4)
        .Option(inner) -> {
            (size, align) :: plugin_memory_layout(inner)
            payload :: plugin_align_to(1, align)
            (plugin_align_to(payload + size, align), align)
        }
        .Result(ok, err) -> {
            (ok_size, ok_align) :: plugin_memory_layout(ok)
            (err_size, err_align) :: plugin_memory_layout(err)
            align :: ok_align.max(err_align)
            payload :: plugin_align_to(1, align)
            (plugin_align_to(payload + ok_size.max(err_size), align), align)
        }
        .Record(_, fields) -> {
            size := 0
            align := 1
            loop (_, _, field) in fields {
                (field_size, field_align) :: plugin_memory_layout(field)
                size = plugin_align_to(size, field_align) + field_size
                align = align.max(field_align)
            }
            (plugin_align_to(size, align), align)
        }
    }
}

// Rust: crates/jet-codegen/src/Codegen/Plugin.rs:242
fn plugin_sequence_layout(types: [ComponentTypeDescriptor]) -> (Int, Int) Never! {
    size := 0
    align := 1
    loop ty in types {
        (field_size, field_align) :: plugin_memory_layout(ty)
        size = plugin_align_to(size, field_align) + field_size
        align = align.max(field_align)
    }
    (plugin_align_to(size, align), align)
}

// Rust: crates/jet-codegen/src/Codegen/Plugin.rs:253
fn plugin_record_offsets(fields: [(Int, String, ComponentTypeDescriptor)]) -> [(Int, ComponentTypeDescriptor)] Never! {
    offset := 0
    result := [(Int, ComponentTypeDescriptor)]{}
    loop (_, _, field) in fields {
        (size, align) :: plugin_memory_layout(field)
        offset = plugin_align_to(offset, align)
        &result.push((offset, field))
        offset += size
    }
    result
}

// Rust: crates/jet-codegen/src/Codegen/Plugin.rs:267
fn plugin_needs_post_return(ty: ComponentTypeDescriptor) -> Bool Never! {
    if ty == {
        .String | .List(_) -> true
        .Option(inner) -> plugin_needs_post_return(inner)
        .Result(ok, err) -> plugin_needs_post_return(ok) || plugin_needs_post_return(err)
        .Record(_, fields) -> fields.any(fn(field) { plugin_needs_post_return(field.2) })
        .Int | .Float | .Bool -> false
    }
}

// Rust: crates/jet-codegen/src/Codegen/Plugin.rs:283
fn plugin_unwrap_transparent(program: MirProgram, ty: MirType) -> MirType Never! {
    if ty.kind() == {
        .InlineRange(base, _) | .Tagged(_, base) -> plugin_unwrap_transparent(program, base)
        .Apply(nominal, _) -> {
            definition :: program.types.find(fn(definition) { definition.id == nominal.id }) ?? return ty
            if definition.kind == { .Alias(target) -> plugin_unwrap_transparent(program, target) else -> ty }
        }
        else -> ty
    }
}

// Rust: crates/jet-codegen/src/Codegen/Plugin.rs:302
fn plugin_record_definition(program: MirProgram, ty: MirType) -> MirTypeDef? {
    ty :: plugin_unwrap_transparent(program, ty)
    if ty.kind() == {
        .Apply(nominal, _) -> {
            definition :: program.types.find(fn(definition) { definition.id == nominal.id }) ?? return None
            if definition.kind == { .Struct(_, _) -> Val(definition) else -> None }
        }
        else -> None
    }
}

// Rust: crates/jet-codegen/src/Codegen/Plugin.rs:317
fn plugin_record_fields(program: MirProgram, ty: MirType) -> [MirField]? {
    definition :: plugin_record_definition(program, ty) ?? return None
    if definition.kind == { .Struct(fields, _) -> Val(fields) else -> None }
}

// Rust: crates/jet-codegen/src/Codegen/Plugin.rs:328
fn plugin_sequence_element(program: MirProgram, ty: MirType) -> MirType? {
    if plugin_unwrap_transparent(program, ty).kind() == { .List(inner) | .FixedList(inner, _) -> Val(inner) else -> None }
}

// Rust: crates/jet-codegen/src/Codegen/Plugin.rs:338
fn plugin_fixed_list_len(program: MirProgram, ty: MirType) -> String? {
    if plugin_unwrap_transparent(program, ty).kind() == { .FixedList(_, len) -> Val(len.expression()) else -> None }
}

// Rust: crates/jet-codegen/src/Codegen/Plugin.rs:348
fn plugin_option_element(program: MirProgram, ty: MirType) -> MirType? {
    if plugin_unwrap_transparent(program, ty).kind() == { .Option(inner) -> Val(inner) else -> None }
}

// Rust: crates/jet-codegen/src/Codegen/Plugin.rs:358
fn plugin_result_elements(program: MirProgram, ty: MirType) -> (MirType, MirType)? {
    if plugin_unwrap_transparent(program, ty).kind() == { .Result(ok, err) -> Val((ok, err)) else -> None }
}

// Rust: crates/jet-codegen/src/Codegen/Plugin.rs:368
fn plugin_fresh(counter: &Int, stem: String) -> String Never! {
    value :: "__jet_plugin_{stem}_{counter}"
    counter += 1
    value
}

// Rust: crates/jet-codegen/src/Codegen/Plugin.rs:374
fn plugin_read_memory(ptr: String, offset: Int, rust_ty: String) -> String Never! {
    "unsafe {{ std::ptr::read_unaligned((({ptr}) as usize + {offset}) as *const {rust_ty}) }}"
}

// Rust: crates/jet-codegen/src/Codegen/Plugin.rs:380
fn plugin_write_memory(ptr: String, offset: Int, rust_ty: String, value: String) -> String Never! {
    "unsafe {{ std::ptr::write_unaligned((({ptr}) as usize + {offset}) as *mut {rust_ty}, {value}); }}"
}

// Rust: crates/jet-codegen/src/Codegen/Plugin.rs:386
fn plugin_flat_lift_expr(program: MirProgram, source_ty: MirType, descriptor: ComponentTypeDescriptor, args: [String], arg_slots: [PluginCoreSlot], cursor: &Int, counter: &Int, read_text: String) -> String Never! {
    if descriptor == {
        .Int -> {
            raw :: args[cursor]
            cursor += 1
            "({raw} as i64)"
        }
        .Float -> {
            raw :: args[cursor]
            slot :: arg_slots[cursor]
            cursor += 1
            if slot == PluginCoreSlot.F64 -> raw else -> "f64::from_bits(({raw} as u64))"
        }
        .Bool -> {
            raw :: args[cursor]
            slot :: arg_slots[cursor]
            cursor += 1
            if slot == { .F64 -> "match {raw} {{ 0.0 => false, 1.0 => true, _ => panic!(\"invalid canonical bool\") }}" .I32 | .I64 -> "match {raw} {{ 0 => false, 1 => true, _ => panic!(\"invalid canonical bool\") }}" }
        }
        .String -> {
            ptr :: args[cursor]
            len :: args[cursor + 1]
            cursor += 2
            "{read_text}(({ptr}) as i32, ({len}) as i32)"
        }
        .List(inner) -> {
            ptr :: args[cursor]
            len :: args[cursor + 1]
            cursor += 2
            element_ty :: plugin_sequence_element(program, source_ty) ?? panic("component list source type has no element")
            base :: plugin_fresh(&counter, "list_base")
            length :: plugin_fresh(&counter, "list_len")
            output :: plugin_fresh(&counter, "list_out")
            index :: plugin_fresh(&counter, "list_index")
            element_ptr :: plugin_fresh(&counter, "list_element_ptr")
            element :: plugin_memory_lift_expr(program, element_ty, inner, element_ptr, &counter, read_text)
            output_type :: rust_type(program, source_ty)
            fixed :: if plugin_fixed_list_len(program, source_ty) == { Val(len) -> "let {output}: {output_type} = match {output}.try_into() {{ Ok(value) => value, Err(_) => panic!(\"canonical list length mismatch (expected {len})\") }}; {output}" None -> output }
            "{{ let {base} = ({ptr}) as usize; let {length} = ({len}) as usize; let mut {output} = Vec::with_capacity({length}); for {index} in 0..{length} {{ let {element_ptr} = ({base} + {index} * {plugin_memory_layout(inner).0}) as i32; {output}.push({element}); }} {fixed} }}"
        }
        .Option(inner) -> {
            tag :: args[cursor]
            cursor += 1
            payload_start :: cursor
            payload_slots :: plugin_flat_slots(inner)
            child_ty :: plugin_option_element(program, source_ty) ?? panic("component option source type has no element")
            child :: plugin_flat_lift_expr(program, child_ty, inner, args, arg_slots, &cursor, &counter, read_text)
            cursor = payload_start + payload_slots.len()
            "{{ match {tag} {{ 0 => Err(JetAbsent), 1 => Ok({child}), _ => panic!(\"invalid canonical option discriminant\") }} }}"
        }
        .Result(ok, err) -> {
            tag :: args[cursor]
            cursor += 1
            payload_start :: cursor
            payload_slots :: merge_plugin_slots(plugin_flat_slots(ok), plugin_flat_slots(err))
            (source_ok, source_err) :: plugin_result_elements(program, source_ty) ?? panic("component result source type has no variants")
            ok_cursor := payload_start
            ok_expr :: plugin_flat_lift_expr(program, source_ok, ok, args, arg_slots, &ok_cursor, &counter, read_text)
            err_cursor := payload_start
            err_expr :: plugin_flat_lift_expr(program, source_err, err, args, arg_slots, &err_cursor, &counter, read_text)
            cursor = payload_start + payload_slots.len()
            "{{ match {tag} {{ 0 => Ok({ok_expr}), 1 => Err({err_expr}), _ => panic!(\"invalid canonical result discriminant\") }} }}"
        }
        .Record(_, descriptor_fields) -> {
            source_fields :: plugin_record_fields(program, source_ty) ?? panic("component record source type has no fields")
            values := [Int:String]{}
            loop (index, _, field_descriptor) in descriptor_fields {
                field :: source_fields.get(index) ?? panic("component record field index is out of range")
                value :: plugin_flat_lift_expr(program, field.ty, field_descriptor, args, arg_slots, &cursor, &counter, read_text)
                _ :: &values.insert(index, value)
            }
            record :: plugin_record_definition(program, source_ty) ?? panic("component record source definition disappeared")
            name :: rust_named_type_name(program, record.id, record.name)
            fields :: if record.kind == { .Struct(fields, _) -> fields else -> panic("unreachable") }
            assignments := [String]{}
            first_by_id := [U64:Int]{}
            loop (index, field) in fields {
                if first_by_id.get(field.id.0) == None -> _ :: &first_by_id.insert(field.id.0, index)
            }
            loop field in fields {
                if field.computed -> next
                index :: first_by_id.get(field.id.0) ?? panic("known field")
                value :: if field.skip -> "Default::default()" else -> values.get(index) ?? "Default::default()"
                &assignments.push("{mangle(field.name)}: {value}")
            }
            "{name} {{ {assignments.join(", ")} }}"
        }
    }
}

// Rust: crates/jet-codegen/src/Codegen/Plugin.rs:566
fn plugin_memory_lift_expr(program: MirProgram, source_ty: MirType, descriptor: ComponentTypeDescriptor, ptr: String, counter: &Int, read_text: String) -> String Never! {
    if descriptor == {
        .Int -> plugin_read_memory(ptr, 0, "i64")
        .Float -> plugin_read_memory(ptr, 0, "f64")
        .Bool -> {
            raw :: plugin_read_memory(ptr, 0, "u8")
            "match {raw} {{ 0 => false, 1 => true, _ => panic!(\"invalid canonical bool\") }}"
        }
        .String -> {
            data :: plugin_read_memory(ptr, 0, "i32")
            length :: plugin_read_memory(ptr, 4, "i32")
            "{read_text}({data}, {length})"
        }
        .List(inner) -> {
            data :: plugin_read_memory(ptr, 0, "i32")
            length :: plugin_read_memory(ptr, 4, "i32")
            element_ty :: plugin_sequence_element(program, source_ty) ?? panic("component list source type has no element")
            base :: plugin_fresh(&counter, "mem_list_base")
            len :: plugin_fresh(&counter, "mem_list_len")
            output :: plugin_fresh(&counter, "mem_list_out")
            index :: plugin_fresh(&counter, "mem_list_index")
            element_ptr :: plugin_fresh(&counter, "mem_list_element_ptr")
            element :: plugin_memory_lift_expr(program, element_ty, inner, element_ptr, &counter, read_text)
            output_type :: rust_type(program, source_ty)
            fixed :: if plugin_fixed_list_len(program, source_ty) == { Val(expected) -> "let {output}: {output_type} = match {output}.try_into() {{ Ok(value) => value, Err(_) => panic!(\"canonical list length mismatch (expected {expected})\") }}; {output}" None -> output }
            "{{ let {base} = ({data}) as usize; let {len} = ({length}) as usize; let mut {output} = Vec::with_capacity({len}); for {index} in 0..{len} {{ let {element_ptr} = ({base} + {index} * {plugin_memory_layout(inner).0}) as i32; {output}.push({element}); }} {fixed} }}"
        }
        .Option(inner) -> {
            raw :: plugin_read_memory(ptr, 0, "u8")
            payload_offset :: plugin_align_to(1, plugin_memory_layout(inner).1)
            child_ty :: plugin_option_element(program, source_ty) ?? panic("component option source type has no element")
            child_ptr :: "(({ptr}) as usize + {payload_offset}) as i32"
            child :: plugin_memory_lift_expr(program, child_ty, inner, child_ptr, &counter, read_text)
            "{{ match {raw} {{ 0 => Err(JetAbsent), 1 => Ok({child}), _ => panic!(\"invalid canonical option discriminant\") }} }}"
        }
        .Result(ok, err) -> {
            raw :: plugin_read_memory(ptr, 0, "u8")
            (_, ok_align) :: plugin_memory_layout(ok)
            (_, err_align) :: plugin_memory_layout(err)
            payload_offset :: plugin_align_to(1, ok_align.max(err_align))
            (source_ok, source_err) :: plugin_result_elements(program, source_ty) ?? panic("component result source type has no variants")
            ok_ptr :: "(({ptr}) as usize + {payload_offset}) as i32"
            ok_expr :: plugin_memory_lift_expr(program, source_ok, ok, ok_ptr, &counter, read_text)
            err_expr :: plugin_memory_lift_expr(program, source_err, err, ok_ptr, &counter, read_text)
            "{{ match {raw} {{ 0 => Ok({ok_expr}), 1 => Err({err_expr}), _ => panic!(\"invalid canonical result discriminant\") }} }}"
        }
        .Record(_, fields) -> {
            source_fields :: plugin_record_fields(program, source_ty) ?? panic("component record source type has no fields")
            offsets :: plugin_record_offsets(fields)
            values := [Int:String]{}
            loop (position, (index, _, field_descriptor)) in fields {
                offset :: offsets[position].0
                field :: source_fields.get(index) ?? panic("component record field index is out of range")
                field_ptr :: "(({ptr}) as usize + {offset}) as i32"
                value :: plugin_memory_lift_expr(program, field.ty, field_descriptor, field_ptr, &counter, read_text)
                _ :: &values.insert(index, value)
            }
            record :: plugin_record_definition(program, source_ty) ?? panic("component record source definition disappeared")
            name :: rust_named_type_name(program, record.id, record.name)
            fields :: if record.kind == { .Struct(fields, _) -> fields else -> panic("unreachable") }
            assignments := [String]{}
            first_by_id := [U64:Int]{}
            loop (index, field) in fields {
                if first_by_id.get(field.id.0) == None -> _ :: &first_by_id.insert(field.id.0, index)
            }
            loop field in fields {
                if field.computed -> next
                index :: first_by_id.get(field.id.0) ?? panic("known field")
                value :: if field.skip -> "Default::default()" else -> values.get(index) ?? "Default::default()"
                &assignments.push("{mangle(field.name)}: {value}")
            }
            "{name} {{ {assignments.join(", ")} }}"
        }
    }
}

// Rust: crates/jet-codegen/src/Codegen/Plugin.rs:713
fn plugin_flat_lower_expr(program: MirProgram, source_ty: MirType, descriptor: ComponentTypeDescriptor, value: String) -> String Never! {
    if descriptor == {
        .Int | .Float -> "*({value})"
        .Bool -> "if *({value}) {{ 1i32 }} else {{ 0i32 }}"
        .Record(_, fields) -> {
            source_fields :: plugin_record_fields(program, source_ty) ?? panic("component record source type has no fields")
            (index, _, field_descriptor) :: fields.first() ?? panic("zero-slot record cannot be lowered as a scalar")
            field :: source_fields.get(index) ?? panic("component record field index is out of range")
            plugin_flat_lower_expr(program, field.ty, field_descriptor, "&({value}).{mangle(field.name)}")
        }
        .Option(inner) -> if plugin_flat_slots(inner).is_empty() -> "match {value} {{ Ok(_) => 1i32, Err(_) => 0i32 }}" else -> panic("multi-slot option value passed to flat lowering")
        .Result(ok, err) -> if plugin_flat_slots(ok).is_empty() && plugin_flat_slots(err).is_empty() -> "match {value} {{ Ok(_) => 0i32, Err(_) => 1i32 }}" else -> panic("multi-slot result value passed to flat lowering")
        .String | .List(_) -> panic("multi-slot component value passed to flat lowering")
    }
}

// Rust: crates/jet-codegen/src/Codegen/Plugin.rs:759
fn plugin_memory_lower(program: MirProgram, source_ty: MirType, descriptor: ComponentTypeDescriptor, value: String, ptr: String, counter: &Int, allocator: String) -> String Never! {
    if descriptor == {
        .Int -> plugin_write_memory(ptr, 0, "i64", "*({value})")
        .Float -> plugin_write_memory(ptr, 0, "f64", "*({value})")
        .Bool -> plugin_write_memory(ptr, 0, "u8", "if *({value}) {{ 1u8 }} else {{ 0u8 }}")
        .String -> {
            bytes :: plugin_fresh(&counter, "string_bytes")
            length :: plugin_fresh(&counter, "string_len")
            data :: plugin_fresh(&counter, "string_data")
            statements :: [String]{
                "let {bytes} = ({value}).as_bytes();",
                "let {length} = {bytes}.len();",
                "let {data} = {allocator}(0, 0, 1, {length} as i32); if {data} == 0 && {length} != 0 {{ panic!(\"canonical string allocation failed\") }}",
                "if {length} != 0 {{ unsafe {{ std::ptr::copy_nonoverlapping({bytes}.as_ptr(), {data} as *mut u8, {length}); }} }}",
                plugin_write_memory(ptr, 0, "i32", data),
                plugin_write_memory(ptr, 4, "i32", "{length} as i32"),
            }
            "{{ {statements.join(" ")} }}"
        }
        .List(inner) -> {
            element_ty :: plugin_sequence_element(program, source_ty) ?? panic("component list source type has no element")
            length :: plugin_fresh(&counter, "write_list_len")
            bytes :: plugin_fresh(&counter, "write_list_bytes")
            data :: plugin_fresh(&counter, "write_list_data")
            index :: plugin_fresh(&counter, "write_list_index")
            item :: plugin_fresh(&counter, "write_list_item")
            element_ptr :: plugin_fresh(&counter, "write_list_element_ptr")
            nested :: plugin_memory_lower(program, element_ty, inner, item, element_ptr, &counter, allocator)
            (size, align) :: plugin_memory_layout(inner)
            write_ptr :: plugin_write_memory(ptr, 0, "i32", data)
            write_len :: plugin_write_memory(ptr, 4, "i32", "{length} as i32")
            "{{ let {length} = ({value}).len(); let {bytes} = {length}.checked_mul({size}).expect(\"canonical list size overflow\"); let {data} = {allocator}(0, 0, {align}, {bytes} as i32); if {data} == 0 && {bytes} != 0 {{ panic!(\"canonical list allocation failed\") }}; for ({index}, {item}) in ({value}).iter().enumerate() {{ let {element_ptr} = ({data} as usize + {index} * {size}) as i32; {nested} }} {write_ptr} {write_len} }}"
        }
        .Option(inner) -> {
            payload_offset :: plugin_align_to(1, plugin_memory_layout(inner).1)
            child_ty :: plugin_option_element(program, source_ty) ?? panic("component option source type has no element")
            child_ptr :: "(({ptr}) as usize + {payload_offset}) as i32"
