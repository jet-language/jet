// Rust: crates/jet-codegen/src/Codegen/Plugin.rs:1157
fn plugin_declared_host_imports(program: MirProgram) -> [String] Never! {
    imports := [String:Bool]{}
    loop need in program.facts.authority_needs {
        root :: if need.split_once(':') == { Val((root, _)) -> root None -> need }
        if root == {
            "FS.Read" | "FS.Write" | "Net.Connect" | "Exec" -> _ :: &imports.insert(root, true)
            else -> {}
        }
    }
    keys := imports.keys()
    &keys.sort()
    keys
}

