//RS const PLUGIN_IO_ERROR_HELPERS: &str = r#"
//RS // result<string, io-error> and result<_, io-error> use the same canonical
//RS // return area: one u8 discriminant at byte 0, payload at byte 8, size 64,
//RS // alignment 8. The io-error payload is a variant of size 56/alignment 8.
//RS fn JET_PLUGIN_READ_IO_ERROR(ptr: i32) -> jet_std::IOError {
//RS     let tag = unsafe { std::ptr::read_unaligned(ptr as *const u8) };
//RS     if tag <= 7 {
//RS         // io-context: operation @0; option<string> resource @4; option<s64>
//RS         // os-code @16; option<string> cause @32; total size 48/alignment 8.
//RS         let context_ptr = (ptr as usize + 8) as i32;
//RS         let operation = match unsafe {
//RS             std::ptr::read_unaligned(context_ptr as *const u8)
//RS         } {
//RS             0 => jet_std::IOOperation::Read,
