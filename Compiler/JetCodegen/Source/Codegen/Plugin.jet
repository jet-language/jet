        }
        .List(inner) -> {
            data :: plugin_fresh(&counter, "free_list_data")
            length :: plugin_fresh(&counter, "free_list_len")
            index :: plugin_fresh(&counter, "free_list_index")
            element_ptr :: plugin_fresh(&counter, "free_list_element_ptr")
            child :: plugin_memory_free(inner, element_ptr, &counter, allocator)
            (element_size, element_align) :: plugin_memory_layout(inner)
            "{{ let {data} = {plugin_read_memory(ptr, 0, "i32")}; let {length} = {plugin_read_memory(ptr, 4, "i32")}; if {data} != 0 && {length} != 0 {{ for {index} in 0..({length} as usize) {{ let {element_ptr} = ({data} as usize + {index} * {element_size}) as i32; {child} }} {allocator}({data}, ({length} as usize * {element_size}) as i32, {element_align}, 0); }} }}"
        }
        .Option(inner) -> {
            tag :: plugin_fresh(&counter, "free_option_tag")
            child_ptr :: "(({ptr}) as usize + {plugin_align_to(1, plugin_memory_layout(inner).1)}) as i32"
            child :: plugin_memory_free(inner, child_ptr, &counter, allocator)
            "{{ let {tag} = {plugin_read_memory(ptr, 0, "u8")}; match {tag} {{ 0 => {{}}, 1 => {{ {child} }}, _ => panic!(\"invalid canonical option discriminant\") }} }}"
        }
        .Result(ok, err) -> {
            tag :: plugin_fresh(&counter, "free_result_tag")
            (_, ok_align) :: plugin_memory_layout(ok)
            (_, err_align) :: plugin_memory_layout(err)
            child_ptr :: "(({ptr}) as usize + {plugin_align_to(1, ok_align.max(err_align))}) as i32"
            ok_code :: plugin_memory_free(ok, child_ptr, &counter, allocator)
            err_code :: plugin_memory_free(err, child_ptr, &counter, allocator)
            "{{ let {tag} = {plugin_read_memory(ptr, 0, "u8")}; match {tag} {{ 0 => {{ {ok_code} }}, 1 => {{ {err_code} }}, _ => panic!(\"invalid canonical result discriminant\") }} }}"
        }
        .Record(_, fields) -> {
