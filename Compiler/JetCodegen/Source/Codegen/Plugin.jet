// Rust: crates/jet-codegen/src/Codegen/Plugin.rs:1356
fn plugin_host_import_wit(import_name: String) -> String Never! {
    if import_name == {
        "FS.Read" -> "  import host-read: func(path: string) -> result<string, io-error>;\n"
        "FS.Write" -> "  import host-write: func(path: string, text: string) -> result<_, io-error>;\n"
        "Net.Connect" -> "  import host-connect: func(endpoint: string) -> bool;\n"
        "Exec" -> "  import host-exec: func(program: string, args: list<string>) -> string;\n"
        else -> ""
    }
}

// Rust: crates/jet-codegen/src/Codegen/Plugin.rs:1366
fn plugin_host_io_wit_definitions() -> String Never! {
    "enum io-operation {{\n  read,\n  write,\n  flush,\n  connect,\n  accept,\n  close,\n  resolve,\n  codec,\n}}\nrecord io-context {{\n  operation: io-operation,\n  resource: option<string>,\n  os-code: option<s64>,\n  cause: option<string>,\n}}\nenum process-resource-limit {{\n  wall-time,\n  cpu-time,\n  memory,\n  open-files,\n  output,\n}}\nvariant io-error {{\n  invalid-input(io-context),\n  not-found(io-context),\n  permission-denied(io-context),\n  timed-out(io-context),\n  cancelled(io-context),\n  closed(io-context),\n  protocol(io-context),\n  other(io-context),\n  resource-limit(process-resource-limit),\n}}\n"
}

// Rust: crates/jet-codegen/src/Codegen/Plugin.rs:1404
pub fn emit_plugin(program: MirProgram, artifact_id: MirArtifactId, whole_program_rust: String) -> PluginArtifacts Never! {
    program.cffi.validate_boundaries() catch error -> panic("MIR Plugin emission received invalid foreign boundary facts: {error}")
    artifact :: selected_artifact(program, artifact_id)
    if artifact.kind != MirArtifactKind.SandboxPlugin || artifact.target != MirArtifactTarget.RustAot -> panic("MIR Plugin emission requires a RustAot SandboxPlugin artifact, got {artifact.target:?}/{artifact.kind:?}")
    sanitized :: sanitize_package_name(artifact.name)
    exports :: export_surface(program, artifact_id)
    wit_lines := [String]{}
    wit_definitions := [String]{}
    wit_defined := [String:Bool]{}
    wrapper_fns := ""
    has_text_export := false
    has_component_export := false
    plugin_read_text :: mangle_generated("plugin_read_text")
    plugin_return_text :: mangle_generated("plugin_return_text")
    plugin_post_text :: mangle_generated("plugin_post_text")
    host_imports :: plugin_declared_host_imports(program)
    if host_imports.any(fn(name) { name == "FS.Read" || name == "FS.Write" }) -> &wit_definitions.push(plugin_host_io_wit_definitions())
    loop import_name in host_imports {
        line := plugin_host_import_wit(import_name).trim_end_matches('\n') // #4303
        &wit_lines.push(line)
    }
    loop export_row in exports {
        kebab :: to_kebab(export_row.symbol)
        wrapper_name :: mangle("plugin_export_{export_row.name}")
        callee :: export_row.callee
        if export_row.scalar == Val(scalar) {
            wit_params :: loop (i, _) in export_row.params -> "p{i}: {scalar.wit_ty()}"
            &wit_lines.push("  export {kebab}: func({wit_params.join(", ")}) -> {scalar.wit_ty()};")
            if scalar == ExportScalar.Text {
                has_text_export = true
                rust_params := [String]{}
                locals := [String]{}
                call_args := [String]{}
                loop (i, convention) in export_row.params {
                    &rust_params.push("p{i}_ptr: i32")
                    &rust_params.push("p{i}_len: i32")
                    mutable :: if convention == MirAccess.Write -> "mut " else -> ""
                    &locals.push("let {mutable}p{i} = {plugin_read_text}(p{i}_ptr, p{i}_len);")
                    &call_args.push(if convention == { .Read -> "&p{i}" .Write -> "&mut p{i}" .Move -> "p{i}" })
                }
                call :: "match {callee}({call_args.join(", ")}) {{ Ok(value) => value, Err(error) => jet_entry_error_exit_jet(error) }}"
                post_name :: mangle("plugin_post_{export_row.name}")
                &wrapper_fns.push_str("#[export_name = \"{kebab}\"]\npub extern \"C\" fn {wrapper_name}({rust_params.join(", ")}) -> i32 {{ {locals.join(" ")} jet_ffi_callback_boundary(|| {{ {plugin_return_text}({call}) }}) }}\n#[export_name = \"cabi_post_{kebab}\"]\npub extern \"C\" fn {post_name}(ret_ptr: i32) {{ {plugin_post_text}(ret_ptr) }}\n")
            } else {
                rust_params :: loop (i, _) in export_row.params -> "p{i}: {scalar.rust_ty()}"
                locals := [String]{}
                call_args := [String]{}
                loop (i, convention) in export_row.params {
                    if convention == MirAccess.Write -> &locals.push("let mut p{i} = p{i};")
                    &call_args.push(if convention == { .Write -> "&mut p{i}" .Read | .Move -> "p{i}" })
                }
                call :: "match {callee}({call_args.join(", ")}) {{ Ok(value) => value, Err(error) => jet_entry_error_exit_jet(error) }}"
                &wrapper_fns.push_str("#[export_name = \"{kebab}\"]\npub extern \"C\" fn {wrapper_name}({rust_params.join(", ")}) -> {scalar.rust_ty()} {{ {locals.join(" ")} jet_ffi_callback_boundary(|| {{ {call} }}) }}\n")
            }
            next
        }
        component :: export_row.component ?? panic("component export row has no checked signature")
        descriptor :: component_descriptor(program, component) ?? panic("component export row has no checked descriptor")
        has_component_export = true
        loop definition in descriptor.wit_definitions() {
            name := if definition.strip_prefix("record ") == { Val(rest) -> rest.split_whitespace().next() ?? "" None -> "" } // #4303
            if wit_defined.get(name) == None {
                _ :: &wit_defined.insert(name, true)
                &wit_definitions.push(definition)
            }
        }
        wit_params :: loop (i, ty) in descriptor.params -> "p{i}: {ty.wit_type()}"
        wit_result :: descriptor.result.wit_type()
        &wit_lines.push("  export {kebab}: func({wit_params.join(", ")}) -> {wit_result};")
        &wrapper_fns.push_str(plugin_component_wrapper(program, export_row, component, descriptor, kebab, wrapper_name))
    }
    wit :: "package jet:{sanitized}@0.1.0;\n\n{wit_definitions.join("\n")}\nworld {WORLD_NAME} {{\n{wit_lines.join("\n")}\n}}\n"
    guest_rust := whole_program_rust
    append_web_time_zones(&guest_rust) catch error -> panic("cannot embed sandbox timezone data: {error}")
    // Sandbox guests embed the same complete wasm TZif closure as the browser.
    &guest_rust.push_str("\n// c81 / D-PLUGIN-EXPORT1=A: generated export wrappers (jet-codegen/Plugin.rs).\n")
    if has_text_export || has_component_export || !host_imports.is_empty() -> &guest_rust.push_str(plugin_text_helpers())
    if host_imports.any(fn(name) { name == "FS.Read" || name == "FS.Write" }) -> &guest_rust.push_str(plugin_io_error_helpers())
    &guest_rust.push_str(plugin_host_import_bridge(host_imports))
    &guest_rust.push_str(wrapper_fns)
    exported_fns :: loop export_row in exports -> export_row.name
