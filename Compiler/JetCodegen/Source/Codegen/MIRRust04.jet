    fn callable_type(self, params: [MirType], conventions: [MirAccess]?, ret: MirType?) -> String {
        parameter_types :: params.iter().enumerate().map((pair) -> {
            access :: Self.callable_parameter_access(conventions, pair.0)
            rendered :: self.rust_type(pair.1)
            mode :: self.callable_parameter_mode(pair.1, access)
            callable :: if mode == 'W' -> "&mut {rendered}" else if mode == 'R' -> "&{rendered}" else if mode == 'O' -> rendered.clone() else -> panic("MIR callable has unknown mode `{mode}`")
            (rendered, callable, mode)
        }).collect::<[(String, String, Char)]>()
        parameter_text :: parameter_types.iter().map((row) -> row.1.as_str()).collect::<[String]>().join(", ")
        return_text :: ret.map((ret) -> self.rust_type(ret)).unwrap_or_else(() -> "()")
        if self.history_runtime_metadata_enabled() {
            arity :: parameter_types.len()
            modes :: parameter_types.iter().map((row) -> row.2).collect::<String>()
            borrowed_trait :: modes.chars().any((mode) -> mode != 'O')
            callable_name := String.new()
            if borrowed_trait { _ :: self.history_callable_modes.borrow_mut().insert((arity, modes.clone())); callable_name = "{self.config.root_prefix}JetHistoryFn{arity}B{modes}" }
            else { _ :: self.history_callable_arities.borrow_mut().insert(arity); callable_name = "{self.config.root_prefix}JetHistoryFn{arity}" }
            generic_values :: if borrowed_trait -> parameter_types.iter().map((row) -> row.0.as_str()).collect::<[String]>().join(", ") else -> &parameter_text
            generic_params :: if generic_values.is_empty() -> "" else -> "{generic_values}, "
            lifetime :: self.history_callback_lifetime.get()
            "Box<dyn {callable_name}<{lifetime}, {generic_params}{return_text}> + {lifetime}>"
        } else { "std::rc::Rc<std::cell::RefCell<Option<Box<dyn FnMut({parameter_text}) -> {return_text}>>>>" }
    }
