    fn handle_for_type(self, ty: MirType) -> MirHandleLifecycle? { self.program.handles.iter().find((handle) -> handle.ty.same_checked_type(ty) || handle.ty.nominal_name() == ty.nominal_name() && ty.nominal_name().is_some()) }
