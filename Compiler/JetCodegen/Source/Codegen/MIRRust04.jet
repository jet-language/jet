use jet_foundation.Syntax as Syntax
use jet_foundation.Diagnostics.LineIndex
use jet_codegen.Codegen.MIRRust.[RustEmitter, MirRustTarget, mangle, mangle_path, core_native_probe_name, compiler_trait_method_symbol, STM_TYPE, CACHED_CONSTANT_BYTES, emit_list_constant_chunks, emit_shared_constant]
use jet_codegen.Codegen as Codegen
use jet_codegen.Codegen.TIR.tir_to_mir_types.is_compiler_owned_trait
use jet_foundation.MIR.stable_id
use std.collections.BTreeSet
use std.iter.ExactSizeIterator
// GATE #4499: exact (arity, modes), (function, index) and MirFunctionId key semantics.
// GATE #4483: all emitted ABI/metadata follows config.target, never host layout.
// GATE #4494: canonical history RefCell and shared-value/handle-token substrate.
// This file extends the canonical RustEmitter; boundary fragments join its rust_type/emit_impl.
// Generated Rust is the existing AOT output, not a callback into Rust implementation.

