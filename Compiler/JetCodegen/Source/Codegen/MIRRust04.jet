                drop_impl = "impl Drop for {name} {{\nfn drop(&mut self) {{\nif let Some((_, __jet_raw)) = self.__jet_token.take_raw() {{\nlet __jet_handle = {name}::from_raw(__jet_raw as *mut core::ffi::c_void);\nlet _ = {call};\n}}\n}}\n}}\n"
            }
        }
        out.push_str("""
#[repr(transparent)]
#[derive(Debug)]
pub struct {name} {{ __jet_token: jet_foundation::MIR::MirHandleToken, }}
impl {name} {{
    pub fn from_raw(raw: *mut core::ffi::c_void) -> Self {{
        Self {{ __jet_token: jet_foundation::MIR::MirHandleToken::new(jet_foundation::MIR::MirHandleId({handle_id}), raw as i64), }}
    }}
    pub fn as_raw(&self) -> *mut core::ffi::c_void {{
        self.__jet_token.raw().map(|raw| raw as *mut core::ffi::c_void).unwrap_or_else(|| panic!("opaque handle was already moved"))
    }}
    pub fn into_raw(self) -> *mut core::ffi::c_void {{
        self.__jet_token.take_raw().map(|(_, raw)| raw as *mut core::ffi::c_void).unwrap_or_else(|| panic!("opaque handle was already moved"))
    }}
    pub fn token_identity(&self) -> usize {{ self.__jet_token.identity() }}
}}
""")
