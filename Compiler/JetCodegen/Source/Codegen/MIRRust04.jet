    fn foreign_return_type(self, foreign: MirForeign) -> String {
        if foreign.callback_transport.as_deref() == Val("native-start") { return "*mut core::ffi::c_void" }
        foreign.return_type.as_ref().map((ty) -> {
            if foreign.foreign_language == .C { if self.c_abi_type(ty, .Read) == Val(native) { return native } }
