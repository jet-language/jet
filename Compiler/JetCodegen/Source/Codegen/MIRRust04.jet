                    .None
                }).unwrap_or_else(() -> panic("native callback start row has no FfiCallbackEvent payload"))
                ret :: signature.ret.as_deref().map((ty) -> " -> {self.rust_type(ty)}").unwrap_or_default()
                return "Option<unsafe extern \"C\" fn(*mut core::ffi::c_void, {self.rust_type(payload)}){ret}>"
            }
        }
        if foreign.foreign_language == .C {
            if self.c_abi_record_def(&param.ty) == Val(definition) { name :: self.c_abi_record_name(definition); return if param.access == .Write -> "*mut {name}" else -> name }
            if self.c_abi_type(&param.ty, param.access) == Val(native) { return native }
        }
        if foreign.foreign_language == .C && !foreign.bridge_eligible && param.access == .Read && !self.is_scalar(&param.ty) { return self.rust_type(&param.ty) }
