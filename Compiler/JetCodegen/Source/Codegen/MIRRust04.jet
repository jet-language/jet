    fn is_scalar(self, ty: MirType) -> Bool {
        if self.is_core_layer() && ty.is_string() { return true }
        // JetInt owns a Foundation node even with scalar layout: Read must not move it.
        if ty.kind() == .Int { return false }
        if ty.layout.abi == { .Scalar(_) -> true; .Aggregate | .Sequence | .Function | .Nominal | .Dynamic | .Never -> false }
    }
