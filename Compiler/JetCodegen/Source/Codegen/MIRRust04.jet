    // Rust: crates/jet-codegen/src/Codegen/MIRRust.rs:5401
    // Remaining rust_type match arms, including the Option expression split at 5401.
    fn rust_type_remaining(self, ty: MirType) -> String {
        if ty.kind() == {
            .Option(inner) -> "{self.config.root_prefix}JetOutcome<{self.rust_type(inner)}, {self.config.root_prefix}JetAbsent>"
            .Result(ok: ok, err: err) -> "{self.config.root_prefix}JetOutcome<{self.rust_type(ok)}, {self.rust_type(err)}>"
            .Fn(signature) -> {
                conventions :: signature.call_metadata.as_ref().map((metadata) -> metadata.conventions.as_slice())
                self.callable_type(&signature.params, conventions, signature.ret.as_deref())
            }
            .SendFn(params: params, ret: ret, conventions: conventions) -> {
                parameter_text :: params.iter().enumerate().map((pair) -> {
                    access :: Self.callable_parameter_access(Val(conventions.as_slice()), pair.0)
                    self.callable_parameter_type(pair.1, access)
                }).collect::<[String]>().join(", ")
                return_text :: ret.as_ref().map((ret) -> self.rust_type(ret)).unwrap_or_else(() -> "()")
                "std::sync::Arc<dyn Fn({parameter_text}) -> {return_text} + Send + Sync + 'static>"
            }
            .Apply(name: name, args: args) -> self.rust_apply_type(name, args)
            .TraitObject(bounds) -> {
                names :: bounds.iter().map((bound) -> self.traits_by_name.get(&bound.name).cloned().unwrap_or_else(() -> panic("MIR trait {bound.name:?} has no declaration row"))).collect::<[String]>().join(" + ")
                "Box<dyn {names}>"
            }
            .Tuple(fields) -> {
                values :: fields.iter().map((pair) -> self.rust_type(pair.1)).collect::<[String]>()
                if values.len() == 0 -> "()" else if values.len() == 1 -> "({values[0]},)" else -> "({values.join(", ")})"
            }
            .FixedList(elem: elem, len: len) -> "[{self.rust_type(elem)}; {len.expression()}]"
            .IntN(signed: signed, bits: bits) -> "{if signed -> 'i' else -> 'u'}{bits}"
            .Tagged(marker: .Internal(.AllocatorView), inner: inner) -> "&mut {self.rust_type(inner)}"
            .InlineRange(base: base) | .Tagged(inner: base) | .Quantity(base: base) -> self.rust_type(base)
            .Float32 -> "f32"
            .Union(_) -> self.structural_type_def_for(ty).map((def) -> mangle_path(&def.key)).unwrap_or_else(() -> ty.identity.map((id) -> self.type_name(id)).unwrap_or_else(() -> panic("MIR union type has no canonical type identity")))
            .Measure(_) -> "f64"
            else -> panic("MIR rust_type leading arms must be handled by the canonical owner")
        }
    }
    // Rust: crates/jet-codegen/src/Codegen/MIRRust.rs:5492
    fn emit_web_data_type_registration(self, out: &String) -> {
        if self.config.target_kind != MirRustTarget.WebWasm { return }
        types := [String: String]{}
        loop function in &self.program.functions {
            loop block in &function.blocks {
                loop instruction in &block.instructions {
                    if instruction.operation == .CoreCall(route: route, type_args: type_args) {
                        row :: self.program.prelude_calls.iter().find((row) -> row.id == route).unwrap_or_else(() -> panic("MIR Prelude call ID {route:?} has no row"))
                        if row.symbol == .Prelude(name) {
                            if !(name.starts_with("jet_data") || name.starts_with("jet_data.loader.")) { next }
                            ty :: type_args.first() ?? next
                            _ :: types.entry(ty.name()).or_insert_with(() -> self.rust_type(ty))
                        }
                    }
                }
            }
        }
        if types.is_empty() { return }
        out.push_str("#[cfg(target_arch = \"wasm32\")]\n#[no_mangle]\npub extern \"C\" fn jet_data_web_register_types() {{\n")
        keys := types.keys().collect::<[String]>()
        keys.sort()
        loop key in keys { out.push_str("    {self.config.root_prefix}jet_data_web_register_type::<{types[key]}>({key:?});\n") }
        out.push_str("}}\n")
    }
    // Rust: crates/jet-codegen/src/Codegen/MIRRust.rs:5542
    fn rust_root_prelude_type(self, root_name: String, args: [MirType]) -> String {
        head :: "{self.config.root_prefix}{root_name}"
        if args.is_empty() { return head }
        arguments :: args.iter().map((arg) -> self.rust_type(arg)).collect::<[String]>().join(", ")
        "{head}<{arguments}>"
    }
