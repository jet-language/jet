    // Rust: crates/jet-codegen/src/Codegen/MIRRust.rs:5959
    fn is_handle_type(self, ty: MirType) -> Bool { self.program.handles.iter().any((handle) -> handle.ty.same_checked_type(ty) || handle.ty.nominal_name() == ty.nominal_name() && ty.nominal_name().is_some()) }
