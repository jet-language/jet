//RS                     | MirTypeKind::Map { .. }
//RS                     | MirTypeKind::Option(_)
//RS                     | MirTypeKind::Result { .. }
//RS                     | MirTypeKind::Tuple(_)
//RS                     | MirTypeKind::Apply { .. }
//RS             )
//RS     }
