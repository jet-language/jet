        if !impl_generic_params.is_empty() {
            if implementation.self_type.kind() == .Apply(args: args) {
                if args.is_empty() { owner = "{rendered_owner}<{impl_generic_params.iter().map((param) -> mangle(&param.name)).collect::<[String]>().join(", ")}>" }
            }
        }
        carrier_trait :: if implementation.trait_ref.is_none() && impl_generic_params.is_empty() && self.implementation_owner_def(&implementation.self_type).is_some_and((definition) -> !self.declares_type_def(definition)) -> Val("__jet_ext{mangle_path(&implementation.key)}") else -> String?.None
        trait_definition :: implementation.trait_ref.as_ref().map((trait_ref) -> self.program.traits.iter().find((definition) -> definition.id == trait_ref.id && definition.name == trait_ref.name).unwrap_or_else(() -> panic("MIR implementation {implementation.id:?} trait reference {trait_ref:?} has no declaration row")))
        operator :: implementation.operator_rhs.as_ref()
        rust_operator :: operator.filter((_) -> implementation.trait_ref.as_ref().is_some_and((trait_ref) -> [Syntax.TRAIT_ADD, Syntax.TRAIT_SUB, Syntax.TRAIT_MUL, Syntax.TRAIT_DIV].contains(trait_ref.name)))
        if operator == Val(rhs) {
            trait_ref :: implementation.trait_ref.as_ref().unwrap_or_else(() -> panic("MIR operator implementation {implementation.id:?} has no trait reference"))
            if ![Syntax.TRAIT_ADD, Syntax.TRAIT_SUB, Syntax.TRAIT_MUL, Syntax.TRAIT_DIV, Syntax.TRAIT_EQUATABLE, Syntax.TRAIT_COMPARABLE].contains(trait_ref.name) { panic("MIR operator implementation {implementation.id:?} has non-operator trait {trait_ref.name:?}") }
            if rust_operator.is_some() { out.push_str("impl{generics} {self.trait_nominal_name(trait_ref)}<{self.rust_type(rhs)}> for {owner} {{\n") }
            else { out.push_str("impl{generics} {self.trait_nominal_name(trait_ref)} for {owner} {{\n") }
        } else if implementation.trait_ref == Val(trait_ref) { out.push_str("impl{generics} {self.trait_nominal_name(trait_ref)} for {owner} {{\n") }
        else {
            if implementation.delegation.is_some() || implementation.serde.is_some() || !implementation.associated_types.is_empty() { panic("MIR inherent implementation {implementation.id:?} carries trait-only metadata") }
            if carrier_trait == Val(carrier) { out.push_str("impl {carrier} for {owner} {{\n") }
            else { out.push_str("impl{generics} {owner} {{\n") }
        }
        methods_start :: out.len()
        if trait_definition == Val(definition) {
            loop associated in &implementation.associated_types {
                if !definition.associated_types.iter().any((declared) -> declared.name == associated.name) { panic("MIR implementation {implementation.id:?} defines unknown associated type {associated.name}") }
            }
        }
        (impl_generic_params, generics, owner, carrier_trait, trait_definition, rust_operator, methods_start)
    }
}
