// Source lowering for checked dynamic data literals and canonical Serde encoding.
use jet_foundation.[
    MIRAccess,
    Effect,
    MIRCallArg,
    MIRCallSignature,
    MIRCallee,
    MIRConstant,
    mir_integer_constant,
    MIRCopyFact,
    MIRDBQueryMetadata,
    MIRDBTableFact,
    MIREnumArg,
    MIRIntegerWidth,
    MIROperation,
    MIRPhiIncoming,
    MIRPreludeABI,
    MIRPreludeCall,
    MIRPreludeCallID,
    MIRPreludeFamily,
    MIRPreludeTypeArg,
    MIRSemanticOp,
    MIRSymbol,
    MIRTerminator,
    MIRType,
    MIRTypeID,
    MIRValueID,
    Span,
    TBuiltinOp,
    TDBQueryMetadata,
    TExpr,
    TExprKind,
    TFunc,
    THandleOp,
    TLocal,
    TMapEntry,
    TPanicLoc,
    TStmt,
    Type,
    TypeTupleField,
    mir_source_file_id,
    stable_id,
    tir_generated_local,
    tir_user_local,
    core_identity_in_module,
]

fn jet_codegen_dyn_type() -> Type Never! {
    Type.Named{name: "Dyn"}
}

fn jet_codegen_dyn_type_id(builder: JetCodegenBuilder, program: JetCodegenProgram) -> MIRTypeID Never! {
    jet_codegen_type_instance_id(jet_codegen_dyn_type(), program.nominals, builder.function.module_identity, builder.generic_type_names)
}

fn jet_codegen_data_expr(ty: Type, span: Span, kind: TExprKind) -> TExpr Never! {
    TExpr{ty: ty, kind: kind, span: span, integer_bounds: None, cost: None}
}

fn jet_codegen_data_encode_node(receiver: TExpr) -> TExpr Never! {
    jet_codegen_data_expr(
        jet_codegen_dyn_type(),
        receiver.span,
        TExprKind.HandleMethod{receiver: receiver, operation: THandleOp.SerdeEncode, args: [TExpr]{}},
    )
}

fn jet_codegen_data_enum_arg(builder: &JetCodegenBuilder, program: JetCodegenProgram, argument: TExpr?, clone_arg: Bool) -> [MIREnumArg] {
    if argument == None -> return [MIREnumArg]{}
    value_expr :: argument
    value := jet_codegen_lower_expr(&builder, program, value_expr)
    if clone_arg -> value = jet_codegen_emit_value(&builder, program, value_expr.span, value_expr.ty, MIROperation.Copy{value: value, fact: MIRCopyFact.Materialize})
    [MIREnumArg]{MIREnumArg{field: None, value: value, boxed: false}}
}
fn jet_codegen_lower_data_enum(builder: &JetCodegenBuilder, program: JetCodegenProgram, expression: TExpr, owner: String, variant: String, argument: TExpr?, clone_arg: Bool) -> MIRValueID {
    args := jet_codegen_data_enum_arg(&builder, program, argument, clone_arg)
    type_id := jet_codegen_type_instance_id(Type.Named{name: owner}, program.nominals, builder.function.module_identity, builder.generic_type_names)
    jet_codegen_emit_value(&builder, program, expression.span, expression.ty, MIROperation.Enum{type_id: type_id, variant: variant, args: args})
}

fn jet_codegen_data_pair_type() -> Type Never! {
    Type.Tuple{fields: [TypeTupleField]{
        {name: "key", ty: Type.String},
        {name: "value", ty: jet_codegen_dyn_type()},
    }}
}

fn jet_codegen_data_pair(builder: &JetCodegenBuilder, program: JetCodegenProgram, span: Span, key: TExpr, value: TExpr) -> MIRValueID {
    pair_type := jet_codegen_data_pair_type()
    pair := jet_codegen_data_expr(pair_type, span, TExprKind.Tuple{values: [TExpr]{key, jet_codegen_data_encode_node(value)}})
    jet_codegen_lower_expr(&builder, program, pair)
}

fn jet_codegen_lower_ordered_object_encode(builder: &JetCodegenBuilder, program: JetCodegenProgram, expression: TExpr, entries: [TMapEntry]) -> MIRValueID {
    pair_type := jet_codegen_data_pair_type()
    values := [MIRValueID]{}
    loop entry in entries {
        &values.push(jet_codegen_data_pair(&builder, program, expression.span, entry.key, entry.value))
    }
    payload_type := Type.List{element: pair_type}
    payload := jet_codegen_emit_value(&builder, program, expression.span, payload_type, MIROperation.BuildList{values: values, trait_coercion: None})
    type_id := jet_codegen_dyn_type_id(builder, program)
    jet_codegen_emit_value(
        &builder, program,
        expression.span,
        expression.ty,
        MIROperation.Enum{type_id: type_id, variant: "Object", args: [MIREnumArg]{MIREnumArg{field: None, value: payload, boxed: false}}},
    )
}

fn jet_codegen_lower_json_literal(builder: &JetCodegenBuilder, program: JetCodegenProgram, expression: TExpr, variant: String, argument: TExpr?, clone_arg: Bool) -> MIRValueID {
    if variant == "Object" {
        value :: argument ?? panic("checked Dyn.Object is missing its map payload")
        if value.kind == {
            .MapLit(entries) -> return jet_codegen_lower_ordered_object_encode(&builder, program, expression, entries)
            else -> {}
        }
        // Rust tir_to_mir_expr JSONLit: a `[(key: String, value: Dyn)]`
        // pair list is already the Object payload every
        // engine consumes, so it becomes the payload unchanged instead of
        // being re-read as a key-ordered map.
        if value.ty == .List(_) -> return jet_codegen_lower_data_enum(&builder, program, expression, "Dyn", variant, argument, clone_arg)
        return jet_codegen_lower_container_encode(&builder, program, expression, value, jet_codegen_dyn_type(), true)
    }
    jet_codegen_lower_data_enum(&builder, program, expression, "Dyn", variant, argument, clone_arg)
}

fn jet_codegen_lower_db_value_literal(builder: &JetCodegenBuilder, program: JetCodegenProgram, expression: TExpr, variant: String, argument: TExpr?, clone_arg: Bool) -> MIRValueID {
    jet_codegen_lower_data_enum(&builder, program, expression, "DBValue", variant, argument, clone_arg)
}

fn jet_codegen_codec_kind(ty: Type) -> Int? {
    if jet_codegen_unwrap_pattern_tags(ty) == {
        .Named(name) -> {
            if name == "Date" -> return Val(0)
            if name == "LocalDate" -> return Val(1)
            if name == "LocalTime" -> return Val(2)
            if name == "DateTime" -> return Val(3)
            if name == "Duration" -> return Val(4)
            if name == "Decimal" -> return Val(5)
        }
        else -> {}
    }
    None
}

fn jet_codegen_typed_codec_target(ty: Type) -> Bool Never! {
    if ty == {
        .Int | .Float | .Bool | .String | .Char | .Float32 | .InlineRange(_, _, _) -> return true
        .IntN(_, _) | .List(_) | .FixedList(_, _) | .Option(_) -> return true
        .Map(key, _, _) -> return jet_codegen_unwrap_pattern_tags(key) == Type.String
        .Named(name) -> {
            // Core's ZonedDateTime is the `Dyn.DateTime` payload: a built-in typed codec.
            if name == "ZonedDateTime" || (core_identity_in_module(name, "core.time") && name.ends_with("::ZonedDateTime")) -> return true
            return name == "Data" || name == "Dyn" || name == "U8" || name == "I8" || name == "I16" || name == "I32" || name == "I64" || name == "I128" || name == "U16" || name == "U32" || name == "U64" || name == "U128"
        }
        .Tagged(_, inner) -> return jet_codegen_typed_codec_target(inner)
        else -> return false
    }
}

fn jet_codegen_encode_kind_value(builder: &JetCodegenBuilder, program: JetCodegenProgram, span: Span, value: Int) -> MIRValueID Never! {
    jet_codegen_emit_value(
        &builder, program,
        span,
        Type.IntN{signed: true, bits: 64},
        MIROperation.Constant{value: mir_integer_constant(value, Val(MIRIntegerWidth{signed: true, bits: 64}), None)},
    )
}

fn jet_codegen_lower_typed_encode(builder: &JetCodegenBuilder, program: JetCodegenProgram, expression: TExpr, receiver: TExpr, type_arg: Type) -> MIRValueID {
    jet_codegen_lower_builtin_codec(&builder, program, expression, receiver, type_arg, 0)
}

fn jet_codegen_lower_builtin_codec(builder: &JetCodegenBuilder, program: JetCodegenProgram, expression: TExpr, receiver: TExpr, type_arg: Type, kind: Int) -> MIRValueID {
    route := jet_codegen_intern_route(
        &builder, program,
        MIRPreludeFamily.StaticPrelude,
        "core.encoding.codec",
        "encode",
        "jet_codec_encode",
        2,
        [Bool]{false, true},
        None,
        jet_codegen_failure_carrier_for_type(expression.ty),
        MIRPreludeABI.Value,
    )
    kind_value := jet_codegen_encode_kind_value(&builder, program, expression.span, kind)
    value := jet_codegen_lower_expr(&builder, program, receiver)
    type_args := [MIRType]{jet_codegen_lower_type_for_function(type_arg, builder, program)}
    args := [MIRCallArg]{jet_codegen_numeric_call_arg(kind_value, expression.span), jet_codegen_numeric_call_arg(value, receiver.span)}
    jet_codegen_emit_value(
        &builder, program,
        expression.span,
        expression.ty,
        MIROperation.Semantic{operation: MIRSemanticOp.StaticPreludeCall{call: route, args: args, owner_type_args: [MIRPreludeTypeArg]{}, type_args: type_args}},
    )
}

fn jet_codegen_lower_optional_encode(builder: &JetCodegenBuilder, program: JetCodegenProgram, expression: TExpr, receiver: TExpr, inner: Type) -> MIRValueID {
    subject := jet_codegen_lower_expr(&builder, program, receiver)
    condition := jet_codegen_emit_value(&builder, program, expression.span, Type.Bool, MIROperation.OptionIsSome{subject: subject})
    local := tir_generated_local("encode_option_{subject.value}", expression.span)
    place := jet_codegen_bind_local(&builder, program, local, inner, false, None, None, false)
    present_block := jet_codegen_new_block(&builder, program, expression.span, "encode-option-present")
    absent_block := jet_codegen_new_block(&builder, program, expression.span, "encode-option-absent")
    join_block := jet_codegen_new_block(&builder, program, expression.span, "encode-option-join")
    jet_codegen_terminate(&builder, program, MIRTerminator.Branch{condition: condition, then_target: present_block, else_target: absent_block})
    jet_codegen_switch_block(&builder, program, present_block)
    value := jet_codegen_emit_value(&builder, program, expression.span, inner, MIROperation.OptionValue{subject: subject})
    _ := jet_codegen_emit(&builder, program, expression.span, None, MIROperation.WritePlace{place: place, value: value})
    inner_expr := jet_codegen_data_expr(inner, receiver.span, TExprKind.Local{local: local})
    encoded_expr := jet_codegen_data_expr(jet_codegen_dyn_type(), receiver.span, TExprKind.Unit)
    encoded := jet_codegen_lower_serde_encode(&builder, program, encoded_expr, inner_expr)
    present_end := builder.current
    jet_codegen_terminate(&builder, program, MIRTerminator.Jump{target: join_block})

    jet_codegen_switch_block(&builder, program, absent_block)
    tree_type_id :: jet_codegen_dyn_type_id(builder, program)
    null := jet_codegen_emit_value(
        &builder, program,
        expression.span,
        expression.ty,
        MIROperation.Enum{type_id: tree_type_id, variant: "Null", args: [MIREnumArg]{}},
    )
    absent_end := builder.current
    jet_codegen_terminate(&builder, program, MIRTerminator.Jump{target: join_block})
    jet_codegen_switch_block(&builder, program, join_block)
    incoming := [MIRPhiIncoming]{
        {block: present_end, value: encoded},
        {block: absent_end, value: null},
    }
    jet_codegen_emit_value(&builder, program, expression.span, expression.ty, MIROperation.Phi{incoming: incoming})
}

fn jet_codegen_lower_container_encode(builder: &JetCodegenBuilder, program: JetCodegenProgram, expression: TExpr, receiver: TExpr, element: Type, map: Bool) -> MIRValueID {
    source_value := jet_codegen_lower_expr(&builder, program, receiver)
    source_local := tir_generated_local("encode_source_{source_value.value}", receiver.span)
    source_place := jet_codegen_bind_local(&builder, program, source_local, receiver.ty, false, None, None, false)
    _ := jet_codegen_emit(&builder, program, receiver.span, None, MIROperation.WritePlace{place: source_place, value: source_value})
    source_expr := jet_codegen_data_expr(receiver.ty, receiver.span, TExprKind.Local{local: source_local})

    tree_type := jet_codegen_dyn_type()
    encoded_element_type := if map -> jet_codegen_data_pair_type() else -> tree_type
    output_type := Type.List{element: encoded_element_type}
    output_local := tir_generated_local("encode_output_{source_value.value}", expression.span)
    output_local.mutable = true
    output_place := jet_codegen_bind_local(&builder, program, output_local, output_type, true, None, None, false)
    empty := jet_codegen_emit_value(&builder, program, expression.span, output_type, MIROperation.BuildList{values: [MIRValueID]{}, trait_coercion: None})
    _ := jet_codegen_emit(&builder, program, expression.span, None, MIROperation.WritePlace{place: output_place, value: empty})

    loop_body := [TStmt]{}
    variable := tir_user_local("encode_item_{source_value.value}", expression.span)
    variable_two := TLocal?{None}
    encoded_value := if {
        map -> {
            key_local := tir_user_local("encode_key_{source_value.value}", expression.span)
            item_local := tir_user_local("encode_value_{source_value.value}", expression.span)
            variable = key_local
            variable_two = Val(item_local)
            key_expr := jet_codegen_data_expr(Type.String, expression.span, TExprKind.Local{local: key_local})
            item_expr := jet_codegen_data_expr(element, expression.span, TExprKind.Local{local: item_local})
            jet_codegen_data_expr(
                encoded_element_type,
                expression.span,
                TExprKind.Tuple{values: [TExpr]{key_expr, jet_codegen_data_encode_node(item_expr)}},
            )
        } else -> {
            item_expr := jet_codegen_data_expr(element, expression.span, TExprKind.Local{local: variable})
            jet_codegen_data_encode_node(item_expr)
        }
    }
    output_expr := jet_codegen_data_expr(output_type, expression.span, TExprKind.Local{local: output_local})
    push_expr := jet_codegen_data_expr(
        Type.Named{name: "Unit"},
        expression.span,
        TExprKind.BuiltinMethod{receiver: output_expr, operation: TBuiltinOp.Push, args: [TExpr]{encoded_value}},
    )
    &loop_body.push(TStmt.ExprStmt{value: push_expr, span: expression.span})
    jet_codegen_lower_statement(
        &builder, program,
        TStmt.ForIn{label: None, variable: variable, variable_two: variable_two, source: source_expr, collection: source_expr, step: None, method_kind: None, columnar: false, by_value: false, source_stable: false, body: loop_body, span: expression.span},
    )

    output_place = jet_codegen_lower_local_place(&builder, program, output_local)
    payload := jet_codegen_emit_value(&builder, program, expression.span, output_type, MIROperation.MovePlace{place: output_place})
    variant := if map -> "Object" else -> "Array"
    tree_type_id :: jet_codegen_dyn_type_id(builder, program)
    jet_codegen_emit_value(
        &builder, program,
        expression.span,
        expression.ty,
        MIROperation.Enum{type_id: tree_type_id, variant: variant, args: [MIREnumArg]{MIREnumArg{field: None, value: payload, boxed: false}}},
    )
}

fn jet_codegen_data_union_enum_name(members: [Type]) -> String Never! {
    tags := [String]{}
    loop member in members -> &tags.push(jet_codegen_union_member_tag(member))
    "__JetUnion_{tags.join("_")}"
}

// Rust: crates/jet-codegen/src/Codegen/TIR/tir_to_mir_expr.rs::lower_serde_encode / lower_dyn_decode
fn jet_codegen_data_codec_function(builder: JetCodegenBuilder, program: JetCodegenProgram, ty: Type, codec: String, method_name: String) -> TFunc? {
    owner_type := if ty == {
        .Union(members) -> Type.Named{name: jet_codegen_data_union_enum_name(members)}
        else -> ty
    }
    owner_name := if owner_type == {
        .Named(name) | .Apply(name, _) -> name
        else -> { return None }
    }
    if builder.generic_type_names.contains(owner_name) -> return None
    owner_identity := jet_codegen_find_nominal_identity(program.nominals, builder.function.module_identity, owner_name, builder.generic_type_names)
    if owner_identity == None -> return None
    identity :: owner_identity ?? return None
    owner_key :: jet_codegen_qualified_function_key(identity.module_identity, identity.name)
    owner_row :: program.owners.hooks.nominal_by_owner.get(owner_key) ?? return None
    if program.owners.hooks.nominal_rows[owner_row].next_owner >= 0 -> panic("ambiguous checked Serde {codec} owner identity")
    module_index :: program.owners.hooks.nominal_rows[owner_row].module_index
    nominal_index :: program.owners.hooks.nominal_rows[owner_row].nominal_index
    target_key :: program.modules[module_index].nominals[nominal_index].identity_key
    selected := TFunc?{None}
    key :: jet_codegen_hook_method_key(target_key, codec, method_name)
    row := program.owners.hooks.exact_methods.get(key) ?? -1
    // As in Rust (`function_id_for` missing target), a codec method whose
    // body this program does not lower leaves the builtin codec routes.
    loop row >= 0 {
        candidate :: program.owners.hooks.implementation_rows[row]
        found :: jet_codegen_find_function(program.function_index, program.modules[candidate.module_index].impls[candidate.implementation_index].methods[candidate.method_index].symbol.id.key)
        if found != None {
            if selected != None -> panic("ambiguous checked Serde {codec} implementation")
            selected = found
        }
        row = candidate.next_exact
    }
    selected
}

fn jet_codegen_data_encode_function(builder: JetCodegenBuilder, program: JetCodegenProgram, ty: Type) -> TFunc? {
    jet_codegen_data_codec_function(builder, program, ty, "Encode", "encode")
}

fn jet_codegen_data_decode_function(builder: JetCodegenBuilder, program: JetCodegenProgram, ty: Type) -> TFunc? {
    jet_codegen_data_codec_function(builder, program, ty, "Decode", "decode")
}

fn jet_codegen_data_encode_variant(ty: Type) -> String? {
    if jet_codegen_unwrap_pattern_tags(ty) == {
        .Int | .IntN(_, _) -> return Val("Int")
        .Float | .Float32 -> return Val("Float")
        .Bool -> return Val("Bool")
        .String | .Char -> return Val("Text")
        else -> return None
    }
}

fn jet_codegen_lower_serde_encode(builder: &JetCodegenBuilder, program: JetCodegenProgram, expression: TExpr, receiver: TExpr) -> MIRValueID {
    ty := jet_codegen_unwrap_pattern_tags(receiver.ty)
    function := jet_codegen_data_encode_function(builder, program, ty)
    if function != None {
        target :: function ?? panic("checked Serde encode target disappeared")
        owner_type := if ty == {
            .Union(members) -> Type.Named{name: jet_codegen_data_union_enum_name(members)}
            else -> receiver.ty
        }
        owner := jet_codegen_lower_type_for_function(owner_type, builder, program)
        value := jet_codegen_lower_expr(&builder, program, receiver)
        result_type := jet_codegen_checked_method_return_type(builder, program, target, owner_type, [Type]{})
        jet_codegen_note_core_module(&builder, program, target.module_name)
        args := [MIRCallArg]{jet_codegen_numeric_call_arg(value, receiver.span)}
        return jet_codegen_emit_value(
            &builder, program,
            expression.span,
            result_type,
            MIROperation.Call{callee: MIRCallee.Method{function: jet_codegen_function_id(target), owner: owner}, args: args, type_args: [MIRType]{}},
        )
    }

    if ty == (Type.Named{name: "Dyn"}) -> return jet_codegen_lower_expr(&builder, program, receiver)
    builtin_kind := jet_codegen_codec_kind(ty)
    if builtin_kind != None -> return jet_codegen_lower_builtin_codec(&builder, program, expression, receiver, ty, builtin_kind ?? 0)
    if ty == {
        .List(inner) | .FixedList(inner, _) -> {
            if jet_codegen_unwrap_pattern_tags(inner) != (Type.IntN{signed: false, bits: 8}) -> return jet_codegen_lower_container_encode(&builder, program, expression, receiver, inner, false)
        }
        .Map(key, _, value) -> if jet_codegen_unwrap_pattern_tags(key) == Type.String -> return jet_codegen_lower_container_encode(&builder, program, expression, receiver, value, true)
        .Option(inner) -> return jet_codegen_lower_optional_encode(&builder, program, expression, receiver, inner)
        else -> {}
    }
    if jet_codegen_typed_codec_target(ty) -> return jet_codegen_lower_typed_encode(&builder, program, expression, receiver, ty)
    // A bounded generic receiver (`fn to_string<T: Encode>(value: T)`) has
    // no encode function of its own in the template: the typed codec route
    // takes `T` as its type argument, which each monomorphized instance
    // substitutes with the concrete type.
    if ty == {
        .Named(name) | .Apply(name, _) -> {
            if builder.generic_type_names.contains(name) -> return jet_codegen_lower_typed_encode(&builder, program, expression, receiver, ty)
        }
        else -> {}
    }

    variant :: jet_codegen_data_encode_variant(ty) ?? panic("checked Serde encode target has no Dyn variant or encode method")
    value := jet_codegen_lower_expr(&builder, program, receiver)
    tree_type_id :: jet_codegen_dyn_type_id(builder, program)
    jet_codegen_emit_value(
        &builder, program,
        expression.span,
        expression.ty,
        MIROperation.Enum{type_id: tree_type_id, variant: variant, args: [MIREnumArg]{MIREnumArg{field: None, value: value, boxed: false}}},
    )
}

fn jet_codegen_lower_dyn_decode(builder: &JetCodegenBuilder, program: JetCodegenProgram, expression: TExpr, receiver: TExpr, target_type: Type) -> MIRValueID {
    target := jet_codegen_unwrap_pattern_tags(target_type)
    function := jet_codegen_data_decode_function(builder, program, target)
    if function != None {
        target_function :: function ?? panic("checked Serde decode target disappeared")
        owner_type := if target == {
            .Union(members) -> Type.Named{name: jet_codegen_data_union_enum_name(members)}
            else -> target_type
        }
        owner := jet_codegen_lower_type_for_function(owner_type, builder, program)
        value := jet_codegen_lower_expr(&builder, program, receiver)
        result_type := jet_codegen_checked_method_return_type(builder, program, target_function, owner_type, [Type]{})
        jet_codegen_note_core_module(&builder, program, target_function.module_name)
        args := [MIRCallArg]{jet_codegen_numeric_call_arg(value, receiver.span)}
        return jet_codegen_emit_value(
            &builder, program,
            expression.span,
            result_type,
            MIROperation.Call{callee: MIRCallee.Associated{function: jet_codegen_function_id(target_function), owner: owner}, args: args, type_args: [MIRType]{}},
        )
    }
    builtin_kind := jet_codegen_codec_kind(target)
    if builtin_kind != None {
        route := jet_codegen_intern_route(
            &builder, program,
            MIRPreludeFamily.StaticPrelude,
            "core.encoding.codec",
            "decode",
            "jet_codec_decode",
            2,
            [Bool]{false, true},
            None,
            jet_codegen_failure_carrier_for_type(expression.ty),
            MIRPreludeABI.Value,
        )
        kind_value := jet_codegen_encode_kind_value(&builder, program, expression.span, builtin_kind ?? 0)
        value := jet_codegen_lower_expr(&builder, program, receiver)
        type_args := [MIRType]{jet_codegen_lower_type_for_function(target_type, builder, program)}
        args := [MIRCallArg]{jet_codegen_numeric_call_arg(kind_value, expression.span), jet_codegen_numeric_call_arg(value, receiver.span)}
        return jet_codegen_emit_value(
            &builder, program,
            expression.span,
            expression.ty,
            MIROperation.Semantic{operation: MIRSemanticOp.StaticPreludeCall{call: route, args: args, owner_type_args: [MIRPreludeTypeArg]{}, type_args: type_args}},
        )
    }
    if jet_codegen_typed_codec_target(target) {
        route := jet_codegen_intern_route(
            &builder, program,
            MIRPreludeFamily.StaticPrelude,
            "core.encoding.codec",
            "decode_typed",
            "jet_codec_decode_typed",
            1,
            [Bool]{true},
            None,
            jet_codegen_failure_carrier_for_type(expression.ty),
            MIRPreludeABI.Value,
        )
        value := jet_codegen_lower_expr(&builder, program, receiver)
        args := [MIRCallArg]{jet_codegen_numeric_call_arg(value, receiver.span)}
        type_args := [MIRType]{jet_codegen_lower_type_for_function(target_type, builder, program)}
        return jet_codegen_emit_value(
            &builder, program,
            expression.span,
            expression.ty,
            MIROperation.Semantic{operation: MIRSemanticOp.StaticPreludeCall{call: route, args: args, owner_type_args: [MIRPreludeTypeArg]{}, type_args: type_args}},
        )
    }
    panic("checked Serde decode target has no Dyn codec or decode method")
}

fn jet_codegen_data_mir_db_metadata(metadata: TDBQueryMetadata?) -> MIRDBQueryMetadata? {
    if metadata == None -> return None
    source :: metadata
    table_facts := [MIRDBTableFact]{}
    loop fact in source.table_facts {
        &table_facts.push(MIRDBTableFact{table_id: fact.table_id, read: fact.read, write: fact.write})
    }
    Val(MIRDBQueryMetadata{
        source_file: mir_source_file_id(source.source_file),
        source_path: source.source_file,
        source_span: source.source_span,
        statement_identity: source.statement_identity,
        table_facts: table_facts,
    })
}

fn jet_codegen_data_db_query_route(builder: &JetCodegenBuilder, program: JetCodegenProgram, expression: TExpr, operation: THandleOp) -> MIRPreludeCallID? {
    member := ""
    symbol := ""
    metadata := TDBQueryMetadata?{None}
    if operation == {
        .DBQuery(value) -> {
            member = "query"
            symbol = "jet_db_scope_query_with_metadata"
            metadata = value
        }
        .DBQueryOne(value) -> {
            member = "query_one"
            symbol = "jet_db_scope_query_one_with_metadata"
            metadata = value
        }
        .DBExecute(value) -> {
            member = "execute"
            symbol = "jet_db_scope_execute_with_metadata"
            metadata = value
        }
        else -> return None
    }
    carrier := jet_codegen_failure_carrier_for_type(expression.ty)
    effect_name :: jet_codegen_core_effect_name(Effect.DB) ?? panic("checked database route lost its canonical effect")
    identity := "HandleMethod:core.handle:{member}:{symbol}:3:3:[true, true, true]:Some({effect_name}):{jet_codegen_core_route_fallibility_identity(carrier)}:Value"
    id := MIRPreludeCallID{value: stable_id("mir-prelude-call", identity)}
    call_fallibility :: jet_codegen_core_call_fallibility(carrier, builder, program)
    call := jet_codegen_intern_prelude_call(
        &builder, program,
        MIRPreludeCall{
            id: id,
            family: MIRPreludeFamily.HandleMethod,
            module_name: "core.handle",
            member: member,
            symbol: MIRSymbol.Prelude{name: symbol},
            signature: MIRCallSignature{arity: 3, max_arity: 3, borrow_mask: [Bool]{true, true, true}},
            effect_kind: Val(Effect.DB),
            fallibility: call_fallibility,
            abi: MIRPreludeABI.Value,
            authority: None,
            db_metadata: jet_codegen_data_mir_db_metadata(metadata),
        },
    )
    Val(call)
}

fn jet_codegen_data_handle_route(builder: &JetCodegenBuilder, program: JetCodegenProgram, expression: TExpr, operation: THandleOp) -> MIRPreludeCallID? {
    db_route := jet_codegen_data_db_query_route(&builder, program, expression, operation)
    if db_route != None -> return db_route
    member := ""
    symbol := ""
    arity := 0
    borrow_mask := [Bool]{}
    if operation == {
        .DynField | .JSONField -> {
            member = "field"
            symbol = "jet_dyn_field"
            arity = 2
            borrow_mask = [Bool]{true, true}
        }
        .DynAt | .JSONAt -> {
            member = "at"
            symbol = "jet_dyn_at"
            arity = 2
            borrow_mask = [Bool]{true, false}
        }
        .DynInt | .JSONInt -> {
            member = "int"
            symbol = "jet_dyn_int"
            arity = 1
            borrow_mask = [Bool]{true}
        }
        .DynText | .JSONText -> {
            member = "text"
            symbol = "jet_dyn_text"
            arity = 1
            borrow_mask = [Bool]{true}
        }
        .DynBool | .JSONBool -> {
            member = "bool"
            symbol = "jet_dyn_bool"
            arity = 1
            borrow_mask = [Bool]{true}
        }
        .DynFloat | .JSONFloat -> {
            member = "float"
            symbol = "jet_dyn_float"
            arity = 1
            borrow_mask = [Bool]{true}
        }
        .DynToText | .JSONToText -> {
            member = "to_text"
            symbol = "jet_dyn_to_text"
            arity = 1
            borrow_mask = [Bool]{true}
        }
        .DynEqualUnordered | .JSONEqualUnordered -> {
            member = "equal_unordered"
            symbol = "jet_dyn_equal_unordered"
            arity = 2
            borrow_mask = [Bool]{true, true}
        }
        .DBValueInt -> {
            member = "int"
            symbol = "jet_std::DBValue::int"
            arity = 1
            borrow_mask = [Bool]{true}
        }
        .DBValueFloat -> {
            member = "float"
            symbol = "jet_std::DBValue::float"
            arity = 1
            borrow_mask = [Bool]{true}
        }
        .DBValueText -> {
            member = "text"
            symbol = "jet_std::DBValue::text"
            arity = 1
            borrow_mask = [Bool]{true}
        }
        .DBValueBool -> {
            member = "bool"
            symbol = "jet_std::DBValue::bool"
            arity = 1
            borrow_mask = [Bool]{true}
        }
        .DBValueBlob -> {
            member = "blob"
            symbol = "jet_std::DBValue::blob"
            arity = 1
            borrow_mask = [Bool]{true}
        }
        .DBValueIsNull -> {
            member = "is_null"
            symbol = "jet_std::DBValue::is_null"
            arity = 1
            borrow_mask = [Bool]{true}
        }
        else -> return None
    }
    Val(jet_codegen_intern_route(
        &builder, program,
        MIRPreludeFamily.HandleMethod,
        "core.encoding.dyn",
        member,
        symbol,
        arity,
        borrow_mask,
        None,
        jet_codegen_failure_carrier_for_type(expression.ty),
        MIRPreludeABI.Value,
    ))
}

// The logical MIR operands keep the receiver first. The Rust emitter adapts
// binary operand order and packs path steps into the Prelude's borrowed slice.
fn jet_codegen_lower_dyn_operation(builder: &JetCodegenBuilder, program: JetCodegenProgram, expression: TExpr, receiver: TExpr, operation: THandleOp, args: [TExpr]) -> MIRValueID {
    member := ""
    symbol := ""
    expected_args := 0
    borrow_mask := [Bool]{true}
    site := String?{None}
    operator := String?{None}
    location := TPanicLoc?{None}
    mutating := false
    if operation == {
        .DynIndexKey(value, loc) -> {
            member = "index_key"
            symbol = "jet_dyn_index_key"
            expected_args = 1
            borrow_mask = [Bool]{true, true, true}
            site = Val(value)
            location = Val(loc)
        }
        .DynIndexAt(value, loc) -> {
            member = "index_at"
            symbol = "jet_dyn_index_at"
            expected_args = 1
            borrow_mask = [Bool]{true, false, true}
            site = Val(value)
            location = Val(loc)
        }
        .DynGetKey -> {
            member = "get_key"
            symbol = "jet_dyn_get_key"
            expected_args = 1
            borrow_mask = [Bool]{true, true}
        }
        .DynGetAt -> {
            member = "get_at"
            symbol = "jet_dyn_get_at"
            expected_args = 1
            borrow_mask = [Bool]{true, false}
        }
        .DynHas -> {
            member = "has"
            symbol = "jet_dyn_has"
            expected_args = 1
            borrow_mask = [Bool]{true, true}
        }
        .DynKeys -> {
            member = "keys"
            symbol = "jet_dyn_keys"
        }
        .DynLen(value, loc) -> {
            member = "len"
            symbol = "jet_dyn_len"
            borrow_mask = [Bool]{true, true}
            site = Val(value)
            location = Val(loc)
        }
        .DynRemove -> {
            member = "remove"
            symbol = "jet_dyn_remove"
            expected_args = 1
            borrow_mask = [Bool]{true, true}
            mutating = true
        }
        .DynBinary(op, value, loc) | .DynCompare(op, value, loc) -> {
            compare :: operation == .DynCompare(_, _, _)
            member = if compare -> "compare" else -> "binary"
            symbol = if compare -> "jet_dyn_compare" else -> "jet_dyn_binary"
            expected_args = 1
            borrow_mask = [Bool]{true, true, true, true}
            operator = Val(op)
            site = Val(value)
            location = Val(loc)
        }
        .DynSetPath(keys, value, loc) -> {
            member = "set_path"
            symbol = "jet_dyn_set_path"
            expected_args = keys.len() + 1
            if args.len() != expected_args -> panic("checked Dyn setter has unexpected arguments")
            loop (index, key) in keys {
                expected :: if key -> Type.String else -> Type.Int
                if jet_codegen_unwrap_pattern_tags(args[index].ty) != expected -> panic("checked Dyn path step has the wrong type")
                &borrow_mask.push(false)
            }
            &borrow_mask.push(false)
            &borrow_mask.push(true)
            site = Val(value)
            location = Val(loc)
            mutating = true
        }
        else -> panic("checked Dyn operation has no lowering")
    }
    if args.len() != expected_args -> panic("checked Dyn operation has unexpected arguments")
    receiver_value :: if mutating -> jet_codegen_method_receiver_arg(&builder, program, receiver, MIRAccess.Write).value else -> jet_codegen_lower_expr(&builder, program, receiver)
    lowered_args := [MIRValueID]{}
    loop argument in args -> &lowered_args.push(jet_codegen_lower_expr(&builder, program, argument))
    if operator == .Val(value) -> &lowered_args.push(jet_codegen_emit_value(&builder, program, expression.span, Type.String, MIROperation.Constant{value: MIRConstant.String{value: value}}))
    if site == .Val(value) -> &lowered_args.push(jet_codegen_emit_value(&builder, program, expression.span, Type.String, MIROperation.Constant{value: MIRConstant.String{value: value}}))
    result_type :: if location != None -> Type.Result{ok: expression.ty, err: Type.String} else -> expression.ty
    route :: jet_codegen_intern_route(&builder, program, MIRPreludeFamily.HandleMethod, "core.encoding.dyn", member, symbol, borrow_mask.len(), borrow_mask, None, jet_codegen_failure_carrier_for_type(result_type), MIRPreludeABI.Value)
    result :: jet_codegen_emit_value(&builder, program, expression.span, result_type, MIROperation.Semantic{operation: MIRSemanticOp.HandleMethod{call: route, receiver: receiver_value, args: lowered_args, frame_schedule: None, frame_schedule_derivation: None}})
    if location == .Val(loc) {
        condition :: jet_codegen_emit_value(&builder, program, expression.span, Type.Bool, MIROperation.ResultIsOk{subject: result})
        success :: jet_codegen_new_block(&builder, program, expression.span, "dyn-success")
        failure :: jet_codegen_new_block(&builder, program, expression.span, "dyn-stop")
        jet_codegen_terminate(&builder, program, MIRTerminator.Branch{condition: condition, then_target: success, else_target: failure})
        jet_codegen_switch_block(&builder, program, failure)
        message :: jet_codegen_emit_value(&builder, program, expression.span, Type.String, MIROperation.ResultValue{subject: result, ok: false})
        jet_codegen_lower_panic_value(&builder, program, expression, message, loc)
        jet_codegen_switch_block(&builder, program, success)
        return jet_codegen_emit_value(&builder, program, expression.span, expression.ty, MIROperation.ResultValue{subject: result, ok: true})
    }
    result
}

fn jet_codegen_lower_data_handle_method(builder: &JetCodegenBuilder, program: JetCodegenProgram, expression: TExpr, receiver: TExpr, operation: THandleOp, args: [TExpr]) -> MIRValueID {
    if operation == {
        .DynDecode(target) -> {
            if args.len() != 0 -> panic("checked Dyn decode has unexpected arguments")
            return jet_codegen_lower_dyn_decode(&builder, program, expression, receiver, target)
        }
        else -> {}
    }
    route :: jet_codegen_data_handle_route(&builder, program, expression, operation) ?? panic("checked data handle operation has no dedicated route")
    expected_args := if operation == {
        .DynField | .DynAt | .DynEqualUnordered | .JSONField | .JSONAt | .JSONEqualUnordered | .DBQuery(_) | .DBQueryOne(_) | .DBExecute(_) -> 1
        else -> 0
    }
    if args.len() != expected_args -> panic("checked data handle operation has unexpected arguments")
    receiver_value := jet_codegen_lower_expr(&builder, program, receiver)
    lowered_args := [MIRValueID]{}
    loop argument in args -> &lowered_args.push(jet_codegen_lower_expr(&builder, program, argument))
    jet_codegen_emit_value(
        &builder, program,
        expression.span,
        expression.ty,
        MIROperation.Semantic{operation: MIRSemanticOp.HandleMethod{call: route, receiver: receiver_value, args: lowered_args, frame_schedule: None, frame_schedule_derivation: None}},
    )
}

