use jet_foundation.Syntax as Syntax

// Rust: crates/jet-codegen/src/Codegen/Utils.rs:5
// Dynamic Data variants plus the compiler-only typed-JSON numeric carrier.
fn is_json_variant(variant: String) -> Bool Never! {
    Syntax.is_data_variant(variant) || variant == "Number"
}
// Rust: crates/jet-codegen/src/Codegen/Utils.rs:10
fn is_db_value_variant(variant: String) -> Bool Never! {
    Syntax.is_db_value_variant(variant)
}
// Rust: crates/jet-codegen/src/Codegen/Utils.rs:15
fn is_key_variant(variant: String) -> Bool Never! {
    if variant == {
        "Char" | "Enter" | "Escape" | "Backspace" | "Tab" | "Delete" |
        "Up" | "Down" | "Left" | "Right" | "F" | "Ctrl" | "Unknown" -> true
        else -> false
    }
}
// Rust: crates/jet-codegen/src/Codegen/Utils.rs:34
fn escape_rust_str(s: String) -> String Never! {
    escaped :: s.replace("\\", "\\\\").replace("\"", "\\\"")
    "\"{escaped}\""
}
