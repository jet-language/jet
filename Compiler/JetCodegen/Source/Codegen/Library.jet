            "cpp" -> ["universal C++ ABI and unselected template/class layouts", "implicit exception or string_view lifetime conversion"]
            "rust" -> ["direct Rust-native ABI and unproven repr/layout"]
            "zig" -> ["Zig-native ABI; the generated adapter is C-shim-only", "implicit allocator or sentinel-pointer conversion"]
            "go" -> ["Go pointer retention across calls; cgo handles are required"]
            "python" -> ["foreign interpreter ownership outside the active ctypes process"]
