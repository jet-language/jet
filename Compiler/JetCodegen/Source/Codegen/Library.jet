            direction: "jet-export-to-host + foreign-import-to-jet via stable C shim",
            artifact_identity: ~artifact.artifact_identity, contract: ^contract,
            ownership: "owned resource handles; borrowed views carry slot+generation",
            integer_ranges: "Jet Int is exact; fixed-width I64 adapters check bounds before entry and return overflow",
            encoding: "UTF-8 pointer+length; no NUL truncation; invalid pairs are rejected",
            enums: "tagged discriminants use canonical Encode in supported Outcome error carriers; enum value parameters/results without a checked descriptor are explicit unsupported",
            errors: "lifecycle status values remain distinct from lossless guest Outcome payloads in JetComponent/DataTree; panic, exception, and cancellation do not cross the C ABI",
            runtime_roots: if language == {
