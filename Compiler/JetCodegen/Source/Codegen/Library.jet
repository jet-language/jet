// Rust: crates/jet-codegen/src/Codegen/Library.rs:375
fn collect_exports(program: MirProgram, artifact_id: MirArtifactId) -> ([LibraryExport], [RichExport], [ResourceExport]) Never! {
    scalar := [LibraryExport]{}
    rich := [RichExport]{}
    resources := [ResourceExport]{}
    loop export in export_surface(program, artifact_id) {
        if export.scalar == .Val(export_scalar) {
            scalar.push(LibraryExport{name: ^export.name, symbol: ^export.symbol, callee: ^export.callee, scalar: export_scalar, params: export.params.len(), conventions: ^export.params, ownership: ^export.ownership})
            continue
        }
        component :: export.component ?? continue
        resources.push(ResourceExport{name: ~export.name, symbol: ~export.symbol, callee: ~export.callee, component: ~component, params: ~export.params, ownership: ~export.ownership, failure: ~export.failure})
        descriptor :: component_descriptor(program, component) ?? continue
        rich.push(RichExport{name: ^export.name, symbol: ^export.symbol, callee: ^export.callee, component: ^component, descriptor: ^descriptor, params: ^export.params, ownership: ^export.ownership, failure: ^export.failure})
    }
    (^scalar, ^rich, ^resources)
}
// Rust: crates/jet-codegen/src/Codegen/Library.rs:425
pub fn emit_library(program: MirProgram, artifact_id: MirArtifactId, whole_program_rust: String, requested_bindings: [String]) -> LibraryArtifacts Never! {
    artifact :: selected_artifact(program, artifact_id)
    if artifact.kind != .NativeLibrary || artifact.target != .RustAot -> panic("MIR Library emission requires a RustAot NativeLibrary artifact, got {artifact.target}/{artifact.kind}")
    name :: artifact.name
    (exports, rich_exports, resource_exports) :: collect_exports(program, artifact_id)
    classified_resource_plan :: classify_resource_exports(resource_exports)
    resource_error_unsupported :: classified_resource_plan.is_some_and(plan -> !resource_errors_supported(program, resource_exports, plan))
    resource_plan :: classified_resource_plan.filter(plan -> resource_errors_supported(program, resource_exports, plan))
    has_text_export :: exports.any(export -> export.scalar == .Text)
    wrappers := ""
    loop export in exports {
        params :: (0..export.params).map(index -> if export.scalar == .Text -> "p{index}: JetText" else -> "p{index}: {export.scalar.rust_ty()}").to_list()
        locals :: export.conventions.enumerate().map((index, convention) -> {
            mutable :: if convention == .Write -> "mut " else -> ""
            if export.scalar == .Text -> "let {mutable}p{index} = {mangle_generated("library_read_text")}(p{index});"
            else if export.scalar == .Int -> "let {mutable}p{index} = jet_std::jet_int_owned_from_i64(p{index});"
            else if convention == .Write -> "let mut p{index} = p{index};"
            else -> ""
        }).filter(line -> !line.is_empty()).to_list()
        args :: (0..export.params).map(index -> {
            convention :: export.conventions[index]
            if (export.scalar == .Text || export.scalar == .Int) && convention == .Read -> "&p{index}"
            else if convention == .Write -> "&mut p{index}"
            else -> "p{index}"
        }).to_list()
        wrapper :: mangle("library_export_{export.name}")
        symbol :: export.symbol
        callee :: export.callee
        return_type :: if export.scalar == .Text -> "JetText" else -> export.scalar.rust_ty()
        call :: if export.scalar == .Int -> "match {callee}({args.join(", ")}) {{ Ok(value) => jet_std::jet_int_owned_to_i64(&value).unwrap_or_else(|_| jet_arithmetic_stop(\"\", 0, \"native Int result exceeds host range\")), Err(error) => jet_entry_error_exit_jet(error) }}" else -> "match {callee}({args.join(", ")}) {{ Ok(value) => value, Err(error) => jet_entry_error_exit_jet(error) }}"
        body :: if export.scalar == .Text -> "{locals.join(" ")} {mangle_generated("library_return_text")}({call})" else if !locals.is_empty() -> "{locals.join(" ")} {call}" else -> call
        wrappers += "#[export_name = \"{symbol}\"]\npub extern \"C\" fn {wrapper}({params.join(", ")}) -> {return_type} {{ jet_ffi_callback_boundary(|| {{ {body} }}) }}\n"
        wrappers += "// jet:library-symbol={symbol}\n"
    }
    loop export in rich_exports -> wrappers += render_component_wrapper(program, export)
    rust := ~whole_program_rust
    rust += "\n// D-LIB-EXPORT1=C: generated native Library wrappers.\n"
    if !rich_exports.is_empty() || resource_plan != None -> rust += component_helpers()
    if has_text_export {
        rust += "// JET_VETTED_UNSAFE_BEGIN: library_text_abi\n"
        rust += library_text_helpers()
        rust += "\n// JET_VETTED_UNSAFE_END: library_text_abi\n"
    }
    if resource_plan == .Val(plan) {
        rust += "// JET_VETTED_UNSAFE_BEGIN: library_resource_bridge\n"
        rust += resource_helpers(program, name, resource_exports, plan)
        rust += "\n// JET_VETTED_UNSAFE_END: library_resource_bridge\n"
    }
    rust += wrappers
    projections :: build_projections(name, artifact, resource_plan, resource_error_unsupported)
    header :: render_c_header_with_rich(name, exports, rich_exports, resource_plan, projections)
    bindings := [(String, String)]{}
    emitted := [String: Bool]{}
    loop requested in requested_bindings {
        language :: canonical_binding(requested) ?? continue
        if emitted.contains_key(language) -> continue
        emitted[language] = true
        source :: if language == {
            "c" -> ~header
            "cpp" -> render_cpp(name, exports, rich_exports, resource_plan)
            "rust" -> render_rust(name, exports, rich_exports, resource_plan)
            "python" -> render_python_with_rich(name, exports, rich_exports, resource_plan)
            "zig" -> render_zig(name, exports, rich_exports, resource_plan)
            "go" -> render_go(name, exports, rich_exports, resource_plan)
            "javascript" -> render_javascript(name, exports, rich_exports, resource_plan)
            "swift" -> render_swift(exports)
            _ -> continue
        }
        bindings.push((~language, ^source))
    }
    LibraryArtifacts{rust: ^rust, header: ^header, bindings: ^bindings, exports: ^exports, projections: ^projections}
}
// Rust: crates/jet-codegen/src/Codegen/Library.rs:601
fn rust_component_type(program: MirProgram, ty: MirType) -> String Never! {
    if ty.kind() == {
        .Int -> "i64"
        .Float -> "f64"
        .Bool -> "bool"
        .String -> "String"
        .Char -> "char"
        .List(inner) -> "Vec<{rust_component_type(program, inner)}>"
        .Option(inner) -> "JetOutcome<{rust_component_type(program, inner)}, JetAbsent>"
        .Result(ok, error) -> "JetOutcome<{rust_component_type(program, ok)}, {rust_component_type(program, error)}>"
        .FixedList(elem, len) -> "[{rust_component_type(program, elem)}; {len.expression()}]"
        .InlineRange(base, _, _) | .Tagged(_, base) -> rust_component_type(program, base)
        .IntN(signed, bits) -> "{if signed -> "i" else -> "u"}{bits}"
        .Float32 -> "f32"
        .Apply(name, args) -> {
            if name.name == "View" && args.len() == 1 -> return "&[{rust_component_type(program, args[0])}]"
            if name.name == "ViewMut" && args.len() == 1 -> return "&mut [{rust_component_type(program, args[0])}]"
            head :: mangle_path(name.name)
            if args.is_empty() -> head else -> "{head}<{args.map(arg -> rust_component_type(program, arg)).join(", ")}>"
        }
        _ -> ty.display_name()
    }
}

// Rust: crates/jet-codegen/src/Codegen/Library.rs:654
fn component_helpers() -> String Never! {
    read :: mangle_generated("library_component_read")
    return_value :: mangle_generated("library_component_return")
    error :: mangle_generated("library_component_error")
    error_value :: mangle_generated("library_component_error_value")
    free :: mangle_generated("library_component_free")
    // GATE #4494: generated native pointer/owned allocation ABI.
    "\n" + """
#[repr(C)]
pub struct JetComponent {{
    pub ptr: *const u8,
    pub len: usize,
}}

fn {read}(value: JetComponent) -> Result<String, String> {{
    if value.len == 0 {{
        return Ok(String::new());
    }}
    if value.ptr.is_null()
        || value.len > isize::MAX as usize
        || (value.ptr as usize).checked_add(value.len).is_none()
    {{
        return Err("invalid component pointer-length pair".to_string());
    }}
    let bytes = unsafe {{ std::slice::from_raw_parts(value.ptr, value.len) }};
    String::from_utf8(bytes.to_vec()).map_err(|_| "component input is not UTF-8".to_string())
}}

fn {return_value}(value: jet_std::DataTree) -> JetComponent {{
    let text = jet_std::render_json(&value, false, 0);
    let bytes = text.into_bytes().into_boxed_slice();
    let len = bytes.len();
    let ptr = Box::into_raw(bytes) as *const u8;
    JetComponent {{ ptr, len }}
}}

fn {error_value}<T: __jet_Encode>(value: &T) -> JetComponent {{
    {return_value}(value.jet_encode())
}}

fn {error}(message: &str) -> JetComponent {{
    {return_value}(jet_std::DataTree::Object(vec![
        ("ok".to_string(), jet_std::DataTree::Bool(false)),
        ("error".to_string(), jet_std::DataTree::Text(message.to_string())),
    ]))
}}

#[export_name = "jet_component_free"]
pub extern "C" fn {free}(value: JetComponent) {{
    if value.ptr.is_null() || value.len == 0 {{
        return;
    }}
    unsafe {{
        drop(Box::from_raw(std::ptr::slice_from_raw_parts_mut(
            value.ptr as *mut u8,
            value.len,
        )));
    }}
}}
""" + "\n"
}
// Rust: crates/jet-codegen/src/Codegen/Library.rs:724
fn render_component_wrapper(program: MirProgram, export: RichExport) -> String Never! {
    read :: mangle_generated("library_component_read")
    return_value :: mangle_generated("library_component_return")
    error :: mangle_generated("library_component_error")
    types :: export.component.params.map(ty -> rust_component_type(program, ty))
    locals := [String]{}
    args := [String]{}
    loop (index, (ty, convention)) in export.component.params.zip(export.params).enumerate() {
        rust_ty :: types[index]
        mutable :: if convention == .Write -> "mut " else -> ""
        locals.push("let {mutable}p{index}: {rust_ty} = <{rust_ty} as __jet_Decode>::jet_decode(__jet_values.get({index}).ok_or_else(|| \"missing component parameter\".to_string())?).map_err(|_| \"component parameter decode failed\".to_string())?;")
        args.push(if convention == {
            .Read -> if ty.kind() == .Int || ty.kind() == .Float || ty.kind() == .Bool -> "p{index}" else -> "&p{index}"
            .Write -> "&mut p{index}"
            .Move -> "p{index}"
        })
    }
    parse_values :: if export.component.params.is_empty() -> "let __jet_values = Vec::new();" else -> "let __jet_values = match __jet_tree {{ jet_std::DataTree::Array(values) => values, _ => return Err(\"component input must be a JSON array\".to_string()) }};"
    is_result :: if export.failure == { .Result(_, _) -> true, _ -> false }
    call :: if is_result -> "match {export.callee}({args.join(", ")}) {{ Ok(value) => value, Err(error) => return Ok({return_value}(jet_std::DataTree::Object(vec![(\"ok\".to_string(), jet_std::DataTree::Bool(false)), (\"error\".to_string(), error.jet_encode())]))), }}" else -> "{export.callee}({args.join(", ")})"
    symbol :: "{export.symbol}_component"
    wrapper :: mangle("library_component_{export.name}")
    "\n" + """
#[export_name = "{symbol}"]
pub extern "C" fn {wrapper}(input: JetComponent) -> JetComponent {{
    let run = || -> Result<JetComponent, String> {{
        let text = {read}(input)?;
        let __jet_tree = jet_std::parse_json_typed_datatree(&text)
            .map_err(|_| "component input is not valid JSON".to_string())?;
        {parse_values}
        {locals.join("\n        ")}
        let __jet_value = {call};
        let __jet_tree = __jet_value.jet_encode();
        Ok({return_value}(jet_std::DataTree::Object(vec![
            ("ok".to_string(), jet_std::DataTree::Bool(true)),
            ("value".to_string(), __jet_tree),
        ])))
    }};
    match std::panic::catch_unwind(std::panic::AssertUnwindSafe(run)) {{
        Ok(Ok(value)) => value,
        Ok(Err(message)) => {error}(&message),
        Err(_) => {error}("Jet export panicked at the guest boundary"),
    }}
}}
""" + "\n"
}
// Rust: crates/jet-codegen/src/Codegen/Library.rs:817
PROJECTION_LANGUAGES :: ["c", "cpp", "rust", "zig", "go", "python", "javascript"]
// Rust: crates/jet-codegen/src/Codegen/Library.rs:820
fn canonical_binding(language: String) -> String? Never! {
    trimmed := language.trim() // #4303
    if trimmed.to_ascii_lowercase() == {
        "c" -> Val("c")
        "cpp" | "c++" -> Val("cpp")
        "rust" | "rs" -> Val("rust")
        "zig" -> Val("zig")
        "go" -> Val("go")
        "python" | "py" -> Val("python")
        "javascript" | "js" | "node" | "nodejs" -> Val("javascript")
        "swift" -> Val("swift")
        _ -> None
    }
}
// Rust: crates/jet-codegen/src/Codegen/Library.rs:834
fn c_identifier(name: String) -> String Never! {
    value := name.chars().map(ch -> if ch.is_ascii_alphanumeric() || ch == '_' -> ch.to_ascii_lowercase() else -> '_').collect_string()
    if value.is_empty() || value.bytes().first().is_some_and(ch -> ch.is_ascii_digit()) -> value.insert(0, '_')
    ^value
}
// Rust: crates/jet-codegen/src/Codegen/Library.rs:850
fn go_export_name(name: String) -> String Never! {
    out := ""
    loop part in c_identifier(name).split("_") {
        if part.is_empty() -> continue
        chars := part.chars()
        first :: chars.next() ?? continue
        out += "{first.to_ascii_uppercase()}{chars.as_str()}"
    }
    ^out
}
// Rust: crates/jet-codegen/src/Codegen/Library.rs:864
fn projection_contract_language(language: String) -> ForeignLanguage Never! {
    if language == {
        "cpp" -> .Cpp
        "rust" -> .Rust
        "python" -> .Py
        "javascript" -> .JS
        "go" -> .Go
        // Zig crosses the stable C shim, not an invented native Zig ABI.
        "zig" | "c" -> .C
        _ -> .C
    }
}
// Rust: crates/jet-codegen/src/Codegen/Library.rs:878
fn build_projections(name: String, artifact: MirArtifactPlan, resource_plan: ResourcePlan?, resource_error_unsupported: Bool) -> [LibraryProjection] Never! {
    out := [LibraryProjection]{}
    loop language in PROJECTION_LANGUAGES {
        contract_language :: projection_contract_language(language)
        descriptor :: binder_descriptor(contract_language) ?? continue
