fn render_c_header(name: String, exports: [LibraryExport]) -> String Never! {
    render_c_header_with_rich(name, exports, [RichExport]{}, None, [LibraryProjection]{})
}
// Rust: crates/jet-codegen/src/Codegen/Library.rs:1472
fn append_c_matrix_field(out: &String, key: String, value: String) -> Unit Never! {
    loop line in value.split(ch -> ch == '\r' || ch == '\n') {
        safe := String.with_capacity(line.len())
        chars := line.chars().peekable()
        loop {
            ch :: chars.next() ?? break
            if ch == '*' && chars.peek() == Val('/') {
                safe += "* /"
                _ :: chars.next()
            } else if ch.is_control() {
                // Includes NUL, without introducing a Jet NUL escape.
                safe.push('?')
            } else -> safe.push(ch)
        }
        out += "/* jet-ffi-projection: {key}={safe} */\n"
    }
}
// Rust: crates/jet-codegen/src/Codegen/Library.rs:1494
fn append_projection_matrix_comments(out: &String, projections: [LibraryProjection]) -> Unit Never! {
    if projections.is_empty() -> return
    out += "\n/* jet-ffi-projection-matrix: schema=v1; proof=declared;unexecuted */\n"
    loop projection in projections {
        append_c_matrix_field(&out, "language", projection.language)
        append_c_matrix_field(&out, "direction", projection.direction)
        append_c_matrix_field(&out, "artifact-identity", projection.artifact_identity)
        append_c_matrix_field(&out, "supported-ownership", projection.ownership)
        append_c_matrix_field(&out, "supported-integer-ranges", projection.integer_ranges)
        append_c_matrix_field(&out, "supported-encoding", projection.encoding)
        append_c_matrix_field(&out, "supported-enums", projection.enums)
        append_c_matrix_field(&out, "supported-errors", projection.errors)
        append_c_matrix_field(&out, "runtime-roots", projection.runtime_roots)
        append_c_matrix_field(&out, "resource-lifetime", projection.resource_lifetime)
        append_c_matrix_field(&out, "target-runtime-restrictions", "target={projection.contract.identity.target}; availability={projection.contract.target_availability}; task-thread={projection.contract.task_thread}")
        append_c_matrix_field(&out, "proof-status", "declared;unexecuted;runtime/golden/cost/human/qualification acceptance remains #2919")
        loop unsupported in projection.unsupported -> append_c_matrix_field(&out, "unsupported", unsupported)
        loop (key, value) in projection.contract.provenance_fields() -> append_c_matrix_field(&out, "contract-{key}", value)
    }
}
// Rust: crates/jet-codegen/src/Codegen/Library.rs:1534
fn render_c_header_with_rich(name: String, exports: [LibraryExport], rich_exports: [RichExport], resource_plan: ResourcePlan?, projections: [LibraryProjection]) -> String Never! {
    guard :: header_guard(name)
    out := "/* Generated by Jet — D-LIB-EXPORT1=C / D-EMBED1=E / D-EMBED2=C. */\n#ifndef {guard}\n#define {guard}\n#include <stdbool.h>\n#include <stddef.h>\n#include <stdint.h>\n"
    append_projection_matrix_comments(&out, projections)
    if exports.any(export -> export.scalar == .Text) -> out += "\ntypedef struct JetText {{ const uint8_t *ptr; size_t len; }} JetText;\n"
    if !rich_exports.is_empty() || resource_plan != None -> out += "\ntypedef struct JetComponent {{ const uint8_t *ptr; size_t len; }} JetComponent;\n"
    if resource_plan != None -> out += resource_protocol_header(name)
    out += "\n#ifdef __cplusplus\nextern \"C\" {{\n#endif\n"
    if exports.any(export -> export.scalar == .Text) -> out += "void jet_text_free(JetText value);\n"
    if !rich_exports.is_empty() || resource_plan != None -> out += "void jet_component_free(JetComponent value);\n"
    if resource_plan != None -> out += resource_protocol_declarations(name)
    loop export in exports {
        access :: export.conventions.map(convention -> if convention == { .Read -> "read", .Write -> "write", .Move -> "move" }).join(",")
