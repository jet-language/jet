fn is_integer_list(ty: MirType) -> Bool Never! {
    if ty.kind() == { .List(inner) -> is_integer(inner), _ -> false }
}
// Rust: crates/jet-codegen/src/Codegen/Library.rs:212
fn is_integer(ty: MirType) -> Bool Never! { ty.kind() == .Int }
// Rust: crates/jet-codegen/src/Codegen/Library.rs:216
fn is_nominal(ty: MirType) -> Bool Never! {
    if ty.kind() == { .Apply(_, _) -> true, _ -> false }
}
// Rust: crates/jet-codegen/src/Codegen/Library.rs:221
fn is_integer_view(ty: MirType) -> Bool Never! {
    if ty.kind() == { .Apply(name, args) -> name.name == "View" && args.len() == 1 && is_integer(args[0]), _ -> false }
}
// Rust: crates/jet-codegen/src/Codegen/Library.rs:229
fn has_checked_read_view_result(export: ResourceExport) -> Bool Never! {
    view :: result_ok_type(export) ?? return false
    if !is_integer_view(view) -> return false
    provenance :: export.ownership.return_views ?? return false
    !provenance.is_empty() && provenance.values().all(view -> !view.mutable && view.sources.any(source -> source.source == MirViewSource.Parameter(0)))
}
// Rust: crates/jet-codegen/src/Codegen/Library.rs:250
fn has_ownership_mode(export: ResourceExport, index: Int, mode: MirOwnershipMode) -> Bool Never! {
    export.ownership.parameters.get(index).is_some_and(ownership -> ownership.mode == mode)
}
// Rust: crates/jet-codegen/src/Codegen/Library.rs:258
fn unique_resource_operation(exports: [ResourceExport], predicate: fn(ResourceExport) -> Bool) -> Int? Never! {
    found := Int?{None}
    loop (index, export) in exports.enumerate() {
        if predicate(export) {
            if found != None -> return None
            found = Val(index)
        }
    }
    found
}
// Rust: crates/jet-codegen/src/Codegen/Library.rs:280
fn classify_resource_exports(exports: [ResourceExport]) -> ResourcePlan? Never! {
    open :: unique_resource_operation(exports, export -> export.component.params.len() == 1 && is_integer_list(export.component.params[0]) && result_ok_type(export).is_some_and(is_nominal) && export.ownership.parameters.len() == 1 && has_ownership_mode(export, 0, .ReadBorrow) && has_result_failure(export)) ?? return None
    owner_type :: result_ok_type(exports[open]) ?? return None
    bytes :: unique_resource_operation(exports, export -> export.component.params.len() == 1 && has_checked_read_view_result(export) && export.component.params[0].same_checked_type(owner_type) && has_result_failure(export) && has_ownership_mode(export, 0, .ReadBorrow)) ?? return None
    view_type :: result_ok_type(exports[bytes]) ?? return None
    if view_type.same_checked_type(owner_type) -> return None
    at :: unique_resource_operation(exports, export -> result_ok_type(export).is_some_and(is_integer) && has_result_failure(export) && export.component.params.len() == 3 && export.component.params[0].same_checked_type(owner_type) && export.component.params[1].same_checked_type(view_type) && is_integer(export.component.params[2]) && has_ownership_mode(export, 0, .ReadBorrow) && has_ownership_mode(export, 1, .ReadBorrow)) ?? return None
    replace :: unique_resource_operation(exports, export -> {
        result :: result_ok_type(export) ?? return false
        export.component.params.len() == 2 && has_result_failure(export) && export.component.params[0].same_checked_type(owner_type) && is_integer_list(export.component.params[1]) && result.same_checked_type(owner_type) && has_ownership_mode(export, 0, .Move) && has_ownership_mode(export, 1, .ReadBorrow)
    }) ?? return None
    close :: unique_resource_operation(exports, export -> result_ok_type(export).is_some_and(ty -> ty.is_unit()) && has_result_failure(export) && export.component.params.len() == 1 && export.component.params[0].same_checked_type(owner_type) && has_ownership_mode(export, 0, .Move)) ?? return None
    Val(ResourcePlan{open: open, bytes: bytes, at: at, replace: replace, close: close})
}
