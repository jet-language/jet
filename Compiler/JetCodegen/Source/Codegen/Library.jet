// Rust: crates/jet-codegen/src/Codegen/Library.rs:89
fn nominal_has_encode_impl(program: MirProgram, ty: MirType) -> Bool Never! {
    id :: ty.nominal_id() ?? return false
    if program.impls.any(implementation -> implementation.serde == Val(MirSerdeCodec.Encode) && implementation.self_type.nominal_id() == Val(id)) -> return true
    definition :: program.types.find(definition -> definition.id == id) ?? return false
    definition.derives.any(trait_id -> {
        trait_definition :: program.traits.find(definition -> definition.id == trait_id) ?? return false
        name :: trait_definition.name.rsplit("::").next() ?? return false
        name == "Encode" || name == "Codable"
    })
}
// Rust: crates/jet-codegen/src/Codegen/Library.rs:120
fn resource_error_is_projectable(program: MirProgram, ty: MirType, seen: &[MirTypeId: Bool]) -> Bool Never! {
    // GATE #4499: nominal IDs retain their canonical key equality/hash.
    if ty.kind() == {
        .Int | .Float | .Bool | .String | .Char | .Float32 -> true
        .IntN(_, bits) -> bits <= 32
        .List(inner) | .FixedList(inner, _) | .Option(inner) | .InlineRange(inner, _, _) | .Tagged(_, inner) -> resource_error_is_projectable(program, inner, &seen)
        .Map(key, value) -> key.kind() == .String && resource_error_is_projectable(program, value, &seen)
        .Apply(_, _) -> {
            if !nominal_has_encode_impl(program, ty) -> return false
            id :: ty.nominal_id() ?? return false
            if seen.contains_key(id) -> return false
            seen[id] = true
            supported :: program.types.find(definition -> definition.id == id).is_some_and(definition -> {
                if definition.kind == {
                    .Struct(fields, _) -> fields.all(field -> field.skip || field.computed || resource_error_is_projectable(program, field.ty, &seen))
                    .Enum(variants, _) -> variants.all(variant -> {
                        if variant.payload == {
                            .Unit -> true
                            .Single(inner) -> resource_error_is_projectable(program, inner, &seen)
                            .Named(fields) -> fields.all(field -> field.skip || field.computed || resource_error_is_projectable(program, field.ty, &seen))
                        }
                    })
                    .Distinct(base, _) | .Alias(base) -> resource_error_is_projectable(program, base, &seen)
                    .UnitFamily(_) -> false
                }
            })
            _ :: seen.remove(id)
            supported
        }
        .Result(_, _) | .Shared(_) | .Fn(_) | .SendFn(_, _, _) | .TraitObject(_) | .Tuple(_) | .Union(_) | .Quantity(_, _) | .Measure(_) -> false
    }
}
// Rust: crates/jet-codegen/src/Codegen/Library.rs:194
fn resource_errors_supported(program: MirProgram, exports: [ResourceExport], plan: ResourcePlan) -> Bool Never! {
    loop index in [plan.open, plan.bytes, plan.at, plan.replace, plan.close] {
        error :: result_error_type(exports[index]) ?? return false
        seen := [MirTypeId: Bool]{}
        if !resource_error_is_projectable(program, error, &seen) -> return false
    }
    true
}
