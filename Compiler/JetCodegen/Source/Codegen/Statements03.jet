// Private continuation of canonical Codegen.TIR.tir_to_mir_stmt.
use jet_foundation.MIR.*
use jet_foundation.AST.[Type, BinOp, AutoVectorizationFacts, TypeTupleField]
use jet_foundation.Syntax as Syntax
use jet_codegen.Codegen.TIR.*
use jet_codegen.Codegen.TIR.mir.[LowerCtx, LowerError, TransactionRestore]
use jet_codegen.Codegen.TIR.tir_to_mir_expr.lower_expr
use jet_codegen.Codegen.TIR.tir_to_mir_stmt.[lower_stmts, lower_stmt]
use jet_codegen.Codegen.TIR.[loop_route_bundle, mir_binary_op]
use jet_codegen.Codegen.TIR.Lower.encoding_reader_item_type
use jet_codegen.Codegen.Tuples.tuple_struct_name
use jet_codegen.Collections as Collections
use std.collections.Set

// Rust: crates/jet-codegen/src/Codegen/TIR/tir_to_mir_stmt.rs:1752
fn lower_range_loop(ctx: &LowerCtx, label: String?, var: String, source: TExpr?, start: TExpr, end: TExpr, step: TExpr?, exclusive: Bool, auto_vectorization: AutoVectorizationFacts?, body: [TStmt]) -> Unit LowerError! {
    loop_span :: ctx.span()
    routes :: loop_route_bundle()
    range_init_call :: ctx.intern_prelude_route(routes.range_init)?
    range_has_next_call :: ctx.intern_prelude_route(routes.range_has_next)?
    range_value_call :: ctx.intern_prelude_route(routes.range_value)?
    range_advance_call :: ctx.intern_prelude_route(routes.range_advance)?
    iter_init_call :: ctx.intern_prelude_route(routes.iter_init)?
    iter_has_next_call :: ctx.intern_prelude_route(routes.iter_has_next)?
    iter_value_call :: ctx.intern_prelude_route(routes.iter_value)?
    iter_advance_call :: ctx.intern_prelude_route(routes.iter_advance)?
    (cursor, item_ty, iterator) :: if source == {
        Val(source) -> {
            collection :: lower_expr(&ctx, source)?
            step_value := None
            if step == Val(step) { step_value = Val(lower_expr(&ctx, step)?) }
            cursor :: ctx.emit("range.iter-init", Val(Type.Named("IterCursor")), MirOperation.LoopIterInit{
                call: iter_init_call, collection: collection, step: step_value, by_value: false, source_kind: MirLoopSourceKind.Plain
            })?
            (cursor, start.ty, true)
        }
        None -> {
            start_value :: lower_expr(&ctx, start)?
            end_value :: lower_expr(&ctx, end)?
            step_value := None
            if step == Val(step) { step_value = Val(lower_expr(&ctx, step)?) }
            cursor :: ctx.emit("range.init", Val(Type.Named("RangeCursor")), MirOperation.LoopRangeInit{
                call: range_init_call, start: start_value, end: end_value, step: step_value, exclusive: exclusive
            })?
            (cursor, start.ty, false)
        }
    }
    header :: ctx.new_block(ctx.span(), "range.header")?
    body_block :: ctx.new_block(ctx.span(), "range.body")?
    advance :: ctx.new_block(ctx.span(), "range.advance")?
    exit :: ctx.new_block(ctx.span(), "range.exit")?
    ctx.terminate(MirTerminator.Jump{target: header})
    ctx.switch_to(header)
    has_next :: if iterator -> ctx.emit("range.iter-has-next", Val(Type.Bool), MirOperation.LoopIterHasNext{call: iter_has_next_call, cursor: cursor})?
        else -> ctx.emit("range.has-next", Val(Type.Bool), MirOperation.LoopRangeHasNext{call: range_has_next_call, cursor: cursor})?
    ctx.terminate(MirTerminator.Branch{condition: has_next, then_target: body_block, else_target: exit})
    ctx.switch_to(body_block)
    item :: if iterator -> ctx.emit("range.iter-value", Val(item_ty), MirOperation.LoopIterValue{call: iter_value_call, cursor: cursor})?
        else -> ctx.emit("range.value", Val(item_ty), MirOperation.LoopRangeValue{call: range_value_call, cursor: cursor})?
    bind_value(&ctx, var, item, item_ty, false)?
    ctx.push_loop(label, exit, advance)
    ctx.push_lexical_frame()
    lower_stmts(&ctx, body)?
    ctx.pop_lexical_frame()?
    ctx.pop_loop()
    if !ctx.is_terminated() { ctx.terminate(MirTerminator.Jump{target: advance}) }
    ctx.switch_to(advance)
    if iterator {
        _ :: ctx.emit("range.iter-advance", None, MirOperation.LoopIterAdvance{call: iter_advance_call, cursor: cursor})?
    } else {
        _ :: ctx.emit("range.advance", None, MirOperation.LoopRangeAdvance{call: range_advance_call, cursor: cursor})?
    }
    ctx.terminate(MirTerminator.Jump{target: header})
    ctx.switch_to(exit)
    if iterator { _ :: ctx.emit("range.iter-drop", None, MirOperation.Drop{value: cursor, kind: MirDropKind.Value})? }
    if auto_vectorization == Val(facts) {
        body_blocks :: ctx.loop_body_blocks(header, body_block, Val(exit), Val(advance))
        ctx.record_checked_vector_fact(header, Val(cursor), body_blocks, Val(advance), None, facts, loop_span)?
    }
}

// Rust: crates/jet-codegen/src/Codegen/TIR/tir_to_mir_stmt.rs:1926
// Stable/read list slots are read-only aliases. Columnar slots cannot be named
// as places and keep gathered-record iteration instead.
fn read_list_walk(ctx: &LowerCtx, label: String?, var: String, var2: String?, collection: TExpr, step: TExpr?, method_kind: TForInMethod?, by_value: Bool, columnar: Bool, source_stable: Bool, body: [TStmt]) -> TStmt? LowerError! {
    if method_kind.is_some() || step.is_some() || by_value || columnar { return None }
    element :: if collection.ty.without_user_tags() == { .List(element) -> element; else -> { return None } }
    if ctx.read_window_place(collection)?.is_none() && !(source_stable && ctx.stable_source_place(collection)?.is_some()) { return None }
    list :: if collection.kind == { .Clone(inner, _) -> inner; else -> collection }
    (index_name, item_name) :: if var2 == { Val(item_name) -> (var, item_name); None -> ("__jet_read_walk_{ctx.span().start}", var) }
    index :: TExpr{ty: Type.Int, kind: TExprKind.Local(TLocal.user(index_name))}
    item :: TExpr{ty: element, kind: TExprKind.Borrow{
        place: TExpr{ty: element, kind: TExprKind.Index{base: list, index: index, is_map: false, uninit_fixed: false, line: ctx.source_line() as USize}}, mutable: false
    }}
    walk_body := [TStmt].with_capacity(body.len() + 1)
    walk_body.push(TStmt.Let{name: item_name, kw: "let", let_ty: TLetTy.Inferred, init: item, gc_promotion: None, gc_transferred: false})
    walk_body.extend(body)
    return Val(TStmt.Range{label: label, var: index_name, source: None,
        start: TExpr{ty: Type.Int, kind: TExprKind.IntLit(0, None)},
        end: TExpr{ty: Type.Int, kind: TExprKind.BuiltinMethod{recv: list, op: TBuiltinOp.LenList, args: []}},
        step: None, exclusive: true, auto_vectorization: None, body: walk_body})
}

// Rust: crates/jet-codegen/src/Codegen/TIR/tir_to_mir_stmt.rs:2012
fn lower_for_in(ctx: &LowerCtx, label: String?, var: String, var2: String?, source: TExpr, collection: TExpr, step: TExpr?, method_kind: TForInMethod?, by_value: Bool, columnar: Bool, source_stable: Bool, body: [TStmt]) -> Unit LowerError! {
    if read_list_walk(&ctx, label, var, var2, collection, step, method_kind, by_value, columnar, source_stable, body)? == Val(walk) {
        return lower_stmt(&ctx, walk)
    }
    routes :: loop_route_bundle()
    iter_init_call :: ctx.intern_prelude_route(routes.iter_init)?
    iter_has_next_call :: ctx.intern_prelude_route(routes.iter_has_next)?
    iter_value_call :: ctx.intern_prelude_route(routes.iter_value)?
    iter_advance_call :: ctx.intern_prelude_route(routes.iter_advance)?
    source_kind :: loop_source_kind(method_kind)
    // A sequence's two-name form is (index,item), not an element projection.
    (loop_collection, indexed_pair_types) :: if (method_kind, collection.ty, var2) == {
        (None, .List(elem) | .FixedList(elem: elem, ..), Val(_)) -> {
            fields :: [("idx", Type.Int), ("item", elem)]
            row_ty :: Type.Tuple(fields)
            indexed :: TExpr{ty: Collections.iter_ty(row_ty), kind: TExprKind.BuiltinMethod{
                recv: collection, op: TBuiltinOp.Indexed{tuple_struct: tuple_struct_name(fields)}, args: []
            }}
            (indexed, Val((row_ty, elem)))
        }
        else -> (collection, None)
    }
    owns_source :: if source_kind == {
        .LinesFile | .LinesStdin | .LinesProcessStream | .ChannelReceiver | .EncodingReader(..) | .Iterable(..) -> true
        .Plain -> Collections.iter_elem(loop_collection.ty).is_some()
        .Chars -> false
    }
    effective_by_value :: owns_source || by_value
    source :: if method_kind.is_some() -> source else -> loop_collection
    source_value :: if (source.kind, owns_source) == {
        // The channel adapter shares a read receiver before consuming it.
        (.Local(_), true) if source_kind == MirLoopSourceKind.ChannelReceiver -> lower_expr(&ctx, source)?
        (.Local(local), true) if !ctx.local_is_read_alias(local) -> {
            place :: ctx.place_for_local(local, MirAccess.Move)?
            ctx.emit("for-in.source-move", Val(source.ty), MirOperation.MovePlace{place: place})?
        }
        else -> lower_expr(&ctx, source)?
    }
    step_value := None
    if step == Val(step) { step_value = Val(lower_expr(&ctx, step)?) }
    byte_slice_cursor :: source_kind == MirLoopSourceKind.Plain && !effective_by_value &&
        (if loop_collection.ty.without_user_tags() == {
            .List(elem) | .FixedList(elem: elem, ..) -> elem.without_user_tags() == Type.IntN(false, 8)
            else -> false
        })
    cursor_ty :: Type.Named(if byte_slice_cursor -> "ByteIterCursor" else -> "IterCursor")
    cursor :: ctx.emit("for-in.iter-init", Val(cursor_ty), MirOperation.LoopIterInit{
        call: iter_init_call, collection: source_value, step: step_value, by_value: effective_by_value, source_kind: source_kind
    })?
    item_ty :: indexed_pair_types.map(fn(pair) { pair.0 }) ?? for_item_type(collection, method_kind)
    header :: ctx.new_block(ctx.span(), "for-in.header")?
    body_block :: ctx.new_block(ctx.span(), "for-in.body")?
    advance :: ctx.new_block(ctx.span(), "for-in.advance")?
    exit :: ctx.new_block(ctx.span(), "for-in.exit")?
    ctx.terminate(MirTerminator.Jump{target: header})
    ctx.switch_to(header)
    has_next :: ctx.emit("for-in.has-next", Val(Type.Bool), MirOperation.LoopIterHasNext{call: iter_has_next_call, cursor: cursor})?
    ctx.terminate(MirTerminator.Branch{condition: has_next, then_target: body_block, else_target: exit})
    ctx.switch_to(body_block)
    item :: ctx.emit("for-in.value", Val(item_ty), MirOperation.LoopIterValue{call: iter_value_call, cursor: cursor})?
    if var2 == {
        Val(var2) -> {
            (key_ty, value_ty, key_name, value_name) :: if (collection.ty, indexed_pair_types) == {
                (.Map(key: key, value: value, ..), _) -> (key, value, "key", "value")
                (_, Val((_, elem_ty))) -> (Type.Int, elem_ty, "idx", "item")
                else -> (Type.Int, item_ty, "key", "value")
            }
            key_field :: ctx.field_id_for_type(item_ty, key_name)?
            value_field :: ctx.field_id_for_type(item_ty, value_name)?
            key :: ctx.emit("for-in.key", Val(key_ty), MirOperation.Field{base: item, field: key_field})?
            val :: ctx.emit("for-in.value-field", Val(value_ty), MirOperation.Field{base: item, field: value_field})?
            bind_value(&ctx, var, key, key_ty, false)?
            bind_value(&ctx, var2, val, value_ty, false)?
        }
        None -> bind_value(&ctx, var, item, item_ty, false)?
    }
    ctx.push_loop(label, exit, advance)
    ctx.push_lexical_frame()
    lower_stmts(&ctx, body)?
    ctx.pop_lexical_frame()?
    ctx.pop_loop()
    if !ctx.is_terminated() { ctx.terminate(MirTerminator.Jump{target: advance}) }
    ctx.switch_to(advance)
    _ :: ctx.emit("for-in.advance", None, MirOperation.LoopIterAdvance{call: iter_advance_call, cursor: cursor})?
    ctx.terminate(MirTerminator.Jump{target: header})
    ctx.switch_to(exit)
    _ :: ctx.emit("for-in.iter-drop", None, MirOperation.Drop{value: cursor, kind: MirDropKind.Value})?
}

// Rust: crates/jet-codegen/src/Codegen/TIR/tir_to_mir_stmt.rs:2239
fn loop_source_kind(method_kind: TForInMethod?) -> MirLoopSourceKind Never! {
    return if method_kind == {
        None -> MirLoopSourceKind.Plain
        Val(.Chars) -> MirLoopSourceKind.Chars
        Val(.LinesFile) -> MirLoopSourceKind.LinesFile
        Val(.LinesStdin) -> MirLoopSourceKind.LinesStdin
        Val(.LinesProcessStream) -> MirLoopSourceKind.LinesProcessStream
        Val(.ChannelReceiver) -> MirLoopSourceKind.ChannelReceiver
        Val(.EncodingReader(reader_type: reader_type)) -> MirLoopSourceKind.EncodingReader{reader_type: reader_type}
        Val(.Iterable(coll_type: coll_type, iter_type: iter_type, iter_symbol: iter_symbol, next_symbol: next_symbol, ..)) ->
            MirLoopSourceKind.Iterable{coll_type: coll_type, iter_type: iter_type, iter_symbol: iter_symbol, next_symbol: next_symbol}
    }
}

// Rust: crates/jet-codegen/src/Codegen/TIR/tir_to_mir_stmt.rs:2265
fn for_item_type(collection: TExpr, method_kind: TForInMethod?) -> Type Never! {
    if method_kind == Val(TForInMethod.ChannelReceiver) {
        if collection.ty == { .Apply(name, args) -> { if name == Syntax.TYPE_RECEIVER && args.len() == 1 { return args[0] } }; else -> {} }
    }
    if Collections.iter_elem(collection.ty) == Val(elem) { return elem }
    if method_kind == Val(method) {
        return if method == {
            .Chars -> Type.Char
            .LinesFile | .LinesStdin | .LinesProcessStream -> Type.String
            .Iterable(item_type: item_type, ..) -> item_type
            .ChannelReceiver -> if collection.ty == { .Apply(name, args) if name == Syntax.TYPE_RECEIVER && args.len() == 1 -> args[0]; else -> collection.ty }
            .EncodingReader(reader_type: reader_type) -> encoding_reader_item_type(reader_type).expect("checked encoding-reader loop names a reader with no item type")
        }
    }
    return if collection.ty == {
        .List(elem) | .FixedList(elem: elem, ..) -> elem
        .Map(key: key, value: value, ..) -> Type.Tuple([("key", key), ("value", value)])
        .Apply(name, args) if args.len() == 1 && (name == "View" || name == "ViewMut" || name == "ComputeViewMut" || name == Syntax.TYPE_STREAM) -> args[0]
        else -> collection.ty
    }
}

// Rust: crates/jet-codegen/src/Codegen/TIR/tir_to_mir_stmt.rs:2324
fn bind_value(ctx: &LowerCtx, name: String, value: MirValueId, ty: Type, mutable: Bool) -> Unit LowerError! {
    local :: if mutable -> TLocal.user(name).as_mutable() else -> TLocal.user(name)
    place :: ctx.bind_local(local, ty, mutable, false, false)?
    _ :: ctx.emit("stmt.bind.write", None, MirOperation.WritePlace{place: place, value: value})?
}

// Rust: crates/jet-codegen/src/Codegen/TIR/tir_to_mir_stmt.rs:2345
fn lower_enum_match(ctx: &LowerCtx, scrutinee: TExpr, clone_subject: Bool, arms: [TMatchArm], else_body: [TStmt]?, fallthrough: Bool) -> Unit LowerError! {
    subject := ctx.lower_pattern_subject(scrutinee)?
    if clone_subject && ctx.read_window_of(subject).is_none() {
        subject = ctx.emit("match.subject.copy", Val(scrutinee.ty), MirOperation.Copy{value: subject, fact: MirCopyFact.Materialize})?
    }
    join :: ctx.new_block(ctx.span(), "match.join")?
    otherwise :: ctx.new_block(ctx.span(), "match.otherwise")?
    tests := [MirBlockId].with_capacity(arms.len())
    bodies := [MirBlockId].with_capacity(arms.len())
    for index in 0..<arms.len() {
        tests.push(ctx.new_block(ctx.span(), "match.test.{index}")?)
        bodies.push(ctx.new_block(ctx.span(), "match.body.{index}")?)
    }
    ctx.terminate(MirTerminator.Jump{target: tests.first() ?? otherwise})
    for (index, arm) in arms.iter().enumerate() {
        ctx.switch_to(tests[index])
        // Arm bindings belong to this frame, not the enclosing match frame.
        ctx.push_lexical_frame()
        pattern :: ctx.lower_pattern(arm.pattern)?
        condition :: ctx.lower_pattern_condition(subject, pattern)?
        next :: tests.get(index + 1) ?? otherwise
        unmatched :: if ctx.lexical_frame_has_cleanups() -> ctx.new_block(ctx.span(), "match.unmatched.{index}")? else -> next
        ctx.terminate(MirTerminator.Branch{condition: condition, then_target: bodies[index], else_target: unmatched})
        if unmatched != next {
            ctx.switch_to(unmatched)
            ctx.jump_leaving_lexical_frame(next)?
        }
        ctx.switch_to(bodies[index])
        ctx.push_lexical_frame()
        lower_stmts(&ctx, arm.body)?
        ctx.pop_lexical_frame()?
        ctx.pop_lexical_frame()?
        if !ctx.is_terminated() { ctx.terminate(MirTerminator.Jump{target: join}) }
    }
    ctx.switch_to(otherwise)
    ctx.push_lexical_frame()
    if else_body == {
        Val(body) -> lower_stmts(&ctx, body)?
        None -> {
            if !ctx.is_terminated() { ctx.terminate(MirTerminator.Unreachable{
                reason: if fallthrough -> "checked exhaustive match fallthrough" else -> "checked exhaustive match otherwise"
            }) }
        }
    }
    ctx.pop_lexical_frame()?
    if !ctx.is_terminated() { ctx.terminate(MirTerminator.Jump{target: join}) }
    ctx.switch_to(join)
}

// Rust: crates/jet-codegen/src/Codegen/TIR/tir_to_mir_stmt.rs:2433
fn lower_range_switch(ctx: &LowerCtx, subject: TExpr, arms: [(I64, I64, [TStmt])], else_body: [TStmt]) -> Unit LowerError! {
    subject_value :: lower_expr(&ctx, subject)?
    join :: ctx.new_block(ctx.span(), "range-switch.join")?
    otherwise :: ctx.new_block(ctx.span(), "range-switch.otherwise")?
    tests := [MirBlockId].with_capacity(arms.len())
    bodies := [MirBlockId].with_capacity(arms.len())
    for index in 0..<arms.len() {
        tests.push(ctx.new_block(ctx.span(), "range-switch.test.{index}")?)
        bodies.push(ctx.new_block(ctx.span(), "range-switch.body.{index}")?)
    }
    ctx.terminate(MirTerminator.Jump{target: tests.first() ?? otherwise})
    for (index, (lo, hi, _)) in arms.iter().enumerate() {
        ctx.switch_to(tests[index])
        lo :: const_int(&ctx, lo)?
        hi :: const_int(&ctx, hi)?
        lower :: ctx.emit("range-switch.{index}.lower", Val(Type.Bool), MirOperation.Binary{op: mir_binary_op(BinOp.Ge), dispatch: MirBinaryDispatch.Primitive, left: subject_value, right: lo})?
        upper :: ctx.emit("range-switch.{index}.upper", Val(Type.Bool), MirOperation.Binary{op: mir_binary_op(BinOp.Le), dispatch: MirBinaryDispatch.Primitive, left: subject_value, right: hi})?
        condition :: ctx.emit("range-switch.{index}.condition", Val(Type.Bool), MirOperation.Binary{op: mir_binary_op(BinOp.And), dispatch: MirBinaryDispatch.Primitive, left: lower, right: upper})?
        next :: tests.get(index + 1) ?? otherwise
        ctx.terminate(MirTerminator.Branch{condition: condition, then_target: bodies[index], else_target: next})
        ctx.switch_to(bodies[index])
        ctx.push_lexical_frame()
        lower_stmts(&ctx, arms[index].2)?
        ctx.pop_lexical_frame()?
        if !ctx.is_terminated() { ctx.terminate(MirTerminator.Jump{target: join}) }
    }
    ctx.switch_to(otherwise)
    ctx.push_lexical_frame()
    lower_stmts(&ctx, else_body)?
    ctx.pop_lexical_frame()?
    if !ctx.is_terminated() { ctx.terminate(MirTerminator.Jump{target: join}) }
    ctx.switch_to(join)
}

// Rust: crates/jet-codegen/src/Codegen/TIR/tir_to_mir_stmt.rs:2512
fn lower_mixed_switch(ctx: &LowerCtx, subject: TExpr, arms: [(TExpr, [TStmt])], else_body: [TStmt]?) -> Unit LowerError! {
    subject_value :: lower_expr(&ctx, subject)?
    join :: ctx.new_block(ctx.span(), "mixed-switch.join")?
    otherwise :: ctx.new_block(ctx.span(), "mixed-switch.otherwise")?
    tests := [MirBlockId].with_capacity(arms.len())
    bodies := [MirBlockId].with_capacity(arms.len())
    for index in 0..<arms.len() {
        tests.push(ctx.new_block(ctx.span(), "mixed-switch.test.{index}")?)
        bodies.push(ctx.new_block(ctx.span(), "mixed-switch.body.{index}")?)
    }
    ctx.terminate(MirTerminator.Jump{target: tests.first() ?? otherwise})
    for (index, (condition, body)) in arms.iter().enumerate() {
        ctx.switch_to(tests[index])
        condition :: ctx.with_switch_subject(subject_value, fn(ctx) { lower_expr(&ctx, condition) })?
        next :: tests.get(index + 1) ?? otherwise
        ctx.terminate(MirTerminator.Branch{condition: condition, then_target: bodies[index], else_target: next})
        ctx.switch_to(bodies[index])
        ctx.with_switch_subject(subject_value, fn(ctx) {
            ctx.push_lexical_frame()
            lower_stmts(&ctx, body)?
            return ctx.pop_lexical_frame()
        })?
        if !ctx.is_terminated() { ctx.terminate(MirTerminator.Jump{target: join}) }
    }
    ctx.switch_to(otherwise)
    ctx.push_lexical_frame()
    if else_body == Val(body) { lower_stmts(&ctx, body)? }
    ctx.pop_lexical_frame()?
    if !ctx.is_terminated() { ctx.terminate(MirTerminator.Jump{target: join}) }
    ctx.switch_to(join)
}

// Rust: crates/jet-codegen/src/Codegen/TIR/tir_to_mir_stmt.rs:2564
fn lower_debug_only(ctx: &LowerCtx, body: [TStmt]) -> Unit LowerError! {
    scope :: ctx.enter_scope(MirScopeKind.DebugOnly, ctx.span(), Val("debug-only"))?
    lower_stmts(&ctx, body)?
    ctx.exit_scope(scope)?
}
// Rust: crates/jet-codegen/src/Codegen/TIR/tir_to_mir_stmt.rs:2575
fn lower_scoped(ctx: &LowerCtx, kind: MirScopeKind, name: String?, body: [TStmt]) -> Unit LowerError! {
    scope :: ctx.enter_scope(kind, ctx.span(), name)?
    lower_stmts(&ctx, body)?
    ctx.exit_scope(scope)?
}

// Rust: crates/jet-codegen/src/Codegen/TIR/tir_to_mir_stmt.rs:2587
fn lower_scope_member(ctx: &LowerCtx, kind: ScopeMemberKind, body: [TStmt]) -> Unit LowerError! {
    if kind == {
        .Setup -> lower_stmts(&ctx, body)?
        .ExpectFail(code) -> {
            scope :: ctx.enter_scope(MirScopeKind.ScopeMember, ctx.span(), code)?
            attach_scope_member(&ctx, scope, MirTestScopeMember.ExpectFail{expected_code: code})?
            lower_scope_member_body(&ctx, scope, body)?
        }
        .Timeout(duration) -> {
            value :: lower_expr(&ctx, duration)?
            scope :: ctx.enter_scope(MirScopeKind.ScopeMember, ctx.span(), Val("timeout"))?
            attach_scope_member(&ctx, scope, MirTestScopeMember.Timeout{duration: value})?
            lower_scope_member_body(&ctx, scope, body)?
        }
        .Measure -> {
            scope :: ctx.enter_scope(MirScopeKind.ScopeMember, ctx.span(), Val("measure"))?
            attach_scope_member(&ctx, scope, MirTestScopeMember.Measure)?
            lower_scope_member_body(&ctx, scope, body)?
        }
        .Skip -> {
            whole_test :: ctx.scopes.is_empty() && ctx.current == ctx.entry && ctx.block_by_id(ctx.current).is_some_and(fn(block) { block.instructions.is_empty() })
            scope :: ctx.enter_scope(MirScopeKind.ScopeMember, ctx.span(), Val("skip"))?
            attach_scope_member(&ctx, scope, MirTestScopeMember.Skip{whole_test: whole_test})?
            // Retain the checked body for diagnostics behind an always-false edge.
            body_block :: ctx.new_block(ctx.span(), "scope-member.skip.body")?
            skipped_block :: ctx.new_block(ctx.span(), "scope-member.skip.skipped")?
            exit :: ctx.new_block(ctx.span(), "scope-member.skip.exit")?
            join :: ctx.new_block(ctx.span(), "scope-member.skip.join")?
            false_value :: ctx.emit("scope-member.skip.condition", Val(Type.Bool), MirOperation.Constant(MirConstant.Bool(false)))?
            ctx.terminate(MirTerminator.Branch{condition: false_value, then_target: body_block, else_target: skipped_block})
            ctx.switch_to(body_block)
            body_block_start :: ctx.blocks.len()
            ctx.push_lexical_frame()
            lower_stmts(&ctx, body)?
            ctx.pop_lexical_frame()?
            emit_scope_exits_on_early_paths(&ctx, scope, body_block, body_block_start)?
            if !ctx.is_terminated() { ctx.terminate(MirTerminator.Jump{target: exit}) }
            ctx.switch_to(skipped_block)
            ctx.terminate(MirTerminator.Jump{target: exit})
            ctx.switch_to(exit)
            ctx.exit_scope(scope)?
            if !ctx.is_terminated() { ctx.terminate(MirTerminator.Jump{target: join}) }
            ctx.switch_to(join)
        }
    }
}

// Rust: crates/jet-codegen/src/Codegen/TIR/tir_to_mir_stmt.rs:2675
fn attach_scope_member(ctx: &LowerCtx, scope: MirScopeId, member: MirTestScopeMember) -> Unit LowerError! {
    current :: ctx.current_block()
    span :: ctx.span()
    instruction :: ctx.blocks.iter_mut().find(fn(block) { block.id == current }).and_then(fn(block) { block.instructions.last_mut() })
        ?? return Err(ctx.error(span, "MIR scope member has no scope-enter operation"))
    if &instruction.operation == {
        .ScopeEnter(scope: candidate, test_member: test_member) if candidate == scope -> { test_member = Val(member) }
        else -> { return Err(ctx.error(span, "MIR scope member has no scope-enter operation")) }
    }
}

// Rust: crates/jet-codegen/src/Codegen/TIR/tir_to_mir_stmt.rs:2702
fn rollback_method_lookup(owner: Type, method: String) -> String Never! {
    owner :: if owner.without_user_tags() == { .Named(name) | .Apply(name, ..) -> name; else -> { return "{Syntax.TRAIT_ROLLBACK}::{method}" } }
    key :: "{Syntax.TRAIT_ROLLBACK}::{method}"
    return if key == owner || key.starts_with("{owner}::") -> key else -> "{owner}::{key}"
}
// Rust: crates/jet-codegen/src/Codegen/TIR/tir_to_mir_stmt.rs:2716
fn rollback_method_call(receiver: TLocal, receiver_ty: Type, method: String, return_ty: Type, args: [TCallArg]) -> TExpr Never! {
    return TExpr{ty: return_ty, kind: TExprKind.MethodCall{
        recv: TExpr{ty: receiver_ty, kind: TExprKind.Local(receiver)},
        method: TMethodRef.trait_method(Syntax.TRAIT_ROLLBACK, method), type_args: [], args: args,
        source_first_string_literal: None, operator_line: None
    }}
}
// Rust: crates/jet-codegen/src/Codegen/TIR/tir_to_mir_stmt.rs:2739
fn transaction_restore_call_arg(value: TExpr) -> TCallArg Never! {
    return TCallArg{value: value, template_items: None, borrow: false, mut_borrow: false,
        clone: false, arc_clone: false, fn_coerce: None, widen_to_vec: false, widen_to_union: None, box_as_trait: None}
}

// Rust: crates/jet-codegen/src/Codegen/TIR/tir_to_mir_stmt.rs:2754
fn emit_scope_exits_on_early_paths(ctx: &LowerCtx, scope: MirScopeId, body_entry: MirBlockId, body_block_start: USize) -> Unit LowerError! {
    body_blocks := ctx.blocks[body_block_start..].iter().map(fn(block) { block.id }).collect()
    body_blocks.push(body_entry)
    // Membership is indexed once: do not rescan all body IDs for every exit.
    body_ids: Set<MirBlockId> :: body_blocks.iter().copied().collect()
    early_exits :: body_blocks.iter().copied().filter(fn(block_id) {
        block :: ctx.block_by_id(block_id) ?? return false
        leaves_scope :: if block.terminator == {
            .Return(..) -> true
            .Break(target: target, ..) | .Continue(target: target) -> !body_ids.contains(target)
            else -> false
        }
        return leaves_scope && !block.instructions.iter().any(fn(instruction) {
            return if instruction.operation == { .ScopeExit(scope: candidate) -> candidate == scope; else -> false }
        })
    }).collect()
    current :: ctx.current_block()
    for block in early_exits {
        // Guarded release may branch; move the terminator to the cleanup tail.
        exit :: ctx.block_by_id(block).map(fn(row) { row.terminator }).ok_or_else(fn() { ctx.error(ctx.span(), "scope early exit has no block") })?
        ctx.switch_to(block)
        ctx.emit_scope_cleanups(scope)?
        _ :: ctx.emit("scope-member.exit.early.{block.0}", None, MirOperation.ScopeExit{scope: scope})?
        ctx.terminate(exit)
    }
    ctx.switch_to(current)
}

// Rust: crates/jet-codegen/src/Codegen/TIR/tir_to_mir_stmt.rs:2809
fn lower_scope_member_body(ctx: &LowerCtx, scope: MirScopeId, body: [TStmt]) -> Unit LowerError! {
    body_entry :: ctx.current_block()
    body_block_start :: ctx.blocks.len()
    lower_stmts(&ctx, body)?
    emit_scope_exits_on_early_paths(&ctx, scope, body_entry, body_block_start)?
    if ctx.is_terminated() {
        ctx.exit_scope(scope)?
        return
    }
    exit :: ctx.new_block(ctx.span(), "scope-member.exit")?
    join :: ctx.new_block(ctx.span(), "scope-member.join")?
    ctx.terminate(MirTerminator.Jump{target: exit})
    ctx.switch_to(exit)
    ctx.exit_scope(scope)?
    if !ctx.is_terminated() { ctx.terminate(MirTerminator.Jump{target: join}) }
    ctx.switch_to(join)
}

// Rust: crates/jet-codegen/src/Codegen/TIR/tir_to_mir_stmt.rs:2834
fn lower_transaction(ctx: &LowerCtx, handle: TLocal?, snapshots: [(TLocal, Type?)], stm: TLocal?, body: [TStmt]) -> Unit LowerError! {
    scope :: ctx.enter_scope(MirScopeKind.Transaction, ctx.span(), None)?
    if handle == Val(handle) {
        ty :: Type.Named("Transaction")
        place :: ctx.bind_local(handle, ty, handle.mutable, false, false)?
        value :: ctx.emit("transaction.handle.global", Val(ty), MirOperation.Global{name: "transaction"})?
        _ :: ctx.emit("transaction.handle.write", None, MirOperation.WritePlace{place: place, value: value})?
    }
    if stm == Val(stm) {
        ty :: Type.Named("Stm")
        place :: ctx.bind_local(stm, ty, stm.mutable, false, false)?
        value :: ctx.emit("transaction.stm.global", Val(ty), MirOperation.Global{name: "stm"})?
        _ :: ctx.emit("transaction.stm.write", None, MirOperation.WritePlace{place: place, value: value})?
    }
    restores := []
    for (index, (local, rollback_ty)) in snapshots.iter().enumerate() {
        place :: ctx.lower_place(TPlace.Local(local), MirAccess.Write)?
        (value, snapshot_ty) :: if rollback_ty == {
            Val(owner_ty) -> {
                snapshot_method :: rollback_method_lookup(owner_ty, "snapshot")
                snapshot_function :: ctx.function_id_for(snapshot_method)?
                callable_ty :: ctx.function_registry.return_type_for(snapshot_function) ?? return Err(ctx.error(ctx.span(), "Rollback::snapshot for `{owner_ty.name()}` has no checked return type"))
                call :: rollback_method_call(local, owner_ty, "snapshot", callable_ty, [])
                (snapshot, snapshot_ty) :: if callable_ty == {
                    .Result(ok: ok, ..) -> {
                        snapshot_ty :: ok
                        (TExpr{ty: snapshot_ty, kind: TExprKind.Try{
                            inner: call, note: None, convert: TTryConvert.NoConversion,
                            file: ctx.function.source_file, line: ctx.source_line() as USize,
                            column: ctx.source_column() as USize, fn_name: ctx.function.name
                        }}, snapshot_ty)
                    }
                    else -> (call, callable_ty)
                }
                (lower_expr(&ctx, snapshot)?, snapshot_ty)
            }
            None -> {
                snapshot_ty :: ctx.local_types.get(local.name).or_else(fn() { rollback_ty }) ?? Type.Named("Snapshot")
                value :: ctx.emit("transaction.snapshot.{index}.read", Val(snapshot_ty), MirOperation.ReadPlace(place))?
                copied :: ctx.emit("transaction.snapshot.{index}.copy", Val(snapshot_ty), MirOperation.Copy{value: value, fact: MirCopyFact.Materialize})?
                (copied, snapshot_ty)
            }
        }
        saved_local :: TLocal.generated("txn_snap_{ctx.transaction_restores.len()}_{index}").as_mutable()
        saved_place :: ctx.bind_local(saved_local, snapshot_ty, true, false, false)?
        _ :: ctx.emit("transaction.snapshot.{index}.save", None, MirOperation.WritePlace{place: saved_place, value: value})?
        custom :: rollback_ty.map(fn(owner_ty) {
            rollback_method_call(local, owner_ty, "restore", Type.Named(Syntax.INTERNAL_UNIT_TYPE),
                [transaction_restore_call_arg(TExpr{ty: snapshot_ty, kind: TExprKind.Local(saved_local)})])
        })
        restores.push(TransactionRestore{place: place, saved: saved_place, ty: snapshot_ty, custom: custom})
    }
    ctx.transaction_restores.push((scope, restores))
    body_entry :: ctx.current_block()
    body_block_start :: ctx.blocks.len()
    lower_stmts(&ctx, body)?
    emit_scope_exits_on_early_paths(&ctx, scope, body_entry, body_block_start)?
    if handle == Val(handle) {
        if ctx.is_terminated() {
            ctx.exit_scope(scope)?
            _ :: ctx.transaction_restores.pop()
            return
        }
        receiver :: lower_expr(&ctx, TExpr{ty: Type.Named("Transaction"), kind: TExprKind.Local(handle)})?
        call :: ctx.intern_prelude_route(TPreludeRoute{
            family: MirPreludeFamily.HandleMethod, module: "core.transaction", member: "commit",
            symbol: MirSymbol.Prelude("jet_transaction_commit"), signature: MirCallSignature{arity: 1, max_arity: 1, borrow_mask: [true]},
            effect: None, fallibility: TFailureCarrier.Infallible, abi: MirPreludeAbi.Value, authority: None, db_metadata: None
        })?
        _ :: ctx.emit("transaction.commit", Val(Type.Named(Syntax.INTERNAL_UNIT_TYPE)), MirOperation.Semantic(MirSemanticOp.HandleMethod{
            call: call, receiver: receiver, args: [], frame_schedule: None, frame_schedule_derivation: None
        }))?
    }
    ctx.exit_scope(scope)?
    _ :: ctx.transaction_restores.pop()
}

// Rust: crates/jet-codegen/src/Codegen/TIR/tir_to_mir_stmt.rs:3034
fn const_int(ctx: &LowerCtx, value: I64) -> MirValueId LowerError! {
    return ctx.emit("stmt.constant-int", Val(Type.Int), MirOperation.Constant(MirConstant.Int{value: value, width: None, spelling: None}))
}
