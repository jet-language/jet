fn register_operator_method(cx: &Cx, owner: String, method: String, trait_name: String, operator_rhs: &Type?, sig: [(AccessConvention, Type)], ret: Type?) -> Unit Never! {
    if !(trait_name == Syntax.TRAIT_ADD || trait_name == Syntax.TRAIT_SUB || trait_name == Syntax.TRAIT_MUL || trait_name == Syntax.TRAIT_DIV || trait_name == Syntax.TRAIT_EQUATABLE || trait_name == Syntax.TRAIT_COMPARABLE) -> return
