//RS /// Same recursive shape as the sema hashability walk, minus `Float`/`Float32`
//RS /// — Rust's `f64`/`f32` don't implement `Eq`/`Hash` (NaN breaks both laws).
//RS pub(crate) fn field_type_hashable(
//RS     ty: &Type,
//RS     types: &HashSet<String>,
//RS     param_names: &HashSet<String>,
//RS ) -> bool {
