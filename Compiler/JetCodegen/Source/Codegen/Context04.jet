pub fn type_is_hashable_struct(s: &StructDef, types: &HashSet<String>) -> Bool Never! {
    if s.is_published_schema -> return false
    params :: s.type_params.iter().map(fn(p) { p.name.clone() }).collect::<HashSet<String>>()
    s.fields.iter().all(fn(f) { field_type_hashable(&f.ty, types, &params) })
}
// Rust: crates/jet-codegen/src/Codegen/Context.rs:7086
pub fn type_is_hashable_enum(e: &EnumDef, types: &HashSet<String>) -> Bool Never! {
    params :: e.type_params.iter().map(fn(p) { p.name.clone() }).collect::<HashSet<String>>()
    e.variants.iter().all(fn(v) { if &v.payload == {
        .Unit -> true
        .Single(ty, _) -> field_type_hashable(ty, types, &params)
        .Named(fields) -> fields.iter().all(fn(f) { field_type_hashable(&f.ty, types, &params) })
    } })
