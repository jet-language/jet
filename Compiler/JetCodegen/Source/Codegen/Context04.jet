//RS /// Core nominal values are emitted by the Prelude rather than registered in
//RS /// `Cx::type_names`. Most of those carriers derive `Clone`; these are the
//RS /// stateful stream/reader handles whose single-use state intentionally does not.
//RS fn core_type_cloneable(name: &str) -> bool {
//RS     matches!(
//RS         name,
//RS         "Counter" | "OrderedMap" | "Layer" | "Chain" | "StringSet"
//RS     ) || (core_rust_type_name(name).is_some()
//RS         && !matches!(
//RS             name,
//RS             "JobQueue"
//RS                 | "Clock"
//RS                 | "Match"
//RS                 | "DataStream"
//RS                 | "JSONReader"
//RS                 | "JSONWriter"
//RS                 | "JSONLReader"
//RS                 | "JSONLWriter"
//RS                 | "CSVReader"
//RS                 | "CSVWriter"
//RS                 | "XMLReader"
//RS                 | "XMLWriter"
//RS                 | "CBORReader"
//RS                 | "CBORWriter"
//RS         ))
//RS }
