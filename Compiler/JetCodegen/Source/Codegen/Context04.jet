    cx.method_type_params.insert(key.clone(), method.type_params.clone())
    cx.method_rets.insert(key.clone(), method.return_type.clone())
    cx.contract_sigs.insert("{owner}::{method.name}", (method.pre.clone(), method.post.clone()))
    cx.fn_param_names.insert("{owner}::{method.name}", method.params.iter().map(fn(p) { p.name.clone() }).collect())
    if trait_name == {
        .Val(trait_name) -> {
            cx.trait_methods.insert(key.clone())
            cx.trait_method_traits.insert(key, trait_name)
