}
// Rust: crates/jet-codegen/src/Codegen/Context.rs:6978
fn core_type_cloneable(name: String) -> Bool Never! {
    if name == { "Counter" | "OrderedMap" | "Layer" | "Chain" | "StringSet" -> return true else -> {} }
    if core_rust_type_name(name) == None -> return false
    if name == { "JobQueue" | "Clock" | "Match" | "DataStream" | "JSONReader" | "JSONWriter" | "JSONLReader" | "JSONLWriter" | "CSVReader" | "CSVWriter" | "XMLReader" | "XMLWriter" | "CBORReader" | "CBORWriter" -> false else -> true }
}
// Rust: crates/jet-codegen/src/Codegen/Context.rs:7002
pub fn field_type_cloneable(ty: &Type, types: &HashSet<String>, param_names: &HashSet<String>) -> Bool Never! {
    if ty == {
        .Int | .Bool | .Float | .String | .Char | .IntN(..) | .Float32 -> true
        .List(inner) | .Shared(inner) | .Option(inner) -> field_type_cloneable(inner, types, param_names)
        .Map(key: key, value: value, ..) -> field_type_cloneable(key, types, param_names) && field_type_cloneable(value, types, param_names)
        .Result(ok, err) -> field_type_cloneable(ok, types, param_names) && field_type_cloneable(err, types, param_names)
        .Named(n) -> Generics.is_type_var_name(n) || param_names.contains(n) || is_json_type_name(n) || n == "Tensor" || n == Syntax.DETERMINISTIC_WORLD_TYPE || core_type_cloneable(n) || types.contains(n)
        .Apply(name, args) -> {
            if name == Syntax.TYPE_SHARED_SNAPSHOT || name == "ViewMut" || name == "ComputeViewMut" || name == "Task" || name == Syntax.TYPE_PIN || name == Syntax.TYPE_SHARED_GUARD -> return false
            if name == "View" -> return true
            args.iter().all(fn(a) { field_type_cloneable(a, types, param_names) })
        }
        .Tuple(fields) -> fields.iter().all(fn(row) { field_type_cloneable(&row.1, types, param_names) })
        .TraitObject(_) | .Fn(..) -> false
        .FixedList(elem: elem, ..) -> field_type_cloneable(elem, types, param_names)
        .Tagged(marker: .Internal(.CoreCryptoNominal), ..) -> false
        .Tagged(inner: inner, ..) -> field_type_cloneable(inner, types, param_names)
        .InlineRange(base: base, ..) -> field_type_cloneable(base, types, param_names)
        .Union(members) -> members.iter().all(fn(m) { field_type_cloneable(m, types, param_names) })
        .Quantity(base: base, ..) -> field_type_cloneable(base, types, param_names)
        .Measure(_) -> false
    }
}
