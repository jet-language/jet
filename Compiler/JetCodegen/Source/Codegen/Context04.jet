// Rust: crates/jet-codegen/src/Codegen/Context.rs:7099
pub fn field_type_hashable(ty: &Type, types: &HashSet<String>, param_names: &HashSet<String>) -> Bool Never! {
    if ty == {
        .Float | .Float32 -> false
        .Int | .Bool | .String | .Char | .IntN(..) -> true
        .Option(inner) | .List(inner) -> field_type_hashable(inner, types, param_names)
        .Result(ok, err) -> field_type_hashable(ok, types, param_names) && field_type_hashable(err, types, param_names)
        .Named(n) -> Generics.is_type_var_name(n) || param_names.contains(n) || types.contains(n)
        .Apply(name, args) -> {
            if name == "Task" || name == "Sender" || name == "Receiver" || name == Syntax.TYPE_SHARED_GUARD || name == "Pool" -> return false
            if name == "ID" -> return true
            args.iter().all(fn(a) { field_type_hashable(a, types, param_names) })
        }
        .Tuple(fields) -> fields.iter().all(fn(row) { field_type_hashable(&row.1, types, param_names) })
        .TraitObject(_) | .Map(..) | .Shared(_) | .Fn(..) -> false
        .FixedList(elem: elem, ..) -> field_type_hashable(elem, types, param_names)
        .Tagged(inner: inner, ..) -> field_type_hashable(inner, types, param_names)
        .InlineRange(base: base, ..) -> field_type_hashable(base, types, param_names)
        .Union(members) -> members.iter().all(fn(m) { field_type_hashable(m, types, param_names) })
        .Quantity(base: base, ..) -> field_type_hashable(base, types, param_names)
        .Measure(_) -> false
    }
}

// Rust: crates/jet-codegen/src/Codegen/Context.rs:7166
pub fn find_box_edges(items: &[Item], cx: &Cx) -> HashSet<(String, String)> Never! {
    // Rust: crates/jet-codegen/src/Codegen/Context.rs:7167
    fn targets(ty: &Type, cx: &Cx, out: &[String]) -> Unit Never! {
        if ty == {
            .Named(n) -> { if cx.type_names.contains(n) { out.push(n.clone()) } }
            .Option(inner) | .List(inner) -> targets(inner, cx, out)
            .Map(key: key, value: value, ..) | .Result(ok: key, err: value) -> { targets(key, cx, out); targets(value, cx, out) }
            else -> {}
        }
    }
    // Rust: crates/jet-codegen/src/Codegen/Context.rs:7182
    fn field_edges(fields: &[(String, Type)], cx: &Cx) -> [(String, [String])] Never! {
        fields.iter().map(fn(row) { out := [String]{}; targets(&row.1, cx, &out); (row.0.clone(), ^out) }).collect()
    }
    // Rust: crates/jet-codegen/src/Codegen/Context.rs:7192
    fn variant_edges(variants: &[(String, VariantPayload)], cx: &Cx) -> [(String, [String])] Never! {
        edges := [(String, [String])]{}
        loop (name, payload) in variants {
            if payload == {
                .Unit -> {}
                .Single(ty, _) -> { out := [String]{}; targets(ty, cx, &out); edges.push((name.clone(), ^out)) }
                .Named(fields) -> { loop field in fields { out := [String]{}; targets(&field.ty, cx, &out); edges.push(("{name}.{field.name}", ^out)) } }
            }
        }
        ^edges
    }
    named_edges :: fn(name: String) {
        edges := cx.struct_fields.get(name).map(fn(fields) { field_edges(fields, cx) }) ?? []
        if cx.enum_variants.get(name) == { .Val(variants) -> edges.extend(variant_edges(variants, cx)) else -> {} }
        ^edges
    }
    roots := [(String, [(String, [String])])]{}
    loop item in items {
        if item == {
            .Struct(s) -> { fields :: s.fields.iter().map(fn(f) { (f.name.clone(), f.ty.clone()) }).collect(); roots.push((s.name.clone(), field_edges(&fields, cx))) }
            .Enum(e) -> { variants :: e.variants.iter().map(fn(v) { (v.name.clone(), v.payload.clone()) }).collect(); roots.push((e.name.clone(), variant_edges(&variants, cx))) }
            else -> {}
        }
    }
    exact :: fn() {
        boxed := HashSet<(String, String)>.new()
        loop item in items { if item == { .Struct(s) -> boxed.extend(find_struct_box_edges(s, cx)) .Enum(e) -> boxed.extend(find_enum_box_edges(e, cx)) else -> {} } }
        ^boxed
    }
    root_names :: roots.iter().map(fn(row) { row.0.clone() }).collect::<HashSet<String>>()
    loop (name, edges) in &roots { if cx.type_names.contains(name) && named_edges(name) != edges -> return exact() }
    index := [String: USize]{}
    nodes := [String]{}
    adjacency := [[(String, [String])]]{}
    pending := [USize]{}
    loop (name, edges) in &roots {
        if index.contains_key(name) -> next
        index.insert(name.clone(), nodes.len())
        pending.push(nodes.len())
        nodes.push(name.clone())
        adjacency.push(edges.clone())
    }
    while pending.pop() == {
        .Val(node) -> {
            successors :: adjacency[node].iter().flat_map(fn(row) { row.1.iter().cloned() }).collect()
            loop target in successors {
                if index.contains_key(target) -> next
                index.insert(target.clone(), nodes.len())
                pending.push(nodes.len())
                adjacency.push(named_edges(target))
                nodes.push(^target)
            }
        }
        else -> break
    }
    count :: nodes.len()
    order := [USize.MAX; count]
    low := [0 as USize; count]
    on_stack := [false; count]
    component := [USize.MAX; count]
    stack := [USize]{}
    next_order := 0 as USize
    components := 0 as USize
    successors :: fn(node: USize) { adjacency[node].iter().flat_map(fn(row) { row.1.iter().map(fn(target) { index[target] }) }).collect() }
    loop start in 0..count {
        if order[start] != USize.MAX -> next
        frames := [(start, successors(start), 0 as USize)]
        order[start] = next_order
        low[start] = next_order
        next_order += 1
        stack.push(start)
        on_stack[start] = true
        while !frames.is_empty() {
            frame_index :: frames.len() - 1
            node :: frames[frame_index].0
            cursor :: frames[frame_index].2
            if cursor < frames[frame_index].1.len() {
                child :: frames[frame_index].1[cursor]
                frames[frame_index].2 += 1
                if order[child] == USize.MAX {
                    order[child] = next_order
                    low[child] = next_order
                    next_order += 1
                    stack.push(child)
                    on_stack[child] = true
                    frames.push((child, successors(child), 0))
                } else if on_stack[child] { low[node] = low[node].min(order[child]) }
                next
            }
            _ :: frames.pop()
            if frames.last() == { .Val(parent_frame) -> { parent :: parent_frame.0; low[parent] = low[parent].min(low[node]) } else -> {} }
            if low[node] == order[node] {
                while stack.pop() == {
                    .Val(member) -> { on_stack[member] = false; component[member] = components; if member == node -> break }
                    else -> break
                }
                components += 1
            }
        }
    }
    sizes := [0 as USize; components]
    loop id in &component { sizes[id] += 1 }
    loop (node, name) in nodes.iter().enumerate() { if sizes[component[node]] > 1 && !root_names.contains(name) -> return exact() }
    boxed := HashSet<(String, String)>.new()
    loop (node, owner) in nodes.iter().enumerate() {
        loop (edge, edge_targets) in &adjacency[node] {
            if edge_targets.iter().any(fn(target) { target == owner || component[index[target]] == component[node] }) { boxed.insert((owner.clone(), edge.clone())) }
        }
    }
    #if debug_assertions {
        if count <= 64 { assert(boxed == exact(), "SCC box edges differ from path enumeration") }
    }
    ^boxed
}
// Rust: crates/jet-codegen/src/Codegen/Context.rs:7391
pub fn find_struct_box_edges(s: &StructDef, cx: &Cx) -> HashSet<(String, String)> Never! {
    boxed := HashSet<(String, String)>.new()
    loop f in &s.fields { stack := [s.name.clone()]; walk_type_edge(s.name, f.name, &f.ty, &stack, cx, &boxed) }
    ^boxed
}
// Rust: crates/jet-codegen/src/Codegen/Context.rs:7406
fn find_enum_box_edges(e: &EnumDef, cx: &Cx) -> HashSet<(String, String)> Never! {
    boxed := HashSet<(String, String)>.new()
    loop v in &e.variants {
        if &v.payload == {
            .Unit -> {}
            .Single(t, _) -> { stack := [e.name.clone()]; walk_type_edge(e.name, v.name, t, &stack, cx, &boxed) }
            .Named(fs) -> { loop f in fs { key :: "{v.name}.{f.name}"; stack := [e.name.clone()]; walk_type_edge(e.name, key, &f.ty, &stack, cx, &boxed) } }
        }
    }
    ^boxed
}
// Rust: crates/jet-codegen/src/Codegen/Context.rs:7437
fn walk_type_edge(owner: String, edge: String, ty: &Type, stack: &[String], cx: &Cx, boxed: &HashSet<(String, String)>) -> Unit Never! {
    if ty == {
        .Named(n) -> {
            if !cx.type_names.contains(n) -> return
            if stack.iter().any(fn(s) { s == n }) { boxed.insert((owner, edge)); return }
            stack.push(n.clone())
            if cx.struct_fields.get(n) == { .Val(fields) -> { loop (fname, fty) in fields { walk_type_edge(n, fname, fty, stack, cx, boxed) } } else -> {} }
            if cx.enum_variants.get(n) == {
                .Val(vars) -> {
                    loop (vname, payload) in vars {
                        if payload == {
                            .Unit -> {}
                            .Single(t, _) -> walk_type_edge(n, vname, t, stack, cx, boxed)
                            .Named(fs) -> { loop f in fs { key :: "{vname}.{f.name}"; walk_type_edge(n, key, &f.ty, stack, cx, boxed) } }
                        }
                    }
                }
                else -> {}
            }
            _ :: stack.pop()
        }
        // Shared is already sized; sema rejects strong Shared cycles.
        .Option(inner) | .List(inner) -> walk_type_edge(owner, edge, inner, stack, cx, boxed)
        .Map(key: key, value: value, ..) | .Result(ok: key, err: value) -> { walk_type_edge(owner, edge, key, stack, cx, boxed); walk_type_edge(owner, edge, value, stack, cx, boxed) }
        .Char -> {}
        else -> {}
    }
}
