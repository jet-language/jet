    cx.enum_variants.insert("HTTPRetryPolicy", ^http_retry_policy)
    cx.cloneable.insert("HTTPRetryPolicy")
    cx.variant_owner.insert("Memory", "HTTPCookieJar")
    cx.enum_variants.insert("HTTPCookieJar", [("Memory", VariantPayload.Unit)])
    cx.cloneable.insert("HTTPCookieJar")
    cx.variant_owner.insert("Gzip", "HTTPCompressEncoding")
    cx.enum_variants.insert("HTTPCompressEncoding", [("Gzip", VariantPayload.Unit)])
    cx.cloneable.insert("HTTPCompressEncoding")
    cx.cloneable.insert("HTTPCorsPolicy")
    http_cors_origins :: [("Any", VariantPayload.Unit), ("List", VariantPayload.Single(Type.List(Type.String), zero))]
    loop (variant, _) in &http_cors_origins { cx.variant_owner.insert(variant.clone(), "HTTPCorsOrigins") }
    cx.enum_variants.insert("HTTPCorsOrigins", ^http_cors_origins)
    cx.cloneable.insert("HTTPCorsOrigins")
    http_errors := ["InvalidMethod", "InvalidURL", "InvalidHeader", "InvalidStatus", "BodyConsumed", "InvalidFraming", "UnsupportedEncoding", "Cancelled"].into_iter().map(fn(name) { (name.to_string(), VariantPayload.Unit) }).collect()
    loop (name, field, ty) in [
        ("BodyTooLarge", "limit", Type.Int), ("Resolve", "host", Type.String), ("Connect", "address", Type.String),
        ("TLS", "stage", Type.String), ("Timeout", "phase", Type.String), ("Proxy", "stage", Type.String),
        ("Redirect", "reason", Type.String), ("Protocol", "version", Type.String), ("IO", "operation", Type.String),
        ("Policy", "reason", Type.String), ("ResourceUnavailable", "resource", Type.String), ("Internal", "incident_id", Type.String),
        ("UnsupportedTarget", "operation", Type.Named("HTTPOperation"))] {
        http_errors.push((name, VariantPayload.Named([VariantField{name: field, name_span: zero, ty: ^ty, ty_span: zero}])))
    }
    loop (name, _) in &http_errors { cx.variant_owner.insert(name.clone(), "HTTPError") }
    cx.enum_variants.insert("HTTPError", ^http_errors)
    cx.cloneable.insert("HTTPError")
    cx.cloneable.insert("HTTPOperation")
    ws_errors := ["InvalidURL", "InvalidHandshake", "Protocol", "Timeout", "Closed", "Cancelled", "UnsupportedTarget"].into_iter().map(fn(name) { (name.to_string(), VariantPayload.Unit) }).collect()
    ws_errors.push(("MessageTooLarge", VariantPayload.Named([VariantField{name: "limit", name_span: zero, ty: Type.Int, ty_span: zero}])))
    ws_errors.push(("IO", VariantPayload.Named([VariantField{name: "operation", name_span: zero, ty: Type.String, ty_span: zero}])))
    loop (name, _) in &ws_errors { cx.variant_owner.insert(name.clone(), "WsError") }
    cx.enum_variants.insert("WsError", ^ws_errors)
    loop name in ["WsError", "WsConn", "WsMessage", "Browser", "BrowserContext", "BrowserPage", "BrowserFrame", "BrowserLocator", "BrowserIntercept", "BrowserEvent", "BrowserTrace", "BrowserReceipt", "BrowserPrivacy", "BrowserError", "BrowserAbilities", "BrowserProfile", "BrowserTimeout", "BrowserProtocol"] { cx.cloneable.insert(name) }
    cx.local_type_names.insert(Syntax.TYPE_ORDERING)
    cx.enum_variants.insert(Syntax.TYPE_ORDERING, ["Less", "Equal", "Greater"].into_iter().map(fn(name) { (name, VariantPayload.Unit) }).collect())
    loop name in ["Less", "Equal", "Greater"] { cx.variant_owner.insert(name, Syntax.TYPE_ORDERING) }
    cx.cloneable.insert(Syntax.TYPE_ORDERING)
    cx.enum_variants.insert(Syntax.TYPE_REMOVE_BY, ["Val", "Slot"].into_iter().map(fn(name) { (name, VariantPayload.Unit) }).collect())
    loop name in ["Val", "Slot"] { cx.variant_owner.insert(name, Syntax.TYPE_REMOVE_BY) }
    cx.cloneable.insert(Syntax.TYPE_REMOVE_BY)

    // Rust: crates/jet-codegen/src/Codegen/Context.rs:5782
    fn callable_return_type(function: &Func) -> Type Never! {
        if function.inline_foreign != None -> return function.return_type.clone() ?? Type.Named(Syntax.INTERNAL_UNIT_TYPE)
        if function.return_type == {
            .Val(stream @ .Apply(name, args)) -> {
                if name == Syntax.TYPE_STREAM && args.len() == 1 -> return stream.clone()
            }
            else -> {}
        }
        function.effective_return_type()
    }
    loop item in items {
        if item == {
            .Func(f) -> {
                if f.diverges { cx.diverging_functions.insert(f.name.clone()) }
                cx.contract_sigs.insert(f.name.clone(), (f.pre.clone(), f.post.clone()))
                cx.fn_param_names.insert(f.name.clone(), f.params.iter().map(fn(p) { p.name.clone() }).collect())
                cx.fn_type_params.insert(f.name.clone(), f.type_params.iter().map(fn(p) { p.name.clone() }).collect())
                cx.fn_type_param_order.insert(f.name.clone(), f.type_params.iter().map(fn(p) { p.name.clone() }).collect())
                cx.sigs.insert(f.name.clone(), f.params.iter().map(fn(p) {
                    ty :: if p.variadic -> Type.List(p.ty.clone()) else -> p.ty.clone()
                    (p.convention, ty.with_effective_fn_returns())
                }).collect())
                cx.fn_types.insert(f.name.clone(), Type.Fn(
                    params: f.params.iter().map(fn(p) { ty :: if p.variadic -> Type.List(p.ty.clone()) else -> p.ty.clone(); ty.with_effective_fn_returns() }).collect(),
                    ret: Val(callable_return_type(f)), effect_bound: None,
                    param_contract: if !f.params.is_empty() -> Val(f.params.iter().map(fn(p) { (p.call_label().to_string(), p.zone) }).collect()) else -> None,
                    call_metadata: Val(FunctionCallMetadata{
                        names: f.params.iter().map(fn(p) { p.name.clone() }).collect(),
                        defaults: f.params.iter().map(fn(p) { p.default.cloned() }).collect(),
                        variadic: f.params.iter().map(fn(p) { p.variadic }).collect(),
                        conventions: f.params.iter().map(fn(p) { p.convention }).collect(),
                        policies: f.markers.iter().find(fn(marker) { marker.name == Syntax.MARKER_POLICY }).and_then(fn(marker) { CallablePolicyChain.parse(&marker.expr_args_owned()).ok() }) ?? CallablePolicyChain.default()}),
                    return_view_provenance: f.return_view_provenance.clone()))
                cx.fn_bodies.insert(f.name.clone(), f.body.clone())
                source_fn_type :: cx.fn_types.get(f.name).cloned().map(fn(ty) {
                    source_ty := ^ty
                    if &source_ty == { .Fn(ret: ret, ..) -> ret = f.return_type.clone() else -> {} }
                    ^source_ty
                })
                if source_fn_type == { .Val(ty) -> cx.fn_source_types.insert(f.name.clone(), ^ty) else -> {} }
                if f.params.last() == {
                    .Val(last) -> {
                        if last.variadic_trait_bounds(fn(n) { Generics.is_builtin_trait(n) }) == {
                            .Val(bounds) -> cx.variadic_bound_fns.insert(f.name.clone(), (f.params.len() - 1, ^bounds))
                            else -> {}
                        }
                    }
                    else -> {}
                }
            }
            .Struct(s) -> {
                cx.type_names.insert(s.name.clone())
                cx.local_type_names.insert(s.name.clone())
                encode :: s.derives.iter().any(fn(row) { row.0 == Syntax.MARKER_CODABLE || row.0 == Generics.ENCODE })
                decode :: s.derives.iter().any(fn(row) { row.0 == Syntax.MARKER_CODABLE || row.0 == Generics.DECODE })
                if encode && decode { cx.codable_types.insert(s.name.clone()) }
                if s.is_published_schema { cx.published_schemas.insert(s.name.clone()) }
                param_names :: s.type_params.iter().map(fn(p) { p.name.as_str() }).collect::<HashSet<String>>()
                wire := HashSet.new()
                loop field in s.fields.iter().filter(fn(f) { f.computed == None && !f.serde_markers.iter().any(fn(m) { m.name == Syntax.MARKER_SKIP }) }) {
                    loop name in Generics.free_type_params(&field.ty) { if param_names.contains(name.as_str()) { wire.insert(^name) } }
                }
                cx.serde_wire_params.insert(s.name.clone(), ^wire)
                if s.layout == Val(StructLayout.Columnar) { cx.columnar.insert(s.name.clone()) }
                cx.struct_fields.insert(s.name.clone(), s.reflection_fields().map(fn(f) { (f.name.clone(), f.ty.clone()) }).collect())
                if s.type_markers.iter().find(fn(marker) { marker.name == Syntax.MARKER_RECEIPT && !marker.negated }) == {
                    .Val(marker) -> {
                        if marker.ct == {
                            .Val(.Str(name)) -> {
                                fields :: s.reflection_fields().map(fn(f) { (f.name.clone(), f.ty.clone()) }).collect()
                                cx.receipt_sections.insert(s.name.clone(), ReceiptSectionFact{name: name.clone(), type_name: s.name.clone(), schema_digest: receipt_schema_digest(s.name, &fields)})
                            }
                            else -> {}
                        }
                    }
                    else -> {}
                }
                cx.reflection_fields.insert(s.name.clone(), Reflection.fields(s))
                computed :: s.fields.iter().filter(fn(f) { f.computed != None }).map(fn(f) { f.name.clone() }).collect::<HashSet<String>>()
                if !computed.is_empty() { cx.computed_fields.insert(s.name.clone(), ^computed) }
                (memo_fields, memo_dependencies) :: memo_facts_for_struct(s)
                if !memo_fields.is_empty() { cx.memo_fields.insert(s.name.clone(), ^memo_fields) }
                if !memo_dependencies.is_empty() { cx.memo_dependencies.insert(s.name.clone(), ^memo_dependencies) }
                cx.struct_type_params.insert(s.name.clone(), s.type_params.iter().map(fn(p) { p.name.clone() }).collect())
                cx.struct_type_param_order.insert(s.name.clone(), s.type_params.iter().map(fn(p) { p.name.clone() }).collect())
            }
            .Enum(e) -> {
                cx.type_names.insert(e.name.clone())
                cx.local_type_names.insert(e.name.clone())
                cx.enum_variants.insert(e.name.clone(), e.variants.iter().map(fn(v) { (v.name.clone(), v.payload.clone()) }).collect())
                loop v in &e.variants { cx.variant_owner.insert(v.name.clone(), e.name.clone()) }
                loop g in &e.groups { cx.variant_owner.insert(g.path.clone(), e.name.clone()) }
            }
            .Const(c) -> {
                if TIR.source_constant_type(c) == {
                    .Val(ty) -> {
                        cx.const_types.insert(c.name.clone(), ty.clone())
                        if c.is_persist || c.mutable { cx.persist_types.insert(c.name.clone(), ^ty) }
                    }
                    else -> {}
                }
                if c.is_comptime && c.rust_kind != RustConstKind.Static {
                    serialized :: if (c.ct, c.ty) == {
                        (.Val(.List(xs)), .Val(.List(inner))) -> { if xs.is_empty() -> "Vec::<{cx.rust_type(inner)}>::new()" else -> c.ct.unwrap().serialize() }
                        (.Val(v), _) -> v.serialize()
                        (None, _) -> "Default::default()"
                    }
                    cx.consts.insert(c.name.clone(), serialized)
                    if c.ct == { .Val(value) -> cx.const_values.insert(c.name.clone(), value.clone()) else -> {} }
                } else { cx.consts.insert(c.name.clone(), mangle(c.name).to_uppercase()) }
            }
            .ExternRust(block) -> {
                loop ef in &block.functions {
                    cx.sigs.insert(ef.name.clone(), ef.params.iter().map(fn(p) { (p.convention, if p.variadic -> Type.List(p.ty.clone()) else -> p.ty.clone()) }).collect())
                    cx.fn_types.insert(ef.name.clone(), Type.Fn(
                        params: ef.params.iter().map(fn(p) { if p.variadic -> Type.List(p.ty.clone()) else -> p.ty.clone() }).collect(),
                        ret: ef.return_type.clone(), effect_bound: None, return_view_provenance: None,
                        param_contract: if !ef.params.is_empty() -> Val(ef.params.iter().map(fn(p) { (p.call_label().to_string(), p.zone) }).collect()) else -> None,
                        call_metadata: Val(FunctionCallMetadata{
                            names: ef.params.iter().map(fn(p) { p.name.clone() }).collect(), defaults: ef.params.iter().map(fn(_) { None }).collect(),
                            variadic: ef.params.iter().map(fn(p) { p.variadic }).collect(), conventions: ef.params.iter().map(fn(p) { p.convention }).collect(), policies: CallablePolicyChain.default()})))
                }
            }
            .CModule(cm) -> {
                loop ef in &cm.functions {
                    cx.sigs.insert(ef.name.clone(), ef.params.iter().map(fn(p) { (p.convention, if p.variadic -> Type.List(p.ty.clone()) else -> p.ty.clone()) }).collect())
                    cx.fn_types.insert(ef.name.clone(), Type.Fn(
                        params: ef.params.iter().map(fn(p) { if p.variadic -> Type.List(p.ty.clone()) else -> p.ty.clone() }).collect(),
                        ret: ef.return_type.clone(), effect_bound: None, return_view_provenance: None,
                        param_contract: if !ef.params.is_empty() -> Val(ef.params.iter().map(fn(p) { (p.call_label().to_string(), p.zone) }).collect()) else -> None,
                        call_metadata: Val(FunctionCallMetadata{
                            names: ef.params.iter().map(fn(p) { p.name.clone() }).collect(), defaults: ef.params.iter().map(fn(_) { None }).collect(),
                            variadic: ef.params.iter().map(fn(p) { p.variadic }).collect(), conventions: ef.params.iter().map(fn(p) { p.convention }).collect(), policies: CallablePolicyChain.default()})))
                }
            }
            .Trait(t) -> {
                cx.trait_names.insert(t.name.clone())
                loop m in &t.methods {
                    if m.params.iter().find(fn(p) { p.name == Syntax.KW_SELF }) == { .Val(p) -> cx.method_self_convs.insert((t.name.clone(), m.name.clone()), p.convention) else -> {} }
                    cx.method_sigs.insert((t.name.clone(), m.name.clone()), m.params.iter().filter(fn(p) { p.name != Syntax.KW_SELF }).map(fn(p) { (p.convention, if p.variadic -> Type.List(p.ty.clone()) else -> p.ty.clone()) }).collect())
                    cx.method_rets.insert((t.name.clone(), m.name.clone()), m.return_type.clone())
