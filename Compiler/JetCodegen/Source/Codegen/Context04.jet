    cx.enum_variants.insert(Syntax.TYPE_IO_OPERATION, Syntax.IO_OPERATION_VARIANTS.iter().map(fn(name) { (name.to_string(), VariantPayload.Unit) }).collect())
    cx.enum_variants.insert(Syntax.TYPE_PROCESS_RESOURCE_LIMIT, Syntax.PROCESS_RESOURCE_LIMIT_VARIANTS.iter().map(fn(name) { (name.to_string(), VariantPayload.Unit) }).collect())
    loop name in Syntax.IO_ERROR_VARIANTS { cx.variant_owner.insert(name.to_string(), Syntax.TYPE_IO_ERROR) }
    loop name in Syntax.IO_OPERATION_VARIANTS { cx.variant_owner.insert(name.to_string(), Syntax.TYPE_IO_OPERATION) }
    loop name in Syntax.PROCESS_RESOURCE_LIMIT_VARIANTS { cx.variant_owner.insert(name.to_string(), Syntax.TYPE_PROCESS_RESOURCE_LIMIT) }
    cx.cloneable.insert(Syntax.TYPE_IO_ERROR)
