            .Tag(_) -> {}
            .Migration(m) -> cx.migrations.entry(m.type_name.clone()).or_default().push(m.clone())
            .EffectDecl(_) | .MarkerDecl(_) | .FactDecl(_) | .Impl(_) | .Test(_) | .Module(_) | .ErrorConv(_) | .ProtocolDecl(_) | .UserDerive(_) | .TemplateLoop(_) | .GenericModule(_) | .ModuleAlias(_) -> {}
            .TypeAlias(a) -> cx.type_aliases.insert(a.name.clone(), (a.type_params.clone(), a.target.clone()))
            .Distinct(d) -> {
