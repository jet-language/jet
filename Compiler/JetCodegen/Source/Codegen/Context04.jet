    loop item in items {
        if item == {
            .Impl(i) -> { if i.trait_name == Val(Syntax.TRAIT_INDEX) { index_types.insert(i.type_name.clone()) } }
            .Struct(s) -> { loop block in &s.trait_impls { if block.trait_name == Syntax.TRAIT_INDEX { index_types.insert(s.name.clone()) } } }
