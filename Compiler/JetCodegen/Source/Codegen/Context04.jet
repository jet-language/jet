pub fn collect_iterable_hooks(cx: &Cx, items: &[Item]) -> Unit Never! {
    iterable_pairs := [(String, String)]{}
    loop item in items {
        coll_type :: if item == {
            .Impl(i) -> { if i.trait_name == Val(Syntax.TRAIT_ITERABLE) -> Val(i.type_name) else -> None }
            .Struct(s) -> Val(s.name)
            .Enum(e) -> Val(e.name)
