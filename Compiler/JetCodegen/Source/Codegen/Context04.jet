fn register_method(cx: &Cx, owner: String, method: &Func, trait_name: String?, operator_rhs: &Type?) -> Unit Never! {
    key :: (owner, method.name.clone())
    if method.params.iter().find(fn(p) { p.name == Syntax.KW_SELF }) == { .Val(p) -> cx.method_self_convs.insert(key.clone(), p.convention) else -> {} }
