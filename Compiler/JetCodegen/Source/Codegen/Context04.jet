//RS         Type::Float | Type::Float32 => false,
//RS         Type::Int | Type::Bool | Type::String | Type::Char => true,
//RS         Type::IntN { .. } => true,
//RS         Type::Option(inner) => field_type_hashable(inner, types, param_names),
//RS         Type::Result { ok, err } => {
//RS             field_type_hashable(ok, types, param_names)
//RS                 && field_type_hashable(err, types, param_names)
//RS         }
//RS         Type::List(inner) => field_type_hashable(inner, types, param_names),
//RS         Type::Named(n) if Generics::is_type_var_name(n) || param_names.contains(n.as_str()) => true,
//RS         Type::Named(n) => types.contains(n),
//RS         // D-TUPLE-DESTRUCT1: same opaque-handle exclusion as the backend
//RS         // equality compatibility walk above.
//RS         Type::Apply { name, .. }
//RS             if matches!(
//RS                 name.as_str(),
//RS                 "Task" | "Sender" | "Receiver" | Syntax::TYPE_SHARED_GUARD
//RS             ) =>
//RS         {
//RS             false
//RS         }
//RS         // D-MEM1 S6: same `Pool`/`Id` split as the backend equality walk above.
//RS         Type::Apply { name, .. } if name == "Pool" => false,
//RS         Type::Apply { name, .. } if name == "ID" => true,
//RS         Type::Apply { args, .. } => args
//RS             .iter()
//RS             .all(|a| field_type_hashable(a, types, param_names)),
//RS         Type::Tuple(fields) => fields
//RS             .iter()
//RS             .all(|(_, t)| field_type_hashable(t, types, param_names)),
//RS         Type::TraitObject(_) | Type::Map { .. } | Type::Shared(_) | Type::Fn { .. } => false,
//RS         Type::FixedList { elem, .. } => field_type_hashable(elem, types, param_names),
//RS         Type::Tagged { inner, .. } => field_type_hashable(inner, types, param_names),
//RS         Type::InlineRange { base, .. } => field_type_hashable(base, types, param_names),
//RS         Type::Union(members) => members
//RS             .iter()
//RS             .all(|m| field_type_hashable(m, types, param_names)),
//RS         // Runtime values carry no dimension metadata (I3): hashable iff the
//RS         // erased base numeric type is (a `Quantity<Float, _>` is never
//RS         // hashable, same as bare `Float`).
//RS         Type::Quantity { base, .. } => field_type_hashable(base, types, param_names),
//RS         // Same as the retired `\0compute.dimension.N` string encoding: it
//RS         // never matched the `Type::Named` user-type-registry lookup above
//RS         // (only ever reached as an `Apply` arg via the fallback above it).
//RS         Type::Measure(_) => false,
//RS     }
//RS }
