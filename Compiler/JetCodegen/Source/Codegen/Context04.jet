//RS pub(crate) fn field_type_cloneable(
//RS     ty: &Type,
//RS     types: &HashSet<String>,
//RS     param_names: &HashSet<String>,
//RS ) -> bool {
//RS     match ty {
//RS         Type::Int | Type::Bool | Type::Float | Type::String | Type::Char => true,
//RS         Type::IntN { .. } | Type::Float32 => true,
//RS         Type::List(inner) | Type::Shared(inner) | Type::Option(inner) => {
//RS             field_type_cloneable(inner, types, param_names)
//RS         }
//RS         Type::Map { key, value, .. } => {
//RS             field_type_cloneable(key, types, param_names)
//RS                 && field_type_cloneable(value, types, param_names)
//RS         }
//RS         Type::Result { ok, err } => {
//RS             field_type_cloneable(ok, types, param_names)
//RS                 && field_type_cloneable(err, types, param_names)
//RS         }
//RS         // c148: recognize both single-char heuristic and declared multi-char params.
//RS         Type::Named(n) if Generics::is_type_var_name(n) || param_names.contains(n.as_str()) => true,
//RS         // D-SERDE: the dynamic data surface is the Clone-backed DataTree in
//RS         // every canonical spelling, so records containing it can satisfy the
//RS         // generated decoder's existing result-retention path.
//RS         Type::Named(n) if is_json_type_name(n) || n == "Tensor" => true,
//RS         // D-TEST-WORLD1=A: the world is an Arc-backed scoped capability.
//RS         Type::Named(n) if n == Syntax::DETERMINISTIC_WORLD_TYPE => true,
//RS         Type::Named(n) => core_type_cloneable(n) || types.contains(n),
//RS         // `JetTask` implements no `Clone`: a handle owns one join slot.
//RS         // D-PIN1=A: a pin is an exclusive window, so it is no more cloneable
//RS         // than `ViewMut` — duplicating it would hand out a second no-move claim.
//RS         // `JetSharedSnapshot` owns a single-use publication ticket; cloning
//RS         // it would create two winners for one revision.
//RS         Type::Apply { name, .. } if name == Syntax::TYPE_SHARED_SNAPSHOT => false,
//RS         Type::Apply { name, .. }
//RS             if matches!(
//RS                 name.as_str(),
//RS                 "ViewMut" | "ComputeViewMut" | "Task" | Syntax::TYPE_PIN
//RS             ) || name == Syntax::TYPE_SHARED_GUARD =>
//RS         {
//RS             false
//RS         }
//RS         Type::Apply { name, .. } if name == "View" => true,
//RS         Type::Apply { args, .. } => args
//RS             .iter()
//RS             .all(|a| field_type_cloneable(a, types, param_names)),
//RS         Type::Tuple(fields) => fields
//RS             .iter()
//RS             .all(|(_, t)| field_type_cloneable(t, types, param_names)),
//RS         Type::TraitObject(_) | Type::Fn { .. } => false,
//RS         Type::FixedList { elem, .. } => field_type_cloneable(elem, types, param_names),
//RS         Type::Tagged {
//RS             marker: crate::AST::TagMarker::Internal(crate::AST::InternalTag::CoreCryptoNominal),
//RS             ..
//RS         } => false,
//RS         Type::Tagged { inner, .. } => field_type_cloneable(inner, types, param_names),
//RS         Type::InlineRange { base, .. } => field_type_cloneable(base, types, param_names),
//RS         Type::Union(members) => members
//RS             .iter()
//RS             .all(|m| field_type_cloneable(m, types, param_names)),
//RS         // Runtime values carry no dimension metadata (I3): cloneable iff the
//RS         // erased base numeric type is.
//RS         Type::Quantity { base, .. } => field_type_cloneable(base, types, param_names),
//RS         // Same as the retired `\0compute.dimension.N` string encoding: it
//RS         // never matched the `Type::Named` user-type-registry lookup above
//RS         // (only ever reached as an `Apply` arg via the fallback above it).
//RS         Type::Measure(_) => false,
//RS     }
//RS }
