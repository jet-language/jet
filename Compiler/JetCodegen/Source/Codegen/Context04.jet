// Rust: crates/jet-codegen/src/Codegen/Context.rs:6637
fn register_core_event_enums(cx: &Cx) -> Unit Never! {
    ENUMS :: [("Overflow", ["Block", "DropNewest", "DropOldest"]), ("FailurePolicy", ["StopFirst", "Collect", "Log", "Ignore"]),
        ("HookPolicy", ["FirstCancelElseTransform"]), ("HookOutcome", ["Continue", "Cancel", "Fail"]),
        ("HookDecision", ["Continue", "Transform", "Cancel", "Fail"]),
        ("DispatchState", ["Delivered", "HandlerFailed", "DroppedNewest", "DroppedOldest", "Closed", "Cancelled", "DeadlineExceeded"])]
    loop (enum_name, variants) in ENUMS {
        cx.enum_variants.entry(enum_name).or_insert_with(fn() {
            variants.iter().map(fn(variant) {
                payload :: if (enum_name, variant) == {
                    ("HookOutcome", "Continue" | "Fail") | ("HookDecision", "Transform" | "Fail") -> VariantPayload.Single(Type.Named("Unknown"), Span.new(0, 0))
                    else -> VariantPayload.Unit
                }
                (variant.to_string(), payload)
            }).collect()
        })
        loop variant in variants { cx.variant_owner.entry(variant).or_insert(enum_name) }
    }
    cx.enum_variants.entry(Syntax.TYPE_TASK_FAILURE).or_insert([("Cancelled", VariantPayload.Unit), ("DeadlineBlown", VariantPayload.Unit), ("Panicked", VariantPayload.Single(Type.String, Span.new(0, 0)))])
