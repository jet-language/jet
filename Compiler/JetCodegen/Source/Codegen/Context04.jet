pub fn type_is_cloneable_struct(s: &StructDef, types: &HashSet<String>) -> Bool Never! {
    params :: s.type_params.iter().map(fn(p) { p.name.clone() }).collect::<HashSet<String>>()
    s.fields.iter().all(fn(field) { field_type_cloneable(&field.ty, types, &params) })
}
// Rust: crates/jet-codegen/src/Codegen/Context.rs:6964
pub fn type_is_cloneable_enum(e: &EnumDef, types: &HashSet<String>) -> Bool Never! {
    params :: e.type_params.iter().map(fn(p) { p.name.clone() }).collect::<HashSet<String>>()
    e.variants.iter().all(fn(v) { if &v.payload == {
        .Unit -> true
        .Single(ty, _) -> field_type_cloneable(ty, types, &params)
