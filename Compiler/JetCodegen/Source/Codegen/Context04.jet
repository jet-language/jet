        if trait_impl_assoc_method(items, coll, Syntax.TRAIT_ITERABLE, "Iter", "iter") == {
            .Val(.Named(iter_type)) -> iterable_pairs.push((coll.clone(), ^iter_type))
            else -> {}
        }
    }
    loop (coll_type, iter_type) in iterable_pairs {
        item_type :: trait_impl_assoc_method(items, iter_type, Syntax.TRAIT_ITERATOR, "Item", "next") ?? next
        coll_identity :: TIR.canonical_enum_owner(cx, coll_type)
        iter_identity :: TIR.canonical_enum_owner(cx, iter_type)
        cx.iterable_hooks.insert(coll_type, IterableHook{iter_type: iter_type, item_type: ^item_type,
