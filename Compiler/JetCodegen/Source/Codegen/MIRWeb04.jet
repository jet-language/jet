// Rust: crates/jet-codegen/src/Codegen/MIRWeb.rs:6603
fn web_runtime_link(name: String) -> String? Never! {
    loop (source, local) in WEB_RUNTIME_LINKS { if source == name -> return Val(local) }
    None
}
// Rust: crates/jet-codegen/src/Codegen/MIRWeb.rs:6608
fn js_symbol_expression(symbol: MirSymbol) -> String MirWebError! {
    if symbol == {
        .Prelude(name) -> {
            loop (source, local) in WEB_PRELUDE_LINKS { if source == name -> return local }
            valid := true
            loop (index, byte) in name.bytes() {
                code :: Int.from_u8(byte)
                alphabetic :: (code >= 65 && code <= 90) || (code >= 97 && code <= 122)
                numeric :: code >= 48 && code <= 57
                if !(alphabetic || code == 95 || code == 36 || (index != 0 && numeric)) -> valid = false
            }
            if valid -> return name
            fail MirWebError.InvalidMir{message: "MIR Prelude symbol {name:?} has no direct local Web binding"}
        }
        .Runtime(name) -> web_runtime_link(name) ?? fail MirWebError.InvalidMir{message: "MIR Web runtime symbol {name:?} has no binding in the Web JS runtime module"}
    }
}

// Rust: crates/jet-codegen/src/Codegen/MIRWeb.rs:6641
fn emit_js_terminator(out: &String, function: MirFunction, block: MirBasicBlock) MirWebError! {
    if block.terminator == {
        .Jump(target) | .Continue(target) -> &out.push_str("        __jet_pred = __jet_block; __jet_block = {target.0}; continue;\n")
        .Branch(condition, then_target, else_target) -> &out.push_str("        __jet_pred = __jet_block; __jet_block = Boolean(__jet_values.get({condition.0})) ? {then_target.0} : {else_target.0}; continue;\n")
        .Switch(subject, arms, otherwise) -> {
            &out.push_str("        __jet_pred = __jet_block; const __jet_subject = __jet_values.get({subject.0}); __jet_block = ")
            loop arm in arms -> &out.push_str("__jet_subject === __jet_values.get({arm.condition.0}) ? {arm.target.0} : ")
            &out.push_str("{otherwise.0}; continue;\n")
        }
        .Return(value) -> {
            if returned :: value -> &out.push_str("        return {js_return_expression(function, returned)};\n") else -> &out.push_str("        return undefined;\n")
        }
        .Yield(value, resume, _) -> {
            generator :: function.generator ?? fail MirWebError.InvalidMir{message: "MIR function {function.id.0} has a Yield terminator without generator facts"}
            value_declaration :: function.values.find(fn(row) -> row.0 == value) ?? fail MirWebError.InvalidMir{message: "MIR yield value {value.0} is missing from value declarations"}
            if value_declaration.1 != generator.item -> fail MirWebError.InvalidMir{message: "MIR generator {function.id.0} yields a value with the wrong type"}
            &out.push_str("        yield __jet_values.get({value.0}); __jet_pred = __jet_block; __jet_block = {resume.0}; continue;\n")
        }
        .Break(target, value) -> {
            if broken :: value -> &out.push_str("        __jet_break_value = __jet_values.get({broken.0});\n")
            &out.push_str("        __jet_pred = __jet_block; __jet_block = {target.0}; continue;\n")
        }
        .Unreachable(reason) -> &out.push_str("        throw new Error({js_string(reason)});\n")
    }
}
// Rust: crates/jet-codegen/src/Codegen/MIRWeb.rs:6737
fn js_return_expression(function: MirFunction, value: MirValueId) -> String Never! {
    expression :: "__jet_values.get({value.0})"
    if function.return_type.kind() == .Option(_) -> "jet_clean_option({expression})" else -> expression
}

// Rust: crates/jet-codegen/src/Codegen/MIRWeb.rs:6747
fn js_optional_string(value: String?) -> String Never! { if text :: value -> js_string(text) else -> "null" }
// Rust: crates/jet-codegen/src/Codegen/MIRWeb.rs:6751
fn js_route_field(field: AppRouteField) -> String Never! {
    default :: js_optional_string(field.default)
    "Object.freeze({{ name: {js_string(field.name)}, ty: {js_string(field.ty)}, codec: {js_string(field.codec)}, required: {field.required}, default: {default} }})"
}
// Rust: crates/jet-codegen/src/Codegen/MIRWeb.rs:6767
fn js_route_fields(fields: [AppRouteField]) -> String Never! {
    rendered :: (loop field in fields -> js_route_field(field)).join(", ")
    "Object.freeze([{rendered}])"
}
// Rust: crates/jet-codegen/src/Codegen/MIRWeb.rs:6772
fn js_route_loader(loader: AppRouteLoader?) -> String Never! {
    value :: loader ?? return "null"
    "Object.freeze({{ handler: {js_string(value.handler)}, data_type: {js_string(value.data_type)}, dependency: {js_string(value.dependency)}, preload: {value.preload}, cache_identity: {js_string(value.cache_identity)} }})"
}
// Rust: crates/jet-codegen/src/Codegen/MIRWeb.rs:6786
fn js_route_boundaries(boundaries: AppRouteBoundaries) -> String Never! {
    "Object.freeze({{ pending: {js_optional_string(boundaries.pending)}, not_found: {js_optional_string(boundaries.not_found)}, error: {js_optional_string(boundaries.error)} }})"
}
// Rust: crates/jet-codegen/src/Codegen/MIRWeb.rs:6795
fn js_route_island(island: AppIslandFact?) -> String Never! {
    value :: island ?? return "null"
    captures :: (loop capture in value.resume_payload.captures -> "Object.freeze({{ name: {js_string(capture.name)}, ty: {js_string(capture.ty)}, serializable: {capture.serializable} }})").join(", ")
    "Object.freeze({{ identity: {js_string(value.identity)}, hydration_trigger: {js_string(value.hydration_trigger.as_str())}, resume_payload: Object.freeze({{ captures: Object.freeze([{captures}]), serializable: {value.resume_payload.serializable} }}) }})"
}
// Rust: crates/jet-codegen/src/Codegen/MIRWeb.rs:6822
fn js_route_render_facts(facts: AppRenderFacts) -> String Never! {
    override_mode :: if mode :: facts.override_mode -> js_string(mode.as_str()) else -> "null"
    pending_boundary_id :: if id :: facts.pending_boundary_id -> id.get().to_string() else -> "null"
    "Object.freeze({{ mode: {js_string(facts.mode.as_str())}, reason: Object.freeze({json_string_list(facts.reason)}), effects: Object.freeze({json_string_list(facts.effects)}), interactive: {facts.interactive}, loader: {js_optional_string(facts.loader)}, form: {js_optional_string(facts.form)}, cache: {js_string(facts.cache.as_str())}, override_mode: {override_mode}, pending_boundary_id: {pending_boundary_id}, island: {js_route_island(facts.island)} }})"
}
// Rust: crates/jet-codegen/src/Codegen/MIRWeb.rs:6844
fn js_route_projection(route: AppRoute) -> String Never! {
    "Object.freeze({{ path: {js_string(route.path)}, handler: {js_string(route.handler)}, provenance: {js_string(route.provenance)}, route_identity: {js_string(route.route_identity)}, path_params: {js_route_fields(route.path_params)}, search_params: {js_route_fields(route.search_params)}, search_codec: {js_string(route.search_codec)}, loader: {js_route_loader(route.loader)}, boundaries: {js_route_boundaries(route.boundaries)}, precedence: {js_string(route.precedence)}, render_facts: {js_route_render_facts(route.render_facts)} }})"
}
// Rust: crates/jet-codegen/src/Codegen/MIRWeb.rs:6860
fn js_action_projection(action: AppAction) -> String Never! {
    "Object.freeze({{ name: {js_string(action.name)}, handler: {js_string(action.handler)}, kind: {js_string(action.kind)}, preload: {action.preload}, input: {js_string(action.input_type)}, output: {js_string(action.output_type)}, error: {js_string(action.error_type)}, endpoint: {js_string(action.endpoint)}, method: {js_string(action.method)}, csrf: {js_string(action.csrf)}, effects: {json_string_list(action.effects)}, middleware: {json_string_list(action.middleware)}, provenance: {js_string(action.provenance)} }})"
}

// Rust: crates/jet-codegen/src/Codegen/MIRWeb.rs:6880
fn emit_js_routes(out: &String, program: MirProgram) Never! {
    if graph :: program.facts.web_app {
        &out.push_str("export const jet_app_graph = Object.freeze(")
        &out.push_str(graph.to_json())
        &out.push_str(");\nexport const jet_routes = Object.freeze({{\n")
        loop route in graph.routes -> &out.push_str("  {js_string(route.path)}: {js_route_projection(route)},\n")
        &out.push_str("}});\nexport const jet_actions = Object.freeze([\n")
        loop action in graph.actions -> &out.push_str("  {js_action_projection(action)},\n")
        &out.push_str("]);\n")
    } else {
        &out.push_str("export const jet_app_graph = null;\nexport const jet_routes = Object.freeze({{}});\nexport const jet_actions = Object.freeze([]);\n")
    }
    &out.push_str("globalThis.__jetAppGraph = jet_app_graph;\n")
    &out.push_str("\n// The browser adapter consumes this checked graph and delegates route\n// matching/data production to the native server graph.\nexport const jet_web_app = jetDom.createWebApp({{ graph: jet_app_graph, routes: jet_routes, actions: jet_actions }});\nexport function jet_bootstrap_web(options = {{}}) {{\n  return jetDom.bootstrapWebApp(jet_web_app, options);\n}}\nexport const jet_web_bootstrap = jet_bootstrap_web;\nif (typeof document !== \"undefined\" && jet_app_graph !== null\n    && !globalThis.__jetWebDisableAutoBootstrap\n    && document.getElementById(\"jet-route-data\")) {{\n  queueMicrotask(() => {{\n    if (!globalThis.__jetWebApp) jet_bootstrap_web();\n  }});\n}}\n")
}

// Rust: crates/jet-codegen/src/Codegen/MIRWeb.rs:6933
fn manifest_partitions(functions: [MirFunction]) -> [String:WebBucket] MirWebError! {
    partitions := [String:WebBucket]{}
    loop function in functions {
        if !function.target_applicability.web -> next
        bucket :: function.web_bucket ?? fail MirWebError.InvalidMir{message: "manifest function {function.id.0} is Web-applicable but has no checked Web bucket"}
        if partitions.contains_key(function.key) -> fail MirWebError.InvalidMir{message: "manifest contains duplicate Web function key `{function.key}`"}
        partitions[function.key] = bucket
    }
    partitions
}

// Rust: crates/jet-codegen/src/Codegen/MIRWeb.rs:6961
fn emit_manifest(program: MirProgram, target: MirWebTarget, functions: [MirFunction], artifact: MirArtifactPlan, entry: MirFunctionId, artifact_identity: String) -> String MirWebError! {
    out := "{{\n  \"schema\": \"mir-web-v1\",\n"
    partitions :: manifest_partitions(functions)!
    &out.push_str("  \"status\": \"m2\",\n  \"partitions\": {{\n")
    keys := partitions.keys().collect()
    &keys.sort()
    loop (index, key) in keys {
        if index != 0 -> &out.push_str(",\n")
        &out.push_str("    {json_string(key)}: {optional_web_bucket(Val(partitions[key]))}")
    }
    &out.push_str("\n  }},\n  \"package\": {json_string(program.package_identity)},\n")
    // GATE #4483: target facts belong to the selected Web artifact layout.
    &out.push_str("  \"target\": {{ \"triple\": {json_string(target.layout.triple)}, \"pointer_size\": {target.layout.pointer_size}, \"pointer_alignment\": {target.layout.pointer_alignment} }},\n")
    &out.push_str("  \"artifact_id\": {artifact.id.0},\n  \"entry\": {entry.0},\n  \"functions\": [\n")
    sorted_functions := functions
    &sorted_functions.sort_by_key(fn(function) -> function.id)
    loop (index, function) in sorted_functions {
        if index != 0 -> &out.push_str(",\n")
        generic_params :: json_generic_params(function.generic_params, program)!
        &out.push_str("    {{ \"id\": {function.id.0}, \"key\": {json_string(function.key)}, \"module\": {json_string(function.module)}, \"name\": {json_string(function.name)}, \"kind\": {json_string(function_kind_descriptor(function.kind))}, \"visibility\": {json_string(visibility_descriptor(function.visibility))}, \"web_bucket\": {optional_web_bucket(function.web_bucket)}, \"web_marker\": {optional_web_marker(function.web_marker)}, \"target_applicability\": {{ \"web\": {function.target_applicability.web} }}, \"wasm_export\": {is_wasm_export(function)}, \"generic_params\": {generic_params}, \"web_param_reconstructions\": {json_reconstructions(function.web_param_reconstructions)} }}")
    }
    &out.push_str("\n  ],\n  \"core_calls\": [\n")
    core_calls := loop call in program.core_calls -> @call
    &core_calls.sort_by_key(fn(call) -> call.id)
    loop (index, call) in core_calls {
        if index != 0 -> &out.push_str(",\n")
        &out.push_str("    {{ \"id\": {call.id.0}, \"key\": {json_string(call.key)}, \"symbol\": {json_string(core_symbol(call.symbol))}, \"arity\": {call.arity}, \"max_arity\": {call.max_arity}, \"fallibility\": {json_string(core_call_fallibility_descriptor(call.fallibility))}, \"effect\": {optional_effect_descriptor(call.effect)}, \"pure_route\": {json_string(core_call_pure_route_descriptor(call.pure_route))}, \"interpreter_route\": {json_string(core_call_interpreter_route_descriptor(call.interpreter_route))} }}")
    }
    &out.push_str("\n  ],\n  \"prelude_calls\": [\n")
    prelude_calls := loop call in program.prelude_calls -> @call
    &prelude_calls.sort_by_key(fn(call) -> call.id)
    loop (index, call) in prelude_calls {
        if index != 0 -> &out.push_str(",\n")
        &out.push_str("    {{ \"id\": {call.id.0}, \"module\": {json_string(call.module)}, \"member\": {json_string(call.member)}, \"family\": {json_string(prelude_family_descriptor(call.family))}, \"symbol\": {json_string(call.symbol.name())}, \"abi\": {json_string(prelude_abi_descriptor(call.abi))}, \"arity\": {call.signature.arity}, \"max_arity\": {call.signature.max_arity} }}")
    }
    &out.push_str("\n  ],\n  \"types\": [\n")
    loop (index, type_def) in program.types {
        if index != 0 -> &out.push_str(",\n")
        generic_params :: json_generic_params(type_def.generic_params, program)!
        &out.push_str("    {{ \"id\": {type_def.id.0}, \"key\": {json_string(type_def.key)}, \"name\": {json_string(type_def.name)}, \"kind\": {json_string(type_def_kind_descriptor(type_def.kind))}, \"generic_params\": {generic_params} }}")
    }
    &out.push_str("\n  ],\n  \"modules\": {json_modules(program)}")
    &out.push_str(",\n  \"imports\": {json_imports(program)}")
    &out.push_str(",\n  \"traits\": {json_traits(program)}")
    &out.push_str(",\n  \"impls\": {json_impls(program)}")
    &out.push_str(",\n  \"constants\": {json_constants(program)}")
    &out.push_str(",\n  \"jobs\": {json_jobs(program)}")
    &out.push_str(",\n  \"harnesses\": {json_harnesses(program)}")
    artifacts :: json_artifacts(program, artifact.id, artifact_identity)!
    &out.push_str(",\n  \"artifacts\": {artifacts}")
    artifact_json :: json_artifact(artifact, program, artifact_identity)!
    &out.push_str(",\n  \"artifact\": {artifact_json}")
    entry_spec :: json_entry_spec(artifact.entry, program)!
    &out.push_str(",\n  \"entry_spec\": {entry_spec}")
    &out.push_str(",\n  \"app\": ")
    if graph :: program.facts.web_app -> &out.push_str(graph.to_json()) else -> &out.push_str("null")
    &out.push_str("\n}}\n")
    out
}
