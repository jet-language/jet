use jet_foundation.[AppAction, AppIslandFact, AppRenderFacts, AppRoute, AppRouteBoundaries, AppRouteField, AppRouteLoader, CoreCallSymbol, Effect, HistoryProvenance, MirAccess, MirArtifactPlan, MirBasicBlock, MirCallArg, MirCallee, MirCaptureOperand, MirCoreCall, MirCoreCallId, MirFunction, MirFunctionForm, MirFunctionId, MirOwnershipMode, MirPreludeCallId, MirProgram, MirSymbol, MirTerminator, MirType, MirTypeDefKind, MirTypeKind, MirValueId, MirVariantPayload, WebBucket, sha256_hex]

// Private extension of Codegen.MIRWeb: helpers and error/target carriers are
// supplied by its preceding/following packet fragments, not a second backend.

// Rust: crates/jet-codegen/src/Codegen/MIRWeb.rs:5241
fn js_call_expression(program: MirProgram, caller: MirFunction, callee: MirCallee, args: [MirCallArg], type_args: [MirType], history_provenance: HistoryProvenance) -> String MirWebError! {
    validate_type_args(program, type_args)!
    if callee == {
        .User(id) -> {
            function :: program.functions.find(fn(f) -> f.id == id) ?? fail MirWebError.MissingUserFunction{function: id.0}
            values :: js_call_values(program, caller, args, !is_wasm_export(function))!
            if is_wasm_export(function) -> return js_wasm_export_call(function, caller, args, values)!
            if !function.target_applicability.web || !function_in_bucket(function, WebBucket.JS) -> fail MirWebError.MissingUserFunction{function: id.0}
            call :: "jet_fn_{id.0}([], [{values.join(", ")}])"
            if function.generator == None && web_function_is_async(program, id) -> "await {call}" else -> call
        }
        .Associated(id, owner) -> {
            validate_type_args(program, [owner])!
            function :: program.functions.find(fn(f) -> f.id == id) ?? fail MirWebError.MissingUserFunction{function: id.0}
            values :: js_call_values(program, caller, args, !is_wasm_export(function))!
            if is_wasm_export(function) -> return js_wasm_export_call(function, caller, args, values)!
            if !function.target_applicability.web || !function_in_bucket(function, WebBucket.JS) -> fail MirWebError.MissingUserFunction{function: id.0}
            valid := false
            if function.form == {
                .Method(declared_owner, self_access) -> valid = self_access == None && declared_owner.same_checked_type(owner)
                .TraitMethod(declared_owner, self_access, trait_ref, _) -> valid = self_access == None && declared_owner.same_checked_type(owner) && program.traits.any(fn(row) -> row.id == trait_ref.id)
                .TopLevel -> fail MirWebError.InvalidMir{message: "MIR associated call {id.0} does not target an inherent or trait method"}
            }
            if !valid -> fail MirWebError.InvalidMir{message: "MIR associated call {id.0} does not target a declared static method"}
            call :: "jet_fn_{id.0}([], [{values.join(", ")}])"
            if function.generator == None && web_function_is_async(program, id) -> "await {call}" else -> call
        }
        .Method(id, owner) -> {
            validate_type_args(program, [owner])!
            function :: program.functions.find(fn(f) -> f.id == id) ?? fail MirWebError.MissingUserFunction{function: id.0}
            values :: js_call_values(program, caller, args, !is_wasm_export(function))!
            if is_wasm_export(function) -> return js_wasm_export_call(function, caller, args, values)!
            if !function.target_applicability.web || !function_in_bucket(function, WebBucket.JS) -> fail MirWebError.MissingUserFunction{function: id.0}
            expected_access := None as MirAccess?
            if function.form == {
                .Method(declared_owner, access) -> { if declared_owner.same_checked_type(owner) -> expected_access = access }
                .TraitMethod(declared_owner, access, trait_ref, _) -> { if declared_owner.same_checked_type(owner) && program.traits.any(fn(row) -> row.id == trait_ref.id) -> expected_access = access }
                .TopLevel -> fail MirWebError.InvalidMir{message: "MIR method call {id.0} does not target an inherent or trait method"}
            }
            access :: expected_access ?? fail MirWebError.InvalidMir{message: "MIR method call {id.0} owner/access disagrees with its declaration"}
            receiver :: args.first() ?? fail MirWebError.InvalidMir{message: "MIR method call {id.0} has no receiver argument"}
            if receiver.access != access -> fail MirWebError.InvalidMir{message: "MIR method call {id.0} receiver access {receiver.access:?} disagrees with declaration {access:?}"}
            call :: "jet_fn_{id.0}([], [{values.join(", ")}])"
            if function.generator == None && web_function_is_async(program, id) -> "await {call}" else -> call
        }
        .TraitMethod(method, trait_ref, _) -> {
            values :: js_call_values(program, caller, args, true)!
            receiver_value :: values.first() ?? fail MirWebError.InvalidMir{message: "MIR trait method call {method.0} has no receiver argument"}
            (targets, default) :: web_trait_method_targets(program, method, trait_ref)!
            receiver_args := values
            receiver_args[0] = "__jet_receiver"
            rendered_args :: receiver_args.join(", ")
            dispatch := ""
            is_async := false
            if default_id :: default {
                function :: program.functions.find(fn(f) -> f.id == default_id) ?? fail MirWebError.MissingUserFunction{function: default_id.0}
                if !function.target_applicability.web || !function_in_bucket(function, WebBucket.JS) -> fail MirWebError.MissingUserFunction{function: default_id.0}
                dispatch = "jet_fn_{default_id.0}([], [{rendered_args}])"
                is_async = function.generator == None && web_function_is_async(program, function.id)
            } else {
                message :: js_string("no implementation for trait method {method.0}")
                dispatch = "(() => {{ throw new Error({message}) }})()"
            }
            loop (type_id, function_id) in targets.iter().rev() {
                function :: program.functions.find(fn(f) -> f.id == function_id) ?? fail MirWebError.MissingUserFunction{function: function_id.0}
                if !function.target_applicability.web || !function_in_bucket(function, WebBucket.JS) -> fail MirWebError.MissingUserFunction{function: function_id.0}
                is_async = is_async || (function.generator == None && web_function_is_async(program, function_id))
                call :: "jet_fn_{function_id.0}([], [{rendered_args}])"
                dispatch = "__jet_receiver?.__jet_type === {js_string(type_id.0.to_string())} ? {call} : {dispatch}"
            }
            expression :: "((__jet_receiver) => ({dispatch}))({receiver_value})"
            if caller.generator == None && is_async -> "await ({expression})" else -> expression
        }
        .Core(id) -> js_core_call_expression(program, caller, id, None, args, type_args, history_provenance)!
        .Prelude(id) -> {
            values :: js_call_values(program, caller, args, false)!
            js_prelude_call_expression(program, id, values)!
        }
        .Foreign(id) -> {
            foreign :: program.foreign.find(fn(f) -> f.id == id) ?? fail MirWebError.InvalidMir{message: "MIR foreign function {id.0} is missing"}
            abi :: foreign_abi_name(foreign.foreign_abi)
            fail MirWebError.InvalidMir{message: "MIR Web JS-partition call references foreign row {foreign.id.0} at {foreign.span:?} (symbol `{foreign.symbol}` path `{foreign.path}` ABI `{abi}` language {foreign.foreign_language:?} applicability rust_aot={foreign.target_applicability.rust_aot} cranelift={foreign.target_applicability.cranelift} interpreter={foreign.target_applicability.interpreter} web={foreign.target_applicability.web}); no checked JavaScript linkage exists"}
        }
        .Indirect(id) -> {
            values :: js_call_values(program, caller, args, true)!
            "__jet_values.get({id.0})({values.join(", ")})"
        }
    }
}

// Rust: crates/jet-codegen/src/Codegen/MIRWeb.rs:5481
fn js_closure_expression(program: MirProgram, enclosing: MirFunction, function_id: MirFunctionId, captures: [MirCaptureOperand], history_provenance: HistoryProvenance) -> String MirWebError! {
    function :: program.functions.find(fn(f) -> f.id == function_id) ?? fail MirWebError.MissingUserFunction{function: function_id.0}
    if !function.target_applicability.web || !function_in_bucket(function, WebBucket.JS) -> fail MirWebError.MissingUserFunction{function: function_id.0}
    if function.capture_params.len() != captures.len() -> fail MirWebError.InvalidMir{message: "MIR closure for function {function_id.0} has {captures.len()} captures, expected {function.capture_params.len()}"}
    validate_capture_params(program, function)!
    values := [String]{}
    loop (slot, operand) in captures {
        capture :: function.capture_params[slot]
        value :: if operand == {
            .Value(value) -> {
                if capture.access == MirAccess.Move {
                    js_move_value_expression(value)
                } else if capture.ownership.mode == MirOwnershipMode.Owned {
                    "{{ value: {js_move_value_expression(value)} }}"
                } else {
                    fail MirWebError.InvalidMir{message: "MIR closure capture slot {slot} passes a value for {capture.access:?} access"}
                }
            }
            .Place(place) -> {
                if capture.access == MirAccess.Move -> fail MirWebError.InvalidMir{message: "MIR closure capture slot {slot} passes a place for Move access"}
                js_place_cell_expression(program, enclosing, place)!
            }
        }
        &values.push(value)
    }
    schemas := [String:String]{}
    capture_values := [String]{}
    loop capture in function.capture_params {
        schema :: js_history_capture_schema(program, capture.ty, [:], &schemas)
        slot :: capture.slot
        value :: if capture.access == MirAccess.Move -> "captured[{slot}]" else -> "captured[{slot}].value"
        &capture_values.push("jet_testing_history_web_capture({value}, {js_string(schema)}, types, active)")
    }
    schema_keys := schemas.keys().collect()
    &schema_keys.sort()
    rendered_schemas :: (loop key in schema_keys -> "[{js_string(key)}, {schemas[key]}]").join(", ")
    identity :: sha256_hex("{history_provenance.source}:function:{function_id.0}".bytes())
    "((captured, types) => jet_testing_history_web_callable((...args) => jet_fn_{function_id.0}(captured, args), {js_string(identity)}, active => [{capture_values.join(", ")}]))([{values.join(", ")}], new Map([{rendered_schemas}]))"
}

// Rust: crates/jet-codegen/src/Codegen/MIRWeb.rs:5566
fn js_prelude_call_expression(program: MirProgram, id: MirPreludeCallId, args: [String]) -> String MirWebError! {
    row :: program.prelude_calls.find(fn(call) -> call.id == id) ?? fail MirWebError.MissingPreludeCall{call: id.0}
    if row.symbol == .Prelude(name) && name == "jet_transaction_commit" {
        transaction :: args.first() ?? fail MirWebError.InvalidMir{message: "Web transaction commit is missing its handle"}
        return "await ({transaction}).commit()"
    }
    symbol :: js_symbol_expression(row.symbol)!
    "{symbol}({args.join(", ")})"
}

// Rust: crates/jet-codegen/src/Codegen/MIRWeb.rs:5589
fn web_data_symbol_name(name: String) -> Bool Never! {
    if name == {
        "jet_data_count" | "jet_data_query" | "jet_data_track" | "jet_data_query_tracked"
        | "jet_data_track_insert" | "jet_data_track_replace" | "jet_data_track_remove"
        | "jet_data_load" | "jet_data_loader_load" | "jet_data_loader_load_default"
        | "jet_data_loader_file" | "jet_data_loader_file_member" | "jet_data_loader_url"
        | "jet_data_loader_database" | "jet_data_loader_value" | "jet_data_loader_snapshot"
        | "jet_data_loader_bind" | "jet_data_loader_bind_text" | "jet_data_loader_cancel"
        | "jet_data_loader_offline" | "jet_data_loader_invalidate" | "jet_data_loader_needs_refresh"
        | "jet_data_loader_ready" | "jet_data_loader_status" | "jet_data_loader_source_identity"
        | "jet_data_loader_authority_of" | "jet_data_snapshot_reusable" | "jet_data_loader_stream"
        | "jet_data_stream_next" | "jet_data_stream_collect" | "jet_data_stream_cancel"
        | "jet_data_query_plan" | "jet_data_query_collect" | "jet_data_query_sort_by"
        | "jet_data_left_join_checked_default" | "jet_data_inner_join_checked_default"
        | "jet_data_query_filter" | "jet_data_query_map" | "jet_data_query_min" | "jet_data_query_max"
        | "jet_data_query_inner_join" | "jet_data_query_left_join" | "jet_data_query_group_by"
        | "jet_data_query_watch" | "jet_data_watch_get" | "jet_data_watch_status" | "jet_data_watch_cancel"
        | "jet_data_group_count_query" | "jet_data_group_sum_query" | "jet_data_group_mean_query"
        | "jet_data_status" | "jet_data_require_bridge" | "jet_data_csv_reader" | "jet_data_json_reader" -> true
        else -> name.starts_with("jet_data.loader.")
    }
}

// Rust: crates/jet-codegen/src/Codegen/MIRWeb.rs:5649
fn js_data_call_expression(program: MirProgram, symbol: MirSymbol, values: [String], type_args: [MirType]) -> String MirWebError! {
    name :: if symbol == {
        .Prelude(name) -> name
        .Runtime(_) -> fail MirWebError.InvalidMir{message: "Web data bridge requires a Prelude symbol"}
    }
    if !web_data_symbol_name(name) -> fail MirWebError.InvalidMir{message: "MIR Web data symbol {name:?} has no data bridge binding"}
    local :: js_symbol_expression(symbol)!
    descriptors :: (loop ty in type_args -> js_string(type_descriptor(ty))).join(", ")
    args := values.join(", ")
    if !args.is_empty() -> &args.push_str(", ")
    &args.push_str("[{descriptors}]")
    _ :: program
    "{local}({args})"
}

// Rust: crates/jet-codegen/src/Codegen/MIRWeb.rs:5686
fn js_world_effect_guard(core: MirCoreCall) -> String? Never! {
    effect :: core.effect ?? return None
    controlled :: if effect == {
        .Time -> core.module == "core.time" && core.member != "start"
        .Rand -> core.module != "core.crypto.random"
        else -> false
    }
    if controlled -> None else -> Val("jet_world_reject_uncontrolled_effect({js_string(effect.name())})")
}
// Rust: crates/jet-codegen/src/Codegen/MIRWeb.rs:5707
fn js_guard_core_expression(core: MirCoreCall, expression: String) -> String Never! {
    if guard :: js_world_effect_guard(core) -> "({guard}, {expression})" else -> expression
}
// Rust: crates/jet-codegen/src/Codegen/MIRWeb.rs:5717
fn js_history_absent_schema(schemas: &[String:String]) -> String Never! {
    key :: "jet.absent"
    if !schemas.contains_key(key) -> schemas[key] = "{{ type: {js_string(key)}, kind: \"absent\" }}"
    key
}

// Rust: crates/jet-codegen/src/Codegen/MIRWeb.rs:5727
fn js_history_capture_schema(program: MirProgram, ty: MirType, bindings: [String:String], schemas: &[String:String]) -> String Never! {
    if ty.kind() == .Apply(name, args) && args.is_empty() {
        if schema :: bindings.get(name.name) -> return schema
    }
    key := type_descriptor(ty)
    if ty.kind() == .Tagged(marker, _) -> &key.push_str(";tag={marker}")
    if !bindings.is_empty() {
        keys := bindings.keys().collect()
        &keys.sort()
        &key.push_str(";bindings=")
        loop name in keys { value :: bindings[name]; &key.push_str("{name.len()}:{name}{value.len()}:{value}") }
    }
    if schemas.contains_key(key) -> return key
    schemas[key] = "{{ kind: \"opaque\" }}"
    child :: fn(child_ty: MirType, nested_schemas: &[String:String]) -> String Never! { js_string(js_history_capture_schema(program, child_ty, bindings, &nested_schemas)) }
    is_handle :: program.handles.any(fn(handle) -> handle.ty.same_checked_type(ty) || (handle.ty.nominal_name() == ty.nominal_name() && ty.nominal_name() != None))
    shape := "kind: \"opaque\""
    if is_handle {
        shape = "kind: \"opaque\""
    } else if ty.is_unit() {
        shape = "kind: \"unit\""
    } else {
        if ty.kind() == {
            .Int | .IntN(_, _) -> shape = "kind: \"integer\""
            .Float | .Float32 -> shape = "kind: \"float\""
            .Bool -> shape = "kind: \"boolean\""
            .String | .Char -> shape = "kind: \"text\""
            .Fn(_) | .SendFn(_, _) -> shape = "kind: \"callable\""
            .List(inner) | .FixedList(inner, _) -> shape = "kind: \"list\", item: {child(inner, &schemas)}"
            .Map(map_key, value) -> shape = "kind: \"map\", key: {child(map_key, &schemas)}, value: {child(value, &schemas)}"
            .Option(inner) -> {
                absent :: js_history_absent_schema(&schemas)
                shape = "kind: \"enum\", clean: true, variants: [[\"Err\", [{js_string(absent)}]], [\"Ok\", [{child(inner, &schemas)}]]]"
            }
            .Result(ok, err) -> shape = "kind: \"enum\", variants: [[\"Ok\", [{child(ok, &schemas)}]], [\"Err\", [{child(err, &schemas)}]]]"
            .Shared(inner) -> shape = "kind: \"shared\", inner: {child(inner, &schemas)}"
            .InlineRange(base, _, _) | .Quantity(_, base, _, _) -> shape = "kind: \"transparent\", inner: {child(base, &schemas)}"
            .Tagged(marker, inner) -> {
                marker_text :: marker.to_string()
                if marker_text == "expiring_secret.loan" || marker_text == "core.crypto" || marker_text.rsplit("::").next() == Val("Secret") -> shape = "kind: \"opaque\"" else -> shape = "kind: \"transparent\", inner: {child(inner, &schemas)}"
            }
            .Tuple(fields) -> {
                rendered := [String]{}
                loop (name, field_ty) in fields -> &rendered.push("[{js_string(name)}, {child(field_ty, &schemas)}]")
                shape = "kind: \"record\", fields: [{rendered.join(", ")}]"
            }
            .Apply(_, _) | .Union(_) -> {
                nominal := None
                args := [MirType]{}
                if ty.kind() == .Apply(name, arguments) { nominal = Val(name); args = arguments }
                leaf :: if name :: nominal -> name.name.rsplit("::").next() ?? name.name else -> ""
                if leaf == {
                    "Secret" | "ExpiringSecret" | "HistoryRNG" | "Ptr" -> shape = "kind: \"opaque\""
                    "Bytes" -> shape = "kind: \"bytes\""
                    "BigInt" -> shape = "kind: \"integer\""
                    "DataTree" -> shape = "kind: \"data\""
                    else -> {
                        definition_option := program.types.find(fn(row) -> Val(row.id) == ty.identity)
                        if definition_option == None {
                            if name :: nominal -> definition_option = program.types.find(fn(row) -> row.id == name.id)
                        }
                        if definition :: definition_option {
                            field_bindings := bindings
                            loop (index, parameter) in definition.generic_params {
                                if index >= args.len() -> break
                                field_bindings[parameter.name] = js_history_capture_schema(program, args[index], bindings, &schemas)
                            }
                            field_type :: fn(field_ty: MirType, nested_schemas: &[String:String]) -> String Never! { js_string(js_history_capture_schema(program, field_ty, field_bindings, &nested_schemas)) }
                            if definition.kind == {
                                .Struct(fields, _) -> {
                                    if !fields.any(fn(field) -> field.skip) {
                                        rendered := [String]{}
                                        loop field in fields { if !field.computed -> &rendered.push("[{js_string(field.name)}, {field_type(field.ty, &schemas)}]") }
                                        shape = "kind: \"record\", fields: [{rendered.join(", ")}]"
                                    }
                                }
                                .Enum(variants, _) -> {
                                    rendered := [String]{}
                                    loop variant in variants {
                                        fields := [String]{}
                                        if variant.payload == {
                                            .Unit -> {}
                                            .Single(payload_ty) -> &fields.push(field_type(payload_ty, &schemas))
                                            .Named(payload_fields) -> loop field in payload_fields -> &fields.push(if field.skip -> "null" else -> field_type(field.ty, &schemas))
                                        }
                                        &rendered.push("[{js_string(variant.name)}, [{fields.join(", ")}]]")
                                    }
                                    shape = "kind: \"enum\", variants: [{rendered.join(", ")}]"
                                }
                                .Distinct(base, _) | .Alias(base) -> shape = "kind: \"transparent\", inner: {field_type(base, &schemas)}"
                                else -> {}
                            }
                        }
                    }
                }
            }
            else -> {}
        }
    }
    schemas[key] = "{{ type: {js_string(key)}, {shape} }}"
    key
}

// Rust: crates/jet-codegen/src/Codegen/MIRWeb.rs:5871
fn emit_js_copy_type_facts(out: &String, program: MirProgram) Never! {
    schemas := [String:String]{}
    loop ty in program.type_instances -> _ :: js_history_capture_schema(program, ty, [:], &schemas)
    loop function in program.functions {
        _ :: js_history_capture_schema(program, function.return_type, [:], &schemas)
        loop param in function.params -> _ :: js_history_capture_schema(program, param.ty, [:], &schemas)
        loop capture in function.capture_params -> _ :: js_history_capture_schema(program, capture.ty, [:], &schemas)
        loop (_, ty, _, _) in function.values -> _ :: js_history_capture_schema(program, ty, [:], &schemas)
        loop place in function.places -> _ :: js_history_capture_schema(program, place.ty, [:], &schemas)
    }
    loop handle in program.handles -> _ :: js_history_capture_schema(program, handle.ty, [:], &schemas)
    &out.push_str("const __jet_copy_type_facts = new Map([\n")
    keys := schemas.keys().collect()
    &keys.sort()
    loop key in keys -> &out.push_str("  [{js_string(key)}, {schemas[key]}],\n")
    &out.push_str("]);\n")
}
// Rust: crates/jet-codegen/src/Codegen/MIRWeb.rs:5902
fn js_copy_expression(program: MirProgram, ty: MirType, expression: String) -> String Never! {
    key :: js_copy_type_key(program, ty)
    "jet_copy_value({expression}, {js_string(key)}, __jet_copy_type_facts)"
}
// Rust: crates/jet-codegen/src/Codegen/MIRWeb.rs:5911
fn js_copy_type_key(program: MirProgram, ty: MirType) -> String Never! {
    schemas := [String:String]{}
    js_history_capture_schema(program, ty, [:], &schemas)
}

// Rust: crates/jet-codegen/src/Codegen/MIRWeb.rs:5916
fn js_core_call_expression(program: MirProgram, caller: MirFunction, id: MirCoreCallId, route: MirPreludeCallId?, args: [MirCallArg], type_args: [MirType], history_provenance: HistoryProvenance) -> String MirWebError! {
    core :: program.core_calls.find(fn(call) -> call.id == id) ?? fail MirWebError.MissingCoreCall{call: id.0}
    validate_type_args(program, type_args)!
    values :: js_call_values(program, caller, args, false)!
    if core.module == "core.testing" && core.member == "histories" {
        if type_args.len() != 1 -> fail MirWebError.InvalidMir{message: "MIR testing.histories requires exactly one checked Command type argument"}
        if values.len() != 6 -> fail MirWebError.InvalidMir{message: "MIR testing.histories has {values.len()} runtime arguments; expected six"}
        symbol :: if core.symbol == {
            .Prelude(name) -> js_symbol_expression(MirSymbol.Prelude(name))!
            .Rust(name) -> js_symbol_expression(MirSymbol.Runtime(name))!
        }
        command_descriptor :: js_string(type_descriptor(type_args[0]))
        provenance_descriptor :: "{{ source: {js_string(history_provenance.source)}, tool: {js_string(history_provenance.tool)}, target: {js_string(history_provenance.target)} }}"
        descriptor :: "{{ command_type: {command_descriptor}, provenance: {provenance_descriptor} }}"
        expression :: "{symbol}({values.join(", ")}, {descriptor})"
        return js_guard_core_expression(core, expression)
    }
    if selected_route :: route {
        if row :: program.prelude_calls.find(fn(call) -> call.id == selected_route) {
            if row.symbol == .Prelude(name) && web_data_symbol_name(name) -> return js_data_call_expression(program, row.symbol, values, type_args)!
        }
        expression :: js_prelude_call_expression(program, selected_route, values)!
        return js_guard_core_expression(core, expression)
    }
    if core.symbol == .Prelude(name) && web_data_symbol_name(name) -> return js_data_call_expression(program, MirSymbol.Prelude(name), values, type_args)!
    symbol :: if core.symbol == {
        .Prelude(name) -> js_symbol_expression(MirSymbol.Prelude(name))!
        .Rust(name) -> js_symbol_expression(MirSymbol.Runtime(name))!
    }
    js_guard_core_expression(core, "{symbol}({values.join(", ")})")
}

// Rust: crates/jet-codegen/src/Codegen/MIRWeb.rs:6009
// Closed checked Web linkage, not ambient JavaScript property lookup.
WEB_PRELUDE_LINKS :: [(String, String)]{
    ("jet_transaction_on_commit", "jet_transaction_on_commit"),
    ("jet_transaction_on_rollback", "jet_transaction_on_rollback"),
    ("jet_data_track", "jet_data_track"),
