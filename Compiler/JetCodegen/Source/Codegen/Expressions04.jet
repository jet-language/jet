//RS /// Lower `HandleMethod` arguments so every host-borrow callback is created
//RS /// immediately before the call that borrows it.
//RS ///
//RS /// The legality verifier requires a `HostBorrowCallback` result to be consumed
//RS /// by the very next instruction: the callback lends the host a checked
//RS /// callable for exactly one call, and nothing may sit between the borrow and
//RS /// that call.  App route/page/layout/loader rows carry a devtools binding text
//RS /// after the handler, so ordinary source-order lowering would interpose that
//RS /// constant.  Building a callback is side-effect free (a named function, a
//RS /// capture-free lambda, or a local read), so deferring it keeps the checked
//RS /// evaluation order of every other argument while the returned values keep
//RS /// their source positions.
//RS fn lower_handle_method_args(
//RS     ctx: &mut LowerCtx,
//RS     args: &[TExpr],
//RS ) -> Result<Vec<jet_foundation::MIR::MirValueId>, LowerError> {
//RS     let mut values = vec![None; args.len()];
//RS     for (index, arg) in args.iter().enumerate() {
//RS         if !is_host_borrow_callback(arg) {
//RS             values[index] = Some(ctx.lower_child(arg)?);
//RS         }
//RS     }
//RS     for (index, arg) in args.iter().enumerate() {
//RS         if is_host_borrow_callback(arg) {
//RS             values[index] = Some(ctx.lower_child(arg)?);
//RS         }
//RS     }
//RS     Ok(values.into_iter().flatten().collect())
//RS }
