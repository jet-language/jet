//RS /// One `?` site (written or automatic) on a failure's way out (#3713).
//RS #[derive(Clone, Copy)]
//RS struct TryJourneySite<'a> {
//RS     /// Pre-escaped source file, as `TExprKind::Try` carries it.
//RS     file: &'a str,
//RS     line: usize,
//RS     column: usize,
//RS     /// Pre-escaped enclosing function name.
//RS     fn_name: &'a str,
//RS     /// The operand is a Core call: its failure begins at this site, so any
//RS     /// journey left over from an earlier, handled failure is dropped first.
//RS     fresh_failure: bool,
//RS }
//RS 
//RS /// A Core call runs no program code of its own, so when it fails the failure
//RS /// starts at the call. A Core call that takes a callback can carry a failure
//RS /// out of program code, so it keeps the journey that callback started.
