// Private continuation of the canonical Expressions lowering owner.
use jet_foundation.AST.[Type, BinOp]
use jet_foundation.[CanonicalPass, Syntax]
use jet_foundation.MIR.*
use jet_codegen.Codegen.TIR.*
use jet_codegen.Codegen.TIR.TirToMirExpr.*
use jet_codegen.Codegen.TIR.TirToMirBuilder.LowerCtx

// Rust: crates/jet-codegen/src/Codegen/TIR/tir_to_mir_expr.rs:4584
fn record_lowered_expression(expr: &TExpr, value: &MirValueId) {
    if CanonicalPass.enabled() {
        CanonicalPass.record("lowering", "mir.lower-expression", "crates/jet-codegen/src/Codegen/TIR/tir_to_mir_expr.rs",
            "tir", canonical_expression_payload(expr), canonical_expression_identity(expr),
            "mir", CanonicalPass.debug_payload("mir", "mir.lower-expression", value),
            CanonicalPass.debug_identity("mir", "mir.lower-expression", value), "preserve")
    }
}
// Rust: crates/jet-codegen/src/Codegen/TIR/tir_to_mir_expr.rs:4601
fn lower_values(ctx: &LowerCtx, values: &[TExpr]) -> [MirValueId] LowerError! {
    out := [MirValueId].with_capacity(values.len())
    for value in values { out.push(ctx.lower_child(value)?) }
    Ok(^out)
}
// Rust: crates/jet-codegen/src/Codegen/TIR/tir_to_mir_expr.rs:4610
fn list_trait_coercion(ctx: &LowerCtx, ty: &Type) -> MirTypeId? LowerError! {
    element := if ty.without_user_tags() == { .List(element) | .FixedList{elem: element, ..} -> element.without_user_tags(); else -> return Ok(None) }
    trait_name := if element == {
        .TraitObject(names) if names.len() == 1 -> names.first().cloned()
        .Named(name) if ctx.is_trait_name(name) -> Val(name.clone())
        else -> None
    }
    name := trait_name ?? return Ok(None)
    target := Type.TraitObject([name])
    Ok(ctx.mir_type(target)?.identity)
}
// Rust: crates/jet-codegen/src/Codegen/TIR/tir_to_mir_expr.rs:4639
fn lower_handle_method_args(ctx: &LowerCtx, args: &[TExpr]) -> [MirValueId] LowerError! {
    values := [MirValueId?].filled(args.len(), None)
    for (index, arg) in args.iter().enumerate() {
        if !is_host_borrow_callback(arg) { values[index] = Val(ctx.lower_child(arg)?) }
    }
    for (index, arg) in args.iter().enumerate() {
        if is_host_borrow_callback(arg) { values[index] = Val(ctx.lower_child(arg)?) }
    }
    Ok(values.into_iter().flatten().collect())
}
// Rust: crates/jet-codegen/src/Codegen/TIR/tir_to_mir_expr.rs:4657
fn is_host_borrow_callback(arg: &TExpr) -> Bool {
    if arg.kind == {
        .HostBorrowCallback{..} -> true
        .FnValue{kind: .Send{value}} -> value.kind is .HostBorrowCallback{..}
        else -> false
    }
}
// Rust: crates/jet-codegen/src/Codegen/TIR/tir_to_mir_expr.rs:4667
fn lower_hardware_op(ctx: &LowerCtx, op: &THardwareCall) -> MirHardwareOp LowerError! {
    lowered := if op == {
        .RegisterRead{profile_id, block, register, width} -> MirHardwareOp.RegisterRead{profile_id: profile_id.clone(), block: block.clone(), register: register.clone(), width: width}
        .RegisterWrite{profile_id, block, register, width} -> MirHardwareOp.RegisterWrite{profile_id: profile_id.clone(), block: block.clone(), register: register.clone(), width: width}
        .DmaStart{profile_id, channel, buffer_ty} -> MirHardwareOp.DmaStart{profile_id: profile_id.clone(), channel: channel.clone(), buffer_ty: ctx.mir_type(buffer_ty)?}
        .DmaWait{profile_id, channel, buffer_ty} -> MirHardwareOp.DmaWait{profile_id: profile_id.clone(), channel: channel.clone(), buffer_ty: ctx.mir_type(buffer_ty)?}
    }
    Ok(^lowered)
}
// Rust: crates/jet-codegen/src/Codegen/TIR/tir_to_mir_expr.rs:4715
fn lower_mir_types(ctx: &LowerCtx, types: &[Type]) -> [MirType] LowerError! {
    out := [MirType].with_capacity(types.len())
    for ty in types { out.push(ctx.mir_type(ty)?) }
    Ok(^out)
}
// Rust: crates/jet-codegen/src/Codegen/TIR/tir_to_mir_expr.rs:4722
fn lower_require_stop(ctx: &LowerCtx, expr: &TExpr, kind: &TRequireKind, always_stops: Bool, loc: &TPanicLoc) -> MirValueId LowerError! {
    (kind, condition, values) := if kind == {
        .Require{cond, msg} -> {
            condition := ctx.lower_child(cond)?
            values := [MirValueId]{}
            if msg == Val(msg) { values.push(ctx.lower_child(msg)?) }
            (MirRequireKind.Require, Val(condition), ^values)
        }
        .RequireEq{left, right} -> {
            left_ty := ctx.mir_type(left.ty)?
            right_ty := ctx.mir_type(right.ty)?
            left := ctx.lower_child(left)?
            right := ctx.lower_child(right)?
            route := require_eq_condition_route(left_ty, right_ty)?
            call := ctx.intern_prelude_route(route)?
            condition := ctx.emit("require-eq-condition", Val(Type.Bool), MirOperation.Semantic(MirSemanticOp.StaticPreludeCall{
                call: call, args: [mir_value_arg(ctx, left), mir_value_arg(ctx, right)], owner_type_args: [], type_args: []}))?
            (MirRequireKind.RequireEq, Val(condition), [left, right])
        }
        .Panic{msg} -> (MirRequireKind.Panic, None, [ctx.lower_child(msg)?])
    }
    carrier := TFailureCarrier.from_checked_type(expr.ty)
    kind_key := if kind == { .Require -> "require"; .RequireEq -> "require_eq"; .Panic -> "panic" }
    call := ctx.intern_prelude_route(require_stop_route(kind_key, values.len(), expr.ty, carrier)?)?
    location := MirPanicLoc{file: ctx.source_file_id_for(loc.file), line: loc.line, column: loc.col}
    context := MirPanicContext{function: loc.fn_name.clone(), source_line: loc.src_line.clone(), caret: loc.caret,
        locals: loc.locals.iter().filter_map(fn(entry) { (name, local) := entry; ctx.local_id_for(local).ok().map(fn(id) { (name.clone(), id) }) }).collect()}
    // Stop edges run active closes before reporting, and never inspect moved locals.
    stop_cleanups := ctx.has_stop_path_cleanups()
    if stop_cleanups {
        moved := ctx.stop_path_moved_locals()
        context.locals.retain(fn(entry) { (_, local) := entry; !moved.contains(local) })
    }
    if !always_stops && stop_cleanups {
        if condition == Val(condition) {
            success := ctx.new_block(ctx.span(), "require.success")?
            failure := ctx.new_block(ctx.span(), "require.failure")?
            ctx.terminate(MirTerminator.Branch{condition: condition, then_target: success, else_target: failure})
            ctx.switch_to(failure)
            ctx.emit_stop_path_cleanups()?
            _ :: ctx.emit("require-stop", Val(expr.ty.clone()), MirOperation.Semantic(MirSemanticOp.RequireStop{
                call: call, kind: kind, condition: Val(condition), location: location, context: ^context, values: ^values, always_stops: true}))?
            ctx.terminate(MirTerminator.Unreachable{reason: "checked conditional stop"})
            ctx.switch_to(success)
            return ctx.emit("require-pass", Val(expr.ty.clone()), MirOperation.Constant(MirConstant.Unit))
        }
    }
    if always_stops && stop_cleanups { ctx.emit_stop_path_cleanups()? }
    value := ctx.emit("require-stop", Val(expr.ty.clone()), MirOperation.Semantic(MirSemanticOp.RequireStop{
        call: call, kind: kind, condition: condition, location: location, context: ^context, values: ^values, always_stops: always_stops}))?
    if always_stops { ctx.terminate(MirTerminator.Unreachable{reason: "checked unconditional stop"}) }
    Ok(value)
}
// Rust: crates/jet-codegen/src/Codegen/TIR/tir_to_mir_expr.rs:4860
fn lower_optional_field(ctx: &LowerCtx, expr: &TExpr, base: &TExpr, member: String, flatten: Bool) -> MirValueId LowerError! {
    inner_ty := if base.ty == { .Option(inner) -> inner; else -> return unsupported_expr(ctx, "TExprKind::OptField (non-optional base)") }
    field := ctx.field_id_for_type(inner_ty, member)?
    field_ty := ctx.checked_field_type(inner_ty, member).map_err(fn(_) { ctx.error(ctx.span(), "missing checked optional field `{member}`") })?
    subject := ctx.lower_child(base)?
    condition := ctx.emit("optional-field-condition", Val(Type.Bool), MirOperation.OptionIsSome{subject: subject})?
    present_block := ctx.new_block(ctx.span(), "optional-field-present")?
    absent_block := ctx.new_block(ctx.span(), "optional-field-absent")?
    join := ctx.new_block(ctx.span(), "optional-field-join")?
    ctx.terminate(MirTerminator.Branch{condition: condition, then_target: present_block, else_target: absent_block})
    incoming := [(MirBlockId, MirValueId)].with_capacity(2)
    ctx.switch_to(present_block)
    unwrapped := ctx.emit("optional-field-value", Val(inner_ty.clone()), MirOperation.OptionValue{subject: subject})?
    selected := ctx.emit("optional-field-member", Val(field_ty.clone()), MirOperation.Field{base: unwrapped, field: field})?
    present := if flatten -> selected else -> ctx.emit("optional-field-present-wrap", Val(expr.ty.clone()), MirOperation.Present{value: selected})?
    source := ctx.current_block()
    if !ctx.is_terminated() { ctx.terminate(MirTerminator.Jump{target: join}); incoming.push((source, present)) }
    ctx.switch_to(absent_block)
    absent := ctx.emit("optional-field-absent-value", Val(expr.ty.clone()), MirOperation.Absent)?
    source := ctx.current_block()
    if !ctx.is_terminated() { ctx.terminate(MirTerminator.Jump{target: join}); incoming.push((source, absent)) }
    if incoming.is_empty() -> return unsupported_expr(ctx, "TExprKind::OptField (no reachable branch)")
    ctx.switch_to(join)
    ctx.emit("optional-field-phi", Val(expr.ty.clone()), MirOperation.Phi{incoming: ^incoming})
}
// Rust: crates/jet-codegen/src/Codegen/TIR/tir_to_mir_expr.rs:4946
fn lower_option_lift2(ctx: &LowerCtx, expr: &TExpr, function: &TExpr, left: &TExpr, right: &TExpr) -> MirValueId LowerError! {
    if expr.ty.without_user_tags() != .Option(result_inner) -> return Err(ctx.error(ctx.span(), "checked Option.lift2 result is not optional"))
    if left.ty.without_user_tags() != .Option(left_inner) -> return Err(ctx.error(ctx.span(), "checked Option.lift2 left operand is not optional"))
    if right.ty.without_user_tags() != .Option(right_inner) -> return Err(ctx.error(ctx.span(), "checked Option.lift2 right operand is not optional"))
    called_ty := if function.ty.without_user_tags() == {
        .Fn{ret: Val(ret), ..} -> ret.clone()
        .Fn{ret: None, ..} -> Type.Named(Syntax.INTERNAL_UNIT_TYPE)
        else -> return Err(ctx.error(ctx.span(), "checked Option.lift2 function has no function type"))
    }
    function := ctx.lower_child(function)?
    left := ctx.lower_child(left)?
    right := ctx.lower_child(right)?
    left_condition := ctx.emit("option-lift2-left-condition", Val(Type.Bool), MirOperation.OptionIsSome{subject: left})?
    left_present := ctx.new_block(ctx.span(), "option-lift2-left-present")?
    left_absent := ctx.new_block(ctx.span(), "option-lift2-left-absent")?
    join := ctx.new_block(ctx.span(), "option-lift2-join")?
    ctx.terminate(MirTerminator.Branch{condition: left_condition, then_target: left_present, else_target: left_absent})
    incoming := [(MirBlockId, MirValueId)].with_capacity(3)
    ctx.switch_to(left_present)
    left_value := ctx.emit("option-lift2-left-value", Val(left_inner.clone()), MirOperation.OptionValue{subject: left})?
    right_condition := ctx.emit("option-lift2-right-condition", Val(Type.Bool), MirOperation.OptionIsSome{subject: right})?
    both_present := ctx.new_block(ctx.span(), "option-lift2-both-present")?
    right_absent := ctx.new_block(ctx.span(), "option-lift2-right-absent")?
    ctx.terminate(MirTerminator.Branch{condition: right_condition, then_target: both_present, else_target: right_absent})
    ctx.switch_to(both_present)
    right_value := ctx.emit("option-lift2-right-value", Val(right_inner.clone()), MirOperation.OptionValue{subject: right})?
    called_raw := ctx.emit("option-lift2-call", Val(called_ty.clone()), MirOperation.IndirectCall{
        callee: function, args: [mir_value_arg(ctx, left_value), mir_value_arg(ctx, right_value)], type_args: []})?
    called := ctx.trait_box_value(called_raw, called_ty, result_inner)?
    present := ctx.emit("option-lift2-present", Val(expr.ty.clone()), MirOperation.Present{value: called})?
    source := ctx.current_block()
    ctx.terminate(MirTerminator.Jump{target: join})
    incoming.push((source, present))
    ctx.switch_to(right_absent)
    absent := ctx.emit("option-lift2-right-absent-value", Val(expr.ty.clone()), MirOperation.Absent)?
    source := ctx.current_block()
    ctx.terminate(MirTerminator.Jump{target: join})
    incoming.push((source, absent))
    ctx.switch_to(left_absent)
    absent := ctx.emit("option-lift2-left-absent-value", Val(expr.ty.clone()), MirOperation.Absent)?
    source := ctx.current_block()
    ctx.terminate(MirTerminator.Jump{target: join})
    incoming.push((source, absent))
    ctx.switch_to(join)
    ctx.emit("option-lift2-phi", Val(expr.ty.clone()), MirOperation.Phi{incoming: ^incoming})
}
// Rust: crates/jet-codegen/src/Codegen/TIR/tir_to_mir_expr.rs:5071
fn lower_option_zip(ctx: &LowerCtx, expr: &TExpr, recv: &TExpr, args: &[TExpr], elem_ty: &Type) -> MirValueId LowerError! {
    if args.len() != 1 -> return Err(ctx.error(ctx.span(), "checked Option.zip requires one operand"))
    if recv.ty.without_user_tags() != .Option(left_inner) -> return Err(ctx.error(ctx.span(), "checked Option.zip receiver is not optional"))
    if args[0].ty.without_user_tags() != .Option(right_inner) -> return Err(ctx.error(ctx.span(), "checked Option.zip operand is not optional"))
    if elem_ty.without_user_tags() != .Tuple(fields) -> return Err(ctx.error(ctx.span(), "checked Option.zip result has no tuple fields"))
    if fields.len() != 2 -> return Err(ctx.error(ctx.span(), "checked Option.zip tuple shape is inconsistent"))
    left_target := fields[0].1.clone()
    right_target := fields[1].1.clone()
    tuple_ty := elem_ty.clone()
    owner := ctx.mir_type(tuple_ty)?.identity ?? return Err(ctx.error(ctx.span(), "checked Option.zip tuple has no canonical identity"))
    left := ctx.lower_child(recv)?
    right := ctx.lower_child(args[0])?
    left_condition := ctx.emit("option-zip-left-condition", Val(Type.Bool), MirOperation.OptionIsSome{subject: left})?
    left_present := ctx.new_block(ctx.span(), "option-zip-left-present")?
    left_absent := ctx.new_block(ctx.span(), "option-zip-left-absent")?
    join := ctx.new_block(ctx.span(), "option-zip-join")?
    ctx.terminate(MirTerminator.Branch{condition: left_condition, then_target: left_present, else_target: left_absent})
    incoming := [(MirBlockId, MirValueId)].with_capacity(3)
    ctx.switch_to(left_present)
    left_source_ty := left_inner.clone()
    left_value_raw := ctx.emit("option-zip-left-value", Val(left_source_ty.clone()), MirOperation.OptionValue{subject: left})?
    left_value := ctx.trait_box_value(left_value_raw, left_source_ty, left_target)?
    if left_value == left_value_raw && left_source_ty != left_target -> return Err(ctx.error(ctx.span(), "checked Option.zip left tuple field has no coercion fact"))
    right_condition := ctx.emit("option-zip-right-condition", Val(Type.Bool), MirOperation.OptionIsSome{subject: right})?
    both_present := ctx.new_block(ctx.span(), "option-zip-both-present")?
    right_absent := ctx.new_block(ctx.span(), "option-zip-right-absent")?
    ctx.terminate(MirTerminator.Branch{condition: right_condition, then_target: both_present, else_target: right_absent})
    ctx.switch_to(both_present)
    right_source_ty := right_inner.clone()
    right_value_raw := ctx.emit("option-zip-right-value", Val(right_source_ty.clone()), MirOperation.OptionValue{subject: right})?
    right_value := ctx.trait_box_value(right_value_raw, right_source_ty, right_target)?
    if right_value == right_value_raw && right_source_ty != right_target -> return Err(ctx.error(ctx.span(), "checked Option.zip right tuple field has no coercion fact"))
    tuple_fields := [(ctx.field_id_for_type(tuple_ty, fields[0].0)?, left_value), (ctx.field_id_for_type(tuple_ty, fields[1].0)?, right_value)]
    tuple := ctx.emit("option-zip-tuple", Val(^tuple_ty), MirOperation.Tuple{type_id: owner, fields: ^tuple_fields})?
    present := ctx.emit("option-zip-present", Val(expr.ty.clone()), MirOperation.Present{value: tuple})?
    source := ctx.current_block()
    ctx.terminate(MirTerminator.Jump{target: join})
    incoming.push((source, present))
    ctx.switch_to(right_absent)
    absent := ctx.emit("option-zip-right-absent-value", Val(expr.ty.clone()), MirOperation.Absent)?
    source := ctx.current_block()
    ctx.terminate(MirTerminator.Jump{target: join})
    incoming.push((source, absent))
    ctx.switch_to(left_absent)
    absent := ctx.emit("option-zip-left-absent-value", Val(expr.ty.clone()), MirOperation.Absent)?
    source := ctx.current_block()
    ctx.terminate(MirTerminator.Jump{target: join})
    incoming.push((source, absent))
    ctx.switch_to(join)
    ctx.emit("option-zip-phi", Val(expr.ty.clone()), MirOperation.Phi{incoming: ^incoming})
}

// Rust: crates/jet-codegen/src/Codegen/TIR/tir_to_mir_expr.rs:5209
fn panic_location(ctx: &LowerCtx, line: USize) -> MirPanicLoc {
    file := ctx.function.source_file.clone()
    MirPanicLoc{file: ctx.source_file_id_for(file), line: line as U32, column: 1}
}
// Rust: crates/jet-codegen/src/Codegen/TIR/tir_to_mir_expr.rs:5218
pub fn lower_binary_dispatch(ctx: &LowerCtx, op: BinOp, overflow: Bool, lhs: &Type, rhs: &Type, result: &Type, line: U32) -> MirBinaryDispatch LowerError! {
    carrier := TFailureCarrier.from_checked_type(result)
    if binary_route(op, overflow, lhs, rhs, result, carrier)? == {
        .Primitive -> Ok(MirBinaryDispatch.Primitive)
        .Prelude(route) -> Ok(MirBinaryDispatch.Prelude{call: ctx.intern_prelude_route(route)?, location: Val(panic_location(ctx, line as USize))})
    }
}
// Rust: crates/jet-codegen/src/Codegen/TIR/tir_to_mir_expr.rs:5237
fn lower_index_hook(ctx: &LowerCtx, expr: &TExpr, _type_name: String, base: &TExpr, index: &TExpr, line: USize) -> MirValueId LowerError! {
    option_ty := Type.Option(expr.ty.clone())
    call_expr := TExpr{ty: option_ty.clone(), kind: TExprKind.MethodCall{
        recv: base.clone(), method: TMethodRef.trait_method(Syntax.TRAIT_INDEX, "get"), type_args: [],
        args: [TCallArg{value: index.clone(), template_items: None, borrow: !index.ty.is_scalar(), mut_borrow: false,
            clone: false, arc_clone: false, fn_coerce: None, widen_to_vec: false, widen_to_union: None, box_as_trait: None}],
        source_first_string_literal: None, operator_line: None}}
    call := lower_expr(ctx, call_expr)?
    success_block := ctx.new_block(ctx.span(), "index-hook-success")?
    failure_block := ctx.new_block(ctx.span(), "index-hook-failure")?
    join := ctx.new_block(ctx.span(), "index-hook-join")?
    condition := ctx.emit("index-hook-condition", Val(Type.Bool), MirOperation.OptionIsSome{subject: call})?
    ctx.terminate(MirTerminator.Branch{condition: condition, then_target: success_block, else_target: failure_block})
    incoming := [(MirBlockId, MirValueId)].with_capacity(1)
    ctx.switch_to(success_block)
    value := ctx.emit("index-hook-value", Val(expr.ty.clone()), MirOperation.OptionValue{subject: call})?
    source := ctx.current_block()
    if !ctx.is_terminated() { ctx.terminate(MirTerminator.Jump{target: join}); incoming.push((source, value)) }
    ctx.switch_to(failure_block)
    ctx.lower_index_hook_failure(line)?
    if incoming.is_empty() -> return unsupported_expr(ctx, "TExprKind::IndexHook (no reachable success branch)")
    ctx.switch_to(join)
    ctx.emit("index-hook-phi", Val(expr.ty.clone()), MirOperation.Phi{incoming: ^incoming})
}
// Rust: crates/jet-codegen/src/Codegen/TIR/tir_to_mir_expr.rs:5310
fn lower_inline_block(ctx: &LowerCtx, result_ty: &Type, stmts: &[TStmt]) -> MirValueId LowerError! {
    (tail, prefix) := stmts.split_last() ?? return unsupported_expr(ctx, "TExprKind::InlineBlock (empty)")
    ctx.lower_nested_stmts(prefix)?
    if tail == {
        .ExprStmt(value) -> ctx.lower_child(value)
        .Loop{label, body} -> jet_codegen.Codegen.TIR.TirToMirStmt.lower_loop_value(ctx, label, body, result_ty)
        .Return(_) | .Break(_) | .BreakValue{..} | .Continue(_) -> {
            ctx.lower_nested_stmts(std.slice.from_ref(tail))?
            if ctx.is_terminated() -> return ctx.emit("inline-block-divergent", Val(result_ty.clone()), MirOperation.Constant(MirConstant.Unit))
            unsupported_expr(ctx, "TExprKind::InlineBlock (divergent tail did not terminate)")
        }
        else -> unsupported_expr(ctx, "TExprKind::InlineBlock (non-expression tail)")
    }
}
// Rust: crates/jet-codegen/src/Codegen/TIR/tir_to_mir_expr.rs:5345
fn lower_compare_chain_hook(ctx: &LowerCtx, op: BinOp, left_ty: &Type, right_ty: &Type, left: MirValueId, right: MirValueId) -> MirValueId LowerError! {
    owner := ctx.mir_type(left_ty)?
    generic_receiver := ctx.function.generic_params.iter().any(fn(param) { param.name == left_ty.name() })
    (callee, access, call_return_type) := if generic_receiver {
        (trait_ref, method, access) := ctx.trait_method_identity(Syntax.TRAIT_COMPARABLE, "compare")?
        access := access ?? return Err(ctx.error(ctx.span(), "checked Comparable method has no receiver convention"))
        (MirCallee.TraitMethod{method: method, trait_ref: trait_ref, receiver: owner.clone()}, access,
            ctx.trait_method_return_type(Syntax.TRAIT_COMPARABLE, "compare")?)
    } else {
        method := TMethodRef.operator(left_ty.name(), Syntax.TRAIT_COMPARABLE, "compare", right_ty)
        function := ctx.function_id_for(instance_method_lookup(method, left_ty))?
        access := ctx.function_registry.receiver_access.get(function).copied() ?? return Err(ctx.error(ctx.span(), "checked Comparable method has no receiver convention"))
        call_return_type := ctx.function_registry.method_call_return_type_for(function, [], left_ty)
            .map_err(fn(message) { ctx.error(ctx.span(), message) })?.unwrap_or_else(fn() { Type.Named(Syntax.TYPE_ORDERING) })
        (MirCallee.Method{function: function, owner: owner}, access, call_return_type)
    }
    ordering := ctx.emit("compare-chain-hook-call", Val(call_return_type), MirOperation.Call{
        callee: callee, args: [mir_value_arg_with_access(ctx, left, access), mir_value_arg(ctx, right)], type_args: []})?
    variant := if op == {
        .Lt -> "Less"; .Gt -> "Greater"; .Le -> "Greater"; .Ge -> "Less"
        else -> return Err(ctx.error(ctx.span(), "checked Comparable chain contains a non-relational operator"))
    }
    matches := ctx.emit("compare-chain-hook-test", Val(Type.Bool), MirOperation.EnumIs{
        subject: ordering, owner: ctx.type_id_for(Syntax.TYPE_ORDERING)?, variant: variant.to_string()})?
    if op == BinOp.Le || op == BinOp.Ge -> ctx.emit("compare-chain-hook-invert", Val(Type.Bool), MirOperation.Unary{op: MirUnaryOp.Not, value: matches})
    else -> Ok(matches)
}
// Rust: crates/jet-codegen/src/Codegen/TIR/tir_to_mir_expr.rs:5457
fn lower_decimal_relation(ctx: &LowerCtx, op: BinOp, left: MirValueId, right: MirValueId, carrier: &TFailureCarrier) -> MirValueId LowerError! {
    ordering_ty := Type.Named(Syntax.TYPE_ORDERING)
    type_id := ctx.nominal_type_id(Syntax.TYPE_DECIMAL)?
    call := ctx.intern_prelude_route(precise_builtin_route(Syntax.TYPE_DECIMAL, "compare", 2, ordering_ty, carrier)?)?
    ordering := ctx.emit("compare-chain-decimal", Val(ordering_ty), MirOperation.Semantic(MirSemanticOp.PreciseBuiltin{
        type_id: type_id, call: call, args: [left, right]}))?
    variant := if op == { .Lt | .Ge -> "Less"; .Gt | .Le -> "Greater"; else -> return Err(ctx.error(ctx.span(), "checked Decimal chain contains a non-relational operator")) }
    matches := ctx.emit("compare-chain-decimal-test", Val(Type.Bool), MirOperation.EnumIs{subject: ordering, owner: ctx.type_id_for(Syntax.TYPE_ORDERING)?, variant: variant.to_string()})?
    if op == BinOp.Le || op == BinOp.Ge -> ctx.emit("compare-chain-decimal-invert", Val(Type.Bool), MirOperation.Unary{op: MirUnaryOp.Not, value: matches})
    else -> Ok(matches)
}

// Rust: crates/jet-codegen/src/Codegen/TIR/tir_to_mir_expr.rs:5515
fn lower_compare_chain(ctx: &LowerCtx, expr: &TExpr, operands: &[TExpr], ops: &[BinOp], hooks: &[Bool]) -> MirValueId LowerError! {
    if operands.len() != ops.len().saturating_add(1) || operands.is_empty() -> return unsupported_expr(ctx, "TExprKind::CompareChain (invalid arity)")
    carrier := TFailureCarrier.from_checked_type(expr.ty)
    false_block := ctx.new_block(ctx.span(), "compare-chain-false")?
    true_block := ctx.new_block(ctx.span(), "compare-chain-true")?
    join := ctx.new_block(ctx.span(), "compare-chain-join")?
    left := ctx.lower_child(operands[0])?
    for (index, op) in ops.iter().enumerate() {
        right := ctx.lower_child(operands[index + 1])?
        hook := hooks.get(index).copied().unwrap_or(false)
        comparison := if hook {
            lower_compare_chain_hook(ctx, op, operands[index].ty, operands[index + 1].ty, left, right)?
        } else if operands[index].ty == .Named(name) && name == Syntax.TYPE_DECIMAL {
            lower_decimal_relation(ctx, op, left, right, carrier)?
        } else {
            if compare_chain_route(op, false, operands[index].ty, expr.ty, carrier)? == {
                .Primitive -> ctx.emit("compare-chain-link", Val(Type.Bool), MirOperation.Binary{op: mir_binary_op(op), left: left, right: right, dispatch: MirBinaryDispatch.Primitive})?
                .Prelude(route) -> {
                    call := ctx.intern_prelude_route(route)?
                    ctx.emit("compare-chain-link", Val(Type.Bool), MirOperation.Semantic(MirSemanticOp.StaticPreludeCall{
                        call: call, args: [mir_value_arg(ctx, left), mir_value_arg(ctx, right)], owner_type_args: [], type_args: []}))?
                }
            }
        }
        next := if index + 1 == ops.len() -> true_block else -> ctx.new_block(ctx.span(), "compare-chain-next")?
        ctx.terminate(MirTerminator.Branch{condition: comparison, then_target: next, else_target: false_block})
        if index + 1 != ops.len() { ctx.switch_to(next); left = right }
    }
    incoming := [(MirBlockId, MirValueId)].with_capacity(2)
    ctx.switch_to(true_block)
    true_value := ctx.emit("compare-chain-true-value", Val(Type.Bool), MirOperation.Constant(MirConstant.Bool(true)))?
    true_source := ctx.current_block()
    ctx.terminate(MirTerminator.Jump{target: join})
    incoming.push((true_source, true_value))
    ctx.switch_to(false_block)
    false_value := ctx.emit("compare-chain-false-value", Val(Type.Bool), MirOperation.Constant(MirConstant.Bool(false)))?
    false_source := ctx.current_block()
    ctx.terminate(MirTerminator.Jump{target: join})
    incoming.push((false_source, false_value))
    ctx.switch_to(join)
    ctx.emit("compare-chain-phi", Val(expr.ty.clone()), MirOperation.Phi{incoming: ^incoming})
}
// Rust: crates/jet-codegen/src/Codegen/TIR/tir_to_mir_expr.rs:5619
struct IfExprLevel {
    expr: &TExpr
    else_value: &TExpr
    join: MirBlockId
    incoming: [(MirBlockId, MirValueId)]
    shadow_mark: USize
}
// Rust: crates/jet-codegen/src/Codegen/TIR/tir_to_mir_expr.rs:5632
fn lower_if_expr(ctx: &LowerCtx, expr: &TExpr, cond: &TIfCond, then_body: &[TStmt], then_value: &TExpr, else_body: &[TStmt], else_value: &TExpr) -> MirValueId LowerError! {
    levels := [IfExprLevel]{}
    value := loop {
        then_block := ctx.new_block(ctx.span(), "if-then")?
        else_block := ctx.new_block(ctx.span(), "if-else")?
        join := ctx.new_block(ctx.span(), "if-join")?
        shadow_mark := ctx.shadow_mark()
        lower_if_cond(ctx, cond, then_block, else_block)?
        incoming := [(MirBlockId, MirValueId)].with_capacity(2)
        ctx.switch_to(then_block)
        ctx.lower_nested_stmts(then_body)?
        if !ctx.is_terminated() {
            arm := ctx.lower_child(then_value)?
            arm := ctx.trait_box_value(arm, then_value.ty, expr.ty)?
            source := ctx.current_block()
            if !ctx.is_terminated() { ctx.terminate(MirTerminator.Jump{target: join}); incoming.push((source, arm)) }
        }
        ctx.restore_shadowed_locals(shadow_mark)
        ctx.switch_to(else_block)
        ctx.lower_nested_stmts(else_body)?
        if !ctx.is_terminated() {
            if else_value.kind == .IfExpr{cond: next_cond, then_body: next_then_body, then_value: next_then_value, else_body: next_else_body, else_value: next_else_value} {
                levels.push(IfExprLevel{expr: expr, else_value: else_value, join: join, incoming: ^incoming, shadow_mark: shadow_mark})
                expr = else_value
                cond = next_cond
                then_body = next_then_body
                then_value = next_then_value
                else_body = next_else_body
                else_value = next_else_value
                continue
            }
            arm := ctx.lower_child(else_value)?
            close_if_expr_arm(ctx, expr, else_value, join, &incoming, arm)?
        }
        break finish_if_expr_level(ctx, expr, join, ^incoming, shadow_mark)?
    }
    while levels.pop() == Val(level) {
        record_lowered_expression(level.else_value, &value)
        close_if_expr_arm(ctx, level.expr, level.else_value, level.join, &level.incoming, value)?
        value = finish_if_expr_level(ctx, level.expr, level.join, ^level.incoming, level.shadow_mark)?
    }
    Ok(value)
}
// Rust: crates/jet-codegen/src/Codegen/TIR/tir_to_mir_expr.rs:5709
fn close_if_expr_arm(ctx: &LowerCtx, expr: &TExpr, arm_value: &TExpr, join: MirBlockId, incoming: &[(MirBlockId, MirValueId)], value: MirValueId) -> Void LowerError! {
    value := ctx.trait_box_value(value, arm_value.ty, expr.ty)?
    source := ctx.current_block()
    if !ctx.is_terminated() { ctx.terminate(MirTerminator.Jump{target: join}); incoming.push((source, value)) }
    Ok(())
}
// Rust: crates/jet-codegen/src/Codegen/TIR/tir_to_mir_expr.rs:5727
fn finish_if_expr_level(ctx: &LowerCtx, expr: &TExpr, join: MirBlockId, incoming: [(MirBlockId, MirValueId)], shadow_mark: USize) -> MirValueId LowerError! {
    ctx.restore_shadowed_locals(shadow_mark)
    if incoming.is_empty() {
        ctx.block_mut(join)?.terminator = MirTerminator.Unreachable{reason: "every conditional arm diverges"}
        return ctx.emit("diverging-conditional", Val(Type.Named(Syntax.INTERNAL_UNIT_TYPE)), MirOperation.Constant(MirConstant.Unit))
    }
    ctx.switch_to(join)
    ctx.emit("if-phi", Val(expr.ty.clone()), MirOperation.Phi{incoming: ^incoming})
}
// Rust: crates/jet-codegen/src/Codegen/TIR/tir_to_mir_expr.rs:5755
// Both arms consume the same owned SSA carrier, never a cloned resource.
fn lower_result_handler(ctx: &LowerCtx, expr: &TExpr, source: &TExpr,
    ok_pattern: &TPattern, ok_body: &[TStmt], ok_value: &TExpr,
    err_pattern: &TPattern, err_body: &[TStmt], err_value: &TExpr, terminal: &TExpr) -> MirValueId LowerError! {
    subject := ctx.lower_child(source)?
    ok_block := ctx.new_block(ctx.span(), "result-handler.ok")?
    err_test := ctx.new_block(ctx.span(), "result-handler.err-test")?
    err_block := ctx.new_block(ctx.span(), "result-handler.err")?
    terminal_block := ctx.new_block(ctx.span(), "result-handler.terminal")?
    join := ctx.new_block(ctx.span(), "result-handler.join")?
    ok := ctx.lower_pattern(ok_pattern)?
    ok_test := ctx.lower_pattern_condition(subject, ok)?
    ctx.terminate(MirTerminator.Branch{condition: ok_test, then_target: ok_block, else_target: err_test})
    incoming := [(MirBlockId, MirValueId)].with_capacity(3)
    ctx.switch_to(ok_block)
    ctx.lower_nested_stmts(ok_body)?
    if !ctx.is_terminated() {
        value := ctx.lower_child(ok_value)?
        value := ctx.trait_box_value(value, ok_value.ty, expr.ty)?
        from := ctx.current_block()
        if !ctx.is_terminated() { ctx.terminate(MirTerminator.Jump{target: join}); incoming.push((from, value)) }
    }
    ctx.switch_to(err_test)
    err := ctx.lower_pattern(err_pattern)?
    err_test_value := ctx.lower_pattern_condition(subject, err)?
    ctx.terminate(MirTerminator.Branch{condition: err_test_value, then_target: err_block, else_target: terminal_block})
    ctx.switch_to(err_block)
    ctx.lower_nested_stmts(err_body)?
    if !ctx.is_terminated() {
        value := ctx.lower_child(err_value)?
        value := ctx.trait_box_value(value, err_value.ty, expr.ty)?
        from := ctx.current_block()
        if !ctx.is_terminated() { ctx.terminate(MirTerminator.Jump{target: join}); incoming.push((from, value)) }
    }
    ctx.switch_to(terminal_block)
    value := ctx.lower_child(terminal)?
    value := ctx.trait_box_value(value, terminal.ty, expr.ty)?
    from := ctx.current_block()
    if !ctx.is_terminated() { ctx.terminate(MirTerminator.Jump{target: join}); incoming.push((from, value)) }
    if incoming.is_empty() {
        ctx.block_mut(join)?.terminator = MirTerminator.Unreachable{reason: "every Result handler arm diverges"}
        return ctx.emit("diverging-result-handler", Val(Type.Named(Syntax.INTERNAL_UNIT_TYPE)), MirOperation.Constant(MirConstant.Unit))
    }
    ctx.switch_to(join)
    ctx.emit("result-handler.phi", Val(expr.ty.clone()), MirOperation.Phi{incoming: ^incoming})
}
// Rust: crates/jet-codegen/src/Codegen/TIR/tir_to_mir_expr.rs:5838
fn plain_try_call_root(inner: &TExpr) -> USize? {
    if !jet_codegen.Codegen.TIR.Mir.is_result_carrier(inner.ty) -> return None
    expr := inner
    loop {
        if expr.kind == {
            .Call{..} | .ModuleCall{..} -> {
                // GATE #4494: preserve AST address identity without copying the node.
                return Val(std.ptr.address_of(expr) as USize)
            }
            .InlineBlock(stmts) -> { if stmts.last() == Val(.ExprStmt(tail)) { expr = tail } else { return None } }
            else -> return None
        }
    }
}
// Rust: crates/jet-codegen/src/Codegen/TIR/tir_to_mir_expr.rs:5862
pub fn lower_plain_return_value(ctx: &LowerCtx, expr: &TExpr, expected: &Type) -> MirValueId? LowerError! {
    if !jet_codegen.Codegen.TIR.Mir.is_plain_call_return(expected, expr.ty) -> return Ok(None)
    if expr.kind == .Ok(inner) -> return lower_carrier_payload(ctx, inner, Val(expected)).map(fn(value) { Val(value) })
    value := ctx.lower_child(expr)?
    if ctx.is_terminated() -> return Ok(Val(value))
    carrier := expr.ty.without_user_tags().clone()
    lower_try_value(ctx, value, expected, carrier, None, TTryConvert.Never, None).map(fn(value) { Val(value) })
}
// Rust: crates/jet-codegen/src/Codegen/TIR/tir_to_mir_expr.rs:5881
fn try_child_already_propagated(inner: &TExpr) -> Bool {
    if inner.kind == {
        .ModuleCall{target_return: Val(target), ..} -> (target is .Result{..} || target is .Option(_)) && target != inner.ty
        .HostCall(host) -> host is .EnvSet{..}
        else -> false
    }
}
// Rust: crates/jet-codegen/src/Codegen/TIR/tir_to_mir_expr.rs:5891
fn checked_failure_return_type(ctx: &LowerCtx, carrier: &TFailureCarrier) -> Type? {
    ctx.function.ret.clone().or_else(fn() {
        if carrier == {
            .Result{success, error} -> Val(Type.Result{ok: success.clone(), err: error.clone()})
            .Optional{value} -> Val(Type.Option(value.clone()))
            .Diverges{value} -> Val(value.clone())
            .Infallible -> None
        }
    })
}
// Rust: crates/jet-codegen/src/Codegen/TIR/tir_to_mir_expr.rs:5903
fn lower_if_cond(ctx: &LowerCtx, cond: &TIfCond, then_target: MirBlockId, else_target: MirBlockId) -> Void LowerError! {
    if cond == {
        .Plain(expr) -> {
            condition := ctx.lower_child(expr)?
            ctx.terminate(MirTerminator.Branch{condition: condition, then_target: then_target, else_target: else_target})
        }
        .And{left, right} -> {
            right_block := ctx.new_block(ctx.span(), "if-and-right")?
            lower_if_cond(ctx, left, right_block, else_target)?
            ctx.switch_to(right_block)
            lower_if_cond(ctx, right, then_target, else_target)?
        }
        .IfLet{pattern, subj} | .Matches{pattern, subj} -> {
            subject := ctx.lower_pattern_subject(subj)?
            pattern := lower_pattern(ctx, pattern)?
            condition := ctx.lower_pattern_condition(subject, pattern)?
            ctx.terminate(MirTerminator.Branch{condition: condition, then_target: then_target, else_target: else_target})
        }
        .IsNone{subj} -> {
            subject := ctx.lower_child(subj)?
            pattern := MirPattern{shape: MirPatternShape.Absent(ctx.span()), owner: None, position: MirPatternPosition.OptionBinding, mutable: false, boxed: false}
            condition := ctx.lower_pattern_condition(subject, pattern)?
            ctx.terminate(MirTerminator.Branch{condition: condition, then_target: then_target, else_target: else_target})
        }
        .WithPrelude{prelude, cond} -> {
            ctx.lower_nested_stmts(prelude)?
            if !ctx.is_terminated() { lower_if_cond(ctx, cond, then_target, else_target)? }
        }
    }
    Ok(())
}
// Rust: crates/jet-codegen/src/Codegen/TIR/tir_to_mir_expr.rs:5972
struct TryJourneySite {
    file: String
    line: USize
    column: USize
    fn_name: String
    fresh_failure: Bool
}
// Rust: crates/jet-codegen/src/Codegen/TIR/tir_to_mir_expr.rs:5987
fn try_operand_starts_failure(operand: &TExpr) -> Bool {
    if operand.kind == { .CoreCall{args, ..} -> !args.iter().any(fn(arg) { arg.ty is .Fn{..} }); else -> false }
}
// Rust: crates/jet-codegen/src/Codegen/TIR/tir_to_mir_expr.rs:5996
fn lower_fresh_failure(ctx: &LowerCtx, location: TryJourneySite?) -> Void LowerError! {
    if location.is_some_and(fn(site) { site.fresh_failure }) {
        reset_route := journey_reset_route()?
        unit_ty := Type.Named(Syntax.INTERNAL_UNIT_TYPE)
        _ :: emit_static_call(ctx, unit_ty, reset_route, [])?
    }
    Ok(())
}

// Rust: crates/jet-codegen/src/Codegen/TIR/tir_to_mir_expr.rs:6008
fn lower_try_value(ctx: &LowerCtx, input: MirValueId, result: &Type, input_ty: &Type, note: &TExpr?, convert: &TTryConvert, location: TryJourneySite?) -> MirValueId LowerError! {
    is_result := input_ty is .Result{..}
    is_option := input_ty is .Option(_)
    if !is_result && !is_option -> return unsupported_expr(ctx, "TExprKind::Try (non-carrier operand)")
    never_convert := TTryConvert.Never
    convert := if input_ty == .Result{err, ..} && err.is_never() -> &never_convert else -> convert
    success_block := ctx.new_block(ctx.span(), "try-success")?
    failure_block := ctx.new_block(ctx.span(), "try-failure")?
    join := ctx.new_block(ctx.span(), "try-join")?
    incoming := [(MirBlockId, MirValueId)].with_capacity(2)
    condition := if is_result -> ctx.emit("try-result-condition", Val(Type.Bool), MirOperation.ResultIsOk{subject: input})?
        else -> ctx.emit("try-option-condition", Val(Type.Bool), MirOperation.OptionIsSome{subject: input})?
    ctx.terminate(MirTerminator.Branch{condition: condition, then_target: success_block, else_target: failure_block})
    ctx.switch_to(success_block)
    if location.is_some() {
        reset_route := journey_reset_route()?
        unit_ty := Type.Named(Syntax.INTERNAL_UNIT_TYPE)
        _ :: emit_static_call(ctx, unit_ty, reset_route, [])?
    }
    success_ty := if is_result -> input_ty.unwrap_result().map(fn(pair) { (ok, _) := pair; ok.clone() }) ?? return Err(ctx.error(ctx.span(), "checked try result has no success type"))
        else -> input_ty.unwrap_option().cloned() ?? return Err(ctx.error(ctx.span(), "checked try option has no success type"))
    if success_ty.is_never() {
        ctx.terminate(MirTerminator.Unreachable{reason: "checked try success is uninhabited"})
    } else {
        success := if is_result -> ctx.emit("try-result-value", Val(success_ty.clone()), MirOperation.ResultValue{subject: input, ok: true})?
            else -> ctx.emit("try-option-value", Val(success_ty.clone()), MirOperation.OptionValue{subject: input})?
        success := ctx.trait_box_value(success, success_ty, result)?
        success_source := ctx.current_block()
        if !ctx.is_terminated() { ctx.terminate(MirTerminator.Jump{target: join}); incoming.push((success_source, success)) }
    }
    ctx.switch_to(failure_block)
    carrier := ctx.function.failure_carrier.clone()
    if carrier == {
        .Result{..} -> {
            if convert is .Never {
                ctx.terminate(MirTerminator.Unreachable{reason: "try conversion is unreachable"})
            } else {
                error_ty := input_ty.unwrap_result().map(fn(pair) { (_, error) := pair; error.clone() }) ?? return Err(ctx.error(ctx.span(), "checked try result has no error type"))
                error := ctx.emit("try-result-error-value", Val(error_ty), MirOperation.ResultValue{subject: input, ok: false})?
                if convert is .ProtocolExit {
                    route := try_conversion_route(convert, input_ty, result, carrier)?
                    never_ty := Type.Named(Syntax.TYPE_NEVER)
                    _ :: emit_static_call(ctx, never_ty, route, [error])?
                    ctx.terminate(MirTerminator.Unreachable{reason: "protocol error exit diverges"})
                } else {
                    lower_fresh_failure(ctx, location)?
                    note_value := note.map(fn(value) { ctx.lower_child(value) }).transpose()?
                    converted := lower_try_failure(ctx, error, input_ty, convert, note_value, result, location, carrier)?
                    return_ty := checked_failure_return_type(ctx, carrier) ?? return Err(ctx.error(ctx.span(), "checked try has no result return type"))
                    failure := ctx.emit("try-result-error", Val(return_ty), MirOperation.ResultErr{value: converted})?
                    ctx.terminate_with_cleanup(MirTerminator.Return{value: Val(failure)}, 0)?
                }
            }
        }
        .Optional{..} -> {
            if convert is .Never {
                ctx.terminate(MirTerminator.Unreachable{reason: "try conversion is unreachable"})
            } else if !(convert is .None) {
                return unsupported_expr(ctx, "TExprKind::Try (optional conversion)")
            } else {
                lower_fresh_failure(ctx, location)?
                note_value := note.map(fn(value) { ctx.lower_child(value) }).transpose()?
                if location == Val(site) { lower_try_journey(ctx, result, carrier, note_value, site)? }
                return_ty := checked_failure_return_type(ctx, carrier) ?? return Err(ctx.error(ctx.span(), "checked try has no optional return type"))
                failure := ctx.emit("try-optional-absent", Val(return_ty), MirOperation.Absent)?
                ctx.terminate_with_cleanup(MirTerminator.Return{value: Val(failure)}, 0)?
            }
        }
        .Diverges{..} -> {
            if convert is .Never {
                ctx.terminate(MirTerminator.Unreachable{reason: "try conversion is unreachable"})
            } else if convert is .ProtocolExit && is_result {
                error_ty := input_ty.unwrap_result().map(fn(pair) { (_, error) := pair; error.clone() }) ?? return Err(ctx.error(ctx.span(), "checked try result has no error type"))
                error := ctx.emit("try-result-error-value", Val(error_ty), MirOperation.ResultValue{subject: input, ok: false})?
                route := try_conversion_route(convert, input_ty, result, carrier)?
                never_ty := Type.Named(Syntax.TYPE_NEVER)
                _ :: emit_static_call(ctx, never_ty, route, [error])?
                ctx.terminate(MirTerminator.Unreachable{reason: "protocol error exit diverges"})
            } else {
                return unsupported_expr(ctx, "TExprKind::Try (diverging carrier)")
            }
        }
        .Infallible -> {
            ctx.switch_to(failure_block)
            ctx.terminate(MirTerminator.Unreachable{reason: "try in an infallible function diverges on failure"})
        }
    }
    if incoming.is_empty() {
        ctx.block_mut(join)?.terminator = MirTerminator.Unreachable{reason: "every try edge diverges"}
        return ctx.emit("diverging-try", Val(Type.Named(Syntax.INTERNAL_UNIT_TYPE)), MirOperation.Constant(MirConstant.Unit))
    }
    ctx.switch_to(join)
    ctx.emit("try-phi", Val(result.clone()), MirOperation.Phi{incoming: ^incoming})
}
// Rust: crates/jet-codegen/src/Codegen/TIR/tir_to_mir_expr.rs:6245
fn decode_try_location(value: String) -> String {
    value := value.strip_prefix('"').unwrap_or(value)
    value := value.strip_suffix('"').unwrap_or(value)
    decoded := String.with_capacity(value.len())
    escaped := false
    for ch in value.chars() {
        if escaped {
            if ch == '\\' || ch == '"' { decoded.push(ch) }
            else { decoded.push('\\'); decoded.push(ch) }
            escaped = false
        } else if ch == '\\' { escaped = true }
        else { decoded.push(ch) }
    }
    if escaped { decoded.push('\\') }
    decoded
}
// Rust: crates/jet-codegen/src/Codegen/TIR/tir_to_mir_expr.rs:6273
fn lower_try_context_values(ctx: &LowerCtx, file: String, line: USize, column: USize, fn_name: String) -> [MirValueId] LowerError! {
    line := U32.try_from(line).map_err(fn(_) { ctx.error(ctx.span(), "checked try source line does not fit u32") })?
    column := U32.try_from(column).map_err(fn(_) { ctx.error(ctx.span(), "checked try source column does not fit u32") })?
    file_value := ctx.emit("try-context-file", Val(Type.String), MirOperation.Constant(MirConstant.String(decode_try_location(file))))?
    line_value := ctx.emit("try-context-line", Val(Type.IntN{signed: false, bits: 32}), MirOperation.Constant(MirConstant.Int{
        value: line as I64, width: Val((false, 32)), spelling: None}))?
    column_value := ctx.emit("try-context-column", Val(Type.IntN{signed: false, bits: 32}), MirOperation.Constant(MirConstant.Int{
        value: column as I64, width: Val((false, 32)), spelling: None}))?
    fn_value := ctx.emit("try-context-function", Val(Type.String), MirOperation.Constant(MirConstant.String(decode_try_location(fn_name))))?
    Ok([file_value, line_value, column_value, fn_value])
}
// Rust: crates/jet-codegen/src/Codegen/TIR/tir_to_mir_expr.rs:6321
fn lower_try_journey(ctx: &LowerCtx, result: &Type, carrier: &TFailureCarrier, note: MirValueId?, site: TryJourneySite) -> Void LowerError! {
    values := lower_try_context_values(ctx, site.file, site.line, site.column, site.fn_name)?
    note := if note == {
        Val(note) -> note
        None -> ctx.emit("try-context-empty-note", Val(Type.String), MirOperation.Constant(MirConstant.String(String.new())))?
    }
    values.push(note)
    route := failure_note_route(result, carrier)?
    unit_ty := Type.Named(Syntax.INTERNAL_UNIT_TYPE)
    _ :: emit_static_call(ctx, unit_ty, route, ^values)?
    Ok(())
}
// Rust: crates/jet-codegen/src/Codegen/TIR/tir_to_mir_expr.rs:6350
fn lower_union_widening(ctx: &LowerCtx, union: &Type, tag: String, args: [MirEnumArg]) -> MirValueId LowerError! {
    if union.without_user_tags() != .Union(members) -> return Err(ctx.error(ctx.span(), "checked union widening has no union target"))
    if !members.iter().any(fn(member) { jet_foundation.AST.union_member_tag(member) == tag }) -> return Err(ctx.error(ctx.span(), "checked union widening names no member `{tag}`"))
    type_id := ctx.type_id_for(jet_foundation.AST.union_enum_name(members))?
    ctx.emit("union-widening", Val(union.clone()), MirOperation.Enum{type_id: type_id, variant: tag.to_string(), args: ^args})
}
