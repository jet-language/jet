//RS     err_pattern: &super::TPattern,
//RS     err_body: &[super::TStmt],
//RS     err_value: &TExpr,
//RS     terminal: &TExpr,
//RS ) -> Result<jet_foundation::MIR::MirValueId, LowerError> {
//RS     let subject = ctx.lower_child(source)?;
//RS     let ok_block = ctx.new_block(ctx.span(), "result-handler.ok")?;
//RS     let err_test = ctx.new_block(ctx.span(), "result-handler.err-test")?;
