//RS /// Result handlers share the single owned SSA carrier across both tests.
//RS /// Each selected pattern consumes its payload; the other arm never reads a
//RS /// clone of a non-Clone resource or a second copy of the transport.
//RS fn lower_result_handler(
//RS     ctx: &mut LowerCtx,
//RS     expr: &TExpr,
