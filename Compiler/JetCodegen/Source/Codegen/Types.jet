// Backend-neutral lowering from checked semantic types to canonical MIR types.
// This is the only Type -> MirType projection used by Jet codegen; semantic
// identity and ABI facts are retained instead of reconstructed by an emitter.
use jet_foundation.[
    CORE_MODULE_EXPORTS,
    canonical_pass_debug_snapshot,
    AccessConvention,
    CallContractRow,
    Dimension,
    EffectRowEntry,
    FunctionCallMetadata,
    MIRAccess,
    MIRCallContractRow,
    MIRCallMetadata,
    MIRCallablePolicy,
    MIRCallablePolicyChain,
    MIRDimension,
    MIRDimensionAxis,
    MIRFieldID,
    MIRFunctionSignature,
    MIRInternalTag,
    MIRMeasure,
    MIRMeasureRule,
    MIRSerdeCodec,
    MIRTagMarker,
    MIRTraitID,
    MIRTraitRef,
    MIRTupleField,
    MIRType,
    MIRTypeID,
    MIRTypeKind,
    MIRViewProjection,
    MIRViewProvenance,
    MIRViewProvenanceEntry,
    MIRViewSource,
    MIRViewSourcePath,
    Measure,
    SymbolID,
    SymbolKind,
    TCompilerBuiltin,
    TCoreBuiltinOwner,
    TFieldRef,
    TagMarker,
    Type,
    TypeTupleField,
    ViewProvenanceMap,
    core_enum_variant_payload,
    core_enum_variants,
    core_record_field,
    mir_builtin_codec_trait_id,
    mir_boundary_head_carrier_module,
    mir_field_id,
    mir_measure_expression,
    mir_nominal_ref,
    mir_trait_id,
    mir_trait_ref,
    mir_type_from_kind,
    mir_type_id,
    mir_type_with_identity,
    symbol_id,
    type_mir_identity_key,
    type_name,
]
use jet_sema.[
    SemaGraphModuleResult,
    SemaRegistrationNominal,
    SemaRegistrationNominalKind,
    sema_inference_substitute_type,
    sema_registration_is_compiler_owned_enum,
]

struct JetCodegenNominalIdentity {
    module_identity: String
    name: String
    key: String
    qualified_name: String
}

fn jet_codegen_is_type_parameter(names: [String], name: String) -> Bool Never! {
    loop candidate in names {
        if candidate == name -> return true
    }
    false
}

fn jet_codegen_qualified_type_key(module_identity: String, name: String) -> String Never! {
    if module_identity == "" -> name else -> "{module_identity}::{name}"
}

// The canonical MIR type key of a registered nominal. Compiler-owned runtime
// enums (`Ordering`, `RemoveBy`) keep the bare shared spelling, like Rust's
// compiler-owned MIR rows, so every module's values name one type.
fn jet_codegen_nominal_type_key(module_identity: String, nominal: SemaRegistrationNominal) -> String Never! {
    if sema_registration_is_compiler_owned_enum(nominal) -> return nominal.symbol.name
    jet_codegen_qualified_type_key(module_identity, nominal.symbol.name)
}

// A declared trait as a checked name can resolve to it: its module and its
// canonical key.
struct JetCodegenTraitCandidate {
    module_identity: String
    canonical: String
}

// One declared trait of the program modules, by module and definition row.
struct JetCodegenTraitDefRef {
    module_index: Int
    definition_index: Int
}

// Every declared trait under each spelling that names it
// (jet_codegen_trait_spellings), candidates in module and declaration order:
// resolving a checked trait name is one lookup instead of a scan that formats
// every module's trait spellings. Built once per program lowering.
struct JetCodegenTraitNames {
    candidates: [String:[JetCodegenTraitCandidate]]
    // MIR trait ID value of each trait's canonical key -> the traits with
    // that ID, in module and declaration order.
    by_id: [U64:[JetCodegenTraitDefRef]]
}

// The distinct spellings that name a trait declared as `definition_name` with
// key `definition_key` in a module: its key, its name, its canonical key, and
// its name qualified by the module's name and by the module's identity.
fn jet_codegen_trait_spellings(module_name: String, module_identity: String, definition_key: String, definition_name: String, canonical: String) -> [String] Never! {
    spellings := [String]{}
    names := [String]{definition_key, definition_name, canonical, "{module_name}::{definition_name}", "{module_identity}::{definition_name}"}
    loop spelling in names {
        if !spellings.contains(spelling) -> &spellings.push(spelling)
    }
    spellings
}

fn jet_codegen_trait_names(modules: [SemaGraphModuleResult]) -> JetCodegenTraitNames Never! {
    candidates := [String:[JetCodegenTraitCandidate]]{}
    by_id := [U64:[JetCodegenTraitDefRef]]{}
    loop module_index in 0..<modules.len() {
        semantic_module :: modules[module_index]
        loop definition_index in 0..<semantic_module.declarations.traits.len() {
            definition :: semantic_module.declarations.traits[definition_index]
            canonical :: jet_codegen_canonical_target_type(semantic_module.module_identity, definition.key)
            id :: mir_trait_ref(canonical).id.value
            refs := by_id.get(id) ?? [JetCodegenTraitDefRef]{}
            &refs.push(JetCodegenTraitDefRef{module_index: module_index, definition_index: definition_index})
            by_id[id] = refs
            candidate :: JetCodegenTraitCandidate{module_identity: semantic_module.module_identity, canonical: canonical}
            loop spelling in jet_codegen_trait_spellings(semantic_module.module_name, semantic_module.module_identity, definition.key, definition.name, canonical) {
                rows := candidates.get(spelling) ?? [JetCodegenTraitCandidate]{}
                &rows.push(candidate)
                candidates[spelling] = rows
            }
        }
    }
    JetCodegenTraitNames{candidates: candidates, by_id: by_id}
}

// The trait a checked name resolves to among the traits it names, in module
// order: the one in the preferred module, else the one elsewhere; `None` when
// none matches or the match is ambiguous.
fn jet_codegen_choose_trait_ref(candidates: [JetCodegenTraitCandidate], preferred_module_identity: String) -> MIRTraitRef? {
    preferred := MIRTraitRef?{None}
    other := MIRTraitRef?{None}
    ambiguous_other := false
    loop row in candidates {
        candidate :: mir_trait_ref(row.canonical)
        if {
            row.module_identity == preferred_module_identity -> {
                if preferred != None && (preferred ?? candidate).id != candidate.id -> return None
                preferred = Val(candidate)
            }
            else -> {
                if {
                    other != None && (other ?? candidate).id != candidate.id -> {
                        ambiguous_other = true
                    }
                    else -> {
                        other = Val(candidate)
                    }
                }
            }
        }
    }
    if preferred != None -> return preferred
    if ambiguous_other -> return None
    other
}

fn jet_codegen_resolve_trait_name(names: JetCodegenTraitNames, name: String, preferred_module_identity: String) -> MIRTraitRef? {
    candidates :: names.candidates.get(name) ?? return None
    jet_codegen_choose_trait_ref(candidates, preferred_module_identity)
}

// The traits a Rust derive provides natively.
JET_CODEGEN_NATIVE_RUST_DERIVES :: [String]{"Clone", "Copy", "Debug", "Default", "Eq", "Hash", "Ord", "PartialEq", "PartialOrd"}

fn jet_codegen_is_native_rust_derive_name(name: String) -> Bool Never! {
    JET_CODEGEN_NATIVE_RUST_DERIVES.contains(name)
}

fn jet_codegen_native_rust_derive_name_for_id(id: MIRTraitID) -> String? {
    loop name in JET_CODEGEN_NATIVE_RUST_DERIVES {
        if id == mir_trait_id(name) -> return Val(name)
    }
    None
}

// The IDs of JET_CODEGEN_NATIVE_RUST_DERIVES, for a caller that tests many
// trait IDs: each name hashes once, not once per test.
fn jet_codegen_native_rust_derive_ids() -> [U64:Bool] Never! {
    ids := [U64:Bool]{}
    loop name in JET_CODEGEN_NATIVE_RUST_DERIVES -> _ := &ids.add(mir_trait_id(name).value, true)
    ids
}

fn jet_codegen_is_compiler_owned_trait_name(name: String) -> Bool Never! {
    name == "Encode" || name == "Decode" || name == "Printable" || name == "Renderable" || name == "Display" || name == "Debug" || name == "Equatable" || name == "Comparable" || name == "Close" || name == "Index" || name == "IndexMut" || name == "Iterable" || name == "Iterator" || name == "Add" || name == "Sub" || name == "Mul" || name == "Div" || name == "Rollback"
}

fn jet_codegen_compiler_owned_trait_name_for_id(id: MIRTraitID) -> String? {
    if {
        id == mir_builtin_codec_trait_id(MIRSerdeCodec.Encode) -> Val("Encode")
        id == mir_builtin_codec_trait_id(MIRSerdeCodec.Decode) -> Val("Decode")
        id == mir_trait_id("Printable") -> Val("Printable")
        id == mir_trait_id("Renderable") -> Val("Renderable")
        id == mir_trait_id("Display") -> Val("Display")
        id == mir_trait_id("Debug") -> Val("Debug")
        id == mir_trait_id("Equatable") -> Val("Equatable")
        id == mir_trait_id("Comparable") -> Val("Comparable")
        id == mir_trait_id("Close") -> Val("Close")
        id == mir_trait_id("Index") -> Val("Index")
        id == mir_trait_id("IndexMut") -> Val("IndexMut")
        id == mir_trait_id("Iterable") -> Val("Iterable")
        id == mir_trait_id("Iterator") -> Val("Iterator")
        id == mir_trait_id("Add") -> Val("Add")
        id == mir_trait_id("Sub") -> Val("Sub")
        id == mir_trait_id("Mul") -> Val("Mul")
        id == mir_trait_id("Div") -> Val("Div")
        id == mir_trait_id("Rollback") -> Val("Rollback")
        else -> None
    }
}

fn jet_codegen_is_checked_text_trait_id(id: MIRTraitID) -> Bool Never! {
    id == mir_trait_id("CheckedText")
}

// Rust mir.rs::lower_impl_rows keys an impl's trait by its written name
// (`stable_id("mir-trait", name)`) and refuses none: a declared trait keeps
// its resolved identity, any other name (a builtin bound such as `Serialize`,
// `Numeric` or `Driver`) its bare one, which ensure_referenced_traits
// synthesizes a row for.
fn jet_codegen_lower_declared_or_builtin_trait_ref(names: JetCodegenTraitNames, name: String, module_identity: String) -> MIRTraitRef Never! {
    if jet_codegen_resolve_trait_name(names, name, module_identity) == .Val(resolved) -> return resolved
    if names.candidates.get(name) != None -> panic("checked trait name is ambiguous")
    mir_trait_ref(name)
}

// Rust mir.rs::is_literal_capability_trait: `impl T.Literal.Int` and
// `impl T.Literal.Float` are inherent blocks of their literal hook.
fn jet_codegen_is_literal_capability_trait(name: String) -> Bool Never! {
    name == "Literal.Int" || name == "Literal.Float"
}

// A checked derive names a declared trait, a native Rust derive, a
// compiler-owned trait, or any other type marker the parser keeps as a derive
// (`#SingleUse`, `#Numeric`, ...). Rust keys every derive by its written name
// (tir_to_mir_types.rs `TirTypeDef::derives` -> `stable_id("mir-trait", name)`)
// and never refuses one; a declared trait keeps its resolved identity.
fn jet_codegen_lower_type_derive_trait_id(name: String, nominals: JetCodegenNominalIndex, module_identity: String) -> MIRTraitID Never! {
    resolved := jet_codegen_resolve_trait_name(nominals.traits, name, module_identity)
    if resolved == .Val(reference) -> return reference.id
    mir_trait_id(name)
}

fn jet_codegen_core_owner_identity(owner: TCoreBuiltinOwner, semantic_module: SemaGraphModuleResult) -> JetCodegenNominalIdentity Never! {
    jet_codegen_check_core_owner(owner, semantic_module)
    module_identity := ""
    qualified_name := owner.name
    if owner.module_identity == .Val(identity) {
        module_identity = identity
        qualified_name = jet_codegen_qualified_type_key(identity, owner.name)
    }
    JetCodegenNominalIdentity{module_identity: module_identity, name: owner.name, key: owner.symbol.key, qualified_name: qualified_name}
}

// The invariants of a checked Core builtin owner, without building its
// identity (the nominal index validates every owner once).
// The report takes a copy of `fault`: the stop path releases every live
// local (the scope-exit drops run before the stop call), and the O0 seed
// reads the dropped message otherwise (a0_005 round 5, LIR lint
// "use after moved or dropped").
fn jet_codegen_check_core_owner(owner: TCoreBuiltinOwner, semantic_module: SemaGraphModuleResult) Never! {
    fault :: jet_codegen_core_owner_fault(owner, semantic_module)
    if fault != "" -> panic(fault.copy())
}

// Why a checked Core builtin owner is invalid, "" when it is not.
fn jet_codegen_core_owner_fault(owner: TCoreBuiltinOwner, semantic_module: SemaGraphModuleResult) -> String Never! {
    if owner.name == "" || owner.symbol.key == "" -> return "checked Core builtin owner has an empty canonical identity"
    if owner.module_identity == .Val(identity) {
        if identity != semantic_module.module_identity -> return "checked Core builtin owner has a module linkage mismatch"
    }
    ""
}

// Each Core type leaf -> the one Core module exporting it, "" when several
// do: core_type_modules(leaf) read once per program instead of a scan of
// every Core module's exports per nominal lookup.
fn jet_codegen_core_type_modules() -> [String:String] Never! {
    owners := [String:String]{}
    loop row in CORE_MODULE_EXPORTS {
        seen := [String:Bool]{}
        loop name in row.type_exports {
            if seen.get(name) != None -> next
            seen[name] = true
            owners[name] = if owners.get(name) == None -> row.module_name else -> ""
        }
    }
    owners
}

fn jet_codegen_find_nominal_identity(nominals: JetCodegenNominalIndex, current_module_identity: String, name: String, generic_names: [String]) -> JetCodegenNominalIdentity? {
    found :: jet_codegen_find_source_nominal_identity(nominals, current_module_identity, name, generic_names) ?? return None
    Val(found)
}

// One lookup per table of the program nominal index: the result is the
// candidate a scan of every module in order would have met first, and two
// candidates with different keys are ambiguous.
fn jet_codegen_find_source_nominal_identity(nominals: JetCodegenNominalIndex, current_module_identity: String, name: String, generic_names: [String]) -> JetCodegenNominalIdentity? {
    if jet_codegen_is_type_parameter(generic_names, name) -> return None
    scope :: nominals.scopes.get(current_module_identity) ?? -1
    if scope >= 0 {
        if nominals.scope_nominals[scope].get(name) == .Val(local) -> return Val(local)
    }
    // A `use` binding brings it in from another source package.
    if nominals.import_nominals.get(current_module_identity) == .Val(imported) {
        if imported.get(name) == .Val(found) -> return Val(found)
    }
    // A sibling member file of the same namespace package declares it.
    if nominals.module_packages.get(current_module_identity) == .Val(package) {
        if nominals.package_nominals.get(package) == .Val(names) {
            if names.get(name) == .Val(sibling) -> return Val(sibling)
        }
    }
    // A bare `Err` the current module does not declare is the one original
    // Prelude default error, which its own registered module owns.
    if name == "Err" -> return jet_codegen_default_err_identity(nominals)
    if nominals.owner_fault != "" -> panic(nominals.owner_fault)
    // Source nominals outside the current module arrive with their checked
    // module-qualified key. Never resolve them by a leaf from another module.
    core_owner := String?{None}
    if !name.contains("::") && !name.contains(".") {
        carrier :: mir_boundary_head_carrier_module(name)
        if carrier != None -> core_owner = carrier
        else if mir_typed_head_kind(Type.Named{name: name}) == None {
            // core_type_modules(name) has exactly one module.
            if nominals.core_type_modules.get(name) == .Val(module_name) {
                if module_name != "" -> core_owner = Val(module_name)
            }
        }
    }
    core_owner_name :: core_owner ?? ""
    found := JetCodegenNominalCandidate?{None}
    // This bare spelling is selected by the Core registry, not by all
    // declarations that happen to share its leaf.
    if nominals.corelib_nominals.get(name) == .Val(candidates) {
        loop candidate in candidates {
            if candidate.module_name == core_owner_name && jet_codegen_nominal_candidate_first(found, candidate) -> found = Val(candidate)
        }
    }
    if nominals.qualified_nominals.get(name) == .Val(candidate) {
        if jet_codegen_nominal_candidate_first(found, candidate) -> found = Val(candidate)
    }
    if nominals.owner_keys.get(name) == .Val(candidate) {
        if jet_codegen_nominal_candidate_first(found, candidate) -> found = Val(candidate)
    }
    if scope >= 0 {
        if nominals.scope_owners[scope].get(name) == .Val(candidates) {
            loop candidate in candidates {
                if jet_codegen_nominal_candidate_first(found, candidate) -> found = Val(candidate)
            }
        }
    }
    chosen :: found ?? return None
    Val(chosen.identity)
}

// Whether `candidate` comes before `found` in module, then rank order; two
// candidates of one spelling must carry one key.
fn jet_codegen_nominal_candidate_first(found: JetCodegenNominalCandidate?, candidate: JetCodegenNominalCandidate) -> Bool Never! {
    if found == .Val(existing) {
        if existing.identity.key != candidate.identity.key -> panic("ambiguous checked nominal type identity in Codegen input")
        if existing.module_index != candidate.module_index -> return candidate.module_index < existing.module_index
        return candidate.rank < existing.rank
    }
    true
}

// Rust `CheckedNominalFacts::compiler_owned_default_err_identity`: the unit's
// one original Prelude `Err`, the type definition carrying the DefaultErr
// marker, whichever registered module owns it.
fn jet_codegen_default_err_identity(nominals: JetCodegenNominalIndex) -> JetCodegenNominalIdentity? {
    if nominals.default_err_fault != "" -> panic(nominals.default_err_fault)
    // copy: the program index keeps its row; the caller owns its result.
    nominals.default_err.copy()
}

fn jet_codegen_qualified_nominal_name(nominals: JetCodegenNominalIndex, current_module_identity: String, name: String, generic_names: [String]) -> String Never! {
    nominal := jet_codegen_find_source_nominal_identity(nominals, current_module_identity, name, generic_names)
    if nominal == None -> return name.copy()
    value :: nominal ?? panic("checked nominal type lookup lost its unique result")
    value.qualified_name
}

// The bare `Group` is the compiler-owned task-group handle. A same-leaf Core
// nominal (`core.data::Group<K, V>`) is generic and always spelled with
// arguments, so only a declaration in the current module may claim the bare
// spelling; the leaf fallback must never turn the handle into that record.
fn jet_codegen_is_builtin_task_group(nominals: JetCodegenNominalIndex, module_identity: String, name: String) -> Bool Never! {
    if name != "Group" -> return false
    scope :: nominals.scopes.get(module_identity) ?? return true
    nominals.scope_nominals[scope].get(name) == None
}

fn jet_codegen_qualify_type(ty: Type, nominals: JetCodegenNominalIndex, module_identity: String, generic_names: [String]) -> Type Never! {
    if ty == {
        .Int -> Type.Int
        .Float -> Type.Float
        .Bool -> Type.Bool
        .String -> Type.String
        .Char -> Type.Char
        .List(inner) -> Type.List{element: jet_codegen_qualify_type(inner, nominals, module_identity, generic_names)}
        // copy: `key_span` is a payload of read parameter `ty`, which keeps the original; field `key_span` of the new Type.Map owns this one
        .Map(key, key_span, value) -> Type.Map{key: jet_codegen_qualify_type(key, nominals, module_identity, generic_names), key_span: key_span.copy(), value: jet_codegen_qualify_type(value, nominals, module_identity, generic_names)}
        .Shared(inner) -> Type.Shared{inner: jet_codegen_qualify_type(inner, nominals, module_identity, generic_names)}
        .Option(inner) -> Type.Option{inner: jet_codegen_qualify_type(inner, nominals, module_identity, generic_names)}
        .Result(ok, err) -> Type.Result{ok: jet_codegen_qualify_type(ok, nominals, module_identity, generic_names), err: jet_codegen_qualify_type(err, nominals, module_identity, generic_names)}
        .Fn(params, ret, effect_bound, param_contract, call_metadata, return_view_provenance) -> {
            lowered_params := [Type]{}
            loop param in params -> &lowered_params.push(jet_codegen_qualify_type(param, nominals, module_identity, generic_names))
            lowered_ret := Type?{None}
            if ret == {
                None -> {}
                Val(value) -> lowered_ret = Val(jet_codegen_qualify_type(value, nominals, module_identity, generic_names))
            }
            Type.Fn{params: lowered_params, ret: lowered_ret, effect_bound: effect_bound, param_contract: param_contract, call_metadata: call_metadata, return_view_provenance: return_view_provenance}
        }
        .Named(name) -> {
            if jet_codegen_is_builtin_task_group(nominals, module_identity, name) -> return Type.Named{name: name}
            Type.Named{name: jet_codegen_qualified_nominal_name(nominals, module_identity, name, generic_names)}
        }
        .Apply(name, args) -> {
            lowered_args := [Type]{}
            loop arg in args -> &lowered_args.push(jet_codegen_qualify_type(arg, nominals, module_identity, generic_names))
            Type.Apply{name: jet_codegen_qualified_nominal_name(nominals, module_identity, name, generic_names), args: lowered_args}
        }
        .TraitObject(bounds) -> {
            canonical_bounds := [String]{}
            loop name in bounds {
                // Rust tir_to_mir_types.rs lower_type: an undeclared (builtin)
                // bound keeps its bare name.
                trait_ref :: jet_codegen_resolve_trait_name(nominals.traits, name, module_identity) ?? mir_trait_ref(name)
                &canonical_bounds.push(trait_ref.name)
            }
            Type.TraitObject{bounds: canonical_bounds}
        }
        .Tuple(fields) -> {
            lowered_fields := [TypeTupleField]{}
            loop field in fields -> &lowered_fields.push(TypeTupleField{name: field.name, ty: jet_codegen_qualify_type(field.ty, nominals, module_identity, generic_names)})
            Type.Tuple{fields: lowered_fields}
        }
        // copy: `len` is a payload of read parameter `ty`, which keeps the original; field `len` of the new Type.FixedList owns this one
        .FixedList(elem, len) -> Type.FixedList{elem: jet_codegen_qualify_type(elem, nominals, module_identity, generic_names), len: len.copy()}
        .IntN(signed, bits) -> Type.IntN{signed: signed, bits: bits}
        .InlineRange(base, lo, hi) -> Type.InlineRange{base: jet_codegen_qualify_type(base, nominals, module_identity, generic_names), lo: lo, hi: hi}
        .Float32 -> Type.Float32
        // copy: `marker` is a payload of read parameter `ty`, which keeps the original; field `marker` of the new Type.Tagged owns this one
        .Tagged(marker, inner) -> Type.Tagged{marker: marker.copy(), inner: jet_codegen_qualify_type(inner, nominals, module_identity, generic_names)}
        .Union(members) -> {
            lowered_members := [Type]{}
            loop member in members -> &lowered_members.push(jet_codegen_qualify_type(member, nominals, module_identity, generic_names))
            Type.Union{members: lowered_members}
        }
        // copy: `dimension` is a payload of read parameter `ty`, which keeps the original; field `dimension` of the new Type.Quantity owns this one
        .Quantity(base, dimension) -> Type.Quantity{base: jet_codegen_qualify_type(base, nominals, module_identity, generic_names), dimension: dimension.copy()}
        // copy: `measure` is a payload of read parameter `ty`, which keeps the original; field `measure` of the new Type.Measure owns this one
        .Measure(measure) -> Type.Measure{measure: measure.copy()}
    }
}

fn jet_codegen_type_instance_id(ty: Type, nominals: JetCodegenNominalIndex, module_identity: String, generic_names: [String]) -> MIRTypeID Never! {
    if ty == {
        .Named(name) -> {
            nominal := jet_codegen_find_nominal_identity(nominals, module_identity, name, generic_names)
            if nominal == .Val(value) {
                return mir_type_id(value.key)
            }
        }
        .Apply(name, args) -> {
            if args.len() == 0 {
                nominal := jet_codegen_find_nominal_identity(nominals, module_identity, name, generic_names)
                if nominal == .Val(value) {
                    return mir_type_id(value.key)
                }
            }
        }
        else -> {}
    }
    mir_type_id(type_mir_identity_key(ty))
}

fn jet_codegen_lower_type(ty: Type) -> MIRType Never! {
    jet_codegen_lower_type_with_nominals(ty, jet_codegen_nominal_index([SemaGraphModuleResult]{}), "", [String]{})
}

fn jet_codegen_lower_type_for_function(ty: Type, builder: JetCodegenBuilder, program: JetCodegenProgram) -> MIRType Never! {
    lowered :: jet_codegen_lower_type_with_nominals(ty, program.nominals, builder.function.module_identity, builder.generic_type_names)
    if jet_codegen_journal_requested(program, "mir.lower-type") {
        input :: canonical_pass_debug_snapshot("tir", "mir.lower-type", "{ty}")
        output :: canonical_pass_debug_snapshot("mir", "mir.lower-type", "{lowered}")
        jet_codegen_journal_record(program, "mir.lower-type", "crates/jet-codegen/src/Codegen/TIR/tir_to_mir_types.rs", input, output)
    }
    lowered
}

fn jet_codegen_lower_type_with_nominals(ty: Type, nominals: JetCodegenNominalIndex, module_identity: String, generic_names: [String]) -> MIRType Never! {
    canonical :: jet_codegen_qualify_type(ty, nominals, module_identity, generic_names)
    jet_codegen_lower_canonical_type(canonical, nominals, module_identity, generic_names)
}

fn jet_codegen_lower_canonical_type(canonical: Type, nominals: JetCodegenNominalIndex, module_identity: String, generic_names: [String]) -> MIRType Never! {
    kind :: if canonical == {
        .Int -> MIRTypeKind.Int
        .Float -> MIRTypeKind.Float
        .Bool -> MIRTypeKind.Bool
        .String -> MIRTypeKind.String
        .Char -> MIRTypeKind.Char
        .List(inner) -> MIRTypeKind.List{inner: jet_codegen_lower_canonical_type(inner, nominals, module_identity, generic_names)}
        .Map(key, _, value) -> MIRTypeKind.Map{key: jet_codegen_lower_canonical_type(key, nominals, module_identity, generic_names), value: jet_codegen_lower_canonical_type(value, nominals, module_identity, generic_names)}
        .Shared(inner) -> MIRTypeKind.Shared{inner: jet_codegen_lower_canonical_type(inner, nominals, module_identity, generic_names)}
        .Option(inner) -> MIRTypeKind.Option{inner: jet_codegen_lower_canonical_type(inner, nominals, module_identity, generic_names)}
        .Result(ok, err) -> MIRTypeKind.Result{ok: jet_codegen_lower_canonical_type(ok, nominals, module_identity, generic_names), err: jet_codegen_lower_canonical_type(err, nominals, module_identity, generic_names)}
        .Fn(params, ret, effect_bound, param_contract, call_metadata, return_view_provenance) -> {
            lowered_params := [MIRType]{}
            loop param in params -> &lowered_params.push(jet_codegen_lower_canonical_type(param, nominals, module_identity, generic_names))
            lowered_ret := MIRType?{None}
            if ret == {
                None -> {}
                Val(value) -> lowered_ret = Val(jet_codegen_lower_canonical_type(value, nominals, module_identity, generic_names))
            }
            MIRTypeKind.Fn{signature: MIRFunctionSignature{
                params: lowered_params,
                ret: lowered_ret,
                effect_bound: jet_codegen_lower_effect_bound(effect_bound),
                param_contract: jet_codegen_lower_call_contract(param_contract),
                call_metadata: jet_codegen_lower_function_call_metadata(call_metadata),
                return_view_provenance: jet_codegen_lower_view_provenance_map(return_view_provenance),
            }}
        }
        .Named(name) -> MIRTypeKind.Apply{name: mir_nominal_ref(name), args: [MIRType]{}}
        .Apply(name, args) -> {
            lowered_args := [MIRType]{}
            loop arg in args -> &lowered_args.push(jet_codegen_lower_canonical_type(arg, nominals, module_identity, generic_names))
            MIRTypeKind.Apply{name: mir_nominal_ref(name), args: lowered_args}
        }
        .TraitObject(bounds) -> {
            lowered_bounds := [MIRTraitRef]{}
            loop name in bounds {
                trait_ref :: jet_codegen_resolve_trait_name(nominals.traits, name, module_identity) ?? mir_trait_ref(name)
                &lowered_bounds.push(trait_ref)
            }
            MIRTypeKind.TraitObject{bounds: lowered_bounds}
        }
        .Tuple(fields) -> {
            lowered_fields := [MIRTupleField]{}
            loop field in fields -> &lowered_fields.push(MIRTupleField{name: field.name, ty: jet_codegen_lower_canonical_type(field.ty, nominals, module_identity, generic_names)})
            MIRTypeKind.Tuple{fields: lowered_fields}
        }
        .FixedList(elem, len) -> MIRTypeKind.FixedList{elem: jet_codegen_lower_canonical_type(elem, nominals, module_identity, generic_names), len: jet_codegen_lower_measure(len)}
        .IntN(signed, bits) -> MIRTypeKind.IntN{signed: signed, bits: bits}
        .InlineRange(base, lo, hi) -> MIRTypeKind.InlineRange{base: jet_codegen_lower_canonical_type(base, nominals, module_identity, generic_names), lo: lo, hi: hi}
        .Float32 -> MIRTypeKind.Float32
        .Tagged(marker, inner) -> MIRTypeKind.Tagged{marker: jet_codegen_lower_tag_marker(marker), inner: jet_codegen_lower_canonical_type(inner, nominals, module_identity, generic_names)}
        .Union(members) -> {
            lowered_members := [MIRType]{}
            loop member in members -> &lowered_members.push(jet_codegen_lower_canonical_type(member, nominals, module_identity, generic_names))
            MIRTypeKind.Union{members: lowered_members}
        }
        .Quantity(base, dimension) -> MIRTypeKind.Quantity{base: jet_codegen_lower_canonical_type(base, nominals, module_identity, generic_names), dimension: jet_codegen_lower_dimension(dimension)}
        .Measure(measure) -> MIRTypeKind.Measure{value: jet_codegen_lower_measure(measure)}
    }
    mir_type_with_identity(mir_type_from_kind(kind), jet_codegen_type_instance_id(canonical, nominals, module_identity, generic_names))
}

fn jet_codegen_lower_measure(measure: Measure) -> MIRMeasure Never! {
    if measure == {
        .Literal(kind, value) -> MIRMeasure.Literal{kind: kind, value: value}
        .SignedLiteral(kind, value) -> MIRMeasure.SignedLiteral{kind: kind, value: value}
        .Symbol(kind, name) -> MIRMeasure.Symbol{kind: kind, name: name}
        .Combined(kind, rule, left, right) -> {
            lowered_rule := if rule == {
                .Add -> MIRMeasureRule.Add
                .Mul -> MIRMeasureRule.Mul
                .Match -> MIRMeasureRule.Match
            }
            MIRMeasure.Combined{kind: kind, rule: lowered_rule, left: jet_codegen_lower_measure(left), right: jet_codegen_lower_measure(right)}
        }
    }
}

fn jet_codegen_lower_dimension(dimension: Dimension) -> MIRDimension Never! {
    axes := [MIRDimensionAxis]{}
    loop axis in dimension.axes -> &axes.push(MIRDimensionAxis{name: axis.name, exponent: jet_codegen_lower_measure(axis.exponent)})
    MIRDimension{axes: axes}
}

fn jet_codegen_lower_tag_marker(marker: TagMarker) -> MIRTagMarker Never! {
    if marker == {
        .User(name) -> MIRTagMarker.User{name: name}
        .Internal(tag_value) -> {
            if tag_value == {
                .CoreCryptoNominal -> MIRTagMarker.Internal{internal_tag: MIRInternalTag.CoreCryptoNominal}
                .DeterministicClock -> MIRTagMarker.Internal{internal_tag: MIRInternalTag.DeterministicClock}
                .SystemClock -> MIRTagMarker.Internal{internal_tag: MIRInternalTag.SystemClock}
                .ExpiringSecretLoan -> MIRTagMarker.Internal{internal_tag: MIRInternalTag.ExpiringSecretLoan}
                .SharedGuardRead -> MIRTagMarker.Internal{internal_tag: MIRInternalTag.SharedGuardRead}
                .SharedGuardEdit -> MIRTagMarker.Internal{internal_tag: MIRInternalTag.SharedGuardEdit}
                .TerminalFactSet -> MIRTagMarker.Internal{internal_tag: MIRInternalTag.TerminalFactSet}
                .CppCallbackABI -> MIRTagMarker.Internal{internal_tag: MIRInternalTag.CppCallbackABI}
                .AllocatorView -> MIRTagMarker.Internal{internal_tag: MIRInternalTag.AllocatorView}
            }
        }
    }
}

fn jet_codegen_lower_effect_bound(bound: [EffectRowEntry]?) -> [String]? {
    if bound == None -> return None
    effects := [String]{}
    loop entry in (bound) { &effects.push(entry.name) }
    Val(effects)
}

fn jet_codegen_lower_call_contract(contract: [CallContractRow]?) -> [MIRCallContractRow]? {
    if contract == None -> return None
    rows := [MIRCallContractRow]{}
    loop row in (contract) { &rows.push(MIRCallContractRow{label: row.label, zone: row.zone}) }
    Val(rows)
}

fn jet_codegen_lower_function_call_metadata(metadata: FunctionCallMetadata?) -> MIRCallMetadata? {
    if metadata == None -> return None
    source :: metadata
    defaults := [Bool]{}
    loop default in source.defaults -> &defaults.push(default != None)
    conventions := [MIRAccess]{}
    loop convention in source.conventions -> &conventions.push(jet_codegen_lower_access(convention))
    policies := [MIRCallablePolicy]{}
    loop policy in source.policies.policies -> &policies.push(MIRCallablePolicy{name: policy.name, arguments: policy.arguments})
    Val(MIRCallMetadata{
        names: source.names,
        defaults: defaults,
        variadic: source.variadic,
        conventions: conventions,
        policies: MIRCallablePolicyChain{policies: policies},
    })
}

fn jet_codegen_lower_access(access: AccessConvention) -> MIRAccess Never! {
    if access == {
        .Read -> MIRAccess.Read
        .Write -> MIRAccess.Write
        .Move -> MIRAccess.Move
    }
}

fn jet_codegen_lower_view_provenance_map(provenance: ViewProvenanceMap?) -> [MIRViewProvenanceEntry]? {
    if provenance == None -> return None
    rows := [MIRViewProvenanceEntry]{}
    loop entry in (provenance).entries {
        sources := [MIRViewSourcePath]{}
        loop path in entry.value.sources {
            source :: if path.source == {
                .Receiver -> MIRViewSource.Receiver
                .Parameter(index) -> MIRViewSource.Parameter{index: index}
                .Static(module_path, name) -> MIRViewSource.Static{module_path: module_path, name: name}
            }
            projections := [MIRViewProjection]{}
            loop projection in path.projections {
                if projection == {
                    .Field(name) -> &projections.push(MIRViewProjection.Field{name: name})
                    .Index -> &projections.push(MIRViewProjection.Index)
                    .Range -> &projections.push(MIRViewProjection.Range)
                }
            }
            &sources.push(MIRViewSourcePath{source: source, projections: projections})
        }
        value :: MIRViewProvenance{sources: sources, mutable: entry.value.mutable}
        &rows.push(MIRViewProvenanceEntry{slot: entry.slot, provenance: value})
    }
    Val(rows)
}

struct JetCodegenResolvedField {
    owner_key: String
    field_name: String
}

// One registered nominal field, keyed in the program index by its field
// symbol key so each checked TFieldRef resolves without rescanning every
// module's nominals.
struct JetCodegenFieldSymbolRow {
    owner_key: String
    name: String
    resolved: JetCodegenResolvedField
    // A stored field of a nominal struct (jet_codegen_is_stored_struct_field):
    // computed fields and enum payload fields are not.
    stored: Bool
}

// Built once per lowered program; rows keep module, nominal and field order.
fn jet_codegen_field_symbol_index(modules: [SemaGraphModuleResult]) -> [String:[JetCodegenFieldSymbolRow]] Never! {
    index := [String:[JetCodegenFieldSymbolRow]]{}
    loop semantic_module in modules {
        loop nominal in semantic_module.nominals {
            loop field in nominal.fields {
                rows := index.get(field.symbol.id.key) ?? [JetCodegenFieldSymbolRow]{}
                &rows.push(JetCodegenFieldSymbolRow{
                    owner_key: nominal.symbol.id.key,
                    name: field.symbol.name,
                    resolved: JetCodegenResolvedField{
                        owner_key: jet_codegen_nominal_type_key(semantic_module.module_identity, nominal),
                        field_name: field.symbol.name,
                    },
                    stored: nominal.kind == SemaRegistrationNominalKind.Struct && !field.computed,
                })
                index[field.symbol.id.key] = rows
            }
        }
    }
    index
}

// A reference with a declared owner; an open owner resolves from the
// receiver type instead (`jet_codegen_field_ref_id`).
fn jet_codegen_resolve_field_by_symbol(field_symbols: [String:[JetCodegenFieldSymbolRow]], reference: TFieldRef) -> JetCodegenResolvedField Never! {
    owner :: reference.owner ?? panic("checked TFieldRef has no declared owner")
    resolved := JetCodegenResolvedField?{None}
    rows :: field_symbols.get(reference.field.key) ?? [JetCodegenFieldSymbolRow]{}
    loop row in rows {
        if row.owner_key != owner.key -> next
        if row.name != reference.name -> panic("checked field reference name disagrees with its registered symbol")
        if resolved != None -> panic("ambiguous checked field symbol in Codegen input")
        resolved = Val(row.resolved)
    }
    resolved ?? panic("checked TFieldRef has no registered nominal field")
}

// The compiler-owned `Range` record a range value constructs. It has no
// source declaration; Codegen adds its row to every program
// (`jet_codegen_compiler_owned_record_definition`) under its bare canonical key.
// Rust: crates/jet-codegen/src/Codegen/TIR/tir_to_mir_types.rs::compiler_owned_type_defs
JET_CODEGEN_RANGE_RECORD :: "Range"

// The compiler-owned `ParseError` alias (`jet_codegen_parse_error_alias_definition`).
// Rust: crates/jet-codegen/src/Codegen/TIR/tir_to_mir_types.rs::compiler_owned_parse_error
JET_CODEGEN_PARSE_ERROR_ALIAS :: "ParseError"

fn jet_codegen_range_record_fields() -> [TypeTupleField] Never! {
    [TypeTupleField]{
        {name: "start", ty: Type.Int},
        {name: "end", ty: Type.Int},
        {name: "exclusive", ty: Type.Bool},
    }
}

fn jet_codegen_range_record_field_id(member: String) -> MIRFieldID Never! {
    field :: jet_codegen_compiler_owned_record_field(JET_CODEGEN_RANGE_RECORD, member) ?? panic("compiler-owned Range record has no field `{member}`")
    jet_codegen_mir_field_id(JetCodegenResolvedField{owner_key: JET_CODEGEN_RANGE_RECORD, field_name: field.name})
}

// One compiler-owned Core record: its bare canonical name and the Core record
// oracle's field vocabulary, in row order.
struct JetCodegenCompilerOwnedRecord {
    name: String
    fields: [String]
}

// Compiler-owned Core records (`ProcessReceipt`, `IOContext`, ...) are checked
// runtime values with no Jet declaration. Like `Range`, each joins every
// program as one row under its bare canonical key
// (`jet_codegen_compiler_owned_record_definition`), so a field projection on
// one resolves to the same nominal identity as in Rust. Field types are read
// from the Core record rows (`core_record_field`), never guessed. The rows
// carry no `MarkerArgInfo.value` (its type is computed from the policy rule
// argument declarations), so neither does this table.
// Rust: crates/jet-codegen/src/Codegen/TIR/tir_to_mir_types.rs::COMPILER_OWNED_CORE_RECORDS
