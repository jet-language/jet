// Rust: crates/jet-codegen/src/Codegen/TIR/tir_to_mir_types.rs::compiler_owned_core_record
fn jet_codegen_compiler_owned_core_record_fields(record: JetCodegenCompilerOwnedRecord) -> [TypeTupleField] Never! {
    fields := [TypeTupleField]{}
    loop field in record.fields {
        ty :: core_record_field(record.name, field) ?? panic("missing canonical Core field {record.name}.{field}")
        &fields.push(TypeTupleField{name: field, ty: ty})
    }
    fields
}

// The fields of the compiler-owned record row spelled `name` (`Range` or a
// Core record), or None when no such row exists. Callers resolve declared
// nominals first, as Rust's rows dedupe by key in favour of declarations.
fn jet_codegen_compiler_owned_record_fields(name: String) -> [TypeTupleField]? Never! {
    if name == JET_CODEGEN_RANGE_RECORD -> return Val(jet_codegen_range_record_fields())
    loop record in JET_CODEGEN_COMPILER_OWNED_CORE_RECORDS {
        if record.name == name -> return Val(jet_codegen_compiler_owned_core_record_fields(record))
    }
    None
}

fn jet_codegen_compiler_owned_record_field(owner_name: String, member: String) -> TypeTupleField? Never! {
    fields :: jet_codegen_compiler_owned_record_fields(owner_name) ?? return None
    loop field in fields {
        if field.name == member -> return Val(field)
    }
    None
}

fn jet_codegen_resolve_field_by_name(modules: [SemaGraphModuleResult], current_module_identity: String, generic_names: [String], owner_type: Type, member: String) -> JetCodegenResolvedField Never! {
    owner_name :: if owner_type == {
        .Named(name) -> name
        .Apply(name, _) -> name
        else -> panic("checked field access owner is not a nominal type")
    }
    identity := jet_codegen_find_nominal_identity(modules, current_module_identity, owner_name, generic_names)
    if identity == None && jet_codegen_compiler_owned_record_fields(owner_name) == .Val(fields) {
        loop field in fields {
            if field.name == member -> return JetCodegenResolvedField{module_identity: "", nominal_name: owner_name, field_name: field.name}
        }
        panic("checked field access member has no registered field")
    }
    nominal_identity :: identity ?? panic("checked field access owner has no registered nominal type")
    loop semantic_module in modules {
        if semantic_module.module_identity != nominal_identity.module_identity -> next
        loop nominal in semantic_module.nominals {
            if nominal.symbol.name != nominal_identity.name -> next
            loop field in nominal.fields {
                if field.symbol.name == member {
                    return JetCodegenResolvedField{
                        module_identity: semantic_module.module_identity,
                        nominal_name: nominal.symbol.name,
                        field_name: field.symbol.name,
                    }
                }
            }
            panic("checked field access member has no registered field")
        }
    }
    panic("checked field access nominal disappeared from Codegen input")
}

// Build the checked field reference that Sema would have produced for
// `owner_type.member`, for TIR that Codegen synthesizes itself.
fn jet_codegen_field_ref_by_name(modules: [SemaGraphModuleResult], current_module_identity: String, generic_names: [String], owner_type: Type, member: String, ty: Type) -> TFieldRef Never! {
    resolved :: jet_codegen_resolve_field_by_name(modules, current_module_identity, generic_names, owner_type, member)
    loop semantic_module in modules {
        if semantic_module.module_identity != resolved.module_identity -> next
        loop nominal in semantic_module.nominals {
            if nominal.symbol.name != resolved.nominal_name -> next
            loop field in nominal.fields {
                if field.symbol.name == member -> return TFieldRef{owner: Val(nominal.symbol.id), field: field.symbol.id, name: member, ty: ty, boxed: false}
            }
        }
    }
    panic("checked field access member has no registered field")
}

fn jet_codegen_mir_field_id(field: JetCodegenResolvedField) -> MIRFieldID Never! {
    mir_field_id("{jet_codegen_qualified_type_key(field.module_identity, field.nominal_name)}::{field.field_name}")
}

fn jet_codegen_mir_type_id_for_symbol(modules: [SemaGraphModuleResult], symbol: SymbolID) -> MIRTypeID Never! {
    loop semantic_module in modules {
        loop nominal in semantic_module.nominals {
            if nominal.symbol.id.key == symbol.key -> return mir_type_id(jet_codegen_nominal_type_key(semantic_module.module_identity, nominal))
        }
        loop owner in semantic_module.declarations.core_builtin_owners {
            candidate :: jet_codegen_core_owner_identity(owner, semantic_module)
            if owner.symbol.key == symbol.key -> return mir_type_id(candidate.key)
        }
    }
    panic("checked type symbol has no registered nominal or builtin owner declaration")
}

fn jet_codegen_mir_type_id_for_type(modules: [SemaGraphModuleResult], current_module_identity: String, generic_names: [String], ty: Type) -> MIRTypeID Never! {
    name :: if ty == {
        .Named(value) -> value
        .Apply(value, _) -> value
        else -> panic("checked declaration owner is not a nominal type")
    }
    identity := jet_codegen_find_nominal_identity(modules, current_module_identity, name, generic_names)
    value :: identity ?? panic("checked declaration owner has no registered nominal identity")
    mir_type_id(value.key)
}

fn jet_codegen_mir_trait_ref_for_symbol(modules: [SemaGraphModuleResult], symbol: SymbolID) -> MIRTraitRef Never! {
    loop semantic_module in modules {
        loop nominal in semantic_module.nominals {
            if nominal.symbol.id.key == symbol.key {
                name :: jet_codegen_qualified_type_key(semantic_module.module_identity, nominal.symbol.name)
                return jet_codegen_resolve_trait_ref(modules, name, semantic_module.module_identity) ?? panic("checked trait symbol has no registered trait definition")
            }
        }
    }
    panic("checked trait symbol has no registered nominal declaration")
}

