    {name: "OriginInfo", fields: [String]{"tracked", "source", "line", "column", "ambiguity"}},
    {name: "UnitScaleProvenanceInfo", fields: [String]{"kind", "value", "source", "uncertainty"}},
    {name: "MaturityInfo", fields: [String]{"level"}},
    {name: "DimensionInfo", fields: [String]{"axes", "identity", "display"}},
    {name: "DimensionAxis", fields: [String]{"name", "exponent"}},
    {name: "FunctionInfo", fields: [String]{"name", "module", "identity", "params", "span", "effects", "reaches_panic", "arithmetic", "facts"}},
    {name: "ArithmeticOperationInfo", fields: [String]{"operation", "policy", "operation_span", "scope_span"}},
    {name: "PackageInfo", fields: [String]{"name", "identity", "types", "functions"}},
    {name: "EffectInfo", fields: [String]{"values"}},
    {name: "MethodInfo", fields: [String]{"name", "module", "identity", "return_type", "signature", "params", "effects", "markers", "dimensions", "facts", "arithmetic", "is_pub", "span"}},
    {name: "FieldInfo", fields: [String]{"name", "ty", "index", "fields", "markers", "dimensions", "facts", "is_pub", "span"}},
    {name: "TypeParamInfo", fields: [String]{"name", "bounds", "span"}},
    {name: "SourceSpan", fields: [String]{"start", "end"}},
    {name: "TLSPeerIdentity", fields: [String]{"verified_server_name", "leaf", "certificate_chain", "cipher_suite", "tls_version"}},
    {name: "TLSCertificate", fields: [String]{"der", "sha256", "spki_sha256", "dns_names", "valid_from_unix_ms", "valid_until_unix_ms", "subject", "issuer"}},
    {name: "ModGrant", fields: [String]{"read"}},
} }

// Rust: crates/jet-codegen/src/Codegen/TIR/tir_to_mir_types.rs::compiler_owned_core_record
fn jet_codegen_compiler_owned_core_record_fields(record: JetCodegenCompilerOwnedRecord) -> [TypeTupleField] Never! {
    fields := [TypeTupleField]{}
    loop field in record.fields {
        ty :: core_record_field(record.name, field) ?? panic("missing canonical Core field {record.name}.{field}")
        &fields.push(TypeTupleField{name: field, ty: ty})
    }
    fields
}

// The fields of the compiler-owned record row spelled `name`, written over the
// row's own type parameters (`jet_codegen_compiler_owned_generic_params`), or
// None when no such row exists. Rows follow Rust compiler_owned_type_defs:
// `FieldError`, `Range`, the generic Core carriers, the geometry records, the
// keyed-vault records, the data summaries, `AllocError`,
// `VJPRun`, the Core records and the math records. Callers resolve declared
// nominals first, as Rust's rows dedupe by key in favour of declarations.
fn jet_codegen_compiler_owned_record_fields(name: String) -> [TypeTupleField]? Never! {
    if name == JET_CODEGEN_RANGE_RECORD -> return Val(jet_codegen_range_record_fields())
    t :: Type.Named{name: "T"}
    bytes :: Type.List{element: Type.IntN{signed: false, bits: 8}}
    if name == "FieldError" -> return Val(jet_codegen_compiler_owned_core_record_fields(JetCodegenCompilerOwnedRecord{name: name, fields: [String]{"path", "reason"}}))
    if name == "DataJoin" -> return Val([TypeTupleField]{TypeTupleField{name: "left", ty: Type.Named{name: "L"}}, TypeTupleField{name: "right", ty: Type.Named{name: "R"}}})
    if name == "Group" -> return Val([TypeTupleField]{TypeTupleField{name: "key", ty: Type.Named{name: "K"}}, TypeTupleField{name: "value", ty: Type.Named{name: "V"}}})
    if name == "DataSnapshot" {
        return Val([TypeTupleField]{
            {name: "value", ty: t},
            {name: "identity", ty: Type.Named{name: "DataSnapshotIdentity"}},
            {name: "provenance", ty: Type.Named{name: "DataProvenance"}},
            {name: "schema", ty: Type.Named{name: "DataSchema"}},
            {name: "status", ty: Type.Named{name: "DataLoaderStatus"}},
            {name: "content", ty: bytes},
        })
    }
    if name == "Point2" || name == "Delta2" -> return Val([TypeTupleField]{TypeTupleField{name: "x", ty: t}, TypeTupleField{name: "y", ty: t}})
    if name == "Ray2" {
        space :: Type.Named{name: "To"}
        return Val([TypeTupleField]{
            {name: "origin", ty: Type.Apply{name: "Point2", args: [Type]{t, space}}},
            {name: "direction", ty: Type.Apply{name: "Delta2", args: [Type]{t, space}}},
        })
    }
    if name == "Transform" || name == "Transform2" {
        scalar :: if name == "Transform" -> Type.Float else -> t
        names :: [String]{"m00", "m01", "m10", "m11", "tx", "ty"}
        fields := [TypeTupleField]{}
        loop field in names -> &fields.push(TypeTupleField{name: field, ty: scalar})
        return Val(fields)
    }
    if JET_CODEGEN_COMPILER_OWNED_GEOMETRY_POINTS.contains(name) -> return Val(jet_codegen_compiler_owned_core_record_fields(JetCodegenCompilerOwnedRecord{name: name, fields: [String]{"x", "y"}}))
    if name == "KeyRef" || name == "MutationPlan" || name == "VaultWrite" -> return Val([TypeTupleField]{})
    if name == "Rotation" {
        key :: Type.Apply{name: "KeyRef", args: [Type]{t}}
        return Val([TypeTupleField]{TypeTupleField{name: "previous", ty: key}, TypeTupleField{name: "current", ty: key}})
    }
    if name == "DataPivotCell" -> return Val(jet_codegen_compiler_owned_core_record_fields(JetCodegenCompilerOwnedRecord{name: name, fields: [String]{"row_key", "column_key", "count", "sum", "mean"}}))
    if name == "AllocError" -> return Val(jet_codegen_compiler_owned_core_record_fields(JetCodegenCompilerOwnedRecord{name: name, fields: [String]{"requested_bytes", "allocator"}}))
    if name == "DataSummary" -> return Val(jet_codegen_compiler_owned_core_record_fields(JetCodegenCompilerOwnedRecord{name: name, fields: [String]{"count", "sum", "mean", "min", "max", "median", "variance", "stddev"}}))
    if name == "VJPRun" {
        tensor :: Type.Named{name: "Tensor"}
        return Val([TypeTupleField]{
            {name: "value", ty: tensor},
            {name: "pull", ty: Type.Fn{params: [Type]{tensor}, ret: Val(t), effect_bound: None, param_contract: None, call_metadata: None, return_view_provenance: None}},
            {name: "grads", ty: Type.Fn{params: [Type]{}, ret: Val(t), effect_bound: None, param_contract: None, call_metadata: None, return_view_provenance: None}},
        })
    }
    loop record in JET_CODEGEN_COMPILER_OWNED_CORE_RECORDS {
        if record.name == name -> return Val(jet_codegen_compiler_owned_core_record_fields(record))
    }
    loop record in JET_CODEGEN_COMPILER_OWNED_MATH_RECORDS {
        if record.name != name -> next
        scalar :: jet_codegen_math_scalar_type(name)
        fields := [TypeTupleField]{}
        loop field in record.fields -> &fields.push(TypeTupleField{name: field, ty: scalar})
        return Val(fields)
    }
    None
}

fn jet_codegen_compiler_owned_record_field(owner_name: String, member: String) -> TypeTupleField? Never! {
    fields :: jet_codegen_compiler_owned_record_fields(owner_name) ?? return None
    loop field in fields {
        if field.name == member -> return Val(field)
    }
    None
}

// The declared type of `owner.member` on a compiler-owned record row, its type
// parameters replaced by the receiver's arguments (an `Apply` owner).
fn jet_codegen_compiler_owned_record_field_type(owner: Type, owner_name: String, member: String) -> Type? Never! {
    field :: jet_codegen_compiler_owned_record_field(owner_name, member) ?? return None
    generic_names :: jet_codegen_compiler_owned_generic_params(owner_name)
    if generic_names.len() == 0 -> return Val(field.ty)
    generic_args := if owner == {
        .Apply(_, args) -> args
        else -> [Type]{}
    }
    if generic_names.len() != generic_args.len() -> panic("checked compiler-owned {owner_name} projection has incomplete generic owner arguments")
    Val(sema_inference_substitute_type(field.ty, generic_names, generic_args))
}

// The non-generic geometry carriers (Rust COMPILER_OWNED_GEOMETRY_RECORDS
// rows without type parameters); their `x`/`y` types are Core record rows.
JET_CODEGEN_COMPILER_OWNED_GEOMETRY_POINTS :: prep { [String]{
    "ScreenPoint", "WorldPoint", "ViewPoint", "CameraPoint", "DevicePoint",
    "ScreenDelta", "WorldDelta", "ViewDelta", "CameraDelta", "DeviceDelta",
} }

// Rust: crates/jet-codegen/src/Codegen/TIR/tir_to_mir_types.rs::COMPILER_OWNED_MATH_RECORDS
// (each field is the type's scalar, Rust `math_scalar_ty`).
JET_CODEGEN_COMPILER_OWNED_MATH_RECORDS :: prep { [JetCodegenCompilerOwnedRecord]{
    {name: "F32x4", fields: [String]{"x", "y", "z", "w"}},
    {name: "F64x2", fields: [String]{"x", "y"}},
    {name: "Vec2", fields: [String]{"x", "y"}},
    {name: "Vec3", fields: [String]{"x", "y", "z"}},
    {name: "Vec4", fields: [String]{"x", "y", "z", "w"}},
} }

// The carrier record rows of Rust compiler_owned_type_defs between `Range`
// and the Core records (generic Core carriers, geometry, keyed vault,
// data summaries, `AllocError`, `VJPRun`), in program order.
JET_CODEGEN_COMPILER_OWNED_CARRIER_RECORDS :: prep { [String]{
    "DataJoin", "Group", "DataSnapshot",
    "Point2", "Delta2", "ScreenPoint", "WorldPoint", "ViewPoint", "CameraPoint", "DevicePoint",
    "ScreenDelta", "WorldDelta", "ViewDelta", "CameraDelta", "DeviceDelta", "Ray2", "Transform", "Transform2",
    "KeyRef", "MutationPlan", "VaultWrite", "Rotation", "DataPivotCell", "AllocError", "DataSummary", "VJPRun",
} }

// The type parameters of a compiler-owned row (Rust compiler_owned_type_defs
// `generic_params`); empty for every other row.
fn jet_codegen_compiler_owned_generic_params(name: String) -> [String] Never! {
    if name == "HookDecision" || name == "HookOutcome" -> return [String]{"T", "E"}
    if name == "DataJoin" -> return [String]{"L", "R"}
    if name == "Group" -> return [String]{"K", "V"}
    if name == "Point2" || name == "Delta2" -> return [String]{"T", "Space"}
    if name == "Ray2" || name == "Transform2" -> return [String]{"T", "From", "To"}
    if name == "Transform" -> return [String]{"From", "To"}
    if name == "DataSnapshot" || name == "KeyRef" || name == "MutationPlan" || name == "VaultWrite" || name == "Rotation" || name == "VJPRun" -> return [String]{"T"}
    [String]{}
}

// One compiler-owned runtime enum: its bare canonical name and its variants
// in declaration order; payloads are `jet_codegen_compiler_owned_enum_payload`.
struct JetCodegenCompilerOwnedEnum {
    name: String
    variants: [String]
}

// Compiler-owned runtime enums (`ProcessStreamMode`, `IOError`, `Key`, ...)
// are checked values with no Jet declaration. Each joins every program as one
// row under its bare canonical key, so an enum literal, a variant pattern and
// the backends name the same MIR type as in Rust.
// Rust: crates/jet-codegen/src/Codegen/TIR/tir_to_mir_types.rs::COMPILER_OWNED_ENUMS
JET_CODEGEN_COMPILER_OWNED_ENUMS :: prep { [JetCodegenCompilerOwnedEnum]{
    {name: "Overflow", variants: [String]{"Block", "DropNewest", "DropOldest"}},
    {name: "FailurePolicy", variants: [String]{"StopFirst", "Collect", "Log", "Ignore"}},
    {name: "HookPolicy", variants: [String]{"FirstCancelElseTransform"}},
    {name: "HookOutcome", variants: [String]{"Continue", "Cancel", "Fail"}},
    {name: "HookDecision", variants: [String]{"Continue", "Transform", "Cancel", "Fail"}},
    {name: "DispatchState", variants: [String]{"Delivered", "HandlerFailed", "DroppedNewest", "DroppedOldest", "Closed", "Cancelled", "DeadlineExceeded"}},
    {name: "Ordering", variants: [String]{"Less", "Equal", "Greater"}},
    {name: "RemoveBy", variants: [String]{"Val", "Slot"}},
    {name: "TaskFailure", variants: [String]{"Cancelled", "DeadlineBlown", "Panicked"}},
    {name: "TaskOutcome", variants: [String]{"Finished", "Panicked", "Cancelled", "DeadlineBlown"}},
    {name: "TaskStatus", variants: [String]{"Running", "Paused", "CancelRequested"}},
    {name: "DeliveryState", variants: [String]{"Pending", "Accepted", "Delivering", "Delivered", "DeadLettered", "Cancelled"}},
    {name: "IOError", variants: [String]{"InvalidInput", "NotFound", "PermissionDenied", "TimedOut", "Cancelled", "Closed", "Protocol", "Other", "ResourceLimit", "AlreadyExists", "Unsupported"}},
    {name: "Key", variants: [String]{"Char", "Enter", "Escape", "Backspace", "Tab", "Delete", "Up", "Down", "Left", "Right", "F", "Ctrl", "Unknown"}},
    {name: "IOOperation", variants: [String]{"Read", "Write", "Flush", "Connect", "Accept", "Close", "Resolve", "Codec"}},
    {name: "ProcessResourceLimit", variants: [String]{"WallTime", "CpuTime", "Memory", "OpenFiles", "Output"}},
    {name: "ProcessStreamMode", variants: [String]{"Stream", "Inherit", "Capture"}},
    {name: "TerminalMode", variants: [String]{"Raw", "Cooked"}},
    {name: "DurationUnit", variants: [String]{"Nanoseconds", "Microseconds", "Milliseconds", "Seconds", "Minutes", "Hours"}},
    {name: "FontStyle", variants: [String]{"Body", "Title", "Monospace"}},
    {name: "GlyphShaper", variants: [String]{"HarfBuzz", "HeadlessFallback"}},
    {name: "WebFormValueType", variants: [String]{"String", "Int", "Bool", "Float"}},
    {name: "WebFormControl", variants: [String]{"Text", "Email", "URL", "Password", "Number", "Date", "Checkbox", "Hidden"}},
    {name: "DataLoaderKind", variants: [String]{"File", "URL", "Database", "Value"}},
    {name: "DataErrorKind", variants: [String]{"Decode", "Limit", "IO", "Empty", "InvalidArgument", "NonFinite", "Overflow", "State", "Bridge", "Unsupported", "DuplicateKey", "MissingKey", "WrongOwner", "StaleRevision", "InvalidValue"}},
    {name: "DataFormat", variants: [String]{"CSV", "JSON", "JSONL", "Parquet", "Arrow"}},
    {name: "DataFreshness", variants: [String]{"Pending", "Fresh", "Stale", "Error", "Offline", "Cancelled"}},
    {name: "DataInvalidationCause", variants: [String]{"NoCause", "Loader", "Input", "ArchiveMember", "Parameters", "Credential", "Capability", "Manual"}},
    {name: "Dyn", variants: [String]{"Null", "Bool", "Int", "Float", "Number", "Text", "Bytes", "DateTime", "Array", "Object"}},
    {name: "DataEvent", variants: [String]{"Null", "Bool", "Int", "Float", "Number", "Text", "Bytes", "ArrayStart", "ArrayEnd", "ObjectStart", "Key", "ObjectEnd"}},
    {name: "XMLCanonicalMode", variants: [String]{"Inclusive11", "Exclusive10"}},
    {name: "PluginLimit", variants: [String]{"Fuel", "Memory", "Table", "Time", "Wire"}},
    {name: "PluginError", variants: [String]{"Guest", "Denied", "Budget", "Defect"}},
    {name: "EmailError", variants: [String]{"Configuration", "DNS", "Connect", "TLS", "Auth", "Protocol", "Rejected", "Transient", "TimedOut", "Cancelled", "DeliveryUnknown"}},
    {name: "SMTPSecurity", variants: [String]{"StartTLS", "TLS"}},
    {name: "RecipientPolicy", variants: [String]{"RequireAll", "DeliverAccepted"}},
    {name: "SMTPAuth", variants: [String]{"None", "Password"}},
    {name: "TLSTrust", variants: [String]{"System", "SystemPlusCa"}},
    {name: "TLSVersion", variants: [String]{"TLS12", "TLS13"}},
    {name: "TLSClientTrust", variants: [String]{"System", "SystemPlus", "CustomOnly"}},
    {name: "NetDNSError", variants: [String]{"NotFound", "Failure"}},
    {name: "NetError", variants: [String]{"InvalidInput", "PermissionDenied", "AddressInUse", "AddressUnavailable", "ConnectionRefused", "ConnectionReset", "NotConnected", "Closed", "Timeout", "Cancelled", "Unsupported", "TLS", "Protocol", "Other", "DNS"}},
    {name: "NetShutdown", variants: [String]{"Read", "Write", "Both"}},
    {name: "WatchDomain", variants: [String]{"File", "Process", "Port"}},
    {name: "WatchKind", variants: [String]{"Created", "Modified", "Removed", "Error", "Exited", "Ready"}},
    {name: "NetReadyInterest", variants: [String]{"Read", "Write", "ReadWrite"}},
    {name: "WsError", variants: [String]{"InvalidURL", "InvalidHandshake", "Protocol", "Timeout", "Closed", "Cancelled", "UnsupportedTarget", "MessageTooLarge", "IO"}},
    // The Core lane-reduction enum sema reads from the Core
    // enum payload rows (no Core.jet declaration, no Rust COMPILER_OWNED_ENUMS
    // row: Rust lowers `v.reduce(.Op)` as a marker and never compiles Core
    // math's `reduce(op)`). The runtime pack does, so its `op == .Add` test,
    // its `.Add` literals and its `ReduceOp` parameters need this canonical row.
    {name: "ReduceOp", variants: [String]{"Add", "Mul", "Min", "Max", "Avg"}},
} }

// The payload of one compiler-owned enum variant.
enum JetCodegenCompilerOwnedPayload {
    Unit
    Single(ty: Type)
    Named(fields: [TypeTupleField])
}

fn jet_codegen_compiler_owned_single(ty: Type) -> JetCodegenCompilerOwnedPayload Never! {
    JetCodegenCompilerOwnedPayload.Single{ty: ty}
}

fn jet_codegen_compiler_owned_named(fields: [TypeTupleField]) -> JetCodegenCompilerOwnedPayload Never! {
    JetCodegenCompilerOwnedPayload.Named{fields: fields}
}

// The payload of `name.variant` on a COMPILER_OWNED_ENUMS row, written over
// the row's type parameters; a plain Core enum row's variants are all unit.
// Rust: crates/jet-codegen/src/Codegen/TIR/tir_to_mir_types.rs::compiler_owned_type_defs
// (and jet-sema core_net_error_variants for NetError/NetDNSError).
fn jet_codegen_compiler_owned_enum_payload(name: String, variant: String) -> JetCodegenCompilerOwnedPayload Never! {
    bytes :: Type.List{element: Type.IntN{signed: false, bits: 8}}
    if name == "TaskFailure" || name == "TaskOutcome" {
        if variant == "Panicked" -> return jet_codegen_compiler_owned_single(Type.String)
        return JetCodegenCompilerOwnedPayload.Unit
    }
    if name == "HookDecision" || name == "HookOutcome" {
        carries_value :: if name == "HookDecision" -> "Transform" else -> "Continue"
        if variant == carries_value -> return jet_codegen_compiler_owned_single(Type.Named{name: "T"})
        if variant == "Fail" -> return jet_codegen_compiler_owned_single(Type.Named{name: "E"})
        return JetCodegenCompilerOwnedPayload.Unit
    }
    if name == "DataEvent" {
        if variant == "Bool" -> return jet_codegen_compiler_owned_single(Type.Bool)
        if variant == "Int" -> return jet_codegen_compiler_owned_single(Type.Int)
        if variant == "Float" -> return jet_codegen_compiler_owned_single(Type.Float)
        if variant == "Number" || variant == "Text" || variant == "Key" -> return jet_codegen_compiler_owned_single(Type.String)
        if variant == "Bytes" -> return jet_codegen_compiler_owned_single(Type.List{element: Type.IntN{signed: false, bits: 8}})
        return JetCodegenCompilerOwnedPayload.Unit
    }
    if name == "WsError" {
        if variant == "MessageTooLarge" -> return jet_codegen_compiler_owned_named([TypeTupleField]{TypeTupleField{name: "limit", ty: Type.Int}})
        if variant == "IO" -> return jet_codegen_compiler_owned_named([TypeTupleField]{TypeTupleField{name: "operation", ty: Type.String}})
        return JetCodegenCompilerOwnedPayload.Unit
    }
    if name == "IOError" {
        if variant == "ResourceLimit" -> return jet_codegen_compiler_owned_single(Type.Named{name: "ProcessResourceLimit"})
        return jet_codegen_compiler_owned_single(Type.Named{name: "IOContext"})
    }
    if name == "Key" {
        if variant == "Char" || variant == "Ctrl" -> return jet_codegen_compiler_owned_single(Type.Char)
        if variant == "F" -> return jet_codegen_compiler_owned_single(Type.Int)
        return JetCodegenCompilerOwnedPayload.Unit
    }
    if name == "PluginError" {
        if variant == "Budget" -> return jet_codegen_compiler_owned_named([TypeTupleField]{TypeTupleField{name: "limit", ty: Type.Named{name: "PluginLimit"}}, TypeTupleField{name: "fault", ty: Type.Named{name: "PluginFault"}}})
        return jet_codegen_compiler_owned_single(Type.Named{name: "PluginFault"})
    }
    if name == "EmailError" {
        return jet_codegen_compiler_owned_named([TypeTupleField]{
            {name: "operation", ty: Type.String},
            {name: "server", ty: Type.Option{inner: Type.String}},
            {name: "code", ty: Type.Option{inner: Type.Int}},
            {name: "reason", ty: Type.String},
        })
    }
    if name == "SMTPAuth" && variant == "Password" -> return jet_codegen_compiler_owned_named([TypeTupleField]{TypeTupleField{name: "username", ty: Type.String}, TypeTupleField{name: "password", ty: Type.Named{name: "Secret"}}})
    if name == "TLSTrust" && variant == "SystemPlusCa" -> return jet_codegen_compiler_owned_named([TypeTupleField]{TypeTupleField{name: "pem", ty: bytes}})
    if name == "TLSClientTrust" {
        if variant == "SystemPlus" || variant == "CustomOnly" -> return jet_codegen_compiler_owned_single(Type.Named{name: "TLSRootCertificates"})
        return JetCodegenCompilerOwnedPayload.Unit
    }
    // The canonical twelve DataEvent payloads are the
    // generated Core payload rows (Rust core_types.rs data_event_payload).
    if name == "DataEvent" {
        payload :: core_enum_variant_payload(name, variant) ?? return JetCodegenCompilerOwnedPayload.Unit
        if payload.len() == 1 -> return jet_codegen_compiler_owned_single(payload[0])
        return JetCodegenCompilerOwnedPayload.Unit
    }
    if name == "Dyn" {
        if variant == "Bool" -> return jet_codegen_compiler_owned_single(Type.Bool)
        if variant == "Int" -> return jet_codegen_compiler_owned_single(Type.Int)
        if variant == "Float" -> return jet_codegen_compiler_owned_single(Type.Float)
        if variant == "Bytes" -> return jet_codegen_compiler_owned_single(bytes)
        if variant == "DateTime" -> return jet_codegen_compiler_owned_single(Type.Named{name: "ZonedDateTime"})
        tree :: Type.Named{name: "Dyn"}
        if variant == "Number" || variant == "Text" -> return jet_codegen_compiler_owned_single(Type.String)
        if variant == "Array" -> return jet_codegen_compiler_owned_single(Type.List{element: tree})
        if variant == "Object" -> return jet_codegen_compiler_owned_single(Type.List{element: Type.Tuple{fields: [TypeTupleField]{TypeTupleField{name: "key", ty: Type.String}, TypeTupleField{name: "value", ty: tree}}}})
        return JetCodegenCompilerOwnedPayload.Unit
    }
    if name == "NetDNSError" -> return jet_codegen_compiler_owned_single(Type.String)
    if name == "NetError" {
        if variant == "DNS" -> return jet_codegen_compiler_owned_single(Type.Named{name: "NetDNSError"})
        return jet_codegen_compiler_owned_single(Type.Named{name: "NetErrorDetail"})
    }
    JetCodegenCompilerOwnedPayload.Unit
}

// The COMPILER_OWNED_ENUMS row spelled `name`.
fn jet_codegen_compiler_owned_enum_row(name: String) -> JetCodegenCompilerOwnedEnum? Never! {
    loop row in JET_CODEGEN_COMPILER_OWNED_ENUMS {
        if row.name == name -> return Val(row)
    }
    None
}

// The variants of the compiler-owned enum row spelled `name`: a
// COMPILER_OWNED_ENUMS row, else a Core enum leaf's plain row (Rust
// compiler_owned_core_enums); None when no such row exists. Callers resolve
// declared nominals first.
fn jet_codegen_compiler_owned_enum_variants(name: String) -> [String]? Never! {
    if jet_codegen_compiler_owned_enum_row(name) == .Val(row) -> return Val(row.variants)
    core_enum_variants(name)
}

// The payload of `name.variant` on a compiler-owned enum row; None when the
// row has no such variant.
fn jet_codegen_compiler_owned_variant_payload(name: String, variant: String) -> JetCodegenCompilerOwnedPayload? Never! {
    if jet_codegen_compiler_owned_enum_row(name) == .Val(row) {
        if !row.variants.contains(variant) -> return None
        return Val(jet_codegen_compiler_owned_enum_payload(name, variant))
    }
    variants :: core_enum_variants(name) ?? return None
    if !variants.contains(variant) -> return None
    Val(JetCodegenCompilerOwnedPayload.Unit)
}

// A compiler-owned row (record or enum) is spelled `name`.
fn jet_codegen_is_compiler_owned_row(name: String) -> Bool Never! {
    jet_codegen_compiler_owned_record_fields(name) != None || jet_codegen_compiler_owned_enum_variants(name) != None
}

fn jet_codegen_field_owner_kind(ty: Type) -> String Never! {
    if ty == {
        .Int -> "Int"
        .Float -> "Float"
        .Bool -> "Bool"
        .String -> "String"
        .Char -> "Char"
        .List(_) -> "List"
        .Map(_, _, _) -> "Map"
        .Shared(_) -> "Shared"
        .Option(_) -> "Option"
        .Result(_, _) -> "Result"
        .Fn(_, _, _, _, _, _) -> "Fn"
        .Named(_) -> "Named"
        .Apply(_, _) -> "Apply"
        .TraitObject(_) -> "TraitObject"
        .Tuple(_) -> "Tuple"
        .FixedList(_, _) -> "FixedList"
        .IntN(_, _) -> "IntN"
        .InlineRange(_, _, _) -> "InlineRange"
        .Float32 -> "Float32"
        .Tagged(_, _) -> "Tagged"
        .Union(_) -> "Union"
        .Quantity(_, _) -> "Quantity"
        .Measure(_) -> "Measure"
    }
}

fn jet_codegen_field_resolution_ice(function_key: String, original: Type, owner: Type, member: String, reason: String) -> String Never! {
    "ICE: checked field `{member}` in function `{function_key}`: {reason}; owner `{type_name(original)}` (kind {jet_codegen_field_owner_kind(original)}), normalized owner `{type_name(owner)}` (kind {jet_codegen_field_owner_kind(owner)})"
}

// Rust tuple_field_name/math_field_name accept unsigned decimal positions,
// not the wider Int.parse grammar (underscores, whitespace, or negative signs).
fn jet_codegen_field_position(member: String) -> Int? Never! {
    bytes :: member.bytes()
    length :: bytes.len()
    if length == 0 -> return None
    at := if bytes[0] == (U8{43}) -> 1 else -> 0
    if at == length -> return None
    loop at < length {
        digit :: bytes[at]
        if digit < (U8{48}) || digit > (U8{57}) -> return None
        at += 1
    }
    position :: Int.parse(member) ?? return None
    if position > 18446744073709551615 -> return None
    Val(position)
}

// One field-identity path for every checked owner shape. In particular, indexed
// and optional projections must not bypass tuple or read/write-window handling.
// Rust: LowerCtx::field_id_for_type, field_owner_type, and field_id_for.
fn jet_codegen_resolve_field_by_name(modules: [SemaGraphModuleResult], nominals: JetCodegenNominalIndex, current_module_identity: String, generic_names: [String], owner_type: Type, member: String, function_key: String) -> JetCodegenResolvedField Never! {
    normalized :: jet_codegen_qualify_type(owner_type, nominals, current_module_identity, generic_names)
    owner :: jet_codegen_field_owner_type(normalized)
    if owner == .Tuple(fields) {
        name := String?{None}
        if jet_codegen_field_position(member) == .Val(position) {
            if position < fields.len() -> name = Val(fields[position].name)
        } else {
            loop field in fields {
                if field.name == member {
                    name = Val(field.name)
                    break
                }
            }
        }
        field_name :: name ?? panic(jet_codegen_field_resolution_ice(function_key, owner_type, owner, member, "tuple field is missing"))
        lowered :: jet_codegen_lower_canonical_type(owner, nominals, current_module_identity, generic_names)
        return JetCodegenResolvedField{owner_key: mir_type_identity_key(lowered), field_name: field_name}
    }
    owner_name :: if owner == {
        .Named(name) | .Apply(name, _) -> name
        else -> panic(jet_codegen_field_resolution_ice(function_key, owner_type, owner, member, "owner has no registered field row"))
    }
    identity := jet_codegen_find_nominal_identity(nominals, current_module_identity, owner_name, generic_names)
    math_name :: if identity == {.Val(row) -> row.name else -> owner_name}
    position := Int?{None}
    if math_name == "F32x4" || math_name == "F64x2" || math_name == "Vec2" || math_name == "Vec3" || math_name == "Vec4" {
        position = jet_codegen_field_position(member)
    }
    if identity == .Val(nominal_identity) {
        // The type definitions of that key, in module and declaration order:
        // the first one in the nominal's module decides.
        references :: nominals.type_defs_by_key.get(nominal_identity.key) ?? [JetCodegenTypeDefRef]{}
        loop reference in references {
            if modules[reference.module_index].module_identity != nominal_identity.module_identity -> next
            definition :: modules[reference.module_index].declarations.type_defs[reference.definition_index]
            if definition.kind == {
                .Struct(fields, _) -> {
                    loop (index, field) in fields {
                        indexed :: position == Val((index)) && (field.name == "x" || field.name == "y" || field.name == "z" || field.name == "w")
                        if field.name == member || indexed -> return JetCodegenResolvedField{owner_key: definition.key, field_name: field.name}
                    }
                }
                .Enum(variants, _) -> {
                    loop variant in variants {
                        if variant.payload == .Named(fields) {
                            loop field in fields {
                                if field.name == member -> return JetCodegenResolvedField{owner_key: "{definition.key}::{variant.name}", field_name: field.name}
                            }
                        }
                    }
                }
                else -> {}
            }
            panic(jet_codegen_field_resolution_ice(function_key, owner_type, owner, member, "owner/member has no registered field"))
        }
    }
    // A builtin owner may be registered without a source declaration. Only its
    // exact canonical key can select a compiler-owned row; a scoped user alias
    // or same-leaf declaration must not acquire the builtin's fields.
    owner_key :: if identity == {.Val(row) -> row.key else -> owner_name}
    if jet_codegen_compiler_owned_record_fields(owner_key) == .Val(fields) {
        loop (index, field) in fields {
            indexed :: position == Val((index)) && (field.name == "x" || field.name == "y" || field.name == "z" || field.name == "w")
            if field.name == member || indexed -> return JetCodegenResolvedField{owner_key: owner_key, field_name: field.name}
        }
    }
    if jet_codegen_compiler_owned_enum_variants(owner_key) == .Val(variants) {
        loop variant in variants {
            if jet_codegen_compiler_owned_enum_payload(owner_key, variant) == .Named(fields) {
                loop field in fields {
                    if field.name == member -> return JetCodegenResolvedField{owner_key: "{owner_key}::{variant}", field_name: field.name}
                }
            }
        }
    }
    // A Core runtime record (`TextError`) has no declaration; its canonical
    // Core field row names the member, keyed by the record's own key as the
    // owner identity jet_codegen_mir_type_id_for_type gives it.
    if identity == None && core_record_field(owner_key, member) != None -> return JetCodegenResolvedField{owner_key: owner_key, field_name: member}
    panic(jet_codegen_field_resolution_ice(function_key, owner_type, owner, member, "owner/member has no registered field"))
}

// Build the checked field reference that Sema would have produced for
// `owner_type.member`, for TIR that Codegen synthesizes itself.
fn jet_codegen_field_ref_by_name(modules: [SemaGraphModuleResult], nominals: JetCodegenNominalIndex, current_module_identity: String, generic_names: [String], owner_type: Type, member: String, ty: Type, function_key: String) -> TFieldRef Never! {
    resolved :: jet_codegen_resolve_field_by_name(modules, nominals, current_module_identity, generic_names, owner_type, member, function_key)
    // Compiler-owned rows and structural tuples have no checked nominal symbol.
    identity := jet_codegen_find_nominal_identity(nominals, current_module_identity, resolved.owner_key, generic_names)
    if identity == None {
        return TFieldRef{owner: None, field: symbol_id(SymbolKind.Field, "", resolved.owner_key, resolved.field_name), name: resolved.field_name, ty: ty, boxed: false}
    }
    nominal_identity :: identity ?? panic("resolved field lost its nominal identity")
    loop nominal_row in jet_codegen_scope_nominal_rows(nominals, nominal_identity.module_identity, nominal_identity.name) {
        nominal :: modules[nominal_row.module_index].nominals[nominal_row.nominal_index]
        loop field in nominal.fields {
            if field.symbol.name == resolved.field_name -> return TFieldRef{owner: Val(nominal.symbol.id), field: field.symbol.id, name: resolved.field_name, ty: ty, boxed: false}
        }
    }
    panic(jet_codegen_field_resolution_ice(function_key, owner_type, jet_codegen_field_owner_type(owner_type), member, "synthesized field reference has no registered field"))
}

fn jet_codegen_mir_field_id(field: JetCodegenResolvedField) -> MIRFieldID Never! {
    mir_field_id("{field.owner_key}::{field.field_name}")
}

// The nominal of the first module (in module order) declaring `symbol`
// (jet_codegen_nominal_index), unless a Core builtin owner of an earlier
// module carries the key first.
fn jet_codegen_mir_type_id_for_symbol(program: JetCodegenProgram, symbol: SymbolID) -> MIRTypeID Never! {
    nominal_module := program.modules.len()
    nominal_row := -1
    if program.nominals.rows.get(symbol.key) == .Val(rows) {
        if rows.len() > 0 {
            nominal_module = rows[0].module_index
            nominal_row = rows[0].nominal_index
        }
    }
    if program.nominals.owner_fault != "" -> panic(program.nominals.owner_fault)
    if program.nominals.owner_keys.get(symbol.key) == .Val(owner) {
        if owner.module_index < nominal_module -> return mir_type_id(owner.identity.key)
    }
    if nominal_module < program.modules.len() {
        return mir_type_id(jet_codegen_nominal_type_key(program.modules[nominal_module].module_identity, program.modules[nominal_module].nominals[nominal_row]))
    }
    panic("checked type symbol has no registered nominal or builtin owner declaration")
}

fn jet_codegen_mir_type_id_for_type(nominals: JetCodegenNominalIndex, current_module_identity: String, generic_names: [String], ty: Type) -> MIRTypeID Never! {
    name :: if ty == {
        .Named(value) -> value
        .Apply(value, _) -> value
        else -> panic("checked declaration owner is not a nominal type")
    }
    identity := jet_codegen_find_nominal_identity(nominals, current_module_identity, name, generic_names)
    // Rust type_id_for: a key no declaration registers (a compiler-owned row
    // such as `FieldError`, or a Core runtime record such as `Expired` and
    // `TextError`) is the stable identity of its own key.
    if identity == .Val(value) -> return mir_type_id(value.key)
    mir_type_id(name)
}

// The trait of the first module nominal (in module order) declaring `symbol`
// (jet_codegen_nominal_index rows).
fn jet_codegen_mir_trait_ref_for_symbol(modules: [SemaGraphModuleResult], nominals: JetCodegenNominalIndex, symbol: SymbolID) -> MIRTraitRef Never! {
    if nominals.rows.get(symbol.key) == .Val(rows) {
        if rows.len() > 0 {
            semantic_module :: modules[rows[0].module_index]
            nominal :: semantic_module.nominals[rows[0].nominal_index]
            if nominal.source == .CompilerBuiltinTrait(reference) -> return reference
            name :: jet_codegen_qualified_type_key(semantic_module.module_identity, nominal.symbol.name)
            return jet_codegen_resolve_trait_name(nominals.traits, name, semantic_module.module_identity) ?? panic("checked trait symbol has no registered trait definition")
        }
    }
    // A builtin bound (Sema `sema_type_builtin_trait_symbol`, e.g. `Numeric`,
    // `Serialize`) has no owning module: its identity is the bare trait name,
    // as Rust keys every bound (`MirTraitId(stable_id("mir-trait", bound))`).
    parts :: symbol.key.split(":").to_list()
    name :: parts[parts.len() - 1]
    if symbol.key != symbol_id(SymbolKind.Trait, "", "", name).key -> panic("checked trait symbol has no registered nominal declaration")
    mir_trait_ref(name)
}


// Rust mir_type_as_ast: recover the checked shape for Prelude route selection.
// This is not a new nominal lookup or an emitter's ABI reconstruction.
fn jet_codegen_mir_type_as_type(ty: MIRType) -> Type Never! {
    if ty.kind == {
        .Int -> Type.Int
        .Float -> Type.Float
        .Bool -> Type.Bool
        .String -> Type.String
        .Char -> Type.Char
        .List(inner) -> Type.List{element: jet_codegen_mir_type_as_type(inner)}
        .Map(key, value) -> Type.Map{key: jet_codegen_mir_type_as_type(key), key_span: None, value: jet_codegen_mir_type_as_type(value)}
        .Shared(inner) -> Type.Shared{inner: jet_codegen_mir_type_as_type(inner)}
        .Option(inner) -> Type.Option{inner: jet_codegen_mir_type_as_type(inner)}
        .Result(ok, err) -> Type.Result{ok: jet_codegen_mir_type_as_type(ok), err: jet_codegen_mir_type_as_type(err)}
        .Fn(signature) -> jet_codegen_mir_callable_as_type(signature.params, signature.ret)
        .SendFn(params, ret, _) -> jet_codegen_mir_callable_as_type(params, ret)
        .Apply(name, args) -> {
            if args.len() == 0 -> return Type.Named{name: name.name}
            lowered :: loop arg in args -> jet_codegen_mir_type_as_type(arg)
            Type.Apply{name: name.name, args: lowered}
        }
        .TraitObject(bounds) -> {
            names :: loop bound in bounds -> bound.name
            Type.TraitObject{bounds: names}
        }
        .Tuple(fields) -> {
            lowered :: loop field in fields -> TypeTupleField{name: field.name, ty: jet_codegen_mir_type_as_type(field.ty)}
            Type.Tuple{fields: lowered}
        }
        .FixedList(elem, len) -> Type.FixedList{elem: jet_codegen_mir_type_as_type(elem), len: Measure.Symbol{kind: "mir-measure", name: mir_measure_expression(len)}}
        .IntN(signed, bits) -> Type.IntN{signed: signed, bits: bits}
        .InlineRange(base, lo, hi) -> Type.InlineRange{base: jet_codegen_mir_type_as_type(base), lo: lo, hi: hi}
        .Float32 -> Type.Float32
        .Tagged(_, inner) | .Quantity(inner, _) -> jet_codegen_mir_type_as_type(inner)
        .Union(members) -> {
            lowered :: loop member in members -> jet_codegen_mir_type_as_type(member)
            Type.Union{members: lowered}
        }
        .Measure(value) -> Type.Measure{measure: Measure.Symbol{kind: "mir-measure", name: mir_measure_expression(value)}}
    }
}

fn jet_codegen_mir_callable_as_type(params: [MIRType], ret: MIRType?) -> Type Never! {
    lowered :: loop param in params -> jet_codegen_mir_type_as_type(param)
    result := Type?{None}
    if ret == .Val(value) -> result = Val(jet_codegen_mir_type_as_type(value))
    Type.Fn{params: lowered, ret: result, effect_bound: None, param_contract: None, call_metadata: None, return_view_provenance: None}
}
