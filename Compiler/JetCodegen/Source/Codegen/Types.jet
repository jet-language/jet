// Backend-neutral lowering from checked semantic types to canonical MIR types.
// This is the only Type -> MirType projection used by Jet codegen; semantic
// identity and ABI facts are retained instead of reconstructed by an emitter.
use jet_foundation.[
    AccessConvention,
    CallContractRow,
    Dimension,
    EffectRowEntry,
    FunctionCallMetadata,
    MIRAccess,
    MIRCallContractRow,
    MIRCallMetadata,
    MIRCallablePolicy,
    MIRCallablePolicyChain,
    MIRDimension,
    MIRDimensionAxis,
    MIRFieldID,
    MIRFunctionSignature,
    MIRInternalTag,
    MIRMeasure,
    MIRMeasureRule,
    MIRTagMarker,
    MIRTraitID,
    MIRTraitRef,
    MIRTupleField,
    MIRType,
    MIRTypeID,
    MIRTypeKind,
    MIRViewProjection,
    MIRViewProvenance,
    MIRViewProvenanceEntry,
    MIRViewSource,
    MIRViewSourcePath,
    Measure,
    SymbolID,
    TCoreBuiltinOwner,
    TFieldRef,
    TagMarker,
    Type,
    TypeTupleField,
    ViewProvenanceMap,
    mir_boundary_head_carrier_module,
    mir_field_id,
    mir_nominal_ref,
    mir_trait_id,
    mir_trait_ref,
    mir_type_from_kind,
    mir_type_id,
    mir_type_with_identity,
    type_identity_key,
]
use jet_sema.[
    SemaGraphModuleResult,
    SemaRegistrationNominal,
    sema_registration_is_compiler_owned_enum,
]

struct JetCodegenNominalIdentity {
    pub module_identity: String
    pub name: String
    pub key: String
    pub qualified_name: String
}

fn jet_codegen_is_type_parameter(names: [String], name: String) -> Bool Never! {
    loop candidate in names {
        if candidate == name -> return true
    }
    false
}

fn jet_codegen_qualified_type_key(module_identity: String, name: String) -> String Never! {
    if module_identity == "" -> name else -> "{module_identity}::{name}"
}

// The canonical MIR type key of a registered nominal. Compiler-owned runtime
// enums (`Ordering`, `RemoveBy`) keep the bare shared spelling, like Rust's
// compiler-owned MIR rows, so every module's values name one type.
fn jet_codegen_nominal_type_key(module_identity: String, nominal: SemaRegistrationNominal) -> String Never! {
    if sema_registration_is_compiler_owned_enum(nominal) -> return nominal.symbol.name
    jet_codegen_qualified_type_key(module_identity, nominal.symbol.name)
}

fn jet_codegen_resolve_trait_ref(modules: [SemaGraphModuleResult], name: String, preferred_module_identity: String) -> MIRTraitRef? {
    preferred := MIRTraitRef?{None}
    other := MIRTraitRef?{None}
    ambiguous_other := false
    loop semantic_module in modules {
        loop definition in semantic_module.declarations.traits {
            canonical :: jet_codegen_canonical_target_type(semantic_module.module_identity, definition.key)
            canonical_module_name :: "{semantic_module.module_name}::{definition.name}"
            canonical_module_identity :: "{semantic_module.module_identity}::{definition.name}"
            if name != definition.key && name != definition.name && name != canonical && name != canonical_module_name && name != canonical_module_identity -> next
            candidate :: mir_trait_ref(canonical)
            if {
                semantic_module.module_identity == preferred_module_identity -> {
                    if preferred != None && (preferred ?? candidate).id != candidate.id -> return None
                    preferred = Val(candidate)
                }
                else -> {
                    if {
                        other != None && (other ?? candidate).id != candidate.id -> {
                            ambiguous_other = true
                        }
                        else -> {
                            other = Val(candidate)
                        }
                    }
                }
            }
        }
    }
    if preferred != None -> return preferred
    if ambiguous_other -> return None
    other
}

fn jet_codegen_is_native_rust_derive_name(name: String) -> Bool Never! {
    name == "Clone" || name == "Copy" || name == "Debug" || name == "Default" || name == "Eq" || name == "Hash" || name == "Ord" || name == "PartialEq" || name == "PartialOrd"
}

fn jet_codegen_native_rust_derive_name_for_id(id: MIRTraitID) -> String? {
    if {
        id == mir_trait_id("Clone") -> Val("Clone")
        id == mir_trait_id("Copy") -> Val("Copy")
        id == mir_trait_id("Debug") -> Val("Debug")
        id == mir_trait_id("Default") -> Val("Default")
        id == mir_trait_id("Eq") -> Val("Eq")
        id == mir_trait_id("Hash") -> Val("Hash")
        id == mir_trait_id("Ord") -> Val("Ord")
        id == mir_trait_id("PartialEq") -> Val("PartialEq")
        id == mir_trait_id("PartialOrd") -> Val("PartialOrd")
        else -> None
    }
}

fn jet_codegen_is_compiler_owned_trait_name(name: String) -> Bool Never! {
    name == "Encode" || name == "Decode" || name == "Display" || name == "Debug" || name == "Equatable" || name == "Comparable" || name == "Close" || name == "Index" || name == "IndexMut" || name == "Iterable" || name == "Iterator" || name == "Add" || name == "Sub" || name == "Mul" || name == "Div" || name == "Rollback"
}

fn jet_codegen_compiler_owned_trait_name_for_id(id: MIRTraitID) -> String? {
    if {
        id == mir_trait_id("Encode") -> Val("Encode")
        id == mir_trait_id("Decode") -> Val("Decode")
        id == mir_trait_id("Display") -> Val("Display")
        id == mir_trait_id("Debug") -> Val("Debug")
        id == mir_trait_id("Equatable") -> Val("Equatable")
        id == mir_trait_id("Comparable") -> Val("Comparable")
        id == mir_trait_id("Close") -> Val("Close")
        id == mir_trait_id("Index") -> Val("Index")
        id == mir_trait_id("IndexMut") -> Val("IndexMut")
        id == mir_trait_id("Iterable") -> Val("Iterable")
        id == mir_trait_id("Iterator") -> Val("Iterator")
        id == mir_trait_id("Add") -> Val("Add")
        id == mir_trait_id("Sub") -> Val("Sub")
        id == mir_trait_id("Mul") -> Val("Mul")
        id == mir_trait_id("Div") -> Val("Div")
        id == mir_trait_id("Rollback") -> Val("Rollback")
        else -> None
    }
}

fn jet_codegen_is_checked_text_trait_id(id: MIRTraitID) -> Bool Never! {
    id == mir_trait_id("CheckedText")
}

fn jet_codegen_lower_declared_or_builtin_trait_ref(modules: [SemaGraphModuleResult], name: String, module_identity: String) -> MIRTraitRef Never! {
    if jet_codegen_resolve_trait_ref(modules, name, module_identity) == .Val(resolved) -> return resolved
    if jet_codegen_trait_name_has_declaration(modules, name) -> panic("checked trait name is ambiguous")
    if jet_codegen_is_native_rust_derive_name(name) || jet_codegen_is_compiler_owned_trait_name(name) || name == "CheckedText" -> return mir_trait_ref(name)
    panic("checked trait name has no declared or registered builtin identity")
}

fn jet_codegen_trait_name_has_declaration(modules: [SemaGraphModuleResult], name: String) -> Bool Never! {
    loop semantic_module in modules {
        loop definition in semantic_module.declarations.traits {
            canonical :: jet_codegen_canonical_target_type(semantic_module.module_identity, definition.key)
            canonical_module_name :: "{semantic_module.module_name}::{definition.name}"
            canonical_module_identity :: "{semantic_module.module_identity}::{definition.name}"
            if name == definition.key || name == definition.name || name == canonical || name == canonical_module_name || name == canonical_module_identity -> return true
        }
    }
    false
}

fn jet_codegen_lower_type_derive_trait_id(name: String, modules: [SemaGraphModuleResult], module_identity: String) -> MIRTraitID Never! {
    resolved := jet_codegen_resolve_trait_ref(modules, name, module_identity)
    if resolved != None -> return (resolved ?? panic("resolved derive trait disappeared")).id
    if jet_codegen_trait_name_has_declaration(modules, name) -> panic("checked derive trait name is ambiguous")
    if jet_codegen_is_native_rust_derive_name(name) || jet_codegen_is_compiler_owned_trait_name(name) -> return mir_trait_id(name)
    panic("checked derive trait has no declared or builtin identity")
}

fn jet_codegen_core_owner_identity(owner: TCoreBuiltinOwner, semantic_module: SemaGraphModuleResult) -> JetCodegenNominalIdentity Never! {
    jet_codegen_check_core_owner(owner, semantic_module)
    module_identity := ""
    qualified_name := owner.name
    if owner.module_identity == .Val(identity) {
        module_identity = identity
        qualified_name = jet_codegen_qualified_type_key(identity, owner.name)
    }
    JetCodegenNominalIdentity{module_identity: module_identity, name: owner.name, key: owner.symbol.key, qualified_name: qualified_name}
}

// The invariants of a checked Core builtin owner, without building its
// identity (nominal lookups validate every owner but build only matches).
fn jet_codegen_check_core_owner(owner: TCoreBuiltinOwner, semantic_module: SemaGraphModuleResult) Never! {
    if owner.name == "" || owner.symbol.key == "" -> panic("checked Core builtin owner has an empty canonical identity")
    if owner.module_identity == .Val(identity) {
        if identity != semantic_module.module_identity -> panic("checked Core builtin owner has a module linkage mismatch")
    }
}

fn jet_codegen_merge_nominal_identity(found: JetCodegenNominalIdentity?, candidate: JetCodegenNominalIdentity) -> JetCodegenNominalIdentity? {
    if found == None -> return Val(candidate)
    existing :: found
    if existing.key != candidate.key -> panic("ambiguous checked nominal type identity in Codegen input")
    found
}

// `core.term` declares `Stdout`, `Stderr`, and `StdinHandle` so Jet code can
// name them, but their values are the Prelude's native stream carriers, not
// records. MIR types every spelling of these handles as the one bare native
// nominal, exactly like the host signature of `core.term.stdout()`; a record
// identity would make a backend drop a record the value never was.
fn jet_codegen_is_core_term_stream_carrier(modules: [SemaGraphModuleResult], module_identity: String, name: String) -> Bool Never! {
    if name != "Stdout" && name != "Stderr" && name != "StdinHandle" -> return false
    loop semantic_module in modules {
        if semantic_module.module_identity == module_identity -> return semantic_module.module_name == "core.term"
    }
    false
}

fn jet_codegen_find_nominal_identity(modules: [SemaGraphModuleResult], current_module_identity: String, name: String, generic_names: [String]) -> JetCodegenNominalIdentity? {
    found :: jet_codegen_find_source_nominal_identity(modules, current_module_identity, name, generic_names) ?? return None
    if jet_codegen_is_core_term_stream_carrier(modules, found.module_identity, found.name) -> return None
    Val(found)
}

fn jet_codegen_find_source_nominal_identity(modules: [SemaGraphModuleResult], current_module_identity: String, name: String, generic_names: [String]) -> JetCodegenNominalIdentity? {
    if jet_codegen_is_type_parameter(generic_names, name) -> return None
    loop semantic_module in modules {
        if semantic_module.module_identity == current_module_identity {
            if semantic_module.nominal_positions.get(name) == .Val(position) {
                nominal_name :: semantic_module.nominals[position].symbol.name
                key :: jet_codegen_nominal_type_key(semantic_module.module_identity, semantic_module.nominals[position])
                return Val(JetCodegenNominalIdentity{module_identity: semantic_module.module_identity, name: nominal_name, key: key, qualified_name: key})
            }
        }
    }
    // A lookup that misses the current module asks every module for the two
    // accepted spellings: the bare leaf and the module-qualified key.
    found := JetCodegenNominalIdentity?{None}
    loop semantic_module in modules {
        if semantic_module.nominal_positions.get(name) == .Val(position) {
            found = jet_codegen_merge_nominal_spelling(found, semantic_module, position, name)
        }
        if semantic_module.module_identity != "" {
            prefix :: "{semantic_module.module_identity}::"
            if name.starts_with(prefix) {
                leaf :: jet_codegen_type_key_leaf(name, prefix)
                if semantic_module.nominal_positions.get(leaf) == .Val(position) {
                    found = jet_codegen_merge_nominal_spelling(found, semantic_module, position, name)
                }
            }
        }
        loop owner in semantic_module.declarations.core_builtin_owners {
            if name == owner.name || name == owner.symbol.key {
                found = jet_codegen_merge_nominal_identity(found, jet_codegen_core_owner_identity(owner, semantic_module))
            } else {
                jet_codegen_check_core_owner(owner, semantic_module)
            }
        }
    }
    found
}

// Merges the nominal at `position` when `name` spells it: by its bare leaf
// (when the leaf may claim the bare name) or by its module-qualified key.
fn jet_codegen_merge_nominal_spelling(found: JetCodegenNominalIdentity?, semantic_module: SemaGraphModuleResult, position: Int, name: String) -> JetCodegenNominalIdentity? {
    nominal_name :: semantic_module.nominals[position].symbol.name
    qualified_name :: jet_codegen_nominal_type_key(semantic_module.module_identity, semantic_module.nominals[position])
    if (name == nominal_name && jet_codegen_leaf_claims_bare_name(semantic_module.module_name, name)) || name == qualified_name {
        return jet_codegen_merge_nominal_identity(found, JetCodegenNominalIdentity{module_identity: semantic_module.module_identity, name: nominal_name, key: qualified_name, qualified_name: qualified_name})
    }
    ~found
}

fn jet_codegen_type_key_leaf(name: String, prefix: String) -> String Never! {
    bytes :: name.bytes()
    String.from_bytes(~(bytes[prefix.bytes().len()..<bytes.len()])) ?? ""
}

// A bare built-in boundary spelling (`Path`, `URL`, `DateTime`) names only its
// carrier record; a loaded record that merely shares the leaf is a different
// type. Every other name may match by leaf.
fn jet_codegen_leaf_claims_bare_name(module_name: String, name: String) -> Bool Never! {
    if name != "URL" && name != "Path" && name != "DateTime" -> return true
    carrier :: mir_boundary_head_carrier_module(name) ?? return false
    module_name == carrier
}

fn jet_codegen_qualified_nominal_name(modules: [SemaGraphModuleResult], current_module_identity: String, name: String, generic_names: [String]) -> String Never! {
    nominal := jet_codegen_find_source_nominal_identity(modules, current_module_identity, name, generic_names)
    if nominal == None -> return ~name
    value :: nominal ?? panic("checked nominal type lookup lost its unique result")
    // Every spelling of a core.term stream handle is its bare native carrier.
    if jet_codegen_is_core_term_stream_carrier(modules, value.module_identity, value.name) -> return value.name
    value.qualified_name
}

// The bare `Group` is the compiler-owned task-group handle. A same-leaf Core
// nominal (`core.data::Group<K, V>`) is generic and always spelled with
// arguments, so only a declaration in the current module may claim the bare
// spelling; the leaf fallback must never turn the handle into that record.
fn jet_codegen_is_builtin_task_group(modules: [SemaGraphModuleResult], module_identity: String, name: String) -> Bool Never! {
    if name != "Group" -> return false
    loop semantic_module in modules {
        if semantic_module.module_identity == module_identity {
            loop nominal in semantic_module.nominals {
                if nominal.symbol.name == name -> return false
            }
        }
    }
    true
}

fn jet_codegen_qualify_type(ty: Type, modules: [SemaGraphModuleResult], module_identity: String, generic_names: [String]) -> Type Never! {
    if ty == {
        .Int -> Type.Int
        .Float -> Type.Float
        .Bool -> Type.Bool
        .String -> Type.String
        .Char -> Type.Char
        .List(inner) -> Type.List{element: jet_codegen_qualify_type(inner, modules, module_identity, generic_names)}
        .Map(key, key_span, value) -> Type.Map{key: jet_codegen_qualify_type(key, modules, module_identity, generic_names), key_span: key_span, value: jet_codegen_qualify_type(value, modules, module_identity, generic_names)}
        .Shared(inner) -> Type.Shared{inner: jet_codegen_qualify_type(inner, modules, module_identity, generic_names)}
        .Option(inner) -> Type.Option{inner: jet_codegen_qualify_type(inner, modules, module_identity, generic_names)}
        .Result(ok, err) -> Type.Result{ok: jet_codegen_qualify_type(ok, modules, module_identity, generic_names), err: jet_codegen_qualify_type(err, modules, module_identity, generic_names)}
        .Fn(params, ret, effect_bound, param_contract, call_metadata, return_view_provenance) -> {
            lowered_params := [Type]{}
            loop param in params -> &lowered_params.push(jet_codegen_qualify_type(param, modules, module_identity, generic_names))
            lowered_ret := Type?{None}
            if ret == {
                None -> {}
                Val(value) -> lowered_ret = Val(jet_codegen_qualify_type(value, modules, module_identity, generic_names))
            }
            Type.Fn{params: lowered_params, ret: lowered_ret, effect_bound: effect_bound, param_contract: param_contract, call_metadata: call_metadata, return_view_provenance: return_view_provenance}
        }
        .Named(name) -> {
            if jet_codegen_is_builtin_task_group(modules, module_identity, name) -> return Type.Named{name: name}
            Type.Named{name: jet_codegen_qualified_nominal_name(modules, module_identity, name, generic_names)}
        }
        .Apply(name, args) -> {
            lowered_args := [Type]{}
            loop arg in args -> &lowered_args.push(jet_codegen_qualify_type(arg, modules, module_identity, generic_names))
            Type.Apply{name: jet_codegen_qualified_nominal_name(modules, module_identity, name, generic_names), args: lowered_args}
        }
        .TraitObject(bounds) -> {
            canonical_bounds := [String]{}
            loop name in bounds {
                trait_ref :: jet_codegen_resolve_trait_ref(modules, name, module_identity) ?? panic("checked trait-object bound has no declared trait identity")
                &canonical_bounds.push(trait_ref.name)
            }
            Type.TraitObject{bounds: canonical_bounds}
        }
        .Tuple(fields) -> {
            lowered_fields := [TypeTupleField]{}
            loop field in fields -> &lowered_fields.push(TypeTupleField{name: field.name, ty: jet_codegen_qualify_type(field.ty, modules, module_identity, generic_names)})
            Type.Tuple{fields: lowered_fields}
        }
        .FixedList(elem, len) -> Type.FixedList{elem: jet_codegen_qualify_type(elem, modules, module_identity, generic_names), len: len}
        .IntN(signed, bits) -> Type.IntN{signed: signed, bits: bits}
        .InlineRange(base, lo, hi) -> Type.InlineRange{base: jet_codegen_qualify_type(base, modules, module_identity, generic_names), lo: lo, hi: hi}
        .Float32 -> Type.Float32
        .Tagged(marker, inner) -> Type.Tagged{marker: marker, inner: jet_codegen_qualify_type(inner, modules, module_identity, generic_names)}
        .Union(members) -> {
            lowered_members := [Type]{}
            loop member in members -> &lowered_members.push(jet_codegen_qualify_type(member, modules, module_identity, generic_names))
            Type.Union{members: lowered_members}
        }
        .Quantity(base, dimension) -> Type.Quantity{base: jet_codegen_qualify_type(base, modules, module_identity, generic_names), dimension: dimension}
        .Measure(measure) -> Type.Measure{measure: measure}
    }
}

fn jet_codegen_type_instance_id(ty: Type, modules: [SemaGraphModuleResult], module_identity: String, generic_names: [String]) -> MIRTypeID Never! {
    if ty == {
        .Named(name) -> {
            nominal := jet_codegen_find_nominal_identity(modules, module_identity, name, generic_names)
            if nominal == .Val(value) {
                return mir_type_id(value.key)
            }
        }
        .Apply(name, args) -> {
            if args.len() == 0 {
                nominal := jet_codegen_find_nominal_identity(modules, module_identity, name, generic_names)
                if nominal == .Val(value) {
                    return mir_type_id(value.key)
                }
            }
        }
        else -> {}
    }
    mir_type_id(type_identity_key(ty))
}

pub fn jet_codegen_lower_type(ty: Type) -> MIRType Never! {
    jet_codegen_lower_type_with_modules(ty, [SemaGraphModuleResult]{}, "", [String]{})
}

fn jet_codegen_lower_type_for_function(ty: Type, builder: JetCodegenBuilder) -> MIRType Never! {
    jet_codegen_lower_type_with_modules(ty, builder.modules, builder.function.module_identity, builder.generic_type_names)
}

fn jet_codegen_lower_type_with_modules(ty: Type, modules: [SemaGraphModuleResult], module_identity: String, generic_names: [String]) -> MIRType Never! {
    canonical :: jet_codegen_qualify_type(ty, modules, module_identity, generic_names)
    jet_codegen_lower_canonical_type(canonical, modules, module_identity, generic_names)
}

fn jet_codegen_lower_canonical_type(canonical: Type, modules: [SemaGraphModuleResult], module_identity: String, generic_names: [String]) -> MIRType Never! {
    kind :: if canonical == {
        .Int -> MIRTypeKind.Int
        .Float -> MIRTypeKind.Float
        .Bool -> MIRTypeKind.Bool
        .String -> MIRTypeKind.String
        .Char -> MIRTypeKind.Char
        .List(inner) -> MIRTypeKind.List{inner: jet_codegen_lower_canonical_type(inner, modules, module_identity, generic_names)}
        .Map(key, _, value) -> MIRTypeKind.Map{key: jet_codegen_lower_canonical_type(key, modules, module_identity, generic_names), value: jet_codegen_lower_canonical_type(value, modules, module_identity, generic_names)}
        .Shared(inner) -> MIRTypeKind.Shared{inner: jet_codegen_lower_canonical_type(inner, modules, module_identity, generic_names)}
        .Option(inner) -> MIRTypeKind.Option{inner: jet_codegen_lower_canonical_type(inner, modules, module_identity, generic_names)}
        .Result(ok, err) -> MIRTypeKind.Result{ok: jet_codegen_lower_canonical_type(ok, modules, module_identity, generic_names), err: jet_codegen_lower_canonical_type(err, modules, module_identity, generic_names)}
        .Fn(params, ret, effect_bound, param_contract, call_metadata, return_view_provenance) -> {
            lowered_params := [MIRType]{}
            loop param in params -> &lowered_params.push(jet_codegen_lower_canonical_type(param, modules, module_identity, generic_names))
            lowered_ret := MIRType?{None}
            if ret == {
                None -> {}
                Val(value) -> lowered_ret = Val(jet_codegen_lower_canonical_type(value, modules, module_identity, generic_names))
            }
            MIRTypeKind.Fn{signature: MIRFunctionSignature{
                params: lowered_params,
                ret: lowered_ret,
                effect_bound: jet_codegen_lower_effect_bound(effect_bound),
                param_contract: jet_codegen_lower_call_contract(param_contract),
                call_metadata: jet_codegen_lower_function_call_metadata(call_metadata),
                return_view_provenance: jet_codegen_lower_view_provenance_map(return_view_provenance),
            }}
        }
        .Named(name) -> MIRTypeKind.Apply{name: mir_nominal_ref(name), args: [MIRType]{}}
        .Apply(name, args) -> {
            lowered_args := [MIRType]{}
            loop arg in args -> &lowered_args.push(jet_codegen_lower_canonical_type(arg, modules, module_identity, generic_names))
            MIRTypeKind.Apply{name: mir_nominal_ref(name), args: lowered_args}
        }
        .TraitObject(bounds) -> {
            lowered_bounds := [MIRTraitRef]{}
            loop name in bounds {
                trait_ref :: jet_codegen_resolve_trait_ref(modules, name, module_identity) ?? panic("checked trait-object bound has no declared trait identity")
                &lowered_bounds.push(trait_ref)
            }
            MIRTypeKind.TraitObject{bounds: lowered_bounds}
        }
        .Tuple(fields) -> {
            lowered_fields := [MIRTupleField]{}
            loop field in fields -> &lowered_fields.push(MIRTupleField{name: field.name, ty: jet_codegen_lower_canonical_type(field.ty, modules, module_identity, generic_names)})
            MIRTypeKind.Tuple{fields: lowered_fields}
        }
        .FixedList(elem, len) -> MIRTypeKind.FixedList{elem: jet_codegen_lower_canonical_type(elem, modules, module_identity, generic_names), len: jet_codegen_lower_measure(len)}
        .IntN(signed, bits) -> MIRTypeKind.IntN{signed: signed, bits: bits}
        .InlineRange(base, lo, hi) -> MIRTypeKind.InlineRange{base: jet_codegen_lower_canonical_type(base, modules, module_identity, generic_names), lo: lo, hi: hi}
        .Float32 -> MIRTypeKind.Float32
        .Tagged(marker, inner) -> MIRTypeKind.Tagged{marker: jet_codegen_lower_tag_marker(marker), inner: jet_codegen_lower_canonical_type(inner, modules, module_identity, generic_names)}
        .Union(members) -> {
            lowered_members := [MIRType]{}
            loop member in members -> &lowered_members.push(jet_codegen_lower_canonical_type(member, modules, module_identity, generic_names))
            MIRTypeKind.Union{members: lowered_members}
        }
        .Quantity(base, dimension) -> MIRTypeKind.Quantity{base: jet_codegen_lower_canonical_type(base, modules, module_identity, generic_names), dimension: jet_codegen_lower_dimension(dimension)}
        .Measure(measure) -> MIRTypeKind.Measure{value: jet_codegen_lower_measure(measure)}
    }
    mir_type_with_identity(mir_type_from_kind(kind), jet_codegen_type_instance_id(canonical, modules, module_identity, generic_names))
}

fn jet_codegen_lower_measure(measure: Measure) -> MIRMeasure Never! {
    if measure == {
        .Literal(kind, value) -> MIRMeasure.Literal{kind: kind, value: value}
        .SignedLiteral(kind, value) -> MIRMeasure.SignedLiteral{kind: kind, value: value}
        .Symbol(kind, name) -> MIRMeasure.Symbol{kind: kind, name: name}
        .Combined(kind, rule, left, right) -> {
            lowered_rule := if rule == {
                .Add -> MIRMeasureRule.Add
                .Mul -> MIRMeasureRule.Mul
                .Match -> MIRMeasureRule.Match
            }
            MIRMeasure.Combined{kind: kind, rule: lowered_rule, left: jet_codegen_lower_measure(left), right: jet_codegen_lower_measure(right)}
        }
    }
}

fn jet_codegen_lower_dimension(dimension: Dimension) -> MIRDimension Never! {
    axes := [MIRDimensionAxis]{}
    loop axis in dimension.axes -> &axes.push(MIRDimensionAxis{name: axis.name, exponent: jet_codegen_lower_measure(axis.exponent)})
    MIRDimension{axes: axes}
}

fn jet_codegen_lower_tag_marker(marker: TagMarker) -> MIRTagMarker Never! {
    if marker == {
        .User(name) -> MIRTagMarker.User{name: name}
        .Internal(tag_value) -> {
            if tag_value == {
                .CoreCryptoNominal -> MIRTagMarker.Internal{internal_tag: MIRInternalTag.CoreCryptoNominal}
                .DeterministicClock -> MIRTagMarker.Internal{internal_tag: MIRInternalTag.DeterministicClock}
                .SystemClock -> MIRTagMarker.Internal{internal_tag: MIRInternalTag.SystemClock}
                .ExpiringSecretLoan -> MIRTagMarker.Internal{internal_tag: MIRInternalTag.ExpiringSecretLoan}
                .SharedGuardRead -> MIRTagMarker.Internal{internal_tag: MIRInternalTag.SharedGuardRead}
                .SharedGuardEdit -> MIRTagMarker.Internal{internal_tag: MIRInternalTag.SharedGuardEdit}
                .TerminalFactSet -> MIRTagMarker.Internal{internal_tag: MIRInternalTag.TerminalFactSet}
                .CppCallbackABI -> MIRTagMarker.Internal{internal_tag: MIRInternalTag.CppCallbackABI}
                .AllocatorView -> MIRTagMarker.Internal{internal_tag: MIRInternalTag.AllocatorView}
            }
        }
    }
}

fn jet_codegen_lower_effect_bound(bound: [EffectRowEntry]?) -> [String]? {
    if bound == None -> return None
    effects := [String]{}
    loop entry in (bound) { &effects.push(entry.name) }
    Val(effects)
}

fn jet_codegen_lower_call_contract(contract: [CallContractRow]?) -> [MIRCallContractRow]? {
    if contract == None -> return None
    rows := [MIRCallContractRow]{}
    loop row in (contract) { &rows.push(MIRCallContractRow{label: row.label, zone: row.zone}) }
    Val(rows)
}

fn jet_codegen_lower_function_call_metadata(metadata: FunctionCallMetadata?) -> MIRCallMetadata? {
    if metadata == None -> return None
    source :: metadata
    defaults := [Bool]{}
    loop default in source.defaults -> &defaults.push(default != None)
    conventions := [MIRAccess]{}
    loop convention in source.conventions -> &conventions.push(jet_codegen_lower_access(convention))
    policies := [MIRCallablePolicy]{}
    loop policy in source.policies.policies -> &policies.push(MIRCallablePolicy{name: policy.name, arguments: policy.arguments})
    Val(MIRCallMetadata{
        names: source.names,
        defaults: defaults,
        variadic: source.variadic,
        conventions: conventions,
        policies: MIRCallablePolicyChain{policies: policies},
    })
}

fn jet_codegen_lower_access(access: AccessConvention) -> MIRAccess Never! {
    if access == {
        .Read -> MIRAccess.Read
        .Write -> MIRAccess.Write
        .Move -> MIRAccess.Move
    }
}

fn jet_codegen_lower_view_provenance_map(provenance: ViewProvenanceMap?) -> [MIRViewProvenanceEntry]? {
    if provenance == None -> return None
    rows := [MIRViewProvenanceEntry]{}
    loop entry in (provenance).entries {
        sources := [MIRViewSourcePath]{}
        loop path in entry.value.sources {
            source :: if path.source == {
                .Receiver -> MIRViewSource.Receiver
                .Parameter(index) -> MIRViewSource.Parameter{index: index}
                .Static(module_path, name) -> MIRViewSource.Static{module_path: module_path, name: name}
            }
            projections := [MIRViewProjection]{}
            loop projection in path.projections {
                if projection == {
                    .Field(name) -> &projections.push(MIRViewProjection.Field{name: name})
                    .Index -> &projections.push(MIRViewProjection.Index)
                    .Range -> &projections.push(MIRViewProjection.Range)
                }
            }
            &sources.push(MIRViewSourcePath{source: source, projections: projections})
        }
        value :: MIRViewProvenance{sources: sources, mutable: entry.value.mutable}
        &rows.push(MIRViewProvenanceEntry{slot: entry.slot, provenance: value})
    }
    Val(rows)
}

struct JetCodegenResolvedField {
    pub module_identity: String
    pub nominal_name: String
    pub field_name: String
}

// One registered nominal field, keyed in the program index by its field
// symbol key so each checked TFieldRef resolves without rescanning every
// module's nominals.
struct JetCodegenFieldSymbolRow {
    pub owner_key: String
    pub name: String
    pub resolved: JetCodegenResolvedField
}

// Built once per lowered program; rows keep module, nominal and field order.
fn jet_codegen_field_symbol_index(modules: [SemaGraphModuleResult]) -> [String:[JetCodegenFieldSymbolRow]] Never! {
    index := [String:[JetCodegenFieldSymbolRow]]{}
    loop semantic_module in modules {
        loop nominal in semantic_module.nominals {
            loop field in nominal.fields {
                rows := index.get(field.symbol.id.key) ?? [JetCodegenFieldSymbolRow]{}
                &rows.push(JetCodegenFieldSymbolRow{
                    owner_key: nominal.symbol.id.key,
                    name: field.symbol.name,
                    resolved: JetCodegenResolvedField{
                        module_identity: semantic_module.module_identity,
                        nominal_name: nominal.symbol.name,
                        field_name: field.symbol.name,
                    },
                })
                index[field.symbol.id.key] = rows
            }
        }
    }
    index
}

// A reference with a declared owner; an open owner resolves from the
// receiver type instead (`jet_codegen_field_ref_id`).
fn jet_codegen_resolve_field_by_symbol(field_symbols: [String:[JetCodegenFieldSymbolRow]], reference: TFieldRef) -> JetCodegenResolvedField Never! {
    owner :: reference.owner ?? panic("checked TFieldRef has no declared owner")
    resolved := JetCodegenResolvedField?{None}
    rows :: field_symbols.get(reference.field.key) ?? [JetCodegenFieldSymbolRow]{}
    loop row in rows {
        if row.owner_key != owner.key -> next
        if row.name != reference.name -> panic("checked field reference name disagrees with its registered symbol")
        if resolved != None -> panic("ambiguous checked field symbol in Codegen input")
        resolved = Val(row.resolved)
    }
    resolved ?? panic("checked TFieldRef has no registered nominal field")
}

// The compiler-owned `Range` record a range value constructs. It has no
// source declaration; Codegen adds its row to every program
// (`jet_codegen_range_record_definition`) under its bare canonical key.
// Rust: crates/jet-codegen/src/Codegen/TIR/tir_to_mir_types.rs::compiler_owned_type_defs
JET_CODEGEN_RANGE_RECORD :: "Range"

// The compiler-owned `ParseError` alias (`jet_codegen_parse_error_alias_definition`).
// Rust: crates/jet-codegen/src/Codegen/TIR/tir_to_mir_types.rs::compiler_owned_parse_error
JET_CODEGEN_PARSE_ERROR_ALIAS :: "ParseError"

fn jet_codegen_range_record_fields() -> [TypeTupleField] Never! {
    [TypeTupleField]{
        TypeTupleField{name: "start", ty: Type.Int},
        TypeTupleField{name: "end", ty: Type.Int},
        TypeTupleField{name: "exclusive", ty: Type.Bool},
    }
}

fn jet_codegen_range_record_field(member: String) -> TypeTupleField? {
    loop field in jet_codegen_range_record_fields() {
        if field.name == member -> return Val(field)
    }
    None
}

fn jet_codegen_range_record_field_id(member: String) -> MIRFieldID Never! {
    field :: jet_codegen_range_record_field(member) ?? panic("compiler-owned Range record has no field `{member}`")
    jet_codegen_mir_field_id(JetCodegenResolvedField{module_identity: "", nominal_name: JET_CODEGEN_RANGE_RECORD, field_name: field.name})
}

fn jet_codegen_resolve_field_by_name(modules: [SemaGraphModuleResult], current_module_identity: String, generic_names: [String], owner_type: Type, member: String) -> JetCodegenResolvedField Never! {
    owner_name :: if owner_type == {
        .Named(name) -> name
        .Apply(name, _) -> name
        else -> panic("checked field access owner is not a nominal type")
    }
    identity := jet_codegen_find_nominal_identity(modules, current_module_identity, owner_name, generic_names)
    if identity == None && owner_name == JET_CODEGEN_RANGE_RECORD {
        field :: jet_codegen_range_record_field(member) ?? panic("checked field access member has no registered field")
        return JetCodegenResolvedField{module_identity: "", nominal_name: JET_CODEGEN_RANGE_RECORD, field_name: field.name}
    }
    nominal_identity :: identity ?? panic("checked field access owner has no registered nominal type")
    loop semantic_module in modules {
        if semantic_module.module_identity != nominal_identity.module_identity -> next
        loop nominal in semantic_module.nominals {
            if nominal.symbol.name != nominal_identity.name -> next
            loop field in nominal.fields {
                if field.symbol.name == member {
                    return JetCodegenResolvedField{
                        module_identity: semantic_module.module_identity,
                        nominal_name: nominal.symbol.name,
                        field_name: field.symbol.name,
                    }
                }
            }
            panic("checked field access member has no registered field")
        }
    }
    panic("checked field access nominal disappeared from Codegen input")
}

// Build the checked field reference that Sema would have produced for
// `owner_type.member`, for TIR that Codegen synthesizes itself.
fn jet_codegen_field_ref_by_name(modules: [SemaGraphModuleResult], current_module_identity: String, generic_names: [String], owner_type: Type, member: String, ty: Type) -> TFieldRef Never! {
    resolved :: jet_codegen_resolve_field_by_name(modules, current_module_identity, generic_names, owner_type, member)
    loop semantic_module in modules {
        if semantic_module.module_identity != resolved.module_identity -> next
        loop nominal in semantic_module.nominals {
            if nominal.symbol.name != resolved.nominal_name -> next
            loop field in nominal.fields {
                if field.symbol.name == member -> return TFieldRef{owner: Val(nominal.symbol.id), field: field.symbol.id, name: member, ty: ty, boxed: false}
            }
        }
    }
    panic("checked field access member has no registered field")
}

fn jet_codegen_mir_field_id(field: JetCodegenResolvedField) -> MIRFieldID Never! {
    mir_field_id("{jet_codegen_qualified_type_key(field.module_identity, field.nominal_name)}::{field.field_name}")
}

fn jet_codegen_mir_type_id_for_symbol(modules: [SemaGraphModuleResult], symbol: SymbolID) -> MIRTypeID Never! {
    loop semantic_module in modules {
        loop nominal in semantic_module.nominals {
            if nominal.symbol.id.key == symbol.key -> return mir_type_id(jet_codegen_nominal_type_key(semantic_module.module_identity, nominal))
        }
        loop owner in semantic_module.declarations.core_builtin_owners {
            candidate :: jet_codegen_core_owner_identity(owner, semantic_module)
            if owner.symbol.key == symbol.key -> return mir_type_id(candidate.key)
        }
    }
    panic("checked type symbol has no registered nominal or builtin owner declaration")
}

fn jet_codegen_mir_type_id_for_type(modules: [SemaGraphModuleResult], current_module_identity: String, generic_names: [String], ty: Type) -> MIRTypeID Never! {
    name :: if ty == {
        .Named(value) -> value
        .Apply(value, _) -> value
        else -> panic("checked declaration owner is not a nominal type")
    }
    identity := jet_codegen_find_nominal_identity(modules, current_module_identity, name, generic_names)
    value :: identity ?? panic("checked declaration owner has no registered nominal identity")
    mir_type_id(value.key)
}

fn jet_codegen_mir_trait_ref_for_symbol(modules: [SemaGraphModuleResult], symbol: SymbolID) -> MIRTraitRef Never! {
    loop semantic_module in modules {
        loop nominal in semantic_module.nominals {
            if nominal.symbol.id.key == symbol.key {
                name :: jet_codegen_qualified_type_key(semantic_module.module_identity, nominal.symbol.name)
                return jet_codegen_resolve_trait_ref(modules, name, semantic_module.module_identity) ?? panic("checked trait symbol has no registered trait definition")
            }
        }
    }
    panic("checked trait symbol has no registered nominal declaration")
}

