fn unqualified_file_function_entries(bundle: ProgramBundle, module_idx: USize, imports: [ImportDecl]) -> [(String, String, [(AccessConvention, Type)], Type?)] {
    entries := [(String, String, [(AccessConvention, Type)], Type?)]{}
    loop imp in imports {
        if imp.kind == {
            Unqualified{module_alias, ..} -> {
                if imp.core_module_path() != None { continue }
                if inline_code_module_named(bundle, module_idx, module_alias) { continue }
                maybe_target :: file_import_target(bundle, module_idx, module_alias)
                target :: if maybe_target == {
                    Val(target) -> target
                    None -> {
                        if is_foreign_member_list(imp) || core_list_prefix(module_alias) != None || inline_code_module_named(bundle, module_idx, module_alias) { continue }
                        panic("file import target missing after sema: module={module_idx} alias={module_alias}")
                    }
                }
                loop binding in imp.walk_bindings() {
                    orig :: binding.original ?? panic("member walker returned a binding without a member")
                    local :: binding.local
                    owner :: namespace_member_owner(bundle, target, orig)
                    maybe_item :: bundle.modules[owner].items.find(fn(item) {
                        if item == { Func(f) -> f.name == orig && bundle.name_ledger.visible(module_idx, owner, f.name) _ -> false }
                    })
                    item :: if maybe_item == {
                        Val(item) -> item
                        None -> {
                            c_item :: bundle.modules[owner].items.find(fn(item) {
                                if item == { CModule(_) -> true _ -> false }
                            })
                            if c_item == {
                                Val(Item.CModule(cm)) -> {
                                    if cm.functions.find(fn(function) { function.name == orig }) == {
                                        Val(function) -> {
                                            params :: loop param in function.params {
                                                ty :: if param.variadic { Type.List(param.ty.clone()) } else { param.ty.clone() }
                                                (param.convention, ty)
                                            }
                                            &entries.push((local, orig.to_string(), params, function.return_type.clone()))
                                            continue
                                        }
                                        None -> {}
                                    }
                                }
                                _ -> {}
                            }
                            is_module :: bundle.modules[owner].items.any(fn(item) {
                                if item == { Module(m) -> m.name == orig CodeModule(cm) -> cm.name == orig _ -> false }
                            })
                            if is_module { continue }
                            if bundle.name_ledger.effective_alias(module_idx, local).is_some_and(fn(alias) { alias.target_module == Val(owner) }) { continue }
                            panic("imported member missing after sema: module={module_idx} alias={module_alias} member={orig}")
                        }
                    }
                    if item == {
                        Func(function) -> {
                            params :: loop param in function.params {
                                ty :: if param.variadic { Type.List(param.ty.clone()) } else { param.ty.clone() }
                                (param.convention, qualify_imported_call_type(bundle, owner, "", ty))
                            }
                            ret :: function.return_type.map(fn(ty) { qualify_imported_call_type(bundle, owner, "", ty) })
                            &entries.push((local, orig.to_string(), params, ret))
                        }
                        _ -> panic("imported member is not a function after sema: module={module_idx} alias={module_alias} member={orig}")
                    }
                }
            }
            _ -> continue
        }
    }
    entries
}

// Rust: crates/jet-codegen/src/Codegen/Imports.rs:1528
fn nested_file_function_entries(bundle: ProgramBundle, module_idx: USize) -> [(String, String, String, [(AccessConvention, Type)], Type?)] {
    entries := [(String, String, String, [(AccessConvention, Type)], Type?)]{}
    loop (path, target) in imported_module_paths(bundle, module_idx) {
        loop item in bundle.modules[target].items {
            if item == {
                Func(function) -> {
                    if !bundle.name_ledger.visible(module_idx, target, function.name) { continue }
                    params :: loop param in function.params {
                        ty :: if param.variadic { Type.List(param.ty.clone()) } else { param.ty.clone() }
                        (param.convention, qualify_imported_call_type(bundle, target, path, ty))
                    }
                    ret :: function.return_type.map(fn(ty) { qualify_imported_call_type(bundle, target, path, ty) })
                    &entries.push((path.clone(), mangle(bundle.modules[target].alias), function.name.clone(), params, ret))
                }
                _ -> continue
            }
        }
    }
    entries
}

// Rust: crates/jet-codegen/src/Codegen/Imports.rs:1581
// GATE #4499: Core source signatures preserve structural (module, function) keys.
fn core_source_sig_map(bundle: ProgramBundle) -> [(String, String):CoreSourceFunctionSignature] {
    map := [(String, String):CoreSourceFunctionSignature]{}
    // Qualified calls may reach any loaded Core module.
    loop (target, module) in bundle.modules.enumerate() {
        source :: core_source_module_by_alias(module.alias) ?? continue
        loop item in bundle.modules[target].items {
            if item == {
                Func(function) -> {
                    if !function.is_pub || !core_source_owns(source.module, function.name) { continue }
                    params :: loop param in function.params {
                        ty :: if param.variadic { Type.List(param.ty.clone()) } else { param.ty.clone() }
                        (param.convention, qualify_imported_call_type(bundle, target, source.alias, ty))
                    }
                    return_type :: function.return_type.map(fn(ty) { qualify_imported_call_type(bundle, target, source.alias, ty) })
                    type_params :: loop param in function.type_params -> param.name.clone()
                    &map.insert((source.module.to_string(), function.name.clone()), CoreSourceFunctionSignature{
                        module_identity: module_identity(bundle, target),
                        type_params: type_params,
                        params: params,
                        return_type: return_type,
                    })
                }
                _ -> continue
            }
        }
    }
    // Private receiver-first String functions use the same typed ModuleCall facts.
    if core_private_source_part(CORE_TEXT_STRING_OWNER) == {
        Val(part) -> {
            if bundle.modules.position(fn(loaded) { loaded.alias == part.source.alias }) == {
                Val(target) -> {
                    loop item in bundle.modules[target].items {
                        if item == {
                            Func(function) -> {
                                if function.is_pub { continue }
                                params :: loop param in function.params {
                                    ty :: if param.variadic { Type.List(param.ty.clone()) } else { param.ty.clone() }
                                    (param.convention, qualify_imported_call_type(bundle, target, part.source.alias, ty))
                                }
                                return_type :: function.return_type.map(fn(ty) { qualify_imported_call_type(bundle, target, part.source.alias, ty) })
                                type_params :: loop param in function.type_params -> param.name.clone()
                                &map.insert((part.source.module.to_string(), function.name.clone()), CoreSourceFunctionSignature{
                                    module_identity: module_identity(bundle, target),
                                    type_params: type_params,
                                    params: params,
                                    return_type: return_type,
                                })
                            }
                            _ -> continue
                        }
                    }
                }
                None -> {}
            }
        }
        None -> {}
    }
    map
}

// Rust: crates/jet-codegen/src/Codegen/Imports.rs:1700
// GATE #4499: signatures retain structural (import alias, function) keys.
fn import_sig_map(bundle: ProgramBundle, module_idx: USize) -> [(String, String):[(AccessConvention, Type)]] {
    map := [(String, String):[(AccessConvention, Type)]]{}
    module :: bundle.modules[module_idx]
    loop imp in module.imports {
        loop (alias, target) in foreign_list_targets(bundle, module_idx, imp) {
            loop item in bundle.modules[target].items {
                if item == {
                    Func(f) -> {
                        if !f.is_pub { continue }
                        params :: loop p in f.params -> (p.convention, qualify_unit_type(bundle, target, p.ty))
                        &map.insert((alias.clone(), f.name.clone()), params)
                    }
                    CModule(cm) -> {
                        loop ef in cm.functions {
                            params :: loop p in ef.params -> (p.convention, p.ty.clone())
                            &map.insert((alias.clone(), ef.name.clone()), params)
                        }
                    }
                    _ -> {}
                }
            }
        }
        if is_foreign_member_list(imp) { continue }
        alias :: imp.import_alias()
        target :: if is_c_import_after_frontend(imp) {
            required_c_target(bundle, module_idx, None, alias)
        } else if (if imp.kind == { Unqualified{..} -> true _ -> false }) || imp.core_module_path() != None {
            continue
        } else {
            required_import_target(bundle, module_idx, imp)
        }
        loop item in bundle.modules[target].items {
            if item == {
                Func(f) -> {
                    if !bundle.name_ledger.visible(module_idx, target, f.name) { continue }
                    params :: loop p in f.params {
                        ty :: if p.variadic { Type.List(p.ty.clone()) } else { p.ty.clone() }
                        (p.convention, qualify_imported_call_type(bundle, target, alias, ty))
                    }
                    &map.insert((alias.clone(), f.name.clone()), params)
                }
                CModule(cm) -> {
                    loop ef in cm.functions {
                        params :: loop p in ef.params {
                            ty :: if p.variadic { Type.List(p.ty.clone()) } else { p.ty.clone() }
                            (p.convention, ty)
                        }
                        &map.insert((alias.clone(), ef.name.clone()), params)
                    }
                }
                _ -> {}
            }
        }
    }
    loop (local, original, params, _) in unqualified_file_function_entries(bundle, module_idx, module.imports) {
        &map.insert((local, original), params)
    }
    loop item in module.items {
        if item == {
            CodeModule(cm) -> {
                loop (local, original, params, _) in unqualified_file_function_entries(bundle, module_idx, cm.imports) {
                    &map.insert((local, original), params)
                }
            }
            _ -> {}
        }
    }
    loop (local, target) in unqualified_file_module_targets(bundle, module_idx) {
        loop item in bundle.modules[target].items {
            if item == {
                Func(function) -> {
                    if !bundle.name_ledger.visible(module_idx, target, function.name) { continue }
                    params :: loop param in function.params {
                        ty :: if param.variadic { Type.List(param.ty.clone()) } else { param.ty.clone() }
                        (param.convention, qualify_imported_call_type(bundle, target, "", ty))
                    }
                    &map.insert((local.clone(), function.name.clone()), params)
                }
                _ -> {}
            }
        }
    }
    loop (path, _, function, params, _) in nested_file_function_entries(bundle, module_idx) {
        &map.insert(("{path}.{function}", function), params)
    }
    // Reexports carry the real function's borrow/take conventions.
    loop ((alias, item), (real_mod, real_fn)) in reexport_call_map(bundle, module_idx) {
        stem :: generated_suffix(real_mod)
        real_idx :: bundle.modules.position(fn(m) { m.alias == stem }) ?? continue
        real :: bundle.modules[real_idx]
        loop it in real.items {
            if it == {
                Func(f) -> {
                    if f.name != real_fn || !bundle.name_ledger.visible(module_idx, real_idx, f.name) { continue }
                    params :: loop p in f.params {
                        ty :: if p.variadic { Type.List(p.ty.clone()) } else { p.ty.clone() }
                        (p.convention, qualify_imported_call_type(bundle, real_idx, alias, ty))
                    }
                    &map.insert((alias.clone(), item.clone()), params)
                }
                _ -> {}
            }
        }
    }
    map
}

// Rust: crates/jet-codegen/src/Codegen/Imports.rs:1882
// GATE #4499: return facts retain structural (import alias, function) keys.
fn import_ret_map(bundle: ProgramBundle, module_idx: USize) -> [(String, String):Type?] {
    map := [(String, String):Type?]{}
    module :: bundle.modules[module_idx]
    loop imp in module.imports {
        loop (alias, target) in foreign_list_targets(bundle, module_idx, imp) {
            loop item in bundle.modules[target].items {
                if item == {
                    Func(f) -> {
                        if !f.is_pub { continue }
                        ret :: f.return_type.map(fn(ty) { qualify_unit_type(bundle, target, ty) })
                        &map.insert((alias.clone(), f.name.clone()), ret)
                    }
                    CModule(cm) -> {
                        loop ef in cm.functions { &map.insert((alias.clone(), ef.name.clone()), ef.return_type.clone()) }
                    }
                    _ -> {}
                }
            }
        }
        if is_foreign_member_list(imp) { continue }
        alias :: imp.import_alias()
        target :: if is_c_import_after_frontend(imp) {
            required_c_target(bundle, module_idx, None, alias)
        } else if (if imp.kind == { Unqualified{..} -> true _ -> false }) || imp.core_module_path() != None {
            continue
        } else {
            required_import_target(bundle, module_idx, imp)
        }
        loop item in bundle.modules[target].items {
            if item == {
                Func(f) -> {
                    if !bundle.name_ledger.visible(module_idx, target, f.name) { continue }
                    ret :: f.return_type.map(fn(ty) { qualify_imported_call_type(bundle, target, alias, ty) })
                    &map.insert((alias.clone(), f.name.clone()), ret)
                }
                CModule(cm) -> {
                    loop ef in cm.functions { &map.insert((alias.clone(), ef.name.clone()), ef.return_type.clone()) }
                }
                _ -> {}
            }
        }
    }
    loop (local, original, _, ret) in unqualified_file_function_entries(bundle, module_idx, module.imports) {
        &map.insert((local, original), ret)
    }
    loop item in module.items {
        if item == {
            CodeModule(cm) -> {
                loop (local, original, _, ret) in unqualified_file_function_entries(bundle, module_idx, cm.imports) {
                    &map.insert((local, original), ret)
                }
            }
            _ -> {}
        }
    }
    loop (local, target) in unqualified_file_module_targets(bundle, module_idx) {
        loop item in bundle.modules[target].items {
            if item == {
                Func(function) -> {
                    if !bundle.name_ledger.visible(module_idx, target, function.name) { continue }
                    ret :: function.return_type.map(fn(ty) { qualify_imported_call_type(bundle, target, "", ty) })
                    &map.insert((local.clone(), function.name.clone()), ret)
                }
                _ -> {}
            }
        }
    }
    loop (path, _, function, _, ret) in nested_file_function_entries(bundle, module_idx) {
        &map.insert(("{path}.{function}", function), ret)
    }
    loop ((alias, item), (real_mod, real_fn)) in reexport_call_map(bundle, module_idx) {
        stem :: generated_suffix(real_mod)
        real_idx :: bundle.modules.position(fn(m) { m.alias == stem }) ?? continue
        real :: bundle.modules[real_idx]
        loop it in real.items {
            if it == {
                Func(f) -> {
                    if f.name != real_fn || !bundle.name_ledger.visible(module_idx, real_idx, f.name) { continue }
                    ret :: f.return_type.map(fn(ty) { qualify_imported_call_type(bundle, real_idx, alias, ty) })
                    &map.insert((alias.clone(), item.clone()), ret)
                }
                _ -> {}
            }
        }
    }
    map
}

