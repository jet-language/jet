// Rust: crates/jet-codegen/src/Codegen/Imports.rs:1370
fn namespace_member_owner(bundle: ProgramBundle, target: USize, name: String) -> USize {
    declares :: fn(module: USize) {
        bundle.name_ledger.declaration(module, name) != None || bundle.modules[module].items.any(fn(item) {
            if item == { Func(function) -> function.name == name _ -> false }
        })
    }
    if declares(target) { return target }
    bundle.name_ledger.namespace_siblings(target).find(fn(sibling) { declares(sibling) }) ?? target
}

