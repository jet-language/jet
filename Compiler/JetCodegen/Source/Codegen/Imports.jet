use jet_codegen.AST.[AccessConvention, ImportDecl, ImportKind, Item, LoadedModule, ProgramBundle, Type, VariantPayload, ForeignNamespace, ForeignLanguage, CoreListPath, walk_imports, core_list_prefix, core_list_path, mangle]
use jet_codegen.Codegen.[Cx, CoreSourceFunctionSignature, type_is_cloneable_struct, type_is_hashable_struct, type_is_cloneable_enum, type_is_hashable_enum, nominal_leaf]
use jet_codegen.Codegen.TIR.[qualify_imported_type]
use jet_codegen.Codegen.Context.[module_identity]
use jet_foundation.CoreModuleExports.[CoreSourceModule, core_source_module, core_source_module_by_alias, core_source_owns]
use jet_foundation.CoreSourceParts.[core_private_source_part, CORE_TEXT_STRING_OWNER]
use jet_foundation.Names.[member_name]
use jet_codegen.Syntax.[generated_suffix]

// Rust: crates/jet-codegen/src/Codegen/Imports.rs:7
fn all_imports(module: LoadedModule) -> [(String?, ImportDecl)] {
    walk_imports(module)
}

// Rust: crates/jet-codegen/src/Codegen/Imports.rs:15
fn foreign_imports_after_frontend(imp: ImportDecl) -> [(ForeignNamespace, String)] {
    imp.foreign_imports() catch error {
        panic("invalid foreign import reached codegen after sema: {error.path}")
    }
}

// Rust: crates/jet-codegen/src/Codegen/Imports.rs:24
fn is_c_import_after_frontend(imp: ImportDecl) -> Bool {
    imp.is_c_import() catch error {
        panic("invalid foreign import reached codegen after sema: {error.path}")
    }
}

// Rust: crates/jet-codegen/src/Codegen/Imports.rs:33
fn is_foreign_member_list(imp: ImportDecl) -> Bool {
    if imp.kind == {
        Unqualified{..} -> !foreign_imports_after_frontend(imp).is_empty()
        _ -> false
    }
}

// Rust: crates/jet-codegen/src/Codegen/Imports.rs:41
fn resolve_target(bundle: ProgramBundle, module_idx: USize, imp: ImportDecl) -> USize? {
    bundle.name_ledger.import_target(module_idx, imp.span)
}

// Rust: crates/jet-codegen/src/Codegen/Imports.rs:45
fn required_import_target(bundle: ProgramBundle, module_idx: USize, imp: ImportDecl) -> USize {
    resolve_target(bundle, module_idx, imp) ?? panic("import target missing after sema: module={module_idx} alias={imp.import_alias()} span={imp.span:?}")
}

// Rust: crates/jet-codegen/src/Codegen/Imports.rs:56
fn required_c_target(bundle: ProgramBundle, module_idx: USize, scope: String?, alias: String) -> USize {
    bundle.cffi.target_for_scope(module_idx, scope, alias) ?? panic("C import target missing after sema: module={module_idx} scope={scope:?} alias={alias}")
}

// Rust: crates/jet-codegen/src/Codegen/Imports.rs:73
fn foreign_target(bundle: ProgramBundle, module_idx: USize, namespace: ForeignNamespace, alias: String, scope: String?) -> (String, USize)? {
    target :: if namespace.language == ForeignLanguage.C {
        bundle.cffi.target_for_scope(module_idx, scope, alias)
    } else {
        bundle.modules.position(fn(module) { module.display == namespace.display() })
    }
    if target == {
        Val(index) -> Val((alias, index))
        None -> None
    }
}

// Rust: crates/jet-codegen/src/Codegen/Imports.rs:95
fn foreign_import_targets_in_scope(bundle: ProgramBundle, module_idx: USize, imp: ImportDecl, scope: String?) -> [(String, USize)] {
    loop (namespace, alias) in foreign_imports_after_frontend(imp) ->
        foreign_target(bundle, module_idx, namespace, alias, scope) ?? panic("foreign import target missing after sema: module={module_idx} scope={scope:?}")
}

// Rust: crates/jet-codegen/src/Codegen/Imports.rs:117
fn foreign_list_targets(bundle: ProgramBundle, module_idx: USize, imp: ImportDecl) -> [(String, USize)] {
    foreign_list_targets_in_scope(bundle, module_idx, imp, None)
}

// Rust: crates/jet-codegen/src/Codegen/Imports.rs:125
fn foreign_list_targets_in_scope(bundle: ProgramBundle, module_idx: USize, imp: ImportDecl, scope: String?) -> [(String, USize)] {
    if imp.kind == {
        Unqualified{..} -> foreign_import_targets_in_scope(bundle, module_idx, imp, scope)
        _ -> []
    }
}

// Rust: crates/jet-codegen/src/Codegen/Imports.rs:136
fn file_import_target(bundle: ProgramBundle, module_idx: USize, alias: String) -> USize? {
    loop imp in bundle.modules[module_idx].imports {
        if imp.kind == { Unqualified{..} -> true _ -> false } { continue }
        if imp.import_alias() != alias { continue }
        if resolve_target(bundle, module_idx, imp) == { Val(target) -> return Val(target) None -> {} }
    }
    None
}

// Rust: crates/jet-codegen/src/Codegen/Imports.rs:145
fn inline_code_module_named(bundle: ProgramBundle, module_idx: USize, name: String) -> Bool {
    bundle.modules[module_idx].items.any(fn(item) {
        if item == { CodeModule(cm) -> cm.body != None && cm.name == name _ -> false }
    })
}

// Rust: crates/jet-codegen/src/Codegen/Imports.rs:157
fn selective_nominal_targets(bundle: ProgramBundle, module_idx: USize) -> [(USize, String)] {
    targets := [(USize, String)]{}
    loop import in bundle.modules[module_idx].imports {
        if !(if import.kind == { Unqualified{..} -> true _ -> false }) { continue }
        loop binding in import.walk_bindings() {
            original :: binding.original ?? continue
            local :: binding.local
            target :: bundle.name_ledger.alias(module_idx, local).and_then(fn(alias) { alias.target_module })
                ?? core_list_prefix(binding.module_alias).and_then(fn(path) { core_source_target(bundle, path).map(fn(pair) { pair.1 }) })
                ?? continue
            leaf :: original.rsplit('.').next() ?? original
            is_nominal :: bundle.modules[target].items.any(fn(item) {
                if item == {
                    Struct(definition) -> definition.name == leaf
                    Enum(definition) -> definition.name == leaf
                    Distinct(definition) -> definition.name == leaf
                    UnitFamily(family) -> family.distinct_defs().any(fn(member) { member.name == leaf })
                    _ -> false
                }
            })
            if is_nominal && bundle.name_ledger.visible(module_idx, target, leaf) {
                &targets.push((target, leaf.to_string()))
            }
        }
    }
    &targets.sort()
    &targets.dedup()
    targets
}

// Rust: crates/jet-codegen/src/Codegen/Imports.rs:203
fn qualify_unit_type(bundle: ProgramBundle, target: USize, ty: Type) -> Type {
    ty.map_named_types(fn(name) {
        found :: bundle.modules[target].items.any(fn(item) {
            if item == {
                UnitFamily(family) -> family.distinct_defs().any(fn(member) { member.name == name })
                _ -> false
            }
        })
        if found {
            Val(bundle.name_ledger.nominal_identity(target, name) ?? panic("name ledger must contain every loaded module"))
        } else { None }
    })
}

// Rust: crates/jet-codegen/src/Codegen/Imports.rs:218
fn qualify_imported_call_type(bundle: ProgramBundle, target: USize, _alias: String, ty: Type) -> Type {
    unit_qualified :: qualify_unit_type(bundle, target, ty)
    owner :: bundle.name_ledger.module_identity(target) ?? panic("name ledger must contain every loaded module")
    qualify_imported_type(bundle, target, owner, [], unit_qualified)
}

// Rust: crates/jet-codegen/src/Codegen/Imports.rs:234
fn update_cloneability_with_foreign_types(mut cx: Cx, items: [Item]) {
    foreign_leaf_counts := [String:USize]{}
    loop name in cx.foreign_types.keys() {
        &cx.type_names.insert(name.clone())
        leaf :: nominal_leaf(name).to_string()
        &foreign_leaf_counts.insert(leaf, (foreign_leaf_counts.get(leaf) ?? 0) + 1)
    }
    // Only unique leaves may participate in the existing cloneability walk.
    loop (leaf, count) in foreign_leaf_counts {
        if count == 1 { &cx.type_names.insert(leaf) }
    }
    secret :: cx.secret_containing_types()
    loop item in items {
        if item == {
            Struct(s) -> {
                if !cx.cloneable.contains(s.name) && type_is_cloneable_struct(s, cx.type_names) && !secret.contains(s.name) {
                    &cx.cloneable.insert(s.name.clone())
                }
                if !cx.hashable.contains(s.name) && type_is_hashable_struct(s, cx.hashable) {
                    &cx.hashable.insert(s.name.clone())
                }
            }
            Enum(e) -> {
                if !cx.cloneable.contains(e.name) && type_is_cloneable_enum(e, cx.type_names) && !secret.contains(e.name) {
                    &cx.cloneable.insert(e.name.clone())
                }
                if !cx.hashable.contains(e.name) && type_is_hashable_enum(e, cx.hashable) {
                    &cx.hashable.insert(e.name.clone())
                }
            }
            _ -> {}
        }
    }
}

// Rust: crates/jet-codegen/src/Codegen/Imports.rs:283
fn foreign_type_map(bundle: ProgramBundle, module_idx: USize) -> [String:String] {
    map := [String:String]{}
    module :: bundle.modules[module_idx]
    is_local :: fn(name: String) {
        module.items.any(fn(item) {
            if item == { Struct(s) -> s.name == name Enum(e) -> e.name == name _ -> false }
        })
    }
    add_target :: fn(target: USize) {
        rust_mod :: mangle(bundle.modules[target].alias)
        // Ordering is a crate-wide runtime identity, not an imported nominal.
        loop item in bundle.modules[target].items {
            if item == {
                Struct(s) -> {
                    if bundle.name_ledger.visible(module_idx, target, s.name) && !is_local(s.name) {
                        if bundle.name_ledger.nominal_identity(target, s.name) == {
                            Val(identity) -> &map.insert(identity, rust_mod.clone())
                            None -> {}
                        }
                    }
                }
                Enum(e) -> {
                    if bundle.name_ledger.visible(module_idx, target, e.name) && !is_local(e.name) {
                        if bundle.name_ledger.nominal_identity(target, e.name) == {
                            Val(identity) -> &map.insert(identity, rust_mod.clone())
                            None -> {}
                        }
                    }
                }
                Distinct(d) -> {
                    if bundle.name_ledger.visible(module_idx, target, d.name) {
                        if bundle.name_ledger.nominal_identity(target, d.name) == {
                            Val(identity) -> &map.insert(identity, rust_mod.clone())
                            None -> {}
                        }
                    }
                }
                UnitFamily(family) -> {
                    // Public signatures can expose private unit-family carriers.
                    loop member in family.distinct_defs() {
                        if bundle.name_ledger.nominal_identity(target, member.name) == {
                            Val(identity) -> &map.insert(identity, rust_mod.clone())
                            None -> {}
                        }
                    }
                }
                _ -> {}
            }
        }
    }
    loop (scope, imp) in all_imports(module) {
        loop (_, target) in foreign_list_targets_in_scope(bundle, module_idx, imp, scope) { add_target(target) }
        if is_foreign_member_list(imp) || is_c_import_after_frontend(imp)
            || (if imp.kind == { Unqualified{..} -> true _ -> false }) || imp.core_module_path() != None { continue }
        add_target(required_import_target(bundle, module_idx, imp))
    }
    loop (target, leaf) in selective_nominal_targets(bundle, module_idx) {
        identity :: bundle.name_ledger.nominal_identity(target, leaf) ?? continue
        &map.insert(identity, mangle(bundle.modules[target].alias))
    }
    loop ((_, _), (rust_mod, _)) in reexport_call_map(bundle, module_idx) {
        target :: bundle.modules.position(fn(candidate) { mangle(candidate.alias) == rust_mod }) ?? continue
        loop item in bundle.modules[target].items {
            if item == {
                Struct(s) -> {
                    if bundle.name_ledger.visible(module_idx, target, s.name) {
                        if bundle.name_ledger.nominal_identity(target, s.name) == {
                            Val(identity) -> &map.insert(identity, rust_mod.clone())
                            None -> {}
                        }
                    }
                }
                Enum(e) -> {
                    if bundle.name_ledger.visible(module_idx, target, e.name) {
                        if bundle.name_ledger.nominal_identity(target, e.name) == {
                            Val(identity) -> &map.insert(identity, rust_mod.clone())
                            None -> {}
                        }
                    }
                }
                Distinct(d) -> {
                    if bundle.name_ledger.visible(module_idx, target, d.name) {
                        if bundle.name_ledger.nominal_identity(target, d.name) == {
                            Val(identity) -> &map.insert(identity, rust_mod.clone())
                            None -> {}
                        }
                    }
                }
                UnitFamily(family) -> {
                    loop member in family.distinct_defs() {
                        if bundle.name_ledger.nominal_identity(target, member.name) == {
                            Val(identity) -> &map.insert(identity, rust_mod.clone())
                            None -> {}
                        }
                    }
                }
                _ -> {}
            }
        }
    }
    map
}

// Rust: crates/jet-codegen/src/Codegen/Imports.rs:405
fn register_foreign_enum_variants(mut cx: Cx, bundle: ProgramBundle, module_idx: USize) {
    module :: bundle.modules[module_idx]
    loop (scope, imp) in all_imports(module) {
        loop (_, target) in foreign_list_targets_in_scope(bundle, module_idx, imp, scope) {
            loop item in bundle.modules[target].items {
                if item == {
                    Enum(e) -> {
                        if !bundle.name_ledger.visible(module_idx, target, e.name) { continue }
                        identity :: bundle.name_ledger.nominal_identity(target, e.name) ?? continue
                        binders :: loop param in e.type_params -> param.name.clone()
                        if !cx.enum_variants.contains_key(identity) {
                            variants :: loop v in e.variants -> (v.name.clone(), qualify_imported_variant_payload(bundle, target, identity, binders, v.payload))
                            &cx.enum_variants.insert(identity.clone(), variants)
                        }
                        loop v in e.variants {
                            if !cx.variant_owner.contains_key(v.name) { &cx.variant_owner.insert(v.name.clone(), identity.clone()) }
                        }
                    }
                    _ -> {}
                }
            }
        }
        if is_foreign_member_list(imp) { continue }
        if is_c_import_after_frontend(imp) { continue }
        if imp.core_module_path() == {
            Val(core_module) -> {
                if core_source_target(bundle, core_module) == {
                    Val((_, target)) -> register_core_source_enum_layouts(&cx, bundle, target)
                    None -> {}
                }
                continue
            }
            None -> {}
        }
        if imp.kind == { Unqualified{..} -> true _ -> false } { continue }
        target :: required_import_target(bundle, module_idx, imp)
        loop item in bundle.modules[target].items {
            if item == {
                Enum(e) -> {
                    if !bundle.name_ledger.visible(module_idx, target, e.name) { continue }
                    identity :: bundle.name_ledger.nominal_identity(target, e.name) ?? continue
                    binders :: loop param in e.type_params -> param.name.clone()
                    if !cx.enum_variants.contains_key(identity) {
                        variants :: loop v in e.variants -> (v.name.clone(), qualify_imported_variant_payload(bundle, target, identity, binders, v.payload))
                        &cx.enum_variants.insert(identity.clone(), variants)
                    }
                    loop v in e.variants {
                        if !cx.variant_owner.contains_key(v.name) { &cx.variant_owner.insert(v.name.clone(), identity.clone()) }
                    }
                }
                _ -> {}
            }
        }
    }
    loop (target, leaf) in selective_nominal_targets(bundle, module_idx) {
        item :: bundle.modules[target].items.find(fn(item) {
            if item == { Enum(definition) -> definition.name == leaf _ -> false }
        }) ?? continue
        if item == {
            Enum(e) -> {
                identity :: bundle.name_ledger.nominal_identity(target, leaf) ?? continue
                binders :: loop param in e.type_params -> param.name.clone()
                if !cx.enum_variants.contains_key(identity) {
                    variants :: loop variant in e.variants -> (variant.name.clone(), qualify_imported_variant_payload(bundle, target, identity, binders, variant.payload))
                    &cx.enum_variants.insert(identity.clone(), variants)
                }
                loop variant in e.variants {
                    if !cx.variant_owner.contains_key(variant.name) { &cx.variant_owner.insert(variant.name.clone(), identity.clone()) }
                }
            }
            _ -> continue
        }
    }
}

// Rust: crates/jet-codegen/src/Codegen/Imports.rs:547
// Core error layouts are needed even without a named import; do not claim bare variants.
fn register_core_source_enum_layouts(mut cx: Cx, bundle: ProgramBundle, target: USize) {
    rust_mod :: mangle(bundle.modules[target].alias)
    loop item in bundle.modules[target].items {
        if item == {
            Enum(e) -> {
                if !e.is_pub || !e.type_params.is_empty() { continue }
                identity :: bundle.name_ledger.nominal_identity(target, e.name) ?? continue
                if !cx.foreign_types.contains_key(identity) { &cx.foreign_types.insert(identity.clone(), rust_mod.clone()) }
                if !cx.enum_variants.contains_key(identity) {
                    variants :: loop variant in e.variants -> (variant.name.clone(), qualify_imported_variant_payload(bundle, target, identity, [], variant.payload))
                    &cx.enum_variants.insert(identity.clone(), variants)
                }
            }
            _ -> continue
        }
    }
}

// Rust: crates/jet-codegen/src/Codegen/Imports.rs:580
fn qualify_imported_variant_payload(bundle: ProgramBundle, target: USize, owner: String, binders: [String], payload: VariantPayload) -> VariantPayload {
    if payload == {
        Unit -> VariantPayload.Unit
        Single(ty, span) -> VariantPayload.Single(qualify_imported_type(bundle, target, owner, binders, ty), span)
        Named(fields) -> VariantPayload.Named(loop field in fields {
            qualified := field.clone()
            qualified.ty = qualify_imported_type(bundle, target, owner, binders, field.ty)
            qualified
        })
    }
}

// Rust: crates/jet-codegen/src/Codegen/Imports.rs:608
fn core_source_target(bundle: ProgramBundle, module: String) -> (CoreSourceModule, USize)? {
    source :: core_source_module(module) ?? return None
    target :: bundle.modules.position(fn(loaded) { loaded.alias == source.alias }) ?? return None
    Val((source, target))
}

// Rust: crates/jet-codegen/src/Codegen/Imports.rs:620
fn import_mod_map(bundle: ProgramBundle, module_idx: USize) -> [String:String] {
    map := [String:String]{}
    module :: bundle.modules[module_idx]
    loop imp in module.imports {
        loop (alias, target) in foreign_list_targets(bundle, module_idx, imp) {
            &map.insert(alias, mangle(bundle.modules[target].alias))
        }
        if is_foreign_member_list(imp) { continue }
        alias :: imp.import_alias()
        if is_c_import_after_frontend(imp) {
            target :: required_c_target(bundle, module_idx, None, alias)
            &map.insert(alias, mangle(bundle.modules[target].alias))
            continue
        }
        if imp.kind == { Unqualified{..} -> true _ -> false } { continue }
        if imp.core_module_path() == {
            Val(core_module) -> {
                if core_source_target(bundle, core_module) == {
                    Val((source, _)) -> &map.insert(alias, mangle(source.alias))
                    None -> {}
                }
                continue
            }
            None -> {}
        }
        target :: required_import_target(bundle, module_idx, imp)
        &map.insert(alias, mangle(bundle.modules[target].alias))
    }
    loop (local, target) in unqualified_file_module_targets(bundle, module_idx) {
        &map.insert(local, mangle(bundle.modules[target].alias))
    }
    map
}

// Rust: crates/jet-codegen/src/Codegen/Imports.rs:661
fn imported_module_paths(bundle: ProgramBundle, module_idx: USize) -> [(String, USize)] {
    paths := [(String, USize)]{}
    pending := [(String, USize, [USize:Bool])]{("", module_idx, [module_idx:true])}
    loop {
        (prefix, owner, seen) :: &pending.pop() ?? break
        loop imp in bundle.modules[owner].imports {
            if is_foreign_member_list(imp) || is_c_import_after_frontend(imp)
                || (if imp.kind == { Unqualified{..} -> true _ -> false }) || imp.core_module_path() != None { continue }
            alias :: imp.import_alias()
            target :: required_import_target(bundle, owner, imp)
            path :: if prefix.is_empty() { alias } else { "{prefix}.{alias}" }
            &paths.push((path.clone(), target))
            if seen.contains_key(target) { continue }
            next_seen := seen.clone()
            &next_seen.insert(target, true)
            &pending.push((path, target, next_seen))
        }
    }
    paths
}

// Rust: crates/jet-codegen/src/Codegen/Imports.rs:695
fn unqualified_file_module_targets(bundle: ProgramBundle, module_idx: USize) -> [(String, USize)] {
    module :: bundle.modules[module_idx]
    targets := [(String, USize)]{}
    loop imp in module.imports {
        if imp.kind == {
            Unqualified{module_alias, ..} -> {
                if is_foreign_member_list(imp) { continue }
                parent :: file_import_target(bundle, module_idx, module_alias) ?? continue
                loop binding in imp.walk_bindings() {
                    original :: binding.original ?? continue
                    declaration :: bundle.name_ledger.declaration(parent, original) ?? continue
                    if declaration.kind != "file_module" || !bundle.name_ledger.visible(module_idx, parent, original) { continue }
                    target :: bundle.name_ledger.alias(parent, original).and_then(fn(alias) { alias.target_module }) ?? continue
                    &targets.push((binding.local, target))
                }
            }
            _ -> continue
        }
    }
    targets
}

// Rust: crates/jet-codegen/src/Codegen/Imports.rs:740
// GATE #4499: tuple map keys preserve structural equality/hash.
fn reexport_call_map(bundle: ProgramBundle, module_idx: USize) -> [(String, String):(String, String)] {
    map := [(String, String):(String, String)]{}
    module :: bundle.modules[module_idx]
    loop imp in module.imports {
        if imp.kind == { Unqualified{..} -> true _ -> false } { continue }
        if imp.core_module_path() != None || is_c_import_after_frontend(imp) { continue }
        alias :: imp.import_alias()
        target_idx :: required_import_target(bundle, module_idx, imp)
        target :: bundle.modules[target_idx]
        loop reimp in target.imports {
            if reimp.kind == {
                Unqualified{module_alias, ..} -> {
                    if !reimp.is_pub { continue }
                    if is_foreign_member_list(reimp) || core_list_prefix(module_alias) != None { continue }
                    real_idx :: file_import_target(bundle, target_idx, module_alias)
                        ?? panic("re-export target missing after sema: module={target_idx} alias={module_alias}")
                    real_mod :: mangle(bundle.modules[real_idx].alias)
                    loop binding in reimp.walk_bindings() {
                        orig :: binding.original ?? panic("member walker returned a binding without a member")
                        &map.insert((alias.clone(), binding.local), (real_mod.clone(), orig.to_string()))
                    }
                }
                _ -> continue
            }
        }
    }
    // Inline-to-file reexports share the qualified map; inline-to-inline do not.
    loop item in module.items {
        if item == {
            CodeModule(cm) -> {
                loop reimp in cm.imports {
                    if reimp.kind == {
                        Unqualified{module_alias, ..} -> {
                            if !reimp.is_pub { continue }
                            if is_foreign_member_list(reimp) || core_list_prefix(module_alias) != None { continue }
                            real_idx :: file_import_target(bundle, module_idx, module_alias)
                                ?? panic("inline re-export target missing after sema: module={module_idx} alias={module_alias}")
                            real_mod :: mangle(bundle.modules[real_idx].alias)
                            loop binding in reimp.walk_bindings() {
                                orig :: binding.original ?? panic("member walker returned a binding without a member")
                                &map.insert((cm.name.clone(), binding.local), (real_mod.clone(), orig.to_string()))
                            }
                        }
                        _ -> continue
                    }
                }
            }
            _ -> continue
        }
    }
    map
}

// Rust: crates/jet-codegen/src/Codegen/Imports.rs:827
fn core_import_map(bundle: ProgramBundle, module_idx: USize) -> [String:String] {
    map := [String:String]{}
    module :: bundle.modules[module_idx]
    loop imp in module.imports {
        if imp.core_module_path() == {
            Val(core_module) -> { &map.insert(imp.import_alias(), core_module); continue }
            None -> {}
        }
        if imp.kind == {
            Unqualified{module_alias, ..} -> {
                if core_list_prefix(module_alias) == None { continue }
                loop binding in imp.walk_bindings() {
                    orig :: binding.original ?? panic("member walker returned a binding without a member")
                    local :: binding.local
                    if core_list_path(module_alias, orig) == {
                        Val(CoreListPath.Module(module)) -> &map.insert(local.to_string(), module)
