// Rust: crates/jet-codegen/src/Codegen/Imports.rs:873
fn unqualified_import_maps(bundle: ProgramBundle, module_idx: USize) -> ([String:String], [String:(String, String)]) {
    inline_map := [String:String]{}
    file_map := [String:(String, String)]{}
    module :: bundle.modules[module_idx]
    code_mod_aliases := [String:Bool]{}
    loop item in module.items {
        if item == { CodeModule(cm) -> { if cm.body != None { &code_mod_aliases.insert(cm.name.clone(), true) } } _ -> {} }
    }
    loop imp in module.imports {
        if imp.kind == {
            Unqualified{module_alias, ..} -> {
                if is_foreign_member_list(imp) || core_list_prefix(module_alias) != None { continue }
                loop binding in imp.walk_bindings() {
                    orig :: binding.original ?? panic("member walker returned a binding without a member")
                    local :: binding.local
                    alias :: bundle.name_ledger.effective_alias(module_idx, local)
                    if code_mod_aliases.contains_key(module_alias) {
                        target :: alias.map(fn(name) { name.target.clone() }) ?? member_name(module_alias, orig)
                        &inline_map.insert(local, target)
                    } else {
                        target :: alias.and_then(fn(name) { name.target_module }) ?? file_import_target(bundle, module_idx, module_alias) ?? continue
                        real_name :: alias.and_then(fn(name) {
                            name.target.rsplit_once('.').map(fn(pair) { pair.1.to_string() })
                        }) ?? orig.to_string()
                        &file_map.insert(local, (mangle(bundle.modules[target].alias), real_name))
                    }
                }
            }
            _ -> continue
        }
    }
    loop (path, rust_mod, function, _, _) in nested_file_function_entries(bundle, module_idx) {
        &file_map.insert("{path}.{function}", (rust_mod, function))
    }
    (inline_map, file_map)
}

