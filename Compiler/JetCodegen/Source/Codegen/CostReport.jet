// Read-only projection of frozen typed evidence. No adapter text is inspected.
use jet_foundation.[Span, TExpr, TStmt, TFunc, TLambda, TIfCond, TPattern, TPatternShape, TCostKind, TCostState, TCoreClosureKind, tir_cost_fact]

struct TCostSite {
    function: String
    span: Span
    loop_depth: Int
    kind: TCostKind
    state: TCostState
}
struct TCostReport { sites: [TCostSite]{[TCostSite]{}} }

fn jet_codegen_cost_lambda(value: TLambda, function: String, depth: Int, sites: &[TCostSite]) {
    if value.executable == {
        .Expr(expression) -> jet_codegen_cost_expr(expression, function, depth, &sites)
        .Block(body) -> jet_codegen_cost_stmts(body, function, depth, &sites)
    }
}
fn jet_codegen_cost_expr(value: TExpr, function: String, depth: Int, sites: &[TCostSite], consumed: Bool{false}, override_state: TCostState?{None}) {
    // Reuse the archived collector's direct-cost projection (a3b4fbea8):
    // constructing the whole fact channel needlessly retains the expression.
    if tir_cost_fact(value) == .Val(fact) {
        state :: override_state ?? fact.state
        span :: if value.kind == .CoreCall(_, _, source_span, _, _, _, _) -> source_span else -> value.span
        if !consumed || fact.kind != TCostKind.OutcomeConstruction || state == TCostState.OptimizerRemoved -> &sites.push(TCostSite{function: function, span: span, loop_depth: depth, kind: fact.kind, state: state})
    }
    // Reuse the archived in-place traversal, adapted to the canonical TIR.
    // Containers retain statement boundaries and no child arrays are built.
    if value.kind == {
        .Drop(inner) | .Try(inner, _, _) | .OptField(inner, _, _) -> {
            jet_codegen_cost_expr(inner, function, depth, &sites, true)
            return
        }
        .TryWithContext(inner, note, _, _, _, _) -> {
            jet_codegen_cost_expr(inner, function, depth, &sites, true)
            if note == .Val(note_value) -> jet_codegen_cost_expr(note_value, function, depth, &sites)
            return
        }
        .OrFallback(inner, fallback, _) -> {
            jet_codegen_cost_expr(inner, function, depth, &sites, true, Val(TCostState.OptimizerRemoved))
            if fallback == {
                .Value(fallback_value) | .Panic(fallback_value, _) -> jet_codegen_cost_expr(fallback_value, function, depth, &sites)
                .Return(return_value) -> {
                    if return_value == .Val(nested) -> jet_codegen_cost_expr(nested, function, depth, &sites)
                }
                else -> {}
            }
            return
        }
        .DecodeUnder(segment, inner) -> {
            jet_codegen_cost_expr(segment, function, depth, &sites)
            jet_codegen_cost_expr(inner, function, depth, &sites, true)
            return
        }
        .PatternMatches(subject, pattern) -> {
            jet_codegen_cost_expr(subject, function, depth, &sites, true)
            jet_codegen_cost_pattern(pattern, function, depth, &sites)
            return
        }
        .OptionLift2(callable, left, right) -> {
            jet_codegen_cost_expr(callable, function, depth, &sites)
            jet_codegen_cost_expr(left, function, depth, &sites, true)
            jet_codegen_cost_expr(right, function, depth, &sites, true)
            return
        }
        .FnValue(kind) -> {
            if kind == {
                .NamedFn(_, lambda) -> {
                    if lambda == .Val(executable) -> jet_codegen_cost_lambda(executable, function, depth, &sites)
                }
                .Policy(_, args, _, _, _, callee) | .Call(callee, args) -> {
                    jet_codegen_cost_expr(callee, function, depth, &sites)
                    loop argument in args -> jet_codegen_cost_expr(argument.value, function, depth, &sites)
                }
                .Send(child) -> jet_codegen_cost_expr(child, function, depth, &sites)
            }
            return
        }
        .InlineBlock(body) -> {
            jet_codegen_cost_stmts(body, function, depth, &sites)
            return
        }
        .Lambda(lambda) -> {
            jet_codegen_cost_lambda(lambda, function, depth, &sites)
            return
        }
        .IfExpr(condition, left, left_value, right, right_value) -> {
            jet_codegen_cost_condition(condition, function, depth, &sites)
            jet_codegen_cost_stmts(left, function, depth, &sites)
            jet_codegen_cost_expr(left_value, function, depth, &sites)
            jet_codegen_cost_stmts(right, function, depth, &sites)
            jet_codegen_cost_expr(right_value, function, depth, &sites)
            return
        }
        .ResultHandler(subject, ok_pattern, ok_body, ok_value, err_pattern, err_body, err_value, terminal) -> {
            jet_codegen_cost_expr(subject, function, depth, &sites, true)
            jet_codegen_cost_pattern(ok_pattern, function, depth, &sites)
            jet_codegen_cost_stmts(ok_body, function, depth, &sites)
            jet_codegen_cost_expr(ok_value, function, depth, &sites)
            jet_codegen_cost_pattern(err_pattern, function, depth, &sites)
            jet_codegen_cost_stmts(err_body, function, depth, &sites)
            jet_codegen_cost_expr(err_value, function, depth, &sites)
            jet_codegen_cost_expr(terminal, function, depth, &sites)
            return
        }
        .SharedGuardWait(guard, condition, predicate) -> {
            jet_codegen_cost_expr(guard, function, depth, &sites)
            jet_codegen_cost_expr(condition, function, depth, &sites)
            jet_codegen_cost_lambda(predicate, function, depth, &sites)
            return
        }
        .CoreClosureCall(kind) -> {
            jet_codegen_cost_core_closure(kind, function, depth, &sites)
            return
        }
        .HostCall(call) -> {
            if call == {
                .OptionProbe(inner, _) -> {
                    jet_codegen_cost_expr(inner, function, depth, &sites, true)
                    return
                }
                .Method(receiver, _, args) -> {
                    jet_codegen_cost_expr(receiver, function, depth, &sites)
                    loop child in args -> jet_codegen_cost_expr(child, function, depth, &sites)
                }
                .CellGuardProject(child, _, _, _, _) | .TypedText(_, child) | .TupleIndex(child, _) | .YieldSend(child) -> jet_codegen_cost_expr(child, function, depth, &sites)
                .TypedTextInterp(_, _, holes, _) -> loop child in holes -> jet_codegen_cost_expr(child, function, depth, &sites)
                else -> {}
            }
        }
        else -> {}
    }
    if value.kind == {
        .StrLit(parts) -> loop part in parts {
            if part == .Interpolation(child, _) -> jet_codegen_cost_expr(child, function, depth, &sites)
        }
        .Call(_, _, args) | .AllocNew(_, args) | .StaticCall(_, _, _, _, args) -> loop argument in args -> jet_codegen_cost_expr(argument.value, function, depth, &sites)
        .IndirectCall(callee, _, args, _) | .MethodCall(callee, _, _, args) -> {
            jet_codegen_cost_expr(callee, function, depth, &sites)
            loop argument in args -> jet_codegen_cost_expr(argument.value, function, depth, &sites)
        }
        .DistinctCtor(child) | .DistinctConvert(_, child, _, _, _)
        | .TraitBox(child, _) | .Print(child) | .Close(child) | .Move(child)
        | .Unary(_, child) | .Field(child, _) | .Present(child) | .Ok(child) | .Err(child)
        | .DistinctRaw(child) | .Borrow(child, _) | .RawOf(child) | .Deref(child) | .PtrFromAddr(child, _)
        | .LayoutLiteral(child) | .SharedGuardValue(child) | .SharedGuardMap(child, _, _)
        | .SharedGuardSplit(child, _, _, _) | .ConditionNotify(child, _) | .MathSwizzleRead(_, child, _)
        | .Clone(child, _) | .ExplicitCopy(child) | .MaterializeView(child) | .HostBorrowCallback(child, _)
        | .NumericMethod(child, _) | .TaskGroupAll(child) | .TaskGroupRace(child) | .TaskGroupAny(child)
        | .SelectWait(child, _) -> jet_codegen_cost_expr(child, function, depth, &sites)
        .UnitConvert(child, _, _, rounding, _, _, _, _) -> {
            jet_codegen_cost_expr(child, function, depth, &sites)
            if rounding == .Val(rounding_value) -> jet_codegen_cost_expr(rounding_value.digits, function, depth, &sites)
        }
        .AmbientInput(child) | .JSONLit(_, child, _) | .DBValueLit(_, child, _) -> {
            if child == .Val(expression) -> jet_codegen_cost_expr(expression, function, depth, &sites)
        }
        .RequireStop(kind, _, _) -> if kind == {
            .Require(condition, message) -> {
                jet_codegen_cost_expr(condition, function, depth, &sites)
                if message == .Val(child) -> jet_codegen_cost_expr(child, function, depth, &sites)
            }
            .RequireEq(left, right) -> {
                jet_codegen_cost_expr(left, function, depth, &sites)
                jet_codegen_cost_expr(right, function, depth, &sites)
            }
            .Panic(child) -> jet_codegen_cost_expr(child, function, depth, &sites)
        }
        .MathBuiltin(_, _, children) | .PreciseBuiltin(_, _, children) | .CompareChain(children, _, _)
        | .Tuple(children) | .List(children, _) | .ListLit(children)
        | .CoreCall(_, children, _, _, _, _, _) -> loop child in children -> jet_codegen_cost_expr(child, function, depth, &sites)
        .StructLit(fields) -> loop field in fields -> jet_codegen_cost_expr(field.value, function, depth, &sites)
        .Map(entries) | .MapLit(entries) -> loop entry in entries {
            jet_codegen_cost_expr(entry.key, function, depth, &sites)
            jet_codegen_cost_expr(entry.value, function, depth, &sites)
        }
        .EnumCtor(_, _, payload) | .EnumLit(_, _, payload) -> if payload == {
            .Positional(args) -> loop argument in args -> jet_codegen_cost_expr(argument.value, function, depth, &sites)
            .Named(fields) -> loop field in fields -> jet_codegen_cost_expr(field.value.value, function, depth, &sites)
            .Unit -> {}
        }
        .RawAddressOf(place) -> {
            if place == .Expr(child) -> jet_codegen_cost_expr(child, function, depth, &sites)
        }
        .Binary(_, _, _, left, right) | .LayoutCompare(_, left, right) | .NumericBinaryMethod(left, _, right)
        | .OverflowOpt(_, _, _, left, right) | .Index(left, right, _, _, _, _)
        | .PoolSlot(left, right, _, _, _, _) | .MathLaneIndex(_, left, right, _)
        | .Range(left, right, _) | .SelectRecv(left, right) -> {
            jet_codegen_cost_expr(left, function, depth, &sites)
            jet_codegen_cost_expr(right, function, depth, &sites)
        }
        .Slice(base, start, end, range, _) -> {
            jet_codegen_cost_expr(base, function, depth, &sites)
            jet_codegen_cost_expr(start, function, depth, &sites)
            jet_codegen_cost_expr(end, function, depth, &sites)
            if range == .Val(child) -> jet_codegen_cost_expr(child, function, depth, &sites)
        }
        .ListSpread(parts) -> loop part in parts {
            if part == {.Element(child) | .Spread(child) -> jet_codegen_cost_expr(child, function, depth, &sites)}
        }
        .BuiltinMethod(receiver, _, args) | .ClosureMethod(receiver, _, args) | .HandleMethod(receiver, _, args) -> {
            jet_codegen_cost_expr(receiver, function, depth, &sites)
            loop child in args -> jet_codegen_cost_expr(child, function, depth, &sites)
        }
        .OptMethodCall(base, _, call, _) -> {
            jet_codegen_cost_expr(base, function, depth, &sites, true)
            jet_codegen_cost_expr(call, function, depth, &sites)
        }
        .SelectAfter(builder, duration, child) -> {
            jet_codegen_cost_expr(builder, function, depth, &sites)
            jet_codegen_cost_expr(duration, function, depth, &sites)
            if child == .Val(expression) -> jet_codegen_cost_expr(expression, function, depth, &sites)
        }
        else -> {}
    }
}
fn jet_codegen_cost_core_closure(kind: TCoreClosureKind, function: String, depth: Int, sites: &[TCostSite]) {
    if kind == {
        .Spawn(group, _, _, executable) -> {
            if group == .Val(value) -> jet_codegen_cost_expr(value, function, depth, &sites)
            jet_codegen_cost_lambda(executable, function, depth, &sites)
        }
        .Realtime(rate, frames, executable) -> {
            jet_codegen_cost_expr(rate, function, depth, &sites)
            jet_codegen_cost_expr(frames, function, depth, &sites)
            jet_codegen_cost_lambda(executable, function, depth, &sites)
        }
        .UITextInputOnDrop(state, ime, executable) -> {
            jet_codegen_cost_expr(state, function, depth, &sites)
            jet_codegen_cost_expr(ime, function, depth, &sites)
            jet_codegen_cost_lambda(executable, function, depth, &sites)
        }
        .Guard(executable) | .ReactiveDerived(executable) | .ReactiveEffect(executable) | .UIReactiveRender(executable) | .OnCommit(_, executable) | .OnRollback(_, executable) -> jet_codegen_cost_lambda(executable, function, depth, &sites)
        .UIButtonOnClick(label, shortcut, accessible, executable) -> {
            jet_codegen_cost_expr(label, function, depth, &sites)
            jet_codegen_cost_expr(shortcut, function, depth, &sites)
            jet_codegen_cost_expr(accessible, function, depth, &sites)
            jet_codegen_cost_lambda(executable, function, depth, &sites)
        }
    }
}
fn jet_codegen_cost_condition(condition: TIfCond, function: String, depth: Int, sites: &[TCostSite]) {
    if condition == {
        .Plain(value) -> jet_codegen_cost_expr(value, function, depth, &sites)
        .And(left, right) -> {
            jet_codegen_cost_condition(left, function, depth, &sites)
            jet_codegen_cost_condition(right, function, depth, &sites)
        }
        .IfLet(pattern, subject) -> {
            jet_codegen_cost_expr(subject, function, depth, &sites, true)
            jet_codegen_cost_pattern(pattern, function, depth, &sites)
        }
    }
}
fn jet_codegen_cost_stmts(body: [TStmt], function: String, depth: Int, sites: &[TCostSite]) {
    loop statement in body -> jet_codegen_cost_stmt(statement, function, depth, &sites)
}
fn jet_codegen_cost_stmt(statement: TStmt, function: String, depth: Int, sites: &[TCostSite]) {
    if statement == {
        .ExprStmt(value, _) -> jet_codegen_cost_expr(value, function, depth, &sites, true)
        .Loop(_, body, _) -> jet_codegen_cost_stmts(body, function, depth + 1, &sites)
        .While(_, condition, body, _) -> {
            jet_codegen_cost_expr(condition, function, depth + 1, &sites)
            jet_codegen_cost_stmts(body, function, depth + 1, &sites)
        }
        .CountedLoop(_, init, condition, step, _, body, _) -> {
            jet_codegen_cost_stmt(init, function, depth, &sites)
            jet_codegen_cost_expr(condition, function, depth + 1, &sites)
            if step == .Val(value) -> jet_codegen_cost_stmt(value, function, depth + 1, &sites)
            jet_codegen_cost_stmts(body, function, depth + 1, &sites)
        }
        .ForRange(_, _, start, end, step, _, body, _, _) -> {
            jet_codegen_cost_expr(start, function, depth, &sites)
            jet_codegen_cost_expr(end, function, depth, &sites)
            if step == .Val(value) -> jet_codegen_cost_expr(value, function, depth, &sites)
            jet_codegen_cost_stmts(body, function, depth + 1, &sites)
        }
        .Range(_, _, source, start, end, step, _, _, body, _) -> {
            if source == .Val(value) -> jet_codegen_cost_expr(value, function, depth, &sites)
            jet_codegen_cost_expr(start, function, depth, &sites)
            jet_codegen_cost_expr(end, function, depth, &sites)
            if step == .Val(value) -> jet_codegen_cost_expr(value, function, depth, &sites)
            jet_codegen_cost_stmts(body, function, depth + 1, &sites)
        }
        .ForIn(_, _, _, source, collection, step, _, _, _, _, body, _) -> {
            jet_codegen_cost_expr(source, function, depth, &sites)
            jet_codegen_cost_expr(collection, function, depth, &sites)
            if step == .Val(value) -> jet_codegen_cost_expr(value, function, depth, &sites)
            jet_codegen_cost_stmts(body, function, depth + 1, &sites)
        }
        .If(condition, yes, no, _, _) -> {
            jet_codegen_cost_condition(condition, function, depth, &sites)
            jet_codegen_cost_stmts(yes, function, depth, &sites)
            if no == .Val(body) -> jet_codegen_cost_stmts(body, function, depth, &sites)
        }
        .ContractScope(pre, body, post, _, _) -> {
            loop contract in pre {
                jet_codegen_cost_expr(contract.condition, function, depth, &sites)
                jet_codegen_cost_expr(contract.message, function, depth, &sites)
            }
            jet_codegen_cost_stmts(body, function, depth, &sites)
            loop contract in post {
                jet_codegen_cost_expr(contract.condition, function, depth, &sites)
                jet_codegen_cost_expr(contract.message, function, depth, &sites)
            }
        }
        .TaskGroup(_, limit, body, _) -> {
            if limit == .Val(value) -> jet_codegen_cost_expr(value, function, depth, &sites)
            jet_codegen_cost_stmts(body, function, depth, &sites)
        }
        .RefutableBind(pattern, init, fallback, _) -> {
            jet_codegen_cost_pattern(pattern, function, depth, &sites)
            jet_codegen_cost_expr(init, function, depth, &sites, true)
            jet_codegen_cost_stmts(fallback, function, depth, &sites)
        }
        .Match(subject, arms, _, _) -> {
            jet_codegen_cost_expr(subject, function, depth, &sites, true)
            loop arm in arms {
                jet_codegen_cost_pattern(arm.pattern, function, depth, &sites)
                jet_codegen_cost_stmts(arm.body, function, depth, &sites)
            }
        }
        .EnumMatch(subject, arms, otherwise, _, _) -> {
            jet_codegen_cost_expr(subject, function, depth, &sites, true)
            loop arm in arms {
                jet_codegen_cost_pattern(arm.pattern, function, depth, &sites)
                jet_codegen_cost_stmts(arm.body, function, depth, &sites)
            }
            if otherwise == .Val(body) -> jet_codegen_cost_stmts(body, function, depth, &sites)
        }
        .RangeSwitch(subject, arms, otherwise, _) -> {
            jet_codegen_cost_expr(subject, function, depth, &sites)
            loop arm in arms -> jet_codegen_cost_stmts(arm.body, function, depth, &sites)
            jet_codegen_cost_stmts(otherwise, function, depth, &sites)
        }
        .MixedSwitch(subject, _, arms, otherwise, _) -> {
            jet_codegen_cost_expr(subject, function, depth, &sites)
            loop arm in arms {
                jet_codegen_cost_expr(arm.condition, function, depth, &sites)
                jet_codegen_cost_stmts(arm.body, function, depth, &sites)
            }
            if otherwise == .Val(body) -> jet_codegen_cost_stmts(body, function, depth, &sites)
        }
        .Inline(body, _) | .DebugOnly(body, _) | .Impure(body, _) | .Region(body, _) | .Live(body, _) | .Shield(body, _) | .Unsafe(_, body) | .UnsafeBlock(_, body, _) | .SentryPolicy(_, body, _) | .Layout(_, _, body, _) | .Transact(_, _, _, body, _) -> jet_codegen_cost_stmts(body, function, depth, &sites)
        .Reactive(executable, _) -> jet_codegen_cost_lambda(executable, function, depth, &sites)
        .ContextBlock(guards, body, _) -> {
            loop guard in guards -> jet_codegen_cost_expr(guard.value, function, depth, &sites)
            jet_codegen_cost_stmts(body, function, depth, &sites)
        }
        .ScopeMember(kind, body, _) -> {
            if kind == .Timeout(duration) -> jet_codegen_cost_expr(duration, function, depth, &sites)
            jet_codegen_cost_stmts(body, function, depth, &sites)
        }
        .GCEdit(_, _, _, _, index, edited, _) -> {
            if index == .Val(value) -> jet_codegen_cost_expr(value, function, depth, &sites)
            jet_codegen_cost_stmt(edited, function, depth, &sites)
        }
        .Contract(contract) -> {
            jet_codegen_cost_expr(contract.condition, function, depth, &sites)
            jet_codegen_cost_expr(contract.message, function, depth, &sites)
        }
        .Let(_, _, init, _, _, _) | .TupleDestructure(_, init, _, _, _) | .StructDestructure(_, init, _, _, _)
        | .ListDestructure(_, init, _, _, _, _) | .DeferClose(init, _, _) | .BreakValue(_, init, _) -> jet_codegen_cost_expr(init, function, depth, &sites)
        .Assign(place, _, child, _, _) -> {
            if place == .Expr(expression) -> jet_codegen_cost_expr(expression, function, depth, &sites)
            jet_codegen_cost_expr(child, function, depth, &sites)
        }
        .Return(child, _) -> {
            if child == .Val(expression) -> jet_codegen_cost_expr(expression, function, depth, &sites)
        }
        else -> {}
    }
}
fn jet_codegen_cost_pattern(pattern: TPattern, function: String, depth: Int, sites: &[TCostSite]) {
    jet_codegen_cost_pattern_shape(pattern.shape, function, depth, &sites)
}
fn jet_codegen_cost_pattern_shape(shape: TPatternShape, function: String, depth: Int, sites: &[TCostSite]) {
    if shape == {
        .Or(alternatives, _) -> loop alternative in alternatives -> jet_codegen_cost_pattern_shape(alternative, function, depth, &sites)
        .Struct(fields, _) -> loop field in fields {
            if field == .Value(_, child, _) -> jet_codegen_cost_expr(child, function, depth, &sites)
        }
        else -> {}
    }
}
fn jet_codegen_cost_report(functions: [TFunc]) -> TCostReport {
    report := TCostReport{}
    loop function in functions {
        if function.synthetic -> next
        jet_codegen_cost_stmts(function.body, function.name, 0, &report.sites)
    }
    report
}
