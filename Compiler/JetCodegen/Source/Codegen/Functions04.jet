        (Syntax.TYPE_BUILD_CONTEXT, "program") -> Type.Named(Syntax.TYPE_PROGRAM_INFO)
        (Syntax.TYPE_BUILD_CONTEXT, "__session") -> Type.Int
        (Syntax.TYPE_PROGRAM_INFO, "types") -> Type.List(Type.Named(Syntax.TYPE_TYPE_INFO))
        (Syntax.TYPE_TYPE_INFO, "span") -> Type.Named(Syntax.TYPE_SOURCE_SPAN)
        (Syntax.TYPE_TYPE_INFO, "markers" | "expanded_markers" | "implements") -> Type.List(Type.String)
