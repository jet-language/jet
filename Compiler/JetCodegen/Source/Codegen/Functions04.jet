// Rust: crates/jet-codegen/src/Codegen/TIR/mod.rs:1762
pub fn bind_generic_type(template: Type, actual: Type, params: Set<String>, subst: &[String: Type]) -> Bool Never! {
    if template == {
        .Named(name) if params.contains(name) -> {
            if subst.get(name) == {
                Val(bound) if bound == actual -> true
                Val(.Named(bound_name)) -> {
                    if actual != .Named(actual_name) -> return false
                    same_leaf :: bound_name.rsplit("::").next() == actual_name.rsplit("::").next()
                    one_is_unqualified :: !bound_name.contains("::") || !actual_name.contains("::")
                    if same_leaf && one_is_unqualified {
                        &subst.insert(~name, ~actual)
                        true
                    } else -> false
                }
                Val(_) -> false
                None -> { &subst.insert(~name, ~actual); true }
            }
        }
        .Apply{name, args} -> {
            if actual != .Apply{name: actual_name, args: actual_args} -> return false
            name == actual_name && args.len() == actual_args.len() && args.zip(actual_args).all(fn(pair) { bind_generic_type(pair.0, pair.1, params, &subst) })
        }
        .List(inner) -> if actual == { .List(actual_inner) -> bind_generic_type(inner, actual_inner, params, &subst); else -> false }
        .Option(inner) -> if actual == { .Option(actual_inner) -> bind_generic_type(inner, actual_inner, params, &subst); else -> false }
        .Map{key, value, ..} -> if actual == { .Map{key: actual_key, value: actual_value, ..} -> bind_generic_type(key, actual_key, params, &subst) && bind_generic_type(value, actual_value, params, &subst); else -> false }
        .Shared(inner) -> if actual == { .Shared(actual_inner) -> bind_generic_type(inner, actual_inner, params, &subst); else -> false }
        .Tuple(fields) -> if actual == { .Tuple(actual_fields) -> fields.len() == actual_fields.len() && fields.zip(actual_fields).all(fn(pair) { pair.0.0 == pair.1.0 && bind_generic_type(pair.0.1, pair.1.1, params, &subst) }); else -> false }
        .Result{ok, err} -> if actual == { .Result{ok: actual_ok, err: actual_err} -> bind_generic_type(ok, actual_ok, params, &subst) && bind_generic_type(err, actual_err, params, &subst); else -> false }
        .Fn{params: template_params, ret: template_ret, ..} -> {
            if actual != .Fn{params: actual_params, ret: actual_ret, ..} -> return false
            template_params.len() == actual_params.len() && template_params.zip(actual_params).all(fn(pair) { bind_generic_type(pair.0, pair.1, params, &subst) })
                && (if (template_ret, actual_ret) == {
                    (Val(template), Val(actual)) -> if (template, actual) == {
                        (.Result{ok: template_ok, err: template_err}, .Result{ok: actual_ok, err: actual_err}) if actual_err.is_never() ->
                            bind_generic_type(template_ok, actual_ok, params, &subst)
                            && (!(if template_err == { .Named(name) -> params.contains(name); else -> false }) || bind_generic_type(template_err, actual_err, params, &subst))
                        (.Result{..}, actual) -> bind_generic_type(template, actual, params, &subst)
                        (_, .Result{ok, ..}) -> bind_generic_type(template, ok, params, &subst)
                        (_, actual) -> bind_generic_type(template, actual, params, &subst)
                    }
                    (None, None) -> true
                    else -> false
                })
        }
        .Tagged{inner, ..} -> bind_generic_type(inner, actual, params, &subst)
        else -> template == actual
    }
}

// Rust: crates/jet-codegen/src/Codegen/TIR/mod.rs:1892
fn generic_call_shape(args: [TCallArg], type_args: [Type]) -> [Type] Never! {
    shape := loop arg in args {
        if arg.widen_to_vec && arg.value.ty == .FixedList{elem, ..} -> Type.List(~elem) else -> ~arg.value.ty
    }
    &shape.extend(type_args)
    ^shape
}
// Rust: crates/jet-codegen/src/Codegen/TIR/mod.rs:1909
fn generic_call_substitution(param_types: [Type], type_param_names: [String], actuals: [Type]) -> [String: Type]? Never! {
    if type_param_names.is_empty() -> return None
    (param_actuals, explicit_actuals) :: if actuals.len() == param_types.len() + type_param_names.len() -> actuals.split_at(param_types.len())
        else if actuals.len() == param_types.len() -> (actuals, []) else -> return None
    names :: Set<String>.from(type_param_names)
    subst := [String: Type]{}
    loop (param, actual) in type_param_names.zip(explicit_actuals) -> &subst.insert(~param, ~actual)
    if !param_types.zip(param_actuals).all(fn(pair) { bind_generic_type(pair.0, pair.1, names, &subst) }) || subst.len() != names.len() -> return None
    Val(^subst)
}
// Rust: crates/jet-codegen/src/Codegen/TIR/mod.rs:1941
pub fn demand_generic_free_function(cx: Cx, name: String, args: [TCallArg], explicit_type_args: [Type]) -> String? Never! {
    type_param_names :: cx.fn_type_param_order.get(name)?
    if type_param_names.is_empty() -> return None
    sig :: cx.sigs.get(name)?
    param_types :: loop (_, ty) in sig -> ~ty
    shape :: generic_call_shape(args, explicit_type_args)
    subst :: generic_call_substitution(param_types, type_param_names, shape)?
    type_args := [Type].with_capacity(type_param_names.len())
    loop param in type_param_names -> &type_args.push(~subst.get(param)?)
    &cx.jit_generic_calls.borrow_mut().entry(name).or_default().push(shape)
    Val(generic_free_function_instance_key(name, type_args))
}
// Rust: crates/jet-codegen/src/Codegen/TIR/mod.rs:1967
fn checked_core_source_generic_type_args(signature: CoreSourceFunctionSignature, actuals: [Type]) -> [Type]? Never! {
    param_names :: signature.type_params
    if param_names.is_empty() -> return None
    param_types :: loop (_, ty) in signature.params -> ~ty
    if actuals.len() == param_types.len() + param_names.len() -> return Val(actuals[param_types.len()..].to_vec())
    substitutions :: generic_call_substitution(param_types, param_names, actuals)?
    result := [Type].with_capacity(param_names.len())
    loop param in param_names -> &result.push(~substitutions.get(param)?)
    Val(^result)
}
// Rust: crates/jet-codegen/src/Codegen/TIR/mod.rs:1992
pub fn demand_core_source_generic_function(cx: Cx, method: String, signature: CoreSourceFunctionSignature, args: [TCallArg], explicit_type_args: [Type]) -> String? Never! {
    shape :: generic_call_shape(args, explicit_type_args)
    type_args :: loop ty in checked_core_source_generic_type_args(signature, shape)? -> cx.expand_type_aliases(ty)
    // GATE #4499: exact tuple-key equality/hash.
    &cx.jit_core_source_generic_calls.borrow_mut().entry((~signature.module_identity, method)).or_default().push(~type_args)
    Val(generic_free_function_instance_key(method, type_args))
}
// Rust: crates/jet-codegen/src/Codegen/TIR/mod.rs:2013
fn generic_free_function_template(items: [Item], called_name: String) -> Func? Never! {
    loop item in items {
        if item == {
            .Func(function) if function.name == called_name -> return Val(~function)
            .CodeModule(module) -> {
                body :: module.body ?? continue
                loop inner in body {
                    if inner != .Func(function) -> continue
                    member :: member_name(module.name, function.name)
                    if member == called_name {
                        function := ~function
                        function.name = member
                        return Val(^function)
                    }
                }
            }
            else -> {}
        }
    }
    None
}
// Rust: crates/jet-codegen/src/Codegen/TIR/mod.rs:2039
fn specialize_generic_free_functions(items: [Item], cx: Cx, funcs: &[TFunc]) -> Unit Never! {
    loop {
        calls :: &cx.jit_generic_calls.borrow_mut().take()
        if calls.is_empty() -> break
        loop (called_name, shapes) in calls {
            unique := ^shapes
            &unique.sort_by_key(fn(shape) { "{shape:?}" })
            &unique.dedup()
            variadic_shape :: called_name.rsplit_once("__va").and_then(fn(pair) { USize.parse(pair.1).ok().map(fn(arity) { (pair.0, arity) }) })
            (template, variadic) :: if variadic_shape == Val((base, arity)) -> {
                (_, bounds) :: cx.variadic_bound_fns.get(base) ?? continue
                source :: generic_free_function_template(items, base) ?? continue
                (build_variadic_bound_func(source, bounds, arity), true)
            } else -> (generic_free_function_template(items, called_name) ?? continue, false)
            if template.type_params.is_empty() || (variadic && unique.len() != 1) -> continue
            param_types :: loop param in template.params -> ~param.ty
            type_param_names :: loop param in template.type_params -> ~param.name
            loop actuals in unique {
                subst :: generic_call_substitution(param_types, type_param_names, actuals) ?? continue
                type_args := [Type].with_capacity(type_param_names.len())
                all_bound := true
                loop param in type_param_names {
                    if subst.get(param) == Val(ty) -> &type_args.push(~ty) else -> { all_bound = false; break }
                }
                if !all_bound -> continue
                emitted_name :: if variadic -> ~called_name else -> generic_free_function_instance_key(called_name, type_args)
                emitted_key :: function_semantic_key(cx.module_identity, emitted_name)
                if funcs.any(fn(func) { func.name == emitted_name || func.key == emitted_key }) -> continue
                specialized := specialize_function_types(~template, subst)
                residual_type_params :: Set<String>.from(loop param in specialized.type_params -> ~param.name)
                &specialized.type_params.clear()
                previous_type_params :: ~cx.current_type_params.borrow()
                function_type_params := ~previous_type_params
                &function_type_params.extend(residual_type_params)
                _ :: cx.current_type_params.replace(^function_type_params)
                lowered := lower_func(specialized, cx)
                _ :: cx.current_type_params.replace(^previous_type_params)
                lowered.key = function_semantic_key(lowered.module, emitted_name)
                lowered.name = if cx.jit_local_call_prefix == Val(prefix) -> "{prefix}{mangle(emitted_name)}" else -> ~emitted_name
                &funcs.push(^lowered)
            }
        }
    }
}
// Rust: crates/jet-codegen/src/Codegen/TIR/mod.rs:2142
fn merge_core_source_generic_calls(target: Cx, source: Cx) -> Unit Never! {
    calls :: &source.jit_core_source_generic_calls.borrow_mut().take()
    target_calls := target.jit_core_source_generic_calls.borrow_mut()
    loop (key, type_args) in calls -> &target_calls.entry(key).or_default().extend(type_args)
}
// Rust: crates/jet-codegen/src/Codegen/TIR/mod.rs:2150
fn build_imported_generic_core_cx(bundle: ProgramBundle, module_idx: USize, extern_funcs: [String: ExternFn], debug_linemap: Bool, spawn_site_base: USize) -> Cx Never! {
    imported :: bundle.modules[module_idx]
    imported_cx := build_cx_items(imported.items, imported.source, imported.display, None, extern_funcs, bundle.edition)
    imported_cx.debug_linemap = debug_linemap
    populate_cx_from_bundle(&imported_cx, bundle, module_idx)
    register_own_struct_shapes(&imported_cx, bundle, module_idx)
    collect_iterable_hooks(&imported_cx, imported.items)
    imported_cx.jit_local_call_prefix = Val("{mangle(imported.alias)}::")
    imported_cx.jit_spawn_site_base = spawn_site_base
    ^imported_cx
}
// Rust: crates/jet-codegen/src/Codegen/TIR/mod.rs:2175
fn checked_imported_core_source_signature(imported_alias: String, method: String, owner: String, signatures: [(String, String): CoreSourceFunctionSignature]) -> CoreSourceFunctionSignature? Never! {
    source :: core_source_module_by_alias(imported_alias)?
    signatures.get((source.module.to_string(), method)).filter(fn(signature) { signature.module_identity == owner })
}
// Rust: crates/jet-codegen/src/Codegen/TIR/mod.rs:2190
fn lower_checked_core_source_generic_instance(bundle: ProgramBundle, module_idx: USize, imported_cx: Cx, method: String, type_args: [Type], funcs: &[TFunc]) -> Unit LowerError! {
    imported :: bundle.modules[module_idx]
    owner :: bundle.name_ledger.module_identity(module_idx).expect("name ledger must contain every loaded module")
    missing_target :: fn() { LowerError.new(Span.new(0, 0), "checked Core source generic target `{owner}::{method}` has no loaded template") }
    signature :: checked_imported_core_source_signature(imported.alias, method, owner, imported_cx.core_source_sigs) ?? return Err(missing_target())
    template :: generic_free_function_template(imported.items, method) ?? return Err(missing_target())
    span :: template.span
    type_param_names :: loop param in template.type_params -> ~param.name
    if signature.type_params != type_param_names || type_args.len() != type_param_names.len() -> return Err(LowerError.new(span, "checked Core source generic target `{owner}::{method}` has inconsistent type parameters"))
    emitted_name :: generic_free_function_instance_key(method, type_args)
    emitted_key :: function_semantic_key(owner, emitted_name)
    if funcs.any(fn(function) { function.key == emitted_key }) -> return Ok(())
    (specialized, lowered) := lower_core_source_generic_template(template, type_args, emitted_name, imported_cx)
    binders :: qualification_binders([], Val(specialized))
    loop (_, ty, _) in &lowered.params -> ty = qualify_imported_type(bundle, module_idx, owner, binders, ty)
    lowered.ret = lowered.ret.map(fn(ty) { qualify_imported_type(bundle, module_idx, owner, binders, ty) })
    lowered.key = emitted_key
    lowered.name = "{mangle(imported.alias)}::{mangle(emitted_name)}"
    &funcs.push(^lowered)
    Ok(())
}
// Rust: crates/jet-codegen/src/Codegen/TIR/mod.rs:2259
fn lower_core_source_generic_template(template: Func, type_args: [Type], emitted_name: String, cx: Cx) -> (Func, TFunc) Never! {
    substitutions := [String: Type]{}
    loop (param, actual) in template.type_params.zip(type_args) -> &substitutions.insert(~param.name, ~actual)
    specialized := specialize_function_types(^template, substitutions)
    specialized.name = emitted_name
    residual_type_params :: Set<String>.from(loop param in specialized.type_params -> ~param.name)
    &specialized.type_params.clear()
    previous_type_params :: ~cx.current_type_params.borrow()
    function_type_params := ~previous_type_params
    &function_type_params.extend(residual_type_params)
    _ :: cx.current_type_params.replace(^function_type_params)
    lowered :: lower_func(specialized, cx)
    _ :: cx.current_type_params.replace(^previous_type_params)
    (^specialized, ^lowered)
}
// Rust: crates/jet-codegen/src/Codegen/TIR/mod.rs:2288
fn specialize_checked_core_source_generics(bundle: ProgramBundle, extern_funcs: [String: ExternFn], debug_linemap: Bool, cx: Cx, funcs: &[TFunc], spawn_lambdas: &[TJitSpawnLambda]) -> Unit LowerError! {
    processed := Set<String>.new()
    loop {
        calls :: &cx.jit_core_source_generic_calls.borrow_mut().take()
        if calls.is_empty() -> return Ok(())
        loop ((owner, method), instantiations) in calls {
            instantiations := ^instantiations
            &instantiations.sort_by_key(fn(types) { "{types:?}" })
            &instantiations.dedup()
            module_idx :: (0..bundle.modules.len()).find(fn(index) { bundle.name_ledger.module_identity(index) == Val(owner) })
                ?? return Err(LowerError.new(Span.new(0, 0), "checked Core source generic target `{owner}::{method}` has no loaded module"))
            imported :: bundle.modules[module_idx]
            imported_cx := build_imported_generic_core_cx(bundle, module_idx, extern_funcs, debug_linemap, spawn_lambdas.len())
            loop type_args in instantiations {
                instance :: generic_free_function_instance_key(method, type_args)
                key :: function_semantic_key(owner, instance)
                if !&processed.insert(~key) -> continue
                imported_cx.jit_spawn_site_base = spawn_lambdas.len()
                lower_checked_core_source_generic_instance(bundle, module_idx, imported_cx, method, type_args, &funcs)?
                if !funcs.any(fn(function) { function.key == key }) -> continue
                lower_demanded_generic_methods(imported.items, imported_cx, &funcs)?
                specialize_generic_free_functions(imported.items, imported_cx, &funcs)
                &spawn_lambdas.extend(&imported_cx.jit_spawn_lambdas.borrow_mut().take())
            }
            merge_core_source_generic_calls(cx, imported_cx)
        }
    }
}
// Rust: crates/jet-codegen/src/Codegen/TIR/mod.rs:2354
fn memo_dependency_facts(cx: Cx) -> [String: [String: [String]]] Never! {
    result := [String: [String: [String]]]{}
    loop (owner, sources) in cx.memo_dependencies {
        source_facts := [String: [String]]{}
        loop (source, memo_fields) in sources {
            fields := memo_fields.to_list()
            &fields.sort()
            &source_facts.insert(~source, ^fields)
        }
        &result.insert(~owner, ^source_facts)
    }
    ^result
}
// Rust: crates/jet-codegen/src/Codegen/TIR/mod.rs:2392
fn lower_imported_generated_codecs(bundle: ProgramBundle, module_idx: USize, core_modules: Set<USize>, reachable_bodies: Set<(USize, USize, USize)>, cx: Cx, funcs: &[TFunc]) -> Unit Never! {
    if module_idx == bundle.entry -> return
    imported :: bundle.modules[module_idx]
    loop item in imported.items {
        if item != .Impl(implementation) -> continue
        if !implementation.is_generated_serde -> continue
        trait_name :: implementation.trait_name ?? continue
        if imported.items.any(fn(candidate) { if candidate == { .Struct(definition) -> definition.name == implementation.type_name && published_schema(definition); else -> false } }) -> continue
        owner_params :: imported.items.find_map(fn(item) { if item == {
            .Struct(definition) if definition.name == implementation.type_name -> Val(definition.type_params)
            .Enum(definition) if definition.name == implementation.type_name -> Val(definition.type_params)
            else -> None
        } }) ?? []
        loop owner in imported_type_owners(bundle, module_idx) {
            qualified :: imported_type_name(owner, implementation.type_name)
            if !cx.struct_fields.contains_key(qualified) && !cx.enum_variants.contains_key(qualified) -> continue
            loop method in implementation.methods {
                if !should_lower_imported_core_body(core_modules, reachable_bodies, module_idx, method) || !method.type_params.is_empty() -> continue
                name :: "{qualified}::{method.name}"
                lowered := lower_trait_method(method, qualified, cx, trait_name, implementation.is_generated_serde && method.compiler_generated, implementation.operator_rhs)
                binders :: qualification_binders(owner_params, Val(method))
                lowered.ret = lowered.ret.map(fn(ty) { qualify_imported_type(bundle, module_idx, owner, binders, ty) })
                if funcs.any(fn(function) { function.key == lowered.key && function.source_span == lowered.source_span }) -> continue
                set_lowered_method_name(&lowered, fn() { ^name })
                &funcs.push(^lowered)
            }
        }
    }
}

// Rust: crates/jet-codegen/src/Codegen/TIR/mod.rs:2487
// All maps and declarations are borrowed from the fragment caller, not copied.
pub struct MirFragmentContext {
    pub funcs: [String: Func]
    pub binding_types: [String: Type]
    pub method_traits: [(String, String): String]
    pub error_conversions: [ErrorConvDef]
    pub methods: [(String, String): Func]
    pub extern_names: Set<String>
    pub globals: [String: CtValue]
    pub core_imports: [String: String]
    pub structs: [String: StructDef]
    pub computed_fields: [(String, String): Expr]
    pub checked_nominals: MirFragmentNominalFacts?
    pub distinct_ranges: [String: (I64, I64)?]
    pub distinct_bases: [String: Type]
    pub unit_families: [UnitFamilyDef]
    // GATE #4483: selected target profile, never compiler-host layout facts.
    pub target_layout: TargetLayout
}
