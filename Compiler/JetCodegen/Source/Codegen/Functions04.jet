// Rust: crates/jet-codegen/src/Codegen/TIR/mod.rs:2514
fn fragment_function_key(name: String, context: MirFragmentContext) -> String? Never! {
    if context.funcs.contains_key(name) -> return Val(~name)
    name.split_once('.').map(fn(pair) { "{pair.0}::{pair.1}" }).filter(fn(qualified) { context.funcs.contains_key(qualified) })
}
// Rust: crates/jet-codegen/src/Codegen/TIR/mod.rs:2526
fn fragment_method_key(owner: String, method: String, context: MirFragmentContext) -> (String, String)? Never! {
    owners := [String]{~owner}
    if owner.split_once('.') == Val((module, leaf)) -> &owners.push("{module}::{leaf}")
    if owner.rsplit_once("::") == Val((_, leaf)) -> &owners.push(leaf.to_string())
    if owner.rsplit_once('.') == Val((_, leaf)) -> &owners.push(leaf.to_string())
    &owners.dedup()
    owners.find_map(fn(candidate) {
        key :: (candidate, method)
        if context.methods.contains_key(key) -> Val(key) else -> None
    })
}
// Rust: crates/jet-codegen/src/Codegen/TIR/mod.rs:2548
fn fragment_type_owner(ty: Type) -> String? Never! {
    if ty == { .Named(name) | .Apply{name, ..} -> Val(~name); .Tagged{inner, ..} -> fragment_type_owner(inner); else -> None }
}
// Rust: crates/jet-codegen/src/Codegen/TIR/mod.rs:2556
fn fragment_static_method_key(receiver: Expr, method: String, locals: [String: Type]?, context: MirFragmentContext) -> (String, String)? Never! {
    if receiver == {
        .Ident(name, _) if locals.is_some_and(fn(locals) { locals.contains_key(name) }) -> return None
        .Field(base, _, _) if (if base == { .Ident(name, _) -> locals.is_some_and(fn(locals) { locals.contains_key(name) }); else -> false }) -> return None
        else -> {}
    }
    owner :: static_call_type_name_unchecked(receiver)?
    fragment_method_key(owner, method, context)
}
// Rust: crates/jet-codegen/src/Codegen/TIR/mod.rs:2583
fn collect_fragment_callable(expr: Expr, context: MirFragmentContext, current_owner: String?, locals: [String: Type]?, out: &Set<FragmentCallable>) -> Unit Never! {
    if expr == {
        .Call(call) -> { if fragment_function_key(call.name, context) == Val(name) -> &out.insert(FragmentCallable.Function(name)) }
        .Ident(name, _) if !locals.is_some_and(fn(locals) { locals.contains_key(name) }) -> { if fragment_function_key(name, context) == Val(name) -> &out.insert(FragmentCallable.Function(name)) }
        .Field(receiver, member, _) -> {
            owner :: if receiver == {
                .Ident(name, _) if name == Syntax.KW_SELF -> current_owner
                .Ident(name, _) -> locals.and_then(fn(locals) { locals.get(name) }).and_then(fragment_type_owner)
