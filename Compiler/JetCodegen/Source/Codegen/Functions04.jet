//RS /// Pre-sema context retained by comptime fragment callers. The fragment is
//RS /// lowered here once and then consumed only as canonical MIR by MIREval.
//RS pub struct MirFragmentContext<'a> {
//RS     pub funcs: &'a std::collections::HashMap<String, &'a crate::AST::Func>,
//RS     pub binding_types: &'a std::collections::HashMap<String, crate::AST::Type>,
//RS     pub method_traits: &'a std::collections::HashMap<(String, String), String>,
//RS     pub error_conversions: &'a [crate::AST::ErrorConvDef],
//RS     pub methods: &'a std::collections::HashMap<(String, String), &'a crate::AST::Func>,
//RS     pub extern_names: &'a std::collections::HashSet<String>,
//RS     pub globals: &'a std::collections::HashMap<String, crate::AST::CtValue>,
//RS     pub core_imports: &'a std::collections::HashMap<String, String>,
//RS     pub structs: &'a std::collections::HashMap<String, &'a crate::AST::StructDef>,
//RS     pub computed_fields: &'a std::collections::HashMap<(String, String), &'a crate::AST::Expr>,
//RS     pub checked_nominals: Option<&'a crate::Comptime::MirBridge::MirFragmentNominalFacts>,
//RS     pub distinct_ranges: &'a std::collections::HashMap<String, Option<(i64, i64)>>,
//RS     pub distinct_bases: &'a std::collections::HashMap<String, crate::AST::Type>,
//RS     pub unit_families: &'a [crate::AST::UnitFamilyDef],
//RS     /// Target facts selected by the fragment caller; layout lowering must not
//RS     /// silently substitute the compiler host profile.
//RS     pub target_layout: jet_foundation::Layout::TargetLayout,
//RS }
