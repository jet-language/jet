//RS         // D-PUBSCHEMA: a published schema's unknown-field holder is registered
//RS         // only in the declaring module's context, so its codec cannot be
//RS         // reproduced faithfully from here. Leave it refused rather than lower a
//RS         // codec that silently drops the merge AOT performs.
//RS         if imported.items.iter().any(|candidate| {
//RS             matches!(candidate, Item::Struct(definition)
//RS                 if definition.name == implementation.type_name && published_schema(definition))
//RS         }) {
//RS             continue;
//RS         }
//RS         let owner_params: &[crate::AST::TypeParam] = imported
//RS             .items
//RS             .iter()
//RS             .find_map(|item| match item {
//RS                 Item::Struct(definition) if definition.name == implementation.type_name => {
