// MIR-only WebAssembly/JavaScript emission. No bundle, AST, TIR or checker policy.
use jet_foundation.[HistoryProvenance, HISTORY_ENGINE, TargetLayout, TEXT_NUL, sha256_hex, require_canonical_mir_optimization, GENERATED_NAME_PREFIX]
use jet_foundation.MIR.[MirArtifactId, MirArtifactKind, MirArtifactPlan, MirArtifactTarget, MirBasicBlock, MirBlockId, MirCallArg, MirCallee, MirCliDefault, MirCliEntry, MirCliInputShape, MirConstant, MirCoreCallId, MirFailureCarrier, MirForeignAbi, MirFunction, MirFunctionForm, MirFunctionId, MirOperation, MirPreludeAbi, MirPreludeCallId, MirPreludeFamily, MirProgram, MirRuntimePartId, MirSemanticOp, MirType, MirTypeDef, MirTypeDefKind, MirTypeKind, MirVariantPayload]
use jet_foundation.WebPartition.[WebBucket, WebPartitionMarker]
