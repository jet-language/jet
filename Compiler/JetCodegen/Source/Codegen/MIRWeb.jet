use jet_codegen.[emit_mir_program, MirRustConfig, MirRustExecutionConfig, MirRustTarget, dom_runtime_source, shared_js_prelude, default_index_html, function_in_bucket, is_wasm_export, emit_source_map, emit_manifest, emit_command_record, web_trait_method_targets, js_string, json_string, js_constant_expression, emit_js_copy_type_facts, emit_js_function, emit_js_routes, item_ref_descriptor, ensure_type_instance]

// Rust: crates/jet-codegen/src/Codegen/MIRWeb.rs:30
fn foreign_abi_name(abi: &MirForeignAbi) -> String {
    if abi == { .C -> "C"; .CUnwind -> "C-unwind"; .System -> "system"; .Stdcall -> "stdcall"; .Fastcall -> "fastcall"; .Vectorcall -> "vectorcall"; .Rust -> "Rust"; .Platform(name) -> ~name }
}

// Rust: crates/jet-codegen/src/Codegen/MIRWeb.rs:45
pub struct WebArtifacts {
    pub manifest_json: String
    pub wasm_rust: String
    // Compilation context excludes edited MIR bodies: item hashes select rebuilds.
    pub rustc_incremental_identity: String
    pub js_app: String
    pub js_source_map: String
    pub source_names: [String]
    pub source_contents: [String]
    pub dom_runtime: String
    pub index_html: String
    pub explicit_html_path: String?
    pub command_record: [U8]
}

// Rust: crates/jet-codegen/src/Codegen/MIRWeb.rs:66
pub struct MirWebAssets {
    pub dom_runtime: String
    pub index_html: String
    pub explicit_html_path: String?
    pub source_names: [String]
    pub source_contents: [String]
}
impl MirWebAssets {
    // Rust: crates/jet-codegen/src/Codegen/MIRWeb.rs:77
    pub fn with_default_shell() -> Self {
        Self{dom_runtime: dom_runtime_source().to_string(), index_html: default_index_html(), explicit_html_path: None, source_names: [], source_contents: []}
    }
}

// Rust: crates/jet-codegen/src/Codegen/MIRWeb.rs:94
pub struct MirWebTarget {
    pub layout: TargetLayout
    pub assets: MirWebAssets
    pub semantic_digest: [U8; 32]
    pub artifact: MirArtifactId
    pub release_devtools_policy: ReleaseDevtoolsPolicy
}

// Rust: crates/jet-codegen/src/Codegen/MIRWeb.rs:112
pub fn web_rustc_incremental_identity(program: &MirProgram, target: &MirWebTarget) -> String {
    artifact_kind :: program.artifacts.find(artifact -> artifact.id == target.artifact).map(artifact -> artifact.kind.debug()).unwrap_or_else(fn() { "missing" })
    // GATE #4483: caller's selected target facts; #4500 canonical debug encoding.
    context :: "jet-web-rustc-incremental-v1|target={target.layout.triple}|pointer-size={target.layout.pointer_size}|pointer-align={target.layout.pointer_alignment}|layout={target.layout.layout_facts.debug()}|artifact={target.artifact.0}|artifact-kind={artifact_kind}|compiler={program.facts.target_dossier.compiler_identity}|environment={program.facts.target_dossier.environment_identity}|tier={program.facts.target_dossier.tier_identity}|edition={program.facts.edition}|policy={target.release_devtools_policy.debug()}"
    sha256_hex(context.as_bytes())
}

// Rust: crates/jet-codegen/src/Codegen/MIRWeb.rs:155
#Error
pub enum MirWebError {
    InvalidMir(message: String)
    InvalidLayout(ty: String)
    InvalidAssets(message: String)
    MissingCoreCall(call: U64)
    MissingPreludeCall(call: U64)
    MissingUserFunction(function: U64)
    MissingEntryFunction(function: U64)
}
impl MirWebError {
    // Rust: crates/jet-codegen/src/Codegen/MIRWeb.rs:166
    pub fn fmt(self: &Self) -> String {
        if self == {
            .InvalidMir(message) -> "invalid MIR for Web emission: {message}"
            .InvalidLayout(ty) -> "MIR type has an invalid layout: {ty}"
            .InvalidAssets(message) -> "invalid Web publication assets: {message}"
            .MissingCoreCall(call) -> "MIR CoreCallId {call} is not in the Core table"
            .MissingPreludeCall(call) -> "MIR PreludeCallId {call} is not in the Prelude table"
            .MissingUserFunction(function) -> "MIR function id {function} is not in the function table"
            .MissingEntryFunction(function) -> "MIR entry function {function} is not Web-applicable"
        }
    }
}

// Rust: crates/jet-codegen/src/Codegen/MIRWeb.rs:182
pub fn emit_web(program: &MirProgram, target: &MirWebTarget) -> WebArtifacts MirWebError! {
    try { program.cffi.validate_boundaries() } catch error { throw MirWebError.InvalidMir(message: "invalid foreign boundary facts: {error}") }
    try { require_canonical_mir_optimization(program) } catch error { throw MirWebError.InvalidMir(message: error.to_string()) }
    validate_assets(target.assets)
    validate_layouts(program)
    validate_web_facts(program)
    artifact :: select_web_artifact(program, target.artifact)
    artifact_identity :: try { program.artifact_identity(artifact.id) } catch error { throw MirWebError.InvalidMir(message: "MIR Web artifact identity unavailable: {error}") }
    history_provenance :: HistoryProvenance{source: artifact_identity.identity_digest(), tool: "{HISTORY_ENGINE}:{program.facts.target_dossier.compiler_identity}", target: sha256_hex(program.facts.target_dossier.cache_bytes(target.layout.triple))}
    artifact_identity_text :: artifact_identity.canonical_text()
    rustc_incremental_identity :: web_rustc_incremental_identity(program, target)
    entry :: selected_web_entry(artifact)
    functions :: program.functions.iter().filter(function -> function.target_applicability.web && artifact.modules.any(module -> module == function.module_id)).collect()
    function :: functions.find(function -> function.id == entry) ?? throw MirWebError.MissingEntryFunction(function: entry.0)
    if !function_in_bucket(function, WebBucket.JS) && !function_in_bucket(function, WebBucket.Wasm) -> throw MirWebError.InvalidMir(message: "MIR WebApplication entry {entry.0} has no checked Web partition")
    wasm_rust :: emit_wasm_rust(program, target, functions)
    js_app :: emit_js_app(program, target, artifact, functions, Val(entry), artifact_identity_text, history_provenance)
    js_source_map :: emit_source_map(target.assets)
    manifest_json :: emit_manifest(program, target, functions, artifact, entry, artifact_identity_text)
    command_record :: emit_command_record(program, functions, artifact, entry)
    WebArtifacts{manifest_json: ^manifest_json, wasm_rust: ^wasm_rust, rustc_incremental_identity: ^rustc_incremental_identity, js_app: ^js_app, js_source_map: ^js_source_map, source_names: ~target.assets.source_names, source_contents: ~target.assets.source_contents, dom_runtime: ~target.assets.dom_runtime, index_html: ~target.assets.index_html, explicit_html_path: ~target.assets.explicit_html_path, command_record: ^command_record}
}

// Rust: crates/jet-codegen/src/Codegen/MIRWeb.rs:263
fn select_web_artifact(program: &MirProgram, artifact_id: MirArtifactId) -> &MirArtifactPlan MirWebError! {
    artifact :: program.artifacts.find(artifact -> artifact.id == artifact_id) ?? throw MirWebError.InvalidMir(message: "MIR artifact {artifact_id.0} is missing")
    if artifact.kind != MirArtifactKind.WebApplication -> throw MirWebError.InvalidMir(message: "MIR artifact {artifact_id.0} has kind {artifact.kind.debug()}, expected WebApplication")
    if artifact.target != MirArtifactTarget.Web -> throw MirWebError.InvalidMir(message: "MIR WebApplication artifact {artifact.id.0} targets {artifact.target.debug()}, not Web")
    if artifact.modules.is_empty() -> throw MirWebError.InvalidMir(message: "MIR WebApplication artifact {artifact.id.0} has no selected modules")
    loop module in artifact.modules {
        if !program.modules.any(row -> row.id == module) -> throw MirWebError.InvalidMir(message: "MIR WebApplication artifact {artifact.id.0} references missing module {module.0}")
    }
    loop link in artifact.links {
        if !program.links.any(row -> row.id == link) -> throw MirWebError.InvalidMir(message: "MIR WebApplication artifact {artifact.id.0} references missing link unit {link.0}")
    }
    loop job in artifact.jobs {
        if !program.jobs.any(row -> row.id == job) -> throw MirWebError.InvalidMir(message: "MIR WebApplication artifact {artifact.id.0} references missing job {job.0}")
    }
    entry :: artifact.entry ?? throw MirWebError.InvalidMir(message: "MIR WebApplication artifact {artifact.id.0} has no entry")
    function :: entry.function ?? throw MirWebError.InvalidMir(message: "MIR WebApplication artifact {artifact.id.0} has no entry function")
    if !program.functions.any(row -> row.id == function) -> throw MirWebError.MissingEntryFunction(function: function.0)
    if artifact.harness == .Val(harness) {
        if !program.harnesses.any(row -> row.id == harness) -> throw MirWebError.InvalidMir(message: "MIR WebApplication artifact {artifact.id.0} references missing harness {harness.0}")
    }
    loop export in artifact.exports {
        if export.symbol.is_empty() -> throw MirWebError.InvalidMir(message: "MIR WebApplication artifact {artifact.id.0} has an unnamed export")
        function :: program.functions.find(row -> row.id == export.function) ?? throw MirWebError.MissingUserFunction(function: export.function.0)
        if !artifact.modules.any(module -> module == function.module_id) -> throw MirWebError.InvalidMir(message: "MIR WebApplication artifact {artifact.id.0} export {export.function.0} belongs to unselected module {function.module_id.0}")
        if !function.target_applicability.web -> throw MirWebError.MissingUserFunction(function: export.function.0)
    }
    artifact
}

// Rust: crates/jet-codegen/src/Codegen/MIRWeb.rs:371
fn selected_web_entry(artifact: &MirArtifactPlan) -> MirFunctionId MirWebError! {
    artifact.entry.and_then(entry -> entry.function) ?? throw MirWebError.InvalidMir(message: "MIR WebApplication artifact {artifact.id.0} has no entry function")
}

// Rust: crates/jet-codegen/src/Codegen/MIRWeb.rs:381
fn validate_assets(assets: &MirWebAssets) MirWebError! {
    if assets.source_names.len() != assets.source_contents.len() -> throw MirWebError.InvalidAssets(message: "source_names has {assets.source_names.len()} rows but source_contents has {assets.source_contents.len()} rows")
    if assets.dom_runtime.is_empty() -> throw MirWebError.InvalidAssets(message: "dom_runtime is empty")
    if assets.index_html.is_empty() -> throw MirWebError.InvalidAssets(message: "index_html is empty")
}

// Rust: crates/jet-codegen/src/Codegen/MIRWeb.rs:400
fn validate_layouts(program: &MirProgram) MirWebError! {
    check :: fn(ty: &MirType) MirWebError! { if !ty.has_valid_layout() -> throw MirWebError.InvalidLayout(ty: ty.name()) }
    loop type_def in program.types -> check_type_def(type_def, check)
    loop function in program.functions {
        if function.generator == .Val(generator) -> check(generator.item)
        loop parameter in function.params -> check(parameter.ty)
        if function.declared_return == .Val(return_type) -> check(return_type)
        check(function.return_type)
        loop local in function.locals -> check(local.ty)
        loop (_, ty, _, _) in function.values -> check(ty)
        loop place in function.places -> check(place.ty)
        loop reconstruction in function.web_param_reconstructions {
            check(reconstruction.ty)
            loop field in reconstruction.fields -> check(field.ty)
        }
        loop block in function.blocks {
            loop instruction in block.instructions {
                if instruction.ty == .Val(ty) -> check(ty)
                check_operation_types(instruction.operation, check)
            }
        }
    }
    loop foreign in program.foreign {
        loop parameter in foreign.params -> check(parameter.ty)
        if foreign.return_type == .Val(return_type) -> check(return_type)
    }
}

// Rust: crates/jet-codegen/src/Codegen/MIRWeb.rs:457
fn check_type_def(type_def: &MirTypeDef, check: fn(&MirType) MirWebError!) MirWebError! {
    if type_def.kind == {
        .Struct(fields: fields, ..) -> { loop field in fields -> check(field.ty) }
        .Enum(variants: variants, ..) -> {
            loop variant in variants {
                if variant.payload == { .Unit -> {}; .Single(ty) -> check(ty); .Named(fields) -> { loop field in fields -> check(field.ty) } }
            }
        }
        .Distinct(base: base, ..) -> check(base)
        .Alias(target: target) -> check(target)
        .UnitFamily(..) -> {}
    }
}

// Rust: crates/jet-codegen/src/Codegen/MIRWeb.rs:487
fn check_operation_types(operation: &MirOperation, check: fn(&MirType) MirWebError!) MirWebError! {
    if operation == {
        .Convert(target: target, ..) | .PtrFromAddr(element: target, ..) -> check(target)
        .Present(..) | .ResultOk(..) -> {}
        .Semantic(semantic) -> if semantic == {
            .MathBuiltin(..) | .PreciseBuiltin(..) | .Print(..) | .AmbientInput(..) | .RequireStop(..) | .LayoutCompare(..) | .LayoutLiteral(..) | .StructLiteral(..) | .ReflectOf(..) | .CellGuardProject(..) | .SharedGuardMap(..) | .SharedGuardSplit(..) | .SharedGuardWait(..) | .ConditionNotify(..) | .AllocNew(..) | .ColumnarRead(..) | .StaticPreludeCall(..) | .DecodeUnder(..) | .HardwareCall(..) | .BuiltinMethod(..) | .OptionLift2(..) | .ClosureMethod(..) | .HostBorrowCallback(..) | .NumericMethod(..) | .NumericBinaryMethod(..) | .OverflowOption(..) | .HandleMethod(..) | .PluginInvoke(..) | .CoreClosureCall(..) | .TaskGroup(..) | .Select(..) | .PolicyFunction(..) | .InterruptFunction(..) | .CarrierFact(..) | .GcEdit(..) | .TypedTextInterp(..) | .HostCall(..) | .DataEntriesToMap(..) | .TextPatternMatch(..) | .BinaryPatternMatch(..) | .CursorTakePattern(..) | .ReaderTakePattern(..) | .HttpRouterRegister(..) | .CCallback(..) -> {}
        }
        .Parameter(..) | .Capture(..) | .Global(..) | .Phi(..) | .ReadPlace(_) | .MovePlace(..) | .WritePlace(..) | .ReplacePlace(..) | .InitializeUninit(..) | .Copy(..) | .Move(..) | .TraitBox(..) | .Constant(_) | .Unary(..) | .Binary(..) | .BuildString(..) | .BuildList(..) | .BuildMap(..) | .EnumIs(..) | .EnumPayload(..) | .OptionIsSome(..) | .OptionValue(..) | .ResultIsOk(..) | .ResultValue(..) | .PatternCapture(..) | .PatternMatched(..) | .ProjectMembers(..) | .Index(..) | .Slice(..) | .Range(..) | .Field(..) | .Struct(..) | .Enum(..) | .Tuple(..) | .Absent | .ResultErr(..) | .Call(..) | .CoreCall(..) | .IndirectCall(..) | .Closure(..) | .Deref(..) | .RawAddressOf(..) | .AddressOf(..) | .AttachTag(..) | .Todo(..) | .Never(..) | .LoopRangeInit(..) | .LoopRangeHasNext(..) | .LoopRangeValue(..) | .LoopRangeAdvance(..) | .LoopIterInit(..) | .LoopIterHasNext(..) | .LoopIterValue(..) | .LoopIterAdvance(..) | .ScopeEnter(..) | .ScopeExit(..) | .Drop(..) -> {}
    }
}

// Rust: crates/jet-codegen/src/Codegen/MIRWeb.rs:604
const WEB_TARGET_HARDWARE_CAPABILITY :: "Target.Hardware"
// Rust: crates/jet-codegen/src/Codegen/MIRWeb.rs:606
fn web_hardware_leak(detail: String) -> MirWebError {
    MirWebError.InvalidMir(message: "E3311: Target `Web` lacks the required `{WEB_TARGET_HARDWARE_CAPABILITY}` capability; target validation must reject this hardware use before Web emission ({detail})")
}

// Rust: crates/jet-codegen/src/Codegen/MIRWeb.rs:615
fn reject_leaked_web_hardware(program: &MirProgram) MirWebError! {
    if !program.facts.hardware_setups.is_empty() -> throw web_hardware_leak("a package hardware setup reached the Web adapter")
    loop function in program.functions {
        loop block in function.blocks {
            loop instruction in block.instructions {
                if instruction.operation == .Semantic(.HardwareCall(..)) -> throw web_hardware_leak("function {function.id.0} at {instruction.span.debug()} reached the Web adapter")
            }
        }
    }
}

// Rust: crates/jet-codegen/src/Codegen/MIRWeb.rs:642
fn validate_web_facts(program: &MirProgram) MirWebError! {
    reject_leaked_web_hardware(program)
    loop function in program.functions {
        if function.target_applicability.web && function.web_bucket == None -> throw MirWebError.InvalidMir(message: "function {function.id.0} is Web-applicable but has no checked Web bucket")
        if (function.web_bucket, function.web_marker) == {
            (.Val(WebBucket.JS), .Val(WebPartitionMarker.Wasm)) | (.Val(WebBucket.JS), .Val(WebPartitionMarker.WasmExport)) | (.Val(WebBucket.Wasm), .Val(WebPartitionMarker.JS)) -> throw MirWebError.InvalidMir(message: "function {function.id.0} has contradictory Web bucket and marker")
            (.Val(WebBucket.JS), .Val(WebPartitionMarker.JS)) | (.Val(WebBucket.Wasm), .Val(WebPartitionMarker.Wasm)) | (.Val(WebBucket.Wasm), .Val(WebPartitionMarker.WasmExport)) | (.Val(WebBucket.JS), .None) | (.Val(WebBucket.Wasm), .None) | (.None, .Val(WebPartitionMarker.JS)) | (.None, .Val(WebPartitionMarker.Wasm)) | (.None, .Val(WebPartitionMarker.WasmExport)) | (.None, .None) -> {}
        }
        if function.target_applicability.web && function_in_bucket(function, WebBucket.JS) {
            loop block in function.blocks {
                loop instruction in block.instructions {
                    if instruction.operation != .Call(callee: .Foreign(foreign_id), ..) -> continue
                    foreign :: program.foreign.find(foreign -> foreign.id == foreign_id) ?? throw MirWebError.InvalidMir(message: "function {function.id.0} at {instruction.span.debug()} references missing foreign row {foreign_id.0}")
                    abi :: foreign_abi_name(foreign.foreign_abi)
                    throw MirWebError.InvalidMir(message: "function {function.id.0} at {instruction.span.debug()} contains JS-partition foreign row {foreign.id.0} declared at {foreign.span.debug()} (symbol `{foreign.symbol}` path `{foreign.path}` ABI `{abi}` language {foreign.foreign_language.debug()} applicability rust_aot={foreign.target_applicability.rust_aot} cranelift={foreign.target_applicability.cranelift} interpreter={foreign.target_applicability.interpreter} web={foreign.target_applicability.web}); no checked JavaScript linkage exists")
                }
            }
        }
        loop reconstruction in function.web_param_reconstructions {
            loop field in reconstruction.fields {
                if field.parameter.is_empty() || field.field.is_empty() -> throw MirWebError.InvalidMir(message: "function {function.id.0} has an empty Web reconstruction name")
            }
        }
    }
}

// Rust: crates/jet-codegen/src/Codegen/MIRWeb.rs:724
fn emit_wasm_rust(program: &MirProgram, target: &MirWebTarget, _functions: &[&MirFunction]) -> String MirWebError! {
    // The canonical printer owns CFG, ownership, failure and Core/Prelude lowering.
    config :: MirRustConfig{target: ~target.layout, target_kind: MirRustTarget.WebWasm, root_prefix: "", execution: MirRustExecutionConfig{artifact: target.artifact, ffi: None, emit_types: true, emit_foreign: true, emit_metadata: true, emit_debug_linemap: false, emit_runtime: true, semantic_digest: Val(target.semantic_digest), release_devtools_policy: ~target.release_devtools_policy, prune_unreachable_codecs: false}}
    out := "// Generated by jet from optimized MIR; Web/Wasm target.\n"
    out.push_str(emit_mir_program(program, config))
    ^out
}

// Rust: crates/jet-codegen/src/Codegen/MIRWeb.rs:753
fn web_font_shape_core_call(program: &MirProgram, id: MirCoreCallId) -> Bool {
    program.core_calls.find(call -> call.id == id).is_some_and(call -> call.module == "core.font" && call.member == "shape")
}
// Rust: crates/jet-codegen/src/Codegen/MIRWeb.rs:761
fn web_uses_font_shaping(program: &MirProgram, functions: &[&MirFunction]) -> Bool {
    functions.any(function -> function.blocks.any(block -> block.instructions.any(instruction -> if instruction.operation == {
        .CoreCall(call: call, ..) -> web_font_shape_core_call(program, call)
        .Call(callee: .Core(id), ..) -> web_font_shape_core_call(program, id)
        _ -> false
    })))
}

// Rust: crates/jet-codegen/src/Codegen/MIRWeb.rs:777
fn web_task_join_call(program: &MirProgram, id: MirPreludeCallId) -> Bool {
    program.prelude_calls.find(call -> call.id == id).is_some_and(call -> call.family == MirPreludeFamily.HandleMethod && call.module == "core.tasks" && call.member == "join")
}
// Rust: crates/jet-codegen/src/Codegen/MIRWeb.rs:784
fn web_channel_handle_call(program: &MirProgram, id: MirPreludeCallId) -> Bool {
    program.prelude_calls.find(call -> call.id == id).is_some_and(fn(call) {
        expected_symbol :: if call.member == {
            "receiver.receive" -> "jet_std::JetReceiver::receive"
            "receiver.try_receive" -> "jet_std::JetReceiver::try_receive"
            "receiver.is_timer" -> "jet_std::JetReceiver::is_timer"
            "receiver.is_interval" -> "jet_std::JetReceiver::is_interval"
            "receiver.is_cancelled" -> "jet_std::JetReceiver::is_cancelled"
            "receiver.is_ready" -> "jet_std::JetReceiver::is_ready"
            "receiver.delay_ms" -> "jet_std::JetReceiver::delay_ms"
            "receiver.close" -> "jet_std::JetReceiver::close"
            "sender.send" -> "jet_std::JetSender::send"
            "sender.close" -> "jet_std::JetSender::close"
            _ -> return false
        }
        call.family == MirPreludeFamily.HandleMethod && call.module == "core.channels" && call.abi == MirPreludeAbi.Value && call.symbol.name() == expected_symbol
    })
}
// Rust: crates/jet-codegen/src/Codegen/MIRWeb.rs:806
fn web_channel_select_call(program: &MirProgram, id: MirPreludeCallId) -> Bool {
    program.prelude_calls.find(call -> call.id == id).is_some_and(fn(call) {
        expected_symbol :: if call.member == { "select_wait_tagged" -> "jet_std::jet_select_wait_tagged"; "select_try_wait_tagged" -> "jet_std::jet_select_try_wait_tagged"; _ -> return false }
        call.family == MirPreludeFamily.StaticPrelude && call.module == "core.tasks" && call.abi == MirPreludeAbi.Value && call.symbol.name() == expected_symbol
    })
}
// Rust: crates/jet-codegen/src/Codegen/MIRWeb.rs:820
fn web_channel_async_call(program: &MirProgram, id: MirPreludeCallId) -> Bool {
    if web_channel_select_call(program, id) -> return program.prelude_calls.find(call -> call.id == id).is_some_and(call -> call.member == "select_wait_tagged")
    program.prelude_calls.find(call -> call.id == id).is_some_and(call -> web_channel_handle_call(program, id) && (call.member == "receiver.receive" || call.member == "sender.send"))
}
// Rust: crates/jet-codegen/src/Codegen/MIRWeb.rs:834
fn web_channel_select_wait_call(program: &MirProgram, id: MirPreludeCallId) -> Bool {
    program.prelude_calls.find(call -> call.id == id).is_some_and(call -> web_channel_select_call(program, id) && call.member == "select_wait_tagged")
}
// Rust: crates/jet-codegen/src/Codegen/MIRWeb.rs:845
fn web_transaction_function(function: &MirFunction) -> Bool {
    function.blocks.any(block -> block.instructions.any(instruction -> if instruction.operation == { .Global(name: name) -> name == "transaction"; _ -> false }))
}

// Rust: crates/jet-codegen/src/Codegen/MIRWeb.rs:856
fn web_async_function_ids(program: &MirProgram) -> [MirFunctionId:Bool] {
    // GATE #4499: canonical function-id key equality/hashing.
    async_functions := [MirFunctionId:Bool]{}
    loop {
        changed := false
        loop function in program.functions {
            if function.generator != None || async_functions.contains_key(function.id) -> continue
            needs_async :: function.blocks.any(block -> block.instructions.any(instruction -> if instruction.operation == {
                .Call(callee: callee, ..) -> if callee == {
                    .Core(_) | .Foreign(_) | .Indirect(_) -> false
                    .Prelude(id) -> web_task_join_call(program, id) || web_channel_async_call(program, id)
                    .User(id) | .Associated(function: id, ..) | .Method(function: id, ..) -> program.functions.find(function -> function.id == id).is_some_and(is_wasm_export) || async_functions.contains_key(id)
                    .TraitMethod(method: method, trait_ref: trait_ref, ..) -> try {
                        (targets, default) :: web_trait_method_targets(program, method, trait_ref)
                        targets.any(target -> program.functions.find(function -> function.id == target.1).is_some_and(function -> function.generator == None && (web_function_is_async(program, target.1) || async_functions.contains_key(target.1)))) || default.is_some_and(id -> program.functions.find(function -> function.id == id).is_some_and(function -> function.generator == None && (web_function_is_async(program, id) || async_functions.contains_key(id))))
                    } catch _ { false }
                }
                .Semantic(.HandleMethod(call: call, ..)) -> web_task_join_call(program, call) || web_channel_async_call(program, call)
                .Semantic(.Select(call: call, ..)) -> web_channel_async_call(program, call)
                .Global(name: name) -> name == "transaction"
                _ -> false
            }))
            if needs_async {
                async_functions.insert(function.id, true)
                changed = true
            }
        }
        if !changed -> break
    }
    ^async_functions
}
// Rust: crates/jet-codegen/src/Codegen/MIRWeb.rs:934
fn web_function_is_async(program: &MirProgram, id: MirFunctionId) -> Bool { web_async_function_ids(program).contains_key(id) }
// Rust: crates/jet-codegen/src/Codegen/MIRWeb.rs:938
fn wasm_export_symbol(function: &MirFunction) -> String { "jet_export_{function.name}" }
// Rust: crates/jet-codegen/src/Codegen/MIRWeb.rs:942
fn wasm_bridge_name(function: &MirFunction) -> String { "bridge_{function.name}" }

// Rust: crates/jet-codegen/src/Codegen/MIRWeb.rs:946
fn wasm_abi_list_kind(inner: &MirType) -> String? {
    if inner.kind == {
        .Int -> Val("list-int")
        .String -> Val("list-string")
        .IntN(signed: true, bits: 64) -> Val("list-i64")
        .InlineRange(base: base, ..) | .Tagged(inner: base, ..) -> wasm_abi_list_kind(base)
        _ -> None
    }
}
// Rust: crates/jet-codegen/src/Codegen/MIRWeb.rs:960
fn wasm_abi_kind(ty: &MirType) -> String? MirWebError! {
    if ty.is_unit() -> return None
    if ty.kind == {
        .Int -> Val("int")
        .String -> Val("string")
        .List(inner) -> Val(wasm_abi_list_kind(inner) ?? throw MirWebError.InvalidMir(message: "unsupported Web Wasm export collection type `{ty.display_name()}`"))
        .Map(key: key, value: value) && key.kind == MirTypeKind.String && value.kind == MirTypeKind.Int -> Val("map-string-int")
        .InlineRange(base: base, ..) | .Tagged(inner: base, ..) | .Quantity(base: base, ..) -> wasm_abi_kind(base)
        .Float | .Bool | .Char | .IntN(..) | .Float32 -> None
        .Apply(..) | .Map(..) | .FixedList(..) | .Shared(_) | .Option(_) | .Result(..) | .Fn(_) | .SendFn(..) | .TraitObject(_) | .Tuple(_) | .Union(_) | .Measure(_) -> throw MirWebError.InvalidMir(message: "unsupported Web Wasm export boundary type `{ty.display_name()}`")
    }
}
// Rust: crates/jet-codegen/src/Codegen/MIRWeb.rs:1009
fn wasm_direct_argument(value: String, ty: &MirType) -> String MirWebError! {
    if ty.kind == {
        .Float | .Float32 -> "Number({value})"
        .Bool -> "Number(Boolean({value}))"
        .Char -> "Number(String({value}).codePointAt(0))"
        .IntN(bits: bits, ..) -> if bits <= 32 { "Number({value})" } else { "BigInt({value})" }
        .InlineRange(base: base, ..) | .Tagged(inner: base, ..) | .Quantity(base: base, ..) -> wasm_direct_argument(value, base)
        _ -> throw MirWebError.InvalidMir(message: "unsupported direct Web Wasm export argument type `{ty.display_name()}`")
    }
}
// Rust: crates/jet-codegen/src/Codegen/MIRWeb.rs:1033
fn wasm_direct_return(raw: String, ty: &MirType) -> String MirWebError! {
    if ty.kind == {
        .Float | .Float32 -> "Number({raw})"
        .Bool -> "Boolean(Number({raw}))"
        .Char -> "String.fromCodePoint(Number({raw}))"
        .IntN(signed: signed, bits: bits) -> {
            kind :: if signed { "Int" } else { "Uint" }
            "BigInt.as{kind}N({bits}, BigInt({raw}))"
        }
        .InlineRange(base: base, ..) | .Tagged(inner: base, ..) | .Quantity(base: base, ..) -> wasm_direct_return(raw, base)
        _ -> throw MirWebError.InvalidMir(message: "unsupported direct Web Wasm export return type `{ty.display_name()}`")
    }
}
// Rust: crates/jet-codegen/src/Codegen/MIRWeb.rs:1054
fn wasm_abi_argument(value: String, ty: &MirType) -> String MirWebError! {
    if wasm_abi_kind(ty) == { .Val(kind) -> "jetDom.marshalAbi({value}, {js_string(kind)}, wasm)"; .None -> wasm_direct_argument(value, ty) }
}
// Rust: crates/jet-codegen/src/Codegen/MIRWeb.rs:1065
fn wasm_abi_return(raw: String, ty: &MirType) -> String MirWebError! {
    if wasm_abi_kind(ty) == { .Val(kind) -> "jetDom.unmarshalAbi({raw}, {js_string(kind)}, wasm)"; .None && ty.is_unit() -> "undefined"; .None -> wasm_direct_return(raw, ty) }
}

// Rust: crates/jet-codegen/src/Codegen/MIRWeb.rs:1077
fn wasm_bridge_arguments(function: &MirFunction, values: &[String]) -> [String] MirWebError! {
    if values.len() != function.params.len() -> throw MirWebError.InvalidMir(message: "Web Wasm export `{function.name}` received {values.len()} arguments but declares {function.params.len()}")
    rendered := [String]{}
    loop index in 0..<function.params.len() {
        param :: function.params[index]
        value :: values[index]
        if function.web_param_reconstructions.find(row -> row.local == param.name) == .Val(reconstruction) {
            loop field in reconstruction.fields {
                field_value :: "({value})[{js_string(field.field)}]"
                rendered.push(wasm_abi_argument(field_value, field.ty))
            }
        } else { rendered.push(wasm_abi_argument(value, param.ty)) }
    }
    ^rendered
}

// Rust: crates/jet-codegen/src/Codegen/MIRWeb.rs:1109
fn emit_wasm_export_bridges(out: &String, functions: &[&MirFunction]) MirWebError! {
    exports := functions.filter(function -> is_wasm_export(function) && function_in_bucket(function, WebBucket.Wasm)).collect()
    exports.sort_by_key(function -> function.id)
    names := [String:Bool]{}
    loop function in exports {
        if function.form != MirFunctionForm.TopLevel || !function.capture_params.is_empty() -> throw MirWebError.InvalidMir(message: "Web Wasm export `{function.name}` is not a top-level capture-free function")
        if function.generator != None -> throw MirWebError.InvalidMir(message: "Web Wasm export `{function.name}` cannot be a generator")
        if names.contains_key(function.name) -> throw MirWebError.InvalidMir(message: "Web Wasm export `{function.name}` has a duplicate JavaScript bridge name")
        names.insert(~function.name, true)
        values :: (0..<function.params.len()).map(index -> "args[{index}]").collect()
        arguments :: wasm_bridge_arguments(function, values)
        success :: if function.failure == { .Result(success: success, ..) -> success; .Optional(value: value) -> value; .Infallible | .Diverges(..) -> function.return_type }
        result :: wasm_abi_return("raw", success)
        bridge :: wasm_bridge_name(function)
        symbol :: wasm_export_symbol(function)
        out.push_str("async function {bridge}(...args) {{\n")
        error_message :: js_string("Web Wasm export `{function.name}` expects {function.params.len()} arguments")
        out.push_str("  if (args.length !== {function.params.len()}) throw new TypeError({error_message});\n")
        out.push_str("  const wasm = __jetPreludeWasm;\n")
        out.push_str("  let raw = wasm.{symbol}({arguments.join(", ")});\n")
        out.push_str("  const outcome = jetDom.takeWasmError(wasm);\n")
        out.push_str("  if (outcome?.tag === \"Host\") throw jet_web_wasm_host_error(outcome, null, Number(outcome.status ?? 101));\n")
        if function.failure == {
            .Result(..) | .Optional(..) -> {
                out.push_str("  if (outcome?.tag === \"Err\") return {{ tag: \"Err\", values: [outcome.error] }};\n")
                out.push_str("  return {{ tag: \"Ok\", values: [{result}] }};\n")
            }
            .Infallible | .Diverges(..) -> {
                out.push_str("  if (outcome) return jet_web_edge_result(outcome);\n")
                out.push_str("  return {result};\n")
            }
        }
        out.push_str("}}\n\n")
    }
}

// Rust: crates/jet-codegen/src/Codegen/MIRWeb.rs:1197
fn js_wasm_export_call(function: &MirFunction, caller: &MirFunction, args: &[MirCallArg], values: &[String]) -> String MirWebError! {
    if !function.target_applicability.web || !function_in_bucket(function, WebBucket.Wasm) -> throw MirWebError.MissingUserFunction(function: function.id.0)
    if function.form != MirFunctionForm.TopLevel || !function.capture_params.is_empty() -> throw MirWebError.InvalidMir(message: "Web Wasm export `{function.name}` is not a top-level capture-free function")
    if caller.generator != None -> throw MirWebError.InvalidMir(message: "generator function {caller.id.0} cannot await Web Wasm export `{function.name}`")
    if args.any(arg -> arg.spread) -> throw MirWebError.InvalidMir(message: "Web Wasm export `{function.name}` cannot receive a spread argument")
    "await {wasm_bridge_name(function)}({values.join(", ")})"
}

// Rust: crates/jet-codegen/src/Codegen/MIRWeb.rs:1239
fn web_source_name(name: String) -> String { name.strip_prefix(GENERATED_NAME_PREFIX) ?? name }

// Rust: crates/jet-codegen/src/Codegen/MIRWeb.rs:1244
fn emit_js_print_type_facts(out: &String, program: &MirProgram) {
    out.push_str("const __jet_print_type_facts = Object.freeze({{\n")
    loop type_def in program.types {
        out.push_str("  {js_string(type_def.id.0.to_string())}: {{ name: {js_string(web_source_name(type_def.name))}, auto_printable: {type_def.auto_printable}, ")
        if type_def.kind == {
            .Struct(fields: fields, ..) -> {
                out.push_str("kind: \"struct\", fields: [")
                loop index in 0..<fields.len() {
                    if index != 0 -> out.push_str(", ")
                    field :: fields[index]
                    out.push_str("{{ key: {js_string(field.name)}, name: {js_string(web_source_name(field.name))}, computed: {field.computed}, redacted: {field.redact} }}")
                }
                out.push_str("]")
            }
            .Enum(variants: variants, ..) -> {
                out.push_str("kind: \"enum\", variants: [")
                loop index in 0..<variants.len() {
                    if index != 0 -> out.push_str(", ")
                    variant :: variants[index]
                    out.push_str("{{ tag: {js_string(variant.name)}, name: {js_string(web_source_name(variant.name))}, ")
                    if variant.payload == {
                        .Unit -> out.push_str("kind: \"unit\", fields: []")
                        .Single(_) -> out.push_str("kind: \"single\", fields: []")
                        .Named(fields) -> {
                            out.push_str("kind: \"named\", fields: [")
                            loop field_index in 0..<fields.len() {
                                if field_index != 0 -> out.push_str(", ")
                                field :: fields[field_index]
                                out.push_str("{{ key: {js_string(field.name)}, name: {js_string(web_source_name(field.name))}, computed: {field.computed}, redacted: {field.redact} }}")
                            }
                            out.push_str("]")
                        }
                    }
                    out.push_str("}}")
                }
                out.push_str("]")
            }
            .Distinct(..) | .Alias(..) -> out.push_str("kind: \"transparent\"")
            .UnitFamily(members: members) -> {
                out.push_str("kind: \"unit_family\", members: [")
                loop index in 0..<members.len() {
                    if index != 0 -> out.push_str(", ")
                    out.push_str(js_string(web_source_name(members[index])))
                }
                out.push_str("]")
            }
        }
        out.push_str("}},\n")
    }
    out.push_str("}});\n")
}

// Rust: crates/jet-codegen/src/Codegen/MIRWeb.rs:1333
fn js_cli_type_default(program: &MirProgram, ty: &MirType) -> String MirWebError! {
    constant :: if ty.kind == {
        .Int -> MirConstant.Int(value: 0, width: None, spelling: None)
        .IntN(signed: signed, bits: bits) -> MirConstant.Int(value: 0, width: Val((signed, bits)), spelling: None)
        .Float -> MirConstant.Float(value: 0.0, f32: false, spelling: None)
        .Float32 -> MirConstant.Float(value: 0.0, f32: true, spelling: None)
        .Bool -> MirConstant.Bool(false)
        .String -> MirConstant.String("")
        .Char -> MirConstant.Char(Char.from_code_point(0))
        .InlineRange(base: base, ..) | .Tagged(inner: base, ..) -> return js_cli_type_default(program, base)
        .Option(_) -> MirConstant.Unit
        _ -> return "undefined"
    }
    js_constant_expression(program, constant)
}

// Rust: crates/jet-codegen/src/Codegen/MIRWeb.rs:1367
fn js_web_cli_entry_argument(program: &MirProgram, function: &MirFunction, cli: &MirCliEntry?) -> String? MirWebError! {
    cli :: cli.filter(cli -> cli.record_inputs) ?? return None
    if function.params.len() != 1 -> throw MirWebError.InvalidMir(message: "Web CLI record entry {function.id.0} expects one parameter, found {function.params.len()}")
    fields := [String]{}.with_capacity(cli.inputs.len())
    loop input in cli.inputs {
        default :: if input.shape == {
            .Flag -> "false"
            .Value(default: default, ..) -> if default == { .Val(.Value(value)) -> js_constant_expression(program, value); .Val(.TypeDefault) -> js_cli_type_default(program, input.ty); .None -> "undefined" }
        }
        fields.push("{js_string(input.name)}: {default}")
    }
    defaults := "{{ {fields.join(", ")} }}"
    if function.params[0].ty.identity == .Val(type_id) -> defaults = "Object.defineProperty({defaults}, \"__jet_type\", {{ value: {js_string(type_id.0.to_string())}, enumerable: false }})"
    Val("[Object.assign({defaults}, (args.length === 1 && args[0] !== null && typeof args[0] === \"object\" && !Array.isArray(args[0])) ? args[0] : {{}})]")
}

// Rust: crates/jet-codegen/src/Codegen/MIRWeb.rs:1410
fn emit_js_app(program: &MirProgram, target: &MirWebTarget, artifact: &MirArtifactPlan, functions: &[&MirFunction], entry: MirFunctionId?, artifact_identity: String, history_provenance: &HistoryProvenance) -> String MirWebError! {
    has_game_runtime :: artifact.runtime_parts.any(part -> part == MirRuntimePartId.Game)
    has_data_runtime :: artifact.runtime_parts.contains(MirRuntimePartId.Data)
    // Wasm always exports the history ABI, even without authored history calls.
    include_history :: true
    needs_font_shaping :: web_uses_font_shaping(program, functions)
    out := "import * as jetDom from \"./jet_dom_runtime.js\";\n"
    shared_prelude :: try { shared_js_prelude(needs_font_shaping, artifact.runtime_parts, include_history) } catch error { throw MirWebError.InvalidAssets(message: error.to_string()) }
    out.push_str(shared_prelude)
    out.push_str("\n")
    emit_js_print_type_facts(&out, program)
    emit_js_copy_type_facts(&out, program)
    out.push_str("\n")
    out.push_str(if needs_font_shaping { "const __jetFontImports = await jet_ui_web_harfbuzz_imports();\n" } else { "const __jetFontImports = jet_ui_web_unreachable_harfbuzz_imports();\n" })
    if has_data_runtime -> out.push_str("const __jetDataImports = jet_data_web_imports();\n")
    if include_history -> out.push_str("const __jetTestingHistoryImports = jet_testing_history_web_imports();\n")
    out.push_str("const __jetPreludeWasm = (await jetDom.instantiateWasm(new URL(\"./app.wasm\", import.meta.url).href, {{ ...__jetFontImports")
    if has_data_runtime -> out.push_str(", ...__jetDataImports")
    if include_history -> out.push_str(", ...__jetTestingHistoryImports")
    out.push_str(" }})).exports;\n")
    loop constant in program.constants {
        if !artifact.modules.contains(constant.module) -> continue
        value :: js_constant_expression(program, constant.value)
        out.push_str("globalThis[{js_string(constant.key)}] = {value};\n")
    }
    if has_data_runtime -> out.push_str("jet_data_web_bind_wasm(__jetPreludeWasm);\nif (typeof __jetPreludeWasm.jet_data_web_register_types === \"function\") __jetPreludeWasm.jet_data_web_register_types();\n")
    if include_history -> out.push_str("jet_testing_history_web_bind_wasm(__jetPreludeWasm);\n")
    if needs_font_shaping -> out.push_str("jet_ui_web_harfbuzz_bind_app(__jetPreludeWasm);\n")
    if has_game_runtime -> out.push_str("  if (typeof fetch === \"function\") {{\ntry {{\nconst __jetProjection = await fetch(\"/__jet_devtools/state\").then((response) => response.ok ? response.json() : null);\nif (__jetProjection?.session_id) {{\nglobalThis.__jetDevtoolsGameIdentity = {{\nsession_id: __jetProjection.session_id,\nsource_id: __jetProjection.source_id || \"game\",\nbuild_id: __jetProjection.build_id || \"runtime\",\nrevision: __jetProjection.revision || \"runtime\",\n}};\n}}\n}} catch (_) {{}}\n}}\n")
    emit_wasm_export_bridges(&out, functions)
    emit_web_module_registry(&out, program, artifact, artifact_identity)
    js_functions := functions.filter(function -> function_in_bucket(function, WebBucket.JS) && artifact.modules.any(module -> module == function.module_id)).collect()
    js_functions.sort_by_key(function -> function.id)
    loop function in js_functions -> emit_js_function(&out, program, function, target.release_devtools_policy.local_rail, history_provenance)
    entry_row :: if entry == .Val(entry) { Val(functions.find(function -> function.id == entry) ?? throw MirWebError.MissingEntryFunction(function: entry.0)) } else { None }
    entry_function :: entry_row.filter(function -> function_in_bucket(function, WebBucket.JS))
    entry_cli_argument :: if entry_function == .Val(function) { js_web_cli_entry_argument(program, function, artifact.entry.and_then(entry -> entry.cli)) } else { None }
    entry_wasm :: entry_row.filter(function -> function_in_bucket(function, WebBucket.Wasm))
    main_keyword :: if entry_function.is_some_and(function -> function.generator != None) { "export function*" } else { "export async function" }
    out.push_str("\n{main_keyword} jet_main(...args) {{\n")
    out.push_str("  try {{\n")
    if entry_function == .Val(function) {
        if entry_cli_argument == .Val(argument) -> out.push_str("    const __jet_entry_args = {argument};\n")
        entry_arguments :: if entry_cli_argument != None { "__jet_entry_args" } else { "args" }
        if function.generator != None {
            out.push_str("    const __jet_edge_result = yield* jet_fn_{function.id.0}([], {entry_arguments});\n")
        } else {
            out.push_str("    const __jet_edge_result = await jet_fn_{function.id.0}([], {entry_arguments});\n")
        }
        out.push_str("    return jet_web_edge_result(__jet_edge_result);\n")
    } else if entry_wasm == .Val(function) {
        if function.generator != None -> throw MirWebError.InvalidMir(message: "Web Wasm entry {function.id.0} cannot be a generator")
        out.push_str("    __jetPreludeWasm.jet_entry_{function.id.0}();\n")
        out.push_str("    const outcome = jetDom.takeWasmError(__jetPreludeWasm);\n")
        out.push_str("    if (outcome?.tag === \"Host\") throw jet_web_wasm_host_error(outcome, null, Number(outcome.status ?? 101));\n    if (outcome) return jet_web_edge_result(outcome);\n")
        out.push_str("    return undefined;\n")
    } else { out.push_str("    return undefined;\n") }
    out.push_str("  }} catch (__jet_error) {{\nif (__jet_error instanceof JetWebPropagation) {{\nreturn jet_web_edge_result({{ tag: \"Err\", error: __jet_error.wire }});\n}}\nthrow __jet_error;\n}}\n")
    out.push_str("}}\n\n")
    emit_js_routes(&out, program)
    ^out
}

// Rust: crates/jet-codegen/src/Codegen/MIRWeb.rs:1641
fn emit_web_module_registry(out: &String, program: &MirProgram, artifact: &MirArtifactPlan, artifact_identity: String) MirWebError! {
    module_ids := ~artifact.modules
    module_ids.sort_by_key(id -> id.0)
    loop module_id in module_ids {
        module :: program.modules.find(module -> module.id == module_id) ?? throw MirWebError.InvalidMir(message: "Web artifact {artifact.id.0} references missing module {module_id.0}")
        if module.key.is_empty() || module.path.is_empty() -> throw MirWebError.InvalidMir(message: "Web artifact {artifact.id.0} module {module_id.0} has no stable key/path")
        imports :: module.imports.map(id -> id.0.to_string()).collect().join(",")
        item_order :: module.item_order.map(item_ref_descriptor).collect().join(TEXT_NUL)
        interface_seed :: "{module.key}{TEXT_NUL}{module.path}{TEXT_NUL}{imports}{TEXT_NUL}{item_order}"
        body_seed :: "{artifact_identity}{TEXT_NUL}{module_id.0}{TEXT_NUL}{module.path}"
        interface_fingerprint :: "sha256-{sha256_hex(interface_seed.as_bytes())}"
        body_fingerprint :: "sha256-{sha256_hex(body_seed.as_bytes())}"
        out.push_str("jetDom.registerWebModule({json_string(module.key)}, {json_string(interface_fingerprint)}, {json_string(body_fingerprint)});\n")
    }
    out.push_str("\n")
}

// Rust: crates/jet-codegen/src/Codegen/MIRWeb.rs:1704
fn validate_function_blocks(function: &MirFunction) MirWebError! {
    has_block :: fn(id: MirBlockId) { function.blocks.any(block -> block.id == id) }
    if !has_block(function.entry) -> throw MirWebError.InvalidMir(message: "Web MIR function {function.id.0} has a missing entry block {function.entry.0}")
    loop block in function.blocks {
        loop target in block.terminator.targets() {
            if !has_block(target) -> throw MirWebError.InvalidMir(message: "Web MIR function {function.id.0} block {block.id.0} targets missing block {target.0}")
        }
    }
}

// Rust: crates/jet-codegen/src/Codegen/MIRWeb.rs:1731
fn validate_capture_params(program: &MirProgram, function: &MirFunction) MirWebError! {
    loop slot in 0..<function.capture_params.len() {
        capture :: function.capture_params[slot]
        if capture.slot != slot -> throw MirWebError.InvalidMir(message: "MIR function {function.id.0} capture slot {capture.slot} is out of order")
        if capture.ty.identity == .Val(type_id) -> ensure_type_instance(program, type_id)
    }
}
