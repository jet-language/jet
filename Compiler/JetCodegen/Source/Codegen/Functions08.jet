//RS     body_span: Option<crate::Diagnostics::Span>,
//RS     /// A compiler-generated body (a built-in derive expanded from
//RS     /// `Prelude/Derives.jet`). Its spans are provider-template offsets that
//RS     /// overlap the host file's authored code, so span containment cannot tell
//RS     /// its references from those of the authored callable at the same offsets.
