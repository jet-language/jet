//RS 
//RS /// The callables a reference at `start..end` of `source` belongs to: the
//RS /// innermost authored callable whose body contains it, plus every generated
//RS /// callable whose body span contains it. A generated body carries template
//RS /// offsets, so it must never outrank the authored callable really written at
//RS /// those offsets (that pruned `inflate`'s callees once the derive template got
//RS /// shorter than `inflate`). Crediting the reference to both only keeps extra
//RS /// targets reachable; it never drops a live one.
//RS fn callables_containing_reference(
//RS     index: &CostCallableIndex,
//RS     source: &str,
//RS     start: usize,
//RS     end: usize,
//RS ) -> Vec<usize> {
//RS     let Some(bodies) = index.bodies.get(source) else {
//RS         return Vec::new();
//RS     };
//RS     let mut found = Vec::new();
//RS     bodies.generated.containing(start, end, &mut found);
//RS     let mut containing = found.iter().map(|&(callable, _)| callable).collect::<Vec<_>>();
//RS     containing.sort_unstable();
//RS     found.clear();
//RS     bodies.authored.containing(start, end, &mut found);
//RS     // The narrowest body wins; the earliest callable breaks a width tie.
//RS     containing.extend(
//RS         found
//RS             .into_iter()
//RS             .min_by_key(|&(callable, width)| (width, callable))
//RS             .map(|(callable, _)| callable),
//RS     );
//RS     containing
//RS }
