use jet_foundation.[Type, TExpr, TExprKind, TIntegerBounds, TCostFact, TCostKind, TCostState, TFactChannel, TFactExclusivity, TFactPurity, TListSpreadPart, TLambda, TLambdaBody, TPlace, TEnumPayload, TRequireKind, TCoreClosureKind, TFnValueKind, THostArg, THostCall, TCallArg, TStrPart, TOrFallback, TIfCond, TStmt, ProgramBundle, Span, TBinaryOp, TUnaryOp, AccessConvention, TScopeMemberKind, NameDeclaration, NameReference, NameLedger, AppGraph, WebPartitionMarker, core_source_modules, CORE_PRIVATE_SOURCE_PARTS, core_source_owns]
use jet_parser.[Func, Item, Expr, Call]
use jet_syntax.[is_known_core_module]

// Rust: crates/jet-codegen/src/Codegen/TIR/mod.rs:8627
fn integer_cost_fact(op: TBinaryOp, lhs: @TExpr, rhs: @TExpr) -> TCostFact Never! {
    state := TCostState.SemanticRemainder
    if integer_bounds_for_expr(lhs) == Val(left) {
        if integer_bounds_for_expr(rhs) == Val(right) {
            if combine_integer_bounds(op, left, right) == Val(result) {
                if bounds_fit_inline(left) && bounds_fit_inline(right) && bounds_fit_inline(result) -> state = TCostState.OptimizerRemoved
            }
        }
    }
    TCostFact{kind: TCostKind.ExactIntSpill, state: state}
}

// Rust: crates/jet-codegen/src/Codegen/TIR/mod.rs:8647
fn integer_unary_cost_fact(operand: @TExpr) -> TCostFact Never! {
    state := TCostState.SemanticRemainder
    if integer_bounds_for_expr(operand) == Val(bounds) {
        if bounds.lo.checked_neg().is_some() {
            result :: TIntegerBounds{lo: -bounds.hi, hi: -bounds.lo}
            if bounds_fit_inline(bounds) && bounds_fit_inline(result) -> state = TCostState.OptimizerRemoved
        }
    }
    TCostFact{kind: TCostKind.ExactIntSpill, state: state}
}

// Rust: crates/jet-codegen/src/Codegen/TIR/mod.rs:8668
fn is_outcome_type(ty: @Type) -> Bool Never! {
    if ty == { .Result{..} | .Option(_) -> true else -> false }
}

// Rust: crates/jet-codegen/src/Codegen/TIR/mod.rs:8672
fn is_outcome_constructor(kind: @TExprKind) -> Bool Never! {
    if kind == {
        .Absent | .Present(_) | .Ok(_) | .Err(..) | .Call{..} | .MethodCall{..}
        | .StaticCall{..} | .BuiltinMethod{..} | .ClosureMethod{..} | .HandleMethod{..}
        | .CoreCall{..} | .ModuleCall{..} | .ExternCall{..} | .HostCall(_)
        | .RangeCheckedCtor{..} | .DistinctConvert{fallible: true, ..}
        | .UnitConvert{fallible: true, ..} | .DecodeUnder{..} | .OptionLift2{..}
        | .OptField{..} | .TaskGroupAll{..} | .TaskGroupRace{..} | .TaskGroupAny{..} -> true
        else -> false
    }
}

// Rust: crates/jet-codegen/src/Codegen/TIR/mod.rs:8701
fn cost_fact_for_expr(expr: @TExpr) -> TCostFact? Never! {
    if expr.kind == {
        .MaterializeView(_) -> Val(TCostFact{kind: TCostKind.ViewMaterialization, state: TCostState.SemanticRemainder})
        .BuiltinMethod{receiver: recv, operation: op, ..} if (if recv.ty == { .Map{..} -> true else -> false }) && op.needs_mut_receiver_place() ->
            Val(TCostFact{kind: TCostKind.CollectionCopyOnWrite, state: TCostState.SemanticRemainder})
        .Binary{op, lhs, rhs, ..} if expr.ty == Type.Int && (op == TBinaryOp.Add || op == TBinaryOp.Sub || op == TBinaryOp.Mul) -> Val(integer_cost_fact(op, lhs, rhs))
        .Unary{op: TUnaryOp.Neg, operand} if expr.ty == Type.Int -> Val(integer_unary_cost_fact(operand))
        .IndexRead{base, is_map: false, uninit_fixed: false, ..} if (if base.ty == { .List(_) | .FixedList{..} -> true else -> false }) ->
            Val(TCostFact{kind: TCostKind.RepresentationFallback, state: TCostState.SemanticRemainder})
        else -> if is_outcome_type(@expr.ty) && is_outcome_constructor(@expr.kind) -> Val(TCostFact{kind: TCostKind.OutcomeConstruction, state: TCostState.SemanticRemainder}) else -> None
    }
}

// Rust: crates/jet-codegen/src/Codegen/TIR/mod.rs:8736
// ListSpreadPart is canonically TListSpreadPart in jet_foundation; Elem is Element.

// Rust: crates/jet-codegen/src/Codegen/TIR/mod.rs:8741
impl TExpr {
    // Rust: crates/jet-codegen/src/Codegen/TIR/mod.rs:8749
    pub fn fact_channel(self: @TExpr) -> TFactChannel Never! {
        exclusivity :: if self.kind == {
            .Borrow(_, AccessConvention.Write) -> TFactExclusivity.Exclusive
            .Borrow(_, _) -> TFactExclusivity.Shared
            .ResourceTake(_) | .Move(_) -> TFactExclusivity.Move
            else -> TFactExclusivity.Unknown
        }
        comptime_value :: if self.kind == { .CtLit(value) -> Val(~value) else -> None }
        TFactChannel{ty: Val(~self.ty), integer_bounds: integer_bounds_for_expr(self), exclusivity: exclusivity, purity: TFactPurity.Unknown, no_cross_iteration_deps: false, comptime_value: comptime_value, cost: cost_fact_for_expr(self)}
    }
}

// Rust: crates/jet-codegen/src/Codegen/TIR/mod.rs:8771
fn collect_cost_lambda(lambda: @TLambda, function: String, span: Span, loop_depth: USize, sites: &[TCostSite]) Never! {
    if lambda.executable == {
        .Expr(expr) -> collect_cost_expr(expr, function, span, loop_depth, &sites)
        .Block(body) | .SharedBlock(body) -> collect_cost_stmts(body, function, span, loop_depth, &sites)
    }
}

// Rust: crates/jet-codegen/src/Codegen/TIR/mod.rs:8791
fn collect_cost_place(place: @TPlace, function: String, span: Span, loop_depth: USize, sites: &[TCostSite]) Never! {
    if place == .Expr(expr) -> collect_cost_expr(expr, function, span, loop_depth, &sites)
}

// Rust: crates/jet-codegen/src/Codegen/TIR/mod.rs:8803
fn collect_cost_enum_payload(payload: @TEnumPayload, function: String, span: Span, loop_depth: USize, sites: &[TCostSite]) Never! {
    if payload == {
        .Unit -> {}
        .Positional(args) -> { loop arg in args -> collect_cost_expr(@arg.value, function, span, loop_depth, &sites) }
        .Named(fields) -> { loop arg in fields -> collect_cost_expr(@arg.value.value, function, span, loop_depth, &sites) }
    }
}

// Rust: crates/jet-codegen/src/Codegen/TIR/mod.rs:8825
fn collect_cost_require(require: @TRequireKind, function: String, span: Span, loop_depth: USize, sites: &[TCostSite]) Never! {
    if require == {
        .Require{cond, msg} -> {
            collect_cost_expr(cond, function, span, loop_depth, &sites)
            if msg == Val(value) -> collect_cost_expr(value, function, span, loop_depth, &sites)
        }
        .RequireEq{left, right} -> {
            collect_cost_expr(left, function, span, loop_depth, &sites)
            collect_cost_expr(right, function, span, loop_depth, &sites)
        }
        .Panic{msg} -> collect_cost_expr(msg, function, span, loop_depth, &sites)
    }
}

// Rust: crates/jet-codegen/src/Codegen/TIR/mod.rs:8849
fn collect_cost_core_closure(kind: @TCoreClosureKind, function: String, span: Span, loop_depth: USize, sites: &[TCostSite]) Never! {
    if kind == {
        .Spawn{group, executable, ..} -> {
            if group == Val(value) -> collect_cost_expr(value, function, span, loop_depth, &sites)
            collect_cost_lambda(executable, function, span, loop_depth, &sites)
        }
        .Realtime{rate, frames, executable} -> {
            collect_cost_expr(rate, function, span, loop_depth, &sites)
            collect_cost_expr(frames, function, span, loop_depth, &sites)
            collect_cost_lambda(executable, function, span, loop_depth, &sites)
        }
        .Serve{address: addr, ..} -> collect_cost_expr(addr, function, span, loop_depth, &sites)
        .OnInterrupt{callback} -> collect_cost_expr(callback, function, span, loop_depth, &sites)
        .Guard{executable, ..} | .OnCommit{executable, ..} | .OnRollback{executable, ..}
        | .ReactiveDerived{executable, ..} | .ReactiveEffect{executable, ..} | .UIReactiveRender{executable, ..} -> collect_cost_lambda(executable, function, span, loop_depth, &sites)
        .UIPreview{name, viewport, executable, ..} -> {
            collect_cost_expr(name, function, span, loop_depth, &sites)
            if viewport == Val(value) -> collect_cost_expr(value, function, span, loop_depth, &sites)
            collect_cost_lambda(executable, function, span, loop_depth, &sites)
        }
        .UIButtonOnClick{label, shortcut, accessible_label, executable, ..} -> {
            collect_cost_expr(label, function, span, loop_depth, &sites)
            collect_cost_expr(shortcut, function, span, loop_depth, &sites)
            collect_cost_expr(accessible_label, function, span, loop_depth, &sites)
            collect_cost_lambda(executable, function, span, loop_depth, &sites)
        }
        .UITextInputOnDrop{state, ime, executable, ..} -> {
            collect_cost_expr(state, function, span, loop_depth, &sites)
            collect_cost_expr(ime, function, span, loop_depth, &sites)
            collect_cost_lambda(executable, function, span, loop_depth, &sites)
        }
    }
}

// Rust: crates/jet-codegen/src/Codegen/TIR/mod.rs:8925
fn collect_cost_fn_value(kind: @TFnValueKind, function: String, span: Span, loop_depth: USize, sites: &[TCostSite]) Never! {
    if kind == {
        .NamedFn{lambda, ..} -> { if lambda == Val(value) -> collect_cost_lambda(value, function, span, loop_depth, &sites) }
        .Policy{callee, policy_args, ..} -> {
            collect_cost_expr(callee, function, span, loop_depth, &sites)
            collect_cost_call_args(policy_args, function, span, loop_depth, &sites)
        }
        .Call{callee, args} -> {
            collect_cost_expr(callee, function, span, loop_depth, &sites)
            collect_cost_call_args(args, function, span, loop_depth, &sites)
        }
        .Send{value} -> collect_cost_expr(value, function, span, loop_depth, &sites)
    }
}

// Rust: crates/jet-codegen/src/Codegen/TIR/mod.rs:8956
fn collect_cost_host_arg(arg: @THostArg, function: String, span: Span, loop_depth: USize, sites: &[TCostSite]) Never! {
    if arg == {
        .Expr(value) | .Borrow(value) -> collect_cost_expr(value, function, span, loop_depth, &sites)
        .Lambda(lambda) -> collect_cost_lambda(lambda, function, span, loop_depth, &sites)
    }
}

// Rust: crates/jet-codegen/src/Codegen/TIR/mod.rs:8973
fn collect_cost_call_args(args: @[TCallArg], function: String, span: Span, loop_depth: USize, sites: &[TCostSite]) Never! {
    loop arg in args -> collect_cost_expr(@arg.value, function, span, loop_depth, &sites)
}

// Rust: crates/jet-codegen/src/Codegen/TIR/mod.rs:8985
fn collect_cost_expr(expr: @TExpr, function: String, span: Span, loop_depth: USize, sites: &[TCostSite]) Never! {
    collect_cost_expr_with_state_and_context(expr, function, span, loop_depth, &sites, None, false)
}

// Rust: crates/jet-codegen/src/Codegen/TIR/mod.rs:8997
// A consumed carrier is not retained; descendants retain their ordinary context.
fn collect_cost_expr_consumed(expr: @TExpr, function: String, span: Span, loop_depth: USize, sites: &[TCostSite]) Never! {
    collect_cost_expr_with_state_and_context(expr, function, span, loop_depth, &sites, None, true)
}

// Rust: crates/jet-codegen/src/Codegen/TIR/mod.rs:9007
fn collect_cost_expr_with_state_and_context(expr: @TExpr, function: String, span: Span, loop_depth: USize, sites: &[TCostSite], state_override: TCostState?, outcome_consumed: Bool) Never! {
    expr_span :: if expr.kind == { .CoreCall{source_span, ..} -> source_span else -> span }
    // Read the cost directly rather than materializing the other fact-channel fields.
    if cost_fact_for_expr(expr) == Val(fact) {
        state :: state_override ?? fact.state
        if !outcome_consumed || fact.kind != TCostKind.OutcomeConstruction || state == TCostState.OptimizerRemoved {
            &sites.push(TCostSite{function: ~function, span: expr_span, kind: fact.kind, state: state, loop_depth: loop_depth})
        }
    }
    if expr.kind == {
        .InlineBlock(body) -> collect_cost_stmts(body, function, expr_span, loop_depth, &sites)
        .StrLit(parts) -> { loop part in parts { if part == .Interp(value, _) -> collect_cost_expr(value, function, expr_span, loop_depth, &sites) } }
        .HostCall(host) -> if host == {
            .Helper{args, ..} -> { loop arg in args -> collect_cost_host_arg(arg, function, expr_span, loop_depth, &sites) }
            .Method{receiver: recv, args, ..} -> {
                collect_cost_expr(recv, function, expr_span, loop_depth, &sites)
                loop arg in args -> collect_cost_expr(arg, function, expr_span, loop_depth, &sites)
            }
            .CarrierFact{receiver: recv, ..} | .OptionProbe{inner: recv, ..} -> collect_cost_expr_consumed(recv, function, expr_span, loop_depth, &sites)
            .CellGuardProject{receiver: recv, ..} | .TupleIndex{base: recv, ..} -> collect_cost_expr(recv, function, expr_span, loop_depth, &sites)
            .FixedListIndex{base, index, ..} -> {
                collect_cost_expr(base, function, expr_span, loop_depth, &sites)
                collect_cost_expr(index, function, expr_span, loop_depth, &sites)
            }
            .TypedText{argument: arg, ..} | .YieldSend{value: arg} -> collect_cost_expr(arg, function, expr_span, loop_depth, &sites)
            .GCEdit{edit, index_temp, ..} -> {
                collect_cost_expr(edit, function, expr_span, loop_depth, &sites)
                if index_temp == Val(index) -> collect_cost_expr(index, function, expr_span, loop_depth, &sites)
            }
            .StrMatchScan{subject, ..} | .BinMatchScan{subject, ..} -> collect_cost_expr(subject, function, expr_span, loop_depth, &sites)
            .TypedTextInterp{holes, ..} -> { loop hole in holes -> collect_cost_expr(hole, function, expr_span, loop_depth, &sites) }
            .ExpectSnapshot{value, ..} -> collect_cost_expr(value, function, expr_span, loop_depth, &sites)
            .EnvSet{name, value, ..} -> {
                collect_cost_expr(name, function, expr_span, loop_depth, &sites)
                collect_cost_expr(value, function, expr_span, loop_depth, &sites)
            }
            .ExpiringSecretNew{value, duration, clock, ..} | .ExpiringValueNew{value, duration, clock} -> {
                collect_cost_expr(value, function, expr_span, loop_depth, &sites)
                collect_cost_expr(duration, function, expr_span, loop_depth, &sites)
                collect_cost_expr(clock, function, expr_span, loop_depth, &sites)
            }
            .CCallback{lambda, ..} -> collect_cost_lambda(lambda, function, expr_span, loop_depth, &sites)
            .FnName(_) | .MemoStats{..} | .GCRead{..} | .SwitchSubjectField{..} | .SwitchSubjectValue | .NumericBounds{..} -> {}
        }
        .Call{args, ..} | .StaticCall{args, ..} | .ModuleCall{args, ..} | .AllocNew{args, ..} -> collect_cost_call_args(args, function, expr_span, loop_depth, &sites)
        .DistinctCtor{argument: arg, ..} | .RangeCheckedCtor{argument: arg, ..} | .DistinctConvert{argument: arg, ..}
        | .Print(arg) | .Close(arg) | .ResourceNew(arg) | .DistinctRaw(arg) | .Present(arg)
        | .Ok(arg) | .Err(arg) | .Deref(arg) | .RawOf(arg) | .Clone(arg, _)
        | .ExplicitCopy(arg) | .MaterializeView(arg) -> collect_cost_expr(arg, function, expr_span, loop_depth, &sites)
        .Drop(arg) -> collect_cost_expr_consumed(arg, function, expr_span, loop_depth, &sites)
        .UnitConvert{argument: arg, rounding, ..} -> {
            collect_cost_expr(arg, function, expr_span, loop_depth, &sites)
            if rounding == Val(value) -> collect_cost_expr(@value.digits, function, expr_span, loop_depth, &sites)
        }
        .MathBuiltin{args, ..} | .PreciseBuiltin{args, ..} -> { loop arg in args -> collect_cost_expr(arg, function, expr_span, loop_depth, &sites) }
        .RequireStop{kind, ..} -> collect_cost_require(kind, function, expr_span, loop_depth, &sites)
        .AmbientInput{prompt} -> { if prompt == Val(value) -> collect_cost_expr(value, function, expr_span, loop_depth, &sites) }
        .Binary{lhs, rhs, ..} | .LayoutCompare{lhs, rhs, ..} | .NumericBinaryMethod{receiver: lhs, argument: rhs, ..} | .OverflowOpt{lhs, rhs, ..} -> {
            collect_cost_expr(lhs, function, expr_span, loop_depth, &sites)
            collect_cost_expr(rhs, function, expr_span, loop_depth, &sites)
        }
        .CompareChain{operands, ..} -> { loop operand in operands -> collect_cost_expr(operand, function, expr_span, loop_depth, &sites) }
        .LayoutLit(inner) | .Unary{operand: inner, ..} | .Borrow{place: inner, ..} | .Move(inner) -> collect_cost_expr(inner, function, expr_span, loop_depth, &sites)
        .StructLit{fields, ..} -> { loop field in fields -> collect_cost_expr(@field.value, function, expr_span, loop_depth, &sites) }
        .Field{receiver: recv, ..} | .SharedGuardValue{guard: recv, ..} | .SharedGuardMap{guard: recv, ..}
        | .SharedGuardSplit{guard: recv, ..} | .PtrFromAddr{address: recv, ..} | .MathSwizzleRead{receiver: recv, ..}
        | .TaskGroupAll{tasks: recv} | .TaskGroupRace{tasks: recv} | .TaskGroupAny{tasks: recv} -> collect_cost_expr(recv, function, expr_span, loop_depth, &sites)
        .PatternMatches{subject: recv, ..} -> collect_cost_expr_consumed(recv, function, expr_span, loop_depth, &sites)
        .SharedGuardWait{guard, condition, predicate} -> {
            collect_cost_expr(guard, function, expr_span, loop_depth, &sites)
            collect_cost_expr(condition, function, expr_span, loop_depth, &sites)
            collect_cost_lambda(predicate, function, expr_span, loop_depth, &sites)
        }
        .ConditionNotify{condition, ..} -> collect_cost_expr(condition, function, expr_span, loop_depth, &sites)
        .EnumLit{payload, ..} -> collect_cost_enum_payload(payload, function, expr_span, loop_depth, &sites)
        .JSONLit{arg, ..} | .DBValueLit{arg, ..} -> { if arg == Val(value) -> collect_cost_expr(value, function, expr_span, loop_depth, &sites) }
        .ListLit(values) | .ColumnarListLit{elements: values, ..} -> { loop value in values -> collect_cost_expr(value, function, expr_span, loop_depth, &sites) }
        .ListSpread{parts} -> { loop part in parts { if part == { .Element(value) | .Spread(value) -> collect_cost_expr(value, function, expr_span, loop_depth, &sites) } } }
        .ColumnarGather{base, index, ..} | .ColumnarColumnRead{base, index, ..} | .IndexRead{base, index, ..}
        | .IndexHook{base, index, ..} | .MathLaneIndex{base, index, ..} -> {
            collect_cost_expr(base, function, expr_span, loop_depth, &sites)
            collect_cost_expr(index, function, expr_span, loop_depth, &sites)
        }
        .PoolSlot{pool, id, ..} -> {
            collect_cost_expr(pool, function, expr_span, loop_depth, &sites)
            collect_cost_expr(id, function, expr_span, loop_depth, &sites)
        }
        .SliceOwned{base, start, end, range, ..} -> {
            collect_cost_expr(base, function, expr_span, loop_depth, &sites)
            collect_cost_expr(start, function, expr_span, loop_depth, &sites)
            collect_cost_expr(end, function, expr_span, loop_depth, &sites)
            if range == Val(value) -> collect_cost_expr(value, function, expr_span, loop_depth, &sites)
        }
        .MethodCall{receiver: recv, args, ..} -> {
            collect_cost_expr(recv, function, expr_span, loop_depth, &sites)
            collect_cost_call_args(args, function, expr_span, loop_depth, &sites)
        }
        .DecodeUnder{segment, inner} -> {
            collect_cost_expr(segment, function, expr_span, loop_depth, &sites)
            collect_cost_expr_consumed(inner, function, expr_span, loop_depth, &sites)
        }
        .BuiltinMethod{receiver: recv, args, ..} | .ClosureMethod{receiver: recv, args, ..} | .HandleMethod{receiver: recv, args, ..} -> {
            collect_cost_expr(recv, function, expr_span, loop_depth, &sites)
            loop arg in args -> collect_cost_expr(arg, function, expr_span, loop_depth, &sites)
        }
        .CoreCall{args, ..} -> { loop arg in args -> collect_cost_expr(arg, function, expr_span, loop_depth, &sites) }
        .IfExpr{cond, then_body, then_value, else_body, else_value} -> {
            collect_cost_cond(cond, function, expr_span, loop_depth, &sites)
            collect_cost_stmts(then_body, function, expr_span, loop_depth, &sites)
            collect_cost_expr(then_value, function, expr_span, loop_depth, &sites)
            collect_cost_stmts(else_body, function, expr_span, loop_depth, &sites)
            collect_cost_expr(else_value, function, expr_span, loop_depth, &sites)
        }
        .ResultHandler{subject, ok_body, ok_value, err_body, err_value, terminal, ..} -> {
            collect_cost_expr_consumed(subject, function, expr_span, loop_depth, &sites)
            collect_cost_stmts(ok_body, function, expr_span, loop_depth, &sites)
            collect_cost_expr(ok_value, function, expr_span, loop_depth, &sites)
            collect_cost_stmts(err_body, function, expr_span, loop_depth, &sites)
            collect_cost_expr(err_value, function, expr_span, loop_depth, &sites)
            collect_cost_expr(terminal, function, expr_span, loop_depth, &sites)
        }
        .TryWithContext{inner, note, ..} -> {
            collect_cost_expr_consumed(inner, function, expr_span, loop_depth, &sites)
            if note == Val(value) -> collect_cost_expr(value, function, expr_span, loop_depth, &sites)
        }
        .OrFallback{value, fallback, ..} -> {
            collect_cost_expr_with_state_and_context(value, function, expr_span, loop_depth, &sites, Val(TCostState.OptimizerRemoved), true)
            if fallback == {
                .Value(value) | .Return(Val(value)) -> collect_cost_expr(value, function, expr_span, loop_depth, &sites)
                .Panic{message: msg, ..} -> collect_cost_expr(msg, function, expr_span, loop_depth, &sites)
                .Return(None) | .Break | .Continue | .BreakLabel(_) | .ContinueLabel(_) -> {}
            }
        }
        .OptField{base, ..} -> collect_cost_expr_consumed(base, function, expr_span, loop_depth, &sites)
        .OptionLift2{function: f, left: a, right: b} -> {
            collect_cost_expr(f, function, expr_span, loop_depth, &sites)
            collect_cost_expr_consumed(a, function, expr_span, loop_depth, &sites)
            collect_cost_expr_consumed(b, function, expr_span, loop_depth, &sites)
        }
        .HostBorrowCallback{callable, ..} -> collect_cost_expr(callable, function, expr_span, loop_depth, &sites)
        .Lambda(lambda) -> collect_cost_lambda(lambda, function, expr_span, loop_depth, &sites)
        .NumericMethod{receiver: recv, ..} -> collect_cost_expr(recv, function, expr_span, loop_depth, &sites)
        .SelectRecv{builder, channel} -> {
            collect_cost_expr(builder, function, expr_span, loop_depth, &sites)
            collect_cost_expr(channel, function, expr_span, loop_depth, &sites)
        }
        .SelectAfter{builder, duration, value} -> {
            collect_cost_expr(builder, function, expr_span, loop_depth, &sites)
            collect_cost_expr(duration, function, expr_span, loop_depth, &sites)
            if value == Val(inner) -> collect_cost_expr(inner, function, expr_span, loop_depth, &sites)
        }
        .SelectWait{builder, ..} -> collect_cost_expr(builder, function, expr_span, loop_depth, &sites)
        .CoreClosureCall{kind} -> collect_cost_core_closure(kind, function, expr_span, loop_depth, &sites)
        .FnValue{kind} -> collect_cost_fn_value(kind, function, expr_span, loop_depth, &sites)
        .ExternCall{args, ..} -> { loop arg in args -> collect_cost_expr(@arg.value, function, expr_span, loop_depth, &sites) }
        .TupleLit{fields, ..} -> { loop field in fields -> collect_cost_expr(@field.value, function, expr_span, loop_depth, &sites) }
        .MapLit(fields) -> {
            loop field in fields {
                collect_cost_expr(@field.key, function, expr_span, loop_depth, &sites)
                collect_cost_expr(@field.value, function, expr_span, loop_depth, &sites)
            }
        }
        else -> {}
    }
}

// Rust: crates/jet-codegen/src/Codegen/TIR/mod.rs:9410
fn collect_cost_cond(cond: @TIfCond, function: String, span: Span, loop_depth: USize, sites: &[TCostSite]) Never! {
    if cond == {
        .Plain(expr) -> collect_cost_expr(expr, function, span, loop_depth, &sites)
        .IfLet{subj, ..} | .IsNone{subj} | .Matches{subj, ..} -> collect_cost_expr_consumed(subj, function, span, loop_depth, &sites)
        .And{left, right} -> {
            collect_cost_cond(left, function, span, loop_depth, &sites)
            collect_cost_cond(right, function, span, loop_depth, &sites)
        }
        .WithPrelude{prelude, cond} -> {
            collect_cost_stmts(prelude, function, span, loop_depth, &sites)
            collect_cost_cond(cond, function, span, loop_depth, &sites)
        }
    }
}

// Rust: crates/jet-codegen/src/Codegen/TIR/mod.rs:9435
fn collect_cost_stmts(stmts: @[TStmt], function: String, span: Span, loop_depth: USize, sites: &[TCostSite]) Never! {
    current_span := span
    loop stmt in stmts {
        if stmt == .SourceSpan(source_span) { current_span = source_span; next }
        collect_cost_stmt(stmt, function, current_span, loop_depth, &sites)
    }
}

// Rust: crates/jet-codegen/src/Codegen/TIR/mod.rs:9452
fn collect_cost_stmt(stmt: @TStmt, function: String, span: Span, loop_depth: USize, sites: &[TCostSite]) Never! {
    if stmt == {
        .Contract{contract} -> {
            collect_cost_expr(@contract.condition, function, span, loop_depth, &sites)
            collect_cost_expr(@contract.message, function, span, loop_depth, &sites)
        }
        .ContractScope{pre, body, post, ..} -> {
            loop contract in pre.iter().chain(post) {
                collect_cost_expr(@contract.condition, function, span, loop_depth, &sites)
                collect_cost_expr(@contract.message, function, span, loop_depth, &sites)
            }
            collect_cost_stmts(body, function, span, loop_depth, &sites)
        }
        .Let{init, ..} | .TupleDestructure{init, ..} | .StructDestructure{init, ..} | .ListDestructure{init, ..} -> collect_cost_expr(init, function, span, loop_depth, &sites)
        .RefutableBind{init, fallback, ..} -> {
            collect_cost_expr_consumed(init, function, span, loop_depth, &sites)
            collect_cost_stmts(fallback, function, span, loop_depth, &sites)
        }
        .GCEdit{index_temp, statement: stmt, ..} -> {
            if index_temp == Val(index) -> collect_cost_expr(index, function, span, loop_depth, &sites)
            collect_cost_stmt(stmt, function, span, loop_depth, &sites)
        }
        .SplitViews{owner, ..} -> { if owner == Val(value) -> collect_cost_expr(value, function, span, loop_depth, &sites) }
        .Assign{place, value, ..} -> {
            collect_cost_place(place, function, span, loop_depth, &sites)
            collect_cost_expr(value, function, span, loop_depth, &sites)
        }
        .Return{value, ..} -> { if value == Val(inner) -> collect_cost_expr(inner, function, span, loop_depth, &sites) }
        .ExprStmt{value: expr, ..} -> collect_cost_expr_consumed(expr, function, span, loop_depth, &sites)
        .TaskGroup{limit, body, ..} -> {
            if limit == Val(value) -> collect_cost_expr(value, function, span, loop_depth, &sites)
            collect_cost_stmts(body, function, span, loop_depth, &sites)
        }
        .DeferClose{close, ..} -> collect_cost_expr(close, function, span, loop_depth, &sites)
        .If{condition: cond, then_body, else_body, ..} -> {
            collect_cost_cond(cond, function, span, loop_depth, &sites)
            collect_cost_stmts(then_body, function, span, loop_depth, &sites)
            if else_body == Val(body) -> collect_cost_stmts(body, function, span, loop_depth, &sites)
        }
        .Loop{body, ..} -> collect_cost_stmts(body, function, span, loop_depth + 1, &sites)
        .While{condition: cond, body, ..} -> {
            collect_cost_expr(cond, function, span, loop_depth + 1, &sites)
            collect_cost_stmts(body, function, span, loop_depth + 1, &sites)
        }
        .CountedLoop{init, condition: cond, step, body, ..} -> {
            collect_cost_stmt(init, function, span, loop_depth, &sites)
            collect_cost_expr(cond, function, span, loop_depth + 1, &sites)
            if step == Val(value) -> collect_cost_stmt(value, function, span, loop_depth + 1, &sites)
            collect_cost_stmts(body, function, span, loop_depth + 1, &sites)
        }
        .Range{source, start, end, step, body, ..} -> {
            if source == Val(value) -> collect_cost_expr(value, function, span, loop_depth, &sites)
            collect_cost_expr(start, function, span, loop_depth, &sites)
            collect_cost_expr(end, function, span, loop_depth, &sites)
            if step == Val(value) -> collect_cost_expr(value, function, span, loop_depth, &sites)
            collect_cost_stmts(body, function, span, loop_depth + 1, &sites)
        }
        .BreakValue{value, ..} -> collect_cost_expr(value, function, span, loop_depth, &sites)
        .EnumMatch{scrutinee, arms, else_body, ..} -> {
            collect_cost_expr_consumed(scrutinee, function, span, loop_depth, &sites)
            loop arm in arms -> collect_cost_stmts(@arm.body, function, span, loop_depth, &sites)
            if else_body == Val(body) -> collect_cost_stmts(body, function, span, loop_depth, &sites)
        }
        .RangeSwitch{subject, arms, else_body, ..} -> {
            collect_cost_expr(subject, function, span, loop_depth, &sites)
            loop arm in arms -> collect_cost_stmts(@arm.body, function, span, loop_depth, &sites)
            collect_cost_stmts(else_body, function, span, loop_depth, &sites)
        }
        .IndexAssign{base, index, value, is_map, ..} -> {
            if is_map -> &sites.push(TCostSite{function: ~function, span: span, kind: TCostKind.CollectionCopyOnWrite, state: TCostState.SemanticRemainder, loop_depth: loop_depth})
            collect_cost_expr(base, function, span, loop_depth, &sites)
            collect_cost_expr(index, function, span, loop_depth, &sites)
            collect_cost_expr(value, function, span, loop_depth, &sites)
        }
        .IndexFieldAssign{value: assign, ..} -> {
            if assign.is_map -> &sites.push(TCostSite{function: ~function, span: span, kind: TCostKind.CollectionCopyOnWrite, state: TCostState.SemanticRemainder, loop_depth: loop_depth})
            collect_cost_expr(@assign.base, function, span, loop_depth, &sites)
            collect_cost_expr(@assign.index, function, span, loop_depth, &sites)
            collect_cost_expr(@assign.value, function, span, loop_depth, &sites)
        }
        .IndexHookAssign{base, index, value, ..} -> {
            collect_cost_expr(base, function, span, loop_depth, &sites)
            collect_cost_expr(index, function, span, loop_depth, &sites)
            collect_cost_expr(value, function, span, loop_depth, &sites)
        }
        .MathSwizzleAssign{base, value, ..} -> {
            collect_cost_expr(base, function, span, loop_depth, &sites)
            collect_cost_expr(value, function, span, loop_depth, &sites)
        }
        .ForIn{source, collection, step, body, ..} -> {
            collect_cost_expr(source, function, span, loop_depth, &sites)
            collect_cost_expr(collection, function, span, loop_depth, &sites)
            if step == Val(value) -> collect_cost_expr(value, function, span, loop_depth, &sites)
            collect_cost_stmts(body, function, span, loop_depth + 1, &sites)
        }
        .Inline{body, ..} | .DebugOnly{body, ..} | .Unsafe{body, ..} | .SentryPolicy{body, ..}
        | .Impure{body, ..} | .Region{body, ..} | .Live{body, ..} | .Shield{body, ..} -> collect_cost_stmts(body, function, span, loop_depth, &sites)
        .Reactive{executable, ..} -> collect_cost_lambda(executable, function, span, loop_depth, &sites)
        .ScopeMember{kind, body, ..} -> {
            if kind == .Timeout(timeout) -> collect_cost_expr(timeout, function, span, loop_depth, &sites)
            collect_cost_stmts(body, function, span, loop_depth, &sites)
        }
        .MixedSwitch{subject, arms, else_body, ..} -> {
            collect_cost_expr(subject, function, span, loop_depth, &sites)
            loop arm in arms {
                collect_cost_expr(@arm.condition, function, span, loop_depth, &sites)
                collect_cost_stmts(@arm.body, function, span, loop_depth, &sites)
            }
            if else_body == Val(body) -> collect_cost_stmts(body, function, span, loop_depth, &sites)
        }
        .Layout{body, ..} -> collect_cost_stmts(body, function, span, loop_depth, &sites)
        .ContextBlock{guards, body, ..} -> {
            loop guard in guards -> collect_cost_expr(@guard.value, function, span, loop_depth, &sites)
            collect_cost_stmts(body, function, span, loop_depth, &sites)
        }
        .Transact{body, ..} -> collect_cost_stmts(body, function, span, loop_depth, &sites)
        .SourceSpan(_) | .LineMarker(_) | .Break{..} | .Continue{..} | .Erased{..} -> {}
        .InvariantViolation{construct, span} -> panic("checked TIR contains invariant violation `{construct}` at {span:?}")
    }
}

// Rust: crates/jet-codegen/src/Codegen/TIR/mod.rs:9713
struct TCostCallable {
    module: USize
    declaration_span: Span
    source_span: Span?
    body_span: Span?
    // Generated bodies carry template offsets overlapping authored source.
    generated_body: Bool
    source_name: String?
    declaration_name: String
    method: Bool
    declaration_path: String
    label: String
    foreign: Bool
    type_parameterized: Bool
    root: Bool
}

// Rust: crates/jet-codegen/src/Codegen/TIR/mod.rs:9737
// One front-to-back item traversal per pass, not per callable.
struct CostFunctionIndex {
    functions: [(USize, Span): (@Func, Bool)]
}

// Rust: crates/jet-codegen/src/Codegen/TIR/mod.rs:9741
impl CostFunctionIndex {
    // Rust: crates/jet-codegen/src/Codegen/TIR/mod.rs:9742
    fn new(bundle: @ProgramBundle) -> CostFunctionIndex Never! {
        functions := [(USize, Span): (@Func, Bool)]{}
        loop (module, data) in bundle.modules -> index_cost_functions(@data.items, module, &functions)
        CostFunctionIndex{functions: ^functions}
    }
    // Rust: crates/jet-codegen/src/Codegen/TIR/mod.rs:9750
    fn get(self: @CostFunctionIndex, module: USize, span: Span) -> (@Func, Bool)? Never! {
        self.functions.get((module, span))
    }
}

// Rust: crates/jet-codegen/src/Codegen/TIR/mod.rs:9755
fn index_cost_functions(items: @[Item], module: USize, functions: &[(USize, Span): (@Func, Bool)]) Never! {
    // Rust: crates/jet-codegen/src/Codegen/TIR/mod.rs:9761
    fn add(functions: &[(USize, Span): (@Func, Bool)], module: USize, methods: @[Func], owner_is_generic: Bool) Never! {
        loop function in methods {
            key :: (module, function.name_span)
            if !functions.contains_key(key) -> _ :: &functions.add(key, (function, owner_is_generic))
        }
    }
    generic_owners := [String: Bool]{}
    loop item in items {
        if item == {
            .Struct(definition) if !definition.type_params.is_empty() -> { _ :: &generic_owners.add(definition.name, true) }
            .Enum(definition) if !definition.type_params.is_empty() -> { _ :: &generic_owners.add(definition.name, true) }
            else -> {}
        }
    }
    loop item in items {
        if item == {
            .Func(function) -> {
                key :: (module, function.name_span)
                if !functions.contains_key(key) -> _ :: &functions.add(key, (function, false))
            }
            .Struct(definition) -> {
                generic :: !definition.type_params.is_empty()
                add(&functions, module, @definition.methods, generic)
                loop implementation in definition.trait_impls -> add(&functions, module, @implementation.methods, generic)
            }
            .Enum(definition) -> {
                generic :: !definition.type_params.is_empty()
                add(&functions, module, @definition.methods, generic)
                loop implementation in definition.trait_impls -> add(&functions, module, @implementation.methods, generic)
            }
            .Impl(implementation) -> add(&functions, module, @implementation.methods, generic_owners.contains_key(implementation.type_name))
            .CodeModule(code_module) -> { if code_module.body == Val(body) -> index_cost_functions(body, module, &functions) }
            else -> {}
        }
    }
}

// Rust: crates/jet-codegen/src/Codegen/TIR/mod.rs:9829
fn collect_selected_cost_outputs(items: @[Item], selected: &[(USize, Span): Bool]) Never! {
    loop item in items {
        if item == {
            .Const(value) -> { if value.resolved_output == Val(output) { if output.selected -> _ :: &selected.add((output.module, output.definition), true) } }
            .CodeModule(module) -> { if module.body == Val(body) -> collect_selected_cost_outputs(body, &selected) }
            else -> {}
        }
    }
}

// Rust: crates/jet-codegen/src/Codegen/TIR/mod.rs:9852
struct CostCallableIndex {
    modules: [USize]
    by_span: [Span: [USize]]
    by_identity: [String: [USize]]
    bodies: [String: CostBodySpans]
}

// Rust: crates/jet-codegen/src/Codegen/TIR/mod.rs:9864
struct CostBodySpans {
    authored: CostSpanList
    generated: CostSpanList
}

// Rust: crates/jet-codegen/src/Codegen/TIR/mod.rs:9873
struct CostSpanList {
    spans: [(USize, USize, USize)]
    max_end: [USize]
}

// Rust: crates/jet-codegen/src/Codegen/TIR/mod.rs:9879
impl CostSpanList {
    // Rust: crates/jet-codegen/src/Codegen/TIR/mod.rs:9880
    fn finish(self: &CostSpanList) Never! {
        &self.spans.sort_unstable()
        max_end := 0 as USize
        self.max_end = [USize]{}
        loop (_, end, _) in self.spans {
            max_end = max_end.max(end)
            &self.max_end.push(max_end)
        }
    }
    // Rust: crates/jet-codegen/src/Codegen/TIR/mod.rs:9895
    fn containing(self: @CostSpanList, start: USize, end: USize, out: &[(USize, USize)]) Never! {
        position := self.spans.partition_point(fn(span) { span.0 <= start })
        loop position > 0 {
            position -= 1
            if self.max_end[position] < end -> break
            (span_start, span_end, index) :: self.spans[position]
            if end <= span_end -> &out.push((index, span_end.saturating_sub(span_start)))
        }
    }
}

// Rust: crates/jet-codegen/src/Codegen/TIR/mod.rs:9910
impl CostCallableIndex {
    // Rust: crates/jet-codegen/src/Codegen/TIR/mod.rs:9911
    fn new(bundle: @ProgramBundle, callables: @[TCostCallable]) -> CostCallableIndex Never! {
        by_span := [Span: [USize]]{}
        by_identity := [String: [USize]]{}
        bodies := [String: CostBodySpans]{}
        modules := [USize]{}
        loop (index, callable) in callables {
            &modules.push(callable.module)
            &by_span.entry(callable.declaration_span).or_insert([USize]{}).push(index)
            if callable_semantic_identity(bundle, callable) == Val(identity) -> &by_identity.entry(^identity).or_insert([USize]{}).push(index)
            span :: callable.body_span ?? next
            paths := [String]{}
            if bundle.name_ledger.module_path(callable.module) == Val(path) -> &paths.push(path.to_string())
            if bundle.modules.get(callable.module) == Val(module) {
                if !paths.iter().any(fn(path) { path == module.display.as_str() }) -> &paths.push(module.display.as_str().to_string())
            }
            loop path in paths {
                spans := &bodies.entry(path).or_insert(CostBodySpans{authored: CostSpanList{spans: [], max_end: []}, generated: CostSpanList{spans: [], max_end: []}})
                if callable.generated_body -> &spans.generated.spans.push((span.start, span.end, index))
                else -> &spans.authored.spans.push((span.start, span.end, index))
            }
        }
        loop spans in &bodies.values_mut() {
            &spans.authored.finish()
            &spans.generated.finish()
        }
        CostCallableIndex{modules: ^modules, by_span: ^by_span, by_identity: ^by_identity, bodies: ^bodies}
    }
    // Rust: crates/jet-codegen/src/Codegen/TIR/mod.rs:9955
    fn declared(self: @CostCallableIndex, module: USize, span: Span) -> USize? Never! {
        candidates :: self.by_span.get(span) ?? return None
        loop index in candidates { if self.modules[index] == module -> return Val(index) }
        None
    }
    // Rust: crates/jet-codegen/src/Codegen/TIR/mod.rs:9963
    fn declared_at(self: @CostCallableIndex, span: Span) -> @[USize] Never! {
        self.by_span.get(span) ?? @[]
    }
    // Rust: crates/jet-codegen/src/Codegen/TIR/mod.rs:9967
    fn with_identity(self: @CostCallableIndex, identity: String) -> @[USize] Never! {
        self.by_identity.get(identity) ?? @[]
    }
}

// Rust: crates/jet-codegen/src/Codegen/TIR/mod.rs:9972
fn cost_callable_is_root(bundle: @ProgramBundle, declaration: @NameDeclaration, function: @Func?, app_graph: @AppGraph?, selected_outputs: @[(USize, Span): Bool]) -> Bool Never! {
    function :: function ?? return false
    if function.is_job || function.web_marker == Val(WebPartitionMarker.WasmExport)
        || (declaration.module == bundle.entry && function.name == "run")
        || selected_outputs.contains_key((declaration.module, declaration.span)) -> return true
    if declaration.module != bundle.entry -> return false
    graph :: app_graph ?? return false
    graph.routes.iter().any(fn(route) { route.handler == function.name })
        || graph.actions.iter().any(fn(action) { action.handler == function.name })
        || graph.mounts.iter().any(fn(mount) { mount.handler == function.name })
}

// Rust: crates/jet-codegen/src/Codegen/TIR/mod.rs:10010
fn cost_callables(bundle: @ProgramBundle, app_graph: @AppGraph?) -> [TCostCallable] Never! {
    functions :: CostFunctionIndex.new(bundle)
    selected_outputs := [(USize, Span): Bool]{}
    loop module in bundle.modules -> collect_selected_cost_outputs(@module.items, &selected_outputs)
    callables := [TCostCallable]{}
    loop declaration in bundle.name_ledger.declarations() {
        if declaration.kind != "function" && declaration.kind != "method" && declaration.kind != "extern" -> next
        function :: if declaration.kind == "extern" -> None else -> functions.get(declaration.module, declaration.span)
        if declaration.kind != "extern" && function.is_none() -> next
        source_span := None as Span?
        body_span := None as Span?
        source_name := None as String?
        inline_foreign := false
        type_parameterized := false
        generated_body := false
        source_function := None as @Func?
        if function == Val((value, owner_is_generic)) {
            inline_foreign = value.inline_foreign.is_some()
            source_span = Val(value.span)
            if !inline_foreign -> body_span = Val(value.span)
            source_name = Val(~value.name)
            type_parameterized = owner_is_generic || !value.type_params.is_empty()
            generated_body = value.compiler_generated
            source_function = Val(value)
        }
        root :: cost_callable_is_root(bundle, declaration, source_function, app_graph, @selected_outputs)
        module_label :: if bundle.modules.get(declaration.module) == Val(module) -> module.display.as_str() else -> "<unknown module>"
        &callables.push(TCostCallable{module: declaration.module, declaration_span: declaration.span, source_span: source_span, body_span: body_span, generated_body: generated_body, source_name: ^source_name, declaration_name: ~declaration.name, method: declaration.kind == "method", declaration_path: ~declaration.path, label: "{module_label}:{declaration.path}", foreign: declaration.kind == "extern" || inline_foreign, type_parameterized: type_parameterized, root: root})
    }
    callables
}

// Rust: crates/jet-codegen/src/Codegen/TIR/mod.rs:10083
fn cost_module_path_matches(bundle: @ProgramBundle, module: USize, path: String) -> Bool Never! {
    if bundle.name_ledger.module_path(module) == Val(candidate) { if candidate == path -> return true }
    if bundle.modules.get(module) == Val(candidate) -> candidate.display.as_str() == path else -> false
}

// Rust: crates/jet-codegen/src/Codegen/TIR/mod.rs:10096
fn cost_call_graph(bundle: @ProgramBundle, callables: @[TCostCallable], index: @CostCallableIndex) -> [[USize]] Never! {
    callees := [[USize]]{}
    loop _ in 0..callables.len() -> &callees.push([USize]{})
    loop ((source, start, end), reference) in bundle.name_ledger.references() {
        if !is_checked_function_reference(reference) -> next
        target :: callable_for_reference(bundle, callables, index, reference) ?? next
        loop caller in callables_containing_reference(index, source, start, end) -> &callees[caller].push(target)
    }
    loop (caller, target) in checked_core_source_call_edges(bundle, callables, index) -> &callees[caller].push(target)
    callees
}

// Rust: crates/jet-codegen/src/Codegen/TIR/mod.rs:10119
fn reachable_from_roots(callees: @[[USize]], callables: @[TCostCallable]) -> [Bool] Never! {
    reachable := [Bool]{}
    pending := [USize]{}
    loop (index, callable) in callables {
        &reachable.push(callable.root)
        if callable.root -> &pending.push(index)
    }
    loop pending.len() > 0 {
        caller :: &pending.pop() ?? break
        loop target in callees[caller] {
            if !reachable[target] { reachable[target] = true; &pending.push(target) }
        }
    }
    reachable
}

// Rust: crates/jet-codegen/src/Codegen/TIR/mod.rs:10138
fn reachable_cost_callables(bundle: @ProgramBundle, callables: @[TCostCallable]) -> [Bool] Never! {
    index :: CostCallableIndex.new(bundle, callables)
    graph :: cost_call_graph(bundle, callables, @index)
    reachable_from_roots(@graph, callables)
}

// Rust: crates/jet-codegen/src/Codegen/TIR/mod.rs:10143
fn core_source_module_indices(bundle: @ProgramBundle) -> [USize: Bool] Never! {
    indices := [USize: Bool]{}
    loop (index, module) in bundle.modules {
        public_source :: core_source_modules().iter().any(fn(source) { source.alias == module.alias && source.path == module.display.as_str() })
        private_source :: CORE_PRIVATE_SOURCE_PARTS.iter().any(fn(part) { part.source.alias == module.alias && part.source.path == module.display.as_str() })
        if public_source || private_source -> _ :: &indices.add(index, true)
    }
    indices
}

// Rust: crates/jet-codegen/src/Codegen/TIR/mod.rs:10165
fn callable_semantic_identity(bundle: @ProgramBundle, callable: @TCostCallable) -> String? Never! {
    module :: bundle.name_ledger.module_identity(callable.module) ?? return None
    Val("{module}::{callable.declaration_name}")
}

// Rust: crates/jet-codegen/src/Codegen/TIR/mod.rs:10179
fn callables_containing_reference(index: @CostCallableIndex, source: String, start: USize, end: USize) -> [USize] Never! {
    bodies :: index.bodies.get(source) ?? return []
    found := [(USize, USize)]{}
    bodies.generated.containing(start, end, &found)
    containing := [USize]{}
    loop (callable, _) in found -> &containing.push(callable)
    &containing.sort_unstable()
    &found.clear()
    bodies.authored.containing(start, end, &found)
    // Narrowest authored body wins; callable order breaks width ties.
    best := None as (USize, USize)?
    loop (callable, width) in found {
        candidate :: (width, callable)
        if best == Val(previous) { if candidate < previous -> best = Val(candidate) }
        else -> best = Val(candidate)
    }
    if best == Val((_, callable)) -> &containing.push(callable)
    containing
}

// Rust: crates/jet-codegen/src/Codegen/TIR/mod.rs:10204
fn checked_function_reference_identity(reference: @NameReference) -> String? Never! {
    identity :: reference.semantic_identity ?? return None
    if reference.kind == {
        "function" -> Val(identity.strip_prefix("fn:") ?? identity)
        "semantic" -> identity.strip_prefix("fn:")
        else -> None
    }
}

// Rust: crates/jet-codegen/src/Codegen/TIR/mod.rs:10215
fn is_checked_function_reference(reference: @NameReference) -> Bool Never! {
    reference.kind == "function" || checked_function_reference_identity(reference).is_some()
}

// Rust: crates/jet-codegen/src/Codegen/TIR/mod.rs:10219
fn callable_for_reference(bundle: @ProgramBundle, callables: @[TCostCallable], index: @CostCallableIndex, reference: @NameReference) -> USize? Never! {
    if reference.kind == "semantic" {
        identity :: checked_function_reference_identity(reference) ?? return None
        return index.with_identity(identity).first()
    }
    if reference.kind != "function" -> return None
    declared :: index.declared_at(reference.def_span)
    if checked_function_reference_identity(reference) == Val(identity) {
        loop callable in declared {
            if cost_module_path_matches(bundle, callables[callable].module, reference.module_path)
                && callable_semantic_identity(bundle, @callables[callable]) == Val(identity) -> return Val(callable)
        }
    }
    loop callable in declared {
        if cost_module_path_matches(bundle, callables[callable].module, reference.module_path) -> return Val(callable)
    }
    None
}

// Rust: crates/jet-codegen/src/Codegen/TIR/mod.rs:10248
fn checked_core_module_path_from_receiver(receiver: @Expr, core_imports: @[String: String], name_ledger: @NameLedger, source_path: String) -> String? Never! {
    if receiver == {
        .Ident(alias, span) -> {
            reference :: name_ledger.reference(source_path, span.start, span.end) ?? return None
            if reference.kind == "import_alias" -> core_imports.get(alias).map(fn(value) { ~value }) else -> None
        }
        .Field(base, leaf, _) -> {
            module :: checked_core_module_path_from_receiver(base, core_imports, name_ledger, source_path) ?? return None
            submodule :: "{module}.{leaf}"
            if is_known_core_module(submodule) -> Val(submodule) else -> None
        }
        else -> None
    }
}

// Rust: crates/jet-codegen/src/Codegen/TIR/mod.rs:10276
fn checked_core_source_signature(module: String, method: String, resolved_return: @Type?, signatures: @[(String, String): CoreSourceFunctionSignature]) -> @CoreSourceFunctionSignature? Never! {
    if resolved_return.is_none() || !core_source_owns(module, method) -> return None
    signatures.get((module, method))
}

// Rust: crates/jet-codegen/src/Codegen/TIR/mod.rs:10293
fn checked_local_function_declaration_span(module: USize, name: String, resolved_return: @Type?, declaration: @NameDeclaration?) -> Span? Never! {
    declaration :: declaration ?? return None
    if resolved_return.is_some() && declaration.module == module && declaration.name == name && declaration.kind == "function" -> Val(declaration.span) else -> None
}

// Rust: crates/jet-codegen/src/Codegen/TIR/mod.rs:10307
fn checked_local_function_call_target(bundle: @ProgramBundle, index: @CostCallableIndex, module: USize, call: @Call) -> USize? Never! {
    declaration_span :: checked_local_function_declaration_span(module, call.name, call.resolved_ret.as_ref(), bundle.name_ledger.declaration(module, call.name)) ?? return None
    index.declared(module, declaration_span)
}

// Rust: crates/jet-codegen/src/Codegen/TIR/mod.rs:10325
// Direct checked Core syntax need not leave a function NameReference.
fn checked_core_source_call_edges(bundle: @ProgramBundle, callables: @[TCostCallable], index: @CostCallableIndex) -> [(USize, USize)] Never! {
    signatures :: core_source_sig_map(bundle)
    core_imports := [[String: String]]{}
    loop module in 0..bundle.modules.len() -> &core_imports.push(core_import_map(bundle, module))
    core_modules :: core_source_module_indices(bundle)
    functions :: CostFunctionIndex.new(bundle)
    edges := [(USize, USize)]{}
    loop (caller_index, callable) in callables {
        (function, _) :: functions.get(callable.module, callable.declaration_span) ?? next
        imports :: core_imports.get(callable.module) ?? next
        source_path :: bundle.name_ledger.module_path(callable.module) ?? next
        loop statement in function.body {
            statement.for_each_expr(fn(expression: @Expr) {
                if expression == {
                    .Call(call) if core_modules.contains_key(callable.module) -> {
                        if checked_local_function_call_target(bundle, index, callable.module, call) == Val(target) -> &edges.push((caller_index, target))
                    }
                    .MethodCall{receiver, method, resolved_ret, ..} -> {
                        module :: checked_core_module_path_from_receiver(receiver, imports, @bundle.name_ledger, source_path) ?? return
                        signature :: checked_core_source_signature(module, method, resolved_ret.as_ref(), @signatures) ?? return
                        module_identity :: signature.module_identity.as_str()
                        if bundle.name_ledger.module_identity(callable.module) == Val(module_identity) -> return
                        target_identity :: "{module_identity}::{method}"
                        loop target in index.with_identity(target_identity) {
                            if core_modules.contains_key(callables[target].module) {
                                &edges.push((caller_index, target))
                                break
                            }
                        }
                    }
                    else -> {}
                }
            })
        }
    }
    &edges.sort_unstable()
    &edges.dedup()
    edges
}
