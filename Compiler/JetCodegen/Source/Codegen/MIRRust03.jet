    fn scope_operation_expression(self: RustEmitter, function: MirFunction, scope_id: MirScopeId, enter: Bool) -> String {
        root :: self.config.root_prefix
        if self.scope_row(function, scope_id) == {
            Val(scope) -> {
                if scope.kind == {
                    .Shield if enter -> return "jet_scheduler_shield_enter()"
                    .Shield -> return "jet_scheduler_shield_leave()"
                    .Context if enter -> {
                        if scope.deadline == {
                            Val(deadline) -> {
                                value :: self.value_transfer(deadline)
                                value :: if self.value_type(function, deadline).kind() == { .Int -> self.native_int_argument(value, None), else -> value }
                                return "jet_ctx_push_deadline({value})"
                            }
                            None -> {}
                        }
                    }
                    .Context -> return "/* MIR context scope exit {scope_id.0} */"
                    .Unsafe if enter -> {
                        gate :: function.unsafe_gate
                        file :: scope.facts.get("sentry_file").or_else(() -> gate.map(gate -> gate.file)).unwrap_or("")
                        line :: scope.facts.get("sentry_line").and_then(line -> line.parse::<U32>().ok()).or_else(() -> gate.map(gate -> gate.line)).unwrap_or(0)
                        enabled :: scope.facts.get("sentry_enabled").and_then(value -> value.parse::<Bool>().ok()).or_else(() -> gate.map(gate -> gate.enabled)).unwrap_or(true)
                        fenced :: scope.facts.get("sentry_fenced").and_then(value -> value.parse::<Bool>().ok()).or_else(() -> gate.map(gate -> gate.fenced)).unwrap_or(false)
                        reason :: scope.name.or_else(() -> gate.map(gate -> gate.reason)).unwrap_or("")
                        constructor :: if fenced { "jet_sentry_fenced_scope" } else { "jet_sentry_scope" }
                        return "jet_mem::{constructor}({enabled}, {file:?}, {line}, {reason:?})"
                    }
                    .Policy if enter -> {
                        enabled :: scope.facts.get("sentry_enabled").and_then(value -> value.parse::<Bool>().ok()).unwrap_or(false)
                        return "jet_mem::jet_sentry_policy_scope({enabled})"
                    }
                    else -> {}
                }
            }
            None -> {}
        }
        member :: self.test_scope_member(function, scope_id)
        if enter {
            return if member == {
                Val(.ExpectFail{expected_code}) -> {
                    expected :: expected_code.map(code -> "Some({code:?})").unwrap_or("None")
                    "{root}jet_test_expect_fail_enter_scope({scope_id.0}, {expected})"
                }
                Val(.Timeout{duration}) -> "{root}jet_test_timeout_enter({scope_id.0}, ({self.value_owned(duration)}).ns)"
                else -> "/* MIR scope enter {scope_id.0} */"
            }
        }
        if member == {
            Val(.ExpectFail{expected_code}) -> {
                expected :: expected_code.map(code -> "Some({code:?})").unwrap_or("None")
                "if {root}jet_test_expect_fail_leave_scope({scope_id.0}).is_none() {{ {root}jet_test_expect_fail_unmet({expected}); }}"
            }
            Val(.Timeout{..}) -> "if let Some((__jet_elapsed, __jet_limit)) = {root}jet_test_timeout_leave({scope_id.0}) {{ if __jet_elapsed > __jet_limit {{ {root}jet_test_timeout_failure(__jet_elapsed, __jet_limit); }} }}"
            Val(.Skip{whole_test}) -> "{root}jet_test_skip_scope({whole_test})"
            else -> "/* MIR scope exit {scope_id.0} */"
        }
    }
