        &entry.insert(function.entry, [])
        pending := [function.entry]
        positions :: block_positions(function)
        loop {
            block_id :: &pending.pop() else { break }
            position :: positions.get(block_id) else { continue }
            block :: function.blocks[position]
            active := entry.get(block_id).unwrap_or([])
            loop instruction in block.instructions {
                if instruction.operation == {
                    .ScopeEnter{scope, ..} if self.test_scope_member(function, scope).is_some() -> &active.push(scope)
                    .ScopeExit{scope} if self.test_scope_member(function, scope).is_some() -> {
                        if active.rposition(value -> value == scope) == { Val(index) -> &active.remove(index), None -> {} }
                    }
                    else -> {}
                }
            }
            &exits.insert(block_id, active.clone())
            loop target in block.terminator.targets() {
                if entry.get(target) == {
                    None -> { &entry.insert(target, active.clone()); &pending.push(target) }
                    Val(previous) if previous == active -> {}
                    Val(previous) -> {
                        merged := [MirScopeId]{}
                        loop (left, right) in previous.zip(active) {
                            if left != right -> break
                            &merged.push(left)
                        }
                        if merged != previous { &entry.insert(target, ^merged); &pending.push(target) }
                    }
                }
            }
        }
        ^exits
    }
