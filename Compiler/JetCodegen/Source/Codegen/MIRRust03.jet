    // Length-preserving write windows propagate through callers to a fixed point.
    fn collect_window_params(program: MirProgram) -> Set<(MirFunctionId, USize)> {
        positions := [MirFunctionId: USize]{}
        loop (position, function) in program.functions.enumerate() {
            &positions.entry(function.id).or_insert(position)
        }
        windows := Set<(MirFunctionId, USize)>{}
        loop {
            before :: windows.len()
            loop function in program.functions {
                lookups := None as ([MirPlaceId: MirPlace], [MirValueId: USize])?
                loop block in function.blocks {
                    loop instruction in block.instructions {
                        if instruction.operation == {
                            .Call{callee, args, ..} -> {
                                target :: if callee == {
                                    .User(id) | .Associated{function: id, ..} | .Method{function: id, ..} -> id
                                    else -> continue
                                }
                                position :: positions.get(target) else { continue }
                                target_function :: program.functions[position]
                                loop (position, arg) in args.enumerate() {
                                    if arg.access != MirAccess.Write -> continue
                                    if lookups.is_none() {
                                        places := [MirPlaceId: MirPlace]{}
                                        loop place in function.places -> &places.entry(place.id).or_insert(place)
                                        parameters := [MirValueId: USize]{}
                                        loop definition_block in function.blocks {
                                            loop definition in definition_block.instructions {
                                                if (definition.result, definition.operation) == {
                                                    (Val(result), .Parameter{index, ..}) -> &parameters.entry(result).or_insert(index)
                                                    else -> {}
                                                }
                                            }
                                        }
                                        lookups = Val((^places, ^parameters))
                                    }
                                    (places, parameters) :: lookups.unwrap()
                                    place :: arg.place.and_then(id -> places.get(id)) else { continue }
                                    window :: if (place.projections.last(), place.base) == {
                                        (Val(.Range{..}), _) -> true
                                        (None, .Parameter(value)) -> parameters.get(value).is_some_and(index -> windows.contains((function.id, index)))
                                        else -> false
                                    }
                                    if window {
                                        if target_function.params.get(position) == {
                                            Val(param) -> {
                                                if param.ty.kind() == { .List(_) -> true, else -> false } {
                                                    &windows.insert((target, param.index))
                                                }
                                            }
                                            None -> {}
                                        }
                                    }
                                }
                            }
                            else -> {}
                        }
                    }
                }
            }
            if windows.len() == before -> return ^windows
        }
    }
