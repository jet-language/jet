    // Completion of the constructor across the source packet boundary.
    fn finish_new(emitter: &RustEmitter) -> {
        loop (position, function) in emitter.program.functions.enumerate() {
            &emitter.function_positions.entry(function.id).or_insert(position)
        }
        loop (position, row) in emitter.program.fields.enumerate() {
            &emitter.field_positions.entry(row.id).or_insert(position)
        }
        loop function in emitter.program.functions {
            roots :: emitter.plan_partial_moves(function)
            if !roots.is_empty() -> &emitter.partial_moves.insert(function.id, roots)
            shared :: emitter.plan_shared_capture_locals(function)
            if !shared.is_empty() -> &emitter.shared_capture_locals.insert(function.id, shared)
            moves :: emitter.plan_move_facts(function)
            if !moves.single_use.is_empty() || !moves.payload_groups.is_empty() {
                &emitter.move_facts.insert(function.id, moves)
            }
        }
    }
