    fn collect_type_fields(def: MirTypeDef, fields: &[MirFieldId: String]) -> {
        leaf :: def.key.rsplit_once("::").map(pair -> pair.1)
            .or_else(() -> def.key.rsplit_once('.').map(pair -> pair.1)).unwrap_or(def.key)
