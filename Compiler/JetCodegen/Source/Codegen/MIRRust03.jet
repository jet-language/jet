//RS             | MirTypeKind::String
//RS             | MirTypeKind::Char
//RS             | MirTypeKind::Float32
//RS             | MirTypeKind::IntN { .. }
//RS             | MirTypeKind::InlineRange { .. } => true,
//RS             MirTypeKind::List(inner)
//RS             | MirTypeKind::Option(inner)
//RS             | MirTypeKind::FixedList { elem: inner, .. } => {
//RS                 self.property_param_generator_supported(inner)
//RS             }
//RS             MirTypeKind::Map { .. }
//RS             | MirTypeKind::Shared(_)
//RS             | MirTypeKind::Result { .. }
//RS             | MirTypeKind::Fn(_)
//RS             | MirTypeKind::SendFn { .. }
//RS             | MirTypeKind::Apply { .. }
