    fn generic_params(self: RustEmitter, function: MirFunction) -> String {
        declared := function.generic_params.clone()
        if self.history_runtime_metadata_enabled() && function.form == MirFunctionForm.TopLevel {
            needed := Set<String>{}
            loop capture in function.capture_params -> &needed.extend(self.history_type_parameters(capture.ty))
            loop param in function.params -> &needed.extend(self.history_type_parameters(param.ty))
            &needed.extend(self.history_type_parameters(function.return_type))
            children := Set<MirFunctionId>{function.id}
            parents := Set<MirFunctionId>{}
            closure_parents :: self.closure_parents()
            loop {
                positions := Set<USize>{}
                loop child in children {
                    loop position in closure_parents.get(child).unwrap_or([]) {
                        if !parents.contains(self.program.functions[position].id) -> &positions.insert(position)
                    }
                }
                if positions.is_empty() -> break
                loop position in positions.to_list().sorted() {
                    parent :: self.program.functions[position]
                    loop param in parent.generic_params {
                        if needed.contains(param.name) && !declared.any(own -> own.name == param.name) -> &declared.push(param)
                    }
                    &parents.insert(parent.id)
                    &children.insert(parent.id)
                }
            }
        }
        params :: declared.map(param -> {
            bounds := param.bounds.map(bound -> self.trait_nominal_name(bound))
            if self.history_runtime_metadata_enabled() -> &bounds.push("'static")
            name :: mangle(param.name)
            if bounds.is_empty() { name } else { "{name}: {bounds.join(\" + \")}" }
        })
        if params.is_empty() { "" } else { "<{params.join(\", \")}>" }
    }
    // Rust: crates/jet-codegen/src/Codegen/MIRRust.rs:16447
    fn closure_parents(self: RustEmitter) -> [MirFunctionId: [USize]] {
        self.closure_parents.get_or_init(() -> {
            parents := [MirFunctionId: [USize]]{}
            loop (position, parent) in self.program.functions.enumerate() {
                loop block in parent.blocks {
                    loop instruction in block.instructions {
                        if instruction.operation == {
                            .Closure{function, ..} -> {
                                rows :: &parents.entry(function).or_default()
                                if rows.last() != Val(position) -> &rows.push(position)
                            }
                            else -> {}
                        }
                    }
                }
            }
            ^parents
        }) // GATE #4494: retained once-initialized shared lookup.
    }
