// Typed expression lowering preserves checked MIR types and ownership facts.
// Every produced MIR value retains its checked type, span, and ownership.


struct JetCodegenTraitMethod {
    pub trait_key: String
    pub method: TTraitMethod
}

fn jet_codegen_lower_unary(op: TUnaryOp) -> MirUnaryOp Never! {
    if op == {
        .Neg -> MirUnaryOp.Neg
        .Not -> MirUnaryOp.Not
    }
}

fn jet_codegen_lower_binary(op: TBinaryOp) -> MirBinaryOp Never! {
    if op == {
        .Add -> MirBinaryOp.Add
        .Sub -> MirBinaryOp.Sub
        .Mul -> MirBinaryOp.Mul
        .Div -> MirBinaryOp.Div
        .FloorDiv -> MirBinaryOp.FloorDiv
        .Mod -> MirBinaryOp.Mod
        .Rem -> MirBinaryOp.Rem
        .Pow -> MirBinaryOp.Pow
        .BitAnd -> MirBinaryOp.BitAnd
        .BitOr -> MirBinaryOp.BitOr
        .BitXor -> MirBinaryOp.BitXor
        .Shl -> MirBinaryOp.Shl
        .Shr -> MirBinaryOp.Shr
        .Eq -> MirBinaryOp.Eq
        .Ne -> MirBinaryOp.Ne
        .Lt -> MirBinaryOp.Lt
        .Gt -> MirBinaryOp.Gt
        .Le -> MirBinaryOp.Le
        .Ge -> MirBinaryOp.Ge
        .Compare -> MirBinaryOp.Compare
        .And -> MirBinaryOp.And
        .Or -> MirBinaryOp.Or
    }
}

fn jet_codegen_lower_string_format(format: TStrFormat) -> MirStringFormat Never! {
    if format == {
        .Display -> MirStringFormat.Display
        .Debug -> MirStringFormat.Debug
        .Pretty -> MirStringFormat.Pretty
        .Fixed(digits) -> MirStringFormat.Fixed{digits: digits}
        .Grouped(digits) -> MirStringFormat.Grouped{digits: digits}
        .Hex(digits) -> MirStringFormat.Hex{digits: digits}
        .Pad(width, fill) -> MirStringFormat.Pad{width: width, fill: fill}
        .PadLeft(width, fill) -> MirStringFormat.PadLeft{width: width, fill: fill}
        .Sci(digits) -> MirStringFormat.Sci{digits: digits}
        .Percent(digits) -> MirStringFormat.Percent{digits: digits}
        .Bin -> MirStringFormat.Bin
        .Oct -> MirStringFormat.Oct
        .Unit(format) -> {
            if format == {
                .Symbol -> MirStringFormat.Unit{format: MirUnitFormat.Symbol}
                .Name -> MirStringFormat.Unit{format: MirUnitFormat.Name}
                else -> MirStringFormat.Unit{format: MirUnitFormat.Bare}
            }
        }
    }
}

fn jet_codegen_exact_int_type(ty: Type) -> Bool Never! {
    if ty == {
        .Int -> true
        .InlineRange(base, _, _) -> jet_codegen_exact_int_type(base)
        .Tagged(_, inner) -> jet_codegen_exact_int_type(inner)
        else -> false
    }
}

fn jet_codegen_fixed_width(ty: Type) -> String? {
    if ty == {
        .IntN(signed, bits) -> {
            prefix := if signed == {
                true -> "i"
                else -> "u"
            }
            if bits == {
                8 -> Val("{prefix}8")
                16 -> Val("{prefix}16")
                32 -> Val("{prefix}32")
                64 -> Val("{prefix}64")
                else -> None
            }
        }
        .InlineRange(base, _, _) -> jet_codegen_fixed_width(base)
        .Tagged(_, inner) -> jet_codegen_fixed_width(inner)
        else -> None
    }
}

fn jet_codegen_binary_prelude_member(op: TBinaryOp) -> String? {
    if op == {
        .Add -> Val("add")
        .Sub -> Val("sub")
        .Mul -> Val("mul")
        .Div -> Val("div")
        .Rem -> Val("rem")
        .FloorDiv -> Val("floor_div")
        .Mod -> Val("mod")
        .Pow -> Val("pow")
        .Shl -> Val("shl")
        .Shr -> Val("shr")
        .BitAnd -> Val("bit_and")
        .BitOr -> Val("bit_or")
        .BitXor -> Val("bit_xor")
        else -> None
    }
}

fn jet_codegen_add_binary_prelude(builder: &JetCodegenBuilder, member: String, symbol: String, arity: Int, call_effect: Effect?) -> MirPreludeCallId Never! {
    borrow_mask := [Bool]{}
    arity_index := 0
    loop arity_index < arity {
        &borrow_mask.push(false)
        arity_index += 1
    }
    mask_names := [String]{}
    loop item in borrow_mask {
        if item { &mask_names.push("true") } else { &mask_names.push("false") }
    }
    effect_identity := "None"
    if call_effect != None {
        effect_name :: jet_codegen_core_effect_name(call_effect) ?? panic("checked binary Prelude effect lost its canonical name")
        effect_identity = "Some({effect_name})"
    }
    identity := "Overflow:core.numeric:{member}:{symbol}:{arity}:{arity}:[{mask_names.join(", ")}]:{effect_identity}:Infallible:Value"
    id := MirPreludeCallId{value: stable_id("mir-prelude-call", identity)}
    row := MirPreludeCall{
        id: id,
        family: MirPreludeFamily.Overflow,
        module_name: "core.numeric",
        member: member,
        symbol: MirSymbol.Prelude{name: symbol},
        signature: MirCallSignature{arity: arity, max_arity: arity, borrow_mask: borrow_mask},
        effect_kind: call_effect,
        fallibility: MirCallFallibility.Infallible,
        abi: MirPreludeAbi.Value,
        authority: None,
        db_metadata: None,
    }
    jet_codegen_intern_prelude_call(&builder, row)
}

fn jet_codegen_binary_dispatch(builder: &JetCodegenBuilder, op: TBinaryOp, overflow: Bool, operand_type: Type, span: Span, line: Int) -> MirBinaryDispatch Never! {
    if op == TBinaryOp.And | TBinaryOp.Or -> return MirBinaryDispatch.Primitive
    if jet_codegen_exact_int_type(operand_type) {
        member :: jet_codegen_binary_prelude_member(op) ?? return MirBinaryDispatch.Primitive
        symbol := "jet_std::jet_int_{member}"
        arity := 2
        if op == TBinaryOp.Div | TBinaryOp.Rem | TBinaryOp.FloorDiv | TBinaryOp.Mod | TBinaryOp.Pow | TBinaryOp.Shl | TBinaryOp.Shr -> arity = 4
        call_effect := None
        if arity == 4 -> call_effect = Val(Effect.Panic)
        call := jet_codegen_add_binary_prelude(&builder, member, symbol, arity, call_effect)
        location := Val(MirPanicLoc{file: mir_source_file_id(builder.function.source_file), line: line, column: 0})
        return MirBinaryDispatch.Prelude{call: call, location: location}
    }
    width := jet_codegen_fixed_width(operand_type)
    if width != None {
        if !overflow && !(op == TBinaryOp.Rem | TBinaryOp.FloorDiv | TBinaryOp.Mod | TBinaryOp.Pow) -> return MirBinaryDispatch.Primitive
        member :: jet_codegen_binary_prelude_member(op) ?? return MirBinaryDispatch.Primitive
        if op == TBinaryOp.BitAnd | TBinaryOp.BitOr | TBinaryOp.BitXor -> return MirBinaryDispatch.Primitive
        width_name :: width ?? "i64"
        route_member := "{width_name}.trap.{member}"
        symbol := "jet_{width_name}_trap_{member}"
        call := jet_codegen_add_binary_prelude(&builder, route_member, symbol, 4, Val("Panic"))
        location := MirPanicLoc{file: mir_source_file_id(builder.function.source_file), line: line, column: 0}
        return MirBinaryDispatch.Prelude{call: call, location: Val(location)}
    }
    MirBinaryDispatch.Primitive
}

fn jet_codegen_union_member_tag_name(raw: String) -> String Never! {
    safe := true
    loop byte in raw.bytes() {
        value := Int.from_u8(byte)
        if {
            value < 128 && !((value >= 48 && value <= 57) || (value >= 65 && value <= 90) || (value >= 97 && value <= 122) || value == 95) -> {
                safe = false
                break
            }
            value >= 128 -> {
                safe = false
                break
            }
            else -> {}
        }
    }
    if safe && raw.len() > 0 -> return raw
    bytes := [U8]{77, 95}
    loop byte in raw.bytes() {
        value := Int.from_u8(byte)
        if {
            (value >= 48 && value <= 57) || (value >= 65 && value <= 90) || (value >= 97 && value <= 122) -> &bytes.push(byte)
            value < 128 -> &bytes.push(U8{95})
            value >= 192 -> &bytes.push(U8{95})
            else -> {}
        }
    }
    String.from_bytes(bytes) ?? "M_"
}

fn jet_codegen_union_member_tag(ty: Type) -> String Never! {
    jet_codegen_union_member_tag_name(type_name(ty))
}

fn jet_codegen_is_move_kind(kind: TExprKind) -> Bool Never! {
    if kind == {
        .Move(_) -> true
        else -> false
    }
}

fn jet_codegen_trait_bound_is_declared(modules: [SemaGraphModuleResult], name: String, preferred_module_identity: String) -> Bool Never! {
    jet_codegen_resolve_trait_ref(modules, name, preferred_module_identity) != None
}

fn jet_codegen_require_trait_box_target(target: Type, builder: &JetCodegenBuilder) Never! {
    bounds := if target == {
        .TraitObject(items) -> items
        else -> panic("checked trait coercion target is not a trait object")
    }
    if bounds.len() != 1 -> panic("checked trait coercion target must name exactly one trait")
    if !jet_codegen_trait_bound_is_declared(builder.modules, bounds[0], builder.function.module_identity) -> panic("checked trait coercion target names an undeclared or ambiguous trait")
}

fn jet_codegen_call_argument_needs_trait_box(argument: TCallArg) -> Bool Never! {
    if argument.box_as_trait == None -> return false
    if argument.value.ty == {
        .TraitObject(_) -> return false
        .Named(_) | .Apply(_, _) -> return true
        else -> panic("checked call trait-box source is not nominal")
    }
}

fn jet_codegen_call_access(argument: TCallArg, formal: AccessConvention?) -> MirAccess Never! {
    if argument.mut_borrow -> return MirAccess.Write
    if jet_codegen_call_argument_needs_trait_box(argument) && argument.borrow && !argument.clone && !argument.arc_clone -> return MirAccess.Move
    if argument.widen_to_union != None && !argument.mut_borrow && !argument.clone && !argument.arc_clone && !jet_codegen_is_copy_type(argument.value.ty) -> return MirAccess.Move
    if argument.clone || argument.arc_clone || jet_codegen_is_move_kind(argument.value.kind) -> return MirAccess.Move
    if argument.borrow -> return MirAccess.Read
    convention :: formal ?? AccessConvention.Read
    jet_codegen_lower_access(convention)
}

fn jet_codegen_is_scalar_type(ty: Type) -> Bool Never! {
    if ty == {
        .Int | .Float | .Bool | .Float32 | .IntN(_, _) | .Measure(_) -> return true
        .InlineRange(base, _, _) | .Tagged(_, base) -> return jet_codegen_is_scalar_type(base)
        .Apply(name, args) -> return name == "Ptr" && args.len() == 1
        else -> false
    }
}

fn jet_codegen_is_string_view_local(builder: JetCodegenBuilder, local: TLocal) -> Bool Never! {
    binding :: jet_codegen_find_binding_for_local(builder, local) ?? return false
    loop lowered in builder.locals {
        if lowered.id == binding.local -> return lowered.string_view
    }
    false
}

fn jet_codegen_is_string_view_value(builder: JetCodegenBuilder, value: TExpr) -> Bool Never! {
    if value.ty != Type.String -> return false
    if value.kind == {
        .Local(local) -> return jet_codegen_is_string_view_local(builder, local)
        .Borrow(inner, _) -> return jet_codegen_is_string_view_value(builder, inner)
        else -> false
    }
}


fn jet_codegen_is_copy_type(ty: Type) -> Bool Never! {
    ty == Type.Int | Type.Float | Type.Float32 | Type.Bool | Type.Char
}

fn jet_codegen_formal_slot(label: String?, positional: Int, labels: [String], variadic: [Bool]) -> Int Never! {
    if label != None {
        wanted :: label ?? ""
        index := 0
        loop index < labels.len() {
            if labels[index] == wanted -> return index
            index += 1
        }
        panic("checked call label has no MIR parameter slot")
    }
    if labels.len() == 0 -> return positional
    if positional < labels.len() -> return positional
    if variadic.len() > 0 && variadic[variadic.len() - 1] -> return variadic.len() - 1
    positional
}

fn jet_codegen_lower_call_args(builder: &JetCodegenBuilder, args: [TCallArg], params: [TParameter]) -> [MirCallArg] {
    labels := [String]{}
    variadic := [Bool]{}
    conventions := [AccessConvention]{}
    loop parameter in params {
        &labels.push(parameter.public_label)
        &variadic.push(parameter.variadic)
        &conventions.push(parameter.convention)
    }
    jet_codegen_lower_call_args_for_signature(&builder, args, labels, variadic, conventions)
}
fn jet_codegen_lower_foreign_call_args(builder: &JetCodegenBuilder, args: [TCallArg], params: [SemaCheckedForeignParam]) -> [MirCallArg] {
    labels := [String]{}
    variadic := [Bool]{}
    conventions := [AccessConvention]{}
    loop parameter in params {
        &labels.push(parameter.public_label)
        &variadic.push(parameter.variadic)
        &conventions.push(parameter.convention)
    }
    jet_codegen_lower_call_args_for_signature(&builder, args, labels, variadic, conventions)
}

fn jet_codegen_lower_extern_args(builder: &JetCodegenBuilder, args: [TExternArg]) -> [MirCallArg] {
    lowered := [MirCallArg]{}
    loop argument in args {
        value := jet_codegen_lower_expr(&builder, argument.value)
        resource_take := if argument.value.kind == {
            .ResourceTake(_) -> true
            else -> false
        }
        access := if {
            argument.mut_borrow -> MirAccess.Write
            argument.clone || resource_take -> MirAccess.Move
            else -> MirAccess.Read
        }
        &lowered.push(MirCallArg{
            value: value,
            place: None,
            access: access,
            span: argument.value.span,
            label: None,
            source_index: None,
            binder_slot: None,
            spread: false,
            implicit_clone: argument.clone,
            shared_auto_clone: false,
            owned_last_use: access == MirAccess.Move,
            authority_boundary: false,
            fn_coercion: None,
            widen_fixed_to_list: false,
            widen_to_union: None,
            box_as_trait: None,
        })
    }
    lowered
}

fn jet_codegen_lower_call_args_for_signature(builder: &JetCodegenBuilder, args: [TCallArg], labels: [String], variadic: [Bool], conventions: [AccessConvention]) -> [MirCallArg] {
    lowered := [MirCallArg]{}
    positional := 0
    index := 0
    loop index < args.len() {
        argument :: args[index]
        if argument.template_items.len() != 0 -> panic("checked runtime call contains compile-time template items")
        slot := jet_codegen_formal_slot(argument.label, positional, labels, variadic)
        formal := None
        if slot >= 0 && slot < conventions.len() -> formal = Val(conventions[slot])
        materialize_view_clone := argument.clone && jet_codegen_is_string_view_value(builder, argument.value)
        access := jet_codegen_call_access(argument, formal)
        place := None
        place_expr := argument.value
        if place_expr.kind == {
            .Borrow(value, _) -> place_expr = value
            else -> {}
        }
        if argument.borrow || argument.mut_borrow {
            if place_expr.kind == {
                .Local(local) -> {
                    binding :: jet_codegen_find_binding_for_local(builder, local) ?? panic("checked borrowed argument has no local place")
                    place = Val(binding.place)
                }
                else -> {
                    temporary := tir_generated_local("call_arg_{index}", argument.value.span)
                    temporary.mutable = argument.mut_borrow
                    temporary_place := jet_codegen_bind_local(&builder, temporary, argument.value.ty, argument.mut_borrow, None, None, false)
                    value := jet_codegen_emit_expr(&builder, argument.value)
                    _ := jet_codegen_emit(&builder, argument.value.span, None, MirOperation.WritePlace{place: temporary_place, value: value})
                    place = Val(temporary_place)
                }
            }
        }
        value := if place == {
            None -> jet_codegen_emit_expr(&builder, argument.value)
            Val(place_id) -> {
                operation := MirOperation.ReadPlace{place: place_id}
                if access == MirAccess.Move && !materialize_view_clone -> operation = MirOperation.MovePlace{place: place_id}
                jet_codegen_emit_value(&builder, argument.value.span, argument.value.ty, operation)
            }
        }
        if materialize_view_clone -> value = jet_codegen_emit_value(&builder, argument.value.span, argument.value.ty, MirOperation.Copy{value: value, materialize_view: true})
        fn_coercion := None
        if argument.fn_coerce != None {
            coercion :: argument.fn_coerce ?? TFnCoerce{ty: argument.value.ty, already_boxed: false}
            fn_coercion = Val(MirFnCoercion{ty: jet_codegen_lower_type_for_function(coercion.ty, builder), already_boxed: coercion.already_boxed})
        }
        widen_to_union := None
        if argument.widen_to_union != None {
            union_type :: argument.widen_to_union ?? Type.Union{members: [Type]{}}
            identity :: jet_codegen_lower_type_for_function(union_type, builder).identity ?? panic("checked union type has no MIR identity")
            widen_to_union = Val(MirUnionCoercion{union: identity, variant: jet_codegen_union_member_tag(argument.value.ty)})
        }
        box_as_trait := None
        if argument.box_as_trait != None {
            target_ty := argument.box_as_trait ?? Type.TraitObject{bounds: [String]{}}
            jet_codegen_require_trait_box_target(target_ty, &builder)
            if argument.value.ty == {
                .TraitObject(_) -> {
                    if type_identity_key(argument.value.ty) != type_identity_key(target_ty) -> panic("checked trait-object upcast has no MIR operation")
                }
                .Named(_) | .Apply(_, _) -> {
                    target := jet_codegen_lower_type_for_function(target_ty, builder)
                    identity :: target.identity ?? panic("checked call trait coercion target has no MIR type identity")
                    box_as_trait = Val(identity)
                }
                else -> panic("checked call trait-box source is not nominal")
            }
        }
        owned_last_use := access == MirAccess.Move || box_as_trait != None
        call_place := place
        if box_as_trait != None || argument.widen_to_union != None || materialize_view_clone -> call_place = None
        &lowered.push(MirCallArg{
            value: value,
            place: call_place,
            access: access,
            span: argument.value.span,
            label: argument.label,
            source_index: Val(index),
            binder_slot: Val(slot),
            spread: argument.spread,
            implicit_clone: argument.clone && !materialize_view_clone,
            shared_auto_clone: argument.arc_clone,
            owned_last_use: owned_last_use,
            authority_boundary: false,
            fn_coercion: fn_coercion,
            widen_fixed_to_list: argument.widen_to_vec,
            widen_to_union: widen_to_union,
            box_as_trait: box_as_trait,
        })
        if argument.label == None -> positional += 1
        index += 1
    }
    lowered
}
fn jet_codegen_is_collection_argument(ty: Type) -> Bool Never! {
    if ty == {
        .List(_) | .Map(_, _, _) | .FixedList(_, _) -> true
        else -> false
    }
}

fn jet_codegen_lower_core_call_arg(builder: &JetCodegenBuilder, argument: TExpr, index: Int, record: CoreCallRecord, widen_to_vec: Bool) -> MirCallArg {
    access := MirAccess.Read
    place := None
    if argument.kind == {
        .Borrow(value, convention) -> {
            access = jet_codegen_lower_access(convention)
            place = Val(jet_codegen_lower_place_for_access(&builder, TPlace.Expr{value: value}, access))
        }
        .Clone(_) | .ExplicitCopy(_) | .MaterializeView(_) | .Move(_) | .ResourceTake(_) -> access = MirAccess.Move
        else -> if jet_codegen_is_collection_argument(argument.ty) -> access = MirAccess.Move
    }
    if access == MirAccess.Move && jet_codegen_ownership(argument.ty).mode == MirOwnershipMode.Copy -> access = MirAccess.Read
    value := if place == {
        None -> {
            move_place := None
            if access == MirAccess.Move {
                move_place = if argument.kind == {
                    .Local(local) -> Val(jet_codegen_lower_local_place(&builder, local))
                    .Field(_, _) -> Val(jet_codegen_lower_place_for_access(&builder, TPlace.Expr{value: argument}, MirAccess.Read))
                    else -> None
                }
            }
            if move_place == {
                None -> jet_codegen_lower_expr(&builder, argument)
                Val(id) -> jet_codegen_emit_value(&builder, argument.span, argument.ty, MirOperation.MovePlace{place: id})
            }
        }
        Val(place_id) -> jet_codegen_emit_value(&builder, argument.span, argument.ty, MirOperation.ReadPlace{place: place_id})
    }
    return MirCallArg{
        value: value,
        place: place,
        access: access,
        span: argument.span,
        label: None,
        source_index: Val(index),
        binder_slot: None,
        spread: false,
        implicit_clone: false,
        shared_auto_clone: false,
        owned_last_use: access == MirAccess.Move,
        authority_boundary: record.module_name == "core.plugin" && record.member == "load" && index == 1,
        fn_coercion: None,
        widen_fixed_to_list: widen_to_vec,
        widen_to_union: None,
        box_as_trait: None,
    }
}

fn jet_codegen_intern_route(builder: &JetCodegenBuilder, family: MirPreludeFamily, module_name: String, member: String, symbol: String, arity: Int, borrow_mask: [Bool], route_effect: Effect?, carrier: TFailureCarrier, abi: MirPreludeAbi) -> MirPreludeCallId Never! {
    jet_codegen_intern_route_with_authority(&builder, family, module_name, member, symbol, arity, borrow_mask, route_effect, carrier, abi, None)
}
fn jet_codegen_intern_route_with_authority(builder: &JetCodegenBuilder, family: MirPreludeFamily, module_name: String, member: String, symbol: String, arity: Int, borrow_mask: [Bool], route_effect: Effect?, carrier: TFailureCarrier, abi: MirPreludeAbi, authority: MirAuthorityDecision?) -> MirPreludeCallId Never! {
    mask_names := [String]{}
    loop borrowed in borrow_mask {
        if borrowed -> &mask_names.push("true") else -> &mask_names.push("false")
    }
    effect_identity := "None"
    if route_effect != None {
        effect_name :: jet_codegen_core_effect_name(route_effect) ?? panic("checked Prelude route effect lost its canonical name")
        effect_identity = "Some({effect_name})"
    }
    abi_identity := if abi == {
        .Value -> "Value"
        .Aggregate -> "Aggregate"
        .Control -> "Control"
        .Effect -> "Effect"
    }
    identity := "{family}:{module_name}:{member}:{symbol}:{arity}:{arity}:[{mask_names.join(", ")}]:{effect_identity}:{jet_codegen_core_route_fallibility_identity(carrier)}:{abi_identity}"
    id := MirPreludeCallId{value: stable_id("mir-prelude-call", identity)}
    jet_codegen_intern_prelude_call(&builder, MirPreludeCall{
        id: id,
        family: family,
        module_name: module_name,
        member: member,
        symbol: MirSymbol.Prelude{name: symbol},
        signature: MirCallSignature{arity: arity, max_arity: arity, borrow_mask: borrow_mask},
        effect_kind: route_effect,
        fallibility: jet_codegen_core_call_fallibility(carrier, builder),
        abi: abi,
        authority: authority,
        db_metadata: None,
    })
}
fn jet_codegen_slice_route(builder: &JetCodegenBuilder, base: Type, has_range: Bool, carrier: TFailureCarrier) -> MirPreludeCallId Never! {
    if base == {
        .Shared(inner) | .Tagged(_, inner) | .InlineRange(inner, _, _) -> return jet_codegen_slice_route(&builder, inner, has_range, carrier)
        .String -> {
            if has_range -> return jet_codegen_intern_route(&builder, MirPreludeFamily.StaticPrelude, "core.collections", "slice_string_range", "jet_slice_range", 4, [Bool]{true, true, false, false}, None, carrier, MirPreludeAbi.Value)
            return jet_codegen_intern_route(&builder, MirPreludeFamily.StaticPrelude, "core.collections", "slice_string", "jet_string_slice", 5, [Bool]{true, false, false, false, false}, None, carrier, MirPreludeAbi.Value)
        }
        .List(_) | .FixedList(_, _) -> {
            if has_range -> return jet_codegen_intern_route(&builder, MirPreludeFamily.StaticPrelude, "core.collections", "slice_list_range", "jet_slice_vec_range", 4, [Bool]{true, true, false, false}, None, carrier, MirPreludeAbi.Value)
            return jet_codegen_intern_route(&builder, MirPreludeFamily.StaticPrelude, "core.collections", "slice_list", "jet_slice_vec", 5, [Bool]{true, false, false, false, false}, None, carrier, MirPreludeAbi.Value)
        }
        else -> panic("checked slice base has no canonical slice Prelude route")
    }
}
fn jet_codegen_precise_type_key(type_name: String) -> String Never! {
    if type_name == "Decimal" -> return "decimal"
    if type_name == "Fraction" -> return "fraction"
    if type_name == "Complex" -> return "complex"
    if type_name == "Measurement" -> return "measurement"
    panic("checked precise builtin has an unregistered numeric type")
}

fn jet_codegen_precise_builtin_route(builder: &JetCodegenBuilder, type_name: String, function: String, arity: Int, carrier: TFailureCarrier) -> MirPreludeCallId Never! {
    type_key := jet_codegen_precise_type_key(type_name)
    symbol := "jet_{type_key}_{function}"
    if type_name == "Measurement" && function == "new" -> symbol = "jet_std::JetMeasurement::new"
    by_value := function == "new" || function == "from_parts" || (function.starts_with("from_") && function != "from_str")
    borrow_mask := [Bool]{}
    index := 0
    loop index < arity {
        &borrow_mask.push(!by_value)
        index += 1
    }
    jet_codegen_intern_route(&builder, MirPreludeFamily.PreciseBuiltin, type_name, function, symbol, arity, borrow_mask, None, carrier, MirPreludeAbi.Value)
}

fn jet_codegen_lower_precise_builtin(builder: &JetCodegenBuilder, span: Span, result_type: Type, type_name: String, function: String, args: [TExpr], carrier: TFailureCarrier) -> MirValueId {
    values := [MirValueId]{}
    loop argument in args -> &values.push(jet_codegen_lower_expr(&builder, argument))
    type_id := jet_codegen_type_instance_id(Type.Named{name: type_name}, builder.modules, builder.function.module_identity, builder.generic_type_names)
    call := jet_codegen_precise_builtin_route(&builder, type_name, function, values.len(), carrier)
    jet_codegen_note_core_module(&builder, "core.math")
    jet_codegen_emit_value(&builder, span, result_type, MirOperation.Semantic{operation: MirSemanticOp.PreciseBuiltin{type_id: type_id, call: call, args: values}})
}
fn jet_codegen_lower_registered_math_constructor(builder: &JetCodegenBuilder, expression: TExpr, record: CoreCallRecord, args: [TExpr], type_args: [Type], data_plan: MirDataPlan?, failure: TFailureCarrier) -> MirValueId? {

    if record.module_name != "core.math" || (record.member != "fraction" && record.member != "decimal") -> return None
    if type_args.len() != 0 || data_plan != None -> panic("checked precise math constructor carries unsupported type or data-plan facts")
    if args.len() != record.signature.arity -> panic("checked precise math constructor arity disagrees with its registered CoreCall")
    is_optional := if expression.ty == { .Option(_) -> true else -> false }
    optional_failure := if failure == { .Optional(_) -> true else -> false }
    if record.member == "fraction" && (!is_optional || !optional_failure) -> panic("checked core.math.fraction constructor lost its optional result policy")
    type_name := if record.member == "fraction" -> "Fraction" else -> "Decimal"
    function := if record.member == "fraction" -> "new" else -> "from_str"
    Val(jet_codegen_lower_precise_builtin(&builder, expression.span, expression.ty, type_name, function, args, failure))
}


fn jet_codegen_failure_carrier_for_type(ty: Type) -> TFailureCarrier Never! {
    if ty == {
        .Result(ok, err) -> TFailureCarrier.Result{success: ok, error: err}
        .Option(value) -> TFailureCarrier.Optional{value: value}
        else -> TFailureCarrier.Infallible
    }
}

fn jet_codegen_index_kind(base: Type, kind: TIndexKind) -> MirIndexKind Never! {
    if kind == {
        .List -> MirIndexKind.List
        .FixedListProof -> MirIndexKind.FixedListProof
        .Map -> MirIndexKind.Map
        .Pool -> MirIndexKind.Pool
        .Lane(_) -> MirIndexKind.Lane
        .Unknown -> {
            if base == {
                .Map(_, _, _) -> {
                    return MirIndexKind.Map
                }
                .Apply(name, _) -> {
                    if name == "Pool" {
                        return MirIndexKind.Pool
                    }
                }
                else -> {}
            }
            if base == {
                .FixedList(_, _) -> {
                    return MirIndexKind.FixedListProof
                }
                else -> {}
            }
            MirIndexKind.List
        }
        .Range | .User(_) | .LayoutField(_) -> panic("checked non-place index kind reached place lowering")
    }
}

fn jet_codegen_index_element_type(base: Type, kind: MirIndexKind) -> Type Never! {
    if kind == {
        .List | .FixedListProof -> if base == {
            .List(inner) | .FixedList(inner, _) -> inner
            .Apply(name, args) -> if (name == "View" || name == "ViewMut" || name == "ComputeViewMut") && args.len() == 1 -> args[0] else -> panic("checked index place has no element type")
            else -> panic("checked index place has no element type")
        }
        .Map -> if base == {
            .Map(_, _, value) -> value
            else -> panic("checked index place has no element type")
        }
        .Pool -> if base == {
            .Apply(name, args) -> if name == "Pool" && args.len() == 1 -> args[0] else -> panic("checked index place has no element type")
            else -> panic("checked index place has no element type")
        }
        .Lane -> panic("checked index place has no element type")
    }
}

fn jet_codegen_index_route(builder: &JetCodegenBuilder, kind: MirIndexKind, access: MirAccess, carrier: TFailureCarrier) -> MirPreludeCallId Never! {
    member := ""
    symbol := ""
    arity := 4
    borrow_mask := [Bool]{true, false, true, false}
    if kind == {
        .List | .FixedListProof -> {
            if access == {
                MirAccess.Read -> {
                    member = "index_list"
                    symbol = "jet_index_vec"
                }
                MirAccess.Write -> {
                    member = "index_list_mut"
                    symbol = "jet_index_vec_mut"
                }
                else -> {
                    panic("checked list index place cannot move")
                }
            }
        }
        .Map -> {
            arity = 8
            borrow_mask = [Bool]{true, true, true, false, true, true, false, false}
            if access == {
                MirAccess.Read -> {
                    member = "index_map"
                    symbol = "jet_index_map"
                }
                MirAccess.Write -> {
                    member = "index_map_mut"
                    symbol = "jet_index_map_mut"
                }
                else -> {
                    panic("checked map index place cannot move")
                }
            }
        }
        .Pool -> {
            arity = 6
            borrow_mask = [Bool]{true, false, true, false, true, true}
            if access == {
                MirAccess.Read -> {
                    member = "index_pool"
                    symbol = "jet_std::jet_pool_get"
                }
                MirAccess.Write -> {
                    member = "index_pool_mut"
                    symbol = "jet_std::jet_pool_get_mut"
                }
                else -> {
                    panic("checked pool index place cannot move")
                }
            }
        }
        .Lane -> panic("checked lane place requires its typed lane kernel")
    }
    jet_codegen_intern_route(&builder, MirPreludeFamily.StaticPrelude, "core.index", member, symbol, arity, borrow_mask, None, carrier, MirPreludeAbi.Value)
}

fn jet_codegen_index_write_route(builder: &JetCodegenBuilder, kind: MirIndexKind, base: Type, carrier: TFailureCarrier) -> MirPreludeCallId Never! {
    member := "index_list_set"
    symbol := "jet_index_vec_set"
    arity := 5
    borrow_mask := [Bool]{true, false, false, true, false}
    if kind == {
        .List | .FixedListProof -> {}
        .Map -> {
            member = "index_map_set"
            arity = 3
            if base == {
                .Map(key, _, _) -> {
                    if {
                        key == Type.String -> {
                            symbol = "jet_map_update_string"
                            borrow_mask = [Bool]{true, true, false}
                        } else -> {
                            symbol = "jet_map_insert"
                            borrow_mask = [Bool]{true, false, false}
                        }
                    }
                }
                else -> panic("checked map index setter has no map type")
            }
        }
        .Pool -> {
            member = "index_pool_set"
            symbol = "jet_std::jet_pool_set"
            arity = 7
            borrow_mask = [Bool]{true, false, false, true, false, true, true}
        }
        .Lane -> panic("checked lane place requires its typed lane setter")
    }
    jet_codegen_intern_route(&builder, MirPreludeFamily.StaticPrelude, "core.index", member, symbol, arity, borrow_mask, None, carrier, MirPreludeAbi.Value)
}

fn jet_codegen_math_scalar_type(type_name: String) -> Type Never! {
    if type_name == "F32x4" || type_name == "F32x8" -> return Type.Float32
    if type_name.starts_with("I8x") -> return Type.IntN{signed: true, bits: 8}
    if type_name.starts_with("I16x") -> return Type.IntN{signed: true, bits: 16}
    if type_name.starts_with("I32x") -> return Type.IntN{signed: true, bits: 32}
    if type_name.starts_with("I64x") -> return Type.IntN{signed: true, bits: 64}
    if type_name.starts_with("U8x") -> return Type.IntN{signed: false, bits: 8}
    if type_name.starts_with("U16x") -> return Type.IntN{signed: false, bits: 16}
    if type_name.starts_with("U32x") -> return Type.IntN{signed: false, bits: 32}
    if type_name.starts_with("U64x") -> return Type.IntN{signed: false, bits: 64}
    Type.Float
}

fn jet_codegen_lane_index_route(builder: &JetCodegenBuilder, type_name: String, scalar_ty: Type, carrier: TFailureCarrier) -> MirPreludeCallId Never! {
    jet_codegen_intern_route(&builder, MirPreludeFamily.MathBuiltin, "core.math", "lane_index", "jet_math_{type_name}_lane", 4, [Bool]{true, false, true, false}, None, carrier, MirPreludeAbi.Value)
}

fn jet_codegen_lane_index_write_route(builder: &JetCodegenBuilder, type_name: String, carrier: TFailureCarrier) -> MirPreludeCallId Never! {
    jet_codegen_intern_route(&builder, MirPreludeFamily.MathBuiltin, "core.math", "lane_set", "jet_math_{type_name}_lane_set", 5, [Bool]{true, false, false, true, false}, None, carrier, MirPreludeAbi.Value)
}

fn jet_codegen_place_access(builder: &JetCodegenBuilder, place: MirPlaceId, access: MirAccess) -> MirPlaceId Never! {
    source :: jet_codegen_find_place(builder, place) ?? panic("checked place access has no MIR place")
    if source.access == access -> return place
    identity := jet_codegen_identity(&builder, "place", source.span, "access", "{place.value}|{access}")
    source.id = MirPlaceId{value: stable_id("mir-place", identity)}
    source.access = access
    &builder.places.push(source)
    source.id
}

fn jet_codegen_temporary_place(builder: &JetCodegenBuilder, value: MirValueId, ty: Type, span: Span, access: MirAccess) -> MirPlaceId Never! {
    identity := jet_codegen_identity(&builder, "place", span, "temporary", "{value.value}")
    id := MirPlaceId{value: stable_id("mir-place", identity)}
    &builder.places.push(MirPlace{
        id: id,
        span: span,
        ty: jet_codegen_lower_type_for_function(ty, builder),
        base: MirPlaceBase.Temporary{value: value},
        projections: [MirProjection]{},
        access: access,
        persist_key: None,
    })
    id
}

fn jet_codegen_index_place(builder: &JetCodegenBuilder, base: TExpr, index: TExpr, kind: TIndexKind, result_ty: Type, access: MirAccess, location: TPanicLoc, span: Span) -> MirPlaceId {
    mir_kind := jet_codegen_index_kind(base.ty, kind)
    result_type := jet_codegen_index_element_type(base.ty, mir_kind)
    if type_identity_key(result_type) != type_identity_key(result_ty) -> panic("checked index place result disagrees with its element type")
    base_place := jet_codegen_lower_expression_place(builder, base, access)
    if base_place == None {
        base_value := jet_codegen_lower_expr(&builder, base)
        base_place = Val(jet_codegen_temporary_place(&builder, base_value, base.ty, base.span, access))
    }
    base_id := base_place ?? panic("checked index place has no base place")
    index_value := jet_codegen_lower_expr(&builder, index)
    carrier := jet_codegen_failure_carrier_for_type(result_ty)
    call := jet_codegen_index_route(&builder, mir_kind, access, carrier)
    write_call := None
    if access == MirAccess.Write -> write_call = Val(jet_codegen_index_write_route(&builder, mir_kind, base.ty, carrier))
    locals := [MirPanicLocal]{}
    loop local in location.locals {
        binding :: jet_codegen_find_binding_for_local(builder, local.local) ?? next
        &locals.push(MirPanicLocal{name: local.display_name, local: binding.local})
    }
    panic_loc := MirPanicLoc{file: mir_source_file_id(location.file), line: location.line, column: location.column}
    context := None
    if mir_kind == MirIndexKind.Map || mir_kind == MirIndexKind.Pool {
        context = Val(MirPanicContext{function: location.function, source_line: location.source_line, caret: location.caret, locals: locals})
    }
    root :: jet_codegen_find_place(builder, base_id) ?? panic("checked index base has no MIR place")
    projections := [MirProjection]{}
    loop projection in root.projections -> &projections.push(projection)
    &projections.push(MirProjection.Index{kind: mir_kind, index: index_value, call: call, write_call: write_call, location: panic_loc, context: context, span: span})
    identity := jet_codegen_identity(&builder, "place", span, "index", "{root.id.value}:{index_value.value}")
    id := MirPlaceId{value: stable_id("mir-place", identity)}
    &builder.places.push(MirPlace{
        id: id,
        span: span,
        ty: jet_codegen_lower_type_for_function(result_ty, builder),
        base: root.base,
        projections: projections,
        access: access,
        persist_key: None,
    })
    id
}

fn jet_codegen_swizzle_places(builder: &JetCodegenBuilder, base: TExpr, lanes: [Int], access: MirAccess, span: Span) -> [MirPlaceId] {
    if lanes.len() == 0 -> panic("checked swizzle place has no lanes")
    type_name := if base.ty == {
        .Named(name) -> name
        else -> panic("checked swizzle place has no named lane type")
    }
    scalar_ty := jet_codegen_math_scalar_type(type_name)
    carrier := jet_codegen_failure_carrier_for_type(scalar_ty)
    root_id := if base.kind == {
        .Local(local) -> Val(jet_codegen_place_access(&builder, jet_codegen_lower_local_place(&builder, local), access))
        else -> {
            value := jet_codegen_lower_expr(&builder, base)
            Val(jet_codegen_temporary_place(&builder, value, base.ty, base.span, access))
        }
    }
    root :: jet_codegen_find_place(builder, root_id ?? panic("checked swizzle base has no MIR place")) ?? panic("checked swizzle base place disappeared")
    location := jet_codegen_source_location_at(&builder, span, false)
    panic_loc := MirPanicLoc{file: mir_source_file_id(builder.function.source_file), line: location.line, column: 0}
    call := jet_codegen_lane_index_route(&builder, type_name, scalar_ty, carrier)
    write_call := jet_codegen_lane_index_write_route(&builder, type_name, carrier)
    places := [MirPlaceId]{}
    loop lane in lanes {
        index := jet_codegen_emit_value(&builder, span, Type.Int, MirOperation.Constant{value: MirConstant.Int{value: lane, width: None, spelling: None}})
        projections := [MirProjection]{}
        loop projection in root.projections -> &projections.push(projection)
        identity := jet_codegen_identity(&builder, "place", span, "math-lane", "{root.id.value}:{lane}")
        &projections.push(MirProjection.Index{kind: MirIndexKind.Lane, index: index, call: call, write_call: Val(write_call), location: panic_loc, context: None, span: span})
        id := MirPlaceId{value: stable_id("mir-place", identity)}
        &builder.places.push(MirPlace{
            id: id,
            span: span,
            ty: jet_codegen_lower_type_for_function(scalar_ty, builder),
            base: root.base,
            projections: projections,
            access: access,
            persist_key: None,
        })
        &places.push(id)
    }
    places
}

fn jet_codegen_lower_local_place(builder: &JetCodegenBuilder, local: TLocal) -> MirPlaceId Never! {
    if local.persist_key != None {
        key :: local.persist_key ?? ""
        found := None
        loop place in builder.places {
            if place.persist_key == (Val(key)) -> found = Val(place.id)
        }
        place_id := if found == {
            Val(value) -> value
            None -> {
                ty :: local.persist_ty ?? panic("checked persistent local has no checked type")
                id := MirPlaceId{value: stable_id("mir-place", "{builder.function.key}|persistent|{key}")}
                &builder.places.push(MirPlace{
                    id: id,
                    span: local.span,
                    ty: jet_codegen_lower_type_for_function(ty, builder),
                    base: MirPlaceBase.Static{name: key},
                    projections: [MirProjection]{},
                    access: MirAccess.Read,
                    persist_key: Val(key),
                })
                id
            }
        }
        if local.deref -> return jet_codegen_project_deref_place(&builder, place_id, local.persist_ty ?? panic("checked persistent dereference has no checked type"), local.span)
        return place_id
    }
    binding :: jet_codegen_find_binding_for_local(builder, local) ?? panic("checked TIR local has no MIR place")
    if local.deref -> return jet_codegen_project_deref_place(&builder, binding.place, binding.ty, local.span)
    binding.place
}

fn jet_codegen_project_deref_place(builder: &JetCodegenBuilder, base: MirPlaceId, ty: Type, span: Span) -> MirPlaceId Never! {
    root :: jet_codegen_find_place(builder, base) ?? panic("checked dereference place has no MIR base")
    projections := [MirProjection]{}
    loop projection in root.projections -> &projections.push(projection)
    &projections.push(MirProjection.Deref{span: span})
    identity := jet_codegen_identity(&builder, "place", span, "deref", "{base.value}")
    id := MirPlaceId{value: stable_id("mir-place", identity)}
    &builder.places.push(MirPlace{
        id: id,
        span: span,
        ty: jet_codegen_lower_type_for_function(ty, builder),
        base: root.base,
        projections: projections,
        access: root.access,
        persist_key: None,
    })
    id
}

fn jet_codegen_lower_expression_place(builder: &JetCodegenBuilder, expression: TExpr, access: MirAccess) -> MirPlaceId? {
    if expression.kind == {
        .Local(local) -> return Val(jet_codegen_place_access(&builder, jet_codegen_lower_local_place(&builder, local), access))
        .Field(receiver, reference) -> {
            base := jet_codegen_lower_expression_place(&builder, receiver, access) ?? return None
            if receiver.ty == {
                .Apply(name, args) -> {
                    if name == "Pin" && args.len() == 1 -> base = jet_codegen_project_deref_place(&builder, base, args[0], expression.span)
                }
                else -> {}
            }
            resolved := jet_codegen_resolve_field_by_symbol(builder.modules, reference)
            return Val(jet_codegen_project_field_place(&builder, base, expression.span, reference.ty, jet_codegen_mir_field_id(resolved)))
        }
        .Index(base, index, kind, _, _, location) -> return Val(jet_codegen_index_place(&builder, base, index, kind, expression.ty, access, location, expression.span))
        .Deref(pointer) -> {
            pointer_value := jet_codegen_lower_expr(&builder, pointer)
            temporary := jet_codegen_temporary_place(&builder, pointer_value, pointer.ty, pointer.span, access)
            return Val(jet_codegen_project_deref_place(&builder, temporary, expression.ty, expression.span))
        }
        .Borrow(place, convention) -> {
            borrowed_access := jet_codegen_lower_access(convention)
            place_id := jet_codegen_lower_place_for_access(&builder, TPlace.Expr{value: place}, borrowed_access)
            pointer := jet_codegen_emit_value(&builder, expression.span, expression.ty, MirOperation.AddressOf{place: place_id, access: borrowed_access})
            temporary := jet_codegen_temporary_place(&builder, pointer, expression.ty, expression.span, access)
            return Val(jet_codegen_project_deref_place(&builder, temporary, place.ty, expression.span))
        }
        .SharedGuardValue(guard, _) -> {
            base := jet_codegen_lower_expression_place(&builder, guard, access)
            base_place := if base == {
                None -> {
                    value := jet_codegen_lower_expr(&builder, guard)
                    jet_codegen_temporary_place(&builder, value, guard.ty, guard.span, access)
                }
                Val(place_id) -> place_id
            }
            return Val(jet_codegen_project_deref_place(&builder, base_place, expression.ty, expression.span))
        }
        .PoolSlot(pool, id, _, field, line, source_line) -> {
            location := TPanicLoc{file: builder.function.source_file, source_line: source_line, line: line, column: 0, caret: 0, function: builder.function.name, locals: [TPanicLocal]{}}
            element_ty := jet_codegen_index_element_type(pool.ty, MirIndexKind.Pool)
            base := jet_codegen_index_place(&builder, pool, id, TIndexKind.Pool, element_ty, access, location, expression.span)
            if field == {
                None -> return Val(base)
                Val(name) -> {
                    resolved := jet_codegen_resolve_field_by_name(builder.modules, builder.function.module_identity, builder.generic_type_names, element_ty, name)
                    return Val(jet_codegen_project_field_place(&builder, base, expression.span, expression.ty, jet_codegen_mir_field_id(resolved)))
                }
            }
        }
        else -> None
    }
}

fn jet_codegen_lower_place_for_access(builder: &JetCodegenBuilder, place: TPlace, access: MirAccess) -> MirPlaceId {
    if place == {
        .Local(local) -> return jet_codegen_place_access(&builder, jet_codegen_lower_local_place(&builder, local), access)
        .Expr(value) -> {
            lowered := jet_codegen_lower_expression_place(&builder, value, access)
            if lowered != None -> return lowered ?? panic("checked expression place disappeared")
            value_id := jet_codegen_lower_expr(&builder, value)
            jet_codegen_temporary_place(&builder, value_id, value.ty, value.span, access)
        }
    }
}

fn jet_codegen_lower_place(builder: &JetCodegenBuilder, place: TPlace) -> MirPlaceId {
    jet_codegen_lower_place_for_access(&builder, place, MirAccess.Read)
}

fn jet_codegen_lower_read_place(builder: &JetCodegenBuilder, place: TPlace) -> MirPlaceId {
    jet_codegen_lower_place_for_access(&builder, place, MirAccess.Read)
}

fn jet_codegen_lower_tuple_fields(builder: &JetCodegenBuilder, span: Span, ty: Type, fields: [TypeTupleField], values: [TExpr], type_id: MirTypeId, identity: String) -> MirValueId {
    if fields.len() != values.len() -> panic("checked tuple literal arity does not match its type")
    lowered_fields := [MirFieldValue]{}
    index := 0
    loop index < values.len() {
        field := fields[index]
        value := jet_codegen_lower_expr(&builder, values[index])
        &lowered_fields.push(MirFieldValue{
            field: mir_field_id("{identity}::{field.name}"),
            value: value,
        })
        index += 1
    }
    jet_codegen_emit_value(&builder, span, ty, MirOperation.Tuple{type_id: type_id, fields: lowered_fields})
}

fn jet_codegen_lower_tuple(builder: &JetCodegenBuilder, expression: TExpr, values: [TExpr]) -> MirValueId {
    fields := if expression.ty == {
        .Tuple(fields) -> fields
        else -> panic("checked tuple expression has a non-tuple result type")
    }
    tuple_type := jet_codegen_lower_type_for_function(expression.ty, builder)
    type_id :: tuple_type.identity ?? panic("checked tuple type has no MIR identity")
    identity := mir_type_identity_key(tuple_type)
    jet_codegen_lower_tuple_fields(&builder, expression.span, expression.ty, fields, values, type_id, identity)
}
// A stored field of a nominal struct can be read through a projected place;
// computed fields and enum payload fields cannot.
fn jet_codegen_is_stored_struct_field(modules: [SemaGraphModuleResult], reference: TFieldRef) -> Bool Never! {
    loop semantic_module in modules {
        loop nominal in semantic_module.nominals {
            if reference.owner != None && nominal.symbol.id.key != (reference.owner ?? SymbolId{key: ""}).key -> next
            loop field in nominal.fields {
                if field.symbol.id.key == reference.field.key -> return nominal.kind == SemaRegistrationNominalKind.Struct && !field.computed
            }
        }
    }
    false
}

// A local or parameter (`self` included), or a chain of stored struct fields
// rooted at one, with no `Pin` on the way: its field can be read in place.
fn jet_codegen_is_stored_field_chain(modules: [SemaGraphModuleResult], expression: TExpr) -> Bool Never! {
    if expression.ty == {
        .Apply(name, args) -> {
            if name == "Pin" && args.len() == 1 -> return false
        }
        else -> {}
    }
    if expression.kind == {
        .Local(_) -> true
        .Field(receiver, reference) -> jet_codegen_is_stored_field_chain(modules, receiver) && jet_codegen_is_stored_struct_field(modules, reference)
        else -> false
    }
}

fn jet_codegen_lower_field_expr(builder: &JetCodegenBuilder, expression: TExpr, receiver: TExpr, reference: TFieldRef) -> MirValueId {
    resolved := jet_codegen_resolve_field_by_symbol(builder.modules, reference)
    field_id := jet_codegen_mir_field_id(resolved)
    // Reading one stored field only needs that field: project the field place
    // and read it, instead of copying the whole receiver first (#3735).
    if jet_codegen_is_stored_field_chain(builder.modules, receiver) && jet_codegen_is_stored_struct_field(builder.modules, reference) {
        lowered := jet_codegen_lower_expression_place(&builder, receiver, MirAccess.Read)
        if lowered != None {
            base :: lowered ?? panic("checked stored-field receiver place disappeared")
            place := jet_codegen_project_field_place(&builder, base, expression.span, expression.ty, field_id)
            return jet_codegen_emit_value(&builder, expression.span, expression.ty, MirOperation.ReadPlace{place: place})
        }
    }
    base := jet_codegen_lower_expr(&builder, receiver)
    jet_codegen_emit_value(&builder, expression.span, expression.ty, MirOperation.Field{base: base, field: field_id})
}

fn jet_codegen_lower_optional_field(builder: &JetCodegenBuilder, expression: TExpr, base: TExpr, member: String, flatten: Bool) -> MirValueId {
    inner_type := if base.ty == {
        .Option(inner) -> inner
        else -> panic("checked optional field base is not optional")
    }
    resolved := jet_codegen_resolve_field_by_name(builder.modules, builder.function.module_identity, builder.generic_type_names, inner_type, member)
    field_id := jet_codegen_mir_field_id(resolved)
    selected_type := if {
        flatten -> expression.ty
        else -> if expression.ty == {
            .Option(inner) -> inner
            else -> panic("checked non-flattening optional field result is not optional")
        }
    }
    subject := jet_codegen_lower_expr(&builder, base)
    condition := jet_codegen_emit_value(&builder, expression.span, Type.Bool, MirOperation.OptionIsSome{subject: subject})
    present_block := jet_codegen_new_block(&builder, expression.span, "optional-field-present")
    absent_block := jet_codegen_new_block(&builder, expression.span, "optional-field-absent")
    join_block := jet_codegen_new_block(&builder, expression.span, "optional-field-join")
    jet_codegen_terminate(&builder, MirTerminator.Branch{condition: condition, then_target: present_block, else_target: absent_block})

    incoming := [MirPhiIncoming]{}
    jet_codegen_switch_block(&builder, present_block)
    unwrapped := jet_codegen_emit_value(&builder, base.span, inner_type, MirOperation.OptionValue{subject: subject})
    selected := jet_codegen_emit_value(&builder, expression.span, selected_type, MirOperation.Field{base: unwrapped, field: field_id})
    present := selected
    if !flatten -> present = jet_codegen_emit_value(&builder, expression.span, expression.ty, MirOperation.Present{value: selected})
    present_source := builder.current
    if jet_codegen_current_is_open(builder) {
        jet_codegen_terminate(&builder, MirTerminator.Jump{target: join_block})
        &incoming.push(MirPhiIncoming{block: present_source, value: present})
    }

    jet_codegen_switch_block(&builder, absent_block)
    absent := jet_codegen_emit_value(&builder, expression.span, expression.ty, MirOperation.Absent)
    absent_source := builder.current
    if jet_codegen_current_is_open(builder) {
        jet_codegen_terminate(&builder, MirTerminator.Jump{target: join_block})
        &incoming.push(MirPhiIncoming{block: absent_source, value: absent})
    }
    if incoming.len() == 0 {
        jet_codegen_switch_block(&builder, join_block)
        jet_codegen_terminate(&builder, MirTerminator.Unreachable{reason: "optional field has no reachable branch"})
        panic("checked optional field has no reachable branch")
    }
    jet_codegen_switch_block(&builder, join_block)
    jet_codegen_emit_value(&builder, expression.span, expression.ty, MirOperation.Phi{incoming: incoming})
}

// S71 / D-SUGAR6: `base?.method(args)` runs the checked call only on the
// present path. The payload is a read-only view of the evaluated optional, so
// the call never takes ownership of it and no extra drop is registered.
fn jet_codegen_lower_optional_method_call(builder: &JetCodegenBuilder, expression: TExpr, base: TExpr, binding: TLocal, call: TExpr, flatten: Bool) -> MirValueId {
    inner_type := if base.ty == {
        .Option(inner) -> inner
        else -> panic("checked optional method receiver is not optional")
    }
    subject := jet_codegen_lower_expr(&builder, base)
    condition := jet_codegen_emit_value(&builder, expression.span, Type.Bool, MirOperation.OptionIsSome{subject: subject})
    present_block := jet_codegen_new_block(&builder, expression.span, "optional-call-present")
    absent_block := jet_codegen_new_block(&builder, expression.span, "optional-call-absent")
    join_block := jet_codegen_new_block(&builder, expression.span, "optional-call-join")
    jet_codegen_terminate(&builder, MirTerminator.Branch{condition: condition, then_target: present_block, else_target: absent_block})

    incoming := [MirPhiIncoming]{}
    jet_codegen_switch_block(&builder, present_block)
    jet_codegen_enter_lexical(&builder)
    unwrapped := jet_codegen_emit_value(&builder, base.span, inner_type, MirOperation.OptionValue{subject: subject})
    view := jet_codegen_temporary_place(&builder, unwrapped, inner_type, base.span, MirAccess.Read)
    _ := jet_codegen_bind_local_alias(&builder, binding, inner_type, view, false)
    called := jet_codegen_lower_expr(&builder, call)
    present := called
    if !flatten && jet_codegen_current_is_open(builder) -> present = jet_codegen_emit_value(&builder, expression.span, expression.ty, MirOperation.Present{value: called})
    jet_codegen_leave_lexical(&builder)
    if jet_codegen_current_is_open(builder) {
        present_source := builder.current
        jet_codegen_terminate(&builder, MirTerminator.Jump{target: join_block})
        &incoming.push(MirPhiIncoming{block: present_source, value: present})
    }

    jet_codegen_switch_block(&builder, absent_block)
    absent := jet_codegen_emit_value(&builder, expression.span, expression.ty, MirOperation.Absent)
    absent_source := builder.current
    jet_codegen_terminate(&builder, MirTerminator.Jump{target: join_block})
    &incoming.push(MirPhiIncoming{block: absent_source, value: absent})
    jet_codegen_switch_block(&builder, join_block)
    jet_codegen_emit_value(&builder, expression.span, expression.ty, MirOperation.Phi{incoming: incoming})
}


fn jet_codegen_lower_struct_literal(builder: &JetCodegenBuilder, expression: TExpr, fields: [TStructFieldValue], extra: TStructExtra?, as_trait: TCoercionTarget?) -> MirValueId {
    if as_trait != None -> jet_codegen_require_trait_box_target(expression.ty, &builder)
    owner := if as_trait == {
        None -> jet_codegen_mir_type_id_for_type(builder.modules, builder.function.module_identity, builder.generic_type_names, expression.ty)
        Val(target) -> jet_codegen_mir_type_id_for_symbol(builder.modules, target.concrete_type)
    }
    trait_coercion := if as_trait == {
        None -> None
        Val(target) -> Val(jet_codegen_mir_type_id_for_symbol(builder.modules, target.trait_symbol))
    }
    lowered_fields := [MirFieldValue]{}
    boxed_fields := [MirFieldId]{}
    loop field in fields {
        resolved := jet_codegen_resolve_field_by_symbol(builder.modules, field.field)
        field_id := jet_codegen_mir_field_id(resolved)
        value := jet_codegen_lower_expr(&builder, field.value)
        &lowered_fields.push(MirFieldValue{field: field_id, value: value})
        if field.boxed -> &boxed_fields.push(field_id)
    }
    extra_fact := if extra == {
        None -> None
        Val(value) -> if value == {
            .HTTPRequestParams -> Val(MirStructExtra.HttpRequestParams)
        }
    }
    jet_codegen_emit_value(&builder, expression.span, expression.ty, MirOperation.Semantic{operation: MirSemanticOp.StructLiteral{type_id: owner, fields: lowered_fields, extra: extra_fact, trait_coercion: trait_coercion, boxed_fields: boxed_fields}})
}

fn jet_codegen_lower_comptime_key(value: TComptimeKey) -> MirConstKey? {
    if value == {
        .Int(number) -> Val(MirConstKey.Int{value: number})
        .String(text) -> Val(MirConstKey.String{value: text})
        .Bool(flag) -> Val(MirConstKey.Bool{value: flag})
        .Char(character) -> Val(MirConstKey.Char{value: character})
        .Tuple(fields) -> {
            lowered := [MirConstKeyField]{}
            loop field in fields {
                key :: jet_codegen_lower_comptime_key(field.key) ?? return None
                &lowered.push(MirConstKeyField{name: field.name, key: key})
            }
            Val(MirConstKey.Tuple{fields: lowered})
        }
        .Struct(type_name, fields) -> {
            lowered := [MirConstKeyField]{}
            loop field in fields {
                key :: jet_codegen_lower_comptime_key(field.key) ?? return None
                &lowered.push(MirConstKeyField{name: field.name, key: key})
            }
            Val(MirConstKey.Struct{type_name: type_name, fields: lowered})
        }
        .Enum(type_name, variant) -> Val(MirConstKey.Enum{type_name: type_name, variant: variant})
    }
}

fn jet_codegen_lower_comptime_value(value: TComptimeValue, modules: [SemaGraphModuleResult], module_identity: String, generic_names: [String]) -> MirConstant? {
    if value == {
        .Int(number) -> Val(MirConstant.Int{value: number, width: None, spelling: None})
        .Float(number, bits) -> Val(MirConstant.Float{value: number, f32: bits == 32, spelling: None})
        .Bool(flag) -> Val(MirConstant.Bool{value: flag})
        .Char(character) -> Val(MirConstant.Char{value: character})
        .String(text) -> Val(MirConstant.String{value: text})
        .BigInt(decimal) -> Val(MirConstant.BigInt{decimal: decimal})
        .Bytes(bytes) -> Val(MirConstant.Bytes{value: bytes})
        .List(values) -> {
            lowered := [MirConstant]{}
            loop item in values {
                lowered_value :: jet_codegen_lower_comptime_value(item, modules, module_identity, generic_names) ?? return None
                &lowered.push(lowered_value)
            }
            Val(MirConstant.List{values: lowered})
        }
        .Map(entries) -> {
            lowered := [MirConstMapEntry]{}
            loop entry in entries {
                key :: jet_codegen_lower_comptime_key(entry.key) ?? return None
                item :: jet_codegen_lower_comptime_value(entry.value, modules, module_identity, generic_names) ?? return None
                &lowered.push(MirConstMapEntry{key: key, value: item})
            }
            Val(MirConstant.Map{entries: lowered})
        }
        .Struct(type_name, fields) -> {
            lowered := [MirConstField]{}
            loop field in fields {
                item :: jet_codegen_lower_comptime_value(field.value, modules, module_identity, generic_names) ?? return None
                &lowered.push(MirConstField{name: field.name, value: item})
            }
            Val(MirConstant.Struct{type_name: type_name, fields: lowered})
        }
        .Enum(type_name, variant, args) -> {
            lowered := [MirConstEnumArg]{}
            loop arg in args {
                item :: jet_codegen_lower_comptime_value(arg.value, modules, module_identity, generic_names) ?? return None
                &lowered.push(MirConstEnumArg{name: arg.name, value: item})
            }
            Val(MirConstant.Enum{type_name: type_name, variant: variant, args: lowered})
        }
        .Present(inner) -> {
            lowered :: jet_codegen_lower_comptime_value(inner, modules, module_identity, generic_names) ?? return None
            Val(MirConstant.Present{value: lowered})
        }
        .Failed(report) -> {
            lowered_report := if report == {
                .Clean(ty) -> MirConstReport.Clean{ty: jet_codegen_lower_type_with_modules(ty, modules, module_identity, generic_names)}
                .Told(inner) -> {
                    lowered :: jet_codegen_lower_comptime_value(inner, modules, module_identity, generic_names) ?? return None
                    MirConstReport.Told{value: lowered}
                }
            }
            Val(MirConstant.Failed{report: lowered_report})
        }
        .Unit -> Val(MirConstant.Unit)
        .Closure(_) -> None
    }
}

fn jet_codegen_lower_string_part(builder: &JetCodegenBuilder, part: TStrPart) -> MirStringPart {
    if part == {
        .Literal(text) -> MirStringPart{kind: MirStringPartKind.Literal{text: text}}
        .Interpolation(value, format) -> {
            lowered := jet_codegen_lower_expr(&builder, value)
            MirStringPart{kind: MirStringPartKind.Interpolation{value: lowered, format: jet_codegen_lower_string_format(format)}}
        }
    }
}

fn jet_codegen_lower_map_entry(builder: &JetCodegenBuilder, entry: TMapEntry) -> MirMapEntry {
    key := jet_codegen_lower_expr(&builder, entry.key)
    value := jet_codegen_lower_expr(&builder, entry.value)
    MirMapEntry{key: key, value: value}
}

fn jet_codegen_lower_compare_chain(builder: &JetCodegenBuilder, expression: TExpr, operands: [TExpr], operators: [TBinaryOp], hooks: [Bool]) -> MirValueId {
    if operands.len() == 0 -> panic("checked comparison chain has no operands")
    if operators.len() == 0 -> panic("checked comparison chain has no operators")
    if operands.len() != operators.len() + 1 -> panic("checked comparison chain has inconsistent operands and operators")
    false_block := jet_codegen_new_block(&builder, expression.span, "compare-chain-false")
    true_block := jet_codegen_new_block(&builder, expression.span, "compare-chain-true")
    join_block := jet_codegen_new_block(&builder, expression.span, "compare-chain-join")
    left := jet_codegen_lower_expr(&builder, operands[0])
    index := 0
    loop index < operators.len() {
        right := jet_codegen_lower_expr(&builder, operands[index + 1])
        if index < hooks.len() && hooks[index] -> panic("checked comparison hook lies outside the current Jet codegen contract")
        comparison := jet_codegen_emit_value(&builder, expression.span, Type.Bool, MirOperation.Binary{op: jet_codegen_lower_binary(operators[index]), dispatch: MirBinaryDispatch.Primitive, overflow: MirBinaryOverflow.Unchecked, left: left, right: right})
        next_block := true_block
        if index + 1 < operators.len() -> next_block = jet_codegen_new_block(&builder, expression.span, "compare-chain-next")
        jet_codegen_terminate(&builder, MirTerminator.Branch{condition: comparison, then_target: next_block, else_target: false_block})
        if index + 1 < operators.len() {
            jet_codegen_switch_block(&builder, next_block)
            left = right
        }
        index += 1
    }
    jet_codegen_switch_block(&builder, true_block)
    true_value := jet_codegen_emit_value(&builder, expression.span, Type.Bool, MirOperation.Constant{value: MirConstant.Bool{value: true}})
    jet_codegen_terminate(&builder, MirTerminator.Jump{target: join_block})
    true_predecessor := builder.current
    jet_codegen_switch_block(&builder, false_block)
    false_value := jet_codegen_emit_value(&builder, expression.span, Type.Bool, MirOperation.Constant{value: MirConstant.Bool{value: false}})
    jet_codegen_terminate(&builder, MirTerminator.Jump{target: join_block})
    false_predecessor := builder.current
    jet_codegen_switch_block(&builder, join_block)
    incoming := [MirPhiIncoming]{
        MirPhiIncoming{block: true_predecessor, value: true_value},
        MirPhiIncoming{block: false_predecessor, value: false_value},
    }
    jet_codegen_emit_value(&builder, expression.span, expression.ty, MirOperation.Phi{incoming: incoming})
}
fn jet_codegen_lower_if_expression(builder: &JetCodegenBuilder, expression: TExpr, condition: TIfCond, then_body: [TStmt], then_value: TExpr, else_body: [TStmt], else_value: TExpr) -> MirValueId {
    outer_depth := builder.scope_depth
    jet_codegen_enter_lexical(&builder)
    condition_value := jet_codegen_lower_condition(&builder, condition)
    then_block := jet_codegen_new_block(&builder, expression.span, "if-expression-then")
    else_block := jet_codegen_new_block(&builder, expression.span, "if-expression-else")
    join_block := jet_codegen_new_block(&builder, expression.span, "if-expression-join")
    jet_codegen_terminate(&builder, MirTerminator.Branch{condition: condition_value, then_target: then_block, else_target: else_block})
    incoming := [MirPhiIncoming]{}
    jet_codegen_switch_block(&builder, then_block)
    jet_codegen_lower_block(&builder, then_body)
    if jet_codegen_current_is_open(builder) {
        value := jet_codegen_lower_expr(&builder, then_value)
        if jet_codegen_current_is_open(builder) {
            predecessor := builder.current
            jet_codegen_terminate(&builder, MirTerminator.Jump{target: join_block})
            &incoming.push(MirPhiIncoming{block: predecessor, value: value})
        }
    }
    builder.scope_depth = outer_depth
    jet_codegen_switch_block(&builder, else_block)
    jet_codegen_lower_block(&builder, else_body)
    if jet_codegen_current_is_open(builder) {
        value := jet_codegen_lower_expr(&builder, else_value)
        if jet_codegen_current_is_open(builder) {
            predecessor := builder.current
            jet_codegen_terminate(&builder, MirTerminator.Jump{target: join_block})
            &incoming.push(MirPhiIncoming{block: predecessor, value: value})
        }
    }
    builder.scope_depth = outer_depth + 1
    jet_codegen_leave_lexical(&builder)
    if incoming.len() == 0 {
        jet_codegen_switch_block(&builder, join_block)
        jet_codegen_terminate(&builder, MirTerminator.Unreachable{reason: "every conditional arm diverges"})
        return jet_codegen_emit_value(&builder, expression.span, Type.Named{name: "Unit"}, MirOperation.Constant{value: MirConstant.Unit})
    }
    jet_codegen_switch_block(&builder, join_block)
    jet_codegen_emit_value(&builder, expression.span, expression.ty, MirOperation.Phi{incoming: incoming})
}

fn jet_codegen_signature_call_args(builder: &JetCodegenBuilder, args: [TCallArg], signature: Type) -> [MirCallArg] {
    labels := [String]{}
    variadic := [Bool]{}
    conventions := [AccessConvention]{}
    if signature == {
        .Fn(params, _, _, contract, metadata, _) -> {
            index := 0
            loop _ in params {
                label := ""
                convention := AccessConvention.Read
                is_variadic := false
                if contract != None && index < (contract ?? [CallContractRow]{}).len() -> label = (contract ?? [CallContractRow]{})[index].label
                if metadata != None {
                    facts :: metadata ?? FunctionCallMetadata{names: [String]{}, defaults: [FunctionDefaultRef?]{}, variadic: [Bool]{}, conventions: [AccessConvention]{}, policies: CallablePolicyChain{policies: [CallablePolicy]{}}}
                    if label == "" && index < facts.names.len() -> label = facts.names[index]
                    if index < facts.conventions.len() -> convention = facts.conventions[index]
                    if index < facts.variadic.len() -> is_variadic = facts.variadic[index]
                }
                &labels.push(label)
                &conventions.push(convention)
                &variadic.push(is_variadic)
                index += 1
            }
        }
        else -> panic("checked indirect-call signature is not callable")
    }
    jet_codegen_lower_call_args_for_signature(&builder, args, labels, variadic, conventions)
}

fn jet_codegen_function_id_for_name(builder: JetCodegenBuilder, name: String) -> MirFunctionId Never! {
    found := None
    loop function in builder.functions {
        if function.key == name {
            if found != None -> panic("checked named function key is ambiguous")
            found = Val(function)
        }
    }
    function :: found ?? panic("checked named function has no reachable TFunc")
    jet_codegen_function_id(function)
}

fn jet_codegen_lower_named_function_value(builder: &JetCodegenBuilder, expression: TExpr, name: String, send: Bool) -> MirValueId Never! {
    function := jet_codegen_function_id_for_name(builder, name)
    operation := MirOperation.Closure{function: function, captures: [MirCaptureOperand]{}, facts: MirCaptureFacts{
        escapes: false,
        needs_fn_mut: false,
        mutable: [String]{},
        cloned: [String]{},
        frozen: [String]{},
        materialized: [String]{},
        moved: [String]{},
    }}
    if send -> return jet_codegen_emit_mir_type(&builder, expression.span, jet_codegen_send_function_type(builder, expression.ty), jet_codegen_ownership(expression.ty), operation)
    jet_codegen_emit_value(&builder, expression.span, expression.ty, operation)
}

fn jet_codegen_lower_host_borrow_callback(builder: &JetCodegenBuilder, expression: TExpr, callable: TExpr, params: [Type], send: Bool) -> MirValueId {
    callable_value := if {
        send -> {
            if callable.kind == {
                .Lambda(lambda) -> jet_codegen_lower_lambda(&builder, lambda, true, "direct").value
                .FnValue(kind) -> if kind == {
                    .NamedFn(name, lambda) -> {
                        if lambda != None -> jet_codegen_lower_lambda(&builder, lambda ?? panic("checked named lambda disappeared"), true, "direct").value
                        jet_codegen_lower_named_function_value(&builder, callable, name ?? panic("checked SendFn named function has no key"), true)
                    }
                    .Send(_) | .Local(_) -> jet_codegen_lower_expr(&builder, callable)
                    else -> panic("checked SendFn HostBorrowCallback requires a named function, lambda, or SendFn local")
                }
                .Local(_) -> jet_codegen_lower_expr(&builder, callable)
                else -> panic("checked SendFn HostBorrowCallback requires a named function, lambda, or SendFn local")
            }
        } else -> {
            jet_codegen_lower_expr(&builder, callable)
        }
    }
    lowered_params := [MirType]{}
    loop ty in params -> &lowered_params.push(jet_codegen_lower_type_for_function(ty, builder))
    operation := MirOperation.Semantic{operation: MirSemanticOp.HostBorrowCallback{callable: callable_value, params: lowered_params}}
    if send -> return jet_codegen_emit_mir_type(&builder, expression.span, jet_codegen_send_function_type(builder, expression.ty), jet_codegen_ownership(expression.ty), operation)
    jet_codegen_emit_value(&builder, expression.span, expression.ty, operation)
}

fn jet_codegen_lower_fn_value(builder: &JetCodegenBuilder, expression: TExpr, kind: TFnValueKind) -> MirValueId {
    if kind == {
        .NamedFn(name, lambda) -> {
            if lambda != None -> return jet_codegen_lower_lambda(&builder, lambda ?? panic("checked named lambda disappeared"), false, "direct").value
            return jet_codegen_lower_named_function_value(&builder, expression, name ?? panic("checked named function has no key"), false)
        }
        .Call(callee, args) -> {
            callee_value := jet_codegen_lower_expr(&builder, callee)
            lowered_args := jet_codegen_signature_call_args(&builder, args, callee.ty)
            return jet_codegen_emit_value(&builder, expression.span, jet_codegen_callable_return_type(callee.ty), MirOperation.IndirectCall{callee: callee_value, args: lowered_args, type_args: [MirType]{}})
        }
        .Policy(fn_type, policy_args, policy_conventions, wrapper_name, captures, callee) -> {
            if wrapper_name != None {
                params := [Type]{}
                ret := None
                if fn_type == {
                    .Fn(source_types, source_ret, _, _, _, _) -> {
                        params = source_types
                        ret = source_ret
                    }
                    else -> panic("checked callable policy does not carry a function type")
                }
                source_params := [String]{}
                args := policy_args
                &args.push(TCallArg{
                    value: callee,
                    template_items: [SymbolId]{},
                    borrow: true,
                    mut_borrow: false,
                    clone: false,
                    arc_clone: false,
                    fn_coerce: None,
                    widen_to_vec: false,
                    widen_to_union: None,
                    box_as_trait: None,
                    label: None,
                    spread: false,
                })
                index := 0
                loop ty in params {
                    name := "policy_arg_{index}"
                    &source_params.push(name)
                    value := TExpr{ty: ty, kind: TExprKind.Local{local: tir_user_local(name, expression.span)}, span: expression.span, integer_bounds: None, cost: None}
                    &args.push(TCallArg{
                        value: value,
                        template_items: [SymbolId]{},
                        borrow: !jet_codegen_is_copy_type(ty),
                        mut_borrow: false,
                        clone: false,
                        arc_clone: false,
                        fn_coerce: None,
                        widen_to_vec: false,
                        widen_to_union: None,
                        box_as_trait: None,
                        label: None,
                        spread: false,
                    })
                    index += 1
                }
                return_type := ret ?? Type.Named{name: "Unit"}
                body := TExpr{
                    ty: return_type,
                    kind: TExprKind.Call{callee: SymbolId{key: wrapper_name ?? ""}, type_args: [Type]{}, args: args},
                    span: expression.span,
                    integer_bounds: None,
                    cost: None,
                }
                lambda := TLambda{
                    executable: TLambdaBody.Expr{value: body},
                    source_span: expression.span,
                    frame_schedule: None,
                    frame_schedule_derivation: None,
                    capture_facts: TCaptureFacts{escapes: false, needs_fn_mut: false, mutable: [String]{}, cloned: [String]{}, frozen: [String]{}, materialized: [String]{}, moved: [String]{}},
                    failure_carrier: TFailureCarrier.Infallible,
                    effects: TEffectFacts{direct: [String]{}, solved: [String]{}, call_edges: [String]{}, maximal: false, direct_spans: [TEffectSpan]{}},
                    host_param_conventions: None,
                    source_params: source_params,
                    source_param_symbols: [SymbolId]{},
                    jit_name: "policy@{expression.span.start}",
                    param_types: params,
                    ret: Val(return_type),
                    is_move: true,
                    boxed: false,
                    rc: false,
                    arc: false,
                    captures: captures,
                    materialized_captures: [String]{},
                    frozen_captures: [String]{},
                    uses_stack_sentry: false,
                }
                return jet_codegen_lower_lambda(&builder, lambda, false, "callable-policy").value
            }
            policy := jet_codegen_lower_expr(&builder, callee)
            lowered_args := jet_codegen_signature_call_args(&builder, policy_args, callee.ty)
            index := 0
            loop arg in lowered_args {
                if index < policy_conventions.len() -> arg.access = jet_codegen_lower_access(policy_conventions[index])
                lowered_args[index] = arg
                index += 1
            }
            lowered_values := [MirValueId]{}
            loop arg in lowered_args -> &lowered_values.push(arg.value)
            jet_codegen_emit_value(&builder, expression.span, expression.ty, MirOperation.Semantic{operation: MirSemanticOp.PolicyFunction{policy: policy, values: lowered_values}})
        }
        .Send(value) -> {
            if value.kind == {
                .Lambda(lambda) -> return jet_codegen_lower_lambda(&builder, lambda, true, "direct").value
                .FnValue(inner) -> if inner == {
                    .NamedFn(name, lambda) -> {
                        if lambda != None -> return jet_codegen_lower_lambda(&builder, lambda ?? panic("checked named lambda disappeared"), true, "direct").value
                        return jet_codegen_lower_named_function_value(&builder, value, name ?? panic("checked SendFn named function has no key"), true)
                    }
                    else -> {}
                }
                .HostBorrowCallback(callable, params) -> return jet_codegen_lower_host_borrow_callback(&builder, value, callable, params, true)
                .Local(_) -> {}
                else -> panic("checked SendFn requires a named function, lambda, or SendFn local")
            }
            lowered := jet_codegen_lower_expr(&builder, value)
            target := jet_codegen_send_function_type(builder, expression.ty)
            return jet_codegen_emit_mir_type(&builder, expression.span, target, jet_codegen_ownership(expression.ty), MirOperation.Convert{value: lowered, parameters: [MirValueId]{}, target: target, conversion: MirConversion.SendFn})
        }
    }
}

fn jet_codegen_lower_math_builtin(builder: &JetCodegenBuilder, expression: TExpr, type_name: String, function: String, args: [TExpr]) -> MirValueId {
    values := [MirValueId]{}
    loop argument in args -> &values.push(jet_codegen_lower_expr(&builder, argument))
    jet_codegen_emit_math_builtin(&builder, expression, type_name, function, values)
}

fn jet_codegen_emit_math_builtin(builder: &JetCodegenBuilder, expression: TExpr, type_name: String, function: String, values: [MirValueId]) -> MirValueId Never! {
    carrier := jet_codegen_failure_carrier_for_type(expression.ty)
    symbol := "jet_math_{type_name}_{function}"
    module_name := type_name
    if function == "abs" {
        module_name = "core.math"
        symbol = if {
            type_name == "Int" && expression.ty == Type.Int -> {
                "jet_std::jet_int_abs"
            }
            type_name == "Float" && expression.ty == Type.Float -> {
                "jet_std_math_abs_f64"
            }
            type_name == "F32" && expression.ty == Type.Float32 -> {
                "jet_std_math_abs_f32"
            }
            type_name == "Complex" && expression.ty == Type.Float -> {
                "jet_complex_abs"
            }
            else -> {
                panic("checked abs builtin has no canonical typed route")
            }
        }
    }
    borrow_mask := [Bool]{}
    loop _ in values -> &borrow_mask.push(false)
    call := jet_codegen_intern_route(&builder, MirPreludeFamily.MathBuiltin, module_name, function, symbol, values.len(), borrow_mask, None, carrier, MirPreludeAbi.Value)
    math_type := if type_name == {
        "Int" -> Type.Int
        "Float" -> Type.Float
        "F32" | "Float32" -> Type.Float32
        else -> Type.Named{name: type_name}
    }
    type_id := jet_codegen_lower_type_for_function(math_type, &builder).identity ?? panic("checked math builtin type has no MIR identity")
    jet_codegen_note_core_module(&builder, "core.math")
    jet_codegen_emit_value(&builder, expression.span, expression.ty, MirOperation.Semantic{operation: MirSemanticOp.MathBuiltin{type_id: type_id, call: call, args: values}})
}

fn jet_codegen_enum_definition(builder: &JetCodegenBuilder, enum_type: String) -> TTypeDef Never! {
    identity_option := jet_codegen_find_nominal_identity(builder.modules, builder.function.module_identity, enum_type, builder.generic_type_names)
    identity :: identity_option ?? panic("checked enum literal has no registered nominal type")
    loop semantic_module in builder.modules {
        if semantic_module.module_identity != identity.module_identity -> next
        loop definition in semantic_module.declarations.type_defs {
            if definition.name == identity.name -> return definition
        }
    }
    panic("checked enum literal has no declaration facts")
}

fn jet_codegen_enum_variant(definition: TTypeDef, variant_name: String) -> TVariant Never! {
    if definition.kind == {
        .Enum(variants, _) -> {
            loop variant in variants {
                if variant.name == variant_name -> return variant
            }
        }
        else -> {}
    }
    panic("checked enum literal names an unknown variant")
}

fn jet_codegen_lower_enum_argument(builder: &JetCodegenBuilder, argument: TEnumArg) -> MirValueId {
    value := jet_codegen_lower_expr(&builder, argument.value)
    if argument.clone -> return jet_codegen_emit_value(&builder, argument.value.span, argument.value.ty, MirOperation.Copy{value: value, materialize_view: false})
    value
}

fn jet_codegen_lower_enum_payload(builder: &JetCodegenBuilder, definition: TTypeDef, variant_name: String, payload: TEnumPayload) -> [MirEnumArg] {
    if payload == {
        .Unit -> return [MirEnumArg]{}
        .Positional(args) -> {
            lowered := [MirEnumArg]{}
            loop argument in args -> &lowered.push(MirEnumArg{field: None, value: jet_codegen_lower_enum_argument(&builder, argument), boxed: false})
            return lowered
        }
        .Named(args) -> {
            variant := jet_codegen_enum_variant(definition, variant_name)
            fields := if variant.payload == {
                .Named(values) -> values
                else -> panic("checked named enum payload does not match its declaration")
            }
            lowered := [MirEnumArg]{}
            orders := [Int]{}
            loop argument in args {
                field_index := None
                index := 0
                loop index < fields.len() {
                    if fields[index].name == argument.name {
                        field_index = Val(index)
                        break
                    }
                    index += 1
                }
                order :: field_index ?? panic("checked enum payload field is not declared")
                owner_key := "{definition.key}::{variant_name}"
                field_id := mir_field_id("{owner_key}::{argument.name}")
                item := MirEnumArg{field: Val(field_id), value: jet_codegen_lower_enum_argument(&builder, argument.value), boxed: false}
                insert_at := lowered.len()
                check := 0
                loop check < orders.len() {
                    if orders[check] == order -> panic("checked enum payload repeats a field")
                    if order < orders[check] && insert_at == lowered.len() -> insert_at = check
                    check += 1
                }
                if {
                    insert_at == lowered.len() -> {
                        &orders.push(order)
                        &lowered.push(item)
                    } else -> {
                        &orders.push(0)
                        &lowered.push(item)
                        cursor := lowered.len() - 1
                        loop cursor > insert_at {
                            orders[cursor] = orders[cursor - 1]
                            lowered[cursor] = lowered[cursor - 1]
                            cursor -= 1
                        }
                        orders[insert_at] = order
                        lowered[insert_at] = item
                    }
                }
            }
            return lowered
        }
    }
}

fn jet_codegen_lower_enum_literal(builder: &JetCodegenBuilder, expression: TExpr, enum_type: String, variant: String, payload: TEnumPayload) -> MirValueId {
    definition := jet_codegen_enum_definition(&builder, enum_type)
    type_id := jet_codegen_type_instance_id(Type.Named{name: enum_type}, builder.modules, builder.function.module_identity, builder.generic_type_names)
    args := jet_codegen_lower_enum_payload(&builder, definition, variant, payload)
    jet_codegen_emit_value(&builder, expression.span, expression.ty, MirOperation.Enum{type_id: type_id, variant: variant, args: args})
}

fn jet_codegen_lower_enum_constructor(builder: &JetCodegenBuilder, expression: TExpr, owner: SymbolId, variant: SymbolId, payload: [TEnumArg]) -> MirValueId {
    loop semantic_module in builder.modules {
        loop nominal in semantic_module.nominals {
            if nominal.symbol.id.key != owner.key -> next
            loop candidate in nominal.variants {
                if candidate.symbol.id.key != variant.key -> next
                definition := None
                loop declared in semantic_module.declarations.type_defs {
                    if declared.name == nominal.symbol.name -> definition = Val(declared)
                }
                declared :: definition ?? panic("checked enum constructor has no type declaration")
                lowered := [MirEnumArg]{}
                if candidate.payload == {
                    .Unit -> {
                        if payload.len() != 0 -> panic("checked unit enum constructor carries a payload")
                    }
                    .Single(_, _) -> {
                        if payload.len() != 1 -> panic("checked enum constructor has the wrong payload arity")
                        value := jet_codegen_lower_enum_argument(&builder, payload[0])
                        &lowered.push(MirEnumArg{field: None, value: value, boxed: false})
                    }
                    .Named(fields) -> {
                        if payload.len() != fields.len() -> panic("checked enum constructor has the wrong named payload arity")
                        index := 0
                        loop index < fields.len() {
                            field := fields[index]
                            field_id := mir_field_id("{declared.key}::{candidate.symbol.name}::{field.name}")
                            value := jet_codegen_lower_enum_argument(&builder, payload[index])
                            &lowered.push(MirEnumArg{field: Val(field_id), value: value, boxed: false})
                            index += 1
                        }
                    }
                }
                type_id := jet_codegen_type_instance_id(expression.ty, builder.modules, builder.function.module_identity, builder.generic_type_names)
                return jet_codegen_emit_value(&builder, expression.span, expression.ty, MirOperation.Enum{type_id: type_id, variant: candidate.symbol.name, args: lowered})
            }
            panic("checked enum constructor variant does not belong to its owner")
        }
    }
    panic("checked enum constructor has no registered nominal owner")
}
fn jet_codegen_symbol_name(builder: &JetCodegenBuilder, symbol: SymbolId) -> String Never! {
    loop semantic_module in builder.modules {
        loop nominal in semantic_module.nominals {
            if nominal.symbol.id.key == symbol.key -> return nominal.symbol.name
        }
    }
    panic("checked method trait has no registered symbol")
}

fn jet_codegen_resolve_trait_method(builder: &JetCodegenBuilder, method: TMethodRef) -> JetCodegenTraitMethod Never! {
    symbol :: method.trait_owner ?? panic("checked trait method call has no trait owner")
    selected := None
    loop semantic_module in builder.modules {
        loop nominal in semantic_module.nominals {
            if nominal.symbol.id.key != symbol.key -> next
            if nominal.kind != SemaRegistrationNominalKind.Trait -> panic("checked trait method owner is not a trait")
            loop definition in semantic_module.declarations.traits {
                if definition.name != nominal.symbol.name -> next
                loop trait_method in definition.methods {
                    method_symbol := symbol_id(SymbolKind.Function, semantic_module.module_identity, nominal.symbol.id.key, trait_method.name)
                    if trait_method.name == method.name && method_symbol.key == method.symbol.key {
                        if selected != None -> panic("checked trait method identity is ambiguous")
                        selected = Val(JetCodegenTraitMethod{trait_key: definition.key, method: trait_method})
                    }
                }
            }
        }
    }
    selected ?? panic("checked trait method declaration is unreachable")
}

fn jet_codegen_method_function(builder: &JetCodegenBuilder, method: TMethodRef) -> TFunc? {
    selected := None
    loop function in builder.functions {
        if function.key != method.symbol.key -> next
        if method.operator_identity != None {
            owner_type := if function.kind == {
                .Method(_, owner) | .TraitMethod(_, _, owner, _, _) -> owner
                else -> next
            }
            trait_symbol :: method.trait_owner ?? next
            trait_name := jet_codegen_symbol_name(&builder, trait_symbol)
            if function.params.len() == 0 -> next
            identity := "{type_name(owner_type)}::{trait_name}::{method.name}<{type_name(function.params[0].ty)}>"
            if method.operator_identity != (Val(identity)) -> next
        }
        if selected != None -> panic("checked method function identity is ambiguous")
        selected = Val(function)
    }
    selected
}

fn jet_codegen_method_trait_dispatch(builder: &JetCodegenBuilder, receiver: TExpr, method: TMethodRef) -> Bool Never! {
    if method.trait_owner == None -> return false
    if receiver.ty == {
        .TraitObject(_) -> return true
        .Named(name) | .Apply(name, _) -> return builder.generic_type_names.contains(name)
        else -> return false
    }
}

fn jet_codegen_method_receiver_arg(builder: &JetCodegenBuilder, receiver: TExpr, access: MirAccess) -> MirCallArg {
    place := None
    if access != MirAccess.Read -> place = jet_codegen_lower_expression_place(&builder, receiver, access)
    if place == None && access == MirAccess.Write {
        value := jet_codegen_lower_expr(&builder, receiver)
        local := tir_generated_local("method_receiver_{value.value}", receiver.span)
        local.mutable = true
        temporary := jet_codegen_bind_local(&builder, local, receiver.ty, true, None, None, false)
        _ := jet_codegen_emit(&builder, receiver.span, None, MirOperation.WritePlace{place: temporary, value: value})
        place = Val(temporary)
    }
    value := if {
        access == MirAccess.Read || place == None -> {
            jet_codegen_lower_expr(&builder, receiver)
        } else -> {
            target := place ?? panic("checked method receiver has no place")
            operation := if access == MirAccess.Write -> MirOperation.AddressOf{place: target, access: access} else -> MirOperation.MovePlace{place: target}
            jet_codegen_emit_value(&builder, receiver.span, receiver.ty, operation)
        }
    }
    MirCallArg{
        value: value,
        place: if access == MirAccess.Write -> place else -> None,
        access: access,
        span: receiver.span,
        label: None,
        source_index: None,
        binder_slot: None,
        spread: false,
        implicit_clone: false,
        shared_auto_clone: false,
        owned_last_use: access == MirAccess.Move,
        authority_boundary: false,
        fn_coercion: None,
        widen_fixed_to_list: false,
        widen_to_union: None,
        box_as_trait: None,
    }
}

fn jet_codegen_lower_trait_method_args(builder: &JetCodegenBuilder, args: [TCallArg], signature: TTraitMethod) -> [MirCallArg] {
    labels := [String]{}
    variadic := [Bool]{}
    conventions := [AccessConvention]{}
    loop parameter in signature.params {
        &labels.push(parameter.public_label)
        &variadic.push(parameter.variadic)
        &conventions.push(parameter.access)
    }
    jet_codegen_lower_call_args_for_signature(&builder, args, labels, variadic, conventions)
}

fn jet_codegen_checked_function_return_type(function: TFunc, type_args: [Type]) -> Type Never! {
    return_type := function.ret ?? Type.Named{name: "Unit"}
    if function.generic_params.len() == 0 -> return return_type
    if function.generic_params.len() != type_args.len() -> panic("checked generic call has incomplete return-type arguments")
    names := [String]{}
    loop parameter in function.generic_params -> &names.push(parameter.name)
    sema_inference_substitute_type(return_type, names, type_args)
}

fn jet_codegen_checked_method_return_type(builder: &JetCodegenBuilder, function: TFunc, receiver_type: Type, type_args: [Type]) -> Type Never! {
    return_type := function.ret ?? Type.Named{name: "Unit"}
    if function.generic_params.len() != type_args.len() -> panic("checked generic call has incomplete return-type arguments")
    names := [String]{}
    arguments := [Type]{}
    index := 0
    loop index < function.generic_params.len() {
        &names.push(function.generic_params[index].name)
        &arguments.push(type_args[index])
        index += 1
    }
    owner_names := jet_codegen_function_type_generic_names(function, builder.modules)
    if owner_names.len() > 0 {
        owner_bindings := jet_codegen_function_owner_bindings(function, jet_codegen_unwrap_pattern_tags(receiver_type), builder.modules)
        if !owner_bindings.complete -> panic("checked method receiver has incomplete owner type arguments")
        index = 0
        loop index < owner_bindings.names.len() {
            if !names.contains(owner_bindings.names[index]) {
                &names.push(owner_bindings.names[index])
                &arguments.push(owner_bindings.arguments[index])
            }
            index += 1
        }
    }
    sema_inference_substitute_type(return_type, names, arguments)
}

fn jet_codegen_callable_return_type(signature: Type) -> Type Never! {
    if signature == {
        .Fn(_, ret, _, _, _, _) -> return ret ?? Type.Named{name: "Unit"}
        else -> panic("checked indirect call signature is not callable")
    }
}
fn jet_codegen_expression_call_return_type(builder: &JetCodegenBuilder, expression: TExpr) -> Type? {
    if expression.kind == {
        .Call(callee, type_args, _) -> {
            if jet_codegen_find_checked_foreign_row(builder.modules, callee.key) != None -> return None
            target :: jet_codegen_find_function(builder.functions, callee.key) ?? panic("checked call has no TFunc target")
            return Val(jet_codegen_checked_function_return_type(target, type_args))
        }
        .MethodCall(receiver, method, type_args, _) -> {
            dynamic_trait := jet_codegen_method_trait_dispatch(&builder, receiver, method)
            target := None
            if !dynamic_trait -> target = jet_codegen_method_function(&builder, method)
            if target == None && method.trait_owner != None -> dynamic_trait = true
            if dynamic_trait -> return Val(jet_codegen_resolve_trait_method(&builder, method).method.return_type)
            function :: target ?? panic("checked method call has no TFunc target")
            return Val(jet_codegen_checked_method_return_type(&builder, function, receiver.ty, type_args))
        }
        .IndirectCall(_, _, _, signature) -> return Val(jet_codegen_callable_return_type(signature))
        .FnValue(kind) -> if kind == {
            .Call(callee, _) -> return Val(jet_codegen_callable_return_type(callee.ty))
            else -> return None
        }
        else -> return None
    }
}
fn jet_codegen_lower_method_call(builder: &JetCodegenBuilder, expression: TExpr, receiver: TExpr, method: TMethodRef, type_args: [Type], args: [TCallArg]) -> MirValueId {
    dynamic_trait := jet_codegen_method_trait_dispatch(&builder, receiver, method)
    target := None
    if !dynamic_trait -> target = jet_codegen_method_function(&builder, method)
    if target == None && method.trait_owner != None -> dynamic_trait = true
    owner := jet_codegen_lower_type_for_function(receiver.ty, builder)
    callee := None
    access := MirAccess.Read
    call_return_type := expression.ty
    lowered_args := [MirCallArg]{}
    if {
        dynamic_trait -> {
            trait_method := jet_codegen_resolve_trait_method(&builder, method)
            call_return_type = trait_method.method.return_type
            trait_access := trait_method.method.self_access ?? panic("checked trait method has no receiver convention")
            access = jet_codegen_lower_access(trait_access)
            trait_symbol :: method.trait_owner ?? panic("checked trait method call has no owner symbol")
            trait_ref := jet_codegen_mir_trait_ref_for_symbol(builder.modules, trait_symbol)
            method_id := MirTraitMethodId{value: stable_id("mir-trait-method", "{trait_method.trait_key}::{trait_method.method.key}")}
            callee = Val(MirCallee.TraitMethod{method: method_id, trait_ref: trait_ref, receiver: owner})
            &lowered_args.push(jet_codegen_method_receiver_arg(&builder, receiver, access))
            loop argument in jet_codegen_lower_trait_method_args(&builder, args, trait_method.method) -> &lowered_args.push(argument)
        } else -> {
            function :: target ?? panic("checked instance method has no reachable TFunc")
            call_return_type = jet_codegen_checked_method_return_type(&builder, function, receiver.ty, type_args)
            if function.kind == {
                .Method(convention, _) | .TraitMethod(_, convention, _, _, _) -> access = jet_codegen_lower_access(convention ?? panic("checked method has no receiver convention"))
                else -> panic("checked method target is not an instance function")
            }
            function_id := jet_codegen_function_id(function)
            callee = Val(MirCallee.Method{function: function_id, owner: owner})
            &lowered_args.push(jet_codegen_method_receiver_arg(&builder, receiver, access))
            loop argument in jet_codegen_lower_call_args(&builder, args, function.params) -> &lowered_args.push(argument)
            jet_codegen_note_core_module(&builder, function.module_name)
        }
    }
    lowered_types := [MirType]{}
    loop ty in type_args -> &lowered_types.push(jet_codegen_lower_type_for_function(ty, builder))
    resolved_callee := callee ?? panic("checked method call has no resolved MIR callee")
    jet_codegen_emit_value(&builder, expression.span, call_return_type, MirOperation.Call{callee: resolved_callee, args: lowered_args, type_args: lowered_types})
}

fn jet_codegen_numeric_constant_int(builder: &JetCodegenBuilder, span: Span, value: Int) -> MirValueId Never! {
    jet_codegen_emit_value(&builder, span, Type.IntN{signed: true, bits: 64}, MirOperation.Constant{value: MirConstant.Int{value: value, width: None, spelling: None}})
}

fn jet_codegen_numeric_constant_bool(builder: &JetCodegenBuilder, span: Span, value: Bool) -> MirValueId Never! {
    jet_codegen_emit_value(&builder, span, Type.Bool, MirOperation.Constant{value: MirConstant.Bool{value: value}})
}

fn jet_codegen_numeric_call_arg(value: MirValueId, span: Span) -> MirCallArg Never! {
    MirCallArg{
        value: value,
        place: None,
        access: MirAccess.Read,
        span: span,
        label: None,
        source_index: None,
        binder_slot: None,
        spread: false,
        implicit_clone: false,
        shared_auto_clone: false,
        owned_last_use: false,
        authority_boundary: false,
        fn_coercion: None,
        widen_fixed_to_list: false,
        widen_to_union: None,
        box_as_trait: None,
    }
}

fn jet_codegen_numeric_plain_int(ty: Type) -> Bool Never! {
    if ty == {
        .Int -> true
        .Tagged(_, inner) -> jet_codegen_numeric_plain_int(inner)
        else -> false
    }
}

fn jet_codegen_numeric_signed_fixed(ty: Type) -> Bool Never! {
    if ty == {
        .IntN(signed, _) -> signed
        .Tagged(_, inner) -> jet_codegen_numeric_signed_fixed(inner)
        else -> false
    }
}

fn jet_codegen_numeric_conversion_route(builder: &JetCodegenBuilder, operation: TNumericOp, source: Type, carrier: TFailureCarrier) -> MirPreludeCallId Never! {
    if operation == {
        .CheckedIntToFloat(_, _, _) -> {
            if jet_codegen_numeric_plain_int(source) -> return jet_codegen_intern_route(&builder, MirPreludeFamily.StaticPrelude, "core.numeric", "checked_widen", "jet_std::jet_int_checked_widen", 4, [Bool]{false, false, true, false}, None, carrier, MirPreludeAbi.Value)
            return jet_codegen_intern_route(&builder, MirPreludeFamily.StaticPrelude, "core.numeric", "checked_widen", "jet_numeric_checked_widen_at", 5, [Bool]{false, false, false, true, false}, None, carrier, MirPreludeAbi.Value)
        }
        .TryFrom(_, _, _) -> {
            if jet_codegen_numeric_plain_int(source) -> return jet_codegen_intern_route(&builder, MirPreludeFamily.StaticPrelude, "core.numeric", "int_try_from", "jet_std::jet_int_try_from_checked", 2, [Bool]{false, false}, None, carrier, MirPreludeAbi.Value)
            return jet_codegen_intern_route(&builder, MirPreludeFamily.StaticPrelude, "core.numeric", "fixed_try_from", "jet_numeric_try_from_fixed", 3, [Bool]{false, false, false}, None, carrier, MirPreludeAbi.Value)
        }
        .InlineRange(_, _, _) -> return jet_codegen_intern_route(&builder, MirPreludeFamily.StaticPrelude, "core.numeric", "inline_range", "jet_inline_range_from_int", 3, [Bool]{false, false, false}, None, carrier, MirPreludeAbi.Value)
        .CheckedIntToFixed(_, _, _, _) -> return jet_codegen_intern_route(&builder, MirPreludeFamily.StaticPrelude, "core.numeric", "int_checked_fixed", "jet_std::jet_int_checked_fixed", 4, [Bool]{false, false, true, false}, None, carrier, MirPreludeAbi.Value)
        .FloatToInt(_, _, _, _, _) -> return jet_codegen_intern_route(&builder, MirPreludeFamily.StaticPrelude, "core.numeric", "float_to_int", "jet_numeric_float_to_int", 2, [Bool]{false, false}, None, carrier, MirPreludeAbi.Value)
        .FloatNarrow(_) -> return jet_codegen_intern_route(&builder, MirPreludeFamily.StaticPrelude, "core.numeric", "float_narrow", "jet_numeric_float_narrow", 1, [Bool]{false}, None, carrier, MirPreludeAbi.Value)
        else -> panic("checked numeric operation is not a prelude conversion")
    }
}

fn jet_codegen_numeric_conversion_parameters(builder: &JetCodegenBuilder, span: Span, operation: TNumericOp, source: Type) -> [MirValueId] Never! {
    params := [MirValueId]{}
    if operation == {
        .CheckedIntToFloat(source_signed, target_f32, _) -> {
            if !jet_codegen_numeric_plain_int(source) -> &params.push(jet_codegen_numeric_constant_bool(&builder, span, source_signed))
            &params.push(jet_codegen_numeric_constant_bool(&builder, span, target_f32))
        }
        .CheckedIntToFixed(host_kind, _, _, _) -> &params.push(jet_codegen_numeric_constant_int(&builder, span, host_kind))
        .TryFrom(host_kind, _, _) -> {
            if !jet_codegen_numeric_plain_int(source) -> &params.push(jet_codegen_numeric_constant_bool(&builder, span, jet_codegen_numeric_signed_fixed(source)))
            &params.push(jet_codegen_numeric_constant_int(&builder, span, host_kind))
        }
        .FloatToInt(host_kind, _, _, _, _) -> &params.push(jet_codegen_numeric_constant_int(&builder, span, host_kind))
        .InlineRange(lo, hi, _) -> {
            &params.push(jet_codegen_numeric_constant_int(&builder, span, lo))
            &params.push(jet_codegen_numeric_constant_int(&builder, span, hi))
        }
        else -> {}
    }
    params
}

fn jet_codegen_lower_numeric_conversion(builder: &JetCodegenBuilder, expression: TExpr, receiver: MirValueId, source: Type, operation: TNumericOp) -> MirValueId Never! {
    carrier := jet_codegen_failure_carrier_for_type(expression.ty)
    route := jet_codegen_numeric_conversion_route(&builder, operation, source, carrier)
    call := route
    parameters := jet_codegen_numeric_conversion_parameters(&builder, expression.span, operation, source)
    location := jet_codegen_source_location_at(&builder, expression.span, false)
    panic_location := MirPanicLoc{file: mir_source_file_id(builder.function.source_file), line: location.line, column: 0}
    target := jet_codegen_lower_type_for_function(expression.ty, builder)
    fallibility := jet_codegen_core_call_fallibility(carrier, &builder)
    jet_codegen_emit_value(&builder, expression.span, expression.ty, MirOperation.Convert{value: receiver, parameters: parameters, target: target, conversion: MirConversion.Prelude{call: call, location: panic_location, fallibility: fallibility}})
}

fn jet_codegen_lower_numeric_method(builder: &JetCodegenBuilder, expression: TExpr, receiver_expr: TExpr, operation: TNumericOp) -> MirValueId {
    receiver := jet_codegen_lower_expr(&builder, receiver_expr)
    if operation == {
        .CastAs(_) -> {
            target := jet_codegen_lower_type_for_function(expression.ty, builder)
            return jet_codegen_emit_value(&builder, expression.span, expression.ty, MirOperation.Convert{value: receiver, parameters: [MirValueId]{}, target: target, conversion: MirConversion.NumericCast})
        }
        .BitCount(method, width) -> {
            operation_id := if method == {
                "count_ones" -> 0
                "count_zeros" -> 1
                "leading_zeros" -> 2
                "trailing_zeros" -> 3
                "bit_count" -> 4
                "bit_length" -> 5
                else -> panic("checked integer population operation is unknown")
            }
            exact := jet_codegen_exact_int_type(receiver_expr.ty)
            actual_receiver := receiver
            if !exact {
                raw_type := Type.IntN{signed: true, bits: 64}
                target := jet_codegen_lower_type_for_function(raw_type, builder)
                actual_receiver = jet_codegen_emit_value(&builder, expression.span, raw_type, MirOperation.Convert{value: receiver, parameters: [MirValueId]{}, target: target, conversion: MirConversion.NumericCast})
            }
            call := jet_codegen_intern_route(&builder, MirPreludeFamily.BuiltinMethod, "core.numeric", if exact -> "int_bit_count" else -> "bit_count", if exact -> "jet_numeric_int_bit_count" else -> "jet_numeric_bit_count", 3, [Bool]{false, false, false}, None, TFailureCarrier.Infallible, MirPreludeAbi.Value)
            args := [MirCallArg]{
                jet_codegen_numeric_call_arg(actual_receiver, receiver_expr.span),
                jet_codegen_numeric_call_arg(jet_codegen_numeric_constant_int(&builder, expression.span, operation_id), expression.span),
                jet_codegen_numeric_call_arg(jet_codegen_numeric_constant_int(&builder, expression.span, width), expression.span),
            }
            return jet_codegen_emit_value(&builder, expression.span, expression.ty, MirOperation.Call{callee: MirCallee.Prelude{call: call}, args: args, type_args: [MirType]{}})
        }
        .ToShow -> return jet_codegen_emit_value(&builder, expression.span, expression.ty, MirOperation.BuildString{parts: [MirStringPart]{MirStringPart{kind: MirStringPartKind.Interpolation{value: receiver, format: MirStringFormat.Display}}}})
        .InlineRange(_, _, checked) -> {
            if checked {
                return jet_codegen_lower_numeric_conversion(&builder, expression, receiver, receiver_expr.ty, operation)
            }
            return jet_codegen_emit_value(&builder, expression.span, expression.ty, MirOperation.Copy{value: receiver, materialize_view: false})
        }
        .CheckedIntToFloat(_, _, _) -> return jet_codegen_lower_numeric_conversion(&builder, expression, receiver, receiver_expr.ty, operation)
        .CheckedIntToFixed(_, _, _, _) -> return jet_codegen_lower_numeric_conversion(&builder, expression, receiver, receiver_expr.ty, operation)
        .TryFrom(_, _, _) -> return jet_codegen_lower_numeric_conversion(&builder, expression, receiver, receiver_expr.ty, operation)
        .FloatToInt(_, _, _, _, _) -> return jet_codegen_lower_numeric_conversion(&builder, expression, receiver, receiver_expr.ty, operation)
        .FloatNarrow(_) -> return jet_codegen_lower_numeric_conversion(&builder, expression, receiver, receiver_expr.ty, operation)
        .Predicate(method) -> {
            member := if method == {
                "is_nan" -> "is_nan"
                "is_infinite" -> "is_infinite"
                "is_finite" -> "is_finite"
                else -> panic("checked numeric predicate is unknown")
            }
            symbol := if {
                member == "is_nan" -> "jet_std_math_is_nan"
                member == "is_infinite" -> "jet_std_math_is_infinite"
                else -> "jet_std_math_is_finite"
            }
            call := jet_codegen_intern_route(&builder, MirPreludeFamily.BuiltinMethod, "core.math", member, symbol, 1, [Bool]{false}, None, jet_codegen_failure_carrier_for_type(expression.ty), MirPreludeAbi.Value)
            return jet_codegen_emit_value(&builder, expression.span, expression.ty, MirOperation.Semantic{operation: MirSemanticOp.NumericMethod{call: call, receiver: receiver}})
        }
        .EuclideanDiv(_) | .EuclideanRem(_) -> panic("checked Euclidean numeric operation requires a binary numeric-method node")
    }
    panic("checked numeric operation is unsupported by Source Codegen")
}

fn jet_codegen_lower_numeric_binary_method(builder: &JetCodegenBuilder, expression: TExpr, receiver_expr: TExpr, operation: TNumericOp, argument_expr: TExpr) -> MirValueId {
    receiver := jet_codegen_lower_expr(&builder, receiver_expr)
    argument := jet_codegen_lower_expr(&builder, argument_expr)
    member := if operation == {
        .EuclideanDiv(_) -> "div_euclid"
        .EuclideanRem(_) -> "rem_euclid"
        else -> panic("checked binary numeric operation is unsupported by Source Codegen")
    }
    symbol := if member == "div_euclid" -> "jet_std::jet_int_div_euclid" else -> "jet_std::jet_int_rem_euclid"
    call := jet_codegen_intern_route(&builder, MirPreludeFamily.Overflow, "core.numeric", member, symbol, 2, [Bool]{false, false}, None, jet_codegen_failure_carrier_for_type(expression.ty), MirPreludeAbi.Value)
    jet_codegen_emit_value(&builder, expression.span, expression.ty, MirOperation.Semantic{operation: MirSemanticOp.NumericBinaryMethod{call: call, receiver: receiver, argument: argument}})
}

fn jet_codegen_overflow_opt_arity(prefix: String, operation: String) -> Int Never! {
    if prefix == "checked" && (operation == "add" || operation == "sub" || operation == "mul" || operation == "div" || operation == "rem" || operation == "pow") -> return 2
    if prefix == "checked_policy" && (operation == "add" || operation == "sub" || operation == "mul" || operation == "div" || operation == "rem" || operation == "pow") -> return 4
    if (prefix == "wrapping" || prefix == "saturating") && (operation == "add" || operation == "sub" || operation == "mul") -> return 2
    if (prefix == "wrapping" || prefix == "saturating") && (operation == "div" || operation == "pow") -> return 4
    if (prefix == "rotate_left" || prefix == "rotate_right") && operation == "rotate" -> return 4
    panic("checked overflow option has no canonical Prelude route")
}

fn jet_codegen_overflow_opt_route(builder: &JetCodegenBuilder, prefix: String, operation: String, input: Type, result: Type, carrier: TFailureCarrier) -> MirPreludeCallId Never! {
    width :: jet_codegen_fixed_width(input) ?? panic("checked overflow option has no resolved fixed-width receiver type")
    checked := prefix == "checked"
    if {
        checked -> {
            if result == {
                .Option(value) -> {
                    if type_identity_key(value) != type_identity_key(input) -> panic("checked overflow option has a mismatched payload type")
                }
                else -> panic("checked overflow option has no Option result type")
            }
            if carrier == {
                .Optional(value) -> {
                    if type_identity_key(value) != type_identity_key(input) -> panic("checked overflow option has a mismatched failure carrier")
                }
                else -> panic("checked overflow option has a mismatched failure carrier")
            }
        }
        else -> {
            if type_identity_key(result) != type_identity_key(input) -> panic("overflow option has a mismatched resolved result type")
            if carrier == {
                .Optional(_) -> panic("value-producing overflow option has an optional failure carrier")
                else -> {}
            }
        }
    }
    arity := jet_codegen_overflow_opt_arity(prefix, operation)
    mode := if prefix == "checked_policy" -> "trap" else -> prefix
    route_effect := if arity == 4 -> Val(Effect.Panic) else -> None
    symbol := if prefix == "rotate_left" || prefix == "rotate_right" -> "jet_{width}_{prefix}" else -> "jet_{width}_{mode}_{operation}"
    member := "{width}.{prefix}.{operation}"
    borrow_mask := if arity == 2 -> [Bool]{false, false} else -> [Bool]{false, false, false, false}
    jet_codegen_intern_route(&builder, MirPreludeFamily.Overflow, "core.numeric", member, symbol, arity, borrow_mask, route_effect, carrier, MirPreludeAbi.Value)
}

fn jet_codegen_lower_overflow_opt(builder: &JetCodegenBuilder, expression: TExpr, prefix: String, operation: String, line: Int, lhs: TExpr, rhs: TExpr) -> MirValueId {
    left := jet_codegen_lower_expr(&builder, lhs)
    right := jet_codegen_lower_expr(&builder, rhs)
    result_type := jet_codegen_unwrap_pattern_tags(expression.ty)
    unbounded_int := result_type == Type.Int && jet_codegen_fixed_width(lhs.ty) == None
    if unbounded_int && (prefix == "wrapping" || prefix == "saturating") {
        binop := if operation == {
            "add" -> TBinaryOp.Add
            "sub" -> TBinaryOp.Sub
            "mul" -> TBinaryOp.Mul
            "div" -> TBinaryOp.Div
            "rem" -> TBinaryOp.Rem
            else -> panic("overflow option `{prefix}_{operation}` has no Int route")
        }
        return jet_codegen_emit_value(&builder, expression.span, expression.ty, MirOperation.Binary{op: jet_codegen_lower_binary(binop), dispatch: MirBinaryDispatch.Primitive, overflow: MirBinaryOverflow.Unchecked, left: left, right: right})
    }
    carrier := jet_codegen_failure_carrier_for_type(expression.ty)
    call := jet_codegen_overflow_opt_route(&builder, prefix, operation, lhs.ty, expression.ty, carrier)
    location := if jet_codegen_overflow_opt_arity(prefix, operation) == 4 -> Val(MirPanicLoc{file: mir_source_file_id(builder.function.source_file), line: line, column: 0}) else -> None
    jet_codegen_emit_value(&builder, expression.span, expression.ty, MirOperation.Semantic{operation: MirSemanticOp.OverflowOption{call: call, left: left, right: right, location: location}})
}

fn jet_codegen_lower_callback_adapter(builder: &JetCodegenBuilder, expression: TExpr, symbol: String, lambda: TLambda, ret: Type?, managed: Bool, plan_digest: String?, callback_identity: String?) -> MirValueId {
    lowered_lambda := jet_codegen_lower_lambda(&builder, lambda, false, "direct")
    params := [MirParam]{}
    index := 0
    loop name in lambda.source_params {
        ty := lambda.param_types[index]
        &params.push(MirParam{
            index: index,
            name: name,
            span: lambda.source_span,
            ty: jet_codegen_lower_type_for_function(ty, builder),
            access: MirAccess.Read,
            ownership: mir_ownership_from_access(MirAccess.Read),
            public_label: name,
            variadic: false,
            default_present: false,
        })
        index += 1
    }
    adapter := MirCallbackAdapter{
        id: MirCallbackId{value: stable_id("mir-callback", "{symbol}|{lowered_lambda.function.value}")},
        symbol: symbol,
        function: lowered_lambda.function,
        params: params,
        return_type: if ret == { None -> None Val(ty) -> Val(jet_codegen_lower_type_for_function(ty, builder)) },
        abi: MirForeignAbi.C,
        managed: managed,
        plan_digest: plan_digest,
        callback_identity: callback_identity,
    }
    duplicate := false
    loop existing in builder.callbacks {
        if existing.id == adapter.id {
            if !jet_codegen_same_callback(existing, adapter) -> panic("conflicting C callback adapter identity")
            duplicate = true
        }
    }
    if !duplicate -> &builder.callbacks.push(adapter)
    carrier := jet_codegen_failure_carrier_for_type(expression.ty)
    call := jet_codegen_intern_route(&builder, MirPreludeFamily.StaticPrelude, "core.ffi", "callback_boundary", "jet_ffi_callback_boundary", 1, [Bool]{false}, Val(Effect.FFI), carrier, MirPreludeAbi.Value)
    jet_codegen_emit_value(&builder, expression.span, expression.ty, MirOperation.Semantic{operation: MirSemanticOp.CCallback{call: call, callback: adapter.id, lambda: lowered_lambda.value}})
}

fn jet_codegen_lower_core_closure_call(builder: &JetCodegenBuilder, expression: TExpr, kind: TCoreClosureKind) -> MirValueId {
    values := [MirValueId]{}
    closure := None
    mir_kind := MirCoreClosureKind.Spawn
    grouped_spawn := false
    label_text := ""
    if kind == {
        .Spawn(group, spawn_site, label, executable) -> {
            if group == {
                None -> {}
                Val(group_value) -> &values.push(jet_codegen_lower_expr(&builder, group_value))
            }
            &values.push(jet_codegen_emit_value(&builder, expression.span, Type.Int, MirOperation.Constant{value: MirConstant.Int{value: spawn_site, width: None, spelling: None}}))
            label_text = label ?? ""
            &values.push(jet_codegen_emit_value(&builder, expression.span, Type.String, MirOperation.Constant{value: MirConstant.String{value: label_text}}))
            closure = Val(jet_codegen_lower_lambda(&builder, executable, false, "spawn").value)
            mir_kind = MirCoreClosureKind.Spawn
            grouped_spawn = group != None
        }
        .Realtime(rate, frames, executable) -> {
            &values.push(jet_codegen_lower_expr(&builder, rate))
            &values.push(jet_codegen_lower_expr(&builder, frames))
            closure = Val(jet_codegen_lower_lambda(&builder, executable, false, "direct").value)
            mir_kind = MirCoreClosureKind.Realtime
        }
        .Serve(address, executable) -> {
            &values.push(jet_codegen_lower_expr(&builder, address))
            closure = Val(jet_codegen_lower_lambda(&builder, executable, true, "direct").value)
            mir_kind = MirCoreClosureKind.Serve
        }
        .OnInterrupt(callback) -> {
            &values.push(jet_codegen_lower_expr(&builder, callback))
            mir_kind = MirCoreClosureKind.OnInterrupt
        }
        .Guard(executable) -> {
            closure = Val(jet_codegen_lower_lambda(&builder, executable, false, "direct").value)
            mir_kind = MirCoreClosureKind.Guard
        }
        .OnCommit(handle_name, executable) | .OnRollback(handle_name, executable) -> {
            binding :: jet_codegen_find_binding(builder, handle_name) ?? panic("checked transaction closure has no bound handle")
            handle := TExpr{ty: binding.ty, kind: TExprKind.Local{local: tir_user_local(handle_name, expression.span)}, span: expression.span, integer_bounds: None, cost: None}
            &values.push(jet_codegen_lower_expr(&builder, handle))
            closure = Val(jet_codegen_lower_lambda(&builder, executable, false, "direct").value)
            if kind == {
                .OnCommit(_, _) -> {
                    mir_kind = MirCoreClosureKind.OnCommit
                }
                else -> {
                    mir_kind = MirCoreClosureKind.OnRollback
                }
            }
        }
        .UiButtonOnClick(label, shortcut, accessible_label, executable, _) -> {
            &values.push(jet_codegen_lower_expr(&builder, label))
            &values.push(jet_codegen_lower_expr(&builder, shortcut))
            &values.push(jet_codegen_lower_expr(&builder, accessible_label))
            closure = Val(jet_codegen_lower_lambda(&builder, executable, true, "direct").value)
            mir_kind = MirCoreClosureKind.UiAction
        }
        .UiTextInputOnDrop(state, ime, executable, _) -> {
            &values.push(jet_codegen_lower_expr(&builder, state))
            &values.push(jet_codegen_lower_expr(&builder, ime))
            closure = Val(jet_codegen_lower_lambda(&builder, executable, true, "direct").value)
            mir_kind = MirCoreClosureKind.UiTextInputOnDrop
        }
        .UiPreview(name, viewport, executable, _, playground, source_file, source_span, source_start_line, source_start_column, source_end_line, source_end_column, build_id, revision) -> {
            &values.push(jet_codegen_lower_expr(&builder, name))
            if viewport == {
                None -> {}
                Val(viewport_value) -> &values.push(jet_codegen_lower_expr(&builder, viewport_value))
            }
            closure = Val(jet_codegen_lower_lambda(&builder, executable, true, "direct").value)
            mir_kind = MirCoreClosureKind.UiPreview{playground: playground, source_file: source_file, source_span: source_span, source_start_line: source_start_line, source_start_column: source_start_column, source_end_line: source_end_line, source_end_column: source_end_column, build_id: build_id, revision: revision}
        }
        .ReactiveDerived(executable, _) -> {
            closure = Val(jet_codegen_lower_lambda(&builder, executable, true, "direct").value)
            mir_kind = MirCoreClosureKind.ReactiveDerived
        }
        .ReactiveEffect(executable, _) -> {
            closure = Val(jet_codegen_lower_lambda(&builder, executable, true, "direct").value)
            mir_kind = MirCoreClosureKind.ReactiveEffect
        }
        .UiReactiveRender(executable, _) -> {
            closure = Val(jet_codegen_lower_lambda(&builder, executable, true, "direct").value)
            mir_kind = MirCoreClosureKind.UiMount
        }
    }
    carrier := jet_codegen_failure_carrier_for_type(expression.ty)
    module_name := ""
    member := ""
    symbol := ""
    arity := 0
    borrow_mask := [Bool]{}
    route_effect := None
    if mir_kind == {
        .Spawn -> {
            if {
                grouped_spawn -> {
                    module_name = "core.tasks"
                    member = "spawn_grouped"
                    symbol = "jet_std::JetTaskGroup::spawn_at"
                    arity = 4
                    borrow_mask = [Bool]{false, false, false, false}
                } else -> {
                    module_name = "core.tasks"
                    member = "spawn"
                    symbol = "jet_std::JetTask::spawn_at"
                    arity = 3
                    borrow_mask = [Bool]{false, false, false}
                }
            }
        }
        .Realtime -> {
            module_name = "core.rt"
            member = "callback"
            symbol = "jet_rt_callback"
            arity = 3
            borrow_mask = [Bool]{false, false, false}
            route_effect = Val(Effect.Time)
        }
        .Serve -> {
            module_name = "core.http"
            member = "serve"
            symbol = "jet_http_serve"
            arity = 2
            borrow_mask = [Bool]{true, false}
        }
        .OnInterrupt -> {
            module_name = "core.sys"
            member = "on_interrupt"
            symbol = "jet_std_os_on_interrupt"
            arity = 1
            borrow_mask = [Bool]{false}
        }
        .Guard -> {
            module_name = "core.mem.scope"
            member = "guard"
            symbol = "jet_scope_guard"
            arity = 1
            borrow_mask = [Bool]{false}
        }
        .OnCommit -> {
            module_name = "core.transaction"
            member = "on_commit"
            symbol = "jet_transaction_on_commit"
            arity = 2
            borrow_mask = [Bool]{true, false}
        }
        .OnRollback -> {
            module_name = "core.transaction"
            member = "on_rollback"
            symbol = "jet_transaction_on_rollback"
            arity = 2
            borrow_mask = [Bool]{true, false}
        }
        .ReactiveDerived -> {
            module_name = "core.reactive"
            member = "derived"
            symbol = "jet_std::JetDerived::new"
            arity = 1
            borrow_mask = [Bool]{false}
        }
        .ReactiveEffect -> {
            module_name = "core.reactive"
            member = "effect"
            symbol = "jet_std::jet_reactive_effect"
            arity = 1
            borrow_mask = [Bool]{false}
        }
        .UiMount -> {
            module_name = "core.ui"
            member = "reactive_render"
            symbol = "jet_ui_reactive_render"
            arity = 1
            borrow_mask = [Bool]{false}
        }
        .UiAction -> {
            module_name = "core.ui"
            member = "button"
            symbol = "jet_ui_button_on_click"
            arity = 4
            borrow_mask = [Bool]{true, false, false, false}
        }
        .UiTextInputOnDrop -> {
            module_name = "core.ui"
            member = "text_input"
            symbol = "jet_ui_text_input_on_drop"
            arity = 3
            borrow_mask = [Bool]{true, false, false}
        }
        .UiPreview(playground, _, _, _, _, _, _, _, _) -> {
            module_name = "core.ui"
            member = if playground -> "playground" else -> "preview"
            symbol = if playground -> "jet_ui_playground_with_viewport" else -> "jet_ui_preview_with_viewport"
            arity = 3
            borrow_mask = [Bool]{true, false, false}
        }
    }
    route := jet_codegen_intern_route(&builder, MirPreludeFamily.StaticPrelude, module_name, member, symbol, arity, borrow_mask, route_effect, carrier, MirPreludeAbi.Value)
    identity := jet_codegen_identity(&builder, "site", expression.span, "core-closure", "")
    site := MirSiteId{value: stable_id("mir-site", identity)}
    jet_codegen_emit_value(&builder, expression.span, expression.ty, MirOperation.Semantic{operation: MirSemanticOp.CoreClosureCall{call: route, kind: mir_kind, values: values, closure: closure, site: site, label: label_text}})
}

fn jet_codegen_lower_shared_guard_wait(builder: &JetCodegenBuilder, expression: TExpr, guard: TExpr, condition: TExpr, predicate: TLambda) -> MirValueId {
    guard_value := jet_codegen_lower_expr(&builder, guard)
    condition_value := jet_codegen_lower_expr(&builder, condition)
    predicate_value := jet_codegen_lower_lambda(&builder, predicate, false, "direct").value
    carrier := jet_codegen_failure_carrier_for_type(expression.ty)
    call := jet_codegen_intern_route(&builder, MirPreludeFamily.StaticPrelude, "core.shared_guard", "wait", "jet_shared_guard_wait_once", 3, [Bool]{true, true, false}, None, carrier, MirPreludeAbi.Control)
    jet_codegen_emit_value(&builder, expression.span, expression.ty, MirOperation.Semantic{operation: MirSemanticOp.SharedGuardWait{call: call, guard: guard_value, condition: condition_value, predicate: predicate_value}})
}

fn jet_codegen_host_call_value_arg(value: MirValueId, span: Span, access: MirAccess, place: MirPlaceId?) -> MirCallArg Never! {
    MirCallArg{
        value: value,
        place: place,
        access: access,
        span: span,
        label: None,
        source_index: None,
        binder_slot: None,
        spread: false,
        implicit_clone: false,
        shared_auto_clone: false,
        owned_last_use: access == MirAccess.Move,
        authority_boundary: false,
        fn_coercion: None,
        widen_fixed_to_list: false,
        widen_to_union: None,
        box_as_trait: None,
    }
}

fn jet_codegen_lower_host_method(builder: &JetCodegenBuilder, expression: TExpr, receiver: TExpr, method: String, args: [TExpr]) -> MirValueId {
    if jet_codegen_reflection_host_method(receiver.ty, method, args.len()) -> return jet_codegen_lower_reflection_host_method(&builder, expression, receiver, method, args)
    if jet_codegen_compiler_value_host_method(receiver.ty, method, args.len()) -> return jet_codegen_lower_compiler_value_host_method(&builder, expression, receiver, method, args)
    if args.len() != 1 -> panic("checked host callback method must have exactly one callback")
    member := ""
    symbol := ""
    receiver_arg := jet_codegen_method_receiver_arg(&builder, receiver, MirAccess.Read)
    lowered := [MirCallArg]{receiver_arg}
    if {
        method == "shared.read" || method == "shared.edit" -> {
            if {
                builder.transactions.len() > 0 -> {
                    transaction := builder.transactions[builder.transactions.len() - 1]
                    stm_place :: transaction.stm_place ?? panic("checked Shared transaction callback has no active STM place")
                    stm := jet_codegen_emit_value(&builder, expression.span, Type.Named{name: "Stm"}, MirOperation.ReadPlace{place: stm_place})
                    &lowered.push(jet_codegen_host_call_value_arg(stm, expression.span, MirAccess.Write, Val(stm_place)))
                    if {
                        method == "shared.read" -> {
                            member = "Shared.read_txn"
                            symbol = "jet_shared_read_txn"
                        } else -> {
                            member = "Shared.edit_txn"
                            symbol = "jet_shared_edit_txn"
                        }
                    }
                }
                method == "shared.read" -> {
                    member = "Shared.read"
                    symbol = "jet_shared_read"
                }
                else -> {
                    member = "Shared.edit"
                    symbol = "jet_shared_edit"
                }
            }
        }
        method == "cell.read" -> {
            member = "Cell.read"
            symbol = "jet_cell_read"
        }
        method == "cell.edit" -> {
            member = "Cell.edit"
            symbol = "jet_cell_edit"
        }
        method == "cell_read_guard.read" -> {
            member = "CellReadGuard.read"
            symbol = "jet_cell_read_guard_read"
        }
        method == "cell_edit_guard.edit" -> {
            member = "CellEditGuard.edit"
            symbol = "jet_cell_edit_guard_edit"
        }
        else -> {
            panic("checked callback host method has no static route")
        }
    }
    callback := jet_codegen_lower_expr(&builder, args[0])
    &lowered.push(jet_codegen_host_call_value_arg(callback, args[0].span, MirAccess.Move, None))
    route := jet_codegen_intern_route(&builder, MirPreludeFamily.StaticPrelude, "core.host", member, symbol, lowered.len(), if lowered.len() == 3 -> [Bool]{true, true, false} else -> [Bool]{true, false}, None, jet_codegen_failure_carrier_for_type(expression.ty), MirPreludeAbi.Value)
    jet_codegen_emit_value(&builder, expression.span, expression.ty, MirOperation.Call{callee: MirCallee.Prelude{call: route}, args: lowered, type_args: [MirType]{}})
}

fn jet_codegen_unit_ratio_digits(value: String, negative: Bool) -> Bool Never! {
    bytes := value.bytes()
    if bytes.len() == 0 -> return false
    start := 0
    if negative && Int.from_u8(bytes[0]) == 45 -> start = 1
    if start == bytes.len() -> return false
    index := start
    loop index < bytes.len() {
        digit := Int.from_u8(bytes[index])
        if digit < 48 || digit > 57 -> return false
        index += 1
    }
    true
}

fn jet_codegen_unit_ratio_nonzero(value: String) -> Bool Never! {
    loop byte in value.bytes() {
        if byte != (U8{48}) {
            return true
        }
    }
    false
}

fn jet_codegen_unit_ratio_parts(value: String) -> [String] Never! {
    parts := value.split("/")
    if parts.len() != 2 || !jet_codegen_unit_ratio_digits(parts[0], true) || !jet_codegen_unit_ratio_digits(parts[1], false) || !jet_codegen_unit_ratio_nonzero(parts[1]) -> panic("checked unit conversion ratio is malformed")
    [String]{parts[0], parts[1]}
}

fn jet_codegen_unit_rounding_code(mode: TUnitRoundingMode) -> Int Never! {
    if mode == {
        .TowardZero -> 0
        .Floor -> 1
        .Ceiling -> 2
        .NearestEven -> 3
    }
}

fn jet_codegen_unit_measurement_type(ty: Type) -> Bool Never! {
    if ty == {
        .Apply(name, args) -> name == "Measurement" && args.len() == 1 && args[0] == Type.Float
        .Option(inner) -> jet_codegen_unit_measurement_type(inner)
        .Result(ok, _) -> jet_codegen_unit_measurement_type(ok)
        .Tagged(_, inner) -> jet_codegen_unit_measurement_type(inner)
        else -> false
    }
}

fn jet_codegen_unit_distinct_base(builder: JetCodegenBuilder, ty: Type) -> Type? {
    name := ""
    if ty == {
        .Named(value) -> {
            name = value
        }
        .Apply(value, _) -> {
            name = value
        }
        else -> {
            return None
        }
    }
    identity := jet_codegen_find_nominal_identity(builder.modules, builder.function.module_identity, name, builder.generic_type_names)
    if identity == None -> return None
    owner :: identity ?? return None
    loop semantic_module in builder.modules {
        if semantic_module.module_identity != owner.module_identity -> next
        loop definition in semantic_module.declarations.type_defs {
            if definition.name != owner.name -> next
            if definition.kind == {
                .Distinct(base, _) -> {
                    return Val(base)
                }
                else -> {
                    return None
                }
            }
        }
    }
    None
}
fn jet_codegen_find_distinct_definition(builder: &JetCodegenBuilder, owner: SymbolId) -> TTypeDef Never! {
    found := None
    loop semantic_module in builder.modules {
        loop definition in semantic_module.declarations.type_defs {
            if definition.key == owner.key || definition.name == owner.key {
                if found != None -> panic("checked distinct owner resolves to multiple type definitions")
                found = Val(definition)
            }
        }
    }
    definition :: found ?? panic("checked distinct owner has no registered TTypeDef")
    if definition.kind == {
        .Distinct(_, _) -> {}
        else -> panic("checked distinct owner does not name a distinct type")
    }
    definition
}

fn jet_codegen_distinct_success_type(ty: Type) -> Type Never! {
    if ty == {
        .Result(ok, _) -> ok
        else -> ty
    }
}

fn jet_codegen_is_default_err_type(builder: &JetCodegenBuilder, ty: Type) -> Bool {
    identity := jet_codegen_lower_type_for_function(ty, builder).identity
    if identity == None -> return false
    target_id :: identity ?? return false
    loop semantic_module in builder.modules {
        loop definition in semantic_module.declarations.type_defs {
            if mir_type_id(definition.key) == target_id && jet_codegen_compiler_builtin(definition, builder.modules) == (Val(MirCompilerBuiltin.DefaultErr)) -> return true
        }
    }
    false
}

fn jet_codegen_default_err_type(builder: &JetCodegenBuilder) -> Type {
    selected := None
    loop semantic_module in builder.modules {
        if semantic_module.module_identity != builder.function.module_identity -> next
        loop definition in semantic_module.declarations.type_defs {
            if jet_codegen_compiler_builtin(definition, builder.modules) == (Val(MirCompilerBuiltin.DefaultErr)) {
                if selected != None -> panic("current module has multiple compiler-owned default error types")
                selected = Val(Type.Named{name: definition.key})
            }
        }
    }
    selected ?? panic("checked default-error conversion has no canonical compiler-owned Err")
}

fn jet_codegen_try_output_error_type(builder: &JetCodegenBuilder, source_error: Type, conversion: TTryConvert, carrier: TFailureCarrier) -> Type {
    if conversion == {
        .DefaultErr -> return jet_codegen_default_err_type(builder)
        .Typed(_, _, target) -> return target
        .WidenUnion(_, _) -> {
            if carrier == {
                .Result(_, error) -> return error
                else -> panic("checked union error widening has no Result failure carrier")
            }
        }
        .NoConversion -> return source_error
        else -> panic("diverging conversion has no output error type")
    }
}

// The journey routes' source-site arguments in ABI order: file, line, column,
// function (#3713).
fn jet_codegen_try_site_values(builder: &JetCodegenBuilder, span: Span, file: String, line: Int, function: String) -> [MirValueId] {
    if line < 1 || line > 4294967295 -> panic("checked try context line is outside the supported source range")
    column := jet_codegen_source_column_at(&builder, span)
    file_value := jet_codegen_emit_value(&builder, span, Type.String, MirOperation.Constant{value: MirConstant.String{value: file}})
    line_ty := Type.IntN{signed: false, bits: 32}
    line_value := jet_codegen_emit_value(&builder, span, line_ty, MirOperation.Constant{value: MirConstant.Int{value: line, width: Val(MirIntegerWidth{signed: false, bits: 32}), spelling: None}})
    column_value := jet_codegen_emit_value(&builder, span, line_ty, MirOperation.Constant{value: MirConstant.Int{value: column, width: Val(MirIntegerWidth{signed: false, bits: 32}), spelling: None}})
    function_value := jet_codegen_emit_value(&builder, span, Type.String, MirOperation.Constant{value: MirConstant.String{value: function}})
    [MirValueId]{file_value, line_value, column_value, function_value}
}

// The site arguments followed by the hop's note.
fn jet_codegen_try_context_values(builder: &JetCodegenBuilder, span: Span, file: String, line: Int, function: String, note: TExpr?) -> [MirValueId] {
    values := jet_codegen_try_site_values(&builder, span, file, line, function)
    note_value := if note == {
        None -> jet_codegen_emit_value(&builder, span, Type.String, MirOperation.Constant{value: MirConstant.String{value: ""}})
        Val(value) -> jet_codegen_lower_expr(&builder, value)
    }
    &values.push(note_value)
    values
}

// #3713: a returned `Err(...)` is where its failure starts.
fn jet_codegen_lower_journey_origin(builder: &JetCodegenBuilder, span: Span) Never! {
    location := jet_codegen_source_location_at(&builder, span, false)
    values := jet_codegen_try_site_values(&builder, span, builder.function.source_file, location.line, builder.function.name)
    route := jet_codegen_intern_route(&builder, MirPreludeFamily.StaticPrelude, "core.errors", "journey_origin", "jet_journey_origin", 4, [Bool]{true, false, false, true}, None, TFailureCarrier.Infallible, MirPreludeAbi.Effect)
    jet_codegen_emit_static_prelude_effect(&builder, span, route, values)
}

// A Core call runs no program code, so its failure starts at the call; one
// that takes a callback may carry a failure out of program code instead.
fn jet_codegen_try_operand_starts_failure(operand: TExpr) -> Bool Never! {
    if operand.kind == {
        .CoreCall(_, args, _, _, _, _, _) -> {
            loop arg in args {
                if arg.ty == {
                    .Fn(_, _, _, _, _, _) -> return false
                    else -> {}
                }
            }
            true
        }
        else -> false
    }
}

fn jet_codegen_emit_static_prelude_call(builder: &JetCodegenBuilder, span: Span, result_type: Type, call: MirPreludeCallId, values: [MirValueId]) -> MirValueId Never! {
    args := [MirCallArg]{}
    loop value in values -> &args.push(jet_codegen_numeric_call_arg(value, span))
    jet_codegen_emit_value(&builder, span, result_type, MirOperation.Call{callee: MirCallee.Prelude{call: call}, args: args, type_args: [MirType]{}})
}

fn jet_codegen_emit_static_prelude_effect(builder: &JetCodegenBuilder, span: Span, call: MirPreludeCallId, values: [MirValueId]) Never! {
    args := [MirCallArg]{}
    loop value in values -> &args.push(jet_codegen_numeric_call_arg(value, span))
    _ := jet_codegen_emit(&builder, span, None, MirOperation.Call{callee: MirCallee.Prelude{call: call}, args: args, type_args: [MirType]{}})
}

fn jet_codegen_lower_try_failure_conversion(builder: &JetCodegenBuilder, span: Span, error: MirValueId, source_error: Type, conversion: TTryConvert, carrier: TFailureCarrier) -> MirValueId {
    if conversion == {
        .NoConversion -> return error
        .DefaultErr -> {
            if !jet_codegen_is_default_err_type(builder, jet_codegen_default_err_type(builder)) -> panic("checked DefaultErr conversion does not target the canonical compiler-owned error")
            if type_identity_key(source_error) != type_identity_key(Type.String) -> panic("checked DefaultErr conversion source is not String")
            route := jet_codegen_intern_route(&builder, MirPreludeFamily.StaticPrelude, "core.errors", "from_message", "jet_err_from_message", 1, [Bool]{false}, None, TFailureCarrier.Infallible, MirPreludeAbi.Value)
            return jet_codegen_emit_static_prelude_call(&builder, span, jet_codegen_default_err_type(builder), route, [MirValueId]{error})
        }
        .Typed(function_name, source, target) -> {
            if type_identity_key(source) != type_identity_key(source_error) -> panic("checked typed error conversion source disagrees with the operand carrier")
            function :: jet_codegen_find_function(builder.functions, function_name) ?? panic("checked typed error conversion has no reachable TFunc")
            argument := jet_codegen_numeric_call_arg(error, span)
            argument.access = MirAccess.Move
            // A conversion routine is `fn(Source) -> Target Never!`: its
            // carrier cannot fail, so the converted error is its success value.
            routine_return :: function.ret ?? panic("checked typed error conversion routine has no return type")
            converted := if routine_return == {
                .Result(_, _) -> {
                    carrier_value := jet_codegen_emit_value(&builder, span, routine_return, MirOperation.Call{callee: MirCallee.User{function: jet_codegen_function_id(function)}, args: [MirCallArg]{argument}, type_args: [MirType]{}})
                    jet_codegen_emit_value(&builder, span, target, MirOperation.ResultValue{subject: carrier_value, ok: true})
                }
                else -> jet_codegen_emit_value(&builder, span, target, MirOperation.Call{callee: MirCallee.User{function: jet_codegen_function_id(function)}, args: [MirCallArg]{argument}, type_args: [MirType]{}})
            }
            if !jet_codegen_is_default_err_type(builder, target) -> return converted
            // A source-owned Core error reports under its user spelling
            // (`CryptoError`), never its canonical owner identity.
            source_spelling := type_name(source)
            if source_spelling.starts_with("<corelib>/") {
                owner_parts :: source_spelling.split("::")
                source_spelling = owner_parts[owner_parts.len() - 1]
            }
            source_name := jet_codegen_emit_value(&builder, span, Type.String, MirOperation.Constant{value: MirConstant.String{value: source_spelling}})
            target_name := jet_codegen_emit_value(&builder, span, Type.String, MirOperation.Constant{value: MirConstant.String{value: type_name(target)}})
            route := jet_codegen_intern_route(&builder, MirPreludeFamily.StaticPrelude, "core.errors", "apply_conversion", "jet_err_apply_conversion", 3, [Bool]{false, false, false}, None, TFailureCarrier.Infallible, MirPreludeAbi.Value)
            return jet_codegen_emit_static_prelude_call(&builder, span, target, route, [MirValueId]{converted, source_name, target_name})
        }
        .WidenUnion(_, tag_name) -> {
            target := if carrier == {
                .Result(_, error_type) -> error_type
                else -> panic("checked error union widening has no Result failure carrier")
            }
            if target == {
                .Union(members) -> {
                    matched := false
                    loop member in members {
                        if type_identity_key(member) == type_identity_key(source_error) {
                            if jet_codegen_union_member_tag(member) != jet_codegen_union_member_tag_name(tag_name) -> panic("checked union widening tag disagrees with its source member")
                            matched = true
                        }
                    }
                    if !matched -> panic("checked union widening source is absent from the target union")
                }
                else -> panic("checked union widening target is not a structural union")
            }
            union_type := jet_codegen_lower_type_for_function(target, builder)
            identity :: union_type.identity ?? panic("checked union widening target has no MIR identity")
            variant := jet_codegen_union_member_tag_name(tag_name)
            return jet_codegen_emit_value(&builder, span, target, MirOperation.Enum{type_id: identity, variant: variant, args: [MirEnumArg]{MirEnumArg{field: None, value: error, boxed: false}}})
        }
        .Never | .ProtocolExit -> panic("diverging try conversion was lowered through the value conversion path")
    }
}

// D-UNIONTYPE1=A / D-FAILURE-FOUNDATION1=A: sema admits a member value where
// its Result slot is a structural union (`Err(DBError.Down)` under
// `!(DBError | TimeoutError)`). The carrier stores the generated union, so the
// member is wrapped in its union variant exactly as `?` widening does.
fn jet_codegen_widen_result_payload(builder: &JetCodegenBuilder, expression: TExpr, value: TExpr, lowered: MirValueId, success: Bool) -> MirValueId Never! {
    target := expression.ty
    if jet_codegen_builtin_untag(expression.ty) == {
        .Result(ok, err) -> target = if success -> ok else -> err
        else -> return lowered
    }
    members := [Type]{}
    if jet_codegen_builtin_untag(target) == {
        .Union(values) -> members = values
        else -> return lowered
    }
    source := jet_codegen_builtin_untag(value.ty)
    if source == .Union(_) -> return lowered
    source_key := type_identity_key(jet_codegen_qualify_type(source, builder.modules, builder.function.module_identity, builder.generic_type_names))
    loop member in members {
        if type_identity_key(jet_codegen_qualify_type(member, builder.modules, builder.function.module_identity, builder.generic_type_names)) != source_key -> next
        identity :: jet_codegen_lower_type_for_function(target, builder).identity ?? panic("checked union result payload has no MIR identity")
        return jet_codegen_emit_value(&builder, expression.span, target, MirOperation.Enum{type_id: identity, variant: jet_codegen_union_member_tag(member), args: [MirEnumArg]{MirEnumArg{field: None, value: lowered, boxed: false}}})
    }
    lowered
}

fn jet_codegen_try_target_is_default_err(builder: &JetCodegenBuilder, source_error: Type, conversion: TTryConvert) -> Bool {
    if conversion == {
        .DefaultErr -> {
            return true
        }
        .Typed(_, _, target) -> {
            return jet_codegen_is_default_err_type(builder, target)
        }
        .NoConversion -> {
            return jet_codegen_is_default_err_type(builder, source_error)
        }
        else -> {
            return false
        }
    }
}

fn jet_codegen_lower_try_context(builder: &JetCodegenBuilder, span: Span, converted: MirValueId, target_error: Type, source_error: Type, conversion: TTryConvert, context_values: [MirValueId], has_note: Bool) -> MirValueId {
    if context_values.len() != 5 -> panic("checked try context lowering produced an invalid argument set")
    // Only a `?(text)` note becomes a context frame on the default error; an
    // automatic propagation hop joins the journey alone (#3713).
    if has_note && jet_codegen_try_target_is_default_err(builder, source_error, conversion) {
        route := jet_codegen_intern_route(&builder, MirPreludeFamily.StaticPrelude, "core.errors", "err_with_context_frame", "jet_err_with_context_frame", 6, [Bool]{false, true, false, false, true, false}, None, TFailureCarrier.Infallible, MirPreludeAbi.Value)
        values := [MirValueId]{converted, context_values[0], context_values[1], context_values[2], context_values[3], context_values[4]}
        return jet_codegen_emit_static_prelude_call(&builder, span, target_error, route, values)
    }
    route := jet_codegen_intern_route(&builder, MirPreludeFamily.StaticPrelude, "core.errors", "journey_frame_text", "jet_journey_frame_text", 5, [Bool]{true, false, false, true, true}, None, TFailureCarrier.Infallible, MirPreludeAbi.Effect)
    jet_codegen_emit_static_prelude_effect(&builder, span, route, context_values)
    converted
}

fn jet_codegen_lower_try(builder: &JetCodegenBuilder, expression: TExpr, inner: TExpr, note: TExpr?, conversion: TTryConvert, file: String?, line: Int, function: String?) -> MirValueId {
    input := jet_codegen_lower_expr(&builder, inner)
    input_type := jet_codegen_expression_call_return_type(&builder, inner) ?? inner.ty
    jet_codegen_lower_try_value(&builder, expression, input, input_type, inner.span, note, conversion, file, line, function, jet_codegen_try_operand_starts_failure(inner))
}

fn jet_codegen_lower_journey_reset(builder: &JetCodegenBuilder, span: Span) Never! {
    reset := jet_codegen_intern_route(&builder, MirPreludeFamily.StaticPrelude, "core.errors", "journey_reset", "jet_journey_reset", 0, [Bool]{}, None, TFailureCarrier.Infallible, MirPreludeAbi.Effect)
    jet_codegen_emit_static_prelude_effect(&builder, span, reset, [MirValueId]{})
}

// `fresh_failure`: the operand's failure starts at this site, so any journey
// left from an earlier, handled failure is dropped before the hop (#3713).
fn jet_codegen_lower_try_value(builder: &JetCodegenBuilder, expression: TExpr, input: MirValueId, input_type: Type, input_span: Span, note: TExpr?, conversion: TTryConvert, file: String?, line: Int, function: String?, fresh_failure: Bool) -> MirValueId {
    is_result := if input_type == {
        .Result(_, _) -> true
        else -> false
    }
    is_option := if input_type == {
        .Option(_) -> true
        else -> false
    }
    if !is_result && !is_option -> panic("checked try operand is not a Result or Option")
    context_enabled := file != None
    if context_enabled && (line < 1 || function == None) -> panic("checked try context has incomplete source location data")

    success_block := jet_codegen_new_block(&builder, expression.span, "try-success")
    failure_block := jet_codegen_new_block(&builder, expression.span, "try-failure")
    join_block := jet_codegen_new_block(&builder, expression.span, "try-join")
    condition := if is_result -> jet_codegen_emit_value(&builder, expression.span, Type.Bool, MirOperation.ResultIsOk{subject: input}) else -> jet_codegen_emit_value(&builder, expression.span, Type.Bool, MirOperation.OptionIsSome{subject: input})
    jet_codegen_terminate(&builder, MirTerminator.Branch{condition: condition, then_target: success_block, else_target: failure_block})

    incoming := [MirPhiIncoming]{}
    jet_codegen_switch_block(&builder, success_block)
    if context_enabled -> jet_codegen_lower_journey_reset(&builder, expression.span)
    success := if is_result -> jet_codegen_emit_value(&builder, expression.span, expression.ty, MirOperation.ResultValue{subject: input, ok: true}) else -> jet_codegen_emit_value(&builder, expression.span, expression.ty, MirOperation.OptionValue{subject: input})
    success_source := builder.current
    if jet_codegen_current_is_open(builder) {
        jet_codegen_terminate(&builder, MirTerminator.Jump{target: join_block})
        &incoming.push(MirPhiIncoming{block: success_source, value: success})
    }

    jet_codegen_switch_block(&builder, failure_block)
    carrier := builder.function.failure_carrier
    source_error := if input_type == {
        .Result(_, error) -> error
        else -> Type.Named{name: "Unit"}
    }
    if conversion == {
        .Never -> jet_codegen_terminate(&builder, MirTerminator.Unreachable{reason: "checked try conversion is unreachable"})
        .ProtocolExit -> {
            if !is_result -> panic("checked protocol-exit try does not consume a Result")
            error := jet_codegen_emit_value(&builder, input_span, source_error, MirOperation.ResultValue{subject: input, ok: false})
            route := jet_codegen_intern_route(&builder, MirPreludeFamily.StaticPrelude, "core.errors", "entry_error_exit", "jet_entry_error_exit_jet", 1, [Bool]{false}, Val("Panic"), TFailureCarrier.Diverges{value: Type.Named{name: "Never"}}, MirPreludeAbi.Control)
            _ := jet_codegen_emit_value(&builder, expression.span, Type.Named{name: "Never"}, MirOperation.Call{callee: MirCallee.Prelude{call: route}, args: [MirCallArg]{jet_codegen_numeric_call_arg(error, input_span)}, type_args: [MirType]{}})
            jet_codegen_terminate(&builder, MirTerminator.Unreachable{reason: "protocol error exit diverges"})
        }
        else -> if carrier == {
            .Result(success_type, error_type) -> {
                if !is_result -> panic("checked try Result propagation consumes an Option without a conversion")
                error := jet_codegen_emit_value(&builder, input_span, source_error, MirOperation.ResultValue{subject: input, ok: false})
                target_error := jet_codegen_try_output_error_type(&builder, source_error, conversion, carrier)
                target_error_mir := jet_codegen_lower_type_for_function(target_error, &builder)
                carrier_error_mir := jet_codegen_lower_type_for_function(error_type, &builder)
                if !mir_type_same_checked_type(target_error_mir, carrier_error_mir) -> panic("checked try conversion target disagrees with the enclosing Result error type")
                converted := jet_codegen_lower_try_failure_conversion(&builder, expression.span, error, source_error, conversion, carrier)
                if {
                    context_enabled -> {
                        if fresh_failure -> jet_codegen_lower_journey_reset(&builder, expression.span)
                        values := jet_codegen_try_context_values(&builder, expression.span, file ?? "", line, function ?? "", note)
                        converted = jet_codegen_lower_try_context(&builder, expression.span, converted, target_error, source_error, conversion, values, note != None)
                    }
                    note != None -> {
                        panic("checked try note has no source context")
                    }
                }
                return_type := Type.Result{ok: success_type, err: error_type}
                failure := jet_codegen_emit_value(&builder, expression.span, return_type, MirOperation.ResultErr{value: converted})
                if {
                    builder.contract_scopes.len() > 0 -> {
                        jet_codegen_lower_contract_return(&builder, Val(failure), expression.span)
                    } else -> {
                        terminator := MirTerminator.Return{value: Val(failure)}
                        _ := jet_codegen_terminate_with_owned_cleanup(&builder, terminator, -1)
                    }
                }
            }
            .Optional(success_type) -> {
                if conversion != TTryConvert.NoConversion -> panic("checked optional propagation carries a non-optional error conversion")
                if context_enabled {
                    if fresh_failure -> jet_codegen_lower_journey_reset(&builder, expression.span)
                    values := jet_codegen_try_context_values(&builder, expression.span, file ?? "", line, function ?? "", note)
                    route := jet_codegen_intern_route(&builder, MirPreludeFamily.StaticPrelude, "core.errors", "journey_frame_text", "jet_journey_frame_text", 5, [Bool]{true, false, false, true, true}, None, TFailureCarrier.Infallible, MirPreludeAbi.Effect)
                    jet_codegen_emit_static_prelude_effect(&builder, expression.span, route, values)
                }
                return_type := Type.Option{inner: success_type}
                absent := jet_codegen_emit_value(&builder, expression.span, return_type, MirOperation.Absent)
                if {
                    builder.contract_scopes.len() > 0 -> {
                        jet_codegen_lower_contract_return(&builder, Val(absent), expression.span)
                    } else -> {
                        terminator := MirTerminator.Return{value: Val(absent)}
                        _ := jet_codegen_terminate_with_owned_cleanup(&builder, terminator, -1)
                    }
                }
            }
            .Diverges(_) -> jet_codegen_terminate(&builder, MirTerminator.Unreachable{reason: "try failure diverges"})
            .Infallible -> jet_codegen_terminate(&builder, MirTerminator.Unreachable{reason: "try in an infallible function diverges on failure"})
        }
    }
    if incoming.len() == 0 -> panic("checked try has no reachable success continuation")
    jet_codegen_switch_block(&builder, join_block)
    jet_codegen_emit_value(&builder, expression.span, expression.ty, MirOperation.Phi{incoming: incoming})
}


fn jet_codegen_lower_range_checked_ctor(builder: &JetCodegenBuilder, expression: TExpr, owner: SymbolId, argument: TExpr, failure: TFailureCarrier) -> MirValueId {
    definition := jet_codegen_find_distinct_definition(builder, owner)
    range := if definition.kind == {
        .Distinct(_, bounds) -> bounds
        else -> None
    }
    bounds :: range ?? panic("checked range constructor has no declared integer bounds")
    value := jet_codegen_lower_expr(&builder, argument)
    parameters := [MirValueId]{
        jet_codegen_numeric_constant_int(&builder, expression.span, bounds.lo),
        jet_codegen_numeric_constant_int(&builder, expression.span, bounds.hi),
    }
    route := jet_codegen_intern_route(&builder, MirPreludeFamily.StaticPrelude, "core.numeric", "inline_range", "jet_inline_range_from_int", 3, [Bool]{false, false, false}, None, failure, MirPreludeAbi.Value)
    location := jet_codegen_source_location_at(builder, expression.span, false)
    panic_location := MirPanicLoc{file: mir_source_file_id(builder.function.source_file), line: location.line, column: 0}
    target := jet_codegen_lower_type_for_function(expression.ty, builder)
    jet_codegen_emit_value(&builder, expression.span, expression.ty, MirOperation.Convert{value: value, parameters: parameters, target: target, conversion: MirConversion.Prelude{call: route, location: panic_location, fallibility: jet_codegen_core_call_fallibility(failure, builder)}})
}

fn jet_codegen_lower_distinct_convert(builder: &JetCodegenBuilder, expression: TExpr, owner: SymbolId, argument: TExpr, operation: TNumericOp, range: TIntegerBounds?, fallible: Bool) -> MirValueId {
    definition := jet_codegen_find_distinct_definition(builder, owner)
    base := if definition.kind == {
        .Distinct(value, _) -> value
        else -> panic("checked distinct conversion owner lost its base type")
    }
    carrier := jet_codegen_failure_carrier_for_type(expression.ty)
    if fallible == (carrier == TFailureCarrier.Infallible) -> panic("checked distinct conversion fallibility disagrees with its result carrier")
    value := jet_codegen_lower_expr(&builder, argument)
    success_type := jet_codegen_distinct_success_type(expression.ty)
    if operation == {
        .CastAs(_) -> {
            if type_identity_key(argument.ty) != type_identity_key(base) {
                base_type := jet_codegen_lower_type_for_function(base, builder)
                value = jet_codegen_emit_value(&builder, argument.span, base, MirOperation.Convert{value: value, parameters: [MirValueId]{}, target: base_type, conversion: MirConversion.NumericCast})
            }
            if fallible && range != None {
                bounds :: range ?? panic("checked distinct conversion range disappeared")
                parameters := [MirValueId]{
                    jet_codegen_numeric_constant_int(&builder, expression.span, bounds.lo),
                    jet_codegen_numeric_constant_int(&builder, expression.span, bounds.hi),
                }
                route := jet_codegen_intern_route(&builder, MirPreludeFamily.StaticPrelude, "core.numeric", "inline_range", "jet_inline_range_from_int", 3, [Bool]{false, false, false}, None, carrier, MirPreludeAbi.Value)
                location := jet_codegen_source_location_at(builder, expression.span, false)
                panic_location := MirPanicLoc{file: mir_source_file_id(builder.function.source_file), line: location.line, column: 0}
                target := jet_codegen_lower_type_for_function(expression.ty, builder)
                return jet_codegen_emit_value(&builder, expression.span, expression.ty, MirOperation.Convert{value: value, parameters: parameters, target: target, conversion: MirConversion.Prelude{call: route, location: panic_location, fallibility: jet_codegen_core_call_fallibility(carrier, builder)}})
            }
            target := jet_codegen_lower_type_for_function(success_type, builder)
            distinct := jet_codegen_emit_value(&builder, expression.span, success_type, MirOperation.Convert{value: value, parameters: [MirValueId]{}, target: target, conversion: MirConversion.Transparent})
            if fallible -> return jet_codegen_emit_value(&builder, expression.span, expression.ty, MirOperation.ResultOk{value: distinct})
            return distinct
        }
        else -> {}
    }
    route := jet_codegen_numeric_conversion_route(&builder, operation, argument.ty, carrier)
    parameters := jet_codegen_numeric_conversion_parameters(&builder, expression.span, operation, argument.ty)
    location := jet_codegen_source_location_at(builder, expression.span, false)
    panic_location := MirPanicLoc{file: mir_source_file_id(builder.function.source_file), line: location.line, column: 0}
    target := jet_codegen_lower_type_for_function(expression.ty, builder)
    jet_codegen_emit_value(&builder, expression.span, expression.ty, MirOperation.Convert{value: value, parameters: parameters, target: target, conversion: MirConversion.Prelude{call: route, location: panic_location, fallibility: jet_codegen_core_call_fallibility(carrier, builder)}})
}

fn jet_codegen_lower_unit_convert(builder: &JetCodegenBuilder, expression: TExpr, argument: TExpr, scale: String, offset: String, rounding: TUnitRounding?, fallible: Bool, relative_uncertainty: Float?, file: String, line: Int) -> MirValueId {
    scale_parts := jet_codegen_unit_ratio_parts(scale)
    offset_parts := jet_codegen_unit_ratio_parts(offset)
    raw_value := jet_codegen_lower_expr(&builder, argument)
    source_base := jet_codegen_unit_distinct_base(builder, argument.ty)
    if source_base != None {
        base :: source_base ?? argument.ty
        base_type := jet_codegen_lower_type_for_function(base, builder)
        raw_value = jet_codegen_emit_value(&builder, argument.span, base, MirOperation.Convert{value: raw_value, parameters: [MirValueId]{}, target: base_type, conversion: MirConversion.Transparent})
    }
    measured := relative_uncertainty != None && jet_codegen_unit_measurement_type(expression.ty)
    rounded := rounding != None
    member := ""
    symbol := ""
    borrow_mask := [Bool]{}
    if {
        rounded && measured -> {
            member = "conversion_rounded_measurement"
            symbol = "jet_std::jet_unit_conversion_rounded_measurement"
            borrow_mask = [Bool]{false, true, true, true, true, false, false, false}
        }
        rounded -> {
            member = "conversion_rounded"
            symbol = "jet_unit_conversion_rounded"
            borrow_mask = [Bool]{false, true, true, true, true, false, false}
        }
        measured -> {
            member = "conversion_exact_measurement"
            symbol = "jet_std::jet_unit_conversion_exact_measurement"
            borrow_mask = [Bool]{false, true, true, true, true, false}
        }
        else -> {
            member = "conversion_exact"
            symbol = "jet_unit_conversion_exact"
            borrow_mask = [Bool]{false, true, true, true, true}
        }
    }
    parameters := [MirValueId]{}
    &parameters.push(jet_codegen_emit_value(&builder, expression.span, Type.String, MirOperation.Constant{value: MirConstant.String{value: scale_parts[0]}}))
    &parameters.push(jet_codegen_emit_value(&builder, expression.span, Type.String, MirOperation.Constant{value: MirConstant.String{value: scale_parts[1]}}))
    &parameters.push(jet_codegen_emit_value(&builder, expression.span, Type.String, MirOperation.Constant{value: MirConstant.String{value: offset_parts[0]}}))
    &parameters.push(jet_codegen_emit_value(&builder, expression.span, Type.String, MirOperation.Constant{value: MirConstant.String{value: offset_parts[1]}}))
    if rounding != None {
        rounding_value :: rounding ?? panic("checked unit rounding metadata disappeared")
        &parameters.push(jet_codegen_numeric_constant_int(&builder, expression.span, jet_codegen_unit_rounding_code(rounding_value.mode)))
        &parameters.push(jet_codegen_lower_expr(&builder, rounding_value.digits))
    }
    if measured {
        &parameters.push(jet_codegen_emit_value(&builder, expression.span, Type.Float, MirOperation.Constant{value: MirConstant.Float{value: relative_uncertainty ?? 0.0, f32: false, spelling: None}}))
    }
    route := jet_codegen_intern_route(&builder, MirPreludeFamily.StaticPrelude, "core.units", member, symbol, borrow_mask.len(), borrow_mask, None, jet_codegen_failure_carrier_for_type(expression.ty), MirPreludeAbi.Value)
    if line < 0 -> panic("checked unit conversion line is negative")
    location := MirPanicLoc{file: mir_source_file_id(file), line: line, column: 0}
    carrier := jet_codegen_failure_carrier_for_type(expression.ty)
    failure := jet_codegen_core_call_fallibility(carrier, &builder)
    if !fallible && carrier != TFailureCarrier.Infallible -> panic("nonfallible unit conversion carries a failure result type")
    target := jet_codegen_lower_type_for_function(expression.ty, builder)
    jet_codegen_emit_value(&builder, expression.span, expression.ty, MirOperation.Convert{value: raw_value, parameters: parameters, target: target, conversion: MirConversion.Prelude{call: route, location: location, fallibility: failure}})
}
fn jet_codegen_lower_list_spread(builder: &JetCodegenBuilder, expression: TExpr, parts: [TListSpreadPart]) -> MirValueId {
    element := if jet_codegen_unwrap_pattern_tags(expression.ty) == {
        .List(inner) -> jet_codegen_unwrap_pattern_tags(inner)
        else -> panic("checked list spread result is not a List")
    }
    trait_type := None
    if element == {
        .TraitObject(bounds) -> {
            if bounds.len() == 1 {
                trait_type = Val(element)
            }
        }
        .Named(name) -> {
            if jet_codegen_trait_bound_is_declared(builder.modules, name, builder.function.module_identity) {
                trait_type = Val(Type.TraitObject{bounds: [String]{name}})
            }
        }
        else -> {}
    }
    trait_coercion := if trait_type == {
        None -> None
        Val(target) -> {
            jet_codegen_require_trait_box_target(target, &builder)
            identity :: jet_codegen_lower_type_for_function(target, builder).identity ?? panic("checked list spread trait target has no MIR identity")
            Val(identity)
        }
    }
    accumulator := jet_codegen_emit_value(&builder, expression.span, expression.ty, MirOperation.BuildList{values: [MirValueId]{}, trait_coercion: trait_coercion})
    carrier := jet_codegen_failure_carrier_for_type(expression.ty)
    route := jet_codegen_intern_route(&builder, MirPreludeFamily.BuiltinMethod, "core.builtin", "list_concat", "jet_list_concat", 2, [Bool]{true, true}, None, carrier, MirPreludeAbi.Value)
    loop part in parts {
        chunk := if part == {
            .Element(value) -> {
                lowered := jet_codegen_lower_expr(&builder, value)
                jet_codegen_emit_value(&builder, expression.span, expression.ty, MirOperation.BuildList{values: [MirValueId]{lowered}, trait_coercion: trait_coercion})
            }
            .Spread(value) -> {
                if jet_codegen_unwrap_pattern_tags(value.ty) == {
                    .List(_) -> {}
                    else -> panic("checked list spread operand is not a List")
                }
                jet_codegen_lower_expr(&builder, value)
            }
        }
        accumulator = jet_codegen_emit_static_prelude_call(&builder, expression.span, expression.ty, route, [MirValueId]{accumulator, chunk})
    }
    accumulator
}

fn jet_codegen_lower_data_entries_to_map(builder: &JetCodegenBuilder, expression: TExpr, local: TLocal) -> MirValueId Never! {
    binding :: jet_codegen_find_binding_for_local(builder, local) ?? panic("checked data entries have no MIR local")
    carrier := jet_codegen_failure_carrier_for_type(expression.ty)
    call := jet_codegen_intern_route(&builder, MirPreludeFamily.StaticPrelude, "core.collections", "entries_to_map", "jet_data_entries_to_map", 1, [Bool]{false}, None, carrier, MirPreludeAbi.Value)
    jet_codegen_emit_value(&builder, expression.span, expression.ty, MirOperation.Semantic{operation: MirSemanticOp.DataEntriesToMap{call: call, local: binding.local}})
}

fn jet_codegen_lower_decode_under(builder: &JetCodegenBuilder, expression: TExpr, segment: TExpr, inner: TExpr) -> MirValueId {
    segment_value := jet_codegen_lower_expr(&builder, segment)
    inner_value := jet_codegen_lower_expr(&builder, inner)
    carrier := jet_codegen_failure_carrier_for_type(expression.ty)
    call := jet_codegen_intern_route(&builder, MirPreludeFamily.StaticPrelude, "core.encoding", "decode_under", "jet_std::FieldError::under", 2, [Bool]{true, false}, None, carrier, MirPreludeAbi.Value)
    jet_codegen_emit_value(&builder, expression.span, expression.ty, MirOperation.Semantic{operation: MirSemanticOp.DecodeUnder{call: call, segment: segment_value, inner: inner_value}})
}

fn jet_codegen_lower_pool_slot_value(builder: &JetCodegenBuilder, expression: TExpr, pool: TExpr, index: TExpr, mutable: Bool, field: String?, line: Int, source_line: String) -> MirValueId {
    element_type := jet_codegen_index_element_type(pool.ty, MirIndexKind.Pool)
    access := if mutable -> MirAccess.Write else -> MirAccess.Read
    carrier := jet_codegen_failure_carrier_for_type(expression.ty)
    call := jet_codegen_index_route(&builder, MirIndexKind.Pool, access, carrier)
    location := MirPanicLoc{file: mir_source_file_id(builder.function.source_file), line: line, column: 0}
    context := MirPanicContext{function: builder.function.name, source_line: source_line, caret: 0, locals: [MirPanicLocal]{}}
    pool_value := jet_codegen_lower_expr(&builder, pool)
    index_value := jet_codegen_lower_expr(&builder, index)
    slot := jet_codegen_emit_value(&builder, expression.span, element_type, MirOperation.Index{call: call, base: pool_value, index: index_value, kind: MirIndexKind.Pool, access: access, location: location, context: context})
    if field == {
        None -> {
            if type_identity_key(expression.ty) != type_identity_key(element_type) -> panic("checked pool slot result disagrees with its element type")
            slot
        }
        Val(name) -> {
            resolved := jet_codegen_resolve_field_by_name(builder.modules, builder.function.module_identity, builder.generic_type_names, element_type, name)
            jet_codegen_emit_value(&builder, expression.span, expression.ty, MirOperation.Field{base: slot, field: jet_codegen_mir_field_id(resolved)})
        }
    }
}

fn jet_codegen_lower_math_lane_index_value(builder: &JetCodegenBuilder, expression: TExpr, lane_type: String, base: TExpr, index: TExpr, line: Int) -> MirValueId {
    if type_identity_key(base.ty) != type_identity_key(Type.Named{name: lane_type}) -> panic("checked math lane index type disagrees with its base type")
    scalar_type := jet_codegen_math_scalar_type(lane_type)
    if type_identity_key(expression.ty) != type_identity_key(scalar_type) -> panic("checked math lane result disagrees with its scalar type")
    carrier := jet_codegen_failure_carrier_for_type(expression.ty)
    call := jet_codegen_lane_index_route(&builder, lane_type, scalar_type, carrier)
    source := jet_codegen_source_location_at(&builder, expression.span, true)
    location := MirPanicLoc{file: mir_source_file_id(builder.function.source_file), line: line, column: 0}
    context := MirPanicContext{function: builder.function.name, source_line: source.source_line ?? "", caret: 0, locals: [MirPanicLocal]{}}
    base_value := jet_codegen_lower_expr(&builder, base)
    index_value := jet_codegen_lower_expr(&builder, index)
    jet_codegen_emit_value(&builder, expression.span, expression.ty, MirOperation.Index{call: call, base: base_value, index: index_value, kind: MirIndexKind.Lane, access: MirAccess.Read, location: location, context: context})
}

fn jet_codegen_lower_index_value(builder: &JetCodegenBuilder, expression: TExpr, base: TExpr, index: TExpr, kind: TIndexKind, access: AccessConvention, checked_call: SymbolId?, checked_location: TPanicLoc) -> MirValueId {
    if kind == {
        .User(_) -> {
            if access != AccessConvention.Read -> panic("checked index value lowering requires a read access")
            return jet_codegen_lower_index_hook(&builder, expression, base, index, checked_location.line, checked_call)
        }
        .LayoutField(name) -> {
            if access != AccessConvention.Read || checked_call != None -> panic("checked layout field selector is not an ordinary field read")
            return jet_codegen_lower_layout_field_index(&builder, expression, base, name, checked_location.line)
        }
        else -> {}
    }
    if checked_call != None -> panic("checked custom index call requires the absent Source index-hook lowering body")
    mir_access := jet_codegen_lower_access(access)
    if mir_access != MirAccess.Read -> panic("checked index value lowering requires a read access")
    index_base_type := base.ty
    loop {
        if index_base_type == {
            .Tagged(_, inner) -> index_base_type = inner
            else -> break
        }
    }
    carrier := jet_codegen_failure_carrier_for_type(expression.ty)
    panic_location := MirPanicLoc{file: mir_source_file_id(checked_location.file), line: checked_location.line, column: checked_location.column}
    if kind == {
        .Range -> {
            element_type := if index_base_type == {
                .List(element) -> element
                else -> panic("checked range index base is not a List")
            }
            if type_identity_key(expression.ty) != type_identity_key(Type.List{element: element_type}) -> panic("checked range index result disagrees with its List element type")
            if index.kind == {
                .Range(start, end, exclusive) -> {
                    base_value := jet_codegen_lower_expr(&builder, base)
                    start_value := jet_codegen_lower_expr(&builder, start)
                    end_value := jet_codegen_lower_expr(&builder, end)
                    range_value := jet_codegen_emit_value(&builder, index.span, index.ty, MirOperation.Range{start: start_value, end: end_value, exclusive: exclusive})
                    call := jet_codegen_slice_route(&builder, base.ty, true, carrier)
                    return jet_codegen_emit_value(&builder, expression.span, expression.ty, MirOperation.Slice{call: call, base: base_value, start: start_value, end: end_value, range: Val(range_value), location: panic_location})
                }
                else -> {
                    base_value := jet_codegen_lower_expr(&builder, base)
                    range_value := jet_codegen_lower_expr(&builder, index)
                    unused_bound := jet_codegen_emit_value(&builder, index.span, Type.Int, MirOperation.Constant{value: MirConstant.Int{value: 0, width: None, spelling: None}})
                    call := jet_codegen_slice_route(&builder, base.ty, true, carrier)
                    return jet_codegen_emit_value(&builder, expression.span, expression.ty, MirOperation.Slice{call: call, base: base_value, start: unused_bound, end: unused_bound, range: Val(range_value), location: panic_location})
                }
            }
        }
        else -> {}
    }
    mir_kind := jet_codegen_index_kind(index_base_type, kind)
    result_type := if {
        mir_kind == MirIndexKind.Lane -> {
            lane_type := if kind == { .Lane(name) -> name else -> panic("checked lane index has no lane type") }
            if type_identity_key(index_base_type) != type_identity_key(Type.Named{name: lane_type}) -> panic("checked lane index type disagrees with its base type")
            jet_codegen_math_scalar_type(lane_type)
        } else -> {
            jet_codegen_index_element_type(index_base_type, mir_kind)
        }
    }
    if type_identity_key(result_type) != type_identity_key(expression.ty) -> panic("checked index result disagrees with its element type")
    base_value := jet_codegen_lower_expr(&builder, base)
    index_value := jet_codegen_lower_expr(&builder, index)
    call := if {
        mir_kind == MirIndexKind.Lane -> {
            lane_type := if kind == { .Lane(name) -> name else -> panic("checked lane index has no lane type") }
            jet_codegen_lane_index_route(&builder, lane_type, result_type, carrier)
        } else -> {
            jet_codegen_index_route(&builder, mir_kind, mir_access, carrier)
        }
    }
    locals := [MirPanicLocal]{}
    loop local in checked_location.locals {
        binding :: jet_codegen_find_binding_for_local(builder, local.local) ?? next
        &locals.push(MirPanicLocal{name: local.display_name, local: binding.local})
    }
    context := MirPanicContext{function: checked_location.function, source_line: checked_location.source_line, caret: checked_location.caret, locals: locals}
    jet_codegen_emit_value(&builder, expression.span, expression.ty, MirOperation.Index{call: call, base: base_value, index: index_value, kind: mir_kind, access: mir_access, location: panic_location, context: context})
}

fn jet_codegen_lower_slice(builder: &JetCodegenBuilder, expression: TExpr, base: TExpr, start: TExpr, end: TExpr, range: TExpr?, checked_location: TPanicLoc) -> MirValueId {
    base_value := jet_codegen_lower_expr(&builder, base)
    start_value := jet_codegen_lower_expr(&builder, start)
    end_value := jet_codegen_lower_expr(&builder, end)
    range_value := if range == {
        None -> None
        Val(range_expr) -> Val(jet_codegen_lower_expr(&builder, range_expr))
    }
    carrier := jet_codegen_failure_carrier_for_type(expression.ty)
    call := jet_codegen_slice_route(&builder, base.ty, range_value != None, carrier)
    location := MirPanicLoc{file: mir_source_file_id(checked_location.file), line: checked_location.line, column: checked_location.column}
    jet_codegen_emit_value(&builder, expression.span, expression.ty, MirOperation.Slice{call: call, base: base_value, start: start_value, end: end_value, range: range_value, location: location})
}

fn jet_codegen_lower_handle_method(builder: &JetCodegenBuilder, expression: TExpr, receiver: TExpr, operation: THandleOp, args: [TExpr]) -> MirValueId {
    if operation == {
        .SerdeEncode -> {
            if args.len() != 0 -> panic("checked Serde encode has unexpected arguments")
            jet_codegen_lower_serde_encode(&builder, expression, receiver)
        }
        .Hardware(_) | .ReceiptAttach -> jet_codegen_lower_special_handle_method(&builder, expression, receiver, operation, args)
        .CursorTakePattern(_, _) | .ReaderTakePattern(_, _) -> jet_codegen_lower_take_pattern(&builder, expression, receiver, operation, args)
        .EmailMethod(_) -> jet_codegen_lower_email_method(&builder, expression, receiver, operation, args)
        .HTTPReqField(_) | .HTTPRespField(_) | .HTTPRespHeader | .HTTPClientMethod(_, _) | .HTTPRouterRegister(_, _, _, _, _, _) -> jet_codegen_lower_http_handle_method(&builder, expression, receiver, operation, args)
        .HTTPServerMethod(kind, method) -> {
            if {
                jet_codegen_http_field_projection(receiver.ty, operation, args.len()) != None || (kind == "HTTPResponse" && method == "header") -> {
                    jet_codegen_lower_http_handle_method(&builder, expression, receiver, operation, args)
                } else -> {
                    jet_codegen_lower_general_handle_method(&builder, expression, receiver, operation, args)
                }
            }
        }
        .DataTreeField | .DataTreeAt | .DataTreeInt | .DataTreeText | .DataTreeBool | .DataTreeFloat | .DataTreeToText | .DataTreeEqualUnordered | .DataTreeDecode(_) -> jet_codegen_lower_data_handle_method(&builder, expression, receiver, operation, args)
        .JSONField | .JSONAt | .JSONInt | .JSONText | .JSONBool | .JSONFloat | .JSONToText | .JSONEqualUnordered -> jet_codegen_lower_data_handle_method(&builder, expression, receiver, operation, args)
        .DBValueInt | .DBValueFloat | .DBValueText | .DBValueBool | .DBValueBlob | .DBValueIsNull | .DBQuery(_) | .DBQueryOne(_) | .DBExecute(_) -> jet_codegen_lower_data_handle_method(&builder, expression, receiver, operation, args)
        .DurationNsValue | .DurationSecondsValue -> {
            if args.len() != 0 -> panic("checked Duration value projection has unexpected arguments")
            nanoseconds := operation == THandleOp.DurationNsValue
            member := if nanoseconds -> "duration.ns_value" else -> "duration.seconds_value"
            symbol := if nanoseconds -> "jet_duration_ns_value" else -> "jet_duration_seconds_value"
            value := jet_codegen_lower_expr(&builder, receiver)
            call := jet_codegen_intern_route(&builder, MirPreludeFamily.HandleMethod, "core.handle", member, symbol, 1, [Bool]{true}, None, jet_codegen_failure_carrier_for_type(expression.ty), MirPreludeAbi.Value)
            jet_codegen_emit_value(&builder, expression.span, expression.ty, MirOperation.Semantic{operation: MirSemanticOp.HandleMethod{call: call, receiver: value, args: [MirValueId]{}, frame_schedule: None, frame_schedule_derivation: None}})
        }
        .PluginInvoke(export_name, signature) -> {
            handle := jet_codegen_lower_expr(&builder, receiver)
            lowered_args := [MirValueId]{}
            loop argument in args -> &lowered_args.push(jet_codegen_lower_expr(&builder, argument))
            route := jet_codegen_intern_route_with_authority(
                &builder,
                MirPreludeFamily.HandleMethod,
                "core.handle",
                "plugin.invoke",
                "jet_plugin_call",
                3,
                [Bool]{true, true, true},
                Val(Effect.FFI),
                jet_codegen_failure_carrier_for_type(expression.ty),
                MirPreludeAbi.Value,
                Val(mir_authority_plugin_call()),
            )
            jet_codegen_emit_value(&builder, expression.span, expression.ty, MirOperation.Semantic{operation: MirSemanticOp.PluginInvoke{call: route, handle: handle, export_name: export_name, signature: signature, args: lowered_args}})
        }
        else -> jet_codegen_lower_general_handle_method(&builder, expression, receiver, operation, args)
    }
}
fn jet_codegen_lower_typed_text_interpolation(builder: &JetCodegenBuilder, expression: TExpr, kind: MirTypedHeadKind, literals: [String], holes: [TExpr], trusted_html: [Bool]) -> MirValueId {
    lowered_holes := [MirValueId]{}
    loop hole in holes -> &lowered_holes.push(jet_codegen_lower_expr(&builder, hole))
    member := ""
    symbol := ""
    arity := 2
    borrow_mask := [Bool]{true, false}
    if kind == {
        .SQL -> {
            member = "sql_interpolate"
            symbol = "jet_typed_sql_interpolate"
        }
        .HTML -> {
            member = "html_interpolate"
            symbol = "jet_typed_html_interpolate"
            arity = 3
            borrow_mask = [Bool]{true, false, true}
        }
        .Sh -> {
            member = "sh_interpolate"
            symbol = "jet_typed_sh_interpolate"
        }
        .URL -> {
            member = "url_literal"
            symbol = "jet_std::jet_typed_url_literal"
        }
        .Path -> {
            member = "path_literal"
            symbol = "jet_typed_path_literal"
        }
        .DateTime -> {
            member = "datetime_literal"
            symbol = "jet_typed_datetime_literal"
        }
    }
    carrier := jet_codegen_failure_carrier_for_type(expression.ty)
    call := jet_codegen_intern_route(&builder, MirPreludeFamily.StaticPrelude, "core.typed_text", member, symbol, arity, borrow_mask, None, carrier, MirPreludeAbi.Value)
    jet_codegen_emit_value(&builder, expression.span, expression.ty, MirOperation.Semantic{operation: MirSemanticOp.TypedTextInterp{call: call, kind: kind, literals: literals, holes: lowered_holes, trusted_html: trusted_html}})
}

fn jet_codegen_lower_typed_text_projection(builder: &JetCodegenBuilder, expression: TExpr, kind: TTypedTextForm, argument: TExpr) -> MirValueId {
    value := jet_codegen_lower_expr(&builder, argument)
    member := if kind == {
        .SQLRaw -> "sql_raw"
        .HTMLRaw -> "html_raw"
        .ShRaw -> "sh_raw"
        .SQLTemplate -> "sql_template"
        .SQLParams -> "sql_params"
        .HTMLText -> "html_text"
    }
    borrowed := kind == TTypedTextForm.SQLTemplate || kind == TTypedTextForm.SQLParams
    carrier := jet_codegen_failure_carrier_for_type(expression.ty)
    call := jet_codegen_intern_route(&builder, MirPreludeFamily.StaticPrelude, "core.typed_text", member, "jet_typed_{member}", 1, [Bool]{borrowed}, None, carrier, MirPreludeAbi.Value)
    jet_codegen_emit_static_prelude_call(&builder, expression.span, expression.ty, call, [MirValueId]{value})
}

fn jet_codegen_lower_carrier_fact(builder: &JetCodegenBuilder, expression: TExpr, receiver: TExpr, field: String, notes: Bool) -> MirValueId {
    unwrapped_type := jet_codegen_unwrap_pattern_tags(receiver.ty)
    report_type := if unwrapped_type == {
        .Result(_, error) -> error
        else -> unwrapped_type
    }
    resolved := jet_codegen_resolve_field_by_name(builder.modules, builder.function.module_identity, builder.generic_type_names, report_type, field)
    value := jet_codegen_lower_expr(&builder, receiver)
    carrier := jet_codegen_failure_carrier_for_type(receiver.ty)
    member := if notes -> "notes" else -> "partial"
    symbol := if notes -> "jet_notes" else -> "jet_partial"
    call := jet_codegen_intern_route(&builder, MirPreludeFamily.StaticPrelude, "core.outcome", member, symbol, 1, [Bool]{true}, None, carrier, MirPreludeAbi.Value)
    jet_codegen_emit_value(&builder, expression.span, expression.ty, MirOperation.Semantic{operation: MirSemanticOp.CarrierFact{call: call, receiver: value, field: jet_codegen_mir_field_id(resolved), notes: notes}})
}

fn jet_codegen_lower_option_probe(builder: &JetCodegenBuilder, expression: TExpr, inner: TExpr, probe: TOptionProbe) -> MirValueId {
    if probe == {
        .Field(name) -> jet_codegen_lower_optional_field(&builder, expression, inner, name, false)
        .IsSome -> {
            subject := jet_codegen_lower_expr(&builder, inner)
            jet_codegen_emit_value(&builder, expression.span, expression.ty, MirOperation.OptionIsSome{subject: subject})
        }
        .Unwrap -> {
            subject := jet_codegen_lower_expr(&builder, inner)
            jet_codegen_emit_value(&builder, expression.span, expression.ty, MirOperation.OptionValue{subject: subject})
        }
    }
}

fn jet_codegen_lower_tuple_index(builder: &JetCodegenBuilder, expression: TExpr, base: TExpr, index: Int) -> MirValueId {
    field := jet_codegen_resolve_field_by_name(builder.modules, builder.function.module_identity, builder.generic_type_names, base.ty, "{index}")
    value := jet_codegen_lower_expr(&builder, base)
    jet_codegen_emit_value(&builder, expression.span, expression.ty, MirOperation.Field{base: value, field: jet_codegen_mir_field_id(field)})
}

fn jet_codegen_lower_fixed_list_index(builder: &JetCodegenBuilder, expression: TExpr, base: TExpr, index: TExpr, line: Int) -> MirValueId {
    location := jet_codegen_assignment_panic_location(&builder, expression.span, false)
    location.line = line
    place := jet_codegen_index_place(&builder, base, index, TIndexKind.FixedListProof, expression.ty, MirAccess.Read, location, expression.span)
    jet_codegen_emit_value(&builder, expression.span, expression.ty, MirOperation.ReadPlace{place: place})
}

fn jet_codegen_lower_yield_send(builder: &JetCodegenBuilder, expression: TExpr, value: TExpr) -> MirValueId {
    yielded := jet_codegen_lower_expr(&builder, value)
    resume := jet_codegen_new_block(&builder, expression.span, "yield-resume")
    jet_codegen_terminate(&builder, MirTerminator.Yield{value: yielded, resume: resume})
    jet_codegen_switch_block(&builder, resume)
    jet_codegen_emit_value(&builder, expression.span, expression.ty, MirOperation.Constant{value: MirConstant.Unit})
}

fn jet_codegen_host_value_access(builder: JetCodegenBuilder, value: MirValueId, borrowed: Bool) -> MirAccess Never! {
    if borrowed -> return MirAccess.Read
    index := builder.values.len()
    loop index > 0 {
        index -= 1
        fact := builder.values[index]
        if fact.id == value {
            if fact.ownership.mode == MirOwnershipMode.Copy -> return MirAccess.Read
            return MirAccess.Move
        }
    }
    panic("checked host argument has no MIR ownership fact")
}

fn jet_codegen_apply_host_route_access(builder: &JetCodegenBuilder, args: &[MirCallArg], borrow_mask: [Bool]) Never! {
    index := 0
    loop index < args.len() {
        argument := args[index]
        if argument.access != MirAccess.Write {
            borrowed := false
            if index < borrow_mask.len() -> borrowed = borrow_mask[index]
            argument.access = jet_codegen_host_value_access(builder, argument.value, borrowed)
            args[index] = argument
        }
        index += 1
    }
}

fn jet_codegen_emit_host_route_call(builder: &JetCodegenBuilder, expression: TExpr, call: MirPreludeCallId, args: [MirCallArg], borrow_mask: [Bool]) -> MirValueId Never! {
    if args.len() != borrow_mask.len() -> panic("checked host operation arity disagrees with its Prelude route")
    jet_codegen_apply_host_route_access(&builder, &args, borrow_mask)
    jet_codegen_emit_value(&builder, expression.span, expression.ty, MirOperation.Semantic{operation: MirSemanticOp.HostCall{call: call, args: args}})
}

fn jet_codegen_lower_host_args(builder: &JetCodegenBuilder, args: [THostArg], span: Span) -> [MirCallArg] {
    lowered := [MirCallArg]{}
    loop argument in args {
        value := if argument == {
            .Expr(value) | .Borrow(value) -> jet_codegen_lower_expr(&builder, value)
            .Lambda(lambda) -> jet_codegen_lower_lambda(&builder, lambda, false, "direct").value
        }
        &lowered.push(jet_codegen_numeric_call_arg(value, span))
    }
    lowered
}

fn jet_codegen_field_owner_type(ty: Type) -> Type Never! {
    if ty == {
        .Tagged(_, inner) -> return jet_codegen_field_owner_type(inner)
        .Apply(name, args) -> {
            if (name == "SharedGuard" || name == "CellReadGuard" || name == "CellEditGuard" || name == "Pin") && args.len() == 1 -> return jet_codegen_field_owner_type(args[0])
        }
        else -> {}
    }
    ty
}

fn jet_codegen_host_field_id(builder: JetCodegenBuilder, owner_type: Type, field_name: String) -> MirFieldId Never! {
    owner := jet_codegen_field_owner_type(owner_type)
    if owner == {
        .Tuple(fields) -> {
            loop field in fields {
                if field.name == field_name {
                    mir_type := jet_codegen_lower_type_for_function(owner, &builder)
                    return mir_field_id("{mir_type_identity_key(mir_type)}::{field_name}")
                }
            }
            panic("checked tuple projection field is missing")
        }
        else -> {}
    }
    resolved := jet_codegen_resolve_field_by_name(builder.modules, builder.function.module_identity, builder.generic_type_names, owner, field_name)
    jet_codegen_mir_field_id(resolved)
}

fn jet_codegen_checked_host_field_type(builder: JetCodegenBuilder, owner_type: Type, field_name: String) -> Type Never! {
    owner := jet_codegen_field_owner_type(owner_type)
    if owner == {
        .Tuple(fields) -> {
            loop field in fields {
                if field.name == field_name -> return field.ty
            }
            panic("checked tuple projection field type is missing")
        }
        else -> {}
    }
    owner_name := if owner == {
        .Named(name) | .Apply(name, _) -> name
        else -> panic("checked host projection owner is not nominal")
    }
    identity := jet_codegen_find_nominal_identity(builder.modules, builder.function.module_identity, owner_name, builder.generic_type_names)
    nominal_identity :: identity ?? panic("checked host projection owner has no registered nominal identity")
    generic_args := if owner == {
        .Apply(_, args) -> args
        else -> [Type]{}
    }
    loop semantic_module in builder.modules {
        if semantic_module.module_identity != nominal_identity.module_identity -> next
        loop nominal in semantic_module.nominals {
            if nominal.symbol.name != nominal_identity.name -> next
            loop field in nominal.fields {
                if field.symbol.name == field_name {
                    generic_names := [String]{}
                    loop parameter in nominal.generic_params -> &generic_names.push(parameter.name)
                    if generic_names.len() != generic_args.len() -> panic("checked host projection has incomplete generic owner arguments")
                    return sema_inference_substitute_type(field.ty, generic_names, generic_args)
                }
            }
            panic("checked host projection field has no registered nominal field")
        }
    }
    panic("checked host projection nominal disappeared from Codegen input")
}

fn jet_codegen_direct_display_function(builder: JetCodegenBuilder, value_type: Type) -> TFunc? {
    untagged_type := jet_codegen_unwrap_pattern_tags(value_type)
    value_name := ""
    if untagged_type == {
        .Named(name) | .Apply(name, _) -> {
            value_name = name
        }
        else -> {
            return None
        }
    }
    value_identity := jet_codegen_find_nominal_identity(builder.modules, builder.function.module_identity, value_name, builder.generic_type_names)
    nominal_identity :: value_identity ?? return None
    selected := None
    loop function in builder.functions {
        if function.name != "display" -> next
        if function.kind == {
            .TraitMethod(_, convention, owner, trait_symbol, _) -> {
                if convention == None || jet_codegen_symbol_name(&builder, trait_symbol) != "Display" -> next
                owner_name := if owner == {
                    .Named(name) | .Apply(name, _) -> name
                    else -> next
                }
                owner_identity := jet_codegen_find_nominal_identity(builder.modules, builder.function.module_identity, owner_name, builder.generic_type_names)
                if owner_identity == None || (owner_identity ?? nominal_identity).key != nominal_identity.key -> next
                if selected != None -> panic("checked Display method for a type is ambiguous")
                selected = Val(function)
            }
            else -> {}
        }
    }
    selected
}

fn jet_codegen_lower_direct_display(builder: &JetCodegenBuilder, value: MirValueId, value_type: Type, span: Span) -> MirValueId Never! {
    direct := jet_codegen_direct_display_function(builder, value_type)
    if direct != None {
        function :: direct ?? panic("checked Display method disappeared")
        return jet_codegen_emit_value(&builder, span, Type.String, MirOperation.Call{callee: MirCallee.User{function: jet_codegen_function_id(function)}, args: [MirCallArg]{jet_codegen_numeric_call_arg(value, span)}, type_args: [MirType]{}})
    }
    call := jet_codegen_intern_route(&builder, MirPreludeFamily.StaticPrelude, "core.text.fmt", "display", "jet_fmt_display", 1, [Bool]{true}, None, TFailureCarrier.Infallible, MirPreludeAbi.Value)
    args := [MirCallArg]{jet_codegen_numeric_call_arg(value, span)}
    jet_codegen_apply_host_route_access(&builder, &args, [Bool]{true})
    jet_codegen_emit_value(&builder, span, Type.String, MirOperation.Call{callee: MirCallee.Prelude{call: call}, args: args, type_args: [MirType]{}})
}

fn jet_codegen_numeric_bound_constant(ty: Type, member: String) -> MirConstant? {
    if ty == Type.Float32 {
        if member == "MAX" -> return Val(MirConstant.Float{value: 3.4028234663852886e38, f32: true, spelling: None})
        if member == "MIN" -> return Val(MirConstant.Float{value: -3.4028234663852886e38, f32: true, spelling: None})
        if member == "NAN" -> return Val(MirConstant.Float{value: 0.0 / 0.0, f32: true, spelling: None})
        if member == "INFINITY" -> return Val(MirConstant.Float{value: 1.0 / 0.0, f32: true, spelling: None})
        if member == "NEG_INFINITY" -> return Val(MirConstant.Float{value: -(1.0 / 0.0), f32: true, spelling: None})
        if member == "EPSILON" -> return Val(MirConstant.Float{value: 1.1920928955078125e-7, f32: true, spelling: None})
    }
    if ty == Type.Float {
        if member == "MAX" -> return Val(MirConstant.Float{value: 1.7976931348623157e308, f32: false, spelling: None})
        if member == "MIN" -> return Val(MirConstant.Float{value: -1.7976931348623157e308, f32: false, spelling: None})
        if member == "NAN" -> return Val(MirConstant.Float{value: 0.0 / 0.0, f32: false, spelling: None})
        if member == "INFINITY" -> return Val(MirConstant.Float{value: 1.0 / 0.0, f32: false, spelling: None})
        if member == "NEG_INFINITY" -> return Val(MirConstant.Float{value: -(1.0 / 0.0), f32: false, spelling: None})
        if member == "EPSILON" -> return Val(MirConstant.Float{value: 2.220446049250313e-16, f32: false, spelling: None})
    }
    if ty == Type.Int {
        if member == "MAX" -> return Val(MirConstant.Int{value: 9223372036854775807, width: None, spelling: None})
        if member == "MIN" -> return Val(MirConstant.Int{value: -9223372036854775808, width: None, spelling: None})
    }
    if ty == {
        .IntN(signed, bits) -> {
            if bits < 1 || bits > 64 || (member != "MAX" && member != "MIN") -> return None
            width := Val(MirIntegerWidth{signed: signed, bits: bits})
            value := 0
            if {
                member == "MAX" -> {
                    if {
                        signed -> {
                            if {
                                bits == 64 -> {
                                    value = 9223372036854775807
                                } else -> {
                                    bound := 1
                                    shift := 1
                                    loop shift < bits {
                                        bound *= 2
                                        shift += 1
                                    }
                                    value = bound - 1
                                }
                            }
                        }
                        bits == 64 -> {
                            value = -1
                        }
                        bits == 63 -> {
                            value = 9223372036854775807
                        }
                        else -> {
                            bound := 1
                            shift := 0
                            loop shift < bits {
                                bound *= 2
                                shift += 1
                            }
                            value = bound - 1
                        }
                    }
                }
                signed -> {
                    if {
                        bits == 64 -> {
                            value = -9223372036854775808
                        } else -> {
                            bound := 1
                            shift := 1
                            loop shift < bits {
                                bound *= 2
                                shift += 1
                            }
                            value = -bound
                        }
                    }
                }
            }
            return Val(MirConstant.Int{value: value, width: width, spelling: None})
        }
        else -> {}
    }
    None
}

fn jet_codegen_lower_memo_stats(builder: &JetCodegenBuilder, expression: TExpr, name: String) -> MirValueId Never! {
    name_value := jet_codegen_emit_value(&builder, expression.span, Type.String, MirOperation.Constant{value: MirConstant.String{value: name}})
    bound_value := jet_codegen_emit_value(&builder, expression.span, Type.Int, MirOperation.Constant{value: MirConstant.Int{value: -1, width: None, spelling: None}})
    carrier := jet_codegen_failure_carrier_for_type(expression.ty)
    call := jet_codegen_intern_route(&builder, MirPreludeFamily.StaticPrelude, "core.memo", "stats", "jet_memo_stats", 2, [Bool]{false, false}, None, carrier, MirPreludeAbi.Value)
    args := [MirCallArg]{
        jet_codegen_numeric_call_arg(name_value, expression.span),
        jet_codegen_numeric_call_arg(bound_value, expression.span),
    }
    jet_codegen_emit_host_route_call(&builder, expression, call, args, [Bool]{false, false})
}

fn jet_codegen_lower_host_helper(builder: &JetCodegenBuilder, expression: TExpr, kind: THelperKind, host_args: [THostArg]) -> MirValueId {
    member := ""
    symbol := ""
    arity := 0
    borrow_mask := [Bool]{}
    if kind == {
        .ClockNew -> {
            member = "clock_new"
            symbol = "jet_std_clock_new"
            arity = 1
            borrow_mask = [Bool]{false}
        }
        .ClockSystem -> {
            member = "clock_system"
            symbol = "jet_std_clock_system"
        }
    }
    carrier := jet_codegen_failure_carrier_for_type(expression.ty)
    call := jet_codegen_intern_route(&builder, MirPreludeFamily.StaticPrelude, "core.clock", member, symbol, arity, borrow_mask, None, carrier, MirPreludeAbi.Value)
    args := jet_codegen_lower_host_args(&builder, host_args, expression.span)
    jet_codegen_emit_host_route_call(&builder, expression, call, args, borrow_mask)
}

fn jet_codegen_lower_cell_guard_project(builder: &JetCodegenBuilder, expression: TExpr, recv: TExpr, paths: [[String]], result_type: Type, editable: Bool, edit_paths_disjoint: Bool) -> MirValueId {
    guard := jet_codegen_lower_expr(&builder, recv)
    field_paths := [[MirFieldId]]{}
    loop path in paths {
        owner_type := recv.ty
        fields := [MirFieldId]{}
        loop field in path {
            &fields.push(jet_codegen_host_field_id(builder, owner_type, field))
            owner_type = jet_codegen_checked_host_field_type(builder, owner_type, field)
        }
        &field_paths.push(fields)
    }
    carrier := jet_codegen_failure_carrier_for_type(expression.ty)
    map_member := if editable -> "map_edit" else -> "map_read"
    map_call := jet_codegen_intern_route(&builder, MirPreludeFamily.StaticPrelude, "core.cell_guard", map_member, "jet_cell_guard_map", 2, [Bool]{true, false}, None, carrier, MirPreludeAbi.Value)
    split_call := None
    if field_paths.len() == 2 {
        split_member := if editable -> "split_edit" else -> "split_read"
        split_call = Val(jet_codegen_intern_route(&builder, MirPreludeFamily.StaticPrelude, "core.cell_guard", split_member, "jet_cell_guard_split", 3, [Bool]{true, false, false}, None, carrier, MirPreludeAbi.Value))
    }
    jet_codegen_emit_value(&builder, expression.span, expression.ty, MirOperation.Semantic{operation: MirSemanticOp.CellGuardProject{map_call: map_call, split_call: split_call, guard: guard, paths: field_paths, editable: editable, edit_paths_disjoint: edit_paths_disjoint}})
}

fn jet_codegen_lower_gc_read(builder: &JetCodegenBuilder, expression: TExpr, root: TLocal) -> MirValueId {
    root_value := jet_codegen_lower_gc_local(&builder, root, expression.span)
    carrier := jet_codegen_failure_carrier_for_type(expression.ty)
    call := jet_codegen_intern_route(&builder, MirPreludeFamily.StaticPrelude, "core.gc", "read", "jet_gc_read", 1, [Bool]{true}, Val(Effect.Mem), carrier, MirPreludeAbi.Value)
    args := [MirCallArg]{jet_codegen_numeric_call_arg(root_value, expression.span)}
    jet_codegen_emit_host_route_call(&builder, expression, call, args, [Bool]{true})
}

fn jet_codegen_lower_expect_snapshot(builder: &JetCodegenBuilder, expression: TExpr, value: TExpr, snap_path: String) -> MirValueId {
    value_type := value.ty
    shown_value := jet_codegen_lower_expr(&builder, value)
    shown := jet_codegen_lower_direct_display(&builder, shown_value, value_type, expression.span)
    path := jet_codegen_emit_value(&builder, expression.span, Type.String, MirOperation.Constant{value: MirConstant.String{value: snap_path}})
    carrier := jet_codegen_failure_carrier_for_type(expression.ty)
    call := jet_codegen_intern_route(&builder, MirPreludeFamily.StaticPrelude, "core.test", "expect_snapshot", "jet_expect_snapshot", 2, [Bool]{false, false}, Val(Effect.FS), carrier, MirPreludeAbi.Value)
    args := [MirCallArg]{
        jet_codegen_numeric_call_arg(shown, expression.span),
        jet_codegen_numeric_call_arg(path, expression.span),
    }
    jet_codegen_emit_host_route_call(&builder, expression, call, args, [Bool]{false, false})
}

fn jet_codegen_lower_expiring_new(builder: &JetCodegenBuilder, expression: TExpr, value: TExpr, duration: TExpr, clock: TExpr, elem: Type, secret: Bool) -> MirValueId {
    values := [TExpr]{value, duration, clock}
    args := [MirCallArg]{}
    loop item in values -> &args.push(jet_codegen_numeric_call_arg(jet_codegen_lower_expr(&builder, item), expression.span))
    carrier := jet_codegen_failure_carrier_for_type(expression.ty)
    member := if secret -> "secret_new" else -> "new"
    symbol := if secret -> "jet_expiring_secret_new" else -> "jet_expiring_new"
    borrow_mask := [Bool]{false, true, true}
    call := jet_codegen_intern_route(&builder, MirPreludeFamily.StaticPrelude, "core.expiring", member, symbol, 3, borrow_mask, Val(Effect.Time), carrier, MirPreludeAbi.Value)
    jet_codegen_apply_host_route_access(&builder, &args, borrow_mask)
    type_args := if secret -> [MirType]{jet_codegen_lower_type_for_function(elem, &builder)} else -> [MirType]{jet_codegen_lower_type_for_function(value.ty, &builder)}
    jet_codegen_emit_value(&builder, expression.span, expression.ty, MirOperation.Semantic{operation: MirSemanticOp.StaticPreludeCall{call: call, args: args, owner_type_args: [MirPreludeTypeArg]{}, type_args: type_args}})
}

fn jet_codegen_lower_ambient_input(builder: &JetCodegenBuilder, expression: TExpr, prompt: TExpr?) -> MirValueId {
    prompt_value := None
    if prompt == .Val(value) -> prompt_value = Val(jet_codegen_lower_expr(&builder, value))
    call := jet_codegen_intern_route(&builder, MirPreludeFamily.StaticPrelude, "core.term", "input", "jet_std_io_input", 1, [Bool]{true}, Val(Effect.IO), jet_codegen_failure_carrier_for_type(expression.ty), MirPreludeAbi.Effect)
    jet_codegen_emit_value(&builder, expression.span, expression.ty, MirOperation.Semantic{operation: MirSemanticOp.AmbientInput{call: call, prompt: prompt_value}})
}

fn jet_codegen_close_function(builder: JetCodegenBuilder, receiver_type: Type) -> TFunc Never! {
    name := if jet_codegen_unwrap_pattern_tags(receiver_type) == {
        .Named(value) | .Apply(value, _) -> value
        else -> panic("checked close receiver has no nominal owner")
    }
    owner :: jet_codegen_find_nominal_identity(builder.modules, builder.function.module_identity, name, builder.generic_type_names) ?? panic("checked close receiver has no registered owner")
    selected := None
    loop function in builder.functions {
        if function.name != "close" -> next
        function_owner := if function.kind == {
            .Method(_, ty) | .TraitMethod(_, _, ty, _, _) -> ty
            else -> next
        }
        function_owner_name := if jet_codegen_unwrap_pattern_tags(function_owner) == {
            .Named(value) | .Apply(value, _) -> value
            else -> next
        }
        identity :: jet_codegen_find_nominal_identity(builder.modules, function.module_identity, function_owner_name, [String]{}) ?? next
        if identity.key != owner.key -> next
        if selected != None -> panic("checked close method is ambiguous")
        selected = Val(function)
    }
    selected ?? panic("checked close method has no reachable function")
}

/// D-SHAPE-RESOURCE1=A: the nominal `Close` implementation that scope-end
/// cleanup runs for a still-live local of `ty`. Inside that implementation's
/// own `close` body the receiver is the value being closed, so values of the
/// type are released there without re-entering `close`.
fn jet_codegen_scope_end_close_function(builder: &JetCodegenBuilder, ty: Type) -> TFunc? Never! {
    name := ""
    if jet_codegen_unwrap_pattern_tags(ty) == {
        .Named(value) | .Apply(value, _) -> name = value
        else -> return None
    }
    owner :: jet_codegen_find_nominal_identity(builder.modules, builder.function.module_identity, name, builder.generic_type_names) ?? return None
    loop function in builder.functions {
        if function.name != "close" -> next
        function_owner := if function.kind == {
            .TraitMethod(_, _, owner_type, trait_symbol, _) -> {
                if jet_codegen_symbol_name(&builder, trait_symbol) != "Close" -> next
                owner_type
            }
            else -> next
        }
        function_owner_name := if jet_codegen_unwrap_pattern_tags(function_owner) == {
            .Named(value) | .Apply(value, _) -> value
            else -> next
        }
        identity :: jet_codegen_find_nominal_identity(builder.modules, function.module_identity, function_owner_name, [String]{}) ?? next
        if identity.key != owner.key -> next
        if jet_codegen_function_id(function) == jet_codegen_function_id(builder.function) -> return None
        return Val(function)
    }
    None
}

/// Close a moved-out scope-end value through the same consuming receiver
/// call an explicit `close(^value)` lowers to.
fn jet_codegen_emit_scope_end_close(builder: &JetCodegenBuilder, function: TFunc, ty: Type, value: MirValueId, span: Span) Never! {
    result_type := jet_codegen_checked_method_return_type(&builder, function, ty, [Type]{})
    argument := MirCallArg{
        value: value,
        place: None,
        access: MirAccess.Move,
        span: span,
        label: None,
        source_index: None,
        binder_slot: None,
        spread: false,
        implicit_clone: false,
        shared_auto_clone: false,
        owned_last_use: true,
        authority_boundary: false,
        fn_coercion: None,
        widen_fixed_to_list: false,
        widen_to_union: None,
        box_as_trait: None,
    }
    _ := jet_codegen_emit_value(&builder, span, result_type, MirOperation.Call{callee: MirCallee.User{function: jet_codegen_function_id(function)}, args: [MirCallArg]{argument}, type_args: [MirType]{}})
}

fn jet_codegen_lower_close(builder: &JetCodegenBuilder, expression: TExpr, inner: TExpr) -> MirValueId {
    receiver_type := jet_codegen_unwrap_pattern_tags(inner.ty)
    name := if receiver_type == {
        .Named(value) | .Apply(value, _) -> value
        else -> ""
    }
    if jet_codegen_is_core_file_owner_type(builder, receiver_type) || name == "Arena" || name == "Bump" || name == "Pool" || name == "Fixed" {
        value := jet_codegen_lower_expr(&builder, inner)
        return jet_codegen_emit_value(&builder, expression.span, expression.ty, MirOperation.Drop{value: value, kind: jet_codegen_ownership(inner.ty).drop})
    }
    if name == "DBLease" {
        receiver := jet_codegen_lower_expr(&builder, inner)
        call := jet_codegen_intern_route(&builder, MirPreludeFamily.HandleMethod, "core.handle", "db_lease.close", "jet_db_lease_close", 1, [Bool]{true}, Val(Effect.DB), jet_codegen_failure_carrier_for_type(expression.ty), MirPreludeAbi.Value)
        return jet_codegen_emit_value(&builder, expression.span, expression.ty, MirOperation.Semantic{operation: MirSemanticOp.HandleMethod{call: call, receiver: receiver, args: [MirValueId]{}, frame_schedule: None, frame_schedule_derivation: None}})
    }
    // D-DBDRIVER1: a connection or scope is a host handle with no source `Close` impl; its
    // consuming close is the provider's own `db.close` handle operation, whose Bool report the
    // Unit `close(^value)` statement discards.
    if name == "DBConnection" || name == "DBScope" {
        receiver := jet_codegen_lower_expr(&builder, inner)
        call := jet_codegen_intern_route(&builder, MirPreludeFamily.HandleMethod, "core.handle", "db.close", "jet_db_close", 1, [Bool]{false}, Val(Effect.DB), jet_codegen_failure_carrier_for_type(expression.ty), MirPreludeAbi.Value)
        _ := jet_codegen_emit_value(&builder, expression.span, Type.Bool, MirOperation.Semantic{operation: MirSemanticOp.HandleMethod{call: call, receiver: receiver, args: [MirValueId]{}, frame_schedule: None, frame_schedule_derivation: None}})
        return jet_codegen_emit_value(&builder, expression.span, expression.ty, MirOperation.Constant{value: MirConstant.Unit})
    }
    function := jet_codegen_close_function(builder, inner.ty)
    result_type := jet_codegen_checked_method_return_type(&builder, function, inner.ty, [Type]{})
    argument := jet_codegen_method_receiver_arg(&builder, inner, MirAccess.Move)
    jet_codegen_emit_value(&builder, expression.span, result_type, MirOperation.Call{callee: MirCallee.User{function: jet_codegen_function_id(function)}, args: [MirCallArg]{argument}, type_args: [MirType]{}})
}

fn jet_codegen_lower_host_call(builder: &JetCodegenBuilder, expression: TExpr, call: THostCall) -> MirValueId {
    if call == {
        .CCallback(symbol, lambda, ret, managed, plan_digest, callback_identity) -> return jet_codegen_lower_callback_adapter(&builder, expression, symbol, lambda, ret, managed, plan_digest, callback_identity)
        .Method(receiver, method, args) -> return jet_codegen_lower_host_method(&builder, expression, receiver, method, args)
        .TypedText(kind, argument) -> return jet_codegen_lower_typed_text_projection(&builder, expression, kind, argument)
        .TypedTextInterp(kind, literals, holes, trusted_html) -> return jet_codegen_lower_typed_text_interpolation(&builder, expression, kind, literals, holes, trusted_html)
        .CarrierFact(receiver, field, notes) -> return jet_codegen_lower_carrier_fact(&builder, expression, receiver, field, notes)
        .OptionProbe(inner, probe) -> return jet_codegen_lower_option_probe(&builder, expression, inner, probe)
        .TupleIndex(base, index) -> return jet_codegen_lower_tuple_index(&builder, expression, base, index)
        .FixedListIndex(base, index, line) -> return jet_codegen_lower_fixed_list_index(&builder, expression, base, index, line)
        .YieldSend(value) -> return jet_codegen_lower_yield_send(&builder, expression, value)
        .MemoStats(name) -> return jet_codegen_lower_memo_stats(&builder, expression, name)
        .Helper(_, kind, args) -> return jet_codegen_lower_host_helper(&builder, expression, kind, args)
        .CellGuardProject(recv, paths, result_type, editable, edit_paths_disjoint) -> return jet_codegen_lower_cell_guard_project(&builder, expression, recv, paths, result_type, editable, edit_paths_disjoint)
        .GcRead(root) -> return jet_codegen_lower_gc_read(&builder, expression, root)
        .ExpectSnapshot(value, snap_path) -> return jet_codegen_lower_expect_snapshot(&builder, expression, value, snap_path)
        .NumericBounds(ty, member) -> {
            constant :: jet_codegen_numeric_bound_constant(ty, member) ?? panic("unsupported numeric bound `{member}` on {type_name(ty)}")
            return jet_codegen_emit_value(&builder, expression.span, expression.ty, MirOperation.Constant{value: constant})
        }
        .ExpiringSecretNew(value, duration, clock, elem) -> return jet_codegen_lower_expiring_new(&builder, expression, value, duration, clock, elem, true)
        .ExpiringValueNew(value, duration, clock) -> return jet_codegen_lower_expiring_new(&builder, expression, value, duration, clock, value.ty, false)
        .StrMatchScan(subject, parts, probe) -> return jet_codegen_lower_string_match_scan(&builder, expression, subject, parts, probe)
        .BinMatchScan(subject, parts, probe) -> return jet_codegen_lower_binary_match_scan(&builder, expression, subject, parts, probe)
        .EnvSet(name, value, location) -> return jet_codegen_lower_env_set(&builder, expression, name, value, location)
        .GcEdit(root, _, edges, edit, index_temp, kind) -> return jet_codegen_lower_gc_edit(&builder, expression, root, edges, edit, index_temp, kind)
        .SwitchSubjectField(field) -> return jet_codegen_lower_switch_subject(&builder, expression, Val(field))
        .SwitchSubjectValue -> return jet_codegen_lower_switch_subject(&builder, expression, None)
        else -> panic("checked host call lies outside the current Jet codegen contract")
    }
}

fn jet_codegen_lower_expr(builder: &JetCodegenBuilder, expression: TExpr) -> MirValueId {
    if expression.kind == {
        .IntLit(value, width) -> {
            mir_width := if width == {
                None -> None
                Val(source) -> Val(MirIntegerWidth{signed: source.signed, bits: source.bits})
            }
            jet_codegen_emit_value(&builder, expression.span, expression.ty, MirOperation.Constant{value: MirConstant.Int{value: value, width: mir_width, spelling: None}})
        }
        .FloatLit(value) -> jet_codegen_emit_value(&builder, expression.span, expression.ty, MirOperation.Constant{value: MirConstant.Float{value: value, f32: expression.ty == Type.Float32, spelling: None}})
        .BoolLit(value) -> jet_codegen_emit_value(&builder, expression.span, expression.ty, MirOperation.Constant{value: MirConstant.Bool{value: value}})
        .CharLit(value) -> jet_codegen_emit_value(&builder, expression.span, expression.ty, MirOperation.Constant{value: MirConstant.Char{value: value}})
        .StrLit(parts) -> {
            lowered_parts := [MirStringPart]{}
            loop part in parts -> &lowered_parts.push(jet_codegen_lower_string_part(&builder, part))
            jet_codegen_emit_value(&builder, expression.span, expression.ty, MirOperation.BuildString{parts: lowered_parts})
        }
        .StructLit(fields, extra, as_trait) -> jet_codegen_lower_struct_literal(&builder, expression, fields, extra, as_trait)
        .EnumLit(enum_type, variant, payload) -> jet_codegen_lower_enum_literal(&builder, expression, enum_type, variant, payload)
        .EnumCtor(owner, variant, payload) -> jet_codegen_lower_enum_constructor(&builder, expression, owner, variant, payload)
        .Local(local) -> jet_codegen_emit_value(&builder, expression.span, expression.ty, MirOperation.ReadPlace{place: jet_codegen_lower_local_place(&builder, local)})
        .ConstRef(symbol) -> jet_codegen_lower_constant_reference(&builder, expression, symbol)
        .Field(receiver, field) -> jet_codegen_lower_field_expr(&builder, expression, receiver, field)
        .OptField(base, member, flatten) -> jet_codegen_lower_optional_field(&builder, expression, base, member, flatten)
        .OptMethodCall(base, binding, call, flatten) -> jet_codegen_lower_optional_method_call(&builder, expression, base, binding, call, flatten)
        .OrFallback(value, fallback, ambient_err) -> jet_codegen_lower_or_fallback(&builder, expression, value, fallback, ambient_err)
        .ResultHandler(subject, ok_pattern, ok_body, ok_value, err_pattern, err_body, err_value, terminal) -> jet_codegen_lower_result_handler(&builder, expression, subject, ok_pattern, ok_body, ok_value, err_pattern, err_body, err_value, terminal)
        .OptionLift2(function, left, right) -> jet_codegen_lower_option_lift2(&builder, expression, function, left, right)
        .DecodeUnder(segment, inner) -> jet_codegen_lower_decode_under(&builder, expression, segment, inner)
        .DataEntriesToMap(local) -> jet_codegen_lower_data_entries_to_map(&builder, expression, local)
        .InlineBlock(body) -> jet_codegen_lower_inline_block(&builder, expression, body)
        .Unit -> jet_codegen_emit_value(&builder, expression.span, expression.ty, MirOperation.Constant{value: MirConstant.Unit})
        .CtLit(value) -> {
            constant :: jet_codegen_lower_comptime_value(value, builder.modules, builder.function.module_identity, builder.generic_type_names) ?? panic("checked comptime closure cannot lower as a MIR constant")
            jet_codegen_emit_value(&builder, expression.span, expression.ty, MirOperation.Constant{value: constant})
        }
        .DistinctCtor(_, argument, _) -> {
            value := jet_codegen_lower_expr(&builder, argument)
            target := jet_codegen_lower_type_for_function(expression.ty, builder)
            jet_codegen_emit_value(&builder, expression.span, expression.ty, MirOperation.Convert{value: value, parameters: [MirValueId]{}, target: target, conversion: MirConversion.Transparent})
        }
        .RangeCheckedCtor(owner, argument, failure) -> jet_codegen_lower_range_checked_ctor(&builder, expression, owner, argument, failure)
        .DistinctConvert(owner, argument, operation, range, fallible) -> jet_codegen_lower_distinct_convert(&builder, expression, owner, argument, operation, range, fallible)
        .TraitBox(value, target) -> {
            jet_codegen_require_trait_box_target(target, &builder)
            if type_identity_key(expression.ty) != type_identity_key(target) -> panic("checked trait boxing result type disagrees with its target")
            if value.ty == {
                .TraitObject(_) -> {
                    if type_identity_key(value.ty) != type_identity_key(target) -> panic("checked trait-object upcast has no MIR operation")
                    return jet_codegen_lower_expr(&builder, value)
                }
                .Named(_) | .Apply(_, _) -> {}
                else -> panic("checked trait boxing source is not nominal")
            }
            value_id := jet_codegen_lower_expr(&builder, value)
            target_type := jet_codegen_lower_type_for_function(target, builder)
            target_id :: target_type.identity ?? panic("checked trait boxing target has no MIR type identity")
            jet_codegen_emit_value(&builder, expression.span, target, MirOperation.TraitBox{value: value_id, target: target_id})
        }
        .DistinctRaw(argument) -> {
            if jet_codegen_unit_distinct_base(builder, argument.ty) == None -> panic("checked distinct raw extraction has no distinct source type")
            value := jet_codegen_lower_expr(&builder, argument)
            target := jet_codegen_lower_type_for_function(expression.ty, builder)
            jet_codegen_emit_value(&builder, expression.span, expression.ty, MirOperation.Convert{value: value, parameters: [MirValueId]{}, target: target, conversion: MirConversion.Transparent})
        }
        .UnitConvert(_, argument, scale, offset, rounding, fallible, relative_uncertainty, file, line) -> jet_codegen_lower_unit_convert(&builder, expression, argument, scale, offset, rounding, fallible, relative_uncertainty, file, line)
        .PreciseBuiltin(type_name, function, args) -> jet_codegen_lower_precise_builtin(&builder, expression.span, expression.ty, type_name, function, args, jet_codegen_failure_carrier_for_type(expression.ty))
        .MathBuiltin(type_name, function, args) -> jet_codegen_lower_math_builtin(&builder, expression, type_name, function, args)
        .CoreCall(record, args, _, type_args, widen_to_vec, data_plan, failure) -> {
            canonical_record := jet_codegen_canonical_core_record(record)
            if canonical_record.module_name == "core.encoding.xml" && canonical_record.member == "decode" {
                return jet_codegen_lower_xml_typed_decode(&builder, expression, args, type_args, data_plan) ?? panic("checked typed XML decode has no target type")
            }
            registered_math := jet_codegen_lower_registered_math_constructor(&builder, expression, canonical_record, args, type_args, data_plan, failure)
            if registered_math != None -> return registered_math ?? panic("checked precise math constructor lowering disappeared")
            call := jet_codegen_intern_core_call(&builder, canonical_record)
            route := jet_codegen_intern_core_route(&builder, canonical_record, failure)
            lowered_args := [MirCallArg]{}
            index := 0
            loop index < args.len() {
                widen := false
                if index < widen_to_vec.len() -> widen = widen_to_vec[index]
                &lowered_args.push(jet_codegen_lower_core_call_arg(&builder, args[index], index, canonical_record, widen))
                index += 1
            }
            lowered_types := [MirType]{}
            loop ty in type_args -> &lowered_types.push(jet_codegen_lower_type_for_function(ty, &builder))
            call_failure := jet_codegen_core_call_fallibility(failure, &builder)
            if (canonical_record.module_name == "core.sys" && canonical_record.member == "stop") || (canonical_record.module_name == "core.process" && canonical_record.member == "exit") {
                jet_codegen_emit_explicit_stop_cleanups(&builder)
            }
            jet_codegen_emit_value(&builder, expression.span, expression.ty, MirOperation.CoreCall{call: call, route: route, args: lowered_args, type_args: lowered_types, fallibility: call_failure, data_plan: data_plan})
        }
        .Call(callee, type_args, args) -> {
            checked_foreign := jet_codegen_find_checked_foreign_row(builder.modules, callee.key)
            if checked_foreign != None {
                foreign_row :: checked_foreign ?? panic("checked foreign call row disappeared")
                if type_args.len() != 0 -> panic("checked foreign call carries type arguments")
                foreign_id := MirForeignId{value: stable_id("mir-foreign", foreign_row.key)}
                lowered_args := jet_codegen_lower_foreign_call_args(&builder, args, foreign_row.params)
                return jet_codegen_emit_value(&builder, expression.span, expression.ty, MirOperation.Call{callee: MirCallee.Foreign{id: foreign_id}, args: lowered_args, type_args: [MirType]{}})
            }
            target :: jet_codegen_find_function(builder.functions, callee.key) ?? panic("checked direct call has no TFunc target")
            jet_codegen_note_core_module(&builder, target.module_name)
            lowered_args := jet_codegen_lower_call_args(&builder, args, target.params)
            lowered_types := [MirType]{}
            loop ty in type_args -> &lowered_types.push(jet_codegen_lower_type_for_function(ty, builder))
            call_return_type := jet_codegen_checked_function_return_type(target, type_args)
            jet_codegen_emit_value(&builder, expression.span, call_return_type, MirOperation.Call{callee: MirCallee.User{function: jet_codegen_function_id(target)}, args: lowered_args, type_args: lowered_types})
        }
        .ExternCall(symbol, _, args) -> {
            foreign_row :: jet_codegen_find_checked_foreign_row(builder.modules, symbol) ?? panic("checked extern call has no foreign row")
            foreign_id := MirForeignId{value: stable_id("mir-foreign", foreign_row.key)}
            lowered_args := jet_codegen_lower_extern_args(&builder, args)
            jet_codegen_emit_value(&builder, expression.span, expression.ty, MirOperation.Call{callee: MirCallee.Foreign{id: foreign_id}, args: lowered_args, type_args: [MirType]{}})
        }
        .IndirectCall(callee, type_args, args, signature) -> {
            callee_value := jet_codegen_lower_expr(&builder, callee)
            labels := [String]{}
            variadic := [Bool]{}
            conventions := [AccessConvention]{}
            _ := if signature == {
                .Fn(params, _, _, contract, metadata, _) -> {
                    index := 0
                    loop _ in params {
                        label := ""
                        convention := AccessConvention.Read
                        is_variadic := false
                        if contract != None && index < (contract ?? [CallContractRow]{}).len() -> label = (contract ?? [CallContractRow]{})[index].label
                        if metadata != None {
                            facts :: metadata ?? FunctionCallMetadata{names: [String]{}, defaults: [FunctionDefaultRef?]{}, variadic: [Bool]{}, conventions: [AccessConvention]{}, policies: CallablePolicyChain{policies: [CallablePolicy]{}}}
                            if label == "" && index < facts.names.len() -> label = facts.names[index]
                            if index < facts.conventions.len() -> convention = facts.conventions[index]
                            if index < facts.variadic.len() -> is_variadic = facts.variadic[index]
                        }
                        &labels.push(label)
                        &conventions.push(convention)
                        &variadic.push(is_variadic)
                        index += 1
                    }
                }
                else -> panic("checked indirect-call signature is not callable")
            }
            call_return_type := jet_codegen_callable_return_type(signature)
            lowered_args := jet_codegen_lower_call_args_for_signature(&builder, args, labels, variadic, conventions)
            lowered_types := [MirType]{}
            loop ty in type_args -> &lowered_types.push(jet_codegen_lower_type_for_function(ty, builder))
            jet_codegen_emit_value(&builder, expression.span, call_return_type, MirOperation.IndirectCall{callee: callee_value, args: lowered_args, type_args: lowered_types})
        }
        .MethodCall(receiver, method, type_args, args) -> jet_codegen_lower_method_call(&builder, expression, receiver, method, type_args, args)
        .NumericMethod(receiver, operation) -> jet_codegen_lower_numeric_method(&builder, expression, receiver, operation)
        .NumericBinaryMethod(receiver, operation, argument) -> jet_codegen_lower_numeric_binary_method(&builder, expression, receiver, operation, argument)
        .OverflowOpt(prefix, operation, line, _, lhs, rhs) -> jet_codegen_lower_overflow_opt(&builder, expression, prefix, operation, line, lhs, rhs)
        .Unary(op, operand) -> {
            value := jet_codegen_lower_expr(&builder, operand)
            jet_codegen_emit_value(&builder, expression.span, expression.ty, MirOperation.Unary{op: jet_codegen_lower_unary(op), value: value})
        }
        .Binary(op, overflow, line, lhs, rhs) -> {
            if op == {
                .And | .Or -> return jet_codegen_lower_short_circuit(&builder, expression, op, lhs, rhs)
                else -> {}
            }
            left := jet_codegen_lower_expr(&builder, lhs)
            right := jet_codegen_lower_expr(&builder, rhs)
            dispatch := jet_codegen_binary_dispatch(&builder, op, overflow, lhs.ty, expression.span, line)
            mir_overflow := MirBinaryOverflow.Unchecked
            if overflow && jet_codegen_fixed_width(lhs.ty) != None -> mir_overflow = MirBinaryOverflow.Trap
            jet_codegen_emit_value(&builder, expression.span, expression.ty, MirOperation.Binary{op: jet_codegen_lower_binary(op), dispatch: dispatch, overflow: mir_overflow, left: left, right: right})
        }
        .CompareChain(operands, operators, hooks) -> jet_codegen_lower_compare_chain(&builder, expression, operands, operators, hooks)
        .LayoutCompare(op, lhs, rhs) -> jet_codegen_lower_layout_compare(&builder, expression, op, lhs, rhs)
        .Index(base, index, kind, access, checked_call, location) -> jet_codegen_lower_index_value(&builder, expression, base, index, kind, access, checked_call, location)
        .PoolSlot(pool, index, mutable, field, line, source_line) -> jet_codegen_lower_pool_slot_value(&builder, expression, pool, index, mutable, field, line, source_line)
        .MathLaneIndex(lane_type, base, index, line) -> jet_codegen_lower_math_lane_index_value(&builder, expression, lane_type, base, index, line)
        .MathSwizzleRead(type_name, receiver, lanes) -> jet_codegen_lower_math_swizzle_read(&builder, expression, type_name, receiver, lanes)
        .ColumnarGather(base, index, line) -> jet_codegen_lower_columnar_gather(&builder, expression, base, index, line)
        .ColumnarColumnRead(base, index, owner, field, column, _) -> jet_codegen_lower_columnar_read(&builder, expression, base, index, owner, field, column)
        .IndexHook(_, base, index, line) -> jet_codegen_lower_index_hook(&builder, expression, base, index, line, None)
        .Slice(base, start, end, range, location) -> jet_codegen_lower_slice(&builder, expression, base, start, end, range, location)
        .Range(start, end, exclusive) -> {
            lowered_start := jet_codegen_lower_expr(&builder, start)
            lowered_end := jet_codegen_lower_expr(&builder, end)
            jet_codegen_emit_value(&builder, expression.span, expression.ty, MirOperation.Range{start: lowered_start, end: lowered_end, exclusive: exclusive})
        }
        .Tuple(values) -> jet_codegen_lower_tuple(&builder, expression, values)
        .ListSpread(parts) -> jet_codegen_lower_list_spread(&builder, expression, parts)
        .JSONLit(variant, argument, clone_arg) -> jet_codegen_lower_json_literal(&builder, expression, variant, argument, clone_arg)
        .DBValueLit(variant, argument, clone_arg) -> jet_codegen_lower_db_value_literal(&builder, expression, variant, argument, clone_arg)
        .List(values, trait_coercion) -> {
            lowered_values := [MirValueId]{}
            loop value in values -> &lowered_values.push(jet_codegen_lower_expr(&builder, value))
            lowered_coercion := if trait_coercion == {
                None -> None
                Val(ty) -> {
                    jet_codegen_require_trait_box_target(ty, &builder)
                    loop value in values {
                        if value.ty == {
                            .TraitObject(_) -> if type_identity_key(value.ty) != type_identity_key(ty) -> panic("checked list trait coercion attempts an unsupported trait-object upcast")
                            .Named(_) | .Apply(_, _) -> {}
                            else -> panic("checked list trait coercion source is not nominal")
                        }
                    }
                    jet_codegen_lower_type_for_function(ty, &builder).identity
                }
            }
            jet_codegen_emit_value(&builder, expression.span, expression.ty, MirOperation.BuildList{values: lowered_values, trait_coercion: lowered_coercion})
        }
        .Map(entries) -> {
            lowered_entries := [MirMapEntry]{}
            loop entry in entries -> &lowered_entries.push(jet_codegen_lower_map_entry(&builder, entry))
            jet_codegen_emit_value(&builder, expression.span, expression.ty, MirOperation.BuildMap{entries: lowered_entries})
        }
        .Present(value) -> {
            lowered := jet_codegen_lower_expr(&builder, value)
            jet_codegen_emit_value(&builder, expression.span, expression.ty, MirOperation.Present{value: lowered})
        }
        .Try(value, conversion, _) -> jet_codegen_lower_try(&builder, expression, value, None, conversion, None, 0, None)
        .TryWithContext(inner, note, conversion, file, line, function) -> jet_codegen_lower_try(&builder, expression, inner, note, conversion, Val(file), line, Val(function))
        .Absent -> jet_codegen_emit_value(&builder, expression.span, expression.ty, MirOperation.Absent)
        .Ok(value) -> {
            lowered := jet_codegen_lower_expr(&builder, value)
            lowered = jet_codegen_widen_result_payload(&builder, expression, value, lowered, true)
            jet_codegen_emit_value(&builder, expression.span, expression.ty, MirOperation.ResultOk{value: lowered})
        }
        .Err(value) -> {
            lowered := jet_codegen_lower_expr(&builder, value)
            lowered = jet_codegen_widen_result_payload(&builder, expression, value, lowered, false)
            jet_codegen_emit_value(&builder, expression.span, expression.ty, MirOperation.ResultErr{value: lowered})
        }
        .Drop(value) -> {
            lowered := jet_codegen_lower_expr(&builder, value)
            jet_codegen_emit_value(&builder, expression.span, expression.ty, MirOperation.Drop{value: lowered, kind: jet_codegen_ownership(value.ty).drop})
        }
        .ResourceNew(value) -> {
            lowered := jet_codegen_lower_expr(&builder, value)
            jet_codegen_emit_value(&builder, expression.span, expression.ty, MirOperation.Move{value: lowered})
        }
        .ResourceTake(local) -> {
            place := jet_codegen_lower_local_place(&builder, local)
            jet_codegen_emit_value(&builder, expression.span, expression.ty, MirOperation.MovePlace{place: place})
        }
        .Clone(value) | .ExplicitCopy(value) -> {
            lowered := jet_codegen_lower_expr(&builder, value)
            jet_codegen_emit_value(&builder, expression.span, expression.ty, MirOperation.Copy{value: lowered, materialize_view: false})
        }
        .MaterializeView(value) -> {
            lowered := jet_codegen_lower_expr(&builder, value)
            jet_codegen_emit_value(&builder, expression.span, expression.ty, MirOperation.Copy{value: lowered, materialize_view: true})
        }
        .RequireStop(kind, location, always_stops) -> jet_codegen_lower_require_stop(&builder, expression, kind, always_stops, location)
        .AmbientInput(prompt) -> jet_codegen_lower_ambient_input(&builder, expression, prompt)
        .Close(inner) -> jet_codegen_lower_close(&builder, expression, inner)
        .Move(value) -> {
            if value.kind == {
                .Local(local) -> {
                    place := jet_codegen_lower_local_place(&builder, local)
                    jet_codegen_emit_value(&builder, expression.span, expression.ty, MirOperation.MovePlace{place: place})
                }
                else -> {
                    lowered := jet_codegen_lower_expr(&builder, value)
                    jet_codegen_emit_value(&builder, expression.span, expression.ty, MirOperation.Move{value: lowered})
                }
            }
        }
        .Borrow(value, access) -> {
            place := jet_codegen_lower_place_for_access(&builder, TPlace.Expr{value: value}, jet_codegen_lower_access(access))
            jet_codegen_emit_value(&builder, expression.span, expression.ty, MirOperation.AddressOf{place: place, access: jet_codegen_lower_access(access)})
        }
        .AddressOf(place, access, _) -> {
            lowered_place := jet_codegen_lower_place_for_access(&builder, place, jet_codegen_lower_access(access))
            jet_codegen_emit_value(&builder, expression.span, expression.ty, MirOperation.AddressOf{place: lowered_place, access: jet_codegen_lower_access(access)})
        }
        .RawAddressOf(place) -> {
            lowered_place := jet_codegen_lower_read_place(&builder, place)
            jet_codegen_emit_value(&builder, expression.span, expression.ty, MirOperation.RawAddressOf{place: lowered_place})
        }
        .RawOf(value) -> {
            lowered_place := jet_codegen_lower_read_place(&builder, TPlace.Expr{value: value})
            jet_codegen_emit_value(&builder, expression.span, expression.ty, MirOperation.RawAddressOf{place: lowered_place})
        }
        .Deref(value) -> {
            lowered := jet_codegen_lower_expr(&builder, value)
            jet_codegen_emit_value(&builder, expression.span, expression.ty, MirOperation.Deref{value: lowered})
        }
        .PtrFromAddr(address, element) -> {
            lowered := jet_codegen_lower_expr(&builder, address)
            jet_codegen_emit_value(&builder, expression.span, expression.ty, MirOperation.PtrFromAddr{address: lowered, element: jet_codegen_lower_type_for_function(element, builder)})
        }
        .LayoutLiteral(value) -> {
            lowered := jet_codegen_lower_expr(&builder, value)
            jet_codegen_emit_value(&builder, expression.span, expression.ty, MirOperation.Semantic{operation: MirSemanticOp.LayoutLiteral{inner: lowered}})
        }
        .Unreachable(line) -> jet_codegen_lower_unreachable(&builder, expression, line)
        .Todo(line) -> jet_codegen_lower_todo(&builder, expression, line)
        .Never(reason) -> jet_codegen_emit_value(&builder, expression.span, expression.ty, MirOperation.Never{reason: reason})
        .PatternMatches(subject, pattern) -> {
            subject_value := jet_codegen_lower_expr(&builder, subject)
            jet_codegen_lower_pattern_condition(&builder, pattern, subject, subject_value, false)
        }
        .Lambda(lambda) | .LambdaValue(lambda) -> jet_codegen_lower_lambda(&builder, lambda, false, "direct").value
        .SharedGuardWait(guard, condition, predicate) -> jet_codegen_lower_shared_guard_wait(&builder, expression, guard, condition, predicate)
        .CoreClosureCall(kind) -> jet_codegen_lower_core_closure_call(&builder, expression, kind)
        .TaskGroupAll(tasks) -> jet_codegen_lower_task_group_value(&builder, expression, tasks, MirTaskGroupKind.All)
        .TaskGroupRace(tasks) -> jet_codegen_lower_task_group_value(&builder, expression, tasks, MirTaskGroupKind.Race)
        .TaskGroupAny(tasks) -> jet_codegen_lower_task_group_value(&builder, expression, tasks, MirTaskGroupKind.Any)
        .SelectWait(table, nonblocking) -> jet_codegen_lower_select_wait(&builder, expression, table, nonblocking)
        .SelectStart | .SelectRecv(_, _) | .SelectAfter(_, _, _) -> panic("readiness-table construction is only valid as the operand of select wait")
        .FnValue(kind) -> jet_codegen_lower_fn_value(&builder, expression, kind)
        .HostBorrowCallback(callable, params) -> jet_codegen_lower_host_borrow_callback(&builder, expression, callable, params, false)
        .BuiltinMethod(receiver, operation, args) -> jet_codegen_lower_builtin_method(&builder, expression, receiver, operation, args)
        .HandleMethod(receiver, operation, args) -> jet_codegen_lower_handle_method(&builder, expression, receiver, operation, args)
        .ClosureMethod(receiver, operation, args) -> jet_codegen_lower_closure_method(&builder, expression, receiver, operation, args)
        .HostCall(call) -> jet_codegen_lower_host_call(&builder, expression, call)
        else -> panic("checked TIR expression lies outside the current Jet codegen contract")
    }
}

fn jet_codegen_emit_expr(builder: &JetCodegenBuilder, expression: TExpr) -> MirValueId {
    jet_codegen_lower_expr(&builder, expression)
}

fn jet_codegen_lower_short_circuit(builder: &JetCodegenBuilder, expression: TExpr, op: TBinaryOp, lhs: TExpr, rhs: TExpr) -> MirValueId {
    left := jet_codegen_lower_expr(&builder, lhs)
    rhs_block := jet_codegen_new_block(&builder, rhs.span, "short-circuit-rhs")
    short_block := jet_codegen_new_block(&builder, expression.span, "short-circuit-value")
    join_block := jet_codegen_new_block(&builder, expression.span, "short-circuit-join")
    if op == {
        .And -> jet_codegen_terminate(&builder, MirTerminator.Branch{condition: left, then_target: rhs_block, else_target: short_block})
        .Or -> jet_codegen_terminate(&builder, MirTerminator.Branch{condition: left, then_target: short_block, else_target: rhs_block})
        else -> panic("short-circuit lowering received a non-short-circuit operator")
    }
    jet_codegen_switch_block(&builder, rhs_block)
    right := jet_codegen_lower_expr(&builder, rhs)
    rhs_predecessor := builder.current
    jet_codegen_terminate(&builder, MirTerminator.Jump{target: join_block})
    jet_codegen_switch_block(&builder, short_block)
    short_value := jet_codegen_emit_value(&builder, expression.span, Type.Bool, MirOperation.Constant{value: MirConstant.Bool{value: op == TBinaryOp.Or}})
    short_predecessor := builder.current
    jet_codegen_terminate(&builder, MirTerminator.Jump{target: join_block})
    jet_codegen_switch_block(&builder, join_block)
    incoming := [MirPhiIncoming]{
        MirPhiIncoming{block: rhs_predecessor, value: right},
        MirPhiIncoming{block: short_predecessor, value: short_value},
    }
    jet_codegen_emit_value(&builder, expression.span, Type.Bool, MirOperation.Phi{incoming: incoming})
}


struct JetCodegenPatternTest {
    pub value: MirValueId
    pub matched: MirValueId?
}

fn jet_codegen_unwrap_pattern_tags(ty: Type) -> Type Never! {
    if ty == {
        .Tagged(_, inner) -> return jet_codegen_unwrap_pattern_tags(inner)
        else -> return ty
    }
}

fn jet_codegen_pattern_integer_width(ty: Type) -> MirIntegerWidth? {
    if ty == {
        .IntN(signed, bits) -> Val(MirIntegerWidth{signed: signed, bits: bits})
        .InlineRange(base, _, _) -> jet_codegen_pattern_integer_width(base)
        .Tagged(_, inner) -> jet_codegen_pattern_integer_width(inner)
        else -> None
    }
}

fn jet_codegen_pattern_integer_constant(builder: &JetCodegenBuilder, ty: Type, value: Int, span: Span) -> MirValueId Never! {
    constant := if jet_codegen_unwrap_pattern_tags(ty) == Type.Char -> MirConstant.Char{value: value} else -> MirConstant.Int{value: value, width: jet_codegen_pattern_integer_width(ty), spelling: None}
    jet_codegen_emit_value(&builder, span, ty, MirOperation.Constant{value: constant})
}

fn jet_codegen_lower_numeric_pattern_range(builder: &JetCodegenBuilder, subject: MirValueId, ty: Type, lo: Int, hi: Int, span: Span) -> MirValueId Never! {
    lower := jet_codegen_pattern_integer_constant(&builder, ty, lo, span)
    upper := jet_codegen_pattern_integer_constant(&builder, ty, hi, span)
    ge := jet_codegen_emit_value(&builder, span, Type.Bool, MirOperation.Binary{op: jet_codegen_lower_binary(TBinaryOp.Ge), dispatch: MirBinaryDispatch.Primitive, overflow: MirBinaryOverflow.Unchecked, left: subject, right: lower})
    le := jet_codegen_emit_value(&builder, span, Type.Bool, MirOperation.Binary{op: jet_codegen_lower_binary(TBinaryOp.Le), dispatch: MirBinaryDispatch.Primitive, overflow: MirBinaryOverflow.Unchecked, left: subject, right: upper})
    jet_codegen_emit_value(&builder, span, Type.Bool, MirOperation.Binary{op: MirBinaryOp.And, dispatch: MirBinaryDispatch.Primitive, overflow: MirBinaryOverflow.Unchecked, left: ge, right: le})
}

fn jet_codegen_lower_guarded_pattern_range(builder: &JetCodegenBuilder, test: MirValueId, payload_ty: Type, lo: Int, hi: Int, span: Span, role: String, payload_operation: MirOperation) -> MirValueId Never! {
    matched_block := jet_codegen_new_block(&builder, span, "{role}-matched")
    missed_block := jet_codegen_new_block(&builder, span, "{role}-missed")
    join_block := jet_codegen_new_block(&builder, span, "{role}-join")
    jet_codegen_terminate(&builder, MirTerminator.Branch{condition: test, then_target: matched_block, else_target: missed_block})
    jet_codegen_switch_block(&builder, matched_block)
    payload := jet_codegen_emit_value(&builder, span, payload_ty, payload_operation)
    range_test := jet_codegen_lower_numeric_pattern_range(&builder, payload, payload_ty, lo, hi, span)
    matched_predecessor := builder.current
    jet_codegen_terminate(&builder, MirTerminator.Jump{target: join_block})
    jet_codegen_switch_block(&builder, missed_block)
    false_value := jet_codegen_emit_value(&builder, span, Type.Bool, MirOperation.Constant{value: MirConstant.Bool{value: false}})
    missed_predecessor := builder.current
    jet_codegen_terminate(&builder, MirTerminator.Jump{target: join_block})
    jet_codegen_switch_block(&builder, join_block)
    incoming := [MirPhiIncoming]{
        MirPhiIncoming{block: matched_predecessor, value: range_test},
        MirPhiIncoming{block: missed_predecessor, value: false_value},
    }
    jet_codegen_emit_value(&builder, span, Type.Bool, MirOperation.Phi{incoming: incoming})
}

// S31: the payload type behind a checked `.Val` / `.Ok` / `.Err` pattern.
fn jet_codegen_carrier_payload_type(subject_ty: Type, ok: Bool) -> Type Never! {
    if jet_codegen_unwrap_pattern_tags(subject_ty) == {
        .Option(inner) -> inner
        .Result(ok_ty, err_ty) -> if ok -> ok_ty else -> err_ty
        else -> panic("checked carrier pattern has no payload type")
    }
}

// S31: a nested pattern is tested and bound as its own TPattern over the
// payload, with the payload type's owner and the outer binding facts.
fn jet_codegen_nested_pattern(pattern: TPattern, nested: TNestedPattern) -> TPattern Never! {
    inner := pattern
    inner.shape = nested.shape
    inner.enum_type = nested.enum_type
    inner
}

fn jet_codegen_nested_subject(ty: Type, span: Span) -> TExpr Never! {
    TExpr{ty: ty, kind: TExprKind.Unit, span: span, integer_bounds: None, cost: None}
}

// S31: once the carrier or variant test passed, project the payload and test
// it against the nested pattern; a missed carrier test stays false.
fn jet_codegen_lower_guarded_nested_pattern(builder: &JetCodegenBuilder, pattern: TPattern, test: MirValueId, payload_ty: Type, nested: TNestedPattern, span: Span, role: String, payload_operation: MirOperation) -> MirValueId {
    matched_block := jet_codegen_new_block(&builder, span, "{role}-matched")
    missed_block := jet_codegen_new_block(&builder, span, "{role}-missed")
    join_block := jet_codegen_new_block(&builder, span, "{role}-join")
    jet_codegen_terminate(&builder, MirTerminator.Branch{condition: test, then_target: matched_block, else_target: missed_block})
    jet_codegen_switch_block(&builder, matched_block)
    payload := jet_codegen_emit_value(&builder, span, payload_ty, payload_operation)
    nested_test := jet_codegen_lower_pattern_shape_condition(&builder, jet_codegen_nested_pattern(pattern, nested), jet_codegen_nested_subject(payload_ty, span), payload, nested.shape, false, false)
    matched_predecessor := builder.current
    jet_codegen_terminate(&builder, MirTerminator.Jump{target: join_block})
    jet_codegen_switch_block(&builder, missed_block)
    false_value := jet_codegen_emit_value(&builder, span, Type.Bool, MirOperation.Constant{value: MirConstant.Bool{value: false}})
    missed_predecessor := builder.current
    jet_codegen_terminate(&builder, MirTerminator.Jump{target: join_block})
    jet_codegen_switch_block(&builder, join_block)
    incoming := [MirPhiIncoming]{
        MirPhiIncoming{block: matched_predecessor, value: nested_test},
        MirPhiIncoming{block: missed_predecessor, value: false_value},
    }
    jet_codegen_emit_value(&builder, span, Type.Bool, MirOperation.Phi{incoming: incoming})
}

// S31: bind the names of a matched nested pattern from its payload.
fn jet_codegen_bind_nested_pattern(builder: &JetCodegenBuilder, pattern: TPattern, payload_ty: Type, nested: TNestedPattern, span: Span, payload_operation: MirOperation, reuse: Bool) {
    payload := jet_codegen_emit_value(&builder, span, payload_ty, payload_operation)
    _ := jet_codegen_lower_pattern_shape_condition(&builder, jet_codegen_nested_pattern(pattern, nested), jet_codegen_nested_subject(payload_ty, span), payload, nested.shape, true, reuse)
}

fn jet_codegen_pattern_variant_payload_type(builder: JetCodegenBuilder, subject_ty: Type, owner: SymbolId, variant: String, index: Int) -> Type Never! {
    subject_type := jet_codegen_unwrap_pattern_tags(subject_ty)
    loop semantic_module in builder.modules {
        loop nominal in semantic_module.nominals {
            if nominal.symbol.id.key != owner.key -> next
            variant_row := None
            loop candidate in nominal.variants {
                if candidate.symbol.name == variant -> variant_row = Val(candidate)
            }
            row :: variant_row ?? panic("checked pattern variant has no registered payload")
            raw_type := if row.payload == {
                .Unit -> panic("checked unit variant has a payload pattern")
                .Single(ty, _) -> if index == 0 -> ty else -> panic("checked variant payload index is out of range")
                .Named(fields) -> if index >= 0 && index < fields.len() -> fields[index].ty else -> panic("checked variant payload index is out of range")
            }
            generic_names := [String]{}
            loop parameter in nominal.generic_params -> &generic_names.push(parameter.name)
            generic_args := if subject_type == {
                .Named(_) -> [Type]{}
                .Apply(_, args) -> args
                else -> panic("checked variant pattern subject is not its nominal owner")
            }
            if generic_names.len() != generic_args.len() -> panic("checked variant pattern has incomplete owner type arguments")
            return sema_inference_substitute_type(raw_type, generic_names, generic_args)
        }
    }
    panic("checked pattern owner has no registered nominal declaration")
}

fn jet_codegen_pattern_field_id(builder: JetCodegenBuilder, subject_ty: Type, field: String) -> MirFieldId Never! {
    resolved := jet_codegen_resolve_field_by_name(builder.modules, builder.function.module_identity, builder.generic_type_names, jet_codegen_unwrap_pattern_tags(subject_ty), field)
    jet_codegen_mir_field_id(resolved)
}

fn jet_codegen_pattern_binding_fact(pattern: TPattern, name: String) -> TPatternBindingFact Never! {
    loop fact in pattern.bindings {
        if fact.name == name -> return fact
    }
    panic("checked pattern binding has no typed binding fact")
}

fn jet_codegen_write_pattern_binding(builder: &JetCodegenBuilder, fact: TPatternBindingFact, value: MirValueId, reuse: Bool) Never! {
    if fact.name == "" || fact.name == "_" -> return
    local := tir_user_local(fact.name, fact.span)
    local.mutable = fact.mutable
    local.symbol_id = fact.symbol_id
    place := if {
        reuse -> {
            binding :: jet_codegen_find_binding_for_local(builder, local) ?? panic("checked or-pattern binding has no shared MIR local")
            binding.place
        } else -> {
            jet_codegen_bind_local(&builder, local, fact.ty, fact.mutable, None, None, false)
        }
    }
    bound_value := value
    if fact.boxed -> bound_value = jet_codegen_emit_value(&builder, fact.span, fact.ty, MirOperation.Deref{value: value})
    _ := jet_codegen_emit(&builder, fact.span, None, MirOperation.WritePlace{place: place, value: bound_value})
}

fn jet_codegen_pattern_match_route(builder: &JetCodegenBuilder, binary: Bool) -> MirPreludeCallId Never! {
    member := if binary -> "binary_match" else -> "text_match"
    symbol := if binary -> "jet_binary_pattern_match" else -> "jet_text_pattern_match"
    identity := "StaticPrelude:core.pattern:{member}:{symbol}:2:2:[true,false]:None:Infallible:Value"
    id := MirPreludeCallId{value: stable_id("mir-prelude-call", identity)}
    jet_codegen_intern_prelude_call(&builder, MirPreludeCall{
        id: id,
        family: MirPreludeFamily.StaticPrelude,
        module_name: "core.pattern",
        member: member,
        symbol: MirSymbol.Prelude{name: symbol},
        signature: MirCallSignature{arity: 2, max_arity: 2, borrow_mask: [Bool]{true, false}},
        effect_kind: None,
        fallibility: MirCallFallibility.Infallible,
        abi: MirPreludeAbi.Value,
        authority: None,
        db_metadata: None,
    })
}

fn jet_codegen_pattern_tuple_result_type(pattern: TPattern) -> Type Never! {
    fields := [TypeTupleField]{}
    loop fact in pattern.bindings -> &fields.push(TypeTupleField{name: fact.name, ty: fact.ty})
    Type.Option{inner: Type.Tuple{fields: fields}}
}

fn jet_codegen_pattern_mir_type_id(builder: JetCodegenBuilder, ty: Type) -> MirTypeId Never! {
    lowered := jet_codegen_lower_type_for_function(ty, builder)
    lowered.identity ?? panic("checked pattern payload type has no canonical MIR identity")
}

fn jet_codegen_pattern_text_hole_kind(ty: Type) -> MirTextHoleKind Never! {
    if ty == {
        .String | .Char -> MirTextHoleKind.Text
        .Int | .IntN(_, _) | .Measure(_) -> MirTextHoleKind.Int
        .Float | .Float32 -> MirTextHoleKind.Float
        .Bool -> MirTextHoleKind.Bool
        .InlineRange(_, lo, hi) -> MirTextHoleKind.InlineRange{lo: lo, hi: hi}
        .Tagged(_, inner) -> jet_codegen_pattern_text_hole_kind(inner)
        else -> panic("checked text pattern hole has an unsupported type")
    }
}

fn jet_codegen_lower_text_pattern_test(builder: &JetCodegenBuilder, pattern: TPattern, subject: MirValueId, parts: [TTextPatternPart], span: Span) -> JetCodegenPatternTest Never! {
    lowered_parts := [MirTextPatternPart]{}
    loop part in parts {
        if part == {
            .Literal(value) -> &lowered_parts.push(MirTextPatternPart.Literal{value: value})
            .Hole(_, ty, hole_span) -> &lowered_parts.push(MirTextPatternPart.Hole{kind: jet_codegen_pattern_text_hole_kind(ty), ty: jet_codegen_pattern_mir_type_id(builder, ty), span: hole_span})
        }
    }
    matched := jet_codegen_emit_value(&builder, span, jet_codegen_pattern_tuple_result_type(pattern), MirOperation.Semantic{operation: MirSemanticOp.TextPatternMatch{call: jet_codegen_pattern_match_route(&builder, false), subject: subject, parts: lowered_parts}})
    JetCodegenPatternTest{value: jet_codegen_emit_value(&builder, span, Type.Bool, MirOperation.PatternMatched{matched: matched}), matched: Val(matched)}
}

fn jet_codegen_lower_binary_pattern_test(builder: &JetCodegenBuilder, pattern: TPattern, subject: MirValueId, parts: [TBinaryPatternPart], span: Span) -> JetCodegenPatternTest Never! {
    lowered_parts := [MirBinaryPatternPart]{}
    loop part in parts {
        if part == {
            .Literal(value) -> &lowered_parts.push(MirBinaryPatternPart.Literal{bytes: value})
            .Bits(_, width, big_endian, ty, part_span) -> &lowered_parts.push(MirBinaryPatternPart.Bits{width: U8{width}, ty: jet_codegen_pattern_mir_type_id(builder, ty), little: !big_endian, span: part_span})
            .Rest(_, ty, part_span) -> &lowered_parts.push(MirBinaryPatternPart.Rest{ty: jet_codegen_pattern_mir_type_id(builder, ty), span: part_span})
        }
    }
    matched := jet_codegen_emit_value(&builder, span, jet_codegen_pattern_tuple_result_type(pattern), MirOperation.Semantic{operation: MirSemanticOp.BinaryPatternMatch{call: jet_codegen_pattern_match_route(&builder, true), subject: subject, parts: lowered_parts}})
    JetCodegenPatternTest{value: jet_codegen_emit_value(&builder, span, Type.Bool, MirOperation.PatternMatched{matched: matched}), matched: Val(matched)}
}

fn jet_codegen_lower_pattern_shape_test(builder: &JetCodegenBuilder, pattern: TPattern, subject: TExpr, subject_value: MirValueId, shape: TPatternShape) -> JetCodegenPatternTest {
    if shape == {
        .Variant(variant, bindings, _, span) -> {
            subject_type := jet_codegen_unwrap_pattern_tags(subject.ty)
            if subject_type == {
                .Result(ok_ty, err_ty) -> {
                    if variant == "Ok" || variant == "Err" {
                        is_ok := jet_codegen_emit_value(&builder, span, Type.Bool, MirOperation.ResultIsOk{subject: subject_value})
                        is_selected := if variant == "Ok" -> is_ok else -> jet_codegen_emit_value(&builder, span, Type.Bool, MirOperation.Unary{op: MirUnaryOp.Not, value: is_ok})
                        loop binding in bindings {
                            if binding == {
                                .Range(lo, hi) -> {
                                    payload_ty := if variant == "Ok" -> ok_ty else -> err_ty
                                    operation := MirOperation.ResultValue{subject: subject_value, ok: variant == "Ok"}
                                    is_selected = jet_codegen_lower_guarded_pattern_range(&builder, is_selected, payload_ty, lo, hi, span, "result-pattern-range", operation)
                                }
                                else -> {}
                            }
                        }
                        return JetCodegenPatternTest{value: is_selected, matched: None}
                    }
                }
                else -> {}
            }
            owner :: pattern.enum_type ?? panic("checked variant pattern has no canonical owner")
            owner_id := jet_codegen_mir_type_id_for_symbol(builder.modules, owner)
            is_variant := jet_codegen_emit_value(&builder, span, Type.Bool, MirOperation.EnumIs{subject: subject_value, owner: owner_id, variant: variant})
            index := 0
            loop binding in bindings {
                if binding == {
                    .Range(lo, hi) -> {
                        payload_ty := jet_codegen_pattern_variant_payload_type(builder, subject.ty, owner, variant, index)
                        operation := MirOperation.EnumPayload{subject: subject_value, owner: owner_id, variant: variant, index: index}
                        is_variant = jet_codegen_lower_guarded_pattern_range(&builder, is_variant, payload_ty, lo, hi, span, "enum-pattern-range", operation)
                    }
                    .Nested(nested) -> {
                        payload_ty := jet_codegen_pattern_variant_payload_type(builder, subject.ty, owner, variant, index)
                        operation := MirOperation.EnumPayload{subject: subject_value, owner: owner_id, variant: variant, index: index}
                        is_variant = jet_codegen_lower_guarded_nested_pattern(&builder, pattern, is_variant, payload_ty, nested, span, "enum-pattern-nested", operation)
                    }
                    else -> {}
                }
                index += 1
            }
            JetCodegenPatternTest{value: is_variant, matched: None}
        }
        .Present(_, _, inner, span) -> {
            is_some := jet_codegen_emit_value(&builder, span, Type.Bool, MirOperation.OptionIsSome{subject: subject_value})
            if inner == .Val(nested) -> return JetCodegenPatternTest{value: jet_codegen_lower_guarded_nested_pattern(&builder, pattern, is_some, jet_codegen_carrier_payload_type(subject.ty, true), nested, span, "option-pattern-nested", MirOperation.OptionValue{subject: subject_value}), matched: None}
            JetCodegenPatternTest{value: is_some, matched: None}
        }
        .Absent(span) -> {
            is_some := jet_codegen_emit_value(&builder, span, Type.Bool, MirOperation.OptionIsSome{subject: subject_value})
            JetCodegenPatternTest{value: jet_codegen_emit_value(&builder, span, Type.Bool, MirOperation.Unary{op: MirUnaryOp.Not, value: is_some}), matched: None}
        }
        .Ok(_, _, inner, span) | .Err(_, _, inner, span) -> {
            ok :: if shape == {.Ok(_, _, _, _) -> true else -> false}
            is_ok := jet_codegen_emit_value(&builder, span, Type.Bool, MirOperation.ResultIsOk{subject: subject_value})
            is_selected := if ok -> is_ok else -> jet_codegen_emit_value(&builder, span, Type.Bool, MirOperation.Unary{op: MirUnaryOp.Not, value: is_ok})
            if inner == .Val(nested) -> return JetCodegenPatternTest{value: jet_codegen_lower_guarded_nested_pattern(&builder, pattern, is_selected, jet_codegen_carrier_payload_type(subject.ty, ok), nested, span, "result-pattern-nested", MirOperation.ResultValue{subject: subject_value, ok: ok}), matched: None}
            JetCodegenPatternTest{value: is_selected, matched: None}
        }
        .Range(lo, hi, span) -> JetCodegenPatternTest{value: jet_codegen_lower_numeric_pattern_range(&builder, subject_value, subject.ty, lo, hi, span), matched: None}
        .Or(_, _) -> panic("or-pattern tests must use the ordered alternative lowerer")
        .Struct(fields, _, span) -> {
            tests := [MirValueId]{}
            loop field in fields {
                if field == {
                    .Bind(_, _, _) -> {}
                    .Value(name, value, field_span) -> {
                        field_id := jet_codegen_pattern_field_id(builder, subject.ty, name)
                        projected := jet_codegen_emit_value(&builder, field_span, value.ty, MirOperation.Field{base: subject_value, field: field_id})
                        expected := jet_codegen_lower_expr(&builder, value)
                        dispatch := jet_codegen_binary_dispatch(&builder, TBinaryOp.Eq, false, value.ty, field_span, 0)
                        &tests.push(jet_codegen_emit_value(&builder, field_span, Type.Bool, MirOperation.Binary{op: jet_codegen_lower_binary(TBinaryOp.Eq), dispatch: dispatch, overflow: MirBinaryOverflow.Unchecked, left: projected, right: expected}))
                    }
                }
            }
            result := jet_codegen_emit_value(&builder, span, Type.Bool, MirOperation.Constant{value: MirConstant.Bool{value: true}})
            loop test in tests -> result = jet_codegen_emit_value(&builder, span, Type.Bool, MirOperation.Binary{op: MirBinaryOp.And, dispatch: MirBinaryDispatch.Primitive, overflow: MirBinaryOverflow.Unchecked, left: result, right: test})
            JetCodegenPatternTest{value: result, matched: None}
        }
        .Text(parts, span) -> jet_codegen_lower_text_pattern_test(&builder, pattern, subject_value, parts, span)
        .Binary(parts, span) -> jet_codegen_lower_binary_pattern_test(&builder, pattern, subject_value, parts, span)
    }
}

fn jet_codegen_pattern_group_leaves(builder: JetCodegenBuilder, owner: SymbolId, group: String) -> [String]? {
    loop semantic_module in builder.modules {
        loop nominal in semantic_module.nominals {
            if nominal.symbol.id.key != owner.key -> next
            leaves := [String]{}
            prefix := "{group}."
            loop variant in nominal.variants {
                if variant.symbol.name.starts_with(prefix) -> &leaves.push(variant.symbol.name)
            }
            if leaves.len() > 0 -> return Val(leaves)
            return None
        }
    }
    None
}

fn jet_codegen_bind_pattern_shape(builder: &JetCodegenBuilder, pattern: TPattern, subject: TExpr, subject_value: MirValueId, shape: TPatternShape, matched: MirValueId?, reuse: Bool) {
    if shape == {
        .Variant(variant, bindings, _, span) -> {
            subject_type := jet_codegen_unwrap_pattern_tags(subject.ty)
            if subject_type == {
                .Result(_, _) -> {
                    if variant == "Ok" || variant == "Err" {
                        ok := variant == "Ok"
                        loop binding in bindings {
                            if binding == {
                                .Bind(name, _) -> {
                                    if name == "" || name == "_" -> next
                                    fact := jet_codegen_pattern_binding_fact(pattern, name)
                                    payload := jet_codegen_emit_value(&builder, fact.span, fact.ty, MirOperation.ResultValue{subject: subject_value, ok: ok})
                                    jet_codegen_write_pattern_binding(&builder, fact, payload, reuse)
                                }
                                else -> {}
                            }
                        }
                        return
                    }
                }
                else -> {}
            }
            owner :: pattern.enum_type ?? panic("checked variant binding has no canonical owner")
            owner_id := jet_codegen_mir_type_id_for_symbol(builder.modules, owner)
            index := 0
            loop binding in bindings {
                if binding == {
                    .Bind(name, _) -> {
                        if name != "" && name != "_" {
                            fact := jet_codegen_pattern_binding_fact(pattern, name)
                            payload := jet_codegen_emit_value(&builder, fact.span, fact.ty, MirOperation.EnumPayload{subject: subject_value, owner: owner_id, variant: variant, index: index})
                            jet_codegen_write_pattern_binding(&builder, fact, payload, reuse)
                        }
                    }
                    .Nested(nested) -> {
                        payload_ty := jet_codegen_pattern_variant_payload_type(builder, subject.ty, owner, variant, index)
                        jet_codegen_bind_nested_pattern(&builder, pattern, payload_ty, nested, span, MirOperation.EnumPayload{subject: subject_value, owner: owner_id, variant: variant, index: index}, reuse)
                    }
                    else -> {}
                }
                index += 1
            }
        }
        .Present(name, binding_span, inner, span) -> {
            if inner == .Val(nested) {
                jet_codegen_bind_nested_pattern(&builder, pattern, jet_codegen_carrier_payload_type(subject.ty, true), nested, span, MirOperation.OptionValue{subject: subject_value}, reuse)
            } else if name != "" && name != "_" {
                fact := jet_codegen_pattern_binding_fact(pattern, name)
                payload := jet_codegen_emit_value(&builder, binding_span, fact.ty, MirOperation.OptionValue{subject: subject_value})
                jet_codegen_write_pattern_binding(&builder, fact, payload, reuse)
            }
        }
        .Absent(_) | .Range(_, _, _) -> {}
        .Ok(name, binding_span, inner, span) | .Err(name, binding_span, inner, span) -> {
            ok := if shape == {.Ok(_, _, _, _) -> true else -> false}
            if inner == .Val(nested) {
                jet_codegen_bind_nested_pattern(&builder, pattern, jet_codegen_carrier_payload_type(subject.ty, ok), nested, span, MirOperation.ResultValue{subject: subject_value, ok: ok}, reuse)
            } else if name != "" && name != "_" {
                fact := jet_codegen_pattern_binding_fact(pattern, name)
                payload := jet_codegen_emit_value(&builder, binding_span, fact.ty, MirOperation.ResultValue{subject: subject_value, ok: ok})
                jet_codegen_write_pattern_binding(&builder, fact, payload, reuse)
            }
        }
        .Or(_, _) -> panic("or-pattern bindings must use the ordered alternative lowerer")
        .Struct(fields, _, _) -> {
            loop field in fields {
                if field == {
                    .Bind(field_name, name, _) -> {
                        if name != "" && name != "_" {
                            fact := jet_codegen_pattern_binding_fact(pattern, name)
                            field_id := jet_codegen_pattern_field_id(builder, subject.ty, field_name)
                            value := jet_codegen_emit_value(&builder, fact.span, fact.ty, MirOperation.Field{base: subject_value, field: field_id})
                            jet_codegen_write_pattern_binding(&builder, fact, value, reuse)
                        }
                    }
                    .Value(_, _, _) -> {}
                }
            }
        }
        .Text(parts, span) -> {
            matched_value :: matched ?? panic("checked text pattern lost its MIR capture carrier")
            index := 0
            loop part in parts {
                if part == {
                    .Hole(name, _, hole_span) -> {
                        if name != "" && name != "_" {
                            fact := jet_codegen_pattern_binding_fact(pattern, name)
                            value := jet_codegen_emit_value(&builder, hole_span, fact.ty, MirOperation.PatternCapture{matched: matched_value, index: index})
                            jet_codegen_write_pattern_binding(&builder, fact, value, reuse)
                        }
                        index += 1
                    }
                    .Literal(_) -> {}
                }
            }
        }
        .Binary(parts, span) -> {
            matched_value :: matched ?? panic("checked binary pattern lost its MIR capture carrier")
            index := 0
            loop part in parts {
                if part == {
                    .Bits(name, _, _, _, part_span) | .Rest(name, _, part_span) -> {
                        if name != "" && name != "_" {
                            fact := jet_codegen_pattern_binding_fact(pattern, name)
                            value := jet_codegen_emit_value(&builder, part_span, fact.ty, MirOperation.PatternCapture{matched: matched_value, index: index})
                            jet_codegen_write_pattern_binding(&builder, fact, value, reuse)
                        }
                        index += 1
                    }
                    .Literal(_) -> {}
                }
            }
        }
    }
}

fn jet_codegen_lower_pattern_or(builder: &JetCodegenBuilder, pattern: TPattern, subject: TExpr, subject_value: MirValueId, alternatives: [TPatternShape], span: Span, bind_success: Bool, reuse_bindings: Bool) -> MirValueId {
    if alternatives.len() == 0 -> panic("checked or-pattern has no alternatives")
    join_block := jet_codegen_new_block(&builder, span, "pattern-or-join")
    incoming := [MirPhiIncoming]{}
    index := 0
    loop index < alternatives.len() {
        test := jet_codegen_lower_pattern_shape_condition(&builder, pattern, subject, subject_value, alternatives[index], bind_success, reuse_bindings || index > 0)
        matched_block := jet_codegen_new_block(&builder, span, "pattern-or-matched")
        next_block := jet_codegen_new_block(&builder, span, "pattern-or-next")
        jet_codegen_terminate(&builder, MirTerminator.Branch{condition: test, then_target: matched_block, else_target: next_block})
        jet_codegen_switch_block(&builder, matched_block)
        true_value := jet_codegen_emit_value(&builder, span, Type.Bool, MirOperation.Constant{value: MirConstant.Bool{value: true}})
        matched_predecessor := builder.current
        jet_codegen_terminate(&builder, MirTerminator.Jump{target: join_block})
        &incoming.push(MirPhiIncoming{block: matched_predecessor, value: true_value})
        jet_codegen_switch_block(&builder, next_block)
        index += 1
    }
    false_value := jet_codegen_emit_value(&builder, span, Type.Bool, MirOperation.Constant{value: MirConstant.Bool{value: false}})
    missed_predecessor := builder.current
    jet_codegen_terminate(&builder, MirTerminator.Jump{target: join_block})
    &incoming.push(MirPhiIncoming{block: missed_predecessor, value: false_value})
    jet_codegen_switch_block(&builder, join_block)
    jet_codegen_emit_value(&builder, span, Type.Bool, MirOperation.Phi{incoming: incoming})
}

fn jet_codegen_lower_pattern_shape_condition(builder: &JetCodegenBuilder, pattern: TPattern, subject: TExpr, subject_value: MirValueId, shape: TPatternShape, bind_success: Bool, reuse_bindings: Bool) -> MirValueId {
    if shape == {
        .Or(alternatives, span) -> return jet_codegen_lower_pattern_or(&builder, pattern, subject, subject_value, alternatives, span, bind_success, reuse_bindings)
        .Variant(variant, bindings, leading_dot, span) -> {
            if pattern.enum_type != None {
                owner :: pattern.enum_type ?? panic("checked variant group has no canonical owner")
                leaves := jet_codegen_pattern_group_leaves(builder, owner, variant)
                if leaves != None {
                    alternative_shapes := [TPatternShape]{}
                    loop leaf in (leaves ?? [String]{}) -> &alternative_shapes.push(TPatternShape.Variant{variant: leaf, bindings: bindings, leading_dot: leading_dot, span: span})
                    return jet_codegen_lower_pattern_or(&builder, pattern, subject, subject_value, alternative_shapes, span, bind_success, reuse_bindings)
                }
            }
        }
        else -> {}
    }
    binding_depth := builder.scope_depth
    if reuse_bindings && builder.scope_depth > 0 -> builder.scope_depth -= 1
    test := jet_codegen_lower_pattern_shape_test(&builder, pattern, subject, subject_value, shape)
    builder.scope_depth = binding_depth
    if !bind_success -> return test.value
    matched_block := jet_codegen_new_block(&builder, subject.span, "pattern-condition-matched")
    missed_block := jet_codegen_new_block(&builder, subject.span, "pattern-condition-missed")
    join_block := jet_codegen_new_block(&builder, subject.span, "pattern-condition-join")
    jet_codegen_terminate(&builder, MirTerminator.Branch{condition: test.value, then_target: matched_block, else_target: missed_block})
    jet_codegen_switch_block(&builder, matched_block)
    jet_codegen_bind_pattern_shape(&builder, pattern, subject, subject_value, shape, test.matched, reuse_bindings)
    true_value := jet_codegen_emit_value(&builder, subject.span, Type.Bool, MirOperation.Constant{value: MirConstant.Bool{value: true}})
    matched_predecessor := builder.current
    jet_codegen_terminate(&builder, MirTerminator.Jump{target: join_block})
    jet_codegen_switch_block(&builder, missed_block)
    false_value := jet_codegen_emit_value(&builder, subject.span, Type.Bool, MirOperation.Constant{value: MirConstant.Bool{value: false}})
    missed_predecessor := builder.current
    jet_codegen_terminate(&builder, MirTerminator.Jump{target: join_block})
    jet_codegen_switch_block(&builder, join_block)
    incoming := [MirPhiIncoming]{
        MirPhiIncoming{block: matched_predecessor, value: true_value},
        MirPhiIncoming{block: missed_predecessor, value: false_value},
    }
    jet_codegen_emit_value(&builder, subject.span, Type.Bool, MirOperation.Phi{incoming: incoming})
}

fn jet_codegen_lower_pattern_condition(builder: &JetCodegenBuilder, pattern: TPattern, subject: TExpr, subject_value: MirValueId, bind_success: Bool) -> MirValueId {
    jet_codegen_lower_pattern_shape_condition(&builder, pattern, subject, subject_value, pattern.shape, bind_success, false)
}

fn jet_codegen_task_result_type(ty: Type) -> Bool Never! {
    if jet_codegen_unwrap_pattern_tags(ty) == {
        .Apply(name, args) -> {
            if name != "Task" || args.len() != 1 -> return false
            if jet_codegen_unwrap_pattern_tags(args[0]) == {.Result(_, _) -> true else -> false}
        }
        else -> false
    }
}

fn jet_codegen_task_group_result_tasks(ty: Type) -> Bool Never! {
    if jet_codegen_unwrap_pattern_tags(ty) == {
        .List(inner) | .FixedList(inner, _) -> jet_codegen_task_result_type(inner)
        .Tuple(fields) -> {
            loop field in fields {
                if !jet_codegen_task_result_type(field.ty) -> return false
            }
            true
        }
        else -> false
    }
}

fn jet_codegen_lower_consuming_task_value(builder: &JetCodegenBuilder, value: TExpr) -> MirValueId {
    if jet_codegen_lower_expression_place(&builder, value, MirAccess.Move) == .Val(place) {
        return jet_codegen_emit_value(&builder, value.span, value.ty, MirOperation.MovePlace{place: place})
    }
    jet_codegen_lower_expr(&builder, value)
}

fn jet_codegen_lower_task_group_value(builder: &JetCodegenBuilder, expression: TExpr, tasks: TExpr, kind: MirTaskGroupKind) -> MirValueId {
    member := if kind == {
        .All -> "all"
        .Race -> "race"
        .Any -> "any"
    }
    if jet_codegen_task_group_result_tasks(tasks.ty) -> member = "{member}_result"
    call := jet_codegen_intern_route(&builder, MirPreludeFamily.StaticPrelude, "core.tasks", member, "jet_std::jet_task_{member}", 1, [Bool]{false}, None, jet_codegen_failure_carrier_for_type(expression.ty), MirPreludeAbi.Value)
    value := jet_codegen_lower_consuming_task_value(&builder, tasks)
    jet_codegen_emit_value(&builder, expression.span, expression.ty, MirOperation.Semantic{operation: MirSemanticOp.TaskGroup{call: call, kind: kind, tasks: [MirValueId]{value}}})
}

fn jet_codegen_lower_select_builder(builder: &JetCodegenBuilder, table: TExpr, receivers: &[MirValueId], timers: &[MirValueId]) {
    if table.kind == {
        .SelectStart -> {}
        .SelectRecv(previous, channel) -> {
            &receivers.push(jet_codegen_lower_expr(&builder, channel))
            jet_codegen_lower_select_builder(&builder, previous, &receivers, &timers)
        }
        .SelectAfter(previous, duration, value) -> {
            if value != None -> panic("readiness timer arm unexpectedly carries a value")
            nanoseconds := TExpr{ty: Type.Int, kind: TExprKind.HandleMethod{receiver: duration, operation: THandleOp.DurationNsValue, args: [TExpr]{}}, span: table.span, integer_bounds: None, cost: None}
            &timers.push(jet_codegen_lower_expr(&builder, nanoseconds))
            jet_codegen_lower_select_builder(&builder, previous, &receivers, &timers)
        }
        else -> panic("select wait has a non-canonical readiness-table builder")
    }
}

fn jet_codegen_select_payload_type(ty: Type) -> Type Never! {
    if jet_codegen_unwrap_pattern_tags(ty) == {
        .Result(ok, _) | .Option(ok) -> jet_codegen_select_payload_type(ok)
        .Apply(name, args) -> if name == "Task" && args.len() == 1 -> args[0] else -> ty
        else -> ty
    }
}

fn jet_codegen_lower_select_wait(builder: &JetCodegenBuilder, expression: TExpr, table: TExpr, nonblocking: Bool) -> MirValueId {
    receivers := [MirValueId]{}
    timers := [MirValueId]{}
    jet_codegen_lower_select_builder(&builder, table, &receivers, &timers)
    payload := jet_codegen_select_payload_type(expression.ty)
    receiver_type := Type.Apply{name: "Receiver", args: [Type]{payload}}
    receiver_list := jet_codegen_emit_value(&builder, expression.span, Type.List{element: receiver_type}, MirOperation.BuildList{values: receivers, trait_coercion: None})
    timer_list := jet_codegen_emit_value(&builder, expression.span, Type.List{element: Type.Int}, MirOperation.BuildList{values: timers, trait_coercion: None})
    member := if nonblocking -> "select_try_wait_tagged" else -> "select_wait_tagged"
    call := jet_codegen_intern_route(&builder, MirPreludeFamily.StaticPrelude, "core.tasks", member, "jet_std::jet_{member}", 2, [Bool]{true, false}, None, jet_codegen_failure_carrier_for_type(expression.ty), MirPreludeAbi.Value)
    jet_codegen_emit_value(&builder, expression.span, expression.ty, MirOperation.Semantic{operation: MirSemanticOp.Select{call: call, kind: MirSelectKind.Wait, values: [MirValueId]{receiver_list, timer_list}}})
}

fn jet_codegen_lower_math_swizzle_read(builder: &JetCodegenBuilder, expression: TExpr, type_name: String, receiver: TExpr, lanes: [Int]) -> MirValueId {
    if lanes.len() == 0 -> panic("checked swizzle has no lanes")
    base := jet_codegen_lower_expr(&builder, receiver)
    scalar := jet_codegen_math_scalar_type(type_name)
    source := jet_codegen_source_location_at(&builder, expression.span, true)
    location := MirPanicLoc{file: mir_source_file_id(builder.function.source_file), line: source.line, column: 0}
    context := MirPanicContext{function: builder.function.name, source_line: source.source_line ?? "", caret: 0, locals: [MirPanicLocal]{}}
    values := [MirValueId]{}
    loop lane in lanes {
        index := jet_codegen_emit_value(&builder, expression.span, Type.Int, MirOperation.Constant{value: MirConstant.Int{value: lane, width: None, spelling: None}})
        call := jet_codegen_lane_index_route(&builder, type_name, scalar, jet_codegen_failure_carrier_for_type(scalar))
        &values.push(jet_codegen_emit_value(&builder, expression.span, scalar, MirOperation.Index{call: call, base: base, index: index, kind: MirIndexKind.Lane, access: MirAccess.Read, location: location, context: context}))
    }
    if values.len() == 1 -> return values[0]
    result_name := if jet_codegen_unwrap_pattern_tags(expression.ty) == {
        .Named(name) -> name
        else -> panic("checked multi-lane swizzle has no vector result type")
    }
    jet_codegen_emit_math_builtin(&builder, expression, result_name, "new", values)
}

fn jet_codegen_lower_layout_compare(builder: &JetCodegenBuilder, expression: TExpr, op: TBinaryOp, lhs: TExpr, rhs: TExpr) -> MirValueId {
    operation := if op == {
        .Eq -> MirLayoutCompareOp.Equal
        .Le -> MirLayoutCompareOp.LessEqual
        .Ge -> MirLayoutCompareOp.GreaterEqual
        else -> panic("checked layout comparison has an invalid operator")
    }
    member := if operation == {
        .Equal -> "eq"
        .LessEqual -> "le"
        .GreaterEqual -> "ge"
    }
    symbol := if operation == {
        .Equal -> "jet_layout::eq_"
        .LessEqual -> "jet_layout::le"
        .GreaterEqual -> "jet_layout::ge"
    }
    left := jet_codegen_lower_expr(&builder, lhs)
    right := jet_codegen_lower_expr(&builder, rhs)
    call := jet_codegen_intern_route(&builder, MirPreludeFamily.StaticPrelude, "core.layout", member, symbol, 2, [Bool]{false, false}, None, jet_codegen_failure_carrier_for_type(expression.ty), MirPreludeAbi.Value)
    jet_codegen_emit_value(&builder, expression.span, expression.ty, MirOperation.Semantic{operation: MirSemanticOp.LayoutCompare{call: call, op: operation, left: left, right: right}})
}

fn jet_codegen_lower_columnar_gather(builder: &JetCodegenBuilder, expression: TExpr, base: TExpr, index: TExpr, line: Int) -> MirValueId {
    call := jet_codegen_index_route(&builder, MirIndexKind.List, MirAccess.Read, jet_codegen_failure_carrier_for_type(expression.ty))
    source := jet_codegen_source_location_at(&builder, expression.span, true)
    location := MirPanicLoc{file: mir_source_file_id(builder.function.source_file), line: line, column: 0}
    value := jet_codegen_lower_expr(&builder, base)
    position := jet_codegen_lower_expr(&builder, index)
    context := MirPanicContext{function: builder.function.name, source_line: source.source_line ?? "", caret: 0, locals: [MirPanicLocal]{}}
    jet_codegen_emit_value(&builder, expression.span, expression.ty, MirOperation.Index{call: call, base: value, index: position, kind: MirIndexKind.List, access: MirAccess.Read, location: location, context: context})
}

fn jet_codegen_lower_columnar_read(builder: &JetCodegenBuilder, expression: TExpr, base: TExpr, index: TExpr, owner: String, field: String, column: Int) -> MirValueId {
    field_id := jet_codegen_host_field_id(builder, Type.Named{name: owner}, field)
    call := jet_codegen_intern_route(&builder, MirPreludeFamily.ColumnarAccess, "core.columnar", "{owner}::{field}#{column}", "jet_columns_gather_cell", 3, [Bool]{true, false, false}, None, jet_codegen_failure_carrier_for_type(expression.ty), MirPreludeAbi.Value)
    value := jet_codegen_lower_expr(&builder, base)
    position := jet_codegen_lower_expr(&builder, index)
    jet_codegen_emit_value(&builder, expression.span, expression.ty, MirOperation.Semantic{operation: MirSemanticOp.ColumnarRead{base: call, index: value, column: position, column_index: field_id, accessor: column}})
}

fn jet_codegen_index_hook_get_call(builder: &JetCodegenBuilder, expression: TExpr, base: TExpr, index: TExpr, checked_call: SymbolId?) -> MirValueId {
    target := jet_codegen_index_hook_function(builder, base.ty, "Index", "get")
    method_symbol := None
    trait_symbol := None
    if target == {
        .Val(function) -> {
            method_symbol = Val(SymbolId{key: function.key})
            if function.kind == {
                .TraitMethod(_, _, _, symbol, _) -> trait_symbol = Val(symbol)
                .Method(_, _) -> {}
                else -> panic("checked Index::get target is not an instance method")
            }
        }
        else -> {
            resolved := jet_codegen_index_hook_trait_method(builder, base.ty, None, "Index", "get")
            method_symbol = Val(SymbolId{key: resolved.method.key})
            trait_symbol = Val(resolved.symbol)
        }
    }
    method := TMethodRef{symbol: method_symbol ?? panic("checked Index::get has no method identity"), name: "get", mangled: false, trait_owner: trait_symbol, operator_identity: None}
    if checked_call == .Val(required) && required.key != method.symbol.key -> panic("checked index call disagrees with its registered Index::get identity")
    argument := jet_codegen_transaction_call_arg(index)
    argument.borrow = !jet_codegen_is_scalar_type(index.ty)
    args := [TCallArg]{argument}
    call_expression := TExpr{ty: Type.Option{inner: expression.ty}, kind: TExprKind.MethodCall{receiver: base, method: method, type_args: [Type]{}, args: args}, span: expression.span, integer_bounds: None, cost: None}
    jet_codegen_lower_method_call(&builder, call_expression, base, method, [Type]{}, args)
}

fn jet_codegen_lower_index_hook_failure(builder: &JetCodegenBuilder, span: Span, line: Int) Never! {
    never := Type.Named{name: "Never"}
    call := jet_codegen_intern_route(&builder, MirPreludeFamily.StaticPrelude, "core.index", "index_miss", "jet_panic", 3, [Bool]{true, false, true}, Val(Effect.Panic), TFailureCarrier.Diverges{value: never}, MirPreludeAbi.Control)
    file := jet_codegen_emit_value(&builder, span, Type.String, MirOperation.Constant{value: MirConstant.String{value: builder.function.source_file}})
    line_value := jet_codegen_emit_value(&builder, span, Type.IntN{signed: false, bits: 32}, MirOperation.Constant{value: MirConstant.Int{value: line, width: Val(MirIntegerWidth{signed: false, bits: 32}), spelling: None}})
    message := jet_codegen_emit_value(&builder, span, Type.String, MirOperation.Constant{value: MirConstant.String{value: "index miss"}})
    values := [MirValueId]{file, line_value, message}
    args := [MirCallArg]{}
    source_index := 0
    loop value in values {
        argument := jet_codegen_host_call_value_arg(value, span, MirAccess.Read, None)
        argument.source_index = Val(source_index)
        &args.push(argument)
        source_index += 1
    }
    jet_codegen_emit_explicit_stop_cleanups(&builder)
    _ := jet_codegen_emit_value(&builder, span, never, MirOperation.Call{callee: MirCallee.Prelude{call: call}, args: args, type_args: [MirType]{}})
    jet_codegen_terminate(&builder, MirTerminator.Unreachable{reason: "index miss"})
}

fn jet_codegen_lower_index_hook(builder: &JetCodegenBuilder, expression: TExpr, base: TExpr, index: TExpr, line: Int, checked_call: SymbolId?) -> MirValueId {
    call := jet_codegen_index_hook_get_call(&builder, expression, base, index, checked_call)
    success := jet_codegen_new_block(&builder, expression.span, "index-hook-success")
    failure := jet_codegen_new_block(&builder, expression.span, "index-hook-failure")
    join := jet_codegen_new_block(&builder, expression.span, "index-hook-join")
    condition := jet_codegen_emit_value(&builder, expression.span, Type.Bool, MirOperation.OptionIsSome{subject: call})
    jet_codegen_terminate(&builder, MirTerminator.Branch{condition: condition, then_target: success, else_target: failure})
    incoming := [MirPhiIncoming]{}
    jet_codegen_switch_block(&builder, success)
    value := jet_codegen_emit_value(&builder, expression.span, expression.ty, MirOperation.OptionValue{subject: call})
    source := builder.current
    if jet_codegen_current_is_open(builder) {
        jet_codegen_terminate(&builder, MirTerminator.Jump{target: join})
        &incoming.push(MirPhiIncoming{block: source, value: value})
    }
    jet_codegen_switch_block(&builder, failure)
    jet_codegen_lower_index_hook_failure(&builder, expression.span, line)
    if incoming.len() == 0 -> panic("checked Index::get has no reachable success branch")
    jet_codegen_switch_block(&builder, join)
    jet_codegen_emit_value(&builder, expression.span, expression.ty, MirOperation.Phi{incoming: incoming})
}

fn jet_codegen_lower_layout_field_index(builder: &JetCodegenBuilder, expression: TExpr, base: TExpr, field_name: String, line: Int) -> MirValueId {
    field_type := Type.Named{name: "LayoutField"}
    fields := TExpr{ty: Type.List{element: field_type}, kind: TExprKind.Field{receiver: base, field: "fields"}, span: expression.span, integer_bounds: None, cost: None}
    owner_key := "{builder.function.key}::layout-field-select@{expression.span.start}..{expression.span.end}"
    parameter_symbol := symbol_id(SymbolKind.Parameter, builder.function.module_identity, owner_key, "layout_field")
    parameter := tir_symbol_local("layout_field", expression.span, parameter_symbol)
    parameter.deref = true
    parameter_value := TExpr{ty: field_type, kind: TExprKind.Local{local: parameter}, span: expression.span, integer_bounds: None, cost: None}
    name := TExpr{ty: Type.String, kind: TExprKind.Field{receiver: parameter_value, field: "name"}, span: expression.span, integer_bounds: None, cost: None}
    expected_name := TExpr{ty: Type.String, kind: TExprKind.StrLit{parts: [TStrPart]{TStrPart.Literal{text: field_name}}}, span: expression.span, integer_bounds: None, cost: None}
    predicate := TExpr{ty: Type.Bool, kind: TExprKind.Binary{op: TBinaryOp.Eq, overflow: false, line: line, lhs: name, rhs: expected_name}, span: expression.span, integer_bounds: None, cost: None}
    lambda := TLambda{
        executable: TLambdaBody.Expr{value: predicate},
        source_span: expression.span,
        frame_schedule: None,
        frame_schedule_derivation: None,
        capture_facts: TCaptureFacts{escapes: false, needs_fn_mut: false, mutable: [String]{}, cloned: [String]{}, frozen: [String]{}, materialized: [String]{}, moved: [String]{}},
        failure_carrier: TFailureCarrier.Infallible,
        effects: TEffectFacts{direct: [String]{}, solved: [String]{}, call_edges: [String]{}, maximal: false, direct_spans: [TEffectSpan]{}},
        host_param_conventions: None,
        source_params: [String]{parameter.name},
        source_param_symbols: [SymbolId]{parameter_symbol},
        jit_name: "",
        param_types: [Type]{field_type},
        ret: Val(Type.Bool),
        is_move: true,
        boxed: false,
        rc: false,
        arc: false,
        captures: [TCapture]{},
        materialized_captures: [String]{},
        frozen_captures: [String]{},
        uses_stack_sentry: false,
    }
    callback_type := Type.Fn{params: [Type]{field_type}, ret: Val(Type.Bool), effect_bound: None, param_contract: None, call_metadata: None, return_view_provenance: None}
    callback := TExpr{ty: callback_type, kind: TExprKind.Lambda{value: lambda}, span: expression.span, integer_bounds: None, cost: None}
    args := [TExpr]{callback}
    found := TExpr{ty: Type.Option{inner: field_type}, kind: TExprKind.ClosureMethod{receiver: fields, operation: TClosureOp.Find, args: args}, span: expression.span, integer_bounds: None, cost: None}
    value := jet_codegen_lower_closure_method(&builder, found, fields, TClosureOp.Find, args)
    jet_codegen_emit_value(&builder, expression.span, expression.ty, MirOperation.OptionValue{subject: value})
}

fn jet_codegen_lower_take_pattern(builder: &JetCodegenBuilder, expression: TExpr, receiver: TExpr, operation: THandleOp, args: [TExpr]) -> MirValueId {
    if args.len() != 0 -> panic("checked take_pattern still carries a runtime pattern argument")
    lowered_receiver := jet_codegen_lower_builtin_receiver(&builder, receiver, true)
    receiver_value := lowered_receiver.value
    receiver_place :: lowered_receiver.place ?? panic("checked take_pattern requires a writable receiver place")
    if operation == {
        .CursorTakePattern(parts, canonical) -> {
            lowered_parts := [MirTextPatternPart]{}
            capture_index := 0
            loop part in parts {
                if part == {
                    .Lit(text) -> &lowered_parts.push(MirTextPatternPart.Literal{value: text})
                    .Hole(_, _, span) -> {
                        if capture_index >= canonical.len() -> panic("checked text pattern has no canonical capture type")
                        ty := canonical[capture_index].ty
                        &lowered_parts.push(MirTextPatternPart.Hole{kind: jet_codegen_pattern_text_hole_kind(ty), ty: jet_codegen_pattern_mir_type_id(builder, ty), span: span})
                        capture_index += 1
                    }
                }
            }
            if capture_index != canonical.len() -> panic("checked text pattern has unused canonical capture types")
            return jet_codegen_emit_value(&builder, expression.span, expression.ty, MirOperation.Semantic{operation: MirSemanticOp.CursorTakePattern{receiver: receiver_value, receiver_place: receiver_place, parts: lowered_parts}})
        }
        .ReaderTakePattern(parts, canonical) -> {
            lowered_parts := [MirBinaryPatternPart]{}
            capture_index := 0
            loop part in parts {
                if part == {
                    .Lit(bytes) -> &lowered_parts.push(MirBinaryPatternPart.Literal{bytes: bytes})
                    .Hole(_, spec, span) -> {
                        if capture_index >= canonical.len() -> panic("checked binary pattern has no canonical capture type")
                        ty := jet_codegen_pattern_mir_type_id(builder, canonical[capture_index].ty)
                        if spec == {
                            .Bits(width, endian) -> &lowered_parts.push(MirBinaryPatternPart.Bits{width: U8{width}, ty: ty, little: endian == BinEndian.Little, span: span})
                            .Rest -> &lowered_parts.push(MirBinaryPatternPart.Rest{ty: ty, span: span})
                        }
                        capture_index += 1
                    }
                }
            }
            if capture_index != canonical.len() -> panic("checked binary pattern has unused canonical capture types")
            return jet_codegen_emit_value(&builder, expression.span, expression.ty, MirOperation.Semantic{operation: MirSemanticOp.ReaderTakePattern{receiver: receiver_value, receiver_place: receiver_place, parts: lowered_parts}})
        }
        else -> panic("checked handle operation is not a take_pattern operation")
    }
}
