// Collect canonical MIR type instances from the completed lowered rows.
use jet_foundation.[
    MIRConstantDef,
    MIRForeign,
    MIRFunction,
    MIRImplDef,
    MIRTraitDef,
    MIRTraitMethod,
    MIRType,
    MIRTypeDef,
    Type,
    mir_type_canonical_key,
    mir_type_display_name,
    mir_type_same_checked_type,
    mir_type_with_identity,
]

fn jet_codegen_type_definition_types(definition: MIRTypeDef) -> [MIRType] Never! {
    rows := [MIRType]{}
    if definition.kind == {
        .Struct(fields, _) -> loop field in fields -> &rows.push(field.ty)
        .Enum(variants, _) -> loop variant in variants {
            if variant.payload == {
                .Unit -> {}
                .Single(value) -> &rows.push(value)
                .Named(fields) -> loop field in fields -> &rows.push(field.ty)
            }
        }
        // copy: `base` is a payload of read parameter `definition`, which keeps the original; the pushed list `rows` owns this one
        .Distinct(base, _) -> &rows.push(base.copy())
        // copy: `target` is a payload of read parameter `definition`, which keeps the original; the pushed list `rows` owns this one
        .Alias(target) -> &rows.push(target.copy())
        .UnitFamily(_) -> {}
    }
    rows
}

// Merge every type a function row carries, in row order: parameters, the
// declared and lowered returns, the failure carrier, locals, values, places,
// Web reconstructions, captures, the generator item, then instruction
// results. The types are read in place; no per-function list of copies.
fn jet_codegen_merge_function_types(instances: &JetCodegenTypeInstances, function: MIRFunction) Never! {
    loop parameter in function.params -> jet_codegen_merge_type_instance(&instances, parameter.ty)
    if function.declared_return == .Val(declared) -> jet_codegen_merge_type_instance(&instances, declared)
    jet_codegen_merge_type_instance(&instances, function.return_type)
    if function.failure == {
        .Result(success, error) -> {
            jet_codegen_merge_type_instance(&instances, success)
            jet_codegen_merge_type_instance(&instances, error)
        }
        .Optional(value) | .Diverges(value) -> jet_codegen_merge_type_instance(&instances, value)
        .Infallible -> {}
    }
    loop local in function.locals -> jet_codegen_merge_type_instance(&instances, local.ty)
    loop value in function.values -> jet_codegen_merge_type_instance(&instances, value.ty)
    loop place in function.places -> jet_codegen_merge_type_instance(&instances, place.ty)
    loop reconstruction in function.web_param_reconstructions {
        jet_codegen_merge_type_instance(&instances, reconstruction.ty)
        loop field in reconstruction.fields -> jet_codegen_merge_type_instance(&instances, field.ty)
    }
    loop capture in function.capture_params -> jet_codegen_merge_type_instance(&instances, capture.ty)
    if function.generator == .Val(generator) -> jet_codegen_merge_type_instance(&instances, generator.item)
    loop block in function.blocks {
        loop instruction in block.instructions {
            if instruction.ty == .Val(ty) -> jet_codegen_merge_type_instance(&instances, ty)
        }
    }
}

fn jet_codegen_trait_method_type_rows(method: MIRTraitMethod) -> [MIRType] Never! {
    rows := [MIRType]{}
    loop parameter in method.params -> &rows.push(parameter.ty)
    if method.declared_return != None -> &rows.push(method.declared_return ?? method.return_type)
    &rows.push(method.return_type)
    if method.failure == {
        .Result(success, error) -> {
            &rows.push(success)
            &rows.push(error)
        }
        .Optional(value) | .Diverges(value) -> &rows.push(value)
        .Infallible -> {}
    }
    rows
}

// Canonical type instances in insertion order, with the row position of each
// identity value so a merge never rescans the rows (mir.rs TypeInstances).
struct JetCodegenTypeInstances {
    rows: [MIRType]
    positions: [U64:Int]
}

fn jet_codegen_push_type_instance(instances: &JetCodegenTypeInstances, identity: U64, instance: MIRType) Never! {
    _ := &instances.positions.add(identity, instances.rows.len())
    &instances.rows.push(instance)
}

fn jet_codegen_ensure_type_instance(instances: &JetCodegenTypeInstances, instance: MIRType) Never! {
    identity :: instance.identity ?? return
    if instances.positions.get(identity.value) != None -> return
    jet_codegen_push_type_instance(&instances, identity.value, instance)
}

fn jet_codegen_merge_nested_type_instances(instances: &JetCodegenTypeInstances, ty: MIRType) Never! {
    if ty.kind == {
        .List(inner) | .Shared(inner) | .Option(inner) | .FixedList(inner, _) | .InlineRange(inner, _, _) | .Tagged(_, inner) -> jet_codegen_merge_type_instance(&instances, inner)
        .Map(key, value) | .Result(key, value) -> {
            jet_codegen_merge_type_instance(&instances, key)
            jet_codegen_merge_type_instance(&instances, value)
        }
        .Fn(signature) -> {
            loop parameter in signature.params -> jet_codegen_merge_type_instance(&instances, parameter)
            if signature.ret != None -> jet_codegen_merge_type_instance(&instances, signature.ret ?? ty)
        }
        .SendFn(params, ret, _) -> {
            loop parameter in params -> jet_codegen_merge_type_instance(&instances, parameter)
            if ret != None -> jet_codegen_merge_type_instance(&instances, ret)
        }
        .Apply(_, args) -> loop argument in args -> jet_codegen_merge_type_instance(&instances, argument)
        .Tuple(fields) -> loop field in fields -> jet_codegen_merge_type_instance(&instances, field.ty)
        .Union(members) -> loop member in members -> jet_codegen_merge_type_instance(&instances, member)
        .Quantity(base, _) -> jet_codegen_merge_type_instance(&instances, base)
        .Int | .Float | .Bool | .String | .Char | .TraitObject(_) | .IntN(_, _) | .Float32 | .Measure(_) -> {}
    }
}

// MIRType equality is the checked-type identity (mir.rs `existing != &instance`
// uses MirType's PartialEq = same_checked_type), never a structural row compare:
// one identity may be reached through rows that differ only in spelling/layout.
fn jet_codegen_merge_type_instance(instances: &JetCodegenTypeInstances, instance: MIRType) Never! {
    identity :: instance.identity ?? panic("checked MIR type instance has no canonical identity")
    if instances.positions.get(identity.value) == .Val(position) {
        existing :: instances.rows[position]
        if !mir_type_same_checked_type(existing, instance) -> panic("conflicting canonical MIR type instance {identity.value} `{mir_type_display_name(instance)}`: existing `{mir_type_canonical_key(existing)}` vs incoming `{mir_type_canonical_key(instance)}`")
    } else {
        jet_codegen_push_type_instance(&instances, identity.value, instance)
    }
    jet_codegen_merge_nested_type_instances(&instances, instance)
}

// The rows in identity order (jet_codegen_sorted_order).
fn jet_codegen_sorted_type_instances(instances: JetCodegenTypeInstances) -> [MIRType] Never! {
    identities := [U64]{}
    loop instance in instances.rows {
        identity :: instance.identity ?? panic("checked MIR type instance has no canonical identity")
        &identities.push(identity.value)
    }
    sorted := [MIRType]{}
    loop position in jet_codegen_sorted_order(identities, [String]{}) -> &sorted.push(instances.rows[position])
    sorted
}

// Inputs are completed lowered rows; constants are the runtime-only rows.
// Pass top-level and nested functions separately, plus foreign rows, so their
// signatures participate even when they do not appear in an instruction result.
fn jet_codegen_collect_type_instances(types: [MIRTypeDef], functions: [MIRFunction], nested_functions: [MIRFunction], foreign: [MIRForeign], traits: [MIRTraitDef], impls: [MIRImplDef], constants: [MIRConstantDef]) -> [MIRType] Never! {
    instances := JetCodegenTypeInstances{rows: [MIRType]{}, positions: [U64:Int]{}}
    loop definition in types {
        declared := mir_type_with_identity(jet_codegen_lower_type(Type.Named{name: definition.key}), definition.id)
        jet_codegen_ensure_type_instance(&instances, declared)
    }
    loop definition in types {
        loop ty in jet_codegen_type_definition_types(definition) -> jet_codegen_merge_type_instance(&instances, ty)
    }
    loop function in functions -> jet_codegen_merge_function_types(&instances, function)
    loop function in nested_functions -> jet_codegen_merge_function_types(&instances, function)
    loop function in foreign {
        loop parameter in function.params -> jet_codegen_merge_type_instance(&instances, parameter.ty)
        if function.return_type != None {
            return_type :: function.return_type ?? panic("checked foreign return type disappeared during type-instance collection")
            jet_codegen_merge_type_instance(&instances, return_type)
        }
    }
    loop trait_def in traits {
        loop method in trait_def.methods {
            loop ty in jet_codegen_trait_method_type_rows(method) -> jet_codegen_merge_type_instance(&instances, ty)
        }
    }
    loop implementation in impls {
        jet_codegen_merge_type_instance(&instances, implementation.self_type)
        loop associated in implementation.associated_types -> jet_codegen_merge_type_instance(&instances, associated.ty)
        if implementation.operator_rhs != None {
            rhs :: implementation.operator_rhs ?? panic("checked implementation RHS type disappeared during type-instance collection")
            jet_codegen_merge_type_instance(&instances, rhs)
        }
    }
    loop constant in constants -> jet_codegen_merge_type_instance(&instances, constant.ty)
    // Every function, definition and trait-method type was merged above, and
    // a merge inserts each identity it meets, so a second (ensure) pass over
    // those rows could add nothing.
    loop definition in types {
        if instances.positions.get(definition.id.value) == None -> panic("missing canonical MIR type instance for `{definition.key}` ({definition.id.value})")
    }
    jet_codegen_sorted_type_instances(instances)
}
