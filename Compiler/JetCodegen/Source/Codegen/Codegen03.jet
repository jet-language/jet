//RS /// D-LAYOUT1 / D-LAYOUT-GATES1 (ratified 2026-06-28/29): the `layout NAME { … }`
//RS /// constraint-solver runtime (`jet_layout`). Pure safe Rust (no `unsafe`), so —
//RS /// unlike `MEM_PRELUDE` — it never needs stripping; included everywhere
//RS /// `MEM_PRELUDE`/private collector runtime are (not just the UI-specific sites), since a
//RS /// `layout {}` block isn't limited to UI code.
//RS const LAYOUT_PRELUDE: &str = include_str!("../Prelude/Layout.rs");
//RS 
//RS /// Tower #126: emitted AOT programs that use tasks/networking/process/fs-runtime ship AND select the
//RS /// native readiness backend (epoll on Linux, kqueue on the BSD/Apple family), not
//RS /// just the portable poll. Other Core users retain the safe portable scheduler
//RS /// compatibility surface without inheriting unrelated native FFI (I1).
//RS ///
//RS /// The prelude gates its native syscall paths behind `feature = "jet_native_io"`
//RS /// for the in-crate JIT copy (`jet_codegen::scheduler`, whose Cargo manifest turns
//RS /// that feature on by default). Emitted user programs are built by a bare `rustc`
//RS /// with no Cargo features, so that predicate would always be false and the program
//RS /// would silently fall back to portable poll. Rewrite the predicate to a
//RS /// vacuously-true `all()` at emit time: native then selects purely on `target_os`,
//RS /// so a Linux build compiles in and uses epoll.
//RS ///
//RS /// I1: the raw epoll/kqueue syscalls stay inside the `jet:scheduler-native`
//RS /// vetted region — the only `unsafe` in the emitted scheduler. `tests/golden.rs`
//RS /// ignores exactly that region in its I1 unsafe scan, matching the vetted-internal
//RS /// pattern used by `jet_os_unix`/`jet_term_unix`.
//RS fn strip_scheduler_region(mut source: String, name: &str) -> String {
//RS     let begin = format!("// jet:scheduler-native-{name}-begin");
//RS     let end = format!("// jet:scheduler-native-{name}-end");
//RS     let Some(start) = source.find(&begin) else {
//RS         return source;
//RS     };
//RS     let Some(relative_end) = source[start..].find(&end) else {
//RS         return source;
//RS     };
//RS     let end_offset = start + relative_end + end.len();
//RS     source.replace_range(start..end_offset, "");
//RS     source
//RS }
