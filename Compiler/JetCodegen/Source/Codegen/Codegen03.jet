// Rust: crates/jet-codegen/src/Codegen/mod.rs:4402
fn push_portable_prelude_imports(out: &String, include_atomic: Bool, include_hardware: Bool, include_alloc: Bool) -> {
    mut sources := [PORTABLE_CORE_PRELUDE_RAW, TARGET_ADAPTERS_PRELUDE_RAW]
    if include_atomic { sources.push(CORE_ATOMIC_PRELUDE_RAW) }
    if include_hardware { sources.push(portable_embedded_hardware_source()) }
    if include_alloc { sources.push(PORTABLE_ALLOC_PRELUDE_RAW) }
    out.push_str(merge_flat_prelude_imports(sources))
}
// Rust: crates/jet-codegen/src/Codegen/mod.rs:4423
struct FlatPreludeImport {
    path: String,
    name: String,
    binding: String,
    // Rust: crates/jet-codegen/src/Codegen/mod.rs:4433
    fn identity(self: &Self) -> (String, String) {
        path := self.path.strip_prefix("core::").or_else(|| self.path.strip_prefix("alloc::")).map_or_else(|| self.path, |rest| format("std::{}", rest))
        (path, self.name)
    }
}
// Rust: crates/jet-codegen/src/Codegen/mod.rs:4445
fn flat_prelude_import_bindings(source: &String) -> [FlatPreludeImport] {
    mut bindings: [FlatPreludeImport] = []
    for statement in split_leading_top_level_uses(source).0 {
        item := statement.trim_start_matches("use ").trim_end_matches(';').trim() // #4303
        (path, names) := match item.split_once("::{") {
            Some((path, names)) -> (path.trim(), names.trim_end_matches('}')),
            None -> item.rsplit_once("::").unwrap_or(("", item)),
        }
        for name in names.split(',') {
            name := name.trim() // #4303
            if name.is_empty() { continue }
            (name, binding) := match name.split_once(" as ") {
                Some((name, binding)) -> (name.trim(), binding.trim()),
                None -> (name, name),
            }
            bindings.push(FlatPreludeImport(path: path, name: name, binding: binding))
        }
    }
    bindings
}
// Rust: crates/jet-codegen/src/Codegen/mod.rs:4481
fn merge_flat_prelude_imports(sources: &[String]) -> String {
    mut bindings: [String:FlatPreludeImport] = [:]
    for source in sources {
        for import in flat_prelude_import_bindings(source) {
            if rest := import.path.strip_prefix("jet_foundation::") {
                module := rest.split("::").next().unwrap_or(rest)
                match foundation_placement(module) {
                    Some(FoundationPlacement.Root) if import.binding == import.name -> continue,
                    Some(_) -> {},
                    None -> panic(format("flat Prelude fragment imports `jet_foundation::{}`, which the generated program does not embed; add its placement to FOUNDATION_PLACEMENTS", module)),
                }
            }
            if kept := bindings.get(import.binding) {
                assert(kept.identity() == import.identity(), format("flat Prelude fragments bind `{}` to two items: `{}::{}` and `{}::{}`", import.binding, kept.path, kept.name, import.path, import.name))
            } else { bindings.insert(import.binding, ^import) }
        }
    }
    mut groups: [String:[String]] = [:]
    mut keys := bindings.keys().collect()
    keys.sort()
    for key in keys {
        import := bindings[key]
        spelling := if import.binding == import.name { import.name } else { format("{} as {}", import.name, import.binding) }
        groups.entry(import.path).or_insert([]).push(spelling)
    }
    mut rendered := String.new()
    mut paths := groups.keys().collect()
    paths.sort()
    for path in paths {
        names := groups[path]
        if names.len() == 1 { rendered.push_str(format("use {}::{};\n", path, names[0])) }
        else { rendered.push_str(format("use {}::{{{}}};\n", path, names.join(", "))) }
    }
    rendered.push('\n')
    rendered
}
