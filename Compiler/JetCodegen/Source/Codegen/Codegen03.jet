//RS     /// #1451: the `suite.run()` / `suite.result` handle ops are emitted
//RS     /// unqualified at crate root and are not gated on `used_core` — a
//RS     /// `fn test(suite: TestSuite)` body reaches them with no `core.testing`
//RS     /// call anywhere. Every root adapter those ops can name must therefore be
//RS     /// emitted beside the `Prelude/CommandSuite.rs` kernel part that defines
//RS     /// its callee, for any Core-reaching program. Re-gating them reintroduces
//RS     /// rustc E0425 on generated code (I2).
//RS     #[test]
//RS     fn command_suite_root_adapters_are_never_gated() {
//RS         // Deliberately a `used_core` set with no testing, args, process or
//RS         // files surface: that is what `--show-default` compiles for a file
//RS         // whose only suite contact is an unused `fn test(suite: TestSuite)`.
//RS         let no_testing = HashSet::from(["core.compute::zeros".to_string()]);
//RS         let mut out = String::new();
//RS         push_corelib_prelude_with_policy(
//RS             &mut out,
//RS             &no_testing,
//RS             false,
//RS             &ReleaseDevtoolsPolicy::development(),
//RS         );
//RS         // The whole root fragment, not a symbol list: the `jet_std` kernel
//RS         // defines same-named `pub fn`s, so a name check would pass even with
//RS         // the root adapters gated away.
//RS         assert!(
//RS             out.contains(include_str!("../Prelude/CoreLib/Top/CommandSuite.rs")),
//RS             "the crate-root suite adapters must ship with the kernel part that \
//RS              defines their callees; the handle-op call site names them with no \
//RS              `used_core` guard"
//RS         );
//RS     }
