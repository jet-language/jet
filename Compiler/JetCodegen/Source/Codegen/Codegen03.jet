// Rust: crates/jet-codegen/src/Codegen/mod.rs:4580
fn assemble_scheduler_prelude(scheduler: String) -> String {
    stream := flat_prelude_body(STREAM_PRELUDE_RAW)
    mut source := String.with_capacity(FLAT_PRELUDE_IMPORTS.len() + scheduler.len() + stream.len())
    source.push_str(FLAT_PRELUDE_IMPORTS.as_str())
    source.push_str(scheduler)
    source.push_str(stream)
    source
}
