// Rust: crates/jet-codegen/src/Codegen/mod.rs:4338
fn split_leading_top_level_uses(source: &String) -> ([String], String) {
    mut imports: [String] = []
    mut body := String.with_capacity(source.len())
    mut rest := source
    while !rest.is_empty() {
        line_end := rest.find('\n').map_or(rest.len(), |index| index + 1)
        line := rest[..line_end]
        trimmed := line.trim() // #4303
        if trimmed.is_empty() || trimmed.starts_with("//") || trimmed.starts_with('#') {
            body.push_str(line)
            rest = rest[line_end..]
            continue
        }
        if !line.starts_with("use ") { break }
        mut end := line_end
        while !rest[..end].contains(';') && end < rest.len() {
            end += rest[end..].find('\n').map_or(rest.len() - end, |index| index + 1)
        }
        item := rest[..end].trim() // #4303
        imports.push(item)
        rest = rest[end..]
    }
    body.push_str(rest)
    (imports, body)
}
