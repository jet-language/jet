//RS /// D-UIDEVSHELL1=A (c134 Phase 8): true when the native GTK4 backend prelude
//RS /// should be emitted — the program constructs `core.ui.gtk_backend()` AND the
//RS /// active target OS is Linux. `used_core` is collected before `@if
//RS /// $build.os` folds, so a Linux-only backend used under a `.Linux` arm still
//RS /// shows up on a macOS/Windows build; the `active_os` gate is what actually
//RS /// keeps the gtk `extern "C"` surface out of a non-Linux target (the backend is
//RS /// Linux-only). The `.Linux` dispatch arm's construction is likewise folded out
//RS /// of `main` on those targets, so nothing references it.
//RS fn uses_gtk_backend_for(
//RS     used_core: &std::collections::HashSet<String>,
//RS     active_os: Syntax::OSTarget,
//RS ) -> bool {
//RS     active_os == Syntax::OSTarget::Linux && used_core.iter().any(|u| u == "core.ui::gtk_backend")
//RS }
