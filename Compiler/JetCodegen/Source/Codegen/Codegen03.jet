// Rust: crates/jet-codegen/src/Codegen/mod.rs:4289
fn strip_scheduler_region(source: String, name: &String) -> String {
    mut source := ^source
    begin := format("// jet:scheduler-native-{}-begin", name)
    end := format("// jet:scheduler-native-{}-end", name)
    start := source.find(begin) else { return source }
    relative_end := source[start..].find(end) else { return source }
    end_offset := start + relative_end + end.len()
    source.replace_range(start..end_offset, "")
    source
}
