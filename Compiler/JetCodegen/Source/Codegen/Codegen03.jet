    if needs_reflect { out.push_str(include_str("../Prelude/CoreLib/Top/Reflect.rs")) }
    if needs_auth_tokens { out.push_str(include_str("../Prelude/CoreLib/Top/Auth.rs")) }
    if needs_auth_session { out.push_str(include_str("../Prelude/CoreLib/Top/AuthSession.rs")) }
    if needs_sync {
        out.push_str("\nmod jet_sync {\n")
        out.push_str(include_str("../Prelude/CoreLib/Top/Sync.rs").replace("include!(\"../SyncPublish.rs\");", include_str("../Prelude/CoreLib/SyncPublish.rs")))
        out.push_str("\n}\npub(crate) use jet_sync::*;\n")
    }
    if needs_services || needs_jobs {
        out.push_str(service_authority_prelude_for_emit())
        out.push_str(JOB_QUEUE_NATIVE_PRELUDE_RAW)
        out.push_str(include_str("../Prelude/CoreLib/Top/Services.rs"))
    }
}

