//RS     if include_alloc {
//RS         sources.push(PORTABLE_ALLOC_PRELUDE_RAW);
//RS     }
//RS     out.push_str(&merge_flat_prelude_imports(&sources));
//RS }
//RS 
//RS /// One binding a fragment's leading top-level `use` brings into the flat scope:
//RS /// `use path::{name as binding}`. `binding == name` without `as`.
//RS struct FlatPreludeImport<'a> {
//RS     path: &'a str,
//RS     name: &'a str,
//RS     binding: &'a str,
//RS }
//RS 
//RS impl FlatPreludeImport<'_> {
//RS     /// Two spellings of one item: `core`/`alloc` paths are `std` re-exports, so
//RS     /// a `no_std`-capable fragment and a hosted one may import the same item
//RS     /// under either root without binding one name to two items.
//RS     fn identity(&self) -> (String, &str) {
//RS         let path = self
//RS             .path
//RS             .strip_prefix("core::")
//RS             .or_else(|| self.path.strip_prefix("alloc::"))
//RS             .map_or_else(|| self.path.to_string(), |rest| format!("std::{rest}"));
//RS         (path, self.name)
//RS     }
//RS }
//RS 
//RS /// The bindings a fragment's leading top-level `use` items bring in. One
//RS /// parser backs the hosted and the portable import merge (I8).
//RS fn flat_prelude_import_bindings(source: &str) -> Vec<FlatPreludeImport<'_>> {
//RS     let mut bindings = Vec::new();
//RS     for statement in split_leading_top_level_uses(source).0 {
//RS         let item = statement
//RS             .trim_start_matches("use ")
//RS             .trim_end_matches(';')
//RS             .trim();
//RS         let (path, names) = match item.split_once("::{") {
//RS             Some((path, names)) => (path.trim(), names.trim_end_matches('}')),
//RS             None => item.rsplit_once("::").unwrap_or(("", item)),
//RS         };
//RS         for name in names.split(',') {
//RS             let name = name.trim();
//RS             if name.is_empty() {
//RS                 continue;
//RS             }
//RS             let (name, binding) = match name.split_once(" as ") {
//RS                 Some((name, binding)) => (name.trim(), binding.trim()),
//RS                 None => (name, name),
//RS             };
//RS             bindings.push(FlatPreludeImport { path, name, binding });
//RS         }
//RS     }
//RS     bindings
//RS }
//RS 
//RS /// Merge the leading imports of every flat fragment into one import block for
//RS /// the crate root. Keyed by the *binding* each import creates, because that is
//RS /// what rustc rejects twice (E0252): two fragments may import one item under
//RS /// one name through different spellings, but never two items under one name.
//RS ///
//RS /// `jet_foundation::<Module>` imports go through `FOUNDATION_PLACEMENTS`: the
//RS /// module must be one the program embeds, and an unaliased import of a
//RS /// root-flat module's item is already satisfied by flattening (at the root it
//RS /// would be a self-import, E0255), so it is omitted; every other spelling
//RS /// resolves through the `jet_foundation` facade.
//RS fn merge_flat_prelude_imports(sources: &[&str]) -> String {
//RS     let mut bindings: BTreeMap<&str, FlatPreludeImport<'_>> = BTreeMap::new();
//RS     for source in sources {
//RS         for import in flat_prelude_import_bindings(source) {
//RS             if let Some(module) = import
//RS                 .path
//RS                 .strip_prefix("jet_foundation::")
//RS                 .map(|rest| rest.split("::").next().unwrap_or(rest))
//RS             {
//RS                 match foundation_placement(module) {
//RS                     Some(FoundationPlacement::Root) if import.binding == import.name => continue,
//RS                     Some(_) => {}
//RS                     None => panic!(
//RS                         "flat Prelude fragment imports `jet_foundation::{module}`, which the \
//RS                          generated program does not embed; add its placement to \
//RS                          FOUNDATION_PLACEMENTS"
//RS                     ),
//RS                 }
//RS             }
//RS             match bindings.entry(import.binding) {
//RS                 std::collections::btree_map::Entry::Vacant(slot) => {
//RS                     slot.insert(import);
//RS                 }
//RS                 std::collections::btree_map::Entry::Occupied(slot) => {
//RS                     let kept = slot.get();
//RS                     assert!(
//RS                         kept.identity() == import.identity(),
//RS                         "flat Prelude fragments bind `{}` to two items: `{}::{}` and `{}::{}`",
//RS                         import.binding,
//RS                         kept.path,
//RS                         kept.name,
//RS                         import.path,
//RS                         import.name
//RS                     );
//RS                 }
//RS             }
//RS         }
//RS     }
//RS     let mut groups: BTreeMap<&str, Vec<String>> = BTreeMap::new();
//RS     for import in bindings.values() {
//RS         let spelling = if import.binding == import.name {
//RS             import.name.to_string()
//RS         } else {
//RS             format!("{} as {}", import.name, import.binding)
//RS         };
//RS         groups.entry(import.path).or_default().push(spelling);
//RS     }
//RS     let mut rendered = String::new();
//RS     for (path, names) in groups {
//RS         if let [only] = names.as_slice() {
//RS             rendered.push_str(&format!("use {path}::{only};\n"));
//RS         } else {
//RS             rendered.push_str(&format!("use {path}::{{{}}};\n", names.join(", ")));
//RS         }
//RS     }
//RS     rendered.push('\n');
//RS     rendered
//RS }
//RS 
//RS 
//RS /// The generated program is ONE flat Rust module assembled from many Prelude
//RS /// fragments, but each fragment is also a real Rust file compiled inside a
//RS /// module of its own crate — `Prelude/Scheduler.rs` as `jet_codegen::scheduler`,
//RS /// `Prelude/CoreLib/Top/ServiceAuthority.rs` inside `jet-comptime`'s
//RS /// `Comptime/ServicesLite.rs` — so a fragment must keep its own imports there.
//RS ///
//RS /// Concatenated, those per-fragment imports land in one scope, and two fragments
//RS /// importing one name make rustc reject the generated file: Scheduler.rs and
//RS /// ServiceAuthority.rs both imported `std::time::Duration`, so every program
//RS /// using `core.service` failed to build with E0252 — an internal compiler
//RS /// error (I2), never a user diagnostic.
//RS ///
//RS /// Neither per-fragment workaround closes that class. Qualifying paths inline
//RS /// cannot work for trait imports, because method resolution needs the trait in
//RS /// scope (Scheduler.rs calls `TcpStream::write`). Wrapping these fragments in a
//RS /// private module the way `jet_gc`/`jet_sync` are wrapped cannot work either,
//RS /// because generated code calls their private items flat — `TIR/emit/core_calls.rs`
//RS /// emits 24 private `jet_services_*` calls and `Context.rs` three private types,
//RS /// and a glob re-export carries only `pub` ones.
//RS ///
//RS /// So the assembler owns the flat module's import set instead (I8). It is
//RS /// derived, not restated: add an import to any flat fragment and it is merged
//RS /// here automatically, so no second collision can be introduced by hand.
//RS /// Emitted unconditionally with the scheduler, which every embedded runtime
//RS /// carries — the harness carries `#![allow(warnings)]`, so an import a program
//RS /// never uses costs nothing, and no user name can shadow one because every
//RS /// emitted user type goes through `mangle_path` (`__jet_` prefix).
//RS static FLAT_PRELUDE_IMPORTS: std::sync::LazyLock<String> =
//RS     std::sync::LazyLock::new(|| merge_flat_prelude_imports(&FLAT_PRELUDE_SOURCES));
//RS 
//RS /// `Prelude/CoreLib/Top/ServiceAuthority.rs` as the assembler emits it.
//RS static SERVICE_AUTHORITY_PRELUDE: std::sync::LazyLock<String> =
//RS     std::sync::LazyLock::new(|| flat_prelude_body(SERVICE_AUTHORITY_PRELUDE_RAW));
//RS 
//RS fn service_authority_prelude_for_emit() -> &'static str {
//RS     SERVICE_AUTHORITY_PRELUDE.as_str()
//RS }
//RS 
//RS /// The flat import set, then `Prelude/Scheduler.rs` + `Prelude/Stream.rs` bodies.
//RS fn assemble_scheduler_prelude(scheduler: String) -> String {
//RS     let stream = flat_prelude_body(STREAM_PRELUDE_RAW);
//RS     let mut source =
//RS         String::with_capacity(FLAT_PRELUDE_IMPORTS.len() + scheduler.len() + stream.len());
//RS     source.push_str(FLAT_PRELUDE_IMPORTS.as_str());
//RS     source.push_str(&scheduler);
//RS     source.push_str(&stream);
//RS     source
//RS }
//RS 
//RS static SCHEDULER_PRELUDE_NATIVE: std::sync::LazyLock<String> = std::sync::LazyLock::new(|| {
//RS     assemble_scheduler_prelude(
//RS         flat_prelude_body(SCHEDULER_PRELUDE_RAW).replace("feature = \"jet_native_io\"", "all()"),
//RS     )
//RS });
//RS 
//RS static SCHEDULER_PRELUDE_PORTABLE: std::sync::LazyLock<String> = std::sync::LazyLock::new(|| {
//RS     assemble_scheduler_prelude(["notify", "epoll", "kqueue", "iocp"].into_iter().fold(
//RS         flat_prelude_body(SCHEDULER_PRELUDE_RAW),
//RS         strip_scheduler_region,
//RS     ))
//RS });
//RS 
//RS fn scheduler_prelude_for_emit(native_io: bool) -> &'static str {
//RS     if native_io {
//RS         SCHEDULER_PRELUDE_NATIVE.as_str()
//RS     } else {
//RS         SCHEDULER_PRELUDE_PORTABLE.as_str()
