//RS /// `Prelude/CoreLib/Top/EncodingCodecs.rs` reads the package edition as
//RS /// `__JET_PACKAGE_EDITION`, and the CoreLib kernel is emitted whenever a program
//RS /// mentions any default `Int`. Every harness therefore needs the constant, so one
//RS /// helper emits it: three hand-written copies had already drifted, leaving the
//RS /// fuzz harness with the three uses and no definition (rustc E0425 on generated
//RS /// code, an I2 violation). Unconditional on purpose — the harness carries
//RS /// `#![allow(warnings)]`, so an unused const costs nothing, and a definition that
//RS /// is never gated cannot drift from the use guard again.
//RS fn push_package_edition_value(out: &mut String, edition: &str) {
//RS     let edition_year = edition.parse::<u16>().unwrap_or(2027);
//RS     out.push_str(&format!(
//RS         "const __JET_PACKAGE_EDITION: u16 = {edition_year};\n\n"
//RS     ));
//RS }
//RS 
//RS fn push_package_edition(out: &mut String, bundle: &ProgramBundle) {
