// Rust: crates/jet-codegen/src/Codegen/mod.rs:3601
// Continuation of the kernel-part loop in Codegen02.
fn append_corelib_kernel_part(out: &String, part: &String) -> {
    body := if part == MATH_TASK_MEM_PRELUDE { strip_source_shared_interop_jit(part) } else { part }
    out.push_str(body.strip_prefix("    include!(\"Mime.rs\");\n\n").unwrap_or(body))
}

// Rust: crates/jet-codegen/src/Codegen/mod.rs:3616
// Continuation after the kernel-part loop; preceding selection facts stay explicit.
fn push_corelib_prelude_body_tail(out: &String, used_core: &HashSet<String>, omit_testing_shared: Bool, forces: CorePreludeForces, policy: &ReleaseDevtoolsPolicy, needs_xml: Bool, needs_base: Bool, needs_files: Bool, needs_fs_runtime: Bool) -> {
    out.push_str(flat_prelude_body(CORE_LAZY_TABLE_PLAN_PRELUDE_RAW))
    // Suite handle operations are ungated at their call sites.
