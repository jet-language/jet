use JetFoundation.AST.[Expr, Marker, StrPart, StructDef, Variant, CtValue, MigrationDecl]
use JetFoundation.Syntax
use JetCodegen.Codegen.Cx

// Rust: crates/jet-codegen/src/Codegen/Items.rs:3
fn serde_marker(markers: View<Marker>, name: String) -> &Marker? {
    markers.iter().find(fn(m) -> m.name == name)
}

// Rust: crates/jet-codegen/src/Codegen/Items.rs:6
fn marker_str_arg_for(m: &Marker, label: String) -> String? {
    for (index, marker_label) in m.arg_labels.iter().enumerate() {
        if !marker_label.as_ref().is_some_and(fn(pair) -> pair.0 == label) { continue }
        if expr := m.expr_arg(index) {
            match expr {
                Expr.Str(parts, _) => {
                    if parts.len() == 1 {
                        match parts[0] {
                            StrPart.Lit(s) => return Some(s.clone())
                            _ => {}
                        }
                    }
                }
                _ => {}
            }
        }
    }
    None
}

// Rust: crates/jet-codegen/src/Codegen/Items.rs:25
fn marker_str_arg(m: &Marker) -> String? {
    if m.ct is Some(CtValue.Str(value)) { return Some(value.clone()) }
    match m.expr_arg(0) {
        Some(Expr.Str(parts, _)) => {
            if parts.len() == 1 {
                match parts[0] {
                    StrPart.Lit(s) => Some(s.clone())
                    _ => None
                }
            } else { None }
        }
        _ => None
    }
}

// Rust: crates/jet-codegen/src/Codegen/Items.rs:39
// D-SERDE3=C, D-ACRO-CASE1=A: mechanical acronym split for wire casing.
fn apply_rename_all(style: String, name: String) -> String {
    match style {
        Syntax.RENAME_ALL_CAMEL => Syntax.to_camel_acronym(name)
        Syntax.RENAME_ALL_PASCAL => Syntax.to_pascal_acronym(name)
        Syntax.RENAME_ALL_KEBAB => Syntax.to_snake_acronym(name).replace('_', "-")
        Syntax.RENAME_ALL_SCREAMING => Syntax.to_shouty_acronym(name)
        // Snake and unrecognized styles; sema rejects the latter with E2409.
        _ => Syntax.to_snake_acronym(name)
    }
}

// Rust: crates/jet-codegen/src/Codegen/Items.rs:49
pub fn container_rename_all(markers: View<Marker>) -> String? {
    serde_marker(markers, Syntax.MARKER_RENAME_ALL).and_then(fn(m) -> {
        match m.expr_arg(0) {
            Some(Expr.Ident(n, _)) => Some(n.clone())
            _ => None
        }
    })
}

// Rust: crates/jet-codegen/src/Codegen/Items.rs:56
// Apply the checked container wire-casing rule to a source field name.
pub fn serde_wire_name(style: String?, name: String) -> String {
    match style {
        Some(value) => apply_rename_all(value, name)
        None => name.to_string()
    }
}

// Rust: crates/jet-codegen/src/Codegen/Items.rs:62
// Per-variant #Rename wins over the enclosing enum's #RenameAll rule.
pub fn variant_wire_key(style: String?, variant: &Variant) -> String {
    if m := serde_marker(variant.serde_markers, Syntax.MARKER_RENAME) {
        if s := marker_str_arg_for(m, "json").or_else(fn() -> marker_str_arg(m)) { return s }
    }
    serde_wire_name(style, variant.name)
}

// Rust: crates/jet-codegen/src/Codegen/Items.rs:76
// D-MIGRATE4: runtime migration machinery must use the same gate as sema.
// Grouped #[PublishedSchema, Codable] leaves PublishedSchema in derives.
pub fn migration_blocks(cx: &Cx, s: &StructDef) -> View<MigrationDecl>? {
    published := s.is_published_schema || s.derives.iter().any(fn(pair) -> pair.0 == Syntax.MARKER_PUBLISHED_SCHEMA)
    if !published || !s.type_params.is_empty() { return None }
    blocks := cx.migrations.get(s.name) ?? return None
    if blocks.is_empty() { None } else { Some(blocks[0..<blocks.len()]) }
}
