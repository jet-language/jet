// Rust: crates/jet-codegen/src/Codegen/Web.rs:125
pub struct CanonicalWebRawAssets {
    pub dom_runtime: String, pub execution_prelude: String, pub event_prelude: String,
    pub realtime_prelude: String, pub data_prelude: String, pub history_prelude: String,
    pub compute_prelude: String, pub raylib_prelude: String, pub game_prelude: String,
    pub task_group_prelude: String, pub runtime_stop_metadata: String,
    pub game_default_frame_budget: I64, pub game_frame_budget_error: String,
    pub harfbuzz_wasm: [U8], pub timezone_data: [(String, [U8])]
}
// Rust: crates/jet-codegen/src/Codegen/Web.rs:143
pub fn canonical_web_raw_assets() -> CanonicalWebRawAssets Error! {
    CanonicalWebRawAssets{
        dom_runtime: DOM_RUNTIME, execution_prelude: JS_EXECUTION_PRELUDE,
        event_prelude: JS_EVENT_PRELUDE, realtime_prelude: JS_REALTIME_PRELUDE,
        data_prelude: JS_DATA_PRELUDE, history_prelude: JS_TESTING_HISTORY_PRELUDE,
        compute_prelude: JS_COMPUTE_PRELUDE, raylib_prelude: JS_RAYLIB_PRELUDE,
        game_prelude: JS_GAME_PRELUDE, task_group_prelude: JS_TASK_GROUP_PRELUDE,
        runtime_stop_metadata: js_runtime_stop_metadata(),
        game_default_frame_budget: JetGameFrameBudget.DEFAULT_HEADLESS_FRAMES,
        game_frame_budget_error: JetGameFrameBudget.FRAME_BUDGET_ERROR,
        harfbuzz_wasm: canonical_web_harfbuzz_bytes()?, timezone_data: web_tzdb_files()?
    }
}
// Rust: crates/jet-codegen/src/Codegen/Web.rs:169
fn shared_js_prelude(include_harfbuzz: Bool, runtime_parts: [MirRuntimePartId: Bool], include_history: Bool) -> String Error! {
    out := String.from(JS_EXECUTION_PRELUDE)
    if runtime_parts.contains_key(MirRuntimePartId.Event) -> &out.push_str(JS_EVENT_PRELUDE)
    if runtime_parts.contains_key(MirRuntimePartId.Realtime) -> &out.push_str(JS_REALTIME_PRELUDE)
    if runtime_parts.contains_key(MirRuntimePartId.Data) -> &out.push_str(JS_DATA_PRELUDE)
    if include_history -> &out.push_str(JS_TESTING_HISTORY_PRELUDE)
    if runtime_parts.contains_key(MirRuntimePartId.Compute) -> &out.push_str(JS_COMPUTE_PRELUDE)
    if runtime_parts.contains_key(MirRuntimePartId.Game) {
        &out.push_str(JS_RAYLIB_PRELUDE)
        &out.push_str(JS_GAME_PRELUDE)
        &out.push_str("\nconst JET_GAME_DEFAULT_FRAME_BUDGET = {JetGameFrameBudget.DEFAULT_HEADLESS_FRAMES};\nconst JET_GAME_FRAME_BUDGET_ERROR = {json_quote(JetGameFrameBudget.FRAME_BUDGET_ERROR)};\n")
    }
    if include_harfbuzz -> &out.push_str(canonical_web_harfbuzz_asset()?)
    if runtime_parts.contains_key(MirRuntimePartId.Math) -> &out.push_str(js_time_zone_prelude()?)
    &out.push_str(JS_TASK_GROUP_PRELUDE)
    &out.push_str(js_runtime_stop_metadata())
    out
}
// Rust: crates/jet-codegen/src/Codegen/Web.rs:217
fn canonical_web_harfbuzz_bytes() -> [U8] Error! {
    const ARTIFACT_PATH: String = "wasm/jet_harfbuzz.wasm"
    const MAX_ARTIFACT_BYTES: USize = 32 * 1024 * 1024
    // GATE #4494: retained immutable compile-time byte asset.
    const BYTES: [U8] = include_bytes("Docs/site/assets/wasm/jet_harfbuzz.wasm")
    if BYTES.len() > MAX_ARTIFACT_BYTES || BYTES.len() < 8 || BYTES[..4] != [0, 97, 115, 109] || BYTES[4..<8] != [1, 0, 0, 0] {
        // GATE #4409: InvalidData must survive the IO carrier.
        return Err(Error.new(ErrorKind.InvalidData, "invalid canonical HarfBuzz Wasm artifact: {ARTIFACT_PATH}"))
    }
    BYTES
}
// Rust: crates/jet-codegen/src/Codegen/Web.rs:233
fn canonical_web_harfbuzz_asset() -> String Error! {
    const ARTIFACT_PATH: String = "wasm/jet_harfbuzz.wasm"
    bytes :: canonical_web_harfbuzz_bytes()?
    digest :: sha256_hex(bytes)
    out := String.from("\n// D-FOUND-PLATFORM1=A: the checked HarfBuzz bridge travels with the app.\nconst __jetCanonicalHarfBuzzWasmAsset = Object.freeze({{path:")
    &out.push_str(json_quote(ARTIFACT_PATH))
    &out.push_str(",sha256:")
    &out.push_str(json_quote(digest))
    &out.push_str(",bytes:new Uint8Array([")
    loop (index, byte) in bytes.enumerate() {
        if index != 0 -> &out.push(',')
        &out.push_str("{byte}")
    }
    &out.push_str("])}});\nglobalThis.__jetCanonicalHarfBuzzWasm = __jetCanonicalHarfBuzzWasmAsset;\n")
    out
}
// Rust: crates/jet-codegen/src/Codegen/Web.rs:261
fn web_tzdb_files() -> [(String, [U8])] Error! {
    // Rust: crates/jet-codegen/src/Codegen/Web.rs:262
    fn collect(root: OSPath, dir: OSPath, files: &[(String, [U8])]) -> Void Error! {
        // GATE #4494: native directory entries and byte reads; no host path coercion.
        entries := fs.read_dir(dir)?.collect_result()?
        &entries.sort_by_key(entry -> entry.file_name())
        loop entry in entries {
            path :: entry.path()
            file_type :: entry.file_type()?
            if file_type.is_dir() { collect(root, path, &files)?; continue }
            if !file_type.is_file() -> continue
            bytes :: fs.read(path)?
            if !bytes.starts_with([84, 90, 105, 102]) -> continue
            relative :: path.strip_prefix(root).map_err(fn(_) {
                Error.new(ErrorKind.InvalidData, "TZif path must be below the TZif root") // GATE #4409
            })?
            name :: relative.components().filter_map(component -> component.as_os_str().to_str()).join("/")
            &files.push((name, ^bytes))
        }
    }
    root :: OSPath.from("Core/time/tzdb")
    files := [(String, [U8])]{}
    collect(root, root, &files)?
    &files.sort_by(left, right -> left.0.cmp(right.0))
    files
}
// Rust: crates/jet-codegen/src/Codegen/Web.rs:307
fn js_time_zone_prelude() -> String Error! {
    out := String.from("\n// D-TIMEDEPTH1: exact repository TZif inputs for browser named zones.\n")
    loop (name, bytes) in web_tzdb_files()? {
        &out.push_str("JET_TIME_ZONE_DATA[{json_quote(name)}] = new Uint8Array([")
        loop byte in bytes -> &out.push_str("{byte},")
        &out.push_str("]);\n")
    }
    out
}
// Rust: crates/jet-codegen/src/Codegen/Web.rs:328
pub fn build_wasm_jet_source_map(wasm: [U8], rust_src: String, source_names: [String], source_contents: [String]) -> String Err! {
    code_off :: code_section_payload_offset(wasm).map_err(e -> "wasm code section: {e:?}")?
        ?? return Err("wasm module has no Code section")
    dwarf :: parse_debug_line(wasm).map_err(e -> "wasm .debug_line: {e:?}")?
    rust_to_jet :: rust_marker_table(rust_src)
    name_index := [String: USize]{}
    loop (i, name) in source_names.enumerate() -> name_index[name] = i
    mappings := [JSMapping]{}
    last_offset := None as USize?
    loop row in dwarf {
        if !row.is_stmt || row.end_sequence || row.line == 0 -> continue
        if !row.file.ends_with("app_wasm.rs") && !row.file.contains("app_wasm.rs") {
            base :: OSPath.from(row.file).file_name().and_then(n -> n.to_str()) ?? row.file
            if base != "app_wasm.rs" -> continue
        }
        (source_name, jet_line) :: rust_to_jet.jet_for_rust_line(USize{row.line}) ?? continue
        source :: name_index.get(source_name) ?? continue
        file_offset :: code_off.checked_add(USize{row.address}) ?? return Err("wasm mapping offset overflow")
        if last_offset == Val(file_offset) -> continue
        last_offset = Val(file_offset)
        &mappings.push(JSMapping{generated_line: 0, generated_column: file_offset, source: source, original_line: jet_line.saturating_sub(1)})
    }
    &mappings.sort_by_key(m -> (m.generated_line, m.generated_column, m.source, m.original_line))
    encoded :: encode_source_mappings(mappings)
    names :: source_names.map(n -> json_quote(n)).join(",")
    contents :: source_contents.map(c -> json_quote(c)).join(",")
    "{{\"version\":3,\"file\":\"app.wasm\",\"sources\":[{names}],\"sourcesContent\":[{contents}],\"names\":[],\"mappings\":{json_quote(encoded)}}}\n"
}
// Rust: crates/jet-codegen/src/Codegen/Web.rs:408
struct RustMarkerTable {
    rows: [USize: (String, USize)], keys: [USize]
}
// Rust: crates/jet-codegen/src/Codegen/Web.rs:414
impl RustMarkerTable {
    fn jet_for_rust_line(self: RustMarkerTable, rust_line: USize) -> (String, USize)? Never! {
        // Sorted once; upper-bound predecessor preserves BTreeMap logarithmic lookup.
        lo := 0 as USize
        hi := self.keys.len()
        while lo < hi {
            mid :: lo + (hi - lo) / 2
            if self.keys[mid] <= rust_line { lo = mid + 1 } else { hi = mid }
        }
        if lo == 0 -> return None
        self.rows.get(self.keys[lo - 1])
    }
}
// Rust: crates/jet-codegen/src/Codegen/Web.rs:422
fn rust_marker_table(rust_src: String) -> RustMarkerTable Never! {
    rows := [USize: (String, USize)]{}
    keys := [USize]{}
    pending_source := None as String?
    pending_line := None as USize?
    loop (i, line) in rust_src.lines().enumerate() {
        rust_line :: i + 1
        trim := line.trim_start() // #4303
        if trim.strip_prefix("// jet:source-map source=") == .Val(name) {
            pending_source = Val(name.trim().to_string())
            continue
        }
        if trim.strip_prefix("// jet:line ") == .Val(n) {
            pending_line = n.trim().parse[USize]().ok()
            continue
        }
        jet_line :: pending_line
        pending_line = None
        if pending_source == .Val(source) && jet_line == .Val(n) {
            if !rows.contains_key(rust_line) { rows[rust_line] = (source, n); &keys.push(rust_line) }
        }
    }
    RustMarkerTable{rows: ^rows, keys: ^keys}
}
// Rust: crates/jet-codegen/src/Codegen/Web.rs:445
fn json_quote(s: String) -> String Never! {
    out := String.from("\"")
    loop c in s.chars() {
        if c == {
            '\\' -> &out.push_str("\\\\")
            '"' -> &out.push_str("\\\"")
            '\n' -> &out.push_str("\\n")
            '\r' -> &out.push_str("\\r")
            '\t' -> &out.push_str("\\t")
            else -> {
                if U32{c} < 0x20 { &out.push_str("\\u{U32{c}:04x}") } else { &out.push(c) }
            }
        }
    }
    &out.push('"')
    out
}
// Rust: crates/jet-codegen/src/Codegen/Web.rs:462
struct JSMapping { generated_line: USize, generated_column: USize, source: USize, original_line: USize }
// Rust: crates/jet-codegen/src/Codegen/Web.rs:469
fn encode_source_mappings(mappings: [JSMapping]) -> String Never! {
    out := String.new()
    generated_line := 0 as USize
    generated_column := 0 as I64
    source := 0 as I64
    original_line := 0 as I64
    original_column := 0 as I64
    first_segment := true
    loop mapping in mappings {
        while generated_line < mapping.generated_line {
            &out.push(';')
            generated_line += 1
            generated_column = 0
            first_segment = true
        }
        if !first_segment -> &out.push(',')
        next_generated_column :: I64{mapping.generated_column}
        next_source :: I64{mapping.source}
        next_original_line :: I64{mapping.original_line}
        encode_base64_vlq(next_generated_column - generated_column, &out)
        encode_base64_vlq(next_source - source, &out)
        encode_base64_vlq(next_original_line - original_line, &out)
        encode_base64_vlq(-original_column, &out)
        generated_column = next_generated_column
        source = next_source
        original_line = next_original_line
        original_column = 0
        first_segment = false
    }
    out
}
// Rust: crates/jet-codegen/src/Codegen/Web.rs:504
fn encode_base64_vlq(value: I64, out: &String) -> Void Never! {
    const BASE64: String = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"
    encoded := if value < 0 { ((-value) << 1) | 1 } else { value << 1 }
    loop {
        digit := USize{encoded & 31}
        encoded >>= 5
        if encoded != 0 -> digit |= 32
        &out.push(Char{BASE64.as_bytes()[digit]})
        if encoded == 0 -> break
    }
}
// Rust: crates/jet-codegen/src/Codegen/Web.rs:524
fn js_runtime_stop_metadata() -> String Never! {
    report_template :: fn(report: JetRuntimeDiagnostic) -> String Never! {
        rich_location :: "  --> __JET_RUNTIME_FILE__:{U32.MAX} in __JET_RUNTIME_FUNCTION__\n"
        plain_location :: "  --> __JET_RUNTIME_FILE__:{U32.MAX}\n"
        report.rendered.replace(rich_location, "").replace(plain_location, "")
            .replace(U32.MAX.to_string(), "__JET_RUNTIME_LINE__")
            .replace("\n Why:", "\n__JET_RUNTIME_CONTEXT__\n Why:")
    }
    default_report :: jet_render_runtime_stop("__JET_RUNTIME_STOP_CODE__", "__JET_RUNTIME_FILE__", U32.MAX,
        "__JET_RUNTIME_FUNCTION__", "", 1, 1, "__JET_RUNTIME_MESSAGE__", "")
    default_source :: default_report.source
    default_exit_code :: default_report.exit_code
    default_rendered :: report_template(default_report)
    out := "const JET_RUNTIME_STACK = [];\nconst JET_RUNTIME_STACK_LIMIT = {JET_RUNTIME_STACK_LIMIT};\nconst JET_STACK_OVERFLOW_MESSAGE = {json_quote(jet_stack_overflow_message("__JET_RUNTIME_FUNCTION__"))};\nconst JET_RUNTIME_STOP_DEFAULT = Object.freeze({{ source: {json_quote(default_source)}, exit_code: {default_exit_code}, rich_context: false, rendered: {json_quote(default_rendered)} }});\nconst JET_RUNTIME_STOP_METADATA = Object.freeze({{\n"
    loop row in diagnostic_rows() {
        if row.stage != "runtime" || row.status != DiagnosticStatus.Active -> continue
        message :: if row.template_holes.any(hole -> hole == "type") {
            "__JET_RUNTIME_TODO_PREFIX__ — expected __JET_RUNTIME_TODO_TYPE__"
        } else { "__JET_RUNTIME_MESSAGE__" }
        report :: jet_render_runtime_stop(row.code, "__JET_RUNTIME_FILE__", U32.MAX,
            "__JET_RUNTIME_FUNCTION__", "", 1, 1, message, "")
        source :: report.source
        exit_code :: report.exit_code
        rich_context :: jet_runtime_stop_has_context(report.code)
        rendered :: report_template(report)
        &out.push_str("  {json_quote(row.code)}: Object.freeze({{ source: {json_quote(source)}, exit_code: {exit_code}, rich_context: {rich_context}, rendered: {json_quote(rendered)} }}),\n")
    }
    &out.push_str("}});\n\n")
    out
}
