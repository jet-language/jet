// Rust: crates/jet-codegen/src/Codegen/mod.rs:201
pub fn core_imports_for_bundle(bundle: &ProgramBundle) -> [String:String] {
    imports := [String:String].new()
    for module_idx in 0..bundle.modules.len() {
        module_imports :: core_import_map(bundle, module_idx)
        aliases :: module_imports.keys().cloned().collect()
        aliases.sort()
        for alias in aliases { _ :: imports.entry(alias.clone()).or_insert(module_imports[&alias].clone()) }
    }
    imports
}

