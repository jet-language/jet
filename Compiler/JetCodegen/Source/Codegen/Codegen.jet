fn portable_runtime_diagnostic_projection() -> String {
    rows :: jet_foundation.Registry.diagnostic_rows().iter().filter(fn(row) { row.stage == "runtime" && row.status == jet_foundation.Registry.DiagnosticStatus.Active })
    out := "\nfn jet_runtime_diagnostic_row(code: &str) -> Option<JetRuntimeDiagnosticRow> {\n    match code {\n"
    for row in rows {
        holes :: row.template_holes.iter().map(fn(hole) { "{hole:?}" }).collect[[String]]().join(", ")
        out.push_str(&"        {row.code:?} => Some(JetRuntimeDiagnosticRow {{ code: {row.code:?}, what: {row.what:?}, why: {row.why:?}, fix: {row.fix:?}, template_holes: &[{holes}] }}),\n")
    }
    out.push_str("        _ => None,\n    }\n}\n\n")
