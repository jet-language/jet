    ("Evidence", .Root), ("NumericConversion", .Root), ("ExactUnitConversion", .Root),
    ("StructuralDebug", .Root), ("StreamCursor", .Root),
    ("RuntimeDiagnosticCore", .Module("RuntimeDiagnosticCore")), ("EncodingErrors", .Module("jet_encoding_errors")),
