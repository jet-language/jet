//RS /// Where a Foundation module lands in the generated crate.
//RS enum FoundationPlacement {
//RS     /// Spliced flat: its items are the crate root's own items.
//RS     Root,
//RS     /// Wrapped in this generated module.
//RS     Module(&'static str),
//RS }
//RS 
//RS /// The Foundation modules a generated program embeds, by their Foundation
//RS /// name. Prelude sources compile both inside host crates, where
//RS /// `jet_foundation` is a real dependency, and inside the generated crate,
//RS /// which has none; this table is the one contract that lets a source spell
//RS /// `jet_foundation::<Module>::<Item>` identically in both. It emits the
//RS /// `mod jet_foundation` facade (`push_foundation_facade`) and drives the flat
//RS /// import merge (`flat_prelude_import_bindings`). Optional source modules
//RS /// emitted only under `needs_fs_runtime` use their conditional generated
//RS /// aliases instead of entering this unconditional facade.
//RS const FOUNDATION_PLACEMENTS: &[(&str, FoundationPlacement)] = &[
//RS     ("Outcome", FoundationPlacement::Root),
//RS     ("Shape", FoundationPlacement::Root),
//RS     ("Devtools", FoundationPlacement::Root),
//RS     ("DevtoolsNative", FoundationPlacement::Root),
//RS     ("Evidence", FoundationPlacement::Root),
//RS     ("NumericConversion", FoundationPlacement::Root),
//RS     ("ExactUnitConversion", FoundationPlacement::Root),
//RS     ("StructuralDebug", FoundationPlacement::Root),
//RS     ("StreamCursor", FoundationPlacement::Root),
//RS     ("RuntimeDiagnosticCore", FoundationPlacement::Module("RuntimeDiagnosticCore")),
//RS     ("EncodingErrors", FoundationPlacement::Module("jet_encoding_errors")),
//RS     ("JSONNumber", FoundationPlacement::Module("jet_json_number")),
//RS     ("EncodingJson", FoundationPlacement::Module("jet_encoding_json")),
//RS     ("DataTree", FoundationPlacement::Module("jet_foundation_datatree")),
//RS     ("ArrowData", FoundationPlacement::Module("jet_arrow_data")),
//RS     (
//RS         "ArrowFileReader",
//RS         FoundationPlacement::Module("jet_arrow_file_reader"),
//RS     ),
//RS     ("PreludeDataFlow", FoundationPlacement::Module("jet_prelude_data_flow")),
//RS     ("SHA256", FoundationPlacement::Module("SHA256")),
//RS     ("PerformanceBudget", FoundationPlacement::Module("PerformanceBudget")),
//RS     ("Numeric", FoundationPlacement::Module("jet_foundation_numeric")),
//RS     ("Facts", FoundationPlacement::Module("Facts")),
//RS     ("ResourceSchedule", FoundationPlacement::Module("ResourceSchedule")),
//RS     (
//RS         "CompilerStack",
//RS         FoundationPlacement::Module("CompilerStack"),
//RS     ),
//RS ];
//RS fn foundation_placement(module: &str) -> Option<&'static FoundationPlacement> {
//RS     FOUNDATION_PLACEMENTS
//RS         .iter()
//RS         .find(|(name, _)| *name == module)
//RS         .map(|(_, placement)| placement)
//RS }
//RS 
//RS /// `mod jet_foundation { pub mod <Module> { … } }`: every embedded Foundation
//RS /// module re-exported under its host-crate path. Root-flat modules re-export
//RS /// the crate root itself, so an item keeps the visibility Foundation gave it.
//RS /// Arrow entries are conditional because their modules are demand-driven.
//RS /// `CompilerStack` is compiler infrastructure; generated programs only receive
//RS /// the stack-size constant Prelude scheduler workers share with the host.
