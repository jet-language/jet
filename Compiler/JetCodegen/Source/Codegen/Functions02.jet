fn tfunc_method_owner(function: TFunc) -> (Type, String?)? {
    if function.kind == { Method{owner_type: owner_type, ..} -> Val((owner_type, None)) TraitMethod{owner_type: owner_type, trait_name: trait_name, ..} -> Val((owner_type, Val(trait_name))) TopLevel -> None }
}

// Rust: crates/jet-codegen/src/Codegen/TIR/mir.rs:2247
fn nominal_owner_name(ty: Type) -> String { if ty == { Named(name) | Apply{name: name, ..} -> name.clone() _ -> ty.name() } }

// Rust: crates/jet-codegen/src/Codegen/TIR/mir.rs:2254
fn method_base_leaf(name: String) -> String {
    leaf := method_leaf(name)
    leaf := leaf.split("__generic__").next() ?? leaf
    leaf.split('<').next() ?? leaf
}

// Rust: crates/jet-codegen/src/Codegen/TIR/mir.rs:2260
fn impl_method_matches(function: TFunc, row: TirImplDef, method_key: String) -> Bool {
    (owner, function_trait) :: tfunc_method_owner(function) ?? return false
    if function.module != row.module || method_base_leaf(method_key) != method_base_leaf(function.name) { return false }
    row_trait :: row.trait_ref.or(row.trait_name)
    if function_trait != row_trait { return false }
    expected_owner :: canonical_target_type(row.module, nominal_owner_name(row.self_type))
    actual_owner :: canonical_target_type(function.module, nominal_owner_name(owner))
    if expected_owner != actual_owner { return false }
    if row.operator_rhs == {
        Val(expected_rhs) -> {
            actual_rhs :: function_operator_rhs(function) ?? return false
            if canonical_target_type(row.module, expected_rhs.name()) != canonical_target_type(function.module, actual_rhs) { return false }
        }
        None -> {}
    }
    true
}

// Rust: crates/jet-codegen/src/Codegen/TIR/mir.rs:2295
fn lower_impl_rows(rows: [TirImplDef], functions: [TFunc], registry: FunctionRegistry, types: [MirTypeDef]) -> [MirImplDef] LowerError! {
    result := [MirImplDef]{}
    loop row in rows {
        declared_self_type :: module_relative_type_instance(types, row.self_type, row.module, row.span)?
        trait_name :: row.trait_ref.or(row.trait_name)
