//RS         env: None,
//RS         // Same flag, help, and metavar text a `#CLI` record field gets, so a
//RS         // job's inputs pass the one CLI legality rule and render identically.
//RS         help: format!("value for --{}", argument.name),
//RS         metavar: (!flag).then(|| argument.name.replace('-', "_").to_uppercase()),
//RS         shape: if flag {
