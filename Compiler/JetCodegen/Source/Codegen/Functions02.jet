//RS /// The most scalar leaves a constant may hold and still be copied into each
//RS /// use site; larger values stay one shared item.
//RS const INLINE_CONSTANT_LEAVES: usize = 8;
//RS /// The longest text a copied constant may carry per leaf.
//RS const INLINE_CONSTANT_TEXT_BYTES: usize = 256;
//RS 
//RS /// Card #4258 (D-CONSTMARK1): a read of an immutable module constant whose
//RS /// folded value is a scalar, text, or a small record or enum case of those
//RS /// becomes a MIR `Constant` at the use site, so the optimizer can fold it and
//RS /// no backend calls an accessor. `#Static` keeps the `Global` read of the
//RS /// one addressable item; `#Inline` copies any value.
//RS /// Tables stay one shared item; the emitter caches a large one.
//RS fn inline_known_constant_reads(
//RS     functions: &mut [MirFunction],
//RS     rows: &[super::tir_to_mir_types::TirConstantDef],
