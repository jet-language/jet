//RS fn inline_constant_fits(value: &MirConstant, leaves: &mut usize) -> bool {
//RS     match value {
//RS         MirConstant::Int { .. }
//RS         | MirConstant::Float { .. }
//RS         | MirConstant::Bool(_)
//RS         | MirConstant::Char(_)
//RS         | MirConstant::Unit
//RS         | MirConstant::BigInt(_) => {}
//RS         MirConstant::String(text) if text.len() <= INLINE_CONSTANT_TEXT_BYTES => {}
//RS         MirConstant::Struct { fields, .. } => {
//RS             return fields
