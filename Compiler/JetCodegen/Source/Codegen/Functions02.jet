                id :: registry.id_for(function)?
                if !candidates.iter().any(fn(pair) { pair.0 == id }) { &candidates.push((id, function)) }
            }
            loop (id, function) in candidates {
                (owner, _) :: tfunc_method_owner(function) ?? continue
                owner :: module_relative_type_instance(types, owner, row.module, row.span)?
                group_index :: method_groups.iter().position(fn(pair) { same_impl_owner(pair.0, owner) })
                if group_index == {
                    Val(index) -> { if !method_groups[index].1.contains(id) { &method_groups[index].1.push(id) } }
                    None -> &method_groups.push((owner, [id]))
                }
            }
        }
        if method_groups.is_empty() { &method_groups.push((declared_self_type, row.methods.iter().filter_map(fn(key) { resolve_function_key(key, row.module, registry) }).collect())) }
        if !row.methods.is_empty() && method_groups.iter().all(fn(pair) { pair.1.is_empty() }) { continue }
        loop (self_type, methods) in method_groups {
            key :: canonical_impl_key(row.module, self_type, trait_name)
            associated_types := [MirAssociatedTypeValue]{}
            loop associated in row.associated_types { &associated_types.push(MirAssociatedTypeValue{name: associated.name.clone(), ty: module_relative_type_instance(types, associated.ty, row.module, associated.span)?, span: associated.span}) }
            operator_rhs :: if row.operator_rhs == { Val(ty) -> Val(module_relative_type_instance(types, ty, row.module, row.span)?) None -> None }
            &result.push(MirImplDef{id: MirImplId(stable_id("mir-impl", key)), module: MirModuleId(stable_id("mir-module", row.module)), key: key, span: row.span, self_type: self_type,
                trait_ref: trait_name.filter(fn(name) { !is_literal_capability_trait(name) }).map(fn(name) { MirTraitRef{id: MirTraitId(stable_id("mir-trait", name)), name: name.clone()} }), associated_types: associated_types, methods: methods,
                delegation: row.delegation_field.and_then(fn(name) { resolve_field_id(types, name) }), compiler_generated: row.compiler_generated, serde: row.serde.map(fn(serde) { if serde == { Encode -> MirSerdeCodec.Encode Decode -> MirSerdeCodec.Decode } }),
                operator_rhs: operator_rhs, operator_marker: row.operator_marker.clone(), target_os: row.target_os.clone(), target_applicability: MirTargetApplicability{rust_aot: true, cranelift: true, interpreter: true, web: true}})
        }
    }
    impl_indices := [String:USize]{}
    deduplicated := [MirImplDef].with_capacity(result.len())
    loop row in result {
        if impl_indices.get(row.key) == {
            Val(index) -> { loop method in row.methods { if !deduplicated[index].methods.contains(method) { &deduplicated[index].methods.push(method) } } }
            None -> { index :: deduplicated.len(); &impl_indices.insert(row.key.clone(), index); &deduplicated.push(row) }
        }
    }
    result := deduplicated
    // GATE #4499: exact checked function IDs collected once.
    checked_ids := [MirFunctionId:Bool]{}
    loop function in functions { if registry.id_for(function).ok() == { Val(id) -> &checked_ids.insert(id, true) None -> {} } }
    &result.retain(fn(row) { row.methods.iter().all(fn(id) { checked_ids.contains_key(id) }) })
    &result.sort_unstable_by_key(fn(row) { row.id })
    result
}

// Rust: crates/jet-codegen/src/Codegen/TIR/mir.rs:2450
fn canonical_impl_key(module: String, owner: MirType, trait_name: String?) -> String {
    qualified_display :: canonical_target_type(module, owner.display_name())
    owner_display :: if module.is_empty() { qualified_display.clone() } else { (qualified_display.strip_prefix("{module}::") ?? qualified_display).to_string() }
    owner :: if owner.canonical_key() == qualified_display { owner_display } else { "{owner_display}__instance__{owner.canonical_key()}" }
    if trait_name == { Val(trait_name) -> if !module.is_empty() { "{module}::{owner}::{trait_name}" } else { "{owner}::{trait_name}" } None -> if !module.is_empty() { "{module}::{owner}" } else { owner } }
}

// Rust: crates/jet-codegen/src/Codegen/TIR/mir.rs:2477
fn same_impl_owner(row: MirType, owner: MirType) -> Bool { row.same_checked_type(owner) }

// Rust: crates/jet-codegen/src/Codegen/TIR/mir.rs:2481
fn find_impl_index(impls: [MirImplDef], owner: MirType, trait_ref: MirTraitRef?, module: MirModuleId) -> USize? {
    impls.iter().enumerate().find_map(fn(pair) {
        (index, row) :: pair
        trait_ok :: if (row.trait_ref, trait_ref) == { (None, None) -> true (Val(existing), Val(wanted)) -> existing.id == wanted.id && existing.name == wanted.name _ -> false }
        if row.module == module && trait_ok && same_impl_owner(row.self_type, owner) { Val(index) } else { None }
    })
}

// Rust: crates/jet-codegen/src/Codegen/TIR/mir.rs:2503
fn attach_orphan_methods(mut impls: [MirImplDef], functions: [MirFunction]) {
    owned := [MirFunctionId:Bool]{} // GATE #4499
    loop row in impls { loop id in row.methods { &owned.insert(id, true) } }
    loop function in functions {
        if owned.contains_key(function.id) { continue }
        &owned.insert(function.id, true)
        (owner, trait_ref) :: if function.form == { TopLevel -> continue Method{owner: owner, ..} -> (owner, None) TraitMethod{serde: Val(_), ..} -> continue TraitMethod{owner: owner, trait_ref: trait_ref, ..} -> (owner, Val(trait_ref)) }
        if find_impl_index(impls, owner, trait_ref, function.module_id) == { Val(index) -> { &impls[index].methods.push(function.id); continue } None -> {} }
        key :: canonical_impl_key(function.module, owner, trait_ref.map(fn(trait_ref) { trait_ref.name }))
        &impls.push(MirImplDef{id: MirImplId(stable_id("mir-impl", key)), module: function.module_id, key: key, span: function.span, self_type: owner.clone(), trait_ref: trait_ref.cloned(), associated_types: [], methods: [function.id], delegation: None, compiler_generated: false, serde: None, operator_rhs: None, operator_marker: None, target_os: None, target_applicability: MirTargetApplicability{rust_aot: true, cranelift: true, interpreter: true, web: true}})
    }
    &impls.sort_unstable_by_key(fn(row) { row.id })
}

// Rust: crates/jet-codegen/src/Codegen/TIR/mir.rs:2563
fn resolve_field_id(types: [MirTypeDef], name: String) -> MirFieldId? {
    types.iter().find_map(fn(ty) {
        if ty.kind == {
            Struct{fields: fields, ..} -> fields.iter().find(fn(field) { field.name == name }).map(fn(field) { field.id })
            Enum{variants: variants, ..} -> variants.iter().find_map(fn(variant) { if variant.payload == { Named(fields) -> fields.iter().find(fn(field) { field.name == name }).map(fn(field) { field.id }) _ -> None } })
            _ -> None
        }
    })
}

// Rust: crates/jet-codegen/src/Codegen/TIR/mir.rs:2582
fn lower_decl_visibility(visibility: TirVisibility) -> MirVisibility { if visibility == { Private -> MirVisibility.Private Package -> MirVisibility.Package Public -> MirVisibility.Public } }

// Rust: crates/jet-codegen/src/Codegen/TIR/mir.rs:2594
fn is_runtime_constant(row: TirConstantDef) -> Bool {
    !(row.is_comptime && row.value == CtValue.Unit) && !(if row.ty == { Named(name) -> name == Syntax.TYPE_OUTPUT || name == Syntax.TYPE_OUTPUT_DEFAULTS _ -> false })
}

// Rust: crates/jet-codegen/src/Codegen/TIR/mir.rs:2604
fn lower_constant_rows(rows: [TirConstantDef]) -> [MirConstantDef] {
    result := rows.iter().filter(fn(row) { is_runtime_constant(row) }).filter_map(fn(row) {
        value :: lower_constant_value(row.value) ?? return None
        Val(MirConstantDef{id: MirConstantId(stable_id("mir-constant", row.key)), module: MirModuleId(stable_id("mir-module", row.module)), key: row.key.clone(), name: row.name.clone(), span: row.span, visibility: lower_decl_visibility(row.visibility), ty: lower_type(row.ty), is_storage: row.is_storage, value: value})
    }).collect()
    &result.sort_unstable_by_key(fn(row) { row.id })
    result
}

// Rust: crates/jet-codegen/src/Codegen/TIR/mir.rs:2628
const INLINE_CONSTANT_LEAVES: USize = 8
// Rust: crates/jet-codegen/src/Codegen/TIR/mir.rs:2630
const INLINE_CONSTANT_TEXT_BYTES: USize = 256

// Rust: crates/jet-codegen/src/Codegen/TIR/mir.rs:2638
fn inline_known_constant_reads(mut functions: [MirFunction], rows: [TirConstantDef], constants: [MirConstantDef]) {
    by_key := [String:TirConstantDef]{}
    loop row in rows { &by_key.insert(row.key, row) }
    values := [String:MirConstant]{}
    loop constant in constants {
        if constant.is_storage { continue }
        row :: by_key.get(constant.key) ?? continue
        leaves := 0 as USize
        copied :: !row.addressable && (row.force_inline || inline_constant_fits(constant.value, &leaves))
        if copied { &values.insert(constant.key, constant.value) }
    }
    if values.is_empty() { return }
    loop mut function in functions {
        loop mut block in function.blocks {
            loop mut instruction in block.instructions {
                if instruction.operation == {
                    Global{name: name} -> {
                        value :: values.get(name) ?? continue
                        constant := value.clone()
                        if constant == { Int{width: None, ..} -> { constant.width = instruction.ty.and_then(fn(ty) { ty.fixed_int() }) } _ -> {} }
                        instruction.operation = MirOperation.Constant(constant)
                    }
                    _ -> {}
                }
            }
        }
    }
}

// Rust: crates/jet-codegen/src/Codegen/TIR/mir.rs:2679
fn inline_constant_fits(value: MirConstant, mut leaves: USize) -> Bool {
    if value == {
        Int{..} | Float{..} | Bool(_) | Char(_) | Unit | BigInt(_) -> {}
        String(text) -> { if text.len() > INLINE_CONSTANT_TEXT_BYTES { return false } }
        Struct{fields: fields, ..} -> return fields.iter().all(fn(pair) { inline_constant_fits(pair.1, &leaves) })
        Enum{args: args, ..} -> return args.iter().all(fn(pair) { inline_constant_fits(pair.1, &leaves) })
        Present(inner) -> return inline_constant_fits(inner, &leaves)
        _ -> return false
    }
    leaves += 1
    leaves <= INLINE_CONSTANT_LEAVES
}

// Rust: crates/jet-codegen/src/Codegen/TIR/mir.rs:2703
fn lower_constant_value(value: CtValue) -> MirConstant? {
    Val(if value == {
        Int(value) -> MirConstant.Int{value: value, width: None, spelling: None}
        Float(value) -> MirConstant.Float{value: value.as_f64(), f32: if value == { F32(_) -> true _ -> false }, spelling: None}
        Bool(value) -> MirConstant.Bool(value)
        Char(value) -> MirConstant.Char(value)
        Str(value) -> MirConstant.String(value.clone())
        BigInt(value) -> MirConstant.BigInt(value.to_string_rep())
        Bytes(value) -> MirConstant.Bytes(value.clone())
        List(values) -> {
            out := [MirConstant]{}
            loop value in values { &out.push(lower_constant_value(value) ?? return None) }
            MirConstant.List(out)
        }
        Map(values) -> {
            out := [MirConstKey:MirConstant]{} // GATE #4499: composite constant keys.
            keys := values.keys().collect()
            &keys.sort()
            loop key in keys { &out.insert(lower_const_key(key) ?? return None, lower_constant_value(values[key]) ?? return None) }
            MirConstant.Map(out)
        }
        Struct{type_name: type_name, fields: fields} -> {
            out := [(String, MirConstant)]{}
            loop (name, value) in fields { &out.push((name.clone(), lower_constant_value(value) ?? return None)) }
            MirConstant.Struct{type_name: type_name.clone(), fields: out}
        }
        Enum{type_name: type_name, variant: variant, args: args} -> {
            out := [(String?, MirConstant)]{}
            loop (name, value) in args { &out.push((name.clone(), lower_constant_value(value) ?? return None)) }
            MirConstant.Enum{type_name: type_name.clone(), variant: variant.clone(), args: out}
        }
        Present(value) -> MirConstant.Present(lower_constant_value(value) ?? return None)
        Failed(report) -> MirConstant.Failed(if report == { Clean(ty) -> MirConstReport.Clean(lower_type(ty)) Told(value) -> MirConstReport.Told(lower_constant_value(value) ?? return None) })
        Unit -> MirConstant.Unit
        Closure(_) -> return None
    })
}

// Rust: crates/jet-codegen/src/Codegen/TIR/mir.rs:2763
fn lower_const_key(key: CtKey) -> MirConstKey? {
    Val(if key == {
        Int(value) -> MirConstKey.Int(value)
        Str(value) -> MirConstKey.String(value.clone())
        Bool(value) -> MirConstKey.Bool(value)
        Char(value) -> MirConstKey.Char(value)
        Tuple(fields) -> {
            out := [(String, MirConstKey)]{}
            loop (name, key) in fields { &out.push((name.clone(), lower_const_key(key) ?? return None)) }
            MirConstKey.Tuple(out)
        }
        Struct{type_name: type_name, fields: fields} -> {
            out := [(String, MirConstKey)]{}
            loop (name, key) in fields { &out.push((name.clone(), lower_const_key(key) ?? return None)) }
            MirConstKey.Struct{type_name: type_name.clone(), fields: out}
        }
        Enum{type_name: type_name, variant: variant} -> MirConstKey.Enum{type_name: type_name.clone(), variant: variant.clone()}
    })
}

// Rust: crates/jet-codegen/src/Codegen/TIR/mir.rs:2788
fn lower_job_rows(rows: [TirJobFact], functions: [TFunc], registry: FunctionRegistry, lowered: [MirFunction]) -> [MirJob] {
    result := rows.iter().filter_map(fn(row) {
        function :: row.function.and_then(fn(reference) { resolve_function_ref(reference, functions, registry) }) ?? return None
        inputs :: if row.record_inputs == {
            Val(record) -> loop (ordinal, input) in record.iter().enumerate() -> lower_cli_input(input, ordinal, None)
            None -> {
                params :: lowered.iter().find(fn(candidate) { candidate.id == function }).map(fn(candidate) { candidate.params }) ?? []
                loop (index, argument) in row.arguments.iter().enumerate() -> lower_job_argument(argument, index, params.get(index).map(fn(param) { param.ty.clone() }))
            }
        }
        Val(MirJob{id: MirJobId(stable_id("mir-job", row.key)), function: function, name: row.name.clone(), doc: row.doc.clone(), after: row.after.clone(), parallel: row.parallel,
            scope: if row.scope == { Dev -> MirJobScope.Dev Ship -> MirJobScope.Ship Internal -> MirJobScope.Internal },
            schedule: row.schedule.map(fn(schedule) { if schedule == { Duration{nanos: nanos} -> MirJobSchedule.Duration{nanos: nanos} WallClockTime{hour: hour, minute: minute} -> MirJobSchedule.WallClockTime{hour: hour, minute: minute} } }), inputs: inputs,
            dispatch: if row.schedule.is_some() { MirJobDispatch.Scheduled } else { MirJobDispatch.Direct }, packages: row.packages.clone(), working_directory: row.working_directory.clone(), input_paths: row.input_paths.clone(), output_paths: row.output_paths.clone(),
            skip: row.skip.map(fn(skip) { if skip == { Always(reason) -> MirJobSkip.Always(reason.clone()) UnlessPlatform{platform: platform} -> MirJobSkip.UnlessPlatform(platform.clone()) } }),
            cache: if row.cache == { Uncached -> MirJobCachePolicy.Uncached Local -> MirJobCachePolicy.Local Shared -> MirJobCachePolicy.Shared }, limits: row.limits.clone()})
    }).collect()
    &result.sort_unstable_by_key(fn(row) { row.id })
    result
}

// Rust: crates/jet-codegen/src/Codegen/TIR/mir.rs:2879
fn job_value_kind(ty: Type) -> MirCliValueKind {
    if ty == { Option(inner) -> job_value_kind(inner) Bool -> MirCliValueKind.Bool Int | IntN{..} -> MirCliValueKind.Int Float | Float32 -> MirCliValueKind.Float Named(name) -> if name == Syntax.TYPE_PATH { MirCliValueKind.Path } else { MirCliValueKind.String } _ -> MirCliValueKind.String }
}

// Rust: crates/jet-codegen/src/Codegen/TIR/mir.rs:2894
fn lower_job_argument(argument: TirJobArgument, index: USize, lowered_ty: MirType?) -> MirCliInput {
    flag :: argument.param_ty == Type.Bool && !argument.variadic
    optional :: if argument.param_ty == { Option(_) -> true _ -> false }
    default :: argument.default.filter(fn(_) { !optional }).map(fn(value) { MirCliDefault.Value(MirConstant.String(value.clone())) })
    MirCliInput{parameter: index, name: argument.name.clone(), label: argument.label.clone(), ty: lowered_ty ?? lower_type(argument.param_ty), zone: lower_param_zone(argument.zone), short: None, env: None,
        help: "value for --{argument.name}", metavar: if !flag { Val(argument.name.replace('-', "_").to_uppercase()) } else { None },
        shape: if flag { MirCliInputShape.Flag } else { MirCliInputShape.Value{kind: job_value_kind(argument.param_ty), optional: optional, default: default} },
        positional: if argument.required || argument.variadic { Val(index as U16) } else { None }, variadic: argument.variadic, flag: argument.name.clone()}
}

// Rust: crates/jet-codegen/src/Codegen/TIR/mir.rs:2933
fn lower_test_rows(rows: [TirTestFact], functions: [TFunc], checked_functions: [MirFunction], registry: FunctionRegistry) -> [MirTestCase] LowerError! {
    result := [MirTestCase]{}
    loop row in rows {
        function :: resolve_function_ref(row.function, functions, registry) ?? continue
        checked :: checked_functions.iter().find(fn(candidate) { candidate.id == function }) ?? fail LowerError.new(row.span, "test target has no checked MIR signature")
        parameters := [MirParam].with_capacity(row.parameters.len())
        loop parameter in row.parameters {
            checked_parameter :: checked.params.iter().find(fn(candidate) { candidate.index == parameter.index }) ?? fail LowerError.new(parameter.span, "test parameter has no checked MIR signature slot")
            &parameters.push(MirParam{index: checked_parameter.index, name: parameter.name.clone(), span: parameter.span, ty: checked_parameter.ty.clone(), access: checked_parameter.access, ownership: checked_parameter.ownership, public_label: parameter.label.clone(), variadic: checked_parameter.variadic, default_present: checked_parameter.default_present})
        }
        &result.push(MirTestCase{id: MirTestId(stable_id("mir-test", row.key)), function: function, name: row.name.clone(), span: row.span,
            kind: if row.kind == { Unit -> MirTestKind.Unit Property -> MirTestKind.Property }, parameters: parameters, faults: row.faults.clone(), expected_failure: row.expected_failure, contract_generated: row.contract_generated,
            eligibility: row.eligibility.and_then(fn(reference) { resolve_function_ref(reference, functions, registry) }), generation_unavailable_reason: row.generation_unavailable_reason.clone()})
    }
    &result.sort_unstable_by_key(fn(row) { row.id })
    result
}

// Rust: crates/jet-codegen/src/Codegen/TIR/mir.rs:2985
fn function_block_id(reference: TirFunctionRef, block: String?, functions: [TFunc], registry: FunctionRegistry) -> (MirFunctionId, MirBlockId)? {
    function :: functions.iter().find(fn(function) { function.source_span == reference.span && (function.key == reference.key || (function.module == reference.module && function.name == reference.name)) }) ?? return None
    function_id :: registry.id_for(function).ok() ?? return None
    role :: block ?? "entry"
    identity :: construct_identity(function, "block", reference.span, role, "")
    Val((function_id, MirBlockId(stable_id("mir-block", identity))))
}

// Rust: crates/jet-codegen/src/Codegen/TIR/mir.rs:3002
fn lower_harness_rows(rows: [TirHarnessPlan], test_rows: [TirTestFact], tests: [MirTestCase], functions: [TFunc], registry: FunctionRegistry) -> [MirHarnessPlan] {
    test_ids := [String:MirTestId]{}
    loop row in test_rows {
        id :: MirTestId(stable_id("mir-test", row.key))
        if tests.iter().any(fn(test) { test.id == id }) { &test_ids.insert(row.key.clone(), id) }
    }
    result := loop row in rows -> {
        output_checks :: row.output_checks.iter().filter_map(fn(check) {
            function :: resolve_function_ref(check.function, functions, registry) ?? return None
            Val(MirOutputCheck{id: MirOutputCheckId(stable_id("mir-output-check", check.key)), name: check.name.clone(), function: function})
        }).collect()
        coverage_points :: row.coverage_points.iter().filter_map(fn(point) {
            (function, block) :: function_block_id(point.function, point.block, functions, registry) ?? return None
            Val(MirCoveragePoint{id: MirCoveragePointId(stable_id("mir-coverage", point.key)), function: function, block: block, span: point.span})
        }).collect()
        MirHarnessPlan{id: MirHarnessId(stable_id("mir-harness", row.key)), kind: if row.kind == { Test -> MirHarnessKind.Test Fuzz -> MirHarnessKind.Fuzz Coverage -> MirHarnessKind.Coverage },
            tests: row.tests.iter().filter_map(fn(key) { test_ids.get(key).copied() }).collect(), output_checks: output_checks, selected_test: row.selected_test.and_then(fn(key) { test_ids.get(key).copied() }), coverage_points: coverage_points, command_override: row.command_override}
    }
    &result.retain(fn(row) { !row.tests.is_empty() || !row.output_checks.is_empty() || !row.coverage_points.is_empty() })
    &result.sort_unstable_by_key(fn(row) { row.id })
    result
}

