            self_access: method.self_access.map(fn(access) { mir_access(access) }), params: loop param in method.params -> param.to_mir(), declared_return: method.declared_return.map(fn(ty) { lower_type(ty) }), return_type: lower_type(method.return_type), failure: lower_failure_carrier_types(method.failure), effects: lower_effects(method.declared_effects), is_pure: method.is_pure,
            return_view_provenance: method.return_view_provenance.map(fn(value) { lower_view_provenance(value) }), declared_return_view_provenance: None,
            default: method.default_function_key.and_then(fn(key) { resolve_function_name_at(key, row.module, method.span, functions, registry).or_else(fn() { resolve_function_key(key, row.module, registry) }) })}}
