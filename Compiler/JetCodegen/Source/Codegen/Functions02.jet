        }
    }
    MirCliInput{parameter: parameter.map(fn(param) { param.index }) ?? ordinal, name: input.field.clone(), label: parameter.map(fn(param) { param.label.clone() }) ?? input.field.clone(), ty: ty,
        zone: parameter.map(fn(param) { lower_param_zone(param.zone) }) ?? MirParamZone.Either, short: input.short.clone(), env: input.env.clone(), help: input.help.clone(), metavar: input.metavar.clone(),
        shape: if input.shape == { Flag -> MirCliInputShape.Flag Value{..} -> MirCliInputShape.Value{kind: kind, optional: optional, default: mir_default} }, positional: input.positional, variadic: input.variadic, flag: input.flag.clone()}
}

// Rust: crates/jet-codegen/src/Codegen/TIR/mir.rs:3167
fn cli_parameter(input: TirCliInput, ordinal: USize, function: TirFunctionRef?, facts: TirArtifactFacts) -> TirParamFact? {
    function :: function ?? return None
    function :: facts.functions.iter().find(fn(candidate) { candidate.reference.key == function.key && candidate.reference.span == function.span }) ?? return None
    function.params.iter().find(fn(param) { param.name == input.field || param.label == input.field }).or_else(fn() { function.params.get(ordinal) })
}

// Rust: crates/jet-codegen/src/Codegen/TIR/mir.rs:3184
fn lower_cli_entry(entry: TirCliEntry, function: TirFunctionRef?, facts: TirArtifactFacts, functions: [TFunc], registry: FunctionRegistry) -> MirCliEntry {
    inputs :: loop (ordinal, input) in entry.inputs.iter().enumerate() -> lower_cli_input(input, ordinal, if entry.record_inputs { None } else { cli_parameter(input, ordinal, function, facts) })
    commands :: entry.commands.iter().filter_map(fn(command) {
        function :: command.function.and_then(fn(reference) { resolve_function_ref(reference, functions, registry) }) ?? return None
        Val(MirCliCommand{name: command.name.clone(), description: command.description.clone(), function: function, receiver: command.receiver.map(fn(receiver) { MirTypeId(stable_id("mir-type", receiver)) }),
            inputs: loop (ordinal, input) in command.inputs.iter().enumerate() -> lower_cli_input(input, ordinal, cli_parameter(input, ordinal, command.function, facts))})
    }).collect()
    MirCliEntry{record_inputs: entry.record_inputs, description: entry.description.clone(), inputs: inputs, commands: commands, standard: entry.standard, version: entry.version.clone()}
}

// Rust: crates/jet-codegen/src/Codegen/TIR/mir.rs:3248
fn lower_entry_spec(spec: TirEntrySpec, facts: TirArtifactFacts, functions: [TFunc], registry: FunctionRegistry) -> MirEntrySpec {
    MirEntrySpec{kind: if spec.kind == { Library -> MirEntryKind.Library Command -> MirEntryKind.Command App -> MirEntryKind.App Service -> MirEntryKind.Service Test -> MirEntryKind.Test },
        function: spec.function.and_then(fn(reference) { registry.resolve_entry(reference.key, reference.span).ok() }), cli: spec.cli.map(fn(entry) { lower_cli_entry(entry, spec.function, facts, functions, registry) }),
        output: if spec.output == { None -> MirEntryOutput.None ReturnValue -> MirEntryOutput.ReturnValue }, initialize_environment: spec.initialize_environment, initialize_gc: spec.initialize_gc, serves_until_stopped: spec.serves_until_stopped, package_version: spec.package_version.clone()}
}

// Rust: crates/jet-codegen/src/Codegen/TIR/mir.rs:3284
fn lower_artifact_rows(facts: TirArtifactFacts, functions: [TFunc], registry: FunctionRegistry) -> [MirArtifactPlan] {
    result := loop row in facts.artifacts -> {
        parts := runtime_parts_for_used_core(row.runtime_parts)
        loop key in row.runtime_parts { if parse_runtime_part(key) == { Val(part) -> &parts.insert(part) None -> {} } }
        MirArtifactPlan{id: MirArtifactId(stable_id("mir-artifact", row.key)), kind: row.kind, name: row.name.clone(), target: row.target, mode: facts.build_mode,
            modules: loop key in row.modules -> MirModuleId(stable_id("mir-module", key)), links: loop key in row.links -> MirLinkUnitId(stable_id("mir-link", key)), jobs: loop key in row.jobs -> MirJobId(stable_id("mir-job", key)), runtime_parts: parts,
            exports: row.exports.iter().filter_map(fn(export) {
                function :: resolve_function_ref(export.function, functions, registry) ?? return None
