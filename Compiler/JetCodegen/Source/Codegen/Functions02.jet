//RS         .iter()
//RS         .map(|row| (row.key.as_str(), row))
//RS         .collect::<HashMap<_, _>>();
//RS     let values = constants
//RS         .iter()
//RS         .filter(|constant| !constant.is_storage)
//RS         .filter_map(|constant| {
//RS             let row = rows.get(constant.key.as_str())?;
//RS             let copied = !row.addressable
//RS                 && (row.force_inline || inline_constant_fits(&constant.value, &mut 0));
//RS             copied.then_some((constant.key.as_str(), &constant.value))
//RS         })
//RS         .collect::<HashMap<_, _>>();
//RS     if values.is_empty() {
//RS         return;
//RS     }
//RS     for function in functions {
//RS         for block in &mut function.blocks {
//RS             for instruction in &mut block.instructions {
//RS                 let MirOperation::Global { name } = &instruction.operation else {
//RS                     continue;
//RS                 };
//RS                 if let Some(value) = values.get(name.as_str()) {
//RS                     // A sized-integer read keeps its width, as a literal does.
//RS                     let mut constant = (*value).clone();
//RS                     if let MirConstant::Int { width: width @ None, .. } = &mut constant {
//RS                         *width = instruction.ty.as_ref().and_then(MirType::fixed_int);
//RS                     }
//RS                     instruction.operation = MirOperation::Constant(constant);
//RS                 }
//RS             }
//RS         }
//RS     }
//RS }
