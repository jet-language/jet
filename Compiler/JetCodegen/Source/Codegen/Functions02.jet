fn cli_value_kind(kind: CLIValueKind) -> MirCliValueKind { if kind == { Bool -> MirCliValueKind.Bool Int -> MirCliValueKind.Int Float -> MirCliValueKind.Float String -> MirCliValueKind.String Path -> MirCliValueKind.Path } }

// Rust: crates/jet-codegen/src/Codegen/TIR/mir.rs:3097
fn lower_cli_default(default: TirCliDefault) -> MirCliDefault? {
    Val(if default == { TypeDefault -> MirCliDefault.TypeDefault Value(value) -> MirCliDefault.Value(lower_constant_value(value) ?? return None) Recorded(value) -> MirCliDefault.Value(MirConstant.String(value.clone())) })
