// Rust: crates/jet-codegen/src/Codegen/TIR/mir.rs:1923
fn lower_target_applicability(applicability: TirTargetApplicability) -> MirTargetApplicability { applicability }

// Rust: crates/jet-codegen/src/Codegen/TIR/mir.rs:1929
fn lower_foreign_abi(abi: String) -> MirForeignAbi {
    key := abi.to_ascii_lowercase()
    if key == { "c" -> MirForeignAbi.C "c-unwind" | "cunwind" -> MirForeignAbi.CUnwind "system" -> MirForeignAbi.System "stdcall" -> MirForeignAbi.Stdcall "fastcall" -> MirForeignAbi.Fastcall "vectorcall" -> MirForeignAbi.Vectorcall "rust" -> MirForeignAbi.Rust _ -> MirForeignAbi.Platform(abi.to_string()) }
}

// Rust: crates/jet-codegen/src/Codegen/TIR/mir.rs:1942
fn lower_foreign_language(language: String) -> MirForeignLanguage {
    key := (language.split(':').next() ?? language).to_ascii_lowercase()
    if key == { "c" -> MirForeignLanguage.C "cpp" | "c++" -> MirForeignLanguage.Cpp "asm" | "assembly" -> MirForeignLanguage.Assembly _ -> MirForeignLanguage.Rust }
}

// Rust: crates/jet-codegen/src/Codegen/TIR/mir.rs:1957
fn lower_artifact_param(param: TirParamFact) -> MirParam {
    access :: if param.access == { Read -> MirAccess.Read Write -> MirAccess.Write Move -> MirAccess.Move }
    MirParam{index: param.index, name: param.name.clone(), span: param.span, ty: lower_type(param.ty), access: access, ownership: MirOwnership.from_access(access), public_label: param.label.clone(), variadic: false, default_present: false}
