// Rust: crates/jet-codegen/src/Codegen/TIR/mir.rs:1980
fn never_carrier_success(ty: Type) -> Type? {
    if ty.without_user_tags() == { Result{ok: ok, err: err} -> if err.is_never() { Val(ok) } else { None } _ -> None }
}

// Rust: crates/jet-codegen/src/Codegen/TIR/mir.rs:1990
fn is_result_carrier(ty: Type) -> Bool { if ty.without_user_tags() == { Result{..} -> true _ -> false } }

// Rust: crates/jet-codegen/src/Codegen/TIR/mir.rs:1995
fn is_plain_return(ty: Type) -> Bool { !(if ty.without_user_tags() == { Result{..} | Option(_) -> true _ -> false }) && !ty.is_never() }

// Rust: crates/jet-codegen/src/Codegen/TIR/mir.rs:2008
fn is_plain_call_return(returned: Type, checked: Type) -> Bool {
    if is_plain_return(returned) { return is_result_carrier(checked) }
    (if returned.without_user_tags() == { Option(_) -> true _ -> false }) && never_carrier_success(checked).is_some_and(fn(success) { success.without_user_tags() == returned.without_user_tags() })
}

// Rust: crates/jet-codegen/src/Codegen/TIR/mir.rs:2020
fn fn_value_carrier_adaptation(source: Type, slot: Type) -> ([Type], Type, Type)? {
    if (source.without_user_tags(), slot.without_user_tags()) == {
        (Type.Fn{params: source_params, ret: Val(source_ret), ..}, Type.Fn{params: slot_params, ret: Val(slot_ret), ..}) -> {
            if source_params.len() != slot_params.len() || !(if slot_ret == { Result{..} -> true _ -> false }) || (if source_ret == { Result{..} | Option(_) -> true Named(name) -> name == Syntax.TYPE_NEVER _ -> false }) { return None }
            effective_ret :: if source.without_user_tags().with_effective_fn_returns() == { Fn{ret: Val(ret), ..} -> ret _ -> return None }
            if effective_ret == slot_ret { Val((slot_params.clone(), source_ret.clone(), slot_ret.clone())) } else { None }
        }
        _ -> None
    }
}

// Rust: crates/jet-codegen/src/Codegen/TIR/mir.rs:2059
fn lower_failure_carrier_types(carrier: TFailureCarrier) -> MirFailureCarrier {
    if carrier == { Infallible -> MirFailureCarrier.Infallible Result{success: success, error: error} -> MirFailureCarrier.Result{success: lower_type(success), error: lower_type(error)} Optional{value: value} -> MirFailureCarrier.Optional{value: lower_type(value)} Diverges{value: value} -> MirFailureCarrier.Diverges{value: lower_type(value)} }
}

