fn lower_foreign_rows(rows: [TirForeignFact], _functions: [TFunc], registry: FunctionRegistry) -> [MirForeign] {
    result := loop row in rows -> {
        module_id :: MirModuleId(stable_id("mir-module", row.module))
        effects := MirEffectFacts.default()
        if row.effect_root == { Val(root) -> { &effects.direct.insert(root.clone()); &effects.solved.insert(root.clone()); &effects.direct_spans.insert(root.clone(), row.span) } None -> {} }
        MirForeign{id: MirForeignId(stable_id("mir-foreign", row.key)), module_id: module_id, key: row.key.clone(), module: row.module.clone(), name: row.name.clone(), span: row.span,
            symbol: row.symbol.clone(), path: row.path.clone(), params: loop param in row.params -> lower_artifact_param(param), bridge_eligible: row.bridge_eligible, raw_scalar_abi: row.raw_scalar_abi,
            return_type: row.return_type.map(fn(ty) { lower_type(ty) }), foreign_abi: lower_foreign_abi(row.abi), foreign_language: lower_foreign_language(row.language), target_applicability: lower_target_applicability(row.applicability),
            effects: effects, callback_transport: row.callback_transport.clone(), callback_plan_digest: row.callback_plan_digest.clone(), callback_identity: row.callback_identity.clone(),
            link: row.link_key.map(fn(key) { MirLinkUnitId(stable_id("mir-link", key)) }), callback: row.callback_key.map(fn(key) { MirCallbackId(stable_id("mir-callback", key)) }),
            handle: row.handle_key.map(fn(key) { MirHandleId(stable_id("mir-handle", key)) }), close_function: row.close_function_key.and_then(fn(key) { resolve_function_key(key, row.module, registry) }),
            undo_function: row.undo_function_key.and_then(fn(key) { resolve_function_key(key, row.module, registry) }), close_foreign: None}
    }
    &result.sort_unstable_by_key(fn(row) { row.id })
