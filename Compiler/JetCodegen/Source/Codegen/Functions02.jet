//RS /// Resolve the source-facing target of an unqualified import to the same
//RS /// canonical key used by its `TirModuleFact` row.
//RS ///
//RS /// File-module imports carry only their checked alias when the import itself
//RS /// is unqualified, while inline modules are represented as children of the
//RS /// importing module. Prefer an exact canonical key, then the importing
//RS /// module's child path, and finally a unique module name. An ambiguous name
//RS /// remains unchanged rather than guessing a target.
//RS fn canonical_module_key(modules: &[TirModuleFact], owner: &str, target: &str) -> String {
//RS     if target.is_empty() {
//RS         return target.to_string();
//RS     }
//RS     if modules.iter().any(|row| row.key == target) {
//RS         return target.to_string();
//RS     }
//RS 
//RS     let qualified = target
//RS         .split('.')
//RS         .fold(owner.to_string(), |mut key, segment| {
//RS             if !segment.is_empty() {
//RS                 if !key.is_empty() {
//RS                     key.push_str("::");
//RS                 }
//RS                 key.push_str(segment);
//RS             }
//RS             key
//RS         });
//RS     if modules.iter().any(|row| row.key == qualified) {
//RS         return qualified;
//RS     }
//RS 
//RS     let mut matches = modules.iter().filter(|row| row.name == target);
//RS     match (matches.next(), matches.next()) {
//RS         (Some(row), None) => row.key.clone(),
//RS         _ => target.to_string(),
//RS     }
//RS }
//RS 
