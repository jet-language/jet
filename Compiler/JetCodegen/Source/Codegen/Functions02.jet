    result := loop row in rows -> MirTraitDef{id: MirTraitId(stable_id("mir-trait", row.key)), module: MirModuleId(stable_id("mir-module", row.module)), key: row.key.clone(), name: row.name.clone(), span: row.span, visibility: lower_decl_visibility(row.visibility),
