//RS         }
//RS         MirConstant::Present(inner) => return inline_constant_fits(inner, leaves),
//RS         _ => return false,
//RS     }
//RS     *leaves += 1;
//RS     *leaves <= INLINE_CONSTANT_LEAVES
//RS }
