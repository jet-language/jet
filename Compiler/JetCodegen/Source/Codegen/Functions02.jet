// Rust: crates/jet-codegen/src/Codegen/TIR/mir.rs:3353
fn lower_module_item(item: TirItemRef, types: [MirTypeDef], traits: [MirTraitDef], impls: [MirImplDef], constants: [MirConstantDef], foreign: [MirForeign], functions: [TFunc], registry: FunctionRegistry, module: String) -> MirItemRef? {
    if item == {
        Type(key) -> types.iter().find(fn(row) { row.key == key }).map(fn(row) { MirItemRef.Type(row.id) })
        Trait(key) -> traits.iter().find(fn(row) { row.key == key }).map(fn(row) { MirItemRef.Trait(row.id) })
        Function(key) -> resolve_function_key(key, module, registry).map(fn(id) { MirItemRef.Function(id) })
        Constant(key) -> constants.iter().find(fn(row) { row.key == key }).map(fn(row) { MirItemRef.Constant(row.id) })
        Impl(key) -> impls.iter().find(fn(row) { row.key == key }).map(fn(row) { MirItemRef.Impl(row.id) })
        Foreign(key) -> foreign.iter().find(fn(row) { row.key == key }).map(fn(row) { MirItemRef.Foreign(row.id) })
        Unknown(key) -> {
            types.iter().find(fn(row) { row.key == key }).map(fn(row) { MirItemRef.Type(row.id) })
                .or_else(fn() { traits.iter().find(fn(row) { row.key == key }).map(fn(row) { MirItemRef.Trait(row.id) }) })
                .or_else(fn() { constants.iter().find(fn(row) { row.key == key }).map(fn(row) { MirItemRef.Constant(row.id) }) })
                .or_else(fn() { impls.iter().find(fn(row) { row.key == key }).map(fn(row) { MirItemRef.Impl(row.id) }) })
                .or_else(fn() { foreign.iter().find(fn(row) { row.key == key }).map(fn(row) { MirItemRef.Foreign(row.id) }) })
                .or_else(fn() { resolve_function_key(key, module, registry).map(fn(id) { MirItemRef.Function(id) }) })
                .or_else(fn() { functions.iter().find(fn(function) { function.key == key }).and_then(fn(function) { registry.id_for(function).ok() }).map(fn(id) { MirItemRef.Function(id) }) })
        }
        Module(_) -> None
    }
}

// Rust: crates/jet-codegen/src/Codegen/TIR/mir.rs:3437
fn canonical_module_key(modules: [TirModuleFact], owner: String, target: String) -> String {
    if target.is_empty() || modules.iter().any(fn(row) { row.key == target }) { return target.to_string() }
    qualified := owner.to_string()
    loop segment in target.split('.') {
        if !segment.is_empty() { if !qualified.is_empty() { &qualified.push_str("::") }; &qualified.push_str(segment) }
    }
    if modules.iter().any(fn(row) { row.key == qualified }) { return qualified }
    matches := modules.iter().filter(fn(row) { row.name == target })
    if (&matches.next(), &matches.next()) == { (Val(row), None) -> row.key.clone() _ -> target.to_string() }
}

// Rust: crates/jet-codegen/src/Codegen/TIR/mir.rs:3467
fn lower_import_item(item: TirImportItem, target_alias: String, target_module: String, types: [MirTypeDef], traits: [MirTraitDef], impls: [MirImplDef], constants: [MirConstantDef], foreign: [MirForeign], functions: [TFunc], registry: FunctionRegistry) -> MirItemRef? {
    resolved :: lower_module_item(item.item, types, traits, impls, constants, foreign, functions, registry, target_module)
    if resolved.is_some() { return resolved }
    raw :: if item.item == { Unknown(raw) -> raw _ -> return None }
    suffix := raw.strip_prefix(target_alias).and_then(fn(rest) { rest.strip_prefix("::").or_else(fn() { rest.strip_prefix('.') }) }).filter(fn(suffix) { !suffix.is_empty() })
        .or_else(fn() { raw.rsplit_once('.').map(fn(pair) { pair.1 }) }).or_else(fn() { raw.rsplit_once("::").map(fn(pair) { pair.1 }) }) ?? item.original
    canonical :: "{target_module}::{suffix}"
    lower_module_item(TirItemRef.Unknown(canonical), types, traits, impls, constants, foreign, functions, registry, target_module)
}

// Rust: crates/jet-codegen/src/Codegen/TIR/mir.rs:3518
fn lower_module_rows(modules: [TirModuleFact], import_rows: [TirImportFact], types: [MirTypeDef], traits: [MirTraitDef], impls: [MirImplDef], constants: [MirConstantDef], foreign: [MirForeign], _links: [MirLinkUnit], _jobs: [MirJob], functions: [TFunc], registry: FunctionRegistry, _source_files: [MirSourceFile]) -> ([MirModule], [MirImport]) {
    imports := loop (ordinal, row) in import_rows.iter().enumerate() -> {
        id :: MirImportId(stable_id("mir-import", "{row.module}|{row.alias}|{row.span.start}..{row.span.end}|{ordinal}"))
        kind :: if row.kind == {
            File{path: path} -> MirImportKind.File{path: path.clone()}
            Module{path: path} -> MirImportKind.Module{path: path.clone()}
            Unqualified{module: module, items: items} -> {
                module_key :: canonical_module_key(modules, row.module, module)
                MirImportKind.Unqualified{module: MirModuleId(stable_id("mir-module", module_key)), items: items.iter().filter_map(fn(item) {
                    resolved :: lower_import_item(item, module, module_key, types, traits, impls, constants, foreign, functions, registry) ?? return None
                    Val(MirImportItem{original: item.original.clone(), local: item.local.clone(), item: resolved})
                }).collect()}
            }
        }
        MirImport{id: id, module: MirModuleId(stable_id("mir-module", row.module)), visibility: lower_name_visibility(row.visibility), alias: row.alias.clone(), kind: kind, span: row.span, version: row.version.clone()}
    }
    &imports.sort_unstable_by_key(fn(row) { row.id })
    module_rows := loop row in modules -> {
        module_id :: MirModuleId(stable_id("mir-module", row.key))
        module_imports :: imports.iter().filter(fn(import) { import.module == module_id }).map(fn(import) { import.id }).collect()
        item_order :: row.item_order.iter().filter_map(fn(item) { lower_module_item(item, types, traits, impls, constants, foreign, functions, registry, row.key) }).collect()
        MirModule{id: module_id, key: row.key.clone(), name: row.name.clone(), path: row.path.clone(), source_file: MirSourceFileId(stable_id("mir-source-file", row.source_path)), imports: module_imports,
            children: row.item_order.iter().filter_map(fn(item) { if item == { Module(key) -> Val(MirModuleId(stable_id("mir-module", key))) _ -> None } }).collect(), item_order: item_order}
    }
    &module_rows.sort_unstable_by_key(fn(row) { row.id })
    (module_rows, imports)
}
