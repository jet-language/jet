            }).collect(), provider_identity: row.provider_identity.clone(), closure_identity: row.closure_identity.clone(), artifact_identity: row.artifact_identity.clone(),
            entry: row.entry.or(facts.entry).map(fn(entry) { lower_entry_spec(entry, facts, functions, registry) }), harness: row.harness.map(fn(key) { MirHarnessId(stable_id("mir-harness", key)) })}
