// Rust: crates/jet-codegen/src/Codegen/TIR/mir.rs:2146
fn synthesized_trait_associated_types(name: String) -> [MirAssociatedTypeDecl] {
    leaf := name.rsplit("::").next() ?? name
    names :: if leaf == { Syntax.TRAIT_ITERATOR -> ["Item"] Syntax.TRAIT_ITERABLE -> ["Iter"] Syntax.TRAIT_INDEX -> ["Key", "Value"] Syntax.TRAIT_ROLLBACK -> ["Snapshot"] _ -> [] }
    loop name in names -> MirAssociatedTypeDecl{name: name.to_string(), span: Span.new(0, 0)}
}

// Rust: crates/jet-codegen/src/Codegen/TIR/mir.rs:2163
fn ensure_referenced_traits(mut traits: [MirTraitDef], impls: [MirImplDef], functions: [MirFunction], types: [MirTypeDef]) {
    // GATE #4499: exact MirTraitId key identity; no linear substitute.
    known := [MirTraitId:Bool]{}
    loop row in traits { &known.insert(row.id, true) }
    needed := [MirTraitRef]{}
    take :: fn(trait_ref: MirTraitRef, mut known: [MirTraitId:Bool], mut needed: [MirTraitRef]) {
        if !known.contains_key(trait_ref.id) { &known.insert(trait_ref.id, true); &needed.push(trait_ref.clone()) }
    }
    loop implementation in impls { if implementation.trait_ref == { Val(trait_ref) -> take(trait_ref, &known, &needed) None -> {} } }
    loop function in functions {
        if function.form == { TraitMethod{trait_ref: trait_ref, ..} -> take(trait_ref, &known, &needed) _ -> {} }
        loop generic in function.generic_params { loop bound in generic.bounds { take(bound, &known, &needed) } }
    }
    loop ty in types {
        loop derive in ty.derives {
            if !known.contains_key(derive) { &known.insert(derive, true); &needed.push(MirTraitRef{id: derive, name: "derive#{derive.0}"}) }
        }
        loop generic in ty.generic_params { loop bound in generic.bounds { take(bound, &known, &needed) } }
    }
    if needed.is_empty() { return }
    module :: traits.first().map(fn(row) { row.module }).or_else(fn() { impls.first().map(fn(row) { row.module }) }).or_else(fn() { functions.first().map(fn(row) { row.module_id }) }) ?? MirModuleId(stable_id("mir-module", "compiler"))
    loop trait_ref in needed {
        &traits.push(MirTraitDef{id: trait_ref.id, module: module, key: trait_ref.name.clone(), name: trait_ref.name.clone(), span: Span.new(0, 0), visibility: MirVisibility.Public, associated_types: synthesized_trait_associated_types(trait_ref.name), methods: []})
    }
    &traits.sort_unstable_by_key(fn(row) { row.id })
}

