// Rust: crates/jet-codegen/src/Codegen/TIR/mir.rs:3107
fn lower_cli_input(input: TirCliInput, ordinal: USize, parameter: TirParamFact?) -> MirCliInput {
    (kind, optional, mir_default) :: if input.shape == { Flag -> (MirCliValueKind.Bool, false, None) Value{kind: kind, optional: optional, default: default} -> (cli_value_kind(kind), optional, default.and_then(fn(default) { lower_cli_default(default) })) }
    ty :: if parameter == {
        Val(param) -> lower_type(param.ty)
