// Rust: crates/jet-codegen/src/Codegen/TIR/mir.rs:1815
fn append_core_process_handle_rows(mut handles: [MirHandleLifecycle], prelude_calls: [MirPreludeCall]) {
    needs_child :: prelude_calls.iter().any(fn(row) { row.module == "core.handle" && (row.member == "process.spec.spawn" || row.member.starts_with("process.child.")) })
    needs_stdin :: prelude_calls.iter().any(fn(row) { row.module == "core.handle" && row.member.starts_with("process.stdin_") })
    loop (needed, typedef_name, close) in [(needs_child, "ProcessChild", "process.child.close"), (needs_stdin, "ProcessStdin", "process.stdin_close")] {
        if !needed || handles.iter().any(fn(row) { row.payload.library == "core.process" && row.payload.typedef_name == typedef_name }) { continue }
        key :: "core::core.process::{typedef_name}"
        &handles.push(MirHandleLifecycle{id: MirHandleId(stable_id("mir-handle", key)), ty: lower_type(Type.Named(typedef_name.to_string())), ownership: MirHandleOwnership.Owned,
            payload: MirHandlePayload{library: "core.process", typedef_name: typedef_name.to_string(), close: close.to_string()}, close: None, close_foreign: None, undo: None,
            send: false, sync: false, close_source: None, thread_safety: None})
    }
    &handles.sort_unstable_by_key(fn(row) { row.id })
}

