fn lower_local_value(ctx: &LowerCtx, local: TLocal, ty: Type) -> MirValueId LowerError! {
    place :: lower_local_place(&ctx, local, MirAccess.Read)?
    value_ty :: if ty == Type.String && ctx.place_is_string_view(place) -> Type.Apply("View", [Type]{Type.Named("str")}) else -> ty
    value :: ctx.emit("local.read", Val(value_ty), MirOperation.ReadPlace(place))?
