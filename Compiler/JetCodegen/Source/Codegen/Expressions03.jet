// Rust: crates/jet-codegen/src/Codegen/TIR/tir_to_mir_expr.rs:936
fn reads_container_element(expr: TExpr) -> Bool Never! {
    current := expr
    loop {
        if current.kind == {
            .IndexRead(..) | .PoolSlot(..) -> return true
            .Field(recv, _) -> current = recv
            else -> return false
        }
    }
}
// Rust: crates/jet-codegen/src/Codegen/TIR/tir_to_mir_expr.rs:947
pub fn lower_receiver_place(ctx: &LowerCtx, expr: TExpr, access: MirAccess) -> MirPlaceId? LowerError! {
    if expr.kind == {
        .Borrow(place, _) -> {
            value :: ctx.lower_child(expr)?
            id :: ctx.place_id("temporary", "{value.0}")?
            span :: ctx.span()
            ty :: ctx.mir_type(expr.ty)?
            &ctx.places.push(MirPlace{id: id, span: span, ty: ty, base: MirPlaceBase.Temporary(value), projections: [], access: access, persist_key: None})
            Val(ctx.project_deref_place(id, place.ty, ctx.span())?)
        }
        .Local(local) if access == MirAccess.Move && ctx.local_is_read_alias(local) -> None
        .Local(local) -> Val(lower_local_place(&ctx, local, access)?)
        .IndexRead(..) | .PoolSlot(..) if access == MirAccess.Move -> None
        .IndexRead(base, index, is_map, uninit_fixed, _) -> {
            kind :: if is_map -> MirIndexKind.Map else if uninit_fixed -> MirIndexKind.FixedListProof else -> MirIndexKind.List
            Val(ctx.lower_index_place(base, index, kind, access)?)
        }
        .Field(recv, field) -> {
            base := lower_receiver_place(&ctx, recv, access)? ?? return None
            if pin_inner_type(recv.ty) == .Val(inner) {
                if recv.kind != .Borrow(..) -> base = ctx.project_deref_place(base, inner, ctx.span())?
            }
            Val(ctx.project_field_place(base, field.name, expr.ty, ctx.span())?)
        }
        .SharedGuardValue(guard, _) -> {
            projected :: lower_receiver_place(&ctx, guard, access)?
            base :: if projected == .Val(base) -> base else {
                value :: ctx.lower_child(guard)?
                id :: ctx.place_id("temporary.shared-guard", "{value.0}")?
                span :: ctx.span()
                ty :: ctx.mir_type(guard.ty)?
                &ctx.places.push(MirPlace{id: id, span: span, ty: ty, base: MirPlaceBase.Temporary(value), projections: [], access: access, persist_key: None})
                id
            }
            Val(ctx.project_deref_place(base, expr.ty, ctx.span())?)
        }
        .PoolSlot(pool, id, _, field, ..) -> {
            base :: ctx.lower_index_place(pool, id, MirIndexKind.Pool, access)?
            if field == { .Val(field) -> Val(ctx.project_field_place(base, field, expr.ty, ctx.span())?) else -> Val(base) }
        }
        .BuiltinMethod(recv, .ViewMutNew(line), args) if access == MirAccess.Write && (if recv.ty.without_user_tags() == { .List(_) -> true else -> false }) -> {
            base :: lower_receiver_place(&ctx, recv, access)? ?? return None
            range :: if args.len() == 1 -> ctx.lower_child(args[0])? else if args.len() == 2 {
                // Canonical Range retains the same start/end/inclusive fields.
                range :: TExpr{ty: Type.Named("Range"), kind: TExprKind.Range{start: args[0], end: args[1], exclusive: false}, span: ctx.span(), integer_bounds: None, cost: None}
                ctx.lower_child(range)?
            } else -> return Err(ctx.error(ctx.span(), "checked range window has no bounds"))
            Val(ctx.project_range_place(base, range, line, ctx.span())?)
        }
        else -> None
    }
}
// Rust: crates/jet-codegen/src/Codegen/TIR/tir_to_mir_expr.rs:1093
fn lower_builtin_receiver(ctx: &LowerCtx, recv: TExpr, mutating: Bool) -> (MirValueId, MirPlaceId?) LowerError! {
    if !mutating {
        if Collections.is_iter_type(recv.ty) {
            if lower_receiver_place(&ctx, recv, MirAccess.Move)? == .Val(place) {
                receiver :: ctx.emit("builtin-owned-receiver", Val(recv.ty), MirOperation.MovePlace{place: place})?
                return (receiver, None)
            }
        }
        return (ctx.lower_child(recv)?, None)
    }
    place :: lower_receiver_place(&ctx, recv, MirAccess.Write)? ?? return (ctx.lower_child(recv)?, None)
    if (if recv.kind == { .IndexRead(..) | .Field(..) -> true else -> false })
        && (if recv.ty.without_user_tags() == { .List(_) | .Map(..) -> true else -> false }) {
        receiver :: ctx.emit("builtin-collection-value-receiver", Val(recv.ty), MirOperation.ReadPlace(place))?
        return (receiver, Val(place))
    }
    receiver :: ctx.emit("builtin-mutating-receiver", Val(recv.ty), MirOperation.AddressOf{place: place, access: MirAccess.Write})?
    (receiver, Val(place))
}
