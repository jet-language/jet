// Equivalent tag-only recursion is already canonical in Expressions.jet:5088.
// This scope uses jet_codegen_unwrap_pattern_tags directly, not a second untagged_type.
use jet_codegen.Codegen.Expressions.[jet_codegen_unwrap_pattern_tags]

// Rust: crates/jet-codegen/src/Codegen/TIR/tir_to_mir_expr.rs:1153
fn lower_list_min_max(ctx: &LowerCtx, expr: TExpr, recv: TExpr, op: TBuiltinOp, args: [TExpr], carrier: TFailureCarrier) -> MirValueId LowerError! {
    if !args.is_empty() -> return Err(ctx.error(ctx.span(), "checked List.min_max operation received unexpected arguments"))
    inner :: if jet_codegen_unwrap_pattern_tags(expr.ty) == { .Option(inner) -> inner else -> return Err(ctx.error(ctx.span(), "checked List.min_max result is not optional")) }
    tuple_ty :: jet_codegen_unwrap_pattern_tags(inner)
    fields :: if tuple_ty == { .Tuple(fields) -> fields else -> return Err(ctx.error(ctx.span(), "checked List.min_max result has no named tuple fields")) }
    if fields.len() != 2 || !fields.any(fn(field) { field.name == "min" }) || !fields.any(fn(field) { field.name == "max" }) -> return Err(ctx.error(ctx.span(), "checked List.min_max result must contain exactly min and max fields"))
    aggregate_fields :: [MirFieldId]{ctx.field_id_for_type(tuple_ty, "min")?, ctx.field_id_for_type(tuple_ty, "max")?}
    (receiver, receiver_place) :: lower_builtin_receiver(&ctx, recv, false)?
    route :: op.prelude_route(recv.ty, expr.ty, carrier).map_err(fn(error) { ctx.error(ctx.span(), "builtin method {op.debug()}: {error.debug()}") })?
    call :: ctx.intern_prelude_route(route)?
    ctx.emit("list-min-max", Val(expr.ty), MirOperation.Semantic(MirSemanticOp.BuiltinMethod{call: call, receiver: receiver, receiver_place: receiver_place, args: [], aggregate_fields: Val(aggregate_fields)}))
}
// Rust: crates/jet-codegen/src/Codegen/TIR/tir_to_mir_expr.rs:1208
fn lower_consuming_task_value(ctx: &LowerCtx, value: TExpr) -> MirValueId LowerError! {
    if lower_receiver_place(&ctx, value, MirAccess.Move)? == .Val(place) -> return ctx.emit("task-consuming-value", Val(value.ty), MirOperation.MovePlace{place: place})
    ctx.lower_child(value)
}
// Rust: crates/jet-codegen/src/Codegen/TIR/tir_to_mir_expr.rs:1219
fn math_builtin_type_id(ctx: &LowerCtx, type_name: String) -> MirTypeId LowerError! {
    source :: if type_name == {
        "Int" -> Type.Int
        "Float" -> Type.Float
        "F32" | "Float32" -> Type.Float32
        else -> Type.Named(type_name)
    }
    ctx.mir_type(source)?.identity ?? return Err(ctx.error(ctx.span(), "checked MIR math builtin type `{type_name}` has no identity"))
}
// Rust: crates/jet-codegen/src/Codegen/TIR/tir_to_mir_expr.rs:1238
fn lower_math_swizzle_read(ctx: &LowerCtx, expr: TExpr, type_name: String, recv: TExpr, lanes: [U8], carrier: TFailureCarrier) -> MirValueId LowerError! {
    if lanes.is_empty() -> return Err(ctx.error(ctx.span(), "checked swizzle has no lanes"))
    base :: ctx.lower_child(recv)?
    scalar_ty :: Sema.math_scalar_ty(type_name)
    lane_carrier :: TFailureCarrier.from_checked_type(scalar_ty)
    line :: ctx.source_line()
    values := [MirValueId]{}
    loop (ordinal, lane) in lanes.enumerate() {
        index :: ctx.emit("math-swizzle-index-{ordinal}", Val(Type.Int), MirOperation.Constant(MirConstant.Int{value: I64{lane}, width: None, spelling: None}))?
        call :: ctx.intern_prelude_route(lane_index_route(type_name, scalar_ty, lane_carrier)?)?
        location :: panic_location(ctx, Int{line})
        context :: ctx.panic_context_at(line, None)
        value :: ctx.emit("math-swizzle-lane", Val(scalar_ty), MirOperation.Index{call: call, base: base, index: index, kind: MirIndexKind.Lane, access: MirAccess.Read, location: location, context: context})?
        &values.push(value)
    }
    if values.len() == 1 -> return values[0]
    result_type :: if expr.ty.without_user_tags() == { .Named(name) -> name else -> return Err(ctx.error(ctx.span(), "checked multi-lane swizzle has no vector result type")) }
    type_id :: math_builtin_type_id(&ctx, result_type)?
    route :: math_builtin_route(result_type, "new", values.len(), expr.ty, carrier)?
    call :: ctx.intern_prelude_route(route)?
    ctx.emit("math-swizzle-constructor", Val(expr.ty), MirOperation.Semantic(MirSemanticOp.MathBuiltin{type_id: type_id, call: call, args: values}))
}
// Rust: crates/jet-codegen/src/Codegen/TIR/tir_to_mir_expr.rs:1312
fn lower_short_circuit_binary(ctx: &LowerCtx, expr: TExpr, op: BinOp, lhs: TExpr, rhs: TExpr) -> MirValueId LowerError! {
    left :: ctx.lower_child(lhs)?
    if ctx.is_terminated() -> return left
    right_block :: ctx.new_block(ctx.span(), "short-circuit-right")?
    short_block :: ctx.new_block(ctx.span(), "short-circuit-short")?
    join :: ctx.new_block(ctx.span(), "short-circuit-join")?
    (then_target, else_target, short_value) :: if op == {
        .And -> (right_block, short_block, false)
        .Or -> (short_block, right_block, true)
        else -> return unsupported_expr(ctx, "TExprKind::Binary (invalid short-circuit op)")
    }
    ctx.terminate(MirTerminator.Branch{condition: left, then_target: then_target, else_target: else_target})
    incoming := [(MirBlockId, MirValueId)]{}
    ctx.switch_to(short_block)
    short :: ctx.emit("short-circuit-value", Val(expr.ty), MirOperation.Constant(MirConstant.Bool(short_value)))?
    source :: ctx.current_block()
    ctx.terminate(MirTerminator.Jump{target: join})
    &incoming.push((source, short))
    ctx.switch_to(right_block)
    right :: ctx.lower_child(rhs)?
    source :: ctx.current_block()
    if !ctx.is_terminated() {
        ctx.terminate(MirTerminator.Jump{target: join})
        &incoming.push((source, right))
    }
    ctx.switch_to(join)
    ctx.emit("short-circuit-phi", Val(expr.ty), MirOperation.Phi{incoming: incoming})
}
