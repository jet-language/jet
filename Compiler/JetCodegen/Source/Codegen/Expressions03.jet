// Private canonical Codegen.TIR.tir_to_mir_expr projection continuation.
use jet_foundation.MIR.*
use jet_foundation.AST.[BinOp, Type, TypeTupleField, CtKey, CtValue, CtFloat, CtReport, DataPlanNodeId]
use jet_foundation.Syntax as Syntax
use jet_foundation.Names.[stable_id]
use jet_codegen.Codegen.TIR.*
use jet_codegen.Codegen.TIR.mir.[LowerCtx, LowerError]
use jet_codegen.Codegen.TIR.tir_to_mir_expr.*
use jet_codegen.Codegen.TIR.Routes.*
use jet_codegen.Collections as Collections
use jet_sema.Sema as Sema
use jet_codegen.Codegen.Tuples.[tuple_struct_name]

// Rust: crates/jet-codegen/src/Codegen/TIR/tir_to_mir_expr.rs:30
fn shared_guard_type_name(name: String) -> Bool Never! {
    leaf :: name.rsplit("::").next().and_then(fn(part) { part.rsplit('.').next() }) ?? name
    leaf == Syntax.TYPE_SHARED_GUARD
}
// Rust: crates/jet-codegen/src/Codegen/TIR/tir_to_mir_expr.rs:39
fn shared_guard_value_type(ty: Type) -> Type? Never! {
    if ty == {
        .Apply(name, args) if shared_guard_type_name(name) && args.len() == 1 -> Val(args[0])
        .Tagged(_, inner) -> shared_guard_value_type(inner)
        .Shared(inner) | .Option(inner) -> shared_guard_value_type(inner)
        .Result(ok, _) -> shared_guard_value_type(ok)
        else -> None
    }
}
// Rust: crates/jet-codegen/src/Codegen/TIR/tir_to_mir_expr.rs:50
fn pin_inner_type(ty: Type) -> Type? Never! {
    if ty.without_user_tags() == {
        .Apply(name, args) if name == Syntax.TYPE_PIN && args.len() == 1 -> Val(args[0])
        else -> None
    }
}
// Rust: crates/jet-codegen/src/Codegen/TIR/tir_to_mir_expr.rs:63
fn is_stored_field_chain(ctx: &LowerCtx, expr: TExpr) -> Bool Never! {
    if expr.kind == {
        .Local(_) | .IndexRead(..) -> pin_inner_type(expr.ty) == None
        .Field(recv, field) -> pin_inner_type(recv.ty) == None && is_stored_field_chain(&ctx, recv) && ctx.is_stored_struct_field(recv.ty, field.name)
        else -> false
    }
}
// Rust: crates/jet-codegen/src/Codegen/TIR/tir_to_mir_expr.rs:76
fn lower_carrier_payload(ctx: &LowerCtx, inner: TExpr, expected: Type?) -> MirValueId LowerError! {
    value :: ctx.lower_child(inner)?
    if ctx.is_terminated() -> return value
    if expected == .Val(target_type) {
        if target_type.without_user_tags() == Type.Int && (if inner.ty.without_user_tags() == { .IntN(..) -> true else -> false }) {
            target :: ctx.mir_type(target_type)?
            return ctx.emit("carrier-payload-numeric", Val(target_type), MirOperation.Convert{value: value, parameters: [MirValueId]{}, target: target, conversion: MirConversion.NumericCast})
        }
        return ctx.trait_box_value(value, inner.ty, target_type)
    }
    value
}
// Rust: crates/jet-codegen/src/Codegen/TIR/tir_to_mir_expr.rs:108
fn zip_callback(ctx: &LowerCtx, params: [Type], body: TExpr) -> MirValueId LowerError! {
    source_params := [String]{}
    loop index in 0..<params.len() -> &source_params.push("zip_{index}")
    lambda :: TLambda{
        source_params: source_params, source_param_symbols: [], param_types: params, ret: Val(body.ty),
        failure_carrier: TFailureCarrier.Infallible, executable: TLambdaBody.Expr(body), source_span: ctx.span(),
        frame_schedule: None, frame_schedule_derivation: None,
        capture_facts: TCaptureFacts{escapes: false, needs_fn_mut: false, mutable: [], cloned: [], frozen: [], materialized: [], moved: []},
        host_param_conventions: None, effects: TEffectFacts{direct: [], solved: [], call_edges: [], maximal: false, direct_spans: []}, jit_name: "", is_move: true,
        boxed: false, rc: false, arc: false, captures: [], capture_origins: [:], materialized_captures: [], frozen_captures: [], uses_stack_sentry: false,
    }
    ctx.lower_synthetic_lambda(lambda, "zip")
}
// Rust: crates/jet-codegen/src/Codegen/TIR/tir_to_mir_expr.rs:141
fn zip_context_arg(ctx: &LowerCtx, label: String, ty: Type, constant: MirConstant) -> MirCallArg LowerError! {
    value :: ctx.emit(label, Val(ty), MirOperation.Constant(constant))?
    mir_value_arg_with_access(ctx, value, MirAccess.Read)
}
// Rust: crates/jet-codegen/src/Codegen/TIR/tir_to_mir_expr.rs:151
fn zip_context_args(ctx: &LowerCtx) -> [MirCallArg] LowerError! {
    span :: ctx.span()
    (raw_source_line, line, col) :: if ctx.function_source() == {
        .Val(source) -> tir_src_line_at(source.text, source.lines, span.start)
        else -> ("", 1, 1)
    }
    source_line := raw_source_line.trim_end() // #4303
    file :: ctx.function.source_file
    function :: ctx.function.name
    caret :: U32.try_from(span.end.saturating_sub(span.start)).map_err(fn(_) { ctx.error(span, "zip source span does not fit u32") })?
    int_ty :: Type.IntN(false, 32)
    [MirCallArg]{
        zip_context_arg(&ctx, "zip-context-policy", Type.String, MirConstant.String("strict"))?,
        zip_context_arg(&ctx, "zip-context-file", Type.String, MirConstant.String(file))?,
        zip_context_arg(&ctx, "zip-context-line", int_ty, MirConstant.Int{value: I64{line}, width: Val((false, 32)), spelling: None})?,
        zip_context_arg(&ctx, "zip-context-function", Type.String, MirConstant.String(function))?,
        zip_context_arg(&ctx, "zip-context-source-line", Type.String, MirConstant.String(source_line))?,
        zip_context_arg(&ctx, "zip-context-column", int_ty, MirConstant.Int{value: I64{col}, width: Val((false, 32)), spelling: None})?,
        zip_context_arg(&ctx, "zip-context-caret", int_ty, MirConstant.Int{value: I64{caret}, width: Val((false, 32)), spelling: None})?,
    }
}
// Rust: crates/jet-codegen/src/Codegen/TIR/tir_to_mir_expr.rs:228
fn zip_closure_call(ctx: &LowerCtx, result: Type, route: TPreludeRoute, receiver: MirValueId, values: [(MirValueId, MirAccess)]) -> MirValueId LowerError! {
    strict :: route.member == "zip_strict"
    args := [MirCallArg]{}
    loop (value, access) in values -> &args.push(mir_value_arg_with_access(ctx, value, access))
    if strict -> &args.extend(zip_context_args(&ctx)?)
    call :: ctx.intern_prelude_route(route)?
    ctx.emit("zip-closure", Val(result), MirOperation.Semantic(MirSemanticOp.ClosureMethod{call: call, receiver: receiver, args: args}))
}
// Rust: crates/jet-codegen/src/Codegen/TIR/tir_to_mir_expr.rs:255
fn lower_unzip(ctx: &LowerCtx, expr: TExpr, recv: TExpr) -> MirValueId LowerError! {
    fields :: if expr.ty.without_user_tags() == { .Tuple(fields) -> fields else -> return Err(ctx.error(ctx.span(), "checked unzip result is not a tuple")) }
    item_ty :: if recv.ty.without_user_tags() == {
        .List(element) | .FixedList(element, _) -> element
        .Apply(_, args) if Collections.is_iter_type(recv.ty) && args.len() == 1 -> args[0]
        else -> return Err(ctx.error(ctx.span(), "checked unzip receiver is not a sequence"))
    }
    source :: if Collections.is_iter_type(recv.ty) {
        if recv.kind == {
            .Local(local) -> {
                place :: lower_local_place(&ctx, local, MirAccess.Move)?
                ctx.emit("unzip-source", Val(recv.ty), MirOperation.MovePlace{place: place})?
            }
            else -> ctx.lower_child(recv)?
        }
    } else -> ctx.lower_child(recv)?
    columns := [(TLocal, MirPlaceId, Type, Type, MirFieldId, MirFieldId, MirPreludeCallId)]{}
    unit_ty :: Type.Named("Unit")
    loop field in fields {
        column_ty :: field.ty
        element :: if column_ty.without_user_tags() == { .List(element) -> element else -> return Err(ctx.error(ctx.span(), "checked unzip column is not a List")) }
        local := tir_generated_local("unzip_{source.0}_{field.name}", ctx.span())
        local.mutable = true
        place :: ctx.bind_local(local, column_ty, true, false, false)?
        empty :: ctx.emit("unzip-empty", Val(column_ty), MirOperation.BuildList{values: [], trait_coercion: None})?
        _ :: ctx.emit("unzip-column", None, MirOperation.WritePlace{place: place, value: empty})?
        input_field :: ctx.field_id_for_type(item_ty, field.name)?
        output_field :: ctx.field_id_for_type(expr.ty, field.name)?
        push :: ctx.intern_prelude_route(TBuiltinOp.Push.prelude_route(column_ty, unit_ty, TFailureCarrier.Infallible)?)?
        &columns.push((local, place, column_ty, element, input_field, output_field, push))
    }
    routes :: loop_route_bundle()
    init :: ctx.intern_prelude_route(routes.iter_init)?
    has_next :: ctx.intern_prelude_route(routes.iter_has_next)?
    value :: ctx.intern_prelude_route(routes.iter_value)?
    advance :: ctx.intern_prelude_route(routes.iter_advance)?
    cursor :: ctx.emit("unzip-cursor", Val(Type.Named("IterCursor")), MirOperation.LoopIterInit{call: init, collection: source, step: None, by_value: true, source_kind: MirLoopSourceKind.Plain})?
    header :: ctx.new_block(ctx.span(), "unzip.header")?
    body :: ctx.new_block(ctx.span(), "unzip.body")?
    exit :: ctx.new_block(ctx.span(), "unzip.exit")?
    ctx.terminate(MirTerminator.Jump{target: header})
    ctx.switch_to(header)
    condition :: ctx.emit("unzip-has-next", Val(Type.Bool), MirOperation.LoopIterHasNext{call: has_next, cursor: cursor})?
    ctx.terminate(MirTerminator.Branch{condition: condition, then_target: body, else_target: exit})
    ctx.switch_to(body)
    item :: ctx.emit("unzip-row", Val(item_ty), MirOperation.LoopIterValue{call: value, cursor: cursor})?
    loop (_, place, column_ty, element, input_field, _, push) in columns {
        value :: ctx.emit("unzip-field", Val(element), MirOperation.Field{base: item, field: input_field})?
        receiver :: ctx.emit("unzip-column-ref", Val(column_ty), MirOperation.AddressOf{place: place, access: MirAccess.Write})?
        _ :: ctx.emit("unzip-push", None, MirOperation.Semantic(MirSemanticOp.BuiltinMethod{call: push, receiver: receiver, receiver_place: Val(place), args: [MirValueId]{value}, aggregate_fields: None}))?
    }
    _ :: ctx.emit("unzip-advance", None, MirOperation.LoopIterAdvance{call: advance, cursor: cursor})?
    ctx.terminate(MirTerminator.Jump{target: header})
    ctx.switch_to(exit)
    result_fields := [(MirFieldId, MirValueId)]{}
    loop (local, _, column_ty, _, _, field, _) in columns {
        place :: lower_local_place(&ctx, local, MirAccess.Move)?
        value :: ctx.emit("unzip-column-result", Val(column_ty), MirOperation.MovePlace{place: place})?
        &result_fields.push((field, value))
    }
    owner :: ctx.mir_type(expr.ty)?.identity ?? return Err(ctx.error(ctx.span(), "checked unzip tuple has no canonical identity"))
    ctx.emit("unzip-result", Val(expr.ty), MirOperation.Tuple{type_id: owner, fields: result_fields})
}
// Rust: crates/jet-codegen/src/Codegen/TIR/tir_to_mir_expr.rs:431
fn lower_zip(ctx: &LowerCtx, expr: TExpr, recv: TExpr, op: TBuiltinOp, args: [TExpr]) -> MirValueId LowerError! {
    (mode, fields, flatten, input_count, fill_mode, field_types) :: if op == {
        .Zip(mode: mode, fields: fields, flatten: flatten, input_count: input_count, fill_mode: fill_mode, field_types: field_types, ..) -> (mode, fields, flatten, input_count, fill_mode, field_types)
        else -> unreachable("zip projection receives the checked zip operation")
    }
    fill_count :: if mode == TZipMode.Pad && fill_mode != TZipFillMode.DefaultNone -> 1 else -> 0
    if flatten || input_count < 2 || fields.len() != input_count || field_types.len() != input_count || args.len() != input_count - 1 + fill_count -> return Err(ctx.error(ctx.span(), "checked zip has inconsistent column facts"))
    // Evaluate each source and fill once, in source order.
    inputs := [(MirValueId, Type)]{}
    &inputs.push((lower_builtin_receiver(&ctx, recv, false)?.0, recv.ty))
    loop index in 0..<(input_count - 1) -> &inputs.push((lower_builtin_receiver(&ctx, args[index], false)?.0, args[index].ty))
    fill :: if fill_count == 1 -> Val((ctx.lower_child(args[input_count - 1])?, args[input_count - 1].ty)) else -> None
    columns := [MirValueId]{}
    fills := [MirValueId]{}
    loop (index, (input_value, input_ty)) in inputs.enumerate() {
        element :: if input_ty.without_user_tags() == {
            .List(element) | .FixedList(element, _) -> element
            .Apply(_, arguments) if Collections.is_iter_type(input_ty) && arguments.len() == 1 -> arguments[0]
            else -> return Err(ctx.error(ctx.span(), "checked zip input has no sequence element"))
        }
        iter_ty :: Collections.iter_ty(element)
        value := input_value
        if !Collections.is_iter_type(input_ty) {
            route :: TBuiltinOp.ListLazy.prelude_route(input_ty, iter_ty, TFailureCarrier.Infallible)?
            call :: ctx.intern_prelude_route(route)?
            value = ctx.emit("zip-source", Val(iter_ty), MirOperation.Semantic(MirSemanticOp.BuiltinMethod{call: call, receiver: value, receiver_place: None, args: [], aggregate_fields: None}))?
        }
        if mode == TZipMode.Pad {
            target :: field_types[index]
            fill_value :: if fill == .Val((fill_value, fill_ty)) {
                (fill_lane, actual) :: if fill_mode == TZipFillMode.Columns {
                    shape :: if fill_ty == { .Tuple(shape) -> shape else -> return Err(ctx.error(ctx.span(), "checked zip column fills have no tuple")) }
                    actual :: (shape.find(fn(field) { field.name == fields[index] }) ?? return Err(ctx.error(ctx.span(), "checked zip fill column is missing"))).ty
                    field :: ctx.field_id_for_type(fill_ty, fields[index])?
                    lane :: ctx.emit("zip-fill-column", Val(actual), MirOperation.Field{base: fill_value, field: field})?
                    (lane, actual)
                } else -> (fill_value, fill_ty)
                if actual == target -> fill_lane
                else {
                    mir_target :: ctx.mir_type(target)?
                    ctx.emit("zip-fill-widen", Val(target), MirOperation.Convert{value: fill_lane, parameters: [], target: mir_target, conversion: MirConversion.NumericCast})?
                }
            } else {
                local :: TExpr{ty: element, kind: TExprKind.Local(tir_user_local("zip_0", ctx.span())), span: ctx.span(), integer_bounds: None, cost: None}
                callback :: zip_callback(&ctx, [Type]{element}, TExpr{ty: target, kind: TExprKind.Present(local), span: ctx.span(), integer_bounds: None, cost: None})?
                result :: Collections.iter_ty(target)
                route :: TClosureOp.Map.prelude_route(iter_ty, result, TFailureCarrier.Infallible)?
                value = zip_closure_call(&ctx, result, route, value, [(callback, MirAccess.Move)])?
                ctx.emit("zip-fill-absent", Val(target), MirOperation.Absent)?
            }
            &fills.push(fill_value)
        }
        &columns.push(value)
    }
    left := columns[0]
    left_ty := field_types[0]
    left_fill := fills.first()
    loop column in 1..<input_count {
        shape := [TypeTupleField]{}
        loop index in 0..=column -> &shape.push(TypeTupleField{name: fields[index], ty: field_types[index]})
        row_ty :: Type.Tuple(shape)
        left_local :: TExpr{ty: left_ty, kind: TExprKind.Local(tir_user_local("zip_0", ctx.span())), span: ctx.span(), integer_bounds: None, cost: None}
        row_fields := [TNamedExpr]{}
        loop index in 0..<column {
            value :: if column == 1 -> left_local else -> TExpr{
                ty: field_types[index], kind: TExprKind.HostCall(THostCall.TupleIndex(left_local, index)), span: ctx.span(), integer_bounds: None, cost: None,
            }
            &row_fields.push(TNamedExpr{name: fields[index], value: value})
        }
        &row_fields.push(TNamedExpr{name: fields[column], value: TExpr{ty: field_types[column], kind: TExprKind.Local(tir_user_local("zip_1", ctx.span())), span: ctx.span(), integer_bounds: None, cost: None}})
        callback :: zip_callback(&ctx, [Type]{left_ty, field_types[column]}, TExpr{ty: row_ty, kind: TExprKind.TupleLit{struct_name: tuple_struct_name(shape), fields: row_fields}, span: ctx.span(), integer_bounds: None, cost: None})?
        values := [(MirValueId, MirAccess)]{(columns[column], MirAccess.Move)}
        if left_fill == .Val(fill_value) {
            &values.push((fill_value, MirAccess.Read))
            &values.push((fills[column], MirAccess.Read))
        }
        &values.push((callback, MirAccess.Move))
        result :: if column + 1 == input_count -> expr.ty else -> Collections.iter_ty(row_ty)
        left = zip_closure_call(&ctx, result, zip_closure_route(mode), left, values)?
        if left_fill != None && column + 1 < input_count {
            owner :: ctx.mir_type(row_ty)?.identity ?? return Err(ctx.error(ctx.span(), "zip fill tuple has no type identity"))
            tuple_fields := [(MirFieldId, MirValueId)]{}
            loop index in 0..=column -> &tuple_fields.push((ctx.field_id_for_type(row_ty, fields[index])?, fills[index]))
            left_fill = Val(ctx.emit("zip-fill-prefix", Val(row_ty), MirOperation.Tuple{type_id: owner, fields: tuple_fields})?)
        }
        left_ty = row_ty
    }
    left
}
// Rust: crates/jet-codegen/src/Codegen/TIR/tir_to_mir_expr.rs:665
fn csv_query_row_type(ty: Type) -> Type? Never! {
    ok :: if ty.without_user_tags() == { .Result(ok, _) -> ok else -> return None }
    if ok.without_user_tags() == {
        .Apply(name, args) if name == "Query" && args.len() == 1 -> Val(args[0])
        else -> None
    }
}
// Rust: crates/jet-codegen/src/Codegen/TIR/tir_to_mir_expr.rs:677
fn data_row_type(ty: Type) -> Type? Never! {
    if ty.without_user_tags() == {
        .Result(ok, _) | .Option(ok) -> data_row_type(ok)
        .Apply(name, args) if (name == "DataLoader" || name == "DataSnapshot" || name == "DataStream") && args.len() == 1 -> Val(args[0])
        .List(inner) | .FixedList(inner, _) -> Val(inner)
        else -> None
    }
}
// Rust: crates/jet-codegen/src/Codegen/TIR/tir_to_mir_expr.rs:691
fn lower_data_plan_node_id(id: DataPlanNodeId) -> MirDataPlanNodeId Never! { MirDataPlanNodeId(U64{id.index()}) }
// Rust: crates/jet-codegen/src/Codegen/TIR/tir_to_mir_expr.rs:695
fn lower_data_plan(ctx: &LowerCtx, plan: TDataPlan) -> MirDataPlan LowerError! {
    logical := [MirDataPlanNode]{}
    loop node in plan.logical {
        callable :: if node.callable == .Val(callable) -> Val(MirDataPlanCallable{label: callable.label, parameter: ctx.mir_type(callable.parameter)?, result: ctx.mir_type(callable.result)?, span: callable.span}) else -> None
        inputs := [MirDataPlanNodeId]{}
        loop input in node.inputs -> &inputs.push(lower_data_plan_node_id(input))
        row_type :: ctx.mir_type(node.schema.row_type)?
        columns := [MirDataPlanColumn]{}
        loop column in node.schema.columns -> &columns.push(MirDataPlanColumn{name: column.name, ty: ctx.mir_type(column.ty)?, nullable: column.nullable})
        &logical.push(MirDataPlanNode{id: lower_data_plan_node_id(node.id), operation: node.operation, inputs: inputs, source: node.source, row_type: row_type, columns: columns, callable: callable, stream: node.stream, span: node.span})
    }
    physical := [MirDataPlanPhysicalNode]{}
    loop node in plan.physical -> &physical.push(MirDataPlanPhysicalNode{logical: lower_data_plan_node_id(node.logical), operator: node.operator, stream: node.stream, reason: node.reason})
    MirDataPlan{schema_version: MirDataPlan.SCHEMA_VERSION, source: plan.source, logical: logical, physical: physical, output: lower_data_plan_node_id(plan.output), source_span: plan.source_span}
}
// Rust: crates/jet-codegen/src/Codegen/TIR/tir_to_mir_expr.rs:760
fn mir_const_key(key: CtKey) -> MirConstKey Never! {
    if key == {
        .Int(value) -> MirConstKey.Int(value)
        .Str(value) -> MirConstKey.String(value)
        .Bool(value) -> MirConstKey.Bool(value)
        .Char(value) -> MirConstKey.Char(value)
        .Tuple(fields) -> {
            lowered := [(String, MirConstKey)]{}
            loop field in fields -> &lowered.push((field.name, mir_const_key(field.value)))
            MirConstKey.Tuple(lowered)
        }
        .Struct(type_name, fields) -> {
            lowered := [(String, MirConstKey)]{}
            loop field in fields -> &lowered.push((field.name, mir_const_key(field.value)))
            MirConstKey.Struct{type_name: type_name, fields: lowered}
        }
        .Enum(type_name, variant) -> MirConstKey.Enum{type_name: type_name, variant: variant}
    }
}
// Rust: crates/jet-codegen/src/Codegen/TIR/tir_to_mir_expr.rs:786
fn mir_constant(ctx: &LowerCtx, value: CtValue) -> MirConstant LowerError! {
    if value == {
        .Int(value) -> MirConstant.Int{value: value, width: None, spelling: None}
        .Float(value) -> if value == {
            .F32(number) -> MirConstant.Float{value: number, f32: true, spelling: None}
            .F64(number) -> MirConstant.Float{value: number, f32: false, spelling: None}
        }
        .Bool(value) -> MirConstant.Bool(value)
        .Char(value) -> MirConstant.Char(value)
        .Str(value) -> MirConstant.String(value)
        .BigInt(value) -> MirConstant.BigInt(value)
        .Bytes(value) -> MirConstant.Bytes(value)
        .List(values) -> {
            lowered := [MirConstant]{}
            loop item in values -> &lowered.push(mir_constant(&ctx, item)?)
            MirConstant.List(lowered)
        }
        .Map(entries) -> {
            lowered := [(MirConstKey, MirConstant)]{}
            loop entry in entries -> &lowered.push((mir_const_key(entry.key), mir_constant(&ctx, entry.value)?))
            MirConstant.Map(lowered)
        }
        .Struct(type_name, fields) -> {
            lowered := [(String, MirConstant)]{}
            loop field in fields -> &lowered.push((field.name, mir_constant(&ctx, field.value)?))
            MirConstant.Struct{type_name: type_name, fields: lowered}
        }
        .Enum(type_name, variant, args) -> {
            lowered := [(String?, MirConstant)]{}
            loop arg in args -> &lowered.push((arg.label, mir_constant(&ctx, arg.value)?))
            MirConstant.Enum{type_name: type_name, variant: variant, args: lowered}
        }
        .Present(value) -> MirConstant.Present(mir_constant(&ctx, value)?)
        .Failed(report) -> MirConstant.Failed(if report == { .Clean(ty) -> MirConstReport.Clean(ctx.mir_type(ty)?) .Told(value) -> MirConstReport.Told(mir_constant(&ctx, value)?) })
        .Unit -> MirConstant.Unit
        .Closure(_) -> return Err(ctx.error(ctx.span(), "checked comptime closure cannot lower as a neutral MIR constant"))
    }
}
// Rust: crates/jet-codegen/src/Codegen/TIR/tir_to_mir_expr.rs:856
fn lower_persistent_place(ctx: &LowerCtx, local: TLocal, access: MirAccess) -> MirPlaceId LowerError! {
    key :: local.persist_key ?? return ctx.place_for_local(local, access)
    loop place in &ctx.places {
        if place.persist_key == Val(key) {
            place.access = if (place.access, access) == {
                (.Move, _) | (_, .Move) -> MirAccess.Move
                (.Write, _) | (_, .Write) -> MirAccess.Write
                else -> MirAccess.Read
            }
            return place.id
        }
    }
    ty :: local.persist_ty ?? return Err(ctx.error(ctx.span(), "persistent local `{local.name}` has no checked type"))
    span :: ctx.span()
    id :: MirPlaceId(stable_id("mir-place", "{ctx.function.key}|persistent|{key}"))
    mir_ty :: ctx.mir_type(ty)?
    &ctx.places.push(MirPlace{id: id, span: span, ty: mir_ty, base: MirPlaceBase.Static(key), projections: [], access: access, persist_key: Val(key)})
    id
}
// Rust: crates/jet-codegen/src/Codegen/TIR/tir_to_mir_expr.rs:900
fn lower_local_place(ctx: &LowerCtx, local: TLocal, access: MirAccess) -> MirPlaceId LowerError! {
    if local.persist_key != None -> lower_persistent_place(&ctx, local, access)
    else {
