// Private continuation of canonical Codegen.TIR.TirToMirExpr.
use jet_foundation.AST.[Type, TypeTupleField, CtValue, CtFloat, union_enum_name]
use jet_foundation.TIR.*
use jet_foundation.MIR.*
use jet_foundation.[SymbolID, TEXT_NUL]
use jet_foundation.Diagnostics.Span
use jet_foundation.Syntax as Syntax
use jet_codegen.Codegen.[is_key_variant]
use jet_codegen.Codegen.Tuples.tuple_struct_name
use jet_codegen.Codegen.TIR.Mir.[LowerCtx, LowerError]
use jet_codegen.Codegen.TIR.TirToMirExpr.[mir_value_arg_with_access, lower_local_place, builtin_codec_name]
use jet_codegen.Codegen.TIR.Routes.datatree_access_route
use jet_codegen.Codegen.TIR.TirToMirStmt.lower_stmt

// Rust: crates/jet-codegen/src/Codegen/TIR/tir_to_mir_expr.rs:10028
fn lower_datatree_access(&ctx: LowerCtx, expr: TExpr, recv: TExpr, source_args: [TExpr], op: THandleOp, carrier: TFailureCarrier) -> MirValueId LowerError! {
    route :: datatree_access_route(op, carrier) ?? panic("DataTree access route checked before structural lowering")
    receiver :: &ctx.lower_child(recv)?
    args := [MirValueId]{}
    loop arg in source_args -> &args.push(&ctx.lower_child(arg)?)
    call :: &ctx.intern_prelude_route(route)?
    &ctx.emit("datatree-access", Val(expr.ty), MirOperation.Semantic(MirSemanticOp.HandleMethod{call: call, receiver: receiver, args: ^args, frame_schedule: None, frame_schedule_derivation: None}))
}
// Rust: crates/jet-codegen/src/Codegen/TIR/tir_to_mir_expr.rs:10057
fn typed_codec_target(ty: Type) -> Bool Never! {
    if ty.without_user_tags() == {
        .Int | .Float | .Bool | .String | .Char | .IntN(_, _) | .Float32
        | .List(_) | .FixedList(_, _) | .Option(_) | .InlineRange(_, _, _) -> true
        .Map(key, _, _) -> key.without_user_tags() == Type.String
        .Named(name) -> name == "Data" || name == "DataTree" || name == "U8" || name == "I8"
            || name == "I16" || name == "I32" || name == "I64" || name == "I128" || name == "U16"
            || name == "U32" || name == "U64" || name == "U128" || name == "Secret" || name.ends_with(".Secret")
        .Tagged(_, inner) -> typed_codec_target(inner)
        else -> false
    }
}
// Rust: crates/jet-codegen/src/Codegen/TIR/tir_to_mir_expr.rs:10096
fn lower_typed_codec(&ctx: LowerCtx, expr: TExpr, recv: TExpr, type_arg: Type) -> MirValueId LowerError! {
    route :: TPreludeRoute{family: MirPreludeFamily.StaticPrelude, module: "core.encoding.codec", member: "decode_typed",
        symbol: MirSymbol.Prelude("jet_codec_decode_typed"), signature: MirCallSignature{arity: 1, max_arity: 1, borrow_mask: [true]},
        effect: None, fallibility: TFailureCarrier.from_checked_type(expr.ty), abi: MirPreludeAbi.Value, authority: None, db_metadata: None}
    call :: &ctx.intern_prelude_route(route)?
    value :: &ctx.lower_child(recv)?
    args :: [mir_value_arg_with_access(ctx, value, MirAccess.Read)]
    type_args :: [&ctx.mir_type(type_arg)?]
    &ctx.emit("serde-typed-decode-call", Val(expr.ty), MirOperation.Semantic(MirSemanticOp.StaticPreludeCall{call: call, args: args, owner_type_args: [], type_args: type_args}))
}
// Rust: crates/jet-codegen/src/Codegen/TIR/tir_to_mir_expr.rs:10133
fn lower_typed_encode(&ctx: LowerCtx, expr: TExpr, recv: TExpr, type_arg: Type) -> MirValueId LowerError! {
    route :: TPreludeRoute{family: MirPreludeFamily.StaticPrelude, module: "core.encoding.codec", member: "encode",
        symbol: MirSymbol.Prelude("jet_codec_encode"), signature: MirCallSignature{arity: 2, max_arity: 2, borrow_mask: [false, true]},
        effect: None, fallibility: TFailureCarrier.from_checked_type(expr.ty), abi: MirPreludeAbi.Value, authority: None, db_metadata: None}
    call :: &ctx.intern_prelude_route(route)?
    // Generic Encode ignores the builtin-kind sentinel, but retains that ABI argument.
    kind_value :: &ctx.emit("serde-codec-kind", Val(Type.IntN{signed: true, bits: 64}), MirOperation.Constant(MirConstant.Int{value: 0, width: Val((true, 64)), spelling: None}))?
    value :: &ctx.lower_child(recv)?
    args :: [mir_value_arg_with_access(ctx, kind_value, MirAccess.Read), mir_value_arg_with_access(ctx, value, MirAccess.Read)]
    type_args :: [&ctx.mir_type(type_arg)?]
    &ctx.emit("serde-typed-encode-call", Val(expr.ty), MirOperation.Semantic(MirSemanticOp.StaticPreludeCall{call: call, args: args, owner_type_args: [], type_args: type_args}))
}
// Rust: crates/jet-codegen/src/Codegen/TIR/tir_to_mir_expr.rs:10188
fn missing_function_target(error: LowerError) -> Bool Never! { error.message.starts_with("missing checked function target") }
// Rust: crates/jet-codegen/src/Codegen/TIR/tir_to_mir_expr.rs:10192
fn builtin_codec_kind(ty: Type) -> I64? Never! {
    name :: builtin_codec_name(ty) ?? return None
    if name == { "Date" -> Val(I64{0}) "LocalDate" -> Val(I64{1}) "LocalTime" -> Val(I64{2})
        "DateTime" -> Val(I64{3}) "Duration" -> Val(I64{4}) "Decimal" -> Val(I64{5}) else -> None }
}
// Rust: crates/jet-codegen/src/Codegen/TIR/tir_to_mir_expr.rs:10204
fn lower_builtin_codec(&ctx: LowerCtx, expr: TExpr, recv: TExpr, type_arg: Type, kind: I64, encode: Bool) -> MirValueId LowerError! {
    member :: if encode -> "encode" else -> "decode"
    route :: TPreludeRoute{family: MirPreludeFamily.StaticPrelude, module: "core.encoding.codec", member: member,
        symbol: MirSymbol.Prelude("jet_codec_{member}"), signature: MirCallSignature{arity: 2, max_arity: 2, borrow_mask: [false, true]},
        effect: None, fallibility: TFailureCarrier.from_checked_type(expr.ty), abi: MirPreludeAbi.Value, authority: None, db_metadata: None}
    call :: &ctx.intern_prelude_route(route)?
    kind_value :: &ctx.emit("serde-codec-kind", Val(Type.IntN{signed: true, bits: 64}), MirOperation.Constant(MirConstant.Int{value: kind, width: Val((true, 64)), spelling: None}))?
    value :: &ctx.lower_child(recv)?
    args :: [mir_value_arg_with_access(ctx, kind_value, MirAccess.Read), mir_value_arg_with_access(ctx, value, MirAccess.Read)]
    type_args :: [&ctx.mir_type(type_arg)?]
    &ctx.emit("serde-codec-call", Val(expr.ty), MirOperation.Semantic(MirSemanticOp.StaticPreludeCall{call: call, args: args, owner_type_args: [], type_args: type_args}))
}
// Rust: crates/jet-codegen/src/Codegen/TIR/tir_to_mir_expr.rs:10261
fn lower_optional_encode(&ctx: LowerCtx, expr: TExpr, recv: TExpr, inner: Type) -> MirValueId LowerError! {
    subject :: &ctx.lower_child(recv)?
    condition :: &ctx.emit("encode-option-present", Val(Type.Bool), MirOperation.OptionIsSome{subject: subject})?
    present :: &ctx.new_block(ctx.span(), "encode-option-present")?
    absent :: &ctx.new_block(ctx.span(), "encode-option-absent")?
    join :: &ctx.new_block(ctx.span(), "encode-option-join")?
    &ctx.terminate(MirTerminator.Branch{condition: condition, then_target: present, else_target: absent})
    &ctx.switch_to(present)
    value :: &ctx.emit("encode-option-value", Val(inner), MirOperation.OptionValue{subject: subject})?
    local :: TLocal.generated("encode_option_{subject.0}")
    place :: &ctx.bind_local(local, inner, false, false, false)?
    _ :: &ctx.emit("encode-option-bind", None, MirOperation.WritePlace{place: place, value: value})?
    encoded :: lower_serde_encode(&ctx, expr, TExpr{ty: inner, kind: TExprKind.Local(local), span: expr.span, integer_bounds: None, cost: None})?
    present_end :: ctx.current_block()
    &ctx.terminate(MirTerminator.Jump{target: join})
    &ctx.switch_to(absent)
    type_id :: &ctx.type_id_for(Syntax.TYPE_DATA)?
    null :: &ctx.emit("encode-option-null", Val(expr.ty), MirOperation.Enum{type_id: type_id, variant: "Null", args: []})?
    absent_end :: ctx.current_block()
    &ctx.terminate(MirTerminator.Jump{target: join})
    &ctx.switch_to(join)
    &ctx.emit("encode-option-result", Val(expr.ty), MirOperation.Phi{incoming: [(present_end, encoded), (absent_end, null)]})
}
// Rust: crates/jet-codegen/src/Codegen/TIR/tir_to_mir_expr.rs:10327
fn lower_ordered_object_encode(&ctx: LowerCtx, expr: TExpr, entries: [(TExpr, TExpr)]) -> MirValueId LowerError! {
    tree_ty :: Type.Named(Syntax.TYPE_DATA)
    pair_ty :: Type.Tuple([TypeTupleField{name: "key", ty: Type.String}, TypeTupleField{name: "value", ty: tree_ty}])
    pair_shape :: [("key", Type.String), ("value", tree_ty)]
    values := [MirValueId]{}
    loop (key, value) in entries {
        encoded :: TExpr{ty: tree_ty, kind: TExprKind.HandleMethod(value, THandleOp.SerdeEncode, []), span: expr.span, integer_bounds: None, cost: None}
        pair :: TExpr{ty: pair_ty, kind: TExprKind.TupleLit(tuple_struct_name(pair_shape), [TNamedExpr{name: "key", value: key}, TNamedExpr{name: "value", value: encoded}]), span: expr.span, integer_bounds: None, cost: None}
        &values.push(&ctx.lower_child(pair)?)
    }
    payload :: &ctx.emit("encode-ordered-object", Val(Type.List(pair_ty)), MirOperation.BuildList{values: ^values, trait_coercion: None})?
    type_id :: &ctx.type_id_for(Syntax.TYPE_DATA)?
    &ctx.emit("encode-ordered-tree", Val(expr.ty), MirOperation.Enum{type_id: type_id, variant: "Object", args: [MirEnumArg{field: None, value: payload, boxed: false}]})
}
// Rust: crates/jet-codegen/src/Codegen/TIR/tir_to_mir_expr.rs:10388
fn lower_container_encode(&ctx: LowerCtx, expr: TExpr, recv: TExpr, element: Type, map: Bool) -> MirValueId LowerError! {
    source_value :: &ctx.lower_child(recv)?
    source :: TLocal.generated("encode_source_{source_value.0}")
    source_place :: &ctx.bind_local(source, recv.ty, false, false, false)?
    _ :: &ctx.emit("encode-source", None, MirOperation.WritePlace{place: source_place, value: source_value})?
    source_expr :: TExpr{ty: recv.ty, kind: TExprKind.Local(source), span: recv.span, integer_bounds: None, cost: None}
    tree_ty :: Type.Named(Syntax.TYPE_DATA)
    item :: TLocal.generated("encode_item_{source_value.0}")
    item_ty :: if map -> Type.Tuple([TypeTupleField{name: "key", ty: Type.String}, TypeTupleField{name: "value", ty: element}]) else -> element
    item_expr :: TExpr{ty: item_ty, kind: TExprKind.Local(item), span: expr.span, integer_bounds: None, cost: None}
    item_value :: if map -> TExpr{ty: element, kind: TExprKind.Field(item_expr, TFieldRef{owner: None, field: SymbolID{key: "value"}, name: "value", ty: element, boxed: false}), span: expr.span, integer_bounds: None, cost: None} else -> item_expr
    encoded := TExpr{ty: tree_ty, kind: TExprKind.HandleMethod(item_value, THandleOp.SerdeEncode, []), span: expr.span, integer_bounds: None, cost: None}
    if map {
        shape :: [("key", Type.String), ("value", tree_ty)]
        key :: TExpr{ty: Type.String, kind: TExprKind.Field(item_expr, TFieldRef{owner: None, field: SymbolID{key: "key"}, name: "key", ty: Type.String, boxed: false}), span: expr.span, integer_bounds: None, cost: None}
        encoded = TExpr{ty: Type.Tuple([TypeTupleField{name: "key", ty: Type.String}, TypeTupleField{name: "value", ty: tree_ty}]),
            kind: TExprKind.TupleLit(tuple_struct_name(shape), [TNamedExpr{name: "key", value: key}, TNamedExpr{name: "value", value: ^encoded}]), span: expr.span, integer_bounds: None, cost: None}
    }
    output_ty :: Type.List(encoded.ty)
    output :: TLocal.generated("encode_output_{source_value.0}").as_mutable()
    output_place :: &ctx.bind_local(output, output_ty, true, false, false)?
    empty :: &ctx.emit("encode-empty", Val(output_ty), MirOperation.BuildList{values: [], trait_coercion: None})?
    _ :: &ctx.emit("encode-output", None, MirOperation.WritePlace{place: output_place, value: empty})?
    output_expr :: TExpr{ty: output_ty, kind: TExprKind.Local(output), span: expr.span, integer_bounds: None, cost: None}
    push :: TExpr{ty: Type.Named("Unit"), kind: TExprKind.BuiltinMethod(output_expr, TBuiltinOp.Push, [encoded]), span: expr.span, integer_bounds: None, cost: None}
    lower_stmt(&ctx, TStmt.ForIn{label: None, variable: item, variable_two: None, source: source_expr, collection: source_expr,
        step: None, method_kind: None, columnar: false, by_value: false, source_stable: false,
        body: [TStmt.ExprStmt(push, expr.span)], span: expr.span})?
    moved_place :: lower_local_place(&ctx, output, MirAccess.Move)?
    payload :: &ctx.emit("encode-container", Val(output_ty), MirOperation.MovePlace{place: moved_place})?
    type_id :: &ctx.type_id_for(Syntax.TYPE_DATA)?
    &ctx.emit("encode-tree", Val(expr.ty), MirOperation.Enum{type_id: type_id, variant: if map -> "Object" else -> "Array", args: [MirEnumArg{field: None, value: payload, boxed: false}]})
}
// Rust: crates/jet-codegen/src/Codegen/TIR/tir_to_mir_expr.rs:10544
fn lower_serde_encode(&ctx: LowerCtx, expr: TExpr, recv: TExpr) -> MirValueId LowerError! {
    ty :: recv.ty.without_user_tags()
    function_name :: if ty == .Union(members) -> "{union_enum_name(members)}::encode" else -> "{ty.name()}::encode"
    attempt :: Val(&ctx.function_id_for(function_name)) catch error -> {
        if missing_function_target(error) -> None else -> fail error
    }
    if attempt == Val(function) {
        owner_ty :: if ty == .Union(members) -> Type.Named(union_enum_name(members)) else -> recv.ty
        owner :: &ctx.mir_type(owner_ty)?
        args :: [&ctx.lower_plain_arg(recv)?]
        checked_return :: ctx.function_registry.method_call_return_type_for(function, [], owner_ty) catch message -> fail ctx.error(ctx.span(), message)
        call_return_type :: checked_return ?? expr.ty
        return &ctx.emit("serde-encode-call", Val(call_return_type), MirOperation.Call{callee: MirCallee.Method{function: function, owner: owner}, args: args, type_args: []})
    }
    if ty == Type.Named(Syntax.TYPE_DATA) -> return &ctx.lower_child(recv)
    if builtin_codec_kind(ty) == Val(kind) -> return lower_builtin_codec(&ctx, expr, recv, ty, kind, true)
    if ty == {
        .List(inner) | .FixedList(inner, _) -> {
            if inner.without_user_tags() != Type.IntN{signed: false, bits: 8} -> return lower_container_encode(&ctx, expr, recv, inner, false)
        }
        .Map(key, _, value) -> { if key.without_user_tags() == Type.String -> return lower_container_encode(&ctx, expr, recv, value, true) }
        .Option(inner) -> return lower_optional_encode(&ctx, expr, recv, inner)
        else -> {}
    }
    if typed_codec_target(ty) -> return lower_typed_encode(&ctx, expr, recv, ty)
    variant :: data_tree_encode_variant(ty) ?? fail ctx.error(ctx.span(), "serde encode of `{ty.name()}` requires a checked encode method")
    type_id :: &ctx.type_id_for(Syntax.TYPE_DATA)?
    value :: &ctx.lower_child(recv)?
    &ctx.emit("serde-encode-tree", Val(expr.ty), MirOperation.Enum{type_id: type_id, variant: variant, args: [MirEnumArg{field: None, value: value, boxed: false}]})
}
// Rust: crates/jet-codegen/src/Codegen/TIR/tir_to_mir_expr.rs:10635
fn lower_datatree_decode(&ctx: LowerCtx, expr: TExpr, recv: TExpr, target: Type) -> MirValueId LowerError! {
    target_ty :: target.without_user_tags()
    function_name :: if target_ty == .Union(members) -> "{union_enum_name(members)}::decode" else -> "{target.name()}::decode"
    attempt :: Val(&ctx.function_id_for(function_name)) catch error -> {
        if missing_function_target(error) -> None else -> fail error
    }
    if attempt == Val(function) {
        owner_ty :: if target_ty == .Union(members) -> Type.Named(union_enum_name(members)) else -> target
        owner :: &ctx.mir_type(owner_ty)?
        args :: [&ctx.lower_plain_arg(recv)?]
        checked_return :: ctx.function_registry.method_call_return_type_for(function, [], owner_ty) catch message -> fail ctx.error(ctx.span(), message)
        call_return_type :: checked_return ?? expr.ty
        return &ctx.emit("datatree-decode-call", Val(call_return_type), MirOperation.Call{callee: MirCallee.Associated{function: function, owner: owner}, args: args, type_args: []})
    }
    if builtin_codec_kind(target) == Val(kind) -> return lower_builtin_codec(&ctx, expr, recv, target, kind, false)
    if typed_codec_target(target) -> return lower_typed_codec(&ctx, expr, recv, target)
    fail ctx.error(ctx.span(), "serde decode of `{target.name()}` requires a checked decode method")
}
// Rust: crates/jet-codegen/src/Codegen/TIR/tir_to_mir_expr.rs:10689
fn data_tree_encode_variant(ty: Type) -> String? Never! {
    if ty.without_user_tags() == {
        .Int | .IntN(_, _) -> Val("Int")
        .Float | .Float32 -> Val("Float")
        .Bool -> Val("Bool")
        .String | .Char -> Val("Text")
        else -> None
    }
}
// Rust: crates/jet-codegen/src/Codegen/TIR/tir_to_mir_expr.rs:10700
fn instance_method_lookup(method: TMethodRef, recv_ty: Type) -> String Never! {
    key :: method_key(method)
    if method.operator_identity != None -> return key
    owner := String?{None}
    if recv_ty.without_user_tags() == {
        .Named(name) -> owner = Val(name)
        .Apply(_, _) -> owner = Val(recv_ty.name())
        .Tagged(_, inner) -> return instance_method_lookup(method, inner)
        else -> {}
    }
    name :: owner ?? return key
    if key == name || key.starts_with("{name}::") -> key else -> "{name}::{key}"
}
// Rust: crates/jet-codegen/src/Codegen/TIR/tir_to_mir_expr.rs:10725
fn method_key(method: TMethodRef) -> String Never! {
    if method.operator_identity == Val(identity) -> return identity
    if method.trait_owner == Val(owner) -> "{owner.key}::{method.name}" else -> method.name
}
// Rust: crates/jet-codegen/src/Codegen/TIR/tir_to_mir_expr.rs:10737
pub fn lower_pattern(&ctx: LowerCtx, pattern: TPattern) -> MirPattern LowerError! {
    owner_name := String?{None}
    if pattern.enum_type == Val(identity) -> owner_name = Val(identity.key)
    else if pattern.shape == .Variant(variant, _, _, _) && is_key_variant(variant) -> owner_name = Val(Syntax.TYPE_KEY)
    owner := MirTypeId?{None}
    if owner_name == Val(name) -> owner = Val(&ctx.type_id_for(name)?)
    position :: if pattern.position == {
        .Binding -> MirPatternPosition.Binding
        .OptionBinding -> MirPatternPosition.OptionBinding
        .Arm -> MirPatternPosition.Arm
        .VariantPath -> MirPatternPosition.VariantPath
        .DataEntries(temp) -> {
            identity :: owner ?? fail ctx.error(ctx.span(), "checked data-entry pattern is missing its owner")
            variant :: if pattern.shape == .Variant(name, _, _, _) -> name else -> fail ctx.error(ctx.span(), "checked data-entry pattern is missing its enum variant")
            local :: TLocal.generated(temp)
            temp_id :: &ctx.bind_data_entries_temp(local, identity, variant)?
            MirPatternPosition.DataEntries{temp: temp_id}
        }
    }
    shape :: lower_pattern_shape(&ctx, pattern.shape, owner)?
    MirPattern{shape: shape, owner: owner, position: position, mutable: pattern.mutable, boxed: pattern.boxed}
}
// Rust: crates/jet-codegen/src/Codegen/TIR/tir_to_mir_expr.rs:10785
fn lower_pattern_type(&ctx: LowerCtx, ty: Type) -> MirTypeId LowerError! {
    mir :: &ctx.mir_type(ty)?
    mir.identity ?? fail ctx.error(ctx.span(), "checked pattern type has no canonical MIR identity")
}
// Rust: crates/jet-codegen/src/Codegen/TIR/tir_to_mir_expr.rs:10800
fn lower_pattern_shape(&ctx: LowerCtx, shape: TPatternShape, owner: MirTypeId?) -> MirPatternShape LowerError! {
    if shape == {
        .Variant(variant, bindings, leading_dot, span) -> {
            lowered := [MirPatternBinding]{}
            loop binding in bindings -> &lowered.push(lower_pattern_binding(&ctx, binding)?)
            if lowered.is_empty() && owner == Val(identity) {
                if ctx.enum_group_leaves(identity, variant) == Val(leaves) {
                    alternatives := [MirPatternShape]{}
                    loop leaf in leaves -> &alternatives.push(MirPatternShape.Variant{variant: leaf, bindings: [], leading_dot: leading_dot, span: span})
                    return MirPatternShape.Or{alternatives: ^alternatives, span: span}
                }
            }
            MirPatternShape.Variant{variant: variant, bindings: ^lowered, leading_dot: leading_dot, span: span}
        }
        .Present(binding, binding_span, inner, span) -> MirPatternShape.Present{binding: binding, binding_span: binding_span, inner: lower_nested_pattern_shape(&ctx, inner)?, span: span}
        .Absent(span) -> MirPatternShape.Absent(span)
        .Ok(binding, binding_span, inner, span) -> MirPatternShape.Ok{binding: binding, binding_span: binding_span, inner: lower_nested_pattern_shape(&ctx, inner)?, span: span}
        .Err(binding, binding_span, inner, span) -> MirPatternShape.Err{binding: binding, binding_span: binding_span, inner: lower_nested_pattern_shape(&ctx, inner)?, span: span}
        .Range(lo, hi, span) -> MirPatternShape.Range{lo: lo, hi: hi, span: span}
        .Or(alternatives, span) -> {
            lowered := [MirPatternShape]{}
            loop alternative in alternatives -> &lowered.push(lower_pattern_shape(&ctx, alternative, owner)?)
            MirPatternShape.Or{alternatives: ^lowered, span: span}
        }
        .Struct(fields, rest, span) -> {
            identity :: owner ?? fail ctx.error(span, "checked struct pattern is missing its owner type")
            lowered := [MirPatternField]{}
            loop field in fields {
                if field == {
                    .Bind(name, local, location) -> {
                        field_id :: &ctx.field_id_for(identity, name)?
                        &lowered.push(MirPatternField.Bind{field: field_id, local: local, span: location})
                    }
                    .Value(name, value, location) -> {
                        field_id :: &ctx.field_id_for(identity, name)?
                        child :: &ctx.lower_child(value)?
                        &lowered.push(MirPatternField.Value{field: field_id, value: child, span: location})
                    }
                }
            }
            MirPatternShape.Struct{fields: ^lowered, rest: rest, span: span}
        }
        .Text(parts, span) -> {
            lowered := [MirTextPatternPart]{}
            loop part in parts {
                if part == {
                    .Literal(text) -> &lowered.push(MirTextPatternPart.Literal(text))
                    .Hole(_, ty, location) -> {
                        kind :: lower_text_hole_kind(&ctx, ty, location)?
                        identity :: lower_pattern_type(&ctx, ty)?
                        &lowered.push(MirTextPatternPart.Hole{kind: kind, ty: identity, span: location})
                    }
                }
            }
            MirPatternShape.Text(^lowered, span)
        }
        .Binary(parts, span) -> {
            lowered := [MirBinaryPatternPart]{}
            loop part in parts {
                if part == {
                    .Literal(bytes) -> &lowered.push(MirBinaryPatternPart.Literal(bytes))
                    .Bits(_, width, big_endian, ty, location) -> {
                        identity :: lower_pattern_type(&ctx, ty)?
                        &lowered.push(MirBinaryPatternPart.Bits{width: width, ty: identity, little: !big_endian, span: location})
                    }
                    .Rest(_, ty, location) -> {
                        identity :: lower_pattern_type(&ctx, ty)?
                        &lowered.push(MirBinaryPatternPart.Rest{ty: identity, span: location})
                    }
                }
            }
            MirPatternShape.Binary(^lowered, span)
        }
    }
}
// Rust: crates/jet-codegen/src/Codegen/TIR/tir_to_mir_expr.rs:10964
fn lower_text_hole_kind(&ctx: LowerCtx, ty: Type, _span: Span) -> MirTextHoleKind LowerError! {
    if ty == {
        .String | .Char -> MirTextHoleKind.Text
        .Int | .IntN(_, _) | .Measure(_) -> MirTextHoleKind.Int
        .Float | .Float32 -> MirTextHoleKind.Float
        .Bool -> MirTextHoleKind.Bool
        .InlineRange(_, lo, hi) -> MirTextHoleKind.InlineRange{lo: lo, hi: hi}
        else -> unsupported_pattern(&ctx, "TPatternShape::Text (invalid hole type)")?
    }
}
// Rust: crates/jet-codegen/src/Codegen/TIR/tir_to_mir_expr.rs:10985
fn lower_nested_pattern_shape(&ctx: LowerCtx, inner: TNestedPattern?) -> MirPatternShape? LowerError! {
    // Nested owner is resolved at the payload test boundary, exactly as in Rust.
    if inner == Val(pattern) -> Val(lower_pattern_shape(&ctx, pattern.shape, None)?) else -> None
}
// Rust: crates/jet-codegen/src/Codegen/TIR/tir_to_mir_expr.rs:10994
fn lower_pattern_binding(&ctx: LowerCtx, binding: TPatternBinding) -> MirPatternBinding LowerError! {
    if binding == {
        .Wildcard -> MirPatternBinding.Wildcard
        .Bind(name, span) -> MirPatternBinding.Bind{name: name, span: span}
        .Range(lo, hi) -> MirPatternBinding.Range{lo: lo, hi: hi}
        .Nested(inner) -> MirPatternBinding.Nested(lower_pattern_shape(&ctx, inner.shape, None)?)
    }
}
// Rust: crates/jet-codegen/src/Codegen/TIR/tir_to_mir_expr.rs:11011
fn default_constant(ty: Type) -> CtValue Never! {
    if ty == {
        .Int | .IntN(_, _) | .Measure(_) -> CtValue.Int(0)
        .Float -> CtValue.Float(CtFloat.f64(0.0))
        .Float32 -> CtValue.Float(CtFloat.f32(0.0))
        .Bool -> CtValue.Bool(false)
        .String -> CtValue.Str("")
        .Char -> CtValue.Char(TEXT_NUL.chars()[0])
        .List(_) | .FixedList(_, _) -> CtValue.List([])
        .Map(_, _, _) -> CtValue.Map([:])
        .Shared(inner) | .InlineRange(inner, _, _) | .Tagged(_, inner) | .Quantity(inner, _) -> default_constant(inner)
        .Option(inner) -> CtValue.absent(inner)
        .Result(ok, _) -> CtValue.Present(default_constant(ok))
        .Tuple(fields) -> {
            values := [String:CtValue]{}
            loop field in fields -> values[field.name] = default_constant(field.ty)
            CtValue.Struct{type_name: "Tuple", fields: ^values}
        }
        .Fn{..} | .Named(_) | .Apply(_, _) | .TraitObject(_) | .Union(_) -> CtValue.Unit
    }
}
// Rust: crates/jet-codegen/src/Codegen/TIR/tir_to_mir_expr.rs:11043
fn unsupported_expr<T>(&ctx: LowerCtx, variant: String) -> T LowerError! {
    span :: ctx.span()
    fail ctx.error(span, "{variant} has no canonical MIR operation")
}
// Rust: crates/jet-codegen/src/Codegen/TIR/tir_to_mir_expr.rs:11049
fn unsupported_pattern<T>(&ctx: LowerCtx, variant: String) -> T LowerError! {
    span :: ctx.span()
    fail ctx.error(span, "{variant} has no canonical MIR projection")
}
