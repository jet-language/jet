fn jet_codegen_handle_arg_is_host_borrow_callback(argument: TExpr) -> Bool {
    if argument.kind == {
        .HostBorrowCallback(_, _) -> return true
        .FnValue(kind) -> {
            return if kind == {
                .Send(value) -> {
                    if value.kind == {
                        .HostBorrowCallback(_, _) -> true
                        else -> false
                    }
                }
                else -> false
            }
        }
        else -> false
    }
}

fn jet_codegen_lower_handle_argument(builder: &JetCodegenBuilder, operation: THandleOp, index: Int, argument: TExpr) -> MirValueId {
    if operation == {
        .EventMethod(method) -> {
            if method == "on_priority" {
                if index == 1 -> return jet_codegen_lower_handle_native_int(&builder, argument)
            }
        }
        else -> {}
    }
    if operation == {
        .TcpStreamReadBytes | .TcpStreamReadBytesDeadline | .TcpStreamReadText | .TcpStreamReadTextDeadline | .UdpSocketReceiveDeadline | .UnixStreamReadDeadline | .TLSStreamReadDeadline -> {
            if index == 0 -> return jet_codegen_lower_handle_native_int(&builder, argument)
        }
        else -> {}
    }
    jet_codegen_lower_expr(&builder, argument)
}

fn jet_codegen_lower_handle_arguments(builder: &JetCodegenBuilder, operation: THandleOp, args: [TExpr]) -> [MirValueId] {
    values := [MirValueId?]{}
    loop _ in args -> &values.push(None)
    index := 0
    loop index < args.len() {
        if !jet_codegen_handle_arg_is_host_borrow_callback(args[index]) -> values[index] = Val(jet_codegen_lower_handle_argument(&builder, operation, index, args[index]))
        index += 1
    }
    index = 0
    loop index < args.len() {
        if jet_codegen_handle_arg_is_host_borrow_callback(args[index]) -> values[index] = Val(jet_codegen_lower_handle_argument(&builder, operation, index, args[index]))
        index += 1
    }
    lowered := [MirValueId]{}
    loop value in values -> &lowered.push(value ?? panic("checked handle argument lowering left a hole"))
    lowered
}

fn jet_codegen_lower_handle_native_int(builder: &JetCodegenBuilder, value: TExpr) -> MirValueId {
    if !jet_codegen_numeric_plain_int(value.ty) -> return jet_codegen_lower_expr(&builder, value)
    location := jet_codegen_source_location_at(&builder, value.span, false)
    converted := TExpr{
        ty: Type.IntN{signed: true, bits: 64},
        kind: TExprKind.NumericMethod{receiver: value, operation: TNumericOp.CheckedIntToFixed{host_kind: 3, dst_rust: "i64", dst_spelling: "I64", line: location.line}},
        span: value.span,
        integer_bounds: None,
        cost: None,
    }
    jet_codegen_lower_expr(&builder, converted)
}

fn jet_codegen_lower_frame_schedule(schedule: FrameSchedule?) -> MirFrameSchedule? {
    if schedule == None -> return None
    source :: schedule ?? panic("checked frame schedule disappeared")
    operations := [MirFrameOperation]{}
    loop operation in source.operations {
        accesses := [MirResourceAccess]{}
        loop access in operation.accesses {
            resource := if access.resource == {
                .Named(name) -> MirResourceIdentity.Named{name: name}
                .Unknown -> MirResourceIdentity.Unknown
            }
            mode := if access.mode == {
                .Read -> MirResourceAccessMode.Read
                .Write -> MirResourceAccessMode.Write
                .Move -> MirResourceAccessMode.Move
            }
            region := if access.region == {
                .Whole -> MirResourceRegion.Whole
                .Bytes(start, length) -> MirResourceRegion.Bytes{start: start, length: length}
                .Unknown -> MirResourceRegion.Unknown
            }
            layout := if access.layout == {
                None -> None
                Val(value) -> Val(MirResourceLayout{size: value.size, align: value.align, layout: value.layout, device: value.device})
            }
            &accesses.push(MirResourceAccess{resource: resource, mode: mode, region: region, layout: layout, temporary: access.temporary})
        }
        completion := if operation.completion == {
            .Synchronous -> MirFrameCompletion.Synchronous
            .Pending(token) -> MirFrameCompletion.Pending{token: token}
            .Event(token) -> MirFrameCompletion.Event{token: token}
        }
        &operations.push(MirFrameOperation{name: operation.name, source_index: operation.source_index, accesses: accesses, completion: completion, completion_provider: operation.completion_provider, external_effect: operation.external_effect})
    }
    dependencies := [MirFrameDependency]{}
    loop dependency in source.dependencies -> &dependencies.push(MirFrameDependency{before: dependency.before, after: dependency.after, resource: dependency.resource, reason: dependency.reason})
    transfers := [MirFrameTransfer]{}
    loop transfer in source.transfers -> &transfers.push(MirFrameTransfer{before: transfer.before, after: transfer.after, resource: transfer.resource, from_device: transfer.from_device, to_device: transfer.to_device})
    reuse := [MirFrameReuse]{}
    loop item in source.reuse -> &reuse.push(MirFrameReuse{previous_resource: item.previous_resource, next_resource: item.next_resource, previous_last_use: item.previous_last_use, next_first_use: item.next_first_use, legal: item.legal, reason: item.reason})
    retentions := [MirFrameRetention]{}
    loop item in source.retentions -> &retentions.push(MirFrameRetention{resource: item.resource, operation: item.operation, owner: item.owner, completion_token: item.completion_token, completed: item.completed})
    Val(MirFrameSchedule{operations: operations, dependencies: dependencies, transfers: transfers, reuse: reuse, retentions: retentions, conservative: source.conservative})
}

fn jet_codegen_handle_receiver_is_mutating(operation: THandleOp) -> Bool {
    if operation == {
        .HTTPClientMethod(kind, method) -> return kind == "BrowserTestServer" && method == "stop"
        else -> {}
    }
    if operation == {
        .FileReaderReadLine | .AllocReset | .FileWriterWriteLine | .FileWriterFlush | .CSVWriterWrite | .CSVWriterFlush | .CSVWriterFinish | .ClockTick | .ClockAdvance | .ClockWait | .FakeName | .FakeEmail | .FakeHost | .FakeAddress | .TcpStreamRead | .TcpStreamWrite | .TcpStreamClose | .TcpStreamReadBytes | .TcpStreamReadBytesDeadline | .TcpStreamReadText | .TcpStreamReadTextDeadline | .TcpStreamWriteBytes | .TcpStreamWriteBytesDeadline | .TcpStreamWriteAllBytes | .TcpStreamWriteAllBytesDeadline | .TcpStreamWriteText | .TcpStreamWriteTextDeadline | .TcpStreamShutdown | .TcpStreamReady | .UnixStreamReadDeadline | .UnixStreamWriteAllDeadline | .UnixStreamClose | .UnixStreamSetTimeout | .TLSStreamReadDeadline | .TLSStreamWriteAllDeadline | .TLSStreamClose | .TLSStreamCloseWrite -> true
        else -> false
    }
}

fn jet_codegen_lower_general_handle_method(builder: &JetCodegenBuilder, expression: TExpr, receiver: TExpr, operation: THandleOp, args: [TExpr]) -> MirValueId {
    carrier := jet_codegen_failure_carrier_for_type(expression.ty)
    route_value := jet_codegen_general_handle_route(operation, receiver.ty, args.len(), carrier)
    if route_value == None -> panic("checked THandleOp requires a dedicated lowering body or an unregistered closed route")
    route :: route_value ?? panic("checked general handle route disappeared")
    static_call := if operation == {
        .TLSClientConfigDefault | .TLSRootCertificatesFromPem | .TLSClientIdentityFromPem | .HTTPClientNew -> {
            true
        }
        else -> {
            false
        }
    }
    if static_call {
        if args.len() != route.borrow_mask.len() -> panic("checked static handle constructor arity disagrees with its closed route")
        values := [MirCallArg]{}
        index := 0
        loop index < args.len() {
            value := jet_codegen_lower_expr(&builder, args[index])
            access := if route.borrow_mask[index] -> MirAccess.Read else -> MirAccess.Move
            &values.push(jet_codegen_host_call_value_arg(value, args[index].span, access, None))
            index += 1
        }
        call := jet_codegen_intern_route(&builder, route.family, route.module_name, route.member, route.symbol, route.borrow_mask.len(), route.borrow_mask, route.effect_kind, carrier, route.abi)
        return jet_codegen_emit_value(&builder, expression.span, expression.ty, MirOperation.Semantic{operation: MirSemanticOp.StaticPreludeCall{call: call, args: values, owner_type_args: [MirPreludeTypeArg]{}, type_args: [MirType]{}}})
    }

    if operation == THandleOp.TaskJoin || operation == THandleOp.TaskDetach {
        if args.len() != 0 -> panic("checked consuming task operation takes no arguments")
        receiver_value := jet_codegen_lower_consuming_task_value(&builder, receiver)
        call := jet_codegen_intern_route(&builder, route.family, route.module_name, route.member, route.symbol, route.borrow_mask.len(), route.borrow_mask, route.effect_kind, carrier, route.abi)
        return jet_codegen_emit_value(&builder, expression.span, expression.ty, MirOperation.Semantic{operation: MirSemanticOp.HandleMethod{call: call, receiver: receiver_value, args: [MirValueId]{}, frame_schedule: None, frame_schedule_derivation: None}})
    }

    lowered_receiver := if {
        jet_codegen_handle_receiver_is_mutating(operation) -> {
            jet_codegen_method_receiver_arg(&builder, receiver, MirAccess.Write).value
        }
        else -> {
            jet_codegen_lower_expr(&builder, receiver)
        }
    }
    lowered_args := jet_codegen_lower_handle_arguments(&builder, operation, args)
    if route.family == MirPreludeFamily.ClosureMethod {
        if route.borrow_mask.len() != args.len() + 1 -> panic("checked closure-style handle route has an invalid operand count")
        closure_args := [MirCallArg]{}
        index := 0
        loop index < args.len() {
            value := lowered_args[index]
            access := jet_codegen_host_value_access(builder, value, route.borrow_mask[index + 1])
            &closure_args.push(jet_codegen_host_call_value_arg(value, args[index].span, access, None))
            index += 1
        }
        call := jet_codegen_intern_route(&builder, route.family, route.module_name, route.member, route.symbol, route.borrow_mask.len(), route.borrow_mask, route.effect_kind, carrier, route.abi)
        return jet_codegen_emit_value(&builder, expression.span, expression.ty, MirOperation.Semantic{operation: MirSemanticOp.ClosureMethod{receiver: lowered_receiver, args: closure_args, call: call}})
    }
    if operation == {
        .DurationNew(unit, _) -> {
            if route.borrow_mask.len() != 2 -> panic("checked Duration constructor route has an invalid closed ABI")
            type_id := jet_codegen_type_instance_id(Type.Named{name: "DurationUnit"}, builder.modules, builder.function.module_identity, builder.generic_type_names)
            unit_value := jet_codegen_emit_value(&builder, expression.span, Type.Named{name: "DurationUnit"}, MirOperation.Enum{type_id: type_id, variant: unit, args: [MirEnumArg]{}})
            &lowered_args.push(unit_value)
        }
        else -> {}
    }
    expected_args := if route.borrow_mask.len() == 0 -> 0 else -> route.borrow_mask.len() - 1
    if lowered_args.len() != expected_args -> panic("checked handle argument arity disagrees with its closed route")
    call := jet_codegen_intern_route(&builder, route.family, route.module_name, route.member, route.symbol, route.borrow_mask.len(), route.borrow_mask, route.effect_kind, carrier, route.abi)
    frame_schedule := if operation == {
        .GameSceneOnFrame(schedule, _) -> jet_codegen_lower_frame_schedule(schedule)
        else -> None
    }
    frame_schedule_derivation := if operation == {
        .GameSceneOnFrame(_, derivation) -> {
            if derivation == None -> None else -> Val(MirDerivationRef{id: (derivation ?? DerivationRef{id: ""}).id})
        }
        else -> None
    }
    jet_codegen_emit_value(&builder, expression.span, expression.ty, MirOperation.Semantic{operation: MirSemanticOp.HandleMethod{call: call, receiver: lowered_receiver, args: lowered_args, frame_schedule: frame_schedule, frame_schedule_derivation: frame_schedule_derivation}})
}
