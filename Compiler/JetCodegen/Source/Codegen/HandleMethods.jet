// Closed Prelude routing and ordinary MIR lowering for checked THandleOp nodes.
// Special expression families stay owned by their structural codegen paths.

struct JetCodegenHandleRoute {
    pub family: MirPreludeFamily
    pub module_name: String
    pub member: String
    pub symbol: String
    pub borrow_mask: [Bool]
    pub effect_kind: Effect?
    pub abi: MirPreludeAbi
}
fn jet_codegen_handle_route(family: MirPreludeFamily, module_name: String, member: String, symbol: String, borrow_mask: [Bool], route_effect: Effect?, abi: MirPreludeAbi) -> JetCodegenHandleRoute {
    JetCodegenHandleRoute{family: family, module_name: module_name, member: member, symbol: symbol, borrow_mask: borrow_mask, effect_kind: route_effect, abi: abi}
}
fn jet_codegen_handle_h(member: String, symbol: String, borrow_mask: [Bool], route_effect: Effect?) -> JetCodegenHandleRoute {
    jet_codegen_handle_route(MirPreludeFamily.HandleMethod, "core.handle", member, symbol, borrow_mask, route_effect, MirPreludeAbi.Value)
}
fn jet_codegen_handle_core(module_name: String, member: String, symbol: String, borrow_mask: [Bool], route_effect: Effect?) -> JetCodegenHandleRoute {
    jet_codegen_handle_route(MirPreludeFamily.HandleMethod, module_name, member, symbol, borrow_mask, route_effect, MirPreludeAbi.Value)
}


fn jet_codegen_handle_type_without_tags(ty: Type) -> Type {
    if ty == {
        .Tagged(_, inner) | .InlineRange(inner, _, _) -> return jet_codegen_handle_type_without_tags(inner)
        else -> return ty
    }
}

fn jet_codegen_handle_task_route(receiver: Type) -> JetCodegenHandleRoute {
    task_type := jet_codegen_handle_type_without_tags(receiver)
    if task_type == {
        .Apply(name, args) -> {
            if name != "Task" || args.len() != 1 -> panic("checked task join has an unsupported receiver type")
            symbol := if args[0] == {
                .Result(_, _) -> "jet_std::jet_task_join_result"
                else -> "jet_std::JetTask::join"
            }
            return jet_codegen_handle_core("core.tasks", "join", symbol, [Bool]{false}, None)
        }
        else -> panic("checked task join has an unsupported receiver type")
    }
}

fn jet_codegen_handle_allocator_name(receiver: Type) -> String {
    if jet_codegen_handle_type_without_tags(receiver) == {
        .Named(name) -> {
            if name == "Arena" || name == "Bump" || name == "Pool" || name == "Fixed" -> return name
        }
        else -> {}
    }
    panic("checked allocator method has no allocator receiver")
}

fn jet_codegen_handle_nominal_name(ty: Type) -> String {
    if jet_codegen_handle_type_without_tags(ty) == {
        .Named(name) | .Apply(name, _) -> return name
        else -> panic("checked route requires a nominal receiver type")
    }
}

fn jet_codegen_handle_event_route(receiver: Type, method: String, carrier: TFailureCarrier) -> JetCodegenHandleRoute? {
    name := jet_codegen_handle_nominal_name(receiver)
    if name == {
        "Event" | "AsyncEvent" | "Hook" | "DecisionHook" | "Subscription" | "EventScope" | "EventTrace" | "DispatchReport" -> {}
        else -> return None
    }
    symbol := ""
    mask := [Bool]{}
    if name == {
        "Event" -> {
            if method == {
                "on" | "once" -> {
                    symbol = "jet_std::JetEvent::{method}"
                    mask = [Bool]{true, true, false}
                }
                "on_priority" -> {
                    symbol = "jet_std::JetEvent::on_priority"
                    mask = [Bool]{true, true, false, false}
                }
                "emit" -> {
                    symbol = "jet_std::JetEvent::emit"
                    mask = [Bool]{true, false}
                }
                "listener_count" | "trace" -> {
                    symbol = "jet_std::JetEvent::{method}"
                    mask = [Bool]{true}
                }
                else -> return None
            }
        }
        "AsyncEvent" -> {
            if method == {
                "on" | "once" -> {
                    symbol = "jet_std::JetAsyncEvent::{method}"
                    mask = [Bool]{true, true, false}
                }
                "on_priority" -> {
                    symbol = "jet_std::JetAsyncEvent::on_priority"
                    mask = [Bool]{true, true, false, false}
                }
                "emit_async" -> {
                    symbol = if carrier == {
                        .Result(_, _) -> "jet_std::JetAsyncEvent::emit_async_result"
                        else -> "jet_std::JetAsyncEvent::emit_async"
                    }
                    mask = [Bool]{true, false}
                }
                "close" | "listener_count" | "queued_count" | "running_count" | "blocked_count" -> {
                    symbol = "jet_std::JetAsyncEvent::{method}"
                    mask = [Bool]{true}
                }
                else -> return None
            }
        }
        "Hook" -> {
            if method == {
                "on" | "once" -> {
                    symbol = "jet_std::JetHook::{method}"
                    mask = [Bool]{true, true, false}
                }
                "on_priority" -> {
                    symbol = "jet_std::JetHook::on_priority"
                    mask = [Bool]{true, true, false, false}
                }
                "run" -> {
                    symbol = "jet_std::JetHook::run"
                    mask = [Bool]{true, false, false}
                }
                "listener_count" | "trace" -> {
                    symbol = "jet_std::JetHook::{method}"
                    mask = [Bool]{true}
                }
                else -> return None
            }
        }
        "DecisionHook" -> {
            if method == {
                "on" | "once" -> {
                    symbol = "jet_std::JetDecisionHook::{method}"
                    mask = [Bool]{true, true, false}
                }
                "on_priority" -> {
                    symbol = "jet_std::JetDecisionHook::on_priority"
                    mask = [Bool]{true, true, false, false}
                }
                "run" -> {
                    symbol = "jet_std::JetDecisionHook::run"
                    mask = [Bool]{true, false}
                }
                "listener_count" -> {
                    symbol = "jet_std::JetDecisionHook::listener_count"
                    mask = [Bool]{true}
                }
                else -> return None
            }
        }
        "Subscription" -> {
            if method == {
                "unsubscribe" -> {
                    symbol = "jet_std::JetSubscription::unsubscribe"
                    mask = [Bool]{true}
                }
                "is_active" -> {
                    symbol = "jet_std::JetSubscription::active"
                    mask = [Bool]{true}
                }
                else -> return None
            }
        }
        "EventScope" -> {
            if method == {
                "cancel" -> {
                    symbol = "jet_std::JetEventScope::cancel"
                    mask = [Bool]{true}
                }
                "active_count" -> {
                    symbol = "jet_std::JetEventScope::active_count"
                    mask = [Bool]{true}
                }
                else -> return None
            }
        }
        "EventTrace" -> {
            if method == {
                "summary" | "delivered" | "queued" | "dropped" -> {
                    symbol = "jet_std::JetEventTrace::{method}"
                    mask = [Bool]{true}
                }
                else -> return None
            }
        }
        "DispatchReport" -> {
            if method == {
                "state" | "accepted" | "failures" | "trace" -> {
                    symbol = "jet_std::JetDispatchReport::{method}"
                    mask = [Bool]{true}
                }
                "delivered_handlers" -> {
                    symbol = "jet_std::JetDispatchReport::delivered_handlers"
                    mask = [Bool]{true}
                }
                else -> return None
            }
        }
        else -> return None
    }
    Val(jet_codegen_handle_route(MirPreludeFamily.ClosureMethod, "core.event", method, symbol, mask, None, MirPreludeAbi.Value))
}

fn jet_codegen_handle_watch_route(receiver: Type, method: String) -> JetCodegenHandleRoute? {
    name := if jet_codegen_handle_type_without_tags(receiver) == {
        .Named(value) -> value
        else -> {
            return None
        }
    }
    if name == "WatchHandle" {
        if method == {
            "poll" | "events" -> return Val(jet_codegen_handle_h("watch.poll", "jet_jit_watch_poll", [Bool]{true}, Val(Effect.IO)))
            "cancel" -> return Val(jet_codegen_handle_h("watch.cancel", "jet_jit_watch_cancel", [Bool]{true}, Val(Effect.IO)))
            "is_active" -> return Val(jet_codegen_handle_h("watch.is_active", "jet_jit_watch_is_active", [Bool]{true}, None))
            "summary" -> return Val(jet_codegen_handle_h("watch.summary", "jet_jit_watch_summary", [Bool]{true}, None))
            "on" | "once" -> return Val(jet_codegen_handle_route(MirPreludeFamily.ClosureMethod, "core.watcher", method, "jet_jit_watch_{method}", [Bool]{true, true, false}, Val(Effect.IO), MirPreludeAbi.Value))
            else -> return None
        }
    }
    if name == "WatchSet" {
        if method == {
            "add" -> return Val(jet_codegen_handle_h("watchset.add", "jet_jit_watchset_add", [Bool]{true, true}, Val(Effect.IO)))
            "poll" | "events" -> return Val(jet_codegen_handle_h("watchset.poll", "jet_jit_watchset_poll", [Bool]{true}, Val(Effect.IO)))
            "summary" -> return Val(jet_codegen_handle_h("watchset.summary", "jet_jit_watchset_summary", [Bool]{true}, None))
            else -> return None
        }
    }
    None
}

fn jet_codegen_handle_reactive_name(ty: Type) -> String? {
    return if ty == {
        .Tagged(_, inner) -> jet_codegen_handle_reactive_name(inner)
        .Named(name) | .Apply(name, _) -> Val(name)
        else -> None
    }
}

fn jet_codegen_handle_reactive_route(receiver: Type, method: String) -> JetCodegenHandleRoute? {
    name := jet_codegen_handle_reactive_name(receiver) ?? return None
    if name == "Signal" && method == "get" -> return Val(jet_codegen_handle_route(MirPreludeFamily.HandleMethod, "core.reactive", "Signal.get", "jet_std::JetSignal::get", [Bool]{true}, None, MirPreludeAbi.Value))
    if (name == "Derived" || name == "Computed") && method == "get" -> return Val(jet_codegen_handle_route(MirPreludeFamily.HandleMethod, "core.reactive", "Derived.get", "jet_std::JetDerived::get", [Bool]{true}, None, MirPreludeAbi.Value))
    if name == "Signal" && method == "set" -> return Val(jet_codegen_handle_route(MirPreludeFamily.HandleMethod, "core.reactive", "Signal.set", "jet_std::JetSignal::set", [Bool]{true, false}, None, MirPreludeAbi.Value))
    None
}

fn jet_codegen_handle_precise_route(type_name: String, method: String) -> JetCodegenHandleRoute? {
    arity := if method == {
        "add" | "sub" | "mul" | "div" | "equal" | "compare" -> 2
        "to_string" | "numerator" | "denominator" | "to_float" | "is_zero" -> 1
        else -> {
            return None
        }
    }
    type_key := jet_codegen_precise_type_key(type_name)
    mask := if arity == 2 -> [Bool]{true, true} else -> [Bool]{true}
    Val(jet_codegen_handle_route(MirPreludeFamily.PreciseBuiltin, type_name, method, "jet_{type_key}_{method}", mask, None, MirPreludeAbi.Value))
}

fn jet_codegen_handle_is_simd_lane_type(name: String) -> Bool {
    if name == {
        "F32x4" | "F64x2" | "F32x8" | "F64x4" | "I8x16" | "I16x8" | "I32x4" | "I64x2" |
        "U8x16" | "U16x8" | "U32x4" | "U64x2" | "I8x32" | "I16x16" | "I32x8" | "I64x4" |
        "U8x32" | "U16x16" | "U32x8" | "U64x4" -> {
            true
        }
        else -> {
            false
        }
    }
}

fn jet_codegen_handle_is_geometry_type(name: String) -> Bool {
    if name == {
        "Point2" | "Delta2" | "Transform" | "Transform2" | "Ray2" | "ScreenPoint" | "WorldPoint" | "ViewPoint" |
        "CameraPoint" | "DevicePoint" | "ScreenDelta" | "WorldDelta" | "ViewDelta" | "CameraDelta" | "DeviceDelta" -> {
            true
        }
        else -> {
            false
        }
    }
}

fn jet_codegen_handle_math_route(type_name: String, method: String, reduce_op: String?) -> JetCodegenHandleRoute? {
    suffix := ""
    if {
        method == "reduce" -> {
            suffix = if reduce_op == {
                (Val("Add")) -> "reduce_add"
                (Val("Mul")) -> "reduce_mul"
                (Val("Min")) -> "reduce_min"
                (Val("Max")) -> "reduce_max"
                (Val("Avg")) -> "reduce_avg"
                else -> {
                    return None
                }
            }
        }
        reduce_op != None -> {
            return None
        }
        jet_codegen_handle_is_geometry_type(type_name) -> {
            if method == {
                "add" | "sub" | "then" | "ray" | "inverse" | "point" | "point_at_depth" -> suffix = method
                else -> return None
            }
        }
        jet_codegen_handle_is_simd_lane_type(type_name) -> {
            if method == {
                "to_array" | "sum" | "product" | "min" | "max" -> suffix = method
                else -> return None
            }
        }
        type_name == "Vec2" || type_name == "Vec3" || type_name == "Vec4" -> {
            if method == {
                "to_array" | "length" | "normalize" | "dot" -> suffix = method
                else -> {
                    if {
                        type_name == "Vec3" && method == "cross" -> {
                            suffix = "cross"
                        }
                        else -> {
                            return None
                        }
                    }
                }
            }
        }
        type_name == "Mat3" || type_name == "Mat4" -> {
            if method == {
                "to_array" | "transpose" | "matmul" | "transform" -> suffix = method
                else -> return None
            }
        }
        else -> {
            return None
        }
    }
    arity := if {
        suffix == "point_at_depth" -> {
            3
        }
        suffix == "dot" || suffix == "cross" || suffix == "matmul" || suffix == "transform" || suffix == "add" || suffix == "sub" || suffix == "then" || suffix == "ray" || suffix == "point" -> {
            2
        }
        else -> {
            1
        }
    }
    mask := if {
        arity == 1 -> [Bool]{true}
        arity == 2 -> [Bool]{true, false}
        else -> [Bool]{true, false, false}
    }
    if jet_codegen_handle_is_geometry_type(type_name) -> return Val(jet_codegen_handle_route(MirPreludeFamily.MathBuiltin, "core.math", "geometry.{type_name}.{suffix}", "jet_math_{type_name}_{suffix}", mask, None, MirPreludeAbi.Value))
    Val(jet_codegen_handle_h("{type_name}.{suffix}", "jet_math_{type_name}_{suffix}", mask, None))
}

fn jet_codegen_handle_measurement_route(method: String) -> JetCodegenHandleRoute? {
    if method == {
        "value" -> return Val(jet_codegen_handle_h("Measurement.value", "jet_std::JetMeasurement::value", [Bool]{true}, None))
        "uncertainty" -> return Val(jet_codegen_handle_h("Measurement.uncertainty", "jet_std::JetMeasurement::uncertainty", [Bool]{true}, None))
        "add" | "sub" | "mul" | "div" -> return Val(jet_codegen_handle_h("Measurement.{method}", "jet_std::JetMeasurement::{method}", [Bool]{true, false}, None))
        "sqrt" -> return Val(jet_codegen_handle_h("Measurement.sqrt", "jet_std::JetMeasurement::sqrt", [Bool]{true}, None))
        else -> return None
    }
}

fn jet_codegen_handle_layout_route(method: String) -> JetCodegenHandleRoute? {
    if method == {
        "h" | "v" | "suggest" -> return Val(jet_codegen_handle_core("core.layout", "layout.{method}", "jet_layout::Handle::{method}", [Bool]{true, false, false}, None))
        "value" -> return Val(jet_codegen_handle_core("core.layout", "layout.value", "jet_layout::Handle::value", [Bool]{true, false}, None))
        "is_feasible" | "conflict" -> return Val(jet_codegen_handle_core("core.layout", "layout.{method}", "jet_layout::Handle::{method}", [Bool]{true}, None))
        "required" | "strong" | "medium" | "weak" -> return Val(jet_codegen_handle_core("core.layout", "layout.{method}", "jet_layout::Constraint::{method}", [Bool]{false}, None))
        else -> return None
    }
}

fn jet_codegen_handle_loadable_route(method: String) -> JetCodegenHandleRoute? {
    if method == {
        "is_loading" | "is_loaded" | "is_failed" | "is_idle" | "loaded" -> return Val(jet_codegen_handle_core("core.pending", "loadable.{method}", "JetLoadable::{method}", [Bool]{true}, None))
        "or_else" -> return Val(jet_codegen_handle_core("core.pending", "loadable.or_else", "JetLoadable::or_else", [Bool]{true, false}, None))
        else -> return None
    }
}

fn jet_codegen_handle_ui_route(receiver: Type, method: String) -> JetCodegenHandleRoute? {
    if receiver == {
        .Named(_) | .Apply(_, _) -> {}
        else -> return None
    }
    raw_name := jet_codegen_handle_nominal_name(receiver)
    pieces := raw_name.split("::")
    name := if pieces.len() > 0 -> pieces[pieces.len() - 1] else -> raw_name
    pieces = name.split(".")
    name = if pieces.len() > 0 -> pieces[pieces.len() - 1] else -> name
    backend := if name == {
        "NullBackend" -> "JetNullBackend"
        "TuiBackend" -> "JetTuiBackend"
        "GtkBackend" -> "JetGtkBackend"
        else -> {
            return None
        }
    }
    member := ""
    if method == {
        "measure" -> member = "measure_node"
        "layout" -> member = "layout_node"
        "paint" -> member = "paint_node"
        "on_event" -> member = "dispatch_event"
        "mount_default" -> member = "mount_node_default"
        "mount" -> member = "mount_node"
        "set_focus_group" -> member = "set_focus_group"
        "focused_label" -> member = "focused_label"
        else -> {}
    }
    if method == "commands" && name == "NullBackend" -> member = "paint_commands"
    if (method == "frame_lines" || method == "render_count") && name == "TuiBackend" -> member = method
    if method == "present" && name == "GtkBackend" -> member = "present"
    if member == "" -> return None
    mask := if method == {
        "measure" | "layout" | "mount" -> [Bool]{true, false, false}
        "paint" | "on_event" | "mount_default" | "set_focus_group" | "present" -> [Bool]{true, false}
        else -> [Bool]{true}
    }
    Val(jet_codegen_handle_core("core.ui", "{name}.{method}", "{backend}::{member}", mask, None))
}

fn jet_codegen_handle_sketch_route(sketch: String, method: String) -> JetCodegenHandleRoute? {
    arity := if {
        (sketch == "HyperLogLog" && method == "add") || (sketch == "CountMinSketch" && (method == "add" || method == "count")) -> {
            2
        }
        (sketch == "HyperLogLog" && method == "count") || (sketch == "ReservoirSampler" && method == "sample") -> {
            1
        }
        (sketch == "TDigest" && (method == "add" || method == "quantile")) || (sketch == "ReservoirSampler" && method == "add") -> {
            2
        }
        else -> {
            return None
        }
    }
    mask := if {
        arity == 1 -> [Bool]{true}
        sketch == "TDigest" || sketch == "ReservoirSampler" -> [Bool]{true, false}
        else -> [Bool]{true, true}
    }
    Val(jet_codegen_handle_h("{sketch}.{method}", "Jet{sketch}::{method}", mask, None))
}

fn jet_codegen_handle_regex_route(kind: String, method: String) -> JetCodegenHandleRoute? {
    symbol := ""
    if {
        kind == "Regex" -> {
            if method == {
                "pattern" | "source" | "flags" | "options" | "names" -> symbol = "jet_std::JetRegex::{method}"
                "count" | "is_match" | "full_match" | "find" | "find_all" | "matches" | "split" -> symbol = "jet_std::JetRegex::{method}"
                "match" -> symbol = "jet_std::JetRegex::match_value"
                "replace" | "replace_first" | "replace_all_with" | "split_limit" -> symbol = "jet_std::JetRegex::{method}"
                else -> return None
            }
        }
        kind == "Match" -> {
            if method == {
                "start" | "end" | "named_captures" -> symbol = "jet_std::JetRegexMatch::{method}"
                "group" -> symbol = "jet_std::JetRegexMatch::group"
                "name" -> symbol = "jet_std::JetRegexMatch::name"
                "group_start" | "group_end" -> symbol = "jet_std::JetRegexMatch::{method}"
                else -> return None
            }
        }
        else -> {
            return None
        }
    }
    mask := if {
        kind == "Match" -> {
            if method == {
                "group" | "group_start" | "group_end" -> [Bool]{true, false}
                "name" -> [Bool]{true, true}
                else -> [Bool]{true}
            }
        }
        else -> {
            if method == {
                "pattern" | "source" | "flags" | "options" | "names" | "start" | "end" | "named_captures" -> [Bool]{true}
                "replace" | "replace_first" -> [Bool]{true, true, true}
                "replace_all_with" | "split_limit" -> [Bool]{true, true, false}
                else -> [Bool]{true, true}
            }
        }
    }
    Val(jet_codegen_handle_h("{kind}.{method}", symbol, mask, None))
}

fn jet_codegen_handle_url_mime_route(kind: String, method: String) -> JetCodegenHandleRoute? {
    symbol := ""
    if {
        kind == "URL" -> {
            if method == {
                "scheme" | "host" | "port" | "path" | "path_segments" | "query" | "query_pairs" | "fragment" | "normalize" | "username" | "password" | "userinfo" | "authority" | "default_port" -> {
                    symbol = "jet_std::JetURL::{method}"
                }
                "to_string" -> {
                    symbol = "jet_std::JetURL::to_string_value"
                }
                "join" | "set_query" | "add_query" -> {
                    symbol = "jet_std::JetURL::{method}"
                }
                else -> {
                    return None
                }
            }
        }
        kind == "MIME" -> {
            if method == {
                "media_type" | "subtype" | "essence" | "params" -> {
                    symbol = "jet_std::JetMIME::{method}"
                }
                "to_string" -> {
                    symbol = "jet_std::JetMIME::to_string_value"
                }
                "param" -> {
                    symbol = "jet_std::JetMIME::param"
                }
                else -> {
                    return None
                }
            }
        }
        else -> {
            return None
        }
    }
    mask := [Bool]{true}
    if {
        kind == "MIME" -> {
            if method == "param" -> mask = [Bool]{true, true}
        }
        method == "join" -> {
            mask = [Bool]{true, true}
        }
        method == "set_query" || method == "add_query" -> {
            mask = [Bool]{true, true, true}
        }
    }
    Val(jet_codegen_handle_h("{kind}.{method}", symbol, mask, None))
}

fn jet_codegen_handle_devserver_route(method: String) -> JetCodegenHandleRoute? {
    if method == {
        "html" | "port" -> return Val(jet_codegen_handle_core("core.web.devserver", method, "jet_devserver_{method}", [Bool]{true, false}, None))
        "serve" -> return Val(jet_codegen_handle_core("core.web.devserver", method, "jet_devserver_serve", [Bool]{true}, Val(Effect.Net)))
        else -> return None
    }
}

fn jet_codegen_handle_app_route(method: String, source_arg_count: Int) -> JetCodegenHandleRoute? {
    arity := 0
    if method == {
        "route" | "page" | "layout" | "form" -> {
            if {
                source_arg_count == 2 -> arity = 4
                else -> {}
            }
        }
        "loader" -> {
            if {
                source_arg_count == 2 -> arity = 4
                source_arg_count == 3 -> arity = 5
                else -> {}
            }
        }
        "pending" | "not_found" | "error" -> {
            if {
                source_arg_count == 1 -> arity = 2
                else -> {}
            }
        }
        "action" -> {
            if {
                source_arg_count == 2 -> arity = 3
                else -> {}
            }
        }
        "data" -> {
            if {
                source_arg_count == 2 -> arity = 3
                else -> {}
            }
        }
        "mount" -> {
            if {
                source_arg_count == 2 -> arity = 3
                source_arg_count == 3 -> arity = 4
                source_arg_count == 4 -> arity = 5
                else -> {}
            }
        }
        "routes" | "security" | "assets" | "split" | "code_split" | "cache" | "a11y" | "adapter" -> {
            if {
                source_arg_count == 1 -> arity = 2
                else -> {}
            }
        }
        "csr" | "ssr" | "ssg" | "stream" | "streaming" | "island" | "hydration_dev" | "hydration_release" | "facts_json" -> {
            if {
                source_arg_count == 0 -> arity = 1
                else -> {}
            }
        }
        "serve" -> {
            if {
                source_arg_count == 0 -> arity = 1
                source_arg_count == 1 -> arity = 2
                else -> {}
            }
        }
        "serve_on" -> {
            if {
                source_arg_count == 1 -> arity = 2
                else -> {}
            }
        }
        else -> {}
    }
    if arity == 0 -> return None
    mask := [Bool]{}
    index := 0
    loop index < arity {
        &mask.push(index == 0)
        index += 1
    }
    route_effect := if method == "serve" || method == "serve_on" -> Val(Effect.Net) else -> None
    symbol := "jet_app_{method}"
    if method == "loader" && source_arg_count == 3 -> symbol = "jet_app_loader_preload"
    if method == "mount" && source_arg_count == 3 -> symbol = "jet_app_mount_with_effect"
    if method == "mount" && source_arg_count == 4 -> symbol = "jet_app_mount_with_policy"
    if method == "serve" && source_arg_count == 1 -> symbol = "jet_app_serve_with_port"
    Val(jet_codegen_handle_core("core.web.app", method, symbol, mask, route_effect))
}

fn jet_codegen_handle_civil_time_route(kind: String, method: String) -> JetCodegenHandleRoute? {
    is_date := kind == "Date" || kind == "LocalDate"
    prefix := if {
        is_date -> {
            "JetDate"
        }
        kind == "LocalTime" -> {
            "JetLocalTime"
        }
        kind == "DateTime" -> {
            "JetDateTime"
        }
        kind == "Instant" -> {
            "JetInstant"
        }
        kind == "Period" -> {
            "JetPeriod"
        }
        kind == "Zone" -> {
            "JetZone"
        }
        kind == "ZonedDateTime" -> {
            "JetZonedDateTime"
        }
        else -> {
            return None
        }
    }
    valid := if {
        is_date -> {
            if method == {
                "year" | "month" | "day" | "weekday" | "iso_weekday" | "day_of_year" | "iso_week" | "iso_week_year" |
                "quarter_of_year" | "days_in_month" | "is_leap_year" | "to_string" | "add_days" | "add_months" |
                "add_period" | "subtract_period" | "diff_days" | "truncate" | "replace" | "format" | "format_checked" |
                "until" | "since" | "with" | "equal" | "compare" -> true
                else -> false
            }
        }
        kind == "LocalTime" -> {
            if method == {
                "hour" | "minute" | "second" | "millisecond" | "microsecond" | "nanosecond" | "to_string" |
                "add_duration" | "subtract_duration" | "round" | "truncate" | "floor" | "ceil" | "until" |
                "since" | "format" | "format_checked" | "equal" | "compare" -> true
                else -> false
            }
        }
        kind == "DateTime" -> {
            if method == {
                "hour" | "minute" | "second" | "millisecond" | "microsecond" | "nanosecond" | "to_timestamp" |
                "to_unix_ms" | "to_unix_s" | "to_unix_us" | "to_unix_ns" | "date" | "time" | "to_string" |
                "format_rfc3339" | "format" | "format_checked" | "plus_duration" | "subtract_duration" |
                "add_nanoseconds" | "difference" | "add_period" | "subtract_period" | "until" | "since" |
                "truncate" | "round" | "floor" | "ceil" | "replace" | "in_zone" | "with" | "equal" | "compare" -> true
                else -> false
            }
        }
        kind == "Instant" -> {
            if method == { "elapsed_millis" | "elapsed" | "equal" | "compare" -> true else -> false }
        }
        kind == "Period" -> {
            if method == { "years" | "months" | "days" | "sign" | "is_zero" | "abs" | "negated" | "add" | "sub" | "total_in" | "to_string" -> true else -> false }
        }
        kind == "Zone" -> {
            if method == { "name" | "next_transition" | "previous_transition" | "start_of_day" | "hours_in_day" -> true else -> false }
        }
        else -> {
            if method == {
                "date" | "time" | "offset_seconds" | "is_dst" | "to_datetime" | "zone" | "to_string" | "format" |
                "format_rfc9557" | "format_checked" | "add_duration" | "subtract_duration" | "add_period" |
                "subtract_period" | "with_time" | "with_zone" | "until" | "since" | "next_transition" |
                "previous_transition" | "start_of_day" | "hours_in_day" | "equal" | "compare" -> true
                else -> false
            }
        }
    }
    if !valid -> return None

    member := "{kind}.{method}"
    symbol_method := method
    if method == "to_string" -> symbol_method = "to_string_fmt"
    if method == "format" -> symbol_method = "format_pattern"
    if method == "format_checked" -> symbol_method = "format_checked_text"
    if method == "equal" -> symbol_method = "equal_value"
    if method == "compare" -> symbol_method = "compare_value"
    if method == "until" -> symbol_method = "until_duration"
    if method == "since" -> symbol_method = "since_duration"
    if {
        is_date -> {
            if method == "add_period" -> symbol_method = "add_period_value"
            if method == "subtract_period" -> symbol_method = "subtract_period_value"
            if method == "diff_days" -> symbol_method = "diff_days_value"
            if method == "with" -> symbol_method = "with_overflow"
        }
        kind == "LocalTime" -> {
            if method == "add_duration" -> symbol_method = "add_duration_value"
            if method == "subtract_duration" -> symbol_method = "subtract_duration_value"
            if method == "round" -> symbol_method = "round_with"
            if method == "truncate" || method == "floor" || method == "ceil" -> symbol_method = "{method}_with"
        }
        kind == "DateTime" -> {
            if method == "to_unix_ms" -> symbol_method = "to_unix_ms_value"
            if method == "to_unix_s" -> symbol_method = "to_unix_seconds_value"
            if method == "to_unix_us" -> symbol_method = "to_unix_microseconds_value"
            if method == "to_unix_ns" -> symbol_method = "to_unix_nanoseconds_value"
            if method == "time" -> symbol_method = "time_for_output"
            if method == "plus_duration" -> symbol_method = "plus_duration_value"
            if method == "subtract_duration" -> symbol_method = "subtract_duration_value"
            if method == "difference" -> symbol_method = "difference_duration"
            if method == "add_period" -> symbol_method = "add_period_value"
            if method == "subtract_period" -> symbol_method = "subtract_period_value"
            if method == "truncate" || method == "floor" || method == "ceil" -> symbol_method = "{method}_with"
            if method == "round" -> symbol_method = "round_with"
            if method == "in_zone" -> symbol_method = "in_zone_value"
            if method == "with" -> symbol_method = "with_overflow"
        }
        kind == "Instant" -> {
            if method == "elapsed" -> symbol_method = "elapsed_duration"
        }
        kind == "Period" -> {
            if method == "years" || method == "months" || method == "days" -> symbol_method = "{method}_value"
            if method == "add" -> symbol_method = "add_value"
            if method == "sub" -> symbol_method = "sub_value"
            if method == "total_in" -> symbol_method = "total_in_value"
        }
        kind == "Zone" -> {
            if method == "next_transition" || method == "previous_transition" || method == "start_of_day" || method == "hours_in_day" -> symbol_method = "{method}_value"
        }
        else -> {
            if method == "add_duration" -> symbol_method = "add_duration_value"
            if method == "subtract_duration" -> symbol_method = "subtract_duration_value"
            if method == "add_period" -> symbol_method = "add_period_value"
            if method == "subtract_period" -> symbol_method = "subtract_period_value"
            if method == "next_transition" || method == "previous_transition" -> symbol_method = "{method}_value"
        }
    }
    if (kind == "DateTime" && method == "to_string") || (kind == "LocalTime" && method == "to_string") || (kind == "Date" && method == "to_string") || (kind == "LocalDate" && method == "to_string") || (kind == "ZonedDateTime" && method == "to_string") || (kind == "Period" && method == "to_string") {
        symbol_method = "to_string_fmt"
    }
    if kind == "DateTime" && method == "format_rfc3339" -> symbol_method = "format_rfc3339"
    if kind == "ZonedDateTime" && method == "format_rfc9557" -> symbol_method = "format_rfc9557"
    if kind == "ZonedDateTime" && (method == "start_of_day" || method == "hours_in_day") -> symbol_method = method
    if (kind == "ZonedDateTime" && method == "with_time") || (kind == "ZonedDateTime" && method == "with_zone") -> symbol_method = method
    if kind == "DateTime" && method == "date" -> symbol_method = "date"
    if kind == "ZonedDateTime" && (method == "date" || method == "time" || method == "offset_seconds" || method == "is_dst" || method == "to_datetime" || method == "zone") -> symbol_method = method

    arity := 1
    if {
        is_date -> {
            if method == {
                "add_days" | "add_months" | "add_period" | "subtract_period" | "diff_days" | "truncate" | "format" | "format_checked" | "equal" | "compare" -> arity = 2
                "replace" -> arity = 4
                "until" | "since" -> arity = 6
                "with" -> arity = 5
                else -> {}
            }
        }
        kind == "LocalTime" -> {
            if method == {
                "add_duration" | "subtract_duration" | "format" | "format_checked" | "equal" | "compare" -> arity = 2
                "round" -> arity = 4
                "truncate" | "floor" | "ceil" -> arity = 3
                "until" | "since" -> arity = 6
                else -> {}
            }
        }
        kind == "DateTime" -> {
            if method == {
                "format" | "format_checked" | "plus_duration" | "subtract_duration" | "add_nanoseconds" | "difference" | "add_period" | "subtract_period" | "in_zone" | "equal" | "compare" -> arity = 2
                "until" | "since" -> arity = 6
                "truncate" | "floor" | "ceil" -> arity = 3
                "round" -> arity = 4
                "replace" -> arity = 7
                "with" -> arity = 8
                else -> {}
            }
        }
        kind == "Instant" -> {
            if method == "equal" || method == "compare" -> arity = 2
        }
        kind == "Period" -> {
            if method == "add" || method == "sub" -> arity = 2
            if method == "total_in" -> arity = 3
        }
        kind == "Zone" -> {
            if method != "name" -> arity = 2
        }
        kind == "ZonedDateTime" -> {
            if method == {
                "format" | "format_checked" | "add_duration" | "subtract_duration" | "add_period" | "subtract_period" | "with_zone" | "equal" | "compare" -> arity = 2
                "with_time" -> arity = 3
                "until" | "since" -> arity = 6
                else -> {}
            }
        }
        else -> {}
    }

    mask := [Bool]{}
    index := 0
    loop index < arity {
        &mask.push(index == 0)
        index += 1
    }

    if arity == 2 && (method == "format" || method == "format_checked" || method == "truncate") -> mask = [Bool]{true, true}
    if arity == 6 && (method == "until" || method == "since") -> mask = [Bool]{true, false, true, true, true, false}
    if is_date && method == "with" -> mask = [Bool]{true, false, false, false, true}
    if kind == "LocalTime" && method == "round" -> mask = [Bool]{true, true, false, true}
    if kind == "LocalTime" && (method == "truncate" || method == "floor" || method == "ceil") -> mask = [Bool]{true, true, false}
    if kind == "DateTime" && method == "replace" -> mask = [Bool]{true, false, false, false, false, false, false}
    if kind == "DateTime" && method == "with" -> mask = [Bool]{true, false, false, false, false, false, false, true}
    if kind == "DateTime" && method == "round" -> mask = [Bool]{true, true, false, true}
    if kind == "DateTime" && (method == "truncate" || method == "floor" || method == "ceil") -> mask = [Bool]{true, true, false}
    if kind == "Period" && method == "total_in" -> mask = [Bool]{true, true, true}
    if kind == "ZonedDateTime" && method == "with_time" -> mask = [Bool]{true, true, true}
    Val(jet_codegen_handle_route(MirPreludeFamily.HandleMethod, "core.time", member, "{prefix}::{symbol_method}", mask, None, MirPreludeAbi.Value))
}

fn jet_codegen_handle_dynamic_route(operation: THandleOp, receiver: Type, argument_count: Int, carrier: TFailureCarrier) -> JetCodegenHandleRoute? {
    if operation == {
        .HTTPServerMethod(kind, method) -> {
            route :: jet_codegen_browser_handle_route(kind, method, argument_count, true)
            if route != None -> return route
        }
        .HTTPClientMethod(kind, method) -> {
            route :: jet_codegen_browser_handle_route(kind, method, argument_count, false)
            if route != None -> return route
        }
        else -> {}
    }
    if operation == {
        .AllocAlloc | .AllocTryAlloc | .AllocReset -> {
            allocator := jet_codegen_handle_allocator_name(receiver)
            member := "alloc"
            symbol := "jet_mem::Jet{allocator}::alloc"
            mask := [Bool]{true, false}
            if operation == {
                .AllocTryAlloc -> {
                    member = "try_alloc"
                    symbol = "jet_mem::Jet{allocator}::try_alloc"
                }
                .AllocReset -> {
                    member = "reset"
                    symbol = "jet_mem::Jet{allocator}::reset"
                    mask = [Bool]{true}
                }
                else -> {}
            }
            return Val(jet_codegen_handle_h("{allocator}.{member}", symbol, mask, Val(Effect.Mem)))
        }
        .ReactiveGet -> return jet_codegen_handle_reactive_route(receiver, "get")
        .ReactiveSet -> return jet_codegen_handle_reactive_route(receiver, "set")
        .TaskJoin -> return Val(jet_codegen_handle_task_route(receiver))
        .PreciseMethod(type_name, method) -> return jet_codegen_handle_precise_route(type_name, method)
        .MathMethod(type_name, method, reduce_op) -> return jet_codegen_handle_math_route(type_name, method, reduce_op)
        .EventMethod(method) -> return jet_codegen_handle_event_route(receiver, method, carrier)
        .WatchMethod(method, _) -> return jet_codegen_handle_watch_route(receiver, method)
        .MeasurementMethod(method) -> return jet_codegen_handle_measurement_route(method)
        .LayoutMethod(method) -> return jet_codegen_handle_layout_route(method)
        .LoadableMethod(method) -> return jet_codegen_handle_loadable_route(method)
        .UiBackendMethod(method) -> return jet_codegen_handle_ui_route(receiver, method)
        .SketchMethod(sketch, method) -> return jet_codegen_handle_sketch_route(sketch, method)
        .CivilTimeMethod(kind, method) -> return jet_codegen_handle_civil_time_route(kind, method)
        .UrlMimeMethod(kind, method) -> return jet_codegen_handle_url_mime_route(kind, method)
        .RegexMethod(kind, method) -> return jet_codegen_handle_regex_route(kind, method)
        .DevServerMethod(method) -> return jet_codegen_handle_devserver_route(method)
        .AppMethod(method, source_arg_count) -> return jet_codegen_handle_app_route(method, source_arg_count)
        .ProcessChildMethod(method) -> {
            if method == {
                "id" -> return Val(jet_codegen_handle_h("process.child.id", "jet_process_child_id", [Bool]{true}, None))
                "wait" -> return Val(jet_codegen_handle_h("process.child.wait", "jet_process_child_wait", [Bool]{true}, Val(Effect.Exec)))
                "exited" -> return Val(jet_codegen_handle_h("process.child.exited", "jet_process_child_exited", [Bool]{true}, Val(Effect.Exec)))
                "kill" -> return Val(jet_codegen_handle_h("process.child.kill", "jet_process_child_kill", [Bool]{true}, Val(Effect.Exec)))
                "terminate" -> return Val(jet_codegen_handle_h("process.child.terminate", "jet_process_child_terminate", [Bool]{true}, Val(Effect.Exec)))
                "interrupt" -> return Val(jet_codegen_handle_h("process.child.interrupt", "jet_process_child_interrupt", [Bool]{true}, Val(Effect.Exec)))
                else -> return None
            }
        }
        .ProcessSpecMethod(method, declared_count) -> {
            if declared_count != argument_count -> return None
            if method == {
                "cwd" -> return Val(jet_codegen_handle_h("process.spec.cwd", "jet_process_spec_cwd", [Bool]{false, true}, None))
                "arg" -> return Val(jet_codegen_handle_h("process.spec.arg", "jet_process_spec_arg", [Bool]{false, true}, None))
                "args_extend" -> return Val(jet_codegen_handle_h("process.spec.args_extend", "jet_process_spec_args_extend", [Bool]{false, true}, None))
                "env" -> return Val(jet_codegen_handle_h("process.spec.env", "jet_process_spec_env", [Bool]{false, true, true}, None))
                "env_remove" -> return Val(jet_codegen_handle_h("process.spec.env_remove", "jet_process_spec_env_remove", [Bool]{false, true}, None))
                "env_clear" -> return Val(jet_codegen_handle_h("process.spec.env_clear", "jet_process_spec_env_clear", [Bool]{false}, None))
                "stdin" -> return Val(jet_codegen_handle_h("process.spec.stdin", "jet_process_spec_stdin", [Bool]{false, true}, None))
                "stdout" -> return Val(jet_codegen_handle_h("process.spec.stdout", "jet_process_spec_stdout", [Bool]{false, true}, None))
                "stderr" -> return Val(jet_codegen_handle_h("process.spec.stderr", "jet_process_spec_stderr", [Bool]{false, true}, None))
                "timeout" -> return Val(jet_codegen_handle_h("process.spec.timeout", "jet_process_spec_timeout", [Bool]{false, true}, None))
                "output_limit" -> return Val(jet_codegen_handle_h("process.spec.output_limit", "jet_process_spec_output_limit", [Bool]{false, false}, None))
                "cpu_time_limit" -> return Val(jet_codegen_handle_h("process.spec.cpu_time_limit", "jet_process_spec_cpu_time_limit", [Bool]{false, true}, None))
                "memory_limit" -> return Val(jet_codegen_handle_h("process.spec.memory_limit", "jet_process_spec_memory_limit", [Bool]{false, false}, None))
                "open_file_limit" -> return Val(jet_codegen_handle_h("process.spec.open_file_limit", "jet_process_spec_open_file_limit", [Bool]{false, false}, None))
                "detached" -> return Val(jet_codegen_handle_h("process.spec.detached", "jet_process_spec_detached", [Bool]{false}, None))
                "terminal" -> {
                    if argument_count == 0 -> return Val(jet_codegen_handle_h("process.spec.terminal", "jet_process_spec_terminal", [Bool]{false}, None))
                    if argument_count == 1 -> return Val(jet_codegen_handle_h("process.spec.terminal_with_policy", "jet_process_spec_terminal_with_policy", [Bool]{false, true}, None))
                    return None
                }
                "abilities" -> return Val(jet_codegen_handle_h("process.spec.abilities", "jet_process_spec_abilities", [Bool]{true}, None))
                "under" -> return Val(jet_codegen_handle_h("process.spec.under", "jet_std_process_spec_under", [Bool]{false, true}, None))
                "plan" -> return Val(jet_codegen_handle_h("process.spec.plan", "jet_process_spec_plan", [Bool]{true}, None))
                "run" -> return Val(jet_codegen_handle_h("process.spec.run", "jet_process_spec_run", [Bool]{true}, Val(Effect.Exec)))
                "run_checked" -> return Val(jet_codegen_handle_h("process.spec.run_checked", "jet_process_spec_run_checked", [Bool]{true}, Val(Effect.Exec)))
                "spawn" -> return Val(jet_codegen_handle_h("process.spec.spawn", "jet_process_spec_spawn", [Bool]{true}, Val(Effect.Exec)))
                else -> return None
            }
        }
        .ExpiringMethod(method) -> {
            if method == "get" -> return Val(jet_codegen_handle_h("expiring.get", "jet_expiring_get", [Bool]{true, true}, Val(Effect.Time)))
            return None
        }
        .HTTPServerMethod(kind, method) -> {
            if kind == "WsConn" {
                if method == {
                    "send_text" -> return Val(jet_codegen_handle_h("ws.send_text", "jet_ws_send_text", [Bool]{true, true}, Val(Effect.Net)))
                    "send_bytes" -> return Val(jet_codegen_handle_h("ws.send_bytes", "jet_ws_send_binary", [Bool]{true, true}, Val(Effect.Net)))
                    "close" -> return Val(jet_codegen_handle_h("ws.close", "jet_ws_close", [Bool]{true, false, true}, Val(Effect.Net)))
                    else -> return None
                }
            }
            if kind == "WsMessage" {
                if method == {
                    "is_text" -> return Val(jet_codegen_handle_h("ws.message_is_text", "jet_ws_message_is_text", [Bool]{true}, None))
                    "is_binary" -> return Val(jet_codegen_handle_h("ws.message_is_binary", "jet_ws_message_is_binary", [Bool]{true}, None))
                    "is_close" -> return Val(jet_codegen_handle_h("ws.message_is_close", "jet_ws_message_is_close", [Bool]{true}, None))
                    "bytes" -> return Val(jet_codegen_handle_h("ws.message_bytes", "jet_ws_message_bytes", [Bool]{true}, None))
                    else -> return None
                }
            }
            if kind == "HTTPMux" && method == "middleware" -> return Val(jet_codegen_handle_h("http_mux.middleware", "jet_http_mux_middleware", [Bool]{true, false}, Val(Effect.Net)))
            if kind == "HTTPServer" {
                if method == {
                    "local_addr" -> return Val(jet_codegen_handle_h("http_server.local_addr", "jet_http_server_local_addr", [Bool]{true}, Val(Effect.Net)))
                    "serve" -> return Val(jet_codegen_handle_h("http_server.serve", "jet_http_server_serve", [Bool]{true}, Val(Effect.Net)))
                    "wait" -> return Val(jet_codegen_handle_h("http_server.wait", "jet_http_server_wait", [Bool]{true}, Val(Effect.Net)))
                    "shutdown" -> return Val(jet_codegen_handle_h("http_server.shutdown", "jet_http_server_shutdown", [Bool]{true, true}, Val(Effect.Net)))
                    else -> return None
                }
            }
            return None
        }
        else -> None
    }
}

fn jet_codegen_general_handle_route(operation: THandleOp, receiver: Type, argument_count: Int, carrier: TFailureCarrier) -> JetCodegenHandleRoute? {
    dynamic := jet_codegen_handle_dynamic_route(operation, receiver, argument_count, carrier)
    if dynamic != None -> return dynamic
    if operation == {
        .DurationNew(unit, is_float) -> {
            symbol := if is_float -> "jet_duration_from_float" else -> "jet_duration_from_int"
            return Val(jet_codegen_handle_core("core.time", "duration_new", symbol, [Bool]{false, false}, None))
        }
        .FileReaderReadLine -> return Val(jet_codegen_handle_h("file_reader.read_line", "jet_std_file_reader_read_line", [Bool]{true}, Val(Effect.FS)))
        .FileReaderPath -> return Val(jet_codegen_handle_h("file_reader.path", "jet_std_file_reader_path", [Bool]{true}, None))
        .MappedFileWindow -> return Val(jet_codegen_handle_h("mapped_file.window", "jet_std_fs_map_window_view", [Bool]{true, false, false}, Val(Effect.FS)))
        .MappedFileWindowLen -> return Val(jet_codegen_handle_h("mapped_file.window_len", "jet_std_fs_map_window_len_view", [Bool]{true, false, false}, Val(Effect.FS)))
        .MappedFileLines -> return Val(jet_codegen_handle_h("mapped_file.lines", "jet_std_fs_map_lines_view", [Bool]{true}, Val(Effect.FS)))
        .MappedFileLen -> return Val(jet_codegen_handle_h("mapped_file.len", "jet_std_fs_map_len", [Bool]{true}, None))
        .MappedFileIsEmpty -> return Val(jet_codegen_handle_h("mapped_file.is_empty", "jet_std_fs_map_is_empty", [Bool]{true}, None))
        .FileWriterWriteLine -> return Val(jet_codegen_handle_h("file_writer.write_line", "jet_std_file_writer_write_line", [Bool]{true, true}, Val(Effect.FS)))
        .FileWriterFlush -> return Val(jet_codegen_handle_h("file_writer.flush", "jet_std_file_writer_flush", [Bool]{true}, Val(Effect.FS)))
        .FileWriterPath -> return Val(jet_codegen_handle_h("file_writer.path", "jet_std_file_writer_path", [Bool]{true}, None))
        .JSONReaderNext -> return Val(jet_codegen_handle_h("json_reader.next", "jet_enc_json_reader_next", [Bool]{true}, Val(Effect.IO)))
