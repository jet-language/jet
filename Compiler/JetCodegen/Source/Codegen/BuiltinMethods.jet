// Canonical lowering for closed TIR builtin-method operations.
use jet_foundation.[
    Effect,
    MIRAccess,
    MIRCallArg,
    MIRCallFallibility,
    MIRConstant,
    MIRConversion,
    MIRFieldID,
    MIRFieldValue,
    MIRIntegerWidth,
    MIRLoopSourceKind,
    MIROperation,
    MIRPanicLoc,
    MIRPhiIncoming,
    MIRPlaceID,
    MIRPreludeABI,
    MIRPreludeCallID,
    MIRPreludeFamily,
    MIRPreludeTypeArg,
    MIRSemanticOp,
    MIRSourceFile,
    MIRStringFormat,
    MIRStringPart,
    MIRStringPartKind,
    MIRTerminator,
    MIRType,
    MIRValueID,
    Span,
    SymbolID,
    SymbolKind,
    TBuiltinOp,
    TCapture,
    TCaptureFacts,
    TClosureOp,
    TDestructureBinding,
    TEffectFacts,
    TEffectSpan,
    TExpr,
    TExprKind,
    TFailureCarrier,
    TLambda,
    TLambdaBody,
    TListRemoveMode,
    TNumericOp,
    TStmt,
    TZipFillMode,
    TZipMode,
    Type,
    TypeTupleField,
    mir_source_file_id,
    symbol_id,
    tir_generated_local,
    tir_symbol_local,
]

struct JetCodegenBuiltinRoute {
    pub module_name: String
    pub member: String
    pub symbol: String
    pub arity: Int
    pub borrow_mask: [Bool]
    pub effect_kind: Effect?
    pub abi: MIRPreludeABI
}

fn jet_codegen_builtin_route_row(module_name: String, member: String, symbol: String, arity: Int, borrow_mask: [Bool], route_effect: Effect?, abi: MIRPreludeABI) -> JetCodegenBuiltinRoute Never! {
    JetCodegenBuiltinRoute{module_name: module_name, member: member, symbol: symbol, arity: arity, borrow_mask: borrow_mask, effect_kind: route_effect, abi: abi}
}

fn jet_codegen_builtin_route(member: String, symbol: String, arity: Int, borrow_mask: [Bool], route_effect: Effect?) -> JetCodegenBuiltinRoute Never! {
    jet_codegen_builtin_route_row("core.builtin", member, symbol, arity, borrow_mask, route_effect, MIRPreludeABI.Value)
}

fn jet_codegen_builtin_untag(ty: Type) -> Type Never! {
    if ty == {
        .Tagged(_, inner) -> return jet_codegen_builtin_untag(inner)
        else -> return ~ty
    }
}

fn jet_codegen_builtin_string_receiver(ty: Type) -> Bool Never! {
    jet_codegen_builtin_untag(ty) == Type.String
}

fn jet_codegen_builtin_iter_receiver(ty: Type) -> Bool Never! {
    if jet_codegen_builtin_untag(ty) == {
        .Apply(name, args) -> return args.len() == 1 && (name == "Iter" || name == "ViewIter")
        else -> return false
    }
}

fn jet_codegen_builtin_mutates_receiver(operation: TBuiltinOp) -> Bool Never! {
    if operation == {
        .Push | .TryPush | .TryReserve | .TryInsertMap | .TryStringPush | .Pop
        | .InsertMap | .AddNewMap | .MapSetDefault | .MapUpdate | .InsertList | .RemoveMap
        | .RemoveList(_, _) | .MapPopFirst | .ExtendList | .Reverse | .Sort | .SortDesc | .Clear
        | .SetInsert | .SetUpdate | .SetDifferenceUpdate | .SetIntersectionUpdate
        | .SetSymmetricDifferenceUpdate | .SetRemove | .SetPop | .SetReplace | .SortedSetInsert
        | .SortedSetRemove | .BitSetAdd | .BitSetRemove | .BagAdd | .BagRemove | .LRUPut
        | .LRUAddNew | .LRUGet | .LRURemove | .DequePushFront | .DequePushBack | .DequePopFront
        | .DequePopBack | .DequeDelete | .DequeReverse | .DequeSplit | .SplitWrite(_) | .GetDisjointWrite
        | .PriorityQueuePop | .PriorityQueueRemove(_, _) | .ViewMutNew(_) | .IterNext -> return true
        .ByteBufferWrite(_) -> return true
        .ByteBufferMethod(method) -> return method == "clear" || method == "seek" || method == "rewind" || method == "next" || method == "read" || method == "read_byte" || method == "read_bytes" || method == "read_string" || method == "flush" || method == "close" || method == "shutdown" || method == "copy_to" || method == "write_to"
        else -> return false
    }
}

fn jet_codegen_builtin_route_for_receiver(operation: TBuiltinOp, receiver: Type, carrier: TFailureCarrier) -> JetCodegenBuiltinRoute Never! {
    ty := jet_codegen_builtin_untag(receiver)
    if operation == {
        .Clear -> {
            if ty == {
                .Apply(name, _) -> {
                    if name == "Set" -> return jet_codegen_builtin_route("set_clear", "std::collections::HashSet::clear", 1, [Bool]{true}, Val(Effect.Mem))
                    if name == "Rank" -> return jet_codegen_builtin_route("sorted_set_clear", "std::collections::BTreeSet::clear", 1, [Bool]{true}, Val(Effect.Mem))
                    if name == "Tally" -> return jet_codegen_builtin_route("bag_clear", "std::collections::HashMap::clear", 1, [Bool]{true}, Val(Effect.Mem))
                    if name == "Cache" -> return jet_codegen_builtin_route("lru_clear", "JetCache::clear", 1, [Bool]{true}, Val(Effect.Mem))
                    if name == "Queue" -> return jet_codegen_builtin_route("deque_clear", "std::collections::VecDeque::clear", 1, [Bool]{true}, Val(Effect.Mem))
                    if name == "PriorityQueue" -> return jet_codegen_builtin_route("priority_queue_clear", "std::collections::BinaryHeap::clear", 1, [Bool]{true}, Val(Effect.Mem))
                }
                else -> {}
            }
            if ty == {
                .Map(_, _, _) -> return jet_codegen_builtin_route("map_clear", "std::collections::HashMap::clear", 1, [Bool]{true}, Val(Effect.Mem))
                else -> {}
            }
            if ty == {
                .Named(name) -> {
                    if name == "Bits" -> return jet_codegen_builtin_route("bit_set_clear", "JetBitSet::clear", 1, [Bool]{true}, Val(Effect.Mem))
                }
                else -> {}
            }
            return jet_codegen_builtin_route("list_clear", "jet_list_clear", 1, [Bool]{true}, Val(Effect.Mem))
        }
        else -> {}
    }
    if operation == {
        .LenList -> {
            if ty == {
                .List(_) | .FixedList(_, _) -> return jet_codegen_builtin_route("len", "jet_list_len", 1, [Bool]{true}, None)
                .Map(_, _, _) -> return jet_codegen_builtin_route("len", "jet_map_len", 1, [Bool]{true}, None)
                .String -> return jet_codegen_builtin_route("len", "jet_char_len", 1, [Bool]{true}, None)
                .Apply(name, _) -> {
                    if name == "Iter" || name == "ViewIter" -> return jet_codegen_builtin_route("len", "jet_iter_len", 1, [Bool]{false}, None)
                    if name == "View" || name == "ViewMut" || name == "ComputeViewMut" -> return jet_codegen_builtin_route("len", "jet_list_len", 1, [Bool]{true}, None)
                    if name == "Set" -> return jet_codegen_builtin_route("len", "jet_set_len", 1, [Bool]{true}, None)
                    if name == "Rank" -> return jet_codegen_builtin_route("len", "jet_sorted_set_len", 1, [Bool]{true}, None)
                    if name == "PriorityQueue" -> return jet_codegen_builtin_route("len", "jet_priority_queue_len", 1, [Bool]{true}, None)
                    if name == "Cache" -> return jet_codegen_builtin_route("len", "jet_lru_len", 1, [Bool]{true}, None)
                    if name == "Tally" -> return jet_codegen_builtin_route("len", "jet_bag_len", 1, [Bool]{true}, None)
                    if name == "Queue" -> return jet_codegen_builtin_route("len", "jet_deque_len", 1, [Bool]{true}, None)
                }
                .Named(name) -> {
                    if name == "Bits" -> return jet_codegen_builtin_route("len", "jet_bit_set_len", 1, [Bool]{true}, None)
                }
                else -> {}
            }
        }
        .IsEmpty -> {
            if ty == {
                .List(_) | .FixedList(_, _) -> return jet_codegen_builtin_route("is_empty", "jet_list_is_empty", 1, [Bool]{true}, None)
                .Map(_, _, _) -> return jet_codegen_builtin_route("is_empty", "jet_map_is_empty", 1, [Bool]{true}, None)
                .String -> return jet_codegen_builtin_route("is_empty", "jet_string_is_empty", 1, [Bool]{true}, None)
                .Apply(name, _) -> {
                    if name == "Iter" || name == "ViewIter" -> return jet_codegen_builtin_route("is_empty", "jet_iter_is_empty", 1, [Bool]{false}, None)
                    if name == "View" || name == "ViewMut" || name == "ComputeViewMut" -> return jet_codegen_builtin_route("is_empty", "jet_list_is_empty", 1, [Bool]{true}, None)
                    if name == "Set" -> return jet_codegen_builtin_route("is_empty", "jet_set_is_empty", 1, [Bool]{true}, None)
                    if name == "Rank" -> return jet_codegen_builtin_route("is_empty", "jet_sorted_set_is_empty", 1, [Bool]{true}, None)
                    if name == "PriorityQueue" -> return jet_codegen_builtin_route("is_empty", "jet_priority_queue_is_empty", 1, [Bool]{true}, None)
                    if name == "Cache" -> return jet_codegen_builtin_route("is_empty", "jet_lru_is_empty", 1, [Bool]{true}, None)
                    if name == "Tally" -> return jet_codegen_builtin_route("is_empty", "jet_bag_is_empty", 1, [Bool]{true}, None)
                    if name == "Queue" -> return jet_codegen_builtin_route("is_empty", "jet_deque_is_empty", 1, [Bool]{true}, None)
                }
                .Named(name) -> {
                    if name == "Bits" -> return jet_codegen_builtin_route("is_empty", "jet_bit_set_is_empty", 1, [Bool]{true}, None)
                }
                else -> {}
            }
        }
        .GetList -> {
            if ty == {
                .List(_) | .FixedList(_, _) -> return jet_codegen_builtin_route("get", "jet_list_get_opt", 2, [Bool]{true, false}, None)
                else -> {}
            }
            if ty == {
                .Apply(name, _) -> {
                    if name == "View" || name == "ViewMut" || name == "ComputeViewMut" -> return jet_codegen_builtin_route("get", "jet_list_get_opt", 2, [Bool]{true, false}, None)
                }
                else -> {}
            }
        }
        .GetMap -> {
            if ty == {
                .Map(_, _, _) -> return jet_codegen_builtin_route("get", "jet_map_get_opt", 2, [Bool]{true, true}, None)
                else -> {}
            }
        }
        .ContainsKey -> {
            if ty == {
                .Map(_, _, _) -> return jet_codegen_builtin_route("map_has_key", "jet_map_has_key", 2, [Bool]{true, true}, None)
                else -> {}
            }
            if ty == {
                .Apply(name, _) -> {
                    if name == "Cache" -> return jet_codegen_builtin_route("lru_has", "jet_lru_has", 2, [Bool]{true, false}, None)
                }
                else -> {}
            }
        }
        .SetShuffle -> {
            if ty == {
                .Apply(name, _) -> {
                    if name == "Set" -> return jet_codegen_builtin_route("shuffle", "jet_set_shuffle", 1, [Bool]{true}, None)
                }
                else -> {}
            }
        }
        .Max(max) -> {
            if !max {
                if ty == {
                    .Apply(name, _) -> {
                        if name == "Set" -> return jet_codegen_builtin_route("max", "jet_set_max", 1, [Bool]{true}, None)
                    }
                    else -> {}
                }
                return jet_codegen_builtin_route("max", "jet_list_max", 1, [Bool]{false}, None)
            }
        }
        .First -> {
            if ty == {
                .List(_) | .FixedList(_, _) -> return jet_codegen_builtin_route("first", "jet_list_first", 1, [Bool]{true}, None)
                else -> {}
            }
            if jet_codegen_builtin_iter_receiver(ty) -> return jet_codegen_builtin_route("first", "jet_iter_first", 1, [Bool]{false}, None)
            if ty == {
                .Apply(name, _) -> {
                    if name == "View" || name == "ViewMut" || name == "ComputeViewMut" -> return jet_codegen_builtin_route("first", "jet_list_first", 1, [Bool]{true}, None)
                }
                else -> {}
            }
            if ty == {
                .Apply(name, _) -> {
                    if name == "Rank" -> return jet_codegen_builtin_route("first", "jet_sorted_set_first", 1, [Bool]{true}, None)
                }
                else -> {}
            }
        }
        .Last -> {
            if ty == {
                .List(_) | .FixedList(_, _) -> return jet_codegen_builtin_route("last", "jet_list_last", 1, [Bool]{true}, None)
                else -> {}
            }
            if ty == {
                .Apply(name, _) -> {
                    if name == "View" || name == "ViewMut" || name == "ComputeViewMut" -> return jet_codegen_builtin_route("last", "jet_list_last", 1, [Bool]{true}, None)
                }
                else -> {}
            }
            if ty == {
                .Apply(name, _) -> {
                    if name == "Rank" -> return jet_codegen_builtin_route("last", "jet_sorted_set_last", 1, [Bool]{true}, None)
                }
                else -> {}
            }
        }
        .Contains -> {
            if jet_codegen_builtin_string_receiver(ty) -> return jet_codegen_builtin_route("contains", "jet_string_contains", 2, [Bool]{true, true}, None)
            if ty == {
                .List(_) | .FixedList(_, _) -> return jet_codegen_builtin_route("contains", "jet_list_contains", 2, [Bool]{true, true}, None)
                else -> {}
            }
            if ty == {
                .Apply(name, _) -> {
                    if name == "Set" -> return jet_codegen_builtin_route("contains", "jet_set_has", 2, [Bool]{true, true}, None)
                }
                else -> {}
            }
            if ty == {
                .Named(name) -> {
                    if name == "Range" || name == "Bits" -> return jet_codegen_builtin_route(if name == "Range" -> "contains" else -> "bit_set_has", if name == "Range" -> "jet_range_contains" else -> "jet_bit_set_has", 2, [Bool]{true, false}, None)
                }
                else -> {}
            }
            if ty == {
                .InlineRange(_, _, _) -> return jet_codegen_builtin_route("contains", "jet_range_contains", 2, [Bool]{true, false}, None)
                else -> {}
            }
            if ty == {
                .Apply(name, _) -> {
                    if name == "Rank" -> return jet_codegen_builtin_route("sorted_set_has", "std::collections::BTreeSet::contains", 2, [Bool]{true, true}, None)
                }
                else -> {}
            }
            if ty == {
                .Apply(name, _) -> {
                    if name == "View" || name == "ViewMut" || name == "ComputeViewMut" -> return jet_codegen_builtin_route("contains", "jet_list_contains", 2, [Bool]{true, true}, None)
                }
                else -> {}
            }
        }
        .StartsWith -> {
            if jet_codegen_builtin_string_receiver(ty) -> return jet_codegen_builtin_route("string_starts_with", "jet_string_starts_with", 2, [Bool]{true, true}, None)
            return jet_codegen_builtin_route("list_starts_with", "jet_list_starts_with", 2, [Bool]{true, true}, None)
        }
        .EndsWith -> {
            if jet_codegen_builtin_string_receiver(ty) -> return jet_codegen_builtin_route("string_ends_with", "jet_string_ends_with", 2, [Bool]{true, true}, None)
            return jet_codegen_builtin_route("list_ends_with", "jet_list_ends_with", 2, [Bool]{true, true}, None)
        }
        .DequeCapacity -> {
            if ty == {
                .Apply(name, _) -> {
                    if name == "Queue" -> return jet_codegen_builtin_route("capacity", "jet_deque_capacity", 1, [Bool]{true}, None)
                }
                else -> {}
            }
        }
        .SetCapacity -> {
            if ty == {
                .Apply(name, _) -> {
                    if name == "Set" -> return jet_codegen_builtin_route("capacity", "jet_set_capacity", 1, [Bool]{true}, None)
                }
                else -> {}
            }
        }
        .ListUnion -> {
            if ty == {
                .List(_) | .FixedList(_, _) -> return jet_codegen_builtin_route("union", "jet_list_union", 2, [Bool]{true, true}, None)
                else -> {}
            }
        }
        .ListIntersection -> {
            if ty == {
                .List(_) | .FixedList(_, _) -> return jet_codegen_builtin_route("intersection", "jet_list_intersection", 2, [Bool]{true, true}, None)
                else -> {}
            }
        }
        .ListDifference -> {
            if ty == {
                .List(_) | .FixedList(_, _) -> return jet_codegen_builtin_route("difference", "jet_list_difference", 2, [Bool]{true, true}, None)
                else -> {}
            }
        }
        .ListRandom -> {
            if ty == {
                .List(_) | .FixedList(_, _) -> return jet_codegen_builtin_route("random", "jet_list_random", 1, [Bool]{true}, None)
                else -> {}
            }
        }
        .MapFromKeys -> {
            key := ty
            if ty == {
                .List(inner) -> {
                    key = jet_codegen_builtin_untag(inner)
                }
                else -> {}
            }
            if ty == {
                .FixedList(inner, _) -> {
                    key = jet_codegen_builtin_untag(inner)
                }
                else -> {}
            }
            symbol := if key == {
                .String -> "jet_map_from_keys_kernel"
                .Int | .IntN(_, _) -> "jet_map_from_keys_int"
                else -> "jet_map_from_keys_composite"
            }
            return jet_codegen_builtin_route("map_from_keys", symbol, 2, [Bool]{false, false}, None)
        }
        else -> {}
    }
    panic("checked receiver-sensitive TBuiltinOp has no canonical route for its receiver type")
}

fn jet_codegen_builtin_container_route(operation: TBuiltinOp) -> JetCodegenBuiltinRoute Never! {
    if operation == {
        .SetFrom -> return jet_codegen_builtin_route("set_from", "jet_set_from", 1, [Bool]{false}, None)
        .SetToList -> return jet_codegen_builtin_route("set_to_list", "jet_set_to_list", 1, [Bool]{true}, None)
        .SetSort -> return jet_codegen_builtin_route("set_sort", "jet_set_sort", 1, [Bool]{true}, None)
        .SetEqual -> return jet_codegen_builtin_route("set_equal", "jet_set_equal", 2, [Bool]{true, true}, None)
        .SetFirst -> return jet_codegen_builtin_route("set_first", "jet_set_first", 1, [Bool]{true}, None)
        .SetValues -> return jet_codegen_builtin_route("set_values", "jet_set_values", 1, [Bool]{true}, None)
        .SetPop -> return jet_codegen_builtin_route("set_pop", "jet_set_pop_kernel", 2, [Bool]{true, true}, Val(Effect.Mem))
        .SetReplace -> return jet_codegen_builtin_route("set_replace", "jet_set_replace_kernel", 2, [Bool]{true, false}, Val(Effect.Mem))
        .SetInsert -> return jet_codegen_builtin_route("set_insert", "jet_set_insert", 2, [Bool]{true, false}, Val(Effect.Mem))
        .SetUpdate -> return jet_codegen_builtin_route("set_update", "jet_set_update", 2, [Bool]{true, true}, Val(Effect.Mem))
        .SetDifferenceUpdate -> return jet_codegen_builtin_route("set_difference_update", "jet_set_difference_update", 2, [Bool]{true, true}, Val(Effect.Mem))
        .SetIntersectionUpdate -> return jet_codegen_builtin_route("set_intersection_update", "jet_set_intersection_update", 2, [Bool]{true, true}, Val(Effect.Mem))
        .SetSymmetricDifferenceUpdate -> return jet_codegen_builtin_route("set_symmetric_difference_update", "jet_set_symmetric_difference_update", 2, [Bool]{true, true}, Val(Effect.Mem))
        .SetRemove -> return jet_codegen_builtin_route("set_remove", "jet_set_remove", 2, [Bool]{true, false}, Val(Effect.Mem))
        .SetUnion -> return jet_codegen_builtin_route("set_union", "jet_set_union", 2, [Bool]{true, true}, None)
        .SetIntersection -> return jet_codegen_builtin_route("set_intersection", "jet_set_intersection", 2, [Bool]{true, true}, None)
        .SetDifference -> return jet_codegen_builtin_route("set_difference", "jet_set_difference", 2, [Bool]{true, true}, None)
        .SetSymmetricDifference -> return jet_codegen_builtin_route("set_symmetric_difference", "jet_set_symmetric_difference", 2, [Bool]{true, true}, None)
        .SetIsSubset -> return jet_codegen_builtin_route("set_is_subset", "jet_set_is_subset", 2, [Bool]{true, true}, None)
        .SetIsSuperset -> return jet_codegen_builtin_route("set_is_superset", "jet_set_is_superset", 2, [Bool]{true, true}, None)
        .SetIsDisjoint -> return jet_codegen_builtin_route("set_is_disjoint", "jet_set_is_disjoint", 2, [Bool]{true, true}, None)
        .SortedSetFrom -> return jet_codegen_builtin_route("sorted_set_from", "jet_sorted_set_from", 1, [Bool]{false}, None)
        .SortedSetToList -> return jet_codegen_builtin_route("sorted_set_to_list", "jet_sorted_set_to_list", 1, [Bool]{true}, None)
        .SortedSetInsert -> return jet_codegen_builtin_route("sorted_set_insert", "jet_sorted_set_insert", 2, [Bool]{true, false}, Val(Effect.Mem))
        .SortedSetRemove -> return jet_codegen_builtin_route("sorted_set_remove", "jet_sorted_set_remove", 2, [Bool]{true, false}, Val(Effect.Mem))
        .SortedSetUnion -> return jet_codegen_builtin_route("sorted_set_union", "jet_sorted_set_union", 2, [Bool]{true, true}, None)
        .SortedSetIntersection -> return jet_codegen_builtin_route("sorted_set_intersection", "jet_sorted_set_intersection", 2, [Bool]{true, true}, None)
        .SortedSetDifference -> return jet_codegen_builtin_route("sorted_set_difference", "jet_sorted_set_difference", 2, [Bool]{true, true}, None)
        .SortedSetSymmetricDifference -> return jet_codegen_builtin_route("sorted_set_symmetric_difference", "jet_sorted_set_symmetric_difference", 2, [Bool]{true, true}, None)
        .SortedSetIsSubset -> return jet_codegen_builtin_route("sorted_set_is_subset", "jet_sorted_set_is_subset", 2, [Bool]{true, true}, None)
        .SortedSetIsSuperset -> return jet_codegen_builtin_route("sorted_set_is_superset", "jet_sorted_set_is_superset", 2, [Bool]{true, true}, None)
        .SortedSetIsDisjoint -> return jet_codegen_builtin_route("sorted_set_is_disjoint", "jet_sorted_set_is_disjoint", 2, [Bool]{true, true}, None)
        .PriorityQueueFrom -> return jet_codegen_builtin_route("priority_queue_from", "jet_priority_queue_from", 1, [Bool]{false}, None)
        .PriorityQueuePeek -> return jet_codegen_builtin_route("priority_queue_peek", "jet_priority_queue_peek", 1, [Bool]{true}, None)
        .PriorityQueueToSortedList -> return jet_codegen_builtin_route("priority_queue_to_sorted_list", "jet_priority_queue_to_sorted_list", 1, [Bool]{true}, None)
        .PriorityQueueRemove(_, mode) -> {
            if mode == {
                .Value -> return jet_codegen_builtin_route("priority_queue_remove_value", "jet_priority_queue_remove_value", 2, [Bool]{true, false}, Val(Effect.Mem))
                .Slot -> return jet_codegen_builtin_route("priority_queue_remove_slot", "jet_priority_queue_remove_slot_canonical", 2, [Bool]{true, false}, Val(Effect.Mem))
                .Dynamic -> panic("dynamic priority queue removal requires structural lowering")
            }
        }
        .LRUPut -> return jet_codegen_builtin_route("lru_put", "jet_lru_put", 3, [Bool]{true, false, false}, Val(Effect.Mem))
        .LRUAddNew -> return jet_codegen_builtin_route("lru_add_new", "jet_lru_add_new", 3, [Bool]{true, false, false}, Val(Effect.Mem))
        .LRUGet -> return jet_codegen_builtin_route("lru_get", "jet_lru_get", 2, [Bool]{true, false}, Val(Effect.Mem))
        .LRUKeys -> return jet_codegen_builtin_route("lru_keys", "jet_lru_keys", 1, [Bool]{true}, None)
        .BitSetAdd -> return jet_codegen_builtin_route("bitset_add", "jet_bitset_add", 2, [Bool]{true, false}, Val(Effect.Mem))
        .LRUCapacity -> return jet_codegen_builtin_route("lru_capacity", "JetCache::capacity", 1, [Bool]{true}, None)
        .LRURemove -> return jet_codegen_builtin_route("lru_remove", "JetCache::remove", 2, [Bool]{true, true}, Val(Effect.Mem))
        .BitSetRemove -> return jet_codegen_builtin_route("bitset_remove", "jet_bitset_remove", 2, [Bool]{true, false}, Val(Effect.Mem))
        .BitSetCount -> return jet_codegen_builtin_route("bit_set_count", "jet_bit_set_count", 1, [Bool]{true}, None)
        .BitSetToList -> return jet_codegen_builtin_route("bit_set_to_list", "jet_bit_set_to_list", 1, [Bool]{true}, None)
        .BitSetCopy -> return jet_codegen_builtin_route("bitset_copy", "jet_bits_copy", 1, [Bool]{true}, None)
        .BagAdd -> return jet_codegen_builtin_route("bag_add", "jet_bag_add", 2, [Bool]{true, false}, Val(Effect.Mem))
        .BagRemove -> return jet_codegen_builtin_route("bag_remove", "jet_bag_remove", 2, [Bool]{true, false}, Val(Effect.Mem))
        .BagHas -> return jet_codegen_builtin_route("bag_has", "jet_bag_has", 2, [Bool]{true, true}, None)
        .BagCount -> return jet_codegen_builtin_route("bag_count", "jet_bag_count", 2, [Bool]{true, true}, None)
        .DequePushFront -> return jet_codegen_builtin_route("deque_push_front", "jet_deque_push_front", 2, [Bool]{true, false}, Val(Effect.Mem))
        .DequePushBack -> return jet_codegen_builtin_route("deque_push_back", "jet_deque_push_back", 2, [Bool]{true, false}, Val(Effect.Mem))
        .DequePopFront -> return jet_codegen_builtin_route("deque_pop_front", "jet_deque_pop_front_kernel", 1, [Bool]{true}, Val(Effect.Mem))
        .DequePopBack -> return jet_codegen_builtin_route("deque_pop_back", "jet_deque_pop_back_kernel", 1, [Bool]{true}, Val(Effect.Mem))
        .DequePeekFront -> return jet_codegen_builtin_route("deque_peek_front", "jet_deque_peek_front", 1, [Bool]{true}, None)
        .DequePeekBack -> return jet_codegen_builtin_route("deque_peek_back", "jet_deque_peek_back", 1, [Bool]{true}, None)
        .DequeContains -> return jet_codegen_builtin_route("deque_contains", "jet_deque_contains", 2, [Bool]{true, true}, None)
        .DequeDelete -> return jet_codegen_builtin_route("deque_delete", "jet_deque_delete", 2, [Bool]{true, false}, Val(Effect.Mem))
        .DequeToList -> return jet_codegen_builtin_route("deque_to_list", "jet_deque_to_list", 1, [Bool]{true}, None)
        .DequeJoin -> return jet_codegen_builtin_route("deque_join", "jet_deque_join", 2, [Bool]{true, true}, None)
        .DequeReverse -> return jet_codegen_builtin_route("deque_reverse", "jet_deque_reverse", 1, [Bool]{true}, Val(Effect.Mem))
        .DequeSplit -> return jet_codegen_builtin_route("deque_split", "jet_deque_split", 2, [Bool]{true, false}, Val(Effect.Mem))
        .DequeFrom -> return jet_codegen_builtin_route("deque_from", "jet_deque_from", 1, [Bool]{false}, None)
        else -> {}
    }
    panic("checked container TBuiltinOp has no canonical Prelude route")
}

fn jet_codegen_builtin_route_plan(operation: TBuiltinOp, receiver: Type, result: Type, carrier: TFailureCarrier) -> JetCodegenBuiltinRoute Never! {
    if operation == {
        .AtomicMethod(method) -> {
            if method == "load" -> return jet_codegen_builtin_route_row("core.mem", "load", "jet_atomic_load", 1, [Bool]{true}, None, MIRPreludeABI.Value)
            if method == "store" -> return jet_codegen_builtin_route_row("core.mem", "store", "jet_atomic_store", 2, [Bool]{true, false}, None, MIRPreludeABI.Value)
            if method == "add" -> return jet_codegen_builtin_route_row("core.mem", "add", "jet_atomic_add", 2, [Bool]{true, false}, None, MIRPreludeABI.Value)
            if method == "try_add" -> return jet_codegen_builtin_route_row("core.mem", "try_add", "jet_atomic_try_add", 2, [Bool]{true, false}, Val(Effect.Mem), MIRPreludeABI.Value)
            if method == "compare_exchange" -> return jet_codegen_builtin_route_row("core.mem", "compare_exchange", "jet_atomic_compare_exchange", 3, [Bool]{true, false, false}, None, MIRPreludeABI.Value)
            if method == "publish" -> return jet_codegen_builtin_route_row("core.mem", "publish", "jet_atomic_publish", 2, [Bool]{true, false}, None, MIRPreludeABI.Value)
            if method == "observe" -> return jet_codegen_builtin_route_row("core.mem", "observe", "jet_atomic_observe", 1, [Bool]{true}, None, MIRPreludeABI.Value)
            panic("checked Atomic method has no canonical route")
        }
        .LenString -> return jet_codegen_builtin_route("len_string", "jet_char_len", 1, [Bool]{true}, None)
        .LenList | .IsEmpty | .GetMap | .GetList | .First | .Last | .Contains | .ContainsKey | .DequeCapacity | .SetCapacity | .MapFromKeys | .SetShuffle | .ListUnion | .ListIntersection | .ListDifference | .ListRandom -> return jet_codegen_builtin_route_for_receiver(operation, receiver, carrier)
        .Max(fixed) -> {
            if !fixed -> return jet_codegen_builtin_route_for_receiver(operation, receiver, carrier)
        }
        .Push -> {
            is_priority_queue := if jet_codegen_builtin_untag(receiver) == {
                .Apply(name, _) -> name == "PriorityQueue"
                else -> false
            }
            if is_priority_queue -> return jet_codegen_builtin_route("list_push", "std::collections::BinaryHeap::push", 2, [Bool]{true, false}, Val(Effect.Mem))
            return jet_codegen_builtin_route("list_push", "jet_list_push", 2, [Bool]{true, false}, Val(Effect.Mem))
        }
        .ListTryNew -> return jet_codegen_builtin_route("list_try_new", "jet_list_try_new", 1, [Bool]{false}, Val(Effect.Mem))
        .ListTryWithCapacity -> return jet_codegen_builtin_route("list_try_with_capacity", "jet_list_try_with_capacity", 2, [Bool]{false, false}, Val(Effect.Mem))
        .TryPush -> return jet_codegen_builtin_route("list_try_push", "jet_list_try_push", 2, [Bool]{true, false}, Val(Effect.Mem))
        .TryReserve -> return jet_codegen_builtin_route("list_try_reserve", "jet_list_try_reserve", 2, [Bool]{true, false}, Val(Effect.Mem))
        .TryInsertMap -> return jet_codegen_builtin_route("map_try_insert", "jet_map_try_insert", 3, [Bool]{true, false, false}, Val(Effect.Mem))
        .TryStringPush -> return jet_codegen_builtin_route("string_try_push", "jet_string_try_push", 2, [Bool]{true, true}, Val(Effect.Mem))
        .Pop -> return jet_codegen_builtin_route("list_pop", "jet_list_pop_kernel", 1, [Bool]{true}, Val(Effect.Mem))
        .IterNext -> return jet_codegen_builtin_route("iter_next", "jet_iter_next", 1, [Bool]{true}, Val(Effect.Mem))
        .PriorityQueuePop -> return jet_codegen_builtin_route("priority_queue_pop", "jet_priority_queue_pop_kernel", 1, [Bool]{true}, Val(Effect.Mem))
        .InsertMap -> return jet_codegen_builtin_route("map_insert", "jet_map_insert", 3, [Bool]{true, false, false}, Val(Effect.Mem))
        .AddNewMap -> return jet_codegen_builtin_route("map_add_new", "jet_map_add_new", 3, [Bool]{true, false, false}, Val(Effect.Mem))
        .MapSetDefault -> return jet_codegen_builtin_route("map_setdefault", "jet_map_setdefault", 3, [Bool]{true, false, false}, Val(Effect.Mem))
        .MapUpdate -> return jet_codegen_builtin_route("map_update", "jet_map_update_all", 2, [Bool]{true, true}, Val(Effect.Mem))
        .MapMerge -> return jet_codegen_builtin_route("map_merge", "jet_map_merge", 2, [Bool]{true, true}, None)
        .MapMergeWith -> return jet_codegen_builtin_route("map_merge_with", "jet_map_merge_with", 3, [Bool]{true, true, false}, None)
        .InsertList -> return jet_codegen_builtin_route("list_insert", "jet_list_insert", 3, [Bool]{true, false, false}, Val(Effect.Mem))
        .RemoveMap -> return jet_codegen_builtin_route("map_remove", "jet_map_pop_kernel", 2, [Bool]{true, true}, Val(Effect.Mem))
        .RemoveList(_, mode) -> {
            if mode == {
                .Value -> return jet_codegen_builtin_route("list_remove_value", "jet_list_remove_value", 2, [Bool]{true, false}, Val(Effect.Mem))
                .Slot -> return jet_codegen_builtin_route("list_remove_slot", "jet_list_remove_slot", 2, [Bool]{true, false}, Val(Effect.Mem))
                .Dynamic -> panic("dynamic list removal requires structural lowering")
            }
        }
        .CountList -> return jet_codegen_builtin_route("list_count", "jet_list_count", 2, [Bool]{true, true}, None)
        .Counts -> return jet_codegen_builtin_route("list_counts", "jet_list_counts", 1, [Bool]{false}, None)
        .ExtendList -> return jet_codegen_builtin_route("list_extend", "jet_list_extend", 2, [Bool]{true, false}, Val(Effect.Mem))
        .ConcatList -> return jet_codegen_builtin_route("list_concat", "jet_list_concat", 2, [Bool]{true, true}, None)
        .IndexOf -> return jet_codegen_builtin_route("list_index_of", "jet_list_index_of", 2, [Bool]{true, true}, None)
        .Reverse -> return jet_codegen_builtin_route("list_reverse", "jet_list_reverse", 1, [Bool]{true}, Val(Effect.Mem))
        .Sort -> return jet_codegen_builtin_route("list_sort", "jet_list_sort", 1, [Bool]{true}, Val(Effect.Mem))
        .SortDesc -> return jet_codegen_builtin_route("list_sort_desc", "jet_list_sort_desc", 1, [Bool]{true}, Val(Effect.Mem))
        .OrderingThen -> return jet_codegen_builtin_route("ordering_then", "jet_ordering_then", 2, [Bool]{true, true}, None)
        .OrderingReverse -> return jet_codegen_builtin_route("ordering_reverse", "jet_ordering_reverse", 1, [Bool]{true}, None)
        .JoinSep -> {
            if jet_codegen_builtin_iter_receiver(receiver) -> return jet_codegen_builtin_route("iter_join", "jet_iter_join", 2, [Bool]{false, true}, None)
            return jet_codegen_builtin_route("join", "jet_list_join", 2, [Bool]{true, true}, None)
        }
        .Sum(fixed, float) -> {
            if fixed && float -> return jet_codegen_builtin_route("sum_fixed_f32", "jet_list_sum_fixed_f32", 1, [Bool]{false}, None)
            if fixed -> return jet_codegen_builtin_route("sum_fixed_f64", "jet_list_sum_fixed_f64", 1, [Bool]{false}, None)
            return jet_codegen_builtin_route("sum", "jet_list_sum", 1, [Bool]{false}, None)
        }
        .Product(fixed) -> {
            if !fixed -> return jet_codegen_builtin_route("product", "jet_list_product", 1, [Bool]{false}, None)
        }
        .Min(fixed) -> {
            if !fixed -> return jet_codegen_builtin_route("min", "jet_list_min", 1, [Bool]{false}, None)
        }
        .Flatten -> {
            if jet_codegen_builtin_iter_receiver(receiver) -> return jet_codegen_builtin_route("iter_flatten", "jet_iter_flatten", 1, [Bool]{false}, None)
            return jet_codegen_builtin_route("list_flatten", "jet_list_flatten", 1, [Bool]{false}, None)
        }
        .Intersperse -> return jet_codegen_builtin_route("iter_intersperse", "jet_iter_intersperse", 2, [Bool]{false, false}, None)
        .Clear -> return jet_codegen_builtin_route_for_receiver(operation, receiver, carrier)
        .Bytes(owned) -> {
            if owned -> return jet_codegen_builtin_route("bytes", "jet_string_bytes", 1, [Bool]{false}, None)
            return jet_codegen_builtin_route("bytes", "jet_string_bytes", 1, [Bool]{true}, None)
        }
        .StringFromBytes -> return jet_codegen_builtin_route("string_from_bytes", "jet_string_from_bytes", 1, [Bool]{true}, None)
        .StringFromBytesLossy -> return jet_codegen_builtin_route("string_from_bytes_lossy", "jet_string_from_bytes_lossy", 1, [Bool]{true}, None)
        .Trim -> return jet_codegen_builtin_route("string_trim", "jet_unicode_trim", 1, [Bool]{true}, None)
        .TrimStart -> return jet_codegen_builtin_route("string_trim_start", "jet_text_trim_start", 1, [Bool]{true}, None)
        .TrimEnd -> return jet_codegen_builtin_route("string_trim_end", "jet_text_trim_end", 1, [Bool]{true}, None)
        .PadStart -> return jet_codegen_builtin_route("string_pad_start", "jet_text_pad_start", 3, [Bool]{true, false, true}, None)
        .PadEnd -> return jet_codegen_builtin_route("string_pad_end", "jet_text_pad_end", 3, [Bool]{true, false, true}, None)
        .StringIndexOf -> return jet_codegen_builtin_route("string_index_of", "jet_unicode_index_of", 2, [Bool]{true, true}, None)
        .StringCount -> return jet_codegen_builtin_route("string_count", "jet_unicode_count", 2, [Bool]{true, true}, None)
        .StringIsAlphabetic -> return jet_codegen_builtin_route("string_is_alphabetic", "jet_text_is_alphabetic", 1, [Bool]{true}, None)
        .StringIsNumeric -> return jet_codegen_builtin_route("string_is_numeric", "jet_text_is_numeric", 1, [Bool]{true}, None)
        .StringIsWhitespace -> return jet_codegen_builtin_route("string_is_whitespace", "jet_text_is_whitespace", 1, [Bool]{true}, None)
        .StringIsASCII -> return jet_codegen_builtin_route("string_is_ascii", "jet_text_unicode_is_ascii", 1, [Bool]{true}, None)
        .StringToTitle -> return jet_codegen_builtin_route("string_to_title", "jet_text_title", 1, [Bool]{true}, None)
        .Split -> return jet_codegen_builtin_route("string_split", "jet_iter_string_split", 2, [Bool]{true, true}, None)
        .Lines -> return jet_codegen_builtin_route("string_lines", "jet_string_lines", 1, [Bool]{true}, None)
        .Chars -> return jet_codegen_builtin_route("string_chars", "jet_string_chars", 1, [Bool]{true}, None)
        .ParseInt -> return jet_codegen_builtin_route("int_parse", "jet_std::jet_int_parse", 1, [Bool]{true}, None)
        .ParseFloat -> return jet_codegen_builtin_route("float_parse", "jet_std::jet_float_parse", 1, [Bool]{true}, None)
        .IntToRadix(_) -> return jet_codegen_builtin_route("int_to_radix", "jet_std::jet_int_to_radix", 2, [Bool]{false, false}, None)
        .IntFromRadix(_) -> return jet_codegen_builtin_route("int_from_radix", "jet_std::jet_int_from_radix", 2, [Bool]{true, false}, None)
        .ToUpper -> return jet_codegen_builtin_route("string_upper", "jet_unicode_upper", 1, [Bool]{true}, None)
        .ToLower -> return jet_codegen_builtin_route("string_lower", "jet_unicode_lower", 1, [Bool]{true}, None)
        .ToASCIILower -> return jet_codegen_builtin_route("string_ascii_lower", "jet_text_ascii_lower", 1, [Bool]{true}, None)
        .ToASCIIUpper -> return jet_codegen_builtin_route("string_ascii_upper", "jet_text_ascii_upper", 1, [Bool]{true}, None)
        .Slice(_) -> return jet_codegen_builtin_route("string_slice", "jet_string_slice_builtin", 3, [Bool]{true, false, false}, None)
        .After -> return jet_codegen_builtin_route("string_after", "jet_string_after", 2, [Bool]{true, true}, None)
        .Before -> return jet_codegen_builtin_route("string_before", "jet_string_before", 2, [Bool]{true, true}, None)
        .TrimView -> return jet_codegen_builtin_route("string_trim_view", "jet_unicode_trim_view", 1, [Bool]{true}, None)
        .AfterView -> return jet_codegen_builtin_route("string_after_view", "jet_string_after_view", 2, [Bool]{true, true}, None)
        .BeforeView -> return jet_codegen_builtin_route("string_before_view", "jet_string_before_view", 2, [Bool]{true, true}, None)
        .Keys -> return jet_codegen_builtin_route("map_keys", "jet_map_keys", 1, [Bool]{true}, None)
        .Values -> return jet_codegen_builtin_route("map_values", "jet_map_values", 1, [Bool]{true}, None)
        .MapTopN(_) -> return jet_codegen_builtin_route("map_top_n", "jet_map_top_n", 2, [Bool]{true, false}, None)
        .MapToList(_) -> return jet_codegen_builtin_route_row("core.map", "to_list", "jet_map_to_list", 1, [Bool]{true}, None, MIRPreludeABI.Aggregate)
        .MapMin -> return jet_codegen_builtin_route("map_min", "jet_map_min_value_kernel", 1, [Bool]{true}, None)
        .MapMax -> return jet_codegen_builtin_route("map_max", "jet_map_max_value_kernel", 1, [Bool]{true}, None)
        .MapPopFirst -> return jet_codegen_builtin_route("map_pop_first", "jet_map_pop_first", 1, [Bool]{true}, Val(Effect.Mem))
        .MapEqual -> return jet_codegen_builtin_route("map_equal", "jet_map_equal", 2, [Bool]{true, true}, None)
        .MapFirst -> return jet_codegen_builtin_route("map_first", "jet_map_first_key", 1, [Bool]{true}, None)
        .MapIntersection -> return jet_codegen_builtin_route("map_intersection", "jet_map_intersection", 2, [Bool]{true, true}, None)
        .MapSliceKeys -> return jet_codegen_builtin_route("map_slice", "jet_map_slice", 2, [Bool]{true, false}, None)
        .MapContainsValue -> return jet_codegen_builtin_route("map_contains_value", "jet_map_contains_value", 2, [Bool]{true, true}, None)
        .DequeGet -> return jet_codegen_builtin_route("deque_get", "jet_deque_get", 2, [Bool]{true, false}, None)
        .StringSplitOnce(_) -> return jet_codegen_builtin_route("string_split_once", "jet_unicode_split_once", 2, [Bool]{true, true}, None)
        .StringCutLast(_) -> return jet_codegen_builtin_route("string_cut_last", "jet_unicode_cut_last", 2, [Bool]{true, true}, None)
        .GetDisjointWrite -> return jet_codegen_builtin_route("get_disjoint_write", "jet_get_disjoint_write", 2, [Bool]{true, true}, Val(Effect.Mem))
        .ViewNew(_) -> return jet_codegen_builtin_route("view_new", "jet_view_new", 4, [Bool]{true, false, false, false}, Val(Effect.Mem))
        .ViewMutNew(_) -> return jet_codegen_builtin_route("view_mut_new", "jet_view_mut_new", 4, [Bool]{true, false, false, false}, Val(Effect.Mem))
        .ListMinMax(_) -> return jet_codegen_builtin_route_row("core.list", "min_max", "jet_list_min_max", 1, [Bool]{true}, None, MIRPreludeABI.Aggregate)
        .Indexes -> return jet_codegen_builtin_route("indexes", "jet_iter_indexes", 1, [Bool]{false}, None)
        .Indexed(_) -> return jet_codegen_builtin_route("iter_enumerate", "jet_iter_enumerate", 2, [Bool]{false, false}, None)
        .IterSplit(_) -> return jet_codegen_builtin_route("iter_split", "jet_iter_split_at", 3, [Bool]{false, false, false}, None)
        .SetFrom | .SetToList | .SetSort | .SetEqual | .SetFirst | .SetValues | .SetPop | .SetReplace | .SetInsert | .SetUpdate | .SetDifferenceUpdate | .SetIntersectionUpdate | .SetSymmetricDifferenceUpdate | .SetRemove | .SetUnion | .SetIntersection | .SetDifference | .SetSymmetricDifference | .SetIsSubset | .SetIsSuperset | .SetIsDisjoint | .SortedSetFrom | .SortedSetToList | .SortedSetInsert | .SortedSetRemove | .SortedSetUnion | .SortedSetIntersection | .SortedSetDifference | .SortedSetSymmetricDifference | .SortedSetIsSubset | .SortedSetIsSuperset | .SortedSetIsDisjoint | .PriorityQueueFrom | .PriorityQueuePeek | .PriorityQueueToSortedList | .PriorityQueueRemove(_, _) | .LRUPut | .LRUAddNew | .LRUGet | .LRURemove | .LRUCapacity | .LRUKeys | .BitSetAdd | .BitSetRemove | .BitSetCount | .BitSetToList | .BitSetCopy | .BagAdd | .BagRemove | .BagHas | .BagCount | .BagLen | .DequePushFront | .DequePushBack | .DequePopFront | .DequePopBack | .DequePeekFront | .DequePeekBack | .DequeContains | .DequeDelete | .DequeGet | .DequeToList | .DequeJoin | .DequeSplit | .DequeReverse | .DequeCapacity -> return jet_codegen_builtin_container_route(operation)
        .OptionZip(_, _) | .Zip(_, _, _, _, _, _, _) | .Unzip(_) -> panic("checked structural builtin requires its dedicated non-route lowering")
        .TryCollect | .IterToList | .IterCollect | .ListLazy | .Take | .Skip | .StepBy | .Dedup | .Chunks | .Windows | .IterRepeat | .IterCycle | .IterDropLast | .IterShuffle | .IterIsSorted | .IterLastIndexOf | .IterAverage(_) | .IterCompare -> return jet_codegen_builtin_iter_route(operation, receiver, carrier)
        .StringMethod(method) -> return jet_codegen_builtin_string_method_route(method, result, carrier)
        .ByteBufferMethod(method) -> return jet_codegen_builtin_byte_buffer_method_route(method)
        .ByteBufferWrite(method) -> return jet_codegen_builtin_route("byte_buffer_{method}", "JetByteBuffer::{method}", 2, [Bool]{true, false}, Val(Effect.Mem))
        .ByteBufferToBytes -> return jet_codegen_builtin_route("byte_buffer_to_bytes", "JetByteBuffer::to_bytes", 1, [Bool]{true}, None)
        .ByteBufferFrom -> return jet_codegen_builtin_route("byte_buffer_from", "JetByteBuffer::from", 1, [Bool]{true}, None)
        .ByteBufferWithCapacity -> return jet_codegen_builtin_route("byte_buffer_with_capacity", "JetByteBuffer::with_capacity", 1, [Bool]{false}, None)
        .MatchGroup -> return jet_codegen_builtin_route("match_group", "jet_std::JetRegexMatch::group", 2, [Bool]{true, false}, None)
        .Repeat -> return jet_codegen_builtin_route("string_repeat", "jet_string_repeat", 2, [Bool]{true, false}, None)
        .ListSlice -> return jet_codegen_builtin_route("list_slice", "jet_list_slice", 3, [Bool]{true, false, false}, None)
        .ListBinarySearch -> return jet_codegen_builtin_route("list_binary_search", "jet_list_binary_search", 2, [Bool]{true, true}, None)
        .ListEqual -> return jet_codegen_builtin_route("list_equal", "jet_list_equal", 2, [Bool]{true, true}, None)
        .ListReplace -> return jet_codegen_builtin_route("list_replace", "jet_list_replace", 3, [Bool]{true, false, false}, None)
        .MapCopy | .ListCopy | .MapNew | .SetCopy | .BitSetNew | .ByteBufferNew | .BagLen -> panic("checked primitive or receiver-only builtin has no generic route")
        else -> {}
    }
    jet_codegen_builtin_route_for_receiver(operation, receiver, carrier)
}

fn jet_codegen_builtin_iter_route(operation: TBuiltinOp, receiver: Type, carrier: TFailureCarrier) -> JetCodegenBuiltinRoute Never! {
    if operation == {
        .ListLazy -> {
            is_list_receiver := if jet_codegen_builtin_untag(receiver) == {
                .List(_) | .FixedList(_, _) -> true
                else -> false
            }
            if is_list_receiver -> return jet_codegen_builtin_route("list_lazy", "jet_iter_from_vec", 1, [Bool]{false}, None)
            panic("checked ListLazy builtin has a non-list receiver")
        }
        // One collector for lists and iterators: `[T !E]` becomes `[T] !E`.
        .TryCollect -> return jet_codegen_builtin_route("try_collect", "jet_list_try_collect", 1, [Bool]{false}, None)
        else -> {}
    }
    if !jet_codegen_builtin_iter_receiver(receiver) -> panic("checked iterator builtin has a non-iterator receiver")
    if operation == {
        .IterToList -> return jet_codegen_builtin_route("iter_to_list", "jet_iter_to_list", 1, [Bool]{false}, None)
        .IterCollect -> return jet_codegen_builtin_route("iter_collect", "jet_iter_collect", 1, [Bool]{false}, None)
        .Take -> return jet_codegen_builtin_route("iter_take", "jet_iter_take", 2, [Bool]{false, false}, None)
        .Skip -> return jet_codegen_builtin_route("iter_skip", "jet_iter_skip", 2, [Bool]{false, false}, None)
        .StepBy -> return jet_codegen_builtin_route("iter_step_by", "jet_iter_step_by", 2, [Bool]{false, false}, None)
        .Dedup -> return jet_codegen_builtin_route("iter_dedup", "jet_iter_dedup", 1, [Bool]{false}, None)
        .Chunks -> return jet_codegen_builtin_route("iter_chunks", "jet_iter_chunks", 2, [Bool]{false, false}, None)
        .Windows -> return jet_codegen_builtin_route("iter_windows", "jet_iter_windows", 2, [Bool]{false, false}, None)
        .Flatten -> return jet_codegen_builtin_route("iter_flatten", "jet_iter_flatten", 1, [Bool]{false}, None)
        .Intersperse -> return jet_codegen_builtin_route("iter_intersperse", "jet_iter_intersperse", 2, [Bool]{false, false}, None)
        .IterRepeat -> return jet_codegen_builtin_route("iter_repeat", "jet_iter_repeat", 2, [Bool]{false, false}, None)
        .IterCycle -> return jet_codegen_builtin_route("iter_cycle", "jet_iter_cycle", 2, [Bool]{false, false}, None)
        .IterDropLast -> return jet_codegen_builtin_route("iter_drop_last", "jet_iter_drop_last", 2, [Bool]{false, false}, None)
        .IterShuffle -> return jet_codegen_builtin_route("iter_shuffle", "jet_iter_shuffle", 1, [Bool]{false}, None)
        .IterIsSorted -> return jet_codegen_builtin_route("iter_is_sorted", "jet_iter_is_sorted", 1, [Bool]{false}, None)
        .IterLastIndexOf -> return jet_codegen_builtin_route("iter_last_index_of", "jet_iter_last_index_of", 2, [Bool]{false, false}, None)
        .IterAverage(float) -> {
            if float -> return jet_codegen_builtin_route("iter_average_float", "jet_iter_average_float", 1, [Bool]{false}, None)
            return jet_codegen_builtin_route("iter_average_int", "jet_iter_average_int", 1, [Bool]{false}, None)
        }
        .IterCompare -> return jet_codegen_builtin_route("iter_compare", "jet_iter_compare", 2, [Bool]{false, false}, None)
        else -> panic("checked iterator operation has no canonical route")
    }
}

fn jet_codegen_builtin_string_method_route(method: String, result: Type, carrier: TFailureCarrier) -> JetCodegenBuiltinRoute Never! {
    if method == "equal" -> return jet_codegen_builtin_route_row("core.compare", "eq", "jet_eq", 2, [Bool]{true, true}, None, MIRPreludeABI.Value)
    if method == "expandtabs" -> return jet_codegen_builtin_route("expandtabs", "jet_text_expandtabs", 2, [Bool]{true, true}, None)
    if method == "find" -> return jet_codegen_builtin_route("find", "jet_text_parse_find", 2, [Bool]{true, true}, None)
    if method == "rfind" -> return jet_codegen_builtin_route("rfind", "jet_text_parse_rfind", 2, [Bool]{true, true}, None)
    if method == "partition" -> return jet_codegen_builtin_route("partition", "jet_text_parse_partition", 2, [Bool]{true, true}, None)
    if method == "rpartition" -> return jet_codegen_builtin_route("rpartition", "jet_text_parse_rpartition", 2, [Bool]{true, true}, None)
    if method == "strip" -> return jet_codegen_builtin_route("strip", "jet_text_parse_strip", 1, [Bool]{true}, None)
    if method == "lstrip" -> return jet_codegen_builtin_route("lstrip", "jet_text_parse_lstrip", 1, [Bool]{true}, None)
    if method == "rstrip" -> return jet_codegen_builtin_route("rstrip", "jet_text_parse_rstrip", 1, [Bool]{true}, None)
    if method == "copy" -> return jet_codegen_builtin_route("copy", "jet_string_copy", 1, [Bool]{true}, None)
    if method == "replace" -> return jet_codegen_builtin_route("replace", "jet_string_replace", 3, [Bool]{true, true, true}, None)
    if method == "count_bytes" -> return jet_codegen_builtin_route("count_bytes", "jet_string_count_bytes", 1, [Bool]{true}, None)
    if method == "last_index_of" -> return jet_codegen_builtin_route("last_index_of", "jet_unicode_last_index_of", 2, [Bool]{true, true}, None)
    if method == "is_lower" -> return jet_codegen_builtin_route("is_lower", "jet_text_is_lower", 1, [Bool]{true}, None)
    if method == "is_upper" -> return jet_codegen_builtin_route("is_upper", "jet_text_is_upper", 1, [Bool]{true}, None)
    if method == "capitalize" -> return jet_codegen_builtin_route("capitalize", "jet_text_capitalize", 1, [Bool]{true}, None)
    if method == "swapcase" -> return jet_codegen_builtin_route("swapcase", "jet_text_swapcase", 1, [Bool]{true}, None)
    if method == "remove_prefix" || method == "removeprefix" -> return jet_codegen_builtin_route("remove_prefix", "jet_text_remove_prefix", 2, [Bool]{true, true}, None)
    if method == "remove_suffix" || method == "removesuffix" -> return jet_codegen_builtin_route("remove_suffix", "jet_text_remove_suffix", 2, [Bool]{true, true}, None)
    if method == "compare" -> return jet_codegen_builtin_route("compare", "jet_text_compare", 2, [Bool]{true, true}, None)
    if method == "reverse" -> return jet_codegen_builtin_route("reverse", "jet_text_reverse", 1, [Bool]{true}, None)
    if method == "normalize" -> return jet_codegen_builtin_route("normalize", "jet_text_normalize_nfc", 1, [Bool]{true}, None)
    if method == "rsplit" -> return jet_codegen_builtin_route("rsplit", "jet_iter_string_rsplit", 2, [Bool]{true, true}, None)
    if method == "matches" -> return jet_codegen_builtin_route("matches", "jet_std::jet_string_matches", 2, [Bool]{true, true}, None)
    if method == "match" -> return jet_codegen_builtin_route("match", "jet_std::jet_string_match", 2, [Bool]{true, true}, None)
    if method == "isalnum" -> return jet_codegen_builtin_route("isalnum", "jet_text_isalnum", 1, [Bool]{true}, None)
    if method == "isalpha" -> return jet_codegen_builtin_route("isalpha", "jet_text_is_alphabetic", 1, [Bool]{true}, None)
    if method == "isascii" -> return jet_codegen_builtin_route("isascii", "jet_text_unicode_is_ascii", 1, [Bool]{true}, None)
    if method == "isdecimal" -> return jet_codegen_builtin_route("isdecimal", "jet_text_isdecimal", 1, [Bool]{true}, None)
    if method == "isdigit" -> return jet_codegen_builtin_route("isdigit", "jet_text_isdigit", 1, [Bool]{true}, None)
    if method == "isidentifier" -> return jet_codegen_builtin_route("isidentifier", "jet_text_isidentifier", 1, [Bool]{true}, None)
    if method == "isnumeric" -> return jet_codegen_builtin_route("isnumeric", "jet_text_isnumeric", 1, [Bool]{true}, None)
    if method == "isprintable" -> return jet_codegen_builtin_route("isprintable", "jet_text_isprintable", 1, [Bool]{true}, None)
    if method == "isspace" -> return jet_codegen_builtin_route("isspace", "jet_text_is_whitespace", 1, [Bool]{true}, None)
    if method == "istitle" -> return jet_codegen_builtin_route("istitle", "jet_text_istitle", 1, [Bool]{true}, None)
    if method == "islower" -> return jet_codegen_builtin_route("islower", "jet_text_is_lower", 1, [Bool]{true}, None)
    if method == "isupper" -> return jet_codegen_builtin_route("isupper", "jet_text_is_upper", 1, [Bool]{true}, None)
    if method == "lower" -> return jet_codegen_builtin_route("lower", "jet_unicode_lower", 1, [Bool]{true}, None)
    if method == "upper" -> return jet_codegen_builtin_route("upper", "jet_unicode_upper", 1, [Bool]{true}, None)
    if method == "title" -> return jet_codegen_builtin_route("title", "jet_text_title", 1, [Bool]{true}, None)
    if method == "casefold" -> return jet_codegen_builtin_route("casefold", "jet_text_casefold", 1, [Bool]{true}, None)
    if method == "center" -> return jet_codegen_builtin_route("center", "jet_text_center_ref", 3, [Bool]{true, true, true}, None)
    if method == "ljust" -> return jet_codegen_builtin_route("ljust", "jet_text_pad_end_ref", 3, [Bool]{true, true, true}, None)
    if method == "rjust" -> return jet_codegen_builtin_route("rjust", "jet_text_pad_start_ref", 3, [Bool]{true, true, true}, None)
    if method == "zfill" -> return jet_codegen_builtin_route("zfill", "jet_text_zfill_ref", 2, [Bool]{true, true}, None)
    panic("checked StringMethod has no canonical route")
}

fn jet_codegen_builtin_byte_buffer_method_route(method: String) -> JetCodegenBuiltinRoute Never! {
    if method == "capacity" -> return jet_codegen_builtin_route("byte_buffer_capacity", "JetByteBuffer::capacity", 1, [Bool]{true}, None)
    arity := 0
    if method == "len" || method == "is_empty" || method == "clear" || method == "position" || method == "eof" || method == "rewind" || method == "flush" || method == "close" || method == "shutdown" || method == "get_buffer" || method == "buffer" || method == "to_string" || method == "string" || method == "trim" || method == "trim_start" || method == "trim_end" || method == "to_lower" || method == "to_upper" || method == "to_title" || method == "title" || method == "clone" || method == "copy" || method == "lines" || method == "first" || method == "next" || method == "read_byte" || method == "read" || method == "is_ascii" -> arity = 1
    if method == "get" || method == "seek" || method == "read_bytes" || method == "read_string" || method == "contains" || method == "starts_with" || method == "ends_with" || method == "index_of" || method == "last_index_of" || method == "split" || method == "partition" || method == "join" || method == "equal" || method == "compare" || method == "copy_to" || method == "write_to" -> arity = 2
    if method == "replace" -> arity = 3
    if arity == 0 -> panic("checked ByteBufferMethod has no canonical route")
    mask := [Bool]{}
    index := 0
    loop index < arity {
        &mask.push(true)
        index += 1
    }
    jet_codegen_builtin_route("byte_buffer_{method}", "JetByteBuffer::{method}", arity, mask, Val(Effect.Mem))
}

fn jet_codegen_lower_builtin_receiver(builder: &JetCodegenBuilder, receiver: TExpr, mutating: Bool) -> (value: MIRValueID, place: MIRPlaceID?) {
    if !mutating {
        if jet_codegen_builtin_iter_receiver(receiver.ty) {
            place := jet_codegen_lower_expression_place(&builder, receiver, MIRAccess.Move)
            if place != None -> return (value: jet_codegen_emit_value(&builder, receiver.span, receiver.ty, MIROperation.MovePlace{place: place ?? panic("checked iterator receiver place disappeared")}), place: None)
        }
        return (value: jet_codegen_lower_expr(&builder, receiver), place: None)
    }
    place := jet_codegen_lower_expression_place(&builder, receiver, MIRAccess.Write)
    if place == None -> return (value: jet_codegen_lower_expr(&builder, receiver), place: None)
    collection_value := false
    if receiver.kind == {
        .Index(_, _, _, _, _, _) | .Field(_, _) -> {
            ty := jet_codegen_builtin_untag(receiver.ty)
            if ty == {
                .List(_) | .Map(_, _, _) -> {
                    collection_value = true
                }
                else -> {}
            }
        }
        else -> {}
    }
    if collection_value -> return (value: jet_codegen_emit_value(&builder, receiver.span, receiver.ty, MIROperation.ReadPlace{place: place ?? panic("checked indexed collection receiver place disappeared")}), place: Val(place ?? panic("checked indexed collection receiver place disappeared")))
    (value: jet_codegen_emit_value(&builder, receiver.span, receiver.ty, MIROperation.AddressOf{place: place ?? panic("checked mutating builtin receiver place disappeared"), access: MIRAccess.Write}), place: Val(place ?? panic("checked mutating builtin receiver place disappeared")))
}

fn jet_codegen_builtin_native_int(builder: &JetCodegenBuilder, value: MIRValueID, source: Type, span: Span) -> MIRValueID Never! {
    if jet_codegen_builtin_untag(source) != Type.Int -> return ~value
    raw_type := Type.IntN{signed: true, bits: 64}
    target := jet_codegen_lower_type_for_function(raw_type, builder)
    route := jet_codegen_intern_route(&builder, MIRPreludeFamily.StaticPrelude, "core.numeric", "int_checked_fixed", "jet_std::jet_int_checked_fixed", 4, [Bool]{false, false, true, false}, None, TFailureCarrier.Infallible, MIRPreludeABI.Value)
    host_kind := jet_codegen_numeric_constant_int(&builder, span, 3)
    location := jet_codegen_source_location_at(&builder, span, false)
    panic_location := MIRPanicLoc{file: mir_source_file_id(builder.function.source_file), line: location.line, column: 0}
    jet_codegen_emit_value(&builder, span, raw_type, MIROperation.Convert{value: value, parameters: [MIRValueID]{host_kind}, target: target, conversion: MIRConversion.Prelude{call: route, location: panic_location, fallibility: MIRCallFallibility.Infallible}})
}

fn jet_codegen_lower_builtin_method(builder: &JetCodegenBuilder, expression: TExpr, receiver: TExpr, operation: TBuiltinOp, args: [TExpr]) -> MIRValueID {
    if operation == {
        .OptionZip(_, elem_ty) -> return jet_codegen_lower_builtin_option_zip(&builder, expression, receiver, args, elem_ty)
        .Unzip(_) -> return jet_codegen_lower_builtin_unzip(&builder, expression, receiver)
        .Indexes -> return jet_codegen_lower_builtin_indexes(&builder, expression, receiver, args)
        .ListMinMax(_) -> return jet_codegen_lower_builtin_list_min_max(&builder, expression, receiver, operation, args)
        .Indexed(_) -> return jet_codegen_lower_builtin_tuple_projection(&builder, expression, receiver, operation, args)
        .MapToList(_) -> return jet_codegen_lower_builtin_map_to_list(&builder, expression, receiver, operation, args)
        .IterSplit(_) -> return jet_codegen_lower_builtin_tuple_projection(&builder, expression, receiver, operation, args)
        .Zip(_, mode, fields, flatten, input_count, fill_mode, field_types) -> return jet_codegen_lower_builtin_zip(&builder, expression, receiver, args, mode, fields, flatten, input_count, fill_mode, field_types)
        // `to_string` on a String, Bool, Char or inline range shows the value (Rust `jet_show`).
        .ToString -> {
            shown := jet_codegen_lower_expr(&builder, receiver)
            return jet_codegen_emit_value(&builder, expression.span, expression.ty, MIROperation.BuildString{parts: [MIRStringPart]{MIRStringPart{kind: MIRStringPartKind.Interpolation{value: shown, format: MIRStringFormat.Display}}}})
        }
        else -> {}
    }
    if operation == {
        .RemoveList(line, mode) -> {
            if mode == TListRemoveMode.Dynamic -> return jet_codegen_lower_builtin_dynamic_remove(&builder, expression, receiver, line, args)
        }
        .PriorityQueueRemove(line, mode) -> {
            if mode == TListRemoveMode.Dynamic -> return jet_codegen_lower_builtin_dynamic_priority_queue_remove(&builder, expression, receiver, line, args)
        }
        else -> {}
    }
    route := jet_codegen_builtin_route_plan(operation, receiver.ty, expression.ty, jet_codegen_failure_carrier_for_type(expression.ty))
    mutating := jet_codegen_builtin_mutates_receiver(operation)
    if operation == {
        .AtomicMethod(_) -> {
            mutating = false
        }
        else -> {}
    }
    lowered_receiver := MIRValueID{value: 0}
    receiver_place := MIRPlaceID?{None}
    if operation == {
        .AtomicMethod(_) -> {
            place := jet_codegen_lower_expression_place(&builder, receiver, MIRAccess.Write)
            if {
                place != None -> {
                    receiver_place_id :: place ?? panic("checked atomic receiver place disappeared")
                    lowered_receiver = jet_codegen_emit_value(&builder, receiver.span, receiver.ty, MIROperation.ReadPlace{place: receiver_place_id})
                }
                else -> {
                    lowered_receiver = jet_codegen_lower_expr(&builder, receiver)
                }
            }
        }
        else -> {
            lowered := jet_codegen_lower_builtin_receiver(&builder, receiver, mutating)
            lowered_receiver = lowered.value
            receiver_place = lowered.place
        }
    }
    lowered_args := [MIRValueID]{}
    loop argument in args -> &lowered_args.push(jet_codegen_lower_expr(&builder, argument))
    if operation == {
        .ByteBufferWithCapacity -> {
            lowered_receiver = jet_codegen_builtin_native_int(&builder, lowered_receiver, receiver.ty, receiver.span)
        }
        else -> {}
    }
    if operation == { .GetList | .DequeGet -> {
        if args.len() == 0 -> panic("checked builtin requires an index operand")
        lowered_args[0] = jet_codegen_builtin_native_int(&builder, lowered_args[0], args[0].ty, args[0].span)
    } else -> {} }
    if operation == { .ListReplace | .MatchGroup -> {
        if args.len() == 0 -> panic("checked builtin requires an index operand")
        lowered_args[0] = jet_codegen_builtin_native_int(&builder, lowered_args[0], args[0].ty, args[0].span)
    } else -> {} }
    if operation == { .Repeat -> {
        if args.len() == 0 -> panic("checked builtin requires a repeat count")
        lowered_args[0] = jet_codegen_builtin_native_int(&builder, lowered_args[0], args[0].ty, args[0].span)
    } else -> {} }
    if operation == {
        .ByteBufferWithCapacity -> {}
        else -> {}
    }
    view_range := if operation == { .ViewNew(_) | .ViewMutNew(_) -> true else -> false }
    if !view_range && lowered_args.len() + 1 != route.arity -> panic("checked builtin operand count disagrees with its canonical route")
    if route.borrow_mask.len() != route.arity -> panic("canonical builtin borrow mask disagrees with its route arity")
    call := jet_codegen_intern_route(&builder, MIRPreludeFamily.BuiltinMethod, route.module_name, route.member, route.symbol, route.arity, route.borrow_mask, route.effect_kind, jet_codegen_failure_carrier_for_type(expression.ty), route.abi)
    if operation == { .MapFromKeys -> {
        if receiver.ty == { .FixedList(_, _) -> {
            receiver_arg := jet_codegen_host_call_value_arg(lowered_receiver, receiver.span, jet_codegen_host_value_access(builder, lowered_receiver, false), None)
            receiver_arg.widen_fixed_to_list = true
            call_args := [MIRCallArg]{receiver_arg}
            index := 0
            loop index < lowered_args.len() {
                arg := lowered_args[index]
                &call_args.push(jet_codegen_host_call_value_arg(arg, args[index].span, jet_codegen_host_value_access(builder, arg, false), None))
                index += 1
            }
            return jet_codegen_emit_value(&builder, expression.span, expression.ty, MIROperation.Semantic{operation: MIRSemanticOp.StaticPreludeCall{call: call, args: call_args, owner_type_args: [MIRPreludeTypeArg]{}, type_args: [MIRType]{}}})
        } else -> {} }
    } else -> {} }
    jet_codegen_emit_value(&builder, expression.span, expression.ty, MIROperation.Semantic{operation: MIRSemanticOp.BuiltinMethod{call: call, receiver: lowered_receiver, receiver_place: receiver_place, args: lowered_args, aggregate_fields: None}})
}
fn jet_codegen_builtin_static_call(builder: &JetCodegenBuilder, span: Span, result_type: Type, route: JetCodegenBuiltinRoute, carrier: TFailureCarrier, values: [MIRValueID], spans: [Span]) -> MIRValueID Never! {
    if values.len() != route.arity || spans.len() != values.len() -> panic("checked static builtin operands disagree with its canonical route")
    if route.borrow_mask.len() != route.arity -> panic("canonical static builtin borrow mask disagrees with its route arity")
    call_args := [MIRCallArg]{}
    index := 0
    loop index < values.len() {
        value := values[index]
        access := jet_codegen_host_value_access(builder, value, route.borrow_mask[index])
        &call_args.push(jet_codegen_host_call_value_arg(value, spans[index], access, None))
        index += 1
    }
    call := jet_codegen_intern_route(&builder, MIRPreludeFamily.BuiltinMethod, route.module_name, route.member, route.symbol, route.arity, route.borrow_mask, route.effect_kind, carrier, route.abi)
    jet_codegen_emit_value(&builder, span, result_type, MIROperation.Semantic{operation: MIRSemanticOp.StaticPreludeCall{call: call, args: call_args, owner_type_args: [MIRPreludeTypeArg]{}, type_args: [MIRType]{}}})
}

fn jet_codegen_builtin_option_zip_value(builder: &JetCodegenBuilder, span: Span, value: MIRValueID, source: Type, target: Type) -> MIRValueID Never! {
    if source == target -> return ~value
    target_inner := jet_codegen_builtin_untag(target)
    source_inner := jet_codegen_builtin_untag(source)
    trait_target := if target_inner == {
        .TraitObject(bounds) -> {
            if bounds.len() != 1 -> panic("checked Option.zip trait field is not a single-trait object")
            target_inner
        }
        .Named(name) -> {
            if !jet_codegen_trait_bound_is_declared(builder.modules, name, builder.function.module_identity) -> panic("checked Option.zip trait field names an undeclared trait")
            Type.TraitObject{bounds: [String]{name}}
        }
        else -> panic("checked Option.zip tuple field has no coercion fact")
    }
    if source_inner == {
        .TraitObject(_) -> panic("checked Option.zip trait field has no canonical upcast")
        .Named(name) -> {
            if jet_codegen_trait_bound_is_declared(builder.modules, name, builder.function.module_identity) -> panic("checked Option.zip trait field has no canonical upcast")
        }
        else -> {}
    }
    if source_inner == {
        .Named(_) | .Apply(_, _) -> {}
        else -> panic("checked Option.zip trait coercion source is not nominal")
    }
    jet_codegen_require_trait_box_target(trait_target, builder)
    target_type := jet_codegen_lower_type_for_function(trait_target, builder)
    target_id :: target_type.identity ?? panic("checked Option.zip trait field has no MIR identity")
    jet_codegen_emit_value(&builder, span, trait_target, MIROperation.TraitBox{value: value, target: target_id})
}

fn jet_codegen_lower_builtin_option_zip(builder: &JetCodegenBuilder, expression: TExpr, receiver: TExpr, args: [TExpr], tuple_type: Type) -> MIRValueID {
    if args.len() != 1 -> panic("checked Option.zip requires one operand")
    left_inner := if jet_codegen_builtin_untag(receiver.ty) == { .Option(inner) -> inner else -> panic("checked Option.zip receiver is not optional") }
    right_inner := if jet_codegen_builtin_untag(args[0].ty) == { .Option(inner) -> inner else -> panic("checked Option.zip operand is not optional") }
    fields := if jet_codegen_builtin_untag(tuple_type) == { .Tuple(fields) -> fields else -> panic("checked Option.zip result has no tuple fields") }
    if fields.len() != 2 -> panic("checked Option.zip tuple shape is inconsistent")
    tuple_mir_type := jet_codegen_lower_type_for_function(tuple_type, builder)
    tuple_owner :: tuple_mir_type.identity ?? panic("checked Option.zip tuple has no canonical identity")
    left := jet_codegen_lower_expr(&builder, receiver)
    right := jet_codegen_lower_expr(&builder, args[0])
    left_condition := jet_codegen_emit_value(&builder, expression.span, Type.Bool, MIROperation.OptionIsSome{subject: left})
    left_present := jet_codegen_new_block(&builder, expression.span, "option-zip-left-present")
    left_absent := jet_codegen_new_block(&builder, expression.span, "option-zip-left-absent")
    join := jet_codegen_new_block(&builder, expression.span, "option-zip-join")
    jet_codegen_terminate(&builder, MIRTerminator.Branch{condition: left_condition, then_target: left_present, else_target: left_absent})
    incoming := [MIRPhiIncoming]{}

    jet_codegen_switch_block(&builder, left_present)
    left_source_type := left_inner
    left_raw := jet_codegen_emit_value(&builder, expression.span, left_source_type, MIROperation.OptionValue{subject: left})
    left_value := jet_codegen_builtin_option_zip_value(&builder, expression.span, left_raw, left_source_type, fields[0].ty)
    right_condition := jet_codegen_emit_value(&builder, expression.span, Type.Bool, MIROperation.OptionIsSome{subject: right})
    both_present := jet_codegen_new_block(&builder, expression.span, "option-zip-both-present")
    right_absent := jet_codegen_new_block(&builder, expression.span, "option-zip-right-absent")
    jet_codegen_terminate(&builder, MIRTerminator.Branch{condition: right_condition, then_target: both_present, else_target: right_absent})

    jet_codegen_switch_block(&builder, both_present)
    right_source_type := right_inner
    right_raw := jet_codegen_emit_value(&builder, expression.span, right_source_type, MIROperation.OptionValue{subject: right})
    right_value := jet_codegen_builtin_option_zip_value(&builder, expression.span, right_raw, right_source_type, fields[1].ty)
    tuple_fields := [MIRFieldValue]{
        MIRFieldValue{field: jet_codegen_host_field_id(builder, tuple_type, fields[0].name), value: left_value},
        MIRFieldValue{field: jet_codegen_host_field_id(builder, tuple_type, fields[1].name), value: right_value},
    }
    tuple := jet_codegen_emit_value(&builder, expression.span, tuple_type, MIROperation.Tuple{type_id: tuple_owner, fields: tuple_fields})
    present := jet_codegen_emit_value(&builder, expression.span, expression.ty, MIROperation.Present{value: tuple})
    present_source := builder.current
    jet_codegen_terminate(&builder, MIRTerminator.Jump{target: join})
    &incoming.push(MIRPhiIncoming{block: present_source, value: present})

    jet_codegen_switch_block(&builder, right_absent)
    absent_right := jet_codegen_emit_value(&builder, expression.span, expression.ty, MIROperation.Absent)
    absent_right_source := builder.current
    jet_codegen_terminate(&builder, MIRTerminator.Jump{target: join})
    &incoming.push(MIRPhiIncoming{block: absent_right_source, value: absent_right})

    jet_codegen_switch_block(&builder, left_absent)
    absent_left := jet_codegen_emit_value(&builder, expression.span, expression.ty, MIROperation.Absent)
    absent_left_source := builder.current
    jet_codegen_terminate(&builder, MIRTerminator.Jump{target: join})
    &incoming.push(MIRPhiIncoming{block: absent_left_source, value: absent_left})
    jet_codegen_switch_block(&builder, join)
    jet_codegen_emit_value(&builder, expression.span, expression.ty, MIROperation.Phi{incoming: incoming})
}

fn jet_codegen_lower_builtin_list_min_max(builder: &JetCodegenBuilder, expression: TExpr, receiver: TExpr, operation: TBuiltinOp, args: [TExpr]) -> MIRValueID {
    if args.len() != 0 -> panic("checked List.min_max operation received unexpected arguments")
    optional_inner := if jet_codegen_builtin_untag(expression.ty) == { .Option(inner) -> inner else -> panic("checked List.min_max result is not optional") }
    tuple_type := jet_codegen_builtin_untag(optional_inner)
    fields := if tuple_type == { .Tuple(fields) -> fields else -> panic("checked List.min_max result has no named tuple fields") }
    if fields.len() != 2 -> panic("checked List.min_max result must contain exactly min and max fields")
    has_min := false
    has_max := false
    loop field in fields {
        if field.name == "min" -> has_min = true
        if field.name == "max" -> has_max = true
    }
    if !has_min || !has_max -> panic("checked List.min_max result must contain exactly min and max fields")
    aggregate_fields := [MIRFieldID]{
        jet_codegen_host_field_id(builder, tuple_type, "min"),
        jet_codegen_host_field_id(builder, tuple_type, "max"),
    }
    carrier := jet_codegen_failure_carrier_for_type(expression.ty)
    route := jet_codegen_builtin_route_plan(operation, receiver.ty, expression.ty, carrier)
    call := jet_codegen_intern_route(&builder, MIRPreludeFamily.BuiltinMethod, route.module_name, route.member, route.symbol, route.arity, route.borrow_mask, route.effect_kind, carrier, route.abi)
    lowered_receiver := jet_codegen_lower_builtin_receiver(&builder, receiver, false)
    jet_codegen_emit_value(&builder, expression.span, expression.ty, MIROperation.Semantic{operation: MIRSemanticOp.BuiltinMethod{call: call, receiver: lowered_receiver.value, receiver_place: lowered_receiver.place, args: [MIRValueID]{}, aggregate_fields: Val(aggregate_fields)}})
}

// `map.to_list()` / `map.items()`: the Prelude fills one `(key, value)` named
// tuple per entry, so the call carries the tuple's two field identities.
fn jet_codegen_lower_builtin_map_to_list(builder: &JetCodegenBuilder, expression: TExpr, receiver: TExpr, operation: TBuiltinOp, args: [TExpr]) -> MIRValueID {
    if args.len() != 0 -> panic("checked Map.to_list operation received unexpected arguments")
    tuple_type := if jet_codegen_builtin_untag(expression.ty) == { .List(inner) -> jet_codegen_builtin_untag(inner) else -> panic("checked Map.to_list result is not a list") }
    fields := if tuple_type == { .Tuple(fields) -> fields else -> panic("checked Map.to_list result has no named tuple fields") }
    if fields.len() != 2 -> panic("checked Map.to_list entry must contain exactly key and value fields")
    aggregate_fields := [MIRFieldID]{
        jet_codegen_host_field_id(builder, tuple_type, "key"),
        jet_codegen_host_field_id(builder, tuple_type, "value"),
    }
    carrier := jet_codegen_failure_carrier_for_type(expression.ty)
    route := jet_codegen_builtin_route_plan(operation, receiver.ty, expression.ty, carrier)
    call := jet_codegen_intern_route(&builder, MIRPreludeFamily.BuiltinMethod, route.module_name, route.member, route.symbol, route.arity, route.borrow_mask, route.effect_kind, carrier, route.abi)
    lowered_receiver := jet_codegen_lower_builtin_receiver(&builder, receiver, false)
    jet_codegen_emit_value(&builder, expression.span, expression.ty, MIROperation.Semantic{operation: MIRSemanticOp.BuiltinMethod{call: call, receiver: lowered_receiver.value, receiver_place: lowered_receiver.place, args: [MIRValueID]{}, aggregate_fields: Val(aggregate_fields)}})
}

fn jet_codegen_lower_builtin_indexes(builder: &JetCodegenBuilder, expression: TExpr, receiver: TExpr, args: [TExpr]) -> MIRValueID {
    if args.len() != 0 -> panic("checked indexes operation received unexpected arguments")
    lowered_receiver := jet_codegen_lower_builtin_receiver(&builder, receiver, false).value
    carrier := TFailureCarrier.Infallible
    length_route := jet_codegen_builtin_route_plan(TBuiltinOp.LenList, receiver.ty, Type.Int, carrier)
    length := jet_codegen_builtin_static_call(&builder, expression.span, Type.Int, length_route, TFailureCarrier.Infallible, [MIRValueID]{lowered_receiver}, [Span]{receiver.span})
    native_length := jet_codegen_builtin_native_int(&builder, length, Type.Int, expression.span)
    result_carrier := jet_codegen_failure_carrier_for_type(expression.ty)
    route := jet_codegen_builtin_route_plan(TBuiltinOp.Indexes, receiver.ty, expression.ty, result_carrier)
    jet_codegen_builtin_static_call(&builder, expression.span, expression.ty, route, result_carrier, [MIRValueID]{native_length}, [Span]{expression.span})
}

fn jet_codegen_lower_builtin_dynamic_remove(builder: &JetCodegenBuilder, expression: TExpr, receiver: TExpr, line: Int, args: [TExpr]) -> MIRValueID {
    if args.len() != 2 -> panic("checked dynamic list removal requires an item and a RemoveBy selector")
    if jet_codegen_builtin_untag(args[1].ty) != (Type.Named{name: "RemoveBy"}) -> panic("checked dynamic list removal selector is not RemoveBy")
    carrier := jet_codegen_failure_carrier_for_type(expression.ty)
    lowered_receiver := jet_codegen_lower_builtin_receiver(&builder, receiver, true)
    item := jet_codegen_lower_expr(&builder, args[0])
    selector := jet_codegen_lower_expr(&builder, args[1])
    owner := jet_codegen_type_instance_id(Type.Named{name: "RemoveBy"}, builder.modules, builder.function.module_identity, builder.generic_type_names)
    by_value := jet_codegen_emit_value(&builder, args[1].span, Type.Bool, MIROperation.EnumIs{subject: selector, owner: owner, variant: "Val"})
    value_block := jet_codegen_new_block(&builder, expression.span, "list-remove-value")
    slot_block := jet_codegen_new_block(&builder, expression.span, "list-remove-slot")
    join := jet_codegen_new_block(&builder, expression.span, "list-remove-join")
    jet_codegen_terminate(&builder, MIRTerminator.Branch{condition: by_value, then_target: value_block, else_target: slot_block})
    incoming := [MIRPhiIncoming]{}

    jet_codegen_switch_block(&builder, value_block)
    value_route := jet_codegen_builtin_route_plan(TBuiltinOp.RemoveList{line: line, mode: TListRemoveMode.Value}, receiver.ty, expression.ty, carrier)
    value_call := jet_codegen_intern_route(&builder, MIRPreludeFamily.BuiltinMethod, value_route.module_name, value_route.member, value_route.symbol, value_route.arity, value_route.borrow_mask, value_route.effect_kind, carrier, value_route.abi)
    value_result := jet_codegen_emit_value(&builder, expression.span, expression.ty, MIROperation.Semantic{operation: MIRSemanticOp.BuiltinMethod{call: value_call, receiver: lowered_receiver.value, receiver_place: lowered_receiver.place, args: [MIRValueID]{item}, aggregate_fields: None}})
    value_source := builder.current
    jet_codegen_terminate(&builder, MIRTerminator.Jump{target: join})
    &incoming.push(MIRPhiIncoming{block: value_source, value: value_result})

    jet_codegen_switch_block(&builder, slot_block)
    slot_route := jet_codegen_builtin_route_plan(TBuiltinOp.RemoveList{line: line, mode: TListRemoveMode.Slot}, receiver.ty, expression.ty, carrier)
    slot_call := jet_codegen_intern_route(&builder, MIRPreludeFamily.BuiltinMethod, slot_route.module_name, slot_route.member, slot_route.symbol, slot_route.arity, slot_route.borrow_mask, slot_route.effect_kind, carrier, slot_route.abi)
    slot_result := jet_codegen_emit_value(&builder, expression.span, expression.ty, MIROperation.Semantic{operation: MIRSemanticOp.BuiltinMethod{call: slot_call, receiver: lowered_receiver.value, receiver_place: lowered_receiver.place, args: [MIRValueID]{item}, aggregate_fields: None}})
    slot_source := builder.current
    jet_codegen_terminate(&builder, MIRTerminator.Jump{target: join})
    &incoming.push(MIRPhiIncoming{block: slot_source, value: slot_result})
    jet_codegen_switch_block(&builder, join)
    jet_codegen_emit_value(&builder, expression.span, expression.ty, MIROperation.Phi{incoming: incoming})
}
fn jet_codegen_lower_builtin_dynamic_priority_queue_remove(builder: &JetCodegenBuilder, expression: TExpr, receiver: TExpr, line: Int, args: [TExpr]) -> MIRValueID {
    if args.len() != 2 -> panic("checked dynamic priority queue removal requires an item and a RemoveBy selector")
    if jet_codegen_builtin_untag(args[1].ty) != (Type.Named{name: "RemoveBy"}) -> panic("checked dynamic priority queue removal selector is not RemoveBy")
    carrier := jet_codegen_failure_carrier_for_type(expression.ty)
    lowered_receiver := jet_codegen_lower_builtin_receiver(&builder, receiver, true)
    item := jet_codegen_lower_expr(&builder, args[0])
    selector := jet_codegen_lower_expr(&builder, args[1])
    owner := jet_codegen_type_instance_id(Type.Named{name: "RemoveBy"}, builder.modules, builder.function.module_identity, builder.generic_type_names)
    by_value := jet_codegen_emit_value(&builder, args[1].span, Type.Bool, MIROperation.EnumIs{subject: selector, owner: owner, variant: "Val"})
    value_block := jet_codegen_new_block(&builder, expression.span, "priority-queue-remove-value")
    slot_block := jet_codegen_new_block(&builder, expression.span, "priority-queue-remove-slot")
    join := jet_codegen_new_block(&builder, expression.span, "priority-queue-remove-join")
    jet_codegen_terminate(&builder, MIRTerminator.Branch{condition: by_value, then_target: value_block, else_target: slot_block})
    incoming := [MIRPhiIncoming]{}

    jet_codegen_switch_block(&builder, value_block)
    value_route := jet_codegen_builtin_route_plan(TBuiltinOp.PriorityQueueRemove{line: line, mode: TListRemoveMode.Value}, receiver.ty, expression.ty, carrier)
    value_call := jet_codegen_intern_route(&builder, MIRPreludeFamily.BuiltinMethod, value_route.module_name, value_route.member, value_route.symbol, value_route.arity, value_route.borrow_mask, value_route.effect_kind, carrier, value_route.abi)
    value_result := jet_codegen_emit_value(&builder, expression.span, expression.ty, MIROperation.Semantic{operation: MIRSemanticOp.BuiltinMethod{call: value_call, receiver: lowered_receiver.value, receiver_place: lowered_receiver.place, args: [MIRValueID]{item}, aggregate_fields: None}})
    value_source := builder.current
    jet_codegen_terminate(&builder, MIRTerminator.Jump{target: join})
    &incoming.push(MIRPhiIncoming{block: value_source, value: value_result})

    jet_codegen_switch_block(&builder, slot_block)
    slot_route := jet_codegen_builtin_route_plan(TBuiltinOp.PriorityQueueRemove{line: line, mode: TListRemoveMode.Slot}, receiver.ty, expression.ty, carrier)
    slot_call := jet_codegen_intern_route(&builder, MIRPreludeFamily.BuiltinMethod, slot_route.module_name, slot_route.member, slot_route.symbol, slot_route.arity, slot_route.borrow_mask, slot_route.effect_kind, carrier, slot_route.abi)
    slot_result := jet_codegen_emit_value(&builder, expression.span, expression.ty, MIROperation.Semantic{operation: MIRSemanticOp.BuiltinMethod{call: slot_call, receiver: lowered_receiver.value, receiver_place: lowered_receiver.place, args: [MIRValueID]{item}, aggregate_fields: None}})
    slot_source := builder.current
    jet_codegen_terminate(&builder, MIRTerminator.Jump{target: join})
    &incoming.push(MIRPhiIncoming{block: slot_source, value: slot_result})
    jet_codegen_switch_block(&builder, join)
    jet_codegen_emit_value(&builder, expression.span, expression.ty, MIROperation.Phi{incoming: incoming})
}


fn jet_codegen_lower_builtin_unzip(builder: &JetCodegenBuilder, expression: TExpr, receiver: TExpr) -> MIRValueID {
    tuple_fields := if jet_codegen_builtin_untag(expression.ty) == { .Tuple(fields) -> fields else -> panic("checked unzip result is not a tuple") }
    item_type := if jet_codegen_builtin_untag(receiver.ty) == {
        .List(element) | .FixedList(element, _) -> element
        .Apply(_, elements) -> if jet_codegen_builtin_iter_receiver(receiver.ty) && elements.len() == 1 -> elements[0] else -> panic("checked unzip receiver is not a sequence")
        else -> panic("checked unzip receiver is not a sequence")
    }
    item_fields := if jet_codegen_builtin_untag(item_type) == { .Tuple(fields) -> fields else -> panic("checked unzip item has no named tuple fields") }
    if tuple_fields.len() != item_fields.len() -> panic("checked unzip input and output tuple arity disagree")
    source := jet_codegen_lower_builtin_receiver(&builder, receiver, false).value
    column_types := [Type]{}
    column_elements := [Type]{}
    column_places := [MIRPlaceID]{}
    input_fields := [MIRFieldID]{}
    output_fields := [MIRFieldID]{}
    push_calls := [MIRPreludeCallID]{}
    index := 0
    loop index < tuple_fields.len() {
        field := tuple_fields[index]
        column_type := jet_codegen_builtin_untag(field.ty)
        element := if column_type == { .List(element) -> element else -> panic("checked unzip column is not a List") }
        input_name := field.name
        local := tir_generated_local("unzip_{source.value}_{field.name}", expression.span)
        local.mutable = true
        place := jet_codegen_bind_local(&builder, local, field.ty, true, None, None, false)
        empty := jet_codegen_emit_value(&builder, expression.span, field.ty, MIROperation.BuildList{values: [MIRValueID]{}, trait_coercion: None})
        _ := jet_codegen_emit(&builder, expression.span, None, MIROperation.WritePlace{place: place, value: empty})
        &column_types.push(field.ty)
        &column_elements.push(element)
        &column_places.push(place)
        &input_fields.push(jet_codegen_host_field_id(builder, item_type, input_name))
        &output_fields.push(jet_codegen_host_field_id(builder, expression.ty, field.name))
        push_route := jet_codegen_builtin_route("list_push", "jet_list_push", 2, [Bool]{true, false}, Val(Effect.Mem))
        &push_calls.push(jet_codegen_intern_route(&builder, MIRPreludeFamily.BuiltinMethod, push_route.module_name, push_route.member, push_route.symbol, push_route.arity, push_route.borrow_mask, push_route.effect_kind, TFailureCarrier.Infallible, push_route.abi))
        index += 1
    }
    iter_init := jet_codegen_add_loop_prelude_call(&builder, "loop_iter_init", "jet_loop_iter_init", 5, [Bool]{false, false, false, false, false})
    iter_has_next := jet_codegen_add_loop_prelude_call(&builder, "loop_iter_has_next", "jet_loop_iter_has_next", 1, [Bool]{true})
    iter_value := jet_codegen_add_loop_prelude_call(&builder, "loop_iter_value", "jet_loop_iter_value", 1, [Bool]{true})
    iter_advance := jet_codegen_add_loop_prelude_call(&builder, "loop_iter_advance", "jet_loop_iter_advance", 1, [Bool]{true})
    cursor := jet_codegen_emit_value(&builder, expression.span, Type.Named{name: "IterCursor"}, MIROperation.LoopIterInit{call: iter_init, collection: source, step: None, by_value: true, source_kind: MIRLoopSourceKind.Plain})
    header := jet_codegen_new_block(&builder, expression.span, "unzip-header")
    body := jet_codegen_new_block(&builder, expression.span, "unzip-body")
    exit := jet_codegen_new_block(&builder, expression.span, "unzip-exit")
    jet_codegen_terminate(&builder, MIRTerminator.Jump{target: header})
    jet_codegen_switch_block(&builder, header)
    condition := jet_codegen_emit_value(&builder, expression.span, Type.Bool, MIROperation.LoopIterHasNext{call: iter_has_next, cursor: cursor})
    jet_codegen_terminate(&builder, MIRTerminator.Branch{condition: condition, then_target: body, else_target: exit})
    jet_codegen_switch_block(&builder, body)
    row := jet_codegen_emit_value(&builder, expression.span, item_type, MIROperation.LoopIterValue{call: iter_value, cursor: cursor})
    index = 0
    loop index < tuple_fields.len() {
        value := jet_codegen_emit_value(&builder, expression.span, column_elements[index], MIROperation.Field{base: row, field: input_fields[index]})
        column_ref := jet_codegen_emit_value(&builder, expression.span, column_types[index], MIROperation.AddressOf{place: column_places[index], access: MIRAccess.Write})
        _ := jet_codegen_emit(&builder, expression.span, None, MIROperation.Semantic{operation: MIRSemanticOp.BuiltinMethod{call: push_calls[index], receiver: column_ref, receiver_place: Val(column_places[index]), args: [MIRValueID]{value}, aggregate_fields: None}})
        index += 1
    }
    _ := jet_codegen_emit(&builder, expression.span, None, MIROperation.LoopIterAdvance{call: iter_advance, cursor: cursor})
    jet_codegen_terminate(&builder, MIRTerminator.Jump{target: header})
    jet_codegen_switch_block(&builder, exit)
    tuple_mir_type := jet_codegen_lower_type_for_function(expression.ty, builder)
    tuple_owner :: tuple_mir_type.identity ?? panic("checked unzip tuple has no canonical identity")
    result_fields := [MIRFieldValue]{}
    index = 0
    loop index < tuple_fields.len() {
        column := jet_codegen_emit_value(&builder, expression.span, column_types[index], MIROperation.MovePlace{place: column_places[index]})
        &result_fields.push(MIRFieldValue{field: output_fields[index], value: column})
        index += 1
    }
    jet_codegen_emit_value(&builder, expression.span, expression.ty, MIROperation.Tuple{type_id: tuple_owner, fields: result_fields})
}
fn jet_codegen_builtin_closure_call(builder: &JetCodegenBuilder, span: Span, result_type: Type, route: JetCodegenBuiltinRoute, receiver: MIRValueID, values: [MIRValueID]) -> MIRValueID Never! {
    if values.len() + 1 != route.arity -> panic("checked tuple builtin operands disagree with its canonical route")
    if route.borrow_mask.len() != route.arity -> panic("canonical tuple builtin borrow mask disagrees with its route arity")
    call_args := [MIRCallArg]{}
    index := 0
    loop index < values.len() {
        value := values[index]
        access := jet_codegen_host_value_access(builder, value, route.borrow_mask[index + 1])
        &call_args.push(jet_codegen_host_call_value_arg(value, span, access, None))
        index += 1
    }
    call := jet_codegen_intern_route(&builder, MIRPreludeFamily.BuiltinMethod, route.module_name, route.member, route.symbol, route.arity, route.borrow_mask, route.effect_kind, jet_codegen_failure_carrier_for_type(result_type), route.abi)
    jet_codegen_emit_value(&builder, span, result_type, MIROperation.Semantic{operation: MIRSemanticOp.ClosureMethod{receiver: receiver, args: call_args, call: call}})
}

fn jet_codegen_builtin_synthetic_lambda(builder: &JetCodegenBuilder, span: Span, source_params: [String], source_symbols: [SymbolID], params: [Type], result_type: Type, executable: TLambdaBody, jit_name: String) -> MIRValueID {
    if source_params.len() != params.len() || source_symbols.len() != params.len() -> panic("checked synthetic builtin callback metadata has inconsistent parameters")
    lambda := TLambda{
        executable: executable,
        source_span: span,
        frame_schedule: None,
        frame_schedule_derivation: None,
        capture_facts: TCaptureFacts{escapes: false, needs_fn_mut: false, mutable: [String]{}, cloned: [String]{}, frozen: [String]{}, materialized: [String]{}, moved: [String]{}},
        failure_carrier: TFailureCarrier.Infallible,
        effects: TEffectFacts{direct: [String]{}, solved: [String]{}, call_edges: [String]{}, maximal: false, direct_spans: [TEffectSpan]{}},
        host_param_conventions: None,
        source_params: source_params,
        source_param_symbols: source_symbols,
        jit_name: jit_name,
        param_types: params,
        ret: Val(result_type),
        is_move: true,
        boxed: false,
        rc: false,
        arc: false,
        captures: [TCapture]{},
        materialized_captures: [String]{},
        frozen_captures: [String]{},
        uses_stack_sentry: false,
    }
    jet_codegen_lower_lambda(&builder, lambda, false, "direct").value
}

fn jet_codegen_builtin_callback_symbol(builder: JetCodegenBuilder, span: Span, key: String, name: String) -> SymbolID Never! {
    owner_key := "{builder.function.key}::builtin-callback-{key}@{span.start}..{span.end}"
    symbol_id(SymbolKind.Parameter, builder.function.module_identity, owner_key, name)
}

fn jet_codegen_builtin_tuple_callback(builder: &JetCodegenBuilder, span: Span, key: String, row_type: Type, fields: [TypeTupleField], params: [Type], indexed: Bool) -> MIRValueID {
    if fields.len() != params.len() -> panic("checked tuple builtin callback arity disagrees with its row")
    source_params := [String]{}
    source_symbols := [SymbolID]{}
    row_values := [TExpr]{}
    index := 0
    loop index < params.len() {
        name := "zip_{index}"
        parameter_symbol := jet_codegen_builtin_callback_symbol(builder, span, "tuple-{key}", name)
        local := tir_symbol_local(name, span, parameter_symbol)
        value := TExpr{ty: params[index], kind: TExprKind.Local{local: local}, span: span, integer_bounds: None, cost: None}
        if indexed && index == 0 {
            value = TExpr{
                ty: fields[index].ty,
                kind: TExprKind.NumericMethod{receiver: value, operation: TNumericOp.CastAs{dst_rust: "i64"}},
                span: span,
                integer_bounds: None,
                cost: None,
            }
        }
        &row_values.push(value)
        &source_params.push(name)
        &source_symbols.push(parameter_symbol)
        index += 1
    }
    body := TExpr{
        ty: row_type,
        kind: TExprKind.Tuple{values: row_values},
        span: span,
        integer_bounds: None,
        cost: None,
    }
    jet_codegen_builtin_synthetic_lambda(&builder, span, source_params, source_symbols, params, row_type, TLambdaBody.Expr{value: body}, "builtin_tuple_{key}_{span.start}")
}

fn jet_codegen_builtin_list_lazy(builder: &JetCodegenBuilder, span: Span, receiver: TExpr, value: MIRValueID, element: Type) -> MIRValueID Never! {
    iter_type := Type.Apply{name: "Iter", args: [Type]{element}}
    route := jet_codegen_builtin_route_plan(TBuiltinOp.ListLazy, receiver.ty, iter_type, TFailureCarrier.Infallible)
    call := jet_codegen_intern_route(&builder, MIRPreludeFamily.BuiltinMethod, route.module_name, route.member, route.symbol, route.arity, route.borrow_mask, route.effect_kind, TFailureCarrier.Infallible, route.abi)
    access := jet_codegen_host_value_access(builder, value, route.borrow_mask[0])
    receiver_arg := jet_codegen_host_call_value_arg(value, receiver.span, access, None)
    if jet_codegen_builtin_untag(receiver.ty) == {
        .FixedList(_, _) -> {
            receiver_arg.widen_fixed_to_list = true
        }
        else -> {}
    }
    jet_codegen_emit_value(&builder, span, iter_type, MIROperation.Semantic{operation: MIRSemanticOp.StaticPreludeCall{call: call, args: [MIRCallArg]{receiver_arg}, owner_type_args: [MIRPreludeTypeArg]{}, type_args: [MIRType]{}}})
}
fn jet_codegen_builtin_zip_route(mode: TZipMode) -> JetCodegenBuiltinRoute Never! {
    if mode == {
        .Short -> return jet_codegen_builtin_route_row("core.iter", "zip", "jet_iter_zip", 3, [Bool]{false, false, false}, None, MIRPreludeABI.Value)
        .Strict -> return jet_codegen_builtin_route_row("core.iter", "zip_strict", "jet_iter_zip_strict", 10, [Bool]{false, false, false, false, false, false, false, false, false, false}, None, MIRPreludeABI.Value)
        .Pad -> return jet_codegen_builtin_route_row("core.iter", "zip_pad", "jet_iter_zip_pad", 5, [Bool]{false, false, false, false, false}, None, MIRPreludeABI.Value)
    }
}

fn jet_codegen_builtin_zip_context_arg(builder: &JetCodegenBuilder, span: Span, ty: Type, constant: MIRConstant) -> MIRCallArg Never! {
    value := jet_codegen_emit_value(&builder, span, ty, MIROperation.Constant{value: constant})
    jet_codegen_host_call_value_arg(value, span, MIRAccess.Read, None)
}

fn jet_codegen_builtin_zip_context_args(builder: &JetCodegenBuilder, span: Span) -> [MIRCallArg] Never! {
    row :: jet_codegen_builder_source_row(builder, "ambiguous checked zip source context", "checked zip has no readonly source context")
    if builder.source_files[row].id != mir_source_file_id(builder.source_files[row].path) -> panic("checked zip source context has a conflicting file identity")
    byte_count :: builder.source_index.rows[row].bytes.len()
    if span.start < 0 || span.start > byte_count || span.end < span.start || span.end > byte_count -> panic("checked zip span falls outside its readonly source context")
    line :: jet_codegen_line_of(builder.source_index.rows[row].line_starts, span.start)
    line_start :: builder.source_index.rows[row].line_starts[line - 1]
    column := 1
    loop offset in line_start..<span.start {
        byte :: builder.source_index.rows[row].bytes[offset]
        if byte < (U8{128}) || byte >= (U8{192}) -> column += 1
    }
    line_end :: jet_codegen_source_line_end(builder.source_index.rows[row].bytes, line_start)
    line_text := String.from_bytes(jet_codegen_source_byte_range(builder.source_index.rows[row].bytes, line_start, line_end)) ?? panic("checked zip source line is not valid UTF-8")
    source_line := line_text.trim_end()
    caret := span.end - span.start
    if line > 4294967295 || column > 4294967295 || caret > 4294967295 -> panic("checked zip source context does not fit u32")
    u32_type := Type.IntN{signed: false, bits: 32}
    u32_width := Val(MIRIntegerWidth{signed: false, bits: 32})
    name := builder.function.name
    source_file := builder.function.source_file
    [
        jet_codegen_builtin_zip_context_arg(&builder, span, Type.String, MIRConstant.String{value: "strict"}),
        jet_codegen_builtin_zip_context_arg(&builder, span, Type.String, MIRConstant.String{value: source_file}),
        jet_codegen_builtin_zip_context_arg(&builder, span, u32_type, MIRConstant.Int{value: line, width: u32_width, spelling: None}),
        jet_codegen_builtin_zip_context_arg(&builder, span, Type.String, MIRConstant.String{value: name}),
        jet_codegen_builtin_zip_context_arg(&builder, span, Type.String, MIRConstant.String{value: source_line}),
        jet_codegen_builtin_zip_context_arg(&builder, span, u32_type, MIRConstant.Int{value: column, width: u32_width, spelling: None}),
        jet_codegen_builtin_zip_context_arg(&builder, span, u32_type, MIRConstant.Int{value: caret, width: u32_width, spelling: None}),
    ]
}

fn jet_codegen_builtin_semantic_closure_call(builder: &JetCodegenBuilder, span: Span, result_type: Type, route: JetCodegenBuiltinRoute, receiver: MIRValueID, values: [MIRValueID], accesses: [MIRAccess], strict_context: Bool) -> MIRValueID Never! {
    if values.len() != accesses.len() -> panic("checked closure builtin access metadata is inconsistent")
    context_args := if strict_context -> jet_codegen_builtin_zip_context_args(&builder, span) else -> [MIRCallArg]{}
    if values.len() + context_args.len() + 1 != route.arity -> panic("checked closure builtin operands disagree with its canonical route")
    if route.borrow_mask.len() != route.arity -> panic("canonical closure builtin borrow mask disagrees with its route arity")
    call_args := [MIRCallArg]{}
    index := 0
    loop index < values.len() {
        &call_args.push(jet_codegen_host_call_value_arg(values[index], span, accesses[index], None))
        index += 1
    }
    loop argument in context_args -> &call_args.push(argument)
    call := jet_codegen_intern_route(&builder, MIRPreludeFamily.ClosureMethod, route.module_name, route.member, route.symbol, route.arity, route.borrow_mask, route.effect_kind, TFailureCarrier.Infallible, route.abi)
    jet_codegen_emit_value(&builder, span, result_type, MIROperation.Semantic{operation: MIRSemanticOp.ClosureMethod{receiver: receiver, args: call_args, call: call}})
}

fn jet_codegen_builtin_zip_callback(builder: &JetCodegenBuilder, span: Span, key: String, row_type: Type, fields: [String], field_types: [Type], column: Int, left_type: Type) -> MIRValueID {
    if column < 1 || column >= fields.len() || fields.len() != field_types.len() -> panic("checked zip row callback has inconsistent column facts")
    params := [Type]{left_type, field_types[column]}
    source_params := [String]{"zip_0", "zip_1"}
    source_symbols := [SymbolID]{}
    loop name in source_params -> &source_symbols.push(jet_codegen_builtin_callback_symbol(builder, span, "zip-{key}", name))
    left := TExpr{ty: left_type, kind: TExprKind.Local{local: tir_symbol_local("zip_0", span, source_symbols[0])}, span: span, integer_bounds: None, cost: None}
    if column == 1 {
        right := TExpr{ty: field_types[column], kind: TExprKind.Local{local: tir_symbol_local("zip_1", span, source_symbols[1])}, span: span, integer_bounds: None, cost: None}
        body := TExpr{ty: row_type, kind: TExprKind.Tuple{values: [TExpr]{left, right}}, span: span, integer_bounds: None, cost: None}
        return jet_codegen_builtin_synthetic_lambda(&builder, span, source_params, source_symbols, params, row_type, TLambdaBody.Expr{value: body}, "builtin_zip_{key}_{span.start}")
    }
    binds := [TDestructureBinding]{}
    row_values := [TExpr]{}
    index := 0
    loop index < column {
        name := "zip_{key}_field_{index}"
        local := tir_generated_local(name, span)
        &binds.push(TDestructureBinding{local: local, field: fields[index]})
        &row_values.push(TExpr{ty: field_types[index], kind: TExprKind.Local{local: local}, span: span, integer_bounds: None, cost: None})
        index += 1
    }
    &row_values.push(TExpr{ty: field_types[column], kind: TExprKind.Local{local: tir_symbol_local("zip_1", span, source_symbols[1])}, span: span, integer_bounds: None, cost: None})
    body := TExpr{ty: row_type, kind: TExprKind.Tuple{values: row_values}, span: span, integer_bounds: None, cost: None}
    temporary := tir_generated_local("zip_{key}_left", span)
    destructure := TStmt.TupleDestructure{temp: temporary, init: left, move_fields: true, binds: binds, span: span}
    returned := TStmt.Return{value: Val(body), span: span}
    jet_codegen_builtin_synthetic_lambda(&builder, span, source_params, source_symbols, params, row_type, TLambdaBody.Block{body: [TStmt]{destructure, returned}}, "builtin_zip_{key}_{span.start}")
}

fn jet_codegen_builtin_zip_fill_callback(builder: &JetCodegenBuilder, span: Span, key: String, element: Type, target: Type) -> MIRValueID {
    name := "zip_0"
    parameter_symbol := jet_codegen_builtin_callback_symbol(builder, span, "zip-fill-{key}", name)
    local := TExpr{ty: element, kind: TExprKind.Local{local: tir_symbol_local(name, span, parameter_symbol)}, span: span, integer_bounds: None, cost: None}
    body := TExpr{ty: target, kind: TExprKind.Present{value: local}, span: span, integer_bounds: None, cost: None}
    jet_codegen_builtin_synthetic_lambda(&builder, span, [String]{name}, [SymbolID]{parameter_symbol}, [Type]{element}, target, TLambdaBody.Expr{value: body}, "builtin_zip_fill_{key}_{span.start}")
}

fn jet_codegen_lower_builtin_zip(builder: &JetCodegenBuilder, expression: TExpr, receiver: TExpr, args: [TExpr], mode: TZipMode, fields: [String], flatten: Bool, input_count: Int, fill_mode: TZipFillMode, field_types: [Type]) -> MIRValueID {
    fill_count := if mode == TZipMode.Pad && fill_mode != TZipFillMode.DefaultNone -> 1 else -> 0
    if flatten || input_count < 2 || fields.len() != input_count || field_types.len() != input_count || args.len() != input_count - 1 + fill_count -> panic("checked zip has inconsistent column facts")
    inputs := [TExpr]{receiver}
    input_values := [MIRValueID]{}
    input_index := 0
    loop input_index < input_count - 1 {
        &inputs.push(args[input_index])
        input_index += 1
    }
    loop input in inputs {
        value := jet_codegen_lower_builtin_receiver(&builder, input, false).value
        &input_values.push(value)
    }
    fill_value := MIRValueID?{None}
    fill_type := Type?{None}
    if fill_count == 1 {
        fill_expression := args[input_count - 1]
        fill_value = Val(jet_codegen_lower_expr(&builder, fill_expression))
        fill_type = Val(fill_expression.ty)
    }
    columns := [MIRValueID]{}
    fills := [MIRValueID]{}
    index := 0
    loop index < input_count {
        input_type := inputs[index].ty
        element := if jet_codegen_builtin_untag(input_type) == {
            .List(element) | .FixedList(element, _) -> element
            .Apply(name, elements) -> if jet_codegen_builtin_iter_receiver(input_type) && elements.len() == 1 -> elements[0] else -> panic("checked zip input has no sequence element")
            else -> panic("checked zip input has no sequence element")
        }
        iter_type := Type.Apply{name: "Iter", args: [Type]{element}}
        column := input_values[index]
        if !jet_codegen_builtin_iter_receiver(input_type) -> column = jet_codegen_builtin_list_lazy(&builder, expression.span, inputs[index], column, element)
        if mode == TZipMode.Pad {
            target := field_types[index]
            fill := MIRValueID?{None}
            if {
                fill_value != None -> {
                    lowered_fill := fill_value ?? panic("checked zip fill value disappeared")
                    actual := fill_type ?? panic("checked zip fill type disappeared")
                    if fill_mode == TZipFillMode.Columns {
                        fill_shape := if actual == { .Tuple(tuple_fields) -> tuple_fields else -> panic("checked zip column fills have no tuple") }
                        actual_field := Type?{None}
                        loop field in fill_shape {
                            if field.name == fields[index] -> actual_field = Val(field.ty)
                        }
                        actual = actual_field ?? panic("checked zip fill column is missing")
                        fill_field_id := jet_codegen_host_field_id(builder, fill_type ?? panic("checked zip fill type disappeared"), fields[index])
                        lowered_fill = jet_codegen_emit_value(&builder, expression.span, actual, MIROperation.Field{base: lowered_fill, field: fill_field_id})
                    }
                    if actual != target {
                        lowered_ty :: jet_codegen_lower_type_for_function(target, builder)
                        lowered_fill = jet_codegen_emit_value(&builder, expression.span, target, MIROperation.Convert{value: lowered_fill, parameters: [MIRValueID]{}, target: lowered_ty, conversion: MIRConversion.NumericCast})
                    }
                    fill = Val(lowered_fill)
                }
                else -> {
                    callback := jet_codegen_builtin_zip_fill_callback(&builder, expression.span, "{index}", element, target)
                    result_type := Type.Apply{name: "Iter", args: [Type]{target}}
                    map_route_row := jet_codegen_collection_closure_route(TClosureOp.Map, iter_type)
                    map_route := jet_codegen_builtin_route_row(map_route_row.module_name, map_route_row.member, map_route_row.symbol, map_route_row.arity, map_route_row.borrow_mask, map_route_row.effect_kind, map_route_row.abi)
                    column = jet_codegen_builtin_semantic_closure_call(&builder, expression.span, result_type, map_route, column, [MIRValueID]{callback}, [MIRAccess]{MIRAccess.Move}, false)
                    fill = Val(jet_codegen_emit_value(&builder, expression.span, target, MIROperation.Absent))
                }
            }
            &fills.push(fill ?? panic("checked zip fill value was not produced"))
        }
        &columns.push(column)
        index += 1
    }
    left := columns[0]
    left_type := field_types[0]
    left_fill := MIRValueID?{None}
    if fills.len() != 0 -> left_fill = Val(fills[0])
    index = 1
    loop index < input_count {
        row_fields := [TypeTupleField]{}
        row_names := [String]{}
        row_types := [Type]{}
        field_index := 0
        loop field_index <= index {
            &row_fields.push(TypeTupleField{name: fields[field_index], ty: field_types[field_index]})
            &row_names.push(fields[field_index])
            &row_types.push(field_types[field_index])
            field_index += 1
        }
        row_type := Type.Tuple{fields: row_fields}
        callback := jet_codegen_builtin_zip_callback(&builder, expression.span, "{index}", row_type, row_names, row_types, index, left_type)
        values := [MIRValueID]{columns[index]}
        accesses := [MIRAccess]{MIRAccess.Move}
        if left_fill != None {
            &values.push(left_fill ?? panic("checked zip prefix fill disappeared"))
            &accesses.push(MIRAccess.Read)
            &values.push(fills[index])
            &accesses.push(MIRAccess.Read)
        }
        &values.push(callback)
        &accesses.push(MIRAccess.Move)
        result_type := if index + 1 == input_count -> expression.ty else -> Type.Apply{name: "Iter", args: [Type]{row_type}}
        route := jet_codegen_builtin_zip_route(mode)
        left = jet_codegen_builtin_semantic_closure_call(&builder, expression.span, result_type, route, left, values, accesses, mode == TZipMode.Strict)
        if left_fill != None && index + 1 < input_count {
            tuple_mir_type := jet_codegen_lower_type_for_function(row_type, builder)
            tuple_owner :: tuple_mir_type.identity ?? panic("checked zip fill tuple has no type identity")
            tuple_fields := [MIRFieldValue]{}
            field_index = 0
            loop field_index <= index {
                &tuple_fields.push(MIRFieldValue{field: jet_codegen_host_field_id(builder, row_type, fields[field_index]), value: fills[field_index]})
                field_index += 1
            }
            left_fill = Val(jet_codegen_emit_value(&builder, expression.span, row_type, MIROperation.Tuple{type_id: tuple_owner, fields: tuple_fields}))
        }
        left_type = row_type
        index += 1
    }
    left
}


fn jet_codegen_lower_builtin_tuple_projection(builder: &JetCodegenBuilder, expression: TExpr, receiver: TExpr, operation: TBuiltinOp, args: [TExpr]) -> MIRValueID {
    indexed := if operation == { .Indexed(_) -> true else -> false }
    result_type := jet_codegen_builtin_untag(expression.ty)
    row_type := if {
        indexed -> {
            if result_type == {
                .Apply(name, elements) -> if jet_codegen_builtin_iter_receiver(expression.ty) && elements.len() == 1 -> elements[0] else -> panic("checked indexed result has no row type")
                .List(element) -> element
                else -> panic("checked indexed result has no row type")
            }
        } else -> expression.ty
    }
    fields := if jet_codegen_builtin_untag(row_type) == { .Tuple(fields) -> fields else -> panic("checked tuple builtin has no tuple fields") }
    expected_args := if indexed -> 0 else -> 1
    if fields.len() != 2 || args.len() != expected_args -> panic("checked tuple builtin has inconsistent operands")
    element := if jet_codegen_builtin_untag(receiver.ty) == {
        .List(inner) | .FixedList(inner, _) -> inner
        .Apply(_, elements) -> if jet_codegen_builtin_iter_receiver(receiver.ty) && elements.len() == 1 -> elements[0] else -> panic("checked tuple builtin receiver is not a sequence")
        else -> panic("checked tuple builtin receiver is not a sequence")
    }
    params := [Type]{}
    if {
        indexed -> {
            &params.push(Type.IntN{signed: true, bits: 64})
            &params.push(element)
        } else -> {
            loop field in fields -> &params.push(field.ty)
        }
    }
    lowered_receiver := jet_codegen_lower_builtin_receiver(&builder, receiver, false).value
    operands := [MIRValueID]{}
    loop argument in args -> &operands.push(jet_codegen_lower_expr(&builder, argument))
    if !indexed -> operands[0] = jet_codegen_builtin_native_int(&builder, operands[0], args[0].ty, args[0].span)
    if !jet_codegen_builtin_iter_receiver(receiver.ty) -> lowered_receiver = jet_codegen_builtin_list_lazy(&builder, expression.span, receiver, lowered_receiver, element)
    callback := jet_codegen_builtin_tuple_callback(&builder, expression.span, if indexed -> "indexed" else -> "split", row_type, fields, params, indexed)
    &operands.push(callback)
    call_type := if indexed -> Type.Apply{name: "Iter", args: [Type]{row_type}} else -> expression.ty
    carrier := jet_codegen_failure_carrier_for_type(expression.ty)
    route := jet_codegen_builtin_route_plan(operation, receiver.ty, call_type, carrier)
    result := jet_codegen_builtin_closure_call(&builder, expression.span, call_type, route, lowered_receiver, operands)
    if indexed {
        if result_type == {
            .List(_) -> {
                list_route := jet_codegen_builtin_route_plan(TBuiltinOp.IterToList, call_type, expression.ty, carrier)
                return jet_codegen_builtin_static_call(&builder, expression.span, expression.ty, list_route, carrier, [MIRValueID]{result}, [Span]{expression.span})
            }
            else -> {}
        }
    }
    result
}
