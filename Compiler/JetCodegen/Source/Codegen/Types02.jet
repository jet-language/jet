// Rust: crates/jet-codegen/src/Codegen/TIR/tir_to_mir_types.rs:1318
impl TirErasure {
    fn to_mir(self) -> MIRUnreachable {
        reason :: if self.reason == {
            .CompileTimeOnly -> MIRErasureReason.CompileTimeOnly
            .Disabled -> MIRErasureReason.Disabled
            .ExpandedBeforeLowering -> MIRErasureReason.ExpandedBeforeLowering
            .SemanticIndexOnly -> MIRErasureReason.SemanticIndexOnly
        }
        MIRUnreachable{construct: self.construct, span: self.span, reason: reason}
    }
}
