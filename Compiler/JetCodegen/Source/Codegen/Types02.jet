impl TirParam {
    fn to_mir(self) -> MIRParam {
        MIRParam{index: self.index, name: self.name, span: self.span, ty: lower_type(self.ty), access: lower_mir_access(self.access), ownership: ownership_from_tir(self.ownership), public_label: self.public_label, variadic: self.variadic, default_present: self.default_present}
    }
