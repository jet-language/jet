fn lower_cli_bindings(bindings: [CLICommandBinding], module: String) -> [TirCliBinding] {
    out := [TirCliBinding]{}
    loop binding in bindings {
        names := [String]{}
        loop marker in binding.markers -> &names.push(marker.name)
        &out.push(TirCliBinding{name: binding.name, span: binding.name_span, function_key: jet_codegen_qualified_type_key(module, function_name_from_expr(binding.target) ?? binding.name), markers: names})
    }
    out
}
