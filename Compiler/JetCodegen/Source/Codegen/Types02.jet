fn ownership_from_tir(ownership: TirOwnership) -> MIROwnership {
    if ownership == .Owned -> return MIROwnership.Owned
    MIROwnership{mode: ownership_mode(ownership), drop: if ownership == .Move -> MIRDropKind.Value else -> MIRDropKind.None, moved: false, last_use: false, gc_root: false}
}
