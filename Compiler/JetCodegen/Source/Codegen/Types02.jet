// Rust: crates/jet-codegen/src/Codegen/TIR/tir_to_mir_types.rs:430
// lower_nominal_ref is the canonical jet_foundation.mir_nominal_ref constructor.
// Rust: crates/jet-codegen/src/Codegen/TIR/tir_to_mir_types.rs:439
fn lower_type(ty: Type) -> MIRType {
    if ty == .Named(name) {
        if core_term_stream_carrier(name) == .Val(carrier) -> return lower_type(Type.Named{name: carrier})
    }
    lowered :: mir_type_with_identity(mir_type_from_kind(lower_type_kind(ty)), mir_type_id(type_identity_key(ty)))
    if CanonicalPass.enabled() {
        CanonicalPass.record("lowering", "mir.lower-type", "crates/jet-codegen/src/Codegen/TIR/tir_to_mir_types.rs", "tir", CanonicalPass.debug_payload("tir", "mir.lower-type", ty), CanonicalPass.debug_identity("tir", "mir.lower-type", ty), "mir", CanonicalPass.debug_payload("mir", "mir.lower-type", lowered), CanonicalPass.debug_identity("mir", "mir.lower-type", lowered), "preserve")
    }
    lowered
}
// Rust: crates/jet-codegen/src/Codegen/TIR/tir_to_mir_types.rs:469
fn lower_type_kind(ty: Type) -> MIRTypeKind {
    if ty == {
        .Int -> MIRTypeKind.Int
        .Float -> MIRTypeKind.Float
        .Bool -> MIRTypeKind.Bool
        .String -> MIRTypeKind.String
        .Char -> MIRTypeKind.Char
        .List(inner) -> MIRTypeKind.List{inner: lower_type(inner)}
        .Map(key, _, value) -> MIRTypeKind.Map{key: lower_type(key), value: lower_type(value)}
        .Shared(inner) -> MIRTypeKind.Shared{inner: lower_type(inner)}
        .Option(inner) -> MIRTypeKind.Option{inner: lower_type(inner)}
        .Result(ok, err) -> MIRTypeKind.Result{ok: lower_type(ok), err: lower_type(err)}
        .Fn(params, ret, effect_bound, param_contract, call_metadata, return_view_provenance) -> {
            lowered_params := [MIRType]{}
            loop param in params -> &lowered_params.push(lower_type(param))
            lowered_ret := MIRType?{None}
            if ret == .Val(value) -> lowered_ret = Val(lower_type(value))
            MIRTypeKind.Fn{signature: MIRFunctionSignature{params: lowered_params, ret: lowered_ret, effect_bound: jet_codegen_lower_effect_bound(effect_bound), param_contract: jet_codegen_lower_call_contract(param_contract), call_metadata: jet_codegen_lower_function_call_metadata(call_metadata), return_view_provenance: jet_codegen_lower_view_provenance_map(return_view_provenance)}}
        }
        .Named(name) -> {
            if numeric_type_from_name(name) == .Val(numeric) -> return lower_type_kind(numeric)
            MIRTypeKind.Apply{name: mir_nominal_ref(name), args: []}
        }
        .Apply(name, args) -> {
            lowered_args := [MIRType]{}
            loop arg in args -> &lowered_args.push(lower_type(arg))
            MIRTypeKind.Apply{name: mir_nominal_ref(name), args: lowered_args}
        }
        .TraitObject(bounds) -> {
            lowered_bounds := [MIRTraitRef]{}
            loop name in bounds -> &lowered_bounds.push(MIRTraitRef{id: mir_trait_id(name), name: name})
            MIRTypeKind.TraitObject{bounds: lowered_bounds}
        }
        .Tuple(fields) -> {
            lowered_fields := [MIRTupleField]{}
            loop field in fields -> &lowered_fields.push(MIRTupleField{name: field.name, ty: lower_type(field.ty)})
            MIRTypeKind.Tuple{fields: lowered_fields}
        }
        .FixedList(elem, len) -> MIRTypeKind.FixedList{elem: lower_type(elem), len: jet_codegen_lower_measure(len)}
        .IntN(signed, bits) -> MIRTypeKind.IntN{signed: signed, bits: bits}
        .InlineRange(base, lo, hi) -> MIRTypeKind.InlineRange{base: lower_type(base), lo: lo, hi: hi}
        .Float32 -> MIRTypeKind.Float32
        .Tagged(marker, inner) -> MIRTypeKind.Tagged{marker: jet_codegen_lower_tag_marker(marker), inner: lower_type(inner)}
        .Union(members) -> {
            lowered := [MIRType]{}
            loop member in members -> &lowered.push(lower_type(member))
            MIRTypeKind.Union{members: lowered}
        }
        .Quantity(base, dimension) -> MIRTypeKind.Quantity{base: lower_type(base), dimension: jet_codegen_lower_dimension(dimension)}
        .Measure(measure) -> MIRTypeKind.Measure{value: jet_codegen_lower_measure(measure)}
    }
}
