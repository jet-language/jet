//RS /// `core.term` declares `Stdout`, `Stderr`, and `StdinHandle` so Jet code can
//RS /// name them, but their values are the Prelude's native stream carriers
//RS /// (`core.term.stdout()` and friends), not records. MIR therefore types every
//RS /// spelling of these handles as the one native nominal, exactly like the bare
//RS /// host signature; a record row here would make the JIT drop a record the
//RS /// value never was.
//RS pub(crate) fn core_term_stream_carrier(name: &str) -> Option<&'static str> {
//RS     match name {
//RS         "<corelib>/Core/term::Core/term/term.jet::Stdout" => Some("Stdout"),
//RS         "<corelib>/Core/term::Core/term/term.jet::Stderr" => Some("Stderr"),
//RS         "<corelib>/Core/term::Core/term/term.jet::StdinHandle" => Some("StdinHandle"),
//RS         _ => None,
//RS     }
//RS }
//RS 
//RS fn discard_core_term_stream_carriers(declarations: &mut TirDeclarations) {
//RS     declarations
//RS         .type_defs
//RS         .retain(|row| core_term_stream_carrier(&row.key).is_none());
//RS }
