// Rust: crates/jet-codegen/src/Codegen/TIR/tir_to_mir_types.rs:49
fn canonicalize_checked_trait_types(ty: Type, trait_names: Set<String>, nominal_names: Set<String>, binders: Set<String>) -> Type {
    canonicalize_checked_trait_types_visit(ty, trait_names, nominal_names, binders)
}
// Rust: crates/jet-codegen/src/Codegen/TIR/tir_to_mir_types.rs:55
fn canonicalize_checked_trait_types_visit(ty: Type, trait_names: Set<String>, nominal_names: Set<String>, binders: Set<String>) -> Type {
    if ty == {
        .Named(name) -> {
            if trait_names.contains(name) && !nominal_names.contains(name) && !binders.contains(name) -> return Type.TraitObject{bounds: [name]}
            ty
        }
        .List(inner) -> Type.List{element: canonicalize_checked_trait_types_visit(inner, trait_names, nominal_names, binders)}
        .Map(key, key_span, value) -> Type.Map{key: canonicalize_checked_trait_types_visit(key, trait_names, nominal_names, binders), key_span: key_span, value: canonicalize_checked_trait_types_visit(value, trait_names, nominal_names, binders)}
        .Shared(inner) -> Type.Shared{inner: canonicalize_checked_trait_types_visit(inner, trait_names, nominal_names, binders)}
        .Option(inner) -> Type.Option{inner: canonicalize_checked_trait_types_visit(inner, trait_names, nominal_names, binders)}
        .Result(ok, err) -> Type.Result{ok: canonicalize_checked_trait_types_visit(ok, trait_names, nominal_names, binders), err: canonicalize_checked_trait_types_visit(err, trait_names, nominal_names, binders)}
        .Fn(params, ret, effect_bound, param_contract, call_metadata, return_view_provenance) -> {
            projected := [Type]{}
            loop param in params -> &projected.push(canonicalize_checked_trait_types_visit(param, trait_names, nominal_names, binders))
            projected_ret := Type?{None}
            if ret == .Val(value) -> projected_ret = Val(canonicalize_checked_trait_types_visit(value, trait_names, nominal_names, binders))
            Type.Fn{params: projected, ret: projected_ret, effect_bound: effect_bound, param_contract: param_contract, call_metadata: call_metadata, return_view_provenance: return_view_provenance}
        }
        .Apply(name, args) -> {
            projected := [Type]{}
            loop arg in args -> &projected.push(canonicalize_checked_trait_types_visit(arg, trait_names, nominal_names, binders))
            Type.Apply{name: name, args: projected}
        }
        .Tuple(fields) -> {
            projected := [TypeTupleField]{}
            loop field in fields -> &projected.push(TypeTupleField{name: field.name, ty: canonicalize_checked_trait_types_visit(field.ty, trait_names, nominal_names, binders)})
            Type.Tuple{fields: projected}
        }
        .FixedList(elem, len) -> Type.FixedList{elem: canonicalize_checked_trait_types_visit(elem, trait_names, nominal_names, binders), len: len}
        .InlineRange(base, lo, hi) -> Type.InlineRange{base: canonicalize_checked_trait_types_visit(base, trait_names, nominal_names, binders), lo: lo, hi: hi}
        .Tagged(marker, inner) -> Type.Tagged{marker: marker, inner: canonicalize_checked_trait_types_visit(inner, trait_names, nominal_names, binders)}
        .Union(members) -> {
            projected := [Type]{}
            loop member in members -> &projected.push(canonicalize_checked_trait_types_visit(member, trait_names, nominal_names, binders))
            Type.Union{members: projected}
        }
        .Quantity(base, dimension) -> Type.Quantity{base: canonicalize_checked_trait_types_visit(base, trait_names, nominal_names, binders), dimension: dimension}
        else -> ty
    }
}

