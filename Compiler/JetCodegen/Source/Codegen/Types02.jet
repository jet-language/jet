// Rust: crates/jet-codegen/src/Codegen/TIR/tir_to_mir_types.rs:1346
fn lower_tir_declarations(bundle: ProgramBundle, boxed_edges_by_module: [String:Set<(String, String)>], auto_printable_by_module: [String:Set<String>], auto_debug_by_module: [String:Set<String>]) -> TirDeclarations {
    out := TirDeclarations{}
    // GATE #4483: layout comes from selected build facts, not host pointer facts.
    target_layout :: TargetLayout.from_build_facts(bundle.build_facts)
    loop (index, module) in bundle.modules.iter().enumerate() {
        module_name :: module_identity(bundle, index)
        boxed_edges :: boxed_edges_by_module.get(module_name) ?? Set<(String, String)>{}
        auto_printable :: auto_printable_by_module.get(module_name) ?? Set<String>{}
        auto_debug :: auto_debug_by_module.get(module_name) ?? Set<String>{}
        seed_parse_error :: !module_owned_type_names(module.items).contains("ParseError")
        layout_engine :: TargetLayoutEngine.new(module.items, target_layout)
        collect_items(&out, module.items, module_name, layout_engine, boxed_edges, auto_printable, auto_debug, fn(ty, binders) { qualify_imported_type(bundle, index, module_name, binders, ty) }, fn(type_name) { module_identity(bundle, impl_owner_module(bundle, index, type_name)) }, seed_parse_error, None)
    }
    discard_duplicate_core_enum_fallbacks(&out)
    discard_core_term_stream_carriers(&out)
    ensure_builtin_debug_trait(&out)
    out
}
// Rust: crates/jet-codegen/src/Codegen/TIR/tir_to_mir_types.rs:1395
fn lower_declarations_from_items(items: [Item], module: String, target_layout: TargetLayout) -> TirDeclarations {
    lower_declarations_from_items_with_boxed_edges(items, module, target_layout, Set<(String, String)>{}, Set<String>{}, Set<String>{}, None)
}
// Rust: crates/jet-codegen/src/Codegen/TIR/tir_to_mir_types.rs:1411
fn lower_declarations_from_items_with_boxed_edges(items: [Item], module: String, target_layout: TargetLayout, boxed_edges: Set<(String, String)>, auto_printable: Set<String>, auto_debug: Set<String>, checked_nominals: MirFragmentNominalFacts?) -> TirDeclarations {
    out := TirDeclarations{}
    layout_engine :: TargetLayoutEngine.new(items, target_layout)
    owned :: module_owned_type_names(items)
    qualify_owned :: fn(ty: Type, binders: [String]) -> Type {
        ty.map_named_types(fn(name: String) -> String? {
            if owned.contains(name) && !binders.contains(name) -> Val(jet_codegen_qualified_type_key(module, name)) else -> None
        })
    }
    collect_items(&out, items, module, layout_engine, boxed_edges, auto_printable, auto_debug, qualify_owned, fn(_) { module }, !owned.contains("ParseError"), checked_nominals)
    discard_duplicate_core_enum_fallbacks(&out)
    discard_core_term_stream_carriers(&out)
    ensure_builtin_debug_trait(&out)
    out
}
// Rust: crates/jet-codegen/src/Codegen/TIR/tir_to_mir_types.rs:1454
fn discard_duplicate_core_enum_fallbacks(declarations: &TirDeclarations) {
    source_enum_counts := [String:Int]{}
    loop row in declarations.type_defs {
        if row.key.starts_with("<corelib>/") && row.key != row.name && row.kind == .Enum(_, _) -> source_enum_counts[row.name] = (source_enum_counts.get(row.name) ?? 0) + 1
    }
    &declarations.type_defs.retain(fn(row) { row.key != row.name || !(row.kind == .Enum(_, _)) || compiler_owned_enum_variants(row.name) != None || source_enum_counts.get(row.name) != Val(1) })
}
// Rust: crates/jet-codegen/src/Codegen/TIR/tir_to_mir_types.rs:1478
fn core_term_stream_carrier(name: String) -> String? {
    if name == {
        "<corelib>/Core/term::Core/term/term.jet::Stdout" -> Val("Stdout")
        "<corelib>/Core/term::Core/term/term.jet::Stderr" -> Val("Stderr")
        "<corelib>/Core/term::Core/term/term.jet::StdinHandle" -> Val("StdinHandle")
        else -> None
    }
}
// Rust: crates/jet-codegen/src/Codegen/TIR/tir_to_mir_types.rs:1487
fn discard_core_term_stream_carriers(declarations: &TirDeclarations) {
    &declarations.type_defs.retain(fn(row) { core_term_stream_carrier(row.key) == None })
}
// Rust: crates/jet-codegen/src/Codegen/TIR/tir_to_mir_types.rs:1493
fn collect_items(out: &TirDeclarations, items: [Item], module: String, layout_engine: TargetLayoutEngine, boxed_edges: Set<(String, String)>, auto_printable: Set<String>, auto_debug: Set<String>, qualify_type: fn(Type, [String]) -> Type, impl_owner: fn(String) -> String, seed_parse_error: Bool, checked_nominals: MirFragmentNominalFacts?) {
    trait_names := Set<String>{}
    loop item in items { if item == .Trait(candidate) -> _ :: &trait_names.insert(candidate.name) }
    nominal_names :: module_owned_type_names(items)
    canonical :: fn(ty: Type, binders: [String]) -> Type {
        binder_set := Set<String>{}
        loop binder in binders -> _ :: &binder_set.insert(binder)
        canonicalize_checked_trait_types(qualify_type(ty, binders), trait_names, nominal_names, binder_set)
    }
    loop item in items {
        if item == {
            .Struct(definition) -> {
                &out.type_defs.push(lower_struct(definition, module, canonical, layout_engine, boxed_edges, is_auto_printable(auto_printable, module, definition.name), is_auto_debug(auto_debug, module, definition.name)))
                push_nested_trait_impls(out, definition.name, definition.trait_impls, module)
            }
            .Enum(definition) -> {
                enum_layout := LayoutFacts?{None}
                if definition.c_layout_tag() != None -> enum_layout = Val(layout_engine.enum_facts(definition))
                &out.type_defs.push(lower_enum(definition, module, canonical, enum_layout, boxed_edges, is_auto_printable(auto_printable, module, definition.name), is_auto_debug(auto_debug, module, definition.name)))
                push_nested_trait_impls(out, definition.name, definition.trait_impls, module)
            }
            .Distinct(definition) -> &out.type_defs.push(lower_distinct(definition, module, qualify_type, is_auto_printable(auto_printable, module, definition.name)))
            .TypeAlias(definition) -> &out.type_defs.push(lower_alias(definition, module, qualify_type, is_auto_printable(auto_printable, module, definition.name)))
            .UnitFamily(definition) -> {
                &out.type_defs.push(lower_unit_family(definition, module, is_auto_printable(auto_printable, module, definition.family)))
                loop member in definition.distinct_defs() -> &out.type_defs.push(lower_distinct(member, module, qualify_type, is_auto_printable(auto_printable, module, member.name)))
            }
            .Trait(definition) -> &out.traits.push(lower_trait(definition, module, canonical))
            .Impl(definition) -> &out.impls.push(lower_impl(definition, module, impl_owner(definition.type_name)))
            .Const(definition) -> &out.constants.push(lower_constant(definition, module))
            else -> {}
        }
    }
    known := Set<String>{}
    loop row in out.type_defs -> _ :: &known.insert(row.key)
    loop row in compiler_owned_type_defs(module, seed_parse_error, checked_nominals) {
        if &known.insert(row.key) -> &out.type_defs.push(row)
    }
}
// Rust: crates/jet-codegen/src/Codegen/TIR/tir_to_mir_types.rs:1599
fn ensure_builtin_debug_trait(out: &TirDeclarations) {
    module := String?{None}
    loop definition in out.type_defs {
        if definition.derives.contains("Debug") { module = Val(definition.module); break }
    }
    owner :: module ?? return
    loop definition in out.traits { if definition.name == "Debug" -> return }
    &out.traits.push(TirTraitDef{module: owner, key: "Debug", name: "Debug", span: Span.new(0, 0), visibility: TirVisibility.Public, associated_types: [], methods: []})
}
// Rust: crates/jet-codegen/src/Codegen/TIR/tir_to_mir_types.rs:1634
fn method_keys(module: String, type_name: String, trait_name: String?, operator_rhs: Type?, methods: [Func]) -> [String] {
    keys := [String]{}
    loop method in methods {
        name :: if trait_name == {
            Val(trait_name) -> {
                if ["Add", "Sub", "Mul", "Div", "Equatable", "Comparable"].contains(trait_name) -> operator_method_identity(type_name, trait_name, method.name, operator_rhs ?? Type.Named{name: type_name}) else -> "{type_name}::{trait_name}::{method.name}"
            }
            None -> "{type_name}::{method.name}"
        }
        &keys.push(jet_codegen_qualified_type_key(module, name))
    }
    keys
}
// Rust: crates/jet-codegen/src/Codegen/TIR/tir_to_mir_types.rs:1673
fn lower_struct(definition: StructDef, module: String, qualify_type: fn(Type, [String]) -> Type, layout_engine: TargetLayoutEngine, boxed_edges: Set<(String, String)>, auto_printable: Bool, auto_debug: Bool) -> TirTypeDef {
    layout_alignment := LayoutAlignmentFact?{None}
    if layout_engine.checked_struct_facts(definition).ok() == .Val(facts) -> layout_alignment = facts.alignment
    shape_fact :: shape_fact_from_struct(module, definition).ok()
    binders := [String]{}
    loop param in definition.type_params -> &binders.push(param.name)
    // Index once; preserves the first matching ShapeFact field without quadratic scans.
    shape_names_by_field := [String:ShapeFieldNames]{}
    if shape_fact == .Val(fact) {
        loop field in fact.fields {
            if !shape_names_by_field.contains_key(field.name) -> shape_names_by_field[field.name] = field.names
        }
    }
    params := [String:[String]]{}
    params[definition.name] = binders
    owner := Type.Named{name: definition.name}
    if !definition.type_params.is_empty() {
        args := [Type]{}
        loop param in definition.type_params -> &args.push(Type.Named{name: param.name})
        owner = Type.Apply{name: definition.name, args: args}
    }
    fields := [TirField]{}
    loop field in definition.fields {
        names :: shape_names_by_field.get(field.name) ?? ShapeFieldNames.from_source(field.name)
        projected := field
        projected.ty = substitute_reflect_field_type(params, owner, field.ty)
        &fields.push(lower_field(projected, names, qualify_type, binders))
    }
    TirTypeDef{module: module, key: jet_codegen_qualified_type_key(module, definition.name), name: definition.name, span: definition.span, public: definition.is_pub, package_public: definition.is_package_pub, generic_params: lower_generic_params(definition.type_params), derives: lower_derive_names(definition.derives, auto_debug, has_generated_equatable_block(definition.trait_impls)), auto_derive_default: definition.auto_derive_default, auto_printable: auto_printable, published_schema: definition.is_published_schema, single_use: definition.is_single_use, must_use: definition.is_must_use, layout: definition.layout, layout_alignment: layout_alignment, serde: lower_serde_markers(definition.serde_markers), c_layout_tag: None, enum_layout: None, cli_bindings: lower_cli_bindings(definition.cli_bindings, module), cli: None, ownership: ownership_for_definition(definition.is_single_use), boxed_edges: owner_boxed_edges(definition.name, boxed_edges), compiler_builtin: None, kind: TirTypeDefKind.Struct{fields: fields, methods: method_keys(module, definition.name, None, None, definition.methods)}}
}
// Rust: crates/jet-codegen/src/Codegen/TIR/tir_to_mir_types.rs:1767
fn lower_enum(definition: EnumDef, module: String, qualify_type: fn(Type, [String]) -> Type, enum_layout: LayoutFacts?, boxed_edges: Set<(String, String)>, auto_printable: Bool, auto_debug: Bool) -> TirTypeDef {
