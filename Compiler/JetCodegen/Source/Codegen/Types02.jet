fn lower_derive_names(derives: [(String, Span)], auto_debug: Bool, generated_equatable: Bool) -> [String] {
    names := [String]{}
    loop (name, _) in derives { if name != "CLI" -> &names.push(name) }
    if auto_debug && !names.contains("Debug") -> &names.push("Debug")
    if generated_equatable && !names.contains("Equatable") -> &names.push("Equatable")
    names
}
