    out := [TirSerdeAttribute]{}
    loop marker in markers {
        kind :: if marker.name == {
            "RenameAll" -> TirSerdeAttributeKind.RenameAll
            "Discriminant" -> TirSerdeAttributeKind.Tag
            "Tag" -> TirSerdeAttributeKind.Tag
            "Untagged" -> TirSerdeAttributeKind.Untagged
            "DenyUnknownFields" -> TirSerdeAttributeKind.DenyUnknownFields
            else -> next
        }
        &out.push(TirSerdeAttribute{kind: kind, value: marker_arg_text(marker), span: marker.span})
    }
    out
}
