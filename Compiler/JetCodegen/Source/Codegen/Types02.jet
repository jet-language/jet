fn lower_variant_field(field: VariantField, qualify_type: fn(Type, [String]) -> Type, binders: [String]) -> TirField {
    TirField{name: field.name, shape_names: ShapeFieldNames.from_source(field.name), skip: false, ty: qualify_type(field.ty, binders), span: field.name_span, public: true, package_public: false, computed: false, has_default: false, redact: false}
}
// Rust: crates/jet-codegen/src/Codegen/TIR/tir_to_mir_types.rs:930
fn lower_variant(variant: Variant, style: String?, qualify_type: fn(Type, [String]) -> Type, binders: [String]) -> TirVariant {
    payload :: if variant.payload == {
        .Unit -> TirVariantPayload.Unit
        .Single(ty, _) -> TirVariantPayload.Single{ty: qualify_type(ty, binders)}
        .Named(fields) -> {
            rows := [TirField]{}
            loop field in fields -> &rows.push(lower_variant_field(field, qualify_type, binders))
            TirVariantPayload.Named{fields: rows}
        }
    }
    TirVariant{name: variant.name, wire_name: variant_wire_key(style, variant), span: variant.name_span, payload: payload, discriminant: variant.discriminant}
}
// Rust: crates/jet-codegen/src/Codegen/TIR/tir_to_mir_types.rs:955
fn owner_boxed_edges(owner: String, boxed_edges: Set<(String, String)>) -> [String] {
    // GATE #4499: native equality/hash for tuple keys, never string-encoded keys.
    keys := [String]{}
    loop (candidate, key) in boxed_edges { if candidate == owner -> &keys.push(key) }
    &keys.sort()
    keys
}
// Rust: crates/jet-codegen/src/Codegen/TIR/tir_to_mir_types.rs:965
fn type_names_owner(ty: Type, owner_key: String, owner_name: String) -> Bool {
    if ty == {
        .Named(name) -> name == owner_key || name == owner_name
        .Apply(name, args) -> args.is_empty() && (name == owner_key || name == owner_name)
        else -> false
    }
}
// Rust: crates/jet-codegen/src/Codegen/TIR/tir_to_mir_types.rs:973
fn lower_type_for_owner(ty: Type, owner_key: String, owner_name: String) -> MIRType {
    lowered :: lower_type(ty)
    if type_names_owner(ty, owner_key, owner_name) -> mir_type_with_identity(lowered, mir_type_id(owner_key)) else -> lowered
}
// Rust: crates/jet-codegen/src/Codegen/TIR/tir_to_mir_types.rs:982
fn lower_mir_field(owner: String, field: TirField) -> MIRField {
    lower_mir_field_for_owner(owner, field, None, None)
}
// Rust: crates/jet-codegen/src/Codegen/TIR/tir_to_mir_types.rs:986
fn lower_mir_field_for_owner(owner: String, field: TirField, identity_key: String?, identity_name: String?) -> MIRField {
    ty :: if identity_key != None && identity_name != None -> lower_type_for_owner(field.ty, identity_key ?? "", identity_name ?? "") else -> lower_type(field.ty.with_effective_fn_returns())
    MIRField{id: mir_field_id("{owner}::{field.name}"), name: field.name, shape_names: field.shape_names, skip: field.skip, ty: ty, span: field.span, public: field.public, package_public: field.package_public, computed: field.computed, has_default: field.has_default, redact: field.redact}
}
// Rust: crates/jet-codegen/src/Codegen/TIR/tir_to_mir_types.rs:1014
fn resolve_function_id(registry: FunctionRegistry, key: String, module: String, span: Span) -> MIRFunctionID LowerError! {
    registry.resolve(key, module, span)
}
// Rust: crates/jet-codegen/src/Codegen/TIR/tir_to_mir_types.rs:1023
fn lower_type_cli_entry(entry: TirCliEntry, registry: FunctionRegistry) -> MIRCLIEntry LowerError! {
    commands := [MIRCLICommand]{}
    loop command in entry.commands {
        function :: command.function ?? next
        receiver := MIRTypeID?{None}
        if command.receiver == .Val(value) -> receiver = Val(mir_type_id(value))
        inputs := []
        loop (ordinal, input) in command.inputs.iter().enumerate() -> &inputs.push(lower_cli_input(input, ordinal, None))
        &commands.push(MIRCLICommand{name: command.name, description: command.description, function: resolve_function_id(registry, function.key, function.module, function.span)!, receiver: receiver, inputs: inputs})
    }
    inputs := []
    loop (ordinal, input) in entry.inputs.iter().enumerate() -> &inputs.push(lower_cli_input(input, ordinal, None))
    MIRCLIEntry{record_inputs: entry.record_inputs, description: entry.description, inputs: inputs, commands: commands, standard: entry.standard, version: entry.version}
}
// Rust: crates/jet-codegen/src/Codegen/TIR/tir_to_mir_types.rs:1080
fn lower_core_builtin_owners() -> [MIRCoreOwner] {
    out := [MIRCoreOwner]{}
    loop name in ["Task", "Receiver", "Sender"] -> &out.push(MIRCoreOwner{id: mir_type_id(name), nominal_id: mir_nominal_ref(name).id, module_id: None, key: name, name: name, ownership: MIROwnershipMode.Owned})
    out
}
// Rust: crates/jet-codegen/src/Codegen/TIR/tir_to_mir_types.rs:1098
fn lower_type_defs(definitions: [TirTypeDef], registry: FunctionRegistry) -> [MIRTypeDef] LowerError! {
    seen := Set<String>{}
    rows := [MIRTypeDef]{}
    loop definition in definitions {
        if !&seen.insert(definition.key) -> fail LowerError.new(definition.span, "duplicate checked type definition `{definition.key}`")
        &rows.push(definition.to_mir(registry)!)
    }
    rows
}
// Rust: crates/jet-codegen/src/Codegen/TIR/tir_to_mir_types.rs:1116
fn resolve_type_methods(definition: TirTypeDef, methods: [String], registry: FunctionRegistry) -> [MIRFunctionID] LowerError! {
    out := [MIRFunctionID]{}
    loop key in methods {
        id :: resolve_function_id(registry, key, definition.module, definition.span) catch error {
            if (definition.key.starts_with("<corelib>/") || !definition.generic_params.is_empty()) && error.message.starts_with("missing checked function target") -> next
            fail error
        }
        &out.push(id)
    }
    out
}
// Rust: crates/jet-codegen/src/Codegen/TIR/tir_to_mir_types.rs:1146
impl TirTypeDef {
    fn to_mir(self, registry: FunctionRegistry) -> MIRTypeDef LowerError! {
        kind :: if self.kind == {
            .Struct(fields, methods) -> {
                rows := [MIRField]{}
                loop field in fields -> &rows.push(lower_mir_field(self.key, field))
                MIRTypeDefKind.Struct{fields: rows, methods: resolve_type_methods(self, methods, registry)!}
            }
            .Enum(variants, methods) -> {
                rows := [MIRVariant]{}
                next_discriminant := I64?{Val(0)}
                loop variant in variants {
                    discriminant :: if self.c_layout_tag != None -> variant.discriminant.or(next_discriminant) else -> variant.discriminant
                    next_discriminant = None
                    if discriminant == .Val(value) -> next_discriminant = value.checked_add(1)
                    payload :: if variant.payload == {
                        .Unit -> MIRVariantPayload.Unit
                        .Single(ty) -> MIRVariantPayload.Single{value: lower_type_for_owner(ty, self.key, self.name)}
                        .Named(fields) -> {
                            projected := [MIRField]{}
                            loop field in fields -> &projected.push(lower_mir_field_for_owner("{self.key}::{variant.name}", field, Val(self.key), Val(self.name)))
                            MIRVariantPayload.Named{fields: projected}
                        }
                    }
                    &rows.push(MIRVariant{name: variant.name, wire_name: variant.wire_name, span: variant.span, payload: payload, discriminant: discriminant})
                }
                MIRTypeDefKind.Enum{variants: rows, methods: resolve_type_methods(self, methods, registry)!}
            }
            .Distinct(base, range) -> MIRTypeDefKind.Distinct{base: lower_type(base), range: range}
            .Alias(target) -> MIRTypeDefKind.Alias{target: lower_type(target)}
            .UnitFamily(members) -> MIRTypeDefKind.UnitFamily{members: members}
        }
        generic_params := [MIRGenericParam]{}
        loop parameter in self.generic_params {
            bounds := [MIRTraitRef]{}
            loop bound in parameter.bounds -> &bounds.push(MIRTraitRef{id: mir_trait_id(bound), name: bound})
            &generic_params.push(MIRGenericParam{name: parameter.name, bounds: bounds})
        }
        derives := [MIRTraitID]{}
        loop name in self.derives -> &derives.push(mir_trait_id(name))
        layout := MIRStructLayout?{None}
        if self.layout == .Val(value) {
            layout = Val(if value == {
                .C -> MIRStructLayout.C
                .CAligned(alignment, target) -> MIRStructLayout.CAligned{alignment: alignment, target: target}
                .Columnar -> MIRStructLayout.Columnar
            })
        }
        tag := MIRCEnumTag?{None}
        if self.c_layout_tag == .Val(value) -> tag = Val(lower_c_enum_tag(value))
        serde := [MIRSerdeAttribute]{}
        loop attribute in self.serde {
            attribute_kind :: if attribute.kind == {
                .RenameAll -> MIRSerdeAttributeKind.RenameAll
                .Tag -> MIRSerdeAttributeKind.Tag
                .Untagged -> MIRSerdeAttributeKind.Untagged
                .DenyUnknownFields -> MIRSerdeAttributeKind.DenyUnknownFields
            }
            &serde.push(MIRSerdeAttribute{kind: attribute_kind, value: attribute.value, span: attribute.span})
        }
        cli_bindings := [MIRCLIBinding]{}
        loop binding in self.cli_bindings -> &cli_bindings.push(MIRCLIBinding{name: binding.name, function: resolve_function_id(registry, binding.function_key, self.module, binding.span)!, span: binding.span, markers: binding.markers})
        cli := MIRCLIEntry?{None}
        if self.cli == .Val(entry) -> cli = Val(lower_type_cli_entry(entry, registry)!)
        MIRTypeDef{id: mir_type_id(self.key), module_id: mir_module_id(self.module), key: self.key, name: self.name, span: self.span, public: self.public, package_public: self.package_public, generic_params: generic_params, derives: derives, auto_derive_default: self.auto_derive_default, auto_printable: self.auto_printable, published_schema: self.published_schema, single_use: self.single_use, must_use: self.must_use, compiler_builtin: self.compiler_builtin, layout: layout, c_layout_tag: tag, enum_layout: self.enum_layout, layout_alignment: self.layout_alignment, serde: serde, cli_bindings: cli_bindings, cli: cli, ownership: ownership_mode(self.ownership), boxed_edges: self.boxed_edges, kind: kind}
    }
}
