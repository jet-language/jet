    // Rust: crates/jet-codegen/src/Codegen/MIRRust.rs:16063
    fn vector_place_load(self, function: MirFunction, place_id: MirPlaceId, fact: MirVectorFact,
        index_name: String, loop_places: [MirPlaceId: Bool], width: USize) -> String? {
        place :: function.places.find((place) -> place.id == place_id) ?? return None
        if place.projections.is_empty() {
            index :: self.vector_index_expr(function, fact, index_name, "lane as _")
            if loop_places.contains_key(place_id) { return "core::array::from_fn(|lane| {index})" }
            return "[{self.place_read(function, place_id)}; {width}]"
        }
        index_pos :: place.projections.position((projection) -> if projection == {
            MirProjection.Index(index: index, kind: kind) -> fact.cursor.is_some_and((cursor) -> self.canonical_cursor_value_matches(function, index, cursor)) && kind == MirIndexKind.FixedListProof
            else -> false
        }) ?? return None
        if place.projections[..index_pos].any((projection) -> if projection == { MirProjection.Index -> true; else -> false }) { return None }
        base :: self.place_base(function, place.base, false, place.projections[..index_pos])
        field := ""
        for projection in place.projections[index_pos + 1..] {
            if projection == { MirProjection.Field(field: id) -> { field.push('.'); field.push_str(self.field_name(id)) }; else -> { return None } }
        }
        index :: self.vector_index_usize_expr(function, fact, index_name, "lane as _")
        "core::array::from_fn(|lane| (({base})[{index}]{field}).clone())"
    }
    // Rust: crates/jet-codegen/src/Codegen/MIRRust.rs:16120
    fn vector_index_load(self, function: MirFunction, base: MirValueId, fact: MirVectorFact, index_name: String, _width: USize) -> String? {
        index :: self.vector_index_usize_expr(function, fact, index_name, "lane as _")
        "core::array::from_fn(|lane| ({self.value_borrow(base)}[{index}].clone()))"
    }
    // Rust: crates/jet-codegen/src/Codegen/MIRRust.rs:16135
    fn vector_field_load(self, function: MirFunction, base: MirValueId, field: MirFieldId, fact: MirVectorFact,
        index_name: String, defined: [MirValueId: Bool], loop_places: [MirPlaceId: Bool], width: USize) -> String? {
        base_instruction :: self.value_instruction(function, base) ?? return None
        if base_instruction.operation == {
            MirOperation.Index(base: collection, index: index, kind: MirIndexKind.FixedListProof) -> {
