                        return "core::array::from_fn(|lane| __jet_vec_column_{slot}[{index}].clone())"
                    }
                    return "core::array::from_fn(|lane| ({self.value_borrow(collection)}) .column({column})[{index}].clone().jet_col_{self.field_name(field)}())"
                }
                index :: self.vector_index_usize_expr(function, fact, index_name, "lane as _")
                return "core::array::from_fn(|lane| ({self.value_borrow(collection)}[{index}].{self.field_name(field)}).clone())"
            }
            else -> {}
        }
        base :: self.vector_value_expr(function, base, fact, index_name, defined, loop_places, width) ?? return None
        "core::array::from_fn(|lane| ({base}[lane].{self.field_name(field)}).clone())"
