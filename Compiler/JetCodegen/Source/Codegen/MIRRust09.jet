    // Rust: crates/jet-codegen/src/Codegen/MIRRust.rs:15501
    fn vector_chunk_source<N: USize>(self, function: MirFunction, fact: MirVectorFact, _cursor: MirValueId,
        loop_places: [MirPlaceId: Bool], rmw: (MirPlaceId, MirValueId, MirValueId)?, condition: MirValueId?,
        early: (MirValueId, MirValueId, Bool)?, index_name: String, start_name: String, indent: USize) -> String? {
        defined := [MirValueId: Bool]{}
        source := ""
        pad :: " ".repeat(indent)
        for block_id in fact.body_blocks {
            block :: self.block_row(function, block_id) ?? return None
            for instruction in block.instructions {
                if fact.fixed_reduction.is_some_and((fixed) -> !fixed.source_operations.contains(instruction.id)) { continue }
                if instruction.operation == {
                    MirOperation.WritePlace(place: place, value: value) -> {
                        if loop_places.contains_key(place) || rmw.is_some_and((rmw) -> rmw.0 == place) { continue }
                        expression :: self.vector_value_expr(function, value, fact, index_name, defined, loop_places, N) ?? return None
                        store :: self.vector_store(function, place, fact, expression, index_name, N) ?? return None
                        source.push_str(store)
                    }
                    MirOperation.ScopeEnter | MirOperation.ScopeExit -> {}
                    operation -> {
                        result :: if result := instruction.result { result } else {
                            loop_value :: if operation == { MirOperation.LoopRangeValue | MirOperation.LoopIterValue -> true; else -> false }
                            if !loop_value { continue }
                            return None
                        }
                        expression :: self.vector_value_expr(function, result, fact, index_name, defined, loop_places, N) ?? return None
                        ty :: self.rust_type(self.value_type(function, result))
                        source.push_str("{pad}let __jet_vec_v{result.0}: [{ty}; {N}] = {expression};\n")
                        defined[result] = true
                    }
                }
            }
            if block.terminator == {
                MirTerminator.Jump -> {}
                MirTerminator.Branch(condition: branch_condition) -> {
                    if fact.rule == MirVectorRule.ConditionalAccumulate && Some(branch_condition) == condition {}
                    else if fact.rule == MirVectorRule.EarlyExitSearch && early.is_some_and((early) -> early.0 == branch_condition) {}
                    else if fact.rule != MirVectorRule.ConditionalAccumulate && fact.rule != MirVectorRule.EarlyExitSearch { return None }
                }
                else -> { if fact.rule != MirVectorRule.ConditionalAccumulate && fact.rule != MirVectorRule.EarlyExitSearch { return None } }
            }
        }
        required := [MirValueId: Bool]{}
        if condition := condition { required[condition] = true }
        if early := early { required[early.0] = true; required[early.1] = true }
        required_keys := required.keys().collect()
        required_keys.sort()
        for value in required_keys {
            if defined.contains_key(value) { continue }
            expression :: self.vector_value_expr(function, value, fact, index_name, defined, loop_places, N) ?? return None
            ty :: self.rust_type(self.value_type(function, value))
            source.push_str("{pad}let __jet_vec_v{value.0}: [{ty}; {N}] = {expression};\n")
            defined[value] = true
        }
        if condition := condition {
            mask :: self.vector_array_name(condition)
            rmw :: rmw ?? return None
            addend :: self.vector_array_name(rmw.1)
            lane :: self.fixed_reduction_lane_expr(function, fact, index_name, start_name)
            source.push_str("{pad}jet_simd_accumulate_masked_fixed(&mut __jet_vec_acc, &{addend}, &{mask}, {lane});\n")
            source.push_str("{pad}if {mask}.iter().any(|selected| *selected) {{ __jet_vec_seen = true; }}\n")
        } else if rmw := rmw {
            addend :: self.vector_array_name(rmw.1)
            lane :: self.fixed_reduction_lane_expr(function, fact, index_name, start_name)
            source.push_str("{pad}jet_simd_accumulate_fixed(&mut __jet_vec_acc, &{addend}, {lane});\n")
            source.push_str("{pad}__jet_vec_seen = true;\n")
        }
        if early := early {
            (condition, return_value, early_on_then) :: early
            condition :: self.vector_array_name(condition)
            mask :: if early_on_then { condition } else { "core::array::from_fn(|lane| !{condition}[lane])" }
            value :: self.vector_array_name(return_value)
            source.push_str("{pad}if let Some(__jet_vec_lane) = {mask}.iter().position(|value| *value) {{\n")
            source.push_str("{pad}    return {value}[__jet_vec_lane];\n{pad}}}\n")
        }
        source
    }
    // Rust: crates/jet-codegen/src/Codegen/MIRRust.rs:15673
    fn vector_column_slots(self, fact: MirVectorFact) -> [(MirValueId, MirFieldId, USize, USize)] {
        slots := [(MirValueId, MirFieldId): (USize, USize)]{}
        for access in fact.accesses {
            if (access.root, access.field, access.column_index) == {
                (MirVectorAccessRoot.Value(collection), Some(field), Some(column)) -> {
                    if access.layout != MirVectorLayout.ColumnarDirect { continue }
                    slot :: slots.len()
                    slots.entry((collection, field)).or_insert((column, slot))
                }
                else -> {}
            }
        }
        keys := slots.keys().collect()
        keys.sort()
        keys.map((key) -> (key.0, key.1, slots[key].0, slots[key].1))
    }
    // Rust: crates/jet-codegen/src/Codegen/MIRRust.rs:15696
    fn vector_column_slot(self, fact: MirVectorFact, collection: MirValueId, field: MirFieldId) -> USize? {
        self.vector_column_slots(fact).find_map((entry) -> if entry.0 == collection && entry.1 == field { entry.3 } else { None })
    }
    // Rust: crates/jet-codegen/src/Codegen/MIRRust.rs:15709
    fn vector_default_int_type(ty: MirType) -> Bool {
        if ty.kind() == {
            MirTypeKind.InlineRange(base: base) | MirTypeKind.Tagged(inner: base) | MirTypeKind.Quantity(base: base) -> RustEmitter.vector_default_int_type(base)
            // Exact Int is an owned node, not a machine-vector lane.
            else -> false
        }
    }
    // Rust: crates/jet-codegen/src/Codegen/MIRRust.rs:15719
    fn vector_default_int_range(self, function: MirFunction, fact: MirVectorFact) -> Bool {
        cursor :: fact.cursor ?? return false
        for block in function.blocks {
            for instruction in block.instructions {
                if instruction.operation == {
                    MirOperation.LoopRangeInit(start: start) -> {
                        if instruction.result == Some(cursor) { return RustEmitter.vector_default_int_type(self.value_type(function, start)) }
                    }
                    else -> {}
                }
            }
        }
        false
    }
    // Rust: crates/jet-codegen/src/Codegen/MIRRust.rs:15737
    fn vector_index_expr(self, function: MirFunction, fact: MirVectorFact, index_name: String, lane_name: String) -> String {
        if self.vector_default_int_range(function, fact) { "{self.config.root_prefix}jet_std::jet_int_add(({index_name}), ({lane_name}))" }
        else { "({index_name}) + ({lane_name})" }
    }
    // Rust: crates/jet-codegen/src/Codegen/MIRRust.rs:15754
    fn vector_index_usize_expr(self, function: MirFunction, fact: MirVectorFact, index_name: String, lane_name: String) -> String {
        index :: self.vector_index_expr(function, fact, index_name, lane_name)
        if self.vector_default_int_range(function, fact) { "{self.config.root_prefix}jet_std::jet_int_to_i64({index}).expect(\"vector index exceeds host range\") as usize" }
        else { "({index}) as usize" }
    }
    // Rust: crates/jet-codegen/src/Codegen/MIRRust.rs:15772
    fn fixed_reduction_lane_expr(self, function: MirFunction, fact: MirVectorFact, index_name: String, start_name: String) -> String {
        order :: D_FRED1_FIXED_ORDER
        if !order.is_canonical() { panic("MIR reduction vector emission requires canonical D-FRED1 order") }
        if self.vector_default_int_range(function, fact) {
            return "jet_simd_fixed_lane_from_int::<{order.lanes}>({index_name}, {start_name}, {self.config.root_prefix}jet_std::jet_int_sub, {self.config.root_prefix}jet_std::jet_int_to_i64)"
        }
        "(({index_name}).wrapping_sub({start_name}) as usize) % {order.lanes}"
    }
