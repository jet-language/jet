                MirBinaryOp.Ne -> "Ne"
                MirBinaryOp.Lt -> "Lt"
                MirBinaryOp.Gt -> "Gt"
                MirBinaryOp.Le -> "Le"
                MirBinaryOp.Ge -> "Ge"
