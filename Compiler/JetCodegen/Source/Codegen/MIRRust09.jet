    // Rust: crates/jet-codegen/src/Codegen/MIRRust.rs:14740
    fn acceleration_output_writes(self, function: MirFunction, vector: MirVectorFact, cursor: MirValueId) -> ([(MirPlaceId, MirValueId)], [MirPlaceId: Bool])? {
        outputs := [(MirPlaceId, MirValueId)][]
        loop_places := [MirPlaceId: Bool]{}
        for block_id in vector.body_blocks {
            block :: self.block_row(function, block_id) ?? return None
            jump :: if block.terminator == { MirTerminator.Jump -> true; else -> false }
            if !jump { return None }
            for instruction in block.instructions {
                if instruction.operation == {
                    MirOperation.WritePlace(place: place, value: value) -> {
                        row :: function.places.find((candidate) -> candidate.id == place) ?? return None
                        cursor_index :: row.projections.enumerate().find_map((entry) -> {
                            (index, projection) :: entry
                            if projection == {
                                MirProjection.Index(index: candidate, kind: MirIndexKind.FixedListProof) -> {
                                    if self.canonical_cursor_value_matches(function, candidate, cursor) { Some(index) } else { None }
                                }
                                else -> None
                            }
                        })
                        if index := cursor_index {
                            if row.projections[..index].any((projection) -> if projection == { MirProjection.Index -> true; else -> false }) ||
                                row.projections[index + 1..].any((projection) -> if projection == { MirProjection.Field -> false; else -> true }) { return None }
                            outputs.push((place, value))
                        } else if row.projections.is_empty() && self.acceleration_is_cursor_value(function, value, cursor) {
                            loop_places[place] = true
                        } else { return None }
                    }
                    else -> {}
                }
            }
        }
        if !outputs.is_empty() { (outputs, loop_places) } else { None }
    }
    // Rust: crates/jet-codegen/src/Codegen/MIRRust.rs:14792
    fn acceleration_is_cursor_value(self, function: MirFunction, value: MirValueId, cursor: MirValueId) -> Bool {
        self.canonical_cursor_value_matches(function, value, cursor)
    }
    // Rust: crates/jet-codegen/src/Codegen/MIRRust.rs:14800
    fn acceleration_column_slots(self, vector: MirVectorFact) -> [(MirValueId, MirFieldId): USize]? {
        slots := [(MirValueId, MirFieldId): USize]{}
        for access in vector.accesses {
            if (access.root, access.field, access.column_index) == {
                (MirVectorAccessRoot.Value(collection), Some(field), Some(_)) -> {
                    if access.layout != MirVectorLayout.ColumnarDirect { continue }
                    if !slots.contains_key((collection, field)) { slots[(collection, field)] = slots.len() }
                }
                else -> {}
            }
        }
        slots
    }
    // Rust: crates/jet-codegen/src/Codegen/MIRRust.rs:14822
    fn acceleration_callback_body(self, function: MirFunction, vector: MirVectorFact, cursor: MirValueId,
        outputs: [(MirPlaceId, MirValueId)], loop_places: [MirPlaceId: Bool], index_expr: String,
        column_context: (String, String, [(MirValueId, MirFieldId): USize])?, indent: USize) -> (String, String)? {
        defined := [MirValueId: String]{}
        source := ""
        values := [String][]
        for (_, value) in outputs {
            expression :: self.acceleration_value_expr(function, value, vector, cursor, loop_places,
                index_expr, column_context, &defined, &source, indent) ?? return None
            values.push(expression)
        }
        (source, "({values.join(", ")},)")
    }
    // Rust: crates/jet-codegen/src/Codegen/MIRRust.rs:14854
    fn acceleration_value_expr(self, function: MirFunction, value: MirValueId, vector: MirVectorFact,
        cursor: MirValueId, loop_places: [MirPlaceId: Bool], index_expr: String,
        column_context: (String, String, [(MirValueId, MirFieldId): USize])?, defined: &[MirValueId: String],
        source: &String, indent: USize) -> String? {
        if name := defined.get(value) { return name }
        instruction :: self.value_instruction(function, value) ?? return None
        expression :: if instruction.operation == {
            MirOperation.Constant(constant) -> self.constant_for_type(constant, self.value_type(function, value))
            MirOperation.LoopRangeValue(cursor: candidate) | MirOperation.LoopIterValue(cursor: candidate) -> {
                if candidate != cursor { return None }
                index_expr
            }
            MirOperation.ReadPlace(place) -> {
                if self.canonical_cursor_value_matches(function, value, cursor) { index_expr }
                else { self.acceleration_place_expr(function, place, vector, cursor, loop_places, index_expr, column_context) ?? return None }
            }
            MirOperation.Copy(value: value, fact: fact) -> {
                if fact == MirCopyFact.ViewMaterialize { return None }
                self.acceleration_value_expr(function, value, vector, cursor, loop_places, index_expr, column_context, &defined, &source, indent) ?? return None
            }
            MirOperation.TraitBox -> { return None }
            MirOperation.AttachTag(value: value) -> self.acceleration_value_expr(function, value, vector, cursor, loop_places, index_expr, column_context, &defined, &source, indent) ?? return None
            MirOperation.Index(base: base, index: index, kind: MirIndexKind.FixedListProof) -> {
                if !self.canonical_cursor_value_matches(function, index, cursor) || column_context != None { return None }
                "({self.value_borrow(base)})[(({index_expr} ) as usize)].clone()"
            }
            MirOperation.Field(base: base, field: field) -> self.acceleration_field_expr(function, base, field, vector, cursor,
                loop_places, index_expr, column_context, &defined, &source, indent) ?? return None
            MirOperation.Unary(op: op, value: value) -> {
                operand :: self.acceleration_value_expr(function, value, vector, cursor, loop_places, index_expr, column_context, &defined, &source, indent) ?? return None
                self.unary(op, operand, self.value_type(function, value))
            }
            MirOperation.Binary(op: op, dispatch: dispatch, left: left, right: right) -> {
                left :: self.acceleration_value_expr(function, left, vector, cursor, loop_places, index_expr, column_context, &defined, &source, indent) ?? return None
                right :: self.acceleration_value_expr(function, right, vector, cursor, loop_places, index_expr, column_context, &defined, &source, indent) ?? return None
                self.acceleration_binary(op, dispatch, left, right)
            }
            MirOperation.Semantic(MirSemanticOp.ColumnarRead(base: base, column: column, column_index: column_index, index: index)) -> {
                if !self.canonical_cursor_value_matches(function, index, cursor) { return None }
                if context := column_context {
                    (columns, offset, slots) :: context
                    slot :: slots.get((base, column)) ?? return None
                    "({columns}[{offset}].{slot}).clone()"
                } else {
                    "({self.value_borrow(base)}).column({column_index})[(({index_expr} ) as usize)].clone().jet_col_{self.field_name(column)}()"
                }
            }
            MirOperation.Parameter | MirOperation.Capture -> self.value_owned(value)
            MirOperation.Global(name: name) -> self.global_expression(name)
            else -> { return None }
        }
        name :: "__jet_accel_v{value.0}"
        ty :: self.rust_type(self.value_type(function, value))
        pad :: " ".repeat(indent)
        source.push_str("{pad}let {name}: {ty} = {expression};\n")
        defined[value] = name
        name
    }
    // Rust: crates/jet-codegen/src/Codegen/MIRRust.rs:15039
    fn acceleration_field_expr(self, function: MirFunction, base: MirValueId, field: MirFieldId,
        vector: MirVectorFact, cursor: MirValueId, loop_places: [MirPlaceId: Bool], index_expr: String,
        column_context: (String, String, [(MirValueId, MirFieldId): USize])?, defined: &[MirValueId: String],
        source: &String, indent: USize) -> String? {
        base_instruction :: self.value_instruction(function, base) ?? return None
        if base_instruction.operation == {
            MirOperation.Index(base: collection, index: index, kind: MirIndexKind.FixedListProof) -> {
                if !self.canonical_cursor_value_matches(function, index, cursor) { return None }
                if context := column_context {
                    (columns, offset, slots) :: context
                    slot :: slots.get((collection, field)) ?? return None
                    return "({columns}[{offset}].{slot}).clone()"
                }
                if access := vector.accesses.find((access) -> access.field == Some(field) &&
                    if access.root == { MirVectorAccessRoot.Value(value) -> value == collection; else -> false }) {
                    if access.layout == MirVectorLayout.ColumnarDirect {
                        column :: access.column_index ?? return None
                        return "({self.value_borrow(collection)}).column({column})[(({index_expr} ) as usize)].clone().jet_col_{self.field_name(field)}()"
                    }
                }
                return "({self.value_borrow(collection)})[(({index_expr} ) as usize)].{self.field_name(field)}.clone()"
            }
            else -> {}
        }
        base :: self.acceleration_value_expr(function, base, vector, cursor, loop_places, index_expr, column_context, &defined, &source, indent) ?? return None
        "({base}).{self.field_name(field)}.clone()"
    }
    // Rust: crates/jet-codegen/src/Codegen/MIRRust.rs:15108
    fn acceleration_place_expr(self, function: MirFunction, place_id: MirPlaceId, _vector: MirVectorFact,
        cursor: MirValueId, loop_places: [MirPlaceId: Bool], index_expr: String,
        column_context: (String, String, [(MirValueId, MirFieldId): USize])?) -> String? {
        place :: function.places.find((place) -> place.id == place_id) ?? return None
        if place.projections.is_empty() {
            if loop_places.contains_key(place_id) { return index_expr }
            return self.place_read(function, place_id)
        }
        index_pos :: place.projections.position((projection) -> if projection == {
            MirProjection.Index(kind: MirIndexKind.FixedListProof, index: index) -> self.canonical_cursor_value_matches(function, index, cursor)
            else -> false
        }) ?? return None
        if place.projections[..index_pos].any((projection) -> if projection == { MirProjection.Index -> true; else -> false }) ||
            place.projections[index_pos + 1..].any((projection) -> if projection == { MirProjection.Field -> false; else -> true }) { return None }
        if column_context != None { return None }
        base :: self.place_base(function, place.base, false, place.projections[..index_pos])
        suffix := ""
        for projection in place.projections[index_pos + 1..] {
            if projection == { MirProjection.Field(field: field) -> { suffix.push_str(".{self.field_name(field)}") }; else -> { return None } }
        }
        "({base})[(({index_expr} ) as usize)]{suffix}.clone()"
    }
    // Rust: crates/jet-codegen/src/Codegen/MIRRust.rs:15167
    fn acceleration_binary(self, op: MirBinaryOp, dispatch: MirBinaryDispatch, left: String, right: String) -> String {
        if dispatch == {
            MirBinaryDispatch.Primitive -> self.binary(op, left, right)
            MirBinaryDispatch.Prelude(call: call, location: location) -> {
                args := [left, right]
                extras :: if location := location { ["{self.source_file_path(location.file):?}", "{location.line}u32"] } else { [] }
                self.append_prelude_context(call, &args, extras)
                row :: self.prelude_row(call)
                self.validate_prelude_count(row, args.len())
                args :: args.enumerate().map((entry) -> {
                    (index, arg) :: entry
                    if row.signature.borrow_mask[index] || RustEmitter.canonical_math_borrow(self.prelude_symbol(call), index) { "&({arg})" } else { arg }
                }).join(", ")
                "{self.prelude_symbol(call)}({args})"
            }
        }
    }
    // Rust: crates/jet-codegen/src/Codegen/MIRRust.rs:15209
    fn acceleration_write_place_expr(self, function: MirFunction, place_id: MirPlaceId, index_expr: String, value: String) -> String? {
        place :: function.places.find((place) -> place.id == place_id) ?? return None
        index_pos :: place.projections.position((projection) -> if projection == {
            MirProjection.Index(kind: MirIndexKind.FixedListProof) -> true
            else -> false
        }) ?? return None
        base :: self.place_base(function, place.base, true, place.projections[..index_pos])
        suffix := ""
        for projection in place.projections[index_pos + 1..] {
            if projection == { MirProjection.Field(field: field) -> { suffix.push_str(".{self.field_name(field)}") }; else -> { return None } }
        }
        if suffix.is_empty() { return None }
        "({base})[(({index_expr} ) as usize)]{suffix} = {value}"
    }
    // Rust: crates/jet-codegen/src/Codegen/MIRRust.rs:15244
    fn emit_vector_block(self, function: MirFunction, block: MirBasicBlock, out: &String, indent: USize) -> Bool {
        if self.coverage_enabled() || function.is_scalar { return false }
        fact :: function.optimization.vector_facts.find((fact) -> fact.loop_header == block.id && fact.decision.is_eligible()) ?? return false
        uninit :: (instruction: MirInstruction) -> if instruction.operation == { MirOperation.InitializeUninit -> true; else -> false }
        if block.instructions.any(uninit) || fact.body_blocks.filter_map((block_id) ->
            function.blocks.find((candidate) -> candidate.id == block_id)).flat_map((block) -> block.instructions).any(uninit) { return false }
        if fact.rule == {
            MirVectorRule.Elementwise | MirVectorRule.FieldAccess -> {}
            MirVectorRule.ConditionalAccumulate -> {
                if !D_FRED1_FIXED_ORDER.is_canonical() { panic("MIR conditional vector emission requires canonical D-FRED1 order") }
                if self.vector_rmw_plan(function, fact) == None { panic("MIR conditional vector fact has no canonical accumulator plan") }
            }
            MirVectorRule.EarlyExitSearch -> {}
            MirVectorRule.Reduction -> {
                if !D_FRED1_FIXED_ORDER.is_canonical() { panic("MIR reduction vector emission requires canonical D-FRED1 order") }
                if fact.fixed_reduction == None { panic("MIR reduction vector fact is missing its fixed reduction row") }
            }
        }
        row :: function.optimization.loop_facts.find((row) -> row.header == block.id) ?? return false
        cursor :: fact.cursor ?? return false
        width :: fact.lane_width ?? return false
        (start, end) :: self.canonical_counted_bounds(function, fact) ?? return false
        exit :: fact.fixed_reduction.map((fixed) -> fixed.exit).or(row.exit) ?? return false
        source :: if width == {
            2 -> self.vector_loop_source<2>(function, fact, cursor, start, end, exit, indent)
            4 -> self.vector_loop_source<4>(function, fact, cursor, start, end, exit, indent)
            8 -> self.vector_loop_source<8>(function, fact, cursor, start, end, exit, indent)
            else -> None
        }
        source :: source ?? return false
        out.push_str(source)
        true
    }
    // Rust: crates/jet-codegen/src/Codegen/MIRRust.rs:15344
    fn vector_loop_source<N: USize>(self, function: MirFunction, fact: MirVectorFact, cursor: MirValueId,
        start: MirValueId, end: MirValueId, exit: MirBlockId, indent: USize) -> String? {
        loop_places := [MirPlaceId: Bool]{}
        for block_id in fact.body_blocks {
            block :: self.block_row(function, block_id) ?? return None
            for instruction in block.instructions {
                if instruction.operation == {
                    MirOperation.WritePlace(place: place, value: value) -> { if self.vector_is_loop_value(function, value, cursor) { loop_places[place] = true } }
                    else -> {}
                }
            }
        }
        rmw :: if fact.rule == {
