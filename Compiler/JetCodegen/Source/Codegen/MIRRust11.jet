        for field in &node.fields { out.push_str(&"{field.slot} = Some(__jet_whole.{self.field_name(field.id)}); ") }
        out.push_str("} ")
        out
    }
    // Rust: crates/jet-codegen/src/Codegen/MIRRust.rs:18283
