    }
    // Rust: crates/jet-codegen/src/Codegen/MIRRust.rs:18247
    fn declare_partial_fields(self: &Self, node: &PartialMoveNode, out: &String) -> {
        // Reverse local declarations preserve forward record-field drop order.
        for field in node.fields.iter().rev() {
            ty :: self.rust_local_type(&field.ty)
            ty :: if field.boxed { "Box<{ty}>" } else { ty }
            out.push_str(&"    let mut {field.slot}: Option<{ty}> = None;\n")
            if field.nested == .Some(nested) { self.declare_partial_fields(nested, out) }
        }
    }
    // Rust: crates/jet-codegen/src/Codegen/MIRRust.rs:18260
    fn clear_partial_fields(node: &PartialMoveNode) -> String {
