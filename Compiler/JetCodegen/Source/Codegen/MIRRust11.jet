            .LoopIterHasNext { cursor, .. } if self.borrowed_loop_cursor(function, cursor).is_some() -> "{{ let (items, at) = *{value_slot(cursor)}.as_ref().expect(\"MIR value\"); at < items.len() }}"
            .LoopIterAdvance { cursor, .. } if self.borrowed_loop_cursor(function, cursor).is_some() -> "{{ {value_slot(cursor)}.as_mut().expect(\"MIR value\").1 += 1; }}"
            .Parameter { index, .. } -> self.parameter_expression(function, index)
            .Capture { slot } -> self.capture_expression(function, slot)
            .Global { name } -> self.global_expression(name)
            .Phi { incoming } -> self.phi_expression(function, incoming)
            .ReadPlace(place) -> self.place_read(function, place)
            .MovePlace { place } -> self.move_place(function, place)
            .WritePlace { .. } | .ReplacePlace { .. } | .InitializeUninit { .. } -> "()"
            .Copy { value, fact } -> {
                value_ty :: self.value_type(function, value)
                if fact == MirCopyFact.ViewMaterialize {
                    kind :: mir_view_copy_kind(value_ty).unwrap_or_else(fn() { panic("MIR view materialization source `{value_ty.display_name()}` has no canonical copy kernel") })
                    if result == .Some(result) {
                        target_ty :: self.value_type(function, result)
                        if !kind.target_matches(target_ty) { panic("MIR view materialization `{kind.symbol()}` has destination `{target_ty.display_name()}`") }
                    }
                    "{kind.symbol()}({self.value_copy(value, fact)})"
                } else if is_allocator_result_type(value_ty) { self.value_move(value) }
                else if value_ty.kind() != MirTypeKind.Int && self.history_binding(value).is_none() && self.value_ownership(value).mode == { .Owned | .Move -> true; _ -> false } && self.value_single_use(function, value) { self.value_move(value) }
                else { self.value_copy(value, fact) }
            }
            .Move { value } -> self.value_move(value)
            .TraitBox { value, target } -> {
                source_ty :: self.value_type(function, value)
                if source_ty.kind() == { .TraitObject(_) -> true; _ -> false } { panic("MIR trait boxing source is already a trait object") }
                target_ty :: self.trait_object_type(target)
                "Box::new({self.value_move(value)}) as {self.rust_type(target_ty)}"
            }
            .Constant(constant) -> result.map(fn(value) { self.constant_for_type(constant, self.value_type(function, value)) }).unwrap_or_else(fn() { self.constant(constant) })
            .Unary { op, value } -> self.unary(op, "*({self.value_slot_reference(value, false)})", self.value_type(function, value))
            .Binary { op, dispatch, left, right } -> self.binary_with_dispatch(function, op, dispatch, left, right, location.as_ref())
            .BuildString { parts } -> self.build_string(parts)
            .BuildList { values, trait_coercion } -> self.build_list(function, result, values, trait_coercion)
            .BuildMap { entries } -> {
                root :: self.config.root_prefix
                pairs :: entries.iter().map(fn((key, value)) { "({self.value_move(key)}, {self.value_move(value)})" }).collect[[String]]().join(", ")
                "[{pairs}].into_iter().collect::<{root}JetMap<_,_>>()"
            }
            .EnumIs { subject, owner, variant } -> self.enum_is(function, subject, owner, variant)
            .EnumPayload { subject, owner, variant, index } -> self.enum_payload(function, result, subject, owner, variant, index)
            .OptionIsSome { subject } -> "matches!({self.inspected_value_reference(function, subject)}, Ok(_))"
            .OptionValue { subject } -> self.immutable_read_place(function, subject) == {
                .Some(place) -> "match {self.place_reference(function, place, MirAccess.Read)} {{ Ok(value) => value.clone(), Err(_) => unreachable!(\"MIR option payload missing\") }}"
                .None -> "match {self.value_move(subject)} {{ Ok(value) => value, Err(_) => unreachable!(\"MIR option payload missing\") }}"
            }
            .ResultIsOk { subject } -> "matches!({self.inspected_value_reference(function, subject)}, Ok(_))"
            .ResultValue { subject, ok } if self.immutable_read_place(function, subject).is_some() -> {
                place :: self.immutable_read_place(function, subject).expect("checked read place")
                subject :: self.place_reference(function, place, MirAccess.Read)
                if ok { "match {subject} {{ Ok(value) => value.clone(), Err(_) => unreachable!(\"MIR result success payload missing\") }}" }
                else { "match {subject} {{ Ok(_) => unreachable!(\"MIR result error payload missing\"), Err(error) => error.clone() }}" }
            }
            .ResultValue { subject, ok } -> {
                if ok {
                    if is_allocator_result_type(self.value_type(function, subject)) { "match {self.value_move(subject)} {{ Ok(value) => value, Err(_) => unreachable!(\"MIR result success payload missing\") }}" }
                    else { "match {self.value_move(subject)} {{ Ok(value) => value, Err(_) => unreachable!(\"MIR result success payload missing\") }}" }
                } else {
                    if is_allocator_result_type(self.value_type(function, subject)) { "match {self.value_move(subject)} {{ Ok(_) => unreachable!(\"MIR result error payload missing\"), Err(error) => error }}" }
                    else { "match {self.value_move(subject)} {{ Ok(_) => unreachable!(\"MIR result error payload missing\"), Err(error) => error }}" }
                }
            }
            .PatternCapture { matched, index } -> self.pattern_capture(function, matched, index, result)
            .PatternMatched { matched } -> "matches!({self.value_slot_reference(matched, false)}, Ok(_))"
            .ProjectMembers { base, members } -> self.project_members(base, members)
            .Index { call, base, index, kind, access, location, context } -> self.index(function, call, base, index, kind, access, location, context)
            .Slice { call, base, start, end, range, location } -> self.slice(function, call, base, start, end, range, location)
            .Range { start, end, exclusive } -> "{self.native_int_argument(self.value_owned(start), None)}{if exclusive { ".." } else { "..=" }}{self.native_int_argument(self.value_owned(end), None)}"
            .Field { base, field } -> self.history_field_expression(function, base, field)
            .Struct { type_id, fields } -> self.rust_struct_literal(type_id, fields, &[], false)
            .Enum { type_id, variant, args } -> self.enum_value(function, type_id, variant, args, location.as_ref())
            .Tuple { fields, .. } -> {
                values :: fields.iter().map(fn((_, value)) { self.value_move(value) }).collect[[String]]().join(", ")
                comma :: if fields.len() == 1 { "," } else { "" }
                "({values}{comma})"
            }
            .Present { value } | .ResultOk { value } -> "Ok({self.value_move(value)})"
            .Convert { value, parameters, target, conversion } -> self.conversion(function, value, parameters, target, conversion)
            .Absent -> "{self.config.root_prefix}JetOutcome::Err({self.config.root_prefix}JetAbsent)"
            .ResultErr { value } -> "Err({self.value_move(value)})"
            .Call { callee, args, type_args } -> {
                emitted :: self.call(function, callee, args, type_args)
                callee == {
                    .Core(id) -> self.core_int_result(self.core_row(id), emitted, result.map(fn(value) { self.value_type(function, value) }))
                    .Prelude(_) -> result.and_then(fn(value) { self.native_int_result(&emitted, self.value_type(function, value)) }).unwrap_or(emitted)
                    _ -> self.call_result_expression(function, callee, result, emitted)
                }
            }
            .CoreCall { call, route, args, type_args, data_plan, fallibility, .. } -> {
                if self.source_math_call(function, call, args, type_args, result) == .Some(emitted) { return emitted }
                emitted :: self.core_call(function, call, route, args, type_args, data_plan.as_ref(), result.map(fn(value) { self.value_type(function, value) }), location.as_ref())
                row :: self.core_row(call)
                emitted :: if row.module == "core.crypto.vault" && row.member == "current" { "({emitted}).map(|value| match value {{ Some(value) => Ok(value), None => Err({self.config.root_prefix}JetAbsent) }})" } else { emitted }
                fallibility == { .Failure(.Optional { .. }) -> "({emitted}).ok_or({self.config.root_prefix}JetAbsent)"; _ -> emitted }
            }
            .IndirectCall { callee, args, type_args } -> self.indirect_call(function, callee, args, type_args)
            .Closure { function: target, captures, facts } -> self.closure(function, target, captures, facts, result)
            .PtrFromAddr { addr, element } -> {
                address :: self.value_owned(addr)
                address :: if self.value_type(function, addr).kind() == MirTypeKind.Int { self.native_int_argument(address, location.as_ref()) } else { address }
                "({address} as usize as *mut {self.rust_type(element)})"
            }
            .Deref { value } -> {
                guard :: if is_shared_guard_type(self.value_type(function, value)) {
                    self.value_definition(function, value) == { .Some(.AddressOf { place, .. }) | .Some(.ReadPlace(place)) -> self.place_reference(function, place, MirAccess.Read); _ -> self.value_slot_reference(value, false) }
                } else { self.value_owned(value) }
                if is_shared_guard_type(self.value_type(function, value)) { "jet_mem::jet_sentry_read((&**({guard})) as *const _, \"valid_ptr\")" }
                else { "jet_mem::jet_sentry_read(({guard}), \"valid_ptr\")" }
            }
            .RawAddressOf { place } -> self.raw_address_of(function, place, result.is_some_and(fn(value) { self.value_type(function, value).kind() == MirTypeKind.Int }))
            .AddressOf { place, access } -> {
                // Owned slots retain declared place values; call boundaries rederive borrows.
                if access != MirAccess.Move { self.place_read(function, place) } else { self.address_of(function, place, access) }
            }
            .AttachTag { value, .. } -> self.value_move(value)
            .Todo { call, location, expected_type } -> {
                emitted :: self.prelude_call_args_exact(call, &[])
                expected :: expected_type.as_ref().map(fn(ty) { self.rust_type(ty) }).unwrap_or_else(fn() { "()" })
                "{{ let _: {expected} = {emitted}; unreachable!(\"MIR Todo at {location.file.0}:{location.line}:{location.column}\") }}"
            }
            .Never { reason } -> "unreachable!({reason:?})"
            .Semantic(operation) -> self.semantic(function, operation, result, location)
            .LoopRangeInit { call, start, end, step, exclusive } -> self.loop_range_init(function, call, start, end, step, exclusive, location.expect("MIR range cursor is missing its instruction source location"))
            .LoopRangeHasNext { call, cursor } -> self.prelude_cursor_call(call, cursor, MirAccess.Read)
            .LoopRangeValue { call, cursor } -> {
                emitted :: self.prelude_cursor_call(call, cursor, MirAccess.Read)
                result.and_then(fn(value) { self.native_int_result(&emitted, self.value_type(function, value)) }).unwrap_or(emitted)
            }
            .LoopRangeAdvance { call, cursor } -> self.prelude_cursor_call(call, cursor, MirAccess.Write)
            .LoopIterInit { call, collection, step, by_value, source_kind } -> self.loop_iter_init(function, call, collection, step, by_value, source_kind, location.expect("MIR iterator cursor is missing its instruction source location"))
            .LoopIterHasNext { call, cursor } -> {
                if self.byte_loop_cursor(function, cursor) { "jet_loop_iter_bytes_has_next({self.value_slot_reference(cursor, false)})" }
                else { self.prelude_cursor_call(call, cursor, MirAccess.Read) }
            }
            // Rust: crates/jet-codegen/src/Codegen/MIRRust.rs:19807
            // Complete the boundary-spanning operation_expression item.
            .LoopIterValue { call, cursor } -> {
                if self.byte_loop_cursor(function, cursor) { "jet_loop_iter_bytes_value({self.value_borrow_mut(cursor)})" }
                else { self.prelude_cursor_call(call, cursor, MirAccess.Write) }
            }
            .LoopIterAdvance { call, cursor } -> {
                if self.byte_loop_cursor(function, cursor) { "jet_loop_iter_bytes_advance({self.value_borrow_mut(cursor)})" }
                else { self.prelude_cursor_call(call, cursor, MirAccess.Write) }
            }
            .ScopeEnter { scope, .. } -> "{{ let _ = {scope.0}; }}"
            .ScopeExit { scope } -> "{{ let _ = {scope.0}; }}"
            .Drop { value, kind } -> self.drop_expression(function, value, kind)
        }
    }
}
