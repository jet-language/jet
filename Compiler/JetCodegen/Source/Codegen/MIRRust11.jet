use jet_foundation.MIR.*
use jet_codegen.Codegen.MIRRust.*
use jet_codegen.Codegen.MIRRust02.RustEmitter
use std.rc.Rc
// GATE #4499: MIR ids, places and field paths retain typed equality and ordering.

impl RustEmitter {
    // Rust: crates/jet-codegen/src/Codegen/MIRRust.rs:17999
    fn plain_payload_pattern(self: &Self, function: &MirFunction, subject: MirValueId, owner: MirTypeId, variant: &String, index: USize) -> (String, Bool)? {
        ty :: self.value_type(function, subject)
        owner :: ty.nominal_id().or(ty.identity).unwrap_or(owner)
        key :: &self.type_def(owner).key
        if key.starts_with("<corelib>/") || has_native_type_projection(key) || core_rust_type_name(key).is_some() { return None }
        self.enum_variant_payload(owner, variant) == {
            .Unit -> None
            .Single(_) if index != 0 -> None
            .Named(fields) if index >= fields.len() -> None
            _ -> Some(self.payload_pattern(&MirPayloadKind.Enum { owner, variant: variant.to_string(), index }))
        }
    }

    // Rust: crates/jet-codegen/src/Codegen/MIRRust.rs:18031
    // The stable place reference, including a moved unwrapped payload.
    fn ref_payload_reference(self: &Self, function: &MirFunction, value: MirValueId) -> String {
        value :: self.value_definition(function, value) == { .Some(.Move { value: payload }) -> payload; _ -> value }
        operation :: self.value_definition(function, value).expect("checked binding read")
        if operation == .LoopIterValue { cursor, .. } {
            return "{{ let (items, at) = *{value_slot(cursor)}.as_ref().expect(\"MIR value\"); &items[at] }}"
        }
        read :: operation == {
            .EnumPayload { subject, .. } | .OptionValue { subject } | .ResultValue { subject, .. } -> subject
            .ReadPlace(_) -> value
            _ -> unreachable("checked binding read")
        }
        place :: self.immutable_read_place(function, read).expect("checked stable binding place")
        reference :: self.place_reference(function, place, MirAccess.Read)
        operation == {
            .ReadPlace(_) -> reference
            .EnumPayload { subject, owner, variant, index } -> {
                (pattern, boxed) :: self.plain_payload_pattern(function, subject, owner, variant, index).expect("checked plain payload")
                payload :: if boxed { "&**payload" } else { "payload" }
                "match {reference} {{ {pattern} => {payload}, _ => unreachable!(\"MIR enum payload variant mismatch\") }}"
            }
            .ResultValue { ok: false, .. } -> "match {reference} {{ Ok(_) => unreachable!(\"MIR result error payload missing\"), Err(error) => error }}"
            .ResultValue { .. } -> "match {reference} {{ Ok(value) => value, Err(_) => unreachable!(\"MIR result success payload missing\") }}"
            _ -> "match {reference} {{ Ok(value) => value, Err(_) => unreachable!(\"MIR option payload missing\") }}"
        }
    }

    // Rust: crates/jet-codegen/src/Codegen/MIRRust.rs:18080
    fn ref_bindings_of(self: &Self, function: &MirFunction) -> Rc[RefBindings] {
        if self.ref_bindings.borrow().get(&function.id) == .Some(bindings) { return bindings.clone() }
        bindings :: Rc.new(self.plan_ref_bindings(function))
        self.ref_bindings.borrow_mut().insert(function.id, bindings.clone())
        bindings
    }
    // Rust: crates/jet-codegen/src/Codegen/MIRRust.rs:18091
    fn ref_binding_local(self: &Self, function: &MirFunction, local: MirLocalId) -> Bool {
        self.ref_bindings_of(function).locals.contains(&local)
    }
    // Rust: crates/jet-codegen/src/Codegen/MIRRust.rs:18095
    fn ref_binding_payload(self: &Self, function: &MirFunction, value: MirValueId) -> Bool {
        self.ref_bindings_of(function).payloads.contains(&value)
    }
    // Rust: crates/jet-codegen/src/Codegen/MIRRust.rs:18101
    fn borrowed_loop_cursor(self: &Self, function: &MirFunction, cursor: MirValueId) -> MirPlaceId? {
        self.ref_bindings_of(function).cursors.get(&cursor).copied()
    }
    // Rust: crates/jet-codegen/src/Codegen/MIRRust.rs:18106
    fn borrowed_loop_collection(self: &Self, function: &MirFunction, value: MirValueId) -> Bool {
        self.ref_bindings_of(function).collections.contains(&value)
    }
    // Rust: crates/jet-codegen/src/Codegen/MIRRust.rs:18112
    fn ref_binding_drop(self: &Self, function: &MirFunction, value: MirValueId) -> MirLocalId? {
        operation :: self.value_definition(function, value)?
        if operation != .MovePlace { place } { return None }
        place :: self.place_row(function, place)?
        if place.base != .Local(local) { return None }
        if !place.projections.is_empty() || !self.ref_binding_local(function, local) { return None }
        users :: self.value_users(function, value)
        dropped :: !users.is_empty() && users.iter().all(fn(user) {
            user.is_some_and(fn(instruction) { instruction.operation == { .Drop { value: operand, .. } if operand == value -> true; _ -> false } })
        })
        if dropped { Some(local) } else { None }
    }

    // Rust: crates/jet-codegen/src/Codegen/MIRRust.rs:18133
    fn plan_partial_moves(self: &Self, function: &MirFunction) -> [PartialMoveRoot] {
        if !function.places.iter().any(fn(place) { !place.projections.is_empty() && place.projections.iter().all(fn(projection) { projection == { .Field { .. } -> true; _ -> false } }) }) { return [] }
        moved :: function.blocks.iter().flat_map(fn(block) { &block.instructions }).filter_map(fn(instruction) {
            instruction.operation == { .MovePlace { place } | .AddressOf { place, access: .Move } -> Some(place); _ -> None }
        }).collect[Set[MirPlaceId]]()
        roots := [PartialMoveRoot].new()
        for place in &function.places {
            if !moved.contains(&place.id) || place.projections.is_empty() || !place.projections.iter().all(fn(projection) { projection == { .Field { .. } -> true; _ -> false } }) { continue }
            path :: place.projections.iter().map(fn(projection) { projection == { .Field { field, .. } -> field; _ -> unreachable() } }).collect[[MirFieldId]]()
            root :: if roots.iter().position(fn(root) { root.base == place.base }) == .Some(index) { &roots[index] } else {
                (slot, ty) :: place.base == {
                    .Local(local) -> (local_slot(local), &function.locals.iter().find(fn(row) { row.id == local }).expect("partial move local").ty)
                    .Parameter(value) | .Capture(value) | .Temporary(value) -> (value_slot(value), self.value_type(function, value))
                    .Static(_) -> panic("checked partial move of static storage")
                }
                roots.push(PartialMoveRoot { base: place.base.clone(), node: self.partial_move_node(slot, ty, false, path[0]) })
                roots.last_mut().expect("inserted partial move root")
            }
            self.extend_partial_move(&root.node, &path)
        }
        roots
    }

    // Rust: crates/jet-codegen/src/Codegen/MIRRust.rs:18180
    fn partial_move_node(self: &Self, slot: String, ty: &MirType, boxed: Bool, first_field: MirFieldId) -> PartialMoveNode {
        owner :: self.program.fields.iter().find(fn(row) { row.id == first_field }).expect("partial move field").owner
        fields :: if ty.tuple_fields() == .Some(elements) {
            elements.iter().map(fn((name, ty)) {
                field :: self.program.fields.iter().find(fn(row) { row.owner == owner && row.field.name == name }).expect("checked tuple field")
                PartialMoveField { id: field.id, slot: "{slot}_field_{field.id.0}", ty: ty.clone(), boxed: false, nested: None }
            }).collect()
        } else {
            definition :: self.type_def(owner)
            if definition.kind != .Struct { fields, .. } { panic("checked field move must name a struct field") }
            bindings :: ty.kind() == {
                .Apply { args, .. } -> definition.generic_params.iter().zip(args).map(fn((parameter, argument)) { (parameter.name.clone(), argument.clone()) }).collect[[String:MirType]]()
                _ -> [String:MirType].new()
            }
            fields.iter().filter(fn(field) { !field.computed }).map(fn(field) {
                PartialMoveField { id: field.id, slot: "{slot}_field_{field.id.0}", ty: Self.history_capture_type(&field.ty, &bindings), boxed: self.boxed_field(field.id), nested: None }
            }).collect()
        }
        PartialMoveNode { fields, slot, owner, boxed }
    }
    // Rust: crates/jet-codegen/src/Codegen/MIRRust.rs:18229
    fn extend_partial_move(self: &Self, node: &PartialMoveNode, path: &[MirFieldId]) -> {
        field :: node.fields.iter_mut().find(fn(field) { field.id == path[0] }).expect("partial move field belongs to owner")
        if path.len() > 1 {
            if field.nested.is_none() { field.nested = Some(Box.new(self.partial_move_node(field.slot.clone(), &field.ty, field.boxed, path[1]))) }
            self.extend_partial_move(field.nested.as_mut().expect("nested partial move"), &path[1..])
        }
    }
    // Rust: crates/jet-codegen/src/Codegen/MIRRust.rs:18242
    fn partial_move_root(self: &Self, function: &MirFunction, base: &MirPlaceBase) -> (&PartialMoveNode)? {
