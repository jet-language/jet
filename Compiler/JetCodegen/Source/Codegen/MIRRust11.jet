            result :: instruction.result.unwrap_or_else(fn() { panic("MIR Fixed.new has no result slot") })
            out.push_str(&"    let mut {fixed_inline_backing_name(result)}: [std::mem::MaybeUninit<u8>; {size}] = [std::mem::MaybeUninit::<u8>::uninit(); {size}];\n")
        } }
    }
