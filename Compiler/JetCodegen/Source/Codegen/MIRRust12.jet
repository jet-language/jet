    fn emit_native_derived_equal(self, implementation: MirImplDef, function: MirFunction, out: &String) -> Bool {
        if !implementation.compiler_generated || implementation.trait_ref.as_ref().is_none_or((trait_ref) -> trait_ref.name != EQUATABLE) || self.function_leaf_name(function) != "equal" { return false }
