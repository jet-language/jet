        if definition.generic_params.is_empty() && definition.compiler_builtin.is_none() && !definition.key.starts_with("<corelib>/") && !has_native_type_projection(&definition.key) && canonical_core_email_rust_type_name(&definition.key).is_none() && definition.serde.iter().all((attribute) -> attribute.kind == MirSerdeAttributeKind.RenameAll) -> Val(definition) else -> nil
