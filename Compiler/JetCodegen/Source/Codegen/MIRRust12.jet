        if !definition.generic_params.is_empty() { return false }
        has_computed_field :: if definition.kind == {
            .Struct(fields: fields) -> fields.iter().any((field) -> field.computed)
            .Enum(variants: variants) -> variants.iter().any((variant) -> if variant.payload == .Named(fields) -> fields.iter().any((field) -> field.computed) else -> false)
            else -> return false
        }
        if has_computed_field { return false }
        seen := BTreeSet.from([definition.id])
        equal :: self.canonical_equality_definition(definition, "self", "__jet_rhs", &seen)
        out.push_str("fn equal(&self, __jet_rhs: &Self) -> bool {{\n    {equal}\n}}\n\n")
        true
    }
