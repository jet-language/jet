use JetCodegen.Codegen.[is_json_variant, is_key_variant]
use JetCodegen.Codegen.Context.Cx
use JetFoundation.Syntax
use JetFoundation.AST.[Type, VariantPayload]
use JetCodegen.Codegen.TIR.canonical_enum_owner

// Rust: crates/jet-codegen/src/Codegen/Statement.rs:11
// Payload types carried into destructured bindings; unknown variants stay untyped.
fn variant_binding_types(cx: &Cx, variant: String) -> [Type]? Never! {
    if is_json_variant(variant) {
        data := Type.Named(Syntax.TYPE_DATA.to_string())
        return match variant {
            "Null" => Some([])
            "Bool" => Some([Type.Bool])
            "Int" => Some([Type.Int])
            "Float" => Some([Type.Float])
            "Text" => Some([Type.String])
            "Array" => Some([Type.List(data)])
            "Object" => Some([Type.Map { key: Type.String, key_span: None, value: data }])
            "Number" => Some([Type.String])
            _ => None
        }
    }
    if cx.variant_owner.get(variant) is Some(owner) {
        if variant_binding_types_for_enum(cx, owner, variant) is Some(types) { return Some(types) }
    }
    // D-TERM1: Key variant payloads.
    if is_key_variant(variant) {
        return match variant {
            "Char" | "Ctrl" => Some([Type.Char])
            "F" => Some([Type.Int])
            _ => Some([])
        }
    }
    None
}

// Rust: crates/jet-codegen/src/Codegen/Statement.rs:46
fn variant_binding_types_for_enum(cx: &Cx, enum_name: String, variant: String) -> [Type]? Never! {
    if enum_name == Syntax.TYPE_KEY {
        return match variant {
            "Char" | "Ctrl" => Some([Type.Char])
            "F" => Some([Type.Int])
            _ => Some([])
        }
    }
    if enum_name == "DataEvent" {
        return match variant {
            "Bool" => Some([Type.Bool])
            "Int" => Some([Type.Int])
            "Float" => Some([Type.Float])
            "Text" | "Key" => Some([Type.String])
            "Bytes" => Some([Type.List(Type.Int)])
            "Null" | "ArrayStart" | "ArrayEnd" | "ObjectStart" | "ObjectEnd" => Some([])
            _ => None
        }
    }
    resolved := canonical_enum_owner(cx, enum_name)
    if cx.enum_variants.get(resolved) is Some(variants) {
        for (name, payload) in variants {
            if name == variant {
                return match payload {
                    VariantPayload.Unit => Some([])
                    VariantPayload.Single(ty, _) => Some([ty.clone()])
                    VariantPayload.Named(fields) => Some(fields.iter().map(fn(field) { field.ty.clone() }).collect())
                }
            }
        }
    }
    None
}

// Rust: crates/jet-codegen/src/Codegen/Statement.rs:83
// Ordered group leaves; an unknown enum/group yields no leaves.
fn group_leaves(cx: &Cx, enum_type: String?, variant: String) -> [(&String, &VariantPayload)] Never! {
    if enum_type is Some(owner) {
        if cx.enum_variants.get(owner) is Some(variants) {
            prefix := "{variant}."
            leaves: [(&String, &VariantPayload)] := []
            for (name, payload) in variants {
                if name.starts_with(prefix) { leaves.push((&name, &payload)) }
            }
            return ^leaves
        }
    }
    []
}
