// Rust: crates/jet-codegen/src/Codegen/Context.rs:508
pub fn is_json_type_name(name: String) -> Bool { Syntax.is_data_type_name(name) }
// Rust: crates/jet-codegen/src/Codegen/Context.rs:516
pub fn is_data_tree_subject(cx: Cx, subject_ty: Type) -> Bool {
    if subject_ty.without_user_tags() == {
        .Named(name) | .Apply(name, _) -> is_json_type_name(name) || canonical_enum_owner(cx, name) == Syntax.TYPE_DATA
        else -> false
    }
}
// Rust: crates/jet-codegen/src/Codegen/Context.rs:528
pub fn is_key_subject(cx: Cx, subject_ty: Type) -> Bool {
    if subject_ty.without_user_tags() == {
        .Named(name) | .Apply(name, _) -> canonical_enum_owner(cx, name) == Syntax.TYPE_KEY
        else -> false
    }
}
