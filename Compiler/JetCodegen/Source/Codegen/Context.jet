//RS     /// c148: type-parameter names for the function currently being emitted. Set
//RS     /// from `f.type_params` at the start of `emit_func` so `rust_type` and
//RS     /// `rust_param_type` can recognize multi-char params without the single-letter
//RS     /// heuristic. Cleared when emit returns.
//RS     pub(crate) current_type_params: std::cell::RefCell<HashSet<String>>,
//RS     /// c139 M4: spawn lambda bodies collected during TIR lowering (JIT order).
//RS     pub(crate) jit_spawn_lambdas: std::cell::RefCell<Vec<crate::Codegen::TIR::TJitSpawnLambda>>,
//RS     pub(crate) jit_spawn_sites: std::cell::RefCell<HashMap<(String, usize, usize), usize>>,
//RS     /// Global offset for spawn sites lowered from an imported module.
//RS     pub(crate) jit_spawn_site_base: usize,
//RS     /// Concrete generic owner methods reached while lowering executable TIR.
//RS     /// The key is `Owner<Args>::method`, keeping discovery deterministic.
//RS     pub(crate) jit_method_calls:
//RS         std::cell::RefCell<std::collections::BTreeMap<String, (Type, String, Vec<Type>)>>,
//RS     /// Concrete argument types at calls to generic free functions. TIR uses
//RS     /// these facts to admit one native specialization per concrete call shape.
//RS     pub(crate) jit_generic_calls:
//RS         std::cell::RefCell<std::collections::BTreeMap<String, Vec<Vec<Type>>>>,
//RS     /// Concrete instantiations of imported source-owned Core generic calls,
//RS     /// keyed by their checked canonical module and function identity.
//RS     pub(crate) jit_core_source_generic_calls: std::cell::RefCell<
//RS         std::collections::BTreeMap<(String, String), Vec<Vec<Type>>>,
//RS     >,
//RS     /// Functions whose typed decode depends on the canonical TIR migration
//RS     /// plan. The resident codec has no authority to reinterpret that plan.
//RS     pub(crate) jit_canonical_deopt: std::cell::RefCell<HashSet<String>>,
//RS     /// Functions whose codec calls must stay on TIR if the function deopts.
//RS     pub(crate) jit_canonical_calls: std::cell::RefCell<HashSet<String>>,
//RS     /// Resident-only prefix for calls between functions in an imported module.
//RS     pub(crate) jit_local_call_prefix: Option<String>,
//RS     /// Free-function type parameter names, used to give generic call results
//RS     /// their concrete TIR type at the call site.
//RS     pub(crate) fn_type_params: HashMap<String, HashSet<String>>,
//RS     /// The same free-function parameters in declaration order. HashSet is still
//RS     /// useful for structural binding, but explicit `call<T>(…)` must map each
//RS     /// source argument to the matching binder deterministically.
//RS     pub(crate) fn_type_param_order: HashMap<String, Vec<String>>,
//RS     /// D-DBG3 step 2 (dap-debugger): when true, `lower_stmts` interleaves a
//RS     /// `TStmt::LineMarker` before every lowered statement, and emission turns each
//RS     /// into a `// jet:line N` comment. Set ONLY by the native `jet debug` build path
//RS     /// (`emit_bundle_dbg`); false (the default) is byte-identical to today's output,
//RS     /// so normal builds, `jet test`, and the JIT tier never see a marker.
//RS     pub(crate) debug_linemap: bool,
//RS     /// D-ANY-JAI1/D-VARARGBOUND1 (c7jaiany): trait-bounded variadic function
//RS     /// name -> (fixed param count, resolved trait-bound list). Populated once
//RS     /// from each `Item::Func`'s trailing param; call-site lowering
//RS     /// (`TIR/lower.rs`) reads this to route calls to the typed specialization
//RS     /// built by `Codegen/VariadicBound.rs` instead of ordinary lowering.
//RS     pub(crate) variadic_bound_fns: HashMap<String, (usize, Vec<String>)>,
//RS     /// D-OSTARGET1=A (ratified 2026-07-01, c134): the native OS bucket this
//RS     /// build is compiling for — an `impl` gated to a different `#Target(OS.*)`
//RS     /// is skipped entirely (mirrors how `Codegen/Web.rs` filters by
//RS     /// `WebBucket`). Defaults to the host OS; the real build pipeline
//RS     /// (`emit_bundle_dbg`) overwrites it from the resolved `--target=<triple>`.
//RS     pub(crate) active_os: crate::Syntax::OSTarget,
//RS     /// Web Wasm carries unbounded `Int` in `JetWasmInt`, which is cloneable but
//RS     /// not `Copy`. Native sema sees the same type as a scalar, so shared TIR
//RS     /// emission uses this adapter fact when reading an exact-int field.
//RS     pub(crate) web_wasm_noncopy_int: bool,
//RS     /// D-ENC712: resolved package edition for encoding surface dispatch.
//RS     pub(crate) package_edition: String,
//RS     /// D-DX-PREVIEW1: compiler-owned build/revision facts for inline previews.
//RS     /// Adapters receive these values from checked bundle metadata; source calls
//RS     /// never need to expose a public metadata argument.
//RS     pub(crate) preview_build_id: String,
//RS     pub(crate) preview_revision: String,
//RS     /// D-STM1=A (card #506): true while lowering the body of a `#Transact` block,
//RS     /// so a `Shared<T>.edit(f)` inside it routes to the deferred `edit_txn` (the
//RS     /// atomic Shared plane) instead of taking a lock immediately. Set/restored
//RS     /// around the block body in `lower_stmt`'s `Stmt::Transact` arm.
//RS     pub(crate) in_stm_transact: std::cell::Cell<bool>,
//RS     /// D-STM1=A (card #506): set true when a `Shared.edit` inside the current
//RS     /// `#Transact` body routed to `edit_txn` — i.e. the block actually touches the
//RS     /// Shared plane and so needs the `jet_stm::begin()/commit()` scaffold emitted.
//RS     /// Save/restored per block so each `#Transact` reports its own use.
//RS     pub(crate) stm_touched: std::cell::Cell<bool>,
//RS     /// D-FOUND-BOARD1: selected target profile facts are fixed before TIR lowering.
//RS     /// Hardware call nodes copy canonical IDs from this immutable sema projection.
//RS     pub(crate) hardware_profile: Option<jet_foundation::TargetMachine::TargetHardwareFacts>,
//RS     pub(crate) hardware_profile_id: Option<String>,
//RS }
