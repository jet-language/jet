    pub is_base: Bool
}
// Rust: crates/jet-codegen/src/Codegen/Context.rs:34
fn unit_label(family: UnitFamilyDef, member: UnitFamilyMember) -> UnitLabel {
    base := None as String?
    if family.base == .Val(value) -> base = Val(value.0)
    else if !family.members.is_empty() -> base = Val(family.members[0].name)
    UnitLabel{symbol: member.name, name: UnitFamilyDef.type_name(member.name), family: family.family, is_base: base == Val(member.name)}
}
// Rust: crates/jet-codegen/src/Codegen/Context.rs:51
fn unit_family_member_for_type(family: UnitFamilyDef, type_name: String, kind: QuantityKind) -> UnitFamilyMember? {
    loop member in family.members {
        stem :: UnitFamilyDef.type_name(member.name)
        wanted :: if kind == {
            .Linear -> stem
            .Point -> "{stem}Point"
            .Delta -> "{stem}Delta"
        }
        if type_name == wanted -> return Val(member)
    }
    None
}
// Rust: crates/jet-codegen/src/Codegen/Context.rs:67
fn unit_fact(family: UnitFamilyDef, member: UnitFamilyMember, dimension: Dimension?, kind: QuantityKind) -> UnitFact {
    UnitFact{family: family.family, dimension: ^dimension, kind: kind, scale: ~member.scale,
        offset: if kind == .Point -> ~member.offset else -> UnitRatio.zero(), scale_provenance: ~member.scale_provenance}
}
