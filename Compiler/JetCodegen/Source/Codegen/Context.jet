// Rust: crates/jet-codegen/src/Codegen/Context.rs:732
pub fn history_rust_type_name(name: String) -> String? {
    split :: name.rsplit_once("::") ?? name.rsplit_once(".")
    if split == .Val((prefix, leaf)) {
        if prefix == "core" || prefix.starts_with("core.") || prefix.starts_with("core::") -> return history_rust_type_name(leaf)
        return None
    }
    if name == {
        "Count" | "HandleID" | "TaskID" | "EventID" | "HistoryRNG" | "HistoryValue" | "HistoryPrecondition" | "HistoryCase" | "HistoryOperation" | "HistoryScheduleChoice" | "HistoryBounds" | "HistoryDistribution" | "HistoryStrategy" | "TypedHistoryCase" -> Val(name)
        else -> None
    }
}
// Rust: crates/jet-codegen/src/Codegen/Context.rs:760
pub fn core_source_type_leaf(name: String) -> String {
    if name.strip_prefix("<corelib>/") == .Val(identity) -> identity.rsplit("::").next() ?? name
    else -> name
}
// Rust: crates/jet-codegen/src/Codegen/Context.rs:766
pub fn core_rust_type_name(name: String) -> String? {
    if name.starts_with("<corelib>/Core/sync::") && name.ends_with("::RowPolicy") -> return None
    leaf := core_source_type_leaf(name)
    split :: leaf.rsplit_once("::") ?? leaf.rsplit_once(".")
    if split == .Val((prefix, value)) {
        if prefix == "core" || prefix.starts_with("core.") || prefix.starts_with("core::") -> leaf = value
        else -> return None
    }
    if leaf == {
        n if is_json_type_name(n) -> Val("DataTree")
        n if n == Syntax.TYPE_IO_ERROR || n == "IOError" -> Val("IOError")
        n if n == Syntax.TYPE_IO_CONTEXT -> Val("IOContext")
        n if n == Syntax.TYPE_IO_OPERATION -> Val("IOOperation")
        n if n == Syntax.TYPE_PROCESS_RESOURCE_LIMIT -> Val("ProcessResourceLimit")
        "EnvError" -> Val("EnvError")
        n if n == Syntax.TYPE_UTF8_ERROR || n == "UTF8Error" -> Val("UTF8Error")
        "ProcessResult" | "ProcessReceipt" -> Val("ProcessReceipt")
        "ProcessPlan" | "ProcessSpec" | "ProcessChild" | "ProcessStreamMode" | "TerminalPolicy" | "TerminalSize" | "TerminalMode" | "TerminalSession" | "TextWidth" | "TextWidthAmbiguous" | "TextWidthControls" | "TextError" -> Val(leaf)
        "Query" -> Val("DataQuery")
        "DataGroupedQuery" -> Val("DataGroupedQuery")
        "Group" -> Val("GroupValue")
        "DataJoin" -> Val("DataJoin")
        n if n == Syntax.TYPE_SHARED_GUARD -> Val("JetSharedGuard")
        "Signal" -> Val("JetSignal")
        "Derived" -> Val("JetDerived")
        "AsyncPolicy" -> Val("JetAsyncPolicy")
        "Event" -> Val("JetEvent")
        "AsyncEvent" -> Val("JetAsyncEvent")
        "Hook" -> Val("JetHook")
        "DecisionHook" -> Val("JetDecisionHook")
        "HookDecision" -> Val("JetHookDecision")
        "HookOutcome" -> Val("JetHookOutcome")
        "Subscription" -> Val("JetSubscription")
        "EventScope" -> Val("JetEventScope")
        "EventPolicy" -> Val("JetEventPolicy")
        "EventTrace" -> Val("JetEventTrace")
        "DispatchReport" -> Val("JetDispatchReport")
        "DispatchFailure" -> Val("JetDispatchFailure")
        "Overflow" -> Val("JetEventOverflow")
        "FailurePolicy" -> Val("JetFailurePolicy")
        "DispatchState" -> Val("JetDispatchState")
        "HookPolicy" -> Val("JetHookPolicy")
        "EventConfigError" -> Val("JetEventConfigError")
        "TestSuite" -> Val("JetTestSuite")
        "TestComparison" -> Val("JetTestComparison")
        "Clock" | "RNG" | "Fake" | "Solver" | "Duration" | "DurationUnit" -> Val(leaf)
        "LateEventDisposition" -> Val("JetLateEventDisposition")
        "RangeError" -> Val("RangeError")
        "Instant" -> Val("JetInstant")
        "Date" | "LocalDate" -> Val("JetDate")
        "LocalTime" -> Val("JetLocalTime")
        "DateTime" -> Val("JetDateTime")
        "Period" -> Val("JetPeriod")
        "Zone" -> Val("JetZone")
        "ZonedDateTime" -> Val("JetZonedDateTime")
        "URL" -> Val("JetURL")
        "MIME" -> Val("JetMIME")
        "DataLoaderKind" | "DataFormat" | "DataFreshness" | "DataInvalidationCause" | "DataAuthority" | "DataSourceIdentity" | "DataProvenance" | "DataSnapshotIdentity" | "DataLoaderStatus" | "DataLoader" | "DataSnapshot" -> Val(leaf)
        "Regex" -> Val("JetRegex")
        "RegexFlags" -> Val("RegexFlags")
        "Match" -> Val("JetRegexMatch")
        "Decimal" -> Val("JetDecimal")
        "Fraction" -> Val("JetFraction")
        n if n == Syntax.TYPE_RECEIVER -> Val("JetReceiver")
        n if n == Syntax.TYPE_SENDER -> Val("JetSender")
        "Closed" -> Val("Closed")
        "Pool" -> Val("JetPool")
        "ID" -> Val("JetId")
        n if n == Syntax.TYPE_TASK_FAILURE -> Val("JetTaskFailure")
        "DirEntry" | "Stat" | "WalkEntry" | "WatchEvent" | "WatchDomain" | "WatchKind" | "WatchHandle" | "WatchSet" -> Val(leaf)
        "FfiCallbackEvent" -> Val("JetFfiCallbackEventValue")
        "FfiCallbackRegistration" -> Val("JetFfiCallbackRegistrationHandle")
        "TempDir" | "TempFile" | "FileLock" -> Val(leaf)
