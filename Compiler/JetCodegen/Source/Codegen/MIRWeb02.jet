// Rust: crates/jet-codegen/src/Codegen/MIRWeb.rs:3054
fn js_const_key_expression(key: &MirConstKey) -> String MirWebError! {
    if key == {
        .Int(value) -> Ok("BigInt({js_string(value.to_string())})")
        .String(value) -> Ok(js_string(value))
        .Bool(value) -> Ok(value.to_string())
        .Char(value) -> Ok(js_string(value.to_string()))
        .Tuple(values) -> {
            rendered := [String]{}
            loop (_, key) in values {
                text :: js_const_key_expression(key)
                &rendered.push(text)
            }
            Ok("[{rendered.join(", ")}]")
        }
        .Struct(_, fields) -> {
            rendered := [String]{}
            loop (name, key) in fields {
                text :: js_const_key_expression(key)
                &rendered.push("{js_string(name)}: {text}")
            }
            Ok("{{ {rendered.join(", ")} }}")
        }
        .Enum(_, variant, _) -> Ok("{{ tag: {js_string(variant)}, values: [] }}")
    }
}

// Rust: crates/jet-codegen/src/Codegen/MIRWeb.rs:3087
fn js_unary_expression(op: MirUnaryOp, value: String) -> String {
    if op == { .Neg -> "(-({value}))" .Not -> "(!({value}))" }
}

// Rust: crates/jet-codegen/src/Codegen/MIRWeb.rs:3094
fn js_binary_expression(op: MirBinaryOp, left: String, right: String) -> String {
    if op == {
        .Add -> "(({left}) + ({right}))"
        .Sub -> "(({left}) - ({right}))"
        .Mul -> "(({left}) * ({right}))"
        .Div -> "(({left}) / ({right}))"
        .FloorDiv -> "Math.floor(({left}) / ({right}))"
        .Mod -> "(((({left}) % ({right})) + ({right})) % ({right}))"
        .Rem -> "(({left}) % ({right}))"
        .Pow -> "(({left}) ** ({right}))"
        .BitAnd -> "(({left}) & ({right}))"
        .BitOr -> "(({left}) | ({right}))"
        .BitXor -> "(({left}) ^ ({right}))"
        .Shl -> "(({left}) << ({right}))"
        .Shr -> "(({left}) >> ({right}))"
        .Eq -> "(({left}) === ({right}))"
        .Ne -> "(({left}) !== ({right}))"
        .Lt -> "(({left}) < ({right}))"
        .Gt -> "(({left}) > ({right}))"
        .Le -> "(({left}) <= ({right}))"
        .Ge -> "(({left}) >= ({right}))"
        .Compare -> "(({left}) < ({right}) ? -1 : (({left}) > ({right}) ? 1 : 0))"
        .And -> "(({left}) && ({right}))"
        .Or -> "(({left}) || ({right}))"
    }
}

// Rust: crates/jet-codegen/src/Codegen/MIRWeb.rs:3122
fn js_panic_locals(program: &MirProgram, function: &MirFunction, context: &MirPanicContext) -> String MirWebError! {
