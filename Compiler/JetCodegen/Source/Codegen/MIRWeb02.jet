        .Fn(signature) -> signature.params.len()
        .SendFn(params, _) -> params.len()
        other -> return Err(MirWebError.InvalidMir{message: "MIR HTTP route handler has non-callable type {other.display_name()}"})
    }
    if parameter_count != handler_param_names.len() -> return Err(MirWebError.InvalidMir{message: "MIR HTTP route handler metadata has {handler_param_names.len()} names for {parameter_count} parameters"})
    if handler_param_names.iter().any(fn(name) { name.is_empty() }) -> return Err(MirWebError.InvalidMir{message: "MIR HTTP route handler metadata contains an empty parameter name"})
    // Names validate against checked callable shape; contract is transport authority.
    if location.column != 0 -> return Err(MirWebError.InvalidMir{message: "MIR HTTP router registration location has unsupported column {location.column}"})
    route := program.prelude_calls.iter().find(fn(route) { route.id == call }) ?? return Err(MirWebError.MissingPreludeCall{call: call.0})
    if route.signature.arity != 7 || route.signature.max_arity != 7 -> return Err(MirWebError.InvalidMir{message: "MIR HTTP router registration Prelude call {call.0} must have exact arity 7"})
    names := loop name in handler_param_names -> js_string(name)
    adapted_handler := "jet_http_router_handler_with_names(__jet_values.get({handler.0}), [{names.join(", ")}])"
    file :: js_source_file_path(program, location.file)
    js_prelude_call_expression(program, call, [String]{"__jet_values.get({receiver.0})", js_string(method.as_str()), "__jet_values.get({path.0})", adapted_handler, file, location.line.to_string(), js_string(contract_json)})
}

