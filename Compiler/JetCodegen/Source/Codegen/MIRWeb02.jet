            rendered := [String]{}
            loop (_, value) in args {
                text :: js_constant_expression(program, value)
                &rendered.push(text)
            }
            object := "{{ tag: {js_string(variant)}, values: [{rendered.join(", ")}] }}"
            if js_constant_type_id(program, type_name) == .Val(type_id) -> Ok("Object.defineProperty({object}, \"__jet_type\", {{ value: {js_string(type_id.0.to_string())}, enumerable: false }})") else -> Ok(object)
        }
