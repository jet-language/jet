// Rust: crates/jet-codegen/src/Codegen/MIRWeb.rs:2927
fn js_integer_constant(value: I64, width: (Bool, U8)?) -> String {
    literal := if width == { .Val((false, _)) -> U64.from_bits(value).to_string() else -> value.to_string() }
    base := "BigInt({js_string(literal)})"
    if width == {
        .Val((true, bits)) -> "BigInt.asIntN({bits}, {base})"
        .Val((false, bits)) -> "BigInt.asUintN({bits}, {base})"
        None -> base
    }
}

// Rust: crates/jet-codegen/src/Codegen/MIRWeb.rs:2944
// Exact key, else a unique display name; ambiguous names never borrow identity.
fn js_constant_type_id(program: &MirProgram, type_name: String) -> MirTypeId? {
    if program.types.iter().find(fn(type_def) { type_def.key == type_name }) == .Val(type_def) -> return Val(type_def.id)
    named := program.types.iter().filter(fn(type_def) { type_def.name == type_name })
    type_def := &named.next() ?? return None
    if &named.next() == None -> Val(type_def.id) else -> None
}

// Rust: crates/jet-codegen/src/Codegen/MIRWeb.rs:2956
fn js_constant_expression(program: &MirProgram, constant: &MirConstant) -> String MirWebError! {
    if constant == {
        .Int(value, width, _) -> Ok(js_integer_constant(value, width))
        .Float(value, is_f32, _) -> Ok(if is_f32 -> "{F32.from_f64(value):?}" else -> "{value:?}")
