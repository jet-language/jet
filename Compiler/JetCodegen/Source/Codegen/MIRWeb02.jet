            Ok("new Uint8Array([{rendered.join(", ")}])")
        }
        .Unit -> Ok("undefined")
        .BigInt(value) -> Ok("BigInt({js_string(value)})")
        .List(values) -> {
            rendered := [String]{}
            loop value in values {
                text :: js_constant_expression(program, value)
                &rendered.push(text)
            }
            Ok("[{rendered.join(", ")}]")
        }
        .Map(values) -> {
            rendered := [String]{}
            loop (key, value) in values {
                key_text :: js_const_key_expression(key)
                value_text :: js_constant_expression(program, value)
                &rendered.push("[{key_text}, {value_text}]")
            }
            Ok("new Map([{rendered.join(", ")}])")
        }
        .Struct(type_name, fields) -> {
            rendered := [String]{}
            loop (name, value) in fields {
                text :: js_constant_expression(program, value)
                &rendered.push("{js_string(name)}: {text}")
            }
            object := "{{ {rendered.join(", ")} }}"
            if js_constant_type_id(program, type_name) == .Val(type_id) -> Ok("Object.defineProperty({object}, \"__jet_type\", {{ value: {js_string(type_id.0.to_string())}, enumerable: false }})") else -> Ok(object)
        }
