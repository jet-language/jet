use jet_foundation.MIR.[MirProgram, MirFunction, MirType, MirTypeKind, MirOperation, MirAccess, MirPlaceBase, MirProjection, MirPlace, MirPlaceId, MirLocalId, MirValueId, MirOwnershipMode, MirPayloadKind, MirPreludeCallId, MirPanicLoc, MirPanicContext, MirConstant, MirConstKey, MirUnaryOp, MirBinaryOp, MirCallee, MirCaptureOperand, MirCoreClosureKind, MirGcEditKind, MirStringPart, MirTextHoleKind, MirHttpMethod, MirVariantPayload, MirBinaryDispatch, MirConversion]
use jet_foundation.TestingHistory.[HistoryProvenance]
use jet_foundation.MIR.[MirBlockId, MirTypeId, MirTypeDefKind, MirCopyFact, MirConstReport, MirSiteId, MirFieldId, MirGcEditSiteId, mir_view_copy_kind]
use jet_foundation.Syntax.[TypedHeadKind]

// Rust: crates/jet-codegen/src/Codegen/MIRWeb.rs:1750
fn emit_js_function(out: &String, program: &MirProgram, function: &MirFunction, live_values_enabled: Bool, history_provenance: &HistoryProvenance) MirWebError! {
    _ :: validate_function_blocks(function)
    _ :: validate_capture_params(program, function)
    if function.generator == .Val(generator) {
        if generator.item.identity == .Val(type_id) -> _ :: ensure_type_instance(program, type_id)
    }
    has_transaction := web_transaction_function(function)
    (source_file, source_line, source_text) :: js_function_stack_context(program, function)
    function_name := js_string(function.name)
    function_keyword := if function.generator != None -> "function*" else if web_function_is_async(program, function.id) -> "async function" else -> "function"
    &out.push_str("{function_keyword} jet_fn_{function.id.0}(__jet_env, __jet_args) {{\n")
    &out.push_str("  const __jet_stack_frame = jet_stack_enter({source_file}, {source_line}, {function_name}, {source_text});\n")
    &out.push_str("  try {{\n")
    &out.push_str("  const __jet_values = new Map();\n  const __jet_cells = new Map();\n  const __jet_places = new Map();\n  const __jet_transactions = [];\n  const __jet_moved = Symbol.for(\"jet.moved\");\n  let __jet_break_value;\n")
    loop place in function.places {
        if place.base == { .Local(_) -> true else -> false } {
            &out.push_str("  __jet_places.set({place.id.0}, {{ value: undefined }});\n")
        }
    }
    &out.push_str("  let __jet_block = {function.entry.0};\n  let __jet_pred = 0;\n")
    &out.push_str("  for (;;) {{\n    switch (__jet_block) {{\n")
    blocks := function.blocks.iter().collect()
    &blocks.sort_by_key(fn(block) { block.id })
    loop block in blocks {
        &out.push_str("      case {block.id.0}: {{\n")
        loop instruction in block.instructions {
            expression :: js_operation_expression(program, function, instruction.operation, instruction.ty, history_provenance)
            if instruction.result == .Val(result) {
                &out.push_str("        __jet_values.set({result.0}, {expression});\n")
                if instruction.operation == {
                    .Capture(slot) -> {
                        cell := if function.capture_params[slot].access == {
                            .Read | .Write -> "__jet_env[{slot}]"
                            .Move -> "{{ get value() {{ return __jet_env[{slot}]; }}, set value(value) {{ __jet_env[{slot}] = value; }} }}"
                        }
                        &out.push_str("        __jet_cells.set({result.0}, {cell});\n")
                    }
                    .Parameter(index, _) -> {
                        if function.places.iter().any(fn(place) {
                            if place.base == {
                                .Parameter(value) | .Capture(value) | .Temporary(value) -> value == result
                                .Local(_) | .Static(_) -> false
                            }
                        }) {
                            param := function.params.iter().find(fn(param) { param.index == index }) ?? return Err(MirWebError.InvalidMir{message: "MIR parameter index {index} is missing from function {function.id.0}"})
                            cell := if param.access == MirAccess.Write -> "{{ get value() {{ return __jet_args[{index}]; }}, set value(value) {{ __jet_args[{index}] = value; }} }}" else -> "{{ value: __jet_values.get({result.0}) }}"
                            &out.push_str("        __jet_cells.set({result.0}, {cell});\n")
                        }
                    }
                    else -> {
                        if function.places.iter().any(fn(place) {
                            if place.base == {
                                .Parameter(value) | .Capture(value) | .Temporary(value) -> value == result
                                .Local(_) | .Static(_) -> false
                            }
                        }) -> &out.push_str("        __jet_cells.set({result.0}, {{ value: __jet_values.get({result.0}) }});\n")
                    }
                }
            } else -> &out.push_str("        void ({expression});\n")
            update :: js_persist_live_value_update(program, function, instruction.operation, live_values_enabled)
            if update == .Val(line) -> &out.push_str("        {line}\n")
        }
        _ :: emit_js_terminator(&out, function, block)
        &out.push_str("      }}\n")
    }
    &out.push_str("      default: throw new Error(\"invalid MIR block\");\n}}\n}}\n}} finally {{\n")
    if has_transaction && function.generator == None {
        &out.push_str("         for (let __jet_transaction_index = __jet_transactions.length - 1; __jet_transaction_index >= 0; __jet_transaction_index -= 1) {{\nawait __jet_transactions[__jet_transaction_index].rollback();\n}}\n")
    }
    &out.push_str("         jetDom.exitRenderScope();\njet_stack_leave(__jet_stack_frame);\n}}\n}}\n")
    Ok(())
}

// Rust: crates/jet-codegen/src/Codegen/MIRWeb.rs:1888
fn js_persist_type_renderable(ty: &MirType) -> Bool {
    if ty.kind() == {
        .Int | .Float | .Bool | .String | .Char | .IntN(_, _) | .Float32 | .Measure(_) -> true
        .InlineRange(base, _, _) | .Tagged(_, base) | .Quantity(_, base) -> js_persist_type_renderable(base)
        else -> false
    }
}

// Rust: crates/jet-codegen/src/Codegen/MIRWeb.rs:1905
fn js_persist_live_value_update(program: &MirProgram, function: &MirFunction, operation: &MirOperation, live_values_enabled: Bool) -> String? MirWebError! {
    if !live_values_enabled -> return Ok(None)
    place_id := if operation == { .WritePlace(place, _) -> place else -> return Ok(None) }
    place := function.places.iter().find(fn(candidate) { candidate.id == place_id }) ?? return Err(MirWebError.InvalidMir{message: "Web MIR place {place_id.0} is missing"})
    key := place.persist_key ?? return Ok(None)
    rendered := "null"
    if js_persist_type_renderable(place.ty) {
        value :: js_read_place_expression(program, function, place.id)
        rendered = "String({value})"
    }
    Ok(Val("jetDom.publishLiveValueUpdate({js_string(key)}, {js_string(place.ty.canonical_key())}, {rendered});"))
}

// Rust: crates/jet-codegen/src/Codegen/MIRWeb.rs:1943
fn js_move_place_expression(program: &MirProgram, function: &MirFunction, place_id: MirPlaceId) -> String MirWebError! {
    place := function.places.iter().find(fn(candidate) { candidate.id == place_id }) ?? return Err(MirWebError.InvalidMir{message: "Web MIR place {place_id.0} is missing"})
    if place.access != MirAccess.Move -> return Err(MirWebError.InvalidMir{message: "Web MIR MovePlace {place_id.0} does not have move access"})
    cell :: js_place_cell_expression(program, function, place_id)
    Ok("(() => {{ const cell = {cell}; const moved = cell.value; cell.value = __jet_moved; return moved; }})()")
}

// Rust: crates/jet-codegen/src/Codegen/MIRWeb.rs:1966
fn js_move_value_expression(value: MirValueId) -> String {
    "(() => {{ const moved = __jet_values.get({value.0}); __jet_values.set({value.0}, __jet_moved); const cell = __jet_cells.get({value.0}); if (cell) cell.value = __jet_moved; return moved; }})()"
}

// Rust: crates/jet-codegen/src/Codegen/MIRWeb.rs:1973
fn js_value_transfer_expression(program: &MirProgram, function: &MirFunction, value: MirValueId) -> String MirWebError! {
    row := function.values.iter().find(fn(row) { row.0 == value }) ?? return Err(MirWebError.InvalidMir{message: "MIR value {value.0} is missing from function {function.id.0}"})
    if row.3.mode == {
        .Owned | .Move -> Ok(js_move_value_expression(value))
        .Copy | .Shared | .ReadBorrow | .WriteBorrow -> {
            ty :: mir_function_value_type(function, value)
            Ok(js_copy_expression(program, ty, "__jet_values.get({value.0})"))
        }
    }
}

// Rust: crates/jet-codegen/src/Codegen/MIRWeb.rs:2001
fn js_local_place_id(function: &MirFunction, local: MirLocalId) -> MirPlaceId MirWebError! {
    candidate := function.locals.iter().find(fn(candidate) { candidate.id == local }) ?? return Err(MirWebError.InvalidMir{message: "Web MIR local {local.0} has no place"})
    Ok(candidate.place)
}

// Rust: crates/jet-codegen/src/Codegen/MIRWeb.rs:2015
fn js_place_source(base: &MirPlaceBase) -> MirValueId? {
    if base == {
        .Parameter(value) | .Capture(value) | .Temporary(value) -> Val(value)
        .Local(_) | .Static(_) -> None
    }
}

// Rust: crates/jet-codegen/src/Codegen/MIRWeb.rs:2024
fn js_place_root_value_expression(program: &MirProgram, function: &MirFunction, place: &MirPlace) -> String MirWebError! {
    if place.base == {
        .Parameter(value) | .Capture(value) | .Temporary(value) -> Ok("__jet_cells.get({value.0})?.value")
        .Local(local) -> {
            local_place :: js_local_place_id(function, local)
            Ok("__jet_places.get({local_place.0})?.value")
        }
        .Static(name) -> Ok("globalThis[{js_string(name)}]")
    }
}

// Rust: crates/jet-codegen/src/Codegen/MIRWeb.rs:2044
fn js_place_cell_expression(program: &MirProgram, function: &MirFunction, place_id: MirPlaceId) -> String MirWebError! {
    place := function.places.iter().find(fn(place) { place.id == place_id }) ?? return Err(MirWebError.InvalidMir{message: "Web MIR place {place_id.0} is missing"})
    if place.projections.is_empty() {
        if js_place_source(place.base) == .Val(source) -> return Ok("__jet_cells.get({source.0})")
        if place.base == .Local(local) {
            local_place :: js_local_place_id(function, local)
            return Ok("__jet_places.get({local_place.0})")
        }
    }
    read :: js_read_place_storage_expression(program, function, place_id)
    write :: js_write_place_expression(program, function, place_id, "value")
    Ok("(() => {{ const cell = {{}}; Object.defineProperty(cell, \"value\", {{ get: () => {read}, set: value => {{ void {write}; }} }}); return cell; }})()")
}

// Rust: crates/jet-codegen/src/Codegen/MIRWeb.rs:2071
fn js_read_place_expression(program: &MirProgram, function: &MirFunction, place_id: MirPlaceId) -> String MirWebError! {
    place := function.places.iter().find(fn(place) { place.id == place_id }) ?? return Err(MirWebError.InvalidMir{message: "Web MIR place {place_id.0} is missing"})
    storage :: js_read_place_storage_expression(program, function, place_id)
    Ok(js_copy_expression(program, place.ty, storage))
}

// Rust: crates/jet-codegen/src/Codegen/MIRWeb.rs:2087
fn js_read_place_storage_expression(program: &MirProgram, function: &MirFunction, place_id: MirPlaceId) -> String MirWebError! {
    place := function.places.iter().find(fn(place) { place.id == place_id }) ?? return Err(MirWebError.InvalidMir{message: "Web MIR place {place_id.0} is missing"})
    expression :: js_place_root_value_expression(program, function, place)
    loop projection in place.projections {
        if projection == {
            .Field(field, _) -> {
                field_name :: js_field_name(program, field)
                expression = "{expression}[{js_string(field_name)}]"
            }
            .Index(call, index, location, context, ..) -> expression :: js_index_expression(program, function, call, expression, "__jet_values.get({index.0})", location, context)
            .Deref(_) -> expression = "({expression}).value"
            .Payload(kind, _) -> expression = "({expression}).values[{js_payload_slot(kind)}]"
            .Range(..) -> return Err(MirWebError.InvalidMir{message: "Web MIR has no range write window lowering"})
        }
    }
    Ok(if place.projections.is_empty() -> expression else -> "__jet_places.has({place_id.0}) ? __jet_places.get({place_id.0})?.value : {expression}")
}

// Rust: crates/jet-codegen/src/Codegen/MIRWeb.rs:2143
fn js_write_place_expression(program: &MirProgram, function: &MirFunction, place_id: MirPlaceId, expression: String) -> String MirWebError! {
    place := function.places.iter().find(fn(place) { place.id == place_id }) ?? return Err(MirWebError.InvalidMir{message: "Web MIR place {place_id.0} is missing"})
    if place.projections.is_empty() {
        if js_place_source(place.base) == .Val(source) -> return Ok("(__jet_cells.get({source.0}).value = {expression}, __jet_values.set({source.0}, {expression}), undefined)")
        if place.base == .Local(local) {
            local_place :: js_local_place_id(function, local)
            return Ok("(__jet_places.get({local_place.0}).value = {expression}, undefined)")
        }
        if place.base == .Static(name) -> return Ok("(globalThis[{js_string(name)}] = {expression}, undefined)")
    }
    target :: js_place_root_value_expression(program, function, place)
    js_write_projected_place_expression(program, function, target, place.projections, expression)
}

// Rust: crates/jet-codegen/src/Codegen/MIRWeb.rs:2179
fn js_write_projected_place_expression(program: &MirProgram, function: &MirFunction, target: String, projections: &[MirProjection], expression: String) -> String MirWebError! {
    if projections.is_empty() -> return Ok("({target} = {expression}, undefined)")
    projection := projections[0]
    rest := projections[1..<projections.len()]
    if projection == {
        .Field(field, _) -> {
            name :: js_field_name(program, field)
            js_write_projected_place_expression(program, function, "{target}[{js_string(name)}]", rest, expression)
        }
        .Index(index, call, write_call, location, context, ..) -> {
            setter_call := write_call ?? return Err(MirWebError.InvalidMir{message: "Web write index projection has no exact setter Prelude row"})
            index_expr := "__jet_values.get({index.0})"
            if rest.is_empty() -> return js_index_write_expression(program, setter_call, target, index_expr, expression, location, context)
            read :: js_index_expression(program, function, call, "__jet_index_base", index_expr, location, context)
            nested :: js_write_projected_place_expression(program, function, "__jet_index_value", rest, expression)
            setter :: js_index_write_expression(program, setter_call, "__jet_index_base", index_expr, "__jet_index_value", location, context)
            Ok("(() => {{ const __jet_index_base = {target}; const __jet_index_value = {read}; void ({nested}); return {setter}; }})()")
        }
        .Deref(_) -> js_write_projected_place_expression(program, function, "({target}).value", rest, expression)
        .Payload(kind, _) -> js_write_projected_place_expression(program, function, "({target}).values[{js_payload_slot(kind)}]", rest, expression)
        .Range(..) -> Err(MirWebError.InvalidMir{message: "Web MIR has no range write window lowering"})
    }
}

// Rust: crates/jet-codegen/src/Codegen/MIRWeb.rs:2272
// The values slot a Payload projection names in a JS variant carrier.
fn js_payload_slot(kind: &MirPayloadKind) -> Int {
    if kind == {
        .Option | .Result(_) -> 0
        .Enum(_, index) -> index
    }
}

// Rust: crates/jet-codegen/src/Codegen/MIRWeb.rs:2280
fn js_index_write_expression(program: &MirProgram, call: MirPreludeCallId, base: String, index: String, written: String, location: MirPanicLoc, context: MirPanicContext?) -> String MirWebError! {
    route := program.prelude_calls.iter().find(fn(route) { route.id == call }) ?? return Err(MirWebError.MissingPreludeCall{call: call.0})
    if route.signature.max_arity != route.signature.arity -> return Err(MirWebError.InvalidMir{message: "MIR indexed setter Prelude call {call.0} does not have an exact arity"})
    args := [String]{base, index, written}
    if route.signature.arity == {
        3 -> {}
        5 -> {
            file :: js_source_file_path(program, location.file)
            &args.push(file)
            &args.push(location.line.to_string())
        }
        7 -> {
            checked := context ?? return Err(MirWebError.InvalidMir{message: "MIR indexed setter Prelude call {call.0} requires checked context"})
            file :: js_source_file_path(program, location.file)
            &args.push(file)
            &args.push(location.line.to_string())
            &args.push(js_string(checked.function))
            &args.push(js_string(checked.source_line))
        }
        arity -> return Err(MirWebError.InvalidMir{message: "MIR indexed setter Prelude call {call.0} has unsupported arity {arity}"})
    }
    js_prelude_call_expression(program, call, args)
}

// Rust: crates/jet-codegen/src/Codegen/MIRWeb.rs:2326
fn js_index_context(_program: &MirProgram, _function: &MirFunction, _location: MirPanicLoc, context: MirPanicContext?) -> (String, String) MirWebError! {
    checked := context ?? return Err(MirWebError.InvalidMir{message: "MIR index Prelude call requires checked context"})
    Ok((js_string(checked.function), js_string(checked.source_line)))
}

// Rust: crates/jet-codegen/src/Codegen/MIRWeb.rs:2343
fn js_index_expression(program: &MirProgram, function: &MirFunction, call: MirPreludeCallId, base: String, index: String, location: MirPanicLoc, context: MirPanicContext?) -> String MirWebError! {
    route := program.prelude_calls.iter().find(fn(route) { route.id == call }) ?? return Err(MirWebError.MissingPreludeCall{call: call.0})
    if route.signature.max_arity != route.signature.arity -> return Err(MirWebError.InvalidMir{message: "MIR index Prelude call {call.0} does not have an exact arity"})
    file :: js_source_file_path(program, location.file)
    args := [String]{base, index, file, location.line.to_string()}
    if route.signature.arity == {
        4 -> {}
        6 -> {
            (function_name, source_line) :: js_index_context(program, function, location, context)
            &args.push(function_name)
            &args.push(source_line)
        }
        8 -> {
            (function_name, source_line) :: js_index_context(program, function, location, context)
            checked := context ?? return Err(MirWebError.InvalidMir{message: "MIR index Prelude call {call.0} requires checked context"})
            &args.push(function_name)
            &args.push(source_line)
            &args.push(location.column.to_string())
            &args.push(checked.caret.to_string())
        }
        arity -> return Err(MirWebError.InvalidMir{message: "MIR index Prelude call {call.0} has unsupported arity {arity}"})
    }
    js_prelude_call_expression(program, call, args)
}

// Rust: crates/jet-codegen/src/Codegen/MIRWeb.rs:2398
fn js_capture_rvalue_expression(function: &MirFunction, slot: Int) -> String MirWebError! {
    capture := function.capture_params.get(slot) ?? return Err(MirWebError.InvalidMir{message: "MIR capture slot {slot} is missing"})
    Ok(if capture.access == {
        .Read | .Write -> "__jet_env[{slot}].value"
        .Move -> "__jet_env[{slot}]"
    })
}

// Rust: crates/jet-codegen/src/Codegen/MIRWeb.rs:2413
fn js_operation_expression(program: &MirProgram, function: &MirFunction, operation: &MirOperation, result_type: MirType?, history_provenance: &HistoryProvenance) -> String MirWebError! {
    value := fn(id: MirValueId) -> String { "__jet_values.get({id.0})" }
    expression := if operation == {
        .Parameter(index, _) -> {
            param := function.params.iter().find(fn(param) { param.index == index }) ?? return Err(MirWebError.InvalidMir{message: "MIR parameter index {index} is missing from function {function.id.0}"})
            expression := "__jet_args[{index}]"
            if param.access == MirAccess.Move -> expression else if result_type == .Val(ty) -> js_copy_expression(program, ty, expression) else -> expression
        }
        .Capture(slot) -> {
            capture := function.capture_params.get(slot) ?? return Err(MirWebError.InvalidMir{message: "MIR capture slot {slot} is missing"})
            expression :: js_capture_rvalue_expression(function, slot)
            if capture.access == MirAccess.Move -> expression else if result_type == .Val(ty) -> js_copy_expression(program, ty, expression) else -> expression
        }
        .Global(name) -> if name == {
            "transaction" -> "(() => {{ const __jet_transaction = jet_transaction(); __jet_transactions.push(__jet_transaction); return __jet_transaction; }})()"
            "stm" -> "jet_stm_begin()"
            else -> {
                row := program.constants.iter().find(fn(constant) { constant.key == name })
                key := if row == .Val(constant) -> constant.key else -> name
                "globalThis[{js_string(key)}]"
            }
        }
        .Phi(incoming) -> { expression :: js_phi_expression(program, function, incoming); expression }
        .ReadPlace(place) -> { expression :: js_read_place_expression(program, function, place); expression }
        .MovePlace(place) -> { expression :: js_move_place_expression(program, function, place); expression }
        .InitializeUninit(place) -> {
            place_row := function.places.iter().find(fn(candidate) { candidate.id == place }) ?? return Err(MirWebError.InvalidMir{message: "Web MIR place {place.0} is missing"})
            expression := if place_row.ty.kind() == {
                .FixedList(_, len) -> {
                    length := len.literal_value() ?? return Err(MirWebError.InvalidMir{message: "Web MIR uninitialized fixed-list place {place.0} has no static length"})
                    "Array({length}).fill(undefined)"
                }
                else -> "undefined"
            }
            written :: js_write_place_expression(program, function, place, expression)
            written
        }
        .WritePlace(place, id) | .ReplacePlace(place, id) -> {
            transferred :: js_value_transfer_expression(program, function, id)
            written :: js_write_place_expression(program, function, place, transferred)
            written
        }
        .Copy(id, fact) -> {
            ty :: mir_function_value_type(function, id)
            if fact == MirCopyFact.ViewMaterialize {
                kind := mir_view_copy_kind(ty) ?? return Err(MirWebError.InvalidMir{message: "MIR view materialization source `{ty.display_name()}` has no canonical copy kernel"})
                if result_type == .Val(target) {
                    if !kind.target_matches(target) -> return Err(MirWebError.InvalidMir{message: "MIR view materialization `{kind.symbol()}` has destination `{target.display_name()}`"})
                }
                "{kind.symbol()}({value(id)})"
            } else -> js_copy_expression(program, ty, value(id))
        }
        .Move(id) | .TraitBox(id, _) -> js_move_value_expression(id)
        .Constant(constant) -> { rendered :: js_constant_expression(program, constant); rendered }
        .Unary(op, id) -> js_unary_expression(op, value(id))
        .Binary(op, dispatch, left, right) -> {
            args := [String]{value(left), value(right)}
            if dispatch == .Prelude(_, .Val(location)) {
                file :: js_source_file_path(program, location.file)
                &args.push(file)
                &args.push(location.line.to_string())
            }
            if dispatch == {
                .Primitive -> js_binary_expression(op, value(left), value(right))
                .Prelude(call, _) -> { rendered :: js_prelude_call_expression(program, call, args); rendered }
            }
        }
        .BuildString(parts) -> {
            rendered := loop part in parts -> js_string_part(part)
            "[{rendered.join(", ")}].join(\"\")"
        }
        .BuildList(ids, _) -> {
            rendered := loop id in ids -> js_move_value_expression(id)
            "[{rendered.join(", ")}]"
        }
        .BuildMap(entries) -> {
            rendered := loop (key, id) in entries -> "[{js_move_value_expression(key)}, {js_move_value_expression(id)}]"
            "new Map([{rendered.join(", ")}])"
        }
        .EnumIs(subject, owner, variant) -> {
            _ :: ensure_enum_variant(program, owner, variant, None)
            "{value(subject)}?.tag === {js_string(variant)}"
        }
        .EnumPayload(subject, owner, variant, index) -> {
            _ :: ensure_enum_variant(program, owner, variant, Val(index))
            expression := "{value(subject)}?.tag === {js_string(variant)} ? {value(subject)}?.values[{index}] : undefined"
            if result_type == .Val(ty) -> js_copy_expression(program, ty, expression) else -> expression
        }
        .OptionIsSome(subject) | .ResultIsOk(subject) | .PatternMatched(subject) -> "{value(subject)}?.tag === \"Ok\""
        .OptionValue(subject) -> "(() => {{ const carrier = {js_move_value_expression(subject)}; if (carrier?.tag !== \"Ok\") throw new Error(\"MIR option payload missing\"); return carrier.values[0]; }})()"
        .ResultValue(subject, ok) -> {
