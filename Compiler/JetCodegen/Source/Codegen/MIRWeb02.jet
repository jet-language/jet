        .Realtime -> {
            if values.len() != 2 -> return Err(wrong_arity("two realtime parameters"))
            callback :: required_closure()
            [String]{value(values[0]), value(values[1]), callback}
        }
        .Serve -> {
            if values.len() != 1 -> return Err(wrong_arity("one address"))
            callback :: required_closure()
            [String]{value(values[0]), callback}
        }
        .OnInterrupt -> {
            _ :: no_closure()
            if values.len() != 1 -> return Err(wrong_arity("one callback"))
            [String]{value(values[0])}
        }
        .Guard -> {
            if !values.is_empty() -> return Err(wrong_arity("no value operands"))
            callback :: required_closure()
            [String]{callback}
        }
        .OnCommit | .OnRollback -> {
            if values.len() != 1 -> return Err(wrong_arity("one transaction handle"))
            callback :: required_closure()
            [String]{value(values[0]), callback}
        }
        .ReactiveDerived | .ReactiveEffect | .UiMount -> {
            if !values.is_empty() -> return Err(wrong_arity("no value operands"))
            callback :: required_closure()
            [String]{callback}
        }
        .UiPreview(_, _, _, _, _, _, _, _) -> {
            if values.len() != 2 -> return Err(wrong_arity("name and viewport"))
            callback :: required_closure()
            [String]{value(values[0]), value(values[1]), callback}
        }
        .UiAction -> {
            if values.len() != 3 -> return Err(wrong_arity("display, shortcut, and accessible label"))
            callback :: required_closure()
            [String]{value(values[0]), value(values[1]), value(values[2]), callback}
        }
        .UiTextInputOnDrop -> {
            if values.len() != 2 -> return Err(wrong_arity("state and IME mode"))
            callback :: required_closure()
            [String]{value(values[0]), value(values[1]), callback}
        }
    }
    emitted :: js_prelude_call_expression(program, call, args)
    if preview_source == .Val((source_file, start_line, start_column, end_line, end_column, build_id, revision)) {
        return Ok("jet_ui_preview_attach_compiler_source({emitted}, {js_string(source_file)}, {js_string(source_file)}, {js_string(build_id)}, {js_string(revision)}, {start_line}, {start_column}, {end_line}, {end_column})")
    }
    Ok(emitted)
}

