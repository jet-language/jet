fn js_gc_edit_expression(program: &MirProgram, call: MirPreludeCallId, root: MirValueId, edges: &[MirValueId], edit: MirValueId, index: MirValueId?, kind: MirGcEditKind, site: MirGcEditSiteId) -> String MirWebError! {
