fn js_typed_text_interp_expression(program: &MirProgram, call: MirPreludeCallId, kind: TypedHeadKind, literals: &[String], holes: &[MirValueId], trusted_html: &[Bool]) -> String MirWebError! {
    if literals.len() != holes.len().saturating_add(1) -> return Err(MirWebError.InvalidMir{message: "MIR typed text interpolation literal/hole arity is inconsistent"})
    if trusted_html.len() != holes.len() -> return Err(MirWebError.InvalidMir{message: "MIR typed text interpolation trust metadata is inconsistent"})
    if kind != TypedHeadKind.HTML && trusted_html.iter().any(fn(trusted) { trusted }) -> return Err(MirWebError.InvalidMir{message: "non-HTML typed text interpolation carries HTML trust metadata"})
    rendered_literals := loop literal in literals -> js_string(literal)
    rendered_holes := loop id in holes -> "__jet_values.get({id.0})"
    literal_values := "[{rendered_literals.join(", ")}]"
    hole_values := "[{rendered_holes.join(", ")}]"
    args := [String]{literal_values, hole_values}
    if kind == TypedHeadKind.HTML {
        trusted := loop item in trusted_html -> item.to_string()
        &args.push("[{trusted.join(", ")}]")
    }
    js_prelude_call_expression(program, call, args)
}

