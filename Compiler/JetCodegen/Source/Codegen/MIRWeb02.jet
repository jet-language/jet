fn js_http_router_register_expression(program: &MirProgram, function: &MirFunction, call: MirPreludeCallId, receiver: MirValueId, path: MirValueId, handler: MirValueId, method: MirHttpMethod, handler_param_names: &[String], contract_json: String, location: MirPanicLoc) -> String MirWebError! {
