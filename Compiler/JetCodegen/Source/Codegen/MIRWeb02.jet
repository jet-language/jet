fn js_core_closure_call_expression(program: &MirProgram, call: MirPreludeCallId, kind: MirCoreClosureKind, values: &[MirValueId], closure: MirValueId?, site: MirSiteId, label: String) -> String MirWebError! {
    preview_source := if kind == {
        .UiPreview(source_file, source_start_line, source_start_column, source_end_line, source_end_column, build_id, revision, _) -> Val((source_file, source_start_line, source_start_column, source_end_line, source_end_column, build_id, revision))
