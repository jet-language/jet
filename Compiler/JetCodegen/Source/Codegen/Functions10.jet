//RS /// c109 Phase 11: a resolved closure-taking collection-method op, one per
//RS /// built-in collection-method closure arm. The
//RS /// receiver-type branch (Map vs list vs trait-object list) and the Fn-vs-FnMut
//RS /// branch (off the lambda arg's `needs_fn_mut` meta) are decided ONCE at lowering;
//RS /// the variant encodes the chosen form so emit only formats.
//RS // Debug names the variant in engine rejection text: a JIT refusal is a silent
//RS // interpreter deopt, so the message must say WHICH closure method was refused.
//RS #[derive(Debug, Clone)]
//RS pub enum TClosureOp {
//RS     /// Prove two indexes before lending their mutable views to one callback.
//RS     EditDisjoint,
//RS     /// `map` on a list — `jet_list_map((recv).clone(), f)`.
//RS     Map,
//RS     /// `map` on a list whose lambda is FnMut — `jet_list_map_mut((recv).clone(), f)`.
//RS     MapMut,
//RS     /// Fallible `map` — the callback owns the failure row and the collection
//RS     /// helper returns `Result<Collection<U>, E>`.
//RS     TryMap,
//RS     /// `filter` — `jet_list_filter((recv).clone(), f)`.
//RS     Filter,
//RS     /// Fallible `filter` — the callback returns `Result<Bool, E>` and the
//RS     /// collection helper stops at the first failure.
//RS     TryFilter,
//RS     /// `each` on a list — `jet_list_each((recv).clone(), f)`.
//RS     Each,
//RS     /// `each` on a list whose lambda is FnMut — `jet_list_each_mut((recv).clone(), f)`.
//RS     EachMut,
//RS     /// `each` on a list of trait objects — `jet_list_each_ref(&(recv), f)`.
//RS     EachRef,
//RS     /// `each` on a map — `jet_map_each((recv).clone(), f)`.
//RS     EachMap,
//RS     MapAny,
//RS     MapAll,
//RS     MapFilter,
//RS     MapMap,
//RS     MapFold,
//RS     MapFlatMap,
//RS     ListBinarySearchBy,
//RS     ListMinMaxBy {
//RS         tuple_struct: String,
//RS     },
//RS     /// `find` — `jet_list_find((recv).clone(), f)`.
//RS     Find,
//RS     /// `any` — `jet_list_any((recv).clone(), f)`.
//RS     Any,
//RS     /// `any` on `Tally<T>` — `(recv).keys().any(f)`.
//RS     BagAny,
//RS     /// `all` — `jet_list_all((recv).clone(), f)`.
//RS     All,
//RS     /// `count_where(f)` — `jet_list_count_where(&(recv), f)`.
//RS     CountWhere,
//RS     /// `sort_by` — `{ jet_list_sort_by(&mut recv, f); }`.
//RS     SortBy,
//RS     /// `sort_by_desc` — `{ jet_list_sort_by_desc(&mut recv, f); }`.
//RS     SortByDesc,
//RS     /// Fallible `sort_by` — the callback keys are collected before the list moves.
//RS     TrySortBy,
//RS     /// Fallible `sort_by_desc` — the callback keys are collected before the list moves.
//RS     TrySortByDesc,
//RS     /// `sort_by` with a binary `T -> T -> Ordering` comparator.
//RS     SortByCompare,
//RS     /// `reduce` — `jet_list_reduce((recv).clone(), seed, f)`.
//RS     Reduce,
//RS     // D-ITER1 / D-CORE-EAGER2=A: receiver-sensitive adapter closure methods.
//RS     /// `take_while(f)` — `jet_list_take_while((recv).clone(), f)`.
//RS     TakeWhile,
//RS     /// `skip_while(f)` — `jet_list_skip_while((recv).clone(), f)`.
//RS     SkipWhile,
//RS     /// `flat_map(f)` — eager for List, lazy for Iter; emitter selects the kernel.
//RS     FlatMap,
//RS     /// `scan(seed, f)` — `jet_list_scan((recv).clone(), seed, f)`.
//RS     Scan,
//RS     /// `position(f)` — `jet_list_position((recv).clone(), f)`.
//RS     Position,
//RS     /// `min_by(f)` — `jet_list_min_by((recv).clone(), f)`.
//RS     MinBy,
//RS     /// `max_by(f)` — `jet_list_max_by((recv).clone(), f)`.
//RS     MaxBy,
//RS     /// `fold(init, (acc: F32|F64, item: F32|F64) => acc + item)` with a fixed
//RS     /// scalar addition kernel selected by checked lowering. `f32` records the
//RS     /// checked lane type for target-specific marshaling.
//RS     FloatAddFold {
//RS         f32: bool,
//RS     },
//RS     /// `para_fold(seed, (acc: F32|F64, item: F32|F64) => acc + item)` with a
//RS     /// fixed scalar addition kernel selected by checked lowering.
//RS     FloatAddParaFold {
//RS         f32: bool,
//RS     },
//RS     /// `fold(init, f)` — `jet_list_fold((recv).clone(), init, f)`.
//RS     Fold,
//RS     GroupBy,
//RS     /// `count_by(f)` — `jet_list_count_by((recv).clone(), f)`.
//RS     CountBy,
//RS     /// `update_first(f, replacement)` — `jet_list_update_first(&mut recv, f, replacement)`.
//RS     UpdateFirst,
//RS     /// `partition(f)` — inline emit; struct name embedded. `TupleStruct` is `JetTup_<hash>`.
//RS     Partition {
//RS         tuple_struct: String,
//RS     },
//RS     // #1479
//RS     /// `dedup_by(f)` — `jet_iter_dedup_by({as_iter}, f)`.
//RS     DedupBy,
//RS     /// `is_sorted_by(f)` — `jet_iter_is_sorted_by({as_iter}, f)`.
//RS     IsSortedBy,
//RS     /// `chunk_while(f)` — `jet_iter_chunk_while({as_iter}, f)`.
//RS     ChunkWhile,
//RS     // D-FAILCOMP1: failure-aware adapters.
//RS     /// `filter_map(f)` — `jet_list_filter_map_iter((recv).clone(), f)`.
//RS     FilterMap,
//RS     // D-PARCAPTURE1=D: explicit `para_` adapters.
//RS     ParaMap,
//RS     ParaFilter,
//RS     ParaPartition {
//RS         tuple_struct: String,
//RS     },
//RS     ParaFold,
//RS     // D-HOLE1: Option combinators.
//RS     /// `map` on `?T` — `(recv).as_ref().map(f)` (Rust's native `Option::map`, no
//RS     /// prelude helper needed; `.as_ref()` supplies plain callback read access).
//RS     OptionMap,
//RS     // D-DYNARRAY1: `View<T>` read-only closure methods. `recv` is already a
//RS     // `&[T]` borrow (see `Context::rust_type`'s `View` arm) — NOT `.clone()`d
//RS     // into an owned `Vec` first, unlike every list closure op above; that
//RS     // clone would silently defeat the zero-copy point of `.view(...)`.
//RS     /// `view.fold(init, f)` — `jet_view_fold((recv), init, f)`.
//RS     ViewFold,
//RS     /// `view.map(f)` — `jet_view_map((recv), f)` (map-to-owned: returns `[R]`).
//RS     ViewMap,
//RS }
