//RS     },
//RS     RegisterWrite {
//RS         profile_id: String,
//RS         block: String,
//RS         register: String,
//RS         width: jet_foundation::TargetMachine::RegisterWidth,
//RS     },
//RS     DmaStart {
//RS         profile_id: String,
//RS         channel: String,
//RS         buffer_ty: Type,
//RS     },
//RS     DmaWait {
//RS         profile_id: String,
//RS         channel: String,
//RS         buffer_ty: Type,
//RS     },
//RS }
