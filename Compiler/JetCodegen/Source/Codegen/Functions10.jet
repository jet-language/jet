// Rust: crates/jet-codegen/src/Codegen/TIR/mod.rs:12997
// TTryConvert -> Foundation TIR:1504; Rust None is canonical NoConversion.
// Rust: crates/jet-codegen/src/Codegen/TIR/mod.rs:13022
pub fn try_target_is_default_error(input: Type, convert: TTryConvert) -> Bool Never! {
    if convert == {
        .DefaultErr -> true
        .NoConversion -> input.unwrap_result().map(fn(pair) { pair.1 }).is_some_and(fn(error) { if error == .Named(name) -> name == TYPE_ERR else -> false })
        .Typed(_, _, target) -> if target == .Named(name) -> name == TYPE_ERR else -> false
        .Never | .WidenUnion(_, _) | .ProtocolExit -> false
    }
}
