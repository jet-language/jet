//RS /// Four closed runtime hardware operations are represented inside the existing
//RS /// handle method family so all tiers consume one checked operation node.
//RS #[derive(Clone)]
//RS pub enum THandleOp {
//RS     /// D-FOUND-BOARD1: sema-owned embedded hardware call metadata.
//RS     Hardware(THardwareCall),
//RS     /// Checked DevServer lifecycle operations use the shared Core adapter.
//RS     DevServerMethod {
//RS         method: String,
//RS     },
//RS     /// D-FOUND-RECEIPT1: typed section attachment; MIR lowers this to the
//RS     /// canonical existing CoreCall row with compiler-supplied metadata args.
//RS     ReceiptAttach,
//RS     /// D-SHAPE-DURATION1=A: checked type-owned runtime constructor.
//RS     DurationNew {
//RS         unit: &'static str,
//RS         float: bool,
//RS     },
//RS     /// FileReader: `read_line()` → `{root}jet_std_file_reader_read_line(&mut (recv))`.
//RS     FileReaderReadLine,
//RS     /// Read-only projection of the path retained by a live provider handle.
//RS     FileReaderPath,
//RS     /// D-FOUND-VIEW1=A: mapped-file byte window (`Result<View<[U8]>, IOError>`).
//RS     MappedFileWindow,
//RS     /// D-FOUND-VIEW1=A: mapped-file offset/length window.
//RS     MappedFileWindowLen,
//RS     /// D-FOUND-VIEW1=A: mapped-file line windows retaining the mapping owner.
//RS     MappedFileLines,
//RS     /// D-FOUND-VIEW1=A: mapped-file byte length.
//RS     MappedFileLen,
//RS     /// D-FOUND-VIEW1=A: mapped-file emptiness check.
//RS     MappedFileIsEmpty,
//RS     /// FileWriter: `write_line(s)` → `{root}jet_std_file_writer_write_line(&mut (recv), &(a0))`.
//RS     FileWriterWriteLine,
//RS     /// FileWriter: `flush()` → `{root}jet_std_file_writer_flush(&mut (recv))`.
//RS     FileWriterFlush,
//RS     /// Read-only projection of the path retained by a live provider handle.
//RS     FileWriterPath,
//RS     /// D-ENCSTREAM-SURFACE1=A: JSON pull reader/writer lifecycle.
//RS     JSONReaderNext,
//RS     JSONWriterWrite,
//RS     JSONWriterFlush,
//RS     JSONWriterFinish,
//RS     JSONLReaderNext,
//RS     JSONLWriterWrite,
//RS     JSONLWriterFlush,
//RS     JSONLWriterFinish,
//RS     CSVReaderNext,
//RS     /// D-DATAFLOW1=A: typed pull `DataStream<T>.next()` → `?T !DataError`.
//RS     DataStreamNext,
//RS     /// D-FOUND-COREAPI1 / #2853: shared event-time stream operators.
//RS     StreamWithEventTime,
//RS     /// DateTime callbacks cross the scalar JIT ABI as Unix nanoseconds.
//RS     StreamWithEventTimeNs,
//RS     StreamKeyBy,
//RS     StreamWindow,
//RS     XMLReaderNext,
//RS     XMLWriterWrite,
//RS     XMLWriterFlush,
//RS     XMLWriterFinish,
//RS     CSVWriterWrite,
//RS     CSVWriterFlush,
//RS     CSVWriterFinish,
//RS     CBORReaderNext,
//RS     CBORWriterWrite,
//RS     CBORWriterFlush,
//RS     CBORWriterFinish,
//RS     /// StdinHandle: `read_line()` → `{root}jet_std_io_stdin_read_line(&mut (recv))`.
//RS     StdinReadLine,
//RS     /// Stdout/Stderr: stream writes and facts (D-COREIO1=A).
//RS     StdoutWrite,
//RS     StdoutWriteLine,
//RS     StdoutWriteBytes,
//RS     StdoutFlush,
//RS     StdoutIsTty,
//RS     StderrWrite,
//RS     StderrWriteLine,
//RS     StderrWriteBytes,
//RS     StderrFlush,
//RS     StderrIsTty,
//RS     /// D-CMD-OVERRIDE1=C: `TestSuite.run()` calls the installed command runner.
//RS     TestSuiteRun,
//RS     /// D-DET1 Clock: `now()` → `{root}jet_clock_now(&(recv))` (current ms, no advance).
//RS     ClockNow,
//RS     /// D-DET1 Clock: `tick(ms)` → `{root}jet_clock_tick(&mut (recv), a0)` (advance + read).
//RS     ClockTick,
//RS     /// D-DET-CAPAPI Clock: `advance(to_ms)` → `{root}jet_clock_advance(&mut (recv), a0)` (absolute set + read).
//RS     ClockAdvance,
//RS     /// D-DET-CAPAPI Clock: `wait(d)` → `{root}jet_clock_wait(&mut (recv), &(a0))` (advance by a Duration + read).
//RS     ClockWait,
//RS     /// D-TEST-WORLD1=A: controlled world clock read in milliseconds.
//RS     WorldNow,
//RS     /// D-TEST-WORLD1=A: controlled world monotonic advance by Duration.
//RS     WorldAdvance,
//RS     /// D-TEST-WORLD1=A: drain the world scheduler to a fixed point.
//RS     WorldWaitIdle,
//RS     /// D-TEST-WORLD1=A: return the recorded deterministic execution history.
//RS     WorldHistory,
//RS     /// D-FOUND-REALTIME1=A: next absolute callback deadline.
//RS     RealtimeNextDeadline,
//RS     /// D-FOUND-REALTIME1=A: bounded callback receipt snapshot.
//RS     RealtimeReceipt,
//RS     /// D-FOUND-REALTIME1=A: cancel and join the callback worker.
//RS     RealtimeCancel,
//RS     /// D-FOUND-REALTIME1=A: cancellation state.
//RS     RealtimeIsCancelled,
//RS     /// D-DET1 Rng: `int(lo, hi)` → `{root}jet_rng_int(&mut (recv), a0, a1)` (draw in [lo,hi]).
//RS     RngInt,
//RS     /// D-DET1 Rng: `float()` → `{root}jet_rng_float(&mut (recv))` (draw in [0,1)).
//RS     RngFloat,
//RS     /// D-RANDOMDIST1 Rng: `float_range(lo, hi)` → `{root}jet_rng_float_range(&mut (recv), a0, a1)`.
//RS     RngFloatRange,
//RS     /// D-DET-CAPAPI Rng: `bool()` → `{root}jet_rng_bool(&mut (recv))` (coin draw).
//RS     RngBool,
//RS     /// D-RANDOMDIST1 Rng: `bool(p)` → `{root}jet_rng_bool_p(&mut (recv), a0)`.
//RS     RngBoolP,
//RS     /// D-RANDOMDIST1 Rng: `normal(mean, stddev)` → `{root}jet_rng_normal(&mut (recv), a0, a1)`.
//RS     RngNormal,
//RS     /// D-RANDOMDIST1 Rng: `exponential(lambda)` → `{root}jet_rng_exponential(&mut (recv), a0)`.
//RS     RngExponential,
//RS     /// D-RANDOMDIST1 Rng: `bytes(n)` → `{root}jet_rng_bytes(&mut (recv), a0)`.
//RS     RngBytes,
//RS     /// D-RANDOMDIST1 Rng: `split()` → `{root}jet_rng_split(&mut (recv))`.
//RS     RngSplit,
//RS     /// D-DET-CAPAPI Rng: `pick(list)` → `{root}jet_rng_pick(&mut (recv), &(a0))` (uniform `?T`).
//RS     RngPick,
//RS     /// D-RANDOMDIST1 Rng: `weighted_pick(list, weights)` → `{root}jet_rng_weighted_pick(&mut (recv), &(a0), &(a1))`.
//RS     RngWeightedPick,
//RS     /// D-RANDOMDIST1 Rng: `sample(list, k)` → `{root}jet_rng_sample(&mut (recv), &(a0), a1)`.
//RS     RngSample,
//RS     /// D-DET-CAPAPI Rng: `shuffle(&list)` → `{root}jet_rng_shuffle(&mut (recv), &mut (a0))` (in-place).
//RS     RngShuffle,
//RS     /// D-TEST-STRATEGY1=A HistoryRng: `next_u64()` consumes the callback RNG.
//RS     HistoryRngNextU64,
//RS     /// D-TEST-STRATEGY1=A HistoryRng: `below(bound)` consumes the callback RNG.
//RS     HistoryRngBelow,
//RS     /// D-TESTDATA1 Fake: locale and deterministic fake-data domain draws.
//RS     FakeLocale,
//RS     FakeName,
//RS     FakeEmail,
//RS     FakeHost,
//RS     FakeAddress,
