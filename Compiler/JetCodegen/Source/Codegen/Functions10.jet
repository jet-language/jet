// A single map projection preserves duplicate-effect precedence and sorted iteration without quadratic scans.
fn checked_declared_effect_facts(effects: [EffectRowEntry]?) -> TEffectFacts Never! {
    facts := TEffectFacts.default()
    if effects == .Val(rows) {
        spans := [String:Span]{}
        loop row in rows { &spans.insert(row.name.clone(), row.span) }
        names := spans.keys().cloned().collect()
        &names.sort()
        direct_spans := [TEffectSpan].with_capacity(names.len())
        loop name in names { &direct_spans.push(TEffectSpan{name: name.clone(), span: spans[name]}) }
        facts.direct = ^names
        facts.direct_spans = ^direct_spans
        facts.maximal = true
    }
    facts
}
// Rust: crates/jet-codegen/src/Codegen/TIR/mod.rs:12801
pub fn function_effect_facts(f: Func) -> TEffectFacts Never! { checked_declared_effect_facts(f.declared_effects) }
// Rust: crates/jet-codegen/src/Codegen/TIR/mod.rs:12813
pub fn lambda_effect_facts(lam: Lambda) -> TEffectFacts Never! { checked_declared_effect_facts(lam.effects) }
// Rust: crates/jet-codegen/src/Codegen/TIR/mod.rs:12824
pub fn lambda_failure_carrier(lam: Lambda) -> TFailureCarrier Never! {
    contract := if lam.error_type == .Val(error) {
        success := lam.result_type.clone().unwrap_or_else(fn() { Type.Named(INTERNAL_UNIT_TYPE.to_string()) })
        FailureContract.Explicit(success, error.clone())
    } else if lam.result_type == .Val(result) {
        failure_contract_from_return_type(Val(result))
    } else if lam.meta.fallible_carrier == .Val(carrier) {
        failure_contract_from_return_type(Val(carrier))
    } else { failure_contract_from_return_type(None) }
    TFailureCarrier.from_contract(contract)
}
// Rust: crates/jet-codegen/src/Codegen/TIR/mod.rs:12844
pub fn function_failure_carrier(f: Func) -> TFailureCarrier Never! { TFailureCarrier.from_contract(func_failure_contract(f)) }
// Rust: crates/jet-codegen/src/Codegen/TIR/mod.rs:12855
pub fn function_has_plain_return(f: Func) -> Bool Never! {
    contract := func_failure_contract(f)
    proven := contract is .ProvenUnreachable || contract is .InferredNever
    proven && f.pre.is_empty() && f.post.is_empty() && f.inline_foreign.is_none() && !f.gc_return && !f.is_job && !f.compiler_generated
}
// Rust: crates/jet-codegen/src/Codegen/TIR/mod.rs:12865
pub fn function_target_applicability(f: Func) -> TTargetApplicability Never! {
    if f.inline_foreign.is_none() -> return TTargetApplicability{rust_aot: true, cranelift: true, interpreter: true, web: true}
    foreign := f.inline_foreign.unwrap()
    language := foreign.lang.to_ascii_lowercase()
    if language == "c" || language == "cpp" || language == "c++" || language == "asm" || language == "assembly" {
        return TTargetApplicability{rust_aot: true, cranelift: true, interpreter: true, web: false}
    }
    web := foreign.lang.eq_ignore_ascii_case("js") || foreign.lang.eq_ignore_ascii_case("web")
    TTargetApplicability{rust_aot: true, cranelift: false, interpreter: false, web: web}
}
// Rust: crates/jet-codegen/src/Codegen/TIR/mod.rs:12896
pub fn function_visibility(f: Func) -> TVisibility Never! {
    if f.is_pub -> TVisibility.Public else if f.is_package_pub -> TVisibility.Package else -> TVisibility.Private
}
// Rust: crates/jet-codegen/src/Codegen/TIR/mod.rs:12906
pub fn function_foreign_provenance(f: Func) -> TForeignProvenance? Never! {
    f.inline_foreign.as_ref().map(fn(foreign) { TForeignProvenance{language: foreign.lang.clone(), abi: "inline", symbol: f.name.clone(), span: foreign.marker_span} })
}
fn checked_capture_names(names: [String]) -> [String] Never! {
    unique := Set<String>.new()
    loop name in names { &unique.insert(name.clone()) }
    ordered := unique.iter().cloned().collect()
    &ordered.sort()
    ordered
}
// Rust: crates/jet-codegen/src/Codegen/TIR/mod.rs:12915
pub fn lambda_capture_facts(lam: Lambda) -> TCaptureFacts Never! {
    TCaptureFacts{escapes: lam.meta.escapes, needs_fn_mut: lam.meta.needs_fn_mut, mutable: checked_capture_names(lam.meta.mut_captures), cloned: checked_capture_names(lam.meta.cloned_captures), frozen: checked_capture_names(lam.meta.frozen_captures), materialized: checked_capture_names(lam.meta.materialized_captures), moved: checked_capture_names(lam.meta.moved_captures)}
}

