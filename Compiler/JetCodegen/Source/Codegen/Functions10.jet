    pub fn needs_mut_receiver_place(self) -> Bool Never! {
        if self == {
            .Push | .TryPush | .TryReserve | .TryInsertMap | .TryStringPush | .Pop | .InsertMap | .AddNewMap | .MapSetDefault | .MapUpdate | .InsertList | .RemoveMap | .RemoveList(_, _) | .PriorityQueuePop | .PriorityQueueRemove(_, _) | .MapPopFirst | .ExtendList | .Reverse | .Sort | .SortDesc | .Clear | .SetInsert | .SetUpdate | .SetDifferenceUpdate | .SetIntersectionUpdate | .SetSymmetricDifferenceUpdate | .SetRemove | .SetPop | .SetReplace | .SortedSetInsert | .SortedSetRemove | .BitSetAdd | .BitSetRemove | .BagAdd | .BagRemove | .LRUPut | .LRUAddNew | .LRUGet | .ByteBufferWrite(_) | .DequePushFront | .DequePushBack | .DequePopFront | .DequePopBack | .DequeDelete | .DequeReverse | .DequeSplit | .SplitWrite(_) | .GetDisjointWrite | .IterNext -> true
            .ByteBufferMethod(method) -> method == "clear" || method == "seek" || method == "rewind" || method == "next" || method == "read" || method == "read_byte" || method == "read_bytes" || method == "read_string" || method == "flush" || method == "close" || method == "shutdown" || method == "copy_to" || method == "write_to"
