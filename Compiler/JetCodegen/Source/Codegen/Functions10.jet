//RS /// c109 Phase 11: a fully-resolved lambda/closure. All semantic facts are
//RS /// copied from checked AST metadata before any backend rendering occurs.
//RS #[derive(Clone)]
//RS pub struct TLambda {
//RS     pub executable: TLambdaBody,
//RS     /// Source identity of the checked closure body.
//RS     pub source_span: crate::Diagnostics::Span,
//RS     /// D-RESOURCE-SCHEDULE1=A: the complete sema-derived frame schedule.
//RS     /// This is carried as metadata; no lowering pass derives another plan.
//RS     pub frame_schedule: Option<jet_foundation::ResourceSchedule::JetFrameSchedule>,
//RS     /// ID of the canonical #2945 derivation relation for this payload.
//RS     pub frame_schedule_derivation: Option<jet_foundation::Facts::DerivationRef>,
//RS     /// Complete capture proof copied from `Lambda.meta`.
//RS     pub capture_facts: TCaptureFacts,
//RS     /// Sema-selected failure and effect carriers for this closure.
//RS     pub failure_carrier: TFailureCarrier,
//RS     pub effects: TEffectFacts,
//RS     /// Host callback ABI conventions, when this lambda is lowered for a
//RS     /// value-consuming helper rather than an ordinary Jet function value.
//RS     pub host_param_conventions: Option<Vec<crate::AST::AccessConvention>>,
//RS     /// Unmangled source parameter names for non-Rust targets.
//RS     pub source_params: Vec<String>,
//RS     /// Stable native symbol and resolved signature for noncapturing JIT calls.
//RS     pub jit_name: String,
//RS     pub param_types: Vec<Type>,
//RS     pub ret: Option<Type>,
//RS     pub is_move: bool,
//RS     pub boxed: bool,
//RS     /// Escaping non-mut Fn value: wrap with `std::rc::Rc::new` so collections can `.cloned()`.
//RS     pub rc: bool,
//RS     pub arc: bool,
//RS     /// JIT capture pack: (enclosing Jet name, body place, type). Empty = non-capturing.
//RS     pub captures: Vec<(String, String, Type)>,
//RS     /// Enclosing slot of each cloned/materialized capture whose body reads a
//RS     /// fresh slot, keyed by enclosing Jet name. A resource binding lives under
//RS     /// a generated slot, so the Jet name alone does not locate the value.
//RS     pub capture_origins: std::collections::BTreeMap<String, String>,
//RS     /// D-MEM-COPYSEM1=A: source names whose capture slot is an owned
//RS     /// materialization of a read-only view rather than a reference clone.
//RS     pub materialized_captures: Vec<String>,
//RS     /// D-CONC-FREEZE1=A: frozen source names carried from sema's one flow-fact
//RS     /// proof. This is metadata only; the capture slot is already owned.
//RS     pub frozen_captures: Vec<String>,
//RS     /// D-HARDENED1 / D-MEM-SENTRY1: the closure body mints an address from its
//RS     /// current frame storage and needs a token around each invocation.
//RS     pub uses_stack_sentry: bool,
//RS }
//RS 
//RS #[derive(Clone)]
//RS pub enum TLambdaBody {
//RS     Expr(Box<TExpr>),
//RS     Block(Vec<TStmt>),
//RS     /// A deferred body shared by the AOT closure representation and JIT lambda.
//RS     SharedBlock(std::sync::Arc<[TStmt]>),
//RS }
//RS 
//RS /// #3713: the source site of a function's own returned `Err(...)` — where its
//RS /// failure starts. `file` and `fn_name` use the same pre-escaped spelling as
//RS /// `TExprKind::Try`; `column` is 1-based in characters.
//RS #[derive(Clone)]
//RS pub struct TFailureOrigin {
//RS     pub file: String,
//RS     pub line: usize,
//RS     pub column: usize,
//RS     pub fn_name: String,
//RS }
//RS 
//RS /// c109 Phase 8: the resolved error-conversion of a `?`, mirroring `AST::TryConvert`
//RS /// (the total sema fact). Carried onto the TIR so the emitter never re-derives it.
//RS #[derive(Clone)]
//RS pub enum TTryConvert {
//RS     /// Error types match — bare `jet_trace_err(x, …)?`.
//RS     None,
//RS     /// A raw protocol method (for example `Encode`) consumes a computed
//RS     /// getter's outcome at the trait boundary instead of propagating `?`.
//RS     ProtocolExit,
//RS     /// The source error is `Never`; sema proved the failure route is
//RS     /// unreachable, so lowering unwraps the shared carrier without a
//RS     /// conversion or propagation branch.
//RS     Never,
//RS     /// D-FAIL-ERROR1=A: construct the default `Err` value from a message.
//RS     DefaultErr,
//RS     /// Declared `impl Source -> Target` conversion — `.map_err(<fn>)` (D-ERR-CONV);
//RS     /// holds the mangled Rust conversion-function name and resolved error types.
//RS     Typed {
//RS         fn_name: String,
//RS         source: Type,
//RS         target: Type,
//RS     },
//RS     /// D-UNIONTYPE1=A: wrap the error into a compiler-generated union enum.
//RS     WidenUnion { enum_name: String, tag: String },
//RS }
//RS 
//RS /// Whether a `?` produces the default `Err` carrier after its sema-selected
//RS /// conversion. Only that carrier can own structured context frames.
//RS pub fn try_target_is_default_error(input: &Type, convert: &TTryConvert) -> bool {
//RS     match convert {
//RS         TTryConvert::DefaultErr => true,
//RS         TTryConvert::None => matches!(
//RS             input.unwrap_result().map(|(_, error)| error),
//RS             Some(Type::Named(name)) if name == crate::Syntax::TYPE_ERR
//RS         ),
//RS         TTryConvert::Typed { target, .. } => matches!(
//RS             target,
//RS             Type::Named(name) if name == crate::Syntax::TYPE_ERR
//RS         ),
//RS         TTryConvert::Never | TTryConvert::WidenUnion { .. } | TTryConvert::ProtocolExit => false,
//RS     }
//RS }
//RS 
//RS /// c109 Phase 8: the resolved right-hand side of a `??` fallback (`AST::OrFallback`).
//RS /// `Value` is an expression; `Return` is an early `return [expr]` from the enclosing
//RS /// function. c109 Phase 15 / #776: `Panic` carries structured message + `TPanicLoc`;
//RS /// emit alone formats `jet_panic_rich` (I3: no pre-rendered Rust blob on the node).
//RS #[derive(Clone)]
//RS pub enum TOrFallback {
//RS     Value(Box<TExpr>),
//RS     Return(Option<Box<TExpr>>),
//RS     /// Structured panic stop — emit formats `jet_panic_rich`.
//RS     Panic {
//RS         msg: Box<TExpr>,
//RS         loc: TPanicLoc,
//RS     },
//RS     /// D-ORRETURN-ERG1=B: `?? break` — loop exit.
//RS     Break,
//RS     /// D-ORRETURN-ERG1=B: `?? next` — loop skip.
//RS     Continue,
//RS     /// D-LOOPLABEL3=A as amended by D-ARROW-CONTROL1=A: `?? break(label)`.
//RS     BreakLabel(String),
//RS     /// D-LOOPLABEL3=A as amended by D-ARROW-CONTROL1=A: `?? next(label)`.
//RS     ContinueLabel(String),
//RS }
//RS 
//RS #[derive(Clone)]
//RS pub enum TStrPart {
//RS     Lit(String),
//RS     Interp(TExpr, crate::AST::StrFormat),
//RS }
//RS 
//RS /// c109 Phase 4/16: the resolved payload shape of an enum literal.
//RS #[derive(Clone)]
//RS pub enum TEnumPayload {
//RS     /// `Enum.Variant` — no payload, emits just the prefix.
//RS     Unit,
//RS     /// `Variant(a, b, …)` — positional payload values, emitted as `prefix(a, b)`.
//RS     Positional(Vec<TEnumArg>),
//RS     /// `Variant { f: v, … }` — named payload, emitted as `prefix { f: v, … }`.
//RS     /// Each field's Rust name is already mangled at lowering.
//RS     Named(Vec<(String, TEnumArg)>),
//RS }
//RS 
//RS /// c109 Phase 16: one enum-literal payload argument with its resolved
//RS /// borrow/box decisions. Reproduces `emit_boxed_enum_arg` (Expression.rs) as a
//RS /// TOTAL fact decided at lowering: a non-scalar payload field whose value is a
//RS /// borrowed-in-env ident gets `(…).clone()`; a recursive (`boxed_edge`) payload
//RS /// gets `Box::new(…)`. For a scalar payload from a non-borrowed value both are
//RS /// false (the Phase-4 no-op case), so emit is byte-identical.
//RS #[derive(Clone)]
//RS pub struct TEnumArg {
//RS     pub value: TExpr,
//RS     /// Wrap the value in `(…).clone()` (non-scalar payload, borrowed-in-env arg).
//RS     pub clone: bool,
//RS     /// Wrap (after the clone) in `Box::new(…)` — a recursive boxed edge.
//RS     pub boxed: bool,
//RS }
//RS 
//RS /// D-LISTREMOVE1/F: the selector is resolved before emission. `Dynamic` is only
//RS /// used for an Int list when the selector is stored in a variable; other element
//RS /// types cannot accept both a value and a positional Int in one statically typed call.
//RS #[derive(Debug, Clone, Copy, PartialEq, Eq)]
//RS pub enum ListRemoveMode {
//RS     Value,
//RS     Slot,
//RS     Dynamic,
//RS }
//RS 
//RS /// c109 Phase 9: a resolved built-in collection/string method op. Each variant is
//RS /// one emit form from built-in collection-method lowering. The
//RS /// receiver-type dispatch (`rty = expr_jet_ty(receiver)` → Map vs List vs String)
//RS /// is decided ONCE at lowering — the variant encodes the chosen branch, so emit
//RS /// only formats. Line numbers (for the bounds/remove panic frames) are resolved at
//RS /// lowering; `cx.file`/`cx.root_prefix` are read at emit (program-level, not a
//RS /// per-node decision). Args are emitted plainly (no clone/borrow wrappers), exactly
//RS /// as `emit_builtin_method`'s `arg(i)` does.
//RS #[derive(Debug, Clone, Copy, PartialEq, Eq)]
//RS pub enum TZipMode {
//RS     Strict,
//RS     Short,
//RS     Pad,
//RS }
//RS 
//RS #[derive(Debug, Clone, Copy, PartialEq, Eq)]
//RS pub enum TZipFillMode {
//RS     DefaultNone,
//RS     Common,
//RS     Columns,
//RS }
//RS 
//RS // Debug names the variant in engine rejection text: a JIT refusal is a silent
//RS // interpreter deopt, so the message must say WHICH builtin method was refused.
//RS #[derive(Debug, Clone)]
//RS pub enum TBuiltinOp {
//RS     /// `len` on a `String` → `jet_char_len(&(recv))` (char count, not byte len).
//RS     /// D-PLACE1: lock-free scalar access uses the single checked Prelude
//RS     /// adapter family rather than exposing memory-order choices.
//RS     AtomicMethod {
//RS         method: String,
//RS     },
//RS     LenString,
//RS     /// `len` on a list/map → `(recv).len() as i64`.
//RS     LenList,
//RS     /// `is_empty()` on a list/map/string → `(recv).is_empty()` (Bool).
//RS     IsEmpty,
//RS     /// `push(x)` → `(recv).push(a0)`.
//RS     Push,
//RS     /// D-ALLOCFAIL1=A: fallible list/string mutation and reservation.
//RS     ListTryNew,
//RS     ListTryWithCapacity,
//RS     TryPush,
//RS     TryReserve,
//RS     TryInsertMap,
//RS     TryStringPush,
//RS     /// `pop()` → `(recv).pop()`.
//RS     Pop,
//RS     /// `PriorityQueue.pop()` → the shared Prelude heap kernel.
//RS     PriorityQueuePop,
//RS     /// `add(k, v)` on a map → displaced value, if any.
//RS     InsertMap,
//RS     /// `add_new(k, v)` on a map → false without overwriting an existing key.
//RS     AddNewMap,
//RS     /// `setdefault(k, v)` on a map → return existing value or insert and return `v`.
//RS     MapSetDefault,
//RS     /// `update(other)` on a map → mutate the receiver; right wins on shared keys.
//RS     MapUpdate,
//RS     /// D-MAP-MERGE1=E: `merge(other)` → right wins on shared keys.
//RS     MapMerge,
//RS     /// D-MAP-MERGE1=E: `merge(other, conflict)` → callback resolves shared keys.
//RS     MapMergeWith,
//RS     /// `insert(i, v)` on a list → `(recv).insert(a0 as usize, a1)`.
//RS     InsertList,
//RS     /// `remove(k)` on a map → `(recv).remove(&(a0).clone())`.
//RS     RemoveMap,
//RS     /// `remove(x[, by])` on a list; the selector is fixed at lowering.
//RS     RemoveList {
//RS         line: usize,
//RS         mode: ListRemoveMode,
//RS     },
//RS     /// `count(value)` on a list.
//RS     CountList,
//RS     /// `counts()` on a list or iterator → a frequency map.
//RS     Counts,
//RS     /// `extend(other)` on a list.
//RS     ExtendList,
//RS     /// `concat(other)` on a list.
//RS     ConcatList,
//RS     /// `get(k)` on a map → `(recv).get(&(a0).clone()).cloned()`.
//RS     GetMap,
//RS     /// `get(i)` on a list → `(recv).get(a0 as usize).cloned()`.
//RS     GetList,
//RS     /// `first()` → the consuming `jet_iter_first` terminal or a cloned collection item.
//RS     First,
//RS     /// `last()` → `(recv).last().cloned()`.
//RS     Last,
//RS     /// `contains(x)` → `(recv).contains(&a0)` (list element / String substring).
//RS     Contains,
//RS     /// `index_of(x)` → `(recv).iter().position(|x| *x == a0).map(|i| i as i64)`.
//RS     IndexOf,
//RS     /// `reverse()` → `(recv).reverse()`.
//RS     Reverse,
//RS     /// `sort()` (no comparator) → `(recv).sort()`.
//RS     Sort,
//RS     /// `sort_desc()` → the shared descending Prelude kernel.
//RS     SortDesc,
//RS     /// `Ordering.then(other)` keeps the first non-equal result.
//RS     OrderingThen,
//RS     /// `Ordering.reverse()` swaps Less and Greater.
//RS     OrderingReverse,
//RS     /// `join(sep)` → `(recv).iter().map(|x| x.jet_show()).collect::<Vec<_>>().join((a0).as_str())`.
//RS     JoinSep,
//RS     Sum {
//RS         float: bool,
//RS         f32: bool,
//RS     },
//RS     Product {
//RS         float: bool,
//RS     },
//RS     Min {
//RS         float: bool,
//RS     },
//RS     Max {
//RS         float: bool,
//RS     },
//RS     Flatten,
//RS     Intersperse,
//RS     Unzip {
//RS         tuple_struct: String,
//RS     },
//RS     /// `clear()` → `(recv).clear()`.
//RS     Clear,
//RS     /// `chars()` → `jet_string_chars(&(recv))`, the String's chars as a `[Char]`.
//RS     Chars,
//RS     /// `bytes()` on a proven owned String rvalue consumes it; a place/view keeps
//RS     /// the borrowing copy helper. `owned` is a lowering fact, not an emitter guess.
//RS     Bytes {
//RS         owned: bool,
//RS     },
//RS     /// `String.from_bytes(bytes)` → `{root}jet_string_from_bytes(&(recv))`.
//RS     StringFromBytes,
//RS     /// `String.from_bytes_lossy(bytes)` → `{root}jet_string_from_bytes_lossy(&(recv))`.
//RS     StringFromBytesLossy,
//RS     /// `trim()` → pinned `jet_unicode_trim(&(recv))`.
//RS     Trim,
//RS     TrimStart,
//RS     TrimEnd,
//RS     PadStart,
//RS     PadEnd,
//RS     StringIndexOf,
//RS     StringCount,
//RS     StringIsAlphabetic,
//RS     StringIsNumeric,
//RS     StringIsWhitespace,
//RS     StringIsAscii,
//RS     StringToTitle,
//RS     /// #1476: remaining ambient String methods, dispatched by name.
//RS     StringMethod {
//RS         method: String,
//RS     },
//RS     StringSplitOnce {
//RS         tuple_struct: String,
//RS     },
//RS     /// `cut_last(sep)` → the shared Unicode terminal-boundary helper.
//RS     StringCutLast {
//RS         tuple_struct: String,
//RS     },
//RS     /// `split(sep)` → `jet_iter_string_split(&(recv), &a0)` (lazy `JetIter<String>`).
//RS     Split,
//RS     /// c97/D-STRPARSE1: `lines()` → `{root}jet_string_lines(&(recv))`.
//RS     Lines,
//RS     /// c97/D-STRPARSE1: `Int.parse(text)` → checked integer parse.
//RS     ParseInt,
//RS     /// c97/D-STRPARSE1: `Float.parse(text)` → checked floating-point parse.
//RS     ParseFloat,
//RS     /// `Int.to_radix(base)` → exact lowercase text through the shared Int kernel.
//RS     IntToRadix {
//RS         line: u32,
//RS     },
//RS     /// `Int.from_radix(text, base)` → exact Int through the shared Int kernel.
//RS     IntFromRadix {
//RS         line: u32,
//RS     },
//RS     /// `starts_with(s)` → `(recv).starts_with(&a0)`.
//RS     StartsWith,
//RS     /// `ends_with(s)` → `(recv).ends_with(&a0)`.
//RS     EndsWith,
//RS     /// `replace(from, to)` → `(recv).replace(&a0, &a1)`.
//RS     Replace,
//RS     /// `to_upper()` → pinned `jet_unicode_upper(&(recv))`.
//RS     ToUpper,
//RS     /// `to_lower()` → pinned `jet_unicode_lower(&(recv))`.
//RS     ToLower,
//RS     /// ASCII-only lowercasing; all non-ASCII code points remain unchanged.
//RS     ToAsciiLower,
//RS     /// ASCII-only uppercasing; all non-ASCII code points remain unchanged.
//RS     ToAsciiUpper,
//RS     /// `repeat(n)` → `(recv).repeat(a0 as usize)`.
//RS     Repeat,
//RS     /// `slice(a, b)` → `jet_string_slice_builtin(&(recv), a0, a1)`.
//RS     Slice {
//RS         line: usize,
//RS     },
//RS     /// D-STR-AFTER1: `after(sep)` → `jet_string_after(&(recv), &a0)`. Substring
//RS     /// strictly after the first `sep`; `sep` absent → the whole original string
//RS     /// (mirrors `.replace`'s no-match-is-identity convention).
//RS     After,
//RS     /// D-STR-AFTER1: `before(sep)` → `jet_string_before(&(recv), &a0)`. Substring
//RS     /// strictly before the first `sep`; `sep` absent → the whole original string.
//RS     Before,
//RS     /// D-MEM1 stage S5: the zero-copy sibling of `Trim`, used ONLY as the init
//RS     /// of a `Binding` sema marked `string_view` (E2307 proves it can't outlive
//RS     /// its owner) → `jet_string_trim_view(&(recv))`, a borrowed `&str`, no
//RS     /// `.to_string()`.
//RS     TrimView,
//RS     /// D-MEM1 stage S5: the zero-copy sibling of `After`, same `string_view`
//RS     /// gate → `jet_string_after_view(&(recv), &a0)`.
//RS     AfterView,
//RS     /// D-MEM1 stage S5: the zero-copy sibling of `Before`, same `string_view`
//RS     /// gate → `jet_string_before_view(&(recv), &a0)`.
//RS     BeforeView,
//RS     /// `keys()` → a lazy `JetIter` over map keys.
//RS     Keys,
//RS     /// `values()` → a lazy `JetIter` over map values.
//RS     Values,
//RS     /// `contains_key(k)` → `(recv).contains_key(&a0)`.
//RS     ContainsKey,
//RS     /// `to_string()` (on a String receiver) → `(recv).jet_show()`.
//RS     ToString,
//RS     /// D-REGEXENGINE1=A: `Match.group(n)` → `(recv).group(a0)`.
//RS     MatchGroup,
//RS     // D-ITER1: non-closure lazy adapters.
//RS     /// `take(n)` → `jet_list_take((recv).clone(), a0)`.
//RS     Take,
//RS     /// `skip(n)` → `jet_list_skip((recv).clone(), a0)`.
//RS     Skip,
//RS     /// D-ITERTOOLS1=A: `Iter.to_list()` / `.collect()` → owned `[T]`.
//RS     IterToList,
//RS     IterCollect,
//RS     /// D-LOOPMAP1=B: `list.lazy()` → `Iter<T>` pipeline plane.
//RS     ListLazy,
//RS     /// `step_by(n)` → `jet_list_step_by((recv).clone(), a0)`.
//RS     StepBy,
//RS     /// `dedup()` → `jet_iter_dedup(...)`.
//RS     Dedup,
//RS     /// `chunks(n)` → `jet_iter_chunks(...)`.
//RS     Chunks,
//RS     /// `windows(n)` → `jet_iter_windows(...)`.
//RS     Windows,
//RS     // #1479: remaining Iter ledger surface (non-closure).
//RS     /// `repeat(n)` → `jet_iter_repeat({as_iter}, n)`.
//RS     IterRepeat,
//RS     /// `cycle(n)` → `jet_iter_cycle({as_iter}, n)` — exactly `n` items.
//RS     IterCycle,
//RS     /// `drop_last(n)` → `jet_iter_drop_last({as_iter}, n)`.
//RS     IterDropLast,
//RS     /// `&it.next()` → `jet_iter_next(&mut it)` (D-ITER-RESUME1=A).
//RS     IterNext,
//RS     /// `shuffle()` → `jet_iter_shuffle({as_iter})`.
//RS     IterShuffle,
//RS     /// `is_sorted()` → `jet_iter_is_sorted({as_iter})`.
//RS     IterIsSorted,
//RS     /// `last_index_of(v)` → `jet_iter_last_index_of({as_iter}, v)`.
//RS     IterLastIndexOf,
//RS     /// `average()` → `jet_iter_average_{int,float}({as_iter})`.
//RS     IterAverage {
//RS         float: bool,
//RS     },
//RS     /// `compare(other)` → `jet_iter_compare({as_iter}, other)`.
//RS     IterCompare,
//RS     /// `split(n)` → `jet_iter_split_at({as_iter}, n, |l,r| Struct{…})`.
//RS     IterSplit {
//RS         tuple_struct: String,
//RS     },
//RS     // #1477 List/Map non-closure surface
//RS     ListSlice,
//RS     ListCopy,
//RS     ListEqual,
//RS     ListBinarySearch,
//RS     ListUnion,
//RS     ListIntersection,
//RS     ListDifference,
//RS     ListRandom,
//RS     ListMinMax {
//RS         tuple_struct: String,
//RS     },
//RS     MapCopy,
//RS     MapEqual,
//RS     MapFirst,
//RS     MapToList {
//RS         tuple_struct: String,
//RS     },
//RS     /// `top_n(n)` on a map → key/value rows ordered by descending value.
//RS     MapTopN {
//RS         tuple_struct: String,
//RS     },
//RS     MapMin,
//RS     MapMax,
//RS     MapIntersection,
//RS     MapSliceKeys,
//RS     MapNew,
//RS     MapFromKeys,
//RS     MapContainsValue,
//RS     MapPopFirst,
//RS     /// `list.replace(i, v)` → the prior indexed value.
//RS     ListReplace,
//RS     /// `indexed()` → inline emit building `JetTup_<hash>` struct. The struct name
//RS     /// is embedded here at lowering so emit is a pure formatter.
//RS     Indexed {
//RS         tuple_struct: String,
//RS     },
//RS     /// D-RANGE-EXCL1=C: `indexes()` → `Iter<Int>` of every valid index.
//RS     Indexes,
//RS     /// `zip([U])` → inline emit building `JetTup_<hash>` struct.
//RS     Zip {
//RS         tuple_struct: String,
//RS         mode: TZipMode,
//RS         /// Output field names in source input order.
//RS         fields: Vec<String>,
//RS         /// The left input is a nested pair from an earlier n-ary stage.
//RS         flatten: bool,
//RS         /// Number of source inputs in the complete zip family call.
//RS         input_count: usize,
//RS         fill_mode: TZipFillMode,
//RS         /// Resolved row-field types, used to marshal typed fills per column.
//RS         field_types: Vec<Type>,
//RS     },
//RS     // D-HOLE1: Option combinators.
//RS     /// `zip(?U)` on `?T` → `(recv).clone().zip((a0).clone()).map(|(x,y)| Struct{…})`
//RS     /// (Rust's native `Option::zip`, wrapped into the named-tuple struct). `elem_ty`
//RS     /// (`(a: T, b: U)`) is the resolved pair type — carried so the call's own `TExpr`
//RS     /// type is total (not the generic table's placeholder), even though it's rarely
//RS     /// load-bearing in emit (a binding carries sema's `b.ty`).
//RS     OptionZip {
//RS         tuple_struct: String,
//RS         elem_ty: Type,
//RS     },
//RS     // D-COLLBREADTH1=A: Set<T> operations.
//RS     /// `Set.from([...])` — recv is the list: `(recv).into_iter().collect::<std::collections::HashSet<_>>()`.
//RS     SetFrom,
//RS     /// `set.add(v)` → `(recv).insert(a0)` (HashSet::insert; bool result discarded).
//RS     SetInsert,
//RS     /// `set.update(other)` → mutate the receiver with every value in `other`.
//RS     SetUpdate,
//RS     /// `set.difference_update(other)` → retain values absent from `other`.
//RS     SetDifferenceUpdate,
//RS     /// `set.intersection_update(other)` → retain values present in `other`.
//RS     SetIntersectionUpdate,
//RS     /// `set.symmetric_difference_update(other)` → retain values in exactly one set.
//RS     SetSymmetricDifferenceUpdate,
//RS     /// `set.remove(v)` → `(recv).remove(&a0)` (bool result discarded).
//RS     SetRemove,
//RS     /// `set.to_list()` → `(recv).iter().cloned().collect::<Vec<_>>()`.
//RS     SetToList,
//RS     /// `set.union(other)` → `(recv).union(&(a0)).cloned().collect::<std::collections::HashSet<_>>()`.
//RS     SetUnion,
//RS     SetIntersection,
//RS     SetDifference,
//RS     SetSymmetricDifference,
//RS     SetIsSubset,
//RS     SetIsSuperset,
//RS     SetIsDisjoint,
//RS     /// #1478: `set.copy()` / `set.to_set()` → clone.
//RS     SetCopy,
//RS     /// #1478: `set.equal(other)` → `recv == other`.
//RS     SetEqual,
//RS     /// #1478: `set.capacity()` → `recv.capacity() as i64`.
//RS     SetCapacity,
//RS     /// #1478: `set.first()` → arbitrary element (unordered).
//RS     SetFirst,
//RS     /// `set.values()` → lazy view over the same arbitrary order as `to_list`.
//RS     SetValues,
//RS     /// `set.pop(v)` / `set.take(v)` → shared remove-and-return kernel.
//RS     SetPop,
//RS     /// `set.replace(v)` → insert and return the displaced equal value.
//RS     SetReplace,
//RS     /// D-SET-DECLINE1=C: `set.sort()` → a fresh sorted `List`, same
//RS     /// to-list-then-sort machinery `to_list()` already runs (Set never mutates).
//RS     SetSort,
//RS     /// D-SET-DECLINE1=C: `set.shuffle()` → a fresh shuffled `List`, the same
//RS     /// `jet_iter_shuffle` engine `List.shuffle()` already runs.
//RS     SetShuffle,
//RS     SortedSetFrom,
//RS     SortedSetInsert,
//RS     SortedSetRemove,
//RS     SortedSetToList,
//RS     SortedSetUnion,
//RS     SortedSetIntersection,
//RS     SortedSetDifference,
//RS     SortedSetSymmetricDifference,
//RS     SortedSetIsSubset,
//RS     SortedSetIsSuperset,
//RS     SortedSetIsDisjoint,
//RS     PriorityQueueFrom,
//RS     PriorityQueuePeek,
//RS     PriorityQueueToSortedList,
//RS     /// D-LISTREMOVE1/F: `remove(x[, by])` on a `PriorityQueue`; same selector
//RS     /// shape as `RemoveList`, no positional ordering guarantee across pushes.
//RS     PriorityQueueRemove {
//RS         line: usize,
//RS         mode: ListRemoveMode,
//RS     },
//RS     LruPut,
//RS     LruAddNew,
//RS     LruGet,
//RS     LruCapacity,
//RS     LruKeys,
//RS     BitSetAdd,
//RS     BitSetRemove,
//RS     BitSetCount,
//RS     BitSetToList,
//RS     BitSetCopy,
//RS     BitSetNew,
//RS     ByteBufferNew,
//RS     ByteBufferFrom,
//RS     ByteBufferWrite {
//RS         method: String,
//RS     },
//RS     ByteBufferToBytes,
//RS     /// Generic `Bytes` instance call → `(recv).method(args…)` (cursor + string-like).
//RS     ByteBufferMethod {
//RS         method: String,
//RS     },
//RS     ByteBufferWithCapacity,
//RS     // D-TAG1: Tally<T> counted multiset (HashMap-backed).
//RS     BagAdd,
//RS     BagRemove,
//RS     BagHas,
//RS     BagCount,
//RS     BagLen,
//RS     // D-COLLBREADTH1=A: Queue<T> operations.
//RS     /// `deque.push_front(v)` → `(recv).push_front(a0)`.
//RS     DequePushFront,
//RS     /// `deque.push_back(v)` → `(recv).push_back(a0)`.
//RS     DequePushBack,
//RS     /// `deque.pop_front()` → `(recv).pop_front()` (returns `Option<T>`).
//RS     DequePopFront,
//RS     /// `deque.pop_back()` → `(recv).pop_back()` (returns `Option<T>`).
//RS     DequePopBack,
//RS     /// `deque.peek_front()` → `(recv).front().cloned()` (returns `Option<T>`).
//RS     DequePeekFront,
//RS     /// `deque.peek_back()` → `(recv).back().cloned()` (returns `Option<T>`).
//RS     DequePeekBack,
//RS     /// `deque.capacity()` → `(recv).capacity() as i64`.
//RS     DequeCapacity,
//RS     /// `deque.contains(v)` → `(recv).iter().any(|x| x == &v)`.
//RS     DequeContains,
//RS     /// `deque.get(i)` → `(recv).get(i as usize).cloned()`.
//RS     DequeGet,
//RS     /// `deque.delete(v)` — remove first equal element (unit).
//RS     DequeDelete,
//RS     /// `deque.to_list()` → `(recv).iter().cloned().collect::<Vec<_>>()`.
//RS     DequeToList,
//RS     /// `deque.join(sep)` — string-join of elements via jet_show.
//RS     DequeJoin,
//RS     /// `deque.reverse()` — reverse in place via make_contiguous.
//RS     DequeReverse,
//RS     /// `deque.split(i)` → `(recv).split_off(i as usize)` (returns other half).
//RS     DequeSplit,
//RS     /// `Queue.from(xs)` / `Queue.init(xs)` — build from a list.
//RS     DequeFrom,
//RS     // D-FAILCOMP1: failure-aware list adapters.
//RS     /// `try_collect()` on `[Result<T,E>]` → `jet_list_try_collect((recv).clone())`.
//RS     TryCollect,
//RS     // D-DYNARRAY1: `View<T>` — a zero-copy window (`&[T]`) over a list's
//RS     // backing storage. The read-only accessor methods (`len`/`is_empty`/
//RS     // `get`/`first`/`last`/`contains`/`index_of`) reuse `LenList`/`IsEmpty`/
//RS     // `GetList`/`First`/`Last`/`Contains`/`IndexOf` above unchanged — every
//RS     // one of those emits a plain Rust slice/`.get`/`.first`/… call that a
//RS     // `&[T]` receiver satisfies exactly as a `Vec<T>` does.
//RS     /// `list.view(a..b)` → `jet_view_new(&(recv), a0, a1, file, line)`.
//RS     ViewNew {
//RS         line: usize,
//RS     },
//RS     /// `&list[a..b]` → `jet_view_mut_new(&mut recv, a, b, file, line)`.
//RS     ViewMutNew {
//RS         line: usize,
//RS     },
//RS     /// D-SHAPE-PLACE1=A: a checked rank-preserving Tensor window. The ambient
//RS     /// evaluator materializes the read view and tracks the mutable view handle;
//RS     /// AOT calls the same Prelude bounds law directly.
//RS     ComputeViewNew {
//RS         line: usize,
//RS     },
//RS     ComputeViewMutNew {
//RS         line: usize,
//RS     },
//RS     /// D-MEMDISJOINT1=A: checked runtime split into two tracked mutable views.
//RS     SplitWrite {
//RS         tuple_struct: String,
//RS     },
//RS     /// D-MEMDISJOINT1=A: checked runtime selection of distinct one-item views.
//RS     GetDisjointWrite,
//RS }
//RS 
//RS impl TBuiltinOp {
//RS     /// A resolved builtin with a write receiver must receive a live place.
//RS     /// Keep this fact on the TIR op so lowering and every emitter agree; lazy
//RS     /// iterator adapters are value operations and are intentionally absent,
//RS     /// while `IterNext` pulls through the place so the source keeps its
//RS     /// remainder (D-ITER-RESUME1=A).
//RS     pub(crate) fn needs_mut_receiver_place(&self) -> bool {
//RS         match self {
//RS             Self::Push
//RS             | Self::TryPush
//RS             | Self::TryReserve
//RS             | Self::TryInsertMap
//RS             | Self::TryStringPush
//RS             | Self::Pop
//RS             | Self::InsertMap
//RS             | Self::AddNewMap
//RS             | Self::MapSetDefault
//RS             | Self::MapUpdate
//RS             | Self::InsertList
//RS             | Self::RemoveMap
//RS             | Self::RemoveList { .. }
//RS             | Self::PriorityQueuePop
//RS             | Self::PriorityQueueRemove { .. }
//RS             | Self::MapPopFirst
//RS             | Self::ExtendList
//RS             | Self::Reverse
//RS             | Self::Sort
//RS             | Self::SortDesc
//RS             | Self::Clear
//RS             | Self::SetInsert
//RS             | Self::SetUpdate
//RS             | Self::SetDifferenceUpdate
//RS             | Self::SetIntersectionUpdate
//RS             | Self::SetSymmetricDifferenceUpdate
//RS             | Self::SetRemove
//RS             | Self::SetPop
//RS             | Self::SetReplace
//RS             | Self::SortedSetInsert
//RS             | Self::SortedSetRemove
//RS             | Self::BitSetAdd
//RS             | Self::BitSetRemove
//RS             | Self::BagAdd
//RS             | Self::BagRemove
//RS             | Self::LruPut
//RS             | Self::LruAddNew
//RS             | Self::LruGet
//RS             | Self::ByteBufferWrite { .. }
//RS             | Self::DequePushFront
//RS             | Self::DequePushBack
//RS             | Self::DequePopFront
//RS             | Self::DequePopBack
//RS             | Self::DequeDelete
//RS             | Self::DequeReverse
//RS             | Self::DequeSplit
//RS             | Self::SplitWrite { .. }
//RS             | Self::GetDisjointWrite
//RS             | Self::IterNext => true,
//RS             Self::ByteBufferMethod { method } => matches!(
//RS                 method.as_str(),
//RS                 "clear"
//RS                     | "seek"
//RS                     | "rewind"
//RS                     | "next"
//RS                     | "read"
//RS                     | "read_byte"
//RS                     | "read_bytes"
//RS                     | "read_string"
//RS                     | "flush"
//RS                     | "close"
//RS                     | "shutdown"
//RS                     | "copy_to"
//RS                     | "write_to"
//RS             ),
//RS             _ => false,
//RS         }
//RS     }
//RS }
//RS 
//RS /// One checked table fact attached to a database sink.  The table identity is
//RS /// derived from checked SQL literal segments; runtime result shape is never
//RS /// used to infer a relation.
//RS #[derive(Clone, Debug, PartialEq, Eq)]
//RS pub struct TDbTableFact {
//RS     pub table_id: String,
//RS     pub read: bool,
//RS     pub write: bool,
//RS }
//RS 
//RS /// Checked database query metadata shared by every execution adapter.
//RS /// `source_span` identifies the checked sink call and `table_facts` contains
//RS /// only relations proven from static SQL segments.
//RS #[derive(Clone, Debug, PartialEq, Eq)]
//RS pub struct TDbQueryMetadata {
//RS     pub source_file: String,
//RS     pub source_span: crate::Diagnostics::Span,
//RS     pub statement_identity: String,
//RS     pub table_facts: Vec<TDbTableFact>,
//RS }
