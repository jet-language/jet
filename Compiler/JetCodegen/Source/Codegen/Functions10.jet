// Rust: crates/jet-codegen/src/Codegen/TIR/mod.rs:12689
// TFailureCarrier -> Foundation TIR:1513; every original carrier variant is present.
impl TFailureCarrier {
    // Rust: crates/jet-codegen/src/Codegen/TIR/mod.rs:12697
    pub fn default() -> Self Never! { Self.Infallible }
    // Rust: crates/jet-codegen/src/Codegen/TIR/mod.rs:12703
    pub fn from_contract(contract: FailureContract) -> Self Never! {
        if contract == {
            .Default(success, error) | .Explicit(success, error) | .Inferred(success, error) | .Converted(success, _, error) -> Self.Result(success.clone(), error.clone())
            .Optional(success) -> Self.Optional(success.clone())
            .DeclaredNever -> Self.Diverges(Type.Named(TYPE_NEVER.to_string()))
            .ProvenUnreachable(success) | .InferredNever(success) -> Self.Result(success.clone(), Type.Named(TYPE_NEVER.to_string()))
        }
    }
    // Rust: crates/jet-codegen/src/Codegen/TIR/mod.rs:12732
    pub fn map_types(self, map: fn(Type) -> Type Never!) -> Self Never! {
        if self == {
            .Infallible -> Self.Infallible
            .Result(success, error) -> Self.Result(map(success), map(error))
            .Optional(value) -> Self.Optional(map(value))
            .Diverges(value) -> Self.Diverges(map(value))
        }
    }
    // Rust: crates/jet-codegen/src/Codegen/TIR/mod.rs:12747
    pub fn from_checked_type(ty: Type) -> Self Never! {
        if ty == {
            .Result(ok, err) -> Self.Result(ok.clone(), err.clone())
            .Option(value) -> Self.Optional(value.clone())
            else -> if ty.is_never() -> Self.Diverges(ty.clone()) else -> Self.Infallible
        }
    }
}
