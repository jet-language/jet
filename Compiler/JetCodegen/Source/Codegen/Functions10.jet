//RS                 .unwrap_or_else(|| Type::Named(crate::Syntax::INTERNAL_UNIT_TYPE.to_string())),
//RS             error: error.clone(),
//RS         },
//RS         (Some(result), None, _) => crate::AST::FailureContract::from_return_type(Some(result)),
//RS         (None, None, Some(carrier)) => crate::AST::FailureContract::from_return_type(Some(carrier)),
//RS         (None, None, None) => crate::AST::FailureContract::from_return_type(None),
//RS     };
//RS     TFailureCarrier::from_contract(&contract)
//RS }
//RS 
//RS pub(crate) fn function_failure_carrier(f: &crate::AST::Func) -> TFailureCarrier {
//RS     TFailureCarrier::from_contract(&f.failure_contract())
//RS }
//RS 
//RS /// #3740 (D-FAILURE-FOUNDATION1): a free function whose failure set is empty
//RS /// (`T Never!`, written or inferred by sema) returns its success value on
//RS /// every tier. Only the executable signature changes: the checked body and
//RS /// every call site keep the `Result<T, Never>` carrier, and MIR reconciles
//RS /// the two at returns, calls, `Try`, and function values. Contract scopes,
//RS /// GC returns, jobs, foreign bodies, and compiler-generated harness wrappers
//RS /// keep their carrier-shaped exits.
//RS pub(crate) fn function_has_plain_return(f: &crate::AST::Func) -> bool {
//RS     f.failure_contract().is_proven_unreachable()
//RS         && f.pre.is_empty()
//RS         && f.post.is_empty()
//RS         && f.inline_foreign.is_none()
//RS         && !f.gc_return
//RS         && !f.is_job
//RS         && !f.compiler_generated
//RS }
//RS 
