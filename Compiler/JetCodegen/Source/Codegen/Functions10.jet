//RS             interpreter: true,
//RS             web: true,
//RS         };
//RS     };
//RS     if matches!(
//RS         foreign.lang.to_ascii_lowercase().as_str(),
//RS         "c" | "cpp" | "c++" | "asm" | "assembly"
//RS     ) {
//RS         // Native inline bodies share the checked bridge across AOT, Cranelift,
//RS         // and the resident interpreter; Web has no native provider.
//RS         return TTargetApplicability {
//RS             rust_aot: true,
//RS             cranelift: true,
//RS             interpreter: true,
//RS             web: false,
//RS         };
//RS     }
//RS     let web = foreign.lang.eq_ignore_ascii_case("js") || foreign.lang.eq_ignore_ascii_case("web");
//RS     TTargetApplicability {
//RS         rust_aot: true,
//RS         cranelift: false,
//RS         interpreter: false,
//RS         web,
//RS     }
