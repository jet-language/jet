//RS pub(crate) fn lambda_capture_facts(lam: &crate::AST::Lambda) -> TCaptureFacts {
//RS     TCaptureFacts {
//RS         escapes: lam.meta.escapes,
//RS         needs_fn_mut: lam.meta.needs_fn_mut,
//RS         mutable: lam.meta.mut_captures.iter().cloned().collect(),
//RS         cloned: lam.meta.cloned_captures.iter().cloned().collect(),
//RS         frozen: lam.meta.frozen_captures.iter().cloned().collect(),
//RS         materialized: lam.meta.materialized_captures.iter().cloned().collect(),
//RS         moved: lam.meta.moved_captures.iter().cloned().collect(),
//RS     }
//RS }
