// Lower checked owner-qualified calls without re-resolving source syntax.
use jet_foundation.[
    AccessConvention,
    Effect,
    MIRAccess,
    MIRCallArg,
    MIRCallSignature,
    MIRCallee,
    MIROperation,
    MIRPreludeABI,
    MIRPreludeCall,
    MIRPreludeCallID,
    MIRPreludeFamily,
    MIRPreludeTypeArg,
    MIRSemanticOp,
    MIRSymbol,
    MIRType,
    MIRValueID,
    TCallArg,
    TExpr,
    TFailureCarrier,
    TMethodRef,
    TPreludeArg,
    TStaticOwner,
    Type,
    mir_symbol_name,
    prelude_route_effect,
    stable_id,
]

fn jet_codegen_lower_static_call(builder: &JetCodegenBuilder, program: JetCodegenProgram, expression: TExpr, owner: TStaticOwner, owner_type: Type?, method: TMethodRef, type_args: [Type], args: [TCallArg]) -> MIRValueID {
    return if owner == {
        .User(name) -> jet_codegen_lower_user_static_call(&builder, program, expression, name, owner_type, method, type_args, args)
        .Prelude(rooted, path, generics) -> jet_codegen_lower_prelude_static_call(&builder, program, expression, rooted, path, generics, method, type_args, args)
    }
}

fn jet_codegen_lower_user_static_call(builder: &JetCodegenBuilder, program: JetCodegenProgram, expression: TExpr, owner_name: String, owner_type: Type?, method: TMethodRef, type_args: [Type], args: [TCallArg]) -> MIRValueID {
    target :: jet_codegen_method_function(builder, program, method) ?? panic("checked static method SymbolId has no reachable TFunc")
    owner_ty := owner_type ?? Type.Named{name: owner_name}
    call_return_type := jet_codegen_checked_method_return_type(builder, program, target, owner_ty, type_args)
    owner := jet_codegen_lower_type_for_function(owner_ty, builder, program)
    lowered_args := jet_codegen_lower_call_args(&builder, program, args, target.params)
    lowered_type_args := [MIRType]{}
    loop ty in type_args -> &lowered_type_args.push(jet_codegen_lower_type_for_function(ty, builder, program))
    return jet_codegen_emit_value(&builder, program, expression.span, call_return_type, MIROperation.Call{callee: MIRCallee.Associated{function: jet_codegen_function_id(target), owner: owner}, args: lowered_args, type_args: lowered_type_args})
}

fn jet_codegen_static_method_key(builder: JetCodegenBuilder, program: JetCodegenProgram, method: TMethodRef) -> String Never! {
    if method.operator_identity != None {
        identity :: method.operator_identity ?? return method.name
        return identity
    }
    if method.trait_owner != None {
        trait_owner :: method.trait_owner ?? return method.name
        return "{jet_codegen_symbol_name(builder, program, trait_owner)}::{method.name}"
    }
    return method.name
}

fn jet_codegen_lower_static_prelude_args(builder: &JetCodegenBuilder, program: JetCodegenProgram, args: [TCallArg], takes_owned: Bool) -> [MIRCallArg] {
    // Intrinsic checking already bound these arguments. Its unmarked
    // convention is Read; there is no language variadic slot on this route.
    conventions := [AccessConvention]{}
    loop _ in args -> &conventions.push(AccessConvention.Read)
    lowered := jet_codegen_lower_call_args_for_signature(&builder, program, args, [Bool]{}, conventions)
    loop (index, source_argument) in args {
        lowered[index].label = None
        lowered[index].source_index = Val(index)
        lowered[index].binder_slot = None
        lowered[index].spread = false
        lowered[index].fn_coercion = None
        lowered[index].widen_fixed_to_list = false
        owned_slot :: !source_argument.borrow && !source_argument.mut_borrow
        // A resource take always moves. A route that takes its owned
        // operand (`shared value`) also takes a checked move or a fresh
        // value by Move: passed as a Read, the native lowering would clone
        // the whole value into the cell and drop the original.
        if owned_slot && (source_argument.value.kind == .ResourceTake(_) || (takes_owned && jet_codegen_static_prelude_owned_operand(source_argument.value))) {
            lowered[index].access = MIRAccess.Move
            lowered[index].owned_last_use = true
        }
    }
    return lowered
}

// The prelude statics whose native lowering takes an owned operand when MIR
// moves it (JetBackend Tasks.jet lower_shared_taken_slot).
fn jet_codegen_static_prelude_takes_owned(symbol: String) -> Bool Never! {
    symbol == "jet_std::JetShared::new"
}

// An operand that is already the caller's own value: a checked move
// (TExprKind.Move) or a freshly built one. A bare place read is not: an
// unmarked `shared x` that sema settled as a share copies its source.
fn jet_codegen_static_prelude_owned_operand(value: TExpr) -> Bool Never! {
    if jet_codegen_collection_owned_temporary(value) -> return true
    if value.kind == {
        .StructLit(_, _) | .Tuple(_) | .Map(_) | .MapLit(_) | .EnumCtor(_, _, _) | .Present(_) | .Ok(_) | .Err(_) -> true
        else -> false
    }
}

fn jet_codegen_intern_static_call_route(builder: &JetCodegenBuilder, program: JetCodegenProgram, family: MIRPreludeFamily, module_name: String, member: String, symbol: MIRSymbol, borrow_mask: [Bool], route_effect: Effect?, carrier: TFailureCarrier) -> MIRPreludeCallID Never! {
    checked_effect := prelude_route_effect(module_name, member)
    if checked_effect == None -> checked_effect = route_effect
    mask_names := [String]{}
    loop borrowed in borrow_mask {
        if borrowed -> &mask_names.push("true") else -> &mask_names.push("false")
    }
    symbol_name := mir_symbol_name(symbol)
    effect_identity := "None"
    if checked_effect != None {
        effect_name :: jet_codegen_core_effect_name(checked_effect) ?? panic("static Prelude route effect lost its canonical name")
        effect_identity = "Some({effect_name})"
    }
    identity := "{family}:{module_name}:{member}:{symbol_name}:{borrow_mask.len()}:{borrow_mask.len()}:[{mask_names.join(", ")}]:{effect_identity}:{jet_codegen_core_route_fallibility_identity(carrier)}:Value"
    id := MIRPreludeCallID{value: stable_id("mir-prelude-call", identity)}
    call_fallibility :: jet_codegen_core_call_fallibility(carrier, builder, program)
    return jet_codegen_intern_prelude_call(&builder, program, MIRPreludeCall{
        id: id,
        family: family,
        module_name: module_name,
        member: member,
        symbol: symbol,
        signature: MIRCallSignature{arity: borrow_mask.len(), max_arity: borrow_mask.len(), borrow_mask: borrow_mask},
        effect_kind: checked_effect,
        fallibility: call_fallibility,
        abi: MIRPreludeABI.Value,
        authority: None,
        db_metadata: None,
    })
}

fn jet_codegen_static_prelude_call(builder: &JetCodegenBuilder, program: JetCodegenProgram, module_name: String, member: String, symbol: String, borrow_mask: [Bool], route_effect: Effect?, carrier: TFailureCarrier, rooted: Bool) -> MIRPreludeCallID Never! {
    route_symbol := if rooted -> MIRSymbol.Prelude{name: symbol} else -> MIRSymbol.Runtime{name: symbol}
    return jet_codegen_intern_static_call_route(&builder, program, MIRPreludeFamily.StaticPrelude, module_name, member, route_symbol, borrow_mask, route_effect, carrier)
}

fn jet_codegen_prelude_static_call(builder: &JetCodegenBuilder, program: JetCodegenProgram, module_name: String, member: String, symbol: String, carrier: TFailureCarrier) -> MIRPreludeCallID Never! {
    return jet_codegen_intern_static_call_route(&builder, program, MIRPreludeFamily.StaticPrelude, module_name, member, MIRSymbol.Prelude{name: symbol}, [Bool]{}, None, carrier)
}

fn jet_codegen_prelude_column_call(builder: &JetCodegenBuilder, program: JetCodegenProgram, carrier: TFailureCarrier) -> MIRPreludeCallID Never! {
    return jet_codegen_intern_static_call_route(&builder, program, MIRPreludeFamily.ClosureMethod, "core.data.plot", "column", MIRSymbol.Prelude{name: "jet_data_plot_column"}, [Bool]{false, false}, None, carrier)
}

fn jet_codegen_lower_prelude_owner_type_args(builder: JetCodegenBuilder, program: JetCodegenProgram, generics: [TPreludeArg]) -> [MIRPreludeTypeArg] Never! {
    lowered := [MIRPreludeTypeArg]{}
    loop generic in generics {
        &lowered.push(if generic == {
            .Jet(ty) -> MIRPreludeTypeArg.Type{ty: jet_codegen_lower_type_for_function(ty, builder, program)}
            .HostUsize -> MIRPreludeTypeArg.HostUsize
        })
    }
    return lowered
}

fn jet_codegen_lower_prelude_static_call(builder: &JetCodegenBuilder, program: JetCodegenProgram, expression: TExpr, rooted: Bool, path: String, generics: [TPreludeArg], method: TMethodRef, type_args: [Type], args: [TCallArg]) -> MIRValueID {
    borrow_mask := [Bool]{}
    loop argument in args -> &borrow_mask.push(argument.borrow || argument.mut_borrow)
    member := jet_codegen_static_method_key(builder, program, method)
    lowered_args := jet_codegen_lower_static_prelude_args(&builder, program, args, jet_codegen_static_prelude_takes_owned("{path}::{member}"))
    owner_type_args := jet_codegen_lower_prelude_owner_type_args(builder, program, generics)
    lowered_type_args := [MIRType]{}
    loop ty in type_args -> &lowered_type_args.push(jet_codegen_lower_type_for_function(ty, builder, program))

    module_name := if rooted -> "::{path}" else -> path
    carrier := jet_codegen_failure_carrier_for_type(expression.ty)

    if rooted && path == "jet_std::EncodingLimits" && member == "safe" {
        call := jet_codegen_prelude_static_call(&builder, program, "core.encoding", "limits_safe", "jet_std::EncodingLimits::safe", carrier)
        return jet_codegen_emit_value(&builder, program, expression.span, expression.ty, MIROperation.Semantic{operation: MIRSemanticOp.StaticPreludeCall{call: call, args: lowered_args, owner_type_args: owner_type_args, type_args: lowered_type_args}})
    }
    if rooted && path == "jet_std::DataLimits" && member == "safe" {
        call := jet_codegen_prelude_static_call(&builder, program, "core.data", "limits_safe", "jet_std::DataLimits::safe", carrier)
        return jet_codegen_emit_value(&builder, program, expression.span, expression.ty, MIROperation.Semantic{operation: MIRSemanticOp.StaticPreludeCall{call: call, args: lowered_args, owner_type_args: owner_type_args, type_args: lowered_type_args}})
    }
    if module_name == "core.data.plot" && member == "column" && lowered_args.len() == 2 {
        receiver :: lowered_args[0].value
        call := jet_codegen_prelude_column_call(&builder, program, carrier)
        call_args := [MIRCallArg]{}
        loop (index, argument) in lowered_args {
            if index > 0 -> &call_args.push(argument)
        }
        return jet_codegen_emit_value(&builder, program, expression.span, expression.ty, MIROperation.Semantic{operation: MIRSemanticOp.ClosureMethod{receiver: receiver, args: call_args, call: call}})
    }

    symbol := if {
        rooted && path == "JetAuthority" -> {
            if {
                member == "from_rights" -> "jet_authority_from_rights"
                member == "workspace" -> "jet_authority_workspace"
                member == "with" -> "jet_authority_with"
                member == "without" -> "jet_authority_without"
                else -> "{path}::{member}"
            }
        }
        else -> {
            "{path}::{member}"
        }
    }
    route_effect := prelude_route_effect(module_name, member)
    call := jet_codegen_static_prelude_call(&builder, program, module_name, member, symbol, borrow_mask, route_effect, carrier, rooted)
    return jet_codegen_emit_value(&builder, program, expression.span, expression.ty, MIROperation.Semantic{operation: MIRSemanticOp.StaticPreludeCall{call: call, args: lowered_args, owner_type_args: owner_type_args, type_args: lowered_type_args}})
}
