//RS         let mut pending = vec![Item::Tree(plan.entry, body_indent)];
//RS         while let Some(item) = pending.pop() {
//RS             match item {
//RS                 Item::Text(text) => out.push_str(&text),
//RS                 Item::Tree(position, indent) => {
//RS                     if indent > MAX_STRUCTURED_INDENT {
//RS                         return false;
//RS                     }
//RS                     if plan.headers[position] {
//RS                         let id = function.blocks[position].id.0;
//RS                         pending.push(Item::Text(format!("{:indent$}}}\n", "", indent = indent)));
//RS                         pending.push(Item::Within(position, 0, indent + 4));
//RS                         pending.push(Item::Text(format!(
//RS                             "{:indent$}'jet_loop_{id}: loop {{\n",
//RS                             "",
//RS                             indent = indent
//RS                         )));
//RS                     } else {
//RS                         pending.push(Item::Within(position, 0, indent));
//RS                     }
//RS                 }
//RS                 Item::Within(position, follow, indent) => match plan.follows[position].get(follow) {
//RS                     None => pending.push(Item::Block(position, indent)),
//RS                     Some(&merge) => {
