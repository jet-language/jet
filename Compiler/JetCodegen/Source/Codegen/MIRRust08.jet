        test_id :: selected_test.unwrap_or_else(fn() { panic("MIR fuzz harness has no selected property test") })
        test :: self.program.tests.iter().find(fn(test) { test.id == test_id }).unwrap_or_else(fn() { panic("MIR fuzz test ID {test_id:?} has no row") })
        if test.kind != MirTestKind.Property { panic("MIR fuzz test {test.name:?} is not a property test") }
        function :: self.function_row(test.function)
        if !self.module_selected(function.module_id) || !self.selected_for_target(function) { panic("MIR fuzz test {test.name:?} targets an unselected function") }
        reason_opt :: test.generation_unavailable_reason.as_deref()
        generated_reason :: if reason_opt.is_none() { self.property_generation_unavailable_reason(function) } else { None }
        if reason_opt.is_some() {
            reason :: reason_opt.unwrap().replace('"', "\\\"")
            out.push_str(&"fn __jet_fuzz_run() {{ eprintln!(\"E0613: {reason}\"); std::process::exit(1); }}\n")
        } else if generated_reason.is_some() {
