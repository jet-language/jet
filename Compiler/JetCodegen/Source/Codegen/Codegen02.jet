// Rust: crates/jet-codegen/src/Codegen/mod.rs:1991
const CORE_SOURCE_CLOSURE_SCHEMA: [U8] = "jet-core-source-closure-v1".as_bytes()
// Rust: crates/jet-codegen/src/Codegen/mod.rs:1992
const CORE_SOURCE_MARKER_PREFIX: String = "__core_source::"
// Rust: crates/jet-codegen/src/Codegen/mod.rs:1993
const CORE_INTRINSIC_MARKER_PREFIX: String = "__core_intrinsic::"
// Rust: crates/jet-codegen/src/Codegen/mod.rs:1996
fn is_internal_core_usage(usage: String) -> Bool {
    usage.starts_with(CORE_SOURCE_MARKER_PREFIX) || usage.starts_with(CORE_INTRINSIC_MARKER_PREFIX)
}
// Rust: crates/jet-codegen/src/Codegen/mod.rs:2000
fn core_source_usage_matches(usage: String, module: String) -> Bool {
    normalized :: usage.strip_prefix(CORE_SOURCE_MARKER_PREFIX).unwrap_or(usage)
    normalized == module || normalized.starts_with("{module}::")
}
// Rust: crates/jet-codegen/src/Codegen/mod.rs:2008
fn is_archive_core_usage(usage: String) -> Bool { core_source_usage_matches(usage, "core.archive") }
// Rust: crates/jet-codegen/src/Codegen/mod.rs:2012
fn core_needs_embedded_runtime(used_core: HashSet[String]) -> Bool {
    used_core.iter().any(fn(usage) { !is_internal_core_usage(usage) && !is_archive_core_usage(usage) })
}
// Rust: crates/jet-codegen/src/Codegen/mod.rs:2018
fn append_identity_field(bytes: &[U8], value: [U8]) -> {
    &bytes.extend_from_slice(U64{value.len()}.to_be_bytes())
    &bytes.extend_from_slice(value)
}
// Rust: crates/jet-codegen/src/Codegen/mod.rs:2023
fn core_source_closure_fingerprint(used_core: HashSet[String]) -> String {
    usages := used_core.iter().collect()
    &usages.sort_unstable()
    bytes := []
    &bytes.extend_from_slice(CORE_SOURCE_CLOSURE_SCHEMA)
    loop usage in usages { append_identity_field(&bytes, usage.as_bytes()) }
    loop source_module in core_source_modules() {
        if !used_core.iter().any(fn(usage) { core_source_usage_matches(usage, source_module.module) }) { continue }
        append_identity_field(&bytes, source_module.module.as_bytes())
        append_identity_field(&bytes, source_module.path.as_bytes())
        append_identity_field(&bytes, core_source_body(source_module.module).as_bytes())
    }
    // Private parts contribute their public owner's cache identity only.
    loop part in CORE_PRIVATE_SOURCE_PARTS {
        if !used_core.iter().any(fn(usage) { core_source_usage_matches(usage, part.owner) }) { continue }
        append_identity_field(&bytes, part.owner.as_bytes())
        append_identity_field(&bytes, part.source.module.as_bytes())
        append_identity_field(&bytes, part.source.alias.as_bytes())
        append_identity_field(&bytes, part.source.path.as_bytes())
        append_identity_field(&bytes, core_source_body(part.source.module).as_bytes())
    }
    sha256_hex(bytes)
}
// Rust: crates/jet-codegen/src/Codegen/mod.rs:2060
fn core_source_body(module: String) -> String {
    core_source_text(module).unwrap_or_else(fn() { panic("Core source module `{module}` has no body text") })
}
// Rust: crates/jet-codegen/src/Codegen/mod.rs:2065
fn corelib_emission_identity(body: String, used_core: HashSet[String]) -> String {
    source :: core_source_closure_fingerprint(used_core)
    closure :: sha256_hex(body.as_bytes())
    identity := []
    &identity.extend_from_slice(CORE_SOURCE_CLOSURE_SCHEMA)
    append_identity_field(&identity, source.as_bytes())
    append_identity_field(&identity, closure.as_bytes())
    append_identity_field(&identity, body.len().to_string().as_bytes())
    fingerprint :: sha256_hex(identity)
    "/* jet-corelib-r10 source={source} closure={closure} len={body.len()} fp={fingerprint} */"
}
// Rust: crates/jet-codegen/src/Codegen/mod.rs:2080
fn core_usage_matches(used: HashSet[String], prefixes: [String]) -> Bool {
    used.iter().any(fn(usage) { prefixes.iter().any(fn(prefix) {
        usage == prefix || usage.starts_with("{prefix}::") || usage.starts_with("{prefix}.")
    }) })
}
// Rust: crates/jet-codegen/src/Codegen/mod.rs:2095
// This is the sole lowering boundary that interprets legacy Core-use labels.
pub fn runtime_parts_for_used_core(used_core: BTreeSet[String]) -> BTreeSet[MirRuntimePartId] {
    matches :: fn(prefixes: [String]) -> Bool {
        used_core.iter().any(fn(usage) { prefixes.iter().any(fn(prefix) {
            usage == prefix || usage.starts_with("{prefix}::") || usage.starts_with("{prefix}.")
        }) })
    }
    parts := BTreeSet.new()
    if matches(["core.event"]) { _ :: &parts.insert(.Event) }
    if matches(["core.rt", "core.realtime"]) { _ :: &parts.insert(.Realtime) }
    if matches(["core.hardware", "core.embedded", "core.board", "core.device"]) { _ :: &parts.insert(.EmbeddedHardware) }
    if matches(["core.ui", "core.font", "core.web", "app", "core.args"]) { _ :: &parts.insert(.Ui) }
    if matches(["core.ui", "core.devtools", "core.web", "app"]) { _ :: &parts.insert(.Devtools) }
    if matches(["core.ui::gtk_backend", "core.ui.gtk_backend"]) { _ :: &parts.insert(.Gtk) }
    if matches(["app", "core.web", "core.http", "core.http.client", "core.http.server", "core.web.devserver", "core.web.browser"]) { _ :: &parts.insert(.Apps) }
    if matches(["core.email"]) { _ :: &parts.insert(.Email) }
    if matches(["core.game", "core.game.raylib", "core.raylib"]) { _ :: &parts.insert(.Game) }
    if matches(["core.files", "core.watcher", "core.term", "core.sys", "core.process"]) { _ :: &parts.insert(.Files) }
    if matches(["core.sys::on_interrupt", "core.sys.on_interrupt", "core.process::on_signal", "core.process.on_signal"]) { _ :: &parts.insert(.Interrupt) }
    if matches(["core.files", "core.watcher", "core.term", "core.sys", "core.process", "core.args", "core.testing", "core.perf", "core.mem.scope"]) { _ :: &parts.insert(.FsRuntime) }
    if matches(["core.crypto"]) { _ :: &parts.insert(.Crypto) }
    if matches(["core.math", "core.math.random", "core.time", "core.time.expiring", "core.units"]) { _ :: &parts.insert(.Math) }
    if matches(["core.encoding", "core.encoding.json", "core.encoding.jsonl", "core.encoding.csv", "core.encoding.toml", "core.encoding.yaml", "core.encoding.xml", "core.encoding.cbor", "core.encoding.hex", "core.archive.gzip", "core.archive.zstd"]) { _ :: &parts.insert(.Encoding) }
    if matches(["core.data", "core.data.sketch.hll", "core.data.sketch.tdigest", "core.data.sketch.cms", "core.data.sketch.reservoir", "core.db", "core.encoding.csv"]) { _ :: &parts.insert(.Data) }
    if matches(["core.text.fmt"]) { _ :: &parts.insert(.Fmt) }
    if matches(["core.data", "core.data.sketch.hll", "core.data.sketch.tdigest", "core.data.sketch.cms", "core.data.sketch.reservoir", "core.db", "core.encoding", "core.encoding.json", "core.encoding.jsonl", "core.encoding.csv", "core.encoding.toml", "core.encoding.yaml", "core.encoding.xml", "core.encoding.cbor", "core.encoding.hex", "core.archive.gzip", "core.archive.zstd"]) { _ :: &parts.insert(.DataFmt) }
    if matches(["core.compute"]) { _ :: &parts.insert(.Compute) }
    if matches(["core.http", "core.http.client", "core.http.server", "core.web", "core.web.devserver"]) { _ :: &parts.insert(.Http) }
    if matches(["core.net.ws", "app", "core.web", "core.db", "core.http", "core.http.client", "core.http.server", "core.web.browser"]) { _ :: &parts.insert(.WebSocket) }
    if matches(["core.web.browser", "core.web", "core.web.storage", "core.web.storage.local", "core.web.storage.session"]) { _ :: &parts.insert(.Browser) }
    if matches(["core.args"]) { _ :: &parts.insert(.Args) }
    if matches(["core.reflect", "core.compiler.lang"]) { _ :: &parts.insert(.Reflect) }
    if matches(["core.auth"]) || parts.contains(.Crypto) { _ :: &parts.insert(.AuthTokens) }
    if matches(["core.auth", "app", "core.web"]) { _ :: &parts.insert(.AuthSession) }
    if matches(["core.sync", "app", "core.web", "core.db"]) { _ :: &parts.insert(.Sync) }
    if matches(["core.service", "core.jobs"]) { _ :: &parts.insert(.Services) }
    if matches(["core.mod"]) { _ :: &parts.insert(.Mod) }
    parts
}
