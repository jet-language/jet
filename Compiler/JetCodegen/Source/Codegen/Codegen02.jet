// Rust: crates/jet-codegen/src/Codegen/mod.rs:2335
fn push_corelib_prelude_inner(out: &String, used_core: HashSet[String], force: Bool, omit_testing_shared: Bool, policy: ReleaseDevtoolsPolicy) -> {
