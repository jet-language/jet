// Rust: crates/jet-codegen/src/Codegen/mod.rs:1969
fn strip_source_shared_interop_jit(kernel: String) -> String {
    begin :: "    // jet:source-shared-interop-jit-begin\n"
    end_marker :: "    // jet:source-shared-interop-jit-end\n"
    start :: if kernel.find(begin) == { .Some(index) -> index .None -> return kernel.to_string() }
    offset :: if kernel[start..].find(end_marker) == { .Some(index) -> index .None -> return kernel.to_string() }
    end :: start + offset + end_marker.len()
    out := String.with_capacity(kernel.len() - (end - start))
    &out.push_str(kernel[..start])
    &out.push_str(kernel[end..])
    out
}
