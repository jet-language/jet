}
// Rust: crates/jet-codegen/src/Codegen/mod.rs:2352
fn push_corelib_prelude_inner_with_forces(out: &String, used_core: HashSet[String], force: Bool, omit_testing_shared: Bool, forces: CorePreludeForces, policy: ReleaseDevtoolsPolicy) -> {
    // Archive is ordinary reachable Jet source, never a legacy-template fallback.
    if !force && !core_needs_embedded_runtime(used_core) { return }
    body := ""
    push_corelib_prelude_body(&body, used_core, omit_testing_shared, forces, policy)
    &out.push_str(corelib_emission_identity(body, used_core))
    &out.push('\n')
    &out.push_str(body)
}
// Rust: crates/jet-codegen/src/Codegen/mod.rs:2375
fn type_uses_stream(ty: Type) -> Bool {
    if ty == {
        .Apply(name, args) -> name == "Stream" || args.iter().any(type_uses_stream)
        .List(inner) | .Shared(inner) | .Option(inner) | .FixedList(inner, ..) | .Tagged(inner, ..) -> type_uses_stream(inner)
        .Map(key, value, ..) | .Result(key, value) -> type_uses_stream(key) || type_uses_stream(value)
        .Tuple(fields) -> fields.iter().any(fn((_, field)) { type_uses_stream(field) })
        .Union(members) -> members.iter().any(type_uses_stream)
        .Fn(params, ret, ..) -> params.iter().any(type_uses_stream) || ret.is_some_and(type_uses_stream)
        else -> false
    }
}
// Rust: crates/jet-codegen/src/Codegen/mod.rs:2397
fn func_uses_stream(func: Func) -> Bool {
    func.params.iter().any(fn(param) { type_uses_stream(param.ty) }) || func.return_type.is_some_and(type_uses_stream)
}
// Rust: crates/jet-codegen/src/Codegen/mod.rs:2402
fn trait_method_uses_stream(method: TraitMethodSig) -> Bool {
    method.params.iter().any(fn(param) { type_uses_stream(param.ty) }) || method.return_type.is_some_and(type_uses_stream)
}
// Rust: crates/jet-codegen/src/Codegen/mod.rs:2410
fn items_use_stream(items: [Item]) -> Bool {
    items.iter().any(fn(item) {
        if item == {
            .Func(func) -> func_uses_stream(func)
            .Struct(def) -> def.fields.iter().any(fn(field) { type_uses_stream(field.ty) }) || def.methods.iter().any(func_uses_stream) || def.trait_impls.iter().any(fn(block) { block.methods.iter().any(func_uses_stream) || block.assoc_type_impls.iter().any(fn((_, _, ty)) { type_uses_stream(ty) }) })
            .Enum(def) -> def.variants.iter().any(fn(variant) {
                if variant.payload == {
                    .Unit -> false
                    .Single(ty, _) -> type_uses_stream(ty)
                    .Named(fields) -> fields.iter().any(fn(field) { type_uses_stream(field.ty) })
                }
            }) || def.methods.iter().any(func_uses_stream) || def.trait_impls.iter().any(fn(block) { block.methods.iter().any(func_uses_stream) || block.assoc_type_impls.iter().any(fn((_, _, ty)) { type_uses_stream(ty) }) })
            .Distinct(def) -> type_uses_stream(def.base)
            .TypeAlias(def) -> type_uses_stream(def.target)
            .Trait(def) -> def.methods.iter().any(trait_method_uses_stream)
            .Impl(def) -> def.methods.iter().any(func_uses_stream) || def.assoc_type_impls.iter().any(fn((_, _, ty)) { type_uses_stream(ty) })
            .ExternRust(def) -> def.functions.iter().any(fn(func) { func.params.iter().any(fn(param) { type_uses_stream(param.ty) }) || func.return_type.is_some_and(type_uses_stream) })
            .ProtocolDecl(def) -> def.messages.iter().any(fn(message) { message.fields.iter().any(fn((_, ty)) { type_uses_stream(ty) }) })
            .CodeModule(def) -> def.body.is_some_and(items_use_stream)
            .GenericModule(def) -> items_use_stream(def.body)
            else -> false
        }
    })
}
// Rust: crates/jet-codegen/src/Codegen/mod.rs:2464
fn uses_stream(bundle: ProgramBundle) -> Bool { bundle.modules.iter().any(fn(module) { items_use_stream(module.items) }) }
// Rust: crates/jet-codegen/src/Codegen/mod.rs:2471
fn force_corelib_prelude(bundle: ProgramBundle) -> Bool { uses_stream(bundle) }
// Rust: crates/jet-codegen/src/Codegen/mod.rs:2480
fn core_runtime_body(bundle: ProgramBundle, test_harness: Bool) -> String {
    core_runtime_body_with_policy(bundle, test_harness, ReleaseDevtoolsPolicy.development())
}
// Rust: crates/jet-codegen/src/Codegen/mod.rs:2484
fn core_runtime_body_with_policy(bundle: ProgramBundle, test_harness: Bool, policy: ReleaseDevtoolsPolicy) -> String {
    force_corelib :: force_corelib_prelude(bundle)
    if !force_corelib && !core_needs_embedded_runtime(bundle.used_core) { return "" }
    body := ""
    push_package_edition(&body, bundle)
    &body.push_str(core_runtime_body_for_with_policy(bundle.used_core, bundle.active_os, force_corelib, test_harness, policy))
    body
}
// Rust: crates/jet-codegen/src/Codegen/mod.rs:2508
fn core_runtime_body_for_with_policy(used_core: HashSet[String], active_os: Syntax.OSTarget, force_corelib: Bool, test_harness: Bool, policy: ReleaseDevtoolsPolicy) -> String {
    if !force_corelib && !core_needs_embedded_runtime(used_core) { return "" }
    body := ""
    if test_harness { push_corelib_prelude_for_test_harness_with_policy(&body, used_core, force_corelib, policy) }
    else { push_corelib_prelude_with_policy(&body, used_core, force_corelib, policy) }
    &body.push_str(scheduler_prelude_for_emit(uses_native_scheduler_for(used_core)))
    if force_corelib || core_usage_matches(used_core, ["core.event"]) {
        &body.push_str(CORE_STREAM_PRELUDE_RAW)
        &body.push_str(CORE_STREAM_DURATION_ADAPTER)
    }
    &body.push_str(include_str("crates/jet-codegen/src/Prelude/Core/CollectionSources.rs"))
    if core_usage_matches(used_core, ["core.rt", "core.realtime"]) { &body.push_str(CORE_REALTIME_PRELUDE_RAW) }
    if core_usage_matches(used_core, ["core.board", "core.hardware", "core.device", "core.embedded"]) { &body.push_str(flat_prelude_body(CORE_EMBEDDED_HARDWARE_PRELUDE_RAW)) }
    &body.push_str(flat_prelude_body(CORE_PARALLEL_PLAN_PRELUDE_RAW))
    needs_ui_host :: core_usage_matches(used_core, ["core.ui", "core.font", "core.web", "app"])
    needs_ui_surface :: core_usage_matches(used_core, ["core.ui", "core.web", "app"])
    if needs_ui_host {
        &body.push_str(canonical_font_prelude())
        &body.push_str(include_str("crates/jet-codegen/src/Prelude/Core/HostServices.rs"))
    }
    if needs_ui_surface {
        &body.push_str("\nmod jet_tui_kernel {{\n")
        &body.push_str(TUI_KERNEL_PRELUDE)
        &body.push_str("\n}}\n")
        &body.push_str(UI_PRELUDE)
        &body.push_str(PREVIEW_PRELUDE)
    }
    if policy.panel_code && core_usage_matches(used_core, ["core.ui", "core.devtools"]) {
        &body.push_str(DEVTOOLS_PANEL_PRELUDE)
        &body.push_str(DEVTOOLS_PANEL_CATALOG_PRELUDE_RAW)
        &body.push_str(DEVTOOLS_DATABASE_PANEL_PRELUDE_RAW)
        &body.push_str(DEVTOOLS_JOBS_PANEL_PRELUDE_RAW)
        &body.push_str(DEVTOOLS_REQUEST_PANEL_PRELUDE_RAW)
        &body.push_str(DEVTOOLS_TELEMETRY_PANEL_PRELUDE_RAW)
        &body.push_str(DEVTOOLS_TOPOLOGY_PANEL_PRELUDE_RAW)
    }
    if uses_gtk_backend_for(used_core, active_os) { &body.push_str(UI_GTK_PRELUDE) }
    push_app_preludes(&body, used_core)
    body
}
