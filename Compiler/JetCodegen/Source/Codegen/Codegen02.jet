    monotonic_provider :: if machine.monotonic_clock == {
        .Provider(provider) -> Some(provider)
        .HostedDefault -> panic("portable Prelude cannot inherit a hosted monotonic clock")
        .None | .Unspecified -> None
    }
    sleep_provider :: if machine.sleep == {
        .Provider(provider) -> Some(provider)
        .HostedDefault -> panic("portable Prelude cannot inherit a hosted sleep provider")
        .None | .Unspecified -> None
    }
