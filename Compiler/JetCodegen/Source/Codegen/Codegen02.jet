fn push_portable_target_bindings(out: &String, machine: TargetMachine, include_alloc: Bool) -> {
    panic_provider :: if machine.panic == { .Report(provider) -> Some(provider) else -> None }
    provider_allocator :: if machine.allocator == { .Provider(..) -> true else -> false }
