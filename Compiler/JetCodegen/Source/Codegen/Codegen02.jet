fn push_corelib_prelude_for_test_harness_with_forces(out: &String, used_core: HashSet[String], force: Bool, forces: CorePreludeForces, policy: ReleaseDevtoolsPolicy) -> {
    push_corelib_prelude_inner_with_forces(out, used_core, force, true, forces, policy)
    &out.push_str(REPORT_PRELUDE)
