pub fn push_portable_corelib_prelude(out: &String, program: MirProgram, artifact: MirArtifactPlan) -> {
    dossier :: program.facts.target_dossier
    machine :: dossier.machine.expect("portable Prelude emission requires a checked target machine")
    assert(machine.no_os, "portable Prelude emission requires a no-OS target machine")
    assert(artifact.target == .RustAot, "portable Prelude emission requires a RustAot artifact")
    if machine.panic == {
        .Abort | .Report(..) -> {}
        .HostedDefault | .Unspecified -> panic("portable Prelude requires an explicit no-OS panic policy")
    }
    include_hardware :: artifact.runtime_parts.contains(.EmbeddedHardware)
    include_alloc :: if dossier.layer == {
        .Core -> false
        .Alloc -> true
        .Std -> panic("portable Prelude cannot emit the hosted runtime layer")
    }
    if include_alloc && !(if machine.allocator == { .Fixed(..) -> true else -> false }) {
        if machine.allocator == {
            .Provider(provider) -> assert(provider.abi.calling_convention == "C" && provider.abi.version == "1", "portable target allocator provider `{provider.provider}` requires the C/1 ABI")
            .None -> panic("portable Alloc closure requires a declared allocator")
            .Unspecified -> panic("portable Alloc closure requires an explicit allocator policy")
            .HostedDefault | .Counting(..) -> panic("portable Alloc closure cannot use a hosted allocator policy")
            .Fixed(..) -> unreachable()
        }
    }
    provider_allocator :: if machine.allocator == { .Provider(..) -> true else -> false }
    include_atomic :: machine.provides_capability(.Atomic64)
    if include_atomic {
        &out.push_str("// JET_VETTED_UNSAFE_BEGIN: jet_atomic_carrier\n")
        &out.push_str(flat_prelude_body(CORE_ATOMIC_PRELUDE_RAW))
        &out.push_str("// JET_VETTED_UNSAFE_END: jet_atomic_carrier\n")
        &out.push_str("\nmod jet_std {{\n    #[inline(always)]\n    pub fn jet_int_add(left: i64, right: i64) -> i64 {{\n        left.checked_add(right).unwrap_or_else(|| {{\n            super::jet_arithmetic_stop(\n                \"\",\n                0,\n                super::JET_ARITHMETIC_ADD_OVERFLOW,\n            )\n        }})\n    }}\n}}\n")
        &out.push('\n')
    }
    push_prelude_dependency_closure(out, ["runtime_diagnostic_core"])
    &out.push_str(portable_runtime_diagnostic_projection())
    runtime_parts :: artifact.runtime_parts.iter().map(fn(part) { "{part.as_str():?}" }).collect().join(", ")
    &out.push_str("\nconst __JET_TARGET_NAME: &str = {machine.name:?};\nconst __JET_TARGET_TRIPLE: &str = {machine.triple:?};\nconst __JET_TARGET_PROVIDER_IDENTITY: &str = {artifact.provider_identity:?};\nconst __JET_TARGET_CLOSURE_IDENTITY: &str = {artifact.closure_identity:?};\nconst __JET_TARGET_LINKER_IDENTITY: &str = {dossier.linker_identity:?};\nconst __JET_TARGET_ARTIFACT_IDENTITY: &str = {artifact.artifact_identity:?};\nconst __JET_TARGET_RUNTIME_LAYER: &str = {dossier.layer.as_str():?};\nconst __JET_TARGET_RUNTIME_PARTS: &[&str] = &[{runtime_parts}];\nconst __JET_CHECKED_CORE_CALL_COUNT: usize = {program.core_calls.len()};\nconst __JET_CHECKED_PRELUDE_CALL_COUNT: usize = {program.prelude_calls.len()};\n")
    push_portable_prelude_imports(out, include_atomic, include_hardware, include_alloc)
    &out.push_str(flat_prelude_body(CORE_FIXED_ARITHMETIC_PRELUDE_RAW))
    &out.push_str(flat_prelude_body(PORTABLE_CORE_PRELUDE_RAW))
    &out.push_str(include_str("crates/jet-foundation/src/NumericConversion.rs"))
    &out.push_str(include_str("crates/jet-codegen/src/Prelude/Core/NumericRuntime.rs"))
    &out.push_str(flat_prelude_body(CORE_POWER_PRELUDE_RAW))
    &out.push_str(flat_prelude_body(CORE_DIVISION_PRELUDE_RAW))
    &out.push_str(flat_prelude_body(TARGET_ADAPTERS_PRELUDE_RAW))
    if include_hardware { &out.push_str(flat_prelude_body(portable_embedded_hardware_source())) }
    if include_alloc {
        push_prelude_dependency_closure(out, ["fixed_allocator"])
        &out.push_str(flat_prelude_body(PORTABLE_ALLOC_PRELUDE_RAW))
        if provider_allocator {
            &out.push_str("\n#[global_allocator]\nstatic __JET_TARGET_ALLOCATOR: JetTargetAllocator =\n    JetTargetAllocator::from_callbacks(jet_target_alloc_impl, jet_target_dealloc_impl);\n")
        } else {
            &out.push_str("\n#[global_allocator]\nstatic __JET_TARGET_ALLOCATOR: JetHeapAllocator = JetHeapAllocator::new();\n")
        }
    }
    if artifact.runtime_parts.contains(.Gc) { push_gc_prelude_for_target(out, true) }
    push_portable_target_bindings(out, machine, include_alloc)
    &out.push('\n')
