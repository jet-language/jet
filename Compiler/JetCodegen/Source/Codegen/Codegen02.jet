// Rust: crates/jet-codegen/src/Codegen/mod.rs:3346
fn push_runtime_devtools_panel_preludes(out: &String, devtools_panel_code: Bool, has_devtools_panel: Bool, needs_database_panel: Bool, needs_request_panel: Bool, needs_topology_panel: Bool) -> {
    if devtools_panel_code && has_devtools_panel { return }
    if needs_database_panel { &out.push_str(DEVTOOLS_DATABASE_PANEL_PRELUDE_RAW) }
    if needs_request_panel { &out.push_str(DEVTOOLS_REQUEST_PANEL_PRELUDE_RAW) }
    if needs_topology_panel { &out.push_str(DEVTOOLS_TOPOLOGY_PANEL_PRELUDE_RAW) }
}
// Rust: crates/jet-codegen/src/Codegen/mod.rs:3368
fn push_typed_app_preludes(out: &String, runtime_parts: BTreeSet[MirRuntimePartId]) -> {
    if runtime_parts.contains(.Sync) || runtime_parts.contains(.Apps) { &out.push_str(LIVEQUERY_PRELUDE) }
    if !runtime_parts.contains(.Apps) { return }
    push_app_middleware_prelude(out)
    &out.push_str(flat_prelude_body(CORE_WEB_PENDING_PRELUDE_RAW))
    &out.push_str(flat_prelude_body(WEB_ROUTER_PRELUDE_RAW))
    &out.push_str(flat_prelude_body(OPENAPI_PRELUDE_RAW))
    &out.push_str(flat_prelude_body(WEB_QUERY_PRELUDE_RAW))
    &out.push_str(flat_prelude_body(WEB_FORMS_PRELUDE_RAW))
    &out.push_str(flat_prelude_body(WEB_TABLE_PRELUDE_RAW))
    &out.push_str(flat_prelude_body(WEB_VIRTUAL_PRELUDE_RAW))
    &out.push_str(flat_prelude_body(WEB_STORE_PRELUDE_RAW))
    &out.push_str(flat_prelude_body(WEBSERVERFN_PRELUDE_RAW))
}
// Rust: crates/jet-codegen/src/Codegen/mod.rs:3403
pub fn corelib_emission_fingerprint(bundle: ProgramBundle, test_harness: Bool) -> String {
    corelib_emission_fingerprint_with_policy(bundle, test_harness, ReleaseDevtoolsPolicy.development())
}
// Rust: crates/jet-codegen/src/Codegen/mod.rs:3411
pub fn corelib_emission_fingerprint_with_policy(bundle: ProgramBundle, test_harness: Bool, policy: ReleaseDevtoolsPolicy) -> String {
    used_core := bundle.used_core.iter().cloned().collect()
    &used_core.sort_unstable()
    cache_key :: CoreEmissionFingerprintKey{used_core: ^used_core, active_os: bundle.active_os.name().to_string(), edition: bundle.edition.clone(), force_corelib: force_corelib_prelude(bundle), test_harness: test_harness, release_inspect: policy.release_cfg_value().map(fn(value) { value.to_string() }), devtools_panel_code: policy.panel_code, devtools_stream_code: policy.stream_code}
    // GATE #4494: synchronized process-local once-initialized bounded digest cache.
    cache :: CORELIB_EMISSION_FINGERPRINTS.get_or_init(fn() { Mutex.new([:]) })
    {
        entries :: cache.lock().unwrap()
        if entries.get(cache_key).cloned() == .Some(fingerprint) { return fingerprint }
    }
    body :: core_runtime_body_with_policy(bundle, test_harness, policy)
    fingerprint :: corelib_emission_identity(body, bundle.used_core)
    entries := cache.lock().unwrap()
    if entries.len() >= CORELIB_DIGEST_CACHE_LIMIT {
        keys := entries.keys().cloned().collect()
        &keys.sort_unstable()
        if keys.first() == .Some(oldest) { _ :: &entries.remove(oldest) }
    }
    _ :: &entries.insert(cache_key, fingerprint.clone())
    fingerprint
}
// Rust: crates/jet-codegen/src/Codegen/mod.rs:3450
pub struct CoreClosureProof {
    pub used_calls: [String]
    pub synthesized_calls: [String]
    pub adapter_routes: [String]
    pub fingerprint: String
}
// Rust: crates/jet-codegen/src/Codegen/mod.rs:3461
pub fn core_closure_proof(bundle: ProgramBundle, test_harness: Bool) -> CoreClosureProof {
    used_calls := bundle.used_core.iter().cloned().collect()
    &used_calls.sort_unstable()
    body :: core_runtime_body(bundle, test_harness)
    synthesized_calls := []
    loop line in body.lines() {
        trimmed := line.trim_start() // #4303
        prefix :: trimmed.strip_prefix("pub fn ").or_else(fn() { trimmed.strip_prefix("fn ") })
        if prefix == .Some(rest) {
            if rest.split('(').next() == .Some(name) {
                if name.starts_with("jet_") { &synthesized_calls.push(name.to_string()) }
            }
        }
    }
    &synthesized_calls.sort_unstable()
    &synthesized_calls.dedup()
    imports :: core_imports_for_bundle(bundle)
    adapter_routes :: if body.is_empty() && imports.is_empty() -> ["none"] else -> ["aot:embedded-prelude", "jit:core-import-map", "interpreter:core-import-map"]
    CoreClosureProof{used_calls: ^used_calls, synthesized_calls: ^synthesized_calls, adapter_routes: adapter_routes, fingerprint: corelib_emission_fingerprint(bundle, test_harness)}
}
// Rust: crates/jet-codegen/src/Codegen/mod.rs:3497
fn push_corelib_prelude_body(out: &String, used_core: HashSet[String], omit_testing_shared: Bool, forces: CorePreludeForces, policy: ReleaseDevtoolsPolicy) -> {
    &out.push_str(LIVE_LIFECYCLE_PRELUDE)
    &out.push_str(DATATREE_FOUNDATION_ROOT)
    &out.push_str(include_str("crates/jet-codegen/src/Prelude/Core/SimdLanes.rs"))
    &out.push_str("// JET_VETTED_UNSAFE_BEGIN: jet_atomic_carrier\n")
    &out.push_str(flat_prelude_body(CORE_ATOMIC_PRELUDE_RAW))
    &out.push_str("// JET_VETTED_UNSAFE_END: jet_atomic_carrier\n")
    &out.push('\n')
    &out.push('\n')
    &out.push_str("\nmod jet_xml_pull {{\n")
    &out.push_str(include_str("crates/jet-foundation/src/XmlPull.rs"))
    &out.push_str("\n}}\n\n#[allow(non_snake_case)]\nmod XmlPull {{ pub use crate::jet_xml_pull::*; }}\n")
    &out.push_str("\nmod jet_xml_kernel {{\n")
    &out.push_str(include_str("crates/jet-foundation/src/XmlKernel.rs"))
    &out.push_str("\n}}\n\nmod jet_cbor_budget {{\n")
    &out.push_str(include_str("crates/jet-foundation/src/CborBudget.rs"))
    &out.push_str("\n}}\n\n#[allow(non_snake_case)]\nmod CborBudget {{ pub use crate::jet_cbor_budget::*; }}\n")
    &out.push_str("\nmod jet_cbor_kernel {{\n")
    &out.push_str(include_str("crates/jet-foundation/src/CborKernel.rs"))
    &out.push_str("\n}}\n\nmod jet_csv_kernel {{\n")
    &out.push_str(include_str("crates/jet-foundation/src/CsvKernel.rs"))
    &out.push_str("\n}}\n\nmod jet_base_encoding_strict {{\n")
    &out.push_str(include_str("crates/jet-foundation/src/BaseEncodingStrict.rs"))
    &out.push_str("\n}}\n\nmod jet_regex_syntax {{\n")
    &out.push_str(include_str("crates/jet-foundation/src/RegexSyntax.rs"))
    &out.push_str("\n}}\n")
    needs_xml :: core_usage_matches(used_core, ["core.encoding.xml", "core.encoding"])
    needs_base :: core_usage_matches(used_core, ["core.encoding", "core.encoding.hex", "core.encoding.cbor", "core.encoding"])
    _needs_regex :: core_usage_matches(used_core, ["core.regex"])
    needs_files :: core_usage_matches(used_core, ["core.files", "core.watcher", "core.term", "core.sys", "core.process"])
    needs_fs_runtime :: needs_files || core_usage_matches(used_core, ["core.args", "core.process", "core.testing", "core.perf", "core.mem.scope"])
    needs_mapped_file :: forces.mapped_file || needs_fs_runtime
    needs_shared :: forces.shared || core_usage_matches(used_core, ["core.mem::pool_shared", "core.mem.pool_shared"])
    &out.push_str(include_str("crates/jet-codegen/src/Prelude/Core/FileHandleOwners.rs"))
    loop part in CORELIB_KERNEL_PARTS {
        if (!needs_mapped_file && part == MAPPED_FILE_PRELUDE) || (!needs_shared && part == SHARED_ROUTES_PRELUDE) { continue }
        // The Source Shared interop region is JIT-only; its emission continues in packet 2049.
        append_corelib_kernel_part(out, part)
    }
    push_corelib_prelude_body_tail(out, used_core, omit_testing_shared, forces, policy, needs_xml, needs_base, needs_files, needs_fs_runtime)
}
