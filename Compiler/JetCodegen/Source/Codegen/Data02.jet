// Rust: crates/jet-codegen/src/Codegen/TIR/tir_to_mir_expr.rs:3482
fn fmt_exact_int(ty: Type) -> Bool Never! {
    if ty.without_user_tags() == {
        .Int | .IntN(_, _) -> true
        .InlineRange(base, _, _) -> fmt_exact_int(base)
        .Named(name) -> name == "Int"
        .Tagged(_, inner) -> fmt_exact_int(inner)
        _ -> false
    }
}

