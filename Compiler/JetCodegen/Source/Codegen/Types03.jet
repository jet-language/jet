// Rust: crates/jet-codegen/src/Codegen/TIR/tir_to_mir_types.rs:3000
pub fn is_compiler_owned_type(name: String) -> Bool {
    source_name := name
    name := core_source_type_leaf(name)
    COMPILER_OWNED_ENUMS.iter().any(fn(entry) { (owned, _) := entry; owned == name })
        || (CoreModuleExports.core_enum_variants(name).is_some() && (!source_name.starts_with("<corelib>/") || core_rust_type_name(source_name).is_some()))
        || COMPILER_OWNED_CORE_RECORDS.iter().any(fn(entry) { (owned, _) := entry; owned == name })
        || COMPILER_OWNED_MATH_RECORDS.iter().any(fn(entry) { (owned, _) := entry; owned == name })
        || COMPILER_OWNED_GEOMETRY_RECORDS.iter().any(fn(entry) { (owned, _, _) := entry; owned == name })
        || core_email_rust_type_name(name).is_some() || core_crypto_rust_type_name(name).is_some()
        || core_rust_type_name(name) == Val("JetMappedFile")
        || (source_name.starts_with("<corelib>/Core/files::") && (if file_handle_rust_type(source_name) == { Val("JetFileReader" | "JetFileWriter" | "JetFileScope") -> true; else -> false }))
        || name == Syntax.TYPE_MEASUREMENT || name == Syntax.TYPE_ERR
        || (if name == { "VJPRun" | "Group" | "DataJoin" | "DataSnapshot" | "DataPivotCell" | "DataSummary" | "FieldError" | "AllocError" | "KeyRef" | "MutationPlan" | "VaultWrite" | "Rotation" | Syntax.TYPE_RANGE -> true; else -> false })
}
// Rust: crates/jet-codegen/src/Codegen/TIR/tir_to_mir_types.rs:3044
pub fn compiler_owned_enum_variants(name: String) -> &[String]? {
    COMPILER_OWNED_ENUMS.iter().find(fn(entry) { (owned, _) := entry; owned == name }).map(fn(entry) { (_, variants) := entry; variants })
}
// Rust: crates/jet-codegen/src/Codegen/TIR/tir_to_mir_types.rs:3053
fn compiler_owned_core_enums(module: String, checked_nominals: &MirFragmentNominalFacts?) -> [TirTypeDef] {
    span := Span.new(0, 0)
    seen := HashSet<String>.new()
    checked_payloads := checked_core_enum_payloads(checked_nominals)
    CoreModuleExports.core_modules().iter().flat_map(fn(entry) {
        source_module := entry.module
        entry.type_exports.iter().map(fn(export) { (name, _) := export; (source_module, name) })
    }).filter_map(fn(entry) {
        (source_module, name) := entry
        if compiler_owned_enum_variants(name).is_some() -> return None
        variants := CoreModuleExports.core_enum_variants(name) ?? return None
        if !seen.insert(name) -> return None
        // GATE #4499: canonical (source module, name) key equality.
        if checked_payloads.get((source_module, name)) == Val(definition) {
            definition := definition.clone()
            definition.name = name.to_string()
            identity := fn(ty: &Type, _: &[String]) { ty.clone() }
            row := lower_enum(definition, module, identity, None, HashSet.new(), false, false)
            row.key = name.to_string()
            return Val(row)
        }
        Val(TirTypeDef{module: module.to_string(), key: name.to_string(), name: name.to_string(), span: span,
            public: true, package_public: false, generic_params: [], derives: [], auto_derive_default: false, auto_printable: false,
            published_schema: false, single_use: false, must_use: false, layout: None, layout_alignment: None, c_layout_tag: None,
            enum_layout: None, serde: [], cli_bindings: [], cli: None, ownership: TirOwnership.Owned, boxed_edges: [], compiler_builtin: None,
            kind: TirTypeDefKind.Enum{variants: variants.iter().map(fn(variant) {
                TirVariant{name: variant.to_string(), wire_name: variant.to_string(), span: span, payload: TirVariantPayload.Unit, discriminant: None}
            }).collect(), methods: []}})
    }).collect()
}
// Rust: crates/jet-codegen/src/Codegen/TIR/tir_to_mir_types.rs:3139
fn checked_core_enum_payloads(checked_nominals: &MirFragmentNominalFacts?) -> [(String, String): &EnumDef] {
    payloads := [(String, String): &EnumDef]{}
    checked_nominals := checked_nominals ?? return payloads
    for (identity, definition) in checked_nominals.enums {
        module_alias := checked_nominals.foreign_modules.get(identity) ?? continue
        source := CoreModuleExports.core_source_module_by_alias(module_alias) ?? continue
        name := core_source_type_leaf(identity)
        if !(CoreModuleExports.core_leaf_kind(source.module, name) is Val(.Enum(_))) || !definition.variants.iter().any(fn(variant) { !(variant.payload is .Unit) }) -> continue
        // GATE #4499: retain the exact composite key, and reference the checked declaration.
        payloads.insert((source.module, name), definition)
    }
    payloads
}
// Rust: crates/jet-codegen/src/Codegen/TIR/tir_to_mir_types.rs:3171
fn compiler_owned_default_err(module: String) -> TirTypeDef {
    span := Span.new(0, 0)
    field := fn(name: String, ty: Type) {
        TirField{name: name.to_string(), shape_names: ShapeFieldNames.from_source(name), skip: false, ty: ty, span: span,
            public: true, package_public: false, computed: false, has_default: false, redact: false}
    }
    TirTypeDef{module: module.to_string(), key: Syntax.TYPE_ERR.to_string(), name: Syntax.TYPE_ERR.to_string(), span: span,
        public: true, package_public: false, generic_params: [], derives: [], auto_derive_default: false, auto_printable: false,
        published_schema: false, single_use: false, must_use: false, layout: None, layout_alignment: None, c_layout_tag: None,
        enum_layout: None, serde: [], cli_bindings: [], cli: None, ownership: TirOwnership.Owned, boxed_edges: [],
        compiler_builtin: Val(MirCompilerBuiltin.DefaultErr),
        kind: TirTypeDefKind.Struct{fields: [field("message", Type.String), field("code", Type.Option(Type.String)),
            field("cause", Type.Option(Type.Named(Syntax.TYPE_ERR)))], methods: []}}
}
// Rust: crates/jet-codegen/src/Codegen/TIR/tir_to_mir_types.rs:3223
fn compiler_owned_record(module: String, name: String, fields: Iterable<(String, Type)>) -> TirTypeDef {
    span := Span.new(0, 0)
    TirTypeDef{module: module.to_string(), key: name.to_string(), name: name.to_string(), span: span,
        public: true, package_public: false, generic_params: [], derives: [], auto_derive_default: false, auto_printable: false,
        published_schema: false, single_use: false, must_use: false, layout: None, layout_alignment: None, c_layout_tag: None,
        enum_layout: None, serde: [], cli_bindings: [], cli: None, ownership: TirOwnership.Owned, boxed_edges: [], compiler_builtin: None,
        kind: TirTypeDefKind.Struct{fields: fields.into_iter().map(fn(entry) {
            (name, ty) := entry
            TirField{name: name.to_string(), shape_names: ShapeFieldNames.from_source(name), skip: false, ty: ty, span: span,
                public: true, package_public: false, computed: false, has_default: false, redact: false}
        }).collect(), methods: []}}
}
// Rust: crates/jet-codegen/src/Codegen/TIR/tir_to_mir_types.rs:3276
fn compiler_owned_core_record(module: String, name: String, fields: &[String]) -> TirTypeDef {
    compiler_owned_record(module, name, fields.iter().map(fn(field) {
        (field, jet_sema.Sema.core_struct_field_type(name, field, []).unwrap_or_else(fn() { panic("missing canonical Core field {name}.{field}") }))
    }))
}
// Rust: crates/jet-codegen/src/Codegen/TIR/tir_to_mir_types.rs:3293
fn compiler_owned_core_variant_payload(payload: &VariantPayload) -> TirVariantPayload {
    identity := fn(ty: &Type, _: &[String]) { ty.clone() }
    if payload == {
        .Unit -> TirVariantPayload.Unit
        .Single(ty, _) -> TirVariantPayload.Single(ty.clone())
        .Named(fields) -> TirVariantPayload.Named(fields.iter().map(fn(field) { lower_variant_field(field, identity, []) }).collect())
    }
}
// Rust: crates/jet-codegen/src/Codegen/TIR/tir_to_mir_types.rs:3307
fn compiler_owned_vjp_run(module: String) -> TirTypeDef {
    span := Span.new(0, 0)
    field := fn(name: String, ty: Type) {
        TirField{name: name.to_string(), shape_names: ShapeFieldNames.from_source(name), skip: false, ty: ty, span: span,
            public: true, package_public: false, computed: false, has_default: false, redact: false}
    }
    TirTypeDef{module: module.to_string(), key: "VJPRun", name: "VJPRun", span: span, public: true, package_public: false,
        generic_params: [TGenericParam{name: "T", bounds: []}], derives: [], auto_derive_default: false, auto_printable: false,
        published_schema: false, single_use: false, must_use: false, layout: None, layout_alignment: None, c_layout_tag: None,
        enum_layout: None, serde: [], cli_bindings: [], cli: None, ownership: TirOwnership.Owned, boxed_edges: [], compiler_builtin: None,
        kind: TirTypeDefKind.Struct{fields: [
            field("value", Type.Named("Tensor")),
            field("pull", Type.Fn{params: [Type.Named("Tensor")], ret: Val(Type.Named("T")), effect_bound: None, param_contract: None, call_metadata: None, return_view_provenance: None}),
            field("grads", Type.Fn{params: [], ret: Val(Type.Named("T")), effect_bound: None, param_contract: None, call_metadata: None, return_view_provenance: None})], methods: []}}
}
// Rust: crates/jet-codegen/src/Codegen/TIR/tir_to_mir_types.rs:3379
fn compiler_owned_parse_error(module: String) -> TirTypeDef {
    span := Span.new(0, 0)
    row := lower_alias(TypeAliasDef{is_pub: true, is_package_pub: false, name: "ParseError", name_span: span,
        type_params: [], target: Type.String, target_span: span, span: span}, module, fn(ty, _) { ty.clone() }, false)
    row.key = "ParseError"
    row
}

// Rust: crates/jet-codegen/src/Codegen/TIR/tir_to_mir_types.rs:3402
fn compiler_owned_type_defs(module: String, seed_parse_error: Bool, checked_nominals: &MirFragmentNominalFacts?) -> Iterator<TirTypeDef> {
    span := Span.new(0, 0)
    net_error_variants := ["NetDnsError", "NetError"].into_iter().map(fn(enum_name) {
        (enum_name.to_string(), jet_sema.Sema.core_net_error_variants(enum_name).unwrap_or_else(fn() { panic("missing canonical Core enum {enum_name}") }))
    }).collect<HashMap<_, _>>()
    for enum_name in ["NetDnsError", "NetError"] {
        canonical_names := compiler_owned_enum_variants(enum_name).unwrap_or_else(fn() { panic("missing canonical MIR enum {enum_name}") })
        variants := net_error_variants.get(enum_name).expect("canonical sema enum was registered")
        assert(canonical_names.len() == variants.len(), "Core/MIR variant rows disagree for {enum_name}")
        for variant in canonical_names { assert(variants.contains_key(variant), "missing canonical Core variant {enum_name}.{variant}") }
    }
    COMPILER_OWNED_ENUMS.iter().map(fn(entry) {
        (name, variants) := entry
        TirTypeDef{module: module.to_string(), key: name.to_string(), name: name.to_string(), span: span, public: true, package_public: false,
            generic_params: if name == {
                "HookDecision" | "HookOutcome" -> ["T", "E"].into_iter().map(fn(name) { TGenericParam{name: name.to_string(), bounds: []} }).collect()
                else -> []
            },
            derives: [], auto_derive_default: false, auto_printable: false, published_schema: false, single_use: false, must_use: false,
            layout: None, layout_alignment: None, c_layout_tag: None, enum_layout: None, serde: [], cli_bindings: [], cli: None,
            ownership: TirOwnership.Owned, boxed_edges: [], compiler_builtin: None,
            kind: TirTypeDefKind.Enum{variants: variants.iter().map(fn(variant) {
                payload := if name == Syntax.TYPE_TASK_FAILURE {
                    if variant == Syntax.TASK_FAILURE_PANICKED -> TirVariantPayload.Single(Type.String) else -> TirVariantPayload.Unit
                } else if name == "TaskOutcome" && variant == "Panicked" {
                    TirVariantPayload.Single(Type.String)
                } else if name == "HookDecision" {
                    if variant == { "Transform" -> TirVariantPayload.Single(Type.Named("T")); "Fail" -> TirVariantPayload.Single(Type.Named("E")); else -> TirVariantPayload.Unit }
                } else if name == "HookOutcome" {
                    if variant == { "Continue" -> TirVariantPayload.Single(Type.Named("T")); "Fail" -> TirVariantPayload.Single(Type.Named("E")); else -> TirVariantPayload.Unit }
                } else if name == "WsError" {
                    if variant == {
                        "MessageTooLarge" -> TirVariantPayload.Named([TirField{name: "limit", shape_names: ShapeFieldNames.from_source("limit"), skip: false, ty: Type.Int,
                            span: span, public: true, package_public: false, computed: false, has_default: false, redact: false}])
                        "IO" -> TirVariantPayload.Named([TirField{name: "operation", shape_names: ShapeFieldNames.from_source("operation"), skip: false, ty: Type.String,
                            span: span, public: true, package_public: false, computed: false, has_default: false, redact: false}])
                        else -> TirVariantPayload.Unit
                    }
                } else if name == Syntax.TYPE_IO_ERROR {
                    if variant == "ResourceLimit" -> TirVariantPayload.Single(Type.Named(Syntax.TYPE_PROCESS_RESOURCE_LIMIT))
                    else -> TirVariantPayload.Single(Type.Named(Syntax.TYPE_IO_CONTEXT))
                } else if name == Syntax.TYPE_KEY {
                    if variant == { "Char" | "Ctrl" -> TirVariantPayload.Single(Type.Char); "F" -> TirVariantPayload.Single(Type.Int); else -> TirVariantPayload.Unit }
                } else if name == "EmailError" {
                    TirVariantPayload.Named([
                        TirField{name: "operation", shape_names: ShapeFieldNames.from_source("operation"), skip: false, ty: Type.String, span: span,
                            public: true, package_public: false, computed: false, has_default: false, redact: false},
                        TirField{name: "server", shape_names: ShapeFieldNames.from_source("server"), skip: false, ty: Type.Option(Type.String), span: span,
                            public: true, package_public: false, computed: false, has_default: false, redact: false},
                        TirField{name: "code", shape_names: ShapeFieldNames.from_source("code"), skip: false, ty: Type.Option(Type.Int), span: span,
                            public: true, package_public: false, computed: false, has_default: false, redact: false},
                        TirField{name: "reason", shape_names: ShapeFieldNames.from_source("reason"), skip: false, ty: Type.String, span: span,
                            public: true, package_public: false, computed: false, has_default: false, redact: false}])
                } else if name == "SMTPAuth" && variant == "Password" {
                    TirVariantPayload.Named([
                        TirField{name: "username", shape_names: ShapeFieldNames.from_source("username"), skip: false, ty: Type.String, span: span,
                            public: true, package_public: false, computed: false, has_default: false, redact: false},
                        TirField{name: "password", shape_names: ShapeFieldNames.from_source("password"), skip: false, ty: Type.Named("Secret"), span: span,
                            public: true, package_public: false, computed: false, has_default: false, redact: false}])
                } else if name == "TLSTrust" && variant == "SystemPlusCa" {
                    TirVariantPayload.Named([TirField{name: "pem", shape_names: ShapeFieldNames.from_source("pem"), skip: false,
                        ty: Type.List(Type.IntN{signed: false, bits: 8}), span: span, public: true, package_public: false,
                        computed: false, has_default: false, redact: false}])
                } else if name == "TLSClientTrust" {
                    if variant == { "SystemPlus" | "CustomOnly" -> TirVariantPayload.Single(Type.Named("TLSRootCertificates")); else -> TirVariantPayload.Unit }
                } else if name == "DataEvent" {
                    if variant == {
                        "Bool" -> TirVariantPayload.Single(Type.Bool)
                        "Int" -> TirVariantPayload.Single(Type.Int)
                        "Float" -> TirVariantPayload.Single(Type.Float)
                        "Text" | "Key" -> TirVariantPayload.Single(Type.String)
                        "Bytes" -> TirVariantPayload.Single(Type.List(Type.IntN{signed: false, bits: 8}))
                        else -> TirVariantPayload.Unit
                    }
                } else if name == "DataTree" {
                    if variant == {
                        "Bool" -> TirVariantPayload.Single(Type.Bool)
                        "Int" -> TirVariantPayload.Single(Type.Int)
                        "Float" -> TirVariantPayload.Single(Type.Float)
                        "Number" | "TypedText" | "Text" -> TirVariantPayload.Single(Type.String)
                        "Bytes" -> TirVariantPayload.Single(Type.List(Type.IntN{signed: false, bits: 8}))
                        "Array" -> TirVariantPayload.Single(Type.List(Type.Named("DataTree")))
                        "Object" -> TirVariantPayload.Single(Type.List(Type.Tuple([("key", Type.String), ("value", Type.Named("DataTree"))])))
                        else -> TirVariantPayload.Unit
                    }
                } else if name == "NetError" || name == "NetDnsError" {
                    (_, payload) := net_error_variants.get(name).and_then(fn(variants) { variants.get(variant) })
                        .unwrap_or_else(fn() { panic("missing canonical Core variant {name}.{variant}") })
                    compiler_owned_core_variant_payload(payload)
                } else { TirVariantPayload.Unit }
                TirVariant{name: variant.to_string(), wire_name: variant.to_string(), span: span, payload: ^payload, discriminant: None}
            }).collect(), methods: []}}
    })
    .chain(compiler_owned_core_enums(module, checked_nominals))
    .chain(std.iter.once(compiler_owned_default_err(module)))
    .chain(std.iter.once(compiler_owned_record(module, "FieldError", ["path", "reason"].map(fn(name) {
        (name, jet_sema.Sema.core_struct_field_type("FieldError", name, []).expect("canonical FieldError field"))
    }))))
    .chain(std.iter.once(compiler_owned_record(module, Syntax.TYPE_RANGE, [("start", Type.Int), ("end", Type.Int), ("exclusive", Type.Bool)])))
    .chain([
        ("DataJoin", ["L", "R"], ["left", "right"]),
        ("Group", ["K", "V"], ["key", "value"]),
        ("DataSnapshot", ["T"], ["value", "identity", "provenance", "schema", "status", "content"])
    ].into_iter().map(fn(entry) {
        (name, params, fields) := entry
        args := params.iter().map(fn(name) { Type.Named(name.to_string()) }).collect<[Type]>()
        row := compiler_owned_record(module, name, fields.iter().map(fn(field) {
            (field, jet_sema.Sema.core_struct_field_type(name, field, args).expect("canonical generic Core record field"))
        }))
        row.generic_params = params.iter().map(fn(name) { TGenericParam{name: name.to_string(), bounds: []} }).collect()
        row
    }))
    .chain(COMPILER_OWNED_GEOMETRY_RECORDS.iter().map(fn(entry) {
        (name, params, fields) := entry
        args := params.iter().map(fn(name) { Type.Named(name.to_string()) }).collect<[Type]>()
        row := compiler_owned_record(module, name, fields.iter().map(fn(field) {
            (field, jet_sema.Sema.core_struct_field_type(name, field, args).expect("canonical geometry Core record field"))
        }))
        row.generic_params = params.iter().map(fn(name) { TGenericParam{name: name.to_string(), bounds: []} }).collect()
        row
    }))
    .chain(["KeyRef", "MutationPlan", "VaultWrite"].into_iter().map(fn(name) {
        row := compiler_owned_record(module, name, std.iter.empty<(String, Type)>())
        row.generic_params = [TGenericParam{name: "T", bounds: []}]
        row
    }))
    .chain(std.iter.once({
        args := [Type.Named("T")]
        row := compiler_owned_record(module, "Rotation", ["previous", "current"].map(fn(field) {
            (field, jet_sema.Sema.core_struct_field_type("Rotation", field, args).expect("canonical Rotation field"))
        }))
        row.generic_params = [TGenericParam{name: "T", bounds: []}]
        row
    }))
    .chain(std.iter.once({
        row := compiler_owned_record(module, Syntax.TYPE_MEASUREMENT, [("value", Type.Named("T")), ("uncertainty", Type.Named("T"))])
        row.generic_params = [TGenericParam{name: "T", bounds: []}]
        row
    }))
    .chain(std.iter.once(compiler_owned_record(module, "DataPivotCell", ["row_key", "column_key", "count", "sum", "mean"].map(fn(name) {
        (name, jet_sema.Sema.core_struct_field_type("DataPivotCell", name, []).expect("canonical DataPivotCell field"))
    }))))
    .chain(std.iter.once(compiler_owned_record(module, "AllocError", ["requested_bytes", "allocator"].map(fn(name) {
        (name, jet_sema.Sema.core_struct_field_type("AllocError", name, []).expect("canonical AllocError field"))
    }))))
    .chain(std.iter.once(compiler_owned_record(module, "DataSummary", ["count", "sum", "mean", "min", "max", "median", "variance", "stddev"].map(fn(name) {
        (name, jet_sema.Sema.core_struct_field_type("DataSummary", name, []).expect("canonical DataSummary field"))
    }))))
    .chain(std.iter.once(compiler_owned_vjp_run(module)))
    .chain(COMPILER_OWNED_CORE_RECORDS.iter().map(fn(entry) { (name, fields) := entry; compiler_owned_core_record(module, name, fields) }))
    .chain(COMPILER_OWNED_MATH_RECORDS.iter().map(fn(entry) {
        (name, fields) := entry
        scalar := jet_sema.Sema.math_scalar_ty(name)
        compiler_owned_record(module, name, fields.iter().map(fn(field) { (field, scalar.clone()) }))
    }))
    .chain(if seed_parse_error -> Val(compiler_owned_parse_error(module)) else -> None)
}
// Rust: crates/jet-codegen/src/Codegen/TIR/tir_to_mir_types.rs:3916
pub fn is_compiler_owned_trait(name: String) -> Bool {
    if name == {
        Generics.ENCODE | Generics.DECODE | Generics.DISPLAY | Generics.DEBUG | Generics.EQUATABLE | Generics.COMPARABLE | Generics.CLOSE
        | Syntax.TRAIT_INDEX | Syntax.TRAIT_INDEX_MUT | Syntax.TRAIT_ITERABLE | Syntax.TRAIT_ITERATOR
        | Generics.ADD | Generics.SUB | Generics.MUL | Generics.DIV | Syntax.TRAIT_ROLLBACK -> true
        else -> false
    }
}
