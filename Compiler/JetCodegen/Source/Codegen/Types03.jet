// Rust: crates/jet-codegen/src/Codegen/TIR/tir_to_mir_types.rs:1823
fn lower_distinct(definition: &DistinctDef, module: String, qualify_type: fn(&Type, &[String]) -> Type, auto_printable: Bool) -> TirTypeDef {
    TirTypeDef{module: module.to_string(), key: qualified_key(module, definition.name), name: definition.name.clone(),
        span: definition.span, public: definition.is_pub, package_public: definition.is_package_pub, generic_params: [],
        derives: lower_derive_names(definition.derives, false, false), auto_derive_default: false,
        auto_printable: auto_printable || definition.derives.iter().any(fn(entry) { (name, _) := entry; name == Generics.PRINTABLE }),
        published_schema: false, single_use: false, must_use: false, layout: None, layout_alignment: None, c_layout_tag: None,
        enum_layout: None, serde: [], cli_bindings: [], cli: None, ownership: TirOwnership.Owned, boxed_edges: [], compiler_builtin: None,
        kind: TirTypeDefKind.Distinct{base: qualify_type(definition.base, []), range: definition.range.map(fn(entry) { (lo, hi, _) := entry; (lo, hi) })}}
}
// Rust: crates/jet-codegen/src/Codegen/TIR/tir_to_mir_types.rs:1867
fn lower_alias(definition: &TypeAliasDef, module: String, qualify_type: fn(&Type, &[String]) -> Type, auto_printable: Bool) -> TirTypeDef {
    binders := definition.type_params.iter().map(fn(param) { param.name.clone() }).collect<[String]>()
    TirTypeDef{module: module.to_string(), key: qualified_key(module, definition.name), name: definition.name.clone(),
        span: definition.span, public: definition.is_pub, package_public: definition.is_package_pub,
        generic_params: lower_generic_params(definition.type_params), derives: [], auto_derive_default: false, auto_printable: auto_printable,
        published_schema: false, single_use: false, must_use: false, layout: None, layout_alignment: None, c_layout_tag: None,
        enum_layout: None, serde: [], cli_bindings: [], cli: None, ownership: TirOwnership.Owned, boxed_edges: [], compiler_builtin: None,
        kind: TirTypeDefKind.Alias{target: qualify_type(definition.target, binders)}}
}
// Rust: crates/jet-codegen/src/Codegen/TIR/tir_to_mir_types.rs:1908
fn lower_unit_family(definition: &UnitFamilyDef, module: String, auto_printable: Bool) -> TirTypeDef {
    TirTypeDef{module: module.to_string(), key: qualified_key(module, definition.family), name: definition.family.clone(),
        span: definition.span, public: definition.is_pub, package_public: definition.is_package_pub, generic_params: [], derives: [],
        auto_derive_default: false, auto_printable: auto_printable, published_schema: false, single_use: false, must_use: false,
        layout: None, layout_alignment: None, c_layout_tag: None, enum_layout: None, serde: [], cli_bindings: [], cli: None,
        ownership: TirOwnership.Owned, boxed_edges: [], compiler_builtin: None,
        kind: TirTypeDefKind.UnitFamily{members: definition.distinct_defs().into_iter().map(fn(member) { member.name }).collect()}}
}
// Rust: crates/jet-codegen/src/Codegen/TIR/tir_to_mir_types.rs:1943
fn lower_trait_param(index: USize, param: &Param, qualify_type: fn(&Type, &[String]) -> Type) -> TirParam {
    TirParam{index: index, name: param.name.clone(), span: param.name_span, ty: qualify_type(param.ty, []),
        access: lower_access_convention(param.convention),
        ownership: if param.convention == { .Move -> TirOwnership.Move; .Write -> TirOwnership.WriteBorrow; .Read -> TirOwnership.ReadBorrow },
        public_label: param.public_label.map(fn(entry) { (label, _) := entry; label.clone() }).unwrap_or_else(fn() { param.name.clone() }),
        variadic: param.variadic, default_present: param.default.is_some()}
}
// Rust: crates/jet-codegen/src/Codegen/TIR/tir_to_mir_types.rs:1969
fn lower_trait(definition: &TraitDef, module: String, qualify_type: fn(&Type, &[String]) -> Type) -> TirTraitDef {
    TirTraitDef{module: module.to_string(), key: definition.name.clone(), name: definition.name.clone(), span: definition.span,
        visibility: if definition.is_pub -> TirVisibility.Public else if definition.is_package_pub -> TirVisibility.Package else -> TirVisibility.Private,
        associated_types: definition.assoc_types.iter().map(fn(entry) { (name, span) := entry; TirAssociatedTypeDecl{name: name.clone(), span: span} }).collect(),
        methods: definition.methods.iter().map(fn(method) {
            params := [TirParam]{}
            self_access: TirAccess? := None
            for param in method.params {
                if params.is_empty() && self_access.is_none() && param.name == "self" {
                    self_access = Val(lower_access_convention(param.convention))
                    continue
                }
                params.push(lower_trait_param(params.len(), param, qualify_type))
            }
            TirTraitMethod{key: qualified_key(module, method.name), name: method.name.clone(), span: method.span,
                self_access: self_access, params: ^params, declared_return: method.return_type.map(fn(ty) { qualify_type(ty, []) }),
                return_type: qualify_type(method.effective_return_type(), []),
                failure: TFailureCarrier.from_contract(method.failure_contract()).map_types(fn(ty) { qualify_type(ty, []) }),
                is_pure: method.is_pure, declared_effects: method.declared_effects.clone(), return_view_provenance: method.return_view_provenance.get(),
                declared_return_view_provenance: method.declared_return_view_provenance.clone(),
                default_function_key: method.default_body.map(fn(_) { qualified_key(module, method.name) })}
        }).collect()}
}
// Rust: crates/jet-codegen/src/Codegen/TIR/tir_to_mir_types.rs:2031
fn push_nested_trait_impls(out: &TirDeclarations, type_name: String, blocks: &[TraitImplBlock], module: String) {
    for block in blocks { out.impls.push(lower_nested_trait_impl(type_name, block, module)) }
}
// Rust: crates/jet-codegen/src/Codegen/TIR/tir_to_mir_types.rs:2043
fn lower_nested_trait_impl(type_name: String, block: &TraitImplBlock, module: String) -> TirImplDef {
    TirImplDef{module: module.to_string(), key: "{module}::{type_name}::{block.trait_name}", span: block.trait_span,
        self_type: Type.Named(qualified_key(module, type_name)), trait_name: Val(block.trait_name.clone()), trait_ref: Val(block.trait_name.clone()),
        associated_types: block.assoc_type_impls.iter().map(fn(entry) { (name, span, ty) := entry; TirAssociatedTypeValue{name: name.clone(), ty: ty.clone(), span: span} }).collect(),
        methods: method_keys(module, type_name, Val(block.trait_name), block.operator_rhs, block.methods),
        delegation_field: None, compiler_generated: block.compiler_generated,
        serde: if block.trait_name == { Generics.ENCODE -> Val(TirSerdeCodec.Encode); Generics.DECODE -> Val(TirSerdeCodec.Decode); else -> None },
        operator_rhs: if block.trait_name == { Syntax.TRAIT_ADD | Syntax.TRAIT_SUB | Syntax.TRAIT_MUL | Syntax.TRAIT_DIV -> block.operator_rhs.clone(); else -> None },
        operator_marker: block.operator_marker, target_os: None}
}
// Rust: crates/jet-codegen/src/Codegen/TIR/tir_to_mir_types.rs:2091
fn lower_impl(definition: &ImplDef, module: String, owner_module: String) -> TirImplDef {
    owner := if owner_module == module -> definition.type_name.clone() else -> qualified_key(owner_module, definition.type_name)
    TirImplDef{module: module.to_string(),
        key: if definition.trait_name == { Val(trait_name) -> "{module}::{definition.type_name}::{trait_name}"; None -> "{module}::{definition.type_name}" },
        span: definition.span, self_type: Type.Named(qualified_key(owner_module, definition.type_name)),
        trait_name: definition.trait_name.clone(), trait_ref: definition.trait_name.clone(),
        associated_types: definition.assoc_type_impls.iter().map(fn(entry) { (name, span, ty) := entry; TirAssociatedTypeValue{name: name.clone(), ty: ty.clone(), span: span} }).collect(),
        methods: method_keys(module, owner, definition.trait_name, definition.operator_rhs, definition.methods),
        delegation_field: definition.delegation_field.clone(), compiler_generated: definition.is_generated_serde,
        serde: if definition.trait_name == { Val(Generics.ENCODE) -> Val(TirSerdeCodec.Encode); Val(Generics.DECODE) -> Val(TirSerdeCodec.Decode); else -> None },
        operator_rhs: definition.operator_rhs.clone(), operator_marker: definition.operator_marker, target_os: definition.os_target}
}
// Rust: crates/jet-codegen/src/Codegen/TIR/tir_to_mir_types.rs:2136
pub fn lower_constant(definition: &ConstDef, module: String) -> TirConstantDef {
    value := source_constant_value(definition).unwrap_or(CtValue.Unit)
    ty := source_constant_type(definition).or_else(fn() { if !(value is .Unit) -> Val(value.jet_type()) else -> None }).unwrap_or(Type.Named("Unit"))
    TirConstantDef{module: module.to_string(), key: qualified_key(module, definition.name), name: definition.name.clone(),
        span: definition.span, visibility: TirVisibility.Public, ty: ty, is_comptime: definition.is_comptime,
        is_storage: !definition.is_comptime && (definition.is_persist || definition.mutable),
        addressable: definition.attrs.contains(ConstAttr.ForceStatic), force_inline: definition.attrs.contains(ConstAttr.ForceInline), value: value}
}

