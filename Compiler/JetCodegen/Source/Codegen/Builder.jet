// Per-function MIR construction primitives shared by expression and statement
// lowering. IDs are stable for the checked function and source traversal.

struct JetCodegenBinding {
    pub name: String
    pub symbol_key: String
    pub ty: Type
    pub place: MirPlaceId
    pub local: MirLocalId
    pub depth: Int
}
struct JetCodegenDropLive {
    pub place: MirPlaceId
    pub live: MirPlaceId
    pub ty: Type
    pub kind: MirDropKind
    pub depth: Int
    pub span: Span
}

struct JetCodegenContractScopeState {
    pub result: TContractResult
    pub carrier_place: MirPlaceId
    pub binding_place: MirPlaceId
    pub post: [TContract]
}

struct JetCodegenLoopTarget {
    pub label: ?String
    pub break_target: MirBlockId
    pub continue_target: MirBlockId
    pub break_scope_depth: Int
    pub continue_scope_depth: Int
    pub break_seen: Bool
}
struct JetCodegenTransactionSnapshot {
    pub local: TLocal
    pub ty: Type
    pub saved_ty: Type
    pub place: MirPlaceId
    pub saved_local: TLocal
    pub saved_place: MirPlaceId
    pub rollback_type: ?Type
}
struct JetCodegenTransactionState {
    pub scope: MirScopeId
    pub stm_place: ?MirPlaceId
    pub handle_place: ?MirPlaceId
    pub snapshots: [JetCodegenTransactionSnapshot]
    pub loop_depth: Int
}
struct JetCodegenSourceLocation {
    pub line: Int
    pub source_line: ?String
}

struct JetCodegenBuilder {
    pub function: TFunc
    pub functions: [TFunc]
    pub modules: [SemaGraphModuleResult]
    pub source_files: [MirSourceFile]
    pub current_span: Span
    pub current_line: ?Int
    pub generic_type_names: [String]
    pub current: MirBlockId
    pub entry: MirBlockId
    pub next_identity: Int
    pub scope_depth: Int
    pub blocks: [MirBasicBlock]
    pub locals: [MirLocal]
    pub values: [MirValueFact]
    pub places: [MirPlace]
    pub scopes: [MirScope]
    pub contract_scopes: [JetCodegenContractScopeState]
    pub params: [MirParam]
    pub capture_params: [MirCaptureParam]
    pub capture_facts: ?MirCaptureFacts
    pub bindings: [JetCodegenBinding]
    pub loops: [JetCodegenLoopTarget]
    pub prelude_calls: [MirPreludeCall]
    pub core_calls: [MirCoreCall]
    pub used_core: [String]
    pub nested_functions: [MirFunction]
    pub callbacks: [MirCallbackAdapter]
    pub checked_vector_facts: [MirVectorFact]
    pub transactions: [JetCodegenTransactionState]
    pub transaction_cleanup_active: Bool
    pub drop_live_places: [JetCodegenDropLive]
}

fn jet_codegen_source_location(builder: &JetCodegenBuilder, include_source_line: Bool) -> JetCodegenSourceLocation {
    if builder.function.source_file == "" -> panic("checked function has an empty source path")
    source := None
    loop row in builder.source_files {
        if row.path == builder.function.source_file {
            if source != None -> panic("ambiguous checked function source context")
            source = Val(row)
        }
    }
    source_row :: source ?? panic("checked function has no readonly source context")
    if source_row.path == "" -> panic("checked function source context has an empty path")
    if source_row.id != mir_source_file_id(source_row.path) -> panic("checked function source context has a conflicting file identity")
    bytes := source_row.source.bytes()
    line := builder.current_line ?? 1
    line_start := 0
    if builder.current_line == None {
        span := builder.current_span
        if span.start < 0 || span.start > bytes.len() -> panic("checked span falls outside its readonly source context")
        offset := 0
        loop offset < span.start {
            if bytes[offset] == U8{10} {
                line += 1
                line_start = offset + 1
            }
            offset += 1
        }
    } else {
        if line < 1 -> panic("checked line marker is outside its readonly source context")
        actual_line := 1
        offset := 0
        loop actual_line < line && offset < bytes.len() {
            if bytes[offset] == U8{10} {
                actual_line += 1
                line_start = offset + 1
            }
            offset += 1
        }
        if actual_line != line -> panic("checked line marker is outside its readonly source context")
    }
    source_line := None
    if include_source_line {
        line_end := line_start
        loop line_end < bytes.len() && bytes[line_end] != U8{10} -> line_end += 1
        if line_end > line_start && bytes[line_end - 1] == U8{13} -> line_end -= 1
        line_text := String.from_bytes(bytes[line_start..line_end]) ?? panic("checked source line is not valid UTF-8")
        if line_text == "" -> panic("checked source location resolves to an empty source line")
        source_line = Val(line_text)
    }
    JetCodegenSourceLocation{line: line, source_line: source_line}
}

fn jet_codegen_source_location_at(builder: &JetCodegenBuilder, span: Span, include_source_line: Bool) -> JetCodegenSourceLocation {
    previous_span := builder.current_span
    builder.current_span = span
    location := jet_codegen_source_location(&builder, include_source_line)
    builder.current_span = previous_span
    location
}

fn jet_codegen_assignment_panic_location(builder: &JetCodegenBuilder, span: Span, include_source_line: Bool) -> TPanicLoc {
    source := jet_codegen_source_location_at(&builder, span, include_source_line)
    source_line := if include_source_line -> source.source_line ?? panic("checked source context has no source line") else -> ""
    TPanicLoc{
        file: builder.function.source_file,
        source_line: source_line,
        line: source.line,
        column: 0,
        caret: 0,
        function: builder.function.name,
        locals: [TPanicLocal]{},
    }
}


pub struct JetCodegenLoweredFunction {
    pub function: MirFunction
    pub nested_functions: [MirFunction]
    pub callbacks: [MirCallbackAdapter]
    pub fields: [MirFieldRow]
    pub prelude_calls: [MirPreludeCall]
    pub core_calls: [MirCoreCall]
    pub used_core: [String]
}

struct JetCodegenLambdaValue {
    pub value: MirValueId
    pub function: MirFunctionId
}


fn jet_codegen_identity(builder: &JetCodegenBuilder, kind: String, span: Span, role: String, detail: String) -> String {
    index := builder.next_identity
    builder.next_identity = index + 1
    "{builder.function.key}|{kind}|{span.start}:{span.end}|{role}|{detail}|{index}"
}

fn jet_codegen_type_definition_method_keys(definition: TTypeDef) -> [String] {
    if definition.kind == {
        .Struct(_, methods) | .Enum(_, methods) -> return methods
        else -> return [String]{}
    }
}

fn jet_codegen_function_type_generic_names(function: TFunc, modules: [SemaGraphModuleResult]) -> [String] {
    loop semantic_module in modules {
        if semantic_module.module_identity != function.module_identity -> next
        loop definition in semantic_module.declarations.type_defs {
            method_keys := jet_codegen_type_definition_method_keys(definition)
            if !method_keys.contains(function.key) -> next
            names := [String]{}
            loop parameter in definition.generic_params -> names.push(parameter.name)
            return names
        }
    }
    [String]{}
}

fn jet_codegen_new_builder(function: TFunc, functions: [TFunc], modules: [SemaGraphModuleResult], source_files: [MirSourceFile]) -> JetCodegenBuilder {
    generic_type_names := jet_codegen_function_type_generic_names(function, modules)
    loop param in function.generic_params {
        if !generic_type_names.contains(param.name) -> generic_type_names.push(param.name)
    }
    builder := JetCodegenBuilder{
        function: function,
        functions: functions,
        modules: modules,
        source_files: source_files,
        generic_type_names: generic_type_names,
        current_span: function.source_span,
        current_line: None,
        current: MirBlockId{value: 0},
        entry: MirBlockId{value: 0},
        next_identity: 0,
        scope_depth: 0,
        blocks: [MirBasicBlock]{},
        locals: [MirLocal]{},
        values: [MirValueFact]{},
        places: [MirPlace]{},
        scopes: [MirScope]{},
        contract_scopes: [JetCodegenContractScopeState]{},
        params: [MirParam]{},
        capture_params: [MirCaptureParam]{},
        capture_facts: None,
        bindings: [JetCodegenBinding]{},
        loops: [JetCodegenLoopTarget]{},
        prelude_calls: [MirPreludeCall]{},
        core_calls: [MirCoreCall]{},
        used_core: [String]{},
        nested_functions: [MirFunction]{},
        callbacks: [MirCallbackAdapter]{},
        checked_vector_facts: [MirVectorFact]{},
        transactions: [JetCodegenTransactionState]{},
        drop_live_places: [JetCodegenDropLive]{},
        transaction_cleanup_active: false,
    }
    entry := jet_codegen_new_block(&builder, function.source_span, "entry")
    builder.entry = entry
    builder.current = entry
    builder
}

fn jet_codegen_new_block(builder: &JetCodegenBuilder, span: Span, role: String) -> MirBlockId {
    identity := jet_codegen_identity(&builder, "block", span, role, "")
    id := MirBlockId{value: stable_id("mir-block", identity)}
    builder.blocks.push(MirBasicBlock{
        id: id,
        span: span,
        instructions: [MirInstruction]{},
        terminator: MirTerminator.Unreachable("jet-codegen-open-block"),
    })
    id
}

fn jet_codegen_switch_block(builder: &JetCodegenBuilder, block: MirBlockId) {
    builder.current = block
}

fn jet_codegen_is_open_terminator(terminator: MirTerminator) -> Bool {
    if terminator == {
        .Unreachable(reason) -> reason == "jet-codegen-open-block"
        else -> false
    }
}

fn jet_codegen_block_is_open(builder: JetCodegenBuilder, block_id: MirBlockId) -> Bool {
    loop block in builder.blocks {
        if block.id == block_id -> return jet_codegen_is_open_terminator(block.terminator)
    }
    false
}

fn jet_codegen_current_is_open(builder: JetCodegenBuilder) -> Bool {
    jet_codegen_block_is_open(builder, builder.current)
}

fn jet_codegen_terminate(builder: &JetCodegenBuilder, terminator: MirTerminator) {
    index := 0
    loop index < builder.blocks.len() {
        if builder.blocks[index].id == builder.current {
            block := builder.blocks[index]
            block.terminator = terminator
            builder.blocks[index] = block
            return
        }
        index += 1
    }
    panic("Jet codegen tried to terminate a missing MIR block")
}

fn jet_codegen_emit(builder: &JetCodegenBuilder, span: Span, ty: ?Type, operation: MirOperation) -> ?MirValueId {
    role := "operation"
    identity := jet_codegen_identity(&builder, "operation", span, role, "")
    op_id := MirOpId{value: stable_id("mir-op", identity)}
    result := None
    mir_ty := None
    if ty != None {
        value_type := jet_codegen_lower_type_for_function(ty ?? Type.Named("Unit"), builder)
        value := MirValueId{value: stable_id("mir-value", identity)}
        builder.values.push(MirValueFact{id: value, ty: value_type, span: span, ownership: jet_codegen_operation_ownership(builder, ty ?? Type.Named("Unit"), operation)})
        result = Val(value)
        mir_ty = Val(value_type)
    }
    instruction := MirInstruction{id: op_id, span: span, source_line: None, result: result, ty: mir_ty, operation: operation}
    index := 0
    loop index < builder.blocks.len() {
        if builder.blocks[index].id == builder.current {
            block := builder.blocks[index]
            block.instructions.push(instruction)
            builder.blocks[index] = block
            if operation == {
                .MovePlace(place) -> jet_codegen_set_drop_live(&builder, place, false)
                .InitializeUninit(place) -> jet_codegen_set_drop_live(&builder, place, true)
                .WritePlace(place, _) | .ReplacePlace(place, _) -> jet_codegen_set_drop_live(&builder, place, true)
                else -> {}
            }
            return result
        }
        index += 1
    }
    panic("Jet codegen emitted into a missing MIR block")
}
[Compiler/JetCodegen/Source/Codegen/Builder.jet#DB62]

fn jet_codegen_emit_value(builder: &JetCodegenBuilder, span: Span, ty: Type, operation: MirOperation) -> MirValueId {
    jet_codegen_emit(&builder, span, Val(ty), operation) ?? panic("typed MIR operation produced no value")
}

fn jet_codegen_emit_mir_type(builder: &JetCodegenBuilder, span: Span, ty: MirType, ownership: MirOwnership, operation: MirOperation) -> MirValueId {
    identity := jet_codegen_identity(&builder, "operation", span, "operation", "")
    op_id := MirOpId{value: stable_id("mir-op", identity)}
    value := MirValueId{value: stable_id("mir-value", identity)}
    builder.values.push(MirValueFact{id: value, ty: ty, span: span, ownership: ownership})
    instruction := MirInstruction{id: op_id, span: span, source_line: None, result: Val(value), ty: Val(ty), operation: operation}
    index := 0
    loop index < builder.blocks.len() {
        if builder.blocks[index].id == builder.current {
            block := builder.blocks[index]
            block.instructions.push(instruction)
            builder.blocks[index] = block
            if operation == {
                .MovePlace(place) -> jet_codegen_set_drop_live(&builder, place, false)
                .InitializeUninit(place) -> jet_codegen_set_drop_live(&builder, place, true)
                .WritePlace(place, _) | .ReplacePlace(place, _) -> jet_codegen_set_drop_live(&builder, place, true)
                else -> {}
            }
            return value
        }
        index += 1
    }
    panic("Jet codegen emitted into a missing MIR block")
}

fn jet_codegen_ownership(ty: Type) -> MirOwnership {
    if ty == {
        .Int | .Float | .Float32 | .Bool | .Char -> mir_copy_ownership()
        .Named(name) if name == "Unit" || name == "Never" -> mir_copy_ownership()
        else -> mir_owned_ownership()
    }
}
fn jet_codegen_operation_ownership(builder: &JetCodegenBuilder, ty: Type, operation: MirOperation) -> MirOwnership {
    if operation == {
        .MovePlace(_) | .Move(_) -> return mir_ownership_from_access(MirAccess.Move)
        .AddressOf(_, access) -> return mir_ownership_from_access(access)
        .RawAddressOf(_) -> return MirOwnership{mode: MirOwnershipMode.ReadBorrow, drop: MirDropKind.NoDrop, moved: false, last_use: false, gc_root: false}
        .Phi(incoming) -> return jet_codegen_phi_ownership(builder, incoming)
        else -> return jet_codegen_ownership(ty)
    }
}

fn jet_codegen_phi_ownership(builder: &JetCodegenBuilder, incoming: [MirPhiIncoming]) -> MirOwnership {
    if incoming.len() == 0 -> panic("Jet codegen produced a MIR phi with no ownership inputs")
    first := None
    owned_inputs := true
    same_mode := true
    loop input in incoming {
        fact := None
        loop value in builder.values {
            if value.id == input.value {
                fact = Val(value)
                break
            }
        }
        ownership := (fact ?? panic("Jet codegen phi input has no ownership fact")).ownership
        if first == None {
            first = Val(ownership)
        } else {
            initial :: first ?? panic("Jet codegen phi lost its first ownership fact")
            if ownership.drop != initial.drop -> panic("Jet codegen phi joins incompatible drop obligations")
            if ownership.mode != initial.mode -> same_mode = false
        }
        if ownership.mode != {
            .Owned | .Shared | .Move -> {}
            else -> owned_inputs = false
        }
    }
    ownership :: first ?? panic("Jet codegen phi has no first ownership fact")
    if same_mode -> return ownership
    if owned_inputs {
        ownership.mode = MirOwnershipMode.Owned
        ownership.moved = false
        ownership.last_use = false
        return ownership
    }
    panic("Jet codegen phi joins incompatible ownership modes")
}

fn jet_codegen_set_drop_live(builder: &JetCodegenBuilder, place: MirPlaceId, live: Bool) {
    matching := None
    loop record in builder.drop_live_places {
        if record.place == place {
            matching = Val(record)
            break
        }
    }
    if matching == None -> return
    record :: matching ?? panic("Jet codegen lost a drop-live record")
    value := jet_codegen_emit_value(&builder, record.span, Type.Bool, MirOperation.Constant(MirConstant.Bool(live)))
    _ := jet_codegen_emit(&builder, record.span, None, MirOperation.WritePlace(record.live, value))
}

fn jet_codegen_register_drop_live(builder: &JetCodegenBuilder, place: MirPlaceId, ty: Type, ownership: MirOwnership, initialized: Bool) {
    if ownership.drop == MirDropKind.NoDrop || jet_codegen_ownership(ty).mode == MirOwnershipMode.Copy -> return
    identity := "{builder.function.key}|drop-live|{place.value}"
    local_id := MirLocalId{value: stable_id("mir-local", identity)}
    live_place := MirPlaceId{value: stable_id("mir-place", "{identity}|place")}
    owner_span := builder.current_span
    loop owner in builder.places {
        if owner.id == place {
            owner_span = owner.span
            break
        }
    }
    live_ty := jet_codegen_lower_type_for_function(Type.Bool, builder)
    builder.locals.push(MirLocal{
        id: local_id,
        name: "$drop-live.{place.value}",
        span: owner_span,
        ty: live_ty,
        place: live_place,
        mutable: true,
        ownership: mir_copy_ownership(),
        is_comptime: false,
        uninit: false,
        arena_view: false,
        string_view: false,
        gc_root: false,
    })
    builder.places.push(MirPlace{
        id: live_place,
        span: owner_span,
        ty: live_ty,
        base: MirPlaceBase.Local(local_id),
        projections: [MirProjection]{},
        access: MirAccess.Write,
        persist_key: None,
    })
    builder.drop_live_places.push(JetCodegenDropLive{
        place: place,
        live: live_place,
        ty: ty,
        kind: ownership.drop,
        depth: builder.scope_depth,
        span: owner_span,
    })
    initial := jet_codegen_emit_value(&builder, owner_span, Type.Bool, MirOperation.Constant(MirConstant.Bool(initialized)))
    _ := jet_codegen_emit(&builder, owner_span, None, MirOperation.WritePlace(live_place, initial))
}

fn jet_codegen_emit_drop_cleanups_to_depth(builder: &JetCodegenBuilder, depth: Int) {
    index := builder.drop_live_places.len()
    loop index > 0 {
        index -= 1
        record := builder.drop_live_places[index]
        if record.depth <= depth -> continue
        if !jet_codegen_current_is_open(builder) -> return
        live := jet_codegen_emit_value(&builder, record.span, Type.Bool, MirOperation.ReadPlace(record.live))
        drop_block := jet_codegen_new_block(&builder, record.span, "drop-live")
        next_block := jet_codegen_new_block(&builder, record.span, "drop-live-next")
        jet_codegen_terminate(&builder, MirTerminator.Branch(live, drop_block, next_block))
        jet_codegen_switch_block(&builder, drop_block)
        value := jet_codegen_emit_value(&builder, record.span, record.ty, MirOperation.MovePlace(record.place))
        _ := jet_codegen_emit(&builder, record.span, None, MirOperation.Drop(value, record.kind))
        if jet_codegen_current_is_open(builder) -> jet_codegen_terminate(&builder, MirTerminator.Jump(next_block))
        jet_codegen_switch_block(&builder, next_block)
    }
}
fn jet_codegen_terminate_with_owned_cleanup(builder: &JetCodegenBuilder, terminator: MirTerminator, depth: Int) -> Bool {
    if !jet_codegen_prepare_transaction_exit(&builder, terminator) -> return false
    jet_codegen_emit_drop_cleanups_to_depth(&builder, depth)
    if !jet_codegen_current_is_open(builder) -> return false
    jet_codegen_terminate(&builder, terminator)
    true
}

fn jet_codegen_bind_local_with_base(builder: &JetCodegenBuilder, local: TLocal, ty: Type, mutable: Bool, parameter: ?MirValueId, capture: ?MirValueId, parameter_access: ?MirAccess, capture_ownership: ?MirOwnership, string_view: Bool) -> MirPlaceId {
    identity := ""
    symbol_key := ""
    if local.symbol_id != None {
        symbol :: local.symbol_id ?? SymbolId{key: ""}
        symbol_key = symbol.key
        identity = "{builder.function.key}|local|{symbol.key}"
    } else {
        identity = jet_codegen_identity(&builder, "local", local.span, local.name, "")
    }
    local_id := MirLocalId{value: stable_id("mir-local", identity)}
    place_id := MirPlaceId{value: stable_id("mir-place", "{identity}|place")}
    mir_ty := jet_codegen_lower_type_for_function(ty, builder)
    access := MirAccess.Read
    if mutable -> access = MirAccess.Write
    ownership := jet_codegen_ownership(ty)
    base := MirPlaceBase.Local(local_id)
    if parameter != None {
        parameter_value :: parameter ?? MirValueId{value: 0}
        base = MirPlaceBase.Parameter(parameter_value)
        convention :: parameter_access ?? MirAccess.Read
        access = convention
        ownership = mir_ownership_from_access(convention)
    }
    if capture != None {
        capture_value :: capture ?? MirValueId{value: 0}
        base = MirPlaceBase.Capture(capture_value)
        convention :: parameter_access ?? MirAccess.Read
        access = convention
        ownership = capture_ownership ?? mir_ownership_from_access(convention)
    }
    builder.places.push(MirPlace{
        id: place_id,
        span: local.span,
        ty: mir_ty,
        base: base,
        projections: [MirProjection]{},
        access: access,
        persist_key: local.persist_key,
    })
    builder.locals.push(MirLocal{
        id: local_id,
        name: local.name,
        span: local.span,
        ty: mir_ty,
        place: place_id,
        mutable: mutable,
        ownership: ownership,
        is_comptime: false,
        uninit: local.uninit_scalar || local.uninit_fixed,
        arena_view: false,
        string_view: string_view,
        gc_root: false,
    })
    builder.bindings.push(JetCodegenBinding{name: local.name, symbol_key: symbol_key, ty: ty, place: place_id, local: local_id, depth: builder.scope_depth})
    should_drop := ownership.drop != MirDropKind.NoDrop && !string_view
    if parameter != None {
        should_drop = should_drop && ownership.mode == MirOwnershipMode.Move
        if should_drop -> jet_codegen_register_drop_live(&builder, place_id, ty, ownership, true)
    } else if capture == None && should_drop {
        jet_codegen_register_drop_live(&builder, place_id, ty, ownership, false)
    }
    place_id
}

fn jet_codegen_bind_local(builder: &JetCodegenBuilder, local: TLocal, ty: Type, mutable: Bool, parameter: ?MirValueId, parameter_access: ?MirAccess, string_view: Bool) -> MirPlaceId {
    jet_codegen_bind_local_with_base(&builder, local, ty, mutable, parameter, None, parameter_access, None, string_view)
}

fn jet_codegen_bind_capture_local(builder: &JetCodegenBuilder, local: TLocal, ty: Type, value: MirValueId, access: MirAccess, ownership: MirOwnership, string_view: Bool) -> MirPlaceId {
    jet_codegen_bind_local_with_base(&builder, local, ty, access == MirAccess.Write, None, Val(value), Val(access), Val(ownership), string_view)
}

fn jet_codegen_find_binding(builder: JetCodegenBuilder, name: String) -> ?JetCodegenBinding {
    index := builder.bindings.len() - 1
    loop index >= 0 {
        binding :: builder.bindings[index]
        if binding.name == name && binding.depth <= builder.scope_depth -> return Val(binding)
        index -= 1
    }
    None
}
fn jet_codegen_find_binding_for_local(builder: JetCodegenBuilder, local: TLocal) -> ?JetCodegenBinding {
    if local.symbol_id == None -> return jet_codegen_find_binding(builder, local.name)
    symbol :: local.symbol_id ?? return None
    index := builder.bindings.len() - 1
    loop index >= 0 {
        binding :: builder.bindings[index]
        if binding.symbol_key == symbol.key && binding.depth <= builder.scope_depth -> return Val(binding)
        index -= 1
    }
    None
}
fn jet_codegen_find_place(builder: JetCodegenBuilder, place_id: MirPlaceId) -> ?MirPlace {
    loop place in builder.places {
        if place.id == place_id -> return Val(place)
    }
    None
}

fn jet_codegen_project_field_place(builder: &JetCodegenBuilder, base: MirPlaceId, span: Span, ty: Type, field: MirFieldId) -> MirPlaceId {
    base_place :: jet_codegen_find_place(builder, base) ?? panic("checked field place has no MIR base place")
    projections := [MirProjection]{}
    loop projection in base_place.projections -> projections.push(projection)
    projections.push(MirProjection.Field(field, span))
    identity := jet_codegen_identity(&builder, "place", span, "field", "{base.value}|{field.value}")
    place_id := MirPlaceId{value: stable_id("mir-place", identity)}
    builder.places.push(MirPlace{
        id: place_id,
        span: span,
        ty: jet_codegen_lower_type_for_function(ty, builder),
        base: base_place.base,
        projections: projections,
        access: base_place.access,
        persist_key: base_place.persist_key,
    })
    place_id
}


fn jet_codegen_find_function(functions: [TFunc], key: String) -> ?TFunc {
    loop function in functions {
        if function.key == key -> return Val(function)
    }
    None
}
fn jet_codegen_find_function_by_key(functions: [TFunc], key: String, module_identity: String) -> ?TFunc {
    found := None
    loop function in functions {
        if function.key == key && function.module_identity == module_identity {
            if found != None -> panic("ambiguous checked function key in Codegen input")
            found = Val(function)
        }
    }
    found
}


fn jet_codegen_function_id(function: TFunc) -> MirFunctionId {
    identity := "{function.module_identity}|{function.key}|{function.source_file}|{function.source_span.start}|{function.source_span.end}"
    if function.synthetic -> identity = "{identity}|synthetic|{function.name}"
    mir_function_id(identity)
}

fn jet_codegen_enter_lexical(builder: &JetCodegenBuilder) {
    builder.scope_depth += 1
}

fn jet_codegen_leave_lexical(builder: &JetCodegenBuilder) {
    if builder.scope_depth > 0 {
        builder.scope_depth -= 1
        jet_codegen_emit_drop_cleanups_to_depth(&builder, builder.scope_depth)
        loop builder.drop_live_places.len() > 0 {
            record := builder.drop_live_places[builder.drop_live_places.len() - 1]
            if record.depth <= builder.scope_depth -> break
            _ := builder.drop_live_places.pop()
        }
        loop builder.bindings.len() > 0 {
            binding := builder.bindings[builder.bindings.len() - 1]
            if binding.depth <= builder.scope_depth -> break
            _ := builder.bindings.pop()
        }
    }
}

fn jet_codegen_intern_prelude_call(builder: &JetCodegenBuilder, row: MirPreludeCall) -> MirPreludeCallId {
    loop existing in builder.prelude_calls {
        if existing.id == row.id -> return existing.id
    }
    builder.prelude_calls.push(row)
    builder.prelude_calls[builder.prelude_calls.len() - 1].id
}
