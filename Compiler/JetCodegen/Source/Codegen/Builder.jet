    MIRFieldRow,
    MIRFunction,
    MIRFunctionID,
    MIRInstruction,
    MIRLocal,
    MIRLocalID,
    MIROpID,
    MIROperation,
    MIROwnership,
    MIROwnershipMode,
    MIRParam,
    MIRPhiIncoming,
    MIRPlace,
    MIRPlaceBase,
    MIRPlaceID,
    MIRPreludeCall,
    MIRPreludeCallID,
    MIRProjection,
    MIRScope,
    MIRScopeFact,
    MIRScopeID,
    MIRScopeKind,
    MIRSourceFile,
    MIRTerminator,
    MIRTestScopeMember,
    MIRType,
    MIRValueFact,
    MIRValueID,
    MIRVectorFact,
    Span,
    SymbolID,
    TContract,
    TContractResult,
    TFunc,
    TLocal,
    TMethodRef,
    TPanicLoc,
    TPanicLocal,
    TTypeDef,
    Type,
    mir_copy_ownership,
    mir_copy_fact_for_ownership,
    mir_function_id,
    mir_owned_ownership,
    mir_ownership_from_access,
    mir_source_file_id,
    mir_type_same_checked_type,
