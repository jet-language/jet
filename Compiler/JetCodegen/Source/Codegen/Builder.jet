// Per-function MIR construction primitives shared by expression and statement
// lowering. IDs are stable for the checked function and source traversal.
use jet_foundation.[
    CanonicalPassJournal,
    MIRAccess,
    MIRBasicBlock,
    MIRBlockID,
    MIRCallArg,
    MIRCallbackAdapter,
    MIRCaptureFacts,
    MIRCaptureParam,
    MIRConstant,
    MIRConstantDef,
    MIRCoreCall,
    MIRDropKind,
    MIRFieldID,
    MIRFieldRow,
    MIRFunction,
    MIRFunctionID,
    MIRInstruction,
    MIRLocal,
    MIRLocalID,
    MIROpID,
    MIROperation,
    MIROwnership,
    MIROwnershipMode,
    MIRParam,
    MIRPhiIncoming,
    MIRPlace,
    MIRPlaceBase,
    MIRPlaceID,
    MIRPreludeCall,
    MIRPreludeCallID,
    MIRPollKind,
    MIRProjection,
    MIRRetainedRootCellAction,
    MIRRetainedRootCellBinding,
    MIRScope,
    MIRScopeFact,
    MIRScopeID,
    MIRScopeKind,
    MIRSourceFile,
    MIRTerminator,
    MIRTestScopeMember,
    MIRType,
    MIRValueFact,
    MIRValueID,
    MIRVectorFact,
    Span,
    SymbolID,
    TCompilerBuiltin,
    TContract,
    TContractResult,
    TExpr,
    TIfCond,
    TFunc,
    TLambda,
    TLocal,
    TMethodRef,
    TPanicLoc,
    TPanicLocal,
    TStmt,
    TTypeDef,
    Type,
    mir_copy_ownership,
    mir_operation_can_stop,
    mir_operation_stop_operand,
    mir_operation_stop_place,
    mir_copy_fact_for_ownership,
    mir_function_id,
    mir_type_id,
    mir_owned_ownership,
    mir_ownership_from_access,
    mir_source_file_id,
    mir_type_same_checked_type,
    stable_id,
    type_identity_equal,
    type_mir_identity_key,
    tir_each_expr_child,
    tir_each_if_cond_child,
    tir_each_stmt_child,
]
use jet_sema.[
    SemaGraphModuleResult,
    sema_registration_is_compiler_owned_enum,
]

struct JetCodegenBinding {
    name: String
    symbol_key: String
    ty: Type
    place: MIRPlaceID
    local: MIRLocalID
    depth: Int
}
struct JetCodegenDropLive {
    place: MIRPlaceID
    live: MIRPlaceID
    ty: Type
    kind: MIRDropKind
    span: Span
}
enum JetCodegenCleanupAction {
    DeferredCall(thunk: MIRValueID)
    DropPlace(record: JetCodegenDropLive)
}
struct JetCodegenCleanupFrame {
    owner: MIRScopeID?
    depth: Int
    binding_start: Int
    drop_live_start: Int
    actions: [JetCodegenCleanupAction]
    // Actions other than DropPlace: they run unconditionally, so only on the
    // exits registered after them.
    explicit: Int
    // Drop-chain entry blocks the frame's exits jump to, filled when the frame
    // closes (jet_codegen_seal_exit_chains).
    pending_exits: [JetCodegenPendingExit]
}
// One drop-chain entry of a frame: exits toward the target `key` names taken
// after the frame's first `explicit` explicit actions. `terminator` is the
// exit that ends the chain (a returned value travels in `slot`); `cut` is the
// frame depth the target's cleanup stops at.
struct JetCodegenPendingExit {
    key: String
    terminator: MIRTerminator
    slot: MIRPlaceID?
    explicit: Int
    cut: Int
    block: MIRBlockID
}
// A local that carries a returned value through a shared drop chain.
struct JetCodegenExitValueSlot {
    ty: MIRType
    place: MIRPlaceID
}

struct JetCodegenContractScopeState {
    result: TContractResult
    carrier_place: MIRPlaceID
    binding_place: MIRPlaceID
    post: [TContract]
}

struct JetCodegenLoopTarget {
    label: String?
    break_target: MIRBlockID
    continue_target: MIRBlockID
    break_scope_depth: Int
    continue_scope_depth: Int
    break_cleanup_depth: Int
    continue_cleanup_depth: Int
    break_seen: Bool
}
struct JetCodegenTransactionSnapshot {
    local: TLocal
    ty: Type
    saved_ty: Type
    place: MIRPlaceID
    saved_local: TLocal
    saved_place: MIRPlaceID
    rollback_type: Type?
    restore_method: TMethodRef?
}
struct JetCodegenTransactionState {
    scope: MIRScopeID
    stm_place: MIRPlaceID?
    handle_place: MIRPlaceID?
    snapshots: [JetCodegenTransactionSnapshot]
    loop_depth: Int
}
struct JetCodegenSourceLocation {
    line: Int
    source_line: String?
}

struct JetCodegenSwitchSubject {
    value: MIRValueID
    ty: Type
}

// D-OPT-WRITE1 (#3974): a pattern subject read from a `&place` write window.
struct JetCodegenPatternWindow {
    value: MIRValueID
    place: MIRPlaceID
}

// #5041: how the arms of a conditional binding lend their values
// (jet_codegen_lower_lent_conditional): the owned holder of a computed arm's
// value, the binding's MIR type, and the binding's scope depth.
struct JetCodegenConditionalLend {
    holder: MIRPlaceID
    ty: MIRType
    depth: Int
}

// Line starts and bytes of one checked source file, built once per lowering
// run so source locations binary-search and index the file in place instead
// of rescanning or re-encoding (copying) its text per location.
struct JetCodegenSourceLines {
    path: String
    line_starts: [Int]
    bytes: [U8]
}

// Every checked source file's line index, in `source_files` order, with the
// first row per path and per file id: a location lookup is one map read
// instead of a scan that copied the matching file's whole text.
struct JetCodegenSourceIndex {
    rows: [JetCodegenSourceLines]
    by_path: [String:Int]
    by_id: [U64:Int]
    duplicate_paths: [String:Bool]
}

fn jet_codegen_source_index(source_files: [MIRSourceFile]) -> JetCodegenSourceIndex Never! {
    rows := [JetCodegenSourceLines]{}
    by_path := [String:Int]{}
    by_id := [U64:Int]{}
    duplicate_paths := [String:Bool]{}
    loop row in source_files {
        bytes := row.source.bytes()
        starts := [Int]{0}
        loop (index, byte) in bytes {
            if byte == (U8{10}) -> &starts.push(index + 1)
        }
        if by_path.get(row.path) == None -> by_path[row.path] = rows.len() else -> duplicate_paths[row.path] = true
        if by_id.get(row.id.value) == None -> by_id[row.id.value] = rows.len()
        &rows.push(JetCodegenSourceLines{path: row.path, line_starts: starts, bytes: bytes})
    }
    JetCodegenSourceIndex{rows: rows, by_path: by_path, by_id: by_id, duplicate_paths: duplicate_paths}
}

// 1-based line holding byte `offset`: the count of line starts at or before it.
fn jet_codegen_line_of(line_starts: [Int], offset: Int) -> Int Never! {
    low := 0
    high := line_starts.len()
    loop low < high {
        middle :: (low + high) /% 2
        if line_starts[middle] <= offset -> low = middle + 1 else -> high = middle
    }
    low
}

// End (exclusive, before the newline) of the line starting at `line_start`.
fn jet_codegen_source_line_end(bytes: [U8], line_start: Int) -> Int Never! {
    line_end := line_start
    loop line_end < bytes.len() && bytes[line_end] != (U8{10}) -> line_end += 1
    line_end
}

// Bytes [start, end) of a source file, copied one by one: a range slice of
// the file would copy the whole file first.
fn jet_codegen_source_byte_range(bytes: [U8], start: Int, end: Int) -> [U8] Never! {
    out := [U8]{}
    index := start
    loop index < end {
        &out.push(bytes[index])
        index += 1
    }
    out
}

// Row of the lowered function's source file in `program.source_index` (and
// `program.source_files`, built in the same order).
fn jet_codegen_builder_source_row(builder: JetCodegenBuilder, program: JetCodegenProgram, ambiguous: String, missing: String) -> Int Never! {
    row :: program.source_index.by_path.get(builder.function.source_file) ?? panic(missing)
    if program.source_index.duplicate_paths.get(builder.function.source_file) != None -> panic(ambiguous)
    row
}

// Checked rows in input order. Unqualified calls keep the first match;
// qualified duplicates are recorded, but rejected only when looked up.
struct JetCodegenFunctionIndex {
    rows: [TFunc]
    first_by_key: [String:Int]
    first_by_name: [String:Int]
    next_by_key: [Int]
    next_by_name: [Int]
    qualified_rows: [String:Int]
}

fn jet_codegen_qualified_function_key(module_identity: String, key: String) -> String Never! {
    "{module_identity.len()}:{module_identity}{key}"
}

// The index owns its function rows, taken from the caller: program lowering
// moves the checked rows in and back out (lower_functions), and a caller that
// keeps its input, such as a comptime session, passes a copy (`.copy()`).
fn jet_codegen_function_index(functions: ^[TFunc]) -> JetCodegenFunctionIndex Never! {
    first_by_key := [String:Int]{}
    first_by_name := [String:Int]{}
    next_by_key := [Int]{}
    next_by_name := [Int]{}
    qualified_rows := [String:Int]{}
    loop _ in 0..<functions.len() {
        &next_by_key.push(-1)
        &next_by_name.push(-1)
    }
    row := functions.len() - 1
    loop row >= 0 {
        function :: functions[row]
        next_by_key[row] = first_by_key.get(function.key) ?? -1
        next_by_name[row] = first_by_name.get(function.name) ?? -1
        first_by_key[function.key] = row
        first_by_name[function.name] = row
        qualified :: jet_codegen_qualified_function_key(function.module_identity, function.key)
        if qualified_rows.get(qualified) == None -> qualified_rows[qualified] = row else -> qualified_rows[qualified] = -1
        row -= 1
    }
    JetCodegenFunctionIndex{rows: functions, first_by_key: first_by_key, first_by_name: first_by_name, next_by_key: next_by_key, next_by_name: next_by_name, qualified_rows: qualified_rows}
}

// Appends `functions` to `index` in order, as if they had followed its rows
// when it was built: first rows and qualified rows keep their earlier
// owners, and each same-key and same-name chain gains the new rows at its
// end. Moves the rows out of `functions` (left empty).
fn jet_codegen_function_index_append(index: &JetCodegenFunctionIndex, functions: &[TFunc]) Never! {
    reversed := [TFunc]{}
    loop functions.len() > 0 {
        function := &functions.pop() ?? { break }
        &reversed.push(^function)
    }
    loop reversed.len() > 0 {
        function := &reversed.pop() ?? { break }
        row :: index.rows.len()
        &index.next_by_key.push(-1)
        &index.next_by_name.push(-1)
        key_tail := index.first_by_key.get(function.key) ?? -1
        if key_tail < 0 {
            index.first_by_key[function.key] = row
        } else {
            loop index.next_by_key[key_tail] >= 0 {
                key_tail = index.next_by_key[key_tail]
            }
            index.next_by_key[key_tail] = row
        }
        name_tail := index.first_by_name.get(function.name) ?? -1
        if name_tail < 0 {
            index.first_by_name[function.name] = row
        } else {
            loop index.next_by_name[name_tail] >= 0 {
                name_tail = index.next_by_name[name_tail]
            }
            index.next_by_name[name_tail] = row
        }
        qualified :: jet_codegen_qualified_function_key(function.module_identity, function.key)
        if index.qualified_rows.get(qualified) == None -> index.qualified_rows[qualified] = row else -> index.qualified_rows[qualified] = -1
        &index.rows.push(^function)
    }
}


// The program-wide inputs of lowering, read-only while functions lower: every
// function taking a builder takes this beside it, so compiler threads can
// share one program while each lowers on its own builder.
struct JetCodegenProgram {
    function_index: JetCodegenFunctionIndex
    modules: [SemaGraphModuleResult]
    // Method owner metadata over `modules` (jet_codegen_owner_index).
    owners: JetCodegenOwnerIndex
    // Program-wide field symbol index (jet_codegen_field_symbol_index).
    field_symbols: [String:[JetCodegenFieldSymbolRow]]
    // Program-wide nominal and type-definition rows by key
    // (jet_codegen_nominal_index): a per-expression lookup reads one map row
    // instead of scanning every module's nominals or type definitions.
    nominals: JetCodegenNominalIndex
    // Checked foreign rows by key (jet_codegen_foreign_row_index).
    foreign_rows: JetCodegenForeignRowIndex
    source_files: [MIRSourceFile]
    source_index: JetCodegenSourceIndex
    edition: String
    canonical_journal: Shared<CanonicalPassJournal>?{None}
    // Unified host/stop contract (#4720): lower stop points (MIR Poll/Stopped)
    // for the native execution host. Only host compilations (session turns,
    // compiler callables) set it; every other compilation produces none.
    stop_points: Bool
    // Budget can-stop operations (jet_codegen_emit_budget_site): only a
    // compiler callable lowered for the native host spends comptime fuel and
    // depth; it implies `stop_points`.
    comptime_budget: Bool
}

// One lowering's state: the function being lowered (every field but
// `constant_copies` is per function, JetCodegenFunctionState) beside a
// JetCodegenProgram.
struct JetCodegenBuilder {
    function: TFunc
    // Card #4258: whether each constant (by symbol key) copies into its use
    // sites, decided on its first read (jet_codegen_constant_copies_into_uses
    // reads only the program, so every builder decides alike).
    constant_copies: [String:Bool]
    current_span: Span
    current_line: Int?
    generic_type_names: [String]
    current: MIRBlockID
    entry: MIRBlockID
    next_identity: Int
    scope_depth: Int
    blocks: [MIRBasicBlock]
    // MIR block id value -> position in `blocks`, kept by `jet_codegen_new_block`
    // so emitting into the current block never scans the block list.
    block_positions: [U64:Int]
    locals: [MIRLocal]
    // First row for each local id, including repeated symbol-backed locals.
    local_positions: [U64:Int]
    values: [MIRValueFact]
    // Last row for each value id, matching reverse ownership lookup.
    value_positions: [U64:Int]
    // First row for each value id, matching a forward scan of `values`.
    value_first_positions: [U64:Int]{[U64:Int]{}}
    places: [MIRPlace]
    // First row for each place id, matching `jet_codegen_find_place`.
    place_positions: [U64:Int]
    // Place ids pushed more than once (jet_codegen_push_place): access
    // retention updates every row of such an id, any other id's one row.
    place_repeats: [U64:Bool]{[U64:Bool]{}}
    scopes: [MIRScope]
    contract_scopes: [JetCodegenContractScopeState]
    params: [MIRParam]
    capture_params: [MIRCaptureParam]
    capture_facts: MIRCaptureFacts?
    // Physical capture addresses lend storage; the checked places still own it.
    retained_root: Bool
    retained_cells: [MIRRetainedRootCellBinding]
    retained_deferred: [JetCodegenRetainedDeferred]
    retained_grant_context: JetCodegenRetainedGrantContext?
    bindings: [JetCodegenBinding]
    loops: [JetCodegenLoopTarget]
    prelude_calls: [MIRPreludeCall]
    // Row position of each prelude_calls id, kept by every push.
    prelude_call_positions: [U64:Int]
    core_calls: [MIRCoreCall]
    used_core: [String]
    nested_functions: [MIRFunction]
    shared_sites: [MIRConstantDef]{[MIRConstantDef]{}}
    callbacks: [MIRCallbackAdapter]
    closure_sources: [JetCodegenClosureSource]
    checked_vector_facts: [MIRVectorFact]
    transactions: [JetCodegenTransactionState]
    transaction_cleanup_active: Bool
    drop_live_places: [JetCodegenDropLive]
    // A checked-TIR pre-scan selects only roots with projected owning moves.
    partial_move_roots: [String:Bool]
    split_drop_roots: [U64:Bool]
    // Read-window payload places a match binding aliases over an owned root
    // (no read parameter, element, constant, or aliased window on the way),
    // and those a checked `^p` (TLocal.payload_take) takes: a taken one is
    // moved out of the subject, never copied (jet_codegen_unmovable_place).
    owned_payload_places: [U64:Bool]{[U64:Bool]{}}
    payload_take_places: [U64:Bool]{[U64:Bool]{}}
    // Window places derived from a read alias's place: a payload under one
    // still belongs to the aliased owner.
    aliased_window_places: [U64:Bool]{[U64:Bool]{}}
    // Every drop-live record the function registered, kept after its frame
    // closes for the last-use pass (jet_codegen_move_last_uses).
    drop_live_all: [JetCodegenDropLive]
    cleanup_frames: [JetCodegenCleanupFrame]
    // The final block (id value) of each shared drop chain, by exit target key.
    exit_tails: [String:U64]
    // Locals that carry a returned value through a shared drop chain, one per
    // returned type.
    exit_value_slots: [JetCodegenExitValueSlot]
    switch_subject: JetCodegenSwitchSubject?
    spawn_occurrences: [String:Int]
    // Pattern subjects read through `&place`, and generated locals aliased
    // to one; their payload bindings alias the place (MIRProjection.Payload).
    pattern_windows: [JetCodegenPatternWindow]
    // Value id -> its first row in `pattern_windows` (jet_codegen_push_pattern_window).
    pattern_window_rows: [U64:Int]{[U64:Int]{}}
    pattern_lookup_head: MIRBlockID?
    pattern_lookup_caches: [String:MIRPlaceID]
    window_aliases: [String]
    // D-MEM-COPYSEM1: window places (by place ID) rooted at a read
    // parameter. A pattern on one tests it in place and binds each payload
    // name as a read-only alias: the parameter cannot change while the
    // function runs, so the alias reads exactly what a copy would hold.
    read_windows: [U64:Bool]
    // How many short-circuit right sides (`&&`/`||`, jet_codegen_lower_short_circuit)
    // enclose the expression being lowered. Their block does not dominate
    // the arm the condition guards, so a pattern subject lowered there takes
    // no window whose place carries index operands
    // (jet_codegen_lower_read_window).
    short_circuit_depth: Int{0}
    // Read-only alias locals' places (by place ID): a walked list's item or
    // a read window binding names another value's slot, so a consuming use
    // copies it instead of moving the slot out of its owner.
    read_alias_places: [U64:Bool]
    // D-MEM-COPYSEM1: the immutable place bindings of the function whose root
    // their scope leaves alone (jet_codegen_stable_element_lets), by
    // jet_codegen_element_let_key.
    stable_element_lets: [String:Bool]
    // #3740: the plain-return call a propagating `Try` consumes directly
    // (`jet_codegen_plain_try_identity`), and whether that call took it.
    plain_try_operand: String?
    plain_try_taken: Bool
    // True only on a stop edge's cleanup (Rust `stop_cleanup_active`): each
    // action there is bracketed by a typed StopCleanup scope.
    stop_cleanup_active: Bool
    // True while any cleanup frame runs: the native runtime masks stop
    // delivery for the whole frame (jet_rt_cleanup_enter), so no poll or
    // propagation edge is lowered inside it. A normal exit's cleanup is not a
    // stop edge and opens no StopCleanup scope (MIR legality
    // validate_stop_cleanup_scopes).
    cleanup_masked: Bool
}

// Rust LowerCtx::panic_context_at: a function with no readonly source (a
// synthetic or host-leaf row) and a blank source line both give an empty
// source line rather than stopping the build.
fn jet_codegen_source_location(builder: JetCodegenBuilder, program: JetCodegenProgram, include_source_line: Bool) -> JetCodegenSourceLocation Never! {
    empty_line := String?{None}
    if include_source_line -> empty_line = Val("")
    if builder.function.source_file == "" || program.source_index.by_path.get(builder.function.source_file) == None -> return JetCodegenSourceLocation{line: builder.current_line ?? 1, source_line: empty_line}
    row :: jet_codegen_builder_source_row(builder, program, "ambiguous checked function source context", "checked function has no readonly source context")
    if program.source_files[row].id != mir_source_file_id(program.source_files[row].path) -> panic("checked function source context has a conflicting file identity")
    byte_count :: program.source_index.rows[row].bytes.len()
    line := builder.current_line ?? 1
    if {
        builder.current_line == None -> {
            span := builder.current_span
            if span.start < 0 || span.start > byte_count -> panic("checked span falls outside its readonly source context")
            line = jet_codegen_line_of(program.source_index.rows[row].line_starts, span.start)
        } else -> {
            if line < 1 || line > program.source_index.rows[row].line_starts.len() -> panic("checked line marker is outside its readonly source context")
        }
    }
    line_start :: program.source_index.rows[row].line_starts[line - 1]
    source_line := String?{None}
    if include_source_line {
        line_end := jet_codegen_source_line_end(program.source_index.rows[row].bytes, line_start)
        if line_end > line_start && program.source_index.rows[row].bytes[line_end - 1] == (U8{13}) -> line_end -= 1
        line_text := String.from_bytes(jet_codegen_source_byte_range(program.source_index.rows[row].bytes, line_start, line_end)) ?? panic("checked source line is not valid UTF-8")
        source_line = Val(line_text)
    }
    JetCodegenSourceLocation{line: line, source_line: source_line}
}

fn jet_codegen_source_location_at(builder: &JetCodegenBuilder, program: JetCodegenProgram, span: Span, include_source_line: Bool) -> JetCodegenSourceLocation Never! {
    previous_span := builder.current_span
    builder.current_span = span
    location := jet_codegen_source_location(builder, program, include_source_line)
    builder.current_span = previous_span
    location
}

// #3713: the 1-based character column of `span` in the function's source,
// the same fact `Diagnostics::span_line_col` gives the host compiler.
// A function with no readonly source reports column 1 (Rust unwrap_or_default).
fn jet_codegen_source_column_at(builder: JetCodegenBuilder, program: JetCodegenProgram, span: Span) -> Int Never! {
    row :: program.source_index.by_path.get(builder.function.source_file) ?? return 1
    jet_codegen_source_column(program.source_index.rows[row].bytes, span)
}

fn jet_codegen_source_column(bytes: [U8], span: Span) -> Int Never! {
    if span.start < 0 || span.start > bytes.len() -> panic("checked span falls outside its readonly source context")
    column := 1
    offset := span.start
    loop offset > 0 && bytes[offset - 1] != (U8{10}) {
        offset -= 1
        if bytes[offset] < (U8{128}) || bytes[offset] >= (U8{192}) -> column += 1
    }
    column
}

fn jet_codegen_assignment_panic_location(builder: &JetCodegenBuilder, program: JetCodegenProgram, span: Span, include_source_line: Bool) -> TPanicLoc Never! {
    source := jet_codegen_source_location_at(&builder, program, span, include_source_line)
    source_line := if include_source_line -> source.source_line ?? panic("checked source context has no source line") else -> ""
    TPanicLoc{
        file: builder.function.source_file,
        source_line: source_line,
        line: source.line,
        column: 0,
        caret: 0,
        function: builder.function.name,
        locals: [TPanicLocal]{},
    }
}


// Original checked source, deliberately separate from MIR. The execution host
// pins these rows under its checked snapshot identity before admitting code.
struct JetCodegenClosureSource {
    function: MIRFunctionID
    source_file: String
    lambda: TLambda
}

struct JetCodegenLoweredFunction {
    function: MIRFunction
    nested_functions: [MIRFunction]
    shared_sites: [MIRConstantDef]{[MIRConstantDef]{}}
    callbacks: [MIRCallbackAdapter]
    closure_sources: [JetCodegenClosureSource]
    fields: [MIRFieldRow]
    prelude_calls: [MIRPreludeCall]
    core_calls: [MIRCoreCall]
    used_core: [String]
}

struct JetCodegenLambdaValue {
    value: MIRValueID
    function: MIRFunctionID
}


fn jet_codegen_identity(builder: &JetCodegenBuilder, program: JetCodegenProgram, kind: String, span: Span, role: String, detail: String) -> String Never! {
    index := builder.next_identity
    builder.next_identity = index + 1
    "{builder.function.key}|{kind}|{span.start}:{span.end}|{role}|{detail}|{index}"
}

// Owner metadata of every method, keyed by
// `jet_codegen_qualified_function_key(module, function key)`, built once per
// builder: asking per function scanned every type definition and impl.
// Each map keeps the first row in module, then declaration, order.
struct JetCodegenOwnerIndex {
    // Generic parameter names of the type definition that lists the method.
    type_method_generics: [String:[String]]
    // Target type of the first impl that declares the method.
    impl_method_targets: [String:Type]
    // Generic parameter names of each type definition, by qualified name.
    type_generics_by_name: [String:[String]]
    // Where each type definition sits in `modules`, by qualified name.
    type_def_rows: [String:JetCodegenTypeDefRow]
    // Ordered candidate rows for Index/IndexMut and serde hook lookups.
    hooks: JetCodegenHookIndex
    // Checked constant positions and lazy use-site classification, program-wide.
    constants: JetCodegenConstantIndex
    // Set by a comptime session for the closure it lowers: a type row then
    // lists only the methods in `closure_methods` (qualified keys of the
    // closure's functions), as if every other method were absent from it.
    closure_only: Bool
    closure_methods: [String:Bool]
}

struct JetCodegenTypeDefRow {
    module_index: Int
    definition_index: Int
}

fn jet_codegen_type_generic_names(definition: TTypeDef) -> [String] Never! {
    names := [String]{}
    loop parameter in definition.generic_params -> &names.push(parameter.name)
    names
}

fn jet_codegen_owner_index(modules: [SemaGraphModuleResult], nominals: JetCodegenNominalIndex) -> JetCodegenOwnerIndex Never! {
    type_method_generics := [String:[String]]{}
    impl_method_targets := [String:Type]{}
    type_generics_by_name := [String:[String]]{}
    type_def_rows := [String:JetCodegenTypeDefRow]{}
    loop module_row in 0..<modules.len() {
        module_identity :: modules[module_row].module_identity
        loop definition_row in 0..<modules[module_row].declarations.type_defs.len() {
            definition :: modules[module_row].declarations.type_defs[definition_row]
            name_key :: jet_codegen_qualified_function_key(module_identity, definition.name)
            if type_generics_by_name.get(name_key) == None {
                type_generics_by_name[name_key] = jet_codegen_type_generic_names(definition)
                type_def_rows[name_key] = JetCodegenTypeDefRow{module_index: module_row, definition_index: definition_row}
            }
            if definition.kind == {
                .Struct(_, methods) | .Enum(_, methods) -> {
                    loop method in methods {
                        method_key :: jet_codegen_qualified_function_key(module_identity, method)
                        if type_method_generics.get(method_key) == None -> type_method_generics[method_key] = jet_codegen_type_generic_names(definition)
                    }
                }
                else -> {}
            }
        }
        loop implementation_row in 0..<modules[module_row].impls.len() {
            implementation :: modules[module_row].impls[implementation_row]
            loop method_row in 0..<implementation.methods.len() {
                method :: implementation.methods[method_row]
                method_key :: jet_codegen_qualified_function_key(module_identity, method.symbol.id.key)
                if impl_method_targets.get(method_key) == None -> impl_method_targets[method_key] = implementation.target_type
            }
        }
    }
    JetCodegenOwnerIndex{type_method_generics: type_method_generics, impl_method_targets: impl_method_targets, type_generics_by_name: type_generics_by_name, type_def_rows: type_def_rows, hooks: jet_codegen_hook_index(modules), constants: jet_codegen_constant_index(modules, nominals), closure_only: false, closure_methods: [String:Bool]{}}
}

struct JetCodegenOwnerTypeBindings {
    names: [String]
    arguments: [Type]
    complete: Bool
}

fn jet_codegen_function_owner_pattern(function: TFunc, owners: JetCodegenOwnerIndex) -> Type? {
    registered_pattern :: owners.impl_method_targets.get(jet_codegen_qualified_function_key(function.module_identity, function.key))
    kind_pattern := if function.kind == {
        .Method(_, owner_type) | .TraitMethod(_, _, owner_type, _, _) -> Val(owner_type)
        else -> None
    }
    registered :: registered_pattern ?? return kind_pattern
    kind_owner :: kind_pattern ?? return Val(registered)
    if registered == {
        .Named(name) -> {
            if kind_owner == {
                .Apply(kind_name, _) -> {
                    if jet_codegen_owner_heads_match(name, kind_name, function.module_identity) {
                        return Val(kind_owner)
                    }
                }
                else -> {}
            }
        }
        else -> {}
    }
    Val(registered)
}

// A checked type spells a nominal of `owner_module` bare or qualified by that
// module (`Slot<Int>`, `<module>::Slot<Int>`); both name the one owner.
fn jet_codegen_owner_heads_match(pattern_name: String, actual_name: String, owner_module: String) -> Bool Never! {
    pattern_name == actual_name || actual_name == jet_codegen_qualified_type_key(owner_module, pattern_name) || pattern_name == jet_codegen_qualified_type_key(owner_module, actual_name)
}

// The receiver's owner head in the owner pattern's spelling, so the pattern's
// type parameters bind against the receiver's arguments.
fn jet_codegen_owner_receiver_in_pattern_spelling(pattern: Type, actual: Type, owner_module: String) -> Type Never! {
    if pattern == {
        .Apply(name, _) -> if actual == .Apply(actual_name, actual_args) {
            if actual_name != name && jet_codegen_owner_heads_match(name, actual_name, owner_module) -> return Type.Apply{name: name, args: actual_args}
        }
        .Named(name) -> if actual == .Named(actual_name) {
            if actual_name != name && jet_codegen_owner_heads_match(name, actual_name, owner_module) -> return Type.Named{name: name}
        }
        else -> {}
    }
    // copy: the pattern spelling is a new owned Type. Otherwise it equals `actual`, the caller's
    // checked type (a read parameter), which stays on its node.
    actual.copy()
}

fn jet_codegen_function_type_generic_names(function: TFunc, owners: JetCodegenOwnerIndex) -> [String] Never! {
    method_key :: jet_codegen_qualified_function_key(function.module_identity, function.key)
    if !owners.closure_only || owners.closure_methods.get(method_key) != None {
        listed :: owners.type_method_generics.get(method_key)
        if listed == .Val(names) -> return names
    }
    owner_pattern :: jet_codegen_function_owner_pattern(function, owners) ?? return [String]{}
    owner_name := if owner_pattern == {
        .Named(name) | .Apply(name, _) -> name
        else -> { return [String]{} }
    }
    owners.type_generics_by_name.get(jet_codegen_qualified_function_key(function.module_identity, owner_name)) ?? [String]{}
}

fn jet_codegen_owner_type_binding_index(names: [String], name: String) -> Int? {
    index := 0
    loop index < names.len() {
        if names[index] == name -> return Val(index)
        index += 1
    }
    None
}

fn jet_codegen_bind_owner_type_pattern(pattern: Type, actual: Type, owner_names: [String], names: &[String], arguments: &[Type]) -> Bool Never! {
    if pattern == {
        .Named(name) -> if owner_names.contains(name) {
            existing := jet_codegen_owner_type_binding_index(names, name)
            if existing != None {
                index :: existing ?? return false
                return type_identity_equal(arguments[index], actual)
            }
            &names.push(name)
            &arguments.push(actual)
            return true
        }
        else -> {}
    }
    if type_identity_equal(pattern, actual) -> return true
    if pattern == {
        .List(element) -> if actual == {
            .List(other) -> return jet_codegen_bind_owner_type_pattern(element, other, owner_names, &names, &arguments)
            else -> return false
        }
        .Map(key, _, value) -> if actual == {
            .Map(other_key, _, other_value) -> {
                if !jet_codegen_bind_owner_type_pattern(key, other_key, owner_names, &names, &arguments) -> return false
                return jet_codegen_bind_owner_type_pattern(value, other_value, owner_names, &names, &arguments)
            }
            else -> return false
        }
        .Shared(inner) -> if actual == {
            .Shared(other) -> return jet_codegen_bind_owner_type_pattern(inner, other, owner_names, &names, &arguments)
            else -> return false
        }
        .Option(inner) -> if actual == {
            .Option(other) -> return jet_codegen_bind_owner_type_pattern(inner, other, owner_names, &names, &arguments)
            else -> return false
        }
        .Result(ok, err) -> if actual == {
            .Result(other_ok, other_err) -> {
                if !jet_codegen_bind_owner_type_pattern(ok, other_ok, owner_names, &names, &arguments) -> return false
                return jet_codegen_bind_owner_type_pattern(err, other_err, owner_names, &names, &arguments)
            }
            else -> return false
        }
        .Apply(name, args) -> if actual == {
            .Apply(other_name, other_args) -> {
                if name != other_name || args.len() != other_args.len() -> return false
                index := 0
                loop index < args.len() {
                    if !jet_codegen_bind_owner_type_pattern(args[index], other_args[index], owner_names, &names, &arguments) -> return false
                    index += 1
                }
                return true
            }
            else -> return false
        }
        .Tuple(fields) -> if actual == {
            .Tuple(other_fields) -> {
                if fields.len() != other_fields.len() -> return false
                index := 0
                loop index < fields.len() {
                    if fields[index].name != other_fields[index].name -> return false
                    if !jet_codegen_bind_owner_type_pattern(fields[index].ty, other_fields[index].ty, owner_names, &names, &arguments) -> return false
                    index += 1
                }
                return true
            }
            else -> return false
        }
        .FixedList(element, length) -> if actual == {
            .FixedList(other, other_length) -> return length == other_length && jet_codegen_bind_owner_type_pattern(element, other, owner_names, &names, &arguments)
            else -> return false
        }
        .InlineRange(base, lo, hi) -> if actual == {
            .InlineRange(other, other_lo, other_hi) -> return lo == other_lo && hi == other_hi && jet_codegen_bind_owner_type_pattern(base, other, owner_names, &names, &arguments)
            else -> return false
        }
        .Tagged(marker, inner) -> if actual == {
            .Tagged(other_marker, other_inner) -> return marker == other_marker && jet_codegen_bind_owner_type_pattern(inner, other_inner, owner_names, &names, &arguments)
            else -> return false
        }
        .Union(members) -> if actual == {
            .Union(other_members) -> {
                if members.len() != other_members.len() -> return false
                index := 0
                loop index < members.len() {
                    if !jet_codegen_bind_owner_type_pattern(members[index], other_members[index], owner_names, &names, &arguments) -> return false
                    index += 1
                }
                return true
            }
            else -> return false
        }
        .Quantity(base, dimension) -> if actual == {
            .Quantity(other, other_dimension) -> return dimension == other_dimension && jet_codegen_bind_owner_type_pattern(base, other, owner_names, &names, &arguments)
            else -> return false
        }
        else -> return false
    }
}

fn jet_codegen_function_owner_bindings(function: TFunc, receiver_type: Type, owners: JetCodegenOwnerIndex) -> JetCodegenOwnerTypeBindings Never! {
    owner_pattern :: jet_codegen_function_owner_pattern(function, owners) ?? return JetCodegenOwnerTypeBindings{names: [String]{}, arguments: [Type]{}, complete: true}
    owner_names := jet_codegen_function_type_generic_names(function, owners)
    bound_names := [String]{}
    bound_arguments := [Type]{}
    receiver :: jet_codegen_owner_receiver_in_pattern_spelling(owner_pattern, receiver_type, function.module_identity)
    if !jet_codegen_bind_owner_type_pattern(owner_pattern, receiver, owner_names, &bound_names, &bound_arguments) -> return JetCodegenOwnerTypeBindings{names: [String]{}, arguments: [Type]{}, complete: false}
    ordered_names := [String]{}
    ordered_arguments := [Type]{}
    loop name in owner_names {
        index :: jet_codegen_owner_type_binding_index(bound_names, name) ?? return JetCodegenOwnerTypeBindings{names: [String]{}, arguments: [Type]{}, complete: false}
        &ordered_names.push(name)
        &ordered_arguments.push(bound_arguments[index])
    }
    if ordered_names.len() != bound_names.len() -> return JetCodegenOwnerTypeBindings{names: [String]{}, arguments: [Type]{}, complete: false}
    JetCodegenOwnerTypeBindings{names: ordered_names, arguments: ordered_arguments, complete: true}
}

// Rust: crates/jet-codegen/src/Codegen/TIR/mir.rs::LowerCtx::new
// The program-wide inputs move into the program, which owns them.
// The nominal index is built over `modules` (jet_codegen_nominal_index).
fn jet_codegen_new_program(function_index: ^JetCodegenFunctionIndex, modules: ^[SemaGraphModuleResult], nominals: ^JetCodegenNominalIndex, field_symbols: ^[String:[JetCodegenFieldSymbolRow]], source_files: [MIRSourceFile], source_index: ^JetCodegenSourceIndex, edition: String) -> JetCodegenProgram Never! {
    owners := jet_codegen_owner_index(modules, nominals)
    foreign_rows := jet_codegen_foreign_row_index(modules)
    JetCodegenProgram{function_index: function_index, modules: modules, owners: ^owners, field_symbols: field_symbols, nominals: nominals, foreign_rows: ^foreign_rows, source_files: source_files, source_index: source_index, edition: edition, stop_points: false, comptime_budget: false}
}

// One nominal of `modules`: its module row, its row in that module's
// `nominals`, and the last type definition of that module with the
// nominal's name (-1 for none).
struct JetCodegenNominalRow {
    module_index: Int
    nominal_index: Int
    type_def_index: Int
}

// One type definition of `modules`, by module and definition row.
struct JetCodegenTypeDefRef {
    module_index: Int
    definition_index: Int
}

// A checked nominal a spelling resolves to outside the current module, with
// where a scan of the modules meets it: its module row, then its rank in that
// module (the Core registry's nominal 0, the exact qualified spelling 1, Core
// builtin owner `j` 2 + j). Merging candidates from several tables keeps the
// one that scan met first (jet_codegen_nominal_candidate_first).
struct JetCodegenNominalCandidate {
    module_index: Int
    rank: Int
    module_name: String
    identity: JetCodegenNominalIdentity
}

// Program-wide lookup rows over JetCodegenProgram.modules, built once by
// jet_codegen_nominal_index. Every list keeps module, then declaration order,
// so the first row is the one a scan of the modules met first.
struct JetCodegenNominalIndex {
    // Nominal symbol key -> its rows.
    rows: [String:[JetCodegenNominalRow]]
    // Type definition key, and type definition name -> its rows.
    type_defs_by_key: [String:[JetCodegenTypeDefRef]]
    type_defs_by_name: [String:[JetCodegenTypeDefRef]]
    // MIR type ID values of the DefaultErr type definitions.
    default_err_ids: [U64:Bool]
    // Module identity -> its scope row in `scope_nominals` and `scope_owners`.
    scopes: [String:Int]
    // Per scope: its module rows, in module order.
    scope_modules: [[Int]]
    // "<scope row>:<nominal name>" -> every nominal of that name the scope's
    // modules declare, in module then declaration order.
    scope_rows: [String:[JetCodegenNominalRow]]
    // Module name -> its module rows, in module order.
    named_modules: [String:[Int]]
    // Per scope: each declared nominal name -> its identity in the first
    // module of that identity declaring the name.
    scope_nominals: [[String:JetCodegenNominalIdentity]]
    // Per scope: each Core builtin owner name -> the owners of that name the
    // scope's modules declare, in module and owner order.
    scope_owners: [[String:[JetCodegenNominalCandidate]]]
    // Nominal name -> the `<corelib>/` modules' nominals of that name.
    corelib_nominals: [String:[JetCodegenNominalCandidate]]
    // Exact qualified key `<module identity>::<leaf>` -> the first module
    // nominal it names.
    qualified_nominals: [String:JetCodegenNominalCandidate]
    // Core builtin owner symbol key -> the first owner carrying it.
    owner_keys: [String:JetCodegenNominalCandidate]
    // Core type leaf -> the one Core module exporting it ("" when several do).
    core_type_modules: [String:String]
    // The one original Prelude `Err` (jet_codegen_default_err_identity).
    default_err: JetCodegenNominalIdentity?
    // Why the default error rows, or a Core builtin owner row, are invalid
    // ("" for none): a lookup that reaches them panics with it, as the scan
    // of every module did.
    default_err_fault: String
    owner_fault: String
    // Declared traits by spelling (jet_codegen_trait_names).
    traits: JetCodegenTraitNames
}

fn jet_codegen_nominal_index(modules: [SemaGraphModuleResult]) -> JetCodegenNominalIndex Never! {
    rows := [String:[JetCodegenNominalRow]]{}
    type_defs_by_key := [String:[JetCodegenTypeDefRef]]{}
    type_defs_by_name := [String:[JetCodegenTypeDefRef]]{}
    default_err_ids := [U64:Bool]{}
    default_err := JetCodegenNominalIdentity?{None}
    default_err_fault := ""
    scopes := [String:Int]{}
    scope_modules := [[Int]]{}
    scope_rows := [String:[JetCodegenNominalRow]]{}
    named_modules := [String:[Int]]{}
    corelib_nominals := [String:[JetCodegenNominalCandidate]]{}
    qualified_nominals := [String:JetCodegenNominalCandidate]{}
    owner_keys := [String:JetCodegenNominalCandidate]{}
    owner_fault := ""
    loop module_index in 0..<modules.len() {
        semantic_module :: modules[module_index]
        identity :: semantic_module.module_identity
        if scopes.get(identity) == None {
            scopes[identity] = scope_modules.len()
            &scope_modules.push([Int]{})
        }
        scope :: scopes.get(identity) ?? panic("nominal index lost a module scope row")
        &scope_modules[scope].push(module_index)
        same_name := named_modules.get(semantic_module.module_name) ?? [Int]{}
        &same_name.push(module_index)
        named_modules[semantic_module.module_name] = same_name
        last_definition := [String:Int]{}
        loop definition_index in 0..<semantic_module.declarations.type_defs.len() {
            definition :: semantic_module.declarations.type_defs[definition_index]
            last_definition[definition.name] = definition_index
            reference :: JetCodegenTypeDefRef{module_index: module_index, definition_index: definition_index}
            by_key := type_defs_by_key.get(definition.key) ?? [JetCodegenTypeDefRef]{}
            &by_key.push(reference)
            type_defs_by_key[definition.key] = by_key
            by_name := type_defs_by_name.get(definition.name) ?? [JetCodegenTypeDefRef]{}
            &by_name.push(reference)
            type_defs_by_name[definition.name] = by_name
            if definition.compiler_builtin == (Val(TCompilerBuiltin.DefaultErr)) {
                default_err_ids[mir_type_id(definition.key).value] = true
                if default_err_fault == "" {
                    if semantic_module.nominal_positions.get(definition.name) == .Val(position) {
                        key :: jet_codegen_nominal_type_key(identity, semantic_module.nominals[position])
                        if default_err == .Val(existing) {
                            if existing.key != key -> default_err_fault = "ambiguous checked nominal type identity in Codegen input"
                        } else {
                            default_err = Val(JetCodegenNominalIdentity{module_identity: identity, name: semantic_module.nominals[position].symbol.name, key: key, qualified_name: key})
                        }
                    } else {
                        default_err_fault = "the compiler-owned default error has no checked nominal row"
                    }
                }
            }
        }
        corelib :: identity.starts_with("<corelib>/")
        loop nominal_index in 0..<semantic_module.nominals.len() {
            nominal :: semantic_module.nominals[nominal_index]
            found := rows.get(nominal.symbol.id.key) ?? [JetCodegenNominalRow]{}
            type_def_index :: last_definition.get(nominal.symbol.name) ?? -1
            &found.push(JetCodegenNominalRow{module_index: module_index, nominal_index: nominal_index, type_def_index: type_def_index})
            rows[nominal.symbol.id.key] = found
            scope_key :: "{scope}:{nominal.symbol.name}"
            in_scope := scope_rows.get(scope_key) ?? [JetCodegenNominalRow]{}
            &in_scope.push(JetCodegenNominalRow{module_index: module_index, nominal_index: nominal_index, type_def_index: type_def_index})
            scope_rows[scope_key] = in_scope
            // Spellings resolve to the first nominal of each name only.
            if (semantic_module.nominal_positions.get(nominal.symbol.name) ?? -1) != nominal_index -> next
            if corelib {
                key :: jet_codegen_nominal_type_key(identity, nominal)
                candidates := corelib_nominals.get(nominal.symbol.name) ?? [JetCodegenNominalCandidate]{}
                &candidates.push(JetCodegenNominalCandidate{module_index: module_index, rank: 0, module_name: semantic_module.module_name, identity: JetCodegenNominalIdentity{module_identity: identity, name: nominal.symbol.name, key: key, qualified_name: key}})
                corelib_nominals[nominal.symbol.name] = candidates
            }
            // The key of a nominal that is not a compiler-owned enum is
            // exactly `<module identity>::<name>`.
            if identity != "" && !sema_registration_is_compiler_owned_enum(nominal) {
                key :: jet_codegen_nominal_type_key(identity, nominal)
                if qualified_nominals.get(key) == None {
                    qualified_nominals[key] = JetCodegenNominalCandidate{module_index: module_index, rank: 1, module_name: semantic_module.module_name, identity: JetCodegenNominalIdentity{module_identity: identity, name: nominal.symbol.name, key: key, qualified_name: key}}
                }
            }
        }
        loop owner_index in 0..<semantic_module.declarations.core_builtin_owners.len() {
            owner :: semantic_module.declarations.core_builtin_owners[owner_index]
            fault :: jet_codegen_core_owner_fault(owner, semantic_module)
            if fault != "" {
                if owner_fault == "" -> owner_fault = fault
                next
            }
            if owner_keys.get(owner.symbol.key) == None {
                owner_keys[owner.symbol.key] = JetCodegenNominalCandidate{module_index: module_index, rank: 2 + owner_index, module_name: semantic_module.module_name, identity: jet_codegen_core_owner_identity(owner, semantic_module)}
            }
        }
    }
    scope_nominals := [[String:JetCodegenNominalIdentity]]{}
    scope_owners := [[String:[JetCodegenNominalCandidate]]]{}
    loop members in scope_modules {
        names := [String:JetCodegenNominalIdentity]{}
        owners := [String:[JetCodegenNominalCandidate]]{}
        loop module_index in members {
            semantic_module :: modules[module_index]
            loop nominal_index in 0..<semantic_module.nominals.len() {
                nominal :: semantic_module.nominals[nominal_index]
                if names.get(nominal.symbol.name) != None -> next
                key :: jet_codegen_nominal_type_key(semantic_module.module_identity, nominal)
                names[nominal.symbol.name] = JetCodegenNominalIdentity{module_identity: semantic_module.module_identity, name: nominal.symbol.name, key: key, qualified_name: key}
            }
            loop owner_index in 0..<semantic_module.declarations.core_builtin_owners.len() {
                owner :: semantic_module.declarations.core_builtin_owners[owner_index]
                // An invalid owner panics through `owner_fault` first.
                if jet_codegen_core_owner_fault(owner, semantic_module) != "" -> next
                candidates := owners.get(owner.name) ?? [JetCodegenNominalCandidate]{}
                &candidates.push(JetCodegenNominalCandidate{module_index: module_index, rank: 2 + owner_index, module_name: semantic_module.module_name, identity: jet_codegen_core_owner_identity(owner, semantic_module)})
                owners[owner.name] = candidates
            }
        }
        &scope_nominals.push(^names)
        &scope_owners.push(^owners)
    }
    JetCodegenNominalIndex{
        rows: rows,
        type_defs_by_key: type_defs_by_key,
        type_defs_by_name: type_defs_by_name,
        default_err_ids: default_err_ids,
        scopes: scopes,
        scope_modules: scope_modules,
        scope_rows: scope_rows,
        named_modules: named_modules,
        scope_nominals: scope_nominals,
        scope_owners: scope_owners,
        corelib_nominals: corelib_nominals,
        qualified_nominals: qualified_nominals,
        owner_keys: owner_keys,
        // Read only to pick among `corelib_nominals`: no rows, no registry scan
        // (jet_codegen_lower_type builds an index over no modules per type).
        core_type_modules: if corelib_nominals.len() == 0 -> [String:String]{} else -> jet_codegen_core_type_modules(),
        default_err: default_err,
        default_err_fault: default_err_fault,
        owner_fault: owner_fault,
        traits: jet_codegen_trait_names(modules),
    }
}

// Every nominal named `name` that the modules of `module_identity` declare,
// in module then declaration order: the rows a scan of every module, filtered
// by identity and then by nominal name, meets, read from one index row.
fn jet_codegen_scope_nominal_rows(nominals: JetCodegenNominalIndex, module_identity: String, name: String) -> [JetCodegenNominalRow] Never! {
    scope :: nominals.scopes.get(module_identity) ?? return [JetCodegenNominalRow]{}
    nominals.scope_rows.get("{scope}:{name}") ?? [JetCodegenNominalRow]{}
}

// Whether a module of `module_identity` is named `module_name`.
fn jet_codegen_scope_has_module(nominals: JetCodegenNominalIndex, modules: [SemaGraphModuleResult], module_identity: String, module_name: String) -> Bool Never! {
    scope :: nominals.scopes.get(module_identity) ?? return false
    loop module_index in nominals.scope_modules[scope] {
        if modules[module_index].module_name == module_name -> return true
    }
    false
}

// A builder ready to lower `function` against `program`.
fn jet_codegen_new_builder(function: TFunc, program: JetCodegenProgram) -> JetCodegenBuilder Never! {
    generic_type_names := [String]{}
    loop param in function.generic_params -> &generic_type_names.push(param.name)
    loop name in jet_codegen_function_type_generic_names(function, program.owners) {
        if !generic_type_names.contains(name) -> &generic_type_names.push(name)
    }
    builder := JetCodegenBuilder{
        function: function,
        constant_copies: [String:Bool]{},
        generic_type_names: generic_type_names,
        current_span: function.source_span,
        current_line: None,
        current: MIRBlockID{value: 0},
        entry: MIRBlockID{value: 0},
        next_identity: 0,
        scope_depth: 0,
        blocks: [MIRBasicBlock]{},
        block_positions: [U64:Int]{},
        locals: [MIRLocal]{},
        local_positions: [U64:Int]{},
        values: [MIRValueFact]{},
        value_positions: [U64:Int]{},
        places: [MIRPlace]{},
        place_positions: [U64:Int]{},
        scopes: [MIRScope]{},
        contract_scopes: [JetCodegenContractScopeState]{},
        params: [MIRParam]{},
        capture_params: [MIRCaptureParam]{},
        capture_facts: None,
        retained_root: false,
        retained_cells: [MIRRetainedRootCellBinding]{},
        retained_deferred: [JetCodegenRetainedDeferred]{},
        retained_grant_context: None,
        bindings: [JetCodegenBinding]{},
        loops: [JetCodegenLoopTarget]{},
        prelude_calls: [MIRPreludeCall]{},
        prelude_call_positions: [U64:Int]{},
        core_calls: [MIRCoreCall]{},
        used_core: [String]{},
        nested_functions: [MIRFunction]{},
        callbacks: [MIRCallbackAdapter]{},
        closure_sources: [JetCodegenClosureSource]{},
        checked_vector_facts: [MIRVectorFact]{},
        transactions: [JetCodegenTransactionState]{},
        drop_live_places: [JetCodegenDropLive]{},
        drop_live_all: [JetCodegenDropLive]{},
        partial_move_roots: [String:Bool]{},
        split_drop_roots: [U64:Bool]{},
        transaction_cleanup_active: false,
        cleanup_frames: [JetCodegenCleanupFrame]{JetCodegenCleanupFrame{
            owner: None,
            depth: 0,
            binding_start: 0,
            drop_live_start: 0,
            actions: [JetCodegenCleanupAction]{},
            explicit: 0,
            pending_exits: [JetCodegenPendingExit]{},
        }},
        exit_tails: [String:U64]{},
        exit_value_slots: [JetCodegenExitValueSlot]{},
        switch_subject: None,
        spawn_occurrences: [String:Int]{},
        pattern_windows: [JetCodegenPatternWindow]{},
        pattern_lookup_head: None,
        pattern_lookup_caches: [String:MIRPlaceID]{},
        window_aliases: [String]{},
        read_windows: [U64:Bool]{},
        read_alias_places: [U64:Bool]{},
        stable_element_lets: [String:Bool]{},
        plain_try_operand: None,
        plain_try_taken: false,
        stop_cleanup_active: false,
        cleanup_masked: false,
    }
    entry := jet_codegen_new_block(&builder, program, function.source_span, "entry")
    builder.entry = entry
    builder.current = entry
    builder
}

// The per-function part of a `JetCodegenBuilder`: every field except
// `constant_copies`, which holds program facts. A new builder field that
// belongs to one function must be
// added here, to `jet_codegen_begin_function`, `jet_codegen_function_state`
// and `jet_codegen_restore_function_state`, or it leaks between functions.
struct JetCodegenFunctionState {
    function: TFunc
    current_span: Span
    current_line: Int?
    generic_type_names: [String]
    current: MIRBlockID
    entry: MIRBlockID
    next_identity: Int
    scope_depth: Int
    blocks: [MIRBasicBlock]
    block_positions: [U64:Int]
    locals: [MIRLocal]
    local_positions: [U64:Int]
    values: [MIRValueFact]
    value_positions: [U64:Int]
    value_first_positions: [U64:Int]{[U64:Int]{}}
    places: [MIRPlace]
    place_positions: [U64:Int]
    place_repeats: [U64:Bool]{[U64:Bool]{}}
    scopes: [MIRScope]
    contract_scopes: [JetCodegenContractScopeState]
    params: [MIRParam]
    capture_params: [MIRCaptureParam]
    capture_facts: MIRCaptureFacts?
    retained_root: Bool
    retained_cells: [MIRRetainedRootCellBinding]
    retained_deferred: [JetCodegenRetainedDeferred]
    retained_grant_context: JetCodegenRetainedGrantContext?
    bindings: [JetCodegenBinding]
    loops: [JetCodegenLoopTarget]
    prelude_calls: [MIRPreludeCall]
    prelude_call_positions: [U64:Int]
    core_calls: [MIRCoreCall]
    used_core: [String]
    nested_functions: [MIRFunction]
    shared_sites: [MIRConstantDef]{[MIRConstantDef]{}}
    callbacks: [MIRCallbackAdapter]
    closure_sources: [JetCodegenClosureSource]
    checked_vector_facts: [MIRVectorFact]
    transactions: [JetCodegenTransactionState]
    transaction_cleanup_active: Bool
    drop_live_places: [JetCodegenDropLive]
    drop_live_all: [JetCodegenDropLive]
    partial_move_roots: [String:Bool]
    split_drop_roots: [U64:Bool]
    cleanup_frames: [JetCodegenCleanupFrame]
    exit_tails: [String:U64]
    exit_value_slots: [JetCodegenExitValueSlot]
    switch_subject: JetCodegenSwitchSubject?
    spawn_occurrences: [String:Int]
    pattern_windows: [JetCodegenPatternWindow]
    pattern_window_rows: [U64:Int]{[U64:Int]{}}
    pattern_lookup_head: MIRBlockID?
    pattern_lookup_caches: [String:MIRPlaceID]
    window_aliases: [String]
    read_windows: [U64:Bool]
    read_alias_places: [U64:Bool]
    stable_element_lets: [String:Bool]
    short_circuit_depth: Int{0}
    plain_try_operand: String?
    plain_try_taken: Bool
}

// Starts lowering `function` on a builder that already holds the program
// inputs. Every per-function field is reset, so one builder lowers every
// function of a run: a builder per function copied the whole checked program
// (all functions, modules and source files) once per function.
// Rust: crates/jet-codegen/src/Codegen/TIR/mir.rs::LowerCtx::new
fn jet_codegen_begin_function(builder: &JetCodegenBuilder, program: JetCodegenProgram, function: TFunc) Never! {
    generic_type_names := [String]{}
    loop param in function.generic_params -> &generic_type_names.push(param.name)
    loop name in jet_codegen_function_type_generic_names(function, program.owners) {
        if !generic_type_names.contains(name) -> &generic_type_names.push(name)
    }
    jet_codegen_restore_function_state(&builder, program, JetCodegenFunctionState{
        function: function,
        current_span: function.source_span,
        current_line: None,
        generic_type_names: generic_type_names,
        current: MIRBlockID{value: 0},
        entry: MIRBlockID{value: 0},
        next_identity: 0,
        scope_depth: 0,
        blocks: [MIRBasicBlock]{},
        block_positions: [U64:Int]{},
        locals: [MIRLocal]{},
        local_positions: [U64:Int]{},
        values: [MIRValueFact]{},
        value_positions: [U64:Int]{},
        places: [MIRPlace]{},
        place_positions: [U64:Int]{},
        scopes: [MIRScope]{},
        contract_scopes: [JetCodegenContractScopeState]{},
        params: [MIRParam]{},
        capture_params: [MIRCaptureParam]{},
        capture_facts: None,
        retained_root: false,
        retained_cells: [MIRRetainedRootCellBinding]{},
        retained_deferred: [JetCodegenRetainedDeferred]{},
        retained_grant_context: None,
        bindings: [JetCodegenBinding]{},
        loops: [JetCodegenLoopTarget]{},
        prelude_calls: [MIRPreludeCall]{},
        prelude_call_positions: [U64:Int]{},
        core_calls: [MIRCoreCall]{},
        used_core: [String]{},
        nested_functions: [MIRFunction]{},
        callbacks: [MIRCallbackAdapter]{},
        closure_sources: [JetCodegenClosureSource]{},
        checked_vector_facts: [MIRVectorFact]{},
        transactions: [JetCodegenTransactionState]{},
        transaction_cleanup_active: false,
        drop_live_places: [JetCodegenDropLive]{},
        drop_live_all: [JetCodegenDropLive]{},
        partial_move_roots: [String:Bool]{},
        split_drop_roots: [U64:Bool]{},
        cleanup_frames: [JetCodegenCleanupFrame]{JetCodegenCleanupFrame{
            owner: None,
            depth: 0,
            binding_start: 0,
            drop_live_start: 0,
            actions: [JetCodegenCleanupAction]{},
            explicit: 0,
            pending_exits: [JetCodegenPendingExit]{},
        }},
        exit_tails: [String:U64]{},
        exit_value_slots: [JetCodegenExitValueSlot]{},
        switch_subject: None,
        spawn_occurrences: [String:Int]{},
        pattern_windows: [JetCodegenPatternWindow]{},
        pattern_lookup_head: None,
        pattern_lookup_caches: [String:MIRPlaceID]{},
        window_aliases: [String]{},
        read_windows: [U64:Bool]{},
        read_alias_places: [U64:Bool]{},
        stable_element_lets: [String:Bool]{},
        plain_try_operand: None,
        plain_try_taken: false,
    })
    entry := jet_codegen_new_block(&builder, program, function.source_span, "entry")
    builder.entry = entry
    builder.current = entry
}

// The per-function state of `builder`, saved around a nested (lambda)
// function lowered on the same builder. The snapshot must own its nested
// rows independently: beginning the child resets the builder's list.
// Rust: none (Jet-only pass)
fn jet_codegen_function_state(builder: JetCodegenBuilder, program: JetCodegenProgram) -> JetCodegenFunctionState Never! {
    JetCodegenFunctionState{
        function: builder.function,
        current_span: builder.current_span,
        current_line: builder.current_line,
        generic_type_names: builder.generic_type_names,
        current: builder.current,
        entry: builder.entry,
        next_identity: builder.next_identity,
        scope_depth: builder.scope_depth,
        blocks: builder.blocks,
        block_positions: builder.block_positions,
        locals: builder.locals,
        local_positions: builder.local_positions,
        values: builder.values,
        value_positions: builder.value_positions,
        value_first_positions: builder.value_first_positions,
        places: builder.places,
        place_positions: builder.place_positions,
        place_repeats: builder.place_repeats,
        scopes: builder.scopes,
        contract_scopes: builder.contract_scopes,
        params: builder.params,
        capture_params: builder.capture_params,
        capture_facts: builder.capture_facts,
        retained_root: builder.retained_root,
        retained_cells: builder.retained_cells,
        retained_deferred: builder.retained_deferred,
        retained_grant_context: builder.retained_grant_context,
        bindings: builder.bindings,
        loops: builder.loops,
        prelude_calls: builder.prelude_calls,
        prelude_call_positions: builder.prelude_call_positions,
        core_calls: builder.core_calls,
        used_core: builder.used_core,
        nested_functions: builder.nested_functions,
        shared_sites: builder.shared_sites,
        callbacks: builder.callbacks,
        closure_sources: builder.closure_sources,
        checked_vector_facts: builder.checked_vector_facts,
        transactions: builder.transactions,
        transaction_cleanup_active: builder.transaction_cleanup_active,
        drop_live_places: builder.drop_live_places,
        drop_live_all: builder.drop_live_all,
        partial_move_roots: builder.partial_move_roots,
        split_drop_roots: builder.split_drop_roots,
        cleanup_frames: builder.cleanup_frames,
        exit_tails: builder.exit_tails,
        exit_value_slots: builder.exit_value_slots,
        switch_subject: builder.switch_subject,
        spawn_occurrences: builder.spawn_occurrences,
        pattern_windows: builder.pattern_windows,
        pattern_window_rows: builder.pattern_window_rows,
        short_circuit_depth: builder.short_circuit_depth,
        pattern_lookup_head: builder.pattern_lookup_head,
        pattern_lookup_caches: builder.pattern_lookup_caches,
        window_aliases: builder.window_aliases,
        read_windows: builder.read_windows,
        read_alias_places: builder.read_alias_places,
        stable_element_lets: builder.stable_element_lets,
        plain_try_operand: builder.plain_try_operand,
        plain_try_taken: builder.plain_try_taken,
    }
}

// Rust: none (Jet-only pass)
// The parameter owns this state. Transfer every non-Copy field out of that
// owner instead of cloning it into the builder and dropping the snapshot.
fn jet_codegen_restore_function_state(builder: &JetCodegenBuilder, program: JetCodegenProgram, state: ^JetCodegenFunctionState) Never! {
    builder.function = ^state.function
    builder.current_span = state.current_span
    builder.current_line = state.current_line
    builder.generic_type_names = ^state.generic_type_names
    builder.current = state.current
    builder.entry = state.entry
    builder.next_identity = state.next_identity
    builder.scope_depth = state.scope_depth
    builder.blocks = ^state.blocks
    builder.block_positions = ^state.block_positions
    builder.locals = ^state.locals
    builder.local_positions = ^state.local_positions
    builder.values = ^state.values
    builder.value_positions = ^state.value_positions
    builder.value_first_positions = ^state.value_first_positions
    builder.places = ^state.places
    builder.place_positions = ^state.place_positions
    builder.place_repeats = ^state.place_repeats
    builder.scopes = ^state.scopes
    builder.contract_scopes = ^state.contract_scopes
    builder.params = ^state.params
    builder.capture_params = ^state.capture_params
    builder.capture_facts = ^state.capture_facts
    builder.retained_root = state.retained_root
    builder.retained_cells = ^state.retained_cells
    builder.retained_deferred = ^state.retained_deferred
    builder.retained_grant_context = ^state.retained_grant_context
    builder.bindings = ^state.bindings
    builder.loops = ^state.loops
    builder.prelude_calls = ^state.prelude_calls
    builder.prelude_call_positions = ^state.prelude_call_positions
    builder.core_calls = ^state.core_calls
    builder.used_core = ^state.used_core
    builder.nested_functions = ^state.nested_functions
    builder.callbacks = ^state.callbacks
    builder.checked_vector_facts = ^state.checked_vector_facts
    builder.transactions = ^state.transactions
    builder.transaction_cleanup_active = state.transaction_cleanup_active
    builder.drop_live_places = ^state.drop_live_places
    builder.drop_live_all = ^state.drop_live_all
    builder.partial_move_roots = ^state.partial_move_roots
    builder.split_drop_roots = ^state.split_drop_roots
    builder.cleanup_frames = ^state.cleanup_frames
    builder.exit_tails = ^state.exit_tails
    builder.exit_value_slots = ^state.exit_value_slots
    builder.switch_subject = ^state.switch_subject
    builder.spawn_occurrences = ^state.spawn_occurrences
    builder.pattern_windows = ^state.pattern_windows
    builder.pattern_window_rows = ^state.pattern_window_rows
    builder.short_circuit_depth = state.short_circuit_depth
    builder.window_aliases = ^state.window_aliases
    builder.read_windows = ^state.read_windows
    builder.read_alias_places = ^state.read_alias_places
    builder.stable_element_lets = ^state.stable_element_lets
    builder.plain_try_operand = ^state.plain_try_operand
    builder.plain_try_taken = state.plain_try_taken
}

fn jet_codegen_new_block(builder: &JetCodegenBuilder, program: JetCodegenProgram, span: Span, role: String) -> MIRBlockID Never! {
    identity := jet_codegen_identity(&builder, program, "block", span, role, "")
    id := MIRBlockID{value: stable_id("mir-block", identity)}
    _ := &builder.block_positions.add(id.value, builder.blocks.len())
    &builder.blocks.push(MIRBasicBlock{
        id: id,
        span: span,
        instructions: [MIRInstruction]{},
        terminator: MIRTerminator.Unreachable{reason: "jet-codegen-open-block"},
    })
    id
}

fn jet_codegen_switch_block(builder: &JetCodegenBuilder, program: JetCodegenProgram, block: MIRBlockID) Never! {
    builder.current = block
    // A loop's continue target starts each next iteration: its Check runs
    // after the body's frames closed, where every live value is owned by an
    // enclosing frame.
    if !program.stop_points || !jet_codegen_current_is_open(builder, program) -> return
    at :: builder.block_positions.get(block.value) ?? return
    if builder.blocks[at].instructions.len() > 0 -> return
    loop row in builder.loops {
        if row.continue_target == block {
            jet_codegen_emit_budget_site(&builder, program, "step", "jet_rt_comptime_step")
            return jet_codegen_emit_poll(&builder, program, MIRPollKind.Check, false)
        }
    }
}

// Unified host/stop contract (#4720; design doc "Stop points"). In a
// stop-point program, end the current block with `Poll(kind)`: its stop edge
// runs every open frame's canonical cleanup and ends in Stopped, and lowering
// continues on the resume edge. `Check` is placed at function entry and at
// each loop continue target, where every live value is owned by a cleanup
// frame; `Propagate` directly follows each can-stop operation, before its
// result is bound, so the stop path never drops a result the operation may
// have left uninitialized. Shield and transaction masks defer cancellation,
// never Panic. Only propagation cleanup is already unwinding.
fn jet_codegen_emit_poll(builder: &JetCodegenBuilder, program: JetCodegenProgram, kind: MIRPollKind, panic_capable: Bool) Never! {
    if !program.stop_points || builder.stop_cleanup_active || builder.cleanup_masked -> return
    if !panic_capable && (builder.transactions.len() > 0 || jet_codegen_in_shield(builder)) -> return
    if !jet_codegen_current_is_open(builder, program) -> return
    span := builder.current_span
    resume :: jet_codegen_new_block(&builder, program, span, "poll-resume")
    stop :: jet_codegen_new_block(&builder, program, span, "poll-stop")
    jet_codegen_terminate(&builder, program, MIRTerminator.Poll{kind: kind, resume: resume, stop: stop})
    builder.current = stop
    builder.stop_cleanup_active = true
    jet_codegen_emit_cleanups_from_frame_depth(&builder, program, 0)
    builder.stop_cleanup_active = false
    jet_codegen_emit_budget_leave(&builder, program, MIRTerminator.Stopped)
    jet_codegen_terminate(&builder, program, MIRTerminator.Stopped)
    builder.current = resume
}

// Shared with explicit program-side stops: skip pre-call cleanup only when
// the operation's actual Propagate edge will own the canonical cleanup.
fn jet_codegen_can_emit_propagate(builder: JetCodegenBuilder, program: JetCodegenProgram) -> Bool Never! {
    program.stop_points && !builder.stop_cleanup_active && !builder.cleanup_masked && builder.transactions.len() == 0 && jet_codegen_current_is_open(builder, program)
}

fn jet_codegen_terminate_program_stop(builder: &JetCodegenBuilder, program: JetCodegenProgram, propagated: Bool, reason: String) Never! {
    if propagated -> jet_codegen_terminate(&builder, program, MIRTerminator.Stopped)
    else -> jet_codegen_terminate(&builder, program, MIRTerminator.Unreachable{reason: reason})
}

// These are real MIR branches, not hidden facts-only successors. Only an
// active native expectation has native_test_exit; non-test MIR is unchanged.
// A caught stop runs the existing deeper-frame chains, then the expectation's
// canonical exit runs its own defer/drop actions exactly once.
fn jet_codegen_emit_test_stop_edges(builder: &JetCodegenBuilder, program: JetCodegenProgram) Never! {
    index := builder.cleanup_frames.len()
    loop index > 0 {
        index -= 1
        scope := builder.cleanup_frames[index].owner ?? next
        exit_value := String?{None}
        loop row in builder.scopes {
            if row.id != scope -> next
            loop fact in row.facts {
                if fact.key == "native_test_exit" -> exit_value = Val(fact.value)
            }
        }
        text :: exit_value ?? next
        exit_number :: Int.parse(text) ?? panic("native expectation exit fact is not a block ID")
        exit_id :: U64.from_int(exit_number) ?? panic("native expectation exit fact exceeds a block ID")
        exit :: MIRBlockID{value: exit_id}
        masked :: builder.stop_cleanup_active
        builder.stop_cleanup_active = true
        span := builder.current_span
        scope_value :: jet_codegen_emit_value(&builder, program, span, Type.IntN{signed: false, bits: 64}, MIROperation.Constant{value: MIRConstant.Int{value: Int.from_u64(scope.value), width: Val(MIRIntegerWidth{signed: false, bits: 64}), spelling: None}})
        route :: jet_codegen_static_prelude_call(&builder, program, "core.testing", "catch_for_scope", "jet_rt_test_catch_for_scope", [Bool]{false}, None, TFailureCarrier.Infallible, false)
        caught :: jet_codegen_emit_static_prelude_call(&builder, program, span, Type.Bool, route, [MIRValueID]{scope_value})
        deeper := exit
        if index + 1 < builder.cleanup_frames.len() {
            last_frame := builder.cleanup_frames.len() - 1
            deeper = jet_codegen_exit_chain_entry(&builder, program, last_frame, "test-catch|{scope.value}", MIRTerminator.Jump{target: exit}, None, index + 1)
        }
        otherwise :: jet_codegen_new_block(&builder, program, span, "test-catch.next")
        jet_codegen_terminate(&builder, program, MIRTerminator.Branch{condition: caught, then_target: deeper, else_target: otherwise})
        builder.current = otherwise
        builder.stop_cleanup_active = masked
    }
}
// The entry of a stop-point function, after its parameters are bound: a
// compiler callable first enters one level of comptime depth, then the Check.
fn jet_codegen_emit_entry_check(builder: &JetCodegenBuilder, program: JetCodegenProgram) Never! {
    jet_codegen_emit_budget_site(&builder, program, "enter", "jet_rt_comptime_enter")
    jet_codegen_emit_poll(&builder, program, MIRPollKind.Check, false)
}

fn jet_codegen_in_shield(builder: JetCodegenBuilder) -> Bool Never! {
    loop frame in builder.cleanup_frames {
        scope :: frame.owner ?? next
        loop row in builder.scopes {
            if row.id == scope && row.kind == MIRScopeKind.Shield -> return true
        }
    }
    false
}

fn jet_codegen_is_open_terminator(terminator: MIRTerminator) -> Bool Never! {
    if terminator == {
        .Unreachable(reason) -> reason == "jet-codegen-open-block"
        else -> false
    }
}

fn jet_codegen_block_is_open(builder: JetCodegenBuilder, program: JetCodegenProgram, block_id: MIRBlockID) -> Bool Never! {
    at :: builder.block_positions.get(block_id.value) ?? return false
    jet_codegen_is_open_terminator(builder.blocks[at].terminator)
}

fn jet_codegen_current_is_open(builder: JetCodegenBuilder, program: JetCodegenProgram) -> Bool Never! {
    jet_codegen_block_is_open(builder, program, builder.current)
}

fn jet_codegen_terminate(builder: &JetCodegenBuilder, program: JetCodegenProgram, terminator: MIRTerminator) Never! {
    at :: builder.block_positions.get(builder.current.value) ?? panic("Jet codegen tried to terminate a missing MIR block")
    builder.blocks[at].terminator = terminator
}


// Rust: crates/jet-codegen/src/Codegen/TIR/mir.rs::LowerCtx::emit
fn jet_codegen_operation_can_stop(builder: JetCodegenBuilder, operation: MIROperation) -> Bool Never! {
    operand_type := MIRType?{None}
    if mir_operation_stop_operand(operation) == .Val(value) {
        if builder.value_positions.get(value.value) == .Val(at) -> operand_type = Val(builder.values[at].ty)
    }
    accessed_place := MIRPlace?{None}
    if mir_operation_stop_place(operation) == .Val(place) {
        if builder.place_positions.get(place.value) == .Val(at) -> accessed_place = Val(builder.places[at])
    }
    mir_operation_can_stop(operation, operand_type, accessed_place, builder.prelude_calls, builder.prelude_call_positions)
}

fn jet_codegen_emit(builder: &JetCodegenBuilder, program: JetCodegenProgram, span: Span, ty: Type?, requested: MIROperation) -> MIRValueID? {
    // D-MEM-COPYSEM1: a read parameter's place has no storage to give up,
    // and neither has an element of a container (Rust `lower_receiver_place`
    // never moves an index place). Consuming a read alias of one (a read
    // window or a read-place binding) copies the place, exactly as consuming
    // the copy it stands for would.
    operation := requested
    if requested == .MovePlace(moved) && jet_codegen_unmovable_place(builder, program, moved) -> operation = MIROperation.ReadPlace{place: moved}
    operation = jet_codegen_scalar_copy_fact(builder, program, operation)
    role := "operation"
    identity := jet_codegen_identity(&builder, program, "operation", span, role, "")
    op_id := MIROpID{value: stable_id("mir-op", identity)}
    result := MIRValueID?{None}
    mir_ty := MIRType?{None}
    if ty != None {
        value_type := jet_codegen_lower_type_for_function(ty, builder, program)
        value := MIRValueID{value: stable_id("mir-value", identity)}
        value_ownership :: jet_codegen_operation_ownership(builder, program, ty, operation)
        jet_codegen_push_value(&builder, program, MIRValueFact{id: value, ty: value_type, span: span, ownership: value_ownership})
        result = Val(value)
        mir_ty = Val(value_type)
    }
    instruction := MIRInstruction{id: op_id, span: span, source_line: None, result: result, ty: mir_ty, operation: operation}
    at :: builder.block_positions.get(builder.current.value) ?? panic("Jet codegen emitted into a missing MIR block")
    &builder.blocks[at].instructions.push(instruction)
    jet_codegen_record_retained_instruction(&builder, instruction)
    if operation == {
        .MovePlace(place) -> jet_codegen_set_drop_live(&builder, program, place, false)
        .InitializeUninit(place) -> jet_codegen_set_drop_live(&builder, program, place, true)
        .WritePlace(place, _) | .ReplacePlace(place, _) -> jet_codegen_set_drop_live(&builder, program, place, true)
        else -> {}
    }
    if jet_codegen_operation_can_stop(builder, operation) {
        panic_capable := true
        if operation == .ScopeExit(_) -> panic_capable = false
        jet_codegen_emit_poll(&builder, program, MIRPollKind.Propagate, panic_capable)
    }
    result
}

fn jet_codegen_emit_value(builder: &JetCodegenBuilder, program: JetCodegenProgram, span: Span, ty: Type, operation: MIROperation) -> MIRValueID Never! {
    jet_codegen_emit(&builder, program, span, Val(ty), operation) ?? panic("typed MIR operation produced no value")
}

// Rust: crates/jet-codegen/src/Codegen/TIR/mir.rs::LowerCtx::emit_mir_type
fn jet_codegen_emit_mir_type(builder: &JetCodegenBuilder, program: JetCodegenProgram, span: Span, ty: MIRType, ownership: MIROwnership, requested: MIROperation) -> MIRValueID Never! {
    operation :: jet_codegen_scalar_copy_fact(builder, program, requested)
    identity := jet_codegen_identity(&builder, program, "operation", span, "operation", "")
    op_id := MIROpID{value: stable_id("mir-op", identity)}
    value := MIRValueID{value: stable_id("mir-value", identity)}
    jet_codegen_push_value(&builder, program, MIRValueFact{id: value, ty: ty, span: span, ownership: ownership})
    instruction := MIRInstruction{id: op_id, span: span, source_line: None, result: Val(value), ty: Val(ty), operation: operation}
    at :: builder.block_positions.get(builder.current.value) ?? panic("Jet codegen emitted into a missing MIR block")
    &builder.blocks[at].instructions.push(instruction)
    jet_codegen_record_retained_instruction(&builder, instruction)
    if operation == {
        .MovePlace(place) -> jet_codegen_set_drop_live(&builder, program, place, false)
        .InitializeUninit(place) -> jet_codegen_set_drop_live(&builder, program, place, true)
        .WritePlace(place, _) | .ReplacePlace(place, _) -> jet_codegen_set_drop_live(&builder, program, place, true)
        else -> {}
    }
    if jet_codegen_operation_can_stop(builder, operation) {
        panic_capable := true
        if operation == .ScopeExit(_) -> panic_capable = false
        jet_codegen_emit_poll(&builder, program, MIRPollKind.Propagate, panic_capable)
    }
    value
}

// #4318 (mir.rs emit_mir_type_with_ownership): an implicit copy (materialize,
// share) of a Copy-ABI value is a bitwise `Scalar` read.
fn jet_codegen_scalar_copy_fact(builder: JetCodegenBuilder, program: JetCodegenProgram, operation: MIROperation) -> MIROperation Never! {
    if operation == .Copy(value, fact) {
        // copy: the operation with its copy fact is a new owned MIROperation. Without a position it
        // equals `operation`, the caller's operation (a read parameter), which stays with the
        // caller.
        at :: builder.value_positions.get(value.value) ?? return operation.copy()
        return MIROperation.Copy{value: value, fact: mir_copy_fact_for_ownership(fact, builder.values[at].ownership)}
    }
    // copy: the operation with its copy fact is a new owned MIROperation. Otherwise it equals
    // `operation`, the caller's operation (a read parameter), which stays with the caller.
    operation.copy()
}

fn jet_codegen_ownership(ty: Type) -> MIROwnership Never! {
    if ty == {
        .Int -> mir_copy_value_ownership()
        .Float | .Float32 | .Bool | .Char | .IntN(_, _) -> mir_copy_ownership()
        .Tagged(_, inner) | .InlineRange(inner, _, _) | .Quantity(inner, _) -> jet_codegen_ownership(inner)
        .Named(name) -> {
            if name == "Unit" || name == "Never" -> mir_copy_ownership()
            else -> mir_owned_ownership()
        }
        else -> mir_owned_ownership()
    }
}
fn jet_codegen_operation_ownership(builder: JetCodegenBuilder, program: JetCodegenProgram, ty: Type, operation: MIROperation) -> MIROwnership Never! {
    if operation == {
        .MovePlace(_) | .Move(_) -> return mir_ownership_from_access(MIRAccess.Move)
        .AddressOf(_, access) -> return mir_ownership_from_access(access)
        .RawAddressOf(_) -> return MIROwnership{mode: MIROwnershipMode.ReadBorrow, drop: MIRDropKind.NoDrop, moved: false, last_use: false, gc_root: false}
        .AttachTag(value, _) -> return jet_codegen_carrier_transfer_ownership(builder, value)
        .Convert(value, _, _, conversion) -> {
            if conversion == {
                .Transparent | .SendFn -> return jet_codegen_carrier_transfer_ownership(builder, value)
                else -> return jet_codegen_ownership(ty)
            }
        }
        .Phi(incoming) -> return jet_codegen_phi_ownership(builder, program, incoming)
        else -> return jet_codegen_ownership(ty)
    }
}

fn jet_codegen_carrier_transfer_ownership(builder: JetCodegenBuilder, value: MIRValueID) -> MIROwnership Never! {
    row :: builder.value_positions.get(value.value) ?? panic("checked carrier transfer has no source ownership fact")
    ownership := builder.values[row].ownership
    ownership.moved = false
    ownership.last_use = false
    return ownership
}

fn jet_codegen_phi_ownership(builder: JetCodegenBuilder, program: JetCodegenProgram, incoming: [MIRPhiIncoming]) -> MIROwnership Never! {
    if incoming.len() == 0 -> panic("Jet codegen produced a MIR phi with no ownership inputs")
    first := MIROwnership?{None}
    owned_inputs := true
    same_mode := true
    loop input in incoming {
        fact := MIRValueFact?{None}
        if builder.value_first_positions.get(input.value.value) == .Val(row) -> fact = Val(builder.values[row])
        ownership := (fact ?? panic("Jet codegen phi input has no ownership fact")).ownership
        if {
            first == None -> {
                first = Val(ownership)
            } else -> {
                initial :: first ?? panic("Jet codegen phi lost its first ownership fact")
                if ownership.drop != initial.drop -> panic("Jet codegen phi joins incompatible drop obligations")
                if ownership.mode != initial.mode -> same_mode = false
            }
        }
        if ownership.mode == {
            .Owned | .Shared | .Move -> {}
            else -> owned_inputs = false
        }
    }
    ownership := first ?? panic("Jet codegen phi has no first ownership fact")
    if same_mode -> return ownership
    if owned_inputs {
        ownership.mode = MIROwnershipMode.Owned
        ownership.moved = false
        ownership.last_use = false
        return ownership
    }
    panic("Jet codegen phi joins incompatible ownership modes")
}

// Scan completed TIR before any local, parameter or capture is emitted.
// Nested executables have their own scan; they must not split a same-named
// binding in the enclosing function. Ordinary children reuse Foundation's walk.
fn jet_codegen_partial_move_expression(expression: TExpr, roots: &[String:Bool]) Never! {
    if expression.kind == .Move(value) {
        if value.kind == .Field(_, _) && jet_codegen_ownership(value.ty).mode != MIROwnershipMode.Copy {
            root :: jet_codegen_field_chain_root_local(value)
            if root == .Val(local) -> roots[local.name] = true
        }
    }
    if expression.kind == {
        .Lambda(_) | .LambdaValue(_) -> return
        .InlineBlock(body) -> {
            jet_codegen_partial_move_statements(body, &roots)
            return
        }
        .IfExpr(condition, then_body, then_value, else_body, else_value) -> {
            jet_codegen_partial_move_condition(condition, &roots)
            jet_codegen_partial_move_statements(then_body, &roots)
            jet_codegen_partial_move_expression(then_value, &roots)
            jet_codegen_partial_move_statements(else_body, &roots)
            jet_codegen_partial_move_expression(else_value, &roots)
            return
        }
        .ResultHandler(subject, _, ok_body, ok_value, _, err_body, err_value, terminal) -> {
            jet_codegen_partial_move_expression(subject, &roots)
            jet_codegen_partial_move_statements(ok_body, &roots)
            jet_codegen_partial_move_expression(ok_value, &roots)
            jet_codegen_partial_move_statements(err_body, &roots)
            jet_codegen_partial_move_expression(err_value, &roots)
            jet_codegen_partial_move_expression(terminal, &roots)
            return
        }
        .SharedGuardWait(guard, condition, _) -> {
            jet_codegen_partial_move_expression(guard, &roots)
            jet_codegen_partial_move_expression(condition, &roots)
            return
        }
        .HostCall(call) -> if call == {
            .CCallback(_, _, _, _, _, _) -> return
            else -> {}
        }
        .CoreClosureCall(kind) -> {
            if kind == {
                .Spawn(group, _, _, _) -> {
                    if group == .Val(value) -> jet_codegen_partial_move_expression(value, &roots)
                }
                .Realtime(rate, frames, _) -> {
                    jet_codegen_partial_move_expression(rate, &roots)
                    jet_codegen_partial_move_expression(frames, &roots)
                }
                .Serve(address, _) -> jet_codegen_partial_move_expression(address, &roots)
                .OnInterrupt(callback) -> jet_codegen_partial_move_expression(callback, &roots)
                .UITextInputOnDrop(state, ime, _, _) -> {
                    jet_codegen_partial_move_expression(state, &roots)
                    jet_codegen_partial_move_expression(ime, &roots)
                }
                .UIButtonOnClick(label, shortcut, accessible_label, _, _) -> {
                    jet_codegen_partial_move_expression(label, &roots)
                    jet_codegen_partial_move_expression(shortcut, &roots)
                    jet_codegen_partial_move_expression(accessible_label, &roots)
                }
                .UIPreview(name, viewport, _, _, _, _, _, _, _, _, _, _, _) -> {
                    jet_codegen_partial_move_expression(name, &roots)
                    if viewport == .Val(value) -> jet_codegen_partial_move_expression(value, &roots)
                }
                else -> {}
            }
            return
        }
        .FnValue(kind) -> {
            if kind == .NamedFn(_, _) -> return
        }
        else -> {}
    }
    tir_each_expr_child(expression, (child: TExpr) -> jet_codegen_partial_move_expression(child, &roots))
}

fn jet_codegen_partial_move_condition(condition: TIfCond, roots: &[String:Bool]) Never! {
    if condition == {
        .WithPrelude(prelude, nested) -> {
            jet_codegen_partial_move_statements(prelude, &roots)
            jet_codegen_partial_move_condition(nested, &roots)
        }
        .And(left, right) -> {
            jet_codegen_partial_move_condition(left, &roots)
            jet_codegen_partial_move_condition(right, &roots)
        }
        else -> tir_each_if_cond_child(condition, (child: TExpr) -> jet_codegen_partial_move_expression(child, &roots))
    }
}

fn jet_codegen_partial_move_statements(statements: [TStmt], roots: &[String:Bool]) Never! {
    loop statement in statements {
        if statement == {
            .Reactive(_, _) -> next
            .ContractScope(pre, body, post, _, _) -> {
                loop contract in pre {
                    jet_codegen_partial_move_expression(contract.condition, &roots)
                    jet_codegen_partial_move_expression(contract.message, &roots)
                }
                jet_codegen_partial_move_statements(body, &roots)
                loop contract in post {
                    jet_codegen_partial_move_expression(contract.condition, &roots)
                    jet_codegen_partial_move_expression(contract.message, &roots)
                }
                next
            }
            .RefutableBind(_, init, fallback, _) -> {
                jet_codegen_partial_move_expression(init, &roots)
                jet_codegen_partial_move_statements(fallback, &roots)
                next
            }
            .TaskGroup(_, limit, body, _) -> {
                if limit == .Val(value) -> jet_codegen_partial_move_expression(value, &roots)
                jet_codegen_partial_move_statements(body, &roots)
                next
            }
            .If(condition, then_body, else_body, _, _) -> {
                jet_codegen_partial_move_condition(condition, &roots)
                jet_codegen_partial_move_statements(then_body, &roots)
                if else_body == .Val(body) -> jet_codegen_partial_move_statements(body, &roots)
                next
            }
            .Loop(_, body, _) | .Inline(body, _) | .DebugOnly(body, _) | .Impure(body, _)
            | .Region(body, _) | .Live(body, _) | .Shield(body, _) | .Unsafe(_, body)
            | .UnsafeBlock(_, body, _) | .SentryPolicy(_, body, _) | .Layout(_, _, body, _)
            | .Transact(_, _, _, body, _) -> {
                jet_codegen_partial_move_statements(body, &roots)
                next
            }
            .While(_, condition, body, _) -> {
                jet_codegen_partial_move_expression(condition, &roots)
                jet_codegen_partial_move_statements(body, &roots)
                next
            }
            .CountedLoop(_, init, condition, step, _, body, _) -> {
                jet_codegen_partial_move_statements([TStmt]{init}, &roots)
                jet_codegen_partial_move_expression(condition, &roots)
                if step == .Val(value) -> jet_codegen_partial_move_statements([TStmt]{value}, &roots)
                jet_codegen_partial_move_statements(body, &roots)
                next
            }
            .ForRange(_, _, start, end, step, _, body, _, _) -> {
                jet_codegen_partial_move_expression(start, &roots)
                jet_codegen_partial_move_expression(end, &roots)
                if step == .Val(value) -> jet_codegen_partial_move_expression(value, &roots)
                jet_codegen_partial_move_statements(body, &roots)
                next
            }
            .Range(_, _, source, start, end, step, _, _, body, _) -> {
                if source == .Val(value) -> jet_codegen_partial_move_expression(value, &roots)
                jet_codegen_partial_move_expression(start, &roots)
                jet_codegen_partial_move_expression(end, &roots)
                if step == .Val(value) -> jet_codegen_partial_move_expression(value, &roots)
                jet_codegen_partial_move_statements(body, &roots)
                next
            }
            .ForIn(_, _, _, source, collection, step, _, _, _, _, body, _) -> {
                jet_codegen_partial_move_expression(source, &roots)
                jet_codegen_partial_move_expression(collection, &roots)
                if step == .Val(value) -> jet_codegen_partial_move_expression(value, &roots)
                jet_codegen_partial_move_statements(body, &roots)
                next
            }
            .Match(subject, arms, _, _) | .EnumMatch(subject, arms, _, _, _) -> {
                jet_codegen_partial_move_expression(subject, &roots)
                loop arm in arms -> jet_codegen_partial_move_statements(arm.body, &roots)
                if statement == .EnumMatch(_, _, else_body, _, _) {
                    if else_body == .Val(body) -> jet_codegen_partial_move_statements(body, &roots)
                }
                next
            }
            .RangeSwitch(subject, arms, else_body, _) -> {
                jet_codegen_partial_move_expression(subject, &roots)
                loop arm in arms -> jet_codegen_partial_move_statements(arm.body, &roots)
                jet_codegen_partial_move_statements(else_body, &roots)
                next
            }
            .MixedSwitch(subject, _, arms, else_body, _) -> {
                jet_codegen_partial_move_expression(subject, &roots)
                loop arm in arms {
                    jet_codegen_partial_move_expression(arm.condition, &roots)
                    jet_codegen_partial_move_statements(arm.body, &roots)
                }
                if else_body == .Val(body) -> jet_codegen_partial_move_statements(body, &roots)
                next
            }
            .ContextBlock(guards, body, _) -> {
                loop guard in guards -> jet_codegen_partial_move_expression(guard.value, &roots)
                jet_codegen_partial_move_statements(body, &roots)
                next
            }
            .ScopeMember(kind, body, _) -> {
                if kind == .Timeout(duration) -> jet_codegen_partial_move_expression(duration, &roots)
                jet_codegen_partial_move_statements(body, &roots)
                next
            }
            .GCEdit(_, _, _, _, index_temp, edited, _) -> {
                if index_temp == .Val(value) -> jet_codegen_partial_move_expression(value, &roots)
                jet_codegen_partial_move_statements([TStmt]{edited}, &roots)
                next
            }
            else -> {}
        }
        tir_each_stmt_child(statement, (child: TExpr) -> jet_codegen_partial_move_expression(child, &roots))
    }
}

fn jet_codegen_partial_move_roots(statements: [TStmt], expression: TExpr?) -> [String:Bool] Never! {
    roots := [String:Bool]{}
    if expression == {
        .Val(value) -> jet_codegen_partial_move_expression(value, &roots)
        .None -> jet_codegen_partial_move_statements(statements, &roots)
    }
    roots
}

fn jet_codegen_place_covers_fields(root: MIRPlace, leaf: MIRPlace) -> Bool Never! {
    if root.base != leaf.base || root.projections.len() > leaf.projections.len() -> return false
    loop index in 0..<root.projections.len() {
        if root.projections[index] == .Field(root_field, _) {
            if leaf.projections[index] == .Field(leaf_field, _) {
                if root_field == leaf_field -> next
            }
        }
        return false
    }
    true
}

fn jet_codegen_set_drop_live(builder: &JetCodegenBuilder, program: JetCodegenProgram, place: MIRPlaceID, live: Bool) Never! {
    index := 0
    loop index < builder.drop_live_places.len() {
        record_place := builder.drop_live_places[index].place
        if record_place == place {
            record_span := builder.drop_live_places[index].span
            record_live := builder.drop_live_places[index].live
            value := jet_codegen_emit_value(&builder, program, record_span, Type.Bool, MIROperation.Constant{value: MIRConstant.Bool{value: live}})
            _ := jet_codegen_emit(&builder, program, record_span, None, MIROperation.WritePlace{place: record_live, value: value})
            return
        }
        index += 1
    }
    root :: jet_codegen_find_place(builder, program, place) ?? return
    if !live && root.projections.len() != 0 {
        loop owner in builder.places {
            if owner.base != root.base || owner.projections.len() != 0 -> next
            loop record in builder.drop_live_places {
                if record.place != owner.id -> next
                if jet_codegen_nominal_close_function(builder, program, record.ty) != None && !jet_codegen_is_consuming_close_receiver(builder, program, owner.id, record.ty) {
                    owner_type :: type_mir_identity_key(record.ty)
                    panic("cannot lower projected move from `{owner_type}`: owner has its own Close implementation")
                }
            }
        }
    }
    if builder.split_drop_roots.len() == 0 -> return
    split := false
    loop owner in builder.places {
        if builder.split_drop_roots.get(owner.id.value) != None && owner.base == root.base {
            split = true
            break
        }
    }
    if !split -> return
    index = 0
    covered := false
    loop index < builder.drop_live_places.len() {
        record_place := builder.drop_live_places[index].place
        record_span := builder.drop_live_places[index].span
        record_live := builder.drop_live_places[index].live
        index += 1
        leaf :: jet_codegen_find_place(builder, program, record_place) ?? panic("drop-live leaf has no MIR place")
        if !jet_codegen_place_covers_fields(root, leaf) -> next
        covered = true
        value := jet_codegen_emit_value(&builder, program, record_span, Type.Bool, MIROperation.Constant{value: MIRConstant.Bool{value: live}})
        _ := jet_codegen_emit(&builder, program, record_span, None, MIROperation.WritePlace{place: record_live, value: value})
    }
    if !live && !covered -> panic("cannot lower projected move under split owner: move covers no registered ownership leaf")
}

fn jet_codegen_drop_field_names(builder: JetCodegenBuilder, program: JetCodegenProgram, ty: Type) -> [String] Never! {
    names := [String]{}
    owner := jet_codegen_unwrap_pattern_tags(ty)
    if owner == {
        .Tuple(fields) -> {
            loop field in fields -> &names.push(field.name)
            return names
        }
        .Named(name) | .Apply(name, _) -> {
            identity :: jet_codegen_find_nominal_identity(program.nominals, builder.function.module_identity, name, builder.generic_type_names) ?? return names
            row :: program.owners.type_def_rows.get(jet_codegen_qualified_function_key(identity.module_identity, identity.name)) ?? return names
            if program.modules[row.module_index].declarations.type_defs[row.definition_index].kind == .Struct(fields, _) {
                loop field in fields {
                    if !field.computed -> &names.push(field.name)
                }
            }
        }
        else -> {}
    }
    names
}

fn jet_codegen_is_consuming_close_receiver(builder: JetCodegenBuilder, program: JetCodegenProgram, place: MIRPlaceID, ty: Type) -> Bool Never! {
    hook :: jet_codegen_nominal_close_function(builder, program, ty) ?? return false
    if jet_codegen_function_id(hook) != jet_codegen_function_id(builder.function) -> return false
    owner :: jet_codegen_find_place(builder, program, place) ?? return false
    if owner.projections.len() != 0 -> return false
    if owner.base == .Parameter(_) {
        loop binding in builder.bindings {
            if binding.place == place && binding.name == "self" -> return true
        }
    }
    false
}

// Containers, dynamic owners, nominal Close leaves and recursive back-edges
// stay atomic; only stored struct/tuple members are traversed.
fn jet_codegen_register_drop_leaves(builder: &JetCodegenBuilder, program: JetCodegenProgram, place: MIRPlaceID, ty: Type, initialized: Bool, structural_root: Bool, visiting: [String]) Never! {
    ownership :: jet_codegen_ownership(ty)
    if ownership.drop == MIRDropKind.NoDrop -> return
    key :: "{jet_codegen_type_instance_id(ty, program.nominals, builder.function.module_identity, builder.generic_type_names).value}"
    if !structural_root && (jet_codegen_nominal_close_function(builder, program, ty) != None || visiting.contains(key) || jet_codegen_is_core_file_owner_type(builder, program, ty)) {
        jet_codegen_register_drop_live(&builder, program, place, ty, ownership, initialized)
        return
    }
    fields :: jet_codegen_drop_field_names(builder, program, ty)
    if fields.len() == 0 {
        jet_codegen_register_drop_live(&builder, program, place, ty, ownership, initialized)
        return
    }
    ancestors := visiting.copy()
    &ancestors.push(key)
    // Cleanup reverses registration; stored fields unwind in declaration order.
    owned_field := false
    index := fields.len()
    loop index > 0 {
        index -= 1
        field_type :: jet_codegen_checked_host_field_type(builder, program, ty, fields[index])
        if jet_codegen_ownership(field_type).drop == MIRDropKind.NoDrop -> next
        owned_field = true
        field :: jet_codegen_host_field_id(builder, program, ty, fields[index])
        span := builder.current_span
        leaf := jet_codegen_project_field_place(&builder, program, place, span, field_type, field)
        jet_codegen_register_drop_leaves(&builder, program, leaf, field_type, initialized, false, ancestors)
    }
    // Owned nominal records remain move/drop leaves even when their stored
    // fields are all Copy; an empty traversal must not erase their live flag.
    if !owned_field -> jet_codegen_register_drop_live(&builder, program, place, ty, ownership, initialized)
}

// Rust `retain_place_access`: a place row referenced by several operations
// keeps the strongest access any of them required (Move, then Write, then
// Read), so a later read cannot invalidate an earlier borrow or move.
fn jet_codegen_retain_place_access(builder: &JetCodegenBuilder, program: JetCodegenProgram, place: MIRPlaceID, requested: MIRAccess) Never! {
    if builder.place_repeats.get(place.value) == None {
        row :: builder.place_positions.get(place.value) ?? return
        jet_codegen_retain_place_row(&builder, row, requested)
        return
    }
    loop index in 0..<builder.places.len() {
        if builder.places[index].id == place -> jet_codegen_retain_place_row(&builder, index, requested)
    }
}

fn jet_codegen_retain_place_row(builder: &JetCodegenBuilder, index: Int, requested: MIRAccess) Never! {
    current :: builder.places[index].access
    if {
        current == MIRAccess.Move || requested == MIRAccess.Move -> builder.places[index].access = MIRAccess.Move
        current == MIRAccess.Write || requested == MIRAccess.Write -> builder.places[index].access = MIRAccess.Write
        else -> {}
    }
}

// Rust: register_owned_drop's split test: a whole local or parameter whose
// source name the partial-move pre-scan recorded.
fn jet_codegen_partial_move_root(builder: JetCodegenBuilder, program: JetCodegenProgram, place: MIRPlaceID) -> Bool Never! {
    if builder.partial_move_roots.len() == 0 -> return false
    owner :: jet_codegen_find_place(builder, program, place) ?? return false
    if owner.projections.len() != 0 -> return false
    loop binding in builder.bindings {
        if binding.place == place && builder.partial_move_roots.get(binding.name) != None -> return true
    }
    false
}

// Rust: crates/jet-codegen/src/Codegen/TIR/mir.rs::LowerCtx::register_owned_drop
fn jet_codegen_register_drop_live(builder: &JetCodegenBuilder, program: JetCodegenProgram, place: MIRPlaceID, ty: Type, ownership: MIROwnership, initialized: Bool) Never! {
    retained :: jet_codegen_retained_cell_index(builder, place) >= 0
    if !retained && (ownership.drop == MIRDropKind.NoDrop || jet_codegen_ownership(ty).mode == MIROwnershipMode.Copy) -> return
    if retained {
        loop record in builder.drop_live_places {
            if record.place == place -> return
        }
    }
    // A root the pre-scan saw lose a projected owning move gets one live flag
    // per owned leaf, so the move clears exactly the moved leaf and scope end
    // drops only the remainder. A Close owner (other than the consuming
    // receiver) and a container, enum or opaque owner stay indivisible.
    if !retained && jet_codegen_partial_move_root(builder, program, place) {
        atomic :: jet_codegen_nominal_close_function(builder, program, ty) != None && !jet_codegen_is_consuming_close_receiver(builder, program, place, ty)
        if !atomic && jet_codegen_drop_field_names(builder, program, ty).len() != 0 {
            builder.split_drop_roots[place.value] = true
            jet_codegen_register_drop_leaves(&builder, program, place, ty, initialized, true, [String]{})
            return
        }
    }
    identity := "{builder.function.key}|drop-live|{place.value}"
    local_id := MIRLocalID{value: stable_id("mir-local", identity)}
    live_place := MIRPlaceID{value: stable_id("mir-place", "{identity}|place")}
    owner_span := builder.current_span
    loop owner in builder.places {
        if owner.id == place {
            owner_span = owner.span
            break
        }
    }
    live_ty := jet_codegen_lower_type_for_function(Type.Bool, builder, program)
    jet_codegen_push_local(&builder, program, MIRLocal{
        id: local_id,
        name: "$drop-live.{place.value}",
        span: owner_span,
        ty: live_ty,
        place: live_place,
        ssa_value: None,
        mutable: true,
        ownership: mir_copy_ownership(),
        is_comptime: false,
        uninit: false,
        arena_view: false,
        string_view: false,
        gc_root: false,
    })
    jet_codegen_push_place(&builder, program, MIRPlace{
        id: live_place,
        span: owner_span,
        ty: live_ty,
        base: MIRPlaceBase.Local{local: local_id},
        projections: [MIRProjection]{},
        access: MIRAccess.Write,
        persist_key: None,
    })
    record := JetCodegenDropLive{
        place: place,
        live: live_place,
        ty: ty,
        kind: ownership.drop,
        span: owner_span,
    }
    jet_codegen_attach_retained_live(&builder, program, record)
    // Ordinary lexical flags require dominating false writes. Retained root
    // flags are the existing canonical child cells: turn entry never resets them.
    if !retained {
        resume_block := builder.current
        builder.current = builder.entry
        cleared := jet_codegen_emit_value(&builder, program, owner_span, Type.Bool, MIROperation.Constant{value: MIRConstant.Bool{value: false}})
        _ := jet_codegen_emit(&builder, program, owner_span, None, MIROperation.WritePlace{place: live_place, value: cleared})
        builder.current = resume_block
    }
    &builder.drop_live_places.push(record)
    &builder.drop_live_all.push(record)
    if builder.cleanup_frames.len() == 0 -> panic("drop cleanup registered without an active cleanup frame")
    frame_index := builder.cleanup_frames.len() - 1
    if ownership.drop != MIRDropKind.NoDrop -> &builder.cleanup_frames[frame_index].actions.push(JetCodegenCleanupAction.DropPlace{record: record})
    if !retained {
        initial := jet_codegen_emit_value(&builder, program, owner_span, Type.Bool, MIROperation.Constant{value: MIRConstant.Bool{value: initialized}})
        _ := jet_codegen_emit(&builder, program, owner_span, None, MIROperation.WritePlace{place: live_place, value: initial})
    }
}
fn jet_codegen_emit_drop_cleanup(builder: &JetCodegenBuilder, program: JetCodegenProgram, record: JetCodegenDropLive) Never! {
    if !jet_codegen_current_is_open(builder, program) -> return
    live := jet_codegen_emit_value(&builder, program, record.span, Type.Bool, MIROperation.ReadPlace{place: record.live})
    drop_block := jet_codegen_new_block(&builder, program, record.span, "drop-live")
    next_block := jet_codegen_new_block(&builder, program, record.span, "drop-live-next")
    jet_codegen_terminate(&builder, program, MIRTerminator.Branch{condition: live, then_target: drop_block, else_target: next_block})
    jet_codegen_switch_block(&builder, program, drop_block)
    previous_grant := builder.retained_grant_context
    if jet_codegen_retained_cell_index(builder, record.place) >= 0 {
        builder.retained_grant_context = Val(JetCodegenRetainedGrantContext{place: record.place, action: MIRRetainedRootCellAction.Cleanup})
    }
    // The cleanup consumes the owned value, so its shared place row carries
    // Move access (Rust `emit_owned_place_cleanup`).
    jet_codegen_retain_place_access(&builder, program, record.place, MIRAccess.Move)
    value := jet_codegen_emit_value(&builder, program, record.span, record.ty, MIROperation.MovePlace{place: record.place})
    builder.retained_grant_context = previous_grant
    // A split leaf is never the consuming receiver, so it closes through its
    // nominal Close; a whole owner skips only its own consuming Close.
    owner :: jet_codegen_find_place(builder, program, record.place) ?? panic("drop cleanup has no MIR place")
    scope_close := if owner.projections.len() == 0 -> jet_codegen_scope_end_close_function(builder, program, record.ty) else -> jet_codegen_nominal_close_function(builder, program, record.ty)
    if scope_close == {
        .Val(function) -> jet_codegen_emit_scope_end_close(&builder, program, function, record.ty, value, record.span)
        .None -> _ := jet_codegen_emit(&builder, program, record.span, None, MIROperation.Drop{value: value, kind: record.kind})
    }
    if jet_codegen_current_is_open(builder, program) -> jet_codegen_terminate(&builder, program, MIRTerminator.Jump{target: next_block})
    jet_codegen_switch_block(&builder, program, next_block)
}

// This owner is deliberately not a lexical cleanup frame: the consumed action
// and its arguments must not be registered again on a sibling stop path.
fn jet_codegen_begin_stop_cleanup(builder: &JetCodegenBuilder, program: JetCodegenProgram) -> MIRScopeID Never! {
    span := builder.current_span
    identity :: jet_codegen_identity(&builder, program, "scope", span, "StopCleanup", "")
    scope :: MIRScopeID{value: stable_id("mir-scope", identity)}
    &builder.scopes.push(MIRScope{id: scope, kind: MIRScopeKind.StopCleanup, span: span, name: None, deadline: None, facts: [MIRScopeFact]{}})
    _ := jet_codegen_emit(&builder, program, span, None, MIROperation.ScopeEnter{scope: scope, test_member: None})
    scope
}

fn jet_codegen_emit_cleanup_action(builder: &JetCodegenBuilder, program: JetCodegenProgram, action: JetCodegenCleanupAction) Never! {
    if !jet_codegen_current_is_open(builder, program) -> return
    cleanup_scope :: if builder.stop_cleanup_active -> Val(jet_codegen_begin_stop_cleanup(&builder, program)) else -> MIRScopeID?{None}
    if action == {
        .DeferredCall(thunk) -> {
            if !jet_codegen_emit_retained_deferred(&builder, program, thunk) {
                current_span := builder.current_span
                _ := jet_codegen_emit(&builder, program, current_span, None, MIROperation.IndirectCall{callee: thunk, args: [MIRCallArg]{}, type_args: [MIRType]{}})
            }
        }
        .DropPlace(record) -> jet_codegen_emit_drop_cleanup(&builder, program, record)
    }
    if cleanup_scope == .Val(scope) && jet_codegen_current_is_open(builder, program) {
        current_span := builder.current_span
        _ := jet_codegen_emit(&builder, program, current_span, None, MIROperation.ScopeExit{scope: scope})
    }
}

fn jet_codegen_cleanup_action_is_drop(action: JetCodegenCleanupAction) -> Bool {
    if action == {
        .DropPlace(_) -> true
        .DeferredCall(_) -> false
    }
}

/// D-SHAPE-RESOURCE1=A: explicit deferred actions run first in reverse
/// registration order; the automatic safety net then closes or releases every
/// still-live local in reverse declaration order.
// Current and already-run actions are absent before the operation is emitted.
// Saved registrations are restored for sibling paths, never this stop edge.
fn jet_codegen_emit_cleanup_suffix(builder: &JetCodegenBuilder, program: JetCodegenProgram, depth: Int, remaining: [JetCodegenCleanupAction], action: JetCodegenCleanupAction) Never! {
    saved := builder.cleanup_frames
    active := [JetCodegenCleanupFrame]{}
    loop index in 0..depth -> &active.push(saved[index])
    active[depth].actions = remaining
    active[depth].explicit = 0
    loop item in remaining {
        if !jet_codegen_cleanup_action_is_drop(item) -> active[depth].explicit += 1
    }
    builder.cleanup_frames = active
    jet_codegen_emit_cleanup_action(&builder, program, action)
    builder.cleanup_frames = saved
}

fn jet_codegen_emit_cleanup_frame(builder: &JetCodegenBuilder, program: JetCodegenProgram, frame_index: Int) Never! {
    if frame_index < 0 || frame_index >= builder.cleanup_frames.len() -> panic("MIR cleanup frame index is outside the active stack")
    frame := builder.cleanup_frames[frame_index]
    masked :: builder.cleanup_masked
    builder.cleanup_masked = true
    saved := MIRValueID?{None}
    if program.stop_points && !program.comptime_budget && frame.actions.len() > 0 {
        route :: jet_codegen_static_prelude_call(&builder, program, "core.cleanup", "enter", "jet_rt_cleanup_enter", [Bool]{}, None, TFailureCarrier.Infallible, false)
        span := builder.current_span
        saved = Val(jet_codegen_emit_static_prelude_call(&builder, program, span, Type.IntN{signed: true, bits: 64}, route, [MIRValueID]{}))
    }
    loop automatic in [false, true] {
        index := frame.actions.len()
        loop index > 0 {
            index -= 1
            action := frame.actions[index]
            if jet_codegen_cleanup_action_is_drop(action) != automatic -> next
            remaining := [JetCodegenCleanupAction]{}
            loop (at, item) in frame.actions {
                if {
                    !automatic && jet_codegen_cleanup_action_is_drop(item) -> &remaining.push(item)
                    at < index && jet_codegen_cleanup_action_is_drop(item) == automatic -> &remaining.push(item)
                    else -> {}
                }
            }
            jet_codegen_emit_cleanup_suffix(&builder, program, frame_index, remaining, action)
            if !jet_codegen_current_is_open(builder, program) -> return
        }
    }
    if saved == .Val(word) {
        route :: jet_codegen_static_prelude_call(&builder, program, "core.cleanup", "leave", "jet_rt_cleanup_leave", [Bool]{false}, None, TFailureCarrier.Infallible, false)
        span := builder.current_span
        _ := jet_codegen_emit_static_prelude_call(&builder, program, span, Type.Named{name: "Unit"}, route, [MIRValueID]{word})
    }
    builder.cleanup_masked = masked
    if frame.owner != None && jet_codegen_current_is_open(builder, program) {
        scope :: frame.owner ?? panic("owned cleanup frame lost its MIR scope")
        current_span := builder.current_span
        _ := jet_codegen_emit(&builder, program, current_span, None, MIROperation.ScopeExit{scope: scope})
    }
}

fn jet_codegen_emit_cleanups_from_frame_depth(builder: &JetCodegenBuilder, program: JetCodegenProgram, frame_depth: Int) Never! {
    if frame_depth < 0 || frame_depth > builder.cleanup_frames.len() -> panic("MIR cleanup depth is outside the active stack")
    index := builder.cleanup_frames.len()
    loop index > frame_depth {
        index -= 1
        jet_codegen_emit_cleanup_frame(&builder, program, index)
        if !jet_codegen_current_is_open(builder, program) -> return
    }
}

fn jet_codegen_emit_explicit_stop_cleanups(builder: &JetCodegenBuilder, program: JetCodegenProgram) Never! {
    jet_codegen_emit_cleanups_from_frame_depth(&builder, program, 0)
}

fn jet_codegen_register_deferred_call(builder: &JetCodegenBuilder, program: JetCodegenProgram, thunk: MIRValueID, result_type: Type) Never! {
    if builder.cleanup_frames.len() == 0 -> panic("defer registered without an active cleanup frame")
    frame_index := builder.cleanup_frames.len() - 1
    if builder.retained_root && frame_index == 0 -> jet_codegen_retain_deferred_call(&builder, program, thunk, result_type)
    &builder.cleanup_frames[frame_index].actions.push(JetCodegenCleanupAction.DeferredCall{thunk: thunk})
    builder.cleanup_frames[frame_index].explicit = builder.cleanup_frames[frame_index].explicit + 1
}

fn jet_codegen_terminate_cleanup_frame_depth(builder: JetCodegenBuilder, program: JetCodegenProgram, terminator: MIRTerminator, depth: Int) -> Int Never! {
    if terminator == {
        .Return(_) -> {
            if depth != -1 -> panic("function return carries a loop cleanup depth")
            return if builder.retained_root -> 1 else -> 0
        }
        // A stop leaves the function: every frame's cleanup runs.
        .Stopped -> return 0
        .Break(target, _) -> {
            index := builder.loops.len() - 1
            loop index >= 0 {
                if builder.loops[index].break_target == target {
                    if builder.loops[index].break_scope_depth != depth -> panic("checked break has mismatched lexical and cleanup depths")
                    return builder.loops[index].break_cleanup_depth
                }
                index -= 1
            }
            panic("checked break does not resolve to a MIR cleanup frame")
        }
        .Continue(target) -> {
            index := builder.loops.len() - 1
            loop index >= 0 {
                if builder.loops[index].continue_target == target {
                    if builder.loops[index].continue_scope_depth != depth -> panic("checked continue has mismatched lexical and cleanup depths")
                    return builder.loops[index].continue_cleanup_depth
                }
                index -= 1
            }
            panic("checked continue does not resolve to a MIR cleanup frame")
        }
        else -> return builder.cleanup_frames.len()
    }
}

// End the current path with `terminator`, running the cleanups of every frame
// from the target's depth up first. Each frame's cleanups are lowered once, as
// a drop chain its exits share (jet_codegen_seal_exit_chains), so cleanup code
// grows with the frame's locals, not with exits times locals. Exits that
// cannot share a chain clean up inline on their own path.
fn jet_codegen_terminate_with_owned_cleanup(builder: &JetCodegenBuilder, program: JetCodegenProgram, terminator: MIRTerminator, depth: Int) -> Bool {
    if !jet_codegen_prepare_transaction_exit(&builder, program, terminator) -> return false
    if depth < -1 -> panic("checked MIR cleanup depth is negative")
    frame_depth := jet_codegen_terminate_cleanup_frame_depth(builder, program, terminator, depth)
    if jet_codegen_enter_exit_chain(&builder, program, terminator, frame_depth) -> return true
    jet_codegen_emit_cleanups_from_frame_depth(&builder, program, frame_depth)
    if !jet_codegen_current_is_open(builder, program) -> return false
    jet_codegen_emit_budget_leave(&builder, program, terminator)
    jet_codegen_terminate(&builder, program, terminator)
    true
}

// Leave through the drop chain of the innermost frame. False when the exit
// cleans up inline instead: no frame it leaves owes cleanup, or it carries a
// value no slot can hold (a break value feeds its loop's phi by predecessor;
// a borrow stays on its own path).
fn jet_codegen_enter_exit_chain(builder: &JetCodegenBuilder, program: JetCodegenProgram, terminator: MIRTerminator, frame_depth: Int) -> Bool Never! {
    owes_cleanup := false
    index := frame_depth
    loop index < builder.cleanup_frames.len() {
        if builder.cleanup_frames[index].actions.len() > 0 || builder.cleanup_frames[index].owner != None -> owes_cleanup = true
        index += 1
    }
    if !owes_cleanup -> return false
    key := ""
    tail := terminator
    slot := MIRPlaceID?{None}
    if terminator == {
        .Return(value) -> {
            if value == .Val(returned) {
                place :: jet_codegen_exit_value_slot(&builder, program, returned) ?? return false
                current_span := builder.current_span
                _ := jet_codegen_emit(&builder, program, current_span, None, MIROperation.WritePlace{place: place, value: returned})
                slot = Val(place)
                tail = MIRTerminator.Return{value: None}
                key = "return|{place.value}"
            } else {
                key = "return"
            }
        }
        .Break(target, value) -> {
            if value != None -> return false
            key = "break|{target.value}"
        }
        .Continue(target) -> key = "continue|{target.value}"
        .Stopped -> key = "stopped"
        else -> return false
    }
    top := builder.cleanup_frames.len() - 1
    entry := jet_codegen_exit_chain_entry(&builder, program, top, key, tail, slot, frame_depth)
    jet_codegen_terminate(&builder, program, MIRTerminator.Jump{target: entry})
    true
}

// The local a returned value waits in while its drop chain runs, one per
// returned type; None for a borrow.
// Rust: none (Jet-only pass)
fn jet_codegen_exit_value_slot(builder: &JetCodegenBuilder, program: JetCodegenProgram, value: MIRValueID) -> MIRPlaceID? Never! {
    // The returned value was produced just before the exit, so the scan from
    // the newest fact is short.
    fact := MIRValueFact?{None}
    index := builder.values.len()
    loop index > 0 {
        index -= 1
        if builder.values[index].id == value {
            fact = Val(builder.values[index])
            break
        }
    }
    row :: fact ?? return None
    if row.ownership.mode == {
        .ReadBorrow | .WriteBorrow -> return None
        else -> {}
    }
    loop existing in builder.exit_value_slots {
        if mir_type_same_checked_type(existing.ty, row.ty) -> return Val(existing.place)
    }
    ordinal := builder.exit_value_slots.len()
    identity := "{builder.function.key}|exit-value|{ordinal}"
    local_id := MIRLocalID{value: stable_id("mir-local", identity)}
    place := MIRPlaceID{value: stable_id("mir-place", "{identity}|place")}
    span := builder.current_span
    ownership := row.ownership
    ownership.moved = false
    ownership.last_use = false
    jet_codegen_push_local(&builder, program, MIRLocal{
        id: local_id,
        name: "$exit-value.{ordinal}",
        span: span,
        ty: row.ty,
        place: place,
        ssa_value: None,
        mutable: true,
        ownership: ownership,
        is_comptime: false,
        uninit: false,
        arena_view: false,
        string_view: false,
        gc_root: false,
    })
    jet_codegen_push_place(&builder, program, MIRPlace{
        id: place,
        span: span,
        ty: row.ty,
        base: MIRPlaceBase.Local{local: local_id},
        projections: [MIRProjection]{},
        access: MIRAccess.Move,
        persist_key: None,
    })
    &builder.exit_value_slots.push(JetCodegenExitValueSlot{ty: row.ty, place: place})
    Val(place)
}

// The block an exit from frame `depth` toward `key` jumps to: one per target
// and per count of the frame's explicit actions so far.
fn jet_codegen_exit_chain_entry(builder: &JetCodegenBuilder, program: JetCodegenProgram, depth: Int, key: String, tail: MIRTerminator, slot: MIRPlaceID?, cut: Int) -> MIRBlockID Never! {
    explicit := builder.cleanup_frames[depth].explicit
    loop row in builder.cleanup_frames[depth].pending_exits {
        if row.key == key && row.explicit == explicit -> return row.block
    }
    current_span := builder.current_span
    block := jet_codegen_new_block(&builder, program, current_span, "cleanup-chain")
    &builder.cleanup_frames[depth].pending_exits.push(JetCodegenPendingExit{key: key, terminator: tail, slot: slot, explicit: explicit, cut: cut, block: block})
    block
}

// The block that ends every drop chain toward `chain.key` with the exit.
fn jet_codegen_exit_tail(builder: &JetCodegenBuilder, program: JetCodegenProgram, chain: JetCodegenPendingExit) -> MIRBlockID Never! {
    if builder.exit_tails.get(chain.key) == .Val(known) -> return MIRBlockID{value: known}
    current_span := builder.current_span
    block := jet_codegen_new_block(&builder, program, current_span, "cleanup-chain-exit")
    jet_codegen_switch_block(&builder, program, block)
    terminator := chain.terminator
    if chain.slot == .Val(place) {
        slot_ty := MIRType?{None}
        loop existing in builder.exit_value_slots {
            if existing.place == place -> slot_ty = Val(existing.ty)
        }
        ty :: slot_ty ?? panic("exit value slot has no type")
        value := jet_codegen_emit_mir_type(&builder, program, current_span, ty, mir_ownership_from_access(MIRAccess.Move), MIROperation.MovePlace{place: place})
        terminator = MIRTerminator.Return{value: Val(value)}
    }
    jet_codegen_emit_budget_leave(&builder, program, terminator)
    jet_codegen_terminate(&builder, program, terminator)
    _ := &builder.exit_tails.add(chain.key, block.value)
    block
}

// The pending entry block for `key` after `explicit` explicit actions, or a
// new link block when no exit entered there.
fn jet_codegen_exit_chain_block(builder: &JetCodegenBuilder, program: JetCodegenProgram, pending: [JetCodegenPendingExit], key: String, explicit: Int) -> MIRBlockID Never! {
    loop row in pending {
        if row.key == key && row.explicit == explicit -> return row.block
    }
    current_span := builder.current_span
    jet_codegen_new_block(&builder, program, current_span, "cleanup-chain")
}

// Lower the drop chains exits from frame `depth` jump to, using the frame's
// actions as they stand now. Per target, the chain entered after `e` explicit
// actions runs those actions newest first, then releases every owned local the
// frame registered, newest first, then leaves the frame's MIR scope, then
// continues into the enclosing frame's chain or, at the target's frame, ends
// with the exit. Each release is guarded by the local's live flag, which reads
// false on an exit taken before the local was bound, so one release sequence
// serves every exit of the frame; explicit actions run unconditionally, hence
// the per-count entries. Runs when the frame closes and at the end of the body.
fn jet_codegen_seal_exit_chains(builder: &JetCodegenBuilder, program: JetCodegenProgram, depth: Int) Never! {
    resume_block := builder.current
    loop builder.cleanup_frames[depth].pending_exits.len() > 0 {
        pending := builder.cleanup_frames[depth].pending_exits
        builder.cleanup_frames[depth].pending_exits = [JetCodegenPendingExit]{}
        frame := builder.cleanup_frames[depth]
        explicit := [JetCodegenCleanupAction]{}
        automatic := [JetCodegenCleanupAction]{}
        loop action in frame.actions {
            if {
                jet_codegen_cleanup_action_is_drop(action) -> &automatic.push(action)
                else -> &explicit.push(action)
            }
        }
        sealed := [String]{}
        loop row in pending {
            if sealed.contains(row.key) -> next
            &sealed.push(row.key)
            following := if depth <= row.cut -> jet_codegen_exit_tail(&builder, program, row) else -> jet_codegen_exit_chain_entry(&builder, program, depth - 1, row.key, row.terminator, row.slot, row.cut)
            deepest := 0
            loop other in pending {
                if other.key == row.key && other.explicit > deepest -> deepest = other.explicit
            }
            if deepest > explicit.len() -> panic("drop chain entry outlives its explicit cleanup")
            block := jet_codegen_exit_chain_block(&builder, program, pending, row.key, 0)
            jet_codegen_switch_block(&builder, program, block)
            masked :: builder.stop_cleanup_active
            if row.terminator == .Stopped -> builder.stop_cleanup_active = true
            index := automatic.len()
            loop index > 0 {
                index -= 1
                remaining := [JetCodegenCleanupAction]{}
                loop at in 0..<index -> &remaining.push(automatic[at])
                jet_codegen_emit_cleanup_suffix(&builder, program, depth, remaining, automatic[index])
            }
            if frame.owner != None && jet_codegen_current_is_open(builder, program) {
                scope :: frame.owner ?? panic("owned cleanup frame lost its MIR scope")
                current_span := builder.current_span
                _ := jet_codegen_emit(&builder, program, current_span, None, MIROperation.ScopeExit{scope: scope})
            }
            if jet_codegen_current_is_open(builder, program) -> jet_codegen_terminate(&builder, program, MIRTerminator.Jump{target: following})
            count := 1
            loop count <= deepest {
                previous := block
                block = jet_codegen_exit_chain_block(&builder, program, pending, row.key, count)
                jet_codegen_switch_block(&builder, program, block)
                remaining := automatic
                loop at in 0..<count - 1 -> &remaining.push(explicit[at])
                jet_codegen_emit_cleanup_suffix(&builder, program, depth, remaining, explicit[count - 1])
                if jet_codegen_current_is_open(builder, program) -> jet_codegen_terminate(&builder, program, MIRTerminator.Jump{target: previous})
                count += 1
            }
            builder.stop_cleanup_active = masked
        }
    }
    jet_codegen_switch_block(&builder, program, resume_block)
}

// Seal every active frame's drop chains, innermost first, so each enclosing
// frame sees the entries its inner chains continue into.
fn jet_codegen_seal_all_exit_chains(builder: &JetCodegenBuilder, program: JetCodegenProgram) Never! {
    depth := builder.cleanup_frames.len()
    loop depth > 0 {
        depth -= 1
        jet_codegen_seal_exit_chains(&builder, program, depth)
    }
}

fn jet_codegen_enter_scope(builder: &JetCodegenBuilder, program: JetCodegenProgram, kind: MIRScopeKind, span: Span, name: String?) -> MIRScopeID Never! {
    detail := if name != None -> name else -> ""
    role := if kind == {
        .Unsafe -> "Unsafe"
        .Impure -> "Impure"
        .Reactive -> "Reactive"
        .Shield -> "Shield"
        .StopCleanup -> "StopCleanup"
        .Region -> "Region"
        .Policy -> "Policy"
        .TaskGroup -> "TaskGroup"
        .Layout -> "Layout"
        .Authority -> "Authority"
        .Context -> "Context"
        .Live -> "Live"
        .AssumeDeterministic -> "AssumeDeterministic"
        .Transaction -> "Transaction"
        .ScopeMember -> "ScopeMember"
        .DebugOnly -> "DebugOnly"
    }
    identity := jet_codegen_identity(&builder, program, "scope", span, role, detail)
    scope := MIRScopeID{value: stable_id("mir-scope", identity)}
    &builder.scopes.push(MIRScope{id: scope, kind: kind, span: span, name: name, deadline: None, facts: [MIRScopeFact]{}})
    _ := jet_codegen_emit(&builder, program, span, None, MIROperation.ScopeEnter{scope: scope, test_member: None})
    &builder.cleanup_frames.push(JetCodegenCleanupFrame{
        owner: Val(scope),
        depth: builder.scope_depth,
        binding_start: builder.bindings.len(),
        drop_live_start: builder.drop_live_places.len(),
        actions: [JetCodegenCleanupAction]{},
        explicit: 0,
        pending_exits: [JetCodegenPendingExit]{},
    })
    scope
}

fn jet_codegen_set_scope_fact(builder: &JetCodegenBuilder, program: JetCodegenProgram, scope: MIRScopeID, key: String, value: String) Never! {
    loop index in 0..<builder.scopes.len() {
        if builder.scopes[index].id == scope {
            fact_index := 0
            loop fact_index < builder.scopes[index].facts.len() {
                if builder.scopes[index].facts[fact_index].key == key {
                    builder.scopes[index].facts[fact_index].value = value
                    return
                }
                fact_index += 1
            }
            &builder.scopes[index].facts.push(MIRScopeFact{key: key, value: value})
            return
        }
    }
    panic("MIR scope fact targets a missing scope row")
}

fn jet_codegen_set_scope_deadline(builder: &JetCodegenBuilder, program: JetCodegenProgram, scope: MIRScopeID, deadline: MIRValueID) Never! {
    loop index in 0..<builder.scopes.len() {
        if builder.scopes[index].id == scope {
            builder.scopes[index].deadline = Val(deadline)
            return
        }
    }
    panic("MIR scope deadline targets a missing scope row")
}

fn jet_codegen_attach_scope_member(builder: &JetCodegenBuilder, program: JetCodegenProgram, scope: MIRScopeID, member: MIRTestScopeMember) Never! {
    index := 0
    loop index < builder.blocks.len() {
        if builder.blocks[index].id == builder.current {
            block := builder.blocks[index]
            if block.instructions.len() == 0 -> panic("MIR scope member has no scope-enter operation")
            last := block.instructions.len() - 1
            if block.instructions[last].operation == {
                .ScopeEnter(candidate, _) -> {
                    if {
                        candidate == scope -> {
                            block.instructions[last].operation = MIROperation.ScopeEnter{scope: scope, test_member: Val(member)}
                        } else -> {
                            panic("MIR scope member has no scope-enter operation")
                        }
                    }
                }
                else -> panic("MIR scope member has no scope-enter operation")
            }
            builder.blocks[index] = block
            return
        }
        index += 1
    }
    panic("MIR scope member scope-enter block is missing")
}

fn jet_codegen_leave_scope(builder: &JetCodegenBuilder, program: JetCodegenProgram, scope: MIRScopeID) Never! {
    if builder.cleanup_frames.len() <= 1 -> panic("MIR scope cleanup frame underflow")
    frame_index := builder.cleanup_frames.len() - 1
    frame := builder.cleanup_frames[frame_index]
    if frame.owner != Val(scope) -> panic("MIR scope exit does not match the active cleanup frame")
    jet_codegen_seal_exit_chains(&builder, program, frame_index)
    jet_codegen_emit_cleanup_frame(&builder, program, frame_index)
    _ := &builder.cleanup_frames.pop()
    loop builder.drop_live_places.len() > frame.drop_live_start -> _ := &builder.drop_live_places.pop()
    loop builder.bindings.len() > frame.binding_start -> _ := &builder.bindings.pop()
    if program.stop_points && !program.comptime_budget {
        loop row in builder.scopes {
            if row.id == scope && row.kind == MIRScopeKind.ScopeMember && row.name != Val("skip") && row.name != Val("measure") {
                jet_codegen_emit_poll(&builder, program, MIRPollKind.Propagate, false)
                return
            }
        }
    }
}


// A local's MIR identity is its sema symbol, except a `_` discard: sema
// never declares one, so every `_` in a frame shares one symbol id. Like
// Rust's `reserve_identity`, a symbol bound again in the same function gets
// the next occurrence (`#1`, `#2`, ...), so each binding is its own local and
// place. Template-expanded bodies rebind one symbol: a derived `compare`
// unrolls `if self.$field.compare(rhs.$field) == {…}` per recursive field,
// and every copy hoists its subject into the same `it` symbol.
// Rust: crates/jet-codegen/src/Codegen/TIR/mir.rs::LowerCtx::reserve_identity
fn jet_codegen_local_identity(builder: &JetCodegenBuilder, program: JetCodegenProgram, local: TLocal) -> String Never! {
    symbol :: local.symbol_id ?? return jet_codegen_identity(&builder, program, "local", local.span, local.name, "")
    if local.name == "_" -> return jet_codegen_identity(&builder, program, "local", local.span, local.name, "")
    base :: "{builder.function.key}|local|{symbol.key}"
    identity := base
    occurrence := 0
    loop builder.local_positions.get(stable_id("mir-local", identity)) != None {
        occurrence += 1
        identity = "{base}#{occurrence}"
    }
    identity
}

// Rust: crates/jet-codegen/src/Codegen/TIR/mir.rs::LowerCtx::bind_local
fn jet_codegen_bind_local_with_base(builder: &JetCodegenBuilder, program: JetCodegenProgram, local: TLocal, ty: Type, mutable: Bool, parameter: MIRValueID?, capture: MIRValueID?, parameter_access: MIRAccess?, capture_ownership: MIROwnership?, string_view: Bool) -> MIRPlaceID Never! {
    symbol_key :: (local.symbol_id ?? SymbolID{key: ""}).key
    identity :: jet_codegen_local_identity(&builder, program, local)
    local_id := MIRLocalID{value: stable_id("mir-local", identity)}
    place_id := MIRPlaceID{value: stable_id("mir-place", "{identity}|place")}
    mir_ty := jet_codegen_lower_type_for_function(ty, builder, program)
    access := MIRAccess.Read
    if mutable -> access = MIRAccess.Write
    ownership := jet_codegen_ownership(ty)
    base := MIRPlaceBase.Local{local: local_id}
    if parameter != None {
        parameter_value :: parameter
        base = MIRPlaceBase.Parameter{value: parameter_value}
        convention :: parameter_access ?? MIRAccess.Read
        access = convention
        ownership = mir_ownership_from_access(convention)
    }
    if capture != None {
        capture_value :: capture
        base = MIRPlaceBase.Capture{value: capture_value}
        convention :: parameter_access ?? MIRAccess.Read
        access = convention
        ownership = capture_ownership ?? mir_ownership_from_access(convention)
    }
    jet_codegen_push_place(&builder, program, MIRPlace{
        id: place_id,
        span: local.span,
        ty: mir_ty,
        base: base,
        projections: [MIRProjection]{},
        access: access,
        persist_key: local.persist_key,
    })
    jet_codegen_push_local(&builder, program, MIRLocal{
        id: local_id,
        name: local.name,
        span: local.span,
        ty: mir_ty,
        place: place_id,
        ssa_value: None,
        mutable: mutable,
        ownership: ownership,
        is_comptime: false,
        uninit: local.uninit_scalar || local.uninit_fixed,
        arena_view: false,
        string_view: string_view,
        gc_root: false,
    })
    &builder.bindings.push(JetCodegenBinding{name: local.name, symbol_key: symbol_key, ty: ty, place: place_id, local: local_id, depth: builder.scope_depth})
    should_drop := ownership.drop != MIRDropKind.NoDrop && !string_view
    if {
        parameter != None -> {
            should_drop = should_drop && ownership.mode == MIROwnershipMode.Move
            if should_drop -> jet_codegen_register_drop_live(&builder, program, place_id, ty, ownership, true)
        } else -> {
            if capture == None && should_drop -> jet_codegen_register_drop_live(&builder, program, place_id, ty, ownership, false)
        }
    }
    place_id
}

fn jet_codegen_bind_local(builder: &JetCodegenBuilder, program: JetCodegenProgram, local: TLocal, ty: Type, mutable: Bool, parameter: MIRValueID?, parameter_access: MIRAccess?, string_view: Bool) -> MIRPlaceID Never! {
    if builder.retained_root && builder.scope_depth == 0 && parameter == None && !string_view && local.symbol_id != None {
        return jet_codegen_bind_retained_root(&builder, program, local, ty, mutable)
    }
    jet_codegen_bind_local_with_base(&builder, program, local, ty, mutable, parameter, None, parameter_access, None, string_view)
}

// #5041: a read-only binding that holds a borrow of a payload place its
// subject still owns (jet_codegen_lower_pattern_or under a read window): the
// local's storage is a ReadBorrow of that place, so writing it copies
// nothing, nothing drops it, and a consuming use of it copies the place
// (jet_codegen_unmovable_place).
fn jet_codegen_bind_borrowed_local(builder: &JetCodegenBuilder, program: JetCodegenProgram, local: TLocal, ty: Type) -> MIRPlaceID Never! {
    symbol_key :: (local.symbol_id ?? SymbolID{key: ""}).key
    identity :: jet_codegen_local_identity(&builder, program, local)
    local_id := MIRLocalID{value: stable_id("mir-local", identity)}
    place_id := MIRPlaceID{value: stable_id("mir-place", "{identity}|place")}
    mir_ty := jet_codegen_lower_type_for_function(ty, builder, program)
    jet_codegen_push_place(&builder, program, MIRPlace{
        id: place_id,
        span: local.span,
        ty: mir_ty,
        base: MIRPlaceBase.Local{local: local_id},
        projections: [MIRProjection]{},
        access: MIRAccess.Read,
        persist_key: None,
    })
    jet_codegen_push_local(&builder, program, MIRLocal{
        id: local_id,
        name: local.name,
        span: local.span,
        ty: mir_ty,
        place: place_id,
        ssa_value: None,
        mutable: false,
        ownership: mir_ownership_from_access(MIRAccess.Read),
        is_comptime: false,
        uninit: false,
        arena_view: false,
        string_view: false,
        gc_root: false,
    })
    &builder.bindings.push(JetCodegenBinding{name: local.name, symbol_key: symbol_key, ty: ty, place: place_id, local: local_id, depth: builder.scope_depth})
    place_id
}

// Rust: crates/jet-codegen/src/Codegen/TIR/mir.rs::LowerCtx::bind_local_alias
fn jet_codegen_bind_local_alias(builder: &JetCodegenBuilder, program: JetCodegenProgram, local: TLocal, ty: Type, place: MIRPlaceID, mutable: Bool) -> MIRPlaceID Never! {
    symbol_key :: (local.symbol_id ?? SymbolID{key: ""}).key
    identity :: jet_codegen_local_identity(&builder, program, local)
    local_id := MIRLocalID{value: stable_id("mir-local", identity)}
    access := if mutable -> MIRAccess.Write else -> MIRAccess.Read
    lowered_ty :: jet_codegen_lower_type_for_function(ty, builder, program)
    jet_codegen_push_local(&builder, program, MIRLocal{
        id: local_id,
        name: local.name,
        span: local.span,
        ty: lowered_ty,
        place: place,
        ssa_value: None,
        mutable: mutable,
        ownership: mir_ownership_from_access(access),
        is_comptime: false,
        uninit: false,
        arena_view: false,
        string_view: false,
        gc_root: false,
    })
    if !mutable -> _ := &builder.read_alias_places.add(place.value, true)
    &builder.bindings.push(JetCodegenBinding{name: local.name, symbol_key: symbol_key, ty: ty, place: place, local: local_id, depth: builder.scope_depth})
    place.copy()
}

fn jet_codegen_bind_capture_local(builder: &JetCodegenBuilder, program: JetCodegenProgram, local: TLocal, ty: Type, value: MIRValueID, access: MIRAccess, ownership: MIROwnership, string_view: Bool) -> MIRPlaceID Never! {
    jet_codegen_bind_local_with_base(&builder, program, local, ty, access == MIRAccess.Write, None, Val(value), Val(access), Val(ownership), string_view)
}

fn jet_codegen_find_binding(builder: JetCodegenBuilder, program: JetCodegenProgram, name: String) -> JetCodegenBinding? {
    index := builder.bindings.len() - 1
    loop index >= 0 {
        binding :: builder.bindings[index]
        if binding.name == name && binding.depth <= builder.scope_depth -> return Val(binding)
        index -= 1
    }
    None
}
fn jet_codegen_find_binding_for_local(builder: JetCodegenBuilder, program: JetCodegenProgram, local: TLocal) -> JetCodegenBinding? {
    if local.symbol_id == None -> return jet_codegen_find_binding(builder, program, local.name)
    symbol :: local.symbol_id ?? return None
    index := builder.bindings.len() - 1
    loop index >= 0 {
        binding :: builder.bindings[index]
        if binding.symbol_key == symbol.key && binding.depth <= builder.scope_depth -> return Val(binding)
        index -= 1
    }
    None
}
// Rust: none (Jet-only pass)
fn jet_codegen_push_place(builder: &JetCodegenBuilder, program: JetCodegenProgram, place: MIRPlace) Never! {
    if builder.place_positions.get(place.id.value) == None {
        _ := &builder.place_positions.add(place.id.value, builder.places.len())
    } else {
        builder.place_repeats[place.id.value] = true
    }
    &builder.places.push(place)
}

// Rust: none (Jet-only pass)
fn jet_codegen_push_local(builder: &JetCodegenBuilder, program: JetCodegenProgram, local: MIRLocal) Never! {
    if builder.local_positions.get(local.id.value) == None {
        _ := &builder.local_positions.add(local.id.value, builder.locals.len())
    }
    &builder.locals.push(local)
}

// Rust: none (Jet-only pass)
fn jet_codegen_push_value(builder: &JetCodegenBuilder, program: JetCodegenProgram, fact: MIRValueFact) Never! {
    _ := &builder.value_positions.add(fact.id.value, builder.values.len())
    if builder.value_first_positions.get(fact.id.value) == None -> builder.value_first_positions[fact.id.value] = builder.values.len()
    &builder.values.push(fact)
}

// Rebuild after drop-flag compaction; places and locals keep their first
// matching row, while value ownership lookup keeps its last matching row.
// Rust: none (Jet-only pass)
fn jet_codegen_reindex_lowering_rows(builder: &JetCodegenBuilder, program: JetCodegenProgram) Never! {
    builder.place_positions = [U64:Int]{}
    builder.place_repeats = [U64:Bool]{}
    loop (index, place) in builder.places {
        if builder.place_positions.get(place.id.value) == None {
            _ := &builder.place_positions.add(place.id.value, index)
        } else {
            builder.place_repeats[place.id.value] = true
        }
    }
    builder.local_positions = [U64:Int]{}
    loop (index, local) in builder.locals {
        if builder.local_positions.get(local.id.value) == None {
            _ := &builder.local_positions.add(local.id.value, index)
        }
    }
    builder.value_positions = [U64:Int]{}
    builder.value_first_positions = [U64:Int]{}
    loop (index, fact) in builder.values {
        _ := &builder.value_positions.add(fact.id.value, index)
        if builder.value_first_positions.get(fact.id.value) == None -> builder.value_first_positions[fact.id.value] = index
    }
}

// Rust: crates/jet-codegen/src/Codegen/TIR/mir.rs::LowerCtx::place_for_local
fn jet_codegen_find_place(builder: JetCodegenBuilder, program: JetCodegenProgram, place_id: MIRPlaceID) -> MIRPlace? {
    index :: builder.place_positions.get(place_id.value) ?? return None
    Val(builder.places[index])
}

// Rust: crates/jet-codegen/src/Codegen/TIR/mir.rs::LowerCtx::project_field_place
fn jet_codegen_project_field_place(builder: &JetCodegenBuilder, program: JetCodegenProgram, base: MIRPlaceID, span: Span, ty: Type, field: MIRFieldID) -> MIRPlaceID Never! {
    base_place :: jet_codegen_find_place(builder, program, base) ?? panic("checked field place has no MIR base place")
    projections := [MIRProjection]{}
    loop projection in base_place.projections -> &projections.push(projection)
    &projections.push(MIRProjection.Field{field: field, span: span})
    identity := jet_codegen_identity(&builder, program, "place", span, "field", "{base.value}|{field.value}")
    place_id := MIRPlaceID{value: stable_id("mir-place", identity)}
    lowered_ty :: jet_codegen_lower_type_for_function(ty, builder, program)
    jet_codegen_push_place(&builder, program, MIRPlace{
        id: place_id,
        span: span,
        ty: lowered_ty,
        base: base_place.base,
        projections: projections,
        access: base_place.access,
        persist_key: base_place.persist_key,
    })
    // A field below a read alias's place stays one
    // (jet_codegen_unmovable_place); a root's own place never is one.
    if base_place.projections.len() > 0 && builder.read_alias_places.get(base.value) != None -> _ := &builder.read_alias_places.add(place_id.value, true)
    place_id
}


fn jet_codegen_find_function(function_index: JetCodegenFunctionIndex, key: String) -> TFunc? {
    row :: jet_codegen_find_function_row(function_index, key) ?? return None
    Val(function_index.rows[row])
}

// The row of the first function with `key`, for callers that read a few
// fields in place instead of copying the whole function (body included).
fn jet_codegen_find_function_row(function_index: JetCodegenFunctionIndex, key: String) -> Int? {
    function_index.first_by_key.get(key)
}
fn jet_codegen_find_function_by_key(function_index: JetCodegenFunctionIndex, key: String, module_identity: String) -> TFunc? {
    qualified :: jet_codegen_qualified_function_key(module_identity, key)
    row :: function_index.qualified_rows.get(qualified) ?? return None
    if row < 0 -> panic("ambiguous checked function key in Codegen input")
    Val(function_index.rows[row])
}


// Rust: crates/jet-codegen/src/Codegen/TIR/mir.rs::registry_function_identity
// (function_identity / synthetic_function_identity): byte-identical framing, so
// the Rust seed and the Jet compiler assign one function ID to one function.
fn jet_codegen_function_id(function: TFunc) -> MIRFunctionID Never! {
    identity := "{function.key}|{function.source_file}|{function.source_span.start}|{function.source_span.end}"
    if function.synthetic -> identity = "{identity}|synthetic|{function.module_identity}|{function.name}"
    mir_function_id(identity)
}

fn jet_codegen_enter_lexical(builder: &JetCodegenBuilder, program: JetCodegenProgram) Never! {
    builder.scope_depth += 1
    &builder.cleanup_frames.push(JetCodegenCleanupFrame{
        owner: None,
        depth: builder.scope_depth,
        binding_start: builder.bindings.len(),
        drop_live_start: builder.drop_live_places.len(),
        actions: [JetCodegenCleanupAction]{},
        explicit: 0,
        pending_exits: [JetCodegenPendingExit]{},
    })
}

fn jet_codegen_leave_lexical(builder: &JetCodegenBuilder, program: JetCodegenProgram) Never! {
    if builder.scope_depth > 0 {
        builder.scope_depth -= 1
        if builder.cleanup_frames.len() <= 1 -> panic("lexical cleanup frame underflow")
        frame_index := builder.cleanup_frames.len() - 1
        frame := builder.cleanup_frames[frame_index]
        if frame.owner != None || frame.depth <= builder.scope_depth -> panic("lexical cleanup frame does not match the active depth")
        jet_codegen_seal_exit_chains(&builder, program, frame_index)
        jet_codegen_emit_cleanup_frame(&builder, program, frame_index)
        _ := &builder.cleanup_frames.pop()
        loop builder.drop_live_places.len() > frame.drop_live_start -> _ := &builder.drop_live_places.pop()
        loop builder.bindings.len() > frame.binding_start -> _ := &builder.bindings.pop()
    }
}

fn jet_codegen_intern_prelude_call(builder: &JetCodegenBuilder, program: JetCodegenProgram, row: MIRPreludeCall) -> MIRPreludeCallID Never! {
    id :: row.id
    if builder.prelude_call_positions.get(id.value) != None -> return id
    jet_codegen_push_prelude_call(&builder, program, row)
    id
}

fn jet_codegen_push_prelude_call(builder: &JetCodegenBuilder, program: JetCodegenProgram, row: MIRPreludeCall) Never! {
    _ := &builder.prelude_call_positions.add(row.id.value, builder.prelude_calls.len())
    &builder.prelude_calls.push(row)
}
