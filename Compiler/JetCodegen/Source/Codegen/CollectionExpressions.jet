use jet_foundation.[
    MIRAccess,
    MIRConstant,
    MIRCopyFact,
    MIREnumArg,
    MIRIndexKind,
    MIRMapEntry,
    MIROwnershipMode,
    MIROperation,
    MIRPanicContext,
    MIRPanicLoc,
    MIRPanicLocal,
    MIRPlace,
    MIRPlaceID,
    MIRProjection,
    MIRSemanticOp,
    MIRValueID,
    Span,
    TComptimeField,
    TComptimeMapEntry,
    TComptimeReport,
    TComptimeValue,
    TExpr,
    TExprKind,
    TIndexKind,
    TPanicLoc,
    TPanicLocal,
    Type,
    TypeTupleField,
    mir_source_file_id,
    mir_type_identity_key,
    stable_id,
    type_identity_key,
]

fn jet_codegen_collection_default_value(ty: Type) -> TComptimeValue Never! {
    if ty == {
        .Int | .IntN(_, _) | .Measure(_) -> TComptimeValue.Int{value: 0}
        .Float -> TComptimeValue.Float{value: 0.0, bits: 64}
        .Float32 -> TComptimeValue.Float{value: 0.0, bits: 32}
        .Bool -> TComptimeValue.Bool{value: false}
        .String -> TComptimeValue.String{value: ""}
        .Char -> TComptimeValue.Char{value: 0}
        .List(_) | .FixedList(_, _) -> TComptimeValue.List{values: [TComptimeValue]{}}
        .Map(_, _, _) -> TComptimeValue.Map{entries: [TComptimeMapEntry]{}}
        .Shared(inner) | .InlineRange(inner, _, _) | .Tagged(_, inner) | .Quantity(inner, _) -> jet_codegen_collection_default_value(inner)
        // copy: `inner` is a payload of read parameter `ty`, which keeps the original; field `ty` of the new TComptimeReport.Clean owns this one
        .Option(inner) -> TComptimeValue.Failed{report: TComptimeReport.Clean{ty: inner.copy()}}
        .Result(ok, _) -> TComptimeValue.Present{value: jet_codegen_collection_default_value(ok)}
        .Tuple(fields) -> {
            values := [TComptimeField]{}
            loop field in fields -> &values.push(TComptimeField{name: field.name, value: jet_codegen_collection_default_value(field.ty)})
            TComptimeValue.Struct{type_name: "Tuple", fields: values}
        }
        .Fn(_, _, _, _, _, _) | .Named(_) | .Apply(_, _) | .TraitObject(_) | .Union(_) -> TComptimeValue.Unit
    }
}

fn jet_codegen_collection_trait_target(target: Type, builder: JetCodegenBuilder, program: JetCodegenProgram) -> Type? {
    untagged := jet_codegen_unwrap_pattern_tags(target)
    if untagged == {
        .TraitObject(bounds) -> {
            if bounds.len() != 1 -> return None
            jet_codegen_require_trait_box_target(untagged, builder, program)
            return Val(untagged)
        }
        .Named(name) -> {
            if !jet_codegen_trait_bound_is_declared(program.nominals, name, builder.function.module_identity) -> return None
            trait_target := Type.TraitObject{bounds: [String]{name}}
            jet_codegen_require_trait_box_target(trait_target, builder, program)
            return Val(trait_target)
        }
        else -> None
    }
}

fn jet_codegen_collection_trait_box_value(builder: &JetCodegenBuilder, program: JetCodegenProgram, value: MIRValueID, source: Type, target: Type, span: Span) -> MIRValueID Never! {
    target_type := jet_codegen_collection_trait_target(target, builder, program)
    if target_type == None -> return value.copy()
    source_type := jet_codegen_unwrap_pattern_tags(source)
    if source_type == {
        .TraitObject(_) -> return value.copy()
        .Named(name) -> {
            if jet_codegen_trait_bound_is_declared(program.nominals, name, builder.function.module_identity) -> return value.copy()
        }
        .Apply(_, _) -> {}
        else -> panic("checked collection trait coercion source is not nominal")
    }
    coercion_type := target_type ?? panic("checked collection trait target disappeared")
    target_mir_type := jet_codegen_lower_type_for_function(coercion_type, builder, program)
    target_id := target_mir_type.identity ?? panic("checked collection trait target has no MIR identity")
    jet_codegen_emit_value(&builder, program, span, coercion_type, MIROperation.TraitBox{value: value, target: target_id})
}

fn jet_codegen_collection_owned_temporary(value: TExpr) -> Bool Never! {
    ownership :: jet_codegen_ownership(value.ty)
    if ownership.mode == MIROwnershipMode.ReadBorrow || ownership.mode == MIROwnershipMode.WriteBorrow -> return false
    if jet_codegen_is_move_kind(value.kind) -> return true
    if value.kind == {
        .List(_, _) | .ListSpread(_) | .ListLit(_) | .ColumnarListLit(_, _) | .Clone(_, _) | .ExplicitCopy(_) | .MaterializeView(_) -> true
        .Call(_, _, _) | .IndirectCall(_, _, _, _) | .ModuleCall(_, _, _, _, _) | .MethodCall(_, _, _, _) | .StaticCall(_, _, _, _, _) | .BuiltinMethod(_, _, _) | .CoreCall(_, _, _, _, _, _, _) -> true
        // A checked `[U8]{"…"}` byte value lowers to a fresh byte constant.
        .CtLit(constant) -> constant == .Bytes(_)
        else -> false
    }
}

fn jet_codegen_collection_materialize_view(builder: &JetCodegenBuilder, program: JetCodegenProgram, value: MIRValueID, source: TExpr, target: Type, span: Span) -> MIRValueID Never! {
    copied :: jet_codegen_emit_value(&builder, program, span, target, MIROperation.Copy{value: value, fact: MIRCopyFact.ViewMaterialize})
    // Copy clones the fixed/view elements. Only a checked take or fresh
    // owned producer transfers its source cleanup to this conversion.
    if jet_codegen_collection_owned_temporary(source) -> _ := jet_codegen_emit(&builder, program, source.span, None, MIROperation.Drop{value: value, kind: jet_codegen_ownership(source.ty).drop})
    copied
}

// A checked collection slot is an argument boundary just like a checked
// Result payload. Sema established assignability; this only materializes
// the carrier selected by the exact source and destination types.
fn jet_codegen_collection_slot_value(builder: &JetCodegenBuilder, program: JetCodegenProgram, value: MIRValueID, source: TExpr, target: Type) -> MIRValueID Never! {
    qualified_source :: jet_codegen_qualify_type(source.ty, program.nominals, builder.function.module_identity, builder.generic_type_names)
    qualified_target :: jet_codegen_qualify_type(target, program.nominals, builder.function.module_identity, builder.generic_type_names)
    if type_identity_key(qualified_source) == type_identity_key(qualified_target) -> return value.copy()
    if jet_codegen_unwrap_pattern_tags(qualified_target) == .Union(members) {
        member_found := false
        loop member in members {
            if type_identity_key(member) == type_identity_key(qualified_source) -> member_found = true
        }
        if !member_found -> panic("checked collection union slot has no exact source member")
        union_ty :: jet_codegen_lower_type_for_function(target, builder, program)
        identity :: union_ty.identity ?? panic("checked collection union slot has no MIR identity")
        variant :: jet_codegen_union_member_tag(qualified_source)
        return jet_codegen_emit_value(&builder, program, source.span, target, MIROperation.Enum{type_id: identity, variant: variant, args: [MIREnumArg]{MIREnumArg{field: None, value: value, boxed: false}}})
    }
    if jet_codegen_unwrap_pattern_tags(qualified_target) == .List(element) {
        if jet_codegen_unwrap_pattern_tags(qualified_source) == .FixedList(source_element, _) {
            if type_identity_key(source_element) != type_identity_key(element) -> panic("checked fixed-to-List collection slot changes its element type")
            return jet_codegen_collection_materialize_view(&builder, program, value, source, target, source.span)
        }
    }
    boxed :: jet_codegen_collection_trait_box_value(&builder, program, value, source.ty, target, source.span)
    if boxed.value == value.value {
        source_trait :: jet_codegen_collection_trait_target(source.ty, builder, program)
        target_trait :: jet_codegen_collection_trait_target(target, builder, program)
        if source_trait == .Val(source_type) && target_trait == .Val(target_type) {
            canonical_source :: jet_codegen_qualify_type(source_type, program.nominals, builder.function.module_identity, builder.generic_type_names)
            canonical_target :: jet_codegen_qualify_type(target_type, program.nominals, builder.function.module_identity, builder.generic_type_names)
            if type_identity_key(canonical_source) == type_identity_key(canonical_target) -> return boxed.copy()
        }
        panic("checked collection slot has incompatible source and target carriers")
    }
    boxed
}

fn jet_codegen_collection_boxed_expr(builder: JetCodegenBuilder, program: JetCodegenProgram, value: TExpr, target: Type) -> TExpr Never! {
    coercion_type := jet_codegen_collection_trait_target(target, builder, program)
    // copy: the boxed element is a new owned TExpr. Without a coercion it equals `value`, the
    // caller's checked element (a read parameter), which stays in the list literal's TIR.
    if coercion_type == None -> return value.copy()
    source_type := jet_codegen_unwrap_pattern_tags(value.ty)
    if source_type == {
        // copy: the boxed element is a new owned TExpr. For a trait-object target it equals
        // `value`, the caller's checked element (a read parameter), which stays in the TIR.
        .TraitObject(_) -> return value.copy()
        .Named(name) -> {
            // copy: the boxed element is a new owned TExpr. For a declared bound it equals `value`,
            // the caller's checked element (a read parameter), which stays in the TIR.
            if jet_codegen_trait_bound_is_declared(program.nominals, name, builder.function.module_identity) -> return value.copy()
        }
        .Apply(_, _) -> {}
        else -> panic("checked collection trait coercion source is not nominal")
    }
    target_type := coercion_type ?? panic("checked collection trait target disappeared")
    TExpr{
        ty: target_type,
        kind: TExprKind.TraitBox{value: value, target: target_type},
        span: value.span,
        integer_bounds: value.integer_bounds,
        cost: value.cost,
    }
}

// Rust: crates/jet-codegen/src/Codegen/TIR/mir.rs::LowerCtx::lower_index_place
fn jet_codegen_collection_index_place(builder: &JetCodegenBuilder, program: JetCodegenProgram, base: TExpr, index: TExpr, kind: TIndexKind, result_ty: Type, location: TPanicLoc, span: Span) -> MIRPlaceID {
    base_type := jet_codegen_unwrap_pattern_tags(base.ty)
    if base_type == base.ty -> return jet_codegen_index_place(&builder, program, base, index, kind, result_ty, MIRAccess.Read, location, span)
    mir_kind := jet_codegen_index_kind(base_type, kind)
    result_type := jet_codegen_index_element_type(base_type, mir_kind)
    if type_identity_key(result_type) != type_identity_key(result_ty) -> panic("checked index place result disagrees with its element type")
    base_place := jet_codegen_lower_expression_place(&builder, program, base, MIRAccess.Read)
    if base_place == None {
        base_value := jet_codegen_lower_expr(&builder, program, base)
        base_place = Val(jet_codegen_temporary_place(&builder, program, base_value, base.ty, base.span, MIRAccess.Read))
    }
    base_id := base_place ?? panic("checked index place has no base place")
    index_value := jet_codegen_lower_expr(&builder, program, index)
    carrier := jet_codegen_failure_carrier_for_type(result_ty)
    call := jet_codegen_index_route(&builder, program, mir_kind, MIRAccess.Read, carrier)
    locals := [MIRPanicLocal]{}
    loop local in location.locals {
        binding :: jet_codegen_find_binding_for_local(builder, program, local.local) ?? next
        &locals.push(MIRPanicLocal{name: local.display_name, local: binding.local})
    }
    panic_loc := MIRPanicLoc{file: mir_source_file_id(location.file), line: location.line, column: location.column}
    context := MIRPanicContext?{None}
    if mir_kind == MIRIndexKind.Map -> context = Val(MIRPanicContext{function: location.function, source_line: location.source_line, caret: location.caret, locals: locals})
    root :: jet_codegen_find_place(builder, program, base_id) ?? panic("checked index base has no MIR place")
    projections := [MIRProjection]{}
    loop projection in root.projections -> &projections.push(projection)
    &projections.push(MIRProjection.Index{kind: mir_kind, index: index_value, call: call, write_call: None, location: panic_loc, context: context, span: span})
    identity := jet_codegen_identity(&builder, program, "place", span, "index", "{root.id.value}:{index_value.value}")
    id := MIRPlaceID{value: stable_id("mir-place", identity)}
    lowered_ty :: jet_codegen_lower_type_for_function(result_ty, builder, program)
    jet_codegen_push_place(&builder, program, MIRPlace{
        id: id,
        span: span,
        ty: lowered_ty,
        base: root.base,
        projections: projections,
        access: MIRAccess.Read,
        persist_key: None,
    })
    id
}

// Rust tir_to_mir_expr `constant_byte_list`: the bytes of a `[U8]` list literal
// of at least 256 integer literals in 0..=255; None otherwise.
fn jet_codegen_collection_constant_bytes(ty: Type, values: [TExpr]) -> [U8]? Never! {
    if values.len() < 256 -> return None
    is_byte_list :: if jet_codegen_unwrap_pattern_tags(ty) == {
        .List(element) -> element == Type.IntN{signed: false, bits: 8}
        else -> false
    }
    if !is_byte_list -> return None
    bytes := [U8]{}
    loop value in values {
        if value.kind == {
            .IntLit(literal, _) -> {
                byte :: U8.from_int(literal) ?? return None
                &bytes.push(byte)
            }
            else -> return None
        }
    }
    Val(bytes)
}

fn jet_codegen_lower_collection_expression(builder: &JetCodegenBuilder, program: JetCodegenProgram, expression: TExpr) -> MIRValueID {
    if expression.kind == {
        .DefaultLit -> {
            value := jet_codegen_collection_default_value(expression.ty)
            constant :: jet_codegen_lower_comptime_value(value, program.nominals, builder.function.module_identity, builder.generic_type_names) ?? panic("checked default value cannot lower as a MIR constant")
            return jet_codegen_emit_value(&builder, program, expression.span, expression.ty, MIROperation.Constant{value: constant})
        }
        .ListLit(values) | .ColumnarListLit(_, values) -> {
            // Rust tir_to_mir_expr `constant_byte_list`: a large `[U8]` literal of
            // plain integer bytes (generated Unicode tables) is one byte constant.
            if jet_codegen_collection_constant_bytes(expression.ty, values) == .Val(bytes) {
                return jet_codegen_emit_value(&builder, program, expression.span, expression.ty, MIROperation.Constant{value: MIRConstant.Bytes{value: bytes}})
            }
            element :: if jet_codegen_unwrap_pattern_tags(expression.ty) == {
                .List(inner) | .FixedList(inner, _) -> inner
                else -> panic("checked list literal has a non-list result type")
            }
            lowered := [MIRValueID]{}
            loop value in values {
                raw :: jet_codegen_lower_expr(&builder, program, value)
                &lowered.push(jet_codegen_collection_slot_value(&builder, program, raw, value, element))
            }
            return jet_codegen_emit_value(&builder, program, expression.span, expression.ty, MIROperation.BuildList{values: lowered, trait_coercion: None})
        }
        .TupleLit(_, named_fields) -> {
            tuple_fields := if jet_codegen_unwrap_pattern_tags(expression.ty) == {
                .Tuple(fields) -> fields
                else -> panic("checked tuple literal has a non-tuple result type")
            }
            fields := [TypeTupleField]{}
            values := [TExpr]{}
            loop named in named_fields {
                expected := Type?{None}
                loop field in tuple_fields {
                    if field.name == named.name -> expected = Val(field.ty)
                }
                expected_type :: expected ?? panic("checked tuple literal field has no type")
                &fields.push(TypeTupleField{name: named.name, ty: expected_type})
                &values.push(jet_codegen_collection_boxed_expr(builder, program, named.value, expected_type))
            }
            tuple_type := jet_codegen_lower_type_for_function(expression.ty, builder, program)
            type_id := tuple_type.identity ?? panic("checked tuple type has no MIR identity")
            identity := mir_type_identity_key(tuple_type)
            return jet_codegen_lower_tuple_fields(&builder, program, expression.span, expression.ty, fields, values, type_id, identity)
        }
        .IndexRead(base, index, is_map, uninit_fixed, line) -> {
            kind := if {
                is_map -> TIndexKind.Map
                uninit_fixed -> TIndexKind.FixedListProof
                else -> TIndexKind.List
            }
            location := jet_codegen_assignment_panic_location(&builder, program, expression.span, is_map)
            location.line = line
            place := jet_codegen_collection_index_place(&builder, program, base, index, kind, expression.ty, location, expression.span)
            return jet_codegen_emit_value(&builder, program, expression.span, expression.ty, MIROperation.ReadPlace{place: place})
        }
        .SliceOwned(base, start, end, range, line) -> {
            location := TPanicLoc{file: builder.function.source_file, source_line: "", line: line, column: 0, caret: 0, function: builder.function.name, locals: [TPanicLocal]{}}
            return jet_codegen_lower_slice(&builder, program, expression, base, start, end, range, location)
        }
        .MapLit(entries) -> {
            expected_key := Type.Int
            expected_value := Type.Int
            if jet_codegen_unwrap_pattern_tags(expression.ty) == {
                .Map(key, _, value) -> {
                    expected_key = key
                    expected_value = value
                }
                else -> {}
            }
            lowered := [MIRMapEntry]{}
            loop entry in entries {
                pair := jet_codegen_lower_map_entry(&builder, program, entry)
                key := jet_codegen_collection_trait_box_value(&builder, program, pair.key, entry.key.ty, expected_key, expression.span)
                value := jet_codegen_collection_trait_box_value(&builder, program, pair.value, entry.value.ty, expected_value, expression.span)
                &lowered.push(MIRMapEntry{key: key, value: value})
            }
            return jet_codegen_emit_value(&builder, program, expression.span, expression.ty, MIROperation.BuildMap{entries: lowered})
        }
        .LayoutLit(value) -> {
            lowered := jet_codegen_lower_expr(&builder, program, value)
            return jet_codegen_emit_value(&builder, program, expression.span, expression.ty, MIROperation.Semantic{operation: MIRSemanticOp.LayoutLiteral{inner: lowered}})
        }
        else -> panic("non-collection TIR expression reached collection lowering")
    }
}
