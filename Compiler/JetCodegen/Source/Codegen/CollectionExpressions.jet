fn jet_codegen_collection_default_value(ty: Type) -> TComptimeValue Never! {
    if ty == {
        .Int | .IntN(_, _) | .Measure(_) -> TComptimeValue.Int{value: 0}
        .Float -> TComptimeValue.Float{value: 0.0, bits: 64}
        .Float32 -> TComptimeValue.Float{value: 0.0, bits: 32}
        .Bool -> TComptimeValue.Bool{value: false}
        .String -> TComptimeValue.String{value: ""}
        .Char -> TComptimeValue.Char{value: 0}
        .List(_) | .FixedList(_, _) -> TComptimeValue.List{values: [TComptimeValue]{}}
        .Map(_, _, _) -> TComptimeValue.Map{entries: [TComptimeMapEntry]{}}
        .Shared(inner) | .InlineRange(inner, _, _) | .Tagged(_, inner) | .Quantity(inner, _) -> jet_codegen_collection_default_value(inner)
        .Option(inner) -> TComptimeValue.Failed{report: TComptimeReport.Clean{ty: inner}}
        .Result(ok, _) -> TComptimeValue.Present{value: jet_codegen_collection_default_value(ok)}
        .Tuple(fields) -> {
            values := [TComptimeField]{}
            loop field in fields -> &values.push(TComptimeField{name: field.name, value: jet_codegen_collection_default_value(field.ty)})
            TComptimeValue.Struct{type_name: "Tuple", fields: values}
        }
        .Fn(_, _, _, _, _, _) | .Named(_) | .Apply(_, _) | .TraitObject(_) | .Union(_) -> TComptimeValue.Unit
    }
}

fn jet_codegen_collection_trait_target(target: Type, builder: &JetCodegenBuilder) -> Type? {
    untagged := jet_codegen_unwrap_pattern_tags(target)
    if untagged == {
        .TraitObject(bounds) -> {
            if bounds.len() != 1 -> return None
            jet_codegen_require_trait_box_target(untagged, builder)
            return Val(untagged)
        }
        .Named(name) -> {
            if !jet_codegen_trait_bound_is_declared(builder.modules, name, builder.function.module_identity) -> return None
            trait_target := Type.TraitObject{bounds: [String]{name}}
            jet_codegen_require_trait_box_target(trait_target, builder)
            return Val(trait_target)
        }
        else -> None
    }
}

fn jet_codegen_collection_list_trait_coercion(builder: &JetCodegenBuilder, ty: Type) -> MirTypeId? {
    element := if jet_codegen_unwrap_pattern_tags(ty) == {
        .List(inner) | .FixedList(inner, _) -> jet_codegen_unwrap_pattern_tags(inner)
        else -> { return None }
    }
    target := jet_codegen_collection_trait_target(element, builder)
    if target == None -> return None
    target_type := jet_codegen_lower_type_for_function(target ?? panic("checked collection trait target disappeared"), builder)
    target_type.identity
}

fn jet_codegen_collection_trait_box_value(builder: &JetCodegenBuilder, value: MirValueId, source: Type, target: Type, span: Span) -> MirValueId Never! {
    target_type := jet_codegen_collection_trait_target(target, builder)
    if target_type == None -> return value
    source_type := jet_codegen_unwrap_pattern_tags(source)
    if source_type == {
        .TraitObject(_) -> return value
        .Named(name) -> {
            if jet_codegen_trait_bound_is_declared(builder.modules, name, builder.function.module_identity) -> return value
        }
        .Apply(_, _) -> {}
        else -> panic("checked collection trait coercion source is not nominal")
    }
    coercion_type := target_type ?? panic("checked collection trait target disappeared")
    target_mir_type := jet_codegen_lower_type_for_function(coercion_type, builder)
    target_id := target_mir_type.identity ?? panic("checked collection trait target has no MIR identity")
    jet_codegen_emit_value(&builder, span, coercion_type, MirOperation.TraitBox{value: value, target: target_id})
}

fn jet_codegen_collection_boxed_expr(builder: &JetCodegenBuilder, value: TExpr, target: Type) -> TExpr Never! {
    coercion_type := jet_codegen_collection_trait_target(target, builder)
    if coercion_type == None -> return value
    source_type := jet_codegen_unwrap_pattern_tags(value.ty)
    if source_type == {
        .TraitObject(_) -> return value
        .Named(name) -> {
            if jet_codegen_trait_bound_is_declared(builder.modules, name, builder.function.module_identity) -> return value
        }
        .Apply(_, _) -> {}
        else -> panic("checked collection trait coercion source is not nominal")
    }
    target_type := coercion_type ?? panic("checked collection trait target disappeared")
    TExpr{
        ty: target_type,
        kind: TExprKind.TraitBox{value: value, target: target_type},
        span: value.span,
        integer_bounds: value.integer_bounds,
        cost: value.cost,
    }
}

fn jet_codegen_collection_index_place(builder: &JetCodegenBuilder, base: TExpr, index: TExpr, kind: TIndexKind, result_ty: Type, location: TPanicLoc, span: Span) -> MirPlaceId {
    base_type := jet_codegen_unwrap_pattern_tags(base.ty)
    if base_type == base.ty -> return jet_codegen_index_place(&builder, base, index, kind, result_ty, MirAccess.Read, location, span)
    mir_kind := jet_codegen_index_kind(base_type, kind)
    result_type := jet_codegen_index_element_type(base_type, mir_kind)
    if type_identity_key(result_type) != type_identity_key(result_ty) -> panic("checked index place result disagrees with its element type")
    base_place := jet_codegen_lower_expression_place(builder, base, MirAccess.Read)
    if base_place == None {
        base_value := jet_codegen_lower_expr(&builder, base)
        base_place = Val(jet_codegen_temporary_place(&builder, base_value, base.ty, base.span, MirAccess.Read))
    }
    base_id := base_place ?? panic("checked index place has no base place")
    index_value := jet_codegen_lower_expr(&builder, index)
    carrier := jet_codegen_failure_carrier_for_type(result_ty)
    call := jet_codegen_index_route(&builder, mir_kind, MirAccess.Read, carrier)
    locals := [MirPanicLocal]{}
    loop local in location.locals {
        binding :: jet_codegen_find_binding_for_local(builder, local.local) ?? next
        &locals.push(MirPanicLocal{name: local.display_name, local: binding.local})
    }
    panic_loc := MirPanicLoc{file: mir_source_file_id(location.file), line: location.line, column: location.column}
    context := None
    if mir_kind == MirIndexKind.Map -> context = Val(MirPanicContext{function: location.function, source_line: location.source_line, caret: location.caret, locals: locals})
    root :: jet_codegen_find_place(builder, base_id) ?? panic("checked index base has no MIR place")
    projections := [MirProjection]{}
    loop projection in root.projections -> &projections.push(projection)
    &projections.push(MirProjection.Index{kind: mir_kind, index: index_value, call: call, write_call: None, location: panic_loc, context: context, span: span})
    identity := jet_codegen_identity(&builder, "place", span, "index", "{root.id.value}:{index_value.value}")
    id := MirPlaceId{value: stable_id("mir-place", identity)}
    &builder.places.push(MirPlace{
        id: id,
        span: span,
        ty: jet_codegen_lower_type_for_function(result_ty, builder),
        base: root.base,
        projections: projections,
        access: MirAccess.Read,
        persist_key: None,
    })
    id
}

fn jet_codegen_lower_collection_expression(builder: &JetCodegenBuilder, expression: TExpr) -> MirValueId {
    if expression.kind == {
        .DefaultLit -> {
            value := jet_codegen_collection_default_value(expression.ty)
            constant :: jet_codegen_lower_comptime_value(value, builder.modules, builder.function.module_identity, builder.generic_type_names) ?? panic("checked default value cannot lower as a MIR constant")
            return jet_codegen_emit_value(&builder, expression.span, expression.ty, MirOperation.Constant{value: constant})
        }
        .ListLit(values) -> {
            lowered := [MirValueId]{}
            loop value in values -> &lowered.push(jet_codegen_lower_expr(&builder, value))
            coercion := jet_codegen_collection_list_trait_coercion(&builder, expression.ty)
            return jet_codegen_emit_value(&builder, expression.span, expression.ty, MirOperation.BuildList{values: lowered, trait_coercion: coercion})
        }
        .ColumnarListLit(_, elements) -> {
            lowered := [MirValueId]{}
            loop value in elements -> &lowered.push(jet_codegen_lower_expr(&builder, value))
            coercion := jet_codegen_collection_list_trait_coercion(&builder, expression.ty)
            return jet_codegen_emit_value(&builder, expression.span, expression.ty, MirOperation.BuildList{values: lowered, trait_coercion: coercion})
        }
        .TupleLit(_, named_fields) -> {
            tuple_fields := if jet_codegen_unwrap_pattern_tags(expression.ty) == {
                .Tuple(fields) -> fields
                else -> panic("checked tuple literal has a non-tuple result type")
            }
            fields := [TypeTupleField]{}
            values := [TExpr]{}
            loop named in named_fields {
                expected := None
                loop field in tuple_fields {
                    if field.name == named.name -> expected = Val(field.ty)
                }
                expected_type :: expected ?? panic("checked tuple literal field has no type")
                &fields.push(TypeTupleField{name: named.name, ty: expected_type})
                &values.push(jet_codegen_collection_boxed_expr(&builder, named.value, expected_type))
            }
            tuple_type := jet_codegen_lower_type_for_function(expression.ty, builder)
            type_id := tuple_type.identity ?? panic("checked tuple type has no MIR identity")
            identity := mir_type_identity_key(tuple_type)
            return jet_codegen_lower_tuple_fields(&builder, expression.span, expression.ty, fields, values, type_id, identity)
        }
        .IndexRead(base, index, is_map, uninit_fixed, line) -> {
            kind := if {
                is_map -> TIndexKind.Map
                uninit_fixed -> TIndexKind.FixedListProof
                else -> TIndexKind.List
            }
            location := jet_codegen_assignment_panic_location(&builder, expression.span, is_map)
            location.line = line
            place := jet_codegen_collection_index_place(&builder, base, index, kind, expression.ty, location, expression.span)
            return jet_codegen_emit_value(&builder, expression.span, expression.ty, MirOperation.ReadPlace{place: place})
        }
        .SliceOwned(base, start, end, range, line) -> {
            location := TPanicLoc{file: builder.function.source_file, source_line: "", line: line, column: 0, caret: 0, function: builder.function.name, locals: [TPanicLocal]{}}
            return jet_codegen_lower_slice(&builder, expression, base, start, end, range, location)
        }
        .MapLit(entries) -> {
            expected_key := Type.Int
            expected_value := Type.Int
            if jet_codegen_unwrap_pattern_tags(expression.ty) == {
                .Map(key, _, value) -> {
                    expected_key = key
                    expected_value = value
                }
                else -> {}
            }
            lowered := [MirMapEntry]{}
            loop entry in entries {
                pair := jet_codegen_lower_map_entry(&builder, entry)
                key := jet_codegen_collection_trait_box_value(&builder, pair.key, entry.key.ty, expected_key, expression.span)
                value := jet_codegen_collection_trait_box_value(&builder, pair.value, entry.value.ty, expected_value, expression.span)
                &lowered.push(MirMapEntry{key: key, value: value})
            }
            return jet_codegen_emit_value(&builder, expression.span, expression.ty, MirOperation.BuildMap{entries: lowered})
        }
        .LayoutLit(value) -> {
            lowered := jet_codegen_lower_expr(&builder, value)
            return jet_codegen_emit_value(&builder, expression.span, expression.ty, MirOperation.Semantic{operation: MirSemanticOp.LayoutLiteral{inner: lowered}})
        }
        else -> panic("non-collection TIR expression reached collection lowering")
    }
}
