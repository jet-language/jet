    fn source_math_call(self, caller: &MirFunction, call: MirCoreCallId, args: &[MirCallArg], type_args: &[MirType], result: MirValueId?) -> String? {
        row :: self.core_row(call)
        if row.module != "core.math" || row.aot_direct || !["checked_abs", "checked_neg", "checked_add", "checked_sub", "checked_mul", "checked_div", "checked_rem", "checked_pow", "saturating_add", "saturating_mul", "int_pow", "sum_int", "prod_int", "abs_diff", "div_mod", "div_rem"].contains(&row.member.as_str()) { return None }
        target :: self.program.functions.iter().find(fn(candidate) { candidate.module == row.module && candidate.name == row.member && candidate.form == .TopLevel }).unwrap_or_else(fn() { panic("MIR Core call `{row.module}.{row.member}` is routed through Jet source but has no source function") })
        if target.id == caller.id { panic("MIR Core call `{row.module}.{row.member}` selected its own Jet source function") }
        if args.len() != target.params.len() { panic("MIR Core call `{row.module}.{row.member}` has {args.len()} arguments for its Jet source function's {target.params.len()} parameters") }
        callee :: MirCallee.User(target.id)
        emitted :: self.call(caller, &callee, args, type_args)
        Some(self.call_result_expression(caller, &callee, result, emitted))
    }
