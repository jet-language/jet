fn jet_codegen_contract_same_local(left: TLocal, right: TLocal) -> Bool Never! {
    if left.symbol_id != None && right.symbol_id != None -> return (left.symbol_id ?? SymbolID{key: ""}).key == (right.symbol_id ?? SymbolID{key: ""}).key
    left.name == right.name
}

fn jet_codegen_contract_unit_type(ty: Type) -> Bool Never! {
    if ty == {
        .Named(name) -> name == "Unit"
        .Tagged(_, inner) -> jet_codegen_contract_unit_type(inner)
        else -> false
    }
}

fn jet_codegen_contract_location(builder: JetCodegenBuilder, contract: TContract) -> MIRPanicLoc Never! {
    if contract.file != builder.function.source_file -> panic("checked contract source differs from its function source")
    MIRPanicLoc{file: mir_source_file_id(contract.file), line: contract.line, column: 0}
}

fn jet_codegen_contract_context(builder: &JetCodegenBuilder, contract: TContract) -> MIRPanicContext Never! {
    previous_span := builder.current_span
    previous_line := builder.current_line
    builder.current_span = contract.span
    builder.current_line = Val(contract.line)
    location := jet_codegen_source_location(builder, true)
    builder.current_span = previous_span
    builder.current_line = previous_line
    MIRPanicContext{
        function: builder.function.name,
        source_line: location.source_line ?? panic("checked contract source line disappeared"),
        caret: 0,
        locals: [MIRPanicLocal]{},
    }
}

fn jet_codegen_lower_contract(builder: &JetCodegenBuilder, contract: TContract) {
    if contract.disposition == {
        .Proven | .Stripped -> return
        .Check -> {}
    }
    previous_span := builder.current_span
    previous_line := builder.current_line
    builder.current_span = contract.span
    builder.current_line = Val(contract.line)
    condition := jet_codegen_lower_expr(&builder, contract.condition)
    message := jet_codegen_lower_expr(&builder, contract.message)
    unit := Type.Named{name: "Unit"}
    call := jet_codegen_intern_route(
        &builder,
        MIRPreludeFamily.StaticPrelude,
        "core.require",
        "require",
        "jet_require",
        9,
        [Bool]{false, true, true, false, true, true, false, false, true},
        Val(Effect.Panic),
        TFailureCarrier.Infallible,
        MIRPreludeABI.Control,
    )
    location := jet_codegen_contract_location(builder, contract)
    context := jet_codegen_contract_context(&builder, contract)
    _ := jet_codegen_lower_conditional_stop(&builder, contract.span, unit, call, MIRRequireKind.Require, condition, location, context, [MIRValueID]{message}, "contract")
    builder.current_span = previous_span
    builder.current_line = previous_line
}

fn jet_codegen_contract_write(builder: &JetCodegenBuilder, place: MIRPlaceID, value: MIRValueID, span: Span) Never! {
    writable := jet_codegen_place_access(&builder, place, MIRAccess.Write)
    _ := jet_codegen_emit(&builder, span, None, MIROperation.WritePlace{place: writable, value: value})
}

fn jet_codegen_contract_return_move(builder: &JetCodegenBuilder, place: MIRPlaceID, ty: Type, span: Span) -> MIRValueID Never! {
    movable := jet_codegen_place_access(&builder, place, MIRAccess.Move)
    jet_codegen_emit_value(&builder, span, ty, MIROperation.MovePlace{place: movable})
}

fn jet_codegen_lower_contract_posts(builder: &JetCodegenBuilder, state: JetCodegenContractScopeState) {
    loop contract in state.post -> jet_codegen_lower_contract(&builder, contract)
}

fn jet_codegen_lower_implicit_contract_return(builder: &JetCodegenBuilder, state: JetCodegenContractScopeState, span: Span) {
    if !jet_codegen_contract_unit_type(state.result.binding_ty) -> panic("checked contract return is missing its value")
    binding_value := jet_codegen_emit_value(&builder, span, state.result.binding_ty, MIROperation.Constant{value: MIRConstant.Unit})
    jet_codegen_contract_write(&builder, state.binding_place, binding_value, span)
    if state.result.mode == {
        .Direct -> {
            if !jet_codegen_contract_same_local(state.result.carrier_local, state.result.binding_local) -> panic("direct contract result uses separate carrier and binding locals")
        }
        .ResultPayload | .OptionPayload -> {
            carrier_payload := jet_codegen_emit_value(&builder, span, state.result.binding_ty, MIROperation.Constant{value: MIRConstant.Unit})
            carrier_value := if state.result.mode == {
                .ResultPayload -> jet_codegen_emit_value(&builder, span, state.result.carrier_ty, MIROperation.ResultOk{value: carrier_payload})
                .OptionPayload -> jet_codegen_emit_value(&builder, span, state.result.carrier_ty, MIROperation.Present{value: carrier_payload})
                .Direct -> panic("direct contract result cannot wrap its unit payload")
            }
            jet_codegen_contract_write(&builder, state.carrier_place, carrier_value, span)
        }
    }
    jet_codegen_lower_contract_posts(&builder, state)
    returned := jet_codegen_contract_return_move(&builder, state.carrier_place, state.result.carrier_ty, span)
    terminator := MIRTerminator.Return{value: Val(returned)}
    _ := jet_codegen_terminate_with_owned_cleanup(&builder, terminator, -1)
}

fn jet_codegen_lower_contract_return(builder: &JetCodegenBuilder, value: MIRValueID?, span: Span) {
    if !jet_codegen_current_is_open(builder) -> return
    if builder.contract_scopes.len() == 0 -> panic("checked contract return has no active scope")
    state := builder.contract_scopes[builder.contract_scopes.len() - 1]
    if value == None -> return jet_codegen_lower_implicit_contract_return(&builder, state, span)
    returned_value := value
    if state.result.mode == {
        .Direct -> {
            if !jet_codegen_contract_same_local(state.result.carrier_local, state.result.binding_local) -> panic("direct contract result uses separate carrier and binding locals")
            jet_codegen_contract_write(&builder, state.binding_place, returned_value, span)
            jet_codegen_lower_contract_posts(&builder, state)
            returned := jet_codegen_contract_return_move(&builder, state.carrier_place, state.result.carrier_ty, span)
            terminator := MIRTerminator.Return{value: Val(returned)}
            _ := jet_codegen_terminate_with_owned_cleanup(&builder, terminator, -1)
        }
        .ResultPayload | .OptionPayload -> {
            condition := if state.result.mode == {
                .ResultPayload -> jet_codegen_emit_value(&builder, span, Type.Bool, MIROperation.ResultIsOk{subject: returned_value})
                .OptionPayload -> jet_codegen_emit_value(&builder, span, Type.Bool, MIROperation.OptionIsSome{subject: returned_value})
                .Direct -> panic("direct contract result cannot test a payload carrier")
            }
            success := jet_codegen_new_block(&builder, span, "contract.return.success")
            failure := jet_codegen_new_block(&builder, span, "contract.return.failure")
            jet_codegen_terminate(&builder, MIRTerminator.Branch{condition: condition, then_target: success, else_target: failure})

            jet_codegen_switch_block(&builder, success)
            jet_codegen_contract_write(&builder, state.carrier_place, returned_value, span)
            readable := jet_codegen_place_access(&builder, state.carrier_place, MIRAccess.Read)
            carrier_copy := jet_codegen_emit_value(&builder, span, state.result.carrier_ty, MIROperation.ReadPlace{place: readable})
            binding := if state.result.mode == {
                .ResultPayload -> jet_codegen_emit_value(&builder, span, state.result.binding_ty, MIROperation.ResultValue{subject: carrier_copy, ok: true})
                .OptionPayload -> jet_codegen_emit_value(&builder, span, state.result.binding_ty, MIROperation.OptionValue{subject: carrier_copy})
                .Direct -> panic("direct contract result cannot extract a payload")
            }
            jet_codegen_contract_write(&builder, state.binding_place, binding, span)
            jet_codegen_lower_contract_posts(&builder, state)
            success_return := jet_codegen_contract_return_move(&builder, state.carrier_place, state.result.carrier_ty, span)
            terminator := MIRTerminator.Return{value: Val(success_return)}
            _ := jet_codegen_terminate_with_owned_cleanup(&builder, terminator, -1)

            jet_codegen_switch_block(&builder, failure)
            jet_codegen_contract_write(&builder, state.carrier_place, returned_value, span)
            failure_return := jet_codegen_contract_return_move(&builder, state.carrier_place, state.result.carrier_ty, span)
            failure_terminator := MIRTerminator.Return{value: Val(failure_return)}
            _ := jet_codegen_terminate_with_owned_cleanup(&builder, failure_terminator, -1)
        }
    }
}

fn jet_codegen_lower_contract_scope(builder: &JetCodegenBuilder, pre: [TContract], body: [TStmt], post: [TContract], result: TContractResult, span: Span) {
    loop contract in pre -> jet_codegen_lower_contract(&builder, contract)
    if !jet_codegen_contract_same_local(result.carrier_local, result.binding_local) && result.mode == TContractResultMode.Direct -> panic("direct contract result uses separate carrier and binding locals")
    jet_codegen_enter_lexical(&builder)
    carrier_place := jet_codegen_bind_local(&builder, result.carrier_local, result.carrier_ty, false, None, None, false)
    binding_place := carrier_place
    if !jet_codegen_contract_same_local(result.carrier_local, result.binding_local) {
        binding_place = jet_codegen_bind_local(&builder, result.binding_local, result.binding_ty, false, None, None, false)
    }
    &builder.contract_scopes.push(JetCodegenContractScopeState{result: result, carrier_place: carrier_place, binding_place: binding_place, post: post})
    jet_codegen_lower_statements(&builder, body)
    if jet_codegen_current_is_open(builder) -> jet_codegen_lower_contract_return(&builder, None, span)
    _ := &builder.contract_scopes.pop()
    jet_codegen_leave_lexical(&builder)
}

fn jet_codegen_lower_loop_value(builder: &JetCodegenBuilder, label: String?, body: [TStmt], result_type: Type, span: Span) -> MIRValueID {
    header := jet_codegen_new_block(&builder, span, "loop.header")
    body_block := jet_codegen_new_block(&builder, span, "loop.body")
    exit_block := jet_codegen_new_block(&builder, span, "loop.exit")
    jet_codegen_terminate(&builder, MIRTerminator.Jump{target: header})
    jet_codegen_switch_block(&builder, header)
    jet_codegen_terminate(&builder, MIRTerminator.Jump{target: body_block})

    loop_scope_depth := builder.scope_depth
    cleanup_depth := builder.cleanup_frames.len()
    &builder.loops.push(JetCodegenLoopTarget{
        label: label,
        break_target: exit_block,
        continue_target: header,
        break_scope_depth: loop_scope_depth,
        continue_scope_depth: loop_scope_depth,
        break_cleanup_depth: cleanup_depth,
        continue_cleanup_depth: cleanup_depth,
        break_seen: false,
    })
    jet_codegen_switch_block(&builder, body_block)
    jet_codegen_lower_block(&builder, body)
    if jet_codegen_current_is_open(builder) -> jet_codegen_terminate(&builder, MIRTerminator.Jump{target: header})
    _ := &builder.loops.pop()

    incoming := [MIRPhiIncoming]{}
    value_less_break := false
    loop candidate in builder.blocks {
        if candidate.terminator == {
            .Break(target, value) && target == exit_block -> {
                if {
                    value == None -> {
                        value_less_break = true
                    } else -> {
                        payload :: value
                        &incoming.push(MIRPhiIncoming{block: candidate.id, value: payload})
                    }
                }
            }
            else -> {}
        }
    }
    if value_less_break || incoming.len() == 0 -> panic("TExprKind::InlineBlock result loop has a break exit without a value")
    jet_codegen_switch_block(&builder, exit_block)
    jet_codegen_emit_value(&builder, span, result_type, MIROperation.Phi{incoming: incoming})
}


fn jet_codegen_lower_inline_block(builder: &JetCodegenBuilder, expression: TExpr, body: [TStmt]) -> MIRValueID {
    if body.len() == 0 -> panic("checked inline contract block has no tail expression")
    jet_codegen_enter_lexical(&builder)
    if expression.ty == (Type.Named{name: "Never"}) {
        jet_codegen_lower_statements(&builder, body)
        if jet_codegen_current_is_open(builder) -> panic("checked divergent inline block did not terminate")
        jet_codegen_leave_lexical(&builder)
        return jet_codegen_emit_value(&builder, expression.span, expression.ty, MIROperation.Constant{value: MIRConstant.Unit})
    }
    index := 0
    loop index + 1 < body.len() {
        jet_codegen_lower_statement(&builder, body[index])
        if !jet_codegen_current_is_open(builder) -> panic("checked inline contract block terminates before its result")
        index += 1
    }
    result := if body[body.len() - 1] == {
        .ExprStmt(value, _) -> {
            if type_identity_key(expression.ty) != type_identity_key(value.ty) -> panic("checked inline block result type disagrees with its tail")
            jet_codegen_lower_expr(&builder, value)
        }
        .Loop(label, loop_body, span) -> jet_codegen_lower_loop_value(&builder, label, loop_body, expression.ty, span)
        .Return(_, _) | .Break(_, _) | .BreakValue(_, _, _) | .Continue(_, _) -> {
            jet_codegen_lower_statement(&builder, body[body.len() - 1])
            if jet_codegen_current_is_open(builder) -> panic("checked divergent inline tail did not terminate")
            jet_codegen_emit_value(&builder, expression.span, expression.ty, MIROperation.Constant{value: MIRConstant.Unit})
        }
        else -> panic("checked inline contract block has no expression tail")
    }
    jet_codegen_leave_lexical(&builder)
    result
}


fn jet_codegen_transaction_call_arg(value: TExpr) -> TCallArg Never! {
    TCallArg{
        value: value,
        template_items: [SymbolID]{},
        borrow: false,
        mut_borrow: false,
        clone: false,
        arc_clone: false,
        fn_coerce: None,
        widen_to_vec: false,
        widen_to_union: None,
        box_as_trait: None,
        label: None,
        spread: false,
    }
}

fn jet_codegen_is_unit_type(ty: Type) -> Bool Never! {
    if type_is_unit_callable_return(ty) -> return true
    if ty == {
        .Tuple(fields) -> fields.len() == 0
        else -> false
    }
}

fn jet_codegen_transaction_method_expr(builder: JetCodegenBuilder, local: TLocal, owner: Type, method_ref: TMethodRef, args: [TCallArg], span: Span) -> TExpr Never! {
    function :: jet_codegen_find_function(builder.function_index, method_ref.symbol.key) ?? panic("checked Rollback::{method_ref.name} method has no reachable TFunc")
    if function.key != method_ref.symbol.key -> panic("checked Rollback method SymbolId resolved to a different TFunc")
    return_type := function.ret ?? Type.Named{name: "Unit"}
    receiver := TExpr{ty: owner, kind: TExprKind.Local{local: local}, span: span, integer_bounds: None, cost: None}
    TExpr{ty: return_type, kind: TExprKind.MethodCall{receiver: receiver, method: method_ref, type_args: [Type]{}, args: args}, span: span, integer_bounds: None, cost: None}
}

fn jet_codegen_transaction_save_snapshot(builder: &JetCodegenBuilder, scope: MIRScopeID, index: Int, snapshot: TTransactionSnapshot, span: Span) -> JetCodegenTransactionSnapshot {
    binding :: jet_codegen_find_binding_for_local(builder, snapshot.local) ?? panic("checked transaction snapshot local is not bound")
    target_place := jet_codegen_lower_local_place(&builder, snapshot.local)
    snapshot_value := MIRValueID{value: 0}
    snapshot_type := binding.ty
    if {
        snapshot.rollback_type != None -> {
            owner :: snapshot.rollback_type ?? panic("checked transaction rollback owner disappeared")
            snapshot_method :: snapshot.snapshot_method ?? panic("checked transaction rollback has no Rollback::snapshot method")
            call := jet_codegen_transaction_method_expr(builder, snapshot.local, owner, snapshot_method, [TCallArg]{}, span)
            if call.ty == {
                .Result(ok, _) -> {
                    snapshot_type = ok
                    checked := TExpr{ty: ok, kind: TExprKind.Try{value: call, conversion: TTryConvert.NoConversion, failure: builder.function.failure_carrier}, span: span, integer_bounds: None, cost: None}
                    snapshot_value = jet_codegen_lower_expr(&builder, checked)
                }
                else -> {
                    snapshot_type = call.ty
                    snapshot_value = jet_codegen_lower_expr(&builder, call)
                }
            }
        } else -> {
            value := jet_codegen_emit_value(&builder, span, snapshot_type, MIROperation.ReadPlace{place: target_place})
            // The rollback snapshot owns the state the scope goes on to change.
            snapshot_value = jet_codegen_emit_value(&builder, span, snapshot_type, MIROperation.Copy{value: value, fact: MIRCopyFact.Materialize})
        }
    }
    saved_name := "jet_txn_snapshot_{scope.value}_{index}"
    saved_local := tir_generated_local(saved_name, span)
    saved_local.mutable = true
    saved_place := jet_codegen_bind_local(&builder, saved_local, snapshot_type, true, None, None, false)
    _ := jet_codegen_emit(&builder, span, None, MIROperation.WritePlace{place: saved_place, value: snapshot_value})
    JetCodegenTransactionSnapshot{
        local: snapshot.local,
        ty: binding.ty,
        saved_ty: snapshot_type,
        place: target_place,
        saved_local: saved_local,
        saved_place: saved_place,
        rollback_type: snapshot.rollback_type,
        restore_method: snapshot.restore_method,
    }
}

fn jet_codegen_transaction_restore_snapshot(builder: &JetCodegenBuilder, snapshot: JetCodegenTransactionSnapshot, span: Span) {
    if snapshot.rollback_type == {
        None -> {
            saved := jet_codegen_emit_value(&builder, span, snapshot.saved_ty, MIROperation.ReadPlace{place: snapshot.saved_place})
            _ := jet_codegen_emit(&builder, span, None, MIROperation.WritePlace{place: snapshot.place, value: saved})
        }
        Val(owner) -> {
            saved := TExpr{ty: snapshot.saved_ty, kind: TExprKind.Local{local: snapshot.saved_local}, span: span, integer_bounds: None, cost: None}
            restore_method :: snapshot.restore_method ?? panic("checked transaction rollback has no Rollback::restore method")
            call := jet_codegen_transaction_method_expr(builder, snapshot.local, owner, restore_method, [TCallArg]{jet_codegen_transaction_call_arg(saved)}, span)
            if call.ty != (Type.Named{name: "Unit"}) -> panic("checked Rollback::restore does not return Unit")
            _ := jet_codegen_lower_expr(&builder, call)
        }
    }
}

fn jet_codegen_transaction_exit_required(builder: JetCodegenBuilder, transaction: JetCodegenTransactionState, terminator: MIRTerminator) -> Bool Never! {
    if terminator == {
        .Return(_) -> return true
        .Break(target, _) | .Continue(target) -> {
            loop index in 0..<builder.loops.len() {
                loop_target := builder.loops[index]
                if loop_target.break_target == target || loop_target.continue_target == target -> return index < transaction.loop_depth
            }
            panic("checked transaction early exit does not resolve to a loop target")
        }
        else -> false
    }
}

fn jet_codegen_prepare_transaction_exit(builder: &JetCodegenBuilder, terminator: MIRTerminator) -> Bool {
    if builder.transaction_cleanup_active -> return true
    exiting := [Int]{}
    index := builder.transactions.len() - 1
    loop index >= 0 {
        if jet_codegen_transaction_exit_required(builder, builder.transactions[index], terminator) -> &exiting.push(index)
        index -= 1
    }
    if exiting.len() == 0 -> return true
    builder.transaction_cleanup_active = true
    loop transaction_index in exiting {
        transaction := builder.transactions[transaction_index]
        snapshot_index := transaction.snapshots.len() - 1
        loop snapshot_index >= 0 {
            span := builder.current_span
            jet_codegen_transaction_restore_snapshot(&builder, transaction.snapshots[snapshot_index], span)
            if !jet_codegen_current_is_open(builder) {
                builder.transaction_cleanup_active = false
                return false
            }
            snapshot_index -= 1
        }
        if transaction.stm_place != None {
            place :: transaction.stm_place ?? panic("checked transaction STM place disappeared during rollback")
            span := builder.current_span
            value := jet_codegen_emit_value(&builder, span, Type.Named{name: "Stm"}, MIROperation.MovePlace{place: place})
            _ := jet_codegen_emit(&builder, span, None, MIROperation.Drop{value: value, kind: MIRDropKind.Value})
        }
        if transaction.handle_place != None {
            place :: transaction.handle_place ?? panic("checked transaction handle place disappeared during rollback")
            span := builder.current_span
            value := jet_codegen_emit_value(&builder, span, Type.Named{name: "Transaction"}, MIROperation.MovePlace{place: place})
            _ := jet_codegen_emit(&builder, span, None, MIROperation.Drop{value: value, kind: MIRDropKind.Value})
        }
    }
    builder.transaction_cleanup_active = false
    jet_codegen_current_is_open(builder)
}

fn jet_codegen_lower_transaction(builder: &JetCodegenBuilder, handle: TLocal?, snapshots: [TTransactionSnapshot], stm: TLocal?, body: [TStmt], span: Span) {
    identity := jet_codegen_identity(&builder, "scope", span, "Transaction", "")
    scope := MIRScopeID{value: stable_id("mir-scope", identity)}
    jet_codegen_enter_lexical(&builder)

    stm_local := TLocal?{None}
    if stm != None {
        source :: stm
        local := tir_generated_local("jet_stm_{scope.value}", source.span)
        local.mutable = true
        stm_local = Val(local)
    }
    scope_name := if stm_local != None -> Val((stm_local ?? tir_generated_local("", span)).name) else -> None
    &builder.scopes.push(MIRScope{id: scope, kind: MIRScopeKind.Transaction, span: span, name: scope_name, deadline: None, facts: [MIRScopeFact]{}})
    _ := jet_codegen_emit(&builder, span, None, MIROperation.ScopeEnter{scope: scope, test_member: None})
    &builder.cleanup_frames.push(JetCodegenCleanupFrame{
        owner: Val(scope),
        depth: builder.scope_depth,
        binding_start: builder.bindings.len(),
        drop_live_start: builder.drop_live_places.len(),
        actions: [JetCodegenCleanupAction]{},
        explicit: 0,
        pending_exits: [JetCodegenPendingExit]{},
    })

    handle_place := MIRPlaceID?{None}
    if handle != None {
        local :: handle
        place := jet_codegen_bind_local(&builder, local, Type.Named{name: "Transaction"}, local.mutable, None, None, false)
        value := jet_codegen_emit_value(&builder, span, Type.Named{name: "Transaction"}, MIROperation.Global{name: "transaction"})
        _ := jet_codegen_emit(&builder, span, None, MIROperation.WritePlace{place: place, value: value})
        handle_place = Val(place)
    }
    stm_place := MIRPlaceID?{None}
    if stm_local != None {
        local :: stm_local ?? panic("checked transaction STM local disappeared")
        place := jet_codegen_bind_local(&builder, local, Type.Named{name: "Stm"}, true, None, None, false)
        value := jet_codegen_emit_value(&builder, span, Type.Named{name: "Stm"}, MIROperation.Global{name: "stm"})
        _ := jet_codegen_emit(&builder, span, None, MIROperation.WritePlace{place: place, value: value})
        stm_place = Val(place)
    }

    lowered_snapshots := [JetCodegenTransactionSnapshot]{}
    index := 0
    loop index < snapshots.len() {
        &lowered_snapshots.push(jet_codegen_transaction_save_snapshot(&builder, scope, index, snapshots[index], span))
        index += 1
    }
    &builder.transactions.push(JetCodegenTransactionState{
        scope: scope,
        stm_place: stm_place,
        handle_place: handle_place,
        snapshots: lowered_snapshots,
        loop_depth: builder.loops.len(),
    })
    jet_codegen_lower_block(&builder, body)
    if jet_codegen_current_is_open(builder) && handle_place != None {
        place :: handle_place ?? panic("checked transaction handle place disappeared before commit")
        receiver := jet_codegen_emit_value(&builder, span, Type.Named{name: "Transaction"}, MIROperation.ReadPlace{place: place})
        call := jet_codegen_intern_route(&builder, MIRPreludeFamily.HandleMethod, "core.transaction", "commit", "jet_transaction_commit", 1, [Bool]{true}, None, TFailureCarrier.Infallible, MIRPreludeABI.Value)
        _ := jet_codegen_emit_value(&builder, span, Type.Named{name: "Unit"}, MIROperation.Semantic{operation: MIRSemanticOp.HandleMethod{call: call, receiver: receiver, args: [MIRValueID]{}, frame_schedule: None, frame_schedule_derivation: None}})
    }
    jet_codegen_leave_scope(&builder, scope)
    _ := &builder.transactions.pop()
    jet_codegen_leave_lexical(&builder)
}

fn jet_codegen_mark_gc_root(builder: &JetCodegenBuilder, place: MIRPlaceID) Never! {
    index := 0
    loop index < builder.locals.len() {
        if builder.locals[index].place == place {
            local := builder.locals[index]
            local.gc_root = true
            ownership := local.ownership
            ownership.gc_root = true
            local.ownership = ownership
            builder.locals[index] = local
            return
        }
        index += 1
    }
    panic("checked GC-root local has no MIR local")
}

fn jet_codegen_lower_statement(builder: &JetCodegenBuilder, statement: TStmt) {
    if statement == {
        .Contract(contract) -> jet_codegen_lower_contract(&builder, contract)
        .ContractScope(pre, body, post, result, span) -> jet_codegen_lower_contract_scope(&builder, pre, body, post, result, span)
        .Let(local, let_ty, init, gc_promotion, gc_transferred, span) -> {
            gc_root_requested := gc_promotion != None || gc_transferred
            string_view := false
            gc_root := false
            // The binding holds its initializer's own type (no annotation, or
            // an annotation naming that type), so it may alias a read place.
            binds_init_type := false
            if let_ty == {
                .Inferred -> binds_init_type = true
                .StrView -> string_view = true
                .Annotated(ty, wrapper) -> {
                    if wrapper == {
                        .Plain -> binds_init_type = ty == init.ty
                        .AutomaticRoot -> gc_root = true
                        .Resource -> panic("checked let wrapper lies outside the current Jet codegen contract")
                    }
                }
                else -> panic("checked let wrapper lies outside the current Jet codegen contract")
            }
            if gc_root_requested != gc_root -> panic("checked GC ownership facts disagree with the automatic-root binding")
            if init.kind == {
                .Uninit -> {
                    if !local.uninit_scalar && !local.uninit_fixed -> panic("checked uninitialized let has no uninitialized-local fact")
                    place := jet_codegen_bind_local(&builder, local, init.ty, local.mutable, None, None, string_view)
                    if gc_root -> jet_codegen_mark_gc_root(&builder, place)
                    _ := jet_codegen_emit(&builder, span, None, MIROperation.InitializeUninit{place: place})
                }
                else -> {
                    if local.uninit_scalar || local.uninit_fixed -> panic("checked initialized let carries an uninitialized-local fact")
                    // D-OPT-WRITE1 (#3974): a hoisted `&place` switch subject is
                    // an alias of the place, so arm patterns are write windows.
                    window_place := MIRPlaceID?{None}
                    if local.generated && init.kind == .Borrow(borrowed, access) {
                        if access == AccessConvention.Write -> window_place = Val(jet_codegen_lower_place_for_access(&builder, TPlace.Expr{value: borrowed}, MIRAccess.Write))
                    }
                    if window_place == .Val(window) {
                        _ := jet_codegen_bind_local_alias(&builder, local, init.ty, window, true)
                        &builder.window_aliases.push(local.name)
                    } else {
                        // D-MEM-COPYSEM1: an immutable binding of a read
                        // parameter's place (or of its payload past a
                        // diverging `??`) aliases the place. The parameter
                        // cannot change while the function runs, so the alias
                        // reads exactly what a copy would hold.
                        read_alias := MIRPlaceID?{None}
                        if binds_init_type && !local.mutable && !local.generated && !gc_root_requested {
                            read_alias = if init.kind == {
                                .OrFallback(subject, fallback, ambient_err) -> jet_codegen_lower_or_fallback_window(&builder, init, subject, fallback, ambient_err)
                                else -> jet_codegen_read_window_place(&builder, init)
                            }
                        }
                        if read_alias == .Val(read_place) {
                            _ := jet_codegen_bind_local_alias(&builder, local, init.ty, read_place, false)
                        } else {
                            value := jet_codegen_lower_expr(&builder, init)
                            place := jet_codegen_bind_local(&builder, local, init.ty, local.mutable, None, None, string_view)
                            if gc_root -> jet_codegen_mark_gc_root(&builder, place)
                            _ := jet_codegen_emit(&builder, span, None, MIROperation.WritePlace{place: place, value: value})
                            // Rust: tir_to_mir_stmt.rs::lower_stmt (`TStmt::Let`)
                            // register_file_owner_binding after the write.
                            jet_codegen_register_file_owner_binding(&builder, place, init.ty, value)
                        }
                    }
                }
            }
        }
        .TupleDestructure(temp, init, move_fields, binds, span) | .StructDestructure(temp, init, move_fields, binds, span) -> jet_codegen_lower_field_destructure(&builder, temp, init, move_fields, binds, span)
        .ListDestructure(_, init, count, _, _, elements, span) -> jet_codegen_lower_list_destructure(&builder, init, count, elements, span)
        .Assign(place_expr, op, value, clone_value, line, span) -> {
            place_ty := jet_codegen_assignment_place_type(builder, place_expr)
            destination_is_view := jet_codegen_assignment_destination_is_string_view(builder, place_expr)
            right := jet_codegen_assignment_value(&builder, value, clone_value, destination_is_view, span)
            place := jet_codegen_lower_place_for_access(&builder, place_expr, MIRAccess.Write)
            assigned := if op == {
                .None -> right
                .Val(operation) -> {
                    old := jet_codegen_emit_value(&builder, span, place_ty, MIROperation.ReadPlace{place: place})
                    overflow := jet_codegen_assignment_overflow(operation, place_ty, value.ty)
                    dispatch := jet_codegen_binary_dispatch(&builder, operation, overflow, place_ty, span, line)
                    mir_overflow := MIRBinaryOverflow.Unchecked
                    if overflow && jet_codegen_fixed_width(place_ty) != None -> mir_overflow = MIRBinaryOverflow.Trap
                    jet_codegen_emit_value(&builder, span, place_ty, MIROperation.Binary{op: jet_codegen_lower_binary(operation), dispatch: dispatch, overflow: mir_overflow, left: old, right: right})
                }
            }
            // Rust: tir_to_mir_stmt.rs::lower_assign: a displaced live file
            // owner is released first, and a file-owner slot is replaced.
            owning_file_slot := jet_codegen_is_core_file_owner_type(builder, place_ty)
            jet_codegen_emit_file_owner_replacement(&builder, place)
            if {
                owning_file_slot -> {
                    _ := jet_codegen_emit(&builder, span, None, MIROperation.ReplacePlace{place: place, value: assigned})
                } else -> {
                    _ := jet_codegen_emit(&builder, span, None, MIROperation.WritePlace{place: place, value: assigned})
                }
            }
        }
        .IndexAssign(uninit, base, index, is_map, value, span) -> jet_codegen_lower_index_assign(&builder, uninit, base, index, is_map, value, span)
        .IndexFieldAssign(assign, span) -> jet_codegen_lower_index_field_assign(&builder, assign, span)
        .MathSwizzleAssign(base, _, lanes, value, clone_value, span) -> jet_codegen_lower_math_swizzle_assign(&builder, base, lanes, value, clone_value, span)
        .IndexHookAssign(_, base, index, value, span) -> jet_codegen_lower_index_hook_assign(&builder, base, index, value, span)
        .SplitViews(owner, root, _, _, _, _, _, _, _, name, start, end, single, write, element, line, span) -> jet_codegen_lower_split_view(&builder, owner, root, name, start, end, single, write, element, line, span)
        .Return(value, span) -> {
            result := MIRValueID?{None}
            if value != None -> result = Val(jet_codegen_lower_return_value(&builder, value))
            // #3713: the `Err(...)` a function returns is where its failure
            // starts; every tier records that site as the origin.
            if value == .Val(returned) && jet_codegen_current_is_open(builder) {
                if returned.kind == {
                    .Err(_) -> jet_codegen_lower_journey_origin(&builder, returned.span)
                    else -> {}
                }
            }
            if {
                builder.contract_scopes.len() > 0 -> {
                    jet_codegen_lower_contract_return(&builder, result, span)
                } else -> {
                    terminator := MIRTerminator.Return{value: result}
                    _ := jet_codegen_terminate_with_owned_cleanup(&builder, terminator, -1)
                }
            }
        }
        .ExprStmt(value, _) -> { _ := jet_codegen_lower_expr(&builder, value) }
        .If(condition, then_body, else_body, _, span) -> jet_codegen_lower_if(&builder, condition, then_body, else_body, span)
        .DebugOnly(body, span) -> jet_codegen_lower_debug_only(&builder, body, span)
        .Unsafe(gate, body) -> {
            current_span := builder.current_span
            jet_codegen_lower_unsafe(&builder, gate, body, current_span)
        }
        .UnsafeBlock(gate, body, span) -> jet_codegen_lower_unsafe(&builder, gate, body, span)
        .SentryPolicy(enabled, body, span) -> jet_codegen_lower_sentry_policy(&builder, enabled, body, span)
        .Impure(body, span) -> jet_codegen_lower_scoped(&builder, MIRScopeKind.Impure, None, body, span)
        .Reactive(executable, span) -> {
            function_identity := "{builder.function.key}|{builder.function.source_file}|{builder.function.source_span.start}|{builder.function.source_span.end}"
            site := Int.from_u64(stable_id("mir-site", "{function_identity}:reactive:{span.start}:{span.end}"))
            expression := TExpr{ty: Type.Named{name: "Unit"}, kind: TExprKind.CoreClosureCall{kind: TCoreClosureKind.ReactiveEffect{executable: executable, site: site}}, span: span, integer_bounds: None, cost: None}
            _ := jet_codegen_lower_expr(&builder, expression)
        }
        .Region(body, span) -> jet_codegen_lower_scoped(&builder, MIRScopeKind.Region, None, body, span)
        .Layout(handle, label, body, span) -> jet_codegen_lower_layout(&builder, handle, label, body, span)
        .ContextBlock(guards, body, span) -> jet_codegen_lower_context_block(&builder, guards, body, span)
        .Live(body, span) -> jet_codegen_lower_scoped(&builder, MIRScopeKind.Live, None, body, span)
        .Shield(body, span) -> jet_codegen_lower_scoped(&builder, MIRScopeKind.Shield, None, body, span)
        .ScopeMember(kind, body, span) -> jet_codegen_lower_scope_member(&builder, kind, body, span)
        .TaskGroup(group, limit, body, span) -> jet_codegen_lower_task_group(&builder, group, limit, body, span)
        .DeferClose(close, resource, scope_id, span) -> {
            thunk := jet_codegen_lower_defer_thunk(&builder, close, resource, scope_id, span)
            jet_codegen_register_deferred_call(&builder, thunk)
        }
        .RefutableBind(pattern, init, fallback, span) -> jet_codegen_lower_refutable_bind(&builder, pattern, init, fallback, span)
        .Match(subject, arms, exhaustive, span) -> jet_codegen_lower_pattern_match(&builder, subject, false, arms, None, exhaustive, "checked exhaustive match", span)
        .RangeSwitch(subject, arms, else_body, span) -> jet_codegen_lower_range_switch(&builder, subject, arms, else_body, span)
        .MixedSwitch(subject, _, arms, else_body, span) -> jet_codegen_lower_mixed_switch(&builder, subject, arms, else_body, span)
        .EnumMatch(scrutinee, clone_subject, arms, else_body, fallthrough, span) -> {
            reason := if fallthrough -> "checked exhaustive match fallthrough" else -> "checked exhaustive match otherwise"
            jet_codegen_lower_pattern_match(&builder, scrutinee, clone_subject, arms, else_body, else_body == None, reason, span)
        }
        .While(label, condition, body, span) -> {
            condition_block := jet_codegen_new_block(&builder, span, "while-condition")
            body_block := jet_codegen_new_block(&builder, span, "while-body")
            exit_block := jet_codegen_new_block(&builder, span, "while-exit")
            jet_codegen_terminate(&builder, MIRTerminator.Jump{target: condition_block})
            jet_codegen_switch_block(&builder, condition_block)
            condition_value := jet_codegen_lower_expr(&builder, condition)
            jet_codegen_terminate(&builder, MIRTerminator.Branch{condition: condition_value, then_target: body_block, else_target: exit_block})
            loop_scope_depth := builder.scope_depth
            &builder.loops.push(JetCodegenLoopTarget{label: label, break_target: exit_block, continue_target: condition_block, break_scope_depth: loop_scope_depth, continue_scope_depth: loop_scope_depth, break_cleanup_depth: builder.cleanup_frames.len(), continue_cleanup_depth: builder.cleanup_frames.len(), break_seen: false})
            jet_codegen_switch_block(&builder, body_block)
            jet_codegen_lower_block(&builder, body)
            if jet_codegen_current_is_open(builder) -> jet_codegen_terminate(&builder, MIRTerminator.Jump{target: condition_block})
            _ := &builder.loops.pop()
            jet_codegen_switch_block(&builder, exit_block)
        }
        .CountedLoop(label, init, condition, step, vectorization, body, span) -> jet_codegen_lower_counted_loop(&builder, label, init, condition, step, vectorization, body, span)
        .ForRange(label, local, start, end, step, exclusive, body, vectorization, span) -> jet_codegen_lower_range_loop(&builder, label, local, None, start, end, step, exclusive, vectorization, body, span)
        .Range(label, variable, source, start, end, step, exclusive, vectorization, body, span) -> jet_codegen_lower_range_loop(&builder, label, variable, source, start, end, step, exclusive, vectorization, body, span)
        .ForIn(label, variable, variable_two, source, collection, step, method_kind, columnar, by_value, source_stable, body, span) -> jet_codegen_lower_for_in(&builder, label, variable, variable_two, source, collection, step, method_kind, columnar, by_value, source_stable, body, span)
        .Loop(label, body, span) -> {
            body_block := jet_codegen_new_block(&builder, span, "loop-body")
            exit_block := jet_codegen_new_block(&builder, span, "loop-exit")
            jet_codegen_terminate(&builder, MIRTerminator.Jump{target: body_block})
            loop_scope_depth := builder.scope_depth
            &builder.loops.push(JetCodegenLoopTarget{label: label, break_target: exit_block, continue_target: body_block, break_scope_depth: loop_scope_depth, continue_scope_depth: loop_scope_depth, break_cleanup_depth: builder.cleanup_frames.len(), continue_cleanup_depth: builder.cleanup_frames.len(), break_seen: false})
            jet_codegen_switch_block(&builder, body_block)
            jet_codegen_lower_block(&builder, body)
            if jet_codegen_current_is_open(builder) -> jet_codegen_terminate(&builder, MIRTerminator.Jump{target: body_block})
            loop_target := builder.loops[builder.loops.len() - 1]
            _ := &builder.loops.pop()
            jet_codegen_switch_block(&builder, exit_block)
            if !loop_target.break_seen -> jet_codegen_terminate(&builder, MIRTerminator.Unreachable{reason: "unconditional loop has no break"})
        }
        .Break(label, _) -> {
            target := jet_codegen_find_loop_target(builder, label, true)
            terminator := MIRTerminator.Break{target: target, value: None}
            scope_depth :: jet_codegen_find_loop_scope_depth(builder, label, true)
            if jet_codegen_terminate_with_owned_cleanup(&builder, terminator, scope_depth) {
                jet_codegen_mark_loop_break(&builder, label)
            }
        }
        .BreakValue(label, value, _) -> {
            payload := jet_codegen_lower_expr(&builder, value)
            target := jet_codegen_find_loop_target(builder, label, true)
            terminator := MIRTerminator.Break{target: target, value: Val(payload)}
            scope_depth :: jet_codegen_find_loop_scope_depth(builder, label, true)
            if jet_codegen_terminate_with_owned_cleanup(&builder, terminator, scope_depth) {
                jet_codegen_mark_loop_break(&builder, label)
            }
        }
        .Continue(label, _) -> {
            terminator := MIRTerminator.Continue{target: jet_codegen_find_loop_target(builder, label, false)}
            scope_depth :: jet_codegen_find_loop_scope_depth(builder, label, false)
            _ := jet_codegen_terminate_with_owned_cleanup(&builder, terminator, scope_depth)
        }
        .Reactive(executable, span) -> {
            site := Int.from_u64(stable_id("mir-site", "{builder.function.key}|reactive|{span.start}:{span.end}"))
            value := TExpr{
                ty: Type.Named{name: "Unit"},
                kind: TExprKind.CoreClosureCall{kind: TCoreClosureKind.ReactiveEffect{executable: executable, site: site}},
                span: span,
                integer_bounds: None,
                cost: None,
            }
            _ := jet_codegen_lower_expr(&builder, value)
        }
        .LineMarker(line) -> {
            if line < 0 -> panic("checked source line marker is negative")
            builder.current_line = Val(line)
        }
        .SourceSpan(span) -> builder.current_span = span
        .Inline(body, _) -> jet_codegen_lower_statements(&builder, body)
        .Transact(handle, snapshots, stm, body, span) -> jet_codegen_lower_transaction(&builder, handle, snapshots, stm, body, span)
        else -> panic("checked TIR statement lies outside the current Jet codegen contract")
    }
}

fn jet_codegen_fallback_join_value(builder: &JetCodegenBuilder, expression: TExpr, source_type: Type, value: MIRValueID) -> MIRValueID Never! {
    if type_identity_key(source_type) == type_identity_key(expression.ty) -> return ~value
    if expression.ty == {
        .TraitObject(_) -> {
            jet_codegen_require_trait_box_target(expression.ty, builder)
            target := jet_codegen_lower_type_for_function(expression.ty, builder)
            target_id :: target.identity ?? panic("checked fallback trait result has no MIR identity")
            return jet_codegen_emit_value(&builder, expression.span, expression.ty, MIROperation.TraitBox{value: value, target: target_id})
        }
        else -> panic("checked fallback value disagrees with its joined type")
    }
}

fn jet_codegen_lower_fallback_panic(builder: &JetCodegenBuilder, expression: TExpr, message: TExpr, location: TPanicLoc) {
    value := jet_codegen_lower_expr(&builder, message)
    carrier := jet_codegen_failure_carrier_for_type(expression.ty)
    call := jet_codegen_intern_route(
        &builder,
        MIRPreludeFamily.StaticPrelude,
        "core.require",
        "panic",
        "jet_panic_rich",
        8,
        [Bool]{true, false, true, true, false, false, true, true},
        Val(Effect.Panic),
        carrier,
        MIRPreludeABI.Control,
    )
    locals := [MIRPanicLocal]{}
    loop local in location.locals {
        binding :: jet_codegen_find_binding_for_local(builder, local.local) ?? next
        &locals.push(MIRPanicLocal{name: local.display_name, local: binding.local})
    }
    panic_location := MIRPanicLoc{file: mir_source_file_id(location.file), line: location.line, column: location.column}
    context := MIRPanicContext{function: builder.function.name, source_line: location.source_line, caret: location.caret, locals: locals}
    jet_codegen_emit_explicit_stop_cleanups(&builder)
    _ := jet_codegen_emit_value(&builder, expression.span, expression.ty, MIROperation.Semantic{operation: MIRSemanticOp.RequireStop{call: call, kind: MIRRequireKind.Panic, condition: None, location: panic_location, context: context, values: [MIRValueID]{value}, always_stops: true}})
    jet_codegen_terminate(&builder, MIRTerminator.Unreachable{reason: "checked fallback panic"})
}

fn jet_codegen_lower_fallback_route(builder: &JetCodegenBuilder, expression: TExpr, fallback: TOrFallback) -> MIRValueID? {
    if fallback == {
        .Value(value) -> {
            lowered := jet_codegen_lower_expr(&builder, value)
            if !jet_codegen_current_is_open(builder) -> return None
            return Val(jet_codegen_fallback_join_value(&builder, expression, value.ty, lowered))
        }
        .Return(value) -> jet_codegen_lower_statement(&builder, TStmt.Return{value: value, span: expression.span})
        .Panic(message, location) -> jet_codegen_lower_fallback_panic(&builder, expression, message, location)
        .Break -> jet_codegen_lower_statement(&builder, TStmt.Break{label: None, span: expression.span})
        .Continue -> jet_codegen_lower_statement(&builder, TStmt.Continue{label: None, span: expression.span})
        .BreakLabel(label) -> jet_codegen_lower_statement(&builder, TStmt.Break{label: Val(label), span: expression.span})
        .ContinueLabel(label) -> jet_codegen_lower_statement(&builder, TStmt.Continue{label: Val(label), span: expression.span})
    }
    None
}

fn jet_codegen_lower_or_fallback(builder: &JetCodegenBuilder, expression: TExpr, subject: TExpr, fallback: TOrFallback, ambient_err: TLocal?) -> MIRValueID {
    value := jet_codegen_lower_expr(&builder, subject)
    success_type := Type.Named{name: "Unit"}
    error_type := Type?{None}
    optional := false
    if subject.ty == {
        .Option(inner) -> {
            optional = true
            success_type = inner
        }
        .Result(ok, error) -> {
            success_type = ok
            error_type = Val(error)
        }
        else -> panic("checked fallback subject has no failure carrier")
    }
    success_block := jet_codegen_new_block(&builder, expression.span, "fallback-success")
    failure_block := jet_codegen_new_block(&builder, expression.span, "fallback-failure")
    join_block := jet_codegen_new_block(&builder, expression.span, "fallback-join")
    condition := if {
        optional -> {
            jet_codegen_emit_value(&builder, expression.span, Type.Bool, MIROperation.OptionIsSome{subject: value})
        } else -> {
            jet_codegen_emit_value(&builder, expression.span, Type.Bool, MIROperation.ResultIsOk{subject: value})
        }
    }
    jet_codegen_terminate(&builder, MIRTerminator.Branch{condition: condition, then_target: success_block, else_target: failure_block})
    incoming := [MIRPhiIncoming]{}
    jet_codegen_switch_block(&builder, success_block)
    if {
        success_type == (Type.Named{name: "Never"}) -> {
            jet_codegen_terminate(&builder, MIRTerminator.Unreachable{reason: "checked fallback success is uninhabited"})
        } else -> {
            payload := if {
                optional -> {
                    jet_codegen_emit_value(&builder, expression.span, success_type, MIROperation.OptionValue{subject: value})
                } else -> {
                    jet_codegen_emit_value(&builder, expression.span, success_type, MIROperation.ResultValue{subject: value, ok: true})
                }
            }
            result := jet_codegen_fallback_join_value(&builder, expression, success_type, payload)
            predecessor := builder.current
            jet_codegen_terminate(&builder, MIRTerminator.Jump{target: join_block})
            &incoming.push(MIRPhiIncoming{block: predecessor, value: result})
        }
    }
    jet_codegen_switch_block(&builder, failure_block)
    if {
        error_type == (Val(Type.Named{name: "Never"})) -> {
            jet_codegen_terminate(&builder, MIRTerminator.Unreachable{reason: "checked fallback failure is uninhabited"})
        } else -> {
            result := jet_codegen_lower_fallback_failure(&builder, expression, value, error_type, fallback, ambient_err)
            if result != None && jet_codegen_current_is_open(builder) {
                lowered :: result ?? panic("checked fallback value disappeared")
                predecessor := builder.current
                jet_codegen_terminate(&builder, MIRTerminator.Jump{target: join_block})
                &incoming.push(MIRPhiIncoming{block: predecessor, value: lowered})
            }
        }
    }
    jet_codegen_switch_block(&builder, join_block)
    if incoming.len() == 0 {
        jet_codegen_terminate(&builder, MIRTerminator.Unreachable{reason: "every fallback route diverges"})
        return jet_codegen_emit_value(&builder, expression.span, expression.ty, MIROperation.Never{reason: "unreachable fallback join"})
    }
    jet_codegen_emit_value(&builder, expression.span, expression.ty, MIROperation.Phi{incoming: incoming})
}

// The failure route of `subject ?? fallback` from the current (failure)
// block: binds the ambient `err` of a Result carrier, then lowers the
// fallback. Returns the fallback value when the fallback produces one.
fn jet_codegen_lower_fallback_failure(builder: &JetCodegenBuilder, expression: TExpr, value: MIRValueID, error_type: Type?, fallback: TOrFallback, ambient_err: TLocal?) -> MIRValueID? {
    jet_codegen_enter_lexical(&builder)
    if error_type == .Val(error_ty) {
        error := jet_codegen_emit_value(&builder, expression.span, error_ty, MIROperation.ResultValue{subject: value, ok: false})
        local := ambient_err ?? tir_generated_local("ambient_err", expression.span)
        place := jet_codegen_bind_local(&builder, local, error_ty, false, None, None, false)
        _ := jet_codegen_emit(&builder, expression.span, None, MIROperation.WritePlace{place: place, value: error})
    }
    result := jet_codegen_lower_fallback_route(&builder, expression, fallback)
    jet_codegen_leave_lexical(&builder)
    result
}

// D-MEM-COPYSEM1: `name :: place ?? <diverging fallback>` over a read
// parameter's place. The carrier test reads the place itself and the success
// route names the payload in place, so the binding copies nothing. Returns
// the payload place with lowering continuing on the success route; None
// (nothing emitted) when `subject` is not such a place or the fallback can
// produce a value.
fn jet_codegen_lower_or_fallback_window(builder: &JetCodegenBuilder, expression: TExpr, subject: TExpr, fallback: TOrFallback, ambient_err: TLocal?) -> MIRPlaceID? {
    if fallback == .Value(_) -> return None
    never :: Type.Named{name: "Never"}
    optional := false
    payload_type := never
    error_type := Type?{None}
    if subject.ty == {
        .Option(inner) -> {
            optional = true
            payload_type = inner
        }
        .Result(ok, error) -> {
            payload_type = ok
            error_type = Val(error)
        }
        else -> return None
    }
    if payload_type == never || error_type == (Val(never)) || payload_type != expression.ty -> return None
    value :: jet_codegen_lower_read_window(&builder, subject) ?? return None
    window :: jet_codegen_read_window_of(builder, value) ?? panic("checked read window has no place")
    condition := if {
        optional -> jet_codegen_emit_value(&builder, expression.span, Type.Bool, MIROperation.OptionIsSome{subject: value})
        else -> jet_codegen_emit_value(&builder, expression.span, Type.Bool, MIROperation.ResultIsOk{subject: value})
    }
    success_block := jet_codegen_new_block(&builder, expression.span, "fallback-success")
    failure_block := jet_codegen_new_block(&builder, expression.span, "fallback-failure")
    jet_codegen_terminate(&builder, MIRTerminator.Branch{condition: condition, then_target: success_block, else_target: failure_block})
    jet_codegen_switch_block(&builder, failure_block)
    if jet_codegen_lower_fallback_failure(&builder, expression, value, error_type, fallback, ambient_err) != None -> panic("checked diverging fallback produced a value")
    if jet_codegen_current_is_open(builder) -> jet_codegen_terminate(&builder, MIRTerminator.Unreachable{reason: "diverging fallback"})
    jet_codegen_switch_block(&builder, success_block)
    kind :: if optional -> MIRPayloadKind.Option else -> MIRPayloadKind.Result{ok: true}
    Val(jet_codegen_payload_window_place(&builder, window, kind, payload_type, expression.span))
}

fn jet_codegen_lower_result_handler_arm(builder: &JetCodegenBuilder, expression: TExpr, body: [TStmt], value: TExpr, join: MIRBlockID, incoming: &[MIRPhiIncoming]) {
    jet_codegen_lower_statements(&builder, body)
    result := MIRValueID?{None}
    if jet_codegen_current_is_open(builder) {
        lowered := jet_codegen_lower_expr(&builder, value)
        if jet_codegen_current_is_open(builder) {
            if {
                value.ty == (Type.Named{name: "Never"}) -> {
                    jet_codegen_terminate(&builder, MIRTerminator.Unreachable{reason: "checked Result handler arm diverges"})
                } else -> {
                    result = Val(jet_codegen_fallback_join_value(&builder, expression, value.ty, lowered))
                }
            }
        }
    }
    jet_codegen_leave_lexical(&builder)
    if result != None && jet_codegen_current_is_open(builder) {
        lowered :: result ?? panic("checked Result handler arm lost its value")
        predecessor := builder.current
        jet_codegen_terminate(&builder, MIRTerminator.Jump{target: join})
        &incoming.push(MIRPhiIncoming{block: predecessor, value: lowered})
    }
}

fn jet_codegen_lower_result_handler(builder: &JetCodegenBuilder, expression: TExpr, subject: TExpr, ok_pattern: TPattern, ok_body: [TStmt], ok_value: TExpr, err_pattern: TPattern, err_body: [TStmt], err_value: TExpr, terminal: TExpr) -> MIRValueID {
    subject_value := jet_codegen_lower_expr(&builder, subject)
    ok_block := jet_codegen_new_block(&builder, expression.span, "result-handler-ok")
    err_test_block := jet_codegen_new_block(&builder, expression.span, "result-handler-err-test")
    err_block := jet_codegen_new_block(&builder, expression.span, "result-handler-err")
    terminal_block := jet_codegen_new_block(&builder, expression.span, "result-handler-terminal")
    join_block := jet_codegen_new_block(&builder, expression.span, "result-handler-join")
    incoming := [MIRPhiIncoming]{}

    jet_codegen_enter_lexical(&builder)
    ok_test := jet_codegen_lower_pattern_condition(&builder, ok_pattern, subject, subject_value, true)
    jet_codegen_terminate(&builder, MIRTerminator.Branch{condition: ok_test, then_target: ok_block, else_target: err_test_block})
    jet_codegen_switch_block(&builder, ok_block)
    jet_codegen_lower_result_handler_arm(&builder, expression, ok_body, ok_value, join_block, &incoming)

    jet_codegen_switch_block(&builder, err_test_block)
    jet_codegen_enter_lexical(&builder)
    err_test := jet_codegen_lower_pattern_condition(&builder, err_pattern, subject, subject_value, true)
    jet_codegen_terminate(&builder, MIRTerminator.Branch{condition: err_test, then_target: err_block, else_target: terminal_block})
    jet_codegen_switch_block(&builder, err_block)
    jet_codegen_lower_result_handler_arm(&builder, expression, err_body, err_value, join_block, &incoming)

    jet_codegen_switch_block(&builder, terminal_block)
    jet_codegen_enter_lexical(&builder)
    jet_codegen_lower_result_handler_arm(&builder, expression, [TStmt]{}, terminal, join_block, &incoming)

    jet_codegen_switch_block(&builder, join_block)
    if incoming.len() == 0 {
        jet_codegen_terminate(&builder, MIRTerminator.Unreachable{reason: "every Result handler arm diverges"})
        return jet_codegen_emit_value(&builder, expression.span, expression.ty, MIROperation.Never{reason: "unreachable Result handler join"})
    }
    jet_codegen_emit_value(&builder, expression.span, expression.ty, MIROperation.Phi{incoming: incoming})
}

fn jet_codegen_lower_unreachable(builder: &JetCodegenBuilder, expression: TExpr, line: Int) -> MIRValueID Never! {
    value := jet_codegen_emit_value(&builder, expression.span, Type.Named{name: "Unit"}, MIROperation.Constant{value: MIRConstant.Unit})
    jet_codegen_terminate(&builder, MIRTerminator.Unreachable{reason: "checked exhaustive dispatch at line {line}"})
    value
}

fn jet_codegen_lower_todo(builder: &JetCodegenBuilder, expression: TExpr, line: Int) -> MIRValueID Never! {
    carrier := TFailureCarrier.Diverges{value: Type.Named{name: "Never"}}
    call := jet_codegen_intern_route(&builder, MIRPreludeFamily.StaticPrelude, "core.runtime", "todo", "jet_todo_stop", 3, [Bool]{true, false, true}, Val(Effect.IO), carrier, MIRPreludeABI.Value)
    location := MIRPanicLoc{file: mir_source_file_id(builder.function.source_file), line: line, column: 0}
    expected_type := jet_codegen_lower_type_for_function(expression.ty, builder)
    jet_codegen_emit_value(&builder, expression.span, expression.ty, MIROperation.Todo{call: call, location: location, expected_type: Val(expected_type)})
}

fn jet_codegen_lower_option_lift2(builder: &JetCodegenBuilder, expression: TExpr, function: TExpr, left: TExpr, right: TExpr) -> MIRValueID {
    result_type := if jet_codegen_unwrap_pattern_tags(expression.ty) == {
        .Option(inner) -> inner
        else -> panic("checked Option.lift2 result is not optional")
    }
    left_type := if jet_codegen_unwrap_pattern_tags(left.ty) == {
        .Option(inner) -> inner
        else -> panic("checked Option.lift2 left operand is not optional")
    }
    right_type := if jet_codegen_unwrap_pattern_tags(right.ty) == {
        .Option(inner) -> inner
        else -> panic("checked Option.lift2 right operand is not optional")
    }
    called_type := jet_codegen_callable_return_type(jet_codegen_unwrap_pattern_tags(function.ty))
    callable := jet_codegen_lower_expr(&builder, function)
    left_carrier := jet_codegen_lower_expr(&builder, left)
    right_carrier := jet_codegen_lower_expr(&builder, right)
    left_test := jet_codegen_emit_value(&builder, expression.span, Type.Bool, MIROperation.OptionIsSome{subject: left_carrier})
    left_present := jet_codegen_new_block(&builder, expression.span, "option-lift2-left-present")
    left_absent := jet_codegen_new_block(&builder, expression.span, "option-lift2-left-absent")
    both_present := jet_codegen_new_block(&builder, expression.span, "option-lift2-both-present")
    right_absent := jet_codegen_new_block(&builder, expression.span, "option-lift2-right-absent")
    join := jet_codegen_new_block(&builder, expression.span, "option-lift2-join")
    incoming := [MIRPhiIncoming]{}
    jet_codegen_terminate(&builder, MIRTerminator.Branch{condition: left_test, then_target: left_present, else_target: left_absent})

    jet_codegen_switch_block(&builder, left_present)
    left_value := jet_codegen_emit_value(&builder, expression.span, left_type, MIROperation.OptionValue{subject: left_carrier})
    right_test := jet_codegen_emit_value(&builder, expression.span, Type.Bool, MIROperation.OptionIsSome{subject: right_carrier})
    jet_codegen_terminate(&builder, MIRTerminator.Branch{condition: right_test, then_target: both_present, else_target: right_absent})

    jet_codegen_switch_block(&builder, both_present)
    right_value := jet_codegen_emit_value(&builder, expression.span, right_type, MIROperation.OptionValue{subject: right_carrier})
    args := [MIRCallArg]{jet_codegen_numeric_call_arg(left_value, expression.span), jet_codegen_numeric_call_arg(right_value, expression.span)}
    called := jet_codegen_emit_value(&builder, expression.span, called_type, MIROperation.IndirectCall{callee: callable, args: args, type_args: [MIRType]{}})
    if type_identity_key(called_type) != type_identity_key(result_type) {
        if result_type == {
            .TraitObject(_) -> {
                jet_codegen_require_trait_box_target(result_type, builder)
                target := jet_codegen_lower_type_for_function(result_type, builder)
                target_id :: target.identity ?? panic("checked Option.lift2 trait result has no MIR identity")
                called = jet_codegen_emit_value(&builder, expression.span, result_type, MIROperation.TraitBox{value: called, target: target_id})
            }
            else -> panic("checked Option.lift2 function return disagrees with its result payload")
        }
    }
    present := jet_codegen_emit_value(&builder, expression.span, expression.ty, MIROperation.Present{value: called})
    present_source := builder.current
    jet_codegen_terminate(&builder, MIRTerminator.Jump{target: join})
    &incoming.push(MIRPhiIncoming{block: present_source, value: present})

    jet_codegen_switch_block(&builder, right_absent)
    no_right := jet_codegen_emit_value(&builder, expression.span, expression.ty, MIROperation.Absent)
    right_source := builder.current
    jet_codegen_terminate(&builder, MIRTerminator.Jump{target: join})
    &incoming.push(MIRPhiIncoming{block: right_source, value: no_right})

    jet_codegen_switch_block(&builder, left_absent)
    no_left := jet_codegen_emit_value(&builder, expression.span, expression.ty, MIROperation.Absent)
    left_source := builder.current
    jet_codegen_terminate(&builder, MIRTerminator.Jump{target: join})
    &incoming.push(MIRPhiIncoming{block: left_source, value: no_left})

    jet_codegen_switch_block(&builder, join)
    jet_codegen_emit_value(&builder, expression.span, expression.ty, MIROperation.Phi{incoming: incoming})
}

fn jet_codegen_lower_pattern_probe(builder: &JetCodegenBuilder, expression: TExpr, matched: MIRValueID, probe: TMatchProbe) -> MIRValueID Never! {
    if probe == TMatchProbe.IsSome {
        return jet_codegen_emit_value(&builder, expression.span, Type.Bool, MIROperation.PatternMatched{matched: matched})
    }
    types := if expression.ty == {
        .Tuple(fields) -> fields
        else -> panic("checked pattern captures have no tuple type")
    }
    type_id := jet_codegen_pattern_mir_type_id(builder, expression.ty)
    fields := [MIRFieldValue]{}
    loop (index, field) in types {
        field_id := jet_codegen_pattern_field_id(builder, expression.ty, field.name)
        value := jet_codegen_emit_value(&builder, expression.span, field.ty, MIROperation.PatternCapture{matched: matched, index: index})
        &fields.push(MIRFieldValue{field: field_id, value: value})
    }
    jet_codegen_emit_value(&builder, expression.span, expression.ty, MIROperation.Tuple{type_id: type_id, fields: fields})
}

fn jet_codegen_pattern_scan_route(builder: &JetCodegenBuilder, binary: Bool, result_type: Type) -> MIRPreludeCallID Never! {
    member := if binary -> "binary_match" else -> "text_match"
    symbol := if binary -> "jet_binary_pattern_match" else -> "jet_text_pattern_match"
    jet_codegen_intern_route(&builder, MIRPreludeFamily.StaticPrelude, "core.pattern", member, symbol, 2, [Bool]{true, false}, None, jet_codegen_failure_carrier_for_type(result_type), MIRPreludeABI.Value)
}

fn jet_codegen_lower_string_match_scan(builder: &JetCodegenBuilder, expression: TExpr, subject: TExpr, parts: [StrMatchPart], probe: TMatchProbe) -> MIRValueID {
    subject_value := jet_codegen_lower_expr(&builder, subject)
    pattern := [MIRTextPatternPart]{}
    loop part in parts {
        if part == {
            .Lit(text) -> &pattern.push(MIRTextPatternPart.Literal{value: text})
            .Hole(_, annotation, span) -> {
                ty := annotation ?? Type.String
                &pattern.push(MIRTextPatternPart.Hole{kind: jet_codegen_pattern_text_hole_kind(ty), ty: jet_codegen_pattern_mir_type_id(builder, ty), span: span})
            }
        }
    }
    result_type := Type.Option{inner: Type.Tuple{fields: [TypeTupleField]{}}}
    call := jet_codegen_pattern_scan_route(&builder, false, result_type)
    matched := jet_codegen_emit_value(&builder, expression.span, result_type, MIROperation.Semantic{operation: MIRSemanticOp.TextPatternMatch{call: call, subject: subject_value, parts: pattern}})
    jet_codegen_lower_pattern_probe(&builder, expression, matched, probe)
}

fn jet_codegen_lower_binary_match_scan(builder: &JetCodegenBuilder, expression: TExpr, subject: TExpr, parts: [BinMatchPart], probe: TMatchProbe) -> MIRValueID {
    subject_value := jet_codegen_lower_expr(&builder, subject)
    pattern := [MIRBinaryPatternPart]{}
    loop part in parts {
        if part == {
            .Lit(bytes) -> &pattern.push(MIRBinaryPatternPart.Literal{bytes: bytes})
            .Hole(_, spec, span) -> if spec == {
                .Bits(width, endian) -> {
                    ty := Type.IntN{signed: false, bits: width}
                    &pattern.push(MIRBinaryPatternPart.Bits{width: U8{width}, ty: jet_codegen_pattern_mir_type_id(builder, ty), little: endian == BinEndian.Little, span: span})
                }
                .Rest -> &pattern.push(MIRBinaryPatternPart.Rest{ty: jet_codegen_pattern_mir_type_id(builder, Type.Named{name: "Bytes"}), span: span})
            }
        }
    }
    result_type := Type.Option{inner: Type.Tuple{fields: [TypeTupleField]{}}}
    call := jet_codegen_pattern_scan_route(&builder, true, result_type)
    matched := jet_codegen_emit_value(&builder, expression.span, result_type, MIROperation.Semantic{operation: MIRSemanticOp.BinaryPatternMatch{call: call, subject: subject_value, parts: pattern}})
    jet_codegen_lower_pattern_probe(&builder, expression, matched, probe)
}

fn jet_codegen_lower_env_set(builder: &JetCodegenBuilder, expression: TExpr, name: TExpr, value: TExpr, location: TPanicLoc) -> MIRValueID {
    record :: core_call("core.sys", "set") ?? panic("missing checked Core registry row core.sys.set")
    arguments := [MIRCallArg]{}
    call_values := [TExpr]{name, value}
    loop (index, argument) in call_values {
        lowered := jet_codegen_lower_core_call_arg(&builder, argument, index, record, false)
        borrowed := index < record.signature.borrow_mask.len() && record.signature.borrow_mask[index]
        lowered.access = if borrowed -> MIRAccess.Read else -> MIRAccess.Move
        &arguments.push(lowered)
    }
    error_type := Type.Named{name: "EnvError"}
    result_type := Type.Result{ok: Type.Named{name: "Unit"}, err: error_type}
    carrier := jet_codegen_failure_carrier_for_type(result_type)
    call := jet_codegen_intern_core_call(&builder, record)
    route := jet_codegen_intern_core_route(&builder, record, carrier)
    fallibility := jet_codegen_core_call_fallibility(carrier, builder)
    result := jet_codegen_emit_value(&builder, expression.span, result_type, MIROperation.CoreCall{call: call, route: route, args: arguments, type_args: [MIRType]{}, fallibility: fallibility, data_plan: None})
    condition := jet_codegen_emit_value(&builder, expression.span, Type.Bool, MIROperation.ResultIsOk{subject: result})
    failure := jet_codegen_new_block(&builder, expression.span, "core-sys-set-failure")
    join := jet_codegen_new_block(&builder, expression.span, "core-sys-set-join")
    jet_codegen_terminate(&builder, MIRTerminator.Branch{condition: condition, then_target: join, else_target: failure})
    jet_codegen_switch_block(&builder, failure)
    error := jet_codegen_emit_value(&builder, expression.span, error_type, MIROperation.ResultValue{subject: result, ok: false})
    shown := jet_codegen_lower_string_render(&builder, error, error_type, TStrFormat.Display, expression.span)
    stop_call := jet_codegen_intern_route(&builder, MIRPreludeFamily.StaticPrelude, "core.require", "require", "jet_require", 9, [Bool]{false, true, true, false, true, true, false, false, true}, Val(Effect.Panic), jet_codegen_failure_carrier_for_type(expression.ty), MIRPreludeABI.Control)
    locals := [MIRPanicLocal]{}
    loop local in location.locals {
        binding :: jet_codegen_find_binding_for_local(builder, local.local) ?? next
        &locals.push(MIRPanicLocal{name: local.display_name, local: binding.local})
    }
    panic_location := MIRPanicLoc{file: mir_source_file_id(location.file), line: location.line, column: location.column}
    context := MIRPanicContext{function: builder.function.name, source_line: location.source_line, caret: location.caret, locals: locals}
    jet_codegen_emit_explicit_stop_cleanups(&builder)
    _ := jet_codegen_emit_value(&builder, expression.span, expression.ty, MIROperation.Semantic{operation: MIRSemanticOp.RequireStop{call: stop_call, kind: MIRRequireKind.Require, condition: Val(condition), location: panic_location, context: context, values: [MIRValueID]{shown}, always_stops: true}})
    jet_codegen_terminate(&builder, MIRTerminator.Unreachable{reason: "environment update failure"})
    jet_codegen_switch_block(&builder, join)
    jet_codegen_emit_value(&builder, expression.span, expression.ty, MIROperation.Constant{value: MIRConstant.Unit})
}

fn jet_codegen_gc_local_type(builder: JetCodegenBuilder, local: TLocal) -> Type Never! {
    if jet_codegen_find_binding_for_local(builder, local) == .Val(binding) -> return binding.ty
    local.persist_ty ?? panic("checked MIR GC root has no type")
}

fn jet_codegen_lower_gc_local(builder: &JetCodegenBuilder, local: TLocal, span: Span) -> MIRValueID {
    ty := jet_codegen_gc_local_type(builder, local)
    jet_codegen_lower_expr(&builder, TExpr{ty: ty, kind: TExprKind.Local{local: local}, span: span, integer_bounds: None, cost: None})
}

fn jet_codegen_gc_edit_kind(kind: TGCEditKind) -> MIRGCEditKind Never! {
    if kind == {
        .Clear -> MIRGCEditKind.Clear
        .Pop -> MIRGCEditKind.Pop
        .RemoveIndex -> MIRGCEditKind.RemoveIndex
        .InsertIndex -> MIRGCEditKind.InsertIndex
        .Prepend -> MIRGCEditKind.Prepend
        .Additive -> MIRGCEditKind.Additive
        .Plain -> MIRGCEditKind.Plain
        .EdgeSlot -> MIRGCEditKind.EdgeSlot
    }
}

fn jet_codegen_gc_edit_route(builder: &JetCodegenBuilder, kind: TGCEditKind, result_type: Type) -> MIRPreludeCallID Never! {
    member := if kind == {
        .Clear -> "edit_clear"
        .Pop -> "edit_pop"
        .RemoveIndex -> "edit_remove_index"
        .InsertIndex -> "edit_insert_index"
        .Prepend -> "edit_prepend"
        .Additive -> "edit_additive"
        .Plain -> "edit_plain"
        .EdgeSlot -> "edit_edge_slot"
    }
    mask := if kind == {
        .Clear | .Pop | .Plain -> [Bool]{true, false}
        .RemoveIndex -> [Bool]{true, false, false}
        .InsertIndex -> [Bool]{true, false, true, false}
        .Prepend | .Additive -> [Bool]{true, true, false}
        .EdgeSlot -> [Bool]{true, true, false, false}
    }
    jet_codegen_intern_route(&builder, MIRPreludeFamily.StaticPrelude, "core.gc", member, "jet_gc_{member}", mask.len(), mask, Val(Effect.Mem), jet_codegen_failure_carrier_for_type(result_type), MIRPreludeABI.Value)
}

fn jet_codegen_gc_edit_callback(builder: JetCodegenBuilder, edit: TExpr, root_type: Type, span: Span) -> TLambda Never! {
    parameter := tir_generated_local("value", span)
    owner_key := "{builder.function.key}::gc-edit@{span.start}..{span.end}"
    parameter_symbol := symbol_id(SymbolKind.Parameter, builder.function.module_identity, owner_key, parameter.name)
    TLambda{
        executable: TLambdaBody.Expr{value: edit},
        source_span: span,
        frame_schedule: None,
        frame_schedule_derivation: None,
        capture_facts: TCaptureFacts{escapes: false, needs_fn_mut: false, mutable: [String]{}, cloned: [String]{}, frozen: [String]{}, materialized: [String]{}, moved: [String]{}},
        failure_carrier: jet_codegen_failure_carrier_for_type(edit.ty),
        effects: TEffectFacts{direct: [String]{}, solved: [String]{}, call_edges: [String]{}, maximal: false, direct_spans: [TEffectSpan]{}},
        host_param_conventions: None,
        source_params: [String]{parameter.name},
        source_param_symbols: [SymbolID]{parameter_symbol},
        jit_name: "gc_edit_{span.start}_{span.end}",
        param_types: [Type]{root_type},
        ret: if type_is_unit_callable_return(edit.ty) -> None else -> Val(edit.ty),
        is_move: true,
        boxed: false,
        rc: false,
        arc: false,
        captures: [TCapture]{},
        materialized_captures: [String]{},
        frozen_captures: [String]{},
        uses_stack_sentry: false,
    }
}

fn jet_codegen_lower_gc_edit(builder: &JetCodegenBuilder, expression: TExpr, root: TLocal, edges: [TLocal], edit: TExpr, index_temp: TExpr?, kind: TGCEditKind) -> MIRValueID {
    root_type := jet_codegen_gc_local_type(builder, root)
    root_value := jet_codegen_lower_gc_local(&builder, root, expression.span)
    edge_values := [MIRValueID]{}
    loop edge in edges -> &edge_values.push(jet_codegen_lower_gc_local(&builder, edge, expression.span))
    callback := jet_codegen_gc_edit_callback(builder, edit, root_type, expression.span)
    edit_value := jet_codegen_lower_lambda(&builder, callback, false, "gc-edit").value
    index := MIRValueID?{None}
    if index_temp == .Val(value) -> index = Val(jet_codegen_lower_expr(&builder, value))
    call := jet_codegen_gc_edit_route(&builder, kind, expression.ty)
    site_key := "{builder.function.key}|{builder.function.source_file}|{expression.span.start}|{expression.span.end}"
    site := MIRGCEditSiteID{value: stable_id("gc-edit-site", site_key)}
    jet_codegen_emit_value(&builder, expression.span, expression.ty, MIROperation.Semantic{operation: MIRSemanticOp.GCEdit{call: call, root: root_value, edges: edge_values, edit: edit_value, index: index, kind: jet_codegen_gc_edit_kind(kind), site: site}})
}

fn jet_codegen_lower_range_switch(builder: &JetCodegenBuilder, subject: TExpr, arms: [TRangeArm], else_body: [TStmt], span: Span) {
    subject_value := jet_codegen_lower_expr(&builder, subject)
    join := jet_codegen_new_block(&builder, span, "range-switch-join")
    otherwise := jet_codegen_new_block(&builder, span, "range-switch-otherwise")
    has_join_edge := false
    loop (index, arm) in arms {
        body_block := jet_codegen_new_block(&builder, span, "range-switch-body-{index}")
        next_block := if index + 1 < arms.len() -> jet_codegen_new_block(&builder, span, "range-switch-test-{index + 1}") else -> otherwise
        condition := jet_codegen_lower_numeric_pattern_range(&builder, subject_value, Type.Int, arm.lo, arm.hi, span)
        jet_codegen_terminate(&builder, MIRTerminator.Branch{condition: condition, then_target: body_block, else_target: next_block})
        jet_codegen_switch_block(&builder, body_block)
        jet_codegen_lower_block(&builder, arm.body)
        if jet_codegen_current_is_open(builder) {
            has_join_edge = true
            jet_codegen_terminate(&builder, MIRTerminator.Jump{target: join})
        }
        jet_codegen_switch_block(&builder, next_block)
    }
    if arms.len() == 0 -> jet_codegen_terminate(&builder, MIRTerminator.Jump{target: otherwise})
    jet_codegen_switch_block(&builder, otherwise)
    jet_codegen_lower_block(&builder, else_body)
    if jet_codegen_current_is_open(builder) {
        has_join_edge = true
        jet_codegen_terminate(&builder, MIRTerminator.Jump{target: join})
    }
    jet_codegen_switch_block(&builder, join)
    if !has_join_edge -> jet_codegen_terminate(&builder, MIRTerminator.Unreachable{reason: "all range-switch paths terminate"})
}

fn jet_codegen_lower_mixed_switch(builder: &JetCodegenBuilder, subject: TExpr, arms: [TMixedArm], else_body: [TStmt]?, span: Span) {
    subject_value := jet_codegen_lower_expr(&builder, subject)
    saved_subject := builder.switch_subject
    current_subject := Val(JetCodegenSwitchSubject{value: subject_value, ty: subject.ty})
    join := jet_codegen_new_block(&builder, span, "mixed-switch-join")
    otherwise := jet_codegen_new_block(&builder, span, "mixed-switch-otherwise")
    has_join_edge := false
    loop (index, arm) in arms {
        body_block := jet_codegen_new_block(&builder, span, "mixed-switch-body-{index}")
        next_block := if index + 1 < arms.len() -> jet_codegen_new_block(&builder, span, "mixed-switch-test-{index + 1}") else -> otherwise
        builder.switch_subject = current_subject
        condition := jet_codegen_lower_expr(&builder, arm.condition)
        builder.switch_subject = saved_subject
        jet_codegen_terminate(&builder, MIRTerminator.Branch{condition: condition, then_target: body_block, else_target: next_block})
        jet_codegen_switch_block(&builder, body_block)
        builder.switch_subject = current_subject
        jet_codegen_lower_block(&builder, arm.body)
        builder.switch_subject = saved_subject
        if jet_codegen_current_is_open(builder) {
            has_join_edge = true
            jet_codegen_terminate(&builder, MIRTerminator.Jump{target: join})
        }
        jet_codegen_switch_block(&builder, next_block)
    }
    if arms.len() == 0 -> jet_codegen_terminate(&builder, MIRTerminator.Jump{target: otherwise})
    jet_codegen_switch_block(&builder, otherwise)
    if else_body == .Val(body) -> jet_codegen_lower_block(&builder, body)
    if jet_codegen_current_is_open(builder) {
        has_join_edge = true
        jet_codegen_terminate(&builder, MIRTerminator.Jump{target: join})
    }
    jet_codegen_switch_block(&builder, join)
    if !has_join_edge -> jet_codegen_terminate(&builder, MIRTerminator.Unreachable{reason: "all mixed-switch paths terminate"})
}

fn jet_codegen_lower_switch_subject(builder: &JetCodegenBuilder, expression: TExpr, field: String?) -> MIRValueID Never! {
    subject :: builder.switch_subject ?? panic("checked switch subject is not available")
    subject_value := subject.value
    if field == .Val(name) {
        field_id := jet_codegen_pattern_field_id(builder, subject.ty, name)
        return jet_codegen_emit_value(&builder, expression.span, expression.ty, MIROperation.Field{base: subject_value, field: field_id})
    }
    subject_value
}

fn jet_codegen_lower_require_stop(builder: &JetCodegenBuilder, expression: TExpr, kind: TRequireKind, always_stops: Bool, location: TPanicLoc) -> MIRValueID {
    operation := MIRRequireKind.Require
    condition := MIRValueID?{None}
    values := [MIRValueID]{}
    member := "require"
    symbol := "jet_require"
    mask := [Bool]{false, true, true, false, true, true, false, false, true}
    if kind == {
        .Require(test, message) -> {
            condition = Val(jet_codegen_lower_expr(&builder, test))
            if message == .Val(value) -> &values.push(jet_codegen_lower_expr(&builder, value))
        }
        .RequireEq(left, right) -> {
            if left.ty != right.ty -> panic("require_eq operands have different checked types")
            left_value := jet_codegen_lower_expr(&builder, left)
            right_value := jet_codegen_lower_expr(&builder, right)
            equality_call := jet_codegen_intern_route(&builder, MIRPreludeFamily.BuiltinMethod, "core.compare", "eq", "jet_eq", 2, [Bool]{true, true}, None, TFailureCarrier.Infallible, MIRPreludeABI.Value)
            args := [MIRCallArg]{jet_codegen_numeric_call_arg(left_value, expression.span), jet_codegen_numeric_call_arg(right_value, expression.span)}
            condition = Val(jet_codegen_emit_value(&builder, expression.span, Type.Bool, MIROperation.Semantic{operation: MIRSemanticOp.StaticPreludeCall{call: equality_call, args: args, owner_type_args: [MIRPreludeTypeArg]{}, type_args: [MIRType]{}}}))
            &values.push(left_value)
            &values.push(right_value)
            operation = MIRRequireKind.RequireEq
            member = "require_eq"
            symbol = "jet_require_eq"
            mask = [Bool]{false, true, true, true, false, true, true, false, false, true}
        }
        .Panic(message) -> {
            operation = MIRRequireKind.Panic
            member = "panic"
            symbol = "jet_panic_rich"
            mask = [Bool]{true, false, true, true, false, false, true, true}
            &values.push(jet_codegen_lower_expr(&builder, message))
        }
    }
    call := jet_codegen_intern_route(&builder, MIRPreludeFamily.StaticPrelude, "core.require", member, symbol, mask.len(), mask, Val(Effect.Panic), jet_codegen_failure_carrier_for_type(expression.ty), MIRPreludeABI.Control)
    locals := [MIRPanicLocal]{}
    loop local in location.locals {
        binding :: jet_codegen_find_binding_for_local(builder, local.local) ?? next
        &locals.push(MIRPanicLocal{name: local.display_name, local: binding.local})
    }
    panic_location := MIRPanicLoc{file: mir_source_file_id(location.file), line: location.line, column: location.column}
    // The enclosing function names the report (Rust `capture_panic_loc`
    // `fn_name`); checked TIR locations do not carry it.
    context := MIRPanicContext{function: builder.function.name, source_line: location.source_line, caret: location.caret, locals: locals}
    if condition == .Val(condition_value) && !always_stops {
        return jet_codegen_lower_conditional_stop(&builder, expression.span, expression.ty, call, operation, condition_value, panic_location, context, values, "require-stop")
    }
    jet_codegen_emit_explicit_stop_cleanups(&builder)
    result := jet_codegen_emit_value(&builder, expression.span, expression.ty, MIROperation.Semantic{operation: MIRSemanticOp.RequireStop{call: call, kind: operation, condition: condition, location: panic_location, context: context, values: values, always_stops: always_stops}})
    if always_stops -> jet_codegen_terminate(&builder, MIRTerminator.Unreachable{reason: "checked unconditional stop"})
    result
}

fn jet_codegen_lower_split_view(builder: &JetCodegenBuilder, owner: TExpr?, root: String, name: String, start: Int, end: Int, single: Bool, write: Bool, element: Type?, line: Int, span: Span) {
    element_type :: element ?? panic("checked split view `{name}` has no element type")
    root_expr := TExpr{ty: Type.List{element: element_type}, kind: TExprKind.Local{local: tir_user_local(root, span)}, span: span, integer_bounds: None, cost: None}
    base := owner ?? root_expr
    start_expr := TExpr{ty: Type.Int, kind: TExprKind.IntLit{value: start, width: None}, span: span, integer_bounds: None, cost: None}
    end_expr := TExpr{ty: Type.Int, kind: TExprKind.IntLit{value: end, width: None}, span: span, integer_bounds: None, cost: None}
    local := tir_user_local(name, span)
    local.mutable = write
    location := jet_codegen_assignment_panic_location(&builder, span, false)
    location.line = line
    if single && write {
        place := jet_codegen_index_place(&builder, base, start_expr, TIndexKind.FixedListProof, element_type, MIRAccess.Write, location, span)
        _ := jet_codegen_bind_local_alias(&builder, local, element_type, place, true)
        return
    }
    ty := if single -> element_type else -> Type.Apply{name: if write -> "ViewMut" else -> "View", args: [Type]{element_type}}
    value := if {
        single -> {
            place := jet_codegen_index_place(&builder, base, start_expr, TIndexKind.FixedListProof, element_type, MIRAccess.Read, location, span)
            jet_codegen_emit_value(&builder, span, element_type, MIROperation.ReadPlace{place: place})
        } else -> {
            range := TExpr{ty: Type.Named{name: "Range"}, kind: TExprKind.Range{start: start_expr, end: end_expr, exclusive: false}, span: span, integer_bounds: None, cost: None}
            operation := if write -> TBuiltinOp.ViewMutNew{line: line} else -> TBuiltinOp.ViewNew{line: line}
            view := TExpr{ty: ty, kind: TExprKind.BuiltinMethod{receiver: base, operation: operation, args: [TExpr]{range}}, span: span, integer_bounds: None, cost: None}
            jet_codegen_lower_expr(&builder, view)
        }
    }
    place := jet_codegen_bind_local(&builder, local, ty, write, None, None, false)
    _ := jet_codegen_emit(&builder, span, None, MIROperation.WritePlace{place: place, value: value})
}
