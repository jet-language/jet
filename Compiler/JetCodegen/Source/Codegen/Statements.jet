fn jet_codegen_lower_range_loop(builder: &JetCodegenBuilder, label: String?, local: TLocal, source: TExpr?, start: TExpr, end: TExpr, step: TExpr?, exclusive: Bool, vectorization: AutoVectorizationFacts?, body: [TStmt], span: Span) {
    if source == {
        None -> jet_codegen_lower_numeric_range_loop(&builder, label, local, start, end, step, exclusive, vectorization, body, span)
        Val(collection) -> jet_codegen_lower_iter_range_loop(&builder, label, local, collection, start.ty, step, vectorization, body, span)
    }
}


fn jet_codegen_assignment_place_type(builder: JetCodegenBuilder, place: TPlace) -> Type Never! {
    if place == {
        .Local(local) -> {
            found :: jet_codegen_find_binding_for_local(builder, local)
            if found == .Val(binding_value) -> return binding_value.ty
            local.persist_ty ?? panic("checked assignment place has no MIR local type")
        }
        .Expr(value) -> value.ty
    }
}

fn jet_codegen_assignment_destination_is_string_view(builder: JetCodegenBuilder, place: TPlace) -> Bool Never! {
    if place == {
        .Local(local) -> return jet_codegen_is_string_view_local(builder, local)
        .Expr(place_value) -> return if place_value.kind == {
            .Local(local) -> jet_codegen_is_string_view_local(builder, local)
            else -> false
        }
    }
}

fn jet_codegen_assignment_value(builder: &JetCodegenBuilder, value: TExpr, clone_value: Bool, destination_is_view: Bool, span: Span) -> MIRValueID {
    lowered := jet_codegen_lower_expr(&builder, value)
    if !clone_value -> return lowered
    fact := MIRCopyFact.Materialize
    if jet_codegen_is_string_view_value(builder, value) && !destination_is_view -> fact = MIRCopyFact.ViewMaterialize
    jet_codegen_emit_value(&builder, span, value.ty, MIROperation.Copy{value: lowered, fact: fact})
}

fn jet_codegen_lower_index_assign(builder: &JetCodegenBuilder, uninit: Bool, base: TExpr, index: TExpr, is_map: Bool, value: TExpr, span: Span) {
    right := jet_codegen_lower_expr(&builder, value)
    kind := if {
        uninit -> MIRIndexKind.FixedListProof
        is_map -> MIRIndexKind.Map
        else -> MIRIndexKind.List
    }
    tir_kind := if {
        kind == MIRIndexKind.FixedListProof -> TIndexKind.FixedListProof
        kind == MIRIndexKind.Map -> TIndexKind.Map
        else -> TIndexKind.List
    }
    result_type := jet_codegen_index_element_type(base.ty, kind)
    location := jet_codegen_assignment_panic_location(&builder, span, kind == MIRIndexKind.Map)
    place := jet_codegen_index_place(&builder, base, index, tir_kind, result_type, MIRAccess.Write, location, span)
    _ := jet_codegen_emit(&builder, span, None, MIROperation.WritePlace{place: place, value: right})
}

// Rust: crates/jet-codegen/src/Codegen/TIR/mir.rs::LowerCtx::is_core_file_owner
fn jet_codegen_is_core_file_owner_type(builder: JetCodegenBuilder, ty: Type) -> Bool Never! {
    name := if ty == {
        .Named(value) | .Apply(value, _) -> value
        else -> { return false }
    }
    is_file_owner_name := name == "FileReader" || name == "FileWriter" || name == "TempDir" || name == "TempFile" || name == "FileLock"
    if !is_file_owner_name {
        is_file_owner_name = name.ends_with("::FileReader") || name.ends_with("::FileWriter") || name.ends_with("::TempDir") ||
            name.ends_with("::TempFile") || name.ends_with("::FileLock")
    }
    if !is_file_owner_name -> return false
    identity := jet_codegen_find_nominal_identity(builder.modules, builder.function.module_identity, name, builder.generic_type_names)
    if identity == None -> return false
    owner :: identity ?? return false
    module_index :: builder.owners.hooks.module_positions.get(owner.module_identity) ?? return false
    builder.modules[module_index].module_name == "core.files"
}

fn jet_codegen_is_shared_guard_mir_type(ty: MIRType) -> Bool Never! {
    if ty.kind == {
        .Tagged(_, inner) -> jet_codegen_is_shared_guard_mir_type(inner)
        .Apply(name, _) -> name.name == "SharedGuard" || name.name.ends_with("::SharedGuard")
        else -> false
    }
}

fn jet_codegen_drop_temporary_shared_guard(builder: &JetCodegenBuilder, place: MIRPlaceID, span: Span) Never! {
    row := jet_codegen_find_place(builder, place)
    if row == None -> return
    place_row :: row ?? return
    if place_row.base == {
        .Temporary(value) -> {
            loop fact in builder.values {
                if fact.id == value {
                    if jet_codegen_is_shared_guard_mir_type(fact.ty) && fact.ownership.drop != MIRDropKind.NoDrop {
                        _ := jet_codegen_emit(&builder, span, None, MIROperation.Drop{value: value, kind: fact.ownership.drop})
                    }
                    return
                }
            }
        }
        else -> return
    }
}

fn jet_codegen_lower_index_field_assign(builder: &JetCodegenBuilder, assign: TIndexFieldAssign, span: Span) {
    right := jet_codegen_assignment_value(&builder, assign.value, assign.clone_value, false, span)
    kind := if assign.is_map -> MIRIndexKind.Map else -> MIRIndexKind.List
    tir_kind := if assign.is_map -> TIndexKind.Map else -> TIndexKind.List
    element_type := jet_codegen_index_element_type(assign.base.ty, kind)
    location := jet_codegen_assignment_panic_location(&builder, span, assign.is_map)
    base_place := jet_codegen_index_place(&builder, assign.base, assign.index, tir_kind, element_type, MIRAccess.Write, location, span)
    resolved := jet_codegen_resolve_field_by_name(builder.modules, builder.function.module_identity, builder.generic_type_names, element_type, assign.field)
    place := jet_codegen_project_field_place(&builder, base_place, span, assign.field_ty, jet_codegen_mir_field_id(resolved))
    assigned := if assign.op == {
        None -> right
        Val(operation) -> {
            old := jet_codegen_emit_value(&builder, span, assign.field_ty, MIROperation.ReadPlace{place: place})
            overflow := jet_codegen_assignment_overflow(operation, assign.field_ty, assign.value.ty)
            dispatch := jet_codegen_binary_dispatch(&builder, operation, overflow, assign.field_ty, span, assign.line)
            mir_overflow := MIRBinaryOverflow.Unchecked
            if overflow && jet_codegen_fixed_width(assign.field_ty) != None -> mir_overflow = MIRBinaryOverflow.Trap
            jet_codegen_emit_value(&builder, span, assign.field_ty, MIROperation.Binary{op: jet_codegen_lower_binary(operation), dispatch: dispatch, overflow: mir_overflow, left: old, right: right})
        }
    }
    // Native deferred File cleanup tracks record/tuple roots, not container contents.
    owning_file_slot := jet_codegen_is_core_file_owner_type(builder, assign.field_ty)
    if {
        owning_file_slot -> {
            _ := jet_codegen_emit(&builder, span, None, MIROperation.ReplacePlace{place: place, value: assigned})
        } else -> {
            _ := jet_codegen_emit(&builder, span, None, MIROperation.WritePlace{place: place, value: assigned})
        }
    }
    jet_codegen_drop_temporary_shared_guard(&builder, place, span)
}

fn jet_codegen_lower_math_swizzle_assign(builder: &JetCodegenBuilder, base: TExpr, lanes: [Int], value: TExpr, clone_value: Bool, span: Span) {
    if lanes.len() == 0 -> panic("checked swizzle assignment has no lanes")
    right := jet_codegen_lower_expr(&builder, value)
    right_values := [MIRValueID]{}
    right_type := value.ty
    if {
        lanes.len() > 1 -> {
            right_type_name := if value.ty == {
                .Named(name) -> name
                else -> panic("checked multi-lane swizzle assignment has no vector RHS")
            }
            scalar_ty := jet_codegen_math_scalar_type(right_type_name)
            carrier := jet_codegen_failure_carrier_for_type(scalar_ty)
            source := jet_codegen_source_location_at(&builder, span, true)
            source_line := source.source_line ?? panic("checked swizzle source line disappeared")
            location := MIRPanicLoc{file: mir_source_file_id(builder.function.source_file), line: source.line, column: 0}
            context := MIRPanicContext{function: builder.function.name, source_line: source_line, caret: 0, locals: [MIRPanicLocal]{}}
            call := jet_codegen_lane_index_route(&builder, right_type_name, scalar_ty, carrier)
            ordinal := 0
            loop ordinal < lanes.len() {
                lane_index := jet_codegen_emit_value(&builder, span, Type.Int, MIROperation.Constant{value: MIRConstant.Int{value: ordinal, width: None, spelling: None}})
                &right_values.push(jet_codegen_emit_value(&builder, span, scalar_ty, MIROperation.Index{call: call, base: right, index: lane_index, kind: MIRIndexKind.Lane, access: MIRAccess.Read, location: location, context: context}))
                ordinal += 1
            }
            right_type = scalar_ty
        } else -> {
            &right_values.push(right)
        }
    }
    places := jet_codegen_swizzle_places(&builder, base, lanes, MIRAccess.Write, span)
    index := 0
    loop index < places.len() {
        lane_value := right_values[index]
        if clone_value || index + 1 < lanes.len() -> lane_value = jet_codegen_emit_value(&builder, span, right_type, MIROperation.Copy{value: lane_value, fact: MIRCopyFact.Materialize})
        _ := jet_codegen_emit(&builder, span, None, MIROperation.WritePlace{place: places[index], value: lane_value})
        index += 1
    }
}


// Scalar row chains retain catalog order and duplicate candidates without
// copying owning nominal, impl, or trait declaration records at each query.
pub struct JetCodegenHookNominalRow {
    pub module_index: Int
    pub nominal_index: Int
    pub next_owner: Int
    pub next_trait: Int
}

pub struct JetCodegenHookImplMethodRow {
    pub module_index: Int
    pub implementation_index: Int
    pub method_index: Int
    pub next_exact: Int
    pub next_fallback: Int
}

pub struct JetCodegenHookTraitMethodRow {
    pub module_index: Int
    pub definition_index: Int
    pub method_index: Int
    pub next: Int
}

pub struct JetCodegenHookIndex {
    pub module_positions: [String:Int]
    pub nominal_rows: [JetCodegenHookNominalRow]
    pub nominal_by_owner: [String:Int]
    pub traits_by_name: [String:Int]
    pub implementation_rows: [JetCodegenHookImplMethodRow]
    pub exact_methods: [String:Int]
    pub fallback_methods: [String:Int]
    pub trait_method_rows: [JetCodegenHookTraitMethodRow]
    pub trait_methods: [String:Int]
}

// Rust: none (Jet-only pass)
fn jet_codegen_hook_method_key(owner: String, trait_name: String, method_name: String) -> String Never! {
    jet_codegen_qualified_function_key(owner, jet_codegen_qualified_function_key(trait_name, method_name))
}

// Rust: none (Jet-only pass)
fn jet_codegen_hook_index(modules: [SemaGraphModuleResult]) -> JetCodegenHookIndex Never! {
    module_positions := [String:Int]{}
    nominal_rows := [JetCodegenHookNominalRow]{}
    nominal_by_owner := [String:Int]{}
    traits_by_name := [String:Int]{}
    implementation_rows := [JetCodegenHookImplMethodRow]{}
    exact_methods := [String:Int]{}
    fallback_methods := [String:Int]{}
    trait_method_rows := [JetCodegenHookTraitMethodRow]{}
    trait_methods := [String:Int]{}
    module_index := modules.len() - 1
    loop module_index >= 0 {
        module_identity :: modules[module_index].module_identity
        module_positions[module_identity] = module_index
        nominal_index := modules[module_index].nominals.len() - 1
        loop nominal_index >= 0 {
            name :: modules[module_index].nominals[nominal_index].symbol.name
            owner_key :: jet_codegen_qualified_function_key(module_identity, name)
            is_trait := modules[module_index].nominals[nominal_index].kind == SemaRegistrationNominalKind.Trait
            row := nominal_rows.len()
            &nominal_rows.push(JetCodegenHookNominalRow{
                module_index: module_index,
                nominal_index: nominal_index,
                next_owner: nominal_by_owner.get(owner_key) ?? -1,
                next_trait: if is_trait -> traits_by_name.get(name) ?? -1 else -> -1,
            })
            nominal_by_owner[owner_key] = row
            if is_trait -> traits_by_name[name] = row
            nominal_index -= 1
        }
        implementation_index := modules[module_index].impls.len() - 1
        loop implementation_index >= 0 {
            if modules[module_index].impls[implementation_index].trait_symbol == .Val(trait_symbol) {
                method_index := modules[module_index].impls[implementation_index].methods.len() - 1
                loop method_index >= 0 {
                    method_name :: modules[module_index].impls[implementation_index].methods[method_index].symbol.name
                    exact_key :: jet_codegen_hook_method_key(modules[module_index].impls[implementation_index].target_identity_key, trait_symbol.name, method_name)
                    fallback_key := String?{None}
                    if modules[module_index].impls[implementation_index].target_module_identity == .Val(target_module) {
                        owner_key :: jet_codegen_qualified_function_key(target_module, modules[module_index].impls[implementation_index].target_type_name)
                        fallback_key = Val(jet_codegen_hook_method_key(owner_key, trait_symbol.name, method_name))
                    }
                    row := implementation_rows.len()
                    &implementation_rows.push(JetCodegenHookImplMethodRow{
                        module_index: module_index,
                        implementation_index: implementation_index,
                        method_index: method_index,
                        next_exact: exact_methods.get(exact_key) ?? -1,
                        next_fallback: if fallback_key == .Val(key) -> fallback_methods.get(key) ?? -1 else -> -1,
                    })
                    exact_methods[exact_key] = row
                    if fallback_key == .Val(key) -> fallback_methods[key] = row
                    method_index -= 1
                }
            }
            implementation_index -= 1
        }
        definition_index := modules[module_index].declarations.traits.len() - 1
        loop definition_index >= 0 {
            trait_name :: modules[module_index].declarations.traits[definition_index].name
            method_index := modules[module_index].declarations.traits[definition_index].methods.len() - 1
            loop method_index >= 0 {
                method_name :: modules[module_index].declarations.traits[definition_index].methods[method_index].name
                key :: jet_codegen_hook_method_key("{module_index}", trait_name, method_name)
                row := trait_method_rows.len()
                &trait_method_rows.push(JetCodegenHookTraitMethodRow{
                    module_index: module_index,
                    definition_index: definition_index,
                    method_index: method_index,
                    next: trait_methods.get(key) ?? -1,
                })
                trait_methods[key] = row
                method_index -= 1
            }
            definition_index -= 1
        }
        module_index -= 1
    }
    JetCodegenHookIndex{
        module_positions: module_positions,
        nominal_rows: nominal_rows,
        nominal_by_owner: nominal_by_owner,
        traits_by_name: traits_by_name,
        implementation_rows: implementation_rows,
        exact_methods: exact_methods,
        fallback_methods: fallback_methods,
        trait_method_rows: trait_method_rows,
        trait_methods: trait_methods,
    }
}

struct JetCodegenIndexHookTraitMethod {
    pub symbol: SymbolID
    pub trait_key: String
    pub method: TTraitMethod
}

fn jet_codegen_index_hook_owner_name(ty: Type) -> String? {
    if ty == {
        .Named(name) | .Apply(name, _) -> return Val(name)
        .Tagged(_, inner) -> return jet_codegen_index_hook_owner_name(inner)
        .TraitObject(_) -> return None
        else -> return None
    }
}

// Rust: crates/jet-codegen/src/Codegen/TIR/tir_to_mir_expr.rs::lower_index_hook
fn jet_codegen_index_hook_function(builder: JetCodegenBuilder, owner_type: Type, trait_name: String, method_name: String) -> TFunc? {
    owner_name_option := jet_codegen_index_hook_owner_name(owner_type)
    if owner_name_option == None -> return None
    owner_name :: owner_name_option ?? return None
    if builder.generic_type_names.contains(owner_name) -> return None
    owner_identity_option := jet_codegen_find_nominal_identity(builder.modules, builder.function.module_identity, owner_name, builder.generic_type_names)
    if owner_identity_option == None -> return None
    owner_identity :: owner_identity_option ?? return None
    owner_key :: jet_codegen_qualified_function_key(owner_identity.module_identity, owner_identity.name)
    owner_row :: builder.owners.hooks.nominal_by_owner.get(owner_key) ?? panic("checked {trait_name} receiver identity disappeared")
    if builder.owners.hooks.nominal_rows[owner_row].next_owner >= 0 -> panic("ambiguous checked {trait_name} receiver identity")
    module_index :: builder.owners.hooks.nominal_rows[owner_row].module_index
    nominal_index :: builder.owners.hooks.nominal_rows[owner_row].nominal_index
    target_identity_key :: builder.modules[module_index].nominals[nominal_index].identity_key
    exact_method_key := String?{None}
    fallback_method_key := String?{None}
    exact_key :: jet_codegen_hook_method_key(target_identity_key, trait_name, method_name)
    row := builder.owners.hooks.exact_methods.get(exact_key) ?? -1
    loop row >= 0 {
        if exact_method_key != None -> panic("ambiguous checked {trait_name}::{method_name} implementation")
        candidate :: builder.owners.hooks.implementation_rows[row]
        exact_method_key = Val(builder.modules[candidate.module_index].impls[candidate.implementation_index].methods[candidate.method_index].symbol.id.key)
        row = candidate.next_exact
    }
    fallback_key :: jet_codegen_hook_method_key(owner_key, trait_name, method_name)
    row = builder.owners.hooks.fallback_methods.get(fallback_key) ?? -1
    loop row >= 0 {
        candidate :: builder.owners.hooks.implementation_rows[row]
        if builder.modules[candidate.module_index].impls[candidate.implementation_index].target_identity_key != target_identity_key {
            if fallback_method_key != None -> panic("ambiguous checked {trait_name}::{method_name} implementation")
            fallback_method_key = Val(builder.modules[candidate.module_index].impls[candidate.implementation_index].methods[candidate.method_index].symbol.id.key)
        }
        row = candidate.next_fallback
    }
    method_key :: exact_method_key ?? (fallback_method_key ?? panic("checked {trait_name} receiver has no registered {method_name} implementation"))
    Val(jet_codegen_find_function(builder.function_index, method_key) ?? panic("checked {trait_name}::{method_name} function is not reachable"))
}

// Rust: crates/jet-codegen/src/Codegen/TIR/mir.rs::LowerCtx::trait_method_identity
fn jet_codegen_index_hook_trait_method(builder: JetCodegenBuilder, owner_type: Type, required_symbol: SymbolID?, trait_name: String, method_name: String) -> JetCodegenIndexHookTraitMethod Never! {
    owner_name := jet_codegen_index_hook_owner_name(owner_type) ?? ""
    concrete_owner := owner_name != "" && !builder.generic_type_names.contains(owner_name)
    trait_object_bound := false
    if owner_type == {
        .TraitObject(bounds) -> trait_object_bound = bounds.contains(trait_name)
        else -> {}
    }
    bound_symbols := [String]{}
    loop parameter in builder.function.generic_params {
        if parameter.name == owner_name {
            loop bound in parameter.bounds -> &bound_symbols.push(bound.key)
        }
    }
    required_key := ""
    if required_symbol != None {
        symbol :: required_symbol
        required_key = symbol.key
    }
    selected := JetCodegenIndexHookTraitMethod?{None}
    row := builder.owners.hooks.traits_by_name.get(trait_name) ?? -1
    loop row >= 0 {
        candidate :: builder.owners.hooks.nominal_rows[row]
        row = candidate.next_trait
        symbol :: builder.modules[candidate.module_index].nominals[candidate.nominal_index].symbol.id
        if {
            required_symbol != None -> {
                if symbol.key != required_key -> next
            }
            !trait_object_bound && !concrete_owner && !bound_symbols.contains(symbol.key) -> {
                next
            }
        }
        key :: jet_codegen_hook_method_key("{candidate.module_index}", trait_name, method_name)
        method_row := builder.owners.hooks.trait_methods.get(key) ?? -1
        loop method_row >= 0 {
            if selected != None -> panic("ambiguous checked {trait_name}::{method_name} trait identity")
            method_candidate :: builder.owners.hooks.trait_method_rows[method_row]
            selected = Val(JetCodegenIndexHookTraitMethod{
                symbol: symbol,
                trait_key: builder.modules[method_candidate.module_index].declarations.traits[method_candidate.definition_index].key,
                method: builder.modules[method_candidate.module_index].declarations.traits[method_candidate.definition_index].methods[method_candidate.method_index],
            })
            method_row = method_candidate.next
        }
    }
    selected ?? panic("checked {trait_name} receiver has no checked {trait_name} bound or trait method")
}

fn jet_codegen_index_hook_trait_callee(builder: JetCodegenBuilder, trait_method: JetCodegenIndexHookTraitMethod, owner: MIRType) -> MIRCallee Never! {
    trait_ref := jet_codegen_mir_trait_ref_for_symbol(builder.modules, trait_method.symbol)
    method_id := MIRTraitMethodID{value: stable_id("mir-trait-method", "{trait_method.trait_key}::{trait_method.method.key}")}
    MIRCallee.TraitMethod{method: method_id, trait_ref: trait_ref, receiver: owner}
}

fn jet_codegen_lower_index_hook_assign(builder: &JetCodegenBuilder, base: TExpr, index: TExpr, value: TExpr, span: Span) {
