fn jet_codegen_lower_block(builder: &JetCodegenBuilder, program: JetCodegenProgram, statements: [TStmt]) {
    jet_codegen_enter_lexical(&builder, program)
    jet_codegen_lower_statements(&builder, program, statements)
    jet_codegen_leave_lexical(&builder, program)
}

fn jet_codegen_lower_statements(builder: &JetCodegenBuilder, program: JetCodegenProgram, statements: [TStmt]) {
    input := CanonicalPassSnapshot?{None}
    if jet_codegen_journal_requested(program, "mir.lower-statements") -> input = Val(canonical_pass_debug_snapshot("tir", "mir.lower-statements", "{statements}"))
    jet_codegen_lower_statements_inner(&builder, program, statements)
    if input == .Val(snapshot) {
        output :: canonical_pass_debug_snapshot("mir", "mir.lower-statements", "{builder.blocks}")
        jet_codegen_journal_record(program, "mir.lower-statements", "crates/jet-codegen/src/Codegen/TIR/tir_to_mir_stmt.rs", snapshot, output)
    }
}

fn jet_codegen_lower_statements_inner(builder: &JetCodegenBuilder, program: JetCodegenProgram, statements: [TStmt]) {
    index := 0
    loop index < statements.len() {
        if !jet_codegen_current_is_open(builder, program) -> return
        jet_codegen_lower_statement(&builder, program, statements[index])
        index += 1
    }
}

fn jet_codegen_statement_integer(ty: Type) -> Bool Never! {
    if ty == {
        .Int | .IntN(_, _) -> true
        .InlineRange(base, _, _) -> jet_codegen_statement_integer(base)
        .Tagged(_, inner) -> jet_codegen_statement_integer(inner)
        else -> false
    }
}

fn jet_codegen_assignment_overflow(op: TBinaryOp, lhs: Type, rhs: Type) -> Bool {
    if op == .Add | .Sub | .Mul | .Div -> return jet_codegen_statement_integer(lhs) || jet_codegen_statement_integer(rhs)
    if op == .Pow | .Shl | .Shr -> return jet_codegen_statement_integer(lhs)
    false
}

fn jet_codegen_lower_condition(builder: &JetCodegenBuilder, program: JetCodegenProgram, condition: TIfCond) -> MIRValueID {
    if condition == {
        .Plain(value) -> jet_codegen_lower_expr(&builder, program, value)
        .IsNone(subject) -> {
            subject_value := jet_codegen_lower_expr(&builder, program, subject)
            is_some := jet_codegen_emit_value(&builder, program, subject.span, Type.Bool, MIROperation.OptionIsSome{subject: subject_value})
            jet_codegen_emit_value(&builder, program, subject.span, Type.Bool, MIROperation.Unary{op: MIRUnaryOp.Not, value: is_some})
        }
        .IfLet(pattern, subject) -> {
            subject_value := jet_codegen_lower_pattern_subject(&builder, program, subject)
            jet_codegen_lower_pattern_condition(&builder, program, pattern, subject, subject_value, true)
        }
        .Matches(pattern, subject) -> {
            // D-FACT-ENUM-TIR: a fact-enum test over a prepared value is a constant.
            folded :: jet_codegen_fold_fact_enum_test(&builder, program, subject, subject, pattern)
            if folded == .Val(value) -> return value
            subject_value := jet_codegen_lower_pattern_subject(&builder, program, subject)
            jet_codegen_lower_pattern_condition(&builder, program, pattern, subject, subject_value, true)
        }
        .And(left, right) -> {
            left_value := jet_codegen_lower_condition(&builder, program, left)
            source_span := builder.function.source_span
            right_block := jet_codegen_new_block(&builder, program, source_span, "condition-and-rhs")
            false_block := jet_codegen_new_block(&builder, program, source_span, "condition-and-false")
            join_block := jet_codegen_new_block(&builder, program, source_span, "condition-and-join")
            jet_codegen_terminate(&builder, program, MIRTerminator.Branch{condition: left_value, then_target: right_block, else_target: false_block})
            jet_codegen_switch_block(&builder, program, right_block)
            right_value := jet_codegen_lower_condition(&builder, program, right)
            right_predecessor := builder.current
            jet_codegen_terminate(&builder, program, MIRTerminator.Jump{target: join_block})
            jet_codegen_switch_block(&builder, program, false_block)
            false_value := jet_codegen_emit_value(&builder, program, source_span, Type.Bool, MIROperation.Constant{value: MIRConstant.Bool{value: false}})
            false_predecessor := builder.current
            jet_codegen_terminate(&builder, program, MIRTerminator.Jump{target: join_block})
            jet_codegen_switch_block(&builder, program, join_block)
            incoming := [MIRPhiIncoming]{MIRPhiIncoming{block: right_predecessor, value: right_value}, MIRPhiIncoming{block: false_predecessor, value: false_value}}
            jet_codegen_emit_value(&builder, program, source_span, Type.Bool, MIROperation.Phi{incoming: incoming})
        }
        .WithPrelude(prelude, nested) -> {
            jet_codegen_lower_statements(&builder, program, prelude)
            if !jet_codegen_current_is_open(builder, program) -> panic("checked if-condition prelude terminates before its condition")
            jet_codegen_lower_condition(&builder, program, nested)
        }
        else -> panic("checked TIR condition lies outside the current Jet codegen contract")
    }
}
fn jet_codegen_lower_scoped(builder: &JetCodegenBuilder, program: JetCodegenProgram, kind: MIRScopeKind, name: String?, body: [TStmt], span: Span) {
    scope := jet_codegen_enter_scope(&builder, program, kind, span, name)
    jet_codegen_lower_block(&builder, program, body)
    jet_codegen_leave_scope(&builder, program, scope)
}

fn jet_codegen_lower_unsafe(builder: &JetCodegenBuilder, program: JetCodegenProgram, gate: TUnsafeGate, body: [TStmt], span: Span) {
    scope := jet_codegen_enter_scope(&builder, program, MIRScopeKind.Unsafe, span, Val(gate.reason))
    jet_codegen_set_scope_fact(&builder, program, scope, "sentry_file", gate.file)
    jet_codegen_set_scope_fact(&builder, program, scope, "sentry_enabled", if gate.enabled -> "true" else -> "false")
    jet_codegen_set_scope_fact(&builder, program, scope, "sentry_fenced", if gate.fenced -> "true" else -> "false")
    jet_codegen_set_scope_fact(&builder, program, scope, "sentry_line", "{gate.line}")
    jet_codegen_lower_block(&builder, program, body)
    jet_codegen_leave_scope(&builder, program, scope)
}

fn jet_codegen_lower_sentry_policy(builder: &JetCodegenBuilder, program: JetCodegenProgram, enabled: Bool, body: [TStmt], span: Span) {
    name := if enabled -> "enabled" else -> "disabled"
    scope := jet_codegen_enter_scope(&builder, program, MIRScopeKind.Policy, span, Val(name))
    jet_codegen_set_scope_fact(&builder, program, scope, "sentry_enabled", if enabled -> "true" else -> "false")
    jet_codegen_lower_block(&builder, program, body)
    jet_codegen_leave_scope(&builder, program, scope)
}

fn jet_codegen_lower_debug_only(builder: &JetCodegenBuilder, program: JetCodegenProgram, body: [TStmt], span: Span) {
    jet_codegen_lower_scoped(&builder, program, MIRScopeKind.DebugOnly, Val("debug-only"), body, span)
}

fn jet_codegen_lower_layout(builder: &JetCodegenBuilder, program: JetCodegenProgram, handle: TLocal, label: String, body: [TStmt], span: Span) {
    scope := jet_codegen_enter_scope(&builder, program, MIRScopeKind.Layout, span, Val(label))
    place := jet_codegen_bind_local(&builder, program, handle, Type.Named{name: "Layout"}, handle.mutable, None, None, false)
    value := jet_codegen_emit_value(&builder, program, span, Type.Named{name: "Layout"}, MIROperation.Global{name: "layout::{label}"})
    _ := jet_codegen_emit(&builder, program, span, None, MIROperation.WritePlace{place: place, value: value})
    jet_codegen_lower_block(&builder, program, body)
    jet_codegen_leave_scope(&builder, program, scope)
}

fn jet_codegen_lower_context_block(builder: &JetCodegenBuilder, program: JetCodegenProgram, guards: [TContextGuard], body: [TStmt], span: Span) {
    deadline := MIRValueID?{None}
    loop guard in guards {
        value := jet_codegen_lower_expr(&builder, program, guard.value)
        if guard.field == "deadline" -> deadline = Val(value)
    }
    scope := jet_codegen_enter_scope(&builder, program, MIRScopeKind.Context, span, None)
    if deadline != None {
        value :: deadline ?? panic("checked context deadline disappeared")
        jet_codegen_set_scope_deadline(&builder, program, scope, value)
    }
    jet_codegen_lower_block(&builder, program, body)
    jet_codegen_leave_scope(&builder, program, scope)
}

fn jet_codegen_lower_defer_thunk(builder: &JetCodegenBuilder, program: JetCodegenProgram, close: TExpr, resource: SymbolID, scope_id: Int, span: Span) -> MIRValueID {
    if resource.key == "" -> panic("checked deferred resource has an empty symbol identity")
    binding := JetCodegenBinding?{None}
    index := builder.bindings.len() - 1
    loop index >= 0 {
        candidate := builder.bindings[index]
        if candidate.symbol_key == resource.key && candidate.depth <= builder.scope_depth {
            binding = Val(candidate)
            break
        }
        index -= 1
    }
    captured :: binding ?? panic("checked deferred resource has no active Source binding")
    local := tir_symbol_local(captured.name, span, resource)
    // Rust emit_deferred_close lowers the close at the exit edge and discards
    // its value: the callee's own checked return (a defaulted `Unit Err!`
    // Close.close) is not the Unit statement's type, so a Unit close runs as
    // a statement of a Unit thunk instead of being its returned value.
    // copy: the defer thunk owns its close type, while `close` is the caller's checked defer
    // expression (a read parameter), which stays in the TIR.
    close_type :: close.ty.copy()
    unit_close :: close_type == Type.Named{name: "Unit"}
    // copy: the defer thunk's body owns its close expression, while `close` is the caller's checked
    // defer expression (a read parameter), which stays in the TIR.
    executable :: if unit_close -> TLambdaBody.Block{body: [TStmt]{TStmt.ExprStmt{value: close.copy(), span: span}}} else -> TLambdaBody.Expr{value: close.copy()}
    lambda := TLambda{
        executable: executable,
        source_span: span,
        frame_schedule: None,
        frame_schedule_derivation: None,
        capture_facts: TCaptureFacts{escapes: false, needs_fn_mut: false, mutable: [String]{}, cloned: [String]{}, frozen: [String]{}, materialized: [String]{}, moved: [String]{}},
        failure_carrier: jet_codegen_failure_carrier_for_type(close_type),
        effects: builder.function.effects,
        host_param_conventions: None,
        source_params: [String]{},
        source_param_symbols: [SymbolID]{},
        jit_name: "jet_defer_{scope_id}",
        param_types: [Type]{},
        ret: Val(close_type),
        is_move: false,
        boxed: false,
        rc: false,
        arc: false,
        captures: [TCapture]{TCapture{source: captured.name, local: local, ty: captured.ty}},
        materialized_captures: [String]{},
        frozen_captures: [String]{},
        uses_stack_sentry: false,
    }
    jet_codegen_lower_lambda(&builder, program, lambda, false, "defer-close-{scope_id}").value
}

fn jet_codegen_lower_task_group(builder: &JetCodegenBuilder, program: JetCodegenProgram, group: TLocal, limit: TExpr?, body: [TStmt], span: Span) {
    scope := jet_codegen_enter_scope(&builder, program, MIRScopeKind.TaskGroup, span, Val(group.name))
    group_ty := Type.Named{name: "Group"}
    args := [MIRCallArg]{}
    method := "new"
    if limit != None {
        limit_expr :: limit
        location := jet_codegen_source_location_at(&builder, program, limit_expr.span, false)
        converted := TExpr{
            ty: Type.IntN{signed: true, bits: 64},
            kind: TExprKind.NumericMethod{receiver: limit_expr, operation: TNumericOp.CheckedIntToFixed{host_kind: 3, dst_rust: "i64", dst_spelling: "I64", line: location.line}},
            span: limit_expr.span,
            integer_bounds: None,
            cost: None,
        }
        value := jet_codegen_lower_expr(&builder, program, converted)
        &args.push(jet_codegen_numeric_call_arg(value, limit_expr.span))
        method = "with_limit"
    }
    route := jet_codegen_intern_route(
        &builder, program,
        MIRPreludeFamily.StaticPrelude,
        "::jet_std::JetTaskGroup",
        method,
        "jet_std::JetTaskGroup::{method}",
        args.len(),
        if args.len() == 0 -> [Bool]{} else -> [Bool]{false},
        None,
        TFailureCarrier.Infallible,
        MIRPreludeABI.Value,
    )
    value := jet_codegen_emit_value(&builder, program, span, group_ty, MIROperation.Semantic{operation: MIRSemanticOp.StaticPreludeCall{call: route, args: args, owner_type_args: [MIRPreludeTypeArg]{}, type_args: [MIRType]{}}})
    place := jet_codegen_bind_local(&builder, program, group, group_ty, group.mutable, None, None, false)
    _ := jet_codegen_emit(&builder, program, span, None, MIROperation.WritePlace{place: place, value: value})

    // Rust `TStmt::TaskGroup`: the group joins its children through the
    // Prelude's borrowed `JetTaskGroup::close`, deferred to the scope's exit.
    resource := TExpr{ty: group_ty, kind: TExprKind.Local{local: group}, span: span, integer_bounds: None, cost: None}
    close_method := TMethodRef{symbol: symbol_id(SymbolKind.Function, "", "jet_std::JetTaskGroup", "close"), name: "close", mangled: false, trait_owner: None, operator_identity: None}
    close_arg := TCallArg{value: resource, template_items: [SymbolID]{}, borrow: true, mut_borrow: false, clone: false, arc_clone: false, fn_coerce: None, widen_to_vec: false, widen_to_union: None, box_as_trait: None, label: None, spread: false}
    close := TExpr{ty: Type.Named{name: "Unit"}, kind: TExprKind.StaticCall{owner: TStaticOwner.Prelude{rooted: true, path: "jet_std::JetTaskGroup", generics: [TPreludeArg]{}}, owner_type: None, method: close_method, type_args: [Type]{}, args: [TCallArg]{close_arg}}, span: span, integer_bounds: None, cost: None}
    group_symbol :: group.symbol_id ?? panic("checked task-group local has no symbol identity")
    thunk := jet_codegen_lower_defer_thunk(&builder, program, close, group_symbol, scope.value, span)
    jet_codegen_register_deferred_call(&builder, program, thunk, close.ty)

    jet_codegen_lower_block(&builder, program, body)
    jet_codegen_leave_scope(&builder, program, scope)
}

fn jet_codegen_lower_scope_member_body(builder: &JetCodegenBuilder, program: JetCodegenProgram, scope: MIRScopeID, body: [TStmt], span: Span, expect_fail: Bool) {
    native_exit := MIRBlockID?{None}
    if expect_fail && program.stop_points && !program.comptime_budget {
        native_exit = Val(jet_codegen_new_block(&builder, program, span, "scope-member.exit"))
        jet_codegen_set_scope_fact(&builder, program, scope, "native_test_exit", "{(native_exit ?? MIRBlockID{value: 0}).value}")
    }
    jet_codegen_lower_block(&builder, program, body)
    exit :: native_exit ?? jet_codegen_new_block(&builder, program, span, "scope-member.exit")
    join := jet_codegen_new_block(&builder, program, span, "scope-member.join")
    // Rust lower_scope_member_body: an `.expect_fail` body that ends in an
    // unconditional stop jumps to its exit after the stop. The stop never
    // returns, so the jump never runs; it keeps the exit reachable, which is
    // where a caught stop resumes and which gives the backend's catch match
    // an arm for the scope.
    ends_in_stop := false
    if builder.block_positions.get(builder.current.value) == .Val(at) {
        if builder.blocks[at].terminator == .Unreachable(reason) -> ends_in_stop = reason == "checked unconditional stop"
    }
    if jet_codegen_current_is_open(builder, program) || (expect_fail && ends_in_stop) -> jet_codegen_terminate(&builder, program, MIRTerminator.Jump{target: exit})
    jet_codegen_switch_block(&builder, program, exit)
    if native_exit != None {
        masked :: builder.stop_cleanup_active
        builder.stop_cleanup_active = true
        scope_value :: jet_codegen_emit_value(&builder, program, span, Type.IntN{signed: false, bits: 64}, MIROperation.Constant{value: MIRConstant.Int{value: Int.from_u64(scope.value), width: Val(MIRIntegerWidth{signed: false, bits: 64}), spelling: None}})
        route :: jet_codegen_static_prelude_call(&builder, program, "core.testing", "catch_boundary", "jet_rt_test_catch_boundary", [Bool]{false}, None, TFailureCarrier.Infallible, false)
        _ := jet_codegen_emit_static_prelude_call(&builder, program, span, Type.Named{name: "Unit"}, route, [MIRValueID]{scope_value})
        builder.stop_cleanup_active = masked
    }
    jet_codegen_leave_scope(&builder, program, scope)
    if jet_codegen_current_is_open(builder, program) -> jet_codegen_terminate(&builder, program, MIRTerminator.Jump{target: join})
    jet_codegen_switch_block(&builder, program, join)
}

fn jet_codegen_lower_scope_member(builder: &JetCodegenBuilder, program: JetCodegenProgram, kind: TScopeMemberKind, body: [TStmt], span: Span) {
    if kind == {
        .Setup -> {
            jet_codegen_lower_statements(&builder, program, body)
            return
        }
        .ExpectFail(expected, message) -> {
            scope := jet_codegen_enter_scope(&builder, program, MIRScopeKind.ScopeMember, span, expected)
            jet_codegen_attach_scope_member(&builder, program, scope, MIRTestScopeMember.ExpectFail{expected_code: expected, expected_message: message})
            jet_codegen_lower_scope_member_body(&builder, program, scope, body, span, true)
            return
        }
        .Timeout(duration) -> {
            value := jet_codegen_lower_expr(&builder, program, duration)
            scope := jet_codegen_enter_scope(&builder, program, MIRScopeKind.ScopeMember, span, Val("timeout"))
            jet_codegen_attach_scope_member(&builder, program, scope, MIRTestScopeMember.Timeout{duration: value})
            jet_codegen_lower_scope_member_body(&builder, program, scope, body, span, false)
            return
        }
        .Measure -> {
            scope := jet_codegen_enter_scope(&builder, program, MIRScopeKind.ScopeMember, span, Val("measure"))
            jet_codegen_attach_scope_member(&builder, program, scope, MIRTestScopeMember.Measure)
            jet_codegen_lower_scope_member_body(&builder, program, scope, body, span, false)
            return
        }
        .Skip -> {
            whole_test := builder.scopes.len() == 0 && builder.current == builder.entry
            if whole_test {
                loop block in builder.blocks {
                    if block.id == builder.current && block.instructions.len() != 0 -> whole_test = false
                }
            }
            scope := jet_codegen_enter_scope(&builder, program, MIRScopeKind.ScopeMember, span, Val("skip"))
            jet_codegen_attach_scope_member(&builder, program, scope, MIRTestScopeMember.Skip{whole_test: whole_test})
            body_block := jet_codegen_new_block(&builder, program, span, "scope-member.skip.body")
            skipped_block := jet_codegen_new_block(&builder, program, span, "scope-member.skip.skipped")
            exit_block := jet_codegen_new_block(&builder, program, span, "scope-member.skip.exit")
            join_block := jet_codegen_new_block(&builder, program, span, "scope-member.skip.join")
            false_value := jet_codegen_emit_value(&builder, program, span, Type.Bool, MIROperation.Constant{value: MIRConstant.Bool{value: false}})
            jet_codegen_terminate(&builder, program, MIRTerminator.Branch{condition: false_value, then_target: body_block, else_target: skipped_block})
            jet_codegen_switch_block(&builder, program, body_block)
            jet_codegen_lower_block(&builder, program, body)
            if jet_codegen_current_is_open(builder, program) -> jet_codegen_terminate(&builder, program, MIRTerminator.Jump{target: exit_block})
            jet_codegen_switch_block(&builder, program, skipped_block)
            jet_codegen_terminate(&builder, program, MIRTerminator.Jump{target: exit_block})
            jet_codegen_switch_block(&builder, program, exit_block)
            jet_codegen_leave_scope(&builder, program, scope)
            if jet_codegen_current_is_open(builder, program) -> jet_codegen_terminate(&builder, program, MIRTerminator.Jump{target: join_block})
            jet_codegen_switch_block(&builder, program, join_block)
        }
    }
}
fn jet_codegen_lower_conditional_stop(builder: &JetCodegenBuilder, program: JetCodegenProgram, span: Span, result_type: Type, call: MIRPreludeCallID, kind: MIRRequireKind, condition: MIRValueID, location: MIRPanicLoc, context: MIRPanicContext, values: [MIRValueID], role: String) -> MIRValueID Never! {
    success := jet_codegen_new_block(&builder, program, span, "{role}-success")
    failure := jet_codegen_new_block(&builder, program, span, "{role}-failure")
    jet_codegen_terminate(&builder, program, MIRTerminator.Branch{condition: condition, then_target: success, else_target: failure})
    jet_codegen_switch_block(&builder, program, failure)
    propagated :: jet_codegen_can_emit_propagate(builder, program)
    if !propagated -> jet_codegen_emit_explicit_stop_cleanups(&builder, program)
    _ := jet_codegen_emit_value(&builder, program, span, result_type, MIROperation.Semantic{operation: MIRSemanticOp.RequireStop{call: call, kind: kind, condition: Val(condition), location: location, context: context, values: values, always_stops: true}})
    jet_codegen_terminate_program_stop(&builder, program, propagated, "checked conditional stop")
    jet_codegen_switch_block(&builder, program, success)
    jet_codegen_emit_value(&builder, program, span, result_type, MIROperation.Constant{value: MIRConstant.Unit})
}


// An else-if chain (an `else` that is exactly one `if`, the shape sema gives
// every N-arm decision table) is lowered by direct recursion: one frame per
// arm. The chain is read in place through read parameters, so no link is
// copied; a loop would have to hold the rest of the chain in a local, and a
// local is a copy, which makes the walk quadratic in the arm count. Blocks,
// scopes, and terminators come out in the order `lower_block` ->
// `lower_statements` -> `lower_statement` -> `lower_if` produces.
fn jet_codegen_lower_if(builder: &JetCodegenBuilder, program: JetCodegenProgram, condition: TIfCond, then_body: [TStmt], else_body: [TStmt]?, span: Span) {
    outer_depth := builder.scope_depth
    jet_codegen_enter_lexical(&builder, program)
    value := jet_codegen_lower_condition(&builder, program, condition)
    then_block := jet_codegen_new_block(&builder, program, span, "if-then")
    else_block := jet_codegen_new_block(&builder, program, span, "if-else")
    join_block := jet_codegen_new_block(&builder, program, span, "if-join")
    jet_codegen_terminate(&builder, program, MIRTerminator.Branch{condition: value, then_target: then_block, else_target: else_block})
    jet_codegen_switch_block(&builder, program, then_block)
    jet_codegen_lower_block(&builder, program, then_body)
    then_reaches_join := jet_codegen_current_is_open(builder, program)
    if then_reaches_join -> jet_codegen_terminate(&builder, program, MIRTerminator.Jump{target: join_block})
    builder.scope_depth = outer_depth
    jet_codegen_switch_block(&builder, program, else_block)
    if else_body == .Val(else_statements) {
        jet_codegen_enter_lexical(&builder, program)
        loop statement in else_statements {
            if !jet_codegen_current_is_open(builder, program) -> break
            if statement == .If(next_condition, next_then, next_else, _, next_span) {
                jet_codegen_lower_if(&builder, program, next_condition, next_then, next_else, next_span)
            } else {
                jet_codegen_lower_statement(&builder, program, statement)
            }
        }
        jet_codegen_leave_lexical(&builder, program)
    }
    else_reaches_join := jet_codegen_current_is_open(builder, program)
    if else_reaches_join -> jet_codegen_terminate(&builder, program, MIRTerminator.Jump{target: join_block})
    builder.scope_depth = outer_depth + 1
    jet_codegen_switch_block(&builder, program, join_block)
    if !then_reaches_join && !else_reaches_join -> jet_codegen_terminate(&builder, program, MIRTerminator.Unreachable{reason: "both if arms terminate"})
    jet_codegen_leave_lexical(&builder, program)
}

fn jet_codegen_lower_refutable_bind(builder: &JetCodegenBuilder, program: JetCodegenProgram, pattern: TPattern, init: TExpr, fallback: [TStmt], span: Span) {
    stable :: builder.stable_element_lets.get(jet_codegen_pattern_subject_key(init)) == (Val(true))
    read_window :: jet_codegen_lower_read_window(&builder, program, init, stable)
    subject_value := read_window ?? jet_codegen_lower_expr(&builder, program, init)
    outer_bindings := builder.bindings
    test := jet_codegen_lower_pattern_condition(&builder, program, pattern, init, subject_value, true)
    pattern_bindings := builder.bindings
    success_block := jet_codegen_new_block(&builder, program, span, "refutable-bind-success")
    missed_block := jet_codegen_new_block(&builder, program, span, "refutable-bind-missed")
    join_block := jet_codegen_new_block(&builder, program, span, "refutable-bind-join")
    jet_codegen_terminate(&builder, program, MIRTerminator.Branch{condition: test, then_target: success_block, else_target: missed_block})
    jet_codegen_switch_block(&builder, program, success_block)
    success_reaches_join := jet_codegen_current_is_open(builder, program)
    if success_reaches_join -> jet_codegen_terminate(&builder, program, MIRTerminator.Jump{target: join_block})
    builder.bindings = outer_bindings
    jet_codegen_switch_block(&builder, program, missed_block)
    jet_codegen_lower_statements(&builder, program, fallback)
    missed_reaches_join := jet_codegen_current_is_open(builder, program)
    if missed_reaches_join -> jet_codegen_terminate(&builder, program, MIRTerminator.Jump{target: join_block})
    builder.bindings = pattern_bindings
    jet_codegen_switch_block(&builder, program, join_block)
    if !success_reaches_join && !missed_reaches_join -> jet_codegen_terminate(&builder, program, MIRTerminator.Unreachable{reason: "both refutable binding paths terminate"})
}

fn jet_codegen_lower_pattern_match(builder: &JetCodegenBuilder, program: JetCodegenProgram, subject: TExpr, clone_subject: Bool, arms: [TMatchArm], else_body: [TStmt]?, no_match_unreachable: Bool, no_match_reason: String, span: Span) {
    subject_value := jet_codegen_lower_pattern_subject(&builder, program, subject)
    window :: jet_codegen_pattern_window(builder, program, subject_value)
    // A read window tests a place nothing changes during the match (a read
    // parameter's, or a stable root's): no copy keeps the subject stable.
    // Neither does a plain place read (a local or a stored field path): its
    // ReadPlace already stands for a copy, every payload binding stores its
    // own payload (copying that payload only, or taking it once the MIR
    // last-use pass moves the subject's dead root), and every test runs
    // before any arm body can change the place. Only a computed subject
    // keeps the checked copy.
    plain_read :: window == None && jet_codegen_plain_place_path(subject)
    if clone_subject && !plain_read && jet_codegen_read_window_of(builder, program, subject_value) == None {
        subject_value = jet_codegen_emit_value(&builder, program, span, subject.ty, MIROperation.Copy{value: subject_value, fact: MIRCopyFact.Materialize})
        // The copy tests the same place, so its payload bindings still alias it.
        if window == .Val(place) -> &builder.pattern_windows.push(JetCodegenPatternWindow{value: subject_value, place: place})
    }
    saved_lookup_head := builder.pattern_lookup_head
    builder.pattern_lookup_head = Val(builder.current)
    join_block := jet_codegen_new_block(&builder, program, span, "pattern-match-join")
    otherwise_block := jet_codegen_new_block(&builder, program, span, "pattern-match-otherwise")
    has_join_edge := false
    if arms.len() == 0 -> jet_codegen_terminate(&builder, program, MIRTerminator.Jump{target: otherwise_block})
    index := 0
    loop index < arms.len() {
        arm := arms[index]
        base_depth := builder.scope_depth
        jet_codegen_enter_lexical(&builder, program)
        test := jet_codegen_lower_pattern_condition(&builder, program, arm.pattern, subject, subject_value, true)
        body_block := jet_codegen_new_block(&builder, program, span, "pattern-match-arm")
        next_block := if index + 1 < arms.len() -> jet_codegen_new_block(&builder, program, span, "pattern-match-test") else -> otherwise_block
        jet_codegen_terminate(&builder, program, MIRTerminator.Branch{condition: test, then_target: body_block, else_target: next_block})
        jet_codegen_switch_block(&builder, program, body_block)
        builder.scope_depth = base_depth + 1
        jet_codegen_lower_block(&builder, program, arm.body)
        if jet_codegen_current_is_open(builder, program) {
            jet_codegen_terminate(&builder, program, MIRTerminator.Jump{target: join_block})
            has_join_edge = true
        }
        builder.scope_depth = base_depth + 1
        jet_codegen_leave_lexical(&builder, program)
        jet_codegen_switch_block(&builder, program, next_block)
        builder.scope_depth = base_depth
        index += 1
    }
    jet_codegen_switch_block(&builder, program, otherwise_block)
    if {
        else_body != None -> jet_codegen_lower_block(&builder, program, else_body)
        no_match_unreachable -> jet_codegen_terminate(&builder, program, MIRTerminator.Unreachable{reason: no_match_reason})
    }
    if jet_codegen_current_is_open(builder, program) {
        jet_codegen_terminate(&builder, program, MIRTerminator.Jump{target: join_block})
        has_join_edge = true
    }
    jet_codegen_switch_block(&builder, program, join_block)
    if !has_join_edge -> jet_codegen_terminate(&builder, program, MIRTerminator.Unreachable{reason: "all checked pattern-match paths terminate"})
    builder.pattern_lookup_head = saved_lookup_head
}


fn jet_codegen_find_loop_target(builder: JetCodegenBuilder, program: JetCodegenProgram, label: String?, breaking: Bool) -> MIRBlockID Never! {
    index := builder.loops.len() - 1
    loop index >= 0 {
        target :: builder.loops[index]
        if label == None || target.label == label {
            if breaking -> return target.break_target
            return target.continue_target
        }
        index -= 1
    }
    panic("checked break/continue has no matching MIR loop")
}
fn jet_codegen_find_loop_scope_depth(builder: JetCodegenBuilder, program: JetCodegenProgram, label: String?, breaking: Bool) -> Int Never! {
    index := builder.loops.len() - 1
    loop index >= 0 {
        target := builder.loops[index]
        if label == None || target.label == label {
            if breaking -> return target.break_scope_depth
            return target.continue_scope_depth
        }
        index -= 1
    }
    panic("checked break/continue has no matching MIR loop scope")
}

fn jet_codegen_mark_loop_break(builder: &JetCodegenBuilder, program: JetCodegenProgram, label: String?) Never! {
    index := builder.loops.len() - 1
    loop index >= 0 {
        if label == None || builder.loops[index].label == label {
            builder.loops[index].break_seen = true
            return
        }
        index -= 1
    }
    panic("checked break has no matching MIR loop")
}

fn jet_codegen_add_loop_prelude_call(builder: &JetCodegenBuilder, program: JetCodegenProgram, member: String, symbol: String, arity: Int, borrow_mask: [Bool]) -> MIRPreludeCallID Never! {
    mask_names := [String]{}
    loop borrowed in borrow_mask {
        if borrowed { &mask_names.push("true") } else { &mask_names.push("false") }
    }
    identity := "StaticPrelude:core.prelude:{member}:{symbol}:{arity}:{arity}:[{mask_names.join(", ")}]:None:Infallible:Value"
    id := MIRPreludeCallID{value: stable_id("mir-prelude-call", identity)}
    row := MIRPreludeCall{
        id: id,
        family: MIRPreludeFamily.StaticPrelude,
        module_name: "core.prelude",
        member: member,
        symbol: MIRSymbol.Prelude{name: symbol},
        signature: MIRCallSignature{arity: arity, max_arity: arity, borrow_mask: borrow_mask},
        effect_kind: None,
        fallibility: MIRCallFallibility.Infallible,
        abi: MIRPreludeABI.Value,
        authority: None,
        db_metadata: None,
    }
    jet_codegen_intern_prelude_call(&builder, program, row)
}


fn jet_codegen_has_loop_block(blocks: [MIRBlockID], target: MIRBlockID) -> Bool Never! {
    loop block in blocks {
        if block == target -> return true
    }
    false
}

fn jet_codegen_loop_terminator_targets(terminator: MIRTerminator) -> [MIRBlockID] Never! {
    return if terminator == {
        .Jump(target) -> [MIRBlockID]{target}
        .Branch(_, then_target, else_target) -> [MIRBlockID]{then_target, else_target}
        .Switch(_, arms, otherwise) -> {
            targets := [MIRBlockID]{}
            loop arm in arms -> &targets.push(arm.target)
            &targets.push(otherwise)
            targets
        }
        .Yield(_, resume) -> [MIRBlockID]{resume}
        .Break(target, _) -> [MIRBlockID]{target}
        .Continue(target) -> [MIRBlockID]{target}
        .Return(_) -> [MIRBlockID]{}
        .Unreachable(_) -> [MIRBlockID]{}
        .Poll(_, resume, stop) -> [MIRBlockID]{resume, stop}
        .Stopped -> [MIRBlockID]{}
    }
}

fn jet_codegen_sort_loop_block_ids(blocks: &[MIRBlockID]) Never! {
    keys := [U64]{}
    loop block in blocks -> &keys.push(block.value)
    sorted := [MIRBlockID]{}
    loop position in jet_codegen_sorted_order(keys, [String]{}) -> &sorted.push(blocks[position])
    loop (index, block) in sorted -> blocks[index] = block
}

fn jet_codegen_loop_body_blocks(builder: JetCodegenBuilder, program: JetCodegenProgram, header: MIRBlockID, body: MIRBlockID, exit: MIRBlockID, advance: MIRBlockID?) -> [MIRBlockID] Never! {
    pending := [MIRBlockID]{body}
    region := [MIRBlockID]{}
    in_region := [U64:Bool]{}
    index := 0
    loop index < pending.len() {
        candidate := pending[index]
        index += 1
        if candidate != header && candidate != exit && advance != (Val(candidate)) && in_region.get(candidate.value) == None {
            at :: builder.block_positions.get(candidate.value) ?? next
            _ := &in_region.add(candidate.value, true)
            &region.push(candidate)
            loop target in jet_codegen_loop_terminator_targets(builder.blocks[at].terminator) -> &pending.push(target)
        }
    }
    jet_codegen_sort_loop_block_ids(&region)
    region
}

fn jet_codegen_loop_value_is_indexed(builder: JetCodegenBuilder, program: JetCodegenProgram, body_blocks: [MIRBlockID], advance: MIRBlockID?, value: MIRValueID) -> Bool Never! {
    loop block_id in body_blocks {
        if advance != (Val(block_id)) {
            at :: builder.block_positions.get(block_id.value) ?? next
            loop instruction in builder.blocks[at].instructions {
                indexed := if instruction.operation == {
                    .Index(_, _, index, _, _, _, _) -> index == value
                    else -> false
                }
                if indexed -> return true
            }
        }
    }
    return false
}

fn jet_codegen_checked_loop_cursor(builder: JetCodegenBuilder, program: JetCodegenProgram, condition: TExpr, body_blocks: [MIRBlockID], advance: MIRBlockID?) -> MIRValueID? {
    cursor_place := MIRPlaceID?{None}
    if condition.kind == {
        .Binary(_, _, _, lhs, _) -> {
            if lhs.kind == {
                .Local(local) -> {
                    binding := jet_codegen_find_binding_for_local(builder, program, local)
                    if binding == {
                        None -> {}
                        Val(row) -> cursor_place = Val(row.place)
                    }
                }
                else -> {}
            }
        }
        else -> {}
    }
    if cursor_place == None -> return None
    first := MIRValueID?{None}
    indexed := MIRValueID?{None}
    loop block_id in body_blocks {
        if advance != (Val(block_id)) {
            at :: builder.block_positions.get(block_id.value) ?? next
            loop instruction in builder.blocks[at].instructions {
                if instruction.operation == {
                    .ReadPlace(place) -> {
                        if cursor_place == (Val(place)) {
                            if instruction.result == {
                                None -> {}
                                Val(value) -> {
                                    if first == None -> first = Val(value)
                                    if indexed == None && jet_codegen_loop_value_is_indexed(builder, program, body_blocks, advance, value) -> indexed = Val(value)
                                }
                            }
                        }
                    }
                    else -> {}
                }
            }
        }
    }
    if indexed != None -> return indexed
    first
}

fn jet_codegen_checked_vector_lane_width(ty: Type) -> Int? {
    if ty == {
        .Float -> Val(2)
        .Float32 -> Val(4)
        .IntN(_, bits) -> {
            if bits <= 32 -> return Val(4)
            Val(2)
        }
        .InlineRange(base, _, _) | .Tagged(_, base) | .Quantity(base, _) -> jet_codegen_checked_vector_lane_width(base)
        else -> None
    }
}

fn jet_codegen_record_checked_vector_fact(builder: &JetCodegenBuilder, program: JetCodegenProgram, header: MIRBlockID, cursor: MIRValueID?, body_blocks: [MIRBlockID], advance: MIRBlockID?, facts: AutoVectorizationFacts?, span: Span) Never! {
    if facts == {
        None -> {}
        Val(value) -> {
            lowered_ty :: jet_codegen_lower_type_for_function(value.element_type, builder, program)
            &builder.checked_vector_facts.push(MIRVectorFact{
                loop_header: header,
                cursor: cursor,
                body_blocks: body_blocks,
                advance_block: advance,
                rule: MIRVectorRule.Elementwise,
                accesses: [MIRVectorAccess]{},
                layout: MIRVectorLayout.Flat,
                element_type: Val(lowered_ty),
                packed: false,
                lane_width: jet_codegen_checked_vector_lane_width(value.element_type),
                no_aliasing: value.no_aliasing,
                no_early_exit: value.no_early_exit,
                effect_free_body: value.effect_free_body,
                no_cross_iteration_dependencies: value.no_cross_iteration_deps,
                fixed_reduction: None,
                span: span,
                decision: MIROptimizationDecision.Rejected{reason: MIROptimizationRejection.UnsupportedOperation},
            })
        }
    }
}

fn jet_codegen_lower_counted_loop(builder: &JetCodegenBuilder, program: JetCodegenProgram, label: String?, init: TStmt, condition: TExpr, step: TStmt?, vectorization: AutoVectorizationFacts?, body: [TStmt], span: Span) {
    if condition.ty != Type.Bool -> panic("checked counted-loop condition is not Bool")
    loop_scope_depth := builder.scope_depth
    jet_codegen_enter_lexical(&builder, program)
    jet_codegen_lower_statement(&builder, program, init)
    if !jet_codegen_current_is_open(builder, program) {
        jet_codegen_leave_lexical(&builder, program)
        return
    }
    condition_block := jet_codegen_new_block(&builder, program, span, "counted-loop-condition")
    body_block := jet_codegen_new_block(&builder, program, span, "counted-loop-body")
    step_block := jet_codegen_new_block(&builder, program, span, "counted-loop-step")
    exit_block := jet_codegen_new_block(&builder, program, span, "counted-loop-exit")
    jet_codegen_terminate(&builder, program, MIRTerminator.Jump{target: condition_block})
    jet_codegen_switch_block(&builder, program, condition_block)
    condition_value := jet_codegen_lower_expr(&builder, program, condition)
    jet_codegen_terminate(&builder, program, MIRTerminator.Branch{condition: condition_value, then_target: body_block, else_target: exit_block})
    &builder.loops.push(JetCodegenLoopTarget{label: label, break_target: exit_block, continue_target: step_block, break_scope_depth: loop_scope_depth, continue_scope_depth: builder.scope_depth, break_cleanup_depth: builder.cleanup_frames.len(), continue_cleanup_depth: builder.cleanup_frames.len(), break_seen: false})
    jet_codegen_switch_block(&builder, program, body_block)
    jet_codegen_lower_block(&builder, program, body)
    if jet_codegen_current_is_open(builder, program) -> jet_codegen_terminate(&builder, program, MIRTerminator.Jump{target: step_block})
    jet_codegen_switch_block(&builder, program, step_block)
    if step == {
        .None -> {}
        .Val(step_statement) -> jet_codegen_lower_statement(&builder, program, step_statement)
    }
    if jet_codegen_current_is_open(builder, program) -> jet_codegen_terminate(&builder, program, MIRTerminator.Jump{target: condition_block})
    _ := &builder.loops.pop()
    jet_codegen_switch_block(&builder, program, exit_block)
    body_blocks := jet_codegen_loop_body_blocks(builder, program, condition_block, body_block, exit_block, Val(step_block))
    cursor := jet_codegen_checked_loop_cursor(builder, program, condition, body_blocks, Val(step_block))
    jet_codegen_record_checked_vector_fact(&builder, program, condition_block, cursor, body_blocks, Val(step_block), vectorization, span)
    jet_codegen_leave_lexical(&builder, program)
}

fn jet_codegen_lower_numeric_range_loop(builder: &JetCodegenBuilder, program: JetCodegenProgram, label: String?, local: TLocal, start: TExpr, end: TExpr, step: TExpr?, exclusive: Bool, vectorization: AutoVectorizationFacts?, body: [TStmt], span: Span) {
    range_init_call := jet_codegen_add_loop_prelude_call(&builder, program, "loop_range_init", "jet_loop_range_init", 5, [Bool]{false, false, false, false, false})
    range_has_next_call := jet_codegen_add_loop_prelude_call(&builder, program, "loop_range_has_next", "jet_loop_range_has_next", 1, [Bool]{true})
    range_value_call := jet_codegen_add_loop_prelude_call(&builder, program, "loop_range_value", "jet_loop_range_value", 1, [Bool]{true})
    range_advance_call := jet_codegen_add_loop_prelude_call(&builder, program, "loop_range_advance", "jet_loop_range_advance", 1, [Bool]{true})
    start_value := jet_codegen_lower_expr(&builder, program, start)
    end_value := jet_codegen_lower_expr(&builder, program, end)
    step_value := MIRValueID?{None}
    if step == {
        .None -> {}
        .Val(step_expr) -> step_value = Val(jet_codegen_lower_expr(&builder, program, step_expr))
    }
    cursor := jet_codegen_emit_value(&builder, program, span, Type.Named{name: "RangeCursor"}, MIROperation.LoopRangeInit{call: range_init_call, start: start_value, end: end_value, step: step_value, exclusive: exclusive})
    loop_scope_depth := builder.scope_depth
    jet_codegen_enter_lexical(&builder, program)
    place := jet_codegen_bind_local(&builder, program, local, start.ty, false, None, None, false)
    condition_block := jet_codegen_new_block(&builder, program, span, "range-loop-condition")
    body_block := jet_codegen_new_block(&builder, program, span, "range-loop-body")
    advance_block := jet_codegen_new_block(&builder, program, span, "range-loop-advance")
    exit_block := jet_codegen_new_block(&builder, program, span, "range-loop-exit")
    jet_codegen_terminate(&builder, program, MIRTerminator.Jump{target: condition_block})
    jet_codegen_switch_block(&builder, program, condition_block)
    has_next := jet_codegen_emit_value(&builder, program, span, Type.Bool, MIROperation.LoopRangeHasNext{call: range_has_next_call, cursor: cursor})
    jet_codegen_terminate(&builder, program, MIRTerminator.Branch{condition: has_next, then_target: body_block, else_target: exit_block})
    &builder.loops.push(JetCodegenLoopTarget{label: label, break_target: exit_block, continue_target: advance_block, break_scope_depth: loop_scope_depth, continue_scope_depth: builder.scope_depth, break_cleanup_depth: builder.cleanup_frames.len(), continue_cleanup_depth: builder.cleanup_frames.len(), break_seen: false})
    jet_codegen_switch_block(&builder, program, body_block)
    item := jet_codegen_emit_value(&builder, program, span, start.ty, MIROperation.LoopRangeValue{call: range_value_call, cursor: cursor})
    _ := jet_codegen_emit(&builder, program, span, None, MIROperation.WritePlace{place: place, value: item})
    jet_codegen_lower_block(&builder, program, body)
    if jet_codegen_current_is_open(builder, program) -> jet_codegen_terminate(&builder, program, MIRTerminator.Jump{target: advance_block})
    jet_codegen_switch_block(&builder, program, advance_block)
    _ := jet_codegen_emit(&builder, program, span, None, MIROperation.LoopRangeAdvance{call: range_advance_call, cursor: cursor})
    if jet_codegen_current_is_open(builder, program) -> jet_codegen_terminate(&builder, program, MIRTerminator.Jump{target: condition_block})
    _ := &builder.loops.pop()
    jet_codegen_switch_block(&builder, program, exit_block)
    body_blocks := jet_codegen_loop_body_blocks(builder, program, condition_block, body_block, exit_block, Val(advance_block))
    jet_codegen_record_checked_vector_fact(&builder, program, condition_block, Val(cursor), body_blocks, Val(advance_block), vectorization, span)
    jet_codegen_leave_lexical(&builder, program)
}

fn jet_codegen_lower_iter_range_loop(builder: &JetCodegenBuilder, program: JetCodegenProgram, label: String?, local: TLocal, collection: TExpr, item_type: Type, step: TExpr?, vectorization: AutoVectorizationFacts?, body: [TStmt], span: Span) {
    iter_init_call := jet_codegen_add_loop_prelude_call(&builder, program, "loop_iter_init", "jet_loop_iter_init", 5, [Bool]{false, false, false, false, false})
    iter_has_next_call := jet_codegen_add_loop_prelude_call(&builder, program, "loop_iter_has_next", "jet_loop_iter_has_next", 1, [Bool]{true})
    iter_value_call := jet_codegen_add_loop_prelude_call(&builder, program, "loop_iter_value", "jet_loop_iter_value", 1, [Bool]{true})
    iter_advance_call := jet_codegen_add_loop_prelude_call(&builder, program, "loop_iter_advance", "jet_loop_iter_advance", 1, [Bool]{true})
    collection_value := jet_codegen_lower_expr(&builder, program, collection)
    step_value := MIRValueID?{None}
    if step == {
        .None -> {}
        .Val(step_expr) -> step_value = Val(jet_codegen_lower_expr(&builder, program, step_expr))
    }
    // A `Range` value walks the generic iterator cursor, so its carrier type is
    // the one `LoopIterInit` returns, never the literal-range cursor.
    cursor := jet_codegen_emit_value(&builder, program, span, Type.Named{name: "IterCursor"}, MIROperation.LoopIterInit{call: iter_init_call, collection: collection_value, step: step_value, by_value: false, source_kind: MIRLoopSourceKind.Plain})
    loop_scope_depth := builder.scope_depth
    jet_codegen_enter_lexical(&builder, program)
    place := jet_codegen_bind_local(&builder, program, local, item_type, false, None, None, false)
    condition_block := jet_codegen_new_block(&builder, program, span, "range-iter-condition")
    body_block := jet_codegen_new_block(&builder, program, span, "range-iter-body")
    advance_block := jet_codegen_new_block(&builder, program, span, "range-iter-advance")
    exit_block := jet_codegen_new_block(&builder, program, span, "range-iter-exit")
    jet_codegen_terminate(&builder, program, MIRTerminator.Jump{target: condition_block})
    jet_codegen_switch_block(&builder, program, condition_block)
    has_next := jet_codegen_emit_value(&builder, program, span, Type.Bool, MIROperation.LoopIterHasNext{call: iter_has_next_call, cursor: cursor})
    jet_codegen_terminate(&builder, program, MIRTerminator.Branch{condition: has_next, then_target: body_block, else_target: exit_block})
    &builder.loops.push(JetCodegenLoopTarget{label: label, break_target: exit_block, continue_target: advance_block, break_scope_depth: loop_scope_depth, continue_scope_depth: builder.scope_depth, break_cleanup_depth: builder.cleanup_frames.len(), continue_cleanup_depth: builder.cleanup_frames.len(), break_seen: false})
    jet_codegen_switch_block(&builder, program, body_block)
    item := jet_codegen_emit_value(&builder, program, span, item_type, MIROperation.LoopIterValue{call: iter_value_call, cursor: cursor})
    _ := jet_codegen_emit(&builder, program, span, None, MIROperation.WritePlace{place: place, value: item})
    jet_codegen_lower_block(&builder, program, body)
    if jet_codegen_current_is_open(builder, program) -> jet_codegen_terminate(&builder, program, MIRTerminator.Jump{target: advance_block})
    jet_codegen_switch_block(&builder, program, advance_block)
    _ := jet_codegen_emit(&builder, program, span, None, MIROperation.LoopIterAdvance{call: iter_advance_call, cursor: cursor})
    if jet_codegen_current_is_open(builder, program) -> jet_codegen_terminate(&builder, program, MIRTerminator.Jump{target: condition_block})
    _ := &builder.loops.pop()
    jet_codegen_switch_block(&builder, program, exit_block)
    _ := jet_codegen_emit(&builder, program, span, None, MIROperation.Drop{value: cursor, kind: MIRDropKind.Value})
    body_blocks := jet_codegen_loop_body_blocks(builder, program, condition_block, body_block, exit_block, Val(advance_block))
    jet_codegen_record_checked_vector_fact(&builder, program, condition_block, Val(cursor), body_blocks, Val(advance_block), vectorization, span)
    jet_codegen_leave_lexical(&builder, program)
}

fn jet_codegen_for_in_iter_element(ty: Type) -> Type? {
    if ty == {
        .Apply(name, args) -> if (name == "Iter" || name == "ViewIter") && args.len() == 1 -> Val(args[0]) else -> None
        else -> None
    }
}

// The item a checked encoding-reader loop binds, keyed by the reader's
// canonical or source nominal name (same table as sema's for-in check).
fn jet_codegen_for_in_encoding_item_type(reader_type: String) -> Type? {
    if reader_type == "JSONReader" || reader_type.ends_with("::JSONReader") || reader_type == "CBORReader" || reader_type.ends_with("::CBORReader") -> return Val(Type.Named{name: "DataEvent"})
    if reader_type == "JSONLReader" || reader_type.ends_with("::JSONLReader") || reader_type == "XMLReader" || reader_type.ends_with("::XMLReader") -> return Val(Type.Named{name: "Dyn"})
    if reader_type == "CSVReader" || reader_type.ends_with("::CSVReader") -> return Val(Type.Named{name: "CSVRow"})
    None
}

fn jet_codegen_for_in_item_type(collection: TExpr, method_kind: TForInMethod?) -> Type Never! {
    if method_kind == {
        .Val(method) -> {
            if method == {
                .ChannelReceiver -> {
                    if collection.ty == {
                        .Apply(name, args) -> {
                            if name == "Receiver" && args.len() == 1 -> return args[0]
                        }
                        else -> {}
                    }
                }
                else -> {}
            }
        }
        .None -> {}
    }
    iter_element := jet_codegen_for_in_iter_element(collection.ty)
    if iter_element != None -> return iter_element ?? collection.ty
    if method_kind == {
        .Val(method) -> {
            if method == {
                .Chars -> return Type.Char
                .LinesFile | .LinesStdin | .LinesProcessStream -> return Type.String
                .ChannelReceiver -> return collection.ty
                .Iterable(_, _, _, _, item_type) -> return item_type
                .EncodingReader(reader_type) -> return jet_codegen_for_in_encoding_item_type(reader_type) ?? panic("checked encoding-reader loop names a reader with no item type")
            }
        }
        .None -> {}
    }
    if collection.ty == {
        .List(elem) | .FixedList(elem, _) -> elem
        .Map(key, _, value) -> Type.Tuple{fields: [TypeTupleField]{
            TypeTupleField{name: "key", ty: key},
            TypeTupleField{name: "value", ty: value},
        }}
        .Apply(name, args) -> if (name == "View" || name == "ViewMut" || name == "ComputeViewMut") && args.len() == 1 -> args[0] else -> collection.ty
        else -> collection.ty
    }
}

fn jet_codegen_for_in_owns_source(builder: JetCodegenBuilder, program: JetCodegenProgram, source_kind: MIRLoopSourceKind, collection: TExpr) -> Bool Never! {
    if source_kind == {
        .Plain -> return jet_codegen_for_in_iter_element(collection.ty) != None
        .Chars -> return false
        .LinesFile | .LinesStdin | .LinesProcessStream | .ChannelReceiver | .EncodingReader(_) -> return true
        .Iterable(_, _, iter_symbol, _) -> {
            function :: jet_codegen_find_function(program.function_index, iter_symbol) ?? panic("checked Iterable iter method has no reachable TFunc")
            if function.kind == {
                .Method(convention, _) | .TraitMethod(_, convention, _, _, _) -> {
                    if convention == None -> panic("checked Iterable iter method has no receiver convention")
                    return convention == (Val(AccessConvention.Move))
                }
                else -> panic("checked Iterable iter identity does not name an instance method")
            }
        }
    }
}

fn jet_codegen_for_in_byte_sequence(ty: Type) -> Bool Never! {
    if ty == {
        .Tagged(_, inner) -> return jet_codegen_for_in_byte_sequence(inner)
        .List(elem) | .FixedList(elem, _) -> return jet_codegen_fixed_width(elem) == (Val("u8"))
        else -> return false
    }
}

fn jet_codegen_for_in_tuple_field_type(ty: Type, member: String) -> Type Never! {
    untagged := jet_codegen_unwrap_pattern_tags(ty)
    if untagged == {
        .Tuple(fields) -> {
            loop field in fields {
                if field.name == member -> return field.ty
            }
            panic("checked for-in pair has no {member} field")
        }
        else -> panic("checked for-in pair element is not a tuple")
    }
}

fn jet_codegen_for_in_tuple_field_id(builder: JetCodegenBuilder, program: JetCodegenProgram, ty: Type, member: String) -> MIRFieldID Never! {
    untagged := jet_codegen_unwrap_pattern_tags(ty)
    if untagged == {
        .Tuple(_) -> {
            tuple_type := jet_codegen_lower_type_for_function(untagged, builder, program)
            if tuple_type.identity == None -> panic("checked for-in tuple has no MIR identity")
            return mir_field_id("{mir_type_identity_key(tuple_type)}::{member}")
        }
        else -> {
            resolved := jet_codegen_resolve_field_by_name(program.modules, program.nominals, builder.function.module_identity, builder.generic_type_names, untagged, member, builder.function.key)
            return jet_codegen_mir_field_id(resolved)
        }
    }
}

// D-MEM-COPYSEM1: a plain `loop item in list` (or `loop (index, item) in
// list`) over a read parameter's list walks the list in place: an index runs
// over the list's length and the item is a read-only alias of its slot, so
// neither the list nor any item is copied; the two-name form binds that index
// as `index`. The parameter cannot change while the loop runs, so every alias
// reads exactly what the copied item would hold. #4318 §4: a stable source
// (sema proved the body never mentions its root) walks the same way when it is
// rooted at a local or any parameter. A fixed list walks over its literal
// length; one whose length is not a literal keeps the iterator. False
// (nothing emitted) when `collection` is not such a sequence. A columnar list
// (D-SOA1) stores one column per field, so its slots are not places an alias
// can name; the caller keeps the gathered-record iteration for it.
// Rust: crates/jet-codegen/src/Codegen/TIR/tir_to_mir_stmt.rs::read_list_walk
fn jet_codegen_lower_read_list_walk(builder: &JetCodegenBuilder, program: JetCodegenProgram, label: String?, variable: TLocal, variable_two: TLocal?, collection: TExpr, source_stable: Bool, body: [TStmt], span: Span) -> Bool {
    listed := Type?{None}
    fixed_length := Int?{None}
    if jet_codegen_builtin_untag(collection.ty) == {
        .List(inner) -> listed = Val(inner)
        .FixedList(inner, measure) -> {
            fixed_length = measure_literal_value(measure)
            if fixed_length != None -> listed = Val(inner)
        }
        else -> {}
    }
    element :: listed ?? return false
    if jet_codegen_read_window_place(&builder, program, collection) == None && !(source_stable && jet_codegen_stable_source_place(&builder, program, collection) != None) -> return false
    // The walk reads the list's own slots, so a compiler copy of the source
    // (a share of a later-used local) is never made.
    list := collection
    if collection.kind == .Clone(inner, _) -> list = inner
    loop_scope_depth := builder.scope_depth
    jet_codegen_enter_lexical(&builder, program)
    length := if fixed_length == {
        .Val(count) -> jet_codegen_emit_value(&builder, program, span, Type.Int, MIROperation.Constant{value: MIRConstant.Int{value: count, width: None, spelling: None}})
        .None -> jet_codegen_lower_expr(&builder, program, TExpr{ty: Type.Int, kind: TExprKind.BuiltinMethod{receiver: list, operation: TBuiltinOp.LenList, args: [TExpr]{}}, span: span, integer_bounds: None, cost: None})
    }
    index_local := if variable_two == None -> tir_user_local("read_walk_index_{span.start}", span) else -> variable
    item_local := variable_two ?? variable
    index_place := jet_codegen_bind_local(&builder, program, index_local, Type.Int, true, None, None, false)
    zero := jet_codegen_emit_value(&builder, program, span, Type.Int, MIROperation.Constant{value: mir_integer_constant(0, None, None)})
    _ := jet_codegen_emit(&builder, program, span, None, MIROperation.WritePlace{place: index_place, value: zero})
    condition_block := jet_codegen_new_block(&builder, program, span, "read-walk-condition")
    body_block := jet_codegen_new_block(&builder, program, span, "read-walk-body")
    advance_block := jet_codegen_new_block(&builder, program, span, "read-walk-advance")
    exit_block := jet_codegen_new_block(&builder, program, span, "read-walk-exit")
    jet_codegen_terminate(&builder, program, MIRTerminator.Jump{target: condition_block})
    jet_codegen_switch_block(&builder, program, condition_block)
    current := jet_codegen_emit_value(&builder, program, span, Type.Int, MIROperation.ReadPlace{place: index_place})
    has_next := jet_codegen_emit_value(&builder, program, span, Type.Bool, MIROperation.Binary{op: MIRBinaryOp.Lt, dispatch: MIRBinaryDispatch.Primitive, overflow: MIRBinaryOverflow.Unchecked, left: current, right: length})
    jet_codegen_terminate(&builder, program, MIRTerminator.Branch{condition: has_next, then_target: body_block, else_target: exit_block})
    &builder.loops.push(JetCodegenLoopTarget{label: label, break_target: exit_block, continue_target: advance_block, break_scope_depth: loop_scope_depth, continue_scope_depth: builder.scope_depth, break_cleanup_depth: builder.cleanup_frames.len(), continue_cleanup_depth: builder.cleanup_frames.len(), break_seen: false})
    jet_codegen_switch_block(&builder, program, body_block)
    index_expr := TExpr{ty: Type.Int, kind: TExprKind.Local{local: index_local}, span: span, integer_bounds: None, cost: None}
    location := jet_codegen_assignment_panic_location(&builder, program, span, false)
    item_place := jet_codegen_index_place(&builder, program, list, index_expr, TIndexKind.List, element, MIRAccess.Read, location, span)
    _ := jet_codegen_bind_local_alias(&builder, program, item_local, element, item_place, false)
    jet_codegen_lower_block(&builder, program, body)
    if jet_codegen_current_is_open(builder, program) -> jet_codegen_terminate(&builder, program, MIRTerminator.Jump{target: advance_block})
    jet_codegen_switch_block(&builder, program, advance_block)
    current_index := jet_codegen_emit_value(&builder, program, span, Type.Int, MIROperation.ReadPlace{place: index_place})
    one := jet_codegen_emit_value(&builder, program, span, Type.Int, MIROperation.Constant{value: mir_integer_constant(1, None, None)})
    add_dispatch :: jet_codegen_binary_dispatch(&builder, program, TBinaryOp.Add, false, Type.Int, span, 0)
    next_index := jet_codegen_emit_value(&builder, program, span, Type.Int, MIROperation.Binary{op: MIRBinaryOp.Add, dispatch: add_dispatch, overflow: MIRBinaryOverflow.Unchecked, left: current_index, right: one})
    _ := jet_codegen_emit(&builder, program, span, None, MIROperation.WritePlace{place: index_place, value: next_index})
    jet_codegen_terminate(&builder, program, MIRTerminator.Jump{target: condition_block})
    _ := &builder.loops.pop()
    jet_codegen_switch_block(&builder, program, exit_block)
    jet_codegen_leave_lexical(&builder, program)
    true
}

// Whether `collection` is a List naming an owned local's whole place (not a
// parameter, a read alias or a persisted root), which the MIR last-use pass
// may move into a by-value walk.
fn jet_codegen_loop_owned_local(builder: JetCodegenBuilder, program: JetCodegenProgram, collection: TExpr) -> Bool Never! {
    listed :: if jet_codegen_builtin_untag(collection.ty) == {
        .List(_) -> true
        else -> false
    }
    if !listed -> return false
    if collection.kind == .Local(local) {
        binding :: jet_codegen_find_binding_for_local(builder, program, local) ?? return false
        if builder.read_alias_places.get(binding.place.value) != None -> return false
        row :: jet_codegen_find_place(builder, program, binding.place) ?? return false
        if row.projections.len() != 0 || row.persist_key != None -> return false
        return row.base == .Local(_)
    }
    false
}

// Whether `body` may consume the loop item `name`: a value or write use of
// the bare name (jet_codegen_stability_expr's `consumed`).
fn jet_codegen_loop_body_consumes(body: [TStmt], name: String) -> Bool Never! {
    state := JetCodegenLetStability{tick: 0, last: [String:Int]{}, read_at: [String:Int]{}, pinned: [String:Bool]{}, uses: 0, consumed: [String:Int]{}, pending: [JetCodegenLetCandidate]{}, stable: [String:Bool]{}}
    jet_codegen_stability_list(&state, body, false)
    state.consumed.get(name) != None
}

fn jet_codegen_lower_for_in(builder: &JetCodegenBuilder, program: JetCodegenProgram, label: String?, variable: TLocal, variable_two: TLocal?, source: TExpr, collection: TExpr, step: TExpr?, method_kind: TForInMethod?, columnar: Bool, by_value: Bool, source_stable: Bool, body: [TStmt], span: Span) {
    // A source that would be copied (a field path, or a compiler copy of a
    // later-used local) walks in place when the body leaves its root alone
    // (jet_codegen_stable_element_lets); a bare owned local keeps the iterator,
    // which moves it at its last use. A body that may consume a non-scalar
    // item of a bare owned local takes the iterator too: at the local's last
    // use the MIR pass moves the list into it (LastUse.jet), so every item
    // moves out instead of being copied out of a walked slot.
    stable_walk := source_stable
    bare_local :: if collection.kind == {
        .Local(_) -> true
        else -> false
    }
    if !stable_walk && !bare_local -> stable_walk = builder.stable_element_lets.get(jet_codegen_loop_source_key(collection)) == (Val(true))
    consuming :: bare_local && variable_two == None && method_kind == None && !jet_codegen_stability_scalar(jet_codegen_for_in_item_type(collection, method_kind)) && jet_codegen_loop_owned_local(builder, program, collection) && jet_codegen_loop_body_consumes(body, variable.name)
    if method_kind == None && step == None && !by_value && !columnar && !consuming && jet_codegen_lower_read_list_walk(&builder, program, label, variable, variable_two, collection, stable_walk, body, span) -> return
    iter_init_call := jet_codegen_add_loop_prelude_call(&builder, program, "loop_iter_init", "jet_loop_iter_init", 5, [Bool]{false, false, false, false, false})
    iter_has_next_call := jet_codegen_add_loop_prelude_call(&builder, program, "loop_iter_has_next", "jet_loop_iter_has_next", 1, [Bool]{true})
    iter_value_call := jet_codegen_add_loop_prelude_call(&builder, program, "loop_iter_value", "jet_loop_iter_value", 1, [Bool]{true})
    iter_advance_call := jet_codegen_add_loop_prelude_call(&builder, program, "loop_iter_advance", "jet_loop_iter_advance", 1, [Bool]{true})
    source_kind := if method_kind == {
        .None -> MIRLoopSourceKind.Plain
        .Val(method) -> if method == {
            .Chars -> MIRLoopSourceKind.Chars
            .LinesFile -> MIRLoopSourceKind.LinesFile
            .LinesStdin -> MIRLoopSourceKind.LinesStdin
            .LinesProcessStream -> MIRLoopSourceKind.LinesProcessStream
            .ChannelReceiver -> MIRLoopSourceKind.ChannelReceiver
            .EncodingReader(reader_type) -> MIRLoopSourceKind.EncodingReader{reader_type: reader_type}
            .Iterable(coll_type, iter_type, iter_symbol, next_symbol, _) -> MIRLoopSourceKind.Iterable{coll_type: coll_type, iter_type: iter_type, iter_symbol: iter_symbol, next_symbol: next_symbol}
        }
    }
    indexed_pair := false
    owns_indexed_source := false
    if variable_two != None && method_kind == None {
        if collection.ty == {
            .List(_) | .FixedList(_, _) -> {
                indexed_pair = true
                owns_indexed_source = true
            }
            .Apply(name, args) -> {
                if (name == "View" || name == "ViewMut" || name == "ComputeViewMut") && args.len() == 1 -> indexed_pair = true
            }
            else -> {}
        }
    }
    owns_source := jet_codegen_for_in_owns_source(builder, program, source_kind, collection) || owns_indexed_source
    effective_by_value := owns_source || by_value
    source_expression := if method_kind != None -> source else -> collection
    source_value := if source_expression.kind == {
        .Local(local) -> if {
            // A read-only alias names another value's slot: the cursor reads
            // (and so copies) it instead of moving the slot out of its owner.
            owns_source && !indexed_pair && source_kind != MIRLoopSourceKind.ChannelReceiver && !jet_codegen_local_is_read_alias(builder, program, local) -> {
                place := jet_codegen_lower_local_place(&builder, program, local)
                jet_codegen_retain_place_access(&builder, program, place, MIRAccess.Move)
                jet_codegen_emit_value(&builder, program, source_expression.span, source_expression.ty, MIROperation.MovePlace{place: place})
            } else -> jet_codegen_lower_expr(&builder, program, source_expression)
        }
        else -> jet_codegen_lower_expr(&builder, program, source_expression)
    }
    step_value := MIRValueID?{None}
    if step == {
        .None -> {}
        .Val(step_expr) -> step_value = Val(jet_codegen_lower_expr(&builder, program, step_expr))
    }
    byte_slice_cursor := source_kind == MIRLoopSourceKind.Plain && !effective_by_value && !indexed_pair && jet_codegen_for_in_byte_sequence(collection.ty)
    cursor_type := if byte_slice_cursor -> Type.Named{name: "ByteIterCursor"} else -> Type.Named{name: "IterCursor"}
    cursor := jet_codegen_emit_value(&builder, program, span, cursor_type, MIROperation.LoopIterInit{call: iter_init_call, collection: source_value, step: step_value, by_value: effective_by_value, source_kind: source_kind})
    item_type := jet_codegen_for_in_item_type(collection, method_kind)

    loop_scope_depth := builder.scope_depth
    jet_codegen_enter_lexical(&builder, program)
    sequence_index_place := MIRPlaceID?{None}
    if indexed_pair {
        index_local := tir_user_local("for_in_index_{span.start}", span)
        index_place := jet_codegen_bind_local(&builder, program, index_local, Type.Int, true, None, None, false)
        zero := jet_codegen_emit_value(&builder, program, span, Type.Int, MIROperation.Constant{value: mir_integer_constant(0, None, None)})
        _ := jet_codegen_emit(&builder, program, span, None, MIROperation.WritePlace{place: index_place, value: zero})
        sequence_index_place = Val(index_place)
    }
    first_type := if indexed_pair -> Type.Int else -> item_type
    second_type := item_type
    if variable_two != None && !indexed_pair {
        if collection.ty == {
            .Map(key, _, value) -> {
                first_type = key
                second_type = value
            }
            else -> {
                first_type = jet_codegen_for_in_tuple_field_type(item_type, "key")
                second_type = jet_codegen_for_in_tuple_field_type(item_type, "value")
            }
        }
    }
    first_place := jet_codegen_bind_local(&builder, program, variable, first_type, false, None, None, false)
    second_place := MIRPlaceID?{None}
    if variable_two == .Val(second_local) -> second_place = Val(jet_codegen_bind_local(&builder, program, second_local, second_type, false, None, None, false))
    condition_block := jet_codegen_new_block(&builder, program, span, "for-in-condition")
    body_block := jet_codegen_new_block(&builder, program, span, "for-in-body")
    advance_block := jet_codegen_new_block(&builder, program, span, "for-in-advance")
    exit_block := jet_codegen_new_block(&builder, program, span, "for-in-exit")
    jet_codegen_terminate(&builder, program, MIRTerminator.Jump{target: condition_block})
    jet_codegen_switch_block(&builder, program, condition_block)
    has_next := jet_codegen_emit_value(&builder, program, span, Type.Bool, MIROperation.LoopIterHasNext{call: iter_has_next_call, cursor: cursor})
    jet_codegen_terminate(&builder, program, MIRTerminator.Branch{condition: has_next, then_target: body_block, else_target: exit_block})
    &builder.loops.push(JetCodegenLoopTarget{label: label, break_target: exit_block, continue_target: advance_block, break_scope_depth: loop_scope_depth, continue_scope_depth: builder.scope_depth, break_cleanup_depth: builder.cleanup_frames.len(), continue_cleanup_depth: builder.cleanup_frames.len(), break_seen: false})
    jet_codegen_switch_block(&builder, program, body_block)
    item := jet_codegen_emit_value(&builder, program, span, item_type, MIROperation.LoopIterValue{call: iter_value_call, cursor: cursor})
    if {
        variable_two == None -> {
            _ := jet_codegen_emit(&builder, program, span, None, MIROperation.WritePlace{place: first_place, value: item})
        }
        indexed_pair -> {
            index_place :: sequence_index_place ?? panic("checked indexed for-in lost its index local")
            key := jet_codegen_emit_value(&builder, program, span, Type.Int, MIROperation.ReadPlace{place: index_place})
            _ := jet_codegen_emit(&builder, program, span, None, MIROperation.WritePlace{place: first_place, value: key})
            value_place :: second_place ?? panic("checked indexed for-in lost its item local")
            _ := jet_codegen_emit(&builder, program, span, None, MIROperation.WritePlace{place: value_place, value: item})
        }
        else -> {
            first_field := "key"
            second_field := "value"
            key_field :: jet_codegen_for_in_tuple_field_id(builder, program, item_type, first_field)
            key := jet_codegen_emit_value(&builder, program, span, first_type, MIROperation.Field{base: item, field: key_field})
            value_field :: jet_codegen_for_in_tuple_field_id(builder, program, item_type, second_field)
            value := jet_codegen_emit_value(&builder, program, span, second_type, MIROperation.Field{base: item, field: value_field})
            _ := jet_codegen_emit(&builder, program, span, None, MIROperation.WritePlace{place: first_place, value: key})
            value_place :: second_place ?? panic("checked pair for-in lost its value local")
            _ := jet_codegen_emit(&builder, program, span, None, MIROperation.WritePlace{place: value_place, value: value})
        }
    }
    jet_codegen_lower_block(&builder, program, body)
    if jet_codegen_current_is_open(builder, program) -> jet_codegen_terminate(&builder, program, MIRTerminator.Jump{target: advance_block})
    jet_codegen_switch_block(&builder, program, advance_block)
    _ := jet_codegen_emit(&builder, program, span, None, MIROperation.LoopIterAdvance{call: iter_advance_call, cursor: cursor})
    if indexed_pair {
        index_place :: sequence_index_place ?? panic("checked indexed for-in lost its index local")
        current_index := jet_codegen_emit_value(&builder, program, span, Type.Int, MIROperation.ReadPlace{place: index_place})
        delta := if step_value == {
            .None -> jet_codegen_emit_value(&builder, program, span, Type.Int, MIROperation.Constant{value: mir_integer_constant(1, None, None)})
            .Val(value) -> {
                step_expr :: step ?? panic("checked for-in step disappeared")
                int_ty :: jet_codegen_lower_type_for_function(Type.Int, builder, program)
                if type_identity_key(step_expr.ty) == type_identity_key(Type.Int) -> value else -> jet_codegen_emit_value(&builder, program, span, Type.Int, MIROperation.Convert{value: value, parameters: [MIRValueID]{}, target: int_ty, conversion: MIRConversion.NumericCast})
            }
        }
        add_dispatch :: jet_codegen_binary_dispatch(&builder, program, TBinaryOp.Add, false, Type.Int, span, 0)
        next_index := jet_codegen_emit_value(&builder, program, span, Type.Int, MIROperation.Binary{op: MIRBinaryOp.Add, dispatch: add_dispatch, overflow: MIRBinaryOverflow.Unchecked, left: current_index, right: delta})
        _ := jet_codegen_emit(&builder, program, span, None, MIROperation.WritePlace{place: index_place, value: next_index})
    }
    if jet_codegen_current_is_open(builder, program) -> jet_codegen_terminate(&builder, program, MIRTerminator.Jump{target: condition_block})
    _ := &builder.loops.pop()
    jet_codegen_switch_block(&builder, program, exit_block)
    _ := jet_codegen_emit(&builder, program, span, None, MIROperation.Drop{value: cursor, kind: MIRDropKind.Value})
    jet_codegen_leave_lexical(&builder, program)
}


fn jet_codegen_lower_range_loop(builder: &JetCodegenBuilder, program: JetCodegenProgram, label: String?, local: TLocal, source: TExpr?, start: TExpr, end: TExpr, step: TExpr?, exclusive: Bool, vectorization: AutoVectorizationFacts?, body: [TStmt], span: Span) {
    if source == {
        None -> jet_codegen_lower_numeric_range_loop(&builder, program, label, local, start, end, step, exclusive, vectorization, body, span)
        Val(collection) -> jet_codegen_lower_iter_range_loop(&builder, program, label, local, collection, start.ty, step, vectorization, body, span)
    }
}


fn jet_codegen_assignment_place_type(builder: JetCodegenBuilder, program: JetCodegenProgram, place: TPlace) -> Type Never! {
    if place == {
        .Local(local) -> {
            found :: jet_codegen_find_binding_for_local(builder, program, local)
            if found == .Val(binding_value) -> return binding_value.ty
            local.persist_ty ?? panic("checked assignment place has no MIR local type")
        }
        .Expr(value) -> value.ty
    }
}

fn jet_codegen_assignment_destination_is_string_view(builder: JetCodegenBuilder, program: JetCodegenProgram, place: TPlace) -> Bool Never! {
    if place == {
        .Local(local) -> return jet_codegen_is_string_view_local(builder, program, local)
        .Expr(place_value) -> return if place_value.kind == {
            .Local(local) -> jet_codegen_is_string_view_local(builder, program, local)
            else -> false
        }
    }
}

fn jet_codegen_assignment_value(builder: &JetCodegenBuilder, program: JetCodegenProgram, value: TExpr, clone_value: Bool, destination_is_view: Bool, span: Span) -> MIRValueID {
    lowered := jet_codegen_lower_expr(&builder, program, value)
    if !clone_value -> return lowered
    fact := MIRCopyFact.Materialize
    if jet_codegen_is_string_view_value(builder, program, value) && !destination_is_view -> fact = MIRCopyFact.ViewMaterialize
    jet_codegen_emit_value(&builder, program, span, value.ty, MIROperation.Copy{value: lowered, fact: fact})
}

fn jet_codegen_lower_index_assign(builder: &JetCodegenBuilder, program: JetCodegenProgram, uninit: Bool, base: TExpr, index: TExpr, is_map: Bool, value: TExpr, span: Span) {
    right := jet_codegen_lower_expr(&builder, program, value)
    kind := if {
        uninit -> MIRIndexKind.FixedListProof
        is_map -> MIRIndexKind.Map
        else -> MIRIndexKind.List
    }
    tir_kind := if {
        kind == MIRIndexKind.FixedListProof -> TIndexKind.FixedListProof
        kind == MIRIndexKind.Map -> TIndexKind.Map
        else -> TIndexKind.List
    }
    result_type := jet_codegen_index_element_type(base.ty, kind)
    location := jet_codegen_assignment_panic_location(&builder, program, span, kind == MIRIndexKind.Map)
    place := jet_codegen_index_place(&builder, program, base, index, tir_kind, result_type, MIRAccess.Write, location, span)
    _ := jet_codegen_emit(&builder, program, span, None, MIROperation.WritePlace{place: place, value: right})
    jet_codegen_drop_temporary_shared_guard(&builder, program, place, span)
}

// Rust: crates/jet-codegen/src/Codegen/TIR/mir.rs::LowerCtx::is_core_file_owner
fn jet_codegen_is_core_file_owner_type(builder: JetCodegenBuilder, program: JetCodegenProgram, ty: Type) -> Bool Never! {
    name := if ty == {
        .Named(value) | .Apply(value, _) -> value
        else -> { return false }
    }
    is_file_owner_name := name == "FileReader" || name == "FileWriter" || name == "TempDir" || name == "TempFile" || name == "FileLock"
    if !is_file_owner_name {
        is_file_owner_name = name.ends_with("::FileReader") || name.ends_with("::FileWriter") || name.ends_with("::TempDir") ||
            name.ends_with("::TempFile") || name.ends_with("::FileLock")
    }
    if !is_file_owner_name -> return false
    identity := jet_codegen_find_nominal_identity(program.nominals, builder.function.module_identity, name, builder.generic_type_names)
    if identity == None -> return false
    owner :: identity ?? return false
    module_index :: program.owners.hooks.module_positions.get(owner.module_identity) ?? return false
    program.modules[module_index].module_name == "core.files"
}

fn jet_codegen_is_shared_guard_mir_type(ty: MIRType) -> Bool Never! {
    if ty.kind == {
        .Tagged(_, inner) -> jet_codegen_is_shared_guard_mir_type(inner)
        .Apply(name, _) -> name.name == "SharedGuard" || name.name.ends_with("::SharedGuard")
        else -> false
    }
}

fn jet_codegen_drop_temporary_shared_guard(builder: &JetCodegenBuilder, program: JetCodegenProgram, place: MIRPlaceID, span: Span) Never! {
    row := jet_codegen_find_place(builder, program, place)
    if row == None -> return
    place_row :: row ?? return
    if place_row.base == {
        .Temporary(value) -> {
            loop fact in builder.values {
                if fact.id == value {
                    if jet_codegen_is_shared_guard_mir_type(fact.ty) && fact.ownership.drop != MIRDropKind.NoDrop {
                        _ := jet_codegen_emit(&builder, program, span, None, MIROperation.Drop{value: value, kind: fact.ownership.drop})
                    }
                    return
                }
            }
        }
        else -> return
    }
}

fn jet_codegen_lower_index_field_assign(builder: &JetCodegenBuilder, program: JetCodegenProgram, assign: TIndexFieldAssign, span: Span) {
    right := jet_codegen_assignment_value(&builder, program, assign.value, assign.clone_value, false, span)
    kind := if assign.is_map -> MIRIndexKind.Map else -> MIRIndexKind.List
    tir_kind := if assign.is_map -> TIndexKind.Map else -> TIndexKind.List
    element_type := jet_codegen_index_element_type(assign.base.ty, kind)
    location := jet_codegen_assignment_panic_location(&builder, program, span, assign.is_map)
    base_place := jet_codegen_index_place(&builder, program, assign.base, assign.index, tir_kind, element_type, MIRAccess.Write, location, span)
    resolved := jet_codegen_resolve_field_by_name(program.modules, program.nominals, builder.function.module_identity, builder.generic_type_names, element_type, assign.field, builder.function.key)
    place := jet_codegen_project_field_place(&builder, program, base_place, span, assign.field_ty, jet_codegen_mir_field_id(resolved))
    assigned := if assign.op == {
        None -> right
        Val(operation) -> {
            old := jet_codegen_emit_value(&builder, program, span, assign.field_ty, MIROperation.ReadPlace{place: place})
            overflow := jet_codegen_assignment_overflow(operation, assign.field_ty, assign.value.ty)
            dispatch := jet_codegen_binary_dispatch(&builder, program, operation, overflow, assign.field_ty, span, assign.line)
            mir_overflow := MIRBinaryOverflow.Unchecked
            if overflow && jet_codegen_fixed_width(assign.field_ty) != None -> mir_overflow = MIRBinaryOverflow.Trap
            jet_codegen_emit_value(&builder, program, span, assign.field_ty, MIROperation.Binary{op: jet_codegen_lower_binary(operation), dispatch: dispatch, overflow: mir_overflow, left: old, right: right})
        }
    }
    // Native deferred File cleanup tracks record/tuple roots, not container contents.
    owning_file_slot := jet_codegen_is_core_file_owner_type(builder, program, assign.field_ty)
    if {
        owning_file_slot -> {
            _ := jet_codegen_emit(&builder, program, span, None, MIROperation.ReplacePlace{place: place, value: assigned})
        } else -> {
            _ := jet_codegen_emit(&builder, program, span, None, MIROperation.WritePlace{place: place, value: assigned})
        }
    }
    jet_codegen_drop_temporary_shared_guard(&builder, program, place, span)
}

fn jet_codegen_lower_math_swizzle_assign(builder: &JetCodegenBuilder, program: JetCodegenProgram, base: TExpr, lanes: [Int], value: TExpr, clone_value: Bool, span: Span) {
    if lanes.len() == 0 -> panic("checked swizzle assignment has no lanes")
    right := jet_codegen_lower_expr(&builder, program, value)
    right_values := [MIRValueID]{}
    right_type := value.ty
    if {
        lanes.len() > 1 -> {
            right_type_name := if value.ty == {
                .Named(name) -> name
                else -> panic("checked multi-lane swizzle assignment has no vector RHS")
            }
            scalar_ty := jet_codegen_math_scalar_type(right_type_name)
            carrier := jet_codegen_failure_carrier_for_type(scalar_ty)
            source := jet_codegen_source_location_at(&builder, program, span, true)
            source_line := source.source_line ?? ""
            location := MIRPanicLoc{file: mir_source_file_id(builder.function.source_file), line: source.line, column: 0}
            context := MIRPanicContext{function: builder.function.name, source_line: source_line, caret: 0, locals: [MIRPanicLocal]{}}
            call := jet_codegen_lane_index_route(&builder, program, right_type_name, scalar_ty, carrier)
            ordinal := 0
            loop ordinal < lanes.len() {
                lane_index := jet_codegen_emit_value(&builder, program, span, Type.Int, MIROperation.Constant{value: mir_integer_constant(ordinal, None, None)})
                &right_values.push(jet_codegen_emit_value(&builder, program, span, scalar_ty, MIROperation.Index{call: call, base: right, index: lane_index, kind: MIRIndexKind.Lane, access: MIRAccess.Read, location: location, context: context}))
                ordinal += 1
            }
            right_type = scalar_ty
        } else -> {
            &right_values.push(right)
        }
    }
    places := jet_codegen_swizzle_places(&builder, program, base, lanes, MIRAccess.Write, span)
    index := 0
    loop index < places.len() {
        lane_value := right_values[index]
        if clone_value || index + 1 < lanes.len() -> lane_value = jet_codegen_emit_value(&builder, program, span, right_type, MIROperation.Copy{value: lane_value, fact: MIRCopyFact.Materialize})
        _ := jet_codegen_emit(&builder, program, span, None, MIROperation.WritePlace{place: places[index], value: lane_value})
        index += 1
    }
}


// Scalar row chains retain catalog order and duplicate candidates without
// copying owning nominal, impl, or trait declaration records at each query.
struct JetCodegenHookNominalRow {
    module_index: Int
    nominal_index: Int
    next_owner: Int
    next_trait: Int
}

struct JetCodegenHookImplMethodRow {
    module_index: Int
    implementation_index: Int
    method_index: Int
    next_exact: Int
    next_fallback: Int
}

struct JetCodegenHookTraitMethodRow {
    module_index: Int
    definition_index: Int
    method_index: Int
    next: Int
}

struct JetCodegenHookIndex {
    module_positions: [String:Int]
    nominal_rows: [JetCodegenHookNominalRow]
    nominal_by_owner: [String:Int]
    traits_by_name: [String:Int]
    implementation_rows: [JetCodegenHookImplMethodRow]
    exact_methods: [String:Int]
    fallback_methods: [String:Int]
    trait_method_rows: [JetCodegenHookTraitMethodRow]
    trait_methods: [String:Int]
}

// Rust: none (Jet-only pass)
fn jet_codegen_hook_method_key(owner: String, trait_name: String, method_name: String) -> String Never! {
    jet_codegen_qualified_function_key(owner, jet_codegen_qualified_function_key(trait_name, method_name))
}

// Rust: none (Jet-only pass)
fn jet_codegen_hook_index(modules: [SemaGraphModuleResult]) -> JetCodegenHookIndex Never! {
    module_positions := [String:Int]{}
    nominal_rows := [JetCodegenHookNominalRow]{}
    nominal_by_owner := [String:Int]{}
    traits_by_name := [String:Int]{}
    implementation_rows := [JetCodegenHookImplMethodRow]{}
    exact_methods := [String:Int]{}
    fallback_methods := [String:Int]{}
    trait_method_rows := [JetCodegenHookTraitMethodRow]{}
    trait_methods := [String:Int]{}
    module_index := modules.len() - 1
    loop module_index >= 0 {
        module_identity :: modules[module_index].module_identity
        module_positions[module_identity] = module_index
        nominal_index := modules[module_index].nominals.len() - 1
        loop nominal_index >= 0 {
            name :: modules[module_index].nominals[nominal_index].symbol.name
            owner_key :: jet_codegen_qualified_function_key(module_identity, name)
            is_trait := modules[module_index].nominals[nominal_index].kind == SemaRegistrationNominalKind.Trait
            row := nominal_rows.len()
            &nominal_rows.push(JetCodegenHookNominalRow{
                module_index: module_index,
                nominal_index: nominal_index,
                next_owner: nominal_by_owner.get(owner_key) ?? -1,
                next_trait: if is_trait -> traits_by_name.get(name) ?? -1 else -> -1,
            })
            nominal_by_owner[owner_key] = row
            if is_trait -> traits_by_name[name] = row
            nominal_index -= 1
        }
        implementation_index := modules[module_index].impls.len() - 1
        loop implementation_index >= 0 {
            if modules[module_index].impls[implementation_index].trait_symbol == .Val(trait_symbol) {
                method_index := modules[module_index].impls[implementation_index].methods.len() - 1
                loop method_index >= 0 {
                    method_name :: modules[module_index].impls[implementation_index].methods[method_index].symbol.name
                    exact_key :: jet_codegen_hook_method_key(modules[module_index].impls[implementation_index].target_identity_key, trait_symbol.name, method_name)
                    fallback_key := String?{None}
                    if modules[module_index].impls[implementation_index].target_module_identity == .Val(target_module) {
                        owner_key :: jet_codegen_qualified_function_key(target_module, modules[module_index].impls[implementation_index].target_type_name)
                        fallback_key = Val(jet_codegen_hook_method_key(owner_key, trait_symbol.name, method_name))
                    }
                    row := implementation_rows.len()
                    &implementation_rows.push(JetCodegenHookImplMethodRow{
                        module_index: module_index,
                        implementation_index: implementation_index,
                        method_index: method_index,
                        next_exact: exact_methods.get(exact_key) ?? -1,
                        next_fallback: if fallback_key == .Val(key) -> fallback_methods.get(key) ?? -1 else -> -1,
                    })
                    exact_methods[exact_key] = row
                    if fallback_key == .Val(key) -> fallback_methods[key] = row
                    method_index -= 1
                }
            }
            implementation_index -= 1
        }
        definition_index := modules[module_index].declarations.traits.len() - 1
        loop definition_index >= 0 {
            trait_name :: modules[module_index].declarations.traits[definition_index].name
            method_index := modules[module_index].declarations.traits[definition_index].methods.len() - 1
            loop method_index >= 0 {
                method_name :: modules[module_index].declarations.traits[definition_index].methods[method_index].name
                key :: jet_codegen_hook_method_key("{module_index}", trait_name, method_name)
                row := trait_method_rows.len()
                &trait_method_rows.push(JetCodegenHookTraitMethodRow{
                    module_index: module_index,
                    definition_index: definition_index,
                    method_index: method_index,
                    next: trait_methods.get(key) ?? -1,
                })
                trait_methods[key] = row
                method_index -= 1
            }
            definition_index -= 1
        }
        module_index -= 1
    }
    JetCodegenHookIndex{
        module_positions: module_positions,
        nominal_rows: nominal_rows,
        nominal_by_owner: nominal_by_owner,
        traits_by_name: traits_by_name,
        implementation_rows: implementation_rows,
        exact_methods: exact_methods,
        fallback_methods: fallback_methods,
        trait_method_rows: trait_method_rows,
        trait_methods: trait_methods,
    }
}

struct JetCodegenIndexHookTraitMethod {
    symbol: SymbolID
    trait_key: String
    method: TTraitMethod
}

fn jet_codegen_index_hook_owner_name(ty: Type) -> String? {
    if ty == {
        .Named(name) | .Apply(name, _) -> return Val(name)
        .Tagged(_, inner) -> return jet_codegen_index_hook_owner_name(inner)
        .TraitObject(_) -> return None
        else -> return None
    }
}

// Rust: crates/jet-codegen/src/Codegen/TIR/tir_to_mir_expr.rs::lower_index_hook
fn jet_codegen_index_hook_function(builder: JetCodegenBuilder, program: JetCodegenProgram, owner_type: Type, trait_name: String, method_name: String) -> TFunc? {
    owner_name_option := jet_codegen_index_hook_owner_name(owner_type)
    if owner_name_option == None -> return None
    owner_name :: owner_name_option ?? return None
    if builder.generic_type_names.contains(owner_name) -> return None
    owner_identity_option := jet_codegen_find_nominal_identity(program.nominals, builder.function.module_identity, owner_name, builder.generic_type_names)
    if owner_identity_option == None -> return None
    owner_identity :: owner_identity_option ?? return None
    owner_key :: jet_codegen_qualified_function_key(owner_identity.module_identity, owner_identity.name)
    owner_row :: program.owners.hooks.nominal_by_owner.get(owner_key) ?? panic("checked {trait_name} receiver identity disappeared")
    if program.owners.hooks.nominal_rows[owner_row].next_owner >= 0 -> panic("ambiguous checked {trait_name} receiver identity")
    module_index :: program.owners.hooks.nominal_rows[owner_row].module_index
    nominal_index :: program.owners.hooks.nominal_rows[owner_row].nominal_index
    target_identity_key :: program.modules[module_index].nominals[nominal_index].identity_key
    exact_method_key := String?{None}
    fallback_method_key := String?{None}
    exact_key :: jet_codegen_hook_method_key(target_identity_key, trait_name, method_name)
    row := program.owners.hooks.exact_methods.get(exact_key) ?? -1
    loop row >= 0 {
        if exact_method_key != None -> panic("ambiguous checked {trait_name}::{method_name} implementation")
        candidate :: program.owners.hooks.implementation_rows[row]
        exact_method_key = Val(program.modules[candidate.module_index].impls[candidate.implementation_index].methods[candidate.method_index].symbol.id.key)
        row = candidate.next_exact
    }
    fallback_key :: jet_codegen_hook_method_key(owner_key, trait_name, method_name)
    row = program.owners.hooks.fallback_methods.get(fallback_key) ?? -1
    loop row >= 0 {
        candidate :: program.owners.hooks.implementation_rows[row]
        if program.modules[candidate.module_index].impls[candidate.implementation_index].target_identity_key != target_identity_key {
            if fallback_method_key != None -> panic("ambiguous checked {trait_name}::{method_name} implementation")
            fallback_method_key = Val(program.modules[candidate.module_index].impls[candidate.implementation_index].methods[candidate.method_index].symbol.id.key)
        }
        row = candidate.next_fallback
    }
    method_key :: exact_method_key ?? (fallback_method_key ?? panic("checked {trait_name} receiver has no registered {method_name} implementation"))
    Val(jet_codegen_find_function(program.function_index, method_key) ?? panic("checked {trait_name}::{method_name} function is not reachable"))
}

// Rust: crates/jet-codegen/src/Codegen/TIR/mir.rs::LowerCtx::trait_method_identity
fn jet_codegen_index_hook_trait_method(builder: JetCodegenBuilder, program: JetCodegenProgram, owner_type: Type, required_symbol: SymbolID?, trait_name: String, method_name: String) -> JetCodegenIndexHookTraitMethod Never! {
    owner_name := jet_codegen_index_hook_owner_name(owner_type) ?? ""
    concrete_owner := owner_name != "" && !builder.generic_type_names.contains(owner_name)
    trait_object_bound := false
    if owner_type == {
        .TraitObject(bounds) -> trait_object_bound = bounds.contains(trait_name)
        else -> {}
    }
    bound_symbols := [String]{}
    loop parameter in builder.function.generic_params {
        if parameter.name == owner_name {
            loop bound in parameter.bounds -> &bound_symbols.push(bound.key)
        }
    }
    required_key := ""
    if required_symbol != None {
        symbol :: required_symbol
        required_key = symbol.key
    }
    selected := JetCodegenIndexHookTraitMethod?{None}
    row := program.owners.hooks.traits_by_name.get(trait_name) ?? -1
    loop row >= 0 {
        candidate :: program.owners.hooks.nominal_rows[row]
        row = candidate.next_trait
        symbol :: program.modules[candidate.module_index].nominals[candidate.nominal_index].symbol.id
        if {
            required_symbol != None -> {
                if symbol.key != required_key -> next
            }
            !trait_object_bound && !concrete_owner && !bound_symbols.contains(symbol.key) -> {
                next
            }
        }
        key :: jet_codegen_hook_method_key("{candidate.module_index}", trait_name, method_name)
        method_row := program.owners.hooks.trait_methods.get(key) ?? -1
        loop method_row >= 0 {
            if selected != None -> panic("ambiguous checked {trait_name}::{method_name} trait identity")
            method_candidate :: program.owners.hooks.trait_method_rows[method_row]
            selected = Val(JetCodegenIndexHookTraitMethod{
                symbol: symbol,
                trait_key: program.modules[method_candidate.module_index].declarations.traits[method_candidate.definition_index].key,
                method: program.modules[method_candidate.module_index].declarations.traits[method_candidate.definition_index].methods[method_candidate.method_index],
            })
            method_row = method_candidate.next
        }
    }
    selected ?? panic("checked {trait_name} receiver has no checked {trait_name} bound or trait method")
}

fn jet_codegen_index_hook_trait_callee(builder: JetCodegenBuilder, program: JetCodegenProgram, trait_method: JetCodegenIndexHookTraitMethod, owner: MIRType) -> MIRCallee Never! {
    trait_ref := jet_codegen_mir_trait_ref_for_symbol(program.modules, program.nominals, trait_method.symbol)
    method_id := MIRTraitMethodID{value: stable_id("mir-trait-method", "{trait_method.trait_key}::{trait_method.method.key}")}
    MIRCallee.TraitMethod{method: method_id, trait_ref: trait_ref, receiver: owner}
}

fn jet_codegen_lower_index_hook_assign(builder: &JetCodegenBuilder, program: JetCodegenProgram, base: TExpr, index: TExpr, value: TExpr, span: Span) {
    direct_target := jet_codegen_index_hook_function(builder, program, base.ty, "IndexMut", "set")
    trait_target := JetCodegenIndexHookTraitMethod?{None}
    access := MIRAccess.Read
    if {
        direct_target != None -> {
            target :: direct_target ?? panic("checked IndexMut implementation disappeared")
            access = if target.kind == {
                .Method(convention, _) -> jet_codegen_lower_access(convention ?? panic("checked IndexMut::set has no receiver convention"))
                .TraitMethod(_, convention, _, trait_symbol, _) -> {
                    trait_target = Val(jet_codegen_index_hook_trait_method(builder, program, base.ty, Val(trait_symbol), "IndexMut", "set"))
                    jet_codegen_lower_access(convention ?? panic("checked IndexMut::set has no receiver convention"))
                }
                else -> panic("checked IndexMut::set target is not an instance method")
            }
        } else -> {
            trait_method := jet_codegen_index_hook_trait_method(builder, program, base.ty, None, "IndexMut", "set")
            trait_target = Val(trait_method)
            access = jet_codegen_lower_access(trait_method.method.self_access ?? panic("checked IndexMut::set trait method has no receiver convention"))
        }
    }
    receiver_place := MIRPlaceID?{None}
    if access != MIRAccess.Read -> receiver_place = jet_codegen_lower_expression_place(&builder, program, base, access)
    if receiver_place == None && access == MIRAccess.Write {
        receiver_value := jet_codegen_lower_expr(&builder, program, base)
        local := tir_generated_local("index_hook_receiver_{receiver_value.value}", span)
        local.mutable = true
        receiver_temp := jet_codegen_bind_local(&builder, program, local, base.ty, true, None, None, false)
        _ := jet_codegen_emit(&builder, program, span, None, MIROperation.WritePlace{place: receiver_temp, value: receiver_value})
        receiver_place = Val(receiver_temp)
    }
    receiver := if {
        access == MIRAccess.Read -> {
            jet_codegen_lower_expr(&builder, program, base)
        }
        receiver_place == None -> {
            jet_codegen_lower_expr(&builder, program, base)
        }
        else -> {
            place := receiver_place ?? panic("checked IndexMut receiver has no MIR place")
            operation := if access == MIRAccess.Write -> MIROperation.AddressOf{place: place, access: access} else -> MIROperation.MovePlace{place: place}
            jet_codegen_emit_value(&builder, program, span, base.ty, operation)
        }
    }
    receiver_arg := MIRCallArg{
        value: receiver,
        place: if access == MIRAccess.Write -> receiver_place else -> None,
        access: access,
        span: base.span,
        label: None,
        source_index: None,
        binder_slot: Val(0),
        spread: false,
        implicit_clone: false,
        shared_auto_clone: false,
        owned_last_use: access == MIRAccess.Move,
        authority_boundary: false,
        fn_coercion: None,
        widen_fixed_to_list: false,
        widen_to_union: None,
        box_as_trait: None,
    }
    call_args := [TCallArg]{
        TCallArg{value: index, template_items: [SymbolID]{}, borrow: !jet_codegen_is_scalar_type(index.ty), mut_borrow: false, clone: false, arc_clone: false, fn_coerce: None, widen_to_vec: false, widen_to_union: None, box_as_trait: None, label: None, spread: false},
        TCallArg{value: value, template_items: [SymbolID]{}, borrow: !jet_codegen_is_scalar_type(value.ty), mut_borrow: false, clone: false, arc_clone: false, fn_coerce: None, widen_to_vec: false, widen_to_union: None, box_as_trait: None, label: None, spread: false},
    }
    lowered_call_args := if {
        direct_target != None -> {
            target :: direct_target ?? panic("checked IndexMut implementation disappeared")
            jet_codegen_lower_instance_args(&builder, program, call_args, target.params)
        } else -> {
            trait_method :: trait_target ?? panic("checked IndexMut trait method disappeared")
            jet_codegen_lower_trait_method_args(&builder, program, call_args, trait_method.method)
        }
    }
    lowered_args := [MIRCallArg]{receiver_arg}
    loop argument in lowered_call_args -> &lowered_args.push(argument)
    owner := jet_codegen_lower_type_for_function(base.ty, builder, program)
    result_type := Type.Result{ok: Type.Named{name: "Unit"}, err: Type.Named{name: "Err"}}
    callee := if {
        direct_target != None -> {
            target :: direct_target ?? panic("checked IndexMut implementation disappeared")
            if target.kind == {
                .Method(_, _) -> MIRCallee.Method{function: jet_codegen_function_id(target), owner: owner}
                .TraitMethod(_, _, _, _, _) -> {
                    trait_method :: trait_target ?? panic("checked IndexMut trait method disappeared")
                    jet_codegen_index_hook_trait_callee(builder, program, trait_method, owner)
                }
                else -> panic("checked IndexMut::set target is not an instance method")
            }
        } else -> {
            trait_method :: trait_target ?? panic("checked IndexMut trait method disappeared")
            jet_codegen_index_hook_trait_callee(builder, program, trait_method, owner)
        }
    }
    _ := jet_codegen_emit_value(&builder, program, span, result_type, MIROperation.Call{callee: callee, args: lowered_args, type_args: [MIRType]{}})
}



fn jet_codegen_contract_same_local(left: TLocal, right: TLocal) -> Bool Never! {
    if left.symbol_id != None && right.symbol_id != None -> return (left.symbol_id ?? SymbolID{key: ""}).key == (right.symbol_id ?? SymbolID{key: ""}).key
    left.name == right.name
}

fn jet_codegen_contract_unit_type(ty: Type) -> Bool Never! {
    if ty == {
        .Named(name) -> name == "Unit"
        .Tagged(_, inner) -> jet_codegen_contract_unit_type(inner)
        else -> false
    }
}

fn jet_codegen_contract_location(builder: JetCodegenBuilder, program: JetCodegenProgram, contract: TContract) -> MIRPanicLoc Never! {
    if contract.file != builder.function.source_file -> panic("checked contract source differs from its function source")
    MIRPanicLoc{file: mir_source_file_id(contract.file), line: contract.line, column: 0}
}

fn jet_codegen_contract_context(builder: &JetCodegenBuilder, program: JetCodegenProgram, contract: TContract) -> MIRPanicContext Never! {
    previous_span := builder.current_span
    previous_line := builder.current_line
    builder.current_span = contract.span
    builder.current_line = Val(contract.line)
    location := jet_codegen_source_location(builder, program, true)
    builder.current_span = previous_span
    builder.current_line = previous_line
    MIRPanicContext{
        function: builder.function.name,
        source_line: location.source_line ?? panic("checked contract source line disappeared"),
        caret: 0,
        locals: [MIRPanicLocal]{},
    }
}

fn jet_codegen_lower_contract(builder: &JetCodegenBuilder, program: JetCodegenProgram, contract: TContract) {
    if contract.disposition == {
        .Proven | .Stripped -> return
        .Check -> {}
    }
    previous_span := builder.current_span
    previous_line := builder.current_line
    builder.current_span = contract.span
    builder.current_line = Val(contract.line)
    condition := jet_codegen_lower_expr(&builder, program, contract.condition)
    message := jet_codegen_lower_expr(&builder, program, contract.message)
    unit := Type.Named{name: "Unit"}
    call := jet_codegen_intern_route(
        &builder, program,
        MIRPreludeFamily.StaticPrelude,
        "core.require",
        "require",
        "jet_require",
        9,
        [Bool]{false, true, true, false, true, true, false, false, true},
        Val(Effect.Panic),
        TFailureCarrier.Infallible,
        MIRPreludeABI.Control,
    )
    location := jet_codegen_contract_location(builder, program, contract)
    context := jet_codegen_contract_context(&builder, program, contract)
    _ := jet_codegen_lower_conditional_stop(&builder, program, contract.span, unit, call, MIRRequireKind.Require, condition, location, context, [MIRValueID]{message}, "contract")
    builder.current_span = previous_span
    builder.current_line = previous_line
}

fn jet_codegen_contract_write(builder: &JetCodegenBuilder, program: JetCodegenProgram, place: MIRPlaceID, value: MIRValueID, span: Span) Never! {
    writable := jet_codegen_place_access(&builder, program, place, MIRAccess.Write)
    _ := jet_codegen_emit(&builder, program, span, None, MIROperation.WritePlace{place: writable, value: value})
}

fn jet_codegen_contract_return_move(builder: &JetCodegenBuilder, program: JetCodegenProgram, place: MIRPlaceID, ty: Type, span: Span) -> MIRValueID Never! {
    movable := jet_codegen_place_access(&builder, program, place, MIRAccess.Move)
    jet_codegen_emit_value(&builder, program, span, ty, MIROperation.MovePlace{place: movable})
}

fn jet_codegen_lower_contract_posts(builder: &JetCodegenBuilder, program: JetCodegenProgram, state: JetCodegenContractScopeState) {
    loop contract in state.post -> jet_codegen_lower_contract(&builder, program, contract)
}

fn jet_codegen_lower_implicit_contract_return(builder: &JetCodegenBuilder, program: JetCodegenProgram, state: JetCodegenContractScopeState, span: Span) {
    if !jet_codegen_contract_unit_type(state.result.binding_ty) -> panic("checked contract return is missing its value")
    binding_value := jet_codegen_emit_value(&builder, program, span, state.result.binding_ty, MIROperation.Constant{value: MIRConstant.Unit})
    jet_codegen_contract_write(&builder, program, state.binding_place, binding_value, span)
    if state.result.mode == {
        .Direct -> {
            if !jet_codegen_contract_same_local(state.result.carrier_local, state.result.binding_local) -> panic("direct contract result uses separate carrier and binding locals")
        }
        .ResultPayload | .OptionPayload -> {
            carrier_payload := jet_codegen_emit_value(&builder, program, span, state.result.binding_ty, MIROperation.Constant{value: MIRConstant.Unit})
            carrier_value := if state.result.mode == {
                .ResultPayload -> jet_codegen_emit_value(&builder, program, span, state.result.carrier_ty, MIROperation.ResultOk{value: carrier_payload})
                .OptionPayload -> jet_codegen_emit_value(&builder, program, span, state.result.carrier_ty, MIROperation.Present{value: carrier_payload})
                .Direct -> panic("direct contract result cannot wrap its unit payload")
            }
            jet_codegen_contract_write(&builder, program, state.carrier_place, carrier_value, span)
        }
    }
    jet_codegen_lower_contract_posts(&builder, program, state)
    returned := jet_codegen_contract_return_move(&builder, program, state.carrier_place, state.result.carrier_ty, span)
    terminator := MIRTerminator.Return{value: Val(returned)}
    _ := jet_codegen_terminate_with_owned_cleanup(&builder, program, terminator, -1)
}

fn jet_codegen_lower_contract_return(builder: &JetCodegenBuilder, program: JetCodegenProgram, value: MIRValueID?, span: Span) {
    if !jet_codegen_current_is_open(builder, program) -> return
    if builder.contract_scopes.len() == 0 -> panic("checked contract return has no active scope")
    state := builder.contract_scopes[builder.contract_scopes.len() - 1]
    if value == None -> return jet_codegen_lower_implicit_contract_return(&builder, program, state, span)
    returned_value := value
    if state.result.mode == {
        .Direct -> {
            if !jet_codegen_contract_same_local(state.result.carrier_local, state.result.binding_local) -> panic("direct contract result uses separate carrier and binding locals")
            jet_codegen_contract_write(&builder, program, state.binding_place, returned_value, span)
            jet_codegen_lower_contract_posts(&builder, program, state)
            returned := jet_codegen_contract_return_move(&builder, program, state.carrier_place, state.result.carrier_ty, span)
            terminator := MIRTerminator.Return{value: Val(returned)}
            _ := jet_codegen_terminate_with_owned_cleanup(&builder, program, terminator, -1)
        }
        .ResultPayload | .OptionPayload -> {
            condition := if state.result.mode == {
                .ResultPayload -> jet_codegen_emit_value(&builder, program, span, Type.Bool, MIROperation.ResultIsOk{subject: returned_value})
                .OptionPayload -> jet_codegen_emit_value(&builder, program, span, Type.Bool, MIROperation.OptionIsSome{subject: returned_value})
                .Direct -> panic("direct contract result cannot test a payload carrier")
            }
            success := jet_codegen_new_block(&builder, program, span, "contract.return.success")
            failure := jet_codegen_new_block(&builder, program, span, "contract.return.failure")
            jet_codegen_terminate(&builder, program, MIRTerminator.Branch{condition: condition, then_target: success, else_target: failure})

            jet_codegen_switch_block(&builder, program, success)
            jet_codegen_contract_write(&builder, program, state.carrier_place, returned_value, span)
            readable := jet_codegen_place_access(&builder, program, state.carrier_place, MIRAccess.Read)
            carrier_copy := jet_codegen_emit_value(&builder, program, span, state.result.carrier_ty, MIROperation.ReadPlace{place: readable})
            binding := if state.result.mode == {
                .ResultPayload -> jet_codegen_emit_value(&builder, program, span, state.result.binding_ty, MIROperation.ResultValue{subject: carrier_copy, ok: true})
                .OptionPayload -> jet_codegen_emit_value(&builder, program, span, state.result.binding_ty, MIROperation.OptionValue{subject: carrier_copy})
                .Direct -> panic("direct contract result cannot extract a payload")
            }
            jet_codegen_contract_write(&builder, program, state.binding_place, binding, span)
            jet_codegen_lower_contract_posts(&builder, program, state)
            success_return := jet_codegen_contract_return_move(&builder, program, state.carrier_place, state.result.carrier_ty, span)
            terminator := MIRTerminator.Return{value: Val(success_return)}
            _ := jet_codegen_terminate_with_owned_cleanup(&builder, program, terminator, -1)

            jet_codegen_switch_block(&builder, program, failure)
            jet_codegen_contract_write(&builder, program, state.carrier_place, returned_value, span)
            failure_return := jet_codegen_contract_return_move(&builder, program, state.carrier_place, state.result.carrier_ty, span)
            failure_terminator := MIRTerminator.Return{value: Val(failure_return)}
            _ := jet_codegen_terminate_with_owned_cleanup(&builder, program, failure_terminator, -1)
        }
    }
}

fn jet_codegen_lower_contract_scope(builder: &JetCodegenBuilder, program: JetCodegenProgram, pre: [TContract], body: [TStmt], post: [TContract], result: TContractResult, span: Span) {
    loop contract in pre -> jet_codegen_lower_contract(&builder, program, contract)
    if !jet_codegen_contract_same_local(result.carrier_local, result.binding_local) && result.mode == TContractResultMode.Direct -> panic("direct contract result uses separate carrier and binding locals")
    jet_codegen_enter_lexical(&builder, program)
    carrier_place := jet_codegen_bind_local(&builder, program, result.carrier_local, result.carrier_ty, false, None, None, false)
    binding_place := carrier_place
    if !jet_codegen_contract_same_local(result.carrier_local, result.binding_local) {
        binding_place = jet_codegen_bind_local(&builder, program, result.binding_local, result.binding_ty, false, None, None, false)
    }
    &builder.contract_scopes.push(JetCodegenContractScopeState{result: result, carrier_place: carrier_place, binding_place: binding_place, post: post})
    jet_codegen_lower_statements(&builder, program, body)
    if jet_codegen_current_is_open(builder, program) -> jet_codegen_lower_contract_return(&builder, program, None, span)
    _ := &builder.contract_scopes.pop()
    jet_codegen_leave_lexical(&builder, program)
}

fn jet_codegen_lower_loop_value(builder: &JetCodegenBuilder, program: JetCodegenProgram, label: String?, body: [TStmt], result_type: Type, span: Span) -> MIRValueID {
    header := jet_codegen_new_block(&builder, program, span, "loop.header")
    body_block := jet_codegen_new_block(&builder, program, span, "loop.body")
    exit_block := jet_codegen_new_block(&builder, program, span, "loop.exit")
    jet_codegen_terminate(&builder, program, MIRTerminator.Jump{target: header})
    jet_codegen_switch_block(&builder, program, header)
    jet_codegen_terminate(&builder, program, MIRTerminator.Jump{target: body_block})

    loop_scope_depth := builder.scope_depth
    cleanup_depth := builder.cleanup_frames.len()
    &builder.loops.push(JetCodegenLoopTarget{
        label: label,
        break_target: exit_block,
        continue_target: header,
        break_scope_depth: loop_scope_depth,
        continue_scope_depth: loop_scope_depth,
        break_cleanup_depth: cleanup_depth,
        continue_cleanup_depth: cleanup_depth,
        break_seen: false,
    })
    jet_codegen_switch_block(&builder, program, body_block)
    jet_codegen_lower_block(&builder, program, body)
    if jet_codegen_current_is_open(builder, program) -> jet_codegen_terminate(&builder, program, MIRTerminator.Jump{target: header})
    _ := &builder.loops.pop()

    incoming := [MIRPhiIncoming]{}
    value_less_break := false
    loop candidate in builder.blocks {
        if candidate.terminator == {
            .Break(target, value) && target == exit_block -> {
                if {
                    value == None -> {
                        value_less_break = true
                    } else -> {
                        payload :: value
                        &incoming.push(MIRPhiIncoming{block: candidate.id, value: payload})
                    }
                }
            }
            else -> {}
        }
    }
    if value_less_break || incoming.len() == 0 -> panic("TExprKind::InlineBlock result loop has a break exit without a value")
    jet_codegen_switch_block(&builder, program, exit_block)
    jet_codegen_emit_value(&builder, program, span, result_type, MIROperation.Phi{incoming: incoming})
}


// Rust tir_to_mir_expr.rs lower_inline_block: the prefix lowers as nested
// statements of the enclosing scope (no lexical scope of its own), so a local
// the block declares lives until the enclosing scope ends. A scope here would
// drop that local before the tail value it feeds is used: a collecting loop
// passed as a borrowed argument (`f(loop _ in xs -> false)`) borrows its
// `__jet_collect_*` local after the scope-exit Drop released it.
fn jet_codegen_lower_inline_block(builder: &JetCodegenBuilder, program: JetCodegenProgram, expression: TExpr, body: [TStmt]) -> MIRValueID {
    if body.len() == 0 -> panic("checked inline contract block has no tail expression")
    if expression.ty == (Type.Named{name: "Never"}) {
        jet_codegen_lower_statements(&builder, program, body)
        if jet_codegen_current_is_open(builder, program) -> panic("checked divergent inline block did not terminate")
        return jet_codegen_emit_value(&builder, program, expression.span, expression.ty, MIROperation.Constant{value: MIRConstant.Unit})
    }
    index := 0
    loop index + 1 < body.len() {
        jet_codegen_lower_statement(&builder, program, body[index])
        if !jet_codegen_current_is_open(builder, program) -> panic("checked inline contract block terminates before its result")
        index += 1
    }
    result := if body[body.len() - 1] == {
        .ExprStmt(value, _) -> {
            // A Never tail (the `panic(...)` ending a `??` fallback block,
            // e.g. the `if x == None -> panic(...)` guard's refinement, which
            // sema types at the payload) produces no value, so it fits any
            // result type: the Rust lowering lowers the tail as is.
            if value.ty != (Type.Named{name: "Never"}) && type_identity_key(expression.ty) != type_identity_key(value.ty) -> panic("checked inline block result type disagrees with its tail")
            jet_codegen_lower_expr(&builder, program, value)
        }
        .Loop(label, loop_body, span) -> jet_codegen_lower_loop_value(&builder, program, label, loop_body, expression.ty, span)
        .Return(_, _) | .Break(_, _) | .BreakValue(_, _, _) | .Continue(_, _) -> {
            jet_codegen_lower_statement(&builder, program, body[body.len() - 1])
            if jet_codegen_current_is_open(builder, program) -> panic("checked divergent inline tail did not terminate")
            // Control left the block, so its value is never read; like the
            // all-diverging joins, the inert placeholder is a Unit constant at
            // Unit (at the block's own type it mistypes a non-Unit result).
            jet_codegen_emit_value(&builder, program, expression.span, Type.Named{name: "Unit"}, MIROperation.Constant{value: MIRConstant.Unit})
        }
        else -> {
            // Rust lower_inline_block: a statement tail can diverge through
            // an exhaustive table or an if, not only through a syntactic
            // return/break; a Unit block also ends in a statement.
            jet_codegen_lower_statement(&builder, program, body[body.len() - 1])
            if jet_codegen_current_is_open(builder, program) && expression.ty != (Type.Named{name: "Unit"}) -> panic("checked inline contract block has no expression tail")
            jet_codegen_emit_value(&builder, program, expression.span, Type.Named{name: "Unit"}, MIROperation.Constant{value: MIRConstant.Unit})
        }
    }
    result
}


fn jet_codegen_transaction_call_arg(value: TExpr) -> TCallArg Never! {
    TCallArg{
        value: value,
        template_items: [SymbolID]{},
        borrow: false,
        mut_borrow: false,
        clone: false,
        arc_clone: false,
        fn_coerce: None,
        widen_to_vec: false,
        widen_to_union: None,
        box_as_trait: None,
        label: None,
        spread: false,
    }
}

fn jet_codegen_is_unit_type(ty: Type) -> Bool Never! {
    if type_is_unit_callable_return(ty) -> return true
    if ty == {
        .Tuple(fields) -> fields.len() == 0
        else -> false
    }
}

fn jet_codegen_transaction_method_expr(builder: JetCodegenBuilder, program: JetCodegenProgram, local: TLocal, owner: Type, method_ref: TMethodRef, args: [TCallArg], span: Span) -> TExpr Never! {
    function :: jet_codegen_find_function(program.function_index, method_ref.symbol.key) ?? panic("checked Rollback::{method_ref.name} method has no reachable TFunc")
    if function.key != method_ref.symbol.key -> panic("checked Rollback method SymbolId resolved to a different TFunc")
    return_type := function.ret ?? Type.Named{name: "Unit"}
    receiver := TExpr{ty: owner, kind: TExprKind.Local{local: local}, span: span, integer_bounds: None, cost: None}
    TExpr{ty: return_type, kind: TExprKind.MethodCall{receiver: receiver, method: method_ref, type_args: [Type]{}, args: args}, span: span, integer_bounds: None, cost: None}
}

fn jet_codegen_transaction_save_snapshot(builder: &JetCodegenBuilder, program: JetCodegenProgram, scope: MIRScopeID, index: Int, snapshot: TTransactionSnapshot, span: Span) -> JetCodegenTransactionSnapshot {
    binding :: jet_codegen_find_binding_for_local(builder, program, snapshot.local) ?? panic("checked transaction snapshot local is not bound")
    target_place := jet_codegen_lower_local_place(&builder, program, snapshot.local)
    snapshot_value := MIRValueID{value: 0}
    snapshot_type := binding.ty
    if {
        snapshot.rollback_type != None -> {
            owner :: snapshot.rollback_type ?? panic("checked transaction rollback owner disappeared")
            snapshot_method :: snapshot.snapshot_method ?? panic("checked transaction rollback has no Rollback::snapshot method")
            call := jet_codegen_transaction_method_expr(builder, program, snapshot.local, owner, snapshot_method, [TCallArg]{}, span)
            if call.ty == {
                .Result(ok, error) -> {
                    snapshot_type = ok
                    // A `Never` failure is uninhabited whatever the enclosing
                    // rail, as the checker rules for a written `?` (a plain
                    // `snapshot` returns `LedgerSnap Never!`).
                    conversion :: if jet_codegen_unwrap_pattern_tags(error) == (Type.Named{name: "Never"}) -> TTryConvert.Never else -> TTryConvert.NoConversion
                    checked := TExpr{ty: ok, kind: TExprKind.Try{value: call, conversion: conversion, failure: builder.function.failure_carrier}, span: span, integer_bounds: None, cost: None}
                    snapshot_value = jet_codegen_lower_expr(&builder, program, checked)
                }
                else -> {
                    snapshot_type = call.ty
                    snapshot_value = jet_codegen_lower_expr(&builder, program, call)
                }
            }
        } else -> {
            value := jet_codegen_emit_value(&builder, program, span, snapshot_type, MIROperation.ReadPlace{place: target_place})
            // The rollback snapshot owns the state the scope goes on to change.
            snapshot_value = jet_codegen_emit_value(&builder, program, span, snapshot_type, MIROperation.Copy{value: value, fact: MIRCopyFact.Materialize})
        }
    }
    saved_name := "jet_txn_snapshot_{scope.value}_{index}"
    saved_local := tir_generated_local(saved_name, span)
    saved_local.mutable = true
    saved_place := jet_codegen_bind_local(&builder, program, saved_local, snapshot_type, true, None, None, false)
    _ := jet_codegen_emit(&builder, program, span, None, MIROperation.WritePlace{place: saved_place, value: snapshot_value})
    JetCodegenTransactionSnapshot{
        local: snapshot.local,
        ty: binding.ty,
        saved_ty: snapshot_type,
        place: target_place,
        saved_local: saved_local,
        saved_place: saved_place,
        rollback_type: snapshot.rollback_type,
        restore_method: snapshot.restore_method,
    }
}

fn jet_codegen_transaction_restore_snapshot(builder: &JetCodegenBuilder, program: JetCodegenProgram, snapshot: JetCodegenTransactionSnapshot, span: Span) {
    if snapshot.rollback_type == {
        None -> {
            saved := jet_codegen_emit_value(&builder, program, span, snapshot.saved_ty, MIROperation.ReadPlace{place: snapshot.saved_place})
            _ := jet_codegen_emit(&builder, program, span, None, MIROperation.WritePlace{place: snapshot.place, value: saved})
        }
        Val(owner) -> {
            saved := TExpr{ty: snapshot.saved_ty, kind: TExprKind.Local{local: snapshot.saved_local}, span: span, integer_bounds: None, cost: None}
            restore_method :: snapshot.restore_method ?? panic("checked transaction rollback has no Rollback::restore method")
            call := jet_codegen_transaction_method_expr(builder, program, snapshot.local, owner, restore_method, [TCallArg]{jet_codegen_transaction_call_arg(saved)}, span)
            // `restore` completes with Unit, also as a `Unit Never!` carrier.
            restored :: jet_codegen_never_carrier_success(call.ty) ?? call.ty
            if restored != (Type.Named{name: "Unit"}) -> panic("checked Rollback::restore does not return Unit")
            _ := jet_codegen_lower_expr(&builder, program, call)
        }
    }
}

fn jet_codegen_transaction_exit_required(builder: JetCodegenBuilder, program: JetCodegenProgram, transaction: JetCodegenTransactionState, terminator: MIRTerminator) -> Bool Never! {
    if terminator == {
        .Return(_) -> return true
        .Break(target, _) | .Continue(target) -> {
            loop index in 0..<builder.loops.len() {
                loop_target := builder.loops[index]
                if loop_target.break_target == target || loop_target.continue_target == target -> return index < transaction.loop_depth
            }
            panic("checked transaction early exit does not resolve to a loop target")
        }
        else -> false
    }
}

fn jet_codegen_prepare_transaction_exit(builder: &JetCodegenBuilder, program: JetCodegenProgram, terminator: MIRTerminator) -> Bool {
    if builder.transaction_cleanup_active -> return true
    exiting := [Int]{}
    index := builder.transactions.len() - 1
    loop index >= 0 {
        if jet_codegen_transaction_exit_required(builder, program, builder.transactions[index], terminator) -> &exiting.push(index)
        index -= 1
    }
    if exiting.len() == 0 -> return true
    builder.transaction_cleanup_active = true
    loop transaction_index in exiting {
        transaction := builder.transactions[transaction_index]
        snapshot_index := transaction.snapshots.len() - 1
        loop snapshot_index >= 0 {
            span := builder.current_span
            jet_codegen_transaction_restore_snapshot(&builder, program, transaction.snapshots[snapshot_index], span)
            if !jet_codegen_current_is_open(builder, program) {
                builder.transaction_cleanup_active = false
                return false
            }
            snapshot_index -= 1
        }
        if transaction.stm_place != None {
            place :: transaction.stm_place ?? panic("checked transaction STM place disappeared during rollback")
            span := builder.current_span
            value := jet_codegen_emit_value(&builder, program, span, Type.Named{name: "Stm"}, MIROperation.MovePlace{place: place})
            _ := jet_codegen_emit(&builder, program, span, None, MIROperation.Drop{value: value, kind: MIRDropKind.Value})
        }
        if transaction.handle_place != None {
            place :: transaction.handle_place ?? panic("checked transaction handle place disappeared during rollback")
            span := builder.current_span
            value := jet_codegen_emit_value(&builder, program, span, Type.Named{name: "Transaction"}, MIROperation.MovePlace{place: place})
            _ := jet_codegen_emit(&builder, program, span, None, MIROperation.Drop{value: value, kind: MIRDropKind.Value})
        }
    }
    builder.transaction_cleanup_active = false
    jet_codegen_current_is_open(builder, program)
}

fn jet_codegen_lower_transaction(builder: &JetCodegenBuilder, program: JetCodegenProgram, handle: TLocal?, snapshots: [TTransactionSnapshot], stm: TLocal?, body: [TStmt], span: Span) {
    identity := jet_codegen_identity(&builder, program, "scope", span, "Transaction", "")
    scope := MIRScopeID{value: stable_id("mir-scope", identity)}
    jet_codegen_enter_lexical(&builder, program)

    stm_local := TLocal?{None}
    if stm != None {
        source :: stm
        local := tir_generated_local("jet_stm_{scope.value}", source.span)
        local.mutable = true
        stm_local = Val(local)
    }
    scope_name := if stm_local != None -> Val((stm_local ?? tir_generated_local("", span)).name) else -> None
    &builder.scopes.push(MIRScope{id: scope, kind: MIRScopeKind.Transaction, span: span, name: scope_name, deadline: None, facts: [MIRScopeFact]{}})
    _ := jet_codegen_emit(&builder, program, span, None, MIROperation.ScopeEnter{scope: scope, test_member: None})
    &builder.cleanup_frames.push(JetCodegenCleanupFrame{
        owner: Val(scope),
        depth: builder.scope_depth,
        binding_start: builder.bindings.len(),
        drop_live_start: builder.drop_live_places.len(),
        actions: [JetCodegenCleanupAction]{},
        explicit: 0,
        pending_exits: [JetCodegenPendingExit]{},
    })

    handle_place := MIRPlaceID?{None}
    if handle != None {
        local :: handle
        place := jet_codegen_bind_local(&builder, program, local, Type.Named{name: "Transaction"}, local.mutable, None, None, false)
        value := jet_codegen_emit_value(&builder, program, span, Type.Named{name: "Transaction"}, MIROperation.Global{name: "transaction"})
        _ := jet_codegen_emit(&builder, program, span, None, MIROperation.WritePlace{place: place, value: value})
        handle_place = Val(place)
    }
    stm_place := MIRPlaceID?{None}
    if stm_local != None {
        local :: stm_local ?? panic("checked transaction STM local disappeared")
        place := jet_codegen_bind_local(&builder, program, local, Type.Named{name: "Stm"}, true, None, None, false)
        value := jet_codegen_emit_value(&builder, program, span, Type.Named{name: "Stm"}, MIROperation.Global{name: "stm"})
        _ := jet_codegen_emit(&builder, program, span, None, MIROperation.WritePlace{place: place, value: value})
        stm_place = Val(place)
    }

    lowered_snapshots := [JetCodegenTransactionSnapshot]{}
    index := 0
    loop index < snapshots.len() {
        &lowered_snapshots.push(jet_codegen_transaction_save_snapshot(&builder, program, scope, index, snapshots[index], span))
        index += 1
    }
    &builder.transactions.push(JetCodegenTransactionState{
        scope: scope,
        stm_place: stm_place,
        handle_place: handle_place,
        snapshots: lowered_snapshots,
        loop_depth: builder.loops.len(),
    })
    jet_codegen_lower_block(&builder, program, body)
    if jet_codegen_current_is_open(builder, program) && handle_place != None {
        place :: handle_place ?? panic("checked transaction handle place disappeared before commit")
        receiver := jet_codegen_emit_value(&builder, program, span, Type.Named{name: "Transaction"}, MIROperation.ReadPlace{place: place})
        call := jet_codegen_intern_route(&builder, program, MIRPreludeFamily.HandleMethod, "core.transaction", "commit", "jet_transaction_commit", 1, [Bool]{true}, None, TFailureCarrier.Infallible, MIRPreludeABI.Value)
        _ := jet_codegen_emit_value(&builder, program, span, Type.Named{name: "Unit"}, MIROperation.Semantic{operation: MIRSemanticOp.HandleMethod{call: call, receiver: receiver, args: [MIRValueID]{}, frame_schedule: None, frame_schedule_derivation: None}})
    }
    jet_codegen_leave_scope(&builder, program, scope)
    _ := &builder.transactions.pop()
    jet_codegen_leave_lexical(&builder, program)
}

fn jet_codegen_mark_gc_root(builder: &JetCodegenBuilder, program: JetCodegenProgram, place: MIRPlaceID) Never! {
    index := 0
    loop index < builder.locals.len() {
        if builder.locals[index].place == place {
            local := builder.locals[index]
            local.gc_root = true
            ownership := local.ownership
            ownership.gc_root = true
            local.ownership = ownership
            builder.locals[index] = local
            return
        }
        index += 1
    }
    panic("checked GC-root local has no MIR local")
}

fn jet_codegen_lower_statement(builder: &JetCodegenBuilder, program: JetCodegenProgram, statement: TStmt) {
    if statement == {
        .Contract(contract) -> jet_codegen_lower_contract(&builder, program, contract)
        .ContractScope(pre, body, post, result, span) -> jet_codegen_lower_contract_scope(&builder, program, pre, body, post, result, span)
        .Let(local, let_ty, init, gc_promotion, gc_transferred, span) -> {
            gc_root_requested := gc_promotion != None || gc_transferred
            string_view := false
            gc_root := false
            // The binding holds its initializer's own type (no annotation, or
            // an annotation naming that type), so it may alias a read place.
            binds_init_type := false
            if let_ty == {
                .Inferred -> binds_init_type = true
                .StrView -> string_view = true
                .Annotated(ty, wrapper) -> {
                    if wrapper == {
                        .Plain -> binds_init_type = ty == init.ty
                        .AutomaticRoot -> gc_root = true
                        .Resource -> panic("checked let wrapper lies outside the current Jet codegen contract")
                    }
                }
                else -> panic("checked let wrapper lies outside the current Jet codegen contract")
            }
            if gc_root_requested != gc_root -> panic("checked GC ownership facts disagree with the automatic-root binding")
            if init.kind == {
                .Uninit -> {
                    if !local.uninit_scalar && !local.uninit_fixed -> panic("checked uninitialized let has no uninitialized-local fact")
                    place := jet_codegen_bind_local(&builder, program, local, init.ty, local.mutable, None, None, string_view)
                    if gc_root -> jet_codegen_mark_gc_root(&builder, program, place)
                    _ := jet_codegen_emit(&builder, program, span, None, MIROperation.InitializeUninit{place: place})
                }
                else -> {
                    if local.uninit_scalar || local.uninit_fixed -> panic("checked initialized let carries an uninitialized-local fact")
                    // `name := &place` binds an alias of the place, never a
                    // copy: a write borrow is a window whose edits reach the
                    // owner (D-OPT-WRITE1 (#3974): arm patterns on a hoisted
                    // `&place` switch subject are write windows too), a read
                    // borrow reads the place itself. A range borrow's write
                    // window over a list or a declared `ViewMut<T>` is the
                    // range place (Rust: the ViewMutNew arm,
                    // write_window_receiver). Any other range borrow is the
                    // `View<T>` value it lends (Rust lowers it as ViewNew,
                    // not a borrow of a slice copy): the binding aliases a
                    // temporary place of that View, typed as the binding
                    // reads it and never dropped by the binding.
                    // Rust: tir_to_mir_stmt.rs lower_stmt TStmt::Let alias_place
                    alias_place := MIRPlaceID?{None}
                    write_alias := false
                    if init.kind == .Borrow(borrowed, access) {
                        write_alias = access == AccessConvention.Write
                        borrowed_access :: if write_alias -> MIRAccess.Write else -> MIRAccess.Read
                        if borrowed.kind == .Slice(_, _, _, _, _) {
                            if write_alias -> alias_place = jet_codegen_lower_expression_place(&builder, program, borrowed, MIRAccess.Write)
                            if alias_place == None {
                                view := jet_codegen_lower_expr(&builder, program, init)
                                alias_place = Val(jet_codegen_temporary_place(&builder, program, view, init.ty, span, borrowed_access))
                            }
                        } else {
                            alias_place = Val(jet_codegen_lower_place_for_access(&builder, program, TPlace.Expr{value: borrowed}, borrowed_access))
                        }
                    }
                    if alias_place == .Val(window) {
                        alias_ty :: if let_ty == {
                            .Annotated(ty, _) -> ty
                            else -> init.ty
                        }
                        _ := jet_codegen_bind_local_alias(&builder, program, local, alias_ty, window, write_alias)
                        if write_alias -> &builder.window_aliases.push(local.name)
                    } else {
                        // D-MEM-COPYSEM1: an immutable binding of a read
                        // parameter's place (a field path or a list element
                        // below it, or its payload past a diverging `??`)
                        // aliases the place. The parameter cannot change
                        // while the function runs, so the alias reads exactly
                        // what a copy would hold. So does one of a place
                        // whose root its scope leaves alone
                        // (jet_codegen_stable_element_lets), and (#5041) a
                        // `:=` binding that walk proves nothing ever writes.
                        read_alias := MIRPlaceID?{None}
                        stable_root :: builder.stable_element_lets.get(jet_codegen_element_let_key(local, span)) == (Val(true))
                        if binds_init_type && (!local.mutable || stable_root) && !local.generated && !gc_root_requested {
                            read_alias = if init.kind == {
                                .OrFallback(subject, fallback, ambient_err) -> jet_codegen_lower_or_fallback_window(&builder, program, init, subject, fallback, ambient_err, stable_root)
                                else -> jet_codegen_read_binding_place(&builder, program, init, stable_root)
                            }
                        }
                        if read_alias == .Val(read_place) {
                            _ := jet_codegen_bind_local_alias(&builder, program, local, init.ty, read_place, false)
                        } else {
                            value := jet_codegen_lower_expr(&builder, program, init)
                            place := jet_codegen_bind_local(&builder, program, local, init.ty, local.mutable, None, None, string_view)
                            if gc_root -> jet_codegen_mark_gc_root(&builder, program, place)
                            jet_codegen_initialize_retained_place(&builder, program, span, place, value)
                        }
                    }
                }
            }
        }
        .TupleDestructure(temp, init, move_fields, binds, span) | .StructDestructure(temp, init, move_fields, binds, span) -> jet_codegen_lower_field_destructure(&builder, program, temp, init, move_fields, binds, span)
        .ListDestructure(_, init, count, _, _, elements, span) -> jet_codegen_lower_list_destructure(&builder, program, init, count, elements, span)
        .Assign(place_expr, op, value, clone_value, line, span) -> {
            place_ty := jet_codegen_assignment_place_type(builder, program, place_expr)
            destination_is_view := jet_codegen_assignment_destination_is_string_view(builder, program, place_expr)
            right := jet_codegen_assignment_value(&builder, program, value, clone_value, destination_is_view, span)
            place := jet_codegen_lower_place_for_access(&builder, program, place_expr, MIRAccess.Write)
            assigned := if op == {
                .None -> right
                .Val(operation) -> {
                    old := jet_codegen_emit_value(&builder, program, span, place_ty, MIROperation.ReadPlace{place: place})
                    overflow := jet_codegen_assignment_overflow(operation, place_ty, value.ty)
                    dispatch := jet_codegen_binary_dispatch(&builder, program, operation, overflow, place_ty, span, line)
                    mir_overflow := MIRBinaryOverflow.Unchecked
                    if overflow && jet_codegen_fixed_width(place_ty) != None -> mir_overflow = MIRBinaryOverflow.Trap
                    jet_codegen_emit_value(&builder, program, span, place_ty, MIROperation.Binary{op: jet_codegen_lower_binary(operation), dispatch: dispatch, overflow: mir_overflow, left: old, right: right})
                }
            }
            _ := jet_codegen_emit(&builder, program, span, None, MIROperation.WritePlace{place: place, value: assigned})
            jet_codegen_drop_temporary_shared_guard(&builder, program, place, span)
        }
        .IndexAssign(uninit, base, index, is_map, value, span) -> jet_codegen_lower_index_assign(&builder, program, uninit, base, index, is_map, value, span)
        .IndexFieldAssign(assign, span) -> jet_codegen_lower_index_field_assign(&builder, program, assign, span)
        .MathSwizzleAssign(base, _, lanes, value, clone_value, span) -> jet_codegen_lower_math_swizzle_assign(&builder, program, base, lanes, value, clone_value, span)
        .IndexHookAssign(_, base, index, value, span) -> jet_codegen_lower_index_hook_assign(&builder, program, base, index, value, span)
        .SplitViews(owner, root, _, _, _, _, _, _, _, name, start, end, single, write, element, line, span) -> jet_codegen_lower_split_view(&builder, program, owner, root, name, start, end, single, write, element, line, span)
        .Return(value, span) -> {
            result := MIRValueID?{None}
            if value != None -> result = Val(jet_codegen_lower_return_value(&builder, program, value))
            // #3713: the `Err(...)` a function returns is where its failure
            // starts; every tier records that site as the origin.
            if value == .Val(returned) && jet_codegen_current_is_open(builder, program) {
                if returned.kind == {
                    .Err(_) -> jet_codegen_lower_journey_origin(&builder, program, returned.span)
                    else -> {}
                }
            }
            if {
                builder.contract_scopes.len() > 0 -> {
                    jet_codegen_lower_contract_return(&builder, program, result, span)
                } else -> {
                    // A contract scope completes a bare return itself; a
                    // carrier-kept `Unit Never!` body hands back `Ok(())`.
                    if value == None -> result = jet_codegen_unit_never_return(&builder, program, span)
                    terminator := MIRTerminator.Return{value: result}
                    _ := jet_codegen_terminate_with_owned_cleanup(&builder, program, terminator, -1)
                }
            }
        }
        .ExprStmt(value, _) -> {
            _ := jet_codegen_lower_expr(&builder, program, value)
            // Sema ends the reachable path at a Never-typed statement and
            // keeps none of the source after it (Rust keeps the dead `loop
            // {}` that closes `process.exit`); control never returns here.
            if value.ty == (Type.Named{name: "Never"}) && jet_codegen_current_is_open(builder, program) -> jet_codegen_terminate(&builder, program, MIRTerminator.Unreachable{reason: "checked statement diverges"})
        }
        .If(condition, then_body, else_body, _, span) -> jet_codegen_lower_if(&builder, program, condition, then_body, else_body, span)
        .DebugOnly(body, span) -> jet_codegen_lower_debug_only(&builder, program, body, span)
        .Unsafe(gate, body) -> {
            current_span := builder.current_span
            jet_codegen_lower_unsafe(&builder, program, gate, body, current_span)
        }
        .UnsafeBlock(gate, body, span) -> jet_codegen_lower_unsafe(&builder, program, gate, body, span)
        .SentryPolicy(enabled, body, span) -> jet_codegen_lower_sentry_policy(&builder, program, enabled, body, span)
        .Impure(body, span) -> jet_codegen_lower_scoped(&builder, program, MIRScopeKind.Impure, None, body, span)
        .Reactive(executable, span) -> {
            function_identity := "{builder.function.key}|{builder.function.source_file}|{builder.function.source_span.start}|{builder.function.source_span.end}"
            site := Int.from_u64(stable_id("mir-site", "{function_identity}:reactive:{span.start}:{span.end}"))
            expression := TExpr{ty: Type.Named{name: "Unit"}, kind: TExprKind.CoreClosureCall{kind: TCoreClosureKind.ReactiveEffect{executable: executable, site: site}}, span: span, integer_bounds: None, cost: None}
            _ := jet_codegen_lower_expr(&builder, program, expression)
        }
        .Region(body, span) -> jet_codegen_lower_scoped(&builder, program, MIRScopeKind.Region, None, body, span)
        .Layout(handle, label, body, span) -> jet_codegen_lower_layout(&builder, program, handle, label, body, span)
        .ContextBlock(guards, body, span) -> jet_codegen_lower_context_block(&builder, program, guards, body, span)
        .Live(body, span) -> jet_codegen_lower_scoped(&builder, program, MIRScopeKind.Live, None, body, span)
        .Shield(body, span) -> jet_codegen_lower_scoped(&builder, program, MIRScopeKind.Shield, None, body, span)
        .ScopeMember(kind, body, span) -> jet_codegen_lower_scope_member(&builder, program, kind, body, span)
        .TaskGroup(group, limit, body, span) -> jet_codegen_lower_task_group(&builder, program, group, limit, body, span)
        .DeferClose(close, resource, scope_id, span) -> {
            thunk := jet_codegen_lower_defer_thunk(&builder, program, close, resource, scope_id, span)
            jet_codegen_register_deferred_call(&builder, program, thunk, close.ty)
        }
        .RefutableBind(pattern, init, fallback, span) -> jet_codegen_lower_refutable_bind(&builder, program, pattern, init, fallback, span)
        .Match(subject, arms, exhaustive, span) -> jet_codegen_lower_pattern_match(&builder, program, subject, false, arms, None, exhaustive, "checked exhaustive match", span)
        .RangeSwitch(subject, arms, else_body, span) -> jet_codegen_lower_range_switch(&builder, program, subject, arms, else_body, span)
        .MixedSwitch(subject, _, arms, else_body, span) -> jet_codegen_lower_mixed_switch(&builder, program, subject, arms, else_body, span)
        .EnumMatch(scrutinee, clone_subject, arms, else_body, fallthrough, span) -> {
            reason := if fallthrough -> "checked exhaustive match fallthrough" else -> "checked exhaustive match otherwise"
            jet_codegen_lower_pattern_match(&builder, program, scrutinee, clone_subject, arms, else_body, else_body == None, reason, span)
        }
        .While(label, condition, body, span) -> {
            condition_block := jet_codegen_new_block(&builder, program, span, "while-condition")
            body_block := jet_codegen_new_block(&builder, program, span, "while-body")
            exit_block := jet_codegen_new_block(&builder, program, span, "while-exit")
            jet_codegen_terminate(&builder, program, MIRTerminator.Jump{target: condition_block})
            jet_codegen_switch_block(&builder, program, condition_block)
            condition_value := jet_codegen_lower_expr(&builder, program, condition)
            jet_codegen_terminate(&builder, program, MIRTerminator.Branch{condition: condition_value, then_target: body_block, else_target: exit_block})
            loop_scope_depth := builder.scope_depth
            &builder.loops.push(JetCodegenLoopTarget{label: label, break_target: exit_block, continue_target: condition_block, break_scope_depth: loop_scope_depth, continue_scope_depth: loop_scope_depth, break_cleanup_depth: builder.cleanup_frames.len(), continue_cleanup_depth: builder.cleanup_frames.len(), break_seen: false})
            jet_codegen_switch_block(&builder, program, body_block)
            jet_codegen_lower_block(&builder, program, body)
            if jet_codegen_current_is_open(builder, program) -> jet_codegen_terminate(&builder, program, MIRTerminator.Jump{target: condition_block})
            _ := &builder.loops.pop()
            jet_codegen_switch_block(&builder, program, exit_block)
        }
        .CountedLoop(label, init, condition, step, vectorization, body, span) -> jet_codegen_lower_counted_loop(&builder, program, label, init, condition, step, vectorization, body, span)
        .ForRange(label, local, start, end, step, exclusive, body, vectorization, span) -> jet_codegen_lower_range_loop(&builder, program, label, local, None, start, end, step, exclusive, vectorization, body, span)
        .Range(label, variable, source, start, end, step, exclusive, vectorization, body, span) -> jet_codegen_lower_range_loop(&builder, program, label, variable, source, start, end, step, exclusive, vectorization, body, span)
        .ForIn(label, variable, variable_two, source, collection, step, method_kind, columnar, by_value, source_stable, body, span) -> jet_codegen_lower_for_in(&builder, program, label, variable, variable_two, source, collection, step, method_kind, columnar, by_value, source_stable, body, span)
        .Loop(label, body, span) -> {
            body_block := jet_codegen_new_block(&builder, program, span, "loop-body")
            exit_block := jet_codegen_new_block(&builder, program, span, "loop-exit")
            jet_codegen_terminate(&builder, program, MIRTerminator.Jump{target: body_block})
            loop_scope_depth := builder.scope_depth
            &builder.loops.push(JetCodegenLoopTarget{label: label, break_target: exit_block, continue_target: body_block, break_scope_depth: loop_scope_depth, continue_scope_depth: loop_scope_depth, break_cleanup_depth: builder.cleanup_frames.len(), continue_cleanup_depth: builder.cleanup_frames.len(), break_seen: false})
            jet_codegen_switch_block(&builder, program, body_block)
            jet_codegen_lower_block(&builder, program, body)
            if jet_codegen_current_is_open(builder, program) -> jet_codegen_terminate(&builder, program, MIRTerminator.Jump{target: body_block})
            loop_target := builder.loops[builder.loops.len() - 1]
            _ := &builder.loops.pop()
            jet_codegen_switch_block(&builder, program, exit_block)
            if !loop_target.break_seen -> jet_codegen_terminate(&builder, program, MIRTerminator.Unreachable{reason: "unconditional loop has no break"})
        }
        .Break(label, _) -> {
            target := jet_codegen_find_loop_target(builder, program, label, true)
            terminator := MIRTerminator.Break{target: target, value: None}
            scope_depth :: jet_codegen_find_loop_scope_depth(builder, program, label, true)
            if jet_codegen_terminate_with_owned_cleanup(&builder, program, terminator, scope_depth) {
                jet_codegen_mark_loop_break(&builder, program, label)
            }
        }
        .BreakValue(label, value, _) -> {
            payload := jet_codegen_lower_expr(&builder, program, value)
            target := jet_codegen_find_loop_target(builder, program, label, true)
            terminator := MIRTerminator.Break{target: target, value: Val(payload)}
            scope_depth :: jet_codegen_find_loop_scope_depth(builder, program, label, true)
            if jet_codegen_terminate_with_owned_cleanup(&builder, program, terminator, scope_depth) {
                jet_codegen_mark_loop_break(&builder, program, label)
            }
        }
        .Continue(label, _) -> {
            terminator := MIRTerminator.Continue{target: jet_codegen_find_loop_target(builder, program, label, false)}
            scope_depth :: jet_codegen_find_loop_scope_depth(builder, program, label, false)
            _ := jet_codegen_terminate_with_owned_cleanup(&builder, program, terminator, scope_depth)
        }
        .Reactive(executable, span) -> {
            site := Int.from_u64(stable_id("mir-site", "{builder.function.key}|reactive|{span.start}:{span.end}"))
            value := TExpr{
                ty: Type.Named{name: "Unit"},
                kind: TExprKind.CoreClosureCall{kind: TCoreClosureKind.ReactiveEffect{executable: executable, site: site}},
                span: span,
                integer_bounds: None,
                cost: None,
            }
            _ := jet_codegen_lower_expr(&builder, program, value)
        }
        .LineMarker(line) -> {
            if line < 0 -> panic("checked source line marker is negative")
            builder.current_line = Val(line)
        }
        .SourceSpan(span) -> builder.current_span = span
        .Inline(body, _) -> jet_codegen_lower_statements(&builder, program, body)
        .Transact(handle, snapshots, stm, body, span) -> jet_codegen_lower_transaction(&builder, program, handle, snapshots, stm, body, span)
        .InvariantViolation(construct, span) -> panic(jet_codegen_lowering_error_message(builder.function, span, construct))
        else -> panic(jet_codegen_lowering_error_message(builder.function, builder.current_span, "checked TIR statement lies outside the current Jet codegen contract"))
    }
}

fn jet_codegen_fallback_join_value(builder: &JetCodegenBuilder, program: JetCodegenProgram, expression: TExpr, source_type: Type, value: MIRValueID) -> MIRValueID Never! {
    if type_identity_key(source_type) == type_identity_key(expression.ty) -> return value.copy()
    // A literal keeps its written nominal name (`Effect`) while a declared
    // slot carries the canonical `module::Effect`; both qualify to one type.
    if type_identity_key(jet_codegen_qualify_type(source_type, program.nominals, builder.function.module_identity, builder.generic_type_names)) == type_identity_key(jet_codegen_qualify_type(expression.ty, program.nominals, builder.function.module_identity, builder.generic_type_names)) -> return value.copy()
    if expression.ty == {
        .TraitObject(_) -> {
            jet_codegen_require_trait_box_target(expression.ty, builder, program)
            target := jet_codegen_lower_type_for_function(expression.ty, builder, program)
            target_id :: target.identity ?? panic("checked fallback trait result has no MIR identity")
            return jet_codegen_emit_value(&builder, program, expression.span, expression.ty, MIROperation.TraitBox{value: value, target: target_id})
        }
        else -> panic("checked fallback value disagrees with its joined type")
    }
}

fn jet_codegen_lower_fallback_panic(builder: &JetCodegenBuilder, program: JetCodegenProgram, expression: TExpr, message: TExpr, location: TPanicLoc) {
    value := jet_codegen_lower_expr(&builder, program, message)
    jet_codegen_lower_panic_value(&builder, program, expression, value, location)
}

// Shared by source fallback panic and checked Dyn runtime failures.
fn jet_codegen_lower_panic_value(builder: &JetCodegenBuilder, program: JetCodegenProgram, expression: TExpr, value: MIRValueID, location: TPanicLoc) {
    carrier := jet_codegen_failure_carrier_for_type(expression.ty)
    call := jet_codegen_intern_route(
        &builder, program,
        MIRPreludeFamily.StaticPrelude,
        "core.require",
        "panic",
        "jet_panic_rich",
        8,
        [Bool]{true, false, true, true, false, false, true, true},
        Val(Effect.Panic),
        carrier,
        MIRPreludeABI.Control,
    )
    locals := [MIRPanicLocal]{}
    loop local in location.locals {
        binding :: jet_codegen_find_binding_for_local(builder, program, local.local) ?? next
        &locals.push(MIRPanicLocal{name: local.display_name, local: binding.local})
    }
    panic_location := MIRPanicLoc{file: mir_source_file_id(location.file), line: location.line, column: location.column}
    context := MIRPanicContext{function: builder.function.name, source_line: location.source_line, caret: location.caret, locals: locals}
    propagated :: jet_codegen_can_emit_propagate(builder, program)
    if !propagated -> jet_codegen_emit_explicit_stop_cleanups(&builder, program)
    _ := jet_codegen_emit_value(&builder, program, expression.span, expression.ty, MIROperation.Semantic{operation: MIRSemanticOp.RequireStop{call: call, kind: MIRRequireKind.Panic, condition: None, location: panic_location, context: context, values: [MIRValueID]{value}, always_stops: true}})
    jet_codegen_terminate_program_stop(&builder, program, propagated, "checked fallback panic")
}

fn jet_codegen_lower_fallback_route(builder: &JetCodegenBuilder, program: JetCodegenProgram, expression: TExpr, fallback: TOrFallback) -> MIRValueID? {
    if fallback == {
        .Value(value) -> {
            lowered := jet_codegen_lower_expr(&builder, program, value)
            if !jet_codegen_current_is_open(builder, program) -> return None
            // A diverging fallback value (a call typed plain Never, such as
            // `core.math.__numeric_stop(...)`) never reaches the join, as in
            // Rust's lower_fallback_block: close the block as conditional and
            // Result-handler arms do.
            if value.ty == (Type.Named{name: "Never"}) {
                jet_codegen_terminate(&builder, program, MIRTerminator.Unreachable{reason: "checked fallback value diverges"})
                return None
            }
            return Val(jet_codegen_fallback_join_value(&builder, program, expression, value.ty, lowered))
        }
        .Return(value) -> jet_codegen_lower_statement(&builder, program, TStmt.Return{value: value, span: expression.span})
        .Panic(message, location) -> jet_codegen_lower_fallback_panic(&builder, program, expression, message, location)
        .Break -> jet_codegen_lower_statement(&builder, program, TStmt.Break{label: None, span: expression.span})
        .Continue -> jet_codegen_lower_statement(&builder, program, TStmt.Continue{label: None, span: expression.span})
        .BreakLabel(label) -> jet_codegen_lower_statement(&builder, program, TStmt.Break{label: Val(label), span: expression.span})
        .ContinueLabel(label) -> jet_codegen_lower_statement(&builder, program, TStmt.Continue{label: Val(label), span: expression.span})
    }
    None
}

fn jet_codegen_lower_or_fallback(builder: &JetCodegenBuilder, program: JetCodegenProgram, expression: TExpr, subject: TExpr, fallback: TOrFallback, ambient_err: TLocal?) -> MIRValueID {
    value := jet_codegen_lower_expr(&builder, program, subject)
    success_type := Type.Named{name: "Unit"}
    error_type := Type?{None}
    optional := false
    if subject.ty == {
        .Option(inner) -> {
            optional = true
            success_type = inner
        }
        .Result(ok, error) -> {
            success_type = ok
            error_type = Val(error)
        }
        else -> panic("checked fallback subject has no failure carrier")
    }
    success_block := jet_codegen_new_block(&builder, program, expression.span, "fallback-success")
    failure_block := jet_codegen_new_block(&builder, program, expression.span, "fallback-failure")
    join_block := jet_codegen_new_block(&builder, program, expression.span, "fallback-join")
    condition := if {
        optional -> {
            jet_codegen_emit_value(&builder, program, expression.span, Type.Bool, MIROperation.OptionIsSome{subject: value})
        } else -> {
            jet_codegen_emit_value(&builder, program, expression.span, Type.Bool, MIROperation.ResultIsOk{subject: value})
        }
    }
    jet_codegen_terminate(&builder, program, MIRTerminator.Branch{condition: condition, then_target: success_block, else_target: failure_block})
    incoming := [MIRPhiIncoming]{}
    jet_codegen_switch_block(&builder, program, success_block)
    if {
        success_type == (Type.Named{name: "Never"}) -> {
            jet_codegen_terminate(&builder, program, MIRTerminator.Unreachable{reason: "checked fallback success is uninhabited"})
        } else -> {
            payload := if {
                optional -> {
                    jet_codegen_emit_value(&builder, program, expression.span, success_type, MIROperation.OptionValue{subject: value})
                } else -> {
                    jet_codegen_emit_value(&builder, program, expression.span, success_type, MIROperation.ResultValue{subject: value, ok: true})
                }
            }
            result := jet_codegen_fallback_join_value(&builder, program, expression, success_type, payload)
            predecessor := builder.current
            jet_codegen_terminate(&builder, program, MIRTerminator.Jump{target: join_block})
            &incoming.push(MIRPhiIncoming{block: predecessor, value: result})
        }
    }
    jet_codegen_switch_block(&builder, program, failure_block)
    if {
        error_type == (Val(Type.Named{name: "Never"})) -> {
            jet_codegen_terminate(&builder, program, MIRTerminator.Unreachable{reason: "checked fallback failure is uninhabited"})
        } else -> {
            result := jet_codegen_lower_fallback_failure(&builder, program, expression, value, error_type, fallback, ambient_err)
            if result != None && jet_codegen_current_is_open(builder, program) {
                lowered :: result ?? panic("checked fallback value disappeared")
                predecessor := builder.current
                jet_codegen_terminate(&builder, program, MIRTerminator.Jump{target: join_block})
                &incoming.push(MIRPhiIncoming{block: predecessor, value: lowered})
            }
        }
    }
    jet_codegen_switch_block(&builder, program, join_block)
    if incoming.len() == 0 {
        jet_codegen_terminate(&builder, program, MIRTerminator.Unreachable{reason: "every fallback route diverges"})
        return jet_codegen_emit_value(&builder, program, expression.span, expression.ty, MIROperation.Never{reason: "unreachable fallback join"})
    }
    jet_codegen_emit_value(&builder, program, expression.span, expression.ty, MIROperation.Phi{incoming: incoming})
}

// The failure route of `subject ?? fallback` from the current (failure)
// block: binds the ambient `err` of a Result carrier, then lowers the
// fallback. Returns the fallback value when the fallback produces one.
fn jet_codegen_lower_fallback_failure(builder: &JetCodegenBuilder, program: JetCodegenProgram, expression: TExpr, value: MIRValueID, error_type: Type?, fallback: TOrFallback, ambient_err: TLocal?) -> MIRValueID? {
    jet_codegen_enter_lexical(&builder, program)
    if error_type == .Val(error_ty) {
        error := jet_codegen_emit_value(&builder, program, expression.span, error_ty, MIROperation.ResultValue{subject: value, ok: false})
        local := ambient_err ?? tir_generated_local("ambient_err", expression.span)
        place := jet_codegen_bind_local(&builder, program, local, error_ty, false, None, None, false)
        _ := jet_codegen_emit(&builder, program, expression.span, None, MIROperation.WritePlace{place: place, value: error})
    }
    result := jet_codegen_lower_fallback_route(&builder, program, expression, fallback)
    jet_codegen_leave_lexical(&builder, program)
    result
}

// D-MEM-COPYSEM1: `name :: place ?? <diverging fallback>` over a read
// parameter's place, or (`stable_root`) over a place whose root the
// binding's scope leaves alone (jet_codegen_stable_window_place). The carrier
// test reads the place itself and the success route names the payload in
// place, so the binding copies nothing. Returns the payload place with
// lowering continuing on the success route; None (nothing emitted) when
// `subject` is not such a place or the fallback can produce a value. A
// `.Value` fallback qualifies when it always leaves
// (jet_codegen_fallback_value_exits): the exit block of `x :: p ?? { ...;
// return }` and of the D-FLOWTYPE1 guard `if p == None -> return`, and the
// `<no else arm>` of an else-complement refinement.
// Rust: tir_to_mir_expr.rs lower_or_fallback_window / inline_block_diverges.
fn jet_codegen_lower_or_fallback_window(builder: &JetCodegenBuilder, program: JetCodegenProgram, expression: TExpr, subject: TExpr, fallback: TOrFallback, ambient_err: TLocal?, stable_root: Bool) -> MIRPlaceID? {
    value_fallback := false
    if fallback == .Value(fallback_value) {
        if !jet_codegen_fallback_value_exits(fallback_value) -> return None
        value_fallback = true
    }
    never :: Type.Named{name: "Never"}
    optional := false
    payload_type := never
    error_type := Type?{None}
    if subject.ty == {
        .Option(inner) -> {
            optional = true
            payload_type = inner
        }
        .Result(ok, error) -> {
            payload_type = ok
            error_type = Val(error)
        }
        else -> return None
    }
    if payload_type == never || error_type == (Val(never)) || payload_type != expression.ty -> return None
    value :: jet_codegen_lower_read_window(&builder, program, subject, stable_root) ?? return None
    window :: jet_codegen_read_window_of(builder, program, value) ?? panic("checked read window has no place")
    condition := if {
        optional -> jet_codegen_emit_value(&builder, program, expression.span, Type.Bool, MIROperation.OptionIsSome{subject: value})
        else -> jet_codegen_emit_value(&builder, program, expression.span, Type.Bool, MIROperation.ResultIsOk{subject: value})
    }
    success_block := jet_codegen_new_block(&builder, program, expression.span, "fallback-success")
    failure_block := jet_codegen_new_block(&builder, program, expression.span, "fallback-failure")
    jet_codegen_terminate(&builder, program, MIRTerminator.Branch{condition: condition, then_target: success_block, else_target: failure_block})
    jet_codegen_switch_block(&builder, program, failure_block)
    // An exiting `.Value` fallback never reaches its value: a Never-typed
    // tail that leaves the block open ends in Unreachable like any other.
    produced :: jet_codegen_lower_fallback_failure(&builder, program, expression, value, error_type, fallback, ambient_err)
    if produced != None && !value_fallback -> panic("checked diverging fallback produced a value")
    if jet_codegen_current_is_open(builder, program) -> jet_codegen_terminate(&builder, program, MIRTerminator.Unreachable{reason: "diverging fallback"})
    jet_codegen_switch_block(&builder, program, success_block)
    kind :: if optional -> MIRPayloadKind.Option else -> MIRPayloadKind.Result{ok: true}
    Val(jet_codegen_payload_window_place(&builder, program, window, kind, payload_type, expression.span))
}

// A `??` `.Value` fallback that always leaves the current route: a
// Never-typed value, or an inline block whose last statement exits (a
// return, break, or continue, labelled or not) or is an exiting value.
// Every route through such a block either leaves early or reaches that exit.
fn jet_codegen_fallback_value_exits(value: TExpr) -> Bool Never! {
    if value.ty == (Type.Named{name: "Never"}) -> return true
    if value.kind == {
        .InlineBlock(body) -> {
            if body.len() == 0 -> return false
            if body[body.len() - 1] == {
                .Return(_, _) | .Break(_, _) | .BreakValue(_, _, _) | .Continue(_, _) -> true
                .ExprStmt(tail, _) -> jet_codegen_fallback_value_exits(tail)
                else -> false
            }
        }
        else -> false
    }
}

fn jet_codegen_lower_result_handler_arm(builder: &JetCodegenBuilder, program: JetCodegenProgram, expression: TExpr, body: [TStmt], value: TExpr, join: MIRBlockID, incoming: &[MIRPhiIncoming]) {
    jet_codegen_lower_statements(&builder, program, body)
    result := MIRValueID?{None}
    if jet_codegen_current_is_open(builder, program) {
        lowered := jet_codegen_lower_expr(&builder, program, value)
        if jet_codegen_current_is_open(builder, program) {
            if {
                value.ty == (Type.Named{name: "Never"}) -> {
                    jet_codegen_terminate(&builder, program, MIRTerminator.Unreachable{reason: "checked Result handler arm diverges"})
                } else -> {
                    result = Val(jet_codegen_fallback_join_value(&builder, program, expression, value.ty, lowered))
                }
            }
        }
    }
    jet_codegen_leave_lexical(&builder, program)
    if result != None && jet_codegen_current_is_open(builder, program) {
        lowered :: result ?? panic("checked Result handler arm lost its value")
        predecessor := builder.current
        jet_codegen_terminate(&builder, program, MIRTerminator.Jump{target: join})
        &incoming.push(MIRPhiIncoming{block: predecessor, value: lowered})
    }
}

fn jet_codegen_lower_result_handler(builder: &JetCodegenBuilder, program: JetCodegenProgram, expression: TExpr, subject: TExpr, ok_pattern: TPattern, ok_body: [TStmt], ok_value: TExpr, err_pattern: TPattern, err_body: [TStmt], err_value: TExpr, terminal: TExpr) -> MIRValueID {
    subject_value := jet_codegen_lower_expr(&builder, program, subject)
    ok_block := jet_codegen_new_block(&builder, program, expression.span, "result-handler-ok")
    err_test_block := jet_codegen_new_block(&builder, program, expression.span, "result-handler-err-test")
    err_block := jet_codegen_new_block(&builder, program, expression.span, "result-handler-err")
    terminal_block := jet_codegen_new_block(&builder, program, expression.span, "result-handler-terminal")
    join_block := jet_codegen_new_block(&builder, program, expression.span, "result-handler-join")
    incoming := [MIRPhiIncoming]{}

    jet_codegen_enter_lexical(&builder, program)
    ok_test := jet_codegen_lower_pattern_condition(&builder, program, ok_pattern, subject, subject_value, true)
    jet_codegen_terminate(&builder, program, MIRTerminator.Branch{condition: ok_test, then_target: ok_block, else_target: err_test_block})
    jet_codegen_switch_block(&builder, program, ok_block)
    jet_codegen_lower_result_handler_arm(&builder, program, expression, ok_body, ok_value, join_block, &incoming)

    jet_codegen_switch_block(&builder, program, err_test_block)
    jet_codegen_enter_lexical(&builder, program)
    err_test := jet_codegen_lower_pattern_condition(&builder, program, err_pattern, subject, subject_value, true)
    jet_codegen_terminate(&builder, program, MIRTerminator.Branch{condition: err_test, then_target: err_block, else_target: terminal_block})
    jet_codegen_switch_block(&builder, program, err_block)
    jet_codegen_lower_result_handler_arm(&builder, program, expression, err_body, err_value, join_block, &incoming)

    jet_codegen_switch_block(&builder, program, terminal_block)
    jet_codegen_enter_lexical(&builder, program)
    jet_codegen_lower_result_handler_arm(&builder, program, expression, [TStmt]{}, terminal, join_block, &incoming)

    jet_codegen_switch_block(&builder, program, join_block)
    if incoming.len() == 0 {
        jet_codegen_terminate(&builder, program, MIRTerminator.Unreachable{reason: "every Result handler arm diverges"})
        return jet_codegen_emit_value(&builder, program, expression.span, expression.ty, MIROperation.Never{reason: "unreachable Result handler join"})
    }
    jet_codegen_emit_value(&builder, program, expression.span, expression.ty, MIROperation.Phi{incoming: incoming})
}

fn jet_codegen_lower_unreachable(builder: &JetCodegenBuilder, program: JetCodegenProgram, expression: TExpr, line: Int) -> MIRValueID Never! {
    value := jet_codegen_emit_value(&builder, program, expression.span, Type.Named{name: "Unit"}, MIROperation.Constant{value: MIRConstant.Unit})
    jet_codegen_terminate(&builder, program, MIRTerminator.Unreachable{reason: "checked exhaustive dispatch at line {line}"})
    value
}

// Sema's uninhabited `.Never` node (the `no else arm` end of an else-less
// exhaustive dispatch, `todo`) is Rust's TExprKind::Unreachable: it ends the
// current block in an Unreachable terminator, so no join ever receives it as
// a phi edge (whose `Never` ownership would carry no drop obligation).
fn jet_codegen_lower_never(builder: &JetCodegenBuilder, program: JetCodegenProgram, expression: TExpr, reason: String) -> MIRValueID Never! {
    value := jet_codegen_emit_value(&builder, program, expression.span, expression.ty, MIROperation.Never{reason: reason})
    jet_codegen_terminate(&builder, program, MIRTerminator.Unreachable{reason: reason})
    value
}

fn jet_codegen_lower_todo(builder: &JetCodegenBuilder, program: JetCodegenProgram, expression: TExpr, line: Int) -> MIRValueID Never! {
    carrier := TFailureCarrier.Diverges{value: Type.Named{name: "Never"}}
    call := jet_codegen_intern_route(&builder, program, MIRPreludeFamily.StaticPrelude, "core.runtime", "todo", "jet_todo_stop", 3, [Bool]{true, false, true}, Val(Effect.IO), carrier, MIRPreludeABI.Value)
    location := MIRPanicLoc{file: mir_source_file_id(builder.function.source_file), line: line, column: 0}
    // E3011 names the value type the goal stands for: a `Never` failure
    // carrier around it is the function's contract (`-> Int` reports `Int`).
    goal_type := jet_codegen_never_carrier_success(expression.ty) ?? expression.ty
    expected_type := jet_codegen_lower_type_for_function(goal_type, builder, program)
    jet_codegen_emit_value(&builder, program, expression.span, expression.ty, MIROperation.Todo{call: call, location: location, expected_type: Val(expected_type)})
}

fn jet_codegen_lower_option_lift2(builder: &JetCodegenBuilder, program: JetCodegenProgram, expression: TExpr, function: TExpr, left: TExpr, right: TExpr) -> MIRValueID {
    result_type := if jet_codegen_unwrap_pattern_tags(expression.ty) == {
        .Option(inner) -> inner
        else -> panic("checked Option.lift2 result is not optional")
    }
    left_type := if jet_codegen_unwrap_pattern_tags(left.ty) == {
        .Option(inner) -> inner
        else -> panic("checked Option.lift2 left operand is not optional")
    }
    right_type := if jet_codegen_unwrap_pattern_tags(right.ty) == {
        .Option(inner) -> inner
        else -> panic("checked Option.lift2 right operand is not optional")
    }
    called_type := jet_codegen_callable_return_type(jet_codegen_unwrap_pattern_tags(function.ty))
    callable := jet_codegen_lower_expr(&builder, program, function)
    left_carrier := jet_codegen_lower_expr(&builder, program, left)
    right_carrier := jet_codegen_lower_expr(&builder, program, right)
    left_test := jet_codegen_emit_value(&builder, program, expression.span, Type.Bool, MIROperation.OptionIsSome{subject: left_carrier})
    left_present := jet_codegen_new_block(&builder, program, expression.span, "option-lift2-left-present")
    left_absent := jet_codegen_new_block(&builder, program, expression.span, "option-lift2-left-absent")
    both_present := jet_codegen_new_block(&builder, program, expression.span, "option-lift2-both-present")
    right_absent := jet_codegen_new_block(&builder, program, expression.span, "option-lift2-right-absent")
    join := jet_codegen_new_block(&builder, program, expression.span, "option-lift2-join")
    incoming := [MIRPhiIncoming]{}
    jet_codegen_terminate(&builder, program, MIRTerminator.Branch{condition: left_test, then_target: left_present, else_target: left_absent})

    jet_codegen_switch_block(&builder, program, left_present)
    left_value := jet_codegen_emit_value(&builder, program, expression.span, left_type, MIROperation.OptionValue{subject: left_carrier})
    right_test := jet_codegen_emit_value(&builder, program, expression.span, Type.Bool, MIROperation.OptionIsSome{subject: right_carrier})
    jet_codegen_terminate(&builder, program, MIRTerminator.Branch{condition: right_test, then_target: both_present, else_target: right_absent})

    jet_codegen_switch_block(&builder, program, both_present)
    right_value := jet_codegen_emit_value(&builder, program, expression.span, right_type, MIROperation.OptionValue{subject: right_carrier})
    args := [MIRCallArg]{jet_codegen_numeric_call_arg(left_value, expression.span), jet_codegen_numeric_call_arg(right_value, expression.span)}
    called := jet_codegen_emit_value(&builder, program, expression.span, called_type, MIROperation.IndirectCall{callee: callable, args: args, type_args: [MIRType]{}})
    if type_identity_key(called_type) != type_identity_key(result_type) {
        if result_type == {
            .TraitObject(_) -> {
                jet_codegen_require_trait_box_target(result_type, builder, program)
                target := jet_codegen_lower_type_for_function(result_type, builder, program)
                target_id :: target.identity ?? panic("checked Option.lift2 trait result has no MIR identity")
                called = jet_codegen_emit_value(&builder, program, expression.span, result_type, MIROperation.TraitBox{value: called, target: target_id})
            }
            else -> panic("checked Option.lift2 function return disagrees with its result payload")
        }
    }
    present := jet_codegen_emit_value(&builder, program, expression.span, expression.ty, MIROperation.Present{value: called})
    present_source := builder.current
    jet_codegen_terminate(&builder, program, MIRTerminator.Jump{target: join})
    &incoming.push(MIRPhiIncoming{block: present_source, value: present})

    jet_codegen_switch_block(&builder, program, right_absent)
    no_right := jet_codegen_emit_value(&builder, program, expression.span, expression.ty, MIROperation.Absent)
    right_source := builder.current
    jet_codegen_terminate(&builder, program, MIRTerminator.Jump{target: join})
    &incoming.push(MIRPhiIncoming{block: right_source, value: no_right})

    jet_codegen_switch_block(&builder, program, left_absent)
    no_left := jet_codegen_emit_value(&builder, program, expression.span, expression.ty, MIROperation.Absent)
    left_source := builder.current
    jet_codegen_terminate(&builder, program, MIRTerminator.Jump{target: join})
    &incoming.push(MIRPhiIncoming{block: left_source, value: no_left})

    jet_codegen_switch_block(&builder, program, join)
    jet_codegen_emit_value(&builder, program, expression.span, expression.ty, MIROperation.Phi{incoming: incoming})
}

fn jet_codegen_lower_pattern_probe(builder: &JetCodegenBuilder, program: JetCodegenProgram, expression: TExpr, matched: MIRValueID, probe: TMatchProbe) -> MIRValueID Never! {
    if probe == TMatchProbe.IsSome {
        return jet_codegen_emit_value(&builder, program, expression.span, Type.Bool, MIROperation.PatternMatched{matched: matched})
    }
    types := if expression.ty == {
        .Tuple(fields) -> fields
        else -> panic("checked pattern captures have no tuple type")
    }
    type_id := jet_codegen_pattern_mir_type_id(builder, program, expression.ty)
    fields := [MIRFieldValue]{}
    loop (index, field) in types {
        field_id := jet_codegen_host_field_id(builder, program, expression.ty, field.name)
        value := jet_codegen_emit_value(&builder, program, expression.span, field.ty, MIROperation.PatternCapture{matched: matched, index: index})
        &fields.push(MIRFieldValue{field: field_id, value: value})
    }
    jet_codegen_emit_value(&builder, program, expression.span, expression.ty, MIROperation.Tuple{type_id: type_id, fields: fields})
}

fn jet_codegen_pattern_scan_route(builder: &JetCodegenBuilder, program: JetCodegenProgram, binary: Bool, result_type: Type) -> MIRPreludeCallID Never! {
    member := if binary -> "binary_match" else -> "text_match"
    symbol := if binary -> "jet_binary_pattern_match" else -> "jet_text_pattern_match"
    jet_codegen_intern_route(&builder, program, MIRPreludeFamily.StaticPrelude, "core.pattern", member, symbol, 2, [Bool]{true, false}, None, jet_codegen_failure_carrier_for_type(result_type), MIRPreludeABI.Value)
}

// Rust tir_to_mir_expr pattern_scan_captures: an IsSome probe reads no
// capture, so its carrier keeps the empty tuple. An Unwrap probe reads every
// hole, so its carrier holds each hole at its checked type, named by
// position: the canonical capture tuple each PatternCapture indexes. AOT can
// only read a capture the carrier's type keeps.
fn jet_codegen_pattern_scan_result_type(expression: TExpr, probe: TMatchProbe) -> Type Never! {
    fields := [TypeTupleField]{}
    if probe == TMatchProbe.Unwrap {
        if expression.ty == .Tuple(checked) {
            loop (index, field) in checked -> &fields.push(TypeTupleField{name: "{index}", ty: field.ty})
        }
    }
    Type.Option{inner: Type.Tuple{fields: fields}}
}

fn jet_codegen_lower_string_match_scan(builder: &JetCodegenBuilder, program: JetCodegenProgram, expression: TExpr, subject: TExpr, parts: [StrMatchPart], probe: TMatchProbe) -> MIRValueID {
    subject_value := jet_codegen_lower_expr(&builder, program, subject)
    pattern := [MIRTextPatternPart]{}
    loop part in parts {
        if part == {
            .Lit(text) -> &pattern.push(MIRTextPatternPart.Literal{value: text})
            .Hole(_, annotation, span) -> {
                ty := annotation ?? Type.String
                &pattern.push(MIRTextPatternPart.Hole{kind: jet_codegen_pattern_text_hole_kind(ty), ty: jet_codegen_pattern_mir_type_id(builder, program, ty), span: span})
            }
        }
    }
    result_type := jet_codegen_pattern_scan_result_type(expression, probe)
    call := jet_codegen_pattern_scan_route(&builder, program, false, result_type)
    matched := jet_codegen_emit_value(&builder, program, expression.span, result_type, MIROperation.Semantic{operation: MIRSemanticOp.TextPatternMatch{call: call, subject: subject_value, parts: pattern}})
    jet_codegen_lower_pattern_probe(&builder, program, expression, matched, probe)
}

fn jet_codegen_lower_binary_match_scan(builder: &JetCodegenBuilder, program: JetCodegenProgram, expression: TExpr, subject: TExpr, parts: [BinMatchPart], probe: TMatchProbe) -> MIRValueID {
    subject_value := jet_codegen_lower_expr(&builder, program, subject)
    pattern := [MIRBinaryPatternPart]{}
    loop part in parts {
        if part == {
            .Lit(bytes) -> &pattern.push(MIRBinaryPatternPart.Literal{bytes: bytes})
            .Hole(_, spec, span) -> if spec == {
                .Bits(width, endian) -> {
                    ty := Type.IntN{signed: false, bits: width}
                    &pattern.push(MIRBinaryPatternPart.Bits{width: U8{width}, ty: jet_codegen_pattern_mir_type_id(builder, program, ty), little: endian == BinEndian.Little, span: span})
                }
                .Rest -> &pattern.push(MIRBinaryPatternPart.Rest{ty: jet_codegen_pattern_mir_type_id(builder, program, Type.Named{name: "Bytes"}), span: span})
            }
        }
    }
    result_type := jet_codegen_pattern_scan_result_type(expression, probe)
    call := jet_codegen_pattern_scan_route(&builder, program, true, result_type)
    matched := jet_codegen_emit_value(&builder, program, expression.span, result_type, MIROperation.Semantic{operation: MIRSemanticOp.BinaryPatternMatch{call: call, subject: subject_value, parts: pattern}})
    jet_codegen_lower_pattern_probe(&builder, program, expression, matched, probe)
}

// 3ea7c9cc2: `core.sys.set` is the source-compatible Unit form; the kernel
// itself stops with E3001 on an invalid name or value.
fn jet_codegen_lower_env_set(builder: &JetCodegenBuilder, program: JetCodegenProgram, expression: TExpr, name: TExpr, value: TExpr) -> MIRValueID {
    record :: core_call("core.sys", "set") ?? panic("missing checked Core registry row core.sys.set")
    arguments := [MIRCallArg]{}
    call_values := [TExpr]{name, value}
    loop (index, argument) in call_values {
        lowered := jet_codegen_lower_core_call_arg(&builder, program, argument, index, record, false)
        borrowed := index < record.signature.borrow_mask.len() && record.signature.borrow_mask[index]
        lowered.access = if borrowed -> MIRAccess.Read else -> MIRAccess.Move
        &arguments.push(lowered)
    }
    carrier := jet_codegen_failure_carrier_for_type(expression.ty)
    call := jet_codegen_intern_core_call(&builder, program, record)
    route := jet_codegen_intern_core_route(&builder, program, record, carrier)
    fallibility := jet_codegen_core_call_fallibility(carrier, builder, program)
    jet_codegen_emit_value(&builder, program, expression.span, expression.ty, MIROperation.CoreCall{call: call, route: route, args: arguments, type_args: [MIRType]{}, fallibility: fallibility, data_plan: None})
}

fn jet_codegen_gc_local_type(builder: JetCodegenBuilder, program: JetCodegenProgram, local: TLocal) -> Type Never! {
    if jet_codegen_find_binding_for_local(builder, program, local) == .Val(binding) -> return binding.ty
    local.persist_ty ?? panic("checked MIR GC root has no type")
}

fn jet_codegen_lower_gc_local(builder: &JetCodegenBuilder, program: JetCodegenProgram, local: TLocal, span: Span) -> MIRValueID {
    ty := jet_codegen_gc_local_type(builder, program, local)
    jet_codegen_lower_expr(&builder, program, TExpr{ty: ty, kind: TExprKind.Local{local: local}, span: span, integer_bounds: None, cost: None})
}

fn jet_codegen_gc_edit_kind(kind: TGCEditKind) -> MIRGCEditKind Never! {
    if kind == {
        .Clear -> MIRGCEditKind.Clear
        .Pop -> MIRGCEditKind.Pop
        .RemoveIndex -> MIRGCEditKind.RemoveIndex
        .InsertIndex -> MIRGCEditKind.InsertIndex
        .Prepend -> MIRGCEditKind.Prepend
        .Additive -> MIRGCEditKind.Additive
        .Plain -> MIRGCEditKind.Plain
        .EdgeSlot -> MIRGCEditKind.EdgeSlot
    }
}

fn jet_codegen_gc_edit_route(builder: &JetCodegenBuilder, program: JetCodegenProgram, kind: TGCEditKind, result_type: Type) -> MIRPreludeCallID Never! {
    member := if kind == {
        .Clear -> "edit_clear"
        .Pop -> "edit_pop"
        .RemoveIndex -> "edit_remove_index"
        .InsertIndex -> "edit_insert_index"
        .Prepend -> "edit_prepend"
        .Additive -> "edit_additive"
        .Plain -> "edit_plain"
        .EdgeSlot -> "edit_edge_slot"
    }
    mask := if kind == {
        .Clear | .Pop | .Plain -> [Bool]{true, false}
        .RemoveIndex -> [Bool]{true, false, false}
        .InsertIndex -> [Bool]{true, false, true, false}
        .Prepend | .Additive -> [Bool]{true, true, false}
        .EdgeSlot -> [Bool]{true, true, false, false}
    }
    jet_codegen_intern_route(&builder, program, MIRPreludeFamily.StaticPrelude, "core.gc", member, "jet_gc_{member}", mask.len(), mask, Val(Effect.Mem), jet_codegen_failure_carrier_for_type(result_type), MIRPreludeABI.Value)
}

fn jet_codegen_gc_edit_callback(builder: JetCodegenBuilder, program: JetCodegenProgram, edit: TExpr, root_type: Type, span: Span) -> TLambda Never! {
    parameter := tir_generated_local("value", span)
    owner_key := "{builder.function.key}::gc-edit@{span.start}..{span.end}"
    parameter_symbol := symbol_id(SymbolKind.Parameter, builder.function.module_identity, owner_key, parameter.name)
    TLambda{
        executable: TLambdaBody.Expr{value: edit},
        source_span: span,
        frame_schedule: None,
        frame_schedule_derivation: None,
        capture_facts: TCaptureFacts{escapes: false, needs_fn_mut: false, mutable: [String]{}, cloned: [String]{}, frozen: [String]{}, materialized: [String]{}, moved: [String]{}},
        failure_carrier: jet_codegen_failure_carrier_for_type(edit.ty),
        effects: TEffectFacts{direct: [String]{}, solved: [String]{}, call_edges: [String]{}, maximal: false, direct_spans: [TEffectSpan]{}},
        host_param_conventions: None,
        source_params: [String]{parameter.name},
        source_param_symbols: [SymbolID]{parameter_symbol},
        jit_name: "gc_edit_{span.start}_{span.end}",
        param_types: [Type]{root_type},
        ret: if type_is_unit_callable_return(edit.ty) -> None else -> Val(edit.ty),
        is_move: true,
        boxed: false,
        rc: false,
        arc: false,
        captures: [TCapture]{},
        materialized_captures: [String]{},
        frozen_captures: [String]{},
        uses_stack_sentry: false,
    }
}

fn jet_codegen_lower_gc_edit(builder: &JetCodegenBuilder, program: JetCodegenProgram, expression: TExpr, root: TLocal, edges: [TLocal], edit: TExpr, index_temp: TExpr?, kind: TGCEditKind) -> MIRValueID {
    root_type := jet_codegen_gc_local_type(builder, program, root)
    root_value := jet_codegen_lower_gc_local(&builder, program, root, expression.span)
    edge_values := [MIRValueID]{}
    loop edge in edges -> &edge_values.push(jet_codegen_lower_gc_local(&builder, program, edge, expression.span))
    callback := jet_codegen_gc_edit_callback(builder, program, edit, root_type, expression.span)
    edit_value := jet_codegen_lower_lambda(&builder, program, callback, false, "gc-edit").value
    index := MIRValueID?{None}
    if index_temp == .Val(value) -> index = Val(jet_codegen_lower_expr(&builder, program, value))
    call := jet_codegen_gc_edit_route(&builder, program, kind, expression.ty)
    site_key := "{builder.function.key}|{builder.function.source_file}|{expression.span.start}|{expression.span.end}"
    site := MIRGCEditSiteID{value: stable_id("gc-edit-site", site_key)}
    jet_codegen_emit_value(&builder, program, expression.span, expression.ty, MIROperation.Semantic{operation: MIRSemanticOp.GCEdit{call: call, root: root_value, edges: edge_values, edit: edit_value, index: index, kind: jet_codegen_gc_edit_kind(kind), site: site}})
}

fn jet_codegen_lower_range_switch(builder: &JetCodegenBuilder, program: JetCodegenProgram, subject: TExpr, arms: [TRangeArm], else_body: [TStmt], span: Span) {
    subject_value := jet_codegen_lower_expr(&builder, program, subject)
    join := jet_codegen_new_block(&builder, program, span, "range-switch-join")
    otherwise := jet_codegen_new_block(&builder, program, span, "range-switch-otherwise")
    has_join_edge := false
    loop (index, arm) in arms {
        body_block := jet_codegen_new_block(&builder, program, span, "range-switch-body-{index}")
        next_block := if index + 1 < arms.len() -> jet_codegen_new_block(&builder, program, span, "range-switch-test-{index + 1}") else -> otherwise
        condition := jet_codegen_lower_numeric_pattern_range(&builder, program, subject_value, Type.Int, arm.lo, arm.hi, span)
        jet_codegen_terminate(&builder, program, MIRTerminator.Branch{condition: condition, then_target: body_block, else_target: next_block})
        jet_codegen_switch_block(&builder, program, body_block)
        jet_codegen_lower_block(&builder, program, arm.body)
        if jet_codegen_current_is_open(builder, program) {
            has_join_edge = true
            jet_codegen_terminate(&builder, program, MIRTerminator.Jump{target: join})
        }
        jet_codegen_switch_block(&builder, program, next_block)
    }
    if arms.len() == 0 -> jet_codegen_terminate(&builder, program, MIRTerminator.Jump{target: otherwise})
    jet_codegen_switch_block(&builder, program, otherwise)
    jet_codegen_lower_block(&builder, program, else_body)
    if jet_codegen_current_is_open(builder, program) {
        has_join_edge = true
        jet_codegen_terminate(&builder, program, MIRTerminator.Jump{target: join})
    }
    jet_codegen_switch_block(&builder, program, join)
    if !has_join_edge -> jet_codegen_terminate(&builder, program, MIRTerminator.Unreachable{reason: "all range-switch paths terminate"})
}

fn jet_codegen_lower_mixed_switch(builder: &JetCodegenBuilder, program: JetCodegenProgram, subject: TExpr, arms: [TMixedArm], else_body: [TStmt]?, span: Span) {
    subject_value := jet_codegen_lower_expr(&builder, program, subject)
    saved_subject := builder.switch_subject
    current_subject := Val(JetCodegenSwitchSubject{value: subject_value, ty: subject.ty})
    join := jet_codegen_new_block(&builder, program, span, "mixed-switch-join")
    otherwise := jet_codegen_new_block(&builder, program, span, "mixed-switch-otherwise")
    has_join_edge := false
    loop (index, arm) in arms {
        body_block := jet_codegen_new_block(&builder, program, span, "mixed-switch-body-{index}")
        next_block := if index + 1 < arms.len() -> jet_codegen_new_block(&builder, program, span, "mixed-switch-test-{index + 1}") else -> otherwise
        builder.switch_subject = current_subject
        condition := jet_codegen_lower_expr(&builder, program, arm.condition)
        builder.switch_subject = saved_subject
        jet_codegen_terminate(&builder, program, MIRTerminator.Branch{condition: condition, then_target: body_block, else_target: next_block})
        jet_codegen_switch_block(&builder, program, body_block)
        builder.switch_subject = current_subject
        jet_codegen_lower_block(&builder, program, arm.body)
        builder.switch_subject = saved_subject
        if jet_codegen_current_is_open(builder, program) {
            has_join_edge = true
            jet_codegen_terminate(&builder, program, MIRTerminator.Jump{target: join})
        }
        jet_codegen_switch_block(&builder, program, next_block)
    }
    if arms.len() == 0 -> jet_codegen_terminate(&builder, program, MIRTerminator.Jump{target: otherwise})
    jet_codegen_switch_block(&builder, program, otherwise)
    if else_body == .Val(body) -> jet_codegen_lower_block(&builder, program, body)
    if jet_codegen_current_is_open(builder, program) {
        has_join_edge = true
        jet_codegen_terminate(&builder, program, MIRTerminator.Jump{target: join})
    }
    jet_codegen_switch_block(&builder, program, join)
    if !has_join_edge -> jet_codegen_terminate(&builder, program, MIRTerminator.Unreachable{reason: "all mixed-switch paths terminate"})
}

fn jet_codegen_lower_switch_subject(builder: &JetCodegenBuilder, program: JetCodegenProgram, expression: TExpr, field: String?) -> MIRValueID Never! {
    subject :: builder.switch_subject ?? panic("checked switch subject is not available")
    subject_value := subject.value
    if field == .Val(name) {
        field_id := jet_codegen_host_field_id(builder, program, subject.ty, name)
        return jet_codegen_emit_value(&builder, program, expression.span, expression.ty, MIROperation.Field{base: subject_value, field: field_id})
    }
    subject_value
}

fn jet_codegen_lower_require_stop(builder: &JetCodegenBuilder, program: JetCodegenProgram, expression: TExpr, kind: TRequireKind, always_stops: Bool, location: TPanicLoc) -> MIRValueID {
    operation := MIRRequireKind.Require
    condition := MIRValueID?{None}
    values := [MIRValueID]{}
    member := "require"
    symbol := "jet_require"
    mask := [Bool]{false, true, true, false, true, true, false, false, true}
    if kind == {
        .Require(test, message) -> {
            condition = Val(jet_codegen_lower_expr(&builder, program, test))
            if message == .Val(value) -> &values.push(jet_codegen_lower_expr(&builder, program, value))
        }
        .RequireEq(left, right) -> {
            if left.ty != right.ty -> panic("require_eq operands have different checked types")
            left_value := jet_codegen_lower_expr(&builder, program, left)
            right_value := jet_codegen_lower_expr(&builder, program, right)
            equality_call := jet_codegen_intern_route(&builder, program, MIRPreludeFamily.BuiltinMethod, "core.compare", "eq", "jet_eq", 2, [Bool]{true, true}, None, TFailureCarrier.Infallible, MIRPreludeABI.Value)
            args := [MIRCallArg]{jet_codegen_numeric_call_arg(left_value, expression.span), jet_codegen_numeric_call_arg(right_value, expression.span)}
            condition = Val(jet_codegen_emit_value(&builder, program, expression.span, Type.Bool, MIROperation.Semantic{operation: MIRSemanticOp.StaticPreludeCall{call: equality_call, args: args, owner_type_args: [MIRPreludeTypeArg]{}, type_args: [MIRType]{}}}))
            &values.push(left_value)
            &values.push(right_value)
            operation = MIRRequireKind.RequireEq
            member = "require_eq"
            symbol = "jet_require_eq"
            mask = [Bool]{false, true, true, true, false, true, true, false, false, true}
        }
        .Panic(message) -> {
            operation = MIRRequireKind.Panic
            member = "panic"
            symbol = "jet_panic_rich"
            mask = [Bool]{true, false, true, true, false, false, true, true}
            &values.push(jet_codegen_lower_expr(&builder, program, message))
        }
    }
    call := jet_codegen_intern_route(&builder, program, MIRPreludeFamily.StaticPrelude, "core.require", member, symbol, mask.len(), mask, Val(Effect.Panic), jet_codegen_failure_carrier_for_type(expression.ty), MIRPreludeABI.Control)
    locals := [MIRPanicLocal]{}
    loop local in location.locals {
        binding :: jet_codegen_find_binding_for_local(builder, program, local.local) ?? next
        &locals.push(MIRPanicLocal{name: local.display_name, local: binding.local})
    }
    panic_location := MIRPanicLoc{file: mir_source_file_id(location.file), line: location.line, column: location.column}
    // The enclosing function names the report (Rust `capture_panic_loc`
    // `fn_name`); checked TIR locations do not carry it.
    context := MIRPanicContext{function: builder.function.name, source_line: location.source_line, caret: location.caret, locals: locals}
    if condition == .Val(condition_value) && !always_stops {
        return jet_codegen_lower_conditional_stop(&builder, program, expression.span, expression.ty, call, operation, condition_value, panic_location, context, values, "require-stop")
    }
    propagated :: jet_codegen_can_emit_propagate(builder, program)
    if !propagated -> jet_codegen_emit_explicit_stop_cleanups(&builder, program)
    result := jet_codegen_emit_value(&builder, program, expression.span, expression.ty, MIROperation.Semantic{operation: MIRSemanticOp.RequireStop{call: call, kind: operation, condition: condition, location: panic_location, context: context, values: values, always_stops: always_stops}})
    if always_stops -> jet_codegen_terminate_program_stop(&builder, program, propagated, "checked unconditional stop")
    result
}

fn jet_codegen_lower_split_view(builder: &JetCodegenBuilder, program: JetCodegenProgram, owner: TExpr?, root: String, name: String, start: Int, end: Int, single: Bool, write: Bool, element: Type?, line: Int, span: Span) {
    element_type :: element ?? panic("checked split view `{name}` has no element type")
    root_expr := TExpr{ty: Type.List{element: element_type}, kind: TExprKind.Local{local: tir_user_local(root, span)}, span: span, integer_bounds: None, cost: None}
    base := owner ?? root_expr
    start_expr := TExpr{ty: Type.Int, kind: TExprKind.IntLit{value: start, width: None}, span: span, integer_bounds: None, cost: None}
    end_expr := TExpr{ty: Type.Int, kind: TExprKind.IntLit{value: end, width: None}, span: span, integer_bounds: None, cost: None}
    local := tir_user_local(name, span)
    local.mutable = write
    location := jet_codegen_assignment_panic_location(&builder, program, span, false)
    location.line = line
    if single && write {
        place := jet_codegen_index_place(&builder, program, base, start_expr, TIndexKind.FixedListProof, element_type, MIRAccess.Write, location, span)
        _ := jet_codegen_bind_local_alias(&builder, program, local, element_type, place, true)
        return
    }
    // D-SHAPE-PLACE1=A (#4707): a constant-bound write window aliases the
    // owner's range place, exactly as `w :: &list[a..b]` does, so writes
    // through it land in the owner on every tier (Rust: lower_split_view).
    if write && !single {
        window_range := TExpr{ty: Type.Named{name: "Range"}, kind: TExprKind.Range{start: start_expr, end: end_expr, exclusive: false}, span: span, integer_bounds: None, cost: None}
        window_ty := Type.Apply{name: "ViewMut", args: [Type]{element_type}}
        window := TExpr{ty: window_ty, kind: TExprKind.Slice{base: base, start: start_expr, end: end_expr, range: Val(window_range), location: location}, span: span, integer_bounds: None, cost: None}
        if jet_codegen_lower_expression_place(&builder, program, window, MIRAccess.Write) == .Val(window_place) {
            _ := jet_codegen_bind_local_alias(&builder, program, local, window_ty, window_place, true)
            &builder.window_aliases.push(local.name)
            return
        }
    }
    ty := if single -> element_type else -> Type.Apply{name: if write -> "ViewMut" else -> "View", args: [Type]{element_type}}
    value := if {
        single -> {
            place := jet_codegen_index_place(&builder, program, base, start_expr, TIndexKind.FixedListProof, element_type, MIRAccess.Read, location, span)
            jet_codegen_emit_value(&builder, program, span, element_type, MIROperation.ReadPlace{place: place})
        } else -> {
            range := TExpr{ty: Type.Named{name: "Range"}, kind: TExprKind.Range{start: start_expr, end: end_expr, exclusive: false}, span: span, integer_bounds: None, cost: None}
            operation := if write -> TBuiltinOp.ViewMutNew{line: line} else -> TBuiltinOp.ViewNew{line: line}
            view := TExpr{ty: ty, kind: TExprKind.BuiltinMethod{receiver: base, operation: operation, args: [TExpr]{range}}, span: span, integer_bounds: None, cost: None}
            jet_codegen_lower_expr(&builder, program, view)
        }
    }
    place := jet_codegen_bind_local(&builder, program, local, ty, write, None, None, false)
    _ := jet_codegen_emit(&builder, program, span, None, MIROperation.WritePlace{place: place, value: value})
}

// D-MEM-COPYSEM1 (Rust `check_binding` read window, E0212): which immutable
// place bindings of a body may alias their place: a `::` binding of a place
// (`row :: rows[i]`, `item :: p.items[j]`, `g :: program.graph`, `x :: p.opt
// ?? return`), a pattern's payload and field bindings over a place subject
// (`if program.graph == .Val(graph)`, a match arm, a refutable binding), and
// a copying destructure of a place. Rust sema keeps such a binding a live
// read window and refuses any change to its root while the binding is used;
// Jet sema does not yet (#4559), so lowering proves the same condition over
// the checked body: no change of the root (a write, a consuming use, a write
// borrow, a call of a closure value) runs between the binding and a later
// read of it, also around a loop that reads it, and nothing in its scope
// captures the root or the binding, address-takes it, opens a write window
// on it (a window or capture can change the root under another name), or
// defers a read past the walk. A plain read of the root is no change, and
// neither is testing it as a pattern subject: an implicit last-use move is
// placed by the MIR pass (LastUse.jet), which sees every read of the alias as
// a read of the root. Names stand for locals, so a shadowing name only makes
// the answer more conservative. A read of a binding over another binding
// (`if graph.main == .Val(entry)` under `graph`) reads that one too.
//
// A pattern over a whole root (`if result == .Ok(value)`) whose binding is
// consumed keeps its owned binding: the MIR pass and the backend take the
// payload out of a root at its last use, which beats copying it at the
// consuming use. Below a field, element or payload a consumed alias costs at
// most the copy the owned binding made.
//
// One walk: `tick` orders every change and read, `last` holds each name's
// latest change and `read_at` its latest read, so a binding recorded at tick
// `start` breaks when one of its reads finds its root changed after `start`,
// or when a loop entered after `start` both reads it and changes its root;
// `uses` and `consumed` count consuming uses the same way. The name `*`
// stands for every root. The body of an inline block, an `Inline`
// statement, a setup member or an `if` prelude lowers without a scope of its
// own, so its bindings answer at the end of the enclosing scope; a pattern's
// bindings answer at the end of the arm or branch they bind in. Keyed by
// jet_codegen_element_let_key, jet_codegen_pattern_subject_key and
// jet_codegen_destructure_key.
struct JetCodegenLetStability {
    tick: Int
    last: [String:Int]
    read_at: [String:Int]
    pinned: [String:Bool]
    uses: Int
    consumed: [String:Int]
    pending: [JetCodegenLetCandidate]
    stable: [String:Bool]
}

// A binding (`name :: <place rooted at root>`) recorded at tick `start` and
// consuming-use count `use_start`; `broken` once a read found its root
// changed. A `scoped` (pattern) binding answers where its arm or branch ends;
// a `consume` one is unstable once consumed. A `mutable` one (`name :=
// <place>`, #5041) is also unstable once its own name is changed: only a
// `:=` binding nothing ever writes may alias its place like a `::` one.
struct JetCodegenLetCandidate {
    key: String
    name: String
    root: String
    start: Int
    use_start: Int
    scoped: Bool
    consume: Bool
    mutable: Bool
    broken: Bool
}

// How an expression position uses a local it names: read in place (an index
// or field base, a borrow, a copy, a non-mutating receiver), read as a value,
// or possibly written or consumed. Only the last changes it.
enum JetCodegenStabilityUse {
    Inspect
    Value
    Write
}

fn jet_codegen_element_let_key(local: TLocal, span: Span) -> String Never! {
    "{local.name}@{span.start}:{span.end}"
}

// The stability key of a pattern subject: every binding of its patterns
// aliases one window over the subject, so they answer together.
fn jet_codegen_pattern_subject_key(subject: TExpr) -> String Never! {
    "pattern@{subject.span.start}:{subject.span.end}"
}

fn jet_codegen_destructure_key(span: Span) -> String Never! {
    "destructure@{span.start}:{span.end}"
}

// The stability key of a `loop item in <collection>` source.
fn jet_codegen_loop_source_key(collection: TExpr) -> String Never! {
    "loop-source@{collection.span.start}:{collection.span.end}"
}

fn jet_codegen_stable_element_lets(statements: [TStmt], expression: TExpr?) -> [String:Bool] Never! {
    state := JetCodegenLetStability{tick: 0, last: [String:Int]{}, read_at: [String:Int]{}, pinned: [String:Bool]{}, uses: 0, consumed: [String:Int]{}, pending: [JetCodegenLetCandidate]{}, stable: [String:Bool]{}}
    jet_codegen_stability_list(&state, statements, false)
    if expression == .Val(value) -> jet_codegen_stability_expr(&state, value, JetCodegenStabilityUse.Value)
    jet_codegen_stability_settle(&state, 0)
    state.stable
}

fn jet_codegen_stability_disturb(state: &JetCodegenLetStability, name: String) Never! {
    state.tick += 1
    state.last[name] = state.tick
}

fn jet_codegen_stability_changed_since(state: JetCodegenLetStability, root: String, since: Int) -> Bool Never! {
    (state.last.get(root) ?? 0) > since || (state.last.get("*") ?? 0) > since
}

// A read of `name`: every pending binding of that name (a derived value may
// chain to several bindings; a shadowed one only answers more
// conservatively) breaks if its root changed since the binding, and its root
// is read through it. `seen` holds the names this read already reached.
fn jet_codegen_stability_read(state: &JetCodegenLetStability, name: String, seen: &[String]) Never! {
    if seen.contains(name) -> return
    &seen.push(name.copy())
    state.tick += 1
    state.read_at[name] = state.tick
    roots := [String]{}
    index := state.pending.len() - 1
    loop index >= 0 {
        if state.pending[index].name == name {
            root :: state.pending[index].root.copy()
            if jet_codegen_stability_changed_since(state, root, state.pending[index].start) -> state.pending[index].broken = true
            if root != name -> &roots.push(root)
        }
        index -= 1
    }
    loop root in roots -> jet_codegen_stability_read(&state, root, &seen)
}

// A loop's body runs again after its last statement: a binding made before
// the loop (tick `entry`) breaks when the loop both reads it and changes its
// root.
fn jet_codegen_stability_loop_exit(state: &JetCodegenLetStability, entry: Int) Never! {
    index := 0
    loop index < state.pending.len() {
        candidate :: state.pending[index]
        if candidate.start < entry && (state.read_at.get(candidate.name) ?? 0) > entry && jet_codegen_stability_changed_since(state, candidate.root, entry) -> state.pending[index].broken = true
        index += 1
    }
}

// Records a binding of `name` over a place rooted at `root`, from now on.
fn jet_codegen_stability_bind(state: &JetCodegenLetStability, key: String, name: String, root: String, scoped: Bool, consume: Bool) Never! {
    state.tick += 1
    &state.pending.push(JetCodegenLetCandidate{key: key, name: name, root: root, start: state.tick, use_start: state.uses, scoped: scoped, consume: consume, mutable: false, broken: false})
}

// Answers one candidate whose scope ends here. A captured or address-taken
// binding would hold its place past the reads the walk sees, so it copies
// too.
fn jet_codegen_stability_answer(state: &JetCodegenLetStability, candidate: JetCodegenLetCandidate) Never! {
    stable := !candidate.broken && state.pinned.get("*") == None && state.pinned.get(candidate.root) == None && state.pinned.get(candidate.name) == None
    if candidate.consume && (state.consumed.get(candidate.name) ?? 0) > candidate.use_start -> stable = false
    if candidate.mutable && (state.last.get(candidate.name) ?? 0) > candidate.start -> stable = false
    if state.stable.get(candidate.key) == .Val(known) -> stable = stable && known
    state.stable[candidate.key] = stable
}

// Answers the candidates recorded since `mark`: their scope ends here.
fn jet_codegen_stability_settle(state: &JetCodegenLetStability, mark: Int) Never! {
    loop state.pending.len() > mark {
        candidate :: &state.pending.pop() ?? { break }
        jet_codegen_stability_answer(&state, candidate)
    }
}

// Answers the pattern bindings recorded since `mark` (their arm or branch
// ends here) and keeps the rest pending: an `if` prelude's bindings answer
// with the enclosing scope.
fn jet_codegen_stability_settle_scoped(state: &JetCodegenLetStability, mark: Int) Never! {
    kept := [JetCodegenLetCandidate]{}
    loop state.pending.len() > mark {
        candidate :: &state.pending.pop() ?? { break }
        if candidate.scoped {
            jet_codegen_stability_answer(&state, candidate)
        } else {
            &kept.push(candidate)
        }
    }
    loop kept.len() > 0 {
        candidate :: &kept.pop() ?? { break }
        &state.pending.push(candidate)
    }
}

// The root of the place a binding's initializer or a pattern's subject names
// (jet_codegen_element_place_root), under at most a compiler-inserted clone,
// a read borrow, or an `x :: place ?? exit` fallback.
fn jet_codegen_stability_place_root(expression: TExpr) -> TLocal? Never! {
    if expression.kind == {
        .Clone(inner, _) | .OrFallback(inner, _, _) -> return jet_codegen_stability_place_root(inner)
        .Borrow(inner, access) -> {
            if access == AccessConvention.Read -> return jet_codegen_stability_place_root(inner)
        }
        else -> {}
    }
    jet_codegen_element_place_root(expression)
}

// Whether that place is its root itself, no field, element or payload below.
fn jet_codegen_stability_whole_root(expression: TExpr) -> Bool Never! {
    if expression.kind == {
        .Local(_) -> true
        .Clone(inner, _) | .OrFallback(inner, _, _) -> jet_codegen_stability_whole_root(inner)
        .Borrow(inner, access) -> access == AccessConvention.Read && jet_codegen_stability_whole_root(inner)
        else -> false
    }
}

// Records the bindings of `pattern` over `subject` when the subject is a
// place chain (jet_codegen_is_element_place_chain's shape).
fn jet_codegen_stability_pattern(state: &JetCodegenLetStability, pattern: TPattern, subject: TExpr, scoped: Bool) Never! {
    root :: jet_codegen_stability_place_root(subject) ?? return
    whole :: jet_codegen_stability_whole_root(subject)
    key :: jet_codegen_pattern_subject_key(subject)
    loop fact in pattern.bindings {
        if fact.name == "" || fact.name == "_" -> next
        jet_codegen_stability_bind(&state, key, fact.name, root.name, scoped, whole)
    }
}

// A statement list; `transparent` when it lowers without a scope of its own.
fn jet_codegen_stability_list(state: &JetCodegenLetStability, statements: [TStmt], transparent: Bool) Never! {
    mark :: state.pending.len()
    loop statement in statements {
        jet_codegen_stability_stmt(&state, statement)
        if statement == {
            .Let(local, _, init, _, _, span) -> {
                place_root := TLocal?{None}
                if !local.generated -> place_root = jet_codegen_stability_place_root(init)
                if place_root == .Val(root) {
                    jet_codegen_stability_bind(&state, jet_codegen_element_let_key(local, span), local.name, root.name, false, jet_codegen_stability_whole_root(init))
                    if local.mutable -> state.pending[state.pending.len() - 1].mutable = true
                } else if !jet_codegen_stability_scalar(init.ty) {
                    // A value derived from a binding (a slice, a view, a call
                    // result) may borrow its place: reading it reads the
                    // binding (jet_codegen_stability_read).
                    mentioned :: jet_codegen_stability_pending_mentions(state, init)
                    loop name in mentioned -> jet_codegen_stability_bind(&state, "derived@{span.start}:{span.end}", local.name, name, false, false)
                }
            }
            .RefutableBind(pattern, init, _, _) -> jet_codegen_stability_pattern(&state, pattern, init, false)
            .TupleDestructure(_, init, move_fields, binds, span) | .StructDestructure(_, init, move_fields, binds, span) -> {
                if !move_fields {
                    if jet_codegen_stability_place_root(init) == .Val(root) {
                        loop binding in binds -> jet_codegen_stability_bind(&state, jet_codegen_destructure_key(span), binding.local.name, root.name, false, false)
                    }
                }
            }
            else -> {}
        }
    }
    if !transparent -> jet_codegen_stability_settle(&state, mark)
}

fn jet_codegen_stability_scalar(ty: Type) -> Bool Never! {
    if ty == {
        .Int | .IntN(_, _) | .Float | .Float32 | .Bool | .Char -> true
        .Tagged(_, inner) -> jet_codegen_stability_scalar(inner)
        else -> false
    }
}

// The pending binding names `expression` mentions anywhere.
fn jet_codegen_stability_pending_mentions(state: JetCodegenLetStability, expression: TExpr) -> [String] Never! {
    names := [String]{}
    jet_codegen_stability_collect_locals(expression, &names)
    found := [String]{}
    loop name in names {
        if found.contains(name) -> next
        loop candidate in state.pending {
            if candidate.name == name {
                &found.push(name)
                break
            }
        }
    }
    found
}

fn jet_codegen_stability_collect_locals(expression: TExpr, names: &[String]) Never! {
    if expression.kind == .Local(local) {
        &names.push(local.name)
        return
    }
    tir_each_expr_child(expression, (child: TExpr) -> jet_codegen_stability_collect_locals(child, &names))
}

// A view of a binding (a slice, a `View`/`ViewMut` value) may outlive the
// reads this walk orders (stored, returned, captured): the binding copies.
fn jet_codegen_stability_pin_views(state: &JetCodegenLetStability, expression: TExpr) Never! {
    view := if expression.kind == {
        .Slice(_, _, _, _, _) -> true
        else -> false
    }
    if expression.ty == .Apply(name, _) {
        if name == "View" || name == "ViewMut" -> view = true
    }
    if !view || state.pending.len() == 0 -> return
    mentioned :: jet_codegen_stability_pending_mentions(state, expression)
    loop name in mentioned -> state.pinned[name] = true
}

// The local a place expression is rooted at, through fields, indexes,
// slices, copies and borrows.
fn jet_codegen_stability_root(expression: TExpr) -> String? {
    if expression.kind == {
        .Local(local) -> Val(local.name)
        .Field(base, _) | .Index(base, _, _, _, _, _) | .IndexRead(base, _, _, _, _) | .Slice(base, _, _, _, _) | .SliceOwned(base, _, _, _, _) | .Clone(base, _) | .Borrow(base, _) -> jet_codegen_stability_root(base)
        else -> None
    }
}

// A write window opened on `expression` (a `&place` binding, switch subject
// or loop source) may change its root under the window's names.
fn jet_codegen_stability_window(state: &JetCodegenLetStability, expression: TExpr) Never! {
    if expression.kind == .Borrow(place, access) {
        if access != AccessConvention.Read {
            if jet_codegen_stability_root(place) == .Val(root) -> state.pinned[root] = true
        }
    }
}

// An owner that hands parts of itself out (a moving destructure, a loop
// source) may give up storage.
fn jet_codegen_stability_owner(state: &JetCodegenLetStability, expression: TExpr) Never! {
    jet_codegen_stability_window(&state, expression)
    jet_codegen_stability_expr(&state, expression, JetCodegenStabilityUse.Write)
}

// A pattern subject or a copying destructure only reads its place: a
// payload it hands out by value is a copy, or is taken at the subject's
// last use (LastUse.jet), which sees every alias read as a read of the root.
fn jet_codegen_stability_inspected(state: &JetCodegenLetStability, expression: TExpr) Never! {
    jet_codegen_stability_window(&state, expression)
    jet_codegen_stability_expr(&state, expression, JetCodegenStabilityUse.Inspect)
}

fn jet_codegen_stability_values(state: &JetCodegenLetStability, values: [TExpr]) Never! {
    loop value in values -> jet_codegen_stability_expr(&state, value, JetCodegenStabilityUse.Value)
}

// A condition; its pattern bindings stay pending until the guarded branch
// ends (jet_codegen_stability_settle_scoped). `guarded`: the condition is
// a non-first `&&` operand, lowered in a block of its own that does not
// dominate the guarded branch (jet_codegen_lower_condition).
fn jet_codegen_stability_cond(state: &JetCodegenLetStability, condition: TIfCond, guarded: Bool) Never! {
    if condition == {
        .Plain(value) | .IsNone(value) -> jet_codegen_stability_expr(&state, value, JetCodegenStabilityUse.Value)
        .And(left, right) -> {
            jet_codegen_stability_cond(&state, left, guarded)
            jet_codegen_stability_cond(&state, right, true)
        }
        .IfLet(pattern, subject) | .Matches(pattern, subject) -> {
            tir_each_pattern_child(pattern, (child: TExpr) -> jet_codegen_stability_expr(&state, child, JetCodegenStabilityUse.Value))
            jet_codegen_stability_inspected(&state, subject)
            jet_codegen_stability_pattern(&state, pattern, subject, true)
            // #5031: a window over an indexed place is defined where its
            // index operands are evaluated. In a guarded operand that block
            // does not dominate the branch reading the payload bindings, so
            // the subject stays a value and its bindings are ordinary slots
            // written in the operand's block.
            if guarded && jet_codegen_stability_indexed(subject) && jet_codegen_stability_pattern_binds(pattern) -> state.stable[jet_codegen_pattern_subject_key(subject)] = false
        }
        // The prelude's bindings stay visible in the branch it guards.
        .WithPrelude(prelude, nested) -> {
            jet_codegen_stability_list(&state, prelude, true)
            jet_codegen_stability_cond(&state, nested, guarded)
        }
    }
}

// Whether the place a pattern subject names
// (jet_codegen_stability_place_root's shape) has an index link: lowering it
// evaluates the index operands, and every place below it uses them.
fn jet_codegen_stability_indexed(expression: TExpr) -> Bool Never! {
    if expression.kind == {
        .Clone(inner, _) | .OrFallback(inner, _, _) | .Borrow(inner, _) | .Field(inner, _) -> jet_codegen_stability_indexed(inner)
        .Index(_, _, _, _, _, _) -> true
        else -> false
    }
}

// Whether `pattern` binds a name (jet_codegen_stability_pattern's facts).
fn jet_codegen_stability_pattern_binds(pattern: TPattern) -> Bool Never! {
    loop fact in pattern.bindings {
        if fact.name != "" && fact.name != "_" -> return true
    }
    false
}

// The guarded branch of `condition`; its pattern bindings answer at its end.
fn jet_codegen_stability_guarded(state: &JetCodegenLetStability, condition: TIfCond, then_body: [TStmt], then_value: TExpr?) Never! {
    mark :: state.pending.len()
    jet_codegen_stability_cond(&state, condition, false)
    jet_codegen_stability_list(&state, then_body, false)
    if then_value == .Val(value) -> jet_codegen_stability_expr(&state, value, JetCodegenStabilityUse.Value)
    jet_codegen_stability_settle_scoped(&state, mark)
}

fn jet_codegen_stability_arms(state: &JetCodegenLetStability, subject: TExpr, arms: [TMatchArm]) Never! {
    loop arm in arms {
        tir_each_pattern_child(arm.pattern, (child: TExpr) -> jet_codegen_stability_expr(&state, child, JetCodegenStabilityUse.Value))
        mark :: state.pending.len()
        jet_codegen_stability_pattern(&state, arm.pattern, subject, true)
        jet_codegen_stability_list(&state, arm.body, false)
        jet_codegen_stability_settle_scoped(&state, mark)
    }
}

fn jet_codegen_stability_else(state: &JetCodegenLetStability, else_body: [TStmt]?) Never! {
    if else_body == .Val(statements) -> jet_codegen_stability_list(&state, statements, false)
}

fn jet_codegen_stability_stmt(state: &JetCodegenLetStability, statement: TStmt) Never! {
    value :: JetCodegenStabilityUse.Value
    write :: JetCodegenStabilityUse.Write
    // Every binding made before the loop is older than its entry tick.
    state.tick += 1
    entry :: state.tick
    looping :: if statement == {
        .CountedLoop(_, _, _, _, _, _, _) | .ForRange(_, _, _, _, _, _, _, _, _) | .Range(_, _, _, _, _, _, _, _, _, _) | .Loop(_, _, _) | .While(_, _, _, _) | .ForIn(_, _, _, _, _, _, _, _, _, _, _, _) -> true
        else -> false
    }
    jet_codegen_stability_stmt_body(&state, statement, value, write)
    if looping -> jet_codegen_stability_loop_exit(&state, entry)
}

fn jet_codegen_stability_stmt_body(state: &JetCodegenLetStability, statement: TStmt, value: JetCodegenStabilityUse, write: JetCodegenStabilityUse) Never! {
    if statement == {
        // A deferred close reads what it names when the scope ends, past
        // the reads this walk orders.
        .DeferClose(_, _, _, _) -> state.pinned["*"] = true
        .Let(_, _, init, _, _, _) -> {
            jet_codegen_stability_window(&state, init)
            jet_codegen_stability_expr(&state, init, value)
        }
        .TupleDestructure(_, init, move_fields, _, _) | .StructDestructure(_, init, move_fields, _, _) -> {
            if move_fields {
                jet_codegen_stability_owner(&state, init)
            } else {
                jet_codegen_stability_inspected(&state, init)
            }
        }
        .ListDestructure(_, init, _, _, _, _, _) -> jet_codegen_stability_owner(&state, init)
        .RefutableBind(pattern, init, fallback, _) -> {
            tir_each_pattern_child(pattern, (child: TExpr) -> jet_codegen_stability_expr(&state, child, JetCodegenStabilityUse.Value))
            jet_codegen_stability_inspected(&state, init)
            jet_codegen_stability_list(&state, fallback, false)
        }
        .Assign(place, _, assigned, _, _, _) -> {
            jet_codegen_stability_expr(&state, assigned, value)
            // A value derived from a binding stored into a place that outlives
            // the walk's view of it (an earlier local, a field): the binding
            // copies.
            if !jet_codegen_stability_scalar(assigned.ty) {
                mentioned :: jet_codegen_stability_pending_mentions(state, assigned)
                loop name in mentioned -> state.pinned[name] = true
            }
            if place == {
                .Local(local) -> jet_codegen_stability_disturb(&state, local.name)
                .Expr(target) -> jet_codegen_stability_expr(&state, target, write)
            }
        }
        .ContractScope(pre, body, post, _, _) -> {
            loop contract in pre {
                jet_codegen_stability_expr(&state, contract.condition, value)
                jet_codegen_stability_expr(&state, contract.message, value)
            }
            jet_codegen_stability_list(&state, body, false)
            loop contract in post {
                jet_codegen_stability_expr(&state, contract.condition, value)
                jet_codegen_stability_expr(&state, contract.message, value)
            }
        }
        .CountedLoop(_, init, condition, step, _, body, _) -> {
            jet_codegen_stability_stmt(&state, init)
            jet_codegen_stability_expr(&state, condition, value)
            if step == .Val(next_step) -> jet_codegen_stability_stmt(&state, next_step)
            jet_codegen_stability_list(&state, body, false)
        }
        .ForRange(_, _, start, end, step, _, body, _, _) -> {
            jet_codegen_stability_expr(&state, start, value)
            jet_codegen_stability_expr(&state, end, value)
            if step == .Val(step_value) -> jet_codegen_stability_expr(&state, step_value, value)
            jet_codegen_stability_list(&state, body, false)
        }
        .Range(_, _, source, start, end, step, _, _, body, _) -> {
            if source == .Val(source_value) -> jet_codegen_stability_owner(&state, source_value)
            jet_codegen_stability_expr(&state, start, value)
            jet_codegen_stability_expr(&state, end, value)
            if step == .Val(step_value) -> jet_codegen_stability_expr(&state, step_value, value)
            jet_codegen_stability_list(&state, body, false)
        }
        .TaskGroup(_, limit, body, _) -> {
            if limit == .Val(limit_value) -> jet_codegen_stability_expr(&state, limit_value, value)
            jet_codegen_stability_list(&state, body, false)
        }
        .If(condition, then_body, else_body, _, _) -> {
            jet_codegen_stability_guarded(&state, condition, then_body, None)
            jet_codegen_stability_else(&state, else_body)
        }
        .Loop(_, body, _) -> jet_codegen_stability_list(&state, body, false)
        .While(_, condition, body, _) -> {
            jet_codegen_stability_expr(&state, condition, value)
            jet_codegen_stability_list(&state, body, false)
        }
        .Match(subject, arms, _, _) -> {
            jet_codegen_stability_inspected(&state, subject)
            jet_codegen_stability_arms(&state, subject, arms)
        }
        .EnumMatch(scrutinee, _, arms, else_body, _, _) -> {
            jet_codegen_stability_inspected(&state, scrutinee)
            jet_codegen_stability_arms(&state, scrutinee, arms)
            jet_codegen_stability_else(&state, else_body)
        }
        .RangeSwitch(subject, arms, else_body, _) -> {
            jet_codegen_stability_expr(&state, subject, value)
            loop arm in arms -> jet_codegen_stability_list(&state, arm.body, false)
            jet_codegen_stability_list(&state, else_body, false)
        }
        .MixedSwitch(subject, _, arms, else_body, _) -> {
            jet_codegen_stability_owner(&state, subject)
            loop arm in arms {
                jet_codegen_stability_expr(&state, arm.condition, value)
                jet_codegen_stability_list(&state, arm.body, false)
            }
            jet_codegen_stability_else(&state, else_body)
        }
        .IndexAssign(_, base, index, _, assigned, _) | .IndexHookAssign(_, base, index, assigned, _) -> {
            jet_codegen_stability_expr(&state, index, value)
            jet_codegen_stability_expr(&state, assigned, value)
            jet_codegen_stability_expr(&state, base, write)
        }
        .IndexFieldAssign(assign, _) -> {
            jet_codegen_stability_expr(&state, assign.index, value)
            jet_codegen_stability_expr(&state, assign.value, value)
            jet_codegen_stability_expr(&state, assign.base, write)
        }
        .MathSwizzleAssign(base, _, _, assigned, _, _) -> {
            jet_codegen_stability_expr(&state, assigned, value)
            jet_codegen_stability_expr(&state, base, write)
        }
        .ForIn(_, _, _, source, collection, step, _, _, _, _, body, _) -> {
            jet_codegen_stability_owner(&state, source)
            jet_codegen_stability_owner(&state, collection)
            if step == .Val(step_value) -> jet_codegen_stability_expr(&state, step_value, value)
            // A walk in place (jet_codegen_lower_read_list_walk) reads the
            // source's slots every iteration: stable when nothing in the body
            // changes, captures or address-takes its root.
            entry :: state.tick
            jet_codegen_stability_list(&state, body, false)
            if jet_codegen_stability_place_root(collection) == .Val(root) {
                // Two loops can share a key (a repeated inlined body): the walk
                // is stable only when every one of them is, as for candidates.
                key :: jet_codegen_loop_source_key(collection)
                stable := !jet_codegen_stability_changed_since(state, root.name, entry) && state.pinned.get(root.name) == None && state.pinned.get("*") == None
                if state.stable.get(key) == .Val(known) -> stable = stable && known
                state.stable[key] = stable
            }
        }
        .Inline(body, _) -> jet_codegen_stability_list(&state, body, true)
        .DebugOnly(body, _) | .Impure(body, _) | .Region(body, _) | .Live(body, _) | .Shield(body, _) | .Unsafe(_, body) | .UnsafeBlock(_, body, _) | .SentryPolicy(_, body, _) | .Layout(_, _, body, _) -> jet_codegen_stability_list(&state, body, false)
        .ContextBlock(guards, body, _) -> {
            loop guard in guards -> jet_codegen_stability_expr(&state, guard.value, value)
            jet_codegen_stability_list(&state, body, false)
        }
        .ScopeMember(kind, body, _) -> {
            if kind == .Timeout(duration) -> jet_codegen_stability_expr(&state, duration, value)
            setup :: if kind == {
                .Setup -> true
                else -> false
            }
            jet_codegen_stability_list(&state, body, setup)
        }
        .Transact(_, snapshots, _, body, _) -> {
            loop snapshot in snapshots -> state.pinned[snapshot.local.name] = true
            jet_codegen_stability_list(&state, body, false)
        }
        .GCEdit(root, _, _, _, index_temp, edited, _) -> {
            if index_temp == .Val(index_value) -> jet_codegen_stability_expr(&state, index_value, value)
            jet_codegen_stability_stmt(&state, edited)
            jet_codegen_stability_disturb(&state, root)
        }
        .SplitViews(owner, root, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _) -> {
            if owner == .Val(owner_value) -> jet_codegen_stability_expr(&state, owner_value, write)
            state.pinned[root] = true
        }
        .Reactive(_, _) -> state.pinned["*"] = true
        // Return, ExprStmt, BreakValue, DeferClose, Contract: values only.
        else -> tir_each_stmt_child(statement, (child: TExpr) -> jet_codegen_stability_expr(&state, child, JetCodegenStabilityUse.Value))
    }
}

fn jet_codegen_stability_call_args(state: &JetCodegenLetStability, args: [TCallArg]) Never! {
    loop argument in args {
        // A read borrow only reads its argument; any other argument may be
        // consumed (a copy of the place, or the place at its last use).
        use_kind :: if {
            argument.mut_borrow -> JetCodegenStabilityUse.Write
            argument.borrow -> JetCodegenStabilityUse.Inspect
            else -> JetCodegenStabilityUse.Value
        }
        jet_codegen_stability_expr(&state, argument.value, use_kind)
    }
}

// How the receiver of a route that `mutates` uses its local.
fn jet_codegen_stability_receiver(mutates: Bool) -> JetCodegenStabilityUse Never! {
    if mutates -> return JetCodegenStabilityUse.Write
    JetCodegenStabilityUse.Inspect
}

fn jet_codegen_stability_access(access: AccessConvention) -> JetCodegenStabilityUse Never! {
    if access == AccessConvention.Read -> return JetCodegenStabilityUse.Inspect
    JetCodegenStabilityUse.Write
}

// How a place projection (index, slice) checked with `access` uses its base:
// a write, move or write borrow of `a.b[i].c[j]` writes through every base
// down to the root, whatever access the inner index was checked with.
fn jet_codegen_stability_base(use_kind: JetCodegenStabilityUse, access: AccessConvention) -> JetCodegenStabilityUse Never! {
    if use_kind == JetCodegenStabilityUse.Write -> return JetCodegenStabilityUse.Write
    jet_codegen_stability_access(access)
}

fn jet_codegen_stability_expr(state: &JetCodegenLetStability, expression: TExpr, use_kind: JetCodegenStabilityUse) Never! {
    inspect :: JetCodegenStabilityUse.Inspect
    value :: JetCodegenStabilityUse.Value
    write :: JetCodegenStabilityUse.Write
    jet_codegen_stability_pin_views(&state, expression)
    if expression.kind == {
        // Every use reads the local; a value or write use of a bare local
        // consumes it.
        .Local(local) -> {
            seen := [String]{}
            jet_codegen_stability_read(&state, local.name, &seen)
            if use_kind != inspect {
                state.uses += 1
                state.consumed[local.name] = state.uses
            }
            if use_kind == write -> jet_codegen_stability_disturb(&state, local.name)
        }
        // Reading a field reads the record in place; writing or consuming
        // it changes the record.
        .Field(receiver, _) -> jet_codegen_stability_expr(&state, receiver, if use_kind == write -> write else -> inspect)
        .Index(base, index, _, access, _, _) -> {
            jet_codegen_stability_expr(&state, index, value)
            jet_codegen_stability_expr(&state, base, jet_codegen_stability_base(use_kind, access))
        }
        .IndexRead(base, index, _, _, _) -> {
            jet_codegen_stability_expr(&state, index, value)
            jet_codegen_stability_expr(&state, base, jet_codegen_stability_base(use_kind, AccessConvention.Read))
        }
        .Slice(base, start, end, range, _) | .SliceOwned(base, start, end, range, _) -> {
            jet_codegen_stability_expr(&state, start, value)
            jet_codegen_stability_expr(&state, end, value)
            if range == .Val(range_value) -> jet_codegen_stability_expr(&state, range_value, value)
            jet_codegen_stability_expr(&state, base, jet_codegen_stability_base(use_kind, AccessConvention.Read))
        }
        .Clone(copied, _) | .ExplicitCopy(copied) | .MaterializeView(copied) -> jet_codegen_stability_expr(&state, copied, inspect)
        .Borrow(place, access) -> jet_codegen_stability_expr(&state, place, jet_codegen_stability_access(access))
        // A checked `^p` of a match payload (TLocal.payload_take) takes the
        // payload through its subject's window, a partial move sema already
        // tracks: it reads the binding without consuming or disturbing the
        // subject, so the subject keeps its window.
        .Move(moved) -> {
            if moved.kind == {
                .Local(local) -> {
                    if local.payload_take {
                        seen := [String]{}
                        jet_codegen_stability_read(&state, local.name, &seen)
                        return
                    }
                }
                else -> {}
            }
            jet_codegen_stability_expr(&state, moved, write)
        }
        .Drop(moved) | .Close(moved) -> jet_codegen_stability_expr(&state, moved, write)
        .ResourceTake(local) -> {
            seen := [String]{}
            jet_codegen_stability_read(&state, local.name, &seen)
            jet_codegen_stability_disturb(&state, local.name)
        }
        // A mutating route writes through its receiver; an owned iterator
        // receiver is moved (jet_codegen_lower_builtin_receiver).
        .BuiltinMethod(receiver, operation, args) -> {
            jet_codegen_stability_values(&state, args)
            jet_codegen_stability_expr(&state, receiver, jet_codegen_stability_receiver(tir_builtin_mutates_receiver(operation) || jet_codegen_builtin_iter_receiver(receiver.ty)))
        }
        .ClosureMethod(receiver, operation, args) -> {
            jet_codegen_stability_values(&state, args)
            jet_codegen_stability_expr(&state, receiver, jet_codegen_stability_receiver(jet_codegen_closure_method_mutates_receiver(operation) || jet_codegen_closure_receiver_kind(receiver.ty) == (Val("iter"))))
        }
        .HandleMethod(receiver, operation, args) -> {
            jet_codegen_stability_values(&state, args)
            jet_codegen_stability_expr(&state, receiver, jet_codegen_stability_receiver(jet_codegen_handle_receiver_is_mutating(operation)))
        }
        .Binary(_, _, _, lhs, rhs) -> {
            jet_codegen_stability_expr(&state, lhs, value)
            jet_codegen_stability_expr(&state, rhs, value)
        }
        .Unary(_, operand) | .Present(operand) | .Ok(operand) | .Err(operand) | .Try(operand, _, _) | .Print(operand) -> jet_codegen_stability_expr(&state, operand, value)
        .CompareChain(operands, _, _) -> jet_codegen_stability_values(&state, operands)
        .CoreCall(_, args, _, _, _, _, _) -> jet_codegen_stability_values(&state, args)
        .StructLit(fields, _) -> loop field in fields -> jet_codegen_stability_expr(&state, field.value, value)
        .StrLit(parts) -> loop part in parts {
            if part == .Interpolation(hole, _) -> jet_codegen_stability_expr(&state, hole, value)
        }
        .Call(_, _, args) | .ModuleCall(_, _, _, _, args) | .StaticCall(_, _, _, _, args) | .AllocNew(_, args) -> jet_codegen_stability_call_args(&state, args)
        // A method receiver may be written through: its convention is the
        // method's.
        .MethodCall(receiver, _, _, args) -> {
            jet_codegen_stability_call_args(&state, args)
            jet_codegen_stability_expr(&state, receiver, write)
        }
        .ExternCall(_, _, args) -> loop argument in args {
            use_kind_arg :: if argument.mut_borrow -> write else -> value
            jet_codegen_stability_expr(&state, argument.value, use_kind_arg)
        }
        .PatternMatches(subject, pattern) -> {
            tir_each_pattern_child(pattern, (child: TExpr) -> jet_codegen_stability_expr(&state, child, JetCodegenStabilityUse.Value))
            jet_codegen_stability_inspected(&state, subject)
        }
        // A closure changes only what it captures; its body lowers as its
        // own function.
        .Lambda(lambda) | .LambdaValue(lambda) -> loop capture in lambda.captures {
            state.pinned[capture.source] = true
            state.pinned[capture.local.name] = true
        }
        .AddressOf(place, _, _) | .RawAddressOf(place) -> {
            if place == {
                .Local(local) -> state.pinned[local.name] = true
                .Expr(target) -> {
                    if jet_codegen_stability_root(target) == .Val(root) -> state.pinned[root] = true
                    jet_codegen_stability_expr(&state, target, write)
                }
            }
        }
        // An inline block lowers into the enclosing scope.
        .InlineBlock(body) -> jet_codegen_stability_list(&state, body, true)
        .IfExpr(condition, then_body, then_value, else_body, else_value) -> {
            jet_codegen_stability_guarded(&state, condition, then_body, Val(then_value))
            jet_codegen_stability_list(&state, else_body, false)
            jet_codegen_stability_expr(&state, else_value, value)
        }
        .ResultHandler(subject, ok_pattern, ok_body, ok_value, err_pattern, err_body, err_value, terminal) -> {
            jet_codegen_stability_owner(&state, subject)
            tir_each_pattern_child(ok_pattern, (child: TExpr) -> jet_codegen_stability_expr(&state, child, JetCodegenStabilityUse.Value))
            jet_codegen_stability_list(&state, ok_body, false)
            jet_codegen_stability_expr(&state, ok_value, value)
            tir_each_pattern_child(err_pattern, (child: TExpr) -> jet_codegen_stability_expr(&state, child, JetCodegenStabilityUse.Value))
            jet_codegen_stability_list(&state, err_body, false)
            jet_codegen_stability_expr(&state, err_value, value)
            jet_codegen_stability_expr(&state, terminal, value)
        }
        // A call of a closure value may change whatever that closure captured.
        .IndirectCall(_, _, _, _) | .OptionLift2(_, _, _) | .HostBorrowCallback(_, _) -> {
            tir_each_expr_child(expression, (child: TExpr) -> jet_codegen_stability_expr(&state, child, write))
            jet_codegen_stability_disturb(&state, "*")
        }
        .FnValue(kind) -> {
            if kind == {
                // A named function captures nothing.
                .NamedFn(_, lambda) -> {
                    if lambda != None -> state.pinned["*"] = true
                }
                .Call(_, _) -> {
                    tir_each_expr_child(expression, (child: TExpr) -> jet_codegen_stability_expr(&state, child, write))
                    jet_codegen_stability_disturb(&state, "*")
                }
                else -> state.pinned["*"] = true
            }
        }
        .HostCall(call) -> {
            if call == {
                .CCallback(_, _, _, _, _, _) -> state.pinned["*"] = true
                .GCEdit(root, _, edges, _, _, _) -> {
                    tir_each_expr_child(expression, (child: TExpr) -> jet_codegen_stability_expr(&state, child, write))
                    jet_codegen_stability_disturb(&state, root.name)
                    loop edge in edges -> jet_codegen_stability_disturb(&state, edge.name)
                }
                else -> tir_each_expr_child(expression, (child: TExpr) -> jet_codegen_stability_expr(&state, child, write))
            }
        }
        // Executables whose captures this walk does not read.
        .CoreClosureCall(_) | .SharedGuardWait(_, _, _) -> state.pinned["*"] = true
        // Any other form may write what it names.
        else -> tir_each_expr_child(expression, (child: TExpr) -> jet_codegen_stability_expr(&state, child, write))
    }
}

