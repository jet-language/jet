    // Rust: crates/jet-codegen/src/Codegen/TIR/mir.rs:6135
    pub fn value_source_type(self, value: MirValueId) -> Type LowerError! {
        row :: self.values.find(row -> row.0 == value) ?? return Err(self.error(self.span(), "missing checked MIR value type {value}"))
        mir_type_as_ast(row.1)
    }
    // Rust: crates/jet-codegen/src/Codegen/TIR/mir.rs:6148
    pub fn call_value_access(self, value: MirValueId, borrowed: Bool) -> MirAccess LowerError! {
        if borrowed -> return .Read
        row :: self.values.lazy().rev().find(row -> row.0 == value) ?? return Err(self.error(self.span(), "missing checked MIR value ownership {value}"))
        if row.3.mode == .Copy -> .Read else -> .Move
    }
    // Rust: crates/jet-codegen/src/Codegen/TIR/mir.rs:6177
    pub fn field_id_for(self, owner: MirTypeId, key: String) -> MirFieldId LowerError! {
        ty :: self.type_defs.find(ty -> ty.id == owner) ?? return Err(self.error(self.span(), "missing checked MIR owner type {owner}"))
        lookup_key :: math_field_name(ty, key) ?? key
