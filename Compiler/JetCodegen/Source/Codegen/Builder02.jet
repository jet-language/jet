            output.push(~path)
            return
        }
        if ty.tuple_fields() == .Val(fields) {
            loop (name, field_ty) in fields {
                path.push((~name, mir_type_as_ast(field_ty)))
                self.owned_file_paths(field_ty, &path, &visiting, &output)?
                _ :: path.pop()
            }
            return
        }
        identity :: ty.identity ?? return
        if visiting.contains(identity) -> return
        definition :: self.type_defs.find(row -> row.id == identity) ?? return
        if definition.ownership != .Owned && definition.ownership != .Move -> return
        fields :: if definition.kind == { .Struct(fields: fields, ..) -> fields, else -> return }
        visiting.push(identity)
        owner :: mir_type_as_ast(ty)
        loop field in fields {
            if field.computed -> continue
            field_ty :: self.field_type_for_type(owner, field.name)?
            checked :: self.mir_type(field_ty)?
            path.push((~field.name, ^field_ty))
            self.owned_file_paths(checked, &path, &visiting, &output)?
            _ :: path.pop()
        }
        _ :: visiting.pop()
    }
}
