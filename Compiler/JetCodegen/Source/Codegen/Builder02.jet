    // Rust: crates/jet-codegen/src/Codegen/TIR/mir.rs:5904
    pub fn source_line(self) -> U32 Never! {
        if self.current_line == .Val(line) -> return line
        if self.function_source() == .Val(source) -> return U32{source.lines.line_col(source.text, self.current_span.start).0}
        U32{self.function.line}
    }
    // Rust: crates/jet-codegen/src/Codegen/TIR/mir.rs:5916
    pub fn source_column(self) -> U32 Never! { self.function_source().map(source -> U32{source.lines.line_col(source.text, self.current_span.start).1}) ?? U32{0} }
    // Rust: crates/jet-codegen/src/Codegen/TIR/mir.rs:5921
    pub fn with_switch_subject<R>(&self, subject: MirValueId, lower: fn(&LowerCtx) -> R LowerError!) -> R LowerError! {
        previous :: self.switch_subject.replace(subject)
        result :: lower(&self)
        self.switch_subject = previous
        result?
    }
    // Rust: crates/jet-codegen/src/Codegen/TIR/mir.rs:5932
    pub fn switch_subject(self) -> MirValueId LowerError! { self.switch_subject ?? return Err(self.error(self.span(), "switch subject is not available")) }
    // Rust: crates/jet-codegen/src/Codegen/TIR/mir.rs:5936
    pub fn panic_context_at(self, line: U32, source_line_override: String?) -> MirPanicContext Never! {
        source_line :: source_line_override.map(text -> ~text).or_else(fn() { self.function_source().map(source -> ~source.lines.line_text(source.text, Int{line})) }) ?? ""
        MirPanicContext{function: ~self.function.name, source_line: ^source_line, caret: 0, locals: []}
    }
    // Rust: crates/jet-codegen/src/Codegen/TIR/mir.rs:5960
    pub fn source_file_id_for(&self, file: String) -> MirSourceFileId Never! {
        if self.source_files.get(file) == .Val(id) -> return id
        id :: MirSourceFileId(stable_id("mir-source-file", file))
        self.source_files[file] = id
        id
    }
    // Rust: crates/jet-codegen/src/Codegen/TIR/mir.rs:5968
    fn lower_db_query_metadata(&self, metadata: ^TDbQueryMetadata) -> MirDbQueryMetadata Never! {
        source_path :: ^metadata.source_file
        MirDbQueryMetadata{source_file: self.source_file_id_for(source_path), source_path: ^source_path, source_span: metadata.source_span, statement_identity: ^metadata.statement_identity, table_facts: metadata.table_facts.map(fact -> MirDbTableFact{table_id: fact.table_id, read: fact.read, write: fact.write})}
    }
    // Rust: crates/jet-codegen/src/Codegen/TIR/mir.rs:5987
    pub fn site_id_for(self, span: Span, purpose: String) -> MirSiteId Never! {
        MirSiteId(stable_id("mir-site", "{function_identity(self.function)}:{purpose}:{span.start}:{span.end}"))
    }
    // Rust: crates/jet-codegen/src/Codegen/TIR/mir.rs:5999
    pub fn type_id_for(self, key: String) -> MirTypeId LowerError! {
        scoped := String?{None}
        if !self.function.module.is_empty() && !key.contains("::") {
            candidate :: "{self.function.module}::{key}"
            if self.type_defs.any(ty -> ty.key == candidate && ty.name == key) -> scoped = Val(^candidate)
        }
        canonical_key :: canonical_nominal_name(self.type_defs, scoped ?? key, self.span())?
        exact := MirTypeId?{None}
