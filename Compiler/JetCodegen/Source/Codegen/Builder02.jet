            if ty.key != canonical_key -> continue
            if exact != None -> return Err(self.error(self.span(), "ambiguous checked MIR type key `{key}`"))
            exact = Val(ty.id)
        }
        if exact == .Val(id) -> return id
        trait_count :: self.trait_defs.lazy().filter(row -> row.key == key || row.name == key).count()
        if trait_count == {
            0 -> MirTypeId(stable_id("mir-type", canonical_key))
            1 -> MirTypeId(stable_id("mir-type", "Trait({key})"))
            else -> return Err(self.error(self.span(), "ambiguous checked MIR trait key `{key}`"))
        }
    }
    // Rust: crates/jet-codegen/src/Codegen/TIR/mir.rs:6045
    pub fn enum_group_leaves(self, owner: MirTypeId, group: String) -> [String]? Never! {
        row :: self.type_defs.find(row -> row.id == owner) ?? return None
        variants :: if row.kind == { .Enum(variants: variants, ..) -> variants, else -> return None }
        prefix :: "{group}."
        leaves :: variants.lazy().filter(variant -> variant.name.starts_with(prefix)).map(variant -> ~variant.name).to_list()
        if leaves.is_empty() -> None else -> Val(^leaves)
    }
    // Rust: crates/jet-codegen/src/Codegen/TIR/mir.rs:6059
    fn normalize_contextual_type(self, ty: Type) -> Type Never! {
        ty.map_named_types(fn(name: String) {
            if self.function.generic_params.any(parameter -> parameter.name == name) -> return None
            scoped :: "{self.function.module}::{name}"
            bare :: if name == Syntax.TYPE_TASKGROUP || Syntax.typed_head_kind(name) != None -> None else -> self.nominal_identities.get(name)
            self.nominal_identities.get(scoped).or(bare).map(identity -> ~identity).or_else(fn() {
                if self.function.module.is_empty() -> return None
                if self.type_defs.any(definition -> definition.key == scoped && definition.name == name) -> Val(~scoped) else -> None
            })
        })
    }
    // Rust: crates/jet-codegen/src/Codegen/TIR/mir.rs:6094
    pub fn mir_type(&self, ty: Type) -> MirType LowerError! {
        span :: self.span()
        normalized :: self.normalize_contextual_type(ty)
        contextual_owner :: if normalized == {
            .Named(name) -> {
