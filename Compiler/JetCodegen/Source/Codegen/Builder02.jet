    // Rust: crates/jet-codegen/src/Codegen/TIR/mir.rs:6215
    pub fn has_field_owner(self, ty: Type) -> Bool Never! { self.field_owner_id_for_type(ty).is_ok_and(owner -> self.type_defs.any(definition -> definition.id == owner)) }
    // Rust: crates/jet-codegen/src/Codegen/TIR/mir.rs:6220
    pub fn field_owner_id_for_type(self, ty: Type) -> MirTypeId LowerError! {
        normalized :: self.normalize_contextual_type(ty)
