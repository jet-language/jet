//RS 
//RS     /// Roll back every `#Transact` scope an exit leaves before that exit's
//RS     /// cleanups release the saved snapshots: a `return`, `?` propagation,
//RS     /// `break` or `continue` out of the body restores each snapshot, innermost
//RS     /// transaction and newest snapshot first. The body's fallthrough commits.
//RS     fn emit_transaction_exit_restores(
//RS         &mut self,
//RS         terminator: &MirTerminator,
//RS         from_depth: usize,
