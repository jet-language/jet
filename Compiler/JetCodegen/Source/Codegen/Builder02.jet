//RS             for (index, restore) in transactions[transaction].1.iter().enumerate().rev() {
//RS                 if let Err(error) = self.emit_transaction_restore(index, restore) {
//RS                     result = Err(error);
//RS                     break 'restore;
//RS                 }
//RS             }
