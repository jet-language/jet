impl LowerCtx {
    // Rust: crates/jet-codegen/src/Codegen/TIR/mir.rs:5433
    pub fn span(self) -> Span Never! { self.current_span }
    // Rust: crates/jet-codegen/src/Codegen/TIR/mir.rs:5437
    pub fn loop_body_blocks(self, header: MirBlockId, body: MirBlockId, exit: MirBlockId?, advance: MirBlockId?) -> [MirBlockId] Never! {
        pending := [body]
        seen := [MirBlockId: Bool]{}
        region := [MirBlockId]{}
        loop {
            block_id :: pending.pop() ?? break
            if block_id == header || exit == Val(block_id) || advance == Val(block_id) || seen.contains_key(block_id) -> continue
            seen[block_id] = true
            block :: self.block_by_id(block_id) ?? continue
            region.push(block_id)
            pending.extend(block.terminator.targets())
        }
        region.sort()
        ^region
    }
    // Rust: crates/jet-codegen/src/Codegen/TIR/mir.rs:5470
    pub fn loop_cursor_place(self, condition: TExpr) -> MirPlaceId? Never! {
        lhs :: if condition.kind == { .Binary(lhs: lhs, ..) -> lhs, else -> return None }
        local :: if lhs.kind == { .Local(local) -> local, else -> return None }
        self.local_places.get(local.name)
    }
    // Rust: crates/jet-codegen/src/Codegen/TIR/mir.rs:5480
    pub fn checked_loop_cursor(self, body_blocks: [MirBlockId], advance: MirBlockId?, cursor_place: MirPlaceId?, hinted: MirValueId?) -> MirValueId? Never! {
        if hinted != None -> return hinted
        reads := [MirValueId]{}
        loop block_id in body_blocks {
            if advance == Val(block_id) -> continue
            block :: self.block_by_id(block_id) ?? continue
            loop instruction in block.instructions {
                if (instruction.result, instruction.operation) == {
                    (.Val(result), .ReadPlace(place)) -> { if cursor_place == Val(place) -> reads.push(result) }
                    else -> {}
                }
            }
        }
        reads.find(value -> self.checked_cursor_value_is_indexed(body_blocks, advance, value)).or_else(fn() { reads.first() })
    }
    // Rust: crates/jet-codegen/src/Codegen/TIR/mir.rs:5515
    fn checked_cursor_value_is_indexed(self, body_blocks: [MirBlockId], advance: MirBlockId?, cursor: MirValueId) -> Bool Never! {
        loop block_id in body_blocks {
            if advance == Val(block_id) -> continue
            block :: self.block_by_id(block_id) ?? continue
            loop instruction in block.instructions {
                if instruction.operation == {
                    .Index(index: index, ..) -> { if index == cursor -> return true }
                    else -> {
                        loop place_id in checked_operation_place_refs(instruction.operation) {
                            place :: self.places.find(place -> place.id == place_id) ?? continue
                            if place.projections.any(projection -> if projection == { .Index(index: index, ..) -> index == cursor, else -> false }) -> return true
                        }
                    }
                }
            }
        }
        false
    }
    // Rust: crates/jet-codegen/src/Codegen/TIR/mir.rs:5552
    fn checked_cursor_matches(self, value: MirValueId, cursor: MirValueId, cursor_place: MirPlaceId?, seen: &[MirValueId: Bool]) -> Bool Never! {
        if value == cursor || seen.contains_key(value) -> return value == cursor
        seen[value] = true
        instruction :: self.blocks.lazy().flat_map(block -> block.instructions.lazy()).find(instruction -> instruction.result == Val(value)) ?? return false
        if instruction.operation == {
            .ReadPlace(place) -> cursor_place == Val(place)
            .Copy(value: value, ..) | .Move(value: value) | .AttachTag(value: value, ..) | .Convert(value: value, ..) -> self.checked_cursor_matches(value, cursor, cursor_place, &seen)
            else -> false
        }
    }
    // Rust: crates/jet-codegen/src/Codegen/TIR/mir.rs:5582
    fn checked_value_access_root(self, value: MirValueId, seen: &[MirValueId: Bool]) -> MirVectorAccessRoot Never! {
        if seen.contains_key(value) -> return .Value(value)
        seen[value] = true
        instruction :: self.blocks.lazy().flat_map(block -> block.instructions.lazy()).find(instruction -> instruction.result == Val(value)) ?? return .Value(value)
        if instruction.operation == {
            .ReadPlace(place) | .MovePlace(place: place) -> .Place(place)
            .Copy(value: value, ..) | .Move(value: value) | .AttachTag(value: value, ..) | .Field(base: value, ..) | .Index(base: value, ..) -> self.checked_value_access_root(value, &seen)
            .Semantic(.ColumnarRead(base: base, ..)) -> self.checked_value_access_root(base, &seen)
            else -> .Value(value)
        }
    }
    // Rust: crates/jet-codegen/src/Codegen/TIR/mir.rs:5616
    fn checked_value_type(self, value: MirValueId) -> MirType? Never! { self.values.find(row -> row.0 == value).map(row -> ~row.1) }
    // Rust: crates/jet-codegen/src/Codegen/TIR/mir.rs:5623
    fn checked_place_base_type(self, place: MirPlace) -> MirType? Never! {
        if place.base == {
            .Local(local) -> self.locals.find(candidate -> candidate.id == local).map(local -> ~local.ty)
            .Parameter(value) | .Capture(value) | .Temporary(value) -> self.checked_value_type(value)
            .Static(_) -> None
        }
    }
    // Rust: crates/jet-codegen/src/Codegen/TIR/mir.rs:5637
    fn checked_vector_place_layout(self, place: MirPlace, field: MirFieldId?) -> (MirVectorLayout, Int?) Never! {
        id :: field ?? return (.Flat, None)
        base_type :: self.checked_place_base_type(place) ?? return (.AosStrided, None)
        element :: if base_type.kind() == {
            .List(inner) | .FixedList(elem: inner, ..) -> inner
            .Tagged(inner: inner, ..) -> if inner.kind() == { .List(elem) | .FixedList(elem: elem, ..) -> elem, else -> return (.AosStrided, None) }
            else -> return (.AosStrided, None)
        }
        identity :: element.identity.or_else(fn() { if element.kind() == { .Apply(name: name, ..) -> Val(name.id), else -> None } }) ?? return (.AosStrided, None)
        definition :: self.type_defs.find(definition -> definition.id == identity) ?? return (.AosStrided, None)
        fields :: if definition.kind == { .Struct(fields: fields, ..) -> fields, else -> return (.AosStrided, None) }
        if definition.layout != Val(MirStructLayout.Columnar) -> return (.AosStrided, None)
        (.ColumnarDirect, fields.position(candidate -> candidate.id == id))
    }
    // Rust: crates/jet-codegen/src/Codegen/TIR/mir.rs:5683
    fn checked_indexed_field_access(self, base: MirValueId, field: MirFieldId, cursor: MirValueId?, cursor_place: MirPlaceId?) -> (MirVectorAccessRoot, MirVectorLayout, Int?)? Never! {
        instruction :: self.blocks.lazy().flat_map(block -> block.instructions.lazy()).find(instruction -> instruction.result == Val(base)) ?? return None
        (collection, index) :: if instruction.operation == {
            .Index(base: collection, index: index, kind: .List | .FixedListProof, ..) -> (collection, index)
            else -> return None
        }
        cursor_value :: cursor ?? return None
        seen := [MirValueId: Bool]{}
        if !self.checked_cursor_matches(index, cursor_value, cursor_place, &seen) -> return None
        collection_type :: self.checked_value_type(collection) ?? return None
        element :: if collection_type.kind() == {
            .List(inner) | .FixedList(elem: inner, ..) -> inner
            .Tagged(inner: inner, ..) -> if inner.kind() == { .List(elem) | .FixedList(elem: elem, ..) -> elem, else -> return None }
            else -> return None
        }
        identity :: element.identity.or_else(fn() { if element.kind() == { .Apply(name: name, ..) -> Val(name.id), else -> None } }) ?? return None
        definition :: self.type_defs.find(definition -> definition.id == identity) ?? return None
        fields :: if definition.kind == { .Struct(fields: fields, ..) -> fields, else -> return None }
        layout :: if definition.layout == Val(MirStructLayout.Columnar) -> MirVectorLayout.ColumnarDirect else -> MirVectorLayout.AosStrided
        root_seen := [MirValueId: Bool]{}
        Val((self.checked_value_access_root(collection, &root_seen), layout, if layout == .ColumnarDirect -> fields.position(candidate -> candidate.id == field) else -> None))
    }
    // Rust: crates/jet-codegen/src/Codegen/TIR/mir.rs:5744
    fn checked_vector_accesses(self, blocks: [MirBlockId], cursor: MirValueId?, cursor_place: MirPlaceId?) -> [MirVectorAccess] Never! {
        accesses := [MirVectorAccess]{}
        loop block_id in blocks {
            block :: self.block_by_id(block_id) ?? continue
            loop instruction in block.instructions {
                loop place_id in checked_operation_place_refs(instruction.operation) {
                    place :: self.places.find(place -> place.id == place_id) ?? continue
                    field :: place.projections.lazy().rev().find_map(projection -> if projection == { .Field(field: field, ..) -> Val(field), else -> None })
                    (layout, column_index) :: self.checked_vector_place_layout(place, field)
                    accesses.push(MirVectorAccess{root: .Place(place_id), field: field, layout: layout, column_index: column_index})
                }
                if instruction.operation == {
                    .Index(base: base, index: index, ..) -> {
                        if cursor == .Val(cursor_value) {
                            seen := [MirValueId: Bool]{}
                            if self.checked_cursor_matches(index, cursor_value, cursor_place, &seen) {
                                roots := [MirValueId: Bool]{}
                                accesses.push(MirVectorAccess{root: self.checked_value_access_root(base, &roots), field: None, layout: .Flat, column_index: None})
                            }
                        }
                    }
                    .Semantic(.ColumnarRead(base: base, column: column, column_index: column_index, ..)) -> accesses.push(MirVectorAccess{root: .Value(base), field: Val(column), layout: .ColumnarDirect, column_index: Val(column_index)})
                    .Field(base: base, field: field) -> {
                        if self.checked_indexed_field_access(base, field, cursor, cursor_place) == .Val((root, layout, column_index)) -> accesses.push(MirVectorAccess{root: root, field: Val(field), layout: layout, column_index: column_index})
                    }
                    else -> {}
                }
            }
        }
        // GATE #4499: composite access ordering/equality is canonical MIR ordering.
        accesses.sort()
        accesses.dedup()
        ^accesses
    }
    // Rust: crates/jet-codegen/src/Codegen/TIR/mir.rs:5827
    fn checked_lane_width(ty: MirType, rule: MirVectorRule) -> U16? Never! {
        if ty.kind() == {
            .Int -> if rule == .EarlyExitSearch -> Val(U16{2}) else -> None
            .Float -> Val(U16{2})
            .Float32 -> Val(U16{4})
            .IntN(bits: bits, ..) -> Val(if bits <= 32 -> U16{4} else -> U16{2})
            .InlineRange(base: base, ..) | .Tagged(inner: base, ..) | .Quantity(base: base, ..) -> LowerCtx.checked_lane_width(base, rule)
            else -> None
        }
    }
    // Rust: crates/jet-codegen/src/Codegen/TIR/mir.rs:5840
    pub fn record_checked_vector_fact(&self, header: MirBlockId, cursor: MirValueId?, body_blocks: ^[MirBlockId], advance_block: MirBlockId?, cursor_place: MirPlaceId?, facts: AutoVectorizationFacts, span: Span) -> Unit LowerError! {
        element_type :: self.mir_type(facts.element_type)?
        accesses :: self.checked_vector_accesses(body_blocks, cursor, cursor_place)
        layouts := [MirVectorLayout: Bool]{}
        loop access in accesses {
            if access.field != None || access.layout != .Flat -> layouts[access.layout] = true
        }
        layout :: if layouts.len() == 1 -> layouts.keys().first() ?? panic("one checked vector layout") else -> MirVectorLayout.Flat
        lane_width :: LowerCtx.checked_lane_width(element_type, .Elementwise)
        packed :: lane_width != None && !accesses.is_empty() && facts.no_aliasing && facts.no_early_exit && facts.effect_free_body && facts.no_cross_iteration_deps
        self.checked_vector_facts.push(MirVectorFact{loop_header: header, cursor: cursor, body_blocks: ^body_blocks, advance_block: advance_block, rule: .Elementwise, accesses: ^accesses, layout: layout, element_type: Val(^element_type), packed: packed, lane_width: lane_width, no_aliasing: facts.no_aliasing, no_early_exit: facts.no_early_exit, effect_free_body: facts.effect_free_body, no_cross_iteration_dependencies: facts.no_cross_iteration_deps, fixed_reduction: None, span: span, decision: MirOptimizationDecision.Rejected(MirOptimizationRejection.UnsupportedOperation)})
    }
}

impl LowerCtx {
    // Rust: crates/jet-codegen/src/Codegen/TIR/mir.rs:5894
    pub fn set_span(&self, span: Span) -> Unit Never! { self.current_span = span }
    // Rust: crates/jet-codegen/src/Codegen/TIR/mir.rs:5897
