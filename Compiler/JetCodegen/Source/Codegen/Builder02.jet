            .Struct(fields: fields, ..) -> fields.find(field -> field.name == lookup_key)
            .Enum(variants: variants, ..) -> variants.lazy().find_map(variant -> if variant.payload == { .Named(fields) -> fields.find(field -> field.name == lookup_key), else -> None })
