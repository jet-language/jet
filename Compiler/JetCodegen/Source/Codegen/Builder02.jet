                    same_leaf :: (owner.rsplit("::").next() ?? owner) == name
                    ambiguous :: self.type_defs.lazy().filter(definition -> definition.name == name || (definition.key.rsplit("::").next() ?? definition.key) == name).count() > 1
                    if same_leaf && ambiguous -> Val(Type.Named(^owner)) else -> None
                })
