                (ok_ty, err_ty) :: if ty.kind() == { .Result{ok, err} -> (ok, err), else -> panic("MIR plugin result descriptor has a non-result result type") }
                ok_name :: "__jet_plugin_result_ok_{depth}"
                err_name :: "__jet_plugin_result_err_{depth}"
                ok_value :: self.plugin_decode_value_expr(ok, ok_ty, ok_name, depth.saturating_add(1))
                err_value :: self.plugin_decode_value_expr(err, err_ty, err_name, depth.saturating_add(1))
                "match ({value}) {{ {wire}::ResultOk(Some({ok_name})) => match {ok_value} {{ Ok(value) => Ok(Ok(value)), Err(error) => Err(error) }}, {wire}::ResultErr(Some({err_name})) => match {err_value} {{ Ok(value) => Ok(Err(value)), Err(error) => Err(error) }}, {wire}::ResultOk(None) | {wire}::ResultErr(None) => Err(\"plugin returned a result without its payload\".to_string()), _ => Err(\"plugin returned a value with the wrong Result shape\".to_string()) }}"
