    fn drop_expression_tail(self: RustEmitter, function: MirFunction, value: MirValueId, kind: MirDropKind) -> String {
        if self.history_binding(value).is_some_and(pair -> pair.1 != MirAccess.Move) -> return "()"
        if self.shared_constant_value(function, value) -> return "{{ {value_slot(value)}.release(); () }}"
        if kind == MirDropKind.ForeignHandle {
            ty :: self.value_type(function, value)
            handle :: self.handle_for_type(ty).unwrap_or_else(() -> panic("MIR foreign-handle drop has no lifecycle row"))
            return self.close_handle_drop(handle, self.value_move(value))
        }
        // STM scope cleanup commits; dropping the guard itself would roll back.
        if self.value_type(function, value).kind() == { .Apply{name, args} -> args.is_empty() && name.name == STM_TYPE, else -> false } -> return "{{ {self.value_move(value)}.commit(); () }}"
        if kind == {
            .None -> "{{ let _ = {self.value_move(value)}; () }}"
            .Value | .Shared | .View -> "{{ drop({self.value_move(value)}); () }}"
            .ForeignHandle -> unreachable()
        }
    }
    // Rust: crates/jet-codegen/src/Codegen/MIRRust.rs:27033
    fn map_guard_path(self: RustEmitter, expression: String, path: [MirFieldId], editable: Bool, route: MirPreludeCall) -> String {
        expression := expression
        method :: if route.module == "core.cell_guard" && (route.member == "map_read" || route.member == "map_edit") { "map" } else { route.member }
        borrow :: if editable { "&mut " } else { "&" }
        cell_route :: route.module == "core.cell_guard"
        loop field in path {
            field_name :: self.field_name(field)
            project :: "|__jet_guard_value| {borrow}__jet_guard_value.{field_name}"
            arguments :: if cell_route { "{method}({project})" } else { "{method}({field.0}i64, {project})" }
            expression = "({expression}).{arguments}"
        }
        ^expression
    }
