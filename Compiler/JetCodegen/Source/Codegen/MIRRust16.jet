    fn shared_guard_map(self: RustEmitter, call: MirPreludeCallId, guard: MirValueId, path: [MirFieldId], editable: Bool) -> String {
        if path.is_empty() -> panic("MIR shared guard map has no checked field path")
        self.map_guard_path(self.value_move(guard), path, editable, self.prelude_row(call))
