    fn plugin_invoke(self: RustEmitter, function: MirFunction, call: MirPreludeCallId, handle: MirValueId, export_name: String, signature: ComponentSignatureDescriptor, args: [MirValueId], result: MirValueId?) -> String {
        if args.len() != signature.params.len() -> panic("MIR plugin export `{export_name}` has {signature.params.len()} checked parameters but {args.len()} values")
        result :: result.unwrap_or_else(() -> panic("MIR plugin export `{export_name}` has no checked result value"))
        result_ty :: self.value_type(function, result)
        (ok, err) :: if result_ty.kind() == { .Result{ok, err} -> (ok, err), else -> panic("MIR plugin export `{export_name}` result is not a checked Result") }
        if self.plugin_unwrap_type(err).kind() != MirTypeKind.String -> panic("MIR plugin export `{export_name}` result error is not checked String")
        params :: signature.params.zip(args).map(pair -> self.plugin_encode_value_expr(pair.0, self.value_type(function, pair.1), self.value_owned(pair.1), 0)).join(", ")
        wire :: self.plugin_wire_path("")
        call :: self.prelude_call_args_exact(call, ["({self.value_owned(handle)}).handle", "{export_name:?}", "&__jet_plugin_params_wire"])
        result_type :: self.rust_type(ok)
        decoded :: self.plugin_decode_value_expr(signature.result, ok, "__jet_plugin_result_value", 0)
        "{{ let __jet_plugin_params: Vec<{wire}PluginValue> = vec![{params}]; let __jet_plugin_params_wire = {wire}plugin_encode_params(&__jet_plugin_params); let __jet_plugin_wire = {call}; match {wire}plugin_decode_result(&__jet_plugin_wire) {{ Ok(__jet_plugin_result_value) => (|__jet_plugin_result_value: {wire}PluginValue| -> Result<{result_type}, String> {{ {decoded} }})(__jet_plugin_result_value), Err(__jet_plugin_error) => Err(__jet_plugin_error), }} }}"
    }
