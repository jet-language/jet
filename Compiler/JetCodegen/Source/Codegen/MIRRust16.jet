    // Rust: crates/jet-codegen/src/Codegen/MIRRust.rs:27285
    fn plugin_unwrap_type(self: RustEmitter, ty: MirType) -> MirType {
        if ty.kind() == {
            .InlineRange{base, ..} | .Tagged{inner: base, ..} | .Quantity{base, ..} -> self.plugin_unwrap_type(base)
            .Apply{name, ..} -> {
                definition :: self.program.types.find(definition -> definition.id == name.id) else { return ty }
                if definition.kind == { .Alias{target} -> self.plugin_unwrap_type(target), else -> ty }
            }
            else -> ty
        }
    }
