    fn plugin_record_def(self: RustEmitter, ty: MirType, descriptor: ComponentTypeDescriptor) -> MirTypeDef {
        ty :: self.plugin_unwrap_type(ty)
        identity :: ty.identity
        nominal_name :: ty.nominal_name().unwrap_or("")
        descriptor_name :: if descriptor == { .Record{name, ..} -> name, else -> panic("MIR plugin record descriptor has a non-record source type") }
        if identity == {
            Val(identity) -> return self.program.types.find(definition -> definition.id == identity).unwrap_or_else(() -> panic("MIR plugin record `{descriptor_name}` has no checked type definition"))
            None -> {}
        }
        self.program.types.find(definition -> definition.key == nominal_name || definition.name == nominal_name || definition.key == descriptor_name || definition.name == descriptor_name).unwrap_or_else(() -> panic("MIR plugin record `{descriptor_name}` has no checked type definition"))
    }
    // Rust: crates/jet-codegen/src/Codegen/MIRRust.rs:27340
    fn plugin_record_field(self: RustEmitter, definition: MirTypeDef, index: USize, name: String) -> MirField {
        fields :: if definition.kind == { .Struct{fields, ..} -> fields, else -> panic("MIR plugin record descriptor names a non-struct type") }
        matches_name :: field -> field.name == name || mangle(field.name) == name || field.shape_names.name_for(ShapeProjectionKind.Json).expect("checked MIR field is missing its JSON shape name") == name
        fields.get(index).filter(matches_name).or_else(() -> fields.find(matches_name)).unwrap_or_else(() -> panic("MIR plugin record field `{name}` (index {index}) is absent from its type definition"))
    }
