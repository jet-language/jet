    // Rust: crates/jet-codegen/src/Codegen/MIRRust.rs:27152
    fn hardware_register_helper(self: RustEmitter, operation: String, profile_id: String, block: String, register: String, width: RegisterWidth) -> String {
        profile :: self.program.facts.hardware_profile.unwrap_or_else(() -> panic("MIR hardware register has no checked profile"))
        if self.program.facts.hardware_profile_id != profile_id -> panic("MIR hardware register profile disagrees with checked profile")
        block_fact :: profile.register_blocks.find(candidate -> candidate.name == block).unwrap_or_else(() -> panic("MIR hardware register has unknown block"))
        register_fact :: block_fact.registers.find(candidate -> candidate.name == register).unwrap_or_else(() -> panic("MIR hardware register has unknown register"))
        if register_fact.width != width -> panic("MIR hardware register width disagrees with checked fact")
        allowed :: if operation == { "read" -> register_fact.access.can_read(), "write" -> register_fact.access.can_write(), else -> panic("MIR hardware register has unknown operation") }
        if !allowed -> panic("MIR hardware register operation disagrees with checked access")
        self.hardware_register_helper_name(operation, profile_id, block, register)
    }
    // Rust: crates/jet-codegen/src/Codegen/MIRRust.rs:27193
    fn hardware_call(self: RustEmitter, function: MirFunction, call: MirPreludeCallId, op: MirHardwareOp, receiver: MirValueId?, args: [MirCallArg]) -> String {
        route :: self.prelude_row(call)
        self.validate_prelude_count(route, args.len())
        if route.signature.borrow_mask.any(borrowed -> borrowed) -> panic("MIR hardware route {call:?} has borrowed arguments")
        root :: self.config.root_prefix
        if op == {
            .RegisterRead{profile_id, block, register, width} -> {
                if receiver.is_some() || !args.is_empty() -> panic("MIR hardware register read has unexpected receiver or arguments")
                helper :: self.hardware_register_helper("read", profile_id, block, register, width)
                "{root}{helper}()"
            }
            .RegisterWrite{profile_id, block, register, width} -> {
                if receiver.is_some() || args.len() != 1 -> panic("MIR hardware register write requires one value argument")
                if args[0].access == MirAccess.Write -> panic("MIR hardware register write value cannot be a borrowed place")
                value :: self.call_arg_for_function(function, args[0], false)
                helper :: self.hardware_register_helper("write", profile_id, block, register, width)
                "{root}{helper}({value})"
            }
            .DmaStart{profile_id, channel, buffer_ty} -> {
                if receiver.is_some() || args.len() != 1 -> panic("MIR hardware DMA start requires one buffer argument")
                if args[0].access != MirAccess.Move -> panic("MIR hardware DMA start buffer is not an owned move argument")
                self.validate_dma_buffer_type(function, args[0].value, buffer_ty, "start")
                buffer :: self.call_arg_for_function(function, args[0], false)
                "{root}jet_hardware_dma_start_typed({profile_id:?}, {channel:?}, {buffer})"
            }
            .DmaWait{profile_id, channel, buffer_ty} -> {
                transfer :: receiver.unwrap_or_else(() -> panic("MIR hardware DMA wait has no transfer receiver"))
                if !args.is_empty() -> panic("MIR hardware DMA wait has unexpected value arguments")
                transfer_ty :: self.value_type(function, transfer)
                if transfer_ty.kind() == {
                    .Apply{name, args} -> if name.name != "__JetDmaTransfer" || args.len() != 1 || !args[0].same_checked_type(buffer_ty) -> panic("MIR hardware DMA wait receiver disagrees with checked buffer_ty")
                    else -> panic("MIR hardware DMA wait receiver is not a checked transfer type")
                }
                "{root}jet_hardware_dma_wait_typed({profile_id:?}, {channel:?}, {self.value_move(transfer)})"
            }
        }
    }
