            .List(inner) -> {
                child_ty :: if ty.kind() == { .List(inner) | .FixedList{elem: inner, ..} -> inner, else -> panic("MIR plugin list descriptor has a non-list result type") }
                child_name :: "__jet_plugin_decode_item_{depth}"
                child :: self.plugin_decode_value_expr(inner, child_ty, child_name, depth.saturating_add(1))
                inner_rust :: self.rust_type(child_ty)
