    fn plugin_encode_value_expr(self: RustEmitter, descriptor: ComponentTypeDescriptor, ty: MirType, value: String, depth: USize) -> String {
        wire :: self.plugin_wire_path("PluginValue")
        ty :: self.plugin_unwrap_type(ty)
