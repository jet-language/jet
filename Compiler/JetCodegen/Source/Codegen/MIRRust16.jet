            .List(inner) -> {
                child_ty :: if ty.kind() == { .List(inner) | .FixedList{elem: inner, ..} -> inner, else -> panic("MIR plugin list descriptor has a non-list value type") }
                child_name :: "__jet_plugin_encode_item_{depth}"
                child :: self.plugin_encode_value_expr(inner, child_ty, child_name, depth.saturating_add(1))
                iterator :: if ty.kind() == { .List(inner) if self.columnar_type_def(inner).is_some() -> "({value}).to_aos().into_iter()", else -> "({value}).into_iter()" }
                "{wire}::List({iterator}.map(|{child_name}| {child}).collect())"
            }
            .Option(inner) -> {
                child_ty :: if ty.kind() == { .Option(inner) -> inner, else -> panic("MIR plugin option descriptor has a non-option value type") }
                child_name :: "__jet_plugin_option_value_{depth}"
                child :: self.plugin_encode_value_expr(inner, child_ty, child_name, depth.saturating_add(1))
                "match ({value}) {{ Ok({child_name}) => {wire}::Option(Some(Box::new({child}))), Err(_) => {wire}::Option(None) }}"
            }
            .Result{ok, err} -> {
                (ok_ty, err_ty) :: if ty.kind() == { .Result{ok, err} -> (ok, err), else -> panic("MIR plugin result descriptor has a non-result value type") }
                ok_name :: "__jet_plugin_result_ok_{depth}"
                err_name :: "__jet_plugin_result_err_{depth}"
                ok_value :: self.plugin_encode_value_expr(ok, ok_ty, ok_name, depth.saturating_add(1))
                err_value :: self.plugin_encode_value_expr(err, err_ty, err_name, depth.saturating_add(1))
                "match ({value}) {{ Ok({ok_name}) => {wire}::ResultOk(Some(Box::new({ok_value}))), Err({err_name}) => {wire}::ResultErr(Some(Box::new({err_value}))) }}"
            }
            .Record{fields, ..} -> {
                definition :: self.plugin_record_def(ty, descriptor)
                record_name :: "__jet_plugin_record_{depth}"
                encoded_fields :: fields.map(row -> {
