                "match ({value}) {{ {wire}::List(values) => {{ let {items_name}: Result<Vec<{inner_rust}>, String> = values.into_iter().map(|{child_name}| {child}).collect(); match {items_name} {{ Ok({items_name}) => {{ {converted} }}, Err(error) => Err(error) }} }}, _ => Err(\"plugin returned a value with the wrong List shape\".to_string()) }}"
