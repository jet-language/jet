    fn history_source_field_value(self: RustEmitter, owner: String, field: String, value: String) -> String {
        owner :: history_rust_type_name(owner) else { return value }
        if ((owner == "HandleID" || owner == "TaskID" || owner == "EventID") && field == "value") || (owner == "HistoryCase" && field == "seed") || (owner == "HistoryOperation" && field == "index") || (owner == "HistoryScheduleChoice" && field == "operation") -> return "usize::try_from({value}).expect(\"history value exceeds Count\")"
        if owner == "HistoryOperation" && field == "depends_on" -> return "({value}).into_iter().map(|value| usize::try_from(value).expect(\"history dependency exceeds Count\")).collect::<Vec<_>>()"
        if (owner == "HistoryOperation" || owner == "HistoryScheduleChoice") && (field == "task" || field == "event") -> return "({value}).ok_or({self.config.root_prefix}JetAbsent)"
        value
    }
