    fn shared_guard_split(self: RustEmitter, call: MirPreludeCallId, map_call: MirPreludeCallId, guard: MirValueId, first: [MirFieldId], second: [MirFieldId], editable: Bool) -> String {
        if first.is_empty() || second.is_empty() -> panic("MIR shared guard split has an empty checked field path")
        common := 0 as USize
        loop common < first.len() && common < second.len() && first[common] == second[common] -> common += 1
        if common == first.len() || common == second.len() -> panic("MIR shared guard split paths are identical or prefix-related")
        map_route :: self.prelude_row(map_call)
        split_route :: self.prelude_row(call)
        prefix :: self.map_guard_path(self.value_move(guard), first[..common], editable, map_route)
        method :: if split_route.module == "core.cell_guard" && (split_route.member == "split_read" || split_route.member == "split_edit") { "split" } else { split_route.member }
        borrow :: if editable { "&mut " } else { "&" }
        first_field :: self.field_name(first[common])
        second_field :: self.field_name(second[common])
        project :: "|__jet_guard_value| ({borrow}__jet_guard_value.{first_field}, {borrow}__jet_guard_value.{second_field})"
        split :: if split_route.module == "core.cell_guard" { "({prefix}).{method}({project})" } else { "({prefix}).{method}({first[common].0}i64, {second[common].0}i64, {project})" }
        first_mapped :: self.map_guard_path("__jet_split_first", first[common + 1..], editable, map_route)
        second_mapped :: self.map_guard_path("__jet_split_second", second[common + 1..], editable, map_route)
        "{{ let (__jet_split_first, __jet_split_second) = {split}; ({first_mapped}, {second_mapped}) }}"
