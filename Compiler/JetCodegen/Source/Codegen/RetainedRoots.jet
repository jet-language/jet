// Native root storage is a capture-address view of the ordinary owned place.
// Ownership/action grants and the existing live flags travel with that view;
// the borrowed address itself never grants a source Move.
use jet_foundation.[MIRAccess, MIRCallArg, MIRCaptureParam, MIRInstruction, MIRPlaceBase, MIRPlaceID, MIRRetainedRootCellAction, MIRRetainedRootCellBinding, MIRRetainedRootCellGrant, MIRRetainedRootLivePlace, MIRTerminator, MIRType, MIRValueID, MIROperation, Span, SymbolID, TLocal, Type, mir_ownership_from_access, tir_symbol_local]

struct JetCodegenRetainedDeferred {
    thunk: MIRValueID
    place: MIRPlaceID
    ty: Type
}

struct JetCodegenRetainedCapture {
    value: MIRValueID
    slot: Int
}

// Compiler-only annotation of a checked producer site. Native requests cannot
// manufacture this context: the admitted entry carries the resulting op IDs.
struct JetCodegenRetainedGrantContext {
    place: MIRPlaceID
    action: MIRRetainedRootCellAction
}

fn jet_codegen_record_retained_instruction(builder: &JetCodegenBuilder, instruction: MIRInstruction) Never! {
    // The emitter calls this immediately after the actual instruction push,
    // before live-flag writes or Stop polling can recursively emit cleanup.
    // Producer annotations belong to this ONE instruction, never that cleanup.
    annotation := builder.retained_grant_context
    builder.retained_grant_context = None
    site := JetCodegenRetainedGrantContext?{None}
    if instruction.operation == {
        .ReadPlace(place) -> site = Val(JetCodegenRetainedGrantContext{place: place, action: MIRRetainedRootCellAction.Read})
        .WritePlace(place, _) -> site = Val(JetCodegenRetainedGrantContext{place: place, action: MIRRetainedRootCellAction.Write})
        .MovePlace(place) -> site = Val(JetCodegenRetainedGrantContext{place: place, action: MIRRetainedRootCellAction.Move})
        .InitializeUninit(place) -> site = Val(JetCodegenRetainedGrantContext{place: place, action: MIRRetainedRootCellAction.Initialize})
        .ReplacePlace(place, _) -> site = Val(JetCodegenRetainedGrantContext{place: place, action: MIRRetainedRootCellAction.Replace})
        .AddressOf(place, access) -> {
            if access == MIRAccess.Read || access == MIRAccess.Write {
                site = Val(JetCodegenRetainedGrantContext{place: place, action: if access == MIRAccess.Write -> MIRRetainedRootCellAction.Write else -> MIRRetainedRootCellAction.Read})
            }
        }
        .IndirectCall(_, _, _) -> {
            // The deferred producer supplies Cleanup only after the owned
            // root thunk has moved to an ordinary scoped temporary.
            if annotation == .Val(context) && context.action == MIRRetainedRootCellAction.Cleanup -> site = Val(context)
        }
        else -> {}
    }
    checked := site ?? return
    index :: jet_codegen_retained_cell_index(builder, checked.place)
    if index < 0 -> return
    if annotation == .Val(context) && context.place == checked.place {
        if context.action == {
            .Initialize -> {
                if checked.action != MIRRetainedRootCellAction.Write && checked.action != MIRRetainedRootCellAction.Initialize -> panic("retained initializer annotation is not a complete value write")
            }
            .Cleanup -> {
                if checked.action != MIRRetainedRootCellAction.Move && checked.action != MIRRetainedRootCellAction.Cleanup -> panic("retained cleanup annotation is not its owned move or deferred invocation")
            }
            else -> panic("retained producer context grants only initialization or cleanup")
        }
        checked.action = context.action
    }
    &builder.retained_cells[index].grants.push(MIRRetainedRootCellGrant{function: jet_codegen_function_id(builder.function), operation: instruction.id, place: checked.place, action: checked.action})
}

// A declaration initializer is not a declaration Write permission. Annotate
// only the actual complete checked value write; the ordinary emitter publishes
// the SAME live flag after that instruction.
fn jet_codegen_initialize_retained_place(builder: &JetCodegenBuilder, program: JetCodegenProgram, span: Span, place: MIRPlaceID, value: MIRValueID) Never! {
    previous := builder.retained_grant_context
    if jet_codegen_retained_cell_index(builder, place) >= 0 -> builder.retained_grant_context = Val(JetCodegenRetainedGrantContext{place: place, action: MIRRetainedRootCellAction.Initialize})
    _ :: jet_codegen_emit(&builder, program, span, None, MIROperation.WritePlace{place: place, value: value})
    builder.retained_grant_context = previous
}

fn jet_codegen_retained_cell_index(builder: JetCodegenBuilder, place: MIRPlaceID) -> Int Never! {
    row :: builder.place_positions.get(place.value) ?? return -1
    base :: builder.places[row].base
    loop (index, cell) in builder.retained_cells {
        if cell.place == place || base == (MIRPlaceBase.Capture{value: cell.capture_value}) -> return index
    }
    -1
}

fn jet_codegen_retained_capture(builder: &JetCodegenBuilder, program: JetCodegenProgram, ty: MIRType, name: String, access: MIRAccess) -> JetCodegenRetainedCapture Never! {
    slot :: builder.capture_params.len()
    borrowed :: mir_ownership_from_access(access)
    &builder.capture_params.push(MIRCaptureParam{slot: slot, name: name, span: builder.current_span, ty: ty, access: access, ownership: borrowed, place_only: true})
    resume := builder.current
    span := builder.current_span
    builder.current = builder.entry
    value :: jet_codegen_emit_mir_type(&builder, program, span, ty, borrowed, MIROperation.Capture{slot: slot})
    builder.current = resume
    JetCodegenRetainedCapture{value: value, slot: slot}
}

fn jet_codegen_bind_retained_root(builder: &JetCodegenBuilder, program: JetCodegenProgram, local: TLocal, ty: Type, mutable: Bool) -> MIRPlaceID Never! {
    declaration :: local.symbol_id ?? panic("retained root has no checked declaration identity")
    if declaration.key == "" -> panic("retained root has an empty checked declaration identity")
    access :: if mutable -> MIRAccess.Write else -> MIRAccess.Read
    lowered :: jet_codegen_lower_type_for_function(ty, builder, program)
    capture :: jet_codegen_retained_capture(&builder, program, lowered, local.name, access)
    ownership :: jet_codegen_ownership(ty)
    place :: jet_codegen_bind_local_with_base(&builder, program, local, ty, mutable, None, Val(capture.value), Val(access), Val(ownership), false)
    // A root's MIRLocal owns its value even though its physical cell address
    // is lent to this invocation. Only recorded checked operations may use it.
    &builder.retained_cells.push(MIRRetainedRootCellBinding{declaration: declaration, ty: lowered, place: place, capture_value: capture.value, capture_slot: capture.slot, access: access, ownership: ownership, live_places: [MIRRetainedRootLivePlace]{}, grants: [MIRRetainedRootCellGrant]{}, cleanup_identity: "{builder.function.key}|root-cleanup|{place.value}"})
    jet_codegen_register_drop_live(&builder, program, place, ty, ownership, false)
    place
}

fn jet_codegen_attach_retained_live(builder: &JetCodegenBuilder, program: JetCodegenProgram, record: JetCodegenDropLive) Never! {
    index :: jet_codegen_retained_cell_index(builder, record.place)
    if index < 0 -> return
    row :: builder.place_positions.get(record.live.value) ?? panic("retained root live flag has no canonical place")
    flag_type := builder.places[row].ty
    capture :: jet_codegen_retained_capture(&builder, program, flag_type, "$root-live.{record.live.value}", MIRAccess.Write)
    builder.places[row].base = MIRPlaceBase.Capture{value: capture.value}
    value_type :: jet_codegen_lower_type_for_function(record.ty, builder, program)
    &builder.retained_cells[index].live_places.push(MIRRetainedRootLivePlace{place: record.place, live: record.live, value_type: value_type, drop_kind: record.kind})
}

fn jet_codegen_retain_deferred_call(builder: &JetCodegenBuilder, program: JetCodegenProgram, thunk: MIRValueID, result_type: Type) Never! {
    ty :: Type.Fn{params: [Type]{}, ret: Val(result_type), effect_bound: None, param_contract: None, call_metadata: None, return_view_provenance: None}
    declaration :: SymbolID{key: "{builder.function.key}|retained-defer|{thunk.value}"}
    local :: tir_symbol_local("$root-defer.{thunk.value}", builder.current_span, declaration)
    place :: jet_codegen_bind_retained_root(&builder, program, local, ty, false)
    span := builder.current_span
    jet_codegen_initialize_retained_place(&builder, program, span, place, thunk)
    &builder.retained_deferred.push(JetCodegenRetainedDeferred{thunk: thunk, place: place, ty: ty})
}

fn jet_codegen_emit_retained_deferred(builder: &JetCodegenBuilder, program: JetCodegenProgram, thunk: MIRValueID) -> Bool Never! {
    loop deferred_view in builder.retained_deferred {
        if deferred_view.thunk != thunk -> next
        // copy: the lowering helpers below write the builder (`&builder`), and `deferred_view` is a
        // row of builder.retained_deferred, so its metadata is detached before those writes.
        deferred := deferred_view.copy()
        record := JetCodegenDropLive?{None}
        loop live in builder.drop_live_places {
            if live.place == deferred.place -> record = Val(live)
        }
        owner :: record ?? panic("retained defer has no canonical live flag")
        span := builder.current_span
        live :: jet_codegen_emit_value(&builder, program, span, Type.Bool, MIROperation.ReadPlace{place: owner.live})
        run :: jet_codegen_new_block(&builder, program, span, "retained-defer-live")
        next_block :: jet_codegen_new_block(&builder, program, span, "retained-defer-next")
        jet_codegen_terminate(&builder, program, MIRTerminator.Branch{condition: live, then_target: run, else_target: next_block})
        jet_codegen_switch_block(&builder, program, run)
        // IndirectCall borrows its native closure box; it does not release it.
        // Claim the root owner BEFORE the callback, using MovePlace's existing
        // flag clear. Ordinary scoped ownership covers callback Stop as well
        // as normal return, without re-registering a root cleanup.
        jet_codegen_enter_lexical(&builder, program)
        previous := builder.retained_grant_context
        builder.retained_grant_context = Val(JetCodegenRetainedGrantContext{place: deferred.place, action: MIRRetainedRootCellAction.Cleanup})
        moved :: jet_codegen_emit_value(&builder, program, span, deferred.ty, MIROperation.MovePlace{place: deferred.place})
        declaration :: SymbolID{key: "{builder.function.key}|retained-defer-invoke|{deferred.thunk.value}"}
        local :: tir_symbol_local("$root-defer-invoke.{deferred.thunk.value}", span, declaration)
        temporary :: jet_codegen_bind_local_with_base(&builder, program, local, deferred.ty, false, None, None, None, None, false)
        _ :: jet_codegen_emit(&builder, program, span, None, MIROperation.WritePlace{place: temporary, value: moved})
        ty :: jet_codegen_lower_type_for_function(deferred.ty, builder, program)
        value :: jet_codegen_emit_mir_type(&builder, program, span, ty, mir_ownership_from_access(MIRAccess.Read), MIROperation.ReadPlace{place: temporary})
        builder.retained_grant_context = Val(JetCodegenRetainedGrantContext{place: deferred.place, action: MIRRetainedRootCellAction.Cleanup})
        _ :: jet_codegen_emit(&builder, program, span, None, MIROperation.IndirectCall{callee: value, args: [MIRCallArg]{}, type_args: [MIRType]{}})
        builder.retained_grant_context = previous
        jet_codegen_leave_lexical(&builder, program)
        if jet_codegen_current_is_open(builder, program) -> jet_codegen_terminate(&builder, program, MIRTerminator.Jump{target: next_block})
        jet_codegen_switch_block(&builder, program, next_block)
        return true
    }
    false
}
