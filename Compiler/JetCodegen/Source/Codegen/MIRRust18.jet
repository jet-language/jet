use jet_foundation.MIR.*
use jet_foundation.Syntax.TYPE_FRACTION
use jet_codegen.Codegen.MIRRust.[RustEmitter, copy_tags_enabled, allocator_view_inner, has_native_type_projection, mangle, mangle_path, mangle_variant]
use std.collections.BTreeSet
// GATE #4499: exact MIR IDs, constant integer widths, nominal identities and ordered bindings.
// Extends the canonical RustEmitter; the preceding value_copy tail is owned by 2017.
impl RustEmitter {
    // Rust: crates/jet-codegen/src/Codegen/MIRRust.rs:30608
    // Owned scalar reads are type-backed; other copies keep the ratchet's unbacked tag.
    fn value_owned(self, value: MirValueId) -> String {
        scalar :: self.history_current_function.get().is_some_and((id) -> {
            function :: self.function_row(id)
            self.function_index(function).values.get(&value).is_some_and((row) -> function.values[row].3.mode == MirOwnershipMode.Copy)
        })
        if scalar -> self.value_copy(value, MirCopyFact.Scalar) else -> self.copy_text(value, "unbacked")
    }
    // Rust: crates/jet-codegen/src/Codegen/MIRRust.rs:30623
    fn copy_text(self, value: MirValueId, tag: String) -> String {
        borrow :: self.value_borrow(value)
        bitwise :: self.history_current_function.get().is_some_and((id) -> self.rust_copy_carrier(self.value_type(self.function_row(id), value)))
        if bitwise -> "(*{borrow})" else if copy_tags_enabled() -> "({borrow}).clone()/*copy:{tag}*/" else -> "({borrow}).clone()"
    }
    // Rust: crates/jet-codegen/src/Codegen/MIRRust.rs:30638
    fn rust_copy_carrier(self, ty: MirType) -> Bool {
        canonical :: if ty.identity.is_some() -> self.canonical_type(ty) else -> ty
        if canonical.kind() == {
            .Bool | .Char | .Float | .Float32 | .Measure(_) -> true
            .IntN(bits: bits) -> bits == 8 || bits == 16 || bits == 32 || bits == 64 || bits == 128
            .Tagged(marker: .Internal(.AllocatorView)) -> false
            .InlineRange(base: base) | .Tagged(inner: base) | .Quantity(base: base) -> self.rust_copy_carrier(base)
            else -> false
        }
    }
    // Rust: crates/jet-codegen/src/Codegen/MIRRust.rs:30658
    fn value_move(self, value: MirValueId) -> String {
        if self.history_binding(value) == Val((base, access)) {
            if access != MirAccess.Move { return self.value_owned(value) }
            return self.move_base(self.function_row(self.history_current_function.get().expect("current native function")), &base)
        }
        if self.history_current_function.get().is_some_and((id) -> allocator_view_inner(self.value_type(self.function_row(id), value)).is_some()) { return "{value_slot(value)}.take().expect(\"MIR value\")" }
        if self.history_current_function.get().map((id) -> self.function_row(id)) == Val(function) {
            if self.partial_move_root(function, &MirPlaceBase.Temporary(value)) == Val(node) { return "{{ {self.restore_partial_node(node)} {node.slot}.take().expect(\"MIR whole move\") }}" }
        }
        "{value_slot(value)}.take().expect(\"MIR value\")"
    }
    // Rust: crates/jet-codegen/src/Codegen/MIRRust.rs:30687
    fn value_borrow_mut(self, value: MirValueId) -> String { self.value_slot_reference(value, true) }
    // Rust: crates/jet-codegen/src/Codegen/MIRRust.rs:30694
    // Identity first, then exact key; a bare display name is admitted only if unique.
    fn typed_constant_definition(self, nominal: MirNominalRef) -> MirTypeDef? {
        types :: self.program.types
        if types.iter().find((definition) -> definition.id == nominal.id).or_else(() -> types.iter().find((definition) -> definition.key == nominal.name)) == Val(definition) { return Val(definition) }
        named := types.iter().filter((definition) -> definition.name == nominal.name)
        definition :: named.next() ?? return nil
        if named.next().is_none() -> Val(definition) else -> nil
    }
    // Rust: crates/jet-codegen/src/Codegen/MIRRust.rs:30710
    fn typed_struct_constant(self, nominal: MirNominalRef, args: [MirType], type_name: String, fields: [(String, MirConstant)]) -> String? {
        definition :: self.typed_constant_definition(nominal) ?? return nil
        if type_name != nominal.name && type_name != definition.key && type_name != definition.name { return nil }
        declared :: if definition.kind == .Struct(fields: declared) -> declared else -> return nil
        bindings :: definition.generic_params.iter().zip(args).map((pair) -> (pair.0.name.clone(), pair.1.clone())).collect::<[String: MirType]>()
        rendered := [String]()
        loop field in declared.iter().filter((field) -> !field.computed) {
            pair :: fields.iter().find((pair) -> pair.0 == field.name) ?? return nil
            field_ty :: Self.history_capture_type(&field.ty, &bindings)
            value := self.constant_for_type(pair.1, &field_ty)
            if definition.boxed_edges.iter().any((edge) -> edge == field.name) { value = "Box::new({value})" }
            rendered.push("{self.field_name(field.id)}: {value}")
        }
        constructor := self.rust_apply_type(nominal, args)
        if !args.is_empty() {
            start :: constructor.find('<').expect("checked generic struct constructor has type arguments")
            constructor.insert_str(start, "::")
        }
        Val("{constructor} {{ {rendered.join(", ")} }}")
    }
    // Rust: crates/jet-codegen/src/Codegen/MIRRust.rs:30759
    fn typed_enum_constant(self, nominal: MirNominalRef, args: [MirType], type_name: String, variant: String, values: [(String?, MirConstant)]) -> String? {
        definition :: self.typed_constant_definition(nominal) ?? return nil
        if type_name != nominal.name && type_name != definition.key && type_name != definition.name { return nil }
        variants :: if definition.kind == .Enum(variants: variants) -> variants else -> return nil
        if has_native_type_projection(type_name) { return nil }
        declared_variant :: variants.iter().find((candidate) -> candidate.name == variant).unwrap_or_else(() -> panic("MIR enum variant {variant:?} has no row"))
        bindings :: definition.generic_params.iter().zip(args).map((pair) -> (pair.0.name.clone(), pair.1.clone())).collect::<[String: MirType]>()
        if values.iter().any((pair) -> pair.0.is_some()) && values.iter().any((pair) -> pair.0.is_none()) { panic("MIR enum constant mixes named and positional payloads") }
        variant_name :: mangle_variant(&declared_variant.name)
        owner_name :: self.anonymous_union_definition(&definition.key).map((canonical) -> mangle_path(&canonical.key)).unwrap_or_else(() -> {
            shared :: self.program.types.iter().filter((candidate) -> candidate.name == definition.name).nth(1).is_some()
            self.nominal_name(if shared -> definition.key else -> type_name)
        })
        variant_path :: "{owner_name}::{variant_name}"
        if declared_variant.payload == {
            .Unit -> {
                if !values.is_empty() { panic("MIR unit variant construction has payload arguments") }
                Val(variant_path)
            }
            .Single(payload) -> {
                if values.len() != 1 { panic("MIR single variant construction payload arity mismatch") }
                (field, constant) :: values[0]
                if field.is_some() { panic("MIR single variant construction payload must be positional") }
                payload_ty :: Self.history_capture_type(payload, &bindings)
                value := self.constant_for_type(constant, &payload_ty)
                if definition.boxed_edges.iter().any((edge) -> edge == declared_variant.name) { value = "Box::new({value})" }
                Val("{variant_path}({value})")
            }
            .Named(fields) -> {
                if values.len() != fields.len() { panic("MIR named variant construction payload arity mismatch") }
                seen := BTreeSet<String>()
                loop pair in values {
                    field :: pair.0.as_deref().unwrap_or_else(() -> panic("MIR named variant construction requires named payload fields"))
                    if !seen.insert(field) || !fields.iter().any((declared) -> declared.name == field) { panic("MIR named variant construction field order mismatch") }
                }
                rendered :: fields.iter().map((field) -> {
                    pair :: values.iter().find((pair) -> pair.0.as_deref() == Val(field.name)).expect("checked named enum field")
                    field_ty :: Self.history_capture_type(&field.ty, &bindings)
                    edge :: "{declared_variant.name}.{field.name}"
                    value := self.constant_for_type(pair.1, &field_ty)
                    if definition.boxed_edges.iter().any((candidate) -> candidate == edge) { value = "Box::new({value})" }
                    "{self.field_name(field.id)}: {value}"
                }).collect::<[String]>().join(", ")
                Val("{variant_path} {{ {rendered} }}")
            }
        }
    }
    // Rust: crates/jet-codegen/src/Codegen/MIRRust.rs:30876
    fn constant_for_type(self, constant: MirConstant, ty: MirType) -> String {
        if ty.kind() == {
            .Int -> if constant == {
                .Int(value: value) -> "jet_foundation::Numeric::JetInt::from_i64({value})"
                .BigInt(value) -> "{self.config.root_prefix}jet_std::jet_int_owned_from_str({value:?}).expect(\"MIR Int\")"
                else -> self.constant(constant)
            }
            .InlineRange(base: base) | .Tagged(inner: base) | .Quantity(base: base) -> self.constant_for_type(constant, base)
            .IntN(signed: signed, bits: bits) -> {
                value :: if constant == {
                    .Int(value: value) -> if signed -> value.to_string() else -> (value as U64).to_string()
                    .BigInt(value) -> value.clone()
                    else -> return self.constant(constant)
                }
                "{value}{if signed -> "i" else -> "u"}{bits}"
            }
            .Option(inner) -> if constant == { .Present(value) -> "Ok({self.constant_for_type(value, inner)})"; else -> self.constant(constant) }
            .Result(ok: ok, err: err) -> if constant == {
                .Present(value) -> "Ok({self.constant_for_type(value, ok)})"
                .Failed(.Told(value)) -> "Err({self.constant_for_type(value, err)})"
                else -> self.constant(constant)
            }
            .List(inner) | .FixedList(elem: inner) -> {
                constants :: if constant == .List(values) -> values else -> return self.constant(constant)
                values :: constants.iter().map((value) -> self.constant_for_type(value, inner)).collect::<[String]>().join(", ")
                if ty.kind() == .FixedList -> "[{values}]" else -> "vec![{values}]"
            }
            .Map(key: key_ty, value: value_ty) -> {
                entries :: if constant == .Map(entries) -> entries else -> return self.constant(constant)
                pairs :: entries.iter().map((pair) -> {
                    key :: if pair.0 == .Int(literal) -> self.constant_for_type(&MirConstant.Int(value: literal, width: nil, spelling: nil), key_ty) else -> self.const_key(pair.0)
                    "({key}, {self.constant_for_type(pair.1, value_ty)})"
                }).collect::<[String]>().join(", ")
                "[{pairs}].into_iter().collect::<{self.rust_type(ty)}>()"
            }
            .Apply(name: name, args: args) -> if constant == {
                .Struct(type_name: type_name, fields: fields) -> self.typed_struct_constant(name, args, type_name, fields).unwrap_or_else(() -> self.constant(constant))
                .Enum(type_name: type_name, variant: variant, args: values) -> self.typed_enum_constant(name, args, type_name, variant, values).unwrap_or_else(() -> self.constant(constant))
                else -> self.constant(constant)
            }
            .Union(_) -> if constant == {
                .Enum(type_name: type_name, variant: variant, args: values) -> {
                    definition :: self.structural_type_def_for(ty) ?? return self.constant(constant)
                    nominal :: MirNominalRef(id: definition.id, name: definition.key.clone())
                    self.typed_enum_constant(&nominal, [], type_name, variant, values).unwrap_or_else(() -> self.constant(constant))
                }
                else -> self.constant(constant)
            }
            else -> self.constant(constant)
        }
    }
    // Rust: crates/jet-codegen/src/Codegen/MIRRust.rs:30994
    fn constant(self, constant: MirConstant) -> String {
        if constant == {
            .Int(value: value, width: width, spelling: spelling) -> if width == {
                Val((signed, bits)) -> {
                    literal :: if signed -> spelling.clone().unwrap_or_else(() -> value.to_string()) else -> (value as U64).to_string()
                    "{literal}{if signed -> "i" else -> "u"}{bits}"
                }
                nil -> spelling.clone().unwrap_or_else(() -> value.to_string())
            }
            .Float(value: value, f32: f32, spelling: spelling) -> spelling.clone().unwrap_or_else(() -> {
                if value.is_nan() -> (if f32 -> "f32::NAN" else -> "f64::NAN")
                else if value.is_infinite() -> (if value.is_sign_negative() -> (if f32 -> "f32::NEG_INFINITY" else -> "f64::NEG_INFINITY") else -> (if f32 -> "f32::INFINITY" else -> "f64::INFINITY"))
                else if f32 -> "{value:?}f32" else -> "{value:?}f64"
            })
            .Bool(value) -> value.to_string()
            .Char(value) -> "{value:?}"
            .String(value) -> if self.is_core_layer() -> "{value:?}" else -> "{value:?}.to_string()"
            .Bytes(value) -> "vec![{value.iter().map((byte) -> byte.to_string()).collect::<[String]>().join(", ")}]"
            .Unit -> "()"
            .BigInt(value) -> "{self.config.root_prefix}jet_std::jet_int_owned_from_str({value:?}).expect(\"MIR Int\")"
            .List(values) -> "vec![{values.iter().map((value) -> self.constant(value)).collect::<[String]>().join(", ")}]"
            .Map(values) -> {
                pairs :: values.iter().map((pair) -> "({self.const_key(pair.0)}, {self.constant(pair.1)})").collect::<[String]>().join(", ")
                "[{pairs}].into_iter().collect::<{self.config.root_prefix}JetMap<_,_>>()"
            }
            .Struct(type_name: type_name, fields: fields) if type_name == TYPE_FRACTION && !self.types_by_name.contains_key(type_name) -> {
                part :: (name: String) -> {
                    value :: fields.iter().find((pair) -> pair.0 == name).unwrap_or_else(() -> panic("MIR Fraction has no {name}")).1
                    if !(if value == { .Int | .BigInt(_) -> true; else -> false }) { panic("MIR Fraction {name} is not an Int") }
                    self.constant_for_type(value, &MirType.from_kind(MirTypeKind.Int))
                }
                "{self.config.root_prefix}jet_fraction_from_parts({part("numerator")}, {part("denominator")})"
            }
            .Struct(type_name: type_name, fields: fields) -> {
                native :: has_native_type_projection(type_name)
                rendered :: fields.iter().map((pair) -> {
                    name :: if native -> pair.0.clone() else -> mangle(pair.0)
                    "{name}: {self.constant(pair.1)}"
                }).collect::<[String]>().join(", ")
                "{self.nominal_name(type_name)} {{ {rendered} }}"
            }
            .Enum(type_name: type_name, variant: variant, args: args) -> {
                native :: has_native_type_projection(type_name)
                variant_name :: if native -> variant.clone() else -> mangle_variant(variant)
                path :: "{self.nominal_name(type_name)}::{variant_name}"
                if args.is_empty() -> path
                else if args.iter().all((pair) -> pair.0.is_some()) -> {
                    fields :: args.iter().map((pair) -> {
                        label :: pair.0.as_deref().expect("checked enum field")
                        name :: if native -> label.to_string() else -> mangle(label)
                        "{name}: {self.constant(pair.1)}"
                    }).collect::<[String]>().join(", ")
                    "{path} {{ {fields} }}"
                }
                else if args.iter().all((pair) -> pair.0.is_none()) -> {
                    values :: args.iter().map((pair) -> self.constant(pair.1)).collect::<[String]>().join(", ")
                    "{path}({values})"
                }
                else -> panic("MIR enum constant mixes named and positional payloads")
            }
            .Present(value) -> "Ok({self.constant(value)})"
            .Failed(report) -> if report == { .Clean(_) -> "Err({self.config.root_prefix}JetAbsent)"; .Told(value) -> "Err({self.constant(value)})" }
        }
    }
    // Rust: crates/jet-codegen/src/Codegen/MIRRust.rs:31168
    fn const_key(self, key: MirConstKey) -> String {
        if key == {
            .Int(value) -> value.to_string()
            .String(value) -> if self.is_core_layer() -> "{value:?}" else -> "{value:?}.to_string()"
            .Bool(value) -> value.to_string()
            .Char(value) -> "{value:?}"
            .Tuple(values) -> "({values.iter().map((pair) -> self.const_key(pair.1)).collect::<[String]>().join(", ")})"
            .Struct(type_name: type_name, fields: fields) -> {
                native :: has_native_type_projection(type_name)
                rendered :: fields.iter().map((pair) -> {
                    name :: if native -> pair.0.clone() else -> mangle(pair.0)
                    "{name}: {self.const_key(pair.1)}"
                }).collect::<[String]>().join(", ")
                "{self.nominal_name(type_name)} {{ {rendered} }}"
            }
            .Enum(type_name: type_name, variant: variant) -> {
                native :: has_native_type_projection(type_name)
                variant_name :: if native -> variant.clone() else -> mangle_variant(variant)
                "{self.nominal_name(type_name)}::{variant_name}"
            }
        }
    }
}
// Rust: crates/jet-codegen/src/Codegen/MIRRust.rs:31216
fn value_slot(value: MirValueId) -> String { "__jet_v_{value.0}" }
// Rust: crates/jet-codegen/src/Codegen/MIRRust.rs:31220
// Parks a later payload of a moved enum subject until its own binding takes it.
fn payload_slot(value: MirValueId) -> String { "__jet_pm_{value.0}" }
// Rust: crates/jet-codegen/src/Codegen/MIRRust.rs:31226
fn local_slot(local: MirLocalId) -> String { "__jet_l_{local.0}" }
// Rust: crates/jet-codegen/src/Codegen/MIRRust.rs:31230
fn fixed_inline_backing_name(value: MirValueId) -> String { "__jet_fixed_backing_v{value.0}" }
