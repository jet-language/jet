fn collect_serde_codec_demands(funcs: [TFunc], &demands: [String:(Type, String, [Type])]) Never! {
    // Rust: crates/jet-codegen/src/Codegen/TIR/mod.rs:1477
    fn walk_expr(expr: TExpr, &demands: [String:(Type, String, [Type])]) Never! {
