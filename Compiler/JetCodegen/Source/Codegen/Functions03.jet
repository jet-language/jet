                if encoding && (record.member == "to_string" || record.member == "to_string_pretty" || record.member == "to_bytes" || record.member == "to_bytes_canonical") && !args.is_empty() -> demand_serde_codec(&demands, args[0].ty, "encode")
                if encoding && record.member == "decode" && expr.ty == .Result(ok, _) -> demand_serde_codec(&demands, ok, "decode")
            }
            else -> {}
        }
