                    .DataTreeDecode(target) -> demand_serde_codec(&demands, target, "decode")
                    else -> {}
                }
            }
            .DecodeUnder(segment, inner) -> { walk_expr(segment, &demands); walk_expr(inner, &demands) }
            .Try(inner, _, _, _, note) -> {
                walk_expr(inner, &demands)
                if note == Val(value) -> walk_expr(value, &demands)
            }
            .OrFallback(value, fallback, _) -> {
