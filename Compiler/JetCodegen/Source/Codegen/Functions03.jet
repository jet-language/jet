fn published_schema(definition: StructDef) -> Bool Never! {
    if definition.is_published_schema -> return true
    loop (marker, _) in definition.derives {
        if marker == Syntax.MARKER_PUBLISHED_SCHEMA -> return true
    }
    false
}
