pub struct TirWorklist<T> { pending: [T] }
impl<T> TirWorklist<T> {
    // Rust: crates/jet-codegen/src/Codegen/TIR/mod.rs:414
    pub fn new() -> Self Never! { Self{pending: []} }
    // Rust: crates/jet-codegen/src/Codegen/TIR/mod.rs:420
    pub fn from_reversed<I: IntoIterator<T>>(items: I) -> Self Never! {
        pending := items.into_iter().collect()
        &pending.reverse()
        Self{pending: ^pending}
    }
    // Rust: crates/jet-codegen/src/Codegen/TIR/mod.rs:429
    pub fn push(&self, item: T) Never! { &self.pending.push(^item) }
    // Rust: crates/jet-codegen/src/Codegen/TIR/mod.rs:433
    pub fn extend<I: IntoIterator<T>>(&self, items: I) Never! { &self.pending.extend(items.into_iter()) }
    // Rust: crates/jet-codegen/src/Codegen/TIR/mod.rs:440
    pub fn pop(&self) -> T? Never! { &self.pending.pop() }
    // Rust: crates/jet-codegen/src/Codegen/TIR/mod.rs:446
    pub fn default() -> Self Never! { Self.new() }
}
