//RS 
//RS /// The one total checked analytical program. Every checked executable body is
//RS /// represented by one `TFunc` row with its module/source identity attached.
//RS ///
//RS /// Resident engines may temporarily read the same model while their old
//RS /// adapters are removed.
//RS pub struct TirProgram {
//RS     /// Stable package identity supplied by the checked bundle.
//RS     pub package_identity: String,
//RS     /// D-MOD-CYCLE1=A: the entry's module identity and the call prefix its
//RS     /// package siblings use for it (`__jet_run::`). A sibling reaches an entry
//RS     /// function through the ordinary imported-call spelling, while the entry
//RS     /// lowers its own functions unprefixed; MIR resolves the first to the
//RS     /// second. `None` when the entry has no package siblings.
//RS     pub entry_sibling_calls: Option<(String, String)>,
//RS     pub facts: TirPackageFacts,
//RS     /// Display path of the entry module retained for temporary diagnostics.
//RS     pub source_file: String,
//RS     /// Source text of the entry module retained for temporary diagnostics.
//RS     pub source_text: String,
//RS     /// Canonical source text keyed by every checked module display path.
//RS     pub source_files: std::collections::BTreeMap<String, String>,
//RS     /// D-MEM-GUARANTEE1: package hardening is a checked bundle fact carried
//RS     /// into named deopt; the evaluator never reparses package.jet.
//RS     pub package_hardened: bool,
//RS     /// D-EFFECT-AUTHORITY1: the sema-projected application decision travels
//RS     /// with the lowered program. TIR, JIT, deopt, and the interpreter consume
//RS     /// this value; none of them rediscover package.jet or re-solve effects.
//RS     pub application_authority: jet_foundation::Authority::ApplicationAuthority,
//RS     /// D-REL3: the package edition is a checked bundle fact carried the same
//RS     /// way, because every tier that runs this program answers edition-gated
//RS     /// questions from the checked bundle.
//RS     pub edition: String,
//RS     /// Every checked executable body, including imported modules and methods.
//RS     pub funcs: Vec<TFunc>,
//RS     /// All checked declaration rows.  MIR receives this projection rather than
//RS     /// re-walking source items or reading generated names.
//RS     declarations: TirDeclarations,
//RS     /// Checked module/link/entry/harness/artifact facts for the selected request.
//RS     artifact_facts: TirArtifactFacts,
//RS     /// Exact checked Core registry identities, including receiver rows.
//RS     pub core_calls: Vec<&'static crate::Syntax::CoreCallRecord>,
//RS     /// Explicitly erased or unreachable checked constructs.
//RS     pub unreachable: Vec<TirErasure>,
//RS     /// c139 M4: spawn lambda bodies in program traversal order.
//RS     pub spawn_lambdas: Vec<TJitSpawnLambda>,
//RS     /// M5: mangled field names per struct type (field order).
//RS     pub struct_fields: std::collections::HashMap<String, Vec<String>>,
//RS     /// M5: field types parallel to `struct_fields` order.
//RS     pub struct_field_types: std::collections::HashMap<String, Vec<Type>>,
//RS     /// D-FIELDMEMO1=A: stored-field dependency edges consumed by the JIT
//RS     /// invalidation adapter. Values are memo getter names, not policy.
//RS     pub memo_dependencies:
//RS         std::collections::HashMap<String, std::collections::HashMap<String, Vec<String>>>,
//RS     /// D-METAREFLECT1: registered field rows shared with comptime reflection.
//RS     pub reflection_fields:
//RS         std::collections::HashMap<String, Vec<jet_foundation::Reflection::ReflectionField>>,
//RS     /// Canonical typeable paths used by interpreter reflection.
//RS     pub reflect_paths: std::collections::HashMap<String, String>,
//RS     /// #2252: the ONE projection from a TIR nominal spelling to the canonical
//RS     /// module-qualified identity every shape, codec, and method table is keyed
//RS     /// by. TIR carries three spellings of the same imported type - the bare
//RS     /// local leaf inside the module that declares it, the alias-qualified
//RS     /// source name in a consumer (`plan.ListReport`), and the canonical
//RS     /// identity a qualified call return already resolves to - while the tables
//RS     /// hold exactly one. Both engines resolve through this map instead of
//RS     /// searching table keys by suffix; a spelling two modules could claim is
//RS     /// absent, so an ambiguous name still reports the ordinary missing-shape
//RS     /// diagnostic rather than silently picking a module.
//RS     pub nominal_identities: std::collections::HashMap<String, String>,
//RS     /// Declared generic parameter names per struct, in source order.
//RS     pub struct_type_params: std::collections::HashMap<String, Vec<String>>,
//RS     /// M5: mangled variant names per enum type (discriminant order).
//RS     pub enum_variants: std::collections::HashMap<String, Vec<String>>,
//RS     /// M5: payload field types per `__jet_Type::__jet_Variant` pattern prefix.
//RS     pub enum_variant_payload_types: std::collections::HashMap<String, Vec<Type>>,
//RS     /// Functions whose typed decode must use the canonical TIR migration plan.
//RS     pub canonical_deopt: std::collections::HashSet<String>,
//RS     /// Functions whose codec calls must remain canonical during named deopt.
//RS     pub canonical_calls: std::collections::HashSet<String>,
//RS     pub int_constants: std::collections::HashMap<String, i64>,
//RS     pub constants: std::collections::HashMap<String, crate::AST::CtValue>,
//RS     pub distinct_bases: std::collections::HashMap<String, Type>,
//RS     pub distinct_ranges: std::collections::HashMap<String, (i64, i64)>,
//RS     /// Published-schema migration plans compiled from sema facts. The
//RS     /// evaluator applies these wire-key operations before re-entering the
//RS     /// ordinary lowered `Decode` body.
//RS     pub codec_migrations: std::collections::HashMap<String, SchemaMigrationPlan>,
//RS     /// S62/M9: exact checked `(owner, method) -> trait` identity for static
//RS     /// associated calls. This is projected once; lowerers never scan owners.
//RS     pub trait_method_traits: std::collections::HashMap<(String, String), String>,
//RS     pub iterable_item_types: std::collections::HashMap<(String, String), Type>,
//RS }
//RS 
