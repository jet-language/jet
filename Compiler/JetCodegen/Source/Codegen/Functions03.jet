// Rust: crates/jet-codegen/src/Codegen/TIR/mod.rs:739
pub fn canonical_payload(program: TirProgram) -> String Never! {
    funcs := [String]{}
    loop (index, function) in program.funcs.enumerate() {
        params := [String]{}
        loop parameter in function.params {
            &params.push("{\"name\":\"" + json_escape(parameter.name) + "\",\"type\":\"" + json_escape(parameter.ty.name()) + "\",\"convention\":\"{parameter.convention:?}\"}")
        }
        ret :: if function.ret == Val(ty) -> "\"" + json_escape(ty.name()) + "\"" else -> "null"
        &funcs.push("{\"index\":{index},\"name\":\"" + json_escape(function.name) + "\",\"module\":\"" + json_escape(function.module_name) + "\",\"key\":\"" + json_escape(function.key) + "\",\"source_file\":\"" + json_escape(function.source_file) + "\",\"source_span\":{\"start\":{function.source_span.start},\"end\":{function.source_span.end}},\"params\":[" + params.join(",") + "],\"ret\":" + ret + ",\"body_nodes\":{function.body.len()},\"is_main\":{function.is_main},\"synthetic\":{function.synthetic}}")
    }
    "{\"representation\":\"tir\",\"package\":\"" + json_escape(program.package_identity) + "\",\"source_file\":\"" + json_escape(program.source_file) + "\",\"edition\":\"" + json_escape(program.edition) + "\",\"functions\":[" + funcs.join(",") + "]}"
}
