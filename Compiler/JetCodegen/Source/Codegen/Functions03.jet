// Rust: crates/jet-codegen/src/Codegen/TIR/mod.rs:68
fn source_array_literal(definition: ConstDef) -> (Type, [Expr])? Never! {
    if definition.mutable || definition.is_comptime -> return None
    if definition.value == {
        .TypedLit(Val(Type.List(element)), body, _) -> {
            if element != Type.Int && element != Type.IntN(false, 8) -> return None
            if body == {
                .Elements(elements) -> return Val((element, elements))
                .Empty -> return Val((element, []))
                else -> return None
            }
        }
        else -> return None
    }
}
// Rust: crates/jet-codegen/src/Codegen/TIR/mod.rs:99
fn source_integer_constant_value(expression: Expr) -> CtValue? Never! {
    if expression == {
        .Int(value, _, _, raw) -> {
            if raw == Val(spelling) {
                text :: spelling.replace("_", "")
                if text.parse_i64() == None {
                    if CtBigInt.from_literal(text) == Ok(big) -> return Val(CtValue.BigInt(big))
                }
            }
            return Val(CtValue.Int(value))
        }
        else -> return None
    }
}
// Rust: crates/jet-codegen/src/Codegen/TIR/mod.rs:114
pub fn source_constant_type(definition: ConstDef) -> Type? Never! {
    if definition.ty == Val(ty) -> return Val(ty)
    if definition.ct == Val(value) -> return Val(value.jet_type())
    if source_array_literal(definition) == Val((element, _)) -> return Val(Type.List(element))
    if definition.value == {
        .Int(_, _, _, _) -> Val(Type.Int)
        .Float(_, _, is_f32, _) -> Val(if is_f32 -> Type.Float32 else -> Type.Float)
        .Bool(_, _) -> Val(Type.Bool)
        .Char(_, _) -> Val(Type.Char)
        .Str(parts, _) -> {
            if parts.len() == 1 && parts[0] == .Lit(_) -> Val(Type.String) else -> None
        }
        else -> None
    }
}
// Rust: crates/jet-codegen/src/Codegen/TIR/mod.rs:142
pub fn source_constant_value(definition: ConstDef) -> CtValue? Never! {
    if definition.ct == Val(value) -> return Val(value)
    if definition.value == {
        .Int(_, _, _, _) -> return source_integer_constant_value(definition.value)
        .Float(value, _, is_f32, _) -> return Val(CtValue.Float(CtFloat.literal(value, is_f32)))
        .Bool(value, _) -> return Val(CtValue.Bool(value))
        .Char(value, _) -> return Val(CtValue.Char(value))
        .Str(parts, _) -> {
            if parts.len() == 1 && parts[0] == .Lit(value) -> return Val(CtValue.Str(value))
        }
        else -> {}
    }
    (_, elements) :: source_array_literal(definition) ?? return None
    values := [CtValue]{}
    loop element in elements {
        value :: source_integer_constant_value(element) ?? return None
        &values.push(value)
    }
    Val(CtValue.List(^values))
}
