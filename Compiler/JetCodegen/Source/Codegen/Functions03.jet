// Rust: crates/jet-codegen/src/Codegen/TIR/mod.rs:483
fn target_hardware_setups(bundle: ProgramBundle, hardware: TargetHardwareUse, profile: TargetHardwareFacts?, profile_id: String) -> [THardwareSetup] Never! {
    facts :: profile ?? return []
    if profile_id.is_empty() -> return []
    setups := [THardwareSetup]{}
    channels := [String:Bool]{}
    loop operation in hardware.dma_operations {
        if operation.operation != TargetDmaOperation.Start || channels.contains_key(operation.channel) -> next
        channels[operation.channel] = true
        channel :: facts.dma_channel(operation.channel) ?? next
        &setups.push(THardwareSetup.DmaConfigure(profile_id, channel.name, channel.transfer_width, channel.ownership))
    }
    loop handler in hardware.interrupt_handlers {
        interrupt :: facts.interrupt(handler.interrupt) ?? next
        handler_symbol := handler.handler
        found := false
        loop module in bundle.modules {
            loop item in module.items {
                matches_handler := false
                if item == {
                    .Func(function) -> matches_handler = function.name == handler.handler
                    .Struct(definition) | .Enum(definition) -> {
                        loop method in definition.methods {
                            if method.name == handler.handler -> matches_handler = true
                        }
                        loop implementation in definition.trait_impls {
                            loop method in implementation.methods {
                                if method.name == handler.handler -> matches_handler = true
                            }
                        }
                    }
                    .Impl(implementation) -> {
                        loop method in implementation.methods {
                            if method.name == handler.handler -> matches_handler = true
                        }
                    }
                    else -> {}
                }
                if matches_handler {
                    handler_symbol = "{module.alias}::{handler.handler}"
                    found = true
                    break
                }
            }
            if found -> break
        }
        effects := interrupt.forbidden_effects.clone()
        &effects.extend(handler.forbidden_effects)
        &setups.push(THardwareSetup.InterruptBind(profile_id, interrupt.name, interrupt.vector, handler_symbol, ^effects))
    }
    setups
}
// Rust: crates/jet-codegen/src/Codegen/TIR/mod.rs:574
pub enum TirErasureReason { CompileTimeOnly Disabled ExpandedBeforeLowering SemanticIndexOnly }
// Rust: crates/jet-codegen/src/Codegen/TIR/mod.rs:584
pub struct TirErasure { pub construct: String pub span: Span pub reason: TirErasureReason }
// Rust: crates/jet-codegen/src/Codegen/TIR/mod.rs:590
fn collect_item_erasures(items: [Item], module: String, include_tests: Bool, &rows: [TirErasure]) Never! {
    loop item in items {
        row := (String, Span, TirErasureReason)?{None}
        if item == {
            .Tag(value) -> row = Val(("Tag", value.span, TirErasureReason.CompileTimeOnly))
            .EffectDecl(value) -> row = Val(("EffectDecl", value.span, TirErasureReason.CompileTimeOnly))
            .MarkerDecl(value) -> row = Val(("MarkerDecl", value.span, TirErasureReason.CompileTimeOnly))
            .FactDecl(value) -> row = Val(("FactDecl", value.span, TirErasureReason.CompileTimeOnly))
            .GenericModule(value) -> row = Val(("GenericModule", value.span, TirErasureReason.CompileTimeOnly))
            .UserDerive(value) -> row = Val(("UserDerive", value.span, TirErasureReason.CompileTimeOnly))
            .TemplateLoop(value) -> row = Val(("TemplateLoop", value.span, TirErasureReason.ExpandedBeforeLowering))
            .ModuleAlias(value) -> row = Val(("ModuleAlias", value.span, TirErasureReason.ExpandedBeforeLowering))
            .ProtocolDecl(value) -> row = Val(("ProtocolDecl", value.span, TirErasureReason.ExpandedBeforeLowering))
            .UnitFamily(value) -> row = Val(("UnitFamily", value.span, TirErasureReason.ExpandedBeforeLowering))
            .Migration(value) -> row = Val(("Migration", value.span, TirErasureReason.SemanticIndexOnly))
            .Module(value) -> row = Val(("Module", value.span, TirErasureReason.SemanticIndexOnly))
            .Test(value) -> { if !include_tests -> row = Val(("Test", value.span, TirErasureReason.Disabled)) }
            .CodeModule(value) -> {
                if value.body == Val(body) -> collect_item_erasures(body, "{module}::{value.name}", include_tests, &rows)
            }
            else -> {}
        }
        if row == Val((construct, span, reason)) -> &rows.push(lower_erasure("{module}::{construct}", span, reason))
    }
}
