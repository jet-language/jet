// Rust: crates/jet-codegen/src/Codegen/TIR/mod.rs:933
fn compile_codec_migrations(cx: Cx, module: String, items: [Item]) -> [String:SchemaMigrationPlan]? Never! {
    plans := [String:SchemaMigrationPlan]{}
    loop item in items {
        if item != .Struct(_) -> next
        if item == .Struct(definition) {
            blocks :: jet_codegen.Codegen.Items.migration_blocks(cx, definition) ?? next
            canonical :: canonical_migration_shape(module, definition, blocks) ?? panic("sema-checked struct must have canonical migration shape facts")
            steps := [SchemaMigrationStep]{}
            loop (block_index, block) in blocks.enumerate() {
                ops := [SchemaMigrationOp]{}
                loop op in block.ops {
                    if op == {
                        .Rename(from, to, _) -> &ops.push(SchemaMigrationOp.Rename(canonical.json_key(from), canonical.json_key(to)))
                        .Remove(field, _) -> &ops.push(SchemaMigrationOp.Remove(canonical.json_key(field)))
                        .Add(field, ty, default_fn, _) -> {
                            default :: default_fn ?? return None
                            &ops.push(SchemaMigrationOp.Add(canonical.json_key(field), ty.name(), default))
                        }
                        .Change(field, from_ty, to_ty, conv_fn, _) -> {
                            converter :: conv_fn ?? return None
                            &ops.push(SchemaMigrationOp.Change(canonical.json_key(field), from_ty.name(), to_ty.name(), converter))
                        }
                    }
                }
                &steps.push(SchemaMigrationStep.new(migration_shape_name(block_index), migration_shape_name(block_index + 1), ^ops))
            }
            plans[definition.name] = SchemaMigrationPlan.new(definition.name, canonical.historical, ^steps)
        }
    }
    Val(^plans)
}
// Rust: crates/jet-codegen/src/Codegen/TIR/mod.rs:997
fn register_union_type(ty: Type, &enum_variants: [String:[String]], &enum_variant_payload_types: [String:[Type]]) Never! {
    if ty == {
        .Union(members) -> {
            name :: union_enum_name(members)
            if !enum_variants.contains_key(name) {
                tags := [String]{}
                loop member in members -> &tags.push(union_member_tag(member))
                enum_variants[name] = ^tags
            }
            loop member in members {
                tag :: union_member_tag(member)
                key :: "{name}::{tag}"
                if !enum_variant_payload_types.contains_key(key) -> enum_variant_payload_types[key] = [member]
                register_union_type(member, &enum_variants, &enum_variant_payload_types)
            }
        }
        .List(inner) | .Shared(inner) | .Option(inner) | .Tagged(inner, _) | .FixedList(inner, _) -> register_union_type(inner, &enum_variants, &enum_variant_payload_types)
        .Map(key, value, _) | .Result(key, value) -> {
            register_union_type(key, &enum_variants, &enum_variant_payload_types)
            register_union_type(value, &enum_variants, &enum_variant_payload_types)
        }
        .Fn(params, ret, _) -> {
            loop param in params -> register_union_type(param, &enum_variants, &enum_variant_payload_types)
            if ret == Val(value) -> register_union_type(value, &enum_variants, &enum_variant_payload_types)
        }
        .Apply(_, args) -> loop arg in args -> register_union_type(arg, &enum_variants, &enum_variant_payload_types)
        .Tuple(fields) -> loop (_, field) in fields -> register_union_type(field, &enum_variants, &enum_variant_payload_types)
        else -> {}
    }
}
