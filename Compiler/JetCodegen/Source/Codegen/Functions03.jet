fn qualification_binders(owner: [TypeParam], method: Func?) -> [String] Never! {
    names := [String]{}
    loop param in owner -> &names.push(param.name)
    if method == Val(function) {
        loop param in function.type_params -> &names.push(param.name)
    }
    names
}
// Rust: crates/jet-codegen/src/Codegen/TIR/mod.rs:200
pub fn substitute_reflect_field_type(struct_type_params: [String:[String]], owner_ty: Type, declared: Type) -> Type Never! {
    if owner_ty == .Apply(name, args) {
        if struct_type_params.get(name) == Val(params) {
            substitutions := [String:Type]{}
            loop index in 0..params.len().min(args.len()) -> substitutions[params[index]] = args[index]
            return substitute_type(declared, substitutions)
        }
    }
    declared
}
// Rust: crates/jet-codegen/src/Codegen/TIR/mod.rs:226
pub fn mir_unary_op(op: UnOp) -> MirUnaryOp Never! {
    if op == { .Neg -> MirUnaryOp.Neg .Not -> MirUnaryOp.Not }
}
// Rust: crates/jet-codegen/src/Codegen/TIR/mod.rs:233
pub fn mir_binary_op(op: BinOp) -> MirBinaryOp Never! {
    if op == {
        .Add -> MirBinaryOp.Add .Sub -> MirBinaryOp.Sub .Mul -> MirBinaryOp.Mul
        .Div -> MirBinaryOp.Div .FloorDiv -> MirBinaryOp.FloorDiv
        .Mod -> MirBinaryOp.Mod .Rem -> MirBinaryOp.Rem .Pow -> MirBinaryOp.Pow
        .BitAnd -> MirBinaryOp.BitAnd .BitOr -> MirBinaryOp.BitOr
        .Eq -> MirBinaryOp.Eq .Ne -> MirBinaryOp.Ne .Lt -> MirBinaryOp.Lt
        .Gt -> MirBinaryOp.Gt .Le -> MirBinaryOp.Le .Ge -> MirBinaryOp.Ge
        .Compare -> MirBinaryOp.Compare .And -> MirBinaryOp.And .Or -> MirBinaryOp.Or
    }
}
// Rust: crates/jet-codegen/src/Codegen/TIR/mod.rs:270
fn compiler_owned_unit_enum(type_name: String) -> [String:(Span, VariantPayload)]? Never! {
    core_fact_kind_variants(type_name)
}
// Rust: crates/jet-codegen/src/Codegen/TIR/mod.rs:277
fn typed_unit_enum_value(expr: Expr) -> (String, String)? Never! {
    if expr == {
        .Paren(inner, _) | .Copy(inner, _) -> typed_unit_enum_value(inner)
        .EnumLit(type_name, variant, args, _) -> {
            if args.is_empty() -> Val((type_name, variant)) else -> None
        }
        .ComptimeName(_, Val(CtValue.Enum(type_name, variant, args)), _) -> {
            if args.is_empty() -> Val((type_name, variant)) else -> None
        }
        else -> None
    }
}
// Rust: crates/jet-codegen/src/Codegen/TIR/mod.rs:299
fn compiler_fact_enum_value(expr: Expr) -> (String, String)? Never! {
    if expr == {
        .Paren(inner, _) | .Copy(inner, _) -> compiler_fact_enum_value(inner)
        .ComptimeName(_, Val(CtValue.Enum(type_name, variant, args)), _) -> {
            if args.is_empty() -> Val((type_name, variant)) else -> None
        }
        else -> None
    }
}
// Rust: crates/jet-codegen/src/Codegen/TIR/mod.rs:318
pub fn fold_typed_fact_enum_equality(op: BinOp, lhs: Expr, rhs: Expr) -> Bool? Never! {
    if op != BinOp.Eq && op != BinOp.Ne -> return None
    if compiler_fact_enum_value(lhs) == None && compiler_fact_enum_value(rhs) == None -> return None
    (left_type, left_variant) :: typed_unit_enum_value(lhs) ?? return None
    (right_type, right_variant) :: typed_unit_enum_value(rhs) ?? return None
    if left_type != right_type -> return None
    variants :: compiler_owned_unit_enum(left_type) ?? return None
    if variants.get(left_variant) != Val((_, VariantPayload.Unit)) || variants.get(right_variant) != Val((_, VariantPayload.Unit)) -> return None
    Val(if op == BinOp.Eq -> left_variant == right_variant else -> left_variant != right_variant)
}
// Rust: crates/jet-codegen/src/Codegen/TIR/mod.rs:344
pub fn fold_typed_fact_enum_pattern(subject: Expr, pattern: Pattern) -> Bool? Never! {
    (type_name, variant) :: compiler_fact_enum_value(subject) ?? return None
    fold_fact_enum_variant_test(type_name, variant, pattern)
}
// Rust: crates/jet-codegen/src/Codegen/TIR/mod.rs:350
pub fn fold_fact_enum_variant_test(type_name: String, value_variant: String, pattern: Pattern) -> Bool? Never! {
    if pattern == .Variant(variant, bindings, _, _) {
        if !bindings.is_empty() -> return None
        variants :: compiler_owned_unit_enum(type_name) ?? return None
        if variants.get(value_variant) != Val((_, VariantPayload.Unit)) || variants.get(variant) != Val((_, VariantPayload.Unit)) -> return None
        return Val(value_variant == variant)
    }
    None
}
