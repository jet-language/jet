//RS /// Rust local place for JIT variable lookup (`__jet_x`).
//RS pub fn local_place(name: &str) -> String {
//RS     super::mangle(name)
//RS }
//RS 
//RS /// One local or parameter slot, carried as structure instead of a Rust place
//RS /// string. Every engine resolves a slot from these facts alone.
//RS ///
//RS /// `name` is the slot's identity: a user binding carries its Jet name, which Rust
//RS /// spells `__jet_<name>`; a compiler-generated temp (`generated`) is allocated
//RS /// through the reserved machine-name lane, which cannot collide with a mangled
//RS /// user name.
//RS /// `deref` records a by-reference slot, which Rust reads through `(*…)`.
//RS #[derive(Debug, Clone, PartialEq, Eq)]
//RS pub struct TLocal {
//RS     pub name: String,
//RS     pub generated: bool,
//RS     pub deref: bool,
//RS     /// Storage provenance for a place whose Rust shape does not carry it.
//RS     /// `&self` is represented as the bare Rust receiver so ordinary field and
//RS     /// method emission stays unchanged, but its address still belongs to the
//RS     /// caller's storage rather than this method's frame.
//RS     pub address_lifetime: Option<TAddressLifetime>,
//RS     /// D-PERSIST-DEVSTATE1=A: canonical module-store identity for a pinned
//RS     /// binding. Persistent slots do not enter the ordinary local variable map.
//RS     pub persist_key: Option<String>,
//RS     pub persist_ty: Option<Type>,
//RS     /// The Rust binding is mutable. This is a TIR ownership fact, not an
//RS     /// emitter-side repair for a generated spelling.
//RS     pub mutable: bool,
//RS     /// A dead `String.from_bytes(local)` binding may be fused into the following
//RS     /// map update. This carries the source place only when lowering proved the
//RS     /// binding is not read after that update; other engines ignore the AOT
//RS     /// representation hint and retain the ordinary binding semantics.
//RS     pub string_bytes_source: Option<Box<TLocal>>,
//RS     /// A lowering-proven interval for an Int local. `None` means the local may
//RS     /// carry a bigint value and consumers must retain checked arithmetic.
//RS     pub integer_bounds: Option<TIntegerBounds>,
//RS     /// The Rust binding is a vetted Prelude storage wrapper until sema-proved
//RS     /// initialization; ordinary TIR reads still have the declared Jet type.
//RS     pub uninit_scalar: bool,
//RS     pub uninit_fixed: bool,
//RS     /// The slot holds a non-escaping closure that borrows this frame (S47):
//RS     /// every use is a direct call, and the body's capture writes land in the
//RS     /// enclosing locals. Escaping closures never carry this; they own the
//RS     /// first-class carrier and their captures are private copies.
//RS     pub direct_closure: bool,
//RS }
//RS 
//RS impl TLocal {
//RS     /// A user binding, read by value.
//RS     pub fn user(name: impl Into<String>) -> TLocal {
//RS         TLocal {
//RS             name: name.into(),
//RS             generated: false,
//RS             deref: false,
//RS             address_lifetime: None,
//RS             persist_key: None,
//RS             persist_ty: None,
//RS             mutable: false,
