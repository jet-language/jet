// Rust: crates/jet-codegen/src/Codegen/TIR/mod.rs:827
pub fn canonical_identity(program: TirProgram) -> String Never! {
    functions := [String]{}
    loop function in program.funcs {
        &functions.push("{\"key\":\"" + json_escape(function.key) + "\",\"source_file\":\"" + json_escape(function.source_file) + "\",\"span\":{\"start\":{function.source_span.start},\"end\":{function.source_span.end}}}")
    }
