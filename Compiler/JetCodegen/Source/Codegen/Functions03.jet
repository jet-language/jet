// Rust: crates/jet-codegen/src/Codegen/TIR/mod.rs:1236
// TAddressLifetime uses the canonical jet_foundation.TIR enum, with all six arms.
// Rust: crates/jet-codegen/src/Codegen/TIR/mod.rs:1254
pub fn tir_address_lifetime(expr: TExpr) -> TAddressLifetime Never! {
    if expr.kind == {
        .Local(local) -> {
            if local.address_lifetime == Val(lifetime) -> return lifetime
            if local.is_persistent() -> TAddressLifetime.Static
            else if local.deref -> TAddressLifetime.Borrowed
            else -> TAddressLifetime.Stack
        }
        .ConstRef(_) -> TAddressLifetime.Static
        .Field(recv, _) -> tir_address_lifetime(recv)
        .Index(base, _, _, _, _, _) | .IndexRead(base, _, _, _, _) -> {
            if base.ty == {
                .FixedList(_, _) -> tir_address_lifetime(base)
                .List(_) -> TAddressLifetime.Heap
                else -> TAddressLifetime.Unknown
            }
        }
        .DistinctCtor(_, arg, _) -> tir_address_lifetime(arg)
        .PoolSlot(_, _, _, _, _, _) -> TAddressLifetime.Heap
        .HandleMethod(_, THandleOp.AllocAlloc, _) -> TAddressLifetime.Heap
        .Borrow(place, _) -> tir_address_lifetime(place)
        .RawOf(inner) -> tir_address_lifetime(inner)
        .Deref(_) | .PtrFromAddr(_, _) -> TAddressLifetime.Foreign
        else -> TAddressLifetime.Unknown
    }
}
