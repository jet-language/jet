//RS pub struct JitSpawnCapture {
//RS     /// Local name used by the lowered spawn body.
//RS     pub name: String,
//RS     /// Source local read at the spawn site.
//RS     pub source: String,
//RS     pub ty: Type,
//RS     pub clone_at_spawn: bool,
//RS     /// D-CONC-FREEZE1=A: sema proved this capture is an immutable snapshot.
//RS     /// The JIT carries the fact; it does not re-run crossing policy.
//RS     pub frozen_at_spawn: bool,
//RS     /// D-MEM-COPYSEM1=A: a read-only view capture is copied into its owning
