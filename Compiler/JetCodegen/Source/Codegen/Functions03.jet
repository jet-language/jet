    fn walk_stmt(stmt: TStmt, &demands: [String:(Type, String, [Type])]) Never! {
        if stmt == {
            .ExprStmt(value, _) | .Return(Val(value), _) -> walk_expr(value, &demands)
            .Let(_, _, init, _, _, _) | .Assign(_, _, init, _, _, _) -> walk_expr(init, &demands)
            .RefutableBind(_, init, fallback, _) -> {
                walk_expr(init, &demands)
                loop row in fallback -> walk_stmt(row, &demands)
            }
            else -> {}
