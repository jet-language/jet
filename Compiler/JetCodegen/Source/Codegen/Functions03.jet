// Rust: crates/jet-codegen/src/Codegen/TIR/mod.rs:1587
fn lower_demanded_generic_methods(items: [Item], cx: Cx, &funcs: [TFunc]) LowerError! {
    pending := take(&cx.jit_method_calls.borrow_mut()) // GATE #4494 retained RefCell borrow.
    collect_serde_codec_demands(funcs, &pending)
    processed := [String:Bool]{}
    // GATE #4494: ordered-map pop_first retains Rust's logarithmic frontier updates.
    loop pending.pop_first() == Val((key, (owner_ty, method_name, method_type_args))) {
            if processed.contains_key(key) -> next
            processed[key] = true
            if generic_depth_exceeded(owner_ty) == Val(chain) -> fail LowerError.new(Span{start: 0, end: 0}, "E0909: generic instantiation goes too deep; simplify the types involved: {chain}")
            name := ""
            owner_args := [Type]{}
            if owner_ty == {
                .Apply(owner, args) -> { name = owner; owner_args = args }
                .Named(owner) -> name = owner
                else -> next
            }
            params := [TypeParam]?{None}
            loop item in items {
                if item == {
                    .Struct(definition) | .Enum(definition) -> { if definition.name == name -> params = Val(definition.type_params) }
                    .Distinct(definition) -> { if definition.name == name -> params = Val([]) }
                    else -> {}
                }
                if params != None -> break
            }
            owner_params :: params ?? next
            owner_subst := [String:Type]{}
            loop index in 0..owner_params.len().min(owner_args.len()) -> owner_subst[owner_params[index].name] = owner_args[index]
            loop item in items {
                candidate := (Func, String?, Bool)?{None}
                if item == {
                    .Struct(definition) | .Enum(definition) -> {
                        if definition.name != name -> next
                        loop method in definition.methods {
                            if method.name == method_name { candidate = Val((method, None, false)); break }
                        }
                    }
                    .Impl(implementation) -> {
                        if implementation.type_name != name -> next
                        if implementation.trait_name == Val(trait_name) && trait_name != ENCODE && trait_name != DECODE && trait_name != CHECKED_TEXT -> next
                        loop method in implementation.methods {
                            if method.name == method_name {
                                candidate = Val((method, implementation.trait_name, implementation.trait_name != None && implementation.is_generated_serde))
                                break
                            }
                        }
                    }
                    else -> next
                }
                (method, trait_name, generated_serde) :: candidate ?? next
                subst := owner_subst.clone()
                owner_binds_method_params := (trait_name == Val(ENCODE) || trait_name == Val(DECODE)) && !owner_subst.is_empty()
                loop param in method.type_params {
                    if !owner_subst.contains_key(param.name) -> owner_binds_method_params = false
                }
                if owner_binds_method_params {
                    if !method_type_args.is_empty() -> next
                } else if !method_type_args.is_empty() {
                    if method_type_args.len() != method.type_params.len() -> next
                    loop index in 0..method.type_params.len() -> subst[method.type_params[index].name] = method_type_args[index]
                } else if !method.type_params.is_empty() -> next
                specialized := specialize_function_types(method, subst)
                residual := [String:Bool]{}
                loop param in specialized.type_params -> residual[param.name] = true
                &specialized.type_params.clear()
                previous_type_params :: cx.current_type_params.borrow().clone()
                method_params := previous_type_params.clone()
                loop param in residual.keys() -> method_params[param] = true
                _ :: cx.current_type_params.replace(^method_params)
                static_checked_text := trait_name == Val(CHECKED_TEXT)
                loop param in specialized.params {
                    if param.name == Syntax.KW_SELF -> static_checked_text = false
                }
                lowered := if trait_name == Val(owner_trait) {
                    if (owner_trait == ENCODE && owner_ty == .Apply(_, _)) || static_checked_text -> lower_method_for_owner(specialized, name, owner_ty, cx, generated_serde && specialized.compiler_generated)
                    else -> lower_trait_method(specialized, name, cx, owner_trait, generated_serde && specialized.compiler_generated, None)
                } else -> lower_method_for_owner(specialized, name, owner_ty, cx, false)
                _ :: cx.current_type_params.replace(previous_type_params)
