//RS /// Why a checked construct is absent from executable TIR.
//RS #[derive(Clone, Copy, Debug, PartialEq, Eq)]
//RS pub enum TirErasureReason {
//RS     CompileTimeOnly,
//RS     Disabled,
//RS     ExpandedBeforeLowering,
//RS     SemanticIndexOnly,
//RS }
//RS 
//RS /// Explicit, typed erasure row.  Compile-time constructs never disappear
//RS /// silently from the total checked program.
//RS #[derive(Clone, Debug)]
//RS pub struct TirErasure {
