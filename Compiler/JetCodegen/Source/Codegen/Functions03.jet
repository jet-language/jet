fn payload_types_for_variant(payload: VariantPayload) -> [Type] Never! {
    if payload == {
        .Unit -> []
        .Single(ty, _) -> [ty]
        .Named(fields) -> {
            types := [Type]{}
            loop field in fields -> &types.push(field.ty)
            types
        }
    }
}
// Rust: crates/jet-codegen/src/Codegen/TIR/mod.rs:884
fn register_enum_variants(enum_name: String, variants: [Variant], &enum_variants: [String:[String]], &enum_variant_payload_types: [String:[Type]]) Never! {
    names := [String]{}
    loop variant in variants -> &names.push(mangle_path(variant.name))
    enum_variants[enum_name] = ^names
    loop variant in variants {
        pattern :: mangle_path(enum_name) + "::" + mangle_path(variant.name)
        enum_variant_payload_types[pattern] = payload_types_for_variant(variant.payload)
    }
}
