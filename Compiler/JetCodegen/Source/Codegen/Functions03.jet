//RS /// Storage provenance for an address-producing TIR expression. This is a
//RS /// lowering fact, not a second address-admission policy: sema still decides
//RS /// which source forms are legal, and each engine only marshals this fact.
//RS #[derive(Clone, Copy, Debug, PartialEq, Eq)]
//RS pub enum TAddressLifetime {
//RS     /// A value in the current Jet function/lambda/task frame.
//RS     Stack,
//RS     /// Storage owned by a Jet allocator or collection buffer.
//RS     Heap,
//RS     /// A persistent/static slot whose lifetime is not the current frame.
//RS     Static,
//RS     /// A by-reference slot owned by an enclosing caller or boundary.
//RS     Borrowed,
//RS     /// An address whose owner is outside Jet's allocation ledger.
//RS     Foreign,
//RS     /// Lowering cannot prove a more precise owner.
//RS     Unknown,
//RS }
//RS 
//RS /// Classify the storage reached by an address-producing TIR expression.
//RS /// Unknown and borrowed forms retain the established unowned registration
//RS /// path; only a proven current-frame place receives an expiring sentry token.
//RS pub fn tir_address_lifetime(expr: &TExpr) -> TAddressLifetime {
//RS     match &expr.kind {
//RS         TExprKind::Local(local) => local.address_lifetime.unwrap_or_else(|| {
//RS             if local.is_persistent() {
//RS                 TAddressLifetime::Static
//RS             } else if local.deref {
//RS                 TAddressLifetime::Borrowed
//RS             } else {
//RS                 TAddressLifetime::Stack
//RS             }
//RS         }),
//RS         TExprKind::ConstRef(_) => TAddressLifetime::Static,
//RS         TExprKind::Field { recv, .. } => tir_address_lifetime(recv),
//RS         TExprKind::Index { base, .. } => match &base.ty {
//RS             Type::FixedList { .. } => tir_address_lifetime(base),
//RS             Type::List(_) => TAddressLifetime::Heap,
//RS             _ => TAddressLifetime::Unknown,
//RS         },
//RS         // Distinct values are transparent to the resident raw-place lowering:
//RS         // it takes the address of the same local slot after the nominal wrapper
//RS         // is erased. Preserve that storage fact here so the JIT admission gate
//RS         // and every emitter choose the same frame token.
//RS         TExprKind::DistinctCtor { arg, .. } => tir_address_lifetime(arg),
//RS         TExprKind::PoolSlot { .. } => TAddressLifetime::Heap,
//RS         TExprKind::HandleMethod {
//RS             op: THandleOp::AllocAlloc,
//RS             ..
//RS         } => TAddressLifetime::Heap,
//RS         TExprKind::Borrow { place, .. } => tir_address_lifetime(place),
//RS         TExprKind::RawOf(inner) => tir_address_lifetime(inner),
//RS         TExprKind::Deref(_) | TExprKind::PtrFromAddr { .. } => TAddressLifetime::Foreign,
//RS         _ => TAddressLifetime::Unknown,
//RS     }
//RS }
