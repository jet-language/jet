// Core source-body reachability (Rust Codegen/TIR/mod.rs
// `reachable_core_source_callables`, `should_lower_imported_core_body`).
use jet_foundation.[
    CompilerThreads,
    TExpr,
    TFunc,
    TFuncKind,
    TStmt,
    TLambda,
    compiler_take_rows,
    compiler_threads_admit,
    compiler_threads_failure_text,
    compiler_threads_partition,
    compiler_transfer_rows,
    tir_each_expr_child,
    tir_each_stmt_child,
    TStrFormat,
    core_identity_in_module,
]
use jet_foundation.[Span, TExprKind, TStrPart, Type]

fn jet_codegen_core_reach_is_top_level(kind: TFuncKind) -> Bool Never! {
    if kind == {
        .TopLevel -> true
        else -> false
    }
}

// Source-owned selector policy. Both reachability and expression lowering
// use this map, so the exact helper emitted by a selector is rooted.
fn jet_codegen_string_format_member(ty: Type, format: TStrFormat) -> String? Never! {
    integer :: jet_codegen_string_format_integer(ty)
    if format == {
        .Display | .Debug -> None
        .Pretty -> Val("pretty")
        .Fixed(_) -> Val(if integer -> "fixed_int" else -> "decimal")
        .Grouped(_) -> Val(if integer -> "grouped_int_fixed" else -> "grouped")
        .Hex(_) -> Val(if integer -> "hex" else -> "hex_decimal")
        .Bin -> Val(if integer -> "bin" else -> "bin_decimal")
        .Oct -> Val(if integer -> "oct" else -> "oct_decimal")
        .Sci(_) -> Val("sci")
        .Percent(_) -> Val("percent")
        .Pad(_, _) -> Val("pad")
        .PadLeft(_, _) -> Val("pad_left")
        .Unit(_) -> Val("quantity")
    }
}

// Whether a checked source path names the Core file `relative` (`Core/...`).
// A Core unit outside the entry root keeps its canonical or `<corelib>/`
// prefixed path (`jet_driver_display_path`), so `relative` is its suffix.
fn jet_codegen_core_source_path(path: String, relative: String) -> Bool Never! {
    path == relative || path.ends_with("/{relative}")
}

fn jet_codegen_string_format_source(function: TFunc) -> Bool Never! {
    function.module_identity.starts_with("<corelib>/") && jet_codegen_core_source_path(function.source_file, "Core/Text/Fmt.jet") && jet_codegen_core_reach_is_top_level(function.kind)
}

fn jet_codegen_precise_source_family(name: String, owner: String, prefix: String) -> Bool Never! {
    if !name.starts_with(prefix) -> return false
    helper :: jet_codegen_precise_source_helper(owner, name.slice(prefix.len(), name.len())) ?? return false
    helper == name
}

// Rust `is_core_precise_source_target`: a precise operation (Int.abs and the
// Fraction, Decimal and Complex registry; Float has no source helper) lowers
// to its `Core/Math/Math.jet` helper by name (`jet_codegen_lower_precise_builtin`)
// from sites with no keyed call: registered `core.math.fraction`/`decimal`
// constructors, constants and synthesized operations. That closed registry is
// rooted, not every `__` helper in the file.
fn jet_codegen_precise_source_name(name: String) -> Bool Never! {
    if (jet_codegen_precise_source_helper("Int", "abs") ?? "") == name -> return true
    jet_codegen_precise_source_family(name, "Fraction", "__fraction_") || jet_codegen_precise_source_family(name, "Decimal", "__decimal_") || jet_codegen_precise_source_family(name, "Complex", "__complex_")
}

fn jet_codegen_precise_source_target(function: TFunc) -> Bool Never! {
    function.module_identity.starts_with("<corelib>/") && jet_codegen_core_source_path(function.source_file, "Core/Math/Math.jet") && jet_codegen_core_reach_is_top_level(function.kind) && jet_codegen_precise_source_name(function.name)
}

fn jet_codegen_core_reach_add(keys: &[String], key: String) Never! {
    if key != "" -> &keys.push(key)
}

fn jet_codegen_core_reach_lambda_keys(value: TLambda, functions: [TFunc], keys: &[String]) Never! {
    if value.executable == {
        .Block(body) -> jet_codegen_core_reach_stmt_keys(body, functions, &keys)
        else -> {}
    }
}

// Implicit process loops have no keyed TExpr.Call. Resolve the authored Core
// helper from the checked function inventory, then retain its dependencies
// with the ordinary reachability walk. Both streams share cursor mechanics.
fn jet_codegen_core_reach_one_stmt_keys(statement: TStmt, functions: [TFunc], keys: &[String]) Never! {
        if statement == {
            .ForIn(_, _, _, _, collection, _, method, _, _, _, body, _) -> {
                if method == .Val(kind) && kind == .LinesProcessStream {
                    // Each nominal arm owns its binder; boolean alternatives
                    // do not introduce one shared value into their result.
                    name :: if collection.ty == {
                        .Named(value) -> value
                        .Apply(value, _) -> value
                        else -> ""
                    }
                    member :: if name == "ProcessStdoutStream" || name.ends_with("::ProcessStdoutStream") -> "__stdout_next_line" else if name == "ProcessStderrStream" || name.ends_with("::ProcessStderrStream") -> "__stderr_next_line" else -> ""
                    loop helper in functions {
                        if member != "" && helper.name == member && core_identity_in_module(helper.module_identity, "core.process") -> jet_codegen_core_reach_add(&keys, helper.key)
                    }
                }
                jet_codegen_core_reach_stmt_keys(body, functions, &keys)
            }
            .ContractScope(_, body, _, _, _) | .TaskGroup(_, _, body, _) | .Loop(_, body, _) | .While(_, _, body, _) | .ForRange(_, _, _, _, _, _, body, _, _) | .Range(_, _, _, _, _, _, _, _, body, _) -> jet_codegen_core_reach_stmt_keys(body, functions, &keys)
            .Inline(body, _) | .DebugOnly(body, _) | .Impure(body, _) | .Region(body, _) | .Live(body, _) | .Shield(body, _) | .UnsafeBlock(_, body, _) | .SentryPolicy(_, body, _) | .Layout(_, _, body, _) | .ContextBlock(_, body, _) | .ScopeMember(_, body, _) | .Transact(_, _, _, body, _) | .Unsafe(_, body) -> jet_codegen_core_reach_stmt_keys(body, functions, &keys)
            .RefutableBind(_, _, body, _) -> jet_codegen_core_reach_stmt_keys(body, functions, &keys)
            .If(_, then_body, else_body, _, _) -> {
                jet_codegen_core_reach_stmt_keys(then_body, functions, &keys)
                if else_body == .Val(body) -> jet_codegen_core_reach_stmt_keys(body, functions, &keys)
            }
            .CountedLoop(_, init, _, step, _, body, _) -> {
                jet_codegen_core_reach_one_stmt_keys(init, functions, &keys)
                if step == .Val(value) -> jet_codegen_core_reach_one_stmt_keys(value, functions, &keys)
                jet_codegen_core_reach_stmt_keys(body, functions, &keys)
            }
            .Match(_, arms, _, _) -> loop arm in arms -> jet_codegen_core_reach_stmt_keys(arm.body, functions, &keys)
            .EnumMatch(_, arms, else_body, _, _) -> {
                loop arm in arms -> jet_codegen_core_reach_stmt_keys(arm.body, functions, &keys)
                if else_body == .Val(body) -> jet_codegen_core_reach_stmt_keys(body, functions, &keys)
            }
            .MixedSwitch(_, _, arms, else_body, _) -> {
                loop arm in arms -> jet_codegen_core_reach_stmt_keys(arm.body, functions, &keys)
                if else_body == .Val(body) -> jet_codegen_core_reach_stmt_keys(body, functions, &keys)
            }
            .RangeSwitch(_, arms, body, _) -> {
                loop arm in arms -> jet_codegen_core_reach_stmt_keys(arm.body, functions, &keys)
                jet_codegen_core_reach_stmt_keys(body, functions, &keys)
            }
            .Reactive(value, _) -> jet_codegen_core_reach_lambda_keys(value, functions, &keys)
            .GCEdit(_, _, _, _, _, edited, _) -> jet_codegen_core_reach_one_stmt_keys(edited, functions, &keys)
            else -> {}
        }
}

fn jet_codegen_core_reach_stmt_keys(statements: [TStmt], functions: [TFunc], keys: &[String]) Never! {
    loop statement in statements -> jet_codegen_core_reach_one_stmt_keys(statement, functions, &keys)
}

// The function keys one checked expression names directly. Children are
// walked by the caller.
fn jet_codegen_core_reach_expr_keys(expression: TExpr, functions: [TFunc], keys: &[String], fmt_keys: [String:String]) Never! {
    if expression.kind == {
        .Call(callee, _, args) -> {
            jet_codegen_core_reach_add(&keys, callee.key)
            loop argument in args {
                loop item in argument.template_items -> jet_codegen_core_reach_add(&keys, item.key)
            }
        }
        .MethodCall(_, method, _, args) -> {
            jet_codegen_core_reach_add(&keys, method.symbol.key)
            loop argument in args {
                loop item in argument.template_items -> jet_codegen_core_reach_add(&keys, item.key)
            }
        }
        .StaticCall(_, _, method, _, args) -> {
            jet_codegen_core_reach_add(&keys, method.symbol.key)
            loop argument in args {
                loop item in argument.template_items -> jet_codegen_core_reach_add(&keys, item.key)
            }
        }
        .Index(_, _, _, _, checked_call, _) -> {
            if checked_call == Val(symbol) -> jet_codegen_core_reach_add(&keys, symbol.key)
        }
        .FnValue(kind) -> {
            if kind == .NamedFn(name, _) {
                if name == Val(key) -> jet_codegen_core_reach_add(&keys, key)
            }
        }
        // A function named as a value checks as a constant reference.
        .ConstRef(symbol) -> jet_codegen_core_reach_add(&keys, symbol.key)
        // Interpolation selectors call their source formatter by name
        // (`jet_codegen_lower_string_format_value`), with no keyed call.
        .StrLit(parts) -> {
            loop part in parts {
                if part == .Interpolation(value, format) {
                    member :: jet_codegen_string_format_member(value.ty, format) ?? next
                    key :: fmt_keys.get(member) ?? next
                    jet_codegen_core_reach_add(&keys, key)
                }
            }
        }
        .InlineBlock(body) -> jet_codegen_core_reach_stmt_keys(body, functions, &keys)
        .Lambda(value) -> jet_codegen_core_reach_lambda_keys(value, functions, &keys)
        .IfExpr(_, then_body, _, else_body, _) | .ResultHandler(_, _, then_body, _, _, else_body, _, _) -> {
            jet_codegen_core_reach_stmt_keys(then_body, functions, &keys)
            jet_codegen_core_reach_stmt_keys(else_body, functions, &keys)
        }
        .GlobalShared(initializer, _) -> jet_codegen_core_reach_add(&keys, initializer.key)
        else -> {}
    }
}

// Every function key one checked function body names, including its
// parameter defaults, which call sites lower from the callee.
fn jet_codegen_core_reach_function_keys(function: TFunc, functions: [TFunc], fmt_keys: [String:String]) -> [String] Never! {
    keys := [String]{}
    jet_codegen_core_reach_stmt_keys(function.body, functions, &keys)
    loop parameter in function.params {
        if parameter.default == Val(value) -> jet_codegen_core_reach_tree_keys(value, functions, &keys, fmt_keys)
    }
    loop statement in function.body -> jet_codegen_core_reach_statement_keys(statement, functions, &keys, fmt_keys)
    keys
}

// One statement's subtrees. Its own function so the visitor closure lends the
// `keys` write parameter: the stage-0 Rust tier then lends `functions` and
// `fmt_keys` to the closure instead of copying them per statement.
fn jet_codegen_core_reach_statement_keys(statement: TStmt, functions: [TFunc], keys: &[String], fmt_keys: [String:String]) Never! {
    tir_each_stmt_child(statement, (child: TExpr) -> jet_codegen_core_reach_tree_keys(child, functions, &keys, fmt_keys))
}

// The keys one checked expression and every expression below it name, read
// in place (tir_each_expr_child).
fn jet_codegen_core_reach_tree_keys(expression: TExpr, functions: [TFunc], keys: &[String], fmt_keys: [String:String]) Never! {
    jet_codegen_core_reach_expr_keys(expression, functions, &keys, fmt_keys)
    tir_each_expr_child(expression, (child: TExpr) -> jet_codegen_core_reach_tree_keys(child, functions, &keys, fmt_keys))
}

// The `Core/Math/Math.jet` helper one checked expression lowers to by name
// (`jet_codegen_lower_precise_builtin`): a precise operation, `Int.abs`, or a
// registered `core.math.fraction`/`decimal` constructor.
fn jet_codegen_precise_expr_helper(expression: TExpr) -> String? Never! {
    if expression.kind == {
        .PreciseBuiltin(owner, operation, _) -> jet_codegen_precise_source_helper(owner, operation)
        .MathBuiltin(owner, operation, _) -> if owner == "Int" -> jet_codegen_precise_source_helper(owner, operation) else -> None
        .CoreCall(record, _, _, _, _, _, _) -> {
            canonical :: jet_codegen_canonical_core_record(record)
            if canonical.module_name != "core.math" -> return None
            if canonical.member == "fraction" -> return jet_codegen_precise_source_helper("Fraction", "new")
            if canonical.member == "decimal" -> return jet_codegen_precise_source_helper("Decimal", "from_str")
            None
        }
        else -> None
    }
}

// The distinct precise source helpers a checked body and its root expressions
// lower to by name. A comptime closure holds only explicitly called functions,
// so it adds these (`jet_driver_comptime_function_closure`).
fn jet_codegen_precise_helper_names(roots: [TExpr], body: [TStmt]) -> [String] Never! {
    names := [String]{}
    loop root in roots -> jet_codegen_precise_tree_names(root, &names)
    loop statement in body {
        tir_each_stmt_child(statement, (child: TExpr) -> jet_codegen_precise_tree_names(child, &names))
    }
    names
}

// The precise helpers one checked expression and every expression below it
// lower to, each added once, read in place (tir_each_expr_child).
// Functions an expression tree names as values (`probe: pkg_lua_render_probe`), not
// calls: Sema records call facts only, so a compile-time body that stores a function
// value must queue it for lowering itself. Each key once, in tree order.
fn jet_codegen_function_value_keys(roots: [TExpr], body: [TStmt]) -> [String] Never! {
    keys := [String]{}
    loop root in roots -> jet_codegen_function_value_tree(root, &keys)
    loop statement in body {
        tir_each_stmt_child(statement, (child: TExpr) -> jet_codegen_function_value_tree(child, &keys))
    }
    keys
}

fn jet_codegen_function_value_tree(expression: TExpr, keys: &[String]) Never! {
    if expression.kind == .ConstRef(symbol) {
        if symbol.key.starts_with("function:") && !keys.contains(symbol.key) -> &keys.push(symbol.key)
    }
    tir_each_expr_child(expression, (child: TExpr) -> jet_codegen_function_value_tree(child, &keys))
}

fn jet_codegen_precise_tree_names(expression: TExpr, names: &[String]) Never! {
    helper :: jet_codegen_precise_expr_helper(expression)
    if helper == .Val(name) {
        if !names.contains(name) -> &names.push(name)
    }
    tir_each_expr_child(expression, (child: TExpr) -> jet_codegen_precise_tree_names(child, &names))
}

// Reachability precedes concrete instance lowering. A checked generic/operator
// target keeps its declaration, without stripping the owner's own arguments.
fn jet_codegen_core_reach_template_key(key: String) -> String Never! {
    bytes :: key.bytes()
    if bytes.len() == 0 || Int.from_u8(bytes[bytes.len() - 1]) != 62 -> return key.copy()
    depth := 0
    position := bytes.len() - 1
    loop position >= 0 {
        byte :: Int.from_u8(bytes[position])
        if byte == 62 -> depth += 1
        if byte == 60 {
            depth -= 1
            if depth == 0 -> return key.slice(0, position)
        }
        position -= 1
    }
    key.copy()
}

// Which checked functions to lower: one flag per row of `functions`, read in
// place (never copied). Only rows flagged in `candidates` take part: every
// candidate outside `core_module_identities` (user code) is a root, and a
// top-level Core source candidate, including a compiler-private part's
// receiver function, is kept only when a kept body names it. Authored Core
// methods stay rooted because Codegen resolves their implicit uses (`close`,
// `display`, index hooks, trait dispatch) by owner type rather than by a key
// in the caller's body. The closed precise-operation source registry
// (`jet_codegen_precise_source_target`) is rooted as in Rust. A
// compiler-generated Core method (`TFunc.synthetic`: a Prelude/Derives.jet
// `Equatable`/`Comparable` body) is not a root: as in
// Rust `reachable_core_source_callables`, it is kept only when a kept body
// names it (sema rewrites `==`/`<` on its owner into a keyed method call). An
// unreached derive then loses its impl row (Rust `lower_impl_rows`), so no
// impl is emitted for a runtime-backed Core carrier (`Cursor` -> `JetCursor`,
// `URL`/`MIME` -> `jet_std`).
//
// The roots' bodies, nearly every kept body, are read on the threads
// `threads` admits (jet_codegen_core_reach_root_targets); the rows they
// reach, and the rows those reach, are then read on the calling thread.
// Reachability is a closure, so the flags are the same for any thread
// count. `functions` leaves for the threads and comes back unchanged.
fn jet_codegen_reachable_core_rows(functions: &[TFunc], candidates: ^[Bool], core_module_identities: [String], threads: CompilerThreads) -> [Bool] {
    if core_module_identities.len() == 0 -> return candidates
    core_modules := [String:Bool]{}
    loop identity in core_module_identities -> core_modules[identity] = true
    by_key := [String:Int]{}
    reachable := [Bool]{}
    roots := [Int]{}
    weights := [Int]{}
    fmt_keys := [String:String]{}
    loop (index, function) in functions {
        if !candidates[index] {
            &reachable.push(false)
            next
        }
        _ := &by_key.add(function.key, index)
        if jet_codegen_string_format_source(function) -> fmt_keys[function.name] = function.key
        rooted :: !core_modules.has_key(function.module_identity) || (!jet_codegen_core_reach_is_top_level(function.kind) && !function.synthetic) || jet_codegen_precise_source_target(function)
        &reachable.push(rooted)
        if rooted {
            &roots.push(index)
            &weights.push(function.source_span.end - function.source_span.start)
        }
    }
    slot :: shared JetCodegenReachShared{functions: [[TFunc]]{compiler_take_rows<TFunc>(&functions)}, by_key: [[String:Int]]{^by_key}, fmt_keys: [[String:String]]{^fmt_keys}, roots: ^roots}
    pending := [Int]{}
    loop target in jet_codegen_core_reach_root_targets(slot, weights, threads) {
        if !reachable[target] {
            reachable[target] = true
            &pending.push(target)
        }
    }
    permit :: slot.guard_edit()
    loop pending.len() > 0 {
        caller :: &pending.pop() ?? { break }
        found := [Int]{}
        // Passed straight through: a local binding of the guarded rows would copy them.
        jet_codegen_core_reach_row_targets(permit.value.functions[0], permit.value.by_key[0], permit.value.fmt_keys[0], caller, &found)
        loop target in found {
            if !reachable[target] {
                reachable[target] = true
                &pending.push(target)
            }
        }
    }
    back := &permit.value.functions.pop() ?? panic("the checked functions left the reachability state")
    compiler_transfer_rows<TFunc>(&functions, &back)
    reachable
}

// What every reachability thread reads: the checked functions, their rows by
// key and the format helpers' keys, each the one row of its list, and the
// rooted rows.
struct JetCodegenReachShared {
    functions: [[TFunc]]
    by_key: [[String:Int]]
    fmt_keys: [[String:String]]
    roots: [Int]
}

// The rows one part of the roots names: its number and the rows.
struct JetCodegenReachPart {
    part: Int
    targets: [Int]
}

// Root source bytes per admitted reachability thread.
JET_CODEGEN_REACH_MIN_BYTES_PER_THREAD :: 65536
// Parts per admitted reachability thread: a thread that drew light bodies
// claims more while another reads a heavy one.
JET_CODEGEN_REACH_PARTS_PER_THREAD :: 4

// Every row a root's body names, the roots read on the threads `threads`
// admits for their source bytes (`weights`, one per root), in consecutive
// parts each thread claims until none is left, joined in part order.
fn jet_codegen_core_reach_root_targets(slot: Shared<JetCodegenReachShared>, weights: [Int], threads: CompilerThreads) -> [Int] {
    total := 0
    loop weight in weights -> total += weight
    workers :: compiler_threads_admit(threads, weights.len(), total, JET_CODEGEN_REACH_MIN_BYTES_PER_THREAD, 0, 0)
    count := workers * JET_CODEGEN_REACH_PARTS_PER_THREAD
    if count > weights.len() -> count = weights.len()
    if workers <= 1 || count <= 1 -> return jet_codegen_core_reach_part_targets(slot, 0, weights.len())
    bounds :: compiler_threads_partition(weights, count)
    queue :: shared JetCodegenPartQueue{next: 0}
    parts := [[Int]]{}
    loop _ in 0..<count -> &parts.push([Int]{})
    jet_codegen_core_reach_claimers(slot, bounds, queue, 0, workers, &parts)
    targets := [Int]{}
    loop part in 0..<count -> &targets.extend(compiler_take_rows<Int>(&parts[part]))
    targets
}

// Runs claiming threads `from..<workers`, one task each, and moves every
// part a thread returned into `parts`.
fn jet_codegen_core_reach_claimers(slot: Shared<JetCodegenReachShared>, bounds: [Int], queue: Shared<JetCodegenPartQueue>, from: Int, workers: Int, parts: &[[Int]]) {
    if from >= workers -> return
    task.group core_reach_threads {
        head :: task jet_codegen_core_reach_claimed(slot, bounds, queue)
        jet_codegen_core_reach_claimers(slot, bounds, queue, from + 1, workers, &parts)
        claimed := head.join() ?? panic(compiler_threads_failure_text(err))
        loop claimed.len() > 0 {
            done := &claimed.pop() ?? break
            parts[done.part] = compiler_take_rows<Int>(&done.targets)
        }
    }
}

// One thread: the rows named by the parts it claims until none is left.
fn jet_codegen_core_reach_claimed(slot: Shared<JetCodegenReachShared>, bounds: [Int], queue: Shared<JetCodegenPartQueue>) -> [JetCodegenReachPart] {
    claimed := [JetCodegenReachPart]{}
    loop {
        part :: jet_codegen_lower_claim(queue)
        if part >= bounds.len() - 1 -> break
        &claimed.push(JetCodegenReachPart{part: part, targets: jet_codegen_core_reach_part_targets(slot, bounds[part], bounds[part + 1])})
    }
    claimed
}

// The rows roots [first, last) name, in root order.
fn jet_codegen_core_reach_part_targets(slot: Shared<JetCodegenReachShared>, first: Int, last: Int) -> [Int] {
    inputs :: slot.guard_read()
    targets := [Int]{}
    loop position in first..<last {
        // Passed straight through: a local binding of the guarded rows would copy them.
        jet_codegen_core_reach_row_targets(inputs.value.functions[0], inputs.value.by_key[0], inputs.value.fmt_keys[0], inputs.value.roots[position], &targets)
    }
    targets
}

// The rows checked function row `row` names (resolved by key, or by its
// generic declaration's key), appended to `targets`.
fn jet_codegen_core_reach_row_targets(functions: [TFunc], by_key: [String:Int], fmt_keys: [String:String], row: Int, targets: &[Int]) Never! {
    loop key in jet_codegen_core_reach_function_keys(functions[row], functions, fmt_keys) {
        target :: by_key.get(key) ?? by_key.get(jet_codegen_core_reach_template_key(key)) ?? next
        &targets.push(target)
    }
}

#Test("Precise reachability roots the closed source registry at any Core path") {
    assert(jet_codegen_precise_source_name("abs"))
    assert(jet_codegen_precise_source_name("__fraction_new"))
    assert(jet_codegen_precise_source_name("__decimal_to_fraction"))
    assert(jet_codegen_precise_source_name("__complex_abs"))
    assert(!jet_codegen_precise_source_name("__decimal_normalized"))
    assert(!jet_codegen_precise_source_name("__fraction_"))
    assert(jet_codegen_core_source_path("Core/Math/Math.jet", "Core/Math/Math.jet"))
    assert(jet_codegen_core_source_path("/toolchain/Core/Math/Math.jet", "Core/Math/Math.jet"))
    assert(jet_codegen_core_source_path("<corelib>/Core/Text/Fmt.jet", "Core/Text/Fmt.jet"))
    assert(!jet_codegen_core_source_path("/toolchain/MyCore/text/fmt.jet", "Core/Text/Fmt.jet"))
}

#Test("A comptime closure finds the precise helper a nested literal lowers to") {
    spelling :: TExpr{ty: Type.String, kind: TExprKind.StrLit{parts: [TStrPart]{TStrPart.Literal{text: "9007199254740992.0"}}}, span: Span{start: 0, end: 1}}
    decimal :: TExpr{ty: Type.Named{name: "Decimal"}, kind: TExprKind.PreciseBuiltin{type_name: "Decimal", function: "from_str", args: [TExpr]{spelling}}, span: Span{start: 0, end: 1}}
    converted :: TExpr{ty: Type.Float, kind: TExprKind.PreciseBuiltin{type_name: "Decimal", function: "to_float", args: [TExpr]{decimal}}, span: Span{start: 0, end: 1}}
    names :: jet_codegen_precise_helper_names([TExpr]{converted}, [TStmt]{})
    assert_eq(names.len(), 2)
    assert(names.contains("__decimal_to_float"))
    assert(names.contains("__decimal_from_str"))
}
