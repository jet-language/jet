// Core source-body reachability (Rust Codegen/TIR/mod.rs
// `reachable_core_source_callables`, `should_lower_imported_core_body`).
use jet_foundation.[
    TExpr,
    TFunc,
    TFuncKind,
    tir_expr_children,
    tir_stmt_children,
]
use jet_foundation.[Span, TExprKind, Type]

fn jet_codegen_core_reach_is_top_level(kind: TFuncKind) -> Bool Never! {
    if kind == {
        .TopLevel -> true
        else -> false
    }
}

fn jet_codegen_core_reach_add(keys: &[String], key: String) Never! {
    if key != "" -> &keys.push(key)
}

// The function keys one checked expression names directly. Children are
// walked by the caller.
fn jet_codegen_core_reach_expr_keys(expression: TExpr, keys: &[String], precise_helpers: [String:String]) Never! {
    if expression.kind == {
        .Call(callee, _, args) -> {
            jet_codegen_core_reach_add(&keys, callee.key)
            loop argument in args {
                loop item in argument.template_items -> jet_codegen_core_reach_add(&keys, item.key)
            }
        }
        .ModuleCall(target, _, _, _, args) -> {
            jet_codegen_core_reach_add(&keys, target.key)
            loop argument in args {
                loop item in argument.template_items -> jet_codegen_core_reach_add(&keys, item.key)
            }
        }
        .MethodCall(_, method, _, args) -> {
            jet_codegen_core_reach_add(&keys, method.symbol.key)
            loop argument in args {
                loop item in argument.template_items -> jet_codegen_core_reach_add(&keys, item.key)
            }
        }
        .StaticCall(_, _, method, _, args) -> {
            jet_codegen_core_reach_add(&keys, method.symbol.key)
            loop argument in args {
                loop item in argument.template_items -> jet_codegen_core_reach_add(&keys, item.key)
            }
        }
        .PreciseBuiltin(owner, operation, _) -> {
            helper :: jet_codegen_precise_source_helper(owner, operation) ?? return
            if precise_helpers.get(helper) == .Val(key) -> jet_codegen_core_reach_add(&keys, key)
        }
        .Index(_, _, _, _, checked_call, _) -> {
            if checked_call == Val(symbol) -> jet_codegen_core_reach_add(&keys, symbol.key)
        }
        .FnValue(kind) -> {
            if kind == .NamedFn(name, _) {
                if name == Val(key) -> jet_codegen_core_reach_add(&keys, key)
            }
        }
        // A function named as a value checks as a constant reference.
        .ConstRef(symbol) -> jet_codegen_core_reach_add(&keys, symbol.key)
        else -> {}
    }
}

// Every function key one checked function body names, including its
// parameter defaults, which call sites lower from the callee.
fn jet_codegen_core_reach_function_keys(function: TFunc, precise_helpers: [String:String]) -> [String] Never! {
    keys := [String]{}
    pending := [TExpr]{}
    loop parameter in function.params {
        if parameter.default == Val(value) -> &pending.push(value)
    }
    loop statement in function.body {
        loop child in tir_stmt_children(statement) -> &pending.push(child)
    }
    loop pending.len() > 0 {
        expression :: &pending.pop() ?? return keys
        jet_codegen_core_reach_expr_keys(expression, &keys, precise_helpers)
        loop child in tir_expr_children(expression) -> &pending.push(child)
    }
    keys
}

// Which checked functions to lower: one flag per row of `functions`, read in
// place (never copied). Only rows flagged in `candidates` take part: every
// candidate outside `core_module_identities` (user code and compiler-private
// Core parts) is a root, and a top-level Core source candidate is kept only
// when a kept body names it. Authored Core methods stay rooted because Codegen
// resolves their implicit uses (`close`, `display`, index hooks, trait
// dispatch) by owner type rather than by a key in the caller's body. A
// compiler-generated Core method (`TFunc.synthetic`: a Prelude/Derives.jet
// `Equatable`/`Comparable` body) is not a root: as in
// Rust `reachable_core_source_callables`, it is kept only when a kept body
// names it (sema rewrites `==`/`<` on its owner into a keyed method call). An
// unreached derive then loses its impl row (Rust `lower_impl_rows`), so no
// impl is emitted for a runtime-backed Core carrier (`Cursor` -> `JetCursor`,
// `URL`/`MIME` -> `jet_std`).
pub fn jet_codegen_reachable_core_rows(functions: [TFunc], candidates: ^[Bool], core_module_identities: [String]) -> [Bool] {
    if core_module_identities.len() == 0 -> return candidates
    by_key := [String:Int]{}
    precise_helpers := [String:String]{}
    reachable := [Bool]{}
    pending := [Int]{}
    loop (index, function) in functions {
        if !candidates[index] {
            &reachable.push(false)
            next
        }
        _ := &by_key.add(function.key, index)
        if function.source_file == "Core/math/math.jet" && core_module_identities.contains(function.module_identity) && function.name.starts_with("__") {
            if precise_helpers.get(function.name) != None -> panic("ambiguous checked precise source helper")
            _ := &precise_helpers.add(function.name, function.key)
        }
        rooted :: !core_module_identities.contains(function.module_identity) || (!jet_codegen_core_reach_is_top_level(function.kind) && !function.synthetic)
        &reachable.push(rooted)
        if rooted -> &pending.push(index)
    }
    loop pending.len() > 0 {
        caller :: &pending.pop() ?? { break }
        loop key in jet_codegen_core_reach_function_keys(functions[caller], precise_helpers) {
            target :: by_key.get(key) ?? next
            if !reachable[target] {
                reachable[target] = true
                &pending.push(target)
            }
        }
    }
    reachable
}

#Test("Precise reachability keeps one checked operation key, not its family") {
    helpers := [String:String]{}
    _ := &helpers.add("__fraction_mul", "checked-math::__fraction_mul")
    _ := &helpers.add("__fraction_add", "checked-math::__fraction_add")
    _ := &helpers.add("__decimal_mul", "checked-math::__decimal_mul")
    expression :: TExpr{
        ty: Type.Named{name: "Fraction"},
        kind: TExprKind.PreciseBuiltin{type_name: "Fraction", function: "mul", args: [TExpr]{}},
        span: Span{start: 0, end: 1},
        integer_bounds: None,
        cost: None,
    }
    keys := [String]{}
    jet_codegen_core_reach_expr_keys(expression, &keys, helpers)
    assert_eq(keys.len(), 1)
    assert_eq(keys[0], "checked-math::__fraction_mul")
}
