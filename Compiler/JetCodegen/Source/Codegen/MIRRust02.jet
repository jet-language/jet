fn is_identifier_byte(byte: U8) -> Bool { byte.is_ascii_alphanumeric() || byte == b'_' }
// Rust: crates/jet-codegen/src/Codegen/MIRRust.rs:1930
fn strip_enclosing_parens(text: &String) -> &String {
    text := text
    while text.starts_with('(') && text.ends_with(')') {
        depth := 0
        encloses :: text.bytes().enumerate().all(fn((index, byte)) {
            if byte == b'(' { depth += 1 } else if byte == b')' { depth = depth.saturating_sub(1) }
            depth > 0 || index == text.len() - 1
        })
        if !encloses { break }
        text = &text[1..text.len() - 1]
    }
    text
}
