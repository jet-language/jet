        digits :: digits.strip_prefix('-').unwrap_or(digits)
        return !digits.is_empty() && digits.bytes().all(fn(byte) { byte.is_ascii_digit() })
    }
    text_opt :: expression.strip_prefix("{ let mut __jet_string = String::new(); __jet_string.push_str(\"").and_then(fn(rest) { rest.strip_suffix("\"); __jet_string }") })
