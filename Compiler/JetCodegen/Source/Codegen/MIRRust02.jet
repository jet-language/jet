// Localize only no-drop slots with one declaration and scope-contained uses.
fn localize_value_slots(out: &String, slots_start: USize, slots_end: USize, candidates: &[U64:String]) -> USize {
    if candidates.is_empty() { return slots_end }
    declared := [U64:USize].new()
    for_each_value_mention(&out[slots_start..slots_end], fn(_, _, id) {
        if candidates.contains_key(&id) { declared[id] = declared.get(&id).copied().unwrap_or(0) + 1 }
    })
    struct Mentions { first_line: USize, first_column: USize, on_first_line: USize, last_line: USize }
    body := &out[slots_end..] // #4303
    mentions := [U64:Mentions].new()
    for_each_value_mention(body, fn(line, column, id) {
        if !candidates.contains_key(&id) { return }
        entry :: mentions.entry(id).or_insert(Mentions { first_line: line, first_column: column, on_first_line: 0, last_line: line })
        if entry.first_line == line { entry.on_first_line += 1 }
        entry.last_line = line
    })
    lines :: body.split_inclusive('\n').collect()
    indents :: lines.iter().map(fn(line) {
        content := line.trim_start_matches(' ') // #4303
        if content.trim().is_empty() { USize.MAX } else { line.len() - content.len() }
    }).collect()
    scope_end := [lines.len(); lines.len()]
    open := [USize].new()
    for (index, indent) in indents.iter().enumerate() {
        while !open.is_empty() {
            top :: open.last().unwrap()
            if indent >= indents[top] { break }
            scope_end[top] = index
            _ :: open.pop()
        }
        open.push(index)
    }
    localized := [USize:U64].new()
    dropped := [U64].new().into_set()
    ids := candidates.keys().copied().collect()
    ids.sort()
    for id in ids {
        if declared.get(&id) != Some(&1) { continue }
        mention_opt :: mentions.get(&id)
        if mention_opt.is_none() { _ :: dropped.insert(id); continue }
        mention :: mention_opt.unwrap()
        line :: mention.first_line
        defines :: mention.on_first_line == 1 && mention.first_column == indents[line] && lines[line][indents[line]..].starts_with(&"__jet_v_{id} = Some(")
        if defines && mention.last_line < scope_end[line] { localized.insert(line, id); _ :: dropped.insert(id) }
    }
    if dropped.is_empty() { return slots_end }
    rebuilt := String.with_capacity(out.len() - slots_start)
    for line in out[slots_start..slots_end].split_inclusive('\n') {
        declared_id :: line.strip_prefix("    let mut __jet_v_").and_then(fn(rest) { rest.split_once(':') }).and_then(fn((id, _)) { id.parse[U64]().ok() })
        if declared_id.is_some_and(fn(id) { dropped.contains(&id) }) { continue }
        rebuilt.push_str(line)
    }
    declarations_end :: slots_start + rebuilt.len()
    for (index, line) in lines.iter().enumerate() {
        if localized.get(&index) == {
            .Some(id) -> {
                indent :: indents[index]
                slot :: "__jet_v_{id} = "
                rebuilt.push_str(&line[..indent])
                rebuilt.push_str(&"let mut __jet_v_{id}: Option<{candidates[id]}> = ")
                rebuilt.push_str(&line[indent + slot.len()..])
            }
            .None -> rebuilt.push_str(line)
        }
    }
    out.truncate(slots_start)
    out.push_str(&rebuilt)
    declarations_end
}
