                        continue
                    }
                } else if byte == b'\'' {
                    if bytes.get(index + 1) == Some(&b'\\') {
                        close :: text[index + 3..].find('\'').map_or(bytes.len(), fn(offset) { index + 3 + offset + 1 })
                        out.push_str(&text[index..close])
                        index = close
                        continue
                    }
                    width :: text[index + 1..].chars().next().map_or(0, fn(ch) { ch.len_utf8() })
                    if width > 0 && bytes.get(index + 1 + width) == Some(&b'\'') {
                        out.push_str(&text[index..index + 2 + width])
                        index += 2 + width
                        continue
                    }
                    label :: LABELS.iter().enumerate().find_map(fn((kind, (prefix, short))) {
