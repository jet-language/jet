//RS /// A folded list constant whose rows exceed this many bytes of Rust is built
//RS /// by row-chunk helpers.
//RS const CACHED_CONSTANT_BYTES: usize = 16 * 1024;
//RS /// Upper bound on the rows one cached-constant chunk helper pushes.
//RS const CONSTANT_CHUNK_BYTES: usize = 64 * 1024;
//RS 
//RS /// The initializer of a large folded list constant: row-chunk helpers of at
//RS /// most `CONSTANT_CHUNK_BYTES` each fill the rows, so no emitted function
//RS /// holds the whole table. The helpers are written to `out`.
//RS fn emit_list_constant_chunks(out: &mut String, name: &str, ty: &str, rows: &[String]) -> String {
//RS     let mut chunks: Vec<&[String]> = Vec::new();
//RS     let mut start = 0;
