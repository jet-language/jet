// Rust: crates/jet-codegen/src/Codegen/MIRRust.rs:2707
const CACHED_CONSTANT_BYTES: USize = 16 * 1024
// Rust: crates/jet-codegen/src/Codegen/MIRRust.rs:2709
const CONSTANT_CHUNK_BYTES: USize = 64 * 1024
// Rust: crates/jet-codegen/src/Codegen/MIRRust.rs:2714
fn emit_list_constant_chunks(out: &String, name: &String, ty: &String, rows: &[String]) -> String {
    chunks := [&[String]].new()
    start := 0
    bytes := 0
    for (index, row) in rows.iter().enumerate() {
        if index > start && bytes + row.len() > CONSTANT_CHUNK_BYTES {
            chunks.push(&rows[start..index])
            start = index
            bytes = 0
        }
        bytes += row.len()
    }
    chunks.push(&rows[start..])
    for (index, chunk) in chunks.iter().enumerate() {
        out.push_str(&"fn {name}_rows_{index}(rows: &mut {ty}) {{\n")
        for row in chunk { out.push_str(&"    rows.push({row});\n") }
        out.push_str("}\n\n")
    }
    init := "{{\n        let mut rows: {ty} = Vec::with_capacity({rows.len()});\n"
    for index in 0..chunks.len() { init.push_str(&"        {name}_rows_{index}(&mut rows);\n") }
    init.push_str("        rows\n    }")
    init
}
// Rust: crates/jet-codegen/src/Codegen/MIRRust.rs:2746
fn emit_shared_constant(out: &String, root: &String, visibility: &String, name: &String, ty: &String, init: &String) -> {
    out.push_str(&"thread_local! {{\n    static {name}_SHARED: std::rc::Rc<{ty}> = std::rc::Rc::new({init});\n}}\n\n")
    out.push_str(&"#[inline]\n{visibility}fn {name}() -> {ty} {{ {name}_SHARED.with(|value| (**value).clone()) }}\n\n")
    out.push_str(&"#[inline]\n{visibility}fn {name}_shared() -> {root}JetSharedSlot<{ty}> {{ {name}_SHARED.with(|value| {root}JetSharedSlot::new(std::rc::Rc::clone(value))) }}\n\n")
}
