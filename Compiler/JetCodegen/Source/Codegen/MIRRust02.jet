// Compact names in code only; preserve literal/comment bytes and UTF-8 widths.
fn compact_function_text(out: &String, start: USize) -> {
    enum Lex { Code, Text, Raw(USize), Block }
    const SLOTS: [(String, String)] = [("__jet_v_", "_v"), ("__jet_l_", "_l"), ("__jet_pm_", "_p")]
    const LABELS: [(String, String)] = [("'jet_block_", "'b"), ("'jet_loop_", "'c")]
    text :: out.split_off(start)
    bytes :: text.as_bytes()
    names := [[&String:USize].new(); 5]
    state := Lex.Code
    index := 0
    line_start := true
    digits_at :: fn(at: USize) { bytes[at..].iter().take_while(fn(byte) { byte.is_ascii_digit() }).count() }
    while index < bytes.len() {
        if line_start && state == Lex.Code {
            spaces :: bytes[index..].iter().take_while(fn(byte) { byte == b' ' }).count()
            out.extend(std.iter.repeat_n(' ', (spaces / 4).min(8)))
            index += spaces
            line_start = false
            continue
        }
        line_start = false
        byte :: bytes[index]
        previous :: index.checked_sub(1).map(fn(at) { bytes[at] })
        if state == {
            .Text -> {
                if byte == b'\\' && index + 1 < bytes.len() {
                    width :: 1 + text[index + 1..].chars().next().map_or(0, fn(ch) { ch.len_utf8() })
                    out.push_str(&text[index..index + width])
                    line_start = bytes[index + 1] == b'\n'
                    index += width
                    continue
