//RS     boxed: bool,
//RS     nested: Option<Box<PartialMoveNode>>,
//RS }
//RS 
//RS // Per-function ownership storage only: the source record and its ABI stay
//RS // unchanged. Either `slot` owns the whole value or its field slots own the
//RS // initialized remainder, never both. Nested nodes obey the same invariant.
//RS struct PartialMoveNode {
//RS     slot: String,
//RS     owner: MirTypeId,
//RS     boxed: bool,
//RS     fields: Vec<PartialMoveField>,
//RS }
//RS 
//RS struct PartialMoveRoot {
//RS     base: MirPlaceBase,
//RS     node: PartialMoveNode,
//RS }
//RS 
//RS /// Per-function move facts from the canonical MIR (D-MEM-COPYSEM1).
//RS #[derive(Default)]
//RS struct MoveFacts {
//RS     /// SSA values read exactly once, in their defining block: that one
//RS     /// by-value read may take the value instead of cloning it.
//RS     single_use: BTreeSet<MirValueId>,
//RS     /// Enum subjects that a `Move` hands to the payload bindings of one
//RS     /// block: subject -> (payload index, payload result) in block order.
//RS     payload_groups: BTreeMap<MirValueId, Vec<(usize, MirValueId)>>,
//RS     /// Payload result -> its group's subject.
//RS     payload_subjects: BTreeMap<MirValueId, MirValueId>,
//RS }
//RS 
//RS /// #4318: pattern binding locals stored as a shared reference to the payload
//RS /// they bind (`Option<&T>`) instead of a copy of it (`plan_ref_bindings`).
//RS #[derive(Default)]
//RS struct RefBindings {
//RS     locals: BTreeSet<MirLocalId>,
//RS     /// Payload reads whose only use binds one of `locals`: that write
//RS     /// borrows the payload in place and the read has no slot of its own.
//RS     payloads: BTreeSet<MirValueId>,
//RS     /// Read loops that walk their list in place (`borrowed_loop_candidates`):
//RS     /// cursor -> the stable list place it walks. Every element the cursor
//RS     /// yields binds one of `locals`.
//RS     cursors: BTreeMap<MirValueId, MirPlaceId>,
//RS     /// The collection values those cursors walk; they have no slot.
//RS     collections: BTreeSet<MirValueId>,
//RS }
//RS 
//RS struct RustEmitter<'a> {
//RS     program: &'a MirProgram,
//RS     config: &'a MirRustConfig<'a>,
//RS     artifact: &'a MirArtifactPlan,
//RS     artifact_identity: MirArtifactIdentity,
//RS     functions: BTreeMap<MirFunctionId, String>,
//RS     test_functions: BTreeSet<MirFunctionId>,
//RS     foreigns: BTreeMap<MirForeignId, String>,
//RS     types: BTreeMap<MirTypeId, String>,
//RS     type_instances: BTreeMap<MirTypeId, &'a MirType>,
//RS     types_by_name: BTreeMap<String, String>,
//RS     /// First `program.types` row (program order) for each type ID, key and
//RS     /// name, so type-definition lookups keep first-match order without a
//RS     /// linear scan per query.
//RS     type_def_by_id: BTreeMap<MirTypeId, usize>,
//RS     type_def_by_key: BTreeMap<&'a str, usize>,
//RS     type_def_by_name: BTreeMap<&'a str, usize>,
//RS     /// Source-written (not compiler-generated) trait impls by trait name, in
//RS     /// program order.
//RS     user_impls_by_trait: BTreeMap<&'a str, Vec<&'a MirImplDef>>,
//RS     traits: BTreeMap<MirTraitId, String>,
//RS     traits_by_name: BTreeMap<String, String>,
