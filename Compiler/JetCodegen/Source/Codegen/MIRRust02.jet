                if byte == b'"' { state = Lex.Code }
            }
            .Raw(hashes) -> {
                if byte == b'"' && bytes[index + 1..].iter().take(hashes).filter(fn(byte) { byte == b'#' }).count() == hashes {
                    out.push_str(&text[index..index + 1 + hashes])
                    index += 1 + hashes
                    state = Lex.Code
                    continue
                }
            }
            .Block -> {
                if text[index..].starts_with("*/") {
                    out.push_str("*/")
                    index += 2
                    state = Lex.Code
                    continue
                }
            }
            .Code -> {
                joined :: previous.is_some_and(is_identifier_byte)
                if text[index..].starts_with("//") {
                    end :: text[index..].find('\n').map_or(bytes.len(), fn(offset) { index + offset })
                    out.push_str(&text[index..end])
                    index = end
                    continue
                }
                if text[index..].starts_with("/*") {
                    out.push_str("/*")
                    index += 2
                    state = Lex.Block
