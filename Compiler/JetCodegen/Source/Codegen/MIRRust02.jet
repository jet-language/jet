//RS     for (index, row) in rows.iter().enumerate() {
//RS         if index > start && bytes + row.len() > CONSTANT_CHUNK_BYTES {
//RS             chunks.push(&rows[start..index]);
//RS             start = index;
//RS             bytes = 0;
//RS         }
//RS         bytes += row.len();
//RS     }
//RS     chunks.push(&rows[start..]);
//RS     for (index, chunk) in chunks.iter().enumerate() {
//RS         let _ = writeln!(out, "fn {name}_rows_{index}(rows: &mut {ty}) {{");
//RS         for row in *chunk {
//RS             let _ = writeln!(out, "    rows.push({row});");
//RS         }
//RS         let _ = writeln!(out, "}}\n");
//RS     }
//RS     let mut init = format!("{{\n        let mut rows: {ty} = Vec::with_capacity({});\n", rows.len());
//RS     for index in 0..chunks.len() {
//RS         let _ = writeln!(init, "        {name}_rows_{index}(&mut rows);");
//RS     }
//RS     init.push_str("        rows\n    }");
//RS     init
//RS }
