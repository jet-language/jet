                        if previous.is_some() && previous.unwrap() != def.id { panic("MIR method {function:?} is listed by type IDs {previous.unwrap():?} and {def.id:?}") }
                    }
                }
                _ -> {}
            }
        }
        for ty in &program.type_instances {
            if ty.kind() == {
                .Tuple(declared) -> {
                    identity :: ty.identity_key()
                    for (index, (name, _)) in declared.iter().enumerate() {
                        id :: MirFieldId(stable_id("mir-field", &"{identity}::{name}"))
                        fields.insert(id, index.to_string())
                    }
                }
                _ -> {}
            }
        }
        for handle in &program.handles {
            if handle.ty.kind() == {
                .Apply { name, .. } -> {
                    symbol :: mangle_path(&name.name)
                    _ :: types_by_name.entry(name.name.clone()).or_insert_with(fn() { symbol.clone() })
                }
                _ -> {}
            }
        }
        user_impls_by_trait := [&String:[&MirImplDef]].new()
        for implementation in &program.impls {
            trait_ref :: implementation.trait_ref.as_ref().filter(fn(_) { !implementation.compiler_generated })
            if trait_ref.is_some() { user_impls_by_trait.entry(trait_ref.unwrap().name.as_str()).or_default().push(implementation) }
            owner :: Self.type_identity_from_instances(&type_instances, &implementation.self_type)
            for function in &implementation.methods {
                previous :: method_owners.insert(function, owner)
                if previous.is_some() && previous.unwrap() != owner { panic("MIR method {function:?} is listed by type IDs {previous.unwrap():?} and {owner:?}") }
            }
        }
        traits := [MirTraitId:String].new()
        traits_by_name := [String:String].new()
        user_traits_by_name := [&String:String].new()
        for definition in &program.traits {
            compiler_owned :: codegen.TIR.tir_to_mir_types.is_compiler_owned_trait(&definition.name)
            symbol :: if compiler_owned { codegen.rust_trait_name(&definition.name) } else { mangle_path(&definition.key) }
            if !compiler_owned && !codegen.TIR.tir_to_mir_types.is_compiler_owned_trait(&definition.key) {
                user_traits_by_name.insert(definition.key.as_str(), symbol.clone())
                user_traits_by_name.insert(definition.name.as_str(), symbol.clone())
            }
            traits.insert(definition.id, symbol.clone())
            traits_by_name.insert(definition.key.clone(), symbol.clone())
            traits_by_name.insert(definition.name.clone(), symbol)
        }
        dyn_clone_traits := Set[String].new()
        for ty in &program.type_instances {
            mir_type_single_trait_objects(ty, fn(name) {
                symbol :: user_traits_by_name.get(name)
                if symbol.is_some() { _ :: dyn_clone_traits.insert(symbol.unwrap().clone()) }
            })
        }
        emitter := Self {
            program, config, artifact, artifact_identity, functions,
            test_functions: if artifact.mode == MirArtifactBuildMode.Coverage { program.tests.iter().map(fn(test) { test.function }).collect() } else { Set[MirFunctionId].new() },
            foreigns, types, type_instances, types_by_name, type_def_by_id, type_def_by_key, type_def_by_name,
            user_impls_by_trait, traits, traits_by_name, dyn_clone_traits, fields,
            history_capture_encoders: RefCell.new([String:String].new()),
            history_callable_arities: RefCell.new(Set[USize].new()),
            history_callable_modes: RefCell.new(Set[(USize, String)].new()),
            generic_scopes: RefCell.new([]), history_current_function: Cell.new(None),
            cfg_state: RefCell.new(None), history_runtime_metadata: OnceCell.new(),
            derive_capability_cache: RefCell.new([String:[MirTypeId:Bool]].new()),
            derive_capability_cycle_floor: Cell.new(USize.MAX), history_callback_lifetime: Cell.new("'static"),
            partial_moves: [MirFunctionId:[PartialMoveRoot]].new(),
            shared_capture_locals: [MirFunctionId:Set[MirLocalId]].new(),
            move_facts: [MirFunctionId:MoveFacts].new(), ref_bindings: RefCell.new([MirFunctionId:Rc[RefBindings]].new()),
            window_params: Self.collect_window_params(program),
            source_lines: program.source_files.iter().map(fn(source) {
                lines :: LineIndex.new(&source.source)
                (source.id, (source, lines))
            }).collect(),
            function_positions: [MirFunctionId:USize].new(),
            field_positions: [MirFieldId:USize].new(),
            function_indexes: RefCell.new([MirFunctionId:Rc[FunctionIndex]].new()),
            closure_parents: OnceCell.new()
        }
        // Rust: crates/jet-codegen/src/Codegen/MIRRust.rs:3601-3638
        // Continuation at the next source-slice owner completes the indexes/plans.
        RustEmitter.finish_new(&emitter)
        emitter
    }
}
