                        digits :: digits_at(index + prefix.len())
                        end :: index + prefix.len() + digits
                        if digits > 0 && !bytes.get(end).is_some_and(is_identifier_byte) { Some((kind + 3, short, index + prefix.len(), end)) } else { None }
                    })
                    if label.is_some() {
                        (kind, short, id_start, end) :: label.unwrap()
                        next :: names[kind].len()
                        number :: names[kind].entry(&text[id_start..end]).or_insert(next)
