fn carrier_trait_signatures(methods: &String) -> String {
    out := String.new()
    for line in methods.lines() {
        header_opt :: line.strip_suffix(" {")
        if header_opt.is_none() { continue }
        header :: header_opt.unwrap()
        if !(header.starts_with("fn ") || header.starts_with("unsafe fn ")) { continue }
        header :: header.replace("(mut ", "(").replace(", mut ", ", ")
        out.push_str(&"    {header};\n")
    }
    out
}
