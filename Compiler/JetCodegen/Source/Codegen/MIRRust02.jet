// Iterative DFS and Cooper/Harvey/Kennedy immediate dominators.
fn mir_cfg_plan(function: &MirFunction) -> MirCfgPlan? {
    positions: [MirBlockId:USize] = function.blocks.iter().enumerate().map(fn((position, block)) { (block.id, position) }).collect()
    entry :: positions.get(&function.entry).copied()?
    count :: function.blocks.len()
    successors := [[USize]].with_capacity(count)
    for block in &function.blocks {
        row := [USize].new()
        for target in block.terminator.targets() { row.push(positions.get(&target).copied()?) }
        successors.push(row)
    }
    visited := [false; count]
    postorder := [USize].with_capacity(count)
    stack := [(entry, 0)]
    visited[entry] = true
    while !stack.is_empty() {
        top :: stack.last_mut().unwrap()
        (node, edge) :: top
        child_opt :: successors[node].get(edge).copied()
        if child_opt.is_some() {
            child :: child_opt.unwrap()
            top.1 += 1
            if !visited[child] { visited[child] = true; stack.push((child, 0)) }
        } else { postorder.push(node); _ :: stack.pop() }
    }
    rpo: [USize] = postorder.into_iter().rev().collect()
    order := [USize.MAX; count]
    for (number, position) in rpo.iter().enumerate() { order[position] = number }
    predecessors := [[USize].new(); count]
    for position in &rpo { for target in &successors[position] { predecessors[target].push(position) } }
    idom := [USize.MAX; count]
    idom[entry] = entry
    intersect :: fn(idom: &[USize], left: USize, right: USize) {
        left := left
        right := right
        while left != right {
            while order[left] > order[right] { left = idom[left] }
            while order[right] > order[left] { right = idom[right] }
        }
        left
    }
    changed := true
    while changed {
        changed = false
        for position in &rpo {
            if position == entry { continue }
            candidate := USize.MAX
            for predecessor in &predecessors[position] {
                if idom[predecessor] == USize.MAX { continue }
                candidate = if candidate == USize.MAX { predecessor } else { intersect(&idom, predecessor, candidate) }
            }
            if idom[position] != candidate { idom[position] = candidate; changed = true }
        }
    }
    dominates :: fn(dominator: USize, block: USize) {
        block := block
        loop {
            if block == dominator { return true }
            if block == entry { return false }
            block = idom[block]
        }
    }
    headers := [false; count]
    forward := [0; count]
    for position in &rpo {
        for target in &successors[position] {
            if order[target] <= order[position] {
                if !dominates(target, position) { return None }
                headers[target] = true
            } else { forward[target] += 1 }
        }
    }
    merges := [false; count]
    follows := [[USize].new(); count]
    for position in rpo.iter().skip(1).rev() {
        if forward[position] >= 2 { merges[position] = true; follows[idom[position]].push(position) }
    }
    Some(MirCfgPlan { positions, entry, order, headers, merges, follows })
}
// Rust: crates/jet-codegen/src/Codegen/MIRRust.rs:2896
fn wrap_cfg_not_release(out: &String, start: USize, indent: USize) -> {
    if start >= out.len() { return }
    body :: out[start..].to_string()
    out.truncate(start)
    pad :: " ".repeat(indent)
    out.push_str(&"{pad}#[cfg(not(jet_release))]\n{pad}{{\n")
    for line in body.lines() { out.push_str(&"{pad}    {line}\n") }
    out.push_str(&"{pad}}}\n")
}
