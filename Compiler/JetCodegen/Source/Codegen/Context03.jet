impl Cx {
    // Rust: crates/jet-codegen/src/Codegen/Context.rs:3741
    pub fn rust_fn_trait(self, params: [Type], ret: Type?, return_view_provenance: ViewProvenanceMap?) -> String Never! {
        thread_safe :: params.len() == 1 && params[0] == Type.Named("HTTPHandler") && ret == Val(Type.Named("HTTPHandler"))
        has_view_return :: ret.map(fn(ty) { self.type_contains_view(ty) }) ?? false
        owner_params := [Int:Bool]{}
        if return_view_provenance == .Val(map) {
            loop provenance in map.values() {
                loop source in provenance.sources {
                    if source.source == .Parameter(index) -> owner_params[index] = true
                }
            }
        } else if has_view_return {
            loop (index, ty) in params.enumerate() { if !ty.is_scalar() -> owner_params[index] = true }
        }
        independent_lifetimes := [String]{}
        fn_view :: "'{generated_prefix()}fn_view"
        pieces := [String]{}
        loop (index, p) in params.enumerate() {
            if thread_safe { &pieces.push(self.rust_type(p)); next }
            rust :: rust_param_type(self, AccessConvention.Read, p)
            if owner_params.contains(index) {
                if rust.strip_prefix("&mut ") == .Val(rest) -> &pieces.push("&{fn_view} mut {rest}")
                else if rust.strip_prefix('&') == .Val(rest) -> &pieces.push("&{fn_view} {rest}")
                else -> &pieces.push(rust)
            } else if has_view_return {
                lifetime :: "'{generated_prefix()}arg{index}"
                if rust.strip_prefix("&mut ") == .Val(rest) { &independent_lifetimes.push(lifetime); &pieces.push("&{lifetime} mut {rest}") }
                else if rust.strip_prefix('&') == .Val(rest) { &independent_lifetimes.push(lifetime); &pieces.push("&{lifetime} {rest}") }
                else -> &pieces.push(rust)
            } else -> &pieces.push(rust)
        }
        ps :: pieces.join(", ")
        r :: ret.map(fn(t) { if has_view_return -> self.rust_type_with_view_lifetime(t).replace("'{generated_prefix()}view", fn_view) else -> self.rust_type(t) }) ?? "()"
        trait_name :: "FnMut"
        if thread_safe -> return "std::sync::Arc<dyn Fn({ps}) -> {r} + Send + Sync>"
        if has_view_return {
            lifetimes := [fn_view]
            &lifetimes.extend(^independent_lifetimes)
            return "std::rc::Rc<std::cell::RefCell<Option<Box<dyn for<{lifetimes.join(", ")}> {trait_name}({ps}) -> {r}>>>>"
        }
        "std::rc::Rc<std::cell::RefCell<Option<Box<dyn {trait_name}({ps}) -> {r}>>>>"
    }
}
// Rust: crates/jet-codegen/src/Codegen/Context.rs:3843
pub fn rust_param_type(cx: Cx, convention: AccessConvention, ty: Type) -> String Never! {
    if ty == .Tagged{marker: .Internal(.CppCallbackAbi), inner} {
        if inner == .Fn{params, ret, ..} {
            ps :: (loop param in params -> cx.rust_type(param)).join(", ")
            r :: ret.map(fn(ret) { " -> {cx.rust_type(ret)}" }) ?? ""
            return "extern \"C\" fn({ps}){r}"
        }
    }
    base :: cx.rust_type(ty)
    trait_type :: if ty == { .Named(n) -> cx.trait_names.contains(n); .TraitObject(_) -> true; else -> false }
    type_param :: if ty == { .Named(n) -> Generics.is_type_var_name(n) || cx.current_type_params.borrow().contains(n); else -> false }
    if trait_type || type_param {
        return if convention == { .Read -> "&{base}"; .Write -> "&mut {base}"; .Move -> base }
    }
    if convention == { .Read -> if ty.is_scalar() -> base else -> "&{base}"; .Write -> "&mut {base}"; .Move -> base }
}
// Rust: crates/jet-codegen/src/Codegen/Context.rs:3898
pub fn build_cx(prog: Program, src: String, file: String) -> Cx Never! {
    extern_funcs :: extern_func_map(prog.items, None, [])
    build_cx_items(prog.items, src, file, None, extern_funcs, "")
}
// Rust: crates/jet-codegen/src/Codegen/Context.rs:3903
fn extern_func_map(items: [Item], owner: String?, handles: [FfiHandleFact]) -> [String:ExternFn] Never! {
    map := [String:ExternFn]{}
    collect_extern_funcs(items, owner, handles, &map)
    map
}
// Rust: crates/jet-codegen/src/Codegen/Context.rs:3908
fn collect_extern_funcs(items: [Item], owner: String?, handles: [FfiHandleFact], map: &[String:ExternFn]) Never! {
    loop item in items {
        if item == {
            .ExternRust(block) -> { loop ef in block.functions -> map[ef.name] = ExternFn{wrapper: "jet_ffi_{ef.name}", c_abi: false, component: None} }
            .Func(func) -> {
                if Sema.guest_import_function_signature(func) != None && Sema.guest_import_bridge_compatible(func) {
                    wrapper :: owner.map(fn(owner) { Sema.guest_import_wrapper_name(owner, func.name) }) ?? "jet_ffi_{func.name}"
                    map[func.name] = ExternFn{wrapper: wrapper, c_abi: true, component: None}
                } else if func.inline_foreign != None -> map[func.name] = ExternFn{wrapper: "jet_ffi_{func.name}", c_abi: false, component: None}
            }
            .CModule(module) -> {
                loop function in module.functions {
                    if function.hidden_c_bridge_compatible_with_handles(handles) -> map[function.name] = ExternFn{wrapper: "jet_ffi_{function.name}", c_abi: true, component: Val(module.lib)}
                }
            }
            .CodeModule(module) -> { if module.body == .Val(body) -> collect_extern_funcs(body, owner, handles, &map) }
            else -> {}
        }
    }
}
// Rust: crates/jet-codegen/src/Codegen/Context.rs:3978
fn foreign_undo_map(items: [Item]) -> [String:String] Never! {
    map := [String:String]{}
    collect_foreign_undos(items, &map, None)
    map
}
// Rust: crates/jet-codegen/src/Codegen/Context.rs:3979
fn collect_foreign_undos(items: [Item], map: &[String:String], prefix: String?) Never! {
    loop item in items {
        if item == {
            .ExternRust(block) -> {
                loop ef in block.functions {
                    if ef.undo == .Val((inverse, _)) -> map[prefix.map(fn(p) { "{p}::{ef.name}" }) ?? ef.name] = inverse
                }
            }
            .CModule(module) -> {
                loop ef in module.functions {
                    if ef.undo == .Val((inverse, _)) -> map[prefix.map(fn(p) { "{p}::{ef.name}" }) ?? ef.name] = inverse
                }
            }
            .Func(func) -> {
                if func.undo == .Val((inverse, _)) -> map[prefix.map(fn(p) { "{p}::{func.name}" }) ?? func.name] = inverse
            }
            .CodeModule(module) -> { if module.body == .Val(body) -> collect_foreign_undos(body, &map, Val(module.name)) }
            else -> {}
        }
    }
}
// Rust: crates/jet-codegen/src/Codegen/Context.rs:4030
pub fn bundle_extern_funcs(bundle: ProgramBundle) -> [String:ExternFn] Never! {
    map := [String:ExternFn]{}
    loop (module_idx, module) in bundle.modules.enumerate() {
        module_funcs :: extern_func_map(module.items, Val(module.alias), bundle.cffi.handle_facts)
        loop (name, wrapper) in module_funcs {
            map[name] = wrapper
            map["{mangle(module.alias)}::{name}"] = wrapper
        }
        if module.display.starts_with("cpp.") {
            loop item in module.items {
                if item == .Impl(definition) {
                    loop method in definition.methods {
                        if bundle.name_ledger.exported(module_idx, "{definition.type_name}{method.name}") -> map[foreign_binding_method_key(definition.type_name, method.name)] = ExternFn{wrapper: "", c_abi: false, component: None}
                    }
                }
            }
        }
    }
    map
}
// Rust: crates/jet-codegen/src/Codegen/Context.rs:4066
pub fn bundle_foreign_undos(bundle: ProgramBundle, module_idx: Int) -> [String:String] Never! {
    map := [String:String]{}
    loop module in bundle.modules {
        module_prefix :: mangle(module.alias)
        loop (binding, inverse) in foreign_undo_map(module.items) -> map["{module_prefix}::{binding}"] = inverse
    }
    loop (binding, inverse) in foreign_undo_map(bundle.modules[module_idx].items) -> map[binding] = inverse
    map
}
// Rust: crates/jet-codegen/src/Codegen/Context.rs:4085
pub fn foreign_binding_method_key(owner: String, method: String) -> String Never! { mangle_path("foreign_method__{owner}__{method}") }
// Rust: crates/jet-codegen/src/Codegen/Context.rs:4090
pub fn register_bundle_unit_metadata(cx: &Cx, bundle: ProgramBundle, module_idx: Int) Never! {
    imported := [(Int, String?)]{}
    seen := [Int:Bool]{}
    loop import in bundle.modules[module_idx].imports {
        if bundle.name_ledger.effective_alias(module_idx, import.import_alias()) == None -> next
        target :: bundle.name_ledger.import_target(module_idx, import.span) ?? next
        qualifier :: bundle.name_ledger.module_identity(target).expect("name ledger must contain every loaded module")
        &imported.push((target, Val(qualifier)))
        seen[target] = true
    }
    loop (target, _) in Imports.selective_nominal_targets(bundle, module_idx) {
        if seen.contains(target) -> next
        seen[target] = true
        &imported.push((target, Val(bundle.name_ledger.module_identity(target).expect("name ledger must contain every loaded module"))))
    }
    loop import in bundle.modules[module_idx].imports {
        loop (_, target) in Imports.foreign_list_targets(bundle, module_idx, import) {
            if seen.contains(target) -> next
            seen[target] = true
            &imported.push((target, Val(bundle.name_ledger.module_identity(target).expect("name ledger must contain every loaded module"))))
        }
    }
    targets := [(module_idx, String?{None})]
    &targets.extend(^imported)
    loop (target, qualifier) in targets {
        module :: bundle.modules[target]
        loop item in module.items {
            if item == .Distinct(definition) {
                if qualifier != None && !bundle.name_ledger.visible(module_idx, target, definition.name) -> next
                name :: qualifier.map(fn(q) { "{q}::{definition.name}" }) ?? definition.name
                base :: if qualifier != None -> Imports.qualify_imported_call_type(bundle, target, "", definition.base) else -> definition.base
                &cx.type_names.insert(name)
                cx.distinct_types[name] = (base, definition.derives.any(fn(row) { row.0 == Syntax.MARKER_NUMERIC }))
                next
            }
            if item == .UnitFamily(family) {
                dimension :: family.resolved_dimension
                loop member in family.distinct_defs() {
                    if qualifier != None && !bundle.name_ledger.visible(module_idx, target, member.name) -> next
                    name :: qualifier.map(fn(q) { "{q}::{member.name}" }) ?? member.name
                    &cx.type_names.insert(name)
                    base :: if qualifier != None -> Imports.qualify_imported_call_type(bundle, target, "", member.base) else -> member.base
                    cx.distinct_types[name] = (base, member.derives.any(fn(row) { row.0 == Syntax.MARKER_NUMERIC }))
                    kind :: member.quantity.map(fn(row) { row.1 }) ?? QuantityKind.Linear
                    source :: unit_family_member_for_type(family, member.name, kind) ?? next
                    cx.unit_labels[name] = unit_label(family, source)
                    if family.base != None || dimension != None -> cx.unit_facts[name] = unit_fact(family, source, dimension, kind)
                }
            }
        }
        if qualifier == .Val(q) {
            loop item in module.items {
                if item == .Impl(implementation) {
                    qualified :: "{q}::{implementation.type_name}"
                    if implementation.trait_name == Val(Syntax.TRAIT_DISPLAY) && cx.unit_labels.contains(qualified) -> &cx.display_types.insert(qualified)
                }
            }
        }
    }
}
// Rust: crates/jet-codegen/src/Codegen/Context.rs:4244
pub fn module_identity(bundle: ProgramBundle, module_idx: Int) -> String Never! {
    bundle.name_ledger.module_identity(module_idx) ?? bundle.modules.get(module_idx).map(fn(module) { module.display }) ?? ""
}
// Rust: crates/jet-codegen/src/Codegen/Context.rs:4257
fn qualified_constant_key(module: String, name: String) -> String Never! { if module.is_empty() -> name else -> "{module}::{name}" }
// Rust: crates/jet-codegen/src/Codegen/Context.rs:4268
pub fn populate_cx_from_bundle(cx: &Cx, bundle: ProgramBundle, module_idx: Int) Never! {
    cx.import_mods = Imports.import_mod_map(bundle, module_idx)
    cx.module_alias = bundle.modules[module_idx].alias
    cx.module_identity = module_identity(bundle, module_idx)
    module :: cx.module_identity
    cx.const_ref_keys = [:]
    loop name in cx.const_types.keys() -> cx.const_ref_keys[name] = qualified_constant_key(module, name)
    cx.const_ref_types = ~cx.const_types
    source_path :: bundle.name_ledger.module_path(module_idx)
    cx.checked_const_ref_sites = [:]
    // GATE #4499: checked reference span and declaration tuple keys retain structural equality.
    loop ((source, start, end), reference) in bundle.name_ledger.references() {
        if Val(source) != source_path || reference.kind != "const" -> next
        target_module :: (0..<bundle.modules.len()).find(fn(target_idx) { bundle.name_ledger.module_path(target_idx) == Val(reference.module_path) }) ?? next
        declaration :: bundle.name_ledger.declarations().find(fn(declaration) { declaration.module == target_module && declaration.span == reference.def_span && declaration.kind == "const" }) ?? next
        ty :: bundle.modules[target_module].items.find_map(fn(item) { if item == { .Const(candidate) -> if candidate.name == declaration.name -> TIR.source_constant_type(candidate) else -> None; else -> None } }) ?? next
        cx.checked_const_ref_sites[(start, end)] = (qualified_constant_key(module_identity(bundle, target_module), declaration.name), ty)
    }
    loop alias in bundle.name_ledger.aliases() {
        if alias.module != module_idx || cx.const_ref_keys.contains(alias.name) -> next
        target_module :: alias.target_module ?? next
        target :: bundle.modules.get(target_module) ?? next
        path :: alias.target.strip_prefix(target.alias) ?? next
        target_name :: path.strip_prefix('.') ?? next
        definition :: bundle.name_ledger.declaration(target_module, target_name) ?? next
        if definition.kind != "const" -> next
        cx.const_ref_keys[alias.name] = qualified_constant_key(module_identity(bundle, target_module), definition.name)
        if target.items.find_map(fn(item) { if item == { .Const(candidate) -> if candidate.name == definition.name -> TIR.source_constant_type(candidate) else -> None; else -> None } }) == .Val(ty) -> cx.const_ref_types[alias.name] = ty
    }
    cx.devtools_registry = ~bundle.devtools_registry
    if bundle.name_ledger.module(module_idx) == .Val(module) { cx.devtools_package = module.package; cx.devtools_module = module.path }
    else { cx.devtools_package = ""; cx.devtools_module = "" }
    cx.policy_declarations = ~bundle.modules[module_idx].policy_declarations
    populate_cx_module_facts(&cx, bundle, module_idx)
    &cx.opaque_handles.clear()
    loop fact in bundle.cffi.handle_facts -> &cx.opaque_handles.insert(fact.jet_name)
    cx.core_source_modules = [:]
    loop module in bundle.modules {
        if CoreModuleExports.core_source_module_by_alias(module.alias) == .Val(source) -> cx.core_source_modules[source.module] = source.alias
    }
    if CoreSourceParts.core_private_source_part(CoreSourceParts.CORE_TEXT_STRING_OWNER) == .Val(part) {
        if bundle.modules.any(fn(module) { module.alias == part.source.alias }) -> cx.core_source_modules[part.source.module] = part.source.alias
    }
    cx.core_source_sigs = Imports.core_source_sig_map(bundle)
    cx.foreign_types = Imports.foreign_type_map(bundle, module_idx)
    TIR.register_imported_struct_shapes(&cx, bundle, module_idx)
    Imports.update_cloneability_with_foreign_types(&cx, bundle.modules[module_idx].items)
    Imports.register_foreign_enum_variants(&cx, bundle, module_idx)
    cx.reexport_calls = Imports.reexport_call_map(bundle, module_idx)
    cx.import_sigs = Imports.import_sig_map(bundle, module_idx)
    cx.import_rets = Imports.import_ret_map(bundle, module_idx)
    cx.core_imports = Imports.core_import_map(bundle, module_idx)
    register_bundle_reflect_paths(&cx, bundle, module_idx)
    register_core_close_types(&cx, bundle)
    register_core_import_surfaces(&cx)
    cx.used_core = ~bundle.used_core
    cx.foreign_undos = bundle_foreign_undos(bundle, module_idx)
    cx.ffi_callback_fns = ~bundle.ffi_callback_fns
    register_bundle_unit_metadata(&cx, bundle, module_idx)
    (uinline, ufile) :: Imports.unqualified_import_maps(bundle, module_idx)
    cx.unqualified_inline = uinline; cx.unqualified_file = ufile
    (inline, file, names, reexports) :: Imports.inline_import_maps(bundle, module_idx)
    cx.inline_unqualified = inline; cx.inline_unqualified_file = file; cx.inline_import_names = names; cx.inline_reexport_inline = reexports
    (inline_core, reexport_core) :: Imports.inline_core_import_maps(bundle, module_idx)
    cx.inline_core_imports = inline_core; cx.inline_reexport_core = reexport_core
    cx.inline_foreign_imports = Imports.inline_foreign_import_maps(bundle, module_idx)
    (inline_foreign_sigs, inline_foreign_rets) :: Imports.inline_foreign_import_signature_maps(bundle, module_idx)
    cx.inline_foreign_sigs = inline_foreign_sigs; cx.inline_foreign_rets = inline_foreign_rets
    cx.inline_reexport_foreign = Imports.inline_foreign_reexport_maps(bundle, module_idx)
    preview_identity := "jet-ui-preview-build-v1{TEXT_NUL}".bytes().to_array()
    bundle.build_facts.append_artifact_identity_bytes(&preview_identity)
    loop value in [bundle.build_facts.profile, bundle.build_facts.stamp.toolchain, if bundle.build_facts.stamp.dirty -> "dirty" else -> "clean", bundle.build_facts.package_name, bundle.build_facts.package_version] {
        &preview_identity.extend(U64{value.len()}.to_le_bytes())
        &preview_identity.extend(value.bytes())
    }
    cx.preview_build_id = "sha256-{sha256_hex(preview_identity)}"
    cx.preview_revision = bundle.build_facts.stamp.git.filter(fn(value) { !value.is_empty() }) ?? (if !bundle.build_facts.stamp.at.is_empty() -> bundle.build_facts.stamp.at else -> "{bundle.build_facts.package_name}:{bundle.build_facts.package_version}")
    (inline_foreign_reexport_sigs, inline_foreign_reexport_rets) :: Imports.inline_foreign_reexport_signature_maps(bundle, module_idx)
    cx.inline_foreign_reexport_sigs = inline_foreign_reexport_sigs; cx.inline_foreign_reexport_rets = inline_foreign_reexport_rets
    cx.package_edition = bundle.edition
    cx.hardware_profile = Sema.target_hardware_profile(bundle)
    cx.hardware_profile_id = Sema.target_hardware_profile_id(bundle)
}
// Rust: crates/jet-codegen/src/Codegen/Context.rs:4494
pub fn populate_cx_module_facts(cx: &Cx, bundle: ProgramBundle, module_idx: Int) Never! {
    &cx.direct_c_functions.clear()
    loop module in bundle.modules {
        loop item in module.items {
            if item == .CModule(c_module) { loop function in c_module.functions -> &cx.direct_c_functions.insert("{mangle(module.alias)}::{function.name}") }
        }
    }
    &cx.foreign_call_keys.clear()
    loop (foreign_module_idx, foreign_module) in bundle.modules.enumerate() {
        identity :: module_identity(bundle, foreign_module_idx)
        rust_module :: mangle(foreign_module.alias)
        loop item in foreign_module.items {
            if item == {
                .CModule(c_module) -> {
                    loop function in c_module.functions {
                        key :: "{identity}::{function.name}"
                        cx.foreign_call_keys["{rust_module}::{function.name}"] = key
                        if foreign_module_idx == module_idx -> cx.foreign_call_keys[function.name] = key
                    }
                }
                .ExternRust(block) -> {
                    loop function in block.functions {
                        key :: "{identity}::{function.rust_path}"
                        cx.foreign_call_keys["{rust_module}::{function.name}"] = key
                        if foreign_module_idx == module_idx -> cx.foreign_call_keys[function.name] = key
                    }
                }
                .Func(function) -> {
                    if Sema.guest_import_function_signature(function) != None {
                        wrapper :: Sema.guest_import_wrapper_name(foreign_module.alias, function.name)
                        cx.foreign_call_keys["{rust_module}::{function.name}"] = wrapper
                        if foreign_module_idx == module_idx -> cx.foreign_call_keys[function.name] = wrapper
                    }
                }
                else -> {}
            }
        }
    }
    &cx.local_type_names.retain(fn(name) { bundle.name_ledger.declaration(module_idx, name) != None })
    register_imported_methods(&cx, bundle, module_idx)
    cx.package_hardened = bundle.package_guarantees.harden
    module :: bundle.modules.get(module_idx) ?? { cx.dependency_fenced = false; return }
    dependency := String?{None}
    best_depth := -1
    loop (name, root) in bundle.dep_roots {
        if !module.path.starts_with(root) -> next
        depth :: root.components().count()
        if depth > best_depth || (depth == best_depth && name > (dependency ?? "")) { best_depth = depth; dependency = Val(name) }
    }
    cx.dependency_fenced = dependency.map(fn(name) { bundle.package_guarantees.harden || bundle.package_guarantees.contain.contains(name) }) ?? false
}
// Rust: crates/jet-codegen/src/Codegen/Context.rs:4581
pub fn register_bundle_reflect_paths(cx: &Cx, bundle: ProgramBundle, module_idx: Int) Never! {
    loop (name, path) in bundle.name_ledger.canonical_paths(module_idx) -> cx.reflect_paths[name] = path
}
// Rust: crates/jet-codegen/src/Codegen/Context.rs:4592
fn register_imported_methods(cx: &Cx, bundle: ProgramBundle, module_idx: Int) Never! {
    imported := [Int:Bool]{}
    loop import in bundle.modules[module_idx].imports {
        if import.core_module_path() == .Val(core_module) {
            if Imports.core_source_target(bundle, core_module) == .Val((_, target)) -> imported[target] = true
            next
        }
        if bundle.name_ledger.effective_alias(module_idx, import.import_alias()) == None -> next
        if bundle.name_ledger.import_target(module_idx, import.span) == .Val(target) -> imported[target] = true
    }
    loop (target, _) in Imports.selective_nominal_targets(bundle, module_idx) -> imported[target] = true
    loop import in bundle.modules[module_idx].imports {
        loop (_, target) in Imports.foreign_list_targets(bundle, module_idx, import) -> imported[target] = true
    }
    targets := imported.keys().to_array()
    &targets.sort()
    loop target in targets {
        rust_mod :: mangle(bundle.modules[target].alias)
        loop item in bundle.modules[target].items {
            owner := ""
            methods := [(Func, String?, Bool, Type?)]{}
            if item == {
                .Struct(definition) -> {
                    owner = definition.name
                    loop method in definition.methods -> &methods.push((method, None, false, None))
                    loop implementation in definition.trait_impls {
                        loop method in implementation.methods -> &methods.push((method, Val(implementation.trait_name), implementation.compiler_generated, implementation.operator_rhs))
                    }
                }
                .Enum(definition) -> {
                    owner = definition.name
                    loop method in definition.methods -> &methods.push((method, None, false, None))
                    loop implementation in definition.trait_impls {
                        loop method in implementation.methods -> &methods.push((method, Val(implementation.trait_name), implementation.compiler_generated, implementation.operator_rhs))
                    }
                }
                .Impl(definition) -> {
                    owner = definition.type_name
                    loop method in definition.methods -> &methods.push((method, definition.trait_name, false, definition.operator_rhs))
                }
                else -> next
            }
            owner_identity :: bundle.name_ledger.nominal_identity(target, owner).expect("name ledger must contain every loaded module")
            owner_visible :: bundle.name_ledger.visible(module_idx, target, owner)
            loop (method, trait_name, import_trait, operator_rhs) in methods {
                method_visible :: bundle.name_ledger.visible(module_idx, target, "{owner}.{method.name}")
                if !method_visible && !(trait_name != None && owner_visible) -> next
                // GATE #4499: method keys are exact nominal/method tuples.
                key :: (owner_identity, method.name)
                if trait_name == .Val(trait_name) {
                    &cx.trait_methods.insert(key)
                    cx.trait_method_traits[key] = trait_name
                    if import_trait -> &cx.imported_traits.insert((rust_mod, trait_name))
                }
                if method.params.find(fn(p) { p.name == Syntax.KW_SELF }) == .Val(self_param) {
                    if !cx.method_self_convs.contains(key) -> cx.method_self_convs[key] = self_param.convention
                }
                imported_sig :: loop (convention, ty) in method_sig_params(method) -> (convention, Imports.qualify_imported_call_type(bundle, target, "", ty))
                if !cx.method_sigs.contains(key) -> cx.method_sigs[key] = imported_sig
                contract_key :: "{owner}::{method.name}"
                if !cx.contract_sigs.contains(contract_key) -> cx.contract_sigs[contract_key] = (~method.pre, ~method.post)
                if !cx.fn_param_names.contains(contract_key) -> cx.fn_param_names[contract_key] = loop param in method.params -> param.name
                imported_ret :: method.return_type.map(fn(ty) { Imports.qualify_imported_call_type(bundle, target, "", ty) })
                imported_operator_rhs :: operator_rhs.map(fn(rhs) { Imports.qualify_imported_call_type(bundle, target, "", rhs) })
                if !cx.method_rets.contains(key) -> cx.method_rets[key] = imported_ret
                if trait_name == .Val(trait_name) -> register_operator_method(&cx, owner_identity, method.name, trait_name, imported_operator_rhs, imported_sig, imported_ret)
            }
        }
    }
}
// Rust: crates/jet-codegen/src/Codegen/Context.rs:4765
fn register_core_close_types(cx: &Cx, bundle: ProgramBundle) Never! {
    loop (module, names) in [("core.files", ["FileReader", "FileWriter", "FileLock", "TempDir", "TempFile"]), ("core.net", ["TcpStream", "TCPStream", "UnixStream", "TLSStream"]), (Syntax.CORE_MEM_MODULE, ["Arena", "Bump", "Pool", "Fixed"]), ("core.db", ["DBConnection", "DBScope", "DBPool", "DBLease"])] {
        if !cx.core_imports.values().any(fn(import) { import == module }) -> next
        loop name in names -> &cx.close_types.insert(name)
        if CoreModuleExports.core_source_module(module) == .Val(source) {
            if bundle.modules.enumerate().find(fn(row) { row.1.alias == source.alias }) == .Val((index, _)) {
                loop name in names { if bundle.name_ledger.nominal_identity(index, name) == .Val(identity) -> &cx.close_types.insert(identity) }
            }
        }
    }
}
// Rust: crates/jet-codegen/src/Codegen/Context.rs:4789
pub fn register_core_import_surfaces(cx: &Cx) Never! {
    if cx.core_imports.values().any(fn(module) { module == "core.service" }) {
        zero :: Span.new(0, 0)
        variants :: loop name in ["Pending", "Accepted", "Delivering", "Delivered", "DeadLettered", "Cancelled"] -> (name, VariantPayload.Unit)
        loop (variant, _) in variants -> cx.variant_owner[variant] = "DeliveryState"
        cx.enum_variants["DeliveryState"] = variants
        loop name in ["Delivery", "DeliveryReceipt", "DeliveryEvent"] -> &cx.cloneable.insert(name)
        workflow_outcomes :: [("Finished", VariantPayload.Unit), ("Panicked", VariantPayload.Single(Type.String, zero)), ("Cancelled", VariantPayload.Unit), ("DeadlineBlown", VariantPayload.Unit)]
        loop (variant, _) in workflow_outcomes -> cx.variant_owner[variant] = "TaskOutcome"
        cx.enum_variants["TaskOutcome"] = workflow_outcomes
        &cx.cloneable.insert("TaskOutcome")
        workflow_statuses :: loop variant in ["Running", "Paused", "CancelRequested"] -> (variant, VariantPayload.Unit)
        loop (variant, _) in workflow_statuses -> cx.variant_owner[variant] = "TaskStatus"
        cx.enum_variants["TaskStatus"] = workflow_statuses
        &cx.cloneable.insert("TaskStatus")
        error_variants :: loop name in ["Full", "Ambiguous", "Unknown", "NotStarted", "Policy", "Unavailable", "Partitioned", "Revoked", "Stale", "Expired"] -> (name, VariantPayload.Single(Type.String, zero))
        loop (variant, _) in error_variants -> cx.variant_owner[variant] = "ServiceError"
        cx.enum_variants["ServiceError"] = error_variants
        &cx.cloneable.insert("ServiceError")
    }
    if cx.core_imports.values().any(fn(module) { module == "core.auth" }) {
        zero :: Span.new(0, 0)
        field :: fn(name: String, ty: Type) -> VariantField Never! { VariantField{name: name, name_span: zero, ty: ty, ty_span: zero} }
        variants := [("InvalidSignature", VariantPayload.Unit), ("WeakKey", VariantPayload.Unit), ("TokenExpired", VariantPayload.Unit)]
        loop name in ["MalformedToken", "UnsupportedToken", "MissingClaim", "DecodeError"] -> &variants.push((name, VariantPayload.Single(Type.String, zero)))
        &variants.push(("WrongAudience", VariantPayload.Named([field("expected", Type.String), field("actual", Type.String)])))
        &variants.push(("WrongIssuer", VariantPayload.Named([field("expected", Type.String), field("actual", Type.Option(Type.String))])))
        &variants.push(("TokenNotYetValid", VariantPayload.Unit))
        loop (variant, _) in variants -> cx.variant_owner[variant] = "AuthError"
        cx.enum_variants["AuthError"] = variants
        &cx.cloneable.insert("AuthError")
    }
    if cx.core_imports.values().any(fn(module) { module == "core.net.tls" }) {
        zero :: Span.new(0, 0)
        versions :: [("TLS12", VariantPayload.Unit), ("TLS13", VariantPayload.Unit)]
        loop (variant, _) in versions -> cx.variant_owner[variant] = "TLSVersion"
        cx.enum_variants["TLSVersion"] = versions
        &cx.cloneable.insert("TLSVersion")
        roots :: Type.Named("TLSRootCertificates")
        trust :: [("System", VariantPayload.Unit), ("SystemPlus", VariantPayload.Single(roots, zero)), ("CustomOnly", VariantPayload.Single(roots, zero))]
        loop (variant, _) in trust -> cx.variant_owner[variant] = "TLSClientTrust"
        cx.enum_variants["TLSClientTrust"] = trust
        &cx.cloneable.insert("TLSClientTrust")
    }
    if cx.core_imports.values().any(fn(module) { module == "core.data" }) {
        variants :: loop variant in ["File", "URL", "Database", "Value"] -> (variant, VariantPayload.Unit)
        loop (variant, _) in variants -> cx.variant_owner[variant] = "DataLoaderKind"
        cx.enum_variants["DataLoaderKind"] = variants
        &cx.cloneable.insert("DataLoaderKind")
    }
    if cx.core_imports.values().any(fn(module) { module == Syntax.WATCHER_MODULE }) {
        loop (name, variants) in [("WatchDomain", ["File", "Process", "Port"]), ("WatchKind", ["Created", "Modified", "Removed", "Error", "Exited", "Ready"])] {
            loop variant in variants -> cx.variant_owner[variant] = name
            cx.enum_variants[name] = loop variant in variants -> (variant, VariantPayload.Unit)
            &cx.cloneable.insert(name)
        }
    }
    if !cx.core_imports.values().any(fn(module) { module == Syntax.CORE_EMAIL_MODULE }) && cx.core_source_modules.get(Syntax.CORE_EMAIL_MODULE) != Val(cx.module_alias) -> return
    zero :: Span.new(0, 0)
    loop (name, variants) in [
        ("SMTPSecurity", [("StartTLS", VariantPayload.Unit), ("TLS", VariantPayload.Unit)]),
        ("RecipientPolicy", [("RequireAll", VariantPayload.Unit), ("DeliverAccepted", VariantPayload.Unit)]),
        ("SMTPAuth", [("None", VariantPayload.Unit), ("Password", VariantPayload.Named([
            VariantField{name: "username", name_span: zero, ty: Type.String, ty_span: zero},
            VariantField{name: "password", name_span: zero, ty: Type.Named("Secret"), ty_span: zero}
        ]))]),
        ("TLSTrust", [("System", VariantPayload.Unit), ("SystemPlusCa", VariantPayload.Named([
            VariantField{name: "pem", name_span: zero, ty: Type.List(Type.IntN{signed: false, bits: 8}), ty_span: zero}
        ]))])
    ] {
        loop (variant, _) in variants -> cx.variant_owner[variant] = name
        cx.enum_variants[name] = variants
        &cx.cloneable.insert(name)
    }
    error_fields :: fn() -> [VariantField] Never! {
        loop (field, ty) in [("operation", Type.String), ("server", Type.Option(Type.String)), ("code", Type.Option(Type.Int)), ("reason", Type.String)] -> VariantField{name: field, name_span: zero, ty: ty, ty_span: zero}
    }
    errors :: loop variant in ["Configuration", "DNS", "Connect", "TLS", "Auth", "Protocol", "Rejected", "Transient", "TimedOut", "Cancelled", "DeliveryUnknown"] -> (variant, VariantPayload.Named(error_fields()))
    loop (variant, _) in errors -> cx.variant_owner[variant] = "EmailError"
    cx.enum_variants["EmailError"] = errors
    &cx.cloneable.insert("EmailError")
    cx.struct_fields["Envelope"] = [("from", Type.Named("Address")), ("recipients", Type.List(Type.Named("Address")))]
    cx.struct_fields["RecipientReport"] = [("address", Type.Named("Address")), ("accepted", Type.Bool), ("code", Type.Int), ("message", Type.String)]
    cx.struct_fields["SendReport"] = [("server", Type.String), ("accepted", Type.List(Type.Named("RecipientReport"))), ("rejected", Type.List(Type.Named("RecipientReport"))), ("response_code", Type.Int), ("response", Type.String), ("accepted_at", Type.String)]
    cx.struct_fields["Limits"] = [("max_reply_line_bytes", Type.Int), ("max_reply_lines", Type.Int), ("max_capabilities", Type.Int), ("max_recipients", Type.Int), ("max_message_bytes", Type.Int), ("max_auth_challenge_bytes", Type.Int)]
    cx.struct_fields["SMTPConfig"] = [("host", Type.String), ("port", Type.Int), ("security", Type.Named("SMTPSecurity")), ("auth", Type.Named("SMTPAuth")), ("recipient_policy", Type.Named("RecipientPolicy")), ("trust", Type.Named("TLSTrust")), ("limits", Type.Named("Limits")), ("dkim", Type.Option(Type.Named("DKIMConfig")))]
    cx.struct_fields["DKIMConfig"] = [("domain", Type.String), ("selector", Type.String), ("private_key", Type.Named("Secret")), ("signed_headers", Type.List(Type.String))]
    loop name in ["Envelope", "RecipientReport", "SendReport", "Limits"] -> &cx.cloneable.insert(name)
}
// Rust: crates/jet-codegen/src/Codegen/Context.rs:5193
pub fn memo_facts_for_struct(structure: StructDef) -> ([String:Type], [String:[String:Bool]]) Never! {
    computed := [String:Bool]{}
    loop field in structure.fields { if field.computed != None -> computed[field.name] = true }
    direct := [String:[String:Bool]]{}
    loop field in structure.fields {
        expression :: field.computed ?? next
        dependencies := [String:Bool]{}
        expression.for_each_expr(fn(node) {
            if node == .Field(receiver, name, _) {
                if receiver == .Ident(value, _) && value == Syntax.KW_SELF -> dependencies[name] = true
            }
        })
        direct[field.name] = dependencies
    }
    memo_fields := [String:Type]{}
    loop field in structure.fields {
        if field.computed != None && field.serde_markers.any(fn(marker) { marker.name == Syntax.MARKER_MEMO }) -> memo_fields[field.name] = field.ty
    }
    dependencies := [String:[String:Bool]]{}
    loop field in structure.fields {
        if field.computed != None -> next
        source :: field.name
        loop memo in memo_fields.keys() {
            visiting := [String:Bool]{}
            if depends_on(memo, source, direct, computed, &visiting) {
                if !dependencies.contains(source) -> dependencies[source] = [:]
                dependencies[source][memo] = true
            }
        }
    }
    (memo_fields, dependencies)
}
// Rust: crates/jet-codegen/src/Codegen/Context.rs:5218
fn depends_on(field: String, source: String, direct: [String:[String:Bool]], computed: [String:Bool], visiting: &[String:Bool]) -> Bool Never! {
    if visiting.contains(field) -> return false
    visiting[field] = true
    dependencies :: direct.get(field) ?? return false
    loop dependency in dependencies.keys() {
        if dependency == source || (computed.contains(dependency) && depends_on(dependency, source, direct, computed, &visiting)) -> return true
    }
    // Keep visited marked: reachability revisits add nothing.
    false
}
// Rust: crates/jet-codegen/src/Codegen/Context.rs:5270
fn receipt_schema_digest(type_name: String, fields: [(String, Type)]) -> String Never! {
    schema := "{type_name}{TEXT_NUL}"
    loop (name, ty) in fields -> &schema.push_str("{name}:{ty.name()};")
    sha256_hex(schema.bytes())
}
