    fn cli_web_default_argument(self, input: &MirCliInput) -> String? {
        if input.shape == {
            .Flag -> Some("false")
            .Value(_, optional, default) -> if default == {
                .Some(.TypeDefault) -> Some("Default::default()")
                .Some(.Value(value)) -> Some(self.constant_for_type(value, input.ty))
                .None if optional -> Some("Default::default()")
                .None -> None
            }
        }
    }
    // Rust: crates/jet-codegen/src/Codegen/MIRRust.rs:11228
    fn cli_web_record_argument(self, function: &MirFunction, cli: &MirCliEntry) -> String? {
        if !cli.record_inputs || function.params.len() != 1 { return None }
        fields_opt :: self.cli_record_fields(function.params[0].ty)
        if fields_opt.is_none() { return None }
        fields :: fields_opt.unwrap()
        if fields.iter().filter(fn(field) { !field.computed }).count() != cli.inputs.len() { return None }
        by_name := [String:USize].new()
        for (index, input) in cli.inputs.iter().enumerate() { by_name.entry(input.name).or_insert(index) }
        for field in fields {
            if field.computed { continue }
            first :: by_name.get(field.name)
            second :: by_name.get(field.shape_names.args)
            index :: if (first, second) == { (.Some(a), .Some(b)) -> a.min(b) (.Some(a), .None) -> a (.None, .Some(b)) -> b _ -> return None }
            if self.cli_web_default_argument(cli.inputs[index]).is_none() { return None }
        }
        Some(self.cli_record_argument(function, cli.inputs, fn(input) { self.cli_web_default_argument(input).expect("MIR Web CLI record default validated above") }))
