            .Int -> if input.ty.kind() == {
                .Int -> "match {root}jet_std::jet_int_owned_from_str(&{raw}) {{ Ok(__n) => __n, Err(_) => return Err(format!(\"invalid value for --{{}}: `{{}}` is not a whole number\\n\\n{{}}\", {name}, {raw}, __spec.help())) }}"
                .IntN(_, _) -> "(match {root}jet_std::jet_int_from_str(&{raw}) {{ Ok(__n) => __n, Err(_) => return Err(format!(\"invalid value for --{{}}: `{{}}` is not a whole number\\n\\n{{}}\", {name}, {raw}, __spec.help())) }}) as {self.rust_type(input.ty)}"
                .InlineRange(_, lo, hi) -> "match {root}jet_inline_range_from_int(match {raw}.parse::<i64>() {{ Ok(__n) => __n, Err(_) => return Err(format!(\"invalid value for --{{}}: `{{}}` is not a whole number\\n\\n{{}}\", {name}, {raw}, __spec.help())) }}, {lo}, {hi}) {{ Ok(__n) => __n, Err(__reason) => return Err(format!(\"invalid value for --{{}}: {{}}\\n\\n{{}}\", {name}, __reason, __spec.help())) }}"
                .Tagged(_, inner) | .Quantity(_, inner) -> {
                    nested := input.clone()
                    nested.ty = inner.clone()
                    self.cli_scalar_expr(&nested, raw)
                }
                .Float | .Bool | .String | .Char | .List(_) | .Map(_, _) | .Shared(_) | .Option(_) | .Result(_, _) | .Fn(_) | .SendFn(_, _) | .Apply(_, _) | .TraitObject(_) | .Tuple(_) | .FixedList(_, _) | .Float32 | .Union(_) | .Measure(_) -> panic("MIR CLI Int row has a non-integer checked type")
            }
            .Float -> if input.ty.kind() == {
                .Float -> "match {raw}.parse::<f64>() {{ Ok(__n) => __n, Err(_) => return Err(format!(\"invalid value for --{{}}: `{{}}` is not a number\\n\\n{{}}\", {name}, {raw}, __spec.help())) }}"
                .Float32 -> "(match {raw}.parse::<f64>() {{ Ok(__n) => __n, Err(_) => return Err(format!(\"invalid value for --{{}}: `{{}}` is not a number\\n\\n{{}}\", {name}, {raw}, __spec.help())) }}) as f32"
                .Int | .IntN(_, _) | .Bool | .String | .Char | .List(_) | .Map(_, _) | .Shared(_) | .Option(_) | .Result(_, _) | .Fn(_) | .SendFn(_, _) | .Apply(_, _) | .TraitObject(_) | .Tuple(_) | .FixedList(_, _) | .InlineRange(_, _, _) | .Tagged(_, _) | .Quantity(_, _) | .Union(_) | .Measure(_) -> panic("MIR CLI Float row has a non-floating checked type")
            }
            .String -> {
                if input.ty.kind() != MirTypeKind.String { panic("MIR CLI String row has a non-String checked type") }
                "{raw}.clone()"
            }
            .Path -> {
                if input.ty.nominal_name() != Some("Path") { panic("MIR CLI Path row has a non-Path checked type") }
                "{root}jet_path_from(&{raw})"
            }
        }
    }
