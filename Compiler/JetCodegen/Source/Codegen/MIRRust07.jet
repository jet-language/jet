    // Rust: crates/jet-codegen/src/Codegen/MIRRust.rs:11078
    fn cli_decode_lines(self, inputs: &[MirCliInput], indent: USize, prefix: &String) -> String {
        root :: self.config.root_prefix
        pad :: " ".repeat(indent)
        lines := String.new()
        for input in inputs {
            variable :: "{prefix}{input.parameter}"
            name :: quote_rust_string(input.name)
            if input.shape == {
                .Flag -> {
                    if !input.ty.is_bool() { panic("MIR CLI flag decoder has a non-Bool type") }
                    lines.push_str("{pad}let {variable}: bool = {root}jet_parsed_flag(&__parsed, &{name}.to_string());\n")
                }
                .Value(_, _, _) if input.variadic -> {
                    inner :: if input.ty.kind() == { .List(inner) -> inner _ -> panic("MIR variadic CLI input must have a List type") }
                    element_ty :: self.rust_type(inner)
                    scalar_input := input.clone()
                    scalar_input.ty = inner.clone()
                    result :: self.cli_scalar_result_expr(&scalar_input, "__v")
                    lines.push_str("{pad}let {variable}: Vec<{element_ty}> = match {root}jet_parsed_options(&__parsed, &{name}.to_string()).into_iter().map(|__v| {result}).collect::<Result<Vec<_>, String>>() {{ Ok(__v) => __v, Err(__e) => return Err(__e) }};\n")
                }
                .Value(_, true, _) -> {
                    inner :: if input.ty.kind() == { .Option(inner) -> inner _ -> panic("MIR optional CLI input must have an Option type") }
                    inner_ty :: self.rust_type(inner)
                    scalar_input := input.clone()
                    scalar_input.ty = inner.clone()
                    value :: self.cli_scalar_expr(&scalar_input, "__v")
                    lines.push_str("{pad}let {variable}: {root}JetOutcome<{inner_ty}, {root}JetAbsent> = match {root}jet_parsed_option(&__parsed, &{name}.to_string()) {{ Ok(__v) => Ok({value}), Err({root}JetAbsent) => Err({root}JetAbsent) }};\n")
                }
                .Value(_, false, default) -> {
                    value :: self.cli_scalar_expr(input, "__v")
                    fallback :: if default == {
                        .None -> "return Err(format!(\"missing required argument --{{}}\\n\\n{{}}\", {name}, __spec.help()))"
                        .Some(.TypeDefault) -> "Default::default()"
                        .Some(.Value(value)) -> self.constant_for_type(value, input.ty)
                    }
                    ty :: self.rust_type(input.ty)
                    lines.push_str("{pad}let {variable}: {ty} = match {root}jet_parsed_option(&__parsed, &{name}.to_string()) {{ Ok(__v) => {value}, Err(_) => {fallback} }};\n")
                }
            }
        }
        lines
    }
    // Rust: crates/jet-codegen/src/Codegen/MIRRust.rs:11151
    fn cli_record_fields(self, ty: &MirType) -> [MirField]? {
        if ty.identity == .Some(identity) {
            if self.try_type_def(identity) == .Some(def) {
                if def.kind == .Struct(fields, _) { return Some(fields) }
            }
        }
        None
    }
    // Rust: crates/jet-codegen/src/Codegen/MIRRust.rs:11159
    // One #CLI record parameter carries its fields; one scalar carries itself.
    fn job_record_inputs(self, function: &MirFunction, job: &MirJob) -> Bool {
        if function.params.len() != 1 { return false }
        fields_opt :: self.cli_record_fields(function.params[0].ty)
        if fields_opt.is_none() { return false }
        fields :: fields_opt.unwrap().iter().filter(fn(field) { !field.computed }).collect()
        names := [String:Bool].new()
        for input in job.inputs { names[input.name] = true }
        fields.len() == job.inputs.len() && fields.iter().all(fn(field) { names.contains_key(field.name) || names.contains_key(field.shape_names.args) })
    }
    // Rust: crates/jet-codegen/src/Codegen/MIRRust.rs:11178
    fn cli_record_argument(self, function: &MirFunction, inputs: &[MirCliInput], render_input: fn(&MirCliInput) -> String) -> String {
        fields :: self.cli_record_fields(function.params[0].ty).expect("MIR CLI record fields validated above")
        by_name := [String:USize].new()
        for (index, input) in inputs.iter().enumerate() { by_name.entry(input.name).or_insert(index) }
        values := [String].new()
        for field in fields {
            if field.computed { continue }
            // Preserve first matching input when both aliases are present.
            first :: by_name.get(field.name)
            second :: by_name.get(field.shape_names.args)
            index :: if (first, second) == {
                (.Some(a), .Some(b)) -> a.min(b)
                (.Some(a), .None) -> a
                (.None, .Some(b)) -> b
                _ -> panic("MIR CLI record input validated above")
            }
            values.push("{self.field_name(field.id)}: {render_input(inputs[index])}")
        }
        record :: "{self.rust_type(function.params[0].ty)} {{ {values.join(", ")} }}"
        if function.params[0].access == {
            .Write -> "&mut {record}"
            .Read if self.is_scalar(function.params[0].ty) -> record
            .Read -> "&{record}"
            .Move -> record
        }
    }
