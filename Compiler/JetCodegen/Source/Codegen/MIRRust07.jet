    fn entry_error_exit(self, function: &MirFunction, error: &String, service: Bool) -> String {
        error_ty :: if function.failure == {
            .Result(_, ty) -> Some(ty)
            .Optional(_) -> None
            .Diverges(_) -> panic("MIR entry error edge requested for a diverging function")
            .Infallible -> panic("MIR entry error edge requested for an infallible function")
        }
        is_jet_err :: error_ty.is_some_and(fn(ty) { ty.nominal_name() == Some(TYPE_ERR) })
        // [FieldError] has no definition row; use its one Prelude projection.
        field_errors :: error_ty.is_some_and(fn(ty) {
            if ty.kind() == .List(inner) { if inner.kind() == .Apply(name, args) { return name.name == "FieldError" && args.is_empty() } }
            false
        })
        has_jet_show :: !is_jet_err && (field_errors || error_ty.and_then(fn(ty) { ty.nominal_id().or(ty.identity) }).and_then(fn(id) { self.try_type_def(id) }).is_some_and(fn(def) { def.key == TYPE_IO_ERROR || def.auto_printable || self.selected_trait_impl_for_type(def, PRINTABLE) }))
        root :: self.config.root_prefix
        if self.config.target_kind == MirRustTarget.WebWasm {
            return if is_jet_err { "{root}jet_wasm_store_error(&{error})" }
            else if error_ty.is_none() { "{root}jet_wasm_store_error(&{root}jet_err_from_message(\"entry returned no value\".to_string()))" }
            else if has_jet_show { "{root}jet_wasm_store_error(&{root}jet_err_from_message({root}jet_entry_error_text_show(&{error})))" }
            else { "{root}jet_wasm_store_error(&{root}jet_err_from_message(format!(\"{{:?}}\", {error})))" }
        }
        if self.is_no_os() {
            return if error_ty.is_none() { "{root}jet_entry_error_exit(\"entry returned no value\")" }
            else if has_jet_show { "{root}jet_entry_error_exit({root}jet_entry_error_text_show(&{error}))" }
            else { "{root}jet_entry_error_exit({error})" }
        }
        helper :: if service { if is_jet_err { "jet_service_edge_report_jet" } else { "jet_service_edge_report" } }
        else if is_jet_err { "jet_entry_error_exit_jet" } else { "jet_entry_error_exit" }
        if helper.ends_with("_jet") { "{root}{helper}({error})" }
        else if error_ty.is_none() { "{root}{helper}(\"entry returned no value\".to_string())" }
        else if has_jet_show { "{root}{helper}({root}jet_entry_error_text_show(&{error}))" }
        else { "{root}{helper}(format!(\"{{:?}}\", {error}))" }
    }
