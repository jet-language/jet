        // Index once rather than rescanning all program jobs for each artifact ID.
        jobs := [MirJobId:USize].new()
        for (index, job) in self.program.jobs.iter().enumerate() { jobs.entry(job.id).or_insert(index) }
        for job_id in self.artifact.jobs {
            index :: jobs.get(job_id).unwrap_or_else(fn() { panic("MIR job ID {job_id:?} has no row") })
            job :: self.program.jobs[index]
            function :: self.function_row(job.function)
            if !self.module_selected(function.module_id) || !self.selected_for_target(function) { panic("MIR job {job.name:?} targets an unselected function") }
            if function.form != MirFunctionForm.TopLevel || !function.capture_params.is_empty() { panic("MIR job {job.name:?} requires a top-level non-capturing function") }
            wrapper :: "__jet_job_{job.id.0}"
            validator :: "__jet_job_validate_{job.id.0}"
            record_inputs :: self.job_record_inputs(function, job)
            if job.inputs.is_empty() {
                out.push_str("fn {validator}(__argv: &[String]) -> Result<(), String> {{ if __argv.is_empty() {{ Ok(()) }} else {{ Err(\"job takes no arguments\".to_string()) }} }}\n")
            } else {
                validator_spec :: self.cli_spec_expr(job.inputs, Some(job.name), false, None, "\"job\"")
                out.push_str("fn {validator}(__argv: &[String]) -> Result<(), String> {{ let mut __job_argv = vec![\"job\".to_string()]; __job_argv.extend_from_slice(__argv); let __spec = {validator_spec}; match {root}jet_args_parse(&__spec, &__job_argv) {{ Ok(_) => Ok(()), Err(__e) => Err(__e) }} }}\n")
            }
            out.push_str("fn {wrapper}(__program: &str, __argv: &[String]) {{\n")
            if job.inputs.is_empty() {
                if !function.params.is_empty() { panic("MIR job {job.name:?} has parameters but no checked input rows") }
                call :: "{self.function_name(function.id)}()"
                out.push_str(self.entry_invoke(function, call, MirEntryOutput.None, false, false, "    "))
            } else {
                spec :: self.cli_spec_expr(job.inputs, Some(job.name), false, None, "__program")
                out.push_str("    let mut __job_argv = vec![__program.to_string()];\n    __job_argv.extend_from_slice(__argv);\n    let __spec = {spec};\n")
                out.push_str("    match {root}jet_args_parse(&__spec, &__job_argv) {{\n        Ok(__parsed) => {{\n")
                out.push_str("            if {root}jet_parsed_flag(&__parsed, &\"help\".to_string()) {{ print!(\"{{}}\", {root}jet_cli_banner(&__spec.help())); return; }}\n")
                out.push_str(self.cli_decode_and_invoke(function, job.inputs, record_inputs, None, MirEntryOutput.None, false, false, "            "))
                out.push_str("        }}\n        Err(__e) => {{ eprint!(\"{{}}\", {root}jet_cli_banner(&__e)); std::process::exit(2); }}\n    }}\n")
            }
            out.push_str("}\n\n")
            if function.params.len() == 1 && (record_inputs || job.inputs.len() == 1) {
                queue_wrapper :: "__jet_job_queue_{job.id.0}"
                param :: function.params[0]
                payload_rust :: self.rust_type(param.ty)
                // Decoded owned local uses the same checked parameter convention.
                (binding, argument) :: if param.access == {
                    .Write -> ("let mut __value", "&mut __value")
                    .Read if self.parameter_borrowed(param) -> ("let __value", "&__value")
                    .Read | .Move -> ("let __value", "__value")
                }
                result_encoding :: if function.return_type.is_unit() {
                    "    {self.function_name(function.id)}({argument});\nOk({root}JetJobResult {{ type_id: \"Unit\".to_string(), bytes: Vec::new(), publish: false }})\n"
                } else {
                    if function.return_type.kind() == {
                        .Result(ok, _) -> {
                            ok_type :: ok.display_name()
                            "    let __job_result = {self.function_name(function.id)}({argument});\nmatch __job_result {{\nOk(__ok) => {{\nlet __bytes = match {root}jet_enc_cbor_to_bytes_canonical(&__ok) {{\nOk(__bytes) => __bytes,\nErr(__error) => return Err({root}JetJobError {{ type_id: __payload.type_id.clone(), reason: \"encode\".to_string(), detail: Some(format!(\"{{:?}}\", __error)) }}),\n}};\nOk({root}JetJobResult {{ type_id: {ok_type:?}.to_string(), bytes: __bytes, publish: false }})\n}}\n}}\n"
                        }
                        _ -> {
                            result_type :: function.return_type.display_name()
                            "    let __job_result = {self.function_name(function.id)}({argument});\nlet __bytes = match {root}jet_enc_cbor_to_bytes_canonical(&__job_result) {{\nOk(__bytes) => __bytes,\nErr(__error) => return Err({root}JetJobError {{ type_id: __payload.type_id.clone(), reason: \"encode\".to_string(), detail: Some(format!(\"{{:?}}\", __error)) }}),\n}};\nOk({root}JetJobResult {{ type_id: {result_type:?}.to_string(), bytes: __bytes, publish: false }})\n"
                        }
                    }
                }
                out.push_str("fn {queue_wrapper}(__payload: &{root}JetJobPayload) -> Result<{root}JetJobResult, {root}JetJobError> {{\n")
                out.push_str("    let __bytes = __payload.bytes.clone();\n    {binding} = match {root}jet_enc_cbor_decode::<{payload_rust}>(&__bytes, {root}jet_std::CBOROptions::safe()) {{ Ok(__value) => __value, Err(__error) => return Err({root}JetJobError {{ type_id: __payload.type_id.clone(), reason: \"decode\".to_string(), detail: Some(format!(\"{{:?}}\", __error)) }}), }};\n")
                out.push_str(result_encoding)
                out.push_str("}\n\n")
            }
        }
        out.push_str("static __JET_JOB_SPECS: &[{root}JetJobSpec] = &[\n")
        for job_id in self.artifact.jobs {
            index :: jobs.get(job_id).unwrap_or_else(fn() { panic("MIR job ID {job_id:?} has no row") })
            job :: self.program.jobs[index]
            function :: self.function_row(job.function)
            scope :: if job.scope == { .Dev -> "{root}JetJobScope::Dev" .Ship -> "{root}JetJobScope::Ship" .Internal -> "{root}JetJobScope::Internal" }
            schedule :: if job.schedule == {
                .None -> "None"
                .Some(.Duration(nanos)) -> "Some({root}JetJobSchedule::Duration {{ nanos: {nanos} }})"
                .Some(.WallClockTime(hour, minute)) -> "Some({root}JetJobSchedule::WallClockTime {{ hour: {hour}, minute: {minute} }})"
            }
            dispatch :: if job.dispatch == { .Direct -> "{root}JetJobDispatch::Direct" .Spawn -> "{root}JetJobDispatch::Spawn" .Scheduled -> "{root}JetJobDispatch::Scheduled" }
            skip :: if job.skip == {
                .None -> "None"
                .Some(.Always(reason)) -> "Some({root}JetJobSkip::Always({reason:?}))"
                .Some(.UnlessPlatform(platform)) -> "Some({root}JetJobSkip::UnlessPlatform({platform:?}))"
            }
            cache :: if job.cache == { .Uncached -> "{root}JetJobCachePolicy::Uncached" .Local -> "{root}JetJobCachePolicy::Local" .Shared -> "{root}JetJobCachePolicy::Shared" }
            packages :: "&[{job.packages.iter().map(fn(package) { quote_rust_string(package) }).collect[[String]]().join(", ")}]"
            input_paths :: "&[{job.input_paths.iter().map(fn(path) { quote_rust_string(path) }).collect[[String]]().join(", ")}]"
            output_paths :: "&[{job.output_paths.iter().map(fn(path) { quote_rust_string(path) }).collect[[String]]().join(", ")}]"
            limits :: "&[{job.limits.iter().map(fn((name, value)) { "({name:?}, {value:?})" }).collect[[String]]().join(", ")}]"
            after :: "&[{job.after.iter().map(fn(dependency) { quote_rust_string(dependency) }).collect[[String]]().join(", ")}]"
            working_directory :: job.working_directory.map(fn(directory) { "Some({directory:?})" }).unwrap_or("None")
            record_inputs :: self.job_record_inputs(function, job)
            queue_enabled :: function.params.len() == 1 && (record_inputs || job.inputs.len() == 1)
            payload_type :: if queue_enabled {
                payload :: if record_inputs { function.params[0].ty } else { job.inputs[0].ty }
                payload.nominal_name().map(fn(name) { "Some({name:?})" }).unwrap_or("None")
            } else { "None" }
            // Rust: crates/jet-codegen/src/Codegen/MIRRust.rs:12609
            queue_invoke :: if queue_enabled { "Some(__jet_job_queue_{job.id.0})" } else { "None" }
            out.push_str("        {root}JetJobSpec {{ entry: {root}JetJobEntry {{ name: {job.name:?}, scope: {scope}, schedule: {schedule}, invoke: __jet_job_{job.id.0} }}, payload_type: {payload_type}, queue_invoke: {queue_invoke}, dispatch: {dispatch}, packages: {packages}, working_directory: {working_directory}, input_paths: {input_paths}, output_paths: {output_paths}, skip: {skip}, cache: {cache}, limits: {limits}, after: {after}, parallel: {job.parallel.max(1)}, validate: Some(__jet_job_validate_{job.id.0}) }},\n")
        }
        out.push_str("];\nfn __jet_job_dispatch(__argv: &[String], __service: bool) -> bool {\n    let __jobs = __JET_JOB_SPECS;\n")
        if self.artifact.runtime_parts.contains(MirRuntimePartId.Services) {
            out.push_str("    let __job_service_endpoint = match {root}jet_services_active_execution_endpoint_if_present() {{\n        Ok(__endpoint) => Ok(__endpoint),\n        Err(__error) => Err(format!(\"{{__error:?}}\")),\n    }};\n    let __job_scope = move || -> Result<Option<{root}JetServiceExecutionScope>, String> {{\n        match &__job_service_endpoint {{\n            Ok(Some(__endpoint)) => {root}jet_services_execution_scope(__endpoint)\n                .map(Some)\n                .map_err(|__error| format!(\"{{__error:?}}\")),\n            Ok(None) => Ok(None),\n            Err(__reason) => Err(__reason.clone()),\n        }}\n    }};\n    if {root}jet_job_dispatch_specs(__argv, __jobs, __job_scope.clone()) {{ return true; }}\n    if __service {{\n        {root}jet_job_service_tick_specs_retained(\n            __jobs,\n            __argv.first().map(String::as_str).unwrap_or(\"program\"),\n            __job_scope,\n        );\n    }}\n    false\n}}\n")
        } else {
            out.push_str("    if {root}jet_job_dispatch_specs(__argv, __jobs, {root}jet_job_no_scope) {{ return true; }}\n    if __service {{\n        {root}jet_job_service_tick_specs_retained(\n            __jobs,\n            __argv.first().map(String::as_str).unwrap_or(\"program\"),\n            {root}jet_job_no_scope,\n        );\n    }}\n    false\n}}\n")
        }
    }
}
