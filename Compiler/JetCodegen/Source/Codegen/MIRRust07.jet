    fn emit_cli_input_metadata(self, input: &MirCliInput, out: &String) -> Unit {
        shape :: if input.shape == {
            .Flag -> "flag"
            .Value(kind, optional, default) -> "value:{kind:?}:optional={optional}:default={default:?}"
        }
        out.push_str("// jet-mir-cli-input: parameter={input.parameter} name={input.name} label={input.label} type={self.rust_type(input.ty)} zone={input.zone:?} short={input.short:?} env={input.env:?} metavar={input.metavar:?} positional={input.positional:?} variadic={input.variadic} shape={shape}\n")
    }
    // Rust: crates/jet-codegen/src/Codegen/MIRRust.rs:10867
    fn cli_value_kind(self, kind: MirCliValueKind) -> String {
        if kind == { .Bool | .String | .Path -> "String" .Int -> "Int" .Float -> "Float" }
    }
    // Rust: crates/jet-codegen/src/Codegen/MIRRust.rs:10875
    fn cli_default_expr(self, default: MirCliDefault?, ty: &MirType) -> String {
        if default == {
            .None -> "None"
            .Some(.TypeDefault) -> "Some((Default::default() as {self.rust_type(ty)}).jet_show())"
            .Some(.Value(value)) -> "Some(({self.constant_for_type(value, ty)}).jet_show())"
        }
    }
    // Rust: crates/jet-codegen/src/Codegen/MIRRust.rs:10890
    fn cli_spec_expr(self, inputs: &[MirCliInput], description: String?, standard: Bool, version: String?, program: &String) -> String {
        root :: self.config.root_prefix
        spec := "{root}jet_args_program({root}jet_args_spec(), {program})"
        if description == .Some(description) { spec = "{root}jet_args_description({spec}, &{quote_rust_string(description)}.to_string())" }
        if standard {
            spec = "{root}jet_args_flag_short({spec}, &\"verbose\".to_string(), &\"v\".to_string(), &\"print extra detail\".to_string())"
            spec = "{root}jet_args_flag_short({spec}, &\"quiet\".to_string(), &\"q\".to_string(), &\"suppress normal output\".to_string())"
            spec = "{root}jet_args_option_choice({spec}, &\"color\".to_string(), &\"control terminal color\".to_string(), &\"MODE\".to_string(), &\"auto,always,never\".to_string())"
            if version == .Some(version) { spec = "{root}jet_args_version({spec}, &{quote_rust_string(version)}.to_string())" }
        }
        for input in inputs {
            if input.name.is_empty() || input.help.is_empty() { panic("MIR CLI input has no canonical name/help") }
            name :: quote_rust_string(input.name)
            help :: quote_rust_string(input.help)
            if input.shape == {
                .Flag -> {
                    if !input.ty.is_bool() || input.variadic { panic("MIR CLI flag row is not a non-variadic Bool") }
                    spec = if input.short == {
                        .Some(short) -> "{root}jet_args_flag_short({spec}, &{name}.to_string(), &{quote_rust_string(short)}.to_string(), &{help}.to_string())"
                        .None -> "{root}jet_args_flag({spec}, &{name}.to_string(), &{help}.to_string())"
                    }
                }
                .Value(kind, optional, default) -> {
                    metavar :: quote_rust_string(input.metavar.unwrap_or("VALUE"))
                    default_expr :: self.cli_default_expr(default, input.ty)
                    required :: !optional && default_expr == "None" && input.positional.is_none()
                    value_kind :: self.cli_value_kind(kind)
                    short :: input.short.map(fn(short) { "Some({quote_rust_string(short)}.to_string())" }).unwrap_or("None")
                    env :: input.env.map(fn(env) { "Some({quote_rust_string(env)}.to_string())" }).unwrap_or("None")
                    spec = "{root}jet_args_option_base({spec}, &{name}.to_string(), {short}, &{help}.to_string(), &{metavar}.to_string(), {default_expr}, {env}, {required}, {input.variadic}, {root}JetArgValueKind::{value_kind})"
                    if input.positional.is_some() { spec = "{root}jet_args_positional({spec}, &{name}.to_string(), &{help}.to_string())" }
                }
            }
        }
        spec
    }
