// Rust: crates/jet-codegen/src/Codegen/TIR/mod.rs:4436
pub fn lower_checked_tir_program_for(bundle: &ProgramBundle, request: MirArtifactRequest) -> TirProgram LowerError! {
    lower_checked_tir_program_for_with_debug(bundle, request, false)!
}
// Rust: crates/jet-codegen/src/Codegen/TIR/mod.rs:4444
pub fn lower_checked_tir_program_for_with_debug(bundle: &ProgramBundle, request: MirArtifactRequest, debug_linemap: Bool) -> TirProgram LowerError! {
    // GATE #4494 canonical compiler-worker stack substrate.
    if CompilerStack.on_compiler_worker() -> return lower_checked_tir_program_on_stack(bundle, request, debug_linemap)!
    CompilerStack.run_on_compiler_stack(fn() { lower_checked_tir_program_on_stack(bundle, request, debug_linemap)! })!
}

// Rust: crates/jet-codegen/src/Codegen/TIR/mod.rs:4472
fn nominal_identity_projection(bundle: &ProgramBundle) -> [String:String] {
    claims := [String:Set<String>]{}
    scoped := [(String, String):String]{}
    entry_names :: bundle.modules.get(bundle.entry).map(fn(module) { Set<String>.from(module_owned_type_names(module.items).iter().filter(fn(name) { bundle.name_ledger.declaration(bundle.entry, name).is_some() })) }) ?? Set<String>{}
    loop (module_idx, module) in bundle.modules.iter().enumerate() {
        spellings := [String]{}
        if module_idx != bundle.entry { spellings.extend(module_owned_type_names(module.items)) }
        loop import in module.imports {
            alias :: import.import_alias()
            if nominal_import_target(bundle, module_idx, import) == Val(target) { spellings.extend(module_owned_type_names(bundle.modules[target].items).iter().map(fn(leaf) { "{alias}.{leaf}" })) }
        }
        loop spelling in spellings {
            if !spelling.contains('.') && entry_names.contains(spelling) -> continue
            if canonical_nominal_from(bundle, module_idx, spelling) == Val(identity) {
                scoped.insert((module_identity(bundle, module_idx), spelling), identity.clone())
                claims.entry(spelling).or_default().insert(identity)
            }
        }
    }
    unique := [String:String]{}
    loop (spelling, identities) in claims {
        if identities.len() == 1 { unique.insert(spelling, identities.iter().next() ?? panic("single nominal identity")) }
    }
    loop ((module, spelling), identity) in scoped { unique.insert("{module}::{spelling}", identity) }
    unique
}

// Rust: crates/jet-codegen/src/Codegen/TIR/mod.rs:4541
fn selected_imported_zero_arg_tir_entry(bundle: &ProgramBundle) -> String? {
    if bundle.modules.get(bundle.entry) == Val(module) {
        return module.items.iter().find_map(fn(item) {
            if item == .Const(value) {
                if value.resolved_output == Val(output) {
                    if !output.selected || output.module == bundle.entry || !output.params.is_empty() || (output.kind != OutputKind.Executable && output.kind != OutputKind.Service) -> return None
                    owner :: artifact_plan.module_identity(bundle, output.module)
                    return Val(function_semantic_key(owner, output.semantic_name))
                }
            }
            None
        })
    }
    None
}
// Rust: crates/jet-codegen/src/Codegen/TIR/mod.rs:4562
fn selected_test_override_tir_entry(bundle: &ProgramBundle, request: &MirArtifactRequest) -> String? {
    if request.kind != MirArtifactKind.TestOverride || request.mode != MirArtifactBuildMode.Test -> return None
    if bundle.modules.get(bundle.entry) == Val(module) {
        if module.items.iter().any(fn(item) { if item == .Func(function) -> function.name == "test" else -> false }) -> return Val(function_semantic_key(artifact_plan.module_identity(bundle, bundle.entry), "test"))
    }
    None
}
// Rust: crates/jet-codegen/src/Codegen/TIR/mod.rs:4585
fn selected_zero_arg_tir_entry(bundle: &ProgramBundle) -> String? {
    if bundle.modules.get(bundle.entry) == Val(module) {
        entry_module :: artifact_plan.module_identity(bundle, bundle.entry)
        return selected_imported_zero_arg_tir_entry(bundle).or_else(fn() {
            module.items.iter().find_map(fn(item) {
                if item == .Const(value) {
                    if value.resolved_output == Val(output) {
                        if output.selected && output.module == bundle.entry && output.params.is_empty() -> return Val(function_semantic_key(entry_module, output.semantic_name))
                    }
                }
                None
            })
        }).or_else(fn() { module.items.iter().find_map(fn(item) { if item == .Func(function) { if function.name == "run" && function.params.is_empty() -> return Val(function_semantic_key(entry_module, "run")) }; None }) })
    }
    None
}

// Rust: crates/jet-codegen/src/Codegen/TIR/mod.rs:4607
fn lower_test_item(test: &TestDef, module: &String, cx: &Cx) -> TFunc {
    test_name :: test.name ?? "anonymous"
    synthetic := Func.implicit_run(test.body.clone(), test.span)
    synthetic.name = "__test_{test_name}"
    synthetic.name_span = test.name_span
    synthetic.params = test.params.clone()
    synthetic.compiler_generated = true
    lowered := lower_func(synthetic, cx)
    key :: artifact_plan.test_key(module, test)
    lowered.module = module.clone(); lowered.key = key.clone(); lowered.name = key
    lowered.source_span = test.span; lowered.synthetic = true
    lowered
}

// Rust: crates/jet-codegen/src/Codegen/TIR/mod.rs:4625
fn lower_contract_test_item(function: &Func, module: &String, cx: &Cx, target_name: &String) -> TFunc {
    key :: artifact_plan.contract_key(module, function)
    call_args :: loop param in function.params -> CallArg{convention: param.convention, expr: Expr.Ident(param.name.clone(), param.name_span), span: param.name_span, flags: CallArgFlags.default(), label: param.public_label.clone(), spread: param.variadic}
    call :: Expr.Call(Call{name: target_name.clone(), name_span: function.name_span, type_args: [], args: call_args, resolved_ret: None, range_checked: false, widen_approx: false})
    synthetic := function.clone()
    synthetic.name = "__contract_{function.name}"
    synthetic.name_span = function.name_span
    synthetic.pre.clear(); synthetic.post.clear()
    synthetic.body = [Stmt.Return(Val(call), function.span)]
    synthetic.compiler_generated = true
    lowered := lower_func(synthetic, cx)
    lowered.module = module.clone(); lowered.key = key.clone(); lowered.name = key
    lowered.source_span = function.span; lowered.synthetic = true
    lowered
}

// Rust: crates/jet-codegen/src/Codegen/TIR/mod.rs:4675
// Eligibility executes only checked preconditions, borrowing all candidate parameters.
fn lower_contract_eligibility_item(function: &Func, module: &String, cx: &Cx) -> TFunc {
    key :: artifact_plan.contract_eligibility_key(module, function)
    condition :: function.pre.iter().map(fn(clause) { clause.cond.clone() }).reduce(fn(lhs, rhs) { Expr.Binary(BinOp.And, lhs, rhs, function.span) }) ?? panic("a sampled contract candidate has at least one #Pre clause")
    synthetic := function.clone()
    synthetic.name = "__contract_pre_{function.name}"
    synthetic.name_span = function.name_span
    synthetic.pre.clear(); synthetic.post.clear()
    loop param in &synthetic.params { param.convention = AccessConvention.Read }
    synthetic.return_type = Val(Type.Named(Syntax.TYPE_BOOL))
    synthetic.return_type_span = None
    synthetic.return_view_provenance = None
    synthetic.declared_return_view_provenance = None
    synthetic.gc_return = false; synthetic.diverges = false
    synthetic.body = [Stmt.Return(Val(condition), function.span)]
    synthetic.compiler_generated = true
    lowered := lower_func(synthetic, cx)
    lowered.module = module.clone(); lowered.key = key.clone(); lowered.name = key
    lowered.source_span = function.span; lowered.synthetic = true
    lowered
}

// Rust: crates/jet-codegen/src/Codegen/TIR/mod.rs:4723
// Unavailable sampling rows deliberately resolve to this real, never-invoked callable.
fn lower_contract_unavailable_item(function: &Func, module: &String, cx: &Cx) -> TFunc {
    key :: artifact_plan.contract_key(module, function)
    synthetic := Func.implicit_run([], function.span)
    synthetic.name = "__contract_unavailable_{function.name}"
    synthetic.name_span = function.name_span; synthetic.compiler_generated = true
    lowered := lower_func(synthetic, cx)
    lowered.module = module.clone(); lowered.key = key.clone(); lowered.name = key
    lowered.source_span = function.span; lowered.synthetic = true
    lowered
}

// Rust: crates/jet-codegen/src/Codegen/TIR/mod.rs:4746
fn materialize_contract_sampling(function: &Func, module: &String, covered: Bool, target_name: &String, cx: &Cx, funcs: &[TFunc], contract_rows: &artifact_plan.ContractSamplingPlan) {
    if artifact_plan.contract_sampling_reason(function, covered) == Val(reason) {
        if reason == None {
            funcs.push(lower_contract_eligibility_item(function, module, cx))
            funcs.push(lower_contract_test_item(function, module, cx, target_name))
        } else { funcs.push(lower_contract_unavailable_item(function, module, cx)) }
        contract_rows.insert(artifact_plan.contract_key(module, function), reason)
    }
}

// Rust: crates/jet-codegen/src/Codegen/TIR/mod.rs:4772
fn record_web_partition_key(function: &Func, callable_name: &String, source_file: &String, file_alias: &String, is_entry: Bool, module_prefix: &String?, out: &[(String, USize, USize):String]) {
    file_prefix :: if !is_entry && module_prefix.is_none() -> Val(file_alias) else -> None
    key :: WebPartition.partition_key(file_prefix, module_prefix, callable_name)
    out.insert((source_file.clone(), function.span.start, function.span.end), key)
}

// Rust: crates/jet-codegen/src/Codegen/TIR/mod.rs:4794
fn collect_web_partition_keys(items: &[Item], source_file: &String, file_alias: &String, is_entry: Bool, module_prefix: &String?, out: &[(String, USize, USize):String]) {
    loop item in items {
        if item == {
            .Func(function) -> record_web_partition_key(function, function.name, source_file, file_alias, is_entry, module_prefix, &out)
            .Struct(structure) -> {
                loop method in structure.methods { record_web_partition_key(method, "{structure.name}::{method.name}", source_file, file_alias, is_entry, module_prefix, &out) }
                loop implementation in structure.trait_impls { loop method in implementation.methods { record_web_partition_key(method, "{structure.name}::{method.name}", source_file, file_alias, is_entry, module_prefix, &out) } }
            }
            .Enum(enumeration) -> {
                loop method in enumeration.methods { record_web_partition_key(method, "{enumeration.name}::{method.name}", source_file, file_alias, is_entry, module_prefix, &out) }
                loop implementation in enumeration.trait_impls { loop method in implementation.methods { record_web_partition_key(method, "{enumeration.name}::{method.name}", source_file, file_alias, is_entry, module_prefix, &out) } }
            }
            .Impl(implementation) -> { loop method in implementation.methods { record_web_partition_key(method, "{implementation.type_name}::{method.name}", source_file, file_alias, is_entry, module_prefix, &out) } }
            .CodeModule(module) -> { if module.body == Val(body) { collect_web_partition_keys(body, source_file, file_alias, is_entry, Val(module.name), &out) } }
            else -> {}
        }
    }
}

// Rust: crates/jet-codegen/src/Codegen/TIR/mod.rs:4900
fn apply_checked_web_partitions(bundle: &ProgramBundle, funcs: &[TFunc]) {
    source_rows := [(String, USize, USize):String]{}
    loop (module_idx, module) in bundle.modules.iter().enumerate() { collect_web_partition_keys(module.items, module.display, module.alias, module_idx == bundle.entry, None, &source_rows) }
    loop function in &funcs {
        if function.web_bucket.is_some() -> continue
        source_key :: (function.source_file.clone(), function.source_span.start, function.source_span.end)
        bucket :: source_rows.get(source_key).and_then(fn(key) { bundle.web_partitions.get(key) }).or_else(fn() { bundle.web_partitions.get(function.name) }).or_else(fn() { bundle.web_partitions.get(function.key) }).or_else(fn() { Val(Sema.checked_web_bucket(function.web_marker, None, function.effects.solved, function.ret)) })
        if bucket.is_some() { function.web_bucket = bucket }
    }
}

// Rust: crates/jet-codegen/src/Codegen/TIR/mod.rs:4946
fn child_module_identity(module: &String, child: &String) -> String {
    if module.is_empty() -> child.clone() else -> "{module}::{child}"
}

// Rust: crates/jet-codegen/src/Codegen/TIR/mod.rs:4960
fn collect_http_route_handlers(items: &[Item], out: &Set<String>) {
    // Rust: crates/jet-codegen/src/Codegen/TIR/mod.rs:4961
    fn collect_body(body: &[Stmt], out: &Set<String>) {
        loop statement in body {
            statement.for_each_expr(fn(expr) {
                if expr == .MethodCall{recv_type: Val(recv_type), method: method, args: args, ..} {
                    if (recv_type != "HTTPRouter" && recv_type != "HTTPMux") || !["get", "post", "put", "delete", "patch", "head", "options"].contains(method) || args.len() != 2 -> return
                    handler := args[1].expr
                    loop {
                        if handler == .Paren(inner, _) { handler = inner } else -> break
                    }
                    if handler == .Ident(name, _) { out.insert(name.clone()) }
                }
            })
        }
    }
    loop item in items {
        if item == {
            .Func(function) -> collect_body(function.body, &out)
            .Struct(definition) -> {
                loop method in definition.methods { collect_body(method.body, &out) }
                loop implementation in definition.trait_impls { loop method in implementation.methods { collect_body(method.body, &out) } }
            }
            .Enum(definition) -> {
                loop method in definition.methods { collect_body(method.body, &out) }
                loop implementation in definition.trait_impls { loop method in implementation.methods { collect_body(method.body, &out) } }
            }
            .Impl(implementation) -> { loop method in implementation.methods { collect_body(method.body, &out) } }
            .CodeModule(module) -> { if module.body == Val(body) { collect_http_route_handlers(body, &out) } }
            else -> {}
        }
    }
}
