//RS         .collect();
//RS     cx.core_imports = source.core_imports.clone();
//RS     for (alias, module) in &source.core_imports {
//RS         if let Some(loaded) = facts.core_source_bodies.get(module) {
//RS             cx.import_mods.insert(alias.clone(), mangle(&loaded.alias));
//RS         }
//RS     }
//RS     if user_module {
//RS         install_fragment_module_imports(
//RS             &mut cx,
//RS             facts,
//RS             &source.module_imports,
//RS             &source.imported_functions,
//RS             &source.import_signatures,
