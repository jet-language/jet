use jet_foundation.AST.[Expr, Stmt, Item, Type, Func, TestDef, EnumDef, StructDef, DistinctDef, ImplDef, Variant, VariantPayload, Field, AccessConvention, ParamZone, OutputKind, Call, CallArg, CallArgFlags, BinOp]
use jet_foundation.Diagnostics.Span
use jet_foundation.MIR.[MirProgram, MirFunctionId, MirArtifactRequest, MirArtifactKind, MirArtifactBuildMode, MirOptimizationPolicy, optimize_mir_program]
use jet_foundation.[CompilerStack, CoreModuleExports, WebPartition, Authority]
use jet_codegen.Codegen.Context.[Cx, ProgramBundle, build_cx_items, module_identity]
use jet_codegen.Comptime.MirBridge.[MirFragmentNominalFacts, MirFragmentCoreSourceModule, MirFragmentCoreSourceSignature]
use jet_codegen.Codegen.TIR.[TExpr, TExprKind, TLocal, TStmt, TFunc, TFuncKind, TFailureCarrier, TEffectFacts, TTargetApplicability, TVisibility, TirProgram, TirDeclarations, TirPackageFacts, LowerError, function_semantic_key, generic_free_function_instance_key]
use jet_codegen.Codegen.TIR.Lower.[LowerEnv, lower_func, lower_method, lower_trait_method, lower_expr, lower_stmts, nominal_import_target]
use jet_codegen.Codegen.TIR.[artifact_plan, tir_to_mir_types, opt]
use jet_codegen.Codegen.TIR.[MirFragmentContext, FragmentCallable, lift_receiver_mark, lift_body_receiver_marks, lift_func_receiver_marks, fragment_callable_closure, fragment_host_field_type, fragment_declared_variants, for_each_item_body, normalize_fragment_body_patterns, annotate_fragment_module_calls, fragment_declaration_items, lower_declarations_from_items_with_boxed_edges, lower_demanded_generic_methods, specialize_generic_free_functions, merge_core_source_generic_calls, lower_core_source_generic_template, tir_core_call_records, lower_tir_to_mir, lower_checked_tir_program_on_stack, module_owned_type_names, canonical_nominal_from]
use jet_codegen.Codegen.[mangle, tuple_struct_name, is_json_type_name, CoreSourceFunctionSignature]
use jet_codegen.[Syntax, Sema, Generics, Facts, Names]

// Rust: crates/jet-codegen/src/Codegen/TIR/mod.rs:3241
fn lower_mir_fragment(input_expr: &Expr, input_stmts: &[Stmt], context: &MirFragmentContext) -> (MirProgram, MirFunctionId) LowerError! {
    expr := input_expr.clone()
    expr.for_each_expr_mut(lift_receiver_mark)
    stmts := input_stmts.clone()
    lift_body_receiver_marks(&stmts)
    module :: "__comptime"
    name :: "__fragment"
    file :: module.clone()
    span :: if stmts.is_empty() -> expr.span() else -> stmts.first().map(fn(stmt) { stmt.span() }) ?? Span.new(0, 0)
    free_reads := None
    missing_capture := None
    check_captures :: fn(candidate: &Expr) {
        if missing_capture.is_some() -> return
        if candidate == .Lambda(lambda) {
            captures :: lambda.meta.cloned_captures.iter().chain(lambda.meta.moved_captures.iter()).chain(lambda.meta.mut_captures.iter()).chain(lambda.take_names.iter().map(fn(pair) { pair.0 }))
            loop capture in captures {
                if free_reads.is_none() {
                    (reads, calls) := if stmts.is_empty() -> Sema.expr_free_reads_and_calls(expr) else -> Sema.block_free_reads_and_calls(stmts)
                    reads.extend(calls)
                    free_reads = Val(reads)
                }
                if (free_reads ?? panic("fragment free reads were initialized")).contains(capture) && !context.binding_types.contains_key(capture) {
                    missing_capture = Val(LowerError.new(candidate.span(), "capture `{capture}` has no value in the compile-time environment"))
                    break
                }
            }
        }
    }
    expr.for_each_expr(check_captures)
    loop stmt in stmts { stmt.for_each_expr(check_captures) }
    if missing_capture == Val(error) -> fail error
    reachable :: fragment_callable_closure(expr, stmts, context)
    items := [Item]{}
    loop (function_name, function) in context.funcs {
        if reachable.contains(FragmentCallable.Function(function_name)) { items.push(Item.Func(function.clone())) }
    }
    loop structure in context.structs.values() {
        structure := structure.clone()
        structure.derives.clear()
        items.push(Item.Struct(structure))
    }
    if context.checked_nominals == Val(facts) {
        loop (identity, source_structure) in facts.structs {
            if context.structs.contains_key(identity) -> continue
            structure := source_structure.clone()
            structure.derives.clear()
            items.push(Item.Struct(structure))
        }
        items.extend(facts.enums.values().map(fn(value) { Item.Enum(value.clone()) }))
    }
    // Ordered config-surface declaration seeding, excluding retained checked nominals.
    enum_variants := [String:Set<String>]{}
    struct_fields := [String:Set<String>]{}
    skip_named :: fn(name: &String) -> Bool {
        context.structs.contains_key(name) || context.checked_nominals.is_some_and(fn(facts) {
            facts.structs.contains_key(name) || facts.enums.contains_key(name) || facts.nominal_identities.get(name).is_some_and(fn(identity) { facts.structs.contains_key(identity) || facts.enums.contains_key(identity) })
        }) || jet_foundation.AST.numeric_type_from_name(name).is_some() || is_json_type_name(name) || tir_to_mir_types.is_compiler_owned_type(name)
    }
    collect :: fn(candidate: &Expr) {
        if candidate == {
            .Field(.Ident(name, _), member, _) -> {
                if skip_named(name) -> return
                if name.chars().next().is_some_and(fn(c) { c.is_uppercase() }) && member.chars().next().is_some_and(fn(c) { c.is_uppercase() }) {
                    enum_variants.entry(name).or_default().insert(member)
                }
            }
            .EnumLit{type_name: type_name, variant: variant, ..} where !type_name.is_empty() && !skip_named(type_name) -> { enum_variants.entry(type_name).or_default().insert(variant) }
            .StructLit{type_name: type_name, fields: fields, ..} where !type_name.is_empty() && !skip_named(type_name) -> {
                entry := struct_fields.entry(type_name).or_default()
                loop (field_name, _, _) in fields { entry.insert(field_name) }
            }
            else -> {}
        }
    }
    expr.for_each_expr(collect)
    loop stmt in stmts { stmt.for_each_expr(collect) }
    struct_fields.entry(Syntax.TYPE_PROGRAM_INFO).or_default().extend(["packages", "types", "functions", "definitions", "references", "call_edges", "structural_nodes"])
    struct_fields.entry(Syntax.TYPE_TYPE_INFO).or_default().extend(["name", "path", "layout", "span", "fields", "methods", "type_params", "markers", "expanded_markers", "states", "transitions", "facts", "dimensions", "implements", "trait_contracts"])
    struct_fields.entry(Syntax.TYPE_BUILD_CONTEXT).or_default().insert("program")
    empty_span :: Span.new(0, 0)
    enum_names := enum_variants.keys().collect()
    enum_names.sort()
    loop enum_name in enum_names {
        variants := (enum_variants.get(enum_name) ?? panic("seeded enum key")).iter().collect()
        variants.sort()
        struct_fields.remove(enum_name)
        items.push(Item.Enum(EnumDef{span: empty_span, is_pub: false, is_package_pub: false, name: enum_name, name_span: empty_span, type_params: [], variants: loop variant in variants -> Variant{name: variant, name_span: empty_span, payload: VariantPayload.Unit, discriminant: None, discriminant_expr: None, serde_markers: []}, methods: [], trait_impls: [], derives: [], auto_derive_default: false, is_single_use: false, single_use_span: None, is_must_use: false, must_use_span: None, serde_markers: [], type_markers: [], groups: []}))
    }
    struct_names := struct_fields.keys().collect()
    struct_names.sort()
    loop struct_name in struct_names {
        fields := (struct_fields.get(struct_name) ?? panic("seeded struct key")).iter().collect()
        fields.sort()
        items.push(Item.Struct(StructDef{span: empty_span, is_pub: false, is_package_pub: false, name: struct_name, name_span: empty_span, type_params: [], fields: loop field_name in fields -> Field{is_pub: false, is_package_pub: false, name: field_name.clone(), name_span: empty_span, ty: fragment_host_field_type(struct_name, field_name), ty_span: empty_span, serde_markers: [], redact: false, computed: None, default: None, default_ct: None}, state: None, methods: [], cli_bindings: [], trait_impls: [], derives: [], auto_derive_default: false, is_published_schema: false, published_schema_span: None, is_single_use: false, single_use_span: None, is_must_use: false, must_use_span: None, layout: None, layout_span: None, serde_markers: [], type_markers: [], validate_block: [], validate_span: None}))
    }
    unit_family_members :: Set<String>.from(context.unit_families.iter().flat_map(fn(family) { family.distinct_defs() }).map(fn(definition) { definition.name }))
    loop (distinct_name, base) in context.distinct_bases {
        if context.structs.contains_key(distinct_name) || unit_family_members.contains(distinct_name) -> continue
        range :: context.distinct_ranges.get(distinct_name).and_then(fn(bounds) { bounds.map(fn(pair) { (pair.0, pair.1, empty_span) }) })
        items.push(Item.Distinct(DistinctDef{is_pub: false, is_package_pub: false, type_markers: [], derives: [], quantity: None, name: distinct_name, name_span: empty_span, base: base.clone(), base_span: empty_span, range: range, span: empty_span}))
    }
    loop conversion in context.error_conversions { items.push(Item.ErrorConv(conversion.clone())) }
    loop family in context.unit_families { items.push(Item.UnitFamily(family.clone())) }
    fragment_checked_text_owners :: Set<String>.from(context.distinct_bases.iter().filter(fn(pair) { pair.1 == Type.String && context.methods.contains_key((pair.0, "check")) && context.methods.contains_key((pair.0, "encode_hole")) }).map(fn(pair) { pair.0 }))
    fragment_trait_name :: fn(owner: &String, method_name: &String, method: &Func) -> String? {
        if context.method_traits.get((owner, method_name)) == Val(trait_name) -> return Val(trait_name.clone())
        if fragment_checked_text_owners.contains(owner) && (method_name == "check" || method_name == "encode_hole") && !method.params.iter().any(fn(param) { param.name == Syntax.KW_SELF }) -> return Val(Generics.CHECKED_TEXT)
        None
    }
    loop ((owner, method_name), method) in context.methods {
        if !reachable.contains(FragmentCallable.Method{owner: owner, name: method_name}) -> continue
        if method_name == "encode" || method_name == "decode" -> continue
        declared :: context.structs.get(owner).is_some_and(fn(structure) { structure.methods.iter().any(fn(candidate) { candidate.name == method_name }) || structure.trait_impls.iter().any(fn(implementation) { implementation.methods.iter().any(fn(candidate) { candidate.name == method_name }) }) })
        if declared -> continue
        trait_name :: fragment_trait_name(owner, method_name, method)
        operator_rhs :: trait_name.filter(fn(trait_name) { [Syntax.TRAIT_ADD, Syntax.TRAIT_SUB, Syntax.TRAIT_MUL, Syntax.TRAIT_DIV, Syntax.TRAIT_EQUATABLE, Syntax.TRAIT_COMPARABLE].contains(trait_name) }).and_then(fn(_) { method.params.iter().find(fn(param) { param.name != Syntax.KW_SELF }).map(fn(param) { param.ty.clone() }) })
        items.push(Item.Impl(ImplDef{span: method.span, type_name: owner, type_span: method.span, trait_name: trait_name, trait_span: None, operator_rhs: operator_rhs, operator_marker: None, methods: [method.clone()], delegation_field: None, assoc_type_impls: [], is_generated_serde: false, os_target: None}))
    }
    declared_variants :: fragment_declared_variants(items)
    loop item in &items {
        for_each_item_body(&item, fn(body) { lift_body_receiver_marks(&body); normalize_fragment_body_patterns(&body, declared_variants) })
    }
    cx := build_cx_items(items, "", file, None, [:], "2026")
    if context.checked_nominals == Val(facts) {
        cx.import_mods = facts.import_modules.iter().map(fn(pair) { (pair.0, mangle(pair.1)) }).collect()
        cx.foreign_types = facts.foreign_modules.iter().map(fn(pair) { (pair.0, mangle(pair.1)) }).collect()
        cx.core_source_sigs = facts.core_source_sigs.iter().filter_map(fn(pair) {
            (key, signature) :: pair
            facts.core_source_bodies.get(key.0).map(fn(source) { (key, CoreSourceFunctionSignature{module_identity: source.module_identity.clone(), type_params: signature.type_params.clone(), params: signature.params.clone(), return_type: signature.return_type.clone()}) })
        }).collect()
        cx.local_type_identities.extend(facts.nominal_identities.clone())
        cx.type_names.extend(facts.structs.keys())
        cx.type_names.extend(facts.enums.keys())
        install_fragment_module_imports(&cx, facts, facts.import_modules, facts.imported_functions, facts.import_signatures)
    }
    cx.module_identity = module
    cx.core_imports = context.core_imports.clone()
    loop (alias, core_module) in cx.core_imports {
        if CoreModuleExports.core_source_module(core_module) == Val(source) {
            cx.import_mods.insert(alias, mangle(source.alias))
            cx.core_source_modules.insert(core_module, source.alias)
        }
    }
    cx.const_values = context.globals.clone()
    cx.consts = cx.const_values.keys().map(fn(name) { (name, name) }).collect()
    cx.computed_fields.clear()
    loop ((owner, field), _) in context.computed_fields { cx.computed_fields.entry(owner).or_default().insert(field) }
    cx.distinct_ranges = context.distinct_ranges.iter().filter_map(fn(pair) { pair.1.map(fn(bounds) { (pair.0, bounds) }) }).collect()
    loop (distinct_name, base) in context.distinct_bases { cx.distinct_types.insert(distinct_name, (base.clone(), false)) }
    declaration_items :: fragment_declaration_items(items, reachable)
    declarations :: lower_declarations_from_items_with_boxed_edges(declaration_items, module, context.target_layout, cx.boxed_edges, cx.auto_printable, cx.auto_debug, context.checked_nominals)
    extra_funcs := [TFunc]{}
    loop (function_name, function) in context.funcs {
        if !reachable.contains(FragmentCallable.Function(function_name)) -> continue
        if !function.type_params.is_empty() || function.name == "encode" || function.name == "decode" -> continue
        function := lift_func_receiver_marks(function)
        normalize_fragment_body_patterns(&function.body, declared_variants)
        if context.checked_nominals == Val(facts) { annotate_fragment_module_calls(&function, facts.import_signatures, facts.imported_functions) }
        extra_funcs.push(lower_func(function, cx))
    }
    if context.checked_nominals == Val(facts) { lower_fragment_core_source_bodies(facts, reachable, cx, &extra_funcs)! }
    trait_method_traits := [(String, String):String]{} // GATE #4499 exact composite keys.
    loop ((owner, method_name), method) in context.methods {
        if !reachable.contains(FragmentCallable.Method{owner: owner, name: method_name}) -> continue
        if method_name == "encode" || method_name == "decode" || !method.type_params.is_empty() -> continue
        method := lift_func_receiver_marks(method)
        normalize_fragment_body_patterns(&method.body, declared_variants)
        trait_name :: fragment_trait_name(owner, method_name, method)
        lowered := if trait_name == Val(trait_name) -> {
            trait_method_traits.insert((owner, method_name), trait_name)
            operator_rhs :: if [Syntax.TRAIT_ADD, Syntax.TRAIT_SUB, Syntax.TRAIT_MUL, Syntax.TRAIT_DIV, Syntax.TRAIT_EQUATABLE, Syntax.TRAIT_COMPARABLE].contains(trait_name) -> method.params.iter().find(fn(param) { param.name != Syntax.KW_SELF }).map(fn(param) { param.ty.clone() }) else -> None
            lower_trait_method(method, owner, cx, trait_name, false, operator_rhs)
        } else -> lower_method(method, owner, cx)
        lowered.name = method_name
        extra_funcs.push(lowered)
    }
    cx.current_fn = name // GATE #4494 canonical interior lowering context cell.
    env := LowerEnv.new(name)
    names := context.binding_types.keys().collect()
    names.sort()
    params :: loop binding in names {
        ty :: context.binding_types.get(binding) ?? panic("comptime fragment binding type must be present")
        env.bind(binding, TLocal.user(binding), Val(ty.clone()))
        (binding, ty, AccessConvention.Move)
    }
    value :: if stmts.is_empty() -> lower_expr(expr, cx, &env) else -> {
        body := lower_stmts(stmts, cx, &env)
        tuple_shape :: loop (binding, ty, _) in params -> (binding.clone(), ty.clone())
        tuple_ty :: Type.Tuple(loop (binding, ty) in tuple_shape -> (binding.clone(), ty.clone()))
        fields :: loop (binding, ty) in tuple_shape -> (binding.clone(), TExpr{ty: ty.clone(), kind: TExprKind.Local(TLocal.user(binding))})
        body.push(TStmt.Return(Val(TExpr{ty: tuple_ty.clone(), kind: TExprKind.TupleLit{struct_name: tuple_struct_name(tuple_shape), fields: fields}})))
        lower_demanded_generic_methods(items, cx, &extra_funcs)!
        specialize_generic_free_functions(items, cx, &extra_funcs)
        if context.checked_nominals == Val(facts) { specialize_fragment_core_source_generics(facts, cx, &extra_funcs)! }
        return lower_mir_fragment_program(module, name, file, span, params, tuple_ty, body, extra_funcs, declarations, trait_method_traits, context)!
    }
    tuple_shape := [(String, Type)]{("value", value.ty.clone())}
    tuple_shape.extend(params.iter().map(fn(param) { (param.0.clone(), param.1.clone()) }))
    tuple_ty :: Type.Tuple(loop (binding, ty) in tuple_shape -> (binding.clone(), ty.clone()))
    fields := [(String, TExpr)]{("value", value)}
    fields.extend(params.iter().map(fn(param) { (param.0.clone(), TExpr{ty: param.1.clone(), kind: TExprKind.Local(TLocal.user(param.0))}) }))
    body :: [TStmt.Return(Val(TExpr{ty: tuple_ty.clone(), kind: TExprKind.TupleLit{struct_name: tuple_struct_name(tuple_shape), fields: fields}}))]
    lower_demanded_generic_methods(items, cx, &extra_funcs)!
    specialize_generic_free_functions(items, cx, &extra_funcs)
    if context.checked_nominals == Val(facts) { specialize_fragment_core_source_generics(facts, cx, &extra_funcs)! }
    lower_mir_fragment_program(module, name, file, span, params, tuple_ty, body, extra_funcs, declarations, trait_method_traits, context)!
}

// Rust: crates/jet-codegen/src/Codegen/TIR/mod.rs:3963
fn fragment_core_source_cx(facts: &MirFragmentNominalFacts, source: &MirFragmentCoreSourceModule, fragment_cx: &Cx) -> ([Item], Cx) {
    user_module :: CoreModuleExports.core_source_module_by_alias(source.alias).is_none()
    functions := source.functions.values().collect()
    functions.sort_by(fn(left, right) { left.name.compare(right.name) })
    items := loop function in functions {
        function := lift_func_receiver_marks(function)
        annotate_fragment_module_calls(&function, source.import_signatures, source.imported_functions)
        Item.Func(function)
    }
    items.extend(source.constants.iter().map(fn(constant) { Item.Const(constant.clone()) }))
    function_count :: items.len()
    if user_module {
        items.extend(facts.structs.values().map(fn(structure) { Item.Struct(structure.clone()) }))
        items.extend(facts.enums.values().map(fn(enumeration) { Item.Enum(enumeration.clone()) }))
    }
    cx := build_cx_items(items, "", source.module_identity, None, [:], "2026")
    loop constant in source.constants {
        if cx.const_types.get(constant.name) == Val(ty) {
            row :: tir_to_mir_types.lower_constant(constant, source.module_identity)
            cx.const_ref_keys.insert(constant.name, row.key)
            cx.const_ref_types.insert(constant.name, ty)
        }
    }
    cx.module_alias = source.alias.clone()
    cx.module_identity = source.module_identity.clone()
    cx.jit_local_call_prefix = Val("{mangle(source.alias)}::")
    cx.core_source_sigs = fragment_cx.core_source_sigs.clone()
    cx.core_source_modules = facts.core_source_bodies.iter().map(fn(pair) { (pair.0, pair.1.alias.clone()) }).collect()
    cx.core_imports = source.core_imports.clone()
    loop (alias, core_module) in source.core_imports {
        if facts.core_source_bodies.get(core_module) == Val(loaded) { cx.import_mods.insert(alias, mangle(loaded.alias)) }
    }
    if user_module {
        install_fragment_module_imports(&cx, facts, source.module_imports, source.imported_functions, source.import_signatures)
        cx.foreign_types = fragment_cx.foreign_types.clone()
        cx.local_type_identities.extend(source.nominal_identities.clone())
        cx.type_names.extend(facts.structs.keys())
        cx.type_names.extend(facts.enums.keys())
        items.truncate(function_count)
    }
    (items, cx)
}

// Rust: crates/jet-codegen/src/Codegen/TIR/mod.rs:4048
fn install_fragment_module_imports(cx: &Cx, facts: &MirFragmentNominalFacts, module_imports: &[String:String], imported_functions: &[String:(String, String)], signatures: &[(String, String):MirFragmentCoreSourceSignature]) {
    loop (alias, module) in module_imports {
        if facts.core_source_bodies.get(module) == Val(loaded) { cx.import_mods.insert(alias, mangle(loaded.alias)) }
    }
    loop (local, (module, name)) in imported_functions {
        if facts.core_source_bodies.get(module) == Val(loaded) { cx.unqualified_file.insert(local, (mangle(loaded.alias), name)) }
    }
    loop (key, signature) in signatures {
        cx.import_sigs.insert(key, signature.params.clone())
        cx.import_rets.insert(key, signature.return_type.clone())
    }
}

// Rust: crates/jet-codegen/src/Codegen/TIR/mod.rs:4079
fn lower_fragment_core_source_bodies(facts: &MirFragmentNominalFacts, reachable: &Set<FragmentCallable>, fragment_cx: &Cx, funcs: &[TFunc]) -> Unit LowerError! {
    demanded := [String:[String]]{}
    loop callable in reachable {
        if callable == .CoreSource{module: module, name: name} { demanded.entry(module).or_default().push(name) }
    }
    modules := demanded.keys().collect()
    modules.sort()
    loop module in modules {
        if facts.core_source_bodies.get(module) == Val(source) {
            names :: Set<String>.from(demanded.get(module) ?? [])
            (items, cx) :: fragment_core_source_cx(facts, source, fragment_cx)
            loop item in items {
                if item == .Func(function) {
                    if !names.contains(function.name) || !function.type_params.is_empty() || function.inline_foreign.is_some() -> continue
                    lowered := lower_func(function, cx)
                    lowered.name = "{mangle(source.alias)}::{mangle(function.name)}"
                    funcs.push(lowered)
                }
            }
            lower_demanded_generic_methods(items, cx, &funcs)!
            specialize_generic_free_functions(items, cx, &funcs)
            merge_core_source_generic_calls(fragment_cx, cx)
        }
    }
}

// Rust: crates/jet-codegen/src/Codegen/TIR/mod.rs:4124
fn specialize_fragment_core_source_generics(facts: &MirFragmentNominalFacts, fragment_cx: &Cx, funcs: &[TFunc]) -> Unit LowerError! {
    loop {
        calls :: &fragment_cx.jit_core_source_generic_calls.take() // GATE #4494 context interior cell, no Rust bridge.
        if calls.is_empty() -> return
        loop ((owner, method), instantiations) in calls {
            instantiations := instantiations
            instantiations.sort_by_key(fn(types) { "{types:?}" })
            instantiations.dedup()
            missing_target :: fn() -> LowerError { LowerError.new(Span.new(0, 0), "checked Core source generic target `{owner}::{method}` has no loaded template") }
            source :: facts.core_source_bodies.values().find(fn(source) { source.module_identity == owner }) ?? fail missing_target()
            template :: source.functions.get(method).filter(fn(template) { !template.type_params.is_empty() }) ?? fail missing_target()
            (items, cx) :: fragment_core_source_cx(facts, source, fragment_cx)
            loop type_args in instantiations {
                if type_args.len() != template.type_params.len() -> fail LowerError.new(template.span, "checked Core source generic target `{owner}::{method}` has inconsistent type parameters")
                emitted_name :: generic_free_function_instance_key(method, type_args)
                emitted_key :: function_semantic_key(owner, emitted_name)
                if funcs.iter().any(fn(function) { function.key == emitted_key }) -> continue
                (_, lowered) := lower_core_source_generic_template(lift_func_receiver_marks(template), type_args, emitted_name, cx)
                lowered.key = emitted_key
                lowered.name = "{mangle(source.alias)}::{mangle(emitted_name)}"
                funcs.push(lowered)
            }
            lower_demanded_generic_methods(items, cx, &funcs)!
