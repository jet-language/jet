//RS             annotate_fragment_module_calls(
//RS                 &mut function,
//RS                 &source.import_signatures,
//RS                 &source.imported_functions,
//RS             );
//RS             Item::Func(function)
//RS         })
//RS         .chain(source.constants.iter().cloned().map(Item::Const))
//RS         .collect::<Vec<_>>();
//RS     let function_count = items.len();
//RS     if user_module {
//RS         items.extend(facts.structs.values().cloned().map(Item::Struct));
//RS         items.extend(facts.enums.values().cloned().map(Item::Enum));
//RS     }
//RS     let mut cx = build_cx_items(
//RS         &items,
//RS         "",
//RS         &source.module_identity,
//RS         None,
//RS         &std::collections::HashMap::new(),
//RS         "2026",
//RS     );
//RS     // A same-module constant read lowers to the `Global` key its declaration
//RS     // row carries in the fragment program (`fragment_core_source_constants`),
//RS     // exactly as `populate_cx_from_bundle` keys it for runtime lowering.
//RS     for constant in &source.constants {
//RS         let Some(ty) = cx.const_types.get(&constant.name).cloned() else {
//RS             continue;
//RS         };
//RS         let row = tir_to_mir_types::lower_constant(constant, &source.module_identity);
//RS         cx.const_ref_keys.insert(constant.name.clone(), row.key);
//RS         cx.const_ref_types.insert(constant.name.clone(), ty);
//RS     }
//RS     cx.module_alias = source.alias.clone();
//RS     cx.module_identity = source.module_identity.clone();
//RS     cx.jit_local_call_prefix = Some(format!("{}::", mangle(&source.alias)));
//RS     cx.core_source_sigs = fragment_cx.core_source_sigs.clone();
