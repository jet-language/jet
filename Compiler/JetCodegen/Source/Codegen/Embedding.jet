// Typed artifact exports consume checked MIR only, never source AST or backend policy.
use jet_foundation.MIR.[require_canonical_mir_optimization, MIRAccess, MIRArtifactID, MIRArtifactKind, MIRArtifactPlan, MIRFailureCarrier, MIRFunctionForm, MIROwnership, MIRProgram, MIRType, MIRTypeDefKind, MIRTypeKind, MIRTypeID, MIRViewProvenance, MIRFunction, MIRExport, MIRComponentTypeDescriptor, MIRComponentSignatureDescriptor, MIRComponentTypeField]
use jet_foundation.Names.[mangle_path]
use jet_foundation.Shape.[ShapeProjectionKind]

// Rust: crates/jet-codegen/src/Codegen/Embedding.rs:22
pub enum ExportScalar { Int Float Bool Text }
impl ExportScalar {
    // Rust: crates/jet-codegen/src/Codegen/Embedding.rs:30
    pub fn rust_ty(self) -> String Never! { if self == { .Int -> "i64", .Float -> "f64", .Bool -> "bool", .Text -> "String" } }
    // Rust: crates/jet-codegen/src/Codegen/Embedding.rs:39
    pub fn wit_ty(self) -> String Never! { if self == { .Int -> "s64", .Float -> "f64", .Bool -> "bool", .Text -> "string" } }
    // Rust: crates/jet-codegen/src/Codegen/Embedding.rs:48
    pub fn c_ty(self) -> String Never! { if self == { .Int -> "int64_t", .Float -> "double", .Bool -> "bool", .Text -> "JetText" } }
    // Rust: crates/jet-codegen/src/Codegen/Embedding.rs:57
    pub fn python_ctypes_ty(self) -> String Never! { if self == { .Int -> "ctypes.c_int64", .Float -> "ctypes.c_double", .Bool -> "ctypes.c_bool", .Text -> "JetText" } }
    // Rust: crates/jet-codegen/src/Codegen/Embedding.rs:66
    pub fn swift_ty(self) -> String Never! { if self == { .Int -> "Int64", .Float -> "Double", .Bool -> "Bool", .Text -> "JetText" } }
}
// Rust: crates/jet-codegen/src/Codegen/Embedding.rs:78
// Component descriptors are the canonical Foundation MIR carriers imported above.
// Rust: crates/jet-codegen/src/Codegen/Embedding.rs:81
pub struct ComponentSignature { pub params: [MIRType], pub result: MIRType }
// Rust: crates/jet-codegen/src/Codegen/Embedding.rs:90
pub struct ExportOwnership {
    pub parameters: [MIROwnership]
    pub return_views: [[String]:MIRViewProvenance]?
}
// Rust: crates/jet-codegen/src/Codegen/Embedding.rs:97
pub struct ExportFunction {
    pub name: String
    pub symbol: String
    pub callee: String
    pub scalar: ExportScalar?
    pub component: ComponentSignature?
    pub params: [MIRAccess]
    pub ownership: ExportOwnership
    pub failure: MIRFailureCarrier
}
// Rust: crates/jet-codegen/src/Codegen/Embedding.rs:108
fn mir_scalar(ty: MIRType) -> ExportScalar? Never! {
    if ty.kind == { .Int -> Val(ExportScalar.Int), .Float -> Val(ExportScalar.Float), .Bool -> Val(ExportScalar.Bool), .String -> Val(ExportScalar.Text), else -> None }
}
// Rust: crates/jet-codegen/src/Codegen/Embedding.rs:118
fn component_type_descriptor(program: MIRProgram, ty: MIRType, seen: &Set<MIRTypeID>) -> MIRComponentTypeDescriptor? Never! {
    if ty.kind == {
        .Int -> Val(MIRComponentTypeDescriptor.Int)
        .Float -> Val(MIRComponentTypeDescriptor.Float)
        .Bool -> Val(MIRComponentTypeDescriptor.Bool)
        .String -> Val(MIRComponentTypeDescriptor.String)
        .List(inner) -> {
            descriptor :: component_type_descriptor(program, inner, &seen) ?? return None
            Val(MIRComponentTypeDescriptor.List(descriptor))
        }
        .FixedList(inner, _) -> {
            descriptor :: component_type_descriptor(program, inner, &seen) ?? return None
            Val(MIRComponentTypeDescriptor.List(descriptor))
        }
        .InlineRange(inner, _, _) -> component_type_descriptor(program, inner, &seen)
        .Tagged(_, inner) -> component_type_descriptor(program, inner, &seen)
        .Option(inner) -> {
            descriptor :: component_type_descriptor(program, inner, &seen) ?? return None
            Val(MIRComponentTypeDescriptor.Option(descriptor))
        }
        .Result(ok, err) -> {
            ok_descriptor :: component_type_descriptor(program, ok, &seen) ?? return None
            err_descriptor :: component_type_descriptor(program, err, &seen) ?? return None
            Val(MIRComponentTypeDescriptor.Result(ok_descriptor, err_descriptor))
        }
        .Apply(nominal, _) -> {
            if seen.contains(nominal.id) -> return None
            &seen.insert(nominal.id)
            result := None
            // Always remove the nominal, including missing definitions or invalid fields.
            loop definition in program.types {
                if definition.id != nominal.id -> continue
                if definition.kind == {
                    .Struct(fields, _) -> {
                        descriptors := [MIRComponentTypeField]{}
                        valid := true
                        loop (index, field) in fields {
                            if field.skip || field.computed -> continue
                            field_descriptor :: component_type_descriptor(program, field.ty, &seen)
                            if field_descriptor == .Val(descriptor) {
                                shape_name :: field.shape_names.name_for(ShapeProjectionKind.Json).expect("checked MIR field is missing its JSON shape name")
                                &descriptors.push(MIRComponentTypeField{index: index, name: shape_name, ty: descriptor})
                            } else { valid = false; break }
                        }
                        if valid -> result = Val(MIRComponentTypeDescriptor.Record(definition.name, ^descriptors))
                    }
                    .Alias(target) -> result = component_type_descriptor(program, target, &seen)
                    else -> {}
                }
                break
            }
            &seen.remove(nominal.id)
            result
        }
        .Map(_, _) -> None
        .Shared(_) -> None
        .Fn(_) -> None
        .SendFn(_, _, _) -> None
        .TraitObject(_) -> None
        .Tuple(_) -> None
        .IntN(_, _) -> None
        .Float32 -> None
        .Union(_) -> None
        .Quantity(_, _) -> None
        .Measure(_) -> None
        .Char -> None
    }
}
// Rust: crates/jet-codegen/src/Codegen/Embedding.rs:197
pub fn component_descriptor(program: MIRProgram, signature: ComponentSignature) -> MIRComponentSignatureDescriptor? Never! {
    seen := Set.new<MIRTypeID>()
    params := [MIRComponentTypeDescriptor]{}
    loop ty in signature.params {
        descriptor :: component_type_descriptor(program, ty, &seen) ?? return None
        &params.push(descriptor)
    }
    result :: component_type_descriptor(program, signature.result, &seen) ?? return None
    Val(MIRComponentSignatureDescriptor{params: ^params, result: result})
}
// Rust: crates/jet-codegen/src/Codegen/Embedding.rs:212
fn mir_type_contains_view(ty: MIRType) -> Bool Never! {
    if ty.kind == {
        .Apply(name, _) -> name.name == "View" || name.name == "ViewMut"
        .List(inner) -> mir_type_contains_view(inner)
        .Option(inner) -> mir_type_contains_view(inner)
        .FixedList(inner, _) -> mir_type_contains_view(inner)
        .InlineRange(inner, _, _) -> mir_type_contains_view(inner)
        .Tagged(_, inner) -> mir_type_contains_view(inner)
        .Result(ok, err) -> mir_type_contains_view(ok) || mir_type_contains_view(err)
        else -> false
    }
}
// Rust: crates/jet-codegen/src/Codegen/Embedding.rs:227
fn component_signature(program: MIRProgram, function: MIRFunction, allow_library_views: Bool) -> ComponentSignature? Never! {
    params := [MIRType]{}
    loop param in function.params -> &params.push(param.ty)
    signature :: ComponentSignature{params: ^params, result: function.return_type}
    if component_descriptor(program, signature) != None
        || (allow_library_views && (function.failure == .Result(_, _) || signature.params.any((ty) -> mir_type_contains_view(ty)) || mir_type_contains_view(signature.result))) -> return Val(signature)
    None
}
// Rust: crates/jet-codegen/src/Codegen/Embedding.rs:255
fn scalar_signature(function: MIRFunction) -> ExportScalar? Never! {
    return_type :: if function.failure == {
        .Result(success, _) -> success
        .Infallible -> function.return_type
        .Optional(_) -> return None
        .Diverges(_) -> return None
    }
    scalar :: mir_scalar(return_type) ?? return None
    loop param in function.params {
        if mir_scalar(param.ty) != Val(scalar) -> return None
    }
    Val(scalar)
}
// Rust: crates/jet-codegen/src/Codegen/Embedding.rs:271
fn export_function(program: MIRProgram, export: MIRExport, allow_component: Bool, allow_library_views: Bool) -> ExportFunction? Never! {
    function_option := None
    loop function in program.functions {
        if function.id == export.function { function_option = Val(function); break }
    }
    function :: function_option ?? return None
    if function.form != MIRFunctionForm.TopLevel || !function.capture_params.is_empty() -> return None
    scalar :: scalar_signature(function)
    component :: if allow_component -> component_signature(program, function, allow_library_views) else -> None
    if scalar == None && component == None -> return None
    params := [MIRAccess]{}
    parameters := [MIROwnership]{}
    loop param in function.params { &params.push(param.access); &parameters.push(param.ownership) }
    Val(ExportFunction{name: function.name, symbol: export.symbol, callee: mangle_path(function.key), scalar: scalar, component: component, params: ^params, ownership: ExportOwnership{parameters: ^parameters, return_views: function.return_view_provenance}, failure: function.failure})
}
// Rust: crates/jet-codegen/src/Codegen/Embedding.rs:306
pub fn selected_artifact(program: MIRProgram, artifact_id: MIRArtifactID) -> MIRArtifactPlan from program {
    if require_canonical_mir_optimization(program) == .Err(error) -> panic("MIR artifact emission requires canonical optimization: {error}")
    loop artifact in program.artifacts {
        if artifact.id == artifact_id -> return artifact
    }
    // GATE #4409: original Debug formatting for the MIR artifact identity.
    panic("MIR artifact ID {artifact_id:?} has no plan row")
}
// Rust: crates/jet-codegen/src/Codegen/Embedding.rs:323
pub fn export_surface(program: MIRProgram, artifact_id: MIRArtifactID) -> [ExportFunction] Never! {
    artifact :: selected_artifact(program, artifact_id)
    allow_component :: artifact.kind == MIRArtifactKind.NativeLibrary || artifact.kind == MIRArtifactKind.SandboxPlugin
    allow_library_views :: artifact.kind == MIRArtifactKind.NativeLibrary
    exports := [ExportFunction]{}
    loop export in artifact.exports {
        if export_function(program, export, allow_component, allow_library_views) == .Val(row) -> &exports.push(row)
    }
    exports
}
