    // Rust: crates/jet-codegen/src/Codegen/Context.rs:2074
    // Crypto values cannot derive Clone/Debug. Compute reverse reachability once for all owners.
    pub fn secret_containing_types(self) -> Set<String> Never! {
        // Rust: crates/jet-codegen/src/Codegen/Context.rs:2075
        fn walk(ty: Type, names: &[String], direct: &Bool) Never! {
            if ty == {
                .Tagged(.Internal(.CoreCryptoNominal), _) -> direct = true
                .Named(name) -> names.push(name)
                .Apply(name, args) -> {
                    names.push(name)
                    loop arg in args { walk(arg, &names, &direct) }
                }
                .List(inner) | .Shared(inner) | .Option(inner) | .Tagged(_, inner) -> walk(inner, &names, &direct)
                .Map(key, _, value) | .Result(key, value) -> { walk(key, &names, &direct); walk(value, &names, &direct) }
                .Tuple(fields) -> { loop (_, ty) in fields { walk(ty, &names, &direct) } }
                .Union(members) -> { loop ty in members { walk(ty, &names, &direct) } }
                .FixedList(elem, _) | .InlineRange(elem, _, _) | .Quantity(elem, _) -> walk(elem, &names, &direct)
                .Fn(params, ret, _, _, _, _) -> {
                    loop ty in params { walk(ty, &names, &direct) }
                    if ret == .Val(ty) { walk(ty, &names, &direct) }
                }
                else -> {}
            }
        }
        owners := Set<String>.new()
        loop owner in self.struct_fields.keys() { _ :: owners.insert(owner) }
        loop owner in self.enum_variants.keys() { _ :: owners.insert(owner) }
        dependents := [String:[String]]{}
        secret := Set<String>.new()
        pending := [String]{}
        loop owner in owners {
            names := [String]{}
            direct := false
            if self.struct_fields.get(owner) == .Val(fields) { loop (_, ty) in fields { walk(ty, &names, &direct) } }
            if self.enum_variants.get(owner) == .Val(variants) {
                loop (_, payload) in variants {
                    if payload == {
                        .Unit -> {}
                        .Single(ty, _) -> walk(ty, &names, &direct)
                        .Named(fields) -> { loop field in fields { walk(field.ty, &names, &direct) } }
                    }
                }
            }
            loop name in names { dependents.entry(name).or_default().push(owner) }
            if direct && secret.insert(owner) { pending.push(owner) }
        }
        loop {
            name := pending.pop() ?? break
            if dependents.get(name) == .Val(owners) {
                loop owner in owners { if secret.insert(owner) { pending.push(owner) } }
            }
        }
        ^secret
    }

    // Rust: crates/jet-codegen/src/Codegen/Context.rs:2172
    pub fn rust_type_with_view_lifetime(self, ty: Type) -> String Never! {
        self.rust_type_with_view_lifetime_using(ty, (value) => self.rust_type(value))
    }

    // Rust: crates/jet-codegen/src/Codegen/Context.rs:2176
    fn rust_type_with_view_lifetime_using(self, ty: Type, base: (Type) -> String) -> String Never! {
        // Rust: crates/jet-codegen/src/Codegen/Context.rs:2181
        fn add_reference_lifetime(rust: String) -> String Never! {
            jet_prefix :: generated_prefix()
            if rust.strip_prefix("&mut ") == .Val(rest) -> return "&'{jet_prefix}view mut {rest}"
            if rust.strip_prefix("&") == .Val(rest) -> return "&'{jet_prefix}view {rest}"
            if rust.strip_suffix("JetComputeViewMut<'_>") == .Val(prefix) -> return "{prefix}JetComputeViewMut<'{jet_prefix}view>"
            rust
        }
        // Rust: crates/jet-codegen/src/Codegen/Context.rs:2193
        fn add_type_lifetime(rust: String) -> String Never! {
            jet_prefix :: generated_prefix()
            if rust.find("<") == .Val(open) -> return "{rust.slice(0, open)}<'{jet_prefix}view, {rust.slice(open + 1, rust.len())}"
            "{rust}<'{jet_prefix}view>"
        }
        // Rust: crates/jet-codegen/src/Codegen/Context.rs:2201
        fn definition_contains_view(cx: Cx, name: String) -> Bool Never! {
            if cx.struct_fields.get(name) == .Val(fields) {
                loop (_, ty) in fields { if cx.type_contains_view(ty) -> return true }
            }
            if cx.enum_variants.get(name) == .Val(variants) {
                loop (_, payload) in variants {
                    if payload == {
                        .Unit -> {}
                        .Single(ty, _) -> { if cx.type_contains_view(ty) -> return true }
                        .Named(fields) -> { loop field in fields { if cx.type_contains_view(field.ty) -> return true } }
                    }
                }
            }
            false
        }
        // Rust: crates/jet-codegen/src/Codegen/Context.rs:2216
        fn render(cx: Cx, ty: Type, base: (Type) -> String) -> String Never! {
            if ty == {
                .Apply(name, args) -> {
                    if args.len() == 1 && (name == "View" || name == "ViewMut" || name == "ComputeViewMut" || name == Syntax.TYPE_PIN) -> return add_reference_lifetime(base(ty))
                    contains_view :: definition_contains_view(cx, name)
                    if contains_view || args.iter().any((arg) => cx.type_contains_view(arg)) {
                        head :: base(.Named(name))
                        rendered :: args.iter().map((arg) => render(cx, arg, base)).collect<[String]>().join(", ")
                        lifetime := [String]{}
                        if contains_view { lifetime.push("'{generated_prefix()}view") }
                        if !rendered.is_empty() { lifetime.push(rendered) }
                        return "{head}<{lifetime.join(", ")}>"
                    }
                    base(ty)
                }
                .Tagged(.Internal(.AllocatorView), _) -> add_reference_lifetime(base(ty))
                .List(inner) -> if cx.type_contains_view(inner) -> "Vec<{render(cx, inner, base)}>" else -> base(ty)
                .Map(key, _, value) -> if cx.type_contains_view(ty) -> "{cx.root_prefix}JetMap<{render(cx, key, base)}, {render(cx, value, base)}>" else -> base(ty)
                .Shared(inner) -> if cx.type_contains_view(inner) -> "{cx.root_prefix}jet_std::JetShared<{render(cx, inner, base)}>" else -> base(ty)
                .Option(inner) -> if cx.type_contains_view(inner) -> "{cx.root_prefix}JetOutcome<{render(cx, inner, base)}, {cx.root_prefix}JetAbsent>" else -> base(ty)
                .Result(ok, err) -> if cx.type_contains_view(ty) -> "{cx.root_prefix}JetOutcome<{render(cx, ok, base)}, {render(cx, err, base)}>" else -> base(ty)
                .Tuple(fields) -> if cx.type_contains_view(ty) -> add_type_lifetime(tuple_struct_name(tuple_fields_plain(fields))) else -> base(ty)
                .FixedList(elem, len) -> if cx.type_contains_view(elem) -> "[{render(cx, elem, base)}; {len}]" else -> base(ty)
                .Tagged(_, inner) -> if cx.type_contains_view(inner) -> render(cx, inner, base) else -> base(ty)
                .Named(name) -> if definition_contains_view(cx, name) -> add_type_lifetime(base(ty)) else -> base(ty)
                else -> base(ty)
            }
        }
        expanded :: self.expand_type_aliases(ty)
        render(self, expanded, base)
    }

    // Rust: crates/jet-codegen/src/Codegen/Context.rs:2304
    pub fn is_columnar_struct(self, name: String) -> Bool Never! { self.columnar.contains(name) }
    // Rust: crates/jet-codegen/src/Codegen/Context.rs:2315
    // The shared Prelude store owns layout/rows/gather; only local columnar structs are tracked.
    pub fn columnar_list_type(self, inner: Type) -> String? Never! {
        if inner == .Named(name) { if self.is_columnar_struct(name) -> return Val("JetColumnList<{self.rust_type(inner)}>") }
        None
    }
    // Rust: crates/jet-codegen/src/Codegen/Context.rs:2328
    // Stored-field declaration order is the column order; computed fields are excluded upstream.
    pub fn columnar_column_index(self, name: String, field: String) -> Int? Never! {
        fields := self.struct_fields.get(name) ?? return None
        fields.iter().position((entry) => entry.0 == field)
    }
    // Rust: crates/jet-codegen/src/Codegen/Context.rs:2336
    pub fn data_plot_field_id(self, name: String, ty: Type) -> String Never! {
        type_name :: ty.name()
        column_identity(name, type_name)
    }

    // Rust: crates/jet-codegen/src/Codegen/Context.rs:2342
    pub fn expand_type_aliases(self, ty: Type) -> Type Never! {
        if ty == {
            .Apply(name, args) -> {
                if self.type_aliases.get(name) == .Val((params, target)) {
                    subst := [String:Type]{}
                    loop (param, arg) in params.iter().zip(args.iter()) { subst.insert(param.name, ~arg) }
                    return self.expand_type_aliases(Generics.substitute_type(target, subst))
                }
                .Apply(~name, args.iter().map((arg) => self.expand_type_aliases(arg)).collect<[Type]>())
            }
            .List(inner) -> .List(self.expand_type_aliases(inner))
            .Map(key, key_span, value) -> .Map(self.expand_type_aliases(key), key_span, self.expand_type_aliases(value))
            .Shared(inner) -> .Shared(self.expand_type_aliases(inner))
            .Option(inner) -> .Option(self.expand_type_aliases(inner))
            .Result(ok, err) -> .Result(self.expand_type_aliases(ok), self.expand_type_aliases(err))
            .Fn(params, ret, effect_bound, param_contract, call_metadata, return_view_provenance) -> .Fn(params.iter().map((param) => self.expand_type_aliases(param)).collect<[Type]>(), ret.map((value) => self.expand_type_aliases(value)), ~effect_bound, ~param_contract, ~call_metadata, ~return_view_provenance)
            .Tuple(fields) -> .Tuple(fields.iter().map((field) => (~field.0, self.expand_type_aliases(field.1))).collect())
            .Tagged(marker, inner) -> .Tagged(~marker, self.expand_type_aliases(inner))
            .FixedList(elem, len) -> .FixedList(self.expand_type_aliases(elem), ~len)
            .InlineRange(base, lo, hi) -> .InlineRange(self.expand_type_aliases(base), lo, hi)
            .Union(members) -> canonicalize_union(members.iter().map((member) => self.expand_type_aliases(member)).collect<[Type]>())
            else -> ~ty
        }
    }

    // Rust: crates/jet-codegen/src/Codegen/Context.rs:2420
    pub fn canonicalize_checked_type(self, ty: Type, binders: [String]) -> Type Never! {
        binder_names := ~self.current_type_params.borrow()
        loop name in binders { if !binder_names.contains(name) { _ :: binder_names.insert(name) } }
        expanded :: self.canonicalize_core_type_aliases(self.expand_type_aliases(ty))
        canonicalize_checked_trait_types(expanded, self.trait_names, self.type_names, binder_names)
    }

    // Rust: crates/jet-codegen/src/Codegen/Context.rs:2439
    fn canonicalize_core_type_aliases(self, ty: Type) -> Type Never! {
        // Rust: crates/jet-codegen/src/Codegen/Context.rs:2440
        fn canonical_name(cx: Cx, name: String) -> String Never! { cx.core_qualified_rust_type_name(name) ?? name }
        if ty == {
            .Named(name) -> .Named(canonical_name(self, name))
            .List(inner) -> .List(self.canonicalize_core_type_aliases(inner))
            .Map(key, key_span, value) -> .Map(self.canonicalize_core_type_aliases(key), key_span, self.canonicalize_core_type_aliases(value))
            .Shared(inner) -> .Shared(self.canonicalize_core_type_aliases(inner))
            .Option(inner) -> .Option(self.canonicalize_core_type_aliases(inner))
            .Result(ok, err) -> .Result(self.canonicalize_core_type_aliases(ok), self.canonicalize_core_type_aliases(err))
            .Fn(params, ret, effect_bound, param_contract, call_metadata, return_view_provenance) -> .Fn(params.iter().map((param) => self.canonicalize_core_type_aliases(param)).collect<[Type]>(), ret.map((value) => self.canonicalize_core_type_aliases(value)), ~effect_bound, ~param_contract, ~call_metadata, ~return_view_provenance)
            .Apply(name, args) -> .Apply(canonical_name(self, name), args.iter().map((arg) => self.canonicalize_core_type_aliases(arg)).collect<[Type]>())
            .Tuple(fields) -> .Tuple(fields.iter().map((field) => (~field.0, self.canonicalize_core_type_aliases(field.1))).collect())
            .FixedList(elem, len) -> .FixedList(self.canonicalize_core_type_aliases(elem), ~len)
            .InlineRange(base, lo, hi) -> .InlineRange(self.canonicalize_core_type_aliases(base), lo, hi)
            .Tagged(marker, inner) -> .Tagged(~marker, self.canonicalize_core_type_aliases(inner))
            .Union(members) -> canonicalize_union(members.iter().map((member) => self.canonicalize_core_type_aliases(member)).collect<[Type]>())
            .Quantity(base, dimension) -> .Quantity(self.canonicalize_core_type_aliases(base), ~dimension)
            else -> ~ty
        }
    }

    // Rust: crates/jet-codegen/src/Codegen/Context.rs:2533
    pub fn rust_type(self, ty: Type) -> String Never! {
        expanded :: self.expand_type_aliases(ty)
        if expanded.quantity_parts() == .Val((base, _)) -> return self.rust_type(base)
        if expanded == {
            .Int -> "i64"
            .Float -> "f64"
            .IntN(signed, bits) -> "{if signed -> "i" else -> "u"}{bits}"
            .InlineRange(base, _, _) -> self.rust_type(base)
            .Float32 -> "f32"
            .Bool -> "bool"
            .String -> "String"
            .Char -> "char"
            .List(inner) -> self.columnar_list_type(inner) ?? "Vec<{self.rust_type(inner)}>"
            .Map(key, _, value) -> "{self.root_prefix}JetMap<{self.rust_type(key)}, {self.rust_type(value)}>"
            .Shared(inner) -> "{self.root_prefix}jet_std::JetShared<{self.rust_type(inner)}>"
            .Option(inner) -> "{self.root_prefix}JetOutcome<{self.rust_type(inner)}, {self.root_prefix}JetAbsent>"
            .Result(ok, err) -> "{self.root_prefix}JetOutcome<{self.rust_type(ok)}, {self.rust_type(err)}>"
            .Named(name) -> {
                if (Generics.is_type_var_name(name) || self.current_type_params.borrow().contains(name)) && !self.type_names.contains(name) -> return name
                if self.foreign_type_identity("", name) == .Val(identity) {
                    rust_mod :: self.foreign_types.get(identity).expect("foreign identity must have a Rust module")
                    leaf :: nominal_leaf(identity)
                    return "{self.root_prefix}{rust_mod}::{mangle_path(leaf)}"
                }
                if name == "Unit" && !self.type_names.contains(name) -> return "()"
                if name == Syntax.TYPE_REMOVE_BY && !self.type_names.contains(name) -> return "{self.root_prefix}JetRemoveBy"
                if name == Syntax.TYPE_TASK_FAILURE && !self.type_names.contains(name) -> return "{self.root_prefix}JetTaskFailure"
                if name == Syntax.TYPE_TASKGROUP && !self.type_names.contains(name) -> return "{self.root_prefix}jet_std::JetTaskGroup"
                if name == Syntax.TYPE_CONDITION && !self.type_names.contains(name) -> return "{self.root_prefix}jet_std::JetCondition"
                if name == Syntax.TYPE_SHARED_REVISION_ERROR && !self.type_names.contains(name) -> return "{self.root_prefix}jet_std::JetSharedRevisionError"
                if name == Syntax.TYPE_NEVER -> return "std::convert::Infallible"
                if name == Syntax.TYPE_ALLOC_ERROR -> return "{self.root_prefix}AllocError"
                if name == "Claims" && !self.type_names.contains(name) -> return "{self.root_prefix}JetAuthClaims"
                if name == "AuthError" && !self.type_names.contains(name) -> return "{self.root_prefix}JetAuthError"
                if name == "Session" && !self.type_names.contains(name) -> return "{self.root_prefix}JetAuthSession"
                if name == "Auth" && !self.type_names.contains(name) -> return "{self.root_prefix}JetAuthApp"
                if name == "SyncText" && !self.type_names.contains(name) -> return "{self.root_prefix}JetSyncText"
                if name == "SyncCounter" && !self.type_names.contains(name) -> return "{self.root_prefix}JetSyncCounter"
                if name == "SyncMap" && !self.type_names.contains(name) -> return "{self.root_prefix}JetSyncMap"
                if name == "SyncList" && !self.type_names.contains(name) -> return "{self.root_prefix}JetSyncList"
                if name == "RowPolicy" -> return "{self.root_prefix}JetRowPolicy"
                if !self.type_names.contains(name) {
                    if core_crypto_rust_type_name(name) == .Val(rust) {
                        ffi :: self.ffi_crate ?? "jet_ffi"
                        return "{ffi}::{rust}"
                    }
                }
                if name == "KeyStatus" || name == "VaultError" {
                    ffi :: self.ffi_crate ?? "jet_ffi"
                    rust :: if name == "KeyStatus" -> "JetVaultKeyStatus" else -> "JetVaultError"
                    return "{ffi}::{rust}"
                }
                if name == "Unknown" -> return "_"
                if name == "HyperLogLog" -> return "JetHyperLogLog"
                if name == "TDigest" -> return "JetTDigest"
                if name == "CountMinSketch" -> return "JetCountMinSketch"
                if name == "ReservoirSampler" -> return "JetReservoirSampler"
                if name == "Date" || name == "LocalDate" -> return "JetDate"
                if name == "LocalTime" -> return "JetLocalTime"
                if name == "DateTime" -> return "JetDateTime"
                if name == "Instant" -> return "JetInstant"
                if name == "Period" -> return "JetPeriod"
                if name == "Zone" -> return "JetZone"
                if name == "ZonedDateTime" -> return "JetZonedDateTime"
                if name == "URL" -> return "{self.root_prefix}jet_std::JetURL"
                if name == "MIME" -> return "{self.root_prefix}jet_std::JetMIME"
                if !self.type_names.contains(name) && (name == "Address" || name == "Message" || name == "Attachment" || name == "Envelope" || name == "SMTPSecurity" || name == "RecipientPolicy" || name == "RecipientReport" || name == "SendReport" || name == "EmailError" || name == "Limits") {
                    rust :: if name == "EmailError" -> "Error" else -> name
                    return "{self.root_prefix}jet_email::{rust}"
                }
                if name == "SMTPAuth" && !self.type_names.contains(name) -> return "{self.root_prefix}jet_email::SMTPAuth<{self.ffi_crate ?? "jet_ffi"}::Secret>"
                if (name == "DKIMConfig" || name == "SMTPConfig") && !self.type_names.contains(name) -> return "{self.root_prefix}jet_email::{name}<{self.ffi_crate ?? "jet_ffi"}::Secret>"
                if (name == "TLSTrust" || name == "Mailer") && !self.type_names.contains(name) -> return "{self.root_prefix}jet_email::{name}"
                if name == "WsConn" -> return "JetWsConn"
                if name == "WsError" -> return "JetWsError"
                if name == "WsMessage" -> return "JetWsMessage"
                if name == "Browser" -> return "JetBrowser"
                if name == "BrowserContext" -> return "JetBrowserContext"
                if name == "BrowserPage" -> return "JetBrowserPage"
                if name == "BrowserFrame" -> return "JetBrowserFrame"
                if name == "BrowserLocator" -> return "JetBrowserLocator"
                if name == "BrowserIntercept" -> return "JetBrowserIntercept"
                if name == "BrowserEvent" -> return "JetBrowserEvent"
                if name == "BrowserTrace" -> return "JetBrowserTrace"
                if name == "BrowserReceipt" -> return "JetBrowserReceipt"
                if name == "BrowserPrivacy" -> return "JetBrowserPrivacy"
                if name == "BrowserError" -> return "JetBrowserError"
                if name == "BrowserAbilities" -> return "JetBrowserAbilities"
                if name == "BrowserProfile" -> return "JetBrowserProfile"
                if name == "BrowserTimeout" -> return "JetBrowserTimeout"
                if name == "BrowserProtocol" -> return "JetBrowserProtocol"
                if name == "ParseError" && !self.type_names.contains(name) -> return "String"
                if name == "SQL" -> return "{self.root_prefix}jet_std::SQL"
                if name == "HTML" -> return "String"
                if name == "Sh" -> return "Vec<String>"
                if name == "ScopeGuard" -> return "_"
                if name == "Key" -> return "{self.root_prefix}JetKey"
                if core_ui_rust_type_name(name).is_some() && !self.type_names.contains(name) -> return "{self.root_prefix}Jet{name}"
                if name == "UIFileFilterResult" && !self.type_names.contains(name) -> return "{self.root_prefix}JetUiServiceResult<{self.root_prefix}JetUiFileFilter>"
                if name == "UIFSGrantResult" && !self.type_names.contains(name) -> return "{self.root_prefix}JetUiServiceResult<{self.root_prefix}JetUiFsGrant>"
                if name == "UIShortcutResult" && !self.type_names.contains(name) -> return "{self.root_prefix}JetUiServiceResult<{self.root_prefix}JetUiShortcut>"
                if name == "UiShortcutBindingResult" && !self.type_names.contains(name) -> return "{self.root_prefix}JetUiServiceResult<{self.root_prefix}JetUiShortcutBinding>"
                if name == "UIAccessibilityResult" && !self.type_names.contains(name) -> return "{self.root_prefix}JetUiServiceResult<{self.root_prefix}JetUiAccessibility>"
                if name == "UIFileDialogResult" && !self.type_names.contains(name) -> return "{self.root_prefix}JetUiServiceResult<{self.root_prefix}JetUiFileDialogSelection>"
                if name == "UIClipboardTextResult" && !self.type_names.contains(name) -> return "{self.root_prefix}JetUiServiceResult<{self.root_prefix}JetUiClipboardText>"
                if name == "UIClipboardWriteResult" && !self.type_names.contains(name) -> return "{self.root_prefix}JetUiServiceResult<{self.root_prefix}JetUiClipboardWrite>"
                if name == "UIIMEResult" && !self.type_names.contains(name) -> return "{self.root_prefix}JetUiServiceResult<Option<{self.root_prefix}JetUiImeEvent>>"
                if name == "UIDragResult" && !self.type_names.contains(name) -> return "{self.root_prefix}JetUiServiceResult<Option<{self.root_prefix}JetUiDragEvent>>"
                if name == "UIShortcutDispatchResult" && !self.type_names.contains(name) -> return "{self.root_prefix}JetUiServiceResult<{self.root_prefix}JetUiShortcutDispatch>"
                if name == "UIAccessibilityAttachResult" && !self.type_names.contains(name) -> return "{self.root_prefix}JetUiServiceResult<()>"
                if name == "UIAccessibilityProjectionResult" && !self.type_names.contains(name) -> return "{self.root_prefix}JetUiServiceResult<Option<{self.root_prefix}JetUiAccessibilityProjection>>"
                if name == "UIAccessibilityNodeResult" && !self.type_names.contains(name) -> return "{self.root_prefix}JetUiServiceResult<{self.root_prefix}JetUiNode>"
                if !self.type_names.contains(name) && (name == "ScreenPoint" || name == "WorldPoint" || name == "ViewPoint" || name == "CameraPoint" || name == "DevicePoint" || name == "ScreenDelta" || name == "WorldDelta" || name == "ViewDelta" || name == "CameraDelta" || name == "DeviceDelta") -> return "{self.root_prefix}JetCoord2"
                if (name == "TransformError" || name == "FrameId") && !self.type_names.contains(name) -> return if name == "FrameId" -> "{self.root_prefix}i64" else -> "{self.root_prefix}JetErr"
                if name == "DevServer" && !self.type_names.contains(name) -> return "{self.root_prefix}JetDevServer"
                if name == "App" && !self.type_names.contains(name) -> return "{self.root_prefix}JetApp"
                if name == "WebPage" && !self.type_names.contains(name) -> return "{self.root_prefix}JetWebPage"
                if name == "LiveQuery" && !self.type_names.contains(name) -> return "{self.root_prefix}JetLiveQuery"
                if name == Syntax.TYPE_RANGE && !self.type_names.contains(name) -> return "{self.root_prefix}JetRange"
                if name == "DimensionAxis" && !self.type_names.contains(name) -> return "{self.root_prefix}JetDimensionAxis"
                if name == "DimensionInfo" && !self.type_names.contains(name) -> return "{self.root_prefix}JetDimensionInfo"
                if name == "StateRef" && !self.type_names.contains(name) -> return "{self.root_prefix}JetStateRef"
                if name == "StateInfo" && !self.type_names.contains(name) -> return "{self.root_prefix}JetStateInfo"
                if name == "EffectInfo" && !self.type_names.contains(name) -> return "{self.root_prefix}JetEffectInfo"
                if name == "OriginInfo" && !self.type_names.contains(name) -> return "{self.root_prefix}JetOriginInfo"
                if name == Syntax.TYPE_EFFECT && !self.type_names.contains(name) -> return "{self.root_prefix}jet_std::JetReactiveEffect"
                if name == Syntax.TYPE_SUBSCRIPTION && !self.type_names.contains(name) -> return "{self.root_prefix}jet_std::JetSubscription"
                if name == Syntax.TYPE_EVENT_SCOPE && !self.type_names.contains(name) -> return "{self.root_prefix}jet_std::JetEventScope"
                if name == Syntax.TYPE_EVENT_POLICY && !self.type_names.contains(name) -> return "{self.root_prefix}jet_std::JetEventPolicy"
                if name == Syntax.TYPE_EVENT_TRACE && !self.type_names.contains(name) -> return "{self.root_prefix}jet_std::JetEventTrace"
                if name == Syntax.TYPE_HOOK_POLICY && !self.type_names.contains(name) -> return "{self.root_prefix}jet_std::JetHookPolicy"
                if file_handle_rust_type(name) == .Val(rust) -> return "{self.root_prefix}{rust}"
                if raylib_handle_rust_type(name) == .Val(rust) -> return "{self.root_prefix}{rust}"
                if game_handle_rust_type(name) == .Val(rust) -> return "{self.root_prefix}{rust}"
                if net_handle_rust_type(name) == .Val(rust) -> return "{self.root_prefix}{rust}"
                if compute_handle_rust_type(name) == .Val(rust) -> return "{self.root_prefix}{rust}"
                if service_handle_rust_type(name) == .Val(rust) -> return "{self.root_prefix}{rust}"
                if alloc_handle_rust_type(name) == .Val(rust) -> return "{self.root_prefix}{rust}"
                if args_handle_rust_type(name) == .Val(rust) -> return "{self.root_prefix}{rust}"
                if !self.type_names.contains(name) {
                    if reflect_handle_rust_type(name) == .Val(rust) -> return "{self.root_prefix}{rust}"
                    if binary_text_handle_rust_type(name) == .Val(rust) -> return "{self.root_prefix}{rust}"
                    if layout_handle_rust_type(name) == .Val(rust) -> return "{self.root_prefix}{rust}"
                }
                if name == Syntax.TYPE_COMPLEX && !self.type_names.contains(name) -> return "{self.root_prefix}JetComplex"
                if !self.type_names.contains(name) {
                    if root_prelude_rust_type_name(name) == .Val(rust) -> return "{self.root_prefix}{rust}"
                    if core_rust_type_name(name) == .Val(rust) -> return "{self.root_prefix}jet_std::{rust}"
                }
                if self.core_qualified_rust_type_name(name) == .Val(resolved) {
                    if job_queue_rust_type(resolved) == .Val(rust) -> return "{self.root_prefix}{rust}"
                    if resolved == "AllocError" -> return "{self.root_prefix}AllocError"
                    if resolved == "Claims" || resolved == "AuthError" || resolved == "Session" || resolved == "Auth" || resolved == "SyncText" || resolved == "SyncCounter" || resolved == "SyncMap" || resolved == "Counter" || resolved == "OrderedMap" || resolved == "Layer" || resolved == "Chain" || resolved == "StringSet" || resolved == "RowPolicy" {
                        rust :: if resolved == {
                            "Claims" -> "JetAuthClaims"
                            "AuthError" -> "JetAuthError"
                            "Session" -> "JetAuthSession"
                            "Auth" -> "JetAuthApp"
                            "SyncText" -> "JetSyncText"
                            "SyncCounter" -> "JetSyncCounter"
                            "SyncMap" -> "JetSyncMap"
                            "SyncList" -> "JetSyncList"
                            "Counter" -> "JetCounter"
                            "OrderedMap" -> "JetOrderedMap"
                            "Layer" -> "JetLayer"
                            "StringSet" -> "JetStringSet"
                            "Chain" -> "JetChain"
                            "RowPolicy" -> "JetRowPolicy"
                            else -> resolved
                        }
                        return "{self.root_prefix}{rust}"
                    }
                    if core_crypto_rust_type_name(resolved) == .Val(rust) -> return "{self.ffi_crate ?? "jet_ffi"}::{rust}"
                    if resolved == "Address" || resolved == "Message" || resolved == "Attachment" || resolved == "Envelope" || resolved == "SMTPSecurity" || resolved == "RecipientPolicy" || resolved == "RecipientReport" || resolved == "SendReport" || resolved == "EmailError" || resolved == "Limits" {
                        rust :: if resolved == "EmailError" -> "Error" else -> resolved
                        return "{self.root_prefix}jet_email::{rust}"
                    }
                    if resolved == "SMTPAuth" || resolved == "DKIMConfig" || resolved == "SMTPConfig" -> return "{self.root_prefix}jet_email::{resolved}<{self.ffi_crate ?? "jet_ffi"}::Secret>"
                    if resolved == "TLSTrust" || resolved == "Mailer" -> return "{self.root_prefix}jet_email::{resolved}"
                    return "{self.root_prefix}jet_std::{resolved}"
                }
                if self.trait_names.contains(name) -> return "Box<dyn {rust_trait_name(name)}>"
                if self.foreign_types.get(name) == .Val(rust_mod) -> return "{self.root_prefix}{rust_mod}::{mangle_path(nominal_leaf(name))}"
                if name.split_once(".") == .Val((alias, leaf)) {
                    if self.import_mods.get(alias) == .Val(rust_mod) -> return "{self.root_prefix}{rust_mod}::{mangle_path(leaf)}"
                    return mangle_path(name)
                }
                if name == "Expired" -> return "JetExpired"
                mangle_path(name)
            }
            .Apply(name, args) -> {
                if (name == "Point2" || name == "Delta2") && args.len() == 2 -> return "{self.root_prefix}JetCoord2"
                if (name == "Transform" || name == "Transform2") && (args.len() == 2 || args.len() == 3) -> return "{self.root_prefix}JetTransform2"
                if name == "Ray2" && args.len() == 3 -> return "{self.root_prefix}JetRay2"
                if (name == "Tensor" || name == "Vec" || name == "Matrix") && (name != "Tensor" || args.len() <= 1) && compute_handle_rust_type("Tensor").is_some() -> return "{self.root_prefix}JetTensor"
                if name == "VJPRun" && args.len() == 1 -> return "{self.root_prefix}JetComputeVjpRun<{self.rust_type(args[0])}>"
                // Exact Int is distinct from I64 despite its shared backend ABI.
                if name == "Atomic" && args.len() == 1 {
                    inner :: if args[0].without_user_tags() == .Int -> "JetAtomicInt" else -> self.rust_type(args[0])
                    return "{self.root_prefix}JetAtomic<{inner}>"
                }
                if name == "Task" && !args.is_empty() {
                    item :: self.rust_type(args[0])
                    carried :: if args[0].without_user_tags() == { .Result(_, _) -> true else -> false }
                    carrier :: if carried -> item else -> "Result<{item}, {self.root_prefix}JetErr>"
                    return "{self.root_prefix}jet_std::JetTask<{carrier}>"
                }
                if args.len() == 1 && (name == "KeyRef" || name == "MutationPlan" || name == "VaultWrite" || name == "Rotation" || name == "WrappedImportPlan") {
                    rust :: if name == {
                        "KeyRef" -> "JetVaultKeyRef"
                        "MutationPlan" -> "JetVaultMutationPlan"
                        "VaultWrite" -> "JetVaultWrite"
                        "Rotation" -> "JetVaultRotation"
                        else -> "JetVaultWrappedImportPlan"
                    }
                    return "{self.ffi_crate ?? "jet_ffi"}::{rust}<{self.rust_type(args[0])}>"
                }
                if !args.is_empty() {
                    if core_rust_type_name(name) == .Val(rust) {
                        if rust == "JetReceiver" || rust == "JetSender" || rust == "JetPool" || rust == "JetId" -> return "{self.root_prefix}jet_std::{rust}<{self.rust_type(args[0])}>"
                    }
                }
                if name == "Cell" && !args.is_empty() -> return "{self.root_prefix}jet_std::JetCell<{self.rust_type(args[0])}>"
                if name == "CellReadGuard" && !args.is_empty() -> return "{self.root_prefix}jet_std::JetCellReadGuard<{self.rust_type(args[0])}>"
                if name == "CellEditGuard" && !args.is_empty() -> return "{self.root_prefix}jet_std::JetCellEditGuard<{self.rust_type(args[0])}>"
                if name == "StreamEventTime" && args.len() == 1 -> return "{self.root_prefix}jet_std::JetStream<{self.root_prefix}jet_std::JetStreamEvent<{self.rust_type(args[0])}>>"
                if name == "KeyedStream" && args.len() == 2 -> return "{self.root_prefix}jet_std::JetKeyedStream<{self.rust_type(args[0])}, {self.rust_type(args[1])}>"
                if name == "Window" && args.len() == 2 -> return "{self.root_prefix}jet_std::JetStreamWindow<{self.rust_type(args[0])}, {self.rust_type(args[1])}>"
                if name == Syntax.TYPE_STREAM && !args.is_empty() -> return "{self.root_prefix}jet_std::JetStream<{self.rust_type(args[0])}>"
                if name == Syntax.TYPE_SIGNAL && !args.is_empty() -> return "{self.root_prefix}jet_std::JetSignal<{self.rust_type(args[0])}>"
                if (name == Syntax.TYPE_DERIVED || name == Syntax.TYPE_COMPUTED) && !args.is_empty() -> return "{self.root_prefix}jet_std::JetDerived<{self.rust_type(args[0])}>"
                if name == Syntax.TYPE_EVENT && !args.is_empty() -> return "{self.root_prefix}jet_std::JetEvent<{self.rust_type(args[0])}>"
                if name == Syntax.TYPE_ASYNC_EVENT && args.len() == 2 -> return "{self.root_prefix}jet_std::JetAsyncEvent<{self.rust_type(args[0])}, {self.rust_type(args[1])}>"
                if name == Syntax.TYPE_DISPATCH_REPORT && !args.is_empty() -> return "{self.root_prefix}jet_std::JetDispatchReport<{self.rust_type(args[0])}>"
                if name == Syntax.TYPE_DISPATCH_FAILURE && !args.is_empty() -> return "{self.root_prefix}jet_std::JetDispatchFailure<{self.rust_type(args[0])}>"
                if name == Syntax.TYPE_HOOK && args.len() == 2 -> return "{self.root_prefix}jet_std::JetHook<{self.rust_type(args[0])}, {self.rust_type(args[1])}>"
                if name == Syntax.TYPE_DECISION_HOOK && args.len() == 2 -> return "{self.root_prefix}jet_std::JetDecisionHook<{self.rust_type(args[0])}, {self.rust_type(args[1])}>"
                if name == Syntax.TYPE_HOOK_DECISION && args.len() == 2 -> return "{self.root_prefix}jet_std::JetHookDecision<{self.rust_type(args[0])}, {self.rust_type(args[1])}>"
                if name == Syntax.TYPE_HOOK_OUTCOME && args.len() == 2 -> return "{self.root_prefix}jet_std::JetHookOutcome<{self.rust_type(args[0])}, {self.rust_type(args[1])}>"
                if name == "Query" && args.len() == 1 && !self.type_names.contains(name) -> return "{self.root_prefix}jet_std::DataQuery<{self.rust_type(args[0])}>"
                if name == "Group" && args.len() == 2 && !self.type_names.contains(name) -> return "{self.root_prefix}jet_std::GroupValue<{self.rust_type(args[0])}, {self.rust_type(args[1])}>"
                if name == "DataGroupedQuery" && args.len() == 2 && !self.type_names.contains(name) -> return "{self.root_prefix}jet_std::DataGroupedQuery<{self.rust_type(args[0])}, {self.rust_type(args[1])}>"
                if name == "DataLoader" && args.len() == 1 && !self.type_names.contains(name) -> return "{self.root_prefix}jet_std::DataLoader<{self.rust_type(args[0])}>"
                if name == Syntax.TYPE_SHARED_SNAPSHOT && args.len() == 2 && !self.type_names.contains(name) -> return "{self.root_prefix}jet_std::JetSharedSnapshot<{self.rust_type(args[0])}, {self.rust_type(args[1])}>"
                if name == "DataSnapshot" && args.len() == 1 && !self.type_names.contains(name) -> return "{self.root_prefix}jet_std::DataSnapshot<{self.rust_type(args[0])}>"
                if name == "JetDataPlotColumn" && args.len() == 1 && !self.type_names.contains(name) -> return "{self.root_prefix}JetDataPlotColumn<{self.rust_type(args[0])}>"
                if name == "JetDataPlot" && args.len() == 1 && !self.type_names.contains(name) -> return "{self.root_prefix}JetDataPlot<{self.rust_type(args[0])}>"
                if name == "DataStream" && !args.is_empty() && !self.type_names.contains(name) -> return "{self.root_prefix}jet_std::DataStream"
                if name == "DataJoin" && args.len() == 2 && !self.type_names.contains(name) -> return "{self.root_prefix}jet_std::DataJoin<{self.rust_type(args[0])}, {self.rust_type(args[1])}>"
                if name == Syntax.TYPE_MEASUREMENT && !args.is_empty() -> return "{self.root_prefix}jet_std::JetMeasurement<{self.rust_type(args[0])}>"
                if name == Syntax.TYPE_SHARED_GUARD && args.len() == 1 -> return "{self.root_prefix}jet_std::JetSharedGuard<{self.rust_type(args[0])}>"
                if name == Syntax.TYPE_SHARED_WEAK && args.len() == 1 -> return "{self.root_prefix}jet_std::JetSharedWeak<{self.rust_type(args[0])}>"
                if name == "Loadable" && args.len() == 2 -> return "JetLoadable<{self.rust_type(args[0])}, {self.rust_type(args[1])}>"
                if name == "View" && args.len() == 1 {
                    if args[0] == {
                        .Named(inner) -> if inner == "str" -> "&str" else -> "&[{self.rust_type(args[0])}]"
                        .List(inner) -> "&[{self.rust_type(inner)}]"
                        else -> "&[{self.rust_type(args[0])}]"
                    }
                } else {
                    if name == "ComputeViewMut" && args.len() == 1 -> return "{self.root_prefix}JetComputeViewMut<'_>"
                    if name == "ViewMut" && args.len() == 1 -> return "&mut [{self.rust_type(args[0])}]"
                    if name == Syntax.TYPE_PIN && args.len() == 1 -> return "&mut {self.rust_type(args[0])}"
                    if name == Syntax.TYPE_ITER && args.len() == 1 -> return "{self.root_prefix}{root_prelude_rust_type_name(name).expect("registered iterator carrier")}<{self.rust_type(args[0])}>"
                    if name == Syntax.TYPE_VIEW_ITER && args.len() == 1 -> return "JetViewIter<{self.rust_type(args[0])}>"
                    if name == Syntax.EXPIRING_VALUE_TYPE && args.len() == 1 -> return "JetExpiring<{self.rust_type(args[0])}>"
                    if name == "ExpiringSecret" && args.len() == 1 -> return "JetExpiringSecret<{self.rust_type(args[0])}>"
                    if name == "Set" && !args.is_empty() -> return "std::collections::HashSet<{self.rust_type(args[0])}>"
                    if name == Syntax.TYPE_RANK && !args.is_empty() -> return "std::collections::BTreeSet<{self.rust_type(args[0])}>"
                    if name == Syntax.TYPE_PRIORITY_QUEUE && !args.is_empty() -> return "std::collections::BinaryHeap<{self.rust_type(args[0])}>"
                    if name == Syntax.TYPE_LRU && args.len() >= 2 -> return "JetCache<{self.rust_type(args[0])}, {self.rust_type(args[1])}>"
                    if name == Syntax.TYPE_TALLY && !args.is_empty() -> return "std::collections::HashMap<{self.rust_type(args[0])}, usize>"
                    if name == Syntax.TYPE_QUEUE && !args.is_empty() -> return "std::collections::VecDeque<{self.rust_type(args[0])}>"
                    if name == Syntax.TYPE_PTR && args.len() == 1 -> return "*mut {self.rust_type(args[0])}"
                    head := mangle_path(name)
                    if name.split_once(".") == .Val((alias, leaf)) {
                        if self.import_mods.get(alias) == .Val(rust_mod) { head = "{self.root_prefix}{rust_mod}::{mangle_path(leaf)}" }
                    }
                    if args.is_empty() -> return head
                    rendered :: args.iter().map((arg) => self.rust_type(arg)).collect<[String]>().join(", ")
                    "{head}<{rendered}>"
                }
            }
            .TraitObject(traits) -> "Box<dyn {traits.iter().map((name) => rust_trait_name(name)).collect<[String]>().join(" + ")}>"
            .Fn(params, ret, _, _, _, return_view_provenance) -> self.rust_fn_trait(params, ret, return_view_provenance)
            .Tuple(fields) -> tuple_struct_name(tuple_fields_plain(fields))
            .FixedList(elem, len) -> "[{self.rust_type(elem)}; {len}]"
            .Tagged(.Internal(.AllocatorView), inner) -> "&mut {self.rust_type(inner)}"
            .Tagged(_, inner) -> self.rust_type(inner)
            .Union(members) -> Names.mangle(union_enum_name(members))
            .Quantity(_, _) -> panic("quantity_parts() erased above")
            .Measure(_) -> panic("type measure handled by the Vec/Matrix Apply arm above")
        }
    }
}
