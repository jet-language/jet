    // Rust: crates/jet-codegen/src/Codegen/Context.rs:1796
    pub fn type_contains_boxed_edge(self, ty: Type) -> Bool Never! {
        // Rust: crates/jet-codegen/src/Codegen/Context.rs:1797
        fn contains(cx: Cx, ty: Type, seen: &Set<String>) -> Bool Never! {
            if ty == {
                .Named(name) -> {
                    loop (owner, _) in cx.boxed_edges { if owner == name -> return true }
                    if !seen.insert(name) -> return false
                    if cx.struct_fields.get(name) == .Val(fields) {
                        loop (_, field_ty) in fields { if contains(cx, field_ty, &seen) -> return true }
                    }
                    // Reachability keeps visited nodes marked; unmarking is exponential.
                    false
                }
                .Apply(name, args) -> {
                    loop arg in args { if contains(cx, arg, &seen) -> return true }
                    contains(cx, .Named(name), &seen)
                }
                .List(inner) | .Shared(inner) | .Option(inner) | .Tagged(_, inner) | .InlineRange(inner, _, _) -> contains(cx, inner, &seen)
                .Map(key, _, value) | .Result(key, value) -> contains(cx, key, &seen) || contains(cx, value, &seen)
                .Tuple(fields) -> {
                    loop (_, field_ty) in fields { if contains(cx, field_ty, &seen) -> return true }
                    false
                }
                .FixedList(elem, _) -> contains(cx, elem, &seen)
                .Fn(params, ret, _, _, _, _) -> {
                    loop param in params { if contains(cx, param, &seen) -> return true }
                    if ret == .Val(value) -> return contains(cx, value, &seen)
                    false
                }
                .Union(members) -> {
                    loop member in members { if contains(cx, member, &seen) -> return true }
                    false
                }
                .Quantity(base, _) -> contains(cx, base, &seen)
                else -> false
            }
        }
        seen := Set<String>.new()
        contains(self, ty, &seen)
    }

