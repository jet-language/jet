//RS     /// D-SOA1: is `name` a `#layout(columnar)` struct (local or imported)? The
//RS     /// columnar set only carries local structs; an imported columnar struct is
//RS     /// not tracked, so `[ImportedColumnar]` still lowers AoS — acceptable for v1
//RS     /// (columnar lists don't cross module boundaries in the shipped examples).
//RS     pub(crate) fn is_columnar_struct(&self, name: &str) -> bool {
//RS         self.columnar.contains(name)
//RS     }
//RS 
