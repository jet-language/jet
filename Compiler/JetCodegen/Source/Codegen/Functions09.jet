// Rust: crates/jet-codegen/src/Codegen/TIR/mod.rs:10570
fn collect_test_spans(items: [Item], module: USize, include_tests: Bool, out: &[(USize, Span, Bool)]) {
    loop item in items {
        if item == {
            .Test(test) -> out.push((module, test.span, include_tests && test.name.is_some()))
            .CodeModule(code_module) -> { if code_module.body == .Val(body) -> collect_test_spans(body, module, include_tests, &out) }
            _ -> {}
        }
    }
}
// Rust: crates/jet-codegen/src/Codegen/TIR/mod.rs:10589
fn test_reference_enabled(bundle: ProgramBundle, tests: [(USize, Span, Bool)], source: String, start: USize, end: USize) -> Bool? {
    return tests.iter().find((module, span, _) -> cost_module_path_matches(bundle, module, source) && start >= span.start && end <= span.end).map((_, _, included) -> included)
}
// Rust: crates/jet-codegen/src/Codegen/TIR/mod.rs:10606
fn collect_trait_impl_callable_groups(items: [Item], module: USize, index: CostCallableIndex, groups: &[[USize]]) {
    // Rust: crates/jet-codegen/src/Codegen/TIR/mod.rs:10612
    fn push_group(methods: [Func], module: USize, index: CostCallableIndex, groups: &[[USize]]) {
        indices: [USize] :: methods.iter().filter_map(method -> index.declared(module, method.name_span)).collect()
        if !indices.is_empty() -> groups.push(indices)
    }
    loop item in items {
        if item == {
            .Struct(definition) | .Enum(definition) -> { loop implementation in definition.trait_impls -> push_group(implementation.methods, module, index, &groups) }
            .Impl(implementation) if implementation.trait_name.is_some() -> push_group(implementation.methods, module, index, &groups)
            .CodeModule(code_module) -> { if code_module.body == .Val(body) -> collect_trait_impl_callable_groups(body, module, index, &groups) }
            _ -> {}
        }
    }
}
// Rust: crates/jet-codegen/src/Codegen/TIR/mod.rs:10656
// Scope-end cleanup implicitly roots Core Close implementations.
fn collect_core_close_callables(items: [Item], module: USize, index: CostCallableIndex, out: &[USize]) {
    // Rust: crates/jet-codegen/src/Codegen/TIR/mod.rs:10662
    fn push_close(trait_name: String, methods: [Func], module: USize, index: CostCallableIndex, out: &[USize]) {
        if trait_name.rsplit('.').next() != Val(Syntax.TRAIT_CLOSE) -> return
        out.extend(methods.iter().filter_map(method -> index.declared(module, method.name_span)))
    }
    loop item in items {
        if item == {
            .Struct(definition) | .Enum(definition) -> { loop implementation in definition.trait_impls -> push_close(implementation.trait_name, implementation.methods, module, index, &out) }
            .Impl(implementation) -> { if implementation.trait_name == .Val(trait_name) -> push_close(trait_name, implementation.methods, module, index, &out) }
            .CodeModule(code_module) -> { if code_module.body == .Val(body) -> collect_core_close_callables(body, module, index, &out) }
            _ -> {}
        }
    }
}
// Rust: crates/jet-codegen/src/Codegen/TIR/mod.rs:10706
pub fn reachable_core_source_callables(bundle: ProgramBundle, callables: [TCostCallable], core_modules: Set<USize>, include_tests: Bool, request: MirArtifactRequest, entry_name: String?) -> [Bool] {
    if core_modules.is_empty() -> return []
    tests: [(USize, Span, Bool)] := []
    loop (module, data) in bundle.modules.iter().enumerate() -> collect_test_spans(data.items, module, include_tests, &tests)
    lookup :: CostCallableIndex.new(bundle, callables)
    functions :: CostFunctionIndex.new(bundle)
    rooted := ~callables
    loop callable in &rooted {
        is_core :: core_modules.contains(callable.module)
        artifact_export :: (request.kind == .NativeLibrary || request.kind == .SandboxPlugin) && callable.module == bundle.entry && bundle.name_ledger.declaration(callable.module, callable.declaration_name).is_some_and(declaration -> declaration.visibility.is_exported())
        selected_entry :: entry_name.is_some_and(entry -> {
            identity :: module_identity(bundle, callable.module)
            "{identity}::{callable.declaration_name}" == entry || (callable.module == bundle.entry && callable.source_name == Val(entry))
        })
        ffi_callback :: callable_semantic_identity(bundle, callable).is_some_and(identity -> bundle.ffi_callback_fns.contains(identity))
        sampled_contract :: functions.get(callable.module, callable.declaration_span).is_some_and((function, _) -> !function.pre.is_empty() && !function.params.is_empty())
        private_source :: bundle.modules.get(callable.module).is_some_and(module -> CoreSourceParts.CORE_PRIVATE_SOURCE_PARTS.iter().any(part -> part.source.alias == module.alias && part.source.path == module.display))
        callable.root = callable.root || !is_core || (is_core && private_source) || artifact_export || selected_entry || ffi_callback || sampled_contract
    }
    loop ((source, start, end), reference) in bundle.name_ledger.references() {
        if !is_checked_function_reference(reference) -> continue
        if test_reference_enabled(bundle, tests, source, start, end) == Val(false) -> continue
        if !callables_containing_reference(lookup, source, start, end).is_empty() -> continue
        if callable_for_reference(bundle, rooted, lookup, reference) == .Val(target) -> rooted[target].root = true
    }
    trait_impl_groups: [[USize]] := []
    close_callables: [USize] := []
    loop (module, data) in bundle.modules.iter().enumerate() {
        if core_modules.contains(module) {
            collect_trait_impl_callable_groups(data.items, module, lookup, &trait_impl_groups)
            collect_core_close_callables(data.items, module, lookup, &close_callables)
        }
    }
    loop index in close_callables -> rooted[index].root = true
    callees :: cost_call_graph(bundle, rooted, lookup)
    reachable := reachable_from_roots(callees, rooted)
    loop {
        added_impl_method := false
        loop group in trait_impl_groups {
            if group.iter().any(index -> reachable[index]) {
                loop index in group { if !rooted[index].root { rooted[index].root = true; added_impl_method = true } }
            }
        }
        if !added_impl_method -> return ^reachable
        reachable = reachable_from_roots(callees, rooted)
    }
}
// Rust: crates/jet-codegen/src/Codegen/TIR/mod.rs:10825
// GATE #4499: exact equality/hash for module/span tuple keys.
pub fn reachable_core_source_bodies(callables: [TCostCallable], core_modules: Set<USize>, reachable: [Bool]) -> Set<(USize, USize, USize)> {
    return callables.iter().zip(reachable).filter_map((callable, live) -> if core_modules.contains(callable.module) && live { Val((callable.module, callable.declaration_span.start, callable.declaration_span.end)) } else { None }).collect()
}
// Rust: crates/jet-codegen/src/Codegen/TIR/mod.rs:10843
pub fn should_lower_imported_core_body(core_modules: Set<USize>, reachable_bodies: Set<(USize, USize, USize)>, module: USize, function: Func) -> Bool {
    return !core_modules.contains(module) || reachable_bodies.contains((module, function.name_span.start, function.name_span.end))
}
// Rust: crates/jet-codegen/src/Codegen/TIR/mod.rs:10853
fn lowered_cost_method_matches(lowered: String, expected: String) -> Bool {
    if lowered == expected || lowered.starts_with("{expected}__generic__") -> return true
    if expected.rsplit_once("::") != .Val((owner, method)) -> return false
    return lowered.starts_with("{owner}<") && lowered.ends_with("::{method}")
}
// Rust: crates/jet-codegen/src/Codegen/TIR/mod.rs:10863
fn lowered_cost_function_matches(lowered: String, expected: String) -> Bool {
    return lowered == expected || lowered.starts_with("{expected}__va") || lowered.starts_with("{expected}__generic__")
}
// Rust: crates/jet-codegen/src/Codegen/TIR/mod.rs:10869
fn cost_callable_lowered_name(bundle: ProgramBundle, callable: TCostCallable) -> String? {
    if callable.module == bundle.entry -> return Val(if callable.method { callable.declaration_name.replace('.', "::") } else { ~callable.declaration_name })
    if callable.method {
        owner_type :: callable.declaration_name.split('.').next().unwrap_or(callable.declaration_name)
        owner :: bundle.name_ledger.module_identity(impl_owner_module(bundle, callable.module, owner_type))?
        return Val("{owner}::{callable.declaration_name.replace('.', "::")}")
    }
    module :: bundle.modules.get(callable.module)?
    module_alias :: bundle.name_ledger.module_alias(callable.module)?
    relative_path :: callable.declaration_path.strip_prefix("{module_alias}.").unwrap_or(callable.declaration_path)
    namespace :: relative_path.rsplit_once('.').map((parent, _) -> parent.rsplit('.').next().unwrap_or(parent)).map_or_else(() -> mangle(module.alias), parent -> mangle(parent))
    source_name :: callable.source_name?
    return Val("{namespace}::{mangle(source_name)}")
}
// Rust: crates/jet-codegen/src/Codegen/TIR/mod.rs:10907
// GATE #4499: source-span keys retain exact Span equality/hash.
fn cost_callable_is_covered(bundle: ProgramBundle, callable: TCostCallable, lowered: [Span: [TFunc]]) -> Bool {
    if callable.source_span != .Val(source_span) -> return false
    if lowered.get(source_span) != .Val(functions) -> return false
    if cost_callable_lowered_name(bundle, callable) != .Val(expected) -> return false
    return functions.iter().any(function -> {
        if !callable.method -> return lowered_cost_function_matches(function.name, expected)
        return if function.kind == { .TraitMethod{owner_type, ..} -> lowered_cost_trait_method_matches(owner_type, function.name, expected); _ -> lowered_cost_method_matches(function.name, expected) }
    })
}
// Rust: crates/jet-codegen/src/Codegen/TIR/mod.rs:10937
fn lowered_cost_trait_method_matches(owner_type: Type, method: String, expected: String) -> Bool {
    if expected.rsplit_once("::") != .Val((owner, expected_method)) -> return false
    // Rust: crates/jet-codegen/src/Codegen/TIR/mod.rs:10944
    fn owner_leaf(name: String) -> String {
        base :: name.split('<').next().unwrap_or(name)
        return base.rsplit("::").next().unwrap_or(base)
    }
    return method == expected_method && owner_leaf(owner_type.name()) == owner_leaf(owner)
}
// Rust: crates/jet-codegen/src/Codegen/TIR/mod.rs:10951
fn collect_cost_typed_conversions(body: [Stmt], names: &Set<String>) {
    loop statement in body {
        statement.for_each_expr(expression -> { if expression == .Try(_, _, .Typed{fn_name, ..}, _) -> names.insert(~fn_name) })
    }
}
// Rust: crates/jet-codegen/src/Codegen/TIR/mod.rs:10964
fn find_cost_error_conversion(items: [Item], name: String) -> ErrorConvDef? {
    loop item in items {
        if item == {
            .ErrorConv(conversion) if error_conv_fn_name(conversion.from_ty, conversion.to_ty) == name -> return Val(conversion)
            .CodeModule(module) -> { if module.body == .Val(body) { if find_cost_error_conversion(body, name) == .Val(conversion) -> return Val(conversion) } }
            _ -> {}
        }
    }
    return None
}
// Rust: crates/jet-codegen/src/Codegen/TIR/mod.rs:10989
fn cost_error_conversion_gaps(bundle: ProgramBundle, program: TirProgram, callables: [TCostCallable], reachable: [Bool]) -> [String] {
    functions :: CostFunctionIndex.new(bundle)
    required: Set<String> := Set.new()
    loop (callable, live) in callables.iter().zip(reachable) {
        if !live || callable.foreign -> continue
        if functions.get(callable.module, callable.declaration_span) != .Val((function, _)) -> continue
        collect_cost_typed_conversions(function.body, &required)
    }
    loop {
        changed := false
        snapshot :: required.iter().cloned().collect()
        loop name in snapshot {
            if bundle.modules.iter().find_map(module -> find_cost_error_conversion(module.items, name)) != .Val(conversion) -> continue
            before :: required.len()
            collect_cost_typed_conversions(conversion.body, &required)
            changed = changed || required.len() != before
        }
        if !changed -> break
    }
    names := required.into_iter().collect()
    names.sort()
    gaps: [String] := []
    loop name in names {
        conversion :: bundle.modules.iter().enumerate().find_map((module, data) -> find_cost_error_conversion(data.items, name).map(conversion -> (module, conversion)))
        if conversion != .Val((module, conversion)) { gaps.push("typed error conversion `{name}` has no checked declaration"); continue }
        covered :: program.funcs.iter().any(function -> function.name == name && function.source_span == conversion.from_span)
        if covered -> continue
        module_label :: bundle.modules.get(module).map(module -> module.display).unwrap_or("<unknown module>")
        gaps.push("{module_label}:{name} (reachable typed error conversion has no complete TIR body)")
    }
    return ^gaps
}
// Rust: crates/jet-codegen/src/Codegen/TIR/mod.rs:11061
fn cost_coverage_gaps(bundle: ProgramBundle, program: TirProgram) -> [String] {
    app_graph :: extract_app_graph(bundle).0
    callables :: cost_callables(bundle, app_graph)
    reachable :: reachable_cost_callables(bundle, callables)
    lowered: [Span: [TFunc]] := [:]
    loop function in program.funcs -> lowered.entry(function.source_span).or_default().push(function)
    gaps: [String] := callables.iter().zip(reachable).filter_map((callable, live) -> {
        if !live || callable.foreign || cost_callable_is_covered(bundle, callable, lowered) -> return None
        reason :: if callable.type_parameterized { "type-parameterized callable has no complete TIR specialization" } else { "sema-checked callable is outside typed TIR coverage" }
        return Val("{callable.label} ({reason})")
    }).collect()
    gaps.extend(cost_error_conversion_gaps(bundle, program, callables, reachable))
    gaps.sort()
    gaps.dedup()
    return ^gaps
}
// Rust: crates/jet-codegen/src/Codegen/TIR/mod.rs:11095
pub fn cost_report(bundle: ProgramBundle) -> TCostReport TCostReportError! {
    request :: MirArtifactRequest.new(.RustAot, .NativeExecutable, .Dev)
    program :: lower_checked_tir_program_for(bundle, request) catch error -> {
        if error.message == NO_RUNNABLE_ENTRY || error.message == CLI_ENTRY_MISSING_RUN -> return TCostReport.default()
        throw TCostReportError.Lowering{reason: error.message}
    }
    gaps :: cost_coverage_gaps(bundle, program)
    if !gaps.is_empty() -> throw TCostReportError.Incomplete{surfaces: gaps}
    core_files: Set<String> :: bundle.modules.iter().filter(module -> module.is_core_source()).map(module -> module.display).collect()
    report := TCostReport.default()
    loop function in program.funcs {
        if !function.synthetic && !core_files.contains(function.source_file) -> collect_cost_stmts(function.body, function.name, function.source_span, 0, &report.sites)
    }
    return ^report
}
// Rust: crates/jet-codegen/src/Codegen/TIR/mod.rs:11157
pub struct TirCoverageIssue {
    pub tier: String
    pub callable: String
    pub reason: String
    pub span: Span
}
// Rust: crates/jet-codegen/src/Codegen/TIR/mod.rs:11172
pub fn validate_tir_support(bundle: ProgramBundle) -> [TirCoverageIssue] {
    app_graph :: extract_app_graph(bundle).0
    callables :: cost_callables(bundle, app_graph)
    reachable :: reachable_cost_callables(bundle, callables)
    contexts: [USize: Cx] := [:]
    issues: [TirCoverageIssue] := []
    loop (index, callable) in callables.iter().enumerate() {
        if callable.foreign -> continue
        if bundle.modules.get(callable.module) != .Val(module) {
            issues.push(TirCoverageIssue.{tier: "AOT", callable: ~callable.label, reason: "callable points at a missing module", span: callable.declaration_span})
            if reachable[index] -> issues.push(TirCoverageIssue.{tier: "JIT", callable: ~callable.label, reason: "callable points at a missing module", span: callable.declaration_span})
            continue
        }
        cx :: contexts.entry(callable.module).or_insert_with(() -> {
            extern_funcs :: bundle_extern_funcs(bundle)
            cx := build_cx_items(module.items, module.source, module.display, None, extern_funcs, bundle.edition)
            populate_cx_from_bundle(&cx, bundle, callable.module)
            register_own_struct_shapes(&cx, bundle, callable.module)
            collect_iterable_hooks(&cx, module.items)
            register_foreign_enum_variants(&cx, bundle, callable.module)
            update_cloneability_with_foreign_types(&cx, module.items)
            return ^cx
        })
        outcome :: validate_tir_callable(module.items, callable.declaration_span, &cx)
        if outcome == {
            .Val(.Ok(_)) -> {}
            .Val(.Err(reason)) -> {
                issues.push(TirCoverageIssue.{tier: "AOT", callable: ~callable.label, reason: ~reason, span: callable.declaration_span})
                if reachable[index] -> issues.push(TirCoverageIssue.{tier: "JIT", callable: ~callable.label, reason, span: callable.declaration_span})
            }
            .None -> {
                reason :: "checked callable has no TIR validation route"
                issues.push(TirCoverageIssue.{tier: "AOT", callable: ~callable.label, reason, span: callable.declaration_span})
                if reachable[index] -> issues.push(TirCoverageIssue.{tier: "JIT", callable: ~callable.label, reason, span: callable.declaration_span})
            }
        }
    }
    issues.sort_by((left, right) -> left.tier.cmp(right.tier).then(left.callable.cmp(right.callable)).then(left.span.start.cmp(right.span.start)))
    issues.dedup()
    return ^issues
}
// Rust: crates/jet-codegen/src/Codegen/TIR/mod.rs:11272
// Optional route result distinguishes missing AST routes from unsupported checked routes.
fn validate_tir_callable(items: [Item], declaration_span: Span, cx: &Cx) -> Result<Void, String>? {
    loop item in items {
        if item == {
            .Func(function) if function.name_span == declaration_span -> {
                if function.inline_foreign.is_some() || tir_covers(function, cx) -> return Val(Ok({}))
                return Val(Err("function is outside tir_covers ({describe(cx)})"))
            }
            .Struct(definition) | .Enum(definition) -> {
                if definition.methods.iter().find(method -> method.name_span == declaration_span) == .Val(method) -> return Val(validate_tir_method(method, definition.name, None, false, &cx))
                loop implementation in definition.trait_impls {
                    if implementation.methods.iter().find(method -> method.name_span == declaration_span) == .Val(method) -> return Val(validate_tir_method(method, definition.name, Val(implementation.trait_name), implementation.compiler_generated, &cx))
                }
            }
            .Impl(implementation) -> {
                if implementation.os_target.is_some_and(target -> target != cx.active_os) {
                    if implementation.methods.iter().any(method -> method.name_span == declaration_span) -> return Val(Ok({}))
                    continue
                }
                if implementation.methods.iter().find(method -> method.name_span == declaration_span) == .Val(method) -> return Val(validate_tir_method(method, implementation.type_name, implementation.trait_name, implementation.is_generated_serde, &cx))
            }
            .CodeModule(module) -> { if module.body == .Val(body) { if validate_tir_callable(body, declaration_span, &cx) == .Val(result) -> return Val(result) } }
            _ -> {}
        }
    }
    return None
}
// Rust: crates/jet-codegen/src/Codegen/TIR/mod.rs:11392
fn validate_tir_method(method: Func, owner: String, trait_name: String?, compiler_generated: Bool, cx: &Cx) -> Result<Void, String> {
    covered :: if trait_name == {
        .Val(name) -> tir_covers_trait_method(method, owner, cx, name) || (compiler_generated && tir_covers_compiler_derive_method(method, cx))
        .None -> tir_covers_method(method, owner, cx)
    }
    return if covered { Ok({}) } else { Err("method is outside tir_covers ({describe(cx)})") }
}
// Rust: crates/jet-codegen/src/Codegen/TIR/mod.rs:11421
pub fn view_copy_kind(source: Type) -> MirViewCopyKind? {
    return if source == {
        .Tagged{inner, ..} -> view_copy_kind(inner)
        .String -> Val(.String)
        .List(_) | .FixedList{..} -> Val(.List)
        .Apply{name, args} if args.len() == 1 && (name == "View" || name == "ViewMut") -> Val(if args[0] == .Named("str") { .String } else { .List })
        _ -> None
    }
}
// Rust: crates/jet-codegen/src/Codegen/TIR/mod.rs:11442
fn view_copy_view_element(source: Type) -> Type? {
    return if source == {
        .Tagged{inner, ..} -> view_copy_view_element(inner)
        .Apply{name, args} if args.len() == 1 && (name == "View" || name == "ViewMut") -> Val(args[0])
        _ -> None
    }
}
// Rust: crates/jet-codegen/src/Codegen/TIR/mod.rs:11457
pub fn view_copy_owned_type(source: Type) -> Type? {
    element :: view_copy_view_element(source)?
    return Val(if element == .Named("str") { .String } else { .List(~element) })
}
// Rust: crates/jet-codegen/src/Codegen/TIR/mod.rs:11486
pub fn allocator_constructor_owner(recv_type: String?, method: String) -> String? {
    owner :: recv_type?
    valid :: if owner == { "Arena" | "Bump" | "Pool" -> method == "new"; "Fixed" -> method == "new" || method == "over"; _ -> false }
    return if valid { Val(owner) } else { None }
}
