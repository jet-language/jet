//RS /// Typed allocator constructor fact carried by TIR into the shared MIR
//RS /// allocation operation. No backend constructor spelling crosses this seam.
//RS #[derive(Clone)]
//RS pub enum TAllocCtor {
//RS     Arena,
//RS     Bump,
//RS     Pool,
//RS     /// `Fixed.new(size: N)` carries sema's positive comptime capacity.
//RS     Fixed {
//RS         size: usize,
//RS     },
//RS     /// `Fixed.over` borrows an existing mutable fixed byte buffer.
//RS     FixedOver,
//RS }
//RS /// Return the allocator constructor owner from sema's checked method facts.
//RS ///
//RS /// The front end rewrites core-module constructor receivers to their nominal
//RS /// sentinel (`Arena`, `Bump`, `Pool`, or `Fixed`) before TIR sees the checked
//RS /// AST. Keep constructor admission on that carried dispatch fact rather than
//RS /// re-walking source spelling or guessing from a backend name.
//RS pub(crate) fn allocator_constructor_owner<'a>(
//RS     recv_type: Option<&'a str>,
//RS     method: &str,
//RS ) -> Option<&'a str> {
//RS     let owner = recv_type?;
//RS     let valid = match owner {
//RS         "Arena" | "Bump" | "Pool" => method == "new",
//RS         "Fixed" => matches!(method, "new" | "over"),
//RS         _ => false,
//RS     };
//RS     valid.then_some(owner)
//RS }
//RS 
//RS /// #4318: the copy fact of a call argument sema marked for copying: a
//RS /// shared-reference retain is a share; an owning parameter filled from a
//RS /// value the caller keeps materializes (D-MEM-COPYSEM1).
//RS pub(crate) fn call_arg_copy_fact(arc_clone: bool) -> jet_foundation::MIR::MirCopyFact {
//RS     if arc_clone {
//RS         jet_foundation::MIR::MirCopyFact::Share
//RS     } else {
//RS         jet_foundation::MIR::MirCopyFact::Materialize
//RS     }
//RS }
