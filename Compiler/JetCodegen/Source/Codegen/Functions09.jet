//RS #[derive(Clone)]
//RS pub enum TExprKind {
//RS     /// Integer literal with its D-SG9 width (`None` = default `Int`/i64). The
//RS     /// width is the elaborated `(signed, bits)` sema attached to the AST node.
//RS     IntLit(i64, Option<(bool, u8)>),
//RS     FloatLit(f64),
//RS     BoolLit(bool),
//RS     CharLit(char),
//RS     /// String literal / interpolation. Each part is literal text or an
//RS     /// interpolated TExpr (totally typed, like every other node).
//RS     StrLit(Vec<TStrPart>),
//RS     /// A local or parameter slot, resolved to its Jet binding name plus the
//RS     /// by-reference deref fact. Emit spells the Rust place; no engine parses it.
//RS     Local(TLocal),
//RS     /// Unit / default / uninit / comptime / host forms — structured facts only.
//RS     /// Scalar comptime values use IntLit/BoolLit/CharLit via `lower_comptime_scalar`.
//RS     Unit,
//RS     /// Compiler-private result block used by finite yielding loops. Unlike a
//RS     /// lambda, it executes in the current function, so `return` and cleanup
//RS     /// retain ordinary loop semantics.
//RS     InlineBlock(Vec<TStmt>),
//RS     DefaultLit,
//RS     Uninit,
//RS     CtLit(crate::AST::CtValue),
//RS     HostCall(Box<THostCall>),
//RS     /// A reference to a declared (non-comptime) const, by its Jet name. Emit
//RS     /// resolves the Rust static name; other engines look the value up by the
//RS     /// same Jet name in their own const table.
//RS     ConstRef(String),
//RS     /// D-ENC-DYN1: collect the ordered `Data` object entries a
//RS     /// `TPatternPosition::DataEntries` test captured into the user-visible map.
//RS     DataEntriesToMap(TLocal),
//RS     /// Call to a plain top-level function. Each arg carries its emit decisions.
//RS     Call {
//RS         name: String,
//RS         /// D-GENERIC-CALL1=A: explicit source-level type arguments. This is
//RS         /// separate from value arguments so result-only generics retain their
//RS         /// specialization in every execution tier.
//RS         type_args: Vec<Type>,
//RS         args: Vec<TCallArg>,
//RS     },
//RS     /// Transparent constructor for an unchecked distinct value. Resident JIT
//RS     /// lowers this to the base scalar; AOT emits the nominal tuple constructor.
//RS     DistinctCtor {
//RS         name: String,
//RS         arg: Box<TExpr>,
//RS         base: Type,
//RS     },
//RS     /// D-RANGETYPE1: checked constructor for `distinct Int(lo..hi)` under
//RS     /// postfix `?`. Emits `__jet_T::try_new(arg)` returning `Result<__jet_T,
//RS     /// String>`; the enclosing `Try` node handles propagation.
//RS     RangeCheckedCtor {
//RS         name: String,
//RS         arg: Box<TExpr>,
//RS     },
//RS     /// D-SHAPE-CONVERT1=A: numeric-backed distinct/unit conversion. `op`
//RS     /// converts the named source into the distinct base; emit then wraps the
//RS     /// value, composing a fallible numeric conversion and/or range check.
//RS     DistinctConvert {
//RS         name: String,
//RS         arg: Box<TExpr>,
//RS         op: TNumericOp,
//RS         range: Option<(i64, i64)>,
//RS         /// Sema's authoritative return contract. A literal may discharge a
//RS         /// distinct range check, but never a conversion declared fallible.
//RS         fallible: bool,
//RS     },
//RS     /// D-QUANTITY-CONVERT1=B: a checked or explicitly rounded conversion
//RS     /// between two members of one package-owned unit family. The backend sees
//RS     /// only erased Float values and resolved conversion coefficients.
//RS     UnitConvert {
//RS         destination: String,
//RS         arg: Box<TExpr>,
//RS         scale: crate::AST::UnitRatio,
//RS         offset: crate::AST::UnitRatio,
//RS         rounding: Option<(jet_foundation::UnitRoundingMode, Box<TExpr>)>,
//RS         fallible: bool,
//RS         /// First-order relative standard uncertainty contributed by measured
//RS         /// unit scales. `None` keeps the ordinary exact quantity result.
//RS         relative_uncertainty: Option<f64>,
//RS         file: String,
//RS         line: u32,
//RS     },
//RS     /// D-SIMD2 / D-LINALG1: a built-in math-type constructor `F32x4(a,b,c,d)` /
//RS     /// `Vec3(x,y,z)` / `Mat3(…)`, or a static method `F32x4.splat(x)` /
//RS     /// `Vec3.from_array(a)`. Emits the prelude free function `{root}jet_math_<T>_<fn>(…)`
//RS     /// (`_new` for the constructor) with plainly-lowered float/array args.
//RS     MathBuiltin {
//RS         type_name: String,
//RS         func: String,
//RS         args: Vec<TExpr>,
//RS     },
//RS     /// D-DECIMAL1 / D-NUMTYPE1: precise numeric ctor/method/binop.
//RS     PreciseBuiltin {
//RS         type_name: String,
//RS         func: String,
//RS         args: Vec<TExpr>,
//RS     },
//RS     /// `print(x)` — the one builtin the subset covers.
//RS     Print(Box<TExpr>),
//RS     /// Explicit terminal ownership consumption.
//RS     Drop(Box<TExpr>),
//RS     /// Explicit resource close operation.
//RS     Close(Box<TExpr>),
//RS     /// D-LIN1-DROP (ratified 2026-06-25): `drop(x)` — deliberately discard a
//RS     /// value (a `#SingleUse` value's audited terminal consumption). Lowers to a
//RS     /// plain `drop(arg)` in Rust: a move-to-nowhere whose `Drop` runs. No
//RS     /// `unsafe` is emitted (I3) — the `#Unsafe` gate is a sema-only audit.
//RS     /// Explicit source `AccessConvention::Move` for a Core argument.  This
//RS     /// ownership marker is distinct from the Core row's borrow mask: a
//RS     /// non-borrowed scalar/value argument may still be read or copied, while
//RS     /// this node is emitted only when sema proved an owning move.
//RS     Move(Box<TExpr>),
//RS     ResourceNew(Box<TExpr>),
//RS     ResourceTake(TLocal),
//RS     /// c109 Phase 25: the ambient prelude `input(...)` (D-PRELUDE1 = B). A bare call
//RS     /// (no module alias) lowering to `{root}jet_std_io_input(None|Some(&(prompt)))`,
//RS     /// byte-for-byte the ambient-input call branch. `prompt` is `Some` when a String
//RS     /// prompt arg is given, else `None`.
//RS     /// parity: guard tests/tir_language_features.rs::ambient_input
//RS     AmbientInput {
//RS         prompt: Option<Box<TExpr>>,
//RS     },
//RS     /// c109 Phase 26: an `assert(cond[, msg])` / `assert_eq(a, b)` / `panic(msg)`
//RS     /// rich-runtime-report builtin (S36). Structured facts only — emit formats
//RS     /// `jet_panic_rich` / test-mode `return Err` (I3: no `cx.src` re-read for
//RS     /// location; `loc` was captured at lowering).
//RS     RequireStop {
//RS         kind: TRequireKind,
//RS         loc: TPanicLoc,
//RS         /// True only for the unconditional builtin `panic(...)`; `assert`
//RS         /// may fall through when the condition holds.
//RS         always_stops: bool,
//RS     },
//RS     /// Binary op. `overflow` is the *computed* decision (true → emit the
//RS     /// trapping `jet_add`/… helper). It mirrors today's `operand_is_integer`
//RS     /// logic but is decided here, at lowering, from the total operand types.
//RS     /// `line` is the source line of the operator, resolved at lowering, so the
//RS     /// trapping helper's panic location matches the AST path byte-for-byte (the
//RS     /// emitter never touches `cx.src`).
//RS     Binary {
//RS         op: BinOp,
//RS         overflow: bool,
//RS         line: u32,
//RS         lhs: Box<TExpr>,
//RS         rhs: Box<TExpr>,
//RS     },
//RS     /// D-CHAINCMP1: `0 <= sev < 10` — a same-direction relational chain,
//RS     /// `operands.len() == ops.len() + 1`. Dumb lowering (R1): emit binds each
//RS     /// shared middle operand to a temp exactly once (a Rust block expression),
//RS     /// then ANDs the adjacent-pair comparisons over those temps. Relational
//RS     /// ops never trap on overflow (only `+ - * / << >>` do), so no `overflow`
//RS     /// flag is needed here.
//RS     CompareChain {
//RS         operands: Vec<TExpr>,
//RS         ops: Vec<BinOp>,
//RS         hooks: Vec<bool>,
//RS     },
//RS     /// D-LAYOUT1 / D-LAYOUT-GATES1 (GATE 1): `>=`/`<=`/`==` between layout
//RS     /// values (`HVar`/`VVar`/`LengthVar`) produce a `Constraint`, which Rust's
//RS     /// comparison operators can't do via operator syntax (`PartialOrd`/
//RS     /// `PartialEq` are hard-locked to `bool`) — so this is a DEDICATED node,
//RS     /// not `Binary`. Emits the matching `jet_layout::{ge,le,eq_}(lhs, rhs)`
//RS     /// free function (registers the constraint on whichever side's `LinExpr`
//RS     /// carries the owning handle). `Add`/`Sub` between layout values stay
//RS     /// plain `Binary` — `jet_layout::LinExpr` implements `std::ops::{Add,Sub}`.
//RS     LayoutCompare {
//RS         op: BinOp,
//RS         lhs: Box<TExpr>,
//RS         rhs: Box<TExpr>,
//RS     },
//RS     /// D-LAYOUT1: a plain `Int`/`Float` operand used on the other side of a
//RS     /// layout `+`/`-`/`>=`/`<=`/`==` (axis-neutral, elaborates to `LengthVar`
//RS     /// — see `layout_axis_of`). Wraps the numeric Rust value into a
//RS     /// `jet_layout::LinExpr` constant so `Add`/`Sub`/`ge`/`le`/`eq_` only
//RS     /// ever operate on `LinExpr` (no foreign-type operator-overload games
//RS     /// with bare `f64`/`i64`).
//RS     LayoutLit {
//RS         inner: Box<TExpr>,
//RS     },
//RS     Unary {
//RS         op: UnOp,
//RS         operand: Box<TExpr>,
//RS     },
//RS     /// c109 Phase 3: a struct literal `S { f: v, … }`. The head type is `TExpr.ty`;
//RS     /// each field carries its Jet name (emit mangles) and value. No clone/coercion
//RS     /// at the literal site (mirrors the AST path).
//RS     StructLit {
//RS         /// Each field: Jet name, value, and `boxed` for self-referential `Box<…>` edges.
//RS         fields: Vec<(String, TExpr, bool)>,
//RS         /// c109 Phase 17: injected prelude fields (HTTPRequest route metadata).
//RS         /// Structured — emit spells the Rust field lines.
//RS         extra: Option<TStructExtra>,
//RS         /// c109 Phase 30: TRAIT-OBJECT coercion — `(trait, concrete owner)`.
//RS         as_trait: Option<(String, String)>,
//RS     },
//RS     /// c109 Phase 3: a struct field *read* `recv.field` in borrow position.
//RS     /// `field` is the Jet field name (emit mangles / core-renames).
//RS     Field {
//RS         recv: Box<TExpr>,
//RS         field: String,
//RS         boxed: bool,
//RS     },
//RS     /// D-SHAREDGUARD2=A: compiler-known `guard.value` projection. The public
//RS     /// guard has no Rust field; it dereferences its owned lock lease.
//RS     SharedGuardValue {
//RS         guard: Box<TExpr>,
//RS         editable: bool,
//RS     },
//RS     /// D-SHAREDGUARD1=A: consume one guard and retain the same lock lease while
//RS     /// narrowing its visible value to a sema-validated field path.
//RS     SharedGuardMap {
//RS         guard: Box<TExpr>,
//RS         path: Vec<String>,
//RS         editable: bool,
//RS     },
//RS     /// D-SHAREDGUARD1=A: consume one guard and create two disjoint views backed
//RS     /// by the same lock lease. Sema proved the paths do not overlap.
//RS     SharedGuardSplit {
//RS         guard: Box<TExpr>,
//RS         first: Vec<String>,
//RS         second: Vec<String>,
//RS         editable: bool,
//RS     },
//RS     /// D-SHAREDGUARD1=A: wait on a condition while retaining ownership of the
//RS     /// edit guard. The runtime performs register/release/park/reacquire/recheck.
//RS     SharedGuardWait {
//RS         guard: Box<TExpr>,
//RS         condition: Box<TExpr>,
//RS         predicate: Box<TLambda>,
//RS     },
//RS     /// D-SHAREDGUARD1=A: wake one or every waiter registered on a Condition.
//RS     ConditionNotify {
//RS         condition: Box<TExpr>,
//RS         all: bool,
//RS     },
//RS     /// c109 Phase 18: `mem.Ptr<T>.from_addr(addr)`. `elem` is the Jet element type;
//RS     /// emit spells `(({addr}) as usize as *mut {elem})`.
//RS     PtrFromAddr {
//RS         elem: Type,
//RS         addr: Box<TExpr>,
//RS     },
//RS     /// D-CAP9: postfix `p.*` — dereference a raw pointer. Emits Rust `(*(p))`. The
//RS     /// `unsafe` needed to read through a raw pointer is supplied by the enclosing
//RS     /// `#Unsafe` region/fn (sema-gated by E0208), so this node adds no `unsafe`.
//RS     Deref(Box<TExpr>),
//RS     /// D-CAP9: prefix `*x` — take a raw pointer to `x`. Emits `(&(x) as *const _)`.
//RS     /// Forming a pointer is safe Rust; *using* it needs the surrounding `#Unsafe`
//RS     /// region. Gated by E0208 in sema (raw-of only legal inside `#Unsafe`).
//RS     RawOf(Box<TExpr>),
//RS     /// Allocator constructor. The constructor family and checked arguments
//RS     /// remain structured until each target consumes the shared MIR fact.
//RS     AllocNew {
//RS         ctor: TAllocCtor,
//RS         args: Vec<TCallArg>,
//RS     },
//RS     EnumLit {
//RS         /// Jet enum type name. Emit spells the Rust path via `tir_enum_lit_prefix`.
//RS         enum_type: String,
//RS         /// Jet variant name.
//RS         variant: String,
//RS         payload: TEnumPayload,
//RS     },
//RS     /// c109 Phase 24: a prelude `JSON` enum construction (`JSON.Null` /
//RS     /// `JSON.Boolean(b)` / `JSON.Number(n)` / `JSON.Text(s)` / `JSON.Array(xs)` /
//RS     /// `JSON.Object(map)`). The JSON enum is FOREIGN: its variants render non-mangled
//RS     /// (`{root}jet_std::JSON::Object`, NOT `__jet_…`), distinct from a user enum's
//RS     /// `EnumLit`. `variant` is the bare variant name (`Object`/`Text`/…). `arg` is the
//RS     /// payload `TExpr` plus the resolved `implicit_clone` flag (sema's `CallArg.flags`,
//RS     /// total) — `true` → `(…).clone()`, reproducing `emit_core_json_lit` (Expression.rs)
//RS     /// byte-for-byte. `JSON.Null` has no arg (`None`). The `{root}jet_std::JSON` prefix
//RS     /// is rendered at emit (`cx.root_prefix` is program-level, read there).
//RS     /// parity: guard tests/tir_language_features.rs::json_value_construct_match_render
//RS     JSONLit {
//RS         variant: String,
//RS         arg: Option<Box<(TExpr, bool)>>,
//RS     },
//RS     /// D-DBDRIVER1: a `DBValue` construction (`DBValue.Int(n)` / `.Float(f)` /
//RS     /// `.Text(s)` / `.Bool(b)` / `.Blob(bytes)` / `.Null`) — the tagged SQL
//RS     /// parameter/column value. Same shape as `JSONLit` (a FOREIGN prelude enum,
//RS     /// not a user `EnumLit`), kept as its own node rather than reusing `JSONLit`
//RS     /// because `DBValue` renders to a DIFFERENT prelude type (`jet_std::DBValue`,
//RS     /// not `jet_std::DataTree`) and has no recursive `Array`/`Object`-style
//RS     /// payload to special-case.
//RS     DBValueLit {
//RS         variant: String,
//RS         arg: Option<Box<(TExpr, bool)>>,
//RS     },
//RS     /// c109 Phase 5: a list literal `[a, b, c]`. Lowers to Rust `vec![…]`. Each
//RS     /// element is lowered as-is (the AST path applies no clone/coercion at the
//RS     /// literal site — `emit_expr` per element).
//RS     ListLit(Vec<TExpr>),
//RS     /// D-VARIADIC1: `[a, ...xs, b]` — one growable list built via `extend`.
//RS     ListSpread {
//RS         parts: Vec<ListSpreadPart>,
//RS     },
//RS     /// D-SOA1 / D-SOA-TIER1=A: a list literal whose element is a
//RS     /// `#layout(columnar)` struct `S`. The elements build the array-of-structs,
//RS     /// then the shared column store scatters them across the columns.
//RS     /// `columns_ty` is the resolved `[S]` Rust type — the Prelude-owned
//RS     /// `JetColumnList<S>`, never a per-struct storage type.
//RS     ColumnarListLit {
//RS         columns_ty: String,
//RS         elems: Vec<TExpr>,
//RS     },
//RS     /// D-SOA1 / D-SOA-TIER1=A: index-read `xs[i]` on a columnar list — pulls the
//RS     /// logical `S` out of the columns at `i` through THE shared gather read,
//RS     /// bounds-checked with the same list stop an array-of-structs `xs[i]` uses.
//RS     ColumnarGather {
//RS         base: Box<TExpr>,
//RS         index: Box<TExpr>,
//RS         line: usize,
//RS     },
//RS     /// D-SOA1 / D-SOA-TIER1=A: a fused `xs[i].field` field-read on a columnar
//RS     /// list — one cell straight out of that field's column, with no whole-`S`
//RS     /// gather. This is the cache-friendly fast path.
//RS     ///
//RS     /// `owner` and `field` are checked semantic identities. `column` is the
//RS     /// field's position in declaration order among stored fields, exactly the
//RS     /// column order used by the shared store.
//RS     ColumnarColumnRead {
//RS         base: Box<TExpr>,
//RS         index: Box<TExpr>,
//RS         owner: String,
//RS         field: String,
//RS         column: usize,
//RS         line: usize,
//RS     },
//RS     /// c109 Phase 23: a named-tuple literal `(x: 1, y: 2)` (S73/D-SG7). The generated
//RS     /// struct name (`JetTup_<hash>`) and the CANONICAL field order are resolved at
//RS     /// lowering from the literal's sema-attached `Type::Tuple`; each field's value is
//RS     /// reordered to that canonical order (a `(y: 3, x: 4)` literal becomes
//RS     /// `(x: 4, y: 3)`). `fields` pair each CHECKED field name with its lowered value:
//RS     /// MIR resolves a tuple field by `<instance>::<name>` against the `Type::Tuple`
//RS     /// shape, and every backend mangles from its own field row.
//RS     TupleLit {
//RS         struct_name: String,
//RS         fields: Vec<(String, TExpr)>,
//RS     },
//RS     /// c109 Phase 5: a map literal `[k: v, …]` or empty `[:]`. A map remains
//RS     /// one typed value through TIR; each engine constructs it from these
//RS     /// ordered pairs, so nested maps are ordinary value expressions.
//RS     MapLit(Vec<(TExpr, TExpr)>),
//RS     /// c109 Phase 5: indexing `coll[i]` (`Expr::Index`). `is_map` is the resolved
//RS     /// `IndexKind` carried TOTALLY from sema (never re-inferred): `true` → the
//RS     /// `jet_index_map` helper, `false` → `jet_index_vec`. `line` is the source line
//RS     /// for the bounds/missing-key panic message, resolved at lowering.
//RS     Index {
//RS         base: Box<TExpr>,
//RS         index: Box<TExpr>,
//RS         is_map: bool,
//RS         /// The base uses the vetted `JetUninitFixed` prelude wrapper in AOT.
//RS         uninit_fixed: bool,
//RS         line: usize,
//RS     },
//RS     /// D-MEM1 S6: `pool[id]` / `pool[id].field` — a generation-checked slot in a
//RS     /// `Pool<T>`. `mutable` selects the in-place `jet_pool_get_mut` place over the
//RS     /// `jet_pool_get` value clone, so a write or a mutating receiver edits the
//RS     /// stored element instead of a throwaway copy. `field_rust` narrows the place
//RS     /// to one mangled field. `src_line` is captured at lowering so every engine
//RS     /// receives the stop's own source line rather than a function-frame fallback.
//RS     PoolSlot {
//RS         pool: Box<TExpr>,
//RS         id: Box<TExpr>,
//RS         mutable: bool,
//RS         /// Jet field name when narrowing `pool[id].field`; emit mangles.
//RS         field: Option<String>,
//RS         line: usize,
//RS         src_line: String,
//RS     },
//RS     /// D-INDEX-HOOK: `mytype[k]` when the type implements `Index`.
//RS     IndexHook {
//RS         type_name: String,
//RS         base: Box<TExpr>,
//RS         index: Box<TExpr>,
//RS         line: usize,
//RS     },
//RS     /// D-SIMD2: `v[i]` lane access on a SIMD lane type. Lowers to the bounds-checked
//RS     /// prelude helper `{root}jet_math_<T>_lane(&v, i, file, line)`.
//RS     MathLaneIndex {
//RS         lane_ty: String,
//RS         base: Box<TExpr>,
//RS         index: Box<TExpr>,
//RS         line: u32,
//RS     },
//RS     /// D-SWIZZLE1: a read swizzle `v.xyz` on a vector/SIMD lane type. `lanes` holds
//RS     /// source indices (x=0…w=3); length 1 → scalar, 2..4 → `VecN` constructor.
//RS     MathSwizzleRead {
//RS         type_name: String,
//RS         recv: Box<TExpr>,
//RS         lanes: Vec<u8>,
//RS     },
//RS     /// An owned slice expression. Place contexts lower the same source shape to
//RS     /// `ViewNew` or `ViewMutNew`; explicit copy stays here. `line` identifies
//RS     /// bounds failures.
//RS     Slice {
//RS         base: Box<TExpr>,
//RS         start: Box<TExpr>,
//RS         end: Box<TExpr>,
//RS         /// D-RANGE-VALUE1=A: a stored Range source, evaluated once.
//RS         range: Option<Box<TExpr>>,
//RS         line: usize,
//RS     },
//RS     /// c109 Phase 6: the sema-inserted `.clone()` on an owning non-Copy field read
//RS     /// or borrowed value. This is ordinary sharing/cloning semantics. The
//RS     /// user-written `~` copy has its own `ExplicitCopy` node so a Tensor does not
//RS     /// silently turn compiler-inserted clones into deep storage copies. The
//RS     /// fact (#4318) is the sema decision behind the copy; MIR keeps it on `Copy`.
//RS     Clone(Box<TExpr>, jet_foundation::MIR::MirCopyFact),
//RS     /// D-MEM1/D-CAP2: the explicit Jet `~` copy signal. Backends route Tensor
//RS     /// values through the shared Prelude copy operation; non-Tensor values keep
//RS     /// their ordinary clone/materialization semantics.
//RS     ExplicitCopy(Box<TExpr>),
//RS     /// D-SHAPE-PLACE1=A: a checked local whole/field/index place borrow.
//RS     /// Range places use `ViewNew`/`ViewMutNew` so bounds are checked once.
//RS     Borrow {
//RS         place: Box<TExpr>,
//RS         mutable: bool,
//RS     },
//RS     /// D-MEM-COPYSEM1: an explicit `~` or an implicit read-only view crossing
//RS     /// an owning destination materializes the owned target through the shared
//RS     /// Prelude. A plain `.clone()` is not sufficient for string views: cloning
//RS     /// a `&str` hands back another `&str`, not the owned `String` needed to leave
//RS     /// the view's scope. Generic `View<T>` uses the same path to produce `[T]`.
//RS     MaterializeView(Box<TExpr>),
//RS     /// c109 Phase 6: a user-defined instance method call `recv.method(args)` on a
//RS     /// covered struct/enum. All dispatch facts are resolved at lowering (totality):
//RS     /// `recv` is the lowered receiver (emitted as the AST path emits it — autoref
//RS     /// handles `&self`/`&mut self`/`self`); `method_rust` is the already-resolved
//RS     /// Rust method name (mangled `__jet_<m>`, or the bare name for a trait-impl
//RS     /// method, decided here from `cx.trait_methods`); each arg carries its
//RS     /// borrow/clone decisions, mirroring `emit_call_args`.
//RS     MethodCall {
//RS         recv: Box<TExpr>,
//RS         method: TMethodRef,
//RS         /// D-GENERIC-CALL1=A: resolved method-owned call arguments, explicit or
//RS         /// inferred. Empty for a non-generic method.
//RS         type_args: Vec<Type>,
//RS         args: Vec<TCallArg>,
//RS         /// First source argument when it is one plain string literal. The
//RS         /// comptime BuildContext host surface uses this to preserve the
//RS         /// auditability rule for `b.find("glob")`.
//RS         source_first_string_literal: Option<String>,
//RS         /// Hidden source bridge for generic arithmetic trait dispatch. User
//RS         /// methods keep their two-argument surface; primitive impls receive
//RS         /// the Jet operator line through the synthetic trait's default helper.
//RS         operator_line: Option<u32>,
//RS     },
//RS     /// c109 Phase 7: a STATIC (associated) method call `Type.make(args)`. Resolved
//RS     /// at lowering to `__jet_<Type>::__jet_<method>(args)` — `type_prefix` is the
//RS     /// already-resolved Rust type head (`__jet_<Type>`), `method_rust` the mangled
//RS     /// method name. Mirrors the AST type-name dispatch (Expression.rs ~L1644).
//RS     StaticCall {
//RS         owner: TStaticOwner,
//RS         owner_type: Option<Type>,
//RS         method: TMethodRef,
//RS         /// D-GENERIC-CALL1=A: resolved method-owned call arguments on a static
//RS         /// method, explicit or inferred. Receiver/owner arguments live in
//RS         /// `owner_type`.
//RS         type_args: Vec<Type>,
//RS         args: Vec<TCallArg>,
//RS     },
//RS     /// D-VALIDATE-DECODE1=B: prefix every error in a typed child result while
//RS     /// preserving its success value. The segment and result are already
//RS     /// lowered; every execution tier applies the same list transform.
//RS     DecodeUnder {
//RS         segment: Box<TExpr>,
//RS         inner: Box<TExpr>,
//RS     },
//RS     /// c109 Phase 9: a built-in collection/string method (`emit_builtin_method`).
//RS     /// The receiver-type dispatch (`expr_jet_ty(receiver)` → Map/List/String) is
//RS     /// resolved at lowering into a concrete `op`, so emit makes no type decision
//RS     /// (I3). The args are lowered as PLAIN expressions — `emit_builtin_method`
//RS     /// emits each arg via a raw `emit_expr`, with NO clone/borrow convention
//RS     /// wrappers (unlike `emit_call_args`), so the TIR carries no `TCallArg` here.
//RS     BuiltinMethod {
//RS         recv: Box<TExpr>,
//RS         op: TBuiltinOp,
//RS         args: Vec<TExpr>,
//RS     },
//RS     /// A checked Core registry row plus its typed argument facts.  The record
//RS     /// owns module/member identity and all ABI/effect/interpreter metadata;
//RS     /// TIR never reconstructs those facts from strings.  `type_args` retains
//RS     /// the explicit generic arguments for Core calls whose runtime behavior
//RS     /// depends on a checked operation schema (notably `testing.histories<T>`).
//RS     CoreCall {
//RS         record: &'static crate::Syntax::CoreCallRecord,
//RS         args: Vec<TExpr>,
//RS         source_span: crate::Diagnostics::Span,
//RS         type_args: Vec<Type>,
//RS         /// D-FIXARR1: per-argument `[T#N]` to `[T]` widening, resolved from
//RS         /// the authoritative Core signature during lowering.
//RS         widen_to_vec: Vec<bool>,
//RS         /// Checked table-plan fact, present only for recognized `core.data`
//RS         /// calls.  Backends must consume this fact rather than reclassifying
//RS         /// the call from the registry row.
//RS         data_plan: Option<TDataPlan>,
//RS         /// Checked result failure transport, shared by every CoreCall route.
//RS         fallibility: TFailureCarrier,
//RS     },
//RS     /// `if`-expression form (S68 / D-SG2). Both arms are value blocks.
//RS     IfExpr {
//RS         cond: Box<TIfCond>,
//RS         then_body: Vec<TStmt>,
//RS         then_value: Box<TExpr>,
//RS         else_body: Vec<TStmt>,
//RS         else_value: Box<TExpr>,
//RS     },
//RS     /// A checked Result handler evaluates its carrier once, borrows it for the
//RS     /// variant tests, and consumes exactly the selected payload. The parser's
//RS     /// duplicated pattern-test AST must not become two owned Result reads.
//RS     ResultHandler {
//RS         subject: Box<TExpr>,
//RS         ok_pattern: TPattern,
//RS         ok_body: Vec<TStmt>,
//RS         ok_value: Box<TExpr>,
//RS         err_pattern: TPattern,
//RS         err_body: Vec<TStmt>,
//RS         err_value: Box<TExpr>,
//RS         terminal: Box<TExpr>,
//RS     },
//RS     /// D-FAIL-BREACH1=A: a `#Todo` typed goal (`Expr::Todo`, D-TOOL2, E2-M11)
//RS     /// emits the registered E3011 Prelude stop. The enclosing `TExpr.ty` is
//RS     /// the checked expected type; `line` is the source line resolved at lowering.
//RS     Todo {
//RS         line: usize,
//RS     },
//RS     /// A structurally impossible post-sema shape. Old adapters surface this
//RS     /// as an ICE; canonical MIR returns a typed lowering error.
//RS     InvariantViolation {
//RS         construct: String,
//RS         span: crate::Diagnostics::Span,
//RS     },
//RS     /// Card #1440: the synthesized dead end of an else-less exhaustive value
//RS     /// dispatch (`Expr::NoElse`). Sema proved the pattern arms cover the
//RS     /// subject's whole type (E0307), so no execution reaches it on any tier —
//RS     /// AOT emits a diverging `unreachable!(…)`, JIT traps, TIR-eval errors.
//RS     Unreachable {
//RS         line: usize,
//RS     },
//RS     /// c109 Phase 23: `.raw()` on a distinct type (`Expr::MethodCall { method: "raw" }`,
//RS     /// D-DIST3). The AST `emit_method_call` special-cases this BEFORE any user dispatch:
//RS     /// `({recv}).0` (the newtype's inner field). The receiver is lowered as-is; the
//RS     /// result `ty` is the distinct base type (total, read from `cx.distinct_types`).
//RS     DistinctRaw(Box<TExpr>),
//RS     /// c109 Phase 8: `value(x)` — a present optional (`Some(x)`).
//RS     Present(Box<TExpr>),
//RS     /// c109 Phase 8: bare `null` — an absent optional (`None`).
//RS     Absent,
//RS     /// c109 Phase 8: `Ok(x)` — a success value of `T !E` (`Ok(x)`).
//RS     Ok(Box<TExpr>),
//RS     /// c109 Phase 8: `Err(e)` — a failure value of `T !E` (`Err(e)`). The
//RS     /// origin is set when the value is the function's own returned failure
//RS     /// (#3713): that `Err(...)` is where the failure's journey starts.
//RS     Err(Box<TExpr>, Option<TFailureOrigin>),
//RS     /// c109 Phase 8: the `?` propagation operator (`Expr::Try`). The error
//RS     /// conversion (`convert`) is the TOTAL sema fact (`TryConvert`): a `None` is a
//RS     /// bare propagate or a declared typed conversion calls the declared
//RS     /// conversion. The frame-trace location (`file`, `line`, `column`,
//RS     /// `fn_name`) is resolved at lowering so every tier records the same hop
//RS     /// (the emitter never reads `cx.current_fn`/`cx.src`).
//RS     Try {
//RS         inner: Box<TExpr>,
//RS         /// Optional D-FAIL-CTX1 note. Lowered as a closure/cold branch so its
//RS         /// interpolation is never evaluated when the operand succeeds.
//RS         note: Option<Box<TExpr>>,
//RS         convert: TTryConvert,
//RS         /// Pre-escaped Rust string literal for the source file (`escape_rust_str`).
//RS         file: String,
//RS         line: usize,
//RS         /// 1-based character column of the propagating call.
//RS         column: usize,
//RS         /// Pre-escaped Rust string literal for the enclosing function name.
//RS         fn_name: String,
//RS     },
//RS     /// c109 Phase 8: the `??` fallback operator (`Expr::OrFallback`).
//RS     /// D-FAIL-CARRIER1=A: one carrier, so one lowering —
//RS     /// `match … { Ok(v) => v, Err(_) => fb }` reads `?T` and `T !E` alike.
//RS     /// The fallback is a value or an early `return` (the panic form is deferred —
//RS     /// its `safe_locals_expr` reproduction is out of subset).
//RS     OrFallback {
//RS         value: Box<TExpr>,
//RS         fallback: TOrFallback,
//RS     },
//RS     /// c109 Phase 8: optional field/chain `base?.member` (`Expr::OptField`). The
//RS     /// `flatten` fact (TOTAL, from sema) picks the combinator: `true` → `.and_then`
//RS     /// (the field is itself optional), `false` → `.map`. Mirrors the AST path's
//RS     /// `(base).clone().{and_then|map}(|__optv| __optv.{member})` exactly.
//RS     OptField {
//RS         base: Box<TExpr>,
//RS         /// Jet member name; emit mangles.
//RS         member: String,
//RS         flatten: bool,
//RS     },
//RS     /// c109 Phase 11: a lambda/closure literal (`Expr::Lambda`). Every capture/
//RS     /// escape/Fn-vs-FnMut decision is the TOTAL sema fact (`Lambda.meta`), resolved
//RS     /// at lowering — emit reads them, never recomputes capture analysis (I3). The
//RS     /// `prep` holds the per-`cloned_capture` `let __jet_cap_<n> = (place).clone();`
//RS     /// prelude (resolved from the *outer* env at lowering, since the cap's source
//RS     /// place is an outer local); `params` is the already-rendered `name[: ty]` list;
//RS     /// `body` is the lowered closure body; `is_move`/`boxed` reproduce the AST path's
//RS     /// `move ` keyword (off `needs_fn_mut`/`escapes`) and `Box::new(…)` (off `escapes`)
//RS     /// wrappers. The whole thing is wrapped in `{ <prep> <closure> }` when `prep` is
//RS     /// non-empty — byte-for-byte the TIR lambda encoding.
//RS     Lambda(Box<TLambda>),
//RS     /// D-TAG1: a binding-free enum variant/group pattern test (`d == .Fire`,
//RS     /// `d == .Fire.Burn` in expression position). Lowers to `matches!(&subj, pat)`
//RS     /// where `pat` is the same Rust pattern string `emit_match_pattern` uses for
//RS     /// switch arms (group names expand to or-patterns over their leaves).
//RS     PatternMatches {
//RS         subj: Box<TExpr>,
//RS         pattern: TPattern,
//RS     },
//RS     /// D-HOLE1: `Option.lift2(f, a, b)` — apply `f` to both payloads only when both
//RS     /// `a`/`b` are present; `null` otherwise. `f`/`a`/`b` are lowered plainly as
//RS     /// values (`f` via the generic `Expr::Lambda`/fn-value lowering, same as any
//RS     /// other function-typed argument); emit destructures the zipped pair inside a
//RS     /// closure. No user-visible tuple struct — the pair never surfaces as a Jet
//RS     /// value.
//RS     OptionLift2 {
//RS         f: Box<TExpr>,
//RS         a: Box<TExpr>,
//RS         b: Box<TExpr>,
//RS     },
//RS     /// c109 Phase 11: a closure-taking collection method (`map`/`filter`/`each`/
//RS     /// `find`/`any`/`all`/`sort_by`/`reduce`). The receiver-type + Fn-vs-FnMut
//RS     /// dispatch (`emit_builtin_method`'s closure arms) is resolved at lowering into a
//RS     /// concrete `op`; emit only formats. `recv` is the lowered receiver, `args` the
//RS     /// lowered closure arg(s) (a `reduce` carries the seed first, then the lambda) —
//RS     /// emitted PLAINLY, exactly as `emit_builtin_method`'s `arg(i)`.
//RS     ClosureMethod {
//RS         recv: Box<TExpr>,
//RS         op: TClosureOp,
//RS         args: Vec<TExpr>,
//RS     },
//RS     /// Adapt a Jet callback to a collection helper's borrowed host inputs.
//RS     /// Scalar reads dereference the host borrow; owned/non-scalar reads keep it.
//RS     HostBorrowCallback {
//RS         callable: Box<TExpr>,
//RS         params: Vec<Type>,
//RS     },
//RS     /// c109 Phase 12: a numeric predicate / bit-population query
//RS     /// (D-NUMOPS1: `is_nan`/`count_ones`/…) on a numeric receiver. These
//RS     /// carry `recv_type == Some(<numeric name>)` (sema sets it for numeric receivers
//RS     /// — CheckerInfer ~L2248). The receiver width source/target and the
//RS     /// operation is resolved at lowering into a total `TNumericOp`, so emit makes no
//RS     /// type decision (I3). No args (all numeric queries are nullary).
//RS     NumericMethod {
//RS         recv: Box<TExpr>,
//RS         op: TNumericOp,
//RS     },
//RS     /// D-GO127-STDLIB1=A: a binary exact-Int method whose operation is
//RS     /// resolved at lowering and whose right-hand operand remains a TIR child.
//RS     /// Keeping the operand in its own node preserves the nullary NumericMethod
//RS     /// shape used by predicates and conversions.
//RS     NumericBinaryMethod {
//RS         recv: Box<TExpr>,
//RS         op: TNumericOp,
//RS         arg: Box<TExpr>,
//RS     },
//RS     /// c109 Phase 28: an overflow opt-out builtin `wrapping(e)`/`saturating(e)`/
//RS     /// `checked(e)` (D-NUMOPS1). The single integer `Expr::Binary` argument lowers to
//RS     /// Rust's matching
//RS     /// method: `(lhs).{prefix}_{op}(rhs)` where `prefix ∈ {wrapping, saturating,
//RS     /// checked}` and `op ∈ {add, sub, mul, div, rem}`, or a standard fixed-width
//RS     /// rotation with `prefix ∈ {rotate_left, rotate_right}`. PLAIN operands (no
//RS     /// overflow trap).
//RS     /// `prefix` + `op` are resolved at lowering (total facts), emit only assembles.
//RS     OverflowOpt {
//RS         prefix: String,
//RS         op: &'static str,
//RS         line: u32,
//RS         /// D-WRAP-SCOPE1=A: the lexical policy fact that caused this node.
//RS         /// Explicit receiver methods have no policy fact.
//RS         policy: Option<crate::AST::ArithmeticPolicyFact>,
//RS         lhs: Box<TExpr>,
//RS         rhs: Box<TExpr>,
//RS     },
//RS     /// c109 Phase 13: a method ON a handle (FileReader/FileWriter/StdinHandle/
//RS     /// Stopwatch/TcpListener/TcpStream/HTTPRequest/HTTPResponse) — the handle arms of
//RS     /// built-in method lowering. The handle-receiver
//RS     /// dispatch (`rty == Some(Named(<handle>))`) is resolved at lowering into a total
//RS     /// `THandleOp`, so emit makes no type decision (I3). Args are emitted PLAINLY
//RS     /// (`emit_builtin_method`'s `arg(i)` is a raw `emit_expr`).
//RS     HandleMethod {
//RS         recv: Box<TExpr>,
//RS         op: THandleOp,
//RS         args: Vec<TExpr>,
//RS     },
//RS     /// c109 Phase 13: a closure-taking core/stdlib call.
//RS     /// `task`, `http.serve`, and `scope.guard` are NOT in `core_fixed_sig` and each
//RS     /// has a bespoke emit shape the plain `CoreCall` cannot reproduce: `task` wraps a
//RS     /// `emit_spawn_lambda` (`move |…|`,
//RS     /// NEVER `Box::new`) in `JetTask::spawn(…)`; `serve` (lambda handler) emits
//RS     /// `jet_http_serve(&(addr), <lambda>)`; `guard` emits `jet_scope_guard(<lambda>)`.
//RS     /// The closure body is lowered + rendered at lowering (the lambda is in subset —
//RS     /// Phase 11), so emit only assembles. `kind` selects the bespoke shape.
//RS     CoreClosureCall {
//RS         kind: TCoreClosureKind,
//RS     },
//RS     /// D-CONC-SPAWN1=D: `task.all { … }` — join every child, collect results.
//RS     TaskGroupAll {
//RS         tasks: Box<TExpr>,
//RS     },
//RS     /// D-CONC-SPAWN1=D: `task.race { … }` — first successful child wins.
//RS     TaskGroupRace {
//RS         tasks: Box<TExpr>,
//RS     },
//RS     /// D-CONC-SPAWN1=D: `task.any { … }` — first completed child wins.
//RS     TaskGroupAny {
//RS         tasks: Box<TExpr>,
//RS     },
//RS     /// Compiler-private readiness-table carrier. Source `if { ... }` lowers
//RS     /// to this chain without exposing a public builder spelling.
//RS     SelectStart,
//RS     /// Compiler-private receiver arm in the readiness-table carrier.
//RS     SelectRecv {
//RS         builder: Box<TExpr>,
//RS         channel: Box<TExpr>,
//RS     },
//RS     /// Compiler-private timer arm in the readiness-table carrier.
//RS     SelectAfter {
//RS         builder: Box<TExpr>,
//RS         duration: Box<TExpr>,
//RS         value: Option<Box<TExpr>>,
//RS     },
//RS     /// D-CONC-CHAN2=D: a readiness table with `else` uses the same tagged door
//RS     /// without parking; `nonblocking` is compiler-owned, not user syntax.
//RS     SelectWait {
//RS         builder: Box<TExpr>,
//RS         nonblocking: bool,
//RS     },
//RS     /// c109 Phase 13: a fn-typed-VALUE form. Either a bare function name used as a
//RS     /// value (`Expr::Ident` resolving to a top-level fn) or a call THROUGH a fn-value
//RS     /// (`Expr::CallValue` / sema's `.call(args)` projection). A bare fn-name value emits the
//RS     /// `Box::new(move |…| name(…)) as <fn-type>` wrapper (`emit_named_fn_value`,
//RS     /// Source/Codegen/Statement.rs), resolved at lowering into `wrapper`. A
//RS     /// `CallValue` emits `({callee})({args})` with the args lowered PLAINLY (the AST
//RS     /// `Expr::CallValue` passes `None` to `emit_call_args` → no clone/borrow/convention
//RS     /// wrappers). `kind` selects the form.
//RS     FnValue {
//RS         kind: TFnValueKind,
//RS     },
//RS     /// c109 Phase 14: a cross-module function call. The various module-call forms
//RS     /// (qualified `mod.fn()` via `import_mods`, `pub use` re-exports via
//RS     /// `reexport_calls`, inline code modules via `code_modules`, and the unqualified
//RS     /// inline/file imports in `emit_call`) all resolve at LOWERING to a fully-decided
//RS     /// `TModuleCallForm` — emit makes no table lookup or decision (I3). `args` carry
//RS     /// their borrow/clone wrappers, resolved exactly as `emit_call_args` does from the
//RS     /// callee's import signature. `cx.root_prefix` is the only program-level value the
//RS     /// emitter reads (like Phase 9/10's `cx.file`/`cx.root_prefix`), placed exactly
//RS     /// where the AST path prepends it.
//RS     ModuleCall {
//RS         form: TModuleCallForm,
//RS         /// Effective return type of the lowered target function. `ty` remains the
//RS         /// source-visible call type; the AOT emitter uses this separate fact only
//RS         /// to adapt a hidden `Result` carrier to its raw success payload.
//RS         target_return: Option<Type>,
//RS         /// D-GENERIC-CALL1=A: explicit generic arguments for the target.
//RS         type_args: Vec<Type>,
//RS         args: Vec<TCallArg>,
//RS     },
//RS     /// A resolved foreign symbol and its checked ABI/arguments. The symbol is
//RS     /// consumed by the canonical MIR foreign-call row; no backend wrapper text
//RS     /// is stored.
//RS     ExternCall {
//RS         symbol: String,
//RS         c_abi: bool,
//RS         args: Vec<TExternArg>,
//RS     },
//RS }
//RS 
//RS /// c109 Phase 14: a resolved cross-module call form. Each variant pre-resolves the
//RS /// path pieces of one `emit_call`/`emit_method_call` module-call arm; emit prepends
//RS /// `cx.root_prefix` exactly where the AST path does (or omits it where the AST does).
//RS #[derive(Clone)]
