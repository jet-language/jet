// No second enum is introduced here; backend-neutral fields are consumed by all producers.
use jet_foundation.TExprKind
// Exact Rust variant -> canonical variant mapping (payload facts are kept at the owner):
// IntLit -> IntLit; FloatLit -> FloatLit; BoolLit -> BoolLit; CharLit -> CharLit;
// StrLit -> StrLit; Local -> Local; Unit -> Unit; InlineBlock -> InlineBlock;
// DefaultLit -> DefaultLit; Uninit -> Uninit; CtLit -> CtLit; HostCall -> HostCall;
// ConstRef -> ConstRef; DataEntriesToMap -> DataEntriesToMap; Call -> Call;
// DistinctCtor -> DistinctCtor; RangeCheckedCtor -> RangeCheckedCtor;
// DistinctConvert -> DistinctConvert; UnitConvert -> UnitConvert;
// MathBuiltin -> MathBuiltin; PreciseBuiltin -> PreciseBuiltin; Print -> Print;
// Drop -> Drop; Close -> Close; Move -> Move; ResourceNew -> ResourceNew;
// ResourceTake -> ResourceTake; AmbientInput -> AmbientInput; RequireStop -> RequireStop;
// Binary -> Binary; CompareChain -> CompareChain; LayoutCompare -> LayoutCompare;
// LayoutLit -> LayoutLit; Unary -> Unary; StructLit -> StructLit; Field -> Field;
// SharedGuardValue -> SharedGuardValue; SharedGuardMap -> SharedGuardMap;
// SharedGuardSplit -> SharedGuardSplit; SharedGuardWait -> SharedGuardWait;
// ConditionNotify -> ConditionNotify; PtrFromAddr -> PtrFromAddr; Deref -> Deref;
