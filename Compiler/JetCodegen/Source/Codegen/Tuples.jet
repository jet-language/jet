use JetFoundation.AST.[EnumLitArg, Expr, ForKind, Func, Item, LambdaBody, OrFallback, Stmt, StrPart, Type, VariantPayload]
use JetFoundation.Names.mangle
use std.collections.hash_map.DefaultHasher
use std.hash.[Hash, Hasher]

// Rust: crates/jet-codegen/src/Codegen/Tuples.rs:8
struct CollectedTypeShapes {
    tuples: [String: [(String, Type)]]
    abstract_params: [String]
}
// Rust: crates/jet-codegen/src/Codegen/Tuples.rs:13
fn with_type_params(out: &CollectedTypeShapes, params: [String], collect: fn(&CollectedTypeShapes) Never!) Never! {
    previous := ^out.abstract_params
    out.abstract_params = ^params
    collect(out)
    out.abstract_params = ^previous
}
// Rust: crates/jet-codegen/src/Codegen/Tuples.rs:23
fn tuple_struct_name(fields: &[(String, Type)]) -> String Never! {
    // GATE #4494: canonical Rust-compatible DefaultHasher stream and finish.
    hasher := DefaultHasher.new()
    for (name, ty) in fields {
        name.hash(&hasher)
        ty.name().hash(&hasher)
    }
    mangle("JetTup_{hasher.finish():x}")
}
// Rust: crates/jet-codegen/src/Codegen/Tuples.rs:32
fn tuple_fields_plain(fields: &[(String, Type)]) -> [(String, Type)] Never! {
    fields.iter().map(fn(pair) { (pair.0.clone(), pair.1.clone()) }).collect()
}
// Rust: crates/jet-codegen/src/Codegen/Tuples.rs:39
fn collect_tuple_shapes_from_type(ty: &Type, out: &CollectedTypeShapes) Never! {
    if ty is Type.Tuple(fields) {
        plain := tuple_fields_plain(fields)
        out.tuples.insert(tuple_struct_name(&plain), ^plain)
        for (_, inner) in fields { collect_tuple_shapes_from_type(inner, out) }
        return
    }
    match ty {
        Type.List(inner) | Type.Option(inner) | Type.Shared(inner) => collect_tuple_shapes_from_type(inner, out)
        Type.Map { key, value, .. } => {
            fields := [("key", key.clone()), ("value", value.clone())]
            out.tuples.insert(tuple_struct_name(&fields), ^fields)
            collect_tuple_shapes_from_type(key, out)
            collect_tuple_shapes_from_type(value, out)
        }
        Type.Result { ok, err } => {
            collect_tuple_shapes_from_type(ok, out)
            collect_tuple_shapes_from_type(err, out)
        }
        Type.Fn { params, ret, .. } => {
            for param in params { collect_tuple_shapes_from_type(param, out) }
            if ret is Some(result) { collect_tuple_shapes_from_type(result, out) }
        }
        Type.Apply { args, .. } => { for arg in args { collect_tuple_shapes_from_type(arg, out) } }
        Type.Union(members) => { for member in members { collect_tuple_shapes_from_type(member, out) } }
        _ => {}
    }
}
// Rust: crates/jet-codegen/src/Codegen/Tuples.rs:87
fn collect_tuple_shapes_from_expr(expr: &Expr, out: &CollectedTypeShapes) Never! {
    match expr {
        Expr.TupleLit(_, _, Some(ty)) => collect_tuple_shapes_from_type(ty, out)
        Expr.Str(parts, _) => {
            for part in parts { if part is StrPart.Interp(inner, _) { collect_tuple_shapes_from_expr(inner, out) } }
        }
        Expr.ListLit(elems, _) => { for elem in elems { collect_tuple_shapes_from_expr(elem, out) } }
        Expr.MemberSpread { base, .. } => collect_tuple_shapes_from_expr(base, out)
        Expr.TupleLit(fields, _, _) => { for (_, inner) in fields { collect_tuple_shapes_from_expr(inner, out) } }
        Expr.MapLit(entries, _) => {
            for (key, value) in entries {
                collect_tuple_shapes_from_expr(key, out)
                collect_tuple_shapes_from_expr(value, out)
            }
        }
        Expr.Index { base, index, .. } => {
            collect_tuple_shapes_from_expr(base, out)
            collect_tuple_shapes_from_expr(index, out)
        }
        Expr.Slice { base, start, end, range, .. } => {
            collect_tuple_shapes_from_expr(base, out)
            if range is Some(inner) { collect_tuple_shapes_from_expr(inner, out) }
            else { collect_tuple_shapes_from_expr(start, out); collect_tuple_shapes_from_expr(end, out) }
        }
        Expr.Range { start, end, .. } => {
            collect_tuple_shapes_from_expr(start, out)
            collect_tuple_shapes_from_expr(end, out)
        }
        Expr.Ident(_, _) | Expr.Int(_, _, _, _) | Expr.Float(_, _, _, _) | Expr.Bool(_, _)
        | Expr.Unit(_) | Expr.Char(_, _) | Expr.Absent(_) | Expr.ReduceMarker(_, _)
        | Expr.Todo { .. } | Expr.NoElse(_) | Expr.UnitLit { .. } | Expr.ComptimeName { .. }
        | Expr.StrMatchLit(_, _) | Expr.BinMatchLit(_, _) => {}
        Expr.Call(call) => {
            for arg in call.args { collect_tuple_shapes_from_expr(&arg.expr, out) }
            if call.resolved_ret is Some(ty) { collect_tuple_shapes_from_type(ty, out) }
        }
        Expr.Unary(_, inner, _) | Expr.Deref(inner, _) | Expr.RawOf(inner, _)
        | Expr.Copy(inner, _) | Expr.Place(inner, _, _) | Expr.Tainted(inner, _, _)
        | Expr.Present(inner, _) | Expr.Ok(inner, _) | Expr.Err(inner, _) => collect_tuple_shapes_from_expr(inner, out)
        Expr.Try(inner, _, _, note) => {
            collect_tuple_shapes_from_expr(inner, out)
            if note is Some(value) { collect_tuple_shapes_from_expr(value, out) }
        }
        Expr.Binary(_, left, right, _) => {
            collect_tuple_shapes_from_expr(left, out)
            collect_tuple_shapes_from_expr(right, out)
        }
        Expr.CompareChain { operands, .. } => { for operand in operands { collect_tuple_shapes_from_expr(operand, out) } }
        Expr.Field(inner, _, _) | Expr.OptField { base: inner, .. } => collect_tuple_shapes_from_expr(inner, out)
        Expr.MethodCall { receiver, type_args, args, resolved_ret, .. } => {
            collect_tuple_shapes_from_expr(receiver, out)
            if receiver is Expr.Ident(type_name, _) {
                if !type_args.is_empty() && type_name.chars().next().is_some_and(fn(character) { character.is_uppercase() }) {
                    collect_tuple_shapes_from_type(&Type.Apply { name: type_name.clone(), args: type_args.clone() }, out)
                }
            }
            for ty in type_args { collect_tuple_shapes_from_type(ty, out) }
            for arg in args { collect_tuple_shapes_from_expr(&arg.expr, out) }
            // D-ITER1: resolved indexed/zip/partition tuple returns reach TIR.
            if resolved_ret is Some(ty) { collect_tuple_shapes_from_type(ty, out) }
        }
        Expr.StructLit { type_name, type_args, fields, .. } => {
            if !type_args.is_empty() {
                collect_tuple_shapes_from_type(&Type.Apply { name: type_name.clone(), args: type_args.clone() }, out)
            }
            for (_, _, inner) in fields { collect_tuple_shapes_from_expr(inner, out) }
        }
        Expr.TypedLit { head, body, .. } => {
            if head is Some(ty) { collect_tuple_shapes_from_type(ty, out) }
            body.for_each_expr(fn(inner) { collect_tuple_shapes_from_expr(inner, out) })
        }
        Expr.EnumLit { args, .. } => {
            for arg in args {
                match arg {
                    EnumLitArg.Positional(inner) => collect_tuple_shapes_from_expr(inner, out)
                    EnumLitArg.Named { expr: inner, .. } => collect_tuple_shapes_from_expr(inner, out)
                }
            }
        }
        Expr.PatternTest { subject, .. } => collect_tuple_shapes_from_expr(subject, out)
        Expr.OrFallback { value, fallback, .. } => {
            collect_tuple_shapes_from_expr(value, out)
            match fallback {
                OrFallback.Value(inner) => collect_tuple_shapes_from_expr(inner, out)
                OrFallback.Block { body, value: result, .. } => {
                    for stmt in body { collect_tuple_shapes_from_stmt(stmt, out) }
                    if result is Some(inner) { collect_tuple_shapes_from_expr(inner, out) }
                }
                OrFallback.Return(Some(inner), _) => collect_tuple_shapes_from_expr(inner, out)
                OrFallback.Return(None, _) => {}
                OrFallback.Panic { args, .. } => { for arg in args { collect_tuple_shapes_from_expr(&arg.expr, out) } }
                OrFallback.Break(_) | OrFallback.Continue(_) | OrFallback.BreakLabel(..) | OrFallback.ContinueLabel(..) => {}
            }
        }
        Expr.If { cond, then_body, then_value, else_body, else_value, .. } => {
            collect_tuple_shapes_from_expr(cond, out)
            for stmt in then_body { collect_tuple_shapes_from_stmt(stmt, out) }
            collect_tuple_shapes_from_expr(then_value, out)
            for stmt in else_body { collect_tuple_shapes_from_stmt(stmt, out) }
            collect_tuple_shapes_from_expr(else_value, out)
        }
        Expr.Lambda(lambda) => match lambda.body {
            LambdaBody.Expr(inner) => collect_tuple_shapes_from_expr(inner, out)
            LambdaBody.Block(stmts) => { for stmt in stmts { collect_tuple_shapes_from_stmt(stmt, out) } }
        }
        Expr.CallValue { callee, args, .. } => {
            collect_tuple_shapes_from_expr(callee, out)
            for arg in args { collect_tuple_shapes_from_expr(&arg.expr, out) }
        }
        Expr.PtrFromAddr { addr, .. } => collect_tuple_shapes_from_expr(addr, out)
        Expr.Paren(inner, _) => collect_tuple_shapes_from_expr(inner, out)
        Expr.Spread(inner, _) => collect_tuple_shapes_from_expr(inner, out)
    }
}
// Rust: crates/jet-codegen/src/Codegen/Tuples.rs:313
fn collect_tuple_shapes_from_stmt(stmt: &Stmt, out: &CollectedTypeShapes) Never! {
    match stmt {
        Stmt.Expr(inner) | Stmt.Yield(inner, _) | Stmt.DeferClose { close: inner, .. } => collect_tuple_shapes_from_expr(inner, out)
        Stmt.Val(binding) => {
            if binding.ty is Some(ty) { collect_tuple_shapes_from_type(ty, out) }
            collect_tuple_shapes_from_expr(&binding.init, out)
        }
        Stmt.Assign { value, .. } => collect_tuple_shapes_from_expr(value, out)
        Stmt.Return(Some(inner), _) => collect_tuple_shapes_from_expr(inner, out)
        Stmt.BreakValue(inner, _) | Stmt.BreakLabelValue(_, _, inner, _) => collect_tuple_shapes_from_expr(inner, out)
        Stmt.Return(None, _) => {}
        Stmt.While { cond, body, .. } | Stmt.CountedLoop { cond, body, .. } => {
            collect_tuple_shapes_from_expr(cond, out)
            for inner in body { collect_tuple_shapes_from_stmt(inner, out) }
        }
        Stmt.For { kind, body, .. } => {
            match kind {
                ForKind.Range { start, end, step, exclusive: _ } => {
                    collect_tuple_shapes_from_expr(start, out)
                    collect_tuple_shapes_from_expr(end, out)
                    if step is Some(inner) { collect_tuple_shapes_from_expr(inner, out) }
                }
                ForKind.In { collection, step } => {
                    collect_tuple_shapes_from_expr(collection, out)
                    if step is Some(inner) { collect_tuple_shapes_from_expr(inner, out) }
                }
            }
            for inner in body { collect_tuple_shapes_from_stmt(inner, out) }
        }
        Stmt.Switch { subject, arms, else_body, .. } | Stmt.ComptimeSwitch { subject, arms, else_body, .. } => {
            collect_tuple_shapes_from_expr(subject, out)
            for arm in arms {
                collect_tuple_shapes_from_expr(&arm.cond, out)
                for inner in arm.body { collect_tuple_shapes_from_stmt(inner, out) }
            }
            if else_body is Some(body) { for inner in body { collect_tuple_shapes_from_stmt(inner, out) } }
        }
        // D-REGION1 / D-EFF1: bodies are real code.
        Stmt.Region { body, .. } | Stmt.Policy { body, .. } | Stmt.Shield { body, .. }
        | Stmt.Switched { body, .. } | Stmt.TaskGroup { body, .. } | Stmt.Layout { body, .. }
        | Stmt.AuthorityScope { body, .. } | Stmt.Transact { body, .. } | Stmt.AssumeDet { body, .. } => {
            for inner in body { collect_tuple_shapes_from_stmt(inner, out) }
        }
        Stmt.Break(_) | Stmt.Continue(_) | Stmt.BreakLabel(..) | Stmt.ContinueLabel(..)
        | Stmt.Loop { .. } | Stmt.Unsafe { .. } | Stmt.Impure { .. } | Stmt.Reactive { .. } => {}
        Stmt.ContextBlock { fields, body, .. } => {
            for (_, inner, _) in fields { collect_tuple_shapes_from_expr(inner, out) }
            for inner in body { collect_tuple_shapes_from_stmt(inner, out) }
        }
        Stmt.Live { body, .. } => { for inner in body { collect_tuple_shapes_from_stmt(inner, out) } }
        Stmt.ScopeMember { body, .. } => { for inner in body { collect_tuple_shapes_from_stmt(inner, out) } }
        // D-META-STAGE1=B: erased before TIR.
        Stmt.ComptimeBlock { .. } => {}
        Stmt.ComptimeIf { cond, then_body, else_body, .. } => {
            collect_tuple_shapes_from_expr(cond, out)
            for inner in then_body { collect_tuple_shapes_from_stmt(inner, out) }
            if else_body is Some(body) { for inner in body { collect_tuple_shapes_from_stmt(inner, out) } }
        }
    }
}
// Rust: crates/jet-codegen/src/Codegen/Tuples.rs:452
fn collect_func_shapes(func: &Func, inherited: &[String], out: &CollectedTypeShapes) Never! {
    params := inherited.to_vec()
    params.extend(func.type_params.iter().map(fn(param) { param.name.clone() }))
    with_type_params(out, ^params, fn(shapes) {
        for param in func.params { collect_tuple_shapes_from_type(&param.ty, shapes) }
        if func.return_type is Some(ret) { collect_tuple_shapes_from_type(ret, shapes) }
        for stmt in func.body { collect_tuple_shapes_from_stmt(stmt, shapes) }
    })
}
// Rust: crates/jet-codegen/src/Codegen/Tuples.rs:468
fn collect_type_shapes(items: &[Item]) -> CollectedTypeShapes Never! {
    owner_params: [String: [String]] := [:]
    for item in items {
        match item {
            Item.Struct(definition) => owner_params.insert(definition.name.clone(), definition.type_params.iter().map(fn(param) { param.name.clone() }).collect())
            Item.Enum(definition) => owner_params.insert(definition.name.clone(), definition.type_params.iter().map(fn(param) { param.name.clone() }).collect())
            _ => {}
        }
    }
    out := CollectedTypeShapes { tuples: [:], abstract_params: [] }
    for item in items {
        match item {
            Item.Func(func) => collect_func_shapes(func, [], &out)
            Item.Struct(definition) => {
                params := owner_params.get(definition.name).cloned().unwrap_or_default()
                with_type_params(&out, params.clone(), fn(shapes) {
                    for field in definition.fields { collect_tuple_shapes_from_type(&field.ty, shapes) }
                })
                for method in definition.methods { collect_func_shapes(method, &params, &out) }
            }
            Item.Enum(definition) => {
                params := owner_params.get(definition.name).cloned().unwrap_or_default()
                with_type_params(&out, ^params, fn(shapes) {
                    for variant in definition.variants {
                        match variant.payload {
                            VariantPayload.Unit => {}
                            VariantPayload.Single(ty, _) => collect_tuple_shapes_from_type(ty, shapes)
                            VariantPayload.Named(fields) => { for field in fields { collect_tuple_shapes_from_type(&field.ty, shapes) } }
                        }
                    }
                })
            }
            Item.Const(definition) => collect_tuple_shapes_from_expr(&definition.value, &out)
            Item.Impl(definition) => {
                params := owner_params.get(definition.type_name).cloned().unwrap_or_default()
                for method in definition.methods { collect_func_shapes(method, &params, &out) }
            }
            Item.Test(test) => { for stmt in test.body { collect_tuple_shapes_from_stmt(stmt, &out) } }
            Item.EffectDecl(_) | Item.MarkerDecl(_) | Item.FactDecl(_) | Item.Trait(_)
            | Item.ExternRust(_) | Item.Module(_) | Item.CModule(_) | Item.CodeModule(_)
            | Item.Distinct(_) | Item.TypeAlias(_) | Item.UnitFamily(_) | Item.ErrorConv(_)
            | Item.Tag(_) | Item.Migration(_) | Item.ProtocolDecl(_) | Item.UserDerive(_)
            | Item.TemplateLoop(_) | Item.GenericModule(_) | Item.ModuleAlias(_) => {}
        }
    }
    // Rust BTreeMap consumers must iterate sorted tuple keys once.
    ^out
}
