// Lower checked TClosureOp expressions through their canonical Prelude routes.
use jet_foundation.[
    Effect,
    MIRAccess,
    MIRCallArg,
    mir_integer_constant,
    MIROperation,
    MIRPreludeABI,
    MIRPreludeFamily,
    MIRSemanticOp,
    MIRValueID,
    TClosureOp,
    TExpr,
    Type,
]

struct JetCodegenClosureRoute {
    module_name: String
    member: String
    symbol: String
    arity: Int
    borrow_mask: [Bool]
    effect_kind: Effect?
    abi: MIRPreludeABI
}

fn jet_codegen_closure_route_row(module_name: String, member: String, symbol: String, arity: Int, borrow_mask: [Bool], route_effect: Effect?, abi: MIRPreludeABI) -> JetCodegenClosureRoute Never! {
    JetCodegenClosureRoute{module_name: module_name, member: member, symbol: symbol, arity: arity, borrow_mask: borrow_mask, effect_kind: route_effect, abi: abi}
}

fn jet_codegen_closure_receiver_kind(receiver: Type) -> String? {
    if receiver == {
        .Tagged(_, inner) -> return jet_codegen_closure_receiver_kind(inner)
        .List(_) | .FixedList(_, _) -> return Val("list")
        .Option(_) -> return Val("option")
        .Map(_, _, _) -> return Val("map")
        .Apply(name, args) -> {
            if args.len() == 1 && (name == "Iter" || name == "ViewIter") -> return Val("iter")
            if args.len() == 1 && (name == "View" || name == "ViewMut" || name == "ComputeViewMut") -> return Val("view")
            if name == "Tally" -> return Val("bag")
            return None
        }
        else -> return None
    }
}

fn jet_codegen_closure_receiver_without_user_tags(receiver: Type) -> Type Never! {
    if receiver == {
        .Tagged(marker, inner) -> {
            if marker == {
                .User(_) -> return jet_codegen_closure_receiver_without_user_tags(inner)
                // copy: the receiver type is a new owned Type. Otherwise it equals `receiver`, the
                // caller's checked receiver type (a read parameter), which stays on the TIR node.
                else -> return receiver.copy()
            }
        }
        // copy: the receiver type is a new owned Type. Otherwise it equals `receiver`, the caller's
        // checked receiver type (a read parameter), which stays on the TIR node.
        else -> return receiver.copy()
    }
}

fn jet_codegen_collection_closure_route(operation: TClosureOp, receiver: Type) -> JetCodegenClosureRoute Never! {
    kind :: jet_codegen_closure_receiver_kind(receiver) ?? panic("checked closure operation has an unsupported receiver type")
    if operation == {
        .Map -> {
            // #4566 slice 5: the eager list map kernels borrow their source.
            if kind == "list" -> return jet_codegen_closure_route_row("core.list", "map", "jet_list_map", 2, [Bool]{true, false}, None, MIRPreludeABI.Value)
            if kind == "iter" -> return jet_codegen_closure_route_row("core.iter", "map", "jet_iter_map", 2, [Bool]{false, false}, None, MIRPreludeABI.Value)
        }
        .MapMut -> {
            if kind == "list" -> return jet_codegen_closure_route_row("core.list", "map_mut", "jet_list_map_mut", 2, [Bool]{true, false}, None, MIRPreludeABI.Value)
            if kind == "iter" -> return jet_codegen_closure_route_row("core.iter", "map_mut", "jet_iter_map_mut", 2, [Bool]{false, false}, None, MIRPreludeABI.Value)
        }
        .TryMap -> {
            if kind == "list" -> return jet_codegen_closure_route_row("core.list", "try_map", "jet_list_try_map", 2, [Bool]{false, false}, None, MIRPreludeABI.Value)
            if kind == "iter" -> return jet_codegen_closure_route_row("core.iter", "try_map", "jet_iter_try_map", 2, [Bool]{false, false}, None, MIRPreludeABI.Value)
            if kind == "view" -> return jet_codegen_closure_route_row("core.view", "try_map", "jet_view_try_map", 2, [Bool]{true, false}, None, MIRPreludeABI.Value)
        }
        .Filter -> {
            if kind == "list" -> return jet_codegen_closure_route_row("core.list", "filter", "jet_list_filter", 2, [Bool]{false, false}, None, MIRPreludeABI.Value)
            if kind == "iter" -> return jet_codegen_closure_route_row("core.iter", "filter", "jet_iter_filter", 2, [Bool]{false, false}, None, MIRPreludeABI.Value)
        }
        .FilterMap -> {
            if kind == "list" -> return jet_codegen_closure_route_row("core.list", "filter_map", "jet_list_filter_map_iter", 2, [Bool]{false, false}, None, MIRPreludeABI.Value)
            if kind == "iter" -> return jet_codegen_closure_route_row("core.iter", "filter_map", "jet_iter_filter_map", 2, [Bool]{false, false}, None, MIRPreludeABI.Value)
        }
        .TryFilter -> {
            if kind == "list" -> return jet_codegen_closure_route_row("core.list", "try_filter", "jet_list_try_filter", 2, [Bool]{false, false}, None, MIRPreludeABI.Value)
            if kind == "iter" -> return jet_codegen_closure_route_row("core.iter", "try_filter", "jet_iter_try_filter", 2, [Bool]{false, false}, None, MIRPreludeABI.Value)
            if kind == "view" -> return jet_codegen_closure_route_row("core.view", "try_filter", "jet_view_try_filter", 2, [Bool]{true, false}, None, MIRPreludeABI.Value)
        }
        .Each | .EachMut -> {
            if kind == "list" || kind == "iter" {
                if operation == TClosureOp.Each -> return jet_codegen_closure_route_row("core.list", "each", "jet_list_each", 2, [Bool]{false, false}, None, MIRPreludeABI.Value)
                return jet_codegen_closure_route_row("core.list", "each_mut", "jet_list_each_mut", 2, [Bool]{false, false}, None, MIRPreludeABI.Value)
            }
        }
        .Find -> {
            if kind == "list" || kind == "iter" -> return jet_codegen_closure_route_row("core.list", "find", "jet_list_find", 2, [Bool]{false, false}, None, MIRPreludeABI.Value)
        }
        .Any -> {
            if kind == "list" || kind == "iter" -> return jet_codegen_closure_route_row("core.list", "any", "jet_list_any", 2, [Bool]{false, false}, None, MIRPreludeABI.Value)
        }
        .All -> {
            if kind == "list" || kind == "iter" -> return jet_codegen_closure_route_row("core.list", "all", "jet_list_all", 2, [Bool]{false, false}, None, MIRPreludeABI.Value)
        }
        .Reduce -> {
            if kind == "list" || kind == "iter" -> return jet_codegen_closure_route_row("core.list", "reduce", "jet_list_reduce", 3, [Bool]{false, false, false}, None, MIRPreludeABI.Value)
        }
        .TakeWhile -> {
            if kind == "list" -> return jet_codegen_closure_route_row("core.list", "take_while", "jet_list_take_while_iter", 2, [Bool]{false, false}, None, MIRPreludeABI.Value)
            if kind == "iter" -> return jet_codegen_closure_route_row("core.iter", "take_while", "jet_iter_take_while", 2, [Bool]{false, false}, None, MIRPreludeABI.Value)
        }
        .SkipWhile -> {
            if kind == "list" -> return jet_codegen_closure_route_row("core.list", "skip_while", "jet_list_skip_while_iter", 2, [Bool]{false, false}, None, MIRPreludeABI.Value)
            if kind == "iter" -> return jet_codegen_closure_route_row("core.iter", "skip_while", "jet_iter_skip_while", 2, [Bool]{false, false}, None, MIRPreludeABI.Value)
        }
        .FlatMap -> {
            if kind == "list" -> return jet_codegen_closure_route_row("core.list", "flat_map", "jet_list_flat_map", 2, [Bool]{false, false}, None, MIRPreludeABI.Value)
            if kind == "iter" -> return jet_codegen_closure_route_row("core.iter", "flat_map", "jet_iter_flat_map", 2, [Bool]{false, false}, None, MIRPreludeABI.Value)
        }
        .Position -> {
            if kind == "list" || kind == "iter" -> return jet_codegen_closure_route_row("core.list", "position", "jet_list_position", 2, [Bool]{false, false}, None, MIRPreludeABI.Value)
        }
        .MinBy -> {
            if kind == "list" || kind == "iter" -> return jet_codegen_closure_route_row("core.list", "min_by", "jet_list_min_by", 2, [Bool]{false, false}, None, MIRPreludeABI.Value)
        }
        .MaxBy -> {
            if kind == "list" || kind == "iter" -> return jet_codegen_closure_route_row("core.list", "max_by", "jet_list_max_by", 2, [Bool]{false, false}, None, MIRPreludeABI.Value)
        }
        .GroupBy -> {
            if kind == "list" || kind == "iter" -> return jet_codegen_closure_route_row("core.list", "group_by", "jet_list_group_by", 2, [Bool]{false, false}, None, MIRPreludeABI.Value)
        }
        .CountBy -> {
            if kind == "list" || kind == "iter" -> return jet_codegen_closure_route_row("core.list", "count_by", "jet_list_count_by", 2, [Bool]{false, false}, None, MIRPreludeABI.Value)
        }
        .Scan -> {
            if kind == "list" -> return jet_codegen_closure_route_row("core.list", "scan", "jet_list_scan_iter", 3, [Bool]{false, false, false}, None, MIRPreludeABI.Value)
            if kind == "iter" -> return jet_codegen_closure_route_row("core.iter", "scan", "jet_iter_scan", 3, [Bool]{false, false, false}, None, MIRPreludeABI.Value)
        }
        .OptionMap -> {
            if kind == "option" -> return jet_codegen_closure_route_row("core.option", "map", "jet_option_map_ref", 2, [Bool]{true, false}, None, MIRPreludeABI.Value)
        }
        .BagAny -> {
            if kind == "bag" -> return jet_codegen_closure_route_row("core.bag", "any", "jet_bag_any", 2, [Bool]{true, false}, None, MIRPreludeABI.Value)
        }
        else -> {}
    }
    panic("checked closure operation has no canonical Prelude route for its receiver")
}

fn jet_codegen_closure_route(operation: TClosureOp, receiver: Type) -> JetCodegenClosureRoute Never! {
    if operation == {
        .EditDisjoint -> return jet_codegen_closure_route_row("core.collections", "edit_disjoint", "jet_edit_disjoint", 3, [Bool]{true, true, false}, None, MIRPreludeABI.Value)
        .EachMap -> return jet_codegen_closure_route_row("core.map", "each", "jet_map_each", 2, [Bool]{false, false}, None, MIRPreludeABI.Value)
        .MapAny -> return jet_codegen_closure_route_row("core.map", "any", "jet_map_any", 2, [Bool]{false, false}, None, MIRPreludeABI.Value)
        .MapAll -> return jet_codegen_closure_route_row("core.map", "all", "jet_map_all", 2, [Bool]{false, false}, None, MIRPreludeABI.Value)
        .MapFilter -> return jet_codegen_closure_route_row("core.map", "filter", "jet_map_filter", 2, [Bool]{false, false}, None, MIRPreludeABI.Value)
        .MapMap -> return jet_codegen_closure_route_row("core.map", "map", "jet_map_map_values", 2, [Bool]{false, false}, None, MIRPreludeABI.Value)
        .MapFold -> return jet_codegen_closure_route_row("core.map", "fold", "jet_map_fold", 3, [Bool]{false, false, false}, None, MIRPreludeABI.Value)
        .MapFlatMap -> return jet_codegen_closure_route_row("core.map", "flat_map", "jet_map_flat_map", 2, [Bool]{false, false}, None, MIRPreludeABI.Value)
        .ListBinarySearchBy -> return jet_codegen_closure_route_row("core.list", "binary_search_by", "jet_list_binary_search_by", 2, [Bool]{true, false}, None, MIRPreludeABI.Value)
        .ListMinMaxBy -> return jet_codegen_closure_route_row("core.list", "min_max_by", "jet_list_min_max_by", 2, [Bool]{true, false}, None, MIRPreludeABI.Aggregate)
        .CountWhere -> return jet_codegen_closure_route_row("core.list", "count_where", "jet_list_count_where", 2, [Bool]{true, false}, None, MIRPreludeABI.Value)
        .SortBy -> return jet_codegen_closure_route_row("core.list", "sort_by", "jet_list_sort_by", 2, [Bool]{true, false}, None, MIRPreludeABI.Value)
        .SortByDesc -> return jet_codegen_closure_route_row("core.list", "sort_by_desc", "jet_list_sort_by_desc", 2, [Bool]{true, false}, None, MIRPreludeABI.Value)
        .TrySortBy -> return jet_codegen_closure_route_row("core.list", "try_sort_by", "jet_list_try_sort_by", 2, [Bool]{true, false}, None, MIRPreludeABI.Value)
        .TrySortByDesc -> return jet_codegen_closure_route_row("core.list", "try_sort_by_desc", "jet_list_try_sort_by_desc", 2, [Bool]{true, false}, None, MIRPreludeABI.Value)
        .SortByCompare -> return jet_codegen_closure_route_row("core.list", "sort_by_compare", "jet_list_sort_by_compare", 2, [Bool]{true, false}, None, MIRPreludeABI.Value)
        .ParaMap -> return jet_codegen_closure_route_row("core.list", "para_map", "jet_list_para_map", 3, [Bool]{false, false, false}, None, MIRPreludeABI.Value)
        .ParaFilter -> return jet_codegen_closure_route_row("core.list", "para_filter", "jet_list_para_filter", 2, [Bool]{false, false}, None, MIRPreludeABI.Value)
        .ParaPartition -> return jet_codegen_closure_route_row("core.list", "para_partition", "jet_list_para_partition", 2, [Bool]{false, false}, None, MIRPreludeABI.Aggregate)
        .ParaFold -> return jet_codegen_closure_route_row("core.list", "para_fold", "jet_list_para_fold", 4, [Bool]{false, false, false, false}, None, MIRPreludeABI.Value)
        .DedupBy -> return jet_codegen_closure_route_row("core.iter", "dedup_by", "jet_iter_dedup_by", 2, [Bool]{false, false}, None, MIRPreludeABI.Value)
        .IsSortedBy -> return jet_codegen_closure_route_row("core.iter", "is_sorted_by", "jet_iter_is_sorted_by", 2, [Bool]{false, false}, None, MIRPreludeABI.Value)
        .ChunkWhile -> return jet_codegen_closure_route_row("core.iter", "chunk_while", "jet_iter_chunk_while", 2, [Bool]{false, false}, None, MIRPreludeABI.Value)
        .Fold -> return jet_codegen_closure_route_row("core.list", "fold", "jet_list_fold", 3, [Bool]{false, false, false}, None, MIRPreludeABI.Value)
        .ViewFold -> return jet_codegen_closure_route_row("core.view", "fold", "jet_view_fold", 3, [Bool]{true, false, false}, None, MIRPreludeABI.Value)
        .ViewMap -> return jet_codegen_closure_route_row("core.view", "map", "jet_view_map", 2, [Bool]{true, false}, None, MIRPreludeABI.Value)
        .UpdateFirst -> return jet_codegen_closure_route_row("core.list", "update_first", "jet_list_update_first", 3, [Bool]{true, false, false}, Val(Effect.Mem), MIRPreludeABI.Value)
        .Partition -> return jet_codegen_closure_route_row("core.list", "partition", "jet_list_partition", 2, [Bool]{false, false}, None, MIRPreludeABI.Aggregate)
        .Map | .MapMut | .TryMap | .Filter | .TryFilter | .Each | .EachMut | .Find | .Any | .BagAny | .All | .Reduce | .TakeWhile | .SkipWhile | .FlatMap | .Position | .MinBy | .MaxBy | .GroupBy | .CountBy | .FilterMap | .Scan | .OptionMap -> return jet_codegen_collection_closure_route(operation, receiver)
        else -> panic("checked TClosureOp has no canonical Prelude route")
    }
}

fn jet_codegen_closure_method_mutates_receiver(operation: TClosureOp) -> Bool Never! {
    if operation == {
        .EditDisjoint | .SortBy | .SortByDesc | .TrySortBy | .TrySortByDesc | .SortByCompare | .UpdateFirst -> true
        else -> false
    }
}

fn jet_codegen_lower_closure_receiver(builder: &JetCodegenBuilder, program: JetCodegenProgram, receiver: TExpr, mutating: Bool) -> MIRValueID {
    if !mutating {
        // An owned iterator receiver is consumed by the closure method.
        if jet_codegen_closure_receiver_kind(receiver.ty) == (Val("iter")) -> return jet_codegen_lower_consuming_value(&builder, program, receiver)
        return jet_codegen_lower_expr(&builder, program, receiver)
    }
    place := jet_codegen_lower_expression_place(&builder, program, receiver, MIRAccess.Write)
    if place == None -> return jet_codegen_lower_expr(&builder, program, receiver)
    is_indexed_collection := false
    if receiver.kind == {
        .Index(_, _, _, _, _, _) | .Field(_, _) -> {
            collection_type := jet_codegen_closure_receiver_without_user_tags(receiver.ty)
            if collection_type == {
                .List(_) | .Map(_, _, _) -> is_indexed_collection = true
                else -> {}
            }
        }
        else -> {}
    }
    if is_indexed_collection -> return jet_codegen_emit_value(&builder, program, receiver.span, receiver.ty, MIROperation.ReadPlace{place: place ?? panic("checked indexed closure receiver place disappeared")})
    jet_codegen_emit_value(&builder, program, receiver.span, receiver.ty, MIROperation.AddressOf{place: place ?? panic("checked mutating closure receiver place disappeared"), access: MIRAccess.Write})
}

fn jet_codegen_lower_closure_method(builder: &JetCodegenBuilder, program: JetCodegenProgram, expression: TExpr, receiver: TExpr, operation: TClosureOp, args: [TExpr]) -> MIRValueID {
    route_receiver := receiver.ty
    if operation == TClosureOp.OptionMap {
        if receiver.ty == {
            .Option(_) | .Tagged(_, _) -> {}
            else -> route_receiver = Type.Option{inner: expression.ty}
        }
    }
    route := jet_codegen_closure_route(operation, route_receiver)
    carrier := jet_codegen_failure_carrier_for_type(expression.ty)
    mutating := jet_codegen_closure_method_mutates_receiver(operation)
    lowered_receiver := jet_codegen_lower_closure_receiver(&builder, program, receiver, mutating)

    lowered_args := [MIRCallArg]{}
    loop argument in args {
        callback := jet_codegen_plain_callback_argument(builder, program, operation, argument)
        value := jet_codegen_lower_expr(&builder, program, callback)
        &lowered_args.push(jet_codegen_host_call_value_arg(value, argument.span, MIRAccess.Read, None))
    }
    if operation == TClosureOp.ParaMap && args.len() == 1 {
        limit := jet_codegen_emit_value(&builder, program, expression.span, Type.Int, MIROperation.Constant{value: mir_integer_constant(9223372036854775807, None, None)})
        &lowered_args.push(jet_codegen_host_call_value_arg(limit, expression.span, MIRAccess.Read, None))
    }
    if lowered_args.len() + 1 != route.arity -> panic("checked closure method operand count disagrees with its canonical Prelude route")
    if route.borrow_mask.len() != route.arity -> panic("canonical closure method borrow mask disagrees with route arity")
    index := 0
    loop index < lowered_args.len() {
        argument := lowered_args[index]
        argument.access = jet_codegen_host_value_access(builder, program, argument.value, route.borrow_mask[index + 1])
        lowered_args[index] = argument
        index += 1
    }
    call := jet_codegen_intern_route(&builder, program, MIRPreludeFamily.ClosureMethod, route.module_name, route.member, route.symbol, route.arity, route.borrow_mask, route.effect_kind, carrier, route.abi)
    jet_codegen_emit_value(&builder, program, expression.span, expression.ty, MIROperation.Semantic{operation: MIRSemanticOp.ClosureMethod{receiver: lowered_receiver, args: lowered_args, call: call}})
}

// #3740: a named `T Never!` function returns `T` directly while its checked
// value type names the carrier. A callback slot that takes a plain value gets
// the executable return, so the function value needs no `Ok` adapter the
// kernel cannot accept. `Never Never!` keeps its carrier, as the function does.
fn jet_codegen_plain_callback_argument(builder: JetCodegenBuilder, program: JetCodegenProgram, operation: TClosureOp, argument: TExpr) -> TExpr Never! {
    if operation == {
        // copy: the callback argument is a new owned TExpr. For these operations it equals
        // `argument`, the caller's checked callback (a read parameter), which stays in the closure
        // op's TIR.
        .TryMap | .TryFilter | .TrySortBy | .TrySortByDesc -> return argument.copy()
        else -> {}
    }
    named := if argument.kind == {
        .FnValue(kind) -> if kind == {
            .NamedFn(_, lambda) -> lambda == None
            else -> false
        }
        .ConstRef(symbol) -> jet_codegen_find_function_row(program.function_index, symbol.key) != None
        else -> false
    }
    // copy: the callback argument is a new owned TExpr. An unnamed callback equals `argument`, the
    // caller's checked callback (a read parameter), which stays in the TIR.
    if !named -> return argument.copy()
    fn_type := jet_codegen_unwrap_pattern_tags(argument.ty)
    if fn_type == .Fn(params, ret, effect_bound, param_contract, call_metadata, return_view_provenance) {
        // copy: the callback argument is a new owned TExpr. Without a declared return it equals
        // `argument`, the caller's checked callback (a read parameter), which stays in the TIR.
        declared :: ret ?? return argument.copy()
        // copy: the callback argument is a new owned TExpr. Without a Never carrier it equals
        // `argument`, the caller's checked callback (a read parameter), which stays in the TIR.
        success :: jet_codegen_never_carrier_success(declared) ?? return argument.copy()
        // copy: the callback argument is a new owned TExpr. For a Never success it equals
        // `argument`, the caller's checked callback (a read parameter), which stays in the TIR.
        if jet_codegen_unwrap_pattern_tags(success) == (Type.Named{name: "Never"}) -> return argument.copy()
        plain := argument
        plain.ty = Type.Fn{params: params, ret: Val(success), effect_bound: effect_bound, param_contract: param_contract, call_metadata: call_metadata, return_view_provenance: return_view_provenance}
        return plain
    }
    // copy: the callback argument is a new owned TExpr. Otherwise it equals `argument`, the
    // caller's checked callback (a read parameter), which stays in the TIR.
    argument.copy()
}

