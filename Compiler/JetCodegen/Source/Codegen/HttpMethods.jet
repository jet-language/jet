// Dedicated lowering for checked HTTP fields, client calls, and router registration.
use jet_foundation.[
    Effect,
    MIRCallArg,
    MIRHTTPMethod,
    MIROperation,
    MIRPanicLoc,
    MIRPhiIncoming,
    MIRPreludeABI,
    MIRPreludeCallID,
    MIRPreludeFamily,
    MIRPreludeTypeArg,
    MIRSemanticOp,
    MIRTerminator,
    MIRType,
    MIRValueID,
    Span,
    TExpr,
    TExprKind,
    TFailureCarrier,
    THandleOp,
    Type,
    core_call,
    mir_source_file_id,
]

fn jet_codegen_http_receiver_name(ty: Type) -> String? {
    if jet_codegen_handle_type_without_tags(ty) == {
        .Named(name) -> return Val(name)
        else -> return None
    }
}

fn jet_codegen_http_route_call(builder: &JetCodegenBuilder, route: JetCodegenHandleRoute, carrier: TFailureCarrier) -> MIRPreludeCallID Never! {
    jet_codegen_intern_route(
        &builder,
        route.family,
        route.module_name,
        route.member,
        route.symbol,
        route.borrow_mask.len(),
        route.borrow_mask,
        route.effect_kind,
        carrier,
        route.abi,
    )
}

fn jet_codegen_http_static_call(builder: &JetCodegenBuilder, expression: TExpr, route: MIRPreludeCallID, borrow_mask: [Bool], values: [MIRValueID], spans: [Span]) -> MIRValueID Never! {
    if values.len() != borrow_mask.len() || values.len() != spans.len() -> panic("checked HTTP static call operands disagree with its route signature")
    call_args := [MIRCallArg]{}
    index := 0
    loop index < values.len() {
        access := jet_codegen_host_value_access(builder, values[index], borrow_mask[index])
        &call_args.push(jet_codegen_host_call_value_arg(values[index], spans[index], access, None))
        index += 1
    }
    jet_codegen_emit_value(
        &builder,
        expression.span,
        expression.ty,
        MIROperation.Semantic{operation: MIRSemanticOp.StaticPreludeCall{call: route, args: call_args, owner_type_args: [MIRPreludeTypeArg]{}, type_args: [MIRType]{}}},
    )
}

fn jet_codegen_http_field_projection(receiver: Type, operation: THandleOp, argument_count: Int) -> String? {
    owner_name := jet_codegen_http_receiver_name(receiver) ?? return None
    if operation == {
        .HTTPReqField(field) -> {
            if owner_name != "HTTPRequest" -> return None
            if (field == "method" || field == "path" || field == "body" || field == "body_len") && argument_count == 0 -> return Val(field)
            if field == "under_limit" && argument_count == 1 -> return Val(field)
            return None
        }
        .HTTPRespField(field) -> {
            if owner_name == "HTTPResponse" && argument_count == 0 && (field == "status" || field == "body") -> return Val(field)
            return None
        }
        .HTTPClientMethod(kind, method) | .HTTPServerMethod(kind, method) -> {
            if kind != owner_name || argument_count != 0 -> return None
            if (owner_name == "HTTPRequest" && (method == "method" || method == "path" || method == "body")) || (owner_name == "HTTPResponse" && (method == "status" || method == "body" || method == "cookies")) -> return Val(method)
            return None
        }
        else -> return None
    }
}

fn jet_codegen_http_field_route(owner_name: String, field: String, argument_count: Int) -> JetCodegenHandleRoute? {
    member := ""
    symbol := ""
    borrow_mask := [Bool]{}
    if {
        owner_name == "HTTPRequest" -> {
            if {
                field == "method" && argument_count == 0 -> {
                    member = "request_method"
                    symbol = "jet_http_srv_req_method"
                    borrow_mask = [Bool]{true}
                }
                field == "path" && argument_count == 0 -> {
                    member = "request_path"
                    symbol = "jet_http_srv_req_path"
                    borrow_mask = [Bool]{true}
                }
                field == "body" && argument_count == 0 -> {
                    member = "request_body"
                    symbol = "jet_http_srv_req_body"
                    borrow_mask = [Bool]{true}
                }
                field == "body_len" && argument_count == 0 -> {
                    member = "request_body_len"
                    symbol = "jet_http_srv_req_body_len"
                    borrow_mask = [Bool]{true}
                }
                field == "under_limit" && argument_count == 1 -> {
                    member = "request_under_limit"
                    symbol = "jet_http_srv_req_under_limit"
                    borrow_mask = [Bool]{true, false}
                }
                else -> return None
            }
        }
        owner_name == "HTTPResponse" && argument_count == 0 -> {
            if {
                field == "status" -> {
                    member = "response_status"
                    symbol = "jet_http_client_response_status_value"
                    borrow_mask = [Bool]{true}
                }
                field == "body" -> {
                    member = "response_body"
                    symbol = "jet_http_client_response_body"
                    borrow_mask = [Bool]{true}
                }
                field == "cookies" -> {
                    member = "response_cookies"
                    symbol = "jet_http_response_cookies"
                    borrow_mask = [Bool]{true}
                }
                else -> return None
            }
        }
        else -> {
            return None
        }
    }
    Val(jet_codegen_handle_route(MIRPreludeFamily.HandleMethod, "core.http", member, symbol, borrow_mask, None, MIRPreludeABI.Value))
}

fn jet_codegen_lower_http_field(builder: &JetCodegenBuilder, expression: TExpr, receiver: TExpr, field: String, args: [TExpr]) -> MIRValueID {
    owner_name := jet_codegen_http_receiver_name(receiver.ty) ?? panic("checked HTTP field receiver is not a nominal HTTP type")
    route_value := jet_codegen_http_field_route(owner_name, field, args.len())
    route :: route_value ?? panic("checked HTTP field has no canonical Prelude route")
    route_id := jet_codegen_http_route_call(&builder, route, TFailureCarrier.Infallible)
    values := [MIRValueID]{jet_codegen_lower_expr(&builder, receiver)}
    spans := [Span]{receiver.span}
    loop argument in args {
        &values.push(jet_codegen_lower_expr(&builder, argument))
        &spans.push(argument.span)
    }
    jet_codegen_http_static_call(&builder, expression, route_id, route.borrow_mask, values, spans)
}

fn jet_codegen_http_client_route(kind: String, method: String) -> JetCodegenHandleRoute? {
    member := ""
    symbol := ""
    borrow_mask := [Bool]{}
    if {
        (kind == "HTTPRequest" || kind == "HTTPClient") && method == "send" -> {
            member = "http.request_send"
            symbol = "jet_http_client_request_send"
            borrow_mask = [Bool]{false}
        }
        kind == "Body" && (method == "bytes" || method == "chunks") -> {
            member = if method == "bytes" -> "http.body_bytes" else -> "http.body_chunks"
            symbol = if method == "bytes" -> "jet_http_body_bytes" else -> "jet_http_body_chunks"
            borrow_mask = [Bool]{true, false}
        }
        kind == "HTTPRequest" -> {
            if {
                method == "body" -> {
                    member = "http.request_body"
                    symbol = "jet_http_client_request_body"
                    borrow_mask = [Bool]{false, true}
                }
                method == "header" -> {
                    member = "http.request_header"
                    symbol = "jet_http_client_request_header"
                    borrow_mask = [Bool]{false, true, true}
                }
                method == "timeout" -> {
                    member = "http.request_timeout"
                    symbol = "jet_http_client_request_timeout"
                    borrow_mask = [Bool]{false, false}
                }
                method == "connect_timeout" -> {
                    member = "http.request_connect_timeout"
                    symbol = "jet_http_client_request_connect_timeout"
                    borrow_mask = [Bool]{false, false}
                }
                method == "read_timeout" -> {
                    member = "http.request_read_timeout"
                    symbol = "jet_http_client_request_read_timeout"
                    borrow_mask = [Bool]{false, false}
                }
                method == "total_timeout" -> {
                    member = "http.request_total_timeout"
                    symbol = "jet_http_client_request_total_timeout"
                    borrow_mask = [Bool]{false, false}
                }
                method == "dns_timeout" -> {
                    member = "http.request_dns_timeout"
                    symbol = "jet_http_client_request_dns_timeout"
                    borrow_mask = [Bool]{false, false}
                }
                method == "tls_timeout" -> {
                    member = "http.request_tls_timeout"
                    symbol = "jet_http_client_request_tls_timeout"
                    borrow_mask = [Bool]{false, false}
                }
                method == "write_timeout" -> {
                    member = "http.request_write_timeout"
                    symbol = "jet_http_client_request_write_timeout"
                    borrow_mask = [Bool]{false, false}
                }
                method == "first_byte_timeout" -> {
                    member = "http.request_first_byte_timeout"
                    symbol = "jet_http_client_request_first_byte_timeout"
                    borrow_mask = [Bool]{false, false}
                }
                method == "redirects" -> {
                    member = "http.request_redirects"
                    symbol = "jet_http_client_request_redirects"
                    borrow_mask = [Bool]{false, false}
                }
                method == "proxy" -> {
                    member = "http.request_proxy"
                    symbol = "jet_http_client_request_proxy"
                    borrow_mask = [Bool]{false, true}
                }
                method == "cookie" -> {
                    member = "http.request_cookie"
                    symbol = "jet_http_client_request_cookie"
                    borrow_mask = [Bool]{false, true, true}
                }
                method == "form" -> {
                    member = "http.request_form"
                    symbol = "jet_http_client_request_form"
                    borrow_mask = [Bool]{false, true, true}
                }
                method == "multipart_text" -> {
                    member = "http.request_multipart_text"
                    symbol = "jet_http_client_request_multipart_text"
                    borrow_mask = [Bool]{false, true, true}
                }
                else -> return None
            }
        }
        else -> {
            return None
        }
    }
    Val(jet_codegen_handle_route(MIRPreludeFamily.HandleMethod, "core.http", member, symbol, borrow_mask, Val(Effect.Net), MIRPreludeABI.Value))
}

fn jet_codegen_lower_http_client_method(builder: &JetCodegenBuilder, expression: TExpr, receiver: TExpr, kind: String, method: String, args: [TExpr]) -> MIRValueID {
    route_value := jet_codegen_http_client_route(kind, method)
    route :: route_value ?? panic("checked HTTP client method has no canonical route")
    if args.len() + 1 != route.borrow_mask.len() -> panic("checked HTTP client operands disagree with their route signature")
    route_id := jet_codegen_http_route_call(&builder, route, jet_codegen_failure_carrier_for_type(expression.ty))
    values := [MIRValueID]{jet_codegen_lower_expr(&builder, receiver)}
    spans := [Span]{receiver.span}
    loop argument in args {
        &values.push(jet_codegen_lower_expr(&builder, argument))
        &spans.push(argument.span)
    }
    jet_codegen_http_static_call(&builder, expression, route_id, route.borrow_mask, values, spans)
}

fn jet_codegen_http_text_route(receiver: String, with_limit: Bool) -> JetCodegenHandleRoute Never! {
    member := ""
    symbol := ""
    if {
        receiver == "HTTPRequest" -> {
            member = if with_limit -> "request_text_with_limit" else -> "request_text"
            symbol = if with_limit -> "jet_http_request_text_with_limit" else -> "jet_http_request_text"
        }
        receiver == "HTTPResponse" -> {
            member = if with_limit -> "response_text_with_limit" else -> "response_text"
            symbol = if with_limit -> "jet_http_response_text_with_limit" else -> "jet_http_response_text"
        }
        receiver == "Body" && with_limit -> {
            member = "body_text"
            symbol = "jet_http_body_text"
        }
        else -> {
            panic("checked HTTP text receiver has no canonical route")
        }
    }
    borrow_mask := if with_limit -> [Bool]{true, false} else -> [Bool]{true}
    jet_codegen_handle_route(MIRPreludeFamily.HandleMethod, "core.http", member, symbol, borrow_mask, Val(Effect.Net), MIRPreludeABI.Value)
}

fn jet_codegen_lower_http_text_method(builder: &JetCodegenBuilder, expression: TExpr, receiver: TExpr, args: [TExpr], receiver_name: String) -> MIRValueID {
    if jet_codegen_handle_type_without_tags(expression.ty) == {
        .Result(success, error) -> {
            if jet_codegen_unwrap_pattern_tags(success) != Type.String || jet_codegen_unwrap_pattern_tags(error) != (Type.Named{name: "HTTPError"}) -> panic("checked HTTP text method has an unsupported Result type")
        }
        else -> panic("checked HTTP text method is not a Result")
    }
    with_limit := if {
        receiver_name == "Body" -> {
            if args.len() != 1 -> panic("checked Body.text has an unexpected argument count")
            true
        }
        else -> {
            if args.len() > 1 -> panic("checked HTTP text method has an unexpected argument count")
            args.len() == 1
        }
    }
    route := jet_codegen_http_text_route(receiver_name, with_limit)
    route_id := jet_codegen_http_route_call(&builder, route, TFailureCarrier.Result{success: Type.String, error: Type.Named{name: "HTTPError"}})
    values := [MIRValueID]{jet_codegen_lower_expr(&builder, receiver)}
    spans := [Span]{receiver.span}
    if with_limit {
        &values.push(jet_codegen_lower_handle_native_int(&builder, args[0]))
        &spans.push(args[0].span)
    }
    jet_codegen_http_static_call(&builder, expression, route_id, route.borrow_mask, values, spans)
}

fn jet_codegen_lower_http_request_json(builder: &JetCodegenBuilder, expression: TExpr, receiver: TExpr, args: [TExpr]) -> MIRValueID {
    if args.len() != 1 -> panic("checked HTTPRequest.json builder has an unexpected argument count")
    if jet_codegen_handle_type_without_tags(receiver.ty) != (Type.Named{name: "HTTPRequest"}) || jet_codegen_handle_type_without_tags(expression.ty) != (Type.Named{name: "HTTPRequest"}) -> panic("checked HTTPRequest.json builder has an unsupported request shape")
    encoded_expression := jet_codegen_data_expr(jet_codegen_data_tree_type(), args[0].span, TExprKind.Unit)
    body := jet_codegen_lower_serde_encode(&builder, encoded_expression, args[0])
    route := jet_codegen_handle_route(MIRPreludeFamily.HandleMethod, "core.http", "request_json", "jet_http_client_request_json", [Bool]{false, false}, None, MIRPreludeABI.Value)
    route_id := jet_codegen_http_route_call(&builder, route, TFailureCarrier.Infallible)
    values := [MIRValueID]{jet_codegen_lower_expr(&builder, receiver), body}
    jet_codegen_http_static_call(&builder, expression, route_id, route.borrow_mask, values, [Span]{receiver.span, args[0].span})
}

fn jet_codegen_lower_http_json_method(builder: &JetCodegenBuilder, expression: TExpr, receiver: TExpr, args: [TExpr], receiver_name: String) -> MIRValueID {
    result_type := jet_codegen_handle_type_without_tags(expression.ty)
    target := if result_type == {
        .Result(success, error) -> {
            if jet_codegen_unwrap_pattern_tags(error) != (Type.Named{name: "HTTPError"}) -> panic("checked HTTP JSON method has an unsupported error type")
            success
        }
        else -> panic("checked HTTP JSON method is not a Result")
    }
    with_limit := if {
        receiver_name == "HTTPRequest" -> {
            if args.len() != 0 -> panic("checked HTTPRequest.json has an unexpected argument count")
            false
        }
        receiver_name == "HTTPResponse" -> {
            if args.len() > 1 -> panic("checked HTTPResponse.json has an unexpected argument count")
            args.len() == 1
        }
        receiver_name == "Body" -> {
            if args.len() != 1 -> panic("checked Body.json requires one byte limit")
            true
        }
        else -> {
            panic("checked HTTP JSON receiver has no canonical route")
        }
    }
    text_type := Type.Result{ok: Type.String, err: Type.Named{name: "HTTPError"}}
    text_route := jet_codegen_http_text_route(receiver_name, with_limit)
    text_route_id := jet_codegen_http_route_call(&builder, text_route, TFailureCarrier.Result{success: Type.String, error: Type.Named{name: "HTTPError"}})
    text_values := [MIRValueID]{jet_codegen_lower_expr(&builder, receiver)}
    text_spans := [Span]{receiver.span}
    if with_limit {
        &text_values.push(jet_codegen_lower_handle_native_int(&builder, args[0]))
        &text_spans.push(args[0].span)
    }
    text := jet_codegen_http_static_call(&builder, jet_codegen_data_expr(text_type, expression.span, TExprKind.Unit), text_route_id, text_route.borrow_mask, text_values, text_spans)

    decode_error := Type.List{element: Type.Named{name: "FieldError"}}
    decode_type := Type.Result{ok: target, err: decode_error}
    record :: core_call("core.encoding.json", "decode") ?? panic("typed HTTP JSON decode Core row is not registered")
    carrier := jet_codegen_failure_carrier_for_type(decode_type)
    decode_call := jet_codegen_intern_core_call(&builder, record)
    decode_route := jet_codegen_intern_core_route(&builder, record, carrier)
    decode_fallibility := jet_codegen_core_call_fallibility(carrier, builder)
    decode_type_arg := jet_codegen_lower_type_for_function(target, builder)
    text_ok := jet_codegen_emit_value(&builder, expression.span, Type.Bool, MIROperation.ResultIsOk{subject: text})
    text_success := jet_codegen_new_block(&builder, expression.span, "http-json-text-success")
    text_failure := jet_codegen_new_block(&builder, expression.span, "http-json-text-failure")
    join := jet_codegen_new_block(&builder, expression.span, "http-json-join")
    jet_codegen_terminate(&builder, MIRTerminator.Branch{condition: text_ok, then_target: text_success, else_target: text_failure})
    incoming := [MIRPhiIncoming]{}

    jet_codegen_switch_block(&builder, text_failure)
    text_error := jet_codegen_emit_value(&builder, expression.span, Type.Named{name: "HTTPError"}, MIROperation.ResultValue{subject: text, ok: false})
    text_result := jet_codegen_emit_value(&builder, expression.span, expression.ty, MIROperation.ResultErr{value: text_error})
    text_end := builder.current
    jet_codegen_terminate(&builder, MIRTerminator.Jump{target: join})
    &incoming.push(MIRPhiIncoming{block: text_end, value: text_result})

    jet_codegen_switch_block(&builder, text_success)
    text_value := jet_codegen_emit_value(&builder, expression.span, Type.String, MIROperation.ResultValue{subject: text, ok: true})
    decoded := jet_codegen_emit_value(
        &builder,
        expression.span,
        decode_type,
        MIROperation.CoreCall{
            call: decode_call,
            route: decode_route,
            args: [MIRCallArg]{jet_codegen_numeric_call_arg(text_value, expression.span)},
            type_args: [MIRType]{decode_type_arg},
            fallibility: decode_fallibility,
            data_plan: None,
        },
    )
    project_route := jet_codegen_handle_route(MIRPreludeFamily.StaticPrelude, "core.http", "project_json_decode_error", "jet_http_project_json_decode_error", [Bool]{false}, None, MIRPreludeABI.Value)
    project_route_id := jet_codegen_http_route_call(&builder, project_route, TFailureCarrier.Infallible)
    projected := jet_codegen_http_static_call(
        &builder,
        expression,
        project_route_id,
        project_route.borrow_mask,
        [MIRValueID]{decoded},
        [Span]{expression.span},
    )
    decode_end := builder.current
    jet_codegen_terminate(&builder, MIRTerminator.Jump{target: join})
    &incoming.push(MIRPhiIncoming{block: decode_end, value: projected})

    jet_codegen_switch_block(&builder, join)
    jet_codegen_emit_value(&builder, expression.span, expression.ty, MIROperation.Phi{incoming: incoming})
}

fn jet_codegen_lower_http_response_header(builder: &JetCodegenBuilder, expression: TExpr, receiver: TExpr, args: [TExpr]) -> MIRValueID {
    if args.len() != 1 -> panic("checked HTTPResponse.header getter requires one name")
    if jet_codegen_handle_type_without_tags(receiver.ty) != (Type.Named{name: "HTTPResponse"}) -> panic("checked HTTPResponse.header getter receiver is not HTTPResponse")
    if jet_codegen_handle_type_without_tags(expression.ty) != (Type.Option{inner: Type.String}) || jet_codegen_handle_type_without_tags(args[0].ty) != Type.String -> panic("checked HTTPResponse.header getter has an unsupported checked type")
    route := jet_codegen_handle_route(MIRPreludeFamily.HandleMethod, "core.http", "response_header", "jet_http_client_response_header", [Bool]{true, true}, None, MIRPreludeABI.Value)
    carrier := TFailureCarrier.Optional{value: Type.String}
    route_id := jet_codegen_http_route_call(&builder, route, carrier)
    values := [MIRValueID]{jet_codegen_lower_expr(&builder, receiver), jet_codegen_lower_expr(&builder, args[0])}
    jet_codegen_http_static_call(&builder, expression, route_id, route.borrow_mask, values, [Span]{receiver.span, args[0].span})
}

fn jet_codegen_lower_http_response_header_builder(builder: &JetCodegenBuilder, expression: TExpr, receiver: TExpr, args: [TExpr]) -> MIRValueID {
    if args.len() != 2 -> panic("checked HTTPResponse.header builder requires name and value")
    if jet_codegen_handle_type_without_tags(receiver.ty) != (Type.Named{name: "HTTPResponse"}) || jet_codegen_handle_type_without_tags(expression.ty) != (Type.Named{name: "HTTPResponse"}) -> panic("checked HTTPResponse.header builder has an unsupported response shape")
    if jet_codegen_handle_type_without_tags(args[0].ty) != Type.String || jet_codegen_handle_type_without_tags(args[1].ty) != Type.String -> panic("checked HTTPResponse.header builder arguments are not String")
    route := jet_codegen_handle_route(MIRPreludeFamily.HandleMethod, "core.http", "response_header", "jet_http_srv_response_header", [Bool]{false, true, true}, None, MIRPreludeABI.Value)
    route_id := jet_codegen_http_route_call(&builder, route, TFailureCarrier.Infallible)
    values := [MIRValueID]{jet_codegen_lower_expr(&builder, receiver), jet_codegen_lower_expr(&builder, args[0]), jet_codegen_lower_expr(&builder, args[1])}
    jet_codegen_http_static_call(&builder, expression, route_id, route.borrow_mask, values, [Span]{receiver.span, args[0].span, args[1].span})
}

fn jet_codegen_lower_http_router_register(builder: &JetCodegenBuilder, expression: TExpr, receiver: TExpr, method: MIRHTTPMethod, handler: TExpr, file: String, line: Int, handler_param_names: [String], contract_json: String, args: [TExpr]) -> MIRValueID {
    if args.len() != 1 -> panic("HTTP route registration requires one path operand")
    mux := jet_codegen_handle_type_without_tags(receiver.ty) == Type.Named{name: "HTTPMux"}
    if !mux && jet_codegen_handle_type_without_tags(receiver.ty) != (Type.Named{name: "HTTPRouter"}) -> panic("HTTP route registration receiver is not a router or mux")
    member := "router_register"
    symbol := "jet_http_router_register"
    if mux {
        if {
            handler_param_names.len() == 0 -> {
                member = "mux_add_zero"
                symbol = "jet_http_mux_add_zero_handler"
            }
            else -> {
                member = "mux_add"
                symbol = "jet_http_mux_add_handler"
            }
        }
    }
    borrow_mask := if mux -> [Bool]{true, false, false, false} else -> [Bool]{true, false, false, false, true, false, false}
    route := jet_codegen_handle_route(MIRPreludeFamily.StaticPrelude, "core.http", member, symbol, borrow_mask, None, MIRPreludeABI.Value)
    route_id := jet_codegen_http_route_call(&builder, route, jet_codegen_failure_carrier_for_type(expression.ty))
    receiver_value := jet_codegen_lower_expr(&builder, receiver)
    path := jet_codegen_lower_expr(&builder, args[0])
    handler_value := jet_codegen_lower_expr(&builder, handler)
    location := MIRPanicLoc{file: mir_source_file_id(file), line: line, column: 0}
    jet_codegen_emit_value(
        &builder,
        expression.span,
        expression.ty,
        MIROperation.Semantic{operation: MIRSemanticOp.HTTPRouterRegister{call: route_id, receiver: receiver_value, path: path, handler: handler_value, method: method, handler_param_names: handler_param_names, contract_json: contract_json, location: location}},
    )
}

fn jet_codegen_lower_http_handle_method(builder: &JetCodegenBuilder, expression: TExpr, receiver: TExpr, operation: THandleOp, args: [TExpr]) -> MIRValueID {
    if operation == {
        .HTTPRouterRegister(method, handler, file, line, handler_param_names, contract_json) -> return jet_codegen_lower_http_router_register(&builder, expression, receiver, method, handler, file, line, handler_param_names, contract_json, args)
        .HTTPRespHeader -> return jet_codegen_lower_http_response_header(&builder, expression, receiver, args)
        .HTTPServerMethod(kind, method) -> {
            if kind == "HTTPResponse" && method == "header" -> return jet_codegen_lower_http_response_header_builder(&builder, expression, receiver, args)
        }
        else -> {}
    }
    browser_test := if operation == {
        .HTTPClientMethod(kind, _) -> jet_codegen_browser_test_handle_kind(kind)
        else -> false
    }
    if browser_test -> return jet_codegen_lower_general_handle_method(&builder, expression, receiver, operation, args)
    field := jet_codegen_http_field_projection(receiver.ty, operation, args.len())
    if field != None -> return jet_codegen_lower_http_field(&builder, expression, receiver, field ?? "", args)
    if operation == {
        .HTTPClientMethod(kind, method) -> {
            if method == "json" {
                receiver_name := jet_codegen_http_receiver_name(receiver.ty) ?? panic("checked HTTP JSON receiver is not nominal")
                if kind == "HTTPRequest" && args.len() == 1 && jet_codegen_handle_type_without_tags(expression.ty) == (Type.Named{name: "HTTPRequest"}) -> return jet_codegen_lower_http_request_json(&builder, expression, receiver, args)
                if receiver_name == "HTTPRequest" || receiver_name == "HTTPResponse" || receiver_name == "Body" -> return jet_codegen_lower_http_json_method(&builder, expression, receiver, args, receiver_name)
            }
            if method == "text" {
                receiver_name := jet_codegen_http_receiver_name(receiver.ty) ?? panic("checked HTTP text receiver is not nominal")
                if receiver_name == "HTTPRequest" || receiver_name == "HTTPResponse" || receiver_name == "Body" -> return jet_codegen_lower_http_text_method(&builder, expression, receiver, args, receiver_name)
            }
            return jet_codegen_lower_http_client_method(&builder, expression, receiver, kind, method, args)
        }
        else -> panic("checked HTTP handle operation has no dedicated Source lowering")
    }
}
