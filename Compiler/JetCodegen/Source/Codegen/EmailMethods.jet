// Lower checked Email methods through the checked field schema or exported Rust UFCS.
// These primitive methods are not registered Core Prelude routes.

fn jet_codegen_email_method_route(builder: &JetCodegenBuilder, method: String, symbol: String, borrow_mask: [Bool], carrier: TFailureCarrier) -> MirPreludeCallId Never! {
    jet_codegen_intern_static_call_route(
        &builder,
        MirPreludeFamily.HandleMethod,
        "core.email",
        method,
        MirSymbol.Runtime{name: symbol},
        borrow_mask,
        None,
        carrier,
        MirPreludeAbi.Value,
    )
}

fn jet_codegen_email_method_result_matches(method: String, ty: Type) -> Bool Never! {
    if method == "envelope" -> return ty == Type.Named{name: "Envelope"}
    if method == "with_envelope" -> return ty == Type.Result{ok: Type.Named{name: "Message"}, err: Type.Named{name: "EmailError"}}
    if method == "send" -> return ty == Type.Result{ok: Type.Named{name: "SendReport"}, err: Type.Named{name: "EmailError"}}
    false
}

fn jet_codegen_lower_email_envelope(builder: &JetCodegenBuilder, expression: TExpr, receiver: TExpr) -> MirValueId {
    base_place := jet_codegen_lower_expression_place(&builder, receiver, MirAccess.Read)
    if base_place == None {
        base_value := jet_codegen_lower_expr(&builder, receiver)
        base_place = Val(jet_codegen_temporary_place(&builder, base_value, receiver.ty, receiver.span, MirAccess.Read))
    }
    base :: base_place ?? panic("checked Message.envelope receiver has no readable place")
    field := jet_codegen_resolve_field_by_name(
        builder.modules,
        builder.function.module_identity,
        builder.generic_type_names,
        jet_codegen_handle_type_without_tags(receiver.ty),
        "envelope",
    )
    envelope_place := jet_codegen_project_field_place(&builder, base, expression.span, expression.ty, jet_codegen_mir_field_id(field))
    jet_codegen_emit_value(&builder, expression.span, expression.ty, MirOperation.ReadPlace{place: envelope_place})
}

pub fn jet_codegen_lower_email_method(builder: &JetCodegenBuilder, expression: TExpr, receiver: TExpr, operation: THandleOp, args: [TExpr]) -> MirValueId {
    method :: if operation == {.EmailMethod(name) -> name else -> panic("checked Email lowering received a non-Email method")}
    owner := jet_codegen_handle_type_without_tags(receiver.ty)
    carrier := jet_codegen_failure_carrier_for_type(expression.ty)

    if method == "envelope" {
        if owner != (Type.Named{name: "Message"}) || args.len() != 0 || !jet_codegen_email_method_result_matches(method, jet_codegen_handle_type_without_tags(expression.ty)) -> panic("checked Message.envelope has an unsupported Source ABI")
        return jet_codegen_lower_email_envelope(&builder, expression, receiver)
    }

    if method == "with_envelope" {
        if owner != (Type.Named{name: "Message"}) || args.len() != 1 || jet_codegen_handle_type_without_tags(args[0].ty) != (Type.Named{name: "Envelope"}) || !jet_codegen_email_method_result_matches(method, jet_codegen_handle_type_without_tags(expression.ty)) -> panic("checked Message.with_envelope has an unsupported Source ABI")
        route := jet_codegen_email_method_route(&builder, "Message.with_envelope", "jet_email::Message::with_envelope", [Bool]{true, true}, carrier)
        receiver_arg := jet_codegen_method_receiver_arg(&builder, receiver, MirAccess.Read)
        argument := jet_codegen_lower_expr(&builder, args[0])
        return jet_codegen_emit_value(
            &builder,
            expression.span,
            expression.ty,
            MirOperation.Semantic{operation: MirSemanticOp.HandleMethod{call: route, receiver: receiver_arg.value, args: [MirValueId]{argument}, frame_schedule: None, frame_schedule_derivation: None}},
        )
    }

    if method == "send" {
        if owner != (Type.Named{name: "Mailer"}) || args.len() != 1 || jet_codegen_handle_type_without_tags(args[0].ty) != (Type.Named{name: "Message"}) || !jet_codegen_email_method_result_matches(method, jet_codegen_handle_type_without_tags(expression.ty)) -> panic("checked Mailer.send has an unsupported Source ABI")
        route := jet_codegen_email_method_route(&builder, "Mailer.send", "jet_email::Mailer::send", [Bool]{true, false}, carrier)
        receiver_arg := jet_codegen_method_receiver_arg(&builder, receiver, MirAccess.Write)
        argument := jet_codegen_lower_expr(&builder, args[0])
        return jet_codegen_emit_value(
            &builder,
            expression.span,
            expression.ty,
            MirOperation.Semantic{operation: MirSemanticOp.HandleMethod{call: route, receiver: receiver_arg.value, args: [MirValueId]{argument}, frame_schedule: None, frame_schedule_derivation: None}},
        )
    }

    panic("checked Email method `{method}` has no lowering body")
}
