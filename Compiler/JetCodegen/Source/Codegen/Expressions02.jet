use jet_foundation.AST.UnOp
use jet_foundation.Syntax.[TYPE_NEVER, INTERNAL_UNIT_TYPE]

impl LowerCtx {
    // Rust: crates/jet-codegen/src/Codegen/TIR/mir.rs:8930
    fn lower_pattern_shape_condition(self: &Self, subject: MIRValueID, subject_ty: Type, owner: MIRTypeID?, shape: MIRPatternShape, mutable: Bool, reuse_bindings: Bool, window: MIRPlaceID?) -> MIRValueID LowerError! {
        if shape == {
            .Variant{variant, bindings, ..} -> {
                // Result payloads are owning carriers: inspect by reference, extract only on the selected arm.
                if subject_ty.without_user_tags() is .Result && (variant == "Ok" || variant == "Err") {
                    binding := ""
                    binding_span := self.span()
                    inner := MIRPatternShape?{None}
                    if bindings.len() == 0 {
                    } else if bindings.len() == 1 {
                        if bindings[0] == {
                            .Wildcard -> {}
                            .Bind{name, span} -> { binding = name; binding_span = span }
                            .Nested(nested) -> { inner = Val(nested.clone()) }
                            else -> { return Err(self.error(self.span(), "checked Result variant requires one payload binding")) }
                        }
                    } else { return Err(self.error(self.span(), "checked Result variant requires one payload binding")) }
                    converted := if variant == "Ok" -> MIRPatternShape.Ok{binding: binding, binding_span: binding_span, inner: inner, span: self.span()} else -> MIRPatternShape.Err{binding: binding, binding_span: binding_span, inner: inner, span: self.span()}
                    return self.lower_pattern_shape_condition(subject, subject_ty, None, converted, mutable, reuse_bindings, window)!
                }
                owner := owner.ok_or_else(fn() { self.error(self.span(), "checked variant pattern is missing its owner") })!
                test := self.emit_checked("pattern", Val(Type.Bool), MIROperation.EnumIs{subject: subject, owner: owner, variant: variant.clone()})!
                if bindings.iter().all(fn(binding) { binding is .Wildcard }) -> return test
                self.lower_guarded_pattern(test, fn(ctx: &LowerCtx) -> MIRValueID LowerError! {
                    tests := [MIRValueID]{test}
                    loop (index, binding) in bindings.iter().enumerate() {
                        if binding == {
                            .Wildcard -> {}
                            .Bind{name, ..} -> {
                                ty := ctx.variant_payload_type(owner, variant, index)!
                                if window == .Val(w) {
                                    place := ctx.project_payload_place(w, MIRPayloadKind.Enum{owner: owner, variant: variant.clone(), index: index}, ty)!
                                    ctx.bind_window_binding(name, ty, place)!
                                    continue
                                }
                                value := ctx.emit_checked("pattern", Val(ty), MIROperation.EnumPayload{subject: subject, owner: owner, variant: variant.clone(), index: index})!
                                ctx.bind_pattern_value(name, ty, value, mutable, reuse_bindings)!
                            }
                            .Range{lo, hi} -> {
                                ty := ctx.variant_payload_type(owner, variant, index)!
                                value := ctx.emit_checked("pattern", Val(ty), MIROperation.EnumPayload{subject: subject, owner: owner, variant: variant.clone(), index: index})!
                                &tests.push(ctx.lower_numeric_range(value, ty, lo, hi)!)
                            }
                            .Nested(inner) -> {
                                ty := ctx.enum_payload_type_for(subject_ty, variant, index).or_else(fn(_) { ctx.variant_payload_type(owner, variant, index) })!
                                value := ctx.emit_checked("pattern", Val(ty), MIROperation.EnumPayload{subject: subject, owner: owner, variant: variant.clone(), index: index})!
                                nested_window := MIRPlaceID?{None}
                                if window == .Val(w) { nested_window = Val(ctx.project_payload_place(w, MIRPayloadKind.Enum{owner: owner, variant: variant.clone(), index: index}, ty)!) }
                                &tests.push(ctx.lower_nested_pattern_condition(value, ty, inner, mutable, reuse_bindings, nested_window)!)
                            }
                        }
                    }
                    ctx.combine_pattern_tests(^tests, BinOp.And)!
                })!
            }
            .Present{binding, inner: nested, ..} -> {
                inner := if subject_ty == {
                    .Option(inner) -> inner.clone()
                    else -> { return Err(self.error(self.span(), "checked present pattern has a non-optional subject")) }
                }
                test := self.emit_checked("pattern", Val(Type.Bool), MIROperation.OptionIsSome{subject: subject})!
                if nested.is_none() && (binding.is_empty() || binding == "_") -> return test
                self.lower_guarded_pattern(test, fn(ctx: &LowerCtx) -> MIRValueID LowerError! {
                    if window == .Val(w) && nested.is_none() {
                        place := ctx.project_payload_place(w, MIRPayloadKind.Option, inner)!
                        ctx.bind_window_binding(binding, inner, place)!
                        return test
                    }
                    value := ctx.emit_checked("pattern", Val(inner), MIROperation.OptionValue{subject: subject})!
                    if nested == .Val(n) {
                        nested_window := MIRPlaceID?{None}
                        if window == .Val(w) { nested_window = Val(ctx.project_payload_place(w, MIRPayloadKind.Option, inner)!) }
                        return ctx.lower_nested_pattern_condition(value, inner, n, mutable, reuse_bindings, nested_window)!
                    }
                    ctx.bind_pattern_value(binding, inner, value, mutable, reuse_bindings)!
                    test
                })!
            }
            .Absent(_) -> {
                present := self.emit_checked("pattern", Val(Type.Bool), MIROperation.OptionIsSome{subject: subject})!
                self.emit_checked("pattern", Val(Type.Bool), MIROperation.Unary{op: mir_unary_op(UnOp.Not), value: present})!
            }
            .Ok{binding, inner: nested, ..} | .Err{binding, inner: nested, ..} -> {
                ok := shape is .Ok
                (success, error) := if subject_ty == {
                    .Result{ok, err} -> (ok.clone(), err.clone())
                    else -> { return Err(self.error(self.span(), "checked result pattern has a non-result subject")) }
                }
                test := self.emit_checked("pattern", Val(Type.Bool), MIROperation.ResultIsOk{subject: subject})!
                if !ok { test = self.emit_checked("pattern", Val(Type.Bool), MIROperation.Unary{op: mir_unary_op(UnOp.Not), value: test})! }
                if nested.is_none() && (binding.is_empty() || binding == "_") -> return test
                self.lower_guarded_pattern(test, fn(ctx: &LowerCtx) -> MIRValueID LowerError! {
                    value_ty := if ok -> success else -> error
                    payload := MIRPayloadKind.Result{ok: ok}
                    if window == .Val(w) && nested.is_none() {
                        place := ctx.project_payload_place(w, payload, value_ty)!
                        ctx.bind_window_binding(binding, value_ty, place)!
                        return test
                    }
                    value := ctx.emit_checked("pattern", Val(value_ty), MIROperation.ResultValue{subject: subject, ok: ok})!
                    if nested == .Val(n) {
                        nested_window := MIRPlaceID?{None}
                        if window == .Val(w) { nested_window = Val(ctx.project_payload_place(w, payload, value_ty)!) }
                        return ctx.lower_nested_pattern_condition(value, value_ty, n, mutable, reuse_bindings, nested_window)!
                    }
                    ctx.bind_pattern_value(binding, value_ty, value, mutable, reuse_bindings)!
                    test
                })!
            }
            .Range{lo, hi, ..} -> self.lower_numeric_range(subject, subject_ty, lo, hi)!
            .Or{alternatives, ..} -> {
                tests := [MIRValueID].with_capacity(alternatives.len())
                loop (index, alternative) in alternatives.iter().enumerate() {
                    // An or-pattern name cannot alias two payload slots; it stays read-only.
                    &tests.push(self.lower_pattern_shape_condition(subject, subject_ty, owner, alternative, mutable, reuse_bindings || index > 0, None)!)
                }
                self.combine_pattern_tests(^tests, BinOp.Or)!
            }
            .Struct{fields, ..} -> {
                owner := owner.ok_or_else(fn() { self.error(self.span(), "checked struct pattern is missing its owner") })!
                tests := [MIRValueID]{self.emit_checked("pattern", Val(Type.Bool), MIROperation.Constant(MIRConstant.Bool(true)))!}
                loop field in fields {
                    (field_id, value_ty, binding) := if field == {
                        .Bind{field, local, ..} -> (field, self.field_type_for_id(owner, field)!, Val(local))
                        .Value{field, ..} -> (field, self.field_type_for_id(owner, field)!, None)
                    }
                    if window == .Val(w) && binding == .Val(name) {
                        place := self.project_window_place(w, MIRProjection.Field{field: field_id, span: self.span()}, value_ty)!
                        self.bind_window_binding(name, value_ty, place)!
                        continue
                    }
                    projected := self.emit_checked("pattern", Val(value_ty), MIROperation.Field{base: subject, field: field_id})!
                    if binding == .Val(name) {
                        self.bind_pattern_value(name, value_ty, projected, mutable, reuse_bindings)!
                    } else if field == .Value{value, ..} {
                        &tests.push(self.emit_checked("pattern", Val(Type.Bool), MIROperation.Binary{op: mir_binary_op(BinOp.Eq), dispatch: MIRBinaryDispatch.Primitive, left: projected, right: value})!)
                    }
                }
                self.combine_pattern_tests(^tests, BinOp.And)!
            }
            .Text(parts, _) -> self.lower_text_pattern(subject, subject_ty, parts)!
            .Binary(parts, _) -> self.lower_binary_pattern(subject, subject_ty, parts)!
        }
    }

    // Rust: crates/jet-codegen/src/Codegen/TIR/mir.rs:9335
    // Nested payloads use their canonical owner; group heads expand as at the top level.
    fn lower_nested_pattern_condition(self: &Self, subject: MIRValueID, subject_ty: Type, shape: MIRPatternShape, mutable: Bool, reuse_bindings: Bool, window: MIRPlaceID?) -> MIRValueID LowerError! {
        owner := self.field_owner_id_for_type(subject_ty).ok()
        expanded := self.expand_nested_group_heads(shape, owner)
        self.lower_pattern_shape_condition(subject, subject_ty, owner, expanded, mutable, reuse_bindings, window)!
    }

    // Rust: crates/jet-codegen/src/Codegen/TIR/mir.rs:9357
    fn expand_nested_group_heads(self, shape: MIRPatternShape, owner: MIRTypeID?) -> MIRPatternShape Never! {
        if shape == {
            .Variant{variant, bindings, leading_dot, span} -> {
                if bindings.is_empty() {
                    leaves := owner.and_then(fn(id) { self.enum_group_leaves(id, variant) })
                    if leaves == .Val(rows) {
                        alternatives := [MIRPatternShape].with_capacity(rows.len())
                        loop leaf in rows { &alternatives.push(MIRPatternShape.Variant{variant: leaf, bindings: [MIRPatternBinding]{}, leading_dot: leading_dot, span: span}) }
                        return MIRPatternShape.Or{alternatives: ^alternatives, span: span}
                    }
                }
                shape.clone()
            }
            .Or{alternatives, span} -> {
                expanded := [MIRPatternShape].with_capacity(alternatives.len())
                loop alternative in alternatives { &expanded.push(self.expand_nested_group_heads(alternative, owner)) }
                MIRPatternShape.Or{alternatives: ^expanded, span: span}
            }
            else -> shape.clone()
        }
    }

    // Rust: crates/jet-codegen/src/Codegen/TIR/mir.rs:9396
    fn lower_guarded_pattern(self: &Self, test: MIRValueID, matched: fn(&LowerCtx) -> MIRValueID LowerError!) -> MIRValueID LowerError! {
        unmatched_from := self.current_block()
        matched_block := self.new_block(self.span(), "pattern-matched")!
        join := self.new_block(self.span(), "pattern-join")!
        self.terminate(MIRTerminator.Branch{condition: test, then_target: matched_block, else_target: join})
        self.switch_to(matched_block)
        result := matched(&self)!
        matched_from := self.current_block()
        self.terminate(MIRTerminator.Jump{target: join})
        self.switch_to(join)
        self.emit_checked("pattern-phi", Val(Type.Bool), MIROperation.Phi{incoming: [(unmatched_from, test), (matched_from, result)]})!
    }

    // Rust: crates/jet-codegen/src/Codegen/TIR/mir.rs:9423
    fn lower_text_pattern(self: &Self, _subject: MIRValueID, _subject_ty: Type, _parts: [MIRTextPatternPart]) -> MIRValueID LowerError! {
        Err(self.error(self.span(), "checked text pattern route is not registered"))
    }

    // Rust: crates/jet-codegen/src/Codegen/TIR/mir.rs:9432
    fn lower_binary_pattern(self: &Self, _subject: MIRValueID, _subject_ty: Type, _parts: [MIRBinaryPatternPart]) -> MIRValueID LowerError! {
        Err(self.error(self.span(), "checked binary pattern route is not registered"))
    }

    // Rust: crates/jet-codegen/src/Codegen/TIR/mir.rs:9444
    fn combine_pattern_tests(self: &Self, tests: [MIRValueID], op: BinOp) -> MIRValueID LowerError! {
        result := MIRValueID?{&tests.pop()}
        if result.is_none() -> return self.emit_checked("pattern", Val(Type.Bool), MIROperation.Constant(MIRConstant.Bool(true)))!
        combined := result.unwrap()
        loop {
            next := &tests.pop()
            if next == .Val(value) {
                combined = self.emit_checked("pattern", Val(Type.Bool), MIROperation.Binary{op: mir_binary_op(op), dispatch: MIRBinaryDispatch.Primitive, left: combined, right: value})!
            } else { break }
        }
        combined
    }

    // Rust: crates/jet-codegen/src/Codegen/TIR/mir.rs:9471
    fn lower_numeric_range(self: &Self, subject: MIRValueID, ty: Type, lo: I64, hi: I64) -> MIRValueID LowerError! {
        lower := self.emit_checked("pattern", Val(ty), MIROperation.Constant(MIRConstant.Int{value: lo, width: int_width(ty), spelling: None}))!
        upper := self.emit_checked("pattern", Val(ty), MIROperation.Constant(MIRConstant.Int{value: hi, width: int_width(ty), spelling: None}))!
        ge := self.emit_checked("pattern", Val(Type.Bool), MIROperation.Binary{op: mir_binary_op(BinOp.Ge), dispatch: MIRBinaryDispatch.Primitive, left: subject, right: lower})!
        le := self.emit_checked("pattern", Val(Type.Bool), MIROperation.Binary{op: mir_binary_op(BinOp.Le), dispatch: MIRBinaryDispatch.Primitive, left: subject, right: upper})!
        self.emit_checked("pattern", Val(Type.Bool), MIROperation.Binary{op: mir_binary_op(BinOp.And), dispatch: MIRBinaryDispatch.Primitive, left: ge, right: le})!
    }

    // Rust: crates/jet-codegen/src/Codegen/TIR/mir.rs:9528
    fn bind_pattern_value(self: &Self, name: String, ty: Type, value: MIRValueID, mutable: Bool, reuse_binding: Bool) -> Void LowerError! {
        if name.is_empty() || name == "_" -> return
        place := if reuse_binding -> self.local_places.get(name).copied().ok_or_else(fn() { self.error(self.span(), "missing checked alternative binding `{name}`") })! else -> self.bind_named_local(name, ty, mutable)!
        _ :: self.emit_checked("pattern", None, MIROperation.WritePlace{place: place, value: value})!
    }

    // Rust: crates/jet-codegen/src/Codegen/TIR/mir.rs:9553
    pub fn bind_success_pattern(self: &Self, subject: MIRValueID, pattern: MIRPattern) -> Void LowerError! {
        subject_ty := self.value_source_type(subject)!
        self.bind_success_shape(subject, subject_ty, pattern.owner, pattern.shape, pattern.mutable)!
    }

    // Rust: crates/jet-codegen/src/Codegen/TIR/mir.rs:9568
    fn bind_success_shape(self: &Self, subject: MIRValueID, subject_ty: Type, owner: MIRTypeID?, shape: MIRPatternShape, mutable: Bool) -> Void LowerError! {
        // Immutable read-window bindings alias payload places rather than copying them out.
        window := self.pattern_windows.get(subject).copied().filter(fn(w) { !mutable && self.read_windows.contains(w) })
        if shape == {
            .Variant{variant, bindings, ..} -> {
                if owner.is_none() -> return
                owner := owner.unwrap()
                loop (index, binding) in bindings.iter().enumerate() {
                    if binding == {
                        .Bind{name, ..} -> {
                            ty := self.variant_payload_type(owner, variant, index)!
                            if window == .Val(w) {
                                place := self.project_payload_place(w, MIRPayloadKind.Enum{owner: owner, variant: variant.clone(), index: index}, ty)!
                                self.bind_window_binding(name, ty, place)!
                                continue
                            }
                            value := self.emit_checked("pattern", Val(ty), MIROperation.EnumPayload{subject: subject, owner: owner, variant: variant.clone(), index: index})!
                            self.bind_pattern_value(name, ty, value, mutable, false)!
                        }
                        .Nested(inner) -> {
                            ty := self.enum_payload_type_for(subject_ty, variant, index).or_else(fn(_) { self.variant_payload_type(owner, variant, index) })!
                            value := self.emit_checked("pattern", Val(ty), MIROperation.EnumPayload{subject: subject, owner: owner, variant: variant.clone(), index: index})!
                            nested_owner := self.field_owner_id_for_type(ty).ok()
                            self.bind_success_shape(value, ty, nested_owner, inner, mutable)!
                        }
                        .Wildcard | .Range{..} -> {}
                    }
                }
            }
            .Present{binding, inner: nested, ..} -> {
                if nested.is_none() && (binding.is_empty() || binding == "_") -> return
                inner := if subject_ty == {
                    .Option(inner) -> inner.clone()
                    else -> { return Err(self.error(self.span(), "checked present pattern has a non-optional subject")) }
                }
                if window == .Val(w) && nested.is_none() {
                    place := self.project_payload_place(w, MIRPayloadKind.Option, inner)!
                    return self.bind_window_binding(binding, inner, place)!
                }
                value := self.emit_checked("pattern", Val(inner), MIROperation.OptionValue{subject: subject})!
                if nested == .Val(n) {
                    nested_owner := self.field_owner_id_for_type(inner).ok()
                    return self.bind_success_shape(value, inner, nested_owner, n, mutable)!
                }
                self.bind_pattern_value(binding, inner, value, mutable, false)!
            }
            .Ok{binding, inner: nested, ..} | .Err{binding, inner: nested, ..} -> {
                if nested.is_none() && (binding.is_empty() || binding == "_") -> return
                ok := shape is .Ok
                (success, error) := if subject_ty == {
                    .Result{ok, err} -> (ok.clone(), err.clone())
                    else -> { return Err(self.error(self.span(), "checked result pattern has a non-result subject")) }
                }
                value_ty := if ok -> success else -> error
                if window == .Val(w) && nested.is_none() {
                    place := self.project_payload_place(w, MIRPayloadKind.Result{ok: ok}, value_ty)!
                    return self.bind_window_binding(binding, value_ty, place)!
                }
                value := self.emit_checked("pattern", Val(value_ty), MIROperation.ResultValue{subject: subject, ok: ok})!
                if nested == .Val(n) {
                    nested_owner := self.field_owner_id_for_type(value_ty).ok()
                    return self.bind_success_shape(value, value_ty, nested_owner, n, mutable)!
                }
                self.bind_pattern_value(binding, value_ty, value, mutable, false)!
            }
            .Or{alternatives, ..} -> { loop alt in alternatives { self.bind_success_shape(subject, subject_ty, owner, alt, mutable)! } }
            else -> {}
        }
    }

    // Rust: crates/jet-codegen/src/Codegen/TIR/mir.rs:9721
    fn write_local_id(self: &Self, local: MIRLocalID, value: MIRValueID) -> Void LowerError! {
        place := self.locals.iter().find(fn(candidate) { candidate.id == local }).map(fn(candidate) { candidate.place }).ok_or_else(fn() { self.error(self.span(), "missing MIR pattern local {local:?}") })!
        _ :: self.emit_checked("pattern", None, MIROperation.WritePlace{place: place, value: value})!
    }

    // Rust: crates/jet-codegen/src/Codegen/TIR/mir.rs:9734
    pub fn enum_payload_type_for(self, ty: Type, variant: String, index: USize) -> Type LowerError! {
        owner := self.field_owner_id_for_type(ty)!
        payload := self.variant_payload_type(owner, variant, index)!
        if ty == .Apply{args, ..} {
            if self.type_defs.iter().find(fn(definition) { definition.id == owner }) == .Val(definition) {
                substitutions := [String:Type]{}
                loop (param, arg) in definition.generic_params.iter().zip(args) { &substitutions.insert(param.name.clone(), arg.clone()) }
                return substitute_type(payload, substitutions)
            }
        }
        payload
    }

    // Rust: crates/jet-codegen/src/Codegen/TIR/mir.rs:9756
    fn variant_payload_type(self, owner: MIRTypeID, variant: String, index: USize) -> Type LowerError! {
        row := self.type_defs.iter().find(fn(row) { row.id == owner }).ok_or_else(fn() { self.error(self.span(), "missing MIR owner {owner:?}") })!
        variants := if row.kind == {
            .Enum{variants, ..} -> variants
            else -> { return Err(self.error(self.span(), "MIR owner {owner:?} is not an enum")) }
        }
        found := variants.iter().find(fn(candidate) { candidate.name == variant }).ok_or_else(fn() { self.error(self.span(), "missing MIR enum variant `{variant}`") })!
        if found.payload == {
            .Unit -> Err(self.error(self.span(), "unit MIR variant `{found.name}` has no payload {index}"))
            .Single(ty) -> {
                if index == 0 -> return mir_type_as_ast(ty)
                Err(self.error(self.span(), "single MIR variant `{found.name}` has no payload {index}"))
            }
            .Named(fields) -> fields.get(index).map(fn(field) { mir_type_as_ast(field.ty) }).ok_or_else(fn() { self.error(self.span(), "MIR variant `{found.name}` has no payload {index}") })!
        }
    }

    // Rust: crates/jet-codegen/src/Codegen/TIR/mir.rs:9801
    fn field_type_for_id(self, owner: MIRTypeID, field: MIRFieldID) -> Type LowerError! {
        row := self.type_defs.iter().find(fn(row) { row.id == owner }).ok_or_else(fn() { self.error(self.span(), "missing MIR owner {owner:?}") })!
        fields := if row.kind == {
            .Struct{fields, ..} -> fields
            .Enum{variants, ..} -> {
                loop variant in variants {
                    if variant.payload == .Named(fields) {
                        if fields.iter().find(fn(candidate) { candidate.id == field }) == .Val(found) -> return mir_type_as_ast(found.ty)
                    }
                }
                return Err(self.error(self.span(), "missing MIR field {field:?}"))
            }
            else -> { return Err(self.error(self.span(), "MIR owner {owner:?} has no fields")) }
        }
        fields.iter().find(fn(candidate) { candidate.id == field }).map(fn(field) { mir_type_as_ast(field.ty) }).ok_or_else(fn() { self.error(self.span(), "missing MIR field {field:?}") })!
    }

    // Rust: crates/jet-codegen/src/Codegen/TIR/mir.rs:9828
    pub fn field_type(self, ty: Type, field: String) -> Type? Never! {
        if ty == {
            .Tuple(fields) -> fields.iter().find(fn(row) { row.0 == field }).map(fn(row) { row.1.clone() })
            else -> None
        }
    }

    // Rust: crates/jet-codegen/src/Codegen/TIR/mir.rs:9838
    fn field_type_for_type(self, ty: Type, field: String) -> Type LowerError! {
        normalized := self.normalize_contextual_type(ty)
        ty := field_owner_type(normalized)
        if self.field_type(ty, field) == .Val(field_ty) -> return field_ty
        owner := self.field_owner_id_for_type(ty)!
        field_id := self.field_id_for(owner, field)!
        field_ty := self.field_type_for_id(owner, field_id)!
        if ty == .Apply{args, ..} {
            if self.type_defs.iter().find(fn(definition) { definition.id == owner }) == .Val(definition) {
                substitutions := [String:Type]{}
                loop (param, arg) in definition.generic_params.iter().zip(args) { &substitutions.insert(param.name.clone(), arg.clone()) }
                return substitute_type(field_ty, substitutions)
            }
        }
        field_ty
    }

