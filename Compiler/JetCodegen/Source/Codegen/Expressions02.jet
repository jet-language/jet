// Private expression fragment extending the canonical checked MIR lowering context.
use jet_codegen.Codegen.TIR.mir.[LowerCtx, LowerError, int_width, mir_type_as_ast, field_owner_type, retain_place_access, construct_identity, stable_id, lower_function, fn_value_carrier_adaptation, is_plain_call_return]
use jet_codegen.Codegen.TIR.[mir_binary_op, mir_unary_op, index_miss_route, TLocal, TLambda, TLambdaBody, TExpr, TExprKind, TCallArg, TFnValueKind, TCaptureFacts, TEffectFacts, TFailureCarrier, TFunc, TFuncKind, TTargetApplicability, TVisibility, TExclusivity]
use jet_codegen.Codegen.TIR.tir_to_mir_expr.lower_receiver_place
use jet_codegen.Generics.substitute_type
use jet_foundation.[Type, Span, AccessConvention, FunctionCallMetadata, union_member_tag]
use jet_foundation.MIR.[MIRValueID, MIRPlaceID, MIRLocalID, MIRTypeID, MIRFieldID, MIRPattern, MIRPatternShape, MIRPatternBinding, MIRPatternField, MIRPayloadKind, MIROperation, MIRConstant, MIRBinaryDispatch, MIRTerminator, MIRTextPatternPart, MIRBinaryPatternPart, MIRTypeDefKind, MIRVariantPayload, MIRTypeKind, MIRAccess, MIRPlace, MIRPlaceBase, MIRProjection, MIRABI, MIRCaptureFacts, MIRCaptureParam, MIRCaptureOperand, MIRLocal, MIROwnership, MIROwnershipMode, MIRCopyFact, MIRFunctionID, MIRCallArg, MIRCallee, MIRUnionCoercion]
