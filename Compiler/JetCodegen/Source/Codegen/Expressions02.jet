//RS     /// #3740: a function value keeps the `Result` carrier its checked `fn`
//RS     /// type names, while a plain-return function (`T Never!`) returns `T`.
//RS     /// Close over the call once and lift its value into `Ok` — the same seam
//RS     /// `adapt_fn_value_carrier` gives a raw-payload value — so every tier
//RS     /// sees one callable ABI in the value slot. The slot may name `T Never!`
//RS     /// or, when it was checked before the failure solve (a generated policy
//RS     /// wrapper's `call` slot, #3708), the default `Result<T, Err>`. `None`
//RS     /// when the named function already returns the value type's carrier.
//RS     pub(super) fn plain_named_fn_value(
//RS         &mut self,
//RS         name: &str,
//RS         function: MirFunctionId,
//RS         value_ty: &Type,
//RS         send: bool,
//RS     ) -> Result<Option<MirValueId>, LowerError> {
