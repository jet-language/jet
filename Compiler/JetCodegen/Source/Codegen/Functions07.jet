//RS /// A lowered statement. Only the constructs the Phase-1 subset allows.
//RS #[derive(Clone)]
//RS pub enum TStmt {
//RS     /// D-FAIL-TIER1: one executable contract check.  A precondition node is
//RS     /// placed immediately before the call that supplies its arguments;
//RS     /// postconditions live in `ContractScope` around the callee body.
//RS     Contract {
//RS         contract: TContract,
//RS     },
//RS     /// against the sema-visible result binding on successful returns, while a
//RS     /// failure carrier bypasses postconditions and crosses the scope unchanged.
//RS     ContractScope {
//RS         pre: Vec<TContract>,
//RS         body: Vec<TStmt>,
//RS         post: Vec<TContract>,
//RS         result: TContractResult,
//RS     },
//RS     /// `let [mut] name[: ty] = init;`. All presentation facts are resolved at
//RS     /// lowering, reproducing `emit_let` (Source/Codegen/Statement.rs) byte-for-byte:
//RS     /// `kw` is `"let"` or `"let mut"` (the `mut` accounts for the source `mutable`
//RS     /// flag AND the forced-mut cases — a handle binding FileReader/FileWriter/
//RS     /// TcpStream/HTTPRouter/Arena/… needs `let mut` even when bound immutably, an
//RS     /// escaping FnMut lambda binding, or an owned `ResourceTake`); `let_ty` is the
//RS     /// structured annotation (emit spells the `: …` clause). The binding's resolved
//RS     /// type is carried on the `LowerEnv` slot (for downstream facts), so it is not
//RS     /// duplicated on the node.
//RS     Let {
//RS         name: String,
//RS         kw: &'static str,
//RS         let_ty: TLetTy,
//RS         init: TExpr,
//RS         /// D-OPTGC1=A: sema's complete automatic-promotion decision.
//RS         gc_promotion: Option<crate::AST::GcPromotion>,
//RS         gc_transferred: bool,
//RS     },
//RS     /// D-CHOOSE-TEST1=A: a subject-first pattern test whose miss route
//RS     /// diverges. Unlike an `if let`, Rust's `let ... else` keeps every capture
//RS     /// in the surrounding scope. The same node lets the interpreter bind into
//RS     /// its current scope before continuing, preserving tier parity.
//RS     RefutableBind {
//RS         pattern: TPattern,
//RS         init: TExpr,
//RS         fallback: Vec<TStmt>,
//RS     },
//RS     /// D-OPTGC1=A: assignment through a collector-owned bare value.
//RS     GcEdit {
//RS         root: String,
//RS         slot: String,
//RS         edges: Vec<String>,
//RS         replace_all: bool,
//RS         index_temp: Option<(String, TExpr)>,
//RS         stmt: Box<TStmt>,
//RS     },
//RS     /// D-SHAPE-PLACE1=A: one acquisition in a sema-proven disjoint constant
//RS     /// index/range partition. The first acquisition initializes `root`; later
//RS     /// acquisitions split a retained region at their original statement.
//RS     SplitViews {
//RS         owner: Option<TExpr>,
//RS         root: String,
//RS         len: String,
//RS         source: String,
//RS         source_start: i64,
//RS         before: String,
//RS         split_tail: String,
//RS         segment: String,
//RS         after: String,
//RS         name: String,
//RS         start: i64,
//RS         end: i64,
//RS         single: bool,
//RS         write: bool,
//RS         elem_ty: Option<Type>,
//RS         line: usize,
//RS     },
//RS     /// c109 Phase 23: a TUPLE-destructuring binding `(a, b) :: <init>` (S74,
//RS     /// `BindPattern::Tuple`). The checked init type supplies the canonical source
//RS     /// field labels and field types; MIR resolves each projection by position and
//RS     /// the backend chooses the Rust spelling from the checked field row. `tmp` is
//RS     /// retained for the legacy TIR shape; `kw` is `"let"`/`"let mut"`.
//RS     TupleDestructure {
//RS         tmp: String,
//RS         init: TExpr,
//RS         kw: &'static str,
//RS         /// Non-copyable guard fields must move out of the owned tuple instead
//RS         /// of borrowing it and accidentally cloning the guarded value.
//RS         move_fields: bool,
//RS         /// `(source_binding, checked_field_label)` in canonical source order.
//RS         binds: Vec<(String, String)>,
//RS     },
//RS     /// c109: a STRUCT-destructuring binding `Type.{ x, y } :: <init>` (S74,
//RS     /// `BindPattern::Struct`). The checked field label is carried unchanged;
//RS     /// MIR resolves its type and stable field ID before backend spelling.
//RS     StructDestructure {
//RS         tmp: String,
//RS         init: TExpr,
//RS         kw: &'static str,
//RS         /// Structs containing a SharedGuard are consumed so the owned guard
//RS         /// moves into the binding instead of cloning its dereferenced payload.
//RS         move_fields: bool,
//RS         /// `(source_binding, checked_field_label)` in source order.
//RS         binds: Vec<(String, String)>,
//RS     },
//RS     /// c109 Phase 26: a LIST-destructuring binding `[a, b, c] :: <init>` (S74,
//RS     /// `BindPattern::List`). Reproduces `emit_stmt`'s `BindPattern::List` arm
//RS     /// byte-for-byte: a `let {tmp} = &({init});` borrow temp, then one
//RS     /// `let[ mut] {elem_rust} = jet_unpack_vec({tmp}, {want}, {i}, {file:?}, {line});`
//RS     /// per element. `want` is the element count, `i` the position, and `file`/`line`
//RS     /// the destructure span's source location (resolved at lowering for the
//RS     /// bounds-mismatch panic). Each element binds a non-deref slot whose type
//RS     /// reproduces `expr_jet_ty(init)`'s `Some(List(inner))` partiality (a non-`List`
//RS     /// init — e.g. a `[T#N]` fan-out result — yields `None`, matching the AST).
//RS     ListDestructure {
//RS         tmp: String,
//RS         init: TExpr,
//RS         kw: &'static str,
//RS         want: usize,
//RS         file: String,
//RS         line: usize,
//RS         /// `elem_rust_name` per bound element, source order.
//RS         elems: Vec<String>,
//RS     },
//RS     /// `place [op]= value;` to a plain local (subset excludes indexed assigns).
//RS     /// `op` is the compound-assignment operator (`+=` etc.) or `None` for `=`.
//RS     Assign {
//RS         /// The structured target: a local slot, or a place expression (a field
//RS         /// chain, a `Pool` slot). Every engine reads the structure; only emit
//RS         /// spells Rust.
//RS         place: TPlace,
//RS         op: Option<BinOp>,
//RS         value: TExpr,
//RS         /// c150: true when the value is a borrowed non-scalar ident (a `Read`-convention
//RS         /// non-Copy parameter in deref position). Assigning `(*__jet_s)` directly moves
//RS         /// out of a shared reference (E0507); emitting `((*__jet_s)).clone()` is correct.
//RS         /// Mirrors the `lower_enum_arg` clone predicate. False for scalars and owned values.
//RS         clone_value: bool,
//RS         /// Source line of the assignment, so a compound operator that traps
//RS         /// (D-EXPSEM1: `^=`) can name the line the author wrote.
//RS         line: u32,
//RS     },
//RS     Return(Option<TExpr>),
//RS     /// A call used for effect: `print(x);`, `helper(a);`.
//RS     ExprStmt(TExpr),
//RS     /// D-CONC-SPAWN1=D: a lexical structured-concurrency scope. Engines create
//RS     /// one group, run `body`, and close it on every exit path.
//RS     TaskGroup {
//RS         group: TLocal,
//RS         limit: Option<TExpr>,
//RS         body: Vec<TStmt>,
//RS     },
//RS     /// D-SHAPE-RESOURCE2=A: one sema-checked `defer close(^resource)` action.
//RS     /// MIR lowering emits `close` inline on every exit edge of the enclosing
//RS     /// scope, where the consuming `^resource` is an ordinary move.
//RS     DeferClose { close: TExpr, resource: TLocal },
//RS     /// Statement-form `if`/`else`. `else_body` is `None` for a bare `if`.
//RS     /// `cond` (c109 Phase 22) is a `TIfCond`: a plain boolean expr, an optional-binding
//RS     /// `if let <pat> = <subj>` (an `x == value(b)`/`Ok(b)`/`Err(b)`/variant condition),
//RS     /// or an `<subj>.is_none()` test (`x == null`) — reproducing `emit_if`'s three
//RS     /// condition shapes (Source/Codegen/Statement.rs).
//RS     /// `else_is_elseif` distinguishes a nested residual guard arm from the
//RS     /// explicit `else` body of the canonical subjectless `Switch`: nested arms
//RS     /// emit as `} else if …`, while the final body stays `} else { … }`.
//RS     If {
//RS         cond: TIfCond,
//RS         then_body: Vec<TStmt>,
//RS         else_body: Option<Vec<TStmt>>,
//RS         else_is_elseif: bool,
//RS     },
//RS     /// `loop { … }` — an infinite loop (`Stmt::Loop`). `label` is the optional
//RS     /// `name :: loop` rendered as `'jet_<name>:` (resolved at lowering, never re-derived).
//RS     Loop {
//RS         label: Option<String>,
//RS         body: Vec<TStmt>,
//RS     },
//RS     /// `loop cond { … }` — the while form (`Stmt::While`). Lowers to Rust `while`.
//RS     While {
//RS         label: Option<String>,
//RS         cond: TExpr,
//RS         body: Vec<TStmt>,
//RS     },
//RS     /// D-LOOP-SEMICOLON1=A: `loop init; cond; step { … }` — the three-part counted loop.
//RS     /// Emitted as `{ let mut init_name = init_val; loop { if !(cond) { break; } body; step; } }`.
//RS     CountedLoop {
//RS         label: Option<String>,
//RS         init: Box<TStmt>,
//RS         cond: TExpr,
//RS         step: Option<Box<TStmt>>,
//RS         /// D-SIMD3=B: preserve sema's complete loop proof when a numeric range
//RS         /// is canonicalized into this counted shape.  The TIR-to-MIR boundary
//RS         /// binds it to the emitted header, cursor, body, advance, and access
//RS         /// identities; consumers never rebind it from source spelling.
//RS         auto_vectorization: Option<crate::AST::AutoVectorizationFacts>,
//RS         body: Vec<TStmt>,
//RS     },
//RS     /// `loop i in start..end [, stride]` — a numeric range loop (`ForKind::Range`).
//RS     /// Inclusive `..` (S22) lowers to `start..=end`; exclusive `..<`
//RS     /// (D-RANGE-EXCL1=C) lowers to `start..end`. Optional stride uses `.step_by`.
//RS     Range {
//RS         label: Option<String>,
//RS         var: String,
//RS         /// D-RANGE-VALUE1=A: `Some` evaluates one Range value once. Literal
//RS         /// ranges keep `None` and the direct start/end jump lowering.
//RS         source: Option<TExpr>,
//RS         start: TExpr,
//RS         end: TExpr,
//RS         step: Option<TExpr>,
//RS         exclusive: bool,
//RS         /// D-SIMD3=B: sema's complete loop proof for the loop's vectorizable
//RS         /// shape.  Lowering carries it with the exact emitted MIR scope and
//RS         /// access identities, rather than reconstructing proof from syntax.
//RS         auto_vectorization: Option<crate::AST::AutoVectorizationFacts>,
//RS         body: Vec<TStmt>,
//RS     },
//RS     /// `break` / `break(name)` (label resolved at lowering).
//RS     Break(Option<String>),
//RS     /// `break value` / `break(name, value)`.
//RS     BreakValue {
//RS         label: Option<String>,
//RS         value: TExpr,
//RS     },
//RS     /// Source `next` / `next(name)`; internally retained as Continue.
//RS     Continue(Option<String>),
//RS     /// c109 Phase 4: an exhaustive `when`/match on an enum subject (`Stmt::Switch`
//RS     /// whose arms are all variant patterns). Lowers to a Rust `match`, mirroring
//RS     /// `emit_pattern_match_switch` byte-for-byte. `subject` is the already-lowered
//RS     /// subject expression; `clone_subject` reproduces the AST path's `(subj).clone()`
//RS     /// when the subject reads as a borrow (a by-reference enum param), so the match
//RS     /// owns the value. Each arm carries its resolved Rust pattern string and an
//RS     /// optional range-guard string (both fully resolved at lowering — emit makes no
//RS     /// pattern decision). `fallthrough` records whether the AST path appends the
//RS     /// `_ => unreachable!("jet: exhaustiveness bug")` arm (true when there is no
//RS     /// explicit `else`); sema already proved exhaustiveness (E0307), so the dead arm
//RS     /// exists only because rustc cannot see that proof.
//RS     EnumMatch {
//RS         /// The matched subject. A by-reference subject sets `clone_subject` so the
//RS         /// match owns the value; the slot itself is read without its deref.
//RS         scrutinee: TExpr,
//RS         clone_subject: bool,
//RS         arms: Vec<TMatchArm>,
//RS         else_body: Option<Vec<TStmt>>,
//RS         fallthrough: bool,
//RS     },
//RS     /// c109 Phase 4: a `when`/match whose arms are all arm-head *range* patterns
//RS     /// (`0..59 -> …`) over a scalar subject, plus a required `else`. The AST path
//RS     /// (`emit_mixed_switch`) lowers this to an `if/else if … else` chain wrapped in
//RS     /// a block that binds `__jet_switch_subject` to a borrow of the subject (the
//RS     /// binding is unused in this form but emitted for parity). Each arm's `(lo, hi)`
//RS     /// becomes `(subj >= lo && subj <= hi)`, reading the subject's resolved place.
//RS     RangeSwitch {
//RS         /// The matched subject expression. Emit borrows it for the
//RS         /// `__jet_switch_subject` binding and re-emits it in each range test.
//RS         subject: TExpr,
//RS         arms: Vec<(i64, i64, Vec<TStmt>)>,
//RS         else_body: Vec<TStmt>,
//RS     },
//RS     /// c109 Phase 5: indexed assignment `coll[i] = value` (`Stmt::Assign` with an
//RS     /// `LValue::Index`). `is_map` is the resolved `IndexKind` (TOTAL, from sema):
//RS     /// `true` → `jet_map_insert(&mut (base), (i).clone(), v)`; `false` →
//RS     /// `(base)[i as usize] = v`. `base` may itself be an index projection: each
//RS     /// engine must lower that chain as a mutable place, not as a cloned value.
//RS     /// Both wrap the value in a `{ let __jet_v = …; … }` block, byte-for-byte the
//RS     /// AST `LValue::Index` form. Compound ops (`+=`) on an index are not a Jet
//RS     /// construct here (the parser/sema only admit a plain `=` to an index lvalue),
//RS     /// so no `op` is carried.
//RS     IndexAssign {
//RS         /// The base is fixed-list storage created with `Type.{ uninit }`.
//RS         /// Engines keep the same TIR operation but choose storage-safe writes.
//RS         uninit: bool,
//RS         base: TExpr,
//RS         index: TExpr,
//RS         is_map: bool,
//RS         value: TExpr,
//RS     },
//RS     /// D-SHAPE-PLACE1: `coll[i].field [op]= value`.
//RS     IndexFieldAssign(Box<TIndexFieldAssign>),
//RS     /// D-INDEX-HOOK: `mytype[k] = v` via `IndexMut::set`.
//RS     IndexHookAssign {
//RS         type_name: String,
//RS         base: TExpr,
//RS         index: TExpr,
//RS         value: TExpr,
//RS     },
//RS     /// D-SWIZZLE1: write swizzle `v.xy = value` — ordered lane assignments into the
//RS     /// receiver's backing array. Sema rejects overlapping patterns (E3111).
//RS     MathSwizzleAssign {
//RS         base: TExpr,
//RS         type_name: String,
//RS         lanes: Vec<u8>,
//RS         value: TExpr,
//RS         clone_value: bool,
//RS     },
//RS     /// c109 Phase 5/22: collection iteration `loop x in coll` / `loop (k, v) in map`
//RS     /// (`Stmt::For` with `ForKind::In`). `var2` distinguishes the two-binding map
//RS     /// form (which iterates `(coll).iter()` and clones each key/value) from the
//RS     /// single-binding form (`(coll).iter().cloned()`), reproducing `emit_for_in`
//RS     /// exactly. `method_kind` (c109 Phase 22) carries the method-call-collection
//RS     /// iteration form (`.chars()` char iteration, `.lines()` streaming reads)
//RS     /// resolved at lowering off the same `emit_for_in` branch; `None` is the plain
//RS     /// `.iter()` form (incl. a non-special method-call collection like `.split(…)`,
//RS     /// which the AST routes to the `.iter().cloned()` default). When `method_kind`
//RS     /// is set `source` holds the method *receiver* (not the whole method call), and
//RS     /// `var2` is always `None` (a method-call collection is single-binding only).
//RS     ForIn {
//RS         label: Option<String>,
//RS         var: String,
//RS         var2: Option<String>,
//RS         /// The expression iterated over: the method receiver for a method-call
//RS         /// form, otherwise the whole collection (including codec readers).
//RS         source: TExpr,
//RS         /// The whole collection expression, whose type carries the element type.
//RS         collection: TExpr,
//RS         /// D-LOOP-ADVANCE2=A source stride, evaluated once before the first pull.
//RS         step: Option<TExpr>,
//RS         method_kind: Option<TForInMethod>,
//RS         /// D-SOA1 / D-SOA-TIER1=A: the collection is a `#layout(columnar)` list —
//RS         /// iterate the gathered record view (`iter_aos()`, owned `S` pulled out of
//RS         /// the shared column store) instead of `iter().cloned()`. Always `false`
//RS         /// for the map/method forms.
//RS         columnar: bool,
//RS         /// D-ONCE-WORD1 / D-CONC-STREAM1: the collection is a `Stream<T>` —
//RS         /// iterate it directly BY VALUE; the shared Stream Prelude owns the
//RS         /// producer task and cancellation at the consumer's wait boundary.
//RS         by_value: bool,
//RS         /// #4318 §4 stable loop source: the source is a place (a local or
//RS         /// parameter through field, payload and list-index projections) and the
//RS         /// body never mentions any name the source reads, so nothing can change
//RS         /// it while the loop runs. Lowering then walks it in place
//RS         /// (`read_list_walk`) instead of iterating a snapshot copy.
//RS         source_stable: bool,
//RS         body: Vec<TStmt>,
//RS     },
//RS     /// c109 Phase 15: a resolved comptime-if (`Stmt::ComptimeIf`). Sema picked the
//RS     /// branch (`selected_then`); the AST `emit_stmts` emits ONLY that branch's
//RS     /// statements INLINE at the same indent (no `if`, no block — and its `let`s leak
//RS     /// into the outer scope, exactly like a plain block). The TIR carries the lowered
//RS     /// statements of the selected branch and emits them with no wrapper. When the
//RS     /// selected branch is `else` but there is no else-body (or sema didn't resolve),
//RS     /// this holds an empty vec (emits nothing).
//RS     Inline(Vec<TStmt>),
//RS     /// D-CANVASSTATE1=D: `#DebugOnly <stmt>` / `#DebugOnly { … }`.
//RS     /// AOT emission gates this behind `#[cfg(not(jet_release))]`; dev/JIT tiers
//RS     /// lower it as ordinary debug code. `#Off` has no TIR node: it lowers to an
//RS     /// empty `Inline`.
//RS     DebugOnly(Vec<TStmt>),
//RS     /// c109 Phase 15: a MIXED comparison/Bool `when` switch (`emit_mixed_switch`,
//RS     /// Source/Codegen/Statement.rs) — the general `if/else if … else` form used when the
//RS     /// arms are NOT all-variant (that is shape A, a Rust `match`), NOT all-range (shape
//RS     /// B, `RangeSwitch`), and NOT all-fallible (shape C). Each arm head is a plain
//RS     /// comparison/Bool expression. The AST path wraps the chain in a block that binds
//RS     /// `__jet_switch_subject = &(subject)` (emitted for parity even when unused), then an
//RS     /// `if/else if …` chain over each arm's condition, with the `else`/fallthrough form
//RS     /// reproduced exactly. Each arm's condition is resolved to a Rust string at lowering
//RS     /// (emit makes no decision). `else_body` is the optional `else` arm.
//RS     MixedSwitch {
//RS         /// The matched subject. Emit borrows it for the parity binding; arm
//RS         /// conditions are already structured `TExpr` values.
//RS         subject: TExpr,
//RS         class: BranchClass,
//RS         arms: Vec<(TExpr, Vec<TStmt>)>,
//RS         else_body: Option<Vec<TStmt>>,
//RS     },
//RS     /// c109 Phase 18: an audited `#Unsafe { … }` gate region (`Stmt::Unsafe`, S58,
//RS     /// E2-M13/D-LL1). The AST `emit_stmts` lowers it straight to a Rust `unsafe { … }`
//RS     /// block; the `#Audit("…")` annotation (the `audit` field) emits NOTHING (codegen is
//RS     /// dumb — sema validated the audit). I1: this TIR node exists ONLY for a source
//RS     /// `#Unsafe` region, so the emitted `unsafe { … }` is always 1:1 with a source gate.
//RS     /// Body bindings use the `unsafe` block's child lexical env.
//RS     Unsafe {
//RS         gate: TUnsafeGate,
//RS         body: Vec<TStmt>,
//RS     },
//RS     /// D-MEM-SENTRY1: a source/package sentry policy scope. It changes only
//RS     /// the Prelude gate bit and preserves the enclosing gate provenance.
//RS     SentryPolicy {
//RS         enabled: bool,
//RS         body: Vec<TStmt>,
//RS     },
//RS     /// D-CTEFFECT1: an explicit `#Impure("reason") { … }` policy gate.
//RS     /// AOT/JIT execute a plain lexical block; comptime evaluation raises its
//RS     /// impurity depth only while evaluating this body.
//RS     Impure(Vec<TStmt>),
//RS     /// D-REACTCORE1: `#Reactive { … }` — register a reactive effect at this point.
//RS     /// The executable body is lowered once into the shared MIR.
//RS     Reactive {
//RS         executable: Box<TLambda>,
//RS     },
//RS     /// c109 Phase 19: an explicit `region r { … }` (D-REGION1 opt B). Lowers to a plain
//RS     /// Rust block `{ … }` — a lexical scope. The region's escape bound (E0631) and arena
//RS     /// drop ordering (S63 RAII) are enforced entirely in sema; codegen is dumb (I3).
//RS     /// Body bindings live only in the child `LowerEnv` matching that Rust scope.
//RS     Region(Vec<TStmt>),
//RS     /// D-LAYOUT1 / D-LAYOUT-GATES1: `layout NAME { … }` — a Cassowary-style
//RS     /// constraint block. Unlike `Region`/the `task.group` path, this DOES need a
//RS     /// real runtime object: `handle` is the slot the fresh `jet_layout::Handle`
//RS     /// binds into, `label` is the source name (for the
//RS     /// handle's debug/conflict-report label), and `body` is the block's
//RS     /// statements lowered on the SAME env the handle was just bound into (the
//RS     /// parser already desugared every `box.anchor` read to an ordinary
//RS     /// `NAME.h(box, anchor)`/`NAME.v(box, anchor)` method call, so `body` is
//RS     /// nothing but plain statements — no layout-specific TIR shape needed
//RS     /// beyond the handle construction itself).
//RS     Layout {
//RS         handle: TLocal,
//RS         label: String,
//RS         body: Vec<TStmt>,
//RS     },
//RS     /// c109 Phase 19: a `#Context(field: value) { … }` smart-context block (D-CTX1). Lowers
//RS     /// to a plain block with one RAII/no-op guard per field (in declaration order)
//RS     /// BEFORE the body: `allocator`/`deadline` push a dynamic context guard in
//RS     /// `jet_mem`; `logger` stays a v1 no-op value bind. Each `(field_name, value)`
//RS     /// pair is resolved at lowering. The body uses the block's child lexical env.
//RS     ContextBlock {
//RS         guards: Vec<(String, TExpr)>,
//RS         body: Vec<TStmt>,
//RS     },
//RS     /// D-TERM1 (ratified 2026-06-22): `live { … }` — terminal direct-input block.
//RS     /// Lowers to:
//RS     ///   `{ jet_term_enter(); let _live_guard = jet_scope_guard(|| jet_term_leave()); <body> }`
//RS     /// The scope guard guarantees `jet_term_leave()` runs on every exit path — normal
//RS     /// fall-through, early `return`, `?` propagation, and panic unwind. Codegen is dumb
//RS     /// (I3): no decisions here, only emitting the already-checked RAII form.
//RS     Live {
//RS         body: Vec<TStmt>,
//RS     },
//RS     /// D-SHIELDNAME1=A (ratified 2026-07-11): `#Shield { … }` — a cancellation-shield
//RS     /// region. Lowers to:
//RS     ///   `{ jet_scheduler_shield_enter(); let _shield_guard = jet_scope_guard(|| jet_scheduler_shield_leave()); <body> }`
//RS     /// The scope guard guarantees `jet_scheduler_shield_leave()` runs on every exit
//RS     /// path (normal, `return`, `?`, panic unwind) so a deferred cancel/deadline lands
//RS     /// at region exit — deadline first, then cancel (the runtime `_leave` decides the
//RS     /// order). A no-op outside a task (SHIELD_DEPTH is thread-local). Codegen is dumb
//RS     /// (I3): only emits the already-checked RAII form.
//RS     Shield {
//RS         body: Vec<TStmt>,
//RS     },
//RS     /// D-DOTSCOPE1: a `#Test` scope-member region — `.setup` / `.expect_fail` /
//RS     /// `.timeout(dur)` / `.skip`. Emitted only inside a `jet test` harness fn
//RS     /// (`fn jet_test_N() -> Result<(), String>`); see `emit_tir_stmt` for the
//RS     /// per-kind lowering. Whole-test `.skip` (a `.skip` first statement) is
//RS     /// handled by the harness `main`, not here.
//RS     ScopeMember {
//RS         kind: ScopeMemberKind,
//RS         body: Vec<TStmt>,
//RS     },
//RS     /// D-TXN1–D-TXN4 (ratified 2026-06-24): `#Transact(name) { … }` — a transaction
//RS     /// block. Lowers to:
//RS     ///   `{ let mut <handle> = jet_transaction(); <body>; <handle>.commit(); }`
//RS     /// `<handle>.on_commit(() => { … })` inside the body lowers to
//RS     /// `<handle>.on_commit(Box::new(move || { … }))`. The registered hooks run LIFO
//RS     /// in `JetTransaction::drop` — but only if `commit()` ran. A `?`-failure or any
//RS     /// early return skips `commit()`, so the hooks drop un-run (D-TXN3). The
//RS     /// irreversible-effect rejection (E0746, D-TXN2) and rollback are sema's job;
//RS     /// codegen is dumb (I3): effects/transaction state are a compile-time fact.
//RS     Transact {
//RS         /// The transaction handle's slot, or `None` for a bare `#Transact { … }`
//RS         /// with no handle (no `on_commit`/`on_rollback` hooks). When `snapshots` is
//RS         /// non-empty a handle is synthesized even for a bare block, so the
//RS         /// auto-snapshot has a transaction to register on.
//RS         handle: Option<TLocal>,
//RS         /// D-TXN-ROLLBACK layer 1+2: each snapshotted local plus, when the local's
//RS         /// type implements `Rollback`, that type. Without a type the snapshot is
//RS         /// clone-based (`jet_txn::snapshot`); with one it uses
//RS         /// `jet_txn::snapshot_custom` and `<ty>::restore`, so the custom cheap diff
//RS         /// runs instead of a full clone.
//RS         snapshots: Vec<(TLocal, Option<Type>)>,
//RS         /// D-STM1=A (card #506): the compiler-owned mutable STM handle when the
//RS         /// block touches the `Shared<T>` plane. Its presence means emission wraps
//RS         /// the body in `jet_stm::begin()` … `.commit()` — the atomic multi-handle
//RS         /// commit. `None` preserves the plain local-only transaction shape.
//RS         stm: Option<TLocal>,
//RS         body: Vec<TStmt>,
//RS     },
//RS     /// A checked compile-time-only construct retained as an explicit erasure
//RS     /// row so no source form disappears from the total program silently.
//RS     Erased {
//RS         construct: String,
//RS         span: crate::Diagnostics::Span,
//RS         reason: TirErasureReason,
//RS     },
//RS     /// A structurally impossible post-sema shape.  Old adapters surface this
//RS     /// as an ICE; canonical MIR returns a typed lowering error.
//RS     InvariantViolation {
//RS         construct: String,
//RS         span: crate::Diagnostics::Span,
//RS     },
//RS     /// D-DBG3 step 2 (dap-debugger): a source line marker, one per lowered `Stmt`,
//RS     /// inserted ONLY when `cx.debug_linemap` is set (native `jet debug` builds —
//RS     /// never a normal build or the JIT tier, so this is invisible to the JIT
//RS     /// lowering gate and every other TStmt consumer). Emits a `// jet:line N`
//RS     /// comment immediately before the statement's generated Rust, giving the native
//RS     /// backend a rust-line -> jet-line table without touching any other TStmt shape.
//RS     LineMarker(usize),
//RS     /// Source location for the following statement. Evaluators consume it;
//RS     /// code generators discard it.
//RS     SourceSpan(crate::Diagnostics::Span),
//RS }
//RS 
