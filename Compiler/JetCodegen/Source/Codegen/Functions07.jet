//RS /// The access fact available to an optimizer consumer.
//RS #[derive(Clone, Copy, Debug, PartialEq, Eq)]
//RS pub enum TExclusivity {
//RS     /// Sema did not prove an access mode at this subject.
//RS     Unknown,
//RS     /// A shared/read access. It does not authorize mutation or reordering.
//RS     Shared,
//RS     /// A sema-proven exclusive/write access.
//RS     Exclusive,
//RS     /// A sema-proven consuming/move access.
//RS     Move,
//RS }
//RS 
//RS /// Three-state purity fact. `Unknown` is the conservative default.
//RS #[derive(Clone, Copy, Debug, PartialEq, Eq)]
//RS pub enum TPurity {
//RS     Unknown,
//RS     Pure,
//RS     Impure,
//RS }
//RS 
//RS /// One read-only fact channel shared by TIR optimization consumers.
//RS ///
//RS /// This is deliberately a borrowed view over facts already carried by the
//RS /// frozen TIR (`TExpr.ty`/`CtLit`, `TCallArg` access flags, `TStmt` loop proofs,
//RS /// and `TFunc.is_pure`). It has no per-node allocation and no parallel schema.
//RS /// A missing field means sema did not prove that fact; consumers must retain
//RS /// the checked Prelude operation or other conservative dependency.
//RS #[derive(Clone, Copy, Debug)]
//RS pub struct TFactChannel<'a> {
//RS     pub ty: Option<&'a Type>,
//RS     pub integer_bounds: Option<TIntegerBounds>,
//RS     pub exclusivity: TExclusivity,
//RS     pub purity: TPurity,
//RS     /// Sema's loop-level proof that one iteration cannot observe another's
//RS     /// writes. Unknown stays false so vectorizers never infer independence.
//RS     pub no_cross_iteration_deps: bool,
//RS     pub comptime_value: Option<&'a crate::AST::CtValue>,
//RS     /// Typed cost evidence. `SemanticRemainder` is a real cost; `OptimizerRemoved`
//RS     /// is a proof that the same operation remains semantically available but
//RS     /// its dynamic fallback is unreachable for the carried bounds.
//RS     pub cost: Option<TCostFact>,
//RS }
//RS 
