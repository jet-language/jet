// Rust: crates/jet-codegen/src/Codegen/TIR/mod.rs:8585
INT_SMALL_MIN :: -(I128{1} << 62)
// Rust: crates/jet-codegen/src/Codegen/TIR/mod.rs:8586
INT_SMALL_MAX :: (I128{1} << 62) - 1
// Rust: crates/jet-codegen/src/Codegen/TIR/mod.rs:8588
pub fn bounds_fit_inline(bounds: TIntegerBounds) -> Bool Never! { bounds.lo >= Int{INT_SMALL_MIN} && bounds.hi <= Int{INT_SMALL_MAX} }
// Rust: crates/jet-codegen/src/Codegen/TIR/mod.rs:8592
pub fn combine_integer_bounds(op: TBinaryOp, lhs: TIntegerBounds, rhs: TIntegerBounds) -> TIntegerBounds? Never! {
    candidates: [I128#4] :: if op == {
        .Add -> [I128#4]{I128{lhs.lo}.checked_add(I128{rhs.lo}) ?? return None, I128{lhs.hi}.checked_add(I128{rhs.hi}) ?? return None, 0, 0}
        .Sub -> [I128#4]{I128{lhs.lo}.checked_sub(I128{rhs.hi}) ?? return None, I128{lhs.hi}.checked_sub(I128{rhs.lo}) ?? return None, 0, 0}
        .Mul -> [I128#4]{I128{lhs.lo}.checked_mul(I128{rhs.lo}) ?? return None, I128{lhs.lo}.checked_mul(I128{rhs.hi}) ?? return None, I128{lhs.hi}.checked_mul(I128{rhs.lo}) ?? return None, I128{lhs.hi}.checked_mul(I128{rhs.hi}) ?? return None}
        else -> return None
    }
    lo := candidates[0]
    hi := candidates[0]
    loop i in 1..<4 { lo = min(lo, candidates[i]); hi = max(hi, candidates[i]) }
    Val(TIntegerBounds{lo: Int{lo}, hi: Int{hi}})
}
