//RS /// A fully typed expression. The resolved type is carried on every node,
//RS /// so codegen never recomputes it.
//RS #[derive(Clone)]
//RS pub struct TExpr {
//RS     pub ty: Type,
//RS     pub kind: TExprKind,
//RS }
//RS 
//RS /// The semantic operation whose cost can remain after optimization.  These
//RS /// categories are deliberately small and typed: reporting must consume the
//RS /// same fact that lowering gave to every backend, not infer a cost from Rust
//RS /// text.
//RS #[derive(Clone, Copy, Debug, PartialEq, Eq)]
//RS pub enum TCostKind {
//RS     /// A read-only view crossed an owning boundary and must be copied.
//RS     ViewMaterialization,
//RS     /// A shared map backing store needs `Arc::make_mut` before an edit.
//RS     CollectionCopyOnWrite,
//RS     /// An exact `Int` operation may leave the packed signed-63-bit rail.
//RS     ExactIntSpill,
//RS     /// A `Result`/`Option` carrier is constructed at a call or explicit
//RS     /// constructor site.
//RS     OutcomeConstruction,
//RS     /// A generic collection representation remains because no shape proof
//RS     /// selected the direct representation.
//RS     RepresentationFallback,
//RS }
//RS 
//RS impl TCostKind {
//RS     pub const fn label(self) -> &'static str {
//RS         match self {
//RS             Self::ViewMaterialization => "view materialization",
//RS             Self::CollectionCopyOnWrite => "map copy-on-write",
//RS             Self::ExactIntSpill => "exact Int spill",
//RS             Self::OutcomeConstruction => "outcome construction",
//RS             Self::RepresentationFallback => "generic representation fallback",
//RS         }
//RS     }
//RS 
//RS     pub const fn operation(self) -> &'static str {
//RS         match self {
//RS             Self::ViewMaterialization => "materializing a read-only view",
//RS             Self::CollectionCopyOnWrite => "editing a shared map backing store",
//RS             Self::ExactIntSpill => "an exact Int operation may spill to bigint",
//RS             Self::OutcomeConstruction => "constructing an Outcome carrier",
//RS             Self::RepresentationFallback => "using a generic collection representation",
//RS         }
//RS     }
//RS 
//RS     pub const fn fix(self) -> &'static str {
//RS         match self {
//RS             Self::ViewMaterialization => {
//RS                 "keep the value in its view form, or make the copy explicit outside the loop"
//RS             }
//RS             Self::CollectionCopyOnWrite => {
//RS                 "mutate an exclusive map place, or move the edit outside the loop"
//RS             }
//RS             Self::ExactIntSpill => {
//RS                 "bound the operands so the result stays on the packed Int rail, or accept exact bigint cost"
//RS             }
//RS             Self::OutcomeConstruction => {
//RS                 "consume the outcome through an immediate fast path when one exists"
//RS             }
//RS             Self::RepresentationFallback => {
//RS                 "provide the collection shape proof that selects the direct representation"
//RS             }
//RS         }
//RS     }
//RS }
