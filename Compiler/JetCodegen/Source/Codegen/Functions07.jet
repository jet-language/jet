//RS     pub carrier_ty: Type,
//RS     /// Type sema assigned to the source-level `result` binding.
//RS     pub binding_ty: Type,
//RS     /// Local holding the complete return carrier.
//RS     pub carrier_local: TLocal,
//RS     /// Local visible to lowered postconditions.
//RS     pub binding_local: TLocal,
//RS     /// Whether the successful carrier arm is projected before postconditions.
//RS     pub mode: TContractResultMode,
//RS }
