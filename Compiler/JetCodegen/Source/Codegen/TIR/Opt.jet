        }
        .ColumnarGather(base: base, index: index, ..) | .ColumnarColumnRead(base: base, index: index, ..)
        | .Index(base: base, index: index, ..) | .IndexHook(base: base, index: index, ..)
        | .MathLaneIndex(base: base, index: index, ..) -> { canonicalize_expr(base); canonicalize_expr(index) }
        .PoolSlot(pool: pool, id: id, ..) -> { canonicalize_expr(pool); canonicalize_expr(id) }
        .Slice(base: base, start: start, end: end, range: range, ..) -> {
            canonicalize_expr(base); canonicalize_expr(start); canonicalize_expr(end)
            if range == { Val(range) -> canonicalize_expr(range); else -> {} }
        }
        .TupleLit(fields: fields, ..) -> { for (_, value) in &fields { canonicalize_expr(value) } }
        .MapLit(fields) -> { for (left, right) in &fields { canonicalize_expr(left); canonicalize_expr(right) } }
        .StrLit(parts) -> {
