//RS /// Run the checked TIR normalization pass.
//RS ///
//RS /// Loop canonicalization happens before lowering. `#Inline(Always)` expansion
//RS /// happens only in the canonical MIR optimizer so all execution adapters share
//RS /// the same control-flow and cleanup semantics.
//RS pub(crate) fn optimize_program(program: &mut TirProgram) {
//RS     canonicalize_loop_forms(program);
//RS }
