use JetCodegen.Codegen.TIR.*
use JetSema.AST.[Type, BinOp, UnOp, AutoVectorizationFacts, int_range]
use JetFoundation.CanonicalPass
use std.sync.Arc // GATE #4494: shared allocation identity and unique mutable access.
use std.mem

// Rust: crates/jet-codegen/src/Codegen/TIR/opt.rs:16
// Normalize only proven equivalent loop forms after checked TIR is complete.
pub fn canonicalize_loop_forms(program: &TirProgram) {
    before := canonical_payload(program)
    before_identity := canonical_identity(program)
    shared_slots: [SharedSlot] := []
    for function in &program.funcs {
        visit_shared_slots(&function.body, fn(body: &Arc<[TStmt]>) {
            shared := mem.replace(body, empty_shared_body())
            shared_slots.push(SharedSlot(body: ^shared))
        })
    }
    for spawn in &program.spawn_lambdas {
        if &spawn.body == { .SharedBlock(body, ..) -> {
            shared := mem.replace(body, empty_shared_body())
            shared_slots.push(SharedSlot(body: ^shared))
        }; else -> {} }
    }
    canonicalize_shared_slots(&shared_slots)
    cursor := 0
    for function in &program.funcs {
        visit_shared_slots(&function.body, fn(body: &Arc<[TStmt]>) {
            body.* = Arc.clone(shared_slots[cursor].body)
            cursor += 1
        })
    }
    for spawn in &program.spawn_lambdas {
        if &spawn.body == { .SharedBlock(body, ..) -> {
            body.* = Arc.clone(shared_slots[cursor].body)
            cursor += 1
        }; else -> {} }
    }
    debug_assert(cursor == shared_slots.len())
    for function in &program.funcs { canonicalize_stmts(&function.body) }
    CanonicalPass.record("lowering", "tir.canonicalize-loop-forms",
        "crates/jet-codegen/src/Codegen/TIR/opt.rs", "tir", ^before,
        ^before_identity, "tir", canonical_payload(program),
        canonical_identity(program), "preserve")
}

// Rust: crates/jet-codegen/src/Codegen/TIR/opt.rs:69
// Inline expansion belongs exclusively to the canonical MIR optimizer.
pub fn optimize_program(program: &TirProgram) { canonicalize_loop_forms(program) }

// Rust: crates/jet-codegen/src/Codegen/TIR/opt.rs:73
struct SharedSlot { body: Arc<[TStmt]> }

// Rust: crates/jet-codegen/src/Codegen/TIR/opt.rs:77
fn empty_shared_body() -> Arc<[TStmt]> { Arc.from([] as [TStmt]) }

// Rust: crates/jet-codegen/src/Codegen/TIR/opt.rs:81
fn visit_shared_slots(stmts: &[TStmt], visit: &fn(&Arc<[TStmt]>)) {
    for stmt in &stmts {
        if &stmt == {
            .Reactive(executable) -> {
                if &executable.executable == { .SharedBlock(body) -> visit(body); else -> {} }
            }
            .ContractScope(body: body, ..) | .TaskGroup(body: body, ..)
            | .Loop(body: body, ..) | .While(body: body, ..)
            | .Inline(body) | .DebugOnly(body) | .Unsafe(body: body, ..)
            | .SentryPolicy(body: body, ..) | .Impure(body) | .Region(body)
            | .Layout(body: body, ..) | .ContextBlock(body: body, ..)
            | .Live(body) | .Shield(body) | .ScopeMember(body: body, ..)
            | .Transact(body: body, ..) -> visit_shared_slots(body, visit)
            .RefutableBind(fallback: fallback, ..) -> visit_shared_slots(fallback, visit)
            .GcEdit(stmt: child, ..) -> visit_shared_slots(std.slice.from_mut(child), visit)
            .CountedLoop(init: init, step: step, body: body, ..) -> {
                visit_shared_slots(std.slice.from_mut(init), visit)
                if step == { Val(step) -> visit_shared_slots(std.slice.from_mut(step), visit); else -> {} }
                visit_shared_slots(body, visit)
            }
            .Range(body: body, ..) | .ForIn(body: body, ..) -> visit_shared_slots(body, visit)
            .If(then_body: then_body, else_body: else_body, ..) -> {
                visit_shared_slots(then_body, visit)
                if else_body == { Val(body) -> visit_shared_slots(body, visit); else -> {} }
            }
            .EnumMatch(arms: arms, else_body: else_body, ..) -> {
                for arm in &arms { visit_shared_slots(&arm.body, visit) }
                if else_body == { Val(body) -> visit_shared_slots(body, visit); else -> {} }
            }
            .RangeSwitch(arms: arms, else_body: else_body, ..) -> {
                for (_, _, body) in &arms { visit_shared_slots(body, visit) }
                visit_shared_slots(else_body, visit)
            }
            .MixedSwitch(arms: arms, else_body: else_body, ..) -> {
                for (_, body) in &arms { visit_shared_slots(body, visit) }
                if else_body == { Val(body) -> visit_shared_slots(body, visit); else -> {} }
            }
            else -> {}
        }
    }
}

// Rust: crates/jet-codegen/src/Codegen/TIR/opt.rs:164
fn canonicalize_shared_slots(slots: &[SharedSlot]) {
    groups: [[USize]] := []
    for (index, slot) in slots.iter().enumerate() {
        group := groups.iter_mut().find(fn(group) { Arc.ptr_eq(slots[group[0]].body, slot.body) })
        if group == { Val(group) -> group.push(index); None -> groups.push([index]) }
    }
    for group in groups {
        first := group[0]
        shared := mem.replace(&slots[first].body, empty_shared_body())
        for index in group.iter().skip(1) {
            duplicate := mem.replace(&slots[index].body, empty_shared_body())
            drop(^duplicate)
        }
        if Arc.get_mut(&shared) == { Val(body) -> canonicalize_fixed_stmts(body); else -> {} }
        slots[first].body = ^shared
        shared = Arc.clone(slots[first].body)
        for index in group.iter().skip(1) { slots[index].body = Arc.clone(shared) }
    }
}

// Rust: crates/jet-codegen/src/Codegen/TIR/opt.rs:194
fn counted_loop(label: String?, var: String, start: TExpr, end: TExpr,
    step: TExpr?, exclusive: Bool, auto_vectorization: AutoVectorizationFacts?, body: [TStmt]) -> TStmt {
    lhs := TExpr(ty: Type.Int, kind: .Local(TLocal.user(var.clone())))
    step_expr := step.unwrap_or_else(fn() { TExpr(ty: Type.Int, kind: .IntLit(1, None)) })
    cond := TExpr(ty: Type.Bool, kind: .Binary(
        op: if exclusive { BinOp.Lt } else { BinOp.Le }, overflow: false,
        line: 0, lhs: ^lhs, rhs: ^end))
    TStmt.CountedLoop(label: ^label,
        init: .Let(name: var.clone(), kw: "let mut", let_ty: .Inferred,
            init: ^start, gc_promotion: None, gc_transferred: false),
        cond: ^cond,
        step: Val(TStmt.Assign(place: .Local(TLocal.user(^var).as_mutable()),
            op: Val(BinOp.Add), value: ^step_expr, clone_value: false, line: 0)),
        auto_vectorization: ^auto_vectorization, body: ^body)
}

// Rust: crates/jet-codegen/src/Codegen/TIR/opt.rs:248
fn canonicalize_fixed_stmts(stmts: &[TStmt]) {
    for stmt in &stmts {
        canonicalize_stmt_children(stmt)
        current := mem.replace(stmt, TStmt.Inline([]))
        stmt.* = if ^current == {
            .While(label, cond, body) -> if cond.kind == {
                .BoolLit(true) -> TStmt.Loop(label: ^label, body: ^body)
                .BoolLit(false) -> TStmt.Inline([])
                else -> {
                    if invariant_bool_condition(cond) {
                        TStmt.If(cond: .Plain(^cond), then_body: [TStmt.Loop(label: ^label, body: ^body)],
                            else_body: None, else_is_elseif: false)
                    } else { TStmt.While(label: ^label, cond: ^cond, body: ^body) }
                }
            }
            .Range(label, var, source, start, end, step, exclusive, auto_vectorization, body) -> {
                if integer_range_step(source, start, end, step).is_some() {
                    counted_loop(^label, ^var, ^start, ^end, ^step, exclusive, ^auto_vectorization, ^body)
                } else { TStmt.Range(label: ^label, var: ^var, source: ^source, start: ^start,
                    end: ^end, step: ^step, exclusive: exclusive, auto_vectorization: ^auto_vectorization, body: ^body) }
            }
            other -> ^other
        }
    }
}

// Rust: crates/jet-codegen/src/Codegen/TIR/opt.rs:301
fn canonicalize_stmts(stmts: &[TStmt]) {
    index := 0
    while index < stmts.len() {
        canonicalize_stmt_children(&stmts[index])
        current := mem.replace(&stmts[index], TStmt.Inline([]))
        replacement := if ^current == {
            .While(label, cond, body) -> if cond.kind == {
                .BoolLit(true) -> Val(TStmt.Loop(label: ^label, body: ^body))
                .BoolLit(false) -> None
                else -> {
                    if invariant_bool_condition(cond) {
                        Val(TStmt.If(cond: .Plain(^cond), then_body: [TStmt.Loop(label: ^label, body: ^body)],
                            else_body: None, else_is_elseif: false))
                    } else { Val(TStmt.While(label: ^label, cond: ^cond, body: ^body)) }
                }
            }
            .Range(label, var, source, start, end, step, exclusive, auto_vectorization, body) -> {
                canonical_step := integer_range_step(source, start, end, step)
                if canonical_step == {
                    Val(_) -> {
                        lhs := TExpr(ty: Type.Int, kind: .Local(TLocal.user(var.clone())))
                        step_expr := step.unwrap_or_else(fn() { TExpr(ty: Type.Int, kind: .IntLit(1, None)) })
                        cond := TExpr(ty: Type.Bool, kind: .Binary(
                            op: if exclusive { BinOp.Lt } else { BinOp.Le }, overflow: false,
                            line: 0, lhs: ^lhs, rhs: ^end))
                        counted_step := TStmt.Assign(place: .Local(TLocal.user(var.clone()).as_mutable()),
                            op: Val(BinOp.Add), value: ^step_expr, clone_value: false, line: 0)
                        Val(TStmt.CountedLoop(label: ^label,
                            init: .Let(name: ^var, kw: "let mut", let_ty: .Inferred, init: ^start,
                                gc_promotion: None, gc_transferred: false),
                            cond: ^cond, step: Val(^counted_step), auto_vectorization: ^auto_vectorization, body: ^body))
                    }
                    None -> Val(TStmt.Range(label: ^label, var: ^var, source: ^source, start: ^start,
                        end: ^end, step: ^step, exclusive: exclusive, auto_vectorization: ^auto_vectorization, body: ^body))
                }
            }
            other -> Val(^other)
        }
        if replacement == {
            Val(replacement) -> { stmts[index] = ^replacement; index += 1 }
            None -> {
                // SourceSpan is a separate preceding node and remains intact.
                _ :: stmts.remove(index)
            }
        }
    }
}

// Rust: crates/jet-codegen/src/Codegen/TIR/opt.rs:402
fn invariant_bool_condition(cond: TExpr) -> Bool {
    if cond.kind == {
        .Local(local) -> cond.ty.without_user_tags() == Type.Bool
            && !local.mutable && !local.deref && !local.is_persistent()
        else -> false
    }
}

// Rust: crates/jet-codegen/src/Codegen/TIR/opt.rs:412
fn integer_range_step(source: TExpr?, start: TExpr, end: TExpr, step: TExpr?) -> I64? {
    if source.is_some() -> return None
    _ :: integer_literal(start) ?? return None
    end_value := integer_literal(end) ?? return None
    step_value := if step == {
        Val(step) -> integer_literal(step).filter(fn(value) { value > 0 }) ?? return None
        None -> 1
    }
    // The range cursor stops on overflow; counted assignment must not trap instead.
    _ :: end_value.checked_add(step_value) ?? return None
    Val(step_value)
}

// Rust: crates/jet-codegen/src/Codegen/TIR/opt.rs:433
fn integer_literal(expr: TExpr) -> I64? {
    if expr.ty.without_user_tags() != Type.Int -> return None
    if expr.kind == { .IntLit(value, _) -> Val(value); else -> None }
}

// Rust: crates/jet-codegen/src/Codegen/TIR/opt.rs:443
fn canonicalize_stmt_children(stmt: &TStmt) {
    if &stmt == {
        .Contract(contract) -> {
            canonicalize_expr(&contract.condition)
            canonicalize_expr(&contract.message)
        }
        .ContractScope(pre: pre, body: body, post: post, ..) -> {
            for contract in pre.iter_mut().chain(post.iter_mut()) {
                canonicalize_expr(&contract.condition)
                canonicalize_expr(&contract.message)
            }
            canonicalize_stmts(body)
        }
        .Let(init: init, ..) -> canonicalize_expr(init)
        .RefutableBind(init: init, fallback: fallback, ..) -> {
            canonicalize_expr(init); canonicalize_stmts(fallback)
        }
        .GcEdit(index_temp: index_temp, stmt: child, ..) -> {
            if index_temp == { Val((_, index)) -> canonicalize_expr(index); else -> {} }
            canonicalize_stmt_children(child)
        }
        .SplitViews(owner: owner, ..) -> { if owner == { Val(owner) -> canonicalize_expr(owner); else -> {} } }
        .TupleDestructure(init: init, ..) | .StructDestructure(init: init, ..)
        | .ListDestructure(init: init, ..) -> canonicalize_expr(init)
        .Assign(place: place, value: value, ..) -> {
            if place == { .Expr(place) -> canonicalize_expr(place); else -> {} }
            canonicalize_expr(value)
        }
        .Return(value) -> { if value == { Val(value) -> canonicalize_expr(value); else -> {} } }
        .ExprStmt(value) | .BreakValue(value: value, ..) -> canonicalize_expr(value)
        .TaskGroup(limit: limit, body: body, ..) -> {
            if limit == { Val(limit) -> canonicalize_expr(limit); else -> {} }
            canonicalize_stmts(body)
        }
        .DeferClose(close: close, ..) -> canonicalize_expr(close)
        .If(cond: cond, then_body: then_body, else_body: else_body, ..) -> {
            canonicalize_cond(cond)
            canonicalize_stmts(then_body)
            if else_body == { Val(body) -> canonicalize_stmts(body); else -> {} }
        }
        .Loop(body: body, ..) | .Inline(body) | .DebugOnly(body)
        | .Unsafe(body: body, ..) | .SentryPolicy(body: body, ..)
        | .Impure(body) | .Region(body) | .Live(body) | .Shield(body)
        | .ScopeMember(body: body, ..) | .Layout(body: body, ..) -> canonicalize_stmts(body)
        .While(cond: cond, body: body, ..) -> { canonicalize_expr(cond); canonicalize_stmts(body) }
        .ContextBlock(guards, body) -> {
            for (_, guard) in &guards { canonicalize_expr(guard) }
            canonicalize_stmts(body)
        }
        .CountedLoop(init: init, cond: cond, step: step, body: body, ..) -> {
            canonicalize_stmt_children(init)
            canonicalize_expr(cond)
            if step == { Val(step) -> canonicalize_stmt_children(step); else -> {} }
            canonicalize_stmts(body)
        }
        .Range(source: source, start: start, end: end, step: step, body: body, ..) -> {
            if source == { Val(source) -> canonicalize_expr(source); else -> {} }
            canonicalize_expr(start); canonicalize_expr(end)
            if step == { Val(step) -> canonicalize_expr(step); else -> {} }
            canonicalize_stmts(body)
        }
        .EnumMatch(subj: subj, arms: arms, else_body: else_body, ..) -> {
            canonicalize_expr(subj)
            for arm in &arms { canonicalize_stmts(&arm.body) }
            if else_body == { Val(body) -> canonicalize_stmts(body); else -> {} }
        }
        .RangeSwitch(subject, arms, else_body) -> {
            canonicalize_expr(subject)
            for (_, _, body) in &arms { canonicalize_stmts(body) }
            canonicalize_stmts(else_body)
        }
        .IndexAssign(base: base, index: index, value: value, ..)
        | .IndexHookAssign(base: base, index: index, value: value, ..) -> {
            canonicalize_expr(base); canonicalize_expr(index); canonicalize_expr(value)
        }
        .IndexFieldAssign(assign) -> {
            canonicalize_expr(&assign.base); canonicalize_expr(&assign.index); canonicalize_expr(&assign.value)
        }
        .MathSwizzleAssign(base: base, value: value, ..) -> { canonicalize_expr(base); canonicalize_expr(value) }
        .ForIn(source: source, collection: collection, step: step, body: body, ..) -> {
            canonicalize_expr(source); canonicalize_expr(collection)
            if step == { Val(step) -> canonicalize_expr(step); else -> {} }
            canonicalize_stmts(body)
        }
        .MixedSwitch(subject: subject, arms: arms, else_body: else_body, ..) -> {
            canonicalize_expr(subject)
            for (condition, body) in &arms { canonicalize_expr(condition); canonicalize_stmts(body) }
            if else_body == { Val(body) -> canonicalize_stmts(body); else -> {} }
        }
        .Reactive(executable) -> canonicalize_lambda(executable)
        .Transact(body: body, ..) -> canonicalize_stmts(body)
        else -> {}
    }
}

// Rust: crates/jet-codegen/src/Codegen/TIR/opt.rs:646
fn canonicalize_cond(cond: &TIfCond) {
    if &cond == {
        .Plain(expr) | .IfLet(subj: expr, ..) | .IsNone(expr)
        | .Matches(subj: expr, ..) -> canonicalize_expr(expr)
        .And(left, right) -> { canonicalize_cond(left); canonicalize_cond(right) }
        .WithPrelude(prelude, cond) -> { canonicalize_stmts(prelude); canonicalize_cond(cond) }
    }
}

// Rust: crates/jet-codegen/src/Codegen/TIR/opt.rs:663
fn canonicalize_lambda(lambda: &TLambda) {
    if &lambda.executable == {
        .Expr(expr) -> canonicalize_expr(expr)
        .Block(body) -> canonicalize_stmts(body)
        .SharedBlock(body) -> {
            if Arc.get_mut(body) == { Val(body) -> canonicalize_fixed_stmts(body); else -> {} }
        }
    }
}

// Rust: crates/jet-codegen/src/Codegen/TIR/opt.rs:675
fn canonicalize_core_closure(kind: &TCoreClosureKind) {
    if &kind == {
        .Spawn(group: group, executable: executable, ..) -> {
            if group == { Val(group) -> canonicalize_expr(group); else -> {} }
            canonicalize_lambda(executable)
        }
        .Realtime(rate, frames, executable) -> {
            canonicalize_expr(rate); canonicalize_expr(frames); canonicalize_lambda(executable)
        }
        .Serve(addr, executable) -> { canonicalize_expr(addr); canonicalize_lambda(executable) }
        .OnInterrupt(callback) -> canonicalize_expr(callback)
        .Guard(executable) | .OnCommit(executable: executable, ..)
        | .OnRollback(executable: executable, ..) | .ReactiveDerived(executable: executable, ..)
        | .ReactiveEffect(executable: executable, ..) | .UiReactiveRender(executable: executable, ..) -> canonicalize_lambda(executable)
        .UiPreview(name: name, viewport: viewport, executable: executable, ..) -> {
            canonicalize_expr(name)
            if viewport == { Val(viewport) -> canonicalize_expr(viewport); else -> {} }
            canonicalize_lambda(executable)
        }
        .UiButtonOnClick(label: label, shortcut: shortcut, accessible_label: accessible_label, executable: executable, ..) -> {
            canonicalize_expr(label); canonicalize_expr(shortcut)
            canonicalize_expr(accessible_label); canonicalize_lambda(executable)
        }
        .UiTextInputOnDrop(state: state, ime: ime, executable: executable, ..) -> {
            canonicalize_expr(state); canonicalize_expr(ime); canonicalize_lambda(executable)
        }
    }
}

// Rust: crates/jet-codegen/src/Codegen/TIR/opt.rs:742
fn canonicalize_fn_value(kind: &TFnValueKind) {
    if &kind == {
        .NamedFn(lambda: lambda, ..) -> { if lambda == { Val(lambda) -> canonicalize_lambda(lambda); else -> {} } }
        .Policy(policy_args: policy_args, callee: callee, ..) -> {
            for arg in &policy_args { canonicalize_expr(&arg.value) }
            canonicalize_expr(callee)
        }
        .Call(callee, args) -> {
            canonicalize_expr(callee)
            for arg in &args { canonicalize_expr(&arg.value) }
        }
        .Send(value) -> canonicalize_expr(value)
    }
}

// Rust: crates/jet-codegen/src/Codegen/TIR/opt.rs:769
fn canonicalize_expr(expr: &TExpr) {
    if &expr.kind == {
        .InlineBlock(body) -> canonicalize_stmts(body)
        .IfExpr(cond, then_body, then_value, else_body, else_value) -> {
            canonicalize_cond(cond); canonicalize_stmts(then_body); canonicalize_expr(then_value)
            canonicalize_stmts(else_body); canonicalize_expr(else_value)
        }
        .ResultHandler(subject: subject, ok_body: ok_body, ok_value: ok_value,
            err_body: err_body, err_value: err_value, terminal: terminal, ..) -> {
            canonicalize_expr(subject); canonicalize_stmts(ok_body); canonicalize_expr(ok_value)
            canonicalize_stmts(err_body); canonicalize_expr(err_value); canonicalize_expr(terminal)
        }
        .Lambda(lambda) -> canonicalize_lambda(lambda)
        .CoreClosureCall(kind) -> canonicalize_core_closure(kind)
        .FnValue(kind) -> canonicalize_fn_value(kind)
        .Call(args: args, ..) | .StaticCall(args: args, ..)
        | .ModuleCall(args: args, ..) | .ExternCall(args: args, ..) -> {
            for arg in &args { canonicalize_expr(&arg.value) }
        }
        .MethodCall(recv: recv, args: args, ..) -> {
            canonicalize_expr(recv)
            for arg in &args { canonicalize_expr(&arg.value) }
        }
        .BuiltinMethod(args: args, ..) | .HandleMethod(args: args, ..)
        | .ClosureMethod(args: args, ..) | .MathBuiltin(args: args, ..)
        | .PreciseBuiltin(args: args, ..) | .CoreCall(args: args, ..) -> {
            for arg in &args { canonicalize_expr(arg) }
        }
        .OrFallback(value, fallback) -> {
            canonicalize_expr(value)
            if fallback == {
                .Value(value) | .Return(Val(value)) -> canonicalize_expr(value)
                .Panic(msg: msg, ..) -> canonicalize_expr(msg)
                else -> {}
            }
        }
        .Try(inner: inner, note: note, ..) -> {
            canonicalize_expr(inner)
            if note == { Val(note) -> canonicalize_expr(note); else -> {} }
        }
        .Binary(lhs: lhs, rhs: rhs, ..) | .LayoutCompare(lhs: lhs, rhs: rhs, ..)
        | .OverflowOpt(lhs: lhs, rhs: rhs, ..) | .NumericBinaryMethod(recv: lhs, arg: rhs, ..) -> {
            canonicalize_expr(lhs); canonicalize_expr(rhs)
        }
        .Borrow(place: place, ..) -> canonicalize_expr(place)
        .Unary(operand: operand, ..) | .LayoutLit(operand)
        | .DistinctCtor(arg: operand, ..) | .RangeCheckedCtor(arg: operand, ..)
        | .DistinctConvert(arg: operand, ..) | .Print(operand) | .Drop(operand)
        | .Close(operand) | .ResourceNew(operand) | .Move(operand) | .Deref(operand)
        | .RawOf(operand) | .Clone(operand, _) | .ExplicitCopy(operand)
        | .MaterializeView(operand) | .DistinctRaw(operand) | .Present(operand)
        | .Ok(operand) | .Err(operand, _) | .OptField(base: operand, ..)
        | .PatternMatches(subj: operand, ..) | .NumericMethod(recv: operand, ..)
        | .TaskGroupAll(operand) | .TaskGroupRace(operand) | .TaskGroupAny(operand)
        | .HostBorrowCallback(callable: operand, ..) -> canonicalize_expr(operand)
        .SelectRecv(builder, channel) -> { canonicalize_expr(builder); canonicalize_expr(channel) }
        .SelectAfter(builder, duration, value) -> {
            canonicalize_expr(builder); canonicalize_expr(duration)
            if value == { Val(value) -> canonicalize_expr(value); else -> {} }
        }
        .SelectWait(builder: builder, ..) -> canonicalize_expr(builder)
        .AmbientInput(prompt) -> { if prompt == { Val(prompt) -> canonicalize_expr(prompt); else -> {} } }
        .OptionLift2(f, a, b) -> { canonicalize_expr(f); canonicalize_expr(a); canonicalize_expr(b) }
        .RequireStop(kind: kind, ..) -> if kind == {
            .Require(cond, msg) -> {
                canonicalize_expr(cond)
                if msg == { Val(msg) -> canonicalize_expr(msg); else -> {} }
            }
            .RequireEq(left, right) -> { canonicalize_expr(left); canonicalize_expr(right) }
            .Panic(msg) -> canonicalize_expr(msg)
        }
        .CompareChain(operands: operands, ..) -> { for operand in &operands { canonicalize_expr(operand) } }
        .UnitConvert(arg: arg, rounding: rounding, ..) -> {
            canonicalize_expr(arg)
