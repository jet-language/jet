        .EnumLit(payload: payload, ..) -> if payload == {
            .Unit -> {}
            .Positional(args) -> { for arg in &args { canonicalize_expr(&arg.value) } }
            .Named(args) -> { for (_, arg) in &args { canonicalize_expr(&arg.value) } }
        }
        .StructLit(fields: fields, ..) -> { for (_, value, _) in &fields { canonicalize_expr(value) } }
        .Field(recv: recv, ..) | .SharedGuardValue(guard: recv, ..)
        | .SharedGuardMap(guard: recv, ..) | .SharedGuardSplit(guard: recv, ..)
        | .MathSwizzleRead(recv: recv, ..) -> canonicalize_expr(recv)
        .SharedGuardWait(guard, condition, predicate) -> {
            canonicalize_expr(guard); canonicalize_expr(condition); canonicalize_lambda(predicate)
        }
        .ConditionNotify(condition: condition, ..) -> canonicalize_expr(condition)
        .PtrFromAddr(addr: addr, ..) -> canonicalize_expr(addr)
        .ListLit(values) | .ColumnarListLit(elems: values, ..) -> {
            for value in &values { canonicalize_expr(value) }
        }
        .ListSpread(parts) -> {
            for part in &parts {
                if part == { .Elem(value) | .Spread(value) -> canonicalize_expr(value) }
