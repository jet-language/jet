// Rust: crates/jet-codegen/src/Codegen/TIR/opt.rs:1033
fn fold_expr(expr: &TExpr) {
    folded := if expr.kind == {
        .Unary(op, operand) -> fold_unary(expr, op, operand)
        .Binary(op: op, lhs: lhs, rhs: rhs, ..) -> fold_binary(expr, op, lhs, rhs)
        else -> None
    }
    if ^folded == { Val(replacement) -> expr.* = ^replacement; else -> {} }
}

// Rust: crates/jet-codegen/src/Codegen/TIR/opt.rs:1044
fn fold_unary(expr: TExpr, op: UnOp, operand: TExpr) -> TExpr? {
    if op == {
        .Not -> if operand.kind == {
            .BoolLit(value) -> {
                if expr.ty.without_user_tags() == Type.Bool {
                    Val(TExpr(ty: expr.ty.clone(), kind: .BoolLit(!value)))
                } else { None }
            }
            else -> None
        }
        .Neg -> {
            value := integer_literal_value(operand) ?? return None
            value = value.checked_neg() ?? return None
            if !fits_integer_type(expr.ty, value) -> return None
            Val(integer_expr(expr.ty.clone(), value))
        }
    }
}

// Rust: crates/jet-codegen/src/Codegen/TIR/opt.rs:1066
fn fold_binary(expr: TExpr, op: BinOp, lhs: TExpr, rhs: TExpr) -> TExpr? {
    if (lhs.kind, rhs.kind) == {
        (.BoolLit(left), .BoolLit(right)) -> {
            value := if op == {
                .And -> Val(left && right)
                .Or -> Val(left || right)
                .Eq -> Val(left == right)
                .Ne -> Val(left != right)
                else -> None
            }
            if value == { Val(value) -> return Val(TExpr(ty: expr.ty.clone(), kind: .BoolLit(value))); else -> {} }
        }
        (.CharLit(left), .CharLit(right)) -> {
            value := if op == {
                .Eq -> Val(left == right)
                .Ne -> Val(left != right)
                .Lt -> Val(left < right)
                .Gt -> Val(left > right)
                .Le -> Val(left <= right)
                .Ge -> Val(left >= right)
                else -> None
            }
            if value == { Val(value) -> return Val(TExpr(ty: expr.ty.clone(), kind: .BoolLit(value))); else -> {} }
        }
        else -> {}
    }
    left := integer_literal_value(lhs) ?? return None
    right := integer_literal_value(rhs) ?? return None
    value := fold_integer_binary(op, left, right) ?? return None
    if op == {
        .Eq | .Ne | .Lt | .Gt | .Le | .Ge -> Val(TExpr(ty: expr.ty.clone(), kind: .BoolLit(value != 0)))
        else -> {
            if expr.ty.without_user_tags().is_integer() && fits_integer_type(expr.ty, value) {
                Val(integer_expr(expr.ty.clone(), value))
            } else { None }
        }
    }
}

// Rust: crates/jet-codegen/src/Codegen/TIR/opt.rs:1136
fn integer_literal_value(expr: TExpr) -> I64? {
    if !expr.ty.without_user_tags().is_integer() -> return None
    if expr.kind == { .IntLit(value, _) -> Val(value); else -> None }
}

// Rust: crates/jet-codegen/src/Codegen/TIR/opt.rs:1144
fn integer_expr(ty: Type, value: I64) -> TExpr {
    width := if ty.without_user_tags() == { .IntN(signed, bits) -> Val((signed, bits)); else -> None }
    TExpr(ty: ^ty, kind: .IntLit(value, width))
}

// Rust: crates/jet-codegen/src/Codegen/TIR/opt.rs:1155
fn fits_integer_type(ty: Type, value: I64) -> Bool {
    if ty.without_user_tags() == {
        .Int -> true
        .IntN(signed, bits) -> {
            (lo, hi) := int_range(signed, bits)
            lo <= (value as I128) && (value as I128) <= hi
        }
        .InlineRange(lo: lo, hi: hi, ..) -> lo <= value && value <= hi
        else -> false
    }
}

// Rust: crates/jet-codegen/src/Codegen/TIR/opt.rs:1167
fn fold_integer_binary(op: BinOp, left: I64, right: I64) -> I64? {
    if op == {
        .Add -> left.checked_add(right)
        .Sub -> left.checked_sub(right)
        .Mul -> left.checked_mul(right)
        .Div -> left.checked_div(right)
        .FloorDiv -> floor_div(left, right)
        .Mod -> {
            quotient := floor_div(left, right) ?? return None
            product := quotient.checked_mul(right) ?? return None
            left.checked_sub(product)
        }
        .Rem -> left.checked_rem(right)
        .Pow -> {
            if right < 0 -> return None
            exponent := U32.try_from(right).ok() ?? return None
            left.checked_pow(exponent)
        }
        .BitAnd -> Val(left & right)
        .BitOr -> Val(left | right)
        .BitXor -> Val(left ^ right)
        .Shl -> left.checked_shl(U32.try_from(right).ok() ?? return None)
        .Shr -> left.checked_shr(U32.try_from(right).ok() ?? return None)
        .Eq -> Val(if left == right { 1 } else { 0 })
        .Ne -> Val(if left != right { 1 } else { 0 })
        .Lt -> Val(if left < right { 1 } else { 0 })
        .Gt -> Val(if left > right { 1 } else { 0 })
        .Le -> Val(if left <= right { 1 } else { 0 })
        .Ge -> Val(if left >= right { 1 } else { 0 })
        .And -> Val(if left != 0 && right != 0 { 1 } else { 0 })
        .Or -> Val(if left != 0 || right != 0 { 1 } else { 0 })
        .Compare -> None
    }
}

// Rust: crates/jet-codegen/src/Codegen/TIR/opt.rs:1204
fn floor_div(left: I64, right: I64) -> I64? {
    quotient := left.checked_div(right) ?? return None
    remainder := left.checked_rem(right) ?? return None
    if remainder != 0 && (left < 0) != (right < 0) { quotient.checked_sub(1) }
    else { Val(quotient) }
}
