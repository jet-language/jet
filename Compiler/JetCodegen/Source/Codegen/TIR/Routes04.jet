// Private continuation of canonical Codegen.TIR.Routes; checked handle/builtin rows.
use jet_foundation.[Type, Syntax, Effect, TBuiltinOp, THandleOp, THardwareCall, TFailureCarrier, TDBQueryMetadata, ListRemoveMode]
use JetCodegen.Codegen.TIR.[TRoutePlan, TPreludeRoute, LowerError]
use jet_foundation.MIR.[MirPreludeFamily, MirPreludeAbi, MirAuthorityDecision]
use JetCodegen.Codegen.TIR.Routes.[prelude, prelude_route_row, primitive, route_error, as_prelude, b, atomic_method_route, byte_buffer_method_route, string_method_route, byte_buffer_write_route]
use JetCollections.is_iter_type

impl THandleOp {
    // Rust: crates/jet-codegen/src/Codegen/TIR/routes.rs:4388
    pub fn prelude_route(self, receiver: Type, carrier: TFailureCarrier) -> TPreludeRoute LowerError! {
        return as_prelude(self.route_plan(receiver, carrier)?, "handle method variant {std.mem.discriminant(self):?}")
    }
}
// Rust: crates/jet-codegen/src/Codegen/TIR/routes.rs:4400
pub fn hardware_route(op: THardwareCall, carrier: TFailureCarrier) -> TRoutePlan {
    (member, symbol, arity, mask) :: if op == {
        .RegisterRead{..} -> ("register_read", "jet_hardware_register_read", 0, [])
        .RegisterWrite{..} -> ("register_write", "jet_hardware_register_write", 1, [false])
        .DMAStart{..} -> ("dma_start", "jet_hardware_dma_start", 1, [false])
        .DMAWait{..} -> ("dma_wait", "jet_hardware_dma_wait", 0, [])
    }
    return prelude(.HandleMethod, "core.hardware", member, symbol, arity, arity, mask, None, carrier, .Value)
}
// Rust: crates/jet-codegen/src/Codegen/TIR/routes.rs:4431
pub fn devserver_route(method: String, carrier: TFailureCarrier) -> TRoutePlan {
    (symbol, arity, mask, effect) :: if method == {
        "html" -> ("jet_devserver_html", 2, [true, false], None)
        "port" -> ("jet_devserver_port", 2, [true, false], None)
        "serve" -> ("jet_devserver_serve", 1, [true], Val(.Net))
        _ -> return primitive()
    }
    return prelude(.HandleMethod, "core.web.devserver", method, symbol, arity, arity, mask, effect, carrier, .Value)
}
// Rust: crates/jet-codegen/src/Codegen/TIR/routes.rs:4452
pub fn app_route(method: String, args_len: USize, carrier: TFailureCarrier) -> TRoutePlan {
    (symbol, arity, mask, effect) :: if (method, args_len) == {
        ("route", 2) -> ("jet_app_route", 4, [true, false, false, false], None)
        ("page", 2) -> ("jet_app_page", 4, [true, false, false, false], None)
        ("layout", 2) -> ("jet_app_layout", 4, [true, false, false, false], None)
        ("loader", 2) -> ("jet_app_loader", 4, [true, false, false, false], None)
        ("loader", 3) -> ("jet_app_loader_preload", 5, [true, false, false, false, false], None)
        ("pending", 1) -> ("jet_app_pending", 2, [true, false], None)
        ("not_found", 1) -> ("jet_app_not_found", 2, [true, false], None)
        ("error", 1) -> ("jet_app_error", 2, [true, false], None)
        ("action", 2) -> ("jet_app_action", 3, [true, false, false], None)
        ("form", 2) -> ("jet_app_form", 4, [true, false, false, false], None)
        ("data", 2) -> ("jet_app_data", 3, [true, false, false], None)
        ("mount", 2) -> ("jet_app_mount", 3, [true, false, false], None)
        ("mount", 3) -> ("jet_app_mount_with_effect", 4, [true, false, false, false], None)
        ("mount", 4) -> ("jet_app_mount_with_policy", 5, [true, false, false, false, false], None)
        ("routes", 1) -> ("jet_app_routes", 2, [true, false], None)
        ("security", 1) -> ("jet_app_security", 2, [true, false], None)
        ("assets", 1) -> ("jet_app_assets", 2, [true, false], None)
        ("split", 1) -> ("jet_app_split", 2, [true, false], None)
        ("code_split", 1) -> ("jet_app_code_split", 2, [true, false], None)
        ("cache", 1) -> ("jet_app_cache", 2, [true, false], None)
        ("a11y", 1) -> ("jet_app_a11y", 2, [true, false], None)
        ("adapter", 1) -> ("jet_app_adapter", 2, [true, false], None)
        ("csr", 0) -> ("jet_app_csr", 1, [true], None)
        ("ssr", 0) -> ("jet_app_ssr", 1, [true], None)
        ("ssg", 0) -> ("jet_app_ssg", 1, [true], None)
        ("stream", 0) -> ("jet_app_stream", 1, [true], None)
        ("streaming", 0) -> ("jet_app_streaming", 1, [true], None)
        ("island", 0) -> ("jet_app_island", 1, [true], None)
        ("hydration_dev", 0) -> ("jet_app_hydration_dev", 1, [true], None)
        ("hydration_release", 0) -> ("jet_app_hydration_release", 1, [true], None)
        ("facts_json", 0) -> ("jet_app_facts_json", 1, [true], None)
        ("serve", 0) -> ("jet_app_serve", 1, [true], Val(.Net))
        ("serve", 1) -> ("jet_app_serve_with_port", 2, [true, false], Val(.Net))
        ("serve_on", 1) -> ("jet_app_serve_on", 2, [true, false], Val(.Net))
        _ -> return primitive()
    }
    return prelude(.HandleMethod, "core.web.app", method, symbol, arity, arity, mask, effect, carrier, .Value)
}
// Rust: crates/jet-codegen/src/Codegen/TIR/routes.rs:4525
pub fn h(member: String, symbol: String, arity: USize, max_arity: USize, borrow_mask: [Bool], effect: Effect?, carrier: TFailureCarrier) -> TRoutePlan {
    return prelude(.HandleMethod, "core.handle", member, symbol, arity, max_arity, borrow_mask, effect, carrier, .Value)
}
// Rust: crates/jet-codegen/src/Codegen/TIR/routes.rs:4547
pub fn regex_route(kind: String, method: String, carrier: TFailureCarrier) -> TRoutePlan LowerError! {
    (symbol, mask) :: if (kind, method) == {
        ("Regex", "pattern") -> ("jet_std::JetRegex::pattern", [true])
        ("Regex", "source") -> ("jet_std::JetRegex::source", [true])
        ("Regex", "flags") -> ("jet_std::JetRegex::flags", [true])
        ("Regex", "options") -> ("jet_std::JetRegex::options", [true])
        ("Regex", "names") -> ("jet_std::JetRegex::names", [true])
        ("Regex", "count") -> ("jet_std::JetRegex::count", [true, true])
        ("Regex", "is_match") -> ("jet_std::JetRegex::is_match", [true, true])
        ("Regex", "full_match") -> ("jet_std::JetRegex::full_match", [true, true])
        ("Regex", "match") -> ("jet_std::JetRegex::match_value", [true, true])
        ("Regex", "find") -> ("jet_std::JetRegex::find", [true, true])
        ("Regex", "find_all") -> ("jet_std::JetRegex::find_all", [true, true])
        ("Regex", "matches") -> ("jet_std::JetRegex::matches", [true, true])
        ("Regex", "split") -> ("jet_std::JetRegex::split", [true, true])
        ("Regex", "replace") -> ("jet_std::JetRegex::replace", [true, true, true])
        ("Regex", "replace_first") -> ("jet_std::JetRegex::replace_first", [true, true, true])
        ("Regex", "replace_all_with") -> ("jet_std::JetRegex::replace_all_with", [true, true, false])
        ("Regex", "split_limit") -> ("jet_std::JetRegex::split_limit", [true, true, false])
        ("Match", "start") -> ("jet_std::JetRegexMatch::start", [true])
        ("Match", "end") -> ("jet_std::JetRegexMatch::end", [true])
        ("Match", "named_captures") -> ("jet_std::JetRegexMatch::named_captures", [true])
        ("Match", "group") -> ("jet_std::JetRegexMatch::group", [true, false])
        ("Match", "name") -> ("jet_std::JetRegexMatch::name", [true, true])
        ("Match", "group_start") -> ("jet_std::JetRegexMatch::group_start", [true, false])
        ("Match", "group_end") -> ("jet_std::JetRegexMatch::group_end", [true, false])
        _ -> throw route_error("unknown checked regex method `{kind}.{method}`")
    }
    return h("{kind}.{method}", symbol, mask.len(), mask.len(), mask, None, carrier)
}
// Rust: crates/jet-codegen/src/Codegen/TIR/routes.rs:4600
pub fn url_mime_route(kind: String, method: String, carrier: TFailureCarrier) -> TRoutePlan LowerError! {
    (symbol, mask) :: if (kind, method) == {
        ("MIME", "media_type") -> ("jet_std::JetMIME::media_type", [true])
        ("MIME", "subtype") -> ("jet_std::JetMIME::subtype", [true])
        ("MIME", "essence") -> ("jet_std::JetMIME::essence", [true])
        ("MIME", "params") -> ("jet_std::JetMIME::params", [true])
        ("MIME", "to_string") -> ("jet_std::JetMIME::to_string_value", [true])
        ("MIME", "param") -> ("jet_std::JetMIME::param", [true, true])
        _ -> throw route_error("unknown checked URL/MIME method `{kind}.{method}`")
    }
    return h("{kind}.{method}", symbol, mask.len(), mask.len(), mask, None, carrier)
}
// Rust: crates/jet-codegen/src/Codegen/TIR/routes.rs:4630
pub fn measurement_route(method: String, carrier: TFailureCarrier) -> TRoutePlan LowerError! {
    (symbol, mask) :: if method == {
        "value" -> ("jet_std::JetMeasurement::value", [true])
        "uncertainty" -> ("jet_std::JetMeasurement::uncertainty", [true])
        "add" -> ("jet_std::JetMeasurement::add", [true, false])
        "sub" -> ("jet_std::JetMeasurement::sub", [true, false])
        "mul" -> ("jet_std::JetMeasurement::mul", [true, false])
        "div" -> ("jet_std::JetMeasurement::div", [true, false])
        "sqrt" -> ("jet_std::JetMeasurement::sqrt", [true])
        _ -> throw route_error("unknown checked measurement method `{method}`")
    }
    return h("Measurement.{method}", symbol, mask.len(), mask.len(), mask, None, carrier)
}
// Rust: crates/jet-codegen/src/Codegen/TIR/routes.rs:4657
pub fn reactive_method_route(receiver: Type, method: String, carrier: TFailureCarrier) -> TRoutePlan LowerError! {
    (member, symbol, mask) :: if (receiver.without_user_tags().base_name(), method) == {
        (.Val("Signal"), "get") -> ("Signal.get", "jet_std::JetSignal::get", [true])
        (.Val("Derived" | "Computed"), "get") -> ("Derived.get", "jet_std::JetDerived::get", [true])
        (.Val("Signal"), "set") -> ("Signal.set", "jet_std::JetSignal::set", [true, false])
        _ -> throw route_error("checked reactive method `{method}` has no receiver route for {receiver.name()}")
    }
    return prelude(.HandleMethod, "core.reactive", member, symbol, mask.len(), mask.len(), mask, None, carrier, .Value)
}
// Rust: crates/jet-codegen/src/Codegen/TIR/routes.rs:4690
pub fn layout_method_route(method: String, carrier: TFailureCarrier) -> TRoutePlan LowerError! {
    (symbol, arity, mask) :: if method == {
        "h" | "v" -> ("jet_layout::Handle::{method}", 3, [true, false, false])
        "value" -> ("jet_layout::Handle::value", 2, [true, false])
        "suggest" -> ("jet_layout::Handle::suggest", 3, [true, false, false])
        "is_feasible" -> ("jet_layout::Handle::is_feasible", 1, [true])
        "conflict" -> ("jet_layout::Handle::conflict", 1, [true])
        "required" | "strong" | "medium" | "weak" -> ("jet_layout::Constraint::{method}", 1, [false])
        _ -> throw route_error("unknown checked layout method `{method}`")
    }
    return .Prelude(prelude_route_row(.HandleMethod, "core.layout", "layout.{method}", symbol, arity, arity, mask, None, carrier, .Value, "layout method")?)
}
// Rust: crates/jet-codegen/src/Codegen/TIR/routes.rs:4734
pub fn loadable_method_route(method: String, carrier: TFailureCarrier) -> TRoutePlan LowerError! {
    (arity, mask) :: if method == {
        "is_loading" | "is_loaded" | "is_failed" | "is_idle" | "loaded" -> (1, [true])
        "or_else" -> (2, [true, false])
        _ -> throw route_error("unknown checked Loadable method `{method}`")
    }
    return .Prelude(prelude_route_row(.HandleMethod, "core.pending", "loadable.{method}", "JetLoadable::{method}", arity, arity, mask, None, carrier, .Value, "loadable method")?)
}
// Rust: crates/jet-codegen/src/Codegen/TIR/routes.rs:4764
pub fn ui_backend_method_route(method: String, receiver: Type, carrier: TFailureCarrier) -> TRoutePlan LowerError! {
    name :: if receiver == { .Named(name) | .Apply{name, ..} -> name; _ -> throw route_error("checked UI backend receiver has no nominal type") }
    name :: name.rsplit("::").next().unwrap_or(name)
    name :: name.rsplit('.').next().unwrap_or(name)
    backend :: if name == { "NullBackend" -> "JetNullBackend"; "TUIBackend" -> "JetTuiBackend"; "GtkBackend" -> "JetGtkBackend"; _ -> throw route_error("checked UI backend type `{name}` has no Prelude carrier") }
    (member, mask) :: if method == {
        "measure" -> ("measure_node", [true, false, false])
        "layout" -> ("layout_node", [true, false, false])
        "paint" -> ("paint_node", [true, false])
        "on_event" -> ("dispatch_event", [true, false])
        "mount_default" -> ("mount_node_default", [true, false])
        "mount" -> ("mount_node", [true, false, false])
        "set_focus_group" -> ("set_focus_group", [true, false])
        "focused_label" -> ("focused_label", [true])
        "commands" if name == "NullBackend" -> ("paint_commands", [true])
        "frame_lines" | "render_count" if name == "TUIBackend" -> (method, [true])
        "present" if name == "GtkBackend" -> ("present", [true, false])
        _ -> throw route_error("checked UI backend method `{name}.{method}` has no Prelude route")
    }
    return .Prelude(prelude_route_row(.HandleMethod, "core.ui", "{name}.{method}", "{backend}::{member}", mask.len(), mask.len(), mask, None, carrier, .Value, "UI backend method")?)
}
// Rust: crates/jet-codegen/src/Codegen/TIR/routes.rs:4823
pub fn db_h(member: String, symbol: String, metadata: TDBQueryMetadata?, carrier: TFailureCarrier) -> TRoutePlan {
    plan := prelude(.HandleMethod, "core.handle", member, symbol, 3, 3, [true, true, true], Val(.DB), carrier, .Value)
    if plan != .Prelude(route) -> panic("database route is always a Prelude route")
    route.db_metadata = ~metadata
    return .Prelude(^route)
}
// Rust: crates/jet-codegen/src/Codegen/TIR/routes.rs:4847
pub fn plugin_call_route(member: String, symbol: String, carrier: TFailureCarrier) -> TRoutePlan {
    plan := prelude(.HandleMethod, "core.handle", member, symbol, 3, 3, [true, true, true], Val(.FFI), carrier, .Value)
    if plan != .Prelude(route) -> panic("plugin call route is always a Prelude route")
    route.authority = Val(MirAuthorityDecision.plugin_call())
    return .Prelude(^route)
}
// Rust: crates/jet-codegen/src/Codegen/TIR/routes.rs:4866
pub fn is_string_receiver(receiver: Type) -> Bool {
    return if receiver == { .Tagged{inner, ..} -> is_string_receiver(inner); .String -> true; _ -> false }
}
// Rust: crates/jet-codegen/src/Codegen/TIR/routes.rs:4874
pub fn builtin_collection_route(op: TBuiltinOp, receiver: Type, carrier: TFailureCarrier) -> TRoutePlan LowerError! {
    if receiver == .Tagged{inner, ..} -> return builtin_collection_route(op, inner, carrier)
    row :: (member, symbol, arity, mask) -> b(member, symbol, arity, arity, mask, None, carrier)
    return if (op, receiver) == {
        (.Contains, .List(_) | .FixedList{..}) -> row("contains", "jet_list_contains", 2, [true, true])
        (.Contains, .Apply{name: "Set", ..}) -> row("contains", "jet_set_has", 2, [true, true])
        (.Max{float: false, ..}, .Apply{name: "Set", ..}) -> row("max", "jet_set_max", 1, [true])
        (.SetShuffle, .Apply{name: "Set", ..}) -> row("shuffle", "jet_set_shuffle", 1, [true])
        (.Contains, .Apply{name: "View" | "ViewMut" | "ComputeViewMut", ..}) -> row("contains", "jet_list_contains", 2, [true, true])
        (.Contains, .Named("Range") | .InlineRange{..}) -> row("contains", "jet_range_contains", 2, [true, false])
        (.Contains, .Named(name)) if name == Syntax.TYPE_BITS -> row("bit_set_has", "jet_bit_set_has", 2, [true, false])
        (.ListUnion, .List(_) | .FixedList{..}) -> row("union", "jet_list_union", 2, [true, true])
        (.ListIntersection, .List(_) | .FixedList{..}) -> row("intersection", "jet_list_intersection", 2, [true, true])
        (.ListDifference, .List(_) | .FixedList{..}) -> row("difference", "jet_list_difference", 2, [true, true])
        (.ListRandom, .List(_) | .FixedList{..}) -> row("random", "jet_list_random", 1, [true])
        (.LenList, .List(_) | .FixedList{..}) -> row("len", "jet_list_len", 1, [true])
        (.LenList, .Apply{name: "Iter" | "ViewIter", ..}) -> row("len", "jet_iter_len", 1, [false])
        (.LenList, .Apply{name: "View" | "ViewMut" | "ComputeViewMut", ..}) -> row("len", "jet_list_len", 1, [true])
        (.LenList, .Map{..}) -> row("len", "jet_map_len", 1, [true])
        (.ContainsKey, .Map{..}) -> row("map_has_key", "jet_map_has_key", 2, [true, true])
        (.ContainsKey, .Apply{name, ..}) if name == Syntax.TYPE_LRU -> row("lru_has", "jet_lru_has", 2, [true, false])
        (.LenList, .Apply{name: "Set", ..}) -> row("len", "jet_set_len", 1, [true])
        (.SetCapacity, .Apply{name: "Set", ..}) -> row("capacity", "jet_set_capacity", 1, [true])
        (.LenList, .Apply{name, ..}) if name == Syntax.TYPE_RANK -> row("len", "jet_sorted_set_len", 1, [true])
        (.LenList, .Apply{name, ..}) if name == Syntax.TYPE_PRIORITY_QUEUE -> row("len", "jet_priority_queue_len", 1, [true])
        (.LenList, .Apply{name, ..}) if name == Syntax.TYPE_LRU -> row("len", "jet_lru_len", 1, [true])
        (.LenList, .Apply{name, ..}) if name == Syntax.TYPE_TALLY -> row("len", "jet_bag_len", 1, [true])
        (.LenList, .Named(name)) if name == Syntax.TYPE_BITS -> row("len", "jet_bit_set_len", 1, [true])
        (.LenList, .Apply{name, ..}) if name == Syntax.TYPE_QUEUE -> row("len", "jet_deque_len", 1, [true])
        (.DequeCapacity, .Apply{name, ..}) if name == Syntax.TYPE_QUEUE -> row("capacity", "jet_deque_capacity", 1, [true])
        (.LenList, .String) -> row("len", "jet_char_len", 1, [true])
        (.IsEmpty, .List(_) | .FixedList{..}) -> row("is_empty", "jet_list_is_empty", 1, [true])
        (.IsEmpty, .Apply{name: "Iter" | "ViewIter", ..}) -> row("is_empty", "jet_iter_is_empty", 1, [false])
        (.IsEmpty, .Apply{name: "View" | "ViewMut" | "ComputeViewMut", ..}) -> row("is_empty", "jet_list_is_empty", 1, [true])
        (.IsEmpty, .Map{..}) -> row("is_empty", "jet_map_is_empty", 1, [true])
        (.IsEmpty, .String) -> row("is_empty", "jet_string_is_empty", 1, [true])
        (.IsEmpty, .Apply{name: "Set", ..}) -> row("is_empty", "jet_set_is_empty", 1, [true])
        (.IsEmpty, .Apply{name, ..}) if name == Syntax.TYPE_RANK -> row("is_empty", "jet_sorted_set_is_empty", 1, [true])
        (.IsEmpty, .Apply{name, ..}) if name == Syntax.TYPE_PRIORITY_QUEUE -> row("is_empty", "jet_priority_queue_is_empty", 1, [true])
        (.IsEmpty, .Apply{name, ..}) if name == Syntax.TYPE_LRU -> row("is_empty", "jet_lru_is_empty", 1, [true])
        (.IsEmpty, .Apply{name, ..}) if name == Syntax.TYPE_TALLY -> row("is_empty", "jet_bag_is_empty", 1, [true])
        (.IsEmpty, .Named(name)) if name == Syntax.TYPE_BITS -> row("is_empty", "jet_bit_set_is_empty", 1, [true])
        (.IsEmpty, .Apply{name, ..}) if name == Syntax.TYPE_QUEUE -> row("is_empty", "jet_deque_is_empty", 1, [true])
        (.GetList, .List(_) | .FixedList{..}) -> row("get", "jet_list_get_opt", 2, [true, false])
        (.GetList, .Apply{name: "View" | "ViewMut" | "ComputeViewMut", ..}) -> row("get", "jet_list_get_opt", 2, [true, false])
        (.GetMap, .Map{..}) -> row("get", "jet_map_get_opt", 2, [true, true])
        (.First, .List(_) | .FixedList{..}) -> row("first", "jet_list_first", 1, [true])
        (.First, .Apply{name: "Iter" | "ViewIter", ..}) -> row("first", "jet_iter_first", 1, [false])
        (.First, .Apply{name: "View" | "ViewMut" | "ComputeViewMut", ..}) -> row("first", "jet_list_first", 1, [true])
        (.First, .Apply{name, ..}) if name == Syntax.TYPE_RANK -> row("first", "jet_sorted_set_first", 1, [true])
        (.Last, .List(_) | .FixedList{..}) -> row("last", "jet_list_last", 1, [true])
        (.Last, .Apply{name: "View" | "ViewMut" | "ComputeViewMut", ..}) -> row("last", "jet_list_last", 1, [true])
        (.Last, .Apply{name, ..}) if name == Syntax.TYPE_RANK -> row("last", "jet_sorted_set_last", 1, [true])
        _ -> throw route_error("checked builtin operation `{op:?}` has an unsupported receiver type")
    }
}
// Rust: crates/jet-codegen/src/Codegen/TIR/routes.rs:5056
pub fn iterator_builtin_route(op: TBuiltinOp, receiver: Type, carrier: TFailureCarrier) -> TRoutePlan? {
    if receiver == .Tagged{inner, ..} -> return iterator_builtin_route(op, inner, carrier)
    is_iter :: is_iter_type(receiver)
    is_list :: receiver == .List(_) || receiver == .FixedList{..}
    route :: (member, symbol, arity, mask) -> b(member, symbol, arity, arity, mask, None, carrier)
    plan :: if op == {
        .IterToList if is_iter -> route("iter_to_list", "jet_iter_to_list", 1, [false])
        .IterCollect if is_iter -> route("iter_collect", "jet_iter_collect", 1, [false])
        .ListLazy if is_list -> route("list_lazy", "jet_iter_from_vec", 1, [false])
        .Take if is_iter -> route("iter_take", "jet_iter_take", 2, [false, false])
        .Skip if is_iter -> route("iter_skip", "jet_iter_skip", 2, [false, false])
        .StepBy if is_iter -> route("iter_step_by", "jet_iter_step_by", 2, [false, false])
        .Dedup if is_iter -> route("iter_dedup", "jet_iter_dedup", 1, [false])
        .Chunks if is_iter -> route("iter_chunks", "jet_iter_chunks", 2, [false, false])
        .Windows if is_iter -> route("iter_windows", "jet_iter_windows", 2, [false, false])
        .Flatten if is_iter -> route("iter_flatten", "jet_iter_flatten", 1, [false])
        .Flatten if is_list -> route("list_flatten", "jet_list_flatten", 1, [false])
        .Intersperse if is_iter -> route("iter_intersperse", "jet_iter_intersperse", 2, [false, false])
        .IterRepeat if is_iter -> route("iter_repeat", "jet_iter_repeat", 2, [false, false])
        .IterCycle if is_iter -> route("iter_cycle", "jet_iter_cycle", 2, [false, false])
        .IterDropLast if is_iter -> route("iter_drop_last", "jet_iter_drop_last", 2, [false, false])
        .IterShuffle if is_iter -> route("iter_shuffle", "jet_iter_shuffle", 1, [false])
        .IterIsSorted if is_iter -> route("iter_is_sorted", "jet_iter_is_sorted", 1, [false])
        .IterLastIndexOf if is_iter -> route("iter_last_index_of", "jet_iter_last_index_of", 2, [false, false])
        .IterAverage{float: true} if is_iter -> route("iter_average_float", "jet_iter_average_float", 1, [false])
        .IterAverage{float: false} if is_iter -> route("iter_average_int", "jet_iter_average_int", 1, [false])
        .IterCompare if is_iter -> route("iter_compare", "jet_iter_compare", 2, [false, false])
        .JoinSep if is_iter -> route("iter_join", "jet_iter_join", 2, [false, true])
        .TryCollect if is_iter -> route("try_collect", "jet_list_try_collect", 1, [false])
        _ -> return None
    }
    return Val(plan)
}
