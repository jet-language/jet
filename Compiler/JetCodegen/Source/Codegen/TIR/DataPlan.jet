// Total backend-neutral carrier for checked table-plan facts: no evaluator,
// closure, row buffer, or target-specific operator.
use jet_codegen.[TExpr, TExprKind]
use jet_foundation.[DataPlanCallable, DataPlanFact, DataPlanLogicalNode, DataPlanNodeId, DataPlanOperationKind, DataPlanPhysicalNode, DataPlanPhysicalOperatorKind, DataPlanSchema, DataPlanSourceKind, DataPlanStreamMode, DataPlanValidationError, Type, Span]
use jet_syntax.CoreCallRecord
use jet_sema.[DataPlanBuilder, DataPlanCallKind, classify_data_call, classify_data_receiver_call, callable_fact, scalar_schema]

// Rust: crates/jet-codegen/src/Codegen/TIR/data_plan.rs:17
pub const TDATA_PLAN_SCHEMA_VERSION: U32 = 1

// Rust: crates/jet-codegen/src/Codegen/TIR/data_plan.rs:20
pub struct TDataPlanNode {
    pub id: DataPlanNodeId
    pub operation: DataPlanOperationKind
    pub inputs: [DataPlanNodeId]
    pub source: DataPlanSourceKind?
    pub schema: DataPlanSchema
    pub callable: DataPlanCallable?
    pub stream: DataPlanStreamMode
    pub span: Span
}

// Rust: crates/jet-codegen/src/Codegen/TIR/data_plan.rs:31
impl TDataPlanNode {
    // Rust: crates/jet-codegen/src/Codegen/TIR/data_plan.rs:32
    pub fn from(node: DataPlanLogicalNode) -> TDataPlanNode {
        TDataPlanNode{id: node.id, operation: node.operation, inputs: ~node.inputs, source: node.source, schema: ~node.schema, callable: ~node.callable, stream: ~node.stream, span: node.span}
    }
}

// Rust: crates/jet-codegen/src/Codegen/TIR/data_plan.rs:47
pub struct TDataPlanPhysicalNode {
    pub logical: DataPlanNodeId
    pub operator: DataPlanPhysicalOperatorKind
    pub stream: DataPlanStreamMode
    pub reason: String
}

// Rust: crates/jet-codegen/src/Codegen/TIR/data_plan.rs:54
impl TDataPlanPhysicalNode {
    // Rust: crates/jet-codegen/src/Codegen/TIR/data_plan.rs:55
    pub fn from(node: DataPlanPhysicalNode) -> TDataPlanPhysicalNode {
        TDataPlanPhysicalNode{logical: node.logical, operator: node.operator, stream: ~node.stream, reason: ~node.reason}
    }
}

// Rust: crates/jet-codegen/src/Codegen/TIR/data_plan.rs:67
pub struct TDataPlan {
    pub source: DataPlanSourceKind
    pub logical: [TDataPlanNode]
    pub physical: [TDataPlanPhysicalNode]
    pub output: DataPlanNodeId
    pub source_span: Span
}

// Rust: crates/jet-codegen/src/Codegen/TIR/data_plan.rs:75
impl TDataPlan {
    // Rust: crates/jet-codegen/src/Codegen/TIR/data_plan.rs:78
    pub fn from_fact(fact: DataPlanFact) -> TDataPlan DataPlanError! {
        fact.validate() catch error { fail DataPlanError.Validation(error) }
        plan :: TDataPlan{source: fact.source, logical: fact.logical.map((node) -> TDataPlanNode.from(node)).collect(), physical: fact.physical.map((node) -> TDataPlanPhysicalNode.from(node)).collect(), output: fact.output, source_span: fact.source_span}
        if !plan.validate() -> fail DataPlanError.InvalidProjection
        plan
    }

    // Rust: crates/jet-codegen/src/Codegen/TIR/data_plan.rs:96
    pub fn output_node(self) -> TDataPlanNode? { self.logical.get(self.output.index()) }

    // Rust: crates/jet-codegen/src/Codegen/TIR/data_plan.rs:100
    pub fn output_schema(self) -> DataPlanSchema? { self.output_node().map((node) -> node.schema) }

    // Rust: crates/jet-codegen/src/Codegen/TIR/data_plan.rs:104
    pub fn output_type(self) -> Type? { self.output_schema().map((schema) -> schema.row_type) }

    // Rust: crates/jet-codegen/src/Codegen/TIR/data_plan.rs:108
    pub fn validate(self) -> Bool DataPlanError! {
        if self.logical.is_empty() || self.output.index() >= self.logical.len() -> return false
        if self.logical[0].operation != .Scan || self.logical[0].source != Val(self.source) -> return false
        loop (index, node) in self.logical.enumerate() {
            if node.id.index() != index -> return false
            node.schema.validate() catch _ { return false }
            if node.inputs.any((input) -> input.index() >= index) -> return false
        }
        loop node in self.physical {
            reason := node.reason.trim() // #4303
            if node.logical.index() >= self.logical.len() || reason.is_empty() -> return false
        }
        true
    }

    // Rust: crates/jet-codegen/src/Codegen/TIR/data_plan.rs:138
    pub fn canonical_key(self) -> String {
        // Include schema/callback/stream facts, not just graph topology.
        logical :: self.logical.map((node) -> {
            inputs :: node.inputs.map((input) -> input.index().to_string()).collect().join(",")
            source :: node.source.map((kind) -> kind.as_str()) ?? "none"
            columns :: node.schema.columns.map((column) -> "{column.name:?}:{column.ty.name()}:nullable={column.nullable}").collect().join(",")
            callable :: node.callable.map((callback) -> "{callback.label:?}:{callback.parameter.name()}:{callback.result.name()}:{callback.span.start}-{callback.span.end}") ?? "none"
            "{node.id.index()}:{node.operation.as_str()}:{inputs}:source={source}:row={node.schema.row_type.name()}:columns=[{columns}]:callable={callable}:stream={node.stream:?}:span={node.span.start}-{node.span.end}"
        }).collect().join("|")
        physical :: self.physical.map((node) -> "{node.logical.index()}:{node.operator.as_str()}:stream={node.stream:?}:reason={node.reason:?}").collect().join("|")
        "source={self.source.as_str()};output={self.output.index()};logical={logical};physical={physical}"
    }

    // Rust: crates/jet-codegen/src/Codegen/TIR/data_plan.rs:210
    pub fn to_fact(self) -> DataPlanFact {
        DataPlanFact{
            source: self.source,
            logical: self.logical.map((node) -> DataPlanLogicalNode{id: node.id, operation: node.operation, inputs: ~node.inputs, source: node.source, schema: ~node.schema, callable: ~node.callable, stream: ~node.stream, span: node.span}).collect(),
            physical: self.physical.map((node) -> DataPlanPhysicalNode{logical: node.logical, operator: node.operator, stream: ~node.stream, reason: ~node.reason}).collect(),
            output: self.output,
            source_span: self.source_span,
        }
    }
}

// Rust: crates/jet-codegen/src/Codegen/TIR/data_plan.rs:243
fn result_inner(ty: Type) -> Type {
    if ty == {
        .Result{ok, ..} -> result_inner(ok)
        else -> ty
    }
}

// Rust: crates/jet-codegen/src/Codegen/TIR/data_plan.rs:250
fn row_type(ty: Type) -> Type? {
    if result_inner(ty) == {
        .List(inner) | .FixedList{elem: inner, ..} -> Val(~inner)
        .Apply{name, args} if (name == "Query" || name == "DataStream" || name == "DataLoader") && args.len() == 1 -> Val(~args[0])
        else -> None
    }
}

// Rust: crates/jet-codegen/src/Codegen/TIR/data_plan.rs:263
fn chained_fact(args: [TExpr]) -> DataPlanFact? {
    if args.first() == .Val(arg) {
        if arg.kind == .CoreCall{data_plan: .Val(plan), ..} -> return Val(plan.to_fact())
    }
    None
}

// Rust: crates/jet-codegen/src/Codegen/TIR/data_plan.rs:273
fn callable(arg: TExpr?, label: String, span: Span) -> DataPlanCallable Err! {
    if arg == .Val(TExpr{ty: .Fn{params, ret: .Val(ret), ..}, ..}) {
        if params.len() != 1 -> fail "checked data call `{label}` callable must take one row parameter"
        return callable_fact(~label, ~params[0], ~ret, span)
    }
    fail "checked data call `{label}` has no typed callable"
}

// Rust: crates/jet-codegen/src/Codegen/TIR/data_plan.rs:300
pub fn data_plan_for_core_call(record: CoreCallRecord, args: [TExpr], result_ty: Type, span: Span) -> TDataPlan? Err! {
    kind :: classify_data_call(record.module, record.member) ?? classify_data_receiver_call(record.receiver_types, record.member) ?? return None
    fact :: chained_fact(args)
    builder := if fact == {
        .Val(fact) -> DataPlanBuilder.from_fact(fact) catch error { fail error.to_string() }
        None -> {
            source :: if kind == {
                .Scan(source) -> source
                else -> DataPlanSourceKind.Table
            }
            schema_ty :: if kind == {
                .Scan(_) -> result_ty
                else -> args.first().map((arg) -> arg.ty) ?? result_ty
            }
            row :: row_type(schema_ty) ?? fail "checked data call `{record.module}.{record.member}` has no typed row schema"
            DataPlanBuilder.new(source, scalar_schema(row), span) catch error { fail error.to_string() }
        }
    }
    if kind == {
        .Scan(_) -> {}
        .Filter | .SortBy -> {
            label :: "{record.module}.{record.member}"
            callback :: callable(args.get(1), label, span)
            if kind == .Filter {
                _ :: &builder.filter(callback, span) catch error { fail error.to_string() }
            } else {
                _ :: &builder.sort_by(callback, span) catch error { fail error.to_string() }
            }
        }
        .Collect -> { _ :: &builder.collect(span) catch error { fail error.to_string() } }
        .InspectPlan -> {}
    }
    finished :: builder.finish() catch error { fail error.to_string() }
    Val(TDataPlan.from_fact(finished) catch error { fail error.to_string() })
}

// Rust: crates/jet-codegen/src/Codegen/TIR/data_plan.rs:363
#Error
pub enum DataPlanError {
    Validation(DataPlanValidationError)
    InvalidProjection
}

// Rust: crates/jet-codegen/src/Codegen/TIR/data_plan.rs:368
impl DataPlanError {
    // Rust: crates/jet-codegen/src/Codegen/TIR/data_plan.rs:369
    pub fn to_string(self) -> String {
        if self == {
            .Validation(error) -> error.to_string()
            .InvalidProjection -> "TIR table-plan projection is invalid"
        }
    }
}

// Rust: crates/jet-codegen/src/Codegen/TIR/data_plan.rs:381
pub fn project_data_plan(fact: DataPlanFact) -> TDataPlan DataPlanError! {
    TDataPlan.from_fact(fact)
}
