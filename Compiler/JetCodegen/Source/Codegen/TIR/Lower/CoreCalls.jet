fn ui_preview_callback_type() -> Type Never! {
    Type.Fn(params: [], ret: Val(Type.Named("UINode")), effect_bound: None, param_contract: None, call_metadata: None, return_view_provenance: None)
}
// Rust: crates/jet-codegen/src/Codegen/TIR/lower/core_calls.rs:117
fn lower_optional_core_arg(arg: &CallArg, expected: &Type, cx: &Cx, env: &LowerEnv) -> TExpr Never! {
    option_ty :: Type.Option(expected.clone())
    if &arg.expr == {
        .Absent(_) -> TExpr{ty: ^option_ty, kind: TExprKind.Absent}
        else -> TExpr{ty: ^option_ty, kind: TExprKind.Present(lower_owned_expr(&arg.expr, cx, env))}
    }
}
// Rust: crates/jet-codegen/src/Codegen/TIR/lower/core_calls.rs:137
fn typed_lambda_value(source: &Lambda, lowered: TLambda) -> TExpr Never! {
    ty :: Type.Fn(params: lowered.param_types.clone(), ret: lowered.ret.clone(), effect_bound: None,
        param_contract: None, call_metadata: None, return_view_provenance: source.meta.return_view_provenance.clone())
    TExpr{ty: ^ty, kind: TExprKind.Lambda(^lowered)}
}
// Rust: crates/jet-codegen/src/Codegen/TIR/lower/core_calls.rs:154
fn query_callback_return_type(method: String, index: USize) -> Type? Never! {
    if method == {
        "filter" -> Val(Type.Bool)
        "sort_by" -> Val(Type.String)
        "inner_join" | "left_join" -> { if index >= 1 -> Val(Type.String) else -> None }
        else -> None
    }
}
// Rust: crates/jet-codegen/src/Codegen/TIR/lower/core_calls.rs:163
fn no_widening(args: &[TExpr]) -> [Bool] Never! { [false; args.len()] }
// Rust: crates/jet-codegen/src/Codegen/TIR/lower/core_calls.rs:167
fn data_widening(args: &[TExpr], expected_lists: &[(USize, &Type)]) -> [Bool] Never! {
    widening := no_widening(args)
    loop (index, expected) in expected_lists {
        if args.get(index) == {
            .Val(arg) -> { widening[index] = if &arg.ty == { .FixedList(elem: elem, ..) -> fixed_list_elem_compatible(elem, expected) else -> false } }
            else -> {}
        }
    }
    ^widening
}
// Rust: crates/jet-codegen/src/Codegen/TIR/lower/core_calls.rs:193
// One source callback is one table entry, across repeated lowerings.
pub fn jit_spawn_site_with(lam: &Lambda, cx: &Cx, env: &LowerEnv, lower: fn(&Lambda, &Cx, &LowerEnv) -> TJitSpawnLambda) -> USize Never! {
    // GATE #4499: exact enclosing-function/span tuple identity.
    key :: (env.fn_name.clone(), lam.span.start, lam.span.end)
    existing :: cx.jit_spawn_sites.borrow().get(&key).copied()
    if existing == { .Val(site) -> return site else -> {} }
    jit_lambda :: lower(lam, cx, env)
    site :: cx.jit_spawn_site_base + cx.jit_spawn_lambdas.borrow().len()
    cx.jit_spawn_lambdas.borrow_mut().push(^jit_lambda)
    cx.jit_spawn_sites.borrow_mut().insert(key, site)
    site
}
// Rust: crates/jet-codegen/src/Codegen/TIR/lower/core_calls.rs:212
pub fn jit_spawn_site(lam: &Lambda, cx: &Cx, env: &LowerEnv) -> USize Never! { jit_spawn_site_with(lam, cx, env, lower_spawn_lambda_for_jit) }
// Rust: crates/jet-codegen/src/Codegen/TIR/lower/core_calls.rs:216
pub fn jit_spawn_site_unit(lam: &Lambda, cx: &Cx, env: &LowerEnv) -> USize Never! { jit_spawn_site_with(lam, cx, env, lower_spawn_lambda_for_jit_unit) }
// Rust: crates/jet-codegen/src/Codegen/TIR/lower/core_calls.rs:220
fn interrupt_callback_value(value: TExpr) -> TExpr Never! {
    ty :: value.ty.clone()
    TExpr{ty: ^ty, kind: TExprKind.FnValue(kind: TFnValueKind.Send(value: ^value))}
}
// Rust: crates/jet-codegen/src/Codegen/TIR/lower/core_calls.rs:232
fn normalize_interrupt_named_value(value: TExpr) -> TExpr Never! { ^value }
// Rust: crates/jet-codegen/src/Codegen/TIR/lower/core_calls.rs:236
fn lower_interrupt_callback(expr: &Expr, cx: &Cx, env: &LowerEnv) -> TExpr Never! {
    if expr == {
        .Paren(inner, _) -> lower_interrupt_callback(inner, cx, env)
        .Lambda(lam) -> {
            tl := lower_lambda_expecting_value(lam, cx, env, &[])
            tl.arc = true
            tl.rc = false
            ty :: Type.Fn(params: tl.param_types.clone(), ret: tl.ret.clone(), effect_bound: None,
                param_contract: None, call_metadata: None, return_view_provenance: lam.meta.return_view_provenance.clone())
            interrupt_callback_value(TExpr{ty: ^ty, kind: TExprKind.Lambda(^tl)})
        }
        .Ident(name, _) -> {
            if !env.locals.contains_key(name) && !cx.consts.contains_key(name) {
                ty :: cx.fn_types.get(name).cloned() ?? return invariant_violation_expr(expr.span(), "checked interrupt callback is missing its function type")
                if ty == { .Fn(..) -> {} else -> return invariant_violation_expr(expr.span(), "checked interrupt callback is not a function value") }
                interrupt_callback_value(TExpr{ty: ty.clone(), kind: TExprKind.FnValue(kind: TFnValueKind.NamedFn(name: Val(name.clone()), lambda: None))})
            } else -> interrupt_callback_value(normalize_interrupt_named_value(lower_expr(expr, cx, env)))
        }
        else -> interrupt_callback_value(normalize_interrupt_named_value(lower_expr(expr, cx, env)))
    }
}
// Rust: crates/jet-codegen/src/Codegen/TIR/lower/core_calls.rs:289
pub fn core_module_path_from_receiver(receiver: &Expr, cx: &Cx, env: &LowerEnv) -> String? Never! {
    if receiver == {
        .Ident(alias, _) -> {
            if !env.locals.contains_key(alias) -> cx.core_import_module_for_function(env.fn_name, alias).map(fn(module) { module.to_string() }) else -> None
        }
        .Field(base, leaf, _) -> {
            module :: core_module_path_from_receiver(base, cx, env) ?? return None
            submodule :: "{module}.{leaf}"
            if Syntax.is_known_core_module(submodule) -> Val(submodule) else -> None
        }
        else -> None
    }
}
// Rust: crates/jet-codegen/src/Codegen/TIR/lower/core_calls.rs:312
pub fn lower_query_receiver_call(receiver: &Expr, method: String, method_span: Span, args: &[CallArg], recv_type: &String?, resolved_ret: &Type?, cx: &Cx, env: &LowerEnv, lowered_receiver: &TExpr?) -> TExpr? Never! {
    (receiver_type, callback_row_index) :: if recv_type == {
        .Val("Query") -> {
            if method == { "filter" | "sort_by" | "map" | "min" | "max" | "inner_join" | "left_join" | "collect" | "plan" | "group_by" | "watch" -> ("Query", 0) else -> return None }
        }
        .Val("DataTracked") -> { if method == { "query" | "insert" | "replace" | "remove" -> ("DataTracked", 0) else -> return None } }
        .Val("DataWatch") -> { if method == { "get" | "status" | "cancel" -> ("DataWatch", 0) else -> return None } }
        .Val("DataGroupedQuery") -> { if method == { "count" | "sum" | "mean" -> ("DataGroupedQuery", 0) else -> return None } }
        None -> {
            result_return :: resolved_ret.is_some_and(fn(ty) { if ty == { .Result(..) -> true else -> false } })
            if method == "query" && args.len() == 1 && result_return && core_module_path_from_receiver(receiver, cx, env) == None -> (Syntax.INTERNAL_LIST_QUERY_HANDLE, 0) else -> return None
        }
        else -> return None
    }
    record :: Syntax.core_receiver_method(receiver_type, method) ?? return Val(invariant_violation_expr(method_span, "checked query method `{method}` has no canonical receiver Core row"))
    result_ty :: resolved_ret.cloned() ?? return Val(invariant_violation_expr(method_span, "checked query method `{method}` has no resolved return type"))
    lowered :: lowered_receiver.cloned() ?? lower_expr(receiver, cx, env)
    row_ty :: if lowered.ty.without_user_tags() == {
        .Apply(name, type_args) -> {
            if (name == "Query" && type_args.len() == 1) || (name == "DataGroupedQuery" && type_args.len() == 2) || (name == "DataTracked" && type_args.len() == 2) || (name == "DataWatch" && type_args.len() == 1) -> Val(type_args[callback_row_index].clone())
            else if name == "DataStream" && type_args.len() == 1 -> Val(type_args[0].clone())
            else -> None
        }
        .List(inner) | .FixedList(elem: inner, ..) -> Val(inner.clone())
        else -> None
    } ?? return Val(invariant_violation_expr(method_span, "checked query method `{method}` did not retain its row type"))
    call_args := [TExpr].with_capacity(args.len() + 1)
    call_args.push(^lowered)
    loop (index, arg) in args.iter().enumerate() {
        takes_callback :: if method == "inner_join" || method == "left_join" -> index >= 1
            else -> if method == { "filter" | "sort_by" | "map" | "min" | "max" | "group_by" | "sum" | "mean" -> true else -> false }
        if takes_callback {
            lam :: if required_lambda(args, index, "core.data", method, method_span) == { .Ok(lam) -> lam .Err(error) -> return Val(^error) }
            callback_row :: if (method == "inner_join" || method == "left_join") && index == 2 -> call_args.get(1).and_then(fn(other) {
                if other.ty.without_user_tags() == { .Apply(name, type_args) -> { if name == "Query" && type_args.len() == 1 -> Val(type_args[0].clone()) else -> None } else -> None }
            }) ?? row_ty.clone() else -> row_ty.clone()
            lowered_callback :: if query_callback_return_type(method, index) == {
                .Val(callback_return) -> lower_lambda_expecting_value_with_return(lam, cx, env, &[callback_row], &callback_return)
                else -> lower_lambda_expecting_value(lam, cx, env, &[callback_row])
            }
            call_args.push(typed_lambda_value(lam, ^lowered_callback))
        } else { call_args.push(lower_expr(&arg.expr, cx, env)) }
    }
    if !record.accepts_arity(call_args.len()) -> return Val(invariant_violation_expr(method_span, "checked query Core row `{method}` has wrong arity {call_args.len()}"))
    data_plan :: if data_plan_for_core_call(record, &call_args, &result_ty, method_span) == { .Ok(plan) -> plan .Err(error) -> return Val(invariant_violation_expr(method_span, error)) }
    widen_to_vec :: if receiver_type == Syntax.INTERNAL_LIST_QUERY_HANDLE -> data_widening(&call_args, &[(0, &row_ty)]) else -> no_widening(&call_args)
    Val(TExpr{ty: result_ty.clone(), kind: TExprKind.CoreCall(record: record, args: ^call_args, source_span: method_span,
        type_args: if receiver_type == Syntax.INTERNAL_LIST_QUERY_HANDLE -> [row_ty.clone()] else -> [],
        widen_to_vec: ^widen_to_vec, data_plan: ^data_plan, fallibility: TFailureCarrier.from_checked_type(&result_ty))})
}

// Rust: crates/jet-codegen/src/Codegen/TIR/lower/core_calls.rs:475
pub fn lower_core_closure_call(module: String, method: String, source_span: Span, args: &[CallArg], cx: &Cx, env: &LowerEnv) -> TExpr? Never! {
    if module == "core.term" && method == "progress" {
        first :: args.first() ?? return Val(invariant_violation_expr(source_span, "checked progress call has no source"))
        source := lower_owned_expr(&first.expr, cx, env)
        (member, result_ty) :: if &source.ty == {
            .String -> {
                (_, result) :: core_call_semantic_signature(module, method) ?? return Val(invariant_violation_expr(source_span, "checked text progress has no signature"))
                ("progress", result)
            }
            .List(elem) | .FixedList(elem: elem, ..) -> {
                result :: iter_ty(elem.clone())
                source = TExpr{ty: result.clone(), kind: TExprKind.BuiltinMethod(recv: ^source, op: TBuiltinOp.ListLazy, args: [])}
                ("progress_iter", ^result)
            }
            .Apply(name, type_args) -> {
                if name == Syntax.TYPE_ITER && type_args.len() == 1 -> ("progress_iter", source.ty.clone())
                else -> return Val(invariant_violation_expr(source_span, "checked progress source is not text or a sequence"))
            }
            else -> return Val(invariant_violation_expr(source_span, "checked progress source is not text or a sequence"))
        }
        values := [^source]
        values.extend(args.iter().skip(1).map(fn(arg) { lower_owned_expr(&arg.expr, cx, env) }))
        if member == "progress_iter" { while values.len() < 3 { values.push(TExpr{ty: Type.String, kind: TExprKind.StrLit([])}) } }
        record :: if checked_core_record(module, member, values.len(), source_span) == { .Ok(record) -> record .Err(error) -> return Val(^error) }
        return Val(TExpr{ty: result_ty.clone(), kind: TExprKind.CoreCall(record: record, args: ^values, source_span: source_span,
            type_args: [], widen_to_vec: [], data_plan: None, fallibility: TFailureCarrier.from_checked_type(&result_ty))})
    }
    if module == "core.data" && method == "query" {
        if args.len() != 1 -> return Val(invariant_violation_expr(source_span, "checked Core call `core.data.query` has the wrong arity"))
        record :: if checked_core_record(module, method, args.len(), source_span) == { .Ok(record) -> record .Err(error) -> return Val(^error) }
        rows :: lower_expr(&args[0].expr, cx, env)
        row_ty :: if &rows.ty == {
            .List(inner) | .FixedList(elem: inner, ..) -> Val(inner.clone())
            .Apply(name, type_args) -> { if name == "DataStream" && type_args.len() == 1 -> Val(type_args[0].clone()) else -> None }
            else -> None
        } ?? return Val(invariant_violation_expr(source_span, "checked Core call `core.data.query` did not retain its row type"))
        rows_is_stream :: if &rows.ty == { .Apply(name, type_args) -> name == "DataStream" && type_args.len() == 1 else -> false }
        widen_to_vec :: data_widening(std.slice.from_ref(&rows), &[(0, &row_ty)])
        already_taken :: if &rows.kind == { .Move(_) | .ResourceTake(_) -> true else -> false }
        call_args :: if rows_is_stream && !already_taken -> [TExpr{ty: rows.ty.clone(), kind: TExprKind.Move(^rows)}] else -> [^rows]
        result_ty :: Type.Apply(name: "Query", args: [row_ty.clone()])
        data_plan :: if data_plan_for_core_call(record, &call_args, &result_ty, source_span) == { .Ok(plan) -> plan .Err(error) -> return Val(invariant_violation_expr(source_span, error)) }
        return Val(TExpr{ty: result_ty.clone(), kind: TExprKind.CoreCall(record: record, args: ^call_args, source_span: source_span,
            type_args: if rows_is_stream -> [row_ty.clone()] else -> [], widen_to_vec: ^widen_to_vec, data_plan: ^data_plan, fallibility: TFailureCarrier.from_checked_type(&result_ty))})
    }
    if module == "core.rt" && method == "callback" {
        if args.len() != 3 -> return Val(invariant_violation_expr(source_span, "checked Core call `core.rt.callback` has the wrong arity"))
        lam :: if required_lambda(args, 2, module, method, source_span) == { .Ok(lam) -> lam .Err(error) -> return Val(^error) }
        callback_fn :: Type.Fn(params: [Type.List(Type.Float)], ret: Val(unit_type()),
            effect_bound: Val([("Mem.Alloc", source_span), ("Time.Wait", source_span)]), return_view_provenance: None, param_contract: None, call_metadata: None)
        return Val(TExpr{ty: Type.Named("RealtimeStream"), kind: TExprKind.CoreClosureCall(kind: TCoreClosureKind.Realtime(
            rate: lower_expr(&args[0].expr, cx, env), frames: lower_expr(&args[1].expr, cx, env),
            executable: lower_lambda_expecting_callable(lam, cx, env, &callback_fn)))})
    }
    if module == "core.tasks" && method == "spawn" {
        if args.len() != 1 -> return Val(invariant_violation_expr(source_span, "checked Core call `core.tasks.spawn` has the wrong arity"))
        lam :: if required_lambda(args, 0, module, method, source_span) == { .Ok(lam) -> lam .Err(error) -> return Val(^error) }
        carrier_ty :: spawn_body_carrier_ty(lam, cx, env)
        spawn_env := clone_env(env)
        spawn_env.ret_ty = Val(carrier_ty.clone())
        site :: jit_spawn_site(lam, cx, env)
        label :: spawn_label(lam, cx, env)
        executable :: lower_lambda_expecting_value_with_return(lam, cx, &spawn_env, &[], &carrier_ty)
        return Val(TExpr{ty: core_closure_call_return_ty(module, method, ^carrier_ty), kind: TExprKind.CoreClosureCall(kind: TCoreClosureKind.Spawn(group: None, site: site, label: label, executable: ^executable))})
    }
    data_err :: fn() { Type.Named("DataError") }
    wrap_data :: fn(ok: Type) { Type.Result(ok: ^ok, err: data_err()) }
    data_row_ty :: fn(ty: &Type) {
        if ty == {
            .List(inner) | .FixedList(elem: inner, ..) -> Val(inner.clone())
            .Apply(name, type_args) -> { if name == "DataStream" && type_args.len() == 1 -> Val(type_args[0].clone()) else -> None }
            else -> None
        }
    }
    kind :: if (module, method) == {
        ("core.sys", "on_interrupt") -> {
            if args.len() != 1 -> return Val(invariant_violation_expr(source_span, "checked Core call `core.sys.on_interrupt` has the wrong arity"))
            TCoreClosureKind.OnInterrupt(callback: lower_interrupt_callback(&args[0].expr, cx, env))
        }
        ("core.http", "serve") -> {
            if args.len() != 2 -> return Val(invariant_violation_expr(source_span, "checked Core call `core.http.serve` has the wrong arity"))
            // Ordinary CoreCall owns the valid serve(addr, router) form.
            lam :: args.get(1).and_then(fn(arg) { lambda_from_expr(&arg.expr) }) ?? return None
            address_arg :: args.first() ?? return Val(invariant_violation_expr(source_span, "checked Core call `core.http.serve` is missing its address"))
            addr :: lower_expr(&address_arg.expr, cx, env)
            executable :: lower_lambda_expecting_value(lam, cx, env, &[Type.Named("HTTPRequest")])
            TCoreClosureKind.Serve(addr: ^addr, executable: ^executable)
        }
        ("core.mem.scope", "guard") -> {
            if args.len() != 1 -> return Val(invariant_violation_expr(source_span, "checked Core call `core.mem.scope.guard` has the wrong arity"))
            lam :: if required_lambda(args, 0, module, method, source_span) == { .Ok(lam) -> lam .Err(error) -> return Val(^error) }
            TCoreClosureKind.Guard(executable: lower_lambda_expecting_callable(lam, cx, env, &unit_callback_type()))
        }
        ("core.data", "track") -> {
            record :: if checked_core_record(module, method, args.len(), source_span) == { .Ok(record) -> record .Err(error) -> return Val(^error) }
            if args.len() != 2 -> return Val(invariant_violation_expr(source_span, "checked Core call `core.data.track` has the wrong arity"))
            rows :: lower_expr(&args[0].expr, cx, env)
            row_ty :: data_row_ty(&rows.ty) ?? return Val(invariant_violation_expr(source_span, "checked Core call `core.data.track` did not retain its row type"))
            lam :: if required_lambda(args, 1, module, method, source_span) == { .Ok(lam) -> lam .Err(error) -> return Val(^error) }
            key :: lower_lambda_expecting_value(lam, cx, env, &[row_ty.clone()])
            key_ty :: key.ret.clone() ?? lambda_body_ty_expecting(lam, cx, env, Val(&[row_ty.clone()]))
            result_ty :: wrap_data(Type.Apply(name: "DataTracked", args: [row_ty.clone(), ^key_ty]))
            call_args :: [^rows, typed_lambda_value(lam, ^key)]
            widen_to_vec :: data_widening(&call_args, &[(0, &row_ty)])
            data_plan :: if data_plan_for_core_call(record, &call_args, &result_ty, source_span) == { .Ok(plan) -> plan .Err(error) -> return Val(invariant_violation_expr(source_span, error)) }
            return Val(TExpr{ty: result_ty.clone(), kind: TExprKind.CoreCall(record: record, args: ^call_args, source_span: source_span,
                type_args: [], widen_to_vec: ^widen_to_vec, data_plan: ^data_plan, fallibility: TFailureCarrier.from_checked_type(&result_ty))})
        }
        ("core.data", "inner_join" | "left_join") -> {
            record :: if checked_core_record(module, method, args.len(), source_span) == { .Ok(record) -> record .Err(error) -> return Val(^error) }
            left_arg :: args.first() ?? return Val(invariant_violation_expr(source_span, "checked Core call `{module}.{method}` is missing its left table"))
            right_arg :: args.get(1) ?? return Val(invariant_violation_expr(source_span, "checked Core call `{module}.{method}` is missing its right table"))
            left :: lower_expr(&left_arg.expr, cx, env)
            right :: lower_expr(&right_arg.expr, cx, env)
            left_ty :: if &left.ty == { .List(inner) | .FixedList(elem: inner, ..) -> inner.clone() else -> return Val(invariant_violation_expr(source_span, "checked Core call `{module}.{method}` did not retain its left row type")) }
            right_ty :: if &right.ty == { .List(inner) | .FixedList(elem: inner, ..) -> inner.clone() else -> return Val(invariant_violation_expr(source_span, "checked Core call `{module}.{method}` did not retain its right row type")) }
            left_lam :: if required_lambda(args, 2, module, method, source_span) == { .Ok(lam) -> lam .Err(error) -> return Val(^error) }
            right_lam :: if required_lambda(args, 3, module, method, source_span) == { .Ok(lam) -> lam .Err(error) -> return Val(^error) }
            left_key :: lower_lambda_expecting_value(left_lam, cx, env, &[left_ty.clone()])
            right_key :: lower_lambda_expecting_value(right_lam, cx, env, &[right_ty.clone()])
            call_args :: [^left, ^right, typed_lambda_value(left_lam, ^left_key), typed_lambda_value(right_lam, ^right_key)]
            widen_to_vec :: data_widening(&call_args, &[(0, &left_ty), (1, &right_ty)])
            joined_right :: if method == "left_join" -> Type.Option(^right_ty) else -> ^right_ty
            result_ty :: wrap_data(Type.List(Type.Apply(name: "DataJoin", args: [^left_ty, ^joined_right])))
            return Val(TExpr{ty: result_ty.clone(), kind: TExprKind.CoreCall(record: record, args: ^call_args, source_span: source_span,
                type_args: [], widen_to_vec: ^widen_to_vec, data_plan: None, fallibility: TFailureCarrier.from_checked_type(&result_ty))})
        }
        ("core.data", "pivot_sum") -> {
            record :: if checked_core_record(module, method, args.len(), source_span) == { .Ok(record) -> record .Err(error) -> return Val(^error) }
            rows_arg :: args.first() ?? return Val(invariant_violation_expr(source_span, "checked Core call `core.data.pivot_sum` is missing its table"))
            rows :: lower_expr(&rows_arg.expr, cx, env)
            row_ty :: data_row_ty(&rows.ty) ?? return Val(invariant_violation_expr(source_span, "checked Core call `core.data.pivot_sum` did not retain its row type"))
            row_lam :: if required_lambda(args, 1, module, method, source_span) == { .Ok(lam) -> lam .Err(error) -> return Val(^error) }
            col_lam :: if required_lambda(args, 2, module, method, source_span) == { .Ok(lam) -> lam .Err(error) -> return Val(^error) }
            value_lam :: if required_lambda(args, 3, module, method, source_span) == { .Ok(lam) -> lam .Err(error) -> return Val(^error) }
            row_key :: lower_lambda_expecting_value(row_lam, cx, env, &[row_ty.clone()])
            col_key :: lower_lambda_expecting_value(col_lam, cx, env, &[row_ty.clone()])
            value :: lower_lambda_expecting_value(value_lam, cx, env, &[row_ty.clone()])
            cell :: Type.Named("DataPivotCell")
            call_args :: [^rows, typed_lambda_value(row_lam, ^row_key), typed_lambda_value(col_lam, ^col_key), typed_lambda_value(value_lam, ^value)]
            widen_to_vec :: data_widening(&call_args, &[(0, &row_ty)])
            result_ty :: wrap_data(Type.List(^cell))
            return Val(TExpr{ty: result_ty.clone(), kind: TExprKind.CoreCall(record: record, args: ^call_args, source_span: source_span,
                type_args: [], widen_to_vec: ^widen_to_vec, data_plan: None, fallibility: TFailureCarrier.from_checked_type(&result_ty))})
        }
        ("core.reactive", "derived") -> {
            if args.len() != 1 -> return Val(invariant_violation_expr(source_span, "checked Core call `core.reactive.derived` has the wrong arity"))
            lam :: if required_lambda(args, 0, module, method, source_span) == { .Ok(lam) -> lam .Err(error) -> return Val(^error) }
            body_ty :: lambda_body_ty(lam, cx, env)
            executable :: lower_lambda(lam, cx, env)
            site :: jit_spawn_site(lam, cx, env)
            return Val(TExpr{ty: Type.Apply(name: Syntax.TYPE_DERIVED, args: [^body_ty]), kind: TExprKind.CoreClosureCall(kind: TCoreClosureKind.ReactiveDerived(executable: ^executable, site: site))})
        }
        ("core.reactive", "effect") -> {
            if args.len() != 1 -> return Val(invariant_violation_expr(source_span, "checked Core call `core.reactive.effect` has the wrong arity"))
            lam :: if required_lambda(args, 0, module, method, source_span) == { .Ok(lam) -> lam .Err(error) -> return Val(^error) }
            executable :: lower_lambda_expecting_callable(lam, cx, env, &unit_callback_type())
            site :: jit_spawn_site_unit(lam, cx, env)
            TCoreClosureKind.ReactiveEffect(executable: ^executable, site: site)
        }
        ("core.ui", "reactive_render") -> {
            if args.len() != 1 -> return Val(invariant_violation_expr(source_span, "checked Core call `core.ui.reactive_render` has the wrong arity"))
            lam :: if required_lambda(args, 0, module, method, source_span) == { .Ok(lam) -> lam .Err(error) -> return Val(^error) }
            executable :: lower_lambda_expecting_callable(lam, cx, env, &unit_callback_type())
            site :: jit_spawn_site_unit(lam, cx, env)
            TCoreClosureKind.UiReactiveRender(executable: ^executable, site: site)
        }
        ("core.reactive", "computed") -> {
            if args.len() != 1 -> return Val(invariant_violation_expr(source_span, "checked Core call `core.reactive.computed` has the wrong arity"))
            lam :: if required_lambda(args, 0, module, method, source_span) == { .Ok(lam) -> lam .Err(error) -> return Val(^error) }
            body_ty :: lambda_body_ty(lam, cx, env)
            executable :: lower_lambda(lam, cx, env)
            site :: jit_spawn_site(lam, cx, env)
            return Val(TExpr{ty: Type.Apply(name: Syntax.TYPE_COMPUTED, args: [^body_ty]), kind: TExprKind.CoreClosureCall(kind: TCoreClosureKind.ReactiveDerived(executable: ^executable, site: site))})
        }
        ("core.ui", "preview" | "playground") -> {
            if args.len() < 2 || args.len() > 3 -> return Val(invariant_violation_expr(source_span, "checked Core preview call has the wrong arity"))
            callback_index :: if args.get(1).and_then(fn(arg) { lambda_from_expr(&arg.expr) }) != None -> 1
                else if args.get(2).and_then(fn(arg) { lambda_from_expr(&arg.expr) }) != None -> 2
                else -> return Val(invariant_violation_expr(source_span, "checked Core call `core.ui.{method}` has no callback"))
            name_arg :: args.first().expect("preview arity includes name")
            viewport_index :: if args.len() == 3 -> Val(if callback_index == 1 -> 2 else -> 1) else -> None
            viewport :: if viewport_index == {
                .Val(index) -> lower_optional_core_arg(&args[index], &Type.Named("UIPreviewViewport"), cx, env)
                else -> TExpr{ty: Type.Option(Type.Named("UIPreviewViewport")), kind: TExprKind.Absent}
            }
            lam :: if required_lambda(args, callback_index, module, method, source_span) == { .Ok(lam) -> lam .Err(error) -> return Val(^error) }
            executable :: lower_lambda_expecting_callable(lam, cx, env, &ui_preview_callback_type())
            site :: jit_spawn_site(lam, cx, env)
            return Val(TExpr{ty: Type.Named("UIPreview"), kind: TExprKind.CoreClosureCall(kind: TCoreClosureKind.UiPreview(
                name: lower_owned_expr(&name_arg.expr, cx, env), viewport: Val(^viewport), executable: ^executable, site: site,
                playground: method == "playground", source_file: cx.file.clone(), source_span: source_span,
                source_start_line: cx.src_line_col(source_span.start).0 as U32, source_start_column: cx.src_line_col(source_span.start).1 as U32,
                source_end_line: cx.src_line_col(source_span.end).0 as U32, source_end_column: cx.src_line_col(source_span.end).1 as U32,
                build_id: cx.preview_build_id.clone(), revision: cx.preview_revision.clone()))})
        }
        ("core.ui", "button") -> {
            if args.len() == 1 -> return None
            if args.len() != 4 -> return Val(invariant_violation_expr(source_span, "checked Core UI call has the wrong arity"))
            lam :: if required_lambda(args, 3, module, method, source_span) == { .Ok(lam) -> lam .Err(error) -> return Val(^error) }
            display_arg :: args.first() ?? return Val(invariant_violation_expr(source_span, "checked Core call `core.ui.button` is missing its display text"))
            display :: lower_owned_expr(&display_arg.expr, cx, env)
            shortcut :: lower_optional_core_arg(&args[1], &Type.Named("UIShortcut"), cx, env)
            accessible_label :: lower_optional_core_arg(&args[2], &Type.String, cx, env)
            executable :: lower_lambda_expecting_callable(lam, cx, env, &unit_callback_type())
            site :: jit_spawn_site_unit(lam, cx, env)
            return Val(TExpr{ty: Type.Named("UINode"), kind: TExprKind.CoreClosureCall(kind: TCoreClosureKind.UiButtonOnClick(
                label: ^display, shortcut: ^shortcut, accessible_label: ^accessible_label, executable: ^executable, site: site))})
        }
        ("core.ui", "text_input") -> {
            if args.len() == 2 -> return None
            if args.len() != 3 -> return Val(invariant_violation_expr(source_span, "checked Core UI call has the wrong arity"))
            lam :: if required_lambda(args, 2, module, method, source_span) == { .Ok(lam) -> lam .Err(error) -> return Val(^error) }
            state_arg :: args.first() ?? return Val(invariant_violation_expr(source_span, "checked Core call `core.ui.text_input` is missing its state"))
            ime_arg :: args.get(1) ?? return Val(invariant_violation_expr(source_span, "checked Core call `core.ui.text_input` is missing its IME mode"))
            callback_type :: ui_drop_callback_type()
            state :: lower_owned_expr(&state_arg.expr, cx, env)
            ime :: lower_owned_expr(&ime_arg.expr, cx, env)
            executable :: lower_lambda_expecting_callable(lam, cx, env, &callback_type)
            site :: jit_spawn_site_with(lam, cx, env, fn(lam, cx, env) {
                lower_spawn_lambda_for_jit_expecting(lam, cx, env, &[Type.List(Type.Named("UIDropItem"))])
            })
            return Val(TExpr{ty: Type.Named("UINode"), kind: TExprKind.CoreClosureCall(kind: TCoreClosureKind.UiTextInputOnDrop(state: ^state, ime: ^ime, executable: ^executable, site: site))})
        }
        else -> return None
    }
    Val(TExpr{ty: core_closure_call_return_ty(module, method, unit_type()), kind: TExprKind.CoreClosureCall(kind: ^kind)})
}
