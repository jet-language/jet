use jet_foundation.AST.[Expr, Lambda, Type, CallArg]
use jet_foundation.Diagnostics.[Span]
use jet_foundation.Syntax as Syntax
use jet_codegen.Codegen.Context.[Cx]
use jet_codegen.Codegen.TIR.*
use jet_sema.Sema.[core_call_semantic_signature]
use jet_sema.Collections.[iter_ty]

// Rust: crates/jet-codegen/src/Codegen/TIR/lower/core_calls.rs:30
fn invariant_violation_expr(span: Span, construct: String) -> TExpr Never! {
    TExpr{ty: Type.Named(Syntax.TYPE_NEVER), kind: TExprKind.InvariantViolation(construct: construct, span: span)}
}
// Rust: crates/jet-codegen/src/Codegen/TIR/lower/core_calls.rs:40
fn checked_core_record(module: String, method: String, arity: USize, span: Span) -> &Syntax.CoreCallRecord TExpr! {
    Syntax.core_call_projection(module, method, Syntax.CoreCallCoverage.TIR_SUBSET, arity).map_err(fn(error) {
        invariant_violation_expr(span, "checked Core call `{module}.{method}` has no canonical TIR projection ({error})")
    })
}
// Rust: crates/jet-codegen/src/Codegen/TIR/lower/core_calls.rs:62
fn lambda_from_expr(expr: &Expr) -> &Lambda? Never! {
    if expr == { .Paren(inner, _) -> lambda_from_expr(inner) .Lambda(lam) -> Val(lam) else -> None }
}
// Rust: crates/jet-codegen/src/Codegen/TIR/lower/core_calls.rs:70
fn required_lambda(args: &[CallArg], index: USize, module: String, method: String, span: Span) -> &Lambda TExpr! {
    lam :: args.get(index).and_then(fn(arg) { lambda_from_expr(&arg.expr) }) ?? return Err(invariant_violation_expr(span, "checked Core call `{module}.{method}` has no lambda at argument {index}"))
    Ok(lam)
}
