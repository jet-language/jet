//RS /// The JIT spawn-lambda table index for one source callback.
//RS ///
//RS /// One source lambda is ONE table entry. A lambda body is lowered once per
//RS /// pass — the AOT closure text, the `executable` TIR, and the JIT spawn body —
//RS /// and a callback nested in that body is reached again on every one of them.
//RS /// Pushing per lowering would grow `jit_spawn_lambdas` while
//RS /// `count_spawn_sites` still sees a single site, and the resident tier planner
//RS /// requires those two to be equal (jet-jit `tiers.rs` `spawn_ok`). Keying by
//RS /// `(enclosing fn, lambda span)` keeps that identity true by construction.
//RS ///
//RS /// This is the ONE place a spawn-lambda table entry is minted. `lower` builds
//RS /// the entry and runs only when the key is new, so a nested callback inside
//RS /// this body takes the lower index and is itself minted exactly once.
//RS pub(crate) fn jit_spawn_site_with(
//RS     lam: &Lambda,
//RS     cx: &Cx,
//RS     env: &LowerEnv,
//RS     lower: impl FnOnce(&Lambda, &Cx, &LowerEnv) -> TJitSpawnLambda,
//RS ) -> usize {
//RS     let key = (env.fn_name.clone(), lam.span.start, lam.span.end);
//RS     let existing = cx.jit_spawn_sites.borrow().get(&key).copied();
//RS     if let Some(site) = existing {
//RS         return site;
//RS     }
//RS     let jit_lambda = lower(lam, cx, env);
//RS     let site = cx.jit_spawn_site_base + cx.jit_spawn_lambdas.borrow().len();
//RS     cx.jit_spawn_lambdas.borrow_mut().push(jit_lambda);
//RS     cx.jit_spawn_sites.borrow_mut().insert(key, site);
//RS     site
//RS }
//RS 
//RS /// [`jit_spawn_site_with`] for a callback that needs no parameter seeding.
//RS pub(crate) fn jit_spawn_site(lam: &Lambda, cx: &Cx, env: &LowerEnv) -> usize {
//RS     jit_spawn_site_with(lam, cx, env, lower_spawn_lambda_for_jit)
//RS }
