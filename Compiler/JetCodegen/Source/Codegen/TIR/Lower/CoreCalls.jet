fn unit_callback_type() -> Type Never! {
    Type.Fn(params: [], ret: Val(unit_type()), effect_bound: None, param_contract: None, call_metadata: None, return_view_provenance: None)
}
// Rust: crates/jet-codegen/src/Codegen/TIR/lower/core_calls.rs:96
