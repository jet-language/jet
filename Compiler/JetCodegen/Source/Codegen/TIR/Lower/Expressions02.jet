use jet_codegen.Codegen.TIR.Lower.ControlFlow.[lower_if_let_subject, lower_if_cond, lower_if_cond_atom_cached]
// This private fragment shares Expressions' TLS memo, pointer keys and cache-scope owners.

// Rust: crates/jet-codegen/src/Codegen/TIR/lower/expressions.rs:1803
struct ExprComptimeCacheGuard { scope: ExprCacheScope? }
impl ExprComptimeCacheGuard {
    // Rust: crates/jet-codegen/src/Codegen/TIR/lower/expressions.rs:1808
    fn enter(env: LowerEnv) -> ExprComptimeCacheGuard Never! {
        if env.fn_name != "__ct" -> return ExprComptimeCacheGuard{scope: None}
        // GATE #4494: use the canonical predecessor's real per-thread depth cell.
        nested :: EXPR_COMPTIME_CACHE_DEPTH.with((depth) => {
            nested :: depth.get() > 0
            depth.set(depth.get() + 1)
            nested
        })
        if nested -> return ExprComptimeCacheGuard{scope: None}
        ExprComptimeCacheGuard{scope: Val(ExprCacheScope.enter())}
    }
}
impl ExprComptimeCacheGuard.Drop {
    // Rust: crates/jet-codegen/src/Codegen/TIR/lower/expressions.rs:1827
    fn drop(&self) Never! {
        drop(self.scope.take())
        // GATE #4494: restore the outer memo before decrementing TLS depth.
        EXPR_COMPTIME_CACHE_DEPTH.with((depth) => depth.set(depth.get().saturating_sub(1)))
    }
}
impl ExprCacheOwner.Drop {
    // Rust: crates/jet-codegen/src/Codegen/TIR/lower/expressions.rs:1837
    fn drop(&self) Never! { if self.owns_cache { expr_cache_end() } }
}

// Rust: crates/jet-codegen/src/Codegen/TIR/lower/expressions.rs:1844
fn expr_cache_take(expr: Expr, cx: Cx) -> TExpr? Never! {
    // GATE #4494: actual TLS RefCell, same cache as the canonical Expressions owner.
    EXPR_WORKLIST_CACHE.with((cell) => {
        cache := cell.borrow_mut()
        if !cache.active -> return None
        key :: expr_key(expr, cx)
        value :: cache.values.get_mut(key).and_then((values) => values.pop_front())
        if cache.values.get(key).is_some_and((values) => values.is_empty()) { cache.values.remove(key) }
        value
    })
}
// Rust: crates/jet-codegen/src/Codegen/TIR/lower/expressions.rs:1866
fn expr_cache_put(expr: Expr, value: ^TExpr, cx: Cx) Never! {
    // GATE #4494
    EXPR_WORKLIST_CACHE.with((cell) => {
        cache := cell.borrow_mut()
        cache.types.insert(expr_key(expr, cx), ~value.ty)
        cache.values.entry(expr_key(expr, cx)).or_default().push_back(^value)
    })
}
// Rust: crates/jet-codegen/src/Codegen/TIR/lower/expressions.rs:1878
fn expr_cache_type(expr: Expr, cx: Cx) -> Type? Never! {
    stripped :: strip_expr_parens(expr)
    // GATE #4494
    EXPR_WORKLIST_CACHE.with((cell) => {
        cache :: cell.borrow()
        if !cache.active -> return None
        cache.types.get(expr_key(stripped, cx)).map((ty) => ~ty)
    })
}
// Rust: crates/jet-codegen/src/Codegen/TIR/lower/expressions.rs:1889
fn expr_cache_put_method_sig(expr: Expr, sig: ^[(AccessConvention, Type)], cx: Cx) Never! {
    // GATE #4494; #4499 preserves the predecessor's exact pointer/context key equality.
    EXPR_WORKLIST_CACHE.with((cell) => cell.borrow_mut().method_sigs.entry(expr_key(expr, cx)).or_default().push_back(^sig))
}
// Rust: crates/jet-codegen/src/Codegen/TIR/lower/expressions.rs:1900
fn expr_cache_take_method_sig(expr: Expr, cx: Cx) -> [(AccessConvention, Type)]? Never! {
    // GATE #4494
    EXPR_WORKLIST_CACHE.with((cell) => {
        cache := cell.borrow_mut()
        if !cache.active -> return None
        key :: expr_key(expr, cx)
        sig :: cache.method_sigs.get_mut(key).and_then((sigs) => sigs.pop_front())
        if cache.method_sigs.get(key).is_some_and((sigs) => sigs.is_empty()) { cache.method_sigs.remove(key) }
        sig
    })
}
// Rust: crates/jet-codegen/src/Codegen/TIR/lower/expressions.rs:1922
pub fn take_scheduled_expr(expr: Expr, cx: Cx) -> TExpr? Never! {
    if expr_cache_take(expr, cx) == .Val(value) -> return Val(^value)
    stripped :: strip_expr_parens(expr)
    // GATE #4494: node identity, not structural equality; never clone the AST here.
    if !std.ptr.eq(expr, stripped) -> return expr_cache_take(stripped, cx)
    None
}
// Rust: crates/jet-codegen/src/Codegen/TIR/lower/expressions.rs:1934
pub fn lower_cached_expr(expr: Expr, cx: Cx, _env: &LowerEnv) -> TExpr Never! {
    take_scheduled_expr(strip_expr_parens(expr), cx).expect("condition child missing from expression worklist")
}

// Rust: crates/jet-codegen/src/Codegen/TIR/lower/expressions.rs:1941
fn plain_expr_children(expr: Expr) -> [@Expr] Never! from expr {
    if expr == {
        .Str(parts, _) -> {
            children := [@Expr]{}
            loop part in parts { if part == .Interp(inner, _) { children.push(@inner) } }
            ^children
        }
        .ListLit(items, _) -> {
            children := [@Expr]{}
            loop item in items { if item == { .Spread(inner, _) -> children.push(@inner) else -> children.push(@item) } }
            ^children
        }
        .MemberSpread{base, ..} -> [@base]
        .Spread(inner, _) | .Unary(_, inner, _) | .Deref(inner, _) | .RawOf(inner, _) | .Copy(inner, _) | .Tainted(inner, _, _) | .Present(inner, _) | .Ok(inner, _) | .Err(inner, _) -> [@inner]
        .Try(inner, _, _, note) -> {
            children := [@Expr]{@inner}
            if note == .Val(value) { children.push(@value) }
            ^children
        }
        .MapLit(entries, _) -> {
            children := [@Expr]{}
            loop (key, value) in entries { children.push(@key); children.push(@value) }
            ^children
        }
        .Index{base, index, ..} -> [@base, @index]
        .Slice{base, start, end, range, ..} -> if range == { .Val(value) -> [@base, @value] .None -> [@base, @start, @end] }
        .Range{start, end, ..} -> [@start, @end]
        .Binary(_, left, right, _) -> [@left, @right]
        .CompareChain{operands, ..} -> operands.iter().map((value) => @value).collect()
        .Place(inner, _, _) -> if inner == {
            .Slice{base, start, end, range, ..} -> if range == { .Val(value) -> [@base, @value] .None -> [@base, @start, @end] }
            else -> [@inner]
        }
        .Field(receiver, _, _) -> if receiver == { .Index{base, index, ..} -> [@base, @index] else -> [@receiver] }
        .OptField{base, ..} -> [@base]
        .StructLit{fields, ..} -> fields.iter().map((field) => @field.2).collect()
        .EnumLit{args, ..} -> args.iter().map((arg) => if arg == { .Positional(value) -> @value .Named{expr: value, ..} -> @value }).collect()
        .PatternTest{subject, ..} -> [@subject]
        .Call(_) | .CallValue{..} | .MethodCall{..} -> []
        .TypedLit{body, ..} -> {
            children := [@Expr]{}
            if body == {
                .Fields(fields) -> { loop (_, _, value) in fields { children.push(@value) } }
                .Elements(elements) -> { loop value in elements { children.push(@value) } }
                .Entries(entries) -> { loop (key, value) in entries { children.push(@key); children.push(@value) } }
                .Value(value) -> children.push(@value)
                .ByteText(_) | .Empty -> {}
            }
            ^children
        }
        // Contextual err is installed only by lower_or_fallback, not a strict child.
        .OrFallback{value, ..} -> [@value]
        .If{cond, ..} -> [@cond]
        .Lambda(_) -> []
        .TupleLit(fields, _, _) -> fields.iter().map((field) => @field.1).collect()
        .PtrFromAddr{addr, ..} -> [@addr]
        .Paren(inner, _) -> [@inner]
        .StrMatchLit(..) | .BinMatchLit(..) | .Int(..) | .Float(..) | .Bool(..) | .Unit(..) | .Char(..) | .Ident(..) | .UnitLit{..} | .ComptimeName{..} | .Absent(_) | .Todo{..} | .NoElse(_) | .ReduceMarker(..) -> []
    }
}

// Rust: crates/jet-codegen/src/Codegen/TIR/lower/expressions.rs:2084
// GATE #4500: work items retain borrowed AST nodes, never copies or structural keys.
enum ExprArgMode { Plain Convention(slot: (AccessConvention, Type)?) CallValue(callee: @Expr, index: Int) }
// Rust: crates/jet-codegen/src/Codegen/TIR/lower/expressions.rs:2090
struct ExprWorkArg { arg: @CallArg, mode: ExprArgMode }
// Rust: crates/jet-codegen/src/Codegen/TIR/lower/expressions.rs:2095
enum ExprWorkChild { Expr(expr: @Expr) Arg(arg: ExprWorkArg) }
// Rust: crates/jet-codegen/src/Codegen/TIR/lower/expressions.rs:2100
fn source_arg_indices(args: [CallArg]) -> [Int] Never! {
    order := source_arg_order(args) ?? return (0..<args.len()).collect<[Int]>()
    seen := [Bool].filled(args.len(), false)
    indices := [Int]{}
    loop index in order { seen[index] = true; indices.push(index) }
    loop (index, marked) in seen.enumerate() { if !marked { indices.push(index) } }
    ^indices
}
// Rust: crates/jet-codegen/src/Codegen/TIR/lower/expressions.rs:2123
fn checked_direct_call_sig(call: Call, cx: Cx) -> [(AccessConvention, Type)]? Never! {
    sig := cx.sigs.get(call.name) ?? return None
    order := cx.fn_type_param_order.get(call.name) ?? return Val(~sig)
    if order.is_empty() || order.len() != call.type_args.len() -> return Val(~sig)
    subst := [String:Type]{}
    loop (param, actual) in order.iter().zip(call.type_args.iter()) { subst.insert(param, ~actual) }
    Val(sig.iter().map((slot) => (slot.0, Generics.substitute_type(slot.1, subst))).collect())
}
// Rust: crates/jet-codegen/src/Codegen/TIR/lower/expressions.rs:2146
fn direct_call_conventions(call: Call, cx: Cx, env: LowerEnv) -> [(AccessConvention, Type)]? Never! {
    if env.locals.contains_key(call.name) && !cx.consts.contains_key(call.name) {
        if env.ty_of(call.name) == { .Val(.Fn{params, ..}) -> Val(params.iter().map((ty) => (.Read, ~ty)).collect()) else -> Val([]) }
    } else {
        if checked_direct_call_sig(call, cx) == .Val(sig) -> return Val(^sig)
        inline_mangled :: cx.inline_unqualified.get(env.fn_name).and_then((scope) => scope.get(call.name)).or_else(() => cx.unqualified_inline.get(call.name))
        if inline_mangled == .Val(mangled) -> return cx.sigs.get(mangled).map((sig) => ~sig)
        inline_file :: cx.inline_unqualified_file.get(env.fn_name).and_then((scope) => scope.get(call.name)).or_else(() => cx.unqualified_file.get(call.name))
        inline_file.and_then((entry) => cx.import_sigs.get((call.name, entry.1)).map((sig) => ~sig))
    }
}
// Rust: crates/jet-codegen/src/Codegen/TIR/lower/expressions.rs:2186
fn method_arg_mode(sig: [(AccessConvention, Type)]?, index: Int) -> ExprArgMode Never! {
    if sig == { .Val(slots) -> .Convention(slots.get(index).map((slot) => ~slot)) .None -> .Plain }
}
// Rust: crates/jet-codegen/src/Codegen/TIR/lower/expressions.rs:2191
fn method_arg_contract(method: String, recv_type: String?, owner_type_args: [Type], type_args: [Type], cx: Cx) -> [(AccessConvention, Type)]? Never! {
    ty := recv_type ?? return None
    sig := cx.method_sigs.get((ty, method)) ?? return None
    Val(instantiate_method_sig(cx, ty, method, sig, owner_type_args, type_args))
}
// Rust: crates/jet-codegen/src/Codegen/TIR/lower/expressions.rs:2210
fn inline_loop_body(expr: Expr) -> View<Stmt>? Never! from expr {
    if expr == .CallValue{callee, args, ..} {
        if !args.is_empty() -> return None
        if callee == .Lambda(lam) {
            if !(lam.meta.collecting_loop || lam.meta.result_loop) -> return None
            if lam.body == .Block(body) -> return Val(body.view())
        }
    }
    None
}
// Rust: crates/jet-codegen/src/Codegen/TIR/lower/expressions.rs:2229
fn expr_children(expr: Expr, cx: Cx, env: LowerEnv) -> [ExprWorkChild] Never! from expr {
    if expr == {
        .Call(call) -> {
            if call.name == "apply" && !cx.sigs.contains_key(call.name) && !env.locals.contains_key(call.name) && call.args.last().is_some_and((arg) => arg.flags.callable_policy.is_some()) -> return [.Arg(ExprWorkArg{arg: @call.args.last().expect("policy has final callable"), mode: .Plain})]
            conventions :: direct_call_conventions(call, cx, env)
            source_arg_indices(call.args).iter().map((index) => .Arg(ExprWorkArg{arg: @call.args[index], mode: method_arg_mode(conventions, index)})).collect()
        }
        .CallValue{callee, args, ..} -> {
            children := [ExprWorkChild]{}
            if inline_loop_body(expr).is_none() {
                children.push(.Expr(@callee))
                loop index in source_arg_indices(args) { children.push(.Arg(ExprWorkArg{arg: @args[index], mode: .CallValue(@callee, index)})) }
            }
            ^children
        }
        .MethodCall{..} -> {
            calls := [@Expr]{}
            cursor := @expr
            loop {
                if cursor == .MethodCall{receiver, ..} { calls.push(cursor); cursor = @receiver } else { break }
            }
            children := [ExprWorkChild]{.Expr(cursor)}
            loop call in calls.iter().rev() {
                if call == .MethodCall{method, owner_type_args, type_args, args, recv_type, ..} {
                    contract :: method_arg_contract(method, recv_type, owner_type_args, type_args, cx)
                    if contract == .Val(sig) { expr_cache_put_method_sig(call, ~sig, cx) }
                    loop index in source_arg_indices(args) { children.push(.Arg(ExprWorkArg{arg: @args[index], mode: method_arg_mode(contract, index)})) }
                } else { panic("method chain contains only method calls") }
            }
            ^children
        }
        else -> plain_expr_children(expr).iter().map((child) => .Expr(child)).collect()
    }
}

// Rust: crates/jet-codegen/src/Codegen/TIR/lower/expressions.rs:2325
enum ExprWork {
    Enter(expr: @Expr) EnterArg(arg: ExprWorkArg) Build(expr: @Expr) BuildArg(arg: ExprWorkArg)
    LowerInlineLoop(expr: @Expr, body: View<Stmt>) BuildIf(expr: @Expr)
    LowerIfCondition(state: ExprIfConditionWork) LowerIfThenBody(state: ExprIfWork)
    LowerIfThenValue(state: ExprIfWork) LowerIfElseBody(state: ExprIfWork) LowerIfElseValue(state: ExprIfWork)
}
// Rust: crates/jet-codegen/src/Codegen/TIR/lower/expressions.rs:2339
struct ExprIfConditionWork {
    expr: @Expr, then_body: View<Stmt>, then_value: @Expr, else_body: View<Stmt>, else_value: @Expr,
    terms: [@Expr], next: Int, lowered: [TIfCond], bindings: [(String, TLocal, Type?)], prefixes: [TStmt], base_env: LowerEnv
}
// Rust: crates/jet-codegen/src/Codegen/TIR/lower/expressions.rs:2353
struct ExprIfWork {
    expr: @Expr, condition: TIfCond, then_prefix: [TStmt], then_body: View<Stmt>, then_value: @Expr,
    else_body: View<Stmt>, else_value: @Expr, base_env: LowerEnv, then_env: LowerEnv?, then_lowered: [TStmt], then_value_lowered: TExpr?, else_lowered: [TStmt]
}
// Rust: crates/jet-codegen/src/Codegen/TIR/lower/expressions.rs:2368
struct ResultHandlerAst {
    subject: @Expr, ok_pattern: @Pattern, ok_body: View<Stmt>, ok_value: @Expr,
    err_pattern: @Pattern, err_body: View<Stmt>, err_value: @Expr, terminal: @Expr, ok_cond_span: Span, err_cond_span: Span
}
// Rust: crates/jet-codegen/src/Codegen/TIR/lower/expressions.rs:2384
fn result_handler_ast(expr: Expr) -> ResultHandlerAst? Never! from expr {
    if expr == .If{cond: ok_cond, then_body: ok_body, then_value: ok_value, else_body: outer_else_body, else_value: outer_else_value, ..} {
        if !outer_else_body.is_empty() -> return None
        if ok_cond == .PatternTest{subject: ok_subject, pattern: ok_pattern, span: ok_cond_span} {
            if !(if ok_pattern == { .Ok{..} -> true else -> false }) -> return None
            if outer_else_value == .If{cond: err_cond, then_body: err_body, then_value: err_value, else_body: err_else_body, else_value: terminal, ..} {
                if !err_else_body.is_empty() -> return None
                if !(if terminal == { .NoElse(_) -> true else -> false }) -> return None
                if err_cond == .PatternTest{subject: err_subject, pattern: err_pattern, span: err_cond_span} {
                    if !(if err_pattern == { .Err{..} -> true else -> false }) -> return None
                    if ok_subject.span() != err_subject.span() -> return None
                    return Val(ResultHandlerAst{subject: @ok_subject, ok_pattern: @ok_pattern, ok_body: ok_body.view(), ok_value: @ok_value, err_pattern: @err_pattern, err_body: err_body.view(), err_value: @err_value, terminal: @terminal, ok_cond_span: ok_cond_span, err_cond_span: err_cond_span})
                }
            }
        }
    }
    None
}
// Rust: crates/jet-codegen/src/Codegen/TIR/lower/expressions.rs:2450
fn result_handler_pattern(cond: ^TIfCond) -> TPattern Never! {
    if cond == { .IfLet{pattern, ..} -> ^pattern else -> panic("checked Result handler must bind an Ok or Err pattern") }
}
// Rust: crates/jet-codegen/src/Codegen/TIR/lower/expressions.rs:2457
fn lower_result_handler_expr(expr: Expr, cx: Cx, env: &LowerEnv) -> TExpr? Never! {
    shape := result_handler_ast(expr) ?? return None
    base_env :: clone_env(env)
    fallback_subject :: env.fallback_subject
    env.fallback_subject = true
    subject :: lower_if_let_subject(shape.subject, cx, &env, false)
    env.fallback_subject = fallback_subject
    temp :: "{generated_prefix()}result_handler_{shape.subject.span().start}"
    temp_local :: TLocal.generated(temp)
    handler_env := clone_env(env)
    handler_env.bind(temp, temp_local, Val(~subject.ty))
    ok_cond_expr :: Expr.PatternTest{subject: .Ident(temp, shape.subject.span()), pattern: ~shape.ok_pattern, span: shape.ok_cond_span}
    ok_env := clone_env(handler_env)
    (ok_cond, ok_bindings, ok_body) := lower_if_cond(ok_cond_expr, cx, &ok_env)
    loop (name, place, ty) in ok_bindings {
        ok_env.bind(name, ^place, ~ty)
        if ty == .Val(.Named(type_name)) { if cx.has_close_type(type_name) { ok_env.mark_resource(name) } }
    }
    ok_body.extend(lower_stmts(shape.ok_body, cx, &ok_env))
    ok_value :: lower_owned_expr(shape.ok_value, cx, &ok_env)
    err_cond_expr :: Expr.PatternTest{subject: .Ident(temp, shape.err_cond_span), pattern: ~shape.err_pattern, span: shape.err_cond_span}
    err_env := clone_env(handler_env)
    (err_cond, err_bindings, err_body) := lower_if_cond(err_cond_expr, cx, &err_env)
    loop (name, place, ty) in err_bindings {
        err_env.bind(name, ^place, ~ty)
        if ty == .Val(.Named(type_name)) { if cx.has_close_type(type_name) { err_env.mark_resource(name) } }
    }
    err_body.extend(lower_stmts(shape.err_body, cx, &err_env))
    err_value :: lower_owned_expr(shape.err_value, cx, &err_env)
    terminal :: lower_expr(shape.terminal, cx, &handler_env)
    inner_ty :: tir_if_join_type(tir_if_branch_reaches_merge(err_body, err_value), err_value.ty, tir_expr_reaches_merge(terminal), terminal.ty)
    inner_reaches :: tir_if_branch_reaches_merge(err_body, err_value) || tir_expr_reaches_merge(terminal)
    outer_ty :: tir_if_join_type(tir_if_branch_reaches_merge(ok_body, ok_value), ok_value.ty, inner_reaches, inner_ty)
    lowered :: TExpr{ty: outer_ty, kind: .ResultHandler{subject: ^subject, ok_pattern: result_handler_pattern(^ok_cond), ok_body: ^ok_body, ok_value: ^ok_value, err_pattern: result_handler_pattern(^err_cond), err_body: ^err_body, err_value: ^err_value, terminal: ^terminal}}
    env = ^base_env
    Val(canonicalize_pre_tier_expr(^lowered))
}

// Rust: crates/jet-codegen/src/Codegen/TIR/lower/expressions.rs:2545
fn dispatch_condition_subject(expr: Expr) -> (@Expr)? Never! from expr {
    if expr.without_parens() == {
        .PatternTest{subject, ..} -> Val(@subject)
        .Binary(op, left, right, _) -> {
            if op.is_comparison() -> return Val(@left)
            if op == .And || op == .Or -> return dispatch_condition_subject(left).or_else(() => dispatch_condition_subject(right))
            None
        }
        else -> None
    }
}
// Rust: crates/jet-codegen/src/Codegen/TIR/lower/expressions.rs:2556
fn replace_dispatch_subject(expr: Expr, subject_span: Span, replacement: Expr) -> Expr Never! {
    if expr == {
        .PatternTest{subject, pattern, span} -> if subject.span() == subject_span -> .PatternTest{subject: ~replacement, pattern: ~pattern, span: span} else -> ~expr
        .Binary(op, left, right, span) -> {
            if op.is_comparison() && left.span() == subject_span -> return .Binary(op, ~replacement, ~right, span)
            if op == .And || op == .Or -> return .Binary(op, replace_dispatch_subject(left, subject_span, replacement), replace_dispatch_subject(right, subject_span, replacement), span)
            ~expr
        }
        else -> ~expr
    }
}
// Rust: crates/jet-codegen/src/Codegen/TIR/lower/expressions.rs:2585
fn discarded_dispatch_subject(expr: Expr) -> (@Expr)? Never! from expr {
    if result_handler_ast(expr).is_some() -> return None
    if expr.without_parens() == .If{cond, else_value, ..} {
        subject := dispatch_condition_subject(cond) ?? return None
        subject_span :: subject.span()
        matched := 1
        tail := @else_value.without_parens()
        loop {
            if tail == .If{cond: next_cond, else_value: next_else, ..} {
                next_subject := dispatch_condition_subject(next_cond) ?? break
                if next_subject.span() != subject_span -> break
                matched += 1
                tail = @next_else.without_parens()
            } else { break }
        }
        if matched >= 2 -> return Val(subject)
    }
    None
}
// Rust: crates/jet-codegen/src/Codegen/TIR/lower/expressions.rs:2619
fn lower_value_dispatch_expr(expr: Expr, cx: Cx, env: &LowerEnv) -> TExpr? Never! {
    subject := discarded_dispatch_subject(expr) ?? return None
    if dispatch_subject_is_place(subject) -> return None
    subject_span :: subject.span()
    name :: "{generated_prefix()}switch_subject_{subject_span.start}"
    local :: Expr.Ident(name, subject_span)
    arms := [@Expr]{}
    tail := @expr.without_parens()
    loop {
        if tail == .If{cond, else_value, ..} {
            if dispatch_condition_subject(cond).map((subject) => subject.span()) != Val(subject_span) -> break
            arms.push(tail)
            tail = @else_value.without_parens()
        } else { break }
    }
    carrier :: arms.iter().any((arm) => if arm == { .If{cond, ..} -> if dispatch_condition_pattern(cond) == { .Val(.Ok{..}) | .Val(.Err{..}) -> true else -> false } else -> false })
    table := ~tail
    loop arm in arms.iter().rev() {
        if arm == .If{cond, then_body, then_value, else_body, span, ..} {
            table = .If{cond: replace_dispatch_subject(cond, subject_span, local), then_body: ~then_body, then_value: ~then_value, else_body: ~else_body, else_value: ^table, span: span}
        } else { panic("dispatch arms are if expressions") }
    }
    cache_scope :: ExprCacheScope.enter()
    fallback_subject :: env.fallback_subject
    env.fallback_subject = carrier || fallback_subject
    init :: lower_if_let_subject(subject, cx, &env, false)
    env.fallback_subject = fallback_subject
    ty :: ~init.ty
    env.bind(name, TLocal.generated(name), Val(~ty))
    lowered :: lower_expr(table, cx, &env)
    if lowered.kind == {
        .IfExpr{cond, then_body, then_value, else_body, else_value} -> Val(TExpr{ty: ^lowered.ty, kind: .IfExpr{cond: .WithPrelude{prelude: [.Let{name: name, kw: "let", let_ty: TLetTy.plain(^ty), init: ^init, gc_promotion: None, gc_transferred: false}], cond: ^cond}, then_body: ^then_body, then_value: ^then_value, else_body: ^else_body, else_value: ^else_value}})
        else -> panic("a value dispatch table lowers to an if expression")
    }
}
// Rust: crates/jet-codegen/src/Codegen/TIR/lower/expressions.rs:2712
fn dispatch_condition_pattern(expr: Expr) -> (@Pattern)? Never! from expr {
    if expr.without_parens() == {
        .PatternTest{pattern, ..} -> Val(@pattern)
        .Binary(op, left, right, _) -> if op == .And || op == .Or -> dispatch_condition_pattern(left).or_else(() => dispatch_condition_pattern(right)) else -> None
        else -> None
    }
}
// Rust: crates/jet-codegen/src/Codegen/TIR/lower/expressions.rs:2723
fn dispatch_subject_is_place(subject: Expr) -> Bool Never! {
    cursor := @subject
    loop {
        if cursor.without_parens() == {
            .Ident(..) -> return true
            .Field(base, _, _) | .Copy(base, _) -> cursor = @base
            else -> return false
        }
    }
}
// Rust: crates/jet-codegen/src/Codegen/TIR/lower/expressions.rs:2733
enum DiscardedExprWork {
    Enter(expr: @Expr, env: LowerEnv)
    FinishIf(cond: TIfCond, then_body: [TStmt], else_body: [TStmt]?)
    FinishResultHandler(subject: TExpr, ok_cond: TIfCond, ok_body: [TStmt], err_cond: TIfCond, err_body: [TStmt])
}
// Rust: crates/jet-codegen/src/Codegen/TIR/lower/expressions.rs:2752
fn is_single_if_body(body: [TStmt]) -> Bool Never! { body.len() == 1 && (if body.first() == { .Val(.If{..}) -> true else -> false }) }
// Rust: crates/jet-codegen/src/Codegen/TIR/lower/expressions.rs:2760
pub fn lower_discarded_expr(e: Expr, cx: Cx, env: &LowerEnv) -> TStmt Never! {
    root :: e.without_parens()
    root_env := clone_env(env)
    dispatch :: discarded_dispatch_subject(root).map((subject) => {
        name :: "{generated_prefix()}switch_subject"
        init :: lower_expr(subject, cx, &root_env)
        ty :: ~init.ty
        root_env.bind(name, TLocal.generated(name), Val(~ty))
        (name, subject.span(), ^ty, ^init)
    })
    dispatch_cache_scope :: dispatch.map((_) => ExprCacheScope.enter())
    work := TirWorklist<DiscardedExprWork>.new()
    lowered := [TStmt]{}
    work.push(.Enter(@root, ^root_env))
    loop {
        task := work.pop() ?? break
        if task == {
            .Enter(expr, branch_env) -> {
                expr :: expr.without_parens()
                if result_handler_ast(expr) == .Val(shape) {
                    cache_scope :: ExprCacheScope.enter()
                    fallback_subject :: branch_env.fallback_subject
                    branch_env.fallback_subject = true
                    subject :: lower_if_let_subject(shape.subject, cx, &branch_env, false)
                    branch_env.fallback_subject = fallback_subject
                    temp :: "{generated_prefix()}result_handler_{shape.subject.span().start}"
                    handler_env := clone_env(branch_env)
                    handler_env.bind(temp, TLocal.generated(temp), Val(~subject.ty))
                    ok_cond_expr :: Expr.PatternTest{subject: .Ident(temp, shape.subject.span()), pattern: ~shape.ok_pattern, span: shape.ok_cond_span}
                    ok_env := clone_env(handler_env)
                    (ok_cond, ok_bindings, ok_body) := lower_if_cond(ok_cond_expr, cx, &ok_env)
                    loop (name, place, ty) in ok_bindings {
                        ok_env.bind(name, ^place, ~ty)
                        if ty == .Val(.Named(type_name)) { if cx.has_close_type(type_name) { ok_env.mark_resource(name) } }
                    }
                    ok_body.extend(lower_stmts(shape.ok_body, cx, &ok_env))
                    err_cond_expr :: Expr.PatternTest{subject: .Ident(temp, shape.err_cond_span), pattern: ~shape.err_pattern, span: shape.err_cond_span}
                    err_env := clone_env(handler_env)
                    (err_cond, err_bindings, err_body) := lower_if_cond(err_cond_expr, cx, &err_env)
                    loop (name, place, ty) in err_bindings {
                        err_env.bind(name, ^place, ~ty)
                        if ty == .Val(.Named(type_name)) { if cx.has_close_type(type_name) { err_env.mark_resource(name) } }
                    }
                    err_body.extend(lower_stmts(shape.err_body, cx, &err_env))
                    work.push(.FinishResultHandler(^subject, ^ok_cond, ^ok_body, ^err_cond, ^err_body))
                    work.push(.Enter(shape.terminal, clone_env(handler_env)))
                    work.push(.Enter(shape.err_value, ^err_env))
                    work.push(.Enter(shape.ok_value, ^ok_env))
                    next
                }
                if expr == .If{cond, then_body, then_value, else_body, else_value, ..} {
                    then_env := clone_env(branch_env)
                    replaced_cond :: dispatch.and_then((entry) => {
                        subject := dispatch_condition_subject(cond) ?? return None
                        if subject.span() != entry.1 -> return None
                        Val(replace_dispatch_subject(cond, entry.1, .Ident(entry.0, entry.1)))
                    })
                    condition :: replaced_cond ?? cond
                    (tir_cond, bindings, then_lowered) := lower_if_cond(condition, cx, &then_env)
                    loop (name, place, ty) in bindings { then_env.bind(name, ^place, ^ty) }
                    then_lowered.extend(lower_stmts(then_body, cx, &then_env))
                    else_lowered := None as [TStmt]?
                    else_env := None as LowerEnv?
                    no_else :: if else_value.without_parens() == { .NoElse(_) -> true else -> false }
                    if !(else_body.is_empty() && no_else) {
                        alternate := clone_env(branch_env)
                        else_lowered = Val(lower_stmts(else_body, cx, &alternate))
                        else_env = Val(^alternate)
                    }
                    work.push(.FinishIf(^tir_cond, ^then_lowered, ^else_lowered))
                    if else_env == .Val(alternate) { work.push(.Enter(@else_value, ^alternate)) }
                    work.push(.Enter(@then_value, ^then_env))
                } else {
                    lowered.push(.ExprStmt(lower_expr(expr, cx, &branch_env)))
                }
            }
            .FinishIf(cond, then_body, else_body) -> {
                alternate := None as [TStmt]?
                else_is_elseif := false
                if else_body == .Val(body) {
                    else_value :: lowered.pop().expect("discarded if else tail was lowered")
                    then_value :: lowered.pop().expect("discarded if then tail was lowered")
                    then_body.push(^then_value)
                    body.push(^else_value)
                    else_is_elseif = is_single_if_body(body)
                    alternate = Val(^body)
                } else { then_body.push(lowered.pop().expect("discarded if then tail was lowered")) }
                lowered.push(.If{cond: ^cond, then_body: ^then_body, else_body: ^alternate, else_is_elseif: else_is_elseif})
            }
            .FinishResultHandler(subject, ok_cond, ok_body, err_cond, err_body) -> {
                terminal :: lowered.pop().expect("discarded Result handler terminal was lowered")
                err_value :: lowered.pop().expect("discarded Result handler failure tail was lowered")
                ok_value :: lowered.pop().expect("discarded Result handler success tail was lowered")
                ok_body.push(^ok_value); err_body.push(^err_value)
                if terminal == .ExprStmt(value) {
                    lowered.push(.ExprStmt(canonicalize_pre_tier_expr(TExpr{ty: unit_type(), kind: .ResultHandler{subject: ^subject, ok_pattern: result_handler_pattern(^ok_cond), ok_body: ^ok_body, ok_value: TExpr{ty: unit_type(), kind: .Unit}, err_pattern: result_handler_pattern(^err_cond), err_body: ^err_body, err_value: TExpr{ty: unit_type(), kind: .Unit}, terminal: ^value}})))
                } else { panic("discarded Result handler terminal must lower to an expression") }
            }
        }
    }
    root :: lowered.pop().expect("discarded expression worklist lost its root")
    (name, _, ty, init) := dispatch ?? return ^root
    if root == {
        .If{cond, then_body, else_body, else_is_elseif} -> .If{cond: .WithPrelude{prelude: [.Let{name: ^name, kw: "let", let_ty: TLetTy.plain(^ty), init: ^init, gc_promotion: None, gc_transferred: false}], cond: ^cond}, then_body: ^then_body, else_body: ^else_body, else_is_elseif: else_is_elseif}
        else -> panic("discarded dispatch root must lower to an if statement")
    }
}

// Rust: crates/jet-codegen/src/Codegen/TIR/lower/expressions.rs:3021
fn condition_terms(cond: Expr) -> [@Expr] Never! from cond {
    work := TirWorklist<@Expr>.new()
    work.push(@cond)
    terms := [@Expr]{}
    loop {
        term := work.pop() ?? break
        if term == .Binary(.And, left, right, _) { work.push(@right); work.push(@left) } else { terms.push(term) }
    }
    ^terms
}
// Rust: crates/jet-codegen/src/Codegen/TIR/lower/expressions.rs:3036
fn push_expr_children(work: &[ExprWork], children: ^[ExprWorkChild]) Never! {
    loop child in children.into_iter().rev() {
        if child == { .Expr(value) -> work.push(.Enter(@strip_expr_parens(value))) .Arg(arg) -> work.push(.EnterArg(^arg)) }
    }
}
// Rust: crates/jet-codegen/src/Codegen/TIR/lower/expressions.rs:3048
fn push_expr_condition_atom(work: &[ExprWork], expr: @Expr, cx: Cx, env: LowerEnv) Never! {
    if expr == .PatternTest{..} { push_expr_children(&work, expr_children(expr, cx, env)) } else { push_expr_work(&work, expr, cx, env) }
}
// Rust: crates/jet-codegen/src/Codegen/TIR/lower/expressions.rs:3061
fn push_expr_work(work: &[ExprWork], expr: @Expr, cx: Cx, env: LowerEnv) Never! {
    stripped :: strip_expr_parens(expr)
    if inline_loop_body(stripped) == .Val(body) { work.push(.LowerInlineLoop(@stripped, body)) }
    else if stripped == .If{..} { work.push(.BuildIf(@stripped)) }
    else { work.push(.Build(@stripped)); push_expr_children(&work, expr_children(stripped, cx, env)) }
}
// Rust: crates/jet-codegen/src/Codegen/TIR/lower/expressions.rs:3073
fn lower_expr_segment(root: Expr, cx: Cx, env: &LowerEnv) -> TExpr Never! {
    root :: strip_expr_parens(root)
    work := [ExprWork]{.Enter(@root)}
    loop {
        task := work.pop() ?? break
        if task == {
            .Enter(expr) -> push_expr_work(&work, @strip_expr_parens(expr), cx, env)
            .Build(expr) -> expr_cache_put(expr, lower_expr_node(expr, cx, &env), cx)
            .EnterArg(arg) -> {
                expr :: strip_expr_parens(arg.arg.expr)
                has_binder_refs :: !arg.arg.flags.binder_refs.is_empty()
                work.push(.BuildArg(^arg))
                if has_binder_refs || env.fallback_subject -> next
                if inline_loop_body(expr) == .Val(body) { work.push(.LowerInlineLoop(@expr, body)) }
                else if expr == .If{..} { work.push(.BuildIf(@expr)) }
                else { push_expr_children(&work, expr_children(expr, cx, env)) }
            }
            .BuildArg(arg) -> {
                if strip_expr_parens(arg.arg.expr) == .Lambda(_) -> next
                lower_value :: (active_env: &LowerEnv) => {
                    if arg.mode == {
                        .Plain -> lower_expr(arg.arg.expr, cx, &active_env)
                        .Convention(conv) -> lower_call_arg_value(arg.arg, ~conv, &active_env, cx)
                        .CallValue(callee, index) -> {
                            callee_ty :: expr_cache_type(callee, cx).or_else(() => Val(lower_expr(callee, cx, &active_env).ty))
                            conv :: callee_ty.and_then((ty) => if ty.with_effective_fn_returns() == { .Fn{params, ..} -> params.get(index).map((ty) => (.Read, ~ty)) else -> None })
                            lower_call_arg_value(arg.arg, conv, &active_env, cx)
                        }
                    }
                }
                value :: if env.fallback_subject {
                    arg_cache_scope :: ExprCacheScope.enter()
                    fallback_subject :: env.fallback_subject
                    env.fallback_subject = false
                    value :: lower_value(&env)
                    env.fallback_subject = fallback_subject
                    ^value
                } else { lower_value(&env) }
                expr_cache_put(strip_expr_parens(arg.arg.expr), canonicalize_pre_tier_expr(^value), cx)
            }
            .LowerInlineLoop(expr, body) -> {
                block_env := clone_env(env)
                lowered :: lower_stmts(body, cx, &block_env)
                if expr == .CallValue{callee, ..} {
                    if callee == .Lambda(lam) {
                        ty :: if lam.meta.collecting_loop -> Type.List(lam.meta.collect_item_type ?? Type.Int) else -> lam.meta.loop_result_type ?? Type.Int
                        expr_cache_put(expr, canonicalize_pre_tier_expr(TExpr{ty: ty, kind: .InlineBlock(^lowered)}), cx)
                    } else { panic("inline loop work item requires a lambda") }
                } else { panic("inline loop work item requires a call value") }
            }
            .BuildIf(expr) -> {
                if lower_result_handler_expr(expr, cx, &env) == .Val(handler) { expr_cache_put(expr, ^handler, cx); next }
                if lower_value_dispatch_expr(expr, cx, &env) == .Val(table) { expr_cache_put(expr, ^table, cx); next }
                if expr == .If{cond, then_body, then_value, else_body, else_value, ..} {
                    state :: ExprIfConditionWork{expr: expr, then_body: then_body.view(), then_value: @then_value, else_body: else_body.view(), else_value: @else_value, terms: condition_terms(cond), next: 0, lowered: [], bindings: [], prefixes: [], base_env: clone_env(env)}
                    first :: state.terms.first().expect("if condition has one or more terms")
                    work.push(.LowerIfCondition(^state))
                    push_expr_condition_atom(&work, first, cx, env)
                } else { panic("if work item requires an if expression") }
            }
            .LowerIfCondition(state) -> {
                term :: state.terms[state.next]
                (lowered, binding, prefix) :: lower_if_cond_atom_cached(term, cx, &env)
                loop (name, place, ty) in binding {
                    env.bind(name, ~place, ~ty)
                    state.bindings.push((^name, ^place, ^ty))
                }
                state.lowered.push(^lowered); state.prefixes.extend(^prefix); state.next += 1
                if state.terms.get(state.next) == .Val(next_term) {
                    work.push(.LowerIfCondition(^state))
                    push_expr_condition_atom(&work, next_term, cx, env)
                    next
                }
                lowered_terms := state.lowered.into_iter().rev()
                condition := lowered_terms.next().expect("if condition has one or more lowered terms")
                loop left in lowered_terms { condition = .And{left: ^left, right: ^condition} }
                then_env := clone_env(state.base_env)
                loop (name, place, ty) in state.bindings { then_env.bind(name, ~place, ~ty) }
                branch_env :: clone_env(then_env)
                if_state :: ExprIfWork{expr: state.expr, condition: ^condition, then_prefix: ^state.prefixes, then_body: state.then_body, then_value: state.then_value, else_body: state.else_body, else_value: state.else_value, base_env: ^state.base_env, then_env: Val(^then_env), then_lowered: [], then_value_lowered: None, else_lowered: []}
                env = ^branch_env
                work.push(.LowerIfThenBody(^if_state))
            }
            .LowerIfThenBody(state) -> {
                branch_env := state.then_env.take().expect("if then environment is consumed once")
                state.then_lowered = lower_stmts(state.then_body, cx, &branch_env)
                env = ^branch_env
                then_value :: state.then_value
                work.push(.LowerIfThenValue(^state)); work.push(.Enter(then_value))
            }
            .LowerIfThenValue(state) -> {
                state.then_value_lowered = Val(expr_cache_take(strip_expr_parens(state.then_value), cx).expect("if then value was lowered exactly once"))
                state.then_env = Val(clone_env(env))
                env = clone_env(state.base_env)
                work.push(.LowerIfElseBody(^state))
            }
            .LowerIfElseBody(state) -> {
                state.else_lowered = lower_stmts(state.else_body, cx, &env)
                else_value :: state.else_value
                work.push(.LowerIfElseValue(^state)); work.push(.Enter(else_value))
            }
            .LowerIfElseValue(state) -> {
                else_value := expr_cache_take(strip_expr_parens(state.else_value), cx).expect("if else value was lowered exactly once")
                then_value := state.then_value_lowered.expect("if then value is consumed once")
                then_body := state.then_prefix
                then_body.extend(^state.then_lowered)
                then_reaches :: tir_if_branch_reaches_merge(then_body, then_value)
                else_reaches :: tir_if_branch_reaches_merge(state.else_lowered, else_value)
                if then_reaches && else_reaches {
                    then_absent :: then_value.kind == .Absent
                    else_absent :: else_value.kind == .Absent
                    if then_absent && !else_absent && (if else_value.ty == { .Option(_) -> true else -> false }) { then_value.ty = ~else_value.ty }
                    else if else_absent && !then_absent && (if then_value.ty == { .Option(_) -> true else -> false }) { else_value.ty = ~then_value.ty }
                }
                ty :: tir_if_join_type(then_reaches, then_value.ty, else_reaches, else_value.ty)
                value :: canonicalize_pre_tier_expr(TExpr{ty: ty, kind: .IfExpr{cond: ^state.condition, then_body: ^then_body, then_value: ^then_value, else_body: ^state.else_lowered, else_value: ^else_value}})
                env = ^state.base_env
                expr_cache_put(state.expr, ^value, cx)
            }
        }
    }
    expr_cache_take(root, cx).expect("expression worklist lost its root")
}

// Rust: crates/jet-codegen/src/Codegen/TIR/lower/expressions.rs:3358
fn tir_if_join_type(then_reaches_merge: Bool, then_ty: Type, else_reaches_merge: Bool, else_ty: Type) -> Type Never! {
    // Incompatible live pairs already diagnose E0124; retain first live recovery type.
    if !then_reaches_merge && else_reaches_merge -> ~else_ty else -> ~then_ty
}
// Rust: crates/jet-codegen/src/Codegen/TIR/lower/expressions.rs:3372
fn tir_if_branch_reaches_merge(body: [TStmt], value: TExpr) -> Bool Never! { tir_stmt_sequence_reaches_merge(body) && tir_expr_reaches_merge(value) }
// Rust: crates/jet-codegen/src/Codegen/TIR/lower/expressions.rs:3376
fn tir_stmt_sequence_reaches_merge(stmts: [TStmt]) -> Bool Never! { stmts.iter().all((stmt) => tir_stmt_reaches_merge(stmt)) }
// Rust: crates/jet-codegen/src/Codegen/TIR/lower/expressions.rs:3383
fn tir_stmt_reaches_merge(stmt: TStmt) -> Bool Never! {
    if stmt == {
        .Return(_) | .Break(_) | .BreakValue{..} | .Continue(_) -> false
        .ExprStmt(expr) -> tir_expr_reaches_merge(expr)
        .If{then_body, else_body, ..} -> tir_stmt_sequence_reaches_merge(then_body) || else_body.is_none_or((body) => tir_stmt_sequence_reaches_merge(body))
        .ContractScope{body, ..} | .TaskGroup{body, ..} | .Inline(body) | .Unsafe{body, ..} | .SentryPolicy{body, ..} | .Impure(body) | .Region(body) | .Layout{body, ..} | .ContextBlock{body, ..} | .Live{body} | .Shield{body} | .ScopeMember{body, ..} | .Transact{body, ..} -> tir_stmt_sequence_reaches_merge(body)
        .GcEdit{stmt: inner, ..} -> tir_stmt_reaches_merge(inner)
        .EnumMatch{arms, else_body, fallthrough, ..} -> arms.iter().any((arm) => tir_stmt_sequence_reaches_merge(arm.body)) || (else_body.map((body) => tir_stmt_sequence_reaches_merge(body)) ?? !fallthrough)
        .RangeSwitch{arms, else_body, ..} -> arms.iter().any((arm) => tir_stmt_sequence_reaches_merge(arm.2)) || tir_stmt_sequence_reaches_merge(else_body)
        .MixedSwitch{arms, else_body, ..} -> arms.iter().any((arm) => tir_stmt_sequence_reaches_merge(arm.1)) || else_body.is_none_or((body) => tir_stmt_sequence_reaches_merge(body))
        else -> true
    }
}
// Rust: crates/jet-codegen/src/Codegen/TIR/lower/expressions.rs:3444
pub fn tir_expr_reaches_merge(expr: TExpr) -> Bool Never! {
    if expr.ty == .Named(name) { if name == Syntax.TYPE_NEVER -> return false }
    if expr.kind == {
        .Unreachable{..} | .Todo{..} -> false
        .RequireStop{always_stops, ..} -> !always_stops
        .IfExpr{then_body, then_value, else_body, else_value, ..} -> tir_if_branch_reaches_merge(then_body, then_value) || tir_if_branch_reaches_merge(else_body, else_value)
        .ResultHandler{ok_body, ok_value, err_body, err_value, terminal, ..} -> tir_if_branch_reaches_merge(ok_body, ok_value) || tir_if_branch_reaches_merge(err_body, err_value) || tir_expr_reaches_merge(terminal)
        .InlineBlock(stmts) -> tir_stmt_sequence_reaches_merge(stmts)
        .Try{inner, ..} -> tir_expr_reaches_merge(inner)
        .OrFallback{value, fallback} -> tir_expr_reaches_merge(value) || (if fallback == { .Value(other) -> tir_expr_reaches_merge(other) .Return(_) | .Panic{..} | .Break | .Continue | .BreakLabel(_) | .ContinueLabel(_) -> false })
        else -> true
    }
}
// Rust: crates/jet-codegen/src/Codegen/TIR/lower/expressions.rs:3489
pub fn grouped_enum_unit_variant(cx: Cx, receiver: Expr, member: String, is_bound: (String) -> Bool) -> (String, String)? Never! {
    // Rust: crates/jet-codegen/src/Codegen/TIR/lower/expressions.rs:3495
    fn collect_path(expr: Expr, path: &[String]) -> Bool Never! {
        if expr == {
            .Ident(name, _) -> { path.push(~name); true }
            .Field(base, member, _) -> { if !collect_path(base, &path) -> return false; path.push(~member); true }
            .Paren(inner, _) -> collect_path(inner, &path)
            else -> false
        }
    }
    path := [String]{}
    if !collect_path(receiver, &path) -> return None
    path.push(member)
    enum_name := path.first() ?? return None
    if path.len() < 3 || is_bound(enum_name) -> return None
    variant :: path.view(1..<path.len()).join(".")
    if cx.variant_owner.get(variant) != Val(enum_name) -> return None
    is_unit :: cx.enum_variants.get(enum_name).is_some_and((variants) => variants.iter().any((entry) => entry.0 == variant && entry.1 == .Unit))
    if is_unit -> Val((~enum_name, variant)) else -> None
}
// Rust: crates/jet-codegen/src/Codegen/TIR/lower/expressions.rs:3534
#Inline(false)
pub fn lower_expr(e: Expr, cx: Cx, env: &LowerEnv) -> TExpr Never! {
    before_payload :: if CanonicalPass.enabled() -> Val(CanonicalPass.debug_payload("ast", "tir.lower-expression", e)) else -> None
    before_identity :: if CanonicalPass.enabled() -> Val(CanonicalPass.debug_identity("ast", "tir.lower-expression", e)) else -> None
    lowered :: lower_expr_impl(e, cx, &env)
    if (before_payload, before_identity) == (.Val(payload), .Val(identity)) {
        CanonicalPass.record("lowering", "tir.lower-expression", "crates/jet-codegen/src/Codegen/TIR/lower/expressions.rs", "ast", payload, identity, "tir", canonical_expression_payload(lowered), canonical_expression_identity(lowered), "preserve")
    }
    ^lowered
}
