//RS /// Select the value type at a lowered `if` merge using the same reachability
//RS /// policy as semantic inference.
//RS ///
//RS /// Sema reports an incompatible live pair as E0124 and poisons the later tail
//RS /// with a diverging recovery node, but codegen still walks that tree to collect
//RS /// diagnostics. Keep the first live branch as the recovery type instead of
//RS /// asserting on a malformed pair and turning a user error into an ICE.
//RS fn tir_if_join_type(
//RS     then_reaches_merge: bool,
//RS     then_ty: &Type,
//RS     else_reaches_merge: bool,
//RS     else_ty: &Type,
//RS ) -> Type {
//RS     match (then_reaches_merge, else_reaches_merge) {
//RS         (false, true) => else_ty.clone(),
//RS         (true, false) => then_ty.clone(),
//RS         (true, true) => then_ty.clone(),
//RS         (false, false) => then_ty.clone(),
//RS     }
//RS }
//RS 
//RS fn tir_if_branch_reaches_merge(body: &[TStmt], value: &TExpr) -> bool {
//RS     tir_stmt_sequence_reaches_merge(body) && tir_expr_reaches_merge(value)
//RS }
//RS 
//RS fn tir_stmt_sequence_reaches_merge(stmts: &[TStmt]) -> bool {
//RS     // A lowered sequence can contain an explicit exit before its syntactic
//RS     // tail. Check every statement so an unreachable tail cannot make a
//RS     // divergent branch look live at the value merge.
//RS     stmts.iter().all(tir_stmt_reaches_merge)
//RS }
//RS 
//RS fn tir_stmt_reaches_merge(stmt: &TStmt) -> bool {
//RS     match stmt {
//RS         TStmt::Return(_) | TStmt::Break(_) | TStmt::BreakValue { .. } | TStmt::Continue(_) => false,
//RS         TStmt::ExprStmt(expr) => tir_expr_reaches_merge(expr),
//RS         TStmt::If {
//RS             then_body,
//RS             else_body,
//RS             ..
//RS         } => {
//RS             tir_stmt_sequence_reaches_merge(then_body)
//RS                 || else_body
//RS                     .as_deref()
//RS                     .is_none_or(tir_stmt_sequence_reaches_merge)
//RS         }
//RS         TStmt::ContractScope { body, .. }
//RS         | TStmt::TaskGroup { body, .. }
//RS         | TStmt::Inline(body)
//RS         | TStmt::Unsafe { body, .. }
//RS         | TStmt::SentryPolicy { body, .. }
//RS         | TStmt::Impure(body)
//RS         | TStmt::Region(body)
//RS         | TStmt::Layout { body, .. }
//RS         | TStmt::ContextBlock { body, .. }
//RS         | TStmt::Live { body }
//RS         | TStmt::Shield { body }
//RS         | TStmt::ScopeMember { body, .. }
//RS         | TStmt::Transact { body, .. } => tir_stmt_sequence_reaches_merge(body),
//RS         TStmt::GcEdit { stmt, .. } => tir_stmt_reaches_merge(stmt),
//RS         TStmt::EnumMatch {
//RS             arms,
//RS             else_body,
//RS             fallthrough,
//RS             ..
//RS         } => {
//RS             arms.iter()
//RS                 .any(|arm| tir_stmt_sequence_reaches_merge(&arm.body))
//RS                 || else_body
//RS                     .as_deref()
//RS                     .map(tir_stmt_sequence_reaches_merge)
//RS                     .unwrap_or(!*fallthrough)
//RS         }
//RS         TStmt::RangeSwitch {
//RS             arms, else_body, ..
//RS         } => {
//RS             arms.iter()
//RS                 .any(|(_, _, body)| tir_stmt_sequence_reaches_merge(body))
//RS                 || tir_stmt_sequence_reaches_merge(else_body)
//RS         }
//RS         TStmt::MixedSwitch {
//RS             arms, else_body, ..
//RS         } => {
//RS             arms.iter()
//RS                 .any(|(_, body)| tir_stmt_sequence_reaches_merge(body))
//RS                 || else_body
//RS                     .as_deref()
//RS                     .is_none_or(tir_stmt_sequence_reaches_merge)
//RS         }
//RS         _ => true,
//RS     }
//RS }
