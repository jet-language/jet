#Inline(false)
fn lower_expr_impl(e: Expr, cx: Cx, env: &LowerEnv) -> TExpr Never! {
    comptime_cache_guard :: ExprComptimeCacheGuard.enter(env)
    stripped :: strip_expr_parens(e)
    if stripped == .Ident(name, _) {
        if env.binder_ref(name) == .Val((temp, ty)) -> return TExpr{ty: ~ty, kind: .Local(TLocal.user(~temp))}
    }
    if expr_cache_take(stripped, cx) == .Val(value) {
        if stripped == .Ident(name, _) {
            if value.kind == .Local(_) {
                if env.ty_of(name) == .Val(ty) -> return TExpr{ty: ty, kind: .Local(env.local_of(name))}
            }
        }
        return canonicalize_pre_tier_expr(^value)
    }
    cache_owner :: ExprCacheOwner{owns_cache: expr_cache_begin()}
    value :: canonicalize_pre_tier_expr(lower_expr_segment(stripped, cx, &env))
    drop(cache_owner)
