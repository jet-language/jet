use jet_foundation.AST.[Expr, Type, Call, CallArg]
use jet_foundation.TIR.[TExpr, TExprKind, TLocal, TPanicLoc, TPanicLocal, TRequireKind]
use jet_foundation.Diagnostics.[Span, LineIndex]
use jet_codegen.Codegen.Cx
use jet_codegen.Codegen.TIR.Lower.Env.LowerEnv
use jet_codegen.Codegen.TIR.Lower.Expressions.lower_expr

// Rust: crates/jet-codegen/src/Codegen/TIR/lower/panic.rs:11
pub fn clone_env(env: LowerEnv) -> LowerEnv Never! {
    // GATE #4494: Rc cells retain shared child facts; lexical maps clone independently.
    env.clone()
}
// Rust: crates/jet-codegen/src/Codegen/TIR/lower/panic.rs:15
pub fn fork_panic(env: LowerEnv) -> LowerEnv Never! { clone_env(env) }
// Rust: crates/jet-codegen/src/Codegen/TIR/lower/panic.rs:21
pub fn tir_src_line_at(src: String, lines: LineIndex, offset: Int) -> (String, U32, U32) Never! {
    (line, col) :: lines.line_col(src, offset)
    (lines.line_text(src, line), U32{line}, U32{col})
}
// Rust: crates/jet-codegen/src/Codegen/TIR/lower/panic.rs:30
fn safe_locals_snapshot(env: LowerEnv) -> [TPanicLocal] Never! {
    names := [String]{}
    loop name in env.locals.keys() {
        (_, ty) :: env.locals[name]
        if ty == Val(Type.Int) || ty == Val(Type.Float) || ty == Val(Type.Bool) -> &names.push(name)
    }
    &names.sort()
    parts := [TPanicLocal]{}
    loop name in names {
        (place, _) :: env.locals[name]
        &parts.push(TPanicLocal{display_name: name, local: place})
    }
    parts
}
// Rust: crates/jet-codegen/src/Codegen/TIR/lower/panic.rs:48
pub fn capture_panic_loc(span: Span, cx: Cx, env: LowerEnv) -> TPanicLoc Never! {
    (src_line, line, col) :: tir_src_line_at(cx.src, cx.src_lines(), span.start)
    trimmed := src_line.trim_end() // #4303
    TPanicLoc{file: cx.file, source_line: trimmed, line: Int.from_u32(line), column: Int.from_u32(col),
        caret: Int.from_u32(U32{span.end - span.start}), function: env.fn_name, locals: safe_locals_snapshot(env)}
}
// Rust: crates/jet-codegen/src/Codegen/TIR/lower/panic.rs:61
pub fn lower_panic_message_expr(expression: Expr, cx: Cx, &env: LowerEnv) -> TExpr Never! { lower_expr(expression, cx, &env) }
// Rust: crates/jet-codegen/src/Codegen/TIR/lower/panic.rs:65
pub fn lower_require_stop(call: Call, cx: Cx, &env: LowerEnv) -> (TRequireKind, TPanicLoc) Never! {
    loc :: capture_panic_loc(call.name_span, cx, env)
    cond :: lower_expr(call.args[0].expr, cx, &env)
    msg :: if call.args.len() == 2 -> Val(lower_panic_message_expr(call.args[1].expr, cx, &env)) else -> None
    (TRequireKind.Require(cond, msg), loc)
}
// Rust: crates/jet-codegen/src/Codegen/TIR/lower/panic.rs:84
pub fn lower_require_eq_stop(call: Call, cx: Cx, &env: LowerEnv) -> (TRequireKind, TPanicLoc) Never! {
    loc :: capture_panic_loc(call.name_span, cx, env)
    left :: lower_expr(call.args[0].expr, cx, &env)
    right := lower_expr(call.args[1].expr, cx, &env)
    if right.kind == TExprKind.Absent && left.ty == .Option(_) -> right.ty = left.ty
    (TRequireKind.RequireEq(left, ^right), loc)
}
// Rust: crates/jet-codegen/src/Codegen/TIR/lower/panic.rs:100
pub fn lower_panic_stop(name_span: Span, args: [CallArg], cx: Cx, &env: LowerEnv) -> (TRequireKind, TPanicLoc) Never! {
    loc :: capture_panic_loc(name_span, cx, env)
    msg :: lower_panic_message_expr(args[0].expr, cx, &env)
    (TRequireKind.Panic(msg), loc)
}
