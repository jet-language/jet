// Rust: crates/jet-codegen/src/Codegen/TIR/lower/lambdas.rs:32
fn lambda_jit_name(start: USize, end: USize) -> String Never! {
    mangle_generated("lambda_{start}_{end}")
}

// Rust: crates/jet-codegen/src/Codegen/TIR/lower/lambdas.rs:38
pub fn spawn_label(lam: Lambda, cx: Cx, env: LowerEnv) -> String? {
    body := if lam.body == {
        .Expr(expr) -> expr
        .Block(stmts) -> {
            if stmts.len() != 1 -> return None
            if stmts[0] == { .Expr(expr) | .Return(Val(expr), _) -> expr; else -> return None }
        }
    }
    expr := body
    loop { if expr == { .Paren(inner, _) | .Try(inner, _, _, _) -> expr = inner; else -> break } }
    if expr == {
        .Call(call) -> {
            if cx.fn_types.get(call.name) == { Val(.Fn(_, _, _, _, _, _)) -> Val(call.name.clone()); else -> None }
        }
        .Ident(name, _) -> {
            if env.locals.contains_key(name) -> return None
            if cx.fn_types.get(name) == { Val(.Fn(_, _, _, _, _, _)) -> Val(name.clone()); else -> None }
        }
        else -> None
    }
}

// Rust: crates/jet-codegen/src/Codegen/TIR/lower/lambdas.rs:69
fn reactive_capture_name(name: String) -> String Never! {
    mangle_generated("cap_{Syntax.generated_suffix(mangle(name))}")
}

// Rust: crates/jet-codegen/src/Codegen/TIR/lower/lambdas.rs:79
pub fn materialized_capture_kind(name: String, env: LowerEnv) -> (String, Type)? {
    if env.is_string_view_local(name) {
        kind :: view_copy_kind(Type.String) ?? return None
        return Val((kind.symbol(), Type.String))
    }
    source :: env.split_view_handle(name).or_else(fn() { env.ty_of(name) }) ?? return None
    owned :: view_copy_owned_type(source) ?? return None
    kind :: view_copy_kind(source) ?? return None
    Val((kind.symbol(), owned))
}

// Rust: crates/jet-codegen/src/Codegen/TIR/lower/lambdas.rs:93
fn is_write_split_view(name: String, env: LowerEnv) -> Bool Never! {
    if env.split_view_handle(name) == { Val(.Apply(n, _)) -> n == "ViewMut" || n == "ComputeViewMut"; else -> false }
}

