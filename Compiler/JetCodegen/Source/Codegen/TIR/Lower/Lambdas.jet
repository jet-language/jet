// Rust: crates/jet-codegen/src/Codegen/TIR/lower/lambdas.rs:241
pub fn lambda_explicit_failure_carrier(lam: Lambda) -> Type? {
    if lam.result_type.is_none() && lam.error_type.is_none() -> return None
    Val(Type.Result{ok: lam.result_type.clone().unwrap_or_else(unit_type), err: lam.error_type.clone().unwrap_or_else(fn() { Type.Named(Syntax.TYPE_ERR.to_string()) })})
}

// Rust: crates/jet-codegen/src/Codegen/TIR/lower/lambdas.rs:255
fn is_default_error_type(ty: Type) -> Bool Never! {
    if ty == { .Named(name) -> name == Syntax.TYPE_ERR; else -> false }
}

// Rust: crates/jet-codegen/src/Codegen/TIR/lower/lambdas.rs:259
fn lambda_carrier_return_type(body_ty: Type, carrier: Type) -> Type Never! {
    if (body_ty, carrier) == {
        (.Result(body_ok, body_error), .Result(carrier_ok, err)) -> {
            if body_error == err -> return body_ty.clone()
            if is_default_error_type(body_error) && body_ok == carrier_ok -> return Type.Result{ok: carrier_ok.clone(), err: err.clone()}
            Type.Result{ok: body_ty.clone(), err: err.clone()}
        }
        (.Option(_), .Option(_)) -> body_ty.clone()
        (_, .Result(_, err)) -> Type.Result{ok: body_ty.clone(), err: err.clone()}
        (_, .Option(_)) -> Type.Option(body_ty.clone())
        else -> carrier.clone()
    }
}

// Rust: crates/jet-codegen/src/Codegen/TIR/lower/lambdas.rs:290
fn rehome_default_result_carrier(value: TExpr, carrier: Type?) -> TExpr Never! {
    if (value.ty, carrier) == {
        (.Result(value_ok, value_err), Val(.Result(carrier_ok, carrier_err))) -> {
            if is_default_error_type(value_err) && value_ok == carrier_ok {
                value.ty = Type.Result{ok: carrier_ok.clone(), err: carrier_err.clone()}
            }
        }
        else -> {}
    }
    value
}

// Rust: crates/jet-codegen/src/Codegen/TIR/lower/lambdas.rs:314
fn lower_lambda_expecting_with_host_borrow(lam: Lambda, cx: Cx, env: LowerEnv, expected_params: [Type]?, host_borrow: Bool?, by_value: Bool, shared_body: Arc<[TStmt]>?, expected_return: Type?) -> TLambda Never! {
    param_types: [Type] := []
    loop (i, param) in lam.params.enumerate() {
        param_types.push(param.ty.clone().or_else(fn() { expected_params.and_then(fn(types) { types.get(i).cloned() }) }).unwrap_or(Type.Int))
    }
    body_ty := shared_body.map(fn(body) { lowered_block_return_ty(body) }).unwrap_or_else(fn() { lambda_body_ty_expecting_with_return(lam, cx, env, expected_params, expected_return) })
    explicit_failure_carrier := lambda_explicit_failure_carrier(lam)
    lambda_ret_ty := expected_return.or(explicit_failure_carrier).or(lam.meta.fallible_carrier).map(fn(ret) { lambda_carrier_return_type(body_ty, ret) }).unwrap_or_else(fn() { body_ty.clone() })
    enclosing_carrier := env.ret_ty.is_some_and(fn(ty) { if ty == { .Result(_, _) | .Option(_) -> true; else -> false } })
    direct_fallible := expected_return.is_none() && lam.meta.fallible_carrier.is_none() && explicit_failure_carrier.is_none() && enclosing_carrier && !by_value && host_borrow.is_none()
    lam_env := fork_panic(env)
    lam_env.fallback_subject = false
    lam_env.ret_ty = Val(lambda_ret_ty.clone())
    lam_env.raw_protocol_return = false
    lam_env.txn_handle = None
    lam_env.txn_undo_needed = None
    is_move := !(lam.meta.needs_fn_mut && !lam.meta.escapes)
    extra_cloned: [String] := []
    handle_shares: [String] := []
    captures: [(String, String, Type)] := []
    capture_origins: [String:String] := [:]
    // Membership indices preserve linear capture classification.
    param_names := Set<String>.from(lam.params.map(fn(p) { p.name }))
    cloned_names := Set<String>.from(lam.meta.cloned_captures)
    materialized_names := Set<String>.from(lam.meta.materialized_captures)
    moved_names := Set<String>.from(lam.meta.moved_captures)
    extra_names := Set<String>.new()
    capture_names := Set<String>.new()
    if is_move {
        reads := if lam.body == { .Block(stmts) -> Sema.block_free_var_reads(stmts); .Expr(e) -> Sema.expr_free_reads_and_calls(e).0 }
        loop name in reads {
            if param_names.contains(name) || cloned_names.contains(name) || extra_names.contains(name) || !env.locals.contains_key(name) -> continue
            if env.is_resource(name) {
                if moved_names.contains(name) { _ :: env.resource_take_place(name) }
                continue
            }
            fn_local := if env.ty_of(name) == { Val(.Fn(_, _, _, _, _, _)) -> true; else -> false }
            needs_clone := env.is_borrowed(name) || fn_local
            if needs_clone && is_write_split_view(name, env) && !materialized_names.contains(name) {
                handle_shares.push(name)
            } else if needs_clone {
                extra_names.insert(name.clone())
                extra_cloned.push(name)
            }
        }
    }
    loop name in lam.meta.cloned_captures.chain(extra_cloned) {
        cap := reactive_capture_name(name)
        copied_window := if materialized_names.contains(name) -> materialized_capture_kind(name, env) else -> None
        cap_ty := copied_window.map(fn(pair) { pair.1.clone() }).unwrap_or_else(fn() { env.ty_of(name).expect("checked capture local has no resolved type") })
        captures.push((name.clone(), cap.clone(), cap_ty.clone()))
        capture_names.insert(name.clone())
        capture_origins.insert(name.clone(), env.local_of(name).name)
        lam_env.bind(name, TLocal.generated(cap), Val(cap_ty))
        if copied_window.is_some() { lam_env.clear_view_marks(name) }
    }
    (reads, called) := if lam.body == { .Block(stmts) -> Sema.block_free_reads_and_calls(stmts); .Expr(e) -> Sema.expr_free_reads_and_calls(e) }
    loop (name, _) in lam.take_names { reads.insert(name.clone()) }
    loop name in called {
        if env.ty_of(name) == { Val(.Fn(_, _, _, _, _, _)) -> reads.insert(name); else -> {} }
    }
    loop name in reads {
        if param_names.contains(name) || capture_names.contains(name) || !env.locals.contains_key(name) -> continue
        cap_ty := env.ty_of(name).expect("checked capture local has no resolved type")
        captures.push((name.clone(), env.local_of(name).name, cap_ty))
        capture_names.insert(name)
    }
    loop (i, p) in lam.params.enumerate() {
        ty := p.ty.clone().or_else(fn() { expected_params.and_then(fn(ps) { ps.get(i).cloned() }) })
        place := if host_borrow.is_some() || (!by_value && ty.is_some_and(fn(t) { !t.is_scalar() })) -> TLocal.user(p.name).through_ref() else -> TLocal.user(p.name)
        lam_env.bind(p.name, place, ty)
    }
    prev_in_stm := cx.in_stm_transact.replace(false)
    executable := with_lambda_body_expr_cache(fn() {
        if lam.body == {
            .Expr(e) -> {
                prepare_interrupt_callback_local_expr(e, cx, &lam_env)
                lowered := fallible_lambda_value(lower_owned_expr(e, cx, &lam_env), lam, env, expected_return)
                body_ty = lowered.ty.clone()
                TLambdaBody.Expr(lowered)
            }
            .Block(stmts) -> {
                if shared_body == { Val(shared) -> return TLambdaBody.SharedBlock(shared.clone()); else -> {} }
                prepare_interrupt_callback_locals(stmts, cx, &lam_env)
                has_tail := if stmts.last() == { Val(.Expr(_)) -> true; else -> false }
                lowered := if has_tail || return_type_has_value(body_ty) -> lower_value_block(stmts, cx, &lam_env) else -> lower_stmts(stmts, cx, &lam_env)
                expected_carrier := expected_return.is_some_and(fn(ty) { if ty == { .Result(_, _) | .Option(_) -> true; else -> false } })
                if lam.meta.fallible_carrier.is_some() || expected_carrier { lift_fallible_lambda_returns(&lowered, lam, env, expected_return) }
                body_ty = lowered_block_return_ty(lowered)
                TLambdaBody.Block(lowered)
            }
        }
    })
    cx.in_stm_transact.set(prev_in_stm)
    uses_stack_sentry := lam_env.stack_sentry_needed()
    capture_facts := lambda_capture_facts(lam)
    capture_facts.cloned.extend(extra_cloned)
    capture_facts.cloned.extend(handle_shares)
    capture_facts.moved.retain(fn(name) { !extra_names.contains(name) })
    host_param_conventions := if by_value && host_borrow.is_none() -> Val([AccessConvention.Move; param_types.len()])
        else if host_borrow == Val(true) -> Val([AccessConvention.Write; param_types.len()])
        else -> None
    failure_carrier := if expected_return.is_some() -> TFailureCarrier.from_checked_type(lambda_ret_ty)
        else if lam.result_type.is_some() || lam.error_type.is_some() || lam.meta.fallible_carrier.is_some() {
            if lambda_failure_carrier(lam) == { .Infallible -> TFailureCarrier.from_checked_type(body_ty); carrier -> carrier }
        } else -> TFailureCarrier.from_checked_type(body_ty)
    is_unit := if body_ty == { .Named(name) -> name == "Unit"; else -> false }
    TLambda{
        executable: executable, source_span: lam.span,
        frame_schedule: lam.meta.frame_schedule.clone(), frame_schedule_derivation: lam.meta.frame_schedule_derivation.clone(),
        capture_facts: capture_facts, effects: lambda_effect_facts(lam),
        host_param_conventions: host_param_conventions, source_params: lam.params.map(fn(p) { p.name.clone() }),
        jit_name: lambda_jit_name(lam.span.start, lam.span.end), param_types: param_types,
        failure_carrier: failure_carrier, ret: if !is_unit -> Val(body_ty) else -> None,
        is_move: is_move, boxed: lam.meta.escapes && !direct_fallible,
        rc: lam.meta.escapes && !lam.meta.needs_fn_mut && !by_value && host_borrow.is_none() && !direct_fallible,
        arc: false, captures: captures, capture_origins: capture_origins,
        materialized_captures: lam.meta.materialized_captures.clone(), frozen_captures: lam.meta.frozen_captures.clone(),
        uses_stack_sentry: uses_stack_sentry
    }
}

// Rust: crates/jet-codegen/src/Codegen/TIR/lower/lambdas.rs:643
fn fallible_lambda_value(value: TExpr, lam: Lambda, env: LowerEnv, expected_return: Type?) -> TExpr Never! {
    explicit_failure_carrier := lambda_explicit_failure_carrier(lam)
    carrier := expected_return.or(explicit_failure_carrier).or(lam.meta.fallible_carrier)
    if carrier.is_none() -> return value
    fitted := rehome_default_result_carrier(value, carrier)
    if carrier == {
        Val(.Result(_, err)) -> {
            if fitted.ty == { .Result(_, _) -> fitted; else -> TExpr{ty: Type.Result{ok: fitted.ty.clone(), err: err.clone()}, kind: TExprKind.Ok(fitted)} }
        }
        Val(.Option(_)) -> {
            if fitted.ty == { .Option(_) -> fitted; else -> TExpr{ty: Type.Option(fitted.ty.clone()), kind: TExprKind.Present(fitted)} }
        }
        else -> fitted
    }
}

// Rust: crates/jet-codegen/src/Codegen/TIR/lower/lambdas.rs:677
fn lift_fallible_lambda_returns(stmts: &[TStmt], lam: Lambda, env: LowerEnv, expected_return: Type?) -> Void Never! {
    lift_fallible_lambda_return_block(&stmts, lam, env, expected_return)
    if stmts.last() == { Val(.Return(_)) -> return; else -> {} }
    if stmts.last_mut() == {
        Val(.ExprStmt(value)) -> {
            return_value := std.mem.replace(&value, TExpr{ty: unit_type(), kind: TExprKind.Unit})
            value = fallible_lambda_value(return_value, lam, env, expected_return)
            return
        }
        else -> {}
    }
    stmts.push(TStmt.Return(Val(fallible_lambda_value(TExpr{ty: unit_type(), kind: TExprKind.Unit}, lam, env, expected_return))))
}

// Rust: crates/jet-codegen/src/Codegen/TIR/lower/lambdas.rs:709
fn lift_fallible_lambda_return_block(stmts: &[TStmt], lam: Lambda, env: LowerEnv, expected_return: Type?) -> Void Never! {
    loop stmt in &stmts { lift_fallible_lambda_return_stmt(&stmt, lam, env, expected_return) }
}

// Rust: crates/jet-codegen/src/Codegen/TIR/lower/lambdas.rs:720
fn lift_fallible_lambda_return_stmt(stmt: &TStmt, lam: Lambda, env: LowerEnv, expected_return: Type?) -> Void Never! {
    if &stmt == {
        .Return(value) -> {
            return_value := value.take().unwrap_or_else(fn() { TExpr{ty: unit_type(), kind: TExprKind.Unit} })
            value = Val(fallible_lambda_value(return_value, lam, env, expected_return))
        }
        .ContractScope{body: body, ..} | .TaskGroup{body: body, ..} | .Loop{body: body, ..}
        | .While{body: body, ..} | .Range{body: body, ..} | .ForIn{body: body, ..}
        | .Inline(body) | .DebugOnly(body) | .Unsafe{body: body, ..} | .SentryPolicy{body: body, ..}
        | .Impure(body) | .Region(body) | .Layout{body: body, ..} | .ContextBlock{body: body, ..}
        | .Live{body: body} | .Shield{body: body} | .ScopeMember{body: body, ..} | .Transact{body: body, ..} -> {
            lift_fallible_lambda_return_block(&body, lam, env, expected_return)
        }
        .RefutableBind{fallback: fallback, ..} -> lift_fallible_lambda_return_block(&fallback, lam, env, expected_return)
        .GcEdit{stmt: nested, ..} -> lift_fallible_lambda_return_stmt(&nested, lam, env, expected_return)
        .CountedLoop{init: init, step: step, body: body, ..} -> {
            lift_fallible_lambda_return_stmt(&init, lam, env, expected_return)
            if &step == { Val(s) -> lift_fallible_lambda_return_stmt(&s, lam, env, expected_return); else -> {} }
            lift_fallible_lambda_return_block(&body, lam, env, expected_return)
        }
        .If{then_body: then_body, else_body: else_body, ..} -> {
            lift_fallible_lambda_return_block(&then_body, lam, env, expected_return)
            if &else_body == { Val(body) -> lift_fallible_lambda_return_block(&body, lam, env, expected_return); else -> {} }
        }
        .EnumMatch{arms: arms, else_body: else_body, ..} -> {
            loop arm in &arms { lift_fallible_lambda_return_block(&arm.body, lam, env, expected_return) }
            if &else_body == { Val(body) -> lift_fallible_lambda_return_block(&body, lam, env, expected_return); else -> {} }
        }
        .RangeSwitch{arms: arms, else_body: else_body, ..} -> {
            loop (_, _, body) in &arms { lift_fallible_lambda_return_block(&body, lam, env, expected_return) }
            lift_fallible_lambda_return_block(&else_body, lam, env, expected_return)
        }
        .MixedSwitch{arms: arms, else_body: else_body, ..} -> {
            loop (_, body) in &arms { lift_fallible_lambda_return_block(&body, lam, env, expected_return) }
            if &else_body == { Val(body) -> lift_fallible_lambda_return_block(&body, lam, env, expected_return); else -> {} }
        }
        // Reactive callbacks have their own carrier; leaves have no callable returns.
        .Reactive{..} | .Let{..} | .ExprStmt(_) | .Contract{..} | .SplitViews{..}
        | .TupleDestructure{..} | .StructDestructure{..} | .ListDestructure{..} | .Assign{..}
        | .DeferClose{..} | .Break(_) | .BreakValue{..} | .Continue(_) | .IndexAssign{..}
        | .IndexFieldAssign(_) | .IndexHookAssign{..} | .MathSwizzleAssign{..} | .LineMarker(_)
        | .SourceSpan(_) | .Erased{..} | .InvariantViolation{..} -> {}
    }
}

// Rust: crates/jet-codegen/src/Codegen/TIR/lower/lambdas.rs:838
fn lowered_block_return_ty(body: [TStmt]) -> Type Never! {
    if body.last() == {
        Val(.ExprStmt(expr)) | Val(.Return(Val(expr))) -> expr.ty.clone()
        Val(.Inline(inner)) | Val(.DebugOnly(inner)) -> lowered_block_return_ty(inner)
        else -> unit_type()
    }
}

// Rust: crates/jet-codegen/src/Codegen/TIR/lower/lambdas.rs:850
pub fn lower_lambda_with_shared_block(lam: Lambda, cx: Cx, env: LowerEnv, body: Arc<[TStmt]>) -> TLambda Never! {
    lower_lambda_expecting_with_host_borrow(lam, cx, env, None, None, false, Val(body), None)
}

