// Rust: crates/jet-codegen/src/Codegen/TIR/lower/lambdas.rs:874
pub fn lower_spawn_lambda_for_jit_expecting(lam: Lambda, cx: Cx, env: LowerEnv, expected_params: [Type]) -> TJitSpawnLambda Never! {
    lower_spawn_lambda_for_jit_expecting_with_body(lam, cx, env, expected_params, None)
}

// Rust: crates/jet-codegen/src/Codegen/TIR/lower/lambdas.rs:883
fn lower_spawn_lambda_for_jit_expecting_with_body(lam: Lambda, cx: Cx, env: LowerEnv, expected_params: [Type], shared_body: Arc<[TStmt]>?) -> TJitSpawnLambda Never! {
    param_names := Set<String>.from(lam.params.map(fn(p) { p.name }))
    cloned := Set<String>.from(lam.meta.cloned_captures)
    moved := Set<String>.from(lam.meta.moved_captures)
    materialized := Set<String>.from(lam.meta.materialized_captures)
    frozen := Set<String>.from(lam.meta.frozen_captures)
    (reads, called) := if lam.body == { .Block(stmts) -> Sema.block_free_reads_and_calls(stmts); .Expr(e) -> Sema.expr_free_reads_and_calls(e) }
    loop (name, _) in lam.take_names { reads.insert(name.clone()) }
    loop name in called { if env.ty_of(name) == { Val(.Fn(_, _, _, _, _, _)) -> reads.insert(name); else -> {} } }
    captures: [JitSpawnCapture] := []
    loop source in reads {
        if param_names.contains(source) || !env.locals.contains_key(source) -> continue
        name := if shared_body.is_some() -> reactive_capture_name(source) else -> source.clone()
        materialize_at_spawn := materialized.contains(source) || (shared_body.is_some() && materialized_capture_kind(source, env).is_some())
        source_ty := env.split_view_handle(source).or_else(fn() { env.ty_of(source) }).expect("checked capture local has no resolved type")
        ty := if materialize_at_spawn -> materialized_capture_kind(source, env).map(fn(pair) { pair.1 }).unwrap_or_else(fn() { source_ty.clone() }) else -> source_ty
        captures.push(JitSpawnCapture{materialize_at_spawn: materialize_at_spawn, clone_at_spawn: cloned.contains(source) && !moved.contains(source), frozen_at_spawn: frozen.contains(source), ty: ty, name: name, source: source})
    }
    captures.sort_by(fn(a, b) { a.name.compare(b.name) })
    lam_env := fork_panic(env)
    lam_env.txn_handle = None
    lam_env.txn_undo_needed = None
    loop cap in captures { lam_env.bind(cap.name, TLocal.user(cap.name), Val(cap.ty.clone())) }
    loop (i, p) in lam.params.enumerate() {
        ty := p.ty.clone().or_else(fn() { expected_params.get(i).cloned() }).or(Val(Type.Int))
        lam_env.bind(p.name, TLocal.user(p.name), ty)
    }
    ret := shared_body.map(fn(body) {
        body_ty := lowered_block_return_ty(body)
        if lam.meta.fallible_carrier == { Val(.Result(_, err)) -> return Type.Result{ok: body_ty, err: err.clone()}; else -> {} }
        if lam.meta.fallible_propagation {
            if env.ret_ty == { Val(.Result(_, err)) -> Type.Result{ok: body_ty, err: err.clone()}; Val(.Option(_)) -> Type.Option(body_ty); else -> body_ty }
        } else -> body_ty
    }).unwrap_or_else(fn() { spawn_body_carrier_ty(lam, cx, env) })
    if shared_body.is_none() {
        if lam.body == { .Expr(expr) -> prepare_interrupt_callback_local_expr(expr, cx, &lam_env); .Block(stmts) -> prepare_interrupt_callback_locals(stmts, cx, &lam_env) }
    }
    body := with_lambda_body_expr_cache(fn() {
        if lam.body == {
            .Expr(e) -> TJitSpawnBody.Expr(lower_expr(e, cx, &lam_env))
            .Block(stmts) -> {
                if shared_body == { Val(shared) -> return TJitSpawnBody.SharedBlock{body: shared.clone(), tail: lambda_block_tail(stmts).is_some()}; else -> {} }
                if lambda_block_tail(stmts) == {
                    Val((prefix, tail)) -> {
                        prefix_lowered := lower_stmts(prefix, cx, &lam_env)
                        tail_lowered := if tail == { .Return(Val(e), _) | .Expr(e) -> lower_expr(e, cx, &lam_env); else -> TExpr{ty: unit_type(), kind: TExprKind.IntLit(0, None)} }
                        TJitSpawnBody.Block{prefix: prefix_lowered, tail: Val(tail_lowered)}
                    }
                    else -> TJitSpawnBody.Block{prefix: lower_stmts(stmts, cx, &lam_env), tail: None}
                }
            }
        }
    })
    params: [(String, Type)] := []
    loop (i, p) in lam.params.enumerate() { params.push((p.name.clone(), p.ty.clone().or_else(fn() { expected_params.get(i).cloned() }).unwrap_or(Type.Int))) }
    TJitSpawnLambda{params: params, captures: captures, frozen_captures: lam.meta.frozen_captures.clone(), body: body, ret: ret, uses_stack_sentry: lam_env.stack_sentry_needed()}
}

// Rust: crates/jet-codegen/src/Codegen/TIR/lower/lambdas.rs:1063
pub fn lower_spawn_lambda_for_jit_with_shared_block(lam: Lambda, cx: Cx, env: LowerEnv, body: Arc<[TStmt]>) -> TJitSpawnLambda Never! {
    lower_spawn_lambda_for_jit_expecting_with_body(lam, cx, env, [], Val(body))
}

// Rust: crates/jet-codegen/src/Codegen/TIR/lower/lambdas.rs:1075
fn reactive_capture_setup(stmts: [Stmt], outer_env: LowerEnv) -> (String, LowerEnv) Never! {
    reads := Sema.block_free_var_reads(stmts)
    caps := reads.filter(fn(n) { outer_env.locals.contains_key(n) }).collect()
    caps.sort()
    lam_env := fork_panic(outer_env)
    prep := ""
    loop name in caps {
        cap := reactive_capture_name(name)
        copied_window := materialized_capture_kind(name, outer_env)
        (cap_ty, init) := if copied_window == {
            Val((helper, ty)) -> (Val(ty.clone()), "{helper}(({outer_env.place_of(name)}))")
            None -> (outer_env.ty_of(name), "({outer_env.place_of(name)}).clone()")
        }
        prep.push_str("let mut {cap} = {init};\n    ")
        lam_env.bind(name, TLocal.generated(cap), cap_ty)
        if copied_window.is_some() { lam_env.clear_view_marks(name) }
    }
    (prep, lam_env)
}

// Rust: crates/jet-codegen/src/Codegen/TIR/lower/lambdas.rs:1111
pub fn reactive_block_env(stmts: [Stmt], cx: Cx, outer_env: LowerEnv) -> LowerEnv Never! {
    (_, lam_env) := reactive_capture_setup(stmts, outer_env)
    prepare_interrupt_callback_locals(stmts, cx, &lam_env)
    lam_env
}
