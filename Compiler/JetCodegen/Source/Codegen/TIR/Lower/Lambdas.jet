// Rust: crates/jet-codegen/src/Codegen/TIR/lower/lambdas.rs:127
pub fn lower_lambda_expecting_callable(lam: Lambda, cx: Cx, env: LowerEnv, expected: Type) -> TLambda Never! {
    if expected == {
        .Fn(params, ret, _, _, _, _) -> {
            slot_return := ret.clone().unwrap_or_else(unit_type)
            lower_lambda_expecting_with_host_borrow(lam, cx, env, Val(params), None, false, None, Val(slot_return))
        }
        else -> lower_lambda_expecting(lam, cx, env, None)
    }
}

