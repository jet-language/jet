pub fn lower_spawn_lambda_for_jit(lam: Lambda, cx: Cx, env: LowerEnv) -> TJitSpawnLambda Never! {
    lower_spawn_lambda_for_jit_expecting(lam, cx, env, [])
}

// Rust: crates/jet-codegen/src/Codegen/TIR/lower/lambdas.rs:864
pub fn lower_spawn_lambda_for_jit_unit(lam: Lambda, cx: Cx, env: LowerEnv) -> TJitSpawnLambda Never! {
    lower_spawn_lambda_for_jit(lam, cx, env)
