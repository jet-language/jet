//RS 
//RS /// Per-function lowering environment: a local name -> (structured slot, type).
//RS /// Built from params, extended by `let` bindings. The slot already accounts for
//RS /// parameter deref, so every TIR consumer sees the same
//RS /// local facts.
//RS ///
//RS /// The type is `Option<Type>`: a binding can carry a *resolved* type, or `None`
//RS /// when the AST path's slot had `jet_ty: None` and we must reproduce that
//RS /// partiality. The load-bearing case (c109 Phase 5) is a `loop x in coll`
//RS /// iteration variable: `emit_for_in` binds its slot with `jet_ty: None`, so
//RS /// `operand_is_integer`/`expr_jet_ty` resolve the var to `None` and it never
//RS /// enables the overflow trap. Carrying `Some(elem_ty)` here would diverge —
//RS /// `x + 1` would wrongly trap. So the iteration var is stored as `None`,
//RS /// matching the AST path bit-for-bit (the Phase-3 "reproduce the AST's
//RS /// partiality where it is load-bearing" lesson, again).
//RS 
//RS #[derive(Clone)]
//RS pub(crate) struct LowerEnv {
//RS     pub(super) locals: HashMap<String, (TLocal, Option<Type>)>,
//RS     /// D-FOUND-BOARD1: checked DMA transfer locals retain their channel fact so
//RS     /// a later `.wait()` keeps the same profile identity and ownership route.
//RS     pub(super) dma_transfers: HashMap<String, String>,
//RS     /// c109 Phase 8: the enclosing function's unmangled Jet name, used by a `?`
//RS     /// (`TExprKind::Try`) to embed the trace-frame function name — exactly the value
//RS     /// the AST path reads from `cx.current_fn` at emit time (set to `f.name`).
//RS     pub(super) fn_name: String,
//RS     /// D-UNIONTYPE1=A: enclosing function return type, for member→union inject
//RS     /// at `return` / `Ok` / `Err` / `?` boundaries.
//RS     pub(super) ret_ty: Option<Type>,
//RS     /// The checked enclosing trait uses a raw host protocol return ABI.
//RS     pub(super) raw_protocol_return: bool,
//RS     /// True while lowering the value consumed by `??`. Closure adapters whose
//RS     /// source result is void retain their effective `Result` carrier in this
//RS     /// context so the fallback can consume it as a value rather than inherit
//RS     /// an implicit `?`.
//RS     pub(super) fallback_subject: bool,
//RS     /// D-FIELDPOL1: the owning struct name when lowering an inherent/trait
//RS     /// method (`None` for a free function). `self`'s own env type is
//RS     /// deliberately `None` (see `bind` above), so a `self.field` read can't
//RS     /// resolve its receiver struct through `recv.ty` the way `x.field` does —
//RS     /// this is the one place that struct name is available, used only to
//RS     /// check `cx.computed_fields` (whether `self.field` needs a getter call).
//RS     pub(super) self_owner: Option<String>,
//RS     /// D-MEM1 stage S5: names bound by a `Binding.string_view` init — the Rust
//RS     /// place is a plain `&str` (not the `String` its `Type::String` would
//RS     /// ordinarily lower to). Consulted only by `Expr::Copy` lowering, which
//RS     /// must materialize a view with `.to_string()` (an owned `String`), not
//RS     /// the ordinary `.clone()` (which on a `&str` would just hand back
//RS     /// another `&str` — the wrong Rust type for a `copy` result that needs to
//RS     /// escape the view's scope).
//RS     pub(super) string_view_locals: HashSet<String>,
//RS     pub(super) borrowed_locals: HashSet<String>,
//RS     pub(super) resource_locals: HashSet<String>,
//RS     /// Exact Rust places consumed by `ResourceTake`. This is shared by child
//RS     /// lowering environments so the enclosing TIR body can repair only the
//RS     /// declarations that need mutable access to `JetResource::take`.
//RS     pub(super) resource_take_targets: Rc<RefCell<HashSet<String>>>,
//RS     pub(super) gc_locals: HashSet<String>,
//RS     /// Fixed-list locals created with `Type.{ uninit }`. TIR marks their
//RS     /// index writes so AOT can use the vetted `jet_mem` storage wrapper.
//RS     pub(super) uninit_fixed_locals: HashSet<String>,
//RS     pub(super) gc_return: bool,
//RS     /// D-TASKBORROW1=A: split-view locals and the handle type engines other
//RS     /// than AOT hold them as. AOT keeps a real Rust reference; the JIT keeps a
//RS     /// `ViewMut`/`View` window record, and a spawned task capturing one must be
//RS     /// typed as that window or the child reads the wrong shape.
//RS     pub(super) split_view_handles: HashMap<String, Type>,
//RS     /// Operand types that lowering materializes with Rust `.clone()`. Generic
//RS     /// function emission uses this to add `Clone` only where the body needs it.
//RS     pub(super) cloned_types: Rc<RefCell<Vec<Type>>>,
//RS     /// Function locals whose value crosses the native interrupt boundary.
//RS     pub(super) send_fn_locals: HashSet<String>,
//RS     /// Compiler-private default references resolve to the declaration-slot
//RS     /// temporary made by source-order lowering.
//RS     pub(super) binder_refs: HashMap<String, (String, Type)>,
//RS     /// D-BOUND-UNDO1=A: active transaction handle for compiler-registered FFI
//RS     /// inverse hooks. Nested transactions replace this fact in their child env.
//RS     pub(super) txn_handle: Option<TLocal>,
//RS     /// Set when a synthesized FFI undo hook is emitted in a bare transaction,
//RS     /// so the transaction gets a runtime handle even without user snapshots.
//RS     pub(super) txn_undo_needed: Option<Rc<Cell<bool>>>,
//RS     /// D-MEM-SENTRY1: lexical instrumentation policy. Static obligations are
//RS     /// independent; this fact only controls runtime observation.
//RS     pub(super) sentries_enabled: bool,
//RS     pub(super) sentries_fenced: bool,
//RS     /// D-HARDENED1 / D-MEM-SENTRY1: shared lowering fact that this function or
//RS     /// deferred body mints an address from current-frame storage. Child branch
//RS     /// environments share it so the enclosing function receives one lifetime
//RS     /// hook for every path.
//RS     pub(super) stack_sentry_needed: Rc<Cell<bool>>,
//RS }
