        edges
    }
    // Rust: crates/jet-codegen/src/Codegen/TIR/lower/env.rs:214
    pub fn note_clone(&self, ty: Type) Never! { &self.cloned_types.borrow_mut().push(ty) }
    // Rust: crates/jet-codegen/src/Codegen/TIR/lower/env.rs:220
    pub fn bind(&self, name: String, slot: TLocal, ty: Type?) Never! { self.locals[name] = (^slot, ^ty) }
    // Rust: crates/jet-codegen/src/Codegen/TIR/lower/env.rs:223
    pub fn mark_dma_transfer(&self, name: String, channel: String) Never! { self.dma_transfers[name] = ^channel }
    // Rust: crates/jet-codegen/src/Codegen/TIR/lower/env.rs:226
    pub fn dma_transfer_channel(self, name: String) -> String? Never! { self.dma_transfers.get(name) }
    // Rust: crates/jet-codegen/src/Codegen/TIR/lower/env.rs:232
    pub fn set_integer_bounds(&self, name: String, bounds: TIntegerBounds?) Never! {
        if self.locals.get(name) == Val((slot, ty)) {
            updated := ^slot
            updated.integer_bounds = bounds
            self.locals[name] = (^updated, ty)
        }
    }
    // Rust: crates/jet-codegen/src/Codegen/TIR/lower/env.rs:238
    pub fn integer_bounds_of(self, name: String) -> TIntegerBounds? Never! {
        if self.locals.get(name) == Val((slot, _)) -> slot.integer_bounds else -> None
    }
    // Rust: crates/jet-codegen/src/Codegen/TIR/lower/env.rs:246
    pub fn update_integer_bounds(&self, name: String, op: BinOp?, value: TExpr) Never! {
        bounds := TIntegerBounds?{None}
        if op == {
            .None -> bounds = integer_bounds_for_expr(value)
            .Val(operation) -> {
                if self.integer_bounds_of(name) == Val(lhs) && integer_bounds_for_expr(value) == Val(rhs) -> bounds = integer_bounds_for_op(operation, lhs, rhs)
            }
        }
        &self.set_integer_bounds(name, bounds)
    }
    // Rust: crates/jet-codegen/src/Codegen/TIR/lower/env.rs:262
    pub fn local_of(self, name: String) -> TLocal Never! {
        if self.locals.get(name) == Val((slot, _)) -> slot else -> TLocal.user(name)
    }
    // Rust: crates/jet-codegen/src/Codegen/TIR/lower/env.rs:268
    pub fn place_of(self, name: String) -> String Never! { self.local_of(name).rust_place() }
    // Rust: crates/jet-codegen/src/Codegen/TIR/lower/env.rs:271
    pub fn ty_of(self, name: String) -> Type? Never! {
        if self.locals.get(name) == Val((_, ty)) -> ty else -> None
    }
    // Rust: crates/jet-codegen/src/Codegen/TIR/lower/env.rs:277
    pub fn is_borrowed(self, name: String) -> Bool Never! {
        if self.borrowed_locals.contains(name) -> return true
        if self.locals.get(name) == Val((slot, _)) -> slot.deref else -> false
    }
    // Rust: crates/jet-codegen/src/Codegen/TIR/lower/env.rs:284
    pub fn rust_name_of(self, name: String) -> String Never! { self.local_of(name).rust_name() }
}
// Rust: crates/jet-codegen/src/Codegen/TIR/lower/env.rs:289
fn gc_expr_references_ident(expr: Expr, name: String) -> Bool Never! {
    work := TirWorklist<Expr>.new()
    &work.push(expr)
    loop &work.pop() == Val(current) {
        if current == {
            .Ident(candidate, _) -> { if candidate == name -> return true }
            .Call(call) -> loop arg in call.args.iter().rev() -> &work.push(arg.expr)
            .MethodCall{receiver, args, ..} | .CallValue{callee: receiver, args, ..} -> {
                loop arg in args.iter().rev() -> &work.push(arg.expr)
                &work.push(receiver)
            }
            .Binary(_, left, right, _) -> { &work.push(right); &work.push(left) }
            .Unary(_, inner, _) | .Field(inner, _, _) | .Deref(inner, _) | .RawOf(inner, _)
            | .Copy(inner, _) | .Place(inner, _, _) | .Tainted(inner, _, _) | .Present(inner, _)
            | .Ok(inner, _) | .Err(inner, _) -> &work.push(inner)
            .Try(inner, _, _, note) -> {
                &work.push(inner)
                if note == Val(value) -> &work.push(value)
            }
            .OptField{base, ..} -> &work.push(base)
            .Index{base, index, ..} -> { &work.push(index); &work.push(base) }
            .Slice{base, start, end, range, ..} -> {
                if range == Val(value) -> &work.push(value)
                else { &work.push(end); &work.push(start) }
                &work.push(base)
            }
            .Range{start, end, ..} -> { &work.push(end); &work.push(start) }
            .ListLit(items, _) -> loop item in items.iter().rev() -> &work.push(item)
            .MapLit(pairs, _) -> loop (key, value) in pairs.iter().rev() { &work.push(value); &work.push(key) }
            .StructLit{fields, ..} -> loop (_, _, value) in fields.iter().rev() -> &work.push(value)
            .TypedLit{body, ..} -> {
                if body == {
                    .Fields(fields) -> loop (_, _, value) in fields.iter().rev() -> &work.push(value)
                    .Elements(elements) -> loop value in elements.iter().rev() -> &work.push(value)
                    .Entries(entries) -> loop (key, value) in entries.iter().rev() { &work.push(value); &work.push(key) }
                    .Value(value) -> &work.push(value)
                    .ByteText(_) | .Empty -> {}
                }
            }
            .TupleLit(fields, _, _) -> loop (_, value) in fields.iter().rev() -> &work.push(value)
            .EnumLit{args, ..} -> loop arg in args.iter().rev() {
                if arg == { .Positional(value) | .Named{expr: value, ..} -> &work.push(value) }
            }
            .Str(parts, _) -> loop part in parts.iter().rev() {
                if part == .Interp(value, _) -> &work.push(value)
            }
            else -> {}
        }
    }
    false
}
// Rust: crates/jet-codegen/src/Codegen/TIR/lower/env.rs:432
pub fn collect_txn_mut_roots(body: [Stmt], &out: [String]) Never! {
    // Rust: crates/jet-codegen/src/Codegen/TIR/lower/env.rs:433
    fn push(&out: [String], name: String) Never! {
        loop previous in out { if previous == name -> return }
        &out.push(name)
    }
    // Rust: crates/jet-codegen/src/Codegen/TIR/lower/env.rs:439
    fn lvalue_root(value: LValue) -> String? Never! {
        if value == {
            .Local{name, ..} -> Val(name)
            .Index{base, ..} | .Field{base, ..} -> expr_root(base)
        }
    }
    // Rust: crates/jet-codegen/src/Codegen/TIR/lower/env.rs:445
    fn expr_root(expression: Expr) -> String? Never! {
        current := expression
        loop {
            if current == {
                .Ident(name, _) -> return Val(name)
                .Field(base, _, _) | .Index{base, ..} -> current = base
                else -> return None
            }
        }
    }
    work := TirWorklist<Stmt>.from_reversed(body.iter())
    loop &work.pop() == Val(statement) {
        if statement == {
            .Assign{target, ..} -> {
                if lvalue_root(target) == Val(root) -> push(&out, root)
            }
            .Switched{marker, body, ..} -> {
                if !switched_off(marker) -> &work.extend(body.iter().rev())
            }
            .While{body, ..} | .For{body, ..} | .Loop{body, ..} | .CountedLoop{body, ..}
            | .Unsafe{body, ..} | .Impure{body, ..} | .Reactive{body, ..} | .Region{body, ..}
            | .Policy{body, ..} | .TaskGroup{body, ..} | .Layout{body, ..} | .AuthorityScope{body, ..}
            | .ContextBlock{body, ..} | .Live{body, ..} | .AssumeDet{body, ..} -> &work.extend(body.iter().rev())
            .Switch{arms, else_body, ..} -> {
                if else_body == Val(rows) -> &work.extend(rows.iter().rev())
                loop arm in arms.iter().rev() -> &work.extend(arm.body.iter().rev())
            }
            .ComptimeBlock{..} -> {}
            .ComptimeIf{then_body, else_body, ..} -> {
                if else_body == Val(rows) -> &work.extend(rows.iter().rev())
                &work.extend(then_body.iter().rev())
            }
            .Transact{..} -> {} // Nested transaction owns its rollback scope; deferred lambdas are not walked.
            else -> {}
        }
    }
}
