//RS /// D-TXN-ROLLBACK layer 1: collect the root local names that are *assigned* anywhere
//RS /// in a `#Transact` body — `x = …`, `x += …`, `x.f = …`, `x[i] = …` — so each can be
//RS /// auto-snapshotted at block entry and restored on a `?`-failure. Uses the
//RS /// shared heap worklist through nested control flow (if/while/for/switch/loop/
//RS /// region/etc.) but stops at:
//RS ///   • nested `#Transact` blocks — they establish their own rollback scope; and
//RS ///   • lambda bodies — a deferred execution context (the same reason `on_commit`
//RS ///     lambdas escape the enclosing transaction's effect check).
//RS /// Each root is recorded once, in first-seen order. v1 covers assignment targets,
//RS /// the clearly-analyzable, fully-correct case; mutation reached *only* through a
//RS /// `&self` method call (no assignment) or a deep alias is the documented deferred
//RS /// corner (D-TXN-ROLLBACK). This is a syntactic over-approximation filtered by the
//RS /// caller to roots in scope at block entry.
//RS pub(super) fn collect_txn_mut_roots(body: &[Stmt], out: &mut Vec<String>) {
//RS     fn push(out: &mut Vec<String>, name: &str) {
//RS         if !out.iter().any(|n| n == name) {
//RS             out.push(name.to_string());
//RS         }
