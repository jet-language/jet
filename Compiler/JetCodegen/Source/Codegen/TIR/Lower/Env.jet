    }
    // Rust: crates/jet-codegen/src/Codegen/TIR/lower/env.rs:130
    pub fn mark_split_view(&self, name: String, handle: Type) Never! { self.split_view_handles[name] = ^handle }
    // Rust: crates/jet-codegen/src/Codegen/TIR/lower/env.rs:133
    pub fn split_view_handle(self, name: String) -> Type? Never! { self.split_view_handles.get(name) }
    // Rust: crates/jet-codegen/src/Codegen/TIR/lower/env.rs:137
    pub fn mark_string_view(&self, name: String) Never! { _ :: &self.string_view_locals.insert(name) }
    // Rust: crates/jet-codegen/src/Codegen/TIR/lower/env.rs:141
    pub fn is_string_view_local(self, name: String) -> Bool Never! { self.string_view_locals.contains(name) }
    // Rust: crates/jet-codegen/src/Codegen/TIR/lower/env.rs:149
    pub fn clear_view_marks(&self, name: String) Never! {
        _ :: &self.string_view_locals.remove(name)
        _ :: &self.split_view_handles.remove(name)
    }
    // Rust: crates/jet-codegen/src/Codegen/TIR/lower/env.rs:153
    pub fn mark_resource(&self, name: String) Never! { _ :: &self.resource_locals.insert(name) }
    // Rust: crates/jet-codegen/src/Codegen/TIR/lower/env.rs:156
    pub fn mark_borrowed(&self, name: String) Never! { _ :: &self.borrowed_locals.insert(name) }
    // Rust: crates/jet-codegen/src/Codegen/TIR/lower/env.rs:159
    pub fn is_resource(self, name: String) -> Bool Never! { self.resource_locals.contains(name) }
    // Rust: crates/jet-codegen/src/Codegen/TIR/lower/env.rs:164
    pub fn resource_take_place(self, name: String) -> TLocal Never! {
        _ :: &self.resource_take_targets.borrow_mut().insert(self.rust_name_of(name))
        self.local_of(name)
    }
    // Rust: crates/jet-codegen/src/Codegen/TIR/lower/env.rs:170
    pub fn resource_take_targets(self) -> Set<String> Never! { self.resource_take_targets.borrow().clone() }
    // Rust: crates/jet-codegen/src/Codegen/TIR/lower/env.rs:173
    pub fn mark_gc(&self, name: String) Never! { _ :: &self.gc_locals.insert(name) }
    // Rust: crates/jet-codegen/src/Codegen/TIR/lower/env.rs:176
    pub fn is_gc(self, name: String) -> Bool Never! { self.gc_locals.contains(name) }
    // Rust: crates/jet-codegen/src/Codegen/TIR/lower/env.rs:179
    pub fn mark_uninit_fixed(&self, name: String) Never! { _ :: &self.uninit_fixed_locals.insert(name) }
    // Rust: crates/jet-codegen/src/Codegen/TIR/lower/env.rs:182
    pub fn is_uninit_fixed(self, name: String) -> Bool Never! { self.uninit_fixed_locals.contains(name) }
    // Rust: crates/jet-codegen/src/Codegen/TIR/lower/env.rs:185
    pub fn mark_send_fn(&self, name: String) Never! { _ :: &self.send_fn_locals.insert(name) }
    // Rust: crates/jet-codegen/src/Codegen/TIR/lower/env.rs:188
    pub fn is_send_fn(self, name: String) -> Bool Never! { self.send_fn_locals.contains(name) }
    // Rust: crates/jet-codegen/src/Codegen/TIR/lower/env.rs:191
    pub fn note_stack_address(self) Never! { self.stack_sentry_needed.set(true) }
    // Rust: crates/jet-codegen/src/Codegen/TIR/lower/env.rs:194
    pub fn stack_sentry_needed(self) -> Bool Never! { self.stack_sentry_needed.get() }
    // Rust: crates/jet-codegen/src/Codegen/TIR/lower/env.rs:197
    pub fn binder_ref(self, name: String) -> (String, Type)? Never! { self.binder_refs.get(name) }
    // Rust: crates/jet-codegen/src/Codegen/TIR/lower/env.rs:200
    pub fn gc_edges_for_expr(self, expr: Expr, exclude: String?) -> [String] Never! {
        names := self.gc_locals.iter().collect()
        &names.sort()
        edges := [String]{}
        loop name in names {
            if exclude != Val(name) && gc_expr_references_ident(expr, name) -> &edges.push("{self.place_of(name)}.id()")
