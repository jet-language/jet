            raw_protocol_return: false, fallback_subject: false, self_owner: None,
            string_view_locals: Set<String>.new(), borrowed_locals: Set<String>.new(),
            resource_locals: Set<String>.new(), resource_take_targets: Rc.new(RefCell.new(Set<String>.new())),
            gc_locals: Set<String>.new(), uninit_fixed_locals: Set<String>.new(), gc_return: false,
            split_view_handles: [:], cloned_types: Rc.new(RefCell.new([])), send_fn_locals: Set<String>.new(),
            binder_refs: [:], txn_handle: None, txn_undo_needed: None, sentries_enabled: true,
