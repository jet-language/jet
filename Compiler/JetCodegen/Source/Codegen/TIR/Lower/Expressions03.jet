// Rust: crates/jet-codegen/src/Codegen/TIR/lower/expressions.rs:3604
fn lower_boundary_typed_lit(type_name: String, body: TypedLitBody, cx: Cx, mut env: LowerEnv) -> TExpr? {
    if body == {
        Value(inner) -> {
            if inner == {
                Str(parts, _) -> {
                    literals := [String]{}
                    holes := [TExpr]{}
                    trusted_html := [Bool]{}
                    loop part in parts {
                        if part == {
                            Lit(text) -> &literals.push(text.clone())
                            Interp(expr, _) -> {
                                if literals.len() == holes.len() { &literals.push("") }
                                hole :: lower_expr(expr, cx, &env)
                                trusted :: type_name == Syntax.TYPE_HTML && (if hole.ty == { Named(name) -> name == Syntax.TYPE_HTML _ -> false })
                                &trusted_html.push(trusted)
                                &holes.push(hole)
                            }
                        }
                    }
                    if literals.len() == holes.len() { &literals.push("") }
                    kind :: Syntax.typed_head_kind(type_name).filter(fn(kind) { kind.is_boundary() }) ?? return None
                    Val(TExpr{ty: Type.Named(kind.internal_type_name().to_string()), kind: TExprKind.HostCall(THostCall.TypedTextInterp{
                        kind: kind, literals: literals, holes: holes, trusted_html: trusted_html,
                    })})
                }
                _ -> None
            }
        }
        _ -> None
    }
}

// Rust: crates/jet-codegen/src/Codegen/TIR/lower/expressions.rs:3656
fn byte_text_exprs(parts: [ByteTextPart], span: Span) -> [Expr]? {
    bytes :: TypedLitBody.byte_text_bytes(parts) ?? return None
    Val(loop byte in bytes -> Expr.Int(byte as I64, span, None, Val(byte.to_string())))
}

// Rust: crates/jet-codegen/src/Codegen/TIR/lower/expressions.rs:3666
fn lower_unit_text(value: TExpr, style: UnitFormat, cx: Cx) -> TExpr {
    original_ty :: value.ty.clone()
    raw :: if original_ty == {
        Named(name) -> {
            base :: cx.distinct_types.get(name).map(fn(pair) { pair.0.clone() }) ?? Type.Float
            TExpr{ty: base, kind: TExprKind.DistinctRaw(value)}
        }
        _ -> {
            if original_ty.quantity_parts() == {
                Val((base, _)) -> TExpr{ty: base.clone(), kind: value.kind}
                None -> value
            }
        }
    }
    // The Bare marker keeps the magnitude on the dedicated quantity formatter.
    parts := [TStrPart]{TStrPart.Interp(raw, StrFormat.Unit(UnitFormat.Bare))}
    if style != UnitFormat.Bare {
        label :: cx.unit_label(original_ty).map(fn(label) {
            if style == { Name -> label.name.clone() Symbol | Bare -> label.symbol.clone() }
        }) ?? original_ty.quantity_parts().map(fn(pair) { cx.quantity_unit_label(pair.1, style) })
            ?? cx.quantity_dimension(original_ty).map(fn(dimension) { cx.quantity_unit_label(dimension, style) })
            ?? panic("sema accepted unit formatting only for unit values")
        &parts.push(TStrPart.Lit(" {label}"))
    }
    TExpr{ty: Type.String, kind: TExprKind.StrLit(parts)}
}

// Rust: crates/jet-codegen/src/Codegen/TIR/lower/expressions.rs:3723
fn join_print_args(args: [CallArg], cx: Cx, mut env: LowerEnv) -> TExpr {
    values :: loop arg in args -> lower_expr(arg.expr, cx, &env)
    join_print_values(values, cx)
}

// Rust: crates/jet-codegen/src/Codegen/TIR/lower/expressions.rs:3727
fn join_print_values(values: [TExpr], cx: Cx) -> TExpr {
    display_values :: loop value in values -> lower_display_value(value, cx)
    parts := [TStrPart].with_capacity(display_values.len() * 2)
    loop (index, value) in display_values.enumerate() {
        if index > 0 { &parts.push(TStrPart.Lit("\n")) }
        &parts.push(TStrPart.Interp(value, StrFormat.Display))
    }
    TExpr{ty: Type.String, kind: TExprKind.StrLit(parts)}
}

// Rust: crates/jet-codegen/src/Codegen/TIR/lower/expressions.rs:3745
fn lower_display_value(value: TExpr, cx: Cx) -> TExpr {
    if value.ty.quantity_parts() != None { return lower_unit_text(value, UnitFormat.Symbol, cx) }
    if (if value.ty == { Named(name) -> name == Syntax.TYPE_COMPLEX _ -> false }) && !cx.type_names.contains(Syntax.TYPE_COMPLEX) {
        return TExpr{ty: Type.String, kind: TExprKind.PreciseBuiltin{type_name: Syntax.TYPE_COMPLEX.to_string(), func: "to_string", args: [value]}}
    }
    if (if value.ty == { Named(name) -> name == Syntax.TYPE_FRACTION _ -> false }) && !cx.type_names.contains(Syntax.TYPE_FRACTION) {
        return TExpr{ty: Type.String, kind: TExprKind.PreciseBuiltin{type_name: Syntax.TYPE_FRACTION.to_string(), func: "to_string", args: [value]}}
    }
    name :: if value.ty == { Named(name) -> name _ -> return value }
    prelude_scalar :: if value.ty.without_user_tags() == {
        Named("Int" | "Float" | "Bool" | "String" | "Char" | "I8" | "I16" | "I32" | "I64" | "I128" | "U8" | "U16" | "U32" | "U64" | "U128") -> true
        _ -> false
    }
    // Generic Printable parameters have no concrete fragment Display receiver.
    generic_parameter :: cx.current_type_params.borrow().contains(name)
    if !prelude_scalar && !generic_parameter && cx.has_display_type(name) {
        return TExpr{ty: Type.String, kind: TExprKind.MethodCall{
            recv: value, method: TMethodRef.trait_method("Display", "display"),
            type_args: [], args: [], source_first_string_literal: None, operator_line: None,
        }}
    }
    if cx.unit_label(value.ty) == None { return value }
    lower_unit_text(value, UnitFormat.Symbol, cx)
}

// Rust: crates/jet-codegen/src/Codegen/TIR/lower/expressions.rs:3826
fn lower_print_value(value: TExpr, cx: Cx) -> TExpr {
    printable_unit :: value.ty.quantity_parts() != None || cx.unit_label(value.ty) != None
    explicit_display :: if value.ty == { Named(name) -> cx.has_display_type(name) _ -> false }
    if printable_unit || explicit_display { lower_display_value(value, cx) } else { value }
}

// Rust: crates/jet-codegen/src/Codegen/TIR/lower/expressions.rs:3841
fn print_values(values: [TExpr], cx: Cx, site: USize) -> TExpr {
    lowered := loop value in values -> lower_print_value(value, cx)
    if lowered.len() == 1 {
        value :: &lowered.pop() ?? panic("one-value print fast path has one value")
        return TExpr{ty: unit_type(), kind: TExprKind.Print(value)}
    }
    stmts := [TStmt].with_capacity(lowered.len() * 2)
    locals := [(TLocal, Type)].with_capacity(lowered.len())
    loop (index, value) in lowered.enumerate() {
        temp :: "{generated_prefix()}print_arg_{site}_{index}"
        local :: TLocal.generated(temp)
        &locals.push((local.clone(), value.ty.clone()))
        &stmts.push(TStmt.Let{name: temp, kw: "let", let_ty: TLetTy.inferred(), init: value, gc_promotion: None, gc_transferred: false})
    }
    // All arguments evaluate before the first Print, preserving source order.
    loop (local, ty) in locals {
        value :: TExpr{ty: ty, kind: TExprKind.Local(local)}
        &stmts.push(TStmt.ExprStmt(TExpr{ty: unit_type(), kind: TExprKind.Print(value)}))
    }
    TExpr{ty: unit_type(), kind: TExprKind.InlineBlock(stmts)}
}

// Rust: crates/jet-codegen/src/Codegen/TIR/lower/expressions.rs:3887
fn print_args(args: [CallArg], cx: Cx, mut env: LowerEnv, site: USize) -> TExpr {
    values :: loop arg in args -> lower_expr(arg.expr, cx, &env)
    print_values(values, cx, site)
}

// Rust: crates/jet-codegen/src/Codegen/TIR/lower/expressions.rs:3903
fn lower_debug_text(value: TExpr) -> TExpr {
    TExpr{ty: Type.String, kind: TExprKind.StrLit([TStrPart.Interp(value, StrFormat.Debug)])}
}

// Rust: crates/jet-codegen/src/Codegen/TIR/lower/expressions.rs:3916
fn lower_debug_trace(call: Call, cx: Cx, mut env: LowerEnv) -> TExpr {
    value := lower_expr(call.args[0].expr, cx, &env)
    if !value.ty.is_scalar() && (if value.kind == { Local(_) | Field{..} | Index{..} -> true _ -> false }) {
        value = TExpr{ty: value.ty.clone(), kind: TExprKind.Clone(value, MirCopyFact.Materialize)}
    }
    site :: if call.args.get(1).map(fn(arg) { arg.expr }) == {
        Val(Expr.Str(parts, _)) -> {
            text := String.new()
            loop part in parts { if part == { Lit(literal) -> &text.push_str(literal) Interp(..) -> {} } }
            text
        }
        _ -> ""
    }
    ty :: value.ty.clone()
    temp :: "{generated_prefix()}debug_trace_{call.name_span.start}"
    local :: TLocal.generated(temp)
    read :: fn() { TExpr{ty: ty.clone(), kind: TExprKind.Local(local.clone())} }
    line :: TExpr{ty: Type.String, kind: TExprKind.StrLit([
        TStrPart.Lit("{Syntax.DEBUG_TRACE_PREFIX} {site} = "), TStrPart.Interp(read(), StrFormat.Debug),
    ])}
    write :: core_call_expr(unit_type(), "core.term", "eprint", [line], call.name_span, [false])
    TExpr{ty: ty.clone(), kind: TExprKind.InlineBlock([
        TStmt.Let{name: temp, kw: "let", let_ty: TLetTy.inferred(), init: value, gc_promotion: None, gc_transferred: false},
        TStmt.ExprStmt(write), TStmt.ExprStmt(read()),
    ])}
}

// Rust: crates/jet-codegen/src/Codegen/TIR/lower/expressions.rs:3978
fn lower_fmt_call(method: String, args: [TExpr], source_span: Span) -> TExpr {
    widen_to_vec :: [Bool].repeat(false, args.len())
    core_call_expr(Type.String, "core.text.fmt", method, args, source_span, widen_to_vec)
}

// Rust: crates/jet-codegen/src/Codegen/TIR/lower/expressions.rs:3990
fn lower_fmt_int(value: I64) -> TExpr { TExpr{ty: Type.Int, kind: TExprKind.IntLit(value, None)} }

// Rust: crates/jet-codegen/src/Codegen/TIR/lower/expressions.rs:3997
fn lower_fmt_string(value: String) -> TExpr { TExpr{ty: Type.String, kind: TExprKind.StrLit([TStrPart.Lit(value)])} }

// Rust: crates/jet-codegen/src/Codegen/TIR/lower/expressions.rs:4008
fn lower_default_err_field(name: String, value: Expr, cx: Cx, mut env: LowerEnv) -> TExpr {
    if (name, strip_expr_parens(value)) == {
        ("code", Expr.Absent(_)) -> TExpr{ty: Type.Option(Type.String), kind: TExprKind.Absent}
        ("cause", Expr.Absent(_)) -> TExpr{ty: Type.Option(Type.Named(Syntax.TYPE_ERR.to_string())), kind: TExprKind.Absent}
        _ -> lower_expr(value, cx, &env)
    }
}

// Rust: crates/jet-codegen/src/Codegen/TIR/lower/expressions.rs:4026
fn lower_raw_err_value(call: Call, cx: Cx, mut env: LowerEnv) -> TExpr {
    message :: call.args.first().filter(fn(arg) { arg.label == None }).map(fn(arg) { lower_expr(arg.expr, cx, &env) })
        ?? TExpr{ty: Type.String, kind: TExprKind.StrLit([TStrPart.Lit("")])}
    optional :: fn(value: TExpr?, fallback: Type) {
        if value == {
            Val(value) -> TExpr{ty: Type.Option(value.ty.clone()), kind: TExprKind.Present(value)}
            None -> TExpr{ty: Type.Option(fallback), kind: TExprKind.Absent}
        }
    }
    code :: call.args.find(fn(arg) { arg.label.is_some_and(fn(pair) { pair.0 == "code" }) }).map(fn(arg) { lower_expr(arg.expr, cx, &env) })
    cause :: call.args.find(fn(arg) { arg.label.is_some_and(fn(pair) { pair.0 == "cause" }) }).map(fn(arg) {
        if strip_expr_parens(arg.expr) == {
            Call(nested) -> { if nested.name == Syntax.LIT_ERR { lower_raw_err_value(nested, cx, &env) } else { lower_expr(arg.expr, cx, &env) } }
            _ -> lower_expr(arg.expr, cx, &env)
        }
    })
    TExpr{ty: Type.Named(Syntax.TYPE_ERR.to_string()), kind: TExprKind.StructLit{
        fields: [("message", message, false), ("code", optional(code, Type.String), false), ("cause", optional(cause, Type.Named(Syntax.TYPE_ERR.to_string())), false)],
        extra: None, as_trait: None,
    }}
}

// Rust: crates/jet-codegen/src/Codegen/TIR/lower/expressions.rs:4081
fn lower_raw_ok_call(call: Call, cx: Cx, mut env: LowerEnv) -> TExpr? {
    if call.name != Syntax.LIT_OK || cx.sigs.contains_key(call.name) || env.locals.contains_key(call.name) { return None }
    payload := call.args.first().map(fn(arg) { lower_owned_expr(arg.expr, cx, &env) }) ?? TExpr{ty: unit_type(), kind: TExprKind.Unit}
    (ok_ty, err_ty) :: if env.ret_ty == {
        Val(Type.Result{ok, err}) -> {
            payload = preserve_typed_list_shape(payload, ok, cx)
            payload = maybe_widen_expr_to_union(payload, ok)
            (ok.clone(), err.clone())
        }
        _ -> (payload.ty.clone(), Type.Named(Syntax.TYPE_ERR.to_string()))
    }
    Val(TExpr{ty: Type.Result{ok: ok_ty, err: err_ty}, kind: TExprKind.Ok(payload)})
}

// Rust: crates/jet-codegen/src/Codegen/TIR/lower/expressions.rs:4120
fn lower_raw_contextual_result_variant(variant: String, args: [EnumLitArg], span: Span, cx: Cx, mut env: LowerEnv) -> TExpr? {
    if !(if env.ret_ty == { Val(Type.Result{..}) -> true _ -> false }) || (variant != Syntax.LIT_OK && variant != Syntax.LIT_ERR) { return None }
    call_args :: loop arg in args {
        if arg == {
            Positional(expr) -> CallArg{convention: AccessConvention.Move, expr: expr.clone(), span: expr.span(), flags: .default(), label: None, spread: false}
            Named{label, expr} -> CallArg{convention: AccessConvention.Move, expr: expr.clone(), span: expr.span(), flags: .default(), label: Val((label.clone(), expr.span())), spread: false}
        }
    }
    call :: Call{name: variant.to_string(), name_span: span, type_args: [], args: call_args, resolved_ret: None, range_checked: false, widen_approx: false}
    if variant == Syntax.LIT_OK { lower_raw_ok_call(call, cx, &env) } else { lower_raw_err_call(call, cx, &env) }
}

// Rust: crates/jet-codegen/src/Codegen/TIR/lower/expressions.rs:4172
fn raw_contextual_return_enum(variant: String, cx: Cx, env: LowerEnv) -> String? {
    return_type :: env.ret_ty ?? return None
    success :: if return_type == { Result{ok, ..} -> ok _ -> return_type }
    name :: if success == { Named(name) | Apply{name, ..} -> name _ -> return None }
    resolved :: cx.local_type_identities.get(name) ?? cx.core_qualified_rust_type_name(name) ?? name
    declared :: [name, resolved].any(fn(owner) {
        cx.enum_variants.get(owner).is_some_and(fn(variants) { variants.any(fn(pair) { pair.0 == variant }) })
    }) || compiler_owned_enum_variants(name).is_some_and(fn(variants) { variants.contains(variant) })
        || core_enum_variants(resolved).is_some_and(fn(variants) { variants.contains(variant) })
    if declared { Val(name.clone()) } else { None }
}

// Rust: crates/jet-codegen/src/Codegen/TIR/lower/expressions.rs:4197
fn lower_raw_err_call(call: Call, cx: Cx, mut env: LowerEnv) -> TExpr? {
    if call.name != Syntax.LIT_ERR || cx.sigs.contains_key(call.name) || env.locals.contains_key(call.name) { return None }
    target_error :: if env.ret_ty == { Val(Type.Result{err, ..}) -> Val(err.clone()) _ -> None }
    default_error :: if target_error == {
        None -> true
        Val(error) -> if error == { Named(name) -> name == Syntax.TYPE_ERR _ -> false }
    }
    if default_error {
        value :: lower_raw_err_value(call, cx, &env)
        return Val(if target_error == {
            Val(_) -> {
                ok :: if env.ret_ty == { Val(Type.Result{ok, ..}) -> ok.clone() _ -> Type.Int }
                TExpr{ty: Type.Result{ok: ok, err: value.ty.clone()}, kind: TExprKind.Err(value, None)}
            }
            None -> value
        })
    }
    payload :: call.args.first().map(fn(arg) { lower_expr(arg.expr, cx, &env) })
        ?? TExpr{ty: Type.Named(Syntax.TYPE_ERR.to_string()), kind: TExprKind.StructLit{fields: [], extra: None, as_trait: None}}
    widened :: if target_error == { Val(error) -> maybe_widen_expr_to_union(payload, error) None -> payload }
    ok :: if env.ret_ty == { Val(Type.Result{ok, ..}) -> ok.clone() _ -> Type.Int }
    Val(TExpr{ty: Type.Result{ok: ok, err: widened.ty.clone()}, kind: TExprKind.Err(widened, None)})
}

// Rust: crates/jet-codegen/src/Codegen/TIR/lower/expressions.rs:4255
fn lower_positive_integer_literal(expr: Expr, cx: Cx, mut env: LowerEnv) -> TExpr? {
    if expr == { Paren(inner, _) -> lower_positive_integer_literal(inner, cx, &env) Int(..) -> Val(lower_expr(expr, cx, &env)) _ -> None }
}

// Rust: crates/jet-codegen/src/Codegen/TIR/lower/expressions.rs:4263
fn integer_literal_is_zero(expr: Expr) -> Bool {
    if expr == {
        Paren(inner, _) -> integer_literal_is_zero(inner)
        Int(value, _, _, raw) -> {
            exact :: raw.and_then(fn(text) { CtBigInt.from_literal(text).ok() }) ?? CtBigInt.from_int(value)
            exact.is_zero()
        }
        _ -> false
    }
}

// Rust: crates/jet-codegen/src/Codegen/TIR/lower/expressions.rs:4277
fn lower_negative_power_exponent(expr: Expr, cx: Cx, mut env: LowerEnv) -> TExpr? {
    if expr == {
        Paren(inner, _) -> lower_negative_power_exponent(inner, cx, &env)
        Unary(UnOp.Neg, inner, _) -> {
            if integer_literal_is_zero(inner) { return None }
            lower_positive_integer_literal(inner, cx, &env)
        }
        Int(value, _, _, raw) -> {
            exact :: raw.and_then(fn(text) { CtBigInt.from_literal(text).ok() }) ?? CtBigInt.from_int(value)
            if exact.negative { Val(TExpr{ty: Type.Int, kind: TExprKind.CtLit(CtValue.BigInt(exact.abs()))}) } else { None }
        }
        _ -> None
    }
}

// Rust: crates/jet-codegen/src/Codegen/TIR/lower/expressions.rs:4300
fn invariant_violation_expr(span: Span, construct: String) -> TExpr {
    TExpr{ty: Type.Named(Syntax.TYPE_NEVER.to_string()), kind: TExprKind.InvariantViolation{construct: construct, span: span}}
}

// Rust: crates/jet-codegen/src/Codegen/TIR/lower/expressions.rs:4310
fn checked_const_ref_name(name: String, cx: Cx) -> String { cx.const_ref_keys.get(name).map(fn(key) { key.clone() }) ?? name.to_string() }

// Rust: crates/jet-codegen/src/Codegen/TIR/lower/expressions.rs:4320
fn lower_named_comptime_binding(name: String, cx: Cx, env: LowerEnv) -> TExpr? {
    if env.locals.contains_key(name) { return Val(TExpr{ty: env.ty_of(name) ?? Type.Int, kind: TExprKind.Local(env.local_of(name))}) }
    if !cx.consts.contains_key(name) && !cx.const_values.contains_key(name) && !cx.const_ref_keys.contains_key(name) { return None }
    Val(in_own_frame(fn() {
        value :: cx.const_values.get(name)
        ty :: env.ty_of(name) ?? cx.const_ref_types.get(name).map(fn(ty) { ty.clone() }) ?? value.map(fn(value) { value.jet_type() }) ?? Type.Int
        kind :: lower_comptime_scalar(value, Val(ty)) ?? TExprKind.ConstRef(checked_const_ref_name(name, cx))
        TExpr{kind: kind, ty: ty}
    }))
}

// Rust: crates/jet-codegen/src/Codegen/TIR/lower/expressions.rs:4347
fn core_call_expr(ty: Type, module: String, member: String, args: [TExpr], source_span: Span, widen_to_vec: [Bool]) -> TExpr {
    record :: Syntax.core_call(module, member) ?? return invariant_violation_expr(source_span, "CoreCall `{module}.{member}`")
    fallibility :: TFailureCarrier.from_checked_type(ty)
    data_plan :: data_plan_for_core_call(record, args, ty, source_span) catch error { return invariant_violation_expr(source_span, error) }
    TExpr{ty: ty, kind: TExprKind.CoreCall{
        record: record, args: args, source_span: source_span, type_args: [], widen_to_vec: widen_to_vec, data_plan: data_plan, fallibility: fallibility,
    }}
}

// Rust: crates/jet-codegen/src/Codegen/TIR/lower/expressions.rs:4380
fn prepared_constant_path_value(expr: Expr, cx: Cx, env: LowerEnv) -> CtValue? {
    if expr == {
        Paren(inner, _) | Copy(inner, _) -> prepared_constant_path_value(inner, cx, env)
        Ident(name, _) -> { if !env.locals.contains_key(name) { cx.const_values.get(name) } else { None } }
        Field(base, field, _) -> {
            value :: prepared_constant_path_value(base, cx, env) ?? return None
            if value == {
                Struct{fields, ..} -> fields.find(fn(pair) { pair.0 == field }).map(fn(pair) { pair.1 })
                Present(inner) -> if inner == {
                    Struct{fields, ..} -> fields.find(fn(pair) { pair.0 == field }).map(fn(pair) { pair.1 })
                    _ -> None
                }
                _ -> None
            }
        }
        Index{base, index, ..} -> {
            value :: prepared_constant_path_value(base, cx, env) ?? return None
            if (value, index.without_parens()) == {
                (CtValue.List(items), Expr.Int(position, ..)) -> {
                    offset :: USize.try_from(position).ok() ?? return None
                    items.get(offset)
                }
                _ -> None
            }
        }
        _ -> None
    }
}

// Rust: crates/jet-codegen/src/Codegen/TIR/lower/expressions.rs:4419
// The inline(never) attribute belongs to the following fragment's routine.
